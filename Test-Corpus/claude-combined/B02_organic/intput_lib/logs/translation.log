{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UdYQndF4EeURoAk8xS46D8","type":"tool_result","content":"1\t//! FFI comparison tests: load both the C and Rust shared libraries via\n2\t//! libloading, exercise the public API, and compare results byte-for-byte.\n3\t\n4\tuse libloading::{Library, Symbol};\n5\tuse std::ffi::c_void;\n6\tuse std::os::raw::{c_char, c_int};\n7\tuse std::path::PathBuf;\n8\t\n9\tconst C_LIB_PATH: &str = \"c_src/build/libtranslated_rust.so\";\n10\tconst RUST_LIB_PATH: &str = \"target/release/libtranslated_rust.so\";\n11\t\n12\tfn workspace_root() -> PathBuf {\n13\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n14\t}\n15\t\n16\tfn c_lib_path() -> PathBuf {\n17\t    workspace_root().join(C_LIB_PATH)\n18\t}\n19\t\n20\tfn rust_lib_path() -> PathBuf {\n21\t    workspace_root().join(RUST_LIB_PATH)\n22\t}\n23\t\n24\tunsafe fn load_libs() -> (Library, Library) {\n25\t    let c = Library::new(c_lib_path()).expect(\"load C lib\");\n26\t    let r = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n27\t    (c, r)\n28\t}\n29\t\n30\t// Function signatures we'll bind\n31\ttype FnRandSeed = unsafe extern \"C\" fn(usize);\n32\ttype FnHashString = unsafe extern \"C\" fn(*mut c_char, usize) -> usize;\n33\ttype FnHashBytes = unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize;\n34\ttype FnArrgrowf = unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void;\n35\ttype FnArrfreef = unsafe extern \"C\" fn(*mut c_void);\n36\ttype FnHmputKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\n37\ttype FnHmgetKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\n38\ttype FnHmgetKeyTs =\n39\t    unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, *mut isize, c_int) -> *mut c_void;\n40\ttype FnHmdelKey =\n41\t    unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, usize, c_int) -> *mut c_void;\n42\ttype FnHmfreeFunc = unsafe extern \"C\" fn(*mut c_void, usize);\n43\ttype FnHmputDefault = unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void;\n44\ttype FnShmodeFunc = unsafe extern \"C\" fn(usize, c_int) -> *mut c_void;\n45\ttype FnStrkey = unsafe extern \"C\" fn(c_int) -> *mut c_char;\n46\ttype FnIntput = unsafe extern \"C\" fn(c_int);\n47\t\n48\t#[repr(C)]\n49\t#[derive(Copy, Clone, Debug)]\n50\tstruct StbdsArrayHeader {\n51\t    length: usize,\n52\t    capacity: usize,\n53\t    hash_table: *mut c_void,\n54\t    temp: isize,\n55\t}\n56\t\n57\t/// header_of(t) — like stbds_header(t) in the C macros, returns the header\n58\t/// for an array pointer. Used directly on array bases.\n59\tunsafe fn header_of(t: *mut c_void) -> *mut StbdsArrayHeader {\n60\t    (t as *mut StbdsArrayHeader).sub(1)\n61\t}\n62\t\n63\t/// hash_header_of(t, elemsize) — used on hash-map \"user\" pointers. The user\n64\t/// pointer points one element past the underlying array base; the header sits\n65\t/// before that base.\n66\tunsafe fn hash_header_of(t: *mut c_void, elemsize: usize) -> *mut StbdsArrayHeader {\n67\t    let arr = (t as *mut u8).sub(elemsize) as *mut c_void;\n68\t    (arr as *mut StbdsArrayHeader).sub(1)\n69\t}\n70\t\n71\t#[test]\n72\tfn rand_seed_doesnt_crash() {\n73\t    unsafe {\n74\t        let (c, r) = load_libs();\n75\t        let c_fn: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n76\t        let r_fn: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n77\t        c_fn(0x12345);\n78\t        r_fn(0x12345);\n79\t    }\n80\t}\n81\t\n82\t#[test]\n83\tfn hash_string_matches() {\n84\t    unsafe {\n85\t        let (c, r) = load_libs();\n86\t        let c_fn: Symbol<FnHashString> = c.get(b\"stbds_hash_string\").unwrap();\n87\t        let r_fn: Symbol<FnHashString> = r.get(b\"stbds_hash_string\").unwrap();\n88\t\n89\t        let cases: &[(&[u8], usize)] = &[\n90\t            (b\"\\0\", 0),\n91\t            (b\"hello\\0\", 0),\n92\t            (b\"hello\\0\", 0xdeadbeef),\n93\t            (b\"a longer test string for hashing\\0\", 0x12345678),\n94\t            (b\"\\xff\\xfe\\x01\\x02\\0\", 0xabcdef01),\n95\t            (b\"x\\0\", 0),\n96\t        ];\n97\t        for (s, seed) in cases {\n98\t            let p = s.as_ptr() as *mut c_char;\n99\t            let cv = c_fn(p, *seed);\n100\t            let rv = r_fn(p, *seed);\n101\t            assert_eq!(cv, rv, \"hash_string mismatch on {:?}/{:#x}\", s, seed);\n102\t        }\n103\t    }\n104\t}\n105\t\n106\t#[test]\n107\tfn hash_bytes_matches() {\n108\t    unsafe {\n109\t        let (c, r) = load_libs();\n110\t        let c_fn: Symbol<FnHashBytes> = c.get(b\"stbds_hash_bytes\").unwrap();\n111\t        let r_fn: Symbol<FnHashBytes> = r.get(b\"stbds_hash_bytes\").unwrap();\n112\t\n113\t        let mut buf = [0u8; 64];\n114\t        for i in 0..buf.len() {\n115\t            buf[i] = (i as u8).wrapping_mul(7).wrapping_add(3);\n116\t        }\n117\t        let p = buf.as_mut_ptr() as *mut c_void;\n118\t        for len in 0..=buf.len() {\n119\t            for &seed in &[0usize, 1, 0xdeadbeef, 0xfeedfacecafebeef] {\n120\t                let cv = c_fn(p, len, seed);\n121\t                let rv = r_fn(p, len, seed);\n122\t                assert_eq!(cv, rv, \"hash_bytes len={} seed={:#x}\", len, seed);\n123\t            }\n124\t        }\n125\t    }\n126\t}\n127\t\n128\t#[test]\n129\tfn arrgrowf_grows_correctly() {\n130\t    unsafe {\n131\t        let (c, r) = load_libs();\n132\t        let c_fn: Symbol<FnArrgrowf> = c.get(b\"stbds_arrgrowf\").unwrap();\n133\t        let r_fn: Symbol<FnArrgrowf> = r.get(b\"stbds_arrgrowf\").unwrap();\n134\t        let c_free: Symbol<FnArrfreef> = c.get(b\"stbds_arrfreef\").unwrap();\n135\t        let r_free: Symbol<FnArrfreef> = r.get(b\"stbds_arrfreef\").unwrap();\n136\t\n137\t        let elemsize = std::mem::size_of::<c_int>();\n138\t\n139\t        for &(addlen, min_cap) in &[(1usize, 0usize), (5, 0), (0, 16), (3, 32)] {\n140\t            let ca = c_fn(std::ptr::null_mut(), elemsize, addlen, min_cap);\n141\t            let ra = r_fn(std::ptr::null_mut(), elemsize, addlen, min_cap);\n142\t\n143\t            assert!(!ca.is_null());\n144\t            assert!(!ra.is_null());\n145\t\n146\t            let ch = *header_of(ca);\n147\t            let rh = *header_of(ra);\n148\t            assert_eq!(ch.capacity, rh.capacity, \"cap addlen={} min_cap={}\", addlen, min_cap);\n149\t            assert_eq!(ch.length, rh.length);\n150\t            assert_eq!(ch.temp, rh.temp);\n151\t\n152\t            c_free(ca);\n153\t            r_free(ra);\n154\t        }\n155\t\n156\t        // Confirm both return NULL for (0,0)\n157\t        let ca0 = c_fn(std::ptr::null_mut(), elemsize, 0, 0);\n158\t        let ra0 = r_fn(std::ptr::null_mut(), elemsize, 0, 0);\n159\t        assert!(ca0.is_null());\n160\t        assert!(ra0.is_null());\n161\t    }\n162\t}\n163\t\n164\t#[test]\n165\tfn hmput_hmget_int_key_int_value() {\n166\t    unsafe {\n167\t        let (c, r) = load_libs();\n168\t        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n169\t        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n170\t        let c_get: Symbol<FnHmgetKey> = c.get(b\"stbds_hmget_key\").unwrap();\n171\t        let r_get: Symbol<FnHmgetKey> = r.get(b\"stbds_hmget_key\").unwrap();\n172\t        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n173\t        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n174\t        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n175\t        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n176\t\n177\t        // Reset seed deterministically before each side.\n178\t        c_seed(0x31415926);\n179\t        r_seed(0x31415926);\n180\t\n181\t        // Layout matches `struct { int key; int value; }` => 8 bytes\n182\t        #[repr(C)]\n183\t        #[derive(Copy, Clone)]\n184\t        struct Entry {\n185\t            key: c_int,\n186\t            value: c_int,\n187\t        }\n188\t        let elemsize = std::mem::size_of::<Entry>();\n189\t\n190\t        let mut c_map: *mut c_void = std::ptr::null_mut();\n191\t        let mut r_map: *mut c_void = std::ptr::null_mut();\n192\t\n193\t        // Insert pairs (key, value)\n194\t        let pairs: &[(c_int, c_int)] = &[\n195\t            (5, 100),\n196\t            (11, 3),\n197\t            (9, 50),\n198\t            (7, 7),\n199\t            (5, 999), // overwrite (we re-use temp index)\n200\t            (42, -1),\n201\t            (-7, 12345),\n202\t            (0, 22),\n203\t            (1, 33),\n204\t        ];\n205\t        for (k, v) in pairs {\n206\t            let mut key_local = *k;\n207\t            c_map = c_put(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n208\t            r_map = r_put(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n209\t            // Both should report the same temp index\n210\t            let c_temp = (*header_of(c_map)).temp;\n211\t            let r_temp = (*header_of(r_map)).temp;\n212\t            assert_eq!(c_temp, r_temp, \"temp mismatch for key {}\", k);\n213\t            // Write key/value at the temp index in each map (matching the macro).\n214\t            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n215\t            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n216\t            (*c_entry).key = *k;\n217\t            (*c_entry).value = *v;\n218\t            (*r_entry).key = *k;\n219\t            (*r_entry).value = *v;\n220\t        }\n221\t\n222\t        // Verify: get each key from both, compare result location's value\n223\t        for (k, _) in pairs {\n224\t            let mut key_local = *k;\n225\t            c_map = c_get(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n226\t            r_map = r_get(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n227\t            let c_temp = (*header_of(c_map)).temp;\n228\t            let r_temp = (*header_of(r_map)).temp;\n229\t            assert_eq!(c_temp, r_temp, \"get temp mismatch for key {}\", k);\n230\t            if c_temp >= 0 {\n231\t                let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n232\t                let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n233\t                assert_eq!((*c_entry).value, (*r_entry).value, \"value mismatch on key {}\", k);\n234\t            }\n235\t        }\n236\t\n237\t        // Lookups for keys not present should both report -1 in temp\n238\t        for missing in &[100i32, -55, 999_999] {\n239\t            let mut key_local = *missing;\n240\t            c_map = c_get(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n241\t            r_map = r_get(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n242\t            let c_temp = (*header_of(c_map)).temp;\n243\t            let r_temp = (*header_of(r_map)).temp;\n244\t            assert_eq!(c_temp, r_temp, \"missing key {} temp mismatch\", missing);\n245\t        }\n246\t\n247\t        // Compare lengths\n248\t        assert_eq!((*header_of(c_map)).length, (*header_of(r_map)).length);\n249\t\n250\t        c_freef(c_map, elemsize);\n251\t        r_freef(r_map, elemsize);\n252\t    }\n253\t}\n254\t\n255\t#[test]\n256\tfn hmdel_works() {\n257\t    unsafe {\n258\t        let (c, r) = load_libs();\n259\t        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n260\t        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n261\t        let c_del: Symbol<FnHmdelKey> = c.get(b\"stbds_hmdel_key\").unwrap();\n262\t        let r_del: Symbol<FnHmdelKey> = r.get(b\"stbds_hmdel_key\").unwrap();\n263\t        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n264\t        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n265\t        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n266\t        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n267\t\n268\t        c_seed(0x31415926);\n269\t        r_seed(0x31415926);\n270\t\n271\t        #[repr(C)]\n272\t        #[derive(Copy, Clone)]\n273\t        struct Entry {\n274\t            key: c_int,\n275\t            value: c_int,\n276\t        }\n277\t        let elemsize = std::mem::size_of::<Entry>();\n278\t\n279\t        let mut c_map: *mut c_void = std::ptr::null_mut();\n280\t        let mut r_map: *mut c_void = std::ptr::null_mut();\n281\t\n282\t        for k in 0..32 {\n283\t            let mut key_local = k as c_int;\n284\t            c_map = c_put(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n285\t            r_map = r_put(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n286\t            let c_temp = (*header_of(c_map)).temp;\n287\t            let r_temp = (*header_of(r_map)).temp;\n288\t            assert_eq!(c_temp, r_temp, \"put temp mismatch for k={}\", k);\n289\t            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n290\t            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n291\t            (*c_entry).key = k as c_int;\n292\t            (*c_entry).value = (k * 10) as c_int;\n293\t            (*r_entry).key = k as c_int;\n294\t            (*r_entry).value = (k * 10) as c_int;\n295\t        }\n296\t\n297\t        // Delete some keys\n298\t        for k in [3, 7, 10, 25, 0, 31] {\n299\t            let mut key_local = k as c_int;\n300\t            c_map = c_del(\n301\t                c_map,\n302\t                elemsize,\n303\t                &mut key_local as *mut c_int as *mut c_void,\n304\t                std::mem::size_of::<c_int>(),\n305\t                0,\n306\t                0,\n307\t            );\n308\t            r_map = r_del(\n309\t                r_map,\n310\t                elemsize,\n311\t                &mut key_local as *mut c_int as *mut c_void,\n312\t                std::mem::size_of::<c_int>(),\n313\t                0,\n314\t                0,\n315\t            );\n316\t            let c_temp = (*header_of(c_map)).temp;\n317\t            let r_temp = (*header_of(r_map)).temp;\n318\t            assert_eq!(c_temp, r_temp, \"del temp mismatch for k={}\", k);\n319\t        }\n320\t\n321\t        assert_eq!((*header_of(c_map)).length, (*header_of(r_map)).length);\n322\t\n323\t        c_freef(c_map, elemsize);\n324\t        r_freef(r_map, elemsize);\n325\t    }\n326\t}\n327\t\n328\t#[test]\n329\tfn shmode_func_creates_string_map() {\n330\t    unsafe {\n331\t        let (c, r) = load_libs();\n332\t        let c_fn: Symbol<FnShmodeFunc> = c.get(b\"stbds_shmode_func\").unwrap();\n333\t        let r_fn: Symbol<FnShmodeFunc> = r.get(b\"stbds_shmode_func\").unwrap();\n334\t        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n335\t        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n336\t        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n337\t        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n338\t        c_seed(0x31415926);\n339\t        r_seed(0x31415926);\n340\t\n341\t        #[repr(C)]\n342\t        struct StrEntry {\n343\t            key: *mut c_char,\n344\t            value: c_int,\n345\t        }\n346\t        let elemsize = std::mem::size_of::<StrEntry>();\n347\t        let cmap = c_fn(elemsize, 1 /* STBDS_SH_DEFAULT */);\n348\t        let rmap = r_fn(elemsize, 1);\n349\t\n350\t        // Lengths/temps match\n351\t        assert_eq!((*header_of(cmap)).length, (*header_of(rmap)).length);\n352\t\n353\t        c_freef(cmap, elemsize);\n354\t        r_freef(rmap, elemsize);\n355\t    }\n356\t}\n357\t\n358\t#[test]\n359\tfn strkey_returns_correct_string() {\n360\t    unsafe {\n361\t        let (c, r) = load_libs();\n362\t        let c_fn: Symbol<FnStrkey> = c.get(b\"strkey\").unwrap();\n363\t        let r_fn: Symbol<FnStrkey> = r.get(b\"strkey\").unwrap();\n364\t\n365\t        for n in &[0i32, 1, 42, -7, 12345] {\n366\t            let cp = c_fn(*n);\n367\t            let rp = r_fn(*n);\n368\t            // Compare the C-strings byte-for-byte\n369\t            let mut i = 0usize;\n370\t            loop {\n371\t                let cb = *cp.add(i) as u8;\n372\t                let rb = *rp.add(i) as u8;\n373\t                assert_eq!(cb, rb, \"strkey({}) mismatch at byte {}\", n, i);\n374\t                if cb == 0 {\n375\t                    break;\n376\t                }\n377\t                i += 1;\n378\t                if i > 256 {\n379\t                    panic!(\"buffer not terminated\");\n380\t                }\n381\t            }\n382\t        }\n383\t    }\n384\t}\n385\t\n386\t#[test]\n387\tfn intput_does_not_crash() {\n388\t    unsafe {\n389\t        let (c, r) = load_libs();\n390\t        let c_fn: Symbol<FnIntput> = c.get(b\"intput\").unwrap();\n391\t        let r_fn: Symbol<FnIntput> = r.get(b\"intput\").unwrap();\n392\t        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n393\t        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n394\t        c_seed(0x31415926);\n395\t        r_seed(0x31415926);\n396\t\n397\t        for n in &[0i32, 1, 5, 100, 9, 11, -3] {\n398\t            c_fn(*n);\n399\t            r_fn(*n);\n400\t        }\n401\t    }\n402\t}\n403\t\n404\t#[test]\n405\tfn hmput_default_match() {\n406\t    unsafe {\n407\t        let (c, r) = load_libs();\n408\t        let c_fn: Symbol<FnHmputDefault> = c.get(b\"stbds_hmput_default\").unwrap();\n409\t        let r_fn: Symbol<FnHmputDefault> = r.get(b\"stbds_hmput_default\").unwrap();\n410\t        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n411\t        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n412\t\n413\t        #[repr(C)]\n414\t        struct Entry {\n415\t            key: c_int,\n416\t            value: c_int,\n417\t        }\n418\t        let elemsize = std::mem::size_of::<Entry>();\n419\t        let cmap = c_fn(std::ptr::null_mut(), elemsize);\n420\t        let rmap = r_fn(std::ptr::null_mut(), elemsize);\n421\t        assert_eq!((*header_of(cmap)).length, (*header_of(rmap)).length);\n422\t        c_freef(cmap, elemsize);\n423\t        r_freef(rmap, elemsize);\n424\t    }\n425\t}\n426\t\n427\t#[test]\n428\tfn hmget_key_ts_match() {\n429\t    unsafe {\n430\t        let (c, r) = load_libs();\n431\t        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n432\t        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n433\t        let c_get_ts: Symbol<FnHmgetKeyTs> = c.get(b\"stbds_hmget_key_ts\").unwrap();\n434\t        let r_get_ts: Symbol<FnHmgetKeyTs> = r.get(b\"stbds_hmget_key_ts\").unwrap();\n435\t        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n436\t        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n437\t        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n438\t        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n439\t        c_seed(0x31415926);\n440\t        r_seed(0x31415926);\n441\t\n442\t        #[repr(C)]\n443\t        struct Entry {\n444\t            key: c_int,\n445\t            value: c_int,\n446\t        }\n447\t        let elemsize = std::mem::size_of::<Entry>();\n448\t        let mut c_map: *mut c_void = std::ptr::null_mut();\n449\t        let mut r_map: *mut c_void = std::ptr::null_mut();\n450\t\n451\t        for k in [1i32, 2, 3, 4] {\n452\t            let mut key_local = k;\n453\t            c_map = c_put(\n454\t                c_map,\n455\t                elemsize,\n456\t                &mut key_local as *mut c_int as *mut c_void,\n457\t                std::mem::size_of::<c_int>(),\n458\t                0,\n459\t            );\n460\t            r_map = r_put(\n461\t                r_map,\n462\t                elemsize,\n463\t                &mut key_local as *mut c_int as *mut c_void,\n464\t                std::mem::size_of::<c_int>(),\n465\t                0,\n466\t            );\n467\t            let c_temp = (*header_of(c_map)).temp;\n468\t            let r_temp = (*header_of(r_map)).temp;\n469\t            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n470\t            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n471\t            (*c_entry).key = k;\n472\t            (*c_entry).value = k * 100;\n473\t            (*r_entry).key = k;\n474\t            (*r_entry).value = k * 100;\n475\t        }\n476\t\n477\t        for k in [1i32, 99, 3] {\n478\t            let mut key_local = k;\n479\t            let mut ct: isize = 0;\n480\t            let mut rt: isize = 0;\n481\t            c_map = c_get_ts(\n482\t                c_map,\n483\t                elemsize,\n484\t                &mut key_local as *mut c_int as *mut c_void,\n485\t                std::mem::size_of::<c_int>(),\n486\t                &mut ct,\n487\t                0,\n488\t            );\n489\t            r_map = r_get_ts(\n490\t                r_map,\n491\t                elemsize,\n492\t                &mut key_local as *mut c_int as *mut c_void,\n493\t                std::mem::size_of::<c_int>(),\n494\t                &mut rt,\n495\t                0,\n496\t            );\n497\t            assert_eq!(ct, rt, \"hmget_key_ts temp mismatch on k={}\", k);\n498\t        }\n499\t\n500\t        c_freef(c_map, elemsize);\n501\t        r_freef(r_map, elemsize);\n502\t    }\n503\t}\n504\t"}]},"parent_tool_use_id":null,"session_id":"e04de84a-34d9-44b7-84d5-d2c3ada16f87","uuid":"d88aab84-da54-4f49-8632-4491d2d647cf","timestamp":"2026-05-30T00:56:01.736Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-translate-rKn6nG/translated_rust/tests/ffi_compare.rs","content":"//! FFI comparison tests: load both the C and Rust shared libraries via\n//! libloading, exercise the public API, and compare results byte-for-byte.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_void;\nuse std::os::raw::{c_char, c_int};\nuse std::path::PathBuf;\n\nconst C_LIB_PATH: &str = \"c_src/build/libtranslated_rust.so\";\nconst RUST_LIB_PATH: &str = \"target/release/libtranslated_rust.so\";\n\nfn workspace_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    workspace_root().join(C_LIB_PATH)\n}\n\nfn rust_lib_path() -> PathBuf {\n    workspace_root().join(RUST_LIB_PATH)\n}\n\nunsafe fn load_libs() -> (Library, Library) {\n    let c = Library::new(c_lib_path()).expect(\"load C lib\");\n    let r = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n    (c, r)\n}\n\n// Function signatures we'll bind\ntype FnRandSeed = unsafe extern \"C\" fn(usize);\ntype FnHashString = unsafe extern \"C\" fn(*mut c_char, usize) -> usize;\ntype FnHashBytes = unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize;\ntype FnArrgrowf = unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void;\ntype FnArrfreef = unsafe extern \"C\" fn(*mut c_void);\ntype FnHmputKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\ntype FnHmgetKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\ntype FnHmgetKeyTs =\n    unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, *mut isize, c_int) -> *mut c_void;\ntype FnHmdelKey =\n    unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, usize, c_int) -> *mut c_void;\ntype FnHmfreeFunc = unsafe extern \"C\" fn(*mut c_void, usize);\ntype FnHmputDefault = unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void;\ntype FnShmodeFunc = unsafe extern \"C\" fn(usize, c_int) -> *mut c_void;\ntype FnStrkey = unsafe extern \"C\" fn(c_int) -> *mut c_char;\ntype FnIntput = unsafe extern \"C\" fn(c_int);\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\nstruct StbdsArrayHeader {\n    length: usize,\n    capacity: usize,\n    hash_table: *mut c_void,\n    temp: isize,\n}\n\n/// header_of(t) — like stbds_header(t) in the C macros, returns the header\n/// for an array pointer. Used directly on array bases.\nunsafe fn header_of(t: *mut c_void) -> *mut StbdsArrayHeader {\n    (t as *mut StbdsArrayHeader).sub(1)\n}\n\n/// hash_header_of(t, elemsize) — used on hash-map \"user\" pointers. The user\n/// pointer points one element past the underlying array base; the header sits\n/// before that base.\nunsafe fn hash_header_of(t: *mut c_void, elemsize: usize) -> *mut StbdsArrayHeader {\n    let arr = (t as *mut u8).sub(elemsize) as *mut c_void;\n    (arr as *mut StbdsArrayHeader).sub(1)\n}\n\n#[test]\nfn rand_seed_doesnt_crash() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_fn: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_fn(0x12345);\n        r_fn(0x12345);\n    }\n}\n\n#[test]\nfn hash_string_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnHashString> = c.get(b\"stbds_hash_string\").unwrap();\n        let r_fn: Symbol<FnHashString> = r.get(b\"stbds_hash_string\").unwrap();\n\n        let cases: &[(&[u8], usize)] = &[\n            (b\"\\0\", 0),\n            (b\"hello\\0\", 0),\n            (b\"hello\\0\", 0xdeadbeef),\n            (b\"a longer test string for hashing\\0\", 0x12345678),\n            (b\"\\xff\\xfe\\x01\\x02\\0\", 0xabcdef01),\n            (b\"x\\0\", 0),\n        ];\n        for (s, seed) in cases {\n            let p = s.as_ptr() as *mut c_char;\n            let cv = c_fn(p, *seed);\n            let rv = r_fn(p, *seed);\n            assert_eq!(cv, rv, \"hash_string mismatch on {:?}/{:#x}\", s, seed);\n        }\n    }\n}\n\n#[test]\nfn hash_bytes_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnHashBytes> = c.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<FnHashBytes> = r.get(b\"stbds_hash_bytes\").unwrap();\n\n        let mut buf = [0u8; 64];\n        for i in 0..buf.len() {\n            buf[i] = (i as u8).wrapping_mul(7).wrapping_add(3);\n        }\n        let p = buf.as_mut_ptr() as *mut c_void;\n        for len in 0..=buf.len() {\n            for &seed in &[0usize, 1, 0xdeadbeef, 0xfeedfacecafebeef] {\n                let cv = c_fn(p, len, seed);\n                let rv = r_fn(p, len, seed);\n                assert_eq!(cv, rv, \"hash_bytes len={} seed={:#x}\", len, seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn arrgrowf_grows_correctly() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnArrgrowf> = c.get(b\"stbds_arrgrowf\").unwrap();\n        let r_fn: Symbol<FnArrgrowf> = r.get(b\"stbds_arrgrowf\").unwrap();\n        let c_free: Symbol<FnArrfreef> = c.get(b\"stbds_arrfreef\").unwrap();\n        let r_free: Symbol<FnArrfreef> = r.get(b\"stbds_arrfreef\").unwrap();\n\n        let elemsize = std::mem::size_of::<c_int>();\n\n        for &(addlen, min_cap) in &[(1usize, 0usize), (5, 0), (0, 16), (3, 32)] {\n            let ca = c_fn(std::ptr::null_mut(), elemsize, addlen, min_cap);\n            let ra = r_fn(std::ptr::null_mut(), elemsize, addlen, min_cap);\n\n            assert!(!ca.is_null());\n            assert!(!ra.is_null());\n\n            let ch = *header_of(ca);\n            let rh = *header_of(ra);\n            assert_eq!(ch.capacity, rh.capacity, \"cap addlen={} min_cap={}\", addlen, min_cap);\n            assert_eq!(ch.length, rh.length);\n            assert_eq!(ch.temp, rh.temp);\n\n            c_free(ca);\n            r_free(ra);\n        }\n\n        // Confirm both return NULL for (0,0)\n        let ca0 = c_fn(std::ptr::null_mut(), elemsize, 0, 0);\n        let ra0 = r_fn(std::ptr::null_mut(), elemsize, 0, 0);\n        assert!(ca0.is_null());\n        assert!(ra0.is_null());\n    }\n}\n\n#[test]\nfn hmput_hmget_int_key_int_value() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_get: Symbol<FnHmgetKey> = c.get(b\"stbds_hmget_key\").unwrap();\n        let r_get: Symbol<FnHmgetKey> = r.get(b\"stbds_hmget_key\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        // Reset seed deterministically before each side.\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        // Layout matches `struct { int key; int value; }` => 8 bytes\n        #[repr(C)]\n        #[derive(Copy, Clone)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n\n        let mut c_map: *mut c_void = std::ptr::null_mut();\n        let mut r_map: *mut c_void = std::ptr::null_mut();\n\n        // Insert pairs (key, value)\n        let pairs: &[(c_int, c_int)] = &[\n            (5, 100),\n            (11, 3),\n            (9, 50),\n            (7, 7),\n            (5, 999), // overwrite (we re-use temp index)\n            (42, -1),\n            (-7, 12345),\n            (0, 22),\n            (1, 33),\n        ];\n        for (k, v) in pairs {\n            let mut key_local = *k;\n            c_map = c_put(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n            r_map = r_put(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n            // Both should report the same temp index\n            let c_temp = (*header_of(c_map)).temp;\n            let r_temp = (*header_of(r_map)).temp;\n            assert_eq!(c_temp, r_temp, \"temp mismatch for key {}\", k);\n            // Write key/value at the temp index in each map (matching the macro).\n            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n            (*c_entry).key = *k;\n            (*c_entry).value = *v;\n            (*r_entry).key = *k;\n            (*r_entry).value = *v;\n        }\n\n        // Verify: get each key from both, compare result location's value\n        for (k, _) in pairs {\n            let mut key_local = *k;\n            c_map = c_get(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n            r_map = r_get(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n            let c_temp = (*header_of(c_map)).temp;\n            let r_temp = (*header_of(r_map)).temp;\n            assert_eq!(c_temp, r_temp, \"get temp mismatch for key {}\", k);\n            if c_temp >= 0 {\n                let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n                let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n                assert_eq!((*c_entry).value, (*r_entry).value, \"value mismatch on key {}\", k);\n            }\n        }\n\n        // Lookups for keys not present should both report -1 in temp\n        for missing in &[100i32, -55, 999_999] {\n            let mut key_local = *missing;\n            c_map = c_get(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n            r_map = r_get(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n            let c_temp = (*header_of(c_map)).temp;\n            let r_temp = (*header_of(r_map)).temp;\n            assert_eq!(c_temp, r_temp, \"missing key {} temp mismatch\", missing);\n        }\n\n        // Compare lengths\n        assert_eq!((*header_of(c_map)).length, (*header_of(r_map)).length);\n\n        c_freef(c_map, elemsize);\n        r_freef(r_map, elemsize);\n    }\n}\n\n#[test]\nfn hmdel_works() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_del: Symbol<FnHmdelKey> = c.get(b\"stbds_hmdel_key\").unwrap();\n        let r_del: Symbol<FnHmdelKey> = r.get(b\"stbds_hmdel_key\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        #[repr(C)]\n        #[derive(Copy, Clone)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n\n        let mut c_map: *mut c_void = std::ptr::null_mut();\n        let mut r_map: *mut c_void = std::ptr::null_mut();\n\n        for k in 0..32 {\n            let mut key_local = k as c_int;\n            c_map = c_put(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n            r_map = r_put(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, std::mem::size_of::<c_int>(), 0);\n            let c_temp = (*header_of(c_map)).temp;\n            let r_temp = (*header_of(r_map)).temp;\n            assert_eq!(c_temp, r_temp, \"put temp mismatch for k={}\", k);\n            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n            (*c_entry).key = k as c_int;\n            (*c_entry).value = (k * 10) as c_int;\n            (*r_entry).key = k as c_int;\n            (*r_entry).value = (k * 10) as c_int;\n        }\n\n        // Delete some keys\n        for k in [3, 7, 10, 25, 0, 31] {\n            let mut key_local = k as c_int;\n            c_map = c_del(\n                c_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                std::mem::size_of::<c_int>(),\n                0,\n                0,\n            );\n            r_map = r_del(\n                r_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                std::mem::size_of::<c_int>(),\n                0,\n                0,\n            );\n            let c_temp = (*header_of(c_map)).temp;\n            let r_temp = (*header_of(r_map)).temp;\n            assert_eq!(c_temp, r_temp, \"del temp mismatch for k={}\", k);\n        }\n\n        assert_eq!((*header_of(c_map)).length, (*header_of(r_map)).length);\n\n        c_freef(c_map, elemsize);\n        r_freef(r_map, elemsize);\n    }\n}\n\n#[test]\nfn shmode_func_creates_string_map() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnShmodeFunc> = c.get(b\"stbds_shmode_func\").unwrap();\n        let r_fn: Symbol<FnShmodeFunc> = r.get(b\"stbds_shmode_func\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        #[repr(C)]\n        struct StrEntry {\n            key: *mut c_char,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<StrEntry>();\n        let cmap = c_fn(elemsize, 1 /* STBDS_SH_DEFAULT */);\n        let rmap = r_fn(elemsize, 1);\n\n        // Lengths/temps match\n        assert_eq!((*header_of(cmap)).length, (*header_of(rmap)).length);\n\n        c_freef(cmap, elemsize);\n        r_freef(rmap, elemsize);\n    }\n}\n\n#[test]\nfn strkey_returns_correct_string() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnStrkey> = c.get(b\"strkey\").unwrap();\n        let r_fn: Symbol<FnStrkey> = r.get(b\"strkey\").unwrap();\n\n        for n in &[0i32, 1, 42, -7, 12345] {\n            let cp = c_fn(*n);\n            let rp = r_fn(*n);\n            // Compare the C-strings byte-for-byte\n            let mut i = 0usize;\n            loop {\n                let cb = *cp.add(i) as u8;\n                let rb = *rp.add(i) as u8;\n                assert_eq!(cb, rb, \"strkey({}) mismatch at byte {}\", n, i);\n                if cb == 0 {\n                    break;\n                }\n                i += 1;\n                if i > 256 {\n                    panic!(\"buffer not terminated\");\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn intput_does_not_crash() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnIntput> = c.get(b\"intput\").unwrap();\n        let r_fn: Symbol<FnIntput> = r.get(b\"intput\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        for n in &[0i32, 1, 5, 100, 9, 11, -3] {\n            c_fn(*n);\n            r_fn(*n);\n        }\n    }\n}\n\n#[test]\nfn hmput_default_match() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnHmputDefault> = c.get(b\"stbds_hmput_default\").unwrap();\n        let r_fn: Symbol<FnHmputDefault> = r.get(b\"stbds_hmput_default\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        #[repr(C)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n        let cmap = c_fn(std::ptr::null_mut(), elemsize);\n        let rmap = r_fn(std::ptr::null_mut(), elemsize);\n        assert_eq!((*header_of(cmap)).length, (*header_of(rmap)).length);\n        c_freef(cmap, elemsize);\n        r_freef(rmap, elemsize);\n    }\n}\n\n#[test]\nfn hmget_key_ts_match() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_get_ts: Symbol<FnHmgetKeyTs> = c.get(b\"stbds_hmget_key_ts\").unwrap();\n        let r_get_ts: Symbol<FnHmgetKeyTs> = r.get(b\"stbds_hmget_key_ts\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        #[repr(C)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n        let mut c_map: *mut c_void = std::ptr::null_mut();\n        let mut r_map: *mut c_void = std::ptr::null_mut();\n\n        for k in [1i32, 2, 3, 4] {\n            let mut key_local = k;\n            c_map = c_put(\n                c_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                std::mem::size_of::<c_int>(),\n                0,\n            );\n            r_map = r_put(\n                r_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                std::mem::size_of::<c_int>(),\n                0,\n            );\n            let c_temp = (*header_of(c_map)).temp;\n            let r_temp = (*header_of(r_map)).temp;\n            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n            (*c_entry).key = k;\n            (*c_entry).value = k * 100;\n            (*r_entry).key = k;\n            (*r_entry).value = k * 100;\n        }\n\n        for k in [1i32, 99, 3] {\n            let mut key_local = k;\n            let mut ct: isize = 0;\n            let mut rt: isize = 0;\n            c_map = c_get_ts(\n                c_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                std::mem::size_of::<c_int>(),\n                &mut ct,\n                0,\n            );\n            r_map = r_get_ts(\n                r_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                std::mem::size_of::<c_int>(),\n                &mut rt,\n                0,\n            );\n            assert_eq!(ct, rt, \"hmget_key_ts temp mismatch on k={}\", k);\n        }\n\n        c_freef(c_map, elemsize);\n        r_freef(r_map, elemsize);\n    }\n}\n","numLines":504,"startLine":1,"totalLines":504}}}
