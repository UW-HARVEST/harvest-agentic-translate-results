rse\");\n        let r_parse: Symbol<unsafe extern \"C\" fn(*const c_char) -> *mut CJsonRepr> = get_sym(&p.r, b\"cJSON_Parse\");\n        let c_dup: Symbol<unsafe extern \"C\" fn(*const CJsonRepr, c_int) -> *mut CJsonRepr> = get_sym(&p.c, b\"cJSON_Duplicate\");\n        let r_dup: Symbol<unsafe extern \"C\" fn(*const CJsonRepr, c_int) -> *mut CJsonRepr> = get_sym(&p.r, b\"cJSON_Duplicate\");\n        let c_print: Symbol<unsafe extern \"C\" fn(*const CJsonRepr) -> *mut c_char> = get_sym(&p.c, b\"cJSON_Print\");\n        let r_print: Symbol<unsafe extern \"C\" fn(*const CJsonRepr) -> *mut c_char> = get_sym(&p.r, b\"cJSON_Print\");\n        let c_delete: Symbol<unsafe extern \"C\" fn(*mut CJsonRepr)> = get_sym(&p.c, b\"cJSON_Delete\");\n        let r_delete: Symbol<unsafe extern \"C\" fn(*mut CJsonRepr)> = get_sym(&p.r, b\"cJSON_Delete\");\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut c_void)> = get_sym(&p.c, b\"cJSON_free\");\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut c_void)> = get_sym(&p.r, b\"cJSON_free\");\n\n        let json = \"{\\\"a\\\":1,\\\"b\\\":[1,2,3],\\\"c\\\":{\\\"x\\\":\\\"y\\\"}}\";\n        let cs = CString::new(json).unwrap();\n        let pa = c_parse(cs.as_ptr());\n        let pb = r_parse(cs.as_ptr());\n        let dup_c = c_dup(pa, 1);\n        let dup_r = r_dup(pb, 1);\n        let co = c_print(dup_c);\n        let ro = r_print(dup_r);\n        assert!(print_eq(co, ro, &c_free, &r_free));\n        c_delete(pa);\n        c_delete(dup_c);\n        r_delete(pb);\n        r_delete(dup_r);\n    }\n}\n\n#[test]\nfn test_parse_error() {\n    unsafe {\n        let p = Pair::load();\n        let c_parse: Symbol<unsafe extern \"C\" fn(*const c_char) -> *mut CJsonRepr> = get_sym(&p.c, b\"cJSON_Parse\");\n        let r_parse: Symbol<unsafe extern \"C\" fn(*const c_char) -> *mut CJsonRepr> = get_sym(&p.r, b\"cJSON_Parse\");\n        for bad in [\"{\", \"[1,2,\", \"{\\\"a\\\":}\", \"tru\", \"\\\"unterm\"] {\n            let cs = CString::new(bad).unwrap();\n            let pa = c_parse(cs.as_ptr());\n            let pb = r_parse(cs.as_ptr());\n            assert!(pa.is_null() && pb.is_null(), \"expected null for invalid input: {}\", bad);\n        }\n    }\n}\n\n#[test]\nfn test_get_object_item() {\n    unsafe {\n        let p = Pair::load();\n        let c_parse: Symbol<unsafe extern \"C\" fn(*const c_char) -> *mut CJsonRepr> = get_sym(&p.c, b\"cJSON_Parse\");\n        let r_parse: Symbol<unsafe extern \"C\" fn(*const c_char) -> *mut CJsonRepr> = get_sym(&p.r, b\"cJSON_Parse\");\n        let c_get: Symbol<unsafe extern \"C\" fn(*const CJsonRepr, *const c_char) -> *mut CJsonRepr> = get_sym(&p.c, b\"cJSON_GetObjectItem\");\n        let r_get: Symbol<unsafe extern \"C\" fn(*const CJsonRepr, *const c_char) -> *mut CJsonRepr> = get_sym(&p.r, b\"cJSON_GetObjectItem\");\n        let c_get_cs: Symbol<unsafe extern \"C\" fn(*const CJsonRepr, *const c_char) -> *mut CJsonRepr> = get_sym(&p.c, b\"cJSON_GetObjectItemCaseSensitive\");\n        let r_get_cs: Symbol<unsafe extern \"C\" fn(*const CJsonRepr, *const c_char) -> *mut CJsonRepr> = get_sym(&p.r, b\"cJSON_GetObjectItemCaseSensitive\");\n        let c_delete: Symbol<unsafe extern \"C\" fn(*mut CJsonRepr)> = get_sym(&p.c, b\"cJSON_Delete\");\n        let r_delete: Symbol<unsafe extern \"C\" fn(*mut CJsonRepr)> = get_sym(&p.r, b\"cJSON_Delete\");\n\n        let json = \"{\\\"foo\\\": 1, \\\"BAR\\\": 2, \\\"Baz\\\": \\\"hi\\\"}\";\n        let cs = CString::new(json).unwrap();\n        let pa = c_parse(cs.as_ptr());\n        let pb = r_parse(cs.as_ptr());\n\n        for (name, expected_found) in [(\"foo\", true), (\"FOO\", true), (\"bar\", true), (\"missing\", false)] {\n            let n = CString::new(name).unwrap();\n            let ai = c_get(pa, n.as_ptr());\n            let bi = r_get(pb, n.as_ptr());\n            assert_eq!(ai.is_null(), bi.is_null(), \"GetObjectItem mismatch for {}\", name);\n            assert_eq!(!ai.is_null(), expected_found);\n        }\n        for (name, expected_found) in [(\"foo\", true), (\"FOO\", false), (\"BAR\", true), (\"Baz\", true), (\"baz\", false)] {\n            let n = CString::new(name).unwrap();\n            let ai = c_get_cs(pa, n.as_ptr());\n            let bi = r_get_cs(pb, n.as_ptr());\n            assert_eq!(ai.is_null(), bi.is_null(), \"GetObjectItemCS mismatch for {}\", name);\n            assert_eq!(!ai.is_null(), expected_found);\n        }\n        c_delete(pa);\n        r_delete(pb);\n    }\n}\n\n#[test]\nfn test_special_floats() {\n    unsafe {\n        let p = Pair::load();\n        let c_create: Symbol<unsafe extern \"C\" fn(c_double) -> *mut CJsonRepr> = get_sym(&p.c, b\"cJSON_CreateNumber\");\n        let r_create: Symbol<unsafe extern \"C\" fn(c_double) -> *mut CJsonRepr> = get_sym(&p.r, b\"cJSON_CreateNumber\");\n        let c_print: Symbol<unsafe extern \"C\" fn(*const CJsonRepr) -> *mut c_char> = get_sym(&p.c, b\"cJSON_PrintUnformatted\");\n        let r_print: Symbol<unsafe extern \"C\" fn(*const CJsonRepr) -> *mut c_char> = get_sym(&p.r, b\"cJSON_PrintUnformatted\");\n        let c_delete: Symbol<unsafe extern \"C\" fn(*mut CJsonRepr)> = get_sym(&p.c, b\"cJSON_Delete\");\n        let r_delete: Symbol<unsafe extern \"C\" fn(*mut CJsonRepr)> = get_sym(&p.r, b\"cJSON_Delete\");\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut c_void)> = get_sym(&p.c, b\"cJSON_free\");\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut c_void)> = get_sym(&p.r, b\"cJSON_free\");\n\n        // Try lots of doubles to ensure print_number's 15-digit/17-digit fallback works the same.\n        let nums: Vec<f64> = vec![\n            0.0, 1.0, -1.0, 0.1, 0.2, 0.3, 1.0 / 3.0, 2.0 / 3.0,\n            std::f64::consts::PI, std::f64::consts::E,\n            1e-300, 1e300, -1e-300, -1e300,\n            1.234567890123456789, 1234567890.123456789,\n            f64::EPSILON, 2.0 * f64::EPSILON,\n            (i32::MAX as f64) + 0.5, (i32::MIN as f64) - 0.5,\n        ];\n     