es reallocation. fmt=0 gives unformatted, =1 gives formatted */\n125\tCJSON_PUBLIC(char *) cJSON_PrintBuffered(const cJSON *item, int prebuffer, cJSON_bool fmt);\n126\t/* Render a cJSON entity to text using a buffer already allocated in memory with given length. Returns 1 on success and 0 on failure. */\n127\t/* NOTE: cJSON is not always 100% accurate in estimating how much memory it will use, so to be safe allocate 5 bytes more than you actually need */\n128\tCJSON_PUBLIC(cJSON_bool) cJSON_PrintPreallocated(cJSON *item, char *buffer, const int length, const cJSON_bool format);\n129\t/* Delete a cJSON entity and all subentities. */\n130\tCJSON_PUBLIC(void) cJSON_Delete(cJSON *item);\n131\t\n132\t/* Returns the number of items in an array (or object). */\n133\tCJSON_PUBLIC(int) cJSON_GetArraySize(const cJSON *array);\n134\t/* Retrieve item number \"index\" from array \"array\". Returns NULL if unsuccessful. */\n135\tCJSON_PUBLIC(cJSON *) cJSON_GetArrayItem(const cJSON *array, int index);\n136\t/* Get item \"string\" from object. Case insensitive. */\n137\tCJSON_PUBLIC(cJSON *) cJSON_GetObjectItem(const cJSON * const object, const char * const string);\n138\tCJSON_PUBLIC(cJSON *) cJSON_GetObjectItemCaseSensitive(const cJSON * const object, const char * const string);\n139\tCJSON_PUBLIC(cJSON_bool) cJSON_HasObjectItem(const cJSON *object, const char *string);\n140\t/* For analysing failed parses. This returns a pointer to the parse error. You'll probably need to look a few chars back to make sense of it. Defined when cJSON_Parse() returns 0. 0 when cJSON_Parse() succeeds. */\n141\tCJSON_PUBLIC(const char *) cJSON_GetErrorPtr(void);\n142\t\n143\t/* Check item type and return its value */\n144\tCJSON_PUBLIC(char *) cJSON_GetStringValue(const cJSON * const item);\n145\tCJSON_PUBLIC(double) cJSON_GetNumberValue(const cJSON * const item);\n146\t\n147\t/* These functions check the type of an item */\n148\tCJSON_PUBLIC(cJSON_bool) cJSON_IsInvalid(const cJSON * const item);\n149\tCJSON_PUBLIC(cJSON_bool) cJSON_IsFalse(const cJSON * const item);\n150\tCJSON_PUBLIC(cJSON_bool) cJSON_IsTrue(const cJSON * const item);\n151\tCJSON_PUBLIC(cJSON_bool) cJSON_IsBool(const cJSON * const item);\n152\tCJSON_PUBLIC(cJSON_bool) cJSON_IsNull(const cJSON * const item);\n153\tCJSON_PUBLIC(cJSON_bool) cJSON_IsNumber(const cJSON * const item);\n154\tCJSON_PUBLIC(cJSON_bool) cJSON_IsString(const cJSON * const item);\n155\tCJSON_PUBLIC(cJSON_bool) cJSON_IsArray(const cJSON * const item);\n156\tCJSON_PUBLIC(cJSON_bool) cJSON_IsObject(const cJSON * const item);\n157\tCJSON_PUBLIC(cJSON_bool) cJSON_IsRaw(const cJSON * const item);\n158\t\n159\t/* These calls create a cJSON item of the appropriate type. */\n160\tCJSON_PUBLIC(cJSON *) cJSON_CreateNull(void);\n161\tCJSON_PUBLIC(cJSON *) cJSON_CreateTrue(void);\n162\tCJSON_PUBLIC(cJSON *) cJSON_CreateFalse(void);\n163\tCJSON_PUBLIC(cJSON *) cJSON_CreateBool(cJSON_bool boolean);\n164\tCJSON_PUBLIC(cJSON *) cJSON_CreateNumber(double num);\n165\tCJSON_PUBLIC(cJSON *) cJSON_CreateString(const char *string);\n166\t/* raw json */\n167\tCJSON_PUBLIC(cJSON *) cJSON_CreateRaw(const char *raw);\n168\tCJSON_PUBLIC(cJSON *) cJSON_CreateArray(void);\n169\tCJSON_PUBLIC(cJSON *) cJSON_CreateObject(void);\n170\t\n171\t/* Create a string where valuestring references a string so\n172\t * it will not be freed by cJSON_Delete */\n173\tCJSON_PUBLIC(cJSON *) cJSON_CreateStringReference(const char *string);\n174\t/* Create an object/array that only references it's elements so\n175\t * they will not be freed by cJSON_Delete */\n176\tCJSON_PUBLIC(cJSON *) cJSON_CreateObjectReference(const cJSON *child);\n177\tCJSON_PUBLIC(cJSON *) cJSON_CreateArrayReference(const cJSON *child);\n178\t\n179\t/* These utilities create an Array of count items.\n180\t * The parameter count cannot be greater than the number of elements in the number array, otherwise array access will be out of bounds.*/\n181\tCJSON_PUBLIC(cJSON *) cJSON_CreateIntArray(const int