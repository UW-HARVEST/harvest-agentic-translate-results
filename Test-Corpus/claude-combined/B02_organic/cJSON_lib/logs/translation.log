LL)\n2234\t    {\n2235\t        /* last element */\n2236\t        parent->child->prev = item->prev;\n2237\t    }\n2238\t\n2239\t    /* make sure the detached item doesn't point anywhere anymore */\n2240\t    item->prev = NULL;\n2241\t    item->next = NULL;\n2242\t\n2243\t    return item;\n2244\t}\n2245\t\n2246\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemFromArray(cJSON *array, int which)\n2247\t{\n2248\t    if (which < 0)\n2249\t    {\n2250\t        return NULL;\n2251\t    }\n2252\t\n2253\t    return cJSON_DetachItemViaPointer(array, get_array_item(array, (size_t)which));\n2254\t}\n2255\t\n2256\tCJSON_PUBLIC(void) cJSON_DeleteItemFromArray(cJSON *array, int which)\n2257\t{\n2258\t    cJSON_Delete(cJSON_DetachItemFromArray(array, which));\n2259\t}\n2260\t\n2261\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemFromObject(cJSON *object, const char *string)\n2262\t{\n2263\t    cJSON *to_detach = cJSON_GetObjectItem(object, string);\n2264\t\n2265\t    return cJSON_DetachItemViaPointer(object, to_detach);\n2266\t}\n2267\t\n2268\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemFromObjectCaseSensitive(cJSON *object, const char *string)\n2269\t{\n2270\t    cJSON *to_detach = cJSON_GetObjectItemCaseSensitive(object, string);\n2271\t\n2272\t    return cJSON_DetachItemViaPointer(object, to_detach);\n2273\t}\n2274\t\n2275\tCJSON_PUBLIC(void) cJSON_DeleteItemFromObject(cJSON *object, const char *string)\n2276\t{\n2277\t    cJSON_Delete(cJSON_DetachItemFromObject(object, string));\n2278\t}\n2279\t\n2280\tCJSON_PUBLIC(void) cJSON_DeleteItemFromObjectCaseSensitive(cJSON *object, const char *string)\n2281\t{\n2282\t    cJSON_Delete(cJSON_DetachItemFromObjectCaseSensitive(object, string));\n2283\t}\n2284\t\n2285\t/* Replace array/object items with new ones. */\n2286\tCJSON_PUBLIC(cJSON_bool) cJSON_InsertItemInArray(cJSON *array, int which, cJSON *newitem)\n2287\t{\n2288\t    cJSON *after_inserted = NULL;\n2289\t\n2290\t    if (which < 0 || newitem == NULL)\n2291\t    {\n2292\t        return false;\n2293\t    }\n2294\t\n2295\t    after_inserted = get_array_item(array, (size_t)which);\n2296\t    if (after_inserted == NULL)\n2297\t    {\n2298\t        return add_item_to_array(array, newitem);\n2299\t    }\n2300\t\n2301\t    if (after_inserted != array->child && after_inserted->prev == NULL) {\n2302\t        /* return false if after_inserted is a corrupted array item */\n2303\t        return false;\n2304\t    }\n2305\t\n2306\t    newitem->next = after_inserted;\n2307\t    newitem->prev = after_inserted->prev;\n2308\t    after_inserted->prev = newitem;\n2309\t    if (after_inserted == array->child)\n2310\t    {\n2311\t        array->child = newitem;\n2312\t    }\n2313\t    else\n2314\t    {\n2315\t        newitem->prev->next = newitem;\n2316\t    }\n2317\t    return true;\n2318\t}\n2319\t\n2320\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemViaPointer(cJSON * const parent, cJSON * const item, cJSON * replacement)\n2321\t{\n2322\t    if ((parent == NULL) || (parent->child == NULL) || (replacement == NULL) || (item == NULL))\n2323\t    {\n2324\t        return false;\n2325\t    }\n2326\t\n2327\t    if (replacement == item)\n2328\t    {\n2329\t        return true;\n2330\t    }\n2331\t\n2332\t    replacement->next = item->next;\n2333\t    replacement->prev = item->prev;\n2334\t\n2335\t    if (replacement->next != NULL)\n2336\t    {\n2337\t        replacement->next->prev = replacement;\n2338\t    }\n2339\t    if (parent->child == item)\n2340\t    {\n2341\t        if (parent->child->prev == parent->child)\n2342\t        {\n2343\t            replacement->prev = replacement;\n2344\t        }\n2345\t        parent->child = replacement;\n2346\t    }\n2347\t    else\n2348\t    {   /*\n2349\t         * To find the last item in array quickly, we use prev in array.\n2350\t         * We can't modify the last item's next pointer where this item was the parent's child\n2351\t         */\n2352\t        if (replacement->prev != NULL)\n2353\t        {\n2354\t            replacement->prev->next = replacement;\n2355\t        }\n2356\t        if (replacement->next == NULL)\n2357\t        {\n2358\t            parent->child->prev = replacement;\n2359\t        }\n2360\t    }\n2361\t\n2362\t    item->next = NULL;\n2363\t    item->prev = NULL;\n2364\t    cJSON_Delete(item);\n2365\t\n2366\t    return true;\n2367\t}\n2368\t\n2369\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemInArray(cJSON *array, int which, cJSON *newitem)\n2370\t{\n2371\t    if (which < 0)\n2372\t    {\n2373\t        return false;\n2374\t    }\n2375\t\n2376\t    return cJSON_ReplaceItemViaPointer(array, get_array_item(array, (size_t)which), newitem);\n2377\t}\n2378\t\n2379\tstatic cJSON_bool replace_item_in_object(cJSON *object, const char *string, cJSON *replacement, cJSON_bool case_sensitive)\n2380\t{\n2381\t    if ((replacement == NULL) || (string == NULL))\n2382\t    {\n2383\t        return false;\n2384\t    }\n2385\t\n2386\t    /* replace the name in the replacement */\n2387\t    if (!(replacement->type & cJSON_StringIsConst) && (replacement->string != NULL))\n2388\t    {\n2389\t        cJSON_free(replacement->string);\n2390\t    }\n2391\t    replacement->string = (char*)cJSON_strdup((const unsigned char*)string, &global_hooks);\n2392\t    if (replacement->string == NULL)\n2393\t    {\n2394\t        return false;\n2395\t    }\n2396\t\n2397\t    replacement->type &= ~cJSON_StringIsConst;\n2398\t\n2399\t    return cJSON_ReplaceItemViaPointer(object, get_object_item(object, string, case_sensitive), replacement);\n2400\t}\n2401\t\n2402\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemInObject(cJSON *object, const char *string, cJSON *newitem)\n2403\t{\n2404\t    return replace_item_in_object(object, string, newitem, false);\n2405\t}\n2406\t\n2407\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemInObjectCaseSensitive(cJSON *object, const char *string, cJSON *newitem)\n2408\t{\n2409\t    return replace_item_in_object(object, string, newitem, true);\n2410\t}\n2411\t\n2412\t/* Create basic types: */\n2413\tCJSON_PUBLIC(