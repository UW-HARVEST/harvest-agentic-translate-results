{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_5hn3scfpqgefvylf27xisv57i6u6k5p6ynxgj5q3aoskaewvobna","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01KM41pr5nTBLvqaSWAShj7T","name":"Write","input":{"file_path":"/tmp/harvest-translate-7T6x6w/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::ffi::{c_char, CString};\nuse std::path::PathBuf;\n\ntype CustomStrdupFn = unsafe extern \"C\" fn(*const c_char) -> *mut c_char;\n\nfn c_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src/build/libdriver.so\");\n    p\n}\n\nfn rust_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target/release/libdriver.so\");\n    p\n}\n\nunsafe fn call_custom_strdup(lib: &Library, input: *const c_char) -> *mut c_char {\n    let func: Symbol<CustomStrdupFn> = lib.get(b\"custom_strdup\").expect(\"symbol exists\");\n    func(input)\n}\n\nunsafe fn collect_bytes(ptr: *const c_char) -> Option<Vec<u8>> {\n    if ptr.is_null() {\n        return None;\n    }\n    let mut bytes = Vec::new();\n    let mut i = 0;\n    loop {\n        let b = *ptr.add(i) as u8;\n        bytes.push(b);\n        if b == 0 {\n            break;\n        }\n        i += 1;\n    }\n    Some(bytes)\n}\n\nextern \"C\" {\n    fn free(p: *mut std::ffi::c_void);\n}\n\n#[test]\nfn test_custom_strdup_basic() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load C lib\");\n        let rust_lib = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n\n        let inputs: &[&[u8]] = &[\n            b\"hello\\0\",\n            b\"\\0\",\n            b\"a\\0\",\n            b\"The quick brown fox\\0\",\n            b\"with \\xff binary \\x01 bytes\\0\",\n        ];\n\n        for input in inputs {\n            let c_result = call_custom_strdup(&c_lib, input.as_ptr() as *const c_char);\n            let rust_result = call_custom_strdup(&rust_lib, input.as_ptr() as *const c_char);\n\n            let c_bytes = collect_bytes(c_result);\n            let rust_bytes = collect_bytes(rust_result);\n\n            assert_eq!(c_bytes, rust_bytes, \"outputs differ for input {:?}\", input);\n            assert_eq!(c_bytes.as_deref(), Some(*input), \"C output mismatch\");\n\n            if !c_result.is_null() {\n                free(c_result as *mut std::ffi::c_void);\n            }\n            if !rust_result.is_null() {\n                free(rust_result as *mut std::ffi::c_void);\n            }\n        }\n    }\n}\n\n#[test]\nfn test_custom_strdup_null() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load C lib\");\n        let rust_lib = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n\n        let c_result = call_custom_strdup(&c_lib, std::ptr::null());\n        let rust_result = call_custom_strdup(&rust_lib, std::ptr::null());\n\n        assert!(c_result.is_null(), \"C should return null for null input\");\n        assert!(rust_result.is_null(), \"Rust should return null for null input\");\n    }\n}\n\n#[test]\nfn test_custom_strdup_long_string() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load C lib\");\n        let rust_lib = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n\n        let long = \"a\".repeat(10_000);\n        let cstr = CString::new(long.clone()).unwrap();\n\n        let c_result = call_custom_strdup(&c_lib, cstr.as_ptr());\n        let rust_result = call_custom_strdup(&rust_lib, cstr.as_ptr());\n\n        let c_bytes = collect_bytes(c_result);\n        let rust_bytes = collect_bytes(rust_result);\n\n        assert_eq!(c_bytes, rust_bytes);\n        assert!(c_bytes.is_some());\n        assert_eq!(c_bytes.unwrap().len(), 10_001);\n\n        if !c_result.is_null() {\n            free(c_result as *mut std::ffi::c_void);\n        }\n        if !rust_result.is_null() {\n            free(rust_result as *mut std::ffi::c_void);\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":160,"cache_read_input_tokens":17365,"cache_creation":{"ephemeral_5m_input_tokens":160,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d30a80a5-e56c-48ae-964e-82ae415af70e","uuid":"ff7c8bef-4f15-4d4b-988a-a9ad770eb280"}
