5\t\n106\t#[inline]\n107\tfn c2Norm(a: c2v) -> c2v {\n108\t    c2Div(a, c2Len(a))\n109\t}\n110\t\n111\t#[inline]\n112\tfn c2Minv(a: c2v, b: c2v) -> c2v {\n113\t    c2V(\n114\t        if a.x < b.x { a.x } else { b.x },\n115\t        if a.y < b.y { a.y } else { b.y },\n116\t    )\n117\t}\n118\t\n119\t#[inline]\n120\tfn c2Maxv(a: c2v, b: c2v) -> c2v {\n121\t    c2V(\n122\t        if a.x > b.x { a.x } else { b.x },\n123\t        if a.y > b.y { a.y } else { b.y },\n124\t    )\n125\t}\n126\t\n127\t#[inline]\n128\tfn c2Skew(a: c2v) -> c2v {\n129\t    c2v { x: -a.y, y: a.x }\n130\t}\n131\t\n132\t#[inline]\n133\tfn c2Absv(a: c2v) -> c2v {\n134\t    c2V(\n135\t        if a.x < 0.0 { -a.x } else { a.x },\n136\t        if a.y < 0.0 { -a.y } else { a.y },\n137\t    )\n138\t}\n139\t\n140\t#[inline]\n141\tfn c2CCW90(a: c2v) -> c2v {\n142\t    c2v { x: a.y, y: -a.x }\n143\t}\n144\t\n145\t#[inline]\n146\tfn c2MulmvT(a: c2m, b: c2v) -> c2v {\n147\t    c2v {\n148\t        x: a.x.x * b.x + a.x.y * b.y,\n149\t        y: a.y.x * b.x + a.y.y * b.y,\n150\t    }\n151\t}\n152\t\n153\tfn c2RaytoCircle(A: c2Ray, B: c2Circle, out: &mut c2Raycast) -> i32 {\n154\t    let p = B.p;\n155\t    let m = c2Sub(A.p, p);\n156\t    let c = c2Dot(m, m) - B.r * B.r;\n157\t    let b = c2Dot(m, A.d);\n158\t    let disc = b * b - c;\n159\t    if disc < 0.0 {\n160\t        return 0;\n161\t    }\n162\t    let t = -b - disc.sqrt();\n163\t    if t >= 0.0 && t <= A.t {\n164\t        out.t = t;\n165\t        let impact = c2Add(A.p, c2Mulvs(A.d, t));\n166\t        out.n = c2Norm(c2Sub(impact, p));\n167\t        return 1;\n168\t    }\n169\t    0\n170\t}\n171\t\n172\tfn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> i32 {\n173\t    let d0 = (B.max.x < A.min.x) as i32;\n174\t    let d1 = (A.max.x < B.min.x) as i32;\n175\t    let d2 = (B.max.y < A.min.y) as i32;\n176\t    let d3 = (A.max.y < B.min.y) as i32;\n177\t    (!((d0 | d1 | d2 | d3) != 0)) as i32\n178\t}\n179\t\n180\t#[inline]\n181\tfn c2SignedDistPointToPlane_OneDimension