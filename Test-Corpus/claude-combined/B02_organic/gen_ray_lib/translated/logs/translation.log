= PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    manifest.join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    manifest.join(\"target/release/libtranslated_rust.so\")\n}\n\nunsafe fn load_libs() -> (Library, Library) {\n    unsafe {\n        let c = Library::new(c_lib_path()).expect(\"failed to load C lib\");\n        let r = Library::new(rust_lib_path()).expect(\"failed to load Rust lib\");\n        (c, r)\n    }\n}\n\nfn assert_raycast_eq(a: &C2Raycast, b: &C2Raycast, ctx: &str) {\n    let abits = (a.t.to_bits(), a.n.x.to_bits(), a.n.y.to_bits());\n    let bbits = (b.t.to_bits(), b.n.x.to_bits(), b.n.y.to_bits());\n    assert_eq!(\n        abits, bbits,\n        \"raycast mismatch ({}): C={:?} Rust={:?}\",\n        ctx, a, b\n    );\n}\n\n#[test]\nfn test_c2v_and_basic_vec_ops() {\n    unsafe {\n        let (c, r) = load_libs();\n\n        type FnVV = unsafe extern \"C\" fn(f32, f32) -> C2v;\n        let cv: Symbol<FnVV> = c.get(b\"c2V\").unwrap();\n        let rv: Symbol<FnVV> = r.get(b\"c2V\").unwrap();\n\n        for &(x, y) in &[(0.0, 0.0), (1.0, -2.0), (3.5, 4.5), (-1.0e6, 1.0e6)] {\n            let a = cv(x, y);\n            let b = rv(x, y);\n            assert_eq!(a.x.to_bits(), b.x.to_bits());\n            assert_eq!(a.y.to_bits(), b.y.to_bits());\n        }\n\n        type FnDot = unsafe extern \"C\" fn(C2v, C2v) -> f32;\n        let cdot: Symbol<FnDot> = c.get(b\"c2Dot\").unwrap();\n        let rdot: Symbol<FnDot> = r.get(b\"c2Dot\").unwrap();\n\n        for &(ax, ay, bx, by) in &[\n            (1.0f32, 2.0, 3.0, 4.0),\n            (-1.0, 2.0, 0.5, -0.5),\n            (1e10, 2.0, 1e-10, 1.0),\n        ] {\n            let av = C2v { x: ax, y: ay };\n            let bv = C2v { x: bx, y: by };\n            assert_eq!(cdot(av, bv).to_bits(), rdot(av, bv).to_bits());\n        }\n\n        type FnLen = unsafe extern \"C\" fn(C2v) -> f32;\n        let cl: Symbol<FnLen> = c.get(b\"c2Len\").unwrap();\n        let rl: Symbol<FnLen> = r.get(b\"c2Len\").unwrap();\n        for &(x, y) in &[(3.0f32, 4.0), (1.0, 1.0), (-5.0, 12.0)] {\n            assert_eq!(\n                cl(C2v { x, y }).to_bits(),\n                rl(C2v { x, y }).to_bits()\n            );\n        }\n\n        type FnVecVec = unsafe extern \"C\" fn(C2v, C2v) -> C2v;\n        for sym in &[&b\"c2Add\"[..], &b\"c2Sub\"[..], &b\"c2Minv\"[..], &b\"c2Maxv\"[..]] {\n            let f: Symbol<FnVecVec> = c.get(sym).unwrap();\n            let g: Symbol<FnVecVec> = r.get(sym).unwrap();\n            for &(ax, ay, bx, by) in &[\n                (1.0f32, 2.0, 3.0, 4.0),\n                (-1.0, -2.0, 1.0, 0.5),\n                (5.0, -1.0, -3.0, 2.5),\n            ] {\n                let a = C2v { x: ax, y: ay };\n                let b = C2v { x: bx, y: by };\n                let r1 = f(a, b);\n                let r2 = g(a, b);\n                assert_eq!(r1.x.to_bits(), r2.x.to_bits(), \"{:?}\", sym);\n                assert_eq!(r1.y.to_bits(), r2.y.to_bits(), \"{:?}\", sym);\n            }\n        }\n\n        type FnVecScalar = unsafe extern \"C\" fn(C2v, f32) -> C2v;\n        for sym in &[b\"c2Mulvs\", b\"c2Div\"] {\n            let f: Symbol<FnVecScalar> = c.get(*sym).unwrap();\n            let g: Symbol<FnVecScalar> = r.get(*sym).unwrap();\n            for &(x, y, s) in &[(1.0f32, 2.0, 3.0), (-1.0, 0.5, -2.0)] {\n                let a = C2v { x, y };\n                let r1 = f(a, s);\n                let r2 = g(a, s);\n                assert_eq!(r1.x.to_bits(), r2.x.to_bits());\n                assert_eq!(r1.y.to_bits(), r2.y.to_bits());\n            }\n        }\n\n        type FnVec = unsafe extern \"C\" fn(C2v) -> C2v;\n        for sym in &[b\"c2Norm\", b\"c2Skew\", b\"c2Absv\", b\"c2CCW90\"] {\n            let f: Symbol<FnVec> = c.get(*sym).unwrap();\n            let g: Symbol<FnVec> = r.get(*sym).unwrap();\n            for &(x, y) in &[(3.0f32, 4.0), (-1.0, 2.0), (0.0, 5.0), (-3.0, -4.0)] {\n                let a = C2v { x, y };\n                let r1 = f(a);\n                let r2 = g(a);\n                assert_eq!(r1.x.to_bits(), r2.x.to_bits(), \"{:?} x\", sym);\n                assert_eq!(r1.y.to_bits(), r2.y.to_bits(), \"{:?} y\", sym);\n            }\n        }\n\n        type FnMV = unsafe extern \"C\" fn(C2m, C2v) -> C2v;\n        let cmv: Symbol<FnMV> = c.get(b\"c2MulmvT\").unwrap();\n        let rmv: Symbol<FnMV> = r.get(b\"c2MulmvT\").unwrap();\n        let m = C2m {\n            x: C2v { x: 0.5, y: -0.5 },\n            y: C2v { x: 0.7, y: 0.7 },\n        };\n        let v = C2v { x: 1.0, y: 2.0 };\n        let r1 = cmv(m, v);\n        let r2 = rmv(m, v);\n        assert_eq!(r1.x.to_bits(), r2.x.to_bits());\n        assert_eq!(r1.y.to_bits(), r2.y.to_bits());\n    }\n}\n\n#[test]\nfn test_aabb_circle_predicates() {\n    unsafe {\n        let (c, r) = load_libs();\n\n        type FnAA = unsafe extern \"C\" fn(C2AABB, C2AABB) -> i32;\n        let f: Symbol<FnAA> = c.get(b\"c2AABBtoAABB\").unwrap();\n        let g: Symbol<FnAA> = r.get(b\"c2AABBtoAABB\").unwrap();\n        let cases = [\n            (\n                C2AABB {\n                    min: C2v { x: 0.0, y: 0.0 },\n                    max: C2v { x: 2.0, y: 2.0 },\n                },\n                C2AABB {\n                    min: C2v { x: 1.0, y: 1.0 },\n                    max: C2v { x: 3.0, y: 3.0 },\n                },\n            ),\n            (\n                C2AABB {\n                    min: C2v { x: 0.0, y: 0.0 },\n                    max: C2v { x: 1.0, y: 1.0 },\n                },\n                C2AABB {\n                    min: C2v { x: 2.0, y: 2.0 },\n                    max: C2v { x: 3.0, y: 3.0 },\n                },\n            ),\n        ];\n        for (a, b) in cases {\n            assert_eq!(f(a, b), g(a, b));\n        }\n\n        type FnAP = unsafe extern \"C\" fn(C2AABB, C2v) -> i32;\n        let f: Symbol<FnAP> = c.get(b\"c2AABBtoPoint\").unwrap();\n        let g: Symbol<FnAP> = r.get(b\"c2AABBtoPoint\").unwrap();\n        let aabb = C2AABB {\n            min: C2v { x: 0.0, y: 0.0 },\n            max: C2v { x: 5.0, y: 5.0 },\n        };\n        for (px, py) in [(2.0, 3.0), (-1.0, 0.0), (5.5, 5.5), (5.0, 5.0)] {\n            let p = C2v { x: px, y: py };\n            assert_eq!(f(aabb, p), g(aabb, p));\n        }\n\n        type FnCP = unsafe extern \"C\" fn(C2Circle, C2v) -> i32;\n        let f: Symbol<FnCP> = c.get(b\"c2CircleToPoint\").unwrap();\n        let g: Symbol<FnCP> = r.get(b\"c2CircleToPoint\").unwrap();\n        let circle = C2Circle {\n            p: C2v { x: 0.0, y: 0.0 },\n            r: 2.0,\n        };\n        for (px, py) in [(0.0, 0.0), (1.0, 1.0), (3.0, 0.0), (2.0, 0.0)] {\n            let p = C2v { x: px, y: py };\n            assert_eq!(f(circle, p), g(circle, p));\n        }\n    }\n}\n\n#[test]\nfn test_ray_to_circle() {\n    unsafe {\n        let (c, r) = load_libs();\n        type Fn1 = unsafe extern \"C\" fn(C2Ray, C2Circle, *mut C2Raycast) -> i32;\n        let f: Symbol<Fn1> = c.get(b\"c2RaytoCircle\").unwrap();\n        let g: Symbol<Fn1> = r.get(b\"c2RaytoCircle\").unwrap();\n\n        let cases = [\n            (\n                // direct hit\n                C2Ray {\n                    p: C2v { x: -5.0, y: 0.0 },\n                    d: C2v { x: 1.0, y: 0.0 },\n                    t: 100.0,\n                },\n                C2Circle {\n                    p: C2v { x: 0.0, y: 0.0 },\n                    r: 1.0,\n                },\n            ),\n            (\n                // miss\n                C2Ray {\n                    p: C2v { x: -5.0, y: 5.0 },\n                    d: C2v { x: 1.0, y: 0.0 },\n                    t: 100.0,\n                },\n                C2Circle {\n                    p: C2v { x: 0.0, y: 0.0 },\n                    r: 1.0,\n                },\n            ),\n            (\n                // ray ends short\n                C2Ray {\n                    p: C2v { x: -5.0, y: 0.0 },\n                    d: C2v { x: 1.0, y: 0.0 },\n                    t: 1.0,\n                },\n                C2Circle {\n                    p: C2v { x: 0.0, y: 0.0 },\n                    r: 1.0,\n                },\n            ),\n        ];\n        for (ray, circle) in cases {\n            let mut o1 = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut o2 = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let r1 = f(ray, circle, &mut o1);\n            let r2 = g(ray, circle, &mut o2);\n            assert_eq!(r1, r2);\n            if r1 != 0 {\n                assert_raycast_eq(&o1, &o2, \"RaytoCircle\");\n            }\n        }\n    }\n}\n\n#[test]\nfn test_ray_to_aabb() {\n    unsafe {\n        let (c, r) = load_libs();\n        type Fn1 = unsafe extern \"C\" fn(C2Ray, C2AABB, *mut C2Raycast) -> i32;\n        let f: Symbol<Fn1> = c.get(b\"c2RaytoAABB\").unwrap();\n        let g: Symbol<Fn1> = r.get(b\"c2RaytoAABB\").unwrap();\n\n        let aabb = C2AABB {\n            min: C2v { x: -1.0, y: -1.0 },\n            max: C2v { x: 1.0, y: 1.0 },\n        };\n        let cases = [\n            (\n                C2Ray {\n                    p: C2v { x: -5.0, y: 0.0 },\n                    d: C2v { x: 1.0, y: 0.0 },\n                    t: 100.0,\n                },\n                aabb,\n            ),\n            (\n                C2Ray {\n                    p: C2v { x: 0.0, y: -5.0 },\n                    d: C2v { x: 0.0, y: 1.0 },\n                    t: 100.0,\n                },\n                aabb,\n            ),\n            (\n                C2Ray {\n                    p: C2v { x: -5.0, y: 5.0 },\n                    d: C2v { x: 1.0, y: 0.0 },\n                    t: 100.0,\n                },\n                aabb,\n            ),\n            (\n                C2Ray {\n                    p: C2v { x: -5.0, y: -5.0 },\n                    d: C2v {\n                        x: 0.7071,\n                        y: 0.7071,\n                    },\n                    t: 100.0,\n                },\n                aabb,\n            ),\n        ];\n        for (ray, b) in cases {\n            let mut o1 = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut o2 = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let r1 = f(ray, b, &mut o1);\n            let r2 = g(ray, b, &mut o2);\n            assert_eq!(r1, r2);\n            if r1 != 0 {\n                assert_raycast_eq(&o1, &o2, \"RaytoAABB\");\n            }\n        }\n    }\n}\n\n#[test]\nfn test_ray_to_capsule() {\n    unsafe {\n        let (c, r) = load_libs();\n        type Fn1 = unsafe extern \"C\" fn(C2Ray, C2Capsule, *mut C2Raycast) -> i32;\n        let f: Symbol<Fn1> = c.get(b\"c2RaytoCapsule\").unwrap();\n        let g: Symbol<Fn1> = r.get(b\"c2RaytoCapsule\").unwrap();\n\n        let cap = C2Capsule {\n            a: C2v { x: 0.0, y: 0.0 },\n            b: C2v { x: 0.0, y: 5.0 },\n            r: 1.0,\n        };\n        let cases = [\n            // hit straight through middle\n            C2Ray {\n                p: C2v { x: -5.0, y: 2.5 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 100.0,\n            },\n            // miss\n            C2Ray {\n                p: C2v { x: -5.0, y: 10.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 100.0,\n            },\n            // hit hemisphere top\n            C2Ray {\n                p: C2v { x: -5.0, y: 5.5 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 100.0,\n            },\n            // hit hemisphere bottom\n            C2Ray {\n                p: C2v { x: -5.0, y: -0.5 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 100.0,\n            },\n            // ray from inside\n            C2Ray {\n                p: C2v { x: 0.0, y: 2.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 100.0,\n            },\n        ];\n        for ray in cases {\n            let mut o1 = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut o2 = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let r1 = f(ray, cap, &mut o1);\n            let r2 = g(ray, cap, &mut o2);\n            assert_eq!(r1, r2, \"ray={:?}\", (ray.p.x, ray.p.y));\n            assert_raycast_eq(&o1, &o2, \"RaytoCapsule (out written even on miss)\");\n        }\n    }\n}\n\n#[test]\nfn test_cast_ray_dispatch() {\n    unsafe {\n        let (c, r) = load_libs();\n        type FnCast = unsafe extern \"C\" fn(C2Ray, *const std::ffi::c_void, i32, *mut C2Raycast) -> i32;\n        let f: Symbol<FnCast> = c.get(b\"c2CastRay\").unwrap();\n        let g: Symbol<FnCast> = r.get(b\"c2CastRay\").unwrap();\n\n        let ray = C2Ray {\n            p: C2v { x: -5.0, y: 0.0 },\n            d: C2v { x: 1.0, y: 0.0 },\n            t: 100.0,\n        };\n        let circle = C2Circle {\n            p: C2v { x: 0.0, y: 0.0 },\n            r: 1.0,\n        };\n        let mut o1 = C2Raycast {\n            t: 0.0,\n            n: C2v { x: 0.0, y: 0.0 },\n        };\n        let mut o2 = C2Raycast {\n            t: 0.0,\n            n: C2v { x: 0.0, y: 0.0 },\n        };\n        let r1 = f(ray, &circle as *const _ as *const _, 0, &mut o1);\n        let r2 = g(ray, &circle as *const _ as *const _, 0, &mut o2);\n        assert_eq!(r1, r2);\n        assert_raycast_eq(&o1, &o2, \"CastRay circle\");\n\n        let aabb = C2AABB {\n            min: C2v { x: -1.0, y: -1.0 },\n            max: C2v { x: 1.0, y: 1.0 },\n        };\n        let r1 = f(ray, &aabb as *const _ as *const _, 1, &mut o1);\n        let r2 = g(ray, &aabb as *const _ as *const _, 1, &mut o2);\n        assert_eq!(r1, r2);\n        assert_raycast_eq(&o1, &o2, \"CastRay aabb\");\n\n        let cap = C2Capsule {\n            a: C2v { x: 0.0, y: 0.0 },\n            b: C2v { x: 0.0, y: 5.0 },\n            r: 1.0,\n        };\n        let r1 = f(ray, &cap as *const _ as *const _, 2, &mut o1);\n        let r2 = g(ray, &cap as *const _ as *const _, 2, &mut o2);\n        assert_eq!(r1, r2);\n        assert_raycast_eq(&o1, &o2, \"CastRay capsule\");\n    }\n}\n\n#[test]\nfn test_gen_ray() {\n    unsafe {\n        let (c, r) = load_libs();\n        type FnGen = unsafe extern \"C\" fn(\n            *mut C2Raycast,\n            *mut C2Raycast,\n            *mut C2Raycast,\n            f32, f32, f32, f32,\n            f32, f32, f32,\n            f32, f32, f32, f32, f32,\n            f32, f32, f32, f32,\n        ) -> i32;\n        let f: Symbol<FnGen> = c.get(b\"gen_ray\").unwrap();\n        let g: Symbol<FnGen> = r.get(b\"gen_ray\").unwrap();\n\n        let scenarios: &[(f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32)] = &[\n            // mp_x, mp_y, r_p_x, r_p_y, c_p_x, c_p_y, c_r, cap_a_x, cap_a_y, cap_b_x, cap_b_y, cap_r, bb_min_x, bb_min_y, bb_max_x, bb_max_y\n            (10.0, 0.0, -5.0, 0.0, 0.0, 0.0, 1.0,  20.0, 0.0,  20.0, 5.0, 1.0,  -100.0, -100.0, -50.0, -50.0),\n            (10.0, 5.0, 0.0, 0.0, 5.0, 5.0, 2.0,  3.0, 0.0,   3.0, 8.0, 1.0,  8.0, 3.0, 12.0, 7.0),\n            (5.0, 0.0, -10.0, 0.0, 0.0, 0.0, 1.0,  3.0, -2.0,  3.0, 2.0, 0.5,  -1.0, -1.0, 1.0, 1.0),\n            (-3.0, -4.0, 7.0, 8.0, 1.0, 2.0, 0.7,  -1.0, 0.0,  0.0, -1.0, 0.3,  -2.0, -3.0, 0.0, 1.0),\n            (0.0, 10.0, 0.0, -10.0, 0.5, 0.5, 1.5,  -1.0, 5.0, 1.0, 5.0, 0.5,  -2.0, 7.0, 2.0, 9.0),\n        ];\n\n        for s in scenarios {\n            let mut o1 = [C2Raycast { t: 0.0, n: C2v { x: 0.0, y: 0.0 } }; 3];\n            let mut o2 = [C2Raycast { t: 0.0, n: C2v { x: 0.0, y: 0.0 } }; 3];\n            let r1 = f(\n                &mut o1[0], &mut o1[1], &mut o1[2],\n                s.0, s.1, s.2, s.3,\n                s.4, s.5, s.6,\n                s.7, s.8, s.9, s.10, s.11,\n                s.12, s.13, s.14, s.15,\n            );\n            let r2 = g(\n                &mut o2[0], &mut o2[1], &mut o2[2],\n                s.0, s.1, s.2, s.3,\n                s.4, s.5, s.6,\n                s.7, s.8, s.9, s.10, s.11,\n                s.12, s.13, s.14, s.15,\n            );\n            assert_eq!(r1, r2, \"gen_ray return mismatch for {:?}\", s);\n            for i in 0..3 {\n                assert_raycast_eq(&o1[i], &o2[i], &format!(\"gen_ray cast{}\", i + 1));\n            }\n        }\n    }\n}\n","structuredPatch":[{"oldStart":148,"oldLines":9,"newStart":148,"newLines":9,"lines":["         }"," ","         type FnVecScalar = unsafe extern \"C\" fn(C2v, f32) -> C2v;","-        for sym in &[b\"c2Mulvs\", b\"c2Div\"] {","-            let f: Symbol<FnVecScalar> = c.get(*sym).unwrap();","-            let g: Symbol<FnVecScalar> = r.get(*sym).unwrap();","+        for sym in &[&b\"c2Mulvs\"[..], &b\"c2Div\"[..]] {","+            let f: Symbol<FnVecScalar> = c.get(sym).unwrap();","+            let g: Symbol<FnVecScalar> = r.get(sym).unwrap();","             for &(x, y, s) in &[(1.0f32, 2.0, 3.0), (-1.0, 0.5, -2.0)] {","                 let a = C2v { x, y };","                 let r1 = f(a, s);"]}],"userModified":false,"replaceAll":false}}
