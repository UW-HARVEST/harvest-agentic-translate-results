(p1.x, 1.0f32, B.max.x);\n239\t    let da2 = c2SignedDistPointToPlane_OneDimensional(p0.y, -1.0f32, B.min.y);\n240\t    let db2 = c2SignedDistPointToPlane_OneDimensional(p1.y, -1.0f32, B.min.y);\n241\t    let da3 = c2SignedDistPointToPlane_OneDimensional(p0.y, 1.0f32, B.max.y);\n242\t    let db3 = c2SignedDistPointToPlane_OneDimensional(p1.y, 1.0f32, B.max.y);\n243\t    let mut t0 = c2RayToPlane_OneDimensional(da0, db0);\n244\t    let mut t1 = c2RayToPlane_OneDimensional(da1, db1);\n245\t    let mut t2 = c2RayToPlane_OneDimensional(da2, db2);\n246\t    let mut t3 = c2RayToPlane_OneDimensional(da3, db3);\n247\t    let hit0 = (t0 <= 1.0f32) as i32;\n248\t    let hit1 = (t1 <= 1.0f32) as i32;\n249\t    let hit2 = (t2 <= 1.0f32) as i32;\n250\t    let hit3 = (t3 <= 1.0f32) as i32;\n251\t    let hit = hit0 | hit1 | hit2 | hit3;\n252\t    if hit != 0 {\n253\t        t0 = (hit0 as f32) * t0;\n254\t        t1 = (hit1 as f32) * t1;\n255\t        t2 = (hit2 as f32) * t2;\n256\t        t3 = (hit3 as f32) * t3;\n257\t        if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n258\t            out.t = t0 * A.t;\n259\t            out.n = c2V(-1.0, 0.0);\n260\t        } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n261\t            out.t = t1 * A.t;\n262\t            out.n = c2V(1.0, 0.0);\n263\t        } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n264\t            out.t = t2 * A.t;\n265\t            out.n = c2V(0.0, -1.0);\n266\t        } else {\n267\t            out.t = t3 * A.t;\n268\t            out.n = c2V(0.0, 1.0);\n269\t        }\n270\t        1\n271\t    } else {\n272\t        0\n273\t    }\n274\t}\n275\t\n276\tfn c2RaytoCapsule(A: c2Ray, B: c2Capsule, out: &mut c2Raycast) -> i32 {\n277\t    let mut M = c2m {\n278\t        x: c2v { x: 0.0, y: 0.0 },\n279\t        y: c2v { x: 0.0, y: 0.0 },\n280\t    };\n281\t    M.y = c2Norm(c2Sub(B.b, B.a));\n282\t    M.x = c2CCW90(M.y);\n283\t    let cap_n = c2Sub(B.b, B.a);\n284\t    let yBb = c2MulmvT(M, cap_n);\n285\t    let yAp = c2MulmvT(M, c2Sub(A.p, B.a));\n286\t    let yAd = c2MulmvT(M, A.d);\n287\t    let yAe = c2Add(yAp, c2Mulvs(yAd, A.t));\n288\t    let capsule_bb = c2AABB {\n289\t        min: c2V(-B.r, 0.0),\n290\t        max: c2V(B.r, yBb.y),\n291\t    };\n292\t    out.n = c2Norm(cap_n);\n293\t    out.t = 0.0;\n294\t    if c2AABBtoPoint(capsule_bb, yAp) != 0 {\n295\t        return 1;\n296\t    } else {\n297\t        let capsule_a = c2Circle { p: B.a, r: B.r };\n298\t        let capsule_b = c2Circle { p: B.b, r: B.r };\n299\t        if c2CircleToPoint(capsule_a, A.p) != 0 {\n300\t            return 1;\n301\t        } else if c2CircleToPoint(capsule_b, A.p) != 0 {\n302\t            return 1;\n303\t        }\n304\t    }\n305\t\n306\t    let abs_yAe_x = if yAe.x < 0.0 { -yAe.x } else { yAe.x };\n307\t    let abs_yAp_x = if yAp.x < 0.0 { -yAp.x } else { yAp.x };\n308\t    let min_abs = if abs_yAe_x < abs_yAp_x {\n309\t        abs_yAe_x\n310\t    } else {\n311\t        abs_yAp_x\n312\t    };\n313\t\n314\t    if yAe.x * yAp.x < 0.0 || min_abs < B.r {\n315\t        let Ca = c2Circle { p: B.a, r: B.r };\n316\t        let Cb = c2Circle { p: B.b, r: B.r };\n317\t        if abs_yAp_x < B.r {\n318\t            if yAp.y < 0.0 {\n319\t                return c2RaytoCircle(A, Ca, out);\n320\t            } else {\n321\t                return c2RaytoCircle(A, Cb, out);\n322\t            }\n323\t        } else {\n324\t            let c = if yAp.x > 0.0 { B.r } else { -B.r };\n325\t            let d = yAe.x - yAp.x;\n326\t            let t = (c - yAp.x) / d;\n327\t            let y = yAp.y + (yAe.y - yAp.y) * t;\n328\t            if y <= 0.0 {\n329\t                return c2RaytoCircle(A, Ca, out);\n330\t            }\n331\t            if y >= yBb.y {\n332\t                return c2RaytoCircle(A, Cb, out);\n333\t            } else {\n334\t                out.n = if c > 0.0 { M.x } else { c2Skew(M.y) };\n335\t                out.t = t * A.t;\n336\t                return 1;\n337\t            }\n338\t        }\n339\t    }\n