Symbol<unsafe extern \"C\" fn(c_int)> = c.get(b\"arr_ins\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int)> = r.get(b\"arr_ins\").unwrap();\n        // arr_ins doesn't return anything visible — just must not crash\n        // Run for various inputs\n        for n in [-100i32, -1, 0, 1, 5, 42, 100, 999] {\n            c_fn(n);\n            r_fn(n);\n        }\n    }\n}\n\n#[test]\nfn test_stbds_hash_string() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, usize) -> usize> =\n            c.get(b\"stbds_hash_string\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, usize) -> usize> =\n            r.get(b\"stbds_hash_string\").unwrap();\n\n        let strs: &[&[u8]] = &[\n            b\"\\0\",\n            b\"a\\0\",\n            b\"hello\\0\",\n            b\"the quick brown fox\\0\",\n            b\"\\xff\\xfe\\xfd\\0\",\n            b\"abcdefghijklmnopqrstuvwxyz0123456789\\0\",\n        ];\n        for s in strs {\n            for seed in [0usize, 1, 0xdeadbeef, 0x31415926, usize::MAX] {\n                let mut buf: Vec<u8> = s.to_vec();\n                let cv = c_fn(buf.as_mut_ptr(), seed);\n                let rv = r_fn(buf.as_mut_ptr(), seed);\n                assert_eq!(cv, rv, \"hash_string({:?}, {:#x}) mismatch\", s, seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn test_stbds_hash_bytes() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize> =\n            c.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize> =\n            r.get(b\"stbds_hash_bytes\").unwrap();\n\n        let datas: &[&[u8]] = &[\n            b\"\",\n            b\"a\",\n            b\"ab\",\n            b\"abc\",\n            b\"abcd\",\n            b\"abcde\",\n            b\"abcdef\",\n            b\"abcdefg\",\n            b\"abcdefgh\",\n            b\"abcdefghi\",\n            b\"abcdefghijklmnopqrstuvwxyz\",\n            &[0xff; 16],\n            &[0x80; 8],\n            &[0x80, 0x80, 0x80, 0x80],\n        ];\n        for d in datas {\n            for seed in [0usize, 1, 0xdeadbeef, 0x31415926] {\n                let mut buf: Vec<u8> = d.to_vec();\n                let cv = c_fn(buf.as_mut_ptr() as *mut c_void, buf.len(), seed);\n                let rv = r_fn(buf.as_mut_ptr() as *mut c_void, buf.len(), seed);\n                assert_eq!(cv, rv, \"hash_bytes({:?}, len={}, seed={:#x})\", d, buf.len(), seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn test_stbds_arrgrowf_basic() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void> =\n            c.get(b\"stbds_arrgrowf\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void> =\n            r.get(b\"stbds_arrgrowf\").unwrap();\n\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut c_void)> = c.get(b\"stbds_arrfreef\").unwrap();\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut c_void)> = r.get(b\"stbds_arrfreef\").unwrap();\n\n        // First call: grow new array of int (elemsize=4), addlen=0, min_cap=1\n        let cp = c_fn(std::ptr::null_mut(), 4, 0, 1);\n        let rp = r_fn(std::ptr::null_mut(), 4, 0, 1);\n        let ch = header(cp);\n        let rh = header(rp);\n        assert_eq!((*ch).length, (*rh).length);\n        assert_eq!((*ch).capacity, (*rh).capacity);\n        // length should be 0, capacity should be 4 (min from 4)\n        assert_eq!((*ch).length, 0);\n        assert_eq!((*ch).capacity, 4);\n\n        // Grow more\n        let cp = c_fn(cp, 4, 5, 0);\n        let rp = r_fn(rp, 4, 5, 0);\n        assert_eq!((*header(cp)).capacity, (*header(rp)).capacity);\n\n        c_free(cp);\n        r_free(rp);\n    }\n}\n\n#[test]\nfn test_stbds_rand_seed() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_set: Symbol<unsafe extern \"C\" fn(usize)> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_set: Symbol<unsafe extern \"C\" fn(usize)> = r.get(b\"stbds_rand_seed\").unwrap();\n        // Just call it and ensure it doesn't crash\n        c_set(42);\n        r_set(42);\n        c_set(0x31415926);\n        r_set(0x31415926);\n    }\n}\n\n#[test]\nfn test_strkey() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int) -> *mut u8> = c.get(b\"strkey\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int) -> *mut u8> = r.get(b\"strkey\").unwrap();\n\n        for n in [0i32, 1, 42, -1, 999, 12345] {\n            let cp = c_fn(n);\n            let rp = r_fn(n);\n            let cs = std::ffi::CStr::from_ptr(cp as *const i8);\n            let rs = std::ffi::CStr::from_ptr(rp as *const i8);\n            assert_eq!(cs.to_bytes(), rs.to_bytes(), \"strkey({}) mismatch\", n);\n        }\n    }\n}\n\n// Test the higher-level hashmap APIs by constructing a typed hashmap manually\n// Using a (key=u64, value=u64) hashmap where elemsize = 16\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\nstruct KvU64 {\n    key: u64,\n    value: u64,\n}\n\n#[test]\nfn test_hmput_get_u64() {\n    unsafe {\n        let (c, r) = load_libs();\n        // Reset the seed so both libraries start with the same random state\n        let c_set: Symbol<unsafe extern \"C\" fn(usize)> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_set: Symbol<unsafe extern \"C\" fn(usize)> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_set(0x31415926);\n        r_set(0x31415926);\n\n        let c_hmput: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void> =\n            c.get(b\"stbds_hmput_key\").unwrap();\n        let r_hmput: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void> =\n            r.get(b\"stbds_hmput_key\").unwrap();\n\n        let c_hmget: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void> =\n            c.get(b\"stbds_hmget_key\").unwrap();\n        let r_hmget: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void> =\n            r.get(b\"stbds_hmget_key\").unwrap();\n\n        let c_hmfree: Symbol<unsafe extern \"C\" fn(*mut c_void, usize)> =\n            c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_hmfree: Symbol<unsafe extern \"C\" fn(*mut c_void, usize)> =\n            r.get(b\"stbds_hmfree_func\").unwrap();\n\n        let elemsize = std::mem::size_of::<KvU64>();\n        let mut c_arr: *mut c_void = std::ptr::null_mut();\n        let mut r_arr: *mut c_void = std::ptr::null_mut();\n\n        // Insert 100 keys\n        for i in 0u64..100 {\n            let mut k = i;\n            c_arr = c_hmput(c_arr, elemsize, &mut k as *mut u64 as *mut c_void, 8, 0);\n            r_arr = r_hmput(r_arr, elemsize, &mut k as *mut u64 as *mut c_void, 8, 0);\n\n            // Set key/value at temp\n            let c_temp = (*header(c_arr)).temp;\n            let r_temp = (*header(r_arr)).temp;\n            assert_eq!(c_temp, r_temp, \"temp mismatch on put i={}\", i);\n            // length+1 because [0] is the default sentinel slot\n            let item_idx = (c_temp + 1) as usize;\n            *((c_arr as *mut u8).add(item_idx * elemsize) as *mut KvU64) =\n                KvU64 { key: k, value: i * 7 };\n            *((r_arr as *mut u8).add(item_idx * elemsize) as *mut KvU64) =\n                KvU64 { key: k, value: i * 7 };\n        }\n\n        // Look them up and verify the resulting temp values match\n        for i in 0u64..100 {\n            let mut k = i;\n            c_arr = c_hmget(c_arr, elemsize, &mut k as *mut u64 as *mut c_void, 8, 0);\n            r_arr = r_hmget(r_arr, elemsize, &mut k as *mut u64 as *mut c_void, 8, 0);\n            let c_temp = (*header(c_arr)).temp;\n            let r_temp = (*header(r_arr)).temp;\n            assert_eq!(c_temp, r_temp, \"temp mismatch on get i={}\", i);\n        }\n\n        // Look up missing keys\n        for i in 200u64..210 {\n            let mut k = i;\n            c_arr = c_hmget(c_arr, elemsize, &mut k as *mut u64 as *mut c_void, 8, 0);\n            r_arr = r_hmget(r_arr, elemsize, &mut k as *mut u64 as *mut c_void, 8, 0);\n            let c_temp = (*header(c_arr)).temp;\n            let r_temp = (*header(r_arr)).temp;\n            assert_eq!(c_temp, r_temp, \"missing-key temp mismatch i={}\", i);\n            assert_eq!(c_temp, -1);\n        }\n\n        // The arrays should have the same length\n        assert_eq!((*header(c_arr)).length, (*header(r_arr)).length);\n\n        c_hmfree(c_arr, elemsize);\n        r_hmfree(r_arr, elemsize);\n    }\n}\n\n#[test]\nfn test_hmdel_u64() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_set: Symbol<unsafe extern \"C\" fn(usize)> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_set: Symbol<unsafe extern \"C\" fn(usize)> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_set(0x31415926);\n        r_set(0x31415926);\n\n        let c_hmput: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void> =\n            c.get(b\"stbds_hmput_key\").unwrap();\n        let r_hmput: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void> =\n            r.get(b\"stbds_hmput_key\").unwrap();\n\n        let c_hmdel: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, usize, c_int) -> *mut c_void> =\n            c.get(b\"stbds_hmdel_key\").unwrap();\n        let r_hmdel: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, usize, c_int) -> *mut c_void> =\n            r.get(b\"stbds_hmdel_key\").unwrap();\n\n        let c_hmfree: Symbol<unsafe extern \"C\" fn(*mut c_void, usize)> =\n            c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_hmfree: Symbol<unsafe extern \"C\" fn(*mut c_void, usize)> =\n            r.get(b\"stbds_hmfree_func\").unwrap();\n\n        let elemsize = std::mem::size_of::<KvU64>();\n        let mut c_arr: *mut c_void = std::ptr::null_mut();\n        let mut r_arr: *mut c_void = std::ptr::null_mut();\n\n        for i in 0u64..50 {\n            let mut k = i;\n            c_arr = c_hmput(c_arr, elemsize, &mut k as *mut u64 as *mut c_void, 8, 0);\n            r_arr = r_hmput(r_arr, elemsize, &mut k as *mut u64 as *mut c_void, 8, 0);\n            let c_temp = (*header(c_arr)).temp;\n            let r_temp = (*header(r_arr)).temp;\n            assert_eq!(c_temp, r_temp);\n            let idx = (c_temp + 1) as usize;\n            *((c_arr as *mut u8).add(idx * elemsize) as *mut KvU64) =\n                KvU64 { key: k, value: i * 3 };\n            *((r_arr as *mut u8).add(idx * elemsize) as *mut KvU64) =\n                KvU64 { key: k, value: i * 3 };\n        }\n\n        // Delete every odd key\n        for i in (1u64..50).step_by(2) {\n            let mut k = i;\n            c_arr = c_hmdel(c_arr, elemsize, &mut k as *mut u64 as *mut c_void, 8, 0, 0);\n            r_arr = r_hmdel(r_arr, elemsize, &mut k as *mut u64 as *mut c_void, 8, 0, 0);\n            assert_eq!((*header(c_arr)).temp, (*header(r_arr)).temp);\n            assert_eq!((*header(c_arr)).length, (*header(r_arr)).length);\n        }\n\n        // Try deleting missing keys\n        for i in 100u64..105 {\n            let mut k = i;\n            c_arr = c_hmdel(c_arr, elemsize, &mut k as *mut u64 as *mut c_void, 8, 0, 0);\n            r_arr = r_hmdel(r_arr, elemsize, &mut k as *mut u64 as *mut c_void, 8, 0, 0);\n            assert_eq!((*header(c_arr)).temp, (*header(r_arr)).temp);\n        }\n\n        c_hmfree(c_arr, elemsize);\n        r_hmfree(r_arr, elemsize);\n    }\n}\n","structuredPatch":[{"oldStart":5,"oldLines":7,"newStart":5,"newLines":7,"lines":[" "," fn c_lib_path() -> PathBuf {","     let manifest