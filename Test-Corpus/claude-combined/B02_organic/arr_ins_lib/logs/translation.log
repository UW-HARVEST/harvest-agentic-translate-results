r::null_mut(), 16);\n        let rp = r_fn(std::ptr::null_mut(), 16);\n        assert_eq!((*hash_header(cp, 16)).length, (*hash_header(rp, 16)).length);\n        // Should have called arrgrowf which makes capacity 4\n        assert_eq!((*hash_header(cp, 16)).capacity, (*hash_header(rp, 16)).capacity);\n\n        let c_arrfree: Symbol<unsafe extern \"C\" fn(*mut c_void)> = c.get(b\"stbds_arrfreef\").unwrap();\n        let r_arrfree: Symbol<unsafe extern \"C\" fn(*mut c_void)> = r.get(b\"stbds_arrfreef\").unwrap();\n        // Free the raw_a\n        c_arrfree((cp as *mut u8).offset(-16) as *mut c_void);\n        r_arrfree((rp as *mut u8).offset(-16) as *mut c_void);\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":453,"cache_read_input_tokens":96910,"cache_creation":{"ephemeral_5m_input_tokens":453,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c327825a-0ddc-4a3b-a14a-b9a7c98fef20","uuid":"0387eccd-d9d2-42cd-aa65-777e869b9a25"}
