thBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    project_root().join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    project_root().join(\"target/release/libtranslated_rust.so\")\n}\n\nunsafe fn load(path: &PathBuf) -> Library {\n    Library::new(path).unwrap_or_else(|e| panic!(\"failed to load {}: {}\", path.display(), e))\n}\n\ntype StbdsHashBytesFn = unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize;\ntype SiphashFn = unsafe extern \"C\" fn(c_int);\n\n/// Capture stdout produced by `f` (which presumably calls a C function that\n/// writes to FD 1 via libc's stdio buffer) and return the bytes written.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    use std::io::Read;\n    use std::os::unix::io::FromRawFd;\n    let _guard = FD1_MUTEX.lock().unwrap_or_else(|e| e.into_inner());\n\n    // Flush libc's stdout buffer first.\n    extern \"C\" {\n        fn fflush(stream: *mut c_void) -> c_int;\n    }\n    unsafe {\n        fflush(std::ptr::null_mut()); // flush all\n    }\n\n    // Save current stdout.\n    let saved_stdout = unsafe { libc::dup(1) };\n    assert!(saved_stdout >= 0, \"dup failed\");\n\n    // Make a pipe and redirect stdout to its write end.\n    let mut fds = [0i32; 2];\n    let r = unsafe { libc::pipe(fds.as_mut_ptr()) };\n    assert_eq!(r, 0, \"pipe failed\");\n    let read_fd = fds[0];\n    let write_fd = fds[1];\n\n    let r = unsafe { libc::dup2(write_fd, 1) };\n    assert_eq!(r, 1, \"dup2 failed\");\n    unsafe { libc::close(write_fd) };\n\n    // Run the function.\n    f();\n\n    // Flush libc stdout buffer so all bytes are in the pipe.\n    unsafe {\n        fflush(std::ptr::null_mut());\n    }\n\n    // Restore stdout.\n    let r = unsafe { libc::dup2(saved_stdout, 1) };\n    assert_eq!(r, 1, \"dup2 restore failed\");\n    unsafe { libc::close(saved_stdout) };\n\n    // Drain the read end of the pipe.\n    let mut file = unsafe { std::fs::File::from_raw_fd(read_fd) };\n    let mut buf = Vec::new();\n    file.read_to_end(&mut buf).expect(\"read pipe\");\n    buf\n}\n\n/// Combined into a single `#[test]` so that cargo's parallel test scheduler\n/// can't interleave another test's stdout writes with our `dup2(pipe, 1)`\n/// capture window. (FD 1 is process-wide, not per-thread.)\n#[test]\nfn ffi_parity() {\n    unsafe { run_stbds_hash_bytes(); }\n    unsafe { run_siphash_print(); }\n}\n\nunsafe fn run_stbds_hash_bytes() {\n    unsafe {\n        let c_lib = load(&c_lib_path());\n        let r_lib = load(&rust_lib_path());\n\n        let c_fn: Symbol<StbdsHashBytesFn> = c_lib.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<StbdsHashBytesFn> = r_lib.get(b\"stbds_hash_bytes\").unwrap();\n\n        // 1. Empty input.\n        for &seed in &[0usize, 1, 0xdeadbeef, usize::MAX, 0x80000000] {\n            let mut empty: [u8; 0] = [];\n            let c = c_fn(empty.as_mut_ptr() as *mut c_void, 0, seed);\n            let r = r_fn(empty.as_mut_ptr() as *mut c_void, 0, seed);\n            assert_eq!(c, r, \"empty input, seed={:#x}\", seed);\n        }\n\n        // 2. Various lengths and contents.\n        let mut samples: Vec<Vec<u8>> = Vec::new();\n        // All zeros for lengths 0..32.\n        for len in 0..32usize {\n            samples.push(vec![0u8; len]);\n        }\n        // Sequential bytes for lengths 0..64.\n        for len in 0..64usize {\n            samples.push((0..len as u8).collect());\n        }\n        // Bytes that exercise the int-sign-extension paths (high bit set).\n        for len in 1..32usize {\n            samples.push(vec![0x80u8; len]);\n            samples.push(vec![0xffu8; len]);\n        }\n        // Ascending then descending high-bit patterns.\n        samples.push(b\"The quick brown fox jumps over the lazy dog\".to_vec());\n        samples.push(b\"Hello, World!\\x80\\x81\\x82\\xff\".to_vec());\n\n        // Pseudo-random data of length 0..130 using a simple LCG.\n        for trial in 0..16u64 {\n            let mut state: u64 = 0x9E3779B97F4A7C15u64.wrapping_mul(trial.wrapping_add(1));\n            for len in [0, 1, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 129, 130usize] {\n                let mut v = Vec::with_capacity(len);\n                for _ in 0..len {\n                    state = state\n                        .wrapping_mul(6364136223846793005)\n                        .wrapping_add(1442695040888963407);\n                    v.push((state >> 56) as u8);\n                }\n                samples.push(v);\n            }\n        }\n\n        for sample in &samples {\n            for &seed in &[\n                0usize,\n                1,\n                0xdeadbeef,\n                0xc0ffee,\n                usize::MAX,\n                0x8000_0000_0000_0000,\n                0x1234_5678_9abc_def0,\n            ] {\n                let mut buf = sample.clone();\n                let c = c_fn(buf.as_mut_ptr() as *mut c_void, buf.len(), seed);\n                let r = r_fn(buf.as_mut_ptr() as *mut c_void, buf.len(), seed);\n                assert_eq!(\n                    c, r,\n                    \"mismatch len={} seed={:#x} bytes={:02x?}\",\n                    buf.len(),\n                    seed,\n                    &buf[..buf.len().min(16)]\n                );\n            }\n        }\n    }\n}\n\nunsafe fn run_siphash_print() {\n    unsafe {\n        let c_lib = load(&c_lib_path());\n        let r_lib = load(&rust_lib_path());\n\n        let c_fn: Symbol<SiphashFn> = c_lib.get(b\"siphash\").unwrap();\n        let r_fn: Symbol<SiphashFn> = r_lib.get(b\"siphash\").unwrap();\n\n        for &init in &[0i32, 1, -1, 0x7f, 0x80, 0xff, 42, -128, 256, -2147483648] {\n            // Capture each in turn — we keep them serialized so stdout\n            // capture state is unambiguous.\n            let c_out = capture_stdout(|| c_fn(init));\n            let r_out = capture_stdout(|| r_fn(init));\n            assert_eq!(\n                c_out,\n                r_out,\n                \"siphash({}) output differs:\\nC:    {}\\nRust: {}\",\n                init,\n                String::from_utf8_lossy(&c_out),\n                String::from_utf8_lossy(&r_out),\n            );\n        }\n    }\n}\n","structuredPatch":[{"oldStart":5,"oldLines":15,"newStart":5,"newLines":7,"lines":[" use std::ffi::c_void;"," use std::os::raw::c_int;"," use std::path::PathBuf;","-use std::sync::Mutex;"," ","-/// Both tests in this file may be run in parallel by `cargo test`. The","-/// stdout-capture machinery in `capture_stdout` mutates FD 1 process-wide,","-/// so we serialize access to it. The hash-bytes test doesn't use stdout","-/// capture but we still want to keep ordering deterministic in --nocapture","-/// runs to avoid surprises when both tests do dup2 on FD 1.","-static FD1_MUTEX: Mutex<()> = Mutex::new(());","-"," fn project_root() -> PathBuf {","     PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))"," }"]}],"userModified":false,"replaceAll":false}}
