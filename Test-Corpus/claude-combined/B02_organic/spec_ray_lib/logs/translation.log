{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017PvPnFpP1MNAcTtqrLegHg","type":"tool_result","content":"File created successfully at: /tmp/harvest-translate-iuuT4o/translated_rust/tests/ffi_compare.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"2cafd454-666a-4cb2-98c9-8eec598b4fcd","uuid":"c6e48d6a-d6b8-40a2-9b06-2dda1c092ba0","timestamp":"2026-05-30T00:51:14.618Z","tool_use_result":{"type":"create","filePath":"/tmp/harvest-translate-iuuT4o/translated_rust/tests/ffi_compare.rs","content":"// Integration tests that load BOTH the C-built .so and the Rust-built .so via\n// libloading, then call exported functions through FFI to verify byte-identical\n// behavior.\n\nuse libloading::{Library, Symbol};\nuse std::path::PathBuf;\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq)]\npub struct C2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq)]\npub struct C2Raycast {\n    pub t: f32,\n    pub n: C2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct C2Circle {\n    pub p: C2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct C2AABB {\n    pub min: C2v,\n    pub max: C2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct C2Capsule {\n    pub a: C2v,\n    pub b: C2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct C2Ray {\n    pub p: C2v,\n    pub d: C2v,\n    pub t: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct C2m {\n    pub x: C2v,\n    pub y: C2v,\n}\n\nconst C2_TYPE_CIRCLE: i32 = 0;\nconst C2_TYPE_AABB: i32 = 1;\nconst C2_TYPE_CAPSULE: i32 = 2;\n\nfn c_so_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nfn rust_so_path() -> PathBuf {\n    // The Rust .so lives in target/<profile>/.\n    // Tests built in `cargo test` run with the test profile by default,\n    // but `cargo build --release` produces target/release/libtranslated_rust.so.\n    // We try multiple candidate locations.\n    let manifest = env!(\"CARGO_MANIFEST_DIR\");\n    let candidates = [\n        format!(\"{manifest}/target/release/libtranslated_rust.so\"),\n        format!(\"{manifest}/target/debug/libtranslated_rust.so\"),\n    ];\n    for c in &candidates {\n        let p = PathBuf::from(c);\n        if p.exists() {\n            return p;\n        }\n    }\n    panic!(\"Could not find Rust .so (tried: {:?})\", candidates);\n}\n\nunsafe fn load_pair() -> (Library, Library) {\n    let c = unsafe { Library::new(c_so_path()) }.expect(\"load C .so\");\n    let r = unsafe { Library::new(rust_so_path()) }.expect(\"load Rust .so\");\n    (c, r)\n}\n\n// Helper for comparing floats bit-for-bit (so NaN equals NaN of same bit\n// pattern; +0.0 != -0.0 only via bits, both are equal here since same bits).\n// Actually, NaN may come in different bit patterns. Use bit_eq.\nfn bit_eq_f32(a: f32, b: f32) -> bool {\n    a.to_bits() == b.to_bits()\n}\n\nfn vec_bit_eq(a: C2v, b: C2v) -> bool {\n    bit_eq_f32(a.x, b.x) && bit_eq_f32(a.y, b.y)\n}\n\nfn cast_bit_eq(a: C2Raycast, b: C2Raycast) -> bool {\n    bit_eq_f32(a.t, b.t) && vec_bit_eq(a.n, b.n)\n}\n\n#[test]\nfn test_c2V() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_fn: Symbol<unsafe extern \"C\" fn(f32, f32) -> C2v> = c_lib.get(b\"c2V\\0\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(f32, f32) -> C2v> = r_lib.get(b\"c2V\\0\").unwrap();\n        for (x, y) in [(0.0, 0.0), (1.0, -1.0), (-3.5, 2.25), (f32::NAN, 0.0)] {\n            let cv = c_fn(x, y);\n            let rv = r_fn(x, y);\n            assert!(vec_bit_eq(cv, rv), \"c2V({x},{y}): C={cv:?} Rust={rv:?}\");\n        }\n    }\n}\n\n#[test]\nfn test_c2Dot() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> f32> = c_lib.get(b\"c2Dot\\0\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> f32> = r_lib.get(b\"c2Dot\\0\").unwrap();\n        let cases = [\n            (C2v { x: 1.0, y: 2.0 }, C2v { x: 3.0, y: 4.0 }),\n            (C2v { x: 0.0, y: 0.0 }, C2v { x: 0.0, y: 0.0 }),\n            (C2v { x: -1.5, y: 2.0 }, C2v { x: 4.0, y: -3.5 }),\n        ];\n        for (a, b) in cases {\n            let cv = c_fn(a, b);\n            let rv = r_fn(a, b);\n            assert!(bit_eq_f32(cv, rv), \"c2Dot: C={cv} Rust={rv}\");\n        }\n    }\n}\n\n#[test]\nfn test_c2Len() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2v) -> f32> = c_lib.get(b\"c2Len\\0\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2v) -> f32> = r_lib.get(b\"c2Len\\0\").unwrap();\n        for (x, y) in [(3.0, 4.0), (0.0, 0.0), (1.0, 1.0), (-2.0, 2.0)] {\n            let v = C2v { x, y };\n            assert!(bit_eq_f32(c_fn(v), r_fn(v)));\n        }\n    }\n}\n\n#[test]\nfn test_arith_ops() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_add: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = c_lib.get(b\"c2Add\\0\").unwrap();\n        let r_add: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = r_lib.get(b\"c2Add\\0\").unwrap();\n        let c_sub: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = c_lib.get(b\"c2Sub\\0\").unwrap();\n        let r_sub: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = r_lib.get(b\"c2Sub\\0\").unwrap();\n        let c_mul: Symbol<unsafe extern \"C\" fn(C2v, f32) -> C2v> = c_lib.get(b\"c2Mulvs\\0\").unwrap();\n        let r_mul: Symbol<unsafe extern \"C\" fn(C2v, f32) -> C2v> = r_lib.get(b\"c2Mulvs\\0\").unwrap();\n        let c_div: Symbol<unsafe extern \"C\" fn(C2v, f32) -> C2v> = c_lib.get(b\"c2Div\\0\").unwrap();\n        let r_div: Symbol<unsafe extern \"C\" fn(C2v, f32) -> C2v> = r_lib.get(b\"c2Div\\0\").unwrap();\n        let cases = [\n            (C2v { x: 1.0, y: 2.0 }, C2v { x: 3.0, y: 4.0 }, 2.0),\n            (C2v { x: -1.5, y: 0.5 }, C2v { x: 0.25, y: -0.5 }, 0.5),\n            (C2v { x: 100.0, y: 200.0 }, C2v { x: -50.0, y: -100.0 }, -2.0),\n        ];\n        for (a, b, s) in cases {\n            assert!(vec_bit_eq(c_add(a, b), r_add(a, b)));\n            assert!(vec_bit_eq(c_sub(a, b), r_sub(a, b)));\n            assert!(vec_bit_eq(c_mul(a, s), r_mul(a, s)));\n            assert!(vec_bit_eq(c_div(a, s), r_div(a, s)));\n        }\n    }\n}\n\n#[test]\nfn test_norm_skew_absv_ccw() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_norm: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = c_lib.get(b\"c2Norm\\0\").unwrap();\n        let r_norm: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = r_lib.get(b\"c2Norm\\0\").unwrap();\n        let c_skew: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = c_lib.get(b\"c2Skew\\0\").unwrap();\n        let r_skew: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = r_lib.get(b\"c2Skew\\0\").unwrap();\n        let c_absv: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = c_lib.get(b\"c2Absv\\0\").unwrap();\n        let r_absv: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = r_lib.get(b\"c2Absv\\0\").unwrap();\n        let c_ccw: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = c_lib.get(b\"c2CCW90\\0\").unwrap();\n        let r_ccw: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = r_lib.get(b\"c2CCW90\\0\").unwrap();\n        for v in [\n            C2v { x: 3.0, y: 4.0 },\n            C2v { x: -1.0, y: 0.5 },\n            C2v { x: 0.5, y: -2.5 },\n        ] {\n            assert!(vec_bit_eq(c_norm(v), r_norm(v)));\n            assert!(vec_bit_eq(c_skew(v), r_skew(v)));\n            assert!(vec_bit_eq(c_absv(v), r_absv(v)));\n            assert!(vec_bit_eq(c_ccw(v), r_ccw(v)));\n        }\n    }\n}\n\n#[test]\nfn test_minv_maxv() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_min: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> =\n            c_lib.get(b\"c2Minv\\0\").unwrap();\n        let r_min: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> =\n            r_lib.get(b\"c2Minv\\0\").unwrap();\n        let c_max: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> =\n            c_lib.get(b\"c2Maxv\\0\").unwrap();\n        let r_max: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> =\n            r_lib.get(b\"c2Maxv\\0\").unwrap();\n        let cases = [\n            (C2v { x: 1.0, y: 2.0 }, C2v { x: 3.0, y: 1.0 }),\n            (C2v { x: -1.5, y: 0.5 }, C2v { x: 0.25, y: -0.5 }),\n        ];\n        for (a, b) in cases {\n            assert!(vec_bit_eq(c_min(a, b), r_min(a, b)));\n            assert!(vec_bit_eq(c_max(a, b), r_max(a, b)));\n        }\n    }\n}\n\n#[test]\nfn test_mulmvT() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2m, C2v) -> C2v> =\n            c_lib.get(b\"c2MulmvT\\0\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2m, C2v) -> C2v> =\n            r_lib.get(b\"c2MulmvT\\0\").unwrap();\n        let m = C2m {\n            x: C2v { x: 1.0, y: 0.5 },\n            y: C2v { x: -0.25, y: 2.0 },\n        };\n        for v in [C2v { x: 3.0, y: 4.0 }, C2v { x: -1.0, y: 0.0 }] {\n            assert!(vec_bit_eq(c_fn(m, v), r_fn(m, v)));\n        }\n    }\n}\n\n#[test]\nfn test_aabbtoaabb() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2AABB, C2AABB) -> i32> =\n            c_lib.get(b\"c2AABBtoAABB\\0\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2AABB, C2AABB) -> i32> =\n            r_lib.get(b\"c2AABBtoAABB\\0\").unwrap();\n        let mk = |a: f32, b: f32, c: f32, d: f32| C2AABB {\n            min: C2v { x: a, y: b },\n            max: C2v { x: c, y: d },\n        };\n        let cases = [\n            (mk(0.0, 0.0, 1.0, 1.0), mk(0.5, 0.5, 1.5, 1.5)),\n            (mk(0.0, 0.0, 1.0, 1.0), mk(2.0, 2.0, 3.0, 3.0)),\n            (mk(0.0, 0.0, 5.0, 5.0), mk(1.0, 1.0, 2.0, 2.0)),\n        ];\n        for (a, b) in cases {\n            assert_eq!(c_fn(a, b), r_fn(a, b));\n        }\n    }\n}\n\n#[test]\nfn test_aabbtopoint_circletopoint() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_a: Symbol<unsafe extern \"C\" fn(C2AABB, C2v) -> i32> =\n            c_lib.get(b\"c2AABBtoPoint\\0\").unwrap();\n        let r_a: Symbol<unsafe extern \"C\" fn(C2AABB, C2v) -> i32> =\n            r_lib.get(b\"c2AABBtoPoint\\0\").unwrap();\n        let c_c: Symbol<unsafe extern \"C\" fn(C2Circle, C2v) -> i32> =\n            c_lib.get(b\"c2CircleToPoint\\0\").unwrap();\n        let r_c: Symbol<unsafe extern \"C\" fn(C2Circle, C2v) -> i32> =\n            r_lib.get(b\"c2CircleToPoint\\0\").unwrap();\n        let aabb = C2AABB {\n            min: C2v { x: 0.0, y: 0.0 },\n            max: C2v { x: 2.0, y: 2.0 },\n        };\n        let circ = C2Circle {\n            p: C2v { x: 1.0, y: 1.0 },\n            r: 1.5,\n        };\n        for p in [\n            C2v { x: 1.0, y: 1.0 },\n            C2v { x: 3.0, y: 1.0 },\n            C2v { x: -0.5, y: 0.5 },\n            C2v { x: 2.0, y: 2.0 },\n        ] {\n            assert_eq!(c_a(aabb, p), r_a(aabb, p));\n            assert_eq!(c_c(circ, p), r_c(circ, p));\n        }\n    }\n}\n\n#[test]\nfn test_raytocircle() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2Ray, C2Circle, *mut C2Raycast) -> i32> =\n            c_lib.get(b\"c2RaytoCircle\\0\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2Ray, C2Circle, *mut C2Raycast) -> i32> =\n            r_lib.get(b\"c2RaytoCircle\\0\").unwrap();\n        let cases = [\n            (\n                C2Ray {\n                    p: C2v { x: 0.0, y: 0.0 },\n                    d: C2v { x: 1.0, y: 0.0 },\n                    t: 10.0,\n                },\n                C2Circle {\n                    p: C2v { x: 5.0, y: 0.0 },\n                    r: 1.0,\n                },\n            ),\n            (\n                C2Ray {\n                    p: C2v { x: 0.0, y: 0.0 },\n                    d: C2v { x: 0.0, y: 1.0 },\n                    t: 10.0,\n                },\n                C2Circle {\n                    p: C2v { x: 5.0, y: 0.0 },\n                    r: 1.0,\n                },\n            ),\n            (\n                C2Ray {\n                    p: C2v { x: -3.0, y: 0.0 },\n                    d: C2v { x: 1.0, y: 0.0 },\n                    t: 10.0,\n                },\n                C2Circle {\n                    p: C2v { x: 0.0, y: 0.0 },\n                    r: 1.0,\n                },\n            ),\n        ];\n        for (ray, circle) in cases {\n            let mut c_out = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut r_out = c_out;\n            let cv = c_fn(ray, circle, &mut c_out);\n            let rv = r_fn(ray, circle, &mut r_out);\n            assert_eq!(cv, rv);\n            if cv != 0 {\n                assert!(cast_bit_eq(c_out, r_out), \"C={c_out:?} Rust={r_out:?}\");\n            }\n        }\n    }\n}\n\n#[test]\nfn test_raytoaabb() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2Ray, C2AABB, *mut C2Raycast) -> i32> =\n            c_lib.get(b\"c2RaytoAABB\\0\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2Ray, C2AABB, *mut C2Raycast) -> i32> =\n            r_lib.get(b\"c2RaytoAABB\\0\").unwrap();\n        let aabb = C2AABB {\n            min: C2v { x: -1.0, y: -1.0 },\n            max: C2v { x: 1.0, y: 1.0 },\n        };\n        let cases = [\n            C2Ray {\n                p: C2v { x: -5.0, y: 0.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 10.0,\n            },\n            C2Ray {\n                p: C2v { x: 0.0, y: -5.0 },\n                d: C2v { x: 0.0, y: 1.0 },\n                t: 10.0,\n            },\n            C2Ray {\n                p: C2v { x: -5.0, y: -5.0 },\n                d: C2v { x: 0.7071, y: 0.7071 },\n                t: 20.0,\n            },\n            // A ray that misses\n            C2Ray {\n                p: C2v { x: 5.0, y: 5.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 10.0,\n            },\n        ];\n        for ray in cases {\n            let mut c_out = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut r_out = c_out;\n            let cv = c_fn(ray, aabb, &mut c_out);\n            let rv = r_fn(ray, aabb, &mut r_out);\n            assert_eq!(cv, rv);\n            if cv != 0 {\n                assert!(cast_bit_eq(c_out, r_out), \"C={c_out:?} Rust={r_out:?}\");\n            }\n        }\n    }\n}\n\n#[test]\nfn test_raytocapsule() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2Ray, C2Capsule, *mut C2Raycast) -> i32> =\n            c_lib.get(b\"c2RaytoCapsule\\0\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2Ray, C2Capsule, *mut C2Raycast) -> i32> =\n            r_lib.get(b\"c2RaytoCapsule\\0\").unwrap();\n        let cases = [\n            // Ray hits side of capsule\n            (\n                C2Ray {\n                    p: C2v { x: -5.0, y: 1.0 },\n                    d: C2v { x: 1.0, y: 0.0 },\n                    t: 20.0,\n                },\n                C2Capsule {\n                    a: C2v { x: 0.0, y: 0.0 },\n                    b: C2v { x: 0.0, y: 5.0 },\n                    r: 1.0,\n                },\n            ),\n            // Ray that should miss\n            (\n                C2Ray {\n                    p: C2v { x: 10.0, y: 10.0 },\n                    d: C2v { x: 1.0, y: 0.0 },\n                    t: 5.0,\n                },\n                C2Capsule {\n                    a: C2v { x: 0.0, y: 0.0 },\n                    b: C2v { x: 0.0, y: 5.0 },\n                    r: 1.0,\n                },\n            ),\n            // Ray hits cap\n            (\n                C2Ray {\n                    p: C2v { x: 0.0, y: -5.0 },\n                    d: C2v { x: 0.0, y: 1.0 },\n                    t: 20.0,\n                },\n                C2Capsule {\n                    a: C2v { x: 0.0, y: 0.0 },\n                    b: C2v { x: 0.0, y: 5.0 },\n                    r: 1.0,\n                },\n            ),\n        ];\n        for (ray, cap) in cases {\n            let mut c_out = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut r_out = c_out;\n            let cv = c_fn(ray, cap, &mut c_out);\n            let rv = r_fn(ray, cap, &mut r_out);\n            assert_eq!(cv, rv, \"hit flag mismatch\");\n            assert!(cast_bit_eq(c_out, r_out), \"C={c_out:?} Rust={r_out:?}\");\n        }\n    }\n}\n\n#[test]\nfn test_castray() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_fn: Symbol<\n            unsafe extern \"C\" fn(C2Ray, *const std::ffi::c_void, i32, *mut C2Raycast) -> i32,\n        > = c_lib.get(b\"c2CastRay\\0\").unwrap();\n        let r_fn: Symbol<\n            unsafe extern \"C\" fn(C2Ray, *const std::ffi::c_void, i32, *mut C2Raycast) -> i32,\n        > = r_lib.get(b\"c2CastRay\\0\").unwrap();\n        let ray = C2Ray {\n            p: C2v { x: -5.0, y: 0.0 },\n            d: C2v { x: 1.0, y: 0.0 },\n            t: 10.0,\n        };\n        let circle = C2Circle {\n            p: C2v { x: 0.0, y: 0.0 },\n            r: 1.0,\n        };\n        let aabb = C2AABB {\n            min: C2v { x: -1.0, y: -1.0 },\n            max: C2v { x: 1.0, y: 1.0 },\n        };\n        let cap = C2Capsule {\n            a: C2v { x: 0.0, y: 0.0 },\n            b: C2v { x: 0.0, y: 5.0 },\n            r: 1.0,\n        };\n\n        // Test all three shape types\n        for (typ, ptr) in [\n            (\n                C2_TYPE_CIRCLE,\n                &circle as *const C2Circle as *const std::ffi::c_void,\n            ),\n            (\n                C2_TYPE_AABB,\n                &aabb as *const C2AABB as *const std::ffi::c_void,\n            ),\n            (\n                C2_TYPE_CAPSULE,\n                &cap as *const C2Capsule as *const std::ffi::c_void,\n            ),\n        ] {\n            let mut c_out = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut r_out = c_out;\n            let cv = c_fn(ray, ptr, typ, &mut c_out);\n            let rv = r_fn(ray, ptr, typ, &mut r_out);\n            assert_eq!(cv, rv);\n            if cv != 0 {\n                assert!(cast_bit_eq(c_out, r_out));\n            }\n        }\n    }\n}\n\n#[test]\nfn test_spec_ray() {\n    unsafe {\n        let (c_lib, r_lib) = load_pair();\n        let c_fn: Symbol<\n            unsafe extern \"C\" fn(*mut C2Raycast, f32, f32, f32, f32, f32, f32, f32) -> i32,\n        > = c_lib.get(b\"spec_ray\\0\").unwrap();\n        let r_fn: Symbol<\n            unsafe extern \"C\" fn(*mut C2Raycast, f32, f32, f32, f32, f32, f32, f32) -> i32,\n        > = r_lib.get(b\"spec_ray\\0\").unwrap();\n\n        // (mp_x, mp_y, c_p_x, c_p_y, c_r, r_p_x, r_p_y)\n        let cases = [\n            (5.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, 1.0_f32, -5.0_f32, 0.0_f32),\n            (0.0, 5.0, 0.0, 0.0, 1.0, 0.0, -5.0),\n            (10.0, 10.0, 5.0, 5.0, 2.0, 0.0, 0.0),\n            // Ray going past circle (mp ends past circle but mp is along ray)\n            (10.0, 0.0, 5.0, 0.0, 1.0, 0.0, 0.0),\n            // Ray that misses circle\n            (10.0, 10.0, 0.0, 0.0, 1.0, -5.0, 5.0),\n        ];\n\n        for (mp_x, mp_y, c_p_x, c_p_y, c_r, r_p_x, r_p_y) in cases {\n            let mut c_out = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut r_out = c_out;\n            let cv = c_fn(&mut c_out, mp_x, mp_y, c_p_x, c_p_y, c_r, r_p_x, r_p_y);\n            let rv = r_fn(&mut r_out, mp_x, mp_y, c_p_x, c_p_y, c_r, r_p_x, r_p_y);\n            assert_eq!(cv, rv, \"spec_ray hit flag\");\n            if cv != 0 {\n                assert!(cast_bit_eq(c_out, r_out), \"C={c_out:?} Rust={r_out:?}\");\n            }\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
