let min_abs = if abs_yAe_x < abs_yAp_x { abs_yAe_x } else { abs_yAp_x };\n    if yAe.x * yAp.x < 0.0 || min_abs < B.r {\n        let Ca = c2Circle { p: B.a, r: B.r };\n        let Cb = c2Circle { p: B.b, r: B.r };\n        if abs_yAp_x < B.r {\n            if yAp.y < 0.0 {\n                return c2RaytoCircle(A, Ca, out);\n            } else {\n                return c2RaytoCircle(A, Cb, out);\n            }\n        } else {\n            let c = if yAp.x > 0.0 { B.r } else { -B.r };\n            let d = yAe.x - yAp.x;\n            let t = (c - yAp.x) / d;\n            let y = yAp.y + (yAe.y - yAp.y) * t;\n            if y <= 0.0 {\n                return c2RaytoCircle(A, Ca, out);\n            }\n            if y >= yBb.y {\n                return c2RaytoCircle(A, Cb, out);\n            } else {\n                out.n = if c > 0.0 { M.x } else { c2Skew(M.y) };\n                out.t = t * A.t;\n                return 1;\n            }\n        }\n    }\n    0\n}\n\nfn c2CastRay(A: c2Ray, B: *const std::ffi::c_void, typeB: C2_TYPE, out: &mut c2Raycast) -> i32 {\n    match typeB {\n        C2_TYPE::C2_TYPE_CIRCLE => unsafe {\n            let circle = *(B as *const c2Circle);\n            c2RaytoCircle(A, circle, out)\n        },\n        C2_TYPE::C2_TYPE_AABB => unsafe {\n            let aabb = *(B as *const c2AABB);\n            c2RaytoAABB(A, aabb, out)\n        },\n        C2_TYPE::C2_TYPE_CAPSULE => unsafe {\n            let capsule = *(B as *const c2Capsule);\n            c2RaytoCapsule(A, capsule, out)\n        },\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn spec_ray(\n    cast: *mut c2Raycast,\n    mp_x: f32,\n    mp_y: f32,\n    c_p_x: f32,\n    c_p_y: f32,\n    c_r: f32,\n    r_p_x: f32,\n    r_p_y: f32,\n) -> c_int {\n    let mp = c2V(mp_x, mp_y);\n\n    let c = c2Circle {\n        p: c2V(c_p_x, c_p_y),\n        r: c_r,\n    };\n\n    let mut ray = c2Ray {\n        p: c2V(r_p_x, r_p_y),\n        d: c2v { x: 0.0, y: 0.0 },\n        t: 0.0,\