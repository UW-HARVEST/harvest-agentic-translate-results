"-        },","-        C2_TYPE::C2_TYPE_AABB => unsafe {","-            let aabb = *(B as *const c2AABB);","-            c2RaytoAABB_inner(A, aabb, out)","-        },","-        C2_TYPE::C2_TYPE_CAPSULE => unsafe {","-            let capsule = *(B as *const c2Capsule);","-            c2RaytoCapsule_inner(A, capsule, out)","-        },","-    }","-}"]}],"originalFile":"#![allow(non_camel_case_types, non_snake_case, dead_code)]\n\nuse std::ffi::c_int;\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Raycast {\n    pub t: f32,\n    pub n: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct c2Circle {\n    p: c2v,\n    r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct c2AABB {\n    min: c2v,\n    max: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct c2Capsule {\n    a: c2v,\n    b: c2v,\n    r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct c2Ray {\n    p: c2v,\n    d: c2v,\n    t: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, PartialEq, Eq)]\n#[allow(dead_code)]\nenum C2_TYPE {\n    C2_TYPE_CIRCLE = 0,\n    C2_TYPE_AABB = 1,\n    C2_TYPE_CAPSULE = 2,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct c2m {\n    x: c2v,\n    y: c2v,\n}\n\n#[inline]\nfn c2V(x: f32, y: f32) -> c2v {\n    c2v { x, y }\n}\n\n#[inline]\nfn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n#[inline]\nfn c2Len(a: c2v) -> f32 {\n    // sqrtf in C\n    c2Dot(a, a).sqrt()\n}\n\n#[inline]\nfn c2Add(mut a: c2v, b: c2v) -> c2v {\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[inline]\nfn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[inline]\nfn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n#[inline]\nfn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n#[inline]\nfn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[inline]\nfn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[inline]\nfn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[inline]\nfn c2Skew(a: c2v) -> c2v {\n    c2v { x: -a.y, y: a.x }\n}\n\n#[inline]\nfn c2Absv(a: c2v) -> c2v {\n    c2V(\n        if a.x < 0.0 { -a.x } else { a.x },\n        if a.y < 0.0 { -a.y } else { a.y },\n    )\n}\n\n#[inline]\nfn c2CCW90(a: c2v) -> c2v {\n    c2v { x: a.y, y: -a.x }\n}\n\n#[inline]\nfn c2MulmvT(a: c2m, b: c2v) -> c2v {\n    c2v {\n        x: a.x.x * b.x + a.x.y * b.y,\n        y: a.y.x * b.x + a.y.y * b.y,\n    }\n}\n\nfn c2RaytoCircle(A: c2Ray, B: c2Circle, out: &mut c2Raycast) -> i32 {\n    let p = B.p;\n    let m = c2Sub(A.p, p);\n    let c = c2Dot(m, m) - B.r * B.r;\n    let b = c2Dot(m, A.d);\n    let disc = b * b - c;\n    if disc < 0.0 {\n        return 0;\n    }\n    let t = -b - disc.sqrt();\n    if t >= 0.0 && t <= A.t {\n        out.t = t;\n        let impact = c2Add(A.p, c2Mulvs(A.d, t));\n        out.n = c2Norm(c2Sub(impact, p));\n        return 1;\n    }\n    0\n}\n\nfn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> i32 {\n    let d0: i32 = (B.max.x < A.min.x) as i32;\n    let d1: i32 = (A.max.x < B.min.x) as i32;\n    let d2: i32 = (B.max.y < A.min.y) as i32;\n    let d3: i32 = (A.max.y < B.min.y) as i32;\n    if (d0 | d1 | d2 | d3) == 0 { 1 } else { 0 }\n}\n\n#[inline]\nfn c2SignedDistPointToPlane_OneDimensional(p: f32, n: f32, d: f32) -> f32 {\n    p * n - d * n\n}\n\n#[inline]\nfn c2RayToPlane_OneDimensional(da: f32, db: f32) -> f32 {\n    if da < 0.0 {\n        0.0\n    } else if da * db > 0.0 {\n        1.0\n    } else {\n        let d = da - db;\n        if d != 0.0 { da / d } else { 0.0 }\n    }\n}\n\nfn c2RaytoAABB(A: c2Ray, B: c2AABB, out: &mut c2Raycast) -> i32 {\n    let p0 = A.p;\n    let p1 = c2Add(A.p, c2Mulvs(A.d, A.t));\n    let a_box = c2AABB {\n        min: c2Minv(p0, p1),\n  