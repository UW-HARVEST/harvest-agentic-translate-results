{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_7qsbn4lvizhdt6hahaalwkcahuv2abbilvw2i3cnnmodg7cclbua","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01GoV17y7HGQFVSrpw6nJg4G","name":"Write","input":{"file_path":"/tmp/harvest-translate-vhBkUK/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::os::raw::{c_char, c_int, c_void};\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug, PartialEq)]\nstruct C2v {\n    x: f32,\n    y: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug, PartialEq)]\nstruct C2r {\n    c: f32,\n    s: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug, PartialEq)]\nstruct C2x {\n    p: C2v,\n    r: C2r,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug, PartialEq)]\nstruct C2Circle {\n    p: C2v,\n    r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug, PartialEq)]\nstruct C2AABB {\n    min: C2v,\n    max: C2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug, PartialEq)]\nstruct C2Capsule {\n    a: C2v,\n    b: C2v,\n    r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug, PartialEq)]\nstruct C2GJKCache {\n    metric: f32,\n    count: c_int,\n    iA: [c_int; 3],\n    iB: [c_int; 3],\n    div: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\nstruct C2Proxy {\n    radius: f32,\n    count: c_int,\n    verts: [C2v; 8],\n}\n\nimpl Default for C2Proxy {\n    fn default() -> Self {\n        C2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [C2v::default(); 8],\n        }\n    }\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug, PartialEq)]\nstruct C2sv {\n    sA: C2v,\n    sB: C2v,\n    p: C2v,\n    u: f32,\n    iA: c_int,\n    iB: c_int,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug, PartialEq)]\nstruct C2Simplex {\n    a: C2sv,\n    b: C2sv,\n    c: C2sv,\n    d: C2sv,\n    div: f32,\n    count: c_int,\n}\n\nconst C_LIB: &str = \"c_src/build/libtranslated_rust.so\";\nconst RUST_LIB: &str = \"target/release/libtranslated_rust.so\";\n\nfn load_libs() -> (Library, Library) {\n    unsafe {\n        let c = Library::new(C_LIB).expect(\"failed to load C lib\");\n        let r = Library::new(RUST_LIB).expect(\"failed to load Rust lib\");\n        (c, r)\n    }\n}\n\n#[test]\nfn test_c2v() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let cf: Symbol<extern \"C\" fn(f32, f32) -> C2v> = cl.get(b\"c2V\").unwrap();\n        let rf: Symbol<extern \"C\" fn(f32, f32) -> C2v> = rl.get(b\"c2V\").unwrap();\n        for &(x, y) in &[(0.0, 0.0), (1.0, 2.0), (-3.5, 4.5), (1e10, -1e-10)] {\n            assert_eq!(cf(x, y), rf(x, y));\n        }\n    }\n}\n\n#[test]\nfn test_c2mulvs() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let cf: Symbol<extern \"C\" fn(C2v, f32) -> C2v> = cl.get(b\"c2Mulvs\").unwrap();\n        let rf: Symbol<extern \"C\" fn(C2v, f32) -> C2v> = rl.get(b\"c2Mulvs\").unwrap();\n        let v = C2v { x: 1.5, y: -2.5 };\n        for &b in &[0.0f32, 1.0, -1.0, 3.5, 1e6] {\n            assert_eq!(cf(v, b), rf(v, b));\n        }\n    }\n}\n\n#[test]\nfn test_basic_ops() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let a = C2v { x: 1.0, y: 2.0 };\n        let b = C2v { x: 3.0, y: 4.0 };\n\n        let c1: Symbol<extern \"C\" fn(C2v, C2v) -> C2v> = cl.get(b\"c2Maxv\").unwrap();\n        let r1: Symbol<extern \"C\" fn(C2v, C2v) -> C2v> = rl.get(b\"c2Maxv\").unwrap();\n        assert_eq!(c1(a, b), r1(a, b));\n\n        let c2: Symbol<extern \"C\" fn(C2v, C2v) -> C2v> = cl.get(b\"c2Minv\").unwrap();\n        let r2: Symbol<extern \"C\" fn(C2v, C2v) -> C2v> = rl.get(b\"c2Minv\").unwrap();\n        assert_eq!(c2(a, b), r2(a, b));\n\n        let c3: Symbol<extern \"C\" fn(C2v, C2v) -> C2v> = cl.get(b\"c2Sub\").unwrap();\n        let r3: Symbol<extern \"C\" fn(C2v, C2v) -> C2v> = rl.get(b\"c2Sub\").unwrap();\n        assert_eq!(c3(a, b), r3(a, b));\n\n        let c4: Symbol<extern \"C\" fn(C2v, C2v) -> C2v> = cl.get(b\"c2Add\").unwrap();\n        let r4: Symbol<extern \"C\" fn(C2v, C2v) -> C2v> = rl.get(b\"c2Add\").unwrap();\n        assert_eq!(c4(a, b), r4(a, b));\n\n        let c5: Symbol<extern \"C\" fn(C2v, C2v) -> f32> = cl.get(b\"c2Dot\").unwrap();\n        let r5: Symbol<extern \"C\" fn(C2v, C2v) -> f32> = rl.get(b\"c2Dot\").unwrap();\n        assert_eq!(c5(a, b).to_bits(), r5(a, b).to_bits());\n\n        let c6: Symbol<extern \"C\" fn(C2v, C2v) -> f32> = cl.get(b\"c2Det2\").unwrap();\n        let r6: Symbol<extern \"C\" fn(C2v, C2v) -> f32> = rl.get(b\"c2Det2\").unwrap();\n        assert_eq!(c6(a, b).to_bits(), r6(a, b).to_bits());\n\n        let c7: Symbol<extern \"C\" fn(C2v) -> f32> = cl.get(b\"c2Len\").unwrap();\n        let r7: Symbol<extern \"C\" fn(C2v) -> f32> = rl.get(b\"c2Len\").unwrap();\n        assert_eq!(c7(a).to_bits(), r7(a).to_bits());\n\n        let c8: Symbol<extern \"C\" fn(C2v) -> C2v> = cl.get(b\"c2Neg\").unwrap();\n        let r8: Symbol<extern \"C\" fn(C2v) -> C2v> = rl.get(b\"c2Neg\").unwrap();\n        assert_eq!(c8(a), r8(a));\n\n        let c9: Symbol<extern \"C\" fn(C2v) -> C2v> = cl.get(b\"c2Skew\").unwrap();\n        let r9: Symbol<extern \"C\" fn(C2v) -> C2v> = rl.get(b\"c2Skew\").unwrap();\n        assert_eq!(c9(a), r9(a));\n\n        let c10: Symbol<extern \"C\" fn(C2v) -> C2v> = cl.get(b\"c2CCW90\").unwrap();\n        let r10: Symbol<extern \"C\" fn(C2v) -> C2v> = rl.get(b\"c2CCW90\").unwrap();\n        assert_eq!(c10(a), r10(a));\n\n        let c11: Symbol<extern \"C\" fn(C2v, f32) -> C2v> = cl.get(b\"c2Div\").unwrap();\n        let r11: Symbol<extern \"C\" fn(C2v, f32) -> C2v> = rl.get(b\"c2Div\").unwrap();\n        assert_eq!(c11(a, 2.5), r11(a, 2.5));\n\n        let c12: Symbol<extern \"C\" fn(C2v) -> C2v> = cl.get(b\"c2Norm\").unwrap();\n        let r12: Symbol<extern \"C\" fn(C2v) -> C2v> = rl.get(b\"c2Norm\").unwrap();\n        assert_eq!(c12(a), r12(a));\n    }\n}\n\n#[test]\nfn test_clampv() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let cf: Symbol<extern \"C\" fn(C2v, C2v, C2v) -> C2v> = cl.get(b\"c2Clampv\").unwrap();\n        let rf: Symbol<extern \"C\" fn(C2v, C2v, C2v) -> C2v> = rl.get(b\"c2Clampv\").unwrap();\n        let a = C2v { x: 5.0, y: -5.0 };\n        let lo = C2v { x: -1.0, y: -1.0 };\n        let hi = C2v { x: 3.0, y: 3.0 };\n        assert_eq!(cf(a, lo, hi), rf(a, lo, hi));\n    }\n}\n\n#[test]\nfn test_rot_identity() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let cf: Symbol<extern \"C\" fn() -> C2r> = cl.get(b\"c2RotIdentity\").unwrap();\n        let rf: Symbol<extern \"C\" fn() -> C2r> = rl.get(b\"c2RotIdentity\").unwrap();\n        assert_eq!(cf(), rf());\n\n        let cf2: Symbol<extern \"C\" fn() -> C2x> = cl.get(b\"c2xIdentity\").unwrap();\n        let rf2: Symbol<extern \"C\" fn() -> C2x> = rl.get(b\"c2xIdentity\").unwrap();\n        assert_eq!(cf2(), rf2());\n    }\n}\n\n#[test]\nfn test_mulrv_mulxv_mulrvT() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let r = C2r { c: 0.6, s: 0.8 };\n        let v = C2v { x: 1.0, y: 2.0 };\n        let cf: Symbol<extern \"C\" fn(C2r, C2v) -> C2v> = cl.get(b\"c2Mulrv\").unwrap();\n        let rf: Symbol<extern \"C\" fn(C2r, C2v) -> C2v> = rl.get(b\"c2Mulrv\").unwrap();\n        assert_eq!(cf(r, v), rf(r, v));\n\n        let cf2: Symbol<extern \"C\" fn(C2r, C2v) -> C2v> = cl.get(b\"c2MulrvT\").unwrap();\n        let rf2: Symbol<extern \"C\" fn(C2r, C2v) -> C2v> = rl.get(b\"c2MulrvT\").unwrap();\n        assert_eq!(cf2(r, v), rf2(r, v));\n\n        let x = C2x { p: C2v { x: 5.0, y: 6.0 }, r };\n        let cf3: Symbol<extern \"C\" fn(C2x, C2v) -> C2v> = cl.get(b\"c2Mulxv\").unwrap();\n        let rf3: Symbol<extern \"C\" fn(C2x, C2v) -> C2v> = rl.get(b\"c2Mulxv\").unwrap();\n        assert_eq!(cf3(x, v), rf3(x, v));\n    }\n}\n\n#[test]\nfn test_bbverts() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let cf: Symbol<unsafe extern \"C\" fn(*mut C2v, *mut C2AABB)> = cl.get(b\"c2BBVerts\").unwrap();\n        let rf: Symbol<unsafe extern \"C\" fn(*mut C2v, *mut C2AABB)> = rl.get(b\"c2BBVerts\").unwrap();\n        let mut bb = C2AABB {\n            min: C2v { x: -1.0, y: -2.0 },\n            max: C2v { x: 3.0, y: 4.0 },\n        };\n        let mut out_c = [C2v::default(); 4];\n        let mut out_r = [C2v::default(); 4];\n        cf(out_c.as_mut_ptr(), &mut bb);\n        rf(out_r.as_mut_ptr(), &mut bb);\n        assert_eq!(out_c, out_r);\n    }\n}\n\n#[test]\nfn test_makeproxy() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let cf: Symbol<unsafe extern \"C\" fn(*const c_void, c_int, *mut C2Proxy)> =\n            cl.get(b\"c2MakeProxy\").unwrap();\n        let rf: Symbol<unsafe extern \"C\" fn(*const c_void, c_int, *mut C2Proxy)> =\n            rl.get(b\"c2MakeProxy\").unwrap();\n\n        // Circle\n        let c = C2Circle {\n            p: C2v { x: 1.0, y: 2.0 },\n            r: 3.0,\n        };\n        let mut pc = C2Proxy::default();\n        let mut pr = C2Proxy::default();\n        cf(&c as *const _ as *const c_void, 0, &mut pc);\n        rf(&c as *const _ as *const c_void, 0, &mut pr);\n        assert_eq!(pc.radius, pr.radius);\n        assert_eq!(pc.count, pr.count);\n        assert_eq!(pc.verts, pr.verts);\n\n        // AABB\n        let bb = C2AABB {\n            min: C2v { x: -1.0, y: -1.0 },\n            max: C2v { x: 1.0, y: 1.0 },\n        };\n        let mut pc = C2Proxy::default();\n        let mut pr = C2Proxy::default();\n        cf(&bb as *const _ as *const c_void, 1, &mut pc);\n        rf(&bb as *const _ as *const c_void, 1, &mut pr);\n        assert_eq!(pc.radius, pr.radius);\n        assert_eq!(pc.count, pr.count);\n        assert_eq!(pc.verts, pr.verts);\n\n        // Capsule\n        let cap = C2Capsule {\n            a: C2v { x: 0.0, y: 0.0 },\n            b: C2v { x: 5.0, y: 5.0 },\n            r: 2.0,\n        };\n        let mut pc = C2Proxy::default();\n        let mut pr = C2Proxy::default();\n        cf(&cap as *const _ as *const c_void, 2, &mut pc);\n        rf(&cap as *const _ as *const c_void, 2, &mut pr);\n        assert_eq!(pc.radius, pr.radius);\n        assert_eq!(pc.count, pr.count);\n        assert_eq!(pc.verts, pr.verts);\n    }\n}\n\n#[test]\nfn test_support() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let cf: Symbol<unsafe extern \"C\" fn(*const C2v, c_int, C2v) -> c_int> =\n            cl.get(b\"c2Support\").unwrap();\n        let rf: Symbol<unsafe extern \"C\" fn(*const C2v, c_int, C2v) -> c_int> =\n            rl.get(b\"c2Support\").unwrap();\n        let verts = [\n            C2v { x: 0.0, y: 0.0 },\n            C2v { x: 1.0, y: 0.0 },\n            C2v { x: 0.0, y: 1.0 },\n            C2v { x: -1.0, y: -1.0 },\n        ];\n        for d in &[\n            C2v { x: 1.0, y: 0.0 },\n            C2v { x: 0.0, y: 1.0 },\n            C2v { x: -1.0, y: -1.0 },\n            C2v { x: 0.5, y: 0.5 },\n        ] {\n            assert_eq!(\n                cf(verts.as_ptr(), verts.len() as c_int, *d),\n                rf(verts.as_ptr(), verts.len() as c_int, *d)\n            );\n        }\n    }\n}\n\nfn make_simplex_3() -> C2Simplex {\n    let mut s = C2Simplex::default();\n    s.a.p = C2v { x: 1.0, y: 0.0 };\n    s.b.p = C2v { x: -1.0, y: 0.5 };\n    s.c.p = C2v { x: 0.0, y: 1.0 };\n    s.a.sA = C2v { x: 1.0, y: 0.5 };\n    s.a.sB = C2v { x: 2.0, y: 0.5 };\n    s.b.sA = C2v { x: -1.0, y: 0.6 };\n    s.b.sB = C2v { x: 0.5, y: 0.7 };\n    s.c.sA = C2v { x: 0.0, y: 1.0 };\n    s.c.sB = C2v { x: 0.0, y: 1.5 };\n    s.a.u = 1.0;\n    s.b.u = 1.0;\n    s.c.u = 1.0;\n    s.div = 3.0;\n    s.count = 3;\n    s\n}\n\n#[test]\nfn test_simplex_metric() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let cf: Symbol<unsafe extern \"C\" fn(*mut C2Simplex) -> f32> =\n            cl.get(b\"c2GJKSimplexMetric\").unwrap();\n        let rf: Symbol<unsafe extern \"C\" fn(*mut C2Simplex) -> f32> =\n            rl.get(b\"c2GJKSimplexMetric\").unwrap();\n        for c in 1..=3 {\n            let mut s = make_simplex_3();\n            s.count = c;\n            let mut s2 = s;\n            assert_eq!(cf(&mut s).to_bits(), rf(&mut s2).to_bits());\n        }\n    }\n}\n\n#[test]\nfn test_c2_c22_c23() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let c22c: Symbol<unsafe extern \"C\" fn(*mut C2Simplex)> = cl.get(b\"c22\").unwrap();\n        let c22r: Symbol<unsafe extern \"C\" fn(*mut C2Simplex)> = rl.get(b\"c22\").unwrap();\n        let mut s1 = make_simplex_3();\n        s1.count = 2;\n        let mut s2 = s1;\n        c22c(&mut s1);\n        c22r(&mut s2);\n        assert_eq!(s1, s2);\n\n        let c23c: Symbol<unsafe extern \"C\" fn(*mut C2Simplex)> = cl.get(b\"c23\").unwrap();\n        let c23r: Symbol<unsafe extern \"C\" fn(*mut C2Simplex)> = rl.get(b\"c23\").unwrap();\n        let mut s1 = make_simplex_3();\n        let mut s2 = s1;\n        c23c(&mut s1);\n        c23r(&mut s2);\n        assert_eq!(s1, s2);\n    }\n}\n\n#[test]\nfn test_d_l_witness() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let dc: Symbol<unsafe extern \"C\" fn(*mut C2Simplex) -> C2v> = cl.get(b\"c2D\").unwrap();\n        let dr: Symbol<unsafe extern \"C\" fn(*mut C2Simplex) -> C2v> = rl.get(b\"c2D\").unwrap();\n\n        for c in 1..=3 {\n            let mut s = make_simplex_3();\n            s.count = c;\n            let mut s2 = s;\n            assert_eq!(dc(&mut s), dr(&mut s2));\n        }\n\n        let lc: Symbol<unsafe extern \"C\" fn(*mut C2Simplex) -> C2v> = cl.get(b\"c2L\").unwrap();\n        let lr: Symbol<unsafe extern \"C\" fn(*mut C2Simplex) -> C2v> = rl.get(b\"c2L\").unwrap();\n        for c in 1..=3 {\n            let mut s = make_simplex_3();\n            s.count = c;\n            let mut s2 = s;\n            assert_eq!(lc(&mut s), lr(&mut s2));\n        }\n\n        let wc: Symbol<unsafe extern \"C\" fn(*mut C2Simplex, *mut C2v, *mut C2v)> =\n            cl.get(b\"c2Witness\").unwrap();\n        let wr: Symbol<unsafe extern \"C\" fn(*mut C2Simplex, *mut C2v, *mut C2v)> =\n            rl.get(b\"c2Witness\").unwrap();\n        for c in 1..=3 {\n            let mut s = make_simplex_3();\n            s.count = c;\n            let mut s2 = s;\n            let mut a1 = C2v::default();\n            let mut b1 = C2v::default();\n            let mut a2 = C2v::default();\n            let mut b2 = C2v::default();\n            wc(&mut s, &mut a1, &mut b1);\n            wr(&mut s2, &mut a2, &mut b2);\n            assert_eq!(a1, a2);\n            assert_eq!(b1, b2);\n        }\n    }\n}\n\n#[test]\nfn test_gjk_circle_capsule() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let cf: Symbol<\n            unsafe extern \"C\" fn(\n                *const c_void,\n                c_int,\n                *const C2x,\n                *const c_void,\n                c_int,\n                *const C2x,\n                *mut C2v,\n                *mut C2v,\n                c_int,\n                *mut c_int,\n                *mut C2GJKCache,\n            ) -> f32,\n        > = cl.get(b\"c2GJK\").unwrap();\n        let rf: Symbol<\n            unsafe extern \"C\" fn(\n                *const c_void,\n                c_int,\n                *const C2x,\n                *const c_void,\n                c_int,\n                *const C2x,\n                *mut C2v,\n                *mut C2v,\n                c_int,\n                *mut c_int,\n                *mut C2GJKCache,\n            ) -> f32,\n        > = rl.get(b\"c2GJK\").unwrap();\n\n        let circle = C2Circle {\n            p: C2v { x: 0.0, y: 0.0 },\n            r: 15.0,\n        };\n        let cap = C2Capsule {\n            a: C2v { x: 100.0, y: -25.0 },\n            b: C2v { x: 75.0, y: 100.0 },\n            r: 10.0,\n        };\n        let mut a_c = C2v::default();\n        let mut b_c = C2v::default();\n        let mut a_r = C2v::default();\n        let mut b_r = C2v::default();\n        let mut iter_c = 0;\n        let mut iter_r = 0;\n        let mut cache_c = C2GJKCache::default();\n        let mut cache_r = C2GJKCache::default();\n\n        let dc = cf(\n            &circle as *const _ as *const c_void,\n            0,\n            std::ptr::null(),\n            &cap as *const _ as *const c_void,\n            2,\n            std::ptr::null(),\n            &mut a_c,\n            &mut b_c,\n            1,\n            &mut iter_c,\n            &mut cache_c,\n        );\n        let dr = rf(\n            &circle as *const _ as *const c_void,\n            0,\n            std::ptr::null(),\n            &cap as *const _ as *const c_void,\n            2,\n            std::ptr::null(),\n            &mut a_r,\n            &mut b_r,\n            1,\n            &mut iter_r,\n            &mut cache_r,\n        );\n        assert_eq!(dc.to_bits(), dr.to_bits());\n        assert_eq!(a_c, a_r);\n        assert_eq!(b_c, b_r);\n        assert_eq!(iter_c, iter_r);\n        assert_eq!(cache_c, cache_r);\n\n        // Run again with the cache populated\n        let dc2 = cf(\n            &circle as *const _ as *const c_void,\n            0,\n            std::ptr::null(),\n            &cap as *const _ as *const c_void,\n            2,\n            std::ptr::null(),\n            &mut a_c,\n            &mut b_c,\n            1,\n            &mut iter_c,\n            &mut cache_c,\n        );\n        let dr2 = rf(\n            &circle as *const _ as *const c_void,\n            0,\n            std::ptr::null(),\n            &cap as *const _ as *const c_void,\n            2,\n            std::ptr::null(),\n            &mut a_r,\n            &mut b_r,\n            1,\n            &mut iter_r,\n            &mut cache_r,\n        );\n        assert_eq!(dc2.to_bits(), dr2.to_bits());\n        assert_eq!(a_c, a_r);\n        assert_eq!(b_c, b_r);\n        assert_eq!(iter_c, iter_r);\n        assert_eq!(cache_c, cache_r);\n    }\n}\n\n#[test]\nfn test_gjk_aabb_capsule_overlapping() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let cf: Symbol<\n            unsafe extern \"C\" fn(\n                *const c_void,\n                c_int,\n                *const C2x,\n                *const c_void,\n                c_int,\n                *const C2x,\n                *mut C2v,\n                *mut C2v,\n                c_int,\n                *mut c_int,\n                *mut C2GJKCache,\n            ) -> f32,\n        > = cl.get(b\"c2GJK\").unwrap();\n        let rf: Symbol<\n            unsafe extern \"C\" fn(\n                *const c_void,\n                c_int,\n                *const C2x,\n                *const c_void,\n                c_int,\n                *const C2x,\n                *mut C2v,\n                *mut C2v,\n                c_int,\n                *mut c_int,\n                *mut C2GJKCache,\n            ) -> f32,\n        > = rl.get(b\"c2GJK\").unwrap();\n\n        let bb = C2AABB {\n            min: C2v { x: -1.0, y: -1.0 },\n            max: C2v { x: 1.0, y: 1.0 },\n        };\n        let cap = C2Capsule {\n            a: C2v { x: 0.5, y: 0.5 },\n            b: C2v { x: 5.0, y: 5.0 },\n            r: 0.1,\n        };\n        let mut a_c = C2v::default();\n        let mut b_c = C2v::default();\n        let mut a_r = C2v::default();\n        let mut b_r = C2v::default();\n\n        let dc = cf(\n            &bb as *const _ as *const c_void,\n            1,\n            std::ptr::null(),\n            &cap as *const _ as *const c_void,\n            2,\n            std::ptr::null(),\n            &mut a_c,\n            &mut b_c,\n            1,\n            std::ptr::null_mut(),\n            std::ptr::null_mut(),\n        );\n        let dr = rf(\n            &bb as *const _ as *const c_void,\n            1,\n            std::ptr::null(),\n            &cap as *const _ as *const c_void,\n            2,\n            std::ptr::null(),\n            &mut a_r,\n            &mut b_r,\n            1,\n            std::ptr::null_mut(),\n            std::ptr::null_mut(),\n        );\n        assert_eq!(dc.to_bits(), dr.to_bits());\n        assert_eq!(a_c, a_r);\n        assert_eq!(b_c, b_r);\n    }\n}\n\n#[test]\nfn test_gjk_cache_function() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let cf: Symbol<\n            unsafe extern \"C\" fn(\n                c_char,\n                *mut C2v,\n                *mut C2v,\n                f32,\n                f32,\n                f32,\n                f32,\n                f32,\n                f32,\n                f32,\n                f32,\n                f32,\n            ),\n        > = cl.get(b\"gjk_cache\").unwrap();\n        let rf: Symbol<\n            unsafe extern \"C\" fn(\n                c_char,\n                *mut C2v,\n                *mut C2v,\n                f32,\n                f32,\n                f32,\n                f32,\n                f32,\n                f32,\n                f32,\n                f32,\n                f32,\n            ),\n        > = rl.get(b\"gjk_cache\").unwrap();\n\n        let cases = [\n            (\n                0i8, -1.0f32, -1.0, 1.0, 1.0, // bb\n                0.5, 0.5, 5.0, 5.0, 0.1, // cap\n            ),\n            (\n                1, -1.0, -1.0, 1.0, 1.0, // bb\n                10.0, 10.0, 20.0, 20.0, 0.5, // cap\n            ),\n            (\n                0, -10.0, -10.0, 10.0, 10.0, // bb\n                100.0, 100.0, 150.0, 150.0, 5.0, // cap (separated)\n            ),\n        ];\n        for &(rev, a1, a2, a3, a4, b1, b2, b3, b4, b5) in &cases {\n            // The function only mutates locals - but exercise it anyway\n            let mut a9 = C2v::default();\n            let mut b9 = C2v::default();\n            cf(rev, &mut a9, &mut b9, a1, a2, a3, a4, b1, b2, b3, b4, b5);\n            rf(rev, &mut a9, &mut b9, a1, a2, a3, a4, b1, b2, b3, b4, b5);\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_detai