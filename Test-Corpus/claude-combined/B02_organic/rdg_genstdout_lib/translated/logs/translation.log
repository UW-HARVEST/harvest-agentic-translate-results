{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_6kmysj4t5tscko5l3zos5txkzaq35szd6rn3bnxdku27e5hjbkha","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01TfXsEgHtXDtC5HWE4wnoyL","name":"Write","input":{"file_path":"/tmp/harvest-translate-XCYHq0/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::ffi::{CStr, CString};\nuse std::os::raw::{c_char, c_int};\n\nconst C_LIB_PATH: &str = \"c_src/build/libdriver.so\";\nconst RUST_LIB_PATH: &str = \"target/release/libdriver.so\";\n\ntype ExtractFilenameFn = unsafe extern \"C\" fn(*const c_char, c_char) -> *const c_char;\ntype CreateFilenameFn = unsafe extern \"C\" fn(*const c_char, *const c_char, usize) -> *mut c_char;\n\nfn load_libs() -> (Library, Library) {\n    let c_lib = unsafe { Library::new(C_LIB_PATH).expect(\"Failed to load C lib\") };\n    let rust_lib = unsafe { Library::new(RUST_LIB_PATH).expect(\"Failed to load Rust lib\") };\n    (c_lib, rust_lib)\n}\n\n#[test]\nfn test_extract_filename_basic() {\n    let (c_lib, rust_lib) = load_libs();\n    unsafe {\n        let c_fn: Symbol<ExtractFilenameFn> = c_lib.get(b\"extractFilename\").unwrap();\n        let rust_fn: Symbol<ExtractFilenameFn> = rust_lib.get(b\"extractFilename\").unwrap();\n\n        let cases: &[&[u8]] = &[\n            b\"/foo/bar/baz.txt\\0\",\n            b\"file.txt\\0\",\n            b\"/single\\0\",\n            b\"/\\0\",\n            b\"\\0\",\n            b\"/a/b/c/d/e\\0\",\n            b\"a/b/c\\0\",\n            b\"no_separator_here\\0\",\n        ];\n\n        for case in cases {\n            let path = case.as_ptr() as *const c_char;\n            let c_result = c_fn(path, b'/' as c_char);\n            let rust_result = rust_fn(path, b'/' as c_char);\n\n            let c_str = CStr::from_ptr(c_result).to_bytes();\n            let rust_str = CStr::from_ptr(rust_result).to_bytes();\n            assert_eq!(c_str, rust_str, \"Mismatch for input: {:?}\", case);\n        }\n    }\n}\n\n#[test]\nfn test_extract_filename_other_separator() {\n    let (c_lib, rust_lib) = load_libs();\n    unsafe {\n        let c_fn: Symbol<ExtractFilenameFn> = c_lib.get(b\"extractFilename\").unwrap();\n        let rust_fn: Symbol<ExtractFilenameFn> = rust_lib.get(b\"extractFilename\").unwrap();\n\n        let inputs: &[(&[u8], u8)] = &[\n            (b\"a\\\\b\\\\c\\0\", b'\\\\'),\n            (b\"hello\\0\", b'x'),\n            (b\"xxx\\0\", b'x'),\n        ];\n\n        for (case, sep) in inputs {\n            let path = case.as_ptr() as *const c_char;\n            let c_result = c_fn(path, *sep as c_char);\n            let rust_result = rust_fn(path, *sep as c_char);\n\n            let c_str = CStr::from_ptr(c_result).to_bytes();\n            let rust_str = CStr::from_ptr(rust_result).to_bytes();\n            assert_eq!(c_str, rust_str, \"Mismatch for input: {:?}, sep: {}\", case, *sep as char);\n        }\n    }\n}\n\n#[test]\nfn test_create_filename_from_outdir() {\n    let (c_lib, rust_lib) = load_libs();\n    unsafe {\n        let c_fn: Symbol<CreateFilenameFn> = c_lib.get(b\"FIO_createFilename_fromOutDir\").unwrap();\n        let rust_fn: Symbol<CreateFilenameFn> = rust_lib.get(b\"FIO_createFilename_fromOutDir\").unwrap();\n\n        let cases: &[(&str, &str, usize)] = &[\n            (\"/foo/bar/baz.txt\", \"/output\", 0),\n            (\"/foo/bar/baz.txt\", \"/output/\", 0),\n            (\"file.txt\", \"outdir\", 0),\n            (\"file.txt\", \"outdir/\", 0),\n            (\"/path/to/file.txt\", \"out\", 4),\n            (\"/path/to/file.txt\", \"out/\", 4),\n            (\"nopath\", \"/o\", 0),\n            (\"a/b/c/d/e\", \"/dir\", 10),\n            (\"file\", \"/\", 0),\n            (\"/foo\", \"x\", 0),\n        ];\n\n        for (path, out_dir, suffix_len) in cases {\n            let path_c = CString::new(*path).unwrap();\n            let out_dir_c = CString::new(*out_dir).unwrap();\n\n            let c_result = c_fn(path_c.as_ptr(), out_dir_c.as_ptr(), *suffix_len);\n            let rust_result = rust_fn(path_c.as_ptr(), out_dir_c.as_ptr(), *suffix_len);\n\n            assert!(!c_result.is_null());\n            assert!(!rust_result.is_null());\n\n            let c_str = CStr::from_ptr(c_result).to_bytes();\n            let rust_str = CStr::from_ptr(rust_result).to_bytes();\n            assert_eq!(\n                c_str, rust_str,\n                \"Mismatch for path={}, outDir={}, suffixLen={}\",\n                path, out_dir, suffix_len\n            );\n\n            // Also compare full buffer including suffix area (zeros expected after the string)\n            let full_size = out_dir.len() + 1 + extract_filename(path, '/').len() + suffix_len + 1;\n            let c_slice = std::slice::from_raw_parts(c_result as *const u8, full_size);\n            let rust_slice = std::slice::from_raw_parts(rust_result as *const u8, full_size);\n            assert_eq!(\n                c_slice, rust_slice,\n                \"Full buffer mismatch for path={}, outDir={}, suffixLen={}\",\n                path, out_dir, suffix_len\n            );\n\n            libc::free(c_result as *mut _);\n            libc::free(rust_result as *mut _);\n        }\n    }\n}\n\nfn extract_filename(path: &str, sep: char) -> &str {\n    match path.rfind(sep) {\n        Some(i) => &path[i + 1..],\n        None => path,\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":163,"cache_read_input_tokens":19919,"cache_creation":{"ephemeral_5m_input_tokens":163,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0bc893e1-9bb2-493e-a8bc-7ec7e26faef5","uuid":"abad1749-0e28-4c09-b00b-a5abfcda8f27"}
