\n    }\n}\n\nfn compare(name: &str, png_bytes: &[u8]) {\n    unsafe {\n        let c_result = call_load_png(C_LIB, png_bytes);\n        let rust_result = call_load_png(RUST_LIB, png_bytes);\n        assert_eq!(\n            c_result.is_some(),\n            rust_result.is_some(),\n            \"Test {}: C result success={:?} but Rust result success={:?}\",\n            name,\n            c_result.is_some(),\n            rust_result.is_some()\n        );\n        if let (Some(c), Some(r)) = (c_result, rust_result) {\n            assert_eq!(c.len(), r.len(), \"Test {}: Pixel count mismatch\", name);\n            assert_eq!(c, r, \"Test {}: Pixel data mismatch\", name);\n        }\n    }\n}\n\n// Generated PNG test data (from Python)\nconst PNG1_RGB_2X2: &[u8] = &[\n    137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 2, 0, 0, 0, 2, 8, 2, 0,\n    0, 0, 253, 212, 154, 115, 0, 0, 0, 20, 73, 68, 65, 84, 120, 156, 99, 248, 207, 192, 192, 0,\n    194, 12, 255, 255, 255, 103, 0, 0, 30, 239, 4, 252, 163, 200, 180, 247, 0, 0, 0, 0, 73, 69, 78,\n    68, 174, 66, 96, 130,\n];\n\nconst PNG2_RGBA_1X1: &[u8] = &[\n    137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 1, 0, 0, 0, 1, 8, 6, 0,\n    0, 0, 31, 21, 196, 137, 0, 0, 0, 13, 73, 68, 65, 84, 120, 156, 99, 248, 223, 224, 240, 31, 0,\n    7, 0, 2, 191, 43, 215, 199, 226, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130,\n];\n\nconst PNG3_RGBA_4X3: &[u8] = &[\n    137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 4, 0, 0, 0, 3, 8, 6, 0,\n    0, 0, 180, 244, 174, 198, 0, 0, 0, 50, 73, 68, 65, 84, 120, 156, 13, 200, 65, 1, 0, 48, 12, 2,\n    49, 228, 76, 68, 69, 32, 7, 57, 136, 168, 136, 185, 186, 45, 207, 72, 18, 163, 67, 100, 86, 65,\n    242, 97, 108, 226, 176, 238, 143, 154, 105, 72, 203, 246, 242, 0, 16, 153, 24, 157, 222, 103,\n    195, 177, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130,\n];\n\nconst PNG4_GRAY_2X2: &[u8] = &[\n    137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 2, 0, 0, 0, 2, 8, 0, 0,\n    0, 0, 87, 221, 82, 248, 0, 0, 0, 14, 73, 68, 65, 84, 120, 156, 99, 16, 80, 96, 48, 112, 0, 0,\n    1, 118, 0, 161, 236, 48, 138, 244, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130,\n];\n\nconst PNG5_INDEXED_2X2: &[u8] = &[\n    137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 2, 0, 0, 0, 2, 8, 3, 0,\n    0, 0, 69, 104, 253, 22, 0, 0, 0, 12, 80, 76, 84, 69, 255, 0, 0, 0, 255, 0, 0, 0, 255, 255, 255,\n    0, 214, 2, 143, 123, 0, 0, 0, 4, 116, 82, 78, 83, 255, 128, 64, 32, 71, 180, 20, 38, 0, 0, 0,\n    14, 73, 68, 65, 84, 120, 156, 99, 96, 96, 100, 96, 98, 6, 0, 0, 17, 0, 7, 158, 162, 42, 18, 0,\n    0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130,\n];\n\nconst PNG6_GRAYA_2X2: &[u8] = &[\n    137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 2, 0, 0, 0, 2, 8, 4, 0,\n    0, 0, 216, 191, 197, 175, 0, 0, 0, 18, 73, 68, 65, 84, 120, 156, 99, 16, 248, 175, 208, 192,\n    96, 224, 224, 192, 0, 0, 14, 114, 2, 96, 128, 184, 105, 251, 0, 0, 0, 0, 73, 69, 78, 68, 174,\n    66, 96, 130,\n];\n\nconst PNG7_LARGE_RGBA: &[u8] = &[\n    137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 8, 0, 0, 0, 6, 8, 6, 0,\n    0, 0, 254, 5, 223, 251, 0, 0, 0, 209, 73, 68, 65, 84, 120, 156, 1, 198, 0, 57, 255, 0, 57, 12,\n    140, 125, 114, 71, 52, 44, 216, 16, 15, 47, 111, 119, 13, 101, 214, 112, 229, 142, 3, 81, 216,\n    174, 142, 79, 110, 172, 52, 47, 194, 49, 1, 183, 176, 135, 22, 235, 63, 193, 40, 150, 185, 98,\n    35, 23, 116, 148, 40, 119, 51, 194, 142, 232, 186, 83, 189, 181, 107, 136, 36, 87, 125, 83,\n    236, 2, 194, 138, 112, 166, 28, 117, 16, 161, 205, 137, 33, 108, 161, 108, 255, 202, 234, 73,\n    135, 71, 126, 134, 219, 204, 185, 112, 70, 252, 46, 24, 56, 78, 3, 81, 216, 32, 197, 195, 239,\n    128, 5, 58, 136, 174, 57, 150, 222, 80, 232, 1, 134, 91, 54, 152, 101, 78, 191, 82, 0, 165,\n    250, 9, 57, 185, 157, 4, 122, 29, 123, 40, 43, 248, 35, 64, 65, 243, 84, 135, 216, 108, 102,\n    159, 204, 191, 224, 231, 61, 126, 115, 32, 173, 10, 117, 112, 3, 36, 30, 117, 0, 34, 16, 169,\n    36, 121, 142, 248, 109, 67, 242, 124, 242, 208, 97, 48, 49, 220, 181, 216, 210, 239, 27, 50,\n    31, 206, 173, 55, 127, 98, 97, 229, 71, 59, 189, 90, 118, 230, 196, 109, 142, 0, 0, 0, 0, 73,\n    69, 78, 68, 174, 66, 96, 130,\n];\n\n#[test]\nfn test_rgb_2x2() {\n    compare(\"RGB_2x2\", PNG1_RGB_2X2);\n}\n\n#[test]\nfn test_rgba_1x1() {\n    compare(\"RGBA_1x1\", PNG2_RGBA_1X1);\n}\n\n#[test]\nfn test_rgba_4x3() {\n    compare(\"RGBA_4x3\", PNG3_RGBA_4X3);\n}\n\n#[test]\nfn test_gray_2x2() {\n    compare(\"GRAY_2x2\", PNG4_GRAY_2X2);\n}\n\n#[test]\nfn test_indexed_2x2() {\n    compare(\"INDEXED_2x2\", PNG5_INDEXED_2X2);\n}\n\n#[test]\nfn test_graya_2x2() {\n    compare(\"GRAYA_2x2\", PNG6_GRAYA_2X2);\n}\n\n#[test]\nfn test_large_rgba() {\n    compare(\"LARGE_RGBA\", PNG7_LARGE_RGBA);\n}\n\n#[test]\nfn test_invalid_signature() {\n    // Garbage data: signature is wrong\n    let bad_data = vec![0u8; 100];\n    unsafe {\n        let c_result = call_load_png(C_LIB, &bad_data);\n        let rust_result = call_load_png(RUST_LIB, &bad_data);\n        assert_eq!(\n            c_result.is_none(),\n            rust_result.is_none(),\n            \"Both should fail for invalid signature\"\n        );\n    }\n}\n\n#[test]\nfn test_truncated() {\n    // Just the PNG signature\n    let sig = b\"\\x89PNG\\r\\n\\x1a\\n\";\n    unsafe {\n        let c_result = call_load_png(C_LIB, sig);\n        let rust_result = call_load_png(RUST_LIB, sig);\n        assert_eq!(\n            c_result.is_none(),\n            rust_result.is_none(),\n            \"Both should fail for truncated input\"\n        );\n    }\n}\n\n// Test cp_inflate directly via FFI\ntype CpInflateFn = unsafe extern \"C\" fn(\n    *mut std::ffi::c_void,\n    c_int,\n    *mut std::ffi::c_void,\n    c_int,\n) -> c_int;\n\nunsafe fn call_cp_inflate(lib_path: &str, in_data: &[u8], out_size: usize) -> Option<Vec<u8>> {\n    unsafe {\n        let lib = Library::new(lib_path).expect(\"failed to load library\");\n        let func: Symbol<CpInflateFn> = lib.get(b\"cp_inflate\").expect(\"missing cp_inflate\");\n        let mut input = in_data.to_vec();\n        let mut output = vec![0u8; out_size];\n        let result = func(\n            input.as_mut_ptr() as *mut std::ffi::c_void,\n            input.len() as c_int,\n            output.as_mut_ptr() as *mut std::ffi::c_void,\n            output.len() as c_int,\n        );\n        if result == 0 {\n            None\n        } else {\n            Some(output)\n        }\n    }\n}\n\n#[test]\nfn test_cp_inflate_simple() {\n    // A trivial fixed Huffman block: just an end-of-block code (256).\n    // In fixed Huffman tables, code 256 is encoded as 7 bits 0000000.\n    // Block header: BFINAL=1, BTYPE=01 (fixed) => bits 1, 01\n    // Bits emitted little-endian: bfinal=1 (bit 0), btype=01 (bits 1,2 = 1,0)\n    // EOB code 0000000 (7 bits, code value 0 reversed). Actually fixed Huffman\n    // code for symbol 256 is 7 bits, value 0. Reverse of 0 is 0. So 7 zero bits.\n    // First byte: bfinal=1, btype low=1, btype high=0, then 5 zero bits = 0b00000011 = 0x03\n    // That gives us 8 bits total: bfinal+btype = 3 bits, then 5 of the 7 EOB bits\n    // remaining 2 bits (zero) in next byte: 0x00\n    let input = vec![0x03, 0x00];\n    let c_result = unsafe { call_cp_inflate(C_LIB, &input, 0) };\n    let rust_result = unsafe { call_cp_inflate(RUST_LIB, &input, 0) };\n    assert_eq!(c_result.is_some(), rust_result.is_some());\n    if let (Some(c), Some(r)) = (c_result, rust_result) {\n        assert_eq!(c, r);\n    }\n}\n\n#[test]\nfn test_cp_inflate_uncompressed_block() {\n    // An uncompressed (stored) block containing \"Hello\"\n    // Block header: BFINAL=1, BTYPE=00\n    // Pad to byte, then LEN (16 bits), NLEN (~LEN, 16 bits), then data\n    let payload = b\"Hello\";\n    let len: u16 = payload.len() as u16;\n    let nlen: u16 = !len;\n    let mut input: Vec<u8> = vec![0x01]; // bfinal=1, btype=00\n    input.push((len & 0xff) as u8);\n    input.push((len >> 8) as u8);\n    input.push((nlen & 0xff) as u8);\n    input.push((nlen >> 8) as u8);\n    input.extend_from_slice(payload);\n    let c_result = unsafe { call_cp_inflate(C_LIB, &input, payload.len()) };\n    let rust_result = unsafe { call_cp_inflate(RUST_LIB, &input, payload.len()) };\n    assert_eq!(c_result.is_some(), rust_result.is_some());\n    if let (Some(c), Some(r)) = (c_result, rust_result) {\n        assert_eq!(c, r);\n        assert_eq!(&c[..], payload);\n    }\n}\n\n// Use libc crate for free\nmod libc {\n    use std::os::raw::c_void;\n    extern \"C\" {\n        pub fn free(ptr: *mut c_void);\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":7,"lines":[" // Integration test: compare C and Rust implementations via FFI"," "," use libloading::{Library, Symbol};","-use std::os::raw::{c_char, c_int};","+use std::os::raw::c_int;"," "," #[repr(C)]"," #[derive(Copy, Clone, Debug, PartialEq, Eq)]"]}],"userModified":false,"replaceAll":false}}
