2v { x: 0.0, y: 0.0 },\n            r: 1.0,\n        };\n        for p in [\n            C2v { x: 0.0, y: 0.0 },\n            C2v { x: 0.5, y: 0.5 },\n            C2v { x: 1.0, y: 0.0 },\n            C2v { x: 2.0, y: 0.0 },\n        ] {\n            assert_eq!(f_c(circle, p), f_r(circle, p));\n        }\n    }\n}\n\n#[test]\nfn test_ray_to_circle() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<unsafe extern \"C\" fn(C2Ray, C2Circle, *mut C2Raycast) -> c_int> =\n            c.get(b\"c2RaytoCircle\").unwrap();\n        let f_r: Symbol<unsafe extern \"C\" fn(C2Ray, C2Circle, *mut C2Raycast) -> c_int> =\n            r.get(b\"c2RaytoCircle\").unwrap();\n        let circle = C2Circle {\n            p: C2v { x: 5.0, y: 0.0 },\n            r: 1.0,\n        };\n        let ray = C2Ray {\n            p: C2v { x: 0.0, y: 0.0 },\n            d: C2v { x: 1.0, y: 0.0 },\n            t: 10.0,\n        };\n        let mut out_c = C2Raycast {\n            t: 0.0,\n            n: C2v { x: 0.0, y: 0.0 },\n        };\n        let mut out_r = out_c;\n        let rc = f_c(ray, circle, &mut out_c);\n        let rr = f_r(ray, circle, &mut out_r);\n        assert_eq!(rc, rr);\n        if rc != 0 {\n            assert!(raycast_eq(&out_c, &out_r));\n        }\n\n        // Miss case\n        let circle2 = C2Circle {\n            p: C2v { x: 0.0, y: 5.0 },\n            r: 0.5,\n        };\n        let rc2 = f_c(ray, circle2, &mut out_c);\n        let rr2 = f_r(ray, circle2, &mut out_r);\n        assert_eq!(rc2, rr2);\n    }\n}\n\n#[test]\nfn test_ray_to_aabb() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<unsafe extern \"C\" fn(C2Ray, C2AABB, *mut C2Raycast) -> c_int> =\n            c.get(b\"c2RaytoAABB\").unwrap();\n        let f_r: Symbol<unsafe extern \"C\" fn(C2Ray, C2AABB, *mut C2Raycast) -> c_int> =\n            r.get(b\"c2RaytoAABB\").unwrap();\n        let aabb = C2AABB {\n            min: C2v { x: 5.0, y: -1.0 },\n            max: C2v { x: 7.0, y: 1.0 },\n        };\n        let cases = [\n            C2Ray {\n                p: C2v { x: 0.0, y: 0.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 10.0,\n            },\n            C2Ray {\n                p: C2v { x: 0.0, y: 0.0 },\n                d: C2v { x: 0.0, y: 1.0 },\n                t: 10.0,\n            },\n            C2Ray {\n                p: C2v { x: 6.0, y: 0.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 1.0,\n            },\n            C2Ray {\n                p: C2v { x: 10.0, y: 5.0 },\n                d: C2v { x: -1.0, y: -0.5 },\n                t: 10.0,\n            },\n        ];\n        for ray in cases {\n            let mut out_c = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut out_r = out_c;\n            let rc = f_c(ray, aabb, &mut out_c);\n            let rr = f_r(ray, aabb, &mut out_r);\n            assert_eq!(rc, rr);\n            if rc != 0 {\n                assert!(\n                    raycast_eq(&out_c, &out_r),\n                    \"ray {:?} c {:?} r {:?}\",\n                    ray.p,\n                    out_c,\n                    out_r\n                );\n            }\n        }\n    }\n}\n\n#[test]\nfn test_ray_to_capsule() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<unsafe extern \"C\" fn(C2Ray, C2Capsule, *mut C2Raycast) -> c_int> =\n            c.get(b\"c2RaytoCapsule\").unwrap();\n        let f_r: Symbol<unsafe extern \"C\" fn(C2Ray, C2Capsule, *mut C2Raycast) -> c_int> =\n            r.get(b\"c2RaytoCapsule\").unwrap();\n        let cap = C2Capsule {\n            a: C2v { x: 0.0, y: 0.0 },\n            b: C2v { x: 0.0, y: 5.0 },\n            r: 1.0,\n        };\n        let cases = [\n            C2Ray {\n                p: C2v { x: -5.0, y: 2.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 10.0,\n            },\n            C2Ray {\n                p: C2v { x: -5.0, y: -2.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 10.0,\n            },\n            C2Ray {\n                p: C2v { x: 0.5, y: 0.0 },\n                d: C2v { x: 0.0, y: 1.0 },\n                t: 10.0,\n            },\n            C2Ray {\n                p: C2v { x: -10.0, y: 5.0 },\n                d: C2v { x: 1.0, y: 0.5 },\n                t: 20.0,\n            },\n        ];\n        for ray in cases {\n            let mut out_c = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut out_r = out_c;\n            let rc = f_c(ray, cap, &mut out_c);\n            let rr = f_r(ray, cap, &mut out_r);\n            assert_eq!(rc, rr);\n            // capsule writes to out before some return paths, compare always\n            assert!(raycast_eq(&out_c, &out_r));\n        }\n    }\n}\n\n#[test]\nfn test_ray_to_poly() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<\n            unsafe extern \"C\" fn(C2Ray, *const C2Poly, *const C2x, *mut C2Raycast) -> c_int,\n        > = c.get(b\"c2RaytoPoly\").unwrap();\n        let f_r: Symbol<\n            unsafe extern \"C\" fn(C2Ray, *const C2Poly, *const C2x, *mut C2Raycast) -> c_int,\n        > = r.get(b\"c2RaytoPoly\").unwrap();\n        let mut p = C2Poly {\n            count: 4,\n            verts: [C2v { x: 0.0, y: 0.0 }; 8],\n            norms: [C2v { x: 0.0, y: 0.0 }; 8],\n        };\n        p.verts[0] = C2v { x: 0.875, y: -11.5 };\n        p.verts[1] = C2v { x: 0.875, y: 11.5 };\n        p.verts[2] = C2v {\n            x: -0.875,\n            y: 11.5,\n        };\n        p.verts[3] = C2v {\n            x: -0.875,\n            y: -11.5,\n        };\n        p.norms[0] = C2v { x: 1.0, y: 0.0 };\n        p.norms[1] = C2v { x: 0.0, y: 1.0 };\n        p.norms[2] = C2v { x: -1.0, y: 0.0 };\n        p.norms[3] = C2v { x: 0.0, y: -1.0 };\n\n        let cases = [\n            C2Ray {\n                p: C2v {\n                    x: -3.869416,\n                    y: 13.0693407,\n                },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 4.0,\n            },\n            C2Ray {\n                p: C2v {\n                    x: -3.869416,\n                    y: 13.0693407,\n                },\n                d: C2v { x: 0.0, y: -1.0 },\n                t: 4.0,\n            },\n            C2Ray {\n                p: C2v { x: -5.0, y: 0.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 10.0,\n            },\n        ];\n        for ray in cases {\n            let mut out_c = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut out_r = out_c;\n            let rc = f_c(ray, &p, std::ptr::null(), &mut out_c);\n            let rr = f_r(ray, &p, std::ptr::null(), &mut out_r);\n            assert_eq!(rc, rr);\n            if rc != 0 {\n                assert!(raycast_eq(&out_c, &out_r));\n            }\n        }\n    }\n}\n\n#[test]\nfn test_poly_ray() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<unsafe extern \"C\" fn(*mut C2Raycast, *mut C2Raycast) -> c_int> =\n            c.get(b\"poly_ray\").unwrap();\n        let f_r: Symbol<unsafe extern \"C\" fn(*mut C2Raycast, *mut C2Raycast) -> c_int> =\n            r.get(b\"poly_ray\").unwrap();\n        let mut c1c = C2Raycast {\n            t: 0.0,\n            n: C2v { x: 0.0, y: 0.0 },\n        };\n        let mut c2c = c1c;\n        let mut c1r = c1c;\n        let mut c2r = c1c;\n        let rc = f_c(&mut c1c, &mut c2c);\n        let rr = f_r(&mut c1r, &mut c2r);\n        assert_eq!(rc, rr);\n        // Result depends on hit bits, so only compare buffers if hit set.\n        // Compare bitwise.\n        assert_eq!(c1c.t.to_bits(), c1r.t.to_bits());\n        assert_eq!(c1c.n.x.to_bits(), c1r.n.x.to_bits());\n        assert_eq!(c1c.n.y.to_bits(), c1r.n.y.to_bits());\n        assert_eq!(c2c.t.to_bits(), c2r.t.to_bits());\n        assert_eq!(c2c.n.x.to_bits(), c2r.n.x.to_bits());\n        assert_eq!(c2c.n.y.to_bits(), c2r.n.y.to_bits());\n    }\n}\n\n#[test]\nfn test_c2ccw90_mulmvt() {\n    let (c, r) = load_libs();\n    unsafe {\n        let ccw_c: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = c.get(b\"c2CCW90\").unwrap();\n        let ccw_r: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = r.get(b\"c2CCW90\").unwrap();\n        let mvt_c: Symbol<unsafe extern \"C\" fn(C2m, C2v) -> C2v> = c.get(b\"c2MulmvT\").unwrap();\n        let mvt_r: Symbol<unsafe extern \"C\" fn(C2m, C2v) -> C2v> = r.get(b\"c2MulmvT\").unwrap();\n        let v = C2v { x: 1.0, y: 2.0 };\n        assert!(v_eq(ccw_c(v), ccw_r(v)));\n        let m = C2m {\n            x: C2v { x: 1.0, y: 0.0 },\n            y: C2v { x: 0.0, y: 1.0 },\n        };\n        assert!(v_eq(mvt_c(m, v), mvt_r(m, v)));\n    }\n}\n\n#[test]\nfn test_rot_x_identity_mulrv() {\n    let (c, r) = load_libs();\n    unsafe {\n        let id_c: Symbol<unsafe extern \"C\" fn() -> C2r> = c.get(b\"c2RotIdentity\").unwrap();\n        let id_r: Symbol<unsafe extern \"C\" fn() -> C2r> = r.get(b\"c2RotIdentity\").unwrap();\n        let xid_c: Symbol<unsafe extern \"C\" fn() -> C2x> = c.get(b\"c2xIdentity\").unwrap();\n        let xid_r: Symbol<unsafe extern \"C\" fn() -> C2x> = r.get(b\"c2xIdentity\").unwrap();\n        let mulrv_c: Symbol<unsafe extern \"C\" fn(C2r, C2v) -> C2v> = c.get(b\"c2Mulrv\").unwrap();\n        let mulrv_r: Symbol<unsafe extern \"C\" fn(C2r, C2v) -> C2v> = r.get(b\"c2Mulrv\").unwrap();\n        let mulrvT_c: Symbol<unsafe extern \"C\" fn(C2r, C2v) -> C2v> = c.get(b\"c2MulrvT\").unwrap();\n        let mulrvT_r: Symbol<unsafe extern \"C\" fn(C2r, C2v) -> C2v> = r.get(b\"c2MulrvT\").unwrap();\n        let mulxvT_c: Symbol<unsafe extern \"C\" fn(C2x, C2v) -> C2v> = c.get(b\"c2MulxvT\").unwrap();\n        let mulxvT_r: Symbol<unsafe extern \"C\" fn(C2x, C2v) -> C2v> = r.get(b\"c2MulxvT\").unwrap();\n\n        let ic = id_c();\n        let ir = id_r();\n        assert_eq!(ic.c.to_bits(), ir.c.to_bits());\n        assert_eq!(ic.s.to_bits(), ir.s.to_bits());\n        let xc = xid_c();\n        let xr = xid_r();\n        assert!(v_eq(xc.p, xr.p));\n\n        let r_rot = C2r { c: 0.6, s: 0.8 };\n        let v = C2v { x: 1.5, y: -2.5 };\n        assert!(v_eq(mulrv_c(r_rot, v), mulrv_r(r_rot, v)));\n        assert!(v_eq(mulrvT_c(r_rot, v), mulrvT_r(r_rot, v)));\n\n        let xform = C2x {\n            p: C2v { x: 0.5, y: 1.0 },\n            r: r_rot,\n        };\n        assert!(v_eq(mulxvT_c(xform, v), mulxvT_r(xform, v)));\n    }\n}\n\n#[test]\nfn test_cast_ray_poly() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<\n            unsafe extern \"C\" fn(\n                C2Ray,\n                *const std::ffi::c_void,\n                *const C2x,\n                c_int,\n                *mut C2Raycast,\n            ) -> c_int,\n        > = c.get(b\"c2CastRay\").unwrap();\n        let f_r: Symbol<\n            unsafe extern \"C\" fn(\n                C2Ray,\n                *const std::ffi::c_void,\n                *const C2x,\n                c_int,\n                *mut C2Raycast,\n            ) -> c_int,\n        > = r.get(b\"c2CastRay\").unwrap();\n        let mut p = C2Poly {\n            count: 4,\n            verts: [C2v { x: 0.0, y: 0.0 }; 8],\n            norms: [C2v { x: 0.0, y: 0.0 }; 8],\n        };\n        p.verts[0] = C2v { x: 0.875, y: -11.5 };\n        p.verts[1] = C2v { x: 0.875, y: 11.5 };\n        p.verts[2] = C2v {\n            x: -0.875,\n            y: 11.5,\n        };\n        p.verts[3] = C2v {\n            x: -0.875,\n            y: -11.5,\n        };\n        p.norms[0] = C2v { x: 1.0, y: 0.0 };\n        p.norms[1] = C2v { x: 0.0, y: 1.0 };\n        p.norms[2] = C2v { x: -1.0, y: 0.0 };\n        p.norms[3] = C2v { x: 0.0, y: -1.0 };\n\n        let ray = C2Ray {\n            p: C2v {\n                x: -3.869416,\n                y: 13.0693407,\n            },\n            d: C2v { x: 1.0, y: 0.0 },\n            t: 4.0,\n        };\n        let mut out_c = C2Raycast {\n            t: 0.0,\n            n: C2v { x: 0.0, y: 0.0 },\n        };\n        let mut out_r = out_c;\n        let rc = f_c(\n            ray,\n            &p as *const C2Poly as *const _,\n            std::ptr::null(),\n            3,\n            &mut out_c,\n        );\n        let rr = f_r(\n            ray,\n            &p as *const C2Poly as *const _,\n            std::ptr::null(),\n            3,\n            &mut out_r,\n        );\n        assert_eq!(rc, rr);\n        if rc != 0 {\n            assert!(raycast_eq(&out_c, &out_r));\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
