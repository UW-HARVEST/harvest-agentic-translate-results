 y: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\nstruct C2Raycast {\n    t: f32,\n    n: C2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\nstruct C2r {\n    c: f32,\n    s: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\nstruct C2x {\n    p: C2v,\n    r: C2r,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct C2Circle {\n    p: C2v,\n    r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct C2AABB {\n    min: C2v,\n    max: C2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct C2Capsule {\n    a: C2v,\n    b: C2v,\n    r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct C2Poly {\n    count: c_int,\n    verts: [C2v; 8],\n    norms: [C2v; 8],\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct C2Ray {\n    p: C2v,\n    d: C2v,\n    t: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct C2m {\n    x: C2v,\n    y: C2v,\n}\n\nfn c_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nfn rust_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    p.push(\"release\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nfn load_libs() -> (Library, Library) {\n    unsafe {\n        let c = Library::new(c_lib_path()).expect(\"load C lib\");\n        let r = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n        (c, r)\n    }\n}\n\nfn raycast_eq(a: &C2Raycast, b: &C2Raycast) -> bool {\n    a.t.to_bits() == b.t.to_bits()\n        && a.n.x.to_bits() == b.n.x.to_bits()\n        && a.n.y.to_bits() == b.n.y.to_bits()\n}\n\nfn v_eq(a: C2v, b: C2v) -> bool {\n    a.x.to_bits() == b.x.to_bits() && a.y.to_bits() == b.y.to_bits()\n}\n\n#[test]\nfn test_c2v() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<unsafe extern \"C\" fn(f32, f32) -> C2v> = c.get(b\"c2V\").unwrap();\n        let f_r: Symbol<unsafe extern \"C\" fn(f32, f32) -> C2v> = r.get(b\"c2V\").unwrap();\n        let inputs = [(0.0f32, 0.0f32), (1.0, 2.5), (-3.0, 4.0), (1e10, -1e-10)];\n        for (x, y) in inputs {\n            let cv = f_c(x, y);\n            let rv = f_r(x, y);\n            assert!(v_eq(cv, rv));\n        }\n    }\n}\n\n#[test]\nfn test_c2dot_len() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> f32> = c.get(b\"c2Dot\").unwrap();\n        let f_r: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> f32> = r.get(b\"c2Dot\").unwrap();\n        let len_c: Symbol<unsafe extern \"C\" fn(C2v) -> f32> = c.get(b\"c2Len\").unwrap();\n        let len_r: Symbol<unsafe extern \"C\" fn(C2v) -> f32> = r.get(b\"c2Len\").unwrap();\n        for (x1, y1, x2, y2) in [\n            (0.0f32, 0.0f32, 0.0f32, 0.0f32),\n            (1.0, 2.0, 3.0, 4.0),\n            (-1.5, 2.5, 3.5, -4.5),\n        ] {\n            let a = C2v { x: x1, y: y1 };\n            let b = C2v { x: x2, y: y2 };\n            assert_eq!(f_c(a, b).to_bits(), f_r(a, b).to_bits());\n            assert_eq!(len_c(a).to_bits(), len_r(a).to_bits());\n        }\n    }\n}\n\n#[test]\nfn test_c2add_sub_mulvs_div_norm_min_max_skew_absv() {\n    let (c, r) = load_libs();\n    unsafe {\n        let add_c: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = c.get(b\"c2Add\").unwrap();\n        let add_r: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = r.get(b\"c2Add\").unwrap();\n        let sub_c: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = c.get(b\"c2Sub\").unwrap();\n        let sub_r: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = r.get(b\"c2Sub\").unwrap();\n        let mulvs_c: Symbol<unsafe extern \"C\" fn(C2v, f32) -> C2v> = c.get(b\"c2Mulvs\").unwrap();\n        let mulvs_r: Symbol<unsafe extern \"C\" fn(C2v, f32) -> C2v> = r.get(b\"c2Mulvs\").unwrap();\n        let div_c: Symbol<unsafe extern \"C\" fn(C2v, f32) -> C2v> = c.get(b\"c2Div\").unwrap();\n        let div_r: Symbol<unsafe extern \"C\" fn(C2v, f32) -> C2v> = r.get(b\"c2Div\").unwrap();\n        let norm_c: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = c.get(b\"c2Norm\").unwrap();\n        let norm_r: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = r.get(b\"c2Norm\").unwrap();\n        let minv_c: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = c.get(b\"c2Minv\").unwrap();\n        let minv_r: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = r.get(b\"c2Minv\").unwrap();\n        let maxv_c: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = c.get(b\"c2Maxv\").unwrap();\n        let maxv_r: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = r.get(b\"c2Maxv\").unwrap();\n        let skew_c: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = c.get(b\"c2Skew\").unwrap();\n        let skew_r: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = r.get(b\"c2Skew\").unwrap();\n        let absv_c: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = c.get(b\"c2Absv\").unwrap();\n        let absv_r: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = r.get(b\"c2Absv\").unwrap();\n        let cases = [\n            (1.0f32, 2.0f32, 3.0f32, 4.0f32, 2.0f32),\n            (-1.5, 2.5, 3.5, -4.5, 0.5),\n            (0.0, 0.0, 1.0, 1.0, 1.0),\n        ];\n        for (x1, y1, x2, y2, s) in cases {\n            let a = C2v { x: x1, y: y1 };\n            let b = C2v { x: x2, y: y2 };\n            assert!(v_eq(add_c(a, b), add_r(a, b)));\n            assert!(v_eq(sub_c(a, b), sub_r(a, b)));\n            assert!(v_eq(mulvs_c(a, s), mulvs_r(a, s)));\n            assert!(v_eq(div_c(a, s), div_r(a, s)));\n            assert!(v_eq(norm_c(a), norm_r(a)));\n            assert!(v_eq(minv_c(a, b), minv_r(a, b)));\n            assert!(v_eq(maxv_c(a, b), maxv_r(a, b)));\n            assert!(v_eq(skew_c(a), skew_r(a)));\n            assert!(v_eq(absv_c(a), absv_r(a)));\n        }\n    }\n}\n\n#[test]\nfn test_c2aabb_to_aabb_and_point() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<unsafe extern \"C\" fn(C2AABB, C2AABB) -> c_int> =\n            c.get(b\"c2AABBtoAABB\").unwrap();\n        let f_r: Symbol<unsafe extern \"C\" fn(C2AABB, C2AABB) -> c_int> =\n            r.get(b\"c2AABBtoAABB\").unwrap();\n        let pt_c: Symbol<unsafe extern \"C\" fn(C2AABB, C2v) -> c_int> =\n            c.get(b\"c2AABBtoPoint\").unwrap();\n        let pt_r: Symbol<unsafe extern \"C\" fn(C2AABB, C2v) -> c_int> =\n            r.get(b\"c2AABBtoPoint\").unwrap();\n        let a = C2AABB {\n            min: C2v { x: 0.0, y: 0.0 },\n            max: C2v { x: 1.0, y: 1.0 },\n        };\n        let b = C2AABB {\n            min: C2v { x: 0.5, y: 0.5 },\n            max: C2v { x: 2.0, y: 2.0 },\n        };\n        assert_eq!(f_c(a, b), f_r(a, b));\n        let p = C2v { x: 0.5, y: 0.5 };\n        assert_eq!(pt_c(a, p), pt_r(a, p));\n        let p2 = C2v { x: 5.0, y: 5.0 };\n        assert_eq!(pt_c(a, p2), pt_r(a, p2));\n    }\n}\n\n#[test]\nfn test_circle_to_point() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<unsafe extern \"C\" fn(C2Circle, C2v) -> c_int> =\n            c.get(b\"c2CircleToPoint\").unwrap();\n        let f_r: Symbol<unsafe extern \"C\" fn(C2Circle, C2v) -> c_int> =\n            r.get(b\"c2CircleToPoint\").unwrap();\n        let circle = C2Circle {\n            p: C2v { x: 0.0, y: 0.0 },\n            r: 1.0,\n        };\n        for p in [\n            C2v { x: 0.0, y: 0.0 },\n            C2v { x: 0.5, y: 0.5 },\n            C2v { x: 1.0, y: 0.0 },\n            C2v { x: 2.0, y: 0.0 },\n        ] {\n            assert_eq!(f_c(circle, p), f_r(circle, p));\n        }\n    }\n}\n\n#[test]\nfn test_ray_to_circle() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<unsafe extern \"C\" fn(C2Ray, C2Circle, *mut C2Raycast) -> c_int> =\n            c.get(b\"c2RaytoCircle\").unwrap();\n        let f_r: Symbol<unsafe extern \"C\" fn(C2Ray, C2Circle, *mut C2Raycast) -> c_int> =\n            r.get(b\"c2RaytoCircle\").unwrap();\n        let circle = C2Circle {\n            p: C2v { x: 5.0, y: 0.0 },\n            r: 1.0,\n        };\n        let ray = C2Ray {\n            p: C2v { x: 0.0, y: 0.0 },\n            d: C2v { x: 1.0, y: 0.0 },\n            t: 10.0,\n        };\n        let mut out_c = C2Raycast {\n            t: 0.0,\n            n: C2v { x: 0.0, y: 0.0 },\n        };\n        let mut out_r = out_c;\n        let rc = f_c(ray, circle, &mut out_c);\n        let rr = f_r(ray, circle, &mut out_r);\n        assert_eq!(rc, rr);\n        if rc != 0 {\n            assert!(raycast_eq(&out_c, &out_r));\n        }\n\n        // Miss case\n        let circle2 = C2Circle {\n            p: C2v { x: 0.0, y: 5.0 },\n            r: 0.5,\n        };\n        let rc2 = f_c(ray, circle2, &mut out_c);\n        let rr2 = f_r(ray, circle2, &mut out_r);\n        assert_eq!(rc2, rr2);\n    }\n}\n\n#[test]\nfn test_ray_to_aabb() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<unsafe extern \"C\" fn(C2Ray, C2AABB, *mut C2Raycast) -> c_int> =\n            c.get(b\"c2RaytoAABB\").unwrap();\n        let f_r: Symbol<unsafe extern \"C\" fn(C2Ray, C2AABB, *mut C2Raycast) -> c_int> =\n            r.get(b\"c2RaytoAABB\").unwrap();\n        let aabb = C2AABB {\n            min: C2v { x: 5.0, y: -1.0 },\n            max: C2v { x: 7.0, y: 1.0 },\n        };\n        let cases = [\n            C2Ray {\n                p: C2v { x: 0.0, y: 0.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 10.0,\n            },\n            C2Ray {\n                p: C2v { x: 0.0, y: 0.0 },\n                d: C2v { x: 0.0, y: 1.0 },\n                t: 10.0,\n            },\n            C2Ray {\n                p: C2v { x: 6.0, y: 0.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 1.0,\n            },\n            C2Ray {\n                p: C2v { x: 10.0, y: 5.0 },\n                d: C2v { x: -1.0, y: -0.5 },\n                t: 10.0,\n            },\n        ];\n        for ray in cases {\n            let mut out_c = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut out_r = out_c;\n            let rc = f_c(ray, aabb, &mut out_c);\n            let rr = f_r(ray, aabb, &mut out_r);\n            assert_eq!(rc, rr);\n            if rc != 0 {\n                assert!(\n                    raycast_eq(&out_c, &out_r),\n                    \"ray {:?} c {:?} r {:?}\",\n                    ray.p,\n                    out_c,\n                    out_r\n                );\n            }\n        }\n    }\n}\n\n#[test]\nfn test_ray_to_capsule() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<unsafe extern \"C\" fn(C2Ray, C2Capsule, *mut C2Raycast) -> c_int> =\n            c.get(b\"c2RaytoCapsule\").unwrap();\n        let f_r: Symbol<unsafe extern \"C\" fn(C2Ray, C2Capsule, *mut C2Raycast) -> c_int> =\n            r.get(b\"c2RaytoCapsule\").unwrap();\n        let cap = C2Capsule {\n            a: C2v { x: 0.0, y: 0.0 },\n            b: C2v { x: 0.0, y: 5.0 },\n            r: 1.0,\n        };\n        let cases = [\n            C2Ray {\n                p: C2v { x: -5.0, y: 2.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 10.0,\n            },\n            C2Ray {\n                p: C2v { x: -5.0, y: -2.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 10.0,\n            },\n            C2Ray {\n                p: C2v { x: 0.5, y: 0.0 },\n                d: C2v { x: 0.0, y: 1.0 },\n                t: 10.0,\n            },\n            C2Ray {\n                p: C2v { x: -10.0, y: 5.0 },\n                d: C2v { x: 1.0, y: 0.5 },\n                t: 20.0,\n            },\n        ];\n        for ray in cases {\n            let mut out_c = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut out_r = out_c;\n            let rc = f_c(ray, cap, &mut out_c);\n            let rr = f_r(ray, cap, &mut out_r);\n            assert_eq!(rc, rr);\n            // capsule writes to out before some return paths, compare always\n            assert!(raycast_eq(&out_c, &out_r));\n        }\n    }\n}\n\n#[test]\nfn test_ray_to_poly() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<\n            unsafe extern \"C\" fn(C2Ray, *const C2Poly, *const C2x, *mut C2Raycast) -> c_int,\n        > = c.get(b\"c2RaytoPoly\").unwrap();\n        let f_r: Symbol<\n            unsafe extern \"C\" fn(C2Ray, *const C2Poly, *const C2x, *mut C2Raycast) -> c_int,\n        > = r.get(b\"c2RaytoPoly\").unwrap();\n        let mut p = C2Poly {\n            count: 4,\n            verts: [C2v { x: 0.0, y: 0.0 }; 8],\n            norms: [C2v { x: 0.0, y: 0.0 }; 8],\n        };\n        p.verts[0] = C2v { x: 0.875, y: -11.5 };\n        p.verts[1] = C2v { x: 0.875, y: 11.5 };\n        p.verts[2] = C2v {\n            x: -0.875,\n            y: 11.5,\n        };\n        p.verts[3] = C2v {\n            x: -0.875,\n            y: -11.5,\n        };\n        p.norms[0] = C2v { x: 1.0, y: 0.0 };\n        p.norms[1] = C2v { x: 0.0, y: 1.0 };\n        p.norms[2] = C2v { x: -1.0, y: 0.0 };\n        p.norms[3] = C2v { x: 0.0, y: -1.0 };\n\n        let cases = [\n            C2Ray {\n                p: C2v {\n                    x: -3.869416,\n                    y: 13.0693407,\n                },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 4.0,\n            },\n            C2Ray {\n                p: C2v {\n                    x: -3.869416,\n                    y: 13.0693407,\n                },\n                d: C2v { x: 0.0, y: -1.0 },\n                t: 4.0,\n            },\n            C2Ray {\n                p: C2v { x: -5.0, y: 0.0 },\n                d: C2v { x: 1.0, y: 0.0 },\n                t: 10.0,\n            },\n        ];\n        for ray in cases {\n            let mut out_c = C2Raycast {\n                t: 0.0,\n                n: C2v { x: 0.0, y: 0.0 },\n            };\n            let mut out_r = out_c;\n            let rc = f_c(ray, &p, std::ptr::null(), &mut out_c);\n            let rr = f_r(ray, &p, std::ptr::null(), &mut out_r);\n            assert_eq!(rc, rr);\n            if rc != 0 {\n                assert!(raycast_eq(&out_c, &out_r));\n            }\n        }\n    }\n}\n\n#[test]\nfn test_poly_ray() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<unsafe extern \"C\" fn(*mut C2Raycast, *mut C2Raycast) -> c_int> =\n            c.get(b\"poly_ray\").unwrap();\n        let f_r: Symbol<unsafe extern \"C\" fn(*mut C2Raycast, *mut C2Raycast) -> c_int> =\n            r.get(b\"poly_ray\").unwrap();\n        let mut c1c = C2Raycast {\n            t: 0.0,\n            n: C2v { x: 0.0, y: 0.0 },\n        };\n        let mut c2c = c1c;\n        let mut c1r = c1c;\n        let mut c2r = c1c;\n        let rc = f_c(&mut c1c, &mut c2c);\n        let rr = f_r(&mut c1r, &mut c2r);\n        assert_eq!(rc, rr);\n        // Result depends on hit bits, so only compare buffers if hit set.\n        // Compare bitwise.\n        assert_eq!(c1c.t.to_bits(), c1r.t.to_bits());\n        assert_eq!(c1c.n.x.to_bits(), c1r.n.x.to_bits());\n        assert_eq!(c1c.n.y.to_bits(), c1r.n.y.to_bits());\n        assert_eq!(c2c.t.to_bits(), c2r.t.to_bits());\n        assert_eq!(c2c.n.x.to_bits(), c2r.n.x.to_bits());\n        assert_eq!(c2c.n.y.to_bits(), c2r.n.y.to_bits());\n    }\n}\n\n#[test]\nfn test_c2ccw90_mulmvt() {\n    let (c, r) = load_libs();\n    unsafe {\n        let ccw_c: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = c.get(b\"c2CCW90\").unwrap();\n        let ccw_r: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = r.get(b\"c2CCW90\").unwrap();\n        let mvt_c: Symbol<unsafe extern \"C\" fn(C2m, C2v) -> C2v> = c.get(b\"c2MulmvT\").unwrap();\n        let mvt_r: Symbol<unsafe extern \"C\" fn(C2m, C2v) -> C2v> = r.get(b\"c2MulmvT\").unwrap();\n        let v = C2v { x: 1.0, y: 2.0 };\n        assert!(v_eq(ccw_c(v), ccw_r(v)));\n        let m = C2m {\n            x: C2v { x: 1.0, y: 0.0 },\n            y: C2v { x: 0.0, y: 1.0 },\n        };\n        assert!(v_eq(mvt_c(m, v), mvt_r(m, v)));\n    }\n}\n\n#[test]\nfn test_rot_x_identity_mulrv() {\n    let (c, r) = load_libs();\n    unsafe {\n        let id_c: Symbol<unsafe extern \"C\" fn() -> C2r> = c.get(b\"c2RotIdentity\").unwrap();\n        let id_r: Symbol<unsafe extern \"C\" fn() -> C2r> = r.get(b\"c2RotIdentity\").unwrap();\n        let xid_c: Symbol<unsafe extern \"C\" fn() -> C2x> = c.get(b\"c2xIdentity\").unwrap();\n        let xid_r: Symbol<unsafe extern \"C\" fn() -> C2x> = r.get(b\"c2xIdentity\").unwrap();\n        let mulrv_c: Symbol<unsafe extern \"C\" fn(C2r, C2v) -> C2v> = c.get(b\"c2Mulrv\").unwrap();\n        let mulrv_r: Symbol<unsafe extern \"C\" fn(C2r, C2v) -> C2v> = r.get(b\"c2Mulrv\").unwrap();\n        let mulrvT_c: Symbol<unsafe extern \"C\" fn(C2r, C2v) -> C2v> = c.get(b\"c2MulrvT\").unwrap();\n        let mulrvT_r: Symbol<unsafe extern \"C\" fn(C2r, C2v) -> C2v> = r.get(b\"c2MulrvT\").unwrap();\n        let mulxvT_c: Symbol<unsafe extern \"C\" fn(C2x, C2v) -> C2v> = c.get(b\"c2MulxvT\").unwrap();\n        let mulxvT_r: Symbol<unsafe extern \"C\" fn(C2x, C2v) -> C2v> = r.get(b\"c2MulxvT\").unwrap();\n\n        let ic = id_c();\n        let ir = id_r();\n        assert_eq!(ic.c.to_bits(), ir.c.to_bits());\n        assert_eq!(ic.s.to_bits(), ir.s.to_bits());\n        let xc = xid_c();\n        let xr = xid_r();\n        assert!(v_eq(xc.p, xr.p));\n\n        let r_rot = C2r { c: 0.6, s: 0.8 };\n        let v = C2v { x: 1.5, y: -2.5 };\n        assert!(v_eq(mulrv_c(r_rot, v), mulrv_r(r_rot, v)));\n        assert!(v_eq(mulrvT_c(r_rot, v), mulrvT_r(r_rot, v)));\n\n        let xform = C2x {\n            p: C2v { x: 0.5, y: 1.0 },\n            r: r_rot,\n        };\n        assert!(v_eq(mulxvT_c(xform, v), mulxvT_r(xform, v)));\n    }\n}\n\n#[test]\nfn test_cast_ray_poly() {\n    let (c, r) = load_libs();\n    unsafe {\n        let f_c: Symbol<\n            unsafe extern \"C\" fn(\n                C2Ray,\n                *const std::ffi::c_void,\n                *const C2x,\n                c_int,\n                *mut C2Raycast,\n            ) -> c_int,\n        > = c.get(b\"c2CastRay\").unwrap();\n        let f_r: Symbol<\n            unsafe extern \"C\" fn(\n                C2Ray,\n                *const std::ffi::c_void,\n                *const C2x,\n                c_int,\n                *mut C2Raycast,\n            ) -> c_int,\n        > = r.get(b\"c2CastRay\").unwrap();\n        let mut p = C2Poly {\n            count: 4,\n            verts: [C2v { x: 0.0, y: 0.0 }; 8],\n            norms: [C2v { x: 0.0, y: 0.0 }; 8],\n        };\n        p.verts[0] = C2v { x: 0.875, y: -11.5 };\n        p.verts[1] = C2v { x: 0.875, y: 11.5 };\n        p.verts[2] = C2v {\n            x: -0.875,\n            y: 11.5,\n        };\n        p.verts[3] = C2v {\n            x: -0.875,\n            y: -11.5,\n        };\n        p.norms[0] = C2v { x: 1.0, y: 0.0 };\n        p.norms[1] = C2v { x: 0.0, y: 1.0 };\n        p.norms[2] = C2v { x: -1.0, y: 0.0 };\n        p.norms[3] = C2v { x: 0.0, y: -1.0 };\n\n        let ray = C2Ray {\n            p: C2v {\n                x: -3.869416,\n                y: 13.0693407,\n            },\n            d: C2v { x: 1.0, y: 0.0 },\n            t: 4.0,\n        };\n        let mut out_c = C2Raycast {\n            t: 0.0,\n            n: C2v { x: 0.0, y: 0.0 },\n        };\n        let mut out_r = out_c;\n        let rc = f_c(\n            ray,\n            &p as *const C2Poly as *const _,\n            std::ptr::null(),\n            3,\n            &mut out_c,\n        );\n        let rr = f_r(\n            ray,\n            &p as *const C2Poly as *const _,\n            std::ptr::null(),\n            3,\n            &mut out_r,\n        );\n        assert_eq!(rc, rr);\n        if rc != 0 {\n            assert!(raycast_eq(&out_c, &out_r));\n        }\n    }\n}\n",