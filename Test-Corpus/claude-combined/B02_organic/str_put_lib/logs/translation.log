ut u8).sub(elemsize) as *mut c_void;\n        let ra_arr = (ra as *mut u8).sub(elemsize) as *mut c_void;\n        let ch = *header(ca_arr);\n        let rh = *header(ra_arr);\n        assert_eq!(ch.length, rh.length);\n        assert_eq!(ch.capacity, rh.capacity);\n        assert_eq!(ch.temp, rh.temp);\n        assert_eq!(ch.length, 1);\n        assert!(!ch.hash_table.is_null());\n        assert!(!rh.hash_table.is_null());\n    }\n}","originalFile":"// Integration tests that load BOTH the C .so and the Rust .so via libloading\n// and compare outputs/state byte-for-byte through the FFI boundary.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int, c_void};\nuse std::os::raw::c_long;\n\nconst C_SO: &str = \"c_src/build/libtranslated_rust.so\";\nconst RUST_SO: &str = \"target/release/libtranslated_rust.so\";\n\n// stbds_array_header (must match C exactly)\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Eq)]\nstruct ArrayHeader {\n    length: usize,\n    capacity: usize,\n    hash_table: *mut c_void,\n    temp: isize,\n}\n\n// stbds_string_arena\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Eq)]\nstruct StringArena {\n    storage: *mut c_void,\n    remaining: usize,\n    block: u8,\n    mode: u8,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\nstruct StringBlock {\n    next: *mut StringBlock,\n    storage: [c_char; 8],\n}\n\nunsafe fn header(t: *mut c_void) -> *mut ArrayHeader {\n    (t as *mut ArrayHeader).offset(-1)\n}\n\nfn load_lib(name: &str) -> Library {\n    unsafe { Library::new(name).unwrap_or_else(|e| panic!(\"Failed to load {}: {}\", name, e)) }\n}\n\n#[test]\nfn arrgrowf_basic() {\n    unsafe {\n        let c = load_lib(C_SO);\n        let r = load_lib(RUST_SO);\n\n        type FN = unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void;\n        let c_fn: Symbol<FN> = c.get(b\"stbds_arrgrowf\").unwrap();\n        let r_fn: Symbol<FN> = r.get(b\"stbds_arrgrowf\").unwrap();\n\n        // Initial allocation: a=NULL, elemsize=8, addlen=0, min_cap=1 -> min_cap clamped to 4\n        let ca = c_fn(std::ptr::null_mut(), 8, 0, 1);\n        let ra = r_fn(std::ptr::null_mut(), 8, 0, 1);\n\n        let ch = *header(ca);\n        let rh = *header(ra);\n        // hash_table is set to null in both. capacity, length, temp same.\n        assert_eq!(ch.length, rh.length);\n        assert_eq!(ch.capacity, rh.capacity);\n        assert_eq!(ch.temp, rh.temp);\n        assert!(ch.hash_table.is_null() && rh.hash_table.is_null());\n        assert_eq!(ch.capacity, 4);\n\n        // Growth: addlen=2, min_cap=0 — already capacity 4, returns same a.\n        let ca2 = c_fn(ca, 8, 2, 0);\n        let ra2 = r_fn(ra, 8, 2, 0);\n        assert_eq!((*header(ca2)).capacity, (*header(ra2)).capacity);\n\n        // Force growth: addlen=10\n        let ca3 = c_fn(ca2, 8, 10, 0);\n        let ra3 = r_fn(ra2, 8, 10, 0);\n        assert_eq!((*header(ca3)).capacity, (*header(ra3)).capacity);\n\n        // Free\n        type FREE = unsafe extern \"C\" fn(*mut c_void);\n        let cf: Symbol<FREE> = c.get(b\"stbds_arrfreef\").unwrap();\n        let rf: Symbol<FREE> = r.get(b\"stbds_arrfreef\").unwrap();\n        cf(ca3);\n        rf(ra3);\n    }\n}\n\n#[test]\nfn rand_seed_changes_subsequent_alloc() {\n    unsafe {\n        let c = load_lib(C_SO);\n        let r = load_lib(RUST_SO);\n\n        type SEEDFN = unsafe extern \"C\" fn(usize);\n        let cs: Symbol<SEEDFN> = c.get(b\"stbds_rand_seed\").unwrap();\n        let rs: Symbol<SEEDFN> = r.get(b\"stbds_rand_seed\").unwrap();\n        cs(42);\n        rs(42);\n        // No direct observation, but verifies symbol is exported and callable\n    }\n}\n\n#[test]\nfn hash_string_matches() {\n    unsafe {\n        let c = load_lib(C_SO);\n        let r = load_lib(RUST_SO);\n\n        type FN = unsafe extern \"C\" fn(*mut c_char, usize) -> usize;\n        let cf: Symbol<FN> = c.get(b\"stbds_hash_string\").unwrap();\n        let rf: Symbol<FN> = r.get(b\"stbds_hash_string\").unwrap();\n\n        let inputs: &[&[u8]] = &[\n            b\"\\0\",\n            b\"a\\0\",\n            b\"hello\\0\",\n            b\"the quick brown fox jumps over the lazy dog\\0\",\n            b\"test_0\\0\",\n            b\"test_42\\0\",\n            b\"\\xff\\xfe\\xfd\\0\",\n        ];\n        let seeds: &[usize] = &[0, 1, 0x31415926, 0xdeadbeefcafebabe, usize::MAX];\n        for s in inputs {\n            for &seed in seeds {\n                let mut buf = s.to_vec();\n                let p = buf.as_mut_ptr() as *mut c_char;\n                let ch = cf(p, seed);\n                let rh = rf(p, seed);\n                assert_eq!(ch, rh, \"hash_string mismatch for {:?} seed={:x}\", s, seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn hash_bytes_matches() {\n    unsafe {\n        let c = load_lib(C_SO);\n        let r = load_lib(RUST_SO);\n\n        type FN = unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize;\n        let cf: Symbol<FN> = c.get(b\"stbds_hash_bytes\").unwrap();\n        let rf: Symbol<FN> = r.get(b\"stbds_hash_bytes\").unwrap();\n\n        let test_data: Vec<Vec<u8>> = vec![\n            vec![],\n            vec![0],\n            vec![0xff],\n            vec![1, 2, 3, 4],\n            vec![1, 2, 3, 4, 5, 6, 7, 8],\n            (0..16u8).collect(),\n            (0..32u8).collect(),\n            (0..64u8).collect(),\n            (0..100u8).collect(),\n            vec![0xff; 23],\n            vec![0x80; 17],\n        ];\n        let seeds = [0usize, 1, 0x31415926, 0xdeadbeef, 0xcafebabe1234usize];\n        for d in &test_data {\n            for &seed in &seeds {\n                let mut buf = d.clone();\n                let p = if buf.is_empty() {\n                    std::ptr::null_mut()\n                } else {\n                    buf.as_mut_ptr() as *mut c_void\n                };\n                // Some data lengths may have UB-ish reads if pointer is null but len=0.\n                // We'll skip empty to avoid that.\n                if buf.is_empty() {\n                    continue;\n                }\n                let ch = cf(p, buf.len(), seed);\n                let rh = rf(p, buf.len(), seed);\n                assert_eq!(\n                    ch, rh,\n                    \"hash_bytes mismatch for len={} seed={:x}\",\n                    buf.len(), seed\n                );\n            }\n        }\n    }\n}\n\n#[test]\nfn stralloc_strreset_basic() {\n    unsafe {\n        let c = load_lib(C_SO);\n        let r = load_lib(RUST_SO);\n\n        type ALLOC = unsafe extern \"C\" fn(*mut StringArena, *mut c_char) -> *mut c_char;\n        type RESET = unsafe extern \"C\" fn(*mut StringArena);\n        let ca: Symbol<ALLOC> = c.get(b\"stbds_stralloc\").unwrap();\n        let ra: Symbol<ALLOC> = r.get(b\"stbds_stralloc\").unwrap();\n        let cr: Symbol<RESET> = c.get(b\"stbds_strreset\").unwrap();\n        let rr: Symbol<RESET> = r.get(b\"stbds_strreset\").unwrap();\n\n        let mut c_sa = StringArena {\n            storage: std::ptr::null_mut(),\n            remaining: 0,\n            block: 0,\n            mode: 0,\n        };\n        let mut r_sa = c_sa;\n\n        let inputs: Vec<Vec<u8>> = (0..50)\n            .map(|i| format!(\"test_{}\\0\", i).into_bytes())\n            .collect();\n        let mut c_results = Vec::new();\n        let mut r_results = Vec::new();\n        for buf in &inputs {\n            let mut cb = buf.clone();\n            let mut rb = buf.clone();\n            let cp = ca(&mut c_sa, cb.as_mut_ptr() as *mut c_char);\n            let rp = ra(&mut r_sa, rb.as_mut_ptr() as *mut c_char);\n\n            // Verify the contents at the returned pointers\n            let cs = std::ffi::CStr::from_ptr(cp).to_bytes();\n            let rs = std::ffi::CStr::from_ptr(rp).to_bytes();\n            assert_eq!(cs, rs, \"stralloc returned different content\");\n            // The state of the arena (remaining, block) should match\n            assert_eq!(\n                c_sa.remaining, r_sa.remaining,\n                \"remaining differs after iter\"\n            );\n            assert_eq!(c_sa.block, r_sa.block, \"block differs after iter\");\n            c_results.push(cp);\n            r_results.push(rp);\n        }\n        // Reset\n        cr(&mut c_sa);\n        rr(&mut r_sa);\n        assert_eq!(c_sa, r_sa);\n        assert!(c_sa.storage.is_null());\n        assert_eq!(c_sa.remaining, 0);\n    }\n}\n\n#[test]\nfn shmode_func_smoke() {\n    unsafe {\n        let c = load_lib(C_SO);\n        let r = load_lib(RUST_SO);\n\n        type FN = unsafe extern \"C\" fn(usize, c_int) -> *mut c_void;\n        let cf: Symbol<FN> = c.get(b\"stbds_shmode_func\").unwrap();\n        let rf: Symbol<FN> = r.get(b\"stbds_shmode_func\").unwrap();\n\n        // Make a hash map with elemsize 16 (char* + int + padding) and STBDS_SH_STRDUP=2\n        let ca = cf(16, 2);\n        let ra = rf(16, 2);\n        let ch = *header(ca);\n        let rh = *header(ra);\n        assert_eq!(ch.length, rh.length);\n        assert_eq!(ch.capacity, rh.capacity);\n        assert_eq!(ch.temp, rh.temp);\n    }\n}\n\n#[test]\nfn str_put_output_matches() {\n    // Both libraries write to stdout via printf. Capture each library's stdout\n    // separately by forking, and compare the raw bytes.\n    use std::os::unix::io::FromRawFd;\n\n    fn run_and_capture(so: &str, num: c_int) -> Vec<u8> {\n        unsafe {\n            // Pipe to capture child stdout.\n            let mut fds = [0i32; 2];\n            assert_eq!(libc::pipe(fds.as_mut_ptr()), 0);\n            let read_fd = fds[0];\n            let write_fd = fds[1];\n\n            let pid = libc::fork();\n            assert!(pid >= 0);\n            if pid == 0 {\n                // Child\n                libc::close(read_fd);\n                libc::dup2(write_fd, 1);\n                libc::close(write_fd);\n                let lib = libloading::Library::new(so).expect(\"load\");\n                let f: libloading::Symbol<unsafe extern \"C\" fn(c_int)> =\n                    lib.get(b\"str_put\").expect(\"sym\");\n                f(num);\n                libc::fflush(std::ptr::null_mut());\n                libc::_exit(0);\n            } else {\n                libc::close(write_fd);\n                let mut out = Vec::new();\n                let mut buf = [0u8; 4096];\n                loop {\n                    let n = libc::read(\n                        read_fd,\n                        buf.as_mut_ptr() as *mut c_void,\n                        buf.len(),\n                    );\n                    if n <= 0 {\n                        break;\n                    }\n                    out.extend_from_slice(&buf[..n as usize]);\n                }\n                libc::close(read_fd);\n                let mut status = 0i32;\n                libc::waitpid(pid, &mut status, 0);\n                out\n            }\n        }\n    }\n\n    // The test loop: compare across various num values.\n    for &num in &[0, 1, 5, 10, 50] {\n        let c_out = run_and_capture(C_SO, num);\n        let r_out = run_and_capture(RUST_SO, num);\n        assert_eq!(c_out, r_out, \"str_put({}) output mismatch:\\nC:   {:?}\\nRUST: {:?}\",\n            num,\n            String::from_utf8_lossy(&c_out),\n            String::from_utf8_lossy(&r_out));\n    }\n    // suppress unused\n    let _ = c_long::default;\n}\n\n#[test]\nfn strkey_buffer_matches_format() {\n    unsafe {\n        let c = load_lib(C_SO);\n        let r = load_lib(RUST_SO);\n\n        type FN = unsafe extern \"C\" fn(c_int) -> *mut c_char;\n        let cf: Symbol<FN> = c.get(b\"strkey\").unwrap();\n        let rf: Symbol<FN> = r.get(b\"strkey\").unwrap();\n\n        for n in [0, 1, 42, -1, 1000, i32::MAX, i32::MIN] {\n            let cp = cf(n);\n            let rp = rf(n);\n            let cs = std::ffi::CStr::from_ptr(cp).to_bytes().to_vec();\n            let rs = std::ffi::CStr::from_ptr(rp).to_bytes().to_vec();\n            assert_eq!(cs, rs, \"strkey({}) mismatch\", n);\n        }\n    }\n}\n\n#[test]\nfn binary_hashmap_put_get_via_shmode() {\n    // Use stbds_hmput_key + stbds_hmget_key directly with binary mode (mode=0).\n    // We'll use elemsize matching {int key; int value;} = 8, keysize=4, but on\n    // a fresh hash map (a=NULL). Compare returned pointer state and stored values.\n    unsafe {\n        let c = load_lib(C_SO);\n        let r = load_lib(RUST_SO);\n\n        type PUTFN = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\n        type GETFN = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\n        type FREEFN = unsafe extern \"C\" fn(*mut c_void, usize);\n\n        let cput: Symbol<PUTFN> = c.get(b\"stbds_hmput_key\").unwrap();\n        let rput: Symbol<PUTFN> = r.get(b\"stbds_hmput_key\").unwrap();\n        let cget: Symbol<GETFN> = c.get(b\"stbds_hmget_key\").unwrap();\n        let rget: Symbol<GETFN> = r.get(b\"stbds_hmget_key\").unwrap();\n        let cfree: Symbol<FREEFN> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let rfree: Symbol<FREEFN> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        // Reset RNG so both libraries have the same seed sequence.\n        type SEEDFN = unsafe extern \"C\" fn(usize);\n        let cseed: Symbol<SEEDFN> = c.get(b\"stbds_rand_seed\").unwrap();\n        let rseed: Symbol<SEEDFN> = r.get(b\"stbds_rand_seed\").unwrap();\n        cseed(0x31415926);\n        rseed(0x31415926);\n\n        let elemsize: usize = 8; // {int key; int value;}\n        let keysize: usize = 4;\n\n        let mut ca: *mut c_void = std::ptr::null_mut();\n        let mut ra: *mut c_void = std::ptr::null_mut();\n\n        for i in 0i32..32 {\n            let mut k = i;\n            ca = cput(ca, elemsize, &mut k as *mut _ as *mut c_void, keysize, 0);\n            ra = rput(ra, elemsize, &mut k as *mut _ as *mut c_void, keysize, 0);\n            // Write value into slot:\n            let c_temp = (*header((ca as *mut u8).sub(elemsize) as *mut c_void)).temp;\n            let r_temp = (*header((ra as *mut u8).sub(elemsize) as *mut c_void)).temp;\n            assert_eq!(c_temp, r_temp, \"temp differs at i={}\", i);\n            // Write key+value into slots\n            let cslot = (ca as *mut u8).add(elemsize * c_temp as usize) as *mut i32;\n            let rslot = (ra as *mut u8).add(elemsize * r_temp as usize) as *mut i32;\n            *cslot = i;\n            *cslot.add(1) = i * 100;\n            *rslot = i;\n            *rslot.add(1) = i * 100;\n        }\n\n        // Lookup all keys\n        for i in 0i32..32 {\n            let mut k = i;\n            let cap = cget(ca, elemsize, &mut k as *mut _ as *mut c_void, keysize, 0);\n            let rap = rget(ra, elemsize, &mut k as *mut _ as *mut c_void, keysize, 0);\n            ca = cap;\n            ra = rap;\n            let c_temp = (*header((ca as *mut u8).sub(elemsize) as *mut c_void)).temp;\n            let r_temp = (*header((ra as *mut u8).sub(elemsize) as *mut c_void)).temp;\n            assert_eq!(c_temp, r_temp, \"lookup temp differs at i={}\", i);\n            assert!(c_temp >= 0, \"key not found\");\n            let cslot = (ca as *mut u8).add(elemsize * c_temp as usize) as *const i32;\n            let rslot = (ra as *mut u8).add(elemsize * r_temp as usize) as *const i32;\n            assert_eq!(*cslot, *rslot);\n            assert_eq!(*cslot.add(1), *rslot.add(1));\n            assert_eq!(*cslot, i);\n            assert_eq!(*cslot.add(1), i * 100);\n        }\n\n        // Lookup a missing key\n        let mut k = 999;\n        let cap = cget(ca, elemsize, &mut k as *mut _ as *mut c_void, keysize, 0);\n        let rap = rget(ra, elemsize, &mut k as *mut _ as *mut c_void, keysize, 0);\n        ca = cap;\n        ra = rap;\n        let c_temp = (*header((ca as *mut u8).sub(elemsize) as *mut c_void)).temp;\n        let r_temp = (*header((ra as *mut u8).sub(elemsize) as *mut c_void)).temp;\n        assert_eq!(c_temp, r_temp);\n        assert_eq!(c_temp, -1);\n\n        cfree((ca as *mut u8).sub(elemsize) as *mut c_void, elemsize);\n        rfree((ra as *mut u8).sub(elemsize) as *mut c_void, elemsize);\n    }\n}\n","structuredPatch":[{"oldStart":245,"oldLines":14,"newStart":245,"newLines":22,"lines":["         let cf: Symbol<FN> = c.get(b\"stbds_shmode_func\").unwrap();","         let rf: Symbol<FN> = r.get(b\"stbds_shmode_func\").unwrap();"," ","-        // Make a hash map with elemsize 16 (char* + int + padding) and STBDS_SH_STRDUP=2","-        let ca = cf(16, 2);","-        let ra = rf(16, 2);","-        let ch = *header(ca);","-        let rh = *header(ra);","+        // Make a hash map with elemsize 16 (char* + int + padding) and STBDS_SH_STRDUP=2.","+        // The returned pointer is offset by one element (arr_to_hash); walk back to","+        // the underlying array (and its header) with hash_to_arr.","+        let elemsize: usize = 16;","+        let ca = cf(elemsize, 2);","+        let ra = rf(elemsize, 2);","+        let ca_arr = (ca as *mut u8).sub(elemsize) as *mut c_void;","+        let ra_arr = (ra as *mut u8).sub(elemsize) as *mut c_void;","+        let ch = *header(ca_arr);","+        let rh = *header(ra_arr);","         assert_eq!(ch.length, rh.length);","         assert_eq!(ch.capacity, rh.capacity);","         assert_eq!(ch.temp, rh.temp);","+        assert_eq!(ch.length, 1);","+        assert!(!ch.hash_table.is_null());","+        assert!(!rh.hash_table.is_null());","     }"," }"," "]}],"userModified":false,"replaceAll":false}}
