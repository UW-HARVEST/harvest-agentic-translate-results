_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        let mut raw = vec![0u8; 1 + 4 * 4];\n        raw[0] = 7; // invalid filter\n        let (rc, _) = run_unfilter(&r_lib, 4, 1, 4, &mut raw.clone());\n        let (cc, _) = run_unfilter(&c_lib, 4, 1, 4, &mut raw.clone());\n        assert_eq!(rc, cc);\n        assert_eq!(rc, 0);\n    }\n}\n\n#[test]\nfn test_unfilter_invalid_filter_subsequent_row() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        let w = 4;\n        let bpp = 4;\n        let h = 2;\n        let row_len = 1 + w * bpp;\n        let mut raw = vec![0u8; row_len * h as usize];\n        raw[0] = 0; // first row valid\n        raw[row_len] = 99; // invalid filter for second row\n        let (rc, _) = run_unfilter(&r_lib, w, h, bpp, &mut raw.clone());\n        let (cc, _) = run_unfilter(&c_lib, w, h, bpp, &mut raw.clone());\n        assert_eq!(rc, cc);\n        assert_eq!(rc, 0);\n    }\n}\n\n// ---------------- cp_inflate tests ----------------\n\nfn deflate_compress(data: &[u8]) -> Vec<u8> {\n    use std::io::Write;\n    let mut encoder = flate2_like_zlib_strip(data);\n    encoder\n}\n\n// Simple Python-generated DEFLATE blob for round-tripping.\n// We use a hardcoded fixed-block DEFLATE stream.\nfn flate2_like_zlib_strip(data: &[u8]) -> Vec<u8> {\n    // Use 'miniz_oxide' style? We don't have it. Instead, hand-build a stored\n    // DEFLATE block which is straightforward.\n    // Stored block format: BFINAL(1) BTYPE(00) padding to byte boundary,\n    // then LEN(2) NLEN(2) then bytes.\n    let len = data.len() as u16;\n    let nlen = !len;\n    let mut out = Vec::new();\n    // First byte: BFINAL=1, BTYPE=00, rest 0 -> 0x01\n    out.push(0x01);\n    out.push((len & 0xFF) as u8);\n    out.push((len >> 8) as u8);\n    out.push((nlen & 0xFF) as u8);\n    out.push((nlen >> 8) as u8);\n    out.extend_from_slice(data);\n    out\n}\n\n#[test]\nfn test_inflate_stored_block() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        let data = b\"Hello, world! Some test data here.\";\n        let compressed = deflate_compress(data);\n\n        let (rc, rdata) = run_inflate(&r_lib, &compressed, data.len());\n        let (cc, cdata) = run_inflate(&c_lib, &compressed, data.len());\n        assert_eq!(rc, cc, \"return codes differ\");\n        assert_eq!(rc, 1, \"expected success\");\n        assert_eq!(&rdata, data);\n        assert_eq!(&cdata, data);\n        assert_eq!(rdata, cdata);\n    }\n}\n\n#[test]\nfn test_inflate_fixed_block() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        // Pre-generated DEFLATE data using zlib in Python (fixed Huffman).\n        let deflate_hex = \"f348cdc9c9d75108cf2fca49515408c9c82c5600a2448592d4e21285b4fc22051757371fc710578594d4e4fcdc82a2d4e2e2ccfc3c3d050f3cfaf400\";\n        let deflate: Vec<u8> = (0..deflate_hex.len())\n            .step_by(2)\n            .map(|i| u8::from_str_radix(&deflate_hex[i..i + 2], 16).unwrap())\n            .collect();\n        let original = b\"Hello, World! This is a test for DEFLATE decompression. Hello, World! This is a test.\";\n\n        let (rc, rdata) = run_inflate(&r_lib, &deflate, original.len());\n        let (cc, cdata) = run_inflate(&c_lib, &deflate, original.len());\n        assert_eq!(rc, cc, \"return codes differ: rust={} c={}\", rc, cc);\n        assert_eq!(rc, 1, \"expected success\");\n        assert_eq!(&rdata[..], &original[..]);\n        assert_eq!(&cdata[..], &original[..]);\n        assert_eq!(rdata, cdata);\n    }\n}\n\n#[test]\nfn test_inflate_dynamic_block() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        // Use a longer, more diverse string that triggers dynamic Huffman.\n        // The deflate hex was generated via zlib.compress with level 9 and the\n        // 2-byte header + 4-byte adler stripped.\n        // Generate using python in build steps.\n        let original_text: &[u8] = b\"The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs. \\\nHow vexingly quick daft zebras jump! Sphinx of black quartz, judge my vow. \\\nThe five boxing wizards jump quickly. Mr Jock, TV quiz PhD, bags few lynx. \\\nThe quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs. \\\nHow vexingly quick daft zebras jump! Sphinx of black quartz, judge my vow. \\\nThe five boxing wizards jump quickly. Mr Jock, TV quiz PhD, bags few lynx.\";\n\n        // Use a Python script via std::process::Command to compress.\n        let py = format!(\n            \"import zlib,sys\\n\\\nsys.stdout.buffer.write(zlib.compress(open('/tmp/inflate_test_input.bin','rb').read(),9)[2:-4])\\n\"\n        );\n        std::fs::write(\"/tmp/inflate_test_input.bin\", original_text).unwrap();\n        let output = std::process::Command::new(\"python3\")\n            .arg(\"-c\")\n            .arg(&py)\n            .output()\n            .expect(\"python3 needed for test\");\n        let deflate = output.stdout;\n\n        let (rc, rdata) = run_inflate(&r_lib, &deflate, original_text.len());\n        let (cc, cdata) = run_inflate(&c_lib, &deflate, original_text.len());\n        assert_eq!(rc, cc);\n        assert_eq!(rc, 1);\n        assert_eq!(&rdata[..], original_text);\n        assert_eq!(&cdata[..], original_text);\n        assert_eq!(rdata, cdata);\n    }\n}\n\n#[test]\nfn test_inflate_misaligned_input() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        let data = b\"Misalignment regression test bytes!\";\n        let compressed = deflate_compress(data);\n\n        // Prepend a few bytes to force misalignment of the input pointer\n        // (cp_inflate internally aligns by skipping the first 0..3 bytes).\n        for prefix in 0..4usize {\n            let mut buffer = vec![0xAAu8; prefix];\n            buffer.extend_from_slice(&compressed);\n            // Pass a pointer offset into a larger allocation so 'in' is\n            // potentially misaligned. Easier: allocate and pass slice.\n            let mut input_copy = buffer.clone();\n            let in_ptr = unsafe { input_copy.as_mut_ptr().add(prefix) };\n            let mut out_r = vec![0u8; data.len()];\n            let mut out_c = vec![0u8; data.len()];\n\n            let f_r: libloading::Symbol<CpInflateFn> =\n                r_lib.get(b\"cp_inflate\\0\").unwrap();\n            let f_c: libloading::Symbol<CpInflateFn> =\n                c_lib.get(b\"cp_inflate\\0\").unwrap();\n            let rc = f_r(\n                in_ptr as *mut c_void,\n                compressed.len() as c_int,\n                out_r.as_mut_ptr() as *mut c_void,\n                out_r.len() as c_int,\n            );\n            // Need a fresh copy because cp_inflate writes in-place via aligned\n            // word reads (some implementations).\n            let mut input_copy2 = buffer.clone();\n            let in_ptr2 = unsafe { input_copy2.as_mut_ptr().add(prefix) };\n            let cc = f_c(\n                in_ptr2 as *mut c_void,\n                compressed.len() as c_int,\n                out_c.as_mut_ptr() as *mut c_void,\n                out_c.len() as c_int,\n            );\n            assert_eq!(rc, cc, \"prefix {} return codes differ\", prefix);\n            assert_eq!(out_r, out_c, \"prefix {} outputs differ\", prefix);\n        }\n    }\n}\n\n// ---------------- Symbol export parity ----------------\n\n#[test]\nfn test_exported_globals_match() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n\n        // Compare cp_fixed_table content.\n        let c_sym: Symbol<*mut u8> = c_lib.get(b\"cp_fixed_table\\0\").unwrap();\n        let r_sym: Symbol<*mut u8> = r_lib.get(b\"cp_fixed_table\\0\").unwrap();\n        let c_ptr: *mut u8 = *c_sym;\n        let r_ptr: *mut u8 = *r_sym;\n        for i in 0..(288 + 32) {\n            assert_eq!(\n                *c_ptr.add(i),\n                *r_ptr.add(i),\n                \"cp_fixed_table[{}] mismatch\",\n                i\n            );\n        }\n\n        // cp_permutation_order.\n        let c_sym: Symbol<*mut u8> = c_lib.get(b\"cp_permutation_order\\0\").unwrap();\n        let r_sym: Symbol<*mut u8> = r_lib.get(b\"cp_permutation_order\\0\").unwrap();\n        for i in 0..19 {\n            assert_eq!(*(*c_sym).add(i), *(*r_sym).add(i));\n        }\n\n        // cp_len_extra_bits.\n        let c_sym: Symbol<*mut u8> = c_lib.get(b\"cp_len_extra_bits\\0\").unwrap();\n        let r_sym: Symbol<*mut u8> = r_lib.get(b\"cp_len_extra_bits\\0\").unwrap();\n        for i in 0..(29 + 2) {\n            assert_eq!(*(*c_sym).add(i), *(*r_sym).add(i));\n        }\n\n        // cp_dist_extra_bits.\n        let c_sym: Symbol<*mut u8> = c_lib.get(b\"cp_dist_extra_bits\\0\").unwrap();\n        let r_sym: Symbol<*mut u8> = r_lib.get(b\"cp_dist_extra_bits\\0\").unwrap();\n        for i in 0..(30 + 2) {\n            assert_eq!(*(*c_sym).add(i), *(*r_sym).add(i));\n        }\n\n        // cp_len_base (u32 array).\n        let c_sym: Symbol<*mut u32> = c_lib.get(b\"cp_len_base\\0\").unwrap();\n        let r_sym: Symbol<*mut u32> = r_lib.get(b\"cp_len_base\\0\").unwrap();\n        for i in 0..(29 + 2) {\n            assert_eq!(*(*c_sym).add(i), *(*r_sym).add(i));\n        }\n\n        // cp_dist_base (u32 array).\n        let c_sym: Symbol<*mut u32> = c_lib.get(b\"cp_dist_base\\0\").unwrap();\n        let r_sym: Symbol<*mut u32> = r_lib.get(b\"cp_dist_base\\0\").unwrap();\n        for i in 0..(30 + 2) {\n            assert_eq!(*(*c_sym).add(i), 