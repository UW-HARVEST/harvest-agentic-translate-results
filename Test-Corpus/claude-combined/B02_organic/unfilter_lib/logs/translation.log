  raw[off] = y as u8;\n            for x in 0..(w * bpp) {\n                raw[off + 1 + x as usize] =\n                    ((y * 31 + x) as u8).wrapping_mul(23).wrapping_add(5);\n            }\n        }\n        let (rc, rdata) = run_unfilter(&r_lib, w, h, bpp, &mut raw.clone());\n        let (cc, cdata) = run_unfilter(&c_lib, w, h, bpp, &mut raw.clone());\n        assert_eq!(rc, cc);\n        assert_eq!(rdata, cdata);\n    }\n}","originalFile":"use libloading::{Library, Symbol};\nuse std::os::raw::{c_int, c_void};\nuse std::path::PathBuf;\n\nfn c_lib_path() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"target/release\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\ntype UnfilterFn =\n    unsafe extern \"C\" fn(c_int, c_int, c_int, *mut u8) -> c_int;\ntype CpInflateFn =\n    unsafe extern \"C\" fn(*mut c_void, c_int, *mut c_void, c_int) -> c_int;\n\nunsafe fn run_unfilter(lib: &Library, w: i32, h: i32, bpp: i32, raw: &mut [u8]) -> (i32, Vec<u8>) {\n    let f: Symbol<UnfilterFn> = lib.get(b\"unfilter\\0\").unwrap();\n    let mut copy = raw.to_vec();\n    let r = f(w, h, bpp, copy.as_mut_ptr());\n    (r, copy)\n}\n\nunsafe fn run_inflate(\n    lib: &Library,\n    input: &[u8],\n    out_size: usize,\n) -> (i32, Vec<u8>) {\n    let f: Symbol<CpInflateFn> = lib.get(b\"cp_inflate\\0\").unwrap();\n    let mut input_copy = input.to_vec();\n    let mut out = vec![0u8; out_size];\n    let r = f(\n        input_copy.as_mut_ptr() as *mut c_void,\n        input_copy.len() as c_int,\n        out.as_mut_ptr() as *mut c_void,\n        out.len() as c_int,\n    );\n    (r, out)\n}\n\n#[test]\nfn test_unfilter_h0() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n\n        let raw = vec![0u8; 16];\n        let (rc, rdata) = run_unfilter(&r_lib, 4, 0, 4, &mut raw.clone());\n        let (cc, cdata) = run_unfilter(&c_lib, 4, 0, 4, &mut raw.clone());\n        assert_eq!(rc, cc);\n        assert_eq!(rdata, cdata);\n    }\n}\n\n#[test]\nfn test_unfilter_h1_filter_none() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n\n        // 1 row, 4 wide, 4 bpp, with filter byte = 0 (None)\n        let mut raw = vec![0u8; 1 + 4 * 4];\n        raw[0] = 0;\n        for i in 1..raw.len() {\n            raw[i] = (i as u8).wrapping_mul(7);\n        }\n        let (rc, rdata) = run_unfilter(&r_lib, 4, 1, 4, &mut raw.clone());\n        let (cc, cdata) = run_unfilter(&c_lib, 4, 1, 4, &mut raw.clone());\n        assert_eq!(rc, cc);\n        assert_eq!(rdata, cdata);\n    }\n}\n\n#[test]\nfn test_unfilter_h1_filter_sub() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        let mut raw = vec![0u8; 1 + 5 * 3];\n        raw[0] = 1;\n        for i in 1..raw.len() {\n            raw[i] = (i as u8).wrapping_mul(11);\n        }\n        let (rc, rdata) = run_unfilter(&r_lib, 5, 1, 3, &mut raw.clone());\n        let (cc, cdata) = run_unfilter(&c_lib, 5, 1, 3, &mut raw.clone());\n        assert_eq!(rc, cc);\n        assert_eq!(rdata, cdata);\n    }\n}\n\n#[test]\nfn test_unfilter_h1_filter_up() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        let mut raw = vec![0u8; 1 + 4 * 4];\n        raw[0] = 2;\n        for i in 1..raw.len() {\n            raw[i] = (i as u8).wrapping_mul(13);\n        }\n        let (rc, rdata) = run_unfilter(&r_lib, 4, 1, 4, &mut raw.clone());\n        let (cc, cdata) = run_unfilter(&c_lib, 4, 1, 4, &mut raw.clone());\n        assert_eq!(rc, cc);\n        assert_eq!(rdata, cdata);\n    }\n}\n\n#[test]\nfn test_unfilter_h1_filter_avg() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        let mut raw = vec![0u8; 1 + 6 * 3];\n        raw[0] = 3;\n        for i in 1..raw.len() {\n            raw[i] = (i as u8).wrapping_mul(17).wrapping_add(7);\n        }\n        let (rc, rdata) = run_unfilter(&r_lib, 6, 1, 3, &mut raw.clone());\n        let (cc, cdata) = run_unfilter(&c_lib, 6, 1, 3, &mut raw.clone());\n        assert_eq!(rc, cc);\n        assert_eq!(rdata, cdata);\n    }\n}\n\n#[test]\nfn test_unfilter_h1_filter_paeth() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        let mut raw = vec![0u8; 1 + 4 * 4];\n        raw[0] = 4;\n        for i in 1..raw.len() {\n            raw[i] = (i as u8).wrapping_mul(19);\n        }\n        let (rc, rdata) = run_unfilter(&r_lib, 4, 1, 4, &mut raw.clone());\n        let (cc, cdata) = run_unfilter(&c_lib, 4, 1, 4, &mut raw.clone());\n        assert_eq!(rc, cc);\n        assert_eq!(rdata, cdata);\n    }\n}\n\n#[test]\nfn test_unfilter_multirow_all_filters() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        let w = 5;\n        let bpp = 4;\n        let h = 5;\n        let row_len = 1 + w * bpp;\n        let mut raw = vec![0u8; row_len * h as usize];\n        for y in 0..h {\n            let off = y as usize * row_len;\n            // Use filter type y (cycles through 0..=4)\n            raw[off] = y as u8;\n            for x in 0..(w * bpp) {\n                raw[off + 1 + x as usize] =\n                    ((y * 31 + x) as u8).wrapping_mul(23).wrapping_add(5);\n            }\n        }\n        let (rc, rdata) = run_unfilter(&r_lib, w, h, bpp, &mut raw.clone());\n        let (cc, cdata) = run_unfilter(&c_lib, w, h, bpp, &mut raw.clone());\n        assert_eq!(rc, cc);\n        assert_eq!(rdata, cdata);\n    }\n}\n\n#[test]\nfn test_unfilter_invalid_filter_first_row() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        let mut raw = vec![0u8; 1 + 4 * 4];\n        raw[0] = 7; // invalid filter\n        let (rc, _) = run_unfilter(&r_lib, 4, 1, 4, &mut raw.clone());\n        let (cc, _) = run_unfilter(&c_lib, 4, 1, 4, &mut raw.clone());\n        assert_eq!(rc, cc);\n        assert_eq!(rc, 0);\n    }\n}\n\n#[test]\nfn test_unfilter_invalid_filter_subsequent_row() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        let w = 4;\n        let bpp = 4;\n        let h = 2;\n        let row_len = 1 + w * bpp;\n        let mut raw = vec![0u8; row_len * h as usize];\n        raw[0] = 0; // first row valid\n        raw[row_len] = 99; // invalid filter for second row\n        let (rc, _) = run_unfilter(&r_lib, w, h, bpp, &mut raw.clone());\n        let (cc, _) = run_unfilter(&c_lib, w, h, bpp, &mut raw.clone());\n        assert_eq!(rc, cc);\n        assert_eq!(rc, 0);\n    }\n}\n\n// ---------------- cp_inflate tests ----------------\n\nfn deflate_compress(data: &[u8]) -> Vec<u8> {\n    use std::io::Write;\n    let mut encoder = flate2_like_zlib_strip(data);\n    encoder\n}\n\n// Simple Python-generated DEFLATE blob for round-tripping.\n// We use a hardcoded fixed-block DEFLATE stream.\nfn flate2_like_zlib_strip(data: &[u8]) -> Vec<u8> {\n    // Use 'miniz_oxide' style? We don't have it. Instead, hand-build a stored\n    // DEFLATE block which is straightforward.\n    // Stored block format: BFINAL(1) BTYPE(00) padding to byte boundary,\n    // then LEN(2) NLEN(2) then bytes.\n    let len = data.len() as u16;\n    let nlen = !len;\n    let mut out = Vec::new();\n    // First byte: BFINAL=1, BTYPE=00, rest 0 -> 0x01\n    out.push(0x01);\n    out.push((len & 0xFF) as u8);\n    out.push((len >> 8) as u8);\n    out.push((nlen & 0xFF) as u8);\n    out.push((nlen >> 8) as u8);\n    out.extend_from_slice(data);\n    out\n}\n\n#[test]\nfn test_inflate_stored_block() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        let data = b\"Hello, world! Some test data here.\";\n        let compressed = deflate_compress(data);\n\n        let (rc, rdata) = run_inflate(&r_lib, &compressed, data.len());\n        let (cc, cdata) = run_inflate(&c_lib, &compressed, data.len());\n        assert_eq!(rc, cc, \"return codes differ\");\n        assert_eq!(rc, 1, \"expected success\");\n        assert_eq!(&rdata, data);\n        assert_eq!(&cdata, data);\n        assert_eq!(rdata, cdata);\n    }\n}\n\n#[test]\nfn test_inflate_fixed_block() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n        // Pre-generated DEFLATE data using zlib in Python (fixed Huffman).\n        let deflate_hex = \"f348cdc9c9d75108cf2fca49515408c9c82c5600a2448592d4e21285b4fc22051757371fc710578594d4e4fcdc82a2d4e2e2ccfc3c3d050f3cfaf400\";\n        let deflate: Vec<u8> = (0..deflate_hex.len())\n            .step_by(2)\n            .map(|i| u8::from_str_radix(&deflate_hex[i..i + 2], 16).unwrap())\n            .collect();\n        let original = b\"Hello, World! This is a test for DEFLATE decompression. Hello, World! This is a test.\";\n\n        let (rc, rdata) = run_inflate(&r_lib, &deflate, original.len());\n        let (cc, cdata) = run_inflate(&c_lib, &deflate, original.len());\n        assert_eq!(rc, cc, \"return codes differ: rust={} c={}\", rc, cc);\n        assert_eq!(rc, 1, \"expected success\");\n        assert_eq!(&rdata[..], &original[..]);\n        assert_eq!(&cdata[..], &original[..]);\n        assert_eq!(rdata, cdata);\n    }\n}\n\n#[test]\nfn test_inflate_dynamic_block() {\n    unsafe {\n        let c_lib = Librar