{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PzCAu9QhuB31xqr7nD5Y2Q","type":"tool_result","content":"The file /tmp/harvest-translate-mFGYDP/translated_rust/tests/ffi_compare.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"966493ff-0f61-4f59-a0ca-e08817788f96","uuid":"4573427e-cbec-489b-b8f5-fc4c8d2554f0","timestamp":"2026-05-30T00:08:41.831Z","tool_use_result":{"filePath":"/tmp/harvest-translate-mFGYDP/translated_rust/tests/ffi_compare.rs","oldString":"use libloading::{Library, Symbol};\nuse std::os::raw::{c_int, c_void};","newString":"#![allow(non_snake_case)]\n#![allow(dead_code)]\n\nuse libloading::{Library, Symbol};\nuse std::os::raw::{c_int, c_void};","originalFile":"use libloading::{Library, Symbol};\nuse std::os::raw::{c_int, c_void};\n\nconst RTLD_NOW: i32 = 0x2;\nconst RTLD_GLOBAL: i32 = 0x100;\n\nextern \"C\" {\n    fn dlopen(filename: *const std::os::raw::c_char, flags: i32) -> *mut c_void;\n}\n\nfn preload_libm() {\n    let names = [\n        b\"libm.so.6\\0\".as_ptr() as *const std::os::raw::c_char,\n        b\"libm.so\\0\".as_ptr() as *const std::os::raw::c_char,\n    ];\n    for n in names {\n        let h = unsafe { dlopen(n, RTLD_NOW | RTLD_GLOBAL) };\n        if !h.is_null() {\n            return;\n        }\n    }\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Default)]\nstruct C2v {\n    x: f32,\n    y: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Default)]\nstruct C2r {\n    c: f32,\n    s: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Default)]\nstruct C2x {\n    p: C2v,\n    r: C2r,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Default)]\nstruct C2Circle {\n    p: C2v,\n    r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Default)]\nstruct C2AABB {\n    min: C2v,\n    max: C2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Default)]\nstruct C2Capsule {\n    a: C2v,\n    b: C2v,\n    r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Default)]\nstruct C2GJKCache {\n    metric: f32,\n    count: i32,\n    iA: [i32; 3],\n    iB: [i32; 3],\n    div: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\nstruct C2Proxy {\n    radius: f32,\n    count: i32,\n    verts: [C2v; 8],\n}\n\nimpl Default for C2Proxy {\n    fn default() -> Self {\n        C2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [C2v::default(); 8],\n        }\n    }\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\nstruct C2sv {\n    sA: C2v,\n    sB: C2v,\n    p: C2v,\n    u: f32,\n    iA: i32,\n    iB: i32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\nstruct C2Simplex {\n    a: C2sv,\n    b: C2sv,\n    c: C2sv,\n    d: C2sv,\n    div: f32,\n    count: i32,\n}\n\nconst C2_TYPE_CIRCLE: i32 = 0;\nconst C2_TYPE_AABB: i32 = 1;\nconst C2_TYPE_CAPSULE: i32 = 2;\n\nfn c_lib_path() -> String {\n    let manifest = env!(\"CARGO_MANIFEST_DIR\");\n    format!(\"{}/c_src/build/libtranslated_rust.so\", manifest)\n}\n\nfn rust_lib_path() -> String {\n    let manifest = env!(\"CARGO_MANIFEST_DIR\");\n    format!(\"{}/target/release/liblib.so\", manifest)\n}\n\nfn load_libs() -> (Library, Library) {\n    preload_libm();\n    unsafe {\n        let c = Library::new(c_lib_path()).expect(\"load C lib\");\n        let r = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n        (c, r)\n    }\n}\n\n#[test]\nfn test_c2v() {\n    let (c_lib, r_lib) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(f32, f32) -> C2v> = c_lib.get(b\"c2V\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(f32, f32) -> C2v> = r_lib.get(b\"c2V\").unwrap();\n        for &(x, y) in &[(0.0f32, 0.0f32), (1.0, -2.0), (3.5, 4.5), (-1e6, 1e6)] {\n            assert_eq!(c_fn(x, y), r_fn(x, y));\n        }\n    }\n}\n\n#[test]\nfn test_c2dot_c2sub_c2add() {\n    let (c_lib, r_lib) = load_libs();\n    unsafe {\n        let c_dot: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> f32> = c_lib.get(b\"c2Dot\").unwrap();\n        let r_dot: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> f32> = r_lib.get(b\"c2Dot\").unwrap();\n        let c_sub: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = c_lib.get(b\"c2Sub\").unwrap();\n        let r_sub: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = r_lib.get(b\"c2Sub\").unwrap();\n        let c_add: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = c_lib.get(b\"c2Add\").unwrap();\n        let r_add: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = r_lib.get(b\"c2Add\").unwrap();\n\n        let pairs = [\n            (C2v { x: 1.0, y: 2.0 }, C2v { x: 3.0, y: 4.0 }),\n            (C2v { x: -5.0, y: 0.0 }, C2v { x: 0.5, y: -1.5 }),\n            (C2v { x: 1e10, y: -1e10 }, C2v { x: 1.0, y: 1.0 }),\n        ];\n        for &(a, b) in &pairs {\n            assert_eq!(c_dot(a, b).to_bits(), r_dot(a, b).to_bits());\n            assert_eq!(c_sub(a, b), r_sub(a, b));\n            assert_eq!(c_add(a, b), r_add(a, b));\n        }\n    }\n}\n\n#[test]\nfn test_c2_misc_vectors() {\n    let (c_lib, r_lib) = load_libs();\n    unsafe {\n        let names_unary: &[&[u8]] = &[b\"c2Neg\", b\"c2Skew\", b\"c2CCW90\", b\"c2Norm\"];\n        for n in names_unary {\n            let c_fn: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = c_lib.get(n).unwrap();\n            let r_fn: Symbol<unsafe extern \"C\" fn(C2v) -> C2v> = r_lib.get(n).unwrap();\n            for &v in &[\n                C2v { x: 1.0, y: 2.0 },\n                C2v { x: -3.0, y: 4.0 },\n                C2v { x: 100.0, y: 0.0 },\n                C2v { x: 0.0, y: 100.0 },\n            ] {\n                let cr = c_fn(v);\n                let rr = r_fn(v);\n                assert_eq!(cr.x.to_bits(), rr.x.to_bits(), \"fn {:?}\", String::from_utf8_lossy(n));\n                assert_eq!(cr.y.to_bits(), rr.y.to_bits(), \"fn {:?}\", String::from_utf8_lossy(n));\n            }\n        }\n    }\n}\n\n#[test]\nfn test_c2_minmax_clamp() {\n    let (c_lib, r_lib) = load_libs();\n    unsafe {\n        let names: &[&[u8]] = &[b\"c2Maxv\", b\"c2Minv\"];\n        for n in names {\n            let c_fn: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = c_lib.get(n).unwrap();\n            let r_fn: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = r_lib.get(n).unwrap();\n            for &(a, b) in &[\n                (C2v { x: 1.0, y: 5.0 }, C2v { x: 3.0, y: 2.0 }),\n                (C2v { x: -1.0, y: -2.0 }, C2v { x: -3.0, y: -4.0 }),\n            ] {\n                assert_eq!(c_fn(a, b), r_fn(a, b));\n            }\n        }\n        let c_clamp: Symbol<unsafe extern \"C\" fn(C2v, C2v, C2v) -> C2v> = c_lib.get(b\"c2Clampv\").unwrap();\n        let r_clamp: Symbol<unsafe extern \"C\" fn(C2v, C2v, C2v) -> C2v> = r_lib.get(b\"c2Clampv\").unwrap();\n        let a = C2v { x: 5.0, y: -5.0 };\n        let lo = C2v { x: 0.0, y: 0.0 };\n        let hi = C2v { x: 10.0, y: 10.0 };\n        assert_eq!(c_clamp(a, lo, hi), r_clamp(a, lo, hi));\n    }\n}\n\n#[test]\nfn test_c2_det_len() {\n    let (c_lib, r_lib) = load_libs();\n    unsafe {\n        let c_det: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> f32> = c_lib.get(b\"c2Det2\").unwrap();\n        let r_det: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> f32> = r_lib.get(b\"c2Det2\").unwrap();\n        let c_len: Symbol<unsafe extern \"C\" fn(C2v) -> f32> = c_lib.get(b\"c2Len\").unwrap();\n        let r_len: Symbol<unsafe extern \"C\" fn(C2v) -> f32> = r_lib.get(b\"c2Len\").unwrap();\n\n        for &(a, b) in &[\n            (C2v { x: 1.0, y: 0.0 }, C2v { x: 0.0, y: 1.0 }),\n            (C2v { x: 3.0, y: 4.0 }, C2v { x: -4.0, y: 3.0 }),\n        ] {\n            assert_eq!(c_det(a, b).to_bits(), r_det(a, b).to_bits());\n        }\n        for &v in &[C2v { x: 3.0, y: 4.0 }, C2v { x: 0.0, y: 0.0 }, C2v { x: 1e-3, y: 1e-3 }] {\n            assert_eq!(c_len(v).to_bits(), r_len(v).to_bits());\n        }\n    }\n}\n\n#[test]\nfn test_c2_collisions() {\n    let (c_lib, r_lib) = load_libs();\n    unsafe {\n        let circle_a = C2Circle { p: C2v { x: 0.0, y: 0.0 }, r: 5.0 };\n        let circle_b = C2Circle { p: C2v { x: 6.0, y: 0.0 }, r: 2.0 };\n        let circle_c = C2Circle { p: C2v { x: 1.0, y: 0.0 }, r: 2.0 };\n\n        let aabb_a = C2AABB { min: C2v { x: -1.0, y: -1.0 }, max: C2v { x: 1.0, y: 1.0 } };\n        let aabb_b = C2AABB { min: C2v { x: 5.0, y: 5.0 }, max: C2v { x: 6.0, y: 6.0 } };\n\n        let cap_a = C2Capsule { a: C2v { x: 0.0, y: 0.0 }, b: C2v { x: 5.0, y: 0.0 }, r: 1.0 };\n        let cap_b = C2Capsule { a: C2v { x: 10.0, y: 10.0 }, b: C2v { x: 12.0, y: 12.0 }, r: 1.0 };\n\n        // c2CircletoCircle\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2Circle, C2Circle) -> c_int> = c_lib.get(b\"c2CircletoCircle\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2Circle, C2Circle) -> c_int> = r_lib.get(b\"c2CircletoCircle\").unwrap();\n        assert_eq!(c_fn(circle_a, circle_b), r_fn(circle_a, circle_b));\n        assert_eq!(c_fn(circle_a, circle_c), r_fn(circle_a, circle_c));\n\n        // c2CircletoAABB\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2Circle, C2AABB) -> c_int> = c_lib.get(b\"c2CircletoAABB\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2Circle, C2AABB) -> c_int> = r_lib.get(b\"c2CircletoAABB\").unwrap();\n        assert_eq!(c_fn(circle_a, aabb_a), r_fn(circle_a, aabb_a));\n        assert_eq!(c_fn(circle_a, aabb_b), r_fn(circle_a, aabb_b));\n\n        // c2AABBtoAABB\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2AABB, C2AABB) -> c_int> = c_lib.get(b\"c2AABBtoAABB\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2AABB, C2AABB) -> c_int> = r_lib.get(b\"c2AABBtoAABB\").unwrap();\n        assert_eq!(c_fn(aabb_a, aabb_b), r_fn(aabb_a, aabb_b));\n        assert_eq!(c_fn(aabb_a, aabb_a), r_fn(aabb_a, aabb_a));\n\n        // c2CircletoCapsule\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2Circle, C2Capsule) -> c_int> = c_lib.get(b\"c2CircletoCapsule\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2Circle, C2Capsule) -> c_int> = r_lib.get(b\"c2CircletoCapsule\").unwrap();\n        assert_eq!(c_fn(circle_a, cap_a), r_fn(circle_a, cap_a));\n        assert_eq!(c_fn(circle_a, cap_b), r_fn(circle_a, cap_b));\n\n        // c2AABBtoCapsule (uses GJK)\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2AABB, C2Capsule) -> c_int> = c_lib.get(b\"c2AABBtoCapsule\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2AABB, C2Capsule) -> c_int> = r_lib.get(b\"c2AABBtoCapsule\").unwrap();\n        assert_eq!(c_fn(aabb_a, cap_a), r_fn(aabb_a, cap_a));\n        assert_eq!(c_fn(aabb_a, cap_b), r_fn(aabb_a, cap_b));\n\n        // c2CapsuletoCapsule (uses GJK)\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2Capsule, C2Capsule) -> c_int> = c_lib.get(b\"c2CapsuletoCapsule\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2Capsule, C2Capsule) -> c_int> = r_lib.get(b\"c2CapsuletoCapsule\").unwrap();\n        assert_eq!(c_fn(cap_a, cap_b), r_fn(cap_a, cap_b));\n        assert_eq!(c_fn(cap_a, cap_a), r_fn(cap_a, cap_a));\n    }\n}\n\n#[test]\nfn test_c2_collided() {\n    let (c_lib, r_lib) = load_libs();\n    unsafe {\n        let c_fn: Symbol<\n            unsafe extern \"C\" fn(*const c_void, c_int, *const c_void, c_int) -> c_int,\n        > = c_lib.get(b\"c2Collided\").unwrap();\n        let r_fn: Symbol<\n            unsafe extern \"C\" fn(*const c_void, c_int, *const c_void, c_int) -> c_int,\n        > = r_lib.get(b\"c2Collided\").unwrap();\n\n        let circle = C2Circle { p: C2v { x: 0.0, y: 0.0 }, r: 5.0 };\n        let aabb = C2AABB { min: C2v { x: -1.0, y: -1.0 }, max: C2v { x: 1.0, y: 1.0 } };\n        let cap = C2Capsule { a: C2v { x: 0.0, y: 0.0 }, b: C2v { x: 10.0, y: 0.0 }, r: 1.0 };\n\n        let c_res = c_fn(\n            &circle as *const _ as *const c_void,\n            C2_TYPE_CIRCLE,\n            &aabb as *const _ as *const c_void,\n            C2_TYPE_AABB,\n        );\n        let r_res = r_fn(\n            &circle as *const _ as *const c_void,\n            C2_TYPE_CIRCLE,\n            &aabb as *const _ as *const c_void,\n            C2_TYPE_AABB,\n        );\n        assert_eq!(c_res, r_res);\n\n        let c_res = c_fn(\n            &cap as *const _ as *const c_void,\n            C2_TYPE_CAPSULE,\n            &aabb as *const _ as *const c_void,\n            C2_TYPE_AABB,\n        );\n        let r_res = r_fn(\n            &cap as *const _ as *const c_void,\n            C2_TYPE_CAPSULE,\n            &aabb as *const _ as *const c_void,\n            C2_TYPE_AABB,\n        );\n        assert_eq!(c_res, r_res);\n    }\n}\n\n#[test]\nfn test_reverse_collide() {\n    let (c_lib, r_lib) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(f32, f32, f32) -> c_int> = c_lib.get(b\"reverse_collide\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(f32, f32, f32) -> c_int> = r_lib.get(b\"reverse_collide\").unwrap();\n\n        // Test a wide range of inputs\n        let inputs = [\n            (0.0_f32, 0.0_f32, 1.0_f32),\n            (-70.0, 0.0, 20.0),  // Inside circle\n            (-25.0, -25.0, 5.0), // Inside AABB\n            (-30.0, 70.0, 5.0),  // Near capsule\n            (100.0, 100.0, 1.0), // Far away\n            (-50.0, 0.0, 0.1),   // Close to circle\n            (-50.0, 50.0, 30.0), // Big radius, multiple collisions\n            (1.0, 2.0, 3.0),\n            (-100.0, -100.0, 10.0),\n            (50.0, 50.0, 0.5),\n            (0.0, 50.0, 100.0),\n        ];\n        for &(x, y, r) in &inputs {\n            let c_res = c_fn(x, y, r);\n            let r_res = r_fn(x, y, r);\n            assert_eq!(c_res, r_res, \"reverse_collide({}, {}, {})\", x, y, r);\n        }\n    }\n}\n\n#[test]\nfn test_c2gjk() {\n    let (c_lib, r_lib) = load_libs();\n    unsafe {\n        type GjkFn = unsafe extern \"C\" fn(\n            *const c_void, c_int, *const C2x,\n            *const c_void, c_int, *const C2x,\n            *mut C2v, *mut C2v, c_int,\n            *mut c_int, *mut C2GJKCache,\n        ) -> f32;\n        let c_fn: Symbol<GjkFn> = c_lib.get(b\"c2GJK\").unwrap();\n        let r_fn: Symbol<GjkFn> = r_lib.get(b\"c2GJK\").unwrap();\n\n        let aabb = C2AABB { min: C2v { x: -1.0, y: -1.0 }, max: C2v { x: 1.0, y: 1.0 } };\n        let cap = C2Capsule { a: C2v { x: 5.0, y: 0.0 }, b: C2v { x: 10.0, y: 0.0 }, r: 1.0 };\n\n        let mut c_outA = C2v::default();\n        let mut c_outB = C2v::default();\n        let mut c_iter: c_int = 0;\n        let c_dist = c_fn(\n            &aabb as *const _ as *const c_void, C2_TYPE_AABB, std::ptr::null(),\n            &cap as *const _ as *const c_void, C2_TYPE_CAPSULE, std::ptr::null(),\n            &mut c_outA, &mut c_outB, 1, &mut c_iter, std::ptr::null_mut(),\n        );\n\n        let mut r_outA = C2v::default();\n        let mut r_outB = C2v::default();\n        let mut r_iter: c_int = 0;\n        let r_dist = r_fn(\n            &aabb as *const _ as *const c_void, C2_TYPE_AABB, std::ptr::null(),\n            &cap as *const _ as *const c_void, C2_TYPE_CAPSULE, std::ptr::null(),\n            &mut r_outA, &mut r_outB, 1, &mut r_iter, std::ptr::null_mut(),\n        );\n\n        assert_eq!(c_dist.to_bits(), r_dist.to_bits());\n        assert_eq!(c_outA.x.to_bits(), r_outA.x.to_bits());\n        assert_eq!(c_outA.y.to_bits(), r_outA.y.to_bits());\n        assert_eq!(c_outB.x.to_bits(), r_outB.x.to_bits());\n        assert_eq!(c_outB.y.to_bits(), r_outB.y.to_bits());\n        assert_eq!(c_iter, r_iter);\n    }\n}\n\n#[test]\nfn test_c2makeproxy() {\n    let (c_lib, r_lib) = load_libs();\n    unsafe {\n        type Fn = unsafe extern \"C\" fn(*const c_void, c_int, *mut C2Proxy);\n        let c_fn: Symbol<Fn> = c_lib.get(b\"c2MakeProxy\").unwrap();\n        let r_fn: Symbol<Fn> = r_lib.get(b\"c2MakeProxy\").unwrap();\n\n        let circle = C2Circle { p: C2v { x: 1.0, y: 2.0 }, r: 3.0 };\n        let mut cp = C2Proxy::default();\n        let mut rp = C2Proxy::default();\n        c_fn(&circle as *const _ as *const c_void, C2_TYPE_CIRCLE, &mut cp);\n        r_fn(&circle as *const _ as *const c_void, C2_TYPE_CIRCLE, &mut rp);\n        assert_eq!(cp.radius.to_bits(), rp.radius.to_bits());\n        assert_eq!(cp.count, rp.count);\n        for i in 0..1 {\n            assert_eq!(cp.verts[i], rp.verts[i]);\n        }\n\n        let aabb = C2AABB { min: C2v { x: -1.0, y: -2.0 }, max: C2v { x: 3.0, y: 4.0 } };\n        let mut cp = C2Proxy::default();\n        let mut rp = C2Proxy::default();\n        c_fn(&aabb as *const _ as *const c_void, C2_TYPE_AABB, &mut cp);\n        r_fn(&aabb as *const _ as *const c_void, C2_TYPE_AABB, &mut rp);\n        assert_eq!(cp.radius.to_bits(), rp.radius.to_bits());\n        assert_eq!(cp.count, rp.count);\n        for i in 0..4 {\n            assert_eq!(cp.verts[i], rp.verts[i]);\n        }\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":3,"newStart":1,"newLines":6,"lines":["+#![allow(non_snake_case)]","+#![allow(dead_code)]","+"," use libloading::{Library, Symbol};"," use std::os::raw::{c_int, c_void};"," "]}],"userModified":false,"replaceAll":false}}
