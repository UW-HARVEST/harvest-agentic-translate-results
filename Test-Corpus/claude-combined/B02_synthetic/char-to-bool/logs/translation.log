\n45\t        return 1;\n46\t    }\n47\t    operation = atoi(input_buffer);\n48\t    \n49\t    /* Read parameter */\n50\t    if (fgets(input_buffer, MAX_INPUT_SIZE, stdin) == NULL) {\n51\t        fprintf(stderr, \"Error reading parameter\\n\");\n52\t        return 1;\n53\t    }\n54\t    param = atoi(input_buffer);\n55\t    \n56\t    /* Read decision string */\n57\t    if (fgets(input_buffer, MAX_INPUT_SIZE, stdin) == NULL) {\n58\t        fprintf(stderr, \"Error reading decision string\\n\");\n59\t        return 1;\n60\t    }\n61\t    \n62\t    /* Remove trailing newline if present */\n63\t    size_t len = strlen(input_buffer);\n64\t    if (len > 0 && input_buffer[len - 1] == '\\n') {\n65\t        input_buffer[len - 1] = '\\0';\n66\t        len--;\n67\t    }\n68\t    \n69\t    /* Call the library function */\n70\t    result = process_decisions(input_buffer, len, operation, param);\n71\t    \n72\t    /* Print result to stdout */\n73\t    printf(\"%d\\n\", result);\n74\t    \n75\t    return 0;\n76\t}\n77\t"}]},"parent_tool_use_id":null,"session_id":"5da670c8-3c96-43c0-ab27-fbd91deaa22f","uuid":"7688575b-ea83-4437-9078-4769d6b434da","timestamp":"2026-05-30T01:39:50.373Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-translate-WYfiqb/translated_rust/c_src/src/main.c","content":"/*\n * Copyright 2025 MIT Lincoln Laboratory\n * Permission is hereby granted, free of charge,\n * to any person obtaining a copy of this software\n * and associated documentation files (the \"Software\"),\n * to deal in the Software without restriction,\n * including without limitation the rights to use, copy,\n * modify, merge, publish, distribute, sublicense,\n * and/or sell copies of the Software,\n * and to permit persons to whom the Software is furnished to do so,\n * subject to the following conditions:\n * \n * The above copyright notice and this permission notice\n * shall be included in all copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n * THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n */\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n\n/* External function declaration */\nint process_decisions(char *decision_string, size_t length, \n                     int operation, int param);\n\n#define MAX_INPUT_SIZE 1024\n\nint main(void) {\n    char input_buffer[MAX_INPUT_SIZE];\n    int operation;\n    int param;\n    int result;\n    \n    /* Read operation number */\n    if (fgets(input_buffer, MAX_INPUT_SIZE, stdin) == NULL) {\n        fprintf(stderr, \"Error reading operation\\n\");\n        return 1;\n    }\n    operation = atoi(input_buffer);\n    \n    /* Read parameter */\n    if (fgets(input_buffer, MAX_INPUT_SIZE, stdin) == NULL) {\n        fprintf(stderr, \"Error reading parameter\\n\");\n        return 1;\n    }\n    param = atoi(input_buffer);\n    \n    /* Read decision string */\n    if (fgets(input_buffer, MAX_INPUT_SIZE, stdin) == NULL) {\n        fprintf(stderr, \"Error reading decision string\\n\");\n        return 1;\n    }\n    \n    /* Remove trailing newline if present */\n    size_t len = strlen(input_buffer);\n    if (len > 0 && input_buffer[len - 1] == '\\n') {\n        input_buffer[len - 1] = '\\0';\n        len--;\n    }\n    \n    /* Call the library function */\n    result = process_decisions(input_buffer, len, operation, param);\n    \n    /* Print result to stdout */\n    printf(\"%d\\n\", result);\n    \n    return 0;\n}\n","numLines":77,"startLine":1,"totalLines":77}}}
