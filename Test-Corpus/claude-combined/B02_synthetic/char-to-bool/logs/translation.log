ram length Length of decision string\n41\t * @param operation Operation to perform:\n42\t *                  0: apply permissions (uses first 3 decisions)\n43\t *                  1: evaluate conditions with logic (uses first 3 decisions)\n44\t *                  2: configure flags (uses all decisions)\n45\t *                  3: validate sequence (checks pattern)\n46\t * @param param Operation-specific parameter (logic operator, mode, etc)\n47\t * @return Operation result or error code\n48\t */\n49\tint process_decisions(char *decision_string, size_t length, \n50\t                     int operation, int param) {\n51\t    \n52\t    if (decision_string == NULL || length == 0) {\n53\t        return -1;\n54\t    }\n55\t    \n56\t    switch (operation) {\n57\t        case 0: {\n58\t            /* Apply permissions: read, write, execute */\n59\t            if (length < 3) return -2;\n60\t            \n61\t            bool read = parse_bool(decision_string[0]);\n62\t            bool write = parse_bool(decision_string[1]);\n63\t            bool execute = parse_bool(decision_string[2]);\n64\t            \n65\t            return apply_permissions(read, write, execute);\n66\t        }\n67\t        \n68\t        case 1: {\n69\t            /* Evaluate logical conditions */\n70\t            if (length < 3) return -2;\n71\t            \n72\t            bool cond1 = parse_bool(decision_string[0]);\n73\t            bool cond2 = parse_bool(decision_string[1]);\n74\t            bool cond3 = parse_bool(decision_string[2]);\n75\t            \n76\t            /* param determines logic operation: 0=AND, 1=OR, 2=XOR, 3=NAND */\n77\t            return evaluate_conditions(cond1, cond2, cond3, param);\n78\t        }\n79\t        \n80\t        case 2: {\n81\t            /* Configure flags from all decisions */\n82\t            bool decisions[32];\n83\t            size_t count = (length < 32) ? length : 32;\n84\t            \n85\t            for (size_t i = 0; i < count; i++) {\n86\t          