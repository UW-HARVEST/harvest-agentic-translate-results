ir = manifest_dir.join(\"target\").join(\"c_so\");\n    std::fs::create_dir_all(&out_dir).expect(\"create target/c_so\");\n    let so_path = out_dir.join(\"libdriver_c.so\");\n\n    let src = manifest_dir.join(\"c_src\").join(\"src\").join(\"mdcore.c\");\n\n    let status = Command::new(\"gcc\")\n        .args([\n            \"-shared\",\n            \"-fPIC\",\n            \"-O2\",\n            \"-Wno-implicit-function-declaration\",\n        ])\n        .arg(format!(\"-DOP={}\", op))\n        .arg(format!(\"-DREPEAT={}\", repeat))\n        .arg(&src)\n        .arg(\"-o\")\n        .arg(&so_path)\n        .status()\n        .expect(\"failed to spawn gcc\");\n    if !status.success() {\n        panic!(\"gcc failed building C shared library\");\n    }\n\n    println!(\"cargo:rustc-env=DRIVER_C_SO={}\", so_path.display());\n    println!(\"cargo:rustc-env=DRIVER_OP={}\", op);\n    println!(\"cargo:rustc-env=DRIVER_REPEAT={}\", repeat);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3794,"cache_read_input_tokens":33194,"cache_creation":{"ephemeral_5m_input_tokens":3794,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d70c8913-b824-4183-8c18-b31b0f3aff65","uuid":"cf47877a-5693-414e-b8b9-d4adb12d4432"}
