nerated_matches() {\n    unsafe {\n        let c = Loaded::new(c_lib_path());\n        let r = Loaded::new(rust_lib_path());\n\n        let cf = c.unary_fn(\"use_generated\");\n        let rf = r.unary_fn(\"use_generated\");\n\n        for n in 0..=7i32 {\n            let mut c_ret = 0;\n            let c_out = capture_stdout(|| {\n                c_ret = cf(n);\n            });\n            let mut r_ret = 0;\n            let r_out = capture_stdout(|| {\n                r_ret = rf(n);\n            });\n            assert_eq!(c_out, r_out, \"use_generated stdout differs for n={}\", n);\n            assert_eq!(c_ret, r_ret, \"use_generated return differs for n={}\", n);\n        }\n    }\n}","new_string":"// Stdout-capturing tests cannot safely run concurrently with the rest of\n// the harness (which prints \"ok\"/\"FAILED\" lines to stdout between tests).\n// We collapse the three printf-using comparisons into a single test that\n// captures stdout once and serializes the comparisons.\n#[test]\nfn ffi_printf_helpers_match() {\n    unsafe {\n        let c = Loaded::new(c_lib_path());\n        let r = Loaded::new(rust_lib_path());\n\n        let c_call = c.op_fn(\"helper_call\");\n        let r_call = r.op_fn(\"helper_call\");\n        let c_ptr = c.op_fn(\"helper_ptr\");\n        let r_ptr = r.op_fn(\"helper_ptr\");\n        let c_use = c.unary_fn(\"use_generated\");\n        let r_use = r.unary_fn(\"use_generated\");\n\n        for (a, b) in [(0, 0), (3, 4), (-2, 5), (10, 10)] {\n            let mut cret = 0;\n            let cout = capture_stdout(|| {\n                cret = c_call(a, b);\n            });\n            let mut rret = 0;\n            let rout = capture_stdout(|| {\n                rret = r_call(a, b);\n            });\n            assert_eq!(cout, rout, \"helper_call stdout differs for ({},{})\", a, b);\n            assert_eq!(cret, rret, \"helper_call return differs for ({},{})\", a, b);\n\n            let mut cret = 0;\n            let cout = capture_stdout(|| {\n                cret = c_ptr(a, b);\n            });\n            let mut rret = 0;\n            let rout = capture_stdout(|| {\n                rret = r_ptr(a, b);\n            });\n            assert_eq!(cout, rout, \"helper_ptr stdout differs for ({},{})\", a, b);\n            assert_eq!(cret, rret, \"helper_ptr return differs for ({},{})\", a, b);\n        }\n\n        for n in 0..=7i32 {\n            let mut cret = 0;\n            let cout = capture_stdout(|| {\n                cret = c_use(n);\n            });\n            let mut rret = 0;\n            let rout = capture_stdout(|| {\n                rret = r_use(n);\n            });\n            assert_eq!(cout, rout, \"use_generated stdout differs for n={}\", n);\n            assert_eq!(cret, rret, \"use_generated return differs for n={}\", n);\n        }\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":590,"cache_read_input_tokens":45330,"cache_creation":{"ephemeral_5m_input_tokens":590,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d70c8913-b824-4183-8c18-b31b0f3aff65","uuid":"fb11de0d-3878-43f5-b2c2-76593272e8f9"}
