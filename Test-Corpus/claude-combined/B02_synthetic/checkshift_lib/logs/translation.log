{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CFSnstUuoRgXsj5fEA29qc","type":"tool_result","content":"File created successfully at: /tmp/harvest-translate-EBrOoW/translated_rust/tests/ffi_compare.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"69a00770-41da-4029-81d4-eda07fe8236f","uuid":"59aa5754-97b2-4d5a-9d0f-a90c7584d236","timestamp":"2026-05-30T01:38:44.781Z","tool_use_result":{"type":"create","filePath":"/tmp/harvest-translate-EBrOoW/translated_rust/tests/ffi_compare.rs","content":"// Integration tests comparing the C reference shared library to the Rust port\n// through the FFI boundary. Both libraries are loaded with libloading and\n// invoked via their exported C symbols.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int, c_uint, c_void};\nuse std::io::{Read, Seek, SeekFrom, Write};\nuse std::os::unix::io::AsRawFd;\nuse std::sync::Mutex;\n\n// libc dup, dup2, fflush, fileno(stdout) are needed to capture printf output.\nextern \"C\" {\n    fn dup(fd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    fn fflush(stream: *mut c_void) -> c_int;\n}\n\n// Lazy global lock so two captures cannot interleave on stdout (FD 1).\nstatic STDOUT_LOCK: Mutex<()> = Mutex::new(());\n\nfn capture_stdout<F: FnOnce() -> R, R>(f: F) -> (R, Vec<u8>) {\n    let _guard = STDOUT_LOCK.lock().unwrap();\n    // Flush stdout in C before redirecting so prior buffered output isn't captured.\n    unsafe {\n        // 0 == NULL flushes all open output streams.\n        fflush(std::ptr::null_mut());\n    }\n    let mut tmp = tempfile().expect(\"tempfile\");\n    let saved_fd;\n    unsafe {\n        saved_fd = dup(1);\n        assert!(saved_fd >= 0, \"dup failed\");\n        let rc = dup2(tmp.as_raw_fd(), 1);\n        assert!(rc >= 0, \"dup2 failed\");\n    }\n    let result = f();\n    unsafe {\n        fflush(std::ptr::null_mut());\n        let rc = dup2(saved_fd, 1);\n        assert!(rc >= 0, \"dup2 restore failed\");\n        close(saved_fd);\n    }\n    tmp.seek(SeekFrom::Start(0)).expect(\"seek\");\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).expect(\"read\");\n    (result, buf)\n}\n\nfn tempfile() -> std::io::Result<std::fs::File> {\n    let dir = std::env::temp_dir();\n    let pid = std::process::id();\n    let nanos = std::time::SystemTime::now()\n        .duration_since(std::time::UNIX_EPOCH)\n        .unwrap()\n        .as_nanos();\n    let counter = std::sync::atomic::AtomicU64::new(0);\n    let n = counter.fetch_add(1, std::sync::atomic::Ordering::SeqCst);\n    let path = dir.join(format!(\"ffi_compare_{}_{}_{}.tmp\", pid, nanos, n));\n    let f = std::fs::OpenOptions::new()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(true)\n        .open(&path)?;\n    let _ = std::fs::remove_file(&path);\n    Ok(f)\n}\n\nconst C_LIB: &str = \"c_src/build/libtranslated_rust.so\";\nconst RUST_LIB: &str = \"target/release/libtranslated_rust.so\";\n\nfn load(path: &str) -> Library {\n    unsafe { Library::new(path).expect(\"failed to load library\") }\n}\n\n// ---- Wrappers ----\n\nunsafe fn sym<T>(lib: &Library, name: &[u8]) -> Symbol<T> {\n    lib.get(name).expect(\"symbol not found\")\n}\n\nfn run_pair<F, R>(name: &str, c: &Library, r: &Library, mut f: F)\nwhere\n    F: FnMut(&Library) -> R,\n    R: PartialEq + std::fmt::Debug,\n{\n    let (rc, c_out) = capture_stdout(|| f(c));\n    let (rr, r_out) = capture_stdout(|| f(r));\n    assert_eq!(rc, rr, \"[{}] return values differ\", name);\n    if c_out != r_out {\n        eprintln!(\n            \"C output:\\n{}\\n--\\nRust output:\\n{}\",\n            String::from_utf8_lossy(&c_out),\n            String::from_utf8_lossy(&r_out)\n        );\n        panic!(\"[{}] stdout output differs\", name);\n    }\n}\n\n// ---- Tests ----\n\n#[test]\nfn test_multiply_with_static() {\n    let c = load(C_LIB);\n    let r = load(RUST_LIB);\n    let cases = [\n        (0, 0),\n        (1, 1),\n        (2, 5),\n        (-3, 7),\n        (i32::MAX, 2),\n        (i32::MIN, 2),\n        (1_000_000, 1_000),\n    ];\n    for (a, b) in cases {\n        run_pair(&format!(\"multiply_with_static({},{})\", a, b), &c, &r, |lib| {\n            let f: Symbol<unsafe extern \"C\" fn(c_int, c_int) -> c_int> =\n                unsafe { sym(lib, b\"multiply_with_static\") };\n            unsafe { f(a, b) }\n        });\n    }\n}\n\n#[test]\nfn test_add_with_static() {\n    let c = load(C_LIB);\n    let r = load(RUST_LIB);\n    let cases = [\n        (0, 0),\n        (-100, 50),\n        (i32::MAX, 1),\n        (i32::MIN, -1),\n        (1234, 5678),\n    ];\n    for (a, b) in cases {\n        run_pair(&format!(\"add_with_static({},{})\", a, b), &c, &r, |lib| {\n            let f: Symbol<unsafe extern \"C\" fn(c_int, c_int) -> c_int> =\n                unsafe { sym(lib, b\"add_with_static\") };\n            unsafe { f(a, b) }\n        });\n    }\n}\n\n#[test]\nfn test_xor_operation() {\n    let c = load(C_LIB);\n    let r = load(RUST_LIB);\n    let cases = [\n        (0, 0),\n        (-1, 0),\n        (0xABCD, 0),\n        (0x12345678u32 as i32, 0x9ABCDEF0u32 as i32),\n        (i32::MAX, i32::MIN),\n    ];\n    for (a, b) in cases {\n        run_pair(&format!(\"xor_operation({},{})\", a, b), &c, &r, |lib| {\n            let f: Symbol<unsafe extern \"C\" fn(c_int, c_int) -> c_int> =\n                unsafe { sym(lib, b\"xor_operation\") };\n            unsafe { f(a, b) }\n        });\n    }\n}\n\n#[test]\nfn test_shift_with_static() {\n    let c = load(C_LIB);\n    let r = load(RUST_LIB);\n    let cases = [\n        (0, 0),\n        (1, 0),\n        (0x40000000, 0),\n        (0x12345678, 0x12345678),\n        (-1, -1),\n        (i32::MIN, i32::MAX),\n    ];\n    for (a, b) in cases {\n        run_pair(&format!(\"shift_with_static({},{})\", a, b), &c, &r, |lib| {\n            let f: Symbol<unsafe extern \"C\" fn(c_int, c_int) -> c_int> =\n                unsafe { sym(lib, b\"shift_with_static\") };\n            unsafe { f(a, b) }\n        });\n    }\n}\n\n#[test]\nfn test_get_operation() {\n    // get_operation returns a function pointer. We exercise it indirectly: for\n    // each opcode, verify that calling the returned pointer with the same args\n    // produces the same result on both sides. For invalid opcodes both must be\n    // NULL.\n    let c = load(C_LIB);\n    let r = load(RUST_LIB);\n\n    type GetOp = unsafe extern \"C\" fn(c_int) -> Option<unsafe extern \"C\" fn(c_int, c_int) -> c_int>;\n    let cg: Symbol<GetOp> = unsafe { sym(&c, b\"get_operation\") };\n    let rg: Symbol<GetOp> = unsafe { sym(&r, b\"get_operation\") };\n\n    for opcode in [-1, 0, 1, 2, 3, 4, 100] {\n        unsafe {\n            let cf = cg(opcode);\n            let rf = rg(opcode);\n            assert_eq!(\n                cf.is_some(),\n                rf.is_some(),\n                \"get_operation({}) NULL mismatch\",\n                opcode\n            );\n            if let (Some(cfun), Some(rfun)) = (cf, rf) {\n                for (a, b) in [(0, 0), (3, 4), (-7, 11), (0xABC, 0xDEF)] {\n                    let cv = cfun(a, b);\n                    let rv = rfun(a, b);\n                    assert_eq!(cv, rv, \"get_operation({}) result mismatch a={} b={}\", opcode, a, b);\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn test_execute_operation() {\n    let c = load(C_LIB);\n    let r = load(RUST_LIB);\n\n    type GetOp = unsafe extern \"C\" fn(c_int) -> Option<unsafe extern \"C\" fn(c_int, c_int) -> c_int>;\n    type ExecOp = unsafe extern \"C\" fn(\n        Option<unsafe extern \"C\" fn(c_int, c_int) -> c_int>,\n        c_int,\n        c_int,\n        *const c_char,\n    ) -> c_int;\n\n    let names: [&[u8]; 4] = [b\"MULT\\0\", b\"ADD\\0\", b\"XOR\\0\", b\"SHIFT\\0\"];\n\n    for opcode in [0, 1, 2, 3] {\n        for (a, b) in [(0, 0), (5, 7), (-1, -1), (12345, 6789)] {\n            let label = format!(\"execute_operation(op={}, a={}, b={})\", opcode, a, b);\n            run_pair(&label, &c, &r, |lib| {\n                let go: Symbol<GetOp> = unsafe { sym(lib, b\"get_operation\") };\n                let eo: Symbol<ExecOp> = unsafe { sym(lib, b\"execute_operation\") };\n                unsafe {\n                    let f = go(opcode);\n                    eo(f, a, b, names[opcode as usize].as_ptr() as *const c_char)\n                }\n            });\n        }\n    }\n\n    // NULL func path\n    run_pair(\"execute_operation(NULL, ...)\", &c, &r, |lib| {\n        let eo: Symbol<ExecOp> = unsafe { sym(lib, b\"execute_operation\") };\n        unsafe { eo(None, 1, 2, b\"NULLOP\\0\".as_ptr() as *const c_char) }\n    });\n}\n\n#[test]\nfn test_compute_checksum() {\n    let c = load(C_LIB);\n    let r = load(RUST_LIB);\n\n    type Cs = unsafe extern \"C\" fn(*mut c_int, c_int) -> c_uint;\n\n    let mut cases: Vec<Vec<c_int>> = vec![\n        vec![],\n        vec![0],\n        vec![1, 2, 3, 4],\n        vec![1, 2, 3, 4, 5, 6, 7, 8],\n        vec![-1, -2, -3, -4],\n        vec![i32::MIN, i32::MAX, 0, -1],\n    ];\n\n    for arr in cases.iter_mut() {\n        let len = arr.len() as c_int;\n        // NULL pointer path with count > 0\n        let label = format!(\"compute_checksum(len={})\", len);\n        let arr_clone_c = arr.clone();\n        let arr_clone_r = arr.clone();\n        let mut a_c = arr_clone_c;\n        let mut a_r = arr_clone_r;\n\n        let (rc, _) = capture_stdout(|| {\n            let f: Symbol<Cs> = unsafe { sym(&c, b\"compute_checksum\") };\n            let p = if a_c.is_empty() {\n                std::ptr::null_mut()\n            } else {\n                a_c.as_mut_ptr()\n            };\n            unsafe { f(p, len) }\n        });\n        let (rr, _) = capture_stdout(|| {\n            let f: Symbol<Cs> = unsafe { sym(&r, b\"compute_checksum\") };\n            let p = if a_r.is_empty() {\n                std::ptr::null_mut()\n            } else {\n                a_r.as_mut_ptr()\n            };\n            unsafe { f(p, len) }\n        });\n        assert_eq!(rc, rr, \"[{}]\", label);\n    }\n\n    // Explicit NULL with positive count — should return 0\n    let f_c: Symbol<Cs> = unsafe { sym(&c, b\"compute_checksum\") };\n    let f_r: Symbol<Cs> = unsafe { sym(&r, b\"compute_checksum\") };\n    unsafe {\n        assert_eq!(f_c(std::ptr::null_mut(), 4), f_r(std::ptr::null_mut(), 4));\n        assert_eq!(f_c(std::ptr::null_mut(), 0), f_r(std::ptr::null_mut(), 0));\n    }\n}\n\n#[test]\nfn test_init_state_and_apply() {\n    let c = load(C_LIB);\n    let r = load(RUST_LIB);\n\n    // Use a 12-byte buffer (matching ComputeState layout: int, int, unsigned int).\n    #[repr(C)]\n    #[derive(Copy, Clone, Default, Debug, PartialEq, Eq)]\n    struct State {\n        accumulator: c_int,\n        operation_count: c_int,\n        checksum: c_uint,\n    }\n\n    type InitFn = unsafe extern \"C\" fn(*mut State, c_int);\n    type ApplyFn = unsafe extern \"C\" fn(\n        *mut State,\n        c_int,\n        Option<unsafe extern \"C\" fn(c_int, c_int) -> c_int>,\n    );\n    type GetOp = unsafe extern \"C\" fn(c_int) -> Option<unsafe extern \"C\" fn(c_int, c_int) -> c_int>;\n\n    for init_val in [0, 5, -7, 100, i32::MIN, i32::MAX] {\n        let label = format!(\"init_state({})\", init_val);\n        let mut sc = State::default();\n        let mut sr = State::default();\n\n        let (_, oc) = capture_stdout(|| {\n            let f: Symbol<InitFn> = unsafe { sym(&c, b\"init_state\") };\n            unsafe { f(&mut sc, init_val) };\n        });\n        let (_, or) = capture_stdout(|| {\n            let f: Symbol<InitFn> = unsafe { sym(&r, b\"init_state\") };\n            unsafe { f(&mut sr, init_val) };\n        });\n        assert_eq!(oc, or, \"[{}] stdout differs\", label);\n        assert_eq!(sc, sr, \"[{}] state differs\", label);\n\n        // Apply each operation and compare states.\n        for op in 0..4 {\n            for v in [0, 1, -3, 9999] {\n                let label2 = format!(\"apply_operation(init={}, op={}, v={})\", init_val, op, v);\n                let (_, oc) = capture_stdout(|| {\n                    let go: Symbol<GetOp> = unsafe { sym(&c, b\"get_operation\") };\n                    let ap: Symbol<ApplyFn> = unsafe { sym(&c, b\"apply_operation\") };\n                    unsafe {\n                        let f = go(op);\n                        ap(&mut sc, v, f);\n                    }\n                });\n                let (_, or) = capture_stdout(|| {\n                    let go: Symbol<GetOp> = unsafe { sym(&r, b\"get_operation\") };\n                    let ap: Symbol<ApplyFn> = unsafe { sym(&r, b\"apply_operation\") };\n                    unsafe {\n                        let f = go(op);\n                        ap(&mut sr, v, f);\n                    }\n                });\n                assert_eq!(oc, or, \"[{}] stdout differs\", label2);\n                assert_eq!(sc, sr, \"[{}] state differs\", label2);\n            }\n        }\n    }\n\n    // NULL state path\n    run_pair(\"init_state(NULL)\", &c, &r, |lib| {\n        let f: Symbol<InitFn> = unsafe { sym(lib, b\"init_state\") };\n        unsafe { f(std::ptr::null_mut(), 42) };\n    });\n    run_pair(\"apply_operation(NULL, _, _)\", &c, &r, |lib| {\n        let f: Symbol<ApplyFn> = unsafe { sym(lib, b\"apply_operation\") };\n        unsafe { f(std::ptr::null_mut(), 7, None) };\n    });\n    // apply_operation with NULL func and non-null state\n    let mut s_c = State::default();\n    let mut s_r = State::default();\n    let (_, oc) = capture_stdout(|| {\n        let f: Symbol<ApplyFn> = unsafe { sym(&c, b\"apply_operation\") };\n        unsafe { f(&mut s_c, 5, None) };\n    });\n    let (_, or) = capture_stdout(|| {\n        let f: Symbol<ApplyFn> = unsafe { sym(&r, b\"apply_operation\") };\n        unsafe { f(&mut s_r, 5, None) };\n    });\n    assert_eq!(oc, or);\n    assert_eq!(s_c, s_r);\n}\n\n#[test]\nfn test_checkshift() {\n    let c = load(C_LIB);\n    let r = load(RUST_LIB);\n\n    let cases = [\n        (0, 0, 0, 0),\n        (1, 2, 3, 4),\n        (-1, -2, -3, -4),\n        (10, 20, 30, 40),\n        (1000, -500, 250, -125),\n        (i32::MAX, 1, 1, 1),\n        (i32::MIN, -1, 0, 7),\n        (0xABC, 0xDEF, 0x123, 0x456),\n    ];\n    for (a, b, c_, d) in cases {\n        run_pair(\n            &format!(\"checkshift({},{},{},{})\", a, b, c_, d),\n            &c,\n            &r,\n            |lib| {\n                let f: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =\n                    unsafe { sym(lib, b\"checkshift\") };\n                unsafe { f(a, b, c_, d) }\n            },\n        );\n    }\n}\n\n#[test]\nfn test_exported_symbols_match() {\n    // Sanity-check: every textual symbol the C .so exports must also exist in\n    // the Rust .so. We don't shell out to `nm`; instead we just attempt to\n    // resolve each known public symbol on both sides.\n    let c = load(C_LIB);\n    let r = load(RUST_LIB);\n    let names: &[&[u8]] = &[\n        b\"add_with_static\",\n        b\"apply_operation\",\n        b\"checkshift\",\n        b\"compute_checksum\",\n        b\"execute_operation\",\n        b\"get_operation\",\n        b\"init_state\",\n        b\"multiply_with_static\",\n        b\"shift_with_static\",\n        b\"xor_operation\",\n    ];\n    for n in names {\n        unsafe {\n            let _: Symbol<*const ()> = c.get(n).unwrap_or_else(|_| panic!(\"C missing {:?}\", n));\n            let _: Symbol<*const ()> = r.get(n).unwrap_or_else(|_| panic!(\"Rust missing {:?}\", n));\n        }\n    }\n    // Avoid unused warnings.\n    let _ = std::io::stdout().flush();\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
