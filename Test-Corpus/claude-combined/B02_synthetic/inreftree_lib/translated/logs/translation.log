n semantics. C `/` truncates toward zero,\n    // which matches Rust's `/` for primitive integers.\n    // Note: a / b with a == INT_MIN and b == -1 is UB in C; match wrapping.\n    a.wrapping_div(b)\n}\n\nfn modulo_op(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n    if b == 0 {\n        return 0;\n    }\n    a.wrapping_rem(b)\n}\n\n/// Returns Some(index) into NODE_TABLE for the node with the given id, else None.\nunsafe fn find_node_index_by_id(id: c_int) -> Option<usize> {\n    let count = NODE_COUNT as usize;\n    for i in 0..count {\n        if NODE_TABLE[i].id == id {\n            return Some(i);\n        }\n    }\n    None\n}\n\n/// Replicates `strncpy(dst, src, 31)` then `dst[31] = '\\0'`.\n/// `src` is a C string (NUL terminated). We copy at most 31 bytes (stopping\n/// at the NUL terminator) into the destination, zero-filling the remainder\n/// of the first 31 bytes (matching strncpy semantics) and forcing\n/// dst[31] = 0.\nunsafe fn copy_label(dst: &mut [c_char; 32], src: *const c_char) {\n    // Replicate strncpy(dst, src, 31): copy until NUL or 31 bytes consumed,\n    // then zero-fill the remaining bytes within the 31-byte window.\n    let mut i: usize = 0;\n    let mut hit_nul = false;\n    while i < 31 {\n        if !hit_nul {\n            let b = *src.add(i);\n            dst[i] = b;\n            if b == 0 {\n                hit_nul = true;\n            }\n        } else {\n            dst[i] = 0;\n        }\n        i += 1;\n    }\n    dst[31] = 0;\n}\n\nunsafe fn add_tree_node(id: c_int, value: c_int, parent_id: c_int, label: *const c_char) -> c_int {\n    if NODE_COUNT >= MAX_NODES as c_int {\n        return -1;\n    }\n\n    let idx = NODE_COUNT as usize;\n    {\n        let node = &mut NODE_TABLE[idx];\n        node.id = id;\n        node.value = value;\n        node.parent_id = parent_id;\n        node.left_child_id = -1;\n        node.right_child_id = -1;\n        copy_label(&mut node.label, label);\n    }\n\n    if parent_id != -1 {\n        match find_node_index_by_id(parent_id) {\n            None => return -1,\n            Some(pidx) => {\n                let parent = &mut NODE_TABLE[pidx];\n                // Note: the C code redundantly checks `parent->id != parent_id`\n                // after finding by id; that's always false, but we mirror the\n                // structure regardless.\n                if parent.id != parent_id {\n                    return -1;\n                }\n                if parent.left_child_id == -1 {\n                    parent.left_child_id = id;\n                } else if parent.right_child_id == -1 {\n                    parent.right_child_id = id;\n                }\n            }\n        }\n    }\n\n    NODE_COUNT += 1;\n    NODE_COUNT - 1\n}\n\nunsafe fn calculate_tree_sum(node_id: c_int) -> c_int {\n    let idx = match find_node_index_by_id(node_id) {\n        None => return 0,\n        Some(i) => i,\n    };\n\n    // Snapshot fields we need (copy out to avoid aliasing issues during recursion).\n    let value = NODE_TABLE[idx].value;\n    let left = NODE_TABLE[idx].left_child_id;\n    let right = NODE_TABLE[idx].right_child_id;\n\n    let mut sum: c_int = value;\n    if left != -1 {\n        sum = sum.wrapping_add(calculate_tree_sum(left));\n    }\n    if right != -1 {\n        sum = sum.wrapping_add(calculate_tree_sum(right));\n    }\n    sum\n}\n\n/// Replicates strchr(s, c) returning whether the character is present.\n/// `s` may be NULL.\nunsafe fn strchr_contains(s: *const c_char, c: c_char) -> bool {\n    if s.is_null() {\n        return false;\n    }\n    let mut i: usize = 0;\n    loop {\n        let b = *s.add(i);\n        if b == c {\n            // strchr also matches the trailing NUL when c == '\\0'.\n            return true;\n        }\n        if b == 0 {\n            return false;\n        }\n        i += 1;\n    }\n}\n\nunsafe fn parse_operation(op_str: *const c_char) -> Operation {\n    // Match the C exactly: `op_str == NULL || strchr(op_str, '+') != NULL`\n    if op_str.is_null() || strchr_contains(op_str, b'+' as c_char) {\n        return Operation::Add;\n    }\n    if strchr_contains(op_str, b'*' as c_char) {\n        return Operation::Multiply;\n    }\n    if strchr_contains(op_str, b'-' as c_char) {\n        return Operation::Subtract;\n    }\n    if strchr_contains(op_str, b'/' as c_char) {\n        return Operation::Divide;\n    }\n    if strchr_contains(op_str, b'%' as c_char) {\n        return Operation::Modulo;\n    }\n    Operation::Add\n}\n\nfn get_operation_func(op: Operation) -> OperationFunc {\n    match op as c_int {\n        1 => add_op,\n        2 => multiply_op,\n        3 => subtract_op,\n        4 => divide_op,\n        5 => modulo_op,\n        _ => add_op,\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn inreftree(param1: c_int, param2: c_int, param3: c_int, param4: c_int) -> c_int {\n    unsafe {\n        NODE_COUNT = 0;\n\n        // Static C-string labels (NUL-terminated). Using byte literals + 0.\n        let root_label = b\"root\\0\".as_ptr() as *const c_char;\n        let left_label = b\"left\\0\".as_ptr() as *const c_char;\n        let right_label = b\"right\\0\".as_ptr() as *const c_char;\n        let leftleft_label = b\"left-left\\0\".as_ptr() as *const c_char;\n\n        add_tree_node(1, param1, -1, root_label);\n        add_tree_node(2, param2, 1, left_label);\n        add_tree_node(3, param3, 1, right_label);\n        add_tree_node(4, param4, 2, leftleft_label);\n\n        let mut target_id: c_int = -1;\n        let count = NODE_COUNT as usize;\n        for i in 0..count {\n            // Take a pointer to the label so strchr_contains sees the same bytes.\n            let label_ptr = NODE_TABLE[i].label.as_ptr();\n            if strchr_contains(label_ptr, b'l' as c_char) {\n                target_id = NODE_TABLE[i].id;\n                break;\n            }\n        }\n\n        let target_idx_opt = find_node_index_by_id(target_id);\n        let need_reset = match target_idx_opt {\n            None => true,\n            Some(idx) => NODE_TABLE[idx].value == 0,\n        };\n        if need_reset {\n            target_id = 1;\n        }\n\n        let tree_sum = calculate_tree_sum(1);\n\n        // op_string = \"+*-%\"\n        let op_string: &[u8; 4] = b\"+*-%\";\n        // C: tree_sum % 4 with signed semantics; index into 4-byte string.\n        // The result of `%` in C may be negative; indexing a negative offset\n        // is UB in C. We replicate the literal computed value bit-for-bit.\n        let idx_signed = tree_sum.wrapping_rem(4);\n        // Reproduce indexing: `op_string[tree_sum % 4]`.\n        // To match potential C UB safely while preserving common-case values,\n        // when the index is in 0..4 we read from op_string. Otherwise we\n        // fall back to '+': in practice tree_sum is the sum of inputs, and\n        // for the cases the test exercises we expect non-negative indices.\n        let op_byte = if (0..4).contains(&idx_signed) {\n            op_string[idx_signed as usize]\n        } else {\n            // Negative index in C is UB; we replicate by taking the byte\n            // at the equivalent position relative to the start of the\n            // op_string array (i.e. wrap into 0..4 using Euclidean mod).\n            // Note: this is not strictly defined by C, but produces a\n            // deterministic value rather than a crash.\n            let m = idx_signed.rem_euclid(4) as usize;\n            op_string[m]\n        };\n        let op_char: [c_char; 2] = [op_byte as c_char, 0];\n        let op = parse_operation(op_char.as_ptr());\n\n        let _op_value = op as c_int;\n\n        let func = get_operation_func(op);\n\n        func(tree_sum, target_id, 0, 0)\n    }\n}\n","userModified":false}}
