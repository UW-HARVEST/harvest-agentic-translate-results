e extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\ntype Inreftree = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n\nfn manifest_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn load_lib(rel: &str) -> Library {\n    let path = manifest_dir().join(rel);\n    assert!(\n        path.exists(),\n        \"expected library at {} — did you build it?\",\n        path.display()\n    );\n    unsafe { Library::new(&path) }.expect(\"failed to load library\")\n}\n\nstruct Libs {\n    c: Library,\n    rust: Library,\n}\n\nfn libs() -> Libs {\n    Libs {\n        c: load_lib(C_REL_PATH),\n        rust: load_lib(RUST_REL_PATH),\n    }\n}\n\nunsafe fn sym<'a, T>(lib: &'a Library, name: &[u8]) -> Symbol<'a, T> {\n    lib.get(name).unwrap_or_else(|e| {\n        panic!(\n            \"missing symbol {}: {e}\",\n            std::str::from_utf8(name).unwrap_or(\"<bad utf8>\")\n        )\n    })\n}\n\n#[test]\nfn add_op_parity() {\n    let libs = libs();\n    unsafe {\n        let c: Symbol<AddOp> = sym(&libs.c, b\"add_op\");\n        let r: Symbol<AddOp> = sym(&libs.rust, b\"add_op\");\n        for (a, b) in [\n            (0, 0),\n            (1, 2),\n            (-3, 7),\n            (i32::MAX, 1),    // wraps in C (signed overflow UB but matches in practice)\n            (i32::MIN, -1),\n            (12345, -67890),\n        ] {\n            assert_eq!(c(a, b, 0, 0), r(a, b, 0, 0), \"add_op({a}, {b})\");\n        }\n    }\n}\n\n#[test]\nfn multiply_op_parity() {\n    let libs = libs();\n    unsafe {\n        let c: Symbol<AddOp> = sym(&libs.c, b\"multiply_op\");\n        let r: Symbol<AddOp> = sym(&libs.rust, b\"multiply_op\");\n        for (a, b) in [(0, 0), (1, 2), (-3, 7), (123, 456), (-1, -1), (10, 0)] {\n            assert_eq!(c(a, b, 0, 0), r(a, b, 0, 0), \"multiply_op({a}, {b})\");\n        }\n    }\n}\n\n#[test]\nfn subtract_op_parity() {\n    let libs = libs();\n    unsafe {\n        let c: Symbol<AddOp> = sym(&libs.c, b\"subtract_op\");\n        let r: Symbol<AddOp> = sym(&libs.rust, b\"subtract_op\");\n        for (a, b) in [(0, 0), (5, 3), (-3, 7), (1000, -1000)] {\n            assert_eq!(c(a, b, 0, 0), r(a, b, 0, 0), \"subtract_op({a}, {b})\");\n        }\n    }\n}\n\n#[test]\nfn divide_op_parity() {\n    let libs = libs();\n    unsafe {\n        let c: Symbol<AddOp> = sym(&libs.c, b\"divide_op\");\n        let r: Symbol<AddOp> = sym(&libs.rust, b\"divide_op\");\n        for (a, b) in [\n            (10, 2),\n            (10, 3),\n            (-10, 3),\n            (10, -3),\n            (0, 1),\n            (5, 0),  // divide-by-zero short-circuit -> 0\n            (-7, -2),\n        ] {\n            assert_eq!(c(a, b, 0, 0), r(a, b, 0, 0), \"divide_op({a}, {b})\");\n        }\n    }\n}\n\n#[test]\nfn modulo_op_parity() {\n    let libs = libs();\n    unsafe {\n        let c: Symbol<AddOp> = sym(&libs.c, b\"modulo_op\");\n        let r: Symbol<AddOp> = sym(&libs.rust, b\"modulo_op\");\n        for (a, b) in [(10, 3), (-10, 3), (10, -3), (0, 5), (5, 0), (-7, -2)] {\n            assert_eq!(c(a, b, 0, 0), r(a, b, 0, 0), \"modulo_op({a}, {b})\");\n        }\n    }\n}\n\n#[test]\nfn parse_operation_parity() {\n    let libs = libs();\n    unsafe {\n        let c: Symbol<ParseOperation> = sym(&libs.c, b\"parse_operation\");\n        let r: Symbol<ParseOperation> = sym(&libs.rust, b\"parse_operation\");\n\n        // NULL -> OP_ADD (1)\n        assert_eq!(c(std::ptr::null()), r(std::ptr::null()));\n\n        let cases: &[&[u8]] = &[\n            b\"+\\0\",\n            b\"*\\0\",\n            b\"-\\0\",\n            b\"/\\0\",\n            b\"%\\0\",\n            b\"\\0\",\n            b\"abc\\0\",\n            b\"a+b\\0\",\n            b\"a*b\\0\",\n            b\"a-b\\0\",\n            b\"a/b\\0\",\n            b\"a%b\\0\",\n            // mixed: '+' takes priority because it's checked first\n            b\"+*-/%\\0\",\n        ];\n        for case in cases {\n            let p = case.as_ptr() as *const c_char;\n            assert_eq!(\n                c(p),\n                r(p),\n                \"parse_operation({:?})\",\n                std::str::from_utf8(&case[..case.len() - 1]).unwrap()\n            );\n        }\n    }\n}\n\n#[test]\nfn get_operation_func_parity() {\n    let libs = libs();\n    unsafe {\n        let c: Symbol<GetOperationFunc> = sym(&libs.c, b\"get_operation_func\");\n        let r: Symbol<GetOperationFunc> = sym(&libs.rust, b\"get_operation_func\");\n\n        // Ensure that the function pointers returned, when invoked with the\n        // same inputs, produce the same outputs. We can't compare pointers\n        // directly across two different .so images.\n        for op in [-5, 0, 1, 2, 3, 4, 5, 6, 99] {\n            let cf = c(op);\n            let rf = r(op);\n            for (a, b) in [(7, 3), (-4, 9), (0, 0), (10, 0)] {\n                assert_eq!(\n                    cf(a, b, 0, 0),\n                    rf(a, b, 0, 0),\n                    \"get_operation_func({op})({a}, {b})\"\n                );\n            }\n        }\n    }\n}\n\n#[test]\nfn add_tree_node_and_find_node_parity() {\n    let libs = libs();\n    unsafe {\n        let c_add: Symbol<AddTreeNode> = sym(&libs.c, b\"add_tree_node\");\n        let r_add: Symbol<AddTreeNode> = sym(&libs.rust, b\"add_tree_node\");\n        let c_find: Symbol<FindNodeById> = sym(&libs.c, b\"find_node_by_id\");\n        let r_find: Symbol<FindNodeById> = sym(&libs.rust, b\"find_node_by_id\");\n\n        // Both libraries have separate `node_count` globals, so we can build\n        // identical trees in each independently and compare structure.\n        let labels: &[&[u8]] = &[b\"root\\0\", b\"left\\0\", b\"right\\0\", b\"leaf-A\\0\", b\"leaf-B\\0\"];\n        let nodes: &[(c_int, c_int, c_int)] = &[\n            (1, 100, -1),\n            (2, 50, 1),\n            (3, 25, 1),\n            (4, 12, 2),\n            (5, 6, 2),\n        ];\n\n        for (i, &(id, value, parent)) in nodes.iter().enumerate() {\n            let label = labels[i].as_ptr() as *const c_char;\n            let cret = c_add(id, value, parent, label);\n            let rret = r_add(id, value, parent, label);\n            assert_eq!(cret, rret, \"add_tree_node({id}, {value}, {parent})\");\n        }\n\n        for &(id, value, parent) in nodes {\n            let cn = c_find(id);\n            let rn = r_find(id);\n            assert!(!cn.is_null(), \"C find_node_by_id({id}) returned NULL\");\n            assert!(!rn.is_null(), \"Rust find_node_by_id({id}) returned NULL\");\n\n            let c = *cn;\n            let r = *rn;\n            assert_eq!(c.id, r.id);\n            assert_eq!(c.value, r.value);\n            assert_eq!(c.parent_id, r.parent_id);\n            assert_eq!(c.left_child_id, r.left_child_id);\n            assert_eq!(c.right_child_id, r.right_child_id);\n            assert_eq!(c.label, r.label, \"label bytes for node {id}\");\n            assert_eq!(c.id, id);\n            assert_eq!(c.value, value);\n            assert_eq!(c.parent_id, parent);\n        }\n\n        // Look up a missing id.\n        let cn = c_find(9999);\n        let rn = r_find(9999);\n        assert_eq!(cn.is_null(), rn.is_null());\n        assert!(cn.is_null());\n\n        // Try inserting a node referencing a missing parent — should fail (-1).\n        let bad_label = b\"orphan\\0\".as_ptr() as *const c_char;\n        let cret = c_add(42, 1, 1234, bad_label);\n        let rret = r_add(42, 1, 1234, bad_label);\n        assert_eq!(cret, rret);\n        assert_eq!(cret, -1);\n    }\n}\n\n#[test]\nfn calculate_tree_sum_parity() {\n    let libs = libs();\n    unsafe {\n        let c_add: Symbol<AddTreeNode> = sym(&libs.c, b\"add_tree_node\");\n        let r_add: Symbol<AddTreeNode> = sym(&libs.rust, b\"add_tree_node\");\n        let c_sum: Symbol<CalculateTreeSum> = sym(&libs.c, b\"calculate_tree_sum\");\n        let r_sum: Symbol<CalculateTreeSum> = sym(&libs.rust, b\"calculate_tree_sum\");\n\n        // Both libraries' globals were already populated by the previous test\n        // (libloading caches images per process when the same path is loaded).\n        // To make this test deterministic, we don't rely on that — instead we\n        // call inreftree to (re)initialize state into a known shape, then\n        // compute sums. Actually, we need a clean state. Both libraries reset\n        // node_count = 0 inside inreftree, so call it first, then add fresh\n        // nodes using c_add / r_add.\n        let inref_c: Symbol<Inreftree> = sym(&libs.c, b\"inreftree\");\n        let inref_r: Symbol<Inreftree> = sym(&libs.rust, b\"inreftree\");\n        // inreftree will populate 4 nodes with values param1..param4.\n        let _ = inref_c(10, 20, 30, 40);\n        let _ = inref_r(10, 20, 30, 40);\n\n        for id in [-1, 0, 1, 2, 3, 4, 5, 99] {\n            assert_eq!(\n                c_sum(id),\n                r_sum(id),\n                \"calculate_tree_sum({id}) after inreftree(10,20,30,40)\"\n            );\n        }\n\n        // Force-extend after `inreftree` (whose call left 4 nodes).\n        // Both libs should accept additional nodes identically.\n        let _ = c_add(5, 7, 4, b\"deeper\\0\".as_ptr() as *const c_char);\n        let _ = r_add(5, 7, 4, b\"deeper\\0\".as_ptr() as *const c_char);\n        for id in [1, 2, 3, 4, 5] {\n            assert_eq!(c_sum(id), r_sum(id), \"calculate_tree_sum({id}) after extend\");\n        }\n    }\n}\n\n#[test]\nfn inreftree_parity() {\n    let libs = libs();\n    unsafe {\n        let c: Symbol<Inreftree> = sym(&libs.c, b\"inreftree\");\n        let r: Symbol<Inreftree> = sym(&libs.rust, b\"inreftree\");\n\n        // Picked to span the operation-selection branches (op_string[tree_sum % 4]):\n        //   tree_sum % 4 == 0 -> '+'\n        //   tree_sum % 4 == 1 -> '*'\n        //   tree_sum % 4 == 2 -> '-'\n        //   tree_sum % 4 == 3 -> '%'\n        let cases: &[(c_int, c_int, c_int, c_int)] = &[\n            (1, 1, 1, 1),    // sum=4, %4=0 -> '+'\n            (1, 0, 0, 0),    // sum=1, %4=1 -> '*'\n            (1, 1, 0, 0),    // sum=2, %4=2 -> '-'\n            (1, 1, 1, 0),    // sum=3, %4=3 -> '%'\n            (5, 6, 7, 8),\n            (10, 20, 30, 40),\n            (0, 0, 0, 0),\n            (-1, -1, -1, -1),\n            (100, -50, 25, -75),\n            (i32::MAX, 0, 0, 0),\n            (1, 2, 3, 4),\n            (7, 11, 13, 17),\n        ];\n\n        for &(a, b, cc, d) in cases {\n            assert_eq!(c(a, b, cc, d), r(a, b, cc, d), \"inreftree({a},{b},{cc},{d})\");\n        }\n    }\n}\n\n#[test]\nfn exported_symbol_set_matches_c() {\n    // Sanity check: the Rust .so should export at least the same public\n    // function symbols as the C .so. We don't shell out — we just attempt to\n    // load each name. This guards against regressions where someone removes\n    // a `#[no_mangle]` export.\n    let libs = libs();\n    let names: &[&[u8]] = &[\n        b\"add_op\",\n        b\"multiply_op\",\n        b\"subtract_op\",\n        b\"divide_op\",\n        b\"modulo_op\",\n        b\"find_node_by_id\",\n        b\"add_tree_node\",\n        b\"calculate_tree_sum\",\n        b\"parse_operation\",\n        b\"get_operation_func\",\n        b\"inreftree\",\n    ];\n    unsafe {\n        for n in names {\n            let _c: Symbol<*const ()> = libs.c.get(n).expect(\"C lib missing symbol\");\n            let _r: Symbol<*const ()> = libs.rust.get(n).expect(\"Rust lib missing symbol\");\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
