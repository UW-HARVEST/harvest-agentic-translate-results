).join(\"target/debug/libtranslated_rust.so\")\n}\n\nfn load_lib(path: &PathBuf) -> UnixLibrary {\n    unsafe { UnixLibrary::open(Some(path), RTLD_NOW | RTLD_LOCAL) }\n        .unwrap_or_else(|e| panic!(\"failed to load {}: {}\", path.display(), e))\n}\n\nstruct Libs {\n    c: UnixLibrary,\n    r: UnixLibrary,\n}\n\nfn libs() -> Libs {\n    static ONCE: Once = Once::new();\n    ONCE.call_once(|| {\n        // Make sure the C build exists.\n        let c = c_lib_path();\n        assert!(\n            c.exists(),\n            \"C shared library not built at {}; run cmake first\",\n            c.display()\n        );\n    });\n    Libs {\n        c: load_lib(&c_lib_path()),\n        r: load_lib(&rust_lib_path()),\n    }\n}\n\n// ----- Stdout capture helpers (for byte-for-byte printf comparison) -----\n\n// Redirect stdout (fd 1) to a temp file for the duration of `f`, then return\n// the captured bytes. Uses dup/dup2 so that printf inside the loaded .so\n// (which uses the process's libc stdout) is captured.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    use std::fs::File;\n    use std::io::Read;\n    use std::io::Write;\n    use std::os::unix::io::AsRawFd;\n\n    // Flush rust stdout first.\n    let _ = std::io::stdout().flush();\n\n    // Also flush libc stdout to avoid interleaving previously-buffered data.\n    extern \"C\" {\n        fn fflush(stream: *mut libc::FILE) -> c_int;\n        static mut stdout: *mut libc::FILE;\n    }\n    unsafe { fflush(stdout) };\n\n    let tmp_path = env::temp_dir().join(format!(\n        \"ffi_capture_{}_{}.txt\",\n        std::process::id(),\n        rand_suffix(),\n    ));\n    let tmp = File::create(&tmp_path).expect(\"create tmp file\");\n    let saved = unsafe { libc::dup(1) };\n    assert!(saved >= 0, \"dup failed\");\n    let new_fd = tmp.as_raw_fd();\n    let rc = unsafe { libc::dup2(new_fd, 1) };\n    assert!(rc >= 0, \"dup2 failed\");\n    drop(tmp); // file still open via fd 1\n\n    f();\n\n    unsafe { fflush(stdout) };\n    let _ = std::io::stdout().flush();\n    let rc = unsafe { libc::dup2(saved, 1) };\n    assert!(rc >= 0, \"dup2 restore failed\");\n    unsafe { libc::close(saved) };\n\n    let mut out = Vec::new();\n    File::open(&tmp_path)\n        .expect(\"reopen tmp file\")\n        .read_to_end(&mut out)\n        .expect(\"read tmp file\");\n    let _ = std::fs::remove_file(&tmp_path);\n    out\n}\n\nfn rand_suffix() -> u64 {\n    use std::time::{SystemTime, UNIX_EPOCH};\n    let n = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .map(|d| d.as_nanos() as u64)\n        .unwrap_or(0);\n    n\n}\n\n// ----- Type aliases for the FFI symbols -----\n\ntype FnEnvy = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\ntype FnParseEnv = unsafe extern \"C\" fn(*const c_char, c_int) -> c_int;\ntype FnInitConfig = unsafe extern \"C\" fn(*mut u32);\ntype FnPerformOp = unsafe extern \"C\" fn(c_int, c_int, *mut u32) -> c_int;\ntype FnApplyBits = unsafe extern \"C\" fn(c_int, *mut u32) -> c_int;\n\nunsafe fn sym<T: Copy>(lib: &UnixLibrary, name: &[u8]) -> UnixSymbol<T> {\n    lib.get(name)\n        .unwrap_or_else(|e| panic!(\"symbol {:?} not found: {}\", name, e))\n}\n\n// ----- The PROG_* env vars must be the same when invoking C and Rust to be\n// comparable. The test process clears them up front for each test that does\n// not explicitly set them. -----\n\nfn clear_prog_env() {\n    for k in [\n        \"PROG_VERBOSE\",\n        \"PROG_DEBUG\",\n        \"PROG_OPTIMIZE\",\n        \"PROG_BASE_OFFSET\",\n        \"PROG_MULTIPLIER\",\n    ] {\n        env::remove_var(k);\n    }\n}\n\n// ----- Helpers to build ConfigFlags as the C code lays them out -----\n\nconst fn make_flags(\n    verbose: u32,\n    debug: u32,\n    optimize: u32,\n    cache_enabled: u32,\n    log_level: u32,\n    reserved: u32,\n) -> u32 {\n    (verbose & 1)\n        | ((debug & 1) << 1)\n        | ((optimize & 1) << 2)\n        | ((cache_enabled & 1) << 3)\n        | ((log_level & 0x7) << 4)\n        | ((reserved & 1) << 7)\n}\n\n// ============================================================================\n// Tests\n// ============================================================================\n\n#[test]\nfn parse_env_numeric_default_when_unset() {\n    clear_prog_env();\n    let l = libs();\n    unsafe {\n        let c: UnixSymbol<FnParseEnv> = sym(&l.c, b\"parse_env_numeric\");\n        let r: UnixSymbol<FnParseEnv> = sym(&l.r, b\"parse_env_numeric\");\n        let name = CString::new(\"PROG_NEVER_SET_XYZ\").unwrap();\n        for default in [-1, 0, 1, 42, 0o100, 0o12, i32::MAX, i32::MIN] {\n            let cv = c(name.as_ptr(), default);\n            let rv = r(name.as_ptr(), default);\n            assert_eq!(cv, rv, \"default={}\", default);\n        }\n    }\n}\n\n#[test]\nfn parse_env_numeric_plain_integer() {\n    clear_prog_env();\n    let l = libs();\n    let key = \"PROG_TEST_NUMERIC\";\n    let name = CString::new(key).unwrap();\n    let cases = [\"0\", \"1\", \"-7\", \"12345\", \"  17\", \"9abc\", \"abc\", \"\"];\n    unsafe {\n        let c: UnixSymbol<FnParseEnv> = sym(&l.c, b\"parse_env_numeric\");\n        let r: UnixSymbol<FnParseEnv> = sym(&l.r, b\"parse_env_numeric\");\n        for v in cases {\n            env::set_var(key, v);\n            let cv = c(name.as_ptr(), 99);\n            let rv = r(name.as_ptr(), 99);\n            assert_eq!(cv, rv, \"value={:?}\", v);\n        }\n        env::remove_var(key);\n    }\n}\n\n#[test]\nfn parse_env_numeric_rejects_comma_and_semicolon() {\n    clear_prog_env();\n    let l = libs();\n    let key = \"PROG_TEST_NUMERIC2\";\n    let name = CString::new(key).unwrap();\n    unsafe {\n        let c: UnixSymbol<FnParseEnv> = sym(&l.c, b\"parse_env_numeric\");\n        let r: UnixSymbol<FnParseEnv> = sym(&l.r, b\"parse_env_numeric\");\n        for v in [\"1,2\", \"10;20\", \"5,\", \",5\", \";\", \",\"] {\n            env::set_var(key, v);\n            // Capture stderr is similar to stdout but we mainly check return val.\n            let cv = c(name.as_ptr(), 77);\n            let rv = r(name.as_ptr(), 77);\n            assert_eq!(cv, rv, \"value={:?}\", v);\n            assert_eq!(cv, 77, \"expected default for {:?}\", v);\n        }\n        env::remove_var(key);\n    }\n}\n\n#[test]\nfn init_config_from_env_no_envvars() {\n    clear_prog_env();\n    let l = libs();\n    unsafe {\n        let c: UnixSymbol<FnInitConfig> = sym(&l.c, b\"init_config_from_env\");\n        let r: UnixSymbol<FnInitConfig> = sym(&l.r, b\"init_config_from_env\");\n        let mut cf: u32 = 0xDEAD_BEEF;\n        let mut rf: u32 = 0xDEAD_BEEF;\n        c(&mut cf as *mut u32);\n        r(&mut rf as *mut u32);\n        // Only the low byte (8 bits used by the bitfield) is meaningful.\n        assert_eq!(cf & 0xFF, rf & 0xFF, \"C=0x{:x} R=0x{:x}\", cf, rf);\n    }\n}\n\n#[test]\nfn init_config_from_env_various_envs() {\n    let l = libs();\n    let cases: &[(&[(&str, &str)], &str)] = &[\n        (&[(\"PROG_VERBOSE\", \"1\")], \"verbose=1\"),\n        (&[(\"PROG_VERBOSE\", \"0\")], \"verbose=0\"),\n        (&[(\"PROG_DEBUG\", \"1\")], \"debug=1\"),\n        (&[(\"PROG_DEBUG\", \"yes\")], \"debug=yes\"),\n        (&[(\"PROG_OPTIMIZE\", \"\")], \"optimize empty\"),\n        (&[(\"PROG_OPTIMIZE\", \"anything\")], \"optimize set\"),\n        (\n            &[\n                (\"PROG_VERBOSE\", \"1\"),\n                (\"PROG_DEBUG\", \"1\"),\n                (\"PROG_OPTIMIZE\", \"x\"),\n            ],\n            \"all set\",\n        ),\n        (\n            &[\n                (\"PROG_VERBOSE\", \"abc1def\"),\n                (\"PROG_DEBUG\", \"0\"),\n                (\"PROG_OPTIMIZE\", \"1\"),\n            ],\n            \"verbose contains 1\",\n        ),\n    ];\n    unsafe {\n        let c: UnixSymbol<FnInitConfig> = sym(&l.c, b\"init_config_from_env\");\n        let r: UnixSymbol<FnInitConfig> = sym(&l.r, b\"init_config_from_env\");\n        for (envs, label) in cases {\n            clear_prog_env();\n            for (k, v) in *envs {\n                env::set_var(k, v);\n            }\n            let mut cf: u32 = 0;\n            let mut rf: u32 = 0;\n            c(&mut cf as *mut u32);\n            r(&mut rf as *mut u32);\n            assert_eq!(cf & 0xFF, rf & 0xFF, \"{}: C=0x{:x} R=0x{:x}\", label, cf, rf);\n        }\n        clear_prog_env();\n    }\n}\n\n#[test]\nfn perform_operation_matrix() {\n    let l = libs();\n    unsafe {\n        let c: UnixSymbol<FnPerformOp> = sym(&l.c, b\"perform_operation\");\n        let r: UnixSymbol<FnPerformOp> = sym(&l.r, b\"perform_operation\");\n        let vals = [-100, -3, -1, 0, 1, 2, 7, 50, 1234];\n        let log_levels = [0u32, 1, 2, 3, 4, 5, 6, 7];\n        for &v1 in &vals {\n            for &v2 in &vals {\n                for &opt in &[0u32, 1] {\n                    for &ll in &log_levels {\n                        // debug=0 to avoid stdout\n                        let mut cf =\n                            make_flags(0, 0, opt, 1, ll, 0);\n                        let mut rf = cf;\n                        let cv = c(v1, v2, &mut cf as *mut u32);\n                        let rv = r(v1, v2, &mut rf as *mut u32);\n                        assert_eq!(\n                            cv, rv,\n                            \"v1={} v2={} opt={} ll={}: C={} R={}\",\n                            v1, v2, opt, ll, cv, rv\n                        );\n                        assert_eq!(cf, rf, \"flags mutated differently\");\n                    }\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn apply_bit_operations_matrix() {\n    let l = libs();\n    unsafe {\n        let c: UnixSymbol<FnApplyBits> = sym(&l.c, b\"apply_bit_operations\");\n        let r: UnixSymbol<FnApplyBits> = sym(&l.r, b\"apply_bit_operations\");\n        let vals = [-1, -16, 0, 1, 7, 15, 16, 255, 0x7FFF_FFFF, -0x7FFF_FFFF];\n        for &v in &vals {\n            for &verbose in &[0u32, 1] {\n                for &cache in &[0u32, 1] {\n                    let mut cf = make_flags(verbose, 0, 0, cache, 0, 0);\n                    let mut rf = cf;\n                    let cv = c(v, &mut cf as *mut u32);\n                    let rv = r(v, &mut rf as *mut u32);\n                    assert_eq!(\n                        cv, rv,\n                        \"v={} verbose={} cache={}: C={} R={}\",\n                        v, verbose, cache, cv, rv\n                    );\n                }\n            }\n        }\n    }\n}\n\n// ----- envy: integration tests, including stdout capture -----\n\nfn run_envy(\n    libs: &Libs,\n    p1: c_int,\n    p2: c_int,\n    p3: c_int,\n    p4: c_int,\n) -> ((c_int, Vec<u8>), (c_int, Vec<u8>)) {\n    unsafe {\n        let cf: UnixSymbol<FnEnvy> = sym(&libs.c, b\"envy\");\n        let rf: UnixSymbol<FnEnvy> = sym(&libs.r, b\"envy\");\n        let mut cv = 0;\n        let mut rv = 0;\n        let cout = capture_stdout(|| cv = cf(p1, p2, p3, p4));\n        let rout = capture_stdout(|| rv = rf(p1, p2, p3, p4));\n        ((cv, cout), (rv, rout))\n    }\n}\n\n#[test]\nfn envy_default_environment() {\n    clear_prog_env();\n    let l = libs();\n    let cases: &[(c_int, c_int, c_int, c_int)] = &[\n        (0, 0, 0, 0),\n        (1, 2, 3, 4),\n        (10, 20, 0, 0),\n        (-1, -2, -3, -4),\n        (100, 200, 300, 400),\n        (i32::MIN / 2, 1, 1, 1),\n        (0, 0, 5, 16),\n        (5, 6, 0, 32),\n    ];\n    for &(p1, p2, p3, p4) in cases {\n        let ((cv, cout), (rv, rout)) = run_envy(&l, p1, p2, p3, p4);\n        assert_eq!(\n            cv, rv,\n            \"envy({},{},{},{}) return mismatch: C={} R={}\",\n            p1, p2, p3, p4, cv, rv\n        );\n        assert_eq!(\n            cout, rout,\n            \"envy({},{},{},{}) stdout differs:\\nC={:?}\\nR={:?}\",\n            p1, p2, p3, p4, cout, rout\n        );\n    }\n}\n\n#[test]\nfn envy_verbose_and_debug() {\n    let l = libs();\n    let env_combos: &[&[(&str, &str)]] = &[\n        &[(\"PROG_VERBOSE\", \"1\")],\n        &[(\"PROG_DEBUG\", \"1\")],\n        &[(\"PROG_VERBOSE\", \"1\"), (\"PROG_DEBUG\", \"1\")],\n        &[(\"PROG_VERBOSE\", \"1\"), (\"PROG_OPTIMIZE\", \"yes\")],\n        &[\n            (\"PROG_VERBOSE\", \"1\"),\n            (\"PROG_DEBUG\", \"1\"),\n            (\"PROG_OPTIMIZE\", \"1\"),\n            (\"PROG_BASE_OFFSET\", \"16\"),\n            (\"PROG_MULTIPLIER\", \"5\"),\n        ],\n        &[(\"PROG_BASE_OFFSET\", \"1,2\")], // triggers comma warning\n        &[(\"PROG_MULTIPLIER\", \"5;6\")],  // triggers semicolon warning\n    ];\n    let inputs: &[(c_int, c_int, c_int, c_int)] =\n        &[(1, 2, 3, 4), (10, -3, 5, 8), (0, 0, 0, 0), (-5, 7, 2, 4)];\n    for envs in env_combos {\n        for &(p1, p2, p3, p4) in inputs {\n            clear_prog_env();\n            for (k, v) in *envs {\n                env::set_var(k, v);\n            }\n            let ((cv, cout), (rv, rout)) = run_envy(&l, p1, p2, p3, p4);\n            assert_eq!(\n                cv, rv,\n                \"envy({},{},{},{}) env={:?} return mismatch: C={} R={}\",\n                p1, p2, p3, p4, envs, cv, rv\n            );\n            assert_eq!(\n                cout, rout,\n                \"envy({},{},{},{}) env={:?} stdout differs:\\nC=\\n{}\\nR=\\n{}\",\n                p1,\n                p2,\n                p3,\n                p4,\n                envs,\n                String::from_utf8_lossy(&cout),\n                String::from_utf8_lossy(&rout)\n            );\n        }\n    }\n    clear_prog_env();\n}\n\n#[test]\nfn exported_symbols_match() {\n    // Sanity check: every T-typed symbol the C lib exports, the Rust lib must\n    // also export. We don't shell out to nm here (that's the user-level check)\n    // but we do verify that all five known public symbols resolve in both.\n    let l = libs();\n    for name in [\n        b\"envy\" as &[u8],\n        b\"parse_env_numeric\",\n        b\"init_config_from_env\",\n        b\"perform_operation\",\n        b\"apply_bit_operations\",\n    ] {\n        unsafe {\n            let _: UnixSymbol<*const ()> = sym(&l.c, name);\n            let _: UnixSymbol<*const ()> = sym(&l.r, name);\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
