fd = tmp.as_raw_fd();\n\n        // Replace fd 1 with our tmp file.\n        let r = dup2(tmp_fd, 1);\n        assert!(r >= 0);\n\n        // Run the user function.\n        f();\n\n        // Flush libc stdout buffers.\n        fflush(stdout_ptr);\n\n        // Restore stdout.\n        let r = dup2(saved, 1);\n        assert!(r >= 0);\n        close(saved);\n\n        // Read everything written to tmp.\n        let mut tmp = tmp;\n        tmp.seek(SeekFrom::Start(0)).expect(\"seek\");\n        let mut buf = Vec::new();\n        tmp.read_to_end(&mut buf).expect(\"read\");\n        buf\n    }\n}\n\nfn libc_stdout() -> *mut std::ffi::c_void {\n    // Use the libc stdout symbol via dlopen on libc itself for portability,\n    // but on Linux glibc exposes `stdout` as a global. Just rely on extern \"C\".\n    extern \"C\" {\n        static mut stdout: *mut std::ffi::c_void;\n    }\n    unsafe { stdout }\n}\n\ntype ConfusionFn = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n\nfn run_confusion(lib_path: &str, a: c_int, b: c_int, c: c_int, d: c_int) -> (c_int, Vec<u8>) {\n    unsafe {\n        let lib = Library::new(lib_path).unwrap_or_else(|e| panic!(\"load {lib_path}: {e}\"));\n        let f: Symbol<ConfusionFn> = lib.get(b\"confusion\\0\").expect(\"symbol confusion\");\n\n        let mut ret: c_int = 0;\n        let captured = capture_stdout(|| {\n            ret = f(a, b, c, d);\n        });\n        (ret, captured)\n    }\n}\n\nfn check_inputs(inputs: &[(c_int, c_int, c_int, c_int)]) {\n    for &(a, b, c, d) in inputs {\n        let (c_ret, c_out) = run_confusion(C_LIB, a, b, c, d);\n        let (r_ret, r_out) = run_confusion(RUST_LIB, a, b, c, d);\n        assert_eq!(\n            c_ret, r_ret,\n            \"return value mismatch for ({a}, {b}, {c}, {d}): C={c_ret} Rust={r_ret}\"\n        );\n        if c_out != r_out {\n            eprintln!(\n                \"stdout mismatch for ({a}, {b}, {c}, {d}):\\n--- C ---\\n{}\\n--- Rust ---\\n{}\\n\",\n    