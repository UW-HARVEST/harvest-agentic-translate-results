e the libc stdout symbol via dlopen on libc itself for portability,\n    // but on Linux glibc exposes `stdout` as a global. Just rely on extern \"C\".\n    extern \"C\" {\n        static mut stdout: *mut std::ffi::c_void;\n    }\n    unsafe { stdout }\n}\n\ntype ConfusionFn = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n\nfn run_confusion(lib_path: &str, a: c_int, b: c_int, c: c_int, d: c_int) -> (c_int, Vec<u8>) {\n    unsafe {\n        let lib = Library::new(lib_path).unwrap_or_else(|e| panic!(\"load {lib_path}: {e}\"));\n        let f: Symbol<ConfusionFn> = lib.get(b\"confusion\\0\").expect(\"symbol confusion\");\n\n        let mut ret: c_int = 0;\n        let captured = capture_stdout(|| {\n            ret = f(a, b, c, d);\n        });\n        (ret, captured)\n    }\n}\n\nfn check_inputs(inputs: &[(c_int, c_int, c_int, c_int)]) {\n    for &(a, b, c, d) in inputs {\n        let (c_ret, c_out) = run_confusion(C_LIB, a, b, c, d);\n        let (r_ret, r_out) = run_confusion(RUST_LIB, a, b, c, d);\n        assert_eq!(\n            c_ret, r_ret,\n            \"return value mismatch for ({a}, {b}, {c}, {d}): C={c_ret} Rust={r_ret}\"\n        );\n        if c_out != r_out {\n            eprintln!(\n                \"stdout mismatch for ({a}, {b}, {c}, {d}):\\n--- C ---\\n{}\\n--- Rust ---\\n{}\\n\",\n                String::from_utf8_lossy(&c_out),\n                String::from_utf8_lossy(&r_out)\n            );\n            panic!(\"stdout mismatch for ({a}, {b}, {c}, {d})\");\n        }\n    }\n}\n\n#[test]\nfn confusion_basic_zero() {\n    check_inputs(&[(0, 0, 0, 0)]);\n}\n\n#[test]\nfn confusion_simple_positives() {\n    check_inputs(&[\n        (1, 2, 3, 4),\n        (10, 20, 30, 40),\n        (5, 7, 9, 11),\n        (42, 13, 7, 2),\n    ]);\n}\n\n#[test]\nfn confusion_all_op_branches() {\n    // param4 % 4 selects the switch case 0..3\n    check_inputs(&[\n        (100, 1, 0, 0),\n        (100, 1, 0, 1),\n        (100, 1, 0, 2),\n        (100, 1, 0, 3),\n    ]);\n}\n\n#[test]\nfn confusion_search_chars() {\n    // param3 % 10 selects '0'..'9'\n    for d in 0..10 {\n        check_inputs(&[(123, 5, d, 1)]);\n    }\n}\n\n#[test]\nfn confusion_param2_bits() {\n    // exercises various flag/mode bit combinations\n    for p in 0..64 {\n        check_inputs(&[(7, p, 1, 0)]);\n    }\n}\n\n#[test]\nfn confusion_negatives() {\n    check_inputs(&[\n        (-1, -1, -1, -1),\n        (-100, -2, -3, -4),\n        (-7, 1, 2, 3),\n    ]);\n}\n\n#[test]\nfn confusion_large_values() {\n    check_inputs(&[\n        (1_000_000, 999_999, 12345, 6789),\n        (i32::MAX / 2, 31, 9, 3),\n    ]);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":166,"cache_read_input_tokens":22649,"cache_creation":{"ephemeral_5m_input_tokens":166,"ephemeral_1h_input_tokens":0},"output_tokens":31,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"840a3416-0640-4cb1-be82-1514ca0ebb06","uuid":"4867c4da-d194-4ddc-a554-6f7b6fd18272"}
