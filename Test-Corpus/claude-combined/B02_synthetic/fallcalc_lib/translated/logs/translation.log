{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_qeczy6mymubeabyucnq75tbr2zbsyewny2wp27ovqbwrmhsfrsxq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01BQHaf9dYrbzgtzpqPDh7Lq","name":"Write","input":{"file_path":"/tmp/harvest-translate-nm7A7c/translated_rust/tests/ffi_compare.rs","content":"// FFI comparison test: load both the C reference shared library and the\n// Rust shared library through libloading, then exercise every exported\n// function with identical inputs and assert byte-identical results.\n//\n// We never call into the Rust crate directly — every Rust call goes\n// through the .so, exactly mirroring how an external consumer would use it.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_int;\nuse std::os::raw::c_double;\nuse std::path::PathBuf;\n\n// --- Function-pointer type aliases for the exported C ABI symbols ---\ntype SafeDoubleToInt = unsafe extern \"C\" fn(c_double) -> c_int;\ntype ProcessArrayReverse = unsafe extern \"C\" fn(*mut c_int, c_int) -> c_int;\ntype SwitchFallthroughCalculator = unsafe extern \"C\" fn(c_int, c_int) -> c_int;\ntype AllocateAndCompute = unsafe extern \"C\" fn(c_int, c_double) -> c_int;\ntype ForeachSum = unsafe extern \"C\" fn(*mut c_int, c_int) -> c_int;\ntype Fallcalc = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n\n// --- Helpers ---\nfn c_lib_path() -> PathBuf {\n    let manifest_dir = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    manifest_dir.join(\"c_src\").join(\"build\").join(\"libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    // The Rust .so lives under target/<profile>/. Tests typically run in the\n    // debug profile, but allow either.\n    let manifest_dir = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    let candidates = [\n        manifest_dir.join(\"target/debug/libtranslated_rust.so\"),\n        manifest_dir.join(\"target/release/libtranslated_rust.so\"),\n    ];\n    for c in &candidates {\n        if c.exists() {\n            return c.clone();\n        }\n    }\n    panic!(\n        \"Rust .so not found at any of: {:?}. Did `cargo build` run?\",\n        candidates\n    );\n}\n\nfn load_libs() -> (Library, Library) {\n    // Safety: loading shared libraries can run constructors. Both libraries\n    // are produced by this build and are trusted.\n    let c = unsafe { Library::new(c_lib_path()) }\n        .unwrap_or_else(|e| panic!(\"Failed to open C library: {e}\"));\n    let r = unsafe { Library::new(rust_lib_path()) }\n        .unwrap_or_else(|e| panic!(\"Failed to open Rust library: {e}\"));\n    (c, r)\n}\n\n// ---------- safe_double_to_int ----------\n#[test]\nfn safe_double_to_int_matches() {\n    let (c, r) = load_libs();\n    let c_fn: Symbol<SafeDoubleToInt> = unsafe { c.get(b\"safe_double_to_int\").unwrap() };\n    let r_fn: Symbol<SafeDoubleToInt> = unsafe { r.get(b\"safe_double_to_int\").unwrap() };\n\n    let cases: &[c_double] = &[\n        0.0,\n        -0.0,\n        1.0,\n        -1.0,\n        42.5,\n        -42.5,\n        1e9,\n        -1e9,\n        2_147_483_646.0,                 // INT_MAX - 1\n        2_147_483_647.0,                 // INT_MAX (>= comparison hits)\n        2_147_483_648.0,                 // INT_MAX + 1\n        -2_147_483_647.0,                // INT_MIN + 1\n        -2_147_483_648.0,                // INT_MIN\n        -2_147_483_649.0,                // INT_MIN - 1\n        f64::INFINITY,\n        f64::NEG_INFINITY,\n        f64::NAN,\n        f64::MIN,\n        f64::MAX,\n    ];\n\n    for &d in cases {\n        let cv = unsafe { c_fn(d) };\n        let rv = unsafe { r_fn(d) };\n        assert_eq!(cv, rv, \"safe_double_to_int mismatch for {d}\");\n    }\n}\n\n// ---------- switch_fallthrough_calculator ----------\n#[test]\nfn switch_fallthrough_calculator_matches() {\n    let (c, r) = load_libs();\n    let c_fn: Symbol<SwitchFallthroughCalculator> =\n        unsafe { c.get(b\"switch_fallthrough_calculator\").unwrap() };\n    let r_fn: Symbol<SwitchFallthroughCalculator> =\n        unsafe { r.get(b\"switch_fallthrough_calculator\").unwrap() };\n\n    let values: &[c_int] = &[0, 1, 7, 64, 128, 255, 256, 511, 512, -1, -100, 1234];\n    let ops: &[c_int] = &[-1, 0, 1, 2, 3, 4, 5, 100];\n\n    for &v in values {\n        for &op in ops {\n            let cv = unsafe { c_fn(v, op) };\n            let rv = unsafe { r_fn(v, op) };\n            assert_eq!(cv, rv, \"switch mismatch for v={v}, op={op}\");\n        }\n    }\n}\n\n// ---------- foreach_sum ----------\n#[test]\nfn foreach_sum_matches() {\n    let (c, r) = load_libs();\n    let c_fn: Symbol<ForeachSum> = unsafe { c.get(b\"foreach_sum\").unwrap() };\n    let r_fn: Symbol<ForeachSum> = unsafe { r.get(b\"foreach_sum\").unwrap() };\n\n    let inputs: Vec<Vec<c_int>> = vec![\n        vec![],\n        vec![0],\n        vec![1, 2, 3, 4, 5],\n        vec![-1, -2, -3, -4, -5],\n        vec![100, 200, 300, 400, 500],\n        vec![i32::MAX, 1], // wrapping\n    ];\n\n    for inp in inputs {\n        let count = inp.len() as c_int;\n        let mut a = inp.clone();\n        let mut b = inp.clone();\n        let cv = unsafe { c_fn(a.as_mut_ptr(), count) };\n        let rv = unsafe { r_fn(b.as_mut_ptr(), count) };\n        assert_eq!(cv, rv, \"foreach_sum mismatch for {inp:?}\");\n    }\n}\n\n// ---------- process_array_reverse ----------\n#[test]\nfn process_array_reverse_matches() {\n    let (c, r) = load_libs();\n    let c_fn: Symbol<ProcessArrayReverse> = unsafe { c.get(b\"process_array_reverse\").unwrap() };\n    let r_fn: Symbol<ProcessArrayReverse> = unsafe { r.get(b\"process_array_reverse\").unwrap() };\n\n    let inputs: Vec<Vec<c_int>> = vec![\n        vec![1, 2, 3, 4, 5],\n        vec![-10, -20, -30, 40, 50],\n        vec![0, 0, 0, 0, 0],\n        vec![i32::MAX, 1, -1, i32::MIN, 0],\n    ];\n\n    for inp in inputs {\n        let count = inp.len() as c_int;\n        let mut a = inp.clone();\n        let mut b = inp.clone();\n        // process_array_reverse expects a pointer to the LAST element and\n        // walks backwards count times.\n        let last_a = unsafe { a.as_mut_ptr().offset((count - 1) as isize) };\n        let last_b = unsafe { b.as_mut_ptr().offset((count - 1) as isize) };\n        let cv = unsafe { c_fn(last_a, count) };\n        let rv = unsafe { r_fn(last_b, count) };\n        assert_eq!(cv, rv, \"process_array_reverse mismatch for {inp:?}\");\n    }\n}\n\n// ---------- allocate_and_compute ----------\n#[test]\nfn allocate_and_compute_matches() {\n    let (c, r) = load_libs();\n    let c_fn: Symbol<AllocateAndCompute> = unsafe { c.get(b\"allocate_and_compute\").unwrap() };\n    let r_fn: Symbol<AllocateAndCompute> = unsafe { r.get(b\"allocate_and_compute\").unwrap() };\n\n    let cases: &[(c_int, c_double)] = &[\n        (1, 1.0),\n        (2, 1.5),\n        (5, 2.0),\n        (10, 0.0),\n        (10, -1.0),\n        (10, 1.5),\n        (50, 0.25),\n        (100, 1.5),\n    ];\n\n    for &(size, mult) in cases {\n        let cv = unsafe { c_fn(size, mult) };\n        let rv = unsafe { r_fn(size, mult) };\n        assert_eq!(cv, rv, \"allocate_and_compute mismatch for ({size}, {mult})\");\n    }\n}\n\n// ---------- fallcalc (top-level) ----------\n#[test]\nfn fallcalc_matches() {\n    let (c, r) = load_libs();\n    let c_fn: Symbol<Fallcalc> = unsafe { c.get(b\"fallcalc\").unwrap() };\n    let r_fn: Symbol<Fallcalc> = unsafe { r.get(b\"fallcalc\").unwrap() };\n\n    // Mix of magnitudes, signs, and edge values for the modulo paths.\n    let values: &[c_int] = &[0, 1, 2, 5, 7, 9, 10, 64, 128, 200, 255, -1, -7, -100];\n\n    for &a in values {\n        for &b in values {\n            for &c_ in values {\n                for &d in values {\n                    let cv = unsafe { c_fn(a, b, c_, d) };\n                    let rv = unsafe { r_fn(a, b, c_, d) };\n                    assert_eq!(\n                        cv, rv,\n                        \"fallcalc mismatch for ({a}, {b}, {c_}, {d}): C={cv} R={rv}\"\n                    );\n                }\n            }\n        }\n    }\n}\n\n// Ensure every C-exported public symbol is also exported by the Rust .so.\n#[test]\nfn all_public_symbols_present_in_rust() {\n    let (_c, r) = load_libs();\n    for name in [\n        \"safe_double_to_int\",\n        \"process_array_reverse\",\n        \"switch_fallthrough_calculator\",\n        \"allocate_and_compute\",\n        \"foreach_sum\",\n        \"fallcalc\",\n    ] {\n        let bytes = name.as_bytes();\n        let mut zname = Vec::with_capacity(bytes.len() + 1);\n        zname.extend_from_slice(bytes);\n        zname.push(0);\n        let res: Result<Symbol<unsafe extern \"C\" fn()>, _> = unsafe { r.get(&zname) };\n        assert!(res.is_ok(), \"Rust .so missing symbol `{name}`\");\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":258,"cache_read_input_tokens":26319,"cache_creation":{"ephemeral_5m_input_tokens":258,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"cd3bbaf4-6dd6-4ca6-9826-0e44cff16167","uuid":"1f1c80ca-1f04-4468-be44-c2c5ddaf32d3"}
