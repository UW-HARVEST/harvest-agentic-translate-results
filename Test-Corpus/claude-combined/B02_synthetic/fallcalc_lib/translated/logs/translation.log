rom(env!(\"CARGO_MANIFEST_DIR\"));\n    let candidates = [\n        manifest_dir.join(\"target/debug/libtranslated_rust.so\"),\n        manifest_dir.join(\"target/release/libtranslated_rust.so\"),\n    ];\n    for c in &candidates {\n        if c.exists() {\n            return c.clone();\n        }\n    }\n    panic!(\n        \"Rust .so not found at any of: {:?}. Did `cargo build` run?\",\n        candidates\n    );\n}\n\nfn load_libs() -> (Library, Library) {\n    // Safety: loading shared libraries can run constructors. Both libraries\n    // are produced by this build and are trusted.\n    let c = unsafe { Library::new(c_lib_path()) }\n        .unwrap_or_else(|e| panic!(\"Failed to open C library: {e}\"));\n    let r = unsafe { Library::new(rust_lib_path()) }\n        .unwrap_or_else(|e| panic!(\"Failed to open Rust library: {e}\"));\n    (c, r)\n}\n\n// ---------- safe_double_to_int ----------\n#[test]\nfn safe_double_to_int_matches() {\n    let (c, r) = load_libs();\n    let c_fn: Symbol<SafeDoubleToInt> = unsafe { c.get(b\"safe_double_to_int\").unwrap() };\n    let r_fn: Symbol<SafeDoubleToInt> = unsafe { r.get(b\"safe_double_to_int\").unwrap() };\n\n    let cases: &[c_double] = &[\n        0.0,\n        -0.0,\n        1.0,\n        -1.0,\n        42.5,\n        -42.5,\n        1e9,\n        -1e9,\n        2_147_483_646.0,                 // INT_MAX - 1\n        2_147_483_647.0,                 // INT_MAX (>= comparison hits)\n        2_147_483_648.0,                 // INT_MAX + 1\n        -2_147_483_647.0,                // INT_MIN + 1\n        -2_147_483_648.0,                // INT_MIN\n        -2_147_483_649.0,                // INT_MIN - 1\n        f64::INFINITY,\n        f64::NEG_INFINITY,\n        f64::NAN,\n        f64::MIN,\n        f64::MAX,\n    ];\n\n    for &d in cases {\n        let cv = unsafe { c_fn(d) };\n        let rv = unsafe { r_fn(d) };\n        assert_eq!(cv, rv, \"safe_double_to_int mismatch for {d}\");\n    }\n}\n\n// ---------- swit