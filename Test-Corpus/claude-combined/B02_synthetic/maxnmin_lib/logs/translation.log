{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_lsip5j366ldftgryng6nbklhb3e3occhf7nggscgwx3mwj7ta4ua","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Bpv6UAARDWC2wyh8oA5XHb","name":"Write","input":{"file_path":"/tmp/harvest-translate-IdYIhk/translated_rust/tests/ffi_compare.rs","content":"// Integration tests that load BOTH the C shared library and the Rust shared\n// library through libloading and compare their outputs byte-for-byte.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_char;\nuse std::ffi::c_double;\nuse std::ffi::c_int;\nuse std::path::PathBuf;\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct Node {\n    id: c_int,\n    parent_id: c_int,\n    name: [c_char; 50],\n    value: c_double,\n    active: c_int,\n}\n\nfn c_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nfn rust_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    p.push(\"release\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nfn load_libs() -> (Library, Library) {\n    let c = unsafe { Library::new(c_lib_path()).expect(\"load C lib\") };\n    let r = unsafe { Library::new(rust_lib_path()).expect(\"load Rust lib\") };\n    (c, r)\n}\n\ntype FnAddNode = unsafe extern \"C\" fn(c_int, c_int, *const c_char, c_double) -> c_int;\ntype FnFindNodeById = unsafe extern \"C\" fn(c_int) -> *mut Node;\ntype FnGetChildrenCount = unsafe extern \"C\" fn(c_int) -> c_int;\ntype FnCalculateSubtreeSum = unsafe extern \"C\" fn(c_int) -> c_double;\ntype FnProcessString = unsafe extern \"C\" fn(*mut c_char) -> c_int;\ntype FnSafeDoubleToInt = unsafe extern \"C\" fn(c_double) -> c_int;\ntype FnMaxnmin = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n\nfn cstr(s: &str) -> Vec<u8> {\n    let mut v: Vec<u8> = s.bytes().collect();\n    v.push(0);\n    v\n}\n\n#[test]\nfn test_safe_double_to_int() {\n    let (c, r) = load_libs();\n    unsafe {\n        let cf: Symbol<FnSafeDoubleToInt> = c.get(b\"safe_double_to_int\").unwrap();\n        let rf: Symbol<FnSafeDoubleToInt> = r.get(b\"safe_double_to_int\").unwrap();\n\n        let cases = [\n            0.0_f64,\n            1.0,\n            -1.0,\n            1.5,\n            -1.5,\n            42.0,\n            42.9,\n            -42.9,\n            (i32::MAX as f64) - 0.5,\n            (i32::MAX as f64) + 1.0,\n            (i32::MIN as f64) - 1.0,\n            (i32::MIN as f64),\n            (i32::MAX as f64),\n            f64::NAN,\n            f64::INFINITY,\n            f64::NEG_INFINITY,\n            1e30,\n            -1e30,\n        ];\n        for &d in &cases {\n            assert_eq!(cf(d), rf(d), \"mismatch for d={}\", d);\n        }\n    }\n}\n\n#[test]\nfn test_process_string() {\n    let (c, r) = load_libs();\n    unsafe {\n        let cf: Symbol<FnProcessString> = c.get(b\"process_string\").unwrap();\n        let rf: Symbol<FnProcessString> = r.get(b\"process_string\").unwrap();\n\n        let cases = [\n            \"hello\",\n            \"\",\n            \"a\",\n            \"ABCDEFG\",\n            \"with spaces\",\n            \"0123456789\",\n            \"non-ascii: \\x7f\",\n        ];\n        for s in cases.iter() {\n            let mut buf_c = cstr(s);\n            let mut buf_r = cstr(s);\n            let cv = cf(buf_c.as_mut_ptr() as *mut c_char);\n            let rv = rf(buf_r.as_mut_ptr() as *mut c_char);\n            assert_eq!(cv, rv, \"mismatch for s={:?}\", s);\n        }\n    }\n}\n\n#[test]\nfn test_add_node_and_find_and_children() {\n    let (c, r) = load_libs();\n    unsafe {\n        // Reset by calling maxnmin first (which resets node_count).\n        let cmax: Symbol<FnMaxnmin> = c.get(b\"maxnmin\").unwrap();\n        let rmax: Symbol<FnMaxnmin> = r.get(b\"maxnmin\").unwrap();\n        let _ = cmax(0, 0, 1, 0);\n        let _ = rmax(0, 0, 1, 0);\n\n        // The state after maxnmin should be: 6 nodes (the same set in both).\n        let cfind: Symbol<FnFindNodeById> = c.get(b\"find_node_by_id\").unwrap();\n        let rfind: Symbol<FnFindNodeById> = r.get(b\"find_node_by_id\").unwrap();\n\n        let cgetc: Symbol<FnGetChildrenCount> = c.get(b\"get_children_count\").unwrap();\n        let rgetc: Symbol<FnGetChildrenCount> = r.get(b\"get_children_count\").unwrap();\n\n        for id in -1..=10 {\n            let cp = cfind(id);\n            let rp = rfind(id);\n            assert_eq!(cp.is_null(), rp.is_null(), \"find_node_by_id({}) null mismatch\", id);\n            if !cp.is_null() {\n                let cn = &*cp;\n                let rn = &*rp;\n                assert_eq!(cn.id, rn.id);\n                assert_eq!(cn.parent_id, rn.parent_id);\n                assert_eq!(cn.value.to_bits(), rn.value.to_bits());\n                assert_eq!(cn.active, rn.active);\n                let cname: &[c_char] = &cn.name;\n                let rname: &[c_char] = &rn.name;\n                for i in 0..cname.len() {\n                    assert_eq!(cname[i], rname[i], \"name byte {} mismatch for id={}\", i, id);\n                }\n            }\n            assert_eq!(cgetc(id), rgetc(id), \"children count mismatch parent_id={}\", id);\n        }\n    }\n}\n\n#[test]\nfn test_calculate_subtree_sum() {\n    let (c, r) = load_libs();\n    unsafe {\n        // Initialize via maxnmin (which loads the canonical 6 nodes)\n        let cmax: Symbol<FnMaxnmin> = c.get(b\"maxnmin\").unwrap();\n        let rmax: Symbol<FnMaxnmin> = r.get(b\"maxnmin\").unwrap();\n        let _ = cmax(0, 0, 1, 0);\n        let _ = rmax(0, 0, 1, 0);\n\n        let csum: Symbol<FnCalculateSubtreeSum> = c.get(b\"calculate_subtree_sum\").unwrap();\n        let rsum: Symbol<FnCalculateSubtreeSum> = r.get(b\"calculate_subtree_sum\").unwrap();\n\n        for id in -1..=10 {\n            let cv = csum(id);\n            let rv = rsum(id);\n            assert_eq!(cv.to_bits(), rv.to_bits(), \"sum mismatch id={}\", id);\n        }\n    }\n}\n\n#[test]\nfn test_add_node_direct() {\n    let (c, r) = load_libs();\n    unsafe {\n        // Reset first\n        let cmax: Symbol<FnMaxnmin> = c.get(b\"maxnmin\").unwrap();\n        let rmax: Symbol<FnMaxnmin> = r.get(b\"maxnmin\").unwrap();\n        let _ = cmax(0, 0, 1, 0);\n        let _ = rmax(0, 0, 1, 0);\n\n        // After maxnmin, node_count = 6. Add new nodes and compare returned indices.\n        let cadd: Symbol<FnAddNode> = c.get(b\"add_node\").unwrap();\n        let radd: Symbol<FnAddNode> = r.get(b\"add_node\").unwrap();\n\n        let name = cstr(\"extra\");\n        for i in 0..10 {\n            let cv = cadd(100 + i, 1, name.as_ptr() as *const c_char, i as f64);\n            let rv = radd(100 + i, 1, name.as_ptr() as *const c_char, i as f64);\n            assert_eq!(cv, rv, \"add_node returned mismatch at i={}\", i);\n        }\n    }\n}\n\n#[test]\nfn test_maxnmin() {\n    let (c, r) = load_libs();\n    unsafe {\n        let cf: Symbol<FnMaxnmin> = c.get(b\"maxnmin\").unwrap();\n        let rf: Symbol<FnMaxnmin> = r.get(b\"maxnmin\").unwrap();\n\n        let cases: &[(c_int, c_int, c_int, c_int)] = &[\n            (0, 0, 1, 0),\n            (1, 2, 3, 4),\n            (5, 5, 5, 5),\n            (10, 20, 30, 40),\n            (-1, -2, -3, -4),\n            (-1, -2, 1, -4),\n            (100, 200, 7, 13),\n            (0, 1, 2, 3),\n            (6, 12, 1, 2),\n            (7, 13, 4, 5),\n            (-100, -200, 9, -7),\n            (i32::MAX, i32::MAX, 1, 1),\n            (i32::MIN, i32::MIN, 1, 1),\n            (1, 1, -1, 1),\n            (123, 456, 789, 101),\n        ];\n        for &(a, b2, c2, d) in cases {\n            let cv = cf(a, b2, c2, d);\n            let rv = rf(a, b2, c2, d);\n            assert_eq!(\n                cv, rv,\n                \"maxnmin mismatch ({}, {}, {}, {}): C={}, R={}\",\n                a, b2, c2, d, cv, rv\n            );\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":213,"cache_read_input_tokens":23857,"cache_creation":{"ephemeral_5m_input_tokens":213,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"bb3c1015-8e94-4d68-90fa-f2dbaff733be","uuid":"404dd291-ca6d-4c71-835a-cec0625a4c61"}
