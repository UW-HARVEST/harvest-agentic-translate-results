 }; 10],\n        count: 0,\n    }\n}\n\nunsafe fn load_libs() -> (Library, Library) {\n    let c_path = c_lib_path();\n    let r_path = rust_lib_path();\n    eprintln!(\"Loading C lib at {:?}\", c_path);\n    eprintln!(\"Loading Rust lib at {:?}\", r_path);\n    let clib = Library::new(&c_path).expect(\"failed to load C lib\");\n    let rlib = Library::new(&r_path).expect(\"failed to load Rust lib\");\n    (clib, rlib)\n}\n\n#[test]\nfn add_operation_matches() {\n    type Fn_ = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n    unsafe {\n        let (clib, rlib) = load_libs();\n        let cf: Symbol<Fn_> = clib.get(b\"add_operation\").unwrap();\n        let rf: Symbol<Fn_> = rlib.get(b\"add_operation\").unwrap();\n        let cases: &[(c_int, c_int, c_int, c_int)] = &[\n            (0, 0, 0, 0),\n            (1, 2, 3, 4),\n            (-1, -2, 100, 200),\n            (i32::MAX, 1, 0, 0),\n            (i32::MIN, -1, 0, 0),\n            (12345, -54321, 7, 8),\n        ];\n        for &(a, b, c, d) in cases {\n            assert_eq!(cf(a, b, c, d), rf(a, b, c, d), \"add_operation({},{},{},{})\", a, b, c, d);\n        }\n    }\n}\n\n#[test]\nfn multiply_operation_matches() {\n    type Fn_ = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n    unsafe {\n        let (clib, rlib) = load_libs();\n        let cf: Symbol<Fn_> = clib.get(b\"multiply_operation\").unwrap();\n        let rf: Symbol<Fn_> = rlib.get(b\"multiply_operation\").unwrap();\n        let cases: &[(c_int, c_int, c_int, c_int)] = &[\n            (0, 0, 0, 0),\n            (3, 4, 0, 0),\n            (-3, 4, 0, 0),\n            (i32::MAX, 2, 0, 0),\n            (i32::MIN, 2, 0, 0),\n            (123, 456, 0, 0),\n        ];\n        for &(a, b, c, d) in cases {\n            assert_eq!(cf(a, b, c, d), rf(a, b, c, d));\n        }\n    }\n}\n\n#[test]\nfn subtract_operation_matches() {\n    type Fn_ = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n    unsafe {\n       