ut a_r, vr.as_mut_ptr(), v.len() as c_int);\n                let cv = cf(&mut a_c, c_op_ptr);\n                let rv = rf(&mut a_r, r_op_ptr);\n                assert_eq!(cv, rv, \"process_with_foreach total mismatch\");\n                assert_eq!(a_c.count, a_r.count);\n                for i in 0..a_c.count as usize {\n                    assert_eq!(a_c.data[i].value, a_r.data[i].value);\n                    assert_eq!(\n                        a_c.data[i].scaled.to_bits(),\n                        a_r.data[i].scaled.to_bits()\n                    );\n                    assert_eq!(a_c.data[i].rank, a_r.data[i].rank);\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn arrayfunc_matches() {\n    type Fn_ = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n    unsafe {\n        let (clib, rlib) = load_libs();\n        let cf: Symbol<Fn_> = clib.get(b\"arrayfunc\").unwrap();\n        let rf: Symbol<Fn_> = rlib.get(b\"arrayfunc\").unwrap();\n\n        let cases: &[(c_int, c_int, c_int, c_int)] = &[\n            (0, 0, 0, 0),\n            (1, 2, 3, 4),\n            (-1, -2, -3, -4),\n            (10, 20, 30, 40),\n            (100, -50, 25, 12),\n            (i32::MAX, 1, 1, 2),\n            (i32::MIN + 2, 1, 1, 2),\n            (5, 0, 5, 10),\n            (7, 3, 0, 5),\n            (1000, 2000, 3000, 4000),\n            (123, 456, 789, 1011),\n            (-1000, -2000, -3000, -4000),\n        ];\n        for &(a, b, c, d) in cases {\n            let cv = cf(a, b, c, d);\n            let rv = rf(a, b, c, d);\n            assert_eq!(cv, rv, \"arrayfunc({},{},{},{})\", a, b, c, d);\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
