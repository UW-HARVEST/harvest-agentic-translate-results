0\t    char c = peek_char();\n221\t    \n222\t    buffer[length++] = advance_char();\n223\t    \n224\t    // Check for two-character operators\n225\t    char next = peek_char();\n226\t    if ((c == '=' && next == '=') ||\n227\t        (c == '!' && next == '=') ||\n228\t        (c == '<' && next == '=') ||\n229\t        (c == '>' && next == '=') ||\n230\t        (c == '&' && next == '&') ||\n231\t        (c == '|' && next == '|') ||\n232\t        (c == '+' && next == '+') ||\n233\t        (c == '-' && next == '-') ||\n234\t        (c == '-' && next == '>') ||\n235\t        (c == '<' && next == '<') ||\n236\t        (c == '>' && next == '>')) {\n237\t        buffer[length++] = advance_char();\n238\t    }\n239\t    \n240\t    buffer[length] = '\\0';\n241\t    return create_token(TOKEN_OPERATOR, buffer, length);\n242\t}\n243\t\n244\t// Public functions that use static globals\n245\ttoken_t tokenizer_next_token(void) {\n246\t    // Check if we have a lookahead token\n247\t    if (lookahead_valid) {\n248\t        lookahead_valid = 0;\n249\t        return lookahead_token;\n250\t    }\n251\t    \n252\t    skip_whitespace();\n253\t    \n254\t    if (current_position >= buffer_length) {\n255\t        return create_token(TOKEN_EOF, \"\", 0);\n256\t    }\n257\t    \n258\t    char c = peek_char();\n259\t    \n260\t    // Newline\n261\t    if (c == '\\n') {\n262\t        char newline[2] = {advance_char(), '\\0'};\n263\t        return create_token(TOKEN_NEWLINE, newline, 1);\n264\t    }\n265\t    \n266\t    // Identifier or keyword\n267\t    if (isalpha(c) || c == '_') {\n268\t        return scan_word();\n269\t    }\n270\t    \n271\t    // Number\n272\t    if (isdigit(c)) {\n273\t        return scan_number();\n274\t    }\n275\t    \n276\t    // String\n277\t    if (c == '\"' || c == '\\'') {\n278\t        return scan_string();\n279\t    }\n280\t    \n281\t    // Comment\n282\t    if (c == '/' && (peek_char() == '/' || peek_char() == '*')) {\n283\t        return scan_comment();\n28