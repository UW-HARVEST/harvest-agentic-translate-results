{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TXfseaDUgR4z6BDWaCrtQi","type":"tool_result","content":"1\t// Copyright 2025 MIT Lincoln Laboratory\n2\t// Permission is hereby granted, free of charge,\n3\t// to any person obtaining a copy of this software\n4\t// and associated documentation files (the “Software”),\n5\t// to deal in the Software without restriction,\n6\t// including without limitation the rights to use, copy,\n7\t// modify, merge, publish, distribute, sublicense,\n8\t// and/or sell copies of the Software,\n9\t// and to permit persons to whom the Software is furnished to do so,\n10\t// subject to the following conditions:\n11\t// \n12\t// The above copyright notice and this permission notice\n13\t// shall be included in all copies or substantial portions of the Software.\n14\t// \n15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n17\t// THE WARRANTIES OF MERCHANTABILITY,\n18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n23\t\n24\t#include <stdio.h>\n25\t#include <stdlib.h>\n26\t#include <string.h>\n27\t#include <stdint.h>\n28\t#include <stdbool.h>\n29\t\n30\t// ==================== Data Structures ====================\n31\t\n32\ttypedef struct {\n33\t    uint8_t data[256];\n34\t    size_t length;\n35\t    uint32_t checksum;\n36\t} buffer_t;\n37\t\n38\ttypedef struct {\n39\t    buffer_t *buffers;\n40\t    int count;\n41\t    int capacity;\n42\t} buffer_array_t;\n43\t\n44\ttypedef enum {\n45\t    OP_COPY = 0,\n46\t    OP_REVERSE = 1,\n47\t    OP_MERGE = 2,\n48\t    OP_SPLIT = 3,\n49\t    OP_INTERLEAVE = 4,\n50\t    OP_ROTATE = 5,\n51\t    OP_CHECKSUM = 6\n52\t} operation_t;\n53\t\n54\t// ==================== Helper Functions ====================\n55\t\n56\t// Calculate simple checksum\n57\tuint32_t calculate_checksum(const uint8_t *data, size_t length) {\n58\t    uint32_t sum = 0;\n59\t    for (size_t i = 0; i < length; i++) {\n60\t        sum = (sum << 3) ^ data[i];\n61\t    }\n62\t    return sum;\n63\t}\n64\t\n65\t// Validate buffer integrity\n66\tbool validate_buffer(const buffer_t *buf) {\n67\t    if (buf == NULL) {\n68\t        fprintf(stderr, \"Error: NULL buffer\\n\");\n69\t        return false;\n70\t    }\n71\t    if (buf->length > 256) {\n72\t        fprintf(stderr, \"Error: Buffer length %zu exceeds maximum 256\\n\", buf->length);\n73\t        return false;\n74\t    }\n75\t    uint32_t expected = calculate_checksum(buf->data, buf->length);\n76\t    if (buf->checksum != expected) {\n77\t        fprintf(stderr, \"Warning: Checksum mismatch. Expected %u, got %u\\n\", \n78\t                expected, buf->checksum);\n79\t    }\n80\t    return true;\n81\t}\n82\t\n83\t// Initialize buffer array\n84\tbuffer_array_t* init_buffer_array(int initial_capacity) {\n85\t    if (initial_capacity <= 0) {\n86\t        fprintf(stderr, \"Error: Invalid capacity %d\\n\", initial_capacity);\n87\t        return NULL;\n88\t    }\n89\t    \n90\t    buffer_array_t *arr = malloc(sizeof(buffer_array_t));\n91\t    if (!arr) {\n92\t        fprintf(stderr, \"Error: Failed to allocate buffer array\\n\");\n93\t        return NULL;\n94\t    }\n95\t    \n96\t    arr->buffers = malloc(sizeof(buffer_t) * initial_capacity);\n97\t    if (!arr->buffers) {\n98\t        fprintf(stderr, \"Error: Failed to allocate buffer storage\\n\");\n99\t        free(arr);\n100\t        return NULL;\n101\t    }\n102\t    \n103\t    arr->count = 0;\n104\t    arr->capacity = initial_capacity;\n105\t    return arr;\n106\t}\n107\t\n108\t// Free buffer array\n109\tvoid free_buffer_array(buffer_array_t *arr) {\n110\t    if (arr) {\n111\t        free(arr->buffers);\n112\t        free(arr);\n113\t    }\n114\t}\n115\t\n116\t// ==================== Core Buffer Operations ====================\n117\t\n118\t// Simple copy operation with memcpy\n119\tint buffer_copy(const buffer_t *src, buffer_t *dst) {\n120\t    if (!src || !dst) {\n121\t        fprintf(stderr, \"Error: NULL pointer in buffer_copy\\n\");\n122\t        return -1;\n123\t    }\n124\t    \n125\t    if (!validate_buffer(src)) {\n126\t        return -1;\n127\t    }\n128\t    \n129\t    // Use memcpy for data transfer\n130\t    memcpy(dst->data, src->data, src->length);\n131\t    dst->length = src->length;\n132\t    dst->checksum = calculate_checksum(dst->data, dst->length);\n133\t    \n134\t    return 0;\n135\t}\n136\t\n137\t// Reverse buffer contents\n138\tint buffer_reverse(buffer_t *buf) {\n139\t    if (!buf) {\n140\t        fprintf(stderr, \"Error: NULL buffer in reverse\\n\");\n141\t        return -1;\n142\t    }\n143\t    \n144\t    if (buf->length == 0) {\n145\t        return 0;  // Nothing to reverse\n146\t    }\n147\t    \n148\t    uint8_t temp[256];\n149\t    memcpy(temp, buf->data, buf->length);\n150\t    \n151\t    for (size_t i = 0; i < buf->length; i++) {\n152\t        buf->data[i] = temp[buf->length - 1 - i];\n153\t    }\n154\t    \n155\t    buf->checksum = calculate_checksum(buf->data, buf->length);\n156\t    return 0;\n157\t}\n158\t\n159\t// Merge two buffers into destination\n160\tint buffer_merge(const buffer_t *src1, const buffer_t *src2, buffer_t *dst) {\n161\t    if (!src1 || !src2 || !dst) {\n162\t        fprintf(stderr, \"Error: NULL pointer in buffer_merge\\n\");\n163\t        return -1;\n164\t    }\n165\t    \n166\t    if (src1->length + src2->length > 256) {\n167\t        fprintf(stderr, \"Error: Merged length %zu exceeds maximum\\n\", \n168\t                src1->length + src2->length);\n169\t        return -1;\n170\t    }\n171\t    \n172\t    // Copy first buffer\n173\t    memcpy(dst->data, src1->data, src1->length);\n174\t    // Copy second buffer after first\n175\t    memcpy(dst->data + src1->length, src2->data, src2->length);\n176\t    \n177\t    dst->length = src1->length + src2->length;\n178\t    dst->checksum = calculate_checksum(dst->data, dst->length);\n179\t    \n180\t    return 0;\n181\t}\n182\t\n183\t// Split buffer at position into two buffers\n184\tint buffer_split(const buffer_t *src, size_t split_pos, \n185\t                 buffer_t *dst1, buffer_t *dst2) {\n186\t    if (!src || !dst1 || !dst2) {\n187\t        fprintf(stderr, \"Error: NULL pointer in buffer_split\\n\");\n188\t        return -1;\n189\t    }\n190\t    \n191\t    if (split_pos > src->length) {\n192\t        fprintf(stderr, \"Error: Split position %zu exceeds length %zu\\n\", \n193\t                split_pos, src->length);\n194\t        return -1;\n195\t    }\n196\t    \n197\t    // Copy first part\n198\t    if (split_pos > 0) {\n199\t        memcpy(dst1->data, src->data, split_pos);\n200\t    }\n201\t    dst1->length = split_pos;\n202\t    dst1->checksum = calculate_checksum(dst1->data, dst1->length);\n203\t    \n204\t    // Copy second part\n205\t    size_t remaining = src->length - split_pos;\n206\t    if (remaining > 0) {\n207\t        memcpy(dst2->data, src->data + split_pos, remaining);\n208\t    }\n209\t    dst2->length = remaining;\n210\t    dst2->checksum = calculate_checksum(dst2->data, dst2->length);\n211\t    \n212\t    return 0;\n213\t}\n214\t\n215\t// Interleave two buffers (alternating bytes)\n216\tint buffer_interleave(const buffer_t *src1, const buffer_t *src2, buffer_t *dst) {\n217\t    if (!src1 || !src2 || !dst) {\n218\t        fprintf(stderr, \"Error: NULL pointer in buffer_interleave\\n\");\n219\t        return -1;\n220\t    }\n221\t    \n222\t    size_t max_len = src1->length > src2->length ? src1->length : src2->length;\n223\t    if (src1->length + src2->length > 256) {\n224\t        fprintf(stderr, \"Error: Interleaved length exceeds maximum\\n\");\n225\t        return -1;\n226\t    }\n227\t    \n228\t    size_t dst_pos = 0;\n229\t    for (size_t i = 0; i < max_len; i++) {\n230\t        if (i < src1->length) {\n231\t            memcpy(&dst->data[dst_pos++], &src1->data[i], 1);\n232\t        }\n233\t        if (i < src2->length) {\n234\t            memcpy(&dst->data[dst_pos++], &src2->data[i], 1);\n235\t        }\n236\t    }\n237\t    \n238\t    dst->length = dst_pos;\n239\t    dst->checksum = calculate_checksum(dst->data, dst->length);\n240\t    \n241\t    return 0;\n242\t}\n243\t\n244\t// Rotate buffer left by n positions\n245\tint buffer_rotate(buffer_t *buf, int positions) {\n246\t    if (!buf) {\n247\t        fprintf(stderr, \"Error: NULL buffer in rotate\\n\");\n248\t        return -1;\n249\t    }\n250\t    \n251\t    if (buf->length == 0 || positions == 0) {\n252\t        return 0;  // Nothing to rotate\n253\t    }\n254\t    \n255\t    // Normalize positions to valid range\n256\t    positions = positions % (int)buf->length;\n257\t    if (positions < 0) {\n258\t        positions += buf->length;\n259\t    }\n260\t    \n261\t    uint8_t temp[256];\n262\t    memcpy(temp, buf->data, buf->length);\n263\t    \n264\t    // Copy rotated portions\n265\t    memcpy(buf->data, temp + positions, buf->length - positions);\n266\t    memcpy(buf->data + (buf->length - positions), temp, positions);\n267\t    \n268\t    buf->checksum = calculate_checksum(buf->data, buf->length);\n269\t    \n270\t    return 0;\n271\t}\n272\t\n273\t// Conditional copy based on pattern matching\n274\tint buffer_conditional_copy(const buffer_t *src, buffer_t *dst, \n275\t                            uint8_t pattern, bool copy_matching) {\n276\t    if (!src || !dst) {\n277\t        fprintf(stderr, \"Error: NULL pointer in conditional_copy\\n\");\n278\t        return -1;\n279\t    }\n280\t    \n281\t    size_t dst_pos = 0;\n282\t    for (size_t i = 0; i < src->length; i++) {\n283\t        bool matches = (src->data[i] == pattern);\n284\t        if (matches == copy_matching) {\n285\t            memcpy(&dst->data[dst_pos++], &src->data[i], 1);\n286\t        }\n287\t    }\n288\t    \n289\t    dst->length = dst_pos;\n290\t    dst->checksum = calculate_checksum(dst->data, dst->length);\n291\t    \n292\t    return 0;\n293\t}\n294\t\n295\t// Copy with stride (every nth byte)\n296\tint buffer_copy_strided(const buffer_t *src, buffer_t *dst, int stride) {\n297\t    if (!src || !dst) {\n298\t        fprintf(stderr, \"Error: NULL pointer in copy_strided\\n\");\n299\t        return -1;\n300\t    }\n301\t    \n302\t    if (stride <= 0) {\n303\t        fprintf(stderr, \"Error: Invalid stride %d\\n\", stride);\n304\t        return -1;\n305\t    }\n306\t    \n307\t    size_t dst_pos = 0;\n308\t    for (size_t i = 0; i < src->length; i += stride) {\n309\t        memcpy(&dst->data[dst_pos++], &src->data[i], 1);\n310\t    }\n311\t    \n312\t    dst->length = dst_pos;\n313\t    dst->checksum = calculate_checksum(dst->data, dst->length);\n314\t    \n315\t    return 0;\n316\t}\n317\t\n318\t// ==================== Complex Processing Functions ====================\n319\t\n320\t// Process buffer array with operation\n321\tint process_buffer_array(buffer_array_t *arr, operation_t op, int param) {\n322\t    if (!arr || arr->count == 0) {\n323\t        fprintf(stderr, \"Error: Invalid buffer array\\n\");\n324\t        return -1;\n325\t    }\n326\t    \n327\t    switch (op) {\n328\t        case OP_COPY:\n329\t            // Copy first buffer to all others\n330\t            for (int i = 1; i < arr->count; i++) {\n331\t                if (buffer_copy(&arr->buffers[0], &arr->buffers[i]) != 0) {\n332\t                    return -1;\n333\t                }\n334\t            }\n335\t            break;\n336\t            \n337\t        case OP_REVERSE:\n338\t            // Reverse all buffers\n339\t            for (int i = 0; i < arr->count; i++) {\n340\t                if (buffer_reverse(&arr->buffers[i]) != 0) {\n341\t                    return -1;\n342\t                }\n343\t            }\n344\t            break;\n345\t            \n346\t        case OP_MERGE:\n347\t            // Merge consecutive pairs\n348\t            if (arr->count < 2) {\n349\t                fprintf(stderr, \"Error: Need at least 2 buffers for merge\\n\");\n350\t                return -1;\n351\t            }\n352\t            for (int i = 0; i < arr->count - 1; i += 2) {\n353\t                buffer_t merged;\n354\t                if (buffer_merge(&arr->buffers[i], &arr->buffers[i+1], &merged) != 0) {\n355\t                    return -1;\n356\t                }\n357\t                memcpy(&arr->buffers[i], &merged, sizeof(buffer_t));\n358\t            }\n359\t            break;\n360\t            \n361\t        case OP_ROTATE:\n362\t            // Rotate all buffers by param positions\n363\t            for (int i = 0; i < arr->count; i++) {\n364\t                if (buffer_rotate(&arr->buffers[i], param) != 0) {\n365\t                    return -1;\n366\t                }\n367\t            }\n368\t            break;\n369\t            \n370\t        case OP_CHECKSUM:\n371\t            // Verify all checksums\n372\t            for (int i = 0; i < arr->count; i++) {\n373\t                if (!validate_buffer(&arr->buffers[i])) {\n374\t                    return -1;\n375\t                }\n376\t            }\n377\t            break;\n378\t            \n379\t        default:\n380\t            fprintf(stderr, \"Error: Unknown operation %d\\n\", op);\n381\t            return -1;\n382\t    }\n383\t    \n384\t    return 0;\n385\t}\n386\t\n387\t// ==================== Input/Output Functions ====================\n388\t\n389\t// Read buffer from stdin\n390\tint read_buffer(buffer_t *buf) {\n391\t    if (!buf) {\n392\t        fprintf(stderr, \"Error: NULL buffer in read_buffer\\n\");\n393\t        return -1;\n394\t    }\n395\t    \n396\t    int length;\n397\t    if (scanf(\"%d\", &length) != 1) {\n398\t        fprintf(stderr, \"Error: Failed to read buffer length\\n\");\n399\t        return -1;\n400\t    }\n401\t    \n402\t    if (length < 0 || length > 256) {\n403\t        fprintf(stderr, \"Error: Invalid buffer length %d\\n\", length);\n404\t        return -1;\n405\t    }\n406\t    \n407\t    buf->length = length;\n408\t    for (size_t i = 0; i < buf->length; i++) {\n409\t        int byte;\n410\t        if (scanf(\"%d\", &byte) != 1) {\n411\t            fprintf(stderr, \"Error: Failed to read byte %zu\\n\", i);\n412\t            return -1;\n413\t        }\n414\t        buf->data[i] = (uint8_t)byte;\n415\t    }\n416\t    \n417\t    buf->checksum = calculate_checksum(buf->data, buf->length);\n418\t    return 0;\n419\t}\n420\t\n421\t// Write buffer to stdout\n422\tvoid write_buffer(const buffer_t *buf) {\n423\t    if (!buf) {\n424\t        fprintf(stderr, \"Error: NULL buffer in write_buffer\\n\");\n425\t        return;\n426\t    }\n427\t    \n428\t    printf(\"%zu\", buf->length);\n429\t    for (size_t i = 0; i < buf->length; i++) {\n430\t        printf(\" %u\", buf->data[i]);\n431\t    }\n432\t    printf(\"\\n\");\n433\t}\n434\t\n435\t// ==================== Main Function ====================\n436\t\n437\tint main(int argc, char *argv[]) {\n438\t    int operation;\n439\t    int buffer_count;\n440\t    \n441\t    // Read operation type\n442\t    if (scanf(\"%d\", &operation) != 1) {\n443\t        fprintf(stderr, \"Error: Failed to read operation\\n\");\n444\t        return 1;\n445\t    }\n446\t    \n447\t    // Read buffer count\n448\t    if (scanf(\"%d\", &buffer_count) != 1) {\n449\t        fprintf(stderr, \"Error: Failed to read buffer count\\n\");\n450\t        return 1;\n451\t    }\n452\t    \n453\t    if (buffer_count <= 0 || buffer_count > 100) {\n454\t        fprintf(stderr, \"Error: Invalid buffer count %d\\n\", buffer_count);\n455\t        return 1;\n456\t    }\n457\t    \n458\t    // Allocate buffer array\n459\t    buffer_array_t *buffers = init_buffer_array(buffer_count);\n460\t    if (!buffers) {\n461\t        return 1;\n462\t    }\n463\t    \n464\t    // Read all buffers\n465\t    for (int i = 0; i < buffer_count; i++) {\n466\t        if (read_buffer(&buffers->buffers[i]) != 0) {\n467\t            free_buffer_array(buffers);\n468\t            return 1;\n469\t        }\n470\t        buffers->count++;\n471\t    }\n472\t    \n473\t    // Execute operation based on type\n474\t    int result = 0;\n475\t    switch (operation) {\n476\t        case OP_COPY:\n477\t            if (buffer_count >= 2) {\n478\t                buffer_t temp;\n479\t                result = buffer_copy(&buffers->buffers[0], &temp);\n480\t                if (result == 0) {\n481\t                    write_buffer(&temp);\n482\t                }\n483\t            } else {\n484\t                fprintf(stderr, \"Error: Copy needs at least 2 buffers\\n\");\n485\t                result = -1;\n486\t            }\n487\t            break;\n488\t            \n489\t        case OP_REVERSE:\n490\t            for (int i = 0; i < buffer_count; i++) {\n491\t                result = buffer_reverse(&buffers->buffers[i]);\n492\t                if (result != 0) break;\n493\t                write_buffer(&buffers->buffers[i]);\n494\t            }\n495\t            break;\n496\t            \n497\t        case OP_MERGE:\n498\t            if (buffer_count >= 2) {\n499\t                buffer_t merged;\n500\t                result = buffer_merge(&buffers->buffers[0], &buffers->buffers[1], &merged);\n501\t                if (result == 0) {\n502\t                    write_buffer(&merged);\n503\t                }\n504\t            } else {\n505\t                fprintf(stderr, \"Error: Merge needs at least 2 buffers\\n\");\n506\t                result = -1;\n507\t            }\n508\t            break;\n509\t            \n510\t        case OP_SPLIT: {\n511\t            if (buffer_count >= 1) {\n512\t                int split_pos;\n513\t                if (scanf(\"%d\", &split_pos) != 1) {\n514\t                    fprintf(stderr, \"Error: Failed to read split position\\n\");\n515\t                    result = -1;\n516\t                } else {\n517\t                    buffer_t part1, part2;\n518\t                    result = buffer_split(&buffers->buffers[0], split_pos, &part1, &part2);\n519\t                    if (result == 0) {\n520\t                        write_buffer(&part1);\n521\t                        write_buffer(&part2);\n522\t                    }\n523\t                }\n524\t            }\n525\t            break;\n526\t        }\n527\t            \n528\t        case OP_INTERLEAVE:\n529\t            if (buffer_count >= 2) {\n530\t                buffer_t interleaved;\n531\t                result = buffer_interleave(&buffers->buffers[0], &buffers->buffers[1], &interleaved);\n532\t                if (result == 0) {\n533\t                    write_buffer(&interleaved);\n534\t                }\n535\t            } else {\n536\t                fprintf(stderr, \"Error: Interleave needs at least 2 buffers\\n\");\n537\t                result = -1;\n538\t            }\n539\t            break;\n540\t            \n541\t        case OP_ROTATE: {\n542\t            int positions;\n543\t            if (scanf(\"%d\", &positions) != 1) {\n544\t                fprintf(stderr, \"Error: Failed to read rotation amount\\n\");\n545\t                result = -1;\n546\t            } else {\n547\t                for (int i = 0; i < buffer_count; i++) {\n548\t                    result = buffer_rotate(&buffers->buffers[i], positions);\n549\t                    if (result != 0) break;\n550\t                    write_buffer(&buffers->buffers[i]);\n551\t                }\n552\t            }\n553\t            break;\n554\t        }\n555\t            \n556\t        case OP_CHECKSUM:\n557\t            for (int i = 0; i < buffer_count; i++) {\n558\t                printf(\"%u\\n\", buffers->buffers[i].checksum);\n559\t            }\n560\t            break;\n561\t            \n562\t        default:\n563\t            fprintf(stderr, \"Error: Unknown operation %d\\n\", operation);\n564\t            result = -1;\n565\t            break;\n566\t    }\n567\t    \n568\t    free_buffer_array(buffers);\n569\t    return result != 0 ? 1 : 0;\n570\t}\n571\t"}]},"parent_tool_use_id":null,"session_id":"64a37aaa-b753-461e-b7a2-2fb321e1c7ed","uuid":"a3e828ef-cdb5-4a80-9a17-83e9421f7026","timestamp":"2026-05-30T01:32:16.252Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-translate-EEapww/translated_rust/c_src/src/main.c","content":"// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the “Software”),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n// \n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n// \n// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <stdbool.h>\n\n// ==================== Data Structures ====================\n\ntypedef struct {\n    uint8_t data[256];\n    size_t length;\n    uint32_t checksum;\n} buffer_t;\n\ntypedef struct {\n    buffer_t *buffers;\n    int count;\n    int capacity;\n} buffer_array_t;\n\ntypedef enum {\n    OP_COPY = 0,\n    OP_REVERSE = 1,\n    OP_MERGE = 2,\n    OP_SPLIT = 3,\n    OP_INTERLEAVE = 4,\n    OP_ROTATE = 5,\n    OP_CHECKSUM = 6\n} operation_t;\n\n// ==================== Helper Functions ====================\n\n// Calculate simple checksum\nuint32_t calculate_checksum(const uint8_t *data, size_t length) {\n    uint32_t sum = 0;\n    for (size_t i = 0; i < length; i++) {\n        sum = (sum << 3) ^ data[i];\n    }\n    return sum;\n}\n\n// Validate buffer integrity\nbool validate_buffer(const buffer_t *buf) {\n    if (buf == NULL) {\n        fprintf(stderr, \"Error: NULL buffer\\n\");\n        return false;\n    }\n    if (buf->length > 256) {\n        fprintf(stderr, \"Error: Buffer length %zu exceeds maximum 256\\n\", buf->length);\n        return false;\n    }\n    uint32_t expected = calculate_checksum(buf->data, buf->length);\n    if (buf->checksum != expected) {\n        fprintf(stderr, \"Warning: Checksum mismatch. Expected %u, got %u\\n\", \n                expected, buf->checksum);\n    }\n    return true;\n}\n\n// Initialize buffer array\nbuffer_array_t* init_buffer_array(int initial_capacity) {\n    if (initial_capacity <= 0) {\n        fprintf(stderr, \"Error: Invalid capacity %d\\n\", initial_capacity);\n        return NULL;\n    }\n    \n    buffer_array_t *arr = malloc(sizeof(buffer_array_t));\n    if (!arr) {\n        fprintf(stderr, \"Error: Failed to allocate buffer array\\n\");\n        return NULL;\n    }\n    \n    arr->buffers = malloc(sizeof(buffer_t) * initial_capacity);\n    if (!arr->buffers) {\n        fprintf(stderr, \"Error: Failed to allocate buffer storage\\n\");\n        free(arr);\n        return NULL;\n    }\n    \n    arr->count = 0;\n    arr->capacity = initial_capacity;\n    return arr;\n}\n\n// Free buffer array\nvoid free_buffer_array(buffer_array_t *arr) {\n    if (arr) {\n        free(arr->buffers);\n        free(arr);\n    }\n}\n\n// ==================== Core Buffer Operations ====================\n\n// Simple copy operation with memcpy\nint buffer_copy(const buffer_t *src, buffer_t *dst) {\n    if (!src || !dst) {\n        fprintf(stderr, \"Error: NULL pointer in buffer_copy\\n\");\n        return -1;\n    }\n    \n    if (!validate_buffer(src)) {\n        return -1;\n    }\n    \n    // Use memcpy for data transfer\n    memcpy(dst->data, src->data, src->length);\n    dst->length = src->length;\n    dst->checksum = calculate_checksum(dst->data, dst->length);\n    \n    return 0;\n}\n\n// Reverse buffer contents\nint buffer_reverse(buffer_t *buf) {\n    if (!buf) {\n        fprintf(stderr, \"Error: NULL buffer in reverse\\n\");\n        return -1;\n    }\n    \n    if (buf->length == 0) {\n        return 0;  // Nothing to reverse\n    }\n    \n    uint8_t temp[256];\n    memcpy(temp, buf->data, buf->length);\n    \n    for (size_t i = 0; i < buf->length; i++) {\n        buf->data[i] = temp[buf->length - 1 - i];\n    }\n    \n    buf->checksum = calculate_checksum(buf->data, buf->length);\n    return 0;\n}\n\n// Merge two buffers into destination\nint buffer_merge(const buffer_t *src1, const buffer_t *src2, buffer_t *dst) {\n    if (!src1 || !src2 || !dst) {\n        fprintf(stderr, \"Error: NULL pointer in buffer_merge\\n\");\n        return -1;\n    }\n    \n    if (src1->length + src2->length > 256) {\n        fprintf(stderr, \"Error: Merged length %zu exceeds maximum\\n\", \n                src1->length + src2->length);\n        return -1;\n    }\n    \n    // Copy first buffer\n    memcpy(dst->data, src1->data, src1->length);\n    // Copy second buffer after first\n    memcpy(dst->data + src1->length, src2->data, src2->length);\n    \n    dst->length = src1->length + src2->length;\n    dst->checksum = calculate_checksum(dst->data, dst->length);\n    \n    return 0;\n}\n\n// Split buffer at position into two buffers\nint buffer_split(const buffer_t *src, size_t split_pos, \n                 buffer_t *dst1, buffer_t *dst2) {\n    if (!src || !dst1 || !dst2) {\n        fprintf(stderr, \"Error: NULL pointer in buffer_split\\n\");\n        return -1;\n    }\n    \n    if (split_pos > src->length) {\n        fprintf(stderr, \"Error: Split position %zu exceeds length %zu\\n\", \n                split_pos, src->length);\n        return -1;\n    }\n    \n    // Copy first part\n    if (split_pos > 0) {\n        memcpy(dst1->data, src->data, split_pos);\n    }\n    dst1->length = split_pos;\n    dst1->checksum = calculate_checksum(dst1->data, dst1->length);\n    \n    // Copy second part\n    size_t remaining = src->length - split_pos;\n    if (remaining > 0) {\n        memcpy(dst2->data, src->data + split_pos, remaining);\n    }\n    dst2->length = remaining;\n    dst2->checksum = calculate_checksum(dst2->data, dst2->length);\n    \n    return 0;\n}\n\n// Interleave two buffers (alternating bytes)\nint buffer_interleave(const buffer_t *src1, const buffer_t *src2, buffer_t *dst) {\n    if (!src1 || !src2 || !dst) {\n        fprintf(stderr, \"Error: NULL pointer in buffer_interleave\\n\");\n        return -1;\n    }\n    \n    size_t max_len = src1->length > src2->length ? src1->length : src2->length;\n    if (src1->length + src2->length > 256) {\n        fprintf(stderr, \"Error: Interleaved length exceeds maximum\\n\");\n        return -1;\n    }\n    \n    size_t dst_pos = 0;\n    for (size_t i = 0; i < max_len; i++) {\n        if (i < src1->length) {\n            memcpy(&dst->data[dst_pos++], &src1->data[i], 1);\n        }\n        if (i < src2->length) {\n            memcpy(&dst->data[dst_pos++], &src2->data[i], 1);\n        }\n    }\n    \n    dst->length = dst_pos;\n    dst->checksum = calculate_checksum(dst->data, dst->length);\n    \n    return 0;\n}\n\n// Rotate buffer left by n positions\nint buffer_rotate(buffer_t *buf, int positions) {\n    if (!buf) {\n        fprintf(stderr, \"Error: NULL buffer in rotate\\n\");\n        return -1;\n    }\n    \n    if (buf->length == 0 || positions == 0) {\n        return 0;  // Nothing to rotate\n    }\n    \n    // Normalize positions to valid range\n    positions = positions % (int)buf->length;\n    if (positions < 0) {\n        positions += buf->length;\n    }\n    \n    uint8_t temp[256];\n    memcpy(temp, buf->data, buf->length);\n    \n    // Copy rotated portions\n    memcpy(buf->data, temp + positions, buf->length - positions);\n    memcpy(buf->data + (buf->length - positions), temp, positions);\n    \n    buf->checksum = calculate_checksum(buf->data, buf->length);\n    \n    return 0;\n}\n\n// Conditional copy based on pattern matching\nint buffer_conditional_copy(const buffer_t *src, buffer_t *dst, \n                            uint8_t pattern, bool copy_matching) {\n    if (!src || !dst) {\n        fprintf(stderr, \"Error: NULL pointer in conditional_copy\\n\");\n        return -1;\n    }\n    \n    size_t dst_pos = 0;\n    for (size_t i = 0; i < src->length; i++) {\n        bool matches = (src->data[i] == pattern);\n        if (matches == copy_matching) {\n            memcpy(&dst->data[dst_pos++], &src->data[i], 1);\n        }\n    }\n    \n    dst->length = dst_pos;\n    dst->checksum = calculate_checksum(dst->data, dst->length);\n    \n    return 0;\n}\n\n// Copy with stride (every nth byte)\nint buffer_copy_strided(const buffer_t *src, buffer_t *dst, int stride) {\n    if (!src || !dst) {\n        fprintf(stderr, \"Error: NULL pointer in copy_strided\\n\");\n        return -1;\n    }\n    \n    if (stride <= 0) {\n        fprintf(stderr, \"Error: Invalid stride %d\\n\", stride);\n        return -1;\n    }\n    \n    size_t dst_pos = 0;\n    for (size_t i = 0; i < src->length; i += stride) {\n        memcpy(&dst->data[dst_pos++], &src->data[i], 1);\n    }\n    \n    dst->length = dst_pos;\n    dst->checksum = calculate_checksum(dst->data, dst->length);\n    \n    return 0;\n}\n\n// ==================== Complex Processing Functions ====================\n\n// Process buffer array with operation\nint process_buffer_array(buffer_array_t *arr, operation_t op, int param) {\n    if (!arr || arr->count == 0) {\n        fprintf(stderr, \"Error: Invalid buffer array\\n\");\n        return -1;\n    }\n    \n    switch (op) {\n        case OP_COPY:\n            // Copy first buffer to all others\n            for (int i = 1; i < arr->count; i++) {\n                if (buffer_copy(&arr->buffers[0], &arr->buffers[i]) != 0) {\n                    return -1;\n                }\n            }\n            break;\n            \n        case OP_REVERSE:\n            // Reverse all buffers\n            for (int i = 0; i < arr->count; i++) {\n                if (buffer_reverse(&arr->buffers[i]) != 0) {\n                    return -1;\n                }\n            }\n            break;\n            \n        case OP_MERGE:\n            // Merge consecutive pairs\n            if (arr->count < 2) {\n                fprintf(stderr, \"Error: Need at least 2 buffers for merge\\n\");\n                return -1;\n            }\n            for (int i = 0; i < arr->count - 1; i += 2) {\n                buffer_t merged;\n                if (buffer_merge(&arr->buffers[i], &arr->buffers[i+1], &merged) != 0) {\n                    return -1;\n                }\n                memcpy(&arr->buffers[i], &merged, sizeof(buffer_t));\n            }\n            break;\n            \n        case OP_ROTATE:\n            // Rotate all buffers by param positions\n            for (int i = 0; i < arr->count; i++) {\n                if (buffer_rotate(&arr->buffers[i], param) != 0) {\n                    return -1;\n                }\n            }\n            break;\n            \n        case OP_CHECKSUM:\n            // Verify all checksums\n            for (int i = 0; i < arr->count; i++) {\n                if (!validate_buffer(&arr->buffers[i])) {\n                    return -1;\n                }\n            }\n            break;\n            \n        default:\n            fprintf(stderr, \"Error: Unknown operation %d\\n\", op);\n            return -1;\n    }\n    \n    return 0;\n}\n\n// ==================== Input/Output Functions ====================\n\n// Read buffer from stdin\nint read_buffer(buffer_t *buf) {\n    if (!buf) {\n        fprintf(stderr, \"Error: NULL buffer in read_buffer\\n\");\n        return -1;\n    }\n    \n    int length;\n    if (scanf(\"%d\", &length) != 1) {\n        fprintf(stderr, \"Error: Failed to read buffer length\\n\");\n        return -1;\n    }\n    \n    if (length < 0 || length > 256) {\n        fprintf(stderr, \"Error: Invalid buffer length %d\\n\", length);\n        return -1;\n    }\n    \n    buf->length = length;\n    for (size_t i = 0; i < buf->length; i++) {\n        int byte;\n        if (scanf(\"%d\", &byte) != 1) {\n            fprintf(stderr, \"Error: Failed to read byte %zu\\n\", i);\n            return -1;\n        }\n        buf->data[i] = (uint8_t)byte;\n    }\n    \n    buf->checksum = calculate_checksum(buf->data, buf->length);\n    return 0;\n}\n\n// Write buffer to stdout\nvoid write_buffer(const buffer_t *buf) {\n    if (!buf) {\n        fprintf(stderr, \"Error: NULL buffer in write_buffer\\n\");\n        return;\n    }\n    \n    printf(\"%zu\", buf->length);\n    for (size_t i = 0; i < buf->length; i++) {\n        printf(\" %u\", buf->data[i]);\n    }\n    printf(\"\\n\");\n}\n\n// ==================== Main Function ====================\n\nint main(int argc, char *argv[]) {\n    int operation;\n    int buffer_count;\n    \n    // Read operation type\n    if (scanf(\"%d\", &operation) != 1) {\n        fprintf(stderr, \"Error: Failed to read operation\\n\");\n        return 1;\n    }\n    \n    // Read buffer count\n    if (scanf(\"%d\", &buffer_count) != 1) {\n        fprintf(stderr, \"Error: Failed to read buffer count\\n\");\n        return 1;\n    }\n    \n    if (buffer_count <= 0 || buffer_count > 100) {\n        fprintf(stderr, \"Error: Invalid buffer count %d\\n\", buffer_count);\n        return 1;\n    }\n    \n    // Allocate buffer array\n    buffer_array_t *buffers = init_buffer_array(buffer_count);\n    if (!buffers) {\n        return 1;\n    }\n    \n    // Read all buffers\n    for (int i = 0; i < buffer_count; i++) {\n        if (read_buffer(&buffers->buffers[i]) != 0) {\n            free_buffer_array(buffers);\n            return 1;\n        }\n        buffers->count++;\n    }\n    \n    // Execute operation based on type\n    int result = 0;\n    switch (operation) {\n        case OP_COPY:\n            if (buffer_count >= 2) {\n                buffer_t temp;\n                result = buffer_copy(&buffers->buffers[0], &temp);\n                if (result == 0) {\n                    write_buffer(&temp);\n                }\n            } else {\n                fprintf(stderr, \"Error: Copy needs at least 2 buffers\\n\");\n                result = -1;\n            }\n            break;\n            \n        case OP_REVERSE:\n            for (int i = 0; i < buffer_count; i++) {\n                result = buffer_reverse(&buffers->buffers[i]);\n                if (result != 0) break;\n                write_buffer(&buffers->buffers[i]);\n            }\n            break;\n            \n        case OP_MERGE:\n            if (buffer_count >= 2) {\n                buffer_t merged;\n                result = buffer_merge(&buffers->buffers[0], &buffers->buffers[1], &merged);\n                if (result == 0) {\n                    write_buffer(&merged);\n                }\n            } else {\n                fprintf(stderr, \"Error: Merge needs at least 2 buffers\\n\");\n                result = -1;\n            }\n            break;\n            \n        case OP_SPLIT: {\n            if (buffer_count >= 1) {\n                int split_pos;\n                if (scanf(\"%d\", &split_pos) != 1) {\n                    fprintf(stderr, \"Error: Failed to read split position\\n\");\n                    result = -1;\n                } else {\n                    buffer_t part1, part2;\n                    result = buffer_split(&buffers->buffers[0], split_pos, &part1, &part2);\n                    if (result == 0) {\n                        write_buffer(&part1);\n                        write_buffer(&part2);\n                    }\n                }\n            }\n            break;\n        }\n            \n        case OP_INTERLEAVE:\n            if (buffer_count >= 2) {\n                buffer_t interleaved;\n                result = buffer_interleave(&buffers->buffers[0], &buffers->buffers[1], &interleaved);\n                if (result == 0) {\n                    write_buffer(&interleaved);\n                }\n            } else {\n                fprintf(stderr, \"Error: Interleave needs at least 2 buffers\\n\");\n                result = -1;\n            }\n            break;\n            \n        case OP_ROTATE: {\n            int positions;\n            if (scanf(\"%d\", &positions) != 1) {\n                fprintf(stderr, \"Error: Failed to read rotation amount\\n\");\n                result = -1;\n            } else {\n                for (int i = 0; i < buffer_count; i++) {\n                    result = buffer_rotate(&buffers->buffers[i], positions);\n                    if (result != 0) break;\n                    write_buffer(&buffers->buffers[i]);\n                }\n            }\n            break;\n        }\n            \n        case OP_CHECKSUM:\n            for (int i = 0; i < buffer_count; i++) {\n                printf(\"%u\\n\", buffers->buffers[i].checksum);\n            }\n            break;\n            \n        default:\n            fprintf(stderr, \"Error: Unknown operation %d\\n\", operation);\n            result = -1;\n            break;\n    }\n    \n    free_buffer_array(buffers);\n    return result != 0 ? 1 : 0;\n}\n","numLines":571,"startLine":1,"totalLines":571}}}
