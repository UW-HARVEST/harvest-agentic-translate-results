ff for debugging.","             let c_str = String::from_utf8_lossy(&c_out);","             let r_str = String::from_utf8_lossy(&r_out);","             for (i, (cl, rl)) in c_str.lines().zip(r_str.lines()).enumerate() {","                 if cl != rl {","-                    eprintln!(\"line {} differs:\\nC: {:?}\\nR: {:?}\", i, cl, rl);","+                    eprintln!(\"line {} differs:\\n  C: {:?}\\n  R: {:?}\", i, cl, rl);","                 }","             }","-            if c_str.lines().count() != r_str.lines().count() {","-                eprintln!(","-                    \"line count C={} R={}\",","-                    c_str.lines().count(),","-                    r_str.lines().count()","-                );","+            let c_n = c_str.lines().count();","+            let r_n = r_str.lines().count();","+            if c_n != r_n {","+                eprintln!(\"line count differs: C={} R={}\", c_n, r_n);","             }","-            panic!(\"output mismatch for params {:?}\", p);","+            panic!(\"stdout output mismatch for params {:?}\", p);","         }","     }"," }","+","+#[test]","+fn ffi_all_functions_match() {","+    let libs = Libs::load();","+    check_convert_double_to_int(&libs);","+    check_process_negation(&libs);","+    check_create_numeric_buffer(&libs);","+    check_find_value_in_buffer(&libs);","+    check_calculate_with_doubles(&libs);","+    // Run the stdout-capturing test last; it modifies fd 1.","+    check_doubleneg(&libs);","+}"]}],"originalFile":"use libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_double, c_int, c_void};\nuse std::fs::File;\nuse std::io::Read;\nuse std::os::unix::io::AsRawFd;\nuse std::path::PathBuf;\nuse std::sync::Mutex;\n\nextern \"C\" {\n    fn dup(oldfd: i32) -> i32;\n    fn dup2(oldfd: i32, newfd: i32) -> i32;\n    fn close(fd: i32) -> i32;\n    fn fflush(stream: *mut c_void) -> i32;\n}\n\n// stdout in glibc is referenced via the `stdout` symbol.\nextern \"C\" {\n    static stdout: *mut c_void;\n}\n\n// Serialize all stdout-redirecting tests so they don't clobber each other.\nstatic STDOUT_LOCK: Mutex<()> = Mutex::new(());\n\nfn c_lib_path() -> PathBuf {\n    let manifest_dir = env!(\"CARGO_MANIFEST_DIR\");\n    PathBuf::from(manifest_dir).join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    let manifest_dir = env!(\"CARGO_MANIFEST_DIR\");\n    PathBuf::from(manifest_dir).join(\"target/release/libdoubleneg.so\")\n}\n\n/// Run `f`, redirecting stdout (fd 1) into a temp file, and return the\n/// captured bytes plus whatever `f` returned.\nfn capture_stdout<R, F: FnOnce() -> R>(f: F) -> (Vec<u8>, R) {\n    let _guard = STDOUT_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n\n    // Flush any pending stdout output so it doesn't end up in our capture file.\n    unsafe {\n        let _ = std::io::Write::flush(&mut std::io::stdout());\n        fflush(stdout);\n    }\n\n    let tmp_path = std::env::temp_dir().join(format!(\n        \"ffi_capture_{}_{}.txt\",\n        std::process::id(),\n        rand_suffix()\n    ));\n    let tmp = File::create(&tmp_path).expect(\"create temp file\");\n    let tmp_fd = tmp.as_raw_fd();\n\n    let saved_fd = unsafe { dup(1) };\n    assert!(saved_fd >= 0, \"dup(1) failed\");\n\n    let rc = unsafe { dup2(tmp_fd, 1) };\n    assert!(rc >= 0, \"dup2 failed\");\n    drop(tmp);\n\n    let result = f();\n\n    unsafe {\n        fflush(stdout);\n        let _ = std::io::Write::flush(&mut std::io::stdout());\n        dup2(saved_fd, 1);\n        close(saved_fd);\n    }\n\n    let mut data = Vec::new();\n    File::open(&tmp_path)\n        .expect(\"open temp\")\n        .read_to_end(&mut data)\n        .expect(\"read temp\");\n    let _ = std::fs::remove_file(&tmp_path);\n\n    (data, result)\n}\n\nfn rand_suffix() -> u64 {\n    use std::time::{SystemTime, UNIX_EPOCH};\n    let nanos = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap()\n        .as_nanos() as u64;\n    nanos.wrapping_mul(0x9E3779B97F4A7C15)\n}\n\n// ----- function signature aliases -----\n\ntype DoubleNegFn = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\ntype ConvertDoubleToIntFn = unsafe extern \"C\" fn(c_double) -> c_int;\ntype FindValueInBufferFn =\n    unsafe extern \"C\" fn(*const c_char, usize, c_int) -> c_int;\ntype ProcessNegationFn = unsafe extern \"C\" fn(c_int) -> c_int;\ntype CreateNumericBufferFn = unsafe extern \"C\" fn(*mut c_char, c_int, c_int);\ntype CalculateWithDoublesFn =\n    unsafe extern \"C\" fn(c_int, c_int, c_int) -> c_double;\n\nstruct Libs {\n    c: Library,\n    rust: Library,\n}\n\nimpl Libs {\n    fn load() -> Self {\n        let c = unsafe { Library::new(c_lib_path()).expect(\"load C lib\") };\n        let rust = unsafe { Library::new(rust_lib_path()).expect(\"load Rust lib\") };\n        Libs { c, rust }\n    }\n\n    fn pair<T: Copy>(&self, name: &[u8]) -> (Symbol<'_, T>, Symbol<'_, T>) {\n        unsafe {\n            let c_sym: Symbol<T> = self.c.get(name).expect(\"C symbol missing\");\n            let r_sym: Symbol<T> = self.rust.get(name).expect(\"Rust symbol missing\");\n            (c_sym, r_sym)\n        }\n    }\n}\n\n#[test]\nfn convert_double_to_int_matches() {\n    let libs = Libs::load();\n    let (c_fn, r_fn) = libs.pair::<ConvertDoubleToIntFn>(b\"convert_double_to_int\");\n\n    let inputs: &[f64] = &[\n        0.0,\n        1.0,\n        -1.0,\n        3.14,\n        -3.14,\n        1e10,\n        1e15,\n        -1e15,\n        f64::INFINITY,\n        f64::NEG_INFINITY,\n        f64::NAN,\n        2147483647.0,\n        -2147483648.0,\n        1e40,\n        -1e40,\n    ];\n    for &v in inputs {\n        let cv = unsafe { c_fn(v) };\n        let rv = unsafe { r_fn(v) };\n        assert_eq!(cv, rv, \"convert_double_to_int({})\", v);\n    }\n}\n\n#[test]\nfn process_negation_matches() {\n    let libs = Libs::load();\n    let (c_fn, r_fn) = libs.pair::<ProcessNegationFn>(b\"process_negation\");\n    for &v in &[0, 1, -1, 42, i32::MIN, i32::MAX, 1000] {\n        assert_eq!(unsafe { c_fn(v) }, unsafe { r_fn(v) });\n    }\n}\n\n#[test]\nfn create_numeric_buffer_matches() {\n    let libs = Libs::load();\n    let (c_fn, r_fn) = libs.pair::<CreateNumericBufferFn>(b\"create_numeric_buffer\");\n    for &(size, seed) in &[(0i32, 0i32), (1, 0), (256, 0), (256, 7), (256, -1), (256, 12345)] {\n        let mut cb = vec![0i8; size as usize];\n        let mut rb = vec![0i8; size as usize];\n        unsafe {\n            c_fn(cb.as_mut_ptr(), size, seed);\n            r_fn(rb.as_mut_ptr(), size, seed);\n        }\n        assert_eq!(cb, rb, \"create_numeric_buffer size={} seed={}\", size, seed);\n    }\n}\n\n#[test]\nfn find_value_in_buffer_matches() {\n    let libs = Libs::load();\n    let (c_fn, r_fn) = libs.pair::<FindValueInBufferFn>(b\"find_value_in_buffer\");\n    let buffer: Vec<i8> = (0..256).map(|i| (i % 256) as i8).collect();\n    for &search_val in &[0i32, 1, 100, 255, -1, 256, 42, 12345] {\n        let cv = unsafe { c_fn(buffer.as_ptr(), buffer.len(), search_val) };\n        let rv = unsafe { r_fn(buffer.as_ptr(), buffer.len(), search_val) };\n        assert_eq!(cv, rv, \"find_value_in_buffer search_val={}\", search_val);\n    }\n    // empty buffer\n    assert_eq!(\n        unsafe { c_fn(buffer.as_ptr(), 0, 0) },\n        unsafe { r_fn(buffer.as_ptr(), 0, 0) }\n    );\n}\n\n#[test]\nfn calculate_with_doubles_matches() {\n    let libs = Libs::load();\n    let (c_fn, r_fn) = libs.pair::<CalculateWithDoublesFn>(b\"calculate_with_doubles\");\n    let cases: &[(i32, i32, i32)] = &[\n        (0, 0, 0),\n        (1, 0, 5),\n        (10, 2, 3),\n        (-10, 4, 7),\n        (1, 3, 9),\n        (12345, 6789, 11),\n        (1, 1, -3),\n        (i32::MAX, 1, 0),\n    ];\n    for &(a, b, c) in cases {\n        let cv = unsafe { c_fn(a, b, c) };\n        let rv = unsafe { r_fn(a, b, c) };\n        // Bit-for-bit equality (handles NaN, +0/-0 differences).\n        assert_eq!(\n            cv.to_bits(),\n            rv.to_bits(),\n            \"calculate_with_doubles({},{},{}) got C={:?} R={:?}\",\n            a,\n            b,\n            c,\n            cv,\n            rv\n        );\n    }\n}\n\nfn run_doubleneg(libs: &Libs, p: (i32, i32, i32, i32)) -> (Vec<u8>, i32, Vec<u8>, i32) {\n    let (c_fn, r_fn) = libs.pair::<DoubleNegFn>(b\"doubleneg\");\n    let (c_out, c_ret) = capture_stdout(|| unsafe { c_fn(p.0, p.1, p.2, p.3) });\n    let (r_out, r_ret) = capture_stdout(|| unsafe { r_fn(p.0, p.1, p.2, p.3) });\n    (c_out, c_ret, r_out, r_ret)\n}\n\n#[test]\nfn doubleneg_matches_basic() {\n    let libs = Libs::load();\n    let cases = [\n        (1, 2, 3, 4),\n        (0, 0, 0, 0),\n        (-1, -2, -3, -4),\n        (100, 200, 300, 400),\n        (1, 0, 5, 10),\n        (i32::MAX, 1, 1, 1),\n    ];\n    for &p in &cases {\n        let (c_out, c_ret, r_out, r_ret) = run_doubleneg(&libs, p);\n        assert_eq!(c_ret, r_ret, \"return value mismatch for {:?}\", p);\n        if c_out != r_out {\n            // Print a diff for debugging.\n            let c_str = String::from_utf8_lossy(&c_out);\n            let r_str = String::from_utf8_lossy(&r_out);\n            for (i, (cl, rl)) in c_str.lines().zip(r_str.lines()).enumerate() {\n                if cl != rl {\n                    eprintln!(\"line {} differs:\\nC: {:?}\\nR: {:?}\", i, cl, rl);\n                }\n            }\n            if c_str.lines().count() != r_str.lines().count() {\n                eprintln!(\n                    \"line count C={} R={}\",\n                    c_str.lines().count(),\n                    r_str.lines().count()\n                );\n            }\n            panic!(\"output mismatch for params {:?}\", p);\n        }\n    }\n}\n","userModified":false}}
