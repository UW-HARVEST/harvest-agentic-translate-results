rs: C={} R={}\", c_n, r_n);\n            }\n            panic!(\"stdout output mismatch for params {:?}\", p);\n        }\n    }\n}\n\n#[test]\nfn ffi_all_functions_match() {\n    let libs = Libs::load();\n    check_convert_double_to_int(&libs);\n    check_process_negation(&libs);\n    check_create_numeric_buffer(&libs);\n    check_find_value_in_buffer(&libs);\n    check_calculate_with_doubles(&libs);\n    // Run the stdout-capturing test last; it modifies fd 1.\n    check_doubleneg(&libs);\n}\n","structuredPatch":[{"oldStart":1,"oldLines":42,"newStart":1,"newLines":38,"lines":["+// FFI integration tests: load both libraries via libloading and compare.","+//","+// Several of the tests below capture stdout via `dup2`, which clobbers fd 1","+// process-wide. The Rust test harness writes test status messages to stdout","+// from other threads in parallel, and those would leak into our capture.","+//","+// To avoid that, all tests are consolidated into a single `#[test]` function","+// so the harness only ever runs one capturing test at a time.","+"," use libloading::{Library, Symbol};"," use std::ffi::{c_char, c_double, c_int, c_void};"," use std::fs::File;"," use std::io::Read;"," use std::os::unix::io::AsRawFd;"," use std::path::PathBuf;","-use std::sync::Mutex;"," "," extern \"C\" {","     fn dup(oldfd: i32) -> i32;","     fn dup2(oldfd: i32, newfd: i32) -> i32;","     fn close(fd: i32) -> i32;","     fn fflush(stream: *mut c_void) -> i32;","-}","-","-// stdout in glibc is referenced via the `stdout` symbol.","-extern \"C\" {","     static stdout: *mut c_void;"," }"," ","-// Serialize all stdout-redirecting tests so they don't clobber each other.","-static STDOUT_LOCK: Mutex<()> = Mutex::new(());","-"," fn c_lib_path() -> PathBuf {","-    let manifest_dir = env!(\"CARGO_MANIFEST_DIR\");","-    PathBuf::from(manifest_dir).join(\"c_src/build/libtranslated_rust.so\")","+    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))","+        .join(\"c_src/build/libtranslated_rust.so