{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_66ixqzej5totha7mzaf7mlrfexaoiuokisoqsybf2liht634rcfa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01KRwu8p3SY7FGMtHz7zvpgV","name":"Write","input":{"file_path":"/tmp/harvest-translate-YJGu0J/translated_rust/tests/ffi_compare.rs","content":"// Integration test: compare C and Rust implementations via libloading.\n//\n// We spawn child processes for each test invocation to ensure global state\n// (the static FILE *log_file in logger.c, plus stdout) is per-test and\n// isolated from other tests. The child loads ONE shared library at a time\n// (either C or Rust), runs a fixed sequence of FFI calls, and writes its\n// captured output to a results file. The parent then byte-compares.\n\nuse std::ffi::{CStr, CString};\nuse std::fs;\nuse std::io::{Read, Write};\nuse std::os::raw::{c_char, c_int};\nuse std::path::{Path, PathBuf};\nuse std::process::Command;\n\nconst REPO_ROOT_ENV: &str = \"CARGO_MANIFEST_DIR\";\n\nfn repo_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    repo_root().join(\"c_src/build/libdriver.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    repo_root().join(\"target/release/libdriver.so\")\n}\n\nfn ensure_libs_built() {\n    assert!(\n        c_lib_path().exists(),\n        \"C library not built at {:?}; build it first\",\n        c_lib_path()\n    );\n    assert!(\n        rust_lib_path().exists(),\n        \"Rust library not built at {:?}; build it first\",\n        rust_lib_path()\n    );\n}\n\n// ---- structs that mirror task_manager.h ----\n#[repr(C)]\n#[allow(dead_code)]\nstruct Task {\n    description: [c_char; 256],\n    priority: c_int,\n}\n\n#[repr(C)]\n#[allow(dead_code)]\nstruct TaskManager {\n    tasks: *mut Task,\n    max_tasks: c_int,\n    task_count: c_int,\n}\n\n// ----- helper: load lib and call a function ----\n//\n// We test through libloading directly in a child-like model: each test creates\n// a unique temp dir, sets LOG_FILE to a file in that dir, redirects stdout via\n// `freopen` to another file in that dir, performs the FFI calls, restores\n// stdout, and then reads back both files for comparison.\n\nunsafe fn run_scenario_with_lib(lib_path: &Path, tmpdir: &Path, scenario: Scenario) -> RunOutput {\n    let lib = libloading::Library::new(lib_path).expect(\"failed to load lib\");\n\n    let log_file = tmpdir.join(\"log.txt\");\n    let stdout_file = tmpdir.join(\"stdout.txt\");\n\n    // Configure env vars for THIS process. They affect the next call into\n    // the library (which uses getenv).\n    std::env::set_var(\"LOG_FILE\", &log_file);\n    if let Some(max) = scenario.max_tasks_env {\n        std::env::set_var(\"MAX_TASKS\", max);\n    } else {\n        std::env::remove_var(\"MAX_TASKS\");\n    }\n\n    // Redirect stdout to a file via freopen so the C library's printf goes\n    // there too. We restore it via freopen(\"/dev/tty\", ...) afterwards — but\n    // since \"/dev/tty\" may not exist, use dup/dup2 of the original fd instead.\n    let saved_stdout_fd: libc::c_int = unsafe { libc::dup(1) };\n    assert!(saved_stdout_fd >= 0, \"dup(stdout) failed\");\n    let stdout_path_c = CString::new(stdout_file.to_string_lossy().as_bytes()).unwrap();\n    let mode_c = CString::new(\"w\").unwrap();\n    let new_stdout = unsafe { libc::freopen(stdout_path_c.as_ptr(), mode_c.as_ptr(), libc_stdout()) };\n    assert!(!new_stdout.is_null(), \"freopen for stdout failed\");\n\n    match scenario.kind {\n        ScenarioKind::Driver { ref input } => {\n            type DriverFn = unsafe extern \"C\" fn(*const c_char) -> c_int;\n            let func: libloading::Symbol<DriverFn> =\n                unsafe { lib.get(b\"driver\").expect(\"missing driver\") };\n            let cinput = CString::new(input.as_str()).unwrap();\n            let rc = unsafe { func(cinput.as_ptr()) };\n            // Flush stdout before restoring.\n            unsafe {\n                libc::fflush(libc_stdout());\n            }\n            // Restore stdout\n            unsafe {\n                libc::dup2(saved_stdout_fd, 1);\n                libc::close(saved_stdout_fd);\n            }\n\n            let stdout = read_file_bytes(&stdout_file);\n            let log = read_file_bytes(&log_file);\n            RunOutput {\n                stdout,\n                log,\n                ret_code: Some(rc),\n                tm_state: None,\n            }\n        }\n        ScenarioKind::TaskManagerOps { ref ops } => {\n            // Direct calls into create_task_manager / add_task / print_tasks /\n            // destroy_task_manager, plus initialize_logger / finalize_logger\n            // bracketing.\n            type Init = unsafe extern \"C\" fn() -> c_int;\n            type Fin = unsafe extern \"C\" fn();\n            type Create = unsafe extern \"C\" fn() -> *mut TaskManager;\n            type Add = unsafe extern \"C\" fn(*mut TaskManager, *const c_char, c_int);\n            type Print = unsafe extern \"C\" fn(*const TaskManager);\n            type Destroy = unsafe extern \"C\" fn(*mut TaskManager);\n\n            let init: libloading::Symbol<Init> = unsafe { lib.get(b\"initialize_logger\").unwrap() };\n            let create: libloading::Symbol<Create> = unsafe { lib.get(b\"create_task_manager\").unwrap() };\n            let add: libloading::Symbol<Add> = unsafe { lib.get(b\"add_task\").unwrap() };\n            let print: libloading::Symbol<Print> = unsafe { lib.get(b\"print_tasks\").unwrap() };\n            let destroy: libloading::Symbol<Destroy> = unsafe { lib.get(b\"destroy_task_manager\").unwrap() };\n            let fin: libloading::Symbol<Fin> = unsafe { lib.get(b\"finalize_logger\").unwrap() };\n\n            let rc = unsafe { init() };\n            assert_eq!(rc, 0, \"initialize_logger failed\");\n            let tm = unsafe { create() };\n            assert!(!tm.is_null(), \"create_task_manager returned NULL\");\n            // Snapshot the manager state once after creation so we can\n            // compare struct layouts.\n            let tm_state_after_create = unsafe {\n                ManagerSnapshot {\n                    max_tasks: (*tm).max_tasks,\n                    task_count: (*tm).task_count,\n                }\n            };\n\n            let mut snapshots = Vec::new();\n            for op in ops {\n                match op {\n                    TmOp::Add { desc, priority } => {\n                        let cdesc = CString::new(desc.as_str()).unwrap();\n                        unsafe { add(tm, cdesc.as_ptr(), *priority) };\n                    }\n                    TmOp::Print => unsafe {\n                        print(tm);\n                        libc::fflush(libc_stdout());\n                    },\n                    TmOp::Snapshot => unsafe {\n                        // Snapshot description bytes for first few tasks.\n                        let tc = (*tm).task_count;\n                        let mut tasks_dump = Vec::new();\n                        for i in 0..tc {\n                            let t = (*tm).tasks.offset(i as isize);\n                            let cstr = CStr::from_ptr((*t).description.as_ptr());\n                            tasks_dump.push(TaskSnapshot {\n                                priority: (*t).priority,\n                                description: cstr.to_bytes().to_vec(),\n                            });\n                        }\n                        snapshots.push(ManagerStateDump {\n                            max_tasks: (*tm).max_tasks,\n                            task_count: (*tm).task_count,\n                            tasks: tasks_dump,\n                        });\n                    },\n                }\n            }\n            unsafe {\n                destroy(tm);\n                fin();\n            }\n\n            // Restore stdout\n            unsafe {\n                libc::dup2(saved_stdout_fd, 1);\n                libc::close(saved_stdout_fd);\n            }\n\n            let stdout = read_file_bytes(&stdout_file);\n            let log = read_file_bytes(&log_file);\n            RunOutput {\n                stdout,\n                log,\n                ret_code: None,\n                tm_state: Some(TmState {\n                    after_create: tm_state_after_create,\n                    snapshots,\n                }),\n            }\n        }\n    }\n}\n\nunsafe fn libc_stdout() -> *mut libc::FILE {\n    extern \"C\" {\n        static stdout: *mut libc::FILE;\n    }\n    unsafe { stdout }\n}\n\nfn read_file_bytes(p: &Path) -> Vec<u8> {\n    if !p.exists() {\n        return Vec::new();\n    }\n    let mut v = Vec::new();\n    fs::File::open(p)\n        .and_then(|mut f| f.read_to_end(&mut v))\n        .expect(\"read file\");\n    v\n}\n\nstruct Scenario {\n    max_tasks_env: Option<String>,\n    kind: ScenarioKind,\n}\n\nenum ScenarioKind {\n    Driver { input: String },\n    TaskManagerOps { ops: Vec<TmOp> },\n}\n\nenum TmOp {\n    Add { desc: String, priority: c_int },\n    Print,\n    Snapshot,\n}\n\n#[derive(Debug, PartialEq, Eq)]\nstruct RunOutput {\n    stdout: Vec<u8>,\n    log: Vec<u8>,\n    ret_code: Option<c_int>,\n    tm_state: Option<TmState>,\n}\n\n#[derive(Debug, PartialEq, Eq)]\nstruct TmState {\n    after_create: ManagerSnapshot,\n    snapshots: Vec<ManagerStateDump>,\n}\n\n#[derive(Debug, PartialEq, Eq)]\nstruct ManagerSnapshot {\n    max_tasks: c_int,\n    task_count: c_int,\n}\n\n#[derive(Debug, PartialEq, Eq)]\nstruct ManagerStateDump {\n    max_tasks: c_int,\n    task_count: c_int,\n    tasks: Vec<TaskSnapshot>,\n}\n\n#[derive(Debug, PartialEq, Eq)]\nstruct TaskSnapshot {\n    priority: c_int,\n    description: Vec<u8>,\n}\n\nfn make_tmpdir(tag: &str) -> PathBuf {\n    let base = std::env::temp_dir().join(format!(\n        \"ffi_compare_{}_{}_{}\",\n        tag,\n        std::process::id(),\n        std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .unwrap()\n            .as_nanos()\n    ));\n    fs::create_dir_all(&base).unwrap();\n    base\n}\n\nfn run_both_and_compare(scenario_factory: impl Fn() -> Scenario, tag: &str) {\n    ensure_libs_built();\n\n    let c_dir = make_tmpdir(&format!(\"c_{}\", tag));\n    let rust_dir = make_tmpdir(&format!(\"rust_{}\", tag));\n\n    let c_out = unsafe { run_scenario_with_lib(&c_lib_path(), &c_dir, scenario_factory()) };\n    let r_out = unsafe { run_scenario_with_lib(&rust_lib_path(), &rust_dir, scenario_factory()) };\n\n    if c_out.stdout != r_out.stdout {\n        eprintln!(\"--- C stdout ---\\n{}\", String::from_utf8_lossy(&c_out.stdout));\n        eprintln!(\"--- R stdout ---\\n{}\", String::from_utf8_lossy(&r_out.stdout));\n        panic!(\"stdout mismatch for tag {}\", tag);\n    }\n    if c_out.log != r_out.log {\n        eprintln!(\"--- C log ---\\n{}\", String::from_utf8_lossy(&c_out.log));\n        eprintln!(\"--- R log ---\\n{}\", String::from_utf8_lossy(&r_out.log));\n        panic!(\"log mismatch for tag {}\", tag);\n    }\n    assert_eq!(c_out.ret_code, r_out.ret_code, \"ret code mismatch\");\n    assert_eq!(c_out.tm_state, r_out.tm_state, \"tm state mismatch\");\n\n    let _ = fs::remove_dir_all(&c_dir);\n    let _ = fs::remove_dir_all(&rust_dir);\n}\n\n// We must serialize tests because they all mutate process-global env and\n// stdout. Use a simple Mutex<()> with #[serial] semantics via a wrapper.\nfn run_serial(f: impl FnOnce()) {\n    use std::sync::Mutex;\n    static LOCK: Mutex<()> = Mutex::new(());\n    let _g = LOCK.lock().unwrap_or_else(|p| p.into_inner());\n    let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f)).map_err(|e| {\n        std::panic::resume_unwind(e);\n    });\n}\n\n#[test]\nfn test_logger_init_finalize_only() {\n    run_serial(|| {\n        run_both_and_compare(\n            || Scenario {\n                max_tasks_env: None,\n                kind: ScenarioKind::TaskManagerOps { ops: vec![] },\n            },\n            \"logger_only\",\n        );\n    });\n}\n\n#[test]\nfn test_task_manager_basic() {\n    run_serial(|| {\n        run_both_and_compare(\n            || Scenario {\n                max_tasks_env: Some(\"5\".into()),\n                kind: ScenarioKind::TaskManagerOps {\n                    ops: vec![\n                        TmOp::Snapshot,\n                        TmOp::Add { desc: \"first task\".into(), priority: 1 },\n                        TmOp::Add { desc: \"second task\".into(), priority: 2 },\n                        TmOp::Snapshot,\n                        TmOp::Print,\n                    ],\n                },\n            },\n            \"tm_basic\",\n        );\n    });\n}\n\n#[test]\nfn test_task_manager_overflow() {\n    run_serial(|| {\n        run_both_and_compare(\n            || Scenario {\n                max_tasks_env: Some(\"2\".into()),\n                kind: ScenarioKind::TaskManagerOps {\n                    ops: vec![\n                        TmOp::Add { desc: \"a\".into(), priority: 1 },\n                        TmOp::Add { desc: \"b\".into(), priority: 2 },\n                        TmOp::Add { desc: \"c (should fail)\".into(), priority: 3 },\n                        TmOp::Snapshot,\n                        TmOp::Print,\n                    ],\n                },\n            },\n            \"tm_overflow\",\n        );\n    });\n}\n\n#[test]\nfn test_task_manager_long_description() {\n    run_serial(|| {\n        let long = \"x\".repeat(300); // longer than 255\n        run_both_and_compare(\n            move || Scenario {\n                max_tasks_env: Some(\"3\".into()),\n                kind: ScenarioKind::TaskManagerOps {\n                    ops: vec![\n                        TmOp::Add { desc: long.clone(), priority: 7 },\n                        TmOp::Snapshot,\n                        TmOp::Print,\n                    ],\n                },\n            },\n            \"tm_long\",\n        );\n    });\n}\n\n#[test]\nfn test_driver_simple() {\n    run_serial(|| {\n        run_both_and_compare(\n            || Scenario {\n                max_tasks_env: Some(\"10\".into()),\n                kind: ScenarioKind::Driver {\n                    input: \"alpha\\nbeta\\ngamma\".into(),\n                },\n            },\n            \"drv_simple\",\n        );\n    });\n}\n\n#[test]\nfn test_driver_trailing_newline() {\n    run_serial(|| {\n        run_both_and_compare(\n            || Scenario {\n                max_tasks_env: Some(\"10\".into()),\n                kind: ScenarioKind::Driver {\n                    input: \"one\\ntwo\\n\".into(),\n                },\n            },\n            \"drv_trail\",\n        );\n    });\n}\n\n#[test]\nfn test_driver_single_no_newline() {\n    run_serial(|| {\n        run_both_and_compare(\n            || Scenario {\n                max_tasks_env: Some(\"3\".into()),\n                kind: ScenarioKind::Driver {\n                    input: \"only one task\".into(),\n                },\n            },\n            \"drv_single\",\n        );\n    });\n}\n\n// Symbols match nm test\n#[test]\nfn test_symbol_parity() {\n    ensure_libs_built();\n    let c_syms = collect_t_symbols(&c_lib_path());\n    let r_syms = collect_t_symbols(&rust_lib_path());\n    let expected = [\"initialize_logger\", \"log_info\", \"log_warning\", \"log_error\",\n        \"finalize_logger\", \"create_task_manager\", \"add_task\", \"print_tasks\",\n        \"destroy_task_manager\", \"driver\"];\n    for s in expected.iter() {\n        assert!(c_syms.contains(*s), \"C lib missing {}\", s);\n        assert!(r_syms.contains(*s), \"Rust lib missing {}\", s);\n    }\n}\n\nfn collect_t_symbols(p: &Path) -> std::collections::HashSet<String> {\n    let out = Command::new(\"nm\").arg(\"-D\").arg(p).output().expect(\"nm\");\n    let s = String::from_utf8_lossy(&out.stdout);\n    let mut set = std::collections::HashSet::new();\n    for line in s.lines() {\n        // expect: \"<addr> T <name>\"\n        let parts: Vec<&str> = line.split_whitespace().collect();\n        if parts.len() == 3 && parts[1] == \"T\" {\n            set.insert(parts[2].to_string());\n        }\n    }\n    set\n}\n\n// silence unused-import warning when REPO_ROOT_ENV is referenced only by docs.\n#[allow(dead_code)]\nfn _touch_root() {\n    let _ = REPO_ROOT_ENV;\n    let _: Box<dyn Write> = Box::new(std::io::sink());\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":162,"cache_read_input_tokens":29071,"cache_creation":{"ephemeral_5m_input_tokens":162,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"902c9409-39ff-4eee-b975-6e0b77483841","uuid":"75be6b4a-7f5f-40da-8f4d-a1a8b097a0be"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KRwu8p3SY7FGMtHz7zvpgV","type":"tool_result","content":"File created successfully at: /tmp/harvest-translate-YJGu0J/translated_rust/tests/ffi_compare.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"902c9409-39ff-4eee-b975-6e0b77483841","uuid":"1e223434-82d8-4bcd-ad69-d058df6f4c0e","timestamp":"2026-05-30T01:29:15.454Z","tool_use_result":{"type":"create","filePath":"/tmp/harvest-translate-YJGu0J/translated_rust/tests/ffi_compare.rs","content":"// Integration test: compare C and Rust implementations via libloading.\n//\n// We spawn child processes for each test invocation to ensure global state\n// (the static FILE *log_file in logger.c, plus stdout) is per-test and\n// isolated from other tests. The child loads ONE shared library at a time\n// (either C or Rust), runs a fixed sequence of FFI calls, and writes its\n// captured output to a results file. The parent then byte-compares.\n\nuse std::ffi::{CStr, CString};\nuse std::fs;\nuse std::io::{Read, Write};\nuse std::os::raw::{c_char, c_int};\nuse std::path::{Path, PathBuf};\nuse std::process::Command;\n\nconst REPO_ROOT_ENV: &str = \"CARGO_MANIFEST_DIR\";\n\nfn repo_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    repo_root().join(\"c_src/build/libdriver.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    repo_root().join(\"target/release/libdriver.so\")\n}\n\nfn ensure_libs_built() {\n    assert!(\n        c_lib_path().exists(),\n        \"C library not built at {:?}; build it first\",\n        c_lib_path()\n    );\n    assert!(\n        rust_lib_path().exists(),\n        \"Rust library not built at {:?}; build it first\",\n        rust_lib_path()\n    );\n}\n\n// ---- structs that mirror task_manager.h ----\n#[repr(C)]\n#[allow(dead_code)]\nstruct Task {\n    description: [c_char; 256],\n    priority: c_int,\n}\n\n#[repr(C)]\n#[allow(dead_code)]\nstruct TaskManager {\n    tasks: *mut Task,\n    max_tasks: c_int,\n    task_count: c_int,\n}\n\n// ----- helper: load lib and call a function ----\n//\n// We test through libloading directly in a child-like model: each test creates\n// a unique temp dir, sets LOG_FILE to a file in that dir, redirects stdout via\n// `freopen` to another file in that dir, performs the FFI calls, restores\n// stdout, and then reads back both files for comparison.\n\nunsafe fn run_scenario_with_lib(lib_path: &Path, tmpdir: &Path, scenario: Scenario) -> RunOutput {\n    let lib = libloading::Library::new(lib_path).expect(\"failed to load lib\");\n\n    let log_file = tmpdir.join(\"log.txt\");\n    let stdout_file = tmpdir.join(\"stdout.txt\");\n\n    // Configure env vars for THIS process. They affect the next call into\n    // the library (which uses getenv).\n    std::env::set_var(\"LOG_FILE\", &log_file);\n    if let Some(max) = scenario.max_tasks_env {\n        std::env::set_var(\"MAX_TASKS\", max);\n    } else {\n        std::env::remove_var(\"MAX_TASKS\");\n    }\n\n    // Redirect stdout to a file via freopen so the C library's printf goes\n    // there too. We restore it via freopen(\"/dev/tty\", ...) afterwards — but\n    // since \"/dev/tty\" may not exist, use dup/dup2 of the original fd instead.\n    let saved_stdout_fd: libc::c_int = unsafe { libc::dup(1) };\n    assert!(saved_stdout_fd >= 0, \"dup(stdout) failed\");\n    let stdout_path_c = CString::new(stdout_file.to_string_lossy().as_bytes()).unwrap();\n    let mode_c = CString::new(\"w\").unwrap();\n    let new_stdout = unsafe { libc::freopen(stdout_path_c.as_ptr(), mode_c.as_ptr(), libc_stdout()) };\n    assert!(!new_stdout.is_null(), \"freopen for stdout failed\");\n\n    match scenario.kind {\n        ScenarioKind::Driver { ref input } => {\n            type DriverFn = unsafe extern \"C\" fn(*const c_char) -> c_int;\n            let func: libloading::Symbol<DriverFn> =\n                unsafe { lib.get(b\"driver\").expect(\"missing driver\") };\n            let cinput = CString::new(input.as_str()).unwrap();\n            let rc = unsafe { func(cinput.as_ptr()) };\n            // Flush stdout before restoring.\n            unsafe {\n                libc::fflush(libc_stdout());\n            }\n            // Restore stdout\n            unsafe {\n                libc::dup2(saved_stdout_fd, 1);\n                libc::close(saved_stdout_fd);\n            }\n\n            let stdout = read_file_bytes(&stdout_file);\n            let log = read_file_bytes(&log_file);\n            RunOutput {\n                stdout,\n                log,\n                ret_code: Some(rc),\n                tm_state: None,\n            }\n        }\n        ScenarioKind::TaskManagerOps { ref ops } => {\n            // Direct calls into create_task_manager / add_task / print_tasks /\n            // destroy_task_manager, plus initialize_logger / finalize_logger\n            // bracketing.\n            type Init = unsafe extern \"C\" fn() -> c_int;\n            type Fin = unsafe extern \"C\" fn();\n            type Create = unsafe extern \"C\" fn() -> *mut TaskManager;\n            type Add = unsafe extern \"C\" fn(*mut TaskManager, *const c_char, c_int);\n            type Print = unsafe extern \"C\" fn(*const TaskManager);\n            type Destroy = unsafe extern \"C\" fn(*mut TaskManager);\n\n            let init: libloading::Symbol<Init> = unsafe { lib.get(b\"initialize_logger\").unwrap() };\n            let create: libloading::Symbol<Create> = unsafe { lib.get(b\"create_task_manager\").unwrap() };\n            let add: libloading::Symbol<Add> = unsafe { lib.get(b\"add_task\").unwrap() };\n            let print: libloading::Symbol<Print> = unsafe { lib.get(b\"print_tasks\").unwrap() };\n            let destroy: libloading::Symbol<Destroy> = unsafe { lib.get(b\"destroy_task_manager\").unwrap() };\n            let fin: libloading::Symbol<Fin> = unsafe { lib.get(b\"finalize_logger\").unwrap() };\n\n            let rc = unsafe { init() };\n            assert_eq!(rc, 0, \"initialize_logger failed\");\n            let tm = unsafe { create() };\n            assert!(!tm.is_null(), \"create_task_manager returned NULL\");\n            // Snapshot the manager state once after creation so we can\n            // compare struct layouts.\n            let tm_state_after_create = unsafe {\n                ManagerSnapshot {\n                    max_tasks: (*tm).max_tasks,\n                    task_count: (*tm).task_count,\n                }\n            };\n\n            let mut snapshots = Vec::new();\n            for op in ops {\n                match op {\n                    TmOp::Add { desc, priority } => {\n                        let cdesc = CString::new(desc.as_str()).unwrap();\n                        unsafe { add(tm, cdesc.as_ptr(), *priority) };\n                    }\n                    TmOp::Print => unsafe {\n                        print(tm);\n                        libc::fflush(libc_stdout());\n                    },\n                    TmOp::Snapshot => unsafe {\n                        // Snapshot description bytes for first few tasks.\n                        let tc = (*tm).task_count;\n                        let mut tasks_dump = Vec::new();\n                        for i in 0..tc {\n                            let t = (*tm).tasks.offset(i as isize);\n                            let cstr = CStr::from_ptr((*t).description.as_ptr());\n                            tasks_dump.push(TaskSnapshot {\n                                priority: (*t).priority,\n                                description: cstr.to_bytes().to_vec(),\n                            });\n                        }\n                        snapshots.push(ManagerStateDump {\n                            max_tasks: (*tm).max_tasks,\n                            task_count: (*tm).task_count,\n                            tasks: tasks_dump,\n                        });\n                    },\n                }\n            }\n            unsafe {\n                destroy(tm);\n                fin();\n            }\n\n            // Restore stdout\n            unsafe {\n                libc::dup2(saved_stdout_fd, 1);\n                libc::close(saved_stdout_fd);\n            }\n\n            let stdout = read_file_bytes(&stdout_file);\n            let log = read_file_bytes(&log_file);\n            RunOutput {\n                stdout,\n                log,\n                ret_code: None,\n                tm_state: Some(TmState {\n                    after_create: tm_state_after_create,\n                    snapshots,\n                }),\n            }\n        }\n    }\n}\n\nunsafe fn libc_stdout() -> *mut libc::FILE {\n    extern \"C\" {\n        static stdout: *mut libc::FILE;\n    }\n    unsafe { stdout }\n}\n\nfn read_file_bytes(p: &Path) -> Vec<u8> {\n    if !p.exists() {\n        return Vec::new();\n    }\n    let mut v = Vec::new();\n    fs::File::open(p)\n        .and_then(|mut f| f.read_to_end(&mut v))\n        .expect(\"read file\");\n    v\n}\n\nstruct Scenario {\n    max_tasks_env: Option<String>,\n    kind: ScenarioKind,\n}\n\nenum ScenarioKind {\n    Driver { input: String },\n    TaskManagerOps { ops: Vec<TmOp> },\n}\n\nenum TmOp {\n    Add { desc: String, priority: c_int },\n    Print,\n    Snapshot,\n}\n\n#[derive(Debug, PartialEq, Eq)]\nstruct RunOutput {\n    stdout: Vec<u8>,\n    log: Vec<u8>,\n    ret_code: Option<c_int>,\n    tm_state: Option<TmState>,\n}\n\n#[derive(Debug, PartialEq, Eq)]\nstruct TmState {\n    after_create: ManagerSnapshot,\n    snapshots: Vec<ManagerStateDump>,\n}\n\n#[derive(Debug, PartialEq, Eq)]\nstruct ManagerSnapshot {\n    max_tasks: c_int,\n    task_count: c_int,\n}\n\n#[derive(Debug, PartialEq, Eq)]\nstruct ManagerStateDump {\n    max_tasks: c_int,\n    task_count: c_int,\n    tasks: Vec<TaskSnapshot>,\n}\n\n#[derive(Debug, PartialEq, Eq)]\nstruct TaskSnapshot {\n    priority: c_int,\n    description: Vec<u8>,\n}\n\nfn make_tmpdir(tag: &str) -> PathBuf {\n    let base = std::env::temp_dir().join(format!(\n        \"ffi_compare_{}_{}_{}\",\n        tag,\n        std::process::id(),\n        std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .unwrap()\n            .as_nanos()\n    ));\n    fs::create_dir_all(&base).unwrap();\n    base\n}\n\nfn run_both_and_compare(scenario_factory: impl Fn() -> Scenario, tag: &str) {\n    ensure_libs_built();\n\n    let c_dir = make_tmpdir(&format!(\"c_{}\", tag));\n    let rust_dir = make_tmpdir(&format!(\"rust_{}\", tag));\n\n    let c_out = unsafe { run_scenario_with_lib(&c_lib_path(), &c_dir, scenario_factory()) };\n    let r_out = unsafe { run_scenario_with_lib(&rust_lib_path(), &rust_dir, scenario_factory()) };\n\n    if c_out.stdout != r_out.stdout {\n        eprintln!(\"--- C stdout ---\\n{}\", String::from_utf8_lossy(&c_out.stdout));\n        eprintln!(\"--- R stdout ---\\n{}\", String::from_utf8_lossy(&r_out.stdout));\n        panic!(\"stdout mismatch for tag {}\", tag);\n    }\n    if c_out.log != r_out.log {\n        eprintln!(\"--- C log ---\\n{}\", String::from_utf8_lossy(&c_out.log));\n        eprintln!(\"--- R log ---\\n{}\", String::from_utf8_lossy(&r_out.log));\n        panic!(\"log mismatch for tag {}\", tag);\n    }\n    assert_eq!(c_out.ret_code, r_out.ret_code, \"ret code mismatch\");\n    assert_eq!(c_out.tm_state, r_out.tm_state, \"tm state mismatch\");\n\n    let _ = fs::remove_dir_all(&c_dir);\n    let _ = fs::remove_dir_all(&rust_dir);\n}\n\n// We must serialize tests because they all mutate process-global env and\n// stdout. Use a simple Mutex<()> with #[serial] semantics via a wrapper.\nfn run_serial(f: impl FnOnce()) {\n    use std::sync::Mutex;\n    static LOCK: Mutex<()> = Mutex::new(());\n    let _g = LOCK.lock().unwrap_or_else(|p| p.into_inner());\n    let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f)).map_err(|e| {\n        std::panic::resume_unwind(e);\n    });\n}\n\n#[test]\nfn test_logger_init_finalize_only() {\n    run_serial(|| {\n        run_both_and_compare(\n            || Scenario {\n                max_tasks_env: None,\n                kind: ScenarioKind::TaskManagerOps { ops: vec![] },\n            },\n            \"logger_only\",\n        );\n    });\n}\n\n#[test]\nfn test_task_manager_basic() {\n    run_serial(|| {\n        run_both_and_compare(\n            || Scenario {\n                max_tasks_env: Some(\"5\".into()),\n                kind: ScenarioKind::TaskManagerOps {\n                    ops: vec![\n                        TmOp::Snapshot,\n                        TmOp::Add { desc: \"first task\".into(), priority: 1 },\n                        TmOp::Add { desc: \"second task\".into(), priority: 2 },\n                        TmOp::Snapshot,\n                        TmOp::Print,\n                    ],\n                },\n            },\n            \"tm_basic\",\n        );\n    });\n}\n\n#[test]\nfn test_task_manager_overflow() {\n    run_serial(|| {\n        run_both_and_compare(\n            || Scenario {\n                max_tasks_env: Some(\"2\".into()),\n                kind: ScenarioKind::TaskManagerOps {\n                    ops: vec![\n                        TmOp::Add { desc: \"a\".into(), priority: 1 },\n                        TmOp::Add { desc: \"b\".into(), priority: 2 },\n                        TmOp::Add { desc: \"c (should fail)\".into(), priority: 3 },\n                        TmOp::Snapshot,\n                        TmOp::Print,\n                    ],\n                },\n            },\n            \"tm_overflow\",\n        );\n    });\n}\n\n#[test]\nfn test_task_manager_long_description() {\n    run_serial(|| {\n        let long = \"x\".repeat(300); // longer than 255\n        run_both_and_compare(\n            move || Scenario {\n                max_tasks_env: Some(\"3\".into()),\n                kind: ScenarioKind::TaskManagerOps {\n                    ops: vec![\n                        TmOp::Add { desc: long.clone(), priority: 7 },\n                        TmOp::Snapshot,\n                        TmOp::Print,\n                    ],\n                },\n            },\n            \"tm_long\",\n        );\n    });\n}\n\n#[test]\nfn test_driver_simple() {\n    run_serial(|| {\n        run_both_and_compare(\n            || Scenario {\n                max_tasks_env: Some(\"10\".into()),\n                kind: ScenarioKind::Driver {\n                    input: \"alpha\\nbeta\\ngamma\".into(),\n                },\n            },\n            \"drv_simple\",\n        );\n    });\n}\n\n#[test]\nfn test_driver_trailing_newline() {\n    run_serial(|| {\n        run_both_and_compare(\n            || Scenario {\n                max_tasks_env: Some(\"10\".into()),\n                kind: ScenarioKind::Driver {\n                    input: \"one\\ntwo\\n\".into(),\n                },\n            },\n            \"drv_trail\",\n        );\n    });\n}\n\n#[test]\nfn test_driver_single_no_newline() {\n    run_serial(|| {\n        run_both_and_compare(\n            || Scenario {\n                max_tasks_env: Some(\"3\".into()),\n                kind: ScenarioKind::Driver {\n                    input: \"only one task\".into(),\n                },\n            },\n            \"drv_single\",\n        );\n    });\n}\n\n// Symbols match nm test\n#[test]\nfn test_symbol_parity() {\n    ensure_libs_built();\n    let c_syms = collect_t_symbols(&c_lib_path());\n    let r_syms = collect_t_symbols(&rust_lib_path());\n    let expected = [\"initialize_logger\", \"log_info\", \"log_warning\", \"log_error\",\n        \"finalize_logger\", \"create_task_manager\", \"add_task\", \"print_tasks\",\n        \"destroy_task_manager\", \"driver\"];\n    for s in expected.iter() {\n        assert!(c_syms.contains(*s), \"C lib missing {}\", s);\n        assert!(r_syms.contains(*s), \"Rust lib missing {}\", s);\n    }\n}\n\nfn collect_t_symbols(p: &Path) -> std::collections::HashSet<String> {\n    let out = Command::new(\"nm\").arg(\"-D\").arg(p).output().expect(\"nm\");\n    let s = String::from_utf8_lossy(&out.stdout);\n    let mut set = std::collections::HashSet::new();\n    for line in s.lines() {\n        // expect: \"<addr> T <name>\"\n        let parts: Vec<&str> = line.split_whitespace().collect();\n        if parts.len() == 3 && parts[1] == \"T\" {\n            set.insert(parts[2].to_string());\n        }\n    }\n    set\n}\n\n// silence unused-import warning when REPO_ROOT_ENV is referenced only by docs.\n#[allow(dead_code)]\nfn _touch_root() {\n    let _ = REPO_ROOT_ENV;\n    let _: Box<dyn Write> = Box::new(std::io::sink());\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
