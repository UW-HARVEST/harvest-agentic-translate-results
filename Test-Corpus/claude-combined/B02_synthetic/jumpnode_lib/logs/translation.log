{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_osnbbdpfubimxwizos7uskkw5juhxnvhmb3yfgijxsyg5uvgtvwq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01LAJiSMqqeR5a8JFoqdpmmz","name":"Write","input":{"file_path":"/tmp/harvest-translate-eyWZar/translated_rust/tests/ffi_parity.rs","content":"// FFI parity tests: load both the C and the Rust .so via libloading and\n// compare outputs for jumpnode.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_int;\nuse std::path::PathBuf;\n\ntype JumpnodeFn = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n\nfn workspace_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    workspace_root().join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    workspace_root().join(\"target/release/libtranslated_rust.so\")\n}\n\nunsafe fn call_jumpnode(lib: &Library, args: (c_int, c_int, c_int, c_int)) -> c_int {\n    let f: Symbol<JumpnodeFn> = lib.get(b\"jumpnode\\0\").expect(\"symbol missing\");\n    f(args.0, args.1, args.2, args.3)\n}\n\n#[test]\nfn jumpnode_parity_full_matrix() {\n    // Each library should be loaded once per process to avoid re-init issues.\n    let c_lib = unsafe { Library::new(c_lib_path()) }.expect(\"failed to load C .so\");\n    let rust_lib = unsafe { Library::new(rust_lib_path()) }.expect(\"failed to load Rust .so\");\n\n    // Operation modes covered: 0o001..=0o004, plus a default-branch case (0o000 and 0o005).\n    let modes: [c_int; 6] = [0o000, 0o001, 0o002, 0o003, 0o004, 0o005];\n    let node_ids: [c_int; 5] = [-1, 0, 1, 7, 999];\n    let depths: [c_int; 6] = [0, 1, 3, 8, 15, 16];\n    let flags: [c_int; 5] = [0, 1, 0o0177, -1, 12345];\n\n    for &m in &modes {\n        for &n in &node_ids {\n            for &d in &depths {\n                for &f in &flags {\n                    let c_out = unsafe { call_jumpnode(&c_lib, (m, n, d, f)) };\n                    let r_out = unsafe { call_jumpnode(&rust_lib, (m, n, d, f)) };\n                    assert_eq!(\n                        c_out, r_out,\n                        \"mismatch for jumpnode(m={m}, n={n}, d={d}, f={f}): C={c_out} Rust={r_out}\"\n                    );\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn jumpnode_parity_mode_3_format_buffer() {\n    // Mode 3 doesn't read node_storage, so we can probe sprintf-derived outputs.\n    let c_lib = unsafe { Library::new(c_lib_path()) }.expect(\"failed to load C .so\");\n    let rust_lib = unsafe { Library::new(rust_lib_path()) }.expect(\"failed to load Rust .so\");\n\n    let cases: &[(c_int, c_int, c_int, c_int)] = &[\n        (0o003, 0, 0, 0),\n        (0o003, 1, 1, 1),\n        (0o003, 99, 99, 0o0177),\n        (0o003, -1, -1, -1),\n        (0o003, 1234567, 8, 0x55),\n    ];\n\n    for &args in cases {\n        let c_out = unsafe { call_jumpnode(&c_lib, args) };\n        let r_out = unsafe { call_jumpnode(&rust_lib, args) };\n        assert_eq!(c_out, r_out, \"mismatch for {:?}: C={} Rust={}\", args, c_out, r_out);\n    }\n}\n\n#[test]\nfn jumpnode_parity_default_branch() {\n    let c_lib = unsafe { Library::new(c_lib_path()) }.expect(\"failed to load C .so\");\n    let rust_lib = unsafe { Library::new(rust_lib_path()) }.expect(\"failed to load Rust .so\");\n\n    for m in [-100, -1, 5, 6, 100, c_int::MAX, c_int::MIN] {\n        let args = (m, 1, 2, 3);\n        let c_out = unsafe { call_jumpnode(&c_lib, args) };\n        let r_out = unsafe { call_jumpnode(&rust_lib, args) };\n        assert_eq!(c_out, r_out, \"default-branch mismatch for mode {m}\");\n    }\n}\n\n#[test]\nfn rust_lib_exports_match_c_lib() {\n    // Ensure jumpnode resolves on both libraries (the parity tests already use\n    // it, but this gives an early failure if the symbol is missing).\n    let c_lib = unsafe { Library::new(c_lib_path()) }.expect(\"failed to load C .so\");\n    let rust_lib = unsafe { Library::new(rust_lib_path()) }.expect(\"failed to load Rust .so\");\n\n    let _: Symbol<JumpnodeFn> = unsafe { c_lib.get(b\"jumpnode\\0\") }.expect(\"C: jumpnode missing\");\n    let _: Symbol<JumpnodeFn> =\n        unsafe { rust_lib.get(b\"jumpnode\\0\") }.expect(\"Rust: jumpnode missing\");\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":142,"cache_read_input_tokens":23617,"cache_creation":{"ephemeral_5m_input_tokens":142,"ephemeral_1h_input_tokens":0},"output_tokens":33,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fbf14eb3-428e-45f9-b8b5-29509656ec4c","uuid":"8c44eed0-1708-4192-bf91-2be36a2269e9"}
