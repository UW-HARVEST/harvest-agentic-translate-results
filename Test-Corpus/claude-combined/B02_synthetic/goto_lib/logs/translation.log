s.\n    let saved_stdout: RawFd = unsafe { libc::dup(1) };\n    let saved_stderr: RawFd = unsafe { libc::dup(2) };\n    assert!(saved_stdout >= 0 && saved_stderr >= 0);\n\n    // Create temp files for capture.\n    let dir = std::env::temp_dir();\n    let stdout_path = dir.join(format!(\"ffi_stdout_{}\", std::process::id()));\n    let stderr_path = dir.join(format!(\"ffi_stderr_{}\", std::process::id()));\n\n    let stdout_file = fs::File::create(&stdout_path).unwrap();\n    let stderr_file = fs::File::create(&stderr_path).unwrap();\n    let stdout_fd = stdout_file.into_raw_fd();\n    let stderr_fd = stderr_file.into_raw_fd();\n\n    unsafe {\n        libc::dup2(stdout_fd, 1);\n        libc::dup2(stderr_fd, 2);\n        libc::close(stdout_fd);\n        libc::close(stderr_fd);\n    }\n\n    let ret = f();\n\n    // Flush libc buffers before reading captured files.\n    unsafe {\n        libc::fflush(std::ptr::null_mut());\n    }\n\n    // Restore original fds.\n    unsafe {\n        libc::dup2(saved_stdout, 1);\n        libc::dup2(saved_stderr, 2);\n        libc::close(saved_stdout);\n        libc::close(saved_stderr);\n    }\n\n    let stdout_bytes = fs::read(&stdout_path).unwrap_or_default();\n    let stderr_bytes = fs::read(&stderr_path).unwrap_or_default();\n    let _ = fs::remove_file(&stdout_path);\n    let _ = fs::remove_file(&stderr_path);\n\n    Captured {\n        stdout: stdout_bytes,\n        stderr: stderr_bytes,\n        ret,\n    }\n}\n\nfn load_libs() -> (Library, Library) {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"failed to load C lib\");\n        let rust_lib = Library::new(rust_lib_path()).expect(\"failed to load Rust lib\");\n        (c_lib, rust_lib)\n    }\n}\n\n#[test]\nfn forward_goto_example_matches() {\n    let (c_lib, rust_lib) = load_libs();\n    let c_fn: Symbol<ForwardGotoFn> =\n        unsafe { c_lib.get(b\"forward_goto_example\").unwrap() };\n    let rust_fn: Symbol<ForwardGotoFn> =\n        unsafe { rust_lib.get(b\"forward_goto_example\").unwrap() };\n\n    for &x in &[-100, -1, 0, 1, 5, 42, 1000] {\n        let c_cap = capture(|| unsafe { c_fn(x) });\n        let r_cap = capture(|| unsafe { rust_fn(x) });\n        assert_eq!(c_cap.ret, r_cap.ret, \"ret mismatch for x={}\", x);\n        assert_eq!(c_cap.stdout, r_cap.stdout, \"stdout mismatch for x={}\", x);\n        assert_eq!(c_cap.stderr, r_cap.stderr, \"stderr mismatch for x={}\", x);\n    }\n}\n\n#[test]\nfn open_with_cleanup_existing_file() {\n    let (c_lib, rust_lib) = load_libs();\n    let c_fn: Symbol<OpenWithCleanupFn> =\n        unsafe { c_lib.get(b\"open_with_cleanup\").unwrap() };\n    let rust_fn: Symbol<OpenWithCleanupFn> =\n        unsafe { rust_lib.get(b\"open_with_cleanup\").unwrap() };\n\n    // Create a file with multiple lines.\n    let path = std::env::temp_dir().join(format!(\"ffi_test_open_{}.txt\", std::process::id()));\n    fs::write(&path, \"Hello world\\nLine two\\nLast line without newline\").unwrap();\n    let cstr = CString::new(path.to_str().unwrap()).unwrap();\n\n    let c_cap = capture(|| unsafe {\n        let fp = c_fn(cstr.as_ptr());\n        let r = if fp.is_null() { 0 } else { 1 };\n        if !fp.is_null() {\n            libc::fclose(fp);\n        }\n        r\n    });\n    let r_cap = capture(|| unsafe {\n        let fp = rust_fn(cstr.as_ptr());\n        let r = if fp.is_null() { 0 } else { 1 };\n        if !fp.is_null() {\n            libc::fclose(fp);\n        }\n        r\n    });\n\n    let _ = fs::remove_file(&path);\n\n    assert_eq!(c_cap.ret, r_cap.ret, \"ret mismatch\");\n    assert_eq!(c_cap.stdout, r_cap.stdout, \"stdout mismatch\");\n    assert_eq!(c_cap.stderr, r_cap.stderr, \"stderr mismatch\");\n}\n\n#[test]\nfn open_with_cleanup_missing_file() {\n    let (c_lib, rust_lib) = load_libs();\n    let c_fn: Symbol<OpenWithCleanupFn> =\n        unsafe { c_lib.get(b\"open_with_cleanup\").unwrap() };\n    let rust_fn: Symbol<OpenWithCleanupFn> =\n        unsafe { rust_