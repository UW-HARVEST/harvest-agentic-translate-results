ib) = load_libs();\n    let c_fn: Symbol<DriverFn> = unsafe { c_lib.get(b\"driver\").unwrap() };\n    let rust_fn: Symbol<DriverFn> = unsafe { rust_lib.get(b\"driver\").unwrap() };\n\n    let cstr = CString::new(\"/tmp/whatever.txt\").unwrap();\n    let c_cap = capture(|| unsafe { c_fn(-5, cstr.as_ptr()) });\n    let r_cap = capture(|| unsafe { rust_fn(-5, cstr.as_ptr()) });\n\n    assert_eq!(c_cap.ret, r_cap.ret);\n    assert_eq!(c_cap.stdout, r_cap.stdout);\n    assert_eq!(c_cap.stderr, r_cap.stderr);\n}\n\n#[test]\nfn driver_missing_file() {\n    let (c_lib, rust_lib) = load_libs();\n    let c_fn: Symbol<DriverFn> = unsafe { c_lib.get(b\"driver\").unwrap() };\n    let rust_fn: Symbol<DriverFn> = unsafe { rust_lib.get(b\"driver\").unwrap() };\n\n    let cstr = CString::new(\"/tmp/zzz_this_file_definitely_does_not_exist_xyz.txt\").unwrap();\n    let c_cap = capture(|| unsafe { c_fn(7, cstr.as_ptr()) });\n    let r_cap = capture(|| unsafe { rust_fn(7, cstr.as_ptr()) });\n\n    assert_eq!(c_cap.ret, r_cap.ret);\n    assert_eq!(c_cap.stdout, r_cap.stdout);\n    assert_eq!(c_cap.stderr, r_cap.stderr);\n}\n\n#[test]\nfn driver_existing_file() {\n    let (c_lib, rust_lib) = load_libs();\n    let c_fn: Symbol<DriverFn> = unsafe { c_lib.get(b\"driver\").unwrap() };\n    let rust_fn: Symbol<DriverFn> = unsafe { rust_lib.get(b\"driver\").unwrap() };\n\n    let path =\n        std::env::temp_dir().join(format!(\"ffi_test_driver_{}.txt\", std::process::id()));\n    fs::write(&path, \"alpha\\nbeta\\ngamma\\n\").unwrap();\n    let cstr = CString::new(path.to_str().unwrap()).unwrap();\n\n    let c_cap = capture(|| unsafe { c_fn(3, cstr.as_ptr()) });\n    let r_cap = capture(|| unsafe { rust_fn(3, cstr.as_ptr()) });\n\n    let _ = fs::remove_file(&path);\n\n    assert_eq!(c_cap.ret, r_cap.ret);\n    assert_eq!(c_cap.stdout, r_cap.stdout);\n    assert_eq!(c_cap.stderr, r_cap.stderr);\n}\n\n#[test]\nfn driver_zero_input() {\n    let (c_lib, rust_lib) = load_libs();\n    let c_fn: Sy