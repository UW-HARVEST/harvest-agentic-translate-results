{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_r6ohjryckaohh5yokixd3wyshi7wen7y7oex4gp3k7562merz44q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01FcTxAqB8eT948Gw2v3ZwVW","name":"Write","input":{"file_path":"/tmp/harvest-translate-yecg77/translated_rust/tests/ffi_compare.rs","content":"// Integration tests that load both the C shared library and the Rust shared\n// library through libloading and confirm their FFI-exposed functions behave\n// byte-identically.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int};\nuse std::io::Read;\nuse std::os::unix::io::RawFd;\nuse std::path::PathBuf;\nuse std::sync::Mutex;\n\n// Stdout capture is global; serialize tests that share it.\nstatic CAPTURE_LOCK: Mutex<()> = Mutex::new(());\n\nfn c_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src/build/libtranslated_rust.so\");\n    p\n}\n\nfn rust_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target/release/libtranslated_rust.so\");\n    p\n}\n\nfn load_libs() -> (Library, Library) {\n    unsafe {\n        let c = Library::new(c_lib_path()).expect(\"failed to load C .so\");\n        let r = Library::new(rust_lib_path()).expect(\"failed to load Rust .so\");\n        (c, r)\n    }\n}\n\n/// Captures everything written to stdout (file descriptor 1) while `f` runs,\n/// returning the captured bytes. `fflush(NULL)` is invoked before and after\n/// to make sure stdio buffers are drained.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    unsafe {\n        // Make sure any existing buffered output is drained first.\n        libc::fflush(std::ptr::null_mut());\n\n        let saved_stdout: RawFd = libc::dup(1);\n        assert!(saved_stdout >= 0, \"dup(1) failed\");\n\n        let mut fds: [RawFd; 2] = [0; 2];\n        let rc = libc::pipe(fds.as_mut_ptr());\n        assert_eq!(rc, 0, \"pipe() failed\");\n        let read_fd = fds[0];\n        let write_fd = fds[1];\n\n        // Redirect stdout to the write end of the pipe.\n        let rc = libc::dup2(write_fd, 1);\n        assert!(rc >= 0, \"dup2 to stdout failed\");\n        libc::close(write_fd);\n\n        // Run the callee.\n        f();\n\n        // Flush before restoring.\n        libc::fflush(std::ptr::null_mut());\n\n        // Restore stdout.\n        libc::dup2(saved_stdout, 1);\n        libc::close(saved_stdout);\n\n        // Read whatever the pipe collected.\n        let mut buf = Vec::new();\n        let mut file = std::fs::File::from(std::os::fd::OwnedFd::from_raw_fd(read_fd));\n        let _ = file.read_to_end(&mut buf);\n        buf\n    }\n}\n\nuse std::os::fd::FromRawFd;\n\nfn call_charinbuf(lib: &Library, mode: c_int, value: c_int, opt1: c_int, opt2: c_int) -> (c_int, Vec<u8>) {\n    let _guard = CAPTURE_LOCK.lock().unwrap();\n    unsafe {\n        let f: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =\n            lib.get(b\"charinbuf\").expect(\"charinbuf symbol missing\");\n        let mut result: c_int = 0;\n        let captured = capture_stdout(|| {\n            result = f(mode, value, opt1, opt2);\n        });\n        (result, captured)\n    }\n}\n\n#[test]\nfn symbols_match() {\n    // Every symbol exported by the C library must also be exported by the\n    // Rust library so that consumers can transparently swap implementations.\n    let names: &[&[u8]] = &[\n        b\"increment_counter\",\n        b\"decrement_counter\",\n        b\"multiply_counter\",\n        b\"reset_counter\",\n        b\"is_string_empty\",\n        b\"find_char_in_buffer\",\n        b\"create_buffer\",\n        b\"validate_uint16_range\",\n        b\"apply_operation\",\n        b\"charinbuf\",\n    ];\n    let (c, r) = load_libs();\n    for name in names {\n        unsafe {\n            let _: Symbol<unsafe extern \"C\" fn()> =\n                c.get(name).unwrap_or_else(|_| panic!(\"C missing {:?}\", name));\n            let _: Symbol<unsafe extern \"C\" fn()> =\n                r.get(name).unwrap_or_else(|_| panic!(\"Rust missing {:?}\", name));\n        }\n    }\n}\n\n#[test]\nfn counter_funcs_match() {\n    let (c, r) = load_libs();\n    unsafe {\n        type FnI = unsafe extern \"C\" fn(c_int) -> c_int;\n        let pairs: &[&[u8]] = &[\n            b\"reset_counter\",\n            b\"increment_counter\",\n            b\"decrement_counter\",\n            b\"multiply_counter\",\n        ];\n        // Reset both before any test.\n        let c_reset: Symbol<FnI> = c.get(b\"reset_counter\").unwrap();\n        let r_reset: Symbol<FnI> = r.get(b\"reset_counter\").unwrap();\n        assert_eq!(c_reset(0), r_reset(0));\n\n        for name in pairs {\n            let cf: Symbol<FnI> = c.get(name).unwrap();\n            let rf: Symbol<FnI> = r.get(name).unwrap();\n            for v in [0, 1, -1, 5, -5, 100, i32::MAX / 2, i32::MIN / 2] {\n                // Re-zero the counter on each library before applying the op\n                // so they stay in sync regardless of which library is called.\n                c_reset(0);\n                r_reset(0);\n                let cr = cf(v);\n                let rr = rf(v);\n                assert_eq!(cr, rr, \"fn={:?} v={}\", std::str::from_utf8(name).unwrap(), v);\n            }\n        }\n    }\n}\n\n#[test]\nfn is_string_empty_matches() {\n    let (c, r) = load_libs();\n    unsafe {\n        type Fn1 = unsafe extern \"C\" fn(*const c_char) -> c_int;\n        let cf: Symbol<Fn1> = c.get(b\"is_string_empty\").unwrap();\n        let rf: Symbol<Fn1> = r.get(b\"is_string_empty\").unwrap();\n\n        let null = std::ptr::null::<c_char>();\n        assert_eq!(cf(null), rf(null));\n\n        let empty = b\"\\0\".as_ptr() as *const c_char;\n        assert_eq!(cf(empty), rf(empty));\n\n        let nonempty = b\"hello\\0\".as_ptr() as *const c_char;\n        assert_eq!(cf(nonempty), rf(nonempty));\n    }\n}\n\n#[test]\nfn validate_uint16_range_matches() {\n    let (c, r) = load_libs();\n    unsafe {\n        type FnI = unsafe extern \"C\" fn(c_int) -> c_int;\n        let cf: Symbol<FnI> = c.get(b\"validate_uint16_range\").unwrap();\n        let rf: Symbol<FnI> = r.get(b\"validate_uint16_range\").unwrap();\n        for v in [-1, 0, 1, 100, 65535, 65536, 70000, i32::MIN, i32::MAX] {\n            assert_eq!(cf(v), rf(v), \"validate_uint16_range({})\", v);\n        }\n    }\n}\n\n#[test]\nfn create_buffer_matches() {\n    let (c, r) = load_libs();\n    unsafe {\n        type FnB = unsafe extern \"C\" fn(*const c_char) -> *mut c_char;\n        type FnFree = unsafe extern \"C\" fn(*mut c_char);\n\n        let cf: Symbol<FnB> = c.get(b\"create_buffer\").unwrap();\n        let rf: Symbol<FnB> = r.get(b\"create_buffer\").unwrap();\n\n        // null in -> null out\n        let cb = cf(std::ptr::null());\n        let rb = rf(std::ptr::null());\n        assert!(cb.is_null() && rb.is_null());\n\n        // copy a string and confirm both buffers contain identical bytes\n        let s = b\"hello world\\0\".as_ptr() as *const c_char;\n        let cb = cf(s);\n        let rb = rf(s);\n        assert!(!cb.is_null() && !rb.is_null());\n        assert_eq!(libc::strcmp(cb, rb), 0);\n        assert_eq!(libc::strlen(cb), libc::strlen(rb));\n\n        libc::free(cb as *mut libc::c_void);\n        libc::free(rb as *mut libc::c_void);\n        let _ = std::mem::transmute::<&Symbol<FnB>, &Symbol<FnFree>>(&cf);\n    }\n}\n\n#[test]\nfn find_char_in_buffer_matches() {\n    let (c, r) = load_libs();\n    unsafe {\n        type FnFc = unsafe extern \"C\" fn(*const c_char, libc::size_t, c_char) -> *mut c_char;\n        let cf: Symbol<FnFc> = c.get(b\"find_char_in_buffer\").unwrap();\n        let rf: Symbol<FnFc> = r.get(b\"find_char_in_buffer\").unwrap();\n\n        let buf = b\"hello world\\0\";\n        let p = buf.as_ptr() as *const c_char;\n        for ch in [b'h', b'o', b'z', b' ', b'd'] {\n            let cr = cf(p, 11, ch as c_char);\n            let rr = rf(p, 11, ch as c_char);\n            // Compare offsets (positions) not absolute pointer values.\n            let coff = if cr.is_null() { -1 } else { cr.offset_from(p) };\n            let roff = if rr.is_null() { -1 } else { rr.offset_from(p) };\n            assert_eq!(coff, roff, \"char={}\", ch as char);\n        }\n\n        let cr = cf(std::ptr::null(), 5, b'a' as c_char);\n        let rr = rf(std::ptr::null(), 5, b'a' as c_char);\n        assert!(cr.is_null() && rr.is_null());\n    }\n}\n\n#[test]\nfn apply_operation_matches() {\n    let (c, r) = load_libs();\n    unsafe {\n        type FnI = unsafe extern \"C\" fn(c_int) -> c_int;\n        type FnApply =\n            unsafe extern \"C\" fn(Option<unsafe extern \"C\" fn(c_int) -> c_int>, c_int) -> c_int;\n\n        let c_apply: Symbol<FnApply> = c.get(b\"apply_operation\").unwrap();\n        let r_apply: Symbol<FnApply> = r.get(b\"apply_operation\").unwrap();\n\n        // null op -> -1\n        assert_eq!(c_apply(None, 5), -1);\n        assert_eq!(r_apply(None, 5), -1);\n\n        // Use C reset_counter as the callable; it is a plain extern \"C\" fn.\n        let c_reset: Symbol<FnI> = c.get(b\"reset_counter\").unwrap();\n        let r_reset: Symbol<FnI> = r.get(b\"reset_counter\").unwrap();\n        let c_op: unsafe extern \"C\" fn(c_int) -> c_int = *c_reset;\n        let r_op: unsafe extern \"C\" fn(c_int) -> c_int = *r_reset;\n\n        // Each library reads its own counter, so call apply with same lib's op.\n        assert_eq!(c_apply(Some(c_op), 42), 42);\n        assert_eq!(r_apply(Some(r_op), 42), 42);\n    }\n}\n\n#[test]\nfn charinbuf_modes_match() {\n    let (c, r) = load_libs();\n\n    let cases: &[(c_int, c_int, c_int, c_int)] = &[\n        // Mode 0 - validate_uint16_range\n        (0, -1, 0, 0),\n        (0, 0, 0, 0),\n        (0, 32768, 0, 0),\n        (0, 65535, 0, 0),\n        (0, 65536, 0, 0),\n        // Mode 1 - is_string_empty checks\n        (1, 0, 0, 0),\n        // Mode 2 - malloc/free of a fixed string\n        (2, 0, 0, 0),\n        // Mode 3 - function pointer counter\n        (3, 0, 1, 2),\n        (3, 10, 5, 3),\n        (3, -7, 4, -2),\n        // Mode 4 - memchr\n        (4, 0, 0, 0),\n        // Default\n        (5, 0, 0, 0),\n        (-1, 0, 0, 0),\n    ];\n\n    for (mode, value, opt1, opt2) in cases.iter().copied() {\n        let (cret, cout) = call_charinbuf(&c, mode, value, opt1, opt2);\n        let (rret, rout) = call_charinbuf(&r, mode, value, opt1, opt2);\n        assert_eq!(\n            cret, rret,\n            \"return mismatch mode={} value={} opt1={} opt2={}\",\n            mode, value, opt1, opt2\n        );\n        assert_eq!(\n            cout, rout,\n            \"stdout mismatch mode={} value={} opt1={} opt2={}\\nC: {}\\nR: {}\",\n            mode,\n            value,\n            opt1,\n            opt2,\n            String::from_utf8_lossy(&cout),\n            String::from_utf8_lossy(&rout)\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":235,"cache_read_input_tokens":25527,"cache_creation":{"ephemeral_5m_input_tokens":235,"ephemeral_1h_input_tokens":0},"output_tokens":31,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"5bb09ace-fa59-44ac-bc53-8939be21e04c","uuid":"b976bf41-053b-45b7-8f70-ef1c9a94257b"}
