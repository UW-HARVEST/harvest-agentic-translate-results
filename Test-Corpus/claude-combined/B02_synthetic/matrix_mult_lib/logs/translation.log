int)] = &[\n            (\"1 2\\n3 4\\n\", 2, 2, \"5 6\\n7 8\\n\", 2, 2),\n            (\"1 2 3\\n4 5 6\\n\", 3, 2, \"7 8\\n9 10\\n11 12\\n\", 2, 3),\n            (\"1\\n\", 1, 1, \"5\\n\", 1, 1),\n            (\"1 2 3\\n\", 3, 1, \"1\\n2\\n3\\n\", 1, 3),\n            (\"0 0\\n0 0\\n\", 2, 2, \"1 2\\n3 4\\n\", 2, 2),\n        ];\n\n        for (a, wa, ha, b, wb, hb) in cases {\n            let c_a = CString::new(*a).unwrap();\n            let c_b = CString::new(*b).unwrap();\n\n            let c_ma = c_init(c_a.as_ptr(), *wa, *ha);\n            let c_mb = c_init(c_b.as_ptr(), *wb, *hb);\n            let r_ma = r_init(c_a.as_ptr(), *wa, *ha);\n            let r_mb = r_init(c_b.as_ptr(), *wb, *hb);\n\n            let c_res = c_mul(c_ma, c_mb);\n            let r_res = r_mul(r_ma, r_mb);\n            assert!(!c_res.is_null());\n            assert!(!r_res.is_null());\n\n            assert_eq!(matrix_to_vec(c_res), matrix_to_vec(r_res));\n\n            c_free(c_ma); c_free(c_mb); c_free(c_res);\n            r_free(r_ma); r_free(r_mb); r_free(r_res);\n        }\n    }\n}\n\n#[test]\nfn test_matrix_to_string() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load c lib\");\n        let r_lib = Library::new(rust_lib_path()).expect(\"load rust lib\");\n\n        let c_init: Symbol<InitFromStringFn> =\n            c_lib.get(b\"initialize_matrix_from_string\").unwrap();\n        let r_init: Symbol<InitFromStringFn> =\n            r_lib.get(b\"initialize_matrix_from_string\").unwrap();\n        let c_to_s: Symbol<ToStringFn> = c_lib.get(b\"matrix_to_string\").unwrap();\n        let r_to_s: Symbol<ToStringFn> = r_lib.get(b\"matrix_to_string\").unwrap();\n        let c_free: Symbol<FreeMatrixFn> = c_lib.get(b\"free_matrix\").unwrap();\n        let r_free: Symbol<FreeMatrixFn> = r_lib.get(b\"free_matrix\").unwrap();\n\n        let cases = [\n            (\"1 2 3\\n4 5 6\\n\", 3, 2),\n            (\"0\\n\", 1, 1),\n            (\"-1 -2\\n-3 -4\\n\", 2, 2),\n            (\"100 200 300\\n\", 3, 1),\n        ];\n\n        for (s, w, h) in cases {\n            let c_s = CString::new(s).unwrap();\n            let c_mat = c_init(c_s.as_ptr(), w, h);\n            let r_mat = r_init(c_s.as_ptr(), w, h);\n\n            let c_str = c_to_s(c_mat);\n            let r_str = r_to_s(r_mat);\n            assert!(!c_str.is_null());\n            assert!(!r_str.is_null());\n\n            let cb = cstr_to_bytes(c_str);\n            let rb = cstr_to_bytes(r_str);\n            assert_eq!(cb, rb, \"to_string mismatch for input {:?}\", s);\n\n            free(c_str as *mut std::ffi::c_void);\n            free(r_str as *mut std::ffi::c_void);\n            c_free(c_mat);\n            r_free(r_mat);\n        }\n\n        // Null input case\n        assert!(c_to_s(ptr::null_mut()).is_null());\n        assert!(r_to_s(ptr::null_mut()).is_null());\n    }\n}\n\n#[test]\nfn test_write_to_file() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load c lib\");\n        let r_lib = Library::new(rust_lib_path()).expect(\"load rust lib\");\n\n        let c_w: Symbol<WriteToFileFn> = c_lib.get(b\"write_to_file\").unwrap();\n        let r_w: Symbol<WriteToFileFn> = r_lib.get(b\"write_to_file\").unwrap();\n\n        let dir = std::env::temp_dir();\n        let c_path = dir.join(\"c_write_test.txt\");\n        let r_path = dir.join(\"r_write_test.txt\");\n\n        let c_path_c = CString::new(c_path.to_str().unwrap()).unwrap();\n        let r_path_c = CString::new(r_path.to_str().unwrap()).unwrap();\n        let content = CString::new(\"hello world\\nline 2\\n123 456\\n\").unwrap();\n\n        let cr = c_w(c_path_c.as_ptr(), content.as_ptr());\n        let rr = r_w(r_path_c.as_ptr(), content.as_ptr());\n        assert_eq!(cr, 0);\n        assert_eq!(rr, 0);\n\n        let c_data = std::fs::read(&c_path).unwrap();\n        let r_data = std::fs::read(&r_path).unwrap();\n        assert_eq!(c_data, r_data);\n\n        let _ = std::fs::remove_file(&c_path);\n        let _ = std::fs::remove_file(&r_path);\n\n        // null content\n        let cr = c_w(c_path_c.as_ptr(), ptr::null());\n        let rr = r_w(r_path_c.as_ptr(), ptr::null());\n        assert_eq!(cr, rr);\n        assert_ne!(cr, 0); // EINVAL\n\n        // failed open (dir that doesn't exist)\n        let bad = CString::new(\"/this/path/should/not/exist/file.txt\").unwrap();\n        let cr = c_w(bad.as_ptr(), content.as_ptr());\n        let rr = r_w(bad.as_ptr(), content.as_ptr());\n        assert_eq!(cr, rr);\n        assert_ne!(cr, 0);\n    }\n}\n\n#[test]\nfn test_driver_end_to_end() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load c lib\");\n        let r_lib = Library::new(rust_lib_path()).expect(\"load rust lib\");\n\n        let c_drv: Symbol<DriverFn> = c_lib.get(b\"driver\").unwrap();\n        let r_drv: Symbol<DriverFn> = r_lib.get(b\"driver\").unwrap();\n\n        // The driver writes to \"matrix.txt\" in CWD. We need to compare bytes\n        // of the output file. Run each in a temp directory.\n        let base = std::env::temp_dir().join(format!(\n            \"driver_test_{}\",\n            std::process::id()\n        ));\n        let c_dir = base.join(\"c\");\n        let r_dir = base.join(\"r\");\n        std::fs::create_dir_all(&c_dir).unwrap();\n        std::fs::create_dir_all(&r_dir).unwrap();\n\n        let a = CString::new(\"1 2 3\\n4 5 6\\n\").unwrap();\n        let b = CString::new(\"7 8\\n9 10\\n11 12\\n\").unwrap();\n\n        let cwd = std::env::current_dir().unwrap();\n\n        std::env::set_current_dir(&c_dir).unwrap();\n        let cr = c_drv(3, 2, a.as_ptr(), 2, 3, b.as_ptr());\n        std::env::set_current_dir(&cwd).unwrap();\n\n        std::env::set_current_dir(&r_dir).unwrap();\n        let rr = r_drv(3, 2, a.as_ptr(), 2, 3, b.as_ptr());\n        std::env::set_current_dir(&cwd).unwrap();\n\n        assert_eq!(cr, rr);\n        assert_eq!(cr, 0);\n\n        let c_out = std::fs::read(c_dir.join(\"matrix.txt\")).unwrap();\n        let r_out = std::fs::read(r_dir.join(\"matrix.txt\")).unwrap();\n        assert_eq!(c_out, r_out);\n\n        let _ = std::fs::remove_dir_all(&base);\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
