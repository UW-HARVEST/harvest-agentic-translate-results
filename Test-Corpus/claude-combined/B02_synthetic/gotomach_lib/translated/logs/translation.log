{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_ltzlsl5xewq4d6xfaui5e4vjtwtjc23fju4hlqizl3qndevzffya","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Ncwc4Bu4Wqs9FRB88K2SpU","name":"Write","input":{"file_path":"/tmp/harvest-translate-ima993/translated_rust/tests/ffi_compare.rs","content":"// FFI tests that compare the Rust .so output against the C .so output for\n// every public symbol. The Rust side is loaded via libloading (never called\n// directly) so we exercise the same boundary an external user would.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_int;\nuse std::os::raw::c_void;\nuse std::path::PathBuf;\n\ntype LeafFn = unsafe extern \"C\" fn(c_int, c_int, *mut c_void) -> c_int;\ntype GotomachFn = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n\nfn workspace_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    workspace_root().join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    // The integration test target is built before being run, but we need the\n    // cdylib output. Cargo places it under target/<profile>/.\n    let mut p = workspace_root().join(\"target\");\n    // Tests run against either debug or release. We always know the cdylib was\n    // built; pick whichever exists. Prefer debug since `cargo test` produces\n    // that automatically.\n    let debug = p.join(\"debug\").join(\"libtranslated_rust.so\");\n    if debug.exists() {\n        return debug;\n    }\n    p.push(\"release\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nunsafe fn load_libs() -> (Library, Library) {\n    // Make sure both are built before tests run. In CI we expect the user to\n    // have run `cargo build` and `cmake --build` already.\n    let c = Library::new(c_lib_path()).expect(\"failed to load C .so – did you run cmake --build?\");\n    let r = Library::new(rust_lib_path()).expect(\"failed to load Rust .so – did you run cargo build?\");\n    (c, r)\n}\n\nunsafe fn get_leaf<'a>(lib: &'a Library, name: &[u8]) -> Symbol<'a, LeafFn> {\n    lib.get(name).expect(\"missing symbol\")\n}\n\nunsafe fn get_gotomach<'a>(lib: &'a Library) -> Symbol<'a, GotomachFn> {\n    lib.get(b\"gotomach\").expect(\"missing gotomach\")\n}\n\n#[test]\nfn process_value_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let cf = get_leaf(&c, b\"process_value\");\n        let rf = get_leaf(&r, b\"process_value\");\n        for v in [-100, -1, 0, 1, 5, 100, 65535, i32::MAX - 100, i32::MIN + 100] {\n            let cv = cf(v, 0, std::ptr::null_mut());\n            let rv = rf(v, 0, std::ptr::null_mut());\n            assert_eq!(cv, rv, \"process_value({v}) mismatch\");\n        }\n    }\n}\n\n#[test]\nfn double_value_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let cf = get_leaf(&c, b\"double_value\");\n        let rf = get_leaf(&r, b\"double_value\");\n        for v in [-50, -1, 0, 1, 7, 1000, 32767, -32768] {\n            let cv = cf(v, 0, std::ptr::null_mut());\n            let rv = rf(v, 0, std::ptr::null_mut());\n            assert_eq!(cv, rv, \"double_value({v}) mismatch\");\n        }\n    }\n}\n\n#[test]\nfn triple_value_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let cf = get_leaf(&c, b\"triple_value\");\n        let rf = get_leaf(&r, b\"triple_value\");\n        for v in [-50, -1, 0, 1, 7, 1000, 32767, -32768] {\n            let cv = cf(v, 0, std::ptr::null_mut());\n            let rv = rf(v, 0, std::ptr::null_mut());\n            assert_eq!(cv, rv, \"triple_value({v}) mismatch\");\n        }\n    }\n}\n\n#[test]\nfn gotomach_error_paths() {\n    unsafe {\n        let (c, r) = load_libs();\n        let cg = get_gotomach(&c);\n        let rg = get_gotomach(&r);\n\n        // iterations < 0 => -1\n        assert_eq!(cg(-1, 0, 0, 0), rg(-1, 0, 0, 0));\n        // iterations > UINT16_MAX => -1\n        assert_eq!(cg(70000, 0, 0, 0), rg(70000, 0, 0, 0));\n        // seed < 0 => -2\n        assert_eq!(cg(10, -1, 0, 0), rg(10, -1, 0, 0));\n        // seed > UINT16_MAX => -2\n        assert_eq!(cg(10, 70000, 0, 0), rg(10, 70000, 0, 0));\n    }\n}\n\n#[test]\nfn gotomach_basic_modes() {\n    unsafe {\n        let (c, r) = load_libs();\n        let cg = get_gotomach(&c);\n        let rg = get_gotomach(&r);\n\n        let cases = [\n            (10, 1, 0, 1000),\n            (10, 1, 1, 1000),\n            (10, 1, 2, 1000),\n            (10, 1, 99, 1000), // default branch\n            (0, 0, 0, 1000),    // 0 iterations\n            (1, 5, 1, 100),\n            (50, 7, 2, 50),     // threshold filtering\n            (50, 7, 2, -1000),  // nothing makes it past threshold\n            (100, 13, 0, 200),\n            (1000, 1, 1, 500),\n            (65535, 1, 1, 0),   // very large iteration count, no items pass threshold\n        ];\n\n        for (it, seed, mode, threshold) in cases {\n            let cv = cg(it, seed, mode, threshold);\n            let rv = rg(it, seed, mode, threshold);\n            assert_eq!(\n                cv, rv,\n                \"gotomach({it},{seed},{mode},{threshold}): C={cv} Rust={rv}\"\n            );\n        }\n    }\n}\n\n#[test]\nfn gotomach_thresholds_sweep() {\n    unsafe {\n        let (c, r) = load_libs();\n        let cg = get_gotomach(&c);\n        let rg = get_gotomach(&r);\n\n        for mode in 0..=3 {\n            for seed in [0, 1, 2, 999, 65535] {\n                for threshold in [-100, 0, 5, 100, 1000, i32::MAX] {\n                    let cv = cg(20, seed, mode, threshold);\n                    let rv = rg(20, seed, mode, threshold);\n                    assert_eq!(\n                        cv, rv,\n                        \"gotomach(20,{seed},{mode},{threshold}): C={cv} Rust={rv}\"\n                    );\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn exported_symbols_match() {\n    use std::process::Command;\n    let c_path = c_lib_path();\n    let r_path = rust_lib_path();\n\n    let extract = |path: &PathBuf| -> Vec<String> {\n        let out = Command::new(\"nm\")\n            .args([\"-D\", \"--defined-only\"])\n            .arg(path)\n            .output()\n            .expect(\"nm\");\n        let s = String::from_utf8(out.stdout).unwrap();\n        let mut syms: Vec<String> = s\n            .lines()\n            .filter_map(|l| {\n                // format: \"<addr> <type> <name>\"\n                let mut parts = l.split_whitespace();\n                let _addr = parts.next()?;\n                let kind = parts.next()?;\n                let name = parts.next()?;\n                if kind == \"T\" {\n                    Some(name.to_string())\n                } else {\n                    None\n                }\n            })\n            .filter(|n| {\n                // Ignore standard ELF init/fini symbols which the C version\n                // exports but Rust does not.\n                !matches!(n.as_str(), \"_init\" | \"_fini\")\n            })\n            .collect();\n        syms.sort();\n        syms\n    };\n\n    let c_syms = extract(&c_path);\n    let r_syms = extract(&r_path);\n\n    for s in &c_syms {\n        assert!(\n            r_syms.contains(s),\n            \"Rust .so missing symbol {s}; rust syms = {:?}\",\n            r_syms\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":162,"cache_read_input_tokens":23892,"cache_creation":{"ephemeral_5m_input_tokens":162,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"7cf0a6d9-8e8b-4d03-ae34-c28737bb4dd2","uuid":"bd23b505-cf1b-4477-b503-9faebe14dcda"}
