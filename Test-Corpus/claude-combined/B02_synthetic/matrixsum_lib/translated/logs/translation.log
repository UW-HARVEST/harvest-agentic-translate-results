{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_mkeg5empt4erh4midvm6o42kn2sisy3dvsrbeqtijl3oh2opug5a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_0173HmqDsnViVB7YnWWDemcH","name":"Write","input":{"file_path":"/tmp/harvest-translate-ZDiHtD/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::os::raw::{c_int, c_void};\n\n#[repr(C)]\nstruct DynamicArray {\n    data: *mut c_int,\n    size: usize,\n    capacity: usize,\n}\n\nfn c_lib_path() -> &'static str {\n    \"c_src/build/libtranslated_rust.so\"\n}\n\nfn rust_lib_path() -> &'static str {\n    \"target/release/libtranslated_rust.so\"\n}\n\nfn load_libs() -> (Library, Library) {\n    unsafe {\n        let c = Library::new(c_lib_path()).expect(\"failed to load C lib\");\n        let r = Library::new(rust_lib_path()).expect(\"failed to load Rust lib\");\n        (c, r)\n    }\n}\n\n#[test]\nfn test_process_flags() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> =\n            c.get(b\"process_flags\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> =\n            r.get(b\"process_flags\").unwrap();\n\n        for flags in 0..32 {\n            assert_eq!(c_fn(flags), r_fn(flags), \"flags={}\", flags);\n        }\n        // Edge cases: negative values and high bits\n        for flags in &[-1, 0x7FFFFFFF, 0x12345, 0xFF, 0xF0] {\n            assert_eq!(c_fn(*flags), r_fn(*flags), \"flags={}\", flags);\n        }\n    }\n}\n\n#[test]\nfn test_calculate_matrix_checksum() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn() -> c_int> =\n            c.get(b\"calculate_matrix_checksum\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn() -> c_int> =\n            r.get(b\"calculate_matrix_checksum\").unwrap();\n\n        assert_eq!(c_fn(), r_fn());\n    }\n}\n\n#[test]\nfn test_matrix_global_layout() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_mat: Symbol<*mut [[c_int; 4]; 3]> = c.get(b\"matrix\").unwrap();\n        let r_mat: Symbol<*mut [[c_int; 4]; 3]> = r.get(b\"matrix\").unwrap();\n        let c_ref = &**c_mat;\n        let r_ref = &**r_mat;\n        assert_eq!(c_ref, r_ref);\n    }\n}\n\n#[test]\nfn test_init_array_and_free() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_init: Symbol<unsafe extern \"C\" fn(usize) -> *mut DynamicArray> =\n            c.get(b\"init_array\").unwrap();\n        let r_init: Symbol<unsafe extern \"C\" fn(usize) -> *mut DynamicArray> =\n            r.get(b\"init_array\").unwrap();\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut DynamicArray)> =\n            c.get(b\"free_array\").unwrap();\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut DynamicArray)> =\n            r.get(b\"free_array\").unwrap();\n\n        for cap in &[1usize, 2, 4, 8, 16] {\n            let c_arr = c_init(*cap);\n            let r_arr = r_init(*cap);\n            assert!(!c_arr.is_null());\n            assert!(!r_arr.is_null());\n            assert_eq!((*c_arr).size, (*r_arr).size);\n            assert_eq!((*c_arr).capacity, (*r_arr).capacity);\n            c_free(c_arr);\n            r_free(r_arr);\n        }\n\n        // free_array NULL should be safe\n        c_free(std::ptr::null_mut());\n        r_free(std::ptr::null_mut());\n    }\n}\n\n#[test]\nfn test_add_element_and_expand() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_init: Symbol<unsafe extern \"C\" fn(usize) -> *mut DynamicArray> =\n            c.get(b\"init_array\").unwrap();\n        let r_init: Symbol<unsafe extern \"C\" fn(usize) -> *mut DynamicArray> =\n            r.get(b\"init_array\").unwrap();\n        let c_add: Symbol<unsafe extern \"C\" fn(*mut DynamicArray, c_int) -> c_int> =\n            c.get(b\"add_element\").unwrap();\n        let r_add: Symbol<unsafe extern \"C\" fn(*mut DynamicArray, c_int) -> c_int> =\n            r.get(b\"add_element\").unwrap();\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut DynamicArray)> =\n            c.get(b\"free_array\").unwrap();\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut DynamicArray)> =\n            r.get(b\"free_array\").unwrap();\n\n        let c_arr = c_init(2);\n        let r_arr = r_init(2);\n\n        for v in 0..20i32 {\n            let c_ret = c_add(c_arr, v);\n            let r_ret = r_add(r_arr, v);\n            assert_eq!(c_ret, r_ret);\n            assert_eq!((*c_arr).size, (*r_arr).size);\n            assert_eq!((*c_arr).capacity, (*r_arr).capacity);\n\n            // compare data contents\n            let n = (*c_arr).size;\n            for i in 0..n {\n                let cv = *(*c_arr).data.add(i);\n                let rv = *(*r_arr).data.add(i);\n                assert_eq!(cv, rv, \"i={}\", i);\n            }\n        }\n\n        // null arr returns 0\n        let c_ret = c_add(std::ptr::null_mut(), 5);\n        let r_ret = r_add(std::ptr::null_mut(), 5);\n        assert_eq!(c_ret, r_ret);\n\n        c_free(c_arr);\n        r_free(r_arr);\n    }\n}\n\n#[test]\nfn test_expand_array_null() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut DynamicArray) -> c_int> =\n            c.get(b\"expand_array\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut DynamicArray) -> c_int> =\n            r.get(b\"expand_array\").unwrap();\n        assert_eq!(c_fn(std::ptr::null_mut()), r_fn(std::ptr::null_mut()));\n    }\n}\n\n#[test]\nfn test_matrixsum() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =\n            c.get(b\"matrixsum\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =\n            r.get(b\"matrixsum\").unwrap();\n\n        // Combinations of 0/non-zero\n        let vals = [0, 1, 2, 5, 10, -1, -5, 100, 1000];\n        for &a in &vals {\n            for &b in &vals {\n                for &cc in &vals {\n                    for &d in &vals {\n                        let cr = c_fn(a, b, cc, d);\n                        let rr = r_fn(a, b, cc, d);\n                        assert_eq!(\n                            cr, rr,\n                            \"matrixsum({}, {}, {}, {}) C={} Rust={}\",\n                            a, b, cc, d, cr, rr\n                        );\n                    }\n                }\n            }\n        }\n    }\n}\n\n// Suppress unused warning\n#[allow(dead_code)]\nfn _unused(_p: *mut c_void) {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":144,"cache_read_input_tokens":24483,"cache_creation":{"ephemeral_5m_input_tokens":144,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e834b918-fea3-4360-9a0d-99e2b47887f6","uuid":"761de1e1-0835-41bd-925e-407e1cfcee66"}
