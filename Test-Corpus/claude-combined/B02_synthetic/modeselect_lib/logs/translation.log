oad C lib\");\n        let r = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n        (c, r)\n    }\n}\n\n// --- function-pointer typedefs ---\ntype FnClassify = unsafe extern \"C\" fn(*const c_char) -> c_int;\ntype FnApplyMult = unsafe extern \"C\" fn(c_int, c_int) -> c_int;\ntype FnConvTime = unsafe extern \"C\" fn(c_double) -> c_int;\ntype FnConvNeg = unsafe extern \"C\" fn(c_double) -> c_int;\ntype FnGetModTime = unsafe extern \"C\" fn(c_int, c_int) -> time_t;\ntype FnHashTime = unsafe extern \"C\" fn(time_t) -> c_int;\n\n#[test]\nfn classify_mode_matches() {\n    let (c, r) = open_libs();\n    let cf: Symbol<FnClassify> = unsafe { c.get(b\"classify_mode\").unwrap() };\n    let rf: Symbol<FnClassify> = unsafe { r.get(b\"classify_mode\").unwrap() };\n\n    let cases = [\n        \"standard\", \"enhanced\", \"turbo\", \"extreme\", \"\", \"STANDARD\", \"unknown\", \"standar\",\n        \"standardx\",\n    ];\n    for s in cases {\n        let cs = CString::new(s).unwrap();\n        let cv = unsafe { cf(cs.as_ptr()) };\n        let rv = unsafe { rf(cs.as_ptr()) };\n        assert_eq!(cv, rv, \"classify_mode mismatch for {:?}\", s);\n    }\n}\n\n#[test]\nfn apply_multiplier_matches() {\n    let (c, r) = open_libs();\n    let cf: Symbol<FnApplyMult> = unsafe { c.get(b\"apply_multiplier\").unwrap() };\n    let rf: Symbol<FnApplyMult> = unsafe { r.get(b\"apply_multiplier\").unwrap() };\n\n    let bases = [0i32, 1, 0xA0, -5, 1000, i32::MAX - 0x300, i32::MIN + 0x300];\n    let levels = [-1i32, 0, 1, 2, 3, 4, 5, 100];\n    for &b in &bases {\n        for &l in &levels {\n            let cv = unsafe { cf(b, l) };\n            let rv = unsafe { rf(b, l) };\n            assert_eq!(cv, rv, \"apply_multiplier mismatch for ({}, {})\", b, l);\n        }\n    }\n}\n\n#[test]\nfn convert_time_factor_matches() {\n    let (c, r) = open_libs();\n    let cf: Symbol<FnConvTime> = unsafe { c.get(b\"convert_time_factor\").unwrap() };\n    let rf: Symbol<FnConvTime> = unsafe { r.get(b\"convert_time_factor\").unwrap() };\n\n    // Stay in-range for int after *1e12 to avoid C UB / undefined results.\n    let cases = [0.0, 1e-12, -1e-12, 1.5e-12, -2.3e-12, 2.0e-12, -1.999e-12];\n    for &v in &cases {\n        let cv = unsafe { cf(v) };\n        let rv = unsafe { rf(v) };\n        assert_eq!(cv, rv, \"convert_time_factor mismatch for {}\", v);\n    }\n}\n\n#[test]\nfn convert_negative_overflow_matches() {\n    let (c, r) = open_libs();\n    let cf: Symbol<FnConvNeg> = unsafe { c.get(b\"convert_negative_overflow\").unwrap() };\n    let rf: Symbol<FnConvNeg> = unsafe { r.get(b\"convert_negative_overflow\").unwrap() };\n\n    // Stay in-range after *-1e15 so the C result is well-defined.\n    let cases = [0.0, 1e-15, -1e-15, 1.5e-15, -2.0e-15, 1.999e-15];\n    for &v in &cases {\n        let cv = unsafe { cf(v) };\n        let rv = unsafe { rf(v) };\n        assert_eq!(cv, rv, \"convert_negative_overflow mismatch for {}\", v);\n    }\n}\n\n#[test]\nfn get_modified_time_matches() {\n    let (c, r) = open_libs();\n    let cf: Symbol<FnGetModTime> = unsafe { c.get(b\"get_modified_time\").unwrap() };\n    let rf: Symbol<FnGetModTime> = unsafe { r.get(b\"get_modified_time\").unwrap() };\n\n    // get_modified_time calls time(NULL); `time(NULL) >> 29` only changes\n    // every ~17 years, so calling C and Rust back-to-back here is safe.\n    let cases = [(0, 0), (1, 1), (5, 23), (-1, -1), (10, 0), (0, 24), (100, 100)];\n    for &(d, h) in &cases {\n        let cv = unsafe { cf(d, h) };\n        let rv = unsafe { rf(d, h) };\n        assert_eq!(cv, rv, \"get_modified_time mismatch for ({}, {})\", d, h);\n    }\n}\n\n#[test]\nfn hash_time_value_matches() {\n    let (c, r) = open_libs();\n    let cf: Symbol<FnHashTime> = unsafe { c.get(b\"hash_time_value\").unwrap() };\n    let rf: Symbol<FnHashTime> = unsafe { r.get(b\"hash_time_value\").unwrap() };\n\n    let cases: [time_t; 8] = [\n        0,\n        1,\n        -1,\n        0x1234_5678,\n        -0x1234_5678,\n        0x7FFF_FFFF_FFFF_FFFF,\n        i64::MIN,\n        1_700_000_000,\n    ];\n    for &t in &cases {\n        let cv = unsafe { cf(t) };\n        let rv = unsafe { rf(t) };\n        assert_eq!(cv, rv, \"hash_time_value mismatch for {}\", t);\n    }\n}\n\nfn run_helper(so: &PathBuf, helper: &PathBuf, args: (i32, i32, i32, i32)) -> Vec<u8> {\n    let out = Command::new(helper)\n        .arg(so)\n        .arg(args.0.to_string())\n        .arg(args.1.to_string())\n        .arg(args.2.to_string())\n        .arg(args.3.to_string())\n        .output()\n        .expect(\"run helper\");\n    assert!(out.status.success(), \"helper failed: {:?}\", out.status);\n    out.stdout\n}\n\n#[test]\nfn modeselect_matches_return_and_output() {\n    let helper = helper_bin_path();\n    let c_so = c_lib_path();\n    let r_so = rust_lib_path();\n\n    // mode_selector kept in [0, 3] because the C indexes modes[mode % 4]\n    // unguarded; complexity in [0, 4] to hit all switch arms in\n    // apply_multiplier (default arm covered separately above).\n    let cases = [\n        (0i32, 0i32, 0i32, 0i32),\n        (1, 0, 1, 1),\n        (2, 5, 2, 7),\n        (3, -3, 3, 12),\n        (0, 100, 4, 23),\n        (1, -100, 0, 50),\n        (2, 1, 1, 100),\n        (3, 0, 4, -1),\n    ];\n\n    for &case in &cases {\n        let c_out = run_helper(&c_so, &helper, case);\n        let r_out = run_helper(&r_so, &helper, case);\n        assert_eq!(\n            c_out,\n            r_out,\n            \"modeselect output diverged for {:?}\\nC:\\n{}\\nRust:\\n{}\",\n            case,\n            String::from_utf8_lossy(&c_out),\n            String::from_utf8_lossy(&r_out)\n        );\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":21,"newStart":1,"newLines":18,"lines":[" // Compare Rust .so against the C .so via FFI loading."," // Both libraries are loaded with libloading and called through their exported","-// C ABI. stdout is redirected to a temp file around each call so the printf","-// output can be diffed byte-for-byte.","+// C ABI. For functions that produce stdout, we shell out to a small helper","+// binary so the captured output is unambiguous (no interference from cargo's","+// own test-harness writes)."," "," use libloading::{Library, Symbol};"," use std::ffi::CString;","-use std::fs;","-use std::io::Read;"," use std::os::raw::{c_char, c_double, c_int, c_long};"," use std::path::PathBuf;","-use std::sync::Mutex;","+use std::process::Command;"," "," #[allow(non_camel_case_types)]"," type time_t = c_long;"," ","-static STDOUT_GUARD: Mutex<()> = Mutex::new(());","-"," fn project_root() -> PathBuf {","     PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))"," }"]},{"oldStart":28,"oldLines":69,"newStart":25,"newLines":14,"lines":["     project_root().join(\"target/release/libtranslated_rust.so\")"," }"," ","-/// Captures everything written to stdout (file descriptor 1) at the libc level","-/// while `f` runs, returning the captured bytes.","-fn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {","-    // Hold a process-wide lock to prevent concurrent stdout redirections from","-    // racing each other.","-    let _guard = STDOUT_GUARD.lock().unwrap_or_else(|p| p.into_inner());","-","-    // Force a flush before swapping fds so anything buffered earlier is gone.","-    unsafe {","-        libc::fflush(std::ptr::null_mut());","-    }","-","-    let dir = std::env::temp_dir();","-    let path = dir.join(format!(","-        \"ffi_capture_{}_{}.tmp\",","-        std::process::id(),","-        std::time::SystemTime::now()","-            .duration_since(std::time::UNIX_EPOCH)","-            .unwrap()","-            .as_nanos()","-    ));","-","-    let path_c = CString::new(path.to_string_lossy().into_owned()).unwrap();","-","-    // Save current stdout fd.","-    let saved_fd = unsafe { libc::dup(1) };","-    assert!(saved_fd >= 0, \"dup(1) failed\");","-","-    // Open the temp file and redirect fd 1 to it.","-    let new_fd = unsafe {","-        