rite_all(b\"City '\");","+                        let _ = buf.write_all(&name);","+                        let _ = buf.write_all(b\"' not found\\n\");","+                        print_bytes(&mut stdout, &buf);","+                        continue;","                     }","+                    let copy = shallow_copy(node);","+                    if !copy.is_null() {","+                        let mut buf = Vec::new();","+                        let _ = buf.write_all(b\"Created shallow copy starting from \");","+                        let _ = buf.write_all(&name);","+                        let _ = buf.write_all(b\"\\n\");","+                        print_bytes(&mut stdout, &buf);","+                        print_bytes(","+                            &mut stdout,","+                            b\"Reference counts incremented for all reachable nodes\\n\",","+                        );","+                        print_node(&mut stdout, copy);","+                    } else {","+                        print_bytes(&mut stdout, b\"Failed to create shallow copy\\n\");","+                    }","                 }","-            }","-            7 => {","-                // Delete node","-                print!(\"Enter city name to delete: \");","-                if !read_line(&mut reader, &mut input) {","-                    continue;","-                }","-                let name = strip_newline(&input).to_string();","-                match get_node_by_name(&graph, &name) {","-                    None => {","-                        println!(\"City '{}' not found\", name);","+                7 => {","+                    print_bytes(&mut stdout, b\"Enter city name to delete: \");","+                    let _ = stdout.flush();","+                    if !read_line(&mut reader, &mut line) {","+                        break;","                     }","-                    Some(node) => {","-                        println!(\"Current ref count: {}\", node.borrow().ref_count);","-                        delete_node(&node);","-                        println!(\"Decremented reference count for {}\", name);","-                        println!(\"Note: Node will be freed when ref count reaches 0\");","+                    let name = strip_newline(&line).to_vec();","+                    let node = get_node_by_name(graph, &name);","+                    if node.is_null() {","+                        let mut buf = Vec::new();","+                        let _ = buf.write_all(b\"City '\");","+                        let _ = buf.write_all(&name);","+                        let _ = buf.write_all(b\"' not found\\n\");","+                        print_bytes(&mut stdout, &buf);","+                        continue;","                     }","+                    let mut buf = Vec::new();","+                    let _ = write!(buf, \"Current ref count: {}\\n\", (*node).ref_count);","+                    print_bytes(&mut stdout, &buf);","+                    delete_node(node);","+                    let mut buf2 = Vec::new();","+                    let _ = buf2.write_all(b\"Decremented reference count for \");","+                    let _ = buf2.write_all(&name);","+                    let _ = buf2.write_all(b\"\\n\");","+                    print_bytes(&mut stdout, &buf2);","+                    print_bytes(","+                        &mut stdout,","+                        b\"Note: Node will be freed when ref count reaches 0\\n\",","+                    );","                 }","+                8 => {","+                    print_bytes(&mut stdout, b\"Freeing graph and exiting...\\n\");","+                    let _ = stdout.flush();","+                    free_graph(graph);","+                    return;","+                }","+                _ => {","+                    print_bytes(&mut stdout, b\"Invalid choice\\n\");","+                }","             }","-            8 => {","-                // Exit","-                println!(\"Freeing graph and exiting...\");","-                free_graph(&mut graph);","-                return;","-            }","-            _ => {","-                println!(\"Invalid choice\");","-            }","         }","-    }"," ","-    free_graph(&mut graph);","+        free_graph(graph);","+    }"," }"]}],"originalFile":"// Translation of c_src/src/main.c and c_src/src/lib.c to Rust.\n// Aims to produce byte-identical stdout output for the same inputs.\n\nuse std::cell::RefCell;\nuse std::io::{self, BufRead, BufReader};\nuse std::rc::Rc;\n\nconst MAX_CITY_NAME: usize = 64;\nconst MAX_EDGES: usize = 10;\nconst MAX_NODES: usize = 100;\n\ntype NodeRef = Rc<RefCell<Node>>;\n\nstruct Edge {\n    destination: NodeRef,\n    distance: i32,\n}\n\nstruct Node {\n    city_name: String,\n    ref_count: i32,\n    edges: Vec<Edge>,\n}\n\nstruct Graph {\n    nodes: Vec<NodeRef>,\n}\n\nfn create_graph() -> Graph {\n    Graph { nodes: Vec::new() }\n}\n\nfn add_node(graph: &mut Graph, city_name: &str) -> Option<NodeRef> {\n    if graph.nodes.len() >= MAX_NODES {\n        eprintln!(\"Error: Graph is full (max {} nodes)\", MAX_NODES);\n        return None;\n    }\n\n    // Check duplicate by comparing existing (possibly truncated) stored name\n    // against the full input string, mimicking strcmp behavior.\n    for n in &graph.nodes {\n        if n.borrow().city_name == city_name {\n            eprintln!(\"Error: Node '{}' already exists\", city_name);\n            return None;\n        }\n    }\n\n    // Mimic strncpy(node->city_name, city_name, MAX_CITY_NAME - 1);\n    // and node->city_name[MAX_CITY_NAME - 1] = '\\0';\n    let bytes = city_name.as_bytes();\n    let end = bytes.len().min(MAX_CITY_NAME - 1);\n    let truncated = String::from_utf8_lossy(&bytes[..end]).into_owned();\n\n    let node = Rc::new(RefCell::new(Node {\n        city_name: truncated,\n        ref_count: 1,\n        edges: Vec::new(),\n    }));\n    graph.nodes.push(Rc::clone(&node));\n    Some(node)\n}\n\nfn add_edge(from: &NodeRef, to: &NodeRef, distance: i32) -> i32 {\n    {\n        let from_b = from.borrow();\n        if from_b.edges.len() >= MAX_EDGES {\n            eprintln!(\"Error: Node '{}' has maximum edges\", from_b.city_name);\n            return -1;\n        }\n    }\n    if distance < 0 {\n        eprintln!(\"Error: Negative distance not allowed\");\n        return -1;\n    }\n    {\n        let from_b = from.borrow();\n        for e in &from_b.edges {\n            if Rc::ptr_eq(&e.destination, to) {\n                eprintln!(\"Error: Edge already exists\");\n                return -1;\n            }\n        }\n    }\n    from.borrow_mut().edges.push(Edge {\n        destination: Rc::clone(to),\n        distance,\n    });\n    0\n}\n\nfn delete_node(node: &NodeRef) {\n    // We can't actually free since Rc may have other references (the graph\n    // itself, edges, etc.). Just decrement the displayed ref_count to match\n    // C's externally visible behavior.\n    let mut n = node.borrow_mut();\n    n.ref_count -= 1;\n    // If ref_count reached zero, the C code would free the node. We don't\n    // simulate freeing because the graph still holds the pointer in C\n    // (which is undefined behavior). For the test cases we care about,\n    // this is sufficient to match output.\n}\n\nfn increment_refs_recursive(node: &NodeRef, visited: &mut Vec<NodeRef>) {\n    for v in visited.iter() {\n        if Rc::ptr_eq(v, node) {\n            return;\n        }\n    }\n\n    if visited.len() < MAX_NODES {\n        visited.push(Rc::clone(node));\n    }\n\n    node.borrow_mut().ref_count += 1;\n\n    let edges_clone: Vec<NodeRef> = node\n        .borrow()\n        .edges\n        .iter()\n        .map(|e| Rc::clone(&e.destination))\n        .collect();\n    for dest in edges_clone {\n        increment_refs_recursive(&dest, visited);\n    }\n}\n\nfn shallow_copy(start: &NodeRef) -> NodeRef {\n    let mut visited: Vec<NodeRef> = Vec::new();\n    increment_refs_recursive(start, &mut visited);\n    Rc::clone(start)\n}\n\nstruct DijkstraState {\n    node: NodeRef,\n    distance: i32,\n    previous: Option<NodeRef>,\n    visited: bool,\n}\n\nfn find_shortest_path(start: &NodeRef, end: &NodeRef) -> Option<Vec<NodeRef>> {\n    const INT_MAX: i32 = i32::MAX;\n\n    let mut state: Vec<DijkstraState> = Vec::new();\n    state.push(DijkstraState {\n        node: Rc::clone(start),\n        distance: 0,\n        previous: None,\n        visited: false,\n    });\n\n    let mut current: Option<NodeRef> = Some(Rc::clone(start));\n\n    while let Some(curr) = current.clone() {\n        let mut current_idx: Option<usize> = None;\n        for (i, s) in state.iter().enumerate() {\n            if Rc::ptr_eq(&s.node, &curr) {\n                current_idx = Some(i);\n                break;\n            }\n        }\n        let current_idx = match current_idx {\n            Some(i) => i,\n            None => break,\n        };\n\n        state[current_idx].visited = true;\n\n        if Rc::ptr_eq(&curr, end) {\n            break;\n        }\n\n        let curr_distance = state[current_idx].distance;\n        let edges_info: Vec<(NodeRef, i32)> = curr\n            .borrow()\n            .edges\n            .iter()\n            .map(|e| (Rc::clone(&e.destination), e.distance))\n            .collect();\n\n        for (neighbor, edge_dist) in &edges_info {\n            // Match C's i32 arithmetic (wrapping on overflow).\n            let new_distance = curr_distance.wrapping_add(*edge_dist);\n\n            let mut neighbor_idx: Option<usize> = None;\n            for (j, s) in state.iter().enumerate() {\n                if Rc::ptr_eq(&s.node, neighbor) {\n                    neighbor_idx = Some(j);\n                    break;\n                }\n            }\n\n            if neighbor_idx.is_none() && state.len() < MAX_NODES {\n                neighbor_idx = Some(state.len());\n                state.push(DijkstraState {\n                    node: Rc::clone(neighbor),\n                    distance: INT_MAX,\n                    previous: None,\n                    visited: false,\n                });\n            }\n\n            if let Some(ni) = neighbor_idx {\n                if new_distance < state[ni].distance {\n                    state[ni].distance = new_distance;\n                    state[ni].previous = Some(Rc::clone(&curr));\n                }\n            }\n        }\n\n        // Find next unvisited node with min distance\n        let mut min_distance = INT_MAX;\n        let mut next: Option<NodeRef> = None;\n        for s in &state {\n            if !s.visited && s.distance < min_distance {\n                min_distance = s.distance;\n                next = Some(Rc::clone(&s.node));\n            }\n        }\n        current = next;\n    }\n\n    let mut end_idx: Option<usize> = None;\n    for (i, s) in state.iter().enumerate() {\n        if Rc::ptr_eq(&s.node, end) {\n            end_idx = Some(i);\n            break;\n        }\n    }\n\n    let end_idx = match end_idx {\n        Some(i) => i,\n        None => {\n            eprintln!(\"No path found\");\n            return None;\n        }\n    };\n\n    if state[end_idx].distance == INT_MAX {\n        eprintln!(\"No path found\");\n        return None;\n    }\n\n    // Reconstruct path\n    let mut path: Vec<NodeRef> = Vec::new();\n    let mut current_node: Option<NodeRef> = Some(Rc::clone(end));\n    while let Some(cn) = current_node.clone() {\n        path.push(Rc::clone(&cn));\n\n        let mut cs_idx: Option<usize> = None;\n        for (i, s) in state.iter().enumerate() {\n            if Rc::ptr_eq(&s.node, &cn) {\n                cs_idx = Some(i);\n                break;\n            }\n        }\n        match cs_idx {\n            None => break,\n            Some(i) => {\n                current_node = state[i].previous.as_ref().map(Rc::clone);\n            }\n        }\n    }\n    path.reverse();\n    Some(path)\n}\n\nfn get_node_by_name(graph: &Graph, name: &str) -> Option<NodeRef> {\n    for n in &graph.nodes {\n        if n.borrow().city_name == name {\n            return Some(Rc::clone(n));\n        }\n    }\n    None\n}\n\nfn print_node(node: &NodeRef) {\n    let n = node.borrow();\n    println!(\"City: {} (ref_count: {})\", n.city_name, n.ref_count);\n    println!(\"  Edges:\");\n    for e in &n.edges {\n        let dest = e.destination.borrow();\n        println!(\"    -> {} (distance: {})\", dest.city_name, e.distance);\n    }\n}\n\nfn print_graph(graph: &Graph) {\n    println!(\"Graph with {} nodes:\", graph.nodes.len());\n    for node in &graph.nodes {\n        print_node(node);\n    }\n}\n\nfn free_graph(graph: &mut Graph) {\n    // Decrement ref count for all nodes (matches C's free_graph that calls\n    // delete_node on each).\n    for node in &graph.nodes {\n        delete_node(node);\n    }\n    graph.nodes.clear();\n}\n\nfn print_menu() {\n    println!();\n    println!(\"=== DAG City Route Manager ===\");\n    println!(\"1. Add city (node)\");\n    println!(\"2. Add route (edge)\");\n    println!(\"3. Show all cities\");\n    println!(\"4. Show city details\");\n    println!(\"5. Find shortest path\");\n    println!(\"6. Make shallow copy of subsection\");\n    println!(\"7. Delete node\");\n    println!(\"8. Exit\");\n    print!(\"Choice: \");\n}\n\n// Mimic strcspn(input, \"\\n\") -> truncate at first newline.\nfn strip_newline(s: &str) -> &str {\n    match s.find('\\n') {\n        Some(i) => &s[..i],\n        None => s,\n    }\n}\n\n// Mimic sscanf(\"%d\", &x): skip leading whitespace, optional sign, then digits.\n// Returns Some(x) if at least one digit was parsed, None otherwise.\nfn parse_int(s: &str) -> Option<i32> {\n    let s = s.trim_start();\n    let bytes = s.as_bytes();\n    let mut i = 0;\n    if i < bytes.len() && (bytes[i] == b'+' || bytes[i] == b'-') {\n        i += 1;\n    }\n    let digit_start = i;\n    while i < bytes.len() && bytes[i].is_ascii_digit() {\n        i += 1;\n    }\n    if digit_start == i {\n        return None;\n    }\n    let slice = std::str::from_utf8(&bytes[..i]).ok()?;\n    slice.parse::<i32>().ok()\n}\n\n// Read a single line (like fgets) into `buf` (overwriting). Returns true on\n// success, false on EOF/error (matches C's NULL return semantics).\nfn read_line<R: BufRead>(reader: &mut R, buf: &mut String) -> bool {\n    buf.clear();\n    match reader.read_line(buf) {\n        Ok(0) => false,\n        Ok(_) => true,\n        Err(_) => false,\n    }\n}\n\nfn main() {\n    let mut graph = create_graph();\n\n    let stdin = io::stdin();\n    let mut reader = BufReader::new(stdin.lock());\n    let mut input = String::new();\n\n    println!(\"City Route Management System\");\n    println!(\"Commands are read from stdin\");\n\n    loop {\n        print_menu();\n\n        if !read_line(&mut reader, &mut input) {\n            break;\n        }\n\n        let choice = match parse_int(&input) {\n            Some(c) => c,\n            None => {\n                println!(\"Invalid input\");\n                continue;\n            }\n        };\n\n        match choice {\n            1 => {\n                // Add city\n                print!(\"Enter city name: \");\n                if !read_line(&mut reader, &mut input) {\n                    continue;\n                }\n                let name = strip_newline(&input).to_string();\n                let res = add_node(&mut graph, &name);\n                if res.is_some() {\n                    println!(\"Added city: {}\", name);\n                } else {\n                    println!(\"Failed to add city\");\n                }\n            }\n            2 => {\n                // Add route\n                let mut from_buf = String::new();\n                let mut to_buf = String::new();\n                let mut dist_buf = String::new();\n\n                print!(\"Enter from city: \");\n                if !read_line(&mut reader, &mut from_buf) {\n                    continue;\n                }\n                let from_city = strip_newline(&from_buf).to_string();\n\n                print!(\"Enter to city: \");\n                if !read_line(&mut reader, &mut to_buf) {\n                    continue;\n                }\n                let to_city = strip_newline(&to_buf).to_string();\n\n                print!(\"Enter distance: \");\n                if !read_line(&mut reader, &mut dist_buf) {\n                    continue;\n                }\n                let distance = match parse_int(&dist_buf) {\n                    Some(d) => d,\n                    None => {\n                        println!(\"Invalid distance\");\n                        continue;\n                    }\n                };\n\n                let from = get_node_by_name(&graph, &from_city);\n                let to = get_node_by_name(&graph, &to_city);\n\n                if from.is_none() {\n                    println!(\"City '{}' not found\", from_city);\n                    continue;\n                }\n                if to.is_none() {\n                    println!(\"City '{}' not found\", to_city);\n                    continue;\n                }\n                let from = from.unwrap();\n                let to = to.unwrap();\n\n                if add_edge(&from, &to, distance) == 0 {\n                    println!(\n                        \"Added route: {} -> {} (distance: {})\",\n                        from_city, to_city, distance\n                    );\n                } else {\n                    println!(\"Failed to add route\");\n                }\n            }\n            3 => {\n                // Show all cities\n                print_graph(&graph);\n            }\n            4 => {\n                // Show city details\n                print!(\"Enter city name: \");\n                if !read_line(&mut reader, &mut input) {\n                    continue;\n                }\n                let name = strip_newline(&input).to_string();\n                match get_node_by_name(&graph, &name) {\n                    Some(node) => print_node(&node),\n                    None => println!(\"City '{}' not found\", name),\n                }\n            }\n            5 => {\n                // Find shortest path\n                let mut start_buf = String::new();\n                let mut end_buf = String::new();\n\n                print!(\"Enter start city: \");\n                if !read_line(&mut reader, &mut start_buf) {\n                    continue;\n                }\n                let start_city = strip_newline(&start_buf).to_string();\n\n                print!(\"Enter end city: \");\n                if !read_line(&mut reader, &mut end_buf) {\n                    continue;\n                }\n                let end_city = strip_newline(&end_buf).to_string();\n\n                let start = get_node_by_name(&graph, &start_city);\n                let end = get_node_by_name(&graph, &end_city);\n\n                if start.is_none() {\n                    println!(\"City '{}' not found\", start_city);\n                    continue;\n                }\n                if end.is_none() {\n                    println!(\"City '{}' not found\", end_city);\n                    continue;\n                }\n                let start = start.unwrap();\n                let end = end.unwrap();\n\n                match find_shortest_path(&start, &end) {\n                    Some(path) => {\n                        println!(\"Shortest path from {} to {}:\", start_city, end_city);\n                        for (i, node) in path.iter().enumerate() {\n                            println!(\"  {}. {}\", i + 1, node.borrow().city_name);\n                        }\n                    }\n                    None => {\n                        println!(\"No path found\");\n                    }\n                }\n            }\n            6 => {\n                // Make shallow copy\n                print!(\"Enter start city for shallow copy: \");\n                if !read_line(&mut reader, &mut input) {\n                    continue;\n                }\n                let name = strip_newline(&input).to_string();\n                match get_node_by_name(&graph, &name) {\n                    None => {\n                        println!(\"City '{}' not found\", name);\n                    }\n                    Some(node) => {\n                        let copy = shallow_copy(&node);\n                        println!(\"Created shallow copy starting from {}\", name);\n                        println!(\"Reference counts incremented for all reachable nodes\");\n                        print_node(&copy);\n                    }\n                }\n            }\n            7 => {\n                // Delete node\n                print!(\"Enter city name to delete: \");\n                if !read_line(&mut reader, &mut input) {\n                    continue;\n                }\n                let name = strip_newline(&input).to_string();\n                match get_node_by_name(&graph, &name) {\n                    None => {\n                        println!(\"City '{}' not found\", name);\n                    }\n                    Some(node) => {\n                        println!(\"Current ref count: {}\", node.borrow().ref_count);\n                        delete_node(&node);\n                        println!(\"Decremented reference count for {}\", name);\n                        println!(\"Note: Node will be freed when ref count reaches 0\");\n                    }\n                }\n            }\n            8 => {\n                // Exit\n                println!(\"Freeing graph and exiting...\");\n                free_graph(&mut graph);\n                return;\n            }\n            _ => {\n                println!(\"Invalid choice\");\n            }\n        }\n    }\n\n    free_graph(&mut graph);\n}\n","userModified":false}}
