);\n\n        // Build a fully initialized source block (zero padding) so both\n        // copies will compare equal.\n        let mut src = DataBlock {\n            id: 12345,\n            value: 3.14159,\n            label: [0; 20],\n        };\n        let s = b\"hello-world\";\n        for (i, &b) in s.iter().enumerate() {\n            src.label[i] = b as c_char;\n        }\n\n        let mut c_dest = DataBlock {\n            id: 0,\n            value: 0.0,\n            label: [0; 20],\n        };\n        let mut r_dest = DataBlock {\n            id: 0,\n            value: 0.0,\n            label: [0; 20],\n        };\n\n        c_fn(&mut c_dest as *mut _, &src as *const _);\n        r_fn(&mut r_dest as *mut _, &src as *const _);\n\n        // Compare full bytes, including padding, by transmuting to byte slices.\n        let c_bytes = std::slice::from_raw_parts(\n            &c_dest as *const _ as *const u8,\n            std::mem::size_of::<DataBlock>(),\n        );\n        let r_bytes = std::slice::from_raw_parts(\n            &r_dest as *const _ as *const u8,\n            std::mem::size_of::<DataBlock>(),\n        );\n        assert_eq!(c_bytes, r_bytes, \"copy_data_block bytes mismatch\");\n    }\n}\n\n#[test]\nfn overunder_matches() {\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        type FnSig = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n        let c_fn: Symbol<FnSig> = c_lib.get(b\"overunder\").unwrap();\n        let r_fn: Symbol<FnSig> = r_lib.get(b\"overunder\").unwrap();\n\n        // Set of input quadruples covering each switch case (a%6 in 0..=5),\n        // including negatives and edge cases.\n        let cases: &[(c_int, c_int, c_int, c_int)] = &[\n            (0, 0, 0, 0),\n            (1, 2, 3, 4),\n            (6, 7, 8, 9),\n            (5, 10, 15, 20),\n            (-1, -2, -3, -4),\n            (12, 5, 33, 7),\n            (13, -7, 100, -100),\n            (4, 4, 4, 4),\n            (3, 1, 1, 1),\n            (2, 50, 60, 70),\n            (8, -1, -2, 3),\n        ];\n\n        for &(a, b, c, d) in cases {\n            let c_bytes = capture_stdout(|| {\n                let _ = c_fn(a, b, c, d);\n            });\n            let c_out = {\n                // The first capture also returned the function's value via the\n                // closure side effect, but to keep return values aligned we\n                // call again separately. Order matters because these functions\n                // use UB-adjacent operations; we accept the cost.\n                let mut ret: c_int = 0;\n                let _ = capture_stdout(|| {\n                    ret = c_fn(a, b, c, d);\n                });\n                ret\n            };\n            let _ = c_bytes; // unused below; we use the second capture's bytes.\n\n            let mut c_ret: c_int = 0;\n            let c_bytes = capture_stdout(|| {\n                c_ret = c_fn(a, b, c, d);\n            });\n            let mut r_ret: c_int = 0;\n            let r_bytes = capture_stdout(|| {\n                r_ret = r_fn(a, b, c, d);\n            });\n\n            assert_eq!(\n                c_ret, r_ret,\n                \"overunder({}, {}, {}, {}) return value mismatch\",\n                a, b, c, d\n            );\n            assert_eq!(c_out, c_ret); // sanity check capture vs raw call\n            assert_eq!(\n                c_bytes,\n                r_bytes,\n                \"overunder({}, {}, {}, {}) stdout mismatch:\\nC:\\n{}\\nRUST:\\n{}\",\n                a,\n                b,\n                c,\n                d,\n                String::from_utf8_lossy(&c_bytes),\n                String::from_utf8_lossy(&r_bytes),\n            );\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
