{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_faisz3tnuvym7tq3mkduewh7qebqntbztfcapw74iziclhwa237q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_011piZFnSn14gxXvrudGs5ef","name":"Write","input":{"file_path":"/tmp/harvest-translate-HES6N4/translated_rust/tests/ffi_compare.rs","content":"// FFI integration tests: compare C and Rust shared libraries.\n//\n// Loads both .so files via libloading and asserts that each exported\n// function returns the same value AND prints byte-identical bytes to stdout.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_double, c_int};\nuse std::io::Read;\nuse std::os::unix::io::FromRawFd;\nuse std::path::PathBuf;\n\n// Captures fd 1 (stdout) bytes produced while running `f`. Flushes before\n// and after so libc printf buffers don't leak between invocations.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    extern \"C\" {\n        fn fflush(stream: *mut std::ffi::c_void) -> c_int;\n    }\n    unsafe {\n        // Flush any pending stdout data first.\n        fflush(std::ptr::null_mut());\n\n        // Save the original stdout fd.\n        let saved = libc::dup(1);\n        assert!(saved >= 0, \"dup failed\");\n\n        // Create a pipe.\n        let mut fds = [0i32; 2];\n        let r = libc::pipe(fds.as_mut_ptr());\n        assert_eq!(r, 0, \"pipe failed\");\n        let read_fd = fds[0];\n        let write_fd = fds[1];\n\n        // Redirect stdout (fd 1) to the write end of the pipe.\n        let r = libc::dup2(write_fd, 1);\n        assert!(r >= 0, \"dup2 failed\");\n        libc::close(write_fd);\n\n        // Run the closure.\n        f();\n\n        // Flush libc stdout buffer so all output makes it into the pipe.\n        fflush(std::ptr::null_mut());\n\n        // Restore original stdout, then close the saved fd.\n        let r = libc::dup2(saved, 1);\n        assert!(r >= 0, \"dup2 restore failed\");\n        libc::close(saved);\n\n        // Read all bytes from the read end of the pipe.\n        let mut file = std::fs::File::from_raw_fd(read_fd);\n        let mut buf = Vec::new();\n        file.read_to_end(&mut buf).expect(\"read pipe failed\");\n        buf\n    }\n}\n\nfn c_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nfn rust_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    p.push(\"release\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nunsafe fn load_lib(path: &PathBuf) -> Library {\n    Library::new(path).unwrap_or_else(|e| panic!(\"failed to load {}: {}\", path.display(), e))\n}\n\n#[test]\nfn safe_double_to_int_matches() {\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        type FnSig = unsafe extern \"C\" fn(c_double) -> c_int;\n        let c_fn: Symbol<FnSig> = c_lib.get(b\"safe_double_to_int\").unwrap();\n        let r_fn: Symbol<FnSig> = r_lib.get(b\"safe_double_to_int\").unwrap();\n\n        let inputs: &[c_double] = &[\n            0.0,\n            1.0,\n            -1.0,\n            42.5,\n            -42.5,\n            1e15,\n            -1e15,\n            1e30,\n            -1e30,\n            f64::NAN,\n            f64::INFINITY,\n            f64::NEG_INFINITY,\n            (i32::MAX as f64) - 0.5,\n            (i32::MIN as f64) + 0.5,\n            i32::MAX as f64,\n            i32::MIN as f64,\n            (i32::MAX as f64) + 1.0,\n            (i32::MIN as f64) - 1.0,\n        ];\n        for &d in inputs {\n            let c_out = c_fn(d);\n            let r_out = r_fn(d);\n            assert_eq!(c_out, r_out, \"safe_double_to_int({}) mismatch\", d);\n        }\n    }\n}\n\n#[test]\nfn process_with_fallthrough_matches() {\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        type FnSig = unsafe extern \"C\" fn(c_int, c_int) -> c_int;\n        let c_fn: Symbol<FnSig> = c_lib.get(b\"process_with_fallthrough\").unwrap();\n        let r_fn: Symbol<FnSig> = r_lib.get(b\"process_with_fallthrough\").unwrap();\n\n        for code in -3..=8 {\n            for base in &[-100, -1, 0, 1, 7, 100, 1000] {\n                let c_out = c_fn(code, *base);\n                let r_out = r_fn(code, *base);\n                assert_eq!(c_out, r_out, \"process_with_fallthrough({}, {})\", code, base);\n            }\n        }\n    }\n}\n\n#[test]\nfn handle_pointer_operations_matches() {\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        type FnSig = unsafe extern \"C\" fn(c_int) -> c_int;\n        let c_fn: Symbol<FnSig> = c_lib.get(b\"handle_pointer_operations\").unwrap();\n        let r_fn: Symbol<FnSig> = r_lib.get(b\"handle_pointer_operations\").unwrap();\n\n        for v in &[-1000, -1, 0, 1, 7, 42, 1000, 100000, i32::MAX / 4] {\n            let c_out = c_fn(*v);\n            let r_out = r_fn(*v);\n            assert_eq!(c_out, r_out, \"handle_pointer_operations({})\", v);\n        }\n    }\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq)]\nstruct DataBlock {\n    id: c_int,\n    value: c_double,\n    label: [c_char; 20],\n}\n\n#[test]\nfn copy_data_block_matches() {\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        type FnSig = unsafe extern \"C\" fn(*mut DataBlock, *const DataBlock);\n        let c_fn: Symbol<FnSig> = c_lib.get(b\"copy_data_block\").unwrap();\n        let r_fn: Symbol<FnSig> = r_lib.get(b\"copy_data_block\").unwrap();\n\n        // Build a fully initialized source block (zero padding) so both\n        // copies will compare equal.\n        let mut src = DataBlock {\n            id: 12345,\n            value: 3.14159,\n            label: [0; 20],\n        };\n        let s = b\"hello-world\";\n        for (i, &b) in s.iter().enumerate() {\n            src.label[i] = b as c_char;\n        }\n\n        let mut c_dest = DataBlock {\n            id: 0,\n            value: 0.0,\n            label: [0; 20],\n        };\n        let mut r_dest = DataBlock {\n            id: 0,\n            value: 0.0,\n            label: [0; 20],\n        };\n\n        c_fn(&mut c_dest as *mut _, &src as *const _);\n        r_fn(&mut r_dest as *mut _, &src as *const _);\n\n        // Compare full bytes, including padding, by transmuting to byte slices.\n        let c_bytes = std::slice::from_raw_parts(\n            &c_dest as *const _ as *const u8,\n            std::mem::size_of::<DataBlock>(),\n        );\n        let r_bytes = std::slice::from_raw_parts(\n            &r_dest as *const _ as *const u8,\n            std::mem::size_of::<DataBlock>(),\n        );\n        assert_eq!(c_bytes, r_bytes, \"copy_data_block bytes mismatch\");\n    }\n}\n\n#[test]\nfn overunder_matches() {\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        type FnSig = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n        let c_fn: Symbol<FnSig> = c_lib.get(b\"overunder\").unwrap();\n        let r_fn: Symbol<FnSig> = r_lib.get(b\"overunder\").unwrap();\n\n        // Set of input quadruples covering each switch case (a%6 in 0..=5),\n        // including negatives and edge cases.\n        let cases: &[(c_int, c_int, c_int, c_int)] = &[\n            (0, 0, 0, 0),\n            (1, 2, 3, 4),\n            (6, 7, 8, 9),\n            (5, 10, 15, 20),\n            (-1, -2, -3, -4),\n            (12, 5, 33, 7),\n            (13, -7, 100, -100),\n            (4, 4, 4, 4),\n            (3, 1, 1, 1),\n            (2, 50, 60, 70),\n            (8, -1, -2, 3),\n        ];\n\n        for &(a, b, c, d) in cases {\n            let c_bytes = capture_stdout(|| {\n                let _ = c_fn(a, b, c, d);\n            });\n            let c_out = {\n                // The first capture also returned the function's value via the\n                // closure side effect, but to keep return values aligned we\n                // call again separately. Order matters because these functions\n                // use UB-adjacent operations; we accept the cost.\n                let mut ret: c_int = 0;\n                let _ = capture_stdout(|| {\n                    ret = c_fn(a, b, c, d);\n                });\n                ret\n            };\n            let _ = c_bytes; // unused below; we use the second capture's bytes.\n\n            let mut c_ret: c_int = 0;\n            let c_bytes = capture_stdout(|| {\n                c_ret = c_fn(a, b, c, d);\n            });\n            let mut r_ret: c_int = 0;\n            let r_bytes = capture_stdout(|| {\n                r_ret = r_fn(a, b, c, d);\n            });\n\n            assert_eq!(\n                c_ret, r_ret,\n                \"overunder({}, {}, {}, {}) return value mismatch\",\n                a, b, c, d\n            );\n            assert_eq!(c_out, c_ret); // sanity check capture vs raw call\n            assert_eq!(\n                c_bytes,\n                r_bytes,\n                \"overunder({}, {}, {}, {}) stdout mismatch:\\nC:\\n{}\\nRUST:\\n{}\",\n                a,\n                b,\n                c,\n                d,\n                String::from_utf8_lossy(&c_bytes),\n                String::from_utf8_lossy(&r_bytes),\n            );\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":142,"cache_read_input_tokens":29917,"cache_creation":{"ephemeral_5m_input_tokens":142,"ephemeral_1h_input_tokens":0},"output_tokens":33,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0ccf4d64-ff9c-4d0f-b660-9ab86a151432","uuid":"c2e54cd6-cafd-42b9-bd9f-65e8d7504394"}
