3) as u8;\\n                gr_ref.subblock_gain[2] = get_bits(bs, 3) as u8;\\n            } else {\\n                gr_ref.block_type = 0;\\n                gr_ref.mixed_block_flag = 0;\\n                tables = get_bits(bs, 15);\\n                gr_ref.region_count[0] = get_bits(bs, 4) as u8;\\n                gr_ref.region_count[1] = get_bits(bs, 3) as u8;\\n                gr_ref.region_count[2] = 255;\\n            }\\n\\n            gr_ref.table_select[0] = (tables >> 10) as u8;\\n            gr_ref.table_select[1] = ((tables >> 5) & 31) as u8;\\n            gr_ref.table_select[2] = (tables & 31) as u8;\\n            gr_ref.preflag = if (hdr_slice[1] & 0x8) != 0 {\\n                get_bits(bs, 1) as u8\\n            } else if gr_ref.scalefac_compress >= 500 {\\n                1\\n            } else {\\n                0\\n            };\\n            gr_ref.scalefac_scale = get_bits(bs, 1) as u8;\\n            gr_ref.count1_table = get_bits(bs, 1) as u8;\\n            gr_ref.scfsi = ((scfsi >> 12) & 15) as u8;\\n            scfsi <<= 4;\\n            gr_ptr = gr_ptr.add(1);\\n            gr_count -= 1;\\n            if gr_count == 0 {\\n                break;\\n            }\\n        }\\n\\n        if part_23_sum + (*bs).pos > (*bs).limit + main_data_begin * 8 {\\n            return -1;\\n        }\\n    }\\n\\n    main_data_begin\\n}\\n\"}]}","refusal":null,"reasoning":null}}],"usage":{"prompt_tokens":4923,"completion_tokens":4559,"total_tokens":9482,"cost":0,"is_byok":true,"prompt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.0806925,"upstream_inference_prompt_cost":0.0123075,"upstream_inference_completions_cost":0.068385},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}