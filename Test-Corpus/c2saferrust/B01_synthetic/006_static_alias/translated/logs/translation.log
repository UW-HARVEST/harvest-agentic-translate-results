pub fn static_alias(outer: &mut i32) -> &mut i32 {
    static INNER: std::sync::atomic::AtomicI32 = std::sync::atomic::AtomicI32::new(1);

    let inner_val = INNER.load(std::sync::atomic::Ordering::SeqCst);
    if *outer >= inner_val {
        let new_val = inner_val + *outer;
        INNER.store(new_val, std::sync::atomic::Ordering::SeqCst);
        outer
    } else {
        *outer += inner_val;
        outer
    }
}
</FUNC>
