pub unsafe extern "C" fn static_alias(
    mut outer: *mut ::core::ffi::c_int,
) -> *mut ::core::ffi::c_int {
    static mut inner: ::core::ffi::c_int = 1 as ::core::ffi::c_int;
    if *outer >= inner {
        inner += *outer;
        return &raw mut inner;
    } else {
        *outer += inner;
        return outer;
    };
}
```


