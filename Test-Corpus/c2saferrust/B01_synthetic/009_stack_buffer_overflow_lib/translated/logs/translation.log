    let mut buffer = [0i32; 10];

    if data < 0 {
        printLine("ERROR: Array index is negative.");
        return;
    }

    let index = data as usize;
    if index >= buffer.len() {
        printLine("ERROR: Array index is out-of-bounds");
        return;
    }

    buffer[index] = 1;

    for &value in &buffer {
        printIntLine(value);
    }
}
