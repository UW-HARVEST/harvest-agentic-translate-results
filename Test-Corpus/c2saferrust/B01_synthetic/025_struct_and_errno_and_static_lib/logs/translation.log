<IMPORTS>
use std::ffi::CStr;
</IMPORTS>

<FUNC>
fn parse_val(str: *const ::core::ffi::c_char, val: &mut ::core::ffi::c_int) -> bool {
    if str.is_null() {
        return false;
    }

    let s = match unsafe { CStr::from_ptr(str) }.to_str() {
        Ok(s) => s,
        Err(_) => return false,
    };

    match s.trim().parse::<::core::ffi::c_int>() {
        Ok(parsed) => {
            *val = parsed;
            true
        }
        Err(_) => false,
    }
}
