                | ('t' as i32 as ima_u8_t as ima_u32_t) << 8 as ::core::ffi::c_int
                | ('a' as i32 as ima_u8_t as ima_u32_t) << 16 as ::core::ffi::c_int
                | ('d' as i32 as ima_u8_t as ima_u32_t) << 24 as ::core::ffi::c_int
        {
