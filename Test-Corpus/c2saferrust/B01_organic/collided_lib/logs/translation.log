pub fn c2CircletoAABB(a: &c2Circle, b: &c2AABB) -> bool {
    let l = c2Clampv(a.p, b.min, b.max);
    let ab = c2Sub(a.p, l);
    let d2 = c2Dot(ab, ab);
    let r2 = a.r * a.r;
    d2 < r2
}
