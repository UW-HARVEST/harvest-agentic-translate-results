    unsafe {
        let s = ((*bs).pos & 7) as u32;
        let mut shl = (n as u32).wrapping_add(s) as ::core::ffi::c_int;
        let mut p = (*bs).buf.wrapping_add(((*bs).pos >> 3) as usize);

        (*bs).pos += n;
        if (*bs).pos > (*bs).limit {
            return 0;
        }

        let mut cache: u32 = 0;
        let mut next: u32 = ((*p as ::core::ffi::c_int & (255 >> s) as ::core::ffi::c_int) as u32);
        p = p.wrapping_add(1);

        loop {
            shl -= 8;
            if shl <= 0 {
                break;
            }
            cache |= next << shl;
            next = *p as u32;
            p = p.wrapping_add(1);
        }

        cache | (next >> (-shl))
    }
}
</FUNC>
