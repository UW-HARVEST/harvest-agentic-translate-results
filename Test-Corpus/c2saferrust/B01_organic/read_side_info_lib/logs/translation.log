fn get_bits(bs: &mut bs_t, n: i32) -> u32 {
    let s = (bs.pos & 7) as u32;
    let mut shl = (n as u32 + s) as i32;
    let byte_pos = (bs.pos >> 3) as usize;

    bs.pos += n;
    if bs.pos > bs.limit {
        return 0;
    }

    let buf = bs.buf;
    let mut p = byte_pos;

    let mut cache: u32 = 0;
    let mut next: u32 = ((buf[p] as i32 & (255 >> s) as i32) as u32);
    p += 1;

    loop {
        shl -= 8;
        if shl <= 0 {
            break;
        }
        cache |= next << shl;
        next = buf[p] as u32;
        p += 1;
    }

    cache | (next >> (-shl))
}
