<FUNC>
fn cbContrastRatio(
    ra: f32,
    ga: f32,
    ba: f32,
    rb: f32,
    gb: f32,
    bb: f32,
) -> f32 {
    let lum_a = cbLuminance(ra, ga, ba);
    let lum_b = cbLuminance(rb, gb, bb);
    let (high, low) = if lum_a < lum_b {
        (lum_b, lum_a)
    } else {
        (lum_a, lum_b)
    };
    high / low
}
</FUNC>

