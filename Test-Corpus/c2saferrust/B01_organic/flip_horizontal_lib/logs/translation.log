pub fn flip_horizontal(img: &mut cp_image_t) {
    let w = img.w as usize;
    let h = img.h as usize;
    let flips = h / 2;

    for i in 0..flips {
        let top_start = w * i;
        let bottom_start = w * (h - i - 1);

        for j in 0..w {
            img.pix.swap(top_start + j, bottom_start + j);
        }
    }
}
