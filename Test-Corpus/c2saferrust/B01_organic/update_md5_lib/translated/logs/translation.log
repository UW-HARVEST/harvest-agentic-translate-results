            bytes = bytes.wrapping_sub(1);
            if !(fresh0 != 0) {
                break;
            }
            (*m).buffer[bytes as usize] =
                (*m).buffer[(64 as tflac_u32).wrapping_add(bytes) as usize];
        }
    }
}
