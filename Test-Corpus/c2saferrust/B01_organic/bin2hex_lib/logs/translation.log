<FUNC>
pub fn bin2hex(bin: &[u8]) -> String {
    let mut hex = String::with_capacity(bin.len() * 2);
    for &byte in bin {
        let high = byte >> 4;
        let low = byte & 0x0f;

        hex.push(if high < 10 {
            (b'0' + high) as char
        } else {
            (b'a' + (high - 10)) as char
        });

        hex.push(if low < 10 {
            (b'0' + low) as char
        } else {
            (b'a' + (low - 10)) as char
        });
    }
    hex
}
