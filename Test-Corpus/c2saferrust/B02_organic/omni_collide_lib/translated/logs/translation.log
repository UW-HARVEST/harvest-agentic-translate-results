pub unsafe extern "C" fn c2Support(
    mut verts: *const c2v,
    mut count: ::core::ffi::c_int,
    mut d: c2v,
) -> ::core::ffi::c_int {
    let mut imax: ::core::ffi::c_int = 0 as ::core::ffi::c_int;
    let mut dmax: ::core::ffi::c_float = c2Dot(*verts.offset(0 as ::core::ffi::c_int as isize), d);
    let mut i: ::core::ffi::c_int = 1 as ::core::ffi::c_int;
    while i < count {
        let mut dot: ::core::ffi::c_float = c2Dot(*verts.offset(i as isize), d);
        if dot > dmax {
            imax = i;
            dmax = dot;
        }
        i += 1;
    }
    return imax;
}
