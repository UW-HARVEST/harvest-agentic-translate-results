pub fn cJSON_DetachItemViaPointer(
    parent: Option<&mut cJSON>,
    item: Option<&mut cJSON>,
) -> Option<&mut cJSON> {
    let parent = parent?;
    let item = item?;

    let parent_child_ptr = parent.child.as_deref_mut().map(|child| child as *mut cJSON);
    let item_ptr = item as *mut cJSON;
    let item_prev_ptr = item.prev.as_deref_mut().map(|prev| prev as *mut cJSON);
    let item_next_ptr = item.next.as_deref_mut().map(|next| next as *mut cJSON);

    if parent_child_ptr != Some(item_ptr) && item_prev_ptr.is_none() {
        return None;
    }

    if parent_child_ptr != Some(item_ptr) {
        if let Some(prev) = item.prev.as_deref_mut() {
            prev.next = item.next.take();
        }
    }

    if let Some(next) = item.next.as_deref_mut() {
        next.prev = item.prev.take();
    }

    if parent_child_ptr == Some(item_ptr) {
        parent.child = item.next.take();
    } else if item_next_ptr.is_none() {
        if let Some(child) = parent.child.as_deref_mut() {
            child.prev = item.prev.take();
        }
    }

    item.prev = None;
    item.next = None;
    Some(item)
}
</FUNC>
