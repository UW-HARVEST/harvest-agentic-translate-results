<FUNC>
fn get_object_item<'a>(
    object: Option<&'a cJSON>,
    name: &str,
    case_sensitive: bool,
) -> Option<&'a cJSON> {
    let mut current_element = object.and_then(|obj| obj.child.as_deref());

    if case_sensitive {
        while let Some(element) = current_element {
            match element.string.as_deref() {
                Some(s) if s == name => return Some(element),
                _ => current_element = element.next.as_deref(),
            }
        }
    } else {
        while let Some(element) = current_element {
            match element.string.as_deref() {
                Some(s) if s.eq_ignore_ascii_case(name) => return Some(element),
                _ => current_element = element.next.as_deref(),
            }
        }
    }

    None
}
</FUNC>

