<FUNC>
fn get_object_item(
    object: *const cJSON,
    name: *const ::core::ffi::c_char,
    case_sensitive: cJSON_bool,
) -> *mut cJSON {
    if object.is_null() || name.is_null() {
        return ::core::ptr::null_mut();
    }

    let mut current_element = unsafe { (*object).child as *mut cJSON };

    while !current_element.is_null() {
        let current_name = unsafe { (*current_element).string };
        if !current_name.is_null() {
            let matches = if case_sensitive != 0 {
                unsafe { strcmp(name, current_name) == 0 }
            } else {
                unsafe {
                    case_insensitive_strcmp(
                        name as *const ::core::ffi::c_uchar,
                        current_name as *const ::core::ffi::c_uchar,
                    ) == 0
                }
            };

            if matches {
                return current_element;
            }
        }

        current_element = unsafe { (*current_element).next as *mut cJSON };
    }

    ::core::ptr::null_mut()
}
</FUNC>

