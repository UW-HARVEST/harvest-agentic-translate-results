









pub type btac1c_idxstate = btac1c_idxstate_s;
#[derive(Copy, Clone)]
#[repr(C)]
pub struct btac1c_idxstate_s {
    pub idx: btac1c_u16,
    pub lpred: btac1c_s16,
    pub rpred: btac1c_s16,
    pub tag: btac1c_byte,
    pub bcfcn: btac1c_byte,
    pub bsfcn: btac1c_byte,
    pub usefx: btac1c_byte,
    pub firfx: [[btac1c_s16; 8]; 4],
}
pub type btac1c_s16 = ::core::ffi::c_short;
pub type btac1c_byte = ::core::ffi::c_uchar;
pub type btac1c_u16 = ::core::ffi::c_ushort;
unsafe extern "C" fn BTAC1C2_PredictSample(
    mut psamp: *mut ::core::ffi::c_int,
    mut idx: ::core::ffi::c_int,
    mut pfcn: ::core::ffi::c_int,
    mut ridx: *mut btac1c_idxstate,
) -> ::core::ffi::c_int {
     let mut pred: i32 = 0;
let mut p0: i32 = 0;
let mut p1: i32 = 0;
let mut i: i32 = idx;

match pfcn {
    0 => {
        pred = psamp.wrapping_offset(((i - 1) & 7) as isize).read();
    }
    1 => {
        pred = 2 * psamp.wrapping_offset(((i - 1) & 7) as isize).read()
            - psamp.wrapping_offset(((i - 2) & 7) as isize).read();
    }
    2 => {
        pred = (3 * psamp.wrapping_offset(((i - 1) & 7) as isize).read()
            - psamp.wrapping_offset(((i - 2) & 7) as isize).read())
            >> 1;
    }
    3 => {
        pred = (5 * psamp.wrapping_offset(((i - 1) & 7) as isize).read()
            - psamp.wrapping_offset(((i - 2) & 7) as isize).read())
            >> 2;
    }
    4 => {
        p0 = psamp.wrapping_offset(((i - 1) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 2) & 7) as isize).read();
        p1 = psamp.wrapping_offset(((i - 2) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 3) & 7) as isize).read();
        pred = p0 - (p1 >> 1);
    }
    5 => {
        p0 = psamp.wrapping_offset(((i - 1) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 2) & 7) as isize).read();
        p1 = psamp.wrapping_offset(((i - 2) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 3) & 7) as isize).read();
        pred = (3 * p0 - p1) >> 2;
    }
    6 => {
        p0 = psamp.wrapping_offset(((i - 1) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 2) & 7) as isize).read();
        p1 = psamp.wrapping_offset(((i - 2) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 3) & 7) as isize).read();
        pred = (5 * p0 - p1) >> 3;
    }
    7 => {
        pred = (18 * *psamp.add(((i - 1) & 7) as usize)
    - 4 * *psamp.add(((i - 2) & 7) as usize)
    + 3 * *psamp.add(((i - 3) & 7) as usize)
    - 2 * *psamp.add(((i - 4) & 7) as usize)
    + *psamp.add(((i - 5) & 7) as usize))
    / 16;

        }
    8 => {
        pred = (
    72 * unsafe { *psamp.offset(((i - 1) & 7) as isize) }
        - 16 * unsafe { *psamp.offset(((i - 2) & 7) as isize) }
        + 12 * unsafe { *psamp.offset(((i - 3) & 7) as isize) }
        - 8 * unsafe { *psamp.offset(((i - 4) & 7) as isize) }
        + 5 * unsafe { *psamp.offset(((i - 5) & 7) as isize) }
        - 3 * unsafe { *psamp.offset(((i - 6) & 7) as isize) }
        + 3 * unsafe { *psamp.offset(((i - 7) & 7) as isize) }
        - unsafe { *psamp.offset(((i - 8) & 7) as isize) }
) / 64;

        }
    9 => {
        pred = (76 * unsafe { *psamp.add(((i - 1) & 7) as usize) }
    - 17 * unsafe { *psamp.add(((i - 2) & 7) as usize) }
    + 10 * unsafe { *psamp.add(((i - 3) & 7) as usize) }
    - 7 * unsafe { *psamp.add(((i - 4) & 7) as usize) }
    + 5 * unsafe { *psamp.add(((i - 5) & 7) as usize) }
    - 4 * unsafe { *psamp.add(((i - 6) & 7) as usize) }
    + 4 * unsafe { *psamp.add(((i - 7) & 7) as usize) }
    - 3 * unsafe { *psamp.add(((i - 8) & 7) as usize) })
    / 64;

        }
    10 => {
        p0 = psamp.wrapping_offset(((i - 1) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 2) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 3) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 4) & 7) as isize).read();
        p1 = psamp.wrapping_offset(((i - 5) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 6) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 7) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 8) & 7) as isize).read();
        pred = (5 * p0 - p1) >> 4;
    }
    11 => {
        p0 = psamp.wrapping_offset(((i - 1) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 2) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 3) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 4) & 7) as isize).read();
        p1 = psamp.wrapping_offset(((i - 5) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 6) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 7) & 7) as isize).read()
            + psamp.wrapping_offset(((i - 8) & 7) as isize).read();
        pred = (p0 + p1) >> 3;
    }
    12 | 13 | 14 | 15 => {
        let fir = unsafe { &(*ridx).firfx[(pfcn - 12) as usize] };
pred = (
    fir[0] as i32 * unsafe { *psamp.offset(((i - 1) & 7) as isize) }
        + fir[1] as i32 * unsafe { *psamp.offset(((i - 2) & 7) as isize) }
        + fir[2] as i32 * unsafe { *psamp.offset(((i - 3) & 7) as isize) }
        + fir[3] as i32 * unsafe { *psamp.offset(((i - 4) & 7) as isize) }
        + fir[4] as i32 * unsafe { *psamp.offset(((i - 5) & 7) as isize) }
        + fir[5] as i32 * unsafe { *psamp.offset(((i - 6) & 7) as isize) }
        + fir[6] as i32 * unsafe { *psamp.offset(((i - 7) & 7) as isize) }
        + fir[7] as i32 * unsafe { *psamp.offset(((i - 8) & 7) as isize) }
) / 256;

        }
    _ => {
        pred = 0;
    }
}

pred


}

unsafe extern "C" fn BTAC1C2_PredictSample_Pfn0(
    mut psamp: *mut ::core::ffi::c_int,
    mut idx: ::core::ffi::c_int,
    mut pfcn: ::core::ffi::c_int,
    mut ridx: *mut btac1c_idxstate,
) -> ::core::ffi::c_int {
    return *psamp.offset((idx - 1 as ::core::ffi::c_int & 7 as ::core::ffi::c_int) as isize);
}
