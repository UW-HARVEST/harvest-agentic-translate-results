pub unsafe extern "C" fn os_realloc(
    mut ptr: *mut ::core::ffi::c_void,
    mut new_size: size_t,
) -> *mut ::core::ffi::c_void {
    let mut out: *mut ::core::ffi::c_void = realloc(ptr, new_size);
    if out.is_null() {
        fprintf(
            stderr as *mut FILE,
            b"Memory allocation failed in os_realloc\0" as *const u8 as *const ::core::ffi::c_char,
        );
        exit(EXIT_FAILURE);
    }
    return out;
}
