<FUNC>
pub fn stbds_arrgrowf(
    a: Option<Vec<u8>>,
    elemsize: usize,
    addlen: usize,
    min_cap: usize,
) -> Vec<u8> {
    let current_len_elems = a
        .as_ref()
        .map(|v| if elemsize == 0 { 0 } else { v.len() / elemsize })
        .unwrap_or(0);

    let current_cap_elems = a
        .as_ref()
        .map(|v| if elemsize == 0 { 0 } else { v.capacity() / elemsize })
        .unwrap_or(0);

    let min_len = current_len_elems.saturating_add(addlen);
    let mut target_cap = cmp::max(min_cap, min_len);

    if target_cap <= current_cap_elems {
        return a.unwrap_or_default();
    }

    if target_cap < 2usize.saturating_mul(current_cap_elems) {
        target_cap = 2usize.saturating_mul(current_cap_elems);
    } else if target_cap < 4 {
        target_cap = 4;
    }

    let needed_bytes = target_cap.saturating_mul(elemsize);

    let mut v = a.unwrap_or_default();
    if v.capacity() < needed_bytes {
        v.reserve(needed_bytes.saturating_sub(v.capacity()));
    }
    v
}
