<FUNC>
pub fn allocate_matrix(
    width: ::core::ffi::c_int,
    height: ::core::ffi::c_int,
) -> *mut matrix_t {
    if width < 0 || height < 0 {
        eprintln!("Failed to allocate matrix: negative dimensions");
        return ::core::ptr::null_mut();
    }

    let width_usize = match usize::try_from(width) {
        Ok(v) => v,
        Err(_) => {
            eprintln!("Failed to allocate matrix: invalid width");
            return ::core::ptr::null_mut();
        }
    };
    let height_usize = match usize::try_from(height) {
        Ok(v) => v,
        Err(_) => {
            eprintln!("Failed to allocate matrix: invalid height");
            return ::core::ptr::null_mut();
        }
    };

    let mut row_ptrs: Vec<*mut ::core::ffi::c_int> = Vec::with_capacity(height_usize);

    for _ in 0..height_usize {
        let mut row: Vec<::core::ffi::c_int> = vec![0; width_usize];
        let row_ptr = row.as_mut_ptr();
        ::core::mem::forget(row);
        row_ptrs.push(row_ptr);
    }

    let matrix_ptr = row_ptrs.as_mut_ptr();
    ::core::mem::forget(row_ptrs);

    let mat = Box::new(matrix_t {
        width,
        height,
        matrix: matrix_ptr,
    });

    Box::into_raw(mat)
}
</FUNC>

