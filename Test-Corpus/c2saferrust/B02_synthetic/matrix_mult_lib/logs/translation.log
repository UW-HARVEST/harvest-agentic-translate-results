pub fn allocate_matrix(width: ::core::ffi::c_int, height: ::core::ffi::c_int) -> Option<matrix_t> {
    if width < 0 || height < 0 {
        eprintln!("Failed to allocate matrix: negative dimensions");
        return None;
    }

    let width_usize = width as usize;
    let height_usize = height as usize;

    let mut rows = Vec::with_capacity(height_usize);
    for _ in 0..height_usize {
        rows.push(vec![0; width_usize]);
    }

    Some(matrix_t {
        width,
        height,
        matrix: rows,
    })
}
