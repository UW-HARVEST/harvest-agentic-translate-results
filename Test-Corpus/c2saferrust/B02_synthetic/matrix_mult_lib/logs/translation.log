<FUNC>
pub fn multiply_matrices(mat_a: &matrix_t, mat_b: &matrix_t) -> Option<matrix_t> {
    if mat_a.width != mat_b.height {
        eprintln!("Matrix dimensions do not allow multiplication.");
        return None;
    }

    let mut result = allocate_matrix(mat_b.width, mat_a.height);

    for i in 0..mat_a.height {
        for j in 0..mat_b.width {
            result.matrix[i as usize][j as usize] = 0;
            for k in 0..mat_a.width {
                result.matrix[i as usize][j as usize] +=
                    mat_a.matrix[i as usize][k as usize] * mat_b.matrix[k as usize][j as usize];
            }
        }
    }

    Some(result)
}
</FUNC>
