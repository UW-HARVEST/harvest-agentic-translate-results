pub unsafe extern "C" fn compute_weighted_sum(mut arr: *mut ResultArray) -> ::core::ffi::c_int {
    let mut sum: ::core::ffi::c_int = 0 as ::core::ffi::c_int;
    let mut i: ::core::ffi::c_int = 0 as ::core::ffi::c_int;
    while i < (*arr).count {
        let mut current: *mut Result_0 =
            (&raw mut (*arr).data as *mut Result_0).offset(i as isize) as *mut Result_0;
        let mut base: *mut Result_0 = (&raw mut (*arr).data as *mut Result_0)
            .offset(0 as ::core::ffi::c_int as isize)
            as *mut Result_0;
        let mut weight: ::core::ffi::c_int = if current > base {
            current.offset_from(base) as ::core::ffi::c_long as ::core::ffi::c_int
        } else {
            1 as ::core::ffi::c_int
        };
        let mut weighted: ::core::ffi::c_double =
            (*current).value as ::core::ffi::c_double * weight as ::core::ffi::c_double * 0.8f64;
        sum += safe_double_to_int(weighted);
        i += 1;
    }
    return sum;
}
