pub fn create_state(
    initial_val: ::core::ffi::c_int,
    capacity: ::core::ffi::c_int,
) -> *mut ProcessState {
    if capacity <= 0 {
        println!("Error: Failed to allocate buffer");
        return ptr::null_mut();
    }

    let capacity_usize = capacity as usize;

    let mut state = Box::new(ProcessState {
        flags: Default::default(),
        data: Default::default(),
        capacity,
        buffer: ptr::null_mut(),
    });

    state.flags.set_flag1(1);
    state.flags.set_flag2(0);
    state.flags.set_flag3(1);
    state.flags.set_counter(0);
    state.flags.set_mode(3);
    state.flags.set_status(15);
    state.flags.set_reserved(0);

    state.data.int_val = initial_val;

    let text = format!("State:{}:Mode:{}", initial_val, state.flags.mode());
    let mut bytes = text.into_bytes();
    bytes.push(0);

    let mut buffer = vec![0 as ::core::ffi::c_char; capacity_usize];
    let copy_len = bytes.len().saturating_sub(1).min(capacity_usize.saturating_sub(1));
    for i in 0..copy_len {
        buffer[i] = bytes[i] as ::core::ffi::c_char;
    }

    let boxed_slice = buffer.into_boxed_slice();
    let buffer_ptr = Box::into_raw(boxed_slice) as *mut ::core::ffi::c_char;
    state.buffer = buffer_ptr;

    Box::into_raw(state)
}
