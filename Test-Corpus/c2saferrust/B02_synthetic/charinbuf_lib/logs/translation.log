<FUNC>
pub fn find_char_in_buffer(
    buffer: Option<&CStr>,
    size: usize,
    target: ::core::ffi::c_char,
) -> Option<usize> {
    let bytes = match buffer {
        Some(s) => s.to_bytes(),
        None => return None,
    };

    let search_len = size.min(bytes.len());
    let target = target as u8;

    bytes[..search_len].iter().position(|&b| b == target)
}
</FUNC>

<CALL>
found_pos = match if buffer.is_null() {
    None
} else {
    Some(unsafe { CStr::from_ptr(buffer) })
} {
    Some(cstr) => match find_char_in_buffer(Some(cstr), buf_size, search_char) {
        Some(pos) => unsafe { buffer.add(pos) as *mut ::core::ffi::c_char },
        None => ::core::ptr::null_mut(),
    },
    None => ::core::ptr::null_mut(),
};
</CALL>
