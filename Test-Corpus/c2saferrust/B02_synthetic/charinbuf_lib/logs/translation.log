```rust
pub unsafe extern "C" fn create_buffer(
    mut initial: *const ::core::ffi::c_char,
) -> *mut ::core::ffi::c_char {
    if initial.is_null() {
        return ::core::ptr::null_mut::<::core::ffi::c_char>();
    }
    let mut len: size_t = strlen(initial);
    let mut buffer: *mut ::core::ffi::c_char =
        malloc(len.wrapping_add(1 as size_t)) as *mut ::core::ffi::c_char;
    if !buffer.is_null() {
        strcpy(buffer, initial);
    }
    return buffer;
}
```
