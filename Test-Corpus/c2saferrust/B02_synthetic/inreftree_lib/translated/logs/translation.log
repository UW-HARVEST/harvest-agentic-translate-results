pub unsafe extern "C" fn calculate_tree_sum(mut node_id: ::core::ffi::c_int) -> ::core::ffi::c_int {
    let mut node: *mut TreeNode = find_node_by_id(node_id);
    if node.is_null() || (*node).id != node_id {
        return 0 as ::core::ffi::c_int;
