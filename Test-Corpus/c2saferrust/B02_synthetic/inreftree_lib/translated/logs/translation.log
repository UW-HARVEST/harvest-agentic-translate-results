```rust
pub unsafe extern "C" fn parse_operation(mut op_str: *const ::core::ffi::c_char) -> Operation {
    if op_str.is_null() || !strchr(op_str, '+' as i32).is_null() {
        return OP_ADD;
    }
    if !strchr(op_str, '*' as i32).is_null() {
        return OP_MULTIPLY;
    }
    if !strchr(op_str, '-' as i32).is_null() {
        return OP_SUBTRACT;
    }
    if !strchr(op_str, '/' as i32).is_null() {
        return OP_DIVIDE;
    }
    if !strchr(op_str, '%' as i32).is_null() {
        return OP_MODULO;
    }
    return OP_ADD;
}
```
