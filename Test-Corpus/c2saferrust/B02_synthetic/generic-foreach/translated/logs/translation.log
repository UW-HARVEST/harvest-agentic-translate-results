pub fn list_item_t_destroy(list: *mut list_item_t_t) {
    if list.is_null() {
        return;
    }

    unsafe {
        let mut current = (*list).head;
        while !current.is_null() {
            let next = (*current).next;
            drop(Box::from_raw(current));
            current = next;
        }
        drop(Box::from_raw(list));
    }
}
