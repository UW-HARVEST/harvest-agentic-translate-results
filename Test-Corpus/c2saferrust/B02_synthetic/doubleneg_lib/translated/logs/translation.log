pub unsafe extern "C" fn find_value_in_buffer(
    mut buffer: *const ::core::ffi::c_char,
    mut size: size_t,
    mut search_val: ::core::ffi::c_int,
) -> ::core::ffi::c_int {
    let mut target: ::core::ffi::c_char = search_val as ::core::ffi::c_char;
    let mut result: *mut ::core::ffi::c_void = memchr(
        buffer as *const ::core::ffi::c_void,
