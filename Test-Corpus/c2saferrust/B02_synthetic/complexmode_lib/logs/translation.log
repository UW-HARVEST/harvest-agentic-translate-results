pub fn compare_operations(op1: Option<&str>, op2: Option<&str>) -> i32 {
    match (op1, op2) {
        (Some(op1), Some(op2)) => {
            use std::cmp::Ordering;
            match op1.cmp(op2) {
                Ordering::Less => -1,
                Ordering::Equal => 0,
                Ordering::Greater => 1,
            }
        }
        _ => {
            println!("One or both operation strings are NULL");
            -1
        }
    }
}
