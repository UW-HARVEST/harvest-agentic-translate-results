                res_tracker.operation[..bytes.len()].copy_from_slice(bytes);
            }
            if check_permissions(permissions, 0o100) != 0 {
                result = value1 * value2 + value3;
            } else {
                result = value1 + value2 + value3;
            }
            res_tracker.value = result;
            println!("Mode 4: Complex Calculation");
            println!("Result: {}", result);
