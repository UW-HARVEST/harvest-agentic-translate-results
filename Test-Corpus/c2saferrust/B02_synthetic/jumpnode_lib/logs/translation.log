unsafe extern "C" fn process_backward(
    mut array: *mut ::core::ffi::c_int,
    mut size: size_t,
    mut start_offset: ::core::ffi::c_int,
) -> ::core::ffi::c_int {
    let mut sum: ::core::ffi::c_int = 0 as ::core::ffi::c_int;
    let mut ptr: *mut ::core::ffi::c_int = ::core::ptr::null_mut::<::core::ffi::c_int>();
    let mut start: *mut ::core::ffi::c_int = ::core::ptr::null_mut::<::core::ffi::c_int>();
    ptr = array.offset(size as isize);
    start = array.offset(start_offset as isize);
    while ptr > start {
        ptr = ptr.offset(-1);
        sum += *ptr;
    }
    return sum;
}
```
