        atoi(&raw mut *args.offset(2 as ::core::ffi::c_int as isize) as *mut ::core::ffi::c_char)
    } else {
        1 as ::core::ffi::c_int
    };
    users[user_count as usize].logged_in = 0 as ::core::ffi::c_int;
    user_count += 1;
