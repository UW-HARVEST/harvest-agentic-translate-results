        element = *array.offset(idx as isize);
        while keep != 0 {
            total += element;
            keep = (keep == 0) as ::core::ffi::c_int;
        }
        keep = (keep == 0) as ::core::ffi::c_int;
        idx += 1;
    }
    return total;
