pub unsafe extern "C" fn calculate_checksum(
    mut data: *const uint8_t,
    mut length: size_t,
) -> uint32_t {
    let mut sum: uint32_t = 0 as uint32_t;
    let mut i: size_t = 0 as size_t;
    while i < length {
        sum = sum << 3 as ::core::ffi::c_int ^ *data.offset(i as isize) as uint32_t;
        i = i.wrapping_add(1);
    }
    return sum;
}
```
