<IMPORTS>
use std::ffi::CStr;
use std::fs::File;
use std::io::{BufRead, BufReader, Write};
</IMPORTS>

<FUNC>
pub fn open_with_cleanup(filename: *const ::core::ffi::c_char) -> Option<File> {
    let filename_str = unsafe { CStr::from_ptr(filename) };
    let filename_owned = filename_str.to_string_lossy().into_owned();

    match File::open(&filename_owned) {
        Ok(file) => {
            let reader_file = match file.try_clone() {
                Ok(f) => f,
                Err(_) => {
                    eprintln!("Error: opening or processing file {}", filename_owned);
                    return None;
                }
            };

            let mut reader = BufReader::new(reader_file);
            let mut line = String::new();

            loop {
                line.clear();
                match reader.read_line(&mut line) {
                    Ok(0) => break,
                    Ok(_) => {
                        print!("{}", line);
                    }
                    Err(_) => {
                        eprintln!("Error: opening or processing file {}", filename_owned);
                        return None;
                    }
                }
            }

            if std::io::stdout().flush().is_err() {
                eprintln!("Error: opening or processing file {}", filename_owned);
                return None;
            }

            Some(file)
        }
        Err(_) => {
            eprintln!("Error: opening or processing file {}", filename_owned);
            None
        }
    }
}
</FUNC>

