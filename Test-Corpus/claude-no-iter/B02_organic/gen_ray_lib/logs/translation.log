abs_yAe_x = if yAe.x < 0.0 { -yAe.x } else { yAe.x };\n    let abs_yAp_x = if yAp.x < 0.0 { -yAp.x } else { yAp.x };\n    let min_abs = if abs_yAe_x < abs_yAp_x {\n        abs_yAe_x\n    } else {\n        abs_yAp_x\n    };\n    if yAe.x * yAp.x < 0.0 || min_abs < B.r {\n        let Ca = c2Circle { p: B.a, r: B.r };\n        let Cb = c2Circle { p: B.b, r: B.r };\n        if abs_yAp_x < B.r {\n            if yAp.y < 0.0 {\n                return c2RaytoCircle(A, Ca, out);\n            } else {\n                return c2RaytoCircle(A, Cb, out);\n            }\n        } else {\n            let c = if yAp.x > 0.0 { B.r } else { -B.r };\n            let d = yAe.x - yAp.x;\n            let t = (c - yAp.x) / d;\n            let y = yAp.y + (yAe.y - yAp.y) * t;\n            if y <= 0.0 {\n                return c2RaytoCircle(A, Ca, out);\n            }\n            if y >= yBb.y {\n                return c2RaytoCircle(A, Cb, out);\n            } else {\n                out.n = if c > 0.0 { M.x } else { c2Skew(M.y) };\n                out.t = t * A.t;\n                return 1;\n            }\n        }\n    }\n    0\n}\n\nfn c2CastRay_circle(A: c2Ray, B: &c2Circle, out: &mut c2Raycast) -> c_int {\n    c2RaytoCircle(A, *B, out)\n}\n\nfn c2CastRay_aabb(A: c2Ray, B: &c2AABB, out: &mut c2Raycast) -> c_int {\n    c2RaytoAABB(A, *B, out)\n}\n\nfn c2CastRay_capsule(A: c2Ray, B: &c2Capsule, out: &mut c2Raycast) -> c_int {\n    c2RaytoCapsule(A, *B, out)\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn gen_ray(\n    cast1: *mut c2Raycast,\n    cast2: *mut c2Raycast,\n    cast3: *mut c2Raycast,\n    mp_x: f32,\n    mp_y: f32,\n    r_p_x: f32,\n    r_p_y: f32,\n    c_p_x: f32,\n    c_p_y: f32,\n    c_r: f32,\n    cap_a_x: f32,\n    cap_a_y: f32,\n    cap_b_x: f32,\n    cap_b_y: f32,\n    cap_r: f32,\n    bb_min_x: f32,\n    bb_min_y: f32,\n    bb_max_x: f32,\n    bb_max_y: f32,\n) -> c_int {\n    let mut hit: c_int = 0;\n\n    let mp = c2V(mp_x, mp_y);\n\n    let mut ray = c2Ray