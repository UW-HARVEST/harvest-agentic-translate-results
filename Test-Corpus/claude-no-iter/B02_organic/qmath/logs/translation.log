n        while i < bytes.len() && bytes[i].is_ascii_digit() {\n            i += 1;\n            has_digit = true;\n        }\n    }\n\n    if !has_digit {\n        return 0.0;\n    }\n\n    // Optional exponent.\n    let mut end = i;\n    if i < bytes.len() && (bytes[i] == b'e' || bytes[i] == b'E') {\n        let mut j = i + 1;\n        if j < bytes.len() && (bytes[j] == b'+' || bytes[j] == b'-') {\n            j += 1;\n        }\n        let exp_digits_start = j;\n        while j < bytes.len() && bytes[j].is_ascii_digit() {\n            j += 1;\n        }\n        if j > exp_digits_start {\n            end = j;\n        }\n    }\n\n    let slice = &s[start..end];\n    slice.parse::<f64>().unwrap_or(0.0)\n}\n\nfn main() {\n    let args: Vec<String> = env::args().collect();\n    let argc = args.len();\n\n    if argc != 4 {\n        eprintln!(\"{} requires 4 inputs\", args[0]);\n        exit(1);\n    }\n\n    let mut inputs: [f32; 3] = [\n        c_atof(&args[1]) as f32,\n        c_atof(&args[2]) as f32,\n        c_atof(&args[3]) as f32,\n    ];\n\n    vector_normalize_fast(&mut inputs);\n\n    // C's printf(\"%f %f %f\\n\", ...) promotes float -> double and prints with\n    // default precision of 6 decimal digits.\n    println!(\n        \"{:.6} {:.6} {:.6}\",\n        inputs[0] as f64, inputs[1] as f64, inputs[2] as f64\n    );\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":132,"cache_read_input_tokens":32499,"cache_creation":{"ephemeral_5m_input_tokens":132,"ephemeral_1h_input_tokens":0},"output_tokens":37,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"95a5a67f-5317-486b-a5f5-516aa320b477","uuid":"8607c1eb-d3e1-43c2-9ca9-d56145014d0d"}
