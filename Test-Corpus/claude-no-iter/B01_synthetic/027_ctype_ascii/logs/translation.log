nt;\n    fn iscntrl(c: c_int) -> c_int;\n    fn isgraph(c: c_int) -> c_int;\n    fn isspace(c: c_int) -> c_int;\n    fn isblank(c: c_int) -> c_int;\n    fn isprint(c: c_int) -> c_int;\n    fn ispunct(c: c_int) -> c_int;\n    fn tolower(c: c_int) -> c_int;\n    fn toupper(c: c_int) -> c_int;\n}\n\n// LC_ALL value on glibc/Linux\nconst LC_ALL: c_int = 6;\n\n// Write a single byte (matches C's printf(\"%c\", int) which writes the\n// low 8 bits of the int as one byte to stdout).\nfn write_byte(stdout: &mut impl Write, val: c_int) {\n    let b: u8 = (val & 0xFF) as u8;\n    let _ = stdout.write_all(&[b]);\n}\n\nfn driver(c: c_int) {\n    // setlocale(LC_ALL, \"C\");\n    unsafe {\n        let loc = b\"C\\0\";\n        setlocale(LC_ALL, loc.as_ptr() as *const c_char);\n    }\n\n    let stdout = io::stdout();\n    let mut out = stdout.lock();\n\n    unsafe {\n        let _ = write!(out, \"alphanumeric: {}\\n\", isalnum(c));\n        let _ = write!(out, \"alphabetic: {}\\n\", isalpha(c));\n        let _ = write!(out, \"lowercase: {}\\n\", islower(c));\n        let _ = write!(out, \"uppercase: {}\\n\", isupper(c));\n        let _ = write!(out, \"digit: {}\\n\", isdigit(c));\n        let _ = write!(out, \"hexadecimal: {}\\n\", isxdigit(c));\n        let _ = write!(out, \"control: {}\\n\", iscntrl(c));\n        let _ = write!(out, \"graphical: {}\\n\", isgraph(c));\n        let _ = write!(out, \"space: {}\\n\", isspace(c));\n        let _ = write!(out, \"blank: {}\\n\", isblank(c));\n        let _ = write!(out, \"printing: {}\\n\", isprint(c));\n        let _ = write!(out, \"punctuation: {}\\n\", ispunct(c));\n\n        let _ = write!(out, \"to lower: \");\n        let lower = tolower(c);\n        write_byte(&mut out, lower);\n        let _ = out.write_all(b\"\\n\");\n\n        let _ = write!(out, \"to upper: \");\n        let upper = toupper(c);\n        write_byte(&mut out, upper);\n        let _ = out.write_all(b\"\\n\");\n    }\n\n    let _ = out.flush();\n}\n\nfn main() {\n    // Mirror C's `char c = getchar();` semantics. getchar() returns\n    // int: -1 (EOF) or unsigned-byte 0..=255. Storing into `char`\n    // narrows it. On platforms where char is signed (the common case\n    // for x86_64 Linux) and EOF is -1, the stored value is -1 (0xFF\n    // pattern) which sign-extends back to -1 when promoted to int for\n    // the ctype calls.\n    let mut buf = [0u8; 1];\n    let read_result = io::stdin().lock().read(&mut buf);\n\n    let c_int_val: c_int = match read_result {\n        Ok(0) => -1, // EOF -> getchar returns -1, char(-1) sign-extends to int(-1)\n        Ok(_) => {\n            // The byte is in 0..=255. C does `char c = getchar()`; on a\n            // platform where `char` is signed, bytes 128..=255 sign-extend\n            // to negative ints when passed to the driver. Replicate that.\n            let b = buf[0];\n            // signed-char interpretation\n            (b as i8) as c_int\n        }\n        Err(_) => -1,\n    };\n\n    driver(c_int_val);\n}\n","userModified":false}}
