    let mut c = loop {\n        match read_byte(reader) {\n            Some(b) if matches!(b, b' ' | b'\\t' | b'\\n' | b'\\r' | 0x0B | 0x0C) => continue,\n            Some(b) => break b,\n            None => return None,\n        }\n    };\n\n    // Optional sign.\n    let mut negative = false;\n    if c == b'+' || c == b'-' {\n        negative = c == b'-';\n        match read_byte(reader) {\n            Some(b) => c = b,\n            None => return None,\n        }\n    }\n\n    if !c.is_ascii_digit() {\n        // No digits; nothing matched.\n        return None;\n    }\n\n    // Accumulate digits in i64 with saturation (matches glibc strtoll-on-overflow).\n    // Build as a negative number to handle i64::MIN cleanly.\n    let mut value: i64 = 0;\n    let mut saturated = false;\n    loop {\n        if !c.is_ascii_digit() {\n            break;\n        }\n        let d = (c - b'0') as i64;\n        if !saturated {\n            match value.checked_mul(10).and_then(|v| v.checked_sub(d)) {\n                Some(v) => value = v,\n                None => {\n                    saturated = true;\n                    value = if negative { i64::MIN } else { i64::MAX };\n                }\n            }\n        }\n        match read_byte(reader) {\n            Some(b) => c = b,\n            None => break,\n        }\n    }\n\n    let final_i64 = if saturated {\n        value\n    } else if negative {\n        value\n    } else {\n        // Accumulated as negative; flip sign. Safe because positive magnitudes\n        // up to i64::MAX have been representable as negative throughout.\n        value.wrapping_neg()\n    };\n\n    // Truncate long long → int (matches what glibc does after strtoll).\n    Some(final_i64 as i32)\n}","originalFile":"// Copyright 2025 MIT Lincoln Laboratory\n// Translated from C to Rust.\n\nuse std::io::{self, Read, Write, BufWriter};\n\n/// Mimics C `scanf(\"%d\", &x)`:\n///   - skips leading whitespace (space, tab, \\n, \\r, \\v, \\f)\n///   - reads optional '+' or '-'\n///   - consumes consecutive ASCII digits\n///   - on overflow, clamps to INT_MAX / INT_MIN (glibc behavior)\n///   - if no digits found, leaves x unchanged\nfn scanf_int<R: Read>(reader: &mut R) -> Option<i32> {\n    let mut peeked: Option<u8> = None;\n    let mut buf = [0u8; 1];\n\n    // Helper to read a single byte (with one-byte putback via `peeked`).\n    let mut read_byte = |peeked: &mut Option<u8>, reader: &mut R| -> Option<u8> {\n        if let Some(b) = peeked.take() {\n            return Some(b);\n        }\n        match reader.read(&mut buf) {\n            Ok(0) => None,\n            Ok(_) => Some(buf[0]),\n            Err(_) => None,\n        }\n    };\n\n    // Skip leading whitespace as defined by C isspace() in the C locale.\n    let mut c = loop {\n        match read_byte(&mut peeked, reader) {\n            Some(b) if matches!(b, b' ' | b'\\t' | b'\\n' | b'\\r' | 0x0B | 0x0C) => continue,\n            Some(b) => break b,\n            None => return None,\n        }\n    };\n\n    // Optional sign.\n    let mut negative = false;\n    if c == b'+' || c == b'-' {\n        negative = c == b'-';\n        match read_byte(&mut peeked, reader) {\n            Some(b) => c = b,\n            None => return None,\n        }\n    }\n\n    if !c.is_ascii_digit() {\n        // No digits; nothing matched. (Putback would be discarded anyway.)\n        return None;\n    }\n\n    // Accumulate digits, clamping on overflow like glibc.\n    let mut value: i32 = 0;\n    let mut overflowed = false;\n    loop {\n        if !c.is_ascii_digit() {\n            peeked = Some(c);\n            break;\n        }\n        let d = (c - b'0') as i32;\n        if !overflowed {\n            // value = value * 10 - d  (build as negative to handle INT_MIN cleanly)\n            match value.checked_mul(10).and_then(|v| v.checked_sub(d)) {\n                Some(v) => value = v,\n                None => {\n                    overflowed = true;\n                    value = if negative { i32::MIN } else { i32::MAX };\n                }\n            }\n        }\n        match read_byte(&mut peeked, reader) {\n            Some(b) => c = b,\n            None => break,\n        }\n    }\n\n    let _ = peeked; // discarded: the C program does no further reads\n\n    if overflowed {\n        Some(value)\n    } else if negative {\n        Some(value)\n    } else {\n        // value was accumulated as negative; flip sign.\n        Some(value.wrapping_neg())\n    }\n}\n\nfn print_hex<W: Write>(out: &mut W, bytes: &[u8]) {\n    for b in bytes {\n        write!(out, \"{:02x}\", b).unwrap();\n    }\n    writeln!(out).unwrap();\n}\n\nfn driver<W: Write>(out: &mut W, x: i32) {\n    // Match C: print the raw bytes of `int x` in native (little-endian on x86) order.\n    let bytes = x.to_ne_bytes();\n    print_hex(out, &bytes);\n}\n\nfn main() {\n    let stdin = io::stdin();\n    let stdout = io::stdout();\n    let mut input = stdin.lock();\n    let mut output = BufWriter::new(stdout.lock());\n\n    let x: i32 = scanf_int(&mut input).unwrap_or(0);\n    driver(&mut output, x);\n}\n","structuredPatch":[{"oldStart":3,"oldLines":21,"newStart":3,"newLines":17,"lines":[" "," use std::io::{self, Read, Write, BufWriter};"," ","-/// Mimics C `scanf(\"%d\", &x)`:","+/// Mimics C `scanf(\"%d\", &x)` as implemented by glibc:"," ///   - skips leading whitespace (space, tab, \\n, \\r, \\v, \\f)"," ///   - reads optional '+' or '-'"," ///   - consumes consecutive ASCII digits","-///   - on overflow, clamps to INT_MAX / INT_MIN (glibc behavior)","+///   - parses through `strtoll` (saturating to LLONG_MAX/LLONG_MIN on overflow),","+///     then truncates the resulting `long long` to `int`"," ///   - if no digits found, leaves x unchanged"," fn scanf_int<R: Read>(reader: &mut R) -> Option<i32> {","-    let mut peeked: Option<u8> = None;","     let mut buf = [0u8; 1];"," ","-    // Helper to read a single byte (with one-byte putback via `peeked`).","-    let mut