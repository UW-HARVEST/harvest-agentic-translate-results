useT as *const u8,\n            std::mem::size_of::<HouseT>(),\n        )\n    };\n    print_hex(bytes);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":284,"cache_read_input_tokens":17660,"cache_creation":{"ephemeral_5m_input_tokens":284,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"205eff14-8764-47b2-a256-2d9d43d5cdcc","uuid":"399f6c5e-b98c-4859-a6c9-01bf00f71a7e"}
