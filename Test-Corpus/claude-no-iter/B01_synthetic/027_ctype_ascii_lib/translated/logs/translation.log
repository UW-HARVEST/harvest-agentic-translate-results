let fmt_hex = CString::new(\"hexadecimal: %d\\n\").unwrap();\n    let fmt_cntrl = CString::new(\"control: %d\\n\").unwrap();\n    let fmt_graph = CString::new(\"graphical: %d\\n\").unwrap();\n    let fmt_space = CString::new(\"space: %d\\n\").unwrap();\n    let fmt_blank = CString::new(\"blank: %d\\n\").unwrap();\n    let fmt_print = CString::new(\"printing: %d\\n\").unwrap();\n    let fmt_punct = CString::new(\"punctuation: %d\\n\").unwrap();\n    let fmt_to_lower = CString::new(\"to lower: %c\\n\").unwrap();\n    let fmt_to_upper = CString::new(\"to upper: %c\\n\").unwrap();\n\n    unsafe {\n        printf(fmt_d.as_ptr(), isalnum(arg));\n        printf(fmt_alpha.as_ptr(), isalpha(arg));\n        printf(fmt_lower.as_ptr(), islower(arg));\n        printf(fmt_upper.as_ptr(), isupper(arg));\n        printf(fmt_digit.as_ptr(), isdigit(arg));\n        printf(fmt_hex.as_ptr(), isxdigit(arg));\n        printf(fmt_cntrl.as_ptr(), iscntrl(arg));\n        printf(fmt_graph.as_ptr(), isgraph(arg));\n        printf(fmt_space.as_ptr(), isspace(arg));\n        printf(fmt_blank.as_ptr(), isblank(arg));\n        printf(fmt_print.as_ptr(), isprint(arg));\n        printf(fmt_punct.as_ptr(), ispunct(arg));\n        printf(fmt_to_lower.as_ptr(), tolower(arg));\n        printf(fmt_to_upper.as_ptr(), toupper(arg));\n    }\n}\n","userModified":false}}
