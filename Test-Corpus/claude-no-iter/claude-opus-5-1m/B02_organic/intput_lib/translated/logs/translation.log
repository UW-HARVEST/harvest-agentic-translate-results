30\t  }\n531\t  data = len << (STBDS_SIZE_T_BITS-8);\n532\t  switch (len - i) {\n533\t    case 7: data |= ((size_t) d[6] << 24) << 24;\n534\t    case 6: data |= ((size_t) d[5] << 20) << 20;\n535\t    case 5: data |= ((size_t) d[4] << 16) << 16;\n536\t    case 4: data |= (d[3] << 24);\n537\t    case 3: data |= (d[2] << 16);\n538\t    case 2: data |= (d[1] << 8);\n539\t    case 1: data |= d[0];\n540\t    case 0: break;\n541\t  }\n542\t  v3 ^= data;\n543\t  for (j=0; j < STBDS_SIPHASH_C_ROUNDS; ++j)\n544\t    STBDS_SIPROUND();\n545\t  v0 ^= data;\n546\t  v2 ^= 0xff;\n547\t  for (j=0; j < STBDS_SIPHASH_D_ROUNDS; ++j)\n548\t    STBDS_SIPROUND();\n549\t\n550\t  return v0^v1^v2^v3;\n551\t}\n552\t\n553\tsize_t stbds_hash_bytes(void *p, size_t len, size_t seed)\n554\t{\n555\t  return stbds_siphash_bytes(p,len,seed);\n556\t}\n557\t\n558\tstatic int stbds_is_key_equal(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode, size_t i)\n559\t{\n560\t  if (mode >= STBDS_HM_STRING)\n561\t    return 0==strcmp((char *) key, * (char **) ((char *) a + elemsize*i + keyoffset));\n562\t  else\n563\t    return 0==memcmp(key, (char *) a + elemsize*i + keyoffset, keysize);\n564\t}\n565\t\n566\t#define STBDS_HASH_TO_ARR(x,elemsize) ((char*) (x) - (elemsize))\n567\t#define STBDS_ARR_TO_HASH(x,elemsize) ((char*) (x) + (elemsize))\n568\t\n569\t#define stbds_hash_table(a)  ((stbds_hash_index *) stbds_header(a)->hash_table)\n570\t\n571\tvoid stbds_hmfree_func(void *a, size_t elemsize)\n572\t{\n573\t  if (a == NULL) return;\n574\t  if (stbds_hash_table(a) != NULL) {\n575\t    if (stbds_hash_table(a)->string.mode == STBDS_SH_STRDUP) {\n576\t      size_t i;\n577\t      for (i=1; i < stbds_header(a)->length; ++i)\n578\t        STBDS_FREE(NULL, *(char**) ((char *) a + elemsize*i));\n579\t    }\n580\t    stbds_strreset(&stbds_hash_table(a)->string);\n581\t  }\n582\t  STBDS_FREE(NULL, stbds_header(a)->hash_table);\n583\t  STBDS_FREE(NULL, stbds_header(a));\n584\t}\n585\t\n586\tst