global_hooks.allocate = hooks->malloc_fn;\n191\t    }\n192\t\n193\t    global_hooks.deallocate = free;\n194\t    if (hooks->free_fn != NULL)\n195\t    {\n196\t        global_hooks.deallocate = hooks->free_fn;\n197\t    }\n198\t\n199\t    /* use realloc only if both free and malloc are used */\n200\t    global_hooks.reallocate = NULL;\n201\t    if ((global_hooks.allocate == malloc) && (global_hooks.deallocate == free))\n202\t    {\n203\t        global_hooks.reallocate = realloc;\n204\t    }\n205\t}\n206\t\n207\t/* Internal constructor. */\n208\tstatic cJSON *cJSON_New_Item(const internal_hooks * const hooks)\n209\t{\n210\t    cJSON* node = (cJSON*)hooks->allocate(sizeof(cJSON));\n211\t    if (node)\n212\t    {\n213\t        memset(node, '\\0', sizeof(cJSON));\n214\t    }\n215\t\n216\t    return node;\n217\t}\n218\t\n219\t/* Delete a cJSON structure. */\n220\tCJSON_PUBLIC(void) cJSON_Delete(cJSON *item)\n221\t{\n222\t    cJSON *next = NULL;\n223\t    while (item != NULL)\n224\t    {\n225\t        next = item->next;\n226\t        if (!(item->type & cJSON_IsReference) && (item->child != NULL))\n227\t        {\n228\t            cJSON_Delete(item->child);\n229\t        }\n230\t        if (!(item->type & cJSON_IsReference) && (item->valuestring != NULL))\n231\t        {\n232\t            global_hooks.deallocate(item->valuestring);\n233\t            item->valuestring = NULL;\n234\t        }\n235\t        if (!(item->type & cJSON_StringIsConst) && (item->string != NULL))\n236\t        {\n237\t            global_hooks.deallocate(item->string);\n238\t            item->string = NULL;\n239\t        }\n240\t        global_hooks.deallocate(item);\n241\t        item = next;\n242\t    }\n243\t}\n244\t\n245\t/* get the decimal point character of the current locale */\n246\tstatic unsigned char get_decimal_point(void)\n247\t{\n248\t#ifdef ENABLE_LOCALES\n249\t    struct lconv *lconv = localeconv();\n250\t    return (unsigned char) lconv->decimal_point[0];\n251\t#else\n252\t    return '.';\n253\t#endif\n254\t}\n255\t\n256\ttypedef struct\n257\t{\n258\t    const unsigned char *content;\n259\t    size_t length;\n260\t    size_t offset;\n261\t    size_t depth; /* How deeply nested (in arrays/objects) is the input at the current offset. */\n262\t    internal_hooks hooks;\n263\t} parse_buffer;\n264\t\n265\t/* check if the given size is left to read in a given parse buffer (starting with 1) */\n266\t#define can_read(buffer, size) ((buffer != NULL) && (((buffer)->offset + size) <= (buffer)->length))\n267\t/* check if the buffer can be accessed at the given index (starting with 0) */\n268\t#define can_access_at_index(buffer, index) ((buffer != NULL) && (((buffer)->offset + index) < (buffer)->length))\n269\t#define cannot_access_at_index(buffer, index) (!can_access_at_index(buffer, index))\n270\t/* get a pointer to the buffer at the position */\n271\t#define buffer_at_offset(buffer) ((buffer)->content + (buffer)->offset)\n272\t\n273\t/* Parse the input text to generate a number, and populate the result into item. */\n274\tstatic cJSON_bool parse_number(cJSON * const item, parse_buffer * const input_buffer)\n275\t{\n276\t    double number = 0;\n277\t    unsigned char *after_end = NULL;\n278\t    unsigned char *number_c_string;\n279\t    unsigned char decimal_point = get_decimal_point();\n280\t    size_t i = 0;\n281\t    size_t number_string_length = 0;\n282\t    cJSON_bool has_decimal_point = false;\n283\t\n284\t    if ((input_buffer == NULL) || (input_buffer->content == NULL))\n285\t    {\n286\t        return false;\n287\t    }\n288\t\n289\t    /* copy the number into a temporary buffer and replace '.' with the decimal point\n290\t     * of the current locale (for strtod)\n291\t     * This also takes care of '\\0' not necessarily being available for marking the end of the input */\n292\t    for (i = 0; can_access_at_index(input_buffer, i); i++)\n293\t    {\n294\t        switch (buffer_at_offset(input_buffer)[i])\n295\t        {\n296\t            case '0':