ur */\n54\tstatic void GetFile_Queue(file_queue *fileq)\n55\t{\n56\t    /* Create the logfile name */\n57\t    fileq->file_name[0] = '\\0';\n58\t    fileq->file_name[MAX_FQUEUE] = '\\0';\n59\t\n60\t    snprintf(fileq->file_name, MAX_FQUEUE, \"%s\", fileq->flags & CRALERT_FP_SET ? \"<stdin>\" : ALERTS_DAILY);\n61\t}\n62\t\n63\t/* Re Handle the file queue */\n64\tstatic int Handle_Queue(file_queue *fileq, int flags)\n65\t{\n66\t    /* Close if it is open */\n67\t    if (!(flags & CRALERT_FP_SET)) {\n68\t        if (fileq->fp) {\n69\t            fclose(fileq->fp);\n70\t            fileq->fp = NULL;\n71\t        }\n72\t\n73\t        /* We must be able to open the file, fseek and get the\n74\t         * time of change from it.\n75\t         */\n76\t        fileq->fp = fopen(fileq->file_name, \"r\");\n77\t        if (!fileq->fp) {\n78\t            /* Queue not available */\n79\t            return (0);\n80\t        }\n81\t    }\n82\t\n83\t    /* Seek to the end of the file */\n84\t    if (!(flags & CRALERT_READ_ALL)) {\n85\t        if (!fileq->fp) {\n86\t            return (0);\n87\t        }\n88\t\n89\t        if (fseek(fileq->fp, 0, SEEK_END) < 0) {\n90\t            merror(FSEEK_ERROR, fileq->file_name, errno, strerror(errno));\n91\t            fclose(fileq->fp);\n92\t            fileq->fp = NULL;\n93\t            return (-1);\n94\t        }\n95\t    }\n96\t\n97\t    /* File change time */\n98\t    if (fileq->fp) {\n99\t        if (fstat(fileno(fileq->fp), &fileq->f_status) < 0) {\n100\t            merror(FSTAT_ERROR, fileq->file_name, errno, strerror(errno));\n101\t            fclose(fileq->fp);\n102\t            fileq->fp = NULL;\n103\t            return (-1);\n104\t        }\n105\t    }\n106\t\n107\t    fileq->last_change = fileq->f_status.st_mtime;\n108\t\n109\t    return (1);\n110\t}\n111\t\n112\t/* Initiates the file monitoring */\n113\tint Init_FileQueue(file_queue *fileq, const struct tm *p, int flags)\n114\t{\n115\t    /* Initialize file_queue fields */\n116\t    if (!(flags & CRALERT_FP_SET)) {\n117\t        fileq->fp = NULL;\n118\t    }\n119\t    fileq->last_change = 0;\n120\t    fileq->flags = 0;\n121\t\n122\t    fileq->day = p->tm_mday;\n123\t    fileq->year = p->tm_year + 1900;\n124\t\n125\t    strncpy(fileq->mon, s_month[p->tm_mon], 3);\n126\t    memset(fileq->file_name, '\\0', MAX_FQUEUE + 1);\n127\t\n128\t    /* Set the supplied flags */\n129\t    fileq->flags = flags;\n130\t\n131\t    /* Get latest file */\n132\t    GetFile_Queue(fileq);\n133\t\n134\t    /* Always seek to the end when starting the queue */\n135\t    if (Handle_Queue(fileq, fileq->flags) < 0) {\n136\t        return (-1);\n137\t    }\n138\t\n139\t    return (0);\n140\t}\n141\t\n142\t/* Reads from the monitored file */\n143\talert_data *Read_FileMon(file_queue *fileq, const struct tm *p, unsigned int timeout)\n144\t{\n145\t    unsigned int i = 0;\n146\t    alert_data *al_data;\n147\t\n148\t    /* If the file queue is not available, try to access it */\n149\t    if (!fileq->fp) {\n150\t        if (Handle_Queue(fileq, 0) != 1) {\n151\t            file_sleep();\n152\t            return (NULL);\n153\t        }\n154\t    }\n155\t\n156\t    if(!fileq->fp){\n157\t        return (NULL);\n158\t    }\n159\t\n160\t    if (al_data = GetAlertData(fileq->flags, fileq->fp), al_data) {\n161\t        return al_data;\n162\t    }\n163\t\n164\t    fileq->day = p->tm_mday;\n165\t    fileq->year = p->tm_year + 1900;\n166\t    strncpy(fileq->mon, s_month[p->tm_mon], 3);\n167\t\n168\t    /* Get latest file */\n169\t    GetFile_Queue(fileq);\n170\t\n171\t    if (Handle_Queue(fileq, 0) != 1) {\n172\t        file_sleep();\n173\t        return (NULL);\n174\t    }\n175\t\n176\t    /* Try up to timeout times to get an event */\n177\t    while (i < timeout) {\n178\t        al_data = GetAlertData(fileq->flags, fileq->fp);\n179\t        if (al_data) {\n180\t            return (al_data);\n181\t        }\n182\t\n183\t        i++;\n184\t        file_sleep();\n185\t    }\n186\t\n187\t  