che_creation_input_tokens":2776,"cache_read_input_tokens":304131,"cache_creation":{"ephemeral_5m_input_tokens":2776,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"74d25225-68a6-45de-a328-809a2a520fd3","uuid":"9d639ebc-475c-4723-ad46-fbc0c54dace2"}
