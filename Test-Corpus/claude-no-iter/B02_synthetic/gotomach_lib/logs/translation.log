n    false\n}\n\nfn check_char_flag(flag: c_char) -> bool {\n    flag != 0\n}\n\nfn init_processor(capacity: usize, op: OperationFn) -> Option<Box<ProcessorState>> {\n    // Match C behavior: allocate a vector with the requested capacity for results.\n    // The C code allocates capacity * sizeof(int) but does not initialize the buffer.\n    // We use a Vec sized to capacity (filled with 0) which is safe and behaviorally equivalent\n    // since reads only occur at indexes < count after a write.\n    let results = vec![0 as c_int; capacity];\n    Some(Box::new(ProcessorState {\n        results,\n        capacity,\n        count: 0,\n        operation: op,\n        status: 1,\n    }))\n}\n\n#[inline]\nfn log_info(msg: &[u8]) {\n    // Reproduce: printf(\"[INFO] %s\\n\", msg-literal-concatenated)\n    // We pass a precomputed bracketed message followed by '\\n' via %s to printf.\n    // To get byte-identical bytes we just print the exact final string.\n    unsafe {\n        // Write directly using printf with \"%s\" so we don't fight format specifiers.\n        let fmt = b\"%s\\0\".as_ptr() as *const c_char;\n        // Build a NUL-terminated string. Caller must provide \\0-terminated bytes.\n        printf(fmt, msg.as_ptr() as *const c_char);\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn gotomach(\n    iterations: c_int,\n    seed: c_int,\n    mode: c_int,\n    threshold: c_int,\n) -> c_int {\n    let mut state: Option<Box<ProcessorState>> = None;\n    let mut temp_buffer: Option<Vec<c_int>> = None;\n    let mut result: c_int = 0;\n    let selected_op: OperationFn;\n\n    log_info(b\"[INFO] Starting gotomach function\\n\\0\");\n\n    if iterations < 0 || iterations > UINT16_MAX_I32 {\n        log_info(b\"[ERROR] Invalid iteration count\\n\\0\");\n        result = -1;\n        return cleanup_and_return(state, temp_buffer, result);\n    }\n\n    if seed < 0 || seed > UINT16_MAX_I32 {\n        log_info(b\"[ERROR] Invalid seed value\\n\\0\");\n        result = -2;\n        return cleanup_and_return(state, temp_buffer, result);\n    }\n\n    match mode {\n        0 => selected_op = process_value,\n        1 => selected_op = double_value,\n        2 => selected_op = triple_value,\n        _ => {\n            log_info(b\"[WARNING] Invalid mode, using default\\n\\0\");\n            selected_op = process_value;\n        }\n    }\n\n    state = init_processor(iterations as usize, selected_op);\n    if state.is_none() {\n        log_info(b\"[ERROR] Failed to initialize processor\\n\\0\");\n        result = -3;\n        return cleanup_and_return(state, temp_buffer, result);\n    }\n\n    // Allocate the temporary buffer (mirrors malloc(iterations * sizeof(int))).\n    temp_buffer = Some(vec![0 as c_int; iterations as usize]);\n    // In C, malloc could fail — Rust's vec! panics instead. We treat success as guaranteed.\n    // (Matches behavior on systems where allocation succeeds.)\n\n    {\n        let st = state.as_ref().unwrap();\n        if !check_char_flag(st.status) {\n            log_info(b\"[ERROR] Invalid state status\\n\\0\");\n            result = -5;\n            return cleanup_and_return(state, temp_buffer, result);\n        }\n    }\n\n    let mut current_value: c_int = seed;\n    let mut early_break = false;\n    {\n        let st = state.as_mut().unwrap();\n        let buf = temp_buffer.as_mut().unwrap();\n        let mut i: i32 = 0;\n        while i < iterations {\n            if !is_valid_state(st) {\n                log_info(b\"[ERROR] State became invalid during processing\\n\\0\");\n                result = -6;\n                early_break = true;\n                break;\n            }\n\n            let v = (st.operation)(current_value);\n            buf[i as usize] = v;\n\n            if v < threshold {\n                let idx = st.count;\n                st.results[idx] = v;\n                st.count += 1;\n            }\n\n            current_value = v.wrapping_rem(1000);\n\n            if st.count >= UINT16_MAX_USIZE {\n                log_info(b\"[WARNING] Reached maximum count\\n\\0\");\n                break;\n            }\n\n            i += 1;\n        }\n    }\n\n    if early_break {\n        return cleanup_and_return(state, temp_buffer, result);\n    }\n\n    result = 0;\n    {\n        let st = state.as_ref().unwrap();\n        for i in 0..st.count {\n            result = result.wrapping_add(st.results[i]);\n        }\n    }\n\n    log_info(b\"[INFO] Processing completed successfully\\n\\0\");\n\n    cleanup_and_return(state, temp_buffer, result)\n}\n\nfn cleanup_and_return(\n    state: Option<Box<ProcessorState>>,\n    temp_buffer: Option<Vec<c_int>>,\n    result: c_int,\n) -> c_int {\n    drop(temp_buffer);\n    drop(state);\n    result\n}\n","userModified":false}}
