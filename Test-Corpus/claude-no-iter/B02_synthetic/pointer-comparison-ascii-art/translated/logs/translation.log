4\t    printf(\"3. Add shape to scene\\n\");\n45\t    printf(\"4. Remove shape from scene\\n\");\n46\t    printf(\"5. View scene\\n\");\n47\t    printf(\"6. List all scenes\\n\");\n48\t    printf(\"7. Save scene\\n\");\n49\t    printf(\"8. Load scene\\n\");\n50\t    printf(\"9. Compare two shapes\\n\");\n51\t    printf(\"10. Compare two scenes\\n\");\n52\t    printf(\"11. Delete scene\\n\");\n53\t    printf(\"12. Exit\\n\");\n54\t    printf(\"=========================================\\n\");\n55\t    printf(\"Choice: \");\n56\t}\n57\t\n58\tvoid view_all_shapes(void) {\n59\t    printf(\"\\n=== Available Shapes ===\\n\");\n60\t    for (int i = 0; i < SHAPE_COUNT; i++) {\n61\t        printf(\"\\n%d. \", i + 1);\n62\t        shape_print(shape_get((shape_type_t)i));\n63\t    }\n64\t}\n65\t\n66\tvoid create_new_scene(void) {\n67\t    if (scene_count >= MAX_SCENES) {\n68\t        printf(\"Error: Maximum scenes reached\\n\");\n69\t        return;\n70\t    }\n71\t    \n72\t    char name[MAX_SCENE_NAME];\n73\t    printf(\"Enter scene name: \");\n74\t    if (fgets(name, MAX_SCENE_NAME, stdin) == NULL) {\n75\t        return;\n76\t    }\n77\t    name[strcspn(name, \"\\n\")] = 0;\n78\t    \n79\t    scenes[scene_count] = scene_create(name);\n80\t    if (scenes[scene_count]) {\n81\t        printf(\"Scene '%s' created (index %d)\\n\", name, scene_count);\n82\t        scene_count++;\n83\t    } else {\n84\t        printf(\"Error creating scene\\n\");\n85\t    }\n86\t}\n87\t\n88\tvoid add_shape_to_scene(void) {\n89\t    if (scene_count == 0) {\n90\t        printf(\"No scenes available. Create a scene first.\\n\");\n91\t        return;\n92\t    }\n93\t    \n94\t    printf(\"Select scene (0-%d): \", scene_count - 1);\n95\t    int scene_idx;\n96\t    if (scanf(\"%d\", &scene_idx) != 1) {\n97\t        printf(\"Invalid input\\n\");\n98\t        while (getchar() != '\\n');\n99\t        return;\n100\t    }\n101\t    while (getchar() != '\\n');\n102\t    \n103\t    if (scene_idx < 0 || scene_idx >= scene_count) {\n104\t        printf(\"Invalid scene index\\n\");\n105\t        return;\n106\t    }\n107\t    \n108\t    printf(\"\\nSelect shape to add:\\n\");\n109\t    for (int i = 0; i < SHAPE_COUNT; i++) {\n110\t        printf(\"%d. %s\\n\", i, shape_type_name((shape_type_t)i));\n111\t    }\n112\t    printf(\"Choice: \");\n113\t    \n114\t    int shape_type;\n115\t    if (scanf(\"%d\", &shape_type) != 1) {\n116\t        printf(\"Invalid input\\n\");\n117\t        while (getchar() != '\\n');\n118\t        return;\n119\t    }\n120\t    while (getchar() != '\\n');\n121\t    \n122\t    if (shape_type < 0 || shape_type >= SHAPE_COUNT) {\n123\t        printf(\"Invalid shape type\\n\");\n124\t        return;\n125\t    }\n126\t    \n127\t    shape_t *shape = shape_get((shape_type_t)shape_type);\n128\t    if (scene_add_shape(scenes[scene_idx], shape) == 0) {\n129\t        printf(\"Shape '%s' added to scene (reusing singleton at %p)\\n\", \n130\t               shape->name, (void*)shape);\n131\t    } else {\n132\t        printf(\"Error adding shape\\n\");\n133\t    }\n134\t}\n135\t\n136\tvoid remove_shape_from_scene(void) {\n137\t    if (scene_count == 0) {\n138\t        printf(\"No scenes available\\n\");\n139\t        return;\n140\t    }\n141\t    \n142\t    printf(\"Select scene (0-%d): \", scene_count - 1);\n143\t    int scene_idx;\n144\t    if (scanf(\"%d\", &scene_idx) != 1) {\n145\t        printf(\"Invalid input\\n\");\n146\t        while (getchar() != '\\n');\n147\t        return;\n148\t    }\n149\t    while (getchar() != '\\n');\n150\t    \n151\t    if (scene_idx < 0 || scene_idx >= scene_count) {\n152\t        printf(\"Invalid scene index\\n\");\n153\t        return;\n154\t    }\n155\t    \n156\t    scene_list_shapes(scenes[scene_idx]);\n157\t    \n158\t    if (scenes[scene_idx]->shape_count == 0) {\n159\t        printf(\"Scene is empty\\n\");\n160\t        return;\n161\t    }\n162\t    \n163\t    printf(\"Select shape to remove (1-%d): \", scenes[scene_idx]->shape_count);\n164\t    int shape_idx;\n165\t    if (scanf(\"%d\", &shape_idx) != 1) {\n166\t        printf(\"Invalid input\\n\");\n167\t        while (getchar() != '\\n');\n168\t        return;\n169\t    }\n170\t    while (getchar() != '\\n');\n171\t    \n172\t    if (scene_remove_shape(scenes[scene_idx], shape_idx - 1) == 0) {\n173\t        printf(\"Shape removed\\n\");\n174\t    } else {\n175\t        printf(\"Error removing shape\\n\");\n176\t    }\n177\t}\n178\t\n179\tvoid view_scene(void) {\n180\t    if (scene_count == 0) {\n181\t        printf(\"No scenes available\\n\");\n182\t        return;\n183\t    }\n184\t    \n185\t    printf(\"Select scene (0-%d): \", scene_count - 1);\n186\t    int scene_idx;\n187\t    if (scanf(\"%d\", &scene_idx) != 1) {\n188\t        printf(\"Invalid input\\n\");\n189\t        while (getchar() != '\\n');\n190\t        return;\n191\t    }\n192\t    while (getchar() != '\\n');\n193\t    \n194\t    if (scene_idx < 0 || scene_idx >= scene_count) {\n195\t        printf(\"Invalid scene index\\n\");\n196\t        return;\n197\t    }\n198\t    \n199\t    scene_print(scenes[scene_idx]);\n200\t}\n201\t\n202\tvoid list_all_scenes(void) {\n203\t    printf(\"\\n=== All Scenes ===\\n\");\n204\t    if (scene_count == 0) {\n205\t        printf(\"No scenes created yet\\n\");\n206\t        return;\n207\t    }\n208\t    \n209\t    for (int i = 0; i < scene_count; i++) {\n210\t        printf(\"%d. %s (%d shapes)\\n\", i, scenes[i]->name, scenes[i]->shape_count);\n211\t    }\n212\t}\n213\t\n214\tvoid save_scene_to_file(void) {\n215\t    if (scene_count == 0) {\n216\t        printf(\"No scenes available\\n\");\n217\t        return;\n218\t    }\n219\t    \n220\t    printf(\"Select scene (0-%d): \", scene_count - 1);\n221\t    int scene_idx;\n222\t    if (scanf(\"%d\", &scene_idx) != 1) {\n223\t        printf(\"Invalid input\\n\");\n224\t        while (getchar() != '\\n');\n225\t        return;\n226\t    }\n227\t    while (getchar() != '\\n');\n228\t    \n229\t    if (scene_idx < 0 || scene_idx >= scene_count) {\n230\t        printf(\"Invalid scene index\\n\");\n231\t        return;\n232\t    }\n233\t    \n234\t    char filename[256];\n235\t    printf(\"Enter filename: \");\n236\t    if (fgets(filename, sizeof(filename), stdin) == NULL) {\n237\t        return;\n238\t    }\n239\t    filename[strcspn(filename, \"\\n\")] = 0;\n240\t    \n241\t    scene_save(scenes[scene_idx], filename);\n242\t}\n243\t\n244\tvoid load_scene_from_file(void) {\n245\t    if (scene_count >= MAX_SCENES) {\n246\t        printf(\"Error: Maximum scenes reached\\n\");\n247\t        return;\n248\t    }\n249\t    \n250\t    char filename[256];\n251\t    printf(\"Enter filename: \");\n252\t    if (fgets(filename, sizeof(filename), stdin) == NULL) {\n253\t        return;\n254\t    }\n255\t    filename[strcspn(filename, \"\\n\")] = 0;\n256\t    \n257\t    scene_t *scene = scene_load(filename);\n258\t    if (scene) {\n259\t        scenes[scene_count++] = scene;\n260\t        printf(\"Scene loaded (index %d)\\n\", scene_count - 1);\n261\t    }\n262\t}\n263\t\n264\tvoid compare_shapes(void) {\n265\t    printf(\"\\nSelect first shape (0-%d):\\n\", SHAPE_COUNT - 1);\n266\t    for (int i = 0; i < SHAPE_COUNT; i++) {\n267\t        printf(\"%d. %s\\n\", i, shape_type_name((shape_type_t)i));\n268\t    }\n269\t    printf(\"Choice: \");\n270\t    \n271\t    int type1;\n272\t    if (scanf(\"%d\", &type1) != 1) {\n273\t        printf(\"Invalid input\\n\");\n274\t        while (getchar() != '\\n');\n275\t        return;\n276\t    }\n277\t    while (getchar() != '\\n');\n278\t    \n279\t    printf(\"\\nSelect second shape (0-%d): \", SHAPE_COUNT - 1);\n280\t    int type2;\n281\t    if (scanf(\"%d\", &type2) != 1) {\n282\t        printf(\"Invalid input\\n\");\n283\t        while (getchar() != '\\n');\n284\t        return;\n285\t    }\n286\t    while (getchar() != '\\n');\n287\t    \n288\t    if (type1 < 0 || type1 >= SHAPE_COUNT || type2 < 0 || type2 >= SHAPE_COUNT) {\n289\t        printf(\"Invalid shape type\\n\");\n290\t        return;\n291\t    }\n292\t    \n293\t    shape_t *s1 = shape_get((shape_type_t)type1);\n294\t    shape_t *s2 = shape_get((shape_type_t)type2);\n295\t    \n296\t    printf(\"\\nShape 1: %s (ptr: %p)\\n\", s1->name, (void*)s1);\n297\t    printf(\"Shape 2: %s (ptr: %p)\\n\", s2->name, (void*)s2);\n298\t    printf(\"Comparison of pointers: %d\\n\", s1 == s2);\n299\t    \n300\t    if (shape_equals(s1, s2)) {\n301\t        printf(\"Result: Shapes are EQUAL (same instance)\\n\");\n302\t    } else {\n303\t        printf(\"Result: Shapes are NOT EQUAL (different instances)\\n\");\n304\t    }\n305\t}\n306\t\n307\tvoid compare_scenes(void) {\n308\t    if (scene_count < 2) {\n309\t        printf(\"Need at least 2 scenes to compare\\n\");\n310\t        return;\n311\t    }\n312\t    \n313\t    printf(\"Select first scene (0-%d): \", scene_count - 1);\n314\t    int idx1;\n315\t    if (scanf(\"%d\", &idx1) != 1) {\n316\t        printf(\"Invalid input\\n\");\n317\t        while (getchar() != '\\n');\n318\t        return;\n319\t    }\n320\t    while (getchar() != '\\n');\n321\t    \n322\t    printf(\"Select second scene (0-%d): \", scene_count - 1);\n323\t    int idx2;\n324\t    if (scanf(\"%d\", &idx2) != 1) {\n325\t        printf(\"Invalid input\\n\");\n326\t        while (getchar() != '\\n');\n327\t        return;\n328\t    }\n329\t    while (getchar() != '\\n');\n330\t    \n331\t    if (idx1 < 0 || idx1 >= scene_count || idx2 < 0 || idx2 >= scene_count) {\n332\t        printf(\"Invalid scene index\\n\");\n333\t        return;\n334\t    }\n335\t    \n336\t    scene_t *sc1 = scenes[idx1];\n337\t    scene_t *sc2 = scenes[idx2];\n338\t    \n339\t    printf(\"\\nScene 1: %s (%d shapes)\\n\", sc1->name, sc1->shape_count);\n340\t    scene_list_shapes(sc1);\n341\t    \n342\t    printf(\"\\nScene 2: %s (%d shapes)\\n\", sc2->name, sc2->shape_count);\n343\t    scene_list_shapes(sc2);\n344\t    \n345\t    if (scene_equals(