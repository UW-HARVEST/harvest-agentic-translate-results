l() {\n                end = start.add(strlen(start));\n            }\n\n            // Extract the current task\n            let length: usize = (end as usize) - (start as usize);\n            let task = malloc(length + 1) as *mut c_char;\n            if task.is_null() {\n                dprintf(2, c\"Error: Failed to allocate memory for task.\\n\".as_ptr());\n                destroy_task_manager(manager);\n                finalize_logger();\n                return libc::EXIT_FAILURE;\n            }\n            strncpy(task, start, length);\n            *task.add(length) = 0;\n\n            // add_task(manager, task, priority++);\n            add_task(manager, task, priority);\n            priority += 1;\n            free(task as *mut c_void);\n\n            start = if *end == b'\\n' as c_char {\n                end.add(1)\n            } else {\n                end\n            };\n        }\n\n        print_tasks(manager);\n\n        destroy_task_manager(manager);\n        finalize_logger();\n\n        0\n    }\n}\n","structuredPatch":[{"oldStart":225,"oldLines":7,"newStart":225,"newLines":7,"lines":["             let length: usize = (end as usize) - (start as usize);","             let task = malloc(length + 1) as *mut c_char;","             if task.is_null() {","-                dprintf(2, c\"Error: Failed to allocate memory for task.\\n\".as_ptr());","+                fprintf(stderr, c\"Error: Failed to allocate memory for task.\\n\".as_ptr());","                 destroy_task_manager(manager);","                 finalize_logger();","                 return libc::EXIT_FAILURE;"]}],"userModified":false,"replaceAll":false}}
