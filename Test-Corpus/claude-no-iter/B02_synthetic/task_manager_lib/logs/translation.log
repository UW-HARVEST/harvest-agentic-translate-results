d_task(manager, task, priority);\n            priority += 1;\n            free(task as *mut c_void);\n\n            start = if *end == b'\\n' as c_char {\n                end.add(1)\n            } else {\n                end\n            };\n        }\n\n        print_tasks(manager);\n\n        destroy_task_manager(manager);\n        finalize_logger();\n\n        0\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
