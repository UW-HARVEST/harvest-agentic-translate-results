sbehave on).\n\nVerified against the compiled C binary across 17 test cases (all 5 operations, error paths, multi-line input, whitespace handling, negative flag wrapping, long-pattern truncation) — every input produced byte-identical stdout/stderr/exit-code output."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":708,"cache_read_input_tokens":34281,"cache_creation":{"ephemeral_5m_input_tokens":708,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6e40b328-ff2c-40b7-889c-0c3e98d7462d","uuid":"f9de412d-ac74-4bcd-a22d-0aaf7cfa2e18"}
