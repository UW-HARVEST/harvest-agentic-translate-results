e(BufStdout(bw));\n}\n\nfn flush_stdout() {\n    if let Some(BufStdout(ref mut bw)) = *STDOUT.lock().unwrap() {\n        let _ = bw.flush();\n    }\n}\n\nmacro_rules! out {\n    ($($arg:tt)*) => {{\n        let mut g = STDOUT.lock().unwrap();\n        if let Some(BufStdout(ref mut bw)) = *g {\n            let _ = write!(bw, $($arg)*);\n        }\n    }};\n}\n\nmacro_rules! outln {\n    () => {{\n        let mut g = STDOUT.lock().unwrap();\n        if let Some(BufStdout(ref mut bw)) = *g {\n            let _ = writeln!(bw);\n        }\n    }};\n    ($($arg:tt)*) => {{\n        let mut g = STDOUT.lock().unwrap();\n        if let Some(BufStdout(ref mut bw)) = *g {\n            let _ = writeln!(bw, $($arg)*);\n        }\n    }};\n}\n\npub(crate) use out;\npub(crate) use outln;"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":330,"cache_read_input_tokens":46506,"cache_creation":{"ephemeral_5m_input_tokens":330,"ephemeral_1h_input_tokens":0},"output_tokens":39,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a6ae889c-e8a1-4f56-a7ce-6f18c60d660e","uuid":"9bdc9fd4-d93b-4c1c-b87c-1ab30747dc83"}
