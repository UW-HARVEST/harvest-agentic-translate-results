e node 2 and its children\n222\t    assert(tree_remove_node(tree, 2) == 0);\n223\t    assert(tree_size(tree) == 2);\n224\t    assert(tree_contains(tree, 2) == 0);\n225\t    assert(tree_contains(tree, 3) == 0);\n226\t    assert(tree_contains(tree, 4) == 0);\n227\t    assert(tree_contains(tree, 1) == 1);\n228\t    assert(tree_contains(tree, 5) == 1);\n229\t    \n230\t    tree_delete(tree);\n231\t    TEST_PASS;\n232\t}\n233\t\n234\tvoid test_tree_remove_root(void) {\n235\t    printf(\"\\n=== Testing Tree Remove Root ===\\n\");\n236\t    \n237\t    tree_t *tree = tree_create();\n238\t    \n239\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n240\t    assert(tree_add_node(tree, 2, 1, \"child1\") == 0);\n241\t    assert(tree_add_node(tree, 3, 1, \"child2\") == 0);\n242\t    \n243\t    assert(tree_size(tree) == 3);\n244\t    \n245\t    // Remove root\n246\t    assert(tree_remove_node(tree, 1) == 0);\n247\t    assert(tree_size(tree) == 0);\n248\t    assert(tree->has_root == 0);\n249\t    \n250\t    tree_delete(tree);\n251\t    TEST_PASS;\n252\t}\n253\t\n254\tvoid test_tree_count_descendants(void) {\n255\t    printf(\"\\n=== Testing Tree Count Descendants ===\\n\");\n256\t    \n257\t    tree_t *tree = tree_create();\n258\t    \n259\t    /*\n260\t     * Build tree:\n261\t     *        1\n262\t     *       / \\\n263\t     *      2   5\n264\t     *     / \\\n265\t     *    3   4\n266\t     */\n267\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n268\t    assert(tree_add_node(tree, 2, 1, \"child1\") == 0);\n269\t    assert(tree_add_node(tree, 3, 2, \"grandchild1\") == 0);\n270\t    assert(tree_add_node(tree, 4, 2, \"grandchild2\") == 0);\n271\t    assert(tree_add_node(tree, 5, 1, \"child2\") == 0);\n272\t    \n273\t    assert(tree_count_descendants(tree, 1) == 4);\n274\t    assert(tree_count_descendants(tree, 2) == 2);\n275\t    assert(tree_count_descendants(tree, 3) == 0);\n276\t    assert(tree_count_descendants(tree, 5) == 0);\n277\t    \n278\t    tree_delete(tre