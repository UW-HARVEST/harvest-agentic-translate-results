);","+fn test_tree_remove_root(out: &mut Out) {","+    writeln!(out).unwrap();","+    writeln!(out, \"=== Testing Tree Remove Root ===\").unwrap();"," ","     let mut tree = Tree::create();"," "]},{"oldStart":317,"oldLines":12,"newStart":267,"newLines":12,"lines":["     c_assert!(!tree.has_root);"," ","     Tree::delete(tree);","-    println!(\"✓ PASS: test_tree_remove_root\");","+    writeln!(out, \"✓ PASS: test_tree_remove_root\").unwrap();"," }"," ","-fn test_tree_count_descendants() {","-    println!();","-    println!(\"=== Testing Tree Count Descendants ===\");","+fn test_tree_count_descendants(out: &mut Out) {","+    writeln!(out).unwrap();","+    writeln!(out, \"=== Testing Tree Count Descendants ===\").unwrap();"," ","     let mut tree = Tree::create();"," "]},{"oldStart":338,"oldLines":12,"newStart":288,"newLines":12,"lines":["     c_assert!(tree.count_descendants(5) == 0);"," ","     Tree::delete(tree);","-    println!(\"✓ PASS: test_tree_count_descendants\");","+    writeln!(out, \"✓ PASS: test_tree_count_descendants\").unwrap();"," }"," ","-fn test_tree_find_path() {","-    println!();","-    println!(\"=== Testing Tree Find Path ===\");","+fn test_tree_find_path(out: &mut Out) {","+    writeln!(out).unwrap();","+    writeln!(out, \"=== Testing Tree Find Path ===\").unwrap();"," ","     let mut tree = Tree::create();"," "]},{"oldStart":363,"oldLines":12,"newStart":313,"newLines":12,"lines":["     c_assert!(path[0] == 1);"," ","     Tree::delete(tree);","-    println!(\"✓ PASS: test_tree_find_path\");","+    writeln!(out, \"✓ PASS: test_tree_find_path\").unwrap();"," }"," ","-fn test_tree_duplicate_id() {","-    println!();","-    println!(\"=== Testing Tree Duplicate ID ===\");","+fn test_tree_duplicate_id(out: &mut Out) {","+    writeln!(out).unwrap();","+    writeln!(out, \"=== Testing Tree Duplicate ID ===\").unwrap();"," ","     let mut tree = Tree::create();"," "]},{"oldStart":380,"oldLines":12,"newStart":330,"newLines":12,"lines":["     c_assert!(tree.size() == 2);"," ","     Tree::delete(tree);","-    println!(\"✓ PASS: test_tree_duplicate_id\");","+    writeln!(out, \"✓ PASS: test_tree_duplicate_id\").unwrap();"," }"," ","-fn test_tree_max_children() {","-    println!();","-    println!(\"=== Testing Tree Max Children ===\");","+fn test_tree_max_children(out: &mut Out) {","+    writeln!(out).unwrap();","+    writeln!(out, \"=== Testing Tree Max Children ===\").unwrap();"," ","     let mut tree = Tree::create();"," "]},{"oldStart":399,"oldLines":12,"newStart":349,"newLines":12,"lines":["     c_assert!(tree.size() == MAX_CHILDREN + 1);"," ","     Tree::delete(tree);","-    println!(\"✓ PASS: test_tree_max_children\");","+    writeln!(out, \"✓ PASS: test_tree_max_children\").unwrap();"," }"," ","-fn test_tree_complex_structure() {","-    println!();","-    println!(\"=== Testing Tree Complex Structure ===\");","+fn test_tree_complex_structure(out: &mut Out) {","+    writeln!(out).unwrap();","+    writeln!(out, \"=== Testing Tree Complex Structure ===\").unwrap();"," ","     let mut tree = Tree::create();"," "]},{"oldStart":425,"oldLines":39,"newStart":375,"newLines":46,"lines":["     c_assert!(tree.count_descendants(2) == 2);","     c_assert!(tree.count_descendants(7) == 1);"," ","-    tree.print();","+    tree.print(out);"," ","     Tree::delete(tree);","-    println!(\"✓ PASS: test_tree_complex_structure\");","+    writeln!(out, \"✓ PASS: test_tree_complex_structure\").unwrap();"," }"," "," fn main() {","-    println!(\"╔════════════════════════════════════════╗\");","-    println!(\"║  TREE WITH HASHMAP ID MAPPING TESTS   ║\");","-    println!(\"╚════════════════════════════════════════╝\");","+    // Use a 64 KiB buffered stdout. Larger than total program output, so","+    // nothing is written to fd 1 until we flush at end of main, mirroring","+    // glibc full-buffering of redirected stdout.","+    let mut out: Out = BufWriter::with_capacity(1 << 16, std::io::stdout());"," ","-    test_hashmap_basic();","-    test_hashmap_collisions();","+    writeln!(out, \"╔════════════════════════════════════════╗\").unwrap();","+    writeln!(out, \"║  TREE WITH HASHMAP ID MAPPING TESTS   ║\").unwrap();","+    writeln!(out, \"╚════════════════════════════════════════╝\").unwrap();"," ","-    test_tree_creation();","-    test_tree_add_root();","-    test_tree_add_children();","+    test_hashmap_basic(&mut out);","+    test_hashmap_collisions(&mut out);"," ","-    test_tree_deep_hierarchy();","-    test_tree_complex_structure();","+    test_tree_creation(&mut out);","+    test_tree_add_root(&mut out);","+    test_tree_add_children(&mut out);"," ","-    test_tree_remove_leaf();","-    test_tree_remove_subtree();","-    test_tree_remove_root();","+    test_tree_deep_hierarchy(&mut out);","+    test_tree_complex_structure(&mut out);"," ","-    test_tree_count_descendants();","-    test_tree_find_path();","+    test_tree_remove_leaf(&mut out);","+    test_tree_remove_subtree(&mut out);","+    test_tree_remove_root(&mut out);"," ","-    test_tree_duplicate_id();","-    test_tree_max_children();","+    test_tree_count_descendants(&mut out);","+    test_tree_find_path(&mut out);"," ","-    println!();","-    println!(\"========================================\");","-    println!(\"  All tests passed successfully!\");","-    println!(\"========================================\");","+    test_tree_duplicate_id(&mut out);","+    test_tree_max_children(&mut out);","+","+    writeln!(out).unwrap();","+    writeln!(out, \"========================================\").unwrap();","+    writeln!(out, \"  All tests passed successfully!\").unwrap();","+    writeln!(out, \"========================================\").unwrap();","+","+    out.flush().unwrap();"," }"]}],"originalFile":"// main.rs - translation of main.c\n//\n// Reproduces the C executable's exact stdout and stderr output, including\n// the \"Error: ...\" messages emitted to stderr by tree_add_node when\n// duplicate IDs or maximum-children conditions are encountered.\n//\n// We mirror C stdio behavior: when stdout is not a TTY, glibc uses full\n// (block) buffering, while stderr is unbuffered. To preserve byte-identical\n// merged-stream output, we buffer stdout through a global BufWriter and\n// flush only on exit. stderr writes go directly via eprintln!.\n\nmod hashmap;\nmod tree;\n\nuse hashmap::Hashmap;\nuse std::io::{BufWriter, StdoutLock, Write};\nuse std::sync::Mutex;\nuse tree::{Tree, TreeNode, MAX_CHILDREN};\n\n// A 64 KiB buffer is comfortably larger than the program's total stdout size,\n// which means it behaves like fully buffered C stdout: nothing is written to\n// the underlying fd until the program ends and we explicitly flush.\nstruct BufStdout(BufWriter<StdoutLock<'static>>);\n\nstatic STDOUT: Mutex<Option<BufStdout>> = Mutex::new(None);\n\nfn init_stdout() {\n    let stdout = Box::leak(Box::new(std::io::stdout()));\n    let lock = stdout.lock();\n    let bw = BufWriter::with_capacity(1 << 16, lock);\n    *STDOUT.lock().unwrap() = Some(BufStdout(bw));\n}\n\nfn flush_stdout() {\n    if let Some(BufStdout(ref mut bw)) = *STDOUT.lock().unwrap() {\n        let _ = bw.flush();\n    }\n}\n\nmacro_rules! out {\n    ($($arg:tt)*) => {{\n        let mut g = STDOUT.lock().unwrap();\n        if let Some(BufStdout(ref mut bw)) = *g {\n            let _ = write!(bw, $($arg)*);\n        }\n    }};\n}\n\nmacro_rules! outln {\n    () => {{\n        let mut g = STDOUT.lock().unwrap();\n        if let Some(BufStdout(ref mut bw)) = *g {\n            let _ = writeln!(bw);\n        }\n    }};\n    ($($arg:tt)*) => {{\n        let mut g = STDOUT.lock().unwrap();\n        if let Some(BufStdout(ref mut bw)) = *g {\n            let _ = writeln!(bw, $($arg)*);\n        }\n    }};\n}\n\npub(crate) use out;\npub(crate) use outln;\n\n// We model the C `assert` macro as a runtime check. The C builds without\n// -DNDEBUG, so all asserts are active.\nmacro_rules! c_assert {\n    ($cond:expr) => {\n        if !$cond {\n            std::process::abort();\n        }\n    };\n}\n\nfn cstr_eq(buf: &[u8], s: &str) -> bool {\n    let sb = s.as_bytes();\n    let mut end = 0;\n    while end < buf.len() && buf[end] != 0 {\n        end += 1;\n    }\n    &buf[..end] == sb\n}\n\nfn test_hashmap_basic() {\n    println!();\n    println!(\"=== Testing Hashmap Basic Operations ===\");\n\n    let mut map = Hashmap::create();\n    c_assert!(map.size() == 0);\n\n    // In C, &val1, &val2, &val3 are arbitrary pointers used to check identity\n    // and dereference. Since we store *mut TreeNode in our Rust port, we\n    // simulate by casting integers' addresses; instead, we use sentinel\n    // pointers built from leaked Box<i32> for identity checks below.\n    let val1 = Box::leak(Box::new(42i32));\n    let val2 = Box::leak(Box::new(100i32));\n    let val3 = Box::leak(Box::new(200i32));\n\n    let p1 = val1 as *mut i32 as *mut TreeNode;\n    let p2 = val2 as *mut i32 as *mut TreeNode;\n    let p3 = val3 as *mut i32 as *mut TreeNode;\n\n    c_assert!(map.put(1, p1) == 0);\n    c_assert!(map.put(2, p2) == 0);\n    c_assert!(map.put(3, p3) == 0);\n    c_assert!(map.size() == 3);\n\n    unsafe {\n        c_assert!(*(map.get(1) as *mut i32) == 42);\n        c_assert!(*(map.get(2) as *mut i32) == 100);\n        c_assert!(*(map.get(3) as *mut i32) == 200);\n    }\n\n    let val4 = Box::leak(Box::new(500i32));\n    let p4 = val4 as *mut i32 as *mut TreeNode;\n    c_assert!(map.put(1, p4) == 0);\n    c_assert!(map.size() == 3);\n    unsafe {\n        c_assert!(*(map.get(1) as *mut i32) == 500);\n    }\n\n    let removed = map.remove(2);\n    c_assert!(removed == p2);\n    c_assert!(map.size() == 2);\n    c_assert!(map.get(2).is_null());\n\n    c_assert!(map.contains(1));\n    c_assert!(!map.contains(2));\n    c_assert!(map.contains(3));\n\n    drop(map);\n    println!(\"✓ PASS: test_hashmap_basic\");\n}\n\nfn test_hashmap_collisions() {\n    println!();\n    println!(\"=== Testing Hashmap Collisions ===\");\n\n    let mut map = Hashmap::create();\n\n    let mut values: Vec<Box<i32>> = (0..100).map(|i| Box::new(i * 10)).collect();\n    let ptrs: Vec<*mut TreeNode> = values\n        .iter_mut()\n        .map(|b| (&mut **b) as *mut i32 as *mut TreeNode)\n        .collect();\n\n    for i in 0..100i64 {\n        c_assert!(map.put(i as u64, ptrs[i as usize]) == 0);\n    }\n\n    c_assert!(map.size() == 100);\n\n    for i in 0..100i64 {\n        let val = map.get(i as u64);\n        c_assert!(!val.is_null());\n        unsafe {\n            c_assert!(*(val as *mut i32) == (i as i32) * 10);\n        }\n    }\n\n    drop(map);\n    println!(\"✓ PASS: test_hashmap_collisions\");\n}\n\nfn test_tree_creation() {\n    println!();\n    println!(\"=== Testing Tree Creation ===\");\n\n    let tree = Tree::create();\n    c_assert!(tree.size() == 0);\n    c_assert!(!tree.has_root);\n\n    Tree::delete(tree);\n    println!(\"✓ PASS: test_tree_creation\");\n}\n\nfn test_tree_add_root() {\n    println!();\n    println!(\"=== Testing Tree Add Root ===\");\n\n    let mut tree = Tree::create();\n\n    c_assert!(tree.add_node(1, 0, Some(\"root\")) == 0);\n    c_assert!(tree.size() == 1);\n    c_assert!(tree.has_root);\n    c_assert!(tree.root_id == 1);\n\n    let root_ptr = tree.get_node(1);\n    c_assert!(!root_ptr.is_null());\n    let root: &TreeNode = unsafe { &*root_ptr };\n    c_assert!(root.id == 1);\n    c_assert!(cstr_eq(&root.data, \"root\"));\n    c_assert!(root.child_count == 0);\n\n    Tree::delete(tree);\n    println!(\"✓ PASS: test_tree_add_root\");\n}\n\nfn test_tree_add_children() {\n    println!();\n    println!(\"=== Testing Tree Add Children ===\");\n\n    let mut tree = Tree::create();\n\n    c_assert!(tree.add_node(1, 0, Some(\"root\")) == 0);\n    c_assert!(tree.add_node(2, 1, Some(\"child1\")) == 0);\n    c_assert!(tree.add_node(3, 1, Some(\"child2\")) == 0);\n    c_assert!(tree.add_node(4, 1, Some(\"child3\")) == 0);\n\n    c_assert!(tree.size() == 4);\n\n    let root_ptr = tree.get_node(1);\n    let root: &TreeNode = unsafe { &*root_ptr };\n    c_assert!(root.child_count == 3);\n    c_assert!(root.child_ids[0] == 2);\n    c_assert!(root.child_ids[1] == 3);\n    c_assert!(root.child_ids[2] == 4);\n\n    Tree::delete(tree);\n    println!(\"✓ PASS: test_tree_add_children\");\n}\n\nfn test_tree_deep_hierarchy() {\n    println!();\n    println!(\"=== Testing Tree Deep Hierarchy ===\");\n\n    let mut tree = Tree::create();\n\n    c_assert!(tree.add_node(1, 0, Some(\"level0\")) == 0);\n    c_assert!(tree.add_node(2, 1, Some(\"level1\")) == 0);\n    c_assert!(tree.add_node(3, 2, Some(\"level2\")) == 0);\n    c_assert!(tree.add_node(4, 3, Some(\"level3\")) == 0);\n    c_assert!(tree.add_node(5, 4, Some(\"level4\")) == 0);\n\n    c_assert!(tree.size() == 5);\n\n    c_assert!(tree.get_depth(1) == 0);\n    c_assert!(tree.get_depth(2) == 1);\n    c_assert!(tree.get_depth(3) == 2);\n    c_assert!(tree.get_depth(4) == 3);\n    c_assert!(tree.get_depth(5) == 4);\n\n    c_assert!(tree.get_height(1) == 4);\n    c_assert!(tree.get_height(2) == 3);\n    c_assert!(tree.get_height(5) == 0);\n\n    Tree::delete(tree);\n    println!(\"✓ PASS: test_tree_deep_hierarchy\");\n}\n\nfn test_tree_remove_leaf() {\n    println!();\n    println!(\"=== Testing Tree Remove Leaf ===\");\n\n    let mut tree = Tree::create();\n\n    c_assert!(tree.add_node(1, 0, Some(\"root\")) == 0);\n    c_assert!(tree.add_node(2, 1, Some(\"child1\")) == 0);\n    c_assert!(tree.add_node(3, 1, Some(\"child2\")) == 0);\n    c_assert!(tree.size() == 3);\n\n    c_assert!(tree.remove_node(3) == 0);\n    c_assert!(tree.size() == 2);\n    c_assert!(!tree.contains(3));\n\n    let root_ptr = tree.get_node(1);\n    let root: &TreeNode = unsafe { &*root_ptr };\n    c_assert!(root.child_count == 1);\n    c_assert!(root.child_ids[0] == 2);\n\n    Tree::delete(tree);\n    println!(\"✓ PASS: test_tree_remove_leaf\");\n}\n\nfn test_tree_remove_subtree() {\n    println!();\n    println!(\"=