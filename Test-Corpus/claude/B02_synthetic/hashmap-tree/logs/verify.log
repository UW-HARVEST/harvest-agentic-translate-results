{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DiqbpxX4RvPHPm7oY4hDc8","type":"tool_result","content":"1\t// Translated from c_src/src/hashmap.c\n2\t// Open-addressing hash map with linear probing and tombstone deletion.\n3\t\n4\tconst HASHMAP_INITIAL_CAPACITY: usize = 16;\n5\tconst HASHMAP_LOAD_FACTOR: f64 = 0.75;\n6\t\n7\tpub type TreeId = u64;\n8\t\n9\tpub struct Entry<V> {\n10\t    pub key: TreeId,\n11\t    pub value: Option<V>,\n12\t    pub occupied: bool,\n13\t    pub deleted: bool,\n14\t}\n15\t\n16\timpl<V> Default for Entry<V> {\n17\t    fn default() -> Self {\n18\t        Entry {\n19\t            key: 0,\n20\t            value: None,\n21\t            occupied: false,\n22\t            deleted: false,\n23\t        }\n24\t    }\n25\t}\n26\t\n27\tpub struct Hashmap<V> {\n28\t    entries: Vec<Entry<V>>,\n29\t    capacity: usize,\n30\t    size: usize,\n31\t    deleted_count: usize,\n32\t}\n33\t\n34\tfn hash_function(key: TreeId) -> u64 {\n35\t    // FNV-1a hash, byte-by-byte over the key bytes (native byte order, like C's\n36\t    // pointer-cast access).\n37\t    let mut hash: u64 = 14695981039346656037u64;\n38\t    let bytes = key.to_ne_bytes();\n39\t    for b in bytes.iter() {\n40\t        hash ^= *b as u64;\n41\t        hash = hash.wrapping_mul(1099511628211u64);\n42\t    }\n43\t    hash\n44\t}\n45\t\n46\timpl<V> Hashmap<V> {\n47\t    pub fn new() -> Self {\n48\t        let capacity = HASHMAP_INITIAL_CAPACITY;\n49\t        let mut entries = Vec::with_capacity(capacity);\n50\t        for _ in 0..capacity {\n51\t            entries.push(Entry::default());\n52\t        }\n53\t        Hashmap {\n54\t            entries,\n55\t            capacity,\n56\t            size: 0,\n57\t            deleted_count: 0,\n58\t        }\n59\t    }\n60\t\n61\t    fn should_resize(&self) -> bool {\n62\t        let load = (self.size + self.deleted_count) as f64 / self.capacity as f64;\n63\t        load > HASHMAP_LOAD_FACTOR\n64\t    }\n65\t\n66\t    fn resize(&mut self) {\n67\t        let new_capacity = self.capacity * 2;\n68\t        let mut new_entries: Vec<Entry<V>> = Vec::with_capacity(new_capacity);\n69\t        for _ in 0..new_capacity {\n70\t            new_entries.push(Entry::default());\n71\t        }\n72\t        let old_entries = std::mem::replace(&mut self.entries, new_entries);\n73\t        self.capacity = new_capacity;\n74\t        self.size = 0;\n75\t        self.deleted_count = 0;\n76\t\n77\t        for entry in old_entries.into_iter() {\n78\t            if entry.occupied && !entry.deleted {\n79\t                if let Some(v) = entry.value {\n80\t                    self.put(entry.key, v);\n81\t                }\n82\t            }\n83\t        }\n84\t    }\n85\t\n86\t    pub fn put(&mut self, key: TreeId, value: V) -> i32 {\n87\t        if self.should_resize() {\n88\t            self.resize();\n89\t        }\n90\t\n91\t        let hash = hash_function(key);\n92\t        let index = (hash as usize) % self.capacity;\n93\t\n94\t        for probe in 0..self.capacity {\n95\t            let current = (index + probe) % self.capacity;\n96\t            let entry = &mut self.entries[current];\n97\t\n98\t            if !entry.occupied {\n99\t                entry.key = key;\n100\t                entry.value = Some(value);\n101\t                entry.occupied = true;\n102\t                entry.deleted = false;\n103\t                self.size += 1;\n104\t                return 0;\n105\t            } else if entry.deleted {\n106\t                entry.key = key;\n107\t                entry.value = Some(value);\n108\t                entry.deleted = false;\n109\t                self.size += 1;\n110\t                self.deleted_count -= 1;\n111\t                return 0;\n112\t            } else if entry.key == key {\n113\t                entry.value = Some(value);\n114\t                return 0;\n115\t            }\n116\t        }\n117\t\n118\t        -1\n119\t    }\n120\t\n121\t    pub fn get(&self, key: T