{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RDmPirzBaLXzHTqWaWfBvY","type":"tool_result","content":"1\t// Translated from c_src/src/tree.c\n2\t\n3\tuse crate::hashmap::{Hashmap, TreeId};\n4\t\n5\tpub const MAX_CHILDREN: usize = 32;\n6\tpub const MAX_DATA_LENGTH: usize = 256;\n7\t\n8\tpub struct TreeNode {\n9\t    pub id: TreeId,\n10\t    pub parent_id: TreeId,\n11\t    pub child_ids: [TreeId; MAX_CHILDREN],\n12\t    pub child_count: i32,\n13\t    pub data: [u8; MAX_DATA_LENGTH],\n14\t}\n15\t\n16\timpl TreeNode {\n17\t    pub fn new(id: TreeId, parent_id: TreeId, data: &str) -> Self {\n18\t        let mut node = TreeNode {\n19\t            id,\n20\t            parent_id,\n21\t            child_ids: [0u64; MAX_CHILDREN],\n22\t            child_count: 0,\n23\t            data: [0u8; MAX_DATA_LENGTH],\n24\t        };\n25\t        // Mimic C's strncpy(node->data, data, MAX_DATA_LENGTH - 1) followed by\n26\t        // explicit null terminator.\n27\t        let bytes = data.as_bytes();\n28\t        let n = std::cmp::min(bytes.len(), MAX_DATA_LENGTH - 1);\n29\t        node.data[..n].copy_from_slice(&bytes[..n]);\n30\t        node.data[MAX_DATA_LENGTH - 1] = 0;\n31\t        node\n32\t    }\n33\t\n34\t    pub fn data_str(&self) -> &str {\n35\t        let end = self\n36\t            .data\n37\t            .iter()\n38\t            .position(|&b| b == 0)\n39\t            .unwrap_or(self.data.len());\n40\t        std::str::from_utf8(&self.data[..end]).unwrap_or(\"\")\n41\t    }\n42\t}\n43\t\n44\tpub struct Tree {\n45\t    pub node_map: Hashmap<TreeNode>,\n46\t    pub root_id: TreeId,\n47\t    pub has_root: bool,\n48\t    pub node_count: usize,\n49\t}\n50\t\n51\timpl Tree {\n52\t    pub fn new() -> Self {\n53\t        Tree {\n54\t            node_map: Hashmap::new(),\n55\t            root_id: 0,\n56\t            has_root: false,\n57\t            node_count: 0,\n58\t        }\n59\t    }\n60\t\n61\t    pub fn add_node(&mut self, id: TreeId, parent_id: TreeId, data: &str) -> i32 {\n62\t        // Check if node already exists\n63\t        if self.contains(id) {\n64\t            eprintln!(\"Error: Node with ID {} already exists\", id);\n65\t            return -1;\n66\t        }\n67\t\n68\t        let mut node = TreeNode::new(id, parent_id, data);\n69\t\n70\t        if !self.has_root {\n71\t            // First node becomes root\n72\t            self.root_id = id;\n73\t            self.has_root = true;\n74\t            node.parent_id = 0;\n75\t        } else {\n76\t            // Find parent and add this node as a child\n77\t            let parent = self.node_map.get_mut(parent_id);\n78\t            match parent {\n79\t                None => {\n80\t                    eprintln!(\"Error: Parent node {} not found\", parent_id);\n81\t                    return -1;\n82\t                }\n83\t                Some(parent) => {\n84\t                    if (parent.child_count as usize) >= MAX_CHILDREN {\n85\t                        eprintln!(\"Error: Parent has maximum children\");\n86\t                        return -1;\n87\t                    }\n88\t                    let idx = parent.child_count as usize;\n89\t                    parent.child_ids[idx] = id;\n90\t                    parent.child_count += 1;\n91\t                }\n92\t            }\n93\t        }\n94\t\n95\t        if self.node_map.put(id, node) != 0 {\n96\t            eprintln!(\"Error: Failed to add node to hashmap\");\n97\t            return -1;\n98\t        }\n99\t\n100\t        self.node_count += 1;\n101\t        0\n102\t    }\n103\t\n104\t    fn remove_subtree(&mut self, id: TreeId) -> i32 {\n105\t        // Collect children first (avoid mutating while iterating)\n106\t        let child_info = match self.node_map.get(id) {\n107\t            None => return -1,\n108\t            Some(node) => {\n109\t                let cnt = node.child_count as usize;\n110\t                let mut ids = [0u64; MAX_CHILDREN];\n111\t                ids[..cnt].c