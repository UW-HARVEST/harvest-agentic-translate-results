s various string comparison operations\n39\t * \n40\t * @param input Input string buffer\n41\t * @param input_len Length of input buffer\n42\t * @param reference Reference string for comparison\n43\t * @param ref_len Length of reference buffer\n44\t * @param operation Operation code:\n45\t *                  0: validate token\n46\t *                  1: parse command\n47\t *                  2: compare prefix\n48\t *                  3: find delimiter\n49\t *                  4: match pattern\n50\t * @param flags Operation flags (case sensitivity, exact match, etc)\n51\t * @return Operation result (match count, position, or error code)\n52\t */\n53\tint process_strings(char *input, size_t input_len, \n54\t                   const char *reference, size_t ref_len,\n55\t                   int operation, uint32_t flags) {\n56\t    \n57\t    if (input == NULL) {\n58\t        return -1;\n59\t    }\n60\t    \n61\t    /* Different operations based on operation code */\n62\t    switch (operation) {\n63\t        case 0: {\n64\t            /* Validate token - VULNERABLE if input not null-terminated */\n65\t            if (reference == NULL) return -2;\n66\t            return validate_token(input, reference);\n67\t        }\n68\t        \n69\t        case 1: {\n70\t            /* Parse command from list - checks against multiple strings */\n71\t            const char *commands[] = {\"START\", \"STOP\", \"PAUSE\", \"RESUME\", \"RESET\"};\n72\t            return parse_command(input, input_len, commands, 5);\n73\t        }\n74\t        \n75\t        case 2: {\n76\t            /* Compare prefix - can use strcmp or strncmp based on flags */\n77\t            if (reference == NULL) return -2;\n78\t            int exact = (flags & 0x01);\n79\t            return compare_prefix(input, reference, exact);\n80\t        }\n81\t        \n82\t        case 3: {\n83\t            /* Find delimiter position */\n84\t            char delim = (reference && ref_len > 0) ? reference[0] : ':';\n85\t    