{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014Qg97CLf6kV72TkGbidTXY","type":"tool_result","content":"1\t// Translation of c_src/src/lib.c into safe Rust.\n2\t//\n3\t// Notes on faithfulness:\n4\t// - The C buffers `input_buffer` and `ref_buffer` are uninitialized stack\n5\t//   arrays of MAX_BUFFER_SIZE bytes; only the first `input_len` / `ref_len`\n6\t//   are filled. The C `strcmp`/`strncmp` calls read past those lengths and\n7\t//   rely on terminating null bytes that may or may not exist (undefined\n8\t//   behavior). In Rust we treat the supplied byte arrays the same way as the\n9\t//   C code does: we treat them as C-style strings terminated by the first\n10\t//   NUL byte. The caller passes zero-initialized buffers so reads past\n11\t//   `len` will reliably stop at the first zero byte.\n12\t\n13\t/// Compute the C strlen of the buffer (number of bytes before first NUL).\n14\tfn c_strlen(buf: &[u8]) -> usize {\n15\t    buf.iter().position(|&b| b == 0).unwrap_or(buf.len())\n16\t}\n17\t\n18\t/// Compare two C strings (NUL-terminated) like C `strcmp`.\n19\t/// Returns negative / zero / positive like C.\n20\tfn c_strcmp(a: &[u8], b: &[u8]) -> i32 {\n21\t    let mut i = 0usize;\n22\t    loop {\n23\t        let ca = if i < a.len() { a[i] } else { 0 };\n24\t        let cb = if i < b.len() { b[i] } else { 0 };\n25\t        if ca != cb {\n26\t            return (ca as i32) - (cb as i32);\n27\t        }\n28\t        if ca == 0 {\n29\t            return 0;\n30\t        }\n31\t        i += 1;\n32\t    }\n33\t}\n34\t\n35\t/// C strncmp: compare up to n bytes, stopping early at a NUL.\n36\tfn c_strncmp(a: &[u8], b: &[u8], n: usize) -> i32 {\n37\t    let mut i = 0usize;\n38\t    while i < n {\n39\t        let ca = if i < a.len() { a[i] } else { 0 };\n40\t        let cb = if i < b.len() { b[i] } else { 0 };\n41\t        if ca != cb {\n42\t            return (ca as i32) - (cb as i32);\n43\t        }\n44\t        if ca == 0 {\n45\t            return 0;\n46\t        }\n47\t        i += 1;\n48\t    }\n49\t    0\n50\t}\n51\t\n52\t/// Mimics C `strncpy(dest, src, n)`: copies up to n bytes, padding with NUL\n53\t/// if src is shorter than n. Does NOT null-terminate dest if src has >= n\n54\t/// bytes before its NUL.\n55\tfn c_strncpy(dest: &mut [u8], src: &[u8], n: usize) {\n56\t    let mut copied_nul = false;\n57\t    for i in 0..n {\n58\t        if i >= dest.len() {\n59\t            break;\n60\t        }\n61\t        if copied_nul {\n62\t            dest[i] = 0;\n63\t        } else {\n64\t            let c = if i < src.len() { src[i] } else { 0 };\n65\t            dest[i] = c;\n66\t            if c == 0 {\n67\t                copied_nul = true;\n68\t            }\n69\t        }\n70\t    }\n71\t}\n72\t\n73\t/// Mimics C `strncat(dest, src, n)`: appends up to n bytes from src to the\n74\t/// end of dest (the position of the first NUL in dest), then writes a final\n75\t/// NUL terminator after the appended bytes.\n76\tfn c_strncat(dest: &mut [u8], src: &[u8], n: usize) {\n77\t    let start = c_strlen(dest);\n78\t    let mut written = 0usize;\n79\t    while written < n {\n80\t        let pos = start + written;\n81\t        if pos >= dest.len() {\n82\t            return;\n83\t        }\n84\t        let c = if written < src.len() { src[written] } else { 0 };\n85\t        if c == 0 {\n86\t            dest[pos] = 0;\n87\t            return;\n88\t        }\n89\t        dest[pos] = c;\n90\t        written += 1;\n91\t    }\n92\t    let nul_pos = start + written;\n93\t    if nul_pos < dest.len() {\n94\t        dest[nul_pos] = 0;\n95\t    }\n96\t}\n97\t\n98\t/// Process strings - main library entry point matching the C signature.\n99\t///\n100\t/// `input` is the input buffer (mutable in C, but we don't modify it).\n101\t/// `input_len` is the user-supplied input length.\n102\t/// `reference` is the reference buffer.\n103\t/// `ref_len` is the reference length.\n104\tpub fn process_strings(\n105\t    input: &mut [u8],\n106\t    input_len: usize,\n107\t    reference: &[u8],\n108\t    ref_len: usize,\n109\t    operation: i32,\n110\t    flags: u32,\n111\t) -> i32 {\n112\t    // The C code checks `input == NULL`. In Rust, slices are non-null; we\n113\t    // treat an empty slice as \"not null\" since the caller always provides\n114\t    // a buffer.\n115\t    // (We intentionally do not return -1 because input is always non-null.)\n116\t    let _ = input;\n117\t\n118\t    match operation {\n119\t        0 => {\n120\t            // Validate token - C also has `if (reference == NULL) return -2;`\n121\t            // but reference is always provided, so skip that.\n122\t            validate_token(input, reference)\n123\t        }\n124\t        1 => {\n125\t            let commands: [&[u8]; 5] = [\n126\t                b\"START\\0\",\n127\t                b\"STOP\\0\",\n128\t                b\"PAUSE\\0\",\n129\t                b\"RESUME\\0\",\n130\t                b\"RESET\\0\",\n131\t            ];\n132\t            parse_command(input, input_len, &commands)\n133\t        }\n134\t        2 => {\n135\t            let exact = (flags & 0x01) != 0;\n136\t            compare_prefix(input, reference, exact)\n137\t        }\n138\t        3 => {\n139\t            // Determine delimiter.\n140\t            let delim: u8 = if ref_len > 0 && !reference.is_empty() {\n141\t                reference[0]\n142\t            } else {\n143\t                b':'\n144\t            };\n145\t            find_delimiter(input, input_len, delim)\n146\t        }\n147\t        4 => {\n148\t            let case_sens = (flags & 0x02) != 0;\n149\t            match_pattern(input, reference, case_sens)\n150\t        }\n151\t        _ => -3,\n152\t    }\n153\t}\n154\t\n155\tfn validate_token(token: &[u8], expected: &[u8]) -> i32 {\n156\t    if c_strcmp(token, expected) == 0 {\n157\t        return 1;\n158\t    }\n159\t    if c_strcmp(token, b\"VALID\\0\") == 0 || c_strcmp(token, b\"OK\\0\") == 0 {\n160\t        return 1;\n161\t    }\n162\t    0\n163\t}\n164\t\n165\tfn parse_command(buffer: &[u8], buf_size: usize, cmd_list: &[&[u8]]) -> i32 {\n166\t    for (i, cmd) in cmd_list.iter().enumerate() {\n167\t        let cmd_len = c_strlen(cmd);\n168\t        if buf_size >= cmd_len {\n169\t            if c_strncmp(buffer, cmd, cmd_len) == 0 {\n170\t                let next = if cmd_len < buffer.len() { buffer[cmd_len] } else { 0 };\n171\t                if next == 0 || next == b' ' {\n172\t                    return i as i32;\n173\t                }\n174\t            }\n175\t        }\n176\t        if c_strcmp(buffer, cmd) == 0 {\n177\t            return i as i32;\n178\t        }\n179\t    }\n180\t    if c_strcmp(buffer, b\"ADMIN\\0\") == 0 {\n181\t        return 99;\n182\t    }\n183\t    -1\n184\t}\n185\t\n186\tfn compare_prefix(s: &[u8], prefix: &[u8], exact_match: bool) -> i32 {\n187\t    let prefix_len = c_strlen(prefix);\n188\t\n189\t    if exact_match {\n190\t        if c_strcmp(s, prefix) == 0 {\n191\t            return 1;\n192\t        }\n193\t        let variations: [&[u8]; 5] = [b\"_v1\\0\", b\"_v2\\0\", b\"_old\\0\", b\"_new\\0\", b\"_tmp\\0\"];\n194\t        for (i, var) in variations.iter().enumerate() {\n195\t            // char expected[64];\n196\t            let mut expected = [0u8; 64];\n197\t            // strncpy(expected, prefix, 63);\n198\t            c_strncpy(&mut expected[..63], prefix, 63);\n199\t            // expected[63] = '\\0';\n200\t            expected[63] = 0;\n201\t            // strncat(expected, variations[i], 63 - strlen(expected));\n202\t            let cur_len = c_strlen(&expected);\n203\t            // The C code passes 63 - strlen(expected) as n (could underflow\n204\t            // if strlen(expected) > 63, but expected is limited).\n205\t            let n = 63usize.wrapping_sub(cur_len);\n206\t            c_strncat(&mut expected, var, n);\n207\t            if c_strcmp(s, &expected) == 0 {\n208\t                return 2 + i as i32;\n209\t            }\n210\t        }\n211\t        0\n212\t    } else {\n213\t        if c_strncmp(s, prefix, prefix_len) == 0 {\n214\t            return 1;\n215\t        }\n216\t        0\n217\t    }\n218\t}\n219\t\n220\tfn find_delimiter(data: &[u8], len: usize, delim: u8) -> i32 {\n221\t    if len == 0 {\n222\t        return -1;\n223\t    }\n224\t    let mut i = 0usize;\n225\t    while i < len {\n226\t        if i >= data.len() {\n227\t            break;\n228\t        }\n229\t        if data[i] == delim {\n230\t            return i as i32;\n231\t        }\n232\t        if data[i] == 0 {\n233\t            break;\n234\t        }\n235\t        i += 1;\n236\t    }\n237\t    if delim == b'|' && c_strcmp(data, b\"NONE\\0\") == 0 {\n238\t        return -2;\n239\t    }\n240\t    if delim == b':' && c_strcmp(data, b\"EMPTY\\0\") == 0 {\n241\t        return -3;\n242\t    }\n243\t    -1\n244\t}\n245\t\n246\tfn match_pattern(text: &[u8], pattern: &[u8], case_sensitive: bool) -> i32 {\n247\t    if case_sensitive {\n248\t        if c_strcmp(text, pattern) == 0 {\n249\t            return 1;\n250\t        }\n251\t\n252\t        // Construct wildcard patterns using snprintf-like behavior.\n253\t        // wildcard_patterns[0] = \"*<pattern>*\"\n254\t        // wildcard_patterns[1] = \"<pattern>*\"\n255\t        // wildcard_patterns[2] = \"*<pattern>\"\n256\t        let mut wildcard_patterns: [[u8; 64]; 3] = [[0u8; 64]; 3];\n257\t\n258\t        snprintf_wildcard(&mut wildcard_patterns[0], b\"*\", pattern, b\"*\");\n259\t        snprintf_wildcard(&mut wildcard_patterns[1], b\"\", pattern, b\"*\");\n260\t        snprintf_wildcard(&mut wildcard_patterns[2], b\"*\", pattern, b\"\");\n261\t\n262\t        for i in 0..3 {\n263\t            if c_strcmp(text, &wildcard_patterns[i]) == 0 {\n264\t                return 2 + i as i32;\n265\t            }\n266\t        }\n267\t\n268\t        let text_len = c_strlen(text);\n269\t        let pattern_len = c_strlen(pattern);\n270\t\n271\t        if pattern_len == 0 {\n272\t            // strncmp with n=0 returns 0, so this would always match at i=0.\n273\t            // The loop runs i = 0..=text_len.\n274\t            // We replicate that behavior - return 10 + 0 = 10 for first iteration.\n275\t            // (Faithfully this would return 10 immediately.)\n276\t            return 10;\n277\t        }\n278\t\n279\t        // C does `for (size_t i = 0; i <= text_len - pattern_len; i++)`.\n280\t        // If pattern_len > text_len, the subtraction underflows. The loop\n281\t        // would run effectively forever and read out of bounds. We avoid\n282\t        // crashing by checking the underflow condition first.\n283\t        if text_len >= pattern_len {\n284\t            let upper = text_len - pattern_len;\n285\t            for i in 0..=upper {\n286\t                if c_strncmp(&text[i..], pattern, pattern_len) == 0 {\n287\t                    return 10 + i as i32;\n288\t                }\n289\t            }\n290\t        }\n291\t    } else {\n292\t        if c_strcmp(text, pattern) == 0 {\n293\t            return 1;\n294\t        }\n295\t\n296\t        let pattern_len = c_strlen(pattern);\n297\t        let text_len = c_strlen(text);\n298\t\n299\t        if text_len != pattern_len {\n300\t            if c_strncmp(text, pattern, pattern_len) == 0 {\n301\t                return 5;\n302\t            }\n303\t        }\n304\t\n305\t        if text_len == pattern_len {\n306\t            let mut is_match = true;\n307\t            for i in 0..pattern_len {\n308\t                let mut c1 = if i < text.len() { text[i] } else { 0 };\n309\t                let mut c2 = if i < pattern.len() { pattern[i] } else { 0 };\n310\t                if c1 >= b'A' && c1 <= b'Z' {\n311\t                    c1 += 32;\n312\t                }\n313\t                if c2 >= b'A' && c2 <= b'Z' {\n314\t                    c2 += 32;\n315\t                }\n316\t                if c1 != c2 {\n317\t                    is_match = false;\n318\t               