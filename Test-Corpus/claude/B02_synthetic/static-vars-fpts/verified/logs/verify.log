t            case TOKEN_OPERATOR:\n103\t                result.operator_count++;\n104\t                break;\n105\t                \n106\t            case TOKEN_COMMENT:\n107\t                result.comment_count++;\n108\t                break;\n109\t                \n110\t            case TOKEN_STRING:\n111\t                result.string_count++;\n112\t                break;\n113\t                \n114\t            case TOKEN_NEWLINE:\n115\t                result.line_count++;\n116\t                break;\n117\t                \n118\t            default:\n119\t                break;\n120\t        }\n121\t    }\n122\t    \n123\t    // Get final statistics using function pointer\n124\t    size_t lines, tokens, chars;\n125\t    tokenizer_ops.get_stats(&lines, &tokens, &chars);\n126\t    \n127\t    result.line_count = lines;\n128\t    result.char_count = chars;\n129\t    \n130\t    return result;\n131\t}\n132\t\n133\tvoid print_token_distribution(void) {\n134\t    printf(\"\\n=== Token Distribution ===\\n\");\n135\t    \n136\t    const char *token_names[] = {\n137\t        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCTUATION\", \"WHITESPACE\",\n138\t        \"NEWLINE\", \"IDENTIFIER\", \"KEYWORD\", \"OPERATOR\", \n139\t        \"STRING\", \"COMMENT\", \"ERROR\"\n140\t    };\n141\t    \n142\t    for (int i = 0; i < 12; i++) {\n143\t        if (token_type_counts[i] > 0) {\n144\t            printf(\"%s: %d\\n\", token_names[i], token_type_counts[i]);\n145\t        }\n146\t    }\n147\t    \n148\t    printf(\"\\n=== Most Common Words ===\\n\");\n149\t    \n150\t    // Simple bubble sort for display\n151\t    for (int i = 0; i < num_common_words - 1; i++) {\n152\t        for (int j = 0; j < num_common_words - i - 1; j++) {\n153\t            if (common_word_counts[j] < common_word_counts[j + 1]) {\n154\t                // Swap counts\n155\t                int temp_count = common_word_counts[j];\n156\t                common_word_counts[j] = common_word_counts[j + 1];\n157\t          