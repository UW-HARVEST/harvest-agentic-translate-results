atch path, `analyze_text`, and `calculate_complexity_score`.\n\n### Notes\n- C's `token.value` array contains uninitialized stack bytes past the null terminator, while Rust zero-fills, so `tokens_equal` only compares meaningful bytes (`length + 1`)."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":647,"cache_read_input_tokens":71247,"cache_creation":{"ephemeral_5m_input_tokens":647,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"47ced015-b554-4c89-ac3f-1e604ced3183","uuid":"f2bbd634-c8cc-4520-a0df-e3751f7db004"}
