ngth++] = advance_char(); // Escape character\n164\t            if (peek_char() != '\\0') {\n165\t                buffer[length++] = advance_char(); // Escaped character\n166\t            }\n167\t        } else {\n168\t            buffer[length++] = advance_char();\n169\t        }\n170\t    }\n171\t    \n172\t    if (peek_char() == quote) {\n173\t        buffer[length++] = advance_char(); // Closing quote\n174\t    }\n175\t    \n176\t    buffer[length] = '\\0';\n177\t    return create_token(TOKEN_STRING, buffer, length);\n178\t}\n179\t\n180\tstatic token_t scan_comment(void) {\n181\t    char buffer[MAX_TOKEN_LENGTH];\n182\t    size_t length = 0;\n183\t    \n184\t    // Assume we've seen '/'\n185\t    buffer[length++] = advance_char(); // First '/'\n186\t    \n187\t    if (peek_char() == '/') {\n188\t        // Single-line comment\n189\t        buffer[length++] = advance_char(); // Second '/'\n190\t        \n191\t        while (peek_char() != '\\0' && \n192\t               peek_char() != '\\n' && \n193\t               length < MAX_TOKEN_LENGTH - 1) {\n194\t            buffer[length++] = advance_char();\n195\t        }\n196\t    } else if (peek_char() == '*') {\n197\t        // Multi-line comment\n198\t        buffer[length++] = advance_char(); // '*'\n199\t        \n200\t        while (peek_char() != '\\0' && length < MAX_TOKEN_LENGTH - 2) {\n201\t            if (peek_char() == '*') {\n202\t                buffer[length++] = advance_char();\n203\t                if (peek_char() == '/') {\n204\t                    buffer[length++] = advance_char();\n205\t                    break;\n206\t                }\n207\t            } else {\n208\t                buffer[length++] = advance_char();\n209\t            }\n210\t        }\n211\t    }\n212\t    \n213\t    buffer[length] = '\\0';\n214\t    return create_token(TOKEN_COMMENT, buffer, length);\n215\t}\n216\t\n217\tstatic token_t scan_operator(void) {\n218\t    char buffer[MAX_TOKEN_LENGTH];\n219\t    size_t length = 0;\n220\t    char c = peek_char();\n221\t    \n222\t    buffer[length++] = advance_char();\n223\t    \n224\t    // Check for two-character operators\n225\t    char next = peek_char();\n226\t    if ((c == '=' && next == '=') ||\n227\t        (c == '!' && next == '=') ||\n228\t        (c == '<' && next == '=') ||\n229\t        (c == '>' && next == '=') ||\n230\t        (c == '&' && next == '&') ||\n231\t        (c == '|' && next == '|') ||\n232\t        (c == '+' && next == '+') ||\n233\t        (c == '-' && next == '-') ||\n234\t        (c == '-' && next == '>') ||\n235\t        (c == '<' && next == '<') ||\n236\t        (c == '>' && next == '>')) {\n237\t        buffer[length++] = advance_char();\n238\t    }\n239\t    \n240\t    buffer[length] = '\\0';\n241\t    return create_token(TOKEN_OPERATOR, buffer, length);\n242\t}\n243\t\n244\t// Public functions that use static globals\n245\ttoken_t tokenizer_next_token(void) {\n246\t    // Check if we have a lookahead token\n247\t    if (lookahead_valid) {\n248\t        lookahead_valid = 0;\n249\t        return lookahead_token;\n250\t    }\n251\t    \n252\t    skip_whitespace();\n253\t    \n254\t    if (current_position >= buffer_length) {\n255\t        return create_token(TOKEN_EOF, \"\", 0);\n256\t    }\n257\t    \n258\t    char c = peek_char();\n259\t    \n260\t    // Newline\n261\t    if (c == '\\n') {\n262\t        char newline[2] = {advance_char(), '\\0'};\n263\t        return create_token(TOKEN_NEWLINE, newline, 1);\n264\t    }\n265\t    \n266\t    // Identifier or keyword\n267\t    if (isalpha(c) || c == '_') {\n268\t        return scan_word();\n269\t    }\n270\t    \n271\t    // Number\n272\t    if (isdigit(c)) {\n273\t        return scan_number();\n274\t    }\n275\t    \n276\t    // String\n277\t    if (c == '\"' || c == '\\'') {\n278\t        return scan_string();\n279\t    }\n280\t    \n281\t    // Comment\n282\t    if (c == '/' && (peek_char() == '/' || peek_char() == '*')) {\n283\t        return scan_comment();\n28