{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EXRpwXw1vfE1jpqCZDoM9B","type":"tool_result","content":"1\t// Rust translation of c_src/src/tokenizer.c\n2\t\n3\tuse std::cell::RefCell;\n4\t\n5\tpub const MAX_TOKEN_LENGTH: usize = 256;\n6\tpub const MAX_BUFFER_SIZE: usize = 8192;\n7\t\n8\t#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n9\t#[repr(u8)]\n10\tpub enum TokenType {\n11\t    Eof = 0,\n12\t    Word = 1,\n13\t    Number = 2,\n14\t    Punctuation = 3,\n15\t    Whitespace = 4,\n16\t    Newline = 5,\n17\t    Identifier = 6,\n18\t    Keyword = 7,\n19\t    Operator = 8,\n20\t    String = 9,\n21\t    Comment = 10,\n22\t    Error = 11,\n23\t}\n24\t\n25\t#[derive(Clone)]\n26\tpub struct Token {\n27\t    pub ttype: TokenType,\n28\t    /// Holds `length` bytes followed by a `0` terminator byte (mirrors C `char value[MAX_TOKEN_LENGTH]`).\n29\t    pub value: Vec<u8>,\n30\t    pub length: usize,\n31\t    pub line: i32,\n32\t    pub column: i32,\n33\t}\n34\t\n35\t#[derive(Clone, Copy)]\n36\tpub struct TokenizerOps {\n37\t    pub next_token: fn() -> Token,\n38\t    pub peek_token: fn() -> Token,\n39\t    pub reset: fn(),\n40\t    pub load_text: fn(&[u8]) -> i32,\n41\t    pub get_stats: fn() -> (usize, usize, usize),\n42\t}\n43\t\n44\tstruct State {\n45\t    input_buffer: Vec<u8>,\n46\t    buffer_length: usize,\n47\t    current_position: usize,\n48\t    current_line: i32,\n49\t    current_column: i32,\n50\t    total_tokens_processed: usize,\n51\t    total_lines_processed: usize,\n52\t    total_chars_processed: usize,\n53\t    lookahead_token: Option<Token>,\n54\t    lookahead_valid: bool,\n55\t}\n56\t\n57\timpl State {\n58\t    fn new() -> Self {\n59\t        State {\n60\t            input_buffer: vec![0u8; MAX_BUFFER_SIZE],\n61\t            buffer_length: 0,\n62\t            current_position: 0,\n63\t            current_line: 1,\n64\t            current_column: 1,\n65\t            total_tokens_processed: 0,\n66\t            total_lines_processed: 0,\n67\t            total_chars_processed: 0,\n68\t            lookahead_token: None,\n69\t            lookahead_valid: false,\n70\t        }\n71\t    }\n72\t}\n73\t\n74\tthread_local! {\n75\t    static STATE: RefCell<State> = RefCell::new(State::new());\n76\t}\n77\t\n78\tconst KEYWORDS: &[&[u8]] = &[\n79\t    b\"if\", b\"else\", b\"while\", b\"for\", b\"return\", b\"int\", b\"char\",\n80\t    b\"float\", b\"double\", b\"void\", b\"struct\", b\"typedef\", b\"const\",\n81\t    b\"static\", b\"extern\", b\"auto\", b\"register\", b\"sizeof\", b\"break\",\n82\t    b\"continue\", b\"switch\", b\"case\", b\"default\", b\"do\", b\"goto\",\n83\t    b\"enum\", b\"union\", b\"signed\", b\"unsigned\", b\"long\", b\"short\",\n84\t];\n85\t\n86\tfn is_keyword(s: &[u8]) -> bool {\n87\t    KEYWORDS.iter().any(|k| *k == s)\n88\t}\n89\t\n90\t// C isspace() returns nonzero for ' ', '\\t', '\\n', '\\v', '\\f', '\\r'.\n91\t// skip_whitespace excludes '\\n', so this set is the rest.\n92\tfn is_skippable_ws(c: u8) -> bool {\n93\t    matches!(c, b' ' | b'\\t' | 0x0B | 0x0C | b'\\r')\n94\t}\n95\t\n96\tfn is_alpha(c: u8) -> bool {\n97\t    (b'a'..=b'z').contains(&c) || (b'A'..=b'Z').contains(&c)\n98\t}\n99\t\n100\tfn is_digit(c: u8) -> bool {\n101\t    (b'0'..=b'9').contains(&c)\n102\t}\n103\t\n104\tfn is_alnum(c: u8) -> bool {\n105\t    is_alpha(c) || is_digit(c)\n106\t}\n107\t\n108\tfn peek_char(s: &State) -> u8 {\n109\t    if s.current_position >= s.buffer_length {\n110\t        0\n111\t    } else {\n112\t        s.input_buffer[s.current_position]\n113\t    }\n114\t}\n115\t\n116\tfn advance_char(s: &mut State) -> u8 {\n117\t    if s.current_position >= s.buffer_length {\n118\t        return 0;\n119\t    }\n120\t    let c = s.input_buffer[s.current_position];\n121\t    s.current_position += 1;\n122\t    s.total_chars_processed += 1;\n123\t    if c == b'\\n' {\n124\t        s.current_line += 1;\n125\t        s.current_column = 1;\n126\t        s.total_lines_processed += 1;\n127\t    } else {\n128\t        s.current_column += 1;\n129\t    }\n130\t    c\n131\t}\n132\t\n133\tfn skip_whitespace(s: &mut State) {\n134\t    loop {\n135\t        let c = peek_char(s);\n136\t        if c != 0 && is_skippable_ws(c) && c != b'\\n' {\n137\t            advance_char(s);\n138\t        } else {\n139\t            break;\n140\t        }\n141\t    }\n142\t}\n143\t\n144\tfn create_token(s: &mut State, ttype: TokenType, value: &[u8]) -> Token {\n145\t    let length = if value.len() < MAX_TOKEN_LENGTH {\n146\t        value.len()\n147\t    } else {\n148\t        MAX_TOKEN_LENGTH - 1\n149\t    };\n150\t    let mut buf = vec![0u8; length + 1];\n151\t    buf[..length].copy_from_slice(&value[..length]);\n152\t    // Mirror C: token.column = current_column - token.length (with C's signed/unsigned mixing).\n153\t    let column = (s.current_column).wrapping_sub(length as i32);\n154\t    s.total_tokens_processed += 1;\n155\t    Token {\n156\t        ttype,\n157\t        value: buf,\n158\t        length,\n159\t        line: s.current_line,\n160\t        column,\n161\t    }\n162\t}\n163\t\n164\tfn scan_word(s: &mut State) -> Token {\n165\t    let mut buffer = [0u8; MAX_TOKEN_LENGTH];\n166\t    let mut length: usize = 0;\n167\t    while peek_char(s) != 0\n168\t        && (is_alnum(peek_char(s)) || peek_char(s) == b'_')\n169\t        && length < MAX_TOKEN_LENGTH - 1\n170\t    {\n171\t        buffer[length] = advance_char(s);\n172\t        length += 1;\n173\t    }\n174\t    let val = &buffer[..length];\n175\t    if is_keyword(val) {\n176\t        create_token(s, TokenType::Keyword, val)\n177\t    } else {\n178\t        create_token(s, TokenType::Identifier, val)\n179\t    }\n180\t}\n181\t\n182\tfn scan_number(s: &mut State) -> Token {\n183\t    let mut buffer = [0u8; MAX_TOKEN_LENGTH];\n184\t    let mut length: usize = 0;\n185\t    let mut has_decimal = false;\n186\t    while peek_char(s) != 0\n187\t        && (is_digit(peek_char(s)) || peek_char(s) == b'.')\n188\t        && length < MAX_TOKEN_LENGTH - 1\n189\t    {\n190\t        if peek_char(s) == b'.' {\n191\t            if has_decimal {\n192\t                break;\n193\t            }\n194\t            has_decimal = true;\n195\t        }\n196\t        buffer[length] = advance_char(s);\n197\t        length += 1;\n198\t    }\n199\t    create_token(s, TokenType::Number, &buffer[..length])\n200\t}\n201\t\n202\tfn scan_string(s: &mut State) -> Token {\n203\t    let mut buffer = [0u8; MAX_TOKEN_LENGTH];\n204\t    let mut length: usize = 0;\n205\t    let quote = advance_char(s);\n206\t    buffer[length] = quote;\n207\t    length += 1;\n208\t    while peek_char(s) != 0\n209\t        && peek_char(s) != quote\n210\t        && peek_char(s) != b'\\n'\n211\t        && length < MAX_TOKEN_LENGTH - 2\n212\t    {\n213\t        if peek_char(s) == b'\\\\' {\n214\t            buffer[length] = advance_char(s);\n215\t            length += 1;\n216\t            if peek_char(s) != 0 {\n217\t                buffer[length] = advance_char(s);\n218\t                length += 1;\n219\t            }\n220\t        } else {\n221\t            buffer[length] = advance_char(s);\n222\t            length += 1;\n223\t        }\n224\t    }\n225\t    if peek_char(s) == quote {\n226\t        buffer[length] = advance_char(s);\n227\t        length += 1;\n228\t    }\n229\t    create_token(s, TokenType::String, &buffer[..length])\n230\t}\n231\t\n232\tfn scan_comment(s: &mut State) -> Token {\n233\t    let mut buffer = [0u8; MAX_TOKEN_LENGTH];\n234\t    let mut length: usize = 0;\n235\t    // First '/' (already determined to be '/')\n236\t    buffer[length] = advance_char(s);\n237\t    length += 1;\n238\t    if peek_char(s) == b'/' {\n239\t        // Single-line comment\n240\t        buffer[length] = advance_char(s);\n241\t        length += 1;\n242\t        while peek_char(s) != 0\n243\t            && peek_char(s) != b'\\n'\n244\t            && length < MAX_TOKEN_LENGTH - 1\n245\t        {\n246\t            buffer[length] = advance_char(s);\n247\t            length += 1;\n248\t        }\n249\t    } else if peek_char(s) == b'*' {\n250\t        // Multi-line comment\n251\t        buffer[length] = advance_char(s);\n252\t        length += 1;\n253\t        while peek_char(s) != 0 && length < MAX_TOKEN_LENGTH - 2 {\n254\t            if peek_char(s) == b'*' {\n255\t                buffer[length] = advance_char(s);\n256\t                length += 1;\n257\t                if peek_char(s) == b'/' {\n258\t                    buffer[length] = advance_char(s);\n259\t                    length += 1;\n260\t                    break;\n261\t                }\n262\t            } else {\n263\t                buffer[length] = advance_char(s);\n264\t                length += 1;\n265\t            }\n266\t        }\n267\t    }\n268\t    create_token(s, TokenType::Comment, &buffer[..length])\n269\t}\n270\t\n271\tfn scan_operator(s: &mut State) -> Token {\n272\t    let mut buffer = [0u8; MAX_TOKEN_LENGTH];\n273\t    let mut length: usize = 0;\n274\t    let c = peek_char(s);\n275\t    buffer[length] = advance_char(s);\n276\t    length += 1;\n277\t    let next = peek_char(s);\n278\t    let two_char = matches!(\n279\t        (c, next),\n280\t        (b'=', b'=')\n281\t            | (b'!', b'=')\n282\t            | (b'<', b'=')\n283\t            | (b'>', b'=')\n284\t            | (b'&', b'&')\n285\t            | (b'|', b'|')\n286\t            | (b'+', b'+')\n287\t            | (b'-', b'-')\n288\t            | (b'-', b'>')\n289\t            | (b'<', b'<')\n290\t            | (b'>', b'>')\n291\t    );\n292\t    if two_char {\n293\t        buffer[length] = advance_char(s);\n294\t        length += 1;\n295\t    }\n296\t    create_token(s, TokenType::Operator, &buffer[..length])\n297\t}\n298\t\n299\tfn next_token_impl(s: &mut State) -> Token {\n300\t    if s.lookahead_valid {\n301\t        s.lookahead_valid = false;\n302\t        return s.lookahead_token.take().unwrap();\n303\t    }\n304\t\n305\t    skip_whitespace(s);\n306\t\n307\t    if s.current_position >= s.buffer_length {\n308\t        return create_token(s, TokenType::Eof, b\"\");\n309\t    }\n310\t\n311\t    let c = peek_char(s);\n312\t\n313\t    // Newline\n314\t    if c == b'\\n' {\n315\t        let nl = [advance_char(s)];\n316\t        return create_token(s, TokenType::Newline, &nl);\n317\t    }\n318\t\n319\t    // Identifier or keyword\n320\t    if is_alpha(c) || c == b'_' {\n321\t        return scan_word(s);\n322\t    }\n323\t\n324\t    // Number\n325\t    if is_digit(c) {\n326\t        return scan_number(s);\n327\t    }\n328\t\n329\t    // String\n330\t    if c == b'\"' || c == b'\\'' {\n331\t        return scan_string(s);\n332\t    }\n333\t\n334\t    // Comment (preserving the C behavior: peek_char() == c after only peeking,\n335\t    // so any '/' triggers scan_comment).\n336\t    if c == b'/' && (peek_char(s) == b'/' || peek_char(s) == b'*') {\n337\t        return scan_comment(s);\n338\t    }\n339\t\n340\t    // Operator\n341\t    if b\"+-*/%=<>!&|^~?:\".contains(&c) {\n342\t        return scan_operator(s);\n343\t    }\n344\t\n345\t    // Punctuation\n346\t    if b\"(){}[];,.\".contains(&c) {\n347\t        let p = [advance_char(s)];\n348\t        return create_token(s, TokenType::Punctuation, &p);\n349\t    }\n350\t\n351\t    // Unknown character\n352\t    let u = [advance_char(s)];\n353\t    create_token(s, TokenType::Error, &u)\n354\t}\n355\t\n356\tpub fn tokenizer_next_token() -> Token {\n357\t    STATE.with(|st| {\n358\t        let mut s = st.borrow_mut();\n359\t        next_token_impl(&mut s)\n360\t    })\n361\t}\n362\t\n363\tpub fn tokenizer_peek_token() -> Token {\n364\t    STATE.with(|st| {\n365\t        let mut s = st.borrow_mut();\n366\t        if !s.lookahead_valid {\n367\t            let t = next_token_impl(&mut s);\n368\t            s.lookahead_token = Some(t);\n369\t            s.lookahead_valid = true;\n370\t        }\n371\t        s.lookahead_token.clone().unwrap()\n372\t    })\n373\t}\n374\t\n375\tpub fn tokenizer_reset() {\n376\t    STATE.with(|st| {\n377\t        let mut s = st.borrow_mut();\n378\t        s.current_position = 0;\n379\t        s.current_line = 1;\n380\t        s.current_column = 1;\n381\t        s.lookahead_valid = false;\n382\t        s.lookahead_token = None;\n383\t        // total statistics intentionally not reset\n384\t    });\n385\t}\n386\t\n387\tpub fn tokenizer_load_text(text: &[u8]) -> i32 {\n388\t    let length = text.len();\n389\t    if length >= MAX_BUFFER_SIZE {\n390\t        eprintln!(\"Error: Input text too large\");\n391\t        return -1;\n392\t    }\n393\t    STATE.with(|st| {\n394\t        let mut s = st.borrow_mut();\n395\t        // strncpy semantics; we only care about the first `length` bytes anyway.\n396\t        for i in 0..length {\n397\t            s.input_buffer[i] = text[i];\n398\t        }\n399\t        s.input_buffer[MAX_BUFFER_SIZE - 1] = 0;\n400\t        s.buffer_length = length;\n401\t        // Inline reset (avoid borrowing twice).\n402\t        s.current_position = 0;\n403\t        s.current_line = 1;\n404\t        s.current_column = 1;\n405\t        s.lookahead_valid = false;\n406\t        s.lookahead_token = None;\n407\t    });\n408\t    0\n409\t}\n410\t\n411\tpub fn tokenizer_get_stats() -> (usize, usize, usize) {\n412\t    STATE.with(|st| {\n413\t        let s = st.borrow();\n414\t        (\n415\t            s.total_lines_processed,\n416\t            s.total_tokens_processed,\n417\t            s.total_chars_processed,\n418\t        )\n419\t    })\n420\t}\n421\t\n422\tpub fn get_tokenizer_ops() -> TokenizerOps {\n423\t    TokenizerOps {\n424\t        next_token: tokenizer_next_token,\n425\t        peek_token: tokenizer_peek_token,\n426\t        reset: tokenizer_reset,\n427\t        load_text: tokenizer_load_text,\n428\t        get_stats: tokenizer_get_stats,\n429\t    }\n430\t}\n431\t"}]},"parent_tool_use_id":null,"session_id":"47ced015-b554-4c89-ac3f-1e604ced3183","uuid":"8a0f1792-6a06-435f-ba80-96259c7465c6","timestamp":"2026-05-27T21:19:12.778Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-work-ZioW2W/translated_rust/src/tokenizer.rs","content":"// Rust translation of c_src/src/tokenizer.c\n\nuse std::cell::RefCell;\n\npub const MAX_TOKEN_LENGTH: usize = 256;\npub const MAX_BUFFER_SIZE: usize = 8192;\n\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n#[repr(u8)]\npub enum TokenType {\n    Eof = 0,\n    Word = 1,\n    Number = 2,\n    Punctuation = 3,\n    Whitespace = 4,\n    Newline = 5,\n    Identifier = 6,\n    Keyword = 7,\n    Operator = 8,\n    String = 9,\n    Comment = 10,\n    Error = 11,\n}\n\n#[derive(Clone)]\npub struct Token {\n    pub ttype: TokenType,\n    /// Holds `length` bytes followed by a `0` terminator byte (mirrors C `char value[MAX_TOKEN_LENGTH]`).\n    pub value: Vec<u8>,\n    pub length: usize,\n    pub line: i32,\n    pub column: i32,\n}\n\n#[derive(Clone, Copy)]\npub struct TokenizerOps {\n    pub next_token: fn() -> Token,\n    pub peek_token: fn() -> Token,\n    pub reset: fn(),\n    pub load_text: fn(&[u8]) -> i32,\n    pub get_stats: fn() -> (usize, usize, usize),\n}\n\nstruct State {\n    input_buffer: Vec<u8>,\n    buffer_length: usize,\n    current_position: usize,\n    current_line: i32,\n    current_column: i32,\n    total_tokens_processed: usize,\n    total_lines_processed: usize,\n    total_chars_processed: usize,\n    lookahead_token: Option<Token>,\n    lookahead_valid: bool,\n}\n\nimpl State {\n    fn new() -> Self {\n        State {\n            input_buffer: vec![0u8; MAX_BUFFER_SIZE],\n            buffer_length: 0,\n            current_position: 0,\n            current_line: 1,\n            current_column: 1,\n            total_tokens_processed: 0,\n            total_lines_processed: 0,\n            total_chars_processed: 0,\n            lookahead_token: None,\n            lookahead_valid: false,\n        }\n    }\n}\n\nthread_local! {\n    static STATE: RefCell<State> = RefCell::new(State::new());\n}\n\nconst KEYWORDS: &[&[u8]] = &[\n    b\"if\", b\"else\", b\"while\", b\"for\", b\"return\", b\"int\", b\"char\",\n    b\"float\", b\"double\", b\"void\", b\"struct\", b\"typedef\", b\"const\",\n    b\"static\", b\"extern\", b\"auto\", b\"register\", b\"sizeof\", b\"break\",\n    b\"continue\", b\"switch\", b\"case\", b\"default\", b\"do\", b\"goto\",\n    b\"enum\", b\"union\", b\"signed\", b\"unsigned\", b\"long\", b\"short\",\n];\n\nfn is_keyword(s: &[u8]) -> bool {\n    KEYWORDS.iter().any(|k| *k == s)\n}\n\n// C isspace() returns nonzero for ' ', '\\t', '\\n', '\\v', '\\f', '\\r'.\n// skip_whitespace excludes '\\n', so this set is the rest.\nfn is_skippable_ws(c: u8) -> bool {\n    matches!(c, b' ' | b'\\t' | 0x0B | 0x0C | b'\\r')\n}\n\nfn is_alpha(c: u8) -> bool {\n    (b'a'..=b'z').contains(&c) || (b'A'..=b'Z').contains(&c)\n}\n\nfn is_digit(c: u8) -> bool {\n    (b'0'..=b'9').contains(&c)\n}\n\nfn is_alnum(c: u8) -> bool {\n    is_alpha(c) || is_digit(c)\n}\n\nfn peek_char(s: &State) -> u8 {\n    if s.current_position >= s.buffer_length {\n        0\n    } else {\n        s.input_buffer[s.current_position]\n    }\n}\n\nfn advance_char(s: &mut State) -> u8 {\n    if s.current_position >= s.buffer_length {\n        return 0;\n    }\n    let c = s.input_buffer[s.current_position];\n    s.current_position += 1;\n    s.total_chars_processed += 1;\n    if c == b'\\n' {\n        s.current_line += 1;\n        s.current_column = 1;\n        s.total_lines_processed += 1;\n    } else {\n        s.current_column += 1;\n    }\n    c\n}\n\nfn skip_whitespace(s: &mut State) {\n    loop {\n        let c = peek_char(s);\n        if c != 0 && is_skippable_ws(c) && c != b'\\n' {\n            advance_char(s);\n        } else {\n            break;\n        }\n    }\n}\n\nfn create_token(s: &mut State, ttype: TokenType, value: &[u8]) -> Token {\n    let length = if value.len() < MAX_TOKEN_LENGTH {\n        value.len()\n    } else {\n        MAX_TOKEN_LENGTH - 1\n    };\n    let mut buf = vec![0u8; length + 1];\n    buf[..length].copy_from_slice(&value[..length]);\n    // Mirror C: token.column = current_column - token.length (with C's signed/unsigned mixing).\n    let column = (s.current_column).wrapping_sub(length as i32);\n    s.total_tokens_processed += 1;\n    Token {\n        ttype,\n        value: buf,\n        length,\n        line: s.current_line,\n        column,\n    }\n}\n\nfn scan_word(s: &mut State) -> Token {\n    let mut buffer = [0u8; MAX_TOKEN_LENGTH];\n    let mut length: usize = 0;\n    while peek_char(s) != 0\n        && (is_alnum(peek_char(s)) || peek_char(s) == b'_')\n        && length < MAX_TOKEN_LENGTH - 1\n    {\n        buffer[length] = advance_char(s);\n        length += 1;\n    }\n    let val = &buffer[..length];\n    if is_keyword(val) {\n        create_token(s, TokenType::Keyword, val)\n    } else {\n        create_token(s, TokenType::Identifier, val)\n    }\n}\n\nfn scan_number(s: &mut State) -> Token {\n    let mut buffer = [0u8; MAX_TOKEN_LENGTH];\n    let mut length: usize = 0;\n    let mut has_decimal = false;\n    while peek_char(s) != 0\n        && (is_digit(peek_char(s)) || peek_char(s) == b'.')\n        && length < MAX_TOKEN_LENGTH - 1\n    {\n        if peek_char(s) == b'.' {\n            if has_decimal {\n                break;\n            }\n            has_decimal = true;\n        }\n        buffer[length] = advance_char(s);\n        length += 1;\n    }\n    create_token(s, TokenType::Number, &buffer[..length])\n}\n\nfn scan_string(s: &mut State) -> Token {\n    let mut buffer = [0u8; MAX_TOKEN_LENGTH];\n    let mut length: usize = 0;\n    let quote = advance_char(s);\n    buffer[length] = quote;\n    length += 1;\n    while peek_char(s) != 0\n        && peek_char(s) != quote\n        && peek_char(s) != b'\\n'\n        && length < MAX_TOKEN_LENGTH - 2\n    {\n        if peek_char(s) == b'\\\\' {\n            buffer[length] = advance_char(s);\n            length += 1;\n            if peek_char(s) != 0 {\n                buffer[length] = advance_char(s);\n                length += 1;\n            }\n        } else {\n            buffer[length] = advance_char(s);\n            length += 1;\n        }\n    }\n    if peek_char(s) == quote {\n        buffer[length] = advance_char(s);\n        length += 1;\n    }\n    create_token(s, TokenType::String, &buffer[..length])\n}\n\nfn scan_comment(s: &mut State) -> Token {\n    let mut buffer = [0u8; MAX_TOKEN_LENGTH];\n    let mut length: usize = 0;\n    // First '/' (already determined to be '/')\n    buffer[length] = advance_char(s);\n    length += 1;\n    if peek_char(s) == b'/' {\n        // Single-line comment\n        buffer[length] = advance_char(s);\n        length += 1;\n        while peek_char(s) != 0\n            && peek_char(s) != b'\\n'\n            && length < MAX_TOKEN_LENGTH - 1\n        {\n            buffer[length] = advance_char(s);\n            length += 1;\n        }\n    } else if peek_char(s) == b'*' {\n        // Multi-line comment\n        buffer[length] = advance_char(s);\n        length += 1;\n        while peek_char(s) != 0 && length < MAX_TOKEN_LENGTH - 2 {\n            if peek_char(s) == b'*' {\n                buffer[length] = advance_char(s);\n                length += 1;\n                if peek_char(s) == b'/' {\n                    buffer[length] = advance_char(s);\n                    length += 1;\n                    break;\n                }\n            } else {\n                buffer[length] = advance_char(s);\n                length += 1;\n            }\n        }\n    }\n    create_token(s, TokenType::Comment, &buffer[..length])\n}\n\nfn scan_operator(s: &mut State) -> Token {\n    let mut buffer = [0u8; MAX_TOKEN_LENGTH];\n    let mut length: usize = 0;\n    let c = peek_char(s);\n    buffer[length] = advance_char(s);\n    length += 1;\n    let next = peek_char(s);\n    let two_char = matches!(\n        (c, next),\n        (b'=', b'=')\n            | (b'!', b'=')\n            | (b'<', b'=')\n            | (b'>', b'=')\n            | (b'&', b'&')\n            | (b'|', b'|')\n            | (b'+', b'+')\n            | (b'-', b'-')\n            | (b'-', b'>')\n            | (b'<', b'<')\n            | (b'>', b'>')\n    );\n    if two_char {\n        buffer[length] = advance_char(s);\n        length += 1;\n    }\n    create_token(s, TokenType::Operator, &buffer[..length])\n}\n\nfn next_token_impl(s: &mut State) -> Token {\n    if s.lookahead_valid {\n        s.lookahead_valid = false;\n        return s.lookahead_token.take().unwrap();\n    }\n\n    skip_whitespace(s);\n\n    if s.current_position >= s.buffer_length {\n        return create_token(s, TokenType::Eof, b\"\");\n    }\n\n    let c = peek_char(s);\n\n    // Newline\n    if c == b'\\n' {\n        let nl = [advance_char(s)];\n        return create_token(s, TokenType::Newline, &nl);\n    }\n\n    // Identifier or keyword\n    if is_alpha(c) || c == b'_' {\n        return scan_word(s);\n    }\n\n    // Number\n    if is_digit(c) {\n        return scan_number(s);\n    }\n\n    // String\n    if c == b'\"' || c == b'\\'' {\n        return scan_string(s);\n    }\n\n    // Comment (preserving the C behavior: peek_char() == c after only peeking,\n    // so any '/' triggers scan_comment).\n    if c == b'/' && (peek_char(s) == b'/' || peek_char(s) == b'*') {\n        return scan_comment(s);\n    }\n\n    // Operator\n    if b\"+-*/%=<>!&|^~?:\".contains(&c) {\n        return scan_operator(s);\n    }\n\n    // Punctuation\n    if b\"(){}[];,.\".contains(&c) {\n        let p = [advance_char(s)];\n        return create_token(s, TokenType::Punctuation, &p);\n    }\n\n    // Unknown character\n    let u = [advance_char(s)];\n    create_token(s, TokenType::Error, &u)\n}\n\npub fn tokenizer_next_token() -> Token {\n    STATE.with(|st| {\n        let mut s = st.borrow_mut();\n        next_token_impl(&mut s)\n    })\n}\n\npub fn tokenizer_peek_token() -> Token {\n    STATE.with(|st| {\n        let mut s = st.borrow_mut();\n        if !s.lookahead_valid {\n            let t = next_token_impl(&mut s);\n            s.lookahead_token = Some(t);\n            s.lookahead_valid = true;\n        }\n        s.lookahead_token.clone().unwrap()\n    })\n}\n\npub fn tokenizer_reset() {\n    STATE.with(|st| {\n        let mut s = st.borrow_mut();\n        s.current_position = 0;\n        s.current_line = 1;\n        s.current_column = 1;\n        s.lookahead_valid = false;\n        s.lookahead_token = None;\n        // total statistics intentionally not reset\n    });\n}\n\npub fn tokenizer_load_text(text: &[u8]) -> i32 {\n    let length = text.len();\n    if length >= MAX_BUFFER_SIZE {\n        eprintln!(\"Error: Input text too large\");\n        return -1;\n    }\n    STATE.with(|st| {\n        let mut s = st.borrow_mut();\n        // strncpy semantics; we only care about the first `length` bytes anyway.\n        for i in 0..length {\n            s.input_buffer[i] = text[i];\n        }\n        s.input_buffer[MAX_BUFFER_SIZE - 1] = 0;\n        s.buffer_length = length;\n        // Inline reset (avoid borrowing twice).\n        s.current_position = 0;\n        s.current_line = 1;\n        s.current_column = 1;\n        s.lookahead_valid = false;\n        s.lookahead_token = None;\n    });\n    0\n}\n\npub fn tokenizer_get_stats() -> (usize, usize, usize) {\n    STATE.with(|st| {\n        let s = st.borrow();\n        (\n            s.total_lines_processed,\n            s.total_tokens_processed,\n            s.total_chars_processed,\n        )\n    })\n}\n\npub fn get_tokenizer_ops() -> TokenizerOps {\n    TokenizerOps {\n        next_token: tokenizer_next_token,\n        peek_token: tokenizer_peek_token,\n        reset: tokenizer_reset,\n        load_text: tokenizer_load_text,\n        get_stats: tokenizer_get_stats,\n    }\n}\n","numLines":431,"startLine":1,"totalLines":431}}}
