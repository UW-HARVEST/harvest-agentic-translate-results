extern \"C\" fn(*mut MemoryBlock)> =","-            r.get(b\"free_block\").unwrap();","+        let r_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> = r.get(b\"free_block\").unwrap();"," ","         let cases: &[(usize, c_int)] = &[","             (5, 0),"]},{"oldStart":160,"oldLines":13,"newStart":243,"newLines":12,"lines":["         for &(count, init) in cases {","             let cb = c_alloc(count, init);","             let rb = r_alloc(count, init);","-            assert!(!cb.is_null(), \"C allocate_block returned null for {} {}\", count, init);","-            assert!(!rb.is_null(), \"Rust allocate_block returned null for {} {}\", count, init);","+            assert!(!cb.is_null(), \"C allocate_block null\");","+            assert!(!rb.is_null(), \"Rust allocate_block null\");"," ","-            assert_eq!((*cb).size, count, \"C size\");","-            assert_eq!((*rb).size, count, \"Rust size\");","+            assert_eq!((*cb).size, count);","+            assert_eq!((*rb).size, count);"," ","-            // Compare the data values element-by-element","             for i in 0..count {","                 let cv = *((*cb).data.add(i));","                 let rv = *((*rb).data.add(i));"]},{"oldStart":181,"oldLines":32,"newStart":263,"newLines":27,"lines":[" "," #[test]"," fn test_compute_hash_self() {","-    // compute_hash with the same pointer should yield 0","-    // (both pointer comparisons are equal so neither branch fires)","-    let (c, r) = load_libs();","     unsafe {","+        let c = Library::new(c_so_path()).unwrap();","+        let r = Library::new(rust_so_path()).unwrap();","         let c_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =","             c.get(b\"allocate_block\").unwrap();","-        let c_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =","-            c.get(b\"free_block\").unwrap();","+        let c_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> = c.get(b\"free_block\").unwrap();",