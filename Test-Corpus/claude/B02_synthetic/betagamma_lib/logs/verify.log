{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_iyfpbxlvcv52vxn5ubz25mx75hvg4aqveqzjwpd6lg5vuyx4eufq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_018V9eUFuKHoPWsRSASwi8tH","name":"Write","input":{"file_path":"/tmp/harvest-work-59kz7g/translated_rust/tests/ffi_compare.rs","content":"// Integration tests that compare C and Rust shared libraries via libloading.\n\nuse libloading::{Library, Symbol};\nuse std::os::raw::{c_char, c_int};\nuse std::path::PathBuf;\n\n#[repr(C)]\n#[derive(Clone, Copy)]\nstruct DataBlock {\n    id: c_int,\n    name: [u8; 32],\n    flags: u8,\n}\n\n#[repr(C)]\nstruct MemoryBlock {\n    data: *mut c_int,\n    size: usize,\n}\n\nfn c_so_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nfn rust_so_path() -> PathBuf {\n    // The integration test runs after `cargo build`; the dylib is in target/<profile>\n    // We try both debug and release to be safe.\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    let release = p.join(\"release\").join(\"libbetagamma_lib.so\");\n    let debug = p.join(\"debug\").join(\"libbetagamma_lib.so\");\n    if release.exists() {\n        release\n    } else {\n        debug\n    }\n}\n\nfn load_libs() -> (Library, Library) {\n    unsafe {\n        let c = Library::new(c_so_path()).expect(\"Could not load C .so\");\n        let r = Library::new(rust_so_path()).expect(\"Could not load Rust .so\");\n        (c, r)\n    }\n}\n\n#[test]\nfn test_betagamma_matches() {\n    let (c, r) = load_libs();\n    unsafe {\n        let cfn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =\n            c.get(b\"betagamma\").unwrap();\n        let rfn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =\n            r.get(b\"betagamma\").unwrap();\n\n        let inputs: &[(c_int, c_int, c_int, c_int)] = &[\n            (1, 2, 3, 4),\n            (0, 0, 0, 0),\n            (10, 20, 30, 40),\n            (-1, -2, -3, -4),\n            (100, 200, 300, 400),\n            (5, 7, 11, 13),\n            (1000, -1000, 999, -999),\n            (123456, 654321, 1, 2),\n            (7, 0, 0, 0),\n            (9, 8, 7, 6),\n        ];\n\n        for &(a, b, cc, d) in inputs {\n            let cv = cfn(a, b, cc, d);\n            let rv = rfn(a, b, cc, d);\n            assert_eq!(\n                cv, rv,\n                \"betagamma({}, {}, {}, {}) C={} R={}\",\n                a, b, cc, d, cv, rv\n            );\n        }\n    }\n}\n\n#[test]\nfn test_create_block_matches() {\n    let (c, r) = load_libs();\n    unsafe {\n        let cfn: Symbol<unsafe extern \"C\" fn(c_int, *const c_char, u8) -> DataBlock> =\n            c.get(b\"create_block\").unwrap();\n        let rfn: Symbol<unsafe extern \"C\" fn(c_int, *const c_char, u8) -> DataBlock> =\n            r.get(b\"create_block\").unwrap();\n\n        let cases: &[(c_int, &[u8], u8)] = &[\n            (1, b\"Hello\\0\", 0xAA),\n            (0, b\"\\0\", 0x00),\n            (42, b\"ABC\\0\", 0xFF),\n            (-7, b\"Test_String_Foo\\0\", 0x55),\n            (1000, b\"Block_Alpha\\0\", 0b10101010),\n        ];\n\n        for (id, name, flags) in cases {\n            let cv = cfn(*id, name.as_ptr() as *const c_char, *flags);\n            let rv = rfn(*id, name.as_ptr() as *const c_char, *flags);\n            assert_eq!(cv.id, rv.id, \"id mismatch for {:?}\", name);\n            assert_eq!(cv.flags, rv.flags, \"flags mismatch for {:?}\", name);\n            assert_eq!(\n                &cv.name[..],\n                &rv.name[..],\n                \"name mismatch for {:?}\",\n                name\n            );\n        }\n    }\n}\n\n#[test]\nfn test_allocate_and_free_block() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =\n            c.get(b\"allocate_block\").unwrap();\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =\n            c.get(b\"free_block\").unwrap();\n        let r_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =\n            r.get(b\"allocate_block\").unwrap();\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =\n            r.get(b\"free_block\").unwrap();\n\n        let cases: &[(usize, c_int)] = &[\n            (5, 0),\n            (10, 100),\n            (1, -1),\n            (8, -50),\n            (16, 1234),\n            (3, i32::MAX - 1),\n            (4, i32::MIN + 1),\n        ];\n\n        for &(count, init) in cases {\n            let cb = c_alloc(count, init);\n            let rb = r_alloc(count, init);\n            assert!(!cb.is_null(), \"C allocate_block returned null for {} {}\", count, init);\n            assert!(!rb.is_null(), \"Rust allocate_block returned null for {} {}\", count, init);\n\n            assert_eq!((*cb).size, count, \"C size\");\n            assert_eq!((*rb).size, count, \"Rust size\");\n\n            // Compare the data values element-by-element\n            for i in 0..count {\n                let cv = *((*cb).data.add(i));\n                let rv = *((*rb).data.add(i));\n                assert_eq!(cv, rv, \"data[{}] differs for count={} init={}\", i, count, init);\n            }\n\n            c_free(cb);\n            r_free(rb);\n        }\n    }\n}\n\n#[test]\nfn test_compute_hash_self() {\n    // compute_hash with the same pointer should yield 0\n    // (both pointer comparisons are equal so neither branch fires)\n    let (c, r) = load_libs();\n    unsafe {\n        let c_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =\n            c.get(b\"allocate_block\").unwrap();\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =\n            c.get(b\"free_block\").unwrap();\n        let c_hash: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock, *mut MemoryBlock) -> c_int> =\n            c.get(b\"compute_hash\").unwrap();\n        let r_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =\n            r.get(b\"allocate_block\").unwrap();\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =\n            r.get(b\"free_block\").unwrap();\n        let r_hash: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock, *mut MemoryBlock) -> c_int> =\n            r.get(b\"compute_hash\").unwrap();\n\n        let cb = c_alloc(5, 10);\n        let rb = r_alloc(5, 10);\n\n        // Self comparison: both equal, should be 0 in both\n        let ch = c_hash(cb, cb);\n        let rh = r_hash(rb, rb);\n        assert_eq!(ch, 0, \"C compute_hash(p,p) should be 0\");\n        assert_eq!(rh, 0, \"Rust compute_hash(p,p) should be 0\");\n        assert_eq!(ch, rh);\n\n        c_free(cb);\n        r_free(rb);\n    }\n}\n\n#[test]\nfn test_compute_hash_two_blocks() {\n    // Allocate two blocks within the same library, and verify that the hash\n    // returned has a sensible \"non-zero\" structure.\n    // Since C and Rust use possibly different heap layouts, we don't compare\n    // exact hash values across libraries — but each library should be\n    // self-consistent and yield 110, 220, 120, 210, etc., consistent with\n    // pointer ordering.\n    let (c, r) = load_libs();\n    unsafe {\n        let c_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =\n            c.get(b\"allocate_block\").unwrap();\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =\n            c.get(b\"free_block\").unwrap();\n        let c_hash: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock, *mut MemoryBlock) -> c_int> =\n            c.get(b\"compute_hash\").unwrap();\n        let r_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =\n            r.get(b\"allocate_block\").unwrap();\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =\n            r.get(b\"free_block\").unwrap();\n        let r_hash: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock, *mut MemoryBlock) -> c_int> =\n            r.get(b\"compute_hash\").unwrap();\n\n        let c1 = c_alloc(5, 10);\n        let c2 = c_alloc(5, 20);\n        let r1 = r_alloc(5, 10);\n        let r2 = r_alloc(5, 20);\n\n        let ch12 = c_hash(c1, c2);\n        let ch21 = c_hash(c2, c1);\n        let rh12 = r_hash(r1, r2);\n        let rh21 = r_hash(r2, r1);\n\n        // Property: hash(a,b) + hash(b,a) should be 100+200+10+20 = 330 if a != b\n        // (one direction yields 100/10 contributions, the other yields 200/20).\n        assert_eq!(ch12 + ch21, 330, \"C hash sum should be 330\");\n        assert_eq!(rh12 + rh21, 330, \"Rust hash sum should be 330\");\n\n        c_free(c1);\n        c_free(c2);\n        r_free(r1);\n        r_free(r2);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":141,"cache_read_input_tokens":27541,"cache_creation":{"ephemeral_5m_input_tokens":141,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e8c188cb-59a6-4979-b120-22ece3da3034","uuid":"f15f6e97-998f-4167-9915-5d730a604412"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018V9eUFuKHoPWsRSASwi8tH","type":"tool_result","content":"File created successfully at: /tmp/harvest-work-59kz7g/translated_rust/tests/ffi_compare.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"e8c188cb-59a6-4979-b120-22ece3da3034","uuid":"fbe70f8f-f3e5-406a-a12b-14b5665d2b52","timestamp":"2026-05-27T20:17:32.207Z","tool_use_result":{"type":"create","filePath":"/tmp/harvest-work-59kz7g/translated_rust/tests/ffi_compare.rs","content":"// Integration tests that compare C and Rust shared libraries via libloading.\n\nuse libloading::{Library, Symbol};\nuse std::os::raw::{c_char, c_int};\nuse std::path::PathBuf;\n\n#[repr(C)]\n#[derive(Clone, Copy)]\nstruct DataBlock {\n    id: c_int,\n    name: [u8; 32],\n    flags: u8,\n}\n\n#[repr(C)]\nstruct MemoryBlock {\n    data: *mut c_int,\n    size: usize,\n}\n\nfn c_so_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nfn rust_so_path() -> PathBuf {\n    // The integration test runs after `cargo build`; the dylib is in target/<profile>\n    // We try both debug and release to be safe.\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    let release = p.join(\"release\").join(\"libbetagamma_lib.so\");\n    let debug = p.join(\"debug\").join(\"libbetagamma_lib.so\");\n    if release.exists() {\n        release\n    } else {\n        debug\n    }\n}\n\nfn load_libs() -> (Library, Library) {\n    unsafe {\n        let c = Library::new(c_so_path()).expect(\"Could not load C .so\");\n        let r = Library::new(rust_so_path()).expect(\"Could not load Rust .so\");\n        (c, r)\n    }\n}\n\n#[test]\nfn test_betagamma_matches() {\n    let (c, r) = load_libs();\n    unsafe {\n        let cfn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =\n            c.get(b\"betagamma\").unwrap();\n        let rfn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =\n            r.get(b\"betagamma\").unwrap();\n\n        let inputs: &[(c_int, c_int, c_int, c_int)] = &[\n            (1, 2, 3, 4),\n            (0, 0, 0, 0),\n            (10, 20, 30, 40),\n            (-1, -2, -3, -4),\n            (100, 200, 300, 400),\n            (5, 7, 11, 13),\n            (1000, -1000, 999, -999),\n            (123456, 654321, 1, 2),\n            (7, 0, 0, 0),\n            (9, 8, 7, 6),\n        ];\n\n        for &(a, b, cc, d) in inputs {\n            let cv = cfn(a, b, cc, d);\n            let rv = rfn(a, b, cc, d);\n            assert_eq!(\n                cv, rv,\n                \"betagamma({}, {}, {}, {}) C={} R={}\",\n                a, b, cc, d, cv, rv\n            );\n        }\n    }\n}\n\n#[test]\nfn test_create_block_matches() {\n    let (c, r) = load_libs();\n    unsafe {\n        let cfn: Symbol<unsafe extern \"C\" fn(c_int, *const c_char, u8) -> DataBlock> =\n            c.get(b\"create_block\").unwrap();\n        let rfn: Symbol<unsafe extern \"C\" fn(c_int, *const c_char, u8) -> DataBlock> =\n            r.get(b\"create_block\").unwrap();\n\n        let cases: &[(c_int, &[u8], u8)] = &[\n            (1, b\"Hello\\0\", 0xAA),\n            (0, b\"\\0\", 0x00),\n            (42, b\"ABC\\0\", 0xFF),\n            (-7, b\"Test_String_Foo\\0\", 0x55),\n            (1000, b\"Block_Alpha\\0\", 0b10101010),\n        ];\n\n        for (id, name, flags) in cases {\n            let cv = cfn(*id, name.as_ptr() as *const c_char, *flags);\n            let rv = rfn(*id, name.as_ptr() as *const c_char, *flags);\n            assert_eq!(cv.id, rv.id, \"id mismatch for {:?}\", name);\n            assert_eq!(cv.flags, rv.flags, \"flags mismatch for {:?}\", name);\n            assert_eq!(\n                &cv.name[..],\n                &rv.name[..],\n                \"name mismatch for {:?}\",\n                name\n            );\n        }\n    }\n}\n\n#[test]\nfn test_allocate_and_free_block() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =\n            c.get(b\"allocate_block\").unwrap();\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =\n            c.get(b\"free_block\").unwrap();\n        let r_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =\n            r.get(b\"allocate_block\").unwrap();\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =\n            r.get(b\"free_block\").unwrap();\n\n        let cases: &[(usize, c_int)] = &[\n            (5, 0),\n            (10, 100),\n            (1, -1),\n            (8, -50),\n            (16, 1234),\n            (3, i32::MAX - 1),\n            (4, i32::MIN + 1),\n        ];\n\n        for &(count, init) in cases {\n            let cb = c_alloc(count, init);\n            let rb = r_alloc(count, init);\n            assert!(!cb.is_null(), \"C allocate_block returned null for {} {}\", count, init);\n            assert!(!rb.is_null(), \"Rust allocate_block returned null for {} {}\", count, init);\n\n            assert_eq!((*cb).size, count, \"C size\");\n            assert_eq!((*rb).size, count, \"Rust size\");\n\n            // Compare the data values element-by-element\n            for i in 0..count {\n                let cv = *((*cb).data.add(i));\n                let rv = *((*rb).data.add(i));\n                assert_eq!(cv, rv, \"data[{}] differs for count={} init={}\", i, count, init);\n            }\n\n            c_free(cb);\n            r_free(rb);\n        }\n    }\n}\n\n#[test]\nfn test_compute_hash_self() {\n    // compute_hash with the same pointer should yield 0\n    // (both pointer comparisons are equal so neither branch fires)\n    let (c, r) = load_libs();\n    unsafe {\n        let c_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =\n            c.get(b\"allocate_block\").unwrap();\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =\n            c.get(b\"free_block\").unwrap();\n        let c_hash: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock, *mut MemoryBlock) -> c_int> =\n            c.get(b\"compute_hash\").unwrap();\n        let r_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =\n            r.get(b\"allocate_block\").unwrap();\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =\n            r.get(b\"free_block\").unwrap();\n        let r_hash: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock, *mut MemoryBlock) -> c_int> =\n            r.get(b\"compute_hash\").unwrap();\n\n        let cb = c_alloc(5, 10);\n        let rb = r_alloc(5, 10);\n\n        // Self comparison: both equal, should be 0 in both\n        let ch = c_hash(cb, cb);\n        let rh = r_hash(rb, rb);\n        assert_eq!(ch, 0, \"C compute_hash(p,p) should be 0\");\n        assert_eq!(rh, 0, \"Rust compute_hash(p,p) should be 0\");\n        assert_eq!(ch, rh);\n\n        c_free(cb);\n        r_free(rb);\n    }\n}\n\n#[test]\nfn test_compute_hash_two_blocks() {\n    // Allocate two blocks within the same library, and verify that the hash\n    // returned has a sensible \"non-zero\" structure.\n    // Since C and Rust use possibly different heap layouts, we don't compare\n    // exact hash values across libraries — but each library should be\n    // self-consistent and yield 110, 220, 120, 210, etc., consistent with\n    // pointer ordering.\n    let (c, r) = load_libs();\n    unsafe {\n        let c_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =\n            c.get(b\"allocate_block\").unwrap();\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =\n            c.get(b\"free_block\").unwrap();\n        let c_hash: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock, *mut MemoryBlock) -> c_int> =\n            c.get(b\"compute_hash\").unwrap();\n        let r_alloc: Symbol<unsafe extern \"C\" fn(usize, c_int) -> *mut MemoryBlock> =\n            r.get(b\"allocate_block\").unwrap();\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock)> =\n            r.get(b\"free_block\").unwrap();\n        let r_hash: Symbol<unsafe extern \"C\" fn(*mut MemoryBlock, *mut MemoryBlock) -> c_int> =\n            r.get(b\"compute_hash\").unwrap();\n\n        let c1 = c_alloc(5, 10);\n        let c2 = c_alloc(5, 20);\n        let r1 = r_alloc(5, 10);\n        let r2 = r_alloc(5, 20);\n\n        let ch12 = c_hash(c1, c2);\n        let ch21 = c_hash(c2, c1);\n        let rh12 = r_hash(r1, r2);\n        let rh21 = r_hash(r2, r1);\n\n        // Property: hash(a,b) + hash(b,a) should be 100+200+10+20 = 330 if a != b\n        // (one direction yields 100/10 contributions, the other yields 200/20).\n        assert_eq!(ch12 + ch21, 330, \"C hash sum should be 330\");\n        assert_eq!(rh12 + rh21, 330, \"Rust hash sum should be 330\");\n\n        c_free(c1);\n        c_free(c2);\n        r_free(r1);\n        r_free(r2);\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
