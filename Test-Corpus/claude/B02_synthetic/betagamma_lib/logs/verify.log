vec![0u8; len];","+    if len > 0 {","+        file.read_exact(&mut buf).expect(\"read body\");","+    }","+    // Reap child.","+    let mut status: c_int = 0;","+    unsafe { libc::waitpid(pid, &mut status, 0) };","+    let _ = file.into_raw_fd(); // (already closed when File drops)","+    buf","+}","+","+fn run_betagamma(so: &PathBuf, a: c_int, b: c_int, cc: c_int, d: c_int) -> c_int {","+    let so = so.clone();","+    let bytes = run_in_fork(move || {","+        unsafe {","+            let lib = Library::new(&so).expect(\"load\");","+            let f: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =","+                lib.get(b\"betagamma\").unwrap();","+            let v = f(a, b, cc, d);","+            v.to_le_bytes().to_vec()","+        }","+    });","+    let mut arr = [0u8; 4];","+    arr.copy_from_slice(&bytes[..4]);","+    c_int::from_le_bytes(arr)","+}","+"," #[test]"," fn test_betagamma_matches() {","-    let (c, r) = load_libs();","-    unsafe {","-        let cfn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =","-            c.get(b\"betagamma\").unwrap();","-        let rfn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =","-            r.get(b\"betagamma\").unwrap();","+    let c = c_so_path();","+    let r = rust_so_path();"," ","-        let inputs: &[(c_int, c_int, c_int, c_int)] = &[","-            (1, 2, 3, 4),","-            (0, 0, 0, 0),","-            (10, 20, 30, 40),","-            (-1, -2, -3, -4),","-            (100, 200, 300, 400),","-            (5, 7, 11, 13),","-            (1000, -1000, 999, -999),","-            (123456, 654321, 1, 2),","-            (7, 0, 0, 0),","-            (9, 8, 7, 6),","-        ];","+    let inputs: &[(c_int, c_int, c_int, c_int)] = &[","+        (1, 2, 3, 4),","+        (0, 0, 0, 0),","+        (10, 20, 30, 40),","+        (-1, -2, -3, -4),","+        (100, 200, 300, 400),","+        (5, 7, 11, 13),","+        (1000, -1000, 999, -999),",