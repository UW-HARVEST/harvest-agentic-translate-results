nt node_count;\n54\t};\n55\t\n56\t\n57\t// Create a new empty graph\n58\tgraph_t* create_graph(void);\n59\t\n60\t// Add a node to the graph (returns pointer to node)\n61\tnode_t* add_node(graph_t *graph, const char *city_name);\n62\t\n63\t// Add an edge between two nodes with a given distance\n64\tint add_edge(node_t *from, node_t *to, int distance);\n65\t\n66\t// Delete a node (decrements ref count, frees if 0)\n67\tvoid delete_node(node_t *node);\n68\t\n69\t// Create shallow copy of subsection starting from node (increments ref counts)\n70\tnode_t* shallow_copy(node_t *start);\n71\t\n72\t// Find shortest path between two nodes (returns array of nodes, NULL if no path)\n73\tnode_t** find_shortest_path(node_t *start, node_t *end, int *path_length);\n74\t\n75\t// Free the entire graph\n76\tvoid free_graph(graph_t *graph);\n77\t\n78\t// Get node by city name\n79\tnode_t* get_node_by_name(graph_t *graph, const char *city_name);\n80\t\n81\t// Print node information (for debugging)\n82\tvoid print_node(node_t *node);\n83\t\n84\t// Print entire graph\n85\tvoid print_graph(graph_t *graph);\n86\t\n87\t#endif // DAG_LIB_H\n88\t"}]},"parent_tool_use_id":null,"session_id":"fa0f5091-9748-474b-8214-88aa96da5787","uuid":"724e5d55-7445-4f7c-8803-b2174dbba105","timestamp":"2026-05-28T14:12:16.681Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-translate-tCA9lA/translated_rust/c_src/include/dag_lib.h","content":"/*\n * Copyright 2025 MIT Lincoln Laboratory\n * Permission is hereby granted, free of charge,\n * to any person obtaining a copy of this software\n * and associated documentation files (the \"Software\"),\n * to deal in the Software without restriction,\n * including without limitation the rights to use, copy,\n * modify, merge, publish, distribute, sublicense,\n * and/or sell copies of the Software,\n * and to permit persons to whom the Software is furnished to do so,\n * subject to the following conditions:\n * \n * The above copyright notice and this 