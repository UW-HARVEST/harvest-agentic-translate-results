tf(\"Choice: \");\n44\t}\n45\t\n46\tint main(void) {\n47\t    graph_t *graph = create_graph();\n48\t    if (!graph) {\n49\t        fprintf(stderr, \"Failed to create graph\\n\");\n50\t        return 1;\n51\t    }\n52\t    \n53\t    char input[MAX_INPUT];\n54\t    int choice;\n55\t    \n56\t    printf(\"City Route Management System\\n\");\n57\t    printf(\"Commands are read from stdin\\n\");\n58\t    \n59\t    while (1) {\n60\t        print_menu();\n61\t        \n62\t        if (fgets(input, MAX_INPUT, stdin) == NULL) {\n63\t            break;\n64\t        }\n65\t        \n66\t        if (sscanf(input, \"%d\", &choice) != 1) {\n67\t            printf(\"Invalid input\\n\");\n68\t            continue;\n69\t        }\n70\t        \n71\t        switch (choice) {\n72\t            case 1: {\n73\t                // Add city\n74\t                printf(\"Enter city name: \");\n75\t                if (fgets(input, MAX_INPUT, stdin) == NULL) {\n76\t                    break;\n77\t                }\n78\t                \n79\t                // Remove newline\n80\t                input[strcspn(input, \"\\n\")] = 0;\n81\t                \n82\t                node_t *node = add_node(graph, input);\n83\t                if (node) {\n84\t                    printf(\"Added city: %s\\n\", input);\n85\t                } else {\n86\t                    printf(\"Failed to add city\\n\");\n87\t                }\n88\t                break;\n89\t            }\n90\t            \n91\t            case 2: {\n92\t                // Add route\n93\t                char from_city[MAX_INPUT], to_city[MAX_INPUT];\n94\t                int distance;\n95\t                \n96\t                printf(\"Enter from city: \");\n97\t                if (fgets(from_city, MAX_INPUT, stdin) == NULL) {\n98\t                    break;\n99\t                }\n100\t                from_city[strcspn(from_city, \"\\n\")] = 0;\n101\t                \n102\t                printf(\"Enter to city: \");\n103\t              