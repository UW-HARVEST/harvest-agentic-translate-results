stdin: io::Stdin,\n    buf: Vec<u8>,\n    pos: usize,\n    eof: bool,\n}\n\nimpl StdinReader {\n    fn new() -> Self {\n        StdinReader {\n            stdin: io::stdin(),\n            buf: Vec::new(),\n            pos: 0,\n            eof: false,\n        }\n    }\n\n    fn read_byte(&mut self) -> Option<u8> {\n        if self.eof {\n            return None;\n        }\n        if self.pos >= self.buf.len() {\n            self.buf.clear();\n            self.pos = 0;\n            let mut chunk = [0u8; 4096];\n            match self.stdin.read(&mut chunk) {\n                Ok(0) => {\n                    self.eof = true;\n                    return None;\n                }\n                Ok(n) => self.buf.extend_from_slice(&chunk[..n]),\n                Err(_) => {\n                    self.eof = true;\n                    return None;\n                }\n            }\n        }\n        let b = self.buf[self.pos];\n        self.pos += 1;\n        Some(b)\n    }\n\n    /// Read up to `max_len-1` bytes or to a newline, then NUL-terminate.\n    /// Returns Some(buf with trailing NUL) or None on EOF with no data.\n    fn fgets(&mut self, max_len: usize) -> Option<Vec<u8>> {\n        if max_len == 0 {\n            return Some(Vec::new());\n        }\n        let cap = max_len - 1;\n        let mut out: Vec<u8> = Vec::new();\n        let mut got_any = false;\n        while out.len() < cap {\n            match self.read_byte() {\n                Some(b) => {\n                    got_any = true;\n                    out.push(b);\n                    if b == b'\\n' {\n                        break;\n                    }\n                }\n                None => {\n                    if !got_any {\n                        return None;\n                    }\n                    break;\n                }\n            }\n        }\n        out.push(0);\n        Some(out)\n    }\n}\n\n/// Parse a leading decimal integer, returns None if no digit.\nfn parse_int(s: &[u8