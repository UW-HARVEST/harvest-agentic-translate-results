ctional symbol (`process_buffer`); other symbols in the C `.so` (`__bss_start`, `_edata`, `_end`, `_init`, `_fini`) are linker-generated ELF metadata, not API surface.","stop_reason":"end_turn","session_id":"d7789b5a-1796-4b79-88f2-3400c1f0f704","total_cost_usd":2.1736995,"usage":{"input_tokens":54,"cache_creation_input_tokens":39942,"cache_read_input_tokens":1657684,"output_tokens":43798,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":39942},"inference_geo":"","iterations":[],"speed":"standard"},"modelUsage":{"global.anthropic.claude-opus-4-7[1m]":{"inputTokens":54,"outputTokens":43798,"cacheReadInputTokens":1657684,"cacheCreationInputTokens":39942,"webSearchRequests":0,"costUSD":2.1736995,"contextWindow":1000000,"maxOutputTokens":64000}},"permission_denials":[{"tool_name":"Bash","tool_use_id":"toolu_bdrk_01KxHAhGDbEiVbCwjbUTw9MM","tool_input":{"command":"rm -rf /tmp/harvest-work-DdMYpi/translated_rust/c_src/build","description":"Remove build dir created in c_src"}}],"terminal_reason":"completed","fast_mode_state":"off","uuid":"6b439615-ea76-40c3-b82c-40460ed2b4b4"}
