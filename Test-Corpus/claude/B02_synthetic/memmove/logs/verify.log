{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_wfkqedxxdknc5fbd6ctyiaw7glfqcvnzay6jwjf4jj5zhcaqfe2a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01WT2QonrA3zZ1xuWT5hLwuM","name":"Write","input":{"file_path":"/tmp/harvest-work-DdMYpi/translated_rust/tests/ffi_compare.rs","content":"// Integration tests that compare the C .so against the Rust .so via libloading.\n// We never call Rust functions directly — both implementations are loaded as\n// dynamic libraries and called through their `process_buffer` C ABI symbol.\n\nuse libloading::{Library, Symbol};\nuse std::os::raw::c_int;\nuse std::path::PathBuf;\n\ntype ProcessBufferFn = unsafe extern \"C\" fn(\n    buffer: *mut u8,\n    length: usize,\n    flags: u32,\n    param1: c_int,\n    param2: c_int,\n) -> usize;\n\nfn c_so_path() -> PathBuf {\n    // Built outside the workspace by the test driver / setup.\n    PathBuf::from(\"/tmp/harvest-work-DdMYpi/c_build/libdriver_c.so\")\n}\n\nfn rust_so_path() -> PathBuf {\n    // Cargo writes cdylib here when the test binary is built.\n    // Use the same target dir as the test runner.\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    // Cargo test usually goes to debug\n    p.push(\"debug\");\n    p.push(\"libdriver.so\");\n    p\n}\n\nstruct Libs {\n    _c_lib: Library,\n    _rust_lib: Library,\n    c_fn: ProcessBufferFn,\n    rust_fn: ProcessBufferFn,\n}\n\nimpl Libs {\n    fn load() -> Self {\n        let c_path = c_so_path();\n        let r_path = rust_so_path();\n        unsafe {\n            let c_lib = Library::new(&c_path)\n                .unwrap_or_else(|e| panic!(\"failed to load C lib at {:?}: {}\", c_path, e));\n            let rust_lib = Library::new(&r_path)\n                .unwrap_or_else(|e| panic!(\"failed to load Rust lib at {:?}: {}\", r_path, e));\n            let c_sym: Symbol<ProcessBufferFn> = c_lib\n                .get(b\"process_buffer\\0\")\n                .expect(\"process_buffer not found in C .so\");\n            let r_sym: Symbol<ProcessBufferFn> = rust_lib\n                .get(b\"process_buffer\\0\")\n                .expect(\"process_buffer not found in Rust .so\");\n            let c_fn = *c_sym;\n            let rust_fn = *r_sym;\n            Libs {\n                _c_lib: c_lib,\n                _rust_lib: rust_lib,\n                c_fn,\n                rust_fn,\n            }\n        }\n    }\n\n    fn run_pair(\n        &self,\n        input: &[u8],\n        flags: u32,\n        p1: i32,\n        p2: i32,\n    ) -> ((usize, Vec<u8>), (usize, Vec<u8>)) {\n        // Buffers are independent so each impl writes only into its own copy.\n        let mut c_buf = input.to_vec();\n        let mut r_buf = input.to_vec();\n        let c_len = unsafe {\n            (self.c_fn)(\n                c_buf.as_mut_ptr(),\n                input.len(),\n                flags,\n                p1 as c_int,\n                p2 as c_int,\n            )\n        };\n        let r_len = unsafe {\n            (self.rust_fn)(\n                r_buf.as_mut_ptr(),\n                input.len(),\n                flags,\n                p1 as c_int,\n                p2 as c_int,\n            )\n        };\n        ((c_len, c_buf), (r_len, r_buf))\n    }\n}\n\nfn assert_pair_match(\n    libs: &Libs,\n    input: &[u8],\n    flags: u32,\n    p1: i32,\n    p2: i32,\n) {\n    let ((c_len, c_buf), (r_len, r_buf)) = libs.run_pair(input, flags, p1, p2);\n    assert_eq!(\n        c_len, r_len,\n        \"length mismatch for input={:?}, flags=0x{:x}, p1={}, p2={}\",\n        input, flags, p1, p2\n    );\n    // Only the first `c_len` bytes are meaningful — the rest is leftover scratch\n    // and is not promised to match (the C code does not zero unused bytes).\n    assert_eq!(\n        &c_buf[..c_len],\n        &r_buf[..r_len],\n        \"buffer mismatch for input={:?}, flags=0x{:x}, p1={}, p2={}\\nC: {:?}\\nR: {:?}\",\n        input, flags, p1, p2, &c_buf[..c_len], &r_buf[..r_len]\n    );\n    // Also assert the trailing portion matches — many of the original ops keep\n    // working over the entire backing buffer (rotate writes everywhere; reverse\n    // segments mutates indices >= new_len after compact_runs may keep stale\n    // bytes there). Behavior outside [0, new_len) is implementation-defined for\n    // the public contract but should still match because both implementations\n    // claim to be byte-identical.\n    assert_eq!(\n        c_buf, r_buf,\n        \"trailing buffer bytes differ for input={:?}, flags=0x{:x}, p1={}, p2={}\",\n        input, flags, p1, p2\n    );\n}\n\n// ------------------- Empty / degenerate inputs -------------------\n\n#[test]\nfn empty_buffer_returns_zero() {\n    let libs = Libs::load();\n    let input: Vec<u8> = vec![];\n    // length-0 -> always returns 0 in both impls\n    let mut c_buf = vec![0u8; 0];\n    let mut r_buf = vec![0u8; 0];\n    let c_len = unsafe { (libs.c_fn)(c_buf.as_mut_ptr(), 0, 0xFF, 5, 1) };\n    let r_len = unsafe { (libs.rust_fn)(r_buf.as_mut_ptr(), 0, 0xFF, 5, 1) };\n    assert_eq!(c_len, 0);\n    assert_eq!(r_len, 0);\n    assert_eq!(input, c_buf);\n    assert_eq!(input, r_buf);\n}\n\n#[test]\nfn zero_flags_no_op() {\n    let libs = Libs::load();\n    for input_len in [1usize, 2, 5, 10, 33, 100, 256] {\n        let input: Vec<u8> = (0..input_len).map(|i| (i * 7 + 3) as u8).collect();\n        assert_pair_match(&libs, &input, 0, 0, 0);\n    }\n}\n\n// ------------------- Rotate (flag 0x01) -------------------\n\n#[test]\nfn rotate_various_offsets_and_lengths() {\n    let libs = Libs::load();\n    let lengths: &[usize] = &[1, 2, 3, 4, 8, 16, 32, 64, 100, 200, 256];\n    for &len in lengths {\n        let input: Vec<u8> = (0..len as u32).map(|x| (x as u8).wrapping_mul(13)).collect();\n        for offset in [\n            -10000i32, -300, -129, -64, -33, -10, -1, 0, 1, 7, 33, 64, 128, 200, 256, 300, 10000,\n        ] {\n            assert_pair_match(&libs, &input, 0x01, offset, 0);\n        }\n    }\n}\n\n#[test]\nfn rotate_small_offset_path() {\n    // exercise the \"small offset\" path: offset < len/2\n    let libs = Libs::load();\n    let input: Vec<u8> = (0..100u32).map(|x| x as u8).collect();\n    for offset in 1..49 {\n        assert_pair_match(&libs, &input, 0x01, offset, 0);\n    }\n}\n\n#[test]\nfn rotate_large_offset_path() {\n    // exercise the \"large offset\" path: offset >= len/2\n    let libs = Libs::load();\n    let input: Vec<u8> = (0..100u32).map(|x| (x as u8).wrapping_add(1)).collect();\n    for offset in 50..=99 {\n        assert_pair_match(&libs, &input, 0x01, offset, 0);\n    }\n}\n\n#[test]\nfn rotate_offset_greater_than_256_chunked() {\n    // The chunked path triggers when offset is large, but rotate's chunk is\n    // capped at 256. With our max len of 256, we still test it.\n    let libs = Libs::load();\n    let input: Vec<u8> = (0..256u32).map(|x| x as u8).collect();\n    for offset in [1, 64, 127, 128, 129, 200, 255] {\n        assert_pair_match(&libs, &input, 0x01, offset, 0);\n    }\n}\n\n// ------------------- Compact runs (flag 0x02) -------------------\n\n#[test]\nfn compact_runs_basic() {\n    let libs = Libs::load();\n    // Build inputs with various run patterns\n    let inputs: Vec<Vec<u8>> = vec![\n        vec![1, 1, 1, 1, 2, 3, 3, 3, 4],\n        vec![5, 5, 5, 5, 5, 5, 5, 5],\n        vec![1, 2, 3, 4, 5],\n        (0..100u32).map(|i| (i / 10) as u8).collect(),\n        // 300 of the same value capped at 255\n        std::iter::repeat(7u8).take(256).collect(),\n        vec![],\n    ];\n    for input in inputs {\n        for threshold in [1i32, 2, 3, 4, 5, 10, 100, 255, 256, 0, -5] {\n            assert_pair_match(&libs, &input, 0x02, threshold, 0);\n        }\n    }\n}\n\n#[test]\nfn compact_runs_long_run_capped_at_255() {\n    let libs = Libs::load();\n    // A run of 256 zeros followed by 0 ... but len max is 256, so we test with\n    // 256 same bytes which gets capped at 255 in count.\n    let input: Vec<u8> = std::iter::repeat(42u8).take(256).collect();\n    for threshold in [1i32, 2, 3, 200] {\n        assert_pair_match(&libs, &input, 0x02, threshold, 0);\n    }\n}\n\n// ------------------- Remove duplicates (flag 0x04) -------------------\n\n#[test]\nfn remove_duplicates_preserve_order() {\n    let libs = Libs::load();\n    let inputs: Vec<Vec<u8>> = vec![\n        vec![1, 2, 3, 1, 2, 3],\n        vec![5, 5, 5, 5, 5],\n        (0..200u32).map(|i| (i % 10) as u8).collect(),\n        (0..256u32).map(|i| i as u8).collect(),\n        vec![1],\n        vec![],\n    ];\n    for input in inputs {\n        assert_pair_match(&libs, &input, 0x04, 0, 1);\n    }\n}\n\n#[test]\nfn remove_duplicates_no_preserve_order() {\n    let libs = Libs::load();\n    let inputs: Vec<Vec<u8>> = vec![\n        vec![1, 2, 3, 1, 2, 3],\n        vec![5, 5, 5, 5, 5],\n        (0..200u32).map(|i| (i % 10) as u8).collect(),\n        (0..256u32).map(|i| i as u8).collect(),\n        vec![1],\n        vec![],\n    ];\n    for input in inputs {\n        assert_pair_match(&libs, &input, 0x04, 0, 0);\n    }\n}\n\n// ------------------- Interleave (flag 0x08) -------------------\n\n#[test]\nfn interleave_various_lengths() {\n    let libs = Libs::load();\n    for len in [2usize, 3, 4, 5, 10, 11, 32, 100, 200, 255, 256] {\n        let input: Vec<u8> = (0..len as u32).map(|x| (x as u8).wrapping_mul(3)).collect();\n        assert_pair_match(&libs, &input, 0x08, 0, 0);\n    }\n}\n\n#[test]\nfn interleave_too_short() {\n    let libs = Libs::load();\n    let input = vec![42u8];\n    assert_pair_match(&libs, &input, 0x08, 0, 0);\n}\n\n// ------------------- Reverse segments (flag 0x10) -------------------\n\n#[test]\nfn reverse_segments_various() {\n    let libs = Libs::load();\n    let lengths: &[usize] = &[4, 5, 8, 9, 16, 17, 31, 32, 64, 100, 256];\n    for &len in lengths {\n        let input: Vec<u8> = (0..len as u32).map(|x| x as u8).collect();\n        for seg_size in [1i32, 2, 3, 4, 5, 7, 8, 16, 32, 64, 100, 256, 0, -3] {\n            assert_pair_match(&libs, &input, 0x10, seg_size, 0);\n        }\n    }\n}\n\n#[test]\nfn reverse_segments_too_short() {\n    let libs = Libs::load();\n    // len < 4 -> reverse path skipped\n    let input = vec![1u8, 2, 3];\n    assert_pair_match(&libs, &input, 0x10, 4, 0);\n}\n\n// ------------------- Combined flags -------------------\n\n#[test]\nfn combined_all_flags() {\n    let libs = Libs::load();\n    let inputs: Vec<Vec<u8>> = vec![\n        (0..100u32).map(|i| ((i * 7) % 11) as u8).collect(),\n        (0..50u32).map(|i| (i / 5) as u8).collect(),\n        std::iter::repeat(0u8).take(256).collect(),\n        (0..256u32).map(|i| (i ^ 0xA5) as u8).collect(),\n        vec![1, 2, 2, 3, 3, 3, 4, 4, 4, 4, 5],\n    ];\n    for input in inputs {\n        for flags in 0u32..32u32 {\n            for p1 in [-5i32, 0, 1, 3, 4, 7, 16, 100] {\n                for p2 in [0i32, 1] {\n                    assert_pair_match(&libs, &input, flags, p1, p2);\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn pseudorandom_inputs() {\n    // A small PRNG-like sweep (deterministic) to catch unexpected divergences.\n    let libs = Libs::load();\n    let mut state: u32 = 0xDEAD_BEEF;\n    let mut next = || {\n        state = state.wrapping_mul(1664525).wrapping_add(1013904223);\n        state\n    };\n\n    for _ in 0..200 {\n        let len = (next() as usize) % 257; // 0..=256\n        let input: Vec<u8> = (0..len).map(|_| (next() & 0xFF) as u8).collect();\n        let flags = next() & 0x1F;\n        let p1 = (next() % 512) as i32 - 256;\n        let p2 = (next() & 1) as i32;\n        assert_pair_match(&libs, &input, flags, p1, p2);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":142,"cache_read_input_tokens":34223,"cache_creation":{"ephemeral_5m_input_tokens":142,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d7789b5a-1796-4b79-88f2-3400c1f0f704","uuid":"71a17f60-697c-4e08-a412-a7f3ae38894e"}
