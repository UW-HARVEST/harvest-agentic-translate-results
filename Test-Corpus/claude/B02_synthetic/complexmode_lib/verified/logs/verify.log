eturn (perms & required) == required;\n49\t}\n50\t\n51\tint safe_add(int a, int b, int perms) {\n52\t    if (!check_permissions(perms, READ_PERM | WRITE_PERM)) {\n53\t        printf(\"Insufficient permissions for addition\\n\");\n54\t        return 0;\n55\t    }\n56\t    return a + b;\n57\t}\n58\t\n59\tint multiply_with_log(int a, int b, char** log_msg) {\n60\t    *log_msg = create_result_string(\"multiply\", a * b);\n61\t    if (*log_msg == NULL) {\n62\t        return 0;\n63\t    }\n64\t    return a * b;\n65\t}\n66\t\n67\tint copy_and_sum(int* src, int count) {\n68\t    if (src == NULL) {\n69\t        printf(\"Source pointer is NULL\\n\");\n70\t        return -1;\n71\t    }\n72\t\n73\t    int* dest = (int*)malloc(count * sizeof(int));\n74\t    if (dest == NULL) {\n75\t        printf(\"Memory allocation failed\\n\");\n76\t        return -1;\n77\t    }\n78\t\n79\t    memcpy(dest, src, count * sizeof(int));\n80\t\n81\t    int sum = 0;\n82\t    for (int i = 0; i < count; i++) {\n83\t        sum += dest[i];\n84\t    }\n85\t\n86\t    free(dest);\n87\t    return sum;\n88\t}\n89\t\n90\tint compare_operations(const char* op1, const char* op2) {\n91\t    if (op1 == NULL || op2 == NULL) {\n92\t        printf(\"One or both operation strings are NULL\\n\");\n93\t        return -1;\n94\t    }\n95\t\n96\t    return strcmp(op1, op2);\n97\t}\n98\t\n99\tint complexmode(int mode, int value1, int value2, int value3) {\n100\t    int result = 0;\n101\t    char* log_message = NULL;\n102\t\n103\t    int permissions = 0644;  // rw-r--r--\n104\t\n105\t    Result* res_tracker = (Result*)malloc(sizeof(Result));\n106\t    if (res_tracker == NULL) {\n107\t        printf(\"Failed to allocate result tracker\\n\");\n108\t        return -1;\n109\t    }\n110\t\n111\t    res_tracker->value = 0;\n112\t    res_tracker->permissions = permissions;\n113\t    strcpy(res_tracker->operation, \"none\");\n114\t\n115\t    switch (mode) {\n116\t        case 1: {\n117\t            strcpy(res_tracker->operation, \