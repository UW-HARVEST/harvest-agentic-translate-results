f result {\n                100\n            } else {\n                if cond1 && cond2 {\n                    return 50;\n                }\n                if cond1 && cond3 {\n                    return 51;\n                }\n                if cond2 && cond3 {\n                    return 52;\n                }\n                if cond1 {\n                    return 10;\n                }\n                if cond2 {\n                    return 11;\n                }\n                if cond3 {\n                    return 12;\n                }\n                0\n            }\n        }\n        1 => {\n            // OR - at least one must be true\n            let result = cond1 || cond2 || cond3;\n            if result {\n                let mut count: i32 = 0;\n                if cond1 {\n                    count += 1;\n                }\n                if cond2 {\n                    count += 1;\n                }\n                if cond3 {\n                    count += 1;\n                }\n                100 + count\n            } else {\n                0\n            }\n        }\n        2 => {\n            // XOR - odd number must be true\n            let result = cond1 ^ cond2 ^ cond3;\n            if result {\n                if cond1 && !cond2 && !cond3 {\n                    return 1;\n                }\n                if !cond1 && cond2 && !cond3 {\n                    return 2;\n                }\n                if !cond1 && !cond2 && cond3 {\n                    return 3;\n                }\n                if cond1 && cond2 && cond3 {\n                    return 7;\n                }\n                90\n            } else {\n                0\n            }\n        }\n        3 => {\n            // NAND - not all true\n            let result = !(cond1 && cond2 && cond3);\n            if result {\n                if !cond1 && !cond2 && !cond3 {\n                    return 200;\n                }\n                if !cond1 {\n                    return 150;\n                }\n                if !cond2 {\n                    return 151;\n                }\n                if !cond3 {\n                    return 152;\n                }\n                100\n            } else {\n                0\n            }\n        }\n        _ => -1,\n    }\n}\n\n/// Configure system flags based on array of decisions.\nfn configure_flags(decisions: &[bool], count: usize) -> i32 {\n    let mut _flags: u32 = 0;\n    let mut special_count: i32 = 0;\n\n    let upper = if count < 32 { count } else { 32 };\n    for i in 0..upper {\n        if decisions[i] {\n            _flags |= 1u32 << i;\n            special_count += 1;\n        }\n    }\n\n    if special_count == 0 {\n        return 0;\n    } else if special_count as usize == count {\n        return 1000 + count as i32;\n    } else if special_count == 1 {\n        for i in 0..count {\n            if decisions[i] {\n                return 100 + i as i32;\n            }\n        }\n    } else if (special_count as usize) == count.wrapping_sub(1) {\n        // count - 1, matching C unsigned semantics: when count == 0 this wraps,\n        // but special_count would also be 0 in that branch which we already\n        // handled, so this is safe.\n        for i in 0..count {\n            if !decisions[i] {\n                return 200 + i as i32;\n            }\n        }\n    }\n\n    // Check for alternating pattern\n    let mut alternating = true;\n    for i in 1..count {\n        if decisions[i] == decisions[i - 1] {\n            alternating = false;\n            break;\n        }\n    }\n\n    if alternating {\n        return 500 + special_count;\n    }\n\n    // Check for consecutive true values\n    let mut max_consecutive: i32 = 0;\n    let mut current_consecutive: i32 = 0;\n    for i in 0..count {\n        if decisions[i] {\n            current_consecutive += 1;\n            if current_consecutive > max_consecutive {\n                max_consecutive = current_consecutive;\n            }\n        } else {\n            current_consecutive = 0;\n        }\n    }\n\n    if max_consecutive >= 3 {\n        return 300 + max_consecutive;\n    }\n\n    special_count\n}\n\n/// Validate sequence has proper pattern.\nfn validate_sequence(sequence: &[u8], len: usize) -> i32 {\n    if len == 0 {\n        return 0;\n    }\n\n    // Convert all to bools (the C code reuses the original buffer; we use a\n    // separate Vec since the algorithm only depends on the bool values).\n    let bools: Vec<bool> = (0..len).map(|i| parse_bool(sequence[i])).collect();\n\n    // Rule 1: Must start with 'y'\n    if !bools[0] {\n        return -10;\n    }\n\n    // Rule 2: Must end with 'n' if length > 1\n    if len > 1 && bools[len - 1] {\n        return -11;\n    }\n\n    // Rule 3: Cannot have more than 3 consecutive same values\n    let mut consecutive = 1;\n    for i in 1..len {\n        if bools[i] == bools[i - 1] {\n            consecutive += 1;\n            if consecutive > 3 {\n                return -12;\n            }\n        } else {\n            consecutive = 1;\n        }\n    }\n\n    // Rule 4: Count transitions\n    let mut transitions: i32 = 0;\n    for i in 1..len {\n        if bools[i] != bools[i - 1] {\n            transitions += 1;\n        }\n    }\n\n    let len_i = len as i32;\n    if len <= 3 {\n        if transitions == 0 {\n            return 1;\n        }\n        if transitions == len_i - 1 {\n            return 2;\n        }\n        return 10 + transitions;\n    } else if len <= 10 {\n        if transitions < len_i / 3 {\n            return 20;\n        }\n        if transitions > len_i / 2 {\n            return 30;\n        }\n        25\n    } else {\n        if transitions < 3 {\n            return 40;\n        }\n        if transitions > len_i - 3 {\n            return 50;\n        }\n        45\n    }\n}\n\n/// Main entrance function - processes boolean decisions.\npub fn process_decisions(\n    decision_string: &[u8],\n    length: usize,\n    operation: i32,\n    param: i32,\n) -> i32 {\n    // The C code checks `decision_string == NULL || length == 0`. In Rust we\n    // cannot have a NULL slice; the analog of the length check still applies.\n    if length == 0 {\n        return -1;\n    }\n\n    match operation {\n        0 => {\n            if length < 3 {\n                return -2;\n            }\n            let read = parse_bool(decision_string[0]);\n            let write = parse_bool(decision_string[1]);\n            let execute = parse_bool(decision_string[2]);\n            apply_permissions(read, write, execute)\n        }\n        1 => {\n            if length < 3 {\n                return -2;\n            }\n            let cond1 = parse_bool(decision_string[0]);\n            let cond2 = parse_bool(decision_string[1]);\n            let cond3 = parse_bool(decision_string[2]);\n            evaluate_conditions(cond1, cond2, cond3, param)\n        }\n        2 => {\n            let mut decisions = [false; 32];\n            let count = if length < 32 { length } else { 32 };\n            for i in 0..count {\n                decisions[i] = parse_bool(decision_string[i]);\n            }\n            configure_flags(&decisions[..count], count)\n        }\n        3 => validate_sequence(decision_string, length),\n        _ => -3,\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
