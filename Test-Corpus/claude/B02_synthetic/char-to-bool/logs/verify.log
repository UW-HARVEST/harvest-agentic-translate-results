ram length Length of decision string\n41\t * @param operation Operation to perform:\n42\t *                  0: apply permissions (uses first 3 decisions)\n43\t *                  1: evaluate conditions with logic (uses first 3 decisions)\n44\t *                  2: configure flags (uses all decisions)\n45\t *                  3: validate sequence (checks pattern)\n46\t * @param param Operation-specific parameter (logic operator, mode, etc)\n47\t * @return Operation result or error code\n48\t */\n49\tint process_decisions(char *decision_string, size_t length, \n50\t                     int operation, int param) {\n51\t    \n52\t    if (decision_string == NULL || length == 0) {\n53\t        return -1;\n54\t    }\n55\t    \n56\t    switch (operation) {\n57\t        case 0: {\n58\t            /* Apply permissions: read, write, execute */\n59\t            if (length < 3) return -2;\n60\t            \n61\t            bool read = parse_bool(decision_string[0]);\n62\t            bool write = parse_bool(decision_string[1]);\n63\t            bool execute = parse_bool(decision_string[2]);\n64\t            \n65\t            return apply_permissions(read, write, execute);\n66\t        }\n67\t        \n68\t        case 1: {\n69\t            /* Evaluate logical conditions */\n70\t            if (length < 3) return -2;\n71\t            \n72\t            bool cond1 = parse_bool(decision_string[0]);\n73\t            bool cond2 = parse_bool(decision_string[1]);\n74\t            bool cond3 = parse_bool(decision_string[2]);\n75\t            \n76\t            /* param determines logic operation: 0=AND, 1=OR, 2=XOR, 3=NAND */\n77\t            return evaluate_conditions(cond1, cond2, cond3, param);\n78\t        }\n79\t        \n80\t        case 2: {\n81\t            /* Configure flags from all decisions */\n82\t            bool decisions[32];\n83\t            size_t count = (length < 32) ? length : 32;\n84\t            \n85\t            for (size_t i = 0; i < count; i++) {\n86\t                decisions[i] = parse_bool(decision_string[i]);\n87\t            }\n88\t            \n89\t            return configure_flags(decisions, count);\n90\t        }\n91\t        \n92\t        case 3: {\n93\t            /* Validate decision sequence */\n94\t            return validate_sequence(decision_string, length);\n95\t        }\n96\t        \n97\t        default:\n98\t            return -3;\n99\t    }\n100\t}\n101\t\n102\t/**\n103\t * Parse character to boolean\n104\t * 'y' or 'Y' -> true\n105\t * 'n' or 'N' -> false\n106\t * anything else -> false\n107\t */\n108\tstatic bool parse_bool(char c) {\n109\t    if (c == 'y' || c == 'Y') {\n110\t        return true;\n111\t    } else if (c == 'n' || c == 'N') {\n112\t        return false;\n113\t    }\n114\t    return false;  /* Default to false for invalid input */\n115\t}\n116\t\n117\t/**\n118\t * Apply permissions based on read/write/execute flags\n119\t * Complex branching based on boolean combinations\n120\t */\n121\tstatic int apply_permissions(bool read, bool write, bool execute) {\n122\t    int permission_value = 0;\n123\t    \n124\t    /* Base permission calculation */\n125\t    if (read) {\n126\t        permission_value += 4;\n127\t    }\n128\t    if (write) {\n129\t        permission_value += 2;\n130\t    }\n131\t    if (execute) {\n132\t        permission_value += 1;\n133\t    }\n134\t    \n135\t    /* Complex decision tree based on combinations */\n136\t    if (read && write && execute) {\n137\t        /* Full permissions - special handling */\n138\t        return 100 + permission_value;  /* 107 */\n139\t    } else if (read && write) {\n140\t        /* Read/write but no execute */\n141\t        if (permission_value == 6) {\n142\t            return 50 + permission_value;  /* 56 */\n143\t        }\n144\t    } else if (read && execute) {\n145\t        /* Read/execute but no write */\n146\t        return 30 + permission_value;  /* 35 */\n147\t    } else if (write && execute) {\n148\t        /* Write/execute but no read - unusual case */\n149\t        return 20 + permission_value;  /* 23 */\n150\t    } else if (read) {\n151\t        /* Read only */\n152\t        return 10 + permission_value;  /* 14 */\n153\t    } else if (write) {\n154\t        /* Write only - dangerous */\n155\t        return -10;\n156\t    } else if (execute) {\n157\t        /* Execute only - very unusual */\n158\t        return -20;\n159\t    }\n160\t    \n161\t    /* No permissions */\n162\t    return 0;\n163\t}\n164\t\n165\t/**\n166\t * Evaluate three conditions with different logic operators\n167\t */\n168\tstatic int evaluate_conditions(bool cond1, bool cond2, bool cond3, int logic_op) {\n169\t    bool result;\n170\t    \n171\t    switch (logic_op) {\n172\t        case 0: {\n173\t            /* AND - all must be true */\n174\t            result = cond1 && cond2 && cond3;\n175\t            \n176\t            if (result) {\n177\t                return 100;\n178\t            } else {\n179\t                /* Partial matches */\n180\t                if (cond1 && cond2) return 50;\n181\t                if (cond1 && cond3) return 51;\n182\t                if (cond2 && cond3) return 52;\n183\t                if (cond1) return 10;\n184\t                if (cond2) return 11;\n185\t                if (cond3) return 12;\n186\t                return 0;\n187\t            }\n188\t        }\n189\t        \n190\t        case 1: {\n191\t            /* OR - at least one must be true */\n192\t            result = cond1 || cond2 || cond3;\n193\t            \n194\t            if (result) {\n195\t                /* Count how many are true */\n196\t                int count = 0;\n197\t                if (cond1) count++;\n198\t                if (cond2) count++;\n199\t                if (cond3) count++;\n200\t                return 100 + count;\n201\t            }\n202\t            return 0;\n203\t        }\n204\t        \n205\t        case 2: {\n206\t            /* XOR - odd number must be true */\n207\t            result = (cond1 ^ cond2 ^ cond3);\n208\t            \n209\t            if (result) {\n210\t                /* Determine which combination */\n211\t                if (cond1 && !cond2 && !cond3) return 1;\n212\t                if (!cond1 && cond2 && !cond3) return 2;\n213\t                if (!cond1 && !cond2 && cond3) return 3;\n214\t                if (cond1 && cond2 && cond3) return 7;\n215\t                return 90;\n216\t            }\n217\t            return 0;\n218\t        }\n219\t        \n220\t        case 3: {\n221\t            /* NAND - not all true */\n222\t            result = !(cond1 && cond2 && cond3);\n223\t            \n224\t            if (result) {\n225\t                /* Various false combinations */\n226\t                if (!cond1 && !cond2 && !cond3) return 200;\n227\t                if (!cond1) return 150;\n228\t                if (!cond2) return 151;\n229\t                if (!cond3) return 152;\n230\t                return 100;\n231\t            }\n232\t            return 0;\n233\t        }\n234\t        \n235\t        default:\n236\t            return -1;\n237\t    }\n238\t}\n239\t\n240\t/**\n241\t * Configure system flags based on array of decisions\n242\t * Creates bitmask and applies various rules\n243\t */\n244\tstatic int configure_flags(bool *decisions, size_t count) {\n245\t    uint32_t flags = 0;\n246\t    int special_count = 0;\n247\t    \n248\t    /* Build flag bitmask */\n249\t    for (size_t i = 0; i < count && i < 32; i++) {\n250\t        if (decisions[i]) {\n251\t            flags |= (1u << i);\n252\t            special_count++;\n253\t        }\n254\t    }\n255\t    \n256\t    /* Apply rules based on flag patterns */\n257\t    if (special_count == 0) {\n258\t        /* All false */\n259\t        return 0;\n260\t    } else if (special_count == count) {\n261\t        /* All true */\n262\t        return 1000 + (int)count;\n263\t    } else if (special_count == 1) {\n264\t        /* Exactly one true - find which one */\n265\t        for (size_t i = 0; i < count; i++) {\n266\t            if (decisions[i]) {\n267\t                return 100 + (int)i;\n268\t            }\n269\t        }\n270\t    } else if (special_count == count - 1) {\n271\t        /* Exactly one false - find which one */\n272\t        for (size_t i = 0; i < count; i++) {\n273\t            if (!decisions[i]) {\n274\t                return 200 + (int)i;\n275\t            }\n276\t        }\n277\t    }\n278\t    \n279\t    /* Check for alternating pattern */\n280\t    bool alternating = true;\n281\t    for (size_t i = 1; i < count; i++) {\n282\t        if (decisions[i] == decisions[i-1]) {\n283\t            alternating = false;\n284\t            break;\n285\t        }\n286\t    }\n287\t    \n288\t    if (alternating) {\n289\t        return 500 + special_count;\n290\t    }\n291\t    \n292\t    /* Check for consecutive true values */\n293\t    int max_consecutive = 0;\n294\t    int current_consecutive = 0;\n295\t    for (size_t i = 0; i < count; i++) {\n296\t        if (decisions[i]) {\n297\t            current_consecutive++;\n298\t            if (current_consecutive > max_consecutive) {\n299\t                max_consecutive = current_consecutive;\n300\t            }\n301\t        } else {\n302\t            current_consecutive = 0;\n303\t        }\n304\t    }\n305\t    \n306\t    if (max_consecutive >= 3) {\n307\t        return 300 + max_consecutive;\n308\t    }\n309\t    \n310\t    /* Return count of true values */\n311\t    return special_count;\n312\t}\n313\t\n314\t/**\n315\t * Validate sequence has proper pattern\n316\t * Checks various decision sequence rules\n317\t */\n318\tstatic int validate_sequence(char *sequence, size_t len) {\n319\t    if (len == 0) return 0;\n320\t    \n321\t    /* Convert all to bools */\n322\t    bool *bools = (bool*)sequence;  /* Reuse buffer */\n323\t    for (size_t i = 0; i < len; i++) {\n324\t        bool val = parse_bool(sequence[i]);\n325\t        bools[i] = val;\n326\t    }\n327\t    \n328\t    /* Rule 1: Must start with 'y' */\n329\t    if (!bools[0]) {\n330\t        return -10;\n331\t    }\n332\t    \n333\t    /* Rule 2: Must end with 'n' if length > 1 */\n334\t    if (len > 1 && bools[len-1]) {\n335\t        return -11;\n336\t    }\n337\t    \n338\t    /* Rule 3: Cannot have more than 3 consecutive same values */\n339\t    int consecutive = 1;\n340\t    for (size_t i = 1; i < len; i++) {\n341\t        if (bools[i] == bools[i-1]) {\n342\t            consecutive++;\n343\t            if (consecutive > 3) {\n344\t                return -12;\n345\t            }\n346\t        } else {\n347\t            consecutive = 1;\n348\t        }\n349\t    }\n350\t    \n351\t    /* Rule 4: Count transitions */\n352\t    int transitions = 0;\n353\t    for (size_t i = 1; i < len; i++) {\n354\t        if (bools[i] != bools[i-1]) {\n355\t            transitions++;\n356\t        }\n357\t    }\n358\t    \n359\t    /* Validate based on length */\n360\t    if (len <= 3) {\n361\t        /* Short sequences - simple rules */\n362\t        if (transitions == 0) return 1;  /* All same (but passes other rules) */\n363\t        if (transitions == len - 1) return 2;  /* All different */\n364\t        return 10 + transitions;\n365\t    } else if (len <= 10) {\n366\t        /* Medium sequences */\n367\t        if (transitions < len / 3) return 20;  /* Few transitions */\n368\t        if (transitions > len / 2) return 30;  /* Many transitions */\n369\t        return 25;\n370\t    } else {\n371\t        /* Long sequences */\n372\t        if (transitions < 3) return 40;\n373\t        if (transitions > len - 3) return 50;\n374\t        return 45;\n375\t    }\n376\t}\n377\t"}]},"parent_tool_use_id":null,"session_id":"13eab570-5e71-4e4a-abbe-45800d80ba98","uuid":"3dcc65b5-6b9c-41d3-9e12-906f696c0e9a","timestamp":"2026-05-28T14:46:41.044Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-work-IUWT1D/translated_rust/c_src/src/lib.c","content":"/*\n * Copyright 2025 MIT Lincoln Lab