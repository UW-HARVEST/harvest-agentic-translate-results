or the C .so.\n        let out_dir = std::env::var(\"OUT_DIR\").expect(\"OUT_DIR set by cargo\");\n        let script_path = std::path::Path::new(&out_dir).join(\"export_init_fini.ver\");\n        std::fs::write(\n            &script_path,\n            \"{ global: _init; _fini; };\\n\",\n        )\n        .expect(\"write version script\");\n        println!(\n            \"cargo:rustc-cdylib-link-arg=-Wl,--version-script={}\",\n            script_path.display()\n        );\n        println!(\"cargo:rerun-if-changed=build.rs\");\n    }\n}\n","structuredPatch":[{"oldStart":21,"oldLines":7,"newStart":21,"newLines":7,"lines":["         let script_path = std::path::Path::new(&out_dir).join(\"export_init_fini.ver\");","         std::fs::write(","             &script_path,","-            \"{ global: _init; _fini; };\\n\",","+            \"EXPORT_INIT_FINI { global: _init; _fini; };\\n\",","         )","         .expect(\"write version script\");","         println!("]}],"userModified":false,"replaceAll":false}}
