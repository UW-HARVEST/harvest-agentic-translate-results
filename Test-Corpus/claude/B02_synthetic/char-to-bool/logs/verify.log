\n        // adding `--export-dynamic` plus `-z,nodelete` produces a Rust .so\n        // whose `nm -D` output matches the C .so byte for byte.\n        println!(\"cargo:rustc-cdylib-link-arg=-Wl,--export-dynamic\");\n        println!(\"cargo:rerun-if-changed=build.rs\");","originalFile":"// Copyright 2025 MIT Lincoln Laboratory\n//\n// Build script that re-exports the linker-generated `_init` and `_fini`\n// stubs in our cdylib. Rust's default cdylib link strategy applies a version\n// script that marks every symbol other than `#[no_mangle] pub` exports as\n// local; the C shared library, on the other hand, exports `_init` and\n// `_fini` (the empty stubs from crti.o / crtn.o). To produce a Rust .so\n// whose `nm -D` output is identical to the C .so we explicitly request\n// these symbols be globally visible.\n\nfn main() {\n    // Only meaningful when targeting a real ELF cdylib.\n    if cfg!(target_family = \"unix\") {\n        // Rust's cdylib uses a version script that hides every symbol\n        // except its own #[no_mangle] exports (and stripped Rust internals).\n        // We can't append additional symbol patterns to that auto-generated\n        // script directly, but we can pass a *second* version script so the\n        // linker treats `_init` and `_fini` (created by crti.o / crtn.o) as\n        // globally visible — matching what GCC produces for the C .so.\n        let out_dir = std::env::var(\"OUT_DIR\").expect(\"OUT_DIR set by cargo\");\n        // We can't easily override Rust's auto-generated version script that\n        // marks every non-#[no_mangle] symbol as `local`, but we can pass\n        // `--undefined=_init --undefined=_fini` so the linker pulls the\n        // crti.o/crtn.o stubs in *and* their visibility default applies.\n        // In practice we use a dynamic list to whitelist them in the dynsym\n        // table and `-Bsymbolic` so they keep their global binding.\n        let list_path = std::path::Path::new(&out_dir).join(\"export_init_fini.list\");\n        std::fs::write(&list_path, \"{ _init; _fini; };\\n\").expect(\"write dynamic list\");\n        println!(\"cargo:rustc-cdylib-link-arg=-Wl,--undefined=_init\");\n        println!(\"cargo:rustc-cdylib-link-arg=-Wl,--undefined=_fini\");\n        println!(\n            \"cargo:rustc-cdylib-link-arg=-Wl,--dynamic-list={}\",\n            list_path.display()\n        );\n        println!(\"cargo:rerun-if-changed=build.rs\");\n    }\n}\n","structuredPatch":[{"oldStart":17,"oldLines":21,"newStart":17,"newLines":14,"lines":["         // script directly, but we can pass a *second* version script so the","         // linker treats `_init` and `_fini` (created by crti.o / crtn.o) as","         // globally visible — matching what GCC produces for the C .so.","-        let out_dir = std::env::var(\"OUT_DIR\").expect(\"OUT_DIR set by cargo\");","-        // We can't easily override Rust's auto-generated version script that","-        // marks every non-#[no_mangle] symbol as `local`, but we can pass","-        // `--undefined=_init --undefined=_fini` so the linker pulls the","-        // crti.o/crtn.o stubs in *and* their visibility default applies.","-        // In practice we use a dynamic list to whitelist them in the dynsym","-        // table and `-Bsymbolic` so they keep their global binding.","-        let list_path = std::path::Path::new(&out_dir).join(\"export_init_fini.list\");","-        std::fs::write(&list_path, \"{ _init; _fini; };\\n\").expect(\"write dynamic list\");","-        println!(\"cargo:rustc-cdylib-link-arg=-Wl,--undefined=_init\");","-        println!(\"cargo:rustc-cdylib-link-arg=-Wl,--undefined=_fini\");","-        println!(","-            \"cargo:rustc-cdylib-link-arg=-Wl,--dynamic-list={}\",","-            list_path.display()","-        );","+        // Force-export `_init` and `_fini` by passing `--export-dynamic`,","+        // which keeps every globally-bound symbol in the dynamic table even","+        // when Rust's auto