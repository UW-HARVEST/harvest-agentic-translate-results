identical to the C .so we explicitly request\n// these symbols be globally visible.\n\nfn main() {\n    // Only meaningful when targeting a real ELF cdylib.\n    if cfg!(target_family = \"unix\") {\n        // Rust's cdylib uses a version script that hides every symbol\n        // except its own #[no_mangle] exports (and stripped Rust internals).\n        // We can't append additional symbol patterns to that auto-generated\n        // script directly, but we can pass a *second* version script so the\n        // linker treats `_init` and `_fini` (created by crti.o / crtn.o) as\n        // globally visible — matching what GCC produces for the C .so.\n        // Force-export `_init` and `_fini` by passing `--export-dynamic`,\n        // which keeps every globally-bound symbol in the dynamic table even\n        // when Rust's auto-generated version script would mark unrelated\n        // exports `local`. The `_init`/`_fini` stubs come from crti.o /\n        // crtn.o and are linked into the .so as local symbols by default;\n        // adding `--export-dynamic` plus `-z,nodelete` produces a Rust .so\n        // whose `nm -D` output matches the C .so byte for byte.\n        println!(\"cargo:rustc-cdylib-link-arg=-Wl,--export-dynamic\");\n        println!(\"cargo:rerun-if-changed=build.rs\");\n    }\n}\n","structuredPatch":[{"oldStart":17,"oldLines":14,"newStart":17,"newLines":63,"lines":["         // script directly, but we can pass a *second* version script so the","         // linker treats `_init` and `_fini` (created by crti.o / crtn.o) as","         // globally visible — matching what GCC produces for the C .so.","-        // Force-export `_init` and `_fini` by passing `--export-dynamic`,","-        // which keeps every globally-bound symbol in the dynamic table even","-        // when Rust's auto-generated version script would mark unrelated","-        // exports `local`. The `_init`/`_fini` stubs come from crti.o /","-        // crtn.o and are linked into the .so a