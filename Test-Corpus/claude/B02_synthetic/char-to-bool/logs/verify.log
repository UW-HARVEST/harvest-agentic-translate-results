ests, 0 failures.**\n\n**Symbol-export verification:** `nm -D` on both `.so` files yields the same set: `_fini`, `_init`, `process_decisions`. **Identical exported-symbol set, no missing exports.**\n\n**End-to-end binary parity:** A 504-case shell fuzz comparing `c_src/build/driver` and `target/release/driver` produces **0 mismatches**.","stop_reason":"end_turn","session_id":"13eab570-5e71-4e4a-abbe-45800d80ba98","total_cost_usd":3.9446507500000005,"usage":{"input_tokens":105,"cache_creation_input_tokens":67297,"cache_read_input_tokens":4886239,"output_tokens":43216,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":67297},"inference_geo":"","iterations":[],"speed":"standard"},"modelUsage":{"global.anthropic.claude-opus-4-7[1m]":{"inputTokens":105,"outputTokens":43216,"cacheReadInputTokens":4886239,"cacheCreationInputTokens":67297,"webSearchRequests":0,"costUSD":3.9446507500000005,"contextWindow":1000000,"maxOutputTokens":64000}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","uuid":"6895b8f5-f3d5-48f4-a9cc-a74386d11998"}
