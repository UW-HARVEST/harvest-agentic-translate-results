 script that re-exports the linker-generated `_init` and `_fini`\n// stubs in our cdylib. Rust's default cdylib link strategy applies a version\n// script that marks every symbol other than `#[no_mangle] pub` exports as\n// local; the C shared library, on the other hand, exports `_init` and\n// `_fini` (the empty stubs from crti.o / crtn.o). To produce a Rust .so\n// whose `nm -D` output is identical to the C .so we explicitly request\n// these symbols be globally visible.\n\nfn main() {\n    // Only meaningful when targeting a real ELF cdylib.\n    if cfg!(target_family = \"unix\") {\n        // Rust's cdylib uses a version script that hides every symbol\n        // except its own #[no_mangle] exports (and stripped Rust internals).\n        // We can't append additional symbol patterns to that auto-generated\n        // script directly, but we can pass a *second* version script so the\n        // linker treats `_init` and `_fini` (created by crti.o / crtn.o) as\n        // globally visible — matching what GCC produces for the C .so.\n        // The C shared library exports `_init` and `_fini` (linker-generated\n        // stubs from crti.o / crtn.o). Rust's cdylib build emits a version\n        // script with `local: *;`, so those stubs become local in `.dynsym`.\n        // We supply our own `_init`/`_fini` stubs in a small assembly object\n        // and ask the linker to skip the crti/crtn standard files, so our\n        // copies are the ones included and they go into `.dynsym` as global.\n        let out_dir = std::env::var(\"OUT_DIR\").expect(\"OUT_DIR set by cargo\");\n        let asm_path = std::path::Path::new(&out_dir).join(\"init_fini_stubs.S\");\n        let obj_path = std::path::Path::new(&out_dir).join(\"init_fini_stubs.o\");\n        std::fs::write(\n            &asm_path,\n            r#\"\n    .section .init,\"ax\",@progbits\n    .globl _init\n    .type _init, @function\n_init:\n    ret\n    .size _init, .-_init\n\n    .section .fini,\"ax\",@progbits\n    .globl _fini\n    .type _fini, @function\n_fini:\n    ret\n    .size _fini, .-_fini\n\n    .section .note.GNU-stack,\"\",@progbits\n\"#,\n        )\n        .expect(\"write init/fini stub asm\");\n\n        let status = std::process::Command::new(\"cc\")\n            .arg(\"-c\")\n            .arg(\"-fPIC\")\n            .arg(\"-o\")\n            .arg(&obj_path)\n            .arg(&asm_path)\n            .status()\n            .expect(\"invoke cc to assemble init/fini stubs\");\n        assert!(status.success(), \"failed to assemble init/fini stubs\");\n\n        // Skip the standard crti.o / crtn.o so our stubs win, and include\n        // our object file plus a dynamic-list whitelist so `_init`/`_fini`\n        // make it into the dynamic symbol table even with Rust's version\n        // script.\n        let list_path = std::path::Path::new(&out_dir).join(\"export_init_fini.list\");\n        std::fs::write(&list_path, \"{ _init; _fini; };\\n\").expect(\"write dynamic list\");\n\n        println!(\"cargo:rustc-cdylib-link-arg=-nostartfiles\");\n        println!(\n            \"cargo:rustc-cdylib-link-arg={}\",\n            obj_path.display()\n        );\n        println!(\n            \"cargo:rustc-cdylib-link-arg=-Wl,--dynamic-list={}\",\n            list_path.display()\n        );\n        println!(\"cargo:rerun-if-changed=build.rs\");\n    }\n}\n","structuredPatch":[{"oldStart":62,"oldLines":8,"newStart":62,"newLines":14,"lines":["         // our object file plus a dynamic-list whitelist so `_init`/`_fini`","         // make it into the dynamic symbol table even with Rust's version","         // script.","-        let list_path = std::path::Path::new(&out_dir).join(\"export_init_fini.list\");","-        std::fs::write(&list_path, \"{ _init; _fini; };\\n\").expect(\"write dynamic list\");","+        // Replace Rust's auto-generated version script with one that exports","+        // `_init` and `_fini` in addition to `process_decisions`.","+        let ver_