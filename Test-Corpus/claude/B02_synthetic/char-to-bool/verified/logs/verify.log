nd3 {\n60\t                    return 52;\n61\t                }\n62\t                if cond1 {\n63\t                    return 10;\n64\t                }\n65\t                if cond2 {\n66\t                    return 11;\n67\t                }\n68\t                if cond3 {\n69\t                    return 12;\n70\t                }\n71\t                0\n72\t            }\n73\t        }\n74\t        1 => {\n75\t            // OR - at least one must be true\n76\t            let result = cond1 || cond2 || cond3;\n77\t            if result {\n78\t                let mut count: i32 = 0;\n79\t                if cond1 {\n80\t                    count += 1;\n81\t                }\n82\t                if cond2 {\n83\t                    count += 1;\n84\t                }\n85\t                if cond3 {\n86\t                    count += 1;\n87\t                }\n88\t                100 + count\n89\t            } else {\n90\t                0\n91\t            }\n92\t        }\n93\t        2 => {\n94\t            // XOR - odd number must be true\n95\t            let result = cond1 ^ cond2 ^ cond3;\n96\t            if result {\n97\t                if cond1 && !cond2 && !cond3 {\n98\t                    return 1;\n99\t                }\n100\t                if !cond1 && cond2 && !cond3 {\n101\t                    return 2;\n102\t                }\n103\t                if !cond1 && !cond2 && cond3 {\n104\t                    return 3;\n105\t                }\n106\t                if cond1 && cond2 && cond3 {\n107\t                    return 7;\n108\t                }\n109\t                90\n110\t            } else {\n111\t                0\n112\t            }\n113\t        }\n114\t        3 => {\n115\t            // NAND - not all true\n116\t            let result = !(cond1 && cond2 && cond3);\n117\t            if result {\n118\t                if !cond1 && !cond2 && !cond3 {\n119\t                    return 200;\n120\t                }\n121\t                if !cond1 {\n122\t                    return 150;\n123\t                }\n124\t                if !cond2 {\n125\t                    return 151;\n126\t                }\n127\t                if !cond3 {\n128\t                    return 152;\n129\t                }\n130\t                100\n131\t            } else {\n132\t                0\n133\t            }\n134\t        }\n135\t        _ => -1,\n136\t    }\n137\t}\n138\t\n139\t/// Configure system flags based on array of decisions.\n140\tfn configure_flags(decisions: &[bool], count: usize) -> i32 {\n141\t    let mut _flags: u32 = 0;\n142\t    let mut special_count: i32 = 0;\n143\t\n144\t    let upper = if count < 32 { count } else { 32 };\n145\t    for i in 0..upper {\n146\t        if decisions[i] {\n147\t            _flags |= 1u32 << i;\n148\t            special_count += 1;\n149\t        }\n150\t    }\n151\t\n152\t    if special_count == 0 {\n153\t        return 0;\n154\t    } else if special_count as usize == count {\n155\t        return 1000 + count as i32;\n156\t    } else if special_count == 1 {\n157\t        for i in 0..count {\n158\t            if decisions[i] {\n159\t                return 100 + i as i32;\n160\t            }\n161\t        }\n162\t    } else if (special_count as usize) == count.wrapping_sub(1) {\n163\t        // count - 1, matching C unsigned semantics: when count == 0 this wraps,\n164\t        // but special_count would also be 0 in that branch which we already\n165\t        // handled, so this is safe.\n166\t        for i in 0..count {\n167\t            if !decisions[i] {\n168\t                return 200 + i as i32;\n169\t            }\n170\t        }\n171\t    }\n172\t\n173\t    // Check for alternating pattern\n174\t    let mut alternating = true;\n175\t    for i in 1..count {\n176\t        if decisions[i] == decisions[i - 1] {\n177\t            alternating = false;\n178\t            break;\n179\t        }\n180\t    }\n181\t\n182\t    if alternating {\n183\t        return 500 + special_count;\n184\t    }\n185\t\n186\t    // Check for consecutive true values\n187\t    let mut max_consecutive: i32 = 0;\n188\t    let mut current_consecutive: i32 = 0;\n189\t    for i in 0..count {\n190\t        if decisions[i] {\n191\t            current_consecutive += 1;\n192\t            if current_consecutive > max_consecutive {\n193\t                max_consecutive = current_consecutive;\n194\t            }\n195\t        } else {\n196\t            current_consecutive = 0;\n197\t        }\n198\t    }\n199\t\n200\t    if max_consecutive >= 3 {\n201\t        return 300 + max_consecutive;\n202\t    }\n203\t\n204\t    special_count\n205\t}\n206\t\n207\t/// Validate sequence has proper pattern.\n208\tfn validate_sequence(sequence: &[u8], len: usize) -> i32 {\n209\t    if len == 0 {\n210\t        return 0;\n211\t    }\n212\t\n213\t    // Convert all to bools (the C code reuses the original buffer; we use a\n214\t    // separate Vec since the algorithm only depends on the bool values).\n215\t    let bools: Vec<bool> = (0..len).map(|i| parse_bool(sequence[i])).collect();\n216\t\n217\t    // Rule 1: Must start with 'y'\n218\t    if !bools[0] {\n219\t        return -10;\n220\t    }\n221\t\n222\t    // Rule 2: Must end with 'n' if length > 1\n223\t    if len > 1 && bools[len - 1] {\n224\t        return -11;\n225\t    }\n226\t\n227\t    // Rule 3: Cannot have more than 3 consecutive same values\n228\t    let mut consecutive = 1;\n229\t    for i in 1..len {\n230\t        if bools[i] == bools[i - 1] {\n231\t            consecutive += 1;\n232\t            if consecutive > 3 {\n233\t                return -12;\n234\t            }\n235\t        } else {\n236\t            consecutive = 1;\n237\t        }\n238\t    }\n239\t\n240\t    // Rule 4: Count transitions\n241\t    let mut transitions: i32 = 0;\n242\t    for i in 1..len {\n243\t        if bools[i] != bools[i - 1] {\n244\t            transitions += 1;\n245\t        }\n246\t    }\n247\t\n248\t    let len_i = len as i32;\n249\t    if len <=