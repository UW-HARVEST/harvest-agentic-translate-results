{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01V2wZPrdQ3osghVrauYzRcK","type":"tool_result","content":"1\t/*\n2\t * Copyright 2025 MIT Lincoln Laboratory\n3\t * Permission is hereby granted, free of charge,\n4\t * to any person obtaining a copy of this software\n5\t * and associated documentation files (the \"Software\"),\n6\t * to deal in the Software without restriction,\n7\t * including without limitation the rights to use, copy,\n8\t * modify, merge, publish, distribute, sublicense,\n9\t * and/or sell copies of the Software,\n10\t * and to permit persons to whom the Software is furnished to do so,\n11\t * subject to the following conditions:\n12\t * \n13\t * The above copyright notice and this permission notice\n14\t * shall be included in all copies or substantial portions of the Software.\n15\t * \n16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n18\t * THE WARRANTIES OF MERCHANTABILITY,\n19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n24\t */\n25\t#include <stddef.h>\n26\t#include <stdint.h>\n27\t#include <stdbool.h>\n28\t\n29\t/* Forward declarations */\n30\tstatic bool parse_bool(char c);\n31\tstatic int apply_permissions(bool read, bool write, bool execute);\n32\tstatic int evaluate_conditions(bool cond1, bool cond2, bool cond3, int logic_op);\n33\tstatic int configure_flags(bool *decisions, size_t count);\n34\tstatic int validate_sequence(char *sequence, size_t len);\n35\t\n36\t/**\n37\t * Main entrance function - processes boolean decisions\n38\t * \n39\t * @param decision_string String of 'y'/'n' characters representing decisions\n40\t * @param length Length of decision string\n41\t * @param operation Operation to perform:\n42\t *                  0: apply permissions (uses first 3 decisions)\n43\t *                  1: evaluate conditions with logic (uses first 3 decisions)\n44\t *                  2: configure flags (uses all decisions)\n45\t *                  3: validate sequence (checks pattern)\n46\t * @param param Operation-specific parameter (logic operator, mode, etc)\n47\t * @return Operation result or error code\n48\t */\n49\tint process_decisions(char *decision_string, size_t length, \n50\t                     int operation, int param) {\n51\t    \n52\t    if (decision_string == NULL || length == 0) {\n53\t        return -1;\n54\t    }\n55\t    \n56\t    switch (operation) {\n57\t        case 0: {\n58\t            /* Apply permissions: read, write, execute */\n59\t            if (length < 3) return -2;\n60\t            \n61\t            bool read = parse_bool(decision_string[0]);\n62\t            bool write = parse_bool(decision_string[1]);\n63\t            bool execute = parse_bool(decision_string[2]);\n64\t            \n65\t            return apply_permissions(read, write, execute);\n66\t        }\n67\t        \n68\t        case 1: {\n69\t            /* Evaluate logical conditions */\n70\t            if (length < 3) return -2;\n71\t            \n72\t            bool cond1 = parse_bool(decision_string[0]);\n73\t            bool cond2 = parse_bool(decision_string[1]);\n74\t            bool cond3 = parse_bool(decision_string[2]);\n75\t            \n76\t            /* param determines logic operation: 0=AND, 1=OR, 2=XOR, 3=NAND */\n77\t            return evaluate_conditions(cond1, cond2, cond3, param);\n78\t        }\n79\t        \n80\t        case 2: {\n81\t            /* Configure flags from all decisions */\n82\t            bool decisions[32];\n83\t            size_t count = (length < 32) ? length : 32;\n84\t            \n85\t            for (size_t i = 0; i < count; i++) {\n86\t                decisions[i] = parse_bool(decision_string[i]);\n87\t            }\n88\t            \n89\t            return configure_flags(decisions, count);\n90\t        }\n91\t        \n92\t        case 3: {\n93\t            /* Validate decision sequence */\n94\t            return validate_sequence(decision_string, length);\n95\t        }\n96\t        \n97\t        default:\n98\t            return -3;\n99\t    }\n100\t}\n101\t\n102\t/**\n103\t * Parse character to boolean\n104\t * 'y' or 'Y' -> true\n105\t * 'n' or 'N' -> false\n106\t * anything else -> false\n107\t */\n108\tstatic bool parse_bool(char c) {\n109\t    if (c == 'y' || c == 'Y') {\n110\t        return true;\n111\t    } else if (c == 'n' || c == 'N') {\n112\t        return false;\n113\t    }\n114\t    return false;  /* Default to false for invalid input */\n115\t}\n116\t\n117\t/**\n118\t * Apply permissions based on read/write/execute flags\n119\t * Complex branching based on boolean combinations\n120\t */\n121\tstatic int apply_permissions(bool read, bool write, bool execute) {\n122\t    int permission_value = 0;\n123\t    \n124\t    /* Base permission calculation */\n125\t    if (read) {\n126\t        permission_value += 4;\n127\t    }\n128\t    if (write) {\n129\t        permission_value += 2;\n130\t    }\n131\t    if (execute) {\n132\t        permission_value += 1;\n133\t    }\n134\t    \n135\t    /* Complex decision tree based on combinations */\n136\t    if (read && write && execute) {\n137\t        /* Full permissions - special handling */\n138\t        return 100 + permission_value;  /* 107 */\n139\t    } else if (read && write) {\n140\t        /* Read/write but no execute */\n141\t        if (permission_value == 6) {\n142\t            return 50 + permission_value;  /* 56 */\n143\t        }\n144\t    } else if (read && execute) {\n145\t        /* Read/execute but no write */\n146\t        return 30 + permission_value;  /* 35 */\n147\t    } else if (write && execute) {\n148\t        /* Write/execute but