{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AtbewvGQqTb8WHqgsDkdEt","type":"tool_result","content":"1\tuse std::io::{self, Read, Write};\n2\t\n3\tconst MAX_NAME_LENGTH: usize = 64;\n4\tconst MAX_CATEGORY_LENGTH: usize = 32;\n5\t\n6\t#[derive(Clone)]\n7\tstruct Item {\n8\t    id: i32,\n9\t    name: Vec<u8>,     // null-terminated, fixed length MAX_NAME_LENGTH\n10\t    category: Vec<u8>, // null-terminated, fixed length MAX_CATEGORY_LENGTH\n11\t    price: f64,\n12\t    quantity: i32,\n13\t}\n14\t\n15\t#[derive(Clone)]\n16\tstruct Order {\n17\t    customer_id: i32,\n18\t    customer_name: Vec<u8>, // null-terminated, fixed length MAX_NAME_LENGTH\n19\t    total_amount: f64,\n20\t}\n21\t\n22\t// ----- Helpers to mimic C strncpy + null-termination semantics -----\n23\t\n24\tfn copy_c_string(dst_len: usize, src: &str) -> Vec<u8> {\n25\t    let mut buf = vec![0u8; dst_len];\n26\t    let src_bytes = src.as_bytes();\n27\t    let copy_len = src_bytes.len().min(dst_len - 1);\n28\t    buf[..copy_len].copy_from_slice(&src_bytes[..copy_len]);\n29\t    // ensure final byte is 0\n30\t    buf[dst_len - 1] = 0;\n31\t    buf\n32\t}\n33\t\n34\tfn cstr_as_str(buf: &[u8]) -> &str {\n35\t    let end = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());\n36\t    // safe because we constructed strings from valid UTF-8\n37\t    std::str::from_utf8(&buf[..end]).unwrap_or(\"\")\n38\t}\n39\t\n40\tfn create_item(id: i32, name: &str, category: &str, price: f64, quantity: i32) -> Item {\n41\t    Item {\n42\t        id,\n43\t        name: copy_c_string(MAX_NAME_LENGTH, name),\n44\t        category: copy_c_string(MAX_CATEGORY_LENGTH, category),\n45\t        price,\n46\t        quantity,\n47\t    }\n48\t}\n49\t\n50\tfn create_order(customer_id: i32, customer_name: &str, total_amount: f64) -> Order {\n51\t    Order {\n52\t        customer_id,\n53\t        customer_name: copy_c_string(MAX_NAME_LENGTH, customer_name),\n54\t        total_amount,\n55\t    }\n56\t}\n57\t\n58\tfn print_item(out: &mut dyn Write, item: &Item) {\n59\t    let _ = writeln!(out, \"  [{}] {}\", item.id, cstr_as_str(&item.name));\n60\t    let _ = writeln!(out, \"      Category: {}\", cstr_as_str(&item.category));\n61\t    let _ = writeln!(out, \"      Price: ${:.2}\", item.price);\n62\t    let _ = writeln!(out, \"      Quantity: {}\", item.quantity);\n63\t}\n64\t\n65\tfn print_order(out: &mut dyn Write, order: &Order) {\n66\t    let _ = writeln!(\n67\t        out,\n68\t        \"  Order - Customer ID: {}, Name: {}\",\n69\t        order.customer_id,\n70\t        cstr_as_str(&order.customer_name)\n71\t    );\n72\t    let _ = writeln!(out, \"          Total: ${:.2}\", order.total_amount);\n73\t}\n74\t\n75\tfn calculate_inventory_stats(out: &mut dyn Write, items: &[Item]) {\n76\t    if items.is_empty() {\n77\t        let _ = writeln!(out, \"No items in inventory\");\n78\t        return;\n79\t    }\n80\t\n81\t    let _ = writeln!(out, \"\\n=== Inventory Statistics (Array) ===\");\n82\t\n83\t    let mut total_value: f64 = 0.0;\n84\t    let mut total_items: i32 = 0;\n85\t    let mut max_price: f64 = 0.0;\n86\t    let mut min_price: f64 = items[0].price;\n87\t\n88\t    for item in items {\n89\t        total_value += item.price * item.quantity as f64;\n90\t        total_items = total_items.wrapping_add(item.quantity);\n91\t        if item.price > max_price {\n92\t            max_price = item.price;\n93\t        }\n94\t        if item.price < min_price {\n95\t            min_price = item.price;\n96\t        }\n97\t    }\n98\t\n99\t    let _ = writeln!(out, \"Total unique items: {}\", items.len());\n100\t    let _ = writeln!(out, \"Total item count: {}\", total_items);\n101\t    let _ = writeln!(out, \"Total inventory value: ${:.2}\", total_value);\n102\t    // C: total_value / total_items where total_items is int -> int converted to double\n103\t    let _ = writeln!(\n104\t        out,\n105\t        \"Average item price: ${:.2}\",\n106\t        total_value / total_items as f64\n107\t    );\n108\t    let _ = writeln!(out, \"Most expensive item: ${:.2}\", max_price);\n109\t    let _ = writeln!(out, \"Least expensive item: ${:.2}\", min_price);\n110\t}\n111\t\n112\tfn calculate_order_stats(out: &mut dyn Write, orders: &[Order]) {\n113\t    if orders.is_empty() {\n114\t        let _ = writeln!(out, \"No orders to analyze\");\n115\t        return;\n116\t    }\n117\t\n118\t    let _ = writeln!(out, \"\\n=== Order Statistics (List) ===\");\n119\t\n120\t    let mut total_revenue: f64 = 0.0;\n121\t    let mut max_order: f64 = 0.0;\n122\t    let mut min_order: f64 = -1.0;\n123\t\n124\t    for order in orders {\n125\t        total_revenue += order.total_amount;\n126\t        if order.total_amount > max_order {\n127\t            max_order = order.total_amount;\n128\t        }\n129\t        if min_order < 0.0 || order.total_amount < min_order {\n130\t            min_order = order.total_amount;\n131\t        }\n132\t    }\n133\t\n134\t    let _ = writeln!(out, \"Total orders: {}\", orders.len());\n135\t    let _ = writeln!(out, \"Total revenue: ${:.2}\", total_revenue);\n136\t    // In C: total_revenue / orders->size where orders->size is size_t.\n137\t    // double / size_t -> double; we use f64 division.\n138\t    let _ = writeln!(\n139\t        out,\n140\t        \"Average order value: ${:.2}\",\n141\t        total_revenue / orders.len() as f64\n142\t    );\n143\t    let _ = writeln!(out, \"Largest order: ${:.2}\", max_order);\n144\t    let _ = writeln!(out, \"Smallest order: ${:.2}\", min_order);\n145\t}\n146\t\n147\tfn find_items_by_category(out: &mut dyn Write, items: &[Item], category: &str) {\n148\t    let _ = writeln!(out, \"\\n=== Items in category '{}' ===\", category);\n149\t\n150\t    let mut found: i32 = 0;\n151\t    for item in items {\n152\t        if cstr_as_str(&item.category) == category {\n153\t            print_item(out, item);\n154\t            found += 1;\n155\t        }\n156\t    }\n157\t\n158\t    if found == 0 {\n159\t        let _ = writeln!(out, \"No items found in this category\");\n160\t    } else {\n161\t        let _ = writeln!(out, \"Found {} items\", found);\n162\t    }\n163\t}\n164\t\n165\t#[allow(dead_code)]\n166\tfn find_expensive_items(out: &mut dyn Write, items: &[Item], min_price: f64) {\n167\t    let _ = writeln!(out, \"\\n=== Items priced above ${:.2} ===\", min_price);\n168\t\n169\t    let mut found: i32 = 0;\n170\t    for item in items {\n171\t        if item.price >= min_price {\n172\t            print_item(out, item);\n173\t            found += 1;\n174\t        }\n175\t    }\n176\t\n177\t    if found == 0 {\n178\t        let _ = writeln!(out, \"No items found above this price\");\n179\t    } else {\n180\t        let _ = writeln!(out, \"Found {} items\", found);\n181\t    }\n182\t}\n183\t\n184\t// ============================================================================\n185\t// Demos\n186\t// ============================================================================\n187\t\n188\tfn print_menu(out: &mut dyn Write) {\n189\t    let _ = writeln!(out);\n190\t    let _ = writeln!(out, \"========================================\");\n191\t    let _ = writeln!(out, \"  GENERIC FOR_EACH MACRO DEMO\");\n192\t    let _ = writeln!(out, \"========================================\");\n193\t    let _ = writeln!(out, \"1. Demo: Integer Containers\");\n194\t    let _ = writeln!(out, \"2. Demo: Double Containers\");\n195\t    let _ = writeln!(out, \"3. Demo: Inventory Array\");\n196\t    let _ = writeln!(out, \"4. Demo: Order List\");\n197\t    let _ = writeln!(out, \"5. Demo: Mixed Operations\");\n198\t    let _ = writeln!(out, \"6. Run All Demos\");\n199\t    let _ = writeln!(out, \"7. Exit\");\n200\t    let _ = writeln!(out, \"========================================\");\n201\t    let _ = write!(out, \"Choice: \");\n202\t    let _ = out.flush();\n203\t}\n204\t\n205\tfn demo_integer_containers(out: &mut dyn Write) {\n206\t    let _ = writeln!(out);\n207\t    let _ = writeln!(out, \"========================================\");\n208\t    let _ = writeln!(out, \"  DEMO 1: Integer Containers\");\n209\t    let _ = writeln!(out, \"========================================\");\n210\t\n211\t    let mut int_array: Vec<i32> = Vec::with_capacity(10);\n212\t    let _ = writeln!(out, \"\\n--- Integer Array ---\");\n213\t    let _ = writeln!(out, \"Adding integers: 10, 20, 30, 40, 50\");\n214\t    int_array.push(10);\n215\t    int_array.push(20);\n216\t    int_array.push(30);\n217\t    int_array.push(40);\n218\t    int_array.push(50);\n219\t\n220\t    let _ = write!(out, \"Array contents: \");\n221\t    for &val in &int_array {\n222\t        let _ = write!(out, \"{} \", val);\n223\t    }\n224\t    let _ = writeln!(out);\n225\t\n226\t    let mut sum: i32 = 0;\n227\t    for &val in &int_array {\n228\t        sum = sum.wrapping_add(val);\n229\t    }\n230\t    let _ = writeln!(out, \"Sum: {}\", sum);\n231\t    let _ = writeln!(\n232\t        out,\n233\t        \"Average: {:.2}\",\n234\t        (sum as f64) / (int_array.len() as f64)\n235\t    );\n236\t\n237\t    let mut int_list: Vec<i32> = Vec::new();\n238\t    let _ = writeln!(out, \"\\n--- Integer List ---\");\n239\t    let _ = writeln!(out, \"Adding integers: 100, 200, 300, 400, 500\");\n240\t    int_list.push(100);\n241\t    int_list.push(200);\n242\t    int_list.push(300);\n243\t    int_list.push(400);\n244\t    int_list.push(500);\n245\t\n246\t    let _ = write!(out, \"List contents: \");\n247\t    for &val in &int_list {\n248\t        let _ = write!(out, \"{} \", val);\n249\t    }\n250\t    let _ = writeln!(out);\n251\t\n252\t    let mut product: i64 = 1;\n253\t    for &val in &int_list {\n254\t        product = product.wrapping_mul(val as i64);\n255\t    }\n256\t    let _ = writeln!(out, \"Product: {}\", product);\n257\t}\n258\t\n259\tfn demo_double_containers(out: &mut dyn Write) {\n260\t    let _ = writeln!(out);\n261\t    let _ = writeln!(out, \"========================================\");\n262\t    let _ = writeln!(out, \"  DEMO 2: Double Containers\");\n263\t    let _ = writeln!(out, \"========================================\");\n264\t\n265\t    let mut double_array: Vec<f64> = Vec::with_capacity(5);\n266\t    let _ = writeln!(out, \"\\n--- Double Array (Temperatures in Celsius) ---\");\n267\t\n268\t    let temps: [f64; 7] = [23.5, 25.0, 22.8, 26.3, 24.1, 21.9, 27.5];\n269\t\n270\t    let _ = write!(out, \"Adding temperatures: \");\n271\t    for &t in &temps {\n272\t        double_array.push(t);\n273\t        let _ = write!(out, \"{:.1} \", t);\n274\t    }\n275\t    let _ = writeln!(out);\n276\t\n277\t    let mut min_temp = temps[0];\n278\t    let mut max_temp = temps[0];\n279\t    let mut sum_temp = 0.0_f64;\n280\t\n281\t    for &temp in &double_array {\n282\t        if temp < min_temp {\n283\t            min_temp = temp;\n284\t        }\n285\t        if temp > max_temp {\n286\t            max_temp = temp;\n287\t        }\n288\t        sum_temp += temp;\n289\t    }\n290\t\n291\t    let _ = writeln!(out, \"Minimum: {:.1}\\u{00B0}C\", min_temp);\n292\t    let _ = writeln!(out, \"Maximum: {:.1}\\u{00B0}C\", max_temp);\n293\t    let _ = writeln!(\n294\t        out,\n295\t        \"Average: {:.1}\\u{00B0}C\",\n296\t        sum_temp / (double_array.len() as f64)\n297\t    );\n298\t\n299\t    let mut price_list: Vec<f64> = Vec::new();\n300\t    let _ = writeln!(out, \"\\n--- Double List (Product Prices) ---\");\n301\t\n302\t    let prices: [f64; 6] = [9.99, 14.50, 7.25, 22.00, 5.99, 18.75];\n303\t\n304\t    let _ = write!(out, \"Adding prices: \");\n305\t    for &p in &prices {\n306\t        price_list.push(p);\n307\t        let _ = write!(out, \"${:.2} \", p);\n308\t    }\n309\t    let _ = writeln!(out);\n310\t\n311\t    let mut total = 0.0_f64;\n312\t    let mut count_under_10: i32 = 0;\n313\t    for &temp in &price_list {\n314\t        total += temp;\n315\t        if temp < 10.0 {\n316\t            count_under_10 += 1;\n317\t        }\n318\t    }\n319\t\n320\t    let _ = writeln!(out, \"Total cost: ${:.2}\", total);\n321\t    let _ = writeln!(out, \"Items under $10: {}\", count_under_10);\n322\t}\n323\t\n324\tfn demo_inventory_array(out: &mut dyn Write) {\n325\t    let _ = writeln!(out);\n326\t    let _ = writeln!(out, \"========================================\");\n327\t    let _ = writeln!(out, \"  DEMO 3: Inventory Array (Items)\");\n328\t    let _ = writeln!(out, \"========================================\");\n329\t\n330\t    let mut inventory: Vec<Item> = Vec::with_capacity(20);\n331\t\n332\t    let _ = writeln!(out, \"\\n--- Adding Items to Inventory ---\");\n333\t    inventory.push(create_item(1, \"Laptop\", \"Electronics\", 899.99, 15));\n334\t    inventory.push(create_item(2, \"Mouse\", \"Electronics\", 24.99, 50));\n335\t    inventory.push(create_item(3, \"Keyboard\", \"Electronics\", 79.99, 30));\n336\t    inventory.push(create_item(4, \"Monitor\", \"Electronics\", 299.99, 20));\n337\t    inventory.push(create_item(5, \"Desk Chair\", \"Furniture\", 199.99, 10));\n338\t    inventory.push(create_item(6, \"Desk\", \"Furniture\", 349.99, 8));\n339\t    inventory.push(create_item(7, \"Notebook\", \"Office\", 4.99, 100));\n340\t    inventory.push(create_item(8, \"Pen Set\", \"Office\", 12.99, 75));\n341\t    inventory.push(create_item(9, \"USB Cable\", \"Electronics\", 9.99, 60));\n342\t    inventory.push(create_item(10, \"Bookshelf\", \"Furniture\", 149.99, 12));\n343\t\n344\t    let _ = writeln!(out, \"Added {} items to inventory\", inventory.len());\n345\t\n346\t    let _ = writeln!(out, \"\\n--- All Inventory Items ---\");\n347\t    for item in &inventory {\n348\t        print_item(out, item);\n349\t        let _ = writeln!(out);\n350\t    }\n351\t\n352\t    calculate_inventory_stats(out, &inventory);\n353\t\n354\t    find_items_by_category(out, &inventory, \"Electronics\");\n355\t    find_items_by_category(out, &inventory, \"Furniture\");\n356\t\n357\t    let _ = writeln!(out, \"\\n--- Low Stock Items (< 20) ---\");\n358\t    let mut low_stock_count: i32 = 0;\n359\t    for item in &inventory {\n360\t        if item.quantity < 20 {\n361\t            print_item(out, item);\n362\t            low_stock_count += 1;\n363\t        }\n364\t    }\n365\t    let _ = writeln!(out, \"Total low stock items: {}\", low_stock_count);\n366\t}\n367\t\n368\tfn demo_order_list(out: &mut dyn Write) {\n369\t    let _ = writeln!(out);\n370\t    let _ = writeln!(out, \"========================================\");\n371\t    let _ = writeln!(out, \"  DEMO 4: Order List (Orders)\");\n372\t    let _ = writeln!(out, \"========================================\");\n373\t\n374\t    let mut orders: Vec<Order> = Vec::new();\n375\t\n376\t    let _ = writeln!(out, \"\\n--- Adding Orders ---\");\n377\t    orders.push(create_order(1001, \"Alice Johnson\", 1249.95));\n378\t    orders.push(create_order(1002, \"Bob Smith\", 89.99));\n379\t    orders.push(create_order(1003, \"Carol White\", 549.98));\n380\t    orders.push(create_order(1004, \"David Brown\", 24.99));\n381\t    orders.push(create_order(1005, \"Eve Davis\", 899.99));\n382\t    orders.push(create_order(1006, \"Frank Miller\", 374.97));\n383\t    orders.push(create_order(1007, \"Grace Lee\", 159.98));\n384\t    orders.push(create_order(1008, \"Henry Wilson\", 1099.99));\n385\t\n386\t    let _ = writeln!(out, \"Added {} orders\", orders.len());\n387\t\n388\t    let _ = writeln!(out, \"\\n--- All Orders ---\");\n389\t    for order in &orders {\n390\t        print_order(out, order);\n391\t    }\n392\t\n393\t    calculate_order_stats(out, &orders);\n394\t\n395\t    let _ = writeln!(out, \"\\n--- Large Orders (> $500) ---\");\n396\t    let mut large_order_count: i32 = 0;\n397\t    let mut large_order_total: f64 = 0.0;\n398\t\n399\t    for order in &orders {\n400\t        if order.total_amount > 500.0 {\n401\t            print_order(out, order);\n402\t            large_order_count += 1;\n403\t            large_order_total += order.total_amount;\n404\t        }\n405\t    }\n406\t\n407\t    let _ = writeln!(out, \"Total large orders: {}\", large_order_count);\n408\t    let _ = writeln!(out, \"Revenue from large orders: ${:.2}\", large_order_total);\n409\t}\n410\t\n411\tfn demo_mixed_operations(out: &mut dyn Write) {\n412\t    let _ = writeln!(out);\n413\t    let _ = writeln!(out, \"========================================\");\n414\t    let _ = writeln!(out, \"  DEMO 5: Mixed Operations\");\n415\t    let _ = writeln!(out, \"========================================\");\n416\t\n417\t    let mut array_inventory: Vec<Item> = Vec::with_capacity(10);\n418\t    let mut list_inventory: Vec<Item> = Vec::new();\n419\t\n420\t    let _ = writeln!(out, \"\\n--- Populating both Array and List ---\");\n421\t\n422\t    let items = [\n423\t        create_item(1, \"Smartphone\", \"Electronics\", 699.99, 25),\n424\t        create_item(2, \"Tablet\", \"Electronics\", 449.99, 18),\n425\t        create_item(3, \"Headphones\", \"Electronics\", 149.99, 40),\n426\t        create_item(4, \"Smart Watch\", \"Electronics\", 299.99, 22),\n427\t        create_item(5, \"Power Bank\", \"Electronics\", 39.99, 55),\n428\t    ];\n429\t\n430\t    let num_items: i32 = items.len() as i32;\n431\t\n432\t    for it in &items {\n433\t        array_inventory.push(it.clone());\n434\t        list_inventory.push(it.clone());\n435\t    }\n436\t\n437\t    let _ = writeln!(out, \"Added {} items to both containers\", num_items);\n438\t\n439\t    let _ = writeln!(out, \"\\n--- Iterating through Array ---\");\n440\t    let mut array_count: i32 = 0;\n441\t    for _ in &array_inventory {\n442\t        array_count += 1;\n443\t    }\n444\t    let _ = writeln!(out, \"Array iteration count: {}\", array_count);\n445\t\n446\t    let _ = writeln!(out, \"\\n--- Iterating through List ---\");\n447\t    let mut list_count: i32 = 0;\n448\t    for _ in &list_inventory {\n449\t        list_count += 1;\n450\t    }\n451\t    let _ = writeln!(out, \"List iteration count: {}\", list_count);\n452\t\n453\t    let price_threshold: f64 = 200.0;\n454\t\n455\t    let _ = writeln!(out, \"\\n--- Items above ${:.2} (Array) ---\", price_threshold);\n456\t    for item in &array_inventory {\n457\t        if item.price >= price_threshold {\n458\t            let _ = writeln!(out, \"  {}: ${:.2}\", cstr_as_str(&item.name), item.price);\n459\t        }\n460\t    }\n461\t\n462\t    let _ = writeln!(out, \"\\n--- Items above ${:.2} (List) ---\", price_threshold);\n463\t    for item in &list_inventory {\n464\t        if item.price >= price_threshold {\n465\t            let _ = writeln!(out, \"  {}: ${:.2}\", cstr_as_str(&item.name), item.price);\n466\t        }\n467\t    }\n468\t}\n469\t\n470\t// ----- fgets / sscanf %d emulation -----\n471\t\n472\t/// Mimic C's fgets(buf, size, stdin):\n473\t/// reads up to `size - 1` bytes from stdin into `buf`, stopping when a newline\n474\t/// is read (newline is included). Returns false on EOF with no bytes read.\n475\tfn fgets_like(reader: &mut dyn Read, size: usize) -> Option<Vec<u8>> {\n476\t    if size <= 1 {\n477\t        return Some(Vec::new());\n478\t    }\n479\t    let max_chars = size - 1;\n480\t    let mut buf: Vec<u8> = Vec::new();\n481\t    let mut single = [0u8; 1];\n482\t    loop {\n483\t        if buf.len() >= max_chars {\n484\t            break;\n485\t        }\n486\t        match reader.read(&mut single) {\n487\t            Ok(0) => {\n488\t                if buf.is_empty() {\n489\t                    return None;\n490\t                }\n491\t                break;\n492\t            }\n493\t            Ok(_) => {\n494\t                buf.push(single[0]);\n495\t                if single[0] == b'\\n' {\n496\t                    break;\n497\t                }\n498\t            }\n499\t            Err(_) => {\n500\t                if buf.is_empty() {\n501\t                    return None;\n502\t                }\n503\t                break;\n504\t            }\n505\t        }\n506\t    }\n507\t    Some(buf)\n508\t}\n509\t\n510\t/// Mimic C's sscanf(input, \"%d\", &choice). Returns Some(int) if parse succeeds.\n511\tfn sscanf_d(input: &[u8]) -> Option<i32> {\n512\t    let mut i = 0;\n513\t    // Skip whitespace per C's isspace\n514\t    while i < input.len() && is_c_space(input[i]) {\n515\t        i += 1;\n516\t    }\n517\t    let mut sign: i32 = 1;\n518\t    if i < input.len() && (input[i] == b'+' || input[i] == b'-') {\n519\t        if input[i] == b'-' {\n520\t            sign = -1;\n521\t        }\n522\t        i += 1;\n523\t    }\n524\t    let start = i;\n525\t    let mut value: i64 = 0;\n526\t    while i < input.len() && input[i].is_ascii_digit() {\n527\t        value = value\n528\t            .wrapping_mul(10)\n529\t            .wrapping_add((input[i] - b'0') as i64);\n530\t        i += 1;\n531\t    }\n532\t    if i == start {\n533\t        return None;\n534\t    }\n535\t    let signed = (sign as i64).wrapping_mul(value);\n536\t    // C %d into int: truncate to 32-bit\n537\t    Some(signed as i32)\n538\t}\n539\t\n540\tfn is_c_space(b: u8) -> bool {\n541\t    matches!(b, b' ' | b'\\t' | b'\\n' | b'\\x0b' | b'\\x0c' | b'\\r')\n542\t}\n543\t\n544\tfn main() {\n545\t    let stdout = io::stdout();\n546\t    let mut stdout_lock = stdout.lock();\n547\t    let stdin = io::stdin();\n548\t    let mut stdin_lock = stdin.lock();\n549\t\n550\t    {\n551\t        let out = &mut stdout_lock;\n552\t        let _ = writeln!(out, \"\\u{2554}{}\\u{2557}\", \"\\u{2550}\".repeat(40));\n553\t        let _ = writeln!(\n554\t            out,\n555\t            \"\\u{2551}   GENERIC FOR_EACH MACRO DEMO         \\u{2551}\"\n556\t        );\n557\t        let _ = writeln!(\n558\t            out,\n559\t            \"\\u{2551}   Demonstrating Generic Containers    \\u{2551}\"\n560\t        );\n561\t        let _ = writeln!(out, \"\\u{255A}{}\\u{255D}\", \"\\u{2550}\".repeat(40));\n562\t    }\n563\t\n564\t    loop {\n565\t        print_menu(&mut stdout_lock);\n566\t\n567\t        let line = match fgets_like(&mut stdin_lock, 256) {\n568\t            Some(l) => l,\n569\t            None => break,\n570\t        };\n571\t\n572\t        let choice = match sscanf_d(&line) {\n573\t            Some(c) => c,\n574\t            None => {\n575\t                let _ = writeln!(&mut stdout_lock, \"Invalid input\");\n576\t                continue;\n577\t            }\n578\t        };\n579\t\n580\t        match choice {\n581\t            1 => demo_integer_containers(&mut stdout_lock),\n582\t            2 => demo_double_containers(&mut stdout_lock),\n583\t            3 => demo_inventory_array(&mut stdout_lock),\n584\t            4 => demo_order_list(&mut stdout_lock),\n585\t            5 => demo_mixed_operations(&mut stdout_lock),\n586\t            6 => {\n587\t                let _ = writeln!(&mut stdout_lock, \"\\n=== Running All Demos ===\");\n588\t                demo_integer_containers(&mut stdout_lock);\n589\t                demo_double_containers(&mut stdout_lock);\n590\t                demo_inventory_array(&mut stdout_lock);\n591\t                demo_order_list(&mut stdout_lock);\n592\t                demo_mixed_operations(&mut stdout_lock);\n593\t                let _ = writeln!(&mut stdout_lock, \"\\n========================================\");\n594\t                let _ = writeln!(&mut stdout_lock, \"  All demos completed successfully!\");\n595\t                let _ = writeln!(&mut stdout_lock, \"========================================\");\n596\t            }\n597\t            7 => {\n598\t                let _ = writeln!(&mut stdout_lock, \"\\nGoodbye!\");\n599\t                return;\n600\t            }\n601\t            _ => {\n602\t                let _ = writeln!(&mut stdout_lock, \"Invalid choice\");\n603\t            }\n604\t        }\n605\t    }\n606\t}\n607\t"}]},"parent_tool_use_id":null,"session_id":"3a2bb0ef-7d05-45bf-b9d1-b4aaf6cce70c","uuid":"dacb50c1-08e5-4151-8999-831a41369b21","timestamp":"2026-06-09T02:51:55.012Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-work-HfXxj2/translated_rust/src/main.rs","content":"use std::io::{self, Read, Write};\n\nconst MAX_NAME_LENGTH: usize = 64;\nconst MAX_CATEGORY_LENGTH: usize = 32;\n\n#[derive(Clone)]\nstruct Item {\n    id: i32,\n    name: Vec<u8>,     // null-terminated, fixed length MAX_NAME_LENGTH\n    category: Vec<u8>, // null-terminated, fixed length MAX_CATEGORY_LENGTH\n    price: f64,\n    quantity: i32,\n}\n\n#[derive(Clone)]\nstruct Order {\n    customer_id: i32,\n    customer_name: Vec<u8>, // null-terminated, fixed length MAX_NAME_LENGTH\n    total_amount: f64,\n}\n\n// ----- Helpers to mimic C strncpy + null-termination semantics -----\n\nfn copy_c_string(dst_len: usize, src: &str) -> Vec<u8> {\n    let mut buf = vec![0u8; dst_len];\n    let src_bytes = src.as_bytes();\n    let copy_len = src_bytes.len().min(dst_len - 1);\n    buf[..copy_len].copy_from_slice(&src_bytes[..copy_len]);\n    // ensure final byte is 0\n    buf[dst_len - 1] = 0;\n    buf\n}\n\nfn cstr_as_str(buf: &[u8]) -> &str {\n    let end = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());\n    // safe because we constructed strings from valid UTF-8\n    std::str::from_utf8(&buf[..end]).unwrap_or(\"\")\n}\n\nfn create_item(id: i32, name: &str, category: &str, price: f64, quantity: i32) -> Item {\n    Item {\n        id,\n        name: copy_c_string(MAX_NAME_LENGTH, name),\n        category: copy_c_string(MAX_CATEGORY_LENGTH, category),\n        price,\n        quantity,\n    }\n}\n\nfn create_order(customer_id: i32, customer_name: &str, total_amount: f64) -> Order {\n    Order {\n        customer_id,\n        customer_name: copy_c_string(MAX_NAME_LENGTH, customer_name),\n        total_amount,\n    }\n}\n\nfn print_item(out: &mut dyn Write, item: &Item) {\n    let _ = writeln!(out, \"  [{}] {}\", item.id, cstr_as_str(&item.name));\n    let _ = writeln!(out, \"      Category: {}\", cstr_as_str(&item.category));\n    let _ = writeln!(out, \"      Price: ${:.2}\", item.price);\n    let _ = writeln!(out, \"      Quantity: {}\", item.quantity);\n}\n\nfn print_order(out: &mut dyn Write, order: &Order) {\n    let _ = writeln!(\n        out,\n        \"  Order - Customer ID: {}, Name: {}\",\n        order.customer_id,\n        cstr_as_str(&order.customer_name)\n    );\n    let _ = writeln!(out, \"          Total: ${:.2}\", order.total_amount);\n}\n\nfn calculate_inventory_stats(out: &mut dyn Write, items: &[Item]) {\n    if items.is_empty() {\n        let _ = writeln!(out, \"No items in inventory\");\n        return;\n    }\n\n    let _ = writeln!(out, \"\\n=== Inventory Statistics (Array) ===\");\n\n    let mut total_value: f64 = 0.0;\n    let mut total_items: i32 = 0;\n    let mut max_price: f64 = 0.0;\n    let mut min_price: f64 = items[0].price;\n\n    for item in items {\n        total_value += item.price * item.quantity as f64;\n        total_items = total_items.wrapping_add(item.quantity);\n        if item.price > max_price {\n            max_price = item.price;\n        }\n        if item.price < min_price {\n            min_price = item.price;\n        }\n    }\n\n    let _ = writeln!(out, \"Total unique items: {}\", items.len());\n    let _ = writeln!(out, \"Total item count: {}\", total_items);\n    let _ = writeln!(out, \"Total inventory value: ${:.2}\", total_value);\n    // C: total_value / total_items where total_items is int -> int converted to double\n    let _ = writeln!(\n        out,\n        \"Average item price: ${:.2}\",\n        total_value / total_items as f64\n    );\n    let _ = writeln!(out, \"Most expensive item: ${:.2}\", max_price);\n    let _ = writeln!(out, \"Least expensive item: ${:.2}\", min_price);\n}\n\nfn calculate_order_stats(out: &mut dyn Write, orders: &[Order]) {\n    if orders.is_empty() {\n        let _ = writeln!(out, \"No orders to analyze\");\n        return;\n    }\n\n    let _ = writeln!(out, \"\\n=== Order Statistics (List) ===\");\n\n    let mut total_revenue: f64 = 0.0;\n    let mut max_order: f64 = 0.0;\n    let mut min_order: f64 = -1.0;\n\n    for order in orders {\n        total_revenue += order.total_amount;\n        if order.total_amount > max_order {\n            max_order = order.total_amount;\n        }\n        if min_order < 0.0 || order.total_amount < min_order {\n            min_order = order.total_amount;\n        }\n    }\n\n    let _ = writeln!(out, \"Total orders: {}\", orders.len());\n    let _ = writeln!(out, \"Total revenue: ${:.2}\", total_revenue);\n    // In C: total_revenue / orders->size where orders->size is size_t.\n    // double / size_t -> double; we use f64 division.\n    let _ = writeln!(\n        out,\n        \"Average order value: ${:.2}\",\n        total_revenue / orders.len() as f64\n    );\n    let _ = writeln!(out, \"Largest order: ${:.2}\", max_order);\n    let _ = writeln!(out, \"Smallest order: ${:.2}\", min_order);\n}\n\nfn find_items_by_category(out: &mut dyn Write, items: &[Item], category: &str) {\n    let _ = writeln!(out, \"\\n=== Items in category '{}' ===\", category);\n\n    let mut found: i32 = 0;\n    for item in items {\n        if cstr_as_str(&item.category) == category {\n            print_item(out, item);\n            found += 1;\n        }\n    }\n\n    if found == 0 {\n        let _ = writeln!(out, \"No items found in this category\");\n    } else {\n        let _ = writeln!(out, \"Found {} items\", found);\n    }\n}\n\n#[allow(dead_code)]\nfn find_expensive_items(out: &mut dyn Write, items: &[Item], min_price: f64) {\n    let _ = writeln!(out, \"\\n=== Items priced above ${:.2} ===\", min_price);\n\n    let mut found: i32 = 0;\n    for item in items {\n        if item.price >= min_price {\n            print_item(out, item);\n            found += 1;\n        }\n    }\n\n    if found == 0 {\n        let _ = writeln!(out, \"No items found above this price\");\n    } else {\n        let _ = writeln!(out, \"Found {} items\", found);\n    }\n}\n\n// ============================================================================\n// Demos\n// ============================================================================\n\nfn print_menu(out: &mut dyn Write) {\n    let _ = writeln!(out);\n    let _ = writeln!(out, \"========================================\");\n    let _ = writeln!(out, \"  GENERIC FOR_EACH MACRO DEMO\");\n    let _ = writeln!(out, \"========================================\");\n    let _ = writeln!(out, \"1. Demo: Integer Containers\");\n    let _ = writeln!(out, \"2. Demo: Double Containers\");\n    let _ = writeln!(out, \"3. Demo: Inventory Array\");\n    let _ = writeln!(out, \"4. Demo: Order List\");\n    let _ = writeln!(out, \"5. Demo: Mixed Operations\");\n    let _ = writeln!(out, \"6. Run All Demos\");\n    let _ = writeln!(out, \"7. Exit\");\n    let _ = writeln!(out, \"========================================\");\n    let _ = write!(out, \"Choice: \");\n    let _ = out.flush();\n}\n\nfn demo_integer_containers(out: &mut dyn Write) {\n    let _ = writeln!(out);\n    let _ = writeln!(out, \"========================================\");\n    let _ = writeln!(out, \"  DEMO 1: Integer Containers\");\n    let _ = writeln!(out, \"========================================\");\n\n    let mut int_array: Vec<i32> = Vec::with_capacity(10);\n    let _ = writeln!(out, \"\\n--- Integer Array ---\");\n    let _ = writeln!(out, \"Adding integers: 10, 20, 30, 40, 50\");\n    int_array.push(10);\n    int_array.push(20);\n    int_array.push(30);\n    int_array.push(40);\n    int_array.push(50);\n\n    let _ = write!(out, \"Array contents: \");\n    for &val in &int_array {\n        let _ = write!(out, \"{} \", val);\n    }\n    let _ = writeln!(out);\n\n    let mut sum: i32 = 0;\n    for &val in &int_array {\n        sum = sum.wrapping_add(val);\n    }\n    let _ = writeln!(out, \"Sum: {}\", sum);\n    let _ = writeln!(\n        out,\n        \"Average: {:.2}\",\n        (sum as f64) / (int_array.len() as f64)\n    );\n\n    let mut int_list: Vec<i32> = Vec::new();\n    let _ = writeln!(out, \"\\n--- Integer List ---\");\n    let _ = writeln!(out, \"Adding integers: 100, 200, 300, 400, 500\");\n    int_list.push(100);\n    int_list.push(200);\n    int_list.push(300);\n    int_list.push(400);\n    int_list.push(500);\n\n    let _ = write!(out, \"List contents: \");\n    for &val in &int_list {\n        let _ = write!(out, \"{} \", val);\n    }\n    let _ = writeln!(out);\n\n    let mut product: i64 = 1;\n    for &val in &int_list {\n        product = product.wrapping_mul(val as i64);\n    }\n    let _ = writeln!(out, \"Product: {}\", product);\n}\n\nfn demo_double_containers(out: &mut dyn Write) {\n    let _ = writeln!(out);\n    let _ = writeln!(out, \"========================================\");\n    let _ = writeln!(out, \"  DEMO 2: Double Containers\");\n    let _ = writeln!(out, \"========================================\");\n\n    let mut double_array: Vec<f64> = Vec::with_capacity(5);\n    let _ = writeln!(out, \"\\n--- Double Array (Temperatures in Celsius) ---\");\n\n    let temps: [f64; 7] = [23.5, 25.0, 22.8, 26.3, 24.1, 21.9, 27.5];\n\n    let _ = write!(out, \"Adding temperatures: \");\n    for &t in &temps {\n        double_array.push(t);\n        let _ = write!(out, \"{:.1} \", t);\n    }\n    let _ = writeln!(out);\n\n    let mut min_temp = temps[0];\n    let mut max_temp = temps[0];\n    let mut sum_temp = 0.0_f64;\n\n    for &temp in &double_array {\n        if temp < min_temp {\n            min_temp = temp;\n        }\n        if temp > max_temp {\n            max_temp = temp;\n        }\n        sum_temp += temp;\n    }\n\n    let _ = writeln!(out, \"Minimum: {:.1}\\u{00B0}C\", min_temp);\n    let _ = writeln!(out, \"Maximum: {:.1}\\u{00B0}C\", max_temp);\n    let _ = writeln!(\n        out,\n        \"Average: {:.1}\\u{00B0}C\",\n        sum_temp / (double_array.len() as f64)\n    );\n\n    let mut price_list: Vec<f64> = Vec::new();\n    let _ = writeln!(out, \"\\n--- Double List (Product Prices) ---\");\n\n    let prices: [f64; 6] = [9.99, 14.50, 7.25, 22.00, 5.99, 18.75];\n\n    let _ = write!(out, \"Adding prices: \");\n    for &p in &prices {\n        price_list.push(p);\n        let _ = write!(out, \"${:.2} \", p);\n    }\n    let _ = writeln!(out);\n\n    let mut total = 0.0_f64;\n    let mut count_under_10: i32 = 0;\n    for &temp in &price_list {\n        total += temp;\n        if temp < 10.0 {\n            count_under_10 += 1;\n        }\n    }\n\n    let _ = writeln!(out, \"Total cost: ${:.2}\", total);\n    let _ = writeln!(out, \"Items under $10: {}\", count_under_10);\n}\n\nfn demo_inventory_array(out: &mut dyn Write) {\n    let _ = writeln!(out);\n    let _ = writeln!(out, \"========================================\");\n    let _ = writeln!(out, \"  DEMO 3: Inventory Array (Items)\");\n    let _ = writeln!(out, \"========================================\");\n\n    let mut inventory: Vec<Item> = Vec::with_capacity(20);\n\n    let _ = writeln!(out, \"\\n--- Adding Items to Inventory ---\");\n    inventory.push(create_item(1, \"Laptop\", \"Electronics\", 899.99, 15));\n    inventory.push(create_item(2, \"Mouse\", \"Electronics\", 24.99, 50));\n    inventory.push(create_item(3, \"Keyboard\", \"Electronics\", 79.99, 30));\n    inventory.push(create_item(4, \"Monitor\", \"Electronics\", 299.99, 20));\n    inventory.push(create_item(5, \"Desk Chair\", \"Furniture\", 199.99, 10));\n    inventory.push(create_item(6, \"Desk\", \"Furniture\", 349.99, 8));\n    inventory.push(create_item(7, \"Notebook\", \"Office\", 4.99, 100));\n    inventory.push(create_item(8, \"Pen Set\", \"Office\", 12.99, 75));\n    inventory.push(create_item(9, \"USB Cable\", \"Electronics\", 9.99, 60));\n    inventory.push(create_item(10, \"Bookshelf\", \"Furniture\", 149.99, 12));\n\n    let _ = writeln!(out, \"Added {} items to inventory\", inventory.len());\n\n    let _ = writeln!(out, \"\\n--- All Inventory Items ---\");\n    for item in &inventory {\n        print_item(out, item);\n        let _ = writeln!(out);\n    }\n\n    calculate_inventory_stats(out, &inventory);\n\n    find_items_by_category(out, &inventory, \"Electronics\");\n    find_items_by_category(out, &inventory, \"Furniture\");\n\n    let _ = writeln!(out, \"\\n--- Low Stock Items (< 20) ---\");\n    let mut low_stock_count: i32 = 0;\n    for item in &inventory {\n        if item.quantity < 20 {\n            print_item(out, item);\n            low_stock_count += 1;\n        }\n    }\n    let _ = writeln!(out, \"Total low stock items: {}\", low_stock_count);\n}\n\nfn demo_order_list(out: &mut dyn Write) {\n    let _ = writeln!(out);\n    let _ = writeln!(out, \"========================================\");\n    let _ = writeln!(out, \"  DEMO 4: Order List (Orders)\");\n    let _ = writeln!(out, \"========================================\");\n\n    let mut orders: Vec<Order> = Vec::new();\n\n    let _ = writeln!(out, \"\\n--- Adding Orders ---\");\n    orders.push(create_order(1001, \"Alice Johnson\", 1249.95));\n    orders.push(create_order(1002, \"Bob Smith\", 89.99));\n    orders.push(create_order(1003, \"Carol White\", 549.98));\n    orders.push(create_order(1004, \"David Brown\", 24.99));\n    orders.push(create_order(1005, \"Eve Davis\", 899.99));\n    orders.push(create_order(1006, \"Frank Miller\", 374.97));\n    orders.push(create_order(1007, \"Grace Lee\", 159.98));\n    orders.push(create_order(1008, \"Henry Wilson\", 1099.99));\n\n    let _ = writeln!(out, \"Added {} orders\", orders.len());\n\n    let _ = writeln!(out, \"\\n--- All Orders ---\");\n    for order in &orders {\n        print_order(out, order);\n    }\n\n    calculate_order_stats(out, &orders);\n\n    let _ = writeln!(out, \"\\n--- Large Orders (> $500) ---\");\n    let mut large_order_count: i32 = 0;\n    let mut large_order_total: f64 = 0.0;\n\n    for order in &orders {\n        if order.total_amount > 500.0 {\n            print_order(out, order);\n            large_order_count += 1;\n            large_order_total += order.total_amount;\n        }\n    }\n\n    let _ = writeln!(out, \"Total large orders: {}\", large_order_count);\n    let _ = writeln!(out, \"Revenue from large orders: ${:.2}\", large_order_total);\n}\n\nfn demo_mixed_operations(out: &mut dyn Write) {\n    let _ = writeln!(out);\n    let _ = writeln!(out, \"========================================\");\n    let _ = writeln!(out, \"  DEMO 5: Mixed Operations\");\n    let _ = writeln!(out, \"========================================\");\n\n    let mut array_inventory: Vec<Item> = Vec::with_capacity(10);\n    let mut list_inventory: Vec<Item> = Vec::new();\n\n    let _ = writeln!(out, \"\\n--- Populating both Array and List ---\");\n\n    let items = [\n        create_item(1, \"Smartphone\", \"Electronics\", 699.99, 25),\n        create_item(2, \"Tablet\", \"Electronics\", 449.99, 18),\n        create_item(3, \"Headphones\", \"Electronics\", 149.99, 40),\n        create_item(4, \"Smart Watch\", \"Electronics\", 299.99, 22),\n        create_item(5, \"Power Bank\", \"Electronics\", 39.99, 55),\n    ];\n\n    let num_items: i32 = items.len() as i32;\n\n    for it in &items {\n        array_inventory.push(it.clone());\n        list_inventory.push(it.clone());\n    }\n\n    let _ = writeln!(out, \"Added {} items to both containers\", num_items);\n\n    let _ = writeln!(out, \"\\n--- Iterating through Array ---\");\n    let mut array_count: i32 = 0;\n    for _ in &array_inventory {\n        array_count += 1;\n    }\n    let _ = writeln!(out, \"Array iteration count: {}\", array_count);\n\n    let _ = writeln!(out, \"\\n--- Iterating through List ---\");\n    let mut list_count: i32 = 0;\n    for _ in &list_inventory {\n        list_count += 1;\n    }\n    let _ = writeln!(out, \"List iteration count: {}\", list_count);\n\n    let price_threshold: f64 = 200.0;\n\n    let _ = writeln!(out, \"\\n--- Items above ${:.2} (Array) ---\", price_threshold);\n    for item in &array_inventory {\n        if item.price >= price_threshold {\n            let _ = writeln!(out, \"  {}: ${:.2}\", cstr_as_str(&item.name), item.price);\n        }\n    }\n\n    let _ = writeln!(out, \"\\n--- Items above ${:.2} (List) ---\", price_threshold);\n    for item in &list_inventory {\n        if item.price >= price_threshold {\n            let _ = writeln!(out, \"  {}: ${:.2}\", cstr_as_str(&item.name), item.price);\n        }\n    }\n}\n\n// ----- fgets / sscanf %d emulation -----\n\n/// Mimic C's fgets(buf, size, stdin):\n/// reads up to `size - 1` bytes from stdin into `buf`, stopping when a newline\n/// is read (newline is included). Returns false on EOF with no bytes read.\nfn fgets_like(reader: &mut dyn Read, size: usize) -> Option<Vec<u8>> {\n    if size <= 1 {\n        return Some(Vec::new());\n    }\n    let max_chars = size - 1;\n    let mut buf: Vec<u8> = Vec::new();\n    let mut single = [0u8; 1];\n    loop {\n        if buf.len() >= max_chars {\n            break;\n        }\n        match reader.read(&mut single) {\n            Ok(0) => {\n                if buf.is_empty() {\n                    return None;\n                }\n                break;\n            }\n            Ok(_) => {\n                buf.push(single[0]);\n                if single[0] == b'\\n' {\n                    break;\n                }\n            }\n            Err(_) => {\n                if buf.is_empty() {\n                    return None;\n                }\n                break;\n            }\n        }\n    }\n    Some(buf)\n}\n\n/// Mimic C's sscanf(input, \"%d\", &choice). Returns Some(int) if parse succeeds.\nfn sscanf_d(input: &[u8]) -> Option<i32> {\n    let mut i = 0;\n    // Skip whitespace per C's isspace\n    while i < input.len() && is_c_space(input[i]) {\n        i += 1;\n    }\n    let mut sign: i32 = 1;\n    if i < input.len() && (input[i] == b'+' || input[i] == b'-') {\n        if input[i] == b'-' {\n            sign = -1;\n        }\n        i += 1;\n    }\n    let start = i;\n    let mut value: i64 = 0;\n    while i < input.len() && input[i].is_ascii_digit() {\n        value = value\n            .wrapping_mul(10)\n            .wrapping_add((input[i] - b'0') as i64);\n        i += 1;\n    }\n    if i == start {\n        return None;\n    }\n    let signed = (sign as i64).wrapping_mul(value);\n    // C %d into int: truncate to 32-bit\n    Some(signed as i32)\n}\n\nfn is_c_space(b: u8) -> bool {\n    matches!(b, b' ' | b'\\t' | b'\\n' | b'\\x0b' | b'\\x0c' | b'\\r')\n}\n\nfn main() {\n    let stdout = io::stdout();\n    let mut stdout_lock = stdout.lock();\n    let stdin = io::stdin();\n    let mut stdin_lock = stdin.lock();\n\n    {\n        let out = &mut stdout_lock;\n        let _ = writeln!(out, \"\\u{2554}{}\\u{2557}\", \"\\u{2550}\".repeat(40));\n        let _ = writeln!(\n            out,\n            \"\\u{2551}   GENERIC FOR_EACH MACRO DEMO         \\u{2551}\"\n        );\n        let _ = writeln!(\n            out,\n            \"\\u{2551}   Demonstrating Generic Containers    \\u{2551}\"\n        );\n        let _ = writeln!(out, \"\\u{255A}{}\\u{255D}\", \"\\u{2550}\".repeat(40));\n    }\n\n    loop {\n        print_menu(&mut stdout_lock);\n\n        let line = match fgets_like(&mut stdin_lock, 256) {\n            Some(l) => l,\n            None => break,\n        };\n\n        let choice = match sscanf_d(&line) {\n            Some(c) => c,\n            None => {\n                let _ = writeln!(&mut stdout_lock, \"Invalid input\");\n                continue;\n            }\n        };\n\n        match choice {\n            1 => demo_integer_containers(&mut stdout_lock),\n            2 => demo_double_containers(&mut stdout_lock),\n            3 => demo_inventory_array(&mut stdout_lock),\n            4 => demo_order_list(&mut stdout_lock),\n            5 => demo_mixed_operations(&mut stdout_lock),\n            6 => {\n                let _ = writeln!(&mut stdout_lock, \"\\n=== Running All Demos ===\");\n                demo_integer_containers(&mut stdout_lock);\n                demo_double_containers(&mut stdout_lock);\n                demo_inventory_array(&mut stdout_lock);\n                demo_order_list(&mut stdout_lock);\n                demo_mixed_operations(&mut stdout_lock);\n                let _ = writeln!(&mut stdout_lock, \"\\n========================================\");\n                let _ = writeln!(&mut stdout_lock, \"  All demos completed successfully!\");\n                let _ = writeln!(&mut stdout_lock, \"========================================\");\n            }\n            7 => {\n                let _ = writeln!(&mut stdout_lock, \"\\nGoodbye!\");\n                return;\n            }\n            _ => {\n                let _ = writeln!(&mut stdout_lock, \"Invalid choice\");\n            }\n        }\n    }\n}\n","numLines":607,"startLine":1,"totalLines":607}}}
