{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01433WvzocAtvbDyn9e7mFkz","type":"tool_result","content":"1\t/*\n2\t * Copyright 2025 MIT Lincoln Laboratory\n3\t * Permission is hereby granted, free of charge,\n4\t * to any person obtaining a copy of this software\n5\t * and associated documentation files (the \"Software\"),\n6\t * to deal in the Software without restriction,\n7\t * including without limitation the rights to use, copy,\n8\t * modify, merge, publish, distribute, sublicense,\n9\t * and/or sell copies of the Software,\n10\t * and to permit persons to whom the Software is furnished to do so,\n11\t * subject to the following conditions:\n12\t * \n13\t * The above copyright notice and this permission notice\n14\t * shall be included in all copies or substantial portions of the Software.\n15\t * \n16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n18\t * THE WARRANTIES OF MERCHANTABILITY,\n19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n24\t */\n25\t// generic_containers.h\n26\t#ifndef GENERIC_CONTAINERS_H\n27\t#define GENERIC_CONTAINERS_H\n28\t\n29\t#include <stddef.h>\n30\t#include <stdlib.h>\n31\t#include <string.h>\n32\t#include <stdio.h>\n33\t\n34\t// ============================================================================\n35\t// GENERIC DYNAMIC ARRAY\n36\t// ============================================================================\n37\t\n38\t#define DECLARE_ARRAY(TYPE) \\\n39\t    typedef struct { \\\n40\t        TYPE *data; \\\n41\t        size_t size; \\\n42\t        size_t capacity; \\\n43\t    } array_##TYPE##_t; \\\n44\t    \\\n45\t    array_##TYPE##_t* array_##TYPE##_create(size_t initial_capacity); \\\n46\t    void array_##TYPE##_destroy(array_##TYPE##_t *arr); \\\n47\t    int array_##TYPE##_push(array_##TYPE##_t *arr, TYPE value); \\\n48\t    TYPE array_##TYPE##_get(array_##TYPE##_t *arr, size_t index); \\\n49\t    size_t array_##TYPE##_size(array_##TYPE##_t *arr); \\\n50\t    void array_##TYPE##_clear(array_##TYPE##_t *arr);\n51\t\n52\t#define DEFINE_ARRAY(TYPE) \\\n53\t    array_##TYPE##_t* array_##TYPE##_create(size_t initial_capacity) { \\\n54\t        array_##TYPE##_t *arr = malloc(sizeof(array_##TYPE##_t)); \\\n55\t        if (!arr) return NULL; \\\n56\t        arr->capacity = initial_capacity > 0 ? initial_capacity : 16; \\\n57\t        arr->size = 0; \\\n58\t        arr->data = malloc(sizeof(TYPE) * arr->capacity); \\\n59\t        if (!arr->data) { \\\n60\t            free(arr); \\\n61\t            return NULL; \\\n62\t        } \\\n63\t        return arr; \\\n64\t    } \\\n65\t    \\\n66\t    void array_##TYPE##_destroy(array_##TYPE##_t *arr) { \\\n67\t        if (arr) { \\\n68\t            free(arr->data); \\\n69\t            free(arr); \\\n70\t        } \\\n71\t    } \\\n72\t    \\\n73\t    int array_##TYPE##_push(array_##TYPE##_t *arr, TYPE value) { \\\n74\t        if (!arr) return -1; \\\n75\t        if (arr->size >= arr->capacity) { \\\n76\t            size_t new_capacity = arr->capacity * 2; \\\n77\t            TYPE *new_data = realloc(arr->data, sizeof(TYPE) * new_capacity); \\\n78\t            if (!new_data) return -1; \\\n79\t            arr->data = new_data; \\\n80\t            arr->capacity = new_capacity; \\\n81\t        } \\\n82\t        arr->data[arr->size++] = value; \\\n83\t        return 0; \\\n84\t    } \\\n85\t    \\\n86\t    TYPE array_##TYPE##_get(array_##TYPE##_t *arr, size_t index) { \\\n87\t        return arr->data[index]; \\\n88\t    } \\\n89\t    \\\n90\t    size_t array_##TYPE##_size(array_##TYPE##_t *arr) { \\\n91\t        return arr ? arr->size : 0; \\\n92\t    } \\\n93\t    \\\n94\t    void array_##TYPE##_clear(array_##TYPE##_t *arr) { \\\n95\t        if (arr) arr->size = 0; \\\n96\t    }\n97\t\n98\t// FOR_EACH macro for arrays\n99\t#define ARRAY_FOREACH(TYPE, var, arr) \\\n100\t    for (size_t _i = 0; _i < (arr)->size && (var = (arr)->data[_i], 1); _i++)\n101\t\n102\t// ============================================================================\n103\t// GENERIC LINKED LIST\n104\t// ============================================================================\n105\t\n106\t#define DECLARE_LIST(TYPE) \\\n107\t    typedef struct list_node_##TYPE { \\\n108\t        TYPE data; \\\n109\t        struct list_node_##TYPE *next; \\\n110\t    } list_node_##TYPE##_t; \\\n111\t    \\\n112\t    typedef struct { \\\n113\t        list_node_##TYPE##_t *head; \\\n114\t        list_node_##TYPE##_t *tail; \\\n115\t        size_t size; \\\n116\t    } list_##TYPE##_t; \\\n117\t    \\\n118\t    list_##TYPE##_t* list_##TYPE##_create(void); \\\n119\t    void list_##TYPE##_destroy(list_##TYPE##_t *list); \\\n120\t    int list_##TYPE##_append(list_##TYPE##_t *list, TYPE value); \\\n121\t    int list_##TYPE##_prepend(list_##TYPE##_t *list, TYPE value); \\\n122\t    size_t list_##TYPE##_size(list_##TYPE##_t *list); \\\n123\t    void list_##TYPE##_clear(list_##TYPE##_t *list);\n124\t\n125\t#define DEFINE_LIST(TYPE) \\\n126\t    list_##TYPE##_t* list_##TYPE##_create(void) { \\\n127\t        list_##TYPE##_t *list = malloc(sizeof(list_##TYPE##_t)); \\\n128\t        if (!list) return NULL; \\\n129\t        list->head = NULL; \\\n130\t        list->tail = NULL; \\\n131\t        list->size = 0; \\\n132\t        return list; \\\n133\t    } \\\n134\t    \\\n135\t    void list_##TYPE##_destroy(list_##TYPE##_t *list) { \\\n136\t        if (!list) return; \\\n137\t        list_node_##TYPE##_t *current = list->head; \\\n138\t        while (current) { \\\n139\t            list_node_##TYPE##_t *next = current->next; \\\n140\t            free(current); \\