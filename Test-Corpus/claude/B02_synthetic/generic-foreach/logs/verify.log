{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016g2Z3VM6gG25HZT7JrqRxB","type":"tool_result","content":"1\tuse std::io::{self, BufRead, Write};\n2\t\n3\tconst MAX_NAME_LENGTH: usize = 64;\n4\tconst MAX_CATEGORY_LENGTH: usize = 32;\n5\t\n6\t#[derive(Clone)]\n7\tstruct Item {\n8\t    id: i32,\n9\t    name: String,\n10\t    category: String,\n11\t    price: f64,\n12\t    quantity: i32,\n13\t}\n14\t\n15\t#[derive(Clone)]\n16\tstruct Order {\n17\t    customer_id: i32,\n18\t    customer_name: String,\n19\t    total_amount: f64,\n20\t}\n21\t\n22\tfn truncate_to_c_string(s: &str, max_len_with_nul: usize) -> String {\n23\t    // Mimics C's strncpy(dest, src, max_len_with_nul - 1) followed by setting last byte to '\\0'.\n24\t    // The maximum number of usable chars (not counting NUL terminator) is max_len_with_nul - 1.\n25\t    let max_chars = max_len_with_nul - 1;\n26\t    let bytes = s.as_bytes();\n27\t    if bytes.len() <= max_chars {\n28\t        s.to_string()\n29\t    } else {\n30\t        // Truncate at byte boundary, keeping valid UTF-8 if possible.\n31\t        // For ASCII inputs (which all test inputs are) this is straightforward.\n32\t        let mut end = max_chars;\n33\t        while end > 0 && !s.is_char_boundary(end) {\n34\t            end -= 1;\n35\t        }\n36\t        s[..end].to_string()\n37\t    }\n38\t}\n39\t\n40\tfn create_item(id: i32, name: &str, category: &str, price: f64, quantity: i32) -> Item {\n41\t    Item {\n42\t        id,\n43\t        name: truncate_to_c_string(name, MAX_NAME_LENGTH),\n44\t        category: truncate_to_c_string(category, MAX_CATEGORY_LENGTH),\n45\t        price,\n46\t        quantity,\n47\t    }\n48\t}\n49\t\n50\tfn create_order(customer_id: i32, customer_name: &str, total_amount: f64) -> Order {\n51\t    Order {\n52\t        customer_id,\n53\t        customer_name: truncate_to_c_string(customer_name, MAX_NAME_LENGTH),\n54\t        total_amount,\n55\t    }\n56\t}\n57\t\n58\tfn print_item<W: Write>(out: &mut W, item: &Item) {\n59\t    writeln!(out, \"  [{}] {}\", item.id, item.name).unwrap();\n60\t    writeln!(out, \"      Category: {}\", item.category).unwrap();\n61\t    writeln!(out, \"      Price: ${:.2}\", item.price).unwrap();\n62\t    writeln!(out, \"      Quantity: {}\", item.quantity).unwrap();\n63\t}\n64\t\n65\tfn print_order<W: Write>(out: &mut W, order: &Order) {\n66\t    writeln!(\n67\t        out,\n68\t        \"  Order - Customer ID: {}, Name: {}\",\n69\t        order.customer_id, order.customer_name\n70\t    )\n71\t    .unwrap();\n72\t    writeln!(out, \"          Total: ${:.2}\", order.total_amount).unwrap();\n73\t}\n74\t\n75\tfn calculate_inventory_stats<W: Write>(out: &mut W, items: &[Item]) {\n76\t    if items.is_empty() {\n77\t        writeln!(out, \"No items in inventory\").unwrap();\n78\t        return;\n79\t    }\n80\t\n81\t    writeln!(out, \"\\n=== Inventory Statistics (Array) ===\").unwrap();\n82\t\n83\t    let mut total_value: f64 = 0.0;\n84\t    let mut total_items: i32 = 0;\n85\t    let mut max_price: f64 = 0.0;\n86\t    let mut min_price: f64 = items[0].price;\n87\t\n88\t    for item in items.iter() {\n89\t        total_value += item.price * (item.quantity as f64);\n90\t        total_items += item.quantity;\n91\t        if item.price > max_price {\n92\t            max_price = item.price;\n93\t        }\n94\t        if item.price < min_price {\n95\t            min_price = item.price;\n96\t        }\n97\t    }\n98\t\n99\t    writeln!(out, \"Total unique items: {}\", items.len()).unwrap();\n100\t    writeln!(out, \"Total item count: {}\", total_items).unwrap();\n101\t    writeln!(out, \"Total inventory value: ${:.2}\", total_value).unwrap();\n102\t    writeln!(\n103\t        out,\n104\t        \"Average item price: ${:.2}\",\n105\t        total_value / (total_items as f64)\n106\t    )\n107\t    .unwrap();\n108\t    writeln!(out, \"Most expensive item: ${:.2}\", max_price).unwrap();\n109\t    writeln!(out, \"Least expensive item: ${:.2}\", min_price).unwrap();\n110\t}\n111\t\n112\tfn calculate_order_stats<W: Write>(out: &mut W, orders: &[Order]) {\n113\t    if orders.is_empty() {\n114\t        writeln!(out, \"No orders to analyze\").unwrap();\n115\t        return;\n116\t    }\n117\t\n118\t    writeln!(out, \"\\n=== Order Statistics (List) ===\").unwrap();\n119\t\n120\t    let mut total_revenue: f64 = 0.0;\n121\t    let mut max_order: f64 = 0.0;\n122\t    let mut min_order: f64 = -1.0;\n123\t\n124\t    for order in orders.iter() {\n125\t        total_revenue += order.total_amount;\n126\t        if order.total_amount > max_order {\n127\t            max_order = order.total_amount;\n128\t        }\n129\t        if min_order < 0.0 || order.total_amount < min_order {\n130\t            min_order = order.total_amount;\n131\t        }\n132\t    }\n133\t\n134\t    writeln!(out, \"Total orders: {}\", orders.len()).unwrap();\n135\t    writeln!(out, \"Total revenue: ${:.2}\", total_revenue).unwrap();\n136\t    writeln!(\n137\t        out,\n138\t        \"Average order value: ${:.2}\",\n139\t        total_revenue / (orders.len() as f64)\n140\t    )\n141\t    .unwrap();\n142\t    writeln!(out, \"Largest order: ${:.2}\", max_order).unwrap();\n143\t    writeln!(out, \"Smallest order: ${:.2}\", min_order).unwrap();\n144\t}\n145\t\n146\tfn find_items_by_category<W: Write>(out: &mut W, items: &[Item], category: &str) {\n147\t    writeln!(out, \"\\n=== Items in category '{}' ===\", category).unwrap();\n148\t\n149\t    let mut found = 0;\n150\t    for item in items.iter() {\n151\t        if item.category == category {\n152\t            print_item(out, item);\n153\t            found += 1;\n154\t        }\n155\t    }\n156\t\n157\t    if found == 0 {\n158\t        writeln!(out, \"No items found in this category\").unwrap();\n159\t    } else {\n160\t        writeln!(out, \"Found {} items\", found).unwrap();\n161\t    }\n162\t}\n163\t\n164\t#[allow(dead_code)]\n165\tfn find_expensive_items<W: Write>(out: &mut W, items: &[Item], min_price: f64) {\n166\t    writeln!(out, \"\\n=== Items priced above ${:.2} ===\", min_price).unwrap();\n167\t\n168\t    let mut found = 0;\n169\t    for item in items.iter() {\n170\t        if item.price >= min_price {\n171\t            print_item(out, item);\n172\t            found += 1;\n173\t        }\n174\t    }\n175\t\n176\t    if found == 0 {\n177\t        writeln!(out, \"No items found above this price\").unwrap();\n178\t    } else {\n179\t        writeln!(out, \"Found {} items\", found).unwrap();\n180\t    }\n181\t}\n182\t\n183\tfn print_menu<W: Write>(out: &mut W) {\n184\t    writeln!(out).unwrap();\n185\t    writeln!(out, \"========================================\").unwrap();\n186\t    writeln!(out, \"  GENERIC FOR_EACH MACRO DEMO\").unwrap();\n187\t    writeln!(out, \"========================================\").unwrap();\n188\t    writeln!(out, \"1. Demo: Integer Containers\").unwrap();\n189\t    writeln!(out, \"2. Demo: Double Containers\").unwrap();\n190\t    writeln!(out, \"3. Demo: Inventory Array\").unwrap();\n191\t    writeln!(out, \"4. Demo: Order List\").unwrap();\n192\t    writeln!(out, \"5. Demo: Mixed Operations\").unwrap();\n193\t    writeln!(out, \"6. Run All Demos\").unwrap();\n194\t    writeln!(out, \"7. Exit\").unwrap();\n195\t    writeln!(out, \"========================================\").unwrap();\n196\t    write!(out, \"Choice: \").unwrap();\n197\t    out.flush().unwrap();\n198\t}\n199\t\n200\tfn demo_integer_containers<W: Write>(out: &mut W) {\n201\t    writeln!(out).unwrap();\n202\t    writeln!(out, \"========================================\").unwrap();\n203\t    writeln!(out, \"  DEMO 1: Integer Containers\").unwrap();\n204\t    writeln!(out, \"========================================\").unwrap();\n205\t\n206\t    // Create integer array\n207\t    let mut int_array: Vec<i32> = Vec::with_capacity(10);\n208\t    writeln!(out, \"\\n--- Integer Array ---\").unwrap();\n209\t    writeln!(out, \"Adding integers: 10, 20, 30, 40, 50\").unwrap();\n210\t    int_array.push(10);\n211\t    int_array.push(20);\n212\t    int_array.push(30);\n213\t    int_array.push(40);\n214\t    int_array.push(50);\n215\t\n216\t    write!(out, \"Array contents: \").unwrap();\n217\t    for &val in int_array.iter() {\n218\t        write!(out, \"{} \", val).unwrap();\n219\t    }\n220\t    writeln!(out).unwrap();\n221\t\n222\t    // Calculate sum using ARRAY_FOREACH\n223\t    let mut sum: i32 = 0;\n224\t    for &val in int_array.iter() {\n225\t        sum += val;\n226\t    }\n227\t    writeln!(out, \"Sum: {}\", sum).unwrap();\n228\t    writeln!(\n229\t        out,\n230\t        \"Average: {:.2}\",\n231\t        (sum as f64) / (int_array.len() as f64)\n232\t    )\n233\t    .unwrap();\n234\t\n235\t    // Create integer list\n236\t    let mut int_list: Vec<i32> = Vec::new();\n237\t    writeln!(out, \"\\n--- Integer List ---\").unwrap();\n238\t    writeln!(out, \"Adding integers: 100, 200, 300, 400, 500\").unwrap();\n239\t    int_list.push(100);\n240\t    int_list.push(200);\n241\t    int_list.push(300);\n242\t    int_list.push(400);\n243\t    int_list.push(500);\n244\t\n245\t    write!(out, \"List contents: \").unwrap();\n246\t    for &val in int_list.iter() {\n247\t        write!(out, \"{} \", val).unwrap();\n248\t    }\n249\t    writeln!(out).unwrap();\n250\t\n251\t    // Calculate product using LIST_FOREACH\n252\t    let mut product: i64 = 1;\n253\t    for &val in int_list.iter() {\n254\t        product = product.wrapping_mul(val as i64);\n255\t    }\n256\t    writeln!(out, \"Product: {}\", product).unwrap();\n257\t}\n258\t\n259\tfn demo_double_containers<W: Write>(out: &mut W) {\n260\t    writeln!(out).unwrap();\n261\t    writeln!(out, \"========================================\").unwrap();\n262\t    writeln!(out, \"  DEMO 2: Double Containers\").unwrap();\n263\t    writeln!(out, \"========================================\").unwrap();\n264\t\n265\t    // Create double array\n266\t    let mut double_array: Vec<f64> = Vec::with_capacity(5);\n267\t    writeln!(out, \"\\n--- Double Array (Temperatures in Celsius) ---\").unwrap();\n268\t\n269\t    let temps: [f64; 7] = [23.5, 25.0, 22.8, 26.3, 24.1, 21.9, 27.5];\n270\t\n271\t    write!(out, \"Adding temperatures: \").unwrap();\n272\t    for &t in temps.iter() {\n273\t        double_array.push(t);\n274\t        write!(out, \"{:.1} \", t).unwrap();\n275\t    }\n276\t    writeln!(out).unwrap();\n277\t\n278\t    // Find min, max, average using ARRAY_FOREACH\n279\t    let mut min_temp: f64 = temps[0];\n280\t    let mut max_temp: f64 = temps[0];\n281\t    let mut sum_temp: f64 = 0.0;\n282\t\n283\t    for &temp in double_array.iter() {\n284\t        if temp < min_temp {\n285\t            min_temp = temp;\n286\t        }\n287\t        if temp > max_temp {\n288\t            max_temp = temp;\n289\t        }\n290\t        sum_temp += temp;\n291\t    }\n292\t\n293\t    writeln!(out, \"Minimum: {:.1}\\u{00B0}C\", min_temp).unwrap();\n294\t    writeln!(out, \"Maximum: {:.1}\\u{00B0}C\", max_temp).unwrap();\n295\t    writeln!(\n296\t        out,\n297\t        \"Average: {:.1}\\u{00B0}C\",\n298\t        sum_temp / (double_array.len() as f64)\n299\t    )\n300\t    .unwrap();\n301\t\n302\t    // Create double list\n303\t    let mut price_list: Vec<f64> = Vec::new();\n304\t    writeln!(out, \"\\n--- Double List (Product Prices) ---\").unwrap();\n305\t\n306\t    let prices: [f64; 6] = [9.99, 14.50, 7.25, 22.00, 5.99, 18.75];\n307\t\n308\t    write!(out, \"Adding prices: \").unwrap();\n309\t    for &p in prices.iter() {\n310\t        price_list.push(p);\n311\t        write!(out, \"${:.2} \", p).unwrap();\n312\t    }\n313\t    writeln!(out).unwrap();\n314\t\n315\t    // Calculate total and find items under $10 using LIST_FOREACH\n316\t    let mut total: f64 = 0.0;\n317\t    let mut count_under_10: i32 = 0;\n318\t\n319\t    for &temp in price_list.iter() {\n320\t        total += temp;\n321\t        if temp < 10.0 {\n322\t            count_under_10 += 1;\n323\t        }\n324\t    }\n325\t\n326\t    writeln!(out, \"Total cost: ${:.2}\", total).unwrap();\n327\t    writeln!(out, \"Items under $10: {}\", count_under_10).unwrap();\n328\t}\n329\t\n330\tfn demo_inventory_array<W: Write>(out: &mut W) {\n331\t    writeln!(out).unwrap();\n332\t    writeln!(out, \"========================================\").unwrap();\n333\t    writeln!(out, \"  DEMO 3: Inventory Array (Items)\").unwrap();\n334\t    writeln!(out, \"========================================\").unwrap();\n335\t\n336\t    let mut inventory: Vec<Item> = Vec::with_capacity(20);\n337\t\n338\t    // Add items\n339\t    writeln!(out, \"\\n--- Adding Items to Inventory ---\").unwrap();\n340\t    inventory.push(create_item(1, \"Laptop\", \"Electronics\", 899.99, 15));\n341\t    inventory.push(create_item(2, \"Mouse\", \"Electronics\", 24.99, 50));\n342\t    inventory.push(create_item(3, \"Keyboard\", \"Electronics\", 79.99, 30));\n343\t    inventory.push(create_item(4, \"Monitor\", \"Electronics\", 299.99, 20));\n344\t    inventory.push(create_item(5, \"Desk Chair\", \"Furniture\", 199.99, 10));\n345\t    inventory.push(create_item(6, \"Desk\", \"Furniture\", 349.99, 8));\n346\t    inventory.push(create_item(7, \"Notebook\", \"Office\", 4.99, 100));\n347\t    inventory.push(create_item(8, \"Pen Set\", \"Office\", 12.99, 75));\n348\t    inventory.push(create_item(9, \"USB Cable\", \"Electronics\", 9.99, 60));\n349\t    inventory.push(create_item(10, \"Bookshelf\", \"Furniture\", 149.99, 12));\n350\t\n351\t    writeln!(out, \"Added {} items to inventory\", inventory.len()).unwrap();\n352\t\n353\t    // Display all items using ARRAY_FOREACH\n354\t    writeln!(out, \"\\n--- All Inventory Items ---\").unwrap();\n355\t    for item in inventory.iter() {\n356\t        print_item(out, item);\n357\t        writeln!(out).unwrap();\n358\t    }\n359\t\n360\t    calculate_inventory_stats(out, &inventory);\n361\t\n362\t    find_items_by_category(out, &inventory, \"Electronics\");\n363\t    find_items_by_category(out, &inventory, \"Furniture\");\n364\t\n365\t    // Find low stock items using ARRAY_FOREACH\n366\t    writeln!(out, \"\\n--- Low Stock Items (< 20) ---\").unwrap();\n367\t    let mut low_stock_count = 0;\n368\t    for item in inventory.iter() {\n369\t        if item.quantity < 20 {\n370\t            print_item(out, item);\n371\t            low_stock_count += 1;\n372\t        }\n373\t    }\n374\t    writeln!(out, \"Total low stock items: {}\", low_stock_count).unwrap();\n375\t}\n376\t\n377\tfn demo_order_list<W: Write>(out: &mut W) {\n378\t    writeln!(out).unwrap();\n379\t    writeln!(out, \"========================================\").unwrap();\n380\t    writeln!(out, \"  DEMO 4: Order List (Orders)\").unwrap();\n381\t    writeln!(out, \"========================================\").unwrap();\n382\t\n383\t    let mut orders: Vec<Order> = Vec::new();\n384\t\n385\t    // Add orders\n386\t    writeln!(out, \"\\n--- Adding Orders ---\").unwrap();\n387\t    orders.push(create_order(1001, \"Alice Johnson\", 1249.95));\n388\t    orders.push(create_order(1002, \"Bob Smith\", 89.99));\n389\t    orders.push(create_order(1003, \"Carol White\", 549.98));\n390\t    orders.push(create_order(1004, \"David Brown\", 24.99));\n391\t    orders.push(create_order(1005, \"Eve Davis\", 899.99));\n392\t    orders.push(create_order(1006, \"Frank Miller\", 374.97));\n393\t    orders.push(create_order(1007, \"Grace Lee\", 159.98));\n394\t    orders.push(create_order(1008, \"Henry Wilson\", 1099.99));\n395\t\n396\t    writeln!(out, \"Added {} orders\", orders.len()).unwrap();\n397\t\n398\t    // Display all orders using LIST_FOREACH\n399\t    writeln!(out, \"\\n--- All Orders ---\").unwrap();\n400\t    for order in orders.iter() {\n401\t        print_order(out, order);\n402\t    }\n403\t\n404\t    calculate_order_stats(out, &orders);\n405\t\n406\t    // Find large orders using LIST_FOREACH\n407\t    writeln!(out, \"\\n--- Large Orders (> $500) ---\").unwrap();\n408\t    let mut large_order_count: i32 = 0;\n409\t    let mut large_order_total: f64 = 0.0;\n410\t\n411\t    for order in orders.iter() {\n412\t        if order.total_amount > 500.0 {\n413\t            print_order(out, order);\n414\t            large_order_count += 1;\n415\t            large_order_total += order.total_amount;\n416\t        }\n417\t    }\n418\t\n419\t    writeln!(out, \"Total large orders: {}\", large_order_count).unwrap();\n420\t    writeln!(\n421\t        out,\n422\t        \"Revenue from large orders: ${:.2}\",\n423\t        large_order_total\n424\t    )\n425\t    .unwrap();\n426\t}\n427\t\n428\tfn demo_mixed_operations<W: Write>(out: &mut W) {\n429\t    writeln!(out).unwrap();\n430\t    writeln!(out, \"========================================\").unwrap();\n431\t    writeln!(out, \"  DEMO 5: Mixed Operations\").unwrap();\n432\t    writeln!(out, \"========================================\").unwrap();\n433\t\n434\t    let mut array_inventory: Vec<Item> = Vec::with_capacity(10);\n435\t    let mut list_inventory: Vec<Item> = Vec::new();\n436\t\n437\t    writeln!(out, \"\\n--- Populating both Array and List ---\").unwrap();\n438\t\n439\t    let items: [Item; 5] = [\n440\t        create_item(1, \"Smartphone\", \"Electronics\", 699.99, 25),\n441\t        create_item(2, \"Tablet\", \"Electronics\", 449.99, 18),\n442\t        create_item(3, \"Headphones\", \"Electronics\", 149.99, 40),\n443\t        create_item(4, \"Smart Watch\", \"Electronics\", 299.99, 22),\n444\t        create_item(5, \"Power Bank\", \"Electronics\", 39.99, 55),\n445\t    ];\n446\t\n447\t    let num_items = items.len() as i32;\n448\t\n449\t    for item in items.iter() {\n450\t        array_inventory.push(item.clone());\n451\t        list_inventory.push(item.clone());\n452\t    }\n453\t\n454\t    writeln!(out, \"Added {} items to both containers\", num_items).unwrap();\n455\t\n456\t    // Compare iteration performance (conceptually)\n457\t    writeln!(out, \"\\n--- Iterating through Array ---\").unwrap();\n458\t    let mut array_count: i32 = 0;\n459\t    for _item in array_inventory.iter() {\n460\t        array_count += 1;\n461\t    }\n462\t    writeln!(out, \"Array iteration count: {}\", array_count).unwrap();\n463\t\n464\t    writeln!(out, \"\\n--- Iterating through List ---\").unwrap();\n465\t    let mut list_count: i32 = 0;\n466\t    for _item in list_inventory.iter() {\n467\t        list_count += 1;\n468\t    }\n469\t    writeln!(out, \"List iteration count: {}\", list_count).unwrap();\n470\t\n471\t    let price_threshold: f64 = 200.0;\n472\t\n473\t    writeln!(out, \"\\n--- Items above ${:.2} (Array) ---\", price_threshold).unwrap();\n474\t    for item in array_inventory.iter() {\n475\t        if item.price >= price_threshold {\n476\t            writeln!(out, \"  {}: ${:.2}\", item.name, item.price).unwrap();\n477\t        }\n478\t    }\n479\t\n480\t    writeln!(out, \"\\n--- Items above ${:.2} (List) ---\", price_threshold).unwrap();\n481\t    for item in list_inventory.iter() {\n482\t        if item.price >= price_threshold {\n483\t            writeln!(out, \"  {}: ${:.2}\", item.name, item.price).unwrap();\n484\t        }\n485\t    }\n486\t}\n487\t\n488\t/// Mimics sscanf(\"%d\") on a buffer: skips leading whitespace, parses optional sign,\n489\t/// then digits. Returns Some(n) if at least one digit found, else None.\n490\tfn scanf_int(input: &str) -> Option<i32> {\n491\t    let bytes = input.as_bytes();\n492\t    let mut i = 0;\n493\t    while i < bytes.len() && (bytes[i] as char).is_whitespace() {\n494\t        i += 1;\n495\t    }\n496\t    let mut neg = false;\n497\t    if i < bytes.len() && (bytes[i] == b'+' || bytes[i] == b'-') {\n498\t        neg = bytes[i] == b'-';\n499\t        i += 1;\n500\t    }\n501\t    let start = i;\n502\t    while i < bytes.len() && bytes[i].is_ascii_digit() {\n503\t        i += 1;\n504\t    }\n505\t    if start == i {\n506\t        return None;\n507\t    }\n508\t    let digits = &input[start..i];\n509\t    // Use i64 to allow overflow handling like C (sscanf would store overflow).\n510\t    // C's sscanf with %d on overflow has undefined behavior; for normal short ints we just use i32 parse with saturation.\n511\t    let val: i64 = digits.parse().ok()?;\n512\t    let val = if neg { -val } else { val };\n513\t    Some(val as i32)\n514\t}\n515\t\n516\tfn main() {\n517\t    let stdout = io::stdout();\n518\t    let mut out = stdout.lock();\n519\t    let stdin = io::stdin();\n520\t    let mut stdin = stdin.lock();\n521\t\n522\t    writeln!(\n523\t        out,\n524\t        \"\\u{2554}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2557}\"\n525\t    )\n526\t    .unwrap();\n527\t    writeln!(\n528\t        out,\n529\t        \"\\u{2551}   GENERIC FOR_EACH MACRO DEMO         \\u{2551}\"\n530\t    )\n531\t    .unwrap();\n532\t    writeln!(\n533\t        out,\n534\t        \"\\u{2551}   Demonstrating Generic Containers    \\u{2551}\"\n535\t    )\n536\t    .unwrap();\n537\t    writeln!(\n538\t        out,\n539\t        \"\\u{255A}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{255D}\"\n540\t    )\n541\t    .unwrap();\n542\t\n543\t    // The C version uses fgets(input, 256, stdin). It reads up to 255 chars or until newline (inclusive).\n544\t    // We mimic with read_line. For inputs longer than 256 bytes the C version would split, but typical menu input is short.\n545\t    loop {\n546\t        print_menu(&mut out);\n547\t\n548\t        let mut input = String::new();\n549\t        match stdin.read_line(&mut input) {\n550\t            Ok(0) => break, // EOF\n551\t            Ok(_) => {}\n552\t            Err(_) => break,\n553\t        }\n554\t\n555\t        let choice = match scanf_int(&input) {\n556\t            Some(n) => n,\n557\t            None => {\n558\t                writeln!(out, \"Invalid input\").unwrap();\n559\t                continue;\n560\t            }\n561\t        };\n562\t\n563\t        match choice {\n564\t            1 => demo_integer_containers(&mut out),\n565\t            2 => demo_double_containers(&mut out),\n566\t            3 => demo_inventory_array(&mut out),\n567\t            4 => demo_order_list(&mut out),\n568\t            5 => demo_mixed_operations(&mut out),\n569\t            6 => {\n570\t                writeln!(out, \"\\n=== Running All Demos ===\").unwrap();\n571\t                demo_integer_containers(&mut out);\n572\t                demo_double_containers(&mut out);\n573\t                demo_inventory_array(&mut out);\n574\t                demo_order_list(&mut out);\n575\t                demo_mixed_operations(&mut out);\n576\t                writeln!(out, \"\\n========================================\").unwrap();\n577\t                writeln!(out, \"  All demos completed successfully!\").unwrap();\n578\t                writeln!(out, \"========================================\").unwrap();\n579\t            }\n580\t            7 => {\n581\t                writeln!(out, \"\\nGoodbye!\").unwrap();\n582\t                return;\n583\t            }\n584\t            _ => {\n585\t                writeln!(out, \"Invalid choice\").unwrap();\n586\t            }\n587\t        }\n588\t    }\n589\t}\n590\t"}]},"parent_tool_use_id":null,"session_id":"e2925954-c890-4be5-ac11-9ef84014a270","uuid":"92ddce2c-9284-4635-a45e-f07fafa69873","timestamp":"2026-05-28T14:46:39.805Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-work-E0y1iq/translated_rust/src/main.rs","content":"use std::io::{self, BufRead, Write};\n\nconst MAX_NAME_LENGTH: usize = 64;\nconst MAX_CATEGORY_LENGTH: usize = 32;\n\n#[derive(Clone)]\nstruct Item {\n    id: i32,\n    name: String,\n    category: String,\n    price: f64,\n    quantity: i32,\n}\n\n#[derive(Clone)]\nstruct Order {\n    customer_id: i32,\n    customer_name: String,\n    total_amount: f64,\n}\n\nfn truncate_to_c_string(s: &str, max_len_with_nul: usize) -> String {\n    // Mimics C's strncpy(dest, src, max_len_with_nul - 1) followed by setting last byte to '\\0'.\n    // The maximum number of usable chars (not counting NUL terminator) is max_len_with_nul - 1.\n    let max_chars = max_len_with_nul - 1;\n    let bytes = s.as_bytes();\n    if bytes.len() <= max_chars {\n        s.to_string()\n    } else {\n        // Truncate at byte boundary, keeping valid UTF-8 if possible.\n        // For ASCII inputs (which all test inputs are) this is straightforward.\n        let mut end = max_chars;\n        while end > 0 && !s.is_char_boundary(end) {\n            end -= 1;\n        }\n        s[..end].to_string()\n    }\n}\n\nfn create_item(id: i32, name: &str, category: &str, price: f64, quantity: i32) -> Item {\n    Item {\n        id,\n        name: truncate_to_c_string(name, MAX_NAME_LENGTH),\n        category: truncate_to_c_string(category, MAX_CATEGORY_LENGTH),\n        price,\n        quantity,\n    }\n}\n\nfn create_order(customer_id: i32, customer_name: &str, total_amount: f64) -> Order {\n    Order {\n        customer_id,\n        customer_name: truncate_to_c_string(customer_name, MAX_NAME_LENGTH),\n        total_amount,\n    }\n}\n\nfn print_item<W: Write>(out: &mut W, item: &Item) {\n    writeln!(out, \"  [{}] {}\", item.id, item.name).unwrap();\n    writeln!(out, \"      Category: {}\", item.category).unwrap();\n    writeln!(out, \"      Price: ${:.2}\", item.price).unwrap();\n    writeln!(out, \"      Quantity: {}\", item.quantity).unwrap();\n}\n\nfn print_order<W: Write>(out: &mut W, order: &Order) {\n    writeln!(\n        out,\n        \"  Order - Customer ID: {}, Name: {}\",\n        order.customer_id, order.customer_name\n    )\n    .unwrap();\n    writeln!(out, \"          Total: ${:.2}\", order.total_amount).unwrap();\n}\n\nfn calculate_inventory_stats<W: Write>(out: &mut W, items: &[Item]) {\n    if items.is_empty() {\n        writeln!(out, \"No items in inventory\").unwrap();\n        return;\n    }\n\n    writeln!(out, \"\\n=== Inventory Statistics (Array) ===\").unwrap();\n\n    let mut total_value: f64 = 0.0;\n    let mut total_items: i32 = 0;\n    let mut max_price: f64 = 0.0;\n    let mut min_price: f64 = items[0].price;\n\n    for item in items.iter() {\n        total_value += item.price * (item.quantity as f64);\n        total_items += item.quantity;\n        if item.price > max_price {\n            max_price = item.price;\n        }\n        if item.price < min_price {\n            min_price = item.price;\n        }\n    }\n\n    writeln!(out, \"Total unique items: {}\", items.len()).unwrap();\n    writeln!(out, \"Total item count: {}\", total_items).unwrap();\n    writeln!(out, \"Total inventory value: ${:.2}\", total_value).unwrap();\n    writeln!(\n        out,\n        \"Average item price: ${:.2}\",\n        total_value / (total_items as f64)\n    )\n    .unwrap();\n    writeln!(out, \"Most expensive item: ${:.2}\", max_price).unwrap();\n    writeln!(out, \"Least expensive item: ${:.2}\", min_price).unwrap();\n}\n\nfn calculate_order_stats<W: Write>(out: &mut W, orders: &[Order]) {\n    if orders.is_empty() {\n        writeln!(out, \"No orders to analyze\").unwrap();\n        return;\n    }\n\n    writeln!(out, \"\\n=== Order Statistics (List) ===\").unwrap();\n\n    let mut total_revenue: f64 = 0.0;\n    let mut max_order: f64 = 0.0;\n    let mut min_order: f64 = -1.0;\n\n    for order in orders.iter() {\n        total_revenue += order.total_amount;\n        if order.total_amount > max_order {\n            max_order = order.total_amount;\n        }\n        if min_order < 0.0 || order.total_amount < min_order {\n            min_order = order.total_amount;\n        }\n    }\n\n    writeln!(out, \"Total orders: {}\", orders.len()).unwrap();\n    writeln!(out, \"Total revenue: ${:.2}\", total_revenue).unwrap();\n    writeln!(\n        out,\n        \"Average order value: ${:.2}\",\n        total_revenue / (orders.len() as f64)\n    )\n    .unwrap();\n    writeln!(out, \"Largest order: ${:.2}\", max_order).unwrap();\n    writeln!(out, \"Smallest order: ${:.2}\", min_order).unwrap();\n}\n\nfn find_items_by_category<W: Write>(out: &mut W, items: &[Item], category: &str) {\n    writeln!(out, \"\\n=== Items in category '{}' ===\", category).unwrap();\n\n    let mut found = 0;\n    for item in items.iter() {\n        if item.category == category {\n            print_item(out, item);\n            found += 1;\n        }\n    }\n\n    if found == 0 {\n        writeln!(out, \"No items found in this category\").unwrap();\n    } else {\n        writeln!(out, \"Found {} items\", found).unwrap();\n    }\n}\n\n#[allow(dead_code)]\nfn find_expensive_items<W: Write>(out: &mut W, items: &[Item], min_price: f64) {\n    writeln!(out, \"\\n=== Items priced above ${:.2} ===\", min_price).unwrap();\n\n    let mut found = 0;\n    for item in items.iter() {\n        if item.price >= min_price {\n            print_item(out, item);\n            found += 1;\n        }\n    }\n\n    if found == 0 {\n        writeln!(out, \"No items found above this price\").unwrap();\n    } else {\n        writeln!(out, \"Found {} items\", found).unwrap();\n    }\n}\n\nfn print_menu<W: Write>(out: &mut W) {\n    writeln!(out).unwrap();\n    writeln!(out, \"========================================\").unwrap();\n    writeln!(out, \"  GENERIC FOR_EACH MACRO DEMO\").unwrap();\n    writeln!(out, \"========================================\").unwrap();\n    writeln!(out, \"1. Demo: Integer Containers\").unwrap();\n    writeln!(out, \"2. Demo: Double Containers\").unwrap();\n    writeln!(out, \"3. Demo: Inventory Array\").unwrap();\n    writeln!(out, \"4. Demo: Order List\").unwrap();\n    writeln!(out, \"5. Demo: Mixed Operations\").unwrap();\n    writeln!(out, \"6. Run All Demos\").unwrap();\n    writeln!(out, \"7. Exit\").unwrap();\n    writeln!(out, \"========================================\").unwrap();\n    write!(out, \"Choice: \").unwrap();\n    out.flush().unwrap();\n}\n\nfn demo_integer_containers<W: Write>(out: &mut W) {\n    writeln!(out).unwrap();\n    writeln!(out, \"========================================\").unwrap();\n    writeln!(out, \"  DEMO 1: Integer Containers\").unwrap();\n    writeln!(out, \"========================================\").unwrap();\n\n    // Create integer array\n    let mut int_array: Vec<i32> = Vec::with_capacity(10);\n    writeln!(out, \"\\n--- Integer Array ---\").unwrap();\n    writeln!(out, \"Adding integers: 10, 20, 30, 40, 50\").unwrap();\n    int_array.push(10);\n    int_array.push(20);\n    int_array.push(30);\n    int_array.push(40);\n    int_array.push(50);\n\n    write!(out, \"Array contents: \").unwrap();\n    for &val in int_array.iter() {\n        write!(out, \"{} \", val).unwrap();\n    }\n    writeln!(out).unwrap();\n\n    // Calculate sum using ARRAY_FOREACH\n    let mut sum: i32 = 0;\n    for &val in int_array.iter() {\n        sum += val;\n    }\n    writeln!(out, \"Sum: {}\", sum).unwrap();\n    writeln!(\n        out,\n        \"Average: {:.2}\",\n        (sum as f64) / (int_array.len() as f64)\n    )\n    .unwrap();\n\n    // Create integer list\n    let mut int_list: Vec<i32> = Vec::new();\n    writeln!(out, \"\\n--- Integer List ---\").unwrap();\n    writeln!(out, \"Adding integers: 100, 200, 300, 400, 500\").unwrap();\n    int_list.push(100);\n    int_list.push(200);\n    int_list.push(300);\n    int_list.push(400);\n    int_list.push(500);\n\n    write!(out, \"List contents: \").unwrap();\n    for &val in int_list.iter() {\n        write!(out, \"{} \", val).unwrap();\n    }\n    writeln!(out).unwrap();\n\n    // Calculate product using LIST_FOREACH\n    let mut product: i64 = 1;\n    for &val in int_list.iter() {\n        product = product.wrapping_mul(val as i64);\n    }\n    writeln!(out, \"Product: {}\", product).unwrap();\n}\n\nfn demo_double_containers<W: Write>(out: &mut W) {\n    writeln!(out).unwrap();\n    writeln!(out, \"========================================\").unwrap();\n    writeln!(out, \"  DEMO 2: Double Containers\").unwrap();\n    writeln!(out, \"========================================\").unwrap();\n\n    // Create double array\n    let mut double_array: Vec<f64> = Vec::with_capacity(5);\n    writeln!(out, \"\\n--- Double Array (Temperatures in Celsius) ---\").unwrap();\n\n    let temps: [f64; 7] = [23.5, 25.0, 22.8, 26.3, 24.1, 21.9, 27.5];\n\n    write!(out, \"Adding temperatures: \").unwrap();\n    for &t in temps.iter() {\n        double_array.push(t);\n        write!(out, \"{:.1} \", t).unwrap();\n    }\n    writeln!(out).unwrap();\n\n    // Find min, max, average using ARRAY_FOREACH\n    let mut min_temp: f64 = temps[0];\n    let mut max_temp: f64 = temps[0];\n    let mut sum_temp: f64 = 0.0;\n\n    for &temp in double_array.iter() {\n        if temp < min_temp {\n            min_temp = temp;\n        }\n        if temp > max_temp {\n            max_temp = temp;\n        }\n        sum_temp += temp;\n    }\n\n    writeln!(out, \"Minimum: {:.1}\\u{00B0}C\", min_temp).unwrap();\n    writeln!(out, \"Maximum: {:.1}\\u{00B0}C\", max_temp).unwrap();\n    writeln!(\n        out,\n        \"Average: {:.1}\\u{00B0}C\",\n        sum_temp / (double_array.len() as f64)\n    )\n    .unwrap();\n\n    // Create double list\n    let mut price_list: Vec<f64> = Vec::new();\n    writeln!(out, \"\\n--- Double List (Product Prices) ---\").unwrap();\n\n    let prices: [f64; 6] = [9.99, 14.50, 7.25, 22.00, 5.99, 18.75];\n\n    write!(out, \"Adding prices: \").unwrap();\n    for &p in prices.iter() {\n        price_list.push(p);\n        write!(out, \"${:.2} \", p).unwrap();\n    }\n    writeln!(out).unwrap();\n\n    // Calculate total and find items under $10 using LIST_FOREACH\n    let mut total: f64 = 0.0;\n    let mut count_under_10: i32 = 0;\n\n    for &temp in price_list.iter() {\n        total += temp;\n        if temp < 10.0 {\n            count_under_10 += 1;\n        }\n    }\n\n    writeln!(out, \"Total cost: ${:.2}\", total).unwrap();\n    writeln!(out, \"Items under $10: {}\", count_under_10).unwrap();\n}\n\nfn demo_inventory_array<W: Write>(out: &mut W) {\n    writeln!(out).unwrap();\n    writeln!(out, \"========================================\").unwrap();\n    writeln!(out, \"  DEMO 3: Inventory Array (Items)\").unwrap();\n    writeln!(out, \"========================================\").unwrap();\n\n    let mut inventory: Vec<Item> = Vec::with_capacity(20);\n\n    // Add items\n    writeln!(out, \"\\n--- Adding Items to Inventory ---\").unwrap();\n    inventory.push(create_item(1, \"Laptop\", \"Electronics\", 899.99, 15));\n    inventory.push(create_item(2, \"Mouse\", \"Electronics\", 24.99, 50));\n    inventory.push(create_item(3, \"Keyboard\", \"Electronics\", 79.99, 30));\n    inventory.push(create_item(4, \"Monitor\", \"Electronics\", 299.99, 20));\n    inventory.push(create_item(5, \"Desk Chair\", \"Furniture\", 199.99, 10));\n    inventory.push(create_item(6, \"Desk\", \"Furniture\", 349.99, 8));\n    inventory.push(create_item(7, \"Notebook\", \"Office\", 4.99, 100));\n    inventory.push(create_item(8, \"Pen Set\", \"Office\", 12.99, 75));\n    inventory.push(create_item(9, \"USB Cable\", \"Electronics\", 9.99, 60));\n    inventory.push(create_item(10, \"Bookshelf\", \"Furniture\", 149.99, 12));\n\n    writeln!(out, \"Added {} items to inventory\", inventory.len()).unwrap();\n\n    // Display all items using ARRAY_FOREACH\n    writeln!(out, \"\\n--- All Inventory Items ---\").unwrap();\n    for item in inventory.iter() {\n        print_item(out, item);\n        writeln!(out).unwrap();\n    }\n\n    calculate_inventory_stats(out, &inventory);\n\n    find_items_by_category(out, &inventory, \"Electronics\");\n    find_items_by_category(out, &inventory, \"Furniture\");\n\n    // Find low stock items using ARRAY_FOREACH\n    writeln!(out, \"\\n--- Low Stock Items (< 20) ---\").unwrap();\n    let mut low_stock_count = 0;\n    for item in inventory.iter() {\n        if item.quantity < 20 {\n            print_item(out, item);\n            low_stock_count += 1;\n        }\n    }\n    writeln!(out, \"Total low stock items: {}\", low_stock_count).unwrap();\n}\n\nfn demo_order_list<W: Write>(out: &mut W) {\n    writeln!(out).unwrap();\n    writeln!(out, \"========================================\").unwrap();\n    writeln!(out, \"  DEMO 4: Order List (Orders)\").unwrap();\n    writeln!(out, \"========================================\").unwrap();\n\n    let mut orders: Vec<Order> = Vec::new();\n\n    // Add orders\n    writeln!(out, \"\\n--- Adding Orders ---\").unwrap();\n    orders.push(create_order(1001, \"Alice Johnson\", 1249.95));\n    orders.push(create_order(1002, \"Bob Smith\", 89.99));\n    orders.push(create_order(1003, \"Carol White\", 549.98));\n    orders.push(create_order(1004, \"David Brown\", 24.99));\n    orders.push(create_order(1005, \"Eve Davis\", 899.99));\n    orders.push(create_order(1006, \"Frank Miller\", 374.97));\n    orders.push(create_order(1007, \"Grace Lee\", 159.98));\n    orders.push(create_order(1008, \"Henry Wilson\", 1099.99));\n\n    writeln!(out, \"Added {} orders\", orders.len()).unwrap();\n\n    // Display all orders using LIST_FOREACH\n    writeln!(out, \"\\n--- All Orders ---\").unwrap();\n    for order in orders.iter() {\n        print_order(out, order);\n    }\n\n    calculate_order_stats(out, &orders);\n\n    // Find large orders using LIST_FOREACH\n    writeln!(out, \"\\n--- Large Orders (> $500) ---\").unwrap();\n    let mut large_order_count: i32 = 0;\n    let mut large_order_total: f64 = 0.0;\n\n    for order in orders.iter() {\n        if order.total_amount > 500.0 {\n            print_order(out, order);\n            large_order_count += 1;\n            large_order_total += order.total_amount;\n        }\n    }\n\n    writeln!(out, \"Total large orders: {}\", large_order_count).unwrap();\n    writeln!(\n        out,\n        \"Revenue from large orders: ${:.2}\",\n        large_order_total\n    )\n    .unwrap();\n}\n\nfn demo_mixed_operations<W: Write>(out: &mut W) {\n    writeln!(out).unwrap();\n    writeln!(out, \"========================================\").unwrap();\n    writeln!(out, \"  DEMO 5: Mixed Operations\").unwrap();\n    writeln!(out, \"========================================\").unwrap();\n\n    let mut array_inventory: Vec<Item> = Vec::with_capacity(10);\n    let mut list_inventory: Vec<Item> = Vec::new();\n\n    writeln!(out, \"\\n--- Populating both Array and List ---\").unwrap();\n\n    let items: [Item; 5] = [\n        create_item(1, \"Smartphone\", \"Electronics\", 699.99, 25),\n        create_item(2, \"Tablet\", \"Electronics\", 449.99, 18),\n        create_item(3, \"Headphones\", \"Electronics\", 149.99, 40),\n        create_item(4, \"Smart Watch\", \"Electronics\", 299.99, 22),\n        create_item(5, \"Power Bank\", \"Electronics\", 39.99, 55),\n    ];\n\n    let num_items = items.len() as i32;\n\n    for item in items.iter() {\n        array_inventory.push(item.clone());\n        list_inventory.push(item.clone());\n    }\n\n    writeln!(out, \"Added {} items to both containers\", num_items).unwrap();\n\n    // Compare iteration performance (conceptually)\n    writeln!(out, \"\\n--- Iterating through Array ---\").unwrap();\n    let mut array_count: i32 = 0;\n    for _item in array_inventory.iter() {\n        array_count += 1;\n    }\n    writeln!(out, \"Array iteration count: {}\", array_count).unwrap();\n\n    writeln!(out, \"\\n--- Iterating through List ---\").unwrap();\n    let mut list_count: i32 = 0;\n    for _item in list_inventory.iter() {\n        list_count += 1;\n    }\n    writeln!(out, \"List iteration count: {}\", list_count).unwrap();\n\n    let price_threshold: f64 = 200.0;\n\n    writeln!(out, \"\\n--- Items above ${:.2} (Array) ---\", price_threshold).unwrap();\n    for item in array_inventory.iter() {\n        if item.price >= price_threshold {\n            writeln!(out, \"  {}: ${:.2}\", item.name, item.price).unwrap();\n        }\n    }\n\n    writeln!(out, \"\\n--- Items above ${:.2} (List) ---\", price_threshold).unwrap();\n    for item in list_inventory.iter() {\n        if item.price >= price_threshold {\n            writeln!(out, \"  {}: ${:.2}\", item.name, item.price).unwrap();\n        }\n    }\n}\n\n/// Mimics sscanf(\"%d\") on a buffer: skips leading whitespace, parses optional sign,\n/// then digits. Returns Some(n) if at least one digit found, else None.\nfn scanf_int(input: &str) -> Option<i32> {\n    let bytes = input.as_bytes();\n    let mut i = 0;\n    while i < bytes.len() && (bytes[i] as char).is_whitespace() {\n        i += 1;\n    }\n    let mut neg = false;\n    if i < bytes.len() && (bytes[i] == b'+' || bytes[i] == b'-') {\n        neg = bytes[i] == b'-';\n        i += 1;\n    }\n    let start = i;\n    while i < bytes.len() && bytes[i].is_ascii_digit() {\n        i += 1;\n    }\n    if start == i {\n        return None;\n    }\n    let digits = &input[start..i];\n    // Use i64 to allow overflow handling like C (sscanf would store overflow).\n    // C's sscanf with %d on overflow has undefined behavior; for normal short ints we just use i32 parse with saturation.\n    let val: i64 = digits.parse().ok()?;\n    let val = if neg { -val } else { val };\n    Some(val as i32)\n}\n\nfn main() {\n    let stdout = io::stdout();\n    let mut out = stdout.lock();\n    let stdin = io::stdin();\n    let mut stdin = stdin.lock();\n\n    writeln!(\n        out,\n        \"\\u{2554}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2557}\"\n    )\n    .unwrap();\n    writeln!(\n        out,\n        \"\\u{2551}   GENERIC FOR_EACH MACRO DEMO         \\u{2551}\"\n    )\n    .unwrap();\n    writeln!(\n        out,\n        \"\\u{2551}   Demonstrating Generic Containers    \\u{2551}\"\n    )\n    .unwrap();\n    writeln!(\n        out,\n        \"\\u{255A}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{2550}\\u{255D}\"\n    )\n    .unwrap();\n\n    // The C version uses fgets(input, 256, stdin). It reads up to 255 chars or until newline (inclusive).\n    // We mimic with read_line. For inputs longer than 256 bytes the C version would split, but typical menu input is short.\n    loop {\n        print_menu(&mut out);\n\n        let mut input = String::new();\n        match stdin.read_line(&mut input) {\n            Ok(0) => break, // EOF\n            Ok(_) => {}\n            Err(_) => break,\n        }\n\n        let choice = match scanf_int(&input) {\n            Some(n) => n,\n            None => {\n                writeln!(out, \"Invalid input\").unwrap();\n                continue;\n            }\n        };\n\n        match choice {\n            1 => demo_integer_containers(&mut out),\n            2 => demo_double_containers(&mut out),\n            3 => demo_inventory_array(&mut out),\n            4 => demo_order_list(&mut out),\n            5 => demo_mixed_operations(&mut out),\n            6 => {\n                writeln!(out, \"\\n=== Running All Demos ===\").unwrap();\n                demo_integer_containers(&mut out);\n                demo_double_containers(&mut out);\n                demo_inventory_array(&mut out);\n                demo_order_list(&mut out);\n                demo_mixed_operations(&mut out);\n                writeln!(out, \"\\n========================================\").unwrap();\n                writeln!(out, \"  All demos completed successfully!\").unwrap();\n                writeln!(out, \"========================================\").unwrap();\n            }\n            7 => {\n                writeln!(out, \"\\nGoodbye!\").unwrap();\n                return;\n            }\n            _ => {\n                writeln!(out, \"Invalid choice\").unwrap();\n            }\n        }\n    }\n}\n","numLines":590,"startLine":1,"totalLines":590}}}
