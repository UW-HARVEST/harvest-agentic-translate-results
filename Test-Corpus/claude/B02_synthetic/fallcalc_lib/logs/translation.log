        sum += (points_value[i as usize] as f64) * points_coeff[i as usize];\n    }\n\n    safe_double_to_int(sum)\n}\n\nfn foreach_sum(array: &[c_int], count: c_int) -> c_int {\n    let mut total: c_int = 0;\n\n    // Mirror the FOREACH macro: iterate idx from 0..count, set element from array[idx].\n    for idx in 0..count {\n        let element = array[idx as usize];\n        total = total.wrapping_add(element);\n    }\n\n    total\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn fallcalc(param1: c_int, param2: c_int, param3: c_int, param4: c_int) -> c_int {\n    let mut result: c_int;\n\n    let base_value: c_int = param1.wrapping_mul(OCTAL_MASK_2).wrapping_add(param2);\n\n    let array_size: c_int = 5;\n    let mut data_array: Vec<c_int> = vec![0; array_size as usize];\n\n    for i in 0..array_size {\n        data_array[i as usize] = (i + 1).wrapping_mul(OCTAL_BASE).wrapping_add(param1);\n    }\n\n    let foreach_result = foreach_sum(&data_array, array_size);\n\n    // last_element pointer in C: data_array + array_size - 1\n    let last_index = (array_size - 1) as usize;\n    let reverse_sum = process_array_reverse(&data_array, last_index, array_size);\n\n    let switch_result = switch_fallthrough_calculator(param2, param3.rem_euclid_c(5));\n    // Note: C uses % which is truncated division; we use a helper below.\n\n    let floating_calc: f64 =\n        (param1 as f64) * 3.7 + (param2 as f64) * 2.3 - (param3 as f64) * 0.5;\n    let converted = safe_double_to_int(floating_calc);\n\n    let alloc_result = allocate_and_compute(param4.rem_truncated(10).wrapping_add(1), 1.5);\n\n    result = base_value\n        .wrapping_add(foreach_result)\n        .wrapping_add(reverse_sum)\n        .wrapping_add(switch_result)\n        .wrapping_add(converted)\n        .wrapping_add(alloc_result);\n\n    if param3 > OCTAL_FLAG {\n        result |= OCTAL_FLAG;\n    }\n\n    // data_array dropped automatically at end of scope (mimics free).\n\n    result &= OCTAL_MASK_1;\n\n    result\n}\n\n// Helper trait to provide C-style truncated modulo (matches C99 % operator).\ntrait CMod {\n    fn rem_truncated(self, rhs: Self) -> Self;\n    fn rem_euclid_c(self, rhs: Self) -> Self;\n}\n\nimpl CMod for c_int {\n    #[inline]\n    fn rem_truncated(self, rhs: c_int) -> c_int {\n        // Rust's `%` on i32 is already truncated (matches C99 semantics for\n        // signed integers when the result is non-negative or both operands\n        // have the same sign). i32::wrapping_rem handles the INT_MIN % -1 edge.\n        self.wrapping_rem(rhs)\n    }\n\n    #[inline]\n    fn rem_euclid_c(self, rhs: c_int) -> c_int {\n        // C's % is truncated, not euclidean. Despite the helper name we\n        // reproduce C semantics here for parity with the original source.\n        self.wrapping_rem(rhs)\n    }\n}\n","userModified":false}}
