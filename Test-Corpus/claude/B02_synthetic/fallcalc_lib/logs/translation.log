{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_qijr6nua7j65txixdkw4ho7glieqlwctkz5kii7pwb3dk5eypt6a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01G4e9CYL3LPXSXJyKW5jk3W","name":"Write","input":{"file_path":"/tmp/harvest-translate-MMlD8Y/translated_rust/src/lib.rs","content":"// Copyright 2025 MIT Lincoln Laboratory\n// Translated to Rust - reproduces the byte-identical behavior of the C library.\n\nuse std::ffi::c_int;\n\nconst OCTAL_MASK_1: c_int = 0o777;\nconst OCTAL_MASK_2: c_int = 0o100;\nconst OCTAL_FLAG: c_int = 0o200;\nconst OCTAL_BASE: c_int = 0o10;\n\nfn safe_double_to_int(d: f64) -> c_int {\n    if d.is_nan() {\n        return 0;\n    }\n\n    if d.is_infinite() {\n        return if d > 0.0 { c_int::MAX } else { c_int::MIN };\n    }\n\n    if d >= c_int::MAX as f64 {\n        return c_int::MAX;\n    }\n    if d <= c_int::MIN as f64 {\n        return c_int::MIN;\n    }\n\n    d as c_int\n}\n\nfn process_array_reverse(slice: &[c_int], end_index: usize, count: c_int) -> c_int {\n    // Mirrors C: walks backwards starting at `end_index` for `count` elements.\n    let mut sum: c_int = 0;\n    let mut idx = end_index as isize;\n\n    for _ in 0..count {\n        sum = sum.wrapping_add(slice[idx as usize]);\n        idx -= 1;\n    }\n\n    sum\n}\n\nfn switch_fallthrough_calculator(value: c_int, operation: c_int) -> c_int {\n    let mut result = value;\n\n    // Reproduce C switch fall-through semantics exactly.\n    match operation {\n        0 => {\n            result = result.wrapping_mul(OCTAL_BASE);\n            result = result.wrapping_add(OCTAL_FLAG);\n            result &= OCTAL_MASK_1;\n        }\n        1 => {\n            result = result.wrapping_add(OCTAL_FLAG);\n            result &= OCTAL_MASK_1;\n        }\n        2 => {\n            result &= OCTAL_MASK_1;\n        }\n        3 => {\n            result = result.wrapping_mul(3);\n            result = result.wrapping_add(OCTAL_MASK_2);\n        }\n        4 => {\n            result = result.wrapping_add(OCTAL_MASK_2);\n        }\n        _ => {\n            result = 0;\n        }\n    }\n\n    result\n}\n\nfn allocate_and_compute(size: c_int, multiplier: f64) -> c_int {\n    if size < 0 {\n        // The C code multiplies size * sizeof(DataPoint) for malloc; on negative\n        // values malloc would normally fail (return NULL) -> -1.\n        return -1;\n    }\n\n    let size_usz = size as usize;\n\n    // Equivalent of malloc - vec allocation.\n    let mut points_value: Vec<c_int> = vec![0; size_usz];\n    let mut points_coeff: Vec<f64> = vec![0.0; size_usz];\n\n    for i in 0..size {\n        points_value[i as usize] = i.wrapping_mul(OCTAL_BASE);\n        points_coeff[i as usize] = (i as f64) * multiplier;\n    }\n\n    let mut sum: f64 = 0.0;\n    for i in 0..size {\n        sum += (points_value[i as usize] as f64) * points_coeff[i as usize];\n    }\n\n    safe_double_to_int(sum)\n}\n\nfn foreach_sum(array: &[c_int], count: c_int) -> c_int {\n    let mut total: c_int = 0;\n\n    // Mirror the FOREACH macro: iterate idx from 0..count, set element from array[idx].\n    for idx in 0..count {\n        let element = array[idx as usize];\n        total = total.wrapping_add(element);\n    }\n\n    total\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn fallcalc(param1: c_int, param2: c_int, param3: c_int, param4: c_int) -> c_int {\n    let mut result: c_int;\n\n    let base_value: c_int = param1.wrapping_mul(OCTAL_MASK_2).wrapping_add(param2);\n\n    let array_size: c_int = 5;\n    let mut data_array: Vec<c_int> = vec![0; array_size as usize];\n\n    for i in 0..array_size {\n        data_array[i as usize] = (i + 1).wrapping_mul(OCTAL_BASE).wrapping_add(param1);\n    }\n\n    let foreach_result = foreach_sum(&data_array, array_size);\n\n    // last_element pointer in C: data_array + array_size - 1\n    let last_index = (array_size - 1) as usize;\n    let reverse_sum = process_array_reverse(&data_array, last_index, array_size);\n\n    let switch_result = switch_fallthrough_calculator(param2, param3.rem_euclid_c(5));\n    // Note: C uses % which is truncated division; we use a helper below.\n\n    let floating_calc: f64 =\n        (param1 as f64) * 3.7 + (param2 as f64) * 2.3 - (param3 as f64) * 0.5;\n    let converted = safe_double_to_int(floating_calc);\n\n    let alloc_result = allocate_and_compute(param4.rem_truncated(10).wrapping_add(1), 1.5);\n\n    result = base_value\n        .wrapping_add(foreach_result)\n        .wrapping_add(reverse_sum)\n        .wrapping_add(switch_result)\n        .wrapping_add(converted)\n        .wrapping_add(alloc_result);\n\n    if param3 > OCTAL_FLAG {\n        result |= OCTAL_FLAG;\n    }\n\n    // data_array dropped automatically at end of scope (mimics free).\n\n    result &= OCTAL_MASK_1;\n\n    result\n}\n\n// Helper trait to provide C-style truncated modulo (matches C99 % operator).\ntrait CMod {\n    fn rem_truncated(self, rhs: Self) -> Self;\n    fn rem_euclid_c(self, rhs: Self) -> Self;\n}\n\nimpl CMod for c_int {\n    #[inline]\n    fn rem_truncated(self, rhs: c_int) -> c_int {\n        // Rust's `%` on i32 is already truncated (matches C99 semantics for\n        // signed integers when the result is non-negative or both operands\n        // have the same sign). i32::wrapping_rem handles the INT_MIN % -1 edge.\n        self.wrapping_rem(rhs)\n    }\n\n    #[inline]\n    fn rem_euclid_c(self, rhs: c_int) -> c_int {\n        // C's % is truncated, not euclidean. Despite the helper name we\n        // reproduce C semantics here for parity with the original source.\n        self.wrapping_rem(rhs)\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":263,"cache_read_input_tokens":17539,"cache_creation":{"ephemeral_5m_input_tokens":263,"ephemeral_1h_input_tokens":0},"output_tokens":52,"service_tier":"standard"},"context_management":null},"parent