t    let mut sign: i64 = 1;\n61\t    if i < bytes.len() && (bytes[i] == b'+' || bytes[i] == b'-') {\n62\t        if bytes[i] == b'-' {\n63\t            sign = -1;\n64\t        }\n65\t        i += 1;\n66\t    }\n67\t    let mut val: i64 = 0;\n68\t    while i < bytes.len() && bytes[i].is_ascii_digit() {\n69\t        val = val.wrapping_mul(10).wrapping_add((bytes[i] - b'0') as i64);\n70\t        i += 1;\n71\t    }\n72\t    (val * sign) as c_int\n73\t}\n74\t\n75\tfn parse_env_numeric(env_name: &[u8], default_val: c_int) -> c_int {\n76\t    let env_value = match c_getenv(env_name) {\n77\t        None => return default_val,\n78\t        Some(v) => v,\n79\t    };\n80\t\n81\t    if c_strchr(env_value, b',').is_some() {\n82\t        // Strip null terminator from env_name for the printf format\n83\t        let name_str = unsafe { CStr::from_ptr(env_name.as_ptr() as *const c_char) };\n84\t        unsafe {\n85\t            libc::fprintf(\n86\t                stderr,\n87\t                b\"Warning: Invalid character in %s\\n\\0\".as_ptr() as *const c_char,\n88\t                name_str.as_ptr(),\n89\t            );\n90\t        }\n91\t        return default_val;\n92\t    }\n93\t\n94\t    if c_strchr(env_value, b';').is_some() {\n95\t        let name_str = unsafe { CStr::from_ptr(env_name.as_ptr() as *const c_char) };\n96\t        unsafe {\n97\t            libc::fprintf(\n98\t                stderr,\n99\t                b\"Warning: Semicolon found in %s\\n\\0\".as_ptr() as *const c_char,\n100\t                name_str.as_ptr(),\n101\t            );\n102\t        }\n103\t        return default_val;\n104\t    }\n105\t\n106\t    c_atoi(env_value)\n107\t}\n108\t\n109\tfn init_config_from_env(flags: &mut ConfigFlags) {\n110\t    let verbose_env = c_getenv(b\"PROG_VERBOSE\\0\");\n111\t    let debug_env = c_getenv(b\"PROG_DEBUG\\0\");\n112\t    let optimize_env = c_getenv(b\"PROG_OPTIMIZE\\0\");\n113\t\n114\t    flags.verbose = match verbose_env {\n115\t        Some(v) if c_strchr(v, b