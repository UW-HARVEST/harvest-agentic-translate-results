n50\t        while buf.len() < max {\n51\t            match self.inner.read(&mut byte) {\n52\t                Ok(0) => break,\n53\t                Ok(_) => {\n54\t                    got_any = true;\n55\t                    buf.push(byte[0]);\n56\t                    if byte[0] == b'\\n' {\n57\t                        break;\n58\t                    }\n59\t                }\n60\t                Err(_) => break,\n61\t            }\n62\t        }\n63\t        if !got_any {\n64\t            return None;\n65\t        }\n66\t        Some(String::from_utf8_lossy(&buf).into_owned())\n67\t    }\n68\t\n69\t    /// Read characters until '\\n' is read (and consume it). Mimics\n70\t    /// `while (getchar() != '\\n');`. Returns on EOF.\n71\t    fn consume_line(&mut self) {\n72\t        let mut byte = [0u8; 1];\n73\t        loop {\n74\t            match self.inner.read(&mut byte) {\n75\t                Ok(0) => return,\n76\t                Ok(_) => {\n77\t                    if byte[0] == b'\\n' {\n78\t                        return;\n79\t                    }\n80\t                }\n81\t                Err(_) => return,\n82\t            }\n83\t        }\n84\t    }\n85\t\n86\t    /// Read an integer with scanf(\"%d\") semantics: skip whitespace, then\n87\t    /// read optional sign and digits. Returns None on failure (no digits).\n88\t    /// Does NOT consume the trailing non-digit character (it stays in the\n89\t    /// buffer just like scanf would behave). However, since we are reading\n90\t    /// byte-by-byte from stdin, we have to use peek via fill_buf.\n91\t    fn scan_int(&mut self) -> Option<i32> {\n92\t        // Skip whitespace using fill_buf so we can ungetc-like\n93\t        loop {\n94\t            let buf = self.inner.fill_buf().ok()?;\n95\t            if buf.is_empty() {\n96\t                return None;\n97\t            }\n98\t            let mut consumed = 0usize;\n99\t            let mut found_non_ws = false;\n100\t            for &b in buf.iter() {\n101\t                if (b as char).is_whitespace() {\n102\t                    consumed += 1;\n103\t                } else {\n104\t                    found_non_ws = true;\n105\t                    break;\n106\t                }\n107\t            }\n108\t            self.inner.consume(consumed);\n109\t            if found_non_ws {\n110\t                break;\n111\t            }\n112\t        }\n113\t\n114\t        let mut sign: i32 = 1;\n115\t        let mut digits: Vec<u8> = Vec::new();\n116\t\n117\t        // Check sign\n118\t        {\n119\t            let buf = self.inner.fill_buf().ok()?;\n120\t            if buf.is_empty() {\n121\t                return None;\n122\t            }\n123\t            let first = buf[0];\n124\t            if first == b'-' {\n125\t                sign = -1;\n126\t                self.inner.consume(1);\n127\t            } else if first == b'+' {\n128\t                self.inner.consume(1);\n129\t            }\n130\t        }\n131\t\n132\t        // Read digits\n133\t        loop {\n134\t            let buf = match self.inner.fill_buf() {\n135\t                Ok(b) => b,\n136\t                Err(_) => break,\n137\t            };\n138\t            if buf.is_empty() {\n139\t                break;\n140\t            }\n141\t            let mut consumed = 0usize;\n142\t            let mut stop = false;\n143\t            for &b in buf.iter() {\n144\t                if b.is_ascii_digit() {\n145\t                    digits.push(b);\n146\t                    consumed += 1;\n147\t                } else {\n148\t                    stop = true;\n149\t                    break;\n150\t                }\n151\t            }\n152\t            self.inner.consume(consumed);\n153\t            if stop {\n154\t                break;\n155\t            }\n156\t        }\n157\t\n158\t        if digits.is_empty() {\n159\t            return None;\n160\t        }\n161\t        let s = std::str::from_utf8(&digits).ok()?;\n162\t        s.parse::<i32>().ok().map(|v| v * sign)\n163\t    }\n164\t}\n165\t\n166\tfn strip_newline(s: &mut String) {\n167\t    // C does: name[strcspn(name, \"\\n\")] = 0;\n168\t    // This finds the first '\\n' and replaces with 0, truncating the string there.\n169\t    if let Some(pos) = s.find('\\n') {\n170\t        s.truncate(pos);\n171\t    }\n172\t}\n173\t\n174\tfn print_menu() {\n175\t    print!(\"\\n\");\n176\t    print!(\"=========================================\\n\");\n177\t    print!(\"  ASCII ART DRAWING APPLICATION\\n\");\n178\t    print!(\"=========================================\\n\");\n179\t    print!(\"1. View all available shapes\\n\");\n180\t    print!(\"2. Create new scene\\n\");\n181\t    print!(\"3. Add shape to scene\\n\");\n182\t    print!(\"4. Remove shape from scene\\n\");\n183\t    print!(\"5. View scene\\n\");\n184\t    print!(\"6. List all scenes\\n\");\n185\t    print!(\"7. Save scene\\n\");\n186\t    print!(\"8. Load scene\\n\");\n187\t    print!(\"9. Compare two shapes\\n\");\n188\t    print!(\"10. Compare two scenes\\n\");\n189\t    print!(\"11. Delete scene\\n\");\n190\t    print!(\"12. Exit\\n\");\n191\t    print!(\"=========================================\\n\");\n192\t    print!(\"Choice: \");\n193\t    let _ = io::stdout().flush();\n194\t}\n195\t\n196\tfn view_all_shapes() {\n197\t    print!(\"\\n=== Available Shapes ===\\n\");\n198\t    for i in 0..SHAPE_COUNT {\n199\t        print!(\"\\n{}. \", i + 1);\n200\t        let t = ShapeType::from_i32(i).unwrap();\n201\t        shape_print(shape_get(t) as *const Shape);\n202\t    }\n203\t}\n204\t\n205\tfn create_new_scene(stdin: &mut StdinReader) {\n206\t    unsafe {\n207\t        if SCENE_COUNT as usize >= MAX_SCENES {\n208\t            print!(\"Error: Maximum scenes reached\\n\");\n209\t            return;\n210\t        }\n211\t    }\n212\t\n213\t    print!(\"Enter scene name: \");\n214\t    let _ = io::stdout().flush();\n215\t    let mut name = match stdin.fgets(MAX_SCENE_NAME) {\n216\t        Some(n) => n,\n217\t        None => return,\n218\t    };\n219\t    strip_newline(&mut name);\n220\t\n221\t    let scene_ptr = scene_create(Some(&name));\n222\t    unsafe {\n223\t        if !scene_ptr.is_null() {\n224\t            SCENES[SCENE_COUNT as usize] = scene_ptr;\n225\t            print!(\"Scene '{}' created (index {})\\n\", name, SCENE_COUNT);\n226\t            SCENE_COUNT += 1;\n227\t        } else {\n228\t            print!(\"Error creating scene\\n\");\n229\t        }\n230\t    }\n231\t}\n232\t\n233\tfn add_shape_to_scene(stdin: &mut StdinReader) {\n234\t    unsafe {\n235\t        if SCENE_COUNT == 0 {\n236\t            print!(\"No scenes available. Create a scene first.\\n\");\n237\t            return;\n238\t        }\n239\t\n240\t        print!(\"Select scene (0-{}): \", SCENE_COUNT - 1);\n241\t        let _ = io::stdout().flush();\n242\t        let scene_idx = match stdin.scan_int() {\n243\t            Some(v) => v,\n244\t            None => {\n245\t                print!(\"Invalid input\\n\");\n246\t                stdin.consume_line();\n247\t                return;\n248\t            }\n249\t        };\n250\t        stdin.consume_line();\n251\t\n252\t        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n253\t            print!(\"Invalid scene index\\n\");\n254\t            return;\n255\t        }\n256\t\n257\t        print!(\"\\nSelect shape to add:\\n\");\n258\t        for i in 0..SHAPE_COUNT {\n259\t            print!(\"{}. {}\\n\", i, shape_type_name_i32(i));\n260\t        }\n261\t        print!(\"Choice: \");\n262\t        let _ = io::stdout().flush();\n263\t\n264\t        let shape_type = match stdin.scan_int() {\n265\t            Some(v) => v,\n266\t            None => {\n267\t                print!(\"Invalid input\\n\");\n268\t                stdin.consume_line();\n269\t                return;\n270\t            }\n271\t        };\n272\t        stdin.consume_line();\n273\t\n274\t        if shape_type < 0 || shape_type >= SHAPE_COUNT {\n275\t            print!(\"Invalid shape type\\n\");\n276\t            return;\n277\t        }\n278\t\n279\t        let shape_ptr = shape_get_by_index(shape_type);\n280\t        if scene_add_shape(SCENES[scene_idx as usize], shape_ptr) == 0 {\n281\t            let sh = &*shape_ptr;\n282\t            print!(\n283\t                \"Shape '{}' added to scene (reusing singleton at {})\\n\",\n284\t                sh.name,\n285\t                util::format_ptr(shape_ptr as *const u8)\n286\t            );\n287\t        } else {\n288\t            print!(\"Error adding shape\\n\");\n289\t        }\n290\t    }\n291\t}\n292\t\n293\tfn remove_shape_from_scene(stdin: &mut StdinReader) {\n294\t    unsafe {\n295\t        if SCENE_COUNT == 0 {\n296\t            print!(\"No scenes available\\n\");\n297\t            return;\n298\t        }\n299\t\n300\t        print!(\"Select scene (0-{}): \", SCENE_COUNT - 1);\n301\t        let _ = io::stdout().flush();\n302\t        let scene_idx = match stdin.scan_int() {\n303\t            Some(v) => v,\n304\t            None => {\n305\t                print!(\"Invalid input\\n\");\n306\t                stdin.consume_line();\n307\t                return;\n308\t            }\n309\t        };\n310\t        stdin.consume_line();\n311\t\n312\t        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n313\t            print!(\"Invalid scene index\\n\");\n314\t            return;\n315\t        }\n316\t\n317\t        scene_list_shapes(SCENES[scene_idx as usize]);\n318\t\n319\t        let scene_ref = &*SCENES[scene_idx as usize];\n320\t        if scene_ref.shape_count == 0 {\n321\t            print!(\"Scene is empty\\n\");\n322\t            return;\n323\t        }\n324\t\n325\t        print!(\n326\t            \"Select shape to remove (1-{}): \",\n327\t            scene_ref.shape_count\n328\t        );\n329\t        let _ = io::stdout().flush();\n330\t        let shape_idx = match stdin.scan_int() {\n331\t            Some(v) => v,\n332\t            None => {\n333\t                print!(\"Invalid input\\n\");\n334\t                stdin.consume_line();\n335\t                return;\n336\t            }\n337\t        };\n338\t        stdin.consume_line();\n339\t\n340\t        if scene_remove_shape(SCENES[scene_idx as usize], shape_idx - 1) == 0 {\n341\t            print!(\"Shape removed\\n\");\n342\t        } else {\n343\t            print!(\"Error removing shape\\n\");\n344\t        }\n345\t    }\n346\t}\n347\t\n348\tfn view_scene(stdin: &mut StdinReader) {\n349\t    unsafe {\n350\t        if SCENE_COUNT == 0 {\n351\t            print!(\"No scenes available\\n\");\n352\t            return;\n353\t        }\n354\t\n355\t        print!(\"Select scene (0-{}): \", SCENE_COUNT - 1);\n356\t        let _ = io::stdout().flush();\n357\t        let scene_idx = match stdin.scan_int() {\n358\t            Some(v) => v,\n359\t            None => {\n360\t                print!(\"Invalid input\\n\");\n361\t                stdin.consume_line();\n362\t                return;\n363\t            }\n364\t        };\n365\t        stdin.consume_line();\n366\t\n367\t        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n368\t            print!(\"Invalid scene index\\n\");\n369\t            return;\n370\t        }\n371\t\n372\t        scene_print(SCENES[scene_idx as usize]);\n373\t    }\n374\t}\n375\t\n376\tfn list_all_scenes() {\n377\t    print!(\"\\n=== All Scenes ===\\n\");\n378\t    unsafe {\n379\t        if SCENE_COUNT == 0 {\n380\t            print!(\"No scenes created yet\\n\");\n381\t            return;\n382\t        }\n383\t        for i in 0..SCENE_COUNT {\n384\t            let s = &*SCENES[i as usize];\n385\t            print!(\"{}. {} ({} shapes)\\n\", i, s.name, s.shape_count);\n386\t        }\n387\t    }\n388\t}\n389\t\n390\tfn save_scene_to_file(stdin: &mut StdinReader) {\n391\t    unsafe {\n392\t        if SCENE_COUNT == 0 {\n393\t            print!(\"No scenes available\\n\");\n394\t            return;\n395\t        }\n396\t\n397\t        print!(\"Select scene (0-{}): \", SCENE_COUNT - 1);\n398\t        let _ = io::stdout().flush();\n399\t        let scene_idx = match stdin.scan_int() {\n400\t            Some(v) => v,\n401\t            None => {\n402\t                print!(\"Invalid input\\n\");\n403\t                stdin.consume_line();\n404\t                return;\n405\t            }\n406\t        };\n407\t        stdin.consume_line();\n408\t\n409\t        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n410\t            print!(\"Invalid scene index\\n\");\n411\t            return;\n412\t        }\n413\t\n414\t        print!(\"Enter filename: \");\n415\t        let _ = io::stdout().flush();\n416\t        let mut filename = match stdin.fgets(256) {\n417\t            Some(s) => s,\n418\t            None => return,\n419\t        };\n420\t        strip_newline(&mut filename);\n421\t\n422\t        scene_save(SCENES[scene_idx as usize], &filename);\n423\t    }\n424\t}\n425\t\n426\tfn load_scene_from_file(stdin: &mut StdinReader) {\n427\t    unsafe {\n428\t        if SCENE_COUNT as usize >= MAX_SCENES {\n429\t            print!(\"Error: Maximum scenes reached\\n\");\n430\t            return;\n431\t        }\n432\t\n433\t        print!(\"Enter filename: \");\n434\t        let _ = io::stdout().flush();\n435\t        let mut filename = match stdin.fgets(256) {\n436\t            Some(s) => s,\n437\t            None => return,\n438\t        };\n439\t        strip_newline(&mut filename);\n440\t\n441\t        let scene_ptr = scene_load(&filename);\n442\t        if !scene_ptr.is_null() {\n443\t            SCENES[SCENE_COUNT as usize] = scene_ptr;\n444\t            SCENE_COUNT += 1;\n445\t            print!(\"Scene loaded (index {})\\n\", SCENE_COUNT - 1);\n446\t        }\n447\t    }\n448\t}\n449\t\n450\tfn compare_shapes(stdin: &mut StdinReader) {\n451\t    print!(\"\\nSelect first shape (0-{}):\\n\", SHAPE_COUNT - 1);\n452\t    for i in 0..SHAPE_COUNT {\n453\t        print!(\"{}. {}\\n\", i, shape_type_name_i32(i));\n454\t    }\n455\t    print!(\"Choice: \");\n456\t    let _ = io::stdout().flush();\n457\t\n458\t    let type1 = match stdin.scan_int() {\n459\t        Some(v) => v,\n460\t        None => {\n461\t            print!(\"Invalid input\\n\");\n462\t            stdin.consume_line();\n463\t            return;\n464\t        }\n465\t    };\n466\t    stdin.consume_line();\n467\t\n468\t    print!(\"\\nSelect second shape (0-{}): \", SHAPE_COUNT - 1);\n469\t    let _ = io::stdout().flush();\n470\t    let type2 = match stdin.scan_int() {\n471\t        Some(v) => v,\n472\t        None => {\n473\t            print!(\"Invalid input\\n\");\n474\t            stdin.consume_line();\n475\t            return;\n476\t        }\n477\t    };\n478\t    stdin.consume_line();\n479\t\n480\t    if type1 < 0 || type1 >= SHAPE_COUNT || type2 < 0 || type2 >= SHAPE_COUNT {\n481\t        print!(\"Invalid shape type\\n\");\n482\t        return;\n483\t    }\n484\t\n485\t    let s1 = shape_get_by_index(type1);\n486\t    let s2 = shape_get_by_index(type2);\n487\t\n488\t    unsafe {\n489\t        let s1r = &*s1;\n490\t        let s2r = &*s2;\n491\t        print!(\n492\t            \"\\nShape 1: {} (ptr: {})\\n\",\n493\t            s1r.name,\n494\t            util::format_ptr(s1 as *const u8)\n495\t        );\n496\t        print!(\n497\t            \"Shape 2: {} (ptr: {})\\n\",\n498\t            s2r.name,\n499\t            util::format_ptr(s2 as *const u8)\n500\t        );\n501\t        // C's `s1 == s2` returns 0 or 1 (int)\n502\t        let cmp = if std::ptr::eq(s1, s2) { 1 } else { 0 };\n503\t        print!(\"Comparison of pointers: {}\\n\", cmp);\n504\t\n505\t        if shape_equals(s1 as *const Shape, s2 as *const Shape) != 0 {\n506\t            print!(\"Result: Shapes are EQUAL (same instance)\\n\");\n507\t        } else {\n508\t            print!(\"Result: Shapes are NOT EQUAL (different instances)\\n\");\n509\t        }\n510\t    }\n511\t}\n512\t\n513\tfn compare_scenes(stdin: &mut StdinReader) {\n514\t    unsafe {\n515\t        if SCENE_COUNT < 2 {\n516\t            print!(\"Need at least 2 scenes to compare\\n\");\n517\t            return;\n518\t        }\n519\t\n520\t        print!(\"Select first scene (0-{}): \", SCENE_COUNT - 1);\n521\t        let _ = io::stdout().flush();\n522\t        let idx1 = match stdin.scan_int() {\n523\t            Some(v) => v,\n524\t            None => {\n525\t                print!(\"Invalid input\\n\");\n526\t                stdin.consume_line();\n527\t                return;\n528\t            }\n529\t        };\n530\t        stdin.consume_line();\n531\t\n532\t        print!(\"Select second scene (0-{}): \", SCENE_COUNT - 1);\n533\t        let _ = io::stdout().flush();\n534\t        let idx2 = match stdin.scan_int() {\n535\t            Some(v) => v,\n536\t            None => {\n537\t                print!(\"Invalid input\\n\");\n538\t                stdin.consume_line();\n539\t                return;\n540\t            }\n541\t        };\n542\t        stdin.consume_line();\n543\t\n544\t        if idx1 < 0 || idx1 >= SCENE_COUNT || idx2 < 0 || idx2 >= SCENE_COUNT {\n545\t            print!(\"Invalid scene index\\n\");\n546\t            return;\n547\t        }\n548\t\n549\t        let sc1 = SCENES[idx1 as usize];\n550\t        let sc2 = SCENES[idx2 as usize];\n551\t        let sc1r = &*sc1;\n552\t        let sc2r = &*sc2;\n553\t\n554\t        print!(\"\\nScene 1: {} ({} shapes)\\n\", sc1r.name, sc1r.shape_count);\n555\t        scene_list_shapes(sc1);\n556\t\n557\t        print!(\"\\nScene 2: {} ({} shapes)\\n\", sc2r.name, sc2r.shape_count);\n558\t        scene_list_shapes(sc2);\n559\t\n560\t        if scene_equals(sc1 as *const Scene, sc2 as *const Scene) != 0 {\n561\t            print!(\"\\nResult: Scenes are EQUAL (1:1 correspondence)\\n\");\n562\t        } else {\n563\t            print!(\"\\nResult: Scenes are NOT EQUAL\\n\");\n564\t        }\n565\t    }\n566\t}\n567\t\n568\tfn delete_scene(stdin: &mut StdinReader) {\n569\t    unsafe {\n570\t        if SCENE_COUNT == 0 {\n571\t            print!(\"No scenes available\\n\");\n572\t            return;\n573\t        }\n574\t\n575\t        print!(\"Select scene to delete (0-{}): \", SCENE_COUNT - 1);\n576\t        let _ = io::stdout().flush();\n577\t        let scene_idx = match stdin.scan_int() {\n578\t            Some(v) => v,\n579\t            None => {\n580\t                print!(\"Invalid input\\n\");\n581\t                stdin.consume_line();\n582\t                return;\n583\t            }\n584\t        };\n585\t        stdin.consume_line();\n586\t\n587\t        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n588\t            print!(\"Invalid scene index\\n\");\n589\t            return;\n590\t        }\n591\t\n592\t        scene_destroy(SCENES[scene_idx as usize]);\n593\t\n594\t        let mut i = scene_idx;\n595\t        while i < SCENE_COUNT - 1 {\n596\t            SCENES[i as usize] = SCENES[(i + 1) as usize];\n597\t            i += 1;\n598\t        }\n599\t\n600\t        SCENE_COUNT -= 1;\n601\t        print!(\"Scene deleted\\n\");\n602\t    }\n603\t}\n604\t\n605\tfn main() {\n606\t    print!(\"╔════════════════════════════════════════╗\\n\");\n607\t    print!(\"║  ASCII ART DRAWING APPLICATION        ║\\n\");\n608\t    print!(\"║  Child-Friendly Shape Editor           ║\\n\");\n609\t    print!(\"╚════════════════════════════════════════╝\\n\");\n610\t\n611\t    shape_manager_init();\n612\t\n613\t    let mut stdin = StdinReader::new();\n614\t\n615\t    loop {\n616\t        print_menu();\n617\t\n618\t        let input = match stdin.fgets(256) {\n619\t            Some(s) => s,\n620\t            None => break,\n621\t        };\n622\t\n623\t        // sscanf-style parse: skip leading whitespace, read int.\n624\t        let trimmed = input.trim_start();\n625\t        let choice_str: String = trimmed\n626\t            .chars()\n627\t            .take_while(|c| c.is_ascii_digit() || *c == '-' || *c == '+')\n628\t            .collect();\n629\t        let choice: i32 = match choice_str.parse() {\n630\t            Ok(v) => v,\n631\t            Err(_) => {\n632\t                print!(\"Invalid input\\n\");\n633\t                continue;\n634\t            }\n635\t        };\n636\t\n637\t        match choice {\n638\t            1 => view_all_shapes(),\n639\t            2 => create_new_scene(&mut stdin),\n640\t            3 => add_shape_to_scene(&mut stdin),\n641\t            4 => remove_shape_from_scene(&mut stdin),\n642\t            5 => view_scene(&mut stdin),\n643\t            6 => list_all_scenes(),\n644\t            7 => save_scene_to_file(&mut stdin),\n645\t            8 => load_scene_from_file(&mut stdin),\n646\t            9 => compare_shapes(&mut stdin),\n647\t            10 => compare_scenes(&mut stdin),\n648\t            11 => delete_scene(&mut stdin),\n649\t            12 => {\n650\t                print!(\"\\nCleaning up and exiting...\\n\");\n651\t                unsafe {\n652\t                    for i in 0..SCENE_COUNT {\n653\t                        scene_destroy(SCENES[i as usize]);\n654\t                    }\n655\t                }\n656\t                shape_manager_cleanup();\n657\t                print!(\"Goodbye!\\n\");\n658\t                let _ = io::stdout().flush();\n659\t                return;\n660\t            }\n661\t            _ => {\n662\t                print!(\"Invalid choice\\n\");\n663\t            }\n664\t        }\n665\t    }\n666\t\n667\t    // Cleanup on EOF break\n668\t    unsafe {\n669\t        for i in 0..SCENE_COUNT {\n670\t            scene_destroy(SCENES[i as usize]);\n671\t        }\n672\t    }\n673\t    shape_manager_cleanup();\n674\t    let _ = io::stdout().flush();\n675\t}\n676\t"}]},"parent_tool_use_id":null,"session_id":"3abea399-4b51-47bc-896c-f3333c726210","uuid":"11222117-7fab-4289-9762-57529acfcb7b","timestamp":"2026-05-28T14:18:53.989Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-translate-L0dgA5/translated_rust/src/main.rs","content":"// main.rs - Rust translation of main.c\nmod shape;\nmod scene;\nmod util;\nmod out;\n\nuse std::io::{self, BufRead, Read, Write};\nuse crate::out::{cout_print, cout_flush};\n\nuse shape::{\n    shape_equals, shape_get, shape_get_by_index, shape_manager_cleanup, shape_manager_init,\n    shape_print, shape_type_name_i32, ShapeType, Shape, MAX_SHAPE_NAME, SHAPE_COUNT,\n};\nuse scene::{\n    scene_add_shape, scene_create, scene_destroy, scene_equals, scene_list_shapes, scene_load,\n    scene_print, scene_remove_shape, scene_save, Scene, MAX_SCENE_NAME, MAX_SHAPES_IN_SCENE,\n};\n\nconst MAX_SCENES: usize = 10;\n\n// Global mutable state - similar to C's static globals.\n// Use a thread_local with RefCell since this program is single-threaded.\nstatic mut SCENES: [*mut Scene; MAX_SCENES] = [std::ptr::null_mut(); MAX_SCENES];\nstatic mut SCENE_COUNT: i32 = 0;\n\n/// A reader that mimics C stdin behavior. We read raw bytes from stdin so\n/// we can implement both line-based (fgets) and scanf-style integer reads.\nstruct StdinReader {\n    inner: io::BufReader<io::Stdin>,\n}\n\nimpl StdinReader {\n    fn new() -> Self {\n        Self {\n            inner: io::BufReader::new(io::stdin()),\n        }\n    }\n\n    /// Read a \"line\" up to size-1 bytes or a newline (inclusive).\n    /// Returns None on EOF (matches fgets returning NULL).\n    /// The trailing newline (if read) is included in the returned string.\n    fn fgets(&mut self, size: usize) -> Option<String> {\n        if size == 0 {\n            return None;\n        }\n        let mut buf = Vec::new();\n        let max = size - 1;\n        let mut byte = [0u8; 1];\n        let mut got_any = false;\n        while buf.len() < max {\n            match self.inner.read(&mut byte) {\n                Ok(0) => break,\n                Ok(_) => {\n                    got_any = true;\n                    buf.push(byte[0]);\n                    if byte[0] == b'\\n' {\n                        break;\n                    }\n                }\n                Err(_) => break,\n            }\n        }\n        if !got_any {\n            return None;\n        }\n        Some(String::from_utf8_lossy(&buf).into_owned())\n    }\n\n    /// Read characters until '\\n' is read (and consume it). Mimics\n    /// `while (getchar() != '\\n');`. Returns on EOF.\n    fn consume_line(&mut self) {\n        let mut byte = [0u8; 1];\n        loop {\n            match self.inner.read(&mut byte) {\n                Ok(0) => return,\n                Ok(_) => {\n                    if byte[0] == b'\\n' {\n                        return;\n                    }\n                }\n                Err(_) => return,\n            }\n        }\n    }\n\n    /// Read an integer with scanf(\"%d\") semantics: skip whitespace, then\n    /// read optional sign and digits. Returns None on failure (no digits).\n    /// Does NOT consume the trailing non-digit character (it stays in the\n    /// buffer just like scanf would behave). However, since we are reading\n    /// byte-by-byte from stdin, we have to use peek via fill_buf.\n    fn scan_int(&mut self) -> Option<i32> {\n        // Skip whitespace using fill_buf so we can ungetc-like\n        loop {\n            let buf = self.inner.fill_buf().ok()?;\n            if buf.is_empty() {\n                return None;\n            }\n            let mut consumed = 0usize;\n            let mut found_non_ws = false;\n            for &b in buf.iter() {\n                if (b as char).is_whitespace() {\n                    consumed += 1;\n                } else {\n                    found_non_ws = true;\n                    break;\n                }\n            }\n            self.inner.consume(consumed);\n            if found_non_ws {\n                break;\n            }\n        }\n\n        let mut sign: i32 = 1;\n        let mut digits: Vec<u8> = Vec::new();\n\n        // Check sign\n        {\n            let buf = self.inner.fill_buf().ok()?;\n            if buf.is_empty() {\n                return None;\n            }\n            let first = buf[0];\n            if first == b'-' {\n                sign = -1;\n                self.inner.consume(1);\n            } else if first == b'+' {\n                self.inner.consume(1);\n            }\n        }\n\n        // Read digits\n        loop {\n            let buf = match self.inner.fill_buf() {\n                Ok(b) => b,\n                Err(_) => break,\n            };\n            if buf.is_empty() {\n                break;\n            }\n            let mut consumed = 0usize;\n            let mut stop = false;\n            for &b in buf.iter() {\n                if b.is_ascii_digit() {\n                    digits.push(b);\n                    consumed += 1;\n                } else {\n                    stop = true;\n                    break;\n                }\n            }\n            self.inner.consume(consumed);\n            if stop {\n                break;\n            }\n        }\n\n        if digits.is_empty() {\n            return None;\n        }\n        let s = std::str::from_utf8(&digits).ok()?;\n        s.parse::<i32>().ok().map(|v| v * sign)\n    }\n}\n\nfn strip_newline(s: &mut String) {\n    // C does: name[strcspn(name, \"\\n\")] = 0;\n    // This finds the first '\\n' and replaces with 0, truncating the string there.\n    if let Some(pos) = s.find('\\n') {\n        s.truncate(pos);\n    }\n}\n\nfn print_menu() {\n    print!(\"\\n\");\n    print!(\"=========================================\\n\");\n    print!(\"  ASCII ART DRAWING APPLICATION\\n\");\n    print!(\"=========================================\\n\");\n    print!(\"1. View all available shapes\\n\");\n    print!(\"2. Create new scene\\n\");\n    print!(\"3. Add shape to scene\\n\");\n    print!(\"4. Remove shape from scene\\n\");\n    print!(\"5. View scene\\n\");\n    print!(\"6. List all scenes\\n\");\n    print!(\"7. Save scene\\n\");\n    print!(\"8. Load scene\\n\");\n    print!(\"9. Compare two shapes\\n\");\n    print!(\"10. Compare two scenes\\n\");\n    print!(\"11. Delete scene\\n\");\n    print!(\"12. Exit\\n\");\n    print!(\"=========================================\\n\");\n    print!(\"Choice: \");\n    let _ = io::stdout().flush();\n}\n\nfn view_all_shapes() {\n    print!(\"\\n=== Available Shapes ===\\n\");\n    for i in 0..SHAPE_COUNT {\n        print!(\"\\n{}. \", i + 1);\n        let t = ShapeType::from_i32(i).unwrap();\n        shape_print(shape_get(t) as *const Shape);\n    }\n}\n\nfn create_new_scene(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT as usize >= MAX_SCENES {\n            print!(\"Error: Maximum scenes reached\\n\");\n            return;\n        }\n    }\n\n    print!(\"Enter scene name: \");\n    let _ = io::stdout().flush();\n    let mut name = match stdin.fgets(MAX_SCENE_NAME) {\n        Some(n) => n,\n        None => return,\n    };\n    strip_newline(&mut name);\n\n    let scene_ptr = scene_create(Some(&name));\n    unsafe {\n        if !scene_ptr.is_null() {\n            SCENES[SCENE_COUNT as usize] = scene_ptr;\n            print!(\"Scene '{}' created (index {})\\n\", name, SCENE_COUNT);\n            SCENE_COUNT += 1;\n        } else {\n            print!(\"Error creating scene\\n\");\n        }\n    }\n}\n\nfn add_shape_to_scene(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT == 0 {\n            print!(\"No scenes available. Create a scene first.\\n\");\n            return;\n        }\n\n        print!(\"Select scene (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let scene_idx = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n            print!(\"Invalid scene index\\n\");\n            return;\n        }\n\n        print!(\"\\nSelect shape to add:\\n\");\n        for i in 0..SHAPE_COUNT {\n            print!(\"{}. {}\\n\", i, shape_type_name_i32(i));\n        }\n        print!(\"Choice: \");\n        let _ = io::stdout().flush();\n\n        let shape_type = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if shape_type < 0 || shape_type >= SHAPE_COUNT {\n            print!(\"Invalid shape type\\n\");\n            return;\n        }\n\n        let shape_ptr = shape_get_by_index(shape_type);\n        if scene_add_shape(SCENES[scene_idx as usize], shape_ptr) == 0 {\n            let sh = &*shape_ptr;\n            print!(\n                \"Shape '{}' added to scene (reusing singleton at {})\\n\",\n                sh.name,\n                util::format_ptr(shape_ptr as *const u8)\n            );\n        } else {\n            print!(\"Error adding shape\\n\");\n        }\n    }\n}\n\nfn remove_shape_from_scene(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT == 0 {\n            print!(\"No scenes available\\n\");\n            return;\n        }\n\n        print!(\"Select scene (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let scene_idx = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n            print!(\"Invalid scene index\\n\");\n            return;\n        }\n\n        scene_list_shapes(SCENES[scene_idx as usize]);\n\n        let scene_ref = &*SCENES[scene_idx as usize];\n        if scene_ref.shape_count == 0 {\n            print!(\"Scene is empty\\n\");\n            return;\n        }\n\n        print!(\n            \"Select shape to remove (1-{}): \",\n            scene_ref.shape_count\n        );\n        let _ = io::stdout().flush();\n        let shape_idx = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if scene_remove_shape(SCENES[scene_idx as usize], shape_idx - 1) == 0 {\n            print!(\"Shape removed\\n\");\n        } else {\n            print!(\"Error removing shape\\n\");\n        }\n    }\n}\n\nfn view_scene(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT == 0 {\n            print!(\"No scenes available\\n\");\n            return;\n        }\n\n        print!(\"Select scene (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let scene_idx = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n            print!(\"Invalid scene index\\n\");\n            return;\n        }\n\n        scene_print(SCENES[scene_idx as usize]);\n    }\n}\n\nfn list_all_scenes() {\n    print!(\"\\n=== All Scenes ===\\n\");\n    unsafe {\n        if SCENE_COUNT == 0 {\n            print!(\"No scenes created yet\\n\");\n            return;\n        }\n        for i in 0..SCENE_COUNT {\n            let s = &*SCENES[i as usize];\n            print!(\"{}. {} ({} shapes)\\n\", i, s.name, s.shape_count);\n        }\n    }\n}\n\nfn save_scene_to_file(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT == 0 {\n            print!(\"No scenes available\\n\");\n            return;\n        }\n\n        print!(\"Select scene (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let scene_idx = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n            print!(\"Invalid scene index\\n\");\n            return;\n        }\n\n        print!(\"Enter filename: \");\n        let _ = io::stdout().flush();\n        let mut filename = match stdin.fgets(256) {\n            Some(s) => s,\n            None => return,\n        };\n        strip_newline(&mut filename);\n\n        scene_save(SCENES[scene_idx as usize], &filename);\n    }\n}\n\nfn load_scene_from_file(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT as usize >= MAX_SCENES {\n            print!(\"Error: Maximum scenes reached\\n\");\n            return;\n        }\n\n        print!(\"Enter filename: \");\n        let _ = io::stdout().flush();\n        let mut filename = match stdin.fgets(256) {\n            Some(s) => s,\n            None => return,\n        };\n        strip_newline(&mut filename);\n\n        let scene_ptr = scene_load(&filename);\n        if !scene_ptr.is_null() {\n            SCENES[SCENE_COUNT as usize] = scene_ptr;\n            SCENE_COUNT += 1;\n            print!(\"Scene loaded (index {})\\n\", SCENE_COUNT - 1);\n        }\n    }\n}\n\nfn compare_shapes(stdin: &mut StdinReader) {\n    print!(\"\\nSelect first shape (0-{}):\\n\", SHAPE_COUNT - 1);\n    for i in 0..SHAPE_COUNT {\n        print!(\"{}. {}\\n\", i, shape_type_name_i32(i));\n    }\n    print!(\"Choice: \");\n    let _ = io::stdout().flush();\n\n    let type1 = match stdin.scan_int() {\n        Some(v) => v,\n        None => {\n            print!(\"Invalid input\\n\");\n            stdin.consume_line();\n            return;\n        }\n    };\n    stdin.consume_line();\n\n    print!(\"\\nSelect second shape (0-{}): \", SHAPE_COUNT - 1);\n    let _ = io::stdout().flush();\n    let type2 = match stdin.scan_int() {\n        Some(v) => v,\n        None => {\n            print!(\"Invalid input\\n\");\n            stdin.consume_line();\n            return;\n        }\n    };\n    stdin.consume_line();\n\n    if type1 < 0 || type1 >= SHAPE_COUNT || type2 < 0 || type2 >= SHAPE_COUNT {\n        print!(\"Invalid shape type\\n\");\n        return;\n    }\n\n    let s1 = shape_get_by_index(type1);\n    let s2 = shape_get_by_index(type2);\n\n    unsafe {\n        let s1r = &*s1;\n        let s2r = &*s2;\n        print!(\n            \"\\nShape 1: {} (ptr: {})\\n\",\n            s1r.name,\n            util::format_ptr(s1 as *const u8)\n        );\n        print!(\n            \"Shape 2: {} (ptr: {})\\n\",\n            s2r.name,\n            util::format_ptr(s2 as *const u8)\n        );\n        // C's `s1 == s2` returns 0 or 1 (int)\n        let cmp = if std::ptr::eq(s1, s2) { 1 } else { 0 };\n        print!(\"Comparison of pointers: {}\\n\", cmp);\n\n        if shape_equals(s1 as *const Shape, s2 as *const Shape) != 0 {\n            print!(\"Result: Shapes are EQUAL (same instance)\\n\");\n        } else {\n            print!(\"Result: Shapes are NOT EQUAL (different instances)\\n\");\n        }\n    }\n}\n\nfn compare_scenes(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT < 2 {\n            print!(\"Need at least 2 scenes to compare\\n\");\n            return;\n        }\n\n        print!(\"Select first scene (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let idx1 = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        print!(\"Select second scene (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let idx2 = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if idx1 < 0 || idx1 >= SCENE_COUNT || idx2 < 0 || idx2 >= SCENE_COUNT {\n            print!(\"Invalid scene index\\n\");\n            return;\n        }\n\n        let sc1 = SCENES[idx1 as usize];\n        let sc2 = SCENES[idx2 as usize];\n        let sc1r = &*sc1;\n        let sc2r = &*sc2;\n\n        print!(\"\\nScene 1: {} ({} shapes)\\n\", sc1r.name, sc1r.shape_count);\n        scene_list_shapes(sc1);\n\n        print!(\"\\nScene 2: {} ({} shapes)\\n\", sc2r.name, sc2r.shape_count);\n        scene_list_shapes(sc2);\n\n        if scene_equals(sc1 as *const Scene, sc2 as *const Scene) != 0 {\n            print!(\"\\nResult: Scenes are EQUAL (1:1 correspondence)\\n\");\n        } else {\n            print!(\"\\nResult: Scenes are NOT EQUAL\\n\");\n        }\n    }\n}\n\nfn delete_scene(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT == 0 {\n            print!(\"No scenes available\\n\");\n            return;\n        }\n\n        print!(\"Select scene to delete (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let scene_idx = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n            print!(\"Invalid scene index\\n\");\n            return;\n        }\n\n        scene_destroy(SCENES[scene_idx as usize]);\n\n        let mut i = scene_idx;\n        while i < SCENE_COUNT - 1 {\n            SCENES[i as usize] = SCENES[(i + 1) as usize];\n            i += 1;\n        }\n\n        SCENE_COUNT -= 1;\n        print!(\"Scene deleted\\n\");\n    }\n}\n\nfn main() {\n    print!(\"╔════════════════════════════════════════╗\\n\");\n    print!(\"║  ASCII ART DRAWING APPLICATION        ║\\n\");\n    print!(\"║  Child-Friendly Shape Editor           ║\\n\");\n    print!(\"╚════════════════════════════════════════╝\\n\");\n\n    shape_manager_init();\n\n    let mut stdin = StdinReader::new();\n\n    loop {\n        print_menu();\n\n        let input = match stdin.fgets(256) {\n            Some(s) => s,\n            None => break,\n        };\n\n        // sscanf-style parse: skip leading whitespace, read int.\n        let trimmed = input.trim_start();\n        let choice_str: String = trimmed\n            .chars()\n            .take_while(|c| c.is_ascii_digit() || *c == '-' || *c == '+')\n            .collect();\n        let choice: i32 = match choice_str.parse() {\n            Ok(v) => v,\n            Err(_) => {\n                print!(\"Invalid input\\n\");\n                continue;\n            }\n        };\n\n        match choice {\n            1 => view_all_shapes(),\n            2 => create_new_scene(&mut stdin),\n            3 => add_shape_to_scene(&mut stdin),\n            4 => remove_shape_from_scene(&mut stdin),\n            5 => view_scene(&mut stdin),\n            6 => list_all_scenes(),\n            7 => save_scene_to_file(&mut stdin),\n            8 => load_scene_from_file(&mut stdin),\n            9 => compare_shapes(&mut stdin),\n            10 => compare_scenes(&mut stdin),\n            11 => delete_scene(&mut stdin),\n            12 => {\n                print!(\"\\nCleaning up and exiting...\\n\");\n                unsafe {\n                    for i in 0..SCENE_COUNT {\n                        scene_destroy(SCENES[i as usize]);\n                    }\n                }\n                shape_manager_cleanup();\n                print!(\"Goodbye!\\n\");\n                let _ = io::stdout().flush();\n                return;\n            }\n    