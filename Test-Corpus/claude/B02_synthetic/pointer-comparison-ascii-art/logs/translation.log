pub struct Scene {\n    pub name: String,\n    pub shapes: Vec<*mut Shape>,\n    pub shape_count: i32,\n}\n\n// Truncate a string to at most (max_bytes - 1) bytes, mimicking strncpy\n// followed by NUL-termination. Operates on raw bytes.\nfn truncate_to(name: &str, max_bytes: usize) -> String {\n    let bytes = name.as_bytes();\n    let take = bytes.len().min(max_bytes - 1);\n    // strncpy in C copies bytes; the result here might split a UTF-8\n    // multibyte sequence. Fall back to a lossy conversion for safety.\n    String::from_utf8_lossy(&bytes[..take]).into_owned()\n}\n\npub fn scene_create(name: Option<&str>) -> *mut Scene {\n    let scene_name = match name {\n        Some(n) => truncate_to(n, MAX_SCENE_NAME),\n        None => \"Untitled Scene\".to_string(),\n    };\n    let scene = Scene {\n        name: scene_name,\n        shapes: vec![std::ptr::null_mut(); MAX_SHAPES_IN_SCENE],\n        shape_count: 0,\n    };\n    Box::into_raw(Box::new(scene))\n}\n\npub fn scene_destroy(scene: *mut Scene) {\n    if !scene.is_null() {\n        unsafe {\n            let _ = Box::from_raw(scene);\n        }\n    }\n}\n\npub fn scene_add_shape(scene: *mut Scene, shape: *mut Shape) -> i32 {\n    if scene.is_null() || shape.is_null() {\n        return -1;\n    }\n    unsafe {\n        let s = &mut *scene;\n        if (s.shape_count as usize) >= MAX_SHAPES_IN_SCENE {\n            eprintln!(\"Error: Scene is full\");\n            return -1;\n        }\n        let idx = s.shape_count as usize;\n        s.shapes[idx] = shape;\n        s.shape_count += 1;\n        0\n    }\n}\n\npub fn scene_remove_shape(scene: *mut Scene, index: i32) -> i32 {\n    if scene.is_null() {\n        return -1;\n    }\n    unsafe {\n        let s = &mut *scene;\n        if index < 0 || index >= s.shape_count {\n            return -1;\n        }\n        let mut i = index as usize;\n        let count = s.shape_count as usize;\n        while i < count - 1 {\n            s.shapes[i] = s.shapes[i + 1];\n            i += 1;\n        }\n        s.shape_count -= 1;\n        0\n    }\n}\n\npub fn scene_print(scene: *const Scene) {\n    if scene.is_null() {\n        println!(\"(null scene)\");\n        return;\n    }\n    unsafe {\n        let s = &*scene;\n        println!(\"\\n=== Scene: {} ===\", s.name);\n        println!(\"Contains {} shape(s)\\n\", s.shape_count);\n        for i in 0..s.shape_count as usize {\n            println!(\"Shape #{}:\", i + 1);\n            shape_print(s.shapes[i] as *const Shape);\n            println!();\n        }\n    }\n}\n\npub fn scene_equals(s1: *const Scene, s2: *const Scene) -> i32 {\n    if s1.is_null() || s2.is_null() {\n        return 0;\n    }\n    unsafe {\n        let a = &*s1;\n        let b = &*s2;\n        if a.shape_count != b.shape_count {\n            return 0;\n        }\n        let mut matched = vec![0i32; MAX_SHAPES_IN_SCENE];\n        for i in 0..a.shape_count as usize {\n            let mut found = 0i32;\n            for j in 0..b.shape_count as usize {\n                if matched[j] == 0\n                    && shape_equals(a.shapes[i] as *const Shape, b.shapes[j] as *const Shape) != 0\n                {\n                    matched[j] = 1;\n                    found = 1;\n                    break;\n                }\n            }\n            if found == 0 {\n                return 0;\n            }\n        }\n        1\n    }\n}\n\npub fn scene_save(scene: *const Scene, filename: &str) -> i32 {\n    if scene.is_null() {\n        return -1;\n    }\n    unsafe {\n        let s = &*scene;\n        let mut file = match File::create(filename) {\n            Ok(f) => f,\n            Err(_) => {\n                eprintln!(\"Error: Could not open file '{}' for writing\", filename);\n                return -1;\n            }\n        };\n        let _ = writeln!(file, \"{}\", s.name);\n        let _ = writeln!(file, \"{}\", s.shape_count);\n        for i in 0..s.shape_count as usize {\n            let sh = &*s.shapes[i];\n            let _ = writeln!(file, \"{}\", sh.shape_type.as_i32());\n        }\n        // file is dropped (closed) at end of scope\n        drop(file);\n        println!(\"Scene saved to '{}'\", filename);\n        0\n    }\n}\n\npub fn scene_load(filename: &str) -> *mut Scene {\n    let file = match File::open(filename) {\n        Ok(f) => f,\n        Err(_) => {\n            eprintln!(\"Error: Could not open file '{}' for reading\", filename);\n            return std::ptr::null_mut();\n        }\n    };\n    let mut reader = BufReader::new(file);\n\n    // Read scene name (fgets-style — read up to MAX_SCENE_NAME bytes including newline)\n    let mut name_line = String::new();\n    match reader.read_line(&mut name_line) {\n        Ok(0) => return std::ptr::null_mut(),\n        Ok(_) => {}\n        Err(_) => return std::ptr::null_mut(),\n    }\n    // C uses fgets with MAX_SCENE_NAME buffer. fgets reads up to size-1 bytes.\n    // Truncate to MAX_SCENE_NAME-1 bytes max to mimic.\n    if name_line.len() > MAX_SCENE_NAME - 1 {\n        name_line.truncate(MAX_SCENE_NAME - 1);\n    }\n    // Strip trailing \\n (and \\r if present, though C only strips \\n)\n    if name_line.ends_with('\\n') {\n        name_line.pop();\n    }\n\n    let scene = scene_create(Some(&name_line));\n    if scene.is_null() {\n        return std::ptr::null_mut();\n    }\n\n    // Read shape count using fscanf-like behavior — read a line and parse int\n    let shape_count = match read_int(&mut reader) {\n        Some(v) => v,\n        None => {\n            scene_destroy(scene);\n            return std::ptr::null_mut();\n        }\n    };\n\n    for _ in 0..shape_count {\n        let t = match read_int(&mut reader) {\n            Some(v) => v,\n            None => {\n                scene_destroy(scene);\n                return std::ptr::null_mut();\n            }\n        };\n        let shape_ptr = shape_get_by_index(t);\n        if !shape_ptr.is_null() {\n            scene_add_shape(scene, shape_ptr);\n        }\n    }\n\n    println!(\"Scene loaded from '{}'\", filename);\n    scene\n}\n\n// Read an integer using fscanf-like semantics: skip whitespace, then parse digits.\nfn read_int<R: BufRead>(reader: &mut R) -> Option<i32> {\n    // Skip whitespace\n    let mut buf = [0u8; 1];\n    let mut sign: i32 = 1;\n    let mut digits = String::new();\n    let mut have_byte = false;\n    let mut last_byte = 0u8;\n\n    // Skip whitespace bytes\n    loop {\n        let n = reader.read(&mut buf).ok()?;\n        if n == 0 {\n            return None;\n        }\n        if !buf[0].is_ascii_whitespace() {\n            have_byte = true;\n            last_byte = buf[0];\n            break;\n        }\n    }\n\n    if have_byte {\n        if last_byte == b'-' {\n            sign = -1;\n        } else if last_byte == b'+' {\n            // skip\n        } else if last_byte.is_ascii_digit() {\n            digits.push(last_byte as char);\n        } else {\n            return None;\n        }\n    }\n\n    loop {\n        let n = match reader.read(&mut buf) {\n            Ok(n) => n,\n            Err(_) => break,\n        };\n        if n == 0 {\n            break;\n        }\n        if buf[0].is_ascii_digit() {\n            digits.push(buf[0] as char);\n        } else {\n            // We \"put back\" only matters if we needed to consume a non-numeric char\n            // For our usage (file with one int per line), the next char is \\n\n            // and we can drop it.\n            break;\n        }\n    }\n\n    if digits.is_empty() {\n        return None;\n    }\n    digits.parse::<i32>().ok().map(|v| v * sign)\n}\n\npub fn scene_list_shapes(scene: *const Scene) {\n    if scene.is_null() {\n        println!(\"(null scene)\");\n        return;\n    }\n    unsafe {\n        let s = &*scene;\n        println!(\"\\nScene: {}\", s.name);\n        println!(\"Shapes ({}):\", s.shape_count);\n        for i in 0..s.shape_count as usize {\n            let sh = &*s.shapes[i];\n            println!(\n                \"  {}. {} (ptr: {})\",\n                i + 1,\n                sh.name,\n                crate::util::format_ptr(s.shapes[i] as *const u8)\n            );\n        }\n    }\n}\n","userModified":false}}
