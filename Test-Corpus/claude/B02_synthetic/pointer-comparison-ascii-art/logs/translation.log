eType::Tree,\n        \"Tree\",\n        7,\n        11,\n        &[\n            \"    /\\\\    \",\n            \"   /  \\\\   \",\n            \"  /____\\\\  \",\n            \"  /    \\\\  \",\n            \" /______\\\\ \",\n            \"    ||    \",\n            \"    ||    \",\n        ],\n    )\n}\n\nfn init_tractor() -> Shape {\n    make_shape(\n        ShapeType::Tractor,\n        \"Tractor\",\n        6,\n        20,\n        &[\n            \"      ________     \",\n            \"     |        |___ \",\n            \"     |  []  []|   |\",\n            \"  ___|________|___|\",\n            \" /  o        o   \\\\\",\n            \"|___|        |___| \",\n        ],\n    )\n}\n\nfn init_house() -> Shape {\n    make_shape(\n        ShapeType::House,\n        \"House\",\n        7,\n        13,\n        &[\n            \"     /\\\\     \",\n            \"    /  \\\\    \",\n            \"   /____\\\\   \",\n            \"   |    |   \",\n            \"   | [] |   \",\n            \"   |    |   \",\n            \"   |____|   \",\n        ],\n    )\n}\n\nfn init_sun() -> Shape {\n    make_shape(\n        ShapeType::Sun,\n        \"Sun\",\n        7,\n        11,\n        &[\n            \"  \\\\  |  / \",\n            \"   \\\\ | /  \",\n            \"--- (@) ---\",\n            \"   / | \\\\  \",\n            \"  /  |  \\\\ \",\n            \"          \",\n            \"          \",\n        ],\n    )\n}\n\nfn init_cloud() -> Shape {\n    make_shape(\n        ShapeType::Cloud,\n        \"Cloud\",\n        4,\n        16,\n        &[\n            \"   _____       \",\n            \"  /     \\\\_    \",\n            \" /  ___  _\\\\  \",\n            \"(__/   \\\\_)   \",\n        ],\n    )\n}\n\nfn init_flower() -> Shape {\n    make_shape(\n        ShapeType::Flower,\n        \"Flower\",\n        7,\n        9,\n        &[\n            \"  \\\\|/  \",\n            \" -(@)- \",\n            \"  /|\\\\  \",\n            \"   |   \",\n            \"   |   \"