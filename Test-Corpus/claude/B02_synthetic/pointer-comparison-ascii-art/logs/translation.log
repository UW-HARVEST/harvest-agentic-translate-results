: \", SCENE_COUNT - 1);","         let scene_idx = match stdin.scan_int() {","             Some(v) => v,","             None => {","-                print!(\"Invalid input\\n\");","+                cprint!(\"Invalid input\\n\");","                 stdin.consume_line();","                 return;","             }"]},{"oldStart":585,"oldLines":7,"newStart":565,"newLines":7,"lines":["         stdin.consume_line();"," ","         if scene_idx < 0 || scene_idx >= SCENE_COUNT {","-            print!(\"Invalid scene index\\n\");","+            cprint!(\"Invalid scene index\\n\");","             return;","         }"," "]},{"oldStart":598,"oldLines":15,"newStart":578,"newLines":15,"lines":["         }"," ","         SCENE_COUNT -= 1;","-        print!(\"Scene deleted\\n\");","+        cprint!(\"Scene deleted\\n\");","     }"," }"," "," fn main() {","-    print!(\"╔════════════════════════════════════════╗\\n\");","-    print!(\"║  ASCII ART DRAWING APPLICATION        ║\\n\");","-    print!(\"║  Child-Friendly Shape Editor           ║\\n\");","-    print!(\"╚════════════════════════════════════════╝\\n\");","+    cprint!(\"╔════════════════════════════════════════╗\\n\");","+    cprint!(\"║  ASCII ART DRAWING APPLICATION        ║\\n\");","+    cprint!(\"║  Child-Friendly Shape Editor           ║\\n\");","+    cprint!(\"╚════════════════════════════════════════╝\\n\");"," ","     shape_manager_init();"," "]},{"oldStart":629,"oldLines":7,"newStart":609,"newLines":7,"lines":["         let choice: i32 = match choice_str.parse() {","             Ok(v) => v,","             Err(_) => {","-                print!(\"Invalid input\\n\");","+                cprint!(\"Invalid input\\n\");","                 continue;","             }","         };"]},{"oldStart":647,"oldLines":19,"newStart":627,"newLines":19,"lines":["             10 => compare_scenes(&mut stdin),","             11 => delete_scene(&mut stdin),","             12 => {","-                print!(\"\\nCleaning up and exiting...\\n\");","+                cprint!(\"\\nCleaning up and exiting...\\n\");","                 unsafe {","                     for i in 0..SCENE_COUNT {","                         scene_destroy(SCENES[i as usize]);","                     }","                 }","                 shape_manager_cleanup();","-                print!(\"Goodbye!\\n\");","-                let _ = io::stdout().flush();","+                cprint!(\"Goodbye!\\n\");","+                out::cout_flush();","                 return;","             }","             _ => {","-                print!(\"Invalid choice\\n\");","+                cprint!(\"Invalid choice\\n\");","             }","         }","     }"]},{"oldStart":671,"oldLines":5,"newStart":651,"newLines":5,"lines":["         }","     }","     shape_manager_cleanup();","-    let _ = io::stdout().flush();","+    out::cout_flush();"," }"]}],"originalFile":"// main.rs - Rust translation of main.c\nmod shape;\nmod scene;\nmod util;\nmod out;\n\nuse std::io::{self, BufRead, Read, Write};\nuse crate::out::{cout_print, cout_flush};\n\nuse shape::{\n    shape_equals, shape_get, shape_get_by_index, shape_manager_cleanup, shape_manager_init,\n    shape_print, shape_type_name_i32, ShapeType, Shape, MAX_SHAPE_NAME, SHAPE_COUNT,\n};\nuse scene::{\n    scene_add_shape, scene_create, scene_destroy, scene_equals, scene_list_shapes, scene_load,\n    scene_print, scene_remove_shape, scene_save, Scene, MAX_SCENE_NAME, MAX_SHAPES_IN_SCENE,\n};\n\nconst MAX_SCENES: usize = 10;\n\n// Global mutable state - similar to C's static globals.\n// Use a thread_local with RefCell since this program is single-threaded.\nstatic mut SCENES: [*mut Scene; MAX_SCENES] = [std::ptr::null_mut(); MAX_SCENES];\nstatic mut SCENE_COUNT: i32 = 0;\n\n/// A reader that mimics C stdin behavior. We read raw bytes from stdin so\n/// we can implement both line-based (fgets) and scanf-style integer reads.\nstruct StdinReader {\n    inner: io::BufReader<io::Stdin>,\n}\n\nimpl StdinReader {\n    fn new() -> Self {\n        Self {\n            inner: io::BufReader::new(io::stdin()),\n        }\n    }\n\n    /// Read a \"line\" up to size-1 bytes or a newline (inclusive).\n    /// Returns None on EOF (matches fgets returning NULL).\n    /// The trailing newline (if read) is included in the returned string.\n    fn fgets(&mut self, size: usize) -> Option<String> {\n        if size == 0 {\n            return None;\n        }\n        let mut buf = Vec::new();\n        let max = size - 1;\n        let mut byte = [0u8; 1];\n        let mut got_any = false;\n        while buf.len() < max {\n            match self.inner.read(&mut byte) {\n                Ok(0) => break,\n                Ok(_) => {\n                    got_any = true;\n                    buf.push(byte[0]);\n                    if byte[0] == b'\\n' {\n                        break;\n                    }\n                }\n                Err(_) => break,\n            }\n        }\n        if !got_any {\n            return None;\n        }\n        Some(String::from_utf8_lossy(&buf).into_owned())\n    }\n\n    /// Read characters until '\\n' is read (and consume it). Mimics\n    /// `while (getchar() != '\\n');`. Returns on EOF.\n    fn consume_line(&mut self) {\n        let mut byte = [0u8; 1];\n        loop {\n            match self.inner.read(&mut byte) {\n                Ok(0) => return,\n                Ok(_) => {\n                    if byte[0] == b'\\n' {\n                        return;\n                    }\n                }\n                Err(_) => return,\n            }\n        }\n    }\n\n    /// Read an integer with scanf(\"%d\") semantics: skip whitespace, then\n    /// read optional sign and digits. Returns None on failure (no digits).\n    /// Does NOT consume the trailing non-digit character (it stays in the\n    /// buffer just like scanf would behave). However, since we are reading\n    /// byte-by-byte from stdin, we have to use peek via fill_buf.\n    fn scan_int(&mut self) -> Option<i32> {\n        // Skip whitespace using fill_buf so we can ungetc-like\n        loop {\n            let buf = self.inner.fill_buf().ok()?;\n            if buf.is_empty() {\n                return None;\n            }\n            let mut consumed = 0usize;\n            let mut found_non_ws = false;\n            for &b in buf.iter() {\n                if (b as char).is_whitespace() {\n                    consumed += 1;\n                } else {\n                    found_non_ws = true;\n                    break;\n                }\n            }\n            self.inner.consume(consumed);\n            if found_non_ws {\n                break;\n            }\n        }\n\n        let mut sign: i32 = 1;\n        let mut digits: Vec<u8> = Vec::new();\n\n        // Check sign\n        {\n            let buf = self.inner.fill_buf().ok()?;\n            if buf.is_empty() {\n                return None;\n            }\n            let first = buf[0];\n            if first == b'-' {\n                sign = -1;\n                self.inner.consume(1);\n            } else if first == b'+' {\n                self.inner.consume(1);\n            }\n        }\n\n        // Read digits\n        loop {\n            let buf = match self.inner.fill_buf() {\n                Ok(b) => b,\n                Err(_) => break,\n            };\n            if buf.is_empty() {\n                break;\n            }\n            let mut consumed = 0usize;\n            let mut stop = false;\n            for &b in buf.iter() {\n                if b.is_ascii_digit() {\n                    digits.push(b);\n                    consumed += 1;\n                } else {\n                    stop = true;\n                    break;\n                }\n            }\n            self.inner.consume(consumed);\n            if stop {\n                break;\n            }\n        }\n\n        if digits.is_empty() {\n            return None;\n        }\n        let s = std::str::from_utf8(&digits).ok()?;\n        s.parse::<i32>().ok().map(|v| v * sign)\n    }\n}\n\nfn strip_newline(s: &mut String) {\n    // C does: name[strcspn(name, \"\\n\")] = 0;\n    // This finds the first '\\n' and replaces with 0, truncating the string there.\n    if let Some(pos) = s.find('\\n') {\n        s.truncate(pos);\n    }\n}\n\nfn print_menu() {\n    print!(\"\\n\");\n    print!(\"=========================================\\n\");\n    print!(\"  ASCII ART DRAWING APPLICATION\\n\");\n    print!(\"=========================================\\n\");\n    print!(\"1. View all available shapes\\n\");\n    print!(\"2. Create new scene\\n\");\n    print!(\"3. Add shape to scene\\n\");\n    print!(\"4. Remove shape from scene\\n\");\n    print!(\"5. View scene\\n\");\n    print!(\"6. List all scenes\\n\");\n    print!(\"7. Save scene\\n\");\n    print!(\"8. Load scene\\n\");\n    print!(\"9. Compare two shapes\\n\");\n    print!(\"10. Compare two scenes\\n\");\n    print!(\"11. Delete scene\\n\");\n    print!(\"12. Exit\\n\");\n    print!(\"=========================================\\n\");\n    print!(\"Choice: \");\n    let _ = io::stdout().flush();\n}\n\nfn view_all_shapes() {\n    print!(\"\\n=== Available Shapes ===\\n\");\n    for i in 0..SHAPE_COUNT {\n        print!(\"\\n{}. \", i + 1);\n        let t = ShapeType::from_i32(i).unwrap();\n        shape_print(shape_get(t) as *const Shape);\n    }\n}\n\nfn create_new_scene(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT as usize >= MAX_SCENES {\n            print!(\"Error: Maximum scenes reached\\n\");\n            return;\n        }\n    }\n\n    print!(\"Enter scene name: \");\n    let _ = io::stdout().flush();\n    let mut name = match stdin.fgets(MAX_SCENE_NAME) {\n        Some(n) => n,\n        None => return,\n    };\n    strip_newline(&mut name);\n\n    let scene_ptr = scene_create(Some(&name));\n    unsafe {\n        if !scene_ptr.is_null() {\n            SCENES[SCENE_COUNT as usize] = scene_ptr;\n            print!(\"Scene '{}' created (index {})\\n\", name, SCENE_COUNT);\n            SCENE_COUNT += 1;\n        } else {\n            print!(\"Error creating scene\\n\");\n        }\n    }\n}\n\nfn add_shape_to_scene(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT == 0 {\n            print!(\"No scenes available. Create a scene first.\\n\");\n            return;\n        }\n\n        print!(\"Select scene (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let scene_idx = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n            print!(\"Invalid scene index\\n\");\n            return;\n        }\n\n        print!(\"\\nSelect shape to add:\\n\");\n        for i in 0..SHAPE_COUNT {\n            print!(\"{}. {}\\n\", i, shape_type_name_i32(i));\n        }\n        print!(\"Choice: \");\n        let _ = io::stdout().flush();\n\n        let shape_type = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if shape_type < 0 || shape_type >= SHAPE_COUNT {\n            print!(\"Invalid shape type\\n\");\n            return;\n        }\n\n        let shape_ptr = shape_get_by_index(shape_type);\n        if scene_add_shape(SCENES[scene_idx as usize], shape_ptr) == 0 {\n            let sh = &*shape_ptr;\n            print!(\n                \"Shape '{}' added to scene (reusing singleton at {})\\n\",\n                sh.name,\n                util::format_ptr(shape_ptr as *const u8)\n            );\n        } else {\n            print!(\"Error adding shape\\n\");\n        }\n    }\n}\n\nfn remove_shape_from_scene(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT == 0 {\n            print!(\"No scenes available\\n\");\n            return;\n        }\n\n        print!(\"Select scene (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let scene_idx = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n            print!(\"Invalid scene index\\n\");\n            return;\n        }\n\n        scene_list_shapes(SCENES[scene_idx as usize]);\n\n        let scene_ref = &*SCENES[scene_idx as usize];\n        if scene_ref.shape_count == 0 {\n            print!(\"Scene is empty\\n\");\n            return;\n        }\n\n        print!(\n            \"Select shape to remove (1-{}): \",\n            scene_ref.shape_count\n        );\n        let _ = io::stdout().flush();\n        let shape_idx = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if scene_remove_shape(SCENES[scene_idx as usize], shape_idx - 1) == 0 {\n            print!(\"Shape removed\\n\");\n        } else {\n            print!(\"Error removing shape\\n\");\n        }\n    }\n}\n\nfn view_scene(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT == 0 {\n            print!(\"No scenes available\\n\");\n            return;\n        }\n\n        print!(\"Select scene (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let scene_idx = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n            print!(\"Invalid scene index\\n\");\n            return;\n        }\n\n        scene_print(SCENES[scene_idx as usize]);\n    }\n}\n\nfn list_all_scenes() {\n    print!(\"\\n=== All Scenes ===\\n\");\n    unsafe {\n        if SCENE_COUNT == 0 {\n            print!(\"No scenes created yet\\n\");\n            return;\n        }\n        for i in 0..SCENE_COUNT {\n            let s = &*SCENES[i as usize];\n            print!(\"{}. {} ({} shapes)\\n\", i, s.name, s.shape_count);\n        }\n    }\n}\n\nfn save_scene_to_file(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT == 0 {\n            print!(\"No scenes available\\n\");\n            return;\n        }\n\n        print!(\"Select scene (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let scene_idx = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n            print!(\"Invalid scene index\\n\");\n            return;\n        }\n\n        print!(\"Enter filename: \");\n        let _ = io::stdout().flush();\n        let mut filename = match stdin.fgets(256) {\n            Some(s) => s,\n            None => return,\n        };\n        strip_newline(&mut filename);\n\n        scene_save(SCENES[scene_idx as usize], &filename);\n    }\n}\n\nfn load_scene_from_file(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT as usize >= MAX_SCENES {\n            print!(\"Error: Maximum scenes reached\\n\");\n            return;\n        }\n\n        print!(\"Enter filename: \");\n        let _ = io::stdout().flush();\n        let mut filename = match stdin.fgets(256) {\n            Some(s) => s,\n            None => return,\n        };\n        strip_newline(&mut filename);\n\n        let scene_ptr = scene_load(&filename);\n        if !scene_ptr.is_null() {\n            SCENES[SCENE_COUNT as usize] = scene_ptr;\n            SCENE_COUNT += 1;\n            print!(\"Scene loaded (index {})\\n\", SCENE_COUNT - 1);\n        }\n    }\n}\n\nfn compare_shapes(stdin: &mut StdinReader) {\n    print!(\"\\nSelect first shape (0-{}):\\n\", SHAPE_COUNT - 1);\n    for i in 0..SHAPE_COUNT {\n        print!(\"{}. {}\\n\", i, shape_type_name_i32(i));\n    }\n    print!(\"Choice: \");\n    let _ = io::stdout().flush();\n\n    let type1 = match stdin.scan_int() {\n        Some(v) => v,\n        None => {\n            print!(\"Invalid input\\n\");\n            stdin.consume_line();\n            return;\n        }\n    };\n    stdin.consume_line();\n\n    print!(\"\\nSelect second shape (0-{}): \", SHAPE_COUNT - 1);\n    let _ = io::stdout().flush();\n    let type2 = match stdin.scan_int() {\n        Some(v) => v,\n        None => {\n            print!(\"Invalid input\\n\");\n            stdin.consume_line();\n            return;\n        }\n    };\n    stdin.consume_line();\n\n    if type1 < 0 || type1 >= SHAPE_COUNT || type2 < 0 || type2 >= SHAPE_COUNT {\n        print!(\"Invalid shape type\\n\");\n        return;\n    }\n\n    let s1 = shape_get_by_index(type1);\n    let s2 = shape_get_by_index(type2);\n\n    unsafe {\n        let s1r = &*s1;\n        let s2r = &*s2;\n        print!(\n            \"\\nShape 1: {} (ptr: {})\\n\",\n            s1r.name,\n            util::format_ptr(s1 as *const u8)\n        );\n        print!(\n            \"Shape 2: {} (ptr: {})\\n\",\n            s2r.name,\n            util::format_ptr(s2 as *const u8)\n        );\n        // C's `s1 == s2` returns 0 or 1 (int)\n        let cmp = if std::ptr::eq(s1, s2) { 1 } else { 0 };\n        print!(\"Comparison of pointers: {}\\n\", cmp);\n\n        if shape_equals(s1 as *const Shape, s2 as *const Shape) != 0 {\n            print!(\"Result: Shapes are EQUAL (same instance)\\n\");\n        } else {\n            print!(\"Result: Shapes are NOT EQUAL (different instances)\\n\");\n        }\n    }\n}\n\nfn compare_scenes(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT < 2 {\n            print!(\"Need at least 2 scenes to compare\\n\");\n            return;\n        }\n\n        print!(\"Select first scene (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let idx1 = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        print!(\"Select second scene (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let idx2 = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if idx1 < 0 || idx1 >= SCENE_COUNT || idx2 < 0 || idx2 >= SCENE_COUNT {\n            print!(\"Invalid scene index\\n\");\n            return;\n        }\n\n        let sc1 = SCENES[idx1 as usize];\n        let sc2 = SCENES[idx2 as usize];\n        let sc1r = &*sc1;\n        let sc2r = &*sc2;\n\n        print!(\"\\nScene 1: {} ({} shapes)\\n\", sc1r.name, sc1r.shape_count);\n        scene_list_shapes(sc1);\n\n        print!(\"\\nScene 2: {} ({} shapes)\\n\", sc2r.name, sc2r.shape_count);\n        scene_list_shapes(sc2);\n\n        if scene_equals(sc1 as *const Scene, sc2 as *const Scene) != 0 {\n            print!(\"\\nResult: Scenes are EQUAL (1:1 correspondence)\\n\");\n        } else {\n            print!(\"\\nResult: Scenes are NOT EQUAL\\n\");\n        }\n    }\n}\n\nfn delete_scene(stdin: &mut StdinReader) {\n    unsafe {\n        if SCENE_COUNT == 0 {\n            print!(\"No scenes available\\n\");\n            return;\n        }\n\n        print!(\"Select scene to delete (0-{}): \", SCENE_COUNT - 1);\n        let _ = io::stdout().flush();\n        let scene_idx = match stdin.scan_int() {\n            Some(v) => v,\n            None => {\n                print!(\"Invalid input\\n\");\n                stdin.consume_line();\n                return;\n            }\n        };\n        stdin.consume_line();\n\n        if scene_idx < 0 || scene_idx >= SCENE_COUNT {\n            print!(\"Invalid scene index\\n\");\n            return;\n        }\n\n        scene_destroy(SCENES[scene_idx as usize]);\n\n        let mut i = scene_idx;\n        while i < SCENE_COUNT - 1 {\n            SCENES[i as usize] = SCENES[(i + 1) as usize];\n            i += 1;\n        }\n\n        SCENE_COUNT -= 1;\n        print!(\"Scene deleted\\n\");\n    }\n}\n\nfn main() {\n    print!(\"╔════════════════════════════════════════╗\\n\");\n    print!(\"║  ASCII ART DRAWING APPLICATION        ║\\n\");\n    print!(\"║  Child-Friendly Shape Editor           ║\\n\");\n    print!(\"╚════════════════════════════════════════╝\\n\");\n\n    shape_manager_init();\n\n    let mut stdin = StdinReader::new();\n\n    loop {\n        print_menu();\n\n        let input = match stdin.fgets(256) {\n            Some(s) => s,\n            None => break,\n        };\n\n        // sscanf-style parse: skip leading whitespace, read int.\n        let trimmed = input.trim_start();\n        let choice_str: String = trimmed\n            .chars()\n            .take_while(|c| c.is_ascii_digit() || *c == '-' || *c == '+')\n            .collect();\n        let choice: i32 = match choice_str.parse() {\n            Ok(v) => v,\n            Err(_) => {\n                print!(\"Invalid input\\n\");\n                continue;\n            }\n        };\n\n        match choice {\n            1 => view_all_shapes(),\n            2 => create_new_scene(&mut stdin),\n            3 => add_shape_to_scene(&mut stdin),\n            4 => remove_shape_from_scene(&mut stdin),\n            5 => view_scene(&mut stdin),\n            6 => list_all_scenes(),\n            7 => save_scene_to_file(&mut stdin),\n            8 => load_scene_from_file(&mut stdin),\n            9 => compare_shapes(&mut stdin),\n            10 => compare_scenes(&mut stdin),\n            11 => delete_scene(&mut stdin),\n            12 => {\n                print!(\"\\nCleaning up and exiting...\\n\");\n                unsafe {\n                    for i in 0..SCENE_COUNT {\n                        scene_destroy(SCENES[i as usize]);\n                    }\n                }\n                shape_manager_cleanup();\n                print!(\"Goodbye!\\n\");\n                let _ = io::stdout().flush();\n                return;\n            }\n            _ => {\n                print!(\"Invalid choice\\n\");\n            }\n        }\n    }\n\n    // Cleanup on EOF break\n    unsafe {\n        for i in 0..SCENE_COUNT {\n            scene_destroy(SCENES[i as usize]);\n        }\n    }\n    shape_manager_cleanup();\n    let _ = io::stdout().flush();\n}\n","userModified":false}}
