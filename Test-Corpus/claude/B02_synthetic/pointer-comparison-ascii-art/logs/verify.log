{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018sYzYXH8hhs1bGN9uZsRnT","type":"tool_result","content":"1\t// tests/common/mod.rs\n2\t//\n3\t// Shared test infrastructure: loads both the C and Rust shared libraries via\n4\t// libloading and exposes their symbols for byte-level comparison tests.\n5\t\n6\tuse libloading::{Library, Symbol};\n7\tuse std::os::raw::{c_char, c_int};\n8\tuse std::path::PathBuf;\n9\tuse std::sync::{Mutex, MutexGuard, OnceLock};\n10\t\n11\t/// Global lock — both the C and Rust libraries keep process-wide singleton\n12\t/// state (shape_manager) and tests must run serialized.\n13\tfn test_lock() -> &'static Mutex<()> {\n14\t    static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n15\t    LOCK.get_or_init(|| Mutex::new(()))\n16\t}\n17\t\n18\t/// Acquire the global test lock for the duration of the test.\n19\tpub fn acquire_lock() -> MutexGuard<'static, ()> {\n20\t    match test_lock().lock() {\n21\t        Ok(g) => g,\n22\t        Err(p) => p.into_inner(), // continue even on poison\n23\t    }\n24\t}\n25\t\n26\tpub const MAX_SCENE_NAME: usize = 64;\n27\tpub const MAX_SHAPES_IN_SCENE: usize = 50;\n28\tpub const MAX_SHAPE_NAME: usize = 32;\n29\tpub const MAX_SHAPE_WIDTH: usize = 80;\n30\tpub const MAX_SHAPE_HEIGHT: usize = 30;\n31\tpub const SHAPE_COUNT: c_int = 10;\n32\t\n33\t#[repr(C)]\n34\tpub struct ShapeC {\n35\t    pub type_: c_int,\n36\t    pub name: [c_char; MAX_SHAPE_NAME],\n37\t    pub art: [[c_char; MAX_SHAPE_WIDTH]; MAX_SHAPE_HEIGHT],\n38\t    pub width: c_int,\n39\t    pub height: c_int,\n40\t}\n41\t\n42\t#[repr(C)]\n43\tpub struct SceneC {\n44\t    pub name: [c_char; MAX_SCENE_NAME],\n45\t    pub shapes: [*mut ShapeC; MAX_SHAPES_IN_SCENE],\n46\t    pub shape_count: c_int,\n47\t}\n48\t\n49\tpub struct LoadedLib {\n50\t    pub lib: &'static Library,"}]},"parent_tool_use_id":null,"session_id":"299b5348-af19-4700-b09c-f31aaeea6bb0","uuid":"14cb506d-c8da-42b4-9208-22fa6e2cf045","timestamp":"2026-06-10T03:3