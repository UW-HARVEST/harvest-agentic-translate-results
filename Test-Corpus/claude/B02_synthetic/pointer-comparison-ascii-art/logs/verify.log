         *v[ShapeType::Sun as usize] = init_sun();\n275\t            *v[ShapeType::Cloud as usize] = init_cloud();\n276\t            *v[ShapeType::Flower as usize] = init_flower();\n277\t            *v[ShapeType::Car as usize] = init_car();\n278\t            *v[ShapeType::Star as usize] = init_star();\n279\t            *v[ShapeType::Heart as usize] = init_heart();\n280\t            *v[ShapeType::Rainbow as usize] = init_rainbow();\n281\t        }\n282\t        ShapesWrapper(v)\n283\t    });\n284\t}\n285\t\n286\tpub fn shape_manager_cleanup() {\n287\t    // The C version frees the singletons. In Rust, we leak them since they\n288\t    // are static for the program's lifetime; cleanup is a no-op effectively\n289\t    // because OnceLock holds the Vec for the program lifetime.\n290\t    // To match C's behavior of \"free\", we'd need to reset the OnceLock, but\n291\t    // that's not directly supported. Since the program is exiting, this is fine.\n292\t}\n293\t\n294\tpub fn shape_get(t: ShapeType) -> *mut Shape {\n295\t    let v = SHAPES.get().expect(\"shape_manager_init not called\");\n296\t    v.0[t as usize]\n297\t}\n298\t\n299\tpub fn shape_get_by_index(i: i32) -> *mut Shape {\n300\t    if i < 0 || i >= SHAPE_COUNT {\n301\t        return std::ptr::null_mut();\n302\t    }\n303\t    let v = SHAPES.get().expect(\"shape_manager_init not called\");\n304\t    v.0[i as usize]\n305\t}\n306\t\n307\tpub fn shape_print(shape: *const Shape) {\n308\t    if shape.is_null() {\n309\t        cprint!(\"(null shape)\\n\");\n310\t        return;\n311\t    }\n312\t    unsafe {\n313\t        let s = &*shape;\n314\t        cprint!(\"{}:\\n\", s.name);\n315\t        for i in 0..s.height as usize {\n316\t            cprint!(\"{}\\n\", s.art[i]);\n317\t        }\n318\t    }\n319\t}\n320\t\n321\tpub fn shape_equals(s1: *const Shape, s2: *const Shape) -> i32 {\n322\t    if std::ptr::eq(s1, s2) {\n323\t        1\n324\t    } else {\n325\t        0\n326\t    }\n327\t}\n328\t\n329\tpub fn shape_t