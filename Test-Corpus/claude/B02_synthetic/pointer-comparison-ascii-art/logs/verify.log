t.join(\"c_lib_build/libdriver_c.so\");\n    let lib_ref = *ONCE.get_or_init(|| load_leaked(&path));\n    LoadedLib {\n        lib: LibRef::Static(lib_ref),\n    }\n}\n\npub fn load_rust() -> LoadedLib {\n    static ONCE: OnceLock<&'static Library> = OnceLock::new();\n    let root = workspace_root();\n    let candidates = [\n        root.join(\"target/debug/libdriver.so\"),\n        root.join(\"target/release/libdriver.so\"),\n    ];\n    let path = candidates\n        .iter()\n        .find(|p| p.exists())\n        .expect(\"Rust libdriver.so not found; run `cargo build` first\")\n        .clone();\n    let lib_ref = *ONCE.get_or_init(|| load_leaked(&path));\n    LoadedLib {\n        lib: LibRef::Static(lib_ref),\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":882,"cache_read_input_tokens":91324,"cache_creation":{"ephemeral_5m_input_tokens":882,"ephemeral_1h_input_tokens":0},"output_tokens":39,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"299b5348-af19-4700-b09c-f31aaeea6bb0","uuid":"4bb368c9-d8bc-42da-9834-d662476085d2"}
