  \n229\t    if (scene_idx < 0 || scene_idx >= scene_count) {\n230\t        printf(\"Invalid scene index\\n\");\n231\t        return;\n232\t    }\n233\t    \n234\t    char filename[256];\n235\t    printf(\"Enter filename: \");\n236\t    if (fgets(filename, sizeof(filename), stdin) == NULL) {\n237\t        return;\n238\t    }\n239\t    filename[strcspn(filename, \"\\n\")] = 0;\n240\t    \n241\t    scene_save(scenes[scene_idx], filename);\n242\t}\n243\t\n244\tvoid load_scene_from_file(void) {\n245\t    if (scene_count >= MAX_SCENES) {\n246\t        printf(\"Error: Maximum scenes reached\\n\");\n247\t        return;\n248\t    }\n249\t    \n250\t    char filename[256];\n251\t    printf(\"Enter filename: \");\n252\t    if (fgets(filename, sizeof(filename), stdin) == NULL) {\n253\t        return;\n254\t    }\n255\t    filename[strcspn(filename, \"\\n\")] = 0;\n256\t    \n257\t    scene_t *scene = scene_load(filename);\n258\t    if (scene) {\n259\t        scenes[scene_count++] = scene;\n260\t        printf(\"Scene loaded (index %d)\\n\", scene_count - 1);\n261\t    }\n262\t}\n263\t\n264\tvoid compare_shapes(void) {\n265\t    printf(\"\\nSelect first shape (0-%d):\\n\", SHAPE_COUNT - 1);\n266\t    for (int i = 0; i < SHAPE_COUNT; i++) {\n267\t        printf(\"%d. %s\\n\", i, shape_type_name((shape_type_t)i));\n268\t    }\n269\t    printf(\"Choice: \");\n270\t    \n271\t    int type1;\n272\t    if (scanf(\"%d\", &type1) != 1) {\n273\t        printf(\"Invalid input\\n\");\n274\t        while (getchar() != '\\n');\n275\t        return;\n276\t    }\n277\t    while (getchar() != '\\n');\n278\t    \n279\t    printf(\"\\nSelect second shape (0-%d): \", SHAPE_COUNT - 1);\n280\t    int type2;\n281\t    if (scanf(\"%d\", &type2) != 1) {\n282\t        printf(\"Invalid input\\n\");\n283\t        while (getchar() != '\\n');\n284\t        return;\n285\t    }\n286\t    while (getchar() != '\\n');\n287\t    \n288\t    if (type1 < 0 || type1 >= SHAPE_COUNT || type2 < 0 || type2 >= SHAPE_COUNT) {\n289\t        printf(\"Invalid shape type\\n\");\n290\t        return;\n291\t    }\n292\t    \n293\t    shape_t *s1 = shape_get((shape_type_t)type1);\n294\t    shape_t *s2 = shape_get((shape_type_t)type2);\n295\t    \n296\t    printf(\"\\nShape 1: %s (ptr: %p)\\n\", s1->name, (void*)s1);\n297\t    printf(\"Shape 2: %s (ptr: %p)\\n\", s2->name, (void*)s2);\n298\t    printf(\"Comparison of pointers: %d\\n\", s1 == s2);\n299\t    \n300\t    if (shape_equals(s1, s2)) {\n301\t        printf(\"Result: Shapes are EQUAL (same instance)\\n\");\n302\t    } else {\n303\t        printf(\"Result: Shapes are NOT EQUAL (different instances)\\n\");\n304\t    }\n305\t}\n306\t\n307\tvoid compare_scenes(void) {\n308\t    if (scene_count < 2) {\n309\t        printf(\"Need at least 2 scenes to compare\\n\");\n310\t        return;\n311\t    }\n312\t    \n313\t    printf(\"Select first scene (0-%d): \", scene_count - 1);\n314\t    int idx1;\n315\t    if (scanf(\"%d\", &idx1) != 1) {\n316\t        printf(\"Invalid input\\n\");\n317\t        while (getchar() != '\\n');\n318\t        return;\n319\t    }\n320\t    while (getchar() != '\\n');\n321\t    \n322\t    printf(\"Select second scene (0-%d): \", scene_count - 1);\n323\t    int idx2;\n324\t    if (scanf(\"%d\", &idx2) != 1) {\n325\t        printf(\"Invalid input\\n\");\n326\t        while (getchar() != '\\n');\n327\t        return;\n328\t    }\n329\t    while (getchar() != '\\n');\n330\t    \n331\t    if (idx1 < 0 || idx1 >= scene_count || idx2 < 0 || idx2 >= scene_count) {\n332\t        printf(\"Invalid scene index\\n\");\n333\t        return;\n334\t    }\n335\t    \n336\t    scene_t *sc1 = scenes[idx1];\n337\t    scene_t *sc2 = scenes[idx2];\n338\t    \n339\t    printf(\"\\nScene 1: %s (%d shapes)\\n\", sc1->name, sc1->shape_count);\n340\t    scene_list_shapes(sc1);\n341\t    \n342\t    printf(\"\\nScene 2: %s (%d shapes)\\n\", sc2->name, sc2->shape_count);\n343\t    scene_list_shapes(sc2);\n344\t    \n345\t    if (scene_equals(