 \\\\  \");\n45\t    strcpy(shape->art[4], \" /______\\\\ \");\n46\t    strcpy(shape->art[5], \"    ||    \");\n47\t    strcpy(shape->art[6], \"    ||    \");\n48\t}\n49\t\n50\tstatic void init_tractor(shape_t *shape) {\n51\t    shape->type = SHAPE_TRACTOR;\n52\t    strcpy(shape->name, \"Tractor\");\n53\t    shape->height = 6;\n54\t    shape->width = 20;\n55\t    \n56\t    strcpy(shape->art[0], \"      ________     \");\n57\t    strcpy(shape->art[1], \"     |        |___ \");\n58\t    strcpy(shape->art[2], \"     |  []  []|   |\");\n59\t    strcpy(shape->art[3], \"  ___|________|___|\");\n60\t    strcpy(shape->art[4], \" /  o        o   \\\\\");\n61\t    strcpy(shape->art[5], \"|___|        |___| \");\n62\t}\n63\t\n64\tstatic void init_house(shape_t *shape) {\n65\t    shape->type = SHAPE_HOUSE;\n66\t    strcpy(shape->name, \"House\");\n67\t    shape->height = 7;\n68\t    shape->width = 13;\n69\t    \n70\t    strcpy(shape->art[0], \"     /\\\\     \");\n71\t    strcpy(shape->art[1], \"    /  \\\\    \");\n72\t    strcpy(shape->art[2], \"   /____\\\\   \");\n73\t    strcpy(shape->art[3], \"   |    |   \");\n74\t    strcpy(shape->art[4], \"   | [] |   \");\n75\t    strcpy(shape->art[5], \"   |    |   \");\n76\t    strcpy(shape->art[6], \"   |____|   \");\n77\t}\n78\t\n79\tstatic void init_sun(shape_t *shape) {\n80\t    shape->type = SHAPE_SUN;\n81\t    strcpy(shape->name, \"Sun\");\n82\t    shape->height = 7;\n83\t    shape->width = 11;\n84\t    \n85\t    strcpy(shape->art[0], \"  \\\\  |  / \");\n86\t    strcpy(shape->art[1], \"   \\\\ | /  \");\n87\t    strcpy(shape->art[2], \"--- (@) ---\");\n88\t    strcpy(shape->art[3], \"   / | \\\\  \");\n89\t    strcpy(shape->art[4], \"  /  |  \\\\ \");\n90\t    strcpy(shape->art[5], \"          \");\n91\t    strcpy(shape->art[6], \"          \");\n92\t}\n93\t\n94\tstatic void init_cloud(shape_t *shape) {\n95\t    shape->type = SHAPE_CLOUD;\n96\t    strcpy(shape->name, \"Cloud\");\n97\t    shape->height = 4;\n98\t    shape->width = 16;\n99\t    \n100\t    strcpy(shape->art[0], \"   _____       \");\n101\t    strcpy(shape->art[1], \"  /     \\\\_    \");\n102\t    strcpy(shape->art[2], \" /  ___  _\\\\  \");\n103\t    strcpy(shape->art[3], \"(__/   \\\\_)   \");\n104\t}\n105\t\n106\tstatic void init_flower(shape_t *shape) {\n107\t    shape->type = SHAPE_FLOWER;\n108\t    strcpy(shape->name, \"Flower\");\n109\t    shape->height = 7;\n110\t    shape->width = 9;\n111\t    \n112\t    strcpy(shape->art[0], \"  \\\\|/  \");\n113\t    strcpy(shape->art[1], \" -(@)- \");\n114\t    strcpy(shape->art[2], \"  /|\\\\  \");\n115\t    strcpy(shape->art[3], \"   |   \");\n116\t    strcpy(shape->art[4], \"   |   \");\n117\t    strcpy(shape->art[5], \"  / \\\\  \");\n118\t    strcpy(shape->art[6], \" /   \\\\ \");\n119\t}\n120\t\n121\tstatic void init_car(shape_t *shape) {\n122\t    shape->type = SHAPE_CAR;\n123\t    strcpy(shape->name, \"Car\");\n124\t    shape->height = 4;\n125\t    shape->width = 16;\n126\t    \n127\t    strcpy(shape->art[0], \"  ____       \");\n128\t    strcpy(shape->art[1], \" /|_||_\\\\____ \");\n129\t    strcpy(shape->art[2], \"( o     o  ) \");\n130\t    strcpy(shape->art[3], \" -----------  \");\n131\t}\n132\t\n133\tstatic void init_star(shape_t *shape) {\n134\t    shape->type = SHAPE_STAR;\n135\t    strcpy(shape->name, \"Star\");\n136\t    shape->height = 5;\n137\t    shape->width = 9;\n138\t    \n139\t    strcpy(shape->art[0], \"    *    \");\n140\t    strcpy(shape->art[1], \"   ***   \");\n141\t    strcpy(shape->art[2], \"  *****  \");\n142\t    strcpy(shape->art[3], \" ******* \");\n143\t    strcpy(shape->art[4], \"*********\");\n144\t}\n145\t\n146\tstatic void init_heart(shape_t *shape) {\n147\t    shape->type = SHAPE_HEART;\n148\t    strcpy(shape->name, \"Heart\");\n149\t    shape->height = 6;\n150\t    shape->width = 11;\n151\t    \n152\t    strcpy(shape->art[0], \" *** ***  \");\n153\t    strcpy(shape->art[1], \"*********  \");\n154\t    strcpy(shape->art[2], \"********* 