T;\n170\t    run_loop(&mut acc);\n171\t    println!(\"helper.call={} helper.acc={}\", r, acc);\n172\t    r.wrapping_add(acc)\n173\t}\n174\t\n175\t#[unsafe(no_mangle)]\n176\tpub extern \"C\" fn helper_ptr(a: c_int, b: c_int) -> c_int {\n177\t    let fp: unsafe extern \"C\" fn(c_int, c_int) -> c_int = op_select::OP_FN;\n178\t    let r = unsafe { fp(a, b) };\n179\t    println!(\"helper.ptr={}\", r);\n180\t    r\n181\t}\n182\t\n183\t#[unsafe(no_mangle)]\n184\tpub extern \"C\" fn use_generated(n: c_int) -> c_int {\n185\t    let r = accum_op(n);\n186\t    println!(\"gen.acc={}\", r);\n187\t    r\n188\t}\n189\t\n190\t// ------------ Internal items used by the binary driver ------------\n191\t\n192\tpub mod driver_support {\n193\t    //! Re-exports for the binary `main.rs`. These are not part of the\n194\t    //! C-visible ABI; they only exist so `main.rs` can drive the same\n195\t    //! compile-time configuration as `lib.rs`.\n196\t\n197\t    pub fn op_name_cstr() -> &'static str {\n198\t        // Strip the trailing NUL we keep for the C `const char *`.\n199\t        let bytes = super::op_select::OP_NAME;\n200\t        let trimmed = &bytes[..bytes.len() - 1];\n201\t        // Safety: OP_NAME is a literal ASCII byte string above.\n202\t        std::str::from_utf8(trimmed).unwrap()\n203\t    }\n204\t\n205\t    pub fn op_init() -> i32 {\n206\t        super::op_select::INIT\n207\t    }\n208\t\n209\t    pub fn op_call(a: i32, b: i32) -> i32 {\n210\t        unsafe { (super::op_select::OP_FN)(a, b) }\n211\t    }\n212\t\n213\t    pub fn run_loop(acc: &mut i32) {\n214\t        super::run_loop(acc);\n215\t    }\n216\t}\n217\t"}]},"parent_tool_use_id":null,"session_id":"50b69b0f-8a80-49c6-b5cb-f4dbeea22b14","uuid":"84779d03-738f-4e00-9720-d85e59bb3a4f","timestamp":"2026-05-28T14:59:17.313Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-work-NEPsPP/translated_rust/src/lib.rs","content":"// SPDX-License-Identifier: MIT\n// Rust translation of c_src/src/mdcore.c (a