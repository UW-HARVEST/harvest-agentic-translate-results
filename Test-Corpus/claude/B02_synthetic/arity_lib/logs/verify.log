","-        let c_res = c_fn(p1, p2, p3, p4);","-        let r_res = r_fn(p1, p2, p3, p4);","-","-        // The order tag (1, 2, or 3) feeds into result. Then result is","-        // possibly multiplied by p3 / 100 and incremented by p4. Compute","-        // both possible C and Rust results across order tags and ensure","-        // intersection is non-empty.","-        let possible: Vec<c_int> = (1..=3)","-            .flat_map(|order| {","-                let bonuses = [0, 10];","-                bonuses.iter().map(move |b| {","-                    arity4_with_alloc_result(p1, p2, p3, p4, order + b)","-                })","-            })","-            .collect();","-","-        assert!(","-            possible.contains(&c_res),","-            \"C arity4({}, {}, {}, {}) = {} not in expected set {:?}\",","-            p1, p2, p3, p4, c_res, possible","-        );","-        assert!(","-            possible.contains(&r_res),","-            \"Rust arity4({}, {}, {}, {}) = {} not in expected set {:?}\",","-            p1, p2, p3, p4, r_res, possible","-        );","-    }","-}","-","-// Recompute arity4 in pure Rust assuming compare_allocations returned `alloc`.","-// This mirrors the C logic exactly.","-fn arity4_with_alloc_result(p1: c_int, p2: c_int, p3: c_int, p4: c_int, alloc: c_int) -> c_int {","+// Faithfully recompute arity4 in pure Rust assuming `compare_allocations`","+// returned `alloc`. Used to enumerate the possible C/Rust outputs when","+// pointer ordering is unknown.","+fn arity4_with_alloc(p1: c_int, p2: c_int, p3: c_int, p4: c_int, alloc: c_int) -> c_int {","     let mut result: c_int = 0;","     let mut values = [p1, p2, p3, p4];"," ","-    // process_string(\"Hello\") -> 5; process_string(\"\") -> 0","+    // process_string(\"Hello\") = 5; process_string(\"\") = 0","     result += 5 + 0;"," ","-    // shift_array(values, 4, 1)","-    // memmove(values+1, values, 3*4) then values[0] = 0","+    // shift_array(values, 4, 1) -> shift right by 1, fill leading with 0","     for i in (1..4).rev() {","         values[i] = values[i - 1];","     }"]},{"oldStart":244,"oldLines":8,"newStart":209,"newLines":9,"lines":["         result += *v;","     }"," ","-    // apply_bitmask(result, p1 % 4)","-    result = match p1.rem_euclid_c(4) {","+    // apply_bitmask(result, p1 % 4)  (C `%` truncates toward zero, same as Rust `%`)","+    let op = p1 % 4;","+    result = match op {","         0 => result & 0b1111_0000,","         1 => result & 0b0000_1111,","         2 => result | 0b1010_1010,"]},{"oldStart":253,"oldLines":7,"newStart":219,"newLines":7,"lines":["         _ => result,","     };"," ","-    // matrix[0][0] + matrix[2][3] = 1 + 12 = 13","+    // matrix[0][0] + matrix[2][3] = 1 + 12","     result += 1 + 12;"," ","     result += alloc;"]},{"oldStart":267,"oldLines":59,"newStart":233,"newLines":66,"lines":["     result"," }"," ","-// C-style remainder: `%` in C truncates toward zero (same as Rust's `%`).","-trait RemEuclidC {","-    fn rem_euclid_c(self, rhs: Self) -> Self;","+fn arity4_possible(p1: c_int, p2: c_int, p3: c_int, p4: c_int) -> Vec<c_int> {","+    compare_allocations_possible(p1)","+        .into_iter()","+        .map(|alloc| arity4_with_alloc(p1, p2, p3, p4, alloc))","+        .collect()"," }","-impl RemEuclidC for c_int {","-    fn rem_euclid_c(self, rhs: c_int) -> c_int {","-        self % rhs","-    }","-}"," "," #[test]"," fn test_arity4_consistency() {","-    let cases = [","-        (1, 2, 0, 0),","-        (5, 5, 5, 5),","-        (10, 20, 30, 40),","-        (-1, -2, -3, -4),","-        (0, 0, 0, 0),","-        (100, 200, 0, 0),","-        (1, 1, 100, 1),","-        (3, 7, 50, 5),","-        (4, 8, 0, 0),     // p1 % 4 == 0","-        (1, 8, 0, 0),     // p1 % 4 == 1","-        (2, 8, 0, 0),     // p1 % 4 == 2","-        (3, 8, 0, 0),     // p1 % 4 == 3","-    ];","-    for (p1, p2, p3, p4) in cases {","-        verify_arity4_consistency(p1, p2, p3, p4);","+    let libs = libs();","+    type Fn_ = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;","+","+    unsafe {","+        let c_fn: Symbol<Fn_> = sym(&libs.c, b\"arity4\");","+        let r_fn: Symbol<Fn_> = sym(&libs.r, b\"arity4\");","+","+        let cases = [","+            (1, 2, 0, 0),","+            (5, 5, 5, 5),","+            (10, 20, 30, 40),","+            (-1, -2, -3, -4),","+            (0, 0, 0, 0),","+            (100, 200, 0, 0),","+            (1, 1, 100, 1),","+            (3, 7, 50, 5),","+            (4, 8, 0, 0),    // p1 % 4 == 0","+            (1, 8, 0, 0),    // p1 % 4 == 1","+            (2, 8, 0, 0),    // p1 % 4 == 2","+            (3, 8, 0, 0),    // p1 % 4 == 3","+            (-4, 8, 0, 0),   // negative p1","+        ];","+        for (p1, p2, p3, p4) in cases {","+            let c_res = c_fn(p1, p2, p3, p4);","+            let r_res = r_fn(p1, p2, p3, p4);","+            let possible = arity4_possible(p1, p2, p3, p4);","+            assert!(possible.contains(&c_res),","+                \"C arity4({}, {}, {}, {}) = {} not in {:?}\", p1, p2, p3, p4, c_res, possible);","+            assert!(possible.contains(&r_res),","+                \"Rust arity4({}, {}, {}, {}) = {} not in {:?}\", p1, p2, p3, p4, r_res, possible);","+        }","     }"," }"," "," #[test]"," fn test_arity2_consistency() {","     let libs = libs();","-    type Fn = unsafe extern \"C\" fn(c_int, c_int) -> c_int;","+    type Fn_ = unsafe extern \"C\" fn(c_int, c_int) -> c_int;"," ","     unsafe {","-        let c_fn: Symbol<Fn> = sym(&libs.c, b\"arity2\");","-        let r_fn: Symbol<Fn> = sym(&libs.r, b\"arity2\");","+        let c_fn: Symbol<Fn_> = sym(&libs.c, b\"arity2\");","+        let r_fn: Symbol<Fn_> = sym(&libs.r, b\"arity2\");"," ","         for (p1, p2) in [(1i32, 2i32), (5, 5), (-1, -2), (100, 200), (4, 8)] {","             let c_res = c_fn(p1, p2);","             let r_res = r_fn(p1, p2);","-","-            // arity2 forwards to arity4(p1, p2, 0, 0) so the only randomness","-            // is the order tag/bonus from compare_allocations. Compute the","-            // pure-Rust set of possibilities and check both fall in it.","-            let possible: Vec<c_int> = (1..=3)","-                .flat_map(|order| [0, 10].iter().map(move |b| arity4_with_alloc_result(p1, p2, 0, 0, order + b)))","-                .collect();","-","-            assert!(possible.contains(&c_res), \"C arity2 unexpected: {}\", c_res);","-            assert!(possible.contains(&r_res), \"R arity2 unexpected: {}\", r_res);","+            let possible = arity4_possible(p1, p2, 0, 0);","+            assert!(possible.contains(&c_res),","+                \"C arity2({}, {}) = {} not in {:?}\", p1, p2, c_res, possible);","+            assert!(possible.contains(&r_res),","+                \"Rust arity2({}, {}) = {} not in {:?}\", p1, p2, r_res, possible);","         }","     }"," }"]},{"oldStart":327,"oldLines":40,"newStart":300,"newLines":33,"lines":[" #[test]"," fn test_arity3_consistency() {","     let libs = libs();","-    type Fn = unsafe extern \"C\" fn(c_int, c_int, c_int) -> c_int;","+    type Fn_ = unsafe extern \"C\" fn(c_int, c_int, c_int) -> c_int;"," ","     unsafe {","-        let c_fn: Symbol<Fn> = sym(&libs.c, b\"arity3\");","-        let r_fn: Symbol<Fn> = sym(&libs.r, b\"arity3\");","+        let c_fn: Symbol<Fn_> = sym(&libs.c, b\"arity3\");","+        let r_fn: Symbol<Fn_> = sym(&libs.r, b\"arity3\");"," ","         for (p1, p2, p3) in [(1i32, 2i32, 3i32), (5, 5, 5), (-1, -2, -3), (4, 8, 50)] {","             let c_res = c_fn(p1, p2, p3);","             let r_res = r_fn(p1, p2, p3);","-            let possible: Vec<c_int> = (1..=3)","-                .flat_map(|order| [0, 10].iter().map(move |b| arity4_with_alloc_result(p1, p2, p3, 0, order + b)))","-                .collect();","-            assert!(possible.contains(&c_res), \"C arity3 unexpected: {}\", c_res);","-            assert!(possible.contains(&r_res), \"R arity3 unexpected: {}\", r_res);","+            let possible = arity4_possible(p1, p2, p3, 0);","+            assert!(possible.contains(&c_res),","+                \"C arity3({}, {}, {}) = {} not in {:?}\", p1, p2, p3, c_res, possible);","+            assert!(possible.contains(&r_res),","+                \"Rust arity3({}, {}, {}) = {} not in {:?}\", p1, p2, p3, r_res, possible);","         }","     }"," }"," ","-// ----- arity (top level dispatcher) -----","-// Note: C source signature is `int arity(unsigned char len, int *params)`,","-// while the header declares `int arity(int len, int *params)`. The actual","-// definition (unsigned char) is what gets called via the .so's `arity` symbol.","-// We pass len as c_uchar to match.","-"," #[test]","-fn test_arity_dispatch_matches_for_short_len() {","+fn test_arity_dispatch_short_len_matches_exactly() {","     let libs = libs();","-    type Fn = unsafe extern \"C\" fn(c_uchar, *mut c_int) -> c_int;","+    type Fn_ = unsafe extern \"C\" fn(c_uchar, *mut c_int) -> c_int;"," ","     unsafe {","-        let c_fn: Symbol<Fn> = sym(&libs.c, b\"arity\");","-        let r_fn: Symbol<Fn> = sym(&libs.r, b\"arity\");","+        let c_fn: Symbol<Fn_> = sym(&libs.c, b\"arity\");","+        let r_fn: Symbol<Fn_> = sym(&libs.r, b\"arity\");"," ","-        // len < 2 returns -1 deterministically","         let mut params = [1, 2, 3, 4];","         for len in [0u8, 1u8] {","             let c_res = c_fn(len, params.as_mut_ptr());"]},{"oldStart":374,"oldLines":17,"newStart":340,"newLines":17,"lines":[" #[test]"," fn test_arity_dispatch_consistency() {","     let libs = libs();","-    type Fn = unsafe extern \"C\" fn(c_uchar, *mut c_int) -> c_int;","+    type Fn_ = unsafe extern \"C\" fn(c_uchar, *mut c_int) -> c_int;"," ","     unsafe {","-        let c_fn: Symbol<Fn> = sym(&libs.c, b\"arity\");","-        let r_fn: Symbol<Fn> = sym(&libs.r, b\"arity\");","+        let c_fn: Symbol<Fn_> = sym(&libs.c, b\"arity\");","+        let r_fn: Symbol<Fn_> = sym(&libs.r, b\"arity\");"," ","         let scenarios: &[(u8, [c_int; 4])] = &[","             (2, [1, 2, 0, 0]),","             (3, [4, 5, 6, 0]),","             (4, [7, 8, 9, 10]),","-            (5, [11, 12, 13, 14]), // len > 4 still uses arity4(0..3)","+            (5, [11, 12, 13, 14]),  // len > 4 still uses arity4","             (3, [-1, -2, -3, 0]),","         ];"," "]},{"oldStart":394,"oldLines":30,"newStart":360,"newLines":13,"lines":["             let c_res = c_fn(*len, p_c.as_mut_ptr());","             let r_res = r_fn(*len, p_r.as_mut_ptr());"," ","-            // Both are either deterministic (len<2 case handled above) or","-            // a function of arity{2,3,4} which we handled above. Just check","-            // both fall in the same possibility set.","             let (a, b, cc, d) = match *len {","                 2 => (params[0], params[1], 0, 0),","                 3 => (params[0], params[1], params[2], 0),","                 _ => (params[0], params[1], params[2], params[3]),","             };","-            let possible: Vec<c_int> = (1..=3)","-                .flat_map(|order| [0, 10].iter().map(move |b| arity4_with_alloc_result(a, b_param(b), cc, d, order + b)))","-                .map(|x| x)","-                .collect();","+            let possible = arity4_possible(a, b, cc, d);"," ","-            // The closure capture above is messy; recompute simply:","-            let possible: Vec<c_int> = {","-                let mut v = vec![];","-                for order in 1..=3 {","-                    for bonus in [0, 10] {","-                        v.push(arity4_with_alloc_result(a, b, cc, d, order + bonus));","-                    }","-                }","-                v","-            };","-","             assert!(possible.contains(&c_res),","                 \"C arity(len={}, {:?}) = {} not in {:?}\", len, params, c_res, possible);","             assert!(possible.contains(&r_res),"]},{"oldStart":426,"oldLines":4,"newStart":375,"newLines":33,"lines":["     }"," }"," ","-fn b_param(b: &i32) -> c_int { *b }","+// --------------------------------------------------------------------------","+// Symbol export parity: every public symbol exported by the C .so must","+// also be exported by the Rust .so under the same name.","+// --------------------------------------------------------------------------","+","+#[test]","+fn test_rust_so_exports_every_c_symbol() {","+    let libs = libs();","+    let expected = [","+        \"shift_array\",","+        \"process_string\",","+        \"apply_bitmask\",","+        \"init_matrix\",","+        \"compare_allocations\",","+        \"arity4\",","+        \"arity3\",","+        \"arity2\",","+        \"arity\",","+    ];","+    unsafe {","+        for name in expected {","+            let mut bytes = name.as_bytes().to_vec();","+            bytes.push(0);","+            let c_sym: Result<Symbol<*const ()>, _> = libs.c.get(&bytes);","+            let r_sym: Result<Symbol<*const ()>, _> = libs.r.get(&bytes);","+            assert!(c_sym.is_ok(), \"C library missing '{}'\", name);","+            assert!(r_sym.is_ok(), \"Rust library missing '{}'\", name);","+        }","+    }","+}"]}],"originalFile":"// Integration tests comparing the C reference shared library against the\n// Rust-translated shared library through the FFI boundary.\n//\n// Both libraries are loaded with `libloading` and their exported symbols are\n// invoked side by side. Outputs are compared byte-for-byte where the C code\n// produces deterministic results.\n\nuse libloading::{Library, Symbol};\nuse std::os::raw::{c_char, c_int, c_uchar};\nuse std::path::PathBuf;\nuse std::sync::OnceLock;\n\nstruct Libs {\n    c: Library,\n    r: Library,\n}\n\nfn libs() -> &'static Libs {\n    static INSTANCE: OnceLock<Libs> = OnceLock::new();\n    INSTANCE.get_or_init(|| {\n        let mut c_path = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n        c_path.push(\"c_src/build/libtranslated_rust.so\");\n\n        let mut r_path = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n        r_path.push(\"target/release/libarity_lib.so\");\n\n        unsafe {\n            Libs {\n                c: Library::new(&c_path).expect(\"failed to load C library\"),\n                r: Library::new(&r_path).expect(\"failed to load Rust library\"),\n            }\n        }\n    })\n}\n\nunsafe fn sym<'lib, T>(lib: &'lib Library, name: &[u8]) -> Symbol<'lib, T> {\n    lib.get(name).expect(\"missing symbol\")\n}\n\n// ----- shift_array -----\n\n#[test]\nfn test_shift_array_matches() {\n    let libs = libs();\n    type Fn = unsafe extern \"C\" fn(*mut c_int, c_int, c_int);\n\n    unsafe {\n        let c_fn: Symbol<Fn> = sym(&libs.c, b\"shift_array\");\n        let r_fn: Symbol<Fn> = sym(&libs.r, b\"shift_array\");\n\n        let cases: &[(Vec<c_int>, c_int, c_int)] = &[\n            (vec![1, 2, 3, 4], 4, 1),\n            (vec![1, 2, 3, 4], 4, 2),\n            (vec![1, 2, 3, 4], 4, 3),\n            (vec![1, 2, 3, 4], 4, 0),     // no-op\n            (vec![1, 2, 3, 4], 4, 4),     // positions == size, no-op\n            (vec![1, 2, 3, 4], 4, -1),    // negative, no-op\n            (vec![10, 20, 30, 40, 50, 60], 6, 2),\n            (vec![10, 20, 30, 40, 50, 60], 6, 5),\n            (vec![-7, 0, 99, -1], 4, 1),\n        ];\n\n        for (arr, size, positions) in cases {\n            let mut a = arr.clone();\n            let mut b = arr.clone();\n            c_fn(a.as_mut_ptr(), *size, *positions);\n            r_fn(b.as_mut_ptr(), *size, *positions);\n            assert_eq!(a, b, \"shift_array mismatch for {:?} size={} pos={}\", arr, size, positions);\n        }\n    }\n}\n\n// ----- process_string -----\n\n#[test]\nfn test_process_string_matches() {\n    let libs = libs();\n    type Fn = unsafe extern \"C\" fn(*const c_char) -> c_int;\n\n    unsafe {\n        let c_fn: Symbol<Fn> = sym(&libs.c, b\"process_string\");\n        let r_fn: Symbol<Fn> = sym(&libs.r, b\"process_string\");\n\n        let cases: &[&[u8]] = &[\n            b\"\\0\",                       // empty\n            b\"a\\0\",\n            b\"hello\\0\",\n            b\"Hello, world!\\0\",\n            b\"\\xff\\xfe\\xfd\\0\",\n        ];\n\n        for s in cases {\n            let c_res = c_fn(s.as_ptr() as *const c_char);\n            let r_res = r_fn(s.as_ptr() as *const c_char);\n            assert_eq!(c_res, r_res, \"process_string mismatch for {:?}\", s);\n        }\n    }\n}\n\n// ----- apply_bitmask -----\n\n#[test]\nfn test_apply_bitmask_matches() {\n    let libs = libs();\n    type Fn = unsafe extern \"C\" fn(c_int, c_int) -> c_int;\n\n    unsafe {\n        let c_fn: Symbol<Fn> = sym(&libs.c, b\"apply_bitmask\");\n        let r_fn: Symbol<Fn> = sym(&libs.r, b\"apply_bitmask\");\n\n        for value in &[0i32, 1, 0xFF, 0xAA, 0x55, 0x12345678, -1, -42, i32::MIN, i32::MAX] {\n            for op in -1..=5 {\n                let c_res = c_fn(*value, op);\n                let r_res = r_fn(*value, op);\n                assert_eq!(c_res, r_res, \"apply_bitmask({}, {}) mismatch\", value, op);\n            }\n        }\n    }\n}\n\n// ----- init_matrix -----\n\n#[test]\nfn test_init_matrix_matches() {\n    let libs = libs();\n    type Fn = unsafe extern \"C\" fn(*mut c_int);\n\n    unsafe {\n        let c_fn: Symbol<Fn> = sym(&libs.c, b\"init_matrix\");\n        let r_fn: Symbol<Fn> = sym(&libs.r, b\"init_matrix\");\n\n        let mut c_mat = [[0xDEADBEEFu32 as c_int; 4]; 3];\n        let mut r_mat = [[0xDEADBEEFu32 as c_int; 4]; 3];\n\n        c_fn(c_mat.as_mut_ptr() as *mut c_int);\n        r_fn(r_mat.as_mut_ptr() as *mut c_int);\n\n        assert_eq!(c_mat, r_mat, \"init_matrix mismatch\");\n    }\n}\n\n// ----- compare_allocations -----\n// The C function returns a value that depends on the relative order of two\n// malloc'd pointers (1, 2, or 3) plus a bonus from the value stored at ptr1.\n// Allocator behavior differs between processes/runs, so the pointer-ordering\n// component is not deterministic. We verify that the value-dependent bonus\n// component matches by masking off the order bits.\n\n#[test]\nfn test_compare_allocations_value_component() {\n    let libs = libs();\n    type Fn = unsafe extern \"C\" fn(c_int, c_int) -> c_int;\n\n    unsafe {\n        let c_fn: Symbol<Fn> = sym(&libs.c, b\"compare_allocations\");\n        let r_fn: Symbol<Fn> = sym(&libs.r, b\"compare_allocations\");\n\n        for &(v1, v2) in &[(0i32, 0i32), (1, 0), (-1, 5), (100, -100), (42, 42)] {\n            let c_res = c_fn(v1, v2);\n            let r_res = r_fn(v1, v2);\n\n            // Pull out the bonus and the order tag separately. Order tag is\n            // 1, 2, or 3; bonus is 0 or 10.\n            let c_bonus = c_res - (c_res % 10).max(0); // get 10s digit\n            let r_bonus = r_res - (r_res % 10).max(0);\n            assert_eq!(\n                c_bonus, r_bonus,\n                \"compare_allocations bonus mismatch for ({}, {}): c={}, r={}\",\n                v1, v2, c_res, r_res\n            );\n\n            let c_order = c_res % 10;\n            let r_order = r_res % 10;\n            assert!((1..=3).contains(&c_order), \"C returned unexpected order tag: {}\", c_order);\n            assert!((1..=3).contains(&r_order), \"Rust returned unexpected order tag: {}\", r_order);\n        }\n    }\n}\n\n// ----- arity4 / arity3 / arity2 -----\n// arity4 internally calls compare_allocations whose return value depends on\n// pointer ordering. We call both C and Rust enough times that any constant\n// allocator-induced offset cancels out: we compare the *set* of possible\n// outputs by trying both with the same inputs and checking they're within\n// the small set of possible results given pointer-order ambiguity.\n//\n// More robustly: we verify that the *difference* between c and r results\n// is in {-2, -1, 0, 1, 2} corresponding to the order-tag difference.\n\nfn verify_arity4_consistency(p1: c_int, p2: c_int, p3: c_int, p4: c_int) {\n    let libs = libs();\n    type Fn = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n\n    unsafe {\n        let c_fn: Symbol<Fn> = sym(&libs.c, b\"arity4\");\n        let r_fn: Symbol<Fn> = sym(&libs.r, b\"arity4\");\n\n        let c_res = c_fn(p1, p2, p3, p4);\n        let r_res = r_fn(p1, p2, p3, p4);\n\n        // The order tag (1, 2, or 3) feeds into result. Then result is\n        // possibly multiplied by p3 / 100 and incremented by p4. Compute\n        // both possible C and Rust results across order tags and ensure\n        // intersection is non-empty.\n        let possible: Vec<c_int> = (1..=3)\n            .flat_map(|order| {\n                let bonuses = [0, 10];\n                bonuses.iter().map(move |b| {\n                    arity4_with_alloc_result(p1, p2, p3, p4, order + b)\n                })\n            })\n            .collect();\n\n        assert!(\n            possible.contains(&c_res),\n            \"C arity4({}, {}, {}, {}) = {} not in expected set {:?}\",\n            p1, p2, p3, p4, c_res, possible\n        );\n        assert!(\n            possible.contains(&r_res),\n            \"Rust arity4({}, {}, {}, {}) = {} not in expected set {:?}\",\n            p1, p2, p3, p4, r_res, possible\n        );\n    }\n}\n\n// Recompute arity4 in pure Rust assuming compare_allocations returned `alloc`.\n// This mirrors the C logic exactly.\nfn arity4_with_alloc_result(p1: c_int, p2: c_int, p3: c_int, p4: c_int, alloc: c_int) -> c_int {\n    let mut result: c_int = 0;\n    let mut values = [p1, p2, p3, p4];\n\n    // process_string(\"Hello\") -> 5; process_string(\"\") -> 0\n    result += 5 + 0;\n\n    // shift_array(values, 4, 1)\n    // memmove(values+1, values, 3*4) then values[0] = 0\n    for i in (1..4).rev() {\n        values[i] = values[i - 1];\n    }\n    values[0] = 0;\n\n    for v in &values {\n        result += *v;\n    }\n\n    // apply_bitmask(result, p1 % 4)\n    result = match p1.rem_euclid_c(4) {\n        0 => result & 0b1111_0000,\n        1 => result & 0b0000_1111,\n        2 => result | 0b1010_1010,\n        3 => result ^ 0b0101_0101,\n        _ => result,\n    };\n\n    // matrix[0][0] + matrix[2][3] = 1 + 12 = 13\n    result += 1 + 12;\n\n    result += alloc;\n\n    if p3 != 0 {\n        result = (result * p3) / 100;\n    }\n    if p4 != 0 {\n        result += p4;\n    }\n    result\n}\n\n// C-style remainder: `%` in C truncates toward zero (same as Rust's `%`).\ntrait RemEuclidC {\n    fn rem_euclid_c(self, rhs: Self) -> Self;\n}\nimpl RemEuclidC for c_int {\n    fn rem_euclid_c(self, rhs: c_int) -> c_int {\n        self % rhs\n    }\n}\n\n#[test]\nfn test_arity4_consistency() {\n    let cases = [\n        (1, 2, 0, 0),\n        (5, 5, 5, 5),\n        (10, 20, 30, 40),\n        (-1, -2, -3, -4),\n        (0, 0, 0, 0),\n        (100, 200, 0, 0),\n        (1, 1, 100, 1),\n        (3, 7, 50, 5),\n        (4, 8, 0, 0),     // p1 % 4 == 0\n        (1, 8, 0, 0),     // p1 % 4 == 1\n        (2, 8, 0, 0),     // p1 % 4 == 2\n        (3, 8, 0, 0),     // p1 % 4 == 3\n    ];\n    for (p1, p2, p3, p4) in cases {\n        verify_arity4_consistency(p1, p2, p3, p4);\n    }\n}\n\n#[test]\nfn test_arity2_consistency() {\n    let libs = libs();\n    type Fn = unsafe extern \"C\" fn(c_int, c_int) -> c_int;\n\n    unsafe {\n        let c_fn: Symbol<Fn> = sym(&libs.c, b\"arity2\");\n        let r_fn: Symbol<Fn> = sym(&libs.r, b\"arity2\");\n\n        for (p1, p2) in [(1i32, 2i32), (5, 5), (-1, -2), (100, 200), (4, 8)] {\n            let c_res = c_fn(p1, p2);\n            let r_res = r_fn(p1, p2);\n\n            // arity2 forwards to arity4(p1, p2, 0, 0) so the only randomness\n            // is the order tag/bonus from compare_allocations. Compute the\n            // pure-Rust set of possibilities and check both fall in it.\n            let possible: Vec<c_int> = (1..=3)\n                .flat_map(|order| [0, 10].iter().map(move |b| arity4_with_alloc_result(p1, p2, 0, 0, order + b)))\n                .collect();\n\n            assert!(possible.contains(&c_res), \"C arity2 unexpected: {}\", c_res);\n            assert!(possible.contains(&r_res), \"R arity2 unexpected: {}\", r_res);\n        }\n    }\n}\n\n#[test]\nfn test_arity3_consistency() {\n    let libs = libs();\n    type Fn = unsafe extern \"C\" fn(c_int, c_int, c_int) -> c_int;\n\n    unsafe {\n        let c_fn: Symbol<Fn> = sym(&libs.c, b\"arity3\");\n        let r_fn: Symbol<Fn> = sym(&libs.r, b\"arity3\");\n\n        for (p1, p2, p3) in [(1i32, 2i32, 3i32), (5, 5, 5), (-1, -2, -3), (4, 8, 50)] {\n            let c_res = c_fn(p1, p2, p3);\n            let r_res = r_fn(p1, p2, p3);\n            let possible: Vec<c_int> = (1..=3)\n                .flat_map(|order| [0, 10].iter().map(move |b| arity4_with_alloc_result(p1, p2, p3, 0, order + b)))\n                .collect();\n            assert!(possible.contains(&c_res), \"C arity3 unexpected: {}\", c_res);\n            assert!(possible.contains(&r_res), \"R arity3 unexpected: {}\", r_res);\n        }\n    }\n}\n\n// ----- arity (top level dispatcher) -----\n// Note: C source signature is `int arity(unsigned char len, int *params)`,\n// while the header declares `int arity(int len, int *params)`. The actual\n// definition (unsigned char) is what gets called via the .so's `arity` symbol.\n// We pass len as c_uchar to match.\n\n#[test]\nfn test_arity_dispatch_matches_for_short_len() {\n    let libs = libs();\n    type Fn = unsafe extern \"C\" fn(c_uchar, *mut c_int) -> c_int;\n\n    unsafe {\n        let c_fn: Symbol<Fn> = sym(&libs.c, b\"arity\");\n        let r_fn: Symbol<Fn> = sym(&libs.r, b\"arity\");\n\n        // len < 2 returns -1 deterministically\n        let mut params = [1, 2, 3, 4];\n        for len in [0u8, 1u8] {\n            let c_res = c_fn(len, params.as_mut_ptr());\n            let r_res = r_fn(len, params.as_mut_ptr());\n            assert_eq!(c_res, -1);\n            assert_eq!(r_res, -1);\n        }\n    }\n}\n\n#[test]\nfn test_arity_dispatch_consistency() {\n    let libs = libs();\n    type Fn = unsafe extern \"C\" fn(c_uchar, *mut c_int) -> c_int;\n\n    unsafe {\n        let c_fn: Symbol<Fn> = sym(&libs.c, b\"arity\");\n        let r_fn: Symbol<Fn> = sym(&libs.r, b\"arity\");\n\n        let scenarios: &[(u8, [c_int; 4])] = &[\n            (2, [1, 2, 0, 0]),\n            (3, [4, 5, 6, 0]),\n            (4, [7, 8, 9, 10]),\n            (5, [11, 12, 13, 14]), // len > 4 still uses arity4(0..3)\n            (3, [-1, -2, -3, 0]),\n        ];\n\n        for (len, params) in scenarios {\n            let mut p_c = *params;\n            let mut p_r = *params;\n            let c_res = c_fn(*len, p_c.as_mut_ptr());\n            let r_res = r_fn(*len, p_r.as_mut_ptr());\n\n            // Both are either deterministic (len<2 case handled above) or\n            // a function of arity{2,3,4} which we handled above. Just check\n            // both fall in the same possibility set.\n            let (a, b, cc, d) = match *len {\n                2 => (params[0], params[1], 0, 0),\n                3 => (params[0], params[1], params[2], 0),\n                _ => (params[0], params[1], params[2], params[3]),\n            };\n            let possible: Vec<c_int> = (1..=3)\n                .flat_map(|order| [0, 10].iter().map(move |b| arity4_with_alloc_result(a, b_param(b), cc, d, order + b)))\n                .map(|x| x)\n                .collect();\n\n            // The closure capture above is messy; recompute simply:\n            let possible: Vec<c_int> = {\n                let mut v = vec![];\n                for order in 1..=3 {\n                    for bonus in [0, 10] {\n                        v.push(arity4_with_alloc_result(a, b, cc, d, order + bonus));\n                    }\n                }\n                v\n            };\n\n            assert!(possible.contains(&c_res),\n                \"C arity(len={}, {:?}) = {} not in {:?}\", len, params, c_res, possible);\n            assert!(possible.contains(&r_res),\n                \"Rust arity(len={}, {:?}) = {} not in {:?}\", len, params, r_res, possible);\n        }\n    }\n}\n\nfn b_param(b: &i32) -> c_int { *b }\n","userModified":false}}
