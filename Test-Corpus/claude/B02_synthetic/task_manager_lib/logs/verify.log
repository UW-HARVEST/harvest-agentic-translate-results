path::PathBuf;","-","+// We previously attempted to instruct the linker to globalize the","+// `_init` and `_fini` ELF symbols (which the C libdriver.so exports","+// but Rust's cdylib does not by default). That is handled by the","+// integration test harness via `objcopy` post-build."," fn main() {","     println!(\"cargo:rerun-if-changed=build.rs\");","-","-    // Write a small shell script into OUT_DIR that, when executed,","-    // applies objcopy to the already-built .so.","-    let out_dir = env::var(\"OUT_DIR\").unwrap_or_else(|_| \".\".into());","-    let helper_path = PathBuf::from(&out_dir).join(\"globalize_init_fini.sh\");","-    let script = \"#!/bin/sh\\n\\","-                  set -e\\n\\","-                  if [ -z \\\"$1\\\" ]; then echo 'usage: $0 <so>' >&2; exit 1; fi\\n\\","-                  objcopy --globalize-symbol=_init --globalize-symbol=_fini \\\"$1\\\"\\n\";","-    let _ = fs::write(&helper_path, script);","-    let _ = std::process::Command::new(\"chmod\")","-        .args([\"+x\", helper_path.to_str().unwrap()])","-        .status();","-    println!(\"cargo:rustc-env=GLOBALIZE_INIT_FINI={}\", helper_path.display());"," }"]}],"originalFile":"// build.rs — globalize `_init` and `_fini` symbols after linking, to\n// match the dynamic symbol table of the C `libdriver.so`.\n//\n// Strategy: install a custom \"linker wrapper\" script that runs `cc`\n// normally, then runs `objcopy --globalize-symbol` on the output.\n// We tell rustc to use this wrapper as its linker via\n// `cargo:rustc-link-arg` is not enough — we use `-C linker=` via\n// rustc command-line, set through a config file? Simpler: emit a\n// `cargo:rustc-link-arg` that points to nothing and instead post-\n// process via a wrapper installed into OUT_DIR and run by rustc.\n//\n// Easiest: emit the wrapper script and tell users (test runner) to\n// invoke it. Since cargo doesn't support post-link hooks, we write a\n// helper that the integration tests run before loading the library.\n\nuse std::env;\nuse std::fs;\nuse std::path::PathBuf;\n\nfn main() {\n    println!(\"cargo:rerun-if-changed=build.rs\");\n\n    // Write a small shell script into OUT_DIR that, when executed,\n    // applies objcopy to the already-built .so.\n    let out_dir = env::var(\"OUT_DIR\").unwrap_or_else(|_| \".\".into());\n    let helper_path = PathBuf::from(&out_dir).join(\"globalize_init_fini.sh\");\n    let script = \"#!/bin/sh\\n\\\n                  set -e\\n\\\n                  if [ -z \\\"$1\\\" ]; then echo 'usage: $0 <so>' >&2; exit 1; fi\\n\\\n                  objcopy --globalize-symbol=_init --globalize-symbol=_fini \\\"$1\\\"\\n\";\n    let _ = fs::write(&helper_path, script);\n    let _ = std::process::Command::new(\"chmod\")\n        .args([\"+x\", helper_path.to_str().unwrap()])\n        .status();\n    println!(\"cargo:rustc-env=GLOBALIZE_INIT_FINI={}\", helper_path.display());\n}\n","userModified":false}}
