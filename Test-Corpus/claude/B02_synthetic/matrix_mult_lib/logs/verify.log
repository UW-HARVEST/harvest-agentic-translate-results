\n46\t        free(mat);\n47\t        return NULL;\n48\t    }\n49\t\n50\t    for (int i = 0; i < height; i++) {\n51\t        mat->matrix[i] = malloc(width * sizeof(int));\n52\t        if (mat->matrix[i] == NULL) {\n53\t            perror(\"Failed to allocate memory for matrix columns\");\n54\t            for (int j = 0; j <= i; j++) {\n55\t                free(mat->matrix[j]);\n56\t            }\n57\t            free(mat->matrix);\n58\t            free(mat);\n59\t            return NULL;\n60\t        }\n61\t    }\n62\t\n63\t    return mat;\n64\t}\n65\t\n66\tvoid free_matrix(matrix_t* mat) {\n67\t    if (mat == NULL) {\n68\t        return;\n69\t    }\n70\t\n71\t    for (int i = 0; i < mat->height; i++) {\n72\t        free(mat->matrix[i]);\n73\t    }\n74\t    free(mat->matrix);\n75\t    free(mat);\n76\t}\n77\t\n78\tmatrix_t* initialize_matrix_from_string(const char* input, int width, int height) {\n79\t    matrix_t* mat = allocate_matrix(width, height);\n80\t\n81\t    char* input_copy = strdup(input);\n82\t    if (input_copy == NULL) {\n83\t        perror(\"Failed to duplicate input string\");\n84\t        free_matrix(mat);\n85\t        return NULL;\n86\t    }\n87\t\n88\t    char* saveptr_row;\n89\t    char* row_token = strtok_r(input_copy, \"\\n\", &saveptr_row);\n90\t    for (int i = 0; i < height; i++) {\n91\t        if (row_token == NULL) {\n92\t            fprintf(stderr, \"Insufficient rows in input string.\\n\");\n93\t            free(input_copy);\n94\t            free_matrix(mat);\n95\t            return NULL;\n96\t        }\n97\t\n98\t        char* saveptr_col;\n99\t        char* col_token = strtok_r(row_token, \" \", &saveptr_col); \n100\t        for (int j = 0; j < width; j++) {\n101\t            if (col_token == NULL) {\n102\t                fprintf(stderr, \"Insufficient columns in row %d.\\n\", i + 1);\n103\t                free(input_copy);\n104\t                free_matrix(mat);\n105\t                return NULL;\n106\t            }\n107\t            mat->matrix[i][j] = atoi(col_token);\n108\t            col_token = strtok_r(NULL, \" \", &saveptr_col);\n109\t        }\n110\t\n111\t        row_token = strtok_r(NULL, \"\\n\", &saveptr_row);\n112\t    }\n113\t\n114\t    free(input_copy);\n115\t    return mat;\n116\t}\n117\t\n118\tmatrix_t* multiply_matrices(matrix_t* mat_a, matrix_t* mat_b) {\n119\t    if (mat_a->width != mat_b->height) {\n120\t        fprintf(stderr, \"Matrix dimensions do not allow multiplication.\\n\");\n121\t        return NULL;\n122\t    }\n123\t\n124\t    matrix_t* result = allocate_matrix(mat_b->width, mat_a->height);\n125\t    for (int i = 0; i < mat_a->height; i++) {\n126\t        for (int j = 0; j < mat_b->width; j++) {\n127\t            result->matrix[i][j] = 0;\n128\t            for (int k = 0; k < mat_a->width; k++) {\n129\t                result->matrix[i][j] += mat_a->matrix[i][k] * mat_b->matrix[k][j];\n130\t            }\n131\t        }\n132\t    }\n133\t\n134\t    return result;\n135\t}\n136\t\n137\tchar* matrix_to_string(matrix_t* mat) {\n138\t    if (mat == NULL) {\n139\t        fprintf(stderr, \"Error: Matrix is NULL.\\n\");\n140\t        return NULL;\n141\t    }\n142\t\n143\t    int buffer_size = mat->height * (mat->width * 10 + mat->width) + mat->height + 1;\n144\t    char* result = malloc(buffer_size);\n145\t    if (result == NULL) {\n146\t        perror(\"Failed to allocate memory for matrix string\");\n147\t        return NULL;\n148\t    }\n149\t\n150\t    result[0] = '\\0';\n151\t\n152\t    for (int i = 0; i < mat->height; i++) {\n153\t        for (int j = 0; j < mat->width; j++) {\n154\t            char buffer[12];\n155\t            snprintf(buffer, sizeof(buffer), \"%d\", mat->matrix[i][j]);\n156\t            strcat(result, buffer);\n157\t\n158\t            if (j < mat->width - 1) {\n159\t                strcat(result, \" \");\n160\t            }\n161\t        }\n162\t        strcat(result, \"\\n\");\n163\t    }\n164\t\n165\t    return result;\n166\t}\n167\t"}]},"parent_