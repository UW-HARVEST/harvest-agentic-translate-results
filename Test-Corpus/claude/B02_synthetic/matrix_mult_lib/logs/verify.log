{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TEQJhqXsMEXQ7fyxtUXiMW","type":"tool_result","content":"1\t// Library translation of c_src to Rust producing byte-identical outputs.\n2\t\n3\tuse std::ffi::{c_char, c_int, CStr};\n4\tuse std::io::Write;\n5\tuse std::ptr;\n6\t\n7\t// EXIT_SUCCESS / EXIT_FAILURE\n8\tconst EXIT_SUCCESS: c_int = 0;\n9\tconst EXIT_FAILURE: c_int = 1;\n10\t\n11\t// EINVAL\n12\tconst EINVAL: c_int = 22;\n13\t\n14\t// matrix_t struct, layout-compatible with the C definition.\n15\t#[repr(C)]\n16\tpub struct matrix_t {\n17\t    pub matrix: *mut *mut c_int,\n18\t    pub width: c_int,\n19\t    pub height: c_int,\n20\t}\n21\t\n22\t// ---------- helpers ----------\n23\t\n24\tfn eprint_bytes(bytes: &[u8]) {\n25\t    let stderr = std::io::stderr();\n26\t    let mut handle = stderr.lock();\n27\t    let _ = handle.write_all(bytes);\n28\t}\n29\t\n30\t// errno helpers using libc\n31\tfn get_errno() -> c_int {\n32\t    unsafe { *libc::__errno_location() as c_int }\n33\t}\n34\t\n35\tfn strerror_string(err: c_int) -> String {\n36\t    unsafe {\n37\t        let p = libc::strerror(err);\n38\t        if p.is_null() {\n39\t            String::new()\n40\t        } else {\n41\t            CStr::from_ptr(p).to_string_lossy().into_owned()\n42\t        }\n43\t    }\n44\t}\n45\t\n46\t// Replicates C's atoi behavior (skip whitespace, optional sign, parse digits, stop on non-digit, return 0 on no digits).\n47\tfn c_atoi(bytes: &[u8]) -> c_int {\n48\t    let mut i = 0usize;\n49\t    // Skip whitespace per isspace\n50\t    while i < bytes.len() {\n51\t        match bytes[i] {\n52\t            b' ' | b'\\t' | b'\\n' | b'\\r' | 0x0b | 0x0c => i += 1,\n53\t            _ => break,\n54\t        }\n55\t    }\n56\t    let mut neg = false;\n57\t    if i < bytes.len() && (bytes[i] == b'+' || bytes[i] == b'-') {\n58\t        neg = bytes[i] == b'-';\n59\t        i += 1;\n60\t    }\n61\t    let mut val: i64 = 0;\n62\t    while i < bytes.len() && bytes[i].is_ascii_digit() {\n63\t        val = val.wrapping_mul(10).wrapping_add((bytes[i] - b'0') as i64);\n64\t        i += 1;\n65\t    }\n66\t    if neg {\n67\t        val = -val;\n68\t    }\n69\t    val as c_int\n70\t}\n71\t\n72\t// ---------- matrix.c ----------\n73\t\n74\tfn allocate_matrix(width: c_int, height: c_int) -> *mut matrix_t {\n75\t    unsafe {\n76\t        let mat = libc::malloc(std::mem::size_of::<matrix_t>()) as *mut matrix_t;\n77\t        if mat.is_null() {\n78\t            // perror(\"Failed to allocate memory for matrix struct\")\n79\t            let msg = format!(\"Failed to allocate memory for matrix struct: {}\\n\", strerror_string(get_errno()));\n80\t            eprint_bytes(msg.as_bytes());\n81\t            return ptr::null_mut();\n82\t        }\n83\t\n84\t        (*mat).width = width;\n85\t        (*mat).height = height;\n86\t\n87\t        let row_ptrs_size = (height as usize).wrapping_mul(std::mem::size_of::<*mut c_int>());\n88\t        (*mat).matrix = libc::malloc(row_ptrs_size) as *mut *mut c_int;\n89\t        if (*mat).matrix.is_null() {\n90\t            let msg = format!(\"Failed to allocate memory for matrix rows: {}\\n\", strerror_string(get_errno()));\n91\t            eprint_bytes(msg.as_bytes());\n92\t            libc::free(mat as *mut libc::c_void);\n93\t            return ptr::null_mut();\n94\t        }\n95\t\n96\t        for i in 0..height as isize {\n97\t            let col_size = (width as usize).wrapping_mul(std::mem::size_of::<c_int>());\n98\t            let row = libc::malloc(col_size) as *mut c_int;\n99\t            *((*mat).matrix.offset(i)) = row;\n100\t            if row.is_null() {\n101\t                let msg = format!(\"Failed to allocate memory for matrix columns: {}\\n\", strerror_string(get_errno()));\n102\t                eprint_bytes(msg.as_bytes());\n103\t                // C frees j = 0..=i (inclusive)\n104\t                let mut j: isize = 0;\n105\t                while j <= i {\n106\t                    libc::free(*((*mat).matrix.offset(j)) as *mut libc::c_void);\n107\t                    j += 1;\n108\t                }\n109\t                libc::free((*mat).matrix as *mut libc::c_void);\n110\t                libc::free(mat as *mut libc::c_void);\n111\t                return ptr::null_mut();\n112\t            }\n113\t        }\n114\t\n115\t        mat\n116\t    }\n117\t}\n118\t\n119\t#[unsafe(no_mangle)]\n120\tpub unsafe extern \"C\" fn free_matrix(mat: *mut matrix_t) {\n121\t    if mat.is_null() {\n122\t        return;\n123\t    }\n124\t    unsafe {\n125\t        for i in 0..(*mat).height as isize {\n126\t            libc::free(*((*mat).matrix.offset(i)) as *mut libc::c_void);\n127\t        }\n128\t        libc::free((*mat).matrix as *mut libc::c_void);\n129\t        libc::free(mat as *mut libc::c_void);\n130\t    }\n131\t}\n132\t\n133\t#[unsafe(no_mangle)]\n134\tpub unsafe extern \"C\" fn initialize_matrix_from_string(\n135\t    input: *const c_char,\n136\t    width: c_int,\n137\t    height: c_int,\n138\t) -> *mut matrix_t {\n139\t    let mat = allocate_matrix(width, height);\n140\t\n141\t    // strdup the input\n142\t    let input_copy = unsafe { libc::strdup(input) };\n143\t    if input_copy.is_null() {\n144\t        let msg = format!(\"Failed to duplicate input string: {}\\n\", strerror_string(get_errno()));\n145\t        eprint_bytes(msg.as_bytes());\n146\t        unsafe { free_matrix(mat) };\n147\t        return ptr::null_mut();\n148\t    }\n149\t\n150\t    unsafe {\n151\t        let mut saveptr_row: *mut c_char = ptr::null_mut();\n152\t        let nl = b\"\\n\\0\".as_ptr() as *const c_char;\n153\t        let sp = b\" \\0\".as_ptr() as *const c_char;\n154\t\n155\t        let mut row_token = libc::strtok_r(input_copy, nl, &mut saveptr_row);\n156\t        for i in 0..height {\n157\t            if row_token.is_null() {\n158\t                eprint_bytes(b\"Insufficient rows in input string.\\n\");\n159\t                libc::free(input_copy as *mut libc::c_void);\n160\t                free_matrix(mat);\n161\t                return ptr::null_mut();\n162\t            }\n163\t\n164\t            let mut saveptr_col: *mut c_char = ptr::null_mut();\n165\t            let mut col_token = libc::strtok_r(row_token, sp, &mut saveptr_col);\n166\t            for j in 0..width {\n167\t                if col_token.is_null() {\n168\t                    let msg = format!(\"Insufficient columns in row {}.\\n\", i + 1);\n169\t                    eprint_bytes(msg.as_bytes());\n170\t                    libc::free(input_copy as *mut libc::c_void);\n171\t                    free_matrix(mat);\n172\t                    return ptr::null_mut();\n173\t                }\n174\t                // atoi\n175\t                let bytes = CStr::from_ptr(col_token).to_bytes();\n176\t                let val = c_atoi(bytes);\n177\t                *(*(*mat).matrix.offset(i as isize)).offset(j as isize) = val;\n178\t                col_token = libc::strtok_r(ptr::null_mut(), sp, &mut saveptr_col);\n179\t            }\n180\t\n181\t            row_token = libc::strtok_r(ptr::null_mut(), nl, &mut saveptr_row);\n182\t        }\n183\t\n184\t        libc::free(input_copy as *mut libc::c_void);\n185\t    }\n186\t    mat\n187\t}\n188\t\n189\t#[unsafe(no_mangle)]\n190\tpub unsafe extern \"C\" fn multiply_matrices(\n191\t    mat_a: *mut matrix_t,\n192\t    mat_b: *mut matrix_t,\n193\t) -> *mut matrix_t {\n194\t    unsafe {\n195\t        if (*mat_a).width != (*mat_b).height {\n196\t            eprint_bytes(b\"Matrix dimensions do not allow multiplication.\\n\");\n197\t            return ptr::null_mut();\n198\t        }\n199\t\n200\t        let result = allocate_matrix((*mat_b).width, (*mat_a).height);\n201\t        for i in 0..(*mat_a).height as isize {\n202\t            for j in 0..(*mat_b).width as isize {\n203\t                let cell = (*(*result).matrix.offset(i)).offset(j);\n204\t                *cell = 0;\n205\t                for k in 0..(*mat_a).width as isize {\n206\t                    let a = *(*(*mat_a).matrix.offset(i)).offset(k);\n207\t                    let b = *(*(*mat_b).matrix.offset(k)).offset(j);\n208\t                    // Use wrapping_add and wrapping_mul to mirror typical C overflow behavior\n209\t                    *cell = (*cell).wrapping_add(a.wrapping_mul(b));\n210\t                }\n211\t            }\n212\t        }\n213\t        result\n214\t    }\n215\t}\n216\t\n217\t#[unsafe(no_mangle)]\n218\tpub unsafe extern \"C\" fn matrix_to_string(mat: *mut matrix_t) -> *mut c_char {\n219\t    if mat.is_null() {\n220\t        eprint_bytes(b\"Error: Matrix is NULL.\\n\");\n221\t        return ptr::null_mut();\n222\t    }\n223\t    unsafe {\n224\t        let height = (*mat).height as usize;\n225\t        let width = (*mat).width as usize;\n226\t        let buffer_size = height * (width * 10 + width) + height + 1;\n227\t        let result = libc::malloc(buffer_size) as *mut c_char;\n228\t        if result.is_null() {\n229\t            let msg = format!(\"Failed to allocate memory for matrix string: {}\\n\", strerror_string(get_errno()));\n230\t            eprint_bytes(msg.as_bytes());\n231\t            return ptr::null_mut();\n232\t        }\n233\t        // result[0] = '\\0'\n234\t        *result = 0;\n235\t\n236\t        for i in 0..(*mat).height as isize {\n237\t            for j in 0..(*mat).width as isize {\n238\t                let val = *(*(*mat).matrix.offset(i)).offset(j);\n239\t                let s = format!(\"{}\", val);\n240\t                let s_bytes = s.as_bytes();\n241\t                // strcat\n242\t                let cur_len = libc::strlen(result);\n243\t                let dst = result.add(cur_len) as *mut u8;\n244\t                ptr::copy_nonoverlapping(s_bytes.as_ptr(), dst, s_bytes.len());\n245\t                *dst.add(s_bytes.len()) = 0;\n246\t\n247\t                if j < (*mat).width as isize - 1 {\n248\t                    let cur_len = libc::strlen(result);\n249\t                