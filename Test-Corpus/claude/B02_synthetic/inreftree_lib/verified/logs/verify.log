77\t    a.wrapping_div(b)\n78\t}\n79\t\n80\tfn modulo_op(a: i32, b: i32, _unused1: i32, _unused2: i32) -> i32 {\n81\t    if b == 0 {\n82\t        return 0;\n83\t    }\n84\t    a.wrapping_rem(b)\n85\t}\n86\t\n87\tfn find_node_index_by_id(state: &State, id: i32) -> Option<usize> {\n88\t    let count = state.node_count as usize;\n89\t    for i in 0..count {\n90\t        if state.node_table[i].id == id {\n91\t            return Some(i);\n92\t        }\n93\t    }\n94\t    None\n95\t}\n96\t\n97\t/// Mimics strncpy(dst, src, 31) followed by dst[31] = '\\0'.\n98\t/// Copies up to 31 bytes from `src` (a NUL-terminated byte slice) into `dst[..31]`,\n99\t/// padding the remainder of dst[..31] with NUL, then forcing dst[31] = 0.\n100\tfn copy_label(dst: &mut [u8; 32], src: &[u8]) {\n101\t    // src is treated as a C string: copy up to and including the NUL or 31 bytes,\n102\t    // and zero-fill the rest of the first 31 bytes per strncpy semantics.\n103\t    let mut i = 0usize;\n104\t    while i < 31 {\n105\t        // Find next byte in src; if past the NUL, pad with zero.\n106\t        let b = if i < src.len() { src[i] } else { 0 };\n107\t        dst[i] = b;\n108\t        if b == 0 {\n109\t            // strncpy pads remaining with NULs.\n110\t            i += 1;\n111\t            while i < 31 {\n112\t                dst[i] = 0;\n113\t                i += 1;\n114\t            }\n115\t            break;\n116\t        }\n117\t        i += 1;\n118\t    }\n119\t    dst[31] = 0;\n120\t}\n121\t\n122\tfn add_tree_node(state: &mut State, id: i32, value: i32, parent_id: i32, label: &[u8]) -> i32 {\n123\t    if state.node_count as usize >= MAX_NODES {\n124\t        return -1;\n125\t    }\n126\t\n127\t    let idx = state.node_count as usize;\n128\t    {\n129\t        let node = &mut state.node_table[idx];\n130\t        node.id = id;\n131\t        node.value = value;\n132\t        node.parent_id = parent_id;\n133\t        node.left_child_id = -1;\n134\t        node.right_child_id = -1;\n1