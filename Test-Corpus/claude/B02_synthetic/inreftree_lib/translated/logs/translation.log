) {\n123\t        sum += calculate_tree_sum(node->left_child_id);\n124\t    }\n125\t\n126\t    if (node->right_child_id != -1) {\n127\t        sum += calculate_tree_sum(node->right_child_id);\n128\t    }\n129\t\n130\t    return sum;\n131\t}\n132\t\n133\tOperation parse_operation(const char* op_str) {\n134\t    if (op_str == NULL || strchr(op_str, '+') != NULL) {\n135\t        return OP_ADD;\n136\t    }\n137\t    if (strchr(op_str, '*') != NULL) {\n138\t        return OP_MULTIPLY;\n139\t    }\n140\t    if (strchr(op_str, '-') != NULL) {\n141\t        return OP_SUBTRACT;\n142\t    }\n143\t    if (strchr(op_str, '/') != NULL) {\n144\t        return OP_DIVIDE;\n145\t    }\n146\t    if (strchr(op_str, '%') != NULL) {\n147\t        return OP_MODULO;\n148\t    }\n149\t    return OP_ADD;\n150\t}\n151\t\n152\tOperationFunc get_operation_func(Operation op) {\n153\t    switch ((int)op) {\n154\t        case 1: return add_op;\n155\t        case 2: return multiply_op;\n156\t        case 3: return subtract_op;\n157\t        case 4: return divide_op;\n158\t        case 5: return modulo_op;\n159\t        default: return add_op;\n160\t    }\n161\t}\n162\t\n163\tint inreftree(int param1, int param2, int param3, int param4) {\n164\t    node_count = 0;\n165\t\n166\t    add_tree_node(1, param1, -1, \"root\");\n167\t    add_tree_node(2, param2, 1, \"left\");\n168\t    add_tree_node(3, param3, 1, \"right\");\n169\t    add_tree_node(4, param4, 2, \"left-left\");\n170\t\n171\t    int target_id = -1;\n172\t    for (int i = 0; i < node_count; i++) {\n173\t        if (strchr(node_table[i].label, 'l') != NULL) {\n174\t            target_id = node_table[i].id;\n175\t            break;\n176\t        }\n177\t    }\n178\t\n179\t    TreeNode* target = find_node_by_id(target_id);\n180\t    if (target == NULL || target->value == 0) {\n181\t        target_id = 1;\n182\t    }\n183\t\n184\t    int tree_sum = calculate_tree_sum(1);\n185\t\n186\t    const char* op_string = \"+*-%\";\n187\t    char op_char[2