l.to_bits(),\n            r_val,\n            r_val.to_bits()\n        );\n    }\n}\n\nfn compare_range(values: impl IntoIterator<Item = i32>) {\n    unsafe {\n        let (_clib, c_sym) = load_pow43(&c_lib_path());\n        let (_rlib, r_sym) = load_pow43(&rust_lib_path());\n        for x in values {\n            let c_val = c_sym(x);\n            let r_val = r_sym(x);\n            assert_eq!(\n                c_val.to_bits(),\n                r_val.to_bits(),\n                \"Mismatch at x={}: C={} ({:#x}) Rust={} ({:#x})\",\n                x,\n                c_val,\n                c_val.to_bits(),\n                r_val,\n                r_val.to_bits()\n            );\n        }\n    }\n}\n\n#[test]\nfn test_pow43_low_table_indices() {\n    // 0..129 hits the table directly via g_pow43[16 + x]\n    compare_range(0..129);\n}\n\n#[test]\nfn test_pow43_negative_table_indices() {\n    // x in -16..0 still in table (16 + x is in 0..16)\n    // Note: C code: if (x < 129) return g_pow43[16 + x]\n    // For x in -16..0, this still loads from table (negative entries)\n    compare_range(-16..0);\n}\n\n#[test]\nfn test_pow43_mid_range_below_1024() {\n    // 129..1024 takes mult=16, x <<= 3 path\n    compare_range(129..1024);\n}\n\n#[test]\nfn test_pow43_high_range() {\n    // x >= 1024 takes mult=256 path\n    compare_range(1024..8192);\n}\n\n#[test]\nfn test_pow43_large_values() {\n    // sample large values\n    let values = (8192..1_000_000).step_by(1234);\n    compare_range(values);\n}\n\n#[test]\nfn test_pow43_specific_boundaries() {\n    let boundaries = [\n        0, 1, 2, 127, 128, 129, 130, 1023, 1024, 1025, 65535, 65536,\n        100_000, 1_000_000, 10_000_000, 100_000_000,\n    ];\n    for &x in &boundaries {\n        compare_for(x);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":166,"cache_read_input_tokens":21102,"cache_creation":{"ephemeral_5m_input_tokens":166,"ephemera