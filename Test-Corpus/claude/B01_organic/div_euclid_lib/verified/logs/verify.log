vide_by_zero() {\n    run_pair(0, 0);\n    run_pair(1, 0);\n    run_pair(-1, 0);\n    run_pair(i32::MAX, 0);\n    run_pair(i32::MIN, 0);\n}\n\n#[test]\nfn test_basic_positive() {\n    for a in 0..20 {\n        for b in 1..20 {\n            run_pair(a, b);\n        }\n    }\n}\n\n#[test]\nfn test_negatives() {\n    for a in -20..20 {\n        for b in -20..20 {\n            if b == 0 { continue; }\n            run_pair(a, b);\n            run_pair(-a, b);\n            run_pair(a, -b);\n            run_pair(-a, -b);\n        }\n    }\n}\n\n#[test]\nfn test_extremes() {\n    let extremes = [i32::MIN, i32::MIN + 1, -2, -1, 0, 1, 2, i32::MAX - 1, i32::MAX];\n    for &a in &extremes {\n        for &b in &extremes {\n            run_pair(a, b);\n        }\n    }\n}\n\n#[test]\nfn test_random_sample() {\n    use std::num::Wrapping;\n    // Deterministic LCG sample\n    let mut s: u64 = 0xDEAD_BEEF_CAFE_BABE;\n    for _ in 0..5000 {\n        s = s.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        let a = (Wrapping(s as u32).0) as i32;\n        s = s.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        let b = (Wrapping(s as u32).0) as i32;\n        run_pair(a, b);\n    }\n}\n\n#[test]\nfn test_min_intentional_overflow_paths() {\n    let imin = i32::MIN;\n    // Cases that exercise the special branches in C: v2 == INT_MIN, etc.\n    run_pair(imin, imin);\n    run_pair(imin, 1);\n    run_pair(imin, -1);\n    run_pair(1, imin);\n    run_pair(-1, imin);\n    run_pair(imin, 2);\n    run_pair(imin, -2);\n    run_pair(2, imin);\n    run_pair(-2, imin);\n    run_pair(imin + 1, imin);\n    run_pair(imin, imin + 1);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
