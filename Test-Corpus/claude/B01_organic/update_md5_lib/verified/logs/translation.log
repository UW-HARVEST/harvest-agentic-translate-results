) as tflac_uint) & 0xFF) << 48;\n            v |= ((core::ptr::read_unaligned(samples.add(7)) as tflac_uint) & 0xFF) << 56;\n\n            // 8 * sizeof(tflac_uint) == 64\n            tflac_md5_addsample(md5_ctx, 8u32.wrapping_mul(core::mem::size_of::<tflac_uint>() as tflac_u32), v);\n\n            b = b.wrapping_sub(step);\n\n            // samples += 8 * sizeof(tflac_s32);  /* 32 elements */\n            samples = samples.add(8usize * core::mem::size_of::<tflac_s32>());\n\n            i += 1;\n        }\n\n        b\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1329,"cache_read_input_tokens":19144,"cache_creation":{"ephemeral_5m_input_tokens":1329,"ephemeral_1h_input_tokens":0},"output_tokens":21,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"24557fbd-d81c-437e-b5ae-8c78a78a7ad3","uuid":"0cf872f3-1ec8-4de5-b4b1-d6042205dee6","timestamp":"2026-08-19T10:40:55.403Z"}
