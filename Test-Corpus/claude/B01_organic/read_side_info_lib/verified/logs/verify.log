l| {\n                let parts: Vec<&str> = l.split_whitespace().collect();\n                if parts.len() < 3 {\n                    return None;\n                }\n                let name = parts[2];\n                // Filter out runtime-provided symbols common to all shared libs.\n                let skip = [\n                    \"_init\",\n                    \"_fini\",\n                    \"__bss_start\",\n                    \"_edata\",\n                    \"_end\",\n                    \"__cxa_finalize\",\n                ];\n                if skip.contains(&name) {\n                    return None;\n                }\n                if name.starts_with(\"__\") {\n                    return None;\n                }\n                Some(name.to_string())\n            })\n            .collect()\n    };\n\n    let c_syms = extract_user_syms(&c_str);\n    let r_syms = extract_user_syms(&r_str);\n\n    for s in &c_syms {\n        assert!(\n            r_syms.iter().any(|x| x == s),\n            \"Rust .so missing symbol exported by C .so: {}\",\n            s\n        );\n    }\n}\n","structuredPatch":[{"oldStart":182,"oldLines":8,"newStart":182,"newLines":7,"lines":["         if (hdr[1] & 0x8) != 0 {","             gr_count *= 2;","         }","-        let granules = if gr_count >= 2 { 2 } else { 1 };","-        for i in 0..granules {","+        for i in 0..gr_count {","             assert_gr_equal(&c_gr[i], &r_gr[i], &format!(\"{} gr[{}]\", label, i));","         }","     }"]}],"userModified":false,"replaceAll":false}}
