 unsafe { Library::new(c_lib_path()) }.expect(\"load C .so\");\n    let r_lib = unsafe { Library::new(rust_lib_path()) }.expect(\"load Rust .so\");\n    for &inp in cases {\n        let c_out = unsafe { call(&c_lib, inp) };\n        let r_out = unsafe { call(&r_lib, inp) };\n        assert_bytes_eq(c_out, r_out, inp);\n    }\n}\n\n#[test]\nfn test_basic_colors() {\n    let cases = [\n        [0.0f32, 0.0, 0.0],     // black\n        [1.0, 1.0, 1.0],        // white\n        [1.0, 0.0, 0.0],        // pure red\n        [0.0, 1.0, 0.0],        // pure green\n        [0.0, 0.0, 1.0],        // pure blue\n        [1.0, 1.0, 0.0],        // yellow\n        [1.0, 0.0, 1.0],        // magenta\n        [0.0, 1.0, 1.0],        // cyan\n        [0.5, 0.5, 0.5],        // gray\n        [0.25, 0.75, 0.5],\n        [0.9, 0.1, 0.1],\n        [0.1, 0.9, 0.1],\n        [0.1, 0.1, 0.9],\n    ];\n    run_cases(&cases);\n}\n\n#[test]\nfn test_extreme_values() {\n    let cases = [\n        [f32::MIN_POSITIVE, 0.0, 0.0],\n        [1e-30, 1e-30, 1e-30],\n        [1e10, 5e9, 0.0],\n        [-1.0, 0.5, 0.5],     // negative inputs (still well-defined per code)\n        [-0.5, -0.25, -0.75],\n        [0.0, 0.0, f32::MIN_POSITIVE],\n    ];\n    run_cases(&cases);\n}\n\n#[test]\nfn test_random_values() {\n    // Deterministic LCG for reproducibility\n    let mut state: u64 = 0x123456789abcdef0;\n    let mut next = || {\n        state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        ((state >> 33) as u32) as f32 / (u32::MAX as f32)\n    };\n    let mut cases = Vec::new();\n    for _ in 0..1000 {\n        cases.push([next(), next(), next()]);\n    }\n    run_cases(&cases);\n}\n\n#[test]\nfn test_two_equal_max() {\n    // r == max && g == max but b is smaller -> should pick r branch\n    let cases = [\n        [1.0, 1.0, 0.0],\n        [0.5, 0.5, 0.25],\n        [1.0, 0.0, 1.0],   // r==b==max\n        [0.0, 1.0, 1.0],   // g==b==max\n        [0.7, 0.7, 0.7],\n    ];\n    run_cases(&cases);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
