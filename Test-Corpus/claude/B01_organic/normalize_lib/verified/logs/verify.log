\"$sf\\\"\\n\\\n             \\t\\tfi\\n\\\n             \\t\\t;;\\n\\\n             \\tesac\\n\\\n             done\\n\\\n             exec cc \\\"$@\\\"\\n\"\n        )\n        .expect(\"write wrapper\");\n        drop(f);\n        std::process::Command::new(\"chmod\")\n            .args([\"+x\", &wrapper])\n            .status()\n            .expect(\"chmod wrapper\");\n        println!(\"cargo:rustc-linker={}\", wrapper);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":414,"cache_read_input_tokens":46854,"cache_creation":{"ephemeral_5m_input_tokens":414,"ephemeral_1h_input_tokens":0},"output_tokens":37,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"750af272-61b0-442f-8704-09e695c6521b","uuid":"d8c7cf34-af03-418f-aa0a-537acbefd6ff"}
