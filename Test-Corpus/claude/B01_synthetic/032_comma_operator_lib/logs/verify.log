l<unsafe extern \"C\" fn(c_int)> =\n        lib.get(b\"driver\\0\").expect(\"driver symbol\");\n    capture_stdout(|| {\n        func(x);\n    })\n}\n\nfn open_libs() -> (Library, Library) {\n    let c = unsafe { Library::new(C_LIB) }.expect(\"load C lib\");\n    let r = unsafe { Library::new(RUST_LIB) }.expect(\"load Rust lib\");\n    (c, r)\n}\n\n#[test]\nfn driver_matches_for_various_inputs() {\n    let (c_lib, rust_lib) = open_libs();\n    let test_inputs: &[c_int] = &[\n        -5, -1, 0, 1, 2, 5, 10, 100, 1000,\n    ];\n    for &x in test_inputs {\n        let c_out = unsafe { call_driver(&c_lib, x) };\n        let r_out = unsafe { call_driver(&rust_lib, x) };\n        assert_eq!(\n            c_out,\n            r_out,\n            \"Mismatch for x = {}: C={:?}, Rust={:?}\",\n            x,\n            String::from_utf8_lossy(&c_out),\n            String::from_utf8_lossy(&r_out),\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":179,"cache_read_input_tokens":18945,"cache_creation":{"ephemeral_5m_input_tokens":179,"ephemeral_1h_input_tokens":0},"output_tokens":30,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"4f2cd82a-507d-47d5-bba1-bc05183cc21d","uuid":"64b788f4-c2a3-4403-8e70-b3b90d125a08"}
