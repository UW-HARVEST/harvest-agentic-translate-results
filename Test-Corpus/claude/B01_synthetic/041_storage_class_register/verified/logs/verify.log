onfiguration to verify.\n[features]\n\n[dev-dependencies]\nlibloading = \"0.8\"\nlibc = \"0.2\"\n\n[profile.release]\npanic = \"abort\"\n\n[workspace]\n","structuredPatch":[{"oldStart":26,"oldLines":6,"newStart":26,"newLines":19,"lines":[" libloading = \"0.8\""," libc = \"0.2\""," ","+# The in-process `libloading` comparisons redirect fd 1 to capture what the","+# loaded `.so`s print. libtest's own progress output (\"test foo ... ok\") also","+# goes to fd 1 from other threads, which would land inside the capture window,","+# so these tests run without the default harness and print nothing while a","+# capture is active.","+[[test]]","+name = \"phase_b_ffi\"","+harness = false","+","+[[test]]","+name = \"phase_c_ffi\"","+harness = false","+"," [profile.release]"," panic = \"abort\""," "]}],"userModified":false,"replaceAll":false}}
