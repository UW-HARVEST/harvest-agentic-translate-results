{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016zPS8L5kBDbkPWUToaHsQ3","type":"tool_result","content":"1\t// Copyright 2025 MIT Lincoln Laboratory\n2\t// Permission is hereby granted, free of charge,\n3\t// to any person obtaining a copy of this software\n4\t// and associated documentation files (the \"Software\"),\n5\t// to deal in the Software without restriction,\n6\t// including without limitation the rights to use, copy,\n7\t// modify, merge, publish, distribute, sublicense,\n8\t// and/or sell copies of the Software,\n9\t// and to permit persons to whom the Software is furnished to do so,\n10\t// subject to the following conditions:\n11\t//\n12\t// The above copyright notice and this permission notice\n13\t// shall be included in all copies or substantial portions of the Software.\n14\t//\n15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n17\t// THE WARRANTIES OF MERCHANTABILITY,\n18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n23\t\n24\t//! Rust translation of `c_src/src/main.c`.\n25\t//!\n26\t//! The C program reads a single integer with `scanf(\"%d\", &x)` and prints\n27\t//! `2 * x + 300` using `printf(\"%d\\n\", y)`. The translation reproduces the\n28\t//! original behaviour bit-for-bit, including:\n29\t//!\n30\t//! * `scanf` skipping leading whitespace (spaces, tabs, newlines, ...), so the\n31\t//!   value may appear on any line;\n32\t//! * a matching failure or end-of-file leaving `x` at its initial value of `0`;\n33\t//! * glibc's `%d` conversion accumulating the digits into a 64-bit `long`\n34\t//!   (saturating at `LONG_MAX` / `LONG_MIN` on overflow) and then storing the\n35\t//!   truncated low 32 bits into the `int` destination;\n36\t//! * the wrapping 32-bit arithmetic of `2*x` and `y += 300`;\n37\t//! * glibc's `stdin` buffering: one `read` of `st_blksize` (capped at `BUFSIZ`)\n38\t//!   bytes at a time, the single `ungetc` of the character that terminates the\n39\t//!   conversion, and the seek that restores a *seekable* `stdin` to the first\n40\t//!   unconsumed byte when the stream is cleaned up at exit — so a second reader\n41\t//!   sharing the descriptor sees exactly the same leftovers as with the C\n42\t//!   program.\n43\t\n44\tuse std::fs::File;\n45\tuse std::io::{Read, Seek, SeekFrom, Write};\n46\tuse std::mem::ManuallyDrop;\n47\tuse std::os::fd::FromRawFd;\n48\tuse std::os::unix::fs::MetadataExt;\n49\t\n50\t/// Bytes that C's `isspace()` reports as whitespace in the \"C\" locale, i.e. the\n51\t/// characters that `scanf`'s `%d` directive silently consumes before the number.\n52\tfn is_c_space(b: u8) -> bool {\n53\t    b == b' '        // space\n54\t        || b == b'\\t' // horizontal tab\n55\t        || b == b'\\n' // line feed\n56\t        || b == 0x0b_u8 // vertical tab\n57\t        || b == 0x0c_u8 // form feed\n58\t        || b == b'\\r' // carriage return\n59\t}\n60\t\n61\t/// `stdin` with glibc's `FILE` semantics, to the extent `scanf(\"%d\")` can\n62\t/// observe them.\n63\t///\n64\t/// Rust's `io::Stdin` would over-read (an 8 KiB `BufReader`) and would never\n65\t/// give the unconsumed bytes back, which is observable by anything else that\n66\t/// shares file descriptor 0 — e.g. `{ ./driver; cat; } < file`. glibc instead\n67\t///\n68\t/// * fills a buffer of `st_blksize` bytes (capped at `BUFSIZ`, i.e. 8192) per\n69\t///   `read` — see `_IO_file_doallocate`,\n70\t/// * pushes the character that terminated the conversion back with `ungetc`,\n71\t/// * and, while cleaning the stream up at exit, `lseek`s a seekable descriptor\n72\t///   back to the first byte the conversion did not consume.\n73\tstruct CStdin {\n74\t    /// File descriptor 0. `ManuallyDrop` because closing it is not ours to do.\n75\t    file: ManuallyDrop<File>,\n76\t    buf: Vec<u8>,\n77\t    /// Index of the next buffered byte to hand to the parser.\n78\t    pos: usize,\n79\t    /// Number of valid bytes in `buf`.\n80\t    filled: usize,\n81\t    /// Bytes actually pulled out of the descriptor.\n82\t    read_total: u64,\n83\t    /// Bytes handed to the parser.\n84\t    handed: u64,\n85\t    /// Whether the last handed-out byte was pushed back (glibc's single-byte\n86\t    /// `ungetc`), meaning it must not count as consumed.\n87\t    pushed_back: bool,\n88\t    eof: bool,\n89\t}\n90\t\n91\timpl CStdin {\n92\t    fn new() -> CStdin {\n93\t        // SAFETY: fd 0 is the process's standard input, which outlives this\n94\t        // wrapper; `ManuallyDrop` makes sure it is never closed here.\n95\t        let file = ManuallyDrop::new(unsafe { File::from_raw_fd(0) });\n96\t\n97\t        // glibc `_IO_file_doallocate`: `size = BUFSIZ; if (st_blksize > 0 &&\n98\t        // st_blksize < BUFSIZ) size = st_blksize;`\n99\t        const BUFSIZ: u64 = 8192;\n100\t        let blksize = file.metadata().map(|m| m.blksize()).unwrap_or(0);\n101\t        let size = if blksize > 0 && blksize < BUFSIZ {\n102\t            blksize\n103\t        } else {\n104\t            BUFSIZ\n105\t        } as usize;\n106\t\n107\t        CStdin {\n108\t            file,\n109\t            buf: vec![0u8; size],\n110\t            pos: 0,\n111\t            filled: 0,\n112\t            read_total: 0,\n113\t            handed: 0,\n114\t            pushed_back: false,\n115\t            eof: false,\n116\t        }\n117\t    }\n118\t\n119\t    /// One character, or `None` at end of file / on a read error — glibc's\n120\t    /// `__underflow` does not retry, and an error is an input failure just like\n121\t    /// EOF, so neither does this.\n122\t    fn next_byte(&mut self) -> Option<u8> {\n123\t        if self.pos == self.filled {\n124\t            if self.eof {\n125\t                return None;\n126\t            }\n127\t            match self.file.read(&mut self.buf) {\n128\t                Ok(0) => {\n129\t                    self.eof = true;\n130\t                    return None;\n131\t                }\n132\t                Ok(n) => {\n133\t                    self.filled = n;\n134\t                    self.pos = 0;\n135\t                    self.read_total += n as u64;\n136\t                }\n137\t                Err(_) => {\n138\t                    self.eof = true;\n139\t                    return None;\n140\t                }\n141\t            }\n142\t        }\n143\t        let b = self.buf[self.pos];\n144\t        self.pos += 1;\n145\t        self.handed += 1;\n146\t        Some(b)\n147\t    }\n148\t\n149\t    /// glibc's `ungetc_not_eof`: the character that terminated the conversion\n150\t    /// goes back onto the stream. At most one character is ever pushed back.\n151\t    fn push_back(&mut self) {\n152\t        self.pushed_back = true;\n153\t    }\n154\t\n155\t    /// What glibc does to a seekable `stdin` when the stream is cleaned up:\n156\t    /// rewind the descriptor by however much was read ahead, so the shared file\n157\t    /// offset ends up exactly at the first unconsumed byte. Fails harmlessly\n158\t    /// with `ESPIPE` for pipes and terminals, exactly like glibc.\n159\t    fn restore_offset(&mut self) {\n160\t        let consumed = self.handed - u64::from(self.pushed_back);\n161\t        let read_ahead = self.read_total - consumed;\n162\t        if read_ahead > 0 {\n163\t            let _ = self.file.seek(SeekFrom::Current(-(read_ahead as i64)));\n164\t        }\n165\t    }\n166\t}\n167\t\n168\t/// Equivalent of `scanf(\"%d\", &x)`: returns `Some(value)` when the conversion\n169\t/// succeeds and `None` on a matching failure or input failure (in which case the\n170\t/// C code leaves `x` untouched).\n171\tfn scanf_d(input: &mut CStdin) -> Option<i32> {\n172\t    // Skip leading whitespace; `%d` crosses newlines while doing so. Running\n173\t    // into EOF here is an input failure with nothing to push back.\n174\t    let mut cur = loop {\n175\t        let b = input.next_byte()?;\n176\t        if !is_c_space(b) {\n177\t            break b;\n178\t        }\n179\t    };\n180\t\n181\t    // Optional sign. glibc has already accepted it into its work buffer, so it\n182\t    // stays consumed even when the conversion fails afterwards.\n183\t    let negative = match cur {\n184\t        b'-' | b'+' => {\n185\t            let negative = cur == b'-';\n186\t            match input.next_byte() {\n187\t                Some(b) => cur = b,\n188\t                // EOF directly after the sign: a matching failure, but there is\n189\t                // no character to give back.\n190\t                None => return None,\n191\t            }\n192\t            negative\n193\t        }\n194\t        _ => false,\n195\t    };\n196\t\n197\t    // At least one decimal digit is required, otherwise this is a matching\n198\t    // failure: glibc pushes the offending character back and leaves the\n199\t    // destination alone.\n200\t    if !cur.is_ascii_digit() {\n201\t        input.push_back();\n202\t        return None;\n203\t    }\n204\t\n205\t    // Accumulate the magnitude the way glibc's `strtol` does: saturate at the\n206\t    // `long` limit while still consuming every remaining digit.\n207\t    let limit: u64 = if negative {\n208\t        // |LONG_MIN| == 2^63\n209\t        (i64::MAX as u64) + 1\n210\t    } else {\n211\t        i64::MAX as u64\n212\t    };\n213\t    let mut magnitude: u64 = 0;\n214\t    let mut saturated = false;\n215\t\n216\t    loop {\n217\t        let digit = u64::from(cur - b'0');\n218\t        if !saturated {\n219\t            match magnitude\n220\t                .checked_mul(10)\n221\t                .and_then(|v| v.checked_add(digit))\n222\t            {\n223\t                Some(v) if v <= limit => magnitude = v,\n224\t                _ => {\n225\t                    saturated = true;\n226\t                    magnitude = limit;\n227\t                }\n228\t            }\n229\t        }\n230\t\n231\t        match input.next_byte() {\n232\t            Some(b) if b.is_ascii_digit() => cur = b,\n233\t            // The first non-digit terminates the conversion and is pushed back\n234\t            // onto the stream; at EOF there is nothing to push back.\n235\t            Some(_) => {\n236\t                input.push_back();\n237\t                break;\n238\t            }\n239\t            None => break,\n240\t        }\n241\t    }\n242\t\n243\t    // Value as stored in a `long`, then truncated to the `int` destination.\n244\t    let as_long: i64 = if negative {\n245\t        (magnitude.wrapping_neg()) as i64\n246\t    } else {\n247\t        magnitude as i64\n248\t    };\n249\t    Some(as_long as i32)\n250\t}\n251\t\n252\t/// Faithful translation of the C `driver` function (`register` is a no-op hint).\n253\tpub fn driver(x: i32) {\n254\t    let mut y: i32 = 2i32.wrapping_mul(x);\n255\t    y = y.wrapping_add(300);\n256\t    let stdout = std::io::stdout();\n257\t    let mut out = stdout.lock();\n258\t    let _ = write!(out, \"{}\\n\", y);\n259\t    let _ = out.flush();\n260\t}\n261\t\n262\t/// Faithful translation of the C `main` body: read one integer, call `driver`,\n263\t/// return `0`.\n264\t///\n265\t/// This is the part that is shared verbatim with the `cdylib`'s exported `main`\n266\t/// (see `src/ffi.rs`); it deliberately touches no process-global state, exactly\n267\t/// like the C `main`.\n268\tpub fn run() {\n269\t    let mut x: i32 = 0;\n270\t    let mut input = CStdin::new();\n271\t    if let Some(v) = scanf_d(&mut input) {\n272\t        x = v;\n273\t    }\n274\t    driver(x);\n275\t    // glibc does this while cleaning up `stdin` at exit, i.e. after `printf`.\n276\t    input.restore_offset();\n277\t}\n278\t\n279\t/// Restores the default `SIGPIPE` disposition.\n280\t///\n281\t/// Rust's runtime installs `SIG_IGN` for `SIGPIPE` before `main` runs, whereas a\n282\t/// C program inherits the default (`SIG_DFL`) disposition. Without this, writing\n283\t/// the result into a pipe whose read end has been closed makes the C program die\n284\t/// from `SIGPIPE` (exit status 141) while the Rust program would silently ignore\n285\t/// the failed `write` and exit `0`. Undoing Rust's default keeps the executable's\n286\t/// observable behaviour identical to the C executable's.\n287\t///\n288\t/// Only the *executable* entry point does this: the C `main` compiled into a\n289\t/// shared object does not change signal dispositions either, so the `cdylib`\n290\t/// export in `src/ffi.rs` calls [`run`] directly instead.\n291\t#[cfg(unix)]\n292\tfn restore_default_sigpipe() {\n293\t    const SIGPIPE: i32 = 13;\n294\t    const SIG_DFL: usize = 0;\n295\t    extern \"C\" {\n296\t        fn signal(signum: i32, handler: usize) -> usize;\n297\t    }\n298\t    // SAFETY: `signal` with `SIG_DFL` is async-signal-safe and cannot fail for\n299\t    // the valid signal number `SIGPIPE`; the returned previous handler is\n300\t    // discarded.\n301\t    unsafe {\n302\t        signal(SIGPIPE, SIG_DFL);\n303\t    }\n304\t}\n305\t\n306\t#[cfg(not(unix))]\n307\tfn restore_default_sigpipe() {}\n308\t\n309\tpub fn main() {\n310\t    restore_default_sigpipe();\n311\t    run();\n312\t}\n313\t"}]},"parent_tool_use_id":"toolu_bdrk_016tYVJgjag8saeJ3LxydRMU","session_id":"48be53e8-e7f1-4c70-a7a7-6c40e01deca5","uuid":"df6260a1-9d59-4d5f-9e5c-2b24b96d7d15","timestamp":"2026-08-18T13:04:51.476Z","subagent_type":"general-purpose","task_description":"Adversarial C-vs-Rust review"}
