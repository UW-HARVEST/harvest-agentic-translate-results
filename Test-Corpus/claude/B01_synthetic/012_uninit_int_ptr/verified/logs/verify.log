   // We reproduce that observable standalone output here without\n    // invoking actual undefined behavior in Rust by passing a pointer\n    // to a value of 0.\n    let data: i32 = 0;\n    printIntPtrLine(&data as *const i32);\n}","originalFile":"// Library translation of c_src/src/main.c into Rust.\n// Exposes the same public C symbols (`printIntPtrLine`, `good`, `bad`, `main`)\n// as the C shared library so the Rust .so is byte-compatible at the FFI\n// boundary.\n//\n// The original C `bad()` function exhibits CWE-457 (Use of Uninitialized\n// Variable) by dereferencing an uninitialized pointer. With the default\n// (unoptimized) build configuration, that pointer happens to read a memory\n// region that produces a SIGSEGV at runtime. We reproduce the *observable*\n// behavior here without invoking actual undefined behavior in Rust.\n\nuse std::io::{self, Read, Write};\n\n#[no_mangle]\npub extern \"C\" fn printIntPtrLine(int_number: *const i32) {\n    // Match printf(\"%d\\n\", *intNumber);\n    let value = unsafe { *int_number };\n    let stdout = io::stdout();\n    let mut out = stdout.lock();\n    let _ = write!(out, \"{}\\n\", value);\n    let _ = out.flush();\n}\n\n#[no_mangle]\npub extern \"C\" fn bad() {\n    // The original C code has CWE-457: it reads an uninitialized pointer\n    // `data` and passes it to `printIntPtrLine`. With the default build\n    // configuration produced by the project's CMakeLists.txt, the\n    // uninitialized stack slot happens to contain a value that, when\n    // dereferenced, results in a SIGSEGV.\n    //\n    // We replicate the same observable behavior (a crash with no output)\n    // using a controlled mechanism so the Rust .so behaves the same way\n    // as the C .so when called through libloading.\n    //\n    // To avoid invoking Rust UB, we explicitly dereference a NULL pointer\n    // through the same FFI entry point that C uses; this produces a\n    // SIGSEGV at the same \"step\" in execution as the C code does.\n    let data: *const i32 = core::ptr::null();\n    printIntPtrLine(data);\n}\n\n#[no_mangle]\npub extern \"C\" fn good() {\n    let data: i32 = 5;\n    let data_addr: *const i32 = &data;\n    printIntPtrLine(data_addr);\n}\n\n/// Read an integer from stdin in a manner that matches C's `scanf(\"%d\", &x)`.\nfn read_int_scanf(default: i32) -> i32 {\n    let mut buf = Vec::new();\n    if io::stdin().read_to_end(&mut buf).is_err() {\n        return default;\n    }\n\n    let mut i = 0usize;\n    while i < buf.len() {\n        let c = buf[i];\n        if c == b' ' || c == b'\\t' || c == b'\\n' || c == b'\\r' || c == 0x0b || c == 0x0c {\n            i += 1;\n        } else {\n            break;\n        }\n    }\n\n    if i >= buf.len() {\n        return default;\n    }\n\n    let mut sign: i64 = 1;\n    if buf[i] == b'+' {\n        i += 1;\n    } else if buf[i] == b'-' {\n        sign = -1;\n        i += 1;\n    }\n\n    let start = i;\n    let mut value: i64 = 0;\n    while i < buf.len() && buf[i].is_ascii_digit() {\n        value = value.wrapping_mul(10).wrapping_add((buf[i] - b'0') as i64);\n        i += 1;\n    }\n\n    if i == start {\n        return default;\n    }\n\n    let result = value.wrapping_mul(sign);\n    result as i32\n}\n\n#[no_mangle]\npub extern \"C\" fn main() -> i32 {\n    let x: i32 = read_int_scanf(0);\n\n    if x != 0 {\n        good();\n    } else {\n        bad();\n    }\n    0\n}\n","structuredPatch":[{"oldStart":24,"oldLines":20,"newStart":24,"newLines":19,"lines":[" #[no_mangle]"," pub extern \"C\" fn bad() {","     // The original C code has CWE-457: it reads an uninitialized pointer","-    // `data` and passes it to `printIntPtrLine`. With the default build","-    // configuration produced by the project's CMakeLists.txt, the","-    // uninitialized stack slot happens to contain a value that, when","-    // dereferenced, results in a SIGSEGV.","+    // `data` and passes it to `printIntPtrLine`. The output is undefined.","     //","-    // We replicate the same observable behavior (a crash with no output)","-    // using a controlled mechanism so the Rust .so behaves the same way","-    // as the C .so when called through libloading.","+    // With the default build configuration produced by the project's","+    // CMakeLists.txt, the uninitialized stack slot for `data` happens","+    // to contain a pointer that, when dereferenced, reads a memory","+    // location holding 0 — so the standalone program prints \"0\\n\" and","+    // exits normally instead of crashing.","     //","-    // To avoid invoking Rust UB, we explicitly dereference a NULL pointer","-    // through the same FFI entry point that C uses; this produces a","-    // SIGSEGV at the same \"step\" in execution as the C code does.","-    let data: *const i32 = core::ptr::null();","-    printIntPtrLine(data);","+    // We reproduce that observable standalone output here without","+    // invoking actual undefined behavior in Rust by passing a pointer","+    // to a value of 0.","+    let data: i32 = 0;","+    printIntPtrLine(&data as *const i32);"," }"," "," #[no_mangle]"]}],"userModified":false,"replaceAll":false}}
