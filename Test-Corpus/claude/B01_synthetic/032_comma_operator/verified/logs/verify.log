{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Xd6rmhQvB19BfboHNSuf7S","type":"tool_result","content":"280\t    pub code: Option<i32>,\n281\t    pub signal: Option<i32>,\n282\t}\n283\t\n284\t/// The body of the re-executed child: loads the requested `.so`, points fd 1 at\n285\t/// the requested file, calls the exported `main`, and exits with its result.\n286\t///\n287\t/// Returns immediately when the harness environment variables are absent, i.e.\n288\t/// when this is just a normal test run.\n289\tpub fn child_harness_body() {\n290\t    let lib = match std::env::var(ENV_LIB) {\n291\t        Ok(v) => v,\n292\t        Err(_) => return,\n293\t    };\n294\t    let out = std::env::var(ENV_OUT).expect(\"harness output path\");\n295\t    {\n296\t        let file = fs::File::create(&out).expect(\"create harness output\");\n297\t        assert!(unsafe { dup2(file.as_raw_fd(), 1) } >= 0, \"dup2 failed\");\n298\t    }\n299\t    if std::env::var(ENV_CLOSE_STDIN).is_ok() {\n300\t        unsafe { close(0) };\n301\t    }\n302\t    if std::env::var(ENV_CLOSE_STDOUT).is_ok() {\n303\t        unsafe { close(1) };\n304\t    }\n305\t    let lib = unsafe { Library::new(&lib).expect(\"dlopen\") };\n306\t    let m: Symbol<MainFn> = unsafe { lib.get(b\"main\\0\").expect(\"`main` symbol\") };\n307\t    let code = unsafe { m() };\n308\t    unsafe { fflush(std::ptr::null_mut()) };\n309\t    std::process::exit(code);\n310\t}\n311\t\n312\t/// Calls the `main` symbol exported by `lib` in a fresh child process, feeding\n313\t/// it `input` on stdin.\n314\tpub fn run_main_via_so(lib: &Path, input: &[u8], stdin_kind: StdinKind) -> Run {\n315\t    let out_path = unique_name(\"harness-out\");\n316\t    let mut cmd = Command::new(std::env::current_exe().expect(\"current_exe\"));\n317\t    cmd.args([\"--exact\", HARNESS_TEST, \"--nocapture\", \"--test-threads=1\"])\n318\t        .env(ENV_LIB, lib)\n319\t        .env(ENV_OUT, &out_path)\n320\t        .stdout(Stdio::null())\n321\t        .stderr(Stdio::null());\n322\t\n323\t    let in_file_path;\n324\t    match stdin_kind {\n325\t        StdinKind::Pipe => {\n326\t            cmd.stdin(Stdio::piped());\n327\t            in_file_path = None;\n328\t        }\n329\t        StdinKind::File => {\n330\t            let p = unique_name(\"harness-in\");\n331\t            fs::write(&p, input).expect(\"write harness input\");\n332\t            cmd.stdin(Stdio::from(fs::File::open(&p).expect(\"open harness input\")));\n333\t            in_file_path = Some(p);\n334\t        }\n335\t    }\n336\t\n337\t    let mut child = cmd.spawn().expect(\"spawn harness child\");\n338\t    if stdin_kind == StdinKind::Pipe {\n339\t        let mut si = child.stdin.take().expect(\"child stdin\");\n340\t        // The child may stop reading; a broken pipe here is not an error.\n341\t        let _ = si.write_all(input);\n342\t        drop(si);\n343\t    }\n344\t    let status = child.wait().expect(\"wait harness child\");\n345\t    let stdout = fs::read(&out_path).unwrap_or_default();\n346\t    let _ = fs::remove_file(&out_path);\n347\t    if let Some(p) = in_file_path {\n348\t        let _ = fs::remove_file(p);\n349\t    }\n350\t    Run {\n351\t        stdout,\n352\t        code: status.code(),\n353\t        signal: status.signal(),\n354\t    }\n355\t}\n356\t\n357\t#[track_caller]\n358\tpub fn assert_main_so_eq(input: &[u8], stdin_kind: StdinKind) {\n359\t    let c = run_main_via_so(&c_so(), input, stdin_kind);"}]},"parent_tool_use_id":null,"session_id":"759a51e0-0b19-4394-ad6e-11c06fea80b5","uuid":"9e530b1a-62a4-404e-9fc3-47eff65e3e61","timestamp":"2026-08-18T08:38:36.111Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-uE7TUY/translated_rust/tests/common/mod.rs","content":"    pub code: Option<i32>,\n    pub signal: Option<i32>,\n}\n\n/// The body of the re-executed child: loads the requested `.so`, points fd 1 at\n/// the requested file, calls the exported `main`, and exits with its result.\n///\n/// Returns immediately when the harness environment variables are absent, i.e.\n/// when this is just a normal test run.\npub fn child_harness_body() {\n    let lib = match std::env::var(ENV_LIB) {\n        Ok(v) => v,\n        Err(_) => return,\n    };\n    let out = std::env::var(ENV_OUT).expect(\"harness output path\");\n    {\n        let file = fs::File::create(&out).expect(\"create harness output\");\n        assert!(unsafe { dup2(file.as_raw_fd(), 1) } >= 0, \"dup2 failed\");\n    }\n    if std::env::var(ENV_CLOSE_STDIN).is_ok() {\n        unsafe { close(0) };\n    }\n    if std::env::var(ENV_CLOSE_STDOUT).is_ok() {\n        unsafe { close(1) };\n    }\n    let lib = unsafe { Library::new(&lib).expect(\"dlopen\") };\n    let m: Symbol<MainFn> = unsafe { lib.get(b\"main\\0\").expect(\"`main` symbol\") };\n    let code = unsafe { m() };\n    unsafe { fflush(std::ptr::null_mut()) };\n    std::process::exit(code);\n}\n\n/// Calls the `main` symbol exported by `lib` in a fresh child process, feeding\n/// it `input` on stdin.\npub fn run_main_via_so(lib: &Path, input: &[u8], stdin_kind: StdinKind) -> Run {\n    let out_path = unique_name(\"harness-out\");\n    let mut cmd = Command::new(std::env::current_exe().expect(\"current_exe\"));\n    cmd.args([\"--exact\", HARNESS_TEST, \"--nocapture\", \"--test-threads=1\"])\n        .env(ENV_LIB, lib)\n        .env(ENV_OUT, &out_path)\n        .stdout(Stdio::null())\n        .stderr(Stdio::null());\n\n    let in_file_path;\n    match stdin_kind {\n        StdinKind::Pipe => {\n            cmd.stdin(Stdio::piped());\n            in_file_path = None;\n        }\n        StdinKind::File => {\n            let p = unique_name(\"harness-in\");\n            fs::write(&p, input).expect(\"write harness input\");\n            cmd.stdin(Stdio::from(fs::File::open(&p).expect(\"open harness input\")));\n            in_file_path = Some(p);\n        }\n    }\n\n    let mut child = cmd.spawn().expect(\"spawn harness child\");\n    if stdin_kind == StdinKind::Pipe {\n        let mut si = child.stdin.take().expect(\"child stdin\");\n        // The child may stop reading; a broken pipe here is not an error.\n        let _ = si.write_all(input);\n        drop(si);\n    }\n    let status = child.wait().expect(\"wait harness child\");\n    let stdout = fs::read(&out_path).unwrap_or_default();\n    let _ = fs::remove_file(&out_path);\n    if let Some(p) = in_file_path {\n        let _ = fs::remove_file(p);\n    }\n    Run {\n        stdout,\n        code: status.code(),\n        signal: status.signal(),\n    }\n}\n\n#[track_caller]\npub fn assert_main_so_eq(input: &[u8], stdin_kind: StdinKind) {\n    let c = run_main_via_so(&c_so(), input, stdin_kind);","numLines":80,"startLine":280,"totalLines":671}}}
