ed: None,\n44\t            eof: false,\n45\t        }\n46\t    }\n47\t\n48\t    fn next_byte(&mut self) -> Option<u8> {\n49\t        if let Some(b) = self.peeked.take() {\n50\t            return Some(b);\n51\t        }\n52\t        if self.eof {\n53\t            return None;\n54\t        }\n55\t        let mut buf = [0u8; 1];\n56\t        loop {\n57\t            match self.inner.read(&mut buf) {\n58\t                Ok(0) => {\n59\t                    self.eof = true;\n60\t                    return None;\n61\t                }\n62\t                Ok(_) => return Some(buf[0]),\n63\t                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n64\t                Err(_) => {\n65\t                    self.eof = true;\n66\t                    return None;\n67\t                }\n68\t            }\n69\t        }\n70\t    }\n71\t\n72\t    fn unget(&mut self, b: u8) {\n73\t        self.peeked = Some(b);\n74\t    }\n75\t}\n76\t\n77\t/// C's `isspace` for the default \"C\" locale.\n78\tfn is_c_space(b: u8) -> bool {\n79\t    matches!(b, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n80\t}\n81\t\n82\t/// Emulates `scanf(\"%d\", &x)`: returns `Some(value)` on a successful\n83\t/// conversion, `None` on input failure (EOF) or matching failure, in which\n84\t/// case the caller's variable is left untouched (as in C).\n85\tfn scan_int(sc: &mut Scanner) -> Option<i32> {\n86\t    // Skip leading whitespace.\n87\t    let mut b = loop {\n88\t        match sc.next_byte() {\n89\t            Some(c) if is_c_space(c) => continue,\n90\t            Some(c) => break c,\n91\t            None => return None, // input failure\n92\t        }\n93\t    };\n94\t\n95\t    // Optional sign.\n96\t    let negative = match b {\n97\t        b'-' => {\n98\t            b = match sc.next_byte() {\n99\t                Some(c) => c,\n100\t                None => return None,\n101\t            };\n102\t            true\n103\t        }\n104\t        b'+' => {\n105\t            b = match