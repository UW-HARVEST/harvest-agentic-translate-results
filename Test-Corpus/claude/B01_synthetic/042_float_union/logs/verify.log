[test]","-fn driver_min() {","-    assert_match(f64::MIN);","-}","-","-#[test]","-fn driver_rounding_boundary() {","-    // 0.00005 rounds in the last %.4f digit — exercises rounding behavior.","-    assert_match(0.00005);","-}","-","-#[test]","-fn driver_negative_rounding() {","-    assert_match(-0.00005);","-}","-","-#[test]","-fn driver_one_third() {","-    assert_match(1.0 / 3.0);","-}","-","-#[test]","-fn driver_two_thirds() {","-    assert_match(2.0 / 3.0);","-}","-","-#[test]"," fn driver_main_symbol_present() {","-    // Sanity check that the Rust .so exports `main` like the C .so does.","+    // The Rust .so must export `main` with the exact same name as the C .so.","     let rust = unsafe { Library::new(rust_lib_path()).expect(\"load rust\") };","     let _: Symbol<unsafe extern \"C\" fn() -> c_int> =","         unsafe { rust.get(b\"main\").expect(\"main not exported by Rust .so\") };"]}],"originalFile":"// Compares the C shared library's `driver(double)` output against the Rust\n// shared library's `driver(double)` output for byte-identical equality.\n//\n// Both .so files are loaded via libloading; their `driver` symbol is invoked\n// directly. We redirect stdout (fd 1) to a temp file around each call so we\n// can capture the printf output from libc.\n\nuse libloading::{Library, Symbol};\nuse std::fs::File;\nuse std::io::{Read, Seek, SeekFrom};\nuse std::os::raw::{c_double, c_int};\nuse std::os::unix::io::AsRawFd;\nuse std::path::PathBuf;\nuse std::sync::Mutex;\n\n// Serialize all stdout-capturing work, since multiple tests racing on fd 1\n// would corrupt each other's captures.\nstatic STDOUT_LOCK: Mutex<()> = Mutex::new(());\n\nextern \"C\" {\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    fn fflush(stream: *mut std::ffi::c_void) -> c_int;\n}\n\n/// Locate the C shared library produced by gcc into translated_rust/test_build/.\nfn c_lib_path() -> PathBuf {\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    manifest.join(\"test_build/libdriver_c.so\")\n}\n\n/// Locate the Rust shared library produced by cargo (release).\nfn rust_lib_path() -> PathBuf {\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    let release = manifest.join(\"target/release/libdriver.so\");\n    if release.exists() {\n        return release;\n    }\n    manifest.join(\"target/debug/libdriver.so\")\n}\n\n/// Captures everything written to stdout by `f` and returns it as raw bytes.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    let _guard = STDOUT_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n    // Flush libc's stdout buffer first so any pending output goes to the\n    // original fd, not the captured one.\n    unsafe {\n        // 0 here is libc's NULL FILE*, but fflush(NULL) flushes all streams.\n        fflush(std::ptr::null_mut());\n    }\n\n    let tmp = tempfile_in_target();\n    let saved_fd: c_int = unsafe { dup(1) };\n    assert!(saved_fd >= 0, \"dup(stdout) failed\");\n\n    let tmp_fd = tmp.as_raw_fd();\n    let r = unsafe { dup2(tmp_fd, 1) };\n    assert!(r >= 0, \"dup2 failed\");\n\n    f();\n\n    unsafe {\n        fflush(std::ptr::null_mut());\n    }\n\n    // Restore stdout.\n    unsafe {\n        dup2(saved_fd, 1);\n        close(saved_fd);\n    }\n\n    // Read back what was written.\n    let mut tmp = tmp;\n    tmp.seek(SeekFrom::Start(0)).expect(\"seek tmp\");\n    let mut out = Vec::new();\n    tmp.read_to_end(&mut out).expect(\"read tmp\");\n    out\n}\n\nfn tempfile_in_target() -> File {\n    use std::sync::atomic::{AtomicU64, Ordering};\n    static COUNTER: AtomicU64 = AtomicU64::new(0);\n    let n = COUNTER.fetch_add(1, Ordering::Relaxed);\n    let mut path = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    path.push(\"target\");\n    path.push(format!(\"capture-{}-{}.tmp\", std::process::id(), n));\n    let f = std::fs::OpenOptions::new()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(true)\n        .open(&path)\n        .expect(\"open tempfile\");\n    // Best-effort unlink so we don't leave junk behind even if the test panics.\n    let _ = std::fs::remove_file(&path);\n    f\n}\n\ntype DriverFn = unsafe extern \"C\" fn(c_double);\n\nfn run_driver(lib_path: &PathBuf, f: c_double) -> Vec<u8> {\n    let lib = unsafe { Library::new(lib_path).expect(\"load lib\") };\n    let driver: Symbol<DriverFn> = unsafe { lib.get(b\"driver\").expect(\"driver symbol\") };\n    capture_stdout(|| unsafe { driver(f) })\n}\n\nfn assert_match(input: c_double) {\n    let c_out = run_driver(&c_lib_path(), input);\n    let r_out = run_driver(&rust_lib_path(), input);\n    assert_eq!(\n        c_out,\n        r_out,\n        \"mismatch for input {:?}\\n  C   : {:?}\\n  Rust: {:?}\",\n        input,\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&r_out),\n    );\n}\n\n#[test]\nfn driver_zero() {\n    assert_match(0.0);\n}\n\n#[test]\nfn driver_negative_zero() {\n    assert_match(-0.0);\n}\n\n#[test]\nfn driver_one() {\n    assert_match(1.0);\n}\n\n#[test]\nfn driver_negative_one() {\n    assert_match(-1.0);\n}\n\n#[test]\nfn driver_pi() {\n    assert_match(std::f64::consts::PI);\n}\n\n#[test]\nfn driver_e() {\n    assert_match(std::f64::consts::E);\n}\n\n#[test]\nfn driver_small() {\n    assert_match(1.234e-300);\n}\n\n#[test]\nfn driver_large() {\n    assert_match(1.234e300);\n}\n\n#[test]\nfn driver_inf() {\n    assert_match(f64::INFINITY);\n}\n\n#[test]\nfn driver_neg_inf() {\n    assert_match(f64::NEG_INFINITY);\n}\n\n#[test]\nfn driver_nan() {\n    assert_match(f64::NAN);\n}\n\n#[test]\nfn driver_min_positive() {\n    assert_match(f64::MIN_POSITIVE);\n}\n\n#[test]\nfn driver_subnormal() {\n    // Smallest positive subnormal.\n    assert_match(f64::from_bits(1));\n}\n\n#[test]\nfn driver_max() {\n    assert_match(f64::MAX);\n}\n\n#[test]\nfn driver_min() {\n    assert_match(f64::MIN);\n}\n\n#[test]\nfn driver_rounding_boundary() {\n    // 0.00005 rounds in the last %.4f digit — exercises rounding behavior.\n    assert_match(0.00005);\n}\n\n#[test]\nfn driver_negative_rounding() {\n    assert_match(-0.00005);\n}\n\n#[test]\nfn driver_one_third() {\n    assert_match(1.0 / 3.0);\n}\n\n#[test]\nfn driver_two_thirds() {\n    assert_match(2.0 / 3.0);\n}\n\n#[test]\nfn driver_main_symbol_present() {\n    // Sanity check that the Rust .so exports `main` like the C .so does.\n    let rust = unsafe { Library::new(rust_lib_path()).expect(\"load rust\") };\n    let _: Symbol<unsafe extern \"C\" fn() -> c_int> =\n        unsafe { rust.get(b\"main\").expect(\"main not exported by Rust .so\") };\n    let c = unsafe { Library::new(c_lib_path()).expect(\"load c\") };\n    let _: Symbol<unsafe extern \"C\" fn() -> c_int> =\n        unsafe { c.get(b\"main\").expect(\"main not exported by C .so\") };\n}\n","userModified":false}}
