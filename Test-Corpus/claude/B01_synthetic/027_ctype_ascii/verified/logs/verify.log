nput space."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":458,"cache_read_input_tokens":23848,"cache_creation":{"ephemeral_5m_input_tokens":458,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"949e1fe7-0afa-45ab-9d56-5bc46b5d773e","uuid":"e11f66d6-e04e-4ab4-9394-78af653c5804"}
