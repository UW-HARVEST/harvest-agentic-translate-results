ci));\n        let _ = writeln!(out, \"uppercase: {}\", isupper(ci));\n        let _ = writeln!(out, \"digit: {}\", isdigit(ci));\n        let _ = writeln!(out, \"hexadecimal: {}\", isxdigit(ci));\n        let _ = writeln!(out, \"control: {}\", iscntrl(ci));\n        let _ = writeln!(out, \"graphical: {}\", isgraph(ci));\n        let _ = writeln!(out, \"space: {}\", isspace(ci));\n        let _ = writeln!(out, \"blank: {}\", isblank(ci));\n        let _ = writeln!(out, \"printing: {}\", isprint(ci));\n        let _ = writeln!(out, \"punctuation: {}\", ispunct(ci));\n\n        // For %c with the int result of tolower/toupper, C prints the low byte as a single byte.\n        let lower = tolower(ci);\n        let upper = toupper(ci);\n        let lower_byte = (lower & 0xff) as u8;\n        let upper_byte = (upper & 0xff) as u8;\n        let _ = out.write_all(b\"to lower: \");\n        let _ = out.write_all(&[lower_byte]);\n        let _ = out.write_all(b\"\\n\");\n        let _ = out.write_all(b\"to upper: \");\n        let _ = out.write_all(&[upper_byte]);\n        let _ = out.write_all(b\"\\n\");\n    }\n}\n\nfn main() {\n    // Replicate `char c = getchar();`\n    // getchar() returns int. On EOF, it returns -1, and assigning to `char` in C\n    // truncates to the low byte (0xFF), which on signed-char platforms is -1.\n    // We mimic the same byte-level behavior here.\n    let mut buf = [0u8; 1];\n    let stdin = io::stdin();\n    let mut handle = stdin.lock();\n    let n = handle.read(&mut buf).unwrap_or(0);\n    let c: i8 = if n == 0 {\n        // EOF: getchar() returned -1, truncated to char.\n        -1i8\n    } else {\n        buf[0] as i8\n    };\n    driver(c);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":277,"cache_read_input_tokens":16649,"cache_creation":{"ephemeral_5m_input_tokens":277,"ephemeral_1h_input_tokens":0},"output_tokens":36,"service_tier":"standard"},"context_mana