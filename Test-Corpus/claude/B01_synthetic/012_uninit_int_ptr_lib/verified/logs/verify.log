","-    let value: c_int = unsafe { core::ptr::read_unaligned(intNumber) };","+    let value: c_int = unsafe { load_int_unchecked(intNumber) };","     unsafe {","         c_printf(c\"%d\\n\".as_ptr(), value);","     }"]}],"userModified":false,"replaceAll":false}}
