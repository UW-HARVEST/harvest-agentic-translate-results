strides too","+    for k in 0..32 {","+        cases.push(1_i32 << k.min(30));","+        cases.push(-(1_i32 << k.min(30)));","+    }"," ","-#[test]","-fn driver_parity_sweep() {","-    // Sweep a range of values","-    for x in -100..100 {","-        check_value(x as c_int);","+    for x in cases {","+        let c_out = run_driver(&c_lib, x);","+        let rust_out = run_driver(&rust_lib, x);","+        assert_eq!(","+            c_out, rust_out,","+            \"Mismatch for x={}: C={:?} Rust={:?}\",","+            x,","+            String::from_utf8_lossy(&c_out),","+            String::from_utf8_lossy(&rust_out)","+        );","+","+        // Sanity: output should be 8 lowercase hex digits + newline (for 4-byte int).","+        assert_eq!(c_out.len(), 9, \"unexpected length for x={}: {:?}\", x, c_out);","+        assert_eq!(c_out[8], b'\\n');","     }"," }","-","-#[test]","-fn rust_so_exports_driver_symbol() {","-    // Smoke check: ensure the Rust .so exports `driver` (no name mangling).","-    let lib = unsafe { Library::new(rust_lib_path()) }.expect(\"load rust .so\");","-    let _: Symbol<DriverFn> = unsafe { lib.get(b\"driver\") }.expect(\"driver symbol\");","-}"]}],"originalFile":"// Parity tests: compare Rust .so output to C .so output for `driver`.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_int;\nuse std::fs::File;\nuse std::io::{Read, Seek, SeekFrom};\nuse std::os::unix::io::AsRawFd;\nuse std::path::PathBuf;\nuse std::sync::Mutex;\n\n// Serialize fd-1 redirection across all tests in this binary; otherwise parallel\n// tests stomp on each other's captures.\nstatic STDOUT_LOCK: Mutex<()> = Mutex::new(());\n\ntype DriverFn = unsafe extern \"C\" fn(c_int);\n\nfn manifest_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    manifest_dir().join(\"c_src\").join(\"build\").join(\"libdriver.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    // Cargo sets OUT_DIR per build script; we instead rely on the standard target layout.\n    // CARGO_TARGET_DIR may be unset; fall back to manifest_dir/target/debug.\n    let mut p = manifest_dir();\n    p.push(\"target\");\n    p.push(\"debug\");\n    p.push(\"libdriver.so\");\n    p\n}\n\n/// Capture writes to stdout file descriptor 1 produced while running `f`.\n/// Works for both C printf and Rust's io::stdout because both ultimately write to fd 1.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    let _guard = STDOUT_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n    // Make sure existing buffered stdout (from prior test logging) is flushed.\n    use std::io::Write;\n    let _ = std::io::stdout().flush();\n    unsafe { libc::fflush(std::ptr::null_mut()) };\n\n    // Create temp file to redirect fd 1 into.\n    let tmp_path = std::env::temp_dir().join(format!(\"driver_parity_{}.out\", std::process::id()));\n    let tmp = File::options()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(true)\n        .open(&tmp_path)\n        .expect(\"open tmp file\");\n\n    let saved_fd = unsafe { libc::dup(1) };\n    assert!(saved_fd >= 0, \"dup failed\");\n\n    let new_fd = tmp.as_raw_fd();\n    let r = unsafe { libc::dup2(new_fd, 1) };\n    assert!(r >= 0, \"dup2 failed\");\n\n    // Run the closure\n    f();\n\n    // Flush C stdio and Rust stdout before restoring fd 1.\n    let _ = std::io::stdout().flush();\n    unsafe { libc::fflush(std::ptr::null_mut()) };\n\n    // Restore stdout\n    unsafe {\n        libc::dup2(saved_fd, 1);\n        libc::close(saved_fd);\n    }\n\n    // Read tmp file contents\n    let mut tmp = tmp;\n    tmp.seek(SeekFrom::Start(0)).expect(\"seek\");\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).expect(\"read\");\n\n    // Cleanup\n    drop(tmp);\n    let _ = std::fs::remove_file(&tmp_path);\n\n    buf\n}\n\nfn run_driver(lib_path: &std::path::Path, x: c_int) -> Vec<u8> {\n    let lib = unsafe { Library::new(lib_path) }\n        .unwrap_or_else(|e| panic!(\"load {}: {}\", lib_path.display(), e));\n    let driver: Symbol<DriverFn> = unsafe { lib.get(b\"driver\") }\n        .expect(\"driver symbol\");\n\n    let out = capture_stdout(|| unsafe { driver(x) });\n    drop(driver);\n    drop(lib);\n    out\n}\n\nfn check_value(x: c_int) {\n    let c_out = run_driver(&c_lib_path(), x);\n    let rust_out = run_driver(&rust_lib_path(), x);\n    assert_eq!(\n        c_out, rust_out,\n        \"Mismatch for x={}: C={:?} Rust={:?}\",\n        x,\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&rust_out)\n    );\n}\n\n#[test]\nfn driver_parity_basic_values() {\n    let cases: &[c_int] = &[\n        0,\n        1,\n        -1,\n        2,\n        -2,\n        42,\n        -42,\n        0x1234,\n        i32::MAX,\n        i32::MIN,\n        0x7fffffff,\n        -0x80000000_i32,\n        0x12345678,\n        -0x12345678,\n        0x000000ff,\n        0x0000ff00,\n        0x00ff0000,\n        -1_i32 << 24,\n    ];\n    for &x in cases {\n        check_value(x);\n    }\n}\n\n#[test]\nfn driver_parity_sweep() {\n    // Sweep a range of values\n    for x in -100..100 {\n        check_value(x as c_int);\n    }\n}\n\n#[test]\nfn rust_so_exports_driver_symbol() {\n    // Smoke check: ensure the Rust .so exports `driver` (no name mangling).\n    let lib = unsafe { Library::new(rust_lib_path()) }.expect(\"load rust .so\");\n    let _: Symbol<DriverFn> = unsafe { lib.get(b\"driver\") }.expect(\"driver symbol\");\n}\n","userModified":false}}
