{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_ceuk3lca53xs3bbjtu7b327zcmzoyaa47abfn35763odhsfqq5vq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_018b2kthYhi86tVR23engtvQ","name":"Write","input":{"file_path":"/tmp/harvest-work-a9uBF9/translated_rust/tests/ffi_compare.rs","content":"// Integration tests that load BOTH the C-built .so and the Rust-built .so\n// via libloading, invoke their exported functions through the FFI boundary,\n// and assert that the outputs match byte-for-byte.\n//\n// We never call the Rust functions directly; everything goes through dlopen\n// just like an external caller would, so the `#[no_mangle]` export wrappers\n// are exercised.\n\nuse libloading::{Library, Symbol};\nuse std::fs::File;\nuse std::io::{Read, Seek, SeekFrom, Write};\nuse std::os::unix::io::{AsRawFd, FromRawFd};\nuse std::path::PathBuf;\nuse std::sync::Mutex;\n\n// dup/dup2/close come from libc; we link against them via the platform libc.\nextern \"C\" {\n    fn dup(oldfd: i32) -> i32;\n    fn dup2(oldfd: i32, newfd: i32) -> i32;\n    fn close(fd: i32) -> i32;\n    fn fflush(stream: *mut core::ffi::c_void) -> i32;\n}\n\n// Serialise stdout-capturing tests: we mutate the process-global FD 1.\nstatic STDOUT_LOCK: Mutex<()> = Mutex::new(());\n\nfn c_so_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src/build/libdriver.so\");\n    p\n}\n\nfn rust_so_path() -> PathBuf {\n    // Same crate, \"release\" or \"debug\" depending on cargo profile.\n    // CARGO_TARGET_DIR overrides the default target/.\n    let target_dir = std::env::var(\"CARGO_TARGET_DIR\")\n        .unwrap_or_else(|_| {\n            let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n            p.push(\"target\");\n            p.to_string_lossy().into_owned()\n        });\n    let profile = if cfg!(debug_assertions) { \"debug\" } else { \"release\" };\n    let mut p = PathBuf::from(target_dir);\n    p.push(profile);\n    p.push(\"libdriver.so\");\n    p\n}\n\n/// Run a closure while FD 1 is redirected to a temp file; returns the bytes\n/// captured. The original FD 1 is restored on exit.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    let _guard = STDOUT_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n\n    // Make a tempfile via tempfile-less technique: use a memfd via /tmp.\n    let tmp_path = std::env::temp_dir().join(format!(\n        \"ffi_capture_{}_{}\",\n        std::process::id(),\n        std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .map(|d| d.as_nanos())\n            .unwrap_or(0)\n    ));\n    let mut tmp = File::options()\n        .read(true)\n        .write(true)\n        .create_new(true)\n        .open(&tmp_path)\n        .expect(\"create temp file\");\n\n    // Flush any pending Rust stdout buffering before swap.\n    let _ = std::io::stdout().flush();\n    // Flush libc stdout in case the C code already wrote buffered data.\n    unsafe {\n        fflush(core::ptr::null_mut());\n    }\n\n    let saved_fd = unsafe { dup(1) };\n    assert!(saved_fd >= 0, \"dup(1) failed\");\n    let new_fd = tmp.as_raw_fd();\n    let rc = unsafe { dup2(new_fd, 1) };\n    assert!(rc >= 0, \"dup2 failed\");\n\n    // Run the function. Even if it panics we want to restore FD 1.\n    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f));\n\n    // Flush libc stdout (the C printf buffers!), then Rust stdout.\n    unsafe {\n        fflush(core::ptr::null_mut());\n    }\n    let _ = std::io::stdout().flush();\n\n    // Restore FD 1.\n    let rc = unsafe { dup2(saved_fd, 1) };\n    assert!(rc >= 0, \"dup2 restore failed\");\n    unsafe {\n        close(saved_fd);\n    }\n\n    // Read what was written.\n    tmp.seek(SeekFrom::Start(0)).expect(\"seek\");\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).expect(\"read\");\n    drop(tmp);\n    let _ = std::fs::remove_file(&tmp_path);\n\n    if let Err(e) = result {\n        std::panic::resume_unwind(e);\n    }\n\n    buf\n}\n\nunsafe fn load_driver(lib: &Library) -> Symbol<'_, unsafe extern \"C\" fn(i32)> {\n    lib.get(b\"driver\\0\").expect(\"driver symbol\")\n}\n\nfn run_driver_via_lib(path: &std::path::Path, x: i32) -> Vec<u8> {\n    capture_stdout(|| unsafe {\n        let lib = Library::new(path).expect(\"load .so\");\n        let driver = load_driver(&lib);\n        driver(x);\n        // ensure libc stdout buffer flushed (also done in capture_stdout)\n        fflush(core::ptr::null_mut());\n        // drop closes the library\n        drop(driver);\n    })\n}\n\nfn assert_driver_match(x: i32) {\n    let c_out = run_driver_via_lib(&c_so_path(), x);\n    let rust_out = run_driver_via_lib(&rust_so_path(), x);\n    assert_eq!(\n        c_out, rust_out,\n        \"driver({}) mismatch\\nC:    {:?}\\nRust: {:?}\",\n        x,\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&rust_out),\n    );\n}\n\n#[test]\nfn driver_zero() {\n    assert_driver_match(0);\n}\n\n#[test]\nfn driver_positive() {\n    for x in [1, 2, 5, 10, 42, 100, 999, 1_000_000] {\n        assert_driver_match(x);\n    }\n}\n\n#[test]\nfn driver_negative() {\n    for x in [-1, -2, -10, -42, -150, -1_000_000] {\n        assert_driver_match(x);\n    }\n}\n\n#[test]\nfn driver_boundary() {\n    // 2*x + 300 might overflow at extremes; both implementations should wrap\n    // identically (Rust uses wrapping_mul/wrapping_add, C uses int wraparound).\n    for x in [\n        i32::MAX,\n        i32::MIN,\n        i32::MAX - 1,\n        i32::MIN + 1,\n        i32::MAX / 2,\n        i32::MIN / 2,\n        1_000_000_000,\n        -1_000_000_000,\n        1_073_741_823,  // ~ MAX/2\n        -1_073_741_824, // ~ MIN/2\n    ] {\n        assert_driver_match(x);\n    }\n}\n\n/// Sanity check that both .so files actually export the public API symbols\n/// we care about.\n#[test]\nfn both_libs_export_driver_and_main() {\n    unsafe {\n        let c_lib = Library::new(c_so_path()).expect(\"load C .so\");\n        let _: Symbol<unsafe extern \"C\" fn(i32)> =\n            c_lib.get(b\"driver\\0\").expect(\"C exports driver\");\n        // C exports main as well (it's the executable entry point).\n        let _: Symbol<unsafe extern \"C\" fn() -> i32> =\n            c_lib.get(b\"main\\0\").expect(\"C exports main\");\n\n        let rust_lib = Library::new(rust_so_path()).expect(\"load Rust .so\");\n        let _: Symbol<unsafe extern \"C\" fn(i32)> =\n            rust_lib.get(b\"driver\\0\").expect(\"Rust exports driver\");\n        let _: Symbol<unsafe extern \"C\" fn() -> i32> =\n            rust_lib.get(b\"main\\0\").expect(\"Rust exports main\");\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":261,"cache_read_input_tokens":26559,"cache_creation":{"ephemeral_5m_input_tokens":261,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"af390f4e-aa81-4cd0-9d70-73ac4a5ce1cb","uuid":"a750f9f8-1f4a-4b08-b4ff-faa04e21dda6"}
