no_mangle)]\npub extern \"C\" fn run(extra_bedrooms: c_int) {\n    print_the_house();\n    add_floor_to_the_house();\n    print_the_house();\n    {\n        let mut h = THE_HOUSE.lock().unwrap();\n        h.bathrooms += 1.0;\n    }\n    print_the_house();\n    {\n        let mut h = THE_HOUSE.lock().unwrap();\n        add_bedrooms(&mut h, extra_bedrooms);\n    }\n    print_the_house();\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn driver(x: c_int) {\n    run(x);\n    run(x);\n}\n","structuredPatch":[{"oldStart":15,"oldLines":11,"newStart":15,"newLines":12,"lines":[" });"," "," fn add_floor(house: &mut House) {","-    house.floors += 1;","+    // Use wrapping arithmetic to match C's signed-integer behavior on overflow.","+    house.floors = house.floors.wrapping_add(1);"," }"," "," fn add_bedrooms(house: &mut House, extra_bedrooms: c_int) {","-    house.bedrooms += extra_bedrooms;","+    house.bedrooms = house.bedrooms.wrapping_add(extra_bedrooms);"," }"," "," fn add_floor_to_the_house() {"]}],"userModified":false,"replaceAll":false}}
