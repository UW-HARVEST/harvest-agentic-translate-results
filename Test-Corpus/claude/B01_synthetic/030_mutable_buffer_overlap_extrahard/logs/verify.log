e extern \"C\" fn main() -> c_int {","+    extern \"C\" {","+        fn scanf(fmt: *const std::os::raw::c_char, ...) -> c_int;","+    }","+    let mut data: [c_int; 100] = [0; 100];","+    let fmt = b\"%d\\0\".as_ptr() as *const std::os::raw::c_char;","+    let mut i: usize = 0;","+    while i < 100 {","+        if scanf(fmt, &mut data[i] as *mut c_int) != 1 {","+            break;","+        }","+        i += 1;","+    }","+    driver(data.as_mut_ptr(), i as c_int);","+    0","+}","+"]}],"userModified":false,"replaceAll":false}}
