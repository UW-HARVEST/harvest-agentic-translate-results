anf(fmt, &mut data[i] as *mut c_int) != 1 {\n            break;\n        }\n        i += 1;\n    }\n    driver(data.as_mut_ptr(), i as c_int);\n    0\n}\n\n","structuredPatch":[{"oldStart":88,"oldLines":3,"newStart":88,"newLines":14,"lines":["     0"," }"," ","+// The C .so produced by `gcc -shared` exports `_init` and `_fini` —","+// linker-generated dynamic-loader init/finalize stubs. Cargo's default","+// `cdylib` build does not emit these. Provide explicit no-op exports so the","+// Rust .so's exported-symbol set matches the C .so's exactly.","+#[no_mangle]","+pub unsafe extern \"C\" fn _init() {}","+","+#[no_mangle]","+pub unsafe extern \"C\" fn _fini() {}","+","+"]}],"userModified":false,"replaceAll":false}}
