    assert_same_over_values(\"C5 printHexCharLine boundaries\", &vals, 1, |api, v| {\n        api.print_hex_char_line(v)\n    });\"\"\"\nassert old in s; s = s.replace(old, new)\n\n# C6, C8, C10 : driver over a char range\nfor row, lo, hi in [(\"C6\",\"0x00\",\"0x0e\"), (\"C8\",\"0x10\",\"0x7e\"), (\"C10\",\"0x80\",\"0xfe\")]:\n    old = f\"\"\"    for v in chars_in({lo}, {hi}) {{\n        assert_same(&format!(\"{row} driver({{v:#04x}})\"), |api| api.driver(v));\n    }}\"\"\"\n    new = f\"\"\"    let vals: Vec<c_char> = chars_in({lo}, {hi}).collect();\n    assert_same_over_values(\"{row} driver\", &vals, 1, |api, v| api.driver(v));\"\"\"\n    assert old in s, row\n    s = s.replace(old, new)\n\n# C12\nold = \"\"\"    for v in all_chars() {\n        assert_same(&format!(\"C12 driver({v})\"), |api| api.driver(v));\n    }\"\"\"\nnew = \"\"\"    let vals: Vec<c_char> = all_chars().collect();\n    assert_same_over_values(\"C12 driver exhaustive\", &vals, 1, |api, v| api.driver(v));\"\"\"\nassert old in s; s = s.replace(old, new)\n\n# C13\nold = \"\"\"    let mut rng = Rng::new(SEED);\n    for i in 0..4096u32 {\n        let v = rng.next_i8();\n        assert_same(&format!(\"C13 #{i} v={v}\"), |api| {\n            api.print_hex_char_line(v);\n            api.driver(v);\n        });\n    }\"\"\"\nnew = \"\"\"    let mut rng = Rng::new(SEED);\n    let vals: Vec<c_char> = (0..4096).map(|_| rng.next_i8()).collect();\n    // 2 output lines per input: the primitive's, then the wrapper's.\n    assert_same_over_values(\"C13 both entry points\", &vals, 2, |api, v| {\n        api.print_hex_char_line(v);\n        api.driver(v);\n    });\"\"\"\nassert old in s; s = s.replace(old, new)\n\n# C14 / C15\nold = \"\"\"    for v in dirty_int_inputs() {\n        assert_same(&format!(\"C14 printHexCharLine(int {v:#010x})\"), |api| {\n            api.print_hex_char_line_int(v)\n        });\n    }\"\"\"\nnew = \"\"\"    let vals = dirty_int_inputs();\n    assert_same_over_values(\"C14 printHexCharLine(int)\", &vals, 1, |api, v| {\n        api.print_hex_char_line_int(v)\n    });\"\"\"\nassert old in s; s = s.replace(old, new)\n\nold = \"\"\"    for v in dirty_int_inputs() {\n        assert_same(&format!(\"C15 driver(int {v:#010x})\"), |api| {\n            api.driver_int(v)\n        });\n    }\"\"\"\nnew = \"\"\"    let vals = dirty_int_inputs();\n    assert_same_over_values(\"C15 driver(int)\", &vals, 1, |api, v| api.driver_int(v));\"\"\"\nassert old in s; s = s.replace(old, new)\n\n# C24\nold = \"\"\"    for v in all_chars() {\n        assert_same_rust_first(&format!(\"C24 rust-first printHexCharLine({v})\"), |api| {\n            api.print_hex_char_line(v)\n        });\n        assert_same_rust_first(&format!(\"C24 rust-first driver({v})\"), |api| api.driver(v));\n        assert_same(&format!(\"C24 c-first driver({v})\"), |api| api.driver(v));\n    }\"\"\"\nnew = \"\"\"    let vals: Vec<c_char> = all_chars().collect();\n\n    // Rust invoked first, then C.\n    assert_same_rust_first(\"C24 rust-first, exhaustive\", |api| {\n        for &v in &vals {\n            api.print_hex_char_line(v);\n            api.driver(v);\n        }\n    });\n\n    // C invoked first, then Rust.\n    assert_same_over_values(\"C24 c-first, exhaustive\", &vals, 2, |api, v| {\n        api.print_hex_char_line(v);\n        api.driver(v);\n    });\"\"\"\nassert old in s; s = s.replace(old, new)\n\nopen(p,'w').write(s)\nprint(\"differential_valid.rs batched\")\nPY","description":"Convert valid-path tests to batched captures"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1650,"cache_read_input_tokens":158994,"cache_creation":{"ephemeral_5m_input_tokens":1650,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e645b772-5cf8-440b-be14-849c60bcd768","uuid":"dcff13c3-e548-4be6-9c77-e620ae2a9be5","timestamp":"2026-08-18T01:08:22