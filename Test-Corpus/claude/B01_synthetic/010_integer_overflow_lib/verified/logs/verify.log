`c\n    40\t/// printf(\"%02x\\n\", charHex);\n    41\t/// ```\n    42\t///\n    43\t/// `charHex` undergoes the default integer promotions to `int` before being\n    44\t/// passed to `printf`. On this target `char` is signed, so negative values are\n    45\t/// sign-extended and then printed by `%x` as an `unsigned int` (e.g. `-1`\n    46\t/// prints as `ffffffff`). The C `printf` is used directly so that both the\n    47\t/// formatted bytes and the stdio buffering behaviour match the C library\n    48\t/// exactly.\n    49\t#[unsafe(no_mangle)]\n    50\t#[allow(non_snake_case)]\n    51\tpub unsafe extern \"C\" fn printHexCharLine(charHex: c_char) {\n    52\t    // Default argument promotion: char -> int (sign-extending on this target).\n    53\t    let promoted: c_int = charHex as c_int;\n    54\t    unsafe {\n    55\t        c_printf(c\"%02x\\n\".as_ptr(), promoted);\n    56\t    }\n    57\t}\n    58\t\n    59\t/// `void driver(char data)`\n    60\t///\n    61\t/// C body:\n    62\t/// ```c\n    63\t/// char result = data + 1;\n    64\t/// printHexCharLine(result);\n    65\t/// ```\n    66\t///\n    67\t/// `data + 1` is computed in `int` and then converted back to `char`, which\n    68\t/// wraps modulo 256 (implementation-defined conversion as performed by gcc),\n    69\t/// e.g. `127 + 1 == -128`.\n    70\t#[unsafe(no_mangle)]\n    71\tpub unsafe extern \"C\" fn driver(data: c_char) {\n    72\t    let result: c_char = data.wrapping_add(1);\n    73\t    unsafe {\n    74\t        printHexCharLine(result);\n    75\t    }\n    76\t}\n=== translation.json ===\n{\n  \"agent\": \"claude\",\n  \"cache_key\": \"cab6c332bcd4649e7a90a2fc42299ea0c489fd1bfaaeec37926deaa380da8c06\",\n  \"duration_secs\": 96,\n  \"exit_code\": 0,\n  \"harness\": \"599e223\",\n  \"replayed\": false,\n  \"sandboxed\": true,\n  \"success\": true,\n  \"timed_out\": false,\n  \"timestamp\": \"2026-08-17T20:15:31.852930728+00:00\"\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"e