print $NF}' | sed 's/@.*//' | grep -qx \"$s\"; then\n    NONLIBC=\"$NONLIBC $s\"\n  fi\ndone\necho \"${NONLIBC:-<none>}\"\n\nif [ -n \"$MISSING\" ]; then\n  echo \"SYMBOL PARITY: FAIL (missing exports)\"\n  exit 1\nfi\nif [ -n \"$NONLIBC\" ]; then\n  echo \"SYMBOL PARITY: FAIL (unresolved non-libc imports:$NONLIBC)\"\n  exit 1\nfi\necho \"SYMBOL PARITY: PASS (0 missing exports, 0 non-libc undefined)\"\n","structuredPatch":[{"oldStart":27,"oldLines":20,"newStart":27,"newLines":20,"lines":[" MISSING=$(comm -23 \"${TMPDIR:-/tmp}/c_exports.txt\" \"${TMPDIR:-/tmp}/r_exports.txt\")"," echo \"${MISSING:-<none>}\""," ","-# Undefined symbols in the Rust .so that are NOT libc / runtime.","+# Undefined symbols in the Rust .so that do NOT resolve against the system","+# libraries (libc / libm / libgcc_s / ld.so). `ldd -r` performs the authoritative","+# relocation check and prints \"undefined symbol: ...\" for anything unresolved."," echo \"=== Rust .so undefined non-libc/non-runtime symbols (must be empty) ===\"","-UNDEF=$(nm -D --undefined-only \"$R_SO\" | awk '{print $NF}' | sed 's/@.*//' | sort -u \\","-  | grep -Ev \"$GLUE\" | grep -Ev '^(_Unwind_|__libc|__cxa|__tls_get_addr|__errno_location|gettid)')","-# Everything remaining must resolve in libc/libm/libpthread/libdl/libgcc_s.","-NONLIBC=\"\"","-for s in $UNDEF; do","-  if ! nm -D /lib64/libc.so.6 /lib64/libm.so.6 /lib64/libgcc_s.so.1 2>/dev/null \\","-      | awk '{print $NF}' | sed 's/@.*//' | grep -qx \"$s\"; then","-    NONLIBC=\"$NONLIBC $s\"","-  fi","-done","+NONLIBC=$(ldd -r \"$R_SO\" 2>&1 | grep -E 'undefined symbol|not found' || true)"," echo \"${NONLIBC:-<none>}\""," ","+echo \"=== (reference) C .so undefined symbols that do not resolve ===\"","+ldd -r \"$C_SO\" 2>&1 | grep -E 'undefined symbol|not found' || echo \"<none>\"","+","+echo \"=== (reference) full undefined-import list of the Rust .so ===\"","+nm -D --undefined-only \"$R_SO\" | awk '{print $NF}' | sed 's/@.*//' | sort -u | tr '\\n' ' '","+echo","+"," if [ -n \"$MISSING\" ]; then","   echo \"SYMBOL PARITY: FAIL (missing exports)\"","   exit 1"]}],"userModified":false,"replaceAll":false}}
