() {\n    let data: i8 = 2;\n    if data > 0 {\n        let result: i8 = ((data as c_int) * 2) as i8;\n        print_hex_char_line(result);\n    }\n}\n\nfn good_b2g() {\n    let mut data: i8;\n    data = b' ' as i8;\n    let _ = data; // silence unused warnings; matches C dead-store pattern\n    data = CHAR_MAX;\n    if data > 0 {\n        if data < (CHAR_MAX / 2) {\n            let result: i8 = ((data as c_int) * 2) as i8;\n            print_hex_char_line(result);\n        } else {\n            print_line(Some(\"data value is too large to perform arithmetic safely.\"));\n        }\n    }\n}\n\nfn good() {\n    good_g2b();\n    good_b2g();\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn driver(use_good: c_int) {\n    if use_good != 0 {\n        good();\n    } else {\n        bad();\n    }\n}\n","numLines":74,"startLine":1,"totalLines":74}}}
