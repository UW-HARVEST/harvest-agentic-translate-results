rs (e.g. aarch64), exactly like the C `char` type, so\n39\t/// deriving the constant from `c_char` reproduces the platform behaviour.\n40\tconst CHAR_MAX: c_char = c_char::MAX;\n41\t\n42\t/// `void printLine(const char * line)`\n43\t#[unsafe(no_mangle)]\n44\tpub unsafe extern \"C\" fn printLine(line: *const c_char) {\n45\t    if !line.is_null() {\n46\t        printf(b\"%s\\n\\0\".as_ptr() as *const c_char, line);\n47\t    }\n48\t}\n49\t\n50\t/// `void printHexCharLine(char charHex)`\n51\t///\n52\t/// The `char` argument undergoes the default integer promotion to `int` before\n53\t/// being consumed by `%02x`, so negative values (on targets with a signed\n54\t/// `char`) are sign-extended and print as eight hex digits.\n55\t#[unsafe(no_mangle)]\n56\tpub unsafe extern \"C\" fn printHexCharLine(charHex: c_char) {\n57\t    printf(b\"%02x\\n\\0\".as_ptr() as *const c_char, charHex as c_int);\n58\t}\n59\t\n60\t/// `void bad()`\n61\t#[unsafe(no_mangle)]\n62\tpub unsafe extern \"C\" fn bad() {\n63\t    let data: c_char;\n64\t    data = CHAR_MAX;\n65\t    if data > 0 {\n66\t        // char result = data * 2;  -- promotion to int, then truncation back\n67\t        // to char, which overflows for CHAR_MAX.\n68\t        let result: c_char = ((data as c_int) * 2) as c_char;\n69\t        printHexCharLine(result);\n70\t    }\n71\t}\n72\t\n73\t/// `static void goodG2B()`\n74\tunsafe fn goodG2B() {\n75\t    let data: c_char;\n76\t    data = 2;\n77\t    if data > 0 {\n78\t        let result: c_char = ((data as c_int) * 2) as c_char;\n79\t        printHexCharLine(result);\n80\t    }\n81\t}\n82\t\n83\t/// `static void goodB2G()`\n84\tunsafe fn goodB2G() {\n85\t    let mut data: c_char;\n86\t    data = b' ' as c_char;\n87\t    data = CHAR_MAX;\n88\t    if data > 0 {\n89\t        if data < (CHAR_MAX / 2) {\n90\t            let result: c_char = ((data as c_int) * 2) as c_char;\n91\t            printHexCharLine(result);\n92\t        } else {\n93\t            printLine(\n94\t               