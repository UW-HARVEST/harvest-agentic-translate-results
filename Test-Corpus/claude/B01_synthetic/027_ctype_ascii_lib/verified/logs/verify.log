{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Dqd4W2QaSTuw2bBrGY36XR","type":"tool_result","content":"620\t            _ => s.push_str(&format!(\"\\\\x{b:02x}\")),\n621\t        }\n622\t    }\n623\t    s\n624\t}\n625\t\n626\t/// Compares two captures line by line (Axis 1: one line per ctype interface).\n627\t///\n628\t/// `Err` describes the first differing line, naming the interface it came from.\n629\tpub fn compare_lines(c: &[u8], rust: &[u8]) -> Result<(), String> {\n630\t    if c == rust {\n631\t        return Ok(());\n632\t    }\n633\t    let cl: Vec<&[u8]> = c.split(|&b| b == b'\\n').collect();\n634\t    let rl: Vec<&[u8]> = rust.split(|&b| b == b'\\n').collect();\n635\t    if cl.len() != rl.len() {\n636\t        return Err(format!(\n637\t            \"line count differs: C has {} lines, Rust has {}\\n  C   : {}\\n  Rust: {}\",\n638\t            cl.len(),\n639\t            rl.len(),\n640\t            escape(c),\n641\t            escape(rust)\n642\t        ));\n643\t    }\n644\t    for (i, (a, b)) in cl.iter().zip(rl.iter()).enumerate() {\n645\t        if a != b {\n646\t            let label = LABELS.get(i % 14).copied().unwrap_or(\"<unknown>\");\n647\t            return Err(format!(\n648\t                \"line {i} (interface `{label}`) differs:\\n  C   : {}\\n  Rust: {}\",\n649\t                escape(a),\n650\t                escape(b)\n651\t            ));\n652\t        }\n653\t    }\n654\t    Err(\"captures differ but no line differs (impossible)\".to_string())\n655\t}\n656\t\n657\t/// Runs one differential case.\n658\t///\n659\t/// `setup` is applied identically before each implementation runs, then the\n660\t/// body drives the loaded `driver` symbol, and the captured bytes must match.\n661\t/// `expect_lines`, when given, additionally asserts the capture really has that\n662\t/// many `\\n`-terminated lines — a guard against a broken capture silently\n663\t/// comparing two empty buffers.\n664\t/// Returns the C implementation's captured bytes, so a caller can additionally\n665\t/// compare them against a baseline.\n666\tpub fn diff_case(\n667\t    row: &str,\n668\t    detail: &str,\n669\t    opts: Opts,\n670\t    expect_lines: Option<usize>,\n671\t    setup: &dyn Fn(),\n672\t    body: &dyn Fn(DriverChar),\n673\t) -> Vec<u8> {\n674\t    let b = both();\n675\t\n676\t    setup();\n677\t    let out_c = capture_with(opts, || body(b.c.driver));\n678\t    let post_c = PostState::snapshot();\n679\t\n680\t    setup();\n681\t    let out_rust = capture_with(opts, || body(b.rust.driver));\n682\t    let post_rust = PostState::snapshot();\n683\t\n684\t    if let Some(n) = expect_lines {\n685\t        let count = out_c.iter().filter(|&&x| x == b'\\n').count();\n686\t        assert_eq!(\n687\t            count, n,\n688\t            \"[{row}] {detail}: capture harness produced {count} lines from the C \\\n689\t             implementation, expected {n} — the capture itself is broken, so the \\\n690\t             comparison would be vacuous.\\n  C: {}\",\n691\t            escape(&out_c)\n692\t        );\n693\t    }\n694\t\n695\t    if let Err(why) = compare_lines(&out_c, &out_rust) {\n696\t        panic!(\n697\t            \"[{row}] {detail}\\n  opts: {opts:?}\\n{why}\\n  full C   : {}\\n  full Rust: {}\",\n698\t            escape(&out_c),\n699\t            escape(&out_rust)\n700\t        );\n701\t    }\n702\t\n703\t    assert_eq!(\n704\t        post_c, post_rust,\n705\t        \"[{row}] {detail}: observable locale state after the call differs between C and Rust\"\n706\t    );\n707\t\n708\t    out_c\n709\t}"}]},"parent_tool_use_id":null,"session_id":"15fde728-09ee-4ebc-b666-8df5f5cd4de9","uuid":"a5891be7-ad82-40f3-84f0-776227965824","timestamp":"2026-08-18T06:21:38.313Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-DwtwtH/translated_rust/tests/common/mod.rs","content":"            _ => s.push_str(&format!(\"\\\\x{b:02x}\")),\n        }\n    }\n    s\n}\n\n/// Compares two captures line by line (Axis 1: one line per ctype interface).\n///\n/// `Err` describes the first differing line, naming the interface it came from.\npub fn compare_lines(c: &[u8], rust: &[u8]) -> Result<(), String> {\n    if c == rust {\n        return Ok(());\n    }\n    let cl: Vec<&[u8]> = c.split(|&b| b == b'\\n').collect();\n    let rl: Vec<&[u8]> = rust.split(|&b| b == b'\\n').collect();\n    if cl.len() != rl.len() {\n        return Err(format!(\n            \"line count differs: C has {} lines, Rust has {}\\n  C   : {}\\n  Rust: {}\",\n            cl.len(),\n            rl.len(),\n            escape(c),\n            escape(rust)\n        ));\n    }\n    for (i, (a, b)) in cl.iter().zip(rl.iter()).enumerate() {\n        if a != b {\n            let label = LABELS.get(i % 14).copied().unwrap_or(\"<unknown>\");\n            return Err(format!(\n                \"line {i} (interface `{label}`) differs:\\n  C   : {}\\n  Rust: {}\",\n                escape(a),\n                escape(b)\n            ));\n        }\n    }\n    Err(\"captures differ but no line differs (impossible)\".to_string())\n}\n\n/// Runs one differential case.\n///\n/// `setup` is applied identically before each implementation runs, then the\n/// body drives the loaded `driver` symbol, and the captured bytes must match.\n/// `expect_lines`, when given, additionally asserts the capture really has that\n/// many `\\n`-terminated lines — a guard against a broken capture silently\n/// comparing two empty buffers.\n/// Returns the C implementation's captured bytes, so a caller can additionally\n/// compare them against a baseline.\npub fn diff_case(\n    row: &str,\n    detail: &str,\n    opts: Opts,\n    expect_lines: Option<usize>,\n    setup: &dyn Fn(),\n    body: &dyn Fn(DriverChar),\n) -> Vec<u8> {\n    let b = both();\n\n    setup();\n    let out_c = capture_with(opts, || body(b.c.driver));\n    let post_c = PostState::snapshot();\n\n    setup();\n    let out_rust = capture_with(opts, || body(b.rust.driver));\n    let post_rust = PostState::snapshot();\n\n    if let Some(n) = expect_lines {\n        let count = out_c.iter().filter(|&&x| x == b'\\n').count();\n        assert_eq!(\n            count, n,\n            \"[{row}] {detail}: capture harness produced {count} lines from the C \\\n             implementation, expected {n} — the capture itself is broken, so the \\\n             comparison would be vacuous.\\n  C: {}\",\n            escape(&out_c)\n        );\n    }\n\n    if let Err(why) = compare_lines(&out_c, &out_rust) {\n        panic!(\n            \"[{row}] {detail}\\n  opts: {opts:?}\\n{why}\\n  full C   : {}\\n  full Rust: {}\",\n            escape(&out_c),\n            escape(&out_rust)\n        );\n    }\n\n    assert_eq!(\n        post_c, post_rust,\n        \"[{row}] {detail}: observable locale state after the call differs between C and Rust\"\n    );\n\n    out_c\n}","numLines":90,"startLine":620,"totalLines":750}}}
