{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Km1smNoNmSPdbet4pxuERz","type":"tool_result","content":"1\t// Copyright 2025 MIT Lincoln Laboratory\n2\t// Permission is hereby granted, free of charge,\n3\t// to any person obtaining a copy of this software\n4\t// and associated documentation files (the \"Software\"),\n5\t// to deal in the Software without restriction,\n6\t// including without limitation the rights to use, copy,\n7\t// modify, merge, publish, distribute, sublicense,\n8\t// and/or sell copies of the Software,\n9\t// and to permit persons to whom the Software is furnished to do so,\n10\t// subject to the following conditions:\n11\t//\n12\t// The above copyright notice and this permission notice\n13\t// shall be included in all copies or substantial portions of the Software.\n14\t//\n15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n17\t// THE WARRANTIES OF MERCHANTABILITY,\n18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n23\t\n24\t//! Minimal, hand-written bindings to the libc entry points that the original\n25\t//! C translation unit referenced.\n26\t//!\n27\t//! `driver.c` includes `<ctype.h>`, `<locale.h>` and `<stdio.h>` and uses\n28\t//! `printf`, `setlocale` and the `<ctype.h>` classification/conversion\n29\t//! interfaces.  Under glibc the `<ctype.h>` interfaces expand to macros that\n30\t//! index the per-locale lookup tables returned by `__ctype_b_loc`,\n31\t//! `__ctype_tolower_loc` and `__ctype_toupper_loc`; that is exactly what the\n32\t//! reference shared object references in its dynamic symbol table:\n33\t//!\n34\t//! ```text\n35\t//! U __ctype_b_loc@GLIBC_2.3\n36\t//! U __ctype_tolower_loc@GLIBC_2.3\n37\t//! U __ctype_toupper_loc@GLIBC_2.3\n38\t//! U printf@GLIBC_2.2.5\n39\t//! U setlocale@GLIBC_2.2.5\n40\t//! ```\n41\t//!\n42\t//! Binding to the very same tables (rather than reimplementing the ASCII\n43\t//! classification logic in Rust) is what guarantees byte-identical output: the\n44\t//! glibc macros return the *raw masked table bits* (e.g. `1024` for\n45\t//! `isalpha`), not a normalised `0`/`1`, and the tables also cover the\n46\t//! negative indices produced by sign-extending a negative `char`.\n47\t\n48\tuse core::ffi::{c_char, c_int};\n49\t\n50\t/// `locale.h`: category argument for `setlocale`. glibc defines `LC_ALL` as 6.\n51\tpub const LC_ALL: c_int = 6;\n52\t\n53\tunsafe extern \"C\" {\n54\t    /// `int printf(const char *restrict format, ...)`\n55\t    ///\n56\t    /// Reusing libc's `printf` (instead of Rust's `std::io::stdout`) keeps the\n57\t    /// formatting, the stdout `FILE` object and its buffering behaviour bit\n58\t    /// for bit identical to the C library, including how the output\n59\t    /// interleaves with any `printf` performed by the calling program.\n60\t    pub fn printf(format: *const c_char, ...) -> c_int;\n61\t\n62\t    /// `char *setlocale(int category, const char *locale)`\n63\t    pub fn setlocale(category: c_int, locale: *const c_char) -> *mut c_char;\n64\t\n65\t    /// glibc: pointer to the current locale's character-class table.\n66\t    ///\n67\t    /// The returned table is valid for the index range `-128 ..= 255`, which is\n68\t    /// why sign-extended negative `char` values are legal lookups.\n69\t    pub fn __ctype_b_loc() -> *mut *const u16;\n70\t\n71\t    /// glibc: pointer to the current locale's `tolower` conversion table.\n72\t    pub fn __ctype_tolower_loc() -> *mut *const i32;\n73\t\n74\t    /// glibc: pointer to the current locale's `toupper` conversion table.\n75\t    pub fn __ctype_toupper_loc() -> *mut *const i32;\n76\t}\n77\t"}