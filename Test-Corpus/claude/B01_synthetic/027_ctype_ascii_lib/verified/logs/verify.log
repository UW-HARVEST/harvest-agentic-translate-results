{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AippdL1PYhU5SWWuEzr9j2","type":"tool_result","content":"91\t// ---------------------------------------------------------------------------\n92\t// E3 / E4 — printf failures are ignored identically\n93\t// ---------------------------------------------------------------------------\n94\t\n95\t/// Runs `driver` with `stdout` wired to a failing sink and compares everything\n96\t/// observable: the bytes (if any), `errno`, `ferror(stdout)`, and the fact that\n97\t/// the library is still usable afterwards.\n98\tfn failing_sink_row(row: &str, sink: Sink, buffering: Buffering, expect_errno: Option<c_int>) {\n99\t    let b = both();\n100\t    let opts = Opts { sink, buffering };\n101\t\n102\t    for c in [b'a' as c_char, b'A' as c_char, b'0' as c_char, 0, -1, -128, 127, b'\\n' as c_char] {\n103\t        reset_locale();\n104\t        let got_c = capture_with_state(opts, || unsafe { (b.c.driver)(c) });\n105\t        reset_locale();\n106\t        let got_rust = capture_with_state(opts, || unsafe { (b.rust.driver)(c) });\n107\t\n108\t        assert_eq!(\n109\t            escape(&got_c.bytes),\n110\t            escape(&got_rust.bytes),\n111\t            \"[{row}] sink {sink:?}/{buffering:?}, char {}: output differs\",\n112\t            show(c)\n113\t        );\n114\t        assert_eq!(\n115\t            got_c.errno, got_rust.errno,\n116\t            \"[{row}] sink {sink:?}/{buffering:?}, char {}: errno differs \\\n117\t             (C={} / Rust={}) — the two libraries do not fail identically\",\n118\t            show(c),\n119\t            got_c.errno,\n120\t            got_rust.errno\n121\t        );\n122\t        assert_eq!(\n123\t            got_c.ferror != 0,\n124\t            got_rust.ferror != 0,\n125\t            \"[{row}] sink {sink:?}/{buffering:?}, char {}: ferror(stdout) differs \\\n126\t             (C={} / Rust={})\",\n127\t            show(c),\n128\t            got_c.ferror,\n129\t            got_rust.ferror\n130\t        );\n131\t        if let Some(e) = expect_errno {\n132\t            assert_eq!(\n133\t                got_c.errno, e,\n134\t                \"[{row}] sink {sink:?}/{buffering:?}, char {}: expected the C library to \\\n135\t                 fail with errno {e}, got {} ({})\",\n136\t                show(c),\n137\t                got_c.errno,\n138\t                errno_name(got_c.errno)\n139\t            );\n140\t            assert_ne!(got_c.ferror, 0, \"[{row}] expected stdout to be in an error state\");\n141\t        }\n142\t    }\n143\t\n144\t    // Both libraries must still work after the failure: no aborted process, no\n145\t    // poisoned state.  (A `panic = \"abort\"` in Rust would have killed the test\n146\t    // process outright, so reaching here at all is part of the assertion.)\n147\t    diff_case(\n148\t        row,\n149\t        &format!(\"still usable after {sink:?}/{buffering:?} failures\"),\n150\t        Opts::file(),\n151\t        Some(1),\n152\t        &reset_locale,\n153\t        &|d| unsafe { d(b'q' as c_char) },\n154\t    );\n155\t}\n156\t\n157\tfn errno_name(e: c_int) -> &'static str {\n158\t    match e {\n159\t        libc::EBADF => \"EBADF\",\n160\t        libc::ENOSPC => \"ENOSPC\",\n161\t        libc::EPIPE => \"EPIPE\",\n162\t        0 => \"0\",\n163\t        _ => \"other\",\n164\t    }\n165\t}\n166\t\n167\t#[test]\n168\tfn e3_printf_failure_with_stdout_closed_unbuffered() {\n169\t    let _serial = state_lock();\n170\t    failing_sink_row(\"E3\", Sink::Closed, Buffering::None, Some(libc::EBADF));\n171\t}\n172\t\n173\t#[test]\n174\tfn e3b_printf_failure_with_stdout_closed_buffered() {\n175\t    let _serial = state_lock();\n176\t    failing_sink_row(\"E3b\", Sink::Closed, Buffering::Full, None);\n177\t}\n178\t\n179\t#[test]\n180\tfn e4_printf_failure_on_a_read_only_fd() {\n181\t    let _serial = state_lock();\n182\t    failing_sink_row(\"E4\", Sink::ReadOnly, Buffering::None, Some(libc::EBADF));\n183\t}\n184\t\n185\t#[test]\n186\tfn e4b_printf_failure_on_dev_full() {\n187\t    let _serial = state_lock();\n188\t    failing_sink_row(\"E4b\", Sink::DevFull, Buffering::None, Some(libc::ENOSPC));\n189\t}\n190\t\n191\t#[test]\n192\tfn e4c_printf_failure_on_dev_full_buffered() {\n193\t    let _serial = state_lock();\n194\t    failing_sink_row(\"E4c\", Sink::DevFull, Buffering::Full, None);\n195\t}\n196\t"}]},"parent_tool_use_id":null,"session_id":"15fde728-09ee-4ebc-b666-8df5f5cd4de9","uuid":"2f0176ce-b8cb-4d8e-97c5-b20c5c479e5b","timestamp":"2026-08-18T06:32:07.331Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-DwtwtH/translated_rust/tests/phase_c_errors.rs","content":"// ---------------------------------------------------------------------------\n// E3 / E4 — printf failures are ignored identically\n// ---------------------------------------------------------------------------\n\n/// Runs `driver` with `stdout` wired to a failing sink and compares everything\n/// observable: the bytes (if any), `errno`, `ferror(stdout)`, and the fact that\n/// the library is still usable afterwards.\nfn failing_sink_row(row: &str, sink: Sink, buffering: Buffering, expect_errno: Option<c_int>) {\n    let b = both();\n    let opts = Opts { sink, buffering };\n\n    for c in [b'a' as c_char, b'A' as c_char, b'0' as c_char, 0, -1, -128, 127, b'\\n' as c_char] {\n        reset_locale();\n        let got_c = capture_with_state(opts, || unsafe { (b.c.driver)(c) });\n        reset_locale();\n        let got_rust = capture_with_state(opts, || unsafe { (b.rust.driver)(c) });\n\n        assert_eq!(\n            escape(&got_c.bytes),\n            escape(&got_rust.bytes),\n            \"[{row}] sink {sink:?}/{buffering:?}, char {}: output differs\",\n            show(c)\n        );\n        assert_eq!(\n            got_c.errno, got_rust.errno,\n            \"[{row}] sink {sink:?}/{buffering:?}, char {}: errno differs \\\n             (C={} / Rust={}) — the two libraries do not fail identically\",\n            show(c),\n            got_c.errno,\n            got_rust.errno\n        );\n        assert_eq!(\n            got_c.ferror != 0,\n            got_rust.ferror != 0,\n            \"[{row}] sink {sink:?}/{buffering:?}, char {}: ferror(stdout) differs \\\n             (C={} / Rust={})\",\n            show(c),\n            got_c.ferror,\n            got_rust.ferror\n        );\n        if let Some(e) = expect_errno {\n            assert_eq!(\n                got_c.errno, e,\n                \"[{row}] sink {sink:?}/{buffering:?}, char {}: expected the C library to \\\n                 fail with errno {e}, got {} ({})\",\n                show(c),\n                got_c.errno,\n                errno_name(got_c.errno)\n            );\n            assert_ne!(got_c.ferror, 0, \"[{row}] expected stdout to be in an error state\");\n        }\n    }\n\n    // Both libraries must still work after the failure: no aborted process, no\n    // poisoned state.  (A `panic = \"abort\"` in Rust would have killed the test\n    // process outright, so reaching here at all is part of the assertion.)\n    diff_case(\n        row,\n        &format!(\"still usable after {sink:?}/{buffering:?} failures\"),\n        Opts::file(),\n        Some(1),\n        &reset_locale,\n        &|d| unsafe { d(b'q' as c_char) },\n    );\n}\n\nfn errno_name(e: c_int) -> &'static str {\n    match e {\n        libc::EBADF => \"EBADF\",\n        libc::ENOSPC => \"ENOSPC\",\n        libc::EPIPE => \"EPIPE\",\n        0 => \"0\",\n        _ => \"other\",\n    }\n}\n\n#[test]\nfn e3_printf_failure_with_stdout_closed_unbuffered() {\n    let _serial = state_lock();\n    failing_sink_row(\"E3\", Sink::Closed, Buffering::None, Some(libc::EBADF));\n}\n\n#[test]\nfn e3b_printf_failure_with_stdout_closed_buffered() {\n    let _serial = state_lock();\n    failing_sink_row(\"E3b\", Sink::Closed, Buffering::Full, None);\n}\n\n#[test]\nfn e4_printf_failure_on_a_read_only_fd() {\n    let _serial = state_lock();\n    failing_sink_row(\"E4\", Sink::ReadOnly, Buffering::None, Some(libc::EBADF));\n}\n\n#[test]\nfn e4b_printf_failure_on_dev_full() {\n    let _serial = state_lock();\n    failing_sink_row(\"E4b\", Sink::DevFull, Buffering::None, Some(libc::ENOSPC));\n}\n\n#[test]\nfn e4c_printf_failure_on_dev_full_buffered() {\n    let _serial = state_lock();\n    failing_sink_row(\"E4c\", Sink::DevFull, Buffering::Full, None);\n}\n","numLines":106,"startLine":91,"totalLines":451}}}
