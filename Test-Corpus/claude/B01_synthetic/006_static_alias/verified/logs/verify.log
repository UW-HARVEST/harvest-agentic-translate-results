 = false\nbench = false\ndoctest = false\n\n[dev-dependencies]\nlibloading = \"0.8\"\n\n[profile.release]\npanic = \"abort\"\n\n[workspace]\n","structuredPatch":[{"oldStart":10,"oldLines":7,"newStart":10,"newLines":9,"lines":[" [lib]"," name = \"driver\""," path = \"src/lib.rs\"","-crate-type = [\"cdylib\", \"rlib\"]","+# rlib only: the C ABI shared object is the `capi` target below (a lib cdylib","+# would additionally collide with itself under `panic = \"abort\"`).","+crate-type = [\"rlib\"]"," "," [[bin]]"," name = \"driver\""]}],"userModified":false,"replaceAll":false}}
