e]\n","structuredPatch":[{"oldStart":24,"oldLines":6,"newStart":24,"newLines":11,"lines":[" name = \"capi\""," path = \"examples/capi.rs\""," crate-type = [\"cdylib\"]","+# Never build this target as a test/bench harness: it exports `main` itself, so a","+# generated libtest entry point would collide with it.","+test = false","+bench = false","+doctest = false"," "," [dev-dependencies]"," libloading = \"0.8\""]}],"userModified":false,"replaceAll":false}}
