     0..=4 => {\n                    // mix of wild and near-boundary values\n                    let v = match rng.below(6) {\n                        0 => i32::MIN,\n                        1 => i32::MAX,\n                        2 => 0,\n                        3 => rng.range_i32(-5, 5),\n                        4 => rng.range_i32(i32::MIN, i32::MIN + 32),\n                        _ => rng.next_i32(),\n                    };\n                    ops.push(Op::Fresh(v));\n                }\n                5..=8 => ops.push(Op::Chain),\n                _ => ops.push(Op::Probe),\n            }\n        }\n        assert_same(&format!(\"rand{seed}\"), &ops);\n    }\n}\n\n// ------------------------------------------------------------------ CONFIGS #9\n\n#[test]\nfn alias_caller_storage_shapes() {\n    // (a) heap cell\n    let p = load_pair(\"storage_heap\");\n    let mut cb: Box<i32> = Box::new(-3);","numLines":60,"startLine":255,"totalLines":387}}}
