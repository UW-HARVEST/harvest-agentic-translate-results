{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FLshUzQDsbJhFN5hjsSw8x","type":"tool_result","content":"108\t}\n109\t\n110\t// ---------------------------------------------------------------------------\n111\t// stdout capture\n112\t// ---------------------------------------------------------------------------\n113\t\n114\tstatic CAPTURE_LOCK: Mutex<()> = Mutex::new(());\n115\tstatic COUNTER: AtomicU64 = AtomicU64::new(0);\n116\t\n117\tfn tmp_path(tag: &str) -> PathBuf {\n118\t    std::env::temp_dir().join(format!(\n119\t        \"driver_diff_{}_{}_{}.bin\",\n120\t        std::process::id(),\n121\t        COUNTER.fetch_add(1, Ordering::Relaxed),\n122\t        tag\n123\t    ))\n124\t}\n125\t\n126\t/// Run `f` with fd 1 redirected into a temporary file and return everything it\n127\t/// wrote (after flushing the C `stdout` `FILE`).\n128\tpub fn capture(f: impl FnOnce()) -> Vec<u8> {\n129\t    let guard = CAPTURE_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n130\t\n131\t    let path = tmp_path(\"cap\");\n132\t    let file = File::create(&path).expect(\"create capture file\");\n133\t\n134\t    let _ = std::io::stdout().flush();\n135\t    unsafe { fflush(std::ptr::null_mut()) };\n136\t\n137\t    let saved = unsafe { dup(1) };\n138\t    assert!(saved >= 0, \"dup(1) failed\");\n139\t    assert!(unsafe { dup2(file.as_raw_fd(), 1) } >= 0, \"dup2 failed\");\n140\t    drop(file);\n141\t\n142\t    let res = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f));\n143\t\n144\t    unsafe { fflush(std::ptr::null_mut()) };\n145\t    assert!(unsafe { dup2(saved, 1) } >= 0, \"dup2 restore failed\");\n146\t    unsafe { close(saved) };\n147\t    drop(guard);\n148\t\n149\t    if let Err(p) = res {\n150\t        std::panic::resume_unwind(p);\n151\t    }\n152\t\n153\t    let data = std::fs::read(&path).expect(\"read capture file\");\n154\t    let _ = std::fs::remove_file(&path);\n155\t    data\n156\t}\n157\t\n158\t/// Capture at most `max_bytes` of output from a call that may run\n159\t/// (essentially) forever: the call happens in a forked child whose stdout is a\n160\t/// pipe; the child is killed once enough bytes have been observed.\n161\tpub fn capture_prefix(f: DriverFn, x: c_int, y: c_int, max_bytes: usize) -> Vec<u8> {\n162\t    let guard = CAPTURE_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n163\t\n164\t    let mut fds = [0 as c_int; 2];\n165\t    assert_eq!(unsafe { pipe(fds.as_mut_ptr()) }, 0, \"pipe() failed\");\n166\t\n167\t    let _ = std::io::stdout().flush();\n168\t    unsafe { fflush(std::ptr::null_mut()) };\n169\t\n170\t    let pid = unsafe { fork() };\n171\t    assert!(pid >= 0, \"fork() failed\");\n172\t    if pid == 0 {\n173\t        // Child: only async-signal-safe-ish work plus the library call.\n174\t        unsafe {\n175\t            close(fds[0]);\n176\t            dup2(fds[1], 1);\n177\t            close(fds[1]);"}]},"parent_tool_use_id":null,"session_id":"eeb44132-fb7e-4437-9dd9-10fc85cd1842","uuid":"8a027ce6-a104-4deb-994a-80d42d8bcc89","timestamp":"2026-08-18T03:58:55.719Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-1bfdsY/translated_rust/tests/common/mod.rs","content":"}\n\n// ---------------------------------------------------------------------------\n// stdout capture\n// ---------------------------------------------------------------------------\n\nstatic CAPTURE_LOCK: Mutex<()> = Mutex::new(());\nstatic COUNTER: AtomicU64 = AtomicU64::new(0);\n\nfn tmp_path(tag: &str) -> PathBuf {\n    std::env::temp_dir().join(format!(\n        \"driver_diff_{}_{}_{}.bin\",\n        std::process::id(),\n        COUNTER.fetch_add(1, Ordering::Relaxed),\n        tag\n    ))\n}\n\n/// Run `f` with fd 1 redirected into a temporary file and return everything it\n/// wrote (after flushing the C `stdout` `FILE`).\npub fn capture(f: impl FnOnce()) -> Vec<u8> {\n    let guard = CAPTURE_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n\n    let path = tmp_path(\"cap\");\n    let file = File::create(&path).expect(\"create capture file\");\n\n    let _ = std::io::stdout().flush();\n    unsafe { fflush(std::ptr::null_mut()) };\n\n    let saved = unsafe { dup(1) };\n    assert!(saved >= 0, \"dup(1) failed\");\n    assert!(unsafe { dup2(file.as_raw_fd(), 1) } >= 0, \"dup2 failed\");\n    drop(file);\n\n    let res = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f));\n\n    unsafe { fflush(std::ptr::null_mut()) };\n    assert!(unsafe { dup2(saved, 1) } >= 0, \"dup2 restore failed\");\n    unsafe { close(saved) };\n    drop(guard);\n\n    if let Err(p) = res {\n        std::panic::resume_unwind(p);\n    }\n\n    let data = std::fs::read(&path).expect(\"read capture file\");\n    let _ = std::fs::remove_file(&path);\n    data\n}\n\n/// Capture at most `max_bytes` of output from a call that may run\n/// (essentially) forever: the call happens in a forked child whose stdout is a\n/// pipe; the child is killed once enough bytes have been observed.\npub fn capture_prefix(f: DriverFn, x: c_int, y: c_int, max_bytes: usize) -> Vec<u8> {\n    let guard = CAPTURE_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n\n    let mut fds = [0 as c_int; 2];\n    assert_eq!(unsafe { pipe(fds.as_mut_ptr()) }, 0, \"pipe() failed\");\n\n    let _ = std::io::stdout().flush();\n    unsafe { fflush(std::ptr::null_mut()) };\n\n    let pid = unsafe { fork() };\n    assert!(pid >= 0, \"fork() failed\");\n    if pid == 0 {\n        // Child: only async-signal-safe-ish work plus the library call.\n        unsafe {\n            close(fds[0]);\n            dup2(fds[1], 1);\n            close(fds[1]);","numLines":70,"startLine":108,"totalLines":302}}}
