{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VW6ZYWdHBNr37zAAsY6BVW","type":"tool_result","content":"1\t//! Phase C — error / rejection-path differential tests.\n2\t//!\n3\t//! One test per row of `ERRORS.md`. `driver` has no return value and no error\n4\t//! codes, so a \"rejection\" is observable as *the exact bytes it does or does\n5\t//! not write*: the guard that returns immediately (zero bytes), and each guard\n6\t//! that suppresses a branch. Both `.so`s must agree byte-for-byte.\n7\t\n8\tmod common;\n9\t\n10\tuse common::{Rng, SEED, assert_same_labelled, assert_same_prefix, c_driver, rust_driver};\n11\tuse std::ffi::c_int;\n12\t\n13\tconst INT_MIN: c_int = c_int::MIN;\n14\tconst INT_MAX: c_int = c_int::MAX;\n15\t\n16\t/// Helper: assert both libraries agree AND that the C output equals `expect`\n17\t/// (the ground truth captured from the real C library).\n18\tfn assert_same_and_exact(label: &str, x: c_int, y: c_int, expect: &str) {\n19\t    let cf = c_driver();\n20\t    let rf = rust_driver();\n21\t    let c_out = common::capture(|| unsafe { cf(x, y) });\n22\t    let r_out = common::capture(|| unsafe { rf(x, y) });\n23\t    assert_eq!(\n24\t        String::from_utf8_lossy(&c_out),\n25\t        expect,\n26\t        \"{label}: C ground truth changed for driver({x}, {y})\"\n27\t    );\n28\t    assert_eq!(\n29\t        String::from_utf8_lossy(&r_out),\n30\t        String::from_utf8_lossy(&c_out),\n31\t        \"{label}: Rust diverged from C for driver({x}, {y})\"\n32\t    );\n33\t}\n34\t\n35\t/// Row 1 — `while (x > 0 || y > 0)` false on entry ⇒ immediate return, no bytes.\n36\t#[test]\n37\tfn row01_loop_never_entered() {\n38\t    for (x, y) in [(0, 0), (-1, -1), (-5, 0), (0, -5), (-1, 0), (0, -1)] {\n39\t        assert_same_and_exact(\"row01\", x, y, \"\");\n40\t    }\n41\t}\n42\t\n43\t/// Row 2 — both operands negative, randomized.\n44\t#[test]\n45\tfn row02_both_negative_random() {\n46\t    let mut rng = Rng::new(SEED ^ 0xE02);\n47\t    for _ in 0..500 {\n48\t        let x = rng.range(INT_MIN, -1);\n49\t        let y = rng.range(INT_MIN, -1);\n50\t        assert_same_and_exact(\"row02\", x, y, \"\");\n51\t    }\n52\t}\n53\t\n54\t/// Row 3 — the most-negative boundary pair.\n55\t#[test]\n56\tfn row03_int_min_pair() {\n57\t    assert_same_and_exact(\"row03\", INT_MIN, INT_MIN, \"\");\n58\t    assert_same_and_exact(\"row03\", INT_MIN + 1, INT_MIN + 1, \"\");\n59\t    assert_same_and_exact(\"row03\", INT_MIN, INT_MIN + 1, \"\");\n60\t}\n61\t\n62\t/// Row 4 — exactly `0` on one side (boundary of the strict `> 0` tests).\n63\t#[test]\n64\tfn row04_zero_boundary_of_gt0() {\n65\t    for (x, y) in [\n66\t        (0, -1),\n67\t        (-1, 0),\n68\t        (0, INT_MIN),\n69\t        (INT_MIN, 0),\n70\t        (0, 0),\n71\t        (-1, INT_MIN),\n72\t        (INT_MIN, -1),\n73\t    ] {\n74\t        assert_same_and_exact(\"row04\", x, y, \"\");\n75\t    }\n76\t}\n77\t\n78\t/// Row 5 — `if (x > 0)` at `label1` rejected (`x == 0`): no `x\\n`, no `x--`.\n79\t#[test]\n80\tfn row05_label1_x_not_positive() {\n81\t    assert_same_and_exact(\"row05\", 0, 3, \"loop\\ny\\ny\\ny\\n\");\n82\t    assert_same_and_exact(\"row05\", 0, 1, \"loop\\ny\\n\");\n83\t    assert_same_and_exact(\"row05\", 0, 4, \"loop\\ny\\ny\\ny\\ny\\n\");\n84\t    let mut rng = Rng::new(SEED ^ 0xE05);\n85\t    for _ in 0..64 {\n86\t        let y = rng.range(1, 200);\n87\t        let expect = format!(\"loop\\n{}\", \"y\\n\".repeat(y as usize));\n88\t        assert_same_and_exact(\"row05/random\", 0, y, &expect);\n89\t    }\n90\t}\n91\t\n92\t/// Row 6 — `if (x > 0)` rejected with `x == INT_MIN` (must never decrement).\n93\t#[test]\n94\tfn row06_label1_x_int_min() {\n95\t    assert_same_and_exact(\"row06\", INT_MIN, 5, \"loop\\ny\\ny\\ny\\ny\\ny\\n\");\n96\t    assert_same_and_exact(\"row06\", INT_MIN, 1, \"loop\\ny\\n\");\n97\t    assert_same_and_exact(\"row06\", INT_MIN + 1, 4, \"loop\\ny\\ny\\ny\\ny\\n\");\n98\t    assert_same_and_exact(\"row06\", -1, 4, \"loop\\ny\\ny\\ny\\ny\\n\");\n99\t}\n100\t\n101\t/// Row 7 — `if (y == 0) continue` at `label2` on entry.\n102\t#[test]\n103\tfn row07_label2_y_zero_continue() {\n104\t    assert_same_and_exact(\"row07\", 3, 0, \"loop\\nx\\nloop\\nx\\nloop\\nx\\n\");\n105\t    assert_same_and_exact(\"row07\", 1, 0, \"loop\\nx\\n\");\n106\t    assert_same_and_exact(\"row07\", 4, 0, \"loop\\nx\\nloop\\nx\\nloop\\nx\\nloop\\nx\\n\");\n107\t    assert_same_and_exact(\"row07\", 2, 0, \"loop\\nx\\nloop\\nx\\n\");\n108\t    let mut rng = Rng::new(SEED ^ 0xE07);\n109\t    for _ in 0..64 {\n110\t        let x = rng.range(1, 200);\n111\t        let expect = \"loop\\nx\\n\".repeat(x as usize);\n112\t        assert_same_and_exact(\"row07/random\", x, 0, &expect);\n113\t    }\n114\t}\n115\t\n116\t/// Row 8 — `if (y == 0) continue` reached with `y` having become 0 mid-body.\n117\t#[test]\n118\tfn row08_label2_y_became_zero() {\n119\t    assert_same_and_exact(\"row08\", 2, 2, \"loop\\nx\\ny\\nx\\ny\\n\");\n120\t    assert_same_and_exact(\"row08\", 1, 1, \"loop\\nx\\ny\\n\");\n121\t    assert_same_and_exact(\"row08\", 2, 1, \"loop\\nx\\ny\\nx\\n\");\n122\t    assert_same_and_exact(\"row08\", 1, 2, \"loop\\nx\\ny\\ny\\n\");\n123\t}\n124\t\n125\t/// Row 9 — `x == 1 && y == 4` ⇒ `goto label2` skips the whole `label1` block.\n126\t#[test]\n127\tfn row09_x1_y4_goto_label2() {\n128\t    assert_same_and_exact(\"row09\", 1, 4, \"loop\\ny\\nx\\ny\\ny\\ny\\n\");\n129\t}\n130\t\n131\t/// Row 10 — both short-circuit halves of `x == 1 && y == 4` failing.\n132\t#[test]\n133\tfn row10_x1_y4_short_circuit_halves() {\n134\t    assert_same_and_exact(\"row10/y!=4\", 1, 3, \"loop\\nx\\ny\\ny\\ny\\n\");\n135\t    assert_same_and_exact(\"row10/y!=4\", 1, 5, \"loop\\nx\\ny\\ny\\ny\\ny\\ny\\n\");\n136\t    assert_same_and_exact(\"row10/x!=1\", 0, 4, \"loop\\ny\\ny\\ny\\ny\\n\");\n137\t    assert_same_and_exact(\"row10/x!=1\", 2, 4, \"loop\\nx\\ny\\nx\\ny\\ny\\ny\\n\");\n138\t    assert_same_and_exact(\"row10/x!=1\", 4, 4, \"loop\\nx\\ny\\nloop\\nx\\ny\\nx\\ny\\nx\\ny\\n\");\n139\t    assert_same_and_exact(\"row10/x!=1\", -1, 4, \"loop\\ny\\ny\\ny\\ny\\n\");\n140\t}\n141\t\n142\t/// Row 11 — `if (x < 3)` true ⇒ backward `goto label1` (no `while` re-test,\n143\t/// hence no extra `loop\\n`).\n144\t#[test]\n145\tfn row11_backward_goto_taken() {\n146\t    assert_same_and_exact(\"row11\", 1, 1, \"loop\\nx\\ny\\n\");\n147\t    assert_same_and_exact(\"row11\", 2, 5, \"loop\\nx\\ny\\nx\\ny\\ny\\ny\\ny\\n\");\n148\t    assert_same_and_exact(\"row11\", 2, 2, \"loop\\nx\\ny\\nx\\ny\\n\");\n149\t    assert_same_and_exact(\"row11\", 1, 2, \"loop\\nx\\ny\\ny\\n\");\n150\t    // No repeated \"loop\" while the back-edge keeps firing.\n151\t    let cf = c_driver();\n152\t    let out = common::capture(|| unsafe { cf(2, 50) });\n153\t    assert_eq!(\n154\t        out.windows(5).filter(|w| *w == b\"loop\\n\").count(),\n155\t        1,\n156\t        \"row11: expected exactly one while-iteration for driver(2, 50)\"\n157\t    );\n158\t    let rf = rust_driver();\n159\t    let rout = common::capture(|| unsafe { rf(2, 50) });\n160\t    assert_eq!(out, rout, \"row11: driver(2, 50) diverged\");\n161\t}\n162\t\n163\t/// Row 12 — `if (x < 3)` false at the boundary ⇒ back-edge rejected, `while`\n164\t/// condition re-tested (extra `loop\\n`).\n165\t#[test]\n166\tfn row12_backward_goto_boundary_x3() {\n167\t    assert_same_and_exact(\"row12\", 4, 4, \"loop\\nx\\ny\\nloop\\nx\\ny\\nx\\ny\\nx\\ny\\n\");\n168\t    assert_same_and_exact(\n169\t        \"row12\",\n170\t        5,\n171\t        5,\n172\t        \"loop\\nx\\ny\\nloop\\nx\\ny\\nloop\\nx\\ny\\nx\\ny\\nx\\ny\\n\",\n173\t    );\n174\t    assert_same_and_exact(\n175\t        \"row12\",\n176\t        6,\n177\t        2,\n178\t        \"loop\\nx\\ny\\nloop\\nx\\ny\\nloop\\nx\\nloop\\nx\\nloop\\nx\\nloop\\nx\\n\",\n179\t    );\n180\t    assert_same_and_exact(\"row12\", 3, 3, \"loop\\nx\\ny\\nx\\ny\\nx\\ny\\n\");\n181\t}\n182\t\n183\t/// Row 13 — extreme / \"garbage\" `int` bit patterns across the FFI boundary.\n184\t///\n185\t/// The API takes no pointers and no enums, so the analogue of \"out-of-range\n186\t/// enum value\" is an arbitrary 32-bit pattern: all of them are legal input and\n187\t/// none may be rejected differently by the two implementations.\n188\t#[test]\n189\tfn row13_extreme_int_bit_patterns() {\n190\t    let patterns: [c_int; 12] = [\n191\t        INT_MIN,\n192\t        INT_MIN + 1,\n193\t        -2147483647,\n194\t        -1000000,\n195\t        -2,\n196\t        -1,\n197\t        0,\n198\t        i32::from_le_bytes([0xFF, 0xFF, 0xFF, 0xFF]),\n199\t        i32::from_le_bytes([0x00, 0x00, 0x00, 0x80]),\n200\t        i32::from_le_bytes([0xAA, 0xAA, 0xAA, 0xAA]),\n201\t        i32::from_le_bytes([0x55, 0x55, 0x55, 0x80]),\n202\t        i32::from_le_bytes([0xEF, 0xBE, 0xAD, 0xDE]),\n203\t    ];\n204\t    // All of these are <= 0, so every pair must produce zero bytes.\n205\t    for x in patterns {\n206\t        for y in patterns {\n207\t            assert!(x <= 0 && y <= 0);\n208\t            assert_same_and_exact(\"row13\", x, y, \"\");\n209\t        }\n210\t    }\n211\t    // ... and combined with a positive counterpart they must still agree.\n212\t    for x in patterns {\n213\t        for y in [1, 2, 3, 4, 5, 40] {\n214\t            assert_same_labelled(\"row13/mixed\", x, y);\n215\t        }\n216\t    }\n217\t}\n218\t\n219\t/// Row 14 — `x > 0 && y < 0`: `y--` walks toward `INT_MIN` (signed-overflow UB\n220\t/// in C) for ≈2^31 iterations. Compared as a byte-capped prefix, produced in a\n221\t/// forked child that is killed once enough output has been seen.\n222\t#[test]\n223\tfn row14_negative_y_unbounded_prefix_matches() {\n224\t    for (x, y) in [\n225\t        (1, -1),\n226\t        (2, -1),\n227\t        (3, -1),\n228\t        (5, -7),\n229\t        (1, INT_MIN + 1),\n230\t        (40, -100000),\n231\t        (INT_MAX, -1),\n232\t    ] {\n233\t        assert_same_prefix(\"row14\", x, y, 4096);\n234\t    }\n235\t}\n236\t\n237\t/// Row 15 — `x == INT_MAX`: ≈2^31 iterations. Prefix comparison plus bounded\n238\t/// surrogates that take the identical code path.\n239\t#[test]\n240\tfn row15_int_max_x_prefix_matches() {\n241\t    assert_same_prefix(\"row15/(INT_MAX,0)\", INT_MAX, 0, 8192);\n242\t    assert_same_prefix(\"row15/(INT_MAX,1)\", INT_MAX, 1, 8192);\n243\t    assert_same_prefix(\"row15/(INT_MAX,INT_MAX)\", INT_MAX, INT_MAX, 8192);\n244\t    assert_same_prefix(\"row15/(INT_MAX-1,4)\", INT_MAX - 1, 4, 8192);\n245\t    assert_same_prefix(\"row15/(0,INT_MAX)\", 0, INT_MAX, 8192);\n246\t    assert_same_prefix(\"row15/(INT_MIN,INT_MAX)\", INT_MIN, INT_MAX, 8192);\n247\t}\n248\t\n249\t#[test]\n250\tfn row15_large_x_surrogates() {\n251\t    for x in [5_000, 50_000, 200_000] {\n252\t        for y in [0, 7] {\n253\t            assert_same_labelled(\"row15/surrogate\", x, y);\n254\t        }\n255\t    }\n256\t}\n257\t\n258\t/// Generic FFI boundary sweep: values one step past every documented/implicit\n259\t/// range boundary of the two parameters.\n260\t#[test]\n261\tfn generic_boundary_sweep() {\n262\t    let interesting: [c_int; 11] = [INT_MIN, INT_MIN + 1, -2, -1, 0, 1, 2, 3, 4, 5, 6];\n263\t    for x in interesting {\n264\t        for y in interesting {\n265\t            if x > 0 && y < 0 {\n266\t                continue; // unbounded in C (row 14 covers it via prefix)\n267\t            }\n268\t            assert_same_labelled(\"generic-boundary\", x, y);\n269\t        }\n270\t    }\n271\t}\n272\t"}]},"parent_tool_use_id":"toolu_bdrk_01G2LmWbTZtBMi7QzWiNqPwm","session_id":"eeb44132-fb7e-4437-9dd9-10fc85cd1842","uuid":"4ad42330-6662-49c0-baf0-bea34fc17e6e","timestamp":"2026-08-18T04:17:03.988Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust for divergence"}
