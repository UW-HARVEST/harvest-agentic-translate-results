{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Ai2EiHYS78Es6ogfDbYFZX","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Both implementations are loaded as *shared objects* through `libloading`\n4\t//! (the C one built by CMake, the Rust one being this crate's `cdylib`), so\n5\t//! every call goes through the real `extern \"C\"` export exactly as an external\n6\t//! consumer would call it. Rust functions are never called directly.\n7\t//!\n8\t//! `driver` returns `void` and communicates only through `stdout`, so the\n9\t//! comparison point is the exact byte stream each library writes to fd 1.\n10\t\n11\t#![allow(dead_code)]\n12\t\n13\tuse libloading::Library;\n14\tuse std::ffi::{c_int, c_void};\n15\tuse std::fs::File;\n16\tuse std::io::Write;\n17\tuse std::os::fd::AsRawFd;\n18\tuse std::path::PathBuf;\n19\tuse std::sync::atomic::{AtomicU64, Ordering};\n20\tuse std::sync::OnceLock;\n21\t\n22\t/// Signature of the single public entry point: `void driver(int x, int y);`\n23\tpub type DriverFn = unsafe extern \"C\" fn(c_int, c_int);\n24\t\n25\tunsafe extern \"C\" {\n26\t    fn fflush(stream: *mut c_void) -> c_int;\n27\t    fn dup(oldfd: c_int) -> c_int;\n28\t    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n29\t    fn close(fd: c_int) -> c_int;\n30\t    fn pipe(fds: *mut c_int) -> c_int;\n31\t    fn fork() -> c_int;\n32\t    fn read(fd: c_int, buf: *mut c_void, count: usize) -> isize;\n33\t    fn kill(pid: c_int, sig: c_int) -> c_int;\n34\t    fn waitpid(pid: c_int, status: *mut c_int, options: c_int) -> c_int;\n35\t    fn _exit(status: c_int);\n36\t}\n37\t\n38\t// ---------------------------------------------------------------------------\n39\t// Library loading\n40\t// ---------------------------------------------------------------------------\n41\t\n42\tstruct Libs {\n43\t    c: Library,\n44\t    rust: Library,\n45\t}"}]},"parent_tool_use_id":null,"session_id":"eeb44132-fb7e-4437-9dd9-10fc85cd1842","uuid":"24213550-8351-4183-b393-18ce8e275432","timestamp":"2026-08-18T04:24:19.803Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-1bfdsY/translated_rust/tests/common/mod.rs","content":"//! Shared differential-test harness.\n//!\n//! Both implementations are loaded as *shared objects* through `libloading`\n//! (the C one built by CMake, the Rust one being this crate's `cdylib`), so\n//! every call goes through the real `extern \"C\"` export exactly as an external\n//! consumer would call it. Rust functions are never called directly.\n//!\n//! `driver` returns `void` and communicates only through `stdout`, so the\n//! comparison point is the exact byte stream each library writes to fd 1.\n\n#![allow(dead_code)]\n\nuse libloading::Library;\nuse std::ffi::{c_int, c_void};\nuse std::fs::File;\nuse std::io::Write;\nuse std::os::fd::AsRawFd;\nuse std::path::PathBuf;\nuse std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::OnceLock;\n\n/// Signature of the single public entry point: `void driver(int x, int y);`\npub type DriverFn = unsafe extern \"C\" fn(c_int, c_int);\n\nunsafe extern \"C\" {\n    fn fflush(stream: *mut c_void) -> c_int;\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    fn pipe(fds: *mut c_int) -> c_int;\n    fn fork() -> c_int;\n    fn read(fd: c_int, buf: *mut c_void, count: usize) -> isize;\n    fn kill(pid: c_int, sig: c_int) -> c_int;\n    fn waitpid(pid: c_int, status: *mut c_int, options: c_int) -> c_int;\n    fn _exit(status: c_int);\n}\n\n// ---------------------------------------------------------------------------\n// Library loading\n// ---------------------------------------------------------------------------\n\nstruct Libs {\n    c: Library,\n    rust: Library,\n}","numLines":45,"startLine":1,"totalLines":379}}}
