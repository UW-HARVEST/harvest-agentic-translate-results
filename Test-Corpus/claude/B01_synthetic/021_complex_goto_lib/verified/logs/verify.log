{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0118ChWUpdf9Rbj6gMc7rzYJ","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Both implementations are loaded as *shared objects* through `libloading`\n4\t//! (the C one built by CMake, the Rust one being this crate's `cdylib`), so\n5\t//! every call goes through the real `extern \"C\"` export exactly as an external\n6\t//! consumer would call it. Rust functions are never called directly.\n7\t//!\n8\t//! `driver` returns `void` and communicates only through `stdout`, so the\n9\t//! comparison point is the exact byte stream each library writes to fd 1.\n10\t\n11\t#![allow(dead_code)]\n12\t\n13\tuse libloading::Library;\n14\tuse std::ffi::{c_int, c_void};\n15\tuse std::fs::File;\n16\tuse std::io::Write;\n17\tuse std::os::fd::AsRawFd;\n18\tuse std::path::PathBuf;\n19\tuse std::sync::atomic::{AtomicU64, Ordering};\n20\tuse std::sync::OnceLock;\n21\t\n22\t/// Signature of the single public entry point: `void driver(int x, int y);`\n23\tpub type DriverFn = unsafe extern \"C\" fn(c_int, c_int);\n24\t\n25\tunsafe extern \"C\" {\n26\t    fn fflush(stream: *mut c_void) -> c_int;\n27\t    fn dup(oldfd: c_int) -> c_int;\n28\t    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n29\t    fn close(fd: c_int) -> c_int;\n30\t    fn pipe(fds: *mut c_int) -> c_int;\n31\t    fn fork() -> c_int;\n32\t    fn read(fd: c_int, buf: *mut c_void, count: usize) -> isize;\n33\t    fn kill(pid: c_int, sig: c_int) -> c_int;\n34\t    fn waitpid(pid: c_int, status: *mut c_int, options: c_int) -> c_int;\n35\t    fn _exit(status: c_int);\n36\t}\n37\t\n38\t// ---------------------------------------------------------------------------\n39\t// Library loading\n40\t// ---------------------------------------------------------------------------\n41\t\n42\tstruct Libs {\n43\t    c: Library,\n44\t    rust: Library,\n45\t}\n46\t\n47\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n48\t\n49\tfn c_so_path() -> PathBuf {\n50\t    let p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n51\t        .join(\"c_src\")\n52\t        .join(\"build\")\n53\t        .join(\"libdriver.so\");\n54\t    assert!(\n55\t        p.is_file(),\n56\t        \"C shared library not found at {}\\nbuild it with:\\n  cd c_src && mkdir -p build && cd build \\\\\\n    && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\",\n57\t        p.display()\n58\t    );\n59\t    p\n60\t}\n61\t\n62\tfn rust_so_path() -> PathBuf {\n63\t    let exe = std::env::current_exe().expect(\"current_exe\");\n64\t    // .../target/<profile>/deps/<testbin>-<hash>\n65\t    let mut dir = exe.parent().expect(\"test exe parent\").to_path_buf();\n66\t    let mut found = None;\n67\t    for _ in 0..4 {\n68\t        let cand = dir.join(\"libdriver.so\");\n69\t        if cand.is_file() {\n70\t            found = Some(cand);\n71\t            break;\n72\t        }\n73\t        match dir.parent() {\n74\t            Some(p) => dir = p.to_path_buf(),\n75\t            None => break,\n76\t        }\n77\t    }\n78\t    let so = found.unwrap_or_else(|| {\n79\t        panic!(\n80\t            \"could not locate the Rust cdylib `libdriver.so` near {}\\n\\\n81\t             build it first with `cargo build`\",\n82\t            exe.display()\n83\t        )\n84\t    });\n85\t    assert_fresh(&so);\n86\t    so\n87\t}\n88\t\n89\t/// `cargo test` does **not** rebuild a `crate-type = [\"cdylib\"]` artifact, so a\n90\t/// stale `libdriver.so` would silently be tested. Refuse to run in that case.\n91\tfn assert_fresh(so: &PathBuf) {\n92\t    let so_mtime = std::fs::metadata(so)\n93\t        .and_then(|m| m.modified())\n94\t        .expect(\"stat cdylib\");\n95\t    let src = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"src\");\n96\t    let mut newest: Option<(PathBuf, std::time::SystemTime)> = None;\n97\t    let mut stack = vec![src];\n98\t    while let Some(dir) = stack.pop() {\n99\t        let Ok(entries) = std::fs::read_dir(&dir) else {\n100\t            continue;\n101\t        };\n102\t        for e in entries.flatten() {\n103\t            let p = e.path();\n104\t            if p.is_dir() {\n105\t                stack.push(p);\n106\t            } else if let Ok(t) = e.metadata().and_then(|m| m.modified()) {\n107\t                if newest.as_ref().map(|(_, n)| t > *n).unwrap_or(true) {\n108\t                    newest = Some((p, t));\n109\t                }\n110\t            }\n111\t        }\n112\t    }\n113\t    if let Some((p, t)) = newest {\n114\t        assert!(\n115\t            t <= so_mtime,\n116\t            \"STALE ARTIFACT: {} is newer than {}\\n\\\n117\t             `cargo test` does not rebuild a cdylib — run `cargo build` first \\\n118\t             (or use ./check_all.sh)\",\n119\t            p.display(),\n120\t            so.display()\n121\t        );\n122\t    }\n123\t}\n124\t\n125\tfn libs() -> &'static Libs {\n126\t    LIBS.get_or_init(|| unsafe {\n127\t        let c = Library::new(c_so_path()).expect(\"dlopen C libdriver.so\");\n128\t        let rust = Library::new(rust_so_path()).expect(\"dlopen Rust libdriver.so\");\n129\t        Libs { c, rust }\n130\t    })\n131\t}\n132\t\n133\t/// `driver` from the C shared object.\n134\tpub fn c_driver() -> DriverFn {\n135\t    unsafe {\n136\t        *libs()\n137\t            .c\n138\t            .get::<DriverFn>(b\"driver\\0\")\n139\t            .expect(\"symbol `driver` missing from the C .so\")\n140\t    }\n141\t}\n142\t\n143\t/// `driver` from the Rust shared object (exercises the `#[no_mangle]` export).\n144\tpub fn rust_driver() -> DriverFn {\n145\t    unsafe {\n146\t        *libs()\n147\t            .rust\n148\t            .get::<DriverFn>(b\"driver\\0\")\n149\t            .expect(\"symbol `driver` missing from the Rust .so\")\n150\t    }\n151\t}\n152\t\n153\t// ---------------------------------------------------------------------------\n154\t// stdout capture\n155\t// ---------------------------------------------------------------------------\n156\t\n157\tstatic COUNTER: AtomicU64 = AtomicU64::new(0);\n158\t\n159\tfn tmp_path(tag: &str) -> PathBuf {\n160\t    std::env::temp_dir().join(format!(\n161\t        \"driver_diff_{}_{}_{}.bin\",\n162\t        std::process::id(),\n163\t        COUNTER.fetch_add(1, Ordering::Relaxed),\n164\t        tag\n165\t    ))\n166\t}\n167\t\n168\t/// What a captured run produced.\n169\tpub struct Outcome {\n170\t    /// Exact bytes written to `stdout`.\n171\t    pub out: Vec<u8>,\n172\t    /// Raw `waitpid` status of the child that performed the call (so a crash /\n173\t    /// abort / panic counts as an observable difference too).\n174\t    pub status: c_int,\n175\t}\n176\t\n177\t/// Run `f` in a forked child whose fd 1 is a temporary file, and return the\n178\t/// bytes it wrote plus the child's exit status.\n179\t///\n180\t/// A forked child is used (rather than redirecting fd 1 in-process) so that the\n181\t/// libtest harness — which keeps writing its own progress lines to fd 1 from\n182\t/// other threads — cannot contaminate the capture, and so that tests remain\n183\t/// safe to run in parallel.\n184\tpub fn capture_outcome(f: impl FnOnce()) -> Outcome {\n185\t    let path = tmp_path(\"cap\");\n186\t    let file = File::create(&path).expect(\"create capture file\");\n187\t    let fd = file.as_raw_fd();\n188\t\n189\t    // Nothing may be pending in either stdout buffer, or the child would\n190\t    // duplicate it into the capture.\n191\t    let _ = std::io::stdout().flush();\n192\t    unsafe { fflush(std::ptr::null_mut()) };\n193\t\n194\t    let pid = unsafe { fork() };\n195\t    assert!(pid >= 0, \"fork() failed\");\n196\t    if pid == 0 {\n197\t        unsafe {\n198\t            dup2(fd, 1);\n199\t            f();\n200\t            fflush(std::ptr::null_mut());\n201\t            _exit(0);\n202\t        }\n203\t        std::process::exit(0); // not reached\n204\t    }\n205\t    drop(file);\n206\t\n207\t    let mut status: c_int = 0;\n208\t    let rc = unsafe { waitpid(pid, &mut status, 0) };\n209\t    assert_eq!(rc, pid, \"waitpid failed\");\n210\t\n211\t    let out = std::fs::read(&path).expect(\"read capture file\");\n212\t    let _ = std::fs::remove_file(&path);\n213\t    Outcome { out, status }\n214\t}\n215\t\n216\t/// Same as [`capture_outcome`] but asserts the child terminated normally.\n217\tpub fn capture(f: impl FnOnce()) -> Vec<u8> {\n218\t    let o = capture_outcome(f);\n219\t    assert_eq!(o.status, 0, \"captured call did not exit cleanly\");\n220\t    o.out\n221\t}\n222\t\n223\t/// Capture at most `max_bytes` of output from a call that may run\n224\t/// (essentially) forever: the call happens in a forked child whose stdout is a\n225\t/// pipe; the child is killed once enough bytes have been observed.\n226\tpub fn capture_prefix(f: DriverFn, x: c_int, y: c_int, max_bytes: usize) -> Vec<u8> {\n227\t    let mut fds = [0 as c_int; 2];\n228\t    assert_eq!(unsafe { pipe(fds.as_mut_ptr()) }, 0, \"pipe() failed\");\n229\t\n230\t    let _ = std::io::stdout().flush();\n231\t    unsafe { fflush(std::ptr::null_mut()) };\n232\t\n233\t    let pid = unsafe { fork() };\n234\t    assert!(pid >= 0, \"fork() failed\");\n235\t    if pid == 0 {\n236\t        // Child: only async-signal-safe-ish work plus the library call.\n237\t        unsafe {\n238\t            close(fds[0]);\n239\t            dup2(fds[1], 1);\n240\t            close(fds[1]);\n241\t            f(x, y);\n242\t            fflush(std::ptr::null_mut());\n243\t            _exit(0);\n244\t        }\n245\t        // Not reached.\n246\t        std::process::exit(0);\n247\t    }\n248\t\n249\t    unsafe { close(fds[1]) };\n250\t    let mut buf = vec![0u8; max_bytes];\n251\t    let mut got = 0usize;\n252\t    while got < max_bytes {\n253\t        let n = unsafe {\n254\t            read(\n255\t                fds[0],\n256\t                buf[got..].as_mut_ptr() as *mut c_void,\n257\t                max_bytes - got,\n258\t            )\n259\t        };\n260\t        if n <= 0 {\n261\t            break;\n262\t        }\n263\t        got += n as usize;\n264\t    }\n265\t    unsafe {\n266\t        kill(pid, 9); // SIGKILL\n267\t        let mut status: c_int = 0;\n268\t        waitpid(pid, &mut status, 0);\n269\t        close(fds[0]);\n270\t    }\n271\t\n272\t    buf.truncate(got);\n273\t    buf\n274\t}\n275\t\n276\t// ---------------------------------------------------------------------------\n277\t// Differential assertions\n278\t// ---------------------------------------------------------------------------\n279\t\n280\tfn preview(b: &[u8]) -> String {\n281\t    let n = b.len().min(160);\n282\t    String::from_utf8_lossy(&b[..n]).escape_debug().to_string()\n283\t}\n284\t\n285\tfn report(label: &str, x: c_int, y: c_int, c_out: &[u8], r_out: &[u8]) -> String {\n286\t    let first_diff = c_out\n287\t        .iter()\n288\t        .zip(r_out.iter())\n289\t        .position(|(a, b)| a != b)\n290\t        .unwrap_or_else(|| c_out.len().min(r_out.len()));\n291\t    format!(\n292\t        \"{label}: driver({x}, {y}) diverged\\n  C   len={} \\n  Rust len={}\\n  first difference at byte {first_diff}\\n  C   [..]: \\\"{}\\\"\\n  Rust[..]: \\\"{}\\\"\",\n293\t        c_out.len(),\n294\t        r_out.len(),\n295\t        preview(&c_out[first_diff.min(c_out.len())..]),\n296\t        preview(&r_out[first_diff.min(r_out.len())..]),\n297\t    )\n298\t}\n299\t\n300\t/// Call both `.so` exports with `(x, y)` and assert byte-identical stdout.\n301\tpub fn assert_same(x: c_int, y: c_int) {\n302\t    assert_same_labelled(\"case\", x, y);\n303\t}\n304\t\n305\tpub fn assert_same_labelled(label: &str, x: c_int, y: c_int) {\n306\t    let cf = c_driver();\n307\t    let rf = rust_driver();\n308\t    let c = capture_outcome(|| unsafe { cf(x, y) });\n309\t    let r = capture_outcome(|| unsafe { rf(x, y) });\n310\t    if c.out != r.out {\n311\t        panic!(\"{}\", report(label, x, y, &c.out, &r.out));\n312\t    }\n313\t    assert_eq!(\n314\t        c.status, r.status,\n315\t        \"{label}: driver({x}, {y}) termination status differs (C={:#x}, Rust={:#x})\",\n316\t        c.status, r.status\n317\t    );\n318\t    assert_eq!(\n319\t        c.status, 0,\n320\t        \"{label}: driver({x}, {y}) did not terminate cleanly in either library\"\n321\t    );\n322\t}\n323\t\n324\t/// Compare only the first `max_bytes` of output (for non-terminating inputs).\n325\tpub fn assert_same_prefix(label: &str, x: c_int, y: c_int, max_bytes: usize) {\n326\t    let c_out = capture_prefix(c_driver(), x, y, max_bytes);\n327\t    let r_out = capture_prefix(rust_driver(), x, y, max_bytes);\n328\t    if c_out != r_out {\n329\t        panic!(\"{}\", report(label, x, y, &c_out, &r_out));\n330\t    }\n331\t    assert_eq!(\n332\t        c_out.len(),\n333\t        max_bytes,\n334\t        \"{label}: expected a full {max_bytes}-byte window from driver({x}, {y})\"\n335\t    );\n336\t    assert_eq!(\n337\t        r_out.len(),\n338\t        max_bytes,\n339\t        \"{label}: expected a full {max_bytes}-byte window from driver({x}, {y})\"\n340\t    );\n341\t}\n342\t\n343\t// ---------------------------------------------------------------------------\n344\t// Deterministic RNG (xorshift64*), fixed seed for reproducibility\n345\t// ---------------------------------------------------------------------------\n346\t\n347\tpub struct Rng(u64);\n348\t\n349\timpl Rng {\n350\t    pub fn new(seed: u64) -> Self {\n351\t        Rng(if seed == 0 { 0x9E3779B97F4A7C15 } else { seed })\n352\t    }\n353\t\n354\t    pub fn next_u64(&mut self) -> u64 {\n355\t        let mut x = self.0;\n356\t        x ^= x >> 12;\n357\t        x ^= x << 25;\n358\t        x ^= x >> 27;\n359\t        self.0 = x;\n360\t        x.wrapping_mul(0x2545F4914F6CDD1D)\n361\t    }\n362\t\n363\t    /// Uniform in `[lo, hi]` (inclusive).\n364\t    pub fn range(&mut self, lo: i32, hi: i32) -> i32 {\n365\t        assert!(lo <= hi);\n366\t        let span = (hi as i64 - lo as i64 + 1) as u64;\n367\t        (lo as i64 + (self.next_u64() % span) as i64) as i32\n368\t    }\n369\t}\n370\t\n371\tpub const SEED: u64 = 0x2545F4914F6CDD1D;\n372\t\n373\t/// `x > 0 && y < 0` makes the C library run ~2^31 iterations (and hit signed\n374\t/// overflow UB); such pairs are steered away from for the bounded valid-path\n375\t/// rows and covered separately by the capped-prefix error-path tests.\n376\tpub fn bounded_pair(x: c_int, y: c_int) -> (c_int, c_int) {\n377\t    if x > 0 && y < 0 { (x, 0) } else { (x, y) }\n378\t}\n379\t"}]},"parent_tool_use_id":"toolu_bdrk_01G2LmWbTZtBMi7QzWiNqPwm","session_id":"eeb44132-fb7e-4437-9dd9-10fc85cd1842","uuid":"9c67f0e7-a6df-4516-8bdd-4d7543fd4d65","timestamp":"2026-08-18T04:06:32.307Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust for divergence"}
