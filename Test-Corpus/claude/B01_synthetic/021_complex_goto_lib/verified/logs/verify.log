;\n39\t    unsafe {\n40\t        printf(c\"%s\".as_ptr(), s.as_ptr() as *const c_char);\n41\t    }\n42\t}\n43\t\n44\t/// Labels in the original C function body, used to reproduce its `goto`\n45\t/// driven control flow exactly.\n46\t#[derive(Copy, Clone, PartialEq, Eq)]\n47\tenum Label {\n48\t    /// Top of the `while` body (the `printf(\"loop\\n\")` statement).\n49\t    Body,\n50\t    /// The `label1:` target.\n51\t    Label1,\n52\t    /// The `label2:` target.\n53\t    Label2,\n54\t}\n55\t\n56\t/// Translation of:\n57\t///\n58\t/// ```c\n59\t/// void driver(int x, int y) {\n60\t///     while (x > 0 || y > 0) {\n61\t///         printf(\"loop\\n\");\n62\t///         if (x == 1 && y == 4) {\n63\t///             goto label2;\n64\t///         }\n65\t/// label1:\n66\t///         if (x > 0) {\n67\t///             printf(\"x\\n\");\n68\t///             x--;\n69\t///         }\n70\t/// label2:\n71\t///         if (y == 0) {\n72\t///             continue;\n73\t///         }\n74\t///         printf(\"y\\n\");\n75\t///         y--;\n76\t///         if (x < 3) {\n77\t///             goto label1;\n78\t///         }\n79\t///     }\n80\t/// }\n81\t/// ```\n82\t#[unsafe(no_mangle)]\n83\tpub extern \"C\" fn driver(x: c_int, y: c_int) {\n84\t    let mut x: c_int = x;\n85\t    let mut y: c_int = y;\n86\t\n87\t    // `while (x > 0 || y > 0)`\n88\t    while x > 0 || y > 0 {\n89\t        // Inner dispatch loop reproducing the backwards `goto label1` and the\n90\t        // forwards `goto label2` inside the loop body. Breaking out of this\n91\t        // inner loop corresponds to reaching the end of the C loop body (or a\n92\t        // `continue`), i.e. re-evaluating the `while` condition.\n93\t        let mut label = Label::Body;\n94\t        loop {\n95\t            match label {\n96\t                Label::Body => {\n97\t                    c_print(b\"loop\\n\\0\");\n98\t\n99\t                    if x == 1 && y == 4 {\n100\t                        // goto label2;\n101\t                        label = Label::Label2;\n102\t                        continue;\n103\t                    }\n104\t\n105\t                    // fall through to label1:\n106\t                    label = Label::Label1;\n107\t                }\n108\t                Label::Label1 => {\n109\t                    if x > 0 {\n110\t                        c_print(b\"x\\n\\0\");\n111\t                        x = x.wrapping_sub(1);\n112\t                    }\n113\t\n114\t                    // fall through to label2:\n115\t                    label = Label::Label2;\n116\t                }\n117\t                Label::Label2 => {\n118\t                    if y == 0 {\n119\t                        // continue; -> re-test the while condition\n120\t                        break;\n121\t                    }\n122\t\n123\t                    c_print(b\"y\\n\\0\");\n124\t                    y = y.wrapping_sub(1);\n125\t\n126\t                    if x < 3 {\n127\t                        // goto label1;\n128\t                        label = Label::Label1;\n129\t                        continue;\n130\t                    }\n131\t\n132\t                    // end of the while body -> re-test the while condition\n133\t                    break;\n134\t                }\n135\t            }\n136\t        }\n137\t    }\n138\t}\n139\t"}]},"parent_tool_use_id":"toolu_bdrk_01G2LmWbTZtBMi7QzWiNqPwm","session_id":"eeb44132-fb7e-4437-9dd9-10fc85cd1842","uuid":"c9ed3898-17dc-42c5-9852-810457049a94","timestamp":"2026-08-18T04:04:50.102Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust for divergence"}
