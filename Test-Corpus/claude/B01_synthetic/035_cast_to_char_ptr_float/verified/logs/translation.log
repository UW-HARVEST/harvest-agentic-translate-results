xes and trailing junk\nfor base in ['1.25','-2.5e3','0x1p4','nan','inf']:\n    for pre in ['', ' ', '\\n\\n\\t ', '\\r\\v\\f ']:\n        for post in ['', ' rest', '\\n', 'zzz', '.5']:\n            cases.append(pre+base+post)\nbad=0\nfor s in cases:\n    d=s.encode('latin-1')\n    a=run(C,d); b=run(R,d)\n    if a!=b:\n        bad+=1; print(\"MISMATCH %r : C=%r RUST=%r\"%(s,a,b))\n        if bad>25: break\nprint(\"total %d cases, %d mismatches\"%(len(cases),bad))\nPYEOF\npython3 $TMPDIR/ref/difftest2.py","uuid":"d17f82e9-2c95-4ac6-b3f0-f1ab8d0e9bff","session_id":"8cb12d8a-10eb-4924-a2df-a871ffdc63df"}
