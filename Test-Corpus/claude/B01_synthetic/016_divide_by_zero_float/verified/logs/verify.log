oundary >  ->  >=|s/> 0\\.000001/>= 0.000001/\"\n  \"NaN cast -> 0 instead of INT_MIN|s/if v.is_nan() {\\n        return i32::MIN;/XX/\"\n  \"int-range upper bound off by one|s/t >= 2147483648\\.0/t > 2147483648.0/\"\n  \"int-range lower bound off by one|s/t < -2147483648\\.0/t < -2147483649.0/\"\n  \"fgets reads size bytes not size-1|s/buf\\.len() + 1 < size/buf.len() < size/\"\n  \"fgets keeps reading past newline|s/if byte\\[0\\] == b.\\\\\\\\n. {/if false {/\"\n  \"atof: hex mantissa truncated early|s/kept < 28/kept < 6/\"\n  \"atof: ignore NUL terminator|s/Some(p) => \\&bytes\\[\\.\\.p\\]/Some(_) => bytes/\"\n  \"atof: drop the sign|s/if negative { -magnitude } else { magnitude }/magnitude/\"\n  \"atof: no hex support|s/if rest\\.len() >= 2 \\&\\& rest\\[0\\] == b.0./if false \\&\\& rest[0] == b'0'/\"\n  \"atof: nan -> 0.0|s/if negative { -f64::NAN } else { f64::NAN }/0.0/\"\n  \"atof: inf -> 0.0|s/f64::NEG_INFINITY/0.0/\"\n  \"printLine: transcode raw bytes|s/let _ = out.write_all(line);/let _ = out.write_all(String::from_utf8_lossy(line).as_bytes());/\"\n  \"printIntLine: wrong format|s/write!(out, \\\"{}\\\\\\\\n\\\", int_number)/write!(out, \\\"{} \\\\\\\\n\\\", int_number)/\"\n  \"good_g2b constant 2.0 -> 4.0|s/let data: f32 = 2\\.0f32;/let data: f32 = 4.0f32;/\"\n  \"guard uses data not fabs(data)|s/(data as f64)\\.abs() > 0\\.000001/(data as f64) > 0.000001/\"\n  \"bad: divide 100 by 200|s|let result = double_to_int(100.0f64 / data as f64);\\n        print_int_line(result);\\n    }\\n}\\n\\nfn good_g2b|XX|\"\n)\n\npass=0; caught=0; missed=0; skipped=0\necho \"=== mutation negative control ===\"\nfor entry in \"${MUTATIONS[@]}\"; do\n  name=\"${entry%%|*}\"\n  expr=\"${entry#*|}\"\n  restore\n  if ! sed -i \"$expr\" src/imp.rs 2>/dev/null; then\n    printf '  SKIP    %s (sed failed)\\n' \"$name\"; skipped=$((skipped+1)); continue\n  fi\n  if diff -q \"$BACKUP\" src/imp.rs >/dev/null; then\n    printf '  SKIP    %s (no textual change)\\n' \"$name\"; skipped=$((skipped+1)); continue\n  fi\n  out=$(timeout 600 cargo test --offline --no-default-features --test differential \\\n          -- --test-threads=1 2>&1)\n  if echo \"$out\" | grep -qE \"^error(\\[|:)\"; then\n    printf '  SKIP    %s (did not compile)\\n' \"$name\"; skipped=$((skipped+1)); continue\n  fi\n  if echo \"$out\" | grep -q \"test result: FAILED\"; then\n    n=$(echo \"$out\" | grep -oE \"[0-9]+ failed\" | head -1)\n    printf '  CAUGHT  %-42s (%s)\\n' \"$name\" \"$n\"; caught=$((caught+1))\n  else\n    printf '  MISSED  %-42s <-- suite is blind to this!\\n' \"$name\"; missed=$((missed+1))\n  fi\ndone\nrestore\n\necho\necho \"caught=$caught missed=$missed skipped=$skipped\"\n# Confirm the restored (correct) tree still passes.\nout=$(timeout 600 cargo test --offline --no-default-features --test differential \\\n        -- --test-threads=1 2>&1)\nif echo \"$out\" | grep -q \"test result: ok\"; then\n  echo \"restored tree: PASS\"\nelse\n  echo \"restored tree: FAIL <-- restore went wrong\"; exit 1\nfi\n[ \"$missed\" -eq 0 ] || exit 1\n","userModified":false}}
