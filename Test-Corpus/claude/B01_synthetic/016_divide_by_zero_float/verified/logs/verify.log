eproduced exactly rather than \"fixed\".\n//\n// This module holds the shared core so that it can be compiled both into the\n// `driver` executable (src/main.rs) and into the `cdylib` that re-exports the\n// same C ABI symbols as the original C translation unit (src/lib.rs).\n\nuse std::io::{self, Read, Write};\n\n// ---------------------------------------------------------------------------\n// Output helpers (mirror printLine / printIntLine)\n// ---------------------------------------------------------------------------\n\n/// Body of `void printLine(const char * line)` for a non-NULL `line`:\n/// `printf(\"%s\\n\", line)` writes the raw bytes up to the NUL terminator\n/// followed by a newline. Operates on bytes (not `str`) so that non-UTF-8\n/// input crossing the FFI boundary behaves exactly as C's `%s` does.\npub fn print_line_bytes(line: &[u8]) {\n    let stdout = io::stdout();\n    let mut out = stdout.lock();\n    let _ = out.write_all(line);\n    let _ = out.write_all(b\"\\n\");\n    let _ = out.flush();\n}\n\n/// `void printLine(const char * line)` -- prints `\"%s\\n\"` for non-NULL input.\n/// A NULL pointer is modelled by `None`, in which case nothing is printed.\npub fn print_line(line: Option<&[u8]>) {\n    if let Some(line) = line {\n        print_line_bytes(line);\n    }\n}\n\n/// `void printIntLine(int intNumber)` -- prints `\"%d\\n\"`.\npub fn print_int_line(int_number: i32) {\n    let stdout = io::stdout();\n    let mut out = stdout.lock();\n    let _ = write!(out, \"{}\\n\", int_number);\n    let _ = out.flush();\n}\n\n// ---------------------------------------------------------------------------\n// C runtime emulation\n// ---------------------------------------------------------------------------\n\npub const CHAR_ARRAY_SIZE: usize = 20;\n\n/// Emulates `fgets(buf, size, stdin)`.\n///\n/// Reads at most `size - 1` bytes, stopping right after a newline (which is\n/// kept in the buffer) or at end of file. Returns `None` (C's NULL) when EOF\n///