,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":459,"cache_read_input_tokens":33684,"cache_creation":{"ephemeral_5m_input_tokens":459,"ephemeral_1h_input_tokens":0},"output_tokens":39,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"33a26cdd-9dd2-4885-80ea-9e01101ee328","uuid":"23db64cd-77dd-458b-85c0-008a53694e65"}
