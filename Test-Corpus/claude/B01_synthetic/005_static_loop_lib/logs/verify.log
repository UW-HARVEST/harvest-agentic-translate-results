:new(rust_lib_path()).expect(\"failed to load Rust .so\");","+","+        let c_sum: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> =","+            c_lib.get(b\"static_sum\").unwrap();","+        let r_sum: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> =","+            r_lib.get(b\"static_sum\").unwrap();","         let c_driver: Symbol<unsafe extern \"C\" fn(c_int)> =","             c_lib.get(b\"driver\").unwrap();","         let r_driver: Symbol<unsafe extern \"C\" fn(c_int)> =","             r_lib.get(b\"driver\").unwrap();"," ","-        // Each driver call uses static_sum internally with i*stride for i in 0..10.","-        // The static `sum` carries across calls and is independent per library.","-        for &stride in &[0, 1, 2, 3, -1, -5, 10, 100] {","+        // ---- 1. static_sum: identical update sequence on both libs ----","+        // Each library starts with internal sum == 0. Drive both with the same","+        // updates and verify byte-equal results at every step.","+        let updates: &[c_int] = &[","+            0, 1, 2, 3, 4, 5, -1, -2, 100, -50, 0, 7, 7, 7,","+            i32::MAX / 4, -(i32::MAX / 4), 0, 1, -1,","+            // negative excursions","+            -1000, 500, -250, 125,","+        ];","+        for (idx, &u) in updates.iter().enumerate() {","+            let cv = c_sum(u);","+            let rv = r_sum(u);","+            assert_eq!(cv, rv, \"static_sum mismatch at step {} update {}\", idx, u);","+        }","+","+        // ---- 2. static_sum: many zero-updates should preserve sum identically ----","+        for _ in 0..50 {","+            let cv = c_sum(0);","+            let rv = r_sum(0);","+            assert_eq!(cv, rv, \"static_sum(0) idempotency mismatch\");","+        }","+","+        // ---- 3. driver: byte-equal stdout output for various strides ----","+        // driver internally calls static_sum 10 times. The static sum continues","+        // from wherever it was; we just need both libs to be in identical state","+        // before each call (which they are, since they've received the same input","+        // sequence so far). After each driver call, both libs again have the","+        // same internal state.","+        for &stride in &[0, 1, 2, 3, -1, -5, 10, 100, -123, 7] {","             let c_out = capture_stdout(|| c_driver(stride));","             let r_out = capture_stdout(|| r_driver(stride));","             assert_eq!("]},{"oldStart":128,"oldLines":5,"newStart":113,"newLines":25,"lines":["                 String::from_utf8_lossy(&r_out)","             );","         }","+","+        // ---- 4. mixed: a few static_sum updates between driver calls ----","+        for &(stride, extras) in &[","+            (1i32, &[5i32, -3, 0][..]),","+            (-2, &[100, -100, 50][..]),","+            (3, &[][..]),","+            (0, &[1, 2, 3, 4, 5][..]),","+        ] {","+            for &u in extras {","+                let cv = c_sum(u);","+                let rv = r_sum(u);","+                assert_eq!(cv, rv, \"static_sum mismatch in mixed phase update {}\", u);","+            }","+            let c_out = capture_stdout(|| c_driver(stride));","+            let r_out = capture_stdout(|| r_driver(stride));","+            assert_eq!(","+                c_out, r_out,","+                \"mixed driver({}) output mismatch\", stride","+            );","+        }","     }"," }"]}],"originalFile":"// Integration test: compare C .so vs Rust .so byte-for-byte through FFI.\n// Both libraries are loaded via libloading and called as an external caller would.\n\nuse libloading::{Library, Symbol};\nuse std::os::raw::c_int;\nuse std::path::PathBuf;\n\nfn workspace_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    workspace_root().join(\"c_src/build/libStaticLoop.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    // Cargo always places integration test outputs alongside the cdylib in\n    // target/<profile>/. CARGO_MANIFEST_DIR + target/debug works for `cargo test`.\n    let mut p = workspace_root();\n    p.push(\"target\");\n    p.push(\"debug\");\n    p.push(\"libStaticLoop.so\");\n    p\n}\n\nunsafe fn load_libs() -> (Library, Library) {\n    let c = Library::new(c_lib_path()).expect(\"failed to load C .so\");\n    let r = Library::new(rust_lib_path()).expect(\"failed to load Rust .so\");\n    (c, r)\n}\n\n#[test]\nfn static_sum_matches_for_sequence() {\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_sum: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> =\n            c_lib.get(b\"static_sum\").unwrap();\n        let r_sum: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> =\n            r_lib.get(b\"static_sum\").unwrap();\n\n        // Each library has its own internal static `sum` starting at 0.\n        // Drive them with the same sequence of updates and verify byte-equal results.\n        let updates: &[c_int] = &[\n            0, 1, 2, 3, 4, 5, -1, -2, 100, -50, 0, 7, 7, 7,\n            i32::MAX / 4, -(i32::MAX / 4), 0, 1, -1,\n        ];\n        for &u in updates {\n            let cv = c_sum(u);\n            let rv = r_sum(u);\n            assert_eq!(cv, rv, \"static_sum mismatch on update {}\", u);\n        }\n    }\n}\n\n#[test]\nfn static_sum_zero_repeated() {\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_sum: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> =\n            c_lib.get(b\"static_sum\").unwrap();\n        let r_sum: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> =\n            r_lib.get(b\"static_sum\").unwrap();\n\n        for _ in 0..50 {\n            assert_eq!(c_sum(0), r_sum(0));\n        }\n    }\n}\n\n// Helper: redirect stdout while running closure, return captured bytes.\n// Uses dup/dup2 on FD 1 and reads from a pipe.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    use std::io::Read;\n    use std::os::unix::io::FromRawFd;\n\n    unsafe {\n        // Flush libc stdout buffers first.\n        libc::fflush(std::ptr::null_mut());\n\n        let saved = libc::dup(1);\n        assert!(saved >= 0, \"dup failed\");\n\n        let mut fds: [c_int; 2] = [0; 2];\n        let r = libc::pipe(fds.as_mut_ptr());\n        assert_eq!(r, 0, \"pipe failed\");\n\n        // Replace stdout with the write end.\n        let r = libc::dup2(fds[1], 1);\n        assert!(r >= 0, \"dup2 failed\");\n        libc::close(fds[1]);\n\n        f();\n\n        // Flush again so all printf output goes through pipe.\n        libc::fflush(std::ptr::null_mut());\n\n        // Restore real stdout.\n        libc::dup2(saved, 1);\n        libc::close(saved);\n\n        // Read everything from the pipe. Make sure we close it after to avoid hangs.\n        let mut file = std::fs::File::from_raw_fd(fds[0]);\n        let mut buf = Vec::new();\n        file.read_to_end(&mut buf).expect(\"read from pipe failed\");\n        buf\n    }\n}\n\n#[test]\nfn driver_output_matches() {\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_driver: Symbol<unsafe extern \"C\" fn(c_int)> =\n            c_lib.get(b\"driver\").unwrap();\n        let r_driver: Symbol<unsafe extern \"C\" fn(c_int)> =\n            r_lib.get(b\"driver\").unwrap();\n\n        // Each driver call uses static_sum internally with i*stride for i in 0..10.\n        // The static `sum` carries across calls and is independent per library.\n        for &stride in &[0, 1, 2, 3, -1, -5, 10, 100] {\n            let c_out = capture_stdout(|| c_driver(stride));\n            let r_out = capture_stdout(|| r_driver(stride));\n            assert_eq!(\n                c_out, r_out,\n                \"driver({}) output mismatch:\\n C: {:?}\\n R: {:?}\",\n                stride,\n                String::from_utf8_lossy(&c_out),\n                String::from_utf8_lossy(&r_out)\n            );\n        }\n    }\n}\n","userModified":false}}
