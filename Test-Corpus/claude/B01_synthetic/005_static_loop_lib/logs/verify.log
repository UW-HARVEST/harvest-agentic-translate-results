dir.join(\"export.ver\");","     std::fs::write(","         &vs,","-        \"{\\n  global:\\n    static_sum;\\n    driver;\\n    _init;\\n    _fini;\\n    _edata;\\n    _end;\\n    __bss_start;\\n  local: *;\\n};\\n\",","+        \"STATICLOOP_LINKER_MARKERS {\\n  global:\\n    _init;\\n    _fini;\\n    _edata;\\n    _end;\\n    __bss_start;\\n};\\n\",","     )","     .expect(\"write version script\");","     println!("]}],"userModified":false,"replaceAll":false}}
