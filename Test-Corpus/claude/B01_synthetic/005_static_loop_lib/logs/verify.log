iver share an internal `static int sum` that persists","+// across calls within a single library load. To keep the comparison deterministic,","+// we run everything in a single #[test] (single thread) and drive both libraries","+// with the same call sequence so their internal state evolves identically."," "," use libloading::{Library, Symbol};"," use std::os::raw::c_int;"]},{"oldStart":14,"oldLines":8,"newStart":19,"newLines":6,"lines":[" }"," "," fn rust_lib_path() -> PathBuf {","-    // Cargo always places integration test outputs alongside the cdylib in","-    // target/<profile>/. CARGO_MANIFEST_DIR + target/debug works for `cargo test`.","     let mut p = workspace_root();","     p.push(\"target\");","     p.push(\"debug\");"]},{"oldStart":23,"oldLines":58,"newStart":26,"newLines":12,"lines":["     p"," }"," ","-unsafe fn load_libs() -> (Library, Library) {","-    let c = Library::new(c_lib_path()).expect(\"failed to load C .so\");","-    let r = Library::new(rust_lib_path()).expect(\"failed to load Rust .so\");","-    (c, r)","-}","-","-#[test]","-fn static_sum_matches_for_sequence() {","-    unsafe {","-        let (c_lib, r_lib) = load_libs();","-        let c_sum: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> =","-            c_lib.get(b\"static_sum\").unwrap();","-        let r_sum: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> =","-            r_lib.get(b\"static_sum\").unwrap();","-","-        // Each library has its own internal static `sum` starting at 0.","-        // Drive them with the same sequence of updates and verify byte-equal results.","-        let updates: &[c_int] = &[","-            0, 1, 2, 3, 4, 5, -1, -2, 100, -50, 0, 7, 7, 7,","-            i32::MAX / 4, -(i32::MAX / 4), 0, 1, -1,","-        ];","-        for &u in updates {","-            let cv = c_sum(u);","-            let rv = r_sum(u);","-            assert_eq!(cv, rv, \"static_sum mismatch on update {}\", u);","-        }","-    }","-}","-","-#[test]","-fn static_sum_zero_rep