em with the same sequence of updates and verify byte-equal results.\n        let updates: &[c_int] = &[\n            0, 1, 2, 3, 4, 5, -1, -2, 100, -50, 0, 7, 7, 7,\n            i32::MAX / 4, -(i32::MAX / 4), 0, 1, -1,\n        ];\n        for &u in updates {\n            let cv = c_sum(u);\n            let rv = r_sum(u);\n            assert_eq!(cv, rv, \"static_sum mismatch on update {}\", u);\n        }\n    }\n}\n\n#[test]\nfn static_sum_zero_repeated() {\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_sum: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> =\n            c_lib.get(b\"static_sum\").unwrap();\n        let r_sum: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> =\n            r_lib.get(b\"static_sum\").unwrap();\n\n        for _ in 0..50 {\n            assert_eq!(c_sum(0), r_sum(0));\n        }\n    }\n}\n\n// Helper: redirect stdout while running closure, return captured bytes.\n// Uses dup/dup2 on FD 1 and reads from a pipe.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    use std::io::Read;\n    use std::os::unix::io::FromRawFd;\n\n    unsafe {\n        // Flush libc stdout buffers first.\n        libc::fflush(std::ptr::null_mut());\n\n        let saved = libc::dup(1);\n        assert!(saved >= 0, \"dup failed\");\n\n        let mut fds: [c_int; 2] = [0; 2];\n        let r = libc::pipe(fds.as_mut_ptr());\n        assert_eq!(r, 0, \"pipe failed\");\n\n        // Replace stdout with the write end.\n        let r = libc::dup2(fds[1], 1);\n        assert!(r >= 0, \"dup2 failed\");\n        libc::close(fds[1]);\n\n        f();\n\n        // Flush again so all printf output goes through pipe.\n        libc::fflush(std::ptr::null_mut());\n\n        // Restore real stdout.\n        libc::dup2(saved, 1);\n        libc::close(saved);\n\n        // Read everything from the pipe. Make sure we close it after to avoid hangs.\n        let mut file = std::fs::File::from_raw_fd(fds[0]);\n        let mut buf = Vec::new();\n        file.read_to_end(&mut buf).expect(\"read from pipe failed\");\n        buf\n    }\n}\n\n#[test]\nfn driver_output_matches() {\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_driver: Symbol<unsafe extern \"C\" fn(c_int)> =\n            c_lib.get(b\"driver\").unwrap();\n        let r_driver: Symbol<unsafe extern \"C\" fn(c_int)> =\n            r_lib.get(b\"driver\").unwrap();\n\n        // Each driver call uses static_sum internally with i*stride for i in 0..10.\n        // The static `sum` carries across calls and is independent per library.\n        for &stride in &[0, 1, 2, 3, -1, -5, 10, 100] {\n            let c_out = capture_stdout(|| c_driver(stride));\n            let r_out = capture_stdout(|| r_driver(stride));\n            assert_eq!(\n                c_out, r_out,\n                \"driver({}) output mismatch:\\n C: {:?}\\n R: {:?}\",\n                stride,\n                String::from_utf8_lossy(&c_out),\n                String::from_utf8_lossy(&r_out)\n            );\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
