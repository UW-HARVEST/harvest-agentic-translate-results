\"\n    FAIL=1\n  fi\n  echo\ndone\n\n# `default` is a distinct configuration even when it is empty/absent.\nprintf '==== %s (default features) ====\\n' \"${CMD[*]}\"\nif timeout 600 cargo \"${CMD[@]}\" --offline; then\n  echo \"PASS: default\"\nelse\n  echo \"FAIL: default\"\n  FAIL=1\nfi\n\nexit $FAIL\n","structuredPatch":[],"originalFile":null,"userModified":false}}
