{\n    if (len == 0) return 0;\n    int out[len];\n    int ones[len];\n    int zeros[len];\n\n    out[0] = 0;\n    for (int i = 0; i < len; i++) {\n        ones[i] = 1;\n        zeros[i] = 0;\n    }\n\n    fma_array(out, ones, data, zeros, len);\n    return out[len-1];\n}\n\nint main() {\n    int data[100];\n    int i;\n    for (i = 0; i < 100; i++) {\n        if (scanf(\"%d\", &data[i]) != 1) {\n            break;\n        }\n    }\n\n    int result = call_fma(data, i);\n    printf(\"%d\\n\", result);\n\n    return 0;\n}","numLines":61,"startLine":1,"totalLines":61}}}
