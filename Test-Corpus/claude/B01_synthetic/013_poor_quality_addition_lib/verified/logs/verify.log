ibrary.\n37\textern \"C\" {\n38\t    fn printf(format: *const c_char, ...) -> c_int;\n39\t}\n40\t\n41\t/// `void printLine(const char * line)`\n42\t///\n43\t/// Prints `line` followed by a newline; a NULL pointer prints nothing.\n44\t#[unsafe(no_mangle)]\n45\tpub unsafe extern \"C\" fn printLine(line: *const c_char) {\n46\t    if !line.is_null() {\n47\t        printf(c\"%s\\n\".as_ptr(), line);\n48\t    }\n49\t}\n50\t\n51\t/// `void printIntLine(int intNumber)`\n52\t#[unsafe(no_mangle)]\n53\tpub unsafe extern \"C\" fn printIntLine(int_number: c_int) {\n54\t    printf(c\"%d\\n\".as_ptr(), int_number);\n55\t}\n56\t\n57\t/// `void bad(void)`\n58\t///\n59\t/// Faithful translation of the original: the result of `intOne + intTwo` is\n60\t/// computed and then discarded (the C source has the bug that it never assigns\n61\t/// it to `intSum`), so `intSum` stays 0 for both prints. This behaviour is\n62\t/// intentionally preserved, not \"fixed\".\n63\t#[unsafe(no_mangle)]\n64\tpub unsafe extern \"C\" fn bad() {\n65\t    let int_one: c_int = 1;\n66\t    let int_two: c_int = 1;\n67\t    let int_sum: c_int = 0;\n68\t    printIntLine(int_sum);\n69\t    let _ = int_one.wrapping_add(int_two); // value discarded, exactly as in C\n70\t    printIntLine(int_sum);\n71\t}\n72\t\n73\t/// `void good(void)`\n74\t#[unsafe(no_mangle)]\n75\tpub unsafe extern \"C\" fn good() {\n76\t    let int_one: c_int = 1;\n77\t    let int_two: c_int = 1;\n78\t    let mut int_sum: c_int = 0;\n79\t    printIntLine(int_sum);\n80\t    int_sum = int_one.wrapping_add(int_two);\n81\t    printIntLine(int_sum);\n82\t}\n83\t\n84\t/// `void driver(void)` — the library's documented entry point (driver.h).\n85\t#[unsafe(no_mangle)]\n86\tpub unsafe extern \"C\" fn driver() {\n87\t    printLine(c\"Calling good()...\".as_ptr());\n88\t    good();\n89\t    printLine(c\"Finished good()\".as_ptr());\n90\t    printLine(c\"Calling bad()...\".as_ptr());\n91\t    bad();\n92\t    printLine(c\"Finished bad()\".as_ptr());\n93\t}\n9