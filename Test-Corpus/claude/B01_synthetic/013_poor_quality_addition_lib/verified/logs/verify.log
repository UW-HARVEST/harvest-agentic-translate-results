(\"\\n{} total checks, {} failures\", cs.checks, cs.failures.len());\n    if !cs.failures.is_empty() {\n        for f in &cs.failures {\n            eprintln!(\"{f}\");\n        }\n        panic!(\"{} differential check(s) failed\", cs.failures.len());\n    }\n    eprintln!(\"ALL DIFFERENTIAL CHECKS PASSED\");\n}\n\n/// Records which cargo features the binary was built with, so the report shows it.\nconst FEATURES: &str = \"<none: the crate declares no [features]; single configuration>\";\n","structuredPatch":[{"oldStart":62,"oldLines":8,"newStart":62,"newLines":9,"lines":["     fn printable_ascii(&mut self) -> u8 {","         (self.range(0x20, 0x7E)) as u8","     }","-    fn pick<'a, T>(&mut self, items: &'a [T]) -> &'a T {","-        &items[self.range(0, items.len() as u64 - 1) as usize]","+    /// random index in `0..len`","+    fn idx(&mut self, len: usize) -> usize {","+        (self.next_u64() % len as u64) as usize","     }"," }"," "]}],"userModified":false,"replaceAll":false}}
