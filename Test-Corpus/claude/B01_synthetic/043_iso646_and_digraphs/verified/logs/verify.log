OnceLock<()> = OnceLock::new();\n    let p = Path::new(env!(\"CARGO_BIN_EXE_driver\"));\n    CHECKED.get_or_init(|| assert_fresh(p, &[\"src/lib.rs\", \"src/main.rs\", \"Cargo.toml\"]));\n    p\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3214,"cache_read_input_tokens":152241,"cache_creation":{"ephemeral_5m_input_tokens":3214,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6c25b394-7046-4ff6-8cec-46c32ba03643","uuid":"c49ca698-0914-4531-8589-fccafa7b4903","timestamp":"2026-08-18T13:54:49.625Z"}
