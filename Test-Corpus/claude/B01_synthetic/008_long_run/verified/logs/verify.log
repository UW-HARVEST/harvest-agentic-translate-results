unit (`c_src/src/main.c`) into\n//! shared objects so the differential test-suite can dlopen it next to\n//! `libdriver.so`.\n//!\n//! Two shared objects are produced, one per optimisation level, because the\n//! C program's arithmetic relies on signed overflow / negative shifts and we\n//! want to prove the Rust port matches gcc at both `-O0` (what\n//! `c_src/CMakeLists.txt` produces by default) and `-O2`.\n//!\n//! Nothing in `c_src/` is modified: every artefact lands in `OUT_DIR`.\n\nuse std::path::{Path, PathBuf};\nuse std::process::Command;\n\nfn main() {\n    let manifest_dir = PathBuf::from(std::env::var(\"CARGO_MANIFEST_DIR\").unwrap());\n    let c_source = manifest_dir.join(\"c_src/src/main.c\");\n    let out_dir = PathBuf::from(std::env::var(\"OUT_DIR\").unwrap());\n\n    println!(\"cargo:rerun-if-changed={}\", c_source.display());\n    println!(\"cargo:rerun-if-changed=build.rs\");\n\n    if !c_source.exists() {\n        // Nothing to do (e.g. packaged build without the C sources).\n        println!(\"cargo:warning=missing {}\", c_source.display());\n        return;\n    }\n\n    for opt in [\"0\", \"2\"] {\n        let so = out_dir.join(format!(\"libc_driver_O{opt}.so\"));\n        build_so(&c_source, &so, opt);\n        println!(\n            \"cargo:rustc-env=C_DRIVER_SO_O{opt}={}\",\n            so.display()\n        );\n    }\n}\n\nfn build_so(c_source: &Path, so: &Path, opt_level: &str) {\n    let cc = std::env::var(\"CC\").unwrap_or_else(|_| \"cc\".to_string());\n    let status = Command::new(&cc)\n        .args([\"-shared\", \"-fPIC\"])\n        .arg(format!(\"-O{opt_level}\"))\n        .arg(\"-o\")\n        .arg(so)\n        .arg(c_source)\n        .status()\n        .unwrap_or_else(|e| panic!(\"failed to run {cc}: {e}\"));\n    assert!(status.success(), \"{cc} failed to build {}\", so.display());\n}\n","structuredPatch":[{"oldStart":33,"oldLines":9,"newStart":33,"newLines":27,"lines":["             \"cargo:rustc-env=C_DRIVER_SO_O{opt}={}\",","             so.display()","         );","+","+        // ...and the executable, exactly what `c_src/CMakeLists.txt` builds, so","+        // the tests can also compare the two programs as processes.","+        let exe = out_dir.join(format!(\"c_driver_O{opt}\"));","+        build_exe(&c_source, &exe, opt);","+        println!(\"cargo:rustc-env=C_DRIVER_BIN_O{opt}={}\", exe.display());","     }"," }"," ","+fn build_exe(c_source: &Path, exe: &Path, opt_level: &str) {","+    let cc = std::env::var(\"CC\").unwrap_or_else(|_| \"cc\".to_string());","+    let status = Command::new(&cc)","+        .arg(format!(\"-O{opt_level}\"))","+        .arg(\"-o\")","+        .arg(exe)","+        .arg(c_source)","+        .status()","+        .unwrap_or_else(|e| panic!(\"failed to run {cc}: {e}\"));","+    assert!(status.success(), \"{cc} failed to build {}\", exe.display());","+}","+"," fn build_so(c_source: &Path, so: &Path, opt_level: &str) {","     let cc = std::env::var(\"CC\").unwrap_or_else(|_| \"cc\".to_string());","     let status = Command::new(&cc)"]}],"userModified":false,"replaceAll":false}}
