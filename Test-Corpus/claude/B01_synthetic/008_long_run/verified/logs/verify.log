tderr.is_empty());\n\n        for c in p.c.iter().filter(|c| want_impls.split(',').any(|w| w == c.name)) {\n            let t0 = std::time::Instant::now();\n            let got = common::run_main(c, 2, &argv);\n            eprintln!(\n                \"{:5} seed {seed}: {} ({:?})\",\n                c.name,\n                got.describe(),\n                t0.elapsed()\n            );\n            assert_eq!(\n                (got.status, &got.stdout, &got.stderr),\n                (rust.status, &rust.stdout, &rust.stderr),\n                \"full end-to-end mismatch for seed {seed}: {} gave [{}], rust gave [{}]\",\n                c.name,\n                got.describe(),\n                rust.describe()\n            );\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4723,"cache_read_input_tokens":127221,"cache_creation":{"ephemeral_5m_input_tokens":4723,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"994a44c2-98b6-4b9c-a7a9-508ed4953b92","uuid":"4eb0e37d-c835-401c-8c3d-2488aecb8d72","timestamp":"2026-08-17T23:43:01.089Z"}
