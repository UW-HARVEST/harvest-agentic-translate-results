              *out_seed = seed;\n            }\n            0\n        }\n        None => 1,\n    }\n}\n\n/// `ARRAY_SIZE` / `ITERATIONS` as compiled into this library, so the test-suite\n/// can assert they match the C `#define`s.\n#[no_mangle]\npub extern \"C\" fn harness_array_size() -> usize {\n    program::ARRAY_SIZE\n}\n\n#[no_mangle]\npub extern \"C\" fn harness_iterations() -> usize {\n    program::ITERATIONS\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2978,"cache_read_input_tokens":67653,"cache_creation":{"ephemeral_5m_input_tokens":2978,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"994a44c2-98b6-4b9c-a7a9-508ed4953b92","uuid":"590af37a-5dbe-4ca7-97cf-69c3878d614e","timestamp":"2026-08-17T23:32:08.651Z"}
