();\n    }\n    0\n}\n","structuredPatch":[{"oldStart":5,"oldLines":8,"newStart":5,"newLines":12,"lines":[" // and compare behavior byte-for-byte."," "," use std::ffi::CStr;","-use std::io::{self, Read, Write};","-use std::os::raw::{c_char, c_int};","+use std::io::{self, Write};","+#[cfg(not(test))]","+use std::io::Read;","+use std::os::raw::c_char;","+#[cfg(not(test))]","+use std::os::raw::c_int;"," "," /// C: `void printLine(const char *line)`"," /// Prints `line` followed by a newline if `line` is non-null."]}],"userModified":false,"replaceAll":false}}
