nt\\(input\\) \\{\\n        x = v;\\n    \\}/x = scanf_int(input).unwrap_or(-1);/'\n\nmutate \"the SIGPIPE disposition is left as Rust\\x27s SIG_IGN\" \\\n  err_stdout_broken_pipe src/main.rs \\\n  's/        signal\\(SIGPIPE, SIG_DFL\\);//'\n\nrestore\ncargo build --offline >/dev/null 2>&1\necho\necho \"caught $pass / $((pass+fail)) injected bugs\"\n[ \"$fail\" -eq 0 ] || exit 1\necho \"OK: the suite detects every injected bug\"\n","structuredPatch":[],"originalFile":null,"userModified":false}}
