\t\n123\t    let mut img = [0u8; N];\n124\t    memcpy(\n125\t        img.as_mut_ptr() as *mut c_void,\n126\t        foo as *const c_void,\n127\t        N,\n128\t    );\n129\t\n130\t    let bits = img[0];\n131\t    let z = c_int::from_ne_bytes([img[Z], img[Z + 1], img[Z + 2], img[Z + 3]]);\n132\t    // Delegate to C's printf so the emitted bytes and the stdio buffering\n133\t    // behaviour are identical to the original library's.\n134\t    printf(\n135\t        b\"%u %u %d %d\\n\\0\".as_ptr() as *const c_char,\n136\t        foo_x(bits),\n137\t        foo_y(bits),\n138\t        foo_b(bits),\n139\t        z,\n140\t    );\n141\t}\n142\t\n143\t/// ```c\n144\t/// void driver(unsigned int x, unsigned int y, bool b, int z) {\n145\t///     foo_t foo = {.x = x, .y = y, .b = b, .z = z};\n146\t///     print_foo(&foo);\n147\t/// }\n148\t/// ```\n149\t///\n150\t/// Storing into the bit-fields truncates each value to the field width, which\n151\t/// is reproduced here by masking:\n152\t///   * `x` keeps its low 2 bits,\n153\t///   * `y` keeps its low 3 bits,\n154\t///   * `b` keeps its low bit — GCC assumes a `_Bool` argument is already 0 or\n155\t///     1 and simply masks bit 0 (`andl $1`) rather than testing for non-zero,\n156\t///     so a byte such as 2 lands in the field as 0. `b` is taken as a `u8`\n157\t///     here (identical to `_Bool`'s ABI: one byte in the argument register)\n158\t///     so that out-of-range values reproduce the C behaviour instead of\n159\t///     being undefined as they would be for a Rust `bool`.\n160\t///\n161\t/// The two padding bits of the storage unit are left as-is by the C\n162\t/// initializer (it or-s into whatever the stack held); they are never read\n163\t/// back, so their value is immaterial. They are zeroed here.\n164\t#[unsafe(no_mangle)]\n165\tpub unsafe extern \"C\" fn driver(x: c_uint, y: c_uint, b: u8, z: c_int) {\n166\t    let bits = ((x as u8) & 0x3) | (((y as u8) & 0x7) << 2) | ((b & 0x1) << 5);\n167\t    let foo = foo_t {\n