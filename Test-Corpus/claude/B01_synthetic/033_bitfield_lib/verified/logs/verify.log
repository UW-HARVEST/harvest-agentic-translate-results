unsafe { fork() };\n    assert!(pid >= 0, \"fork failed\");\n    if pid == 0 {\n        // Child: perform the call, then leave without running any at-exit\n        // handlers or flushing shared buffers.\n        f();\n        unsafe { _exit(0) };\n    }\n    let mut status: c_int = 0;\n    let r = unsafe { waitpid(pid, &mut status, 0) };\n    assert_eq!(r, pid, \"waitpid failed\");\n    // Decode wait status without pulling in the libc crate.\n    if status & 0x7f == 0x7f {\n        ChildOutcome::Signaled(-1) // stopped; not expected here\n    } else if status & 0x7f != 0 {\n        ChildOutcome::Signaled(status & 0x7f)\n    } else {\n        ChildOutcome::Exited((status >> 8) & 0xff)\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":725,"cache_read_input_tokens":44514,"cache_creation":{"ephemeral_5m_input_tokens":725,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d3d04f41-b20c-47bc-b061-46285585259e","uuid":"7b78aa53-109e-45f9-ada9-48c61759834f","timestamp":"2026-08-18T09:17:15.901Z"}
