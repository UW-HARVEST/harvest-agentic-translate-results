ver_large_negative() {\n    assert_match(-2_000_000_000);\n}\n\n#[test]\nfn driver_max() {\n    assert_match(c_int::MAX);\n}\n\n#[test]\nfn driver_min() {\n    assert_match(c_int::MIN);\n}\n\n#[test]\nfn driver_arbitrary() {\n    assert_match(12345);\n    assert_match(-9876);\n    assert_match(0xCAFE);\n    assert_match(0x55_55_55_55);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":142,"cache_read_input_tokens":20428,"cache_creation":{"ephemeral_5m_input_tokens":142,"ephemeral_1h_input_tokens":0},"output_tokens":31,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"4b06f628-bbec-48a1-84dc-cb05637fad7f","uuid":"4c279fcc-0f6e-429c-9daf-227182eebdfa"}
