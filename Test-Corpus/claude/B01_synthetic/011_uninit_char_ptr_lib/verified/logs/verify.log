t_missing_null_guard_is_detected() {\n    // Removing the guard makes printLine(NULL) print \"(null)\" under glibc\n    // instead of nothing, which ERRORS.md row 1 must catch.\n    let so = build_mutant(\"noguard\", \"if (line != NULL)\", \"if (1)\");\n    let mutant = Impl::load(&so, \"C-mutant(no NULL guard)\");\n\n    assert!(\n        detects_divergence(&mutant, rust(), |imp| imp.print_line(std::ptr::null())),\n        \"harness FAILED to detect removal of the NULL guard\"\n    );\n\n    // Non-NULL inputs stay identical, confirming the mutation is targeted.\n    let buf = cstr(b\"still-fine\");\n    assert!(\n        !detects_divergence(&mutant, rust(), |imp| {\n            imp.print_line(buf.as_ptr() as *const c_char)\n        }),\n        \"no-guard mutant should still agree on non-NULL input\"\n    );\n}\n\n// ---------------------------------------------------------------------------\n// Mutation 4: swapped good/bad branches\n// ---------------------------------------------------------------------------\n\n#[test]\nfn mutant_swapped_branches_is_detected() {\n    let so = build_mutant(\n        \"swap\",\n        \"    if (useGood)\\n    {\\n        good();\\n    }\\n    else\\n    {\\n        bad();\\n    }\",\n        \"    if (useGood)\\n    {\\n        bad();\\n    }\\n    else\\n    {\\n        good();\\n    }\",\n    );\n    let mutant = Impl::load(&so, \"C-mutant(swapped branches)\");\n\n    assert!(\n        detects_divergence(&mutant, rust(), |imp| imp.driver(1)),\n        \"harness FAILED to detect swapped good()/bad() branches\"\n    );\n}\n","structuredPatch":[{"oldStart":155,"oldLines":11,"newStart":155,"newLines":30,"lines":[" // ---------------------------------------------------------------------------"," "," #[test]","-fn mutant_missing_null_guard_is_detected() {","-    // Removing the guard makes printLine(NULL) print \"(null)\" under glibc","-    // instead of nothing, which ERRORS.md row 1 must catch.","-    let so = build_mutant(\"nogua