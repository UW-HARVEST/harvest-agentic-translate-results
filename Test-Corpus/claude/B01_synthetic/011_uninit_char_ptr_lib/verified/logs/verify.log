}\n55\t\n56\t/// C:\n57\t/// ```c\n58\t/// void bad()\n59\t/// {\n60\t///     char *data;\n61\t///     printLine(data);\n62\t/// }\n63\t/// ```\n64\t///\n65\t/// `data` is never initialised in the C source: this is the intentional defect\n66\t/// (use of an uninitialised variable). The bug is *not* fixed here. Reading the\n67\t/// uninitialised object is undefined behaviour in C, and there is no way to\n68\t/// reproduce indeterminate stack residue deterministically. Every optimising\n69\t/// build of the original translation unit (gcc `-O1`, `-O2`, `-O3`, `-Os`)\n70\t/// resolves the uninitialised pointer to a null pointer and therefore calls\n71\t/// `printLine(NULL)`, which prints nothing; that observable behaviour is what\n72\t/// is reproduced. The defective call to `printLine` with an uninitialised\n73\t/// (null) pointer is preserved rather than removed or \"corrected\".\n74\t#[unsafe(no_mangle)]\n75\tpub unsafe extern \"C\" fn bad() {\n76\t    // char *data;  /* deliberately left uninitialised in the C original */\n77\t    let data: *const c_char = ptr::null();\n78\t    unsafe {\n79\t        printLine(data);\n80\t    }\n81\t}\n82\t\n83\t/// C:\n84\t/// ```c\n85\t/// void good()\n86\t/// {\n87\t///     char *data;\n88\t///     data = \"string\";\n89\t///     printLine(data);\n90\t/// }\n91\t/// ```\n92\t#[unsafe(no_mangle)]\n93\tpub unsafe extern \"C\" fn good() {\n94\t    let data: *const c_char = GOOD_STRING.as_ptr() as *const c_char;\n95\t    unsafe {\n96\t        printLine(data);\n97\t    }\n98\t}\n99\t\n100\t/// C:\n101\t/// ```c\n102\t/// void driver(int useGood)\n103\t/// {\n104\t///     if (useGood)\n105\t///     {\n106\t///         good();\n107\t///     }\n108\t///     else\n109\t///     {\n110\t///         bad();\n111\t///     }\n112\t/// }\n113\t/// ```\n114\t#[unsafe(no_mangle)]\n115\tpub unsafe extern \"C\" fn driver(useGood: c_int) {\n116\t    unsafe {\n117\t        if useGood != 0 {\n118\t            good();\n119\t        } else {\n120\t       