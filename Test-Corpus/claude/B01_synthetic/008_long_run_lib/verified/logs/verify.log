char, ...) -> c_int;\n43\t}\n44\t\n45\t// ---------------------------------------------------------------------------\n46\t// Global array\n47\t// ---------------------------------------------------------------------------\n48\t//\n49\t// `int array[ARRAY_SIZE];` — a tentative definition at file scope with external\n50\t// linkage, so it is an exported (`B`, i.e. `.bss`) symbol of the shared object.\n51\t\n52\t#[unsafe(no_mangle)]\n53\tpub static mut array: [c_int; ARRAY_SIZE] = [0; ARRAY_SIZE];\n54\t\n55\t/// The body of the innermost `for (int j = 0; j < 100; j++)` loop of\n56\t/// `perform_expensive_operations`.\n57\t///\n58\t/// The C code relies on wrapping signed arithmetic (`x * 3 + 7`, `x << 1`,\n59\t/// `x - ...`), which is technically undefined behaviour in C but is compiled by\n60\t/// gcc/clang into plain two's-complement wrapping instructions.  The wrapping\n61\t/// operators below reproduce exactly what the C library does at runtime.\n62\t/// Likewise `x >> 3` is an arithmetic (sign-propagating) shift, and `x / 2` /\n63\t/// `x % 7` truncate towards zero — identical semantics in Rust.\n64\t#[inline(always)]\n65\tfn mix(mut x: c_int) -> c_int {\n66\t    let mut j: c_int = 0;\n67\t    while j < 100 {\n68\t        // x = x * 3 + 7;\n69\t        x = x.wrapping_mul(3).wrapping_add(7);\n70\t        // x = x ^ (x >> 3);\n71\t        x ^= x >> 3;\n72\t        // x = x - (x << 1);\n73\t        x = x.wrapping_sub(x.wrapping_shl(1));\n74\t        // x = x / 2 + x % 7;\n75\t        x = (x / 2).wrapping_add(x % 7);\n76\t        j += 1;\n77\t    }\n78\t    x\n79\t}\n80\t\n81\t/// `void perform_expensive_operations()`\n82\t///\n83\t/// Perform expensive arithmetic on each element of the global `array`.\n84\t#[unsafe(no_mangle)]\n85\tpub extern \"C\" fn perform_expensive_operations() {\n86\t    // SAFETY: `array` is a plain global with static storage duration, exactly as\n87\t    // in the C original, which is single-threaded with respect to this access.\n88\t    let 