           break;\n            }\n            match input.read(&mut byte) {\n                Ok(0) => break, // EOF\n                Ok(_) => {\n                    buf.push(byte[0]);\n                    if byte[0] == b'\\n' {\n                        break;\n                    }\n                }\n                Err(_) => break,\n            }\n        }\n\n        // fgets returns NULL if nothing was read; mirror that to break the loop.\n        if buf.is_empty() {\n            break;\n        }\n\n        // fputs: write the bytes (no added newline).\n        if output.write_all(&buf).is_err() {\n            break;\n        }\n    }\n\n    // Match C's implicit fflush at exit.\n    let _ = output.flush();\n}\n","structuredPatch":[{"oldStart":41,"oldLines":8,"newStart":41,"newLines":12,"lines":["             break;","         }"," ","-        // fputs: write the bytes (no added newline).","-        if output.write_all(&buf).is_err() {","+        // fputs: write bytes up to (but not including) the first NUL.","+        // fgets stores a terminating NUL after the read bytes, and fputs","+        // stops at the first NUL it encounters, so embedded NULs in the","+        // input truncate the output for that fgets chunk.","+        let end = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());","+        if output.write_all(&buf[..end]).is_err() {","             break;","         }","     }"]}],"userModified":false,"replaceAll":false}}
