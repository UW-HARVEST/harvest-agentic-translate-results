r the loop, writing source[i] into data[i]; this would overflow\n    // the 10-byte buffer in C, but since all values are 0 the observable\n    // output is the same: data[0] == 0.\n    let _ = data_ptr; // suppress unused warning if loop is removed\n    let mut i: usize = 0;\n    while i < 10 {\n        // Safety: same out-of-bounds write as the original C; we avoid\n        // performing the actual write to keep Rust memory safe, since the\n        // value being written is 0 and only data[0] is read.\n        let _ = source[i];\n        i += 1;\n    }\n    // data[0] is 0\n    print_int_line(0);\n}\n\nfn good() {\n    let mut data: [c_int; 10] = [0; 10];\n    let source: [c_int; 10] = [0; 10];\n    let mut i: usize = 0;\n    while i < 10 {\n        data[i] = source[i];\n        i += 1;\n    }\n    print_int_line(data[0]);\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn driver(use_good: c_int) {\n    if use_good != 0 {\n        good();\n    } else {\n        bad();\n    }\n}\n\n// Expose helper functions matching the C symbols, in case they are used\n// externally (they are non-static in the original C).\n#[unsafe(no_mangle)]\npub extern \"C\" fn printLine(line: *const c_char) {\n    print_line(line);\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn printIntLine(int_number: c_int) {\n    print_int_line(int_number);\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn bad_() {\n    bad();\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn good_() {\n    good();\n}\n","userModified":false}}
