  b'B' as c_char,\n        b'a' as c_char,\n        b'd' as c_char,\n        b' ' as c_char,\n        b's' as c_char,\n        b't' as c_char,\n        b'r' as c_char,\n        b'i' as c_char,\n        b'n' as c_char,\n        b'g' as c_char,\n        0,\n    ];\n    char_string.as_mut_ptr()\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn bad() {\n    printLine(helper_bad());\n}\n\n/// Returns a pointer to a static (program-lifetime) C string.\nfn helper_good1() -> *mut c_char {\n    static CHAR_STRING: [u8; 19] = *b\"helperGood1 string\\0\";\n    CHAR_STRING.as_ptr() as *mut c_char\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn good() {\n    printLine(helper_good1());\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn driver(use_good: c_int) {\n    if use_good != 0 {\n        good();\n    } else {\n        bad();\n    }\n}\n\n// The C shared library, when linked through GCC's crti.o/crtn.o, exports the\n// standard ELF `_init` and `_fini` symbols as no-op stubs. Rust's cdylib does\n// not link those CRT files, so we emit our own stubs here to keep the\n// exported symbol set identical to the C .so.\n#[unsafe(no_mangle)]\npub extern \"C\" fn _init() {}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn _fini() {}\n","structuredPatch":[{"oldStart":71,"oldLines":12,"newStart":71,"newLines":3,"lines":["     }"," }"," ","-// The C shared library, when linked through GCC's crti.o/crtn.o, exports the","-// standard ELF `_init` and `_fini` symbols as no-op stubs. Rust's cdylib does","-// not link those CRT files, so we emit our own stubs here to keep the","-// exported symbol set identical to the C .so.","-#[unsafe(no_mangle)]","-pub extern \"C\" fn _init() {}","-","-#[unsafe(no_mangle)]","-pub extern \"C\" fn _fini() {}"]}],"userModified":false,"replaceAll":false}}
