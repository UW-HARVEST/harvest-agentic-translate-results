saturating_not_wrapping|s/\\.wrapping_add(extra_bedrooms)/.saturating_add(extra_bedrooms)/\"\n  \"bathrooms_precision_2f|s/%\\.1f/%.2f/\"\n  \"drop_int_max_upper_bound|s/tmp <= c_int::MAX as c_long/true/\"\n  \"drop_int_min_lower_bound|s/tmp >= c_int::MIN as c_long/true/\"\n  \"drop_errno_check|s/errno_get() == 0/true/\"\n  \"drop_no_conversion_check|s/endp != str as \\*mut c_char/true/\"\n  \"floors_increment_by_two|s/(\\*house)\\.floors\\.wrapping_add(1)/(*house).floors.wrapping_add(2)/\"\n  \"initial_bathrooms_2_0|s/bathrooms: 2\\.5/bathrooms: 2.0/\"\n  \"strtol_base_16|s/strtol(str, &mut endp, 10)/strtol(str, \\&mut endp, 16)/\"\n  \"bathrooms_increment_half|s/\\.bathrooms += 1\\.0/.bathrooms += 0.5/\"\n  \"int_max_bound_off_by_one|s/tmp <= c_int::MAX as c_long/tmp <= c_int::MAX as c_long + 1/\"\n  \"run_once_in_driver|s/^        run(x);\\n        run(x);/        run(x);/\"\n)\n\nprintf '%-34s %-8s %s\\n' \"MUTATION\" \"RESULT\" \"DETAIL\"\nprintf '%.0s-' {1..90}; echo\n\nfor entry in \"${MUTATIONS[@]}\"; do\n  name=\"${entry%%|*}\"\n  expr=\"${entry#*|}\"\n  restore\n  perl -0pi -e \"$expr\" src/lib.rs\n  if cmp -s src/lib.rs \"$ORIG\"; then\n    printf '%-34s %-8s %s\\n' \"$name\" \"SKIP\" \"sed matched nothing (mutation not applied)\"\n    FAIL=1\n    continue\n  fi\n  if ! cargo build --offline >\"$WORK/b.log\" 2>&1; then\n    printf '%-34s %-8s %s\\n' \"$name\" \"SKIP\" \"mutated code does not compile\"\n    continue\n  fi\n  if cargo test --offline >\"$WORK/t.log\" 2>&1 -- --test-threads=1; then\n    printf '%-34s %-8s %s\\n' \"$name\" \"MISSED\" \"suite PASSED despite the injected bug <<< BLIND SPOT\"\n    FAIL=1\n  else\n    n=$(grep -cE '^test .* FAILED$' \"$WORK/t.log\")\n    first=$(grep -oE '^test [a-z0-9_]+ \\.\\.\\. FAILED$' \"$WORK/t.log\" | head -1 | awk '{print $2}')\n    printf '%-34s %-8s %s\\n' \"$name\" \"CAUGHT\" \"$n test(s) failed, e.g. $first\"\n  fi\ndone\n\nrestore\ncargo build --offline >/dev/null 2>&1\n\nprintf '%.0s-' {1..90}; echo\nif [ \"$FAIL\" -eq 0 ]; then\n  echo \"All mutations were CAUGHT: the differential suite has teeth.\"\nelse\n  echo \"At least one mutation was MISSED or not applied — see above.\"\nfi\necho \"src/lib.rs restored (diff vs original should be empty):\"\ndiff \"$ORIG\" src/lib.rs && echo \"  clean\"\nexit \"$FAIL\"\n","userModified":false}}
