n    pos: usize,\n    /// Number of valid bytes in `buf`.\n    len: usize,\n    eof: bool,\n}\n\nimpl CStdin {\n    fn new() -> Self {\n        // Safety: fd 0 stays open for the whole program and `ManuallyDrop`\n        // keeps this wrapper from closing it.\n        let file = ManuallyDrop::new(unsafe { File::from_raw_fd(0) });\n        let size = match file.metadata() {\n            Ok(md) => {\n                let bs = md.blksize() as usize;\n                if bs > 0 && bs < BUFSIZ {\n                    bs\n                } else {\n                    BUFSIZ\n                }\n            }\n            // Not stat-able (e.g. fd 0 closed): glibc keeps BUFSIZ.\n            Err(_) => BUFSIZ,\n        };\n        CStdin {\n            file,\n            buf: vec![0u8; size],\n            pos: 0,\n            len: 0,\n            eof: false,\n        }\n    }\n\n    /// Returns the next byte of the stream, or None at end-of-file / read error\n    /// (glibc reports both as a `scanf` input failure).\n    fn next_byte(&mut self) -> Option<u8> {\n        while self.pos == self.len {\n            if self.eof {\n                return None;\n            }\n            match self.file.read(&mut self.buf) {\n                Ok(0) => {\n                    self.eof = true;\n                    self.pos = 0;\n                    self.len = 0;\n                    return None;\n                }\n                Ok(n) => {\n                    self.pos = 0;\n                    self.len = n;\n                }\n                Err(ref e) if e.kind() == std::io::ErrorKind::Interrupted => continue,\n                Err(_) => {\n                    self.eof = true;\n                    self.pos = 0;\n                    self.len = 0;\n                    return None;\n                }\n            }\n        }\n        let b = self.buf[self.pos];\n        self.pos += 1;\n        Some(b)\n    }\n\n    /// Equivalent of glibc pushing the read pointer back by one byte, which i