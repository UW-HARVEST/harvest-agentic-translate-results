{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RmkjGshQDHo4fn6LjDhK3f","type":"tool_result","content":"1\t// Rust translation of c_src/src/main.c\n2\t//\n3\t// Behaviour is preserved byte-for-byte, including the C library semantics of\n4\t// fgets() and strtol() that the original program relies on.\n5\t//\n6\t// This module holds the actual translation.  It is shared verbatim by\n7\t// `src/main.rs` (the `driver` executable) and by `src/lib.rs` (the cdylib that\n8\t// exports the same C ABI symbols as the C translation unit: `run` and `main`).\n9\t\n10\tuse std::io::{self, Read, Write};\n11\t\n12\t#[repr(C)]\n13\t#[derive(Clone, Copy)]\n14\tpub struct House {\n15\t    pub floors: i32,\n16\t    pub bedrooms: i32,\n17\t    pub bathrooms: f64,\n18\t}\n19\t\n20\tfn add_floor(house: &mut House) {\n21\t    // house->floors++\n22\t    house.floors = house.floors.wrapping_add(1);\n23\t}\n24\t\n25\tfn add_bedrooms(house: &mut House, extra_bedrooms: i32) {\n26\t    // house->bedrooms += extra_bedrooms\n27\t    house.bedrooms = house.bedrooms.wrapping_add(extra_bedrooms);\n28\t}\n29\t\n30\tfn print_house<W: Write>(out: &mut W, house: &House) {\n31\t    // printf(\"The house has %d floors, %d bedrooms, and %.1f bathrooms\\n\", ...)\n32\t    let _ = write!(\n33\t        out,\n34\t        \"The house has {} floors, {} bedrooms, and {} bathrooms\\n\",\n35\t        house.floors,\n36\t        house.bedrooms,\n37\t        format_f64_1(house.bathrooms)\n38\t    );\n39\t}\n40\t\n41\tpub fn run<W: Write>(out: &mut W, the_house: &mut House, extra_bedrooms: i32) {\n42\t    print_house(out, the_house);\n43\t    add_floor(the_house);\n44\t    print_house(out, the_house);\n45\t    the_house.bathrooms += 1.0;\n46\t    print_house(out, the_house);\n47\t    add_bedrooms(the_house, extra_bedrooms);\n48\t    print_house(out, the_house);\n49\t}\n50\t\n51\t/// Formats a finite double the way C's `printf(\"%.1f\", v)` would.\n52\tfn format_f64_1(v: f64) -> String {\n53\t    if v.is_nan() {\n54\t        // glibc prints \"nan\" / \"-nan\"\n55\t        return if v.is_sign_negative() {\n56\t            \"-nan\".to_string()\n57\t        } else {\n58\t            \"nan\".to_string()\n59\t        };\n60\t    }\n61\t    if v.is_infinite() {\n62\t        return if v < 0.0 {\n63\t            \"-inf\".to_string()\n64\t        } else {\n65\t            \"inf\".to_string()\n66\t        };\n67\t    }\n68\t    // Rust's {:.1} rounds half away from zero on the exact decimal value of the\n69\t    // double, which matches glibc's correctly-rounded output except for exact\n70\t    // ties; handle the tie case with round-half-to-even like glibc.\n71\t    let scaled = v * 10.0;\n72\t    if scaled == scaled.trunc() && scaled.abs() < 9.007_199_254_740_992e15 {\n73\t        // Exact one-decimal value: no rounding needed at all.\n74\t        let neg = scaled < 0.0 || (scaled == 0.0 && v.is_sign_negative());\n75\t        let units = scaled.abs() as u64;\n76\t        let s = format!(\"{}.{}\", units / 10, units % 10);\n77\t        return if neg { format!(\"-{}\", s) } else { s };\n78\t    }\n79\t    format!(\"{:.1}\", v)\n80\t}\n81\t\n82\t/// Emulates `strtol(str, &endp, 10)` for the subset needed here.\n83\t/// Returns (value, number_of_bytes_consumed, erange).\n84\tfn strtol10(s: &[u8]) -> (i64, usize, bool) {\n85\t    let mut i = 0usize;\n86\t    // Skip leading whitespace (isspace in the \"C\" locale).\n87\t    while i < s.len()\n88\t        && matches!(s[i], b' ' | b'\\t' | b'\\n' | b'\\x0b' | b'\\x0c' | b'\\r')\n89\t    {\n90\t        i += 1;\n91\t    }\n92\t    let mut negative = false;\n93\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n94\t        negative = s[i] == b'-';\n95\t        i += 1;\n96\t    }\n97\t    let digits_start = i;\n98\t    let mut acc: i128 = 0;\n99\t    let mut overflow = false;\n100\t    while i < s.len() && s[i].is_ascii_digit() {\n101\t        let d = (s[i] - b'0') as i128;\n102\t        if !overflow {\n103\t            acc = acc * 10 + d;\n104\t            if acc > (i64::MAX as i128) + 1 {\n105\t                overflow = true;\n106\t            }\n107\t        }\n108\t        i += 1;\n109\t    }\n110\t    if i == digits_start {\n111\t        // No conversion performed: endptr is set to the original string.\n112\t        return (0, 0, false);\n113\t    }\n114\t    let signed: i128 = if negative { -acc } else { acc };\n115\t    if overflow || signed > i64::MAX as i128 || signed < i64::MIN as i128 {\n116\t        let clamped = if negative { i64::MIN } else { i64::MAX };\n117\t        return (clamped, i, true);\n118\t    }\n119\t    (signed as i64, i, false)\n120\t}\n121\t\n122\tfn parse_val(str_bytes: &[u8], val: &mut i32) -> bool {\n123\t    // errno = 0; strtol(str, &endp, 10);\n124\t    let (tmp, consumed, erange) = strtol10(str_bytes);\n125\t    let endp_moved = consumed != 0; // endp != str\n126\t    if endp_moved && !erange && tmp >= i32::MIN as i64 && tmp <= i32::MAX as i64 {\n127\t        *val = tmp as i32;\n128\t        true\n129\t    } else {\n130\t        false\n131\t    }\n132\t}\n133\t\n134\t/// Emulates `fgets(in, sizeof(in), stdin)` with a 100-byte buffer that was\n135\t/// initialised to all zero bytes.  Returns the buffer contents.\n136\tfn fgets(buf: &mut [u8]) {\n137\t    let cap = buf.len();\n138\t    if cap == 0 {\n139\t        return;\n140\t    }\n141\t    let stdin = io::stdin();\n142\t    let mut handle = stdin.lock();\n143\t    let mut byte = [0u8; 1];\n144\t    let mut n = 0usize;\n145\t    while n + 1 < cap {\n146\t        match handle.read(&mut byte) {\n147\t            Ok(0) => break,\n148\t            Ok(_) => {\n149\t                buf[n] = byte[0];\n150\t                n += 1;\n151\t                if byte[0] == b'\\n' {\n152\t                    break;\n153\t                }\n154\t            }\n155\t            Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n156\t            Err(_) => break,\n157\t        }\n158\t    }\n159\t    if n > 0 {\n160\t        buf[n] = 0;\n161\t    }\n162\t}\n163\t\n164\t/// The body of the C `main()`.\n165\tpub fn program_main() {\n166\t    let stdout = io::stdout();\n167\t    let mut out = io::BufWriter::new(stdout.lock());\n168\t\n169\t    let mut in_buf = [0u8; 100];\n170\t    fgets(&mut in_buf[..]);\n171\t\n172\t    // The buffer is used as a NUL-terminated C string.\n173\t    let end = in_buf.iter().position(|&b| b == 0).unwrap_or(in_buf.len());\n174\t    let c_str = &in_buf[..end];\n175\t\n176\t    let mut x: i32 = 0;\n177\t    if parse_val(c_str, &mut x) {\n178\t        let mut the_house = House {\n179\t            floors: 2,\n180\t            bedrooms: 5,\n181\t            bathrooms: 2.5,\n182\t        };\n183\t        run(&mut out, &mut the_house, x);\n184\t        run(&mut out, &mut the_house, x);\n185\t    } else {\n186\t        let _ = write!(out, \"An error occurred\\n\");\n187\t    }\n188\t    let _ = out.flush();\n189\t}\n190\t"}]},"parent_tool_use_id":"toolu_bdrk_01NuaRrQBy9LjiJiC6cyTxBs","session_id":"f3474c86-67f7-4839-840d-8be73b7aa864","uuid":"9766a265-0876-41fe-9139-ab588e44fd55","timestamp":"2026-08-18T04:45:15.493Z","subagent_type":"general-purpose","task_description":"Audit printf %.1f emulation"}
