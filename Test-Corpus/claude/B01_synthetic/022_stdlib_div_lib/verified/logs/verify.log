, r.parse().expect(\"rem\"))"," }"," ","+/// C output for a batch of pairs, as parsed `(quot, rem)` pairs. Used by rows","+/// that additionally assert a documented invariant of glibc's `div(3)`.","+pub fn c_results(pairs: &[(c_int, c_int)]) -> Vec<(i64, i64)> {","+    let c = run_ops(&ops_for(Side::C, pairs));","+    assert_eq!(c.signal, None);","+    let lines = c.lines();","+    assert_eq!(lines.len(), pairs.len());","+    lines.iter().map(|l| parse_line(l)).collect()","+}","+"," // ---------------------------------------------------------------------------"," // Deterministic PRNG (fixed seed → reproducible property-style testing)"," // ---------------------------------------------------------------------------"]},{"oldStart":219,"oldLines":7,"newStart":455,"newLines":7,"lines":[" ","     /// Uniform in `[lo, hi]`.","     pub fn in_range(&mut self, lo: i32, hi: i32) -> i32 {","-        debug_assert!(lo <= hi);","+        assert!(lo <= hi);","         let span = (hi as i64 - lo as i64 + 1) as u64;","         (lo as i64 + (self.next_u64() % span) as i64) as i32","     }"]},{"oldStart":242,"oldLines":89,"newStart":478,"newLines":3,"lines":[" "," /// The boundary values crossed with each other by `CONFIGS.md` row 17."," pub const BOUNDARIES: [c_int; 7] = [i32::MIN, i32::MIN + 1, -1, 0, 1, i32::MAX - 1, i32::MAX];","-","-// ---------------------------------------------------------------------------","-// Running a call that is expected to kill the process","-// ---------------------------------------------------------------------------","-","-/// Re-executes *this* test binary as a child process so a `SIGFPE` can be","-/// observed without taking the test runner down with it.","-///","-/// A fresh process (rather than `fork()` from the multi-threaded test harness)","-/// avoids inheriting locks held by other threads.","-pub mod crash {","-    use super::*;","-    use std::os::unix::process::ExitStatusExt;","-    use std::process::{Command, Stdio};","-","-    pub cons