lines for {} calls\",","+        c_lines.len(),","+        pairs.len()","+    );","+    assert_eq!(","+        r_lines.len(),","+        pairs.len(),","+        \"{label}: Rust produced {} lines for {} calls\",","+        r_lines.len(),","+        pairs.len()","+    );","+","+    for (i, (&(x, y), (cl, rl))) in pairs","+        .iter()","+        .zip(c_lines.iter().zip(r_lines.iter()))","+        .enumerate()","+    {","+        assert_eq!(","+            cl,","+            rl,","+            \"{label}: driver({x}, {y}) (call #{i}) diverged\\n  C   : {:?}\\n  Rust: {:?}\",","+            String::from_utf8_lossy(cl),","+            String::from_utf8_lossy(rl)","+        );","+        // Guards against an \"equal because both were empty/garbage\" pass.","+        assert!(","+            cl.starts_with(b\"quotient: \"),","+            \"{label}: driver({x}, {y}) produced unexpected output {:?}\",","+            String::from_utf8_lossy(cl)","+        );","+    }","+","+    eprintln!(\"{label}: {} case(s) matched byte-for-byte\", pairs.len());","+}","+","+/// Single-pair convenience wrapper around [`assert_same_all`]."," pub fn assert_same(x: c_int, y: c_int) {","-    let (c_out, r_out) = run_both(x, y);","+    assert_same_all(&format!(\"driver({x}, {y})\"), &[(x, y)]);","+}","+","+/// Runs one trapping pair on each side and asserts they die identically: same","+/// signal, same exit code, same bytes emitted before the trap.","+pub fn assert_same_trap(x: c_int, y: c_int) -> Outcome {","+    let c = run_ops_with(&[op(Side::C, x, y)], true);","+    let r = run_ops_with(&[op(Side::Rust, x, y)], true);","+","     assert_eq!(","-        c_out,","-        r_out,","-        \"driver({x}, {y}) diverged\\n  C   : {:?}\\n  Rust: {:?}\",","-        String::from_utf8_lossy(&c_out),","-        String::from_utf8_lossy(&r_out),","+        c.signal, r.signal,","+        \"driver({x}, {y}): C died with signal {:?}, Rust with {:?}\",","+        c.signal, r.signal","     );","-    // Sani