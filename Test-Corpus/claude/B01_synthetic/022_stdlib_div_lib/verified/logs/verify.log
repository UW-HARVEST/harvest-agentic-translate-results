{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_37ub2bmd625s6d3k5ytcod3tbo6ntyx7ydfbef3wj27pzehcahva","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Q1UsJToywtgjpwZvRXjRKP","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-fOypFb/translated_rust/tests/common/mod.rs","content":"//! Shared harness for the C-vs-Rust differential tests.\n//!\n//! Both implementations are loaded as *shared libraries* with `libloading` and\n//! called only through their exported `driver` symbol, so the `#[no_mangle]`\n//! export wrapper is part of what is under test. No Rust function is ever\n//! called directly.\n//!\n//! `driver`'s entire observable behaviour is the bytes it writes to the\n//! process-wide `stdout` `FILE` via libc `printf`, so the harness redirects\n//! fd 1 to a temporary file around each call and compares the bytes.\n\n#![allow(dead_code)]\n\nuse std::ffi::{c_int, c_void};\nuse std::io::Write;\nuse std::os::fd::AsRawFd;\nuse std::path::PathBuf;\nuse std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::{Mutex, OnceLock};\n\nuse libloading::{Library, Symbol};\n\n/// `void driver(int x, int y);`\npub type DriverFn = unsafe extern \"C\" fn(c_int, c_int);\n\nunsafe extern \"C\" {\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    /// `fflush(NULL)` flushes *every* open output stream, which is how we force\n    /// libc's `stdout` buffer out to the redirected fd.\n    fn fflush(stream: *mut c_void) -> c_int;\n}\n\n// ---------------------------------------------------------------------------\n// Locating the two shared libraries\n// ---------------------------------------------------------------------------\n\n/// `c_src/build/libdriver.so`, built by CMake.\npub fn c_so_path() -> PathBuf {\n    let p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n        .join(\"c_src\")\n        .join(\"build\")\n        .join(\"libdriver.so\");\n    assert!(\n        p.is_file(),\n        \"C shared library not found at {}\\nBuild it with:\\n  cd c_src && mkdir -p build && cd build \\\n         && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\",\n        p.display()\n    );\n    p\n}\n\n/// `target/<profile>/libdriver.so`, built by `cargo build`.\n///\n/// Derived from the running test executable (`target/<profile>/deps/<exe>`) so\n/// it follows `--release`, `CARGO_TARGET_DIR`, custom profiles, etc.\npub fn rust_so_path() -> PathBuf {\n    let exe = std::env::current_exe().expect(\"current_exe\");\n    let profile_dir = exe\n        .parent()\n        .and_then(|deps| deps.parent())\n        .expect(\"target/<profile>\");\n    let p = profile_dir.join(\"libdriver.so\");\n    assert!(\n        p.is_file(),\n        \"Rust shared library not found at {}\\nBuild it with: cargo build\",\n        p.display()\n    );\n    p\n}\n\n/// Loads both `.so`s once and returns their exported `driver` symbols.\n///\n/// The `Library` handles are leaked on purpose: the returned function pointers\n/// must stay valid for the whole test run.\npub fn drivers() -> (DriverFn, DriverFn) {\n    static FNS: OnceLock<(DriverFn, DriverFn)> = OnceLock::new();\n    *FNS.get_or_init(|| unsafe {\n        let c_lib: &'static Library =\n            Box::leak(Box::new(Library::new(c_so_path()).expect(\"dlopen C .so\")));\n        let r_lib: &'static Library =\n            Box::leak(Box::new(Library::new(rust_so_path()).expect(\"dlopen Rust .so\")));\n\n        let c_sym: Symbol<'static, DriverFn> =\n            c_lib.get(b\"driver\\0\").expect(\"C .so exports `driver`\");\n        let r_sym: Symbol<'static, DriverFn> =\n            r_lib.get(b\"driver\\0\").expect(\"Rust .so exports `driver`\");\n\n        (*c_sym, *r_sym)\n    })\n}\n\n/// Loads only one side, selected by name. Used by the crash-worker child.\npub fn driver_for(side: &str) -> DriverFn {\n    let (c, r) = drivers();\n    match side {\n        \"c\" => c,\n        \"rust\" => r,\n        other => panic!(\"unknown side {other:?}\"),\n    }\n}\n\n// ---------------------------------------------------------------------------\n// stdout capture\n// ---------------------------------------------------------------------------\n\n/// Serialises all fd-1 juggling. Integration tests run on several threads by\n/// default, and redirecting a process-wide file descriptor is not thread safe.\nstatic FD_LOCK: Mutex<()> = Mutex::new(());\n\nfn unique_tmp_path(tag: &str) -> PathBuf {\n    static COUNTER: AtomicU64 = AtomicU64::new(0);\n    let n = COUNTER.fetch_add(1, Ordering::Relaxed);\n    std::env::temp_dir().join(format!(\n        \"driver-difftest-{}-{tag}-{n}.out\",\n        std::process::id()\n    ))\n}\n\n/// Runs `f` with fd 1 redirected to a fresh temporary file and returns\n/// everything written to it (libc `stdout` is flushed before and after).\npub fn capture<F: FnOnce()>(tag: &str, f: F) -> Vec<u8> {\n    let _guard = FD_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n    let path = unique_tmp_path(tag);\n\n    let bytes = {\n        let file = std::fs::File::create(&path).expect(\"create capture file\");\n\n        // Drain anything already pending so it is not misattributed to `f`.\n        std::io::stdout().flush().ok();\n        unsafe { fflush(std::ptr::null_mut()) };\n\n        let saved = unsafe { dup(1) };\n        assert!(saved >= 0, \"dup(1) failed\");\n        assert!(unsafe { dup2(file.as_raw_fd(), 1) } >= 0, \"dup2 failed\");\n\n        f();\n\n        // Push libc's stdout buffer into the file *before* restoring fd 1.\n        unsafe { fflush(std::ptr::null_mut()) };\n        assert!(unsafe { dup2(saved, 1) } >= 0, \"dup2 restore failed\");\n        unsafe { close(saved) };\n        drop(file);\n\n        std::fs::read(&path).expect(\"read capture file\")\n    };\n\n    let _ = std::fs::remove_file(&path);\n    bytes\n}\n\n/// Captures one `driver(x, y)` call on each side and returns `(c_out, rust_out)`.\npub fn run_both(x: c_int, y: c_int) -> (Vec<u8>, Vec<u8>) {\n    let (c, r) = drivers();\n    let c_out = capture(\"c\", || unsafe { c(x, y) });\n    let r_out = capture(\"rust\", || unsafe { r(x, y) });\n    (c_out, r_out)\n}\n\n/// Asserts that C and Rust produce byte-identical output for `driver(x, y)`.\n///\n/// `x` and `y` must be a non-trapping pair (see `ERRORS.md`); trapping pairs go\n/// through `crash::run_in_child`.\npub fn assert_same(x: c_int, y: c_int) {\n    let (c_out, r_out) = run_both(x, y);\n    assert_eq!(\n        c_out,\n        r_out,\n        \"driver({x}, {y}) diverged\\n  C   : {:?}\\n  Rust: {:?}\",\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&r_out),\n    );\n    // Sanity: the call really did produce the one documented line, so an\n    // \"equal because both were empty\" pass cannot hide a broken export.\n    assert!(\n        c_out.starts_with(b\"quotient: \") && c_out.ends_with(b\"\\n\"),\n        \"driver({x}, {y}) produced unexpected C output {:?}\",\n        String::from_utf8_lossy(&c_out)\n    );\n}\n\n/// Asserts C/Rust parity for every pair produced by `pairs`, reporting how many\n/// cases ran so a silently-empty generator cannot pass a row.\npub fn assert_same_all<I: IntoIterator<Item = (c_int, c_int)>>(label: &str, pairs: I) {\n    let mut n = 0usize;\n    for (x, y) in pairs {\n        assert_same(x, y);\n        n += 1;\n    }\n    assert!(n > 0, \"{label}: no cases were generated\");\n    eprintln!(\"{label}: {n} case(s) matched\");\n}\n\n// ---------------------------------------------------------------------------\n// Deterministic PRNG (fixed seed → reproducible property-style testing)\n// ---------------------------------------------------------------------------\n\n/// SplitMix64. Self-contained so the tests need no extra dependency.\npub struct Rng(u64);\n\nimpl Rng {\n    pub const fn new(seed: u64) -> Self {\n        Rng(seed)\n    }\n\n    pub fn next_u64(&mut self) -> u64 {\n        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n        let mut z = self.0;\n        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n        z ^ (z >> 31)\n    }\n\n    /// Uniform over all 2^32 bit patterns, i.e. the whole `int` range.\n    pub fn next_i32(&mut self) -> i32 {\n        self.next_u64() as u32 as i32\n    }\n\n    /// Uniform in `[lo, hi]`.\n    pub fn in_range(&mut self, lo: i32, hi: i32) -> i32 {\n        debug_assert!(lo <= hi);\n        let span = (hi as i64 - lo as i64 + 1) as u64;\n        (lo as i64 + (self.next_u64() % span) as i64) as i32\n    }\n\n    /// A divisor that never triggers `ERRORS.md` row 1.\n    pub fn nonzero_i32(&mut self) -> i32 {\n        loop {\n            let v = self.next_i32();\n            if v != 0 {\n                return v;\n            }\n        }\n    }\n}\n\n/// The two argument pairs that trap (`ERRORS.md`): `y == 0`, and `INT_MIN / -1`.\npub fn traps(x: c_int, y: c_int) -> bool {\n    y == 0 || (x == i32::MIN && y == -1)\n}\n\n/// The boundary values crossed with each other by `CONFIGS.md` row 17.\npub const BOUNDARIES: [c_int; 7] = [i32::MIN, i32::MIN + 1, -1, 0, 1, i32::MAX - 1, i32::MAX];\n\n// ---------------------------------------------------------------------------\n// Running a call that is expected to kill the process\n// ---------------------------------------------------------------------------\n\n/// Re-executes *this* test binary as a child process so a `SIGFPE` can be\n/// observed without taking the test runner down with it.\n///\n/// A fresh process (rather than `fork()` from the multi-threaded test harness)\n/// avoids inheriting locks held by other threads.\npub mod crash {\n    use super::*;\n    use std::os::unix::process::ExitStatusExt;\n    use std::process::{Command, Stdio};\n\n    pub const SIDE: &str = \"DIFFTEST_CRASH_SIDE\";\n    pub const ARG_X: &str = \"DIFFTEST_CRASH_X\";\n    pub const ARG_Y: &str = \"DIFFTEST_CRASH_Y\";\n    pub const OUT: &str = \"DIFFTEST_CRASH_OUT\";\n    /// Name of the `#[test]` that acts as the child-side entry point.\n    pub const WORKER: &str = \"crash_worker\";\n\n    /// How the child terminated, plus whatever `driver` managed to write.\n    #[derive(Debug, PartialEq, Eq)]\n    pub struct Outcome {\n        /// `Some(signum)` if killed by a signal.\n        pub signal: Option<i32>,\n        /// `Some(code)` if it exited normally.\n        pub code: Option<i32>,\n        pub stdout: Vec<u8>,\n    }\n\n    /// Runs `driver(x, y)` on `side` (\"c\" or \"rust\") in a child process.\n    pub fn run_in_child(side: &str, x: c_int, y: c_int) -> Outcome {\n        let exe = std::env::current_exe().expect(\"current_exe\");\n        let out_path = unique_tmp_path(&format!(\"crash-{side}\"));\n\n        let status = Command::new(&exe)\n            .args([WORKER, \"--exact\", \"--test-threads=1\", \"--nocapture\"])\n            .env(SIDE, side)\n            .env(ARG_X, x.to_string())\n            .env(ARG_Y, y.to_string())\n            .env(OUT, &out_path)\n            // The child re-runs the harness; keep its chatter out of the way.\n            .stdout(Stdio::null())\n            .stderr(Stdio::null())\n            .status()\n            .expect(\"spawn crash worker\");\n\n        let stdout = std::fs::read(&out_path).unwrap_or_default();\n        let _ = std::fs::remove_file(&out_path);\n\n        Outcome {\n            signal: status.signal(),\n            code: status.code(),\n            stdout,\n        }\n    }\n\n    /// The child-side body. Every test file defines a `crash_worker` test that\n    /// delegates here; it is inert unless the environment says otherwise.\n    ///\n    /// `driver`'s output is redirected to `OUT` so the harness's own banner does\n    /// not contaminate the comparison.\n    pub fn worker_body() {\n        let Ok(side) = std::env::var(SIDE) else {\n            return; // ordinary test run: nothing to do\n        };\n        let x: c_int = std::env::var(ARG_X).unwrap().parse().unwrap();\n        let y: c_int = std::env::var(ARG_Y).unwrap().parse().unwrap();\n        let out_path = std::env::var(OUT).unwrap();\n        let f = driver_for(&side);\n\n        let file = std::fs::File::create(&out_path).expect(\"create worker out\");\n        std::io::stdout().flush().ok();\n        unsafe { fflush(std::ptr::null_mut()) };\n        assert!(unsafe { dup2(file.as_raw_fd(), 1) } >= 0);\n\n        // If this traps, the process dies here and the parent sees the signal.\n        unsafe { f(x, y) };\n\n        unsafe { fflush(std::ptr::null_mut()) };\n        // Reached only when the call did *not* trap.\n        std::process::exit(0);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2890,"cache_read_input_tokens":38387,"cache_creation":{"ephemeral_5m_input_tokens":2890,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b755e370-103b-414a-94ee-5de01733975a","uuid":"aa36c179-d472-47f0-8e31-710bb2a024d7","timestamp":"2026-08-18T04:45:59.057Z"}
