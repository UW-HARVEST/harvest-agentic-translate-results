    assert_same_all(\"row19 small magnitudes\", &pairs);"," }"," "," // ---------------------------------------------------------------------------","-// Rows 20–21 — statelessness and shared-stdout buffering parity","+// Rows 20-21 — statelessness and shared-stdout buffering parity"," // ---------------------------------------------------------------------------"," "," #[test]"," fn row20_interleaved_calls_are_stateless() {","-    let (c, r) = drivers();","     let mut rng = Rng::new(0x2020);","+    let pairs: Vec<(c_int, c_int)> = (0..600)","+        .map(|_| loop {","+            let x = rng.next_i32();","+            let y = rng.nonzero_i32();","+            if !traps(x, y) {","+                return (x, y);","+            }","+        })","+        .collect();"," ","-    // Alternate C, Rust, C, Rust ... and require every single call to agree.","-    for i in 0..500 {","-        let x = rng.next_i32();","-        let y = rng.nonzero_i32();","-        if traps(x, y) {","-            continue;","-        }","-        let (first, second) = if i % 2 == 0 {","-            let a = capture(\"c\", || unsafe { c(x, y) });","-            let b = capture(\"rust\", || unsafe { r(x, y) });","-            (a, b)","-        } else {","-            let b = capture(\"rust\", || unsafe { r(x, y) });","-            let a = capture(\"c\", || unsafe { c(x, y) });","-            (b, a)","-        };","-        assert_eq!(first, second, \"interleaved driver({x}, {y}) diverged\");","+    // C, Rust, C, Rust ... all in ONE process, so any hidden per-library state","+    // or stdout interference would show up.","+    let mut cr = Vec::new();","+    let mut rc = Vec::new();","+    for &(x, y) in &pairs {","+        cr.push(op(Side::C, x, y));","+        cr.push(op(Side::Rust, x, y));","+        rc.push(op(Side::Rust, x, y));","+        rc.push(op(Side::C, x, y));","     }"," ","+    let out_cr = run_ops(&cr);","+    let out_rc = run_ops(&rc);","+    assert_eq!(out_cr.signal, None);","+    assert_eq!(out_rc.signal, None);","+","+    let l_cr = out_cr.lines();","+    let l_rc = out_rc.lines();","+    assert_eq!(l_cr.len(), pairs.len() * 2);","+    assert_eq!(l_rc.len(), pairs.len() * 2);","+","+    for (i, &(x, y)) in pairs.iter().enumerate() {","+        // Within a C-then-Rust pair the two lines must be identical...","+        assert_eq!(","+            l_cr[2 * i],","+            l_cr[2 * i + 1],","+            \"interleaved C/Rust driver({x}, {y}) diverged\"","+        );","+        // ...and swapping the call order must not change anything.","+        assert_eq!(","+            l_rc[2 * i],","+            l_rc[2 * i + 1],","+            \"interleaved Rust/C driver({x}, {y}) diverged\"","+        );","+        assert_eq!(l_cr[2 * i], l_rc[2 * i], \"call order changed the output\");","+    }","+","     // Calling the same side repeatedly must keep producing the same bytes.","-    let once = capture(\"c\", || unsafe { c(-7, 2) });","-    for _ in 0..5 {","-        assert_eq!(capture(\"c\", || unsafe { c(-7, 2) }), once);","-        assert_eq!(capture(\"rust\", || unsafe { r(-7, 2) }), once);","+    let repeat: Vec<_> = (0..6)","+        .flat_map(|_| [op(Side::C, -7, 2), op(Side::Rust, -7, 2)])","+        .collect();","+    let out = run_ops(&repeat);","+    let lines = out.lines();","+    assert_eq!(lines.len(), 12);","+    for l in &lines {","+        assert_eq!(*l, b\"quotient: -3, remainder: -1\");","     }"," }"," "," #[test]"," fn row21_unflushed_multi_call_stream() {","-    let (c, r) = drivers();","     let mut rng = Rng::new(0x2121);","-","-    let pairs: Vec<(c_int, c_int)> = (0..400)","-        .map(|_| {","+    let pairs: Vec<(c_int, c_int)> = (0..800)","+        .map(|_| loop {","             let x = rng.next_i32();","-            let mut y = rng.nonzero_i32();","-            if x == i32::MIN && y == -1 {","-                y = 1;","+            let y = rng.nonzero_i32();","+            if !traps(x, y) {","+                return (x, y);","             }","-            (x, y)","         })","         .collect();"," ","-    // Many calls, a single flush at the very end: compares the whole stream as","-    // it lands in the shared libc `stdout` buffer, not just per-call output.","-    let c_stream = capture(\"c-stream\", || {","-        for &(x, y) in &pairs {","-            unsafe { c(x, y) };","-        }","-    });","-    let r_stream = capture(\"rust-stream\", || {","-        for &(x, y) in &pairs {","-            unsafe { r(x, y) };","-        }","-    });","-","-    assert_eq!(c_stream, r_stream, \"multi-call stdout streams diverged\");","+    // Many calls with a single flush at the very end: compares the whole stream","+    // as it lands in the shared libc `stdout` buffer, not just per-call output.","+    let c_stream = run_ops(&common::ops_for(Side::C, &pairs));","+    let r_stream = run_ops(&common::ops_for(Side::Rust, &pairs));","     assert_eq!(","-        c_stream.iter().filter(|&&b| b == b'\\n').count(),","+        c_stream.stdout, r_stream.stdout,","+        \"fully-buffered multi-call stdout streams diverged\"","+    );","+    assert_eq!(","+        c_stream.stdout.iter().filter(|&&b| b == b'\\n').count(),","         pairs.len(),","         \"expected exactly one line per call\"","     );"," ","-    // Mixed stream: C and Rust writing into the same unflushed buffer.","-    let mixed_a = capture(\"mixed-a\", || {","-        for &(x, y) in pairs.iter().take(100) {","-            unsafe { c(x, y) };","-            unsafe { r(x, y) };","-        }","-    });","-    let mixed_b = capture(\"mixed-b\", || {","-        for &(x, y) in pairs.iter().take(100) {","-            unsafe { r(x, y) };","-            unsafe { c(x, y) };","-        }","-    });","-    assert_eq!(mixed_a, mixed_b, \"mixed C/Rust stream diverged\");","+    // The same batch with a flush after every call must yield the same bytes:","+    // `driver` must not depend on the buffering mode.","+    let c_unbuf = run_ops_with(&common::ops_for(Side::C, &pairs), true);","+    let r_unbuf = run_ops_with(&common::ops_for(Side::Rust, &pairs), true);","+    assert_eq!(c_unbuf.stdout, c_stream.stdout, \"C: buffering changed output\");","+    assert_eq!(","+        r_unbuf.stdout, r_stream.stdout,","+        \"Rust: buffering changed output\"","+    );","+    assert_eq!(c_unbuf.stdout, r_unbuf.stdout);","+","+    // A single flush shared by a mixed C/Rust stream.","+    let mixed: Vec<_> = pairs","+        .iter()","+        .take(200)","+        .flat_map(|&(x, y)| [op(Side::C, x, y), op(Side::Rust, x, y)])","+        .collect();","+    let out = run_ops(&mixed);","+    let lines = out.lines();","+    assert_eq!(lines.len(), 400);","+    for (i, &(x, y)) in pairs.iter().take(200).enumerate() {","+        assert_eq!(","+            lines[2 * i],","+            lines[2 * i + 1],","+            \"mixed unflushed stream diverged at driver({x}, {y})\"","+        );","+    }"," }"," "," // ---------------------------------------------------------------------------","+// Output format parity, spelled out byte-for-byte","+// ---------------------------------------------------------------------------","+","+/// Locks down the literal format string, including the `%d` rendering of","+/// negatives and the trailing newline, against known-good expected bytes.","+#[test]","+fn output_format_is_byte_exact() {","+    let expected: [(c_int, c_int, &[u8]); 10] = [","+        (0, 1, b\"quotient: 0, remainder: 0\\n\"),","+        (1, 1, b\"quotient: 1, remainder: 0\\n\"),","+        (7, 2, b\"quotient: 3, remainder: 1\\n\"),","+        (-7, 2, b\"quotient: -3, remainder: -1\\n\"),","+        (7, -2, b\"quotient: -3, remainder: 1\\n\"),","+        (-7, -2, b\"quotient: 3, remainder: -1\\n\"),","+        (1, 10, b\"quotient: 0, remainder: 1\\n\"),","+        (i32::MAX, 1, b\"quotient: 2147483647, remainder: 0\\n\"),","+        (i32::MIN, 1, b\"quotient: -2147483648, remainder: 0\\n\"),","+        (i32::MIN + 1, -1, b\"quotient: 2147483647, remainder: 0\\n\"),","+    ];","+","+    let pairs: Vec<(c_int, c_int)> = expected.iter().map(|&(x, y, _)| (x, y)).collect();","+    assert_same_all(\"output format\", &pairs);","+","+    let c = run_ops(&common::ops_for(Side::C, &pairs));","+    let r = run_ops(&common::ops_for(Side::Rust, &pairs));","+    for (i, &(x, y, want)) in expected.iter().enumerate() {","+        let want_line = &want[..want.len() - 1];","+        assert_eq!(","+            c.lines()[i],","+            want_line,","+            \"C driver({x}, {y}) format mismatch\"","+        );","+        assert_eq!(","+            r.lines()[i],","+            want_line,","+            \"Rust driver({x}, {y}) format mismatch\"","+        );","+    }","+","+    // And the parse round-trip agrees on both sides.","+    for (&(x, y), (q, rem)) in pairs.iter().zip(c_results(&pairs)) {","+        assert_eq!(q * y as i64 + rem, x as i64, \"invariant for ({x}, {y})\");","+    }","+}","+","+/// Sanity check that the differential harness can actually *detect* a","+/// difference; otherwise every row above could be passing vacuously.","+#[test]","+fn harness_detects_differences() {","+    // Same call on both sides -> identical lines.","+    let same = run_ops(&[op(Side::C, 9, 4), op(Side::Rust, 9, 4)]);","+    let l = same.lines();","+    assert_eq!(l.len(), 2);","+    assert_eq!(l[0], l[1]);","+","+    // Deliberately different arguments -> the harness must see a difference.","+    let differ = run_ops(&[op(Side::C, 9, 4), op(Side::Rust, 9, 5)]);","+    let l = differ.lines();","+    assert_eq!(l.len(), 2);","+    assert_ne!(","+        l[0], l[1],","+        \"harness cannot distinguish different outputs; the other rows are vacuous\"","+    );","+","+    // The line-count guard also has to work.","+    let one = run_ops(&[op(Side::C, 1, 1)]);","+    assert_eq!(one.lines().len(), 1);","+}","+","+// ---------------------------------------------------------------------------"," // Which `c_div` arm is compiled in (documents the target cfg axis)"," // ---------------------------------------------------------------------------"," "]},{"oldStart":520,"oldLines":4,"newStart":685,"newLines":5,"lines":["         eprintln!(\"non-x86_64: the wrapping_div/wrapping_rem arm of c_div is under test\");","     }","     assert_same(-7, 2);","+    let _ = parse_line(b\"quotient: -3, remainder: -1\");"," }"]}],"originalFile":"//! Phase B — valid-path differential tests.\n//!\n//! One test per row of `CONFIGS.md`. Every test loads BOTH `libdriver.so`s\n//! (C and Rust) with `libloading` and calls the exported `driver` symbol,\n//! comparing the bytes each writes to `stdout`.\n//!\n//! Rows that involve more than one value use a fixed-seed PRNG and many\n//! randomized inputs, so a row passes only across the whole sample.\n\nmod common;\n\nuse common::{assert_same, assert_same_all, capture, drivers, traps, Rng, BOUNDARIES};\nuse std::ffi::c_int;\n\n/// Child-side entry point for the trapping pairs inside row 17.\n/// Inert during a normal test run. See `common::crash`.\n#[test]\nfn crash_worker() {\n    common::crash::worker_body();\n}\n\n// ---------------------------------------------------------------------------\n// Generators\n// ---------------------------------------------------------------------------\n\n/// A magnitude in `[1, INT_MAX]` spread across all bit-widths, so that sampled\n/// pairs hit `|x| < |y|`, `|x| == |y|` and `|x| > |y|` often instead of always\n/// landing in the \"both huge\" regime.\nfn rand_mag(rng: &mut Rng) -> i32 {\n    let bits = rng.in_range(1, 31) as u32;\n    let mask: i32 = if bits >= 31 { i32::MAX } else { (1i32 << bits) - 1 };\n    let v = (rng.next_u64() as u32 as i32) & mask;\n    if v == 0 {\n        1\n    } else {\n        v\n    }\n}\n\n/// Rejection-samples `n` pairs matching `pred` from `gen`.\nfn sample(\n    seed: u64,\n    n: usize,\n    gen: impl Fn(&mut Rng) -> (i32, i32),\n    pred: impl Fn(i32, i32) -> bool,\n) -> Vec<(i32, i32)> {\n    let mut rng = Rng::new(seed);\n    let mut out = Vec::with_capacity(n);\n    let mut attempts = 0usize;\n    while out.len() < n {\n        attempts += 1;\n        assert!(\n            attempts < n * 20_000 + 100_000,\n            \"generator could not produce {n} pairs\"\n        );\n        let (x, y) = gen(&mut rng);\n        if !traps(x, y) && pred(x, y) {\n            out.push((x, y));\n        }\n    }\n    out\n}\n\n/// Signed pair whose magnitudes come from `rand_mag`, with the requested signs.\nfn signed_pairs(seed: u64, n: usize, sx: i32, sy: i32, pred: impl Fn(i32, i32) -> bool) -> Vec<(i32, i32)> {\n    sample(\n        seed,\n        n,\n        move |rng| {\n            let x = rand_mag(rng).wrapping_mul(sx);\n            let y = rand_mag(rng).wrapping_mul(sy);\n            (x, y)\n        },\n        pred,\n    )\n}\n\n/// Turns a magnitude pair into an exactly-divisible pair with the given signs.\nfn divisible_pairs(seed: u64, n: usize, sx: i32, sy: i32) -> Vec<(i32, i32)> {\n    let mut rng = Rng::new(seed);\n    let mut out = Vec::with_capacity(n);\n    while out.len() < n {\n        let y = rand_mag(&mut rng);\n        let k = rng.in_range(2, 1000) as i64;\n        let prod = y as i64 * k;\n        if prod > i32::MAX as i64 {\n            continue;\n        }\n        let x = prod as i32 * sx;\n        let y = y * sy;\n        if !traps(x, y) && x.wrapping_rem(y) == 0 && x.wrapping_div(y).abs() > 1 {\n            out.push((x, y));\n        }\n    }\n    out\n}\n\n/// Parses `quotient: <q>, remainder: <r>\\n` back out of captured output.\nfn parse(out: &[u8]) -> (i64, i64) {\n    let s = std::str::from_utf8(out).expect(\"utf8 output\");\n    let s = s.strip_prefix(\"quotient: \").expect(\"prefix\");\n    let s = s.strip_suffix('\\n').expect(\"newline\");\n    let (q, r) = s.split_once(\", remainder: \").expect(\"separator\");\n    (q.parse().expect(\"quot\"), r.parse().expect(\"rem\"))\n}\n\n// ---------------------------------------------------------------------------\n// Rows 1–8 — the sign x divisibility cross-product for |x| > |y|\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row01_pos_pos_inexact() {\n    assert_same_all(\n        \"row01 x>0 y>0 |x|>|y| inexact\",\n        signed_pairs(0x0101, 400, 1, 1, |x, y| {\n            x > 0 && y > 0 && x.abs() > y.abs() && x % y != 0\n        }),\n    );\n}\n\n#[test]\nfn row02_pos_pos_exact() {\n    assert_same_all(\"row02 x>0 y>0 exact\", divisible_pairs(0x0202, 400, 1, 1));\n}\n\n#[test]\nfn row03_neg_pos_inexact() {\n    assert_same_all(\n        \"row03 x<0 y>0 |x|>|y| inexact\",\n        signed_pairs(0x0303, 400, -1, 1, |x, y| {\n            x < 0 && y > 0 && (x as i64).abs() > y.abs() as i64 && x % y != 0\n        }),\n    );\n}\n\n#[test]\nfn row04_neg_pos_exact() {\n    assert_same_all(\"row04 x<0 y>0 exact\", divisible_pairs(0x0404, 400, -1, 1));\n}\n\n#[test]\nfn row05_pos_neg_inexact() {\n    assert_same_all(\n        \"row05 x>0 y<0 |x|>|y| inexact\",\n        signed_pairs(0x0505, 400, 1, -1, |x, y| {\n            x > 0 && y < 0 && x as i64 > (y as i64).abs() && x % y != 0\n        }),\n    );\n}\n\n#[test]\nfn row06_pos_neg_exact() {\n    assert_same_all(\"row06 x>0 y<0 exact\", divisible_pairs(0x0606, 400, 1, -1));\n}\n\n#[test]\nfn row07_neg_neg_inexact() {\n    assert_same_all(\n        \"row07 x<0 y<0 |x|>|y| inexact\",\n        signed_pairs(0x0707, 400, -1, -1, |x, y| {\n            x < 0 && y < 0 && (x as i64).abs() > (y as i64).abs() && x % y != 0\n        }),\n    );\n}\n\n#[test]\nfn row08_neg_neg_exact() {\n    assert_same_all(\"row08 x<0 y<0 exact\", divisible_pairs(0x0808, 400, -1, -1));\n}\n\n// ---------------------------------------------------------------------------\n// Row 9 — zero dividend\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row09_zero_dividend() {\n    let mut rng = Rng::new(0x0909);\n    let mut pairs: Vec<(i32, i32)> = vec![(0, 1), (0, -1), (0, i32::MAX), (0, i32::MIN), (0, 2), (0, -2)];\n    for _ in 0..300 {\n        pairs.push((0, rng.nonzero_i32()));\n    }\n    assert_same_all(\"row09 x==0\", pairs);\n\n    // Documented shape: quot and rem are both zero, printed without a sign.\n    let (c_out, _) = common::run_both(0, 7);\n    assert_eq!(c_out, b\"quotient: 0, remainder: 0\\n\");\n}\n\n// ---------------------------------------------------------------------------\n// Row 10 — |x| < |y| (quotient 0, remainder == x)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row10_dividend_smaller_than_divisor() {\n    let mut pairs = Vec::new();\n    for (sx, sy) in [(1, 1), (-1, 1), (1, -1), (-1, -1)] {\n        pairs.extend(signed_pairs(\n            0x1010 + sx as u64 * 3 + sy as u64 * 5,\n            150,\n            sx,\n            sy,\n            |x, y| (x as i64).abs() < (y as i64).abs() && x != 0,\n        ));\n    }\n    assert_same_all(\"row10 |x|<|y|\", pairs.clone());\n\n    for (x, y) in pairs.into_iter().take(40) {\n        let (c_out, _) = common::run_both(x, y);\n        let (q, r) = parse(&c_out);\n        assert_eq!((q, r), (0, x as i64), \"|x|<|y| should give quot 0, rem x\");\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 11 — |x| == |y| (quotient ±1, remainder 0)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row11_equal_magnitudes() {\n    let mut rng = Rng::new(0x1111);\n    let mut pairs = Vec::new();\n    for _ in 0..200 {\n        let m = rand_mag(&mut rng);\n        for (sx, sy) in [(1, 1), (-1, 1), (1, -1), (-1, -1)] {\n            let (x, y) = (m * sx, m * sy);\n            if !traps(x, y) {\n                pairs.push((x, y));\n            }\n        }\n    }\n    // Including the extremes, where |x| == |y| still holds.\n    for p in [\n        (i32::MAX, i32::MAX),\n        (i32::MAX, -i32::MAX),\n        (-i32::MAX, i32::MAX),\n        (-i32::MAX, -i32::MAX),\n        (i32::MIN, i32::MIN),\n    ] {\n        pairs.push(p);\n    }\n    assert_same_all(\"row11 |x|==|y|\", pairs);\n\n    let (c_out, _) = common::run_both(12345, -12345);\n    assert_eq!(parse(&c_out), (-1, 0));\n}\n\n// ---------------------------------------------------------------------------\n// Row 12 — glibc's dead `numer >= 0 && rem < 0` fix-up branch\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row12_nonnegative_dividend_fixup_branch_never_fires() {\n    let mut pairs = Vec::new();\n    for sy in [1, -1] {\n        pairs.extend(signed_pairs(0x1200 + sy as u64, 400, 1, sy, |x, _| x >= 0));\n    }\n    pairs.push((0, -1));\n    pairs.push((i32::MAX, -1));\n    pairs.push((1, i32::MIN));\n\n    assert_same_all(\"row12 x>=0 fix-up branch\", pairs.clone());\n\n    // For x >= 0, truncation toward zero means rem >= 0, so glibc's fix-up\n    // (`++quot; rem -= denom;`) is unreachable. Confirm on the C side, and the\n    // differential assertion above guarantees Rust agrees.\n    for (x, y) in pairs {\n        let (c_out, r_out) = common::run_both(x, y);\n        let (q, r) = parse(&c_out);\n        assert!(r >= 0, \"C: x={x} y={y} gave rem {r} < 0 for x >= 0\");\n        assert_eq!(q * y as i64 + r, x as i64, \"quot*y + rem == x for x={x} y={y}\");\n        assert_eq!(c_out, r_out);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 13 — unit divisors\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row13_unit_divisors() {\n    let mut rng = Rng::new(0x1313);\n    let mut pairs = Vec::new();\n    for _ in 0..300 {\n        let x = rng.next_i32();\n        pairs.push((x, 1));\n        if x != i32::MIN {\n            pairs.push((x, -1)); // INT_MIN / -1 traps; ERRORS.md row 2\n        }\n    }\n    for x in [0, 1, -1, 2, -2, i32::MAX, i32::MIN + 1] {\n        pairs.push((x, 1));\n        pairs.push((x, -1));\n    }\n    pairs.push((i32::MIN, 1));\n    assert_same_all(\"row13 y==±1\", pairs);\n\n    let (c_out, _) = common::run_both(i32::MIN, 1);\n    assert_eq!(parse(&c_out), (i32::MIN as i64, 0));\n}\n\n// ---------------------------------------------------------------------------\n// Rows 14–16 — INT_MIN / INT_MAX as dividend and as divisor\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row14_int_min_dividend() {\n    let ys = [1, 2, -2, 3, -3, i32::MIN, i32::MAX, i32::MIN + 1, 7, -7];\n    assert_same_all(\n        \"row14 x==INT_MIN\",\n        ys.into_iter().map(|y| (i32::MIN, y)).collect::<Vec<_>>(),\n    );\n\n    // Widest possible %d output on both fields.\n    let (c_out, _) = common::run_both(i32::MIN, 1);\n    assert_eq!(c_out, b\"quotient: -2147483648, remainder: 0\\n\");\n    let (c_out, _) = common::run_both(i32::MIN, i32::MIN);\n    assert_eq!(c_out, b\"quotient: 1, remainder: 0\\n\");\n}\n\n#[test]\nfn row15_int_max_dividend() {\n    let ys = [1, -1, 2, -2, 3, -3, i32::MAX, i32::MIN, i32::MAX - 1, 10, -10];\n    assert_same_all(\n        \"row15 x==INT_MAX\",\n        ys.into_iter().map(|y| (i32::MAX, y)).collect::<Vec<_>>(),\n    );\n\n    let (c_out, _) = common::run_both(i32::MAX, -1);\n    assert_eq!(c_out, b\"quotient: -2147483647, remainder: 0\\n\");\n}\n\n#[test]\nfn row16_extreme_divisors() {\n    let mut rng = Rng::new(0x1616);\n    let mut pairs = Vec::new();\n    for y in [i32::MIN, i32::MIN + 1, i32::MAX, i32::MAX - 1] {\n        for x in [0, 1, -1, 2, -2, 12345, -12345, i32::MAX, i32::MIN] {\n            pairs.push((x, y));\n        }\n        for _ in 0..100 {\n            pairs.push((rng.next_i32(), y));\n        }\n    }\n    assert_same_all(\"row16 extreme divisors\", pairs);\n\n    let (c_out, _) = common::run_both(-12345, i32::MAX);\n    assert_eq!(parse(&c_out), (0, -12345));\n}\n\n// ---------------------------------------------------------------------------\n// Row 17 — full 7x7 boundary cross-product (trapping pairs included)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row17_full_boundary_matrix() {\n    let mut ok = 0usize;\n    let mut trapped = 0usize;\n\n    for &x in BOUNDARIES.iter() {\n        for &y in BOUNDARIES.iter() {\n            if traps(x, y) {\n                // Both sides must die the same way; done out-of-process.\n                let c = common::crash::run_in_child(\"c\", x, y);\n                let r = common::crash::run_in_child(\"rust\", x, y);\n                assert_eq!(c, r, \"driver({x}, {y}) trap outcome diverged\");\n                assert_eq!(c.signal, Some(8), \"expected SIGFPE for driver({x}, {y})\");\n                trapped += 1;\n            } else {\n                assert_same(x, y);\n                ok += 1;\n            }\n        }\n    }\n\n    assert_eq!(ok + trapped, BOUNDARIES.len() * BOUNDARIES.len());\n    // y == 0 for each of the 7 x values, plus INT_MIN / -1.\n    assert_eq!(trapped, 8, \"unexpected number of trapping boundary pairs\");\n    eprintln!(\"row17: {ok} matched, {trapped} trapped identically\");\n}\n\n// ---------------------------------------------------------------------------\n// Rows 18–19 — randomized property-style sweeps\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row18_random_full_range() {\n    let mut rng = Rng::new(0xDEAD_BEEF_1234_5678);\n    let mut pairs = Vec::with_capacity(20_000);\n    while pairs.len() < 20_000 {\n        let x = rng.next_i32();\n        let y = rng.nonzero_i32();\n        if !traps(x, y) {\n            pairs.push((x, y));\n        }\n    }\n    assert_same_all(\"row18 random full range\", pairs);\n}\n\n#[test]\nfn row19_random_small_magnitudes() {\n    let mut rng = Rng::new(0xC0FF_EE00_0BAD_F00D);\n    let mut pairs = Vec::new();\n    // Exhaustive over the dense core: every |x|,|y| <= 24 pair.\n    for x in -24..=24 {\n        for y in -24..=24 {\n            if !traps(x, y) {\n                pairs.push((x, y));\n            }\n        }\n    }\n    // Plus randomized [-64, 64].\n    for _ in 0..2_000 {\n        let x = rng.in_range(-64, 64);\n        let mut y = rng.in_range(-64, 64);\n        if y == 0 {\n            y = 1;\n        }\n        pairs.push((x, y));\n    }\n    assert_same_all(\"row19 small magnitudes\", pairs);\n}\n\n// ---------------------------------------------------------------------------\n// Rows 20–21 — statelessness and shared-stdout buffering parity\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row20_interleaved_calls_are_stateless() {\n    let (c, r) = drivers();\n    let mut rng = Rng::new(0x2020);\n\n    // Alternate C, Rust, C, Rust ... and require every single call to agree.\n    for i in 0..500 {\n        let x = rng.next_i32();\n        let y = rng.nonzero_i32();\n        if traps(x, y) {\n            continue;\n        }\n        let (first, second) = if i % 2 == 0 {\n            let a = capture(\"c\", || unsafe { c(x, y) });\n            let b = capture(\"rust\", || unsafe { r(x, y) });\n            (a, b)\n        } else {\n            let b = capture(\"rust\", || unsafe { r(x, y) });\n            let a = capture(\"c\", || unsafe { c(x, y) });\n            (b, a)\n        };\n        assert_eq!(first, second, \"interleaved driver({x}, {y}) diverged\");\n    }\n\n    // Calling the same side repeatedly must keep producing the same bytes.\n    let once = capture(\"c\", || unsafe { c(-7, 2) });\n    for _ in 0..5 {\n        assert_eq!(capture(\"c\", || unsafe { c(-7, 2) }), once);\n        assert_eq!(capture(\"rust\", || unsafe { r(-7, 2) }), once);\n    }\n}\n\n#[test]\nfn row21_unflushed_multi_call_stream() {\n    let (c, r) = drivers();\n    let mut rng = Rng::new(0x2121);\n\n    let pairs: Vec<(c_int, c_int)> = (0..400)\n        .map(|_| {\n            let x = rng.next_i32();\n            let mut y = rng.nonzero_i32();\n            if x == i32::MIN && y == -1 {\n                y = 1;\n            }\n            (x, y)\n        })\n        .collect();\n\n    // Many calls, a single flush at the very end: compares the whole stream as\n    // it lands in the shared libc `stdout` buffer, not just per-call output.\n    let c_stream = capture(\"c-stream\", || {\n        for &(x, y) in &pairs {\n            unsafe { c(x, y) };\n        }\n    });\n    let r_stream = capture(\"rust-stream\", || {\n        for &(x, y) in &pairs {\n            unsafe { r(x, y) };\n        }\n    });\n\n    assert_eq!(c_stream, r_stream, \"multi-call stdout streams diverged\");\n    assert_eq!(\n        c_stream.iter().filter(|&&b| b == b'\\n').count(),\n        pairs.len(),\n        \"expected exactly one line per call\"\n    );\n\n    // Mixed stream: C and Rust writing into the same unflushed buffer.\n    let mixed_a = capture(\"mixed-a\", || {\n        for &(x, y) in pairs.iter().take(100) {\n            unsafe { c(x, y) };\n            unsafe { r(x, y) };\n        }\n    });\n    let mixed_b = capture(\"mixed-b\", || {\n        for &(x, y) in pairs.iter().take(100) {\n            unsafe { r(x, y) };\n            unsafe { c(x, y) };\n        }\n    });\n    assert_eq!(mixed_a, mixed_b, \"mixed C/Rust stream diverged\");\n}\n\n// ---------------------------------------------------------------------------\n// Which `c_div` arm is compiled in (documents the target cfg axis)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_x86_64_idiv_path_is_active() {\n    if cfg!(target_arch = \"x86_64\") {\n        eprintln!(\"target_arch=x86_64: the inline `cdq; idiv` arm of c_div is under test\");\n    } else {\n        eprintln!(\"non-x86_64: the wrapping_div/wrapping_rem arm of c_div is under test\");\n    }\n    assert_same(-7, 2);\n}\n","userModified":false}}
