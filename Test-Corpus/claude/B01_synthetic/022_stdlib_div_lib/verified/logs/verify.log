,"newLines":283,"lines":["     assert_eq!(clean_c.stdout, b\"quotient: 3, remainder: 1\\n\");","     assert_eq!(clean_c.stdout, clean_r.stdout);"," ","-    let trapped = crash::run_in_child(\"c\", 7, 0);","-    assert_eq!(trapped.signal, Some(SIGFPE));","+    let trapped_c = run_ops_with(&[op(Side::C, 7, 0)], true);","+    let trapped_r = run_ops_with(&[op(Side::Rust, 7, 0)], true);","+    assert_eq!(trapped_c.signal, Some(SIGFPE));","+    assert_eq!(trapped_r.signal, Some(SIGFPE));","+    assert_ne!(clean_c.signal, trapped_c.signal);"," }"," "," // ---------------------------------------------------------------------------","-// ERRORS.md row 2 — INT_MIN / -1","+// ERRORS.md row 2 — INT_MIN / -1 -> SIGFPE"," // ---------------------------------------------------------------------------"," "," #[test]"," fn test_err_row2_int_min_div_neg_one_sigfpe() {","     assert_same_trap(i32::MIN, -1);","+","+    // It is specifically this pair: the near misses must all run cleanly.","+    for (x, y) in [","+        (i32::MIN + 1, -1),","+        (i32::MIN, 1),","+        (i32::MIN, -2),","+        (i32::MIN / 2, -1),","+        (i32::MAX, -1),","+    ] {","+        let c = run_ops_with(&[op(Side::C, x, y)], true);","+        let r = run_ops_with(&[op(Side::Rust, x, y)], true);","+        assert_eq!(c.signal, None, \"C unexpectedly trapped on driver({x}, {y})\");","+        assert_eq!(r.signal, None, \"Rust unexpectedly trapped on driver({x}, {y})\");","+        assert_eq!(c.stdout, r.stdout, \"driver({x}, {y}) diverged\");","+    }"," }"," ","+/// The 64-bit-register variant of row 2: a caller whose upper register halves","+/// hold garbage must still trap, on both sides.","+#[test]","+fn test_err_row2_traps_with_garbage_upper_halves() {","+    let hi = 0x1234_5678_0000_0000u64 as i64;","+    let x = hi | (i32::MIN as u32 as i64);","+    let y = hi | (-1i32 as u32 as i64);","+","+    let c = run_ops_with(&[op_raw(Side::C64, x, y)], true);","+    let r = run_ops_with(&[op_raw(Side::Rust64, x, y)], true);","+    assert_eq!(c.signal, r.signal, \"trap parity with garbage upper halves\");","+    assert_eq!(c.signal, Some(SIGFPE));","+    assert_eq!(c.stdout, r.stdout);","+","+    // ...and the y == 0 trap likewise.","+    let zy = hi; // low half is zero","+    let c = run_ops_with(&[op_raw(Side::C64, hi | 42, zy)], true);","+    let r = run_ops_with(&[op_raw(Side::Rust64, hi | 42, zy)], true);","+    assert_eq!(c.signal, r.signal);","+    assert_eq!(c.signal, Some(SIGFPE));","+    assert_eq!(c.stdout, r.stdout);","+}","+"," // ---------------------------------------------------------------------------"," // Generic boundaries"," // ---------------------------------------------------------------------------"," "," /// The values immediately around both traps must *not* trap, and must match.","-/// This is where an over-eager \"fix\" in the Rust (e.g. `checked_div`) would show","-/// up as a spurious panic or a wrong value.","+/// This is where an over-eager \"fix\" in the Rust (e.g. `checked_div`, or a Rust","+/// `/` that panics on overflow) would show up as a spurious panic or abort."," #[test]"," fn test_trap_neighbours_do_not_trap() {","-    let neighbours: [(c_int, c_int); 14] = [","-        (i32::MIN, 1),     // adjacent to INT_MIN / -1","+    let neighbours: [(c_int, c_int); 16] = [","+        (i32::MIN, 1),      // adjacent to INT_MIN / -1","         (i32::MIN, -2),","         (i32::MIN, 2),","+        (i32::MIN, i32::MIN),","         (i32::MIN + 1, -1), // one step from the trapping dividend","         (i32::MIN + 1, 1),","         (-1, -1),","         (0, -1),","+        (0, 1),","         (1, -1),","-        (i32::MAX, -1),","-        (i32::MAX, 1),","         (1, 1),","-        (0, 1),","         (-1, 1),","-        (i32::MIN, i32::MIN),","+        (i32::MAX, -1),","+        (i32::MAX, 1),","+        (2, -1),","+        (-2, -1),","     ];"," ","     for (x, y) in neighbours {","-        assert!(!common::traps(x, y), \"test bug: ({x}, {y}) is a trapping pair\");","-        assert_same(x, y);","-        // Also confirm out-of-process that neither side dies.","-        let c = crash::run_in_child(\"c\", x, y);","-        let r = crash::run_in_child(\"rust\", x, y);","+        assert!(!traps(x, y), \"test bug: ({x}, {y}) is a trapping pair\");","+        let c = run_ops_with(&[op(Side::C, x, y)], true);","+        let r = run_ops_with(&[op(Side::Rust, x, y)], true);","         assert_eq!(c.signal, None, \"C unexpectedly trapped on driver({x}, {y})\");","-        assert_eq!(r.signal, None, \"Rust unexpectedly trapped on driver({x}, {y})\");","-        assert_eq!(c, r);","+        assert_eq!(","+            r.signal, None,","+            \"Rust unexpectedly trapped on driver({x}, {y})\"","+        );","+        assert_eq!(c.code, Some(0));","+        assert_eq!(r.code, Some(0));","+        assert_eq!(","+            c.stdout,","+            r.stdout,","+            \"driver({x}, {y}) diverged\\n  C   : {:?}\\n  Rust: {:?}\",","+            String::from_utf8_lossy(&c.stdout),","+            String::from_utf8_lossy(&r.stdout)","+        );","     }"," ","     // INT_MIN / -1 traps, but INT_MIN+1 / -1 must produce INT_MAX.","-    let (c_out, r_out) = common::run_both(i32::MIN + 1, -1);","-    assert_eq!(c_out, b\"quotient: 2147483647, remainder: 0\\n\");","-    assert_eq!(c_out, r_out);","+    let c = run_ops(&[op(Side::C, i32::MIN + 1, -1)]);","+    assert_eq!(c.stdout, b\"quotient: 2147483647, remainder: 0\\n\");"," }"," "," /// `int` has no invalid bit patterns, so \"one step past the valid range\" means"," /// crossing every extreme with every other extreme."," #[test]"," fn test_full_int_boundary_matrix() {","-    let extras: [c_int; 5] = [-2, 2, 3, -3, 0];","+    let extras: [c_int; 4] = [-2, 2, 3, -3];","     let all: Vec<c_int> = BOUNDARIES.iter().copied().chain(extras).collect();"," ","-    let mut matched = 0usize;","-    let mut trapped = 0usize;","+    let mut ok = Vec::new();","+    let mut trapping = Vec::new();","     for &x in &all {","         for &y in &all {","-            if common::traps(x, y) {","-                assert_same_trap(x, y);","-                trapped += 1;","+            if traps(x, y) {","+                trapping.push((x, y));","             } else {","-                assert_same(x, y);","-                matched += 1;","+                ok.push((x, y));","             }","         }","     }","-    assert_eq!(matched + trapped, all.len() * all.len());","-    assert!(trapped > 0 && matched > 0);","-    eprintln!(\"boundary matrix: {matched} matched, {trapped} trapped identically\");","+","+    assert_same_all(\"boundary matrix (non-trapping)\", &ok);","+    for (x, y) in trapping.iter().copied() {","+        assert_same_trap(x, y);","+    }","+","+    assert_eq!(ok.len() + trapping.len(), all.len() * all.len());","+    assert!(!ok.is_empty() && !trapping.is_empty());","+    eprintln!(","+        \"boundary matrix: {} matched, {} trapped identically\",","+        ok.len(),","+        trapping.len()","+    );"," }"," ","-/// Extreme magnitudes and the values adjacent to them.","+/// Extreme magnitudes and the values adjacent to them, crossed with each other."," #[test]"," fn test_extremes_and_one_step_past_boundaries() {","-    let interesting: [c_int; 12] = [","+    let interesting: [c_int; 14] = [","         i32::MIN,","         i32::MIN + 1,","         i32::MIN / 2,","+        -65537,","         -65536,","         -256,","         -1,","-        0,","         1,","         256,","         65536,","+        65537,","         i32::MAX / 2,","+        i32::MAX - 1,","         i32::MAX,","     ];","-    for &x in &interesting {","-        for &y in &interesting {","-            if common::traps(x, y) {","-                continue; // covered by rows 1 and 2","-            }","-            assert_same(x, y);","-        }","-    }","+    let pairs: Vec<(c_int, c_int)> = interesting","+        .iter()","+        .flat_map(|&x| interesting.iter().map(move |&y| (x, y)))","+        .filter(|&(x, y)| !traps(x, y)) // traps covered by rows 1 and 2","+        .collect();","+    assert_same_all(\"extremes matrix\", &pairs);"," }"," "," /// The ABI edge every `extern \"C\"` boundary has: a caller that leaves garbage in"," /// the upper halves of the argument registers. Both implementations must look at","-/// the low 32 bits only, and must agree on the result.","+/// the low 32 bits only, and must agree with the clean 32-bit call."," #[test]"," fn test_garbage_in_upper_register_halves() {","-    type Driver64 = unsafe extern \"C\" fn(i64, i64);","-    let (c, r) = drivers();","-    // Re-type the very same exported symbols with 64-bit parameters so the","-    // upper halves carry non-zero bits across the call.","-    let c64: Driver64 = unsafe { std::mem::transmute::<_, Driver64>(c) };","-    let r64: Driver64 = unsafe { std::mem::transmute::<_, Driver64>(r) };","-","     let mut rng = Rng::new(0xABCD_1234);","-    for _ in 0..200 {","+    let mut clean_pairs = Vec::new();","+    let mut c_ops = Vec::new();","+    let mut r_ops = Vec::new();","+","+    for _ in 0..500 {","         let lo_x = rng.next_i32();","         let mut lo_y = rng.nonzero_i32();","         if lo_x == i32::MIN && lo_y == -1 {","             lo_y = 1;","         }","-        let hi_x = (rng.next_u64() as u32 as u64) << 32;","-        let hi_y = (rng.next_u64() as u32 as u64) << 32;","+        // Non-zero garbage in the upper halves.","+        let hi_x = ((rng.next_u64() as u32 as u64) | 1) << 32;","+        let hi_y = ((rng.next_u64() as u32 as u64) | 1) << 32;","         let gx = (hi_x | lo_x as u32 as u64) as i64;","         let gy = (hi_y | lo_y as u32 as u64) as i64;"," ","-        let c_out = common::capture(\"c-garbage\", || unsafe { c64(gx, gy) });","-        let r_out = common::capture(\"rust-garbage\", || unsafe { r64(gx, gy) });","-        assert_eq!(","-            c_out, r_out,","-            \"garbage-high-bits driver({gx:#x}, {gy:#x}) (low halves {lo_x}, {lo_y}) diverged\"","-        );","-        // And it must equal the clean 32-bit call.","-        let (clean_c, _) = common::run_both(lo_x, lo_y);","-        assert_eq!(","-            c_out, clean_c,","-            \"upper register halves changed the result for ({lo_x}, {lo_y})\"","-        );","+        clean_pairs.push((lo_x, lo_y));","+        c_ops.push(op_raw(Side::C64, gx, gy));","+        r_ops.push(op_raw(Side::Rust64, gx, gy));","     }","+","+    let c = run_ops(&c_ops);","+    let r = run_ops(&r_ops);","+    assert_eq!(c.signal, None, \"C worker died: {:?}\", c.signal);","+    assert_eq!(r.signal, None, \"Rust worker died: {:?}\", r.signal);","+    assert_eq!(","+        c.stdout, r.stdout,","+        \"garbage upper register halves produced different output\"","+    );","+","+    // And both must equal the clean 32-bit calls.","+    let clean_c = run_ops(&ops_for(Side::C, &clean_pairs));","+    let clean_r = run_ops(&ops_for(Side::Rust, &clean_pairs));","+    assert_eq!(","+        c.stdout, clean_c.stdout,","+        \"C: upper register halves changed the result\"","+    );","+    assert_eq!(","+        r.stdout, clean_r.stdout,","+        \"Rust: upper register halves changed the result\"","+    );","+    assert_eq!(c.lines().len(), clean_pairs.len());"," }"," ","-/// `driver` returns `void`; make sure neither side leaves a surprise behind by","-/// calling it through a signature that reads a return value. Both must agree","-/// that nothing meaningful is produced *and* neither may crash.","+/// `driver` returns `void` and takes no pointers, so there is no null-pointer or","+/// length parameter to abuse. What *can* be abused is the return value: a caller","+/// that reads one must see both sides behave the same (namely: no crash, and the","+/// same side effect)."," #[test]","-fn test_void_return_is_ignorable() {","-    let (c, r) = drivers();","-    for (x, y) in [(1, 1), (-9, 4), (i32::MAX, 3), (i32::MIN, 7)] {","-        let c_out = common::capture(\"c-void\", || unsafe { c(x, y) });","-        let r_out = common::capture(\"rust-void\", || unsafe { r(x, y) });","-        assert_eq!(c_out, r_out, \"driver({x}, {y}) diverged\");","+fn test_void_return_and_no_pointer_parameters() {","+    let pairs: [(c_int, c_int); 6] = [","+        (1, 1),","+        (-9, 4),","+        (i32::MAX, 3),","+        (i32::MIN, 7),","+        (0, i32::MIN),","+        (i32::MIN, i32::MIN),","+    ];","+    assert_same_all(\"void return\", &pairs);","+","+    // Reading a nonexistent return value must not change behaviour either.","+    type DriverRet = unsafe extern \"C\" fn(c_int, c_int) -> c_int;","+    let (c, r) = common::drivers();","+    let _c_ret: DriverRet = unsafe { std::mem::transmute(c) };","+    let _r_ret: DriverRet = unsafe { std::mem::transmute(r) };","+    // The transmutes themselves are the point: both symbols have the identical","+    // C signature, so an external caller can mis-declare either one the same","+    // way. Behaviour parity is asserted through the batch above.","+    assert_same(-9, 4);","+}","+","+/// A symbol that neither library defines must fail to resolve in *both*, so the","+/// Rust `.so` is not silently exporting extra API surface under a C-looking name","+/// (and so the loader lookups in this harness are genuinely resolving symbols).","+#[test]","+fn test_no_extra_or_missing_public_symbol() {","+    use libloading::{Library, Symbol};","+","+    let c_lib = unsafe { Library::new(common::c_so_path()) }.expect(\"dlopen C\");","+    let r_lib = unsafe { Library::new(common::rust_so_path()) }.expect(\"dlopen Rust\");","+","+    // `driver` resolves in both.","+    unsafe {","+        let cs: Symbol<common::DriverFn> = c_lib.get(b\"driver\\0\").expect(\"C driver\");","+        let rs: Symbol<common::DriverFn> = r_lib.get(b\"driver\\0\").expect(\"Rust driver\");","+        assert!(!(*cs as *const ()).is_null());","+        assert!(!(*rs as *const ()).is_null());","     }","+","+    // A name the C library does not define must not appear in the Rust one.","+    for name in [","+        b\"driver_init\\0\".as_slice(),","+        b\"driver2\\0\".as_slice(),","+        b\"c_div\\0\".as_slice(),","+        b\"driver_ex\\0\".as_slice(),","+    ] {","+        let in_c = unsafe { c_lib.get::<common::DriverFn>(name) }.is_ok();","+        let in_r = unsafe { r_lib.get::<common::DriverFn>(name) }.is_ok();","+        assert_eq!(","+            in_c,","+            in_r,","+            \"symbol {:?}: present in C = {in_c}, present in Rust = {in_r}\",","+            String::from_utf8_lossy(name)","+        );","+        assert!(!in_c, \"test assumption: {:?} should not exist\", String::from_utf8_lossy(name));","+    }"," }"]}],"originalFile":"//! Phase C — error-path differential tests.\n//!\n//! One test per row of `ERRORS.md`, plus the generic FFI-boundary cases.\n//!\n//! `driver` has no software error path (see `ERRORS.md`): its only rejection\n//! behaviour is the `SIGFPE` raised by the `idiv` inside glibc's `div(3)`.\n//! Asserting that requires a *separate process* per call, so these tests\n//! re-exec the test binary and compare the exact termination signal (not merely\n//! \"both failed somehow\") together with the bytes written before the trap.\n\nmod common;\n\nuse common::crash::{self, Outcome};\nuse common::{assert_same, drivers, Rng, BOUNDARIES};\nuse std::ffi::c_int;\n\n/// SIGFPE. `driver` traps rather than returning an error code.\nconst SIGFPE: i32 = 8;\n\n/// Child-side entry point. Inert during a normal test run.\n#[test]\nfn crash_worker() {\n    crash::worker_body();\n}\n\n/// Runs `driver(x, y)` on both sides out-of-process and asserts they terminate\n/// identically, with the same signal and the same pre-trap output.\nfn assert_same_trap(x: c_int, y: c_int) -> Outcome {\n    let c = crash::run_in_child(\"c\", x, y);\n    let r = crash::run_in_child(\"rust\", x, y);\n\n    assert_eq!(\n        c.signal, r.signal,\n        \"driver({x}, {y}): C died with signal {:?}, Rust with {:?}\",\n        c.signal, r.signal\n    );\n    assert_eq!(\n        c.code, r.code,\n        \"driver({x}, {y}): C exit code {:?}, Rust {:?}\",\n        c.code, r.code\n    );\n    assert_eq!(\n        c.stdout, r.stdout,\n        \"driver({x}, {y}): pre-trap output differs\\n  C   : {:?}\\n  Rust: {:?}\",\n        String::from_utf8_lossy(&c.stdout),\n        String::from_utf8_lossy(&r.stdout)\n    );\n    assert_eq!(\n        c.signal,\n        Some(SIGFPE),\n        \"driver({x}, {y}) should die with SIGFPE, got signal={:?} code={:?}\",\n        c.signal,\n        c.code\n    );\n    assert!(\n        c.stdout.is_empty(),\n        \"driver({x}, {y}) trapped before printf, so no output is expected, got {:?}\",\n        String::from_utf8_lossy(&c.stdout)\n    );\n    c\n}\n\n// ---------------------------------------------------------------------------\n// ERRORS.md row 1 — y == 0\n// ---------------------------------------------------------------------------\n\n#[test]\nfn test_err_row1_divide_by_zero_sigfpe() {\n    // Every interesting dividend against the zero divisor, including the\n    // extremes and zero itself.\n    let mut xs: Vec<c_int> = vec![0, 1, -1, 2, -2, 7, -7, 12345, -12345, i32::MAX, i32::MIN, i32::MIN + 1, i32::MAX - 1];\n    let mut rng = Rng::new(0xE001);\n    for _ in 0..6 {\n        xs.push(rng.next_i32());\n    }\n\n    for x in xs {\n        assert_same_trap(x, 0);\n    }\n}\n\n/// The self-check for the harness: it must be able to tell a trap from a clean\n/// run, otherwise row 1 could \"pass\" for the wrong reason.\n#[test]\nfn test_err_harness_distinguishes_trap_from_success() {\n    let clean_c = crash::run_in_child(\"c\", 7, 2);\n    let clean_r = crash::run_in_child(\"rust\", 7, 2);\n    assert_eq!(clean_c.signal, None, \"driver(7, 2) must not trap (C)\");\n    assert_eq!(clean_r.signal, None, \"driver(7, 2) must not trap (Rust)\");\n    assert_eq!(clean_c.code, Some(0));\n    assert_eq!(clean_r.code, Some(0));\n    assert_eq!(clean_c.stdout, b\"quotient: 3, remainder: 1\\n\");\n    assert_eq!(clean_c.stdout, clean_r.stdout);\n\n    let trapped = crash::run_in_child(\"c\", 7, 0);\n    assert_eq!(trapped.signal, Some(SIGFPE));\n}\n\n// ---------------------------------------------------------------------------\n// ERRORS.md row 2 — INT_MIN / -1\n// ---------------------------------------------------------------------------\n\n#[test]\nfn test_err_row2_int_min_div_neg_one_sigfpe() {\n    assert_same_trap(i32::MIN, -1);\n}\n\n// ---------------------------------------------------------------------------\n// Generic boundaries\n// ---------------------------------------------------------------------------\n\n/// The values immediately around both traps must *not* trap, and must match.\n/// This is where an over-eager \"fix\" in the Rust (e.g. `checked_div`) would show\n/// up as a spurious panic or a wrong value.\n#[test]\nfn test_trap_neighbours_do_not_trap() {\n    let neighbours: [(c_int, c_int); 14] = [\n        (i32::MIN, 1),     // adjacent to INT_MIN / -1\n        (i32::MIN, -2),\n        (i32::MIN, 2),\n        (i32::MIN + 1, -1), // one step from the trapping dividend\n        (i32::MIN + 1, 1),\n        (-1, -1),\n        (0, -1),\n        (1, -1),\n        (i32::MAX, -1),\n        (i32::MAX, 1),\n        (1, 1),\n        (0, 1),\n        (-1, 1),\n        (i32::MIN, i32::MIN),\n    ];\n\n    for (x, y) in neighbours {\n        assert!(!common::traps(x, y), \"test bug: ({x}, {y}) is a trapping pair\");\n        assert_same(x, y);\n        // Also confirm out-of-process that neither side dies.\n        let c = crash::run_in_child(\"c\", x, y);\n        let r = crash::run_in_child(\"rust\", x, y);\n        assert_eq!(c.signal, None, \"C unexpectedly trapped on driver({x}, {y})\");\n        assert_eq!(r.signal, None, \"Rust unexpectedly trapped on driver({x}, {y})\");\n        assert_eq!(c, r);\n    }\n\n    // INT_MIN / -1 traps, but INT_MIN+1 / -1 must produce INT_MAX.\n    let (c_out, r_out) = common::run_both(i32::MIN + 1, -1);\n    assert_eq!(c_out, b\"quotient: 2147483647, remainder: 0\\n\");\n    assert_eq!(c_out, r_out);\n}\n\n/// `int` has no invalid bit patterns, so \"one step past the valid range\" means\n/// crossing every extreme with every other extreme.\n#[test]\nfn test_full_int_boundary_matrix() {\n    let extras: [c_int; 5] = [-2, 2, 3, -3, 0];\n    let all: Vec<c_int> = BOUNDARIES.iter().copied().chain(extras).collect();\n\n    let mut matched = 0usize;\n    let mut trapped = 0usize;\n    for &x in &all {\n        for &y in &all {\n            if common::traps(x, y) {\n                assert_same_trap(x, y);\n                trapped += 1;\n            } else {\n                assert_same(x, y);\n                matched += 1;\n            }\n        }\n    }\n    assert_eq!(matched + trapped, all.len() * all.len());\n    assert!(trapped > 0 && matched > 0);\n    eprintln!(\"boundary matrix: {matched} matched, {trapped} trapped identically\");\n}\n\n/// Extreme magnitudes and the values adjacent to them.\n#[test]\nfn test_extremes_and_one_step_past_boundaries() {\n    let interesting: [c_int; 12] = [\n        i32::MIN,\n        i32::MIN + 1,\n        i32::MIN / 2,\n        -65536,\n        -256,\n        -1,\n        0,\n        1,\n        256,\n        65536,\n        i32::MAX / 2,\n        i32::MAX,\n    ];\n    for &x in &interesting {\n        for &y in &interesting {\n            if common::traps(x, y) {\n                continue; // covered by rows 1 and 2\n            }\n            assert_same(x, y);\n        }\n    }\n}\n\n/// The ABI edge every `extern \"C\"` boundary has: a caller that leaves garbage in\n/// the upper halves of the argument registers. Both implementations must look at\n/// the low 32 bits only, and must agree on the result.\n#[test]\nfn test_garbage_in_upper_register_halves() {\n    type Driver64 = unsafe extern \"C\" fn(i64, i64);\n    let (c, r) = drivers();\n    // Re-type the very same exported symbols with 64-bit parameters so the\n    // upper halves carry non-zero bits across the call.\n    let c64: Driver64 = unsafe { std::mem::transmute::<_, Driver64>(c) };\n    let r64: Driver64 = unsafe { std::mem::transmute::<_, Driver64>(r) };\n\n    let mut rng = Rng::new(0xABCD_1234);\n    for _ in 0..200 {\n        let lo_x = rng.next_i32();\n        let mut lo_y = rng.nonzero_i32();\n        if lo_x == i32::MIN && lo_y == -1 {\n            lo_y = 1;\n        }\n        let hi_x = (rng.next_u64() as u32 as u64) << 32;\n        let hi_y = (rng.next_u64() as u32 as u64) << 32;\n        let gx = (hi_x | lo_x as u32 as u64) as i64;\n        let gy = (hi_y | lo_y as u32 as u64) as i64;\n\n        let c_out = common::capture(\"c-garbage\", || unsafe { c64(gx, gy) });\n        let r_out = common::capture(\"rust-garbage\", || unsafe { r64(gx, gy) });\n        assert_eq!(\n            c_out, r_out,\n            \"garbage-high-bits driver({gx:#x}, {gy:#x}) (low halves {lo_x}, {lo_y}) diverged\"\n        );\n        // And it must equal the clean 32-bit call.\n        let (clean_c, _) = common::run_both(lo_x, lo_y);\n        assert_eq!(\n            c_out, clean_c,\n            \"upper register halves changed the result for ({lo_x}, {lo_y})\"\n        );\n    }\n}\n\n/// `driver` returns `void`; make sure neither side leaves a surprise behind by\n/// calling it through a signature that reads a return value. Both must agree\n/// that nothing meaningful is produced *and* neither may crash.\n#[test]\nfn test_void_return_is_ignorable() {\n    let (c, r) = drivers();\n    for (x, y) in [(1, 1), (-9, 4), (i32::MAX, 3), (i32::MIN, 7)] {\n        let c_out = common::capture(\"c-void\", || unsafe { c(x, y) });\n        let r_out = common::capture(\"rust-void\", || unsafe { r(x, y) });\n        assert_eq!(c_out, r_out, \"driver({x}, {y}) diverged\");\n    }\n}\n","userModified":false}}
