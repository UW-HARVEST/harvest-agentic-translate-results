{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_vfvjcdn4zhhn4ian6j2sdvwu2xj2waxdyu45yh47bkdu4xbx4jga","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01CoE6mVhsLDAY4zEiFUnAyC","name":"Write","input":{"file_path":"/tmp/harvest-work-Zv5Er5/translated_rust/tests/static_sum.rs","content":"// Integration test: compares `static_sum` exported by the C and Rust .so files.\n//\n// `static_sum` maintains a running total in a static (process-wide for C,\n// thread-local for the Rust translation, which is equivalent for the\n// single-threaded reference program). We exercise the function with a\n// deterministic sequence of updates and assert that BOTH libraries\n// produce the exact same sequence of return values.\n\nmod common;\n\nuse libloading::{Library, Symbol};\n\ntype StaticSum = unsafe extern \"C\" fn(update: i32) -> i32;\n\nfn collect_outputs(lib: &Library, updates: &[i32]) -> Vec<i32> {\n    unsafe {\n        let f: Symbol<StaticSum> = lib\n            .get(b\"static_sum\\0\")\n            .expect(\"static_sum not exported\");\n        updates.iter().map(|u| f(*u)).collect()\n    }\n}\n\n#[test]\nfn static_sum_matches_c_for_simple_sequence() {\n    // Each library is freshly loaded -> static state starts at 0.\n    let c_lib = unsafe { Library::new(common::c_so_path()).expect(\"load C .so\") };\n    let r_lib = unsafe { Library::new(common::rust_so_path()).expect(\"load Rust .so\") };\n\n    // Mirror the C program's loop behavior with stride = 3.\n    let stride = 3i32;\n    let updates: Vec<i32> = (0..10).map(|i| i * stride).collect();\n\n    let c_out = collect_outputs(&c_lib, &updates);\n    let r_out = collect_outputs(&r_lib, &updates);\n\n    assert_eq!(\n        c_out, r_out,\n        \"static_sum outputs differ (stride=3): C={:?}, Rust={:?}\",\n        c_out, r_out\n    );\n}\n\n#[test]\nfn static_sum_matches_c_for_zero_stride() {\n    let c_lib = unsafe { Library::new(common::c_so_path()).expect(\"load C .so\") };\n    let r_lib = unsafe { Library::new(common::rust_so_path()).expect(\"load Rust .so\") };\n\n    let updates: Vec<i32> = (0..10).map(|i| i * 0).collect();\n\n    let c_out = collect_outputs(&c_lib, &updates);\n    let r_out = collect_outputs(&r_lib, &updates);\n\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn static_sum_matches_c_for_negative_stride() {\n    let c_lib = unsafe { Library::new(common::c_so_path()).expect(\"load C .so\") };\n    let r_lib = unsafe { Library::new(common::rust_so_path()).expect(\"load Rust .so\") };\n\n    let stride = -7i32;\n    let updates: Vec<i32> = (0..10).map(|i: i32| i.wrapping_mul(stride)).collect();\n\n    let c_out = collect_outputs(&c_lib, &updates);\n    let r_out = collect_outputs(&r_lib, &updates);\n\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn static_sum_matches_c_with_overflow_wrapping() {\n    // Use an update sequence that overflows i32 to confirm both\n    // libraries produce the same two's-complement wraparound.\n    let c_lib = unsafe { Library::new(common::c_so_path()).expect(\"load C .so\") };\n    let r_lib = unsafe { Library::new(common::rust_so_path()).expect(\"load Rust .so\") };\n\n    let updates: Vec<i32> = vec![\n        i32::MAX,\n        1,\n        i32::MAX,\n        i32::MIN,\n        -1,\n        -1,\n        i32::MIN,\n        100,\n        -100,\n        0,\n    ];\n\n    let c_out = collect_outputs(&c_lib, &updates);\n    let r_out = collect_outputs(&r_lib, &updates);\n\n    assert_eq!(\n        c_out, r_out,\n        \"static_sum overflow wrap mismatch: C={:?}, Rust={:?}\",\n        c_out, r_out\n    );\n}\n\n#[test]\nfn static_sum_state_is_per_load() {\n    // Loading the library twice should give independent state in the\n    // second load (because `dlopen`/libloading reuses the same .so;\n    // however, both libraries will reflect cumulative state from any\n    // previous calls inside this test process). To keep the test\n    // deterministic, we just verify that BOTH C and Rust libraries\n    // accumulate the same final value over the same call sequence,\n    // which is what the program actually depends on.\n    let c_lib = unsafe { Library::new(common::c_so_path()).expect(\"load C .so\") };\n    let r_lib = unsafe { Library::new(common::rust_so_path()).expect(\"load Rust .so\") };\n\n    let updates: Vec<i32> = (1..=20).collect();\n    let c_out = collect_outputs(&c_lib, &updates);\n    let r_out = collect_outputs(&r_lib, &updates);\n    assert_eq!(c_out, r_out);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":601,"cache_read_input_tokens":22975,"cache_creation":{"ephemeral_5m_input_tokens":601,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c53a6c3c-0351-4121-8e06-39bbb336496a","uuid":"cc7fe6df-bd2e-47ba-90e3-7e97e9048cb2"}
