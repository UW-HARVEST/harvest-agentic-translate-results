arget\").join(&profile).join(\"libdriver.so\");\n\n    // Build the cdylib with the `export_main` feature once per test\n    // process so the .so we load exposes both `main` and `static_sum`,\n    // mirroring the C library's exported symbol set.\n    BUILD_RUST_SO.call_once(|| {\n        let mut cmd = Command::new(env!(\"CARGO\"));\n        cmd.arg(\"build\").arg(\"--lib\").arg(\"--features\").arg(\"export_main\");\n        if profile == \"release\" {\n            cmd.arg(\"--release\");\n        }\n        // Avoid recursive cargo locks; use a separate target dir if needed.\n        let status = cmd.status().expect(\"invoke cargo build for cdylib\");\n        assert!(status.success(), \"cargo build of cdylib failed\");\n    });\n\n    assert!(\n        so.exists(),\n        \"Rust shared library missing at {:?} after build\",\n        so\n    );\n    so\n}\n\n// Serialize tests that touch the static state in `static_sum`.\n//\n// The C library uses a process-global `static int sum`, while the Rust\n// translation uses a `thread_local!` cell. To compare them apples-to-\n// apples, every test runs single-threaded under this lock and runs both\n// the C and Rust call sequence on the same OS thread.\n//\n// `cargo test` would otherwise run tests across multiple threads,\n// which would expose the C/Rust storage-class difference.\npub static SUM_LOCK: Mutex<()> = Mutex::new(());\n","structuredPatch":[{"oldStart":4,"oldLines":8,"newStart":4,"newLines":7,"lines":[" // compare their externally observable behavior through their C ABI exports."," "," use std::path::PathBuf;","-use std::process::Command;","-use std::sync::{Mutex, Once};","+use std::sync::Mutex;"," "," pub fn c_so_path() -> PathBuf {","     let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));"]},{"oldStart":18,"oldLines":33,"newStart":17,"newLines":20,"lines":["     p"," }"," ","-static BUILD_RUST_SO: Once = Once::new();","-"," pub fn rust_so_path() -> PathBuf {","-    let manifest = PathBuf::from(env