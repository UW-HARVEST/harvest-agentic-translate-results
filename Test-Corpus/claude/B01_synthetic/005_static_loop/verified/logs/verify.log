th the C `.so`\n//! and the Rust `.so` (CONFIGS.md rows 1–9).\n\nmod common;\n\nuse common::{fresh_pair, Rng, SEED};\n\nconst TAG: &str = \"ffi_static_sum\";\n\n/// Runs the same call sequence on both libraries and compares every result.\nfn compare_sequence(updates: &[i32]) {\n    let pair = fresh_pair(TAG);\n    for (i, &u) in updates.iter().enumerate() {\n        let c = pair.c.static_sum(u);\n        let r = pair.rust.static_sum(u);\n        assert_eq!(\n            c, r,\n            \"static_sum divergence at call #{i} (update = {u}) in sequence {updates:?}\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 1, 2 ---\n\n#[test]\nfn ffi_static_sum_single() {\n    // row 1: a single call with 0.\n    compare_sequence(&[0]);\n\n    // row 2: single call, small/typical values plus randomized ones.\n    for u in [1, -1, 2, -2, 7, -7, 100, -100, 12345, -12345] {\n        compare_sequence(&[u]);\n    }\n    let mut rng = Rng::new(SEED ^ 0x11);\n    for _ in 0..200 {\n        let small = (rng.below(2001) as i64 - 1000) as i32;\n        compare_sequence(&[small]);\n    }\n}\n\n// ------------------------------------------------------------------- row 3 ---\n\n#[test]\nfn ffi_static_sum_boundaries() {\n    let mut values = vec![\n        i32::MAX,\n        i32::MIN,\n        i32::MAX - 1,\n        i32::MIN + 1,\n        0,\n        1,\n        -1,\n        i32::MAX / 2,\n        i32::MIN / 2,\n    ];\n    for k in 0..32 {\n        values.push(1i32.wrapping_shl(k));\n        values.push((1i32.wrapping_shl(k)).wrapping_neg());\n    }\n    for v in values {\n        compare_sequence(&[v]);\n        compare_sequence(&[v, v]);\n        compare_sequence(&[v, 1, v, -1]);\n    }\n}\n\n// ---------------------------------------------------------------- row 4, 5 ---\n\n#[test]\nfn ffi_static_sum_sequences() {\n    let mut rng = Rng::new(SEED ^ 0x22);\n\n    // row 4: two calls, mixed signs.\n    for _ in 0..100 {\n        let a = (rng.below(200_001) as i64 - 100_000) as i32;\n        let b = (rng.below(200_001) as i64 - 100_000) as i32;\n        compare_sequence(&[a, b]);\n    }\n\n    // row 5: exactly ten calls, mirroring what `main` does.\n    for _ in 0..60 {\n        let stride = rng.next_i32();\n        let seq: Vec<i32> = (0..10).map(|i| (i as i32).wrapping_mul(stride)).collect();\n        compare_sequence(&seq);\n    }\n\n    // row 6: 1..=64 calls of full-range random i32.\n    for len in 1..=64usize {\n        let seq: Vec<i32> = (0..len).map(|_| rng.next_i32()).collect();\n        compare_sequence(&seq);\n    }\n    for _ in 0..60 {\n        let len = 1 + rng.below(64) as usize;\n        let seq: Vec<i32> = (0..len).map(|_| rng.next_i32()).collect();\n        compare_sequence(&seq);\n    }\n}\n\n// ------------------------------------------------------------------- row 7 ---\n\n#[test]\nfn ffi_static_sum_overflow() {\n    // Deliberate signed overflow of `sum += update` (UB in C, wraps on the\n    // target ABI). Both builds must wrap identically.\n    compare_sequence(&[i32::MAX, i32::MAX]);\n    compare_sequence(&[i32::MAX, 1]);\n    compare_sequence(&[i32::MIN, -1]);\n    compare_sequence(&[i32::MIN, i32::MIN]);\n    compare_sequence(&[i32::MAX; 8]);\n    compare_sequence(&[i32::MIN; 8]);\n    compare_sequence(&[1 << 30; 16]);\n    compare_sequence(&[-(1 << 30); 16]);\n    compare_sequence(&[i32::MAX, i32::MIN, i32::MAX, i32::MIN, 1, -1]);\n\n    let mut rng = Rng::new(SEED ^ 0x33);\n    for _ in 0..100 {\n        // Bias towards huge magnitudes so the accumulator keeps wrapping.\n        let seq: Vec<i32> = (0..16)\n            .map(|_| {\n                let v = rng.next_i32();\n                if v % 2 == 0 {\n                    v | (1 << 30)\n                } else {\n                    v\n                }\n            })\n            .collect();\n        compare_sequence(&seq);\n    }\n}\n\n// ------------------------------------------------------------------- row 8 ---\n\n#[test]\nfn ffi_state_is_per_instance() {\n    // Two independently loaded copies must each start from sum == 0, in both\n    // implementations (this validates the test methodology *and* that Rust's\n    // static has the same storage duration semantics as C's).\n    let a = fresh_pair(TAG);\n    assert_eq!(a.c.static_sum(10), 10);\n    assert_eq!(a.rust.static_sum(10), 10);\n    assert_eq!(a.c.static_sum(5), 15);\n    assert_eq!(a.rust.static_sum(5), 15);\n\n    let b = fresh_pair(TAG);\n    assert_eq!(b.c.static_sum(7), a.rust.static_sum(0) - 15 + 7);\n    assert_eq!(b.rust.static_sum(0), 7);\n\n    // ... and the first pair kept its own state.\n    assert_eq!(a.c.static_sum(0), 15);\n    assert_eq!(a.rust.static_sum(0), 15);\n}\n\n// ------------------------------------------------------------------- row 9 ---\n\n#[test]\nfn ffi_state_shared_between_entry_points() {\n    // `main` must observe the very same `sum` that direct `static_sum` calls\n    // updated (one static per process/library instance, not one per caller).\n    for pre in [1i32, -5, 1_000_000, i32::MAX, i32::MIN] {\n        let pair = fresh_pair(TAG);\n        assert_eq!(pair.c.static_sum(pre), pair.rust.static_sum(pre));\n\n        let args = vec![b\"driver\".to_vec(), b\"3\".to_vec()];\n        let (rc_c, out_c) = pair.c.call_main_auto(&args);\n        let (rc_r, out_r) = pair.rust.call_main_auto(&args);\n        assert_eq!(rc_c, rc_r, \"return value differs (pre = {pre})\");\n        assert_eq!(\n            String::from_utf8_lossy(&out_c),\n            String::from_utf8_lossy(&out_r),\n            \"stdout differs after static_sum({pre})\"\n        );\n\n        // ... and afterwards the running total is still in lock-step.\n        assert_eq!(pair.c.static_sum(0), pair.rust.static_sum(0));\n    }\n}\n","userModified":false}}
