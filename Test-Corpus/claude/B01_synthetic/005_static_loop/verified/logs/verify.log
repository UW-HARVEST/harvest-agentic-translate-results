44\t/// default (\"C\") locale, which `strtol` skips before the number.\n45\tfn is_c_space(b: u8) -> bool {\n46\t    b == b' ' || (0x09..=0x0d).contains(&b)\n47\t}\n48\t\n49\t/// Faithful re-implementation of `strtol(nptr, &end, 10)`.\n50\t///\n51\t/// Returns the converted value together with the byte offset that C would\n52\t/// store into `end`. When no conversion can be performed the offset is 0,\n53\t/// i.e. `end == nptr`.\n54\tfn strtol_base10(s: &[u8]) -> (i64, usize) {\n55\t    let mut i = 0usize;\n56\t\n57\t    // Skip leading white space.\n58\t    while i < s.len() && is_c_space(s[i]) {\n59\t        i += 1;\n60\t    }\n61\t\n62\t    // Optional sign.\n63\t    let mut negative = false;\n64\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n65\t        negative = s[i] == b'-';\n66\t        i += 1;\n67\t    }\n68\t\n69\t    // Digits. Saturate like strtol does (returns LONG_MAX / LONG_MIN).\n70\t    let cutoff: u64 = if negative {\n71\t        (i64::MAX as u64) + 1 // magnitude of LONG_MIN\n72\t    } else {\n73\t        i64::MAX as u64\n74\t    };\n75\t    let cutlim = cutoff % 10;\n76\t    let cutdiv = cutoff / 10;\n77\t\n78\t    let digits_start = i;\n79\t    let mut acc: u64 = 0;\n80\t    let mut overflow = false;\n81\t    while i < s.len() && s[i].is_ascii_digit() {\n82\t        let digit = u64::from(s[i] - b'0');\n83\t        if overflow || acc > cutdiv || (acc == cutdiv && digit > cutlim) {\n84\t            overflow = true;\n85\t        } else {\n86\t            acc = acc * 10 + digit;\n87\t        }\n88\t        i += 1;\n89\t    }\n90\t\n91\t    if i == digits_start {\n92\t        // No digits consumed: no conversion performed, end == nptr.\n93\t        return (0, 0);\n94\t    }\n95\t\n96\t    let value = if overflow {\n97\t        if negative {\n98\t            i64::MIN\n99\t        } else {\n100\t            i64::MAX\n101\t        }\n102\t    } else if negative {\n103\t        (acc as i64).wrapping_neg()\n104\t    } else {\n105\t        acc as