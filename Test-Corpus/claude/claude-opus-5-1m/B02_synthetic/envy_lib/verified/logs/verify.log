s, off);\n    let p = unsafe { buf.as_mut_ptr().add(off) } as *mut u32;\n    let ret = unsafe { (imp.apply_bit_operations)(value, p) };\n    fold(&buf, ret)\n}\n\npub fn call_init_unaligned(imp: &Impl, bits: u32, off: usize) -> i64 {\n    let mut buf = scratch_with(bits, off);\n    let p = unsafe { buf.as_mut_ptr().add(off) } as *mut u32;\n    unsafe { (imp.init_config_from_env)(p) };\n    fold(&buf, 0)\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2237,"cache_read_input_tokens":158269,"cache_creation":{"ephemeral_5m_input_tokens":2237,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"45b2afad-fa3f-48e7-8b2b-5e23c8be9782","uuid":"641e845c-b5c5-457b-a353-b7dcdf4e8223","timestamp":"2026-08-19T19:56:17.312Z"}
