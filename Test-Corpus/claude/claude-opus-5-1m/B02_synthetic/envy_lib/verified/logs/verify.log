{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ibin6kfygjzzibjxdqz5atm5jtgumsyt6bq4olcskp3b3qhhb6ua","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_014HymW6TuSv7KMUEXbUt31H","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-TN1Py3/translated_rust/tests/phase_b_lowlevel.rs","content":"// Phase B — valid-path differential tests for the LOW-LEVEL entry points.\n//\n// Covers CONFIGS.md rows 1-22 and row 33 (the hand-composed pipeline).\n//\n// The whole phase runs inside a single `#[test]` function on purpose: the\n// harness redirects the process-wide file descriptors 1 and 2 in order to\n// capture what the shared objects print, so no other test may run (or print)\n// concurrently.\n\nmod harness;\n\nuse harness::*;\nuse std::ffi::CString;\n\n#[test]\nfn phase_b_lowlevel() {\n    let _guard = GLOBAL.lock().unwrap();\n    let (c, r) = load_impls();\n    println!(\"C   : {}\", c.path.display());\n    println!(\"RUST: {}\", r.path.display());\n\n    let mut fails = Vec::new();\n    let mut n = 0usize;\n    let mut rng = Rng::new(SEED);\n    clear_prog_env();\n\n    let mut cap = Capture::new(\"phase-b-low\");\n\n    // ------------------------------------------------------------------\n    // Rows 1-9: parse_env_numeric\n    // ------------------------------------------------------------------\n    let names: [&str; 5] = [\n        \"PROG_BASE_OFFSET\",\n        \"PROG_MULTIPLIER\",\n        \"PROG_VERBOSE\",\n        \"DIFFTEST_UNUSED_NAME\",\n        \"\",\n    ];\n    let defaults: [i32; 8] = [\n        0,\n        1,\n        -1,\n        64,\n        10,\n        i32::MAX,\n        i32::MIN,\n        0x1234_5678,\n    ];\n\n    for name in names {\n        let cname = CString::new(name).unwrap();\n        for shape in NUMERIC_SHAPES {\n            // Row 5 also needs the *name* to be absent, which `\"\"` provides.\n            if !name.is_empty() {\n                put_env(name, shape);\n            }\n            for d in defaults {\n                let label = format!(\n                    \"rows1-9 parse_env_numeric name={name:?} value={shape:?} default={d}\"\n                );\n                differential(&mut fails, &mut cap, &c, &r, &label, |imp| {\n                    call_parse(imp, &cname, d)\n                });\n                n += 1;\n            }\n            if !name.is_empty() {\n                put_env(name, None);\n            }\n        }\n    }\n\n    // Randomised numeric strings (row 2/3/9) and randomly poisoned strings\n    // (rows 6/7/8).\n    for _ in 0..1500 {\n        let kind = rng.next_u64() % 6;\n        let v = rng.next_u64();\n        let s = match kind {\n            0 => format!(\"{}\", v as i32),\n            1 => format!(\"{}\", v as i64),\n            2 => format!(\"{}\", v),\n            3 => format!(\"{}{}\", v as i16, if v & 1 == 0 { \",\" } else { \";\" }),\n            4 => format!(\n                \"{}{}{}\",\n                if v & 2 == 0 { \",\" } else { \";\" },\n                v as i32,\n                if v & 4 == 0 { \",\" } else { \";\" }\n            ),\n            _ => format!(\"{:x}zz{}\", v as u16, v as i8),\n        };\n        put_env(\"PROG_BASE_OFFSET\", Some(&s));\n        let cname = CString::new(\"PROG_BASE_OFFSET\").unwrap();\n        let d = rng.next_interesting_i32();\n        let label = format!(\"rows2-9 parse_env_numeric random value={s:?} default={d}\");\n        differential(&mut fails, &mut cap, &c, &r, &label, |imp| {\n            call_parse(imp, &cname, d)\n        });\n        n += 1;\n    }\n    put_env(\"PROG_BASE_OFFSET\", None);\n\n    // ------------------------------------------------------------------\n    // Rows 10-11: init_config_from_env over all 3x3x2 environment states,\n    // with three different pre-fills of the destination bit-field unit.\n    // ------------------------------------------------------------------\n    let prefills_fixed: [u32; 6] = [\n        0x0000_0000,\n        0xFFFF_FFFF,\n        0xDEAD_BEEF,\n        0x0000_00FF,\n        0x8000_0080,\n        0x5555_5555,\n    ];\n    for v in VERBOSE_STATES_WIDE {\n        for d in [None, Some(\"\"), Some(\"0\"), Some(\"1\"), Some(\"zz1\")] {\n            for o in OPTIMIZE_STATES_WIDE {\n                put_env(\"PROG_VERBOSE\", v);\n                put_env(\"PROG_DEBUG\", d);\n                put_env(\"PROG_OPTIMIZE\", o);\n                for prefill in prefills_fixed.iter().copied().chain((0..4).map(|_| 0)) {\n                    let prefill = if prefill == 0 { rng.next_u32() } else { prefill };\n                    let label = format!(\n                        \"rows10-11 init_config_from_env V={v:?} D={d:?} O={o:?} prefill=0x{prefill:08x}\"\n                    );\n                    differential(&mut fails, &mut cap, &c, &r, &label, |imp| {\n                        call_init(imp, prefill)\n                    });\n                    n += 1;\n                }\n            }\n        }\n    }\n    clear_prog_env();\n\n    // ------------------------------------------------------------------\n    // Rows 12-17: perform_operation\n    // ------------------------------------------------------------------\n    // Rows 12/13/14/15: explicit optimize x log_level x debug matrix over\n    // boundary values and randomised values.\n    for optimize in [false, true] {\n        for debug in [false, true] {\n            for log_level in 0..8u32 {\n                for cache in [false, true] {\n                    for verbose in [false, true] {\n                        let bits = flags(verbose, debug, optimize, cache, log_level);\n                        for v1 in BOUNDARY_I32 {\n                            for v2 in BOUNDARY_I32 {\n                                let label = format!(\n                                    \"rows12-15 perform_operation bits=0x{bits:02x} v1={v1} v2={v2}\"\n                                );\n                                differential(&mut fails, &mut cap, &c, &r, &label, |imp| {\n                                    call_perform(imp, v1, v2, bits)\n                                });\n                                n += 1;\n                            }\n                        }\n                        for _ in 0..12 {\n                            let v1 = rng.next_interesting_i32();\n                            let v2 = rng.next_interesting_i32();\n                            let label = format!(\n                                \"rows12-15 perform_operation random bits=0x{bits:02x} v1={v1} v2={v2}\"\n                            );\n                            differential(&mut fails, &mut cap, &c, &r, &label, |imp| {\n                                call_perform(imp, v1, v2, bits)\n                            });\n                            n += 1;\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    // Rows 16/17: every one of the 256 low-byte patterns, with clean and with\n    // garbage padding bits.\n    for low in 0..256u32 {\n        for pad in [0x0000_0000u32, 0xDEAD_BE00, 0xFFFF_FF00, 0x1234_5600] {\n            let bits = pad | low;\n            for _ in 0..3 {\n                let v1 = rng.next_interesting_i32();\n                let v2 = rng.next_interesting_i32();\n                let label =\n                    format!(\"rows16-17 perform_operation bits=0x{bits:08x} v1={v1} v2={v2}\");\n                differential(&mut fails, &mut cap, &c, &r, &label, |imp| {\n                    call_perform(imp, v1, v2, bits)\n                });\n                n += 1;\n            }\n        }\n    }\n\n    // ------------------------------------------------------------------\n    // Rows 18-22: apply_bit_operations\n    // ------------------------------------------------------------------\n    for verbose in [false, true] {\n        for cache in [false, true] {\n            for log_level in [0u32, 3, 7] {\n                for debug in [false, true] {\n                    let bits = flags(verbose, debug, false, cache, log_level);\n                    for value in BOUNDARY_I32 {\n                        let label =\n                            format!(\"rows18-21 apply_bit_operations bits=0x{bits:02x} value={value}\");\n                        differential(&mut fails, &mut cap, &c, &r, &label, |imp| {\n                            call_apply(imp, value, bits)\n                        });\n                        n += 1;\n                    }\n                    for extra in [\n                        0x3FFF_FFFF,\n                        0x4000_0001,\n                        -0x4000_0001,\n                        0x7FFF_FFFF,\n                        -0x7FFF_FFFF,\n                        0x0000_000F,\n                        -16,\n                        -15,\n                    ] {\n                        let label = format!(\n                            \"rows18-21 apply_bit_operations shift-edge bits=0x{bits:02x} value={extra}\"\n                        );\n                        differential(&mut fails, &mut cap, &c, &r, &label, |imp| {\n                            call_apply(imp, extra, bits)\n                        });\n                        n += 1;\n                    }\n                    for _ in 0..10 {\n                        let value = rng.next_interesting_i32();\n                        let label = format!(\n                            \"rows18-21 apply_bit_operations random bits=0x{bits:02x} value={value}\"\n                        );\n                        differential(&mut fails, &mut cap, &c, &r, &label, |imp| {\n                            call_apply(imp, value, bits)\n                        });\n                        n += 1;\n                    }\n                }\n            }\n        }\n    }\n\n    // Row 22: all 256 low-byte patterns x padding garbage.\n    for low in 0..256u32 {\n        for pad in [0x0000_0000u32, 0xDEAD_BE00, 0xFFFF_FF00] {\n            let bits = pad | low;\n            for _ in 0..3 {\n                let value = rng.next_interesting_i32();\n                let label = format!(\"row22 apply_bit_operations bits=0x{bits:08x} value={value}\");\n                differential(&mut fails, &mut cap, &c, &r, &label, |imp| {\n                    call_apply(imp, value, bits)\n                });\n                n += 1;\n            }\n        }\n    }\n\n    // ------------------------------------------------------------------\n    // Row 33: the pipeline, composed by hand out of the low-level entry\n    // points exactly like `envy` composes it, plus cross-implementation\n    // chains (C flags -> Rust arithmetic and vice versa).\n    // ------------------------------------------------------------------\n    let base_name = CString::new(\"PROG_BASE_OFFSET\").unwrap();\n    let mult_name = CString::new(\"PROG_MULTIPLIER\").unwrap();\n\n    for v in VERBOSE_STATES {\n        for d in DEBUG_STATES {\n            for o in OPTIMIZE_STATES {\n                for base in [None, Some(\"64\"), Some(\"-1000000\"), Some(\"x,y\"), Some(\"abc\")] {\n                    for mult in [None, Some(\"10\"), Some(\"-3\"), Some(\"9;9\")] {\n                        let env = EnvCfg {\n                            verbose: v,\n                            debug: d,\n                            optimize: o,\n                            base_offset: base,\n                            multiplier: mult,\n                        };\n                        apply_env(&env);\n                        for _ in 0..3 {\n                            let p1 = rng.next_interesting_i32();\n                            let p2 = rng.next_interesting_i32();\n                            let p3 = rng.next_interesting_i32();\n                            let p4 = rng.next_interesting_i32();\n                            let label = format!(\n                                \"row33 pipeline env={env:?} p={p1},{p2},{p3},{p4}\"\n                            );\n\n                            // Pure chain: every step from the same implementation.\n                            differential(&mut fails, &mut cap, &c, &r, &label, |imp| {\n                                pipeline(imp, imp, imp, &base_name, &mult_name, p1, p2, p3, p4)\n                            });\n                            n += 1;\n\n                            // Cross chain A: flags + parse from C, arithmetic from\n                            // the implementation under test.\n                            let cross_a = format!(\"{label} [cross: init/parse from C]\");\n                            differential(&mut fails, &mut cap, &c, &r, &cross_a, |imp| {\n                                pipeline(&c, imp, &c, &base_name, &mult_name, p1, p2, p3, p4)\n                            });\n                            n += 1;\n\n                            // Cross chain B: arithmetic from C, flags + parse from\n                            // the implementation under test.\n                            let cross_b = format!(\"{label} [cross: arithmetic from C]\");\n                            differential(&mut fails, &mut cap, &c, &r, &cross_b, |imp| {\n                                pipeline(imp, &c, imp, &base_name, &mult_name, p1, p2, p3, p4)\n                            });\n                            n += 1;\n                        }\n                    }\n                }\n            }\n        }\n    }\n    clear_prog_env();\n\n    drop(cap);\n    report(fails, n, \"phase B (low-level entry points)\");\n}\n\n/// Re-implements `envy`'s body out of the exported low-level functions.\n/// `flags_from` runs `init_config_from_env`, `arith` runs `perform_operation`\n/// and `apply_bit_operations`, `parse_from` runs `parse_env_numeric`.\n#[allow(clippy::too_many_arguments)]\nfn pipeline(\n    flags_from: &Impl,\n    arith: &Impl,\n    parse_from: &Impl,\n    base_name: &CString,\n    mult_name: &CString,\n    p1: i32,\n    p2: i32,\n    p3: i32,\n    p4: i32,\n) -> i64 {\n    let mut bits: u32 = 0;\n    unsafe { (flags_from.init_config_from_env)(&mut bits) };\n    let base_offset = unsafe { (parse_from.parse_env_numeric)(base_name.as_ptr(), 0o100) };\n    let multiplier = unsafe { (parse_from.parse_env_numeric)(mult_name.as_ptr(), 0o12) };\n\n    let mut result = unsafe { (arith.perform_operation)(p1, p2, &mut bits) };\n    if p3 != 0 {\n        result = result.wrapping_add(p3.wrapping_mul(multiplier));\n    }\n    if p4 != 0 {\n        result = result.wrapping_add(p4 >> 2);\n    }\n    result = unsafe { (arith.apply_bit_operations)(result, &mut bits) };\n    result = result.wrapping_add(base_offset);\n    if result < 0 {\n        result = p1;\n    }\n    ((bits as u64) << 32 | (result as u32 as u64)) as i64\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13011,"cache_read_input_tokens":55341,"cache_creation":{"ephemeral_5m_input_tokens":13011,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"45b2afad-fa3f-48e7-8b2b-5e23c8be9782","uuid":"52eeaaf8-0480-4752-bd61-9b7651f8386c","timestamp":"2026-08-19T19:40:12.397Z"}
