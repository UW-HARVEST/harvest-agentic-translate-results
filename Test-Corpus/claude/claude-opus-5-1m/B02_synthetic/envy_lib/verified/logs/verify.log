 ---------------------------------------------------------------------------\n37\t\n38\t/// Opaque stand-in for `FILE`.\n39\t#[repr(C)]\n40\tpub struct FILE {\n41\t    _opaque: [u8; 0],\n42\t}\n43\t\n44\tunsafe extern \"C\" {\n45\t    static mut stderr: *mut FILE;\n46\t\n47\t    fn getenv(name: *const c_char) -> *mut c_char;\n48\t    fn atoi(s: *const c_char) -> c_int;\n49\t    fn strchr(s: *const c_char, c: c_int) -> *mut c_char;\n50\t    fn memcpy(dest: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n51\t\n52\t    fn printf(fmt: *const c_char, ...) -> c_int;\n53\t    fn fprintf(stream: *mut FILE, fmt: *const c_char, ...) -> c_int;\n54\t    fn snprintf(buf: *mut c_char, size: usize, fmt: *const c_char, ...) -> c_int;\n55\t}\n56\t\n57\t// ---------------------------------------------------------------------------\n58\t// Types\n59\t// ---------------------------------------------------------------------------\n60\t\n61\t/// ```c\n62\t/// struct ConfigFlags {\n63\t///     unsigned int verbose : 1;\n64\t///     unsigned int debug : 1;\n65\t///     unsigned int optimize : 1;\n66\t///     unsigned int cache_enabled : 1;\n67\t///     unsigned int log_level : 3;\n68\t///     unsigned int reserved : 1;\n69\t/// };\n70\t/// ```\n71\t///\n72\t/// GCC on x86-64 (little endian) allocates these bit-fields inside a single\n73\t/// 4-byte storage unit, from the least significant bit upwards:\n74\t///\n75\t/// | bit(s) | field         |\n76\t/// |--------|---------------|\n77\t/// | 0      | verbose       |\n78\t/// | 1      | debug         |\n79\t/// | 2      | optimize      |\n80\t/// | 3      | cache_enabled |\n81\t/// | 4..6   | log_level     |\n82\t/// | 7      | reserved      |\n83\t/// | 8..31  | padding       |\n84\t#[repr(C)]\n85\t#[derive(Copy, Clone, Default)]\n86\tpub struct ConfigFlags {\n87\t    /// The single 4-byte bit-field storage unit.\n88\t    bits: u32,\n89\t}\n90\t\n91\tconst VERBOSE_SHIFT: u32 = 0;\n92\tconst DEBUG_SHIFT: u32 = 1;\n93\tconst OPTIMIZE_SHIFT: u32 = 2;\n94\tconst CACHE_ENABLED_SHIFT: u32 = 3;\n95\tconst LOG_LEVEL_SHIFT: u32 = 4;\n96\tconst LOG_LEVEL_MASK: u32 = 0x7;\n97\tconst RESERVED_SHIFT: u32 = 7;\n98\t\n99\timpl ConfigFlags {\n100\t    #[inline]\n101\t    fn verbose(&self) -> c_uint {\n102\t        (self.bits >> VERBOSE_SHIFT) & 1\n103\t    }\n104\t\n105\t    #[inline]\n106\t    fn debug(&self) -> c_uint {\n107\t        (self.bits >> DEBUG_SHIFT) & 1\n108\t    }\n109\t\n110\t    #[inline]\n111\t    fn optimize(&self) -> c_uint {\n112\t        (self.bits >> OPTIMIZE_SHIFT) & 1\n113\t    }\n114\t\n115\t    #[inline]\n116\t    fn cache_enabled(&self) -> c_uint {\n117\t        (self.bits >> CACHE_ENABLED_SHIFT) & 1\n118\t    }\n119\t\n120\t    #[inline]\n121\t    fn log_level(&self) -> c_uint {\n122\t        (self.bits >> LOG_LEVEL_SHIFT) & LOG_LEVEL_MASK\n123\t    }\n124\t\n125\t    #[inline]\n126\t    fn set_verbose(&mut self, v: c_uint) {\n127\t        self.bits = (self.bits & !(1 << VERBOSE_SHIFT)) | ((v & 1) << VERBOSE_SHIFT);\n128\t    }\n129\t\n130\t    #[inline]\n131\t    fn set_debug(&mut self, v: c_uint) {\n132\t        self.bits = (self.bits & !(1 << DEBUG_SHIFT)) | ((v & 1) << DEBUG_SHIFT);\n133\t    }\n134\t\n135\t    #[inline]\n136\t    fn set_optimize(&mut self, v: c_uint) {\n137\t        self.bits = (self.bits & !(1 << OPTIMIZE_SHIFT)) | ((v & 1) << OPTIMIZE_SHIFT);\n138\t    }\n139\t\n140\t    #[inline]\n141\t    fn set_cache_enabled(&mut self, v: c_uint) {\n142\t        self.bits = (self.bits & !(1 << CACHE_ENABLED_SHIFT)) | ((v & 1) << CACHE_ENABLED_SHIFT);\n143\t    }\n144\t\n145\t    #[inline]\n146\t    fn set_log_level(&mut self, v: c_uint) {\n147\t        self.bits = (self.bits & !(LOG_LEVEL_MASK << LOG_LEVEL_SHIFT))\n148\t            | ((v & LOG_LEVEL_MASK) << LOG_LEVEL_SHIFT);\n149\t    }\n150\t\n151\t    #[inline]\n152\t    fn set_reserved(&mut self, v: c_uint) {\n153\t        self.bits = (self.bits & !(1 << RESERVED_SHIFT)) | ((v & 1) << RESERVED_SHIFT);\n154\t    }\n155\t}\n156\t\n157\t/// ```c\n158\t/// struct ProcessState {\n159\t///     struct ConfigFlags flags;\n160\t///     int base_value;\n161\t///     int multiplier;\n162\t///     char operation;\n163\t/// };\n164\t/// ```\n165\t#[repr(C)]\n166\t#[derive(Copy, Clone, Default)]\n167\tstruct ProcessState {\n168\t    flags: ConfigFlags,\n169\t    base_value: c_int,\n170\t    multiplier: c_int,\n171\t    operation: c_char,\n172\t}\n173\t\n174\t/// `#define BUFFER_SIZE 256`\n175\tconst BUFFER_SIZE: usize = 256;\n176\t\n177\t// ---------------------------------------------------------------------------\n178\t// Format / literal strings (NUL terminated, exactly as in the C source)\n179\t// ---------------------------------------------------------------------------\n180\t\n181\tconst FMT_WARN_INVALID_CHAR: &[u8] = b\"Warning: Invalid character in %s\\n\\0\";\n182\tconst FMT_WARN_SEMICOLON: &[u8] = b\"Warning: Semicolon found in %s\\n\\0\";\n183\t\n184\tconst ENV_PROG_VERBOSE: &[u8] = b\"PROG_VERBOSE\\0\";\n185\tconst ENV_PROG_DEBUG: &[u8] = b\"PROG_DEBUG\\0\";\n186\tconst ENV_PROG_OPTIMIZE: &[u8] = b\"PROG_OPTIMIZE\\0\";\n187\tconst ENV_PROG_BASE_OFFSET: &[u8] = b\"PROG_BASE_OFFSET\\0\";\n188\tconst ENV_PROG_MULTIPLIER: &[u8] = b\"PROG_MULTIPLIER\\0\";\n189\t\n190\tconst FMT_DEBUG_OPERATION_MODE: &[u8] = b\"Debug: operation_mode = %o (octal)\\n\\0\";\n191\tconst FMT_DEBUG_RESULT_BEFORE: &[u8] = b\"Debug: result before adjustment = %d\\n\\0\";\n192\t\n193\tconst FMT_VERBOSE_ENABLED: &[u8] = b\"Verbose mode enabled\\n\\0\";\n194\tconst FMT_BASE_OFFSET: &[u8] = b\"Base offset: %d (from octal 0100)\\n\\0\";\n195\tconst FMT_MULTIPLIER: &[u8] = b\"Multiplier: %d (from octal 012)\\n\\0\";\n196\t\n197\tconst FMT_DEBUG_BACKUP: &[u8] = b\"Debug: Created state backup using memcpy\\n\\0\";\n198\tconst FMT_DEBUG_BACKUP_BASE: &[u8] = b\"Debug: Backup base_value = %d\\n\\0\";\n199\t\n200\tconst FMT_RESULT_STRING: &[u8] = b\"Result:%d:Complete\\0\";\n201\tconst FMT_FOUND_COLON: &[u8] = b\"Found colon at position: %ld\\n\\0\";\n202\tconst FMT_DEBUG_FORMAT_OK: &[u8] = b\"Debug: Result string format validated\\n\\0\";\n203\tconst FMT_RESTORED: &[u8] = b\"Restored state from backup\\n\\0\";\n204\tconst FMT_FINAL_RESULT: &[u8] = b\"Final result: %d\\n\\0\";\n205\tconst FMT_CONFIGURATION: &[u8] =\n206\t    b\"Configuration - Debug: %d, Optimize: %d, Log Level: %d\\n\\0\";\n207\t\n208\t// ---------------------------------------------------------------------------\n209\t// Public API\n210\t// ---------------------------------------------------------------------------\n211\t\n212\t/// ```c\n213\t/// int parse_env_numeric(const char* env_name, int default_val);\n214\t/// ```\n215\t#[unsafe(no_mangle)]\n216\tpub unsafe extern \"C\" fn parse_env_numeric(env_name: *const c_char, default_val: c_int) -> c_int {\n217\t    let env_value: *mut c_char = getenv(env_name);\n218\t\n219\t    if env_value.is_null() {\n220\t        return default_val;\n221\t    }\n222\t\n223\t    let mut invalid_char: *mut c_char = strchr(env_value, b',' as c_int);\n224\t    if !invalid_char.is_null() {\n225\t        fprintf(\n226\t            stderr,\n227\t            FMT_WARN_INVALID_CHAR.as_ptr() as *const c_char,\n228\t            env_name,\n229\t        );\n230\t        return default_val;\n231\t    }\n232\t\n233\t    invalid_char = strchr(env_value, b';' as c_int);\n234\t    if !invalid_char.is_null() {\n235\t        fprintf(\n236\t            stderr,\n237\t            FMT_WARN_SEMICOLON.as_ptr() as *const c_char,\n238\t            env_name,\n239\t        );\n240\t        return default_val;\n241\t    }\n242\t\n243\t    atoi(env_value)\n244\t}\n245\t\n246\t/// ```c\n247\t/// void init_config_from_env(struct ConfigFlags* flags);\n248\t/// ```\n249\t#[unsafe(no_mangle)]\n250\tpub unsafe extern \"C\" fn init_config_from_env(flags: *mut ConfigFlags) {\n251\t    let verbose_env: *mut c_char = getenv(ENV_PROG_VERBOSE.as_ptr() as *const c_char);\n252\t    let debug_env: *mut c_char = getenv(ENV_PROG_DEBUG.as_ptr() as *const c_char);\n253\t    let optimize_env: *mut c_char = getenv(ENV_PROG_OPTIMIZE.as_ptr() as *const c_char);\n254\t\n255\t    let flags = &mut *flags;\n256\t\n257\t    flags.set_verbose(\n258\t        if !verbose_env.is_null() && !strchr(verbose_env, b'1' as c_int).is_null() {\n259\t            1\n260\t        } else {\n261\t            0\n262\t        },\n263\t    );\n264\t    flags.set_debug(\n265\t        if !debug_env.is_null() && !strchr(debug_env, b'1' as c_int).is_null() {\n266\t            1\n267\t        } else {\n268\t            0\n269\t        },\n270\t    );\n271\t    flags.set_optimize(if !optimize_env.is_null() { 1 } else { 0 });\n272\t    flags.set_cache_enabled(1);\n273\t    // `03` is an octal literal in C == 3.\n274\t    flags.set_log_level(0o3);\n275\t    flags.set_reserved(0);\n276\t}\n277\t\n278\t/// ```c\n279\t/// int perform_operation(int val1, int val2, struct ConfigFlags* flags);\n280\t/// ```\n281\t#[unsafe(no_mangle)]\n282\tpub unsafe extern \"C\" fn perform_operation(\n283\t    val1: c_int,\n284\t    val2: c_int,\n285\t    flags: *mut ConfigFlags,\n286\t) -> c_int {\n287\t    let result: c_int;\n288\t\n289\t    // `0755` is an octal literal in C == 493.\n290\t    let operation_mode: c_int = 0o755;\n291\t\n292\t    let flags = &*flags;\n293\t\n294\t    if flags.optimize() != 0 {\n295\t        result = val1.wrapping_add(val2);\n296\t    } else {\n297\t        // A `unsigned int : 3` bit-field promotes to `int`, so this is signed\n298\t        // arithmetic; `val2 / 2` truncates towards zero, exactly like Rust's\n299\t        // integer division.\n300\t        result = val1\n301\t            .wrapping_mul(flags.log_level() as c_int)\n302\t            .wrapping_add(val2.wrapping_div(2));\n303\t    }\n304\t\n305\t    if flags.debug() != 0 {\n306\t        printf(\n307\t            FMT_DEBUG_OPERATION_MODE.as_ptr() as *const c_char,\n308\t            operation_mode,\n309\t        );\n310\t        printf(FMT_DEBUG_RESULT_BEFORE.as_ptr() as *const c_char, result);\n311\t    }\n312\t\n313\t    result\n314\t}\n315\t\n316\t/// ```c\n317\t/// int apply_bit_operations(int value, struct ConfigFlags* flags);\n318\t/// ```\n319\t#[unsafe(no_mangle)]\n320\tpub unsafe extern \"C\" fn apply_bit_operations(value: c_int, flags: *mut ConfigFlags) -> c_int {\n321\t    let mut adjusted: c_int = value;\n322\t\n323\t    let flags = &*flags;\n324\t\n325\t    if flags.verbose() != 0 {\n326\t        adjusted = ((adjusted as u32) << 1) as c_int;\n327\t    }\n328\t\n329\t    if flags.cache_enabled() != 0 {\n330\t        adjusted |= 0x0F;\n331\t    }\n332\t\n333\t    adjusted\n334\t}\n335\t\n336\t/// ```c\n337\t/// int envy(int param1, int param2, int param3, int param4);\n338\t/// ```\n339\t#[unsafe(no_mangle)]\n340\tpub unsafe extern \"C\" fn envy(\n341\t    param1: c_int,\n342\t    param2: c_int,\n343\t    param3: c_int,\n344\t    param4: c_int,\n345\t) -> c_int {\n346\t    let mut state: ProcessState = ProcessState::default();\n347\t    let mut state_backup: ProcessState = ProcessState::default();\n348\t    let mut buffer: [c_char; BUFFER_SIZE] = [0; BUFFER_SIZE];\n349\t    let mut result: c_int;\n350\t\n351\t    init_config_from_env(&mut state.flags as *mut ConfigFlags);\n352\t\n353\t    // `0100` == 64, `012` == 10 (octal literals).\n354\t    let base_offset: c_int =\n355\t        parse_env_numeric(ENV_PROG_BASE_OFFSET.as_ptr() as *const c_char, 0o100);\n356\t    let multiplier: c_int =\n357\t        parse_env_numeric(ENV_PROG_MULTIPLIER.as_ptr() as *const c_char, 0o12);\n358\t\n359\t    if state.flags.verbose() != 0 {\n360\t        printf(FMT_VERBOSE_ENABLED.as_ptr() as *const c_char);\n361\t        printf(FMT_BASE_OFFSET.as_ptr() as *const c_char, base_offset);\n362\t        printf(FMT_MULTIPLIER.as_ptr() as *const c_char, multiplier);\n363\t    }\n364\t\n365\t    state.base_value = param1;\n366\t    state.multiplier = multiplier;\n367\t    state.operation = b'+' as c_char;\n368\t\n369\t    memcpy(\n370\t        &mut state_backup as *mut ProcessState as *mut c_void,\n371\t        &state as *const ProcessState as *const c_void,\n372\t        core::mem::size_of::<ProcessState>(),\n373\t    );\n374\t\n375\t    if state.flags.debug() != 0 {\n376\t        printf(FMT_DEBUG_BACKUP.as_ptr() as *const c_char);\n377\t        printf(\n378\t            FMT_DEBUG_BACKUP_BASE.as_ptr() as *const c_char,\n379\t            state_backup.base_value,\n380\t        );\n381\t    }\n382\t\n383\t    result = perform_operation(param1, param2, &mut state.flags as *mut ConfigFlags);\n384\t\n385\t    if param3 != 0 {\n386\t        result = result.wrapping_add(param3.wrapping_mul(state.multiplier));\n387\t    }\n388\t\n389\t    if param4 != 0 {\n390\t        // Signed right shift is arithmetic on GCC/x86-64, matching Rust's `>>`\n391\t        // on `i32`.\n392\t        result = result.wrapping_add(param4 >> 2);\n393\t    }\n394\t\n395\t    result = apply_bit_operations(result, &mut state.flags as *mut ConfigFlags);\n396\t\n397\t    result = result.wrapping_add(base_offset);\n398\t\n399\t    snprintf(\n400\t        buffer.as_mut_ptr(),\n401\t        BUFFER_SIZE,\n402\t        FMT_RESULT_STRING.as_ptr() as *const c_char,\n403\t        result,\n404\t    );\n405\t\n406\t    let colon_pos: *mut c_char = strchr(buffer.as_ptr(), b':' as c_int);\n407\t    if !colon_pos.is_null() {\n408\t        if state.flags.verbose() != 0 {\n409\t            printf(\n410\t                FMT_FOUND_COLON.as_ptr() as *const c_char,\n411\t                (colon_pos as isize - buffer.as_ptr() as isize) as c_long,\n412\t            );\n413\t        }\n414\t\n415\t        let second_colon: *mut c_char = strchr(colon_pos.add(1), b':' as c_int);\n416\t        if !second_colon.is_null() && state.flags.debug() != 0 {\n417\t            printf(FMT_DEBUG_FORMAT_OK.as_ptr() as *const c_char);\n418\t        }\n419\t    }\n420\t\n421\t    if result < 0 {\n422\t        memcpy(\n423\t            &mut state as *mut ProcessState as *mut c_void,\n424\t            &state_backup as *const ProcessState as *const c_void,\n425\t            core::mem::size_of::<ProcessState>(),\n426\t        );\n427\t        result = state.base_value; /* Use original base value */\n428\t\n429\t        if state.flags.verbose() != 0 {\n430\t            printf(FMT_RESTORED.as_ptr() as *const c_char);\n431\t        }\n432\t    }\n433\t\n434\t    if state.flags.verbose() != 0 {\n435\t        printf(FMT_FINAL_RESULT.as_ptr() as *const c_char, result);\n436\t        printf(\n437\t            FMT_CONFIGURATION.as_ptr() as *const c_char,\n438\t            state.flags.debug() as c_int,\n439\t            state.flags.optimize() as c_int,\n440\t            state.flags.log_level() as c_int,\n441\t        );\n442\t    }\n443\t\n444\t    result\n445\t}\n446\t"}]},"parent_tool_use_id":null,"session_id":"45b2afad-fa3f-48e7-8b2b-5e23c8be9782","uuid":"15e74921-9d20-44a5-b3a5-183365f2e850","timestamp":"2026-08-19T19:32:08.633Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-TN1Py3/translated_rust/src/lib.rs","content":"// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n//\n// Rust translation of c_src/src/lib.c.  The translation is a 1:1 port of the C\n// implementation: the same libc primitives (`getenv`, `atoi`, `strchr`,\n// `printf`, `fprintf`, `snprintf`, `memcpy`) are used so that both the returned\n// values and every byte written to stdout/stderr (including stream buffering\n// behaviour) are identical to the original C shared library.\n\n#![allow(non_camel_case_types)]\n\nuse std::ffi::{c_char, c_int, c_long, c_uint, c_void};\n\n// ---------------------------------------------------------------------------\n// libc bindings\n// ---------------------------------------------------------------------------\n\n/// Opaque stand-in for `FILE`.\n#[repr(C)]\npub struct FILE {\n    _opaque: [u8; 0],\n}\n\nunsafe extern \"C\" {\n    static mut stderr: *mut FILE;\n\n    fn getenv(name: *const c_char) -> *mut c_char;\n    fn atoi(s: *const c_char) -> c_int;\n    fn strchr(s: *const c_char, c: c_int) -> *mut c_char;\n    fn memcpy(dest: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n\n    fn printf(fmt: *const c_char, ...) -> c_int;\n    fn fprintf(stream: *mut FILE, fmt: *const c_char, ...) -> c_int;\n    fn snprintf(buf: *mut c_char, size: usize, fmt: *const c_char, ...) -> c_int;\n}\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// struct ConfigFlags {\n///     unsigned int verbose : 1;\n///     unsigned int debug : 1;\n///     unsigned int optimize : 1;\n///     unsigned int cache_enabled : 1;\n///     unsigned int log_level : 3;\n///     unsigned int reserved : 1;\n/// };\n/// ```\n///\n/// GCC on x86-64 (little endian) allocates these bit-fields inside a single\n/// 4-byte storage unit, from the least significant bit upwards:\n///\n/// | bit(s) | field         |\n/// |--------|---------------|\n/// | 0      | verbose       |\n/// | 1      | debug         |\n/// | 2      | optimize      |\n/// | 3      | cache_enabled |\n/// | 4..6   | log_level     |\n/// | 7      | reserved      |\n/// | 8..31  | padding       |\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct ConfigFlags {\n    /// The single 4-byte bit-field storage unit.\n    bits: u32,\n}\n\nconst VERBOSE_SHIFT: u32 = 0;\nconst DEBUG_SHIFT: u32 = 1;\nconst OPTIMIZE_SHIFT: u32 = 2;\nconst CACHE_ENABLED_SHIFT: u32 = 3;\nconst LOG_LEVEL_SHIFT: u32 = 4;\nconst LOG_LEVEL_MASK: u32 = 0x7;\nconst RESERVED_SHIFT: u32 = 7;\n\nimpl ConfigFlags {\n    #[inline]\n    fn verbose(&self) -> c_uint {\n        (self.bits >> VERBOSE_SHIFT) & 1\n    }\n\n    #[inline]\n    fn debug(&self) -> c_uint {\n        (self.bits >> DEBUG_SHIFT) & 1\n    }\n\n    #[inline]\n    fn optimize(&self) -> c_uint {\n        (self.bits >> OPTIMIZE_SHIFT) & 1\n    }\n\n    #[inline]\n    fn cache_enabled(&self) -> c_uint {\n        (self.bits >> CACHE_ENABLED_SHIFT) & 1\n    }\n\n    #[inline]\n    fn log_level(&self) -> c_uint {\n        (self.bits >> LOG_LEVEL_SHIFT) & LOG_LEVEL_MASK\n    }\n\n    #[inline]\n    fn set_verbose(&mut self, v: c_uint) {\n        self.bits = (self.bits & !(1 << VERBOSE_SHIFT)) | ((v & 1) << VERBOSE_SHIFT);\n    }\n\n    #[inline]\n    fn set_debug(&mut self, v: c_uint) {\n        self.bits = (self.bits & !(1 << DEBUG_SHIFT)) | ((v & 1) << DEBUG_SHIFT);\n    }\n\n    #[inline]\n    fn set_optimize(&mut self, v: c_uint) {\n        self.bits = (self.bits & !(1 << OPTIMIZE_SHIFT)) | ((v & 1) << OPTIMIZE_SHIFT);\n    }\n\n    #[inline]\n    fn set_cache_enabled(&mut self, v: c_uint) {\n        self.bits = (self.bits & !(1 << CACHE_ENABLED_SHIFT)) | ((v & 1) << CACHE_ENABLED_SHIFT);\n    }\n\n    #[inline]\n    fn set_log_level(&mut self, v: c_uint) {\n        self.bits = (self.bits & !(LOG_LEVEL_MASK << LOG_LEVEL_SHIFT))\n            | ((v & LOG_LEVEL_MASK) << LOG_LEVEL_SHIFT);\n    }\n\n    #[inline]\n    fn set_reserved(&mut self, v: c_uint) {\n        self.bits = (self.bits & !(1 << RESERVED_SHIFT)) | ((v & 1) << RESERVED_SHIFT);\n    }\n}\n\n/// ```c\n/// struct ProcessState {\n///     struct ConfigFlags flags;\n///     int base_value;\n///     int multiplier;\n///     char operation;\n/// };\n/// ```\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\nstruct ProcessState {\n    flags: ConfigFlags,\n    base_value: c_int,\n    multiplier: c_int,\n    operation: c_char,\n}\n\n/// `#define BUFFER_SIZE 256`\nconst BUFFER_SIZE: usize = 256;\n\n// ---------------------------------------------------------------------------\n// Format / literal strings (NUL terminated, exactly as in the C source)\n// ---------------------------------------------------------------------------\n\nconst FMT_WARN_INVALID_CHAR: &[u8] = b\"Warning: Invalid character in %s\\n\\0\";\nconst FMT_WARN_SEMICOLON: &[u8] = b\"Warning: Semicolon found in %s\\n\\0\";\n\nconst ENV_PROG_VERBOSE: &[u8] = b\"PROG_VERBOSE\\0\";\nconst ENV_PROG_DEBUG: &[u8] = b\"PROG_DEBUG\\0\";\nconst ENV_PROG_OPTIMIZE: &[u8] = b\"PROG_OPTIMIZE\\0\";\nconst ENV_PROG_BASE_OFFSET: &[u8] = b\"PROG_BASE_OFFSET\\0\";\nconst ENV_PROG_MULTIPLIER: &[u8] = b\"PROG_MULTIPLIER\\0\";\n\nconst FMT_DEBUG_OPERATION_MODE: &[u8] = b\"Debug: operation_mode = %o (octal)\\n\\0\";\nconst FMT_DEBUG_RESULT_BEFORE: &[u8] = b\"Debug: result before adjustment = %d\\n\\0\";\n\nconst FMT_VERBOSE_ENABLED: &[u8] = b\"Verbose mode enabled\\n\\0\";\nconst FMT_BASE_OFFSET: &[u8] = b\"Base offset: %d (from octal 0100)\\n\\0\";\nconst FMT_MULTIPLIER: &[u8] = b\"Multiplier: %d (from octal 012)\\n\\0\";\n\nconst FMT_DEBUG_BACKUP: &[u8] = b\"Debug: Created state backup using memcpy\\n\\0\";\nconst FMT_DEBUG_BACKUP_BASE: &[u8] = b\"Debug: Backup base_value = %d\\n\\0\";\n\nconst FMT_RESULT_STRING: &[u8] = b\"Result:%d:Complete\\0\";\nconst FMT_FOUND_COLON: &[u8] = b\"Found colon at position: %ld\\n\\0\";\nconst FMT_DEBUG_FORMAT_OK: &[u8] = b\"Debug: Result string format validated\\n\\0\";\nconst FMT_RESTORED: &[u8] = b\"Restored state from backup\\n\\0\";\nconst FMT_FINAL_RESULT: &[u8] = b\"Final result: %d\\n\\0\";\nconst FMT_CONFIGURATION: &[u8] =\n    b\"Configuration - Debug: %d, Optimize: %d, Log Level: %d\\n\\0\";\n\n// ---------------------------------------------------------------------------\n// Public API\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// int parse_env_numeric(const char* env_name, int default_val);\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn parse_env_numeric(env_name: *const c_char, default_val: c_int) -> c_int {\n    let env_value: *mut c_char = getenv(env_name);\n\n    if env_value.is_null() {\n        return default_val;\n    }\n\n    let mut invalid_char: *mut c_char = strchr(env_value, b',' as c_int);\n    if !invalid_char.is_null() {\n        fprintf(\n            stderr,\n            FMT_WARN_INVALID_CHAR.as_ptr() as *const c_char,\n            env_name,\n        );\n        return default_val;\n    }\n\n    invalid_char = strchr(env_value, b';' as c_int);\n    if !invalid_char.is_null() {\n        fprintf(\n            stderr,\n            FMT_WARN_SEMICOLON.as_ptr() as *const c_char,\n            env_name,\n        );\n        return default_val;\n    }\n\n    atoi(env_value)\n}\n\n/// ```c\n/// void init_config_from_env(struct ConfigFlags* flags);\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn init_config_from_env(flags: *mut ConfigFlags) {\n    let verbose_env: *mut c_char = getenv(ENV_PROG_VERBOSE.as_ptr() as *const c_char);\n    let debug_env: *mut c_char = getenv(ENV_PROG_DEBUG.as_ptr() as *const c_char);\n    let optimize_env: *mut c_char = getenv(ENV_PROG_OPTIMIZE.as_ptr() as *const c_char);\n\n    let flags = &mut *flags;\n\n    flags.set_verbose(\n        if !verbose_env.is_null() && !strchr(verbose_env, b'1' as c_int).is_null() {\n            1\n        } else {\n            0\n        },\n    );\n    flags.set_debug(\n        if !debug_env.is_null() && !strchr(debug_env, b'1' as c_int).is_null() {\n            1\n        } else {\n            0\n        },\n    );\n    flags.set_optimize(if !optimize_env.is_null() { 1 } else { 0 });\n    flags.set_cache_enabled(1);\n    // `03` is an octal literal in C == 3.\n    flags.set_log_level(0o3);\n    flags.set_reserved(0);\n}\n\n/// ```c\n/// int perform_operation(int val1, int val2, struct ConfigFlags* flags);\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn perform_operation(\n    val1: c_int,\n    val2: c_int,\n    flags: *mut ConfigFlags,\n) -> c_int {\n    let result: c_int;\n\n    // `0755` is an octal literal in C == 493.\n    let operation_mode: c_int = 0o755;\n\n    let flags = &*flags;\n\n    if flags.optimize() != 0 {\n        result = val1.wrapping_add(val2);\n    } else {\n        // A `unsigned int : 3` bit-field promotes to `int`, so this is signed\n        // arithmetic; `val2 / 2` truncates towards zero, exactly like Rust's\n        // integer division.\n        result = val1\n            .wrapping_mul(flags.log_level() as c_int)\n            .wrapping_add(val2.wrapping_div(2));\n    }\n\n    if flags.debug() != 0 {\n        printf(\n            FMT_DEBUG_OPERATION_MODE.as_ptr() as *const c_char,\n            operation_mode,\n        );\n        printf(FMT_DEBUG_RESULT_BEFORE.as_ptr() as *const c_char, result);\n    }\n\n    result\n}\n\n/// ```c\n/// int apply_bit_operations(int value, struct ConfigFlags* flags);\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn apply_bit_operations(value: c_int, flags: *mut ConfigFlags) -> c_int {\n    let mut adjusted: c_int = value;\n\n    let flags = &*flags;\n\n    if flags.verbose() != 0 {\n        adjusted = ((adjusted as u32) << 1) as c_int;\n    }\n\n    if flags.cache_enabled() != 0 {\n        adjusted |= 0x0F;\n    }\n\n    adjusted\n}\n\n/// ```c\n/// int envy(int param1, int param2, int param3, int param4);\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn envy(\n    param1: c_int,\n    param2: c_int,\n    param3: c_int,\n    param4: c_int,\n) -> c_int {\n    let mut state: ProcessState = ProcessState::default();\n    let mut state_backup: ProcessState = ProcessState::default();\n    let mut buffer: [c_char; BUFFER_SIZE] = [0; BUFFER_SIZE];\n    let mut result: c_int;\n\n    init_config_from_env(&mut state.flags as *mut ConfigFlags);\n\n    // `0100` == 64, `012` == 10 (octal literals).\n    let base_offset: c_int =\n        parse_env_numeric(ENV_PROG_BASE_OFFSET.as_ptr() as *const c_char, 0o100);\n    let multiplier: c_int =\n        parse_env_numeric(ENV_PROG_MULTIPLIER.as_ptr() as *const c_char, 0o12);\n\n    if state.flags.verbose() != 0 {\n        printf(FMT_VERBOSE_ENABLED.as_ptr() as *const c_char);\n        printf(FMT_BASE_OFFSET.as_ptr() as *const c_char, base_offset);\n        printf(FMT_MULTIPLIER.as_ptr() as *const c_char, multiplier);\n    }\n\n    state.base_value = param1;\n    state.multiplier = multiplier;\n    state.operation = b'+' as c_char;\n\n    memcpy(\n        &mut state_backup as *mut ProcessState as *mut c_void,\n        &state as *const ProcessState as *const c_void,\n        core::mem::size_of::<ProcessState>(),\n    );\n\n    if state.flags.debug() != 0 {\n        printf(FMT_DEBUG_BACKUP.as_ptr() as *const c_char);\n        printf(\n            FMT_DEBUG_BACKUP_BASE.as_ptr() as *const c_char,\n            state_backup.base_value,\n        );\n    }\n\n    result = perform_operation(param1, param2, &mut state.flags as *mut ConfigFlags);\n\n    if param3 != 0 {\n        result = result.wrapping_add(param3.wrapping_mul(state.multiplier));\n    }\n\n    if param4 != 0 {\n        // Signed right shift is arithmetic on GCC/x86-64, matching Rust's `>>`\n        // on `i32`.\n        result = result.wrapping_add(param4 >> 2);\n    }\n\n    result = apply_bit_operations(result, &mut state.flags as *mut ConfigFlags);\n\n    result = result.wrapping_add(base_offset);\n\n    snprintf(\n        buffer.as_mut_ptr(),\n        BUFFER_SIZE,\n        FMT_RESULT_STRING.as_ptr() as *const c_char,\n        result,\n    );\n\n    let colon_pos: *mut c_char = strchr(buffer.as_ptr(), b':' as c_int);\n    if !colon_pos.is_null() {\n        if state.flags.verbose() != 0 {\n            printf(\n                FMT_FOUND_COLON.as_ptr() as *const c_char,\n                (colon_pos as isize - buffer.as_ptr() as isize) as c_long,\n            );\n        }\n\n        let second_colon: *mut c_char = strchr(colon_pos.add(1), b':' as c_int);\n        if !second_colon.is_null() && state.flags.debug() != 0 {\n            printf(FMT_DEBUG_FORMAT_OK.as_ptr() as *const c_char);\n        }\n    }\n\n    if result < 0 {\n        memcpy(\n            &mut state as *mut ProcessState as *mut c_void,\n            &state_backup as *const ProcessState as *const c_void,\n            core::mem::size_of::<ProcessState>(),\n        );\n        result = state.base_value; /* Use original base value */\n\n        if state.flags.verbose() != 0 {\n            printf(FMT_RESTORED.as_ptr() as *const c_char);\n        }\n    }\n\n    if state.flags.verbose() != 0 {\n        printf(FMT_FINAL_RESULT.as_ptr() as *const c_char, result);\n        printf(\n            FMT_CONFIGURATION.as_ptr() as *const c_char,\n            state.flags.debug() as c_int,\n            state.flags.optimize() as c_int,\n            state.flags.log_level() as c_int,\n        );\n    }\n\n    result\n}\n","numLines":446,"startLine":1,"totalLines":446}}}
