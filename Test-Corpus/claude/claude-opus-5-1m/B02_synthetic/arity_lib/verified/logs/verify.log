":"        let offset = rng.below(28) as usize;\n        let len = 2 + (rng.below(3) as c_int); // 2, 3 or 4\n        let slice = &big[offset..offset + 4];\n        diff_arity(&c, &r, len, slice);\n    }\n}\n\n// ===========================================================================\n// C32: composed pipeline -- long interleaved sequence\n// ===========================================================================\n\n#[test]\nfn row_c32_long_composed_sequence() {\n    // Drive the library the way a real consumer would: a long run of calls\n    // whose allocator state, mask selection and post-adjustments compose across\n    // calls. The C sequence is produced first (an even number of calls, so the\n    // allocator parity is restored), then the Rust sequence; the two full\n    // sequences must be identical element-wise.\n    let (c, r) = load_both();\n    const N: usize = 1000; // even => parity-neutral\n    let mut rng = Rng::new(SEED ^ 0xC32);\n    let mut inputs: Vec<(c_int, [c_int; 4])> = Vec::with_capacity(N);\n    for _ in 0..N {\n        let len = match rng.below(6) {\n            0 => 0,\n            1 => 1,\n            2 => 2,\n            3 => 3,\n            4 => 4,\n            _ => rng.next_i32(),\n        };\n        inputs.push((\n            len,\n            [rng.next_i32(), rng.next_i32(), rng.next_i32(), rng.next_i32()],\n        ));\n    }\n\n    let mut c_out: Vec<c_int> = Vec::with_capacity(N);\n    let mut r_out: Vec<c_int> = Vec::with_capacity(N);\n    let mut params: Vec<c_int> = vec![0; 4];\n\n    // Count the calls that actually reach `compare_allocations` (i.e. that are\n    // NOT rejected by `len < 2`): only those consume allocator parity. If that\n    // count is odd the Rust loop would start from the opposite tcache state and\n    // every result would differ by the 1-vs-2 address-order term, so one extra\n    // parity-consuming call is issued to restore the starting state.\n    let mut parity_consuming = 0usize;\n    for &