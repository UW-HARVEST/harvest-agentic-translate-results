oc(size_t n) {","     unsigned long want = g_fail_size;","+    void *p;","+","     if (want != 0 && (unsigned long)n == want) {","         return (void *)0;","     }","-    return __libc_malloc(n);","+    p = __libc_malloc(n);","+    if (p != (void *)0 && g_fill_armed) {","+        memset(p, g_fill_byte, n);","+    }","+    return p;"," }"]}],"originalFile":"/* Fault-injection interposer used by the Phase C malloc-failure rows of\n * ERRORS.md (rows 1, 2, 9, 11).  Loaded with LD_PRELOAD into the\n * `fault_child` helper; while \"armed\" it makes malloc() requests of one exact\n * byte size fail, which is the only way to reach the `malloc(...) == NULL`\n * branches of c_src/src/lib.c.\n *\n * This file is part of the *test harness*; c_src/ is untouched.\n *\n * __libc_malloc is used instead of dlsym(RTLD_NEXT, \"malloc\") so that no\n * allocation can happen inside the interposer itself (dlsym may allocate,\n * which would recurse).\n */\n#include <stddef.h>\n\nextern void *__libc_malloc(size_t);\n\n/* 0 == disarmed */\nstatic volatile unsigned long g_fail_size = 0;\n\n/* Called by the helper through dlsym() once every library is loaded, so that\n * dlopen()'s own allocations are never disturbed. */\nvoid fail_malloc_arm(unsigned long size) { g_fail_size = size; }\n\nunsigned long fail_malloc_armed_size(void) { return g_fail_size; }\n\nvoid *malloc(size_t n) {\n    unsigned long want = g_fail_size;\n    if (want != 0 && (unsigned long)n == want) {\n        return (void *)0;\n    }\n    return __libc_malloc(n);\n}\n","userModified":false}}
