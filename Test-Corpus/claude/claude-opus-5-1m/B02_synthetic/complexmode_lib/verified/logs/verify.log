p = |label: &str| {\n                        let n = count();\n                        let mut s = String::new();\n                        for i in 0..n {\n                            if i > 0 {\n                                s.push(',');\n                            }\n                            s.push_str(&format!(\"{}\", get(i)));\n                        }\n                        out(&format!(\"SIZES {label}: [{s}]\\n\"));\n                    };\n\n                    for len in [0usize, 8, 40, 70] {\n                        let mut op = vec![b'x'; len];\n                        op.push(0);\n                        start();\n                        let p = crs(op.as_ptr() as *const c_char, -12345);\n                        stop();\n                        dump(&format!(\"crs len={len}\"));\n                        if !p.is_null() {\n                            free(p as *mut c_void);\n                        }\n                    }\n\n                    for (a, b) in [(6, 7), (i32::MIN, -1)] {\n                        let mut log: *mut c_char = std::ptr::null_mut();\n                        start();\n                        let _ = mwl(a, b, &mut log);\n                        stop();\n                        dump(&format!(\"mwl {a} {b}\"));\n                        if !log.is_null() {\n                            free(log as *mut c_void);\n                        }\n                    }\n\n                    // Negative / boundary counts: malloc fails for all of them,\n                    // so only the logged request size distinguishes a wrong\n                    // int -> size_t conversion.\n                    let mut buf: Vec<c_int> = (0..64).map(|i| i - 7).collect();\n                    for c in [\n                        0,\n                        1,\n                        3,\n                        17,\n                        64,\n                        -1,\n                        -2,\n                        -3,\n                        -17,\n                        -1024,\n                        -65536,\n                        -(1 << 30),\n                        i32::MIN,\n                        i32::MIN + 1,\n                    ] {\n                        start();\n                        let _ = cas(buf.as_mut_ptr(), c);\n                        stop();\n                        dump(&format!(\"cas {c}\"));\n                    }\n\n                    for mode in [-1, 0, 1, 2, 3, 4, 5] {\n                        start();\n                        let _ = cm(mode, 6, 7, 8);\n                        stop();\n                        dump(&format!(\"cm {mode}\"));\n                    }\n                }\n                other => {\n                    eprintln!(\"unknown scenario {other}\");\n                    std::process::exit(4);\n                }"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3597,"cache_read_input_tokens":169108,"cache_creation":{"ephemeral_5m_input_tokens":3597,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f77016da-56db-46ae-8e98-e50f61a4e5bc","uuid":"6924ec27-d26d-41f3-8612-a8c66e4fa13e","timestamp":"2026-08-19T19:18:25.149Z"}
