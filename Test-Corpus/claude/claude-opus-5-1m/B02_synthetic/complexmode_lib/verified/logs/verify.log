eep history-\n * dependent contents.  Doing the memset here covers every allocation path.\n *\n * __libc_malloc is used instead of dlsym(RTLD_NEXT, \"malloc\") so that no\n * allocation can happen inside the interposer itself (dlsym may allocate,\n * which would recurse).\n */\n#include <stddef.h>\n#include <string.h>\n\nextern void *__libc_malloc(size_t);\n\n/* 0 == disarmed */\nstatic volatile unsigned long g_fail_size = 0;\nstatic volatile int g_fill_armed = 0;\nstatic volatile unsigned char g_fill_byte = 0;\n\nvoid fail_malloc_arm(unsigned long size) { g_fail_size = size; }\n\nunsigned long fail_malloc_armed_size(void) { return g_fail_size; }\n\n/* byte == 0 disarms the fill */\nvoid fail_malloc_fill(unsigned long byte) {\n    g_fill_byte = (unsigned char)byte;\n    g_fill_armed = (byte != 0);\n}\n\nvoid *malloc(size_t n) {\n    unsigned long want = g_fail_size;\n    void *p;\n\n    if (want != 0 && (unsigned long)n == want) {\n        return (void *)0;\n    }\n    p = __libc_malloc(n);\n    if (p != (void *)0 && g_fill_armed) {\n        memset(p, g_fill_byte, n);\n    }\n    return p;\n}\n","structuredPatch":[{"oldStart":1,"oldLines":32,"newStart":1,"newLines":61,"lines":["-/* Fault-injection interposer used by the Phase C malloc-failure rows of","- * ERRORS.md (rows 1, 2, 9, 11).  Loaded with LD_PRELOAD into the","- * `fault_child` helper; while \"armed\" it makes malloc() requests of one exact","- * byte size fail, which is the only way to reach the `malloc(...) == NULL`","- * branches of c_src/src/lib.c.","+/* Test-harness malloc interposer.  Loaded with LD_PRELOAD into the","+ * `fault_child` helper; c_src/ is untouched.","  *","- * This file is part of the *test harness*; c_src/ is untouched.","+ * Two independent knobs, both armed by the helper *after* every shared object","+ * has been loaded so that dlopen()'s own allocations are never disturbed:","  *","+ *   fail_malloc_arm(size)   ERRORS.md rows 1, 2, 5, 9, 11 — makes malloc()","+ *                  