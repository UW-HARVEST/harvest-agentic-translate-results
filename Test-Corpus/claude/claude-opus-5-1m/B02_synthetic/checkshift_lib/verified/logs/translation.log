xtern \"C\" {\n    /// `int printf(const char *restrict format, ...)`\n    pub safe fn printf(format: *const c_char, ...) -> c_int;\n    /// `void *malloc(size_t size)`\n    pub safe fn malloc(size: usize) -> *mut c_void;\n    /// `void free(void *ptr)`\n    pub safe fn free(ptr: *mut c_void);\n}\n\n/// Emit a format string that takes no arguments.\n#[inline]\npub fn print_lit(format: &'static [u8]) {\n    debug_assert_eq!(*format.last().unwrap(), 0);\n    printf(format.as_ptr() as *const c_char);\n}\n\n/// Emit a format string with a single `%d` argument.\n#[inline]\npub fn print_i(format: &'static [u8], a: c_int) {\n    debug_assert_eq!(*format.last().unwrap(), 0);\n    printf(format.as_ptr() as *const c_char, a);\n}\n\n/// Emit a format string with a single `%u`/`%X` argument.\n#[inline]\npub fn print_u(format: &'static [u8], a: c_uint) {\n    debug_assert_eq!(*format.last().unwrap(), 0);\n    printf(format.as_ptr() as *const c_char, a);\n}\n\n/// Emit a format string with a single `%s` argument.\n///\n/// `s` is forwarded verbatim, so a null pointer reproduces whatever the\n/// platform's `printf` does with `%s` and `NULL` (glibc prints `(null)`).\n#[inline]\npub fn print_s(format: &'static [u8], s: *const c_char) {\n    debug_assert_eq!(*format.last().unwrap(), 0);\n    printf(format.as_ptr() as *const c_char, s);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2757,"cache_read_input_tokens":23376,"cache_creation":{"ephemeral_5m_input_tokens":2757,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"19259f20-380b-4ebf-ab74-03347388c436","uuid":"4bd814a5-7022-46bf-9a5d-ffa85d05e5b5","timestamp":"2026-08-19T16:08:11.511Z"}
