 \\\n  'pub unsafe fn c_main(_argc: c_int, argv: *mut *mut c_char) -> c_int {\n    if _argc < 3 { return 1; }'\ncheck \"argc is never validated\" error_paths row12\n\n# 9. the null-pointer dereference must really happen.\nmutate src/container_of.rs \\\n  '    let mut cur = core::ptr::read_volatile(p);' \\\n  '    if p.is_null() { return 0; }\n    let mut cur = core::ptr::read_volatile(p);'\ncheck \"atoi(NULL) faults\" error_paths row01\n\nprintf '\\n==== mutation check: %s ====\\n' \"$([ $status -eq 0 ] && echo 'all mutations caught' || echo 'VACUOUS TESTS FOUND')\"\nexit $status\n","structuredPatch":[{"oldStart":81,"oldLines":31,"newStart":81,"newLines":18,"lines":[" "," # 5. the printf format (trailing newline)."," mutate src/container_of.rs \\","-  'buf[pos] = b(NEWLINE);' \\","-  'buf[pos] = b(NEWLINE);'","-restore","-mutate src/container_of.rs \\","   \"    pos -= 1;","     buf[pos] = b'\\\\n';\" \\","   \"    pos -= 1;","     buf[pos] = b' ';\""," check \"printf trailing newline\" differential row08"," ","-# 6. argv[1] is read before argv[2] (statement order in main).","+# 6. strtol accepts a leading '+' as well as '-'."," mutate src/container_of.rs \\","-  '    let arg1 = core::ptr::read_volatile(argv.wrapping_add(1));","-    let a = atoi(arg1);","+  \"    let negative = if cur == b'+' || cur == b'-' {\" \\","+  \"    let negative = if cur == b'-' {\"","+check \"strtol accepts a leading '+'\" differential row10"," ","-    // `int b = atoi(argv[2]);`","-    let arg2 = core::ptr::read_volatile(argv.wrapping_add(2));","-    let b = atoi(arg2);' \\","-  '    let arg2 = core::ptr::read_volatile(argv.wrapping_add(2));","-    let b = atoi(arg2);","-","-    let arg1 = core::ptr::read_volatile(argv.wrapping_add(1));","-    let a = atoi(arg1);'","-check \"argv[1] parsed before argv[2]\" error_paths row02","-"," # 7. the (int) truncation of the long result."," mutate src/container_of.rs \\","   '    value as c_int' \\"]}],"userModified":false,"replaceAll":false}}
