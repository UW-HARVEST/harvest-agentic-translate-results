\n38\tpub type operation_func =\n39\t    Option<unsafe extern \"C\" fn(a: c_int, b: c_int, unused1: c_int, unused2: c_int) -> c_int>;\n40\t\n41\t/// C: `typedef struct { int value; double scaled; int rank; } Result;`\n42\t///\n43\t/// `#[repr(C)]` guarantees the same layout as the C struct\n44\t/// (offsets 0 / 8 / 16, size 24, align 8).\n45\t#[repr(C)]\n46\t#[derive(Clone, Copy, Debug, Default)]\n47\tpub struct Result {\n48\t    pub value: c_int,\n49\t    pub scaled: c_double,\n50\t    pub rank: c_int,\n51\t}\n52\t\n53\t/// C: `typedef struct { Result data[10]; int count; } ResultArray;`\n54\t/// (size 248, align 8)\n55\t#[repr(C)]\n56\t#[derive(Clone, Copy, Debug)]\n57\tpub struct ResultArray {\n58\t    pub data: [Result; 10],\n59\t    pub count: c_int,\n60\t}\n61\t\n62\timpl Default for ResultArray {\n63\t    fn default() -> Self {\n64\t        ResultArray {\n65\t            data: [Result::default(); 10],\n66\t            count: 0,\n67\t        }\n68\t    }\n69\t}\n70\t\n71\t// ---------------------------------------------------------------------------\n72\t// Operations\n73\t// ---------------------------------------------------------------------------\n74\t\n75\t/// C: `int add_operation(int a, int b, int unused1, int unused2)`\n76\t///\n77\t/// Signed overflow is UB in C; reproduce the wrapping behaviour that the\n78\t/// compiled C code actually exhibits on two's-complement hardware.\n79\t#[unsafe(no_mangle)]\n80\tpub extern \"C\" fn add_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n81\t    a.wrapping_add(b)\n82\t}\n83\t\n84\t/// C: `int multiply_operation(int a, int b, int unused1, int unused2)`\n85\t#[unsafe(no_mangle)]\n86\tpub extern \"C\" fn multiply_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n87\t    a.wrapping_mul(b)\n88\t}\n89\t\n90\t/// C: `int subtract_operation(int a, int b, int unused1, int unused2)`\n91\t#[unsafe(no_mangle)]\n92\tpub extern \"C\" fn subtract_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n93\t    a.wrapping_sub(b)\n94\t}\n95\t\n96\t/// C: `int modulo_operation(int a, int b, int unused1, int unused2)`\n97\t///\n98\t/// Keeps the original `b == 0` guard (and its `return 0`) in place.\n99\t#[unsafe(no_mangle)]\n100\tpub extern \"C\" fn modulo_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n101\t    if b == 0 {\n102\t        return 0;\n103\t    }\n104\t    // `wrapping_rem` matches `a % b` for every input the C code can compute\n105\t    // without trapping, and avoids a Rust panic for `INT_MIN % -1` (UB in C).\n106\t    a.wrapping_rem(b)\n107\t}\n108\t\n109\t// ---------------------------------------------------------------------------\n110\t// Numeric helpers\n111\t// ---------------------------------------------------------------------------\n112\t\n113\t/// C: `int safe_double_to_int(double d)`\n114\t///\n115\t/// The order of the checks is preserved exactly: the saturation tests come\n116\t/// first, then the NaN test (NaN fails both comparisons, so it still reaches\n117\t/// the `d != d` branch), then the plain truncating cast.\n118\t#[unsafe(no_mangle)]\n119\tpub extern \"C\" fn safe_double_to_int(d: c_double) -> c_int {\n120\t    if d >= c_int::MAX as c_double {\n121\t        return c_int::MAX;\n122\t    }\n123\t    if d <= c_int::MIN as c_double {\n124\t        return c_int::MIN;\n125\t    }\n126\t    if d != d {\n127\t        return 0;\n128\t    }\n129\t    // Here `d` is strictly inside (INT_MIN, INT_MAX), so the Rust saturating\n130\t    // cast is identical to C's truncation toward zero.\n131\t    d as c_int\n132\t}\n133\t\n134\t/// C: `int compute_scaled_value(int base, double scale_factor)`\n135\t#[unsafe(no_mangle)]\n136\tpub extern \"C\" fn compute_scaled_value(base: c_int, scale_factor: c_double) -> c_int {\n137\t    let scaled = base as c_double * scale_factor;\n138\t    safe_double_to_int(scaled)\n139\t}\n140\t\n141\t// ---------------------------------------------------------------------------\n142\t// Array routines\n143\t// ---------------------------------------------------------------------------\n144\t\n145\t/// C: `int compare_results_in_array(ResultArray *arr, int idx1, int idx2)`\n146\t///\n147\t/// The C code compares the *addresses* `&arr->data[idx1]` and\n148\t/// `&arr->data[idx2]`. Because `data` is a contiguous array, that address\n149\t/// ordering is exactly the ordering of the indices, so comparing the indices\n150\t/// reproduces the result bit-for-bit (including for the negative indices the\n151\t/// original never validates).\n152\t///\n153\t/// # Safety\n154\t/// `arr` must be a valid pointer to a `ResultArray`, as in C.\n155\t#[unsafe(no_mangle)]\n156\tpub unsafe extern \"C\" fn compare_results_in_array(\n157\t    arr: *mut ResultArray,\n158\t    idx1: c_int,\n159\t    idx2: c_int,\n160\t) -> c_int {\n161\t    let count = unsafe { (*arr).count };\n162\t\n163\t    if idx1 >= count || idx2 >= count {\n164\t        return 0;\n165\t    }\n166\t\n167\t    if idx1 < idx2 {\n168\t        -1\n169\t    } else if idx1 > idx2 {\n170\t        1\n171\t    } else {\n172\t        0\n173\t    }\n174\t}\n175\t\n176\t/// C: `void init_result_array(ResultArray *arr, int values[], int count)`\n177\t///\n178\t/// Note the original clamps only the upper bound (`count < 10 ? count : 10`);\n179\t/// a negative `count` is stored verbatim and the fill loop simply does not run.\n180\t///\n181\t/// # Safety\n182\t/// `arr` must be valid, and `values` must point to at least `min(count, 10)`\n183\t/// `int`s, as in C.\n184\t#[unsafe(no_mangle)]\n185\tpub unsafe extern \"C\" fn init_result_array(\n186\t    arr: *mut ResultArray,\n187\t    values: *const c_int,\n188\t    count: c_int,\n189\t) {\n190\t    let clamped = if count < 10 { count } else { 10 };\n191\t    unsafe {\n192\t        (*arr).count = clamped;\n193\t    }\n194\t\n195\t    let mut i: c_int = 0;\n196\t    while i < clamped {\n197\t        let v = unsafe { *values.offset(i as isize) };\n198\t        unsafe {\n199\t            (*arr).data[i as usize] = Result {\n200\t                value: v,\n201\t                scaled: v as c_double * 1.5,\n202\t                rank: i,\n203\t            };\n204\t        }\n205\t        i += 1;\n206\t    }\n207\t}\n208\t\n209\t/// C: `int process_with_foreach(ResultArray *arr, operation_func op)`\n210\t///\n211\t/// The `FOREACH` macro expands to a loop whose termination test is\n212\t/// `count_iter != size` (with `size` latched once from `arr->count`); that\n213\t/// inequality — rather than a `<` bound — is reproduced faithfully.\n214\t///\n215\t/// # Safety\n216\t/// `arr` must be valid and `op` must be a callable function pointer, as in C.\n217\t#[unsafe(no_mangle)]\n218\tpub unsafe extern \"C\" fn process_with_foreach(arr: *mut ResultArray, op: operation_func) -> c_int {\n219\t    let mut total: c_int = 0;\n220\t\n221\t    let size: c_int = unsafe { (*arr).count };\n222\t    let op = unsafe { op.unwrap_unchecked() };\n223\t    let base: *mut Result = unsafe { (*arr).data.as_mut_ptr() };\n224\t\n225\t    let mut count_iter: c_int = 0;\n226\t    while count_iter != size {\n227\t        let item: *mut Result = unsafe { base.offset(count_iter as isize) };\n228\t\n229\t        let result = unsafe { op((*item).value, (*item).rank, 0, 0) };\n230\t        total = total.wrapping_add(result);\n231\t\n232\t        let temp = result as c_double * 0.75;\n233\t        unsafe {\n234\t            (*item).scaled = temp;\n235\t            (*item).value = safe_double_to_int(temp);\n236\t        }\n237\t\n238\t        count_iter += 1;\n239\t    }\n240\t\n241\t    total\n242\t}\n243\t\n244\t/// C: `int compute_weighted_sum(ResultArray *arr)`\n245\t///\n246\t/// `weight` comes from the pointer difference `current - base`, i.e. the index\n247\t/// `i`, except that the `current > base` test makes index 0 use a weight of 1.\n248\t///\n249\t/// # Safety\n250\t/// `arr` must be a valid pointer to a `ResultArray`, as in C.\n251\t#[unsafe(no_mangle)]\n252\tpub unsafe extern \"C\" fn compute_weighted_sum(arr: *mut ResultArray) -> c_int {\n253\t    let mut sum: c_int = 0;\n254\t\n255\t    let count = unsafe { (*arr).count };\n256\t\n257\t    let mut i: c_int = 0;\n258\t    while i < count {\n259\t        let base: *mut Result = unsafe { (*arr).data.as_mut_ptr() };\n260\t        let current: *mut Result = unsafe { base.offset(i as isize) };\n261\t\n262\t        let weight: c_int = if current > base {\n263\t            // `(int)(current - base)` == i\n264\t            i\n265\t        } else {\n266\t            1\n267\t        };\n268\t\n269\t        let value = unsafe { (*current).value };\n270\t        let weighted = value as c_double * weight as c_double * 0.8;\n271\t        sum = sum.wrapping_add(safe_double_to_int(weighted));\n272\t\n273\t        i += 1;\n274\t    }\n275\t\n276\t    sum\n277\t}\n278\t\n279\t/// C: `int arrayfunc(int param1, int param2, int param3, int param4)`\n280\t///\n281\t/// This is the sole function declared in the public header `include/lib.h`.\n282\t#[unsafe(no_mangle)]\n283\tpub extern \"C\" fn arrayfunc(param1: c_int, param2: c_int, param3: c_int, param4: c_int) -> c_int {\n284\t    let operations: [operation_func; 4] = [\n285\t        Some(add_operation),\n286\t        Some(multiply_operation),\n287\t        Some(subtract_operation),\n288\t        Some(modulo_operation),\n289\t    ];\n290\t\n291\t    let values: [c_int; 8] = [\n292\t        param1,\n293\t        param2,\n294\t        param3,\n295\t        param4,\n296\t        param1.wrapping_add(param2),\n297\t        param2.wrapping_sub(param3),\n298\t        param3.wrapping_mul(2),\n299\t        // C's `/` truncates toward zero, exactly like Rust's `/` on i32.\n300\t        param4.wrapping_div(2).wrapping_add(1),\n301\t    ];\n302\t\n303\t    let mut arr = ResultArray::default();\n304\t    unsafe { init_result_array(&mut arr, values.as_ptr(), 8) };\n305\t\n306\t    let mut result: c_int = 0;\n307\t\n308\t    for i in 0..4usize {\n309\t        result = result.wrapping_add(unsafe { process_with_foreach(&mut arr, operations[i]) });\n310\t    }\n311\t\n312\t    result = result.wrapping_add(unsafe { compute_weighted_sum(&mut arr) });\n313\t\n314\t    let mut i: c_int = 0;\n315\t    while i < arr.count - 1 {\n316\t        let cmp = unsafe { compare_results_in_array(&mut arr, i, i + 1) };\n317\t        result = result.wrapping_add(cmp);\n318\t        i += 1;\n319\t    }\n320\t\n321\t    let final_scale = result as c_double * 0.333;\n322\t    result = safe_double_to_int(final_scale);\n323\t\n324\t    result\n325\t}\n326\t"}]},"parent_tool_use_id":null,"session_id":"55fd6b2a-7b82-4260-9215-9268aa91a396","uuid":"8a6f139c-f145-45e6-afda-85d82b7a01da","timestamp":"2026-08-19T17:31:16.408Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-rRqwId/translated_rust/src/lib.rs","content":"// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n//! Rust translation of `c_src/src/lib.c`.\n//!\n//! Every non-static C function is reproduced with the exact same linker symbol\n//! name, signature, ABI and observable behaviour (including the quirks of the\n//! original code, which are intentionally *not* fixed).\n\n#![allow(non_camel_case_types)]\n\nuse std::ffi::{c_double, c_int};\n\n/// C: `typedef int (*operation_func)(int a, int b, int unused1, int unused2);`\n///\n/// Modelled as an `Option<...>` so that a NULL function pointer coming from C\n/// is representable (calling it, like in C, is undefined behaviour).\npub type operation_func =\n    Option<unsafe extern \"C\" fn(a: c_int, b: c_int, unused1: c_int, unused2: c_int) -> c_int>;\n\n/// C: `typedef struct { int value; double scaled; int rank; } Result;`\n///\n/// `#[repr(C)]` guarantees the same layout as the C struct\n/// (offsets 0 / 8 / 16, size 24, align 8).\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct Result {\n    pub value: c_int,\n    pub scaled: c_double,\n    pub rank: c_int,\n}\n\n/// C: `typedef struct { Result data[10]; int count; } ResultArray;`\n/// (size 248, align 8)\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct ResultArray {\n    pub data: [Result; 10],\n    pub count: c_int,\n}\n\nimpl Default for ResultArray {\n    fn default() -> Self {\n        ResultArray {\n            data: [Result::default(); 10],\n            count: 0,\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Operations\n// ---------------------------------------------------------------------------\n\n/// C: `int add_operation(int a, int b, int unused1, int unused2)`\n///\n/// Signed overflow is UB in C; reproduce the wrapping behaviour that the\n/// compiled C code actually exhibits on two's-complement hardware.\n#[unsafe(no_mangle)]\npub extern \"C\" fn add_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n    a.wrapping_add(b)\n}\n\n/// C: `int multiply_operation(int a, int b, int unused1, int unused2)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn multiply_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n    a.wrapping_mul(b)\n}\n\n/// C: `int subtract_operation(int a, int b, int unused1, int unused2)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn subtract_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n    a.wrapping_sub(b)\n}\n\n/// C: `int modulo_operation(int a, int b, int unused1, int unused2)`\n///\n/// Keeps the original `b == 0` guard (and its `return 0`) in place.\n#[unsafe(no_mangle)]\npub extern \"C\" fn modulo_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n    if b == 0 {\n        return 0;\n    }\n    // `wrapping_rem` matches `a % b` for every input the C code can compute\n    // without trapping, and avoids a Rust panic for `INT_MIN % -1` (UB in C).\n    a.wrapping_rem(b)\n}\n\n// ---------------------------------------------------------------------------\n// Numeric helpers\n// ---------------------------------------------------------------------------\n\n/// C: `int safe_double_to_int(double d)`\n///\n/// The order of the checks is preserved exactly: the saturation tests come\n/// first, then the NaN test (NaN fails both comparisons, so it still reaches\n/// the `d != d` branch), then the plain truncating cast.\n#[unsafe(no_mangle)]\npub extern \"C\" fn safe_double_to_int(d: c_double) -> c_int {\n    if d >= c_int::MAX as c_double {\n        return c_int::MAX;\n    }\n    if d <= c_int::MIN as c_double {\n        return c_int::MIN;\n    }\n    if d != d {\n        return 0;\n    }\n    // Here `d` is strictly inside (INT_MIN, INT_MAX), so the Rust saturating\n    // cast is identical to C's truncation toward zero.\n    d as c_int\n}\n\n/// C: `int compute_scaled_value(int base, double scale_factor)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn compute_scaled_value(base: c_int, scale_factor: c_double) -> c_int {\n    let scaled = base as c_double * scale_factor;\n    safe_double_to_int(scaled)\n}\n\n// ---------------------------------------------------------------------------\n// Array routines\n// ---------------------------------------------------------------------------\n\n/// C: `int compare_results_in_array(ResultArray *arr, int idx1, int idx2)`\n///\n/// The C code compares the *addresses* `&arr->data[idx1]` and\n/// `&arr->data[idx2]`. Because `data` is a contiguous array, that address\n/// ordering is exactly the ordering of the indices, so comparing the indices\n/// reproduces the result bit-for-bit (including for the negative indices the\n/// original never validates).\n///\n/// # Safety\n/// `arr` must be a valid pointer to a `ResultArray`, as in C.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn compare_results_in_array(\n    arr: *mut ResultArray,\n    idx1: c_int,\n    idx2: c_int,\n) -> c_int {\n    let count = unsafe { (*arr).count };\n\n    if idx1 >= count || idx2 >= count {\n        return 0;\n    }\n\n    if idx1 < idx2 {\n        -1\n    } else if idx1 > idx2 {\n        1\n    } else {\n        0\n    }\n}\n\n/// C: `void init_result_array(ResultArray *arr, int values[], int count)`\n///\n/// Note the original clamps only the upper bound (`count < 10 ? count : 10`);\n/// a negative `count` is stored verbatim and the fill loop simply does not run.\n///\n/// # Safety\n/// `arr` must be valid, and `values` must point to at least `min(count, 10)`\n/// `int`s, as in C.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn init_result_array(\n    arr: *mut ResultArray,\n    values: *const c_int,\n    count: c_int,\n) {\n    let clamped = if count < 10 { count } else { 10 };\n    unsafe {\n        (*arr).count = clamped;\n    }\n\n    let mut i: c_int = 0;\n    while i < clamped {\n        let v = unsafe { *values.offset(i as isize) };\n        unsafe {\n            (*arr).data[i as usize] = Result {\n                value: v,\n                scaled: v as c_double * 1.5,\n                rank: i,\n            };\n        }\n        i += 1;\n    }\n}\n\n/// C: `int process_with_foreach(ResultArray *arr, operation_func op)`\n///\n/// The `FOREACH` macro expands to a loop whose termination test is\n/// `count_iter != size` (with `size` latched once from `arr->count`); that\n/// inequality — rather than a `<` bound — is reproduced faithfully.\n///\n/// # Safety\n/// `arr` must be valid and `op` must be a callable function pointer, as in C.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn process_with_foreach(arr: *mut ResultArray, op: operation_func) -> c_int {\n    let mut total: c_int = 0;\n\n    let size: c_int = unsafe { (*arr).count };\n    let op = unsafe { op.unwrap_unchecked() };\n    let base: *mut Result = unsafe { (*arr).data.as_mut_ptr() };\n\n    let mut count_iter: c_int = 0;\n    while count_iter != size {\n        let item: *mut Result = unsafe { base.offset(count_iter as isize) };\n\n        let result = unsafe { op((*item).value, (*item).rank, 0, 0) };\n        total = total.wrapping_add(result);\n\n        let temp = result as c_double * 0.75;\n        unsafe {\n            (*item).scaled = temp;\n            (*item).value = safe_double_to_int(temp);\n        }\n\n        count_iter += 1;\n    }\n\n    total\n}\n\n/// C: `int compute_weighted_sum(ResultArray *arr)`\n///\n/// `weight` comes from the pointer difference `current - base`, i.e. the index\n/// `i`, except that the `current > base` test makes index 0 use a weight of 1.\n///\n/// # Safety\n/// `arr` must be a valid pointer to a `ResultArray`, as in C.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn compute_weighted_sum(arr: *mut ResultArray) -> c_int {\n    let mut sum: c_int = 0;\n\n    let count = unsafe { (*arr).count };\n\n    let mut i: c_int = 0;\n    while i < count {\n        let base: *mut Result = unsafe { (*arr).data.as_mut_ptr() };\n        let curre