le/libfallcalc_lib.so\" | awk '{print $NF}' | sort) \\\n      > /tmp/symdiff.$$ 2>/dev/null\n    if [ -s /tmp/symdiff.$$ ]; then\n      echo \"MISSING SYMBOLS IN RUST .so:\"; cat /tmp/symdiff.$$; FAIL=1\n    else\n      echo \"symbol diff EMPTY (all C symbols exported by Rust) OK\"\n    fi\n    rm -f /tmp/symdiff.$$\n\n    step \"profile=$profile features='${combo:-<none>}' : cargo test (Phases B, C, D)\"\n    timeout 600 cargo test --offline --no-default-features $RELFLAG \"${FEATFLAG[@]}\" 2>&1 \\\n      | grep -E '^(test result|running|error)|FAILED|panicked'\n    [ \"${PIPESTATUS[0]}\" = 0 ] || FAIL=1\n  done\ndone\n\nstep \"RESULT\"\nif [ \"$FAIL\" = 0 ]; then echo \"ALL CONFIGURATIONS PASS\"; else echo \"FAILURES DETECTED\"; fi\nexit \"$FAIL\"\n","structuredPatch":[{"oldStart":78,"oldLines":13,"newStart":78,"newLines":13,"lines":["     comm -23 \\","       <(nm -D --defined-only c_src/build/libtranslated_rust.so | awk '{print $NF}' | grep -v '^_' | sort) \\","       <(nm -D --defined-only \"target/$profile/libfallcalc_lib.so\" | awk '{print $NF}' | sort) \\","-      > /tmp/symdiff.$$ 2>/dev/null","-    if [ -s /tmp/symdiff.$$ ]; then","-      echo \"MISSING SYMBOLS IN RUST .so:\"; cat /tmp/symdiff.$$; FAIL=1","+      > \"$WORKTMP/symdiff.$$\" 2>/dev/null","+    if [ -s \"$WORKTMP/symdiff.$$\" ]; then","+      echo \"MISSING SYMBOLS IN RUST .so:\"; cat \"$WORKTMP/symdiff.$$\"; FAIL=1","     else","       echo \"symbol diff EMPTY (all C symbols exported by Rust) OK\"","     fi","-    rm -f /tmp/symdiff.$$","+    rm -f \"$WORKTMP/symdiff.$$\""," ","     step \"profile=$profile features='${combo:-<none>}' : cargo test (Phases B, C, D)\"","     timeout 600 cargo test --offline --no-default-features $RELFLAG \"${FEATFLAG[@]}\" 2>&1 \\"]}],"userModified":false,"replaceAll":true}}
