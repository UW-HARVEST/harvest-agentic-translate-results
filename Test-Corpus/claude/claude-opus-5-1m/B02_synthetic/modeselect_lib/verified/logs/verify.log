the C version.\n    32\t\n    33\t#![allow(clippy::missing_safety_doc)]\n    34\t\n    35\tuse core::ffi::{c_char, c_double, c_int, c_long};\n    36\t\n    37\t// ---------------------------------------------------------------------------\n    38\t// libc bindings (used so formatting / string handling matches C exactly)\n    39\t// ---------------------------------------------------------------------------\n    40\tunsafe extern \"C\" {\n    41\t    #[link_name = \"printf\"]\n    42\t    unsafe fn c_printf(fmt: *const c_char, ...) -> c_int;\n    43\t    #[link_name = \"strcmp\"]\n    44\t    unsafe fn c_strcmp(a: *const c_char, b: *const c_char) -> c_int;\n    45\t    #[link_name = \"time\"]\n    46\t    unsafe fn c_time(tloc: *mut time_t) -> time_t;\n    47\t}\n    48\t\n    49\t/// `time_t` on Linux/x86-64 (64-bit signed).\n    50\t#[allow(non_camel_case_types)]\n    51\tpub type time_t = i64;\n    52\t\n    53\t// ---------------------------------------------------------------------------\n    54\t// helpers\n    55\t// ---------------------------------------------------------------------------\n    56\t\n    57\t/// Reproduce the x86-64 `cvttsd2si` (double -> int32) conversion used by the C\n    58\t/// compiler, including the out-of-range / NaN behaviour (which is undefined in\n    59\t/// C but deterministically yields INT_MIN on this target). Note that Rust's\n    60\t/// `as` cast saturates instead, so the range checks below are required.\n    61\t#[inline]\n    62\tfn double_to_int(value: c_double) -> c_int {\n    63\t    if value.is_nan() || value >= 2147483648.0 || value <= -2147483648.0 {\n    64\t        i32::MIN as c_int\n    65\t    } else {\n    66\t        value as c_int\n    67\t    }\n    68\t}\n    69\t\n    70\t// ---------------------------------------------------------------------------\n    71\t// public ABI\n    72\t// ---------------------------------------------------------------------------\n    73\t\n    74\t/// int classify_mode(const char *mode);\n    75\t#[unsafe(no_mangle)]\n    76\tpub unsafe extern \"C\" fn classify_mode(mode: *const c_char) -> c_int {\n    77\t    unsafe {\n    78\t        if c_strcmp(mode, c\"standard\".as_ptr()) == 0 {\n    79\t            return 0x10;\n    80\t        } else if c_strcmp(mode, c\"enhanced\".as_ptr()) == 0 {\n    81\t            return 0x20;\n    82\t        } else if c_strcmp(mode, c\"turbo\".as_ptr()) == 0 {\n    83\t            return 0x30;\n    84\t        } else if c_strcmp(mode, c\"extreme\".as_ptr()) == 0 {\n    85\t            return 0x40;\n    86\t        }\n    87\t        0x00\n    88\t    }\n    89\t}\n    90\t\n    91\t/// int apply_multiplier(int base, int level);\n    92\t///\n    93\t/// The C `switch` deliberately falls through from one case to the next, so the\n    94\t/// accumulated constants are additive.\n    95\t#[unsafe(no_mangle)]\n    96\tpub extern \"C\" fn apply_multiplier(base: c_int, level: c_int) -> c_int {\n    97\t    let mut result: c_int = base;\n    98\t\n    99\t    match level {\n   100\t        4 => {\n   101\t            result = result.wrapping_add(0xFF);\n   102\t            result = result.wrapping_add(0xAB);\n   103\t            result = result.wrapping_add(0x7E);\n   104\t            result = result.wrapping_add(0x1C);\n   105\t            result = result.wrapping_add(0x05);\n   106\t        }\n   107\t        3 => {\n   108\t            result = result.wrapping_add(0xAB);\n   109\t            result = result.wrapping_add(0x7E);\n   110\t            result = result.wrapping_add(0x1C);\n   111\t            result = result.wrapping_add(0x05);\n   112\t        }\n   113\t        2 => {\n   114\t            result = result.wrapping_add(0x7E);\n   115\t            result = result.wrapping_add(0x1C);\n   116\t            result = result.wrapping_add(0x05);\n   117\t        }\n   118\t        1 => {\n   119\t            result = result.wrapping_add(0x1C);\n   120\t            result = result.wrapping_add(0x05);\n   121\t        }\n   122\t        0 => {\n   123\t            result = result.wrapping_add(0x05);\n   124\t        }\n   125\t        _ => {\n   126\t            result = 0xDEAD;\n   127\t        }\n   128\t    }\n   129\t\n   130\t    result\n   131\t}\n   132\t\n   133\t/// int convert_time_factor(double factor);\n   134\t#[unsafe(no_mangle)]\n   135\tpub extern \"C\" fn convert_time_factor(factor: c_double) -> c_int {\n   136\t    let scaled: c_double = factor * 1e12;\n   137\t    double_to_int(scaled)\n   138\t}\n   139\t\n   140\t/// int convert_negative_overflow(double value);\n   141\t#[unsafe(no_mangle)]\n   142\tpub extern \"C\" fn convert_negative_overflow(value: c_double) -> c_int {\n   143\t    let extreme: c_double = value * -1e15;\n   144\t    double_to_int(extreme)\n   145\t}\n   146\t\n   147\t/// time_t get_modified_time(int offset_days, int offset_hours);\n   148\t///\n   149\t/// The offset is computed with `int` arithmetic in C (and only then widened to\n   150\t/// `time_t`), so large day counts wrap around 32 bits.\n   151\t#[unsafe(no_mangle)]\n   152\tpub extern \"C\" fn get_modified_time(offset_days: c_int, offset_hours: c_int) -> time_t {\n   153\t    let mut current: time_t = unsafe { c_time(core::ptr::null_mut()) };\n   154\t    current >>= 29;\n   155\t    let offset: time_t = offset_days\n   156\t        .wrapping_mul(86400)\n   157\t        .wrapping_add(offset_hours.wrapping_mul(3600)) as time_t;\n   158\t    current.wrapping_add(offset)\n   159\t}\n   160\t\n   161\t/// int hash_time_value(time_t t);\n   162\t#[unsafe(no_mangle)]\n   163\tpub extern \"C\" fn hash_time_value(t: time_t) -> c_int {\n   164\t    let mut hash: c_int = 0x5A5A5A5Au32 as c_int;\n   165\t    let bytes = t.to_ne_bytes();\n   166\t\n   167\t    for i in 0..core::mem::size_of::<time_t>() {\n   168\t        let shift = ((i % 4) * 8) as u32;\n   169\t        hash ^= (bytes[i] as c_int).wrapping_shl(shift);\n   170\t        hash = hash.wrapping_mul(0x1F);\n   171\t    }\