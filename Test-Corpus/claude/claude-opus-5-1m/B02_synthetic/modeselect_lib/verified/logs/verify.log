{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0142WubhZJBq7GPDryLeaboz","type":"tool_result","content":"300\t    }\n301\t    /// A finite `f64` in `(-10^exp, 10^exp)`.\n302\t    pub fn scaled_f64(&mut self, exp: i32) -> f64 {\n303\t        let m = (self.next_u64() >> 11) as f64 / (1u64 << 53) as f64; // [0,1)\n304\t        let s = if self.next_u64() & 1 == 0 { 1.0 } else { -1.0 };\n305\t        s * m * 10f64.powi(exp)\n306\t    }\n307\t}\n308\t\n309\t// ---------------------------------------------------------------------------\n310\t// differential assertions\n311\t// ---------------------------------------------------------------------------\n312\t\n313\t/// `time() >> 29` — the only clock-derived quantity the library uses. It\n314\t/// changes roughly once every 17 years, so it is effectively constant, but the\n315\t/// tests still guard against straddling a tick.\n316\tpub fn coarse_now() -> i64 {\n317\t    (unsafe { time(std::ptr::null_mut()) }) >> 29\n318\t}\n319\t\n320\t/// Compare the return value of the same call made against both libraries.\n321\t/// Used for the six functions that perform no I/O (their silence is asserted\n322\t/// separately, see `silent_functions_produce_no_output`).\n323\tpub fn assert_same<T, F>(ctx: &str, mut call: F)\n324\twhere\n325\t    T: PartialEq + std::fmt::Debug,\n326\t    F: FnMut(&Api) -> T,\n327\t{\n328\t    let (c, r) = both();\n329\t    for attempt in 0..3 {\n330\t        let t0 = coarse_now();\n331\t        let cv = call(&c);\n332\t        let rv = call(&r);\n333\t        let t1 = coarse_now();\n334\t        if t0 != t1 && attempt < 2 {\n335\t            continue; // coarse-clock boundary straddled; retry\n336\t        }\n337\t        assert_eq!(cv, rv, \"return value mismatch for {ctx}\");\n338\t        return;\n339\t    }\n340\t    unreachable!()\n341\t}\n342\t\n343\t/// Compare `(return value, stdout bytes)` of the same call made against both\n344\t/// libraries and return the agreed-upon pair.\n345\t///\n346\t/// A disagreement is retried a few times before it is reported: fd 1 is a\n347\t/// process-wide resource, so if libtest happens to be running tests in parallel\n348\t/// its own progress output can land inside a capture window. Contamination is\n349\t/// non-deterministic, a genuine divergence is not.\n350\tpub fn same_io<T, F>(ctx: &str, mut call: F) -> (T, Vec<u8>)\n351\twhere\n352\t    T: PartialEq + std::fmt::Debug,\n353\t    F: FnMut(&Api) -> T,\n354\t{\n355\t    let (c, r) = both();\n356\t    let mut last: Option<(T, T, Vec<u8>, Vec<u8>)> = None;\n357\t    for _ in 0..6 {\n358\t        let t0 = coarse_now();\n359\t        let (cv, cout) = capture_stdout(|| call(&c));\n360\t        let (rv, rout) = capture_stdout(|| call(&r));\n361\t        let t1 = coarse_now();\n362\t        if t0 == t1 && cv == rv && cout == rout {\n363\t            return (cv, cout);\n364\t        }\n365\t        last = Some((cv, rv, cout, rout));\n366\t    }\n367\t    let (cv, rv, cout, rout) = last.unwrap();\n368\t    assert_eq!(cv, rv, \"return value mismatch for {ctx}\");\n369\t    assert_eq!(\n370\t        cout,\n371\t        rout,\n372\t        \"stdout mismatch for {ctx}\\n C   : {}\\n RUST: {}\",\n373\t        show(&cout),\n374\t        show(&rout)\n375\t    );\n376\t    panic!(\"unstable result for {ctx} (clock boundary or fd-1 contamination)\");\n377\t}\n378\t\n379\t/// `same_io`, discarding the agreed value."}]},"parent_tool_use_id":null,"session_id":"36039f30-fd09-4c4d-8331-c2e5578be93e","uuid":"c8035ada-9be2-49d5-99ee-d8492917137e","timestamp":"2026-08-19T22:34:46.594Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-tHYY0x/translated_rust/tests/common/mod.rs","content":"    }\n    /// A finite `f64` in `(-10^exp, 10^exp)`.\n    pub fn scaled_f64(&mut self, exp: i32) -> f64 {\n        let m = (self.next_u64() >> 11) as f64 / (1u64 << 53) as f64; // [0,1)\n        let s = if self.next_u64() & 1 == 0 { 1.0 } else { -1.0 };\n        s * m * 10f64.powi(exp)\n    }\n}\n\n// ---------------------------------------------------------------------------\n// differential assertions\n// ---------------------------------------------------------------------------\n\n/// `time() >> 29` — the only clock-derived quantity the library uses. It\n/// changes roughly once every 17 years, so it is effectively constant, but the\n/// tests still guard against straddling a tick.\npub fn coarse_now() -> i64 {\n    (unsafe { time(std::ptr::null_mut()) }) >> 29\n}\n\n/// Compare the return value of the same call made against both libraries.\n/// Used for the six functions that perform no I/O (their silence is asserted\n/// separately, see `silent_functions_produce_no_output`).\npub fn assert_same<T, F>(ctx: &str, mut call: F)\nwhere\n    T: PartialEq + std::fmt::Debug,\n    F: FnMut(&Api) -> T,\n{\n    let (c, r) = both();\n    for attempt in 0..3 {\n        let t0 = coarse_now();\n        let cv = call(&c);\n        let rv = call(&r);\n        let t1 = coarse_now();\n        if t0 != t1 && attempt < 2 {\n            continue; // coarse-clock boundary straddled; retry\n        }\n        assert_eq!(cv, rv, \"return value mismatch for {ctx}\");\n        return;\n    }\n    unreachable!()\n}\n\n/// Compare `(return value, stdout bytes)` of the same call made against both\n/// libraries and return the agreed-upon pair.\n///\n/// A disagreement is retried a few times before it is reported: fd 1 is a\n/// process-wide resource, so if libtest happens to be running tests in parallel\n/// its own progress output can land inside a capture window. Contamination is\n/// non-deterministic, a genuine divergence is not.\npub fn same_io<T, F>(ctx: &str, mut call: F) -> (T, Vec<u8>)\nwhere\n    T: PartialEq + std::fmt::Debug,\n    F: FnMut(&Api) -> T,\n{\n    let (c, r) = both();\n    let mut last: Option<(T, T, Vec<u8>, Vec<u8>)> = None;\n    for _ in 0..6 {\n        let t0 = coarse_now();\n        let (cv, cout) = capture_stdout(|| call(&c));\n        let (rv, rout) = capture_stdout(|| call(&r));\n        let t1 = coarse_now();\n        if t0 == t1 && cv == rv && cout == rout {\n            return (cv, cout);\n        }\n        last = Some((cv, rv, cout, rout));\n    }\n    let (cv, rv, cout, rout) = last.unwrap();\n    assert_eq!(cv, rv, \"return value mismatch for {ctx}\");\n    assert_eq!(\n        cout,\n        rout,\n        \"stdout mismatch for {ctx}\\n C   : {}\\n RUST: {}\",\n        show(&cout),\n        show(&rout)\n    );\n    panic!(\"unstable result for {ctx} (clock boundary or fd-1 contamination)\");\n}\n\n/// `same_io`, discarding the agreed value.","numLines":80,"startLine":300,"totalLines":421}}}
