00, rnd_int(rng)])\n            toks.append(ln)\n            if 0 <= ln <= 256:\n                for _ in range(ln):\n                    toks.append(rng.choice([rng.randint(0, 255), rng.randint(-300, 600)]))\n        # extra trailing token (split pos / rotate amount)\n        if rng.random() < 0.9:\n            toks.append(rng.choice([0, 1, 2, 3, rnd_int(rng), rng.randint(-300, 300)]))\n        if rng.random() < 0.2:\n            toks.append(rnd_int(rng))\n    else:\n        for _ in range(rng.randint(0, 12)):\n            toks.append(rnd_int(rng))\n\n    s = \"\"\n    for i, t in enumerate(toks):\n        if i:\n            s += rnd_ws(rng)\n        pre = \"\"\n        if rng.random() < 0.05 and t >= 0:\n            pre = \"+\"\n        if rng.random() < 0.03 and t >= 0:\n            pre = \"0\" * rng.randint(1, 3)\n        s += pre + str(t)\n    # occasional garbage tail / garbage token\n    if rng.random() < 0.10:\n        s += rng.choice([\"x\", \" x\", \" abc\", \" -\", \" +\", \" --3\", \" 1.5\", \" 0x10\", \"\\n\\n\"])\n    if rng.random() < 0.05:\n        s = rng.choice([\"\", \" \", \"\\n\", \"x\", \"-\", \"+\"]) + s\n    if rng.random() < 0.3:\n        s += \"\\n\"\n    return s\n\n\ndef run(exe, data):\n    p = subprocess.run([exe], input=data.encode(\"latin-1\"),\n                       stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=20)\n    return p.returncode, p.stdout, p.stderr\n\n\ndef main():\n    n = int(sys.argv[1]) if len(sys.argv) > 1 else 2000\n    seed = int(sys.argv[2]) if len(sys.argv) > 2 else 12345\n    rng = random.Random(seed)\n    bad = 0\n    for it in range(n):\n        data = gen(rng)\n        try:\n            crc, cout, cerr = run(C, data)\n            rrc, rout, rerr = run(R, data)\n        except subprocess.TimeoutExpired:\n            print(\"TIMEOUT on:\", repr(data))\n            bad += 1\n            continue\n        if (crc, cout, cerr) != (rrc, rout, rerr):\n            bad += 1\n            print(\"=== MISMATCH 