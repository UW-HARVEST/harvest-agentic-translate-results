ad_from_start(&mut s.out), read_from_start(&mut s.err))","     };"," ","-    let _ = std::fs::remove_file(&out_p);","-    let _ = std::fs::remove_file(&err_p);","-    if let Some(p) = in_p {","-        let _ = std::fs::remove_file(p);","-    }","-","     Obs { ret, stdout, stderr }"," }"," ","+/// Path of the scratch file that `observe()` installs as fd 0 — needed by the","+/// C side's `freopen(..., stdin)`.","+pub fn observe_stdin_path() -> PathBuf {","+    let s = match scratch().lock() {","+        Ok(g) => g,","+        Err(p) => p.into_inner(),","+    };","+    s.stdin_path.clone()","+}","+","+fn read_from_start(f: &mut std::fs::File) -> Vec<u8> {","+    let mut v = Vec::new();","+    f.seek(std::io::SeekFrom::Start(0)).ok();","+    f.read_to_end(&mut v).ok();","+    v","+}","+"," fn read_all(p: &Path) -> Vec<u8> {","     let mut v = Vec::new();","     if let Ok(mut f) = std::fs::File::open(p) {"]}],"userModified":false,"replaceAll":false}}
