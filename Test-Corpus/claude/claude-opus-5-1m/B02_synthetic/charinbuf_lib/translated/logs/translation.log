sult);\n                } else {\n                    printf(\"Character '%c' not found\\n\", search_char);\n                    result = -1;\n                }\n\n                free(buffer);\n                buffer = NULL;\n            }\n            break;\n\n        default:\n            printf(\"Invalid mode: %d\\n\", mode);\n            result = -1;\n    }\n\n    return result;\n}\n","numLines":211,"startLine":1,"totalLines":211}}}
