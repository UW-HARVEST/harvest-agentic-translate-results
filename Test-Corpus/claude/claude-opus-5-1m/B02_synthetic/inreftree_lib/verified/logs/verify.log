"parse/getop done, checks=%ld fails=%ld\\n\",checks,fails);\n\n  /* ---- add_tree_node / find_node_by_id / calculate_tree_sum direct API ---- */\n  const char* labels[] = {\"\", \"a\", \"root\", \"0123456789012345678901234567890\", /*31*/\n     \"01234567890123456789012345678901\", /*32*/\n     \"0123456789012345678901234567890123456789\", \"l\", \"ll\", \"xxlxx\"};\n  int nl = sizeof(labels)/sizeof(labels[0]);\n  for(long trial=0; trial<20000; trial++){\n    *C.count=0; *R.count=0;\n    memset(C.table,0,50*sizeof(TreeNode)); memset(R.table,0,50*sizeof(TreeNode));\n    int nsteps = 1 + (unsigned)rnd()%8;\n    for(int s=0;s<nsteps;s++){\n      int kind=(unsigned)rnd()%4;\n      if(kind==0){\n        int id=(int)((unsigned)rnd()%9)-2;\n        int val=rnd();\n        int par=(int)((unsigned)rnd()%9)-2;\n        const char* lb=labels[(unsigned)rnd()%nl];\n        int a=C.addn(id,val,par,lb), b=R.addn(id,val,par,lb);\n        CK(a==b,\"add_tree_node(%d,%d,%d,\\\"%s\\\") C=%d R=%d\",id,val,par,lb,a,b);\n        CK(*C.count==*R.count,\"count after add C=%d R=%d\",*C.count,*R.count);\n        CK(memcmp(C.table,R.table,50*sizeof(TreeNode))==0,\"table after add(%d,%d,%d,\\\"%s\\\")\",id,val,par,lb);\n      } else if(kind==1){\n        int id=(int)((unsigned)rnd()%13)-3;\n        TreeNode* pc=C.find(id); TreeNode* pr=R.find(id);\n        long oc = pc? (pc - C.table) : -1;\n        long orr= pr? (pr - R.table) : -1;\n        CK(oc==orr,\"find_node_by_id(%d) idx C=%ld R=%ld\",id,oc,orr);\n      } else if(kind==2){\n        int id=(int)((unsigned)rnd()%13)-3;\n        /* only call when no cycle risk: our ids are small and tree is acyclic-ish; guard depth by trying */\n        int a=C.calc(id), b=R.calc(id);\n        CK(a==b,\"calculate_tree_sum(%d) C=%d R=%d\",id,a,b);\n      } else {\n        /* poke node_count to odd values incl >=50 and negative-free */\n        int nc = (int)((unsigned)rnd()%55);\n        *C.count=nc; *R.count=nc;\n        int a=C.addn(77,12345,-1,\"poke\"),