{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Aagg6xV5nyePdKHfhhM8AJ","type":"tool_result","content":"1\t// Rust translation of c_src/src/lib.c (MIT Lincoln Laboratory, 2025).\n2\t//\n3\t// The translation preserves the exact public ABI of the C shared library:\n4\t//   functions: add_op, multiply_op, subtract_op, divide_op, modulo_op,\n5\t//              find_node_by_id, add_tree_node, calculate_tree_sum,\n6\t//              parse_operation, get_operation_func, inreftree\n7\t//   data:      node_table, node_count\n8\t//\n9\t// Behaviour (including quirks/bugs) is reproduced exactly.\n10\t\n11\t#![allow(non_upper_case_globals)]\n12\t#![allow(non_camel_case_types)]\n13\t\n14\tuse std::ffi::{c_char, c_int};\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// typedef enum { OP_ADD = 1, ... } Operation;\n18\t// ---------------------------------------------------------------------------\n19\t\n20\tpub const OP_ADD: c_int = 1;\n21\tpub const OP_MULTIPLY: c_int = 2;\n22\tpub const OP_SUBTRACT: c_int = 3;\n23\tpub const OP_DIVIDE: c_int = 4;\n24\tpub const OP_MODULO: c_int = 5;\n25\t\n26\t// ---------------------------------------------------------------------------\n27\t// typedef struct { ... } TreeNode;\n28\t// ---------------------------------------------------------------------------\n29\t\n30\t#[repr(C)]\n31\t#[derive(Copy, Clone)]\n32\tpub struct TreeNode {\n33\t    pub id: c_int,\n34\t    pub value: c_int,\n35\t    pub parent_id: c_int,\n36\t    pub left_child_id: c_int,\n37\t    pub right_child_id: c_int,\n38\t    pub label: [c_char; 32],\n39\t}\n40\t\n41\tconst MAX_NODES: usize = 50;\n42\t\n43\tconst EMPTY_NODE: TreeNode = TreeNode {\n44\t    id: 0,\n45\t    value: 0,\n46\t    parent_id: 0,\n47\t    left_child_id: 0,\n48\t    right_child_id: 0,\n49\t    label: [0; 32],\n50\t};\n51\t\n52\t/// `TreeNode node_table[MAX_NODES];` (global, exported, zero initialised)\n53\t#[unsafe(no_mangle)]\n54\tpub static mut node_table: [TreeNode; MAX_NODES] = [EMPTY_NODE; MAX_NODES];\n55\t\n56\t/// `int node_count = 0;` (global, exported)\n57\t#[unsafe(no_mangle)]\n58\tpub static mut node_count: c_int = 0;\n59\t\n60\t/// typedef int (*OperationFunc)(int a, int b, int unused1, int unused2);\n61\tpub type OperationFunc = Option<extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int>;\n62\t\n63\t// ---------------------------------------------------------------------------\n64\t// Small helpers reproducing the libc routines used by the C code.\n65\t// ---------------------------------------------------------------------------\n66\t\n67\t/// Pointer to the first element of `node_table`, without creating a reference\n68\t/// to the mutable static.\n69\t#[inline]\n70\tfn table_ptr() -> *mut TreeNode {\n71\t    (&raw mut node_table) as *mut TreeNode\n72\t}\n73\t\n74\t/// `strchr(s, c)`: returns a pointer to the first occurrence of `c` in the\n75\t/// NUL-terminated string `s`, or NULL. Only used for non-NUL needles here, so\n76\t/// the terminator itself never matches.\n77\t#[inline]\n78\tunsafe fn c_strchr(s: *const c_char, c: u8) -> *const c_char {\n79\t    let mut p = s;\n80\t    loop {\n81\t        let ch = *p as u8;\n82\t        if ch == c {\n83\t            return p;\n84\t        }\n85\t        if ch == 0 {\n86\t            return std::ptr::null();\n87\t        }\n88\t        p = p.add(1);\n89\t    }\n90\t}\n91\t\n92\t/// `strncpy(dst, src, n)`: copies at most `n` bytes from `src`, stopping after\n93\t/// the terminating NUL, and zero-pads the remainder of the `n` bytes.\n94\t#[inline]\n95\tunsafe fn c_strncpy(dst: *mut c_char, src: *const c_char, n: usize) {\n96\t    let mut i = 0usize;\n97\t    while i < n {\n98\t        let ch = *src.add(i);\n99\t        *dst.add(i) = ch;\n100\t        i += 1;\n101\t        if ch == 0 {\n102\t            break;\n103\t        }\n104\t    }\n105\t    while i < n {\n106\t        *dst.add(i) = 0;\n107\t        i += 1;\n108\t    }\n109\t}\n110\t\n111\t// ---------------------------------------------------------------------------\n112\t// Operation implementations\n113\t// ---------------------------------------------------------------------------\n114\t\n115\t#[unsafe(no_mangle)]\n116\tpub extern \"C\" fn add_op(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n117\t    a.wrapping_add(b)\n118\t}\n119\t\n120\t#[unsafe(no_mangle)]\n121\tpub extern \"C\" fn multiply_op(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n122\t    a.wrapping_mul(b)\n123\t}\n124\t\n125\t#[unsafe(no_mangle)]\n126\tpub extern \"C\" fn subtract_op(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n127\t    a.wrapping_sub(b)\n128\t}\n129\t\n130\t#[unsafe(no_mangle)]\n131\tpub extern \"C\" fn divide_op(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n132\t    if b == 0 {\n133\t        return 0;\n134\t    }\n135\t    a.wrapping_div(b)\n136\t}\n137\t\n138\t#[unsafe(no_mangle)]\n139\tpub extern \"C\" fn modulo_op(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n140\t    if b == 0 {\n141\t        return 0;\n142\t    }\n143\t    a.wrapping_rem(b)\n144\t}\n145\t\n146\t// ---------------------------------------------------------------------------\n147\t// Tree handling\n148\t// ---------------------------------------------------------------------------\n149\t\n150\t#[unsafe(no_mangle)]\n151\tpub extern \"C\" fn find_node_by_id(id: c_int) -> *mut TreeNode {\n152\t    unsafe {\n153\t        let base = table_ptr();\n154\t        let count = node_count;\n155\t        let mut i: c_int = 0;\n156\t        while i < count {\n157\t            let node = base.offset(i as isize);\n158\t            if (*node).id == id {\n159\t                return node;\n160\t            }\n161\t            i += 1;\n162\t        }\n163\t    }\n164\t    std::ptr::null_mut()\n165\t}\n166\t\n167\t#[unsafe(no_mangle)]\n168\tpub extern \"C\" fn add_tree_node(\n169\t    id: c_int,\n170\t    value: c_int,\n171\t    parent_id: c_int,\n172\t    label: *const c_char,\n173\t) -> c_int {\n174\t    unsafe {\n175\t        if node_count >= MAX_NODES as c_int {\n176\t            return -1;\n177\t        }\n178\t\n179\t        let node = table_ptr().offset(node_count as isize);\n180\t        (*node).id = id;\n181\t        (*node).value = value;\n182\t        (*node).parent_id = parent_id;\n183\t        (*node).left_child_id = -1;\n184\t        (*node).right_child_id = -1;\n185\t        let label_ptr = (&raw mut (*node).label) as *mut c_char;\n186\t        c_strncpy(label_ptr, label, 31);\n187\t        *label_ptr.add(31) = 0;\n188\t\n189\t        if parent_id != -1 {\n190\t            let parent = find_node_by_id(parent_id);\n191\t            if parent.is_null() || (*parent).id != parent_id {\n192\t                return -1;\n193\t            }\n194\t\n195\t            if (*parent).left_child_id == -1 {\n196\t                (*parent).left_child_id = id;\n197\t            } else if (*parent).right_child_id == -1 {\n198\t                (*parent).right_child_id = id;\n199\t            }\n200\t        }\n201\t\n202\t        node_count = node_count.wrapping_add(1);\n203\t        node_count.wrapping_sub(1)\n204\t    }\n205\t}\n206\t\n207\t#[unsafe(no_mangle)]\n208\tpub extern \"C\" fn calculate_tree_sum(node_id: c_int) -> c_int {\n209\t    unsafe {\n210\t        let node = find_node_by_id(node_id);\n211\t\n212\t        if node.is_null() || (*node).id != node_id {\n213\t            return 0;\n214\t        }\n215\t\n216\t        let mut sum = (*node).value;\n217\t\n218\t        if (*node).left_child_id != -1 {\n219\t            sum = sum.wrapping_add(calculate_tree_sum((*node).left_child_id));\n220\t        }\n221\t\n222\t        if (*node).right_child_id != -1 {\n223\t            sum = sum.wrapping_add(calculate_tree_sum((*node).right_child_id));\n224\t        }\n225\t\n226\t        sum\n227\t    }\n228\t}\n229\t\n230\t// ---------------------------------------------------------------------------\n231\t// Operation dispatch\n232\t// ---------------------------------------------------------------------------\n233\t\n234\t#[unsafe(no_mangle)]\n235\tpub extern \"C\" fn parse_operation(op_str: *const c_char) -> c_int {\n236\t    unsafe {\n237\t        if op_str.is_null() || !c_strchr(op_str, b'+').is_null() {\n238\t            return OP_ADD;\n239\t        }\n240\t        if !c_strchr(op_str, b'*').is_null() {\n241\t            return OP_MULTIPLY;\n242\t        }\n243\t        if !c_strchr(op_str, b'-').is_null() {\n244\t            return OP_SUBTRACT;\n245\t        }\n246\t        if !c_strchr(op_str, b'/').is_null() {\n247\t            return OP_DIVIDE;\n248\t        }\n249\t        if !c_strchr(op_str, b'%').is_null() {\n250\t            return OP_MODULO;\n251\t        }\n252\t        OP_ADD\n253\t    }\n254\t}\n255\t\n256\t#[unsafe(no_mangle)]\n257\tpub extern \"C\" fn get_operation_func(op: c_int) -> OperationFunc {\n258\t    match op {\n259\t        1 => Some(add_op),\n260\t        2 => Some(multiply_op),\n261\t        3 => Some(subtract_op),\n262\t        4 => Some(divide_op),\n263\t        5 => Some(modulo_op),\n264\t        _ => Some(add_op),\n265\t    }\n266\t}\n267\t\n268\t// ---------------------------------------------------------------------------\n269\t// Entry point\n270\t// ---------------------------------------------------------------------------\n271\t\n272\t// `inreftree` indexes `op_string` (the literal \"+*-%\") with `tree_sum % 4`,\n273\t// which is NEGATIVE whenever `tree_sum` is negative and not a multiple of 4.\n274\t// That reads BEFORE the literal - undefined behaviour in C, but deterministic\n275\t// for a given build, so the translation has to reproduce the bytes the C build\n276\t// actually reads.\n277\t//\n278\t// The literal pool that gcc emits for lib.c is, verbatim from\n279\t// `objdump -s -j .rodata c_src/build/libtranslated_rust.so`:\n280\t//\n281\t//     726f6f74 00 6c656674 00 726967 6874 00 6c6566742d6c65 6674 00 2b2a2d25 00\n282\t//     \"root\\0\"    \"left\\0\"    \"right\\0\"    \"left-left\\0\"       \"+*-%\\0\"\n283\t//\n284\t// so with \"+*-%\" at offset 26 the reachable out-of-bounds indices are\n285\t//     op_string[-1] == 0x00 ('\\0')   op_string[-2] == 0x74 ('t')\n286\t//     op_string[-3] == 0x66 ('f')\n287\t// none of which is an operator, so `parse_operation` falls through to OP_ADD.\n288\t// `tree_sum % 4` is always in -3..=3, so the index stays inside this array.\n289\tstatic RODATA: [u8; 31] = *b\"root\\0left\\0right\\0left-left\\0+*-%\\0\";\n290\tconst OP_STRING_OFFSET: isize = 26; // index of \"+*-%\" within RODATA\n291\t\n292\t#[unsafe(no_mangle)]\n293\tpub extern \"C\" fn inreftree(param1: c_int, param2: c_int, param3: c_int, param4: c_int) -> c_int {\n294\t    unsafe {\n295\t        node_count = 0;\n296\t\n297\t        add_tree_node(1, param1, -1, b\"root\\0\".as_ptr() as *const c_char);\n298\t        add_tree_node(2, param2, 1, b\"left\\0\".as_ptr() as *const c_char);\n299\t        add_tree_node(3, param3, 1, b\"right\\0\".as_ptr() as *const c_char);\n300\t        add_tree_node(4, param4, 2, b\"left-left\\0\".as_ptr() as *const c_char);\n301\t\n302\t        let mut target_id: c_int = -1;\n303\t        let base = table_ptr();\n304\t        let count = node_count;\n305\t        let mut i: c_int = 0;\n306\t        while i < count {\n307\t            let node = base.offset(i as isize);\n308\t            let label_ptr = (&raw const (*node).label) as *const c_char;\n309\t            if !c_strchr(label_ptr, b'l').is_null() {\n310\t                target_id = (*node).id;\n311\t                break;\n312\t            }\n313\t            i += 1;\n314\t        }\n315\t\n316\t        let target = find_node_by_id(target_id);\n317\t        if target.is_null() || (*target).value == 0 {\n318\t            target_id = 1;\n319\t        }\n320\t\n321\t        let tree_sum = calculate_tree_sum(1);\n322\t\n323\t        let op_string = RODATA.as_ptr().offset(OP_STRING_OFFSET) as *const c_char;\n324\t        let op_char: [c_char; 2] = [\n325\t            *op_string.offset(tree_sum.wrapping_rem(4) as isize),\n326\t            0,\n327\t        ];\n328\t        let op = parse_operation(op_char.as_ptr());\n329\t\n330\t        let _op_value = op;\n331\t\n332\t        let func = get_operation_func(op);\n333\t\n334\t        let result = (func.unwrap())(tree_sum, target_id, 0, 0);\n335\t\n336\t        result\n337\t    }\n338\t}\n339\t"}]},"parent_tool_use_id":"toolu_bdrk_01T9s29LysRs58tbPT2gELyD","session_id":"e1c21d0a-4bcf-4f52-9a28-e367512a5538","uuid":"33e01d84-cb8d-40aa-b82d-1028fb2add6c","timestamp":"2026-08-19T21:22:15.092Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust semantics"}
