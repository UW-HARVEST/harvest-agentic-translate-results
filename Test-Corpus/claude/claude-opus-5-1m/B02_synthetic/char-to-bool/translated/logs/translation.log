, cond2: bool, cond3: bool, logic_op: i32) -> i32 {\n    match logic_op {\n        0 => {\n            /* AND - all must be true */\n            let result = cond1 && cond2 && cond3;\n\n            if result {\n                100\n            } else {\n                /* Partial matches */\n                if cond1 && cond2 {\n                    return 50;\n                }\n                if cond1 && cond3 {\n                    return 51;\n                }\n                if cond2 && cond3 {\n                    return 52;\n                }\n                if cond1 {\n                    return 10;\n                }\n                if cond2 {\n                    return 11;\n                }\n                if cond3 {\n                    return 12;\n                }\n                0\n            }\n        }\n\n        1 => {\n            /* OR - at least one must be true */\n            let result = cond1 || cond2 || cond3;\n\n            if result {\n                /* Count how many are true */\n                let mut count: i32 = 0;\n                if cond1 {\n                    count += 1;\n                }\n                if cond2 {\n                    count += 1;\n                }\n                if cond3 {\n                    count += 1;\n                }\n                return 100 + count;\n            }\n            0\n        }\n\n        2 => {\n            /* XOR - odd number must be true */\n            let result = cond1 ^ cond2 ^ cond3;\n\n            if result {\n                /* Determine which combination */\n                if cond1 && !cond2 && !cond3 {\n                    return 1;\n                }\n                if !cond1 && cond2 && !cond3 {\n                    return 2;\n                }\n                if !cond1 && !cond2 && cond3 {\n                    return 3;\n                }\n                if cond1 && cond2 && cond3 {\n                    return 7;\n                }\n                return 90