     -9,\n        -10,\n        99,\n        100,\n        999_999_999,\n        1_000_000_000,\n        -999_999_999,\n        -1_000_000_000,\n    ];\n    for &a in &vals {\n        for &b in &vals {\n            compare(a, b, 0, -1);\n            compare(0, -1, a, b);\n        }\n    }\n\n    // decimal-width sweep in every position\n    let mut p: i64 = 1;\n    while p <= 1_000_000_000 {\n        for &sign in &[1i64, -1] {\n            let v = (sign * p) as i32;\n            compare(v, v, v, v);\n            compare(v, 1, -2, 3);\n            compare(1, v, -2, 3);\n            compare(1, -2, v, 3);\n            compare(1, -2, 3, v);\n        }\n        p *= 10;\n    }\n\n    // randomized full-range fuzz\n    let mut rng = Rng::new(SEED ^ 40);\n    for _ in 0..20_000 {\n        compare(\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n        );\n    }\n    for _ in 0..5_000 {\n        compare(\n            rng.next_i32_interesting(),\n            rng.next_i32_interesting(),\n            rng.next_i32_interesting(),\n            rng.next_i32_interesting(),\n        );\n    }\n}\nEOF\ncargo build --offline --no-default-features --features internal_test_api 2>&1 | tail -2 && timeout 600 cargo test --offline --no-default-features --features internal_test_api --test internals 2>&1 | grep -E 'test result:|FAILED|panicked|C   =|Rust=' | head","description":"Add snprintf formatting differential test and run","timeout":600000}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":738,"cache_read_input_tokens":125207,"cache_creation":{"ephemeral_5m_input_tokens":738,"ephemeral_1h_input_tokens":0},"output_tokens":21,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6679050f-fe9a-4a2d-a894-fc694f76821d","uuid":"6af69df3-91ad-403c-9f59-13a673c0464a","timestamp":"2026-08-19T22:08:21.647Z"}
