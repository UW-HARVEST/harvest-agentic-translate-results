{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011HiCbe2ywCg87DsQDDhM6s","type":"tool_result","content":"1\t// Rust translation of c_src/src/lib.c\n2\t//\n3\t// Copyright 2025 MIT Lincoln Laboratory\n4\t// Permission is hereby granted, free of charge,\n5\t// to any person obtaining a copy of this software\n6\t// and associated documentation files (the \"Software\"),\n7\t// to deal in the Software without restriction,\n8\t// including without limitation the rights to use, copy,\n9\t// modify, merge, publish, distribute, sublicense,\n10\t// and/or sell copies of the Software,\n11\t// and to permit persons to whom the Software is furnished to do so,\n12\t// subject to the following conditions:\n13\t//\n14\t// The above copyright notice and this permission notice\n15\t// shall be included in all copies or substantial portions of the Software.\n16\t//\n17\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n18\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n19\t// THE WARRANTIES OF MERCHANTABILITY,\n20\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n21\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n22\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n23\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n24\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n25\t\n26\tuse std::ffi::c_int;\n27\t\n28\t/// static int memchra(const char *str, int c, size_t n)\n29\t///\n30\t/// Counts the bytes in `str[0..n]` that equal `(char)c`.\n31\tfn memchra(str_: &[u8], c: c_int, n: usize) -> c_int {\n32\t    let mut count: c_int = 0;\n33\t    // `(char)c` -- narrowing conversion of the int argument to a char.\n34\t    let needle = (c as u32 & 0xFF) as u8;\n35\t    let mut i: usize = 0;\n36\t    while i < n {\n37\t        if str_[i] == needle {\n38\t            count = count.wrapping_add(1);\n39\t        }\n40\t        i += 1;\n41\t    }\n42\t    count\n43\t}\n44\t\n45\t/// static int process_buffer(char *buffer, size_t len)\n46\t///\n47\t/// `buffer` is never NULL in the Rust translation (it is always a real slice),\n48\t/// so only the empty-string check remains observable.\n49\tfn process_buffer(buffer: &[u8], len: usize) -> c_int {\n50\t    if buffer.is_empty() || buffer[0] == b'\\0' {\n51\t        return -1;\n52\t    }\n53\t\n54\t    let mut result: c_int = 0;\n55\t    let mut i: usize = 0;\n56\t    while i < len && buffer[i] != b'\\0' {\n57\t        // `char` is signed on the reference platform (x86-64 Linux), so the\n58\t        // byte is sign-extended when converted to int.\n59\t        result = result.wrapping_add(buffer[i] as i8 as c_int);\n60\t        i += 1;\n61\t    }\n62\t    result\n63\t}\n64\t\n65\t/// static float int_to_float_bits(int value)\n66\t///\n67\t/// Type-punning union: reinterpret the object representation of the int as a\n68\t/// float.\n69\tfn int_to_float_bits(value: c_int) -> f32 {\n70\t    f32::from_bits(value as u32)\n71\t}\n72\t\n73\t/// static int process_strings(char **strings, int count, const char *target)\n74\t///\n75\t/// Counts how many of the `count` strings start with `target`.\n76\tfn process_strings(strings: &[&[u8]], count: c_int, target: &[u8]) -> c_int {\n77\t    if count <= 0 {\n78\t        return 0;\n79\t    }\n80\t\n81\t    let mut matches: c_int = 0;\n82\t\n83\t    for i in 0..(count as usize) {\n84\t        let s = strings[i];\n85\t\n86\t        // `*i == NULL || **i == '\\0'`\n87\t        if s.is_empty() || s[0] == b'\\0' {\n88\t            continue;\n89\t        }\n90\t\n91\t        // strncmp(*i, target, strlen(target)) == 0\n92\t        if strncmp_prefix(s, target) {\n93\t            matches = matches.wrapping_add(1);\n94\t        }\n95\t    }\n96\t\n97\t    matches\n98\t}\n99\t\n100\t/// Emulates `strncmp(a, target, strlen(target)) == 0`, i.e. \"does `a` begin\n101\t/// with `target`\" for NUL-terminated C strings.\n102\tfn strncmp_prefix(a: &[u8], target: &[u8]) -> bool {\n103\t    let n = cstr_len(target);\n104\t    let ta = &target[..n];\n105\t    let alen = cstr_len(a);\n106\t    if alen < n {\n107\t        return false;\n108\t    }\n109\t    &a[..n] == ta\n110\t}\n111\t\n112\t/// strlen() over a byte slice that is expected to be NUL-terminated (or to be\n113\t/// entirely payload).\n114\tfn cstr_len(s: &[u8]) -> usize {\n115\t    match s.iter().position(|&b| b == b'\\0') {\n116\t        Some(p) => p,\n117\t        None => s.len(),\n118\t    }\n119\t}\n120\t\n121\t/// static int safe_sum_array(int *arr, size_t size)\n122\tfn safe_sum_array(arr: &[c_int], size: usize) -> c_int {\n123\t    if size == 0 {\n124\t        return 0;\n125\t    }\n126\t\n127\t    let mut sum: c_int = 0;\n128\t    for i in 0..size {\n129\t        sum = sum.wrapping_add(arr[i]);\n130\t    }\n131\t    sum\n132\t}\n133\t\n134\t/// static int interpret_as_int(unsigned char *bytes, size_t len)\n135\t///\n136\t/// Reinterprets the first `sizeof(int)` bytes as an int (little endian on the\n137\t/// reference platform).\n138\tfn interpret_as_int(bytes: &[u8], len: usize) -> c_int {\n139\t    if len < core::mem::size_of::<c_int>() {\n140\t        return 0;\n141\t    }\n142\t\n143\t    let mut raw = [0u8; 4];\n144\t    raw.copy_from_slice(&bytes[..4]);\n145\t    c_int::from_le_bytes(raw)\n146\t}\n147\t\n148\t/// static int count_occurrences(const char *text, char ch)\n149\tfn count_occurrences(text: &[u8], ch: u8) -> c_int {\n150\t    if text.is_empty() || text[0] == b'\\0' {\n151\t        return 0;\n152\t    }\n153\t\n154\t    let len = cstr_len(text);\n155\t    memchra(text, ch as i8 as c_int, len)\n156\t}\n157\t\n158\t/// static int complex_iteration(int *data, size_t count)\n159\tfn complex_iteration(data: &[c_int], count: usize) -> c_int {\n160\t    if count == 0 {\n161\t        return -1;\n162\t    }\n163\t\n164\t    let mut result: c_int = 0;\n165\t\n166\t    for i in 0..count {\n167\t        let u = data[i] as u32;\n168\t        result ^= (u & 0xFF) as c_int;\n169\t    }\n170\t\n171\t    result\n172\t}\n173\t\n174\t/// int memchra2(int a, int b, int c, int d)\n175\t#[unsafe(no_mangle)]\n176\tpub extern \"C\" fn memchra2(a: c_int, b: c_int, c: c_int, d: c_int) -> c_int {\n177\t    let mut result: c_int = 0;\n178\t\n179\t    // char buffer[64];\n180\t    // snprintf(buffer, sizeof(buffer), \"test%d-%d-%d-%d\", a, b, c, d);\n181\t    let mut buffer = [0u8; 64];\n182\t    snprintf_buffer(&mut buffer, a, b, c, d);\n183\t\n184\t    let dash_count = count_occurrences(&buffer, b'-');\n185\t    result = result.wrapping_add(dash_count.wrapping_mul(10));\n186\t\n187\t    let values: [c_int; 4] = [a, b, c, d];\n188\t    let sum = safe_sum_array(&values, 4);\n189\t    result = result.wrapping_add(sum);\n190\t\n191\t    let test_strings: [&[u8]; 4] = [b\"test1\\0\", b\"test2\\0\", b\"testing\\0\", b\"other\\0\"];\n192\t\n193\t    let matches = process_strings(&test_strings, 4, b\"test\\0\");\n194\t    result = result.wrapping_add(matches.wrapping_mul(5));\n195\t\n196\t    let f = int_to_float_bits(a);\n197\t    if f > 0.0f32 && f < 1000.0f32 {\n198\t        result = result.wrapping_add(f as c_int);\n199\t    }\n200\t\n201\t    let buf_len = cstr_len(&buffer);\n202\t    let buf_sum = process_buffer(&buffer, buf_len);\n203\t    if buf_sum > 0 {\n204\t        result = result.wrapping_add(buf_sum % 256);\n205\t    }\n206\t\n207\t    // unsigned char bytes[4];\n208\t    let mut bytes = [0u8; 4];\n209\t    bytes[0] = (b as u32 & 0xFF) as u8;\n210\t    bytes[1] = (c as u32 & 0xFF) as u8;\n211\t    bytes[2] = (d as u32 & 0xFF) as u8;\n212\t    bytes[3] = 0;\n213\t\n214\t    let interpreted = interpret_as_int(&bytes, 4);\n215\t    result ^= interpreted;\n216\t\n217\t    let complex_result = complex_iteration(&values, 4);\n218\t    result = result.wrapping_add(complex_result);\n219\t\n220\t    result\n221\t}\n222\t\n223\t/// Reproduces `snprintf(buffer, sizeof(buffer), \"test%d-%d-%d-%d\", a, b, c, d)`\n224\t/// including truncation behaviour and NUL termination.\n225\tfn snprintf_buffer(buffer: &mut [u8; 64], a: c_int, b: c_int, c: c_int, d: c_int) {\n226\t    let mut out: Vec<u8> = Vec::with_capacity(64);\n227\t    out.extend_from_slice(b\"test\");\n228\t    fmt_int(&mut out, a);\n229\t    out.push(b'-');\n230\t    fmt_int(&mut out, b);\n231\t    out.push(b'-');\n232\t    fmt_int(&mut out, c);\n233\t    out.push(b'-');\n234\t    fmt_int(&mut out, d);\n235\t\n236\t    // snprintf writes at most sizeof(buffer) - 1 characters plus a NUL.\n237\t    let cap = buffer.len() - 1;\n238\t    let n = if out.len() < cap { out.len() } else { cap };\n239\t    buffer[..n].copy_from_slice(&out[..n]);\n240\t    buffer[n] = 0;\n241\t    for slot in buffer[n + 1..].iter_mut() {\n242\t        *slot = 0;\n243\t    }\n244\t}\n245\t\n246\t/// Formats a C `int` exactly like the `%d` conversion specifier.\n247\tfn fmt_int(out: &mut Vec<u8>, value: c_int) {\n248\t    let mut tmp = [0u8; 11];\n249\t    let negative = value < 0;\n250\t    // Use the unsigned magnitude so that INT_MIN is handled correctly.\n251\t    let mut mag: u32 = if negative {\n252\t        (value as i64).unsigned_abs() as u32\n253\t    } else {\n254\t        value as u32\n255\t    };\n256\t\n257\t    let mut idx = tmp.len();\n258\t    if mag == 0 {\n259\t        idx -= 1;\n260\t        tmp[idx] = b'0';\n261\t    } else {\n262\t        while mag > 0 {\n263\t            idx -= 1;\n264\t            tmp[idx] = b'0' + (mag % 10) as u8;\n265\t            mag /= 10;\n266\t        }\n267\t    }\n268\t\n269\t    if negative {\n270\t        out.push(b'-');\n271\t    }\n272\t    out.extend_from_slice(&tmp[idx..]);\n273\t}\n274\t"}]},"parent_tool_use_id":null,"session_id":"6679050f-fe9a-4a2d-a894-fc694f76821d","uuid":"ffd40116-00a5-4829-b22b-634cf83ce8e6","timestamp":"2026-08-19T21:51:31.367Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-9oWcC6/translated_rust/src/lib.rs","content":"// Ru