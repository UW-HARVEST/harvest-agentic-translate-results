{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BVjNWa29pZ7RnvABHR8yFc","type":"tool_result","content":"1\t// Rust translation of c_src/src/lib.c\n2\t//\n3\t// Original C source:\n4\t// Copyright 2025 MIT Lincoln Laboratory\n5\t// Permission is hereby granted, free of charge,\n6\t// to any person obtaining a copy of this software\n7\t// and associated documentation files (the \"Software\"),\n8\t// to deal in the Software without restriction,\n9\t// including without limitation the rights to use, copy,\n10\t// modify, merge, publish, distribute, sublicense,\n11\t// and/or sell copies of the Software,\n12\t// and to permit persons to whom the Software is furnished to do so,\n13\t// subject to the following conditions:\n14\t//\n15\t// The above copyright notice and this permission notice\n16\t// shall be included in all copies or substantial portions of the Software.\n17\t//\n18\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n19\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n20\t// THE WARRANTIES OF MERCHANTABILITY,\n21\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n22\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n23\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n24\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n25\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n26\t\n27\tuse std::ffi::{c_char, c_int, c_uint};\n28\tuse std::sync::atomic::{AtomicI32, Ordering};\n29\t\n30\t// ---------------------------------------------------------------------------\n31\t// Function pointer typedefs from the C source:\n32\t//   typedef int  (*operation_func)(int, int);\n33\t//   typedef void (*string_processor)(char*, int);\n34\t// ---------------------------------------------------------------------------\n35\ttype OperationFunc = unsafe extern \"C\" fn(c_int, c_int) -> c_int;\n36\t#[allow(dead_code)]\n37\ttype StringProcessor = unsafe extern \"C\" fn(*mut c_char, c_int);\n38\t\n39\t// ---------------------------------------------------------------------------\n40\t// File-scope (static) mutable state.\n41\t//   static int accumulator = 0;\n42\t//   static int multiplier = 1;\n43\t//   static int operation_count = 0;\n44\t// The C library keeps this state across calls; reproduce that behaviour.\n45\t// ---------------------------------------------------------------------------\n46\tstatic ACCUMULATOR: AtomicI32 = AtomicI32::new(0);\n47\tstatic MULTIPLIER: AtomicI32 = AtomicI32::new(1);\n48\tstatic OPERATION_COUNT: AtomicI32 = AtomicI32::new(0);\n49\t\n50\t#[inline]\n51\tfn acc_get() -> i32 {\n52\t    ACCUMULATOR.load(Ordering::Relaxed)\n53\t}\n54\t#[inline]\n55\tfn acc_set(v: i32) {\n56\t    ACCUMULATOR.store(v, Ordering::Relaxed);\n57\t}\n58\t#[inline]\n59\tfn mul_get() -> i32 {\n60\t    MULTIPLIER.load(Ordering::Relaxed)\n61\t}\n62\t#[inline]\n63\tfn mul_set(v: i32) {\n64\t    MULTIPLIER.store(v, Ordering::Relaxed);\n65\t}\n66\t#[inline]\n67\tfn opcount_get() -> i32 {\n68\t    OPERATION_COUNT.load(Ordering::Relaxed)\n69\t}\n70\t#[inline]\n71\tfn opcount_inc() {\n72\t    OPERATION_COUNT.store(opcount_get().wrapping_add(1), Ordering::Relaxed);\n73\t}\n74\t\n75\t// ---------------------------------------------------------------------------\n76\t// Raw byte access, matching what the C compiler emits.\n77\t//\n78\t// `read_volatile` / `write_volatile` are used instead of a plain dereference so\n79\t// that an invalid (e.g. NULL) pointer coming from the caller faults exactly\n80\t// like it does in C (SIGSEGV) instead of tripping a Rust debug assertion and\n81\t// aborting.  The C library performs no pointer validation at all\n82\t// (`strlen(NULL)`, `strcpy(NULL, …)` simply fault), so neither may this one.\n83\t// ---------------------------------------------------------------------------\n84\t\n85\t#[inline(always)]\n86\tunsafe fn load_u8(p: *const c_char) -> u8 {\n87\t    std::ptr::read_volatile(p as *const u8)\n88\t}\n89\t\n90\t#[inline(always)]\n91\tunsafe fn store_u8(p: *mut c_char, v: u8) {\n92\t    std::ptr::write_volatile(p as *mut u8, v);\n93\t}\n94\t\n95\t/// C's signed `int` division (`/`), including its behaviour on overflow.\n96\t///\n97\t/// `INT_MIN / -1` is undefined in C; on x86-64 the `idiv` instruction the C\n98\t/// compiler emits raises #DE, i.e. the process dies with SIGFPE.  Rust's `/`\n99\t/// would panic and `wrapping_div` would quietly return `INT_MIN`, so the raw\n100\t/// instruction is used to keep the observable behaviour identical.  The caller\n101\t/// guarantees `b != 0` (`if (b != 0)` in the C source).\n102\t#[inline(always)]\n103\tunsafe fn c_int_div(a: c_int, b: c_int) -> c_int {\n104\t    #[cfg(target_arch = \"x86_64\")]\n105\t    {\n106\t        let mut quotient: c_int = a;\n107\t        std::arch::asm!(\n108\t            \"cdq\",\n109\t            \"idiv {divisor:e}\",\n110\t            divisor = in(reg) b,\n111\t            inout(\"eax\") quotient,\n112\t            out(\"edx\") _,\n113\t            options(nostack),\n114\t        );\n115\t        quotient\n116\t    }\n117\t    #[cfg(not(target_arch = \"x86_64\"))]\n118\t    {\n119\t        // Other targets (e.g. aarch64 `sdiv`) do not trap; they produce the\n120\t        // wrapped result, which is what `wrapping_div` computes.\n121\t        a.wrapping_div(b)\n122\t    }\n123\t}\n124\t\n125\t// ---------------------------------------------------------------------------\n126\t// Minimal C string helpers (strlen / memchr / strcpy semantics).\n127\t// ---------------------------------------------------------------------------\n128\t\n129\t/// Equivalent of `strlen(s)`.\n130\tunsafe fn c_strlen(s: *const c_char) -> usize {\n131\t    let mut n: usize = 0;\n132\t    while load_u8(s.add(n)) != 0 {\n133\t        n += 1;\n134\t    }\n135\t    n\n136\t}\n137\t\n138\t/// Equivalent of `memchr(s, ch, n)`; `ch` is converted to `unsigned char`\n139\t/// exactly like the C library does.\n140\tunsafe fn c_memchr(s: *const c_char, ch: c_int, n: usize) -> *mut c_char {\n141\t    let needle = ch as u8;\n142\t    let mut i: usize = 0;\n143\t    while i < n {\n144\t        if load_u8(s.add(i)) == needle {\n145\t            return s.add(i) as *mut c_char;\n146\t        }\n147\t        i += 1;\n148\t    }\n149\t    std::ptr::null_mut()\n150\t}\n151\t\n152\t/// Equivalent of `strcpy(dest, src_bytes)` where `src_bytes` does not contain\n153\t/// a NUL: copies the bytes then the terminating NUL.\n154\tunsafe fn c_strcpy_from_slice(dest: *mut c_char, src: &[u8]) {\n155\t    let mut i: usize = 0;\n156\t    while i < src.len() {\n157\t        store_u8(dest.add(i), src[i]);\n158\t        i += 1;\n159\t    }\n160\t    store_u8(dest.add(src.len()), 0);\n161\t}\n162\t\n163\t/// Equivalent of `strcpy(dest, src)` for two C strings.\n164\tunsafe fn c_strcpy(dest: *mut c_char, src: *const c_char) -> *mut c_char {\n165\t    let mut i: usize = 0;\n166\t    loop {\n167\t        let b = load_u8(src.add(i));\n168\t        store_u8(dest.add(i), b);\n169\t        if b == 0 {\n170\t            break;\n171\t        }\n172\t        i += 1;\n173\t    }\n174\t    dest\n175\t}\n176\t\n177\t/// Renders `sprintf(buffer, \"Octal: 0%o, Decimal: %d\", v, v)` into bytes.\n178\t/// `%o` formats the value as `unsigned int`, `%d` as signed `int`.\n179\tfn format_octal_message(octal_val: c_int) -> Vec<u8> {\n180\t    let unsigned = octal_val as c_uint;\n181\t    format!(\"Octal: 0{:o}, Decimal: {}\", unsigned, octal_val).into_bytes()\n182\t}\n183\t\n184\t// ---------------------------------------------------------------------------\n185\t// Public ABI\n186\t// ---------------------------------------------------------------------------\n187\t\n188\t#[unsafe(no_mangle)]\n189\tpub unsafe extern \"C\" fn add_to_accumulator(a: c_int, b: c_int) -> c_int {\n190\t    acc_set(acc_get().wrapping_add(a.wrapping_add(b)));\n191\t    opcount_inc();\n192\t    acc_get()\n193\t}\n194\t\n195\t#[unsafe(no_mangle)]\n196\tpub unsafe extern \"C\" fn multiply_with_multiplier(a: c_int, b: c_int) -> c_int {\n197\t    mul_set(mul_get().wrapping_mul(a.wrapping_mul(b)));\n198\t    opcount_inc();\n199\t    mul_get()\n200\t}\n201\t\n202\t#[unsafe(no_mangle)]\n203\tpub unsafe extern \"C\" fn subtract_from_accumulator(a: c_int, b: c_int) -> c_int {\n204\t    acc_set(acc_get().wrapping_sub(a.wrapping_sub(b)));\n205\t    opcount_inc();\n206\t    acc_get()\n207\t}\n208\t\n209\t#[unsafe(no_mangle)]\n210\tpub unsafe extern \"C\" fn divide_multiplier(_a: c_int, b: c_int) -> c_int {\n211\t    if b != 0 {\n212\t        mul_set(c_int_div(mul_get(), b));\n213\t    }\n214\t    opcount_inc();\n215\t    mul_get()\n216\t}\n217\t\n218\t#[unsafe(no_mangle)]\n219\tpub unsafe extern \"C\" fn process_octal_string(dest: *mut c_char, octal_val: c_int) {\n220\t    // char buffer[50]; sprintf(buffer, \"Octal: 0%o, Decimal: %d\", v, v);\n221\t    // strcpy(dest, buffer);\n222\t    let rendered = format_octal_message(octal_val);\n223\t    let mut buffer = [0u8; 50];\n224\t    let n = if rendered.len() < buffer.len() {\n225\t        rendered.len()\n226\t    } else {\n227\t        buffer.len() - 1\n228\t    };\n229\t    buffer[..n].copy_from_slice(&rendered[..n]);\n230\t    c_strcpy_from_slice(dest, &buffer[..n]);\n231\t}\n232\t\n233\t#[unsafe(no_mangle)]\n234\tpub unsafe extern \"C\" fn find_and_replace_char(str_: *mut c_char, search_char: c_int) {\n235\t    let found = c_memchr(str_, search_char, c_strlen(str_));\n236\t    if !found.is_null() {\n237\t        store_u8(found, b'X');\n238\t    }\n239\t}\n240\t\n241\t#[unsafe(no_mangle)]\n242\tpub unsafe extern \"C\" fn validate_and_normalize(value: c_int) -> c_int {\n243\t    let is_nonzero: c_int = (value != 0) as c_int;\n244\t    let _is_zero: c_int = (value == 0) as c_int;\n245\t\n246\t    let lower_threshold: c_int = 0o100; // 64\n247\t    let upper_threshold: c_int = 0o777; // 511\n248\t\n249\t    if is_nonzero != 0 && value > 0 {\n250\t     