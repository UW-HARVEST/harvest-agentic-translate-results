     result = result.wrapping_add((found_char as isize - search_ptr as isize) as c_int);\n307\t    }\n308\t\n309\t    let mut selected_op: OperationFunc;\n310\t\n311\t    if active_params >= mode_add {\n312\t        selected_op = OPERATIONS[0];\n313\t        result = result.wrapping_add(selected_op(normalized_p1, normalized_p2));\n314\t    }\n315\t\n316\t    if active_params >= mode_multiply {\n317\t        selected_op = OPERATIONS[1];\n318\t        result = result.wrapping_add(selected_op(normalized_p3, normalized_p4));\n319\t    }\n320\t\n321\t    if acc_get() > 0o150 {\n322\t        selected_op = OPERATIONS[2];\n323\t        let subtract_result = selected_op(normalized_p1, normalized_p3);\n324\t        result = result.wrapping_add(subtract_result);\n325\t    }\n326\t\n327\t    find_and_replace_char(message.as_mut_ptr() as *mut c_char, b'O' as c_int);\n328\t\n329\t    let mut final_message = [0u8; 100];\n330\t    c_strcpy(\n331\t        final_message.as_mut_ptr() as *mut c_char,\n332\t        message.as_ptr() as *const c_char,\n333\t    );\n334\t    // `final_message` is unused afterwards in the C source, but the copy is\n335\t    // performed for fidelity.\n336\t    let _ = &final_message;\n337\t\n338\t    let has_accumulator: c_int = (acc_get() != 0) as c_int;\n339\t    let has_multiplier: c_int = (mul_get() != 0) as c_int;\n340\t    let both_active: c_int = (has_accumulator != 0 && has_multiplier != 0) as c_int;\n341\t\n342\t    if both_active != 0 {\n343\t        result = result.wrapping_add(acc_get().wrapping_add(mul_get()));\n344\t    }\n345\t\n346\t    if mul_get() > 0o100 {\n347\t        selected_op = OPERATIONS[3];\n348\t        selected_op(mul_get(), 2);\n349\t    }\n350\t\n351\t    result = result.wrapping_add(opcount_get().wrapping_mul(0o10));\n352\t\n353\t    let result_exists: c_int = (result != 0) as c_int;\n354\t    if result_exists == 0 {\n355\t        result = 0o777;\n356\t    }\n357\t\n358\t    result\n359\t}\n360\t"}]},"parent_tool_use_id":"too