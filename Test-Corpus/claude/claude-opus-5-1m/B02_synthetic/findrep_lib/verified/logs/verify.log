from a smaller set, plus diagonal */\n  int S[]={0,1,64,511,-1,INT_MAX,INT_MIN,46341,2,65,105,-64};\n  int ns=sizeof(S)/sizeof(S[0]);\n  for(int i=0;i<n;i++){\n    one(V[i],0,0,0); one(0,V[i],0,0); one(0,0,V[i],0); one(0,0,0,V[i]);\n    one(V[i],V[i],V[i],V[i]);\n    for(int j=0;j<ns;j++){\n      one(V[i],S[j],0,0); one(0,0,V[i],S[j]); one(V[i],S[j],S[j],V[i]);\n      one(S[j],V[i],V[i],S[j]); one(V[i],V[i],S[j],S[j]);\n    }\n  }\n  /* randomized pristine cases */\n  unsigned long long s=0x243F6A8885A308D3ULL;\n  #define NX (s^=s<<13, s^=s>>7, s^=s<<17, (int)(unsigned)s)\n  for(int k=0;k<20000;k++){\n    int a=NX,b=NX,d=NX,e=NX;\n    switch((unsigned)NX%4){\n      case 0: a&=1023;b&=1023;d&=1023;e&=1023; break;\n      case 1: a%=600;b%=600;d%=600;e%=600; break;\n      default: break;\n    }\n    one(a,b,d,e);\n  }\n  printf(\"pristine findrep cases=%d fails=%d\\n\",cases,fails);\n  return fails?1:0;\n}\nEOF\ngcc -O1 -o forkrep forkrep.c -ldl && RS=/local/home/scheschb/.harvest/work/harvest-work-vu0rjt/translated_rust/target/release/libfindrep_lib.so && timeout 900 ./forkrep ./libc_O2.so $RS 2>&1 | tail -20; echo \"--- O0 vs debug ---\"; timeout 900 ./forkrep ./libc_O0.so /local/home/scheschb/.harvest/work/harvest-work-vu0rjt/translated_rust/target/debug/libfindrep_lib.so 2>&1 | tail -20","task_type":"local_bash","uuid":"4a1828d1-c12f-40cc-8e4a-51c6228d2347","session_id":"e32b10b8-2a5f-4856-b089-d80616d51352"}
