unt) < 9 {/|history capacity\"\n  \"s/raw_store(history_count, 0);/raw_store(history_count, 1);/|history_count reset value\"\n  \"s/raw_store(\\&raw mut (\\*entry).status, STATUS_SUCCESS);/raw_store(\\&raw mut (*entry).status, STATUS_WARNING);/|recorded status\"\n  \"s/allocate_results(10)/allocate_results(9)/|lazy allocation size\"\n  \"s/let selected_op: Operation = param3.wrapping_rem(5).wrapping_add(1);/let selected_op: Operation = param3.wrapping_rem(5).wrapping_abs().wrapping_add(1);/|mathop selected_op clamping\"\n  \"s/let second_op: Operation = param4.wrapping_add(1).wrapping_rem(5).wrapping_add(1);/let second_op: Operation = param4.wrapping_rem(5).wrapping_add(1);/|mathop second_op derivation\"\n  \"s/final_result = final_result.wrapping_add(operation_priority);/final_result = final_result.wrapping_sub(operation_priority);/|mathop priority sign\"\n  \"s/let time_modifier = (computation_time % 100) as c_int;/let time_modifier = (computation_time % 10) as c_int;/|mathop time modifier\"\n  \"s/b\\\"History entries: %d\\\\\\\\n\\\\\\\\0\\\"/b\\\"History entries:%d\\\\\\\\n\\\\\\\\0\\\"/|printf format text\"\n  \"s/    if b == 0 {\\$/    if b == 1 {/|div\\/mod zero guard\"\n  \"s/let condition = (op_char != 0) \\&\\& (op_char >= ONE \\&\\& op_char <= FIVE);/let condition = op_char >= ONE \\&\\& op_char <= FIVE;/|is_valid_operation null test (no-op mutation)\"\n)\n\nCAUGHT=0\nSURVIVED=0\nfor entry in \"${MUTATIONS[@]}\"; do\n  expr=\"${entry%%|*}\"\n  desc=\"${entry##*|}\"\n  restore\n  if ! sed -i \"$expr\" \"$SRC\"; then\n    echo \"SKIP  (sed failed)          : $desc\"\n    continue\n  fi\n  if cmp -s \"$SRC\" \"$BAK\"; then\n    echo \"SKIP  (pattern didn't match): $desc\"\n    continue\n  fi\n  if ! timeout 300 cargo build --offline >/dev/null 2>&1; then\n    echo \"SKIP  (mutant didn't compile): $desc\"\n    continue\n  fi\n  if timeout 600 cargo test --offline >/dev/null 2>&1; then\n    echo \"SURVIVED  <-- BLIND SPOT    : $desc\"\n    SURVIVED=$((SURVIVE