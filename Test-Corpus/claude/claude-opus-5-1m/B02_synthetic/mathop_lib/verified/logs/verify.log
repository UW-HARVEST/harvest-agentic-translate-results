\nunsafe fn raw_load<T: Copy>(src: *const T) -> T {\n    let mut out = core::mem::MaybeUninit::<T>::uninit();\n    let dst = out.as_mut_ptr() as *mut u8;\n    let src = src as *const u8;\n    let mut i = 0usize;\n    while i < size_of::<T>() {\n        ptr::write_volatile(dst.add(i), ptr::read_volatile(src.wrapping_add(i)));\n        i += 1;\n    }\n    out.assume_init()\n}\n\n/// `*dst = val` — store `T` through a caller-supplied pointer without any\n/// inserted check.\n#[inline(always)]\nunsafe fn raw_store<T: Copy>(dst: *mut T, val: T) {\n    let src = &val as *const T as *const u8;\n    let dst = dst as *mut u8;\n    let mut i = 0usize;\n    while i < size_of::<T>() {\n        ptr::write_volatile(dst.wrapping_add(i), ptr::read_volatile(src.add(i)));\n        i += 1;\n    }\n}\n\n/// `&(*history)[index]` — C's array subscript is wrapping pointer arithmetic and\n/// is *not* bounds checked, so neither is this (the C code reaches here with\n/// `index` in `..10`, which includes negative values).\n#[inline(always)]\nfn slot(base: *mut ComputationResult, index: c_int) -> *mut ComputationResult {\n    base.wrapping_offset(index as isize)\n}\n\n// ---------------------------------------------------------------------------\n// int perform_computation_with_history(int a, int b, Operation op,\n//                                      ComputationResult** history,\n//                                      int* history_count)\n// ---------------------------------------------------------------------------"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5836,"cache_read_input_tokens":111862,"cache_creation":{"ephemeral_5m_input_tokens":5836,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9008289a-d643-4384-a252-4ad65f65b4dc","uuid":"8ddfc5fd-4b3c-404e-8f09-d6cdc729702a","timestamp":"2026-08-19T21:29:44.331Z"}
