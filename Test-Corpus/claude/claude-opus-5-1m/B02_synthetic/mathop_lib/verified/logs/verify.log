\n        perform_computation_with_history(\n            intermediate_result,\n            param4,\n            second_op,\n            computation_history,\n            history_count,\n        )\n    };\n\n    // final_result += operation_priority;\n    final_result = final_result.wrapping_add(operation_priority);\n\n    // time_t computation_time = get_computation_timestamp();\n    let computation_time = get_computation_timestamp();\n\n    // int time_modifier = (int)(computation_time % 100);\n    let time_modifier = (computation_time % 100) as c_int;\n\n    // final_result += time_modifier;\n    final_result = final_result.wrapping_add(time_modifier);\n\n    unsafe {\n        printf(\n            b\"Computation performed at timestamp: %ld\\n\\0\".as_ptr() as *const c_char,\n            computation_time as c_long,\n        );\n        printf(\n            b\"Operation priority: %d\\n\\0\".as_ptr() as *const c_char,\n            operation_priority,\n        );\n        printf(\n            b\"History entries: %d\\n\\0\".as_ptr() as *const c_char,\n            *history_count,\n        );\n        printf(\n            b\"Final result: %d\\n\\0\".as_ptr() as *const c_char,\n            final_result,\n        );\n    }\n\n    final_result\n}\n","structuredPatch":[{"oldStart":293,"oldLines":6,"newStart":293,"newLines":60,"lines":[" }"," "," // ---------------------------------------------------------------------------","+// Raw memory access helpers.","+//","+// `perform_computation_with_history` is the only function that dereferences","+// pointers supplied by the caller, and the C code validates none of them: a","+// NULL `history`/`history_count` simply faults (SIGSEGV), a misaligned","+// `*history` is handled by the hardware, and `(*history)[*history_count]`","+// performs plain wrapping address arithmetic for any index.","+//","+// A plain `*ptr` deref in Rust carries compiler-inserted UB checks in debug","+// builds, which turn those faults into `abort()` (SIGABR