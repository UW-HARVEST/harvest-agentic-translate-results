{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CcyE37rpVmHkqKzmqJyVLB","type":"tool_result","content":"1\t// Rust translation of c_src/src/lib.c\n2\t//\n3\t// Copyright 2025 MIT Lincoln Laboratory\n4\t// Permission is hereby granted, free of charge,\n5\t// to any person obtaining a copy of this software\n6\t// and associated documentation files (the \"Software\"),\n7\t// to deal in the Software without restriction,\n8\t// including without limitation the rights to use, copy,\n9\t// modify, merge, publish, distribute, sublicense,\n10\t// and/or sell copies of the Software,\n11\t// and to permit persons to whom the Software is furnished to do so,\n12\t// subject to the following conditions:\n13\t//\n14\t// The above copyright notice and this permission notice\n15\t// shall be included in all copies or substantial portions of the Software.\n16\t//\n17\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n18\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n19\t// THE WARRANTIES OF MERCHANTABILITY,\n20\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n21\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n22\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n23\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n24\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n25\t\n26\t#![allow(non_camel_case_types)]\n27\t#![allow(non_upper_case_globals)]\n28\t\n29\tuse core::ffi::{c_char, c_int, c_long, c_void};\n30\tuse core::mem::size_of;\n31\tuse core::ptr;\n32\t\n33\t// ---------------------------------------------------------------------------\n34\t// libc bindings\n35\t//\n36\t// The C translation unit uses `time()`, `calloc()` and `printf()` from libc.\n37\t// They are declared (rather than re-implemented) so that behaviour -- in\n38\t// particular stdout buffering semantics and heap ownership (callers may\n39\t// `free()` the block returned by `allocate_results`) -- is bit-for-bit the\n40\t// same as the C library's.\n41\t// ---------------------------------------------------------------------------\n42\t\n43\textern \"C\" {\n44\t    fn time(tloc: *mut time_t) -> time_t;\n45\t    fn calloc(nmemb: usize, size: usize) -> *mut c_void;\n46\t    fn printf(format: *const c_char, ...) -> c_int;\n47\t}\n48\t\n49\t/// `time_t` on the target ABI (x86-64 / aarch64 Linux: 64-bit signed).\n50\tpub type time_t = i64;\n51\t\n52\t// ---------------------------------------------------------------------------\n53\t// typedef enum { OP_ADD = 1, ... } Operation;\n54\t// ---------------------------------------------------------------------------\n55\t\n56\t/// `Operation` is an `int`-sized C enum, so it is modelled as `c_int`.\n57\tpub type Operation = c_int;\n58\t\n59\tpub const OP_ADD: Operation = 1;\n60\tpub const OP_MULTIPLY: Operation = 2;\n61\tpub const OP_SUBTRACT: Operation = 3;\n62\tpub const OP_DIVIDE: Operation = 4;\n63\tpub const OP_MODULO: Operation = 5;\n64\t\n65\t// ---------------------------------------------------------------------------\n66\t// typedef enum { STATUS_SUCCESS = 0, STATUS_ERROR = -1, STATUS_WARNING = 1 }\n67\t//     StatusCode;\n68\t// ---------------------------------------------------------------------------\n69\t\n70\t/// `StatusCode` is an `int`-sized C enum (it has a negative enumerator), so it\n71\t/// is modelled as `c_int`.\n72\tpub type StatusCode = c_int;\n73\t\n74\tpub const STATUS_SUCCESS: StatusCode = 0;\n75\tpub const STATUS_ERROR: StatusCode = -1;\n76\tpub const STATUS_WARNING: StatusCode = 1;\n77\t\n78\t// ---------------------------------------------------------------------------\n79\t// typedef struct { int value; time_t timestamp; StatusCode status; }\n80\t//     ComputationResult;\n81\t//\n82\t// Layout on the reference ABI: size 24, align 8,\n83\t// offsets value = 0, timestamp = 8, status = 16.\n84\t// ---------------------------------------------------------------------------\n85\t\n86\t#[repr(C)]\n87\t#[derive(Copy, Clone)]\n88\tpub struct ComputationResult {\n89\t    pub value: c_int,\n90\t    pub timestamp: time_t,\n91\t    pub status: StatusCode,\n92\t}\n93\t\n94\t// ---------------------------------------------------------------------------\n95\t// typedef int (*MathOperation)(int, int, int);\n96\t// ---------------------------------------------------------------------------\n97\t\n98\tpub type MathOperation = extern \"C\" fn(c_int, c_int, c_int) -> c_int;\n99\t\n100\t// ---------------------------------------------------------------------------\n101\t// bool is_valid_operation(char op_char)\n102\t// ---------------------------------------------------------------------------\n103\t\n104\t/// ```c\n105\t/// bool is_valid_operation(char op_char) {\n106\t///     char valid = op_char && (op_char >= '1' && op_char <= '5');\n107\t///     return valid;\n108\t/// }\n109\t/// ```\n110\t///\n111\t/// `char` is signed on the reference ABI, hence `c_char`. The intermediate\n112\t/// `char valid` only ever holds 0 or 1, and the `_Bool` conversion is\n113\t/// `valid != 0`; both steps are reproduced literally.\n114\t#[unsafe(no_mangle)]\n115\tpub extern \"C\" fn is_valid_operation(op_char: c_char) -> bool {\n116\t    const ONE: c_char = b'1' as c_char;\n117\t    const FIVE: c_char = b'5' as c_char;\n118\t\n119\t    let condition = (op_char != 0) && (op_char >= ONE && op_char <= FIVE);\n120\t    let valid: c_char = if condition { 1 } else { 0 };\n121\t    valid != 0\n122\t}\n123\t\n124\t// ---------------------------------------------------------------------------\n125\t// int get_operation_priority(Operation op)\n126\t// ---------------------------------------------------------------------------\n127\t\n128\t/// ```c\n129\t/// int get_operation_priority(Operation op) {\n130\t///     int priority = op * 10;\n131\t///     return priority;\n132\t/// }\n133\t/// ```\n134\t///\n135\t/// `wrapping_mul` matches the two's-complement result GCC/Clang produce for\n136\t/// signed overflow; no bug is \"fixed\" here.\n137\t#[unsafe(no_mangle)]\n138\tpub extern \"C\" fn get_operation_priority(op: Operation) -> c_int {\n139\t    let priority = op.wrapping_mul(10);\n140\t    priority\n141\t}\n142\t\n143\t// ---------------------------------------------------------------------------\n144\t// The five MathOperation implementations.\n145\t//\n146\t// `unused_param` is present in the C signature and deliberately ignored, so\n147\t// the ABI is preserved exactly.\n148\t// ---------------------------------------------------------------------------\n149\t\n150\t/// `int add_operation(int a, int b, int unused_param) { return a + b; }`\n151\t#[unsafe(no_mangle)]\n152\tpub extern \"C\" fn add_operation(a: c_int, b: c_int, _unused_param: c_int) -> c_int {\n153\t    a.wrapping_add(b)\n154\t}\n155\t\n156\t/// `int multiply_operation(int a, int b, int unused_param) { return a * b; }`\n157\t#[unsafe(no_mangle)]\n158\tpub extern \"C\" fn multiply_operation(a: c_int, b: c_int, _unused_param: c_int) -> c_int {\n159\t    a.wrapping_mul(b)\n160\t}\n161\t\n162\t/// `int subtract_operation(int a, int b, int unused_param) { return a - b; }`\n163\t#[unsafe(no_mangle)]\n164\tpub extern \"C\" fn subtract_operation(a: c_int, b: c_int, _unused_param: c_int) -> c_int {\n165\t    a.wrapping_sub(b)\n166\t}\n167\t\n168\t/// ```c\n169\t/// int divide_operation(int a, int b, int unused_param) {\n170\t///     if (b == 0) {\n171\t///         return 0;\n172\t///     }\n173\t///     return a / b;\n174\t/// }\n175\t/// ```\n176\t///\n177\t/// The divide-by-zero guard is kept in exactly the same position, and\n178\t/// `wrapping_div` gives C's truncating-toward-zero quotient (e.g. `-7 / 2 ==\n179\t/// -3`).\n180\t///\n181\t/// One documented divergence: `divide_operation(INT_MIN, -1, _)`. That is\n182\t/// signed-overflow *undefined behaviour* in C -- the reference library executes\n183\t/// `idiv` and dies from SIGFPE, so it has no defined output to be identical to.\n184\t/// `wrapping_div` returns `INT_MIN` here instead of panicking or killing the\n185\t/// process. Every input with defined C behaviour matches bit-for-bit.\n186\t#[unsafe(no_mangle)]\n187\tpub extern \"C\" fn divide_operation(a: c_int, b: c_int, _unused_param: c_int) -> c_int {\n188\t    if b == 0 {\n189\t        return 0;\n190\t    }\n191\t    a.wrapping_div(b)\n192\t}\n193\t\n194\t/// ```c\n195\t/// int modulo_operation(int a, int b, int unused_param) {\n196\t///     if (b == 0) {\n197\t///         return 0;\n198\t///     }\n199\t///     return a % b;\n200\t/// }\n201\t/// ```\n202\t///\n203\t/// `wrapping_rem` reproduces C's truncating remainder, which keeps the sign of\n204\t/// the dividend (e.g. `-3 % 5 == -3`). As with `divide_operation`, the\n205\t/// `INT_MIN % -1` case is UB in C (SIGFPE on the reference build) and yields 0\n206\t/// here rather than aborting.\n207\t#[unsafe(no_mangle)]\n208\tpub extern \"C\" fn modulo_operation(a: c_int, b: c_int, _unused_param: c_int) -> c_int {\n209\t    if b == 0 {\n210\t        return 0;\n211\t    }\n212\t    a.wrapping_rem(b)\n213\t}\n214\t\n215\t// ---------------------------------------------------------------------------\n216\t// MathOperation select_operation(Operation op)\n217\t// ---------------------------------------------------------------------------\n218\t\n219\t/// ```c\n220\t/// MathOperation select_operation(Operation op) {\n221\t///     switch (op) {\n222\t///         case OP_ADD:      return add_operation;\n223\t///         case OP_MULTIPLY: return multiply_operation;\n224\t///         case OP_SUBTRACT: return subtract_operation;\n225\t///         case OP_DIVIDE:   return divide_operation;\n226\t///         case OP_MODULO:   return modulo_operation;\n227\t///         default:          return add_operation;\n228\t///     }\n229\t/// }\n230\t/// ```\n231\t///\n232\t/// The returned pointers are the addresses of the exported symbols, so callers\n233\t/// can compare them against `add_operation` &c. just as with the C library.\n234\t#[unsafe(no_mangle)]\n235\tpub extern \"C\" fn select_operation(op: Operation) -> MathOperation {\n236\t    match op {\n237\t        OP_ADD => add_operation,\n238\t        OP_MULTIPLY => multiply_operation,\n239\t        OP_SUBTRACT => subtract_operation,\n240\t        OP_DIVIDE => divide_operation,\n241\t        OP_MODULO => modulo_operation,\n242\t        _ => add_operation,\n243\t    }\n244\t}\n245\t\n246\t// ---------------------------------------------------------------------------\n247\t// time_t get_computation_timestamp(void)\n248\t// ---------------------------------------------------------------------------\n249\t\n250\t/// ```c\n251\t/// time_t get_computation_timestamp() {\n252\t///     time_t current_time;\n253\t///     time(&current_time);\n254\t///     current_time = current_time >> 29;\n255\t///     return current_time;\n256\t/// }\n257\t/// ```\n258\t///\n259\t/// The `time()` return value is discarded in the C source exactly as here; the\n260\t/// value comes from the out-parameter. `>>` on a signed `time_t` is an\n261\t/// arithmetic shift, which `i64 >> 29` also performs.\n262\t#[unsafe(no_mangle)]\n263\tpub extern \"C\" fn get_computation_timestamp() -> time_t {\n264\t    let mut current_time: time_t = 0;\n265\t    unsafe {\n266\t        time(&mut current_time);\n267\t    }\n268\t    current_time >>= 29;\n269\t    current_time\n270\t}\n271\t\n272\t// ---------------------------------------------------------------------------\n273\t// ComputationResult* allocate_results(int count)\n274\t// ---------------------------------------------------------------------------\n275\t\n276\t/// ```c\n277\t/// ComputationResult* allocate_results(int count) {\n278\t///     ComputationResult* results =\n279\t///         (ComputationResult*)calloc(count, sizeof(ComputationResult));\n280\t///     return results;\n281\t/// }\n282\t/// ```\n283\t///\n284\t/// `calloc` from libc is used so the block remains `free()`-able by callers.\n285\t/// `count as usize` sign-extends negative counts precisely like C's\n286\t/// `int` -> `size_t` conversion (so `calloc` sees a huge request and returns\n287\t/// NULL), and no NULL check is added because the C code has none.\n288\t#[unsafe(no_mangle)]\n289\tpub extern \"C\" fn allocate_results(count: c_int) -> *mut ComputationResult {\n290\t    let results =\n291\t        unsafe { calloc(count as usize, size_of::<ComputationResult>()) } as *mut ComputationResult;\n292\t    results\n293\t}\n294\t\n295\t// ---------------------------------------------------------------------------\n296\t// int perform_computation_with_history(int a, int b, Operation op,\n297\t//                                      ComputationResult** history,\n298\t//                                      int* history_count)\n299\t// ---------------------------------------------------------------------------\n300\t\n301\t/// ```c\n302\t/// int perform_computation_with_history(int a, int b, Operation op,\n303\t///                                      ComputationResult** history,\n304\t///                                      int* history_count) {\n305\t///     MathOperation math_func = select_operation(op);\n306\t///     int result = math_func(a, b, 0);\n307\t///     if (*history == NULL) {\n308\t///         *history = allocate_results(10);\n309\t///         *history_count = 0;\n310\t///     }\n311\t///     if (*history_count < 10) {\n312\t///         (*history)[*history_count].value = result;\n313\t///         (*history)[*history_count].timestamp = get_computation_timestamp();\n314\t///         (*history)[*history_count].status = STATUS_SUCCESS;\n315\t///         (*history_count)++;\n316\t///     }\n317\t///     return result;\n318\t/// }\n319\t/// ```\n320\t///\n321\t/// The order of the two `if`s, the field assignment order and the timestamp\n322\t/// call site are all preserved. Note that the C code dereferences `*history`\n323\t/// without re-checking it after `allocate_results`, so a failed allocation\n324\t/// faults; that behaviour is reproduced rather than fixed.\n325\t///\n326\t/// # Safety\n327\t/// `history` and `history_count` must be valid, writable pointers, and\n328\t/// `*history` must be either NULL or an array of at least 10\n329\t/// `ComputationResult`s.\n330\t#[unsafe(no_mangle)]\n331\tpub unsafe extern \"C\" fn perform_computation_with_history(\n332\t    a: c_int,\n333\t    b: c_int,\n334\t    op: Operation,\n335\t    history: *mut *mut ComputationResult,\n336\t    history_count: *mut c_int,\n337\t) -> c_int {\n338\t    let math_func = select_operation(op);\n339\t\n340\t    let result = math_func(a, b, 0);\n341\t\n342\t    if (*history).is_null() {\n343\t        *history = allocate_results(10);\n344\t        *history_count = 0;\n345\t    }\n346\t\n347\t    if *history_count < 10 {\n348\t        let index = *history_count;\n349\t        let entry = (*history).offset(index as isize);\n350\t        (*entry).value = result;\n351\t        (*entry).timestamp = get_computation_timestamp();\n352\t        (*entry).status = STATUS_SUCCESS;\n353\t        *history_count = index.wrapping_add(1);\n354\t    }\n355\t\n356\t    result\n357\t}\n358\t\n359\t// ---------------------------------------------------------------------------\n360\t// int mathop(int param1, int param2, int param3, int param4)\n361\t//\n362\t// The `static` locals below correspond to:\n363\t//     static ComputationResult* computation_history = NULL;\n364\t//     static int history_count = 0;\n365\t// They are process-global and, exactly like the C original, not thread-safe.\n366\t// ---------------------------------------------------------------------------\n367\t\n368\tstatic mut COMPUTATION_HISTORY: *mut ComputationResult = ptr::null_mut();\n369\tstatic mut HISTORY_COUNT: c_int = 0;\n370\t\n371\t/// The public entry point declared in `include/lib.h`:\n372\t/// `int mathop(int a, int b, int c, int d);`\n373\t///\n374\t/// Every computation step and all four `printf` calls (same format strings,\n375\t/// same order) are reproduced verbatim, and the real libc `printf` is used so\n376\t/// stdout buffering/interleaving is identical to the C library's.\n377\t///\n378\t/// `%` on negative operands truncates toward zero in both C and Rust, so\n379\t/// `param3 % 5` can be negative and `selected_op` can therefore fall outside\n380\t/// `OP_ADD..=OP_MODULO`; `select_operation` then takes its `default` branch.\n381\t/// This quirk is intentionally preserved.\n382\t#[unsafe(no_mangle)]\n383\tpub extern \"C\" fn mathop(param1: c_int, param2: c_int, param3: c_int, param4: c_int) -> c_int {\n384\t    // `static ComputationResult* computation_history` / `static int history_count`\n385\t    let computation_history: *mut *mut ComputationResult = &raw mut COMPUTATION_HISTORY;\n386\t    let history_count: *mut c_int = &raw mut HISTORY_COUNT;\n387\t\n388\t    // char validation_char = (char)(param1 % 128);\n389\t    let mut validation_char: c_char = param1.wrapping_rem(128) as c_char;\n390\t\n391\t    // bool is_valid = is_valid_operation(validation_char);\n392\t    let is_valid = is_valid_operation(validation_char);\n393\t\n394\t    // if (!is_valid) { validation_char = '1'; }\n395\t    // (dead store in the original -- kept for fidelity)\n396\t    if !is_valid {\n397\t        validation_char = b'1' as c_char;\n398\t    }\n399\t    let _ = validation_char;\n400\t\n401\t    // Operation selected_op = (Operation)((param3 % 5) + 1);\n402\t    let selected_op: Operation = param3.wrapping_rem(5).wrapping_add(1);\n403\t\n404\t    // int operation_priority = get_operation_priority(selected_op);\n405\t    let operation_priority = get_operation_priority(selected_op);\n406\t\n407\t    // int intermediate_result = perform_computation_with_history(...);\n408\t    let intermediate_result = unsafe {\n409\t        perform_computation_with_history(\n410\t            param1,\n411\t            param2,\n412\t            selected_op,\n413\t            computation_history,\n414\t            history_count,\n415\t        )\n416\t    };\n417\t\n418\t    // Operation second_op = (Operation)(((param4 + 1) % 5) + 1);\n419\t    let second_op: Operation = param4.wrapping_add(1).wrapping_rem(5).wrapping_add(1);\n420\t\n421\t    // int final_result = perform_computation_with_history(...);\n422\t    let mut final_result = unsafe {\n423\t        perform_computation_with_history(\n424\t            intermediate_result,\n425\t            param4,\n426\t            second_op,\n427\t            computation_history,\n428\t            history_count,\n429\t        )\n430\t    };\n431\t\n432\t    // final_result += operation_priority;\n433\t    final_result = final_result.wrapping_add(operation_priority);\n434\t\n435\t    // time_t computation_time = get_computation_timestamp();\n436\t    let computation_time = get_computation_timestamp();\n437\t\n438\t    // int time_modifier = (int)(computation_time % 100);\n439\t    let time_modifier = (computation_time % 100) as c_int;\n440\t\n441\t    // final_result += time_modifier;\n442\t    final_result = final_result.wrapping_add(time_modifier);\n443\t\n444\t    unsafe {\n445\t        printf(\n446\t            b\"Computation performed at timestamp: %ld\\n\\0\".as_ptr() as *const c_char,\n447\t            computation_time as c_long,\n448\t        );\n449\t        printf(\n450\t            b\"Operation priority: %d\\n\\0\".as_ptr() as *const c_char,\n451\t            operation_priority,\n452\t        );\n453\t        printf(\n454\t            b\"History entries: %d\\n\\0\".as_ptr() as *const c_char,\n455\t            *history_count,\n456\t        );\n457\t        printf(\n458\t            b\"Final result: %d\\n\\0\".as_ptr() as *const c_char,\n459\t            final_result,\n460\t        );\n461\t    }\n462\t\n463\t    final_result\n464\t}\n465\t"}]},"parent_tool_use_id":null,"session_id":"9008289a-d643-4384-a252-4ad65f65b4dc","uuid":"15efd031-de7a-4ea0-afb7-78f5da4cbd7b","timestamp":"2026-08-19T21:14:33.736Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-nQy0oY/translated_rust/src/lib.rs","content":"// Rust translation of c_src/src/lib.c\n//\n// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n\nuse core::ffi::{c_char, c_int, c_long, c_void};\nuse core::mem::size_of;\nuse core::ptr;\n\n// ---------------------------------------------------------------------------\n// libc bindings\n//\n// The C translation unit uses `time()`, `calloc()` and `printf()` from libc.\n// They are declared (rather than re-implemented) so that behaviour -- in\n// particular stdout buffering semantics and heap ownership (callers may\n// `free()` the block returned by `allocate_results`) -- is bit-for-bit the\n// same as the C library's.\n// ---------------------------------------------------------------------------\n\nextern \"C\" {\n    fn time(tloc: *mut time_t) -> time_t;\n    fn calloc(nmemb: usize, size: usize) -> *mut c_void;\n    fn printf(format: *const c_char, ...) -> c_int;\n}\n\n/// `time_t` on the target ABI (x86-64 / aarch64 Linux: 64-bit signed).\npub type time_t = i64;\n\n// ---------------------------------------------------------------------------\n// typedef enum { OP_ADD = 1, ... } Operation;\n// ---------------------------------------------------------------------------\n\n/// `Operation` is an `int`-sized C enum, so it is modelled as `c_int`.\npub type Operation = c_int;\n\npub const OP_ADD: Operation = 1;\npub const OP_MULTIPLY: Operation = 2;\npub const OP_SUBTRACT: Operation = 3;\npub const OP_DIVIDE: Operation = 4;\npub const OP_MODULO: Operation = 5;\n\n// ---------------------------------------------------------------------------\n// typedef enum { STATUS_SUCCESS = 0, STATUS_ERROR = -1, STATUS_WARNING = 1 }\n//     StatusCode;\n// ---------------------------------------------------------------------------\n\n/// `StatusCode` is an `int`-sized C enum (it has a negative enumerator), so it\n/// is modelled as `c_int`.\npub type StatusCode = c_int;\n\npub const STATUS_SUCCESS: StatusCode = 0;\npub const STATUS_ERROR: StatusCode = -1;\npub const STATUS_WARNING: StatusCode = 1;\n\n// ---------------------------------------------------------------------------\n// typedef struct { int value; time_t timestamp; StatusCode status; }\n//     ComputationResult;\n//\n// Layout on the reference ABI: size 24, align 8,\n// offsets value = 0, timestamp = 8, status = 16.\n// ---------------------------------------------------------------------------\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct ComputationResult {\n    pub value: c_int,\n    pub timestamp: time_t,\n    pub status: StatusCode,\n}\n\n// ---------------------------------------------------------------------------\n// typedef int (*MathOperation)(int, int, int);\n// ---------------------------------------------------------------------------\n\npub type MathOperation = extern \"C\" fn(c_int, c_int, c_int) -> c_int;\n\n// ---------------------------------------------------------------------------\n// bool is_valid_operation(char op_char)\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// bool is_valid_operation(char op_char) {\n///     char valid = op_char && (op_char >= '1' && op_char <= '5');\n///     return valid;\n/// }\n/// ```\n///\n/// `char` is signed on the reference ABI, hence `c_char`. The intermediate\n/// `char valid` only ever holds 0 or 1, and the `_Bool` conversion is\n/// `valid != 0`; both steps are reproduced literally.\n#[unsafe(no_mangle)]\npub extern \"C\" fn is_valid_operation(op_char: c_char) -> bool {\n    const ONE: c_char = b'1' as c_char;\n    const FIVE: c_char = b'5' as c_char;\n\n    let condition = (op_char != 0) && (op_char >= ONE && op_char <= FIVE);\n    let valid: c_char = if condition { 1 } else { 0 };\n    valid != 0\n}\n\n// ---------------------------------------------------------------------------\n// int get_operation_priority(Operation op)\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// int get_operation_priority(Operation op) {\n///     int priority = op * 10;\n///     return priority;\n/// }\n/// ```\n///\n/// `wrapping_mul` matches the two's-complement result GCC/Clang produce for\n/// signed overflow; no bug is \"fixed\" here.\n#[unsafe(no_mangle)]\npub extern \"C\" fn get_operation_priority(op: Operation) -> c_int {\n    let priority = op.wrapping_mul(10);\n    priority\n}\n\n// ---------------------------------------------------------------------------\n// The five MathOperation implementations.\n//\n// `unused_param` is present in the C signature and deliberately ignored, so\n// the ABI is preserved exactly.\n// ---------------------------------------------------------------------------\n\n/// `int add_operation(int a, int b, int unused_param) { return a + b; }`\n#[unsafe(no_mangle)]\npub extern \"C\" fn add_operation(a: c_int, b: c_int, _unused_param: c_int) -> c_int {\n    a.wrapping_add(b)\n}\n\n/// `int multiply_operation(int a, int b, int unused_param) { return a * b; }`\n#[unsafe(no_mangle)]\npub extern \"C\" fn multiply_operation(a: c_int, b: c_int, _unused_param: c_int) -> c_int {\n    a.wrapping_mul(b)\n}\n\n/// `int subtract_operation(int a, int b, int unused_param) { return a - b; }`\n#[unsafe(no_mangle)]\npub extern \"C\" fn subtract_operation(a: c_int, b: c_int, _unused_param: c_int) -> c_int {\n    a.wrapping_sub(b)\n}\n\n/// ```c\n/// int divide_operation(int a, int b, int unused_param) {\n///     if (b == 0) {\n///         return 0;\n///     }\n///     return a / b;\n/// }\n/// ```\n///\n/// The divide-by-zero guard is kept in exactly the same position, and\n/// `wrapping_div` gives C's truncating-toward-zero quotient (e.g. `-7 / 2 ==\n/// -3`).\n///\n/// One documented divergence: `divide_operation(INT_MIN, -1, _)`. That is\n/// signed-overflow *undefined behaviour* in C -- the reference library executes\n/// `idiv` and dies from SIGFPE, so it has no defined output to be identical to.\n/// `wrapping_div` returns `INT_MIN` here instead of panicking or killing the\n/// process. Every input with defined C behaviour matches bit-for-bit.\n#[unsafe(no_mangle)]\npub extern \"C\" fn divide_operation(a: c_int, b: c_int, _unused_param: c_int) -> c_int {\n    if b == 0 {\n        return 0;\n    }\n    a.wrapping_div(b)\n}\n\n/// ```c\n/// int modulo_operation(int a, int b, int unused_param) {\n///     if (b == 0) {\n///         return 0;\n///     }\n///     return a % b;\n/// }\n/// ```\n///\n/// `wrapping_rem` reproduces C's truncating remainder, which keeps the sign of\n/// the dividend (e.g. `-3 % 5 == -3`). As with `divide_operation`, the\n/// `INT_MIN % -1` case is UB in C (SIGFPE on the reference build) and yields 0\n/// here rather than aborting.\n#[unsafe(no_mangle)]\npub extern \"C\" fn modulo_operation(a: c_int, b: c_int, _unused_param: c_int) -> c_int {\n    if b == 0 {\n        return 0;\n    }\n    a.wrapping_rem(b)\n}\n\n// ---------------------------------------------------------------------------\n// MathOperation select_operation(Operation op)\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// MathOperation select_operation(Operation op) {\n///     switch (op) {\n///         case OP_ADD:      return add_operation;\n///         case OP_MULTIPLY: return multiply_operation;\n///         case OP_SUBTRACT: return subtract_operation;\n///         case OP_DIVIDE:   return divide_operation;\n///         case OP_MODULO:   return modulo_operation;\n///         default:          return add_operation;\n///     }\n/// }\n/// ```\n///\n/// The returned pointers are the addresses of the exported symbols, so callers\n/// can compare them against `add_operation` &c. just as with the C library.\n#[unsafe(no_mangle)]\npub extern \"C\" fn select_operation(op: Operation) -> MathOperation {\n    match op {\n        OP_ADD => add_operation,\n        OP_MULTIPLY => multiply_operation,\n        OP_SUBTRACT => subtract_operation,\n        OP_DIVIDE => divide_operation,\n        OP_MODULO => modulo_operation,\n        _ => add_operation,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// time_t get_computation_timestamp(void)\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// time_t get_computation_timestamp() {\n///     time_t current_time;\n///     time(&current_time);\n///     current_time = current_time >> 29;\n///     return current_time;\n/// }\n/// ```\n///\n/// The `time()` return value is discarded in the C source exactly as here; the\n/// value comes from the out-parameter. `>>` on a signed `time_t` is an\n/// arithmetic shift, which `i64 >> 29` also performs.\n#[unsafe(no_mangle)]\npub extern \"C\" fn get_computation_timestamp() -> time_t {\n    let mut current_time: time_t = 0;\n    unsafe {\n        time(&mut current_time);\n    }\n    current_time >>= 29;\n    current_time\n}\n\n// ---------------------------------------------------------------------------\n// ComputationResult* allocate_results(int count)\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// ComputationResult* allocate_results(int count) {\n///     ComputationResult* results =\n///         (ComputationResult*)calloc(count, sizeof(ComputationResult));\n///     return results;\n/// }\n/// ```\n///\n/// `calloc` from libc is used so the block remains `free()`-able by callers.\n/// `count as usize` sign-extends negative counts precisely like C's\n/// `int` -> `size_t` conversion (so `calloc` sees a huge request and returns\n/// NULL), and no NULL check is added because the C code has none.\n#[unsafe(no_mangle)]\npub extern \"C\" fn allocate_results(count: c_int) -> *mut ComputationResult {\n    let results =\n        unsafe { calloc(count as usize, size_of::<ComputationResult>()) } as *mut ComputationResult;\n    results\n}\n\n// ---------------------------------------------------------------------------\n// int perform_computation_with_history(int a, int b, Operation op,\n//                                      ComputationResult** history,\n//                                      int* history_count)\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// int perform_computation_with_history(int a, int b, Operation op,\n///                                      ComputationResult** history,\n///                                      int* history_count) {\n///     MathOperation math_func = select_operation(op);\n///     int result = math_func(a, b, 0);\n///     if (*history == NULL) {\n///         *history = allocate_results(10);\n///         *history_count = 0;\n///     }\n///     if (