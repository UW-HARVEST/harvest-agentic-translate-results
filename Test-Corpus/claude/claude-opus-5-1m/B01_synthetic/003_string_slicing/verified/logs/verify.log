ices.\n    let take = if precision <= 0 {\n        0\n    } else {\n        (precision as usize).min(tail.len())\n    };\n    let _ = out.write_all(&tail[..take]);\n    let _ = out.write_all(b\"\\n\");\n    let _ = out.flush();\n\n    std::process::exit(0);\n}\n","numLines":252,"startLine":1,"totalLines":252}}}
