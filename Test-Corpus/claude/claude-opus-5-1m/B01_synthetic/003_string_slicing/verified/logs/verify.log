StrtolResult {\n41\t    /// The converted value, as returned by C `strtol` (a `long`).\n42\t    value: i64,\n43\t    /// Number of bytes consumed, i.e. `end - nptr`. Zero means \"no conversion\n44\t    /// could be performed\", which in C is signalled by `end == nptr`.\n45\t    consumed: usize,\n46\t}\n47\t\n48\t/// Faithful emulation of C `strtol(s, &end, 10)`.\n49\t///\n50\t/// * Skips leading whitespace as recognized by `isspace` in the C locale.\n51\t/// * Accepts an optional `+`/`-` sign.\n52\t/// * Accepts base-10 digits.\n53\t/// * On overflow, saturates to `LONG_MAX` / `LONG_MIN` (C also sets `errno`,\n54\t///   which the original program never inspects).\n55\t/// * If no digits are present, performs no conversion and reports\n56\t///   `consumed == 0` so the caller can reproduce the `end == nptr` test.\n57\tfn strtol_base10(s: &[u8]) -> StrtolResult {\n58\t    let mut i: usize = 0;\n59\t\n60\t    // isspace() in the \"C\" locale: space, \\t, \\n, \\v, \\f, \\r\n61\t    while i < s.len() && matches!(s[i], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r') {\n62\t        i += 1;\n63\t    }\n64\t\n65\t    let mut negative = false;\n66\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n67\t        negative = s[i] == b'-';\n68\t        i += 1;\n69\t    }\n70\t\n71\t    let digits_start = i;\n72\t    // Accumulate the magnitude in u64 so that LONG_MIN is representable.\n73\t    let mut magnitude: u64 = 0;\n74\t    let mut overflowed = false;\n75\t    while i < s.len() && s[i].is_ascii_digit() {\n76\t        let digit = u64::from(s[i] - b'0');\n77\t        if !overflowed {\n78\t            let next = magnitude\n79\t                .checked_mul(10)\n80\t                .and_then(|acc| acc.checked_add(digit));\n81\t            if let Some(acc) = next {\n82\t                magnitude = acc;\n83\t            } else {\n84\t                overflowed = true;\n85\t            }\n86\t        }\n87\t        i += 1;\n88\t    }\n89\t\n90\t    if i == digits_start {\n91\t        // No conversion performed: C leaves *endptr == nptr and returns 0.\n92\t        return StrtolResult {\n93\t            value: 0,\n94\t            consumed: 0,\n95\t        };\n96\t    }\n97\t\n98\t    // Saturate exactly like strtol does at the LONG_MAX / LONG_MIN boundaries.\n99\t    let limit: u64 = if negative {\n100\t        1u64 << 63 // magnitude of LONG_MIN\n101\t    } else {\n102\t        i64::MAX as u64\n103\t    };\n104\t\n105\t    let value = if overflowed || magnitude > limit {\n106\t        if negative {\n107\t            i64::MIN\n108\t        } else {\n109\t            i64::MAX\n110\t        }\n111\t    } else if negative {\n112\t        // Wrapping negate handles magnitude == 2^63 (LONG_MIN) correctly.\n113\t        magnitude.wrapping_neg() as i64\n114\t    } else {\n115\t        magnitude as i64\n116\t    };\n117\t\n118\t    StrtolResult {\n119\t        value,\n120\t        consumed: i,\n121\t    }\n122\t}\n123\t\n124\t/// Bytes of a command-line argument, as C would see them via `char *`.\n125\t#[cfg(unix)]\n126\tfn arg_bytes(arg: &OsString) -> Vec<u8> {\n127\t    arg.as_bytes().to_vec()\n128\t}\n129\t\n130\t/// Non-Unix fallback: arguments are recovered from their UTF-8 encoding.\n131\t#[cfg(not(unix))]\n132\tfn arg_bytes(arg: &OsString) -> Vec<u8> {\n133\t    arg.to_string_lossy().into_owned().into_bytes()\n134\t}\n135\t\n136\tfn main() {\n137\t    let args: Vec<OsString> = std::env::args_os().collect();\n138\t    // C's argc counts argv[0] (the program name) just like args_os() does.\n139\t    let argc = args.len();\n140\t\n141\t    let stdout = std::io::stdout();\n142\t    let mut out = stdout.lock();\n143\t\n144\t    if (argc > 4) || (argc == 1) {\n145\t        let _ = out.write_all(b\"Error: there should be one to three arguments passed:\\n\");\n146\t        let _ = out.write_all(b\"<string> [start] [stop]\\n\");\n147\t        let _ = out.flush();\n148\t        std::process::exit(1);\n149\t    }\n150\t\n151\t    // argc == 0 (no argv[0] at all) makes the C dereference argv[1] == NULL.\n152\t    // Reproduce the resulting crash rather than inventing a friendlier result.\n153\t    if argc == 0 {\n154\t        let _ = out.flush();\n155\t        std::process::abort();\n156\t    }\n157\t\n158\t    let arg1 = arg_bytes(&args[1]);\n159\t    // size_t len = strlen(argv[1]);\n160\t    let len: usize = arg1.len();\n161\t\n162\t    // int start, stop;  -- deliberately 32-bit, as in the C.\n163\t    let start: i32;\n164\t    let stop: i32;\n165\t\n166\t    // `char *end;` is uninitialized in the C. It is only ever assigned by the\n167\t    // strtol() call below, which runs whenever argc >= 3.\n168\t    let mut end_consumed: Option<usize> = None;\n169\t\n170\t    if argc >= 3 {\n171\t        let arg2 = arg_bytes(&args[2]);\n172\t        let parsed = strtol_base10(&arg2);\n173\t        // strtol returns long; assigning to int truncates (gcc: wraps).\n174\t        start = parsed.value as i32;\n175\t        end_consumed = Some(parsed.consumed);\n176\t\n177\t        if parsed.consumed == 0 {\n178\t            // end == argv[2]: note the C omits the trailing newline here.\n179\t            let _ = out.write_all(b\"Second argument must be an integer!\");\n180\t            let _ = out.flush();\n181\t            std::process::exit(1);\n182\t        }\n183\t\n184\t        // `start > len` compares int against size_t. The usual arithmetic\n185\t        // conversions promote `start` to an unsigned 64-bit value, so any\n186\t        // NEGATIVE start becomes enormous and trips this check. Preserved.\n187\t        if (i64::from(start) as u64) > (len as u64) {\n188\t            let _ = out.write_all(b\"Error: start is off the end of the string!\\n\");\n189\t            let _ = out.flush();\n190\t            std::process::exit(1);\n191\t        }\n192\t    } else {\n193\t        start = 0;\n194\t    }\n195\t\n196\t    if argc == 4 {\n197\t        let arg3 = arg_bytes(&args[3]);\n198\t        // The C passes NULL as endptr