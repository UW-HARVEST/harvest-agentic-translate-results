{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HgVmoiUpzqaF4iF5nE9SYq","type":"tool_result","content":"1\t// Rust translation of c_src/src/main.c\n2\t//\n3\t// Original copyright notice from the C source:\n4\t//\n5\t// Copyright 2025 MIT Lincoln Laboratory\n6\t// Permission is hereby granted, free of charge,\n7\t// to any person obtaining a copy of this software\n8\t// and associated documentation files (the \"Software\"),\n9\t// to deal in the Software without restriction,\n10\t// including without limitation the rights to use, copy,\n11\t// modify, merge, publish, distribute, sublicense,\n12\t// and/or sell copies of the Software,\n13\t// and to permit persons to whom the Software is furnished to do so,\n14\t// subject to the following conditions:\n15\t//\n16\t// The above copyright notice and this permission notice\n17\t// shall be included in all copies or substantial portions of the Software.\n18\t//\n19\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n20\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n21\t// THE WARRANTIES OF MERCHANTABILITY,\n22\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n23\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n24\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n25\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n26\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n27\t\n28\tuse std::io::{self, BufWriter, Read, Write};\n29\t\n30\t/// Emulation of C `stdio` for the single-threaded, sequential behavior of the\n31\t/// original program: byte-at-a-time reads from stdin (so that `fgets` never\n32\t/// consumes more input than a C `fgets` would) plus a fully buffered stdout.\n33\t///\n34\t/// The buffering is observable: C's `stdout` is fully buffered when it is not a\n35\t/// terminal, so output produced before the process dies from the out-of-bounds\n36\t/// write in `bad()` is *discarded*.  `BufWriter` reproduces that -- the buffer\n37\t/// is only handed to the OS by an explicit `flush()`, which the crash paths\n38\t/// deliberately skip.\n39\tpub struct Io {\n40\t    stdin: io::Stdin,\n41\t    stdout: BufWriter<io::Stdout>,\n42\t}\n43\t\n44\timpl Io {\n45\t    pub fn new() -> Self {\n46\t        Io {\n47\t            stdin: io::stdin(),\n48\t            stdout: BufWriter::new(io::stdout()),\n49\t        }\n50\t    }\n51\t\n52\t    pub fn flush(&mut self) {\n53\t        let _ = self.stdout.flush();\n54\t    }\n55\t\n56\t    /// Reads a single byte from stdin, returning `None` on EOF.\n57\t    fn read_byte(&mut self) -> Option<u8> {\n58\t        let mut b = [0u8; 1];\n59\t        loop {\n60\t            match self.stdin.read(&mut b) {\n61\t                Ok(0) => return None,\n62\t                Ok(_) => return Some(b[0]),\n63\t                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n64\t                Err(_) => return None,\n65\t            }\n66\t        }\n67\t    }\n68\t\n69\t    /// Emulates `fgets(buf, size, stdin)`.\n70\t    ///\n71\t    /// Reads at most `size - 1` bytes, stopping after a newline (which is kept\n72\t    /// in the returned bytes). Returns `None` if EOF is hit before any byte is\n73\t    /// read, mirroring `fgets` returning NULL. The implicit NUL terminator that\n74\t    /// C writes is not part of the returned data.\n75\t    fn fgets(&mut self, size: usize) -> Option<Vec<u8>> {\n76\t        if size == 0 {\n77\t            return None;\n78\t        }\n79\t        let mut buf: Vec<u8> = Vec::with_capacity(size);\n80\t        while buf.len() + 1 < size {\n81\t            match self.read_byte() {\n82\t                Some(c) => {\n83\t                    buf.push(c);\n84\t                    if c == b'\\n' {\n85\t                        break;\n86\t                    }\n87\t                }\n88\t                None => break,\n89\t            }\n90\t        }\n91\t        if buf.is_empty() {\n92\t            None\n93\t        } else {\n94\t            Some(buf)\n95\t        }\n96\t    }\n97\t\n98\t    pub fn print_line(&mut self, line: &str) {\n99\t        // printf(\"%s\\n\", line) -- the NULL check in the C original is handled by\n100\t        // the FFI wrapper in lib.rs, which is the only caller that can pass NULL.\n101\t        let _ = write!(self.stdout, \"{}\\n\", line);\n102\t    }\n103\t\n104\t    /// `printf(\"%s\\n\", line)` for a byte string that came in across the FFI\n105\t    /// boundary and need not be valid UTF-8.\n106\t    pub fn print_bytes_line(&mut self, line: &[u8]) {\n107\t        let _ = self.stdout.write_all(line);\n108\t        let _ = self.stdout.write_all(b\"\\n\");\n109\t    }\n110\t\n111\t    pub fn print_int_line(&mut self, int_number: i32) {\n112\t        // printf(\"%d\\n\", intNumber)\n113\t        let _ = write!(self.stdout, \"{}\\n\", int_number);\n114\t    }\n115\t}\n116\t\n117\t/// Emulates glibc's `atoi()`, which is `(int) strtol(nptr, NULL, 10)`:\n118\t/// leading whitespace is skipped, an optional sign is consumed, decimal digits\n119\t/// are accumulated, parsing stops at the first non-digit (or the NUL\n120\t/// terminator), and out-of-range values saturate to `long` bounds before being\n121\t/// truncated to `int`.\n122\tpub fn c_atoi(bytes: &[u8]) -> i32 {\n123\t    // A C string ends at the first NUL byte.\n124\t    let s = match bytes.iter().position(|&b| b == 0) {\n125\t        Some(pos) => &bytes[..pos],\n126\t        None => bytes,\n127\t    };\n128\t\n129\t    let mut i = 0usize;\n130\t    while i < s.len() && matches!(s[i], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r') {\n131\t        i += 1;\n132\t    }\n133\t\n134\t    let mut negative = false;\n135\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n136\t        negative = s[i] == b'-';\n137\t        i += 1;\n138\t    }\n139\t\n140\t    let mut value: i64 = 0;\n141\t    let mut overflow = false;\n142\t    while i < s.len() && s[i].is_ascii_digit() {\n143\t        let digit = (s[i] - b'0') as i64;\n144\t        if !overflow {\n145\t            match value.checked_mul(10).and_then(|v| v.checked_add(digit)) {\n146\t                Some(v) => value = v,\n147\t                None => overflow = true,\n148\t            }\n149\t        }\n150\t        i += 1;\n151\t    }\n152\t\n153\t    let as_long: i64 = if overflow {\n154\t        // strtol clamps to LONG_MAX / LONG_MIN (long is 64-bit here).\n155\t        if negative {\n156\t            i64::MIN\n157\t        } else {\n158\t            i64::MAX\n159\t        }\n160\t    } else if negative {\n161\t        value.wrapping_neg()\n162\t    } else {\n163\t        value\n164\t    };\n165\t\n166\t    // (int) cast: implementation-defined truncation of the low 32 bits.\n167\t    as_long as i32\n168\t}\n169\t\n170\t// ---------------------------------------------------------------------------\n171\t// CWE-129 sink: `buffer[data] = 1` with no upper-bound check.\n172\t//\n173\t// For `data >= 10` the C code writes outside `buffer`, which is undefined\n174\t// behavior.  The C is the ground truth, so the observable consequences of that\n175\t// write have to be reproduced rather than \"fixed\".  The consequences are fully\n176\t// determined by the stack frame gcc -O0 emits for `bad()` on x86-64; the layout\n177\t// below was read straight out of `objdump -d` of the CMake-built binary (and of\n178\t// the same file built as a shared object -- both are identical):\n179\t//\n180\t//     bad():  push %rbp; mov %rsp,%rbp; sub $0x40,%rsp\n181\t//             buffer      at rbp-0x40      inputBuffer at rbp-0x16\n182\t//             i           at rbp-0x08      data        at rbp-0x04\n183\t//     main(): push %rbp; mov %rsp,%rbp; sub $0x10,%rsp\n184\t//             argc        at main_rbp-0x04 argv        at main_rbp-0x10\n185\t//     => main_rbp == bad_rbp + 0x20\n186\t//\n187\t// `buffer[k]` is a 4-byte store at `&buffer[0] + 4*k`, i.e. `bad_rbp-0x40+4*k`:\n188\t//\n189\t//   k        byte offset  target                        observable effect\n190\t//   -------  -----------  ----------------------------  ------------------------\n191\t//   0..9       0..39      buffer[k]                     prints 1 at position k\n192\t//   10          40        alignment padding             none (dead storage)\n193\t//   11..13    44..52      inputBuffer[2..14]            none (dead after atoi)\n194\t//   14          56        i                             none (`i = 0` follows)\n195\t//   15          60        data                           none (already in %eax)\n196\t//   16..17    64..68      bad()'s saved rbp             SIGSEGV, no output\n197\t//   18..19    72..76      bad()'s return address        SIGSEGV, no output\n198\t//   20..23    80..92      main()'s argv / argc          none\n199\t//   24..25    96..100     main()'s saved rbp            none (main only leave/ret)\n200\t//   26..27   104..108     main()'s return address       SIGSEGV, no output\n201\t//   >= 28    >= 112       libc start frames, env block  none, until the write\n202\t//                                                       passes the top of the\n203\t//                                                       stack mapping -> SIGSEGV\n204\t//\n205\t// Verified empirically: for k in 0..=1300 the CMake binary is 100% reproducible\n206\t// over repeated runs and crashes for exactly k in {16,17,18,19,26,27}.  Far\n207\t// beyond that the outcome stops being reproducible *in C itself*, because stack\n208\t// ASLR moves the top of the stack relative to the frame; measured over 40 runs\n209\t// per index, k = 1500..2200 crashes only some of the time.  That band cannot be\n210\t// matched by construction; `far_write_is_fatal` below approximates the boundary\n211\t// from the real stack mapping so that the (overwhelmingly more common) very\n212\t// large indices crash the way C does.\n213\t// ---------------------------------------------------------------------------\n214\t\n215\t/// `buffer[k]` for these `k` lands on a saved frame pointer or return address\n216\t/// that is still live, so the C process dies with SIGSEGV before `stdout` is\n217\t/// ever flushed.\n218\tconst FATAL_INDICES: [i32; 6] = [16, 17, 18, 19, 26, 27];\n219\t\n220\t/// End address of the `[stack]` mapping, i.e. the first address past the top of\n221\t/// the stack.  A store at or beyond this address faults.\n222\tfn stack_mapping_end() -> Option<usize> {\n223\t    let maps = std::fs::read_to_string(\"/proc/self/maps\").ok()?;\n224\t    for line in maps.lines() {\n225\t        if line.ends_with(\"[stack]\") {\n226\t            let range = line.split_whitespace().next()?;\n227\t            let end = range.split('-').nth(1)?;\n228\t            return usize::from_str_radix(end, 16).ok();\n229\t        }\n230\t    }\n231\t    None\n232\t}\n233\t\n234\t/// True when the 4-byte store `buffer[k] = 1` would land past the top of the\n235\t/// stack mapping and therefore fault, as it does in C for large `k`.\n236\tfn far_write_is_fatal(frame_probe: usize, k: i32) -> bool {\n237\t    let end = match stack_mapping_end() {\n238\t        Some(e) => e,\n239\t        None => return false,\n240\t    };\n241\t    let offset = 4usize.saturating_mul(k as usize);\n242\t    frame_probe.saturating_add(offset) >= end\n243\t}\n244\t\n245\t/// Reproduces the death of the C process from the out-of-bounds store: SIGSEGV\n246\t/// with the still-buffered `stdout` contents discarded (never flushed).\n247\tfn die_like_c_oob_write() -> ! {\n248\t    // A store to the unmapped zero page raises SIGSEGV exactly as the corrupted\n249\t    // return address / past-the-stack store does in C.  Nothing is flushed and\n250\t    // no destructor runs, so the buffered output is lost just as C's is.\n251\t    unsafe {\n252\t        std::ptr::write_volatile(std::ptr::null_mut::<u8>(), 0u8);\n253\t    }\n254\t    // Not reached; kept so the function is diverging even if the store were\n255\t    // ever optimized away.\n256\t    std::process::abort();\n257\t}\n258\t\n259\t/// The unchecked sink shared by `bad()`: `buffer[data] = 1` followed by printing\n260\t/// `buffer[0..10]`.\n261\tfn bad_sink(io: &mut Io, data: i32) {\n262\t    let mut buffer = [0i32; 10];\n263\t    let probe: u32 = 0;\n264\t    let frame_probe = &probe as *const u32 as usize;\n265\t\n266\t    if data >= 0 {\n267\t        // buffer[data] = 1;\n268\t        let k = data;\n269\t        if k < 10 {\n270\t            buffer[k as usize] = 1;\n271\t        } else if FATAL_INDICES.contains(&k) || far_write_is_fatal(frame_probe, k) {\n272\t            die_like_c_oob_write();\n273\t        } else {\n274\t            // The store lands in dead storage of this frame or of a caller's\n275\t            // frame; it cannot change anything that is printed below.\n276\t        }\n277\t        /* Print the array values */\n278\t        for i in 0..10 {\n279\t            io.print_int_line(buffer[i]);\n280\t        }\n281\t    } else {\n282\t        io.print_line(\"ERROR: Array index is negative.\");\n283\t    }\n284\t}\n285\t\n286\tpub fn bad(io: &mut Io) {\n287\t    let mut data: i32;\n288\t    /* Initialize data */\n289\t    data = -1;\n290\t    {\n291\t        // char inputBuffer[14] = \"\";\n292\t        match io.fgets(14) {\n293\t            Some(input_buffer) => {\n294\t                /* Convert to int */\n295\t                data = c_atoi(&input_buffer);\n296\t            }\n297\t            None => {\n298\t                io.print_line(\"fgets() failed.\");\n299\t            }\n300\t        }\n301\t    }\n302\t    bad_sink(io, data);\n303\t}\n304\t\n305\t/* goodG2B uses the GoodSource with the BadSink */\n306\t#[allow(unused_assignments)] // mirrors the dead store in the C original\n307\tpub fn good_g2b(io: &mut Io) {\n308\t    let mut data: i32;\n309\t    /* Initialize data */\n310\t    data = -1;\n311\t    data = 7;\n312\t    {\n313\t        let mut buffer = [0i32; 10];\n314\t        if data >= 0 {\n315\t            buffer[data as usize] = 1;\n316\t            /* Print the array values */\n317\t            for i in 0..10 {\n318\t                io.print_int_line(buffer[i]);\n319\t            }\n320\t        } else {\n321\t            io.print_line(\"ERROR: Array index is negative.\");\n322\t        }\n323\t    }\n324\t}\n325\t\n326\t/* goodB2G uses the BadSource with the GoodSink */\n327\tpub fn good_b2g(io: &mut Io) {\n328\t    let mut data: i32;\n329\t    /* Initialize data */\n330\t    data = -1;\n331\t    {\n332\t        // char inputBuffer[14] = \"\";\n333\t        match io.fgets(14) {\n334\t            Some(input_buffer) => {\n335\t                /* Convert to int */\n336\t                data = c_atoi(&input_buffer);\n337\t            }\n338\t            None => {\n339\t                io.print_line(\"fgets() failed.\");\n340\t            }\n341\t        }\n342\t    }\n343\t    {\n344\t        let mut buffer = [0i32; 10];\n345\t        if data >= 0 && data < 10 {\n346\t            buffer[data as usize] = 1;\n347\t            /* Print the array values */\n348\t            for i in 0..10 {\n349\t                io.print_int_line(buffer[i]);\n350\t            }\n351\t        } else {\n352\t            io.print_line(\"ERROR: Array index is out-of-bounds\");\n353\t        }\n354\t    }\n355\t}\n356\t\n357\tpub fn good(io: &mut Io) {\n358\t    good_g2b(io);\n359\t    good_b2g(io);\n360\t}\n361\t\n362\t/// The body of the C `main()`.  Returns the value C returns (0).\n363\tpub fn run_main(io: &mut Io) -> i32 {\n364\t    io.print_line(\"Calling good()...\");\n365\t    good(io);\n366\t    io.print_line(\"Finished good()\");\n367\t    io.print_line(\"Calling bad()...\");\n368\t    bad(io);\n369\t    io.print_line(\"Finished bad()\");\n370\t    0\n371\t}\n372\t"}]},"parent_tool_use_id":"toolu_bdrk_014bcJbEA2ytTVrNHy4sK9vY","session_id":"6de6788a-c8a8-4554-8fe2-4313825db3b2","uuid":"23584da8-042a-4499-9e35-f450d1d2936c","timestamp":"2026-08-18T00:22:00.449Z","subagent_type":"general-purpose","task_description":"Independent C-vs-Rust semantic audit"}
