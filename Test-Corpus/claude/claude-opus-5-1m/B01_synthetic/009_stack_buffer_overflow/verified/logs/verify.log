nt(\"  C :\", sorted((a,b[:80]) for a,b in cc))\n            print(\"  RS:\", sorted((a,b[:80]) for a,b in rr))\n            if ndiff>10: break\nprint(\"fuzz done: compared\",n,\"skipped(nondet C)\",nskip,\"divergent\",ndiff)\nEOF\" completed (exit code 0)","uuid":"6711513f-6214-40c7-b8c4-039bc1e8dcc8","session_id":"6de6788a-c8a8-4554-8fe2-4313825db3b2"}
