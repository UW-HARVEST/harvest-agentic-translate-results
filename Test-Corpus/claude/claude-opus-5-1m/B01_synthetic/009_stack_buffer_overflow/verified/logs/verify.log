       ]:\n    add(s)\n# embedded NUL\nadd(b\"12\\x0034\", \"embedded NUL\")\nadd(b\"\\x0012\", \"leading NUL\")\nadd(b\"1\\x002\", \"nul mid\")\nadd(b\"-\\x005\", \"nul after sign\")\nadd(b\" \\x005\", \"nul after ws\")\nadd(b\"7\\x00\\x00\\x00\", \"nul pad\")\n# high bytes / non-ascii\nadd(b\"\\xff5\", \"high byte\")\nadd(b\"5\\xff\", \"trailing high\")\nadd(b\"\\xc3\\xa95\", \"utf8 e-acute\")\nadd(b\"\\xa0\" + b\"5\", \"nbsp latin1\")\n# 13-char boundary exhaustive-ish: all 13-digit numbers randomly\nrandom.seed(7)\nfor _ in range(400):\n    n = random.randint(1,13)\n    s = \"\".join(random.choice(\"0123456789\") for _ in range(n))\n    add(s)\nfor _ in range(400):\n    n = random.randint(1,12)\n    s = \"-\" + \"\".join(random.choice(\"0123456789\") for _ in range(n))\n    add(s)\nfor _ in range(300):\n    n = random.randint(0,6)\n    s = \"\".join(random.choice(\" \\t\\n\\v\\f\\r+-0123456789abcxX.eE,\\x00\") for _ in range(n))\n    add(s)\n# all single bytes\nfor i in range(256):\n    add(bytes([i]), \"single byte %d\"%i)\n# two byte combos of interesting chars\nchars = b\" \\t\\n\\v\\f\\r+-0123456789.exX\\x00\"\nfor a in chars:\n    for b in chars:\n        add(bytes([a,b]))\n\nwith open(\"corpus.txt\",\"w\") as f, open(\"corpus_labels.txt\",\"w\") as g:\n    for b,note in cases:\n        f.write(b.hex()+\"\\n\")\n        g.write(repr(b)+\"\\t\"+note+\"\\n\")\nprint(len(cases))\nEOF"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":826,"cache_read_input_tokens":35177,"cache_creation":{"ephemeral_5m_input_tokens":826,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_014bcJbEA2ytTVrNHy4sK9vY","session_id":"6de6788a-c8a8-4554-8fe2-4313825db3b2","uuid":"10eb7583-5a79-4f76-b0ae-f44042a9b773","timestamp":"2026-08-18T00:23:54.637Z","subagent_type":"general-purpose","task_description":"Independent C-vs-Rust semant