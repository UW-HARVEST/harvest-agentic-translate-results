n53\t        {\n54\t            printLine(\"fgets() failed.\");\n55\t        }\n56\t    }\n57\t    {\n58\t        int i;\n59\t        int buffer[10] = { 0 };\n60\t        if (data >= 0)\n61\t        {\n62\t            buffer[data] = 1;\n63\t            /* Print the array values */\n64\t            for(i = 0; i < 10; i++)\n65\t            {\n66\t                printIntLine(buffer[i]);\n67\t            }\n68\t        }\n69\t        else\n70\t        {\n71\t            printLine(\"ERROR: Array index is negative.\");\n72\t        }\n73\t    }\n74\t}\n75\t\n76\t\n77\t/* goodG2B uses the GoodSource with the BadSink */\n78\tstatic void goodG2B()\n79\t{\n80\t    int data;\n81\t    /* Initialize data */\n82\t    data = -1;\n83\t    data = 7;\n84\t    {\n85\t        int i;\n86\t        int buffer[10] = { 0 };\n87\t        if (data >= 0)\n88\t        {\n89\t            buffer[data] = 1;\n90\t            /* Print the array values */\n91\t            for(i = 0; i < 10; i++)\n92\t            {\n93\t                printIntLine(buffer[i]);\n94\t            }\n95\t        }\n96\t        else\n97\t        {\n98\t            printLine(\"ERROR: Array index is negative.\");\n99\t        }\n100\t    }\n101\t}\n102\t\n103\t/* goodB2G uses the BadSource with the GoodSink */\n104\tstatic void goodB2G()\n105\t{\n106\t    int data;\n107\t    /* Initialize data */\n108\t    data = -1;\n109\t    {\n110\t        char inputBuffer[14] = \"\";\n111\t        if (fgets(inputBuffer, 14, stdin) != NULL)\n112\t        {\n113\t            /* Convert to int */\n114\t            data = atoi(inputBuffer);\n115\t        }\n116\t        else\n117\t        {\n118\t            printLine(\"fgets() failed.\");\n119\t        }\n120\t    }\n121\t    {\n122\t        int i;\n123\t        int buffer[10] = { 0 };\n124\t        if (data >= 0 && data < (10))\n125\t        {\n126\t            buffer[data] = 1;\n127\t            /* Print the array values */\n128\t            for(i = 0; i < 10; i++)\n129\t            {\n130\t                printIntLine(buffer[i]);\n131\t            }\n132\t        }\n133\t        else\n134\t        {\n135\t            printLine(\"ERROR: Array index is out-of-bounds\");\n136\t        }\n137\t    }\n138\t}\n139\t\n140\tvoid good()\n141\t{\n142\t    goodG2B();\n143\t    goodB2G();\n144\t}\n145\t\n146\tint main(int argc, char * argv[])\n147\t{\n148\t    printLine(\"Calling good()...\");\n149\t    good();\n150\t    printLine(\"Finished good()\");\n151\t    printLine(\"Calling bad()...\");\n152\t    bad();\n153\t    printLine(\"Finished bad()\");\n154\t    return 0;\n155\t}\n156\t"}]},"parent_tool_use_id":"toolu_bdrk_018tXrCniZHFwoX4NqYTaYXh","session_id":"6de6788a-c8a8-4554-8fe2-4313825db3b2","uuid":"c03b838a-0008-46c3-b64b-354e2cfb896c","timestamp":"2026-08-18T00:55:20.050Z","subagent_type":"general-purpose","task_description":"Second audit of rewritten impl"}
