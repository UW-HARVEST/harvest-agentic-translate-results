 main_rbp-0x04 argv        at main_rbp-0x10","-//     => main_rbp == bad_rbp + 0x20","-//","-// `buffer[k]` is a 4-byte store at `&buffer[0] + 4*k`, i.e. `bad_rbp-0x40+4*k`:","-//","-//   k        byte offset  target                        observable effect","-//   -------  -----------  ----------------------------  ------------------------","-//   0..9       0..39      buffer[k]                     prints 1 at position k","-//   10          40        alignment padding             none (dead storage)","-//   11..13    44..52      inputBuffer[2..14]            none (dead after atoi)","-//   14          56        i                             none (`i = 0` follows)","-//   15          60        data                           none (already in %eax)","-//   16..17    64..68      bad()'s saved rbp             SIGSEGV, no output","-//   18..19    72..76      bad()'s return address        SIGSEGV, no output","-//   20..23    80..92      main()'s argv / argc          none","-//   24..25    96..100     main()'s saved rbp            none (main only leave/ret)","-//   26..27   104..108     main()'s return address       SIGSEGV, no output","-//   >= 28    >= 112       libc start frames, env block  none, until the write","-//                                                       passes the top of the","-//                                                       stack mapping -> SIGSEGV","-//","-// Verified empirically: for k in 0..=1300 the CMake binary is 100% reproducible","-// over repeated runs and crashes for exactly k in {16,17,18,19,26,27}.  Far","-// beyond that the outcome stops being reproducible *in C itself*, because stack","-// ASLR moves the top of the stack relative to the frame; measured over 40 runs","-// per index, k = 1500..2200 crashes only some of the time.  That band cannot be","-// matched by construction; `far_write_is_fatal` below approximates the boundary","-// from the real stack mapping so that the (overwhelmingly more common) very","-// large indices crash the way C does.","-// ---------------------------------------------------------------------------","-","-/// `buffer[k]` for these `k` lands on a saved frame pointer or return address","-/// that is still live, so the C process dies with SIGSEGV before `stdout` is","-/// ever flushed.","-const FATAL_INDICES: [i32; 6] = [16, 17, 18, 19, 26, 27];","-","-/// End address of the `[stack]` mapping, i.e. the first address past the top of","-/// the stack.  A store at or beyond this address faults.","-fn stack_mapping_end() -> Option<usize> {","-    let maps = std::fs::read_to_string(\"/proc/self/maps\").ok()?;","-    for line in maps.lines() {","-        if line.ends_with(\"[stack]\") {","-            let range = line.split_whitespace().next()?;","-            let end = range.split('-').nth(1)?;","-            return usize::from_str_radix(end, 16).ok();","-        }","-    }","-    None","-}","-","-/// True when the 4-byte store `buffer[k] = 1` would land past the top of the","-/// stack mapping and therefore fault, as it does in C for large `k`.","-fn far_write_is_fatal(frame_probe: usize, k: i32) -> bool {","-    let end = match stack_mapping_end() {","-        Some(e) => e,","-        None => return false,","-    };","-    let offset = 4usize.saturating_mul(k as usize);","-    frame_probe.saturating_add(offset) >= end","-}","-","-/// Reproduces the death of the C process from the out-of-bounds store: SIGSEGV","-/// with the still-buffered `stdout` contents discarded (never flushed).","-fn die_like_c_oob_write() -> ! {","-    // A store to the unmapped zero page raises SIGSEGV exactly as the corrupted","-    // return address / past-the-stack store does in C.  Nothing is flushed and","-    // no destructor runs, so the buffered output is lost just as C's is.","-    unsafe {","-        std::ptr::write_volatile(std::ptr::null_mut::<u8>(), 0u8);","-    }","-    // Not reached; kept so the function is diverging even if the store were","-    // ever optimized away.","-  