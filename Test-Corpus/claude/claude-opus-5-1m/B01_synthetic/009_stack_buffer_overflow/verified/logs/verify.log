intLine(const char * line)`\n///\n/// Reproduces the `line != NULL` guard: a NULL argument prints nothing at all.\n#[no_mangle]\npub extern \"C\" fn printLine(line: *const c_char) {\n    if line.is_null() {\n        return;\n    }\n    // printf(\"%s\\n\", line) stops at the NUL terminator and passes the bytes\n    // through unchanged, so operate on raw bytes rather than going through UTF-8\n    // validation, which would corrupt non-UTF-8 input.\n    let bytes = unsafe { std::ffi::CStr::from_ptr(line) }.to_bytes();\n    let mut io = Io::new();\n    io.print_bytes_line(bytes);\n    io.flush();\n}\n\n/// `void printIntLine(int intNumber)`\n#[no_mangle]\npub extern \"C\" fn printIntLine(int_number: c_int) {\n    let mut io = Io::new();\n    io.print_int_line(int_number);\n    io.flush();\n}\n\n/// `void bad()`\n#[no_mangle]\npub extern \"C\" fn bad() {\n    let mut io = Io::new();\n    imp::bad(&mut io);\n    io.flush();\n}\n\n/// `void good()`\n#[no_mangle]\npub extern \"C\" fn good() {\n    let mut io = Io::new();\n    imp::good(&mut io);\n    io.flush();\n}\n\n/// `int main(int argc, char * argv[])`\n///\n/// `main` has external linkage in the C translation unit and so appears in the\n/// shared object's dynamic symbol table; it is exported here for parity.  `argc`\n/// and `argv` are unused by the C body.\n#[no_mangle]\npub extern \"C\" fn main(_argc: c_int, _argv: *const *const c_char) -> c_int {\n    let mut io = Io::new();\n    let rc = imp::run_main(&mut io);\n    io.flush();\n    rc\n}\n","userModified":false}}
