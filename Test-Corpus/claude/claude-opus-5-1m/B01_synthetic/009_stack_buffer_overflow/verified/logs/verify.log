ut: BufWriter::new(io::stdout()),\n43\t        }\n44\t    }\n45\t\n46\t    /// Reads a single byte from stdin, returning `None` on EOF.\n47\t    fn read_byte(&mut self) -> Option<u8> {\n48\t        let mut b = [0u8; 1];\n49\t        loop {\n50\t            match self.stdin.read(&mut b) {\n51\t                Ok(0) => return None,\n52\t                Ok(_) => return Some(b[0]),\n53\t                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n54\t                Err(_) => return None,\n55\t            }\n56\t        }\n57\t    }\n58\t\n59\t    /// Emulates `fgets(buf, size, stdin)`.\n60\t    ///\n61\t    /// Reads at most `size - 1` bytes, stopping after a newline (which is kept\n62\t    /// in the returned bytes). Returns `None` if EOF is hit before any byte is\n63\t    /// read, mirroring `fgets` returning NULL. The implicit NUL terminator that\n64\t    /// C writes is not part of the returned data.\n65\t    fn fgets(&mut self, size: usize) -> Option<Vec<u8>> {\n66\t        if size == 0 {\n67\t            return None;\n68\t        }\n69\t        let mut buf: Vec<u8> = Vec::with_capacity(size);\n70\t        while buf.len() + 1 < size {\n71\t            match self.read_byte() {\n72\t                Some(c) => {\n73\t                    buf.push(c);\n74\t                    if c == b'\\n' {\n75\t                        break;\n76\t                    }\n77\t                }\n78\t                None => break,\n79\t            }\n80\t        }\n81\t        if buf.is_empty() {\n82\t            None\n83\t        } else {\n84\t            Some(buf)\n85\t        }\n86\t    }\n87\t\n88\t    fn print_line(&mut self, line: &str) {\n89\t        // printf(\"%s\\n\", line) -- the NULL check in the C original can never\n90\t        // fail for the string literals it is called with.\n91\t        let _ = write!(self.stdout, \"{}\\n\", line);\n92\t    }\n93\t\n94\t    fn print_int_line(&mut self, int_number: i32) {\n95\t        // printf(\"%d\\n\", intNumber)\n96\t        let _ = write!(self.stdout, \"{}\\n\", int_number);\n97\t    }\n98\t}\n99\t\n100\t/// Emulates glibc's `atoi()`, which is `(int) strtol(nptr, NULL, 10)`:\n101\t/// leading whitespace is skipped, an optional sign is consumed, decimal digits\n102\t/// are accumulated, parsing stops at the first non-digit (or the NUL\n103\t/// terminator), and out-of-range values saturate to `long` bounds before being\n104\t/// truncated to `int`.\n105\tfn c_atoi(bytes: &[u8]) -> i32 {\n106\t    // A C string ends at the first NUL byte.\n107\t    let s = match bytes.iter().position(|&b| b == 0) {\n108\t        Some(pos) => &bytes[..pos],\n109\t        None => bytes,\n110\t    };\n111\t\n112\t    let mut i = 0usize;\n113\t    while i < s.len() && matches!(s[i], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r') {\n114\t        i += 1;\n115\t    }\n116\t\n117\t    let mut negative = false;\n118\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n119\t        negative = s[i] == b'-';\n120\t        i += 1;\n121\t    }\n122\t\n123\t    let mut value: i64 = 0;\n124\t    let mut overflow = false;\n125\t    while i < s.len() && s[i].is_ascii_digit() {\n126\t        let digit = (s[i] - b'0') as i64;\n127\t        if !overflow {\n128\t            match value.checked_mul(10).and_then(|v| v.checked_add(digit)) {\n129\t                Some(v) => value = v,\n130\t                None => overflow = true,\n131\t            }\n132\t        }\n133\t        i += 1;\n134\t    }\n135\t\n136\t    let as_long: i64 = if overflow {\n137\t        // strtol clamps to LONG_MAX / LONG_MIN (long is 64-bit here).\n138\t        if negative {\n139\t            i64::MIN\n140\t        } else {\n141\t            i64::MAX\n142\t        }\n143\t    } else if negative {\n144\t        value.wrapping_neg()\n145\t    } else {\n146\t        value\n147\t    };\n148\t\n149\t    // (int) cast: implementation-defined truncation of the low 32 bits.\n150\t    as_long as i32\n151\t}\n152\t\n153\tfn bad(io: &mut Io) {\n154\t    let mut data: i32;\n155\t    /* Initialize data */\n156\t    data = -1;\n157\t    {\n158\t        // char inputBuffer[14] = \"\";\n159\t        match io.fgets(14) {\n160\t            Some(input_buffer) => {\n161\t                /* Convert to int */\n162\t                data = c_atoi(&input_buffer);\n163\t            }\n164\t            None => {\n165\t                io.print_line(\"fgets() failed.\");\n166\t            }\n167\t        }\n168\t    }\n169\t    {\n170\t        let mut buffer = [0i32; 10];\n171\t        if data >= 0 {\n172\t            // buffer[data] = 1;\n173\t            //\n174\t            // This is the CWE-129 sink: the C code performs no upper-bound\n175\t            // check, so for data >= 10 it writes past the end of the buffer,\n176\t            // which is undefined behavior. In practice (gcc, no optimization)\n177\t            // such a write lands in unused stack space or in dead locals of the\n178\t            // same frame, leaving all ten printed elements at 0, so the write is\n179\t            // simply dropped here. It cannot change any value that gets printed.\n180\t            let index = data as usize;\n181\t            if index < buffer.len() {\n182\t                buffer[index] = 1;\n183\t            }\n184\t            /* Print the array values */\n185\t            for i in 0..10 {\n186\t                io.print_int_line(buffer[i]);\n187\t            }\n188\t        } else {\n189\t            io.print_line(\"ERROR: Array index is negative.\");\n190\t        }\n191\t    }\n192\t}\n193\t\n194\t/* goodG2B uses the GoodSource with the BadSink */\n195\t#[allow(unused_assignments)] // mirrors the dead store in the C original\n196\tfn good_g2b(io: &mut Io) {\n197\t    let mut data: i32;\n198\t    /* Initialize data */\n199\t    data = -1;\n200\t    data = 7;\n201\t    {\n202\t        let mut buffer = [0i32; 10];\n203\t        if data >= 0 {\n204\t            buffer[data as usize] = 1;\n205\t            /* Print the array values */\n206\t            for i in 0..10 {\n207\t                io.print_int_line(buffer[i]);\n208\t            }\n209\t        } else {\n210\t            io.print_line(\"ERROR: Array index is negative.\");\n211\t        }\n212\t    }\n213\t}\n214\t\n215\t/* goodB2G uses the BadSource with the GoodSink */\n216\tfn good_b2g(io: &mut Io) {\n217\t    let mut data: i32;\n218\t    /* Initialize data */\n219\t    data = -1;\n220\t    {\n221\t        // char inputBuffer[14] = \"\";\n222\t        match io.fgets(14) {\n223\t            Some(input_buffer) => {\n224\t                /* Convert to int */\n225\t                data = c_atoi(&input_buffer);\n226\t            }\n227\t            None => {\n228\t                io.print_line(\"fgets() failed.\");\n229\t            }\n230\t        }\n231\t    }\n232\t    {\n233\t        let mut buffer = [0i32; 10];\n234\t        if data >= 0 && data < 10 {\n235\t            buffer[data as usize] = 1;\n236\t            /* Print the array values */\n237\t            for i in 0..10 {\n238\t                io.print_int_line(buffer[i]);\n239\t            }\n240\t        } else {\n241\t            io.print_line(\"ERROR: Array index is out-of-bounds\");\n242\t        }\n243\t    }\n244\t}\n245\t\n246\tfn good(io: &mut Io) {\n247\t    good_g2b(io);\n248\t    good_b2g(io);\n249\t}\n250\t\n251\tfn main() {\n252\t    let mut io = Io::new();\n253\t    io.print_line(\"Calling good()...\");\n254\t    good(&mut io);\n255\t    io.print_line(\"Finished good()\");\n256\t    io.print_line(\"Calling bad()...\");\n257\t    bad(&mut io);\n258\t    io.print_line(\"Finished bad()\");\n259\t    let _ = io.stdout.flush();\n260\t}\n261\t"}]},"parent_tool_use_id":null,"session_id":"6de6788a-c8a8-4554-8fe2-4313825db3b2","uuid":"4c602b0c-bfef-403c-9dbf-180f0e8331c9","timestamp":"2026-08-18T00:08:22.264Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-n48Iqv/translated_rust/src/main.rs","content":"// Rust translation of c_src/src/main.c\n//\n// Original copyright notice from the C source:\n//\n// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\nuse std::io::{self, BufWriter, Read, Write};\n\n/// Emulation of C `stdio` for the single-threaded, sequential behavior of the\n/// original program: byte-at-a-time reads from stdin (so that `fgets` never\n/// consumes more input than a C `fgets` would) plus a buffered stdout.\nstruct Io {\n    stdin: io::Stdin,\n    stdout: BufWriter<io::Stdout>,\n}\n\nimpl Io {\n    fn new() -> Self {\n        Io {\n            stdin: io::stdin(),\n            stdout: BufWriter::new(io::stdout()),\n        }\n    }\n\n    /// Reads a single byte from stdin, returning `None` on EOF.\n    fn read_byte(&mut self) -> Option<u8> {\n        let mut b = [0u8; 1];\n        loop {\n            match self.stdin.read(&mut b) {\n                Ok(0) => return None,\n                Ok(_) => return Some(b[0]),\n                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n                Err(_) => return None,\n            }\n        }\n    }\n\n    /// Emulates `fgets(buf, size, stdin)`.\n    ///\n    /// Reads at most `size - 1` bytes, stopping after a newline (which is kept\n    /// in the returned bytes). Returns `None` if EOF is hit before any byte is\n    /// read, mirroring `fgets` returning NULL. The implicit NUL terminator that\n    /// C writes is not part of the returned data.\n    fn fgets(&mut self, size: usize) -> Option<Vec<u8>> {\n        if size == 0 {\n            return None;\n        }\n        let mut buf: Vec<u8> = Vec::with_capacity(size);\n        while buf.len() + 1 < size {\n            match self.read_byte() {\n                Some(c) => {\n                    buf.push(c);\n                    if c == b'\\n' {\n                        break;\n                    }\n                }\n                None => break,\n            }\n        }\n        if buf.is_empty() {\n            None\n        } else {\n            Some(buf)\n        }\n    }\n\n    fn print_line(&mut self, line: &str) {\n        // printf(\"%s\\n\", line) -- the NULL check in the C original can never\n        // fail for the string literals it is called with.\n        let _ = write!(self.stdout, \"{}\\n\", line);\n    }\n\n    fn print_int_line(&mut self, int_number: i32) {\n        // printf(\"%d\\n\", intNumber)\n        let _ = write!(self.stdout, \"{}\\n\", int_number);\n    }\n}\n\n/// Emulates glibc's `atoi()`, which is `(int) strtol(nptr, NULL, 10)`:\n/// leading whitespace is skipped, an optional sign is consumed, decimal digits\n/// are accumulated, parsing stops at the first non-digit (or the NUL\n/// terminator), and out-of-range values saturate to `long` bounds before being\n/// truncated to `int`.\nfn c_atoi(bytes: &[u8]) -> i32 {\n    // A C string ends at the first NUL byte.\n    let s = match bytes.iter().position(|&b| b == 0) {\n        Some(pos) => &bytes[..pos],\n        None => bytes,\n    };\n\n    let mut i = 0usize;\n    while i < s.len() && matches!(s[i], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r') {\n        i += 1;\n    }\n\n    let mut negative = false;\n    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n        negative = s[i] == b'-';\n        i += 1;\n    }\n\n    let mut value: i64 = 0;\n    let mut overflow = false;\n    while i < s.len() && s[i].is_ascii_digit() {\n        let digit = (s[i] - b'0') as i64;\n        if !overflow {\n            match value.checked_mul(10).and_then(|v| v.checked_add(digit)) {\n                Some(v) => value = v,\n                None => overflow = true,\n            }\n        }\n        i += 1;\n    }\n\n    let as_long: i64 = if overflow {\n        // strtol clamps to LONG_MAX / LONG_MIN (long is 64-bit here).\n        if negative {\n            i64::MIN\n        } else {\n            i64::MAX\n        }\n    } else if negative {\n        value.wrapping_neg()\n    } else {\n        value\n    };\n\n    // (int) cast: implementation-defined truncation of the low 32 bits.\n    as_long as i32\n}\n\nfn bad(io: &mut Io) {\n    let mut data: i32;\n    /* Initialize data */\n    data = -1;\n    {\n        // char inputBuffer[14] = \"\";\n        match io.fgets(14) {\n            Some(input_buffer) => {\n                /* Convert to int */\n                data = c_atoi(&input_buffer);\n            }\n            None => {\n                io.print_line(\"fgets() failed.\");\n            }\n        }\n    }\n    {\n        let mut buffer = [0i32; 10];\n        if data >= 0 {\n            // buffer[data] = 1;\n            //\n            // This is the CWE-129 sink: the C code performs no upper-bound\n            // check, so for data >= 10 it writes past the end of the buffer,\n            // which is undefined behavior. In practice (gcc, no optimization)\n            // such a write lands in unused stack space or in dead locals of the\n            // same frame, leaving all ten printed elements at 0, so the write is\n            // simply dropped here. It cannot change any value that gets printed.\n            let index = data as usize;\n            if index < buffer.len() {\n                buffer[index] = 1;\n            }\n            /* Print the array values */\n            for i in 0..10 {\n                io.print_int_line(buffer[i]);\n            }\n        } else {\n            io.print_line(\"ERROR: Array index is negative.\");\n        }\n    }\n}\n\n/* goodG2B uses the GoodSource with the BadSink */\n#[allow(unused_assignments)] // mirrors the dead store in the C original\nfn good_g2b(io: &mut Io) {\n    let mut data: i32;\n    /* Initialize data */\n    data = -1;\n    data = 7;\n    {\n        let mut buffer = [0i32; 10];\n        if data >= 0 {\n            buffer[data as usize] = 1;\n            /* Print the array values */\n            for i in 0..10 {\n                io.print_int_line(buffer[i]);\n            }\n        } else {\n            io.print_line(\"ERROR: Array index is negative.\");\n        }\n    }\n}\n\n/* goodB2G uses the BadSource with the GoodSink */\nfn good_b2g(io: &mut Io) {\n    let mut data: i32;\n    /* Initialize data */\n    data = -1;\n    {\n        // char inputBuffer[14] = \"\";\n        match io.fgets(14) {\n            Some(input_buffer) => {\n                /* Convert to int */\n                data = c_atoi(&input_buffer);\n            }\n            None => {\n                io.print_line(\"fgets() failed.\");\n            }\n        }\n    }\n    {\n        let mut buffer = [0i32; 10];\n        if data >= 0 && data < 10 {\n            buffer[data as usize] = 1;\n            /* Print the array values */\n            for i in 0..10 {\n                io.print_int_line(buffer[i]);\n            }\n        } else {\n            io.print_line(\"ERROR: Array index is out-of-bounds\");\n        }\n    }\n}\n\nfn good(io: &mut Io) {\n    good_g2b(io);\n    good_b2g(io);\n}\n\nfn main() {\n    let mut io = Io::new();\n    io.print_line(\"Calling good()...\");\n    good(&mut io);\n    io.print_line(\"Finished good()\");\n    io.print_line(\"Calling bad()...\");\n    bad(&mut io);\n    io.print_line(\"Finished bad()\");\n    let _ = io.stdout.flush();\n}\n","numLines":261,"startLine":1,"totalLines":261}}}
