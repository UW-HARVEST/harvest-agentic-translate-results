 io = Io::new();\n    io.print_int_line(int_number);\n    io.flush();\n}\n\n/// `void bad()`\n#[no_mangle]\npub extern \"C\" fn bad() {\n    let mut io = Io::new();\n    imp::bad(&mut io);\n    io.flush();\n}\n\n/// `void good()`\n#[no_mangle]\npub extern \"C\" fn good() {\n    let mut io = Io::new();\n    imp::good(&mut io);\n    io.flush();\n}\n\n/// `int main(int argc, char * argv[])`\n///\n/// `main` has external linkage in the C translation unit and so appears in the\n/// shared object's dynamic symbol table; it is exported here for parity.  `argc`\n/// and `argv` are unused by the C body.\n#[no_mangle]\npub extern \"C\" fn main(_argc: c_int, _argv: *const *const c_char) -> c_int {\n    let mut io = Io::new();\n    let rc = imp::run_main(&mut io);\n    io.flush();\n    rc\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5489,"cache_read_input_tokens":65444,"cache_creation":{"ephemeral_5m_input_tokens":5489,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6de6788a-c8a8-4554-8fe2-4313825db3b2","uuid":"71d6ba7b-87f0-45de-9b9c-371f496dec85","timestamp":"2026-08-18T00:18:39.257Z"}
