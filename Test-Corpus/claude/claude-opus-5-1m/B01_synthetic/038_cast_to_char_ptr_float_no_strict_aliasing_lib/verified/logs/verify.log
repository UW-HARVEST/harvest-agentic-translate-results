{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RzFnv6xjbz1Fux9fih7Bne","type":"tool_result","content":"296\t///   row 22) and the lowercase-hex character set,\n297\t/// * cross-checks the C output against an independent model of\n298\t///   `printf(\"%02x\")` over the argument's object representation, which would\n299\t///   catch a harness bug (e.g. a value mangled on its way through the FFI call)\n300\t///   masking a real divergence.\n301\t#[track_caller]\n302\tfn assert_same(row: &str, bits: &[u32]) {\n303\t    assert!(!bits.is_empty(), \"{row}: empty input list\");\n304\t    let c_out = capture_c(bits);\n305\t    let r_out = capture_rust(bits);\n306\t\n307\t    assert_eq!(\n308\t        c_out.len(),\n309\t        bits.len() * REC,\n310\t        \"{row}: C emitted {} bytes for {} calls, expected {} (9 per call)\",\n311\t        c_out.len(),\n312\t        bits.len(),\n313\t        bits.len() * REC\n314\t    );\n315\t    assert_eq!(\n316\t        r_out.len(),\n317\t        c_out.len(),\n318\t        \"{row}: Rust emitted {} bytes but C emitted {}\",\n319\t        r_out.len(),\n320\t        c_out.len()\n321\t    );\n322\t\n323\t    for (i, &b) in bits.iter().enumerate() {\n324\t        let c_rec = &c_out[i * REC..(i + 1) * REC];\n325\t        let r_rec = &r_out[i * REC..(i + 1) * REC];\n326\t        assert_eq!(\n327\t            c_rec,\n328\t            r_rec,\n329\t            \"{row}: divergence at index {i} for input bits {b:#010x} \\\n330\t             (f32 {:?}): C={:?} Rust={:?}\",\n331\t            f32::from_bits(b),\n332\t            show(c_rec),\n333\t            show(r_rec)\n334\t        );\n335\t        // framing / charset invariant\n336\t        assert_eq!(c_rec[8], b'\\n', \"{row}: record {i} not newline-terminated\");\n337\t        assert!(\n338\t            c_rec[..8].iter().all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(c)),\n339\t            \"{row}: record {i} is not 8 lowercase hex digits: {:?}\",\n340\t            show(c_rec)\n341\t        );\n342\t        assert_eq!(\n343\t            c_rec,\n344\t            model_record(b).as_bytes(),\n345\t            \"{row}: harness model disagrees with C at index {i} for {b:#010x} \\\n346\t             (argument mangled in transit?)\"\n347\t        );\n348\t    }\n349\t}\n350\t\n351\t// ---------------------------------------------------------------------------\n352\t// deterministic PRNG (SplitMix64) -- fixed seed for reproducibility\n353\t// ---------------------------------------------------------------------------\n354\t\n355\tconst SEED: u64 = 0x5EED_C0FF_EE00_0001;\n356\t\n357\tstruct Rng(u64);\n358\t\n359\timpl Rng {\n360\t    fn new() -> Self {\n361\t        Rng(SEED)\n362\t    }\n363\t    fn next_u64(&mut self) -> u64 {\n364\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n365\t        let mut z = self.0;"}]},"parent_tool_use_id":null,"session_id":"1b4c23cf-76e2-454f-8a84-8d4383224b9e","uuid":"3d9180aa-777c-4667-9315-41f22ac9035e","timestamp":"2026-08-18T11:25:20.805Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-eVa0F8/translated_rust/tests/differential.rs","content":"///   row 22) and the lowercase-hex character set,\n/// * cross-checks the C output against an independent model of\n///   `printf(\"%02x\")` over the argument's object representation, which would\n///   catch a harness bug (e.g. a value mangled on its way through the FFI call)\n///   masking a real divergence.\n#[track_caller]\nfn assert_same(row: &str, bits: &[u32]) {\n    assert!(!bits.is_empty(), \"{row}: empty input list\");\n    let c_out = capture_c(bits);\n    let r_out = capture_rust(bits);\n\n    assert_eq!(\n        c_out.len(),\n        bits.len() * REC,\n        \"{row}: C emitted {} bytes for {} calls, expected {} (9 per call)\",\n        c_out.len(),\n        bits.len(),\n        bits.len() * REC\n    );\n    assert_eq!(\n        r_out.len(),\n        c_out.len(),\n        \"{row}: Rust emitted {} bytes but C emitted {}\",\n        r_out.len(),\n        c_out.len()\n    );\n\n    for (i, &b) in bits.iter().enumerate() {\n        let c_rec = &c_out[i * REC..(i + 1) * REC];\n        let r_rec = &r_out[i * REC..(i + 1) * REC];\n        assert_eq!(\n            c_rec,\n            r_rec,\n            \"{row}: divergence at index {i} for input bits {b:#010x} \\\n             (f32 {:?}): C={:?} Rust={:?}\",\n            f32::from_bits(b),\n            show(c_rec),\n            show(r_rec)\n        );\n        // framing / charset invariant\n        assert_eq!(c_rec[8], b'\\n', \"{row}: record {i} not newline-terminated\");\n        assert!(\n            c_rec[..8].iter().all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(c)),\n            \"{row}: record {i} is not 8 lowercase hex digits: {:?}\",\n            show(c_rec)\n        );\n        assert_eq!(\n            c_rec,\n            model_record(b).as_bytes(),\n            \"{row}: harness model disagrees with C at index {i} for {b:#010x} \\\n             (argument mangled in transit?)\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// deterministic PRNG (SplitMix64) -- fixed seed for reproducibility\n// ---------------------------------------------------------------------------\n\nconst SEED: u64 = 0x5EED_C0FF_EE00_0001;\n\nstruct Rng(u64);\n\nimpl Rng {\n    fn new() -> Self {\n        Rng(SEED)\n    }\n    fn next_u64(&mut self) -> u64 {\n        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n        let mut z = self.0;","numLines":70,"startLine":296,"totalLines":903}}}
