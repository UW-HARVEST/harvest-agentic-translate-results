-> c_int;\n37\t}\n38\t\n39\t/// `static void print_hex(unsigned char *p, int len)`\n40\t///\n41\t/// Internal (non-exported) helper, matching the C `static` function: prints\n42\t/// each byte as two lowercase hex digits, then a newline.\n43\tunsafe fn print_hex(p: *const c_uchar, len: c_int) {\n44\t    let mut i: c_int = 0;\n45\t    while i < len {\n46\t        // printf(\"%02x\", p[i]) -- `unsigned char` is promoted to `int`.\n47\t        unsafe {\n48\t            printf(c\"%02x\".as_ptr(), c_int::from(*p.offset(i as isize)));\n49\t        }\n50\t        i += 1;\n51\t    }\n52\t    // printf(\"\\n\") -- a single-character format string; the C compiler lowers\n53\t    // this to putchar('\\n'), which is what the C .so actually calls.\n54\t    unsafe {\n55\t        putchar(c_int::from(b'\\n'));\n56\t    }\n57\t}\n58\t\n59\t/// `void driver(float x)`\n60\t///\n61\t/// Copies the raw object representation of `x` into a local byte buffer and\n62\t/// dumps it as hex (in memory / target byte order, i.e. little-endian on x86).\n63\t#[unsafe(no_mangle)]\n64\tpub unsafe extern \"C\" fn driver(x: c_float) {\n65\t    // char raw[sizeof(x)]; memcpy(raw, &x, sizeof(x));\n66\t    let raw: [c_char; core::mem::size_of::<c_float>()] =\n67\t        unsafe { core::mem::transmute(x.to_bits().to_ne_bytes()) };\n68\t\n69\t    // print_hex((unsigned char *)raw, sizeof(raw));\n70\t    unsafe {\n71\t        print_hex(raw.as_ptr() as *const c_uchar, raw.len() as c_int);\n72\t    }\n73\t}\n74\t"}]},"parent_tool_use_id":null,"session_id":"1b4c23cf-76e2-454f-8a84-8d4383224b9e","uuid":"1de3f9f5-c33c-4893-b082-cbf810db2f19","timestamp":"2026-08-18T11:15:03.441Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-eVa0F8/translated_rust/src/lib.rs","content":"// Rust translation of c_src/src/driver.c (+ c_src/include/driver.h).\n//\n// Original copyright notice from the C sources:\n//\n// Copyright 2025 MIT Lincoln Laboratory\n// Permission is her