ht: $caught   equivalent: $equivalent   missed: $missed   broken patterns: $broken ===\"","+[ \"$missed\" -eq 0 ] && [ \"$broken\" -eq 0 ]"]}],"originalFile":"#!/usr/bin/env bash\n# Sensitivity check for the differential suite.\n#\n# Each mutation deliberately breaks the Rust translation in a way the C\n# reference does not share; the named test target MUST then fail.  A mutation\n# that the suite does not catch is a coverage hole.\n#\n# Usage: ./mutation_check.sh\nset -u\n\nROOT=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nSRC=\"$ROOT/src/prog.rs\"\nLIB=\"$ROOT/src/lib.rs\"\nBACKUP_DIR=\"$(mktemp -d)\"\ncp \"$SRC\" \"$BACKUP_DIR/prog.rs\"\ncp \"$LIB\" \"$BACKUP_DIR/lib.rs\"\n\nrestore() {\n  cp \"$BACKUP_DIR/prog.rs\" \"$SRC\"\n  cp \"$BACKUP_DIR/lib.rs\" \"$LIB\"\n}\ntrap 'restore; rm -rf \"$BACKUP_DIR\"' EXIT\n\npass=0\nfail=0\n\n# $1 description, $2 test target, $3.. sed expressions applied to $SRC\nmutate() {\n  local desc=\"$1\"; shift\n  local target=\"$1\"; shift\n  local file=\"$1\"; shift\n  restore\n  for expr in \"$@\"; do\n    perl -0pi -e \"$expr\" \"$file\"\n  done\n  if ! diff -q \"$BACKUP_DIR/$(basename \"$file\")\" \"$file\" >/dev/null; then\n    :\n  else\n    echo \"SKIP  $desc — mutation did not change the source (pattern drift)\"\n    fail=$((fail + 1))\n    return\n  fi\n  if timeout 600 cargo test --offline --quiet --test \"$target\" >/dev/null 2>&1; then\n    echo \"MISSED  $desc — '$target' still passed!\"\n    fail=$((fail + 1))\n  else\n    echo \"caught  $desc  (by $target)\"\n    pass=$((pass + 1))\n  fi\n}\n\necho \"=== mutation sensitivity check ===\"\n\nmutate \"helperBad returns a live string instead of NULL\" ffi_diff \"$SRC\" \\\n  's/let _ = char_string; \\/\\/ written to the stack frame, then abandoned\\n    None/return Some(b\"helperBad string\");/'\n\nmutate \"helperGood1 loses its trailing-NUL trim (prints the NUL byte)\" ffi_diff \"$SRC\" \\\n  's/Some\\(&CHAR_STRING\\[\\.\\.CHAR_STRING\\.len\\(\\) - 1\\]\\)/Some(\\&CHAR_STRING[..])/'\n\nmutate \"printLine emits CRLF instead of LF\" ffi_diff \"$SRC\" \\\n  's/out\\.write_all\\(b\"\\\\n\"\\)/out.write_all(b\"\\\\r\\\\n\")/'\n\nmutate \"printLine validates UTF-8 (lossy) instead of passing bytes through\" ffi_diff \"$SRC\" \\\n  's/let _ = out\\.write_all\\(line\\);/let _ = out.write_all(String::from_utf8_lossy(line).as_bytes());/'\n\nmutate \"printLine drops its NULL check\" ffi_diff \"$LIB\" \\\n  's/if line\\.is_null\\(\\) \\{\\n        return;\\n    \\}/if false { return; }/'\n\nmutate \"isspace() forgets the vertical tab\" main_diff \"$SRC\" \\\n  's/c == 0x0B \\|\\| //'\n\nmutate \"isspace() forgets the form feed\" main_diff \"$SRC\" \\\n  's/c == 0x0C \\|\\| //'\n\nmutate \"strtol saturates negatives to LONG_MAX\" main_diff \"$SRC\" \\\n  's/if negative \\{\\n            i64::MIN\\n        \\} else \\{\\n            i64::MAX\\n        \\}/i64::MAX/'\n\nmutate \"the long->int narrowing is replaced by saturation\" main_diff \"$SRC\" \\\n  's/Some\\(strtol_base10\\(&charbuf\\) as i32\\)/Some(strtol_base10(\\&charbuf).clamp(i32::MIN as i64, i32::MAX as i64) as i32)/'\n\nmutate \"a lone sign is accepted as the value 0\" main_diff \"$SRC\" \\\n  's/\\|\\| \\(charbuf\\.len\\(\\) == 1 && \\(charbuf\\[0\\] == b.\\+. \\|\\| charbuf\\[0\\] == b.-.\\)\\)//'\n\nmutate \"the 0x prefix is honored (base 16)\" main_diff \"$SRC\" \\\n  's/\\/\\/ base is 10: not 0 \\(would become 16\\) and not 16, so no action\\./c = input.inchar();/'\n\nmutate \"scanf does not skip leading whitespace\" main_diff \"$SRC\" \\\n  's/if !is_space\\(c\\) \\{\\n            break;\\n        \\}/break;/'\n\nmutate \"matching failure assigns 0 through the pointer anyway\" main_diff \"$SRC\" \\\n  's/return None; \\/\\/ matching failure/return Some(0);/'\n\nmutate \"the value test becomes x > 0 instead of x != 0\" main_diff \"$SRC\" \\\n  's/if x != 0 \\{/if x > 0 {/'\n\nmutate \"the pushed-back byte is dropped\" main_diff \"$SRC\" \\\n  's/self\\.pushed_back = Some\\(c as u8\\);/let _ = c;/'\n\nmutate \"digits are collected without an overflow guard\" main_diff \"$SRC\" \\\n  's/Some\\(v\\) if v <= cutoff => acc = v,/Some(v) => acc = v,/'\n\nrestore\necho\necho \"=== caught: $pass   missed/skipped: $fail ===\"\n[ \"$fail\" -eq 0 ]\n","userModified":false}}
