diff\"\npath = \"tests/ffi_diff.rs\"\nharness = false\n\n[[test]]\nname = \"main_diff\"\npath = \"tests/main_diff.rs\"\n\n[[test]]\nname = \"symbol_parity\"\npath = \"tests/symbol_parity.rs\"\n\n[[test]]\nname = \"sweep\"\npath = \"tests/sweep.rs\"\n\n[features]\n# This crate has no conditional compilation: the C build (see\n# c_src/CMakeLists.txt) defines no macros and offers no options, so the only\n# valid configuration is the empty/default feature set.\ndefault = []\n\n[profile.release]\npanic = \"abort\"\n\n[workspace]\n","structuredPatch":[{"oldStart":49,"oldLines":6,"newStart":49,"newLines":10,"lines":[" name = \"sweep\""," path = \"tests/sweep.rs\""," ","+[[test]]","+name = \"c_opt_levels\"","+path = \"tests/c_opt_levels.rs\"","+"," [features]"," # This crate has no conditional compilation: the C build (see"," # c_src/CMakeLists.txt) defines no macros and offers no options, so the only"]}],"userModified":false,"replaceAll":false}}
