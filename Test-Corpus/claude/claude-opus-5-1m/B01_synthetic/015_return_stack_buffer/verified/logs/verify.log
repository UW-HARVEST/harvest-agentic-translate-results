t]]\nname = \"ffi_diff\"\npath = \"tests/ffi_diff.rs\"\nharness = false\n\n[[test]]\nname = \"main_diff\"\npath = \"tests/main_diff.rs\"\n\n[[test]]\nname = \"symbol_parity\"\npath = \"tests/symbol_parity.rs\"\n\n[features]\n# This crate has no conditional compilation: the C build (see\n# c_src/CMakeLists.txt) defines no macros and offers no options, so the only\n# valid configuration is the empty/default feature set.\ndefault = []\n\n[profile.release]\npanic = \"abort\"\n\n[workspace]\n","structuredPatch":[{"oldStart":45,"oldLines":6,"newStart":45,"newLines":10,"lines":[" name = \"symbol_parity\""," path = \"tests/symbol_parity.rs\""," ","+[[test]]","+name = \"sweep\"","+path = \"tests/sweep.rs\"","+"," [features]"," # This crate has no conditional compilation: the C build (see"," # c_src/CMakeLists.txt) defines no macros and offers no options, so the only"]}],"userModified":false,"replaceAll":false}}
