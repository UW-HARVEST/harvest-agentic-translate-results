                c.stdin(unsafe { Stdio::from_raw_fd(fd) });\n            }),\n        ),\n    ];\n\n    for (name, setup) in &cases {\n        let c = run(&c_exe, setup.as_ref());\n        let r = run(&r_exe, setup.as_ref());\n        assert_same(\"row41\", &format!(\"{name} [C vs contract]\"), b\"0\\\\n\", &c.stdout);\n        assert_outcomes(\"row41\", name, &c, &r);\n    }\n}\n\n'''\nanchor = '// ---------------------------------------------------------------------------\\n// mini harness'\ns = s.replace(anchor, new_row + anchor, 1)\ns = s.replace('        (\"row40_stdout_devnull\", row40_stdout_devnull),',\n              '        (\"row40_stdout_devnull\", row40_stdout_devnull),\\n'\n              '        (\"row41_stdin_descriptor_shapes\", row41_stdin_descriptor_shapes),', 1)\nopen(p,'w').write(s)\nPY\ntimeout 600 cargo test --offline --test subprocess_diff 2>&1 | tail -20","description":"Add stdin descriptor shape row and run"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":417,"cache_read_input_tokens":139769,"cache_creation":{"ephemeral_5m_input_tokens":417,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"86572b93-40a6-455d-b14b-89ede999baea","uuid":"494fc107-f2fc-4d44-9909-93b5b7e1869e","timestamp":"2026-08-18T03:30:05.568Z"}
