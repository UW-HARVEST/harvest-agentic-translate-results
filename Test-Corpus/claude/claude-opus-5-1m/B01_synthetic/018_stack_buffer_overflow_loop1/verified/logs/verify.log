   }\n44\t    }\n45\t\n46\t    fn next_byte(&mut self) -> Option<u8> {\n47\t        if let Some(b) = self.pushed.take() {\n48\t            return Some(b);\n49\t        }\n50\t        if self.eof {\n51\t            return None;\n52\t        }\n53\t        let mut buf = [0u8; 1];\n54\t        match self.stdin.read(&mut buf) {\n55\t            Ok(1) => Some(buf[0]),\n56\t            _ => {\n57\t                self.eof = true;\n58\t                None\n59\t            }\n60\t        }\n61\t    }\n62\t\n63\t    fn push_back(&mut self, b: u8) {\n64\t        self.pushed = Some(b);\n65\t    }\n66\t\n67\t    /// Emulates `scanf(\"%d\", &out)`.\n68\t    ///\n69\t    /// Returns the number of successfully assigned items (1 on success,\n70\t    /// 0 on matching failure, -1 (EOF) if input ends before any conversion).\n71\t    /// `out` is left untouched unless a value is assigned, exactly like scanf.\n72\t    fn scan_int(&mut self, out: &mut i32) -> i32 {\n73\t        // Skip leading whitespace.\n74\t        let mut cur;\n75\t        loop {\n76\t            match self.next_byte() {\n77\t                Some(b) if is_space(b) => continue,\n78\t                Some(b) => {\n79\t                    cur = Some(b);\n80\t                    break;\n81\t                }\n82\t                None => return -1, // EOF before any input\n83\t            }\n84\t        }\n85\t\n86\t        let mut negative = false;\n87\t        if let Some(b) = cur {\n88\t            if b == b'+' || b == b'-' {\n89\t                negative = b == b'-';\n90\t                cur = self.next_byte();\n91\t            }\n92\t        }\n93\t\n94\t        let mut digits = 0usize;\n95\t        // Accumulate in i64 with saturation, then truncate to int, which is how\n96\t        // glibc behaves (strtol saturates at LONG_MAX/LONG_MIN, the result is\n97\t        // then stored into an int).\n98\t        let mut acc: i128 = 0;\n99\t        let saturated_lo: i128 = i64::MIN as i128;\n100\t        let saturated_hi: i128 = i64::MAX as i128;\n101\t\n102\t        while let Some(b) = cur {\n103\t            if !b.is_ascii_digit() {\n104\t                break;\n105\t            }\n106\t            digits += 1;\n107\t            if acc <= saturated_hi {\n108\t                acc = acc * 10 + i128::from(b - b'0');\n109\t                if acc > saturated_hi + 1 {\n110\t                    acc = saturated_hi + 1;\n111\t                }\n112\t            }\n113\t            cur = self.next_byte();\n114\t        }\n115\t\n116\t        // Push back the character that terminated the conversion.\n117\t        if let Some(b) = cur {\n118\t            self.push_back(b);\n119\t        }\n120\t\n121\t        if digits == 0 {\n122\t            // Matching failure: nothing assigned.\n123\t            return 0;\n124\t        }\n125\t\n126\t        let value: i128 = if negative { -acc } else { acc };\n127\t        let clamped: i64 = if value > saturated_hi {\n128\t            i64::MAX\n129\t        } else if value < saturated_lo {\n130\t            i64::MIN\n131\t        } else {\n132\t            value as i64\n133\t        };\n134\t\n135\t        *out = clamped as i32; // truncating conversion, as in C\n136\t        1\n137\t    }\n138\t}\n139\t\n140\tfn is_space(b: u8) -> bool {\n141\t    matches!(b, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n142\t}\n143\t\n144\t#[allow(dead_code)]\n145\tfn print_line(line: Option<&str>) {\n146\t    if let Some(line) = line {\n147\t        println!(\"{}\", line);\n148\t    }\n149\t}\n150\t\n151\tfn print_int_line(int_number: i32) {\n152\t    println!(\"{}\", int_number);\n153\t}\n154\t\n155\tfn bad() {\n156\t    // The C code allocates only 10 bytes but writes 10 ints (40 bytes),\n157\t    // overflowing the buffer. The values copied are all zeros and only\n158\t    // data[0] is read back, so the observable output is unchanged; it is\n159\t    // modeled here with a properly sized safe buffer.\n160\t    let mut data = vec![0i32; 10];\n161\t    {\n162\t  