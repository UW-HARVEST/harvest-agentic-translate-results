{\n    print_hex(&x.to_ne_bytes());\n}\n\npub fn run() {\n    let mut rdr = ByteReader::new();\n    let x: f32 = scan_float(&mut rdr).unwrap_or(0.0f32);\n    driver(x);\n}\n\n/// Translation of the C `int main()`, exported under its C ABI name.\n///\n/// `c_src/src/main.c` is a program translation unit, so when it is compiled\n/// with `-shared` its `main` becomes a dynamic export of the resulting\n/// `.so`. This mirrors that export exactly so that the symbol diff between\n/// the C `.so` and the Rust `cdylib` is empty.\n///\n/// It is behind the `c_main` feature because a Rust `[[bin]]` already emits a\n/// `main` symbol of its own; with the feature enabled `src/main.rs` becomes\n/// `#![no_main]` and this function *is* the program's entry point, so the\n/// executable keeps working identically.\n#[cfg(feature = \"c_main\")]\n#[no_mangle]\npub extern \"C\" fn main() -> core::ffi::c_int {\n    run();\n    0\n}\n","structuredPatch":[{"oldStart":534,"oldLines":7,"newStart":534,"newLines":9,"lines":[" /// `main` symbol of its own; with the feature enabled `src/main.rs` becomes"," /// `#![no_main]` and this function *is* the program's entry point, so the"," /// executable keeps working identically.","-#[cfg(feature = \"c_main\")]","+/// `not(test)` because the libtest harness generates an entry point of its own;","+/// exporting a second `main` would make the unit-test binary unlinkable.","+#[cfg(all(feature = \"c_main\", not(test)))]"," #[no_mangle]"," pub extern \"C\" fn main() -> core::ffi::c_int {","     run();"]}],"userModified":false,"replaceAll":false}}
