\n47\t                Ok(0) => return None,\n48\t                Ok(_) => return Some(b[0]),\n49\t                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n50\t                Err(_) => return None,\n51\t            }\n52\t        }\n53\t    }\n54\t}\n55\t\n56\t/// `isspace()` in the \"C\" locale.\n57\tfn is_space(c: u8) -> bool {\n58\t    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n59\t}\n60\t\n61\tfn lower(c: u8) -> u8 {\n62\t    c.to_ascii_lowercase()\n63\t}\n64\t\n65\tfn hex_val(c: u8) -> Option<u32> {\n66\t    match c {\n67\t        b'0'..=b'9' => Some((c - b'0') as u32),\n68\t        b'a'..=b'f' => Some((c - b'a' + 10) as u32),\n69\t        b'A'..=b'F' => Some((c - b'A' + 10) as u32),\n70\t        _ => None,\n71\t    }\n72\t}\n73\t\n74\tfn signed_zero(neg: bool) -> f32 {\n75\t    if neg {\n76\t        -0.0f32\n77\t    } else {\n78\t        0.0f32\n79\t    }\n80\t}\n81\t\n82\tfn signed_inf(neg: bool) -> f32 {\n83\t    if neg {\n84\t        f32::NEG_INFINITY\n85\t    } else {\n86\t        f32::INFINITY\n87\t    }\n88\t}\n89\t\n90\t/// Quiet NaN exactly as produced by glibc's `strtof` (\"nan\" / \"-nan\").\n91\tfn signed_nan(neg: bool) -> f32 {\n92\t    if neg {\n93\t        f32::from_bits(0xffc0_0000)\n94\t    } else {\n95\t        f32::from_bits(0x7fc0_0000)\n96\t    }\n97\t}\n98\t\n99\t// ---------------------------------------------------------------------------\n100\t// scanf(\"%f\") emulation\n101\t// ---------------------------------------------------------------------------\n102\t\n103\t/// Collects the characters accepted by the `%f` conversion and converts them.\n104\t///\n105\t/// Returns `None` for a matching/input failure, in which case the C code leaves\n106\t/// its `float` untouched.\n107\tfn scan_float(rdr: &mut ByteReader) -> Option<f32> {\n108\t    // Skip leading whitespace.  EOF while skipping is an input failure.\n109\t    let mut c = loop {\n110\t        match rdr.getc() {\n111\t            None => r