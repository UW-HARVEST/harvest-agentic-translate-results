stride: u32) -> impl Iterator<Item = f32> {\n    (0u64..)\n        .map(move |i| i.wrapping_mul(stride as u64))\n        .take_while(|&x| x <= u32::MAX as u64)\n        .map(|x| f32::from_bits(x as u32))\n}\n","structuredPatch":[{"oldStart":320,"oldLines":7,"newStart":320,"newLines":8,"lines":["         if rng.chance(6, 10) {","             s.push(if rng.chance(1, 2) { 'e' } else { 'E' });","             s.push_str(*rng.pick(&[\"\", \"+\", \"-\"]));","-            s.push_str(&rand_str(&mut rng, DIGITS, rng.below(5)));","+            let elen = rng.below(5);","+            s.push_str(&rand_str(&mut rng, DIGITS, elen));","         }","         out.push(s);","     }"]}],"userModified":false,"replaceAll":false,"staleRecovered":true}}
