e(c_strtof(&buf));\n175\t    }\n176\t\n177\t    // Ordinary number.\n178\t    let mut got_digit = false;\n179\t    let mut got_dot = false;\n180\t    let mut got_e = false;\n181\t    let mut hexa = false;\n182\t    let mut exp_char = b'e';\n183\t\n184\t    let mut cur = Some(c);\n185\t\n186\t    if c == b'0' {\n187\t        buf.push(c);\n188\t        got_digit = true;\n189\t        cur = rdr.getc();\n190\t        if let Some(ch) = cur {\n191\t            if lower(ch) == b'x' {\n192\t                buf.push(ch);\n193\t                hexa = true;\n194\t                exp_char = b'p';\n195\t                got_digit = false;\n196\t                cur = rdr.getc();\n197\t            }\n198\t        }\n199\t    }\n200\t\n201\t    while let Some(ch) = cur {\n202\t        if ch.is_ascii_digit() {\n203\t            buf.push(ch);\n204\t            got_digit = true;\n205\t        } else if !got_e && hexa && hex_val(ch).is_some() {\n206\t            buf.push(ch);\n207\t            got_digit = true;\n208\t        } else if got_e && buf.last() == Some(&exp_char) && (ch == b'-' || ch == b'+') {\n209\t            buf.push(ch);\n210\t        } else if got_digit && !got_e && lower(ch) == exp_char {\n211\t            // glibc stores the lowercase exponent character.\n212\t            buf.push(exp_char);\n213\t            got_e = true;\n214\t            got_dot = true;\n215\t        } else if ch == b'.' && !got_dot {\n216\t            buf.push(ch);\n217\t            got_dot = true;\n218\t        } else {\n219\t            break;\n220\t        }\n221\t        cur = rdr.getc();\n222\t    }\n223\t\n224\t    // Nothing usable read, or only the \"0x\" prefix of a hex float.\n225\t    if buf.len() == sign_len {\n226\t        return None;\n227\t    }\n228\t    if hexa && buf.len() == sign_len + 2 {\n229\t        return None;\n230\t    }\n231\t\n232\t    Some(c_strtof(&buf))\n233\t}\n234\t\n235\t// ---------------------------------------------------------------------------\n236\t// strtof(