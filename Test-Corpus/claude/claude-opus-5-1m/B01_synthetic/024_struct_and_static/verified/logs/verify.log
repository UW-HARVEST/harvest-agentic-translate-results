e->bedrooms += extra_bedrooms\n49\t    house.bedrooms = house.bedrooms.wrapping_add(extra_bedrooms);\n50\t}\n51\t\n52\tfn the_house() -> &'static mut House {\n53\t    // Single-threaded program; equivalent to C's access of the global object.\n54\t    unsafe { &mut *std::ptr::addr_of_mut!(THE_HOUSE) }\n55\t}\n56\t\n57\tfn add_floor_to_the_house() {\n58\t    add_floor(the_house());\n59\t}\n60\t\n61\tfn print_the_house(out: &mut dyn Write) {\n62\t    let h = *the_house();\n63\t    // printf(\"The house has %d floors, %d bedrooms, and %.1f bathrooms\\n\", ...)\n64\t    let _ = write!(\n65\t        out,\n66\t        \"The house has {} floors, {} bedrooms, and {} bathrooms\\n\",\n67\t        h.floors,\n68\t        h.bedrooms,\n69\t        format_f64_1(h.bathrooms)\n70\t    );\n71\t}\n72\t\n73\t/// Formats a double the way C's `%.1f` does.\n74\tfn format_f64_1(v: f64) -> String {\n75\t    if v.is_nan() {\n76\t        // C prints \"nan\" / \"-nan\"\n77\t        return if v.is_sign_negative() {\n78\t            \"-nan\".to_string()\n79\t        } else {\n80\t            \"nan\".to_string()\n81\t        };\n82\t    }\n83\t    if v.is_infinite() {\n84\t        return if v < 0.0 {\n85\t            \"-inf\".to_string()\n86\t        } else {\n87\t            \"inf\".to_string()\n88\t        };\n89\t    }\n90\t    // Rust's {:.1} matches glibc's round-half-to-even on the exact binary value.\n91\t    format!(\"{:.1}\", v)\n92\t}\n93\t\n94\tfn run(out: &mut dyn Write, extra_bedrooms: i32) {\n95\t    print_the_house(out);\n96\t    add_floor_to_the_house();\n97\t    print_the_house(out);\n98\t    the_house().bathrooms += 1.0;\n99\t    print_the_house(out);\n100\t    add_bedrooms(the_house(), extra_bedrooms);\n101\t    print_the_house(out);\n102\t}\n103\t\n104\t/// Emulates `scanf(\"%d\", &x)`: skips leading whitespace (including newlines),\n105\t/// accepts an optional sign, then decimal digits. On matching failure the\n106\t/// destination is left untouched.\n107\tfn scanf_i32(input: &[u8], pos: &mut usize) -> Option<i32> {\n108\t    let mut i = *pos;\n109\t\n110\t    // Skip whitespace, as the %d conversion does.\n111\t    while i < input.len() && matches!(input[i], b' ' | b'\\t' | b'\\n' | b'\\x0b' | b'\\x0c' | b'\\r') {\n112\t        i += 1;\n113\t    }\n114\t    if i >= input.len() {\n115\t        *pos = i;\n116\t        return None;\n117\t    }\n118\t\n119\t    let start = i;\n120\t    let mut negative = false;\n121\t    if input[i] == b'+' || input[i] == b'-' {\n122\t        negative = input[i] == b'-';\n123\t        i += 1;\n124\t    }\n125\t\n126\t    let digits_start = i;\n127\t    let mut acc: i64 = 0;\n128\t    let mut overflow = false;\n129\t    while i < input.len() && input[i].is_ascii_digit() {\n130\t        let d = i64::from(input[i] - b'0');\n131\t        if !overflow {\n132\t            match acc.checked_mul(10).and_then(|a| a.checked_add(d)) {\n133\t                Some(next) => acc = next,\n134\t                None => overflow = true,\n135\t            }\n136\t        }\n137\t        i += 1;\n138\t    }\n139\t\n140\t    if i == digits_start {\n141\t        // No digits consumed: matching failure, nothing is stored.\n142\t        *pos = start;\n143\t        return None;\n144\t    }\n145\t\n146\t    *pos = i;\n147\t\n148\t    // glibc parses with strtol and stores the (possibly saturated) long\n149\t    // truncated to int.\n150\t    let value: i64 = if overflow {\n151\t        if negative {\n152\t            i64::MIN\n153\t        } else {\n154\t            i64::MAX\n155\t        }\n156\t    } else if negative {\n157\t        acc.wrapping_neg()\n158\t    } else {\n159\t        acc\n160\t    };\n161\t\n162\t    Some(value as i32)\n163\t}\n164\t\n165\tfn main() {\n166\t    let mut input = Vec::new();\n167\t    let _ = std::io::stdin().read_to_end(&mut input);\n168\t    let mut pos = 0usize;\n169\t\n170\t    let mut x: i32 = 0;\n171\t    if let Some(v) = scanf_i32(&input, &mut pos) {\n172\t        x = v;\n173\t    }\n174\t\n175\t    let stdout = std::io::stdout();\n176\t    let mut out = std::io::BufWriter::new(stdout.lock());\n177\t    run(&mut out, x);\n178\t    run(&mut out, x);\n179\t    let _ = out.flush();\n180\t}\n181\t"}]},"parent_tool_use_id":null,"session_id":"21d9146d-e5e5-426f-a1e3-f8f82e94deb9","uuid":"48f12e6b-f8eb-463c-83b1-2a673363dec7","timestamp":"2026-08-18T05:07:42.445Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-023p2n/translated_rust/src/main.rs","content":"// Rust translation of c_src/src/main.c\n//\n// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\nuse std::io::{Read, Write};\n\n#[derive(Clone, Copy)]\nstruct House {\n    floors: i32,\n    bedrooms: i32,\n    bathrooms: f64,\n}\n\n/// Mirrors the C file-scope `static house_t the_house`.\nstatic mut THE_HOUSE: House = House {\n    floors: 2,\n    bedrooms: 5,\n    bathrooms: 2.5,\n};\n\nfn add_floor(house: &mut House) {\n    // C: house->floors++\n    house.floors = house.floors.wrapping_add(1);\n}\n\nfn add_bedrooms(house: &mut House, extra_bedrooms: i32) {\n    // C: house->bedrooms += extra_bedrooms\n    house.bedrooms = house.bedrooms.wrapping_add(extra_bedrooms);\n}\n\nfn the_house() -> &'static mut House {\n    // Single-threaded program; equivalent to C's access of the global object.\n    unsafe { &mut *std::ptr::addr_of_mut!(THE_HOUSE) }\n}\n\nfn add_floor_to_the_house() {\n    add_floor(the_house());\n}\n\nfn print_the_house(out: &mut dyn Write) {\n    let h = *the_house();\n    // printf(\"The house has %d floors, %d bedrooms, and %.1f bathrooms\\n\", ...)\n    let _ = write!(\n        out,\n        \"The house has {} floors, {} bedrooms, and {} bathrooms\\n\",\n        h.floors,\n        h.bedrooms,\n        format_f64_1(h.bathrooms)\n    );\n}\n\n/// Formats a double the way C's `%.1f` does.\nfn format_f64_1(v: f64) -> String {\n    if v.is_nan() {\n        // C prints \"nan\" / \"-nan\"\n        return if v.is_sign_negative() {\n            \"-nan\".to_string()\n        } else {\n            \"nan\".to_string()\n        };\n    }\n    if v.is_infinite() {\n        return if v < 0.0 {\n            \"-inf\".to_string()\n        } else {\n            \"inf\".to_string()\n        };\n    }\n    // Rust's {:.1} matches glibc's round-half-to-even on the exact binary value.\n    format!(\"{:.1}\", v)\n}\n\nfn run(out: &mut dyn Write, extra_bedrooms: i32) {\n    print_the_house(out);\n    add_floor_to_the_house();\n    print_the_house(out);\n    the_house().bathrooms += 1.0;\n    print_the_house(out);\n    add_bedrooms(the_house(), extra_bedrooms);\n    print_the_house(out);\n}\n\n/// Emulates `scanf(\"%d\", &x)`: skips leading whitespace (including newlines),\n/// accepts an optional sign, then decimal digits. On matching failure the\n/// destination is left untouched.\nfn scanf_i32(input: &[u8], pos: &mut usize) -> Option<i32> {\n    let mut i = *pos;\n\n    // Skip whitespace, as the %d conversion does.\n    while i < input.len() && matches!(input[i], b' ' | b'\\t' | b'\\n' | b'\\x0b' | b'\\x0c' | b'\\r') {\n        i += 1;\n    }\n    if i >= input.len() {\n        *pos = i;\n        return None;\n    }\n\n    let start = i;\n    let mut negative = false;\n    if input[i] == b'+' || input[i] == b'-' {\n        negative = input[i] == b'-';\n        i += 1;\n    }\n\n    let digits_start = i;\n    let mut acc: i64 = 0;\n    let mut overflow = false;\n    while i < input.len() && input[i].is_ascii_digit() {\n        let d = i64::from(input[i] - b'0');\n        if !overflow {\n            match acc.checked_mul(10).and_then(|a| a.checked_add(d)) {\n                Some(next) => acc = next,\n                None => overflow = true,\n            }\n        }\n        i += 1;\n    }\n\n    if i == digits_start {\n        // No digits consumed: matching failure, nothing is stored.\n        *pos = start;\n        return None;\n    }\n\n    *pos = i;\n\n    // glibc parses with strtol and stores the (possibly saturated) long\n    // truncated to int.\n    let value: i64 = if overflow {\n        if negative {\n            i64::MIN\n        } else {\n            i64::MAX\n        }\n    } else if negative {\n        acc.wrapping_neg()\n    } else {\n        acc\n    };\n\n    Some(value as i32)\n}\n\nfn main() {\n    let mut input = Vec::new();\n    let _ = std::io::stdin().read_to_end(&mut input);\n    let mut pos = 0usize;\n\n    let mut x: i32 = 0;\n    if let Some(v) = scanf_i32(&input, &mut pos) {\n        x = v;\n    }\n\n    let stdout = std::io::stdout();\n    let mut out = std::io::BufWriter::new(stdout.lock());\n    run(&mut out, x);\n    run(&mut out, x);\n    let _ = out.flush();\n}\n","numLines":181,"startLine":1,"totalLines":181}}}
