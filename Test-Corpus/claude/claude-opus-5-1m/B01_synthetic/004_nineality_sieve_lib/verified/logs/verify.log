  \"C child with closed stdout for sieve({val}) status {}\",","+            \"C child with closed stdout for sieve({val}) raw status {}\",","             cc.status","         );","         assert_eq!("]},{"oldStart":124,"oldLines":12,"newStart":140,"newLines":13,"lines":["             \"status differs with closed stdout for sieve({val}): C {} vs Rust {}\",","             cc.status, rr.status","         );","+        assert_eq!(cc.timed_out, rr.timed_out);","     }"," }"," "," /// E7: the signed-overflow boundary `[INT_MAX-7, INT_MAX]`. The shipped C build","-/// wraps to `INT_MIN` and keeps counting; Rust must wrap identically and must","-/// not panic. Compared as an output prefix in a forked child.","+/// wraps to `INT_MIN` and keeps counting; Rust must wrap identically and must not","+/// panic. Compared as an output prefix in a forked child."," #[test]"," fn e7_int_max_overflow_wraps() {","     let (c, r) = funcs();"]},{"oldStart":144,"oldLines":12,"newStart":161,"newLines":12,"lines":["         );","         assert_eq!(co.len(), ro.len(), \"prefix length differs for sieve({val})\");","         assert!(co == ro, \"overflow prefix differs for sieve({val})\");","-        // the wrap itself must be visible in the stream both times","-        let text = String::from_utf8_lossy(&co).into_owned();","+        // the wrap itself must be visible in both streams","+        let ctext = String::from_utf8_lossy(&co).into_owned();","         assert!(","-            text.contains(\"2147483647\\n-2147483648\\n\"),","+            ctext.contains(\"2147483647\\n-2147483648\\n\"),","             \"C did not wrap INT_MAX -> INT_MIN for sieve({val}); head={:?}\",","-            &text[..text.len().min(120)]","+            &ctext[..ctext.len().min(120)]","         );","         assert!(String::from_utf8_lossy(&ro).contains(\"2147483647\\n-2147483648\\n\"));","     }"]},{"oldStart":163,"oldLines":33,"newStart":180,"newLines":44,"lines":["     const WANT: usize = 8192;","     let co = child_prefix(c, i32::MIN, WANT);","     let ro = child_prefix(r, i32::MIN, WANT);","-    assert!(co.starts_with(b\"-2147483648\\n\"), \"C head: {:?}\", &co[..24]);","+    assert!(","+        co.starts_with(b\"-2147483648\\n\"),","+        \"C head: {:?}\",","+        String::from_utf8_lossy(&co[..co.len().min(24)])","+    );","     assert_eq!(co.len(), ro.len());","     assert!(co == ro, \"INT_MIN prefix differs\");"," }"," "," /// E9 / C18: out-of-range bits across the FFI boundary — the caller passes a"," /// 64-bit value whose high half is garbage; the `int` parameter must be the low","-/// 32 bits for both implementations (this is the FFI analogue of passing an","-/// out-of-range enum value: C accepts any bit pattern).","+/// 32 bits for both implementations. (This is the FFI analogue of passing an","+/// out-of-range enum value: a C API accepts any bit pattern.)"," #[test]"," fn e9_ffi_high_bits_ignored() {","     let (cw, rw) = funcs_wide();","     let (c, _) = funcs();","+    const CAP1: usize = 1 << 20;","     let cases: [(i64, i32); 6] = [","         (0x7FFF_FFFF_0000_0003u64 as i64, 3),","-        (-1i64, -1),                                  // 0xFFFF..FFFF -> -1","-        (0x0000_0001_0000_0009u64 as i64, 9),         // high bit set, low = 9","-        (0xDEAD_BEEF_0000_0000u64 as i64, 0),         // low half zero","-        (0x1234_5678_FFFF_FFF7u64 as i64, -9),        // low half = -9","+        (-1i64, -1), // 0xFFFF_FFFF_FFFF_FFFF -> -1","+        (0x0000_0001_0000_0009u64 as i64, 9),","+        (0xDEAD_BEEF_0000_0000u64 as i64, 0),","+        (0x1234_5678_FFFF_FFF7u64 as i64, -9),","         (0xFFFF_FFFF_7FFF_FFD7u64 as i64, 2_147_483_607),","     ];","     for (wide, narrow) in cases {","-        let co = capture(|| unsafe { cw(wide) });","-        let ro = capture(|| unsafe { rw(wide) });","-        let expect = run(c, narrow);","-        assert!(!co.is_empty());","+        let (co, c_capped) = capture_pipe_capped(|| unsafe { cw(wide) }, CAP1);","+        let (ro, r_capped) = capture_pipe_capped(|| unsafe { rw(wide) }, CAP1);","+        let expect = run_one(c, narrow, CAP).bytes;","+        assert!(!co.is_empty(), \"no C output for wide arg 0x{:016X}\", wide as u64);","+        assert!(!c_capped, \"C exceeded cap for wide arg 0x{:016X}\", wide as u64);","         assert_eq!(","+            c_capped, r_capped,","+            \"cap behaviour differs for wide arg 0x{:016X}\",","+            wide as u64","+        );","+        assert_eq!(","             co, ro,","             \"wide-arg call diverged for 0x{:016X} (low32 = {narrow})\",","             wide as u64"]},{"oldStart":205,"oldLines":7,"newStart":233,"newLines":7,"lines":[" /// E10: generic boundary sweep across the whole domain."," #[test]"," fn e10_boundary_sweep() {","-    // bounded (comparable in full)","+    // bounded ends (full comparison)","     assert_same_all(","         \"boundaries (bounded)\",","         ["]},{"oldStart":221,"oldLines":10,"newStart":249,"newLines":10,"lines":["             -9,","             -10,","             -11,","-            2_147_483_638,","-            2_147_483_639,","             2_147_483_629,","             2_147_483_630,","+            2_147_483_638,","+            2_147_483_639,","         ],","     );","     // unbounded / overflowing ends (prefix comparison)"]},{"oldStart":232,"oldLines":14,"newStart":260,"newLines":14,"lines":["     for val in [i32::MIN, i32::MIN + 1, i32::MAX] {","         let co = child_prefix(c, val, 4096);","         let ro = child_prefix(r, val, 4096);","-        assert!(co.len() >= 1024, \"C child output too short for {val}\");","-        assert_eq!(co.len(), ro.len(), \"prefix length differs for {val}\");","-        assert!(co == ro, \"prefix differs for {val}\");","+        assert!(co.len() >= 1024, \"C child output too short for sieve({val})\");","+        assert_eq!(co.len(), ro.len(), \"prefix length differs for sieve({val})\");","+        assert!(co == ro, \"prefix differs for sieve({val})\");","     }"," }"," "," /// E11: the null-pointer / length class of errors does not exist in this ABI —","-/// asserted structurally so the row is provably N/A rather than untested.","+/// asserted structurally, so the row is provably N/A rather than untested."," #[test]"," fn e11_no_pointer_parameters() {","     let header = include_str!(\"../c_src/include/sieve.h\");"]},{"oldStart":259,"oldLines":7,"newStart":287,"newLines":7,"lines":["         decls[0]","     );","     assert_eq!(decls[0].matches(',').count(), 0, \"more than one parameter\");","-    // both libraries really export the symbol that was exercised above","+    // both libraries really export the symbol exercised above","     assert!(c_lib_exports_sieve(), \"C .so must export `sieve`\");","     assert!(rust_lib_exports_sieve(), \"Rust .so must export `sieve`\");"," }"]}],"originalFile":"// Phase C — error-path differential tests, one test per row of ERRORS.md.\n//\n// `sieve` has no explicit rejection path (see ERRORS.md), so these tests cover\n// the implicit ones: the loop-exit predicate's exact C semantics (truncating `%`),\n// the ignored `printf` failure, the unguarded signed overflow, the domain\n// extremes, and the generic FFI boundaries.\n\nmod common;\n\nuse common::*;\n\n/// E1: there is no error return; a child that calls `sieve` must exit 0 in both\n/// implementations (no abort, no panic, no signal).\n#[test]\nfn e1_no_error_return_path() {\n    let (c, r) = funcs();\n    for val in [9, 0, -1, 7, -37, 123_456] {\n        let cc = child_run(c, val, Stdout::File);\n        let rr = child_run(r, val, Stdout::File);\n        assert_eq!(\n            cc.status, 0,\n            \"C child for sieve({val}) exited with raw status {}\",\n            cc.status\n        );\n        assert_eq!(\n            cc.status, rr.status,\n            \"exit status differs for sieve({val}): C {} vs Rust {}\",\n            cc.status, rr.status\n        );\n        assert_eq!(cc.out, rr.out, \"child output differs for sieve({val})\");\n    }\n}\n\n/// E2: `-1 % 10 == -1` in C (truncation toward zero), so the loop must NOT stop\n/// at `-1`; a floor-mod translation would stop immediately after one line.\n#[test]\nfn e2_negative_remainder_never_equals_nine() {\n    let (c, r) = funcs();\n    let co = run(c, -1);\n    let ro = run(r, -1);\n    assert_eq!(co, ro, \"sieve(-1) diverged\");\n    // Positive proof that neither stops early (11 lines, not 1).\n    assert_eq!(\n        co.iter().filter(|&&b| b == b'\\n').count(),\n        11,\n        \"C did not run -1..9\"\n    );\n    assert_eq!(ro.iter().filter(|&&b| b == b'\\n').count(), 11);\n}\n\n/// E3: every negative value whose C remainder is `-9` (a naive `abs`/floor mod\n/// would see \"9\" and break).\n#[test]\nfn e3_negative_residue_minus_nine() {\n    let vals = [-9, -19, -29, -99, -109, -1009, -100_009];\n    for &v in &vals {\n        assert_eq!(v % 10, -9, \"test premise\");\n    }\n    assert_same_all(\"residue -9\", vals);\n    let (c, r) = funcs();\n    for &v in &vals {\n        let n = run(c, v).iter().filter(|&&b| b == b'\\n').count();\n        assert_eq!(n, (9 - v) as usize + 1, \"C stopped early for sieve({v})\");\n        assert_eq!(\n            run(r, v).iter().filter(|&&b| b == b'\\n').count(),\n            n,\n            \"Rust line count differs for sieve({v})\"\n        );\n    }\n}\n\n/// E4: negative multiples of ten (`val % 10 == 0`).\n#[test]\nfn e4_negative_multiple_of_ten() {\n    let vals = [-10, -20, -100, -1000, -10_000];\n    for &v in &vals {\n        assert_eq!(v % 10, 0, \"test premise\");\n    }\n    assert_same_all(\"negative multiples of 10\", vals);\n}\n\n/// E5: `printf` write failure (`/dev/full`, ENOSPC) is ignored by the C: the loop\n/// still terminates normally and the child exits 0. Rust must match.\n#[test]\nfn e5_printf_write_error_ignored() {\n    let (c, r) = funcs();\n    // -20000 => ~20k lines => the 4 KiB libc buffer is flushed (and fails) many\n    // times inside `printf` itself, not just at the final fflush.\n    for val in [-20_000, 3] {\n        let cc = child_run(c, val, Stdout::DevFull);\n        let rr = child_run(r, val, Stdout::DevFull);\n        if cc.status == 97 << 8 {\n            eprintln!(\"skipping: /dev/full unavailable\");\n            return;\n        }\n        assert_eq!(\n            cc.status, 0,\n            \"C child on /dev/full for sieve({val}) status {}\",\n            cc.status\n        );\n        assert_eq!(\n            cc.status, rr.status,\n            \"status differs on /dev/full for sieve({val}): C {} vs Rust {}\",\n            cc.status, rr.status\n        );\n    }\n}\n\n/// E6: fd 1 closed (`EBADF`) — the ignored `printf` error must still let the\n/// function return normally in both implementations.\n#[test]\nfn e6_stdout_closed() {\n    let (c, r) = funcs();\n    for val in [-1000, 9, 4] {\n        let cc = child_run(c, val, Stdout::Closed);\n        let rr = child_run(r, val, Stdout::Closed);\n        assert_eq!(\n            cc.status, 0,\n            \"C child with closed stdout for sieve({val}) status {}\",\n            cc.status\n        );\n        assert_eq!(\n            cc.status, rr.status,\n            \"status differs with closed stdout for sieve({val}): C {} vs Rust {}\",\n            cc.status, rr.status\n        );\n    }\n}\n\n/// E7: the signed-overflow boundary `[INT_MAX-7, INT_MAX]`. The shipped C build\n/// wraps to `INT_MIN` and keeps counting; Rust must wrap identically and must\n/// not panic. Compared as an output prefix in a forked child.\n#[test]\nfn e7_int_max_overflow_wraps() {\n    let (c, r) = funcs();\n    const WANT: usize = 8192;\n    for val in 2_147_483_640..=2_147_483_647i32 {\n        let co = child_prefix(c, val, WANT);\n        let ro = child_prefix(r, val, WANT);\n        assert!(\n            co.len() >= 1024,\n            \"C child produced only {} bytes for sieve({val})\",\n            co.len()\n        );\n        assert_eq!(co.len(), ro.len(), \"prefix length differs for sieve({val})\");\n        assert!(co == ro, \"overflow prefix differs for sieve({val})\");\n        // the wrap itself must be visible in the stream both times\n        let text = String::from_utf8_lossy(&co).into_owned();\n        assert!(\n            text.contains(\"2147483647\\n-2147483648\\n\"),\n            \"C did not wrap INT_MAX -> INT_MIN for sieve({val}); head={:?}\",\n            &text[..text.len().min(120)]\n        );\n        assert!(String::from_utf8_lossy(&ro).contains(\"2147483647\\n-2147483648\\n\"));\n    }\n}\n\n/// E8: `INT_MIN` is accepted, not rejected (prefix comparison; the full run is\n/// ~2^31 lines).\n#[test]\nfn e8_int_min_accepted() {\n    let (c, r) = funcs();\n    const WANT: usize = 8192;\n    let co = child_prefix(c, i32::MIN, WANT);\n    let ro = child_prefix(r, i32::MIN, WANT);\n    assert!(co.starts_with(b\"-2147483648\\n\"), \"C head: {:?}\", &co[..24]);\n    assert_eq!(co.len(), ro.len());\n    assert!(co == ro, \"INT_MIN prefix differs\");\n}\n\n/// E9 / C18: out-of-range bits across the FFI boundary — the caller passes a\n/// 64-bit value whose high half is garbage; the `int` parameter must be the low\n/// 32 bits for both implementations (this is the FFI analogue of passing an\n/// out-of-range enum value: C accepts any bit pattern).\n#[test]\nfn e9_ffi_high_bits_ignored() {\n    let (cw, rw) = funcs_wide();\n    let (c, _) = funcs();\n    let cases: [(i64, i32); 6] = [\n        (0x7FFF_FFFF_0000_0003u64 as i64, 3),\n        (-1i64, -1),                                  // 0xFFFF..FFFF -> -1\n        (0x0000_0001_0000_0009u64 as i64, 9),         // high bit set, low = 9\n        (0xDEAD_BEEF_0000_0000u64 as i64, 0),         // low half zero\n        (0x1234_5678_FFFF_FFF7u64 as i64, -9),        // low half = -9\n        (0xFFFF_FFFF_7FFF_FFD7u64 as i64, 2_147_483_607),\n    ];\n    for (wide, narrow) in cases {\n        let co = capture(|| unsafe { cw(wide) });\n        let ro = capture(|| unsafe { rw(wide) });\n        let expect = run(c, narrow);\n        assert!(!co.is_empty());\n        assert_eq!(\n            co, ro,\n            \"wide-arg call diverged for 0x{:016X} (low32 = {narrow})\",\n            wide as u64\n        );\n        assert_eq!(\n            co, expect,\n            \"C did not truncate 0x{:016X} to {narrow}\",\n            wide as u64\n        );\n    }\n}\n\n/// E10: generic boundary sweep across the whole domain.\n#[test]\nfn e10_boundary_sweep() {\n    // bounded (comparable in full)\n    assert_same_all(\n        \"boundaries (bounded)\",\n        [\n            -1,\n            0,\n            1,\n            8,\n            9,\n            10,\n            11,\n            -2,\n            -8,\n            -9,\n            -10,\n            -11,\n            2_147_483_638,\n            2_147_483_639,\n            2_147_483_629,\n            2_147_483_630,\n        ],\n    );\n    // unbounded / overflowing ends (prefix comparison)\n    let (c, r) = funcs();\n    for val in [i32::MIN, i32::MIN + 1, i32::MAX] {\n        let co = child_prefix(c, val, 4096);\n        let ro = child_prefix(r, val, 4096);\n        assert!(co.len() >= 1024, \"C child output too short for {val}\");\n        assert_eq!(co.len(), ro.len(), \"prefix length differs for {val}\");\n        assert!(co == ro, \"prefix differs for {val}\");\n    }\n}\n\n/// E11: the null-pointer / length class of errors does not exist in this ABI —\n/// asserted structurally so the row is provably N/A rather than untested.\n#[test]\nfn e11_no_pointer_parameters() {\n    let header = include_str!(\"../c_src/include/sieve.h\");\n    let decls: Vec<&str> = header\n        .lines()\n        .filter(|l| l.contains(\"sieve(\") && !l.trim_start().starts_with(\"//\"))\n        .collect();\n    assert_eq!(decls.len(), 1, \"unexpected public declarations: {decls:?}\");\n    assert!(\n        decls[0].contains(\"void sieve(int\"),\n        \"declaration changed: {:?}\",\n        decls[0]\n    );\n    assert!(\n        !decls[0].contains('*'),\n        \"a pointer parameter appeared: {:?}\",\n        decls[0]\n    );\n    assert_eq!(decls[0].matches(',').count(), 0, \"more than one parameter\");\n    // both libraries really export the symbol that was exercised above\n    assert!(c_lib_exports_sieve(), \"C .so must export `sieve`\");\n    assert!(rust_lib_exports_sieve(), \"Rust .so must export `sieve`\");\n}\n","userModified":false}}
