afe { f(val) })"," }"," ","-// ------------------------------------------------------------------- assertions","+// ------------------------------------------------------------------ assertions"," "," fn show(bytes: &[u8]) -> String {","     let s = String::from_utf8_lossy(bytes);","-    let mut lines: Vec<&str> = s.lines().collect();","-    let total = lines.len();","-    let tail = if total > 12 {","-        lines = lines[..6].to_vec();","-        format!(\" ... ({} lines total)\", total)","+    let all: Vec<&str> = s.lines().collect();","+    if all.len() > 10 {","+        format!(\"{:?} ... {:?} ({} lines)\", &all[..5], &all[all.len() - 2..], all.len())","     } else {","-        String::new()","+        format!(\"{all:?}\")","+    }","+}","+","+fn diff_msg(label: &str, c: &RunOut, r: &RunOut) -> String {","+    let first = c","+        .bytes","+        .iter()","+        .zip(r.bytes.iter())","+        .position(|(a, b)| a != b);","+    format!(","+        \"{label} diverged\\n  C   : {:?}\\n        {}\\n  Rust: {:?}\\n        {}\\n  first differing byte offset: {:?}\",","+        c,","+        show(&c.bytes),","+        r,","+        show(&r.bytes),","+        first","+    )","+}","+","+/// Conservative upper bound on the bytes `sieve(val)` emits (C semantics).","+fn est_bytes(val: i32) -> u64 {","+    let lines: u64 = if val % 10 == 9 {","+        1","+    } else if val > 9 {","+        10","+    } else {","+        (9i64 - val as i64) as u64 + 1","     };","-    format!(\"{:?}{}\", lines, tail)","+    lines * 13"," }"," ","-/// Core differential assertion: identical bytes from both `.so`s for `val`.","+/// Differential assertion for one value: identical bytes, cap/timeout flags and","+/// exit status from both `.so`s (forked, bounded)."," pub fn assert_same(val: i32) {","-    let (c, r) = funcs();","-    let co = run(c, val);","-    let ro = run(r, val);","-    assert!(","-        !co.is_empty(),","-        \"harness broken: C produced no output for sieve({