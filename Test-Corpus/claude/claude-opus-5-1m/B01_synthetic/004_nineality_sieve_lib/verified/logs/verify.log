 the current `src/lib.rs` (mtime newer).\npub fn cargo_so_is_fresh(so: &std::path::Path) -> bool {\n    let src = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"src\").join(\"lib.rs\");\n    match (mtime(so), mtime(&src)) {\n        (Some(a), Some(b)) => a >= b,\n        _ => false,\n    }\n}\n\n/// Compiles `src/lib.rs` into a fresh cdylib with plain `rustc`.\n///\n/// This exists because `cargo test` does NOT rebuild a `crate-type = [\"cdylib\"]`\n/// target (integration tests cannot link one), so `target/<profile>/libSieve.so`\n/// can silently be stale — which would make every differential test pass against\n/// an old artifact. The freshly built `.so` is loaded exactly like any external\n/// consumer would: `dlopen` + `dlsym`, never a direct Rust call.\nfn build_fresh_cdylib() -> PathBuf {\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    let src = manifest.join(\"src\").join(\"lib.rs\");\n    let out = tmp_dir().join(format!(\n        \"libSieve_fresh_{}_{}.so\",\n        std::process::id(),\n        std::path::Path::new(&std::env::current_exe().unwrap_or_default())\n            .file_name()\n            .map(|s| s.to_string_lossy().into_owned())\n            .unwrap_or_default()\n    ));\n    let rustc = std::env::var(\"RUSTC\").unwrap_or_else(|_| \"rustc\".to_string());\n    let o = std::process::Command::new(&rustc)\n        .args([\"--edition\", \"2021\", \"--crate-type\", \"cdylib\", \"--crate-name\", \"Sieve\", \"-C\", \"debuginfo=0\", \"-o\"])\n        .arg(&out)\n        .arg(&src)\n        .output()\n        .unwrap_or_else(|e| panic!(\"cannot run `{rustc}` to build a fresh cdylib: {e}\"));\n    assert!(\n        o.status.success(),\n        \"cannot build fresh Rust cdylib from {}:\\n{}\",\n        src.display(),\n        String::from_utf8_lossy(&o.stderr)\n    );\n    out\n}\n\n/// Path of the Rust `.so` under test: the cargo artifact when it is up to date,\n/// otherwise a freshly compiled one (never a stale artifact).\npub fn rust_so_path() -> PathBuf {\n    static P: OnceLock<PathBuf> = OnceLock::new();\n    P.get_or_init(|| match cargo_so_path() {\n        Some(p) if cargo_so_is_fresh(&p) => p,\n        other => {\n            let fresh = build_fresh_cdylib();\n            match other {\n                Some(stale) => eprintln!(\n                    \"note: {} is stale (cargo does not rebuild cdylib targets during \\\n                     `cargo test`); testing freshly built {}\",\n                    stale.display(),\n                    fresh.display()\n                ),\n                None => eprintln!(\"note: no cargo cdylib found; testing freshly built {}\", fresh.display()),\n            }\n            fresh\n        }\n    })\n    .clone()\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3079,"cache_read_input_tokens":69794,"cache_creation":{"ephemeral_5m_input_tokens":3079,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6bd36f9b-9b34-4b47-afdd-5254c45236ff","uuid":"6f028c50-300a-4ac3-8865-2ae4b6f6ca3c","timestamp":"2026-08-17T22:32:08.619Z"}
