\"$out\" | grep -oE \"^test [a-z0-9_]+ \\.\\.\\. FAILED\" | head -6 | sed 's/^/    /'\n    else\n      echo \"MUTATION '$name': *** NOT CAUGHT *** (harness is blind here)\"\n      fails=$((fails+1))\n    fi\n  else\n    echo \"MUTATION '$name': *** SED DID NOT APPLY ***\"\n    fails=$((fails+1))\n  fi\n}\n\nmutate \"floor-mod instead of C truncating %\" \\\n  -e 's/if val % 10 == 9 {/if val.rem_euclid(10) == 9 {/'\nmutate \"saturating_add instead of wrapping overflow\" \\\n  -e 's/val = val.wrapping_add(1);/val = val.saturating_add(1);/'\nmutate \"print after the break check (order swap)\" \\\n  -e 's|^        if val % 10 == 9 {|        if val % 10 == 9 { break; }\\n        if false {|'\nmutate \"format string %d without newline\" \\\n  -e 's/b\"%d\\\\n\\\\0\"/b\"%d \\\\0\"/'\nmutate \"off-by-one terminator (8 instead of 9)\" \\\n  -e 's/if val % 10 == 9 {/if val % 10 == 8 {/'\nmutate \"step by 2\" \\\n  -e 's/val.wrapping_add(1)/val.wrapping_add(2)/'\nmutate \"unsigned printing (%u)\" \\\n  -e 's/b\"%d\\\\n\\\\0\"/b\"%u\\\\n\\\\0\"/'\n\nrestore\ntimeout 600 cargo build --no-default-features --offline >/dev/null 2>&1\necho \"-------------------------------------------\"\nif [ \"$fails\" -eq 0 ]; then\n  echo \"ALL MUTATIONS CAUGHT — harness is sensitive\"\nelse\n  echo \"$fails MUTATION(S) NOT CAUGHT\"\nfi\nexit \"$fails\"\n","structuredPatch":[{"oldStart":15,"oldLines":6,"newStart":15,"newLines":10,"lines":["   sed -i \"$@\" src/lib.rs","   if ! diff -q \"$ORIG\" src/lib.rs >/dev/null; then","     out=$(timeout 600 cargo test --no-default-features --offline -- --test-threads=1 2>&1)","+    if echo \"$out\" | grep -q \"cannot build fresh Rust cdylib\"; then","+      echo \"MUTATION '$name': COMPILE ERROR (mutation not applicable, skipped)\"","+      return","+    fi","     if echo \"$out\" | grep -qE \"^test result: FAILED|test result: FAILED\\.\"; then","       caught=$(echo \"$out\" | grep -oE \"^test [a-z0-9_]+ \\.\\.\\. FAILED\" | wc -l)","       echo \"MUTATION