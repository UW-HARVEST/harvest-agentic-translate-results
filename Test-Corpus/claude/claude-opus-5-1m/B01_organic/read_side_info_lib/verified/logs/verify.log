, 6, 6, 10, 10, 10, 12, 12, 12, 14, 14,\n174\t            14, 16, 16, 16, 20, 20, 20, 26, 26, 26, 66, 66, 66, 0,\n175\t        ],\n176\t        [\n177\t            4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 6, 6, 6, 8, 8, 8, 12, 12, 12, 16, 16, 16, 20, 20,\n178\t            20, 26, 26, 26, 34, 34, 34, 42, 42, 42, 12, 12, 12, 0,\n179\t        ],\n180\t    ],\n181\t    // static const uint8_t g_scf_long[8][23]\n182\t    long_: [\n183\t        [\n184\t            6, 6, 6, 6, 6, 6, 8, 10, 12, 14, 16, 20, 24, 28, 32, 38, 46, 52, 60, 68, 58, 54, 0,\n185\t        ],\n186\t        [\n187\t            12, 12, 12, 12, 12, 12, 16, 20, 24, 28, 32, 40, 48, 56, 64, 76, 90, 2, 2, 2, 2, 2, 0,\n188\t        ],\n189\t        [\n190\t            6, 6, 6, 6, 6, 6, 8, 10, 12, 14, 16, 20, 24, 28, 32, 38, 46, 52, 60, 68, 58, 54, 0,\n191\t        ],\n192\t        [\n193\t            6, 6, 6, 6, 6, 6, 8, 10, 12, 14, 16, 18, 22, 26, 32, 38, 46, 54, 62, 70, 76, 36, 0,\n194\t        ],\n195\t        [\n196\t            6, 6, 6, 6, 6, 6, 8, 10, 12, 14, 16, 20, 24, 28, 32, 38, 46, 52, 60, 68, 58, 54, 0,\n197\t        ],\n198\t        [\n199\t            4, 4, 4, 4, 4, 4, 6, 6, 8, 8, 10, 12, 16, 20, 24, 28, 34, 42, 50, 54, 76, 158, 0,\n200\t        ],\n201\t        [\n202\t            4, 4, 4, 4, 4, 4, 6, 6, 6, 8, 10, 12, 16, 18, 22, 28, 34, 40, 46, 54, 54, 192, 0,\n203\t        ],\n204\t        [\n205\t            4, 4, 4, 4, 4, 4, 6, 6, 8, 10, 12, 16, 20, 24, 30, 38, 46, 56, 68, 84, 102, 26, 0,\n206\t        ],\n207\t    ],\n208\t    tail: [0; 64],\n209\t};\n210\t\n211\t// Lock in the layout the C relies on (see `ScfTables` docs), and the ABI of the\n212\t// two public structs, so any accidental change becomes a compile error.\n213\tconst _: () = {\n214\t    assert!(core::mem::offset_of!(ScfTables, long_) == 0);\n215\t    assert!(core::mem::offset_of!(ScfTables, pad) == 184);\n216\t    assert!(core::mem::offset_of!(ScfTables, short_) == 192);\n217\t    assert!(core::mem::offset_of!(ScfTables, mixed) == 512);\n218\t    assert!(core::mem::offset_of!(ScfTables, tail) == 832);\n219\t\n220\t    assert!(core::mem::size_of::<bs_t>() == 16);\n221\t    assert!(core::mem::offset_of!(bs_t, pos) == 8);\n222\t    assert!(core::mem::offset_of!(bs_t, limit) == 12);\n223\t\n224\t    assert!(core::mem::size_of::<L3_gr_info_t>() == 32);\n225\t    assert!(core::mem::offset_of!(L3_gr_info_t, part_23_length) == 8);\n226\t    assert!(core::mem::offset_of!(L3_gr_info_t, big_values) == 10);\n227\t    assert!(core::mem::offset_of!(L3_gr_info_t, scalefac_compress) == 12);\n228\t    assert!(core::mem::offset_of!(L3_gr_info_t, global_gain) == 14);\n229\t    assert!(core::mem::offset_of!(L3_gr_info_t, table_select) == 19);\n230\t    assert!(core::mem::offset_of!(L3_gr_info_t, region_count) == 22);\n231\t    assert!(core::mem::offset_of!(L3_gr_info_t, subblock_gain) == 25);\n232\t    assert!(core::mem::offset_of!(L3_gr_info_t, preflag) == 28);\n233\t    assert!(core::mem::offset_of!(L3_gr_info_t, scfsi) == 31);\n234\t};\n235\t\n236\t/// `&g_scf_long[idx]` — unchecked row addressing, matching the C.\n237\t#[inline]\n238\tfn scf_long_row(idx: c_int) -> *const u8 {\n239\t    unsafe { (G_SCF.long_.as_ptr() as *const u8).offset((idx as isize) * 23) }\n240\t}\n241\t\n242\t/// `&g_scf_short[idx]` — unchecked row addressing, matching the C.\n243\t#[inline]\n244\tfn scf_short_row(idx: c_int) -> *const u8 {\n245\t    unsafe { (G_SCF.short_.as_ptr() as *const u8).offset((idx as isize) * 40) }\n246\t}\n247\t\n248\t/// `&g_scf_mixed[idx]` — unchecked row addressing, matching the C.\n249\t#[inline]\n250\tfn scf_mixed_row(idx: c_int) -> *const u8 {\n251\t    unsafe { (G_SCF.mixed.as_ptr() as *const u8).offset((idx as isize) * 40) }\n252\t}\n253\t\n254\t/// Translation of the file-local C helper:\n255\t///\n256\t/// ```c\n257\t/// static uint32_t get_bits(bs_t *bs, int n) {\n258\t///     uint32_t next, cache = 0, s = bs->pos & 7;\n259\t///     int shl = n + s;\n260\t///     const uint8_t *p = bs->buf + (bs->pos >> 3);\n261\t///     if ((bs->pos += n) > bs->limit)\n262\t///         return 0;\n263\t///     next = *p++ & (255 >> s);\n264\t///     while ((shl -= 8) > 0) {\n265\t///         cache |= next << shl;\n266\t///         next = *p++;\n267\t///     }\n268\t///     return cache | (next >> -shl);\n269\t/// }\n270\t/// ```\n271\t///\n272\t/// `static` in C means this symbol is not exported, so it stays private here.\n273\t/// Note that `bs->pos` is advanced even when the limit check fails.\n274\tunsafe fn get_bits(bs: *mut bs_t, n: c_int) -> u32 {\n275\t    unsafe {\n276\t        let mut next: u32;\n277\t        let mut cache: u32 = 0;\n278\t        // `s` is `uint32_t` in the C; `pos & 7` is always in 0..=7 (also for\n279\t        // negative `pos` under two's complement, which is what GCC produces).\n280\t        let s: u32 = ((*bs).pos & 7) as u32;\n281\t        // `int shl = n + s;` — `n` is converted to unsigned, the sum computed in\n282\t        // unsigned, then converted back to int.\n283\t        let mut shl: c_int = (n as u32).wrapping_add(s) as c_int;\n284\t        let mut p: *const u8 = (*bs).buf.offset(((*bs).pos >> 3) as isize);\n285\t\n286\t        (*bs).pos = (*bs).pos.wrapping_add(n);\n287\t        if (*bs).pos > (*bs).limit {\n288\t            return 0;\n289\t        }\n290\t\n291\t        next = (*p & (255u32 >> s) as u8) as u32;\n292\t        p = p.add(1);\n293\t\n294\t        loop {\n295\t            shl = shl.wrapping_sub(8);\n296\t            if shl <= 0 {\n297\t                break;\n298\t            }\n299\t            cache |= next.wrapping_shl(shl as u32);\n300\t            next = *p as u32;\n301\t            p = p.add(1);\n302\t        }\n303\t\n304\t        // `shl` is now in -7..=0, so `-shl` is a well-defined 0..=7 shift.\n305\t        cache | next.wrapping_shr(shl.wrapping_neg() as u32)\n306\t    }\n307\t}\n308\t\n309\t/// Translation of the sole public C entry point:\n310\t///\n311\t/// ```c\n312\t/// int read_side_info(bs_t *bs, L3_g