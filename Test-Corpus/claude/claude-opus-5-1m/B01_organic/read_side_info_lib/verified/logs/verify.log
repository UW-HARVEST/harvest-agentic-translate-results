\t            (*gr).sfbtab = scf_long_row(sr_idx);\n362\t            (*gr).n_long_sfb = 22;\n363\t            (*gr).n_short_sfb = 0;\n364\t\n365\t            if get_bits(bs, 1) != 0 {\n366\t                (*gr).block_type = get_bits(bs, 2) as u8;\n367\t                if (*gr).block_type == 0 {\n368\t                    return -1;\n369\t                }\n370\t                (*gr).mixed_block_flag = get_bits(bs, 1) as u8;\n371\t                (*gr).region_count[0] = 7;\n372\t                (*gr).region_count[1] = 255;\n373\t                if (*gr).block_type == 2 {\n374\t                    scfsi &= 0x0F0F;\n375\t                    if (*gr).mixed_block_flag == 0 {\n376\t                        (*gr).region_count[0] = 8;\n377\t                        (*gr).sfbtab = scf_short_row(sr_idx);\n378\t                        (*gr).n_long_sfb = 0;\n379\t                        (*gr).n_short_sfb = 39;\n380\t                    } else {\n381\t                        (*gr).sfbtab = scf_mixed_row(sr_idx);\n382\t                        (*gr).n_long_sfb = if (hdr1 & 0x8) != 0 { 8 } else { 6 };\n383\t                        (*gr).n_short_sfb = 30;\n384\t                    }\n385\t                }\n386\t                tables = get_bits(bs, 10);\n387\t                tables = tables.wrapping_shl(5);\n388\t                (*gr).subblock_gain[0] = get_bits(bs, 3) as u8;\n389\t                (*gr).subblock_gain[1] = get_bits(bs, 3) as u8;\n390\t                (*gr).subblock_gain[2] = get_bits(bs, 3) as u8;\n391\t                // NOTE: the C does not assign region_count[2] on this path.\n392\t            } else {\n393\t                (*gr).block_type = 0;\n394\t                (*gr).mixed_block_flag = 0;\n395\t                tables = get_bits(bs, 15);\n396\t                (*gr).region_count[0] = get_bits(bs, 4) as u8;\n397\t                (*gr).region_count[1] = get_bits(bs, 3) as u8;\n398\t                (*gr).region_count[2] = 255;\n399\t            }\n400\t\n401\t    