{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014qdg8sZc44wFHdQvCHMwWn","type":"tool_result","content":"     1\t//! Phase B — valid-path differential tests.\n     2\t//!\n     3\t//! One `#[test]` per row of `CONFIGS.md`. Every test calls BOTH the C `.so` and\n     4\t//! the Rust `.so` through `libloading` and asserts the returned `u32`s are\n     5\t//! byte-identical (plus a third-opinion oracle check).\n     6\t\n     7\tmod common;\n     8\t\n     9\tuse common::*;\n    10\t\n    11\t/// Iterations for the ordinary randomized rows.\n    12\tconst N: usize = 20_000;\n    13\t\n    14\t// ---------------------------------------------------------------------------\n    15\t// Row 1-7: the stereo path (channels == 2), crossed with the bitdepth axis\n    16\t// ---------------------------------------------------------------------------\n    17\t\n    18\t#[test]\n    19\tfn row01_stereo_bitdepth_exactly_32() {\n    20\t    let l = libs();\n    21\t    let mut rng = Rng::new(1);\n    22\t    for _ in 0..N {\n    23\t        let bs = rng.range(1, 65535);\n    24\t        assert_same_triple(l, bs, 2, 32);\n    25\t    }\n    26\t}\n    27\t\n    28\t#[test]\n    29\tfn row02_stereo_bitdepth_16() {\n    30\t    let l = libs();\n    31\t    let mut rng = Rng::new(2);\n    32\t    for _ in 0..N {\n    33\t        let bs = rng.range(1, 65535);\n    34\t        assert_same_triple(l, bs, 2, 16);\n    35\t    }\n    36\t}\n    37\t\n    38\t#[test]\n    39\tfn row03_stereo_bitdepth_1_to_31() {\n    40\t    let l = libs();\n    41\t    let mut rng = Rng::new(3);\n    42\t    for _ in 0..N {\n    43\t        let bs = rng.range(1, 65535);\n    44\t        let bd = rng.range(1, 31);\n    45\t        assert_same_triple(l, bs, 2, bd);\n    46\t    }\n    47\t}\n    48\t\n    49\t#[test]\n    50\tfn row04_stereo_bitdepth_33_to_64() {\n    51\t    let l = libs();\n    52\t    let mut rng = Rng::new(4);\n    53\t    for _ in 0..N {\n    54\t        let bs = rng.range(1, 65535);\n    55\t        let bd = rng.range(33, 64);\n    56\t        assert_same_triple(l, bs, 2, bd);\n    57\t    }\n    58\t}\n    59\t\n    60\t#[test]\n    61\tfn row05_stereo_bitdepth_zero_full_range_blocksize() {\n    62\t    let l = libs();\n    63\t    let mut rng = Rng::new(5);\n    64\t    for _ in 0..N {\n    65\t        let bs = rng.next_u32();\n    66\t        // T3 collapses to blocksize * (0 + 1) * 1 == blocksize.\n    67\t        assert_same_triple(l, bs, 2, 0);\n    68\t    }\n    69\t}\n    70\t\n    71\t#[test]\n    72\tfn row06_stereo_bitdepth_uint32_max_inner_wrap() {\n    73\t    let l = libs();\n    74\t    let mut rng = Rng::new(6);\n    75\t    for _ in 0..N {\n    76\t        let bs = rng.next_u32();\n    77\t        // bitdepth + (bitdepth != 32) == 0xFFFFFFFF + 1 == 0 (wraps).\n    78\t        assert_same_triple(l, bs, 2, u32::MAX);\n    79\t    }\n    80\t}\n    81\t\n    82\t#[test]\n    83\tfn row07_stereo_full_range_blocksize_and_bitdepth() {\n    84\t    let l = libs();\n    85\t    let mut rng = Rng::new(7);\n    86\t    for _ in 0..N {\n    87\t        let bs = rng.next_u32();\n    88\t        let bd = rng.next_u32();\n    89\t        assert_same_triple(l, bs, 2, bd);\n    90\t    }\n    91\t}\n    92\t\n    93\t// ---------------------------------------------------------------------------\n    94\t// Row 8-14: the non-stereo path (channels != 2)\n    95\t// ---------------------------------------------------------------------------\n    96\t\n    97\t#[test]\n    98\tfn row08_channels_zero_all_terms_vanish() {\n    99\t    let l = libs();\n   100\t    let mut rng = Rng::new(8);\n   101\t    for _ in 0..N {\n   102\t        let bs = rng.next_u32();\n   103\t        let bd = rng.next_u32();\n   104\t        // channels * (channels != 2) == 0, so the result is exactly 18.\n   105\t        assert_same_and_eq(l, bs, 0, bd, 18);\n   106\t    }\n   107\t}\n   108\t\n   109\t#[test]\n   110\tfn row09_mono_realistic() {\n   111\t    let l = libs();\n   112\t    let mut rng = Rng::new(9);\n   113\t    for _ in 0..N {\n   114\t        let bs = rng.pick(FLAC_BLOCKSIZES);\n   115\t        let bd = rng.pick(FLAC_BITDEPTHS);\n   116\t        assert_same_triple(l, bs, 1, bd);\n   117\t    }\n   118\t}\n   119\t\n   120\t#[test]\n   121\tfn row10_channels_three_just_past_stereo() {\n   122\t    let l = libs();\n   123\t    let mut rng = Rng::new(10);\n   124\t    for _ in 0..N {\n   125\t        let bs = rng.range(1, 65535);\n   126\t        let bd = rng.range(1, 32);\n   127\t        assert_same_triple(l, bs, 3, bd);\n   128\t    }\n   129\t}\n   130\t\n   131\t#[test]\n   132\tfn row11_channels_4_to_8_realistic() {\n   133\t    let l = libs();\n   134\t    let mut rng = Rng::new(11);\n   135\t    for _ in 0..N {\n   136\t        let ch = rng.range(4, 8);\n   137\t        let bs = rng.pick(FLAC_BLOCKSIZES);\n   138\t        let bd = rng.pick(FLAC_BITDEPTHS);\n   139\t        assert_same_triple(l, bs, ch, bd);\n   140\t    }\n   141\t}\n   142\t\n   143\t#[test]\n   144\tfn row12_channels_9_to_255() {\n   145\t    let l = libs();\n   146\t    let mut rng = Rng::new(12);\n   147\t    for _ in 0..N {\n   148\t        let ch = rng.range(9, 255);\n   149\t        let bs = rng.range(1, 8192);\n   150\t        let bd = rng.range(1, 64);\n   151\t        assert_same_triple(l, bs, ch, bd);\n   152\t    }\n   153\t}\n   154\t\n   155\t#[test]\n   156\tfn row13_huge_channels_forces_t1_and_outer_wrap() {\n   157\t    let l = libs();\n   158\t    let mut rng = Rng::new(13);\n   159\t    for _ in 0..N {\n   160\t        let mut ch = rng.range(1 << 16, u32::MAX);\n   161\t        if ch == 2 {\n   162\t            ch = 3; // keep this row on the non-stereo path\n   163\t        }\n   164\t        let bs = rng.range(1, u32::MAX);\n   165\t        let bd = rng.range(1, u32::MAX);\n   166\t        assert_same_triple(l, bs, ch, bd);\n   167\t    }\n   168\t}\n   169\t\n   170\t#[test]\n   171\tfn row14_channels_uint32_max_outer_wrap() {\n   172\t    let l = libs();\n   173\t    let mut rng = Rng::new(14);\n   174\t    for _ in 0..N {\n   175\t        let bs = rng.next_u32();\n   176\t        let bd = rng.next_u32();\n   177\t        assert_same_triple(l, bs, u32::MAX, bd);\n   178\t    }\n   179\t}\n   180\t\n   181\t// ---------------------------------------------------------------------------\n   182\t// Row 15-18: the blocksize magnitude axis\n   183\t// ---------------------------------------------------------------------------\n   184\t\n   185\t#[test]\n   186\tfn row15_blocksize_zero() {\n   187\t    let l = libs();\n   188\t    let mut rng = Rng::new(15);\n   189\t    for _ in 0..N {\n   190\t        let ch = rng.next_u32();\n   191\t        let bd = rng.next_u32();\n   192\t        // Every term is multiplied by blocksize == 0, so (0 + 7) / 8 == 0.\n   193\t        assert_same_and_eq(l, 0, ch, bd, 18u32.wrapping_add(ch));\n   194\t    }\n   195\t}\n   196\t\n   197\t#[test]\n   198\tfn row16_blocksize_one() {\n   199\t    let l = libs();\n   200\t    let mut rng = Rng::new(16);\n   201\t    for _ in 0..N {\n   202\t        let ch = rng.next_u32();\n   203\t        let bd = rng.next_u32();\n   204\t        assert_same_triple(l, 1, ch, bd);\n   205\t    }\n   206\t}\n   207\t\n   208\t#[test]\n   209\tfn row17_blocksize_uint32_max() {\n   210\t    let l = libs();\n   211\t    let mut rng = Rng::new(17);\n   212\t    for _ in 0..N {\n   213\t        let ch = rng.range(0, 8);\n   214\t        let bd = rng.range(0, 64);\n   215\t        assert_same_triple(l, u32::MAX, ch, bd);\n   216\t    }\n   217\t}\n   218\t\n   219\t#[test]\n   220\tfn row18_blocksize_powers_of_two_exhaustive() {\n   221\t    let l = libs();\n   222\t    for shift in 0..32u32 {\n   223\t        let bs = 1u32 << shift;\n   224\t        for ch in [1u32, 2, 3] {\n   225\t            for bd in [16u32, 24, 32] {\n   226\t                assert_same_triple(l, bs, ch, bd);\n   227\t            }\n   228\t        }\n   229\t    }\n   230\t}\n   231\t\n   232\t// ---------------------------------------------------------------------------\n   233\t// Row 19-21: the ceiling-divide (+7)/8 rounding axis and its wrap\n   234\t// ---------------------------------------------------------------------------\n   235\t\n   236\t#[test]\n   237\tfn row19_rounding_residues_non_stereo() {\n   238\t    let l = libs();\n   239\t    // channels == 1, bitdepth == 1  =>  T1 == blocksize, so numerator == bs + 7\n   240\t    // and `bs % 8` walks every residue class.\n   241\t    for residue in 0..8u32 {\n   242\t        for k in 0..2048u32 {\n   243\t            let bs = k * 8 + residue;\n   244\t            assert_same_triple(l, bs, 1, 1);\n   245\t        }\n   246\t    }\n   247\t    // Also sweep every residue at large magnitudes.\n   248\t    let mut rng = Rng::new(19);\n   249\t    for _ in 0..N {\n   250\t        let bs = rng.next_u32();\n   251\t        assert_same_triple(l, bs, 1, 1);\n   252\t    }\n   253\t}\n   254\t\n   255\t#[test]\n   256\tfn row20_rounding_residues_stereo() {\n   257\t    let l = libs();\n   258\t    // channels == 2, bitdepth == 1 => T2 == bs, T3 == bs * 2, sum == 3 * bs.\n   259\t    for residue in 0..8u32 {\n   260\t        for k in 0..2048u32 {\n   261\t            let bs = k * 8 + residue;\n   262\t            assert_same_triple(l, bs, 2, 1);\n   263\t        }\n   264\t    }\n   265\t    let mut rng = Rng::new(20);\n   266\t    for _ in 0..N {\n   267\t        let bs = rng.next_u32();\n   268\t        assert_same_triple(l, bs, 2, 1);\n   269\t    }\n   270\t}\n   271\t\n   272\t#[test]\n   273\tfn row21_numerator_plus_seven_wraps() {\n   274\t    let l = libs();\n   275\t\n   276\t    // channels == 1, bitdepth == 1 => numerator == blocksize + 7, so the +7\n   277\t    // itself overflows for blocksize in [UINT32_MAX-6, UINT32_MAX].\n   278\t    for bs in (u32::MAX - 6)..=u32::MAX {\n   279\t        assert_same_triple(l, bs, 1, 1);\n   280\t    }\n   281\t\n   282\t    // Same wrap reached on the stereo path: bitdepth == UINT32_MAX makes\n   283\t    // T2 == blocksize * 0xFFFFFFFF and T3 == 0.\n   284\t    for bs in 1..=64u32 {\n   285\t        assert_same_triple(l, bs, 2, u32::MAX);\n   286\t    }\n   287\t\n   288\t    // Search for triples whose term sum lands in the top 8 values so that\n   289\t    // `sum + 7` wraps, and check each one found.\n   290\t    let mut rng = Rng::new(21);\n   291\t    let mut wrap_cases = 0usize;\n   292\t    for _ in 0..400_000 {\n   293\t        let bs = rng.next_u32();\n   294\t        let ch = rng.next_u32();\n   295\t        let bd = rng.next_u32();\n   296\t        let sum = term_sum(bs, ch, bd);\n   297\t        if sum >= u32::MAX - 6 {\n   298\t            wrap_cases += 1;\n   299\t            assert_same_triple(l, bs, ch, bd);\n   300\t        }\n   301\t    }\n   302\t    // The engineered cases above already cover the wrap; this is informational.\n   303\t    println!(\"row21: {wrap_cases} randomly-found numerator-wrap cases verified\");\n   304\t}\n   305\t\n   306\t/// The three C terms summed WITHOUT the trailing `+7`, used only to steer the\n   307\t/// search in `row21`.\n   308\tfn term_sum(blocksize: u32, channels: u32, bitdepth: u32) -> u32 {\n   309\t    let is_stereo = u32::from(channels == 2);\n   310\t    let not_stereo = u32::from(channels != 2);\n   311\t    let not_32 = u32::from(bitdepth != 32);\n   312\t    let t1 = blocksize\n   313\t        .wrapping_mul(bitdepth)\n   314\t        .wrapping_mul(channels.wrapping_mul(not_stereo));\n   315\t    let t2 = blocksize.wrapping_mul(bitdepth).wrapping_mul(is_stereo);\n   316\t    let t3 = blocksize\n   317\t        .wrapping_mul(bitdepth.wrapping_add(not_32))\n   318\t        .wrapping_mul(is_stereo);\n   319\t    t1.wrapping_add(t2).wrapping_add(t3)\n   320\t}\n   321\t\n   322\t// ---------------------------------------------------------------------------\n   323\t// Row 22-24: exhaustive sweeps\n   324\t// ---------------------------------------------------------------------------\n   325\t\n   326\t#[test]\n   327\tfn row22_exhaustive_small_cube() {\n   328\t    let l = libs();\n   329\t    let mut count = 0usize;\n   330\t    for bs in 0..=48u32 {\n   331\t        for ch in 0..=8u32 {\n   332\t            for bd in 0..=40u32 {\n   333\t                assert_same_triple(l, bs, ch, bd);\n   334\t                count += 1;\n   335\t            }\n   336\t        }\n   337\t    }\n   338\t    assert_eq!(count, 49 * 9 * 41);\n   339\t}\n   340\t\n   341\t#[test]\n   342\tfn row23_exhaustive_single_axis_sweeps() {\n   343\t    let l = libs();\n   344\t\n   345\t    // channels 0..=1024 at several realistic (blocksize, bitdepth) pairs.\n   346\t    for ch in 0..=1024u32 {\n   347\t        for (bs, bd) in [(4096u32, 16u32), (1152, 24), (256, 32), (65535, 8)] {\n   348\t            assert_same_triple(l, bs, ch, bd);\n   349\t        }\n   350\t    }\n   351\t\n   352\t    // bitdepth 0..=64 crossed with the stereo predicate.\n   353\t    for bd in 0..=64u32 {\n   354\t        for ch in [0u32, 1, 2, 3, 8] {\n   355\t            assert_same_triple(l, 4096, ch, bd);\n   356\t        }\n   357\t    }\n   358\t\n   359\t    // blocksize 0..=4096 crossed with the stereo predicate and the 32 predicate.\n   360\t    for bs in 0..=4096u32 {\n   361\t        for ch in [1u32, 2, 3] {\n   362\t            for bd in [0u32, 16, 32, 33] {\n   363\t                assert_same_triple(l, bs, ch, bd);\n   364\t            }\n   365\t        }\n   366\t    }\n   367\t}\n   368\t\n   369\t#[test]\n   370\tfn row24_exhaustive_flac_realistic_matrix() {\n   371\t    let l = libs();\n   372\t    for &bs in FLAC_BLOCKSIZES {\n   373\t        for ch in 1..=8u32 {\n   374\t            for &bd in FLAC_BITDEPTHS {\n   375\t                assert_same_triple(l, bs, ch, bd);\n   376\t            }\n   377\t        }\n   378\t    }\n   379\t}\n   380\t\n   381\t// ---------------------------------------------------------------------------\n   382\t// Row 25-26: unconstrained fuzz and boundary interaction\n   383\t// ---------------------------------------------------------------------------\n   384\t\n   385\t#[test]\n   386\tfn row25_uniform_random_full_range() {\n   387\t    let l = libs();\n   388\t    let mut rng = Rng::new(25);\n   389\t    for _ in 0..200_000 {\n   390\t        let bs = rng.next_u32();\n   391\t        let ch = rng.next_u32();\n   392\t        let bd = rng.next_u32();\n   393\t        assert_same_triple(l, bs, ch, bd);\n   394\t    }\n   395\t}\n   396\t\n   397\t#[test]\n   398\tfn row26_boundary_interaction_exhaustive_plus_random() {\n   399\t    let l = libs();\n   400\t\n   401\t    // Full cross product of the boundary set on all three arguments.\n   402\t    for &bs in BOUNDARY_VALUES {\n   403\t        for &ch in BOUNDARY_VALUES {\n   404\t            for &bd in BOUNDARY_VALUES {\n   405\t                assert_same_triple(l, bs, ch, bd);\n   406\t            }\n   407\t        }\n   408\t    }\n   409\t\n   410\t    // Mixed: each argument independently either a boundary value or uniform\n   411\t    // random, so boundary/random interactions are covered too.\n   412\t    let mut rng = Rng::new(26);\n   413\t    for _ in 0..N {\n   414\t        let pick = |r: &mut Rng| {\n   415\t            if r.next_u64() & 1 == 0 {\n   416\t                r.pick(BOUNDARY_VALUES)\n   417\t            } else {\n   418\t                r.next_u32()\n   419\t            }\n   420\t        };\n   421\t        let bs = pick(&mut rng);\n   422\t        let ch = pick(&mut rng);\n   423\t        let bd = pick(&mut rng);\n   424\t        assert_same_triple(l, bs, ch, bd);\n   425\t    }\n   426\t}\n   427\t\n   428\t// ---------------------------------------------------------------------------\n   429\t// Sanity: the harness really is loading two distinct shared objects.\n   430\t// ---------------------------------------------------------------------------\n   431\t\n   432\t#[test]\n   433\tfn harness_loads_two_distinct_shared_objects() {\n   434\t    let l = libs();\n   435\t    println!(\"C   .so: {}\", l.c_path.display());\n   436\t    println!(\"Rust.so: {}\", l.rust_path.display());\n   437\t    assert_ne!(\n   438\t        l.c_path, l.rust_path,\n   439\t        \"the two libraries must be different files\"\n   440\t    );\n   441\t    assert!(l.c_path.is_file() && l.rust_path.is_file());\n   442\t    // Known-good spot check confirmed against the compiled C library.\n   443\t    assert_same_and_eq(l, 0, 0, 0, 18);\n   444\t    assert_same_and_eq(l, 4096, 2, 16, 16916);\n   445\t    assert_same_and_eq(l, 4096, 1, 16, 8211);\n   446\t    assert_same_and_eq(l, 4096, 2, 32, 32788);\n   447\t}","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01PLDPo4CCwxzE2Uqvw8Y7vS","session_id":"25e5a781-4f1a-46b6-8172-dcad34d2c3fa","uuid":"4f41d2a9-572a-468b-b03c-b80322b809f9","timestamp":"2026-08-19T13:37:43.693Z","subagent_type":"general-purpose","task_description":"Adversarial audit of C-to-Rust equivalence"}
