xFFFFFFFFull;\n    return (uint32_t)res;\n}\nstatic unsigned long long model_mm = 0;\nstatic int model_printed = 0;\nstatic inline void chk3(uint32_t b, uint32_t c, uint32_t d) {\n    uint32_t a = cfn(b, c, d);\n    uint32_t r = rfn(b, c, d);\n    uint32_t m = model(b, c, d);\n    checked++;\n    if (a != r) {\n        mismatches++;\n        if (printed < 40) { printed++;\n            printf(\"MISMATCH C-vs-RUST b=%\" PRIu32 \" c=%\" PRIu32 \" d=%\" PRIu32 \" : C=%\" PRIu32 \" RUST=%\" PRIu32 \"\\n\", b,c,d,a,r); }\n    }\n    if (a != m) {\n        model_mm++;\n        if (model_printed < 40) { model_printed++;\n            printf(\"MISMATCH C-vs-MODEL b=%\" PRIu32 \" c=%\" PRIu32 \" d=%\" PRIu32 \" : C=%\" PRIu32 \" MODEL=%\" PRIu32 \"\\n\", b,c,d,a,m); }\n    }\n}\n\nstatic uint64_t s0=0x243F6A8885A308D3ull, s1=0x13198A2E03707344ull;\nstatic inline uint64_t rnd(void){\n    uint64_t x=s0, y=s1; s0=y; x^=x<<23; x^=x>>17; x^=y; s1=x+y; return s1;\n}\n\nint main(int argc, char **argv) {\n    const char *cpath = argv[1];\n    const char *rpath = argv[2];\n    ch = dlopen(cpath, RTLD_NOW | RTLD_LOCAL);\n    if (!ch) { fprintf(stderr, \"dlopen C failed: %s\\n\", dlerror()); return 2; }\n    rh = dlopen(rpath, RTLD_NOW | RTLD_LOCAL);\n    if (!rh) { fprintf(stderr, \"dlopen R failed: %s\\n\", dlerror()); return 2; }\n    cfn = (fn_t)dlsym(ch, \"max_size_frame\");\n    rfn = (fn_t)dlsym(rh, \"max_size_frame\");\n    if (!cfn || !rfn) { fprintf(stderr, \"dlsym failed\\n\"); return 2; }\n    if ((void*)cfn == (void*)rfn) { fprintf(stderr, \"FATAL: both handles resolved to the SAME function pointer!\\n\"); return 3; }\n    printf(\"cfn=%p rfn=%p (distinct: %s)\\n\", (void*)cfn, (void*)rfn, ((void*)cfn!=(void*)rfn)?\"yes\":\"NO\");\n    /* self-check that the harness can detect a difference at all */\n    printf(\"sanity: C(1,2,3)=%u RUST(1,2,3)=%u MODEL=%u\\n\", cfn(1,2,3), rfn(1,2,3), model(1,2,3));\n\n    /* ---- interesting value set ---- */\n    uint32_t vals[512]; int n