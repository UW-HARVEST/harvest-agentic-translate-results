{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011pFW4u2yfKtedpLM3iQE3B","type":"tool_result","content":"     1\t//! Shared differential-test harness.\n     2\t//!\n     3\t//! Loads BOTH shared libraries via `libloading` and resolves `max_size_frame`\n     4\t//! from each. The Rust implementation is **never** called directly as a Rust\n     5\t//! function — it is always reached through `dlopen`/`dlsym` on the compiled\n     6\t//! `cdylib`, exactly as an external C consumer would, so the\n     7\t//! `#[unsafe(no_mangle)] extern \"C\"` export wrapper is under test too.\n     8\t\n     9\t#![allow(dead_code)]\n    10\t\n    11\tuse libloading::{Library, Symbol};\n    12\tuse std::path::{Path, PathBuf};\n    13\tuse std::process::Command;\n    14\tuse std::sync::OnceLock;\n    15\t\n    16\t/// ABI of the function under test: `tflac_u32 (tflac_u32, tflac_u32, tflac_u32)`.\n    17\tpub type MaxSizeFrameFn = unsafe extern \"C\" fn(u32, u32, u32) -> u32;\n    18\t\n    19\tpub struct Libs {\n    20\t    /// `max_size_frame` from the C shared library (ground truth).\n    21\t    c_fn: MaxSizeFrameFn,\n    22\t    /// `max_size_frame` from the Rust shared library (under test).\n    23\t    rust_fn: MaxSizeFrameFn,\n    24\t    pub c_path: PathBuf,\n    25\t    pub rust_path: PathBuf,\n    26\t    // Keep the handles alive for the whole process; the raw fn pointers above\n    27\t    // borrow from these.\n    28\t    _c_lib: Library,\n    29\t    _rust_lib: Library,\n    30\t}\n    31\t\n    32\timpl Libs {\n    33\t    /// Call the C implementation through the FFI boundary.\n    34\t    #[inline]\n    35\t    pub fn c(&self, blocksize: u32, channels: u32, bitdepth: u32) -> u32 {\n    36\t        unsafe { (self.c_fn)(blocksize, channels, bitdepth) }\n    37\t    }\n    38\t\n    39\t    /// Call the Rust implementation through the FFI boundary.\n    40\t    #[inline]\n    41\t    pub fn rust(&self, blocksize: u32, channels: u32, bitdepth: u32) -> u32 {\n    42\t        unsafe { (self.rust_fn)(blocksize, channels, bitdepth) }\n    43\t    }\n    44\t}\n    45\t\n    46\t/// Process-wide singleton so the libraries are `dlopen`ed once.\n    47\tpub fn libs() -> &'static Libs {\n    48\t    static LIBS: OnceLock<Libs> = OnceLock::new();\n    49\t    LIBS.get_or_init(load_libs)\n    50\t}\n    51\t\n    52\tfn manifest_dir() -> PathBuf {\n    53\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n    54\t}\n    55\t\n    56\t/// Locate the C `.so`, building it with CMake if it is not present yet.\n    57\tfn c_library_path() -> PathBuf {\n    58\t    let c_src = manifest_dir().join(\"c_src\");\n    59\t    let build = c_src.join(\"build\");\n    60\t\n    61\t    if let Some(found) = find_so(&build) {\n    62\t        return found;\n    63\t    }\n    64\t\n    65\t    // Not built yet: run the documented CMake build. Nothing inside c_src's\n    66\t    // sources is modified; only the (git-ignored) build/ directory is created.\n    67\t    std::fs::create_dir_all(&build).expect(\"create c_src/build\");\n    68\t    let conf = Command::new(\"cmake\")\n    69\t        .current_dir(&build)\n    70\t        .arg(\"..\")\n    71\t        .arg(\"-DCMAKE_POSITION_INDEPENDENT_CODE=ON\")\n    72\t        .output()\n    73\t        .expect(\"failed to spawn cmake (is cmake installed?)\");\n    74\t    assert!(\n    75\t        conf.status.success(),\n    76\t        \"cmake configure failed:\\n{}\\n{}\",\n    77\t        String::from_utf8_lossy(&conf.stdout),\n    78\t        String::from_utf8_lossy(&conf.stderr)\n    79\t    );\n    80\t    let built = Command::new(\"cmake\")\n    81\t        .current_dir(&build)\n    82\t        .args([\"--build\", \".\"])\n    83\t        .output()\n    84\t        .expect(\"failed to spawn cmake --build\");\n    85\t    assert!(\n    86\t        built.status.success(),\n    87\t        \"cmake --build failed:\\n{}\\n{}\",\n    88\t        String::from_utf8_lossy(&built.stdout),\n    89\t        String::from_utf8_lossy(&built.stderr)\n    90\t    );\n    91\t\n    92\t    find_so(&build).unwrap_or_else(|| {\n    93\t        panic!(\n    94\t            \"no .so produced in {}; build the C library manually per SYMBOLS.md\",\n    95\t            build.display()\n    96\t        )\n    97\t    })\n    98\t}\n    99\t\n   100\t/// Build (or rebuild) the Rust `cdylib` and return its path.\n   101\t///\n   102\t/// **Why this must build it explicitly:** the crate declares\n   103\t/// `crate-type = [\"cdylib\"]` only, so the integration-test binaries do not link\n   104\t/// against the library and `cargo test` therefore does **not** refresh\n   105\t/// `target/<profile>/libmax_size_frame_lib.so`. Loading whatever `.so` happened\n   106\t/// to be lying around silently tests a STALE binary — a mutation injected into\n   107\t/// `src/lib.rs` would go undetected and every test would pass vacuously.\n   108\t///\n   109\t/// So we drive `cargo build --lib` ourselves into a dedicated target directory\n   110\t/// (separate from the one the running `cargo test` owns, to avoid build-lock\n   111\t/// contention) and then *assert* the artifact is newer than every Rust source\n   112\t/// file. If the nested build cannot run, the freshness assertion still makes\n   113\t/// staleness a loud failure instead of a silent pass.\n   114\tfn rust_library_path() -> PathBuf {\n   115\t    let so_name = format!(\"{DLL_PREFIX}max_size_frame_lib{DLL_SUFFIX}\");\n   116\t    let target_dir = manifest_dir().join(\"target\").join(\"diff-so\");\n   117\t    let profile_dir = if cfg!(debug_assertions) {\n   118\t        \"debug\"\n   119\t    } else {\n   120\t        \"release\"\n   121\t    };\n   122\t    let so_path = target_dir.join(profile_dir).join(&so_name);\n   123\t\n   124\t    build_cdylib(&target_dir);\n   125\t\n   126\t    assert!(\n   127\t        so_path.is_file(),\n   128\t        \"nested `cargo build --lib` did not produce {}\",\n   129\t        so_path.display()\n   130\t    );\n   131\t    assert_fresher_than_sources(&so_path);\n   132\t    so_path\n   133\t}\n   134\t\n   135\t/// Feature flags to forward to the nested build so the `.so` under test matches\n   136\t/// the feature combination the current `cargo test` was invoked with. The\n   137\t/// runner script sets `DIFF_TEST_FEATURE_ARGS` (e.g.\n   138\t/// `--no-default-features --features foo,bar`).\n   139\tfn feature_args() -> Vec<String> {\n   140\t    match std::env::var(\"DIFF_TEST_FEATURE_ARGS\") {\n   141\t        Ok(s) => s.split_whitespace().map(str::to_string).collect(),\n   142\t        Err(_) => Vec::new(),\n   143\t    }\n   144\t}\n   145\t\n   146\tfn build_cdylib(target_dir: &Path) {\n   147\t    static BUILT: OnceLock<()> = OnceLock::new();\n   148\t    BUILT.get_or_init(|| {\n   149\t        let cargo = std::env::var(\"CARGO\").unwrap_or_else(|_| \"cargo\".to_string());\n   150\t\n   151\t        let run = |offline: bool| -> std::io::Result<std::process::Output> {\n   152\t            let mut cmd = Command::new(&cargo);\n   153\t            cmd.current_dir(manifest_dir())\n   154\t                .arg(\"build\")\n   155\t                .arg(\"--lib\")\n   156\t                .arg(\"--target-dir\")\n   157\t                .arg(target_dir);\n   158\t            if offline {\n   159\t                cmd.arg(\"--offline\");\n   160\t            }\n   161\t            if !cfg!(debug_assertions) {\n   162\t                cmd.arg(\"--release\");\n   163\t            }\n   164\t            cmd.args(feature_args());\n   165\t            // Don't inherit the outer invocation's target dir / feature env.\n   166\t            cmd.env_remove(\"CARGO_TARGET_DIR\");\n   167\t            cmd.env_remove(\"RUSTC_WORKSPACE_WRAPPER\");\n   168\t            cmd.output()\n   169\t        };\n   170\t\n   171\t        // Prefer --offline (this sandbox has no network); fall back if the local\n   172\t        // registry cache is incomplete.\n   173\t        let out = run(true).and_then(|o| if o.status.success() { Ok(o) } else { run(false) });\n   174\t\n   175\t        let out = out.expect(\"failed to spawn `cargo build --lib` for the cdylib under test\");\n   176\t        assert!(\n   177\t            out.status.success(),\n   178\t            \"nested `cargo build --lib` FAILED; the .so under test would be stale.\\n\\\n   179\t             stdout:\\n{}\\nstderr:\\n{}\",\n   180\t            String::from_utf8_lossy(&out.stdout),\n   181\t            String::from_utf8_lossy(&out.stderr)\n   182\t        );\n   183\t    });\n   184\t}\n   185\t\n   186\t/// Guard against silently testing a stale artifact.\n   187\tfn assert_fresher_than_sources(so_path: &Path) {\n   188\t    let so_mtime = std::fs::metadata(so_path)\n   189\t        .and_then(|m| m.modified())\n   190\t        .expect(\"stat .so\");\n   191\t\n   192\t    let mut newest: Option<(PathBuf, std::time::SystemTime)> = None;\n   193\t    collect_newest_rs(&manifest_dir().join(\"src\"), &mut newest);\n   194\t\n   195\t    if let Some((src, src_mtime)) = newest {\n   196\t        assert!(\n   197\t            so_mtime >= src_mtime,\n   198\t            \"STALE ARTIFACT: {} is older than {}.\\n\\\n   199\t             The tests would be validating an out-of-date library. Run `cargo build`.\",\n   200\t            so_path.display(),\n   201\t            src.display()\n   202\t        );\n   203\t    }\n   204\t}\n   205\t\n   206\tfn collect_newest_rs(dir: &Path, newest: &mut Option<(PathBuf, std::time::SystemTime)>) {\n   207\t    let Ok(entries) = std::fs::read_dir(dir) else {\n   208\t        return;\n   209\t    };\n   210\t    for e in entries.filter_map(|e| e.ok()) {\n   211\t        let p = e.path();\n   212\t        if p.is_dir() {\n   213\t            collect_newest_rs(&p, newest);\n   214\t        } else if p.extension().and_then(|x| x.to_str()) == Some(\"rs\") {\n   215\t            if let Ok(m) = std::fs::metadata(&p).and_then(|m| m.modified()) {\n   216\t                if newest.as_ref().map(|(_, t)| m > *t).unwrap_or(true) {\n   217\t                    *newest = Some((p, m));\n   218\t                }\n   219\t            }\n   220\t        }\n   221\t    }\n   222\t}\n   223\t\n   224\t#[cfg(target_os = \"linux\")]\n   225\tconst DLL_PREFIX: &str = \"lib\";\n   226\t#[cfg(target_os = \"linux\")]\n   227\tconst DLL_SUFFIX: &str = \".so\";\n   228\t#[cfg(target_os = \"macos\")]\n   229\tconst DLL_PREFIX: &str = \"lib\";\n   230\t#[cfg(target_os = \"macos\")]\n   231\tconst DLL_SUFFIX: &str = \".dylib\";\n   232\t#[cfg(target_os = \"windows\")]\n   233\tconst DLL_PREFIX: &str = \"\";\n   234\t#[cfg(target_os = \"windows\")]\n   235\tconst DLL_SUFFIX: &str = \".dll\";\n   236\t\n   237\tfn find_so(dir: &Path) -> Option<PathBuf> {\n   238\t    let entries = std::fs::read_dir(dir).ok()?;\n   239\t    let mut hits: Vec<PathBuf> = entries\n   240\t        .filter_map(|e| e.ok())\n   241\t        .map(|e| e.path())\n   242\t        .filter(|p| {\n   243\t            p.is_file()\n   244\t                && p.file_name()\n   245\t                    .and_then(|n| n.to_str())\n   246\t                    .map(|n| n.starts_with(DLL_PREFIX) && n.ends_with(DLL_SUFFIX))\n   247\t                    .unwrap_or(false)\n   248\t        })\n   249\t        .collect();\n   250\t    hits.sort();\n   251\t    hits.into_iter().next()\n   252\t}\n   253\t\n   254\tfn load_libs() -> Libs {\n   255\t    let c_path = c_library_path();\n   256\t    let rust_path = rust_library_path();\n   257\t\n   258\t    unsafe {\n   259\t        let c_lib = Library::new(&c_path)\n   260\t            .unwrap_or_else(|e| panic!(\"dlopen C lib {}: {e}\", c_path.display()));\n   261\t        let rust_lib = Library::new(&rust_path)\n   262\t            .unwrap_or_else(|e| panic!(\"dlopen Rust lib {}: {e}\", rust_path.display()));\n   263\t\n   264\t        let c_sym: Symbol<MaxSizeFrameFn> = c_lib.get(b\"max_size_frame\\0\").unwrap_or_else(|e| {\n   265\t            panic!(\"C lib {} has no `max_size_frame`: {e}\", c_path.display())\n   266\t        });\n   267\t        let rust_sym: Symbol<MaxSizeFrameFn> =\n   268\t            rust_lib.get(b\"max_size_frame\\0\").unwrap_or_else(|e| {\n   269\t                panic!(\n   270\t                    \"Rust lib {} does not export `max_size_frame`: {e}\",\n   271\t                    rust_path.display()\n   272\t                )\n   273\t            });\n   274\t\n   275\t        // Copy out the raw fn pointers (Copy + effectively 'static because the\n   276\t        // Library handles are moved into the returned struct and never dropped).\n   277\t        let c_fn: MaxSizeFrameFn = *c_sym;\n   278\t        let rust_fn: MaxSizeFrameFn = *rust_sym;\n   279\t\n   280\t        Libs {\n   281\t            c_fn,\n   282\t            rust_fn,\n   283\t            c_path,\n   284\t            rust_path,\n   285\t            _c_lib: c_lib,\n   286\t            _rust_lib: rust_lib,\n   287\t        }\n   288\t    }\n   289\t}\n   290\t\n   291\t// ---------------------------------------------------------------------------\n   292\t// Differential assertions\n   293\t// ---------------------------------------------------------------------------\n   294\t\n   295\t/// Assert C and Rust agree bit-for-bit for one input triple.\n   296\t#[inline]\n   297\t#[track_caller]\n   298\tpub fn assert_same(l: &Libs, blocksize: u32, channels: u32, bitdepth: u32) -> u32 {\n   299\t    let got_c = l.c(blocksize, channels, bitdepth);\n   300\t    let got_rust = l.rust(blocksize, channels, bitdepth);\n   301\t    assert_eq!(\n   302\t        got_c.to_ne_bytes(),\n   303\t        got_rust.to_ne_bytes(),\n   304\t        \"DIVERGENCE for max_size_frame(blocksize={blocksize}, channels={channels}, \\\n   305\t         bitdepth={bitdepth}) [hex: bs=0x{blocksize:08X} ch=0x{channels:08X} bd=0x{bitdepth:08X}]\\n\\\n   306\t         \\x20 C    = {got_c} (0x{got_c:08X})\\n\\\n   307\t         \\x20 Rust = {got_rust} (0x{got_rust:08X})\"\n   308\t    );\n   309\t    got_c\n   310\t}\n   311\t\n   312\t/// Assert C and Rust agree *and* that the shared value equals `expected`.\n   313\t/// Used by the error-surface rows that predict a concrete value.\n   314\t#[inline]\n   315\t#[track_caller]\n   316\tpub fn assert_same_and_eq(l: &Libs, blocksize: u32, channels: u32, bitdepth: u32, expected: u32) {\n   317\t    let got = assert_same(l, blocksize, channels, bitdepth);\n   318\t    assert_eq!(\n   319\t        got, expected,\n   320\t        \"both libraries agree ({got}) but the documented expectation for \\\n   321\t         max_size_frame({blocksize}, {channels}, {bitdepth}) is {expected}\"\n   322\t    );\n   323\t}\n   324\t\n   325\t/// Independent re-derivation of the C expression, used as a third opinion so a\n   326\t/// shared C/Rust bug cannot hide behind a pure A==B comparison.\n   327\t///\n   328\t/// Mirrors `c_src/src/lib.c` term by term in explicit wrapping arithmetic.\n   329\tpub fn oracle(blocksize: u32, channels: u32, bitdepth: u32) -> u32 {\n   330\t    let is_stereo: u32 = u32::from(channels == 2);\n   331\t    let not_stereo: u32 = u32::from(channels != 2);\n   332\t    let not_32: u32 = u32::from(bitdepth != 32);\n   333\t\n   334\t    let t1 = blocksize\n   335\t        .wrapping_mul(bitdepth)\n   336\t        .wrapping_mul(channels.wrapping_mul(not_stereo));\n   337\t    let t2 = blocksize.wrapping_mul(bitdepth).wrapping_mul(is_stereo);\n   338\t    let t3 = blocksize\n   339\t        .wrapping_mul(bitdepth.wrapping_add(not_32))\n   340\t        .wrapping_mul(is_stereo);\n   341\t\n   342\t    let numerator = t1.wrapping_add(t2).wrapping_add(t3).wrapping_add(7);\n   343\t    18u32.wrapping_add(channels).wrapping_add(numerator / 8)\n   344\t}\n   345\t\n   346\t/// Assert C == Rust == independent oracle.\n   347\t#[inline]\n   348\t#[track_caller]\n   349\tpub fn assert_same_triple(l: &Libs, blocksize: u32, channels: u32, bitdepth: u32) {\n   350\t    let got = assert_same(l, blocksize, channels, bitdepth);\n   351\t    let want = oracle(blocksize, channels, bitdepth);\n   352\t    assert_eq!(\n   353\t        got, want,\n   354\t        \"C and Rust agree ({got}) but the independent oracle says {want} for \\\n   355\t         max_size_frame({blocksize}, {channels}, {bitdepth})\"\n   356\t    );\n   357\t}\n   358\t\n   359\t// ---------------------------------------------------------------------------\n   360\t// Deterministic PRNG (splitmix64) — property-style testing with a fixed seed\n   361\t// ---------------------------------------------------------------------------\n   362\t\n   363\tpub struct Rng(u64);\n   364\t\n   365\t/// Base seed; each test adds a distinct salt so rows explore different points.\n   366\tpub const BASE_SEED: u64 = 0x5EED_C0FF_EE00_0000;\n   367\t\n   368\timpl Rng {\n   369\t    pub fn new(salt: u64) -> Self {\n   370\t        Rng(BASE_SEED ^ salt.wrapping_mul(0x9E37_79B9_7F4A_7C15))\n   371\t    }\n   372\t\n   373\t    #[inline]\n   374\t    pub fn next_u64(&mut self) -> u64 {\n   375\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n   376\t        let mut z = self.0;\n   377\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n   378\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n   379\t        z ^ (z >> 31)\n   380\t    }\n   381\t\n   382\t    /// Uniform over the whole 32-bit range.\n   383\t    #[inline]\n   384\t    pub fn next_u32(&mut self) -> u32 {\n   385\t        (self.next_u64() >> 32) as u32\n   386\t    }\n   387\t\n   388\t    /// Uniform in `lo..=hi`.\n   389\t    #[inline]\n   390\t    pub fn range(&mut self, lo: u32, hi: u32) -> u32 {\n   391\t        debug_assert!(lo <= hi);\n   392\t        let span = (hi - lo) as u64 + 1;\n   393\t        lo + (self.next_u64() % span) as u32\n   394\t    }\n   395\t\n   396\t    /// Pick a random element of a slice.\n   397\t    #[inline]\n   398\t    pub fn pick(&mut self, xs: &[u32]) -> u32 {\n   399\t        xs[(self.next_u64() % xs.len() as u64) as usize]\n   400\t    }\n   401\t}\n   402\t\n   403\t/// The interesting boundary values referenced by `CONFIGS.md` row 26 and by the\n   404\t/// error-surface table.\n   405\tpub const BOUNDARY_VALUES: &[u32] = &[\n   406\t    0,\n   407\t    1,\n   408\t    2,\n   409\t    3,\n   410\t    4,\n   411\t    7,\n   412\t    8,\n   413\t    31,\n   414\t    32,\n   415\t    33,\n   416\t    64,\n   417\t    4096,\n   418\t    65535,\n   419\t    65536,\n   420\t    0x7FFF_FFFF,\n   421\t    0x8000_0000,\n   422\t    0xFFFF_FFFE,\n   423\t    0xFFFF_FFFF,\n   424\t];\n   425\t\n   426\t/// Block sizes a real FLAC encoder emits.\n   427\tpub const FLAC_BLOCKSIZES: &[u32] = &[\n   428\t    192, 576, 1152, 2304, 4608, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65535,\n   429\t];\n   430\t\n   431\t/// Bit depths a real FLAC encoder emits.\n   432\tpub const FLAC_BITDEPTHS: &[u32] = &[4, 8, 12, 16, 20, 24, 32];","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01PLDPo4CCwxzE2Uqvw8Y7vS","session_id":"25e5a781-4f1a-46b6-8172-dcad34d2c3fa","uuid":"fdd071a8-d439-4397-bda0-ba14874e8cc7","timestamp":"2026-08-19T13:37:29.661Z","subagent_type":"general-purpose","task_description":"Adversarial audit of C-to-Rust equivalence"}
