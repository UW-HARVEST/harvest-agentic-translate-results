{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_stb2exxcgapighcgpdzm6t7ueredipvhnnqsb44tcprxihbo3mca","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Mgr5LYyBAUfGRxaa7fkjWP","name":"Bash","input":{"command":"cat -n tests/error_paths.rs","description":"Read error_paths.rs"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14063,"cache_read_input_tokens":59095,"cache_creation":{"ephemeral_5m_input_tokens":14063,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01PLDPo4CCwxzE2Uqvw8Y7vS","session_id":"25e5a781-4f1a-46b6-8172-dcad34d2c3fa","uuid":"1a2745c9-9ed3-41ba-ae59-373ac00c1319","timestamp":"2026-08-19T13:37:53.775Z","subagent_type":"general-purpose","task_description":"Adversarial audit of C-to-Rust equivalence"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Mgr5LYyBAUfGRxaa7fkjWP","type":"tool_result","content":"     1\t//! Phase C — error-path / rejection differential tests.\n     2\t//!\n     3\t//! One `#[test]` per row of `ERRORS.md`. The C source contains ZERO rejection\n     4\t//! sites (no error return, no assert, no range check — see `ERRORS.md` for the\n     5\t//! grep evidence), so `max_size_frame` is a total function. Each row therefore\n     6\t//! asserts that the Rust `.so` *also* accepts the degenerate/extreme/invalid\n     7\t//! input and returns the **same** 32-bit value, rather than panicking,\n     8\t//! overflow-trapping, saturating, or clamping.\n     9\t//!\n    10\t//! Every call goes through `libloading` into the two shared objects.\n    11\t\n    12\tmod common;\n    13\t\n    14\tuse common::*;\n    15\t\n    16\t// ---------------------------------------------------------------------------\n    17\t// Row 1 — the function is total: no input is rejected\n    18\t// ---------------------------------------------------------------------------\n    19\t\n    20\t#[test]\n    21\tfn row01_function_is_total_never_rejects() {\n    22\t    let l = libs();\n    23\t    let mut rng = Rng::new(101);\n    24\t    // Hammer the whole 96-bit input space; any panic/abort in either library\n    25\t    // (a Rust overflow panic in a debug build included) fails this test.\n    26\t    for _ in 0..100_000 {\n    27\t        let bs = rng.next_u32();\n    28\t        let ch = rng.next_u32();\n    29\t        let bd = rng.next_u32();\n    30\t        assert_same_triple(l, bs, ch, bd);\n    31\t    }\n    32\t    // Plus the full boundary cross product: 18^3 = 5832 calls, all must return.\n    33\t    for &bs in BOUNDARY_VALUES {\n    34\t        for &ch in BOUNDARY_VALUES {\n    35\t            for &bd in BOUNDARY_VALUES {\n    36\t                assert_same_triple(l, bs, ch, bd);\n    37\t            }\n    38\t        }\n    39\t    }\n    40\t}\n    41\t\n    42\t// ---------------------------------------------------------------------------\n    43\t// Rows 2-7 — zero / degenerate inputs (\"zero length\" analogues)\n    44\t// ---------------------------------------------------------------------------\n    45\t\n    46\t#[test]\n    47\tfn row02_blocksize_zero() {\n    48\t    let l = libs();\n    49\t    let mut rng = Rng::new(102);\n    50\t    for _ in 0..20_000 {\n    51\t        let ch = rng.next_u32();\n    52\t        let bd = rng.next_u32();\n    53\t        // Documented: result == 18 + channels (mod 2^32).\n    54\t        assert_same_and_eq(l, 0, ch, bd, 18u32.wrapping_add(ch));\n    55\t    }\n    56\t    for &ch in BOUNDARY_VALUES {\n    57\t        for &bd in BOUNDARY_VALUES {\n    58\t            assert_same_and_eq(l, 0, ch, bd, 18u32.wrapping_add(ch));\n    59\t        }\n    60\t    }\n    61\t}\n    62\t\n    63\t#[test]\n    64\tfn row03_channels_zero() {\n    65\t    let l = libs();\n    66\t    let mut rng = Rng::new(103);\n    67\t    for _ in 0..20_000 {\n    68\t        let bs = rng.next_u32();\n    69\t        let bd = rng.next_u32();\n    70\t        // Documented: result == 18 exactly, for every blocksize/bitdepth.\n    71\t        assert_same_and_eq(l, bs, 0, bd, 18);\n    72\t    }\n    73\t    for &bs in BOUNDARY_VALUES {\n    74\t        for &bd in BOUNDARY_VALUES {\n    75\t            assert_same_and_eq(l, bs, 0, bd, 18);\n    76\t        }\n    77\t    }\n    78\t}\n    79\t\n    80\t#[test]\n    81\tfn row04_bitdepth_zero_stereo() {\n    82\t    let l = libs();\n    83\t    let mut rng = Rng::new(104);\n    84\t    for _ in 0..20_000 {\n    85\t        let bs = rng.next_u32();\n    86\t        // T3 == blocksize * (0 + 1) * 1 == blocksize  =>  20 + (bs + 7) / 8\n    87\t        let expected = 20u32.wrapping_add(bs.wrapping_add(7) / 8);\n    88\t        assert_same_and_eq(l, bs, 2, 0, expected);\n    89\t    }\n    90\t}\n    91\t\n    92\t#[test]\n    93\tfn row05_bitdepth_zero_non_stereo() {\n    94\t    let l = libs();\n    95\t    let mut rng = Rng::new(105);\n    96\t    for _ in 0..20_000 {\n    97\t        let bs = rng.next_u32();\n    98\t        let mut ch = rng.next_u32();\n    99\t        if ch == 2 {\n   100\t            ch = 3;\n   101\t        }\n   102\t        // All terms vanish: result == 18 + channels.\n   103\t        assert_same_and_eq(l, bs, ch, 0, 18u32.wrapping_add(ch));\n   104\t    }\n   105\t}\n   106\t\n   107\t#[test]\n   108\tfn row06_all_args_zero() {\n   109\t    let l = libs();\n   110\t    assert_same_and_eq(l, 0, 0, 0, 18);\n   111\t}\n   112\t\n   113\t#[test]\n   114\tfn row07_zero_zero_max() {\n   115\t    let l = libs();\n   116\t    assert_same_and_eq(l, 0, 0, u32::MAX, 18);\n   117\t}\n   118\t\n   119\t// ---------------------------------------------------------------------------\n   120\t// Rows 8-13 — overflow / \"oversized value\" inputs\n   121\t// ---------------------------------------------------------------------------\n   122\t\n   123\t#[test]\n   124\tfn row08_channels_uint32_max_outer_overflow() {\n   125\t    let l = libs();\n   126\t    // 18 + 0xFFFFFFFF wraps to 17.\n   127\t    assert_same_and_eq(l, 0, u32::MAX, 0, 17);\n   128\t\n   129\t    let mut rng = Rng::new(108);\n   130\t    for _ in 0..20_000 {\n   131\t        let bs = rng.next_u32();\n   132\t        let bd = rng.next_u32();\n   133\t        assert_same_triple(l, bs, u32::MAX, bd);\n   134\t    }\n   135\t}\n   136\t\n   137\t#[test]\n   138\tfn row09_bitdepth_uint32_max_inner_overflow() {\n   139\t    let l = libs();\n   140\t    // bitdepth + (bitdepth != 32) == 0xFFFFFFFF + 1 == 0, so T3 == 0 and\n   141\t    // T2 == 1 * 0xFFFFFFFF == 0xFFFFFFFF; (0xFFFFFFFF + 7) wraps to 6; 6/8 == 0.\n   142\t    assert_same_and_eq(l, 1, 2, u32::MAX, 20);\n   143\t\n   144\t    let mut rng = Rng::new(109);\n   145\t    for _ in 0..20_000 {\n   146\t        let bs = rng.next_u32();\n   147\t        assert_same_triple(l, bs, 2, u32::MAX);\n   148\t        let mut ch = rng.next_u32();\n   149\t        if ch == 2 {\n   150\t            ch = 3;\n   151\t        }\n   152\t        assert_same_triple(l, bs, ch, u32::MAX);\n   153\t    }\n   154\t}\n   155\t\n   156\t#[test]\n   157\tfn row10_blocksize_uint32_max() {\n   158\t    let l = libs();\n   159\t    let mut rng = Rng::new(110);\n   160\t    for _ in 0..20_000 {\n   161\t        let ch = rng.next_u32();\n   162\t        let bd = rng.next_u32();\n   163\t        assert_same_triple(l, u32::MAX, ch, bd);\n   164\t    }\n   165\t    for &ch in BOUNDARY_VALUES {\n   166\t        for &bd in BOUNDARY_VALUES {\n   167\t            assert_same_triple(l, u32::MAX, ch, bd);\n   168\t        }\n   169\t    }\n   170\t}\n   171\t\n   172\t#[test]\n   173\tfn row11_all_args_uint32_max() {\n   174\t    let l = libs();\n   175\t    assert_same_triple(l, u32::MAX, u32::MAX, u32::MAX);\n   176\t}\n   177\t\n   178\t#[test]\n   179\tfn row12_product_overflow() {\n   180\t    let l = libs();\n   181\t    // 0x10000 * 0x10000 * 1 == 2^32 -> truncates to 0; numerator == 7; 7/8 == 0.\n   182\t    assert_same_and_eq(l, 0x10000, 1, 0x10000, 19);\n   183\t\n   184\t    // A spread of exactly-overflowing and just-past-overflowing products.\n   185\t    let interesting: &[u32] = &[\n   186\t        0x1_0000, 0x1_0001, 0x8000, 0x2_0000, 0x400, 0x10, 0xFFFF, 0x1_0000_0000u64 as u32,\n   187\t    ];\n   188\t    for &bs in interesting {\n   189\t        for &bd in interesting {\n   190\t            for ch in [0u32, 1, 2, 3, 4, 8, 0x1_0000] {\n   191\t                assert_same_triple(l, bs, ch, bd);\n   192\t            }\n   193\t        }\n   194\t    }\n   195\t\n   196\t    // Randomized products that are guaranteed to exceed 32 bits.\n   197\t    let mut rng = Rng::new(112);\n   198\t    for _ in 0..20_000 {\n   199\t        let bs = rng.range(1 << 16, u32::MAX);\n   200\t        let bd = rng.range(1 << 16, u32::MAX);\n   201\t        let ch = rng.range(0, 8);\n   202\t        assert_same_triple(l, bs, ch, bd);\n   203\t    }\n   204\t}\n   205\t\n   206\t#[test]\n   207\tfn row13_numerator_plus_seven_overflow() {\n   208\t    let l = libs();\n   209\t    // channels == 1, bitdepth == 1 => numerator == blocksize + 7.\n   210\t    // For blocksize in [MAX-6, MAX] the +7 wraps, so the quotient is tiny.\n   211\t    for bs in (u32::MAX - 6)..=u32::MAX {\n   212\t        let expected = 19u32.wrapping_add(bs.wrapping_add(7) / 8);\n   213\t        assert_same_and_eq(l, bs, 1, 1, expected);\n   214\t    }\n   215\t    // blocksize == MAX: (0xFFFFFFFF + 7) == 6 -> 6/8 == 0 -> 18 + 1 + 0 == 19.\n   216\t    assert_same_and_eq(l, u32::MAX, 1, 1, 19);\n   217\t    // The stereo instance of the same wrap.\n   218\t    assert_same_and_eq(l, 1, 2, u32::MAX, 20);\n   219\t}\n   220\t\n   221\t// ---------------------------------------------------------------------------\n   222\t// Rows 14-18 — one step past the only range-like constants in the source\n   223\t// ---------------------------------------------------------------------------\n   224\t\n   225\t#[test]\n   226\tfn row14_channels_one_below_two() {\n   227\t    let l = libs();\n   228\t    let mut rng = Rng::new(114);\n   229\t    for _ in 0..20_000 {\n   230\t        let bs = rng.next_u32();\n   231\t        let bd = rng.next_u32();\n   232\t        assert_same_triple(l, bs, 1, bd);\n   233\t    }\n   234\t}\n   235\t\n   236\t#[test]\n   237\tfn row15_channels_one_above_two() {\n   238\t    let l = libs();\n   239\t    let mut rng = Rng::new(115);\n   240\t    for _ in 0..20_000 {\n   241\t        let bs = rng.next_u32();\n   242\t        let bd = rng.next_u32();\n   243\t        assert_same_triple(l, bs, 3, bd);\n   244\t    }\n   245\t}\n   246\t\n   247\t#[test]\n   248\tfn row16_bitdepth_adjacent_to_32() {\n   249\t    let l = libs();\n   250\t    let mut rng = Rng::new(116);\n   251\t    for _ in 0..20_000 {\n   252\t        let bs = rng.next_u32();\n   253\t        for ch in [0u32, 1, 2, 3, 8] {\n   254\t            for bd in [31u32, 33] {\n   255\t                assert_same_triple(l, bs, ch, bd);\n   256\t            }\n   257\t        }\n   258\t    }\n   259\t}\n   260\t\n   261\t#[test]\n   262\tfn row17_bitdepth_exactly_32() {\n   263\t    let l = libs();\n   264\t    let mut rng = Rng::new(117);\n   265\t    for _ in 0..20_000 {\n   266\t        let bs = rng.next_u32();\n   267\t        let ch = rng.next_u32();\n   268\t        assert_same_triple(l, bs, ch, 32);\n   269\t    }\n   270\t    // The 31 / 32 / 33 discontinuity must be reproduced exactly.\n   271\t    for bs in 1..=512u32 {\n   272\t        for bd in [31u32, 32, 33] {\n   273\t            assert_same_triple(l, bs, 2, bd);\n   274\t        }\n   275\t    }\n   276\t}\n   277\t\n   278\t#[test]\n   279\tfn row18_channels_exactly_2() {\n   280\t    let l = libs();\n   281\t    let mut rng = Rng::new(118);\n   282\t    for _ in 0..20_000 {\n   283\t        let bs = rng.next_u32();\n   284\t        let bd = rng.next_u32();\n   285\t        assert_same_triple(l, bs, 2, bd);\n   286\t    }\n   287\t    // The 1 / 2 / 3 discontinuity must be reproduced exactly.\n   288\t    for bs in 1..=512u32 {\n   289\t        for ch in [1u32, 2, 3] {\n   290\t            assert_same_triple(l, bs, ch, 16);\n   291\t        }\n   292\t    }\n   293\t}\n   294\t\n   295\t// ---------------------------------------------------------------------------\n   296\t// Rows 19-21 — FFI-boundary robustness (enum / null / signedness analogues)\n   297\t// ---------------------------------------------------------------------------\n   298\t\n   299\t/// Stand-in for \"out-of-range enum value passed across FFI\". No parameter is an\n   300\t/// enum here: all three are `uint32_t`, so *every* one of the 2^32 bit patterns\n   301\t/// is a legal input with no invalid variant, and none may be rejected. This\n   302\t/// sweeps hostile bit patterns (all-ones, alternating, single-bit, sign-bit).\n   303\t#[test]\n   304\tfn row19_arbitrary_bit_patterns_no_invalid_variant() {\n   305\t    let l = libs();\n   306\t\n   307\t    let mut patterns: Vec<u32> = vec![\n   308\t        0x0000_0000,\n   309\t        0xFFFF_FFFF,\n   310\t        0xAAAA_AAAA,\n   311\t        0x5555_5555,\n   312\t        0xDEAD_BEEF,\n   313\t        0xCAFE_BABE,\n   314\t        0x8000_0000,\n   315\t        0x7FFF_FFFF,\n   316\t        0xFFFF_0000,\n   317\t        0x0000_FFFF,\n   318\t        0xFF00_FF00,\n   319\t        0x00FF_00FF,\n   320\t    ];\n   321\t    // Every single-bit pattern.\n   322\t    for shift in 0..32u32 {\n   323\t        patterns.push(1u32 << shift);\n   324\t        patterns.push(!(1u32 << shift));\n   325\t    }\n   326\t\n   327\t    for &bs in &patterns {\n   328\t        for &ch in &patterns {\n   329\t            for &bd in &patterns {\n   330\t                assert_same_triple(l, bs, ch, bd);\n   331\t            }\n   332\t        }\n   333\t    }\n   334\t}\n   335\t\n   336\t/// ABI analogue of passing `NULL`: the all-zero-bits argument triple.\n   337\t#[test]\n   338\tfn row20_all_zero_bits_null_analogue() {\n   339\t    let l = libs();\n   340\t    assert_same_and_eq(l, 0, 0, 0, 18);\n   341\t    // Zero in each argument position individually, with hostile values elsewhere.\n   342\t    assert_same_triple(l, 0, u32::MAX, u32::MAX);\n   343\t    assert_same_triple(l, u32::MAX, 0, u32::MAX);\n   344\t    assert_same_triple(l, u32::MAX, u32::MAX, 0);\n   345\t}\n   346\t\n   347\t/// Values above `INT32_MAX` must be treated as unsigned: a signed\n   348\t/// misinterpretation (or a `c_int`-typed wrapper) would sign-extend and diverge.\n   349\t#[test]\n   350\tfn row21_values_above_int32_max_no_sign_extension() {\n   351\t    let l = libs();\n   352\t    let high: &[u32] = &[\n   353\t        0x8000_0000,\n   354\t        0x8000_0001,\n   355\t        0xC000_0000,\n   356\t        0xFFFF_FFFE,\n   357\t        0xFFFF_FFFF,\n   358\t        0x9999_9999,\n   359\t    ];\n   360\t    for &bs in high {\n   361\t        for &ch in high {\n   362\t            for &bd in high {\n   363\t                assert_same_triple(l, bs, ch, bd);\n   364\t            }\n   365\t        }\n   366\t    }\n   367\t    // Mixed high/low so a bad widening of any single parameter shows up.\n   368\t    for &v in high {\n   369\t        for low in [0u32, 1, 2, 3, 16, 32] {\n   370\t            assert_same_triple(l, v, low, low);\n   371\t            assert_same_triple(l, low, v, low);\n   372\t            assert_same_triple(l, low, low, v);\n   373\t        }\n   374\t    }\n   375\t    // The result must also never be interpreted as signed: check a case whose\n   376\t    // return value has the top bit set.\n   377\t    let big = l.c(0xFFFF_FFFF, 0x8000_0000, 1);\n   378\t    assert_eq!(big, l.rust(0xFFFF_FFFF, 0x8000_0000, 1));\n   379\t    assert!(big & 0x8000_0000 != 0, \"expected a result with the sign bit set, got {big:#X}\");\n   380\t}","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01PLDPo4CCwxzE2Uqvw8Y7vS","session_id":"25e5a781-4f1a-46b6-8172-dcad34d2c3fa","uuid":"e2dc4c40-e917-436f-8ba3-5b3a5d0af2b5","timestamp":"2026-08-19T13:37:53.845Z","subagent_type":"general-purpose","task_description":"Adversarial audit of C-to-Rust equivalence"}
