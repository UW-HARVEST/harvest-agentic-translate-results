{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LWJpSskzFDvhk1uMcuxahJ","type":"tool_result","content":"     1\t//! Optional deep sweeps: exhaustively enumerate an ENTIRE 32-bit argument axis.\n     2\t//!\n     3\t//! Rationale. Expanding the C expression shows the three terms share the\n     4\t//! `blocksize` factor:\n     5\t//!\n     6\t//! ```text\n     7\t//! T1 + T2 + T3 = blocksize * M   (mod 2^32)\n     8\t//! M = bitdepth*channels*(channels!=2)\n     9\t//!   + bitdepth*(channels==2)\n    10\t//!   + (bitdepth + (bitdepth!=32))*(channels==2)\n    11\t//! f(bs, ch, bd) = 18 + ch + ((bs * M + 7) / 8)      (all mod 2^32)\n    12\t//! ```\n    13\t//!\n    14\t//! So the whole function is determined by `channels` and the single derived\n    15\t//! multiplier `M`. Sweeping one axis exhaustively while the others are pinned to\n    16\t//! representative values therefore covers a very large, structurally meaningful\n    17\t//! slice of the 2^96 input space.\n    18\t//!\n    19\t//! These tests are `#[ignore]`d because they take minutes; run them with:\n    20\t//!\n    21\t//! ```sh\n    22\t//! cargo test --release --offline --test exhaustive_axis -- --ignored --nocapture\n    23\t//! ```\n    24\t\n    25\tmod common;\n    26\t\n    27\tuse common::*;\n    28\tuse std::time::Instant;\n    29\t\n    30\t/// Sweep every one of the 2^32 `blocksize` values for a handful of\n    31\t/// (channels, bitdepth) pairs that cover both stereo predicates, the\n    32\t/// `bitdepth == 32` predicate, and the degenerate cases.\n    33\t#[test]\n    34\t#[ignore = \"exhaustive 2^32 sweep; run explicitly with --release --ignored\"]\n    35\tfn exhaustive_all_blocksizes() {\n    36\t    let l = libs();\n    37\t    let pairs: &[(u32, u32)] = &[\n    38\t        (2, 32),        // stereo, bitdepth == 32 (T3 keeps bitdepth)\n    39\t        (2, 16),        // stereo, bitdepth != 32 (T3 uses bitdepth + 1)\n    40\t        (2, 0),         // stereo, bitdepth == 0  (T3 == blocksize)\n    41\t        (2, u32::MAX),  // stereo, inner +1 wraps to 0\n    42\t        (1, 16),        // mono\n    43\t        (3, 24),        // non-stereo multi-channel\n    44\t        (0, 16),        // channels == 0, everything vanishes\n    45\t        (u32::MAX, 1),  // outer 18 + channels wraps\n    46\t    ];\n    47\t\n    48\t    for &(ch, bd) in pairs {\n    49\t        let t0 = Instant::now();\n    50\t        let mut bs: u32 = 0;\n    51\t        loop {\n    52\t            let c = l.c(bs, ch, bd);\n    53\t            let r = l.rust(bs, ch, bd);\n    54\t            if c != r {\n    55\t                panic!(\n    56\t                    \"DIVERGENCE at max_size_frame({bs}, {ch}, {bd}): C={c} Rust={r}\"\n    57\t                );\n    58\t            }\n    59\t            if bs == u32::MAX {\n    60\t                break;\n    61\t            }\n    62\t            bs += 1;\n    63\t        }\n    64\t        println!(\n    65\t            \"channels={ch}, bitdepth={bd}: all 2^32 blocksizes match ({:?})\",\n    66\t            t0.elapsed()\n    67\t        );\n    68\t    }\n    69\t}\n    70\t\n    71\t/// Sweep every one of the 2^32 `bitdepth` values for representative\n    72\t/// (blocksize, channels) pairs.\n    73\t#[test]\n    74\t#[ignore = \"exhaustive 2^32 sweep; run explicitly with --release --ignored\"]\n    75\tfn exhaustive_all_bitdepths() {\n    76\t    let l = libs();\n    77\t    let pairs: &[(u32, u32)] = &[\n    78\t        (4096, 2),      // stereo, realistic blocksize\n    79\t        (4096, 1),      // mono\n    80\t        (4096, 3),      // non-stereo\n    81\t        (1, 2),         // smallest non-zero blocksize, stereo\n    82\t        (u32::MAX, 2),  // blocksize wraps the products, stereo\n    83\t        (0, 2),         // blocksize == 0\n    84\t    ];\n    85\t\n    86\t    for &(bs, ch) in pairs {\n    87\t        let t0 = Instant::now();\n    88\t        let mut bd: u32 = 0;\n    89\t        loop {\n    90\t            let c = l.c(bs, ch, bd);\n    91\t            let r = l.rust(bs, ch, bd);\n    92\t            if c != r {\n    93\t                panic!(\n    94\t                    \"DIVERGENCE at max_size_frame({bs}, {ch}, {bd}): C={c} Rust={r}\"\n    95\t                );\n    96\t            }\n    97\t            if bd == u32::MAX {\n    98\t                break;\n    99\t            }\n   100\t            bd += 1;\n   101\t        }\n   102\t        println!(\n   103\t            \"blocksize={bs}, channels={ch}: all 2^32 bitdepths match ({:?})\",\n   104\t            t0.elapsed()\n   105\t        );\n   106\t    }\n   107\t}\n   108\t\n   109\t/// Sweep every one of the 2^32 `channels` values for representative\n   110\t/// (blocksize, bitdepth) pairs. This is the axis that feeds BOTH the `T1`\n   111\t/// multiplier and the outer `18U + channels`, so it exercises the two wrap\n   112\t/// sites simultaneously.\n   113\t#[test]\n   114\t#[ignore = \"exhaustive 2^32 sweep; run explicitly with --release --ignored\"]\n   115\tfn exhaustive_all_channels() {\n   116\t    let l = libs();\n   117\t    let pairs: &[(u32, u32)] = &[\n   118\t        (4096, 16),\n   119\t        (4096, 32),\n   120\t        (1, 1),\n   121\t        (u32::MAX, u32::MAX),\n   122\t        (0, 16),\n   123\t    ];\n   124\t\n   125\t    for &(bs, bd) in pairs {\n   126\t        let t0 = Instant::now();\n   127\t        let mut ch: u32 = 0;\n   128\t        loop {\n   129\t            let c = l.c(bs, ch, bd);\n   130\t            let r = l.rust(bs, ch, bd);\n   131\t            if c != r {\n   132\t                panic!(\n   133\t                    \"DIVERGENCE at max_size_frame({bs}, {ch}, {bd}): C={c} Rust={r}\"\n   134\t                );\n   135\t            }\n   136\t            if ch == u32::MAX {\n   137\t                break;\n   138\t            }\n   139\t            ch += 1;\n   140\t        }\n   141\t        println!(\n   142\t            \"blocksize={bs}, bitdepth={bd}: all 2^32 channels match ({:?})\",\n   143\t            t0.elapsed()\n   144\t        );\n   145\t    }\n   146\t}\n   147\t\n   148\t/// Exhaustively cover the derived multiplier `M` for the stereo path by sweeping\n   149\t/// all 2^32 `bitdepth` values at `blocksize == 1`, where the quotient is\n   150\t/// `(M + 7) / 8` and every distinct `M` is therefore directly observable.\n   151\t#[test]\n   152\t#[ignore = \"exhaustive 2^32 sweep; run explicitly with --release --ignored\"]\n   153\tfn exhaustive_multiplier_stereo() {\n   154\t    let l = libs();\n   155\t    let t0 = Instant::now();\n   156\t    let mut bd: u32 = 0;\n   157\t    loop {\n   158\t        let c = l.c(1, 2, bd);\n   159\t        let r = l.rust(1, 2, bd);\n   160\t        assert_eq!(c, r, \"DIVERGENCE at max_size_frame(1, 2, {bd})\");\n   161\t        if bd == u32::MAX {\n   162\t            break;\n   163\t        }\n   164\t        bd += 1;\n   165\t    }\n   166\t    println!(\"stereo multiplier M: all 2^32 bitdepths match ({:?})\", t0.elapsed());\n   167\t}\n########## symbol_parity\n     1\t//! Phase D — symbol parity, enforced mechanically on every test run.\n     2\t//!\n     3\t//! Runs `nm -D` on both shared objects and asserts the symbol diff\n     4\t//! (C-exported minus Rust-exported) is EMPTY, and that the Rust `.so` has no\n     5\t//! missing/undefined non-libc symbols.\n     6\t\n     7\tmod common;\n     8\t\n     9\tuse common::*;\n    10\tuse std::collections::BTreeSet;\n    11\tuse std::path::Path;\n    12\tuse std::process::Command;\n    13\t\n    14\t/// Parse `nm -D --defined-only <so>` into the set of exported symbol names.\n    15\tfn defined_symbols(so: &Path) -> BTreeSet<String> {\n    16\t    nm(so, &[\"-D\", \"--defined-only\"])\n    17\t}\n    18\t\n    19\t/// Parse `nm -D --undefined-only <so>` into the set of imported symbol names.\n    20\tfn undefined_symbols(so: &Path) -> BTreeSet<String> {\n    21\t    nm(so, &[\"-D\", \"--undefined-only\"])\n    22\t}\n    23\t\n    24\tfn nm(so: &Path, args: &[&str]) -> BTreeSet<String> {\n    25\t    let out = Command::new(\"nm\")\n    26\t        .args(args)\n    27\t        .arg(so)\n    28\t        .output()\n    29\t        .unwrap_or_else(|e| panic!(\"failed to run nm on {}: {e}\", so.display()));\n    30\t    assert!(\n    31\t        out.status.success(),\n    32\t        \"nm {:?} {} failed: {}\",\n    33\t        args,\n    34\t        so.display(),\n    35\t        String::from_utf8_lossy(&out.stderr)\n    36\t    );\n    37\t    String::from_utf8_lossy(&out.stdout)\n    38\t        .lines()\n    39\t        .filter_map(|line| {\n    40\t            // Formats: \"<addr> <type> <name>\" or \"                 <type> <name>\"\n    41\t            let mut parts = line.split_whitespace().collect::<Vec<_>>();\n    42\t            let name = parts.pop()?;\n    43\t            // Require a type letter to be present so blank lines are skipped.\n    44\t            let ty = parts.pop()?;\n    45\t            if ty.len() != 1 {\n    46\t                return None;\n    47\t            }\n    48\t            Some(name.to_string())\n    49\t        })\n    50\t        .collect()\n    51\t}\n    52\t\n    53\t/// Symbols that are toolchain/CRT/libc glue rather than library API.\n    54\tfn is_runtime_glue(name: &str) -> bool {\n    55\t    const GLUE: &[&str] = &[\n    56\t        \"_ITM_deregisterTMCloneTable\",\n    57\t        \"_ITM_registerTMCloneTable\",\n    58\t        \"__gmon_start__\",\n    59\t        \"_init\",\n    60\t        \"_fini\",\n    61\t        \"__bss_start\",\n    62\t        \"_edata\",\n    63\t        \"_end\",\n    64\t    ];\n    65\t    if GLUE.contains(&name) {\n    66\t        return true;\n    67\t    }\n    68\t    // Versioned / reserved names: libc imports (memcpy@GLIBC_2.2.5), Rust std\n    69\t    // internals, and anything in the implementation-reserved `__` namespace.\n    70\t    name.contains('@')\n    71\t        || name.starts_with(\"__\")\n    72\t        || name.starts_with(\"_ZN\")\n    73\t        || name.starts_with(\"_R\")\n    74\t        || name.starts_with(\"rust_\")\n    75\t        || name.starts_with(\"_rust_\")\n    76\t}\n    77\t\n    78\t#[test]\n    79\tfn every_c_exported_symbol_is_exported_by_rust() {\n    80\t    let l = libs();\n    81\t\n    82\t    let c_syms = defined_symbols(&l.c_path);\n    83\t    let rust_syms = defined_symbols(&l.rust_path);\n    84\t\n    85\t    // Only compare real API symbols, not CRT glue emitted by either toolchain.\n    86\t    let c_api: BTreeSet<&String> = c_syms.iter().filter(|s| !is_runtime_glue(s)).collect();\n    87\t    let rust_api: BTreeSet<&String> = rust_syms.iter().filter(|s| !is_runtime_glue(s)).collect();\n    88\t\n    89\t    println!(\"C   .so ({}) exports: {:?}\", l.c_path.display(), c_api);\n    90\t    println!(\"Rust.so ({}) exports: {:?}\", l.rust_path.display(), rust_api);\n    91\t\n    92\t    let missing: Vec<&&String> = c_api.difference(&rust_api).collect();\n    93\t    assert!(\n    94\t        missing.is_empty(),\n    95\t        \"the Rust .so is MISSING {} symbol(s) exported by the C .so: {:?}\\n\\\n    96\t         Each must be either exported with #[unsafe(no_mangle)] extern \\\"C\\\" or, if the \\\n    97\t         whole C module was never translated, translated now.\",\n    98\t        missing.len(),\n    99\t        missing\n   100\t    );\n   101\t\n   102\t    // The C library's public surface is exactly one function; assert we really\n   103\t    // compared something rather than two empty sets.\n   104\t    assert!(\n   105\t        c_api.contains(&\"max_size_frame\".to_string()),\n   106\t        \"expected `max_size_frame` in the C exports, got {c_api:?}\"\n   107\t    );\n   108\t    assert_eq!(\n   109\t        c_api.len(),\n   110\t        1,\n   111\t        \"the C .so's API surface changed; update SYMBOLS.md: {c_api:?}\"\n   112\t    );\n   113\t}\n   114\t\n   115\t#[test]\n   116\tfn rust_so_has_no_missing_non_libc_symbols() {\n   117\t    let l = libs();\n   118\t\n   119\t    let undef = undefined_symbols(&l.rust_path);\n   120\t    let unresolved: Vec<&String> = undef.iter().filter(|s| !is_runtime_glue(s)).collect();\n   121\t\n   122\t    println!(\"Rust.so undefined (raw): {undef:?}\");\n   123\t    assert!(\n   124\t        unresolved.is_empty(),\n   125\t        \"Rust .so has unresolved non-libc symbols: {unresolved:?}\"\n   126\t    );\n   127\t}\n   128\t\n   129\t#[test]\n   130\tfn c_so_has_no_missing_non_libc_symbols() {\n   131\t    let l = libs();\n   132\t    let undef = undefined_symbols(&l.c_path);\n   133\t    let unresolved: Vec<&String> = undef.iter().filter(|s| !is_runtime_glue(s)).collect();\n   134\t    println!(\"C.so undefined (raw): {undef:?}\");\n   135\t    assert!(\n   136\t        unresolved.is_empty(),\n   137\t        \"C .so has unresolved non-libc symbols: {unresolved:?}\"\n   138\t    );\n   139\t}\n   140\t\n   141\t/// The exported Rust symbol must be reachable by the *exact* C name via dlsym —\n   142\t/// already exercised by every other test, asserted explicitly here.\n   143\t#[test]\n   144\tfn rust_symbol_resolves_under_exact_c_name() {\n   145\t    let l = libs();\n   146\t    // If the name were mangled or renamed, `libs()` would have panicked during\n   147\t    // dlsym; calling it proves the wrapper has the right ABI as well.\n   148\t    assert_eq!(l.c(4096, 2, 16), l.rust(4096, 2, 16));\n   149\t}","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01PLDPo4CCwxzE2Uqvw8Y7vS","session_id":"25e5a781-4f1a-46b6-8172-dcad34d2c3fa","uuid":"32597a76-db7c-442a-b1c0-e697439893b3","timestamp":"2026-08-19T13:37:44.674Z","subagent_type":"general-purpose","task_description":"Adversarial audit of C-to-Rust equivalence"}
