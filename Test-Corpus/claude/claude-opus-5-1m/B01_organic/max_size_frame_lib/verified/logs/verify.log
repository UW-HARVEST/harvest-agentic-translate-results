= 2^32-1\"},\n        {17u,252645135u,\"17*252645135 = 2^32-1\"},\n        {257u,16711935u,\"257*16711935 = 2^32-1\"},\n        {1u,0xFFFFFFFFu,\"1*(2^32-1)\"},\n        {0xFFFFFFFFu,1u,\"(2^32-1)*1\"},\n        {65537u,65534u,\"term3 inner: 65534+1=65535 -> 2^32-1\"},\n        {1u,0xFFFFFFFEu,\"inner wraps? 0xFFFFFFFE+1=0xFFFFFFFF\"},\n        {1u,0xFFFFFFFFu,\"inner 0xFFFFFFFF+1 = 0 wrap\"},\n        {2u,0x7FFFFFFFu,\"2*(2^31-1) = 2^32-2\"},\n        {0x7FFFFFFFu,2u,\"= 2^32-2\"},\n        {0x80000000u,3u,\"2^31*3 = 2^32+2^31 -> 2^31\"},\n        {3u,0x80000000u,\"-> 2^31\"},\n    };\n    uint32_t chans[] = {0u,1u,2u,3u,4u,5u,0x7FFFFFFFu,0x80000000u,0xFFFFFFFFu,0xFFFFFFFEu,7u,8u,9u,6u};\n    for (size_t i = 0; i < sizeof(pr)/sizeof(pr[0]); i++)\n        for (size_t c = 0; c < sizeof(chans)/sizeof(chans[0]); c++)\n            chk3(pr[i].b, chans[c], pr[i].d);\n    /* also target numerator == 2^32-1, 2^32-8, 2^32-7 boundaries by brute-force near-misses\n       using channels==2 branch: numerator = bs*bd + bs*(bd+(bd!=32)) + 7 */\n    for (uint32_t bs = 1; bs <= 4096; bs++) {\n        for (uint32_t bd = 0; bd < 64; bd++) chk3(bs, 2u, bd);\n    }\n    printf(\"[phase2 targeted] checked=%llu mismatch=%llu model_mismatch=%llu\\n\", checked, mismatches, model_mm);\n\n    /* ---- channels in {0,1,2,3} x bitdepth in {0,31,32,33,0xFFFFFFFF} x wide blocksize ---- */\n    uint32_t bds[] = {0u,31u,32u,33u,0xFFFFFFFFu,0xFFFFFFFEu,1u,2u,8u};\n    for (uint32_t c = 0; c <= 3; c++)\n      for (size_t d = 0; d < sizeof(bds)/sizeof(bds[0]); d++)\n        for (int i = 0; i < n; i++)\n          chk3(vals[i], c, bds[d]);\n    printf(\"[phase3] checked=%llu mismatch=%llu model_mismatch=%llu\\n\", checked, mismatches, model_mm);\n\n    /* ---- random ---- */\n    long long NR = (argc > 3) ? atoll(argv[3]) : 2000000LL;\n    for (long long i = 0; i < NR; i++) {\n        uint64_t a = rnd(), b = rnd();\n        uint32_t B = (uint32_t)a, C = (uint32_t)(a >> 32), D = (uint32_t)b;\n        /* b