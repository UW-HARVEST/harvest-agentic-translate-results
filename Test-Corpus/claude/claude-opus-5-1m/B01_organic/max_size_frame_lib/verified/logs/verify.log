or diagnostics.","+fn list_so(dir: &Path) -> Vec<String> {","+    std::fs::read_dir(dir)","+        .map(|entries| {","+            entries","+                .filter_map(|e| e.ok())","+                .map(|e| e.file_name().to_string_lossy().to_string())","+                .filter(|n| n.ends_with(DLL_SUFFIX))","+                .collect()","+        })","+        .unwrap_or_default()","+}","+"," /// Build (or rebuild) the Rust `cdylib` and return its path."," ///"," /// **Why this must build it explicitly:** the crate declares"]}],"userModified":false,"replaceAll":false}}
