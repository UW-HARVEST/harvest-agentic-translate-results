{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012UVZDvEGwx5CDLiDmpwZKC","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! Public ABI surface (as exported by the C shared library):\n4\t//!   * `max_size_frame`\n5\t//!\n6\t//! The C header declares:\n7\t//! ```c\n8\t//! #include <stdint.h>\n9\t//! typedef uint32_t tflac_u32;\n10\t//! tflac_u32 max_size_frame(tflac_u32 blocksize, tflac_u32 channels, tflac_u32 bitdepth);\n11\t//! ```\n12\t//!\n13\t//! There are no namespace-renaming preprocessor macros in the public header, so\n14\t//! the final linker symbol name is identical to the source-level name.\n15\t\n16\t#![allow(non_camel_case_types)]\n17\t\n18\t/// `typedef uint32_t tflac_u32;`\n19\tpub type tflac_u32 = u32;\n20\t\n21\t/// C relational/equality operators yield `int` 1 or 0. Because every operand in\n22\t/// the expression below is a `uint32_t`, the usual arithmetic conversions turn\n23\t/// each of those `int` results back into `uint32_t`, so all of the arithmetic is\n24\t/// performed in unsigned 32-bit (wrapping) arithmetic.\n25\t#[inline(always)]\n26\tconst fn c_bool(b: bool) -> u32 {\n27\t    if b { 1 } else { 0 }\n28\t}\n29\t\n30\t/// Direct translation of:\n31\t///\n32\t/// ```c\n33\t/// tflac_u32 max_size_frame(tflac_u32 blocksize, tflac_u32 channels, tflac_u32 bitdepth) {\n34\t///     return 18U + channels +\n35\t///            (((blocksize * bitdepth * (channels * (channels != 2))) +\n36\t///              (blocksize * bitdepth * (channels == 2)) +\n37\t///              (blocksize * (bitdepth + (bitdepth != 32)) * (channels == 2)) +\n38\t///              +7) /\n39\t///             8);\n40\t/// }\n41\t/// ```\n42\t///\n43\t/// All operations use wrapping (modulo 2^32) semantics to match unsigned C\n44\t/// arithmetic exactly, and the division is an unsigned division.\n45\t#[unsafe(no_mangle)]\n46\tpub extern \"C\" fn max_size_frame(\n47\t    blocksize: tflac_u32,\n48\t    channels: tflac_u32,\n49\t    bitdepth: tflac_u32,\n50\t) -> tflac_u32 {\n51\t    // (blocksize * bitdepth * (channels * (channels != 2)))\n52\t    let term1 = blocksize\n53\t        .wrapping_mul(bitdepth)\n54\t        .wrapping_mul(channels.wrapping_mul(c_bool(channels != 2)));\n55\t\n56\t    // (blocksize * bitdepth * (channels == 2))\n57\t    let term2 = blocksize\n58\t        .wrapping_mul(bitdepth)\n59\t        .wrapping_mul(c_bool(channels == 2));\n60\t\n61\t    // (blocksize * (bitdepth + (bitdepth != 32)) * (channels == 2))\n62\t    let term3 = blocksize\n63\t        .wrapping_mul(bitdepth.wrapping_add(c_bool(bitdepth != 32)))\n64\t        .wrapping_mul(c_bool(channels == 2));\n65\t\n66\t    // ((term1 + term2 + term3 + +7) / 8)\n67\t    let numerator = term1\n68\t        .wrapping_add(term2)\n69\t        .wrapping_add(term3)\n70\t        .wrapping_add(7);\n71\t\n72\t    // 18U + channels + (numerator / 8)\n73\t    18u32\n74\t        .wrapping_add(channels)\n75\t        .wrapping_add(numerator / 8)\n76\t}\n77\t"}]},"parent_tool_use_id":"toolu_bdrk_01PLDPo4CCwxzE2Uqvw8Y7vS","session_id":"25e5a781-4f1a-46b6-8172-dcad34d2c3fa","uuid":"98768183-5159-4d3e-91e2-e1943190514e","timestamp":"2026-08-19T13:34:28.082Z","subagent_type":"general-purpose","task_description":"Adversarial audit of C-to-Rust equivalence"}
