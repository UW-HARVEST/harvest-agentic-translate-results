{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JwauWV659W75GVZubd5JHS","type":"tool_result","content":"1\t//! Translation of `int ima_parse(struct ima_info *info, const void *data)`\n2\t//! from `c_src/src/lib.c`.\n3\t\n4\tuse core::ffi::{c_int, c_void};\n5\t\n6\tuse crate::caf::{\n7\t    CAF_CHUNK_DATA, CAF_CHUNK_DESC, CAF_CHUNK_PAKT, CAF_FORMAT_IMA4, CAF_TYPE_CAFF, CAF_VERSION,\n8\t    caf_audio_description, caf_chunk, caf_data, caf_header, caf_packet_table,\n9\t};\n10\tuse crate::endian::{ima_btoh16, ima_btoh32, ima_btoh64};\n11\tuse crate::{ima_block, ima_f64_t, ima_info, ima_s64_t, ima_u16_t, ima_u32_t, ima_u64_t};\n12\t\n13\t// ---------------------------------------------------------------------------\n14\t// Unaligned raw loads\n15\t//\n16\t// The C code reaches into the caller's buffer through `struct` pointers formed\n17\t// by pointer casts at arbitrary offsets. Reproducing that with `read_unaligned`\n18\t// keeps the observable behaviour (including a fault on a NULL/bad pointer)\n19\t// while avoiding Rust-level alignment UB that the C compiler happens to get\n20\t// away with on x86.\n21\t// ---------------------------------------------------------------------------\n22\t\n23\t#[inline]\n24\tunsafe fn load_u16(base: *const u8, offset: usize) -> ima_u16_t {\n25\t    unsafe { base.wrapping_add(offset).cast::<ima_u16_t>().read_unaligned() }\n26\t}\n27\t\n28\t#[inline]\n29\tunsafe fn load_u32(base: *const u8, offset: usize) -> ima_u32_t {\n30\t    unsafe { base.wrapping_add(offset).cast::<ima_u32_t>().read_unaligned() }\n31\t}\n32\t\n33\t#[inline]\n34\tunsafe fn load_u64(base: *const u8, offset: usize) -> ima_u64_t {\n35\t    unsafe { base.wrapping_add(offset).cast::<ima_u64_t>().read_unaligned() }\n36\t}\n37\t\n38\t#[inline]\n39\tunsafe fn load_f64(base: *const u8, offset: usize) -> ima_f64_t {\n40\t    unsafe { base.wrapping_add(offset).cast::<ima_f64_t>().read_unaligned() }\n41\t}\n42\t\n43\t// ---------------------------------------------------------------------------\n44\t// x86-64 `double` -> `unsigned long long` conversion\n45\t//\n46\t// The C source does\n47\t//\n48\t//     conv64.u = desc->sample_rate;   /* NOT a bit cast: a value conversion! */\n49\t//     conv64.u = ima_btoh64(*(const ima_u64_t *)&conv64.u);\n50\t//     info->sample_rate = conv64.f;\n51\t//\n52\t// Assigning the `ima_f64_t` member to the `ima_u64_t` member of the union\n53\t// performs a floating-point-to-integer *conversion* (truncation toward zero),\n54\t// not a reinterpretation of the bits. Because `desc->sample_rate` holds a\n55\t// big-endian double read as if it were native, the value is essentially\n56\t// arbitrary, and for most inputs the conversion is out of `unsigned long long`\n57\t// range, which C leaves undefined.\n58\t//\n59\t// This is a bug in the original, but it must be reproduced exactly, so the\n60\t// conversion below emulates the code GCC emits on x86-64 (verified identical at\n61\t// -O0 and -O2):\n62\t//\n63\t//     comisd xmm0, 2^63\n64\t//     jae    .L2                 ; taken only when ordered and xmm0 >= 2^63\n65\t//     cvttsd2si rax, xmm0\n66\t//     jmp    .L3\n67\t// .L2:\n68\t//     subsd  xmm0, 2^63\n69\t//     cvttsd2si rax, xmm0\n70\t//     xor    rax, 0x8000000000000000\n71\t// .L3:\n72\t// ---------------------------------------------------------------------------\n73\t\n74\t/// 2^63 as an exactly representable `f64`.\n75\tconst TWO_POW_63: ima_f64_t = 9_223_372_036_854_775_808.0;\n76\t\n77\t/// Emulates the x86 `CVTTSD2SI r64, xmm` instruction.\n78\t///\n79\t/// Truncates toward zero. When the source is NaN, infinite, or the truncated\n80\t/// result does not fit in a signed 64-bit integer, the hardware produces the\n81\t/// \"integer indefinite\" value `0x8000000000000000`. Rust's `as` cast saturates\n82\t/// instead, so the range check has to be explicit.\n83\t#[inline]\n84\tfn cvttsd2si(x: ima_f64_t) -> ima_s64_t {\n85\t    const INTEGER_INDEFINITE: ima_s64_t = ima_s64_t::MIN;\n86\t\n87\t    if x.is_nan() {\n88\t        return INTEGER_INDEFINITE;\n89\t    }\n90\t    let truncated = x.trunc();\n91\t    // Valid iff truncated is in [-2^63, 2^63). Both bounds are exact in f64.\n92\t    if truncated >= -TWO_POW_63 && truncated < TWO_POW_63 {\n93\t        truncated as ima_s64_t\n94\t    } else {\n95\t        INTEGER_INDEFINITE\n96\t    }\n97\t}\n98\t\n99\t/// Emulates GCC's x86-64 lowering of a C `double` -> `unsigned long long`\n100\t/// conversion, including the results it produces for the cases C calls\n101\t/// undefined.\n102\t#[inline]\n103\tfn f64_to_u64(x: ima_f64_t) -> ima_u64_t {\n104\t    // `comisd`/`jae` is only taken when the comparison is ordered *and*\n105\t    // x >= 2^63; NaN (unordered) sets CF and falls through to the direct\n106\t    // `cvttsd2si`, which then yields the indefinite value. `x >= TWO_POW_63`\n107\t    // is false for NaN in Rust too, so the mapping is direct.\n108\t    if x >= TWO_POW_63 {\n109\t        (cvttsd2si(x - TWO_POW_63) as ima_u64_t) ^ (1 << 63)\n110\t    } else {\n111\t        cvttsd2si(x) as ima_u64_t\n112\t    }\n113\t}\n114\t\n115\t/// ```c\n116\t/// int ima_parse(struct ima_info *info, const void *data);\n117\t/// ```\n118\t///\n119\t/// Parses a CAF container holding IMA4 audio.\n120\t///\n121\t/// Returns `0` on success, `-1` if the file type is not `caff`, `-2` if the\n122\t/// header version is not 1, and `-3` if the audio description does not\n123\t/// advertise the `ima4` format.\n124\t///\n125\t/// # Safety\n126\t///\n127\t/// Mirrors the C contract exactly: `info` must point to a writable\n128\t/// `struct ima_info` and `data` must point to a well-formed CAF stream. As in\n129\t/// the C original there is no bounds checking, no NULL checking, and no\n130\t/// termination condition for the chunk walk other than finding a `data` chunk,\n131\t/// so malformed input can fault or loop forever.\n132\t#[unsafe(no_mangle)]\n133\tpub unsafe extern \"C\" fn ima_parse(info: *mut 