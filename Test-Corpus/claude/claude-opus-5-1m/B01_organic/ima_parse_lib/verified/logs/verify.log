{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MoxN38Kh1TFmseqE19kBTr","type":"tool_result","content":"1\t//! CAF (Core Audio Format) container structures, translated from the\n2\t//! file-private declarations in `c_src/src/lib.c`.\n3\t//!\n4\t//! These structures are *not* part of the public ABI, but their exact C layout\n5\t//! is load bearing: `ima_parse` walks a raw byte buffer by casting pointers to\n6\t//! them, so every field offset and every structure size must match the C\n7\t//! compiler's layout for the x86-64 SysV ABI.\n8\t//!\n9\t//! The parser reads through `read_unaligned`, because the pointers it forms\n10\t//! come from arbitrary offsets inside the caller's buffer and are therefore not\n11\t//! guaranteed to satisfy the alignment the C `struct` types nominally require\n12\t//! (the C code has the same latent misalignment, which x86 tolerates).\n13\t\n14\t// Some layout constants are documentation of the C layout and are only\n15\t// referenced from the tests.\n16\t#![allow(dead_code)]\n17\t\n18\tuse crate::{ima_f64_t, ima_s32_t, ima_s64_t, ima_u16_t, ima_u32_t};\n19\t\n20\t/// ```c\n21\t/// struct caf_header {\n22\t///     ima_u32_t type;\n23\t///     ima_u16_t version;\n24\t///     ima_u16_t flags;\n25\t/// };\n26\t/// ```\n27\t#[repr(C)]\n28\t#[derive(Clone, Copy)]\n29\tpub struct caf_header {\n30\t    pub type_: ima_u32_t,\n31\t    pub version: ima_u16_t,\n32\t    pub flags: ima_u16_t,\n33\t}\n34\t\n35\timpl caf_header {\n36\t    pub const SIZE: usize = 8;\n37\t    pub const OFF_TYPE: usize = 0;\n38\t    pub const OFF_VERSION: usize = 4;\n39\t}\n40\t\n41\t/// ```c\n42\t/// struct caf_chunk {\n43\t///     ima_u32_t type;\n44\t///     ima_s64_t size;\n45\t/// };\n46\t/// ```\n47\t///\n48\t/// `size` is 8-byte aligned, so there are 4 bytes of padding after `type` and\n49\t/// the structure is 16 bytes long.\n50\t#[repr(C)]\n51\t#[derive(Clone, Copy)]\n52\tpub struct caf_chunk {\n53\t    pub type_: ima_u32_t,\n54\t    pub size: ima_s64_t,\n55\t}\n56\t\n57\timpl caf_chunk {\n58\t    pub const SIZE: usize = 16;\n59\t    pub const OFF_TYPE: usize = 0;\n60\t    pub const OFF_SIZE: usize = 8;\n61\t}\n62\t\n63\t/// ```c\n64\t/// struct caf_audio_description {\n65\t///     ima_f64_t sample_rate;\n66\t///     ima_u32_t format_id;\n67\t///     ima_u32_t format_flags;\n68\t///     ima_u32_t bytes_per_packet;\n69\t///     ima_u32_t frames_per_packet;\n70\t///     ima_u32_t channels_per_frame;\n71\t///     ima_u32_t bits_per_channel;\n72\t/// };\n73\t/// ```\n74\t#[repr(C)]\n75\t#[derive(Clone, Copy)]\n76\tpub struct caf_audio_description {\n77\t    pub sample_rate: ima_f64_t,\n78\t    pub format_id: ima_u32_t,\n79\t    pub format_flags: ima_u32_t,\n80\t    pub bytes_per_packet: ima_u32_t,\n81\t    pub frames_per_packet: ima_u32_t,\n82\t    pub channels_per_frame: ima_u32_t,\n83\t    pub bits_per_channel: ima_u32_t,\n84\t}\n85\t\n86\timpl caf_audio_description {\n87\t    pub const SIZE: usize = 32;\n88\t    pub const OFF_SAMPLE_RATE: usize = 0;\n89\t    pub const OFF_FORMAT_ID: usize = 8;\n90\t    pub const OFF_CHANNELS_PER_FRAME: usize = 24;\n91\t}\n92\t\n93\t/// ```c\n94\t/// struct caf_packet_table {\n95\t///     ima_s64_t packet_count;\n96\t///     ima_s64_t frame_count;\n97\t///     ima_s32_t priming_frames;\n98\t///     ima_s32_t remainder_frames;\n99\t/// };\n100\t/// ```\n101\t#[repr(C)]\n102\t#[derive(Clone, Copy)]\n103\tpub struct caf_packet_table {\n104\t    pub packet_count: ima_s64_t,\n105\t    pub frame_count: ima_s64_t,\n106\t    pub priming_frames: ima_s32_t,\n107\t    pub remainder_frames: ima_s32_t,\n108\t}\n109\t\n110\timpl caf_packet_table {\n111\t    pub const SIZE: usize = 24;\n112\t    pub const OFF_PACKET_COUNT: usize = 0;\n113\t    pub const OFF_FRAME_COUNT: usize = 8;\n114\t}\n115\t\n116\t/// ```c\n117\t/// struct caf_data {\n118\t///     ima_u32_t edit_count;\n119\t/// };\n120\t/// ```\n121\t#[repr(C)]\n122\t#[derive(Clone, Copy)]\n123\tpub struct caf_data {\n124\t    pub edit_count: ima_u32_t,\n125\t}\n126\t\n127\timpl caf_data {\n128\t    pub const SIZE: usize = 4;\n129\t}\n130\t\n131\t// ---------------------------------------------------------------------------\n132\t// Four character codes\n133\t//\n134\t// The C source spells these out as\n135\t//     ((ima_u32_t)(ima_u8_t)('c') | ((ima_u32_t)(ima_u8_t)('a') << 8) | ...)\n136\t// i.e. the *first* character listed ends up in the least significant byte.\n137\t// The comparisons are made against the big-endian-to-host converted value read\n138\t// from the file, so the resulting constant reads naturally when written as a\n139\t// hex literal.\n140\t// ---------------------------------------------------------------------------\n141\t\n142\t/// Builds the same value as the C `(u32)(u8)a | (u32)(u8)b << 8 | ...` idiom.\n143\tconst fn fourcc(a: u8, b: u8, c: u8, d: u8) -> ima_u32_t {\n144\t    (a as ima_u32_t) | ((b as ima_u32_t) << 8) | ((c as ima_u32_t) << 16) | ((d as ima_u32_t) << 24)\n145\t}\n146\t\n147\t/// `'f' | 'f' << 8 | 'a' << 16 | 'c' << 24` == `0x63616666` (\"caff\").\n148\tpub const CAF_TYPE_CAFF: ima_u32_t = fourcc(b'f', b'f', b'a', b'c');\n149\t/// `'c' | 's' << 8 | 'e' << 16 | 'd' << 24` == `0x64657363` (\"desc\").\n150\tpub const CAF_CHUNK_DESC: ima_u32_t = fourcc(b'c', b's', b'e', b'd');\n151\t/// `'t' | 'k' << 8 | 'a' << 16 | 'p' << 24` == `0x70616b74` (\"pakt\").\n152\tpub const CAF_CHUNK_PAKT: ima_u32_t = fourcc(b't', b'k', b'a', b'p');\n153\t/// `'a' | 't' << 8 | 'a' << 16 | 'd' << 24` == `0x64617461` (\"data\").\n154\tpub const CAF_CHUNK_DATA: ima_u32_t = fourcc(b'a', b't', b'a', b'd');\n155\t/// `'4' | 'a' << 8 | 'm' << 16 | 'i' << 24` == `0x696d6134` (\"ima4\").\n156\tpub const CAF_FORMAT_IMA4: ima_u32_t = fourcc(b'4', b'a', b'm', b'i');\n157\t\n158\t/// The CAF header version the parser accepts.\n159\tpub const CAF_VERSION: ima_u16_t = 1;\n160\t\n161\t#[cfg(test)]\n162\tmod tests {\n163\t    use super::*;\n164\t    use core::mem::size_of;\n165\t\n166\t    #[test]\n167\t    fn private_struct_sizes_match_c() {\n168\t        assert_eq!(size_of::<caf_header>(), caf_header::SIZE);\n169\t        assert_eq!(size_of::<caf_chunk>(), caf_chunk::SIZE);\n170\t        assert_eq!(\n171\t            size_of::<caf_audio_description>(),\n172\t            caf_audio_description::SIZE\n173\t        );\n174\t        assert_eq!(size_of::<caf_packet_table>(), caf_packet_table::SIZE);\n175\t        assert_eq!(size_of::<caf_data>(), caf_data::SIZE);\n176\t    }\n177\t\n178\t    #[test]\n179\t    fn fourcc_values_match_c() {\n180\t        assert_eq!(CAF_TYPE_CAFF, 0x6361_6666);\n181\t        assert_eq!(CAF_CHUNK_DESC, 0x6465_7363);\n182\t        assert_eq!(CAF_CHUNK_PAKT, 0x7061_6b74);\n183\t        assert_eq!(CAF_CHUNK_DATA, 0x6461_7461);\n184\t        assert_eq!(CAF_FORMAT_IMA4, 0x696d_6134);\n185\t    }\n186\t}\n187\t"}]},"parent_tool_use_id":null,"session_id":"3786f768-af92-404b-a5c1-7f882bb95312","uuid":"146ac8ff-b72f-420e-9e2a-a79f8ebded75","timestamp":"2026-08-19T13:01:33.708Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-tpHMdy/translated_rust/src/caf.rs","content":"//! CAF (Core Audio Format) container structures, translated from the\n//! file-private declarations in `c_src/src/lib.c`.\n//!\n//! These structures are *not* part of the public ABI, but their exact C layout\n//! is load bearing: `ima_parse` walks a raw byte buffer by casting pointers to\n//! them, so every field offset and every structure size must match the C\n//! compiler's layout for the x86-64 SysV ABI.\n//!\n//! The parser reads through `read_unaligned`, because the pointers it forms\n//! come from arbitrary offsets inside the caller's buffer and are therefore not\n//! guaranteed to satisfy the alignment the C `struct` types nominally require\n//! (the C code has the same latent misalignment, which x86 tolerates).\n\n// Some layout constants are documentation of the C layout and are only\n// referenced from the tests.\n#![allow(dead_code)]\n\nuse crate::{ima_f64_t, ima_s32_t, ima_s64_t, ima_u16_t, ima_u32_t};\n\n/// ```c\n/// struct caf_header {\n///     ima_u32_t type;\n///     ima_u16_t version;\n///     ima_u16_t flags;\n/// };\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct caf_header {\n    pub type_: ima_u32_t,\n    pub version: ima_u16_t,\n    pub flags: ima_u16_t,\n}\n\nimpl caf_header {\n    pub const SIZE: usize = 8;\n    pub const OFF_TYPE: usize = 0;\n    pub const OFF_VERSION: usize = 4;\n}\n\n/// ```c\n/// struct caf_chunk {\n///     ima_u32_t type;\n///     ima_s64_t size;\n/// };\n/// ```\n///\n/// `size` is 8-byte aligned, so there are 4 bytes of padding after `type` and\n/// the structure is 16 bytes long.\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct caf_chunk {\n    pub type_: ima_u32_t,\n    pub size: ima_s64_t,\n}\n\nimpl caf_chunk {\n    pub const SIZE: usize = 16;\n    pub const OFF_TYPE: usize = 0;\n    pub const OFF_SIZE: usize = 8;\n}\n\n/// ```c\n/// struct caf_audio_description {\n///     ima_f64_t sample_rate;\n///     ima_u32_t format_id;\n///     ima_u32_t format_flags;\n///     ima_u32_t bytes_per_packet;\n///     ima_u32_t frames_per_packet;\n///     ima_u32_t channels_per_frame;\n///     ima_u32_t bits_per_channel;\n/// };\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct caf_audio_description {\n    pub sample_rate: ima_f64_t,\n    pub format_id: ima_u32_t,\n    pub format_flags: ima_u32_t,\n    pub bytes_per_packet: ima_u32_t,\n    pub frames_per_packet: ima_u32_t,\n    pub channels_per_frame: ima_u32_t,\n    pub bits_per_channel: ima_u32_t,\n}\n\nimpl caf_audio_description {\n    pub const SIZE: usize = 32;\n    pub const OFF_SAMPLE_RATE: usize = 0;\n    pub const OFF_FORMAT_ID: usize = 8;\n    pub const OFF_CHANNELS_PER_FRAME: usize = 24;\n}\n\n/// ```c\n/// struct caf_packet_table {\n///     ima_s64_t packet_count;\n///     ima_s64_t frame_count;\n///     ima_s32_t priming_frames;\n///     ima_s32_t remainder_frames;\n/// };\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct caf_packet_table {\n    pub packet_count: ima_s64_t,\n    pub frame_count: ima_s64_t,\n    pub priming_frames: ima_s32_t,\n    pub remainder_frames: ima_s32_t,\n}\n\nimpl caf_packet_table {\n    pub const SIZE: usize = 24;\n    pub const OFF_PACKET_COUNT: usize = 0;\n    pub const OFF_FRAME_COUNT: usize = 8;\n}\n\n/// ```c\n/// struct caf_data {\n///     ima_u32_t edit_count;\n/// };\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct caf_data {\n    pub edit_count: ima_u32_t,\n}\n\nimpl caf_data {\n    pub const SIZE: usize = 4;\n}\n\n// ---------------------------------------------------------------------------\n// Four character codes\n//\n// The C source spells these out as\n//     ((ima_u32_t)(ima_u8_t)('c') | ((ima_u32_t)(ima_u8_t)('a') << 8) | ...)\n// i.e. the *first* character listed ends up in the least significant byte.\n// The comparisons are made against the big-endian-to-host converted value read\n// from the file, so the resulting constant reads naturally when written as a\n// hex literal.\n// ---------------------------------------------------------------------------\n\n/// Builds the same value as the C `(u32)(u8)a | (u32)(u8)b << 8 | ...` idiom.\nconst fn fourcc(a: u8, b: u8, c: u8, d: u8) -> ima_u32_t {\n    (a as ima_u32_t) | ((b as ima_u32_t) << 8) | ((c as ima_u32_t) << 16) | ((d as ima_u32_t) << 24)\n}\n\n/// `'f' | 'f' << 8 | 'a' << 16 | 'c' << 24` == `0x63616666` (\"caff\").\npub const CAF_TYPE_CAFF: ima_u32_t = fourcc(b'f', b'f', b'a', b'c');\n/// `'c' | 's' << 8 | 'e' << 16 | 'd' << 24` == `0x64657363` (\"desc\").\npub const CAF_CHUNK_DESC: ima_u32_t = fourcc(b'c', b's', b'e', b'd');\n/// `'t' | 'k' << 8 | 'a' << 16 | 'p' << 24` == `0x70616b74` (\"pakt\").\npub const CAF_CHUNK_PAKT: ima_u32_t = fourcc(b't', b'k', b'a', b'p');\n/// `'a' | 't' << 8 | 'a' << 16 | 'd' << 24` == `0x64617461` (\"data\").\npub const CAF_CHUNK_DATA: ima_u32_t = fourcc(b'a', b't', b'a', b'd');\n/// `'4' | 'a' << 8 | 'm' << 16 | 'i' << 24` == `0x696d6134` (\"ima4\").\npub const CAF_FORMAT_IMA4: ima_u32_t = fourcc(b'4', b'a', b'm', b'i');\n\n/// The CAF header version the parser accepts.\npub const CAF_VERSION: ima_u16_t = 1;\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use core::mem::size_of;\n\n    #[test]\n    fn private_struct_sizes_match_c() {\n        assert_eq!(size_of::<caf_header>(), caf_header::SIZE);\n        assert_eq!(size_of::<caf_chunk>(), caf_chunk::SIZE);\n        assert_eq!(\n            size_of::<caf_audio_description>(),\n            caf_audio_description::SIZE\n        );\n        assert_eq!(size_of::<caf_packet_table>(), caf_packet_table::SIZE);\n        assert_eq!(size_of::<caf_data>(), caf_data::SIZE);\n    }\n\n    #[test]\n    fn fourcc_values_match_c() {\n        assert_eq!(CAF_TYPE_CAFF, 0x6361_6666);\n        assert_eq!(CAF_CHUNK_DESC, 0x6465_7363);\n        assert_eq!(CAF_CHUNK_PAKT, 0x7061_6b74);\n        assert_eq!(CAF_CHUNK_DATA, 0x6461_7461);\n        assert_eq!(CAF_FORMAT_IMA4, 0x696d_6134);\n    }\n}\n","numLines":187,"startLine":1,"totalLines":187}}}
