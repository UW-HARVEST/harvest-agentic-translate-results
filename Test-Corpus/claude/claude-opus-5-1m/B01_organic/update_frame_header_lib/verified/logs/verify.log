{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018boQRR92ycucAvAtKQUthq","type":"tool_result","content":"543\t// ---------------------------------------------------------------------------\n544\t// R59 — repeated invocation on the same struct\n545\t// ---------------------------------------------------------------------------\n546\t\n547\t#[test]\n548\tfn cfg_repeated_invocation_idempotent() {\n549\t    let d = Diff::load();\n550\t    let mut rng = Rng::new(0x2EBE_A7ED);\n551\t    let mut mismatches = 0usize;\n552\t    let mut cases = 0usize;\n553\t\n554\t    for _ in 0..50_000 {\n555\t        let input = rng.tflac();\n556\t        let mut c_state = input;\n557\t        let mut rust_state = input;\n558\t        for round in 0..3 {\n559\t            unsafe {\n560\t                (d.c)(&mut c_state as *mut Tflac);\n561\t                (d.rust)(&mut rust_state as *mut Tflac);\n562\t            }\n563\t            cases += 1;\n564\t            if c_state.as_bytes() != rust_state.as_bytes() {\n565\t                mismatches += 1;\n566\t                panic!(\n567\t                    \"R59 round {round}: C {c_state:?} != Rust {rust_state:?} for input {input:?}\"\n568\t                );\n569\t            }\n570\t        }\n571\t        // Line 12 is `=`, not `|=`, so the operation is idempotent in C; the\n572\t        // Rust must be too.\n573\t        let mut once = input;\n574\t        unsafe { (d.c)(&mut once as *mut Tflac) };\n575\t        assert_eq!(\n576\t            once.frame_header, c_state.frame_header,\n577\t            \"C is expected to be idempotent (line 12 assigns, does not OR)\"\n578\t        );\n579\t    }\n580\t    assert_eq!(mismatches, 0);\n581\t    eprintln!(\"R59 repeated invocation: {cases} cases, 0 mismatches\");\n582\t}\n583\t\n584\t// ---------------------------------------------------------------------------\n585\t// R60 — prior `frame_header` contents must be discarded\n586\t// ---------------------------------------------------------------------------\n587\t"}]},"parent_tool_use_id":null,"session_id":"cd53fac5-42d8-4ad0-b1aa-0e97b26d290e","uuid":"8a70ec8f-c75c-4661-a3fb-244dc1cabc50","timestamp":"2026-08-19T15:25:44.200Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-aXdatY/translated_rust/tests/phase_b_configs.rs","content":"// ---------------------------------------------------------------------------\n// R59 — repeated invocation on the same struct\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_repeated_invocation_idempotent() {\n    let d = Diff::load();\n    let mut rng = Rng::new(0x2EBE_A7ED);\n    let mut mismatches = 0usize;\n    let mut cases = 0usize;\n\n    for _ in 0..50_000 {\n        let input = rng.tflac();\n        let mut c_state = input;\n        let mut rust_state = input;\n        for round in 0..3 {\n            unsafe {\n                (d.c)(&mut c_state as *mut Tflac);\n                (d.rust)(&mut rust_state as *mut Tflac);\n            }\n            cases += 1;\n            if c_state.as_bytes() != rust_state.as_bytes() {\n                mismatches += 1;\n                panic!(\n                    \"R59 round {round}: C {c_state:?} != Rust {rust_state:?} for input {input:?}\"\n                );\n            }\n        }\n        // Line 12 is `=`, not `|=`, so the operation is idempotent in C; the\n        // Rust must be too.\n        let mut once = input;\n        unsafe { (d.c)(&mut once as *mut Tflac) };\n        assert_eq!(\n            once.frame_header, c_state.frame_header,\n            \"C is expected to be idempotent (line 12 assigns, does not OR)\"\n        );\n    }\n    assert_eq!(mismatches, 0);\n    eprintln!(\"R59 repeated invocation: {cases} cases, 0 mismatches\");\n}\n\n// ---------------------------------------------------------------------------\n// R60 — prior `frame_header` contents must be discarded\n// ---------------------------------------------------------------------------\n","numLines":45,"startLine":543,"totalLines":651}}}
