unsafe fn read_u32_at(base: *const u8, off: usize) -> tflac_u32 {\n198\t    let p = base.wrapping_add(off);\n199\t    unsafe {\n200\t        tflac_u32::from_ne_bytes([\n201\t            *p,\n202\t            *p.wrapping_add(1),\n203\t            *p.wrapping_add(2),\n204\t            *p.wrapping_add(3),\n205\t        ])\n206\t    }\n207\t}\n208\t\n209\t/// Reads the `tflac_u8` field at byte offset `off` from `base`.\n210\t///\n211\t/// # Safety\n212\t/// `base.wrapping_add(off)` must be readable.\n213\t#[inline]\n214\tunsafe fn read_u8_at(base: *const u8, off: usize) -> tflac_u8 {\n215\t    unsafe { *base.wrapping_add(off) }\n216\t}\n217\t\n218\t/// Writes the `tflac_u32` field at byte offset `off` from `base`.\n219\t///\n220\t/// # Safety\n221\t/// `base.wrapping_add(off) .. +4` must be writable.\n222\t#[inline]\n223\tunsafe fn write_u32_at(base: *mut u8, off: usize, value: tflac_u32) {\n224\t    let bytes = value.to_ne_bytes();\n225\t    let p = base.wrapping_add(off);\n226\t    unsafe {\n227\t        *p = bytes[0];\n228\t        *p.wrapping_add(1) = bytes[1];\n229\t        *p.wrapping_add(2) = bytes[2];\n230\t        *p.wrapping_add(3) = bytes[3];\n231\t    }\n232\t}\n233\t\n234\t/// `void update_frame_header(tflac *t);`\n235\t///\n236\t/// Rebuilds `t->frame_header` from the sample rate, channel count, bit depth,\n237\t/// channel mode and current blocksize stored in `*t`. No other field (and none\n238\t/// of the struct padding) is touched, exactly as in the C.\n239\t///\n240\t/// # Safety\n241\t///\n242\t/// `t` must point to 24 readable and writable bytes laid out as a\n243\t/// `struct tflac`, exactly as the C function requires.\n244\t#[unsafe(no_mangle)]\n245\tpub unsafe extern \"C\" fn update_frame_header(t: *mut tflac) {\n246\t    let base = t as *mut u8;\n247\t\n248\t    // SAFETY: the caller guarantees `*t` is readable/writable; every access is\n249\t    // byte-sized, so no alignment requirement is imposed on `t`.\n250\t    let (cur_blocksize, samplerat