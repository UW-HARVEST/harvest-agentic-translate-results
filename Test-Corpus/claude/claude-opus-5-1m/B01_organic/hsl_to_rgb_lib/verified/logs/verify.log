{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VLfGPBUckYBvnaJK6iK4nv","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! Public ABI of the C shared library (the complete surface — `nm -D` on the C\n4\t//! `.so` exports exactly one public symbol):\n5\t//!\n6\t//! ```c\n7\t//! void hsl_to_rgb(float *dest, const float *src);\n8\t//! ```\n9\t//!\n10\t//! The translation is deliberately literal:\n11\t//!   * the `s == 0` early-out writes all three components and returns,\n12\t//!   * the comparison chain is evaluated in the original order,\n13\t//!   * the third branch keeps the original (buggy) `h < 120.0f && h < 180.0f`\n14\t//!     condition instead of the presumably intended `h >= 120.0f && ...`,\n15\t//!   * every floating point expression keeps its exact form and operand order,\n16\t//!     so results are bit-identical to the C build (including the sign/payload\n17\t//!     of NaN results, see the `ss_*` helpers below).\n18\t\n19\t#![allow(clippy::excessive_precision)]\n20\t#![allow(clippy::missing_safety_doc)]\n21\t\n22\tuse std::ffi::c_float;\n23\t\n24\t// ---------------------------------------------------------------------------\n25\t// Scalar float helpers that reproduce the reference build bit for bit.\n26\t//\n27\t// For finite/infinite operands these are plain IEEE-754 single precision\n28\t// operations, exactly like the C code. They only differ from the naive Rust\n29\t// operators when *both* operands are NaN: the hardware (SSE `addss`/`subss`/\n30\t// `mulss`/`divss`) then returns the *first* (destination) operand, quieted,\n31\t// while an optimizing Rust/LLVM backend is free to commute the operands and\n32\t// would return the other NaN. Spelling the rule out keeps the observable\n33\t// output identical to the C library for every possible input.\n34\t// ---------------------------------------------------------------------------\n35\t\n36\t/// Quiet a NaN the way SSE does: set the mantissa MSB, keep sign and payload.\n37\t#[inline]\n38\tfn quiet_nan(x: c_float) -> c_float {\n39\t    f32::from_bits(x.to_bits() | 0x0040_0000)\n40\t}\n41\t\n42\t/// `a + b` with SSE NaN propagation (destination operand wins).\n43\t#[inline]\n44\tfn ss_add(a: c_float, b: c_float) -> c_float {\n45\t    if a.is_nan() {\n46\t        quiet_nan(a)\n47\t    } else if b.is_nan() {\n48\t        quiet_nan(b)\n49\t    } else {\n50\t        a + b\n51\t    }\n52\t}\n53\t\n54\t/// `a - b` with SSE NaN propagation (destination operand wins).\n55\t#[inline]\n56\tfn ss_sub(a: c_float, b: c_float) -> c_float {\n57\t    if a.is_nan() {\n58\t        quiet_nan(a)\n59\t    } else if b.is_nan() {\n60\t        quiet_nan(b)\n61\t    } else {\n62\t        a - b\n63\t    }\n64\t}\n65\t\n66\t/// `a * b` with SSE NaN propagation (destination operand wins).\n67\t#[inline]\n68\tfn ss_mul(a: c_float, b: c_float) -> c_float {\n69\t    if a.is_nan() {\n70\t        quiet_nan(a)\n71\t    } else if b.is_nan() {\n72\t        quiet_nan(b)\n73\t    } else {\n74\t        a * b\n75\t    }\n76\t}\n77\t\n78\t/// `a / b` with SSE NaN propagation (destination operand wins).\n79\t#[inline]\n80\tfn ss_div(a: c_float, b: c_float) -> c_float {\n81\t    if a.is_nan() {\n82\t        quiet_nan(a)\n83\t    } else if b.is_nan() {\n84\t        quiet_nan(b)\n85\t    } else {\n86\t        a / b\n87\t    }\n88\t}\n89\t\n90\t/// `fabsf()` from `<math.h>`: a pure sign-bit clear (`andps`), which — unlike an\n91\t/// arithmetic operation — never quiets a signalling NaN.\n92\t#[inline]\n93\tfn fabsf(x: c_float) -> c_float {\n94\t    f32::from_bits(x.to_bits() & 0x7fff_ffff)\n95\t}\n96\t\n97\t/// `fmodf()` from `<math.h>`. Rust's `%` on `f32` is the truncated (C `fmod`)\n98\t/// remainder and lowers to a call to the very same libm routine the C code\n99\t/// uses, so the result — NaN payloads included — is identical.\n100\t#[inline]\n101\tfn fmodf(x: c_float, y: c_float) -> c_float {\n102\t    x % y\n103\t}\n104\t\n105\t// ---------------------------------------------------------------------------\n106\t// Public ABI\n107\t// ---------------------------------------------------------------------------\n108\t\n109\t/// `void hsl_to_rgb(float *dest, const float *src);`\n110\t///\n111\t/// `src` is read as `[h, s, l]`, `dest` is written as `[r, g, b]`.\n112\t#[unsafe(no_mangle)]\n113\tpub unsafe extern \"C\" fn hsl_to_rgb(dest: *mut c_float, src: *const c_float) {\n114\t    let h: c_float = unsafe { *src.add(0) };\n115\t    let s: c_float = unsafe { *src.add(1) };\n116\t    let l: c_float = unsafe { *src.add(2) };\n117\t\n118\t    let c: c_float;\n119\t    let m: c_float;\n120\t    let x: c_float;\n121\t\n122\t    if s == 0.0 {\n123\t        unsafe {\n124\t            *dest.add(0) = l;\n125\t            *dest.add(1) = l;\n126\t            *dest.add(2) = l;\n127\t        }\n128\t        return;\n129\t    }\n130\t\n131\t    // c = (1.0f - fabsf(2.0f * l - 1.0f)) * s;\n132\t    // (`2.0f * l` is emitted as `l + l`, which is exact for every input.)\n133\t    c = ss_mul(ss_sub(1.0, fabsf(ss_sub(ss_add(l, l), 1.0))), s);\n134\t\n135\t    // m = 1.0f * (l - 0.5f * c);\n136\t    // The multiplication by 1.0f is a no-op that the C compiler folds away;\n137\t    // `0.5f * c` is evaluated with `c` as the destination operand.\n138\t    m = ss_sub(l, ss_mul(c, 0.5));\n139\t\n140\t    // x = c * (1.0f - fabsf(fmodf(h / 60.0f, 2) - 1.0f));\n141\t    // The product is evaluated with the parenthesised term as the destination\n142\t    // operand, so it takes precedence when both it and `c` are NaN.\n143\t    x = ss_mul(\n144\t        ss_sub(1.0, fabsf(ss_sub(fmodf(ss_div(h, 60.0), 2.0), 1.0))),\n145\t        c,\n146\t    );\n147\t\n148\t    let (r, g, b): (c_float, c_float, c_float) = if h >= 0.0 && h < 60.0 {\n149\t        (ss_add(c, m), ss_add(x, m), m)\n150\t    } else if h >= 60.0 && h < 120.0 {\n151\t        (ss_add(x, m), ss_add(c, m), m)\n152\t    } else if h < 120.0 && h < 180.0 {\n153\t        // Faithful to the original C source, which tests `h < 120.0f` here\n154\t        // where `h >= 120.0f` was evidently intended.\n155\t        (m, ss_add(c, m), ss_add(x, m))\n156\t    } else if h >= 180.0 && h < 240.0 {\n157\t        (m, ss_add(x, m), ss_add(c, m))\n158\t    } else if h >= 240.0 && h < 300.0 {\n159\t        (ss_add(x, m), m, ss_add(c, m))\n160\t    } else if h >= 300.0 && h < 360.0 {\n161\t        (ss_add(c, m), m, ss_add(x, m))\n162\t    } else {\n163\t        (m, m, m)\n164\t    };\n165\t\n166\t    unsafe {\n167\t        *dest.add(0) = r;\n168\t        *dest.add(1) = g;\n169\t        *dest.add(2) = b;\n170\t    }\n171\t}\n172\t"}]},"parent_tool_use_id":null,"session_id":"3e184715-bcf6-4ef2-94b0-032cbc18aa4f","uuid":"bd344c39-33ac-4dd0-8bb7-e5579964f996","timestamp":"2026-08-19T12:27:15.065Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-L83zxk/translated_rust/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! Public ABI of the C shared library (the complete surface — `nm -D` on the C\n//! `.so` exports exactly one public symbol):\n//!\n//! ```c\n//! void hsl_to_rgb(float *dest, const float *src);\n//! ```\n//!\n//! The translation is deliberately literal:\n//!   * the `s == 0` early-out writes all three components and returns,\n//!   * the comparison chain is evaluated in the original order,\n//!   * the third branch keeps the original (buggy) `h < 120.0f && h < 180.0f`\n//!     condition instead of the presumably intended `h >= 120.0f && ...`,\n//!   * every floating point expression keeps its exact form and operand order,\n//!     so results are bit-identical to the C build (including the sign/payload\n//!     of NaN results, see the `ss_*` helpers below).\n\n#![allow(clippy::excessive_precision)]\n#![allow(clippy::missing_safety_doc)]\n\nuse std::ffi::c_float;\n\n// ---------------------------------------------------------------------------\n// Scalar float helpers that reproduce the reference build bit for bit.\n//\n// For finite/infinite operands these are plain IEEE-754 single precision\n// operations, exactly like the C code. They only differ from the naive Rust\n// operators when *both* operands are NaN: the hardware (SSE `addss`/`subss`/\n// `mulss`/`divss`) then returns the *first* (destination) operand, quieted,\n// while an optimizing Rust/LLVM backend is free to commute the operands and\n// would return the other NaN. Spelling the rule out keeps the observable\n// output identical to the C library for every possible input.\n// ---------------------------------------------------------------------------\n\n/// Quiet a NaN the way SSE does: set the mantissa MSB, keep sign and payload.\n#[inline]\nfn quiet_nan(x: c_float) -> c_float {\n    f32::from_bits(x.to_bits() | 0x0040_0000)\n}\n\n/// `a + b` with SSE NaN propagation (destination operand wins).\n#[inline]\nfn ss_add(a: c_float, b: c_float) -> c_float {\n    if a.is_nan() {\n        quiet_nan(a)\n    } else if b.is_nan() {\n        quiet_nan(b)\n    } else {\n        a + b\n    }\n}\n\n/// `a - b` with SSE NaN propagation (destination operand wins).\n#[inline]\nfn ss_sub(a: c_float, b: c_float) -> c_float {\n    if a.is_nan() {\n        quiet_nan(a)\n    } else if b.is_nan() {\n        quiet_nan(b)\n    } else {\n        a - b\n    }\n}\n\n/// `a * b` with SSE NaN propagation (destination operand wins).\n#[inline]\nfn ss_mul(a: c_float, b: c_float) -> c_float {\n    if a.is_nan() {\n        quiet_nan(a)\n    } else if b.is_nan() {\n        quiet_nan(b)\n    } else {\n        a * b\n    }\n}\n\n/// `a / b` with SSE NaN propagation (destination operand wins).\n#[inline]\nfn ss_div(a: c_float, b: c_float) -> c_float {\n    if a.is_nan() {\n        quiet_nan(a)\n    } else if b.is_nan() {\n        quiet_nan(b)\n    } else {\n        a / b\n    }\n}\n\n/// `fabsf()` from `<math.h>`: a pure sign-bit clear (`andps`), which — unlike an\n/// arithmetic operation — never quiets a signalling NaN.\n#[inline]\nfn fabsf(x: c_float) -> c_float {\n    f32::from_bits(x.to_bits() & 0x7fff_ffff)\n}\n\n/// `fmodf()` from `<math.h>`. Rust's `%` on `f32` is the truncated (C `fmod`)\n/// remainder and lowers to a call to the very same libm routine the C code\n/// uses, so the result — NaN payloads included — is identical.\n#[inline]\nfn fmodf(x: c_float, y: c_float) -> c_float {\n    x % y\n}\n\n// ---------------------------------------------------------------------------\n// Public ABI\n// ---------------------------------------------------------------------------\n\n/// `void hsl_to_rgb(float *dest, const float *src);`\n///\n/// `src` is read as `[h, s, l]`, `dest` is written as `[r, g, b]`.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn hsl_to_rgb(dest: *mut c_float, src: *const c_float) {\n    let h: c_float = unsafe { *src.add(0) };\n    let s: c_float = unsafe { *src.add(1) };\n    let l: c_float = unsafe { *src.add(2) };\n\n    let c: c_float;\n    let m: c_float;\n    let x: c_float;\n\n    if s == 0.0 {\n        unsafe {\n            *dest.add(0) = l;\n            *dest.add(1) = l;\n            *dest.add(2) = l;\n        }\n        return;\n    }\n\n    // c = (1.0f - fabsf(2.0f * l - 1.0f)) * s;\n    // (`2.0f * l` is emitted as `l + l`, which is exact for every input.)\n    c = ss_mul(ss_sub(1.0, fabsf(ss_sub(ss_add(l, l), 1.0))), s);\n\n    // m = 1.0f * (l - 0.5f * c);\n    // The multiplication by 1.0f is a no-op that the C compiler folds away;\n    // `0.5f * c` is evaluated with `c` as the destination operand.\n    m = ss_sub(l, ss_mul(c, 0.5));\n\n    // x = c * (1.0f - fabsf(fmodf(h / 60.0f, 2) - 1.0f));\n    // The product is evaluated with the parenthesised term as the destination\n    // operand, so it takes precedence when both it and `c` are NaN.\n    x = ss_mul(\n        ss_sub(1.0, fabsf(ss_sub(fmodf(ss_div(h, 60.0), 2.0), 1.0))),\n        c,\n    );\n\n    let (r, g, b): (c_float, c_float, c_float) = if h >= 0.0 && h < 60.0 {\n        (ss_add(c, m), ss_add(x, m), m)\n    } else if h >= 60.0 && h < 120.0 {\n        (ss_add(x, m), ss_add(c, m), m)\n    } else if h < 120.0 && h < 180.0 {\n        // Faithful to the original C source, which tests `h < 120.0f` here\n        // where `h >= 120.0f` was evidently intended.\n        (m, ss_add(c, m), ss_add(x, m))\n    } else if h >= 180.0 && h < 240.0 {\n        (m, ss_add(x, m), ss_add(c, m))\n    } else if h >= 240.0 && h < 300.0 {\n        (ss_add(x, m), m, ss_add(c, m))\n    } else if h >= 300.0 && h < 360.0 {\n        (ss_add(c, m), m, ss_add(x, m))\n    } else {\n        (m, m, m)\n    };\n\n    unsafe {\n        *dest.add(0) = r;\n        *dest.add(1) = g;\n        *dest.add(2) = b;\n    }\n}\n","numLines":172,"startLine":1,"totalLines":172}}}
