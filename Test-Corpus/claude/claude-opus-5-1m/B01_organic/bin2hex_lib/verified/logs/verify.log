else","-    echo \"$fails mutant(s) survived or the check itself failed.\"","+    echo \"MUTATION CHECK FAILED: $fails problem(s).\""," fi"," exit \"$fails\""]}],"originalFile":"#!/usr/bin/env bash\n# Harness self-check: every mutation of src/lib.rs below MUST be caught by the\n# differential test suite.  A mutation that survives means the tests are blind.\n# The pristine src/lib.rs is never modified: mutants are built out of $TMPDIR.\nset -u\ncd \"$(dirname \"$0\")\" || exit 1\nROOT=$PWD\nWORK=${TMPDIR:-/tmp}/bin2hex-mutants\nmkdir -p \"$WORK\"\n\nrun_mutant() {\n    local name=\"$1\" sedexpr=\"$2\"\n    local src=\"$WORK/$name.rs\" so=\"$WORK/lib$name.so\"\n    sed \"$sedexpr\" src/lib.rs > \"$src\"\n    if cmp -s src/lib.rs \"$src\"; then\n        echo \"MUT $name: SED DID NOT APPLY (test bug)\"; return 1\n    fi\n    if ! rustc --edition=2021 --crate-type=cdylib --crate-name bin2hex_lib \\\n              -Cdebug-assertions=off -Coverflow-checks=off -Cdebuginfo=0 \\\n              \"$src\" -o \"$so\" 2>\"$WORK/$name.build.log\"; then\n        echo \"MUT $name: DID NOT COMPILE (test bug)\"; tail -3 \"$WORK/$name.build.log\"; return 1\n    fi\n    if RUST_CDYLIB=\"$so\" timeout 600 cargo test --no-default-features -q \\\n           >\"$WORK/$name.test.log\" 2>&1; then\n        echo \"MUT $name: *** SURVIVED *** (tests are blind to this change)\"; return 1\n    else\n        local failed\n        failed=$(grep -c '^test .* FAILED\\|panicked at' \"$WORK/$name.test.log\")\n        echo \"MUT $name: caught (failing assertions: $failed)\"\n        grep -m1 -o '\\[[CEG][0-9a-z/]*\\][^\\\\]*' \"$WORK/$name.test.log\" | head -1\n        return 0\n    fi\n}\n\nfails=0\nrun_mutant swap_nibbles     's/(lo_ch << 8) | hi_ch/(hi_ch << 8) | lo_ch/'          || fails=$((fails+1))\nrun_mutant maxlen_lt        's/hex_maxlen <= bin_len.wrapping_mul(2)/hex_maxlen < bin_len.wrapping_mul(2)/' || fails=$((fails+1))\nrun_mutant limit_gt         's|bin_len >= (18446744073709551615u64 as usize) / 2|bin_len > (18446744073709551615u64 as usize) / 2|' || fails=$((fails+1))\nrun_mutant no_nul           's|^        \\*hex.add(i.wrapping_mul(2)) = 0;|        // removed|' || fails=$((fails+1))\nrun_mutant mask_not         's/& !38u32/\\& 38u32/g'                                  || fails=$((fails+1))\nrun_mutant shift7           's/>> 8) \\& !38u32/>> 7) \\& !38u32/g'                    || fails=$((fails+1))\nrun_mutant nibble_swap_src  's/let c: u32 = (byte \\& 0xf) as u32;/let c: u32 = (byte >> 4) as u32;/' || fails=$((fails+1))\nrun_mutant off_by_one_nul   's|\\*hex.add(i.wrapping_mul(2)) = 0;|*hex.add(i.wrapping_mul(2).wrapping_add(1)) = 0;|' || fails=$((fails+1))\nrun_mutant loop_bound       's|while i < bin_len|while i <= bin_len|'                 || fails=$((fails+1))\nrun_mutant limit_half       's|18446744073709551615u64 as usize) / 2|18446744073709551615u64 as usize) / 4|' || fails=$((fails+1))\n\necho\nif [ \"$fails\" -eq 0 ]; then\n    echo \"ALL MUTANTS CAUGHT — the differential suite is not vacuous.\"\nelse\n    echo \"$fails mutant(s) survived or the check itself failed.\"\nfi\nexit \"$fails\"\n","userModified":false}}
