t\"),\n]\nimps = [(0,\"cbProtanopia\",\"Protanopia\"),(1,\"cbDeuteranopia\",\"Deuteranopia\"),(2,\"cbTritanopia\",\"Tritanopia\")]\n\nrows=[]\nn=0\nfor cid, cdesc, cnt in classes:\n    for iv, iname, helper in imps:\n        n+=1\n        rows.append((f\"C{n}\", \"`colourblind`\",\n            f\"`Impairment={iv}` ({iname} -> static `{helper}`), distinct ptrs, {cdesc} — {cnt} inputs\",\n            f\"cfg_{cid.lower()}_imp{iv}\"))\nfor aid, adesc in alias:\n    if aid == \"A1\":\n        continue\n    for iv, iname, helper in imps:\n        n+=1\n        rows.append((f\"C{n}\", \"`colourblind`\",\n            f\"`Impairment={iv}` ({iname} -> static `{helper}`), **{adesc}**, random normals + full bit patterns — 1000 inputs\",\n            f\"cfg_{aid.lower()}_imp{iv}\"))\nn+=1\nrows.append((f\"C{n}\", \"`colourblind`\", \"byte-offset (unaligned) `float*` for all three args, `Impairment` in {0,1,2}, random normals — 300 inputs (C `movss` has no alignment requirement)\", \"cfg_unaligned_all_imps\"))\nn+=1\nrows.append((f\"C{n}\", \"`colourblind`\", \"sequential calls chaining all three impairments 0->1->2 on the same buffer, random normals — 500 inputs (checks absence of hidden global state)\", \"cfg_chain_all_imps\"))\nn+=1\nrows.append((f\"C{n}\", \"`colourblind`\", \"same input replayed twice in a row (determinism / no internal state) for `Impairment` in {0,1,2}\", \"cfg_replay_determinism\"))\n\nprint(\"| # | entry point(s) | configuration (options set + input shape) | test | [ ] |\")\nprint(\"|---|----------------|--------------------------------------------|------|-----|\")\nfor r in rows:\n    print(f\"| {r[0]} | {r[1]} | {r[2]} | `{r[3]}` | [x] |\")\nprint()\nprint(f\"TOTAL ROWS: {len(rows)}\")\nPYEOF\npython3 $TMPDIR/gen_configs.py > $TMPDIR/configs_table.md && tail -3 $TMPDIR/configs_table.md && wc -l $TMPDIR/configs_table.md","description":"Generate configuration cross-product table"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"in