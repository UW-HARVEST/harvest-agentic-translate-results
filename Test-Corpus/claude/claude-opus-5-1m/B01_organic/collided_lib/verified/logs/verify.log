cts() {\n    // Simply constructing the pair runs the path resolution + staleness guards.\n    let (c, r) = apis();\n    assert_eq!(c.name, \"C\");\n    assert_eq!(r.name, \"Rust\");\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
