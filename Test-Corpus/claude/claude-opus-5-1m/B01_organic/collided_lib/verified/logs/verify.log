min: c2v,\n49\t    pub max: c2v,\n50\t}\n51\t\n52\t// ---------------------------------------------------------------------------\n53\t// Vector helpers\n54\t// ---------------------------------------------------------------------------\n55\t\n56\t/// `c2v c2V(float x, float y)`\n57\t#[unsafe(no_mangle)]\n58\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n59\t    c2v { x, y }\n60\t}\n61\t\n62\t/// `c2v c2Maxv(c2v a, c2v b)`\n63\t///\n64\t/// Uses the C ternary form `a > b ? a : b`; when either operand is NaN the\n65\t/// comparison is false and `b` is returned, exactly as in C.\n66\t#[unsafe(no_mangle)]\n67\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n68\t    c2V(\n69\t        if a.x > b.x { a.x } else { b.x },\n70\t        if a.y > b.y { a.y } else { b.y },\n71\t    )\n72\t}\n73\t\n74\t/// `c2v c2Minv(c2v a, c2v b)`\n75\t///\n76\t/// Uses the C ternary form `a < b ? a : b`; NaN operands select `b`.\n77\t#[unsafe(no_mangle)]\n78\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n79\t    c2V(\n80\t        if a.x < b.x { a.x } else { b.x },\n81\t        if a.y < b.y { a.y } else { b.y },\n82\t    )\n83\t}\n84\t\n85\t/// `c2v c2Clampv(c2v a, c2v lo, c2v hi)`\n86\t#[unsafe(no_mangle)]\n87\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n88\t    c2Maxv(lo, c2Minv(a, hi))\n89\t}\n90\t\n91\t/// `c2v c2Sub(c2v a, c2v b)`\n92\t#[unsafe(no_mangle)]\n93\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n94\t    let mut a = a;\n95\t    a.x -= b.x;\n96\t    a.y -= b.y;\n97\t    a\n98\t}\n99\t\n100\t/// `float c2Dot(c2v a, c2v b)`\n101\t#[unsafe(no_mangle)]\n102\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n103\t    a.x * b.x + a.y * b.y\n104\t}\n105\t\n106\t// ---------------------------------------------------------------------------\n107\t// Boolean collision routines\n108\t// ---------------------------------------------------------------------------\n109\t\n110\t/// `int c2CircletoCircle(c2Circle A, c2Circle B)`\n111\t#[unsafe(no_mang