{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_cov7xaz37joturnfrqnfwcirbwlk2j5wsddwcdug5shb4oeitfma","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_019hNwEiepRwvBDJ7x2NrhMS","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-yWNOkB/translated_rust/tests/differential.rs","content":"//! Differential test harness: loads BOTH the C `.so` and the Rust `.so` with\n//! `libloading` and compares `dequantize_granule` through the FFI boundary.\n//!\n//! Nothing here calls the Rust implementation directly -- every invocation goes\n//! through `dlsym(\"dequantize_granule\")` on the built cdylib, so the\n//! `#[no_mangle] extern \"C\"` wrapper is under test too.\n//!\n//! * Phase B rows (`CONFIGS.md`) -> `phase_b_*` tests\n//! * Phase C rows (`ERRORS.md`)  -> `phase_c_*` tests\n\n#![allow(non_camel_case_types)]\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_int;\nuse std::path::PathBuf;\nuse std::sync::OnceLock;\n\n// ---------------------------------------------------------------------------\n// FFI types -- must match c_src/include/lib.h exactly.\n// ---------------------------------------------------------------------------\n\n#[repr(C)]\n#[derive(Clone, Copy)]\nstruct bs_t {\n    buf: *const u8,\n    pos: c_int,\n    limit: c_int,\n}\n\n#[repr(C)]\n#[derive(Clone)]\nstruct L12_scale_info {\n    scf: [f32; 3 * 64],\n    total_bands: u8,\n    stereo_bands: u8,\n    bitalloc: [u8; 64],\n    scfcod: [u8; 64],\n}\n\n/// `L12_scale_info` followed by slack, because C reads `bitalloc[i]` for\n/// `i` up to `2*total_bands - 1 == 509` -- i.e. up to 380 bytes past the struct.\n/// Keeping that slack inside one allocation makes the OOB read deterministic and\n/// identical for both libraries.\n#[repr(C)]\n#[derive(Clone)]\nstruct SciArena {\n    sci: L12_scale_info,\n    tail: [u8; SCI_TAIL],\n}\nconst SCI_TAIL: usize = 1280;\n\ntype DequantFn = unsafe extern \"C\" fn(*mut f32, *mut bs_t, *mut L12_scale_info, c_int) -> c_int;\n\n// ---------------------------------------------------------------------------\n// Arena geometry\n// ---------------------------------------------------------------------------\n\n/// Bytes of slack before `buf` (only reachable via a negative `bs->pos`, which\n/// the harness normally re-bases away -- kept as a safety net).\nconst BUF_PAD: usize = 4096;\n/// Readable bytes at/after the first byte `get_bits` touches.\nconst BUF_LEN: usize = 1 << 18;\nconst BUF_TOTAL: usize = BUF_PAD * 2 + BUF_LEN;\n/// Largest bit count that keeps every accepted `get_bits` read inside the arena.\nconst MAX_BITS: i32 = ((BUF_LEN - 16) * 8) as i32;\n\n/// `f32` slack before `grbuf`. C never writes below `grbuf` (`2*total_bands` is\n/// always even so `choff` re-enters every granule at +576), but the pad is\n/// compared anyway so that a Rust-only underflow write would be caught.\nconst GR_PAD: usize = 8192;\n/// `f32` slack at/after `grbuf`. C's worst reachable element offset is\n/// `3*group_size + 5148 + group_size - 1` (group_size <= 32 => 5275).\nconst GR_LEN: usize = 16384;\nconst GR_TOTAL: usize = GR_PAD * 2 + GR_LEN;\n\n// ---------------------------------------------------------------------------\n// Library loading\n// ---------------------------------------------------------------------------\n\nfn manifest_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_so_path() -> PathBuf {\n    let p = manifest_dir().join(\"c_src/build/libtranslated_rust.so\");\n    assert!(\n        p.exists(),\n        \"C shared library not built: {p:?}\\n\\\n         run: cd c_src && mkdir -p build && cd build && \\\n         cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\"\n    );\n    p\n}\n\nfn rust_so_path() -> PathBuf {\n    let name = \"libdequantize_granule_lib.so\";\n    // Prefer the profile this test binary itself was built with.\n    let primary = if cfg!(debug_assertions) { \"debug\" } else { \"release\" };\n    let mut cands = vec![manifest_dir().join(\"target\").join(primary).join(name)];\n    for other in [\"debug\", \"release\"] {\n        cands.push(manifest_dir().join(\"target\").join(other).join(name));\n    }\n    for c in &cands {\n        if c.exists() {\n            return c.clone();\n        }\n    }\n    panic!(\"Rust cdylib not found, tried {cands:?}\");\n}\n\nstruct Impls {\n    c: DequantFn,\n    rust: DequantFn,\n}\n\nfn impls() -> &'static Impls {\n    static IMPLS: OnceLock<Impls> = OnceLock::new();\n    IMPLS.get_or_init(|| {\n        let load = |p: PathBuf| -> DequantFn {\n            let lib = unsafe { Library::new(&p) }.unwrap_or_else(|e| panic!(\"dlopen {p:?}: {e}\"));\n            let lib: &'static Library = Box::leak(Box::new(lib));\n            let sym: Symbol<'static, DequantFn> = unsafe { lib.get(b\"dequantize_granule\\0\") }\n                .unwrap_or_else(|e| panic!(\"dlsym dequantize_granule in {p:?}: {e}\"));\n            *sym\n        };\n        Impls {\n            c: load(c_so_path()),\n            rust: load(rust_so_path()),\n        }\n    })\n}\n\n// ---------------------------------------------------------------------------\n// Deterministic RNG (xorshift64*) -- fixed seed => reproducible runs.\n// ---------------------------------------------------------------------------\n\nstruct Rng(u64);\n\nimpl Rng {\n    fn new(seed: u64) -> Self {\n        Rng(seed | 1)\n    }\n    fn next_u64(&mut self) -> u64 {\n        let mut x = self.0;\n        x ^= x >> 12;\n        x ^= x << 25;\n        x ^= x >> 27;\n        self.0 = x;\n        x.wrapping_mul(0x2545_F491_4F6C_DD1D)\n    }\n    fn u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n    fn u8(&mut self) -> u8 {\n        (self.next_u64() >> 33) as u8\n    }\n    /// Uniform in `lo..=hi`.\n    fn range(&mut self, lo: i64, hi: i64) -> i64 {\n        debug_assert!(hi >= lo);\n        let span = (hi - lo + 1) as u64;\n        lo + (self.next_u64() % span) as i64\n    }\n    fn pick<T: Copy>(&mut self, xs: &[T]) -> T {\n        xs[(self.next_u64() % xs.len() as u64) as usize]\n    }\n    fn fill(&mut self, dst: &mut [u8]) {\n        for b in dst.iter_mut() {\n            *b = self.u8();\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Case description + runner\n// ---------------------------------------------------------------------------\n\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\nenum LimitSpec {\n    /// Use this exact `bs->limit`.\n    Abs(i32),\n    /// `bs->limit = pos.wrapping_add(bits)`.\n    RelBits(i32),\n}\n\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\nenum BufSpec {\n    /// `bs->buf` is re-based so that the first byte `get_bits` touches is\n    /// `arena[BUF_PAD]`, whatever `bs->pos` is. Keeps every read in-bounds and\n    /// makes the read stream independent of `pos`.\n    Rebased,\n    /// `bs->buf = arena.as_ptr() + BUF_PAD` verbatim (`pos>>3` is applied on top).\n    Raw,\n    /// `bs->buf = NULL`.\n    Null,\n}\n\n#[derive(Clone)]\nstruct Case {\n    label: String,\n    buf: Vec<u8>,\n    sci: SciArena,\n    pos: i32,\n    limit: LimitSpec,\n    group_size: i32,\n    buf_spec: BufSpec,\n    null_grbuf: bool,\n}\n\n#[derive(PartialEq, Eq)]\nstruct Outcome {\n    ret: c_int,\n    gr: Vec<u32>,\n    buf: Vec<u8>,\n    sci_bytes: Vec<u8>,\n    pos: i32,\n    limit: i32,\n    buf_ptr_unchanged: bool,\n}\n\nfn fresh_gr() -> Vec<u32> {\n    // Unique sentinel per slot: any stray write shows up in the diff.\n    (0..GR_TOTAL as u32).map(|i| 0xDEAD_0000u32 ^ i).collect()\n}\n\nfn sci_bytes(a: &SciArena) -> Vec<u8> {\n    let n = std::mem::size_of::<SciArena>();\n    unsafe { std::slice::from_raw_parts(a as *const SciArena as *const u8, n) }.to_vec()\n}\n\nfn run_one(f: DequantFn, case: &Case) -> Outcome {\n    let mut gr = fresh_gr();\n    let mut buf = case.buf.clone();\n    let mut sci = Box::new(case.sci.clone());\n\n    let base = buf.as_ptr().wrapping_add(BUF_PAD);\n    let bufptr: *const u8 = match case.buf_spec {\n        BufSpec::Rebased => base.wrapping_offset(-((case.pos >> 3) as isize)),\n        BufSpec::Raw => base,\n        BufSpec::Null => std::ptr::null(),\n    };\n    let limit = match case.limit {\n        LimitSpec::Abs(l) => l,\n        LimitSpec::RelBits(b) => case.pos.wrapping_add(b),\n    };\n\n    let mut bs = bs_t {\n        buf: bufptr,\n        pos: case.pos,\n        limit,\n    };\n    let grptr: *mut f32 = if case.null_grbuf {\n        std::ptr::null_mut()\n    } else {\n        (gr.as_mut_ptr() as *mut f32).wrapping_add(GR_PAD)\n    };\n    // Provenance covers the whole SciArena (tail included), matching the C\n    // object that `bitalloc[i>=64]` runs into.\n    let sciptr = (&mut *sci as *mut SciArena) as *mut L12_scale_info;\n\n    let ret = unsafe { f(grptr, &mut bs, sciptr, case.group_size) };\n\n    Outcome {\n        ret,\n        gr,\n        buf,\n        sci_bytes: sci_bytes(&sci),\n        pos: bs.pos,\n        limit: bs.limit,\n        buf_ptr_unchanged: bs.buf == bufptr,\n    }\n}\n\n/// Run the case through both `.so`s and assert byte-identical results.\n#[track_caller]\nfn assert_same(case: &Case) {\n    let i = impls();\n    let c = run_one(i.c, case);\n    let r = run_one(i.rust, case);\n\n    let ctx = || {\n        format!(\n            \"{}\\n  group_size={} pos={} limit={:?} buf={:?} null_grbuf={}\\n  \\\n             total_bands={} stereo_bands={}\\n  bitalloc={:?}\",\n            case.label,\n            case.group_size,\n            case.pos,\n            case.limit,\n            case.buf_spec,\n            case.null_grbuf,\n            case.sci.sci.total_bands,\n            case.sci.sci.stereo_bands,\n            &case.sci.sci.bitalloc[..],\n        )\n    };\n\n    assert_eq!(c.ret, r.ret, \"return value mismatch\\n{}\", ctx());\n    assert_eq!(c.pos, r.pos, \"bs->pos mismatch (C={} rust={})\\n{}\", c.pos, r.pos, ctx());\n    assert_eq!(c.limit, r.limit, \"bs->limit mismatch\\n{}\", ctx());\n    assert_eq!(\n        c.buf_ptr_unchanged,\n        r.buf_ptr_unchanged,\n        \"bs->buf was mutated by exactly one impl\\n{}\",\n        ctx()\n    );\n    assert!(c.buf == r.buf, \"bs->buf contents mismatch\\n{}\", ctx());\n    assert!(\n        c.sci_bytes == r.sci_bytes,\n        \"L12_scale_info mutated differently\\n{}\",\n        ctx()\n    );\n\n    if c.gr != r.gr {\n        let mut diffs = Vec::new();\n        for k in 0..GR_TOTAL {\n            if c.gr[k] != r.gr[k] {\n                diffs.push(format!(\n                    \"  grbuf[{}] C=0x{:08x} ({}) rust=0x{:08x} ({})\",\n                    k as isize - GR_PAD as isize,\n                    c.gr[k],\n                    f32::from_bits(c.gr[k]),\n                    r.gr[k],\n                    f32::from_bits(r.gr[k]),\n                ));\n                if diffs.len() == 12 {\n                    break;\n                }\n            }\n        }\n        panic!(\"grbuf mismatch\\n{}\\n{}\", ctx(), diffs.join(\"\\n\"));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Case builders\n// ---------------------------------------------------------------------------\n\n/// How to populate the bit-reservoir bytes.\n#[derive(Clone, Copy)]\nenum Bytes {\n    Zeros,\n    Ones,\n    Aa55,\n    Random,\n}\n\nfn make_buf(rng: &mut Rng, kind: Bytes) -> Vec<u8> {\n    let mut v = vec![0u8; BUF_TOTAL];\n    match kind {\n        Bytes::Zeros => {}\n        Bytes::Ones => v.fill(0xFF),\n        Bytes::Aa55 => {\n            for (i, b) in v.iter_mut().enumerate() {\n                *b = if i % 2 == 0 { 0xAA } else { 0x55 };\n            }\n        }\n        Bytes::Random => rng.fill(&mut v),\n    }\n    v\n}\n\n/// A fully randomized `SciArena`; `bitalloc` is then overwritten by the caller.\nfn make_sci(rng: &mut Rng, total_bands: u8) -> SciArena {\n    let mut a = SciArena {\n        sci: L12_scale_info {\n            scf: [0.0; 192],\n            total_bands,\n            stereo_bands: rng.u8(),\n            bitalloc: [0; 64],\n            scfcod: [0; 64],\n        },\n        tail: [0; SCI_TAIL],\n    };\n    for s in a.sci.scf.iter_mut() {\n        *s = f32::from_bits(rng.u32());\n    }\n    rng.fill(&mut a.sci.scfcod);\n    rng.fill(&mut a.tail);\n    a\n}\n\n/// Fill `bitalloc` with values drawn from `classes` (a set of inclusive ranges).\nfn fill_bitalloc(rng: &mut Rng, sci: &mut SciArena, classes: &[(u8, u8)]) {\n    for i in 0..64 {\n        let (lo, hi) = rng.pick(classes);\n        sci.sci.bitalloc[i] = rng.range(lo as i64, hi as i64) as u8;\n    }\n}\n\n/// Number of bits the granule consumes when every `bitalloc` value is < 17\n/// (used to build \"exact fit\" reservoirs).\nfn exact_fit_bits(sci: &SciArena, group_size: i32) -> i64 {\n    let mut bits = 0i64;\n    if group_size <= 0 {\n        return 0;\n    }\n    for _j in 0..4 {\n        for i in 0..(2 * sci.sci.total_bands as usize) {\n            let ba = sci.sci.bitalloc[i % 64] as i64;\n            if ba != 0 && ba < 17 {\n                bits += ba * group_size as i64;\n            }\n        }\n    }\n    bits\n}\n\nconst LOW: &[(u8, u8)] = &[(1, 16)];\nconst LOW_NARROW: &[(u8, u8)] = &[(1, 8)];\nconst LOW_WIDE: &[(u8, u8)] = &[(9, 16)];\nconst HIGH_SMALL: &[(u8, u8)] = &[(17, 24)];\nconst MIXED: &[(u8, u8)] = &[(0, 0), (1, 16), (17, 32)];\nconst ANY: &[(u8, u8)] = &[(0, 255)];\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":163,"cache_read_input_tokens":59312,"cache_creation":{"ephemeral_5m_input_tokens":163,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"bde487b0-43b2-4a9c-9ba4-46960388e887","uuid":"834c6e83-8178-479b-aabf-fb2d1d44b798","timestamp":"2026-08-19T11:49:57.854Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019hNwEiepRwvBDJ7x2NrhMS","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-yWNOkB/translated_rust/tests/differential.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"bde487b0-43b2-4a9c-9ba4-46960388e887","uuid":"2f4664aa-07a2-4b16-97a7-6b0ce2c4dc76","timestamp":"2026-08-19T11:49:57.863Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-yWNOkB/translated_rust/tests/differential.rs","content":"//! Differential test harness: loads BOTH the C `.so` and the Rust `.so` with\n//! `libloading` and compares `dequantize_granule` through the FFI boundary.\n//!\n//! Nothing here calls the Rust implementation directly -- every invocation goes\n//! through `dlsym(\"dequantize_granule\")` on the built cdylib, so the\n//! `#[no_mangle] extern \"C\"` wrapper is under test too.\n//!\n//! * Phase B rows (`CONFIGS.md`) -> `phase_b_*` tests\n//! * Phase C rows (`ERRORS.md`)  -> `phase_c_*` tests\n\n#![allow(non_camel_case_types)]\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_int;\nuse std::path::PathBuf;\nuse std::sync::OnceLock;\n\n// ---------------------------------------------------------------------------\n// FFI types -- must match c_src/include/lib.h exactly.\n// ---------------------------------------------------------------------------\n\n#[repr(C)]\n#[derive(Clone, Copy)]\nstruct bs_t {\n    buf: *const u8,\n    pos: c_int,\n    limit: c_int,\n}\n\n#[repr(C)]\n#[derive(Clone)]\nstruct L12_scale_info {\n    scf: [f32; 3 * 64],\n    total_bands: u8,\n    stereo_bands: u8,\n    bitalloc: [u8; 64],\n    scfcod: [u8; 64],\n}\n\n/// `L12_scale_info` followed by slack, because C reads `bitalloc[i]` for\n/// `i` up to `2*total_bands - 1 == 509` -- i.e. up to 380 bytes past the struct.\n/// Keeping that slack inside one allocation makes the OOB read deterministic and\n/// identical for both libraries.\n#[repr(C)]\n#[derive(Clone)]\nstruct SciArena {\n    sci: L12_scale_info,\n    tail: [u8; SCI_TAIL],\n}\nconst SCI_TAIL: usize = 1280;\n\ntype DequantFn = unsafe extern \"C\" fn(*mut f32, *mut bs_t, *mut L12_scale_info, c_int) -> c_int;\n\n// ---------------------------------------------------------------------------\n// Arena geometry\n// ---------------------------------------------------------------------------\n\n/// Bytes of slack before `buf` (only reachable via a negative `bs->pos`, which\n/// the harness normally re-bases away -- kept as a safety net).\nconst BUF_PAD: usize = 4096;\n/// Readable bytes at/after the first byte `get_bits` touches.\nconst BUF_LEN: usize = 1 << 18;\nconst BUF_TOTAL: usize = BUF_PAD * 2 + BUF_LEN;\n/// Largest bit count that keeps every accepted `get_bits` read inside the arena.\nconst MAX_BITS: i32 = ((BUF_LEN - 16) * 8) as i32;\n\n/// `f32` slack before `grbuf`. C never writes below `grbuf` (`2*total_bands` is\n/// always even so `choff` re-enters every granule at +576), but the pad is\n/// compared anyway so that a Rust-only underflow write would be caught.\nconst GR_PAD: usize = 8192;\n/// `f32` slack at/after `grbuf`. C's worst reachable element offset is\n/// `3*group_size + 5148 + group_size - 1` (group_size <= 32 => 5275).\nconst GR_LEN: usize = 16384;\nconst GR_TOTAL: usize = GR_PAD * 2 + GR_LEN;\n\n// ---------------------------------------------------------------------------\n// Library loading\n// ---------------------------------------------------------------------------\n\nfn manifest_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_so_path() -> PathBuf {\n    let p = manifest_dir().join(\"c_src/build/libtranslated_rust.so\");\n    assert!(\n        p.exists(),\n        \"C shared library not built: {p:?}\\n\\\n         run: cd c_src && mkdir -p build && cd build && \\\n         cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\"\n    );\n    p\n}\n\nfn rust_so_path() -> PathBuf {\n    let name = \"libdequantize_granule_lib.so\";\n    // Prefer the profile this test binary itself was built with.\n    let primary = if cfg!(debug_assertions) { \"debug\" } else { \"release\" };\n    let mut cands = vec![manifest_dir().join(\"target\").join(primary).join(name)];\n    for other in [\"debug\", \"release\"] {\n        cands.push(manifest_dir().join(\"target\").join(other).join(name));\n    }\n    for c in &cands {\n        if c.exists() {\n            return c.clone();\n        }\n    }\n    panic!(\"Rust cdylib not found, tried {cands:?}\");\n}\n\nstruct Impls {\n    c: DequantFn,\n    rust: DequantFn,\n}\n\nfn impls() -> &'static Impls {\n    static IMPLS: OnceLock<Impls> = OnceLock::new();\n    IMPLS.get_or_init(|| {\n        let load = |p: PathBuf| -> DequantFn {\n            let lib = unsafe { Library::new(&p) }.unwrap_or_else(|e| panic!(\"dlopen {p:?}: {e}\"));\n            let lib: &'static Library = Box::leak(Box::new(lib));\n            let sym: Symbol<'static, DequantFn> = unsafe { lib.get(b\"dequantize_granule\\0\") }\n                .unwrap_or_else(|e| panic!(\"dlsym dequantize_granule in {p:?}: {e}\"));\n            *sym\n        };\n        Impls {\n            c: load(c_so_path()),\n            rust: load(rust_so_path()),\n        }\n    })\n}\n\n// ---------------------------------------------------------------------------\n// Deterministic RNG (xorshift64*) -- fixed seed => reproducible runs.\n// ---------------------------------------------------------------------------\n\nstruct Rng(u64);\n\nimpl Rng {\n    fn new(seed: u64) -> Self {\n        Rng(seed | 1)\n    }\n    fn next_u64(&mut self) -> u64 {\n        let mut x = self.0;\n        x ^= x >> 12;\n        x ^= x << 25;\n        x ^= x >> 27;\n        self.0 = x;\n        x.wrapping_mul(0x2545_F491_4F6C_DD1D)\n    }\n    fn u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n    fn u8(&mut self) -> u8 {\n        (self.next_u64() >> 33) as u8\n    }\n    /// Uniform in `lo..=hi`.\n    fn range(&mut self, lo: i64, hi: i64) -> i64 {\n        debug_assert!(hi >= lo);\n        let span = (hi - lo + 1) as u64;\n        lo + (self.next_u64() % span) as i64\n    }\n    fn pick<T: Copy>(&mut self, xs: &[T]) -> T {\n        xs[(self.next_u64() % xs.len() as u64) as usize]\n    }\n    fn fill(&mut self, dst: &mut [u8]) {\n        for b in dst.iter_mut() {\n            *b = self.u8();\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Case description + runner\n// ---------------------------------------------------------------------------\n\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\nenum LimitSpec {\n    /// Use this exact `bs->limit`.\n    Abs(i32),\n    /// `bs->limit = pos.wrapping_add(bits)`.\n    RelBits(i32),\n}\n\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\nenum BufSpec {\n    /// `bs->buf` is re-based so that the first byte `get_bits` touches is\n    /// `arena[BUF_PAD]`, whatever `bs->pos` is. Keeps every read in-bounds and\n    /// makes the read stream independent of `pos`.\n    Rebased,\n    /// `bs->buf = arena.as_ptr() + BUF_PAD` verbatim (`pos>>3` is applied on top).\n    Raw,\n    /// `bs->buf = NULL`.\n    Null,\n}\n\n#[derive(Clone)]\nstruct Case {\n    label: String,\n    buf: Vec<u8>,\n    sci: SciArena,\n    pos: i32,\n    limit: LimitSpec,\n    group_size: i32,\n    buf_spec: BufSpec,\n    null_grbuf: bool,\n}\n\n#[derive(PartialEq, Eq)]\nstruct Outcome {\n    ret: c_int,\n    gr: Vec<u32>,\n    buf: Vec<u8>,\n    sci_bytes: Vec<u8>,\n    pos: i32,\n    limit: i32,\n    buf_ptr_unchanged: bool,\n}\n\nfn fresh_gr() -> Vec<u32> {\n    // Unique sentinel per slot: any stray write shows up in the diff.\n    (0..GR_TOTAL as u32).map(|i| 0xDEAD_0000u32 ^ i).collect()\n}\n\nfn sci_bytes(a: &SciArena) -> Vec<u8> {\n    let n = std::mem::size_of::<SciArena>();\n    unsafe { std::slice::from_raw_parts(a as *const SciArena as *const u8, n) }.to_vec()\n}\n\nfn run_one(f: DequantFn, case: &Case) -> Outcome {\n    let mut gr = fresh_gr();\n    let mut buf = case.buf.clone();\n    let mut sci = Box::new(case.sci.clone());\n\n    let base = buf.as_ptr().wrapping_add(BUF_PAD);\n    let bufptr: *const u8 = match case.buf_spec {\n        BufSpec::Rebased => base.wrapping_offset(-((case.pos >> 3) as isize)),\n        BufSpec::Raw => base,\n        BufSpec::Null => std::ptr::null(),\n    };\n    let limit = match case.limit {\n        LimitSpec::Abs(l) => l,\n        LimitSpec::RelBits(b) => case.pos.wrapping_add(b),\n    };\n\n    let mut bs = bs_t {\n        buf: bufptr,\n        pos: case.pos,\n        limit,\n    };\n    let grptr: *mut f32 = if case.null_grbuf {\n        std::ptr::null_mut()\n    } else {\n        (gr.as_mut_ptr() as *mut f32).wrapping_add(GR_PAD)\n    };\n    // Provenance covers the whole SciArena (tail included), matching the C\n    // object that `bitalloc[i>=64]` runs into.\n    let sciptr = (&mut *sci as *mut SciArena) as *mut L12_scale_info;\n\n    let ret = unsafe { f(grptr, &mut bs, sciptr, case.group_size) };\n\n    Outcome {\n        ret,\n        gr,\n        buf,\n        sci_bytes: sci_bytes(&sci),\n        pos: bs.pos,\n        limit: bs.limit,\n        buf_ptr_unchanged: bs.buf == bufptr,\n    }\n}\n\n/// Run the case through both `.so`s and assert byte-identical results.\n#[track_caller]\nfn assert_same(case: &Case) {\n    let i = impls();\n    let c = run_one(i.c, case);\n    let r = run_one(i.rust, case);\n\n    let ctx = || {\n        format!(\n            \"{}\\n  group_size={} pos={} limit={:?} buf={:?} null_grbuf={}\\n  \\\n             total_bands={} stereo_bands={}\\n  bitalloc={:?}\",\n            case.label,\n            case.group_size,\n            case.pos,\n            case.limit,\n            case.buf_spec,\n            case.null_grbuf,\n            case.sci.sci.total_bands,\n            case.sci.sci.stereo_bands,\n            &case.sci.sci.bitalloc[..],\n        )\n    };\n\n    assert_eq!(c.ret, r.ret, \"return value mismatch\\n{}\", ctx());\n    assert_eq!(c.pos, r.pos, \"bs->pos mismatch (C={} rust={})\\n{}\", c.pos, r.pos, ctx());\n    assert_eq!(c.limit, r.limit, \"bs->limit mismatch\\n{}\", ctx());\n    assert_eq!(\n        c.buf_ptr_unchanged,\n        r.buf_ptr_unchanged,\n        \"bs->buf was mutated by exactly one impl\\n{}\",\n        ctx()\n    );\n    assert!(c.buf == r.buf, \"bs->buf contents mismatch\\n{}\", ctx());\n    assert!(\n        c.sci_bytes == r.sci_bytes,\n        \"L12_scale_info mutated differently\\n{}\",\n        ctx()\n    );\n\n    if c.gr != r.gr {\n        let mut diffs = Vec::new();\n        for k in 0..GR_TOTAL {\n            if c.gr[k] != r.gr[k] {\n                diffs.push(format!(\n                    \"  grbuf[{}] C=0x{:08x} ({}) rust=0x{:08x} ({})\",\n                    k as isize - GR_PAD as isize,\n                    c.gr[k],\n                    f32::from_bits(c.gr[k]),\n                    r.gr[k],\n                    f32::from_bits(r.gr[k]),\n                ));\n                if diffs.len() == 12 {\n                    break;\n                }\n            }\n        }\n        panic!(\"grbuf mismatch\\n{}\\n{}\", ctx(), diffs.join(\"\\n\"));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Case builders\n// ---------------------------------------------------------------------------\n\n/// How to populate the bit-reservoir bytes.\n#[derive(Clone, Copy)]\nenum Bytes {\n    Zeros,\n    Ones,\n    Aa55,\n    Random,\n}\n\nfn make_buf(rng: &mut Rng, kind: Bytes) -> Vec<u8> {\n    let mut v = vec![0u8; BUF_TOTAL];\n    match kind {\n        Bytes::Zeros => {}\n        Bytes::Ones => v.fill(0xFF),\n        Bytes::Aa55 => {\n            for (i, b) in v.iter_mut().enumerate() {\n                *b = if i % 2 == 0 { 0xAA } else { 0x55 };\n            }\n        }\n        Bytes::Random => rng.fill(&mut v),\n    }\n    v\n}\n\n/// A fully randomized `SciArena`; `bitalloc` is then overwritten by the caller.\nfn make_sci(rng: &mut Rng, total_bands: u8) -> SciArena {\n    let mut a = SciArena {\n        sci: L12_scale_info {\n            scf: [0.0; 192],\n            total_bands,\n            stereo_bands: rng.u8(),\n            bitalloc: [0; 64],\n            scfcod: [0; 64],\n        },\n        tail: [0; SCI_TAIL],\n    };\n    for s in a.sci.scf.iter_mut() {\n        *s = f32::from_bits(rng.u32());\n    }\n    rng.fill(&mut a.sci.scfcod);\n    rng.fill(&mut a.tail);\n    a\n}\n\n/// Fill `bitalloc` with values drawn from `classes` (a set of inclusive ranges).\nfn fill_bitalloc(rng: &mut Rng, sci: &mut SciArena, classes: &[(u8, u8)]) {\n    for i in 0..64 {\n        let (lo, hi) = rng.pick(classes);\n        sci.sci.bitalloc[i] = rng.range(lo as i64, hi as i64) as u8;\n    }\n}\n\n/// Number of bits the granule consumes when every `bitalloc` value is < 17\n/// (used to build \"exact fit\" reservoirs).\nfn exact_fit_bits(sci: &SciArena, group_size: i32) -> i64 {\n    let mut bits = 0i64;\n    if group_size <= 0 {\n        return 0;\n    }\n    for _j in 0..4 {\n        for i in 0..(2 * sci.sci.total_bands as usize) {\n            let ba = sci.sci.bitalloc[i % 64] as i64;\n            if ba != 0 && ba < 17 {\n                bits += ba * group_size as i64;\n            }\n        }\n    }\n    bits\n}\n\nconst LOW: &[(u8, u8)] = &[(1, 16)];\nconst LOW_NARROW: &[(u8, u8)] = &[(1, 8)];\nconst LOW_WIDE: &[(u8, u8)] = &[(9, 16)];\nconst HIGH_SMALL: &[(u8, u8)] = &[(17, 24)];\nconst MIXED: &[(u8, u8)] = &[(0, 0), (1, 16), (17, 32)];\nconst ANY: &[(u8, u8)] = &[(0, 255)];\n","structuredPatch":[],"originalFile":null,"userModified":false}}
