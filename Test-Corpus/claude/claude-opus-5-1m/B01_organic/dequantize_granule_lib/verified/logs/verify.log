ssert_eq!(a.pos, b.pos, \"E3: pos advances identically on reject\");\n            assert_ne!(a.gr, b.gr, \"E3: the last field must actually be rejected\");\n            // ...and the rejected field is exactly `0 - half` of the last band.\n            let i_last = 2 * tb as i32 - 1;\n            let o_last = 18 * (i_last / 2) + if i_last % 2 == 1 { 576 } else { 0 };\n            let idx = (gs * 3 + o_last + gs - 1) as isize;\n            let ba_last = sci_ba(&fit.sci, i_last as usize);\n            assert_eq!(\n                gr_at(&b, idx),\n                -(half_of(ba_last) as f32),\n                \"E3: last field must yield 0-half\"\n            );\n            t.run(&fit);\n            t.run(&short);\"\"\"\nassert old in s; s = s.replace(old, new)\n\n# ---- E6: observability guards on the direct run_one calls ----\nold = \"\"\"        c.pos = pos;\n        c.buf_spec = BufSpec::Rebased;\n        let neg = run_one(impls().c, &c);\n\n        let mut zero = c.clone();\n        zero.pos = 0;\n        zero.buf_spec = BufSpec::Raw;\n        let z = run_one(impls().c, &zero);\"\"\"\nnew = \"\"\"        c.pos = pos;\n        c.buf_spec = BufSpec::Rebased;\n        assert!(observable(&c));\n        let neg = run_one(impls().c, &c);\n\n        let mut zero = c.clone();\n        zero.pos = 0;\n        zero.buf_spec = BufSpec::Raw;\n        assert!(observable(&zero));\n        let z = run_one(impls().c, &zero);\"\"\"\nassert old in s; s = s.replace(old, new)\nopen(p,'w').write(s)\nprint(\"ok\")\nPYEOF\ntimeout 600 cargo test --no-default-features --no-run 2>&1 | grep -E \"^error\" -A 8 | head -40; echo BUILD_DONE","description":"Harden E2/E3/E6"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2182,"cache_read_input_tokens":163077,"cache_creation":{"ephemeral_5m_input_tokens":2182,"ephemeral_1h_input_tokens":0},"output_tokens":21,"service_tier":"standard"},"context_management":null},"parent_tool_use_id