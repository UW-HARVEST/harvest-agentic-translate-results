> bs->limit)\n50\t///         return 0;\n51\t///     next = *p++ & (255 >> s);\n52\t///     while ((shl -= 8) > 0) {\n53\t///         cache |= next << shl;\n54\t///         next = *p++;\n55\t///     }\n56\t///     return cache | (next >> -shl);\n57\t/// }\n58\t/// ```\n59\t///\n60\t/// # Safety\n61\t/// `bs` must be a valid pointer; `bs->buf` must be readable for the bits the\n62\t/// caller requests (the C code has the same, unchecked, requirement).\n63\tunsafe fn get_bits(bs: *mut bs_t, n: c_int) -> u32 {\n64\t    unsafe {\n65\t        let mut cache: u32 = 0;\n66\t        // `s = bs->pos & 7` is always in 0..=7, even for a negative `pos`.\n67\t        let s: u32 = ((*bs).pos & 7) as u32;\n68\t        // `int shl = n + s;` -- computed in `unsigned`, stored back into `int`.\n69\t        let mut shl: i32 = (n as u32).wrapping_add(s) as i32;\n70\t        let mut p: *const u8 = (*bs).buf.wrapping_offset(((*bs).pos >> 3) as isize);\n71\t\n72\t        // NOTE: `pos` is advanced before (and regardless of) the limit test.\n73\t        (*bs).pos = (*bs).pos.wrapping_add(n);\n74\t        if (*bs).pos > (*bs).limit {\n75\t            return 0;\n76\t        }\n77\t\n78\t        let mut next: u32 = (*p as u32) & (255u32 >> s);\n79\t        p = p.wrapping_add(1);\n80\t\n81\t        loop {\n82\t            shl = shl.wrapping_sub(8);\n83\t            if shl <= 0 {\n84\t                break;\n85\t            }\n86\t            cache |= next.wrapping_shl(shl as u32);\n87\t            next = *p as u32;\n88\t            p = p.wrapping_add(1);\n89\t        }\n90\t\n91\t        // `-shl` is in 0..=8 here; a shift of 32+ can only arise from an absurd\n92\t        // `n`, and `wrapping_shr` then mirrors what the C compiles to on x86.\n93\t        cache | next.wrapping_shr(shl.wrapping_neg() as u32)\n94\t    }\n95\t}\n96\t\n97\t/// ```c\n98\t/// int dequantize_granule(float *grbuf, bs_t *bs, L12_scale_info *sci,\n99\t///                        int group_size);\n100\t/// ```\n101\t///\n102