 }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3809,"cache_read_input_tokens":35270,"cache_creation":{"ephemeral_5m_input_tokens":3809,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"89abdd36-4b93-407b-b420-8213123b136a","uuid":"448afb33-de41-4f09-8854-d9891093b748","timestamp":"2026-08-19T14:03:11.108Z"}
