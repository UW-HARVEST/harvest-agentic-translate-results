{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Rm2hqmYcEhmeH4WuKgtjqb","type":"tool_result","content":"     1\t//! Hashing and hash-index construction (`stbds_rand_seed`, `stbds_hash_string`,\n     2\t//! `stbds_hash_bytes`, `stbds_make_hash_index`, ...).\n     3\t\n     4\tuse core::ffi::{c_char, c_void};\n     5\t\n     6\tuse crate::ffi::*;\n     7\t\n     8\t/// `static size_t stbds_hash_seed=0x31415926;`\n     9\tpub static mut STBDS_HASH_SEED: usize = 0x3141_5926;\n    10\t\n    11\t/// ```c\n    12\t/// void stbds_rand_seed(size_t seed) { stbds_hash_seed = seed; }\n    13\t/// ```\n    14\t#[unsafe(no_mangle)]\n    15\tpub extern \"C\" fn stbds_rand_seed(seed: usize) {\n    16\t    unsafe {\n    17\t        STBDS_HASH_SEED = seed;\n    18\t    }\n    19\t}\n    20\t\n    21\t/// ```c\n    22\t/// static size_t stbds_probe_position(size_t hash, size_t slot_count, size_t slot_log2)\n    23\t/// { pos = hash & (slot_count-1); return pos; }\n    24\t/// ```\n    25\t#[inline]\n    26\tpub fn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n    27\t    hash & slot_count.wrapping_sub(1)\n    28\t}\n    29\t\n    30\t/// ```c\n    31\t/// static size_t stbds_log2(size_t slot_count)\n    32\t/// ```\n    33\tfn stbds_log2(mut slot_count: usize) -> usize {\n    34\t    let mut n: usize = 0;\n    35\t    while slot_count > 1 {\n    36\t        slot_count >>= 1;\n    37\t        n += 1;\n    38\t    }\n    39\t    n\n    40\t}\n    41\t\n    42\t/// `#define STBDS_ALIGN_FWD(n,a) (((n) + (a) - 1) & ~((a)-1))`\n    43\t#[inline]\n    44\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n    45\t    n.wrapping_add(a - 1) & !(a - 1)\n    46\t}\n    47\t\n    48\t/// `#define STBDS_ROTATE_LEFT(val, n)  (((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n))))`\n    49\t#[inline]\n    50\tfn rotl(val: usize, n: u32) -> usize {\n    51\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n    52\t}\n    53\t\n    54\t/// `#define STBDS_ROTATE_RIGHT(val, n) (((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n))))`\n    55\t#[inline]\n    56\tfn rotr(val: usize, n: u32) -> usize {\n    57\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n    58\t}\n    59\t\n    60\t/// ```c\n    61\t/// static stbds_hash_index *stbds_make_hash_index(size_t slot_count, stbds_hash_index *ot)\n    62\t/// ```\n    63\tpub unsafe fn stbds_make_hash_index(\n    64\t    slot_count: usize,\n    65\t    ot: *mut StbdsHashIndex,\n    66\t) -> *mut StbdsHashIndex {\n    67\t    let t: *mut StbdsHashIndex = realloc(\n    68\t        core::ptr::null_mut(),\n    69\t        (slot_count >> STBDS_BUCKET_SHIFT) * core::mem::size_of::<StbdsHashBucket>()\n    70\t            + core::mem::size_of::<StbdsHashIndex>()\n    71\t            + STBDS_CACHE_LINE_SIZE\n    72\t            - 1,\n    73\t    ) as *mut StbdsHashIndex;\n    74\t    (*t).storage =\n    75\t        stbds_align_fwd(t.wrapping_add(1) as usize, STBDS_CACHE_LINE_SIZE) as *mut StbdsHashBucket;\n    76\t    (*t).slot_count = slot_count;\n    77\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n    78\t    (*t).tombstone_count = 0;\n    79\t    (*t).used_count = 0;\n    80\t\n    81\t    (*t).used_count_threshold = slot_count - (slot_count >> 2);\n    82\t    (*t).tombstone_count_threshold = (slot_count >> 3) + (slot_count >> 4);\n    83\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n    84\t\n    85\t    if slot_count <= STBDS_BUCKET_LENGTH {\n    86\t        (*t).used_count_shrink_threshold = 0;\n    87\t    }\n    88\t    stbds_assert!((*t).used_count_threshold + (*t).tombstone_count_threshold < (*t).slot_count);\n    89\t\n    90\t    if !ot.is_null() {\n    91\t        (*t).string = (*ot).string;\n    92\t        (*t).seed = (*ot).seed;\n    93\t    } else {\n    94\t        // memset(&t->string, 0, sizeof(t->string));\n    95\t        core::ptr::write_bytes(\n    96\t            core::ptr::addr_of_mut!((*t).string) as *mut u8,