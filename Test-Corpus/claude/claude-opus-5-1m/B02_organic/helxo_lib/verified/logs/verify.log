                  let src = (raw_a as *mut u8)\n315\t                                    .wrapping_add(elemsize.wrapping_mul((*bucket).index[i] as usize))\n316\t                                    .wrapping_add(keyoffset) as *mut *mut c_char;\n317\t                                stbds_temp_key_set(a, *src);\n318\t                            }\n319\t                            return stbds_arr_to_hash(a, elemsize);\n320\t                        }\n321\t                    } else if (*bucket).hash[i] == 0 {\n322\t                        pos = (pos & !STBDS_BUCKET_MASK) + i;\n323\t                        break 'found_empty_slot;\n324\t                    } else if tombstone < 0 {\n325\t                        if (*bucket).index[i] == STBDS_INDEX_DELETED {\n326\t                            tombstone = ((pos & !STBDS_BUCKET_MASK) + i) as isize;\n327\t                        }\n328\t                    }\n329\t                    i += 1;\n330\t                }\n331\t\n332\t                let limit = pos & STBDS_BUCKET_MASK;\n333\t                let mut i = 0usize;\n334\t                let mut empty_slot = false;\n335\t                while i < limit {\n336\t                    if (*bucket).hash[i] == hash {\n337\t                        if stbds_is_key_equal(\n338\t                            raw_a,\n339\t                            elemsize,\n340\t                            key,\n341\t                            keysize,\n342\t                            keyoffset,\n343\t                            mode,\n344\t                            (*bucket).index[i] as usize,\n345\t                        ) != 0\n346\t                        {\n347\t                            stbds_temp_set(a, (*bucket).index[i]);\n348\t                            return stbds_arr_to_hash(a, elemsize);\n349\t                        }\n350\t                    } else if (*bucket).hash[i] == 0 {\n351\t                        pos = (pos & !STBDS_BUCKET_MASK) + i;\n352\t                        empty_slot = true;\n353\t                        break;\n354\t                    } else if tombstone < 0 {\n355\t                        if (*bucket).index[i] == STBDS_INDEX_DELETED {\n356\t                            tombstone = ((pos & !STBDS_BUCKET_MASK) + i) as isize;\n357\t                        }\n358\t                    }\n359\t                    i += 1;\n360\t                }\n361\t                if empty_slot {\n362\t                    break 'found_empty_slot;\n363\t                }\n364\t\n365\t                pos = pos.wrapping_add(step);\n366\t                step += STBDS_BUCKET_LENGTH;\n367\t                pos &= (*table).slot_count - 1;\n368\t            }\n369\t\n370\t            // found_empty_slot:\n371\t            if tombstone >= 0 {\n372\t                pos = tombstone as usize;\n373\t                (*table).tombstone_count -= 1;\n374\t            }\n375\t            (*table).used_count += 1;\n376\t\n377\t            {\n378\t                let i: isize = stbds_arrlen(a);\n379\t                if (i as usize).wrapping_add(1) > stbds_arrcap(a) {\n380\t                    a = stbds_arrgrowf(a, elemsize, 1, 0);\n381\t                }\n382\t                raw_a = stbds_arr_to_hash(a, elemsize);\n383\t                let _ = raw_a;\n384\t\n385\t                stbds_assert!((i as usize) + 1 <= stbds_arrcap(a));\n386\t                (*stbds_header(a)).length = (i + 1) as usize;\n387\t                bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n388\t                (*bucket).hash[pos & STBDS_BUCKET_MASK] = hash;\n389\t                (*bucket).index[pos & STBDS_BUCKET_MASK] = i - 1;\n390\t                stbds_temp_set(a, i - 1);\n391\t\n392\t                let dst = (a as *mut u8).wrapping_add(elemsize.wrapping_mul(i as usize));\n393\t                match (*table).string.mode as c_int {\n394\t                    STBDS_SH_STRDUP => {\n395\t                        let v = stbds_strdup(key as *mut c_char);\n396\t                        *(dst as *mut *mut c_char) = v;\n397\t                        stbds_temp_key_set(a, v);\n398\t                    }\n399\t                    STBDS_SH_ARENA => {\n400\t                        let v = stbds_stralloc(\n401\t                            core::ptr::addr_of_mut!((*table).string),\n402\t                            key as *mut c_char,\n403\t                        );\n404\t                        *(dst as *mut *mut c_char) = v;\n405\t                        stbds_temp_key_set(a, v);\n406\t                    }\n407\t                    STBDS_SH_DEFAULT => {\n408\t                        let v = key as *mut c_char;\n409\t                        *(dst as *mut *mut c_char) = v;\n410\t                        stbds_temp_key_set(a, v);\n411\t                    }\n412\t                    _ => {\n413\t                        memmove_key(dst, key, keysize);\n414\t                    }\n415\t                }\n416\t            }\n417\t            stbds_arr_to_hash(a, elemsize)\n418\t        }\n419\t    }\n420\t}\n421\t\n422\t/// `memcpy((char *) a + elemsize*i, key, keysize);`\n423\t#[inline]\n424\tunsafe fn memmove_key(dst: *mut u8, key: *mut c_void, keysize: usize) {\n425\t    memcpy(dst as *mut c_void, key as *const c_void, keysize);\n426\t}\n427\t\n428\t/// ```c\n429\t/// void * stbds_shmode_func(size_t elemsize, int mode)\n430\t/// ```\n431\t#[unsafe(no_mangle)]\n432\tpub extern \"C\" fn stbds_shmode_func(elemsize: usize, mode: c_int) -> *mut c_void {\n433\t    unsafe {\n434\t        let a = stbds_arrgrowf(core::ptr::null_mut(), elemsize, 0, 1);\n435\t        let h: *mut StbdsHashIndex;\n436\t        core::ptr::write_bytes(a as *mut u8, 0, elemsize);\n437\t        (*stbds_header(a)).length = 1;\n438\t        h = stbds_make_hash_index(STBDS_BUCKET_LENGTH, core::ptr::null_mut());\n439\t        (*stbds_header(a)).hash_table = h as *mut c_void;\n440\t        (*h).string.mode = mode as u8;\n441\t        stbds_arr_to_hash(a, elemsize)\n442\t    }\n443\t}\n444\t\n445\t/// ```c\n446\t/// void * stbds_hmdel_key(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode)\n447\t/// ```\n448\t#[unsafe(no_mangle)]\n449\tpub extern \"C\" fn stbds_hmdel_key(\n450\t    a: *mut c_void,\n451\t    elemsize: usize,\n452\t    key: *mut c_void,\n453\t    keysize: usize,\n454\t    keyoffset: usize,\n455\t    mode: c_int,\n456\t) -> *mut c_void {\n457\t    unsafe {\n458\t        if a.is_null() {\n459\t            core::ptr::null_mut()\n460\t        } else {\n461\t            let table: *mut StbdsHashIndex;\n462\t            let raw_a = stbds_hash_to_arr(a, elemsize);\n463\t            table = (*stbds_header(raw_a)).hash_table as *mut StbdsHashIndex;\n464\t            stbds_temp_set(raw_a, 0);\n465\t            if table.is_null() {\n466\t                a\n467\t            } else {\n468\t                let mut slot: isize;\n469\t                slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n470\t                if slot < 0 {\n471\t                    a\n472\t                } else {\n473\t                    let mut b: *mut StbdsHashBucket =\n474\t                        (*table).storage.wrapping_offset(slot >> STBDS_BUCKET_SHIFT);\n475\t                    let mut i: usize = (slot as usize) & STBDS_BUCKET_MASK;\n476\t                    let old_index: isize = (*b).index[i];\n477\t                    let final_index: isize = stbds_arrlen(raw_a) - 1 - 1;\n478\t                    stbds_assert!(slot < (*table).slot_count as isize);\n479\t                    (*table).used_count -= 1;\n480\t                    (*table).tombstone_count += 1;\n481\t                    stbds_temp_set(raw_a, 1);\n482\t                    stbds_assert!((*table).used_count as isize >= 0);\n483\t                    (*b).hash[i] = STBDS_HASH_DELETED;\n484\t                    (*b).index[i] = STBDS_INDEX_DELETED;\n485\t\n486\t                    if mode == STBDS_HM_STRING && (*table).string.mode as c_int == STBDS_SH_STRDUP {\n487\t                        let p = (a as *mut u8)\n488\t                            .wrapping_add(elemsize.wrapping_mul(old_index as usize))\n489\t                            as *mut *mut c_char;\n490\t                        free(*p as *mut c_void);\n491\t                    }\n492\t\n493\t                    if old_index != final_index {\n494\t                        memmove(\n495\t                            (a as *mut u8).wrapping_add(elemsize.wrapping_mul(old_index as usize))\n496\t                                as *mut c_void,\n497\t                            (a as *mut u8).wrapping_add(elemsize.wrapping_mul(final_index as usize))\n498\t                                as *const c_void,\n499\t                            elemsize,\n500\t                        );\n501\t\n502\t                        if mode == STBDS_HM_STRING {\n503\t                            let kp = (a as *mut u8)\n504\t                                .wrapping_add(elemsize.wrapping_mul(old_index as usize))\n505\t                                .wrapping_add(keyoffset) as *mut *mut c_char;\n506\t                            slot = stbds_hm_find_slot(\n507\t                                a,\n508\t                                elemsize,\n509\t                                *kp as *mut c_void,\n510\t                                keysize,\n511\t                                keyoffset,\n512\t                                mode,\n513\t                            );\n514\t                        } else {\n515\t                            let kp = (a as *mut u8)\n516\t                                .wrapping_add(elemsize.wrapping_mul(old_index as usize))\n517\t                                .wrapping_add(keyoffset) as *mut c_void;\n518\t                            slot = stbds_hm_find_slot(a, elemsize, kp, keysize, keyoffset, mode);\n519\t                        }\n520\t                        stbds_assert!(slot >= 0);\n521\t                        b = (*table).storage.wrapping_offset(slot >> STBDS_BUCKET_SHIFT);\n522\t                        i = (slot as usize) & STBDS_BUCKET_MASK;\n523\t                        stbds_assert!((*b).index[i] == final_index);\n524\t                        (*b).index[i] = old_index;\n525\t                    }\n526\t                    (*stbds_header(raw_a)).length -= 1;\n527\t\n528\t                    if (*table).used_count < (*table).used_count_shrink_threshold\n529\t                        && (*table).slot_count > STBDS_BUCKET_LENGTH\n530\t                    {\n531\t                        (*stbds_header(raw_a)).hash_table =\n532\t                            stbds_make_hash_index((*table).slot_count >> 1, table) as *mut c_void;\n533\t                        free(table as *mut c_void);\n534\t                    } else if (*table).tombstone_count > (*table).tombstone_count_threshold {\n535\t                        (*stbds_header(raw_a)).hash_table =\n536\t                            stbds_make_hash_index((*table).slot_count, table) as *mut c_void;\n537\t                        free(table as *mut c_void);\n538\t                    }\n539\t\n540\t                    a\n541\t                }\n542\t            }\n543\t        }\n544\t    }\n545\t}\n546\t"}]},"parent_tool_use_id":null,"session_id":"c4c73cdf-d3d2-480b-b64c-7f6e1f7b5869","uuid":"efc8488a-02d9-4e55-b983-a71f1edda9a9","timestamp":"2026-08-20T10:29:43.967Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-M1TrVY/translated_rust/src/hashmap.rs","content":"//! Hash map implementation: `stbds_hmfree_func`, `stbds_hmget_key`,\n//! `stbds_hmget_key_ts`, `stbds_hmput_default`, `stbds_hmput_key`,\n//! `stbds_hmdel_key`, `stbds_shmode_func`.\n\nuse core::ffi::{c_char, c_int, c_void};\n\nuse crate::arena::{stbds_stralloc, stbds_strdup, stbds_strreset};\nuse crate::array::stbds_arrgrowf;\nuse crate::ffi::*;\nuse crate::hash::{stbds_hash_bytes, stbds_hash_string, stbds_make_hash_index, stbds_probe_position};\n\n/// ```c\n/// static int stbds_is_key_equal(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode, size_t i)\n/// ```\nunsafe fn stbds_is_key_equal(\n    a: *mut c_void,\n    elemsize: usize,\n    key: *mut c_void,\n    keysize: usize,\n    keyoffset: usize,\n    mode: c_int,\n    i: usize,\n) -> c_int {\n    if mode >= STBDS_HM_STRING {\n        let slot = (a as *mut u8)\n            .wrapping_add(elemsize.wrapping_mul(i))\n            .wrapping_add(keyoffset) as *mut *mut c_char;\n        (0 == strcmp(key as *const c_char, *slot)) as c_int\n    } else {\n        let slot = (a as *mut u8)\n            .wrapping_add(elemsize.wrapping_mul(i))\n            .wrapping_add(keyoffset) as *const c_void;\n        (0 == memcmp(key as *const c_void, slot, keysize)) as c_int\n    }\n}\n\n/// ```c\n/// void stbds_hmfree_func(void *a, size_t elemsize)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n    unsafe {\n        if a.is_null() {\n            return;\n        }\n        if !stbds_hash_table(a).is_null() {\n            if (*stbds_hash_table(a)).string.mode as c_int == STBDS_SH_STRDUP {\n                let mut i: usize = 1;\n                while i < (*stbds_header(a)).length {\n                    let p = (a as *mut u8).wrapping_add(elemsize.wrapping_mul(i)) as *mut *mut c_char;\n                    free(*p as *mut c_void);\n                    i += 1;\n                }\n            }\n            stbds_strreset(core::ptr::addr_of_mut!((*stbds_hash_table(a)).string));\n        }\n        free((*stbds_header(a)).hash_table);\n        free(stbds_header(a) as *mut c_void);\n    }\n}\n\n/// ```c\n/// static ptrdiff_t stbds_hm_find_slot(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode)\n/// ```\nunsafe fn stbds_hm_find_slot(\n    a: *mut c_void,\n    elemsize: usize,\n    key: *mut c_void,\n    keysize: usize,\n    keyoffset: usize,\n    mode: c_in