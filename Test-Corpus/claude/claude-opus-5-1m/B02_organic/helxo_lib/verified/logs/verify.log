 usize, usize, usize);\n   232\t    let mut data: usize;\n   233\t\n   234\t    v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n   235\t    v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n   236\t    v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n   237\t    v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n   238\t\n   239\t    v0 ^= 0x0706050403020100u64 as usize ^ seed;\n   240\t    v1 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n   241\t    v2 ^= 0x0706050403020100u64 as usize ^ seed;\n   242\t    v3 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n   243\t\n   244\t    // STBDS_SIPROUND()\n   245\t    macro_rules! sipround {\n   246\t        () => {{\n   247\t            v0 = v0.wrapping_add(v1);\n   248\t            v1 = rotl(v1, 13);\n   249\t            v1 ^= v0;\n   250\t            v0 = rotl(v0, STBDS_SIZE_T_BITS / 2);\n   251\t            v2 = v2.wrapping_add(v3);\n   252\t            v3 = rotl(v3, 16);\n   253\t            v3 ^= v2;\n   254\t            v2 = v2.wrapping_add(v1);\n   255\t            v1 = rotl(v1, 17);\n   256\t            v1 ^= v2;\n   257\t            v2 = rotl(v2, STBDS_SIZE_T_BITS / 2);\n   258\t            v0 = v0.wrapping_add(v3);\n   259\t            v3 = rotl(v3, 21);\n   260\t            v3 ^= v0;\n   261\t        }};\n   262\t    }\n   263\t\n   264\t    i = 0;\n   265\t    while i.wrapping_add(core::mem::size_of::<usize>()) <= len {\n   266\t        // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n   267\t        // The right-hand side is an `int` expression, so the store into the\n   268\t        // `size_t` sign-extends when d[3] has its high bit set.\n   269\t        let lo: i32 = (*d.add(0) as i32)\n   270\t            | ((*d.add(1) as i32) << 8)\n   271\t            | ((*d.add(2) as i32) << 16)\n   272\t            | ((*d.add(3) as i32) << 24);\n   273\t        data = lo as i64 as u64 as usize;\n   274\t        // data |= (size_t) (d[4] | (d[5] << 8) | (d[6] << 16) | (d[7] << 24)) << 16 << 16;\n   275\t        let hi: i32 = (*d.add(4) as i32)\n   276\t            | ((*d.add(5) as i32) << 8)\n   277\t            | ((*d.add(6) as i32) << 16)\n   278\t            | ((*d.add(7) as i32) << 24);\n   279\t        data |= ((hi as i64 as u64 as usize) << 16) << 16;\n   280\t\n   281\t        v3 ^= data;\n   282\t        for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n   283\t            sipround!();\n   284\t        }\n   285\t        v0 ^= data;\n   286\t\n   287\t        i = i.wrapping_add(core::mem::size_of::<usize>());\n   288\t        d = d.add(core::mem::size_of::<usize>());\n   289\t    }\n   290\t\n   291\t    data = len << (STBDS_SIZE_T_BITS - 8);\n   292\t    // switch (len - i) { case 7: ... fallthrough ... case 0: break; }\n   293\t    let rem = len.wrapping_sub(i);\n   294\t    if rem >= 7 {\n   295\t        data |= ((*d.add(6) as usize) << 24) << 24;\n   296\t    }\n   297\t    if rem >= 6 {\n   298\t        data |= ((*d.add(5) as usize) << 20) << 20;\n   299\t    }\n   300\t    if rem >= 5 {\n   301\t        data |= ((*d.add(4) as usize) << 16) << 16;\n   302\t    }\n   303\t    if rem >= 4 {\n   304\t        // `(d[3] << 24)` is an int: sign-extends into size_t.\n   305\t        data |= ((*d.add(3) as i32) << 24) as i64 as u64 as usize;\n   306\t    }\n   307\t    if rem >= 3 {\n   308\t        data |= ((*d.add(2) as i32) << 16) as i64 as u64 as usize;\n   309\t    }\n   310\t    if rem >= 2 {\n   311\t        data |= ((*d.add(1) as i32) << 8) as i64 as u64 as usize;\n   312\t    }\n   313\t    if rem >= 1 {\n   314\t        data |= *d.add(0) as usize;\n   315\t    }\n   316\t\n   317\t    v3 ^= data;\n   318\t    for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n   319\t        sipround!();\n   320\t    }\n   321\t    v0 ^= data;\n   322\t    v2 ^= 0xff;\n   323\t    for _ in 0..STBDS_SIPHASH_D_ROUNDS {\n   324\t        sipround!();\n   325\t    }\n   326\t\n   327\t    v0 ^ v1 ^ v2 ^ v3\n   328\t}\n