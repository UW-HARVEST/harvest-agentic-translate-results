{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GWYsxUM2kZr2sS39F7sZ7X","type":"tool_result","content":"########## src/lib.rs ##########\n     1\t//! Rust translation of the C library in `c_src/` (an inlined, lightly modified\n     2\t//! copy of Sean Barrett's `stb_ds.h` plus two demo helpers).\n     3\t//!\n     4\t//! Every function that the C shared library exports is re-implemented here with\n     5\t//! the identical C ABI, identical linker symbol name and identical observable\n     6\t//! behaviour (including quirks such as the sign-extension in the siphash byte\n     7\t//! loader and the missing `temp_key` update on one of the \"key already present\"\n     8\t//! paths of `stbds_hmput_key`).\n     9\t//!\n    10\t//! Exported symbols (must match `nm -D` of the C `.so`):\n    11\t//!   stbds_arrgrowf, stbds_arrfreef, stbds_rand_seed, stbds_hash_string,\n    12\t//!   stbds_hash_bytes, stbds_hmget_key_ts, stbds_hmget_key, stbds_hmput_default,\n    13\t//!   stbds_shmode_func, stbds_hmdel_key, stbds_stralloc, stbds_hmput_key,\n    14\t//!   stbds_strreset, stbds_hmfree_func, strkey, helxo\n    15\t\n    16\t#![allow(clippy::missing_safety_doc)]\n    17\t\n    18\tpub mod arena;\n    19\tpub mod array;\n    20\tpub mod demo;\n    21\tpub mod ffi;\n    22\tpub mod hash;\n    23\tpub mod hashmap;\n########## src/ffi.rs ##########\n     1\t//! C runtime declarations and the C data structures used by the library.\n     2\t//!\n     3\t//! Translated from `c_src/src/lib.c` (an inlined copy of `stb_ds.h`).\n     4\t//! Layouts must match the C structs byte for byte, so everything is `#[repr(C)]`.\n     5\t\n     6\tuse core::ffi::{c_char, c_int, c_void};\n     7\t\n     8\t// ---------------------------------------------------------------------------\n     9\t// libc: the C code uses realloc/free (via STBDS_REALLOC/STBDS_FREE) plus the\n    10\t// usual string/IO routines. Use the very same libc entry points so behaviour\n    11\t// (allocation, stdio buffering, formatting) is byte-identical.\n    12\t// ---------------------------------------------------------------------------\n    13\textern \"C\" {\n    14\t    pub fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n    15\t    pub fn free(p: *mut c_void);\n    16\t    pub fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n    17\t    pub fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n    18\t    pub fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n    19\t    pub fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n    20\t    pub fn strlen(s: *const c_char) -> usize;\n    21\t    pub fn printf(fmt: *const c_char, ...) -> c_int;\n    22\t    pub fn sprintf(s: *mut c_char, fmt: *const c_char, ...) -> c_int;\n    23\t}\n    24\t\n    25\t/// `STBDS_ASSERT` -- the C library builds with `assert`, which is compiled out\n    26\t/// in the shipped (NDEBUG) configuration. Kept as a no-op so no extra output or\n    27\t/// aborts are ever produced.\n    28\tmacro_rules! stbds_assert {\n    29\t    ($cond:expr) => {\n    30\t        let _ = &$cond;\n    31\t    };\n    32\t}\n    33\tpub(crate) use stbds_assert;\n    34\t\n    35\t// ---------------------------------------------------------------------------\n    36\t// Structures\n    37\t// ---------------------------------------------------------------------------\n    38\t\n    39\t/// ```c\n    40\t/// typedef struct {\n    41\t///   size_t      length;\n    42\t///   size_t      capacity;\n    43\t///   void      * hash_table;\n    44\t///   ptrdiff_t   temp;\n    45\t/// } stbds_array_header;\n    46\t/// ```\n    47\t#[repr(C)]\n    48\t#[derive(Clone, Copy)]\n    49\tpub struct StbdsArrayHeader {\n    50\t    pub length: usize,\n    51\t    pub capacity: usize,\n    52\t    pub hash_table: *mut c_void,\n    53\t    pub temp: isize,\n    54\t}\n    55\t\n    56\t/// ```c\n    57\t/// typedef struct stbds_string_block { struct stbds_string_block *next; char storage[8]; } stbds_string_block;\n    58\t/// ```\n    59\t#[repr(C)]\n    60\tpub struct StbdsStringBlock {\n    61\t    pub next: *mut StbdsStringBlock,\n    62\t    pub storage: [c_char; 8],\n    63\t}\n    64\t\n    65\t/// ```c\n    66\t/// struct stbds_string_arena {\n    67\t///   stbds_string_block *storage;\n    68\t///   size_t remaining;\n    69\t///   unsigned char block;\n    70\t///   unsigned char mode;\n    71\t/// };\n    72\t/// ```\n    73\t#[repr(C)]\n    74\t#[derive(Clone, Copy)]\n    75\tpub struct StbdsStringArena {\n    76\t    pub storage: *mut StbdsStringBlock,\n    77\t    pub remaining: usize,\n    78\t    pub block: u8,\n    79\t    pub mode: u8,\n    80\t}\n    81\t\n    82\tpub const STBDS_BUCKET_LENGTH: usize = 8;\n    83\tpub const STBDS_BUCKET_SHIFT: usize = 3;\n    84\tpub const STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n    85\tpub const STBDS_CACHE_LINE_SIZE: usize = 64;\n    86\t\n    87\t/// ```c\n    88\t/// typedef struct { size_t hash[8]; ptrdiff_t index[8]; } stbds_hash_bucket;\n    89\t/// ```\n    90\t#[repr(C)]\n    91\tpub struct StbdsHashBucket {\n    92\t    pub hash: [usize; STBDS_BUCKET_LENGTH],\n    93\t    pub index: [isize; STBDS_BUCKET_LENGTH],\n    94\t}\n    95\t\n    96\t/// ```c\n    97\t/// typedef struct {\n    98\t///   char * temp_key;\n    99\t///   size_t slot_count;\n   100\t///   size_t used_count;\n   101\t///   size_t used_count_threshold;\n   102\t///   size_t used_count_shrink_threshold;\n   103\t///   size_t tombstone_count;\n   104\t///   size_t tombstone_count_threshold;\n   105\t///   size_t seed;\n   106\t///   size_t slot_count_log2;\n   107\t///   stbds_string_arena string;\n   108\t///   stbds_hash_bucket *storage;\n   109\t/// } stbds_hash_index;\n   110\t/// ```\n   111\t#[repr(C)]\n   112\tpub struct StbdsHashIndex {\n   113\t    pub temp_key: *mut c_char,\n   114\t    pub slot_count: usize,\n   115\t    pub used_count: usize,\n  