\n   167\t\n   168\t/// `#define stbds_arrlen(a) ((a) ? (ptrdiff_t) stbds_header(a)->length : 0)`\n   169\t#[inline]\n   170\tpub unsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n   171\t    if a.is_null() {\n   172\t        0\n   173\t    } else {\n   174\t        (*stbds_header(a)).length as isize\n   175\t    }\n   176\t}\n   177\t\n   178\t/// `#define stbds_temp(t) stbds_header(t)->temp`\n   179\t#[inline]\n   180\tpub unsafe fn stbds_temp_set(t: *mut c_void, v: isize) {\n   181\t    (*stbds_header(t)).temp = v;\n   182\t}\n   183\t\n   184\t/// `#define stbds_temp_key(t) (*(char **) stbds_header(t)->hash_table)`\n   185\t#[inline]\n   186\tpub unsafe fn stbds_temp_key_set(t: *mut c_void, v: *mut c_char) {\n   187\t    let table = (*stbds_header(t)).hash_table as *mut *mut c_char;\n   188\t    *table = v;\n   189\t}\n   190\t\n   191\t/// `#define stbds_hash_table(a) ((stbds_hash_index *) stbds_header(a)->hash_table)`\n   192\t#[inline]\n   193\tpub unsafe fn stbds_hash_table(a: *mut c_void) -> *mut StbdsHashIndex {\n   194\t    (*stbds_header(a)).hash_table as *mut StbdsHashIndex\n   195\t}\n   196\t\n   197\t/// `#define STBDS_HASH_TO_ARR(x,elemsize) ((char *) (x) - (elemsize))`\n   198\t#[inline]\n   199\tpub fn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n   200\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n   201\t}\n   202\t\n   203\t/// `#define STBDS_ARR_TO_HASH(x,elemsize) ((char *) (x) + (elemsize))`\n   204\t#[inline]\n   205\tpub fn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n   206\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n   207\t}\n########## src/array.rs ##########\n     1\t//! Dynamic array support (`stbds_arrgrowf`, `stbds_arrfreef`).\n     2\t\n     3\tuse core::ffi::c_void;\n     4\t\n     5\tuse crate::ffi::*;\n     6\t\n     7\t/// ```c\n     8\t/// void *stbds_arrgrowf(void *a, size_t elemsize, size_t addlen, size_t min_cap)\n     9\t/// ```\n    10\t#[unsafe(no_mangle)]\n    11\tpub extern \"C\" fn stbds_arrgrowf(\n    12\t    a: *mut c_void,\n    13\t    elemsize: usize,\n    14\t    addlen: usize,\n    15\t    min_cap: usize,\n    16\t) -> *mut c_void {\n    17\t    unsafe {\n    18\t        let mut min_cap = min_cap;\n    19\t        let b: *mut c_void;\n    20\t        // size_t min_len = stbds_arrlen(a) + addlen;\n    21\t        let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n    22\t\n    23\t        if min_len > min_cap {\n    24\t            min_cap = min_len;\n    25\t        }\n    26\t\n    27\t        if min_cap <= stbds_arrcap(a) {\n    28\t            return a;\n    29\t        }\n    30\t\n    31\t        if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n    32\t            min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n    33\t        } else if min_cap < 4 {\n    34\t            min_cap = 4;\n    35\t        }\n    36\t\n    37\t        b = realloc(\n    38\t            if !a.is_null() {\n    39\t                stbds_header(a) as *mut c_void\n    40\t            } else {\n    41\t                core::ptr::null_mut()\n    42\t            },\n    43\t            elemsize\n    44\t                .wrapping_mul(min_cap)\n    45\t                .wrapping_add(core::mem::size_of::<StbdsArrayHeader>()),\n    46\t        );\n    47\t        let b = (b as *mut u8).wrapping_add(core::mem::size_of::<StbdsArrayHeader>()) as *mut c_void;\n    48\t        if a.is_null() {\n    49\t            (*stbds_header(b)).length = 0;\n    50\t            (*stbds_header(b)).hash_table = core::ptr::null_mut();\n    51\t            (*stbds_header(b)).temp = 0;\n    52\t        }\n    53\t        (*stbds_header(b)).capacity = min_cap;\n    54\t\n    55\t        b\n    56\t    }\n    57\t}\n    58\t\n    59\t/// ```c\n    60\t/// void stbds_arrfreef(void *a) { STBDS_FREE(NULL, stbds_header(a)); }\n    61\t/// ```\n    62\t#[unsafe(no_mangle)]\n    63\tpub extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n    64\t    unsafe {\n    65\t        free(stbds_header(a) as *mut c_void);\n    66\t    }\n    67\t}\n########## src/arena.rs ##########\n     1\t//! String storage: `stbds_strdup`, `stbds_stralloc`, `stbds_strreset`.\n     2\t\n     3\tuse core::ffi::c_char;\n     4\t\n     5\tuse crate::ffi::*;\n     6\t\n     7\t/// ```c\n     8\t/// static char *stbds_strdup(char *str)\n     9\t/// ```\n    10\tpub unsafe fn stbds_strdup(str_: *mut c_char) -> *mut c_char {\n    11\t    let len = strlen(str_) + 1;\n    12\t    let p = realloc(core::ptr::null_mut(), len) as *mut c_char;\n    13\t    memmove(p as *mut _, str_ as *const _, len);\n    14\t    p\n    15\t}\n    16\t\n    17\tconst STBDS_STRING_ARENA_BLOCKSIZE_MIN: usize = 512;\n    18\tconst STBDS_STRING_ARENA_BLOCKSIZE_MAX: usize = 1 << 20;\n    19\t\n    20\t/// ```c\n    21\t/// char *stbds_stralloc(stbds_string_arena *a, char *str)\n    22\t/// ```\n    23\t#[unsafe(no_mangle)]\n    24\tpub extern \"C\" fn stbds_stralloc(a: *mut StbdsStringArena, str_: *mut c_char) -> *mut c_char {\n    25\t    unsafe {\n    26\t        let p: *mut c_char;\n    27\t        let len = strlen(str_) + 1;\n    28\t        if len > (*a).remaining {\n    29\t            let mut blocksize: usize = (*a).block as usize;\n    30\t\n    31\t            blocksize = STBDS_STRING_ARENA_BLOCKSIZE_MIN << (blocksize >> 1);\n    32\t\n    33\t            if blocksize < STBDS_STRING_ARENA_BLOCKSIZE_MAX {\n    34\t                (*a).block = (*a).block.wrapping_add(1);\n    35\t            }\n    36\t\n    37\t            if len > blocksize {\n    38\t                let sb = realloc(\n    39\t                    core::ptr::null_mut(),\n    40\t                    core::mem::size_of::<StbdsStringBlock>() - 8 + len,\n    41\t                ) as *mut StbdsStringBlock;\n    42\t                memmove(\n    43\t                    core::ptr::addr_of_mut!((*sb).storage) as *mut _,\n    44\t                    str_ as *const _,\n    45\t                    len,\n    46\t                );\n    47\t                if !(*a).storage.is_null() {\n    48\t                    (*sb).next = (*(*a).storage).next;\n    49\t                    (*(*a).storage).next = sb;\n    50\t                } else {\n    51\t                    (*sb).next = core::ptr::null_mut();\n    52\t                    (*a).storage = sb;\n    53\t                    (*a).remaining = 0;\n    54\t                }\n    55\t                return core::ptr::addr_of_mut!((*sb).storage) as *mut c_char;\n    56\t            } else {\n    57\t                let sb = realloc(\n    58\t                    core::ptr::null_mut(),\n    59\t                    core::mem::size_of::<StbdsStringBlock>() - 8 + blocksize,\n    60\t                ) as *mut StbdsStringBlock;\n    61\t                (*sb).next = (*a).storage;\n    62\t                (*a).storage = sb;\n    63\t                (*a).remaining = blocksize;\n    64\t            }\n    65\t        }\n    66\t\n    67\t        stbds_assert!(len <= (*a).remaining);\n    68\t        p = (core::ptr::addr_of_mut!((*(*a).storage).storage) as *mut c_char)\n    69\t            .wrapping_add((*a).remaining)\n    70\t            .wrapping_sub(len);\n    71\t        (*a).remaining -= len;\n    72\t        memmove(p as *mut _, str_ as *const _, len);\n    73\t        p\n    74\t    }\n    75\t}\n    76\t\n    77\t/// ```c\n    78\t/// void stbds_strreset(stbds_string_arena *a)\n    79\t/// ```\n    80\t#[unsafe(no_mangle)]\n    81\tpub extern \"C\" fn stbds_strreset(a: *mut StbdsStringArena) {\n    82\t    unsafe {\n    83\t        let mut x: *mut StbdsStringBlock;\n    84\t        let mut y: *mut StbdsStringBlock;\n    85\t        x = (*a).storage;\n    86\t        while !x.is_null() {\n    87\t            y = (*x).next;\n    88\t            free(x as *mut _);\n    89\t            x = y;\n    90\t        }\n    91\t        core::ptr::write_bytes(a as *mut u8, 0, core::mem::size_of::<StbdsStringArena>());\n    9