{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_x4xyajbtub2v7utrkoly3ttrqzrobkqzylfdt2wrg3eyvc56gaia","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_016LcLcoG3sdKWxyVVo9dVct","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-translate-0pdCa6/tmp/driver.c","content":"/* Differential test driver: exercises the whole public ABI through the\n   original stb_ds macros. Linked once against the C .so and once against the\n   Rust .so; stdout must be byte-identical.\n\n   Style rule: at most ONE table-mutating macro per statement, so that the\n   result never depends on unspecified evaluation order. */\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"stbds_decls.h\"\n\nextern char *strkey(int n);\nextern void arr_ins(int num);\n\ntypedef struct { int key; int value; } imap;\ntypedef struct { long long key; int value; } lmap;\ntypedef struct { char *key; int value; } smap;\ntypedef struct { int key[2]; int b, c, d; } skey2;\n\nstatic void test_hash_funcs(void)\n{\n  unsigned char buf[80];\n  size_t len, s;\n  int i, k;\n  static const char *strs[] = { \"\", \"a\", \"ab\", \"hello\", \"test_1\",\n                                \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n                                \"\\xff\\xfe\\x80\\x01 hi\", \"the quick brown fox\" };\n  printf(\"== hash funcs ==\\n\");\n  for (i = 0; i < 80; ++i) buf[i] = (unsigned char) (i * 37 + 11);\n  for (len = 0; len <= 40; ++len) {\n    for (s = 0; s < 3; ++s) {\n      size_t seed = (s == 0) ? 0 : (s == 1 ? (size_t) 0x31415926u\n                                           : (size_t) 0xdeadbeefcafebabeULL);\n      printf(\"hb %2zu %20zu -> %016zx\\n\", len, seed,\n             stbds_hash_bytes(buf, len, seed));\n    }\n  }\n  memset(buf, 0xff, sizeof buf);\n  for (k = 0; k <= 24; ++k)\n    printf(\"hbff %2d -> %016zx\\n\", k, stbds_hash_bytes(buf, (size_t) k, 12345));\n  memset(buf, 0x80, sizeof buf);\n  for (k = 0; k <= 24; ++k)\n    printf(\"hb80 %2d -> %016zx\\n\", k, stbds_hash_bytes(buf, (size_t) k, 0));\n  for (i = 0; i < 8; ++i) {\n    printf(\"hs %d a -> %016zx\\n\", i, stbds_hash_string((char *) strs[i], 0));\n    printf(\"hs %d b -> %016zx\\n\", i, stbds_hash_string((char *) strs[i],\n           (size_t) 0x9e3779b97f4a7c15ULL));\n  }\n}\n\nstatic void test_arrays(void)\n{\n  int *a = NULL;\n  int i;\n  int *p;\n  ptrdiff_t n;\n  size_t c;\n  printf(\"== arrays ==\\n\");\n  printf(\"empty len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  for (i = 0; i < 100; ++i) {\n    arrput(a, i * i);\n    if (i % 17 == 0) {\n      n = arrlen(a); c = arrcap(a);\n      printf(\"push %d len=%td cap=%zu last=%d\\n\", i, n, c, arrlast(a));\n    }\n  }\n  for (i = 0; i < 100; ++i) printf(\"a[%d]=%d\\n\", i, a[i]);\n  for (i = 0; i < 10; ++i) {\n    int v = arrpop(a);\n    n = arrlen(a);\n    printf(\"pop -> %d (len=%td)\\n\", v, n);\n  }\n  arrins(a, 5, -1);\n  arrins(a, 0, -2);\n  arrinsn(a, 3, 4);\n  for (i = 3; i < 7; ++i) a[i] = 1000 + i;\n  arrdel(a, 2);\n  arrdeln(a, 10, 5);\n  arrdelswap(a, 1);\n  n = arrlen(a); c = arrcap(a);\n  printf(\"after edits len=%td cap=%zu\\n\", n, c);\n  for (i = 0; i < n; ++i) printf(\"b[%d]=%d\\n\", i, a[i]);\n  arrsetlen(a, 20);\n  n = arrlen(a); c = arrcap(a);\n  printf(\"setlen20 len=%td cap=%zu\\n\", n, c);\n  arrsetcap(a, 500);\n  n = arrlen(a); c = arrcap(a);\n  printf(\"setcap500 len=%td cap=%zu\\n\", n, c);\n  arrsetlen(a, 400);\n  n = arrlen(a); c = arrcap(a);\n  printf(\"setlen400 len=%td cap=%zu\\n\", n, c);\n  p = arraddnptr(a, 10);\n  for (i = 0; i < 10; ++i) p[i] = 7 * i;\n  n = arrlen(a); c = arrcap(a);\n  printf(\"addnptr len=%td cap=%zu\\n\", n, c);\n  {\n    ptrdiff_t idx = arraddnindex(a, 0);\n    printf(\"addnindex0 = %td\\n\", idx);\n  }\n  n = arrlen(a);\n  for (i = 400; i < n; ++i) printf(\"c[%d]=%d\\n\", i, a[i]);\n  arrfree(a);\n  n = arrlen(a); c = arrcap(a);\n  printf(\"freed len=%td cap=%zu\\n\", n, c);\n\n  /* growth pattern of stbds_arrgrowf through many capacities */\n  {\n    void *g = NULL;\n    for (i = 0; i < 30; ++i) {\n      g = stbds_arrgrowf(g, 4, 1, 0);\n      ((stbds_array_header *) g)[-1].length += 1;\n      printf(\"grow %d len=%zu cap=%zu\\n\", i,\n             ((stbds_array_header *) g)[-1].length,\n             ((stbds_array_header *) g)[-1].capacity);\n    }\n    stbds_arrfreef(g);\n  }\n  for (i = 0; i < 8; ++i) {\n    void *g = stbds_arrgrowf(NULL, 12, (size_t) i, (size_t) (i * 3));\n    printf(\"grow2 %d len=%zu cap=%zu\\n\", i,\n           ((stbds_array_header *) g)[-1].length,\n           ((stbds_array_header *) g)[-1].capacity);\n    stbds_arrfreef(g);\n  }\n  /* growf on an existing buffer where min_cap <= cap (early return) */\n  {\n    void *g = stbds_arrgrowf(NULL, 8, 0, 10);\n    void *g2 = stbds_arrgrowf(g, 8, 0, 4);\n    printf(\"early_return_same=%d cap=%zu\\n\", g == g2,\n           ((stbds_array_header *) g2)[-1].capacity);\n    stbds_arrfreef(g2);\n  }\n}\n\nstatic void test_imap(void)\n{\n  imap *m = NULL;\n  int i;\n  ptrdiff_t j, n, idx;\n  int v;\n  printf(\"== int map ==\\n\");\n  printf(\"len empty=%td\\n\", hmlen(m));\n  for (i = 0; i < 300; ++i) {\n    hmput(m, i * 7, i);\n    if (i % 29 == 0) { n = hmlen(m); printf(\"put %d len=%td\\n\", i, n); }\n  }\n  n = hmlen(m);\n  printf(\"len=%td lenu=%zu\\n\", n, hmlenu(m));\n  for (i = 0; i < 300; ++i) {\n    idx = hmgeti(m, i * 7);\n    v = hmget(m, i * 7);\n    printf(\"get %d idx=%td val=%d\\n\", i * 7, idx, v);\n  }\n  for (i = 0; i < 300; ++i) {\n    ptrdiff_t t;\n    v = hmget_ts(m, i * 7, t);\n    if (i % 31 == 0) printf(\"ts %d idx=%td v=%d\\n\", i * 7, t, v);\n  }\n  for (i = 0; i < 300; i += 3) {\n    int r = (int) hmdel(m, i * 7);\n    n = hmlen(m);\n    if (i % 33 == 0) printf(\"del %d -> %d len=%td\\n\", i * 7, r, n);\n  }\n  n = hmlen(m);\n  printf(\"after del len=%td\\n\", n);\n  for (j = 0; j < n; ++j)\n    printf(\"slot %td k=%d v=%d\\n\", j, m[j].key, m[j].value);\n  for (i = 0; i < 300; ++i) {\n    idx = hmgeti(m, i * 7);\n    printf(\"q %d -> %td\\n\", i * 7, idx);\n  }\n  for (i = 0; i < 300; i += 2) hmput(m, i * 7, -i);\n  n = hmlen(m);\n  printf(\"re-put len=%td\\n\", n);\n  for (j = 0; j < n; ++j)\n    printf(\"slot2 %td k=%d v=%d\\n\", j, m[j].key, m[j].value);\n  hmdefault(m, -12345);\n  v = hmget(m, 999999);\n  printf(\"miss=%d\\n\", v);\n  v = hmget(m, 7);\n  printf(\"hit=%d\\n\", v);\n  printf(\"getp_null miss=%d\\n\", hmgetp_null(m, 999999) == NULL);\n  printf(\"getp_null hit=%d\\n\", hmgetp_null(m, 7) == NULL);\n  /* delete everything -> exercises shrink path */\n  for (i = 0; i < 300; ++i) hmdel(m, i * 7);\n  n = hmlen(m);\n  printf(\"emptied len=%td\\n\", n);\n  /* re-add after full delete */\n  for (i = 0; i < 20; ++i) hmput(m, i, i * 100);\n  for (i = 0; i < 20; ++i) { idx = hmgeti(m, i); printf(\"re %d -> %td\\n\", i, idx); }\n  hmfree(m);\n  printf(\"freed len=%td\\n\", hmlen(m));\n}\n\nstatic void test_lmap(void)\n{\n  lmap *m = NULL;\n  int i;\n  ptrdiff_t idx;\n  int v;\n  printf(\"== long long map ==\\n\");\n  for (i = 0; i < 64; ++i) hmput(m, ((long long) i << 40) | 0xff, i);\n  for (i = 0; i < 64; ++i) {\n    idx = hmgeti(m, ((long long) i << 40) | 0xff);\n    v = hmget(m, ((long long) i << 40) | 0xff);\n    printf(\"ll %d idx=%td v=%d\\n\", i, idx, v);\n  }\n  hmfree(m);\n}\n\n/* array-typed keys: the stb_ds macros cannot take them, so call the raw\n   functions the same way the macros would. */\nstatic ptrdiff_t s2_geti(skey2 **mp, int k0, int k1)\n{\n  int key[2];\n  key[0] = k0; key[1] = k1;\n  *mp = (skey2 *) stbds_hmget_key(*mp, sizeof(skey2), key, sizeof(key),\n                                  STBDS_HM_BINARY);\n  return stbds_temp((*mp) - 1);\n}\n\nstatic ptrdiff_t s2_del(skey2 **mp, int k0, int k1)\n{\n  int key[2];\n  key[0] = k0; key[1] = k1;\n  *mp = (skey2 *) stbds_hmdel_key(*mp, sizeof(skey2), key, sizeof(key),\n                                  0, STBDS_HM_BINARY);\n  return (*mp) ? stbds_temp((*mp) - 1) : 0;\n}\n\nstatic void test_structkey(void)\n{\n  skey2 *m = NULL;\n  int i;\n  ptrdiff_t n, idx;\n  printf(\"== struct(2 int) key map ==\\n\");\n  for (i = 0; i < 50; ++i) {\n    skey2 s;\n    s.key[0] = i; s.key[1] = -i; s.b = i * 2; s.c = i * 3; s.d = i * 4;\n    hmputs(m, s);\n  }\n  n = hmlen(m);\n  printf(\"len=%td\\n\", n);\n  for (i = 0; i < 50; ++i) {\n    idx = s2_geti(&m, i, -i);\n    printf(\"s %d idx=%td b=%d c=%d d=%d\\n\", i, idx, m[idx].b, m[idx].c, m[idx].d);\n  }\n  for (i = 0; i < 50; i += 7) {\n    ptrdiff_t r = s2_del(&m, i, -i);\n    n = hmlen(m);\n    printf(\"del %d -> %td len=%td\\n\", i, r, n);\n  }\n  n = hmlen(m);\n  for (i = 0; i < n; ++i)\n    printf(\"row %d k=%d,%d b=%d\\n\", i, m[i].key[0], m[i].key[1], m[i].b);\n  for (i = 0; i < 50; ++i) { idx = s2_geti(&m, i, -i); printf(\"q %d -> %td\\n\", i, idx); }\n  hmfree(m);\n}\n\nstatic char keybuf[200][32];\n\nstatic void test_smap_default(void)\n{\n  smap *m = NULL;\n  int i;\n  ptrdiff_t j, n, idx;\n  int v;\n  printf(\"== string map (default) ==\\n\");\n  for (i = 0; i < 200; ++i) sprintf(keybuf[i], \"key_%d_%d\", i, i * i);\n  for (i = 0; i < 200; ++i) shput(m, keybuf[i], i * 3);\n  n = shlen(m);\n  printf(\"len=%td\\n\", n);\n  for (i = 0; i < 200; ++i) {\n    idx = shgeti(m, keybuf[i]);\n    v = shget(m, keybuf[i]);\n    printf(\"g %s -> %d idx=%td\\n\", keybuf[i], v, idx);\n  }\n  for (i = 0; i < 200; i += 5) {\n    int r = (int) shdel(m, keybuf[i]);\n    printf(\"del %s -> %d\\n\", keybuf[i], r);\n  }\n  n = shlen(m);\n  printf(\"after del len=%td\\n\", n);\n  for (j = 0; j < n; ++j)\n    printf(\"row %td %s=%d\\n\", j, m[j].key, m[j].value);\n  for (i = 0; i < 200; ++i) {\n    idx = shgeti(m, keybuf[i]);\n    printf(\"q %d -> %td\\n\", i, idx);\n  }\n  printf(\"null miss=%d\\n\", shgetp_null(m, \"nope\") == NULL);\n  printf(\"null hit=%d\\n\", shgetp_null(m, keybuf[1]) == NULL);\n  shdefault(m, -777);\n  v = shget(m, \"nope\");\n  printf(\"miss val=%d\\n\", v);\n  {\n    smap s;\n    s.key = keybuf[7];\n    s.value = 31337;\n    shputs(m, s);\n    v = shget(m, keybuf[7]);\n    printf(\"shputs -> %d\\n\", v);\n  }\n  shfree(m);\n}\n\nstatic void test_smap_strdup(void)\n{\n  smap *m = NULL;\n  int i;\n  ptrdiff_t j, n, idx;\n  int v;\n  char tmp[600];\n  printf(\"== string map (strdup) ==\\n\");\n  sh_new_strdup(m);\n  for (i = 0; i < 120; ++i) {\n    sprintf(tmp, \"dup_%d\", i);\n    shput(m, tmp, i);\n  }\n  for (i = 0; i < 120; ++i) {\n    sprintf(tmp, \"dup_%d\", i);\n    idx = shgeti(m, tmp);\n    v = shget(m, tmp);\n    printf(\"g %s -> %d idx=%td\\n\", tmp, v, idx);\n  }\n  for (i = 0; i < 120; i += 4) {\n    int r;\n    sprintf(tmp, \"dup_%d\", i);\n    r = (int) shdel(m, tmp);\n    printf(\"del %s -> %d\\n\", tmp, r);\n  }\n  n = shlen(m);\n  for (j = 0; j < n; ++j) printf(\"row %td %s=%d\\n\", j, m[j].key, m[j].value);\n  /* long key */\n  memset(tmp, 'x', 550); tmp[550] = 0;\n  shput(m, tmp, 4242);\n  v = shget(m, tmp);\n  idx = shgeti(m, tmp);\n  n = shlen(m);\n  printf(\"long -> %d idx=%td len=%td\\n\", v, idx, n);\n  for (i = 0; i < 60; ++i) shput(m, strkey(i), 100 + i);\n  for (i = 0; i < 60; ++i) {\n    char *k = strkey(i);\n    v = shget(m, k);\n    printf(\"sk %s -> %d\\n\", k, v);\n  }\n  /* overwrite existing keys */\n  for (i = 0; i < 60; i += 3) shput(m, strkey(i), -i);\n  n = shlen(m);\n  printf(\"overwrite len=%td\\n\", n);\n  for (j = 0; j < n; ++j) printf(\"row2 %td %.20s=%d\\n\", j, m[j].key, m[j].value);\n  shfree(m);\n  printf(\"freed len=%td\\n\", shlen(m));\n}\n\nstatic void test_smap_arena(void)\n{\n  smap *m = NULL;\n  int i;\n  ptrdiff_t j, n, idx;\n  int v;\n  char tmp[3200];\n  printf(\"== string map (arena) ==\\n\");\n  sh_new_arena(m);\n  for (i = 0; i < 150; ++i) {\n    sprintf(tmp, \"arena_key_%d\", i);\n    shput(m, tmp, i * i);\n  }\n  for (i = 0; i < 150; ++i) {\n    sprintf(tmp, \"arena_key_%d\", i);\n    idx = shgeti(m, tmp);\n    v = shget(m, tmp);\n    printf(\"g %s -> %d idx=%td\\n\", tmp, v, idx);\n  }\n  /* force big-block path and multiple block sizes */\n  for (i = 0; i < 6; ++i) {\n    size_t sz = (size_t) (400 + i * 500);\n    memset(tmp, 'a' + i, sz); tmp[sz] = 0;\n    shput(m, tmp, 1000 + i);\n    idx = shgeti(m, tmp);\n    v = shget(m, tmp);\n    n = shlen(m);\n    printf(\"big %d -> %d idx=%td len=%td\\n\", i, v, idx, n);\n  }\n  for (i = 0; i < 150; i += 9) {\n    int r;\n    sprintf(tmp, \"arena_key_%d\", i);\n    r = (int) shdel(m, tmp);\n    printf(\"del %s -> %d\\n\", tmp, r);\n  }\n  n = shlen(m);\n  for (j = 0; j < n; ++j)\n    printf(\"row %td %.20s=%d\\n\", j, m[j].key, m[j].value);\n  shfree(m);\n}\n\nstatic void test_stralloc_direct(void)\n{\n  stbds_string_arena a;\n  int i;\n  char tmp[4000];\n  printf(\"== stralloc direct ==\\n\");\n  memset(&a, 0, sizeof a);\n  for (i = 0; i < 40; ++i) {\n    size_t n = (size_t) (i * i + 1);\n    char *p;\n    memset(tmp, 'A' + (i % 26), n); tmp[n] = 0;\n    p = stbds_stralloc(&a, tmp);\n    printf(\"alloc %d len=%zu remaining=%zu block=%d ok=%d\\n\", i, n, a.remaining,\n           (int) a.block, strcmp(p, tmp) == 0);\n  }\n  stbds_strreset(&a);\n  printf(\"reset remaining=%zu block=%d storage_null=%d mode=%d\\n\", a.remaining,\n         (int) a.block, a.storage == NULL, (int) a.mode);\n  memset(tmp, 'z', 3000); tmp[3000] = 0;\n  printf(\"huge ok=%d\\n\", strcmp(stbds_stralloc(&a, tmp), tmp) == 0);\n  printf(\"huge remaining=%zu block=%d\\n\", a.remaining, (int) a.block);\n  {\n    char *p = stbds_stralloc(&a, \"small\");\n    printf(\"after huge small ok=%d remaining=%zu block=%d\\n\",\n           strcmp(p, \"small\") == 0, a.remaining, (int) a.block);\n  }\n  stbds_strreset(&a);\n}\n\nstatic void test_seed(void)\n{\n  imap *m = NULL;\n  int i;\n  ptrdiff_t idx;\n  printf(\"== rand_seed ==\\n\");\n  stbds_rand_seed(0);\n  for (i = 0; i < 40; ++i) hmput(m, i, i);\n  for (i = 0; i < 40; ++i) { idx = hmgeti(m, i); printf(\"s0 %d -> %td\\n\", i, idx); }\n  hmfree(m);\n  stbds_rand_seed((size_t) 0x123456789abcdefULL);\n  for (i = 0; i < 40; ++i) hmput(m, i, i);\n  for (i = 0; i < 40; ++i) { idx = hmgeti(m, i); printf(\"s1 %d -> %td\\n\", i, idx); }\n  hmfree(m);\n  stbds_rand_seed((size_t) 0x31415926u);\n}\n\nstatic void test_misc(void)\n{\n  int i;\n  printf(\"== misc ==\\n\");\n  for (i = -5; i < 5; ++i) printf(\"strkey(%d)=%s\\n\", i, strkey(i));\n  printf(\"strkey big=%s\\n\", strkey(2147483647));\n  printf(\"strkey min=%s\\n\", strkey(-2147483647 - 1));\n  printf(\"strkey 0=%s\\n\", strkey(0));\n  for (i = -3; i < 4; ++i) { arr_ins(i); printf(\"arr_ins(%d) done\\n\", i); }\n  {\n    void *p = stbds_hmput_default(NULL, sizeof(imap));\n    printf(\"hmput_default nonnull=%d len=%zu\\n\", p != NULL,\n           ((stbds_array_header *) ((char *) p - sizeof(imap)))[-1].length);\n    p = stbds_hmput_default(p, sizeof(imap));\n    printf(\"hmput_default2 len=%zu\\n\",\n           ((stbds_array_header *) ((char *) p - sizeof(imap)))[-1].length);\n    stbds_hmfree_func((char *) p - sizeof(imap), sizeof(imap));\n  }\n  {\n    ptrdiff_t temp = 12345;\n    int key = 3;\n    void *p = stbds_hmget_key_ts(NULL, sizeof(imap), &key, sizeof(int), &temp, 0);\n    printf(\"get_key_ts temp=%td nonnull=%d\\n\", temp, p != NULL);\n    p = stbds_hmget_key(p, sizeof(imap), &key, sizeof(int), 0);\n    printf(\"get_key temp=%td\\n\",\n           ((stbds_array_header *) ((char *) p - sizeof(imap)))[-1].temp);\n    stbds_hmfree_func((char *) p - sizeof(imap), sizeof(imap));\n  }\n  printf(\"hmdel_key(NULL)=%d\\n\", stbds_hmdel_key(NULL, 8, NULL, 4, 0, 0) == NULL);\n  {\n    void *p = stbds_shmode_func(sizeof(smap), 2);\n    printf(\"shmode nonnull=%d len=%zu\\n\", p != NULL,\n           ((stbds_array_header *) ((char *) p - sizeof(smap)))[-1].length);\n    stbds_hmfree_func((char *) p - sizeof(smap), sizeof(smap));\n  }\n  {\n    void *p = stbds_shmode_func(sizeof(smap), 3);\n    printf(\"shmode3 nonnull=%d\\n\", p != NULL);\n    stbds_hmfree_func((char *) p - sizeof(smap), sizeof(smap));\n  }\n  stbds_hmfree_func(NULL, 8);\n  printf(\"hmfree_func(NULL) ok\\n\");\n}\n\nint main(void)\n{\n  test_hash_funcs();\n  test_arrays();\n  test_imap();\n  test_lmap();\n  test_structkey();\n  test_smap_default();\n  test_smap_strdup();\n  test_smap_arena();\n  test_stralloc_direct();\n  test_seed();\n  test_misc();\n  printf(\"DONE\\n\");\n  return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3052,"cache_read_input_tokens":90572,"cache_creation":{"ephemeral_5m_input_tokens":3052,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e3c7fae5-0310-4349-8686-774b589003eb","uuid":"30f8b359-e5c1-4f9f-9a3e-13485c232cf0","timestamp":"2026-08-20T02:36:29.603Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016LcLcoG3sdKWxyVVo9dVct","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-translate-0pdCa6/tmp/driver.c has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"e3c7fae5-0310-4349-8686-774b589003eb","uuid":"9b426961-a944-435a-9a4b-20b710f49df2","timestamp":"2026-08-20T02:36:29.632Z","tool_use_result":{"type":"update","filePath":"/local/home/scheschb/.harvest/work/harvest-translate-0pdCa6/tmp/driver.c","content":"/* Differential test driver: exercises the whole public ABI through the\n   original stb_ds macros. Linked once against the C .so and once against the\n   Rust .so; stdout must be byte-identical.\n\n   Style rule: at most ONE table-mutating macro per statement, so that the\n   result never depends on unspecified evaluation order. */\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"stbds_decls.h\"\n\nextern char *strkey(int n);\nextern void arr_ins(int num);\n\ntypedef struct { int key; int value; } imap;\ntypedef struct { long long key; int value; } lmap;\ntypedef struct { char *key; int value; } smap;\ntypedef struct { int key[2]; int b, c, d; } skey2;\n\nstatic void test_hash_funcs(void)\n{\n  unsigned char buf[80];\n  size_t len, s;\n  int i, k;\n  static const char *strs[] = { \"\", \"a\", \"ab\", \"hello\", \"test_1\",\n                                \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n                                \"\\xff\\xfe\\x80\\x01 hi\", \"the quick brown fox\" };\n  printf(\"== hash funcs ==\\n\");\n  for (i = 0; i < 80; ++i) buf[i] = (unsigned char) (i * 37 + 11);\n  for (len = 0; len <= 40; ++len) {\n    for (s = 0; s < 3; ++s) {\n      size_t seed = (s == 0) ? 0 : (s == 1 ? (size_t) 0x31415926u\n                                           : (size_t) 0xdeadbeefcafebabeULL);\n      printf(\"hb %2zu %20zu -> %016zx\\n\", len, seed,\n             stbds_hash_bytes(buf, len, seed));\n    }\n  }\n  memset(buf, 0xff, sizeof buf);\n  for (k = 0; k <= 24; ++k)\n    printf(\"hbff %2d -> %016zx\\n\", k, stbds_hash_bytes(buf, (size_t) k, 12345));\n  memset(buf, 0x80, sizeof buf);\n  for (k = 0; k <= 24; ++k)\n    printf(\"hb80 %2d -> %016zx\\n\", k, stbds_hash_bytes(buf, (size_t) k, 0));\n  for (i = 0; i < 8; ++i) {\n    printf(\"hs %d a -> %016zx\\n\", i, stbds_hash_string((char *) strs[i], 0));\n    printf(\"hs %d b -> %016zx\\n\", i, stbds_hash_string((char *) strs[i],\n           (size_t) 0x9e3779b97f4a7c15ULL));\n  }\n}\n\nstatic void test_arrays(void)\n{\n  int *a = NULL;\n  int i;\n  int *p;\n  ptrdiff_t n;\n  size_t c;\n  printf(\"== arrays ==\\n\");\n  printf(\"empty len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  for (i = 0; i < 100; ++i) {\n    arrput(a, i * i);\n    if (i % 17 == 0) {\n      n = arrlen(a); c = arrcap(a);\n      printf(\"push %d len=%td cap=%zu last=%d\\n\", i, n, c, arrlast(a));\n    }\n  }\n  for (i = 0; i < 100; ++i) printf(\"a[%d]=%d\\n\", i, a[i]);\n  for (i = 0; i < 10; ++i) {\n    int v = arrpop(a);\n    n = arrlen(a);\n    printf(\"pop -> %d (len=%td)\\n\", v, n);\n  }\n  arrins(a, 5, -1);\n  arrins(a, 0, -2);\n  arrinsn(a, 3, 4);\n  for (i = 3; i < 7; ++i) a[i] = 1000 + i;\n  arrdel(a, 2);\n  arrdeln(a, 10, 5);\n  arrdelswap(a, 1);\n  n = arrlen(a); c = arrcap(a);\n  printf(\"after edits len=%td cap=%zu\\n\", n, c);\n  for (i = 0; i < n; ++i) printf(\"b[%d]=%d\\n\", i, a[i]);\n  arrsetlen(a, 20);\n  n = arrlen(a); c = arrcap(a);\n  printf(\"setlen20 len=%td cap=%zu\\n\", n, c);\n  arrsetcap(a, 500);\n  n = arrlen(a); c = arrcap(a);\n  printf(\"setcap500 len=%td cap=%zu\\n\", n, c);\n  arrsetlen(a, 400);\n  n = arrlen(a); c = arrcap(a);\n  printf(\"setlen400 len=%td cap=%zu\\n\", n, c);\n  p = arraddnptr(a, 10);\n  for (i = 0; i < 10; ++i) p[i] = 7 * i;\n  n = arrlen(a); c = arrcap(a);\n  printf(\"addnptr len=%td cap=%zu\\n\", n, c);\n  {\n    ptrdiff_t idx = arraddnindex(a, 0);\n    printf(\"addnindex0 = %td\\n\", idx);\n  }\n  n = arrlen(a);\n  for (i = 400; i < n; ++i) printf(\"c[%d]=%d\\n\", i, a[i]);\n  arrfree(a);\n  n = arrlen(a); c = arrcap(a);\n  printf(\"freed len=%td cap=%zu\\n\", n, c);\n\n  /* growth pattern of stbds_arrgrowf through many capacities */\n  {\n    void *g = NULL;\n    for (i = 0; i < 30; ++i) {\n      g = stbds_arrgrowf(g, 4, 1, 0);\n      ((stbds_array_header *) g)[-1].length += 1;\n      printf(\"grow %d len=%zu cap=%zu\\n\", i,\n             ((stbds_array_header *) g)[-1].length,\n             ((stbds_array_header *) g)[-1].capacity);\n    }\n    stbds_arrfreef(g);\n  }\n  for (i = 0; i < 8; ++i) {\n    void *g = stbds_arrgrowf(NULL, 12, (size_t) i, (size_t) (i * 3));\n    printf(\"grow2 %d len=%zu cap=%zu\\n\", i,\n           ((stbds_array_header *) g)[-1].length,\n           ((stbds_array_header *) g)[-1].capacity);\n    stbds_arrfreef(g);\n  }\n  /* growf on an existing buffer where min_cap <= cap (early return) */\n  {\n    void *g = stbds_arrgrowf(NULL, 8, 0, 10);\n    void *g2 = stbds_arrgrowf(g, 8, 0, 4);\n    printf(\"early_return_same=%d cap=%zu\\n\", g == g2,\n           ((stbds_array_header *) g2)[-1].capacity);\n    stbds_arrfreef(g2);\n  }\n}\n\nstatic void test_imap(void)\n{\n  imap *m = NULL;\n  int i;\n  ptrdiff_t j, n, idx;\n  int v;\n  printf(\"== int map ==\\n\");\n  printf(\"len empty=%td\\n\", hmlen(m));\n  for (i = 0; i < 300; ++i) {\n    hmput(m, i * 7, i);\n    if (i % 29 == 0) { n = hmlen(m); printf(\"put %d len=%td\\n\", i, n); }\n  }\n  n = hmlen(m);\n  printf(\"len=%td lenu=%zu\\n\", n, hmlenu(m));\n  for (i = 0; i < 300; ++i) {\n    idx = hmgeti(m, i * 7);\n    v = hmget(m, i * 7);\n    printf(\"get %d idx=%td val=%d\\n\", i * 7, idx, v);\n  }\n  for (i = 0; i < 300; ++i) {\n    ptrdiff_t t;\n    v = hmget_ts(m, i * 7, t);\n    if (i % 31 == 0) printf(\"ts %d idx=%td v=%d\\n\", i * 7, t, v);\n  }\n  for (i = 0; i < 300; i += 3) {\n    int r = (int) hmdel(m, i * 7);\n    n = hmlen(m);\n    if (i % 33 == 0) printf(\"del %d -> %d len=%td\\n\", i * 7, r, n);\n  }\n  n = hmlen(m);\n  printf(\"after del len=%td\\n\", n);\n  for (j = 0; j < n; ++j)\n    printf(\"slot %td k=%d v=%d\\n\", j, m[j].key, m[j].value);\n  for (i = 0; i < 300; ++i) {\n    idx = hmgeti(m, i * 7);\n    printf(\"q %d -> %td\\n\", i * 7, idx);\n  }\n  for (i = 0; i < 300; i += 2) hmput(m, i * 7, -i);\n  n = hmlen(m);\n  printf(\"re-put len=%td\\n\", n);\n  for (j = 0; j < n; ++j)\n    printf(\"slot2 %td k=%d v=%d\\n\", j, m[j].key, m[j].value);\n  hmdefault(m, -12345);\n  v = hmget(m, 999999);\n  printf(\"miss=%d\\n\", v);\n  v = hmget(m, 7);\n  printf(\"hit=%d\\n\", v);\n  printf(\"getp_null miss=%d\\n\", hmgetp_null(m, 999999) == NULL);\n  printf(\"getp_null hit=%d\\n\", hmgetp_null(m, 7) == NULL);\n  /* delete everything -> exercises shrink path */\n  for (i = 0; i < 300; ++i) hmdel(m, i * 7);\n  n = hmlen(m);\n  printf(\"emptied len=%td\\n\", n);\n  /* re-add after full delete */\n  for (i = 0; i < 20; ++i) hmput(m, i, i * 100);\n  for (i = 0; i < 20; ++i) { idx = hmgeti(m, i); printf(\"re %d -> %td\\n\", i, idx); }\n  hmfree(m);\n  printf(\"freed len=%td\\n\", hmlen(m));\n}\n\nstatic void test_lmap(void)\n{\n  lmap *m = NULL;\n  int i;\n  ptrdiff_t idx;\n  int v;\n  printf(\"== long long map ==\\n\");\n  for (i = 0; i < 64; ++i) hmput(m, ((long long) i << 40) | 0xff, i);\n  for (i = 0; i < 64; ++i) {\n    idx = hmgeti(m, ((long long) i << 40) | 0xff);\n    v = hmget(m, ((long long) i << 40) | 0xff);\n    printf(\"ll %d idx=%td v=%d\\n\", i, idx, v);\n  }\n  hmfree(m);\n}\n\n/* array-typed keys: the stb_ds macros cannot take them, so call the raw\n   functions the same way the macros would. */\nstatic ptrdiff_t s2_geti(skey2 **mp, int k0, int k1)\n{\n  int key[2];\n  key[0] = k0; key[1] = k1;\n  *mp = (skey2 *) stbds_hmget_key(*mp, sizeof(skey2), key, sizeof(key),\n                                  STBDS_HM_BINARY);\n  return stbds_temp((*mp) - 1);\n}\n\nstatic ptrdiff_t s2_del(skey2 **mp, int k0, int k1)\n{\n  int key[2];\n  key[0] = k0; key[1] = k1;\n  *mp = (skey2 *) stbds_hmdel_key(*mp, sizeof(skey2), key, sizeof(key),\n                                  0, STBDS_HM_BINARY);\n  return (*mp) ? stbds_temp((*mp) - 1) : 0;\n}\n\nstatic void test_structkey(void)\n{\n  skey2 *m = NULL;\n  int i;\n  ptrdiff_t n, idx;\n  printf(\"== struct(2 int) key map ==\\n\");\n  for (i = 0; i < 50; ++i) {\n    skey2 s;\n    s.key[0] = i; s.key[1] = -i; s.b = i * 2; s.c = i * 3; s.d = i * 4;\n    hmputs(m, s);\n  }\n  n = hmlen(m);\n  printf(\"len=%td\\n\", n);\n  for (i = 0; i < 50; ++i) {\n    idx = s2_geti(&m, i, -i);\n    printf(\"s %d idx=%td b=%d c=%d d=%d\\n\", i, idx, m[idx].b, m[idx].c, m[idx].d);\n  }\n  for (i = 0; i < 50; i += 7) {\n    ptrdiff_t r = s2_del(&m, i, -i);\n    n = hmlen(m);\n    printf(\"del %d -> %td len=%td\\n\", i, r, n);\n  }\n  n = hmlen(m);\n  for (i = 0; i < n; ++i)\n    printf(\"row %d k=%d,%d b=%d\\n\", i, m[i].key[0], m[i].key[1], m[i].b);\n  for (i = 0; i < 50; ++i) { idx = s2_geti(&m, i, -i); printf(\"q %d -> %td\\n\", i, idx); }\n  hmfree(m);\n}\n\nstatic char keybuf[200][32];\n\nstatic void test_smap_default(void)\n{\n  smap *m = NULL;\n  int i;\n  ptrdiff_t j, n, idx;\n  int v;\n  printf(\"== string map (default) ==\\n\");\n  for (i = 0; i < 200; ++i) sprintf(keybuf[i], \"key_%d_%d\", i, i * i);\n  for (i = 0; i < 200; ++i) shput(m, keybuf[i], i * 3);\n  n = shlen(m);\n  printf(\"len=%td\\n\", n);\n  for (i = 0; i < 200; ++i) {\n    idx = shgeti(m, keybuf[i]);\n    v = shget(m, keybuf[i]);\n    printf(\"g %s -> %d idx=%td\\n\", keybuf[i], v, idx);\n  }\n  for (i = 0; i < 200; i += 5) {\n    int r = (int) shdel(m, keybuf[i]);\n    printf(\"del %s -> %d\\n\", keybuf[i], r);\n  }\n  n = shlen(m);\n  printf(\"after del len=%td\\n\", n);\n  for (j = 0; j < n; ++j)\n    printf(\"row %td %s=%d\\n\", j, m[j].key, m[j].value);\n  for (i = 0; i < 200; ++i) {\n    idx = shgeti(m, keybuf[i]);\n    printf(\"q %d -> %td\\n\", i, idx);\n  }\n  printf(\"null miss=%d\\n\", shgetp_null(m, \"nope\") == NULL);\n  printf(\"null hit=%d\\n\", shgetp_null(m, keybuf[1]) == NULL);\n  shdefault(m, -777);\n  v = shget(m, \"nope\");\n  printf(\"miss val=%d\\n\", v);\n  {\n    smap s;\n    s.key = keybuf[7];\n    s.value = 31337;\n    shputs(m, s);\n    v = shget(m, keybuf[7]);\n    printf(\"shputs -> %d\\n\", v);\n  }\n  shfree(m);\n}\n\nstatic void test_smap_strdup(void)\n{\n  smap *m = NULL;\n  int i;\n  ptrdiff_t j, n, idx;\n  int v;\n  char tmp[600];\n  printf(\"== string map (strdup) ==\\n\");\n  sh_new_strdup(m);\n  for (i = 0; i < 120; ++i) {\n    sprintf(tmp, \"dup_%d\", i);\n    shput(m, tmp, i);\n  }\n  for (i = 0; i < 120; ++i) {\n    sprintf(tmp, \"dup_%d\", i);\n    idx = shgeti(m, tmp);\n    v = shget(m, tmp);\n    printf(\"g %s -> %d idx=%td\\n\", tmp, v, idx);\n  }\n  for (i = 0; i < 120; i += 4) {\n    int r;\n    sprintf(tmp, \"dup_%d\", i);\n    r = (int) shdel(m, tmp);\n    printf(\"del %s -> %d\\n\", tmp, r);\n  }\n  n = shlen(m);\n  for (j = 0; j < n; ++j) printf(\"row %td %s=%d\\n\", j, m[j].key, m[j].value);\n  /* long key */\n  memset(tmp, 'x', 550); tmp[550] = 0;\n  shput(m, tmp, 4242);\n  v = shget(m, tmp);\n  idx = shgeti(m, tmp);\n  n = shlen(m);\n  printf(\"long -> %d idx=%td len=%td\\n\", v, idx, n);\n  for (i = 0; i < 60; ++i) shput(m, strkey(i), 100 + i);\n  for (i = 0; i < 60; ++i) {\n    char *k = strkey(i);\n    v = shget(m, k);\n    printf(\"sk %s -> %d\\n\", k, v);\n  }\n  /* overwrite existing keys */\n  for (i = 0; i < 60; i += 3) shput(m, strkey(i), -i);\n  n = shlen(m);\n  printf(\"overwrite len=%td\\n\", n);\n  for (j = 0; j < n; ++j) printf(\"row2 %td %.20s=%d\\n\", j, m[j].key, m[j].value);\n  shfree(m);\n  printf(\"freed len=%td\\n\", shlen(m));\n}\n\nstatic void test_smap_arena(void)\n{\n  smap *m = NULL;\n  int i;\n  ptrdiff_t j, n, idx;\n  int v;\n  char tmp[3200];\n  printf(\"== string map (arena) ==\\n\");\n  sh_new_arena(m);\n  for (i = 0; i < 150; ++i) {\n    sprintf(tmp, \"arena_key_%d\", i);\n    shput(m, tmp, i * i);\n  }\n  for (i = 0; i < 150; ++i) {\n    sprintf(tmp, \"arena_key_%d\", i);\n    idx = shgeti(m, tmp);\n    v = shget(m, tmp);\n    printf(\"g %s -> %d idx=%td\\n\", tmp, v, idx);\n  }\n  /* force big-block path and multiple block sizes */\n  for (i = 0; i < 6; ++i) {\n    size_t sz = (size_t) (400 + i * 500);\n    memset(tmp, 'a' + i, sz); tmp[sz] = 0;\n    shput(m, tmp, 1000 + i);\n    idx = shgeti(m, tmp);\n    v = shget(m, tmp);\n    n = shlen(m);\n    printf(\"big %d -> %d idx=%td len=%td\\n\", i, v, idx, n);\n  }\n  for (i = 0; i < 150; i += 9) {\n    int r;\n    sprintf(tmp, \"arena_key_%d\", i);\n    r = (int) shdel(m, tmp);\n    printf(\"del %s -> %d\\n\", tmp, r);\n  }\n  n = shlen(m);\n  for (j = 0; j < n; ++j)\n    printf(\"row %td %.20s=%d\\n\", j, m[j].key, m[j].value);\n  shfree(m);\n}\n\nstatic void test_stralloc_direct(void)\n{\n  stbds_string_arena a;\n  int i;\n  char tmp[4000];\n  printf(\"== stralloc direct ==\\n\");\n  memset(&a, 0, sizeof a);\n  for (i = 0; i < 40; ++i) {\n    size_t n = (size_t) (i * i + 1);\n    char *p;\n    memset(tmp, 'A' + (i % 26), n); tmp[n] = 0;\n    p = stbds_stralloc(&a, tmp);\n    printf(\"alloc %d len=%zu remaining=%zu block=%d ok=%d\\n\", i, n, a.remaining,\n           (int) a.block, strcmp(p, tmp) == 0);\n  }\n  stbds_strreset(&a);\n  printf(\"reset remaining=%zu block=%d storage_null=%d mode=%d\\n\", a.remaining,\n         (int) a.block, a.storage == NULL, (int) a.mode);\n  memset(tmp, 'z', 3000); tmp[3000] = 0;\n  printf(\"huge ok=%d\\n\", strcmp(stbds_stralloc(&a, tmp), tmp) == 0);\n  printf(\"huge remaining=%zu block=%d\\n\", a.remaining, (int) a.block);\n  {\n    char *p = stbds_stralloc(&a, \"small\");\n    printf(\"after huge small ok=%d remaining=%zu block=%d\\n\",\n           strcmp(p, \"small\") == 0, a.remaining, (int) a.block);\n  }\n  stbds_strreset(&a);\n}\n\nstatic void test_seed(void)\n{\n  imap *m = NULL;\n  int i;\n  ptrdiff_t idx;\n  printf(\"== rand_seed ==\\n\");\n  stbds_rand_seed(0);\n  for (i = 0; i < 40; ++i) hmput(m, i, i);\n  for (i = 0; i < 40; ++i) { idx = hmgeti(m, i); printf(\"s0 %d -> %td\\n\", i, idx); }\n  hmfree(m);\n  stbds_rand_seed((size_t) 0x123456789abcdefULL);\n  for (i = 0; i < 40; ++i) hmput(m, i, i);\n  for (i = 0; i < 40; ++i) { idx = hmgeti(m, i); printf(\"s1 %d -> %td\\n\", i, idx); }\n  hmfree(m);\n  stbds_rand_seed((size_t) 0x31415926u);\n}\n\nstatic void test_misc(void)\n{\n  int i;\n  printf(\"== misc ==\\n\");\n  for (i = -5; i < 5; ++i) printf(\"strkey(%d)=%s\\n\", i, strkey(i));\n  printf(\"strkey big=%s\\n\", strkey(2147483647));\n  printf(\"strkey min=%s\\n\", strkey(-2147483647 - 1));\n  printf(\"strkey 0=%s\\n\", strkey(0));\n  for (i = -3; i < 4; ++i) { arr_ins(i); printf(\"arr_ins(%d) done\\n\", i); }\n  {\n    void *p = stbds_hmput_default(NULL, sizeof(imap));\n    printf(\"hmput_default nonnull=%d len=%zu\\n\", p != NULL,\n           ((stbds_array_header *) ((char *) p - sizeof(imap)))[-1].length);\n    p = stbds_hmput_default(p, sizeof(imap));\n    printf(\"hmput_default2 len=%zu\\n\",\n           ((stbds_array_header *) ((char *) p - sizeof(imap)))[-1].length);\n    stbds_hmfree_func((char *) p - sizeof(imap), sizeof(imap));\n  }\n  {\n    ptrdiff_t temp = 12345;\n    int key = 3;\n    void *p = stbds_hmget_key_ts(NULL, sizeof(imap), &key, sizeof(int), &temp, 0);\n    printf(\"get_key_ts temp=%td nonnull=%d\\n\", temp, p != NULL);\n    p = stbds_hmget_key(p, sizeof(imap), &key, sizeof(int), 0);\n    printf(\"get_key temp=%td\\n\",\n           ((stbds_array_header *) ((char *) p - sizeof(imap)))[-1].temp);\n    stbds_hmfree_func((char *) p - sizeof(imap), sizeof(imap));\n  }\n  printf(\"hmdel_key(NULL)=%d\\n\", stbds_hmdel_key(NULL, 8, NULL, 4, 0, 0) == NULL);\n  {\n    void *p = stbds_shmode_func(sizeof(smap), 2);\n    printf(\"shmode nonnull=%d len=%zu\\n\", p != NULL,\n           ((stbds_array_header *) ((char *) p