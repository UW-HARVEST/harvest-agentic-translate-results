\"hbff %2d -> %016zx\\n\", k, stbds_hash_bytes(buf, (size_t) k, 12345));\n  memset(buf, 0x80, sizeof buf);\n  for (k = 0; k <= 24; ++k)\n    printf(\"hb80 %2d -> %016zx\\n\", k, stbds_hash_bytes(buf, (size_t) k, 0));\n  for (i = 0; i < 8; ++i) {\n    printf(\"hs %d a -> %016zx\\n\", i, stbds_hash_string((char *) strs[i], 0));\n    printf(\"hs %d b -> %016zx\\n\", i, stbds_hash_string((char *) strs[i],\n           (size_t) 0x9e3779b97f4a7c15ULL));\n  }\n}\n\nstatic void test_arrays(void)\n{\n  int *a = NULL;\n  int i;\n  int *p;\n  printf(\"== arrays ==\\n\");\n  printf(\"empty len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  for (i = 0; i < 100; ++i) {\n    arrput(a, i * i);\n    if (i % 17 == 0)\n      printf(\"push %d len=%td cap=%zu last=%d\\n\", i, arrlen(a), arrcap(a), arrlast(a));\n  }\n  for (i = 0; i < 100; ++i) printf(\"a[%d]=%d\\n\", i, a[i]);\n  for (i = 0; i < 10; ++i) printf(\"pop -> %d (len=%td)\\n\", arrpop(a), arrlen(a));\n  arrins(a, 5, -1);\n  arrins(a, 0, -2);\n  arrinsn(a, 3, 4);\n  for (i = 3; i < 7; ++i) a[i] = 1000 + i;\n  arrdel(a, 2);\n  arrdeln(a, 10, 5);\n  arrdelswap(a, 1);\n  printf(\"after edits len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  for (i = 0; i < arrlen(a); ++i) printf(\"b[%d]=%d\\n\", i, a[i]);\n  arrsetlen(a, 20);\n  printf(\"setlen20 len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetcap(a, 500);\n  printf(\"setcap500 len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetlen(a, 400);\n  printf(\"setlen400 len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  p = arraddnptr(a, 10);\n  for (i = 0; i < 10; ++i) p[i] = 7 * i;\n  printf(\"addnptr len=%td cap=%zu idx=%td\\n\", arrlen(a), arrcap(a),\n         arraddnindex(a, 0));\n  for (i = 400; i < arrlen(a); ++i) printf(\"c[%d]=%d\\n\", i, a[i]);\n  arrfree(a);\n  printf(\"freed len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n\n  /* growth pattern of stbds_arrgrowf through many capacities */\n  {\n    void *g = NULL;\n    for (i = 0; i < 30; ++i) {\n      g = stbds_arrgrowf(g, 4, 1, 0);\n      ((stbds_array_header *) g)[-1].length += 1;\n      printf(\"grow %d len=%zu cap=%zu\\n\", i,\n             ((stbds_array_header *) g)[-1].length,\n             ((stbds_array_header *) g)[-1].capacity);\n    }\n    stbds_arrfreef(g);\n  }\n  for (i = 0; i < 8; ++i) {\n    void *g = stbds_arrgrowf(NULL, 12, (size_t) i, (size_t) (i * 3));\n    printf(\"grow2 %d len=%zu cap=%zu\\n\", i,\n           ((stbds_array_header *) g)[-1].length,\n           ((stbds_array_header *) g)[-1].capacity);\n    stbds_arrfreef(g);\n  }\n}\n\nstatic void test_imap(void)\n{\n  imap *m = NULL;\n  int i;\n  ptrdiff_t j;\n  printf(\"== int map ==\\n\");\n  printf(\"len empty=%td\\n\", hmlen(m));\n  for (i = 0; i < 300; ++i) {\n    hmput(m, i * 7, i);\n    if (i % 29 == 0) printf(\"put %d len=%td\\n\", i, hmlen(m));\n  }\n  printf(\"len=%td lenu=%zu\\n\", hmlen(m), hmlenu(m));\n  for (i = 0; i < 300; ++i)\n    printf(\"get %d idx=%td val=%d\\n\", i * 7, hmgeti(m, i * 7), hmget(m, i * 7));\n  for (i = 0; i < 300; ++i) {\n    ptrdiff_t t;\n    int v = hmget_ts(m, i * 7, t);\n    if (i % 31 == 0) printf(\"ts %d idx=%td v=%d\\n\", i * 7, t, v);\n  }\n  for (i = 0; i < 300; i += 3) {\n    int r = (int) hmdel(m, i * 7);\n    if (i % 33 == 0) printf(\"del %d -> %d len=%td\\n\", i * 7, r, hmlen(m));\n  }\n  printf(\"after del len=%td\\n\", hmlen(m));\n  for (j = 0; j < hmlen(m); ++j)\n    printf(\"slot %td k=%d v=%d\\n\", j, m[j].key, m[j].value);\n  for (i = 0; i < 300; ++i) printf(\"q %d -> %td\\n\", i * 7, hmgeti(m, i * 7));\n  for (i = 0; i < 300; i += 2) hmput(m, i * 7, -i);\n  printf(\"re-put len=%td\\n\", hmlen(m));\n  for (j = 0; j < hmlen(m); ++j)\n    printf(\"slot2 %td k=%d v=%d\\n\", j, m[j].key, m[j].value);\n  hmdefault(m, -12345);\n  printf(\"miss=%d hit=%d\\n\", hmget(m, 999999), hmget(m, 7));\n  printf(\"getp_null miss=%d hit=%d\\n\", hmgetp_null(m, 999999) == NULL,\n         hmgetp_null(m, 7) == NULL);\n  /* delete everything -> exercises shrink path */\n  for (i = 0; i < 300; ++i) hmdel(m, i * 7);\n  printf(\"emptied len=%td\\n\", hmlen(m));\n  hmfree(m);\n  printf(\"freed len=%td\\n\", hmlen(m));\n}\n\nstatic void test_lmap(void)\n{\n  lmap *m = NULL;\n  int i;\n  printf(\"== long long map ==\\n\");\n  for (i = 0; i < 64; ++i) hmput(m, ((long long) i << 40) | 0xff, i);\n  for (i = 0; i < 64; ++i)\n    printf(\"ll %d idx=%td v=%d\\n\", i, hmgeti(m, ((long long) i << 40) | 0xff),\n           hmget(m, ((long long) i << 40) | 0xff));\n  hmfree(m);\n}\n\nstatic void test_structkey(void)\n{\n  skey2 *m = NULL;\n  int i;\n  printf(\"== struct(2 int) key map ==\\n\");\n  for (i = 0; i < 50; ++i) {\n    skey2 s;\n    s.key[0] = i; s.key[1] = -i; s.b = i * 2; s.c = i * 3; s.d = i * 4;\n    hmputs(m, s);\n  }\n  printf(\"len=%td\\n\", hmlen(m));\n  for (i = 0; i < 50; ++i) {\n    skey2 q; q.key[0] = i; q.key[1] = -i;\n    printf(\"s %d idx=%td b=%d c=%d d=%d\\n\", i, hmgeti(m, q.key),\n           hmgets(m, q.key).b, hmgets(m, q.key).c, hmgets(m, q.key).d);\n  }\n  for (i = 0; i < 50; i += 7) {\n    skey2 q; q.key[0] = i; q.key[1] = -i;\n    printf(\"del %d -> %d len=%td\\n\", i, (int) hmdel(m, q.key), hmlen(m));\n  }\n  for (i = 0; i < hmlen(m); ++i)\n    printf(\"row %d k=%d,%d b=%d\\n\", i, m[i].key[0], m[i].key[1], m[i].b);\n  hmfree(m);\n}\n\nstatic char keybuf[200][32];\n\nstatic void test_smap_default(void)\n{\n  smap *m = NULL;\n  int i;\n  ptrdiff_t j;\n  printf(\"== string map (default) ==\\n\");\n  for (i = 0; i < 200; ++i) sprintf(keybuf[i], \"key_%d_%d\", i, i * i);\n  for (i = 0; i < 200; ++i) shput(m, keybuf[i], i * 3);\n  printf(\"len=%td\\n\", shlen(m));\n  for (i = 0; i < 200; ++i)\n    printf(\"g %s -> %d idx=%td\\n\", keybuf[i], shget(m, keybuf[i]),\n           shgeti(m, keybuf[i]));\n  for (i = 0; i < 200; i += 5)\n    printf(\"del %s -> %d\\n\", keybuf[i], (int) shdel(m, keybuf[i]));\n  printf(\"after del len=%td\\n\", shlen(m));\n  for (j = 0; j < shlen(m); ++j)\n    printf(\"row %td %s=%d\\n\", j, m[j].key, m[j].value