es":8,"newStart":356,"newLines":9,"lines":[" {","   smap *m = NULL;","   int i;","-  ptrdiff_t j;","-  char tmp[3000];","+  ptrdiff_t j, n, idx;","+  int v;","+  char tmp[3200];","   printf(\"== string map (arena) ==\\n\");","   sh_new_arena(m);","   for (i = 0; i < 150; ++i) {"]},{"oldStart":254,"oldLines":20,"newStart":367,"newLines":28,"lines":["   }","   for (i = 0; i < 150; ++i) {","     sprintf(tmp, \"arena_key_%d\", i);","-    printf(\"g %s -> %d idx=%td\\n\", tmp, shget(m, tmp), shgeti(m, tmp));","+    idx = shgeti(m, tmp);","+    v = shget(m, tmp);","+    printf(\"g %s -> %d idx=%td\\n\", tmp, v, idx);","   }","   /* force big-block path and multiple block sizes */","   for (i = 0; i < 6; ++i) {","-    size_t n = (size_t) (400 + i * 500);","-    memset(tmp, 'a' + i, n); tmp[n] = 0;","+    size_t sz = (size_t) (400 + i * 500);","+    memset(tmp, 'a' + i, sz); tmp[sz] = 0;","     shput(m, tmp, 1000 + i);","-    printf(\"big %d -> %d idx=%td len=%td\\n\", i, shget(m, tmp), shgeti(m, tmp), shlen(m));","+    idx = shgeti(m, tmp);","+    v = shget(m, tmp);","+    n = shlen(m);","+    printf(\"big %d -> %d idx=%td len=%td\\n\", i, v, idx, n);","   }","   for (i = 0; i < 150; i += 9) {","+    int r;","     sprintf(tmp, \"arena_key_%d\", i);","-    printf(\"del %s -> %d\\n\", tmp, (int) shdel(m, tmp));","+    r = (int) shdel(m, tmp);","+    printf(\"del %s -> %d\\n\", tmp, r);","   }","-  for (j = 0; j < shlen(m); ++j)","+  n = shlen(m);","+  for (j = 0; j < n; ++j)","     printf(\"row %td %.20s=%d\\n\", j, m[j].key, m[j].value);","   shfree(m);"," }"]},{"oldStart":290,"oldLines":10,"newStart":411,"newLines":14,"lines":["   stbds_strreset(&a);","   printf(\"reset remaining=%zu block=%d storage_null=%d mode=%d\\n\", a.remaining,","          (int) a.block, a.storage == NULL, (int) a.mode);","-  /* huge single string */","   memset(tmp, 'z', 3000); tmp[3000] = 0;","   printf(\"huge ok=%d\\n\", strcmp(stbds_stralloc(&a, tmp), tmp) == 0);","   printf(\"huge remaining=%zu block=%d\\n\", a.remaining, (int) a.block);","+  {","+    char *p = stbds_stralloc(&a, \"small\");","+    printf(\"after huge small ok=%d remaining=%zu block=%d\\n\",","+           strcmp(p, \"small\") == 0, a.remaining, (int) a.block);","+  }","   stbds_strreset(&a);"," }"," "]},{"oldStart":301,"oldLines":16,"newStart":426,"newLines":17,"lines":[" {","   imap *m = NULL;","   int i;","+  ptrdiff_t idx;","   printf(\"== rand_seed ==\\n\");","   stbds_rand_seed(0);","   for (i = 0; i < 40; ++i) hmput(m, i, i);","-  for (i = 0; i < 40; ++i) printf(\"s0 %d -> %td\\n\", i, hmgeti(m, i));","+  for (i = 0; i < 40; ++i) { idx = hmgeti(m, i); printf(\"s0 %d -> %td\\n\", i, idx); }","   hmfree(m);","-  stbds_rand_seed(0x123456789abcdefULL);","+  stbds_rand_seed((size_t) 0x123456789abcdefULL);","   for (i = 0; i < 40; ++i) hmput(m, i, i);","-  for (i = 0; i < 40; ++i) printf(\"s1 %d -> %td\\n\", i, hmgeti(m, i));","+  for (i = 0; i < 40; ++i) { idx = hmgeti(m, i); printf(\"s1 %d -> %td\\n\", i, idx); }","   hmfree(m);","-  stbds_rand_seed(0x31415926);","+  stbds_rand_seed((size_t) 0x31415926u);"," }"," "," static void test_misc(void)"]},{"oldStart":320,"oldLines":14,"newStart":446,"newLines":14,"lines":["   for (i = -5; i < 5; ++i) printf(\"strkey(%d)=%s\\n\", i, strkey(i));","   printf(\"strkey big=%s\\n\", strkey(2147483647));","   printf(\"strkey min=%s\\n\", strkey(-2147483647 - 1));","+  printf(\"strkey 0=%s\\n\", strkey(0));","   for (i = -3; i < 4; ++i) { arr_ins(i); printf(\"arr_ins(%d) done\\n\", i); }","-  /* raw calls */","   {","     void *p = stbds_hmput_default(NULL, sizeof(imap));","-    printf(\"hmput_default nonnull=%d len=%td\\n\", p != NULL,","+    printf(\"hmput_default nonnull=%d len=%zu\\n\", p != NULL,","            ((stbds_array_header *) ((char *) p - sizeof(imap)))[-1].length);","     p = stbds_hmput_default(p, sizeof(imap));","-    printf(\"hmput_default2 len=%td\\n\",","+    printf(\"hmput_default2 len=%zu\\n\",","            ((stbds_array_header *) ((char *) p - sizeof(imap)))[-1].length);","     stbds_hmfree_func((char *) p - sizeof(imap), sizeof(imap));","   }"]},{"oldStart":344,"oldLines":10,"newStart":470,"newLines":17,"lines":["   printf(\"hmdel_key(NULL)=%d\\n\", stbds_hmdel_key(NULL, 8, NULL, 4, 0, 0) == NULL);","   {","     void *p = stbds_shmode_func(sizeof(smap), 2);","-    printf(\"shmode nonnull=%d len=%td\\n\", p != NULL,","+    printf(\"shmode nonnull=%d len=%zu\\n\", p != NULL,","            ((stbds_array_header *) ((char *) p - sizeof(smap)))[-1].length);","     stbds_hmfree_func((char *) p - sizeof(smap), sizeof(smap));","   }","+  {","+    void *p = stbds_shmode_func(sizeof(smap), 3);","+    printf(\"shmode3 nonnull=%d\\n\", p != NULL);","+    stbds_hmfree_func((char *) p - sizeof(smap), sizeof(smap));","+  }","+  stbds_hmfree_func(NULL, 8);","+  printf(\"hmfree_func(NULL) ok\\n\");"," }"," "," int main(void)"]}],"originalFile":"/* Differential test driver: exercises the whole public ABI through the\n   original stb_ds macros. Linked once against the C .so and once against the\n   Rust .so; stdout must be byte-identical. */\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"stbds_decls.h\"\n\nextern char *strkey(int n);\nextern void arr_ins(int num);\n\ntypedef struct { int key; int value; } imap;\ntypedef struct { long long key; int value; } lmap;\ntypedef struct { char *key; int value; } smap;\ntypedef struct { int key[2]; int b, c, d; } skey2;\n\nstatic void test_hash_funcs(void)\n{\n  unsigned char buf[80];\n  size_t len, s;\n  int i, k;\n  static const char *strs[] = { \"\", \"a\", \"ab\", \"hello\", \"test_1\",\n                                \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n                                \"\\xff\\xfe\\x80\\x01 hi\", \"the quick brown fox\" };\n  printf(\"== hash funcs ==\\n\");\n  for (i = 0; i < 80; ++i) buf[i] = (unsigned char) (i * 37 + 11);\n  for (len = 0; len <= 40; ++len) {\n    for (s = 0; s < 3; ++s) {\n      size_t seed = (s == 0) ? 0 : (s == 1 ? (size_t) 0x31415926u\n                                           : (size_t) 0xdeadbeefcafebabeULL);\n      printf(\"hb %2zu %20zu -> %016zx\\n\", len, seed,\n             stbds_hash_bytes(buf, len, seed));\n    }\n  }\n  memset(buf, 0xff, sizeof buf);\n  for (k = 0; k <= 24; ++k)\n    printf(\"hbff %2d -> %016zx\\n\", k, stbds_hash_bytes(buf, (size_t) k, 12345));\n  memset(buf, 0x80, sizeof buf);\n  for (k = 0; k <= 24; ++k)\n    printf(\"hb80 %2d -> %016zx\\n\", k, stbds_hash_bytes(buf, (size_t) k, 0));\n  for (i = 0; i < 8; ++i) {\n    printf(\"hs %d a -> %016zx\\n\", i, stbds_hash_string((char *) strs[i], 0));\n    printf(\"hs %d b -> %016zx\\n\", i, stbds_hash_string((char *) strs[i],\n           (size_t) 0x9e3779b97f4a7c15ULL));\n  }\n}\n\nstatic void test_arrays(void)\n{\n  int *a = NULL;\n  int i;\n  int *p;\n  printf(\"== arrays ==\\n\");\n  printf(\"empty len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  for (i = 0; i < 100; ++i) {\n    arrput(a, i * i);\n    if (i % 17 == 0)\n      printf(\"push %d len=%td cap=%zu last=%d\\n\", i, arrlen(a), arrcap(a), arrlast(a));\n  }\n  for (i = 0; i < 100; ++i) printf(\"a[%d]=%d\\n\", i, a[i]);\n  for (i = 0; i < 10; ++i) printf(\"pop -> %d (len=%td)\\n\", arrpop(a), arrlen(a));\n  arrins(a, 5, -1);\n  arrins(a, 0, -2);\n  arrinsn(a, 3, 4);\n  for (i = 3; i < 7; ++i) a[i] = 1000 + i;\n  arrdel(a, 2);\n  arrdeln(a, 10, 5);\n  arrdelswap(a, 1);\n  printf(\"after edits len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  for (i = 0; i < arrlen(a); ++i) printf(\"b[%d]=%d\\n\", i, a[i]);\n  arrsetlen(a, 20);\n  printf(\"setlen20 len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetcap(a, 500);\n  printf(\"setcap500 len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetlen(a, 400);\n  printf(\"setlen400 len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  p = arraddnptr(a, 10);\n  for (i = 0; i < 10; ++i) p[i] = 7 * i;\n  printf(\"addnptr len=%td cap=%zu idx=%td\\n\", arrlen(a), arrcap(a),\n         arraddnindex(a, 0));\n  for (i = 400; i < arrlen(a); ++i) printf(\"c[%d]=%d\\n\", i, a[i]);\n  arrfree(a);\n  printf(\"freed len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n\n  /* growth pattern of stbds_arrgrowf through many capacities */\n  {\n    void *g = NULL;\n    for (i = 0; i < 30; ++i) {\n      g = stbds_arrgrowf(g, 4, 1, 0);\n      ((stbds_array_header *) g)[-1].length += 1;\n      printf(\"grow %d len=%zu cap=%zu\\n\", i,\n             ((stbds_array_header *) g)[-1].length,\n             ((stbds_array_header *) g)[-1].capacity);\n    }\n    stbds_arrfreef(g);\n  }\n  for (i = 0; i < 8; ++i) {\n    void *g = stbds_arrgrowf(NULL, 12, (size_t) i, (size_t) (i * 3));\n    printf(\"grow2 %d len=%zu cap=%zu\\n\", i,\n           ((stbds_array_header *) g)[-1].length,\n           ((stbds_array_header *) g)[-1].capacity);\n    stbds_arrfreef(g);\n  }\n}\n\nstatic void test_imap(void)\n{\n  imap *m = NULL;\n  int i;\n  ptrdiff_t j;\n  printf(\"== int map ==\\n\");\n  printf(\"len empty=%td\\n\", hmlen(m));\n  for (i = 0; i < 300; ++i) {\n    hmput(m, i * 7, i);\n    if (i % 29 == 0) printf(\"put %d len=%td\\n\", i, hmlen(m));\n  }\n  printf(\"len=%td lenu=%zu\\n\", hmlen(m), hmlenu(m));\n  for (i = 0; i < 300; ++i)\n    printf(\"get %d idx=%td val=%d\\n\", i * 7, hmgeti(m, i * 7), hmget(m, i * 7));\n  for (i = 0; i < 300; ++i) {\n    ptrdiff_t t;\n    int v = hmget_ts(m, i * 7, t);\n    if (i % 31 == 0) printf(\"ts %d idx=%td v=%d\\n\", i * 7, t, v);\n  }\n  for (i = 0; i < 300; i += 3) {\n    int r = (int) hmdel(m, i * 7);\n    if (i % 33 == 0) printf(\"del %d -> %d len=%td\\n\", i * 7, r, hmlen(m));\n  }\n  printf(\"after del len=%td\\n\", hmlen(m));\n  for (j = 0; j < hmlen(m); ++j)\n    printf(\"slot %td k=%d v=%d\\n\", j, m[j].key, m[j].value);\n  for (i = 0; i < 300; ++i) printf(\"q %d -> %td\\n\", i * 7, hmgeti(m, i * 7));\n  for (i = 0; i < 300; i += 2) hmput(m, i * 7, -i);\n  printf(\"re-put len=%td\\n\", hmlen(m));\n  for (j = 0; j < hmlen(m); ++j)\n    printf(\"slot2 %td k=%d v=%d\\n\", j, m[j].key, m[j].value);\n  hmdefault(m, -12345);\n  printf(\"miss=%d hit=%d\\n\", hmget(m, 999999), hmget(m, 7));\n  printf(\"getp_null miss=%d hit=%d\\n\", hmgetp_null(m, 999999) == NULL,\n         hmgetp_null(m, 7) == NULL);\n  /* delete everything -> exercises shrink path */\n  for (i = 0; i < 300; ++i) hmdel(m, i * 7);\n  printf(\"emptied len=%td\\n\", hmlen(m));\n  hmfree(m);\n  printf(\"freed len=%td\\n\", hmlen(m));\n}\n\nstatic void test_lmap(void)\n{\n  lmap *m = NULL;\n  int i;\n  printf(\"== long long map ==\\n\");\n  for (i = 0; i < 64; ++i) hmput(m, ((long long) i << 40) | 0xff, i);\n  for (i = 0; i < 64; ++i)\n    printf(\"ll %d idx=%td v=%d\\n\", i, hmgeti(m, ((long long) i << 40) | 0xff),\n           hmget(m, ((long long) i << 40) | 0xff));\n  hmfree(m);\n}\n\nstatic void test_structkey(void)\n{\n  skey2 *m = NULL;\n  int i;\n  printf(\"== struct(2 int) key map ==\\n\");\n  for (i = 0; i < 50; ++i) {\n    skey2 s;\n    s.key[0] = i; s.key[1] = -i; s.b = i * 2; s.c = i * 3; s.d = i * 4;\n    hmputs(m, s);\n  }\n  printf(\"len=%td\\n\", hmlen(m));\n  for (i = 0; i < 50; ++i) {\n    skey2 q; q.key[0] = i; q.key[1] = -i;\n    printf(\"s %d idx=%td b=%d c=%d d=%d\\n\", i, hmgeti(m, q.key),\n           hmgets(m, q.key).b, hmgets(m, q.key).c, hmgets(m, q.key).d);\n  }\n  for (i = 0; i < 50; i += 7) {\n    skey2 q; q.key[0] = i; q.key[1] = -i;\n    printf(\"del %d -> %d len=%td\\n\", i, (int) hmdel(m, q.key), hmlen(m));\n  }\n  for (i = 0; i < hmlen(m); ++i)\n    printf(\"row %d k=%d,%d b=%d\\n\", i, m[i].key[0], m[i].key[1], m[i].b);\n  hmfree(m);\n}\n\nstatic char keybuf[200][32];\n\nstatic void test_smap_default(void)\n{\n  smap *m = NULL;\n  int i;\n  ptrdiff_t j;\n  printf(\"== string map (default) ==\\n\");\n  for (i = 0; i < 200; ++i) sprintf(keybuf[i], \"key_%d_%d\", i, i * i);\n  for (i = 0; i < 200; ++i) shput(m, keybuf[i], i * 3);\n  printf(\"len=%td\\n\", shlen(m));\n  for (i = 0; i < 200; ++i)\n    printf(\"g %s -> %d idx=%td\\n\", keybuf[i], shget(m, keybuf[i]),\n           shgeti(m, keybuf[i]));\n  for (i = 0; i < 200; i += 5)\n    printf(\"del %s -> %d\\n\", keybuf[i], (int) shdel(m, keybuf[i]));\n  printf(\"after del len=%td\\n\", shlen(m));\n  for (j = 0; j < shlen(m); ++j)\n    printf(\"row %td %s=%d\\n\", j, m[j].key, m[j].value);\n  for (i = 0; i < 200; ++i) printf(\"q %d -> %td\\n\", i, shgeti(m, keybuf[i]));\n  printf(\"null miss=%d hit=%d\\n\", shgetp_null(m, \"nope\") == NULL,\n         shgetp_null(m, keybuf[1]) == NULL);\n  shdefault(m, -777);\n  printf(\"miss val=%d\\n\", shget(m, \"nope\"));\n  shfree(m);\n}\n\nstatic void test_smap_strdup(void)\n{\n  smap *m = NULL;\n  int i;\n  ptrdiff_t j;\n  char tmp[600];\n  printf(\"== string map (strdup) ==\\n\");\n  sh_new_strdup(m);\n  for (i = 0; i < 120; ++i) {\n    sprintf(tmp, \"dup_%d\", i);\n    shput(m, tmp, i);\n  }\n  for (i = 0; i < 120; ++i) {\n    sprintf(tmp, \"dup_%d\", i);\n    printf(\"g %s -> %d idx=%td\\n\", tmp, shget(m, tmp), shgeti(m, tmp));\n  }\n  for (i = 0; i < 120; i += 4) {\n    sprintf(tmp, \"dup_%d\", i);\n    printf(\"del %s -> %d\\n\", tmp, (int) shdel(m, tmp));\n  }\n  for (j = 0; j < shlen(m); ++j) printf(\"row %td %s=%d\\n\", j, m[j].key, m[j].value);\n  /* long keys */\n  memset(tmp, 'x', 550); tmp[550] = 0;\n  shput(m, tmp, 4242);\n  printf(\"long -> %d idx=%td len=%td\\n\", shget(m, tmp), shgeti(m, tmp), shlen(m));\n  for (i = 0; i < 60; ++i) { shput(m, strkey(i), 100 + i); }\n  for (i = 0; i < 60; ++i) printf(\"sk %s -> %d\\n\", strkey(i), shget(m, strkey(i)));\n  shfree(m);\n  printf(\"freed len=%td\\n\", shlen(m));\n}\n\nstatic void test_smap_arena(void)\n{\n  smap *m = NULL;\n  int i;\n  ptrdiff_t j;\n  char tmp[3000];\n  printf(\"== string map (arena) ==\\n\");\n  sh_new_arena(m);\n  for (i = 0; i < 150; ++i) {\n    sprintf(tmp, \"arena_key_%d\", i);\n    shput(m, tmp, i * i);\n  }\n  for (i = 0; i < 150; ++i) {\n    sprintf(tmp, \"arena_key_%d\", i);\n    printf(\"g %s -> %d idx=%td\\n\", 