{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_cvqczcpdc2u4pi5v5hxsuycnrvad3uwhhyurwaqnr323x6japp4a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Tc2D9NKbo7EJxGsMAeYAD1","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-translate-0pdCa6/tmp/fuzz.c","content":"/* Randomized differential fuzz driver. Deterministic PRNG; every observable\n   result is folded into a checksum that is printed periodically. */\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"stbds_decls.h\"\n\nextern char *strkey(int n);\nextern void arr_ins(int num);\n\ntypedef struct { int key; int value; } imap;\ntypedef struct { char *key; int value; } smap;\n\nstatic unsigned long long rs = 88172645463325252ULL;\nstatic unsigned long long rnd(void)\n{\n  rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17;\n  return rs;\n}\n\nstatic unsigned long long chk = 1469598103934665603ULL;\nstatic void fold(unsigned long long v)\n{\n  int i;\n  for (i = 0; i < 8; ++i) {\n    chk ^= (v >> (i * 8)) & 0xff;\n    chk *= 1099511628211ULL;\n  }\n}\nstatic void folds(const char *s)\n{\n  while (*s) { chk ^= (unsigned char) *s++; chk *= 1099511628211ULL; }\n}\n\nstatic void fuzz_imap(int iters, int keyspace)\n{\n  imap *m = NULL;\n  int i;\n  printf(\"-- fuzz imap iters=%d keyspace=%d\\n\", iters, keyspace);\n  for (i = 0; i < iters; ++i) {\n    int op = (int) (rnd() % 10);\n    int k = (int) (rnd() % (unsigned) keyspace);\n    if (op < 5) {\n      hmput(m, k, i);\n      fold((unsigned long long) hmlen(m));\n    } else if (op < 8) {\n      ptrdiff_t idx = hmgeti(m, k);\n      fold((unsigned long long) idx);\n      if (idx >= 0) fold((unsigned long long) m[idx].value);\n    } else {\n      ptrdiff_t r = hmdel(m, k);\n      fold((unsigned long long) r);\n      fold((unsigned long long) hmlen(m));\n    }\n    if (i % 1000 == 0) {\n      ptrdiff_t j, n = hmlen(m);\n      fold((unsigned long long) n);\n      for (j = 0; j < n; ++j) {\n        fold((unsigned long long) m[j].key);\n        fold((unsigned long long) m[j].value);\n      }\n      printf(\"  i=%d len=%td chk=%016llx\\n\", i, n, chk);\n    }\n  }\n  {\n    ptrdiff_t j, n = hmlen(m);\n    for (j = 0; j < n; ++j) { fold((unsigned long long) m[j].key); fold((unsigned long long) m[j].value); }\n    printf(\"  final len=%td chk=%016llx\\n\", n, chk);\n  }\n  hmfree(m);\n}\n\nstatic void fuzz_smap(int mode, int iters, int keyspace)\n{\n  smap *m = NULL;\n  int i;\n  char buf[1200];\n  printf(\"-- fuzz smap mode=%d iters=%d keyspace=%d\\n\", mode, iters, keyspace);\n  if (mode == 2) sh_new_strdup(m);\n  else if (mode == 3) sh_new_arena(m);\n  for (i = 0; i < iters; ++i) {\n    int op = (int) (rnd() % 10);\n    int k = (int) (rnd() % (unsigned) keyspace);\n    int extra = (int) (rnd() % 4);\n    if (extra == 3 && mode != 1) {\n      /* occasionally a long key to exercise arena/strdup big blocks */\n      int n = 100 + (int) (rnd() % 900);\n      memset(buf, 'a' + (k % 26), (size_t) n);\n      buf[n] = 0;\n      sprintf(buf + n - 12, \"_%d\", k);\n    } else {\n      sprintf(buf, \"k%d_%d\", k, k * 3);\n    }\n    if (op < 5) {\n      shput(m, buf, i);\n      fold((unsigned long long) shlen(m));\n    } else if (op < 8) {\n      ptrdiff_t idx = shgeti(m, buf);\n      fold((unsigned long long) idx);\n      if (idx >= 0) { fold((unsigned long long) m[idx].value); folds(m[idx].key); }\n    } else {\n      ptrdiff_t r = shdel(m, buf);\n      fold((unsigned long long) r);\n      fold((unsigned long long) shlen(m));\n    }\n    if (i % 500 == 0) {\n      ptrdiff_t j, n = shlen(m);\n      for (j = 0; j < n; ++j) { folds(m[j].key); fold((unsigned long long) m[j].value); }\n      printf(\"  i=%d len=%td chk=%016llx\\n\", i, n, chk);\n    }\n  }\n  {\n    ptrdiff_t j, n = shlen(m);\n    for (j = 0; j < n; ++j) { folds(m[j].key); fold((unsigned long long) m[j].value); }\n    printf(\"  final len=%td chk=%016llx\\n\", n, chk);\n  }\n  