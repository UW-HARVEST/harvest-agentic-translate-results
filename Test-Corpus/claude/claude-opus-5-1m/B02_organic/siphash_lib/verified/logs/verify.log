// --- CONFIGS.md row 36 ------------------------------------------------------","+fn row36_siphash_int_max_overflow() {","+    // `z++` at src/lib.c:118 overflows `int` part-way through the 64 iterations.","+    for init in [","+        i32::MAX,","+        i32::MAX - 1,","+        i32::MAX - 32,","+        i32::MAX - 63,","+        i32::MAX - 64,","+    ] {","+        check(init, &format!(\"row36 init={init}\"));","     }","+}"," ","-    // ---- row 37: 64 random inits ------------------------------------------","-    row(\"37 siphash 64 random inits\");","+// --- CONFIGS.md row 37 ------------------------------------------------------","+fn row37_siphash_random_inits(rng: &mut Rng) {","     for t in 0..64 {","         let init = rng.next_i32();","-        let got = diff_siphash(init);","-        assert_eq!(","-            String::from_utf8(got).unwrap(),","-            expected_text(init),","-            \"row37 t={t} init={init}\"","-        );","+        check(init, &format!(\"row37 t={t} init={init}\"));","     }","+}"," ","-    // ---- row 38: interleaved / repeated calls, no hidden state -------------","-    row(\"38 interleaved siphash + stbds_hash_bytes, repeated calls\");","+// --- CONFIGS.md row 38 ------------------------------------------------------","+fn row38_interleaved_no_hidden_state(rng: &mut Rng) {","     let (c, r) = impls();","     let mut buf = [0u8; 96];","     let baseline = diff_siphash(12345);"]},{"oldStart":154,"oldLines":7,"newStart":139,"newLines":7,"lines":["             \"row38: siphash(12345) output changed on repeat (t={t}) — hidden state?\"","         );","     }","-    // Two back-to-back calls in the same capture window must produce the output","+    // Two back-to-back calls in one capture window must produce the output","     // twice, in order, for both implementations.","     let cc = capture_stdout(|| unsafe {","         (c.siphash)(7);"]},{"oldStart":175,"oldLines":6,"newStart":160,"newLines":28,"lines":["         concat,","         \"row38: back-to-back output is not the concatenation of both digests\"","     );","+}"," ","+#[test]","+fn siphash_configuration_rows_31_to_38() {","+    let mut rng = Rng::new(0x51_9A_5F_00);","+","+    eprintln!(\"  [CONFIGS.md row 31] row31_siphash_init_0\");","+    row31_siphash_init_0();","+    eprintln!(\"  [CONFIGS.md row 32] row32_siphash_small_positive\");","+    row32_siphash_small_positive();","+    eprintln!(\"  [CONFIGS.md row 33] row33_siphash_signext_boundary\");","+    row33_siphash_signext_boundary();","+    eprintln!(\"  [CONFIGS.md row 34] row34_siphash_negative\");","+    row34_siphash_negative();","+    eprintln!(\"  [CONFIGS.md row 35] row35_siphash_int_min\");","+    row35_siphash_int_min();","+    eprintln!(\"  [CONFIGS.md row 36] row36_siphash_int_max_overflow\");","+    row36_siphash_int_max_overflow();","+    eprintln!(\"  [CONFIGS.md row 37] row37_siphash_random_inits\");","+    row37_siphash_random_inits(&mut rng);","+    eprintln!(\"  [CONFIGS.md row 38] row38_interleaved_no_hidden_state\");","+    row38_interleaved_no_hidden_state(&mut rng);","+","     eprintln!(\"  all siphash rows 31..=38 PASSED\");"," }"]}],"originalFile":"//! Phase B — valid-path differential tests for the convenience entry point\n//! `void siphash(int init)`, rows 31..=38 of `CONFIGS.md`.\n//!\n//! `siphash` communicates through `stdout`, so the test redirects fd 1 to a temp\n//! file and compares the emitted bytes. fd 1 is process-global and libtest's own\n//! result lines also go to fd 1, so this file deliberately contains **exactly one\n//! `#[test]`**: with a single test in the binary nothing else can write to fd 1\n//! while a capture window is open. Per-row progress goes to stderr.\n\nmod common;\n\nuse common::{capture_stdout, diff_hash, diff_siphash, impls, Rng};\nuse std::ffi::c_void;\n\nfn row(name: &str) {\n    eprintln!(\"  [CONFIGS.md row] {name}\");\n}\n\n/// Independently recompute what `siphash(init)` must print, using the C\n/// implementation's own `stbds_hash_bytes` — this proves the captured text is\n/// really the 64 digests of the `mem` buffer and that the capture works, not\n/// just that two byte blobs happen to be equal.\nfn expected_text(init: i32) -> String {\n    let (c, _) = impls();\n    let mut mem = [0u8; 64];\n    let mut z: i32 = init;\n    for i in 0..64usize {\n        mem[i] = z as u8;\n        z = z.wrapping_add(1);\n    }\n    let mut s = String::new();\n    for i in 0..64usize {\n        let h = unsafe { (c.hash_bytes)(mem.as_mut_ptr() as *mut c_void, i, 0) };\n        s.push_str(\"  { \");\n        for j in 0..8usize {\n            s.push_str(&format!(\"0x{:02x}, \", ((h >> (j * 8)) & 255) as u8));\n        }\n        s.push_str(\" },\\n\");\n    }\n    s\n}\n\n#[test]\nfn siphash_configuration_rows_31_to_38() {\n    let mut rng = Rng::new(0x51_9A_5F_00);\n\n    // ---- row 31: init == 0 -------------------------------------------------\n    row(\"31 siphash init=0\");\n    let out0 = diff_siphash(0);\n    // Structural checks on the captured output.\n    let text0 = String::from_utf8(out0.clone()).expect(\"siphash output must be UTF-8/ASCII\");\n    assert_eq!(\n        text0.lines().count(),\n        64,\n        \"siphash must print exactly 64 lines, got:\\n{text0}\"\n    );\n    for l in text0.lines() {\n        assert!(\n            l.starts_with(\"  { 0x\") && l.ends_with(\",  },\"),\n            \"unexpected line format: {l:?}\"\n        );\n        assert_eq!(l.matches(\"0x\").count(), 8, \"each line has 8 bytes: {l:?}\");\n    }\n    assert_eq!(\n        text0,\n        expected_text(0),\n        \"row31: captured text does not match an independent recomputation from \\\n         the C stbds_hash_bytes\"\n    );\n\n    // ---- row 32: small positive -------------------------------------------\n    row(\"32 siphash init in {1,2,3,42,127}\");\n    for init in [1i32, 2, 3, 42, 127] {\n        let got = diff_siphash(init);\n        assert_eq!(\n            String::from_utf8(got).unwrap(),\n            expected_text(init),\n            \"row32 init={init}\"\n        );\n    }\n\n    // ---- row 33: 0x80 sign-extension boundary ------------------------------\n    row(\"33 siphash init in {0x7f,0x80,0x81,0xc0,0xff}\");\n    for init in [0x7fi32, 0x80, 0x81, 0xc0, 0xff, 0x100, 0x1ff] {\n        let got = diff_siphash(init);\n        assert_eq!(\n            String::from_utf8(got).unwrap(),\n            expected_text(init),\n            \"row33 init={init:#x}\"\n        );\n    }\n\n    // ---- row 34: negative init --------------------------------------------\n    row(\"34 siphash init negative\");\n    for init in [-1i32, -2, -64, -128, -200, -255, -256, -1000, -65536] {\n        let got = diff_siphash(init);\n        assert_eq!(\n            String::from_utf8(got).unwrap(),\n            expected_text(init),\n            \"row34 init={init}\"\n        );\n    }\n\n    // ---- row 35: INT_MIN ---------------------------------------------------\n    row(\"35 siphash init=INT_MIN\");\n    let got = diff_siphash(i32::MIN);\n    assert_eq!(\n        String::from_utf8(got).unwrap(),\n        expected_text(i32::MIN),\n        \"row35 init=INT_MIN\"\n    );\n    diff_siphash(i32::MIN + 1);\n    diff_siphash(i32::MIN + 63);\n\n    // ---- row 36: INT_MAX (z++ overflows mid-loop) --------------------------\n    row(\"36 siphash init=INT_MAX (signed overflow in z++)\");\n    for init in [i32::MAX, i32::MAX - 1, i32::MAX - 32, i32::MAX - 63, i32::MAX - 64] {\n        let got = diff_siphash(init);\n        assert_eq!(\n            String::from_utf8(got).unwrap(),\n            expected_text(init),\n            \"row36 init={init}\"\n        );\n    }\n\n    // ---- row 37: 64 random inits ------------------------------------------\n    row(\"37 siphash 64 random inits\");\n    for t in 0..64 {\n        let init = rng.next_i32();\n        let got = diff_siphash(init);\n        assert_eq!(\n            String::from_utf8(got).unwrap(),\n            expected_text(init),\n            \"row37 t={t} init={init}\"\n        );\n    }\n\n    // ---- row 38: interleaved / repeated calls, no hidden state -------------\n    row(\"38 interleaved siphash + stbds_hash_bytes, repeated calls\");\n    let (c, r) = impls();\n    let mut buf = [0u8; 96];\n    let baseline = diff_siphash(12345);\n    for t in 0..24 {\n        // Hammer the low-level entry point between the two siphash calls.\n        rng.fill(&mut buf);\n        let len = rng.range(0, 96);\n        let seed = rng.next_usize();\n        diff_hash(&mut buf, len, seed, &format!(\"row38 t={t}\"));\n\n        // Calling siphash again must give byte-identical output (no state).\n        let again = diff_siphash(12345);\n        assert_eq!(\n            baseline, again,\n            \"row38: siphash(12345) output changed on repeat (t={t}) — hidden state?\"\n        );\n    }\n    // Two back-to-back calls in the same capture window must produce the output\n    // twice, in order, for both implementations.\n    let cc = capture_stdout(|| unsafe {\n        (c.siphash)(7);\n        (c.siphash)(-7);\n    });\n    let rr = capture_stdout(|| unsafe {\n        (r.siphash)(7);\n        (r.siphash)(-7);\n    });\n    assert_eq!(\n        cc, rr,\n        \"row38: back-to-back siphash(7); siphash(-7) output differs\"\n    );\n    let mut concat = expected_text(7);\n    concat.push_str(&expected_text(-7));\n    assert_eq!(\n        String::from_utf8(cc).unwrap(),\n        concat,\n        \"row38: back-to-back output is not the concatenation of both digests\"\n    );\n\n    eprintln!(\"  all siphash rows 31..=38 PASSED\");\n}\n","userModified":false}}
