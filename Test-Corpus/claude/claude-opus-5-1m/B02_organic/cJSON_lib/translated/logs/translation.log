(needed > (INT_MAX / 2))\n486\t    {\n487\t        /* overflow of int, use INT_MAX if possible */\n488\t        if (needed <= INT_MAX)\n489\t        {\n490\t            newsize = INT_MAX;\n491\t        }\n492\t        else\n493\t        {\n494\t            return NULL;\n495\t        }\n496\t    }\n497\t    else\n498\t    {\n499\t        newsize = needed * 2;\n500\t    }\n501\t\n502\t    if (p->hooks.reallocate != NULL)\n503\t    {\n504\t        /* reallocate with realloc if available */\n505\t        newbuffer = (unsigned char*)p->hooks.reallocate(p->buffer, newsize);\n506\t        if (newbuffer == NULL)\n507\t        {\n508\t            p->hooks.deallocate(p->buffer);\n509\t            p->length = 0;\n510\t            p->buffer = NULL;\n511\t\n512\t            return NULL;\n513\t        }\n514\t    }\n515\t    else\n516\t    {\n517\t        /* otherwise reallocate manually */\n518\t        newbuffer = (unsigned char*)p->hooks.allocate(newsize);\n519\t        if (!newbuffer)\n520\t        {\n521\t            p->hooks.deallocate(p->buffer);\n522\t            p->length = 0;\n523\t            p->buffer = NULL;\n524\t\n525\t            return NULL;\n526\t        }\n527\t\n528\t        memcpy(newbuffer, p->buffer, p->offset + 1);\n529\t        p->hooks.deallocate(p->buffer);\n530\t    }\n531\t    p->length = newsize;\n532\t    p->buffer = newbuffer;\n533\t\n534\t    return newbuffer + p->offset;\n535\t}\n536\t\n537\t/* calculate the new length of the string in a printbuffer and update the offset */\n538\tstatic void update_offset(printbuffer * const buffer)\n539\t{\n540\t    const unsigned char *buffer_pointer = NULL;\n541\t    if ((buffer == NULL) || (buffer->buffer == NULL))\n542\t    {\n543\t        return;\n544\t    }\n545\t    buffer_pointer = buffer->buffer + buffer->offset;\n546\t\n547\t    buffer->offset += strlen((const char*)buffer_pointer);\n548\t}\n549\t\n550\t/* securely comparison of floating-point variables */\n551\tstatic cJSON_bool compare_double(double 