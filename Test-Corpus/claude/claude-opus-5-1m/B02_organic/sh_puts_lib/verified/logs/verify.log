       } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n681\t                return -1;\n682\t            }\n683\t            i += 1;\n684\t        }\n685\t\n686\t        let limit: usize = pos & STBDS_BUCKET_MASK;\n687\t        i = 0;\n688\t        while i < limit {\n689\t            if (*bucket).hash[i] == hash {\n690\t                if stbds_is_key_equal(\n691\t                    a,\n692\t                    elemsize,\n693\t                    key,\n694\t                    keysize,\n695\t                    keyoffset,\n696\t                    mode,\n697\t                    (*bucket).index[i] as usize,\n698\t                ) != 0\n699\t                {\n700\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n701\t                }\n702\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n703\t                return -1;\n704\t            }\n705\t            i += 1;\n706\t        }\n707\t\n708\t        pos = pos.wrapping_add(step);\n709\t        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n710\t        pos &= (*table).slot_count.wrapping_sub(1);\n711\t    }\n712\t}\n713\t\n714\t#[unsafe(no_mangle)]\n715\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n716\t    a: *mut c_void,\n717\t    elemsize: usize,\n718\t    key: *mut c_void,\n719\t    keysize: usize,\n720\t    temp: *mut isize,\n721\t    mode: c_int,\n722\t) -> *mut c_void {\n723\t    let mut a = a;\n724\t    let keyoffset: usize = 0;\n725\t    if a.is_null() {\n726\t        a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n727\t        (*stbds_header(a)).length = (*stbds_header(a)).length.wrapping_add(1);\n728\t        memset(a, 0, elemsize);\n729\t        *temp = STBDS_INDEX_EMPTY;\n730\t        stbds_arr_to_hash(a, elemsize)\n731\t    } else {\n732\t        let table: *mut stbds_hash_index;\n733\t        let raw_a: *mut c_void = stbds_hash_to_arr(a, elemsize);\n734\t        table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n735\t        if table.is_null() {\n736\t            *temp = -1;\n737\t        } else {\n738\t            let slot: isize = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n739\t            if slot < 0 {\n740\t                *temp = STBDS_INDEX_EMPTY;\n741\t            } else {\n742\t                let b: *mut stbds_hash_bucket = (*table)\n743\t                    .storage\n744\t                    .wrapping_add((slot >> STBDS_BUCKET_SHIFT) as usize);\n745\t                *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n746\t            }\n747\t        }\n748\t        a\n749\t    }\n750\t}\n751\t\n752\t#[unsafe(no_mangle)]\n753\tpub unsafe extern \"C\" fn stbds_hmget_key(\n754\t    a: *mut c_void,\n755\t    elemsize: usize,\n756\t    key: *mut c_void,\n757\t    keysize: usize,\n758\t    mode: c_int,\n759\t) -> *mut c_void {\n760\t    let mut temp: isize = 0;\n761\t    let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &mut temp, mode);\n762\t    (*stbds_header(stbds_hash_to_arr(p, elemsize))).temp = temp;\n763\t    p\n764\t}\n765\t\n766\t#[unsafe(no_mangle)]\n767\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n768\t    let mut a = a;\n769\t    if a.is_null()\n770\t        || (*stbds_header(stbds_hash_to_arr(a, elemsize))).length == 0\n771\t    {\n772\t        a = stbds_arrgrowf(\n773\t            if !a.is_null() {\n774\t                stbds_hash_to_arr(a, elemsize)\n775\t            } else {\n776\t                ptr::null_mut()\n777\t            },\n778\t            elemsize,\n779\t            0,\n780\t            1,\n781\t        );\n782\t        (*stbds_header(a)).length = (*stbds_header(a)).length.wrapping_add(1);\n783\t        memset(a, 0, elemsize);\n784\t        a = stbds_arr_to_hash(a, elemsize);\n785\t    }\n786\t    a\n787\t}\n788\t\n789\t#[unsafe(no_mangle)]\n790\tpub unsafe extern \"C\" fn stbds_hmput_key(\n791\t    a: *mut c_void,\n792\t    elemsize: usize,\n793\t    key: *mut c_void,\n794\t    keysize: usize,\n795\t    mode: c_int,\n796\t) -> *mut c_void {\n797\t    let mut a = a;\n798\t    let keyoffset: usize = 0;\n799\t    let mut raw_a: *mut c_void;\n800\t    let mut table: *mut stbds_hash_index;\n801\t\n802\t    if a.is_null() {\n803\t        a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n804\t        memset(a, 0, elemsize);\n805\t        (*stbds_header(a)).length = (*stbds_header(a)).length.wrapping_add(1);\n806\t        a = stbds_arr_to_hash(a, elemsize);\n807\t    }\n808\t\n809\t    raw_a = a;\n810\t    a = stbds_hash_to_arr(a, elemsize);\n811\t\n812\t    table = (*stbds_header(a)).hash_table as *mut stbds_hash_index;\n813\t\n814\t    if table.is_null() || (*table).used_count >= (*table).used_count_threshold {\n815\t        let nt: *mut stbds_hash_index;\n816\t        let slot_count: usize;\n817\t\n818\t        slot_count = if table.is_null() {\n819\t            STBDS_BUCKET_LENGTH\n820\t        } else {\n821\t            (*table).slot_count.wrapping_mul(2)\n822\t        };\n823\t        nt = stbds_make_hash_index(slot_count, table);\n824\t        if !table.is_null() {\n825\t            free(table as *mut c_void);\n826\t        } else {\n827\t            (*nt).string.mode = if mode >= STBDS_HM_STRING {\n828\t                STBDS_SH_DEFAULT as u8\n829\t            } else {\n830\t                0\n831\t            };\n832\t        }\n833\t        table = nt;\n834\t        (*stbds_header(a)).hash_table = nt as *mut c_void;\n835\t    }\n836\t\n837\t    {\n838\t        let mut hash: usize = if mode >= STBDS_HM_STRING {\n839\t            stbds_hash_string(key as *mut c_char, (*table).seed)\n840\t        } else {\n841\t            stbds_hash_bytes(key, keysize, (*table).seed)\n842\t        };\n843\t        let mut step: usize = STBDS_BUCKET_LENGTH;\n844\t        let mut pos: usize;\n845\t        let mut tombstone: isize = -1;\n846\t        let mut bucket: *mut stbds_hash_bucket;\n847\t\n848\t        if hash < 2 {\n849\t            hash = hash.wrapping_add(2);\n850\t        }\n851\t\n852\t        pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n853\t\n854\t        'found_empty_slot: loop {\n855\t            bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n856\t\n857\t            let mut i: usize = pos & STBDS_BUCKET_MASK;\n858\t            while i < STBDS_BUCKET_LENGTH {\n859\t                if (*bucket).hash[i] == hash {\n860\t                    if stbds_is_key_equal(\n861\t                        raw_a,\n862\t                        elemsize,\n863\t                        key,\n864\t                        keysize,\n865\t                        keyoffset,\n866\t                        mode,\n867\t                        (*bucket).index[i] as usize,\n868\t                    ) != 0\n869\t                    {\n870\t                        (*stbds_header(a)).temp = (*bucket).index[i];\n871\t                        if mode >= STBDS_HM_STRING {\n872\t                            let src = byte_off(\n873\t                                raw_a,\n874\t                                elemsize\n875\t                                    .wrapping_mul((*bucket).index[i] as usize)\n876\t                                    .wrapping_add(keyoffset),\n877\t                            ) as *mut *mut c_char;\n878\t                            *stbds_temp_key_ptr(a) = *src;\n879\t                        }\n880\t                        return stbds_arr_to_hash(a, elemsize);\n881\t                    }\n882\t                } else if (*bucket).hash[i] == 0 {\n883\t                    pos = (pos & !STBDS_BUCKET_MASK).wrapping_add(i);\n884\t                    break 'found_empty_slot;\n885\t                } else if tombstone < 0 {\n886\t                    if (*bucket).index[i] == STBDS_INDEX_DELETED {\n887\t                        tombstone = ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n888\t                    }\n889\t                }\n890\t      