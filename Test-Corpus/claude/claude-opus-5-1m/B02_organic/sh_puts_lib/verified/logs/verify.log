\n97\t#[derive(Copy, Clone)]\n98\tpub struct stbds_hash_bucket {\n99\t    pub hash: [usize; STBDS_BUCKET_LENGTH],\n100\t    pub index: [isize; STBDS_BUCKET_LENGTH],\n101\t}\n102\t\n103\t#[repr(C)]\n104\t#[derive(Copy, Clone)]\n105\tpub struct stbds_hash_index {\n106\t    pub temp_key: *mut c_char,\n107\t    pub slot_count: usize,\n108\t    pub used_count: usize,\n109\t    pub used_count_threshold: usize,\n110\t    pub used_count_shrink_threshold: usize,\n111\t    pub tombstone_count: usize,\n112\t    pub tombstone_count_threshold: usize,\n113\t    pub seed: usize,\n114\t    pub slot_count_log2: usize,\n115\t    pub string: stbds_string_arena,\n116\t    pub storage: *mut stbds_hash_bucket,\n117\t}\n118\t\n119\tconst STBDS_INDEX_EMPTY: isize = -1;\n120\tconst STBDS_INDEX_DELETED: isize = -2;\n121\t\n122\tconst STBDS_HASH_EMPTY: usize = 0;\n123\tconst STBDS_HASH_DELETED: usize = 1;\n124\t\n125\t#[allow(dead_code)]\n126\tconst STBDS_HM_BINARY: c_int = 0;\n127\tconst STBDS_HM_STRING: c_int = 1;\n128\t\n129\t#[allow(dead_code)]\n130\tconst STBDS_SH_NONE: c_int = 0;\n131\tconst STBDS_SH_DEFAULT: c_int = 1;\n132\tconst STBDS_SH_STRDUP: c_int = 2;\n133\tconst STBDS_SH_ARENA: c_int = 3;\n134\t\n135\tconst HEADER_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n136\tconst HASH_INDEX_SIZE: usize = core::mem::size_of::<stbds_hash_index>();\n137\tconst HASH_BUCKET_SIZE: usize = core::mem::size_of::<stbds_hash_bucket>();\n138\tconst STRING_BLOCK_SIZE: usize = core::mem::size_of::<stbds_string_block>();\n139\tconst STRING_ARENA_SIZE: usize = core::mem::size_of::<stbds_string_arena>();\n140\t\n141\t// Guard the layout assumptions the C code makes.\n142\tconst _: () = assert!(HEADER_SIZE == 32);\n143\tconst _: () = assert!(HASH_BUCKET_SIZE == 128);\n144\tconst _: () = assert!(HASH_INDEX_SIZE == 104);\n145\tconst _: () = assert!(STRING_BLOCK_SIZE == 16);\n146\tconst _: () = assert!(STRING_ARENA_SIZE == 24);\n147\tconst _: () = assert!(core::mem::size_of::<usize>() == 8);\n148\t\n149\t// ---------------------------------------------------------------------------\n150\t// Small helpers corresponding to the stb_ds macros\n151\t// ---------------------------------------------------------------------------\n152\t\n153\t/// `stbds_header(t)` == `((stbds_array_header *) (t) - 1)`\n154\t#[inline(always)]\n155\tfn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n156\t    (t as *mut u8).wrapping_sub(HEADER_SIZE) as *mut stbds_array_header\n157\t}\n158\t\n159\t/// `stbds_arrcap(a)`\n160\t#[inline(always)]\n161\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n162\t    if a.is_null() {\n163\t        0\n164\t    } else {\n165\t        (*stbds_header(a)).capacity\n166\t    }\n167\t}\n168\t\n169\t/// `stbds_arrlen(a)`\n170\t#[inline(always)]\n171\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n172\t    if a.is_null() {\n173\t        0\n174\t    } else {\n175\t        (*stbds_header(a)).length as isize\n176\t    }\n177\t}\n178\t\n179\t/// `stbds_hash_table(a)`\n180\t#[inline(always)]\n181\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n182\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n183\t}\n184\t\n185\t/// `STBDS_HASH_TO_ARR(x,elemsize)`\n186\t#[inline(always)]\n187\tfn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n188\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n189\t}\n190\t\n191\t/// `STBDS_ARR_TO_HASH(x,elemsize)`\n192\t#[inline(always)]\n193\tfn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n194\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n195\t}\n196\t\n197\t/// byte offset from a `void *`\n198\t#[inline(always)]\n199\tfn byte_off(p: *mut c_void, off: usize) -> *mut u8 {\n200\t    (p as *mut u8).wrapping_add(off)\n201\t}\n202\t\n203\t/// `stbds_temp_key(t)` lvalue == `*(char **) stbds_header(t)->hash_table`\n204\t#[inline(always)]\n205\tunsafe fn stbds_temp_key_ptr(t: *mut c_void) -> *mut *mut c_char {\n206\t    (*stbds_header(t)).hash_table as *mut *mut c_char\n207\t}\n208\t\n209\t// ---------------------------------------------------------------------------\n210\t// stbds_arrgrowf / stbds_arrfreef\n211\t// ---------------------------------------------------------------------------\n212\t\n213\t#[unsafe(no_mangle)]\n214\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n215\t    a: *mut c_void,\n216\t    elemsize: usize,\n217\t    addlen: usize,\n218\t    min_cap: usize,\n219\t) -> *mut c_void {\n220\t    let mut min_cap = min_cap;\n221\t    let b: *mut c_void;\n222\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n223\t\n224\t    if min_len > min_cap {\n225\t        min_cap = min_len;\n226\t    }\n227\t\n228\t    if min_cap <= stbds_arrcap(a) {\n229\t        return a;\n230\t    }\n231\t\n232\t    if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n233\t        min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n234\t    } else if min_cap < 4 {\n235\t        min_cap = 4;\n236\t    }\n237\t\n238\t    let old: *mut c_void = if !a.is_null() {\n239\t        stbds_header(a) as *mut c_void\n240\t    } else {\n241\t        ptr::null_mut()\n242\t    };\n243\t    let raw = realloc(\n244\t        old,\n245\t        elemsize\n246\t            .wrapping_mul(min_cap)\n247\t            .wrapping_add(HEADER_SIZE),\n248\t    );\n249\t    b = (raw as *mut u8).wrapping_add(HEADER_SIZE) as *mut c_void;\n250\t    if a.is_null() {\n251\t        (*stbds_header(b)).length = 0;\n252\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n253\t        (*stbds_header(b)).temp = 0;\n254\t    }\n255\t    (*stbds_header(b)).capacity = min_cap;\n256\t\n257\t    b\n258\t}\n259\t\n260\t#[unsafe(no_mangle)]\n261\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n262\t    free(stbds_header(a) as *mut c_void);\n263\t}\n264\t\n265\t// ---------------------------------------------------------------------------\n266\t// hash seed / hash index construction\n267\t// ---------------------------------------------------------------------------\n268\t\n269\tstatic mut stbds_hash_seed: usize = 0x31415926;\n270\t\n271\t#[unsafe(no_mangle)]\n272\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n273\t    stbds_hash_seed = seed;\n274\t}\n275\t\n276\t#[inline(always)]\n277\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n278\t    hash & slot_count.wrapping_sub(1)\n279\t}\n280\t\n281\tfn stbds_log2(slot_count: usize) -> usize {\n282\t    let mut slot_count = slot_count;\n283\t    let mut n: usize = 0;\n284\t    while slot_count > 1 {\n285\t        slot_count >>= 1;\n286\t        n += 1;\n287\t    }\n288\t    n\n289\t}\n290\t\n291\t/// `STBDS_ALIGN_FWD(n,a)`\n292\t#[inline(always)]\n293\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n294\t    n.wrapping_add(a).wrapping_sub(1) & !a.wrapping_sub(1)\n295\t}\n296\t\n297\t/// Faithful expansion of\n298\t/// `stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)` on a 64-bit `size_t`,\n299\t/// where `v32`/`v64_hi` are `int` constants and `v64_lo` is an `unsigned int`\n300\t/// constant.\n301\t#[inline(always)]\n302\tfn stbds_load_32_or_64(v32: u32, v64_hi: u32, v64_lo: u32) -> usize {\n303\t    // temp = v64_lo ^ v32;  temp <<= 16; temp <<= 16; temp >>= 16; temp >>= 16;\n304\t    let mut temp: usize = (v64_lo ^ v32) as usize; // unsigned int arithmetic\n305\t    temp = temp << 16;\n306\t    temp = temp << 16;\n307\t    temp = temp >> 16;\n308\t    temp = temp >> 16;\n309\t    // var = v64_hi; var <<= 16; var <<= 16; var ^= temp ^ v32;\n310\t    let mut var: usize = v64_hi as usize;\n311\t    var = var << 16;\n312\t    var = var << 16;\n313\t    var ^= temp ^ (v32 as usize);\n314\t    var\n315\t}\n316\t\n317\tunsafe fn stbds_make_hash_index(\n318\t    slot_count: usize,\n319\t    ot: *mut stbds_hash_index,\n320\t) -> *mut stbds_hash_index {\n321\t    let t: *mut stbds_hash_index = realloc(\n322\t        ptr::null_mut(),\n323\t        (slot_count >> STBDS_BUCKET_SHIFT)\n324\t            .wrapping_mul(HASH_BUCKET_SIZE)\n325\t            .wrapping_add(HASH_INDEX_SIZE)\n326\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n327\t    ) as *mut stbds_hash_index;\n328\t    (*t).storage = stbds_align_fwd(\n329\t        (t as usize).wrapping_add(HASH_INDEX_SIZE),\n330\t        STBDS_CACHE_LINE_SIZE,\n331\t    ) as *mut stbds_hash_bucket;\n332\t    (*t).slot_count = slot_count;\n333\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n334\t    (*t).tombstone_count = 0;\n335\t    (*t).used_count = 0;\n336\t\n337\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n338\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n339\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n340\t\n341\t    if slot_count <= STBDS_BUCKET_LENGTH {\n342\t        (*t).used_count_shrink_threshold = 0;\n343\t    }\n344\t    stbds_assert!(\n345\t        (*t).used_count_threshold.wrapping_add((*t).tombstone_count_threshold) < (*t).slot_count,\n346\t        \"t->used_count_threshold + t->tombstone_count_threshold < t->slot_count\",\n347\t        401,\n348\t        \"stbds_make_hash_index\"\n349\t    );\n350\t\n351\t    if !ot.is_null() {\n352\t        (*t).string = (*ot).string;\n353\t        (*t).seed = (*ot).seed;\n354\t    } else {\n355\t        memset(\n356\t            &mut (*t).string as *mut stbds_string_arena as *mut c_void,\n357\t            0,\n358\t            STRING_ARENA_SIZE,\n359\t        );\n360\t        (*t).seed = stbds_hash_seed;\n361\t        let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n362\t        let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n363\t        stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n364\t    }\n365\t\n366\t    {\n367\t        let mut i: usize = 0;\n368\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n369\t            let b: *mut stbds_hash_bucket = (*t).storage.wrapping_add(i);\n370\t            let mut j: usize = 0;\n371\t            while j < STBDS_BUCKET_LENGTH {\n372\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n373\t                j += 1;\n374\t            }\n375\t            j = 0;\n376\t            while j < STBDS_BUCKET_LENGTH {\n377\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n378\t                j += 1;\n379\t            }\n380\t            i += 1;\n381\t        }\n382\t    }\n383\t\n384\t    if !ot.is_null() {\n385\t        (*t).used_count = (*ot).used_count;\n386\t        let mut i: usize = 0;\n387\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n388\t            let ob: *mut stbds_hash_bucket = (*ot).storage.wrapping_add(i);\n389\t            let mut j: usize = 0;\n390\t            while j < STBDS_BUCKET_LENGTH {\n391\t                if (*ob).index[j] >= 0 {\n392\t                    let hash: usize = (*ob).hash[j];\n393\t                    let mut pos: usize =\n394\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n395\t                    let mut step: usize = STBDS_BUCKET_LENGTH;\n396\t                    'probe: loop {\n397\t                        let bucket: *mut stbds_hash_bucket =\n398\t                            (*t).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n399\t\n400\t                        let mut z: usize = pos & STBDS_BUCKET_MASK;\n401\t                        while z < STBDS_BUCKET_LENGTH {\n402\t                            if (*bucket).hash[z] == 0 {\n403\t                                (*bucket).hash[z] = hash;\n404\t                                (*bucket).index[z] = (*ob).index[j];\n405\t                                break 'probe;\n406\t                            }\n407\t                            z += 1;\n408\t                        }\n409\t\n410\t                        let limit: usize = pos & STBDS_BUCKET_MASK;\n411\t                        z = 0;\n412\t                        let mut placed = false;\n413\t                        while z < limit {\n414\t                            if (*bucket).hash[z] == 0 {\n415\t                                (*bucket).hash[z] = hash;\n416\t                                (*bucket).index[z] = (*ob).index[j];\n417\t                                placed = true;\n418\t                                break;\n419\t                            }\n420\t                            z += 1;\n421\t                        }\n422\t                        if placed {\n423\t                            break 'probe;\n424\t                        }\n425\t\n426\t                        pos = pos.wrapping_add(step);\n427\t                        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n428\t                        pos &= (*t).slot_count.wrapping_sub(1);\n429\t                    }\n430\t                }\n431\t                j += 1;\n432\t            }\n433\t            i += 1;\n434\t        }\n435\t    }\n436\t\n437\t    t\n438\t}\n439\t\n440\t// ---------------------------------------------------------------------------\n441\t// hashing\n442\t// ---------------------------------------------------------------------------\n443\t\n444\tconst STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() * 8) as u32;\n445\t\n446\t#[inline(always)]\n447\tfn rotl(val: usize, n: u32) -> usize {\n448\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n449\t}\n450\t\n451\t#[inline(always)]\n452\tfn rotr(val: usize, n: u32) -> usize {\n453\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n454\t}\n455\t\n456\t#[unsafe(no_mangle)]\n457\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n458\t    let mut hash: usize = seed;\n459\t    let mut s = str_ as *mut u8;\n460\t    while *s != 0 {\n461\t        hash = rotl(hash, 9).wrapping_add(*s as usize);\n462\t        s = s.wrapping_add(1);\n463\t    }\n464\t\n465\t    hash ^= seed;\n466\t    hash = (!hash).wrapping_add(hash << 18);\n467\t    hash = hash ^ (hash ^ rotr(hash, 31));\n468\t    hash = hash.wrapping_mul(21);\n469\t    hash = hash ^ (hash ^ rotr(hash, 11));\n470\t    hash = hash.wrapping_add(hash << 6);\n471\t    hash ^= rotr(hash, 22);\n472\t    hash.wrapping_add(seed)\n473\t}\n474\t\n475\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n476\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n477\t\n478\t#[inline(always)]\n479\tfn sipround(v0: &mut usize, v1: &mut usize, v2: &mut usize, v3: &mut usize) {\n480\t    *v0 = v0.wrapping_add(*v1);\n481\t    *v1 = rotl(*v1, 13);\n482\t    *v1 ^= *v0;\n483\t    *v0 = rotl(*v0, STBDS_SIZE_T_BITS / 2);\n484\t    *v2 = v2.wrapping_add(*v3);\n485\t    *v3 = rotl(*v3, 16);\n486\t    *v3 ^= *v2;\n487\t    *v2 = v2.wrapping_add(*v1);\n488\t    *v1 = rotl(*v1, 17);\n489\t    *v1 ^= *v2;\n490\t    *v2 = rotl(*v2, STBDS_SIZE_T_BITS / 2);\n491\t    *v0 = v0.wrapping_add(*v3);\n492\t    *v3 = rotl(*v3, 21);\n493\t    *v3 ^= *v0;\n494\t}\n495\t\n496\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n497\t    let mut d = p as *mut u8;\n498\t    let mut i: usize;\n499\t    let mut j: usize;\n500\t    let mut v0: usize;\n501\t    let mut v1: usize;\n502\t    let mut v2: usize;\n503\t    let mut v3: usize;\n504\t    let mut data: usize;\n505\t\n506\t    v0 = (((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575)) ^ seed;\n507\t    v1 = (((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d)) ^ !seed;\n508\t    v2 = (((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261)) ^ seed;\n509\t    v3 = (((0x74656462usize << 16) << 16).wrapping_add(0x79746573)) ^ !seed;\n510\t\n511\t    v0 ^= 0x0706050403020100usize ^ seed;\n512\t    v1 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n513\t    v2 ^= 0x0706050403020100usize ^ seed;\n514\t    v3 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n515\t\n516\t    i = 0;\n517\t    while i + core::mem::size_of::<usize>() <= len {\n518\t        // `data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);`\n519\t        // The right hand side is `int`; when d[3] >= 0x80 it becomes negative\n520\t        // and sign-extends into `size_t`.  Reproduce that exactly.\n521\t        let lo: u32 = (*d.wrapping_add(0) as u32)\n522\t            | ((*d.wrapping_add(1) as u32) << 8)\n523\t            | ((*d.wrapping_add(2) as u32) << 16)\n524\t            | ((*d.wrapping_add(3) as u32) << 24);\n525\t        data = (lo as i32) as isize as usize;\n526\t        let hi: u32 = (*d.wrapping_add(4) as u32)\n527\t            | ((*d.wrapping_add(5) as u32) << 8)\n528\t            | ((*d.wrapping_add(6) as u32) << 16)\n529\t            | ((*d.wrapping_add(7) as u32) << 24);\n530\t        data |= (((hi as i32) as isize as usize) << 16) << 16;\n531\t\n532\t        v3 ^= data;\n533\t        j = 0;\n534\t        while j < STBDS_SIPHASH_C_ROUNDS {\n535\t            sipround(&mut v0, &mut v1, &mut v2, &mut v3);\n536\t            j += 1;\n537\t        }\n538\t        v0 ^= data;\n539\t\n540\t        i += core::mem::size_of::<usize>();\n541\t        d = d.wrapping_add(core::mem::size_of::<usize>());\n542\t    }\n543\t\n544\t    data = len << (STBDS_SIZE_T_BITS - 8);\n545\t    let rem = len.wrapping_sub(i);\n546\t    // Fall-through switch on `len - i` (0..=7).\n547\t    if rem == 7 {\n548\t        data |= ((*d.wrapping_add(6) as usize) << 24) << 24;\n549\t    }\n550\t    if rem >= 6 && rem <= 7 {\n551\t        data |= ((*d.wrapping_add(5) as usize) << 20) << 20;\n552\t    }\n553\t    if rem >= 5 && rem <= 7 {\n554\t        data |= ((*d.wrapping_add(4) as usize) << 16) << 16;\n555\t    }\n556\t    if rem >= 4 && rem <= 7 {\n557\t        // `d[3] << 24` is `int` arithmetic -> sign extension on conversion.\n558\t        data |= (((*d.wrapping_add(3) as u32) << 24) as i32) as isize as usize;\n559\t    }\n560\t    if rem >= 3 && rem <= 7 {\n561\t        data |= (*d.wrapping_add(2) as usize) << 16;\n562\t    }\n563\t    if rem >= 2 && rem <= 7 {\n564\t        data |= (*d.wrapping_add(1) as usize) << 8;\n565\t    }\n566\t    if rem >= 1 && rem <= 7 {\n567\t        data |= *d.wrapping_add(0) as u