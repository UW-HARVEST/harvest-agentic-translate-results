d(SIGSEGV), \"C len={len} -> {oc:?}\");\n        assert_eq!(or_, oc, \"RUST len={len} -> {or_:?}\");''',\n'''        assert_eq!(oc, Outcome::Signalled(SIGSEGV), \"C len={len} -> {oc:?}\");\n        assert_fatal_equivalent(&oc, &or_, &format!(\"hash_bytes(NULL, {len})\"));''')\n\n# e33 / e35 / e36 / e42 share the same two lines\ns=s.replace('''    assert_eq!(oc, Outcome::Signalled(SIGSEGV), \"C -> {oc:?}\");\n    assert_eq!(or_, oc, \"RUST -> {or_:?}\");''',\n'''    assert_eq!(oc, Outcome::Signalled(SIGSEGV), \"C -> {oc:?}\");\n    assert_fatal_equivalent(&oc, &or_, \"null-pointer dereference\");''')\nopen(p,'w').write(s)\nPY\ngrep -c \"assert_fatal_equivalent\" tests/errors.rs","description":"Add debug-profile-aware fatal-signal comparison"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":778,"cache_read_input_tokens":254729,"cache_creation":{"ephemeral_5m_input_tokens":778,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"2081d412-c820-46e0-9f61-ea3d6918b907","uuid":"757d2832-02e3-4ecd-be20-7edb3f534e0c","timestamp":"2026-08-20T15:42:26.438Z"}
