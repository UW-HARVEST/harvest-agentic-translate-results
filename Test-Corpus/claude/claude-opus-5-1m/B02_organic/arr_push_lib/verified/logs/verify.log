as *mut *mut c_char;\n590\t                free(*slot as *mut c_void);\n591\t                i += 1;\n592\t            }\n593\t        }\n594\t        stbds_strreset(ptr::addr_of_mut!((*stbds_hash_table(a)).string));\n595\t    }\n596\t    free((*stbds_header(a)).hash_table);\n597\t    free(stbds_header(a) as *mut c_void);\n598\t}\n599\t\n600\tunsafe fn stbds_hm_find_slot(\n601\t    a: *mut c_void,\n602\t    elemsize: usize,\n603\t    key: *mut c_void,\n604\t    keysize: usize,\n605\t    keyoffset: usize,\n606\t    mode: c_int,\n607\t) -> isize {\n608\t    let raw_a = hash_to_arr(a, elemsize);\n609\t    let table = stbds_hash_table(raw_a);\n610\t    let mut hash = if mode >= STBDS_HM_STRING {\n611\t        stbds_hash_string(key as *mut c_char, (*table).seed)\n612\t    } else {\n613\t        stbds_hash_bytes(key, keysize, (*table).seed)\n614\t    };\n615\t    let mut step = STBDS_BUCKET_LENGTH;\n616\t\n617\t    if hash < 2 {\n618\t        hash = hash.wrapping_add(2);\n619\t    }\n620\t\n621\t    let mut pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n622\t\n623\t    loop {\n624\t        let bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n625\t\n626\t        let mut i = pos & STBDS_BUCKET_MASK;\n627\t        while i < STBDS_BUCKET_LENGTH {\n628\t            if (*bucket).hash[i] == hash {\n629\t                if stbds_is_key_equal(\n630\t                    a,\n631\t                    elemsize,\n632\t                    key,\n633\t                    keysize,\n634\t                    keyoffset,\n635\t                    mode,\n636\t                    (*bucket).index[i] as usize,\n637\t                ) {\n638\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n639\t                }\n640\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n641\t                return -1;\n642\t            }\n643\t            i += 1;\n644\t        }\n645\t\n646\t        let limit = pos & 