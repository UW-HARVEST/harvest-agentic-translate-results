{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WYCsXBmHBKTqP4hu9fzwqG","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (an stb_ds.h-based\n2\t//! dynamic array / hash map implementation plus two small test helpers).\n3\t//!\n4\t//! The translation is intentionally a literal, pointer-for-pointer port of the\n5\t//! C code: the same allocations (via libc `realloc`/`free`), the same memory\n6\t//! layouts, the same integer wrap-around / sign-extension quirks and the same\n7\t//! order of side effects.  Behaviour (including reproduced C quirks) must match\n8\t//! byte for byte.\n9\t\n10\t#![allow(non_camel_case_types)]\n11\t#![allow(clippy::missing_safety_doc)]\n12\t\n13\tuse core::ffi::{c_char, c_int, c_void};\n14\tuse core::ptr;\n15\tuse core::sync::atomic::{AtomicUsize, Ordering};\n16\t\n17\t// ---------------------------------------------------------------------------\n18\t// libc bindings (the C code uses realloc/free/memset/... directly)\n19\t// ---------------------------------------------------------------------------\n20\t\n21\textern \"C\" {\n22\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n23\t    fn free(p: *mut c_void);\n24\t    fn memset(p: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n25\t    fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n26\t    fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n27\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n28\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n29\t    fn strlen(s: *const c_char) -> usize;\n30\t    fn abort() -> !;\n31\t}\n32\t\n33\t/// `STBDS_ASSERT` == `assert()`.  None of these can fire during valid use of\n34\t/// the library; if one ever does, terminate like `assert()` does.\n35\t#[inline(always)]\n36\tfn stbds_assert(cond: bool) {\n37\t    if !cond {\n38\t        unsafe { abort() }\n39\t    }\n40\t}\n41\t\n42\t// ---------------------------------------------------------------------------\n43\t// Data structures (must match the C layouts exactly)\n44\t// ---------------------------------------------------------------------------\n45\t\n46\t#[repr(C)]\n47\t#[derive(Clone, Copy)]\n48\tpub struct stbds_array_header {\n49\t    pub length: usize,\n50\t    pub capacity: usize,\n51\t    pub hash_table: *mut c_void,\n52\t    pub temp: isize,\n53\t}\n54\t\n55\tconst HDR_SIZE: usize = core::mem::size_of::<stbds_array_header>(); // 32\n56\t\n57\t#[repr(C)]\n58\tpub struct stbds_string_block {\n59\t    pub next: *mut stbds_string_block,\n60\t    pub storage: [c_char; 8],\n61\t}\n62\t\n63\t#[repr(C)]\n64\t#[derive(Clone, Copy)]\n65\tpub struct stbds_string_arena {\n66\t    pub storage: *mut stbds_string_block,\n67\t    pub remaining: usize,\n68\t    pub block: u8,\n69\t    pub mode: u8,\n70\t}\n71\t\n72\tconst STBDS_BUCKET_LENGTH: usize = 8;\n73\tconst STBDS_BUCKET_SHIFT: usize = 3;\n74\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n75\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n76\t\n77\t#[repr(C)]\n78\tpub struct stbds_hash_bucket {\n79\t    pub hash: [usize; STBDS_BUCKET_LENGTH],\n80\t    pub index: [isize; STBDS_BUCKET_LENGTH],\n81\t}\n82\t\n83\t#[repr(C)]\n84\tpub struct stbds_hash_index {\n85\t    pub temp_key: *mut c_char,\n86\t    pub slot_count: usize,\n87\t    pub used_count: usize,\n88\t    pub used_count_threshold: usize,\n89\t    pub used_count_shrink_threshold: usize,\n90\t    pub tombstone_count: usize,\n91\t    pub tombstone_count_threshold: usize,\n92\t    pub seed: usize,\n93\t    pub slot_count_log2: usize,\n94\t    pub string: stbds_string_arena,\n95\t    pub storage: *mut stbds_hash_bucket,\n96\t}\n97\t\n98\tconst STBDS_INDEX_EMPTY: isize = -1;\n99\tconst STBDS_INDEX_DELETED: isize = -2;\n100\t\n101\tconst STBDS_HASH_EMPTY: usize = 0;\n102\tconst STBDS_HASH_DELETED: usize = 1;\n103\t\n104\t#[allow(dead_code)]\n105\tconst STBDS_HM_BINARY: c_int = 0;\n106\tconst STBDS_HM_STRING: c_int = 1;\n107\t\n108\tconst STBDS_SH_NONE: u8 = 0;\n109\tconst STBDS_SH_DEFAULT: u8 = 1;\n110\tconst STBDS_SH_STRDUP: u8 = 2;\n111\tconst STBDS_SH_ARENA: u8 = 3;\n112\t\n113\tconst STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() as u32) * 8;\n114\t\n115\t// Compile-time layout checks mirroring the C struct sizes.\n116\tconst _: () = assert!(core::mem::size_of::<stbds_array_header>() == 32);\n117\tconst _: () = assert!(core::mem::size_of::<stbds_hash_bucket>() == 128);\n118\tconst _: () = assert!(core::mem::size_of::<stbds_string_block>() == 16);\n119\tconst _: () = assert!(core::mem::size_of::<stbds_string_arena>() == 24);\n120\tconst _: () = assert!(core::mem::size_of::<stbds_hash_index>() == 104);\n121\tconst _: () = assert!(core::mem::size_of::<usize>() == 8);\n122\t\n123\t// ---------------------------------------------------------------------------\n124\t// Small pointer helpers (byte arithmetic, exactly like the C macros)\n125\t// ---------------------------------------------------------------------------\n126\t\n127\t#[inline(always)]\n128\tfn byte_add(p: *mut c_void, n: usize) -> *mut c_void {\n129\t    (p as *mut u8).wrapping_add(n) as *mut c_void\n130\t}\n131\t\n132\t#[inline(always)]\n133\tfn byte_sub(p: *mut c_void, n: usize) -> *mut c_void {\n134\t    (p as *mut u8).wrapping_sub(n) as *mut c_void\n135\t}\n136\t\n137\t/// `stbds_header(t)`\n138\t#[inline(always)]\n139\tfn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n140\t    byte_sub(t, HDR_SIZE) as *mut stbds_array_header\n141\t}\n142\t\n143\t/// `STBDS_ARR_TO_HASH(x, elemsize)`\n144\t#[inline(always)]\n145\tfn arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n146\t    byte_add(x, elemsize)\n147\t}\n148\t\n149\t/// `STBDS_HASH_TO_ARR(x, elemsize)`\n150\t#[inline(always)]\n151\tfn hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n152\t    byte_sub(x, elemsize)\n153\t}\n154\t\n155\t/// `stbds_arrcap(a)`\n156\t#[inline(always)]\n157\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n158\t    if a.is_null() {\n159\t        0\n160\t    } else {\n161\t        (*stbds_header(a)).capacity\n162\t    }\n163\t}\n164\t\n165\t/// `stbds_arrlen(a)`\n166\t#[inline(always)]\n167\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n168\t    if a.is_null() {\n169\t        0\n170\t    } else {\n171\t        (*stbds_header(a)).length as isize\n172\t    }\n173\t}\n174\t\n175\t/// `stbds_temp(t)` (lvalue write)\n176\t#[inline(always)]\n177\tunsafe fn set_temp(t: *mut c_void, v: isize) {\n178\t    (*stbds_header(t)).temp = v;\n179\t}\n180\t\n181\t/// `stbds_temp_key(t)` (lvalue write): `*(char **) stbds_header(t)->hash_table`\n182\t#[inline(always)]\n183\tunsafe fn set_temp_key(t: *mut c_void, v: *mut c_char) {\n184\t    let tbl = (*stbds_header(t)).hash_table as *mut *mut c_char;\n185\t    *tbl = v;\n186\t}\n187\t\n188\t/// `stbds_hash_table(a)`\n189\t#[inline(always)]\n190\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n191\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n192\t}\n193\t\n194\t// ---------------------------------------------------------------------------\n195\t// Dynamic array\n196\t// ---------------------------------------------------------------------------\n197\t\n198\t#[unsafe(no_mangle)]\n199\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n200\t    a: *mut c_void,\n201\t    elemsize: usize,\n202\t    addlen: usize,\n203\t    min_cap: usize,\n204\t) -> *mut c_void {\n205\t    let mut min_cap = min_cap;\n206\t    let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n207\t\n208\t    if min_len > min_cap {\n209\t        min_cap = min_len;\n210\t    }\n211\t\n212\t    if min_cap <= stbds_arrcap(a) {\n213\t        return a;\n214\t    }\n215\t\n216\t    if min_cap < stbds_arrcap(a).wrapping_mul(2) {\n217\t        min_cap = stbds_arrcap(a).wrapping_mul(2);\n218\t    } else if min_cap < 4 {\n219\t        min_cap = 4;\n220\t    }\n221\t\n222\t    let old: *mut c_void = if !a.is_null() {\n223\t        stbds_header(a) as *mut c_void\n224\t    } else {\n225\t        ptr::null_mut()\n226\t    };\n227\t\n228\t    let raw = realloc(\n229\t        old,\n230\t        elemsize.wrapping_mul(min_cap).wrapping_add(HDR_SIZE),\n231\t    );\n232\t    let b = byte_add(raw, HDR_SIZE);\n233\t    if a.is_null() {\n234\t        (*stbds_header(b)).length = 0;\n235\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n236\t        (*stbds_header(b)).temp = 0;\n237\t    }\n238\t    (*stbds_header(b)).capacity = min_cap;\n239\t\n240\t    b\n241\t}\n242\t\n243\t#[unsafe(no_mangle)]\n244\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n245\t    free(stbds_header(a) as *mut c_void);\n246\t}\n247\t\n248\t// ---------------------------------------------------------------------------\n249\t// Hashing\n250\t// ---------------------------------------------------------------------------\n251\t\n252\tstatic STBDS_HASH_SEED: AtomicUsize = AtomicUsize::new(0x31415926);\n253\t\n254\t#[inline(always)]\n255\tfn hash_seed_get() -> usize {\n256\t    STBDS_HASH_SEED.load(Ordering::Relaxed)\n257\t}\n258\t\n259\t#[inline(always)]\n260\tfn hash_seed_set(v: usize) {\n261\t    STBDS_HASH_SEED.store(v, Ordering::Relaxed);\n262\t}\n263\t\n264\t#[unsafe(no_mangle)]\n265\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n266\t    hash_seed_set(seed);\n267\t}\n268\t\n269\t#[inline(always)]\n270\tfn rotl(val: usize, n: u32) -> usize {\n271\t    // ((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n)))\n272\t    (val.wrapping_shl(n)) | (val.wrapping_shr(STBDS_SIZE_T_BITS - n))\n273\t}\n274\t\n275\t#[inline(always)]\n276\tfn rotr(val: usize, n: u32) -> usize {\n277\t    // ((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n)))\n278\t    (val.wrapping_shr(n)) | (val.wrapping_shl(STBDS_SIZE_T_BITS - n))\n279\t}\n280\t\n281\t#[inline(always)]\n282\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n283\t    hash & (slot_count.wrapping_sub(1))\n284\t}\n285\t\n286\tfn stbds_log2(slot_count: usize) -> usize {\n287\t    let mut slot_count = slot_count;\n288\t    let mut n: usize = 0;\n289\t    while slot_count > 1 {\n290\t        slot_count >>= 1;\n291\t        n += 1;\n292\t    }\n293\t    n\n294\t}\n295\t\n296\t#[unsafe(no_mangle)]\n297\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n298\t    let mut hash = seed;\n299\t    let mut s = str_ as *const u8;\n300\t    while *s != 0 {\n301\t        hash = rotl(hash, 9).wrapping_add(*s as usize);\n302\t        s = s.wrapping_add(1);\n303\t    }\n304\t\n305\t    hash ^= seed;\n306\t    hash = (!hash).wrapping_add(hash.wrapping_shl(18));\n307\t    hash = hash ^ (hash ^ rotr(hash, 31));\n308\t    hash = hash.wrapping_mul(21);\n309\t    hash = hash ^ (hash ^ rotr(hash, 11));\n310\t    hash = hash.wrapping_add(hash.wrapping_shl(6));\n311\t    hash ^= rotr(hash, 22);\n312\t    hash.wrapping_add(seed)\n313\t}\n314\t\n315\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n316\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n317\t\n318\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n319\t    let mut d = p as *const u8;\n320\t    let mut v0: usize;\n321\t    let mut v1: usize;\n322\t    let mut v2: usize;\n323\t    let mut v3: usize;\n324\t    let mut data: usize;\n325\t\n326\t    v0 = ((0x736f6d65usize << 16 << 16).wrapping_add(0x70736575)) ^ seed;\n327\t    v1 = ((0x646f7261usize << 16 << 16).wrapping_add(0x6e646f6d)) ^ !seed;\n328\t    v2 = ((0x6c796765usize << 16 << 16).wrapping_add(0x6e657261)) ^ seed;\n329\t    v3 = ((0x74656462usize << 16 << 16).wrapping_add(0x79746573)) ^ !seed;\n330\t\n331\t    v0 ^= 0x0706050403020100usize ^ seed;\n332\t    v1 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n333\t    v2 ^= 0x0706050403020100usize ^ seed;\n334\t    v3 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n335\t\n336\t    macro_rules! siproundf {\n337\t        () => {{\n338\t            v0 = v0.wrapping_add(v1);\n339\t            v1 = rotl(v1, 13);\n340\t            v1 ^= v0;\n341\t            v0 = rotl(v0, STBDS_SIZE_T_BITS / 2);\n342\t            v2 = v2.wrapping_add(v3);\n343\t            v3 = rotl(v3, 16);\n344\t            v3 ^= v2;\n345\t            v2 = v2.wrapping_add(v1);\n346\t            v1 = rotl(v1, 17);\n347\t            v1 ^= v2;\n348\t            v2 = rotl(v2, STBDS_SIZE_T_BITS / 2);\n349\t            v0 = v0.wrapping_add(v3);\n350\t            v3 = rotl(v3, 21);\n351\t            v3 ^= v0;\n352\t        }};\n353\t    }\n354\t\n355\t    let mut i: usize = 0;\n356\t    while i + core::mem::size_of::<usize>() <= len {\n357\t        // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n358\t        //\n359\t        // NOTE: in C these are `int` expressions; `d[3] << 24` can set the sign\n360\t        // bit, and the resulting negative `int` is then sign-extended when\n361\t        // stored into the `size_t` `data`.  That quirk is part of the observable\n362\t        // behaviour, so it is reproduced here.\n363\t        let lo: i32 = (*d.wrapping_add(0) as i32)\n364\t            | ((*d.wrapping_add(1) as i32).wrapping_shl(8))\n365\t            | ((*d.wrapping_add(2) as i32).wrapping_shl(16))\n366\t            | ((*d.wrapping_add(3) as i32).wrapping_shl(24));\n367\t        data = lo as isize as usize;\n368\t\n369\t        let hi: i32 = (*d.wrapping_add(4) as i32)\n370\t            | ((*d.wrapping_add(5) as i32).wrapping_shl(8))\n371\t            | ((*d.wrapping_add(6) as i32).wrapping_shl(16))\n372\t            | ((*d.wrapping_add(7) as i32).wrapping_shl(24));\n373\t        data |= (hi as isize as usize).wrapping_shl(16).wrapping_shl(16);\n374\t\n375\t        v3 ^= data;\n376\t        for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n377\t            siproundf!();\n378\t        }\n379\t        v0 ^= data;\n380\t\n381\t        i += core::mem::size_of::<usize>();\n382\t        d = d.wrapping_add(core::mem::size_of::<usize>());\n383\t    }\n384\t\n385\t    data = len.wrapping_s