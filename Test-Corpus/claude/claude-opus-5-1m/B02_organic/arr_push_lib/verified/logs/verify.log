.is_null() {\n223\t        stbds_header(a) as *mut c_void\n224\t    } else {\n225\t        ptr::null_mut()\n226\t    };\n227\t\n228\t    let raw = realloc(\n229\t        old,\n230\t        elemsize.wrapping_mul(min_cap).wrapping_add(HDR_SIZE),\n231\t    );\n232\t    let b = byte_add(raw, HDR_SIZE);\n233\t    if a.is_null() {\n234\t        (*stbds_header(b)).length = 0;\n235\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n236\t        (*stbds_header(b)).temp = 0;\n237\t    }\n238\t    (*stbds_header(b)).capacity = min_cap;\n239\t\n240\t    b\n241\t}\n242\t\n243\t#[unsafe(no_mangle)]\n244\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n245\t    free(stbds_header(a) as *mut c_void);\n246\t}\n247\t\n248\t// ---------------------------------------------------------------------------\n249\t// Hashing\n250\t// ---------------------------------------------------------------------------\n251\t\n252\tstatic STBDS_HASH_SEED: AtomicUsize = AtomicUsize::new(0x31415926);\n253\t\n254\t#[inline(always)]\n255\tfn hash_seed_get() -> usize {\n256\t    STBDS_HASH_SEED.load(Ordering::Relaxed)\n257\t}\n258\t\n259\t#[inline(always)]\n260\tfn hash_seed_set(v: usize) {\n261\t    STBDS_HASH_SEED.store(v, Ordering::Relaxed);\n262\t}\n263\t\n264\t#[unsafe(no_mangle)]\n265\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n266\t    hash_seed_set(seed);\n267\t}\n268\t\n269\t#[inline(always)]\n270\tfn rotl(val: usize, n: u32) -> usize {\n271\t    // ((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n)))\n272\t    (val.wrapping_shl(n)) | (val.wrapping_shr(STBDS_SIZE_T_BITS - n))\n273\t}\n274\t\n275\t#[inline(always)]\n276\tfn rotr(val: usize, n: u32) -> usize {\n277\t    // ((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n)))\n278\t    (val.wrapping_shr(n)) | (val.wrapping_shl(STBDS_SIZE_T_BITS - n))\n279\t}\n280\t\n281\t#[inline(always)]\n282\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n283\t    hash & (slot_count.wrapping_sub(1))\n284\t}\n285\t\n286\tfn stbds_log2(slot_count: usize) -> usize {\n287\t    let mut slot_count = slot_count;\n288\t    let mut n: usize = 0;\n289\t    while slot_count > 1 {\n290\t        slot_count >>= 1;\n291\t        n += 1;\n292\t    }\n293\t    n\n294\t}\n295\t\n296\t#[unsafe(no_mangle)]\n297\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n298\t    let mut hash = seed;\n299\t    let mut s = str_ as *const u8;\n300\t    while *s != 0 {\n301\t        hash = rotl(hash, 9).wrapping_add(*s as usize);\n302\t        s = s.wrapping_add(1);\n303\t    }\n304\t\n305\t    hash ^= seed;\n306\t    hash = (!hash).wrapping_add(hash.wrapping_shl(18));\n307\t    hash = hash ^ (hash ^ rotr(hash, 31));\n308\t    hash = hash.wrapping_mul(21);\n309\t    hash = hash ^ (hash ^ rotr(hash, 11));\n310\t    hash = hash.wrapping_add(hash.wrapping_shl(6));\n311\t    hash ^= rotr(hash, 22);\n312\t    hash.wrapping_add(seed)\n313\t}\n314\t\n315\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n316\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n317\t\n318\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n319\t    let mut d = p as *const u8;\n320\t    let mut v0: usize;\n321\t    let mut v1: usize;\n322\t    let mut v2: usize;\n323\t    let mut v3: usize;\n324\t    let mut data: usize;\n325\t\n326\t    v0 = ((0x736f6d65usize << 16 << 16).wrapping_add(0x70736575)) ^ seed;\n327\t    v1 = ((0x646f7261usize << 16 << 16).wrapping_add(0x6e646f6d)) ^ !seed;\n328\t    v2 = ((0x6c796765usize << 16 << 16).wrapping_add(0x6e657261)) ^ seed;\n329\t    v3 = ((0x74656462usize << 16 << 16).wrapping_add(0x79746573)) ^ !seed;\n330\t\n331\t    v0 ^= 0x0706050403020100usize ^ seed;\n332\t    v1 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n333\t    v2 ^= 0x0706050403020100usize ^ seed;\n334\t    v3 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n335\t\n336\t    macro_rules! siproundf {\n337\t        () => {{\n338\t            v0 = v0.wrapping_add(v1);\n339\t            v1 = rotl(v1, 13);\n340\t            v1 ^= v0;\n341\t            v0 = rotl(v0, STBDS_SIZE_T_BITS / 2);\n342\t            v2 = v2.wrapping_add(v3);\n343\t            v3 = rotl(v3, 16);\n344\t            v3 ^= v2;\n345\t            v2 = v2.wrapping_add(v1);\n346\t            v1 = rotl(v1, 17);\n347\t            v1 ^= v2;\n348\t            v2 = rotl(v2, STBDS_SIZE_T_BITS / 2);\n349\t            v0 = v0.wrapping_add(v3);\n350\t            v3 = rotl(v3, 21);\n351\t            v3 ^= v0;\n352\t        }};\n353\t    }\n354\t\n355\t    let mut i: usize = 0;\n356\t    while i + core::mem::size_of::<usize>() <= len {\n357\t        // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n358\t        //\n359\t        // NOTE: in C these are `int` expressions; `d[3] << 24` can set the sign\n360\t        // bit, and the resulting negative `int` is then sign-extended when\n361\t        // stored into the `size_t` `data`.  That quirk is part of the observable\n362\t        // behaviour, so it is reproduced here.\n363\t        let lo: i32 = (*d.wrapping_add(0) as i32)\n364\t            | ((*d.wrapping_add(1) as i32).wrapping_shl(8))\n365\t            | ((*d.wrapping_add(2) as i32).wrapping_shl(16))\n366\t            | ((*d.wrapping_add(3) as i32).wrapping_shl(24));\n367\t        data = lo as isize as usize;\n368\t\n369\t        let hi: i32 = (*d.wrapping_add(4) as i32)\n370\t            | ((*d.wrapping_add(5) as i32).wrapping_shl(8))\n371\t            | ((*d.wrapping_add(6) as i32).wrapping_shl(16))\n372\t            | ((*d.wrapping_add(7) as i32).wrapping_shl(24));\n373\t        data |= (hi as isize as usize).wrapping_shl(16).wrapping_shl(16);\n374\t\n375\t        v3 ^= data;\n376\t        for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n377\t            siproundf!();\n378\t        }\n379\t        v0 ^= data;\n380\t\n381\t        i += core::mem::size_of::<usize>();\n382\t        d = d.wrapping_add(core::mem::size_of::<usize>());\n383\t    }\n384\t\n385\t    data = len.wrapping_shl(STBDS_SIZE_T_BITS - 8);\n386\t    // switch (len - i) with fall-through from 7 down to 1\n387\t    let rem = len.wrapping_sub(i);\n388\t    if rem >= 7 {\n389\t        data |= ((*d.wrapping_add(6) as usize).wrapping_shl(24)).wrapping_shl(24);\n390\t    }\n391\t    if rem >= 6 {\n392\t        data |= ((*d.wrapping_add(5) as usize).wrapping_shl(20)).wrapping_shl(20);\n393\t    }\n394\t    if rem >= 5 {\n395\t        data |= ((*d.wrapping_add(4) as usize).wrapping_shl(16)).wrapping_shl(16);\n396\t    }\n397\t    if rem >= 4 {\n398\t        data |= ((*d.wrapping_add(3) as i32).wrapping_shl(24)) as isize as usize;\n399\t    }\n400\t    if rem >= 3 {\n401\t        data |= ((*d.wrapping_add(2) as i32).wrapping_shl(16)) as isize as usize;\n402\t    }\n403\t    if rem >= 2 {\n404\t        data |= ((*d.wrapping_add(1) as i32).wrapping_shl(8)) as isize as usize;\n405\t    }\n406\t    if rem >= 1 {\n407\t        data |= *d.wrapping_add(0) as usize;\n408\t    }\n409\t\n410\t    v3 ^= data;\n411\t    for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n412\t        siproundf!();\n413\t    }\n414\t    v0 ^= data;\n415\t    v2 ^= 0xff;\n416\t    for _ in 0..STBDS_SIPHASH_D_ROUNDS {\n417\t        siproundf!();\n418\t    }\n419\t\n420\t    v0 ^ v1 ^ v2 ^ v3\n421\t}\n422\t\n423\t#[unsafe(no_mangle)]\n424\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n425\t    stbds_siphash_bytes(p, len, seed)\n426\t}\n427\t\n428\t// ---------------------------------------------------------------------------\n429\t// Hash index\n430\t// ---------------------------------------------------------------------------\n431\t\n432\t#[inline(always)]\n433\tfn align_fwd(n: usize, a: usize) -> usize {\n434\t    (n.wrapping_add(a).wrapping_sub(1)) & !(a.wrapping_sub(1))\n435\t}\n436\t\n437\t/// `stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)`\n438\t#[inline(always)]\n439\tfn load_32_or_64(v32: usize, v64_hi: usize, v64_lo: usize) -> usize {\n440\t    let mut temp: usize = v64_lo ^ v32;\n441\t    temp = temp.wrapping_shl(16);\n442\t    temp = temp.wrapping_shl(16);\n443\t    temp = temp.wrapping_shr(16);\n444\t    temp = temp.wrapping_shr(16);\n445\t    let mut var: usize = v64_hi;\n446\t    var = var.wrapping_shl(16);\n447\t    var = var.wrapping_shl(16);\n448\t    var ^= temp ^ v32;\n449\t    var\n450\t}\n451\t\n452\tunsafe fn stbds_make_hash_index(\n453\t    slot_count: usize,\n454\t    ot: *mut stbds_hash_index,\n455\t) -> *mut stbds_hash_index {\n456\t    let t = realloc(\n457\t        ptr::null_mut(),\n458\t        (slot_count >> STBDS_BUCKET_SHIFT)\n459\t            .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n460\t            .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n461\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n462\t    ) as *mut stbds_hash_index;\n463\t\n464\t    (*t).storage = align_fwd(t.wrapping_add(1) as usize, STBDS_CACHE_LINE_SIZE)\n465\t        as *mut stbds_hash_bucket;\n466\t    (*t).slot_count = slot_count;\n467\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n468\t    (*t).tombstone_count = 0;\n469\t    (*t).used_count = 0;\n470\t\n471\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n472\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n473\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n474\t\n475\t    if slot_count <= STBDS_BUCKET_LENGTH {\n476\t        (*t).used_count_shrink_threshold = 0;\n477\t    }\n478\t    stbds_assert(\n479\t        (*t).used_count_threshold.wrapping_add((*t).tombstone_count_threshold) < (*t).slot_count,\n480\t    );\n481\t\n482\t    if !ot.is_null() {\n483\t        (*t).string = (*ot).string;\n484\t        (*t).seed = (*ot).seed;\n485\t    } else {\n486\t        memset(\n487\t            ptr::addr_of_mut!((*t).string) as *mut c_void,\n488\t            0,\n489\t            core::mem::size_of::<stbds_string_arena>(),\n490\t        );\n491\t        (*t).seed = hash_seed_get();\n492\t        let a = load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n493\t        let b = load_32_or_64(715136305, 0, 0xb504f32d);\n494\t        hash_seed_set(hash_seed_get().wrapping_mul(a).wrapping_add(b));\n495\t    }\n496\t\n497\t    {\n498\t        let mut i: usize = 0;\n499\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n500\t            let b = (*t).storage.wrapping_add(i);\n501\t            for j in 0..STBDS_BUCKET_LENGTH {\n502\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n503\t            }\n504\t            for j in 0..STBDS_BUCKET_LENGTH {\n505\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n506\t            }\n507\t            i += 1;\n508\t        }\n509\t    }\n510\t\n511\t    if !ot.is_null() {\n512\t        (*t).used_count = (*ot).used_count;\n513\t        let mut i: usize = 0;\n514\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n515\t            let ob = (*ot).storage.wrapping_add(i);\n516\t            for j in 0..STBDS_BUCKET_LENGTH {\n517\t                if (*ob).index[j] >= 0 {\n518\t                    let hash = (*ob).hash[j];\n519\t                    let mut pos =\n520\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n521\t                    let mut step = STBDS_BUCKET_LENGTH;\n522\t                    'done: loop {\n523\t                        let bucket = (*t).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n524\t\n525\t                        let mut z = pos & STBDS_BUCKET_MASK;\n526\t                        while z < STBDS_BUCKET_LENGTH {\n527\t                            if (*bucket).hash[z] == 0 {\n528\t                                (*bucket).hash[z] = hash;\n529\t                                (*bucket).index[z] = (*ob).index[j];\n530\t                                break 'done;\n531\t                            }\n532\t                            z += 1;\n533\t                        }\n534\t\n535\t                        let limit = pos & STBDS_BUCKET_MASK;\n536\t                        let mut z = 0usize;\n537\t                        while z < limit {\n538\t                            if (*bucket).hash[z] == 0 {\n539\t                                (*bucket).hash[z] = hash;\n540\t                                (*bucket).index[z] = (*ob).index[j];\n541\t                                break 'done;\n542\t                            }\n543\t                            z += 1;\n544\t                        }\n545\t\n546\t                        pos = pos.wrapping_add(step);\n547\t                        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n548\t                        pos &= (*t).slot_count.wrapping_sub(1);\n549\t                    }\n550\t                }\n551\t            }\n552\t            i += 1;\n553\t        }\n554\t    }\n555\t\n556\t    t\n557\t}\n558\t\n559\tunsafe fn stbds_is_key_equal(\n560\t    a: *mut c_void,\n561\t    elemsize: usize,\n562\t    key: *mut c_void,\n563\t    keysize: usize,\n564\t    keyoffset: usize,\n565\t    mode: c_int,\n566\t    i: usize,\n567\t) -> bool {\n568\t    if mode >= STBDS_HM_STRING {\n569\t        let slot = byte_add(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset)) as *mut *mut c_char;\n570\t        0 == strcmp(key as *const c_char, *slot)\n571\t    } else {\n572\t        0 == memcmp(\n573\t            key as *const c_void,\n574\t            byte_add(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset)) as *const c_void,\n575\t            keysize,\n576\t        )\n577\t    }\n578\t}\n579\t\n580\t#[unsafe(no_mangle)]\n581\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n582\t    if a.is_null() {\n583\t        return;\n584\t    }\n585\t    if !stbds_hash_table(a).is_null() {\n586\t        if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP {\n587\t            let mut i: usize = 1;\n588\t            while i < (*stbds_header(a)).length {\n589\t                let slot = byte_add(a, elemsize.wrapping_mul(i)) as *mut *mut c_char;\n590\t                free(*slot as *mut c_void);\n591\t                i += 1;\n592\t            }\n593\t        }\n594\t        stbds_strreset(ptr::addr_of_mut!((*stbds_hash_table(a)).string));\n595\t    }\n596\t    free((*stbds_header(a)).hash_table);\n597\t    free(stbds_header(a) as *mut c_void);\n598\t}\n599\t\n600\tunsafe fn stbds_hm_find_slot(\n601\t    a: *mut c_void,\n602\t    elemsize: usize,\n603\t    key: *mut c_void,\n604\t    keysize: usize,\n605\t    keyoffset: usize,\n606\t    mode: c_int,\n607\t) -> isize {\n608\t    let raw_a = hash_to_arr(a, elemsize);\n609\t    let table = stbds_hash_table(raw_a);\n610\t    let mut hash = if mode >= STBDS_HM_STRING {\n611\t        stbds_hash_string(key as *mut c_char, (*table).seed)\n612\t    } else {\n613\t        stbds_hash_bytes(key, keysize, (*table).seed)\n614\t    };\n615\t    let mut step = STBDS_BUCKET_LENGTH;\n616\t\n617\t    if hash < 2 {\n618\t        hash = hash.wrapping_add(2);\n619\t    }\n620\t\n621\t    let mut pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n622\t\n623\t    loop {\n624\t        let bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n625\t\n626\t        let mut i = pos & STBDS_BUCKET_MASK;\n627\t        while i < STBDS_BUCKET_LENGTH {\n628\t            if (*bucket).hash[i] == hash {\n629\t                if stbds_is_key_equal(\n630\t                    a,\n631\t                    elemsize,\n632\t                    key,\n633\t                    keysize,\n634\t                    keyoffset,\n635\t                    mode,\n636\t                    (*bucket).index[i] as usize,\n637\t                ) {\n638\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n639\t                }\n640\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n641\t                return -1;\n642\t            }\n643\t            i += 1;\n644\t        }\n645\t\n646\t        let limit = pos & STBDS_BUCKET_MASK;\n647\t        let mut i = 0usize;\n648\t        while i < limit {\n649\t            if (*bucket).hash[i] == hash {\n650\t                if stbds_is_key_equal(\n651\t                    a,\n652\t                    elemsize,\n653\t                    key,\n654\t                    keysize,\n655\t                    keyoffset,\n656\t                    mode,\n657\t                    (*bucket).index[i] as usize,\n658\t                ) {\n659\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n660\t                }\n661\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n662\t                return -1;\n663\t            }\n664\t            i += 1;\n665\t        }\n666\t\n667\t        pos = pos.wrapping_add(step);\n668\t        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n669\t        pos &= (*table).slot_count.wrapping_sub(1);\n670\t    }\n671\t}\n672\t\n673\t#[unsafe(no_mangle)]\n674\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n675\t    a: *mut c_void,\n676\t    elemsize: usize,\n677\t    key: *mut c_void,\n678\t    keysize: usize,\n679\t    temp: *mut isize,\n680\t    mode: c_int,\n681\t) -> *mut c_void {\n682\t    let keyoffset: usize = 0;\n683\t    if a.is_null() {\n684\t        let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n685\t        (*stbds_header(a)).length += 1;\n686\t        memset(a, 0, elemsize);\n687\t        *temp = STBDS_INDEX_EMPTY;\n688\t        arr_to_hash(a, elemsize)\n689\t    } else {\n690\t        let raw_a = hash_to_arr(a, elemsize);\n691\t        let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n692\t        if table.is_null() {\n693\t            *temp = -1;\n694\t        } else {\n695\t            let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n696\t            if slot < 0 {\n697\t                *temp = STBDS_INDEX_EMPTY;\n698\t            } else {\n699\t                let b = (*table)\n700\t                