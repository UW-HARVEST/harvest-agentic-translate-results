{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_voos6mnno2sd7kxlnw52uufd363mizfzjmg3ypekgtmww6zsi7la","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Ssk439swHNWbBn7rR5CVsA","name":"Bash","input":{"command":"cd $TMPDIR && cat >> driver.c <<'EOF'\n\n/* ================= differential test driver ================= */\n#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct { int key; int value; } kv_int;\ntypedef struct { long long key; long long value; } kv_ll;\ntypedef struct { char *key; int value; } kv_str;\ntypedef struct { int key[2]; int b,c,d; } s2;\n\nextern char *strkey(int n);\n\nstatic void test_hash(void)\n{\n  unsigned char buf[80];\n  size_t len;\n  int i, s;\n  const char *strs[7];\n  for (i=0;i<80;i++) buf[i] = (unsigned char)(i*37+13);\n  for (len=0; len<=48; ++len)\n    printf(\"hb %zu %zu\\n\", len, stbds_hash_bytes(buf, len, (size_t)0xdeadbeefULL));\n  {\n    unsigned char hi[24];\n    memset(hi, 0xff, sizeof hi);\n    for (len=0; len<=24; ++len)\n      printf(\"hbff %zu %zu\\n\", len, stbds_hash_bytes(hi, len, 12345));\n  }\n  {\n    unsigned char mix[16];\n    for (i=0;i<16;i++) mix[i] = (unsigned char)(i%2 ? 0x80|i : i);\n    for (len=0; len<=16; ++len)\n      printf(\"hbmix %zu %zu\\n\", len, stbds_hash_bytes(mix, len, 0));\n  }\n  for (s=0;s<6;s++)\n    printf(\"hbs %d %zu\\n\", s, stbds_hash_bytes(buf, 17, (size_t)s*0x9e3779b97f4a7c15ULL));\n  strs[0]=\"\"; strs[1]=\"a\"; strs[2]=\"ab\"; strs[3]=\"hello world\";\n  strs[4]=\"test_12345\"; strs[5]=\"\\xff\\xfe\\x80 high\"; strs[6]=\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\";\n  for (i=0;i<7;i++)\n    printf(\"hs %d %zu %zu\\n\", i, stbds_hash_string((char*)strs[i], 0), stbds_hash_string((char*)strs[i], (size_t)0x31415926));\n  stbds_rand_seed(0xabcdef01);\n  for (i=0;i<3;i++) printf(\"hs2 %d %zu\\n\", i, stbds_hash_string((char*)strs[3], (size_t)i));\n  stbds_rand_seed(0x31415926);\n}\n\nstatic void test_arr(void)\n{\n  int *a = NULL;\n  int i;\n  printf(\"arr len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  for (i=0;i<300;i++) {\n    arrpush(a, i*7);\n    if (i < 20 || i % 37 == 0)\n      printf(\"arr push %d len=%td cap=%zu last=%d\\n\", i, arrlen(a), arrcap(a), arrlast(a));\n  }\n  printf(\"arr pop=%d len=%td\\n\", arrpop(a), arrlen(a));\n  arrdel(a, 5);\n  printf(\"arr after del a[5]=%d len=%td\\n\", a[5], arrlen(a));\n  arrdeln(a, 10, 7);\n  printf(\"arr after deln a[10]=%d len=%td\\n\", a[10], arrlen(a));\n  arrins(a, 3, 12345);\n  printf(\"arr after ins a[3]=%d a[4]=%d len=%td\\n\", a[3], a[4], arrlen(a));\n  arrinsn(a, 8, 4);\n  printf(\"arr after insn len=%td a[8]=%d a[12]=%d\\n\", arrlen(a), a[8], a[12]);\n  arrdelswap(a, 2);\n  printf(\"arr after delswap a[2]=%d len=%td\\n\", a[2], arrlen(a));\n  arrsetcap(a, 4096);\n  printf(\"arr setcap cap=%zu len=%td\\n\", arrcap(a), arrlen(a));\n  arrsetlen(a, 1000);\n  printf(\"arr setlen cap=%zu len=%td\\n\", arrcap(a), arrlen(a));\n  {\n    int *p = arraddnptr(a, 10);\n    ptrdiff_t idx = p - a;\n    printf(\"arr addnptr idx=%td len=%td cap=%zu\\n\", idx, arrlen(a), arrcap(a));\n  }\n  printf(\"arr addnindex=%td\\n\", (ptrdiff_t)arraddnindex(a, 3));\n  for (i=0;i<20;i++) printf(\"arr[%d]=%d\\n\", i, a[i]);\n  arrfree(a);\n  printf(\"arr freed len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n\n  /* direct arrgrowf exercise */\n  {\n    void *g = stbds_arrgrowf(0, 8, 0, 1);\n    printf(\"growf cap=%zu len=%zu\\n\", stbds_arrcap(g), stbds_arrlen(g));\n    g = stbds_arrgrowf(g, 8, 5, 0);\n    printf(\"growf2 cap=%zu\\n\", stbds_arrcap(g));\n    g = stbds_arrgrowf(g, 8, 0, 100);\n    printf(\"growf3 cap=%zu\\n\", stbds_arrcap(g));\n    g = stbds_arrgrowf(g, 8, 0, 3);\n    printf(\"growf4 cap=%zu\\n\", stbds_arrcap(g));\n    stbds_arrfreef(g);\n  }\n}\n\nstatic void test_hmap_int(int n)\n{\n  kv_int *t = NULL;\n  int i;\n  printf(\"hm empty len=%td\\n\", hmlen(t));\n  for (i=0;i<n;i++) hmput(t, i, i*3+1);\n  printf(\"hm len=%td\\n\", hmlen(t));\n  for (i=-3;i<n+3;i+=7) printf(\"hm get %d -> %d (i=%td)\\n\", i, hmget(t,i), hmgeti(t,i));\n  /* full array order dump: depends on internal hashing */\n  for (i=0;i<hmlen(t);i++) printf(\"hm[%d] %d=%d\\n\", i, t[i].key, t[i].value);\n  /* overwrite */\n  for (i=0;i<n;i+=3) hmput(t, i, -i);\n  printf(\"hm len after overwrite=%td\\n\", hmlen(t));\n  /* delete */\n  for (i=0;i<n;i+=2) printf(\"hm del %d -> %td\\n\", i, (ptrdiff_t)hmdel(t,i));\n  printf(\"hm len after del=%td\\n\", hmlen(t));\n  for (i=0;i<hmlen(t);i++) printf(\"hmd[%d] %d=%d\\n\", i, t[i].key, t[i].value);\n  for (i=0;i<n;i++) printf(\"hm geti %d -> %td\\n\", i, hmgeti(t,i));\n  {\n    ptrdiff_t tmp;\n    for (i=0;i<n;i+=5) printf(\"hm gets_ts %d -> %td\\n\", i, (hmgeti_ts(t,i,tmp), tmp));\n  }\n  hmdefault(t, -999);\n  printf(\"hm default missing=%d\\n\", hmget(t, 1234567));\n  printf(\"hm getp_null missing=%d\\n\", hmgetp_null(t, 1234567) == NULL);\n  /* reinsert */\n  for (i=0;i<n;i+=2) hmput(t, i, i*11);\n  printf(\"hm len after reinsert=%td\\n\", hmlen(t));\n  for (i=0;i<hmlen(t);i++) printf(\"hmr[%d] %d=%d\\n\", i, t[i].key, t[i].value);\n  hmfree(t);\n  printf(\"hm freed len=%td\\n\", hmlen(t));\n}\n\nstatic void test_hmap_ll(void)\n{\n  kv_ll *t = NULL;\n  long long i;\n  for (i=0;i<200;i++) hmput(t, i*0x100000001LL, i);\n  printf(\"hmll len=%td\\n\", hmlen(t));\n  for (i=0;i<200;i+=13) printf(\"hmll get %lld -> %lld\\n\", i, hmget(t, i*0x100000001LL));\n  for (i=0;i<hmlen(t);i++) printf(\"hmll[%lld] %lld=%lld\\n\", i, t[i].key, t[i].value);\n  hmfree(t);\n}\n\nstatic void test_struct_keys(void)\n{\n  s2 *t = NULL;\n  int i;\n  for (i=0;i<100;i++) {\n    s2 s;\n    memset(&s, 0, sizeof s);\n    s.key[0]=i; s.key[1]=i*i; s.b=i+1; s.c=i+2; s.d=i+3;\n    hmputs(t, s);\n  }\n  printf(\"s2 len=%td\\n\", hmlen(t));\n  for (i=0;i<100;i+=9) {\n    s2 k; memset(&k,0,sizeof k);\n    k.key[0]=i; k.key[1]=i*i;\n    printf(\"s2 get %d -> %td %d\\n\", i, hmgeti(t,k.key), hmgets(t,k.key).b);\n  }\n  for (i=0;i<hmlen(t);i++) printf(\"s2[%d] %d,%d b=%d\\n\", i, t[i].key[0], t[i].key[1], t[i].b);\n  for (i=0;i<100;i+=2) {\n    s2 k; memset(&k,0,sizeof k);\n    k.key[0]=i; k.key[1]=i*i;\n    hmdel(t, k.key);\n  }\n  printf(\"s2 len after del=%td\\n\", hmlen(t));\n  for (i=0;i<hmlen(t);i++) printf(\"s2d[%d] %d,%d b=%d\\n\", i, t[i].key[0], t[i].key[1], t[i].b);\n  hmfree(t);\n}\n\nstatic char *keys_storage[600];\n\nstatic void test_shmap(int mode, int n)\n{\n  kv_str *t = NULL;\n  int i;\n  if (mode == 1) sh_new_strdup(t);\n  else if (mode == 2) sh_new_arena(t);\n  for (i=0;i<n;i++) {\n    char *k = strkey(i);\n    if (mode == 0) { keys_storage[i] = strdup(k); k = keys_storage[i]; }\n    shput(t, k, i*5);\n  }\n  printf(\"sh(%d) len=%td\\n\", mode, shlen(t));\n  for (i=0;i<n;i+=3) printf(\"sh(%d) get %s -> %d i=%td\\n\", mode, strkey(i), shget(t, strkey(i)), shgeti(t, strkey(i)));\n  printf(\"sh(%d) missing i=%td null=%d\\n\", mode, shgeti(t, \"nope\"), shgetp_null(t,\"nope\")==NULL);\n  for (i=0;i<shlen(t);i++) printf(\"sh(%d)[%d] %s=%d\\n\", mode, i, t[i].key, t[i].value);\n  for (i=0;i<n;i+=2) printf(\"sh(%d) del %s -> %td\\n\", mode, strkey(i), (ptrdiff_t)shdel(t, strkey(i)));\n  printf(\"sh(%d) len after del=%td\\n\", mode, shlen(t));\n  for (i=0;i<shlen(t);i++) printf(\"sh(%d)d[%d] %s=%d\\n\", mode, i, t[i].key, t[i].value);\n  for (i=0;i<n;i++) printf(\"sh(%d) geti %s -> %td\\n\", mode, strkey(i), shgeti(t, strkey(i)));\n  {\n    kv_str s;\n    s.key = strkey(999); s.value = 777;\n    if (mode == 0) { keys_storage[500] = strdup(s.key); s.key = keys_storage[500]; }\n    shputs(t, s);\n    printf(\"sh(%d) shputs %s=%d len=%td\\n\", mode, t[shgeti(t,strkey(999))].key, shget(t, strkey(999)), shlen(t));\n  }\n  shdefault(t, -42);\n  printf(\"sh(%d) default=%d\\n\", mode, shget(t, \"absent\"));\n  for (i=0;i<n;i+=2) {\n    char *k = strkey(i);\n    if (mode == 0) { keys_storage[i] = strdup(k); k = keys_storage[i]; }\n    shputi(t, k, i*100);\n  }\n  printf(\"sh(%d) len after reput=%td\\n\", mode, shlen(t));\n  for (i=0;i<shlen(t);i++) printf(\"sh(%d)r[%d] %s=%d\\n\", mode, i, t[i].key, t[i].value);\n  shfree(t);\n  printf(\"sh(%d) freed len=%td\\n\", mode, shlen(t));\n}\n\nstatic void test_arena(void)\n{\n  stbds_string_arena a;\n  char *p[40];\n  int i;\n  memset(&a, 0, sizeof a);\n  for (i=0;i<40;i++) {\n    char tmp[300];\n    int L = (i*i*3) % 250;\n    memset(tmp, 'a'+(i%26), L);\n    tmp[L] = 0;\n    p[i] = stbds_stralloc(&a, tmp);\n    printf(\"arena %d len=%d strcmp=%d remaining=%zu block=%d\\n\", i, L, strcmp(p[i], tmp), a.remaining, a.block);\n  }\n  stbds_strreset(&a);\n  printf(\"arena reset remaining=%zu block=%d mode=%d storage_null=%d\\n\", a.remaining, a.block, a.mode, a.storage==NULL);\n}\n\nstatic void test_misc(void)\n{\n  int i;\n  for (i=-5;i<5;i++) printf(\"strkey %d = %s\\n\", i, strkey(i));\n  printf(\"strkey big = %s\\n\", strkey(2147483647));\n  printf(\"strkey min = %s\\n\", strkey(-2147483647-1));\n  arr_push(1000);\n  printf(\"arr_push done\\n\");\n  arr_push(0);\n  arr_push(1);\n  arr_push(51);\n  printf(\"arr_push edge done\\n\");\n  {\n    kv_int *t = NULL;\n    hmdefault(t, 5);\n    printf(\"hmput_default len=%td get=%d\\n\", hmlen(t), hmget(t, 42));\n    hmfree(t);\n  }\n  {\n    kv_int *t = NULL;\n    printf(\"hmdel on null = %td\\n\", (ptrdiff_t)hmdel(t, 3));\n    printf(\"t null = %d\\n\", t == NULL);\n  }\n  {\n    /* get on empty (no table) map */\n    kv_int *t = NULL;\n    printf(\"hmgeti empty = %td\\n\", hmgeti(t, 7));\n    printf(\"hmlen after get = %td\\n\", hmlen(t));\n    hmfree(t);\n  }\n}\n\nint main(void)\n{\n  test_hash();\n  test_arr();\n  test_hmap_int(700);\n  test_hmap_ll();\n  test_struct_keys();\n  test_shmap(0, 200);\n  test_shmap(1, 200);\n  test_shmap(2, 200);\n  test_arena();\n  test_misc();\n  test_hmap_int(9);\n  test_hash();\n  return 0;\n}\nEOF\nwc -l driver.c","description":"Append differential test driver code"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usa