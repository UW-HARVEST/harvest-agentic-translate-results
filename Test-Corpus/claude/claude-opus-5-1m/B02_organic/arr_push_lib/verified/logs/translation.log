n NULL then again */\n  {\n    void *p = stbds_hmput_default(NULL, sizeof(kv));\n    kv *t = (kv*)p;\n    printf(\"dflt len=%zu key=%d val=%d\\n\", HDR((char*)p-sizeof(kv))->length, t[-1].key, t[-1].value);\n    t[-1].value = 42;\n    p = stbds_hmput_default(p, sizeof(kv));\n    printf(\"dflt2 len=%zu val=%d\\n\", HDR((char*)p-sizeof(kv))->length, ((kv*)p)[-1].value);\n    stbds_hmfree_func((char*)p-sizeof(kv), sizeof(kv));\n  }\n  /* hmdel_key on NULL */\n  printf(\"del null=%d\\n\", stbds_hmdel_key(NULL, sizeof(kv), &i, sizeof(int), 0, 0)==NULL);\n  /* shmode_func for every mode */\n  for (mode = 0; mode <= 3; ++mode) {\n    sv *t = (sv*)stbds_shmode_func(sizeof(sv), mode);\n    for (i = 0; i < 60; ++i) {\n      char *k = strkey(i);\n      char *kk = (mode==1 /*DEFAULT: no copy*/) ? strdup(k) : k;\n      t = (sv*)stbds_hmput_key(t, sizeof(sv), kk, sizeof(char*), 1);\n      t[HDR((char*)t-sizeof(sv))->temp].value = i * 3;\n    }\n    printf(\"mode %d len=%zu\\n\", mode, HDR((char*)t-sizeof(sv))->length);\n    for (i = 0; i < 60; i += 7) {\n      t = (sv*)stbds_hmget_key(t, sizeof(sv), strkey(i), sizeof(char*), 1);\n      printf(\"  mode %d get %d -> %td\\n\", mode, i, HDR((char*)t-sizeof(sv))->temp);\n    }\n    for (i = 1; (size_t)i < HDR((char*)t-sizeof(sv))->length; ++i)\n      printf(\"  mode %d [%d] %s=%d\\n\", mode, i, t[i-1].key, t[i-1].value);\n    for (i = 0; i < 60; i += 3)\n      t = (sv*)stbds_hmdel_key(t, sizeof(sv), strkey(i), sizeof(char*), 0, 1);\n    printf(\"mode %d len after del=%zu\\n\", mode, HDR((char*)t-sizeof(sv))->length);\n    for (i = 1; (size_t)i < HDR((char*)t-sizeof(sv))->length; ++i)\n      printf(\"  mode %d d[%d] %s=%d\\n\", mode, i, t[i-1].key, t[i-1].value);\n    stbds_hmfree_func((char*)t-sizeof(sv), sizeof(sv));\n  }\n  /* binary mode with keysize 0 and mode>1 */\n  {\n    sv *t = (sv*)stbds_shmode_func(sizeof(sv), 2);\n    for (i = 0; i < 20; ++i) {\n      t = (sv*)stbds_hmput_key(t, sizeof(sv), strkey(i), sizeof(char*), 5 /* mode > STRING */);\n      t[HDR((char*)t-sizeof(sv))->temp].value = i;\n    }\n    printf(\"mode5 len=%zu\\n\", HDR((char*)t-sizeof(sv))->length);\n    for (i = 0; i < 20; ++i) {\n      t = (sv*)stbds_hmget_key(t, sizeof(sv), strkey(i), sizeof(char*), 5);\n      printf(\"  mode5 get %d -> %td\\n\", i, HDR((char*)t-sizeof(sv))->temp);\n    }\n    stbds_hmfree_func((char*)t-sizeof(sv), sizeof(sv));\n  }\n  /* rand_seed influence: seeds affect table hashing */\n  for (i = 0; i < 4; ++i) {\n    kv *t;\n    int j;\n    stbds_rand_seed((size_t)i * 0x1234567 + 1);\n    t = NULL;\n    for (j = 0; j < 30; ++j) {\n      t = (kv*)stbds_hmput_key(t, sizeof(kv), &j, sizeof(int), 0);\n      t[HDR((char*)t-sizeof(kv))->temp].key = j;\n      t[HDR((char*)t-sizeof(kv))->temp].value = j*j;\n    }\n    printf(\"seed %d order:\", i);\n    for (j = 1; (size_t)j < HDR((char*)t-sizeof(kv))->length; ++j) printf(\" %d\", t[j-1].key);\n    printf(\"\\n\");\n    stbds_hmfree_func((char*)t-sizeof(kv), sizeof(kv));\n  }\n  /* arrgrowf odd sizes */\n  for (i = 0; i < 6; ++i) {\n    void *g = stbds_arrgrowf(NULL, (size_t)1 << i, (size_t)i, 0);\n    printf(\"g%d cap=%zu len=%zu\\n\", i, HDR(g)->capacity, HDR(g)->length);\n    g = stbds_arrgrowf(g, (size_t)1 << i, 1000, 0);\n    printf(\"g%d b cap=%zu\\n\", i, HDR(g)->capacity);\n    stbds_arrfreef(g);\n  }\n  /* hmfree_func(NULL) */\n  stbds_hmfree_func(NULL, sizeof(kv));\n  printf(\"free null ok\\n\");\n  arr_push(500);\n  printf(\"strkey=%s\\n\", strkey(-1));\n  return 0;\n}\n","structuredPatch":[{"oldStart":53,"oldLines":8,"newStart":53,"newLines":31,"lines":["   }","   /* hmdel_key on NULL */","   printf(\"del null=%d\\n\", stbds_hmdel_key(NULL, sizeof(kv), &i, sizeof(int), 0, 0)==NULL);","-  /* shmode_func for every mode */","-  for (mode = 0; mode <= 3; ++mode) {","+  /* binary keys in a table created by shmode_func(mode=0) */","+  {","+    kv *t = (kv*)stbds_shmode_func(sizeof(kv), 0);","+    int j;","+    for (j = 0; j < 40; ++j) {","+     