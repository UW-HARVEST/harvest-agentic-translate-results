= 0;\n337\t    while slot_count > 1 {\n338\t        slot_count >>= 1;\n339\t        n += 1;\n340\t    }\n341\t    n\n342\t}\n343\t\n344\t/// `stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)`\n345\t#[inline]\n346\tfn stbds_load_32_or_64(v32: usize, v64_hi: usize, v64_lo: usize) -> usize {\n347\t    let mut temp: usize = v64_lo ^ v32;\n348\t    temp <<= 16;\n349\t    temp <<= 16;\n350\t    temp >>= 16;\n351\t    temp >>= 16;\n352\t    let mut var: usize = v64_hi;\n353\t    var <<= 16;\n354\t    var <<= 16;\n355\t    var ^= temp ^ v32;\n356\t    var\n357\t}\n358\t\n359\tunsafe fn stbds_make_hash_index(\n360\t    slot_count: usize,\n361\t    ot: *mut stbds_hash_index,\n362\t) -> *mut stbds_hash_index {\n363\t    let t = stbds_realloc(\n364\t        ptr::null_mut(),\n365\t        (slot_count >> STBDS_BUCKET_SHIFT)\n366\t            .wrapping_mul(size_of::<stbds_hash_bucket>())\n367\t            .wrapping_add(size_of::<stbds_hash_index>())\n368\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n369\t    ) as *mut stbds_hash_index;\n370\t    (*t).storage = stbds_align_fwd(t.wrapping_add(1) as usize, STBDS_CACHE_LINE_SIZE)\n371\t        as *mut stbds_hash_bucket;\n372\t    (*t).slot_count = slot_count;\n373\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n374\t    (*t).tombstone_count = 0;\n375\t    (*t).used_count = 0;\n376\t\n377\t    (*t).used_count_threshold = slot_count - (slot_count >> 2);\n378\t    (*t).tombstone_count_threshold = (slot_count >> 3) + (slot_count >> 4);\n379\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n380\t\n381\t    if slot_count <= STBDS_BUCKET_LENGTH {\n382\t        (*t).used_count_shrink_threshold = 0;\n383\t    }\n384\t    STBDS_ASSERT!(\n385\t        (*t).used_count_threshold.wrapping_add((*t).tombstone_count_threshold) < (*t).slot_count\n386\t    );\n387\t\n388\t    if !ot.is_null() {\n389\t        (*t).string = (*ot).string;\n390\t        (*t).seed = (*ot).seed;\n391\t    } else {\n392\t        memset(\n393\t            ptr::addr_of_mut!((*t).string) as *mut c_void,\n394\t            0,\n395\t            size_of::<stbds_string_arena>(),\n396\t        );\n397\t        (*t).seed = hash_seed_get();\n398\t        let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n399\t        let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n400\t        hash_seed_set(hash_seed_get().wrapping_mul(a).wrapping_add(b));\n401\t    }\n402\t\n403\t    {\n404\t        let mut i: usize = 0;\n405\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n406\t            let b = (*t).storage.wrapping_add(i);\n407\t            for j in 0..STBDS_BUCKET_LENGTH {\n408\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n409\t            }\n410\t            for j in 0..STBDS_BUCKET_LENGTH {\n411\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n412\t            }\n413\t            i += 1;\n414\t        }\n415\t    }\n416\t\n417\t    if !ot.is_null() {\n418\t        (*t).used_count = (*ot).used_count;\n419\t        let mut i: usize = 0;\n420\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n421\t            let ob = (*ot).storage.wrapping_add(i);\n422\t            for j in 0..STBDS_BUCKET_LENGTH {\n423\t                if stbds_index_in_use((*ob).index[j]) {\n424\t                    let hash = (*ob).hash[j];\n425\t                    let mut pos =\n426\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n427\t                    let mut step = STBDS_BUCKET_LENGTH;\n428\t                    'done: loop {\n429\t                        let bucket = (*t).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n430\t\n431\t                        let mut z = pos & STBDS_BUCKET_MASK;\n432\t                        while z < STBDS_BUCKET_LENGTH {\n433\t                            if (*bucket).hash[z] == 0 {\n434\t                                (*bucket).hash[z] = hash;\n435\t                                (*bucket).index[z] = (*ob).index[j];\n436\t                                break 'done;\n437\t                            }\n438\t                            z += 1;\n439\t                        }\n440\t\n441\t                        let limit = pos & STBDS_BUCKET_MASK;\n442\t                        let mut z = 0usize;\n443\t                        while z < limit {\n444\t                            if (*bucket).hash[z] == 0 {\n445\t                                (*bucket).hash[z] = hash;\n446\t                                (*bucket).index[z] = (*ob).index[j];\n447\t                                break 'done;\n448\t                            }\n449\t                            z += 1;\n450\t                        }\n451\t\n452\t                        pos = pos.wrapping_add(step);\n453\t                        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n454\t                        pos &= (*t).slot_count - 1;\n455\t                    }\n456\t                }\n457\t            }\n458\t            i += 1;\n459\t        }\n460\t    }\n461\t\n462\t    t\n463\t}\n464\t\n465\t// ---------------------------------------------------------------------------\n466\t// Hash functions\n467\t// ---------------------------------------------------------------------------\n468\t\n469\t#[unsafe(no_mangle)]\n470\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n471\t    let mut hash: usize = seed;\n472\t    let mut s = str_ as *const u8;\n473\t    while *s != 0 {\n474\t        hash = stbds_rotate_left(hash, 9).wrapping_add(*s as usize);\n475\t        s = s.wrapping_add(1);\n476\t    }\n477\t\n478\t    hash ^= seed;\n479\t    hash = (!hash).wrapping_add(hash << 18);\n480\t    hash ^= hash ^ stbds_rotate_right(hash, 31);\n481\t    hash = hash.wrapping_mul(21);\n482\t    hash ^= hash ^ stbds_rotate_right(hash, 11);\n483\t    hash = hash.wrapping_add(hash << 6);\n484\t    hash ^= stbds_rotate_right(hash, 22);\n485\t    hash.wrapping_add(seed)\n486\t}\n487\t\n488\tmacro_rules! STBDS_SIPROUND {\n489\t    ($v0:ident, $v1:ident, $v2:ident, $v3:ident) => {{\n490\t        $v0 = $v0.wrapping_add($v1);\n491\t        $v1 = stbds_rotate_left($v1, 13);\n492\t        $v1 ^= $v0;\n493\t        $v0 = stbds_rotate_left($v0, STBDS_SIZE_T_BITS / 2);\n494\t        $v2 = $v2.wrapping_add($v3);\n495\t        $v3 = stbds_rotate_left($v3, 16);\n496\t        $v3 ^= $v2;\n497\t        $v2 = $v2.wrapping_add($v1);\n498\t        $v1 = stbds_rotate_left($v1, 17);\n499\t        $v1 ^= $v2;\n500\t        $v2 = stbds_rotate_left($v2, STBDS_SIZE_T_BITS / 2);\n501\t        $v0 = $v0.wrapping_add($v3);\n502\t        $v3 = stbds_rotate_left($v3, 21);\n503\t        $v3 ^= $v0;\n504\t    }};\n505\t}\n506\t\n507\t/// Reproduces the C expression `d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24)`\n508\t/// which is evaluated in `int` arithmetic (so the result is sign extended when\n509\t/// it is later converted to `size_t`).\n510\t#[inline]\n511\tunsafe fn load32_as_c_int(d: *const u8) -> i32 {\n512\t    let v: u32 = (*d.wrapping_add(0) as u32)\n513\t        | ((*d.wrapping_add(1) as u32) << 8)\n514\t        | ((*d.wrapping_add(2) as u32) << 16)\n515\t        | ((*d.wrapping_add(3) as u32) << 24);\n516\t    v as i32\n517\t}\n518\t\n519\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n520\t    let mut d = p as *const u8;\n521\t    let mut i: usize;\n522\t    let j: usize;\n523\t    let mut v0: usize;\n524\t    let mut v1: usize;\n525\t    let mut v2: usize;\n526\t    let mut v3: usize;\n527\t    let mut data: usize;\n528\t    let _ = j;\n529\t\n530\t    v0 = (((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575)) ^ seed;\n531\t    v1 = (((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d)) ^ !seed;\n532\t    v2 = (((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261)) ^ seed;\n533\t    v3 = (((0x74656462usize << 16) << 16).wrapping_add(0x79746573)) ^ !seed;\n534\t\n535\t    v0 ^= 0x0706050403020100usize ^ seed;\n536\t    v1 ^= 0x0f0e0d0c0b0a09