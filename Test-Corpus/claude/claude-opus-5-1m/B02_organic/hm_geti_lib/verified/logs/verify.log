  slot = stbds_hm_find_slot(\n1041\t                            a,\n1042\t                            elemsize,\n1043\t                            *(byte_off(\n1044\t                                a,\n1045\t                                elemsize\n1046\t                                    .wrapping_mul(old_index as usize)\n1047\t                                    .wrapping_add(keyoffset),\n1048\t                            ) as *mut *mut c_char) as *mut c_void,\n1049\t                            keysize,\n1050\t                            keyoffset,\n1051\t                            mode,\n1052\t                        );\n1053\t                    } else {\n1054\t                        slot = stbds_hm_find_slot(\n1055\t                            a,\n1056\t                            elemsize,\n1057\t                            byte_off(\n1058\t                                a,\n1059\t                                elemsize\n1060\t                                    .wrapping_mul(old_index as usize)\n1061\t                                    .wrapping_add(keyoffset),\n1062\t                            ),\n1063\t                            keysize,\n1064\t                            keyoffset,\n1065\t                            mode,\n1066\t                        );\n1067\t                    }\n1068\t                    STBDS_ASSERT!(slot >= 0);\n1069\t                    b = (*table).storage.wrapping_offset(slot >> STBDS_BUCKET_SHIFT);\n1070\t                    i = ((slot as usize) & STBDS_BUCKET_MASK) as c_int;\n1071\t                    STBDS_ASSERT!((*b).index[i as usize] == final_index);\n1072\t                    (*b).index[i as usize] = old_index;\n1073\t                }\n1074\t                (*stbds_header(raw_a)).length -= 1;\n1075\t\n1076\t                if (*table).used_count < (*table).used_count_shrink_threshold\n1077\t                    && (*table).slot_count > STBDS_BUCKET_LENGTH\n1078\t                {\n1079\t                    (*stbd