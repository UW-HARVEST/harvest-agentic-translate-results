>= 0\n161\t}\n162\t\n163\t// ---------------------------------------------------------------------------\n164\t// Pointer / macro helpers\n165\t// ---------------------------------------------------------------------------\n166\t\n167\t/// `#define stbds_header(t) ((stbds_array_header *) (t) - 1)`\n168\t#[inline]\n169\tfn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n170\t    (t as *mut stbds_array_header).wrapping_sub(1)\n171\t}\n172\t\n173\t/// Byte offset of a pointer, using C's wrap-around (unsigned) semantics.\n174\t#[inline]\n175\tfn byte_off(p: *mut c_void, off: usize) -> *mut c_void {\n176\t    (p as *mut u8).wrapping_add(off) as *mut c_void\n177\t}\n178\t\n179\t/// `#define STBDS_HASH_TO_ARR(x,elemsize) ((char *) (x) - (elemsize))`\n180\t#[inline]\n181\tfn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n182\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n183\t}\n184\t\n185\t/// `#define STBDS_ARR_TO_HASH(x,elemsize) ((char *) (x) + (elemsize))`\n186\t#[inline]\n187\tfn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n188\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n189\t}\n190\t\n191\t/// `#define stbds_arrlen(a) ((a) ? (ptrdiff_t) stbds_header(a)->length : 0)`\n192\t#[inline]\n193\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n194\t    if !a.is_null() {\n195\t        (*stbds_header(a)).length as isize\n196\t    } else {\n197\t        0\n198\t    }\n199\t}\n200\t\n201\t/// `#define stbds_arrcap(a) ((a) ? stbds_header(a)->capacity : 0)`\n202\t#[inline]\n203\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n204\t    if !a.is_null() {\n205\t        (*stbds_header(a)).capacity\n206\t    } else {\n207\t        0\n208\t    }\n209\t}\n210\t\n211\t/// `#define stbds_temp(t) stbds_header(t)->temp`\n212\t#[inline]\n213\tunsafe fn stbds_temp_get(t: *mut c_void) -> isize {\n214\t    (*stbds_header(t)).temp\n215\t}\n216\t\n217\t#[inline]\n218\tunsafe fn stbds_temp_set(t: *mut c_void, v: isize) {\n219\t    (*stbds_header(t)).temp = v;\n220\t}\n221\t\n222\t/// `#define stbds_temp_key(t) (*(char **) stbds_header(t)->hash_table)`\n223\t#[inline]\n224\tunsafe fn stbds_temp_key_set(t: *mut c_void, v: *mut c_char) {\n225\t    *((*stbds_header(t)).hash_table as *mut *mut c_char) = v;\n226\t}\n227\t\n228\t/// `#define stbds_hash_table(a) ((stbds_hash_index *) stbds_header(a)->hash_table)`\n229\t#[inline]\n230\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n231\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n232\t}\n233\t\n234\t/// `#define STBDS_ALIGN_FWD(n,a) (((n) + (a) - 1) & ~((a)-1))`\n235\t#[inline]\n236\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n237\t    n.wrapping_add(a - 1) & !(a - 1)\n238\t}\n239\t\n240\t/// `#define STBDS_ROTATE_LEFT(val, n)`\n241\t#[inline]\n242\tfn stbds_rotate_left(val: usize, n: u32) -> usize {\n243\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n244\t}\n245\t\n246\t/// `#define STBDS_ROTATE_RIGHT(val, n)`\n247\t#[inline]\n248\tfn stbds_rotate_right(val: usize, n: u32) -> usize {\n249\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n250\t}\n251\t\n252\t// ---------------------------------------------------------------------------\n253\t// stbds_arrgrowf / stbds_arrfreef\n254\t// ---------------------------------------------------------------------------\n255\t\n256\t#[unsafe(no_mangle)]\n257\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n258\t    a: *mut c_void,\n259\t    elemsize: usize,\n260\t    addlen: usize,\n261\t    min_cap: usize,\n262\t) -> *mut c_void {\n263\t    let mut min_cap = min_cap;\n264\t    // size_t min_len = stbds_arrlen(a) + addlen;   (ptrdiff_t + size_t -> size_t)\n265\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n266\t\n267\t    if min_len > min_cap {\n268\t        min_cap = min_len;\n269\t    }\n270\t\n271\t    if min_cap <= stbds_arrcap(a) {\n272\t        return a;\n273\t    }\n274\t\n275\t    if min_cap < 2usize.wrapp