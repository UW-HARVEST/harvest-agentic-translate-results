t        STBDS_SIPROUND!(v0, v1, v2, v3);\n591\t    }\n592\t\n593\t    v0 ^ v1 ^ v2 ^ v3\n594\t}\n595\t\n596\t#[unsafe(no_mangle)]\n597\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n598\t    stbds_siphash_bytes(p, len, seed)\n599\t}\n600\t\n601\t// ---------------------------------------------------------------------------\n602\t// Hash map internals\n603\t// ---------------------------------------------------------------------------\n604\t\n605\tunsafe fn stbds_is_key_equal(\n606\t    a: *mut c_void,\n607\t    elemsize: usize,\n608\t    key: *mut c_void,\n609\t    keysize: usize,\n610\t    keyoffset: usize,\n611\t    mode: c_int,\n612\t    i: usize,\n613\t) -> c_int {\n614\t    if mode >= STBDS_HM_STRING {\n615\t        let stored = *(byte_off(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset))\n616\t            as *mut *mut c_char);\n617\t        (0 == strcmp(key as *const c_char, stored)) as c_int\n618\t    } else {\n619\t        (0 == memcmp(\n620\t            key as *const c_void,\n621\t            byte_off(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset)) as *const c_void,\n622\t            keysize,\n623\t        )) as c_int\n624\t    }\n625\t}\n626\t\n627\t#[unsafe(no_mangle)]\n628\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n629\t    if a.is_null() {\n630\t        return;\n631\t    }\n632\t    if !stbds_hash_table(a).is_null() {\n633\t        if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP as u8 {\n634\t            let mut i: usize = 1;\n635\t            while i < (*stbds_header(a)).length {\n636\t                stbds_free(\n637\t                    *(byte_off(a, elemsize.wrapping_mul(i)) as *mut *mut c_char) as *mut c_void,\n638\t                );\n639\t                i += 1;\n640\t            }\n641\t        }\n642\t        stbds_strreset(ptr::addr_of_mut!((*stbds_hash_table(a)).string));\n643\t    }\n644\t    stbds_free((*stbds_header(a)).hash_table);\n645\t    stbds_free(stbds_header(a) as *mut c_void);\n646\t}\n647\t\n648\tunsafe fn stbds_hm_find_slot(\n649\t    a: *mut c_void,\n650\t    elemsize: usize,\n651\t    key: *mut c_void,\n652\t    keysize: usize,\n653\t    keyoffset: usize,\n654\t    mode: c_int,\n655\t) -> isize {\n656\t    let raw_a = stbds_hash_to_arr(a, elemsize);\n657\t    let table = stbds_hash_table(raw_a);\n658\t    let mut hash = if mode >= STBDS_HM_STRING {\n659\t        stbds_hash_string(key as *mut c_char, (*table).seed)\n660\t    } else {\n661\t        stbds_hash_bytes(key, keysize, (*table).seed)\n662\t    };\n663\t    let mut step = STBDS_BUCKET_LENGTH;\n664\t    let mut pos: usize;\n665\t\n666\t    if hash < 2 {\n667\t        hash = hash.wrapping_add(2);\n668\t    }\n669\t\n670\t    pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n671\t\n672\t    loop {\n673\t        let bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n674\t\n675\t        let mut i = pos & STBDS_BUCKET_MASK;\n676\t        while i < STBDS_BUCKET_LENGTH {\n677\t            if (*bucket).hash[i] == hash {\n678\t                if stbds_is_key_equal(\n679\t                    a,\n680\t                    elemsize,\n681\t                    key,\n682\t                    keysize,\n683\t                    keyoffset,\n684\t                    mode,\n685\t                    (*bucket).index[i] as usize,\n686\t                ) != 0\n687\t                {\n688\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n689\t                }\n690\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n691\t                return -1;\n692\t            }\n693\t            i += 1;\n694\t        }\n695\t\n696\t        let limit = pos & STBDS_BUCKET_MASK;\n697\t        let mut i = 0usize;\n698\t        while i < limit {\n699\t            if (*bucket).hash[i] == hash {\n700\t                if stbds_is_key_equal(\n701\t                    a,\n702\t                    elemsize,\n703\t                    key,\n704\t                    keysize,\n705\t                    keyoffset,\n706\t                    mode,\n707\t                    (*bucket).index[i] as usize,\n708\t                ) != 0\n709\t                {\n710\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n711\t                }\n712\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n713\t                return -1;\n714\t            }\n715\t            i += 1;\n716\t        }\n717\t\n718\t        pos = pos.wrapping_add(step);\n719\t        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n720\t        pos &= (*table).slot_count - 1;\n721\t    }\n722\t}\n723\t\n724\t#[unsafe(no_mangle)]\n725\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n726\t    a: *mut c_void,\n727\t    elemsize: usize,\n728\t    key: *mut c_void,\n729\t    keysize: usize,\n730\t    temp: *mut isize,\n731\t    mode: c_int,\n732\t) -> *mut c_void {\n733\t    let keyoffset: usize = 0;\n734\t    if a.is_null() {\n735\t        let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n736\t        (*stbds_header(a)).length += 1;\n737\t        memset(a, 0, elemsize);\n738\t        *temp = STBDS_INDEX_EMPTY;\n739\t        stbds_arr_to_hash(a, elemsize)\n740\t    } else {\n741\t        let raw_a = stbds_hash_to_arr(a, elemsize);\n742\t        let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n743\t        if table.is_null() {\n744\t            *temp = -1;\n745\t        } else {\n746\t            let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n747\t            if slot < 0 {\n748\t                *temp = STBDS_INDEX_EMPTY;\n749\t            } else {\n750\t                let b = (*table).storage.wrapping_offset(slot >> STBDS_BUCKET_SHIFT);\n751\t                *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n752\t            }\n753\t        }\n754\t        a\n755\t    }\n756\t}\n757\t\n758\t#[unsafe(no_mangle)]\n759\tpub unsafe extern \"C\" fn stbds_hmget_key(\n760\t    a: *mut c_void,\n761\t    elemsize: usize,\n762\t    key: *mut c_void,\n763\t    keysize: usize,\n764\t    mode: c_int,\n765\t) -> *mut c_void {\n766\t    let mut temp: isize = 0;\n767\t    let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &mut temp, mode);\n768\t    stbds_temp_set(stbds_hash_to_arr(p, elemsize), temp);\n769\t    p\n770\t}\n771\t\n772\t#[unsafe(no_mangle)]\n773\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n774\t    let mut a = a;\n775\t    if a.is_null() || (*stbds_header(stbds_hash_to_arr(a, elemsize))).length == 0 {\n776\t        a = stbds_arrgrowf(\n777\t            if !a.is_null() {\n778\t                stbds_hash_to_arr(a, elemsize)\n779\t            } else {\n780\t                ptr::null_mut()\n781\t            },\n782\t            elemsize,\n783\t            0,\n784\t            1,\n785\t        );\n786\t        (*stbds_header(a)).length += 1;\n787\t        memset(a, 0, elemsize);\n788\t        a = stbds_arr_to_hash(a, elemsize);\n789\t    }\n790\t    a\n791\t}\n792\t\n793\t#[unsafe(no_mangle)]\n794\tpub unsafe extern \"C\" fn stbds_hmput_key(\n795\t    a: *mut c_void,\n796\t    elemsize: usize,\n797\t    key: *mut c_void,\n798\t    keysize: usize,\n799\t    mode: c_int,\n800\t) -> *mut c_void {\n801\t    let keyoffset: usize = 0;\n802\t    let mut a = a;\n803\t    let mut raw_a: *mut c_void;\n804\t    let mut table: *mut stbds_hash_index;\n805\t\n806\t    if a.is_null() {\n807\t        a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n808\t        memset(a, 0, elemsize);\n809\t        (*stbds_header(a)).length += 1;\n810\t        a = stbds_arr_to_hash(a, elemsize);\n811\t    }\n812\t\n813\t    raw_a = a;\n814\t    a = stbds_hash_to_arr(a, elemsize);\n815\t\n816\t    table = (*stbds_header(a)).hash_table as *mut stbds_hash_index;\n817\t\n818\t    if table.is_null() || (*table).used_count >= (*table).used_count_threshold {\n819\t        let slot_count = if table.is_null() {\n820\t            STBDS_BUCKET_LENGTH\n821\t        } else {\n822\t            (*table).slot_count.wrapping_mul(2)\n823\t        };\n824\t        let nt = stbds_make_hash_index(slot_count, table);\n825\t        if !table.is_null() {\n826\t            stbds_free(table as *mut c_void);\n827\t        } else {\n828\t            (*nt).string.mode = if mode >= STBDS_HM_STRING {\n829\t                STBDS_SH_DEFAULT as u8\n830\t            } else {\n831\t                0\n832\t            };\n833\t        }\n834\t        table = nt;\n835\t        (*stbds_header(a)).hash_table = table as *mut c_void;\n836\t    }\n837\t\n838\t    {\n839\t        let mut hash = if mode >= STBDS_HM_STRING {\n840\t            stbds_hash_string(key as *mut c_char, (*table).seed)\n841\t        } else {\n842\t            stbds_hash_bytes(key, keysize, (*table).seed)\n843\t        };\n844\t        let mut step = STBDS_BUCKET_LENGTH;\n845\t        let mut pos: usize;\n846\t        let mut tombstone: isize = -1;\n847\t        let mut bucket: *mut stbds_hash_bucket;\n848\t\n849\t        if hash < 2 {\n850\t            hash = hash.wrapping_add(2);\n851\t        }\n852\t\n853\t        pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n854\t\n855\t        'found_empty_slot: loop {\n856\t            bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n857\t\n858\t            let mut i = pos & STBDS_BUCKET_MASK;\n859\t            while i < STBDS_BUCKET_LENGTH {\n860\t                if (*bucket).hash[i] == hash {\n861\t                    if stbds_is_key_equal(\n862\t                        raw_a,\n863\t                        elemsize,\n864\t                        key,\n865\t                        keysize,\n866\t                        keyoffset,\n867\t                        mode,\n868\t                        (*bucket).index[i] as usize,\n869\t                    ) != 0\n870\t                    {\n871\t                        stbds_temp_set(a, (*bucket).index[i]);\n872\t                        if mode >= STBDS_HM_STRING {\n873\t                            let stored = *(byte_off(\n874\t                                raw_a,\n875\t                                elemsize\n876\t                                    .wrapping_mul((*bucket).index[i] as usize)\n877\t                                    .wrapping_add(keyoffset),\n878\t                            ) as *mut *mut c_char);\n879\t                            stbds_temp_key_set(a, stored);\n880\t                        }\n881\t                        return stbds_arr_to_hash(a, elemsize);\n882\t                    }\n883\t                } else if (*bucket).hash[i] == 0 {\n884\t                    pos = (pos & !STBDS_BUCKET_MASK).wrapping_add(i);\n885\t                    break 'found_empty_slot;\n886\t                } else if tombstone < 0 {\n887\t                    if (*bucket).index[i] == STBDS_INDEX_DELETED {\n888\t                        tombstone = ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n889\t                    }\n890\t                }\n891\t                i += 1;\n892\t            }\n893\t\n894\t            let limit = pos & STBDS_BUCKET_MASK;\n895\t            let mut i = 0usize;\n896\t            while i < limit {\n897\t                if (*bucket).hash[i] == hash {\n898\t                    if stbds_is_key_equal(\n899\t                        raw_a,\n900\t                        elemsize,\n901\t                        key,\n902\t                        keysize,\n903\t                        keyoffset,\n904\t                        mode,\n905\t                        (*bucket).index[i] as usize,\n906\t                    ) != 0\n907\t                    {\n908\t                        stbds_temp_set(a, (*bucket).index[i]);\n909\t                        return stbds_arr_to_hash(a, elemsize);\n910\t                    }\n911\t                } else if (*bucket).hash[i] == 0 {\n912\t                    pos = (pos & !STBDS_BUCKET_MASK).wrapping_add(i);\n913\t                    break 'found_empty_slot;\n914\t                } else if tombstone < 0 {\n915\t                    if (*bucket).index[i] == STBDS_INDEX_DELETED {\n916\t                        tombstone = ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n917\t                    }\n918\t                }\n919\t                i += 1;\n920\t            }\n921\t\n922\t            pos = pos.wrapping_add(step);\n923\t            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n924\t            pos &= (*table).slot_count - 1;\n925\t        }\n926\t\n927\t        // found_empty_slot:\n928\t        if tombstone >= 0 {\n929\t            pos = tombstone as usize;\n930\t            (*table).tombstone_count = (*table).tombstone_count.wrapping_sub(1);\n931\t        }\n932\t        (*table).used_count = (*table).used_count.wrapping_add(1);\n933\t\n934\t        {\n935\t            let i: isize = stbds_arrlen(a);\n936\t            if (i as usize).wrapping_add(1) > stbds_arrcap(a) {\n937\t                a = stbds_arrgrowf(a, elemsize, 1, 0);\n938\t            }\n939\t            raw_a = stbds_arr_to_hash(a, elemsize);\n940\t            let _ = raw_a;\n941\t\n942\t            STBDS_ASSERT!((i as usize).wrapping_add(1) <= stbds_arrcap(a));\n943\t            (*stbds_header(a)).length = (i.wrapping_add(1)) as usize;\n944\t            bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n945\t            (*bucket).hash[pos & STBDS_BUCKET_MASK] = hash;\n946\t            (*bucket).index[pos & STBDS_BUCKET_MASK] = i.wrapping_sub(1);\n947\t            stbds_temp_set(a, i.wrapping_sub(1));\n948\t\n949\t            let slot: *mut *mut c_char =\n950\t                byte_off(a, elemsize.wrapping_mul(i as usize)) as *mut *mut c_char;\n951\t            match (*table).string.mode as c_int {\n952\t                STBDS_SH_STRDUP => {\n953\t                    let p = stbds_strdup(key as *mut c_char);\n954\t                    *slot = p;\n955\t                    stbds_temp_key_set(a, p);\n956\t                }\n957\t                STBDS_SH_ARENA => {\n958\t                    let p = stbds_stralloc(ptr::addr_of_mut!((*table).string), key as *mut c_char);\n959\t                    *slot = p;\n960\t                    stbds_temp_key_set(a, p);\n961\t                }\n962\t                STBDS_SH_DEFAULT => {\n963\t                    let p = key as *mut c_char;\n964\t                    *slot = p;\n965\t                    stbds_temp_key_set(a, p);\n966\t                }\n967\t                _ => {\n968\t                    memcpy(\n969\t                        byte_off(a, elemsize.wrapping_mul(i as usize)),\n970\t                        key as *const c_void,\n971\t                        keysize,\n972\t                    );\n973\t                }\n974\t            }\n975\t        }\n976\t        stbds_arr_to_hash(a, elemsize)\n977\t    }\n978\t}\n979\t\n980\t#[unsafe(no_mangle)]\n981\tpub unsafe extern \"C\" fn stbds_shmode_func(elemsize: usize, mode: c_int) -> *mut c_void {\n982\t    let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n983\t    memset(a, 0, elemsize);\n984\t    (*stbds_header(a)).length = 1;\n985\t    let h = stbds_make_hash_index(STBDS_BUCKET_LENGTH, ptr::null_mut());\n986\t    (*stbds_header(a)).hash_table = h as *mut c_void;\n987\t    (*h).string.mode = mode as u8;\n988\t    stbds_arr_to_hash(a, elemsize)\n989\t}\n990\t\n991\t#[unsafe(no_mangle)]\n992\tpub unsafe extern \"C\" fn stbds_hmdel_key(\n993\t    a: *mut c_void,\n994\t    elemsize: usize,\n995\t    key: *mut c_void,\n996\t    keysize: usize,\n997\t    keyoffset: usize,\n998\t    mode: c_int,\n999\t) -> *mut c_void {\n1000\t    if a.is_null() {\n1001\t        ptr::null_mut()\n1002\t    } else {\n1003\t        let raw_a = stbds_hash_to_arr(a, elemsize);\n1004\t        let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n1005