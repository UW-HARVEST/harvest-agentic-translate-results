          while x < len {\n643\t                    let v = *raw.wrapping_offset((x.wrapping_sub(bpp)) as isize);\n644\t                    let t = raw.wrapping_offset(x as isize);\n645\t                    *t = (*t).wrapping_add(v);\n646\t                    x = x.wrapping_add(1);\n647\t                }\n648\t            }\n649\t            2 => {}\n650\t            3 => {\n651\t                x = bpp;\n652\t                while x < len {\n653\t                    let v = *raw.wrapping_offset((x.wrapping_sub(bpp)) as isize) / 2;\n654\t                    let t = raw.wrapping_offset(x as isize);\n655\t                    *t = (*t).wrapping_add(v);\n656\t                    x = x.wrapping_add(1);\n657\t                }\n658\t            }\n659\t            4 => {\n660\t                x = bpp;\n661\t                while x < len {\n662\t                    let v = cp_paeth(*raw.wrapping_offset((x.wrapping_sub(bpp)) as isize), 0, 0);\n663\t                    let t = raw.wrapping_offset(x as isize);\n664\t                    *t = (*t).wrapping_add(v);\n665\t                    x = x.wrapping_add(1);\n666\t                }\n667\t            }\n668\t            _ => return 0,\n669\t        }\n670\t    }\n671\t    let mut prev = raw;\n672\t    raw = raw.wrapping_offset(len as isize);\n673\t    let mut y: c_int = 1;\n674\t    while y < h {\n675\t        let filter = *raw;\n676\t        raw = raw.wrapping_offset(1);\n677\t        match filter {\n678\t            0 => {}\n679\t            1 => {\n680\t                x = 0;\n681\t                while x < bpp {\n682\t                    let t = raw.wrapping_offset(x as isize);\n683\t                    *t = (*t).wrapping_add(0);\n684\t                    x = x.wrapping_add(1);\n685\t                }\n686\t                while x < len {\n687\t                    let v = *raw.wrapping_offset((x.wrapping_sub(bpp)) as isize);\n688\t                    let t = raw.wrapping_offset(x as isize);\n689\t                    *t = (*t).wrapping_add(v);\n690\t                    x = x.wrapping_add(1);\n691\t                }\n692\t            }\n693\t            2 => {\n694\t                x = 0;\n695\t                while x < bpp {\n696\t                    let v = *prev.wrapping_offset(x as isize);\n697\t                    let t = raw.wrapping_offset(x as isize);\n698\t                    *t = (*t).wrapping_add(v);\n699\t                    x = x.wrapping_add(1);\n700\t                }\n701\t                while x < len {\n702\t                    let v = *prev.wrapping_offset(x as isize);\n703\t                    let t = raw.wrapping_offset(x as isize);\n704\t                    *t = (*t).wrapping_add(v);\n705\t                    x = x.wrapping_add(1);\n706\t                }\n707\t            }\n708\t            3 => {\n709\t                x = 0;\n710\t                while x < bpp {\n711\t                    let v = *prev.wrapping_offset(x as isize) / 2;\n712\t                    let t = raw.wrapping_offset(x as isize);\n713\t                    *t = (*t).wrapping_add(v);\n714\t                    x = x.wrapping_add(1);\n715\t                }\n716\t                while x < len {\n717\t                    let a = *raw.wrapping_offset((x.wrapping_sub(bpp)) as isize) as c_int;\n718\t                    let b = *prev.wrapping_offset(x as isize) as c_int;\n719\t                    let v = (a.wrapping_add(b) / 2) as u8;\n720\t                    let t = raw.wrapping_offset(x as isize);\n721\t                    *t = (*t).wrapping_add(v);\n722\t                    x = x.wrapping_add(1);\n723\t                }\n724\t            }\n725\t            4 => {\n726\t                x = 0;\n727\t                while x < bpp {\n728\t                    let v = *prev.wrapping_offset(x as isize);\n729\t                    let t = raw.wrapping_offset(x as isize);\n730\t                    *t = (*t).wrapping_add(v);\n731\t                    x = x.wrapping_add(1);\n732\t                }\n733\t                while x < len {\n734\t                    let v = cp_paeth(\n735\t                        *raw.wrapping_offset((x.wrapping_sub(bpp)) as isize),\n736\t                        *prev.wrapping_offset(x as isize),\n737\t                        *prev.wrapping_offset((x.wrapping_sub(bpp)) as isize),\n738\t                    );\n739\t                    let t = raw.wrapping_offset(x as isize);\n740\t                    *t = (*t).wrapping_add(v);\n741\t                    x = x.wrapping_add(1);\n742\t                }\n743\t            }\n744\t            _ => return 0,\n745\t        }\n746\t        y = y.wrapping_add(1);\n747\t        prev = raw;\n748\t        raw = raw.wrapping_offset(len as isize);\n749\t    }\n750\t    1\n751\t}\n752\t\n753\tunsafe fn cp_convert(bpp: c_int, w: c_int, h: c_int, src: *mut u8, dst: *mut cp_pixel_t) {\n754\t    let mut src = src;\n755\t    let mut dst = dst;\n756\t    let mut y: c_int = 0;\n757\t    while y < h {\n758\t        src = src.wrapping_offset(1);\n759\t        let mut x: c_int = 0;\n760\t        while x < w {\n761\t            match bpp {\n762\t                1 => {\n763\t                    *dst = cp_make_pixel(*src, *src, *src);\n764\t                    dst = dst.wrapping_offset(1);\n765\t                }\n766\t                2 => {\n767\t                    *dst = cp_make_pixel_a(*src, *src, *src, *src.wrapping_offset(1));\n768\t                    dst = dst.wrapping_offset(1);\n769\t                }\n770\t                3 => {\n771\t                    *dst = cp_make_pixel(\n772\t                        *src,\n773\t                        *src.wrapping_offset(1),\n774\t                        *src.wrapping_offset(2),\n775\t                    );\n776\t                    dst = dst.wrapping_offset(1);\n777\t                }\n778\t                4 => {\n779\t                    *dst = cp_make_pixel_a(\n780\t                        *src,\n781\t                        *src.wrapping_offset(1),\n782\t                        *src.wrapping_offset(2),\n783\t                        *src.wrapping_offset(3),\n784\t                    );\n785\t                    dst = dst.wrapping_offset(1);\n786\t                }\n787\t                _ => {}\n788\t            }\n789\t            x = x.wrapping_add(1);\n790\t            src = src.wrapping_offset(bpp as isize);\n791\t        }\n792\t        y = y.wrapping_add(1);\n793\t    }\n794\t}\n795\t\n796\tunsafe fn cp_get_alpha_for_indexed_image(index: c_int, trns: *const u8, trns_len: u32) -> u8 {\n797\t    if trns.is_null() {\n798\t        255\n799\t    } else if (index as u32) >= trns_len {\n800\t        255\n801\t    } else {\n802\t        *trns.wrapping_offset(index as isize)\n803\t    }\n804\t}\n805\t\n806\tunsafe fn cp_depalette(\n807\t    w: c_int,\n808\t    h: c_int,\n809\t    src: *mut u8,\n810\t    dst: *mut cp_pixel_t,\n811\t    plte: *const u8,\n812\t    trns: *const u8,\n813\t    trns_len: u32,\n814\t) {\n815\t    let mut src = src;\n816\t    let mut dst = dst;\n817\t    let mut y: c_int = 0;\n818\t    while y < h {\n819\t        src = src.wrapping_offset(1);\n820\t        let mut x: c_int = 0;\n821\t        while x < w {\n822\t            let c = *src as c_int;\n823\t            let r = *plte.wrapping_offset((c.wrapping_mul(3)) as isize);\n824\t            let g = *plte.wrapping_offset((c.wrapping_mul(3).wrapping_add(1)) as isize);\n825\t            let b = *plte.wrapping_offset((c.wrapping_mul(3).wrapping_add(2)) as isize);\n826\t            let a = cp_get_alpha_for_indexed_image(c, trns, trns_len);\n827\t            *dst = cp_make_pixel_a(r, g, b, a);\n828\t            dst = dst.wrapping_offset(1);\n829\t            x = x.wrapping_add(1);\n830\t            src = src.wrapping_offset(1);\n831\t        }\n832\t        y = y.wrapping_add(1);\n833\t    }\n834\t}\n835\t\n836\tunsafe fn cp_get_chunk_byte_length(chunk: *const u8) -> u32 {\n837\t    cp_make32(chunk.wrapping_offset(-8))\n838\t}\n839\t\n840\tunsafe fn cp_out_size(img: *const cp_image_t, bpp: c_int) -> c_int {\n841\t    ((*img).w.wrapping_add(1))\n842\t        .wrapping_mul((*img).h)\n843\t        .wrapping_mul(bpp)\n844\t}\n845\t\n846\t#[unsafe(no_mangle)]\n847\tpub unsafe extern \"C\" fn load_png_mem(png_data: *const u8, png_length: c_int) -> cp_image_t {\n848\t    let mut img = cp_image_t {\n849\t        w: 0,\n850\t        h: 0,\n851\t        pix: ptr::null_mut(),\n852\t    };\n853\t    let mut data: *mut u8 = ptr::null_mut();\n854\t    let ok = load_png_mem_body(png_data, png_length, &mut img, &mut data);\n855\t    if ok {\n856\t        free(data as *mut c_void);\n857\t        return img;\n858\t    }\n859\t    free(data as *mut c_void);\n860\t    free(img.pix as *mut c_void);\n861\t    img.pix = ptr::null_mut();\n862\t    img\n863\t}\n864\t\n865\tunsafe fn load_png_mem_body(\n866\t    png_data: *const u8,\n867\t    png_length: c_int,\n868\t    img: &mut cp_image_t,\n869\t    data_out: &mut *mut u8,\n870\t) -> bool {\n871\t    const SIG: &[u8; 8] = b\"\\x89PNG\\r\\n\\x1a\\n\";\n872\t\n873\t    let ihdr: *const u8;\n874\t    let mut first: *const u8;\n875\t    let plte: *const u8;\n876\t    let trns: *const u8;\n877\t    let bit_depth: c_int;\n878\t    let color_type: c_int;\n879\t    let bpp: c_int;\n880\t    let w: c_int;\n881\t    let h: c_int;\n882\t    let pix_bytes: c_int;\n883\t    let compression: c_int;\n884\t    let filter: c_int;\n885\t    let interlace: c_int;\n886\t    let mut datalen: c_int;\n887\t    let mut offset: c_int;\n888\t    let out: *mut u8;\n889\t\n890\t    let mut png = cp_raw_png_t {\n891\t        p: png_data,\n892\t        end: png_data.wrapping_offset(png_length as isize),\n893\t    };\n894\t\n895\t    if !cp_mem_eq(png.p, SIG.as_ptr(), 8) {\n896\t        cp_set_error!(\"incorrect file signature (is this a png file?)\");\n897\t        return false;\n898\t    }\n899\t    png.p = png.p.wrapping_offset(8);\n900\t    ihdr = cp_chunk(&mut png, b\"IHDR\".as_ptr(), 13);\n901\t    if ihdr.is_null() {\n902\t        cp_set_error!(\"unable to find IHDR chunk\");\n903\t        return false;\n904\t    }\n905\t    bit_depth = *ihdr.wrapping_offset(8) as c_int;\n906\t    color_type = *ihdr.wrapping_offset(9) as c_int;\n907\t    if bit_depth != 8 {\n908\t        cp_set_error!(\"only bit-depth of 8 is supported\");\n909\t        return false;\n910\t    }\n911\t    match color_type {\n912\t        0 => bpp = 1,\n913\t        2 => bpp = 3,\n914\t        3 => bpp = 1,\n915\t        4 => bpp = 2,\n916\t        6 => bpp = 4,\n917\t        _ => {\n918\t            cp_set_error!(\"unknown color type\");\n919\t            return false;\n920\t        }\n921\t    }\n922\t    w = cp_make32(ihdr).wrapping_add(1) as c_int;\n923\t    h = cp_make32(ihdr.wrapping_offset(4)) as c_int;\n924\t    if !(w >= 1) {\n925\t        cp_set_error!(\"invalid IHDR chunk found, image width was less than 1\");\n926\t        return false;\n927\t    }\n928\t    if !(h >= 1) {\n929\t        cp_set_error!(\"invalid IHDR chunk found, image height was less than 1\");\n930\t        return false;\n931\t    }\n932\t    // `(int64_t)w * h * sizeof(cp_pixel_t) < INT_MAX` -- the multiplication with\n933\t    // `sizeof` makes the whole expression unsigned.\n934\t    if !((((w as i64).wrapping_mul(h as i64)) as u64)\n935\t        .wrapping_mul(core::mem::size_of::<cp_pixel_t>() as u64)\n936\t        < c_int::MAX as u64)\n937\t    {\n938\t        cp_set_error!(\"image too large\");\n939\t        return false;\n940\t    }\n941\t    pix_bytes = ((w as i64).wrapping_mul(h as i64) as u64)\n942\t        .wrapping_mul(core::mem::size_of::<cp_pixel_t>() as u64) as c_int;\n943\t    img.w = w.wrapping_sub(1);\n944\t    img.h = h;\n945\t    img.pix = malloc(pix_bytes as usize) as *mut cp_pixel_t;\n946\t    if img.pix.is_null() {\n947\t        cp_set_error!(\"unable to allocate raw image space\");\n948\t        return false;\n949\t    }\n950\t    compression = *ihdr.wrapping_offset(10) as c_int;\n951\t    filter = *ihdr.wrapp