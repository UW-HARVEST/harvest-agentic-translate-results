-------------------------\n144\t// DEFLATE decompressor\n145\t// ---------------------------------------------------------------------------\n146\t\n147\t#[repr(C)]\n148\tstruct cp_state_t {\n149\t    bits: u64,\n150\t    count: c_int,\n151\t    words: *mut u32,\n152\t    word_count: c_int,\n153\t    word_index: c_int,\n154\t    bits_left: c_int,\n155\t    final_word_available: c_int,\n156\t    final_word: u32,\n157\t    out: *mut c_char,\n158\t    out_end: *mut c_char,\n159\t    begin: *mut c_char,\n160\t    lookup: [u16; 1 << 9],\n161\t    lit: [u32; 288],\n162\t    dst: [u32; 32],\n163\t    len: [u32; 19],\n164\t    nlit: u32,\n165\t    ndst: u32,\n166\t    nlen: u32,\n167\t}\n168\t\n169\t/// Only ever used by the `assert()` calls of the original C code.\n170\t#[allow(dead_code)]\n171\t#[inline]\n172\tunsafe fn cp_would_overflow(s: *mut cp_state_t, num_bits: c_int) -> c_int {\n173\t    (((*s).bits_left.wrapping_add((*s).count)).wrapping_sub(num_bits) < 0) as c_int\n174\t}\n175\t\n176\t#[inline]\n177\tunsafe fn cp_ptr(s: *mut cp_state_t) -> *mut c_char {\n178\t    ((*s).words.wrapping_offset((*s).word_index as isize) as *mut c_char)\n179\t        .wrapping_offset(-(((*s).count / 8) as isize))\n180\t}\n181\t\n182\tunsafe fn cp_peak_bits(s: *mut cp_state_t, num_bits_to_read: c_int) -> u64 {\n183\t    if (*s).count < num_bits_to_read {\n184\t        if (*s).word_index < (*s).word_count {\n185\t            let word = *(*s).words.wrapping_offset((*s).word_index as isize);\n186\t            (*s).word_index = (*s).word_index.wrapping_add(1);\n187\t            (*s).bits |= (word as u64).wrapping_shl((*s).count as u32);\n188\t            (*s).count = (*s).count.wrapping_add(32);\n189\t        } else if (*s).final_word_available != 0 {\n190\t            let word = (*s).final_word;\n191\t            (*s).bits |= (word as u64).wrapping_shl((*s).count as u32);\n192\t            (*s).count = (*s).count.wrapping_add((*s).bits_left);\n193\t            (*s).final_word_available = 0;\n194\t        }\n195\t    }\n196\t    (*s).bits\n197\t}\n198\t\n199\tunsafe fn cp_consume_bits(s: *mut cp_state_t, num_bits_to_read: c_int) -> u32 {\n200\t    let mask = (1u64.wrapping_shl(num_bits_to_read as u32)).wrapping_sub(1);\n201\t    let bits = ((*s).bits & mask) as u32;\n202\t    (*s).bits = (*s).bits.wrapping_shr(num_bits_to_read as u32);\n203\t    (*s).count = (*s).count.wrapping_sub(num_bits_to_read);\n204\t    (*s).bits_left = (*s).bits_left.wrapping_sub(num_bits_to_read);\n205\t    bits\n206\t}\n207\t\n208\tunsafe fn cp_read_bits(s: *mut cp_state_t, num_bits_to_read: c_int) -> u32 {\n209\t    cp_peak_bits(s, num_bits_to_read);\n210\t    cp_consume_bits(s, num_bits_to_read)\n211\t}\n212\t\n213\tfn cp_rev16(a: u32) -> u32 {\n214\t    let mut a = a;\n215\t    a = ((a & 0xAAAA) >> 1) | ((a & 0x5555) << 1);\n216\t    a = ((a & 0xCCCC) >> 2) | ((a & 0x3333) << 2);\n217\t    a = ((a & 0xF0F0) >> 4) | ((a & 0x0F0F) << 4);\n218\t    a = ((a & 0xFF00) >> 8) | ((a & 0x00FF) << 8);\n219\t    a\n220\t}\n221\t\n222\tunsafe fn cp_build(\n223\t    s: *mut cp_state_t,\n224\t    tree: *mut u32,\n225\t    lens: *const u8,\n226\t    sym_count: c_int,\n227\t) -> c_int {\n228\t    // The C code uses `int codes[16], first[16], counts[16]`; larger arrays are\n229\t    // used here so that (undefined in C) out of range code lengths cannot\n230\t    // corrupt unrelated memory.\n231\t    let mut codes = [0i32; 256];\n232\t    let mut first = [0i32; 256];\n233\t    let mut counts = [0i32; 256];\n234\t\n235\t    let mut n: c_int = 0;\n236\t    while n < sym_count {\n237\t        let idx = *lens.wrapping_offset(n as isize) as usize;\n238\t        counts[idx] = counts[idx].wrapping_add(1);\n239\t        n = n.wrapping_add(1);\n240\t    }\n241\t    counts[0] = 0;\n242\t    codes[0] = 0;\n243\t    first[0] = 0;\n244\t    for n in 1usize..=15usize {\n245\t        codes[n] = codes[n - 1].wrapping_add(counts[n - 1]).wrapping_mul(2);\n246\t        first[n] = first[n - 1].wrapping_add(counts[n - 1]);\n247\t    }\n248\t    if !s.is_null() {\n249\t        memset(\n250\t            (&raw mut (*s).lookup).cast::<c_void>(),\n251\t            0,\n252\t            core::mem::size_of::<[u16; 1 << 9]>(),\n253\t        );\n254\t    }\n255\t    let mut i: c_int = 0;\n256\t    while i < sym_count {\n257\t        let len = *lens.wrapping_offset(i as isize) as c_int;\n258\t        if len != 0 {\n259\t            let code = codes[len as usize] as u32;\n260\t            codes[len as usize] = codes[len as usize].wrapping_add(1);\n261\t            let slot = first[len as usize] as u32;\n262\t            first[len as usize] = first[len as usize].wrapping_add(1);\n263\t            *tree.wrapping_offset(slot as isize) = code\n264\t                .wrapping_shl((32 - len) as u32)\n265\t                | ((i as u32) << 4)\n266\t                | (len as u32);\n267\t            if !s.is_null() && len <= 9 {\n268\t                let lookup = (&raw mut (*s).lookup).cast::<u16>();\n269\t                let mut j: c_int = (cp_rev16(code) >> (16 - len)) as c_int;\n270\t                while j < (1 << 9) {\n271\t                    *lookup.wrapping_offset(j as isize) =\n272\t                        (((len as u32) << 9) | (i as u32)) as u16;\n273\t                    j = j.wrapping_add(1 << len);\n274\t                }\n275\t            }\n276\t        }\n277\t        i = i.wrapping_add(1);\n278\t    }\n279\t    first[15]\n280\t}\n281\t\n282\tunsafe fn cp_stored(s: *mut cp_state_t) -> c_int {\n283\t    cp_read_bits(s, (*s).count & 7);\n284\t    let LEN = cp_read_bits(s, 16) as u16;\n285\t    let NLEN = cp_read_bits(s, 16) as u16;\n286\t    if !(LEN == !NLEN) {\n287\t        cp_set_error!(\n288\t            \"Failed to find LEN and NLEN as complements within stored (uncompressed) stream.\"\n289\t        );\n290\t        return 0;\n291\t    }\n292\t    if !((*s).bits_left / 8 <= LEN as c_int) {\n293\t        cp_set_error!(\"Stored block extends beyond end of input stream.\");\n294\t        return 0;\n295\t    }\n296\t    let p = cp_ptr(s);\n297\t    memcpy(\n298\t        (*s).out as *mut c_void,\n299\t        p as *const c_void,\n300\t        LEN as usize,\n301\t    );\n302\t    (*s).out = (*s).out.wrapping_offset(LEN as isize);\n303\t    1\n304\t}\n305\t\n306\tunsafe fn cp_fixed(s: *mut cp_state_t) -> c_int {\n307\t    (*s).nlit = cp_build(s, (&raw mut (*s).lit).cast::<u32>(), fixed_table_ptr(), 288) as u32;\n308\t    (*s).ndst = cp_build(\n309\t        ptr::null_mut(),\n310\t        (&raw mut (*s).dst).cast::<u32>(),\n311\t        fixed_table_ptr().wrapping_add(288),\n312\t        32,\n313\t    ) as u32;\n314\t    1\n315\t}\n316\t\n317\tunsafe fn cp_decode(s: *mut cp_state_t, tree: *mut u32, hi: c_int) -> c_int {\n318\t    let bits = cp_peak_bits(s, 16);\n319\t    let search = (cp_rev16(bits as u32) << 16) | 0xFFFF;\n320\t    let mut lo: c_int = 0;\n321\t    let mut hi = hi;\n322\t    while lo < hi {\n323\t        let guess = (lo.wrapping_add(hi)) >> 1;\n324\t        if search < *tree.wrapping_offset(guess as isize) {\n325\t            hi = guess;\n326\t        } else {\n327\t            lo = guess.wrapping_add(1);\n328\t        }\n329\t    }\n330\t    let key = *tree.wrapping_offset((lo.wrapping_sub(1)) as isize);\n331\t    let code = cp_consume_bits(s, (key & 0xF) as c_int);\n332\t    let _ = code;\n333\t    ((key >> 4) & 0xFFF) as c_int\n334\t}\n335\t\n336\tunsafe fn cp_dynamic(s: *mut cp_state_t) -> c_int {\n337\t    // `uint8_t lenlens[19] = {0};` in C.  Slack is reserved because\n338\t    // `cp_permutation_order` is a public (writable) symbol and may contain\n339\t    // values >= 19, in which case the C code writes past the array.\n340\t    let mut lenlens = [0u8; 19 + 256];\n341\t    let nlit: c_int = 257i32.wrapping_add(cp_read_bits(s, 5) as c_int);\n342\t    let ndst: c_int = 1i32.wrapping_add(cp_read_bits(s, 5) as c_int);\n343\t    let nlen: c_int = 4i32.wrapping_add(cp_read_bits(s, 4) as c_int);\n344\t    {\n345\t        let mut i: c_int = 0;\n346\t        while i < nlen {\n347\t            let slot = *permutation_order_ptr().wrapping_offset(i as isize) as usize;\n348\t            let v = cp_read_bits(s, 3) as u8;\n349\t            *(lenlens.as_mut_ptr()).wrapping_add(slot) = v;\n350\t            i = i.wrapping_add(1);\n351\t        }\n352\t    }\n353\t    (*s).nlen = cp_build(\n354\t        ptr::null_mut(),\n355\t        (&raw mut (*s).len).cast::<u32>(),\n356\t        lenlens.as_ptr(),\n357\t        19,\n358\t    ) as u32;\n359\t\n360\t    // `uint8_t lens[288 + 32];` in C.  The run-length cases below may write a\n361\t    // little past `nlit + ndst`, so extra slack is reserved here (the C code\n362\t    // simply smashes its own stack in that case).\n363\t    let mut lens_storage = [0u8; 288 + 32 + 160];\n364\t    let lens = lens_storage.as_mut_ptr();\n365\t\n366\t    let mut n: c_int = 0;\n367\t    while n < nlit.wrapping_add(ndst) {\n368\t        let sym = cp_decode(s, (&raw mut (*s).len).cast::<u32>(), (*s).nlen as c_int);\n369\t        match sym {\n370\t            16 => {\n371\t                let mut i: c_int = 3i32.wrapping_add(cp_read_bits(s, 2) as c_int);\n372\t                while i != 0 {\n373\t                    *lens.wrapping_offset(n as isize) =\n374\t                        *lens.wrapping_offset((n.wrapping_sub(1)) as isize);\n375\t                    i = i.wrapping_sub(1);\n376\t                    n = n.wrapping_add(1);\n377\t                }\n378\t            }\n379\t            17 => {\n380\t                let mut i: c_int = 3i32.wrapping_add(cp_read_bits(s, 3) as c_int);\n381\t                while i != 0 {\n382\t                    *lens.wrapping_offset(n as isize) = 0;\n383\t                    i = i.wrapping_sub(1);\n384\t                    n = n.wrapping_add(1);\n385\t                }\n386\t            }\n387\t            18 => {\n388\t                let mut i: c_int = 11i32.wrapping_add(cp_read_bits(s, 7) as c_int);\n389\t                while i != 0 {\n390\t                    *lens.wrapping_offset(n as isize) = 0;\n391\t                    i = i.wrapping_sub(1);\n392\t                    n = n.wrapping_add(1);\n393\t                }\n394\t            }\n395\t            _ => {\n396\t                *lens.wrapping_offset(n as isize) = sym as u8;\n397\t                n = n.wrapping_add(1);\n398\t            }\n399\t        }\n400\t    }\n401\t    (*s).nlit = cp_build(s, (&raw mut (*s).lit).cast::<u32>(), lens, nlit) as u32;\n402\t    (*s).ndst = cp_build(\n403\t        ptr::null_mut(),\n404\t        (&raw mut (*s).dst).cast::<u32>(),\n405\t        lens.wrapping_offset(nlit as isize),\n406\t        ndst,\n407\t    ) as u32;\n408\t    1\n409\t}\n410\t\n411\tunsafe fn cp_block(s: *mut cp_state_t) -> c_int {\n412\t    loop {\n413\t        let mut symbol = cp_decode(s, (&raw mut (*s).lit).cast::<u32>(), (*s).nlit as c_int);\n414\t        if symbol < 256 {\n415\t            if !((*s).out.wrapping_offset(1) <= (*s).out_end) {\n416\t                cp_set_error!(\"Attempted to overwrite out buffer while outputting a symbol.\");\n417\t                return 0;\n418\t            }\n419\t            *(*s).out = symbol as c_char;\n420\t            (*s).out = (*s).out.wrapping_offset(1);\n421\t        } else if symbol > 256 {\n422\t            symbol = symbol.wrapping_sub(257);\n423\t            let length: c_int = cp_read_bits(\n424\t                s,\n425\t                *len_extra_bits_ptr().wrapping_offset(symbol as isize) as c_int,\n426\t            )\n427\t            .wrapping_add(*len_base_ptr().wrapping_offset(symbol as isize)) as c_int;\n428\t            let distance_symbol = cp_decode(s, (&raw mut (*s).dst).cast::<u32>(), (*s).ndst as c_int);\n429\t            let backwards_distance: c_int = cp_read_bits(\n430\t                s,\n431\t                *dist_extra_bits_ptr().wrapping_offset(distance_symbol as isize) as c_int,\n432\t            )\n433\t            .wrapping_add(*dist_base_ptr().wrapping_offset(distance_symbol as isize))\n434\t                as c_int;\n435\t            if !((*s)\n436\t                .out\n437\t                .wrapping_offset(-(backwards_distance as isize))\n438\t                >= (*s).begin)\n439\t            {\n440\t                cp_set_error!(\"Attempted to write before out buffer (invalid backwards distance).\");\n441\t                return 0;\n442\t            }\n443\t            if !((*s).out.wrapping_offset(length as isize) <= (*s).out_end) {\n444\t                cp_set_error!(\"Attempted to overwrite out buffer while outputting a string.\");\n445\t                return 0;\n446\t            }\n447\t            let mut src = (*s).out.wrapping_offset(-(backwards_distance as isize));\n448\t            let mut dst = (*s).out;\n449\t            (*s).out = (*s).out.wrapping_offset(length as isize);\n450\t            match backwards_distance {\n451\t                1 => {\n452\t                    memset(\n453\t                        dst as *mut c_void,\n454\t                        *src as c_int,\n455\t                        length as usize,\n456\t                    );\n457\t                }\n458\t                _ => {\n459\t                    let mut length = length;\n460\t                    while length != 0 {\n461\t                        length = length.wrapping_sub(1);\n462\t                        *dst = *src;\n463\t                        dst = dst.wrapping_offset(1);\n464\t                        src = src.wrapping_offset(1);\n465\t                    }\n466\t                }\n467\t            }\n468\t        } else {\n469\t            break;\n470\t        }\n471\t    }\n472\t    1\n473\t}\n474\t\n475\t#[unsafe(no_mangle)]\n476\tpub unsafe extern \"C\" fn cp_inflate(\n477\t    input: *mut c_void,\n478\t    in_bytes: c_int,\n479\t    out: *mut c_void,\n480\t    out_bytes: c_int,\n481\t) -> c_int {\n482\t    let s = calloc(1, core::mem::size_of::<cp_state_t>()) as *mut cp_state_t;\n483\t    (*s).bits = 0;\n484\t    (*s).count = 0;\n485\t    (*s).word_index = 0;\n486\t    (*s).bits_left = in_bytes.wrapping_mul(8);\n487\t    let in_addr = input as usize;\n488\t    let first_bytes: c_int = (((in_addr.wrapping_add(3)) & !3usize).wrapping_sub(in_addr)) as c_int;\n489\t    (*s).words = (input as *mut c_char).wrapping_offset(first_bytes as isize) as *mut u32;\n490\t    (*s).word_count = in_bytes.wrapping_sub(first_bytes) / 4;\n491\t    let last_bytes: c_int = in_bytes.wrapping_sub(first_bytes) & 3;\n492\t    {\n493\t        let mut i: c_int = 0;\n494\t        while i < first_bytes {\n495\t            let byte = *(input as *const u8).wrapping_offset(i as isize);\n496\t            (*s).bits |= (byte as u64).wrapping_shl((i.wrapping_mul(8)) as u32);\n497\t            i = i.wrapping_add(1);\n498\t        }\n499\t    }\n500\t    (*s).final_word_available = if last_bytes != 0 { 1 } else { 0 };\n501\t    (*s).final_word = 0;\n502\t    {\n503\t        let mut i: c_int = 0;\n504\t        while i < last_bytes {\n505\t            let byte = *(input as *const u8)\n506\t                .wrapping_offset((in_bytes.wrapping_sub(last_bytes).wrapping_add(i)) as isize);\n507\t            (*s).final_word |= (byte as u32).wrapping_shl((i.wrapping_mul(8)) as u32);\n508\t            i = i.wrapping_add(1);\n509\t        }\n510\t    }\n511\t    (*s).count = first_bytes.wrapping_mul(8);\n512\t    (*s).out = out as *mut c_char;\n513\t    (*s).out_end = (*s).out.wrapping_offset(out_bytes as isize);\n514\t    (*s).begin = out as *mut c_char;\n515\t\n516\t    let ok = cp_inflate_blocks(s);\n517\t    free(s as *mut c_void);\n518\t    ok\n519\t}\n520\t\n521\tunsafe fn cp_inflate_blocks(s: *mut cp_state_t) -> c_int {\n522\t    let mut count: c_int = 0;\n523\t    let mut bfinal: c_int;\n524\t    loop {\n525\t        bfinal = cp_read_bits(s, 1) as c_int;\n526\t        let btype = cp_read_bits(s, 2) as c_int;\n527\t        match btype {\n528\t            0 => {\n529\t                if cp_stored(s) == 0 {\n530\t                    return 0;\n531\t                }\n532\t            }\n533\t            1 => {\n534\t                cp_fixed(s);\n535\t                if cp_block(s) == 0 {\n536\t                    return 0;\n537\t                }\n538\t            }\n539\t            2 => {\n540\t                cp_dynamic(s);\n541\t                if cp_block(s) == 0 {\n542\t                    return 0;\n543\t                }\n544\t            }\n545\t            3 => {\n546\t                cp_set_error!(\"Detected unknown block type within input stream.\");\n547\t                return 0;\n548\t            }\n549\t            _ => {}\n550\t        }\n551\t        count = count.wrapping_add(1);\n552\t        if bfinal != 0 {\n553\t            break;\n554\t        }\n555\t    }\n556\t    let _ = count;\n557\t    1\n558\t}\n559\t\n560\t// ---------------------------------------------------------------------------\n561\t// PNG loading\n562\t// ---------------------------------------------------------------------------\n563\t\n564\tfn cp_paeth(a: u8, b: u8, c: u8) -> u8 {\n565\t    let p: c_int = (a as c_int).wrapping_add(b as c_int).wrapping_sub(c as c_int);\n566\t    let pa = (p.wrapping_sub(a as c_int)).wrapping_abs();\n567\t    let pb = (p.wrapping_sub(b as c_int)).wrapping_abs();\n568\t    let pc = (p.wrapping_sub(c as c_int)).wrapping_abs();\n569\t    if pa <= pb && pa <= pc {\n570\t        a\n571\t    } else if pb <= pc {\n572\t        b\n573\t    } else {\n574\t        c\n575\t    }\n576\t}\n577\t\n578\t#[repr(C)]\n579\tstruct cp_raw_png_t {\n580\t    p: *const u8,\n581\t    end: *const u8,\n582\t}\n583\t\n584\tunsafe fn cp_make32(s: *const u8) -> u32 {\n585\t    ((*s.wrapping_offset(0) as u32) << 24)\n586\t        | ((*s.wrapping_offset(1) as u32) << 16)\n587\t        | ((*s.wrapping_offset(2) as u32) << 8)\n588\t        | (*s.wrapping_offset(3) as u32)\n589\t}\n590\t\n591\t/// `memcmp(a, b, n) == 0`.  All `n` bytes are always read (just like the block\n592\t/// wise `mem