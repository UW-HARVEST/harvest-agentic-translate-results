}\n    close(fd[1]);\n    size_t need = sizeof(int)+sizeof(R->err)+tot, got=0; char *q=(char*)R;\n    while (got < need) { ssize_t k = read(fd[0], q+got, need-got); if (k<=0) break; got+=k; }\n    close(fd[0]);\n    int st; waitpid(p,&st,0);\n    return (WIFEXITED(st) && WEXITSTATUS(st)==0 && got==need) ? 0 : -1;\n}\n\nstatic res_t RA, RB;\nstatic void run(const char *tag, unsigned char *in, int in_bytes, int out_bytes)\n{\n    int ca = child(&RA,0,in,in_bytes,out_bytes);\n    int cb = child(&RB,1,in,in_bytes,out_bytes);\n    cases++;\n    if (ca) { skipped++; return; }\n    if (cb) { printf(\"[%s] Rust CRASHED where C returned %d err=\\\"%s\\\" (in=%d out=%d)\\n\",tag,RA.ret,RA.err,in_bytes,out_bytes); fails++; return; }\n    int bad=0, tot=out_bytes+2*PAD;\n    if (RA.ret != RB.ret) { printf(\"[%s] RET C=%d Rust=%d (in=%d out=%d)\\n\",tag,RA.ret,RB.ret,in_bytes,out_bytes); bad=1; }\n    if (memcmp(RA.buf,RB.buf,tot)) { int i; for(i=0;i<tot;i++) if(RA.buf[i]!=RB.buf[i]) break;\n        printf(\"[%s] DATA diff out[%d] C=%02x Rust=%02x (in=%d out=%d r=%d/%d)\\n\",tag,i-PAD,RA.buf[i],RB.buf[i],in_bytes,out_bytes,RA.ret,RB.ret); bad=1; }\n    if (strcmp(RA.err,RB.err)) { printf(\"[%s] ERRSTR C=\\\"%s\\\" Rust=\\\"%s\\\"\\n\",tag,RA.err,RB.err); bad=1; }\n    if (bad) { fails++; if (fails>15) { printf(\"aborting: too many\\n\"); exit(1);} }\n}\n\nstatic int rawdeflate(const unsigned char*s,int n,unsigned char*d,int cap,int l,int st){\n    z_stream z; memset(&z,0,sizeof z);\n    if(deflateInit2(&z,l,Z_DEFLATED,-15,9,st)!=Z_OK) return -1;\n    z.next_in=(Bytef*)s; z.avail_in=n; z.next_out=d; z.avail_out=cap;\n    int r=deflate(&z,Z_FINISH); int len=cap-z.avail_out; deflateEnd(&z);\n    return r==Z_STREAM_END?len:-1;\n}\n\nint main(int argc,char**argv){\n    setvbuf(stdout,0,_IONBF,0);\n    /* private mapping with PROT_NONE guards on both sides */\n    size_t span = 1u<<24;\n    char *base = mmap(0, span, PROT_NONE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);\n    IN = (unsigned char*)(base + (span/2));\n    mprotect(IN, 1u<<20, PROT_READ|PROT_WRITE);\n    int phase=argc>1?atoi(argv[1]):3, iters=argc>2?atoi(argv[2]):20000;\n    static unsigned char raw[300000], db[400000];\n    char tag[64];\n    if(phase==2) for(int it=0;it<iters;it++){\n        int n=1+(rnd()%3000);\n        for(int i=0;i<n;i++) raw[i]=(unsigned char)((rnd()%5)?('a'+rnd()%6):rnd());\n        int dl=rawdeflate(raw,n,db,sizeof db,(int)(rnd()%10),(int)(rnd()%4));\n        if(dl<=0||dl>60000) continue;\n        int nm=1+rnd()%4; for(int m=0;m<nm;m++) db[rnd()%dl]^=(unsigned char)(1u<<(rnd()%8));\n        int off=rnd()%8; memset(IN,0,70000); memcpy(IN+off,db,dl);\n        int outb=1+rnd()%MAXO;\n        snprintf(tag,sizeof tag,\"mut %d\",it);\n        run(tag,IN+off,dl,outb);\n    }\n    if(phase==3) for(int it=0;it<iters;it++){\n        int dl=1+rnd()%300;\n        for(int i=0;i<dl;i++) db[i]=(unsigned char)rnd();\n        int off=rnd()%8; memset(IN,0,1024); memcpy(IN+off,db,dl);\n        int outb=1+rnd()%MAXO;\n        snprintf(tag,sizeof tag,\"rand %d\",it);\n        run(tag,IN+off,dl,outb);\n    }\n    if(phase==5) for(int it=0;it<iters;it++){   /* stored blocks, byte aligned */\n        int dl=0, nb=1+rnd()%3;\n        for(int b=0;b<nb;b++){\n            int final=(b==nb-1); int len=rnd()%80;\n            db[dl++]=final; int nlen=~len&0xFFFF; if(rnd()%8==0) nlen^=1;\n            db[dl++]=len&0xFF; db[dl++]=(len>>8)&0xFF; db[dl++]=nlen&0xFF; db[dl++]=(nlen>>8)&0xFF;\n            for(int i=0;i<len;i++) db[dl++]=(unsigned char)rnd();\n        }\n        int off=rnd()%8; memset(IN,0,1024); memcpy(IN+off,db,dl);\n        int outb=1+rnd()%512;\n        snprintf(tag,sizeof tag,\"stored %d\",it);\n        run(tag,IN+off,dl,outb);\n    }\n    printf(\"phase%d cases=%ld c_crashed_skipped=%ld fails=%ld\\n\",phase,cases,skipped,fails);\n    return fails!=0;\n}\nEOF\ngcc -O1 -o dtest5 diff5.c cdefl.o librusttr.a -lz -lpthread -ldl -lm 2>&1|head && echo BUILT && ./dtest5 3 20000 2>&1 | t