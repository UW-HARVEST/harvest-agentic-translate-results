 osz = out_bytes > 0 ? (size_t)out_bytes : 0;\n  uint8_t *ob = calloc(1, osz + 4096);\n  *errp = NULL;\n  int r = inflate_(ib, in_bytes, ob, out_bytes);\n  printf(\"%s ret=%d hash=%016llx err=%s\\n\", tag, r,\n         (unsigned long long)fnv(ob, osz + 4096), *errp ? *errp : \"(null)\");\n  fflush(stdout);\n}\nstatic void do_png(const char *tag, const void *in, size_t n, int len_arg) {\n  uint8_t *b = padded(in, n);\n  *errp = NULL;\n  img_t im = load(b, len_arg);\n  long long bytes = im.pix ? (long long)im.w * im.h * 4 : -1;\n  if (bytes < 0 && im.pix) bytes = 0;\n  printf(\"%s w=%d h=%d pix=%d hash=%016llx err=%s\\n\", tag, im.w, im.h, im.pix ? 1 : 0,\n         im.pix ? (unsigned long long)fnv(im.pix, (size_t)bytes) : 0ULL,\n         *errp ? *errp : \"(null)\");\n  fflush(stdout);\n  free(im.pix);\n}\n\nint main(int argc, char **argv) {\n  void *h = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n  if (!h) { fprintf(stderr, \"%s\\n\", dlerror()); return 2; }\n  load = (load_fn)dlsym(h, \"load_png_mem\");\n  inflate_ = (inflate_fn)dlsym(h, \"cp_inflate\");\n  errp = (const char **)dlsym(h, \"cp_error_reason\");\n  uint8_t *ft = dlsym(h, \"cp_fixed_table\"), *po = dlsym(h, \"cp_permutation_order\");\n  uint8_t *lex = dlsym(h, \"cp_len_extra_bits\"), *dex = dlsym(h, \"cp_dist_extra_bits\");\n  uint32_t *lb = dlsym(h, \"cp_len_base\"), *db = dlsym(h, \"cp_dist_base\");\n  printf(\"syms load=%d inflate=%d err=%d ft=%d po=%d lex=%d lb=%d dex=%d db=%d\\n\",\n         !!load, !!inflate_, !!errp, !!ft, !!po, !!lex, !!lb, !!dex, !!db);\n  printf(\"initial err=%s\\n\", *errp ? *errp : \"(null)\");\n  printf(\"tables ft=%016llx po=%016llx lex=%016llx lb=%016llx dex=%016llx db=%016llx\\n\",\n         (unsigned long long)fnv(ft, 320), (unsigned long long)fnv(po, 19),\n         (unsigned long long)fnv(lex, 31), (unsigned long long)fnv(lb, 124),\n         (unsigned long long)fnv(dex, 32), (unsigned long long)fnv(db, 128));\n\n  size_t vn; uint8_t *valid = slurp(argv[2], &vn);\n  size_t sn; uint8_t *stream = slurp(argv[3], &sn);\n\n  do_inflate(\"inf/null0\", NULL, 0, 64);\n  do_inflate(\"inf/empty\", stream, 0, 64);\n  do_inflate(\"inf/neg1\", stream, -1, 64);\n  do_inflate(\"inf/neg8\", stream, -8, 64);\n  do_inflate(\"inf/outneg\", stream, (int)sn, -1);\n  do_inflate(\"inf/out0\", stream, (int)sn, 0);\n  do_inflate(\"inf/out1\", stream, (int)sn, 1);\n  do_inflate(\"inf/full\", stream, (int)sn, 65536);\n  do_inflate(\"inf/short3\", stream, 3, 65536);\n  do_inflate(\"inf/short7\", stream, 7, 65536);\n  for (int k = 1; k <= 8; k++) {\n    char tag[64]; snprintf(tag, sizeof tag, \"inf/pre%d\", k);\n    do_inflate(tag, stream, (int)sn - k, 65536);\n  }\n  do_png(\"png/len0\", valid, vn, 0);\n  do_png(\"png/lenneg\", valid, vn, -1);\n  do_png(\"png/lenneg100\", valid, vn, -100);\n  do_png(\"png/len7\", valid, vn, 7);\n  do_png(\"png/len8\", valid, vn, 8);\n  do_png(\"png/len32\", valid, vn, 32);\n  do_png(\"png/full\", valid, vn, (int)vn);\n  for (int off = 1; off < 8; off++) {\n    char tag[64]; snprintf(tag, sizeof tag, \"png/off%d\", off);\n    uint8_t *b = padded(valid, vn);\n    memmove(b + off, b, vn);\n    *errp = NULL;\n    img_t im = load(b + off, (int)vn);\n    printf(\"%s w=%d h=%d pix=%d hash=%016llx err=%s\\n\", tag, im.w, im.h, im.pix ? 1 : 0,\n           im.pix ? (unsigned long long)fnv(im.pix, (size_t)im.w * im.h * 4) : 0ULL,\n           *errp ? *errp : \"(null)\");\n    fflush(stdout);\n    free(im.pix);\n  }\n  for (int i = 0; i < 3; i++) do_png(\"png/repeat\", valid, vn, (int)vn);\n  do_png(\"png/bad\", \"notapng!\", 8, 8);\n  do_png(\"png/after-bad\", valid, vn, (int)vn);\n\n  uint8_t save_ft[320]; memcpy(save_ft, ft, 320);\n  ft[0] = 9; ft[287] = 7; ft[288] = 6;\n  do_png(\"png/ft-mut\", valid, vn, (int)vn);\n  do_inflate(\"inf/ft-mut\", stream, (int)sn, 65536);\n  memcpy(ft, save_ft, 320);\n  do_png(\"png/ft-restored\", valid, vn, (int)vn);\n\n  uint8_t save_po[19]; memcpy(save_po, po, 19);\n  po[0] = 15; po[18] = 16;\n  do_infla