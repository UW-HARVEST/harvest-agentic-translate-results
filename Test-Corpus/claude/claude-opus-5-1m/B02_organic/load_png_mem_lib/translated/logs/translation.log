    let mask = (1u64.wrapping_shl(num_bits_to_read as u32)).wrapping_sub(1);\n199\t    let bits = ((*s).bits & mask) as u32;\n200\t    (*s).bits = (*s).bits.wrapping_shr(num_bits_to_read as u32);\n201\t    (*s).count = (*s).count.wrapping_sub(num_bits_to_read);\n202\t    (*s).bits_left = (*s).bits_left.wrapping_sub(num_bits_to_read);\n203\t    bits\n204\t}\n205\t\n206\tunsafe fn cp_read_bits(s: *mut cp_state_t, num_bits_to_read: c_int) -> u32 {\n207\t    cp_peak_bits(s, num_bits_to_read);\n208\t    cp_consume_bits(s, num_bits_to_read)\n209\t}\n210\t\n211\tfn cp_rev16(a: u32) -> u32 {\n212\t    let mut a = a;\n213\t    a = ((a & 0xAAAA) >> 1) | ((a & 0x5555) << 1);\n214\t    a = ((a & 0xCCCC) >> 2) | ((a & 0x3333) << 2);\n215\t    a = ((a & 0xF0F0) >> 4) | ((a & 0x0F0F) << 4);\n216\t    a = ((a & 0xFF00) >> 8) | ((a & 0x00FF) << 8);\n217\t    a\n218\t}\n219\t\n220\tunsafe fn cp_build(\n221\t    s: *mut cp_state_t,\n222\t    tree: *mut u32,\n223\t    lens: *const u8,\n224\t    sym_count: c_int,\n225\t) -> c_int {\n226\t    // The C code uses `int codes[16], first[16], counts[16]`; larger arrays are\n227\t    // used here so that (undefined in C) out of range code lengths cannot\n228\t    // corrupt unrelated memory.\n229\t    let mut codes = [0i32; 256];\n230\t    let mut first = [0i32; 256];\n231\t    let mut counts = [0i32; 256];\n232\t\n233\t    let mut n: c_int = 0;\n234\t    while n < sym_count {\n235\t        let idx = *lens.wrapping_offset(n as isize) as usize;\n236\t        counts[idx] = counts[idx].wrapping_add(1);\n237\t        n = n.wrapping_add(1);\n238\t    }\n239\t    counts[0] = 0;\n240\t    codes[0] = 0;\n241\t    first[0] = 0;\n242\t    for n in 1usize..=15usize {\n243\t        codes[n] = codes[n - 1].wrapping_add(counts[n - 1]).wrapping_mul(2);\n244\t        first[n] = first[n - 1].wrapping_add(counts[n - 1]);\n245\t    }\n246\t    if !s.is_null() {\n247\t        ptr::write_bytes(\n248\t            (&raw mut (*s).lookup).cast::<u8>(),\n249\t         