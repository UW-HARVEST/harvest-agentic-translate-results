\n  for (int c = NCL - 1; c >= 0; c--)\n    for (int j = NPER - 1; j >= 0; j--) free(keep[c][j]);\n  size_t big = 2u << 20;\n  void *p = malloc(big); memset(p, 0xC3, big); free(p);\n}\n\nstatic char *shared;\n#define SHSZ 8192\n\nint main(int argc, char **argv) {\n  if (argc < 3) { fprintf(stderr, \"usage: runner <lib> <out>\\n\"); return 2; }\n  void *h = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n  if (!h) { fprintf(stderr, \"dlopen: %s\\n\", dlerror()); return 2; }\n  load_fn load = (load_fn)dlsym(h, \"load_png_mem\");\n  inflate_fn inflate_ = (inflate_fn)dlsym(h, \"cp_inflate\");\n  const char **err = (const char **)dlsym(h, \"cp_error_reason\");\n  if (!load || !inflate_ || !err) { fprintf(stderr, \"dlsym failed\\n\"); return 2; }\n\n  FILE *out = fopen(argv[2], \"w\");\n  shared = (char *)mmap(NULL, SHSZ, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);\n\n  size_t clen; uint8_t *cases = slurp(getenv(\"PNGCASES\") ? getenv(\"PNGCASES\") : \"c1_png.bin\", &clen);\n  uint32_t ncases; memcpy(&ncases, cases, 4);\n  size_t off = 4;\n  for (uint32_t i = 0; i < ncases; i++) {\n    uint32_t sz; memcpy(&sz, cases + off, 4); off += 4;\n    uint8_t *png = cases + off; off += sz;\n    memset(shared, 0, SHSZ);\n    pid_t pid = fork();\n    if (pid == 0) {\n      /* zero padding behind the input: the C code reads a few bytes past the\n       * end of the buffer, that must be identical for both libraries */\n      size_t pad = 1 << 17;\n      uint8_t *buf = (uint8_t *)calloc(1, sz + pad);\n      memcpy(buf, png, sz);\n      heap_prime();\n      *err = NULL;\n      img_t im = load(buf, (int)sz);\n      uint64_t ph = 0, pixh = 0; long long bytes = -1;\n      if (im.pix) {\n        bytes = (long long)(im.w + 1) * im.h * 4; if (bytes < 0) bytes = 0;\n        ph = fnv(im.pix, (size_t)bytes);\n        long long pb = (long long)im.w * im.h * 4; if (pb < 0) pb = 0;\n        pixh = fnv(im.pix, (size_t)pb);\n      }\n      snprintf(shared, SHSZ, \"w=%d h=%d pix=%d bytes=%lld pixhash=%016llx hash=%016llx err=%s\",\n               im.w, im.h, im.pix ? 1 : 0, bytes, (unsigned long long)pixh,\n               (unsigned long long)ph, *err ? *err : \"(null)\");\n      _exit(0);\n    }\n    int st = 0; waitpid(pid, &st, 0);\n    fprintf(out, \"png[%u] exit=%d sig=%d %s\\n\", i, WIFEXITED(st) ? WEXITSTATUS(st) : -1,\n            WIFSIGNALED(st) ? WTERMSIG(st) : 0, shared);\n  }\n\n  size_t ilen; uint8_t *ic = slurp(getenv(\"INFCASES\") ? getenv(\"INFCASES\") : \"c1_inf.bin\", &ilen);\n  uint32_t nin; memcpy(&nin, ic, 4);\n  off = 4;\n  for (uint32_t i = 0; i < nin; i++) {\n    uint32_t sz, ob; memcpy(&sz, ic + off, 4); memcpy(&ob, ic + off + 4, 4); off += 8;\n    uint8_t *body = ic + off; off += sz;\n    for (int align = 0; align < 4; align++) {\n      memset(shared, 0, SHSZ);\n      pid_t pid = fork();\n      if (pid == 0) {\n        size_t slack = 70000, inpad = 1 << 17;\n        size_t insz = ((sz + align + 64) / 64 + 1) * 64 + inpad;\n        uint8_t *inbuf = (uint8_t *)aligned_alloc(64, insz);\n        memset(inbuf, 0, insz);\n        memcpy(inbuf + align, body, sz);\n        uint8_t *ob_buf = (uint8_t *)calloc(1, ob + slack);\n        heap_prime();\n        *err = NULL;\n        int r = inflate_(inbuf + align, (int)sz, ob_buf, (int)ob);\n        snprintf(shared, SHSZ, \"ret=%d hash=%016llx err=%s\", r,\n                 (unsigned long long)fnv(ob_buf, ob + slack), *err ? *err : \"(null)\");\n        _exit(0);\n      }\n      int st = 0; waitpid(pid, &st, 0);\n      fprintf(out, \"inf[%u,a%d] exit=%d sig=%d %s\\n\", i, align,\n              WIFEXITED(st) ? WEXITSTATUS(st) : -1,\n              WIFSIGNALED(st) ? WTERMSIG(st) : 0, shared);\n    }\n  }\n  fclose(out);\n  return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7501,"cache_read_input_tokens":202212,"cache_creation":{"ephemeral_5m_input_tokens":7501,"ephemeral_1h_input_tokens":0},"output_tokens":20,"ser