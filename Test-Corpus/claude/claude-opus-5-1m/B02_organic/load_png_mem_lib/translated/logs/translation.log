th.join(D,\"mut\",\"target\",\"release\",\"libtranslated_rust.so\")\n    shutil.copy(so, os.path.join(D,\"libmut.so\"))\n    detected = []\n    for corp,ref in ((\"corpus\",\"c.out\"),(\"corpus2\",\"c2.out\")):\n        out = subprocess.run([os.path.join(D,\"driver2\"), os.path.join(D,\"libmut.so\"), os.path.join(D,corp)],\n                             capture_output=True, text=True, env=dict(os.environ, MALLOC_PERTURB_=\"42\"), timeout=1200)\n        refl = open(os.path.join(D,ref)).read().splitlines()\n        gotl = out.stdout.splitlines()\n        nd = sum(1 for a,b in zip(refl,gotl) if a!=b) + abs(len(refl)-len(gotl))\n        detected.append(\"%s:%d/%d\" % (corp, nd, len(refl)))\n    results[name] = \"DETECTED \" + \" \".join(detected) if any(int(x.split(\":\")[1].split(\"/\")[0])>0 for x in detected) else \"NOT-DETECTED \" + \" \".join(detected)\nopen(os.path.join(D,\"mut\",\"src\",\"lib.rs\"),\"w\").write(base)\nfor k,v in results.items(): print(\"%-22s %s\" % (k,v))\nPY\npython3 \"$D/mutate.py\" 2>&1 | tail -40","task_type":"local_bash","uuid":"13fdf280-8b12-4375-b807-5249fad5d7c6","session_id":"12bb7159-3236-4ecd-a592-3d03b0ce2dfb"}
