n296\t    (*s).out = (*s).out.wrapping_offset(LEN as isize);\n297\t    1\n298\t}\n299\t\n300\tunsafe fn cp_fixed(s: *mut cp_state_t) -> c_int {\n301\t    (*s).nlit = cp_build(s, (&raw mut (*s).lit).cast::<u32>(), fixed_table_ptr(), 288) as u32;\n302\t    (*s).ndst = cp_build(\n303\t        ptr::null_mut(),\n304\t        (&raw mut (*s).dst).cast::<u32>(),\n305\t        fixed_table_ptr().wrapping_add(288),\n306\t        32,\n307\t    ) as u32;\n308\t    1\n309\t}\n310\t\n311\tunsafe fn cp_decode(s: *mut cp_state_t, tree: *mut u32, hi: c_int) -> c_int {\n312\t    let bits = cp_peak_bits(s, 16);\n313\t    let search = (cp_rev16(bits as u32) << 16) | 0xFFFF;\n314\t    let mut lo: c_int = 0;\n315\t    let mut hi = hi;\n316\t    while lo < hi {\n317\t        let guess = (lo.wrapping_add(hi)) >> 1;\n318\t        if search < *tree.wrapping_offset(guess as isize) {\n319\t            hi = guess;\n320\t        } else {\n321\t            lo = guess.wrapping_add(1);\n322\t        }\n323\t    }\n324\t    let key = *tree.wrapping_offset((lo.wrapping_sub(1)) as isize);\n325\t    let code = cp_consume_bits(s, (key & 0xF) as c_int);\n326\t    let _ = code;\n327\t    ((key >> 4) & 0xFFF) as c_int\n328\t}\n329\t\n330\tunsafe fn cp_dynamic(s: *mut cp_state_t) -> c_int {\n331\t    // `uint8_t lenlens[19] = {0};` in C.  Slack is reserved because\n332\t    // `cp_permutation_order` is a public (writable) symbol and may contain\n333\t    // values >= 19, in which case the C code writes past the array.\n334\t    let mut lenlens = [0u8; 19 + 256];\n335\t    let nlit: c_int = 257i32.wrapping_add(cp_read_bits(s, 5) as c_int);\n336\t    let ndst: c_int = 1i32.wrapping_add(cp_read_bits(s, 5) as c_int);\n337\t    let nlen: c_int = 4i32.wrapping_add(cp_read_bits(s, 4) as c_int);\n338\t    {\n339\t        let mut i: c_int = 0;\n340\t        while i < nlen {\n341\t            let slot = *permutation_order_ptr().wrapping_offset(i as isize) as usize;\n342\t            let v = cp_read_bits(s, 3) as u8;\n343\t            *(lenlens.as_mut_ptr()).wrapping_add(slot) = v;\n344\t            i = i.wrapping_add(1);\n345\t        }\n346\t    }\n347\t    (*s).nlen = cp_build(\n348\t        ptr::null_mut(),\n349\t        (&raw mut (*s).len).cast::<u32>(),\n350\t        lenlens.as_ptr(),\n351\t        19,\n352\t    ) as u32;\n353\t\n354\t    // `uint8_t lens[288 + 32];` in C.  The run-length cases below may write a\n355\t    // little past `nlit + ndst`, so extra slack is reserved here (the C code\n356\t    // simply smashes its own stack in that case).\n357\t    let mut lens_storage = [0u8; 288 + 32 + 160];\n358\t    let lens = lens_storage.as_mut_ptr();\n359\t\n360\t    let mut n: c_int = 0;\n361\t    while n < nlit.wrapping_add(ndst) {\n362\t        let sym = cp_decode(s, (&raw mut (*s).len).cast::<u32>(), (*s).nlen as c_int);\n363\t        match sym {\n364\t            16 => {\n365\t                let mut i: c_int = 3i32.wrapping_add(cp_read_bits(s, 2) as c_int);\n366\t                while i != 0 {\n367\t                    *lens.wrapping_offset(n as isize) =\n368\t                        *lens.wrapping_offset((n.wrapping_sub(1)) as isize);\n369\t                    i = i.wrapping_sub(1);\n370\t                    n = n.wrapping_add(1);\n371\t                }\n372\t            }\n373\t            17 => {\n374\t                let mut i: c_int = 3i32.wrapping_add(cp_read_bits(s, 3) as c_int);\n375\t                while i != 0 {\n376\t                    *lens.wrapping_offset(n as isize) = 0;\n377\t                    i = i.wrapping_sub(1);\n378\t                    n = n.wrapping_add(1);\n379\t                }\n380\t            }\n381\t            18 => {\n382\t                let mut i: c_int = 11i32.wrapping_add(cp_read_bits(s, 7) as c_int);\n383\t                while i != 0 {\n384\t                    *lens.wrapping_offset(n as isize) = 0;\n385\t                    i = i.wrapping_sub(1);\n386\t                    n = n.wrapping_add(1);\n387\t                }\n388\