{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_h3xqoqzdi2pceqvqx76r5lbhx6iele5gwl4k3gufricdq72ryqxq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01ToK765BgVV1JKMBeKh9U5y","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-translate-YYTuEm/tmp/verify_main/gen.py","content":"#!/usr/bin/env python3\n\"\"\"Generates the differential-test corpora for the cute_png translation.\"\"\"\nimport zlib, struct, random, sys, os\n\ndef chunk(t, d):\n    return struct.pack('>I', len(d)) + t + d + struct.pack('>I', zlib.crc32(t + d) & 0xffffffff)\n\nBPP = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}\n\ndef mkpng(w, h, ct, rows, plte=None, trns=None, level=6, strategy=0, split=1,\n          post_hdr=b'', idat_extra=None):\n    out = b'\\x89PNG\\r\\n\\x1a\\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, ct, 0, 0, 0)) + post_hdr\n    if plte is not None: out += chunk(b'PLTE', plte)\n    if trns is not None: out += chunk(b'tRNS', trns)\n    co = zlib.compressobj(level, zlib.DEFLATED, 15, 8, strategy)\n    comp = co.compress(b''.join(rows)) + co.flush()\n    step = max(1, (len(comp) + split - 1) // split)\n    for i in range(0, len(comp), step):\n        out += chunk(b'IDAT', comp[i:i + step])\n        if idat_extra: out += idat_extra\n    return out + chunk(b'IEND', b'')\n\ndef rows_for(w, h, ct, rnd, filt='mix'):\n    bpp = BPP[ct]; out = []\n    for y in range(h):\n        f = rnd.choice([0, 1, 2, 3, 4]) if filt == 'mix' else filt\n        out.append(bytes([f]) + bytes(rnd.randrange(256) for _ in range(w * bpp)))\n    return out\n\ndef write_png(path, cases):\n    with open(path, 'wb') as f:\n        f.write(struct.pack('<I', len(cases)))\n        for c in cases:\n            f.write(struct.pack('<I', len(c))); f.write(c)\n    print(path, len(cases))\n\ndef write_inf(path, cases):\n    with open(path, 'wb') as f:\n        f.write(struct.pack('<I', len(cases)))\n        for body, ob in cases:\n            f.write(struct.pack('<II', len(body), ob)); f.write(body)\n    print(path, len(cases))\n\n# ---------------------------------------------------------------- corpus 1\nrnd = random.Random(1234)\ncases = []\nfor ct in (0, 2, 3, 4, 6):\n    for (w, h) in ((1, 1), (3, 2), (7, 5), (16, 16), (33, 17), (64, 1), (1, 64)):\n        for filt in (0, 1, 2, 3, 4, 'mix'):\n            rows = rows_for(w, h, ct, rnd, filt)\n            plte = bytes(rnd.randrange(256) for _ in range(768)) if ct == 3 else None\n            trns = bytes(rnd.randrange(256) for _ in range(rnd.randrange(1, 256))) \\\n                if (ct == 3 and rnd.random() < .5) else None\n            for level in (0, 1, 6, 9):\n                for split in (1, 3):\n                    cases.append(mkpng(w, h, ct, rows, plte, trns, level=level, split=split))\nfor strat in (zlib.Z_FILTERED, zlib.Z_HUFFMAN_ONLY, zlib.Z_RLE, zlib.Z_FIXED):\n    for ct in (0, 2, 6, 3):\n        rows = rows_for(23, 11, ct, rnd)\n        plte = bytes(rnd.randrange(256) for _ in range(768)) if ct == 3 else None\n        cases.append(mkpng(23, 11, ct, rows, plte, level=9, strategy=strat))\nfor ct in (0, 6):\n    bpp = BPP[ct]\n    cases.append(mkpng(40, 20, ct, [bytes([0]) + bytes([0x55] * (40 * bpp))] * 20, level=9))\n    cases.append(mkpng(40, 20, ct, [bytes([4]) + bytes(40 * bpp)] * 20, level=1))\ncases.append(mkpng(9, 9, 2, rows_for(9, 9, 2, rnd),\n                   post_hdr=chunk(b'gAMA', struct.pack('>I', 45455)) + chunk(b'sRGB', b'\\x00')))\nbase = cases[0]\nmal = [b'', b'\\x89PNG', b'\\x89PNG\\r\\n\\x1a\\n', b'not a png file at all!!',\n       base[:20], base[:len(base) // 2], base[:-12]]\nfor pos, val in ((24, 16), (25, 5), (26, 1), (27, 1), (28, 1)):\n    b = bytearray(base); b[pos] = val; mal.append(bytes(b))\nfor sl, val in ((slice(16, 20), 0), (slice(20, 24), 0), (slice(20, 24), 0xFFFFFFFF),\n                (slice(16, 20), 0xFFFFFFFF)):\n    b = bytearray(base); b[sl] = struct.pack('>I', val); mal.append(bytes(b))\nb = bytea