or split in (1,3):\n                    cases.append(png(w,h,8,colortype,rows,plte,trns,level=level,idat_split=split))\n# strategies (fixed huffman / rle / huffman only)\nfor strat in (zlib.Z_FILTERED, zlib.Z_HUFFMAN_ONLY, zlib.Z_RLE, zlib.Z_FIXED):\n    for colortype in (0,2,6,3):\n        bpp=bpp_of[colortype]\n        w,h=23,11\n        rows=[bytes([rnd.choice([0,1,2,3,4])]) + bytes(rnd.randrange(256) for _ in range(w*bpp)) for _ in range(h)]\n        plte = bytes(rnd.randrange(256) for _ in range(256*3)) if colortype==3 else None\n        cases.append(png(w,h,8,colortype,rows,plte,None,level=9,strategy=strat))\n# uniform data (RLE / distance-1 paths)\nfor colortype in (0,6):\n    bpp=bpp_of[colortype]\n    w,h=40,20\n    rows=[bytes([0])+bytes([0x55]*(w*bpp)) for _ in range(h)]\n    cases.append(png(w,h,8,colortype,rows,level=9))\n    rows=[bytes([4])+bytes([0]*(w*bpp)) for _ in range(h)]\n    cases.append(png(w,h,8,colortype,rows,level=1))\n# extra chunks before/after\ncases.append(png(9,9,8,2,[bytes([0])+bytes(rnd.randrange(256) for _ in range(27)) for _ in range(9)],\n                extra_chunks=chunk(b'gAMA', struct.pack('>I',45455))+chunk(b'sRGB', b'\\x00')))\n# malformed / edge cases\nbase = cases[0]\nmal = []\nmal.append(b'')\nmal.append(b'\\x89PNG')\nmal.append(b'\\x89PNG\\r\\n\\x1a\\n')\nmal.append(b'not a png file at all!!')\nmal.append(base[:20])\nmal.append(base[:len(base)//2])\nmal.append(base[:-12])\nb = bytearray(base); b[24]=16; mal.append(bytes(b))            # bit depth 16\nb = bytearray(base); b[25]=5;  mal.append(bytes(b))            # bad color type\nb = bytearray(base); b[26]=1;  mal.append(bytes(b))            # compression != 0\nb = bytearray(base); b[27]=1;  mal.append(bytes(b))            # filter != 0\nb = bytearray(base); b[28]=1;  mal.append(bytes(b))            # interlace\nb = bytearray(base); b[16:20]=struct.pack('>I',0); mal.append(bytes(b))  # width 0\nb = bytearray(base); b[20:24]=struct.pack('>I',0); mal.append(bytes(b))  # height 0\nb = bytearray(base); b[20:24]=struct.pack('>I',0xFFFFFFFF); mal.append(bytes(b))\nb = bytearray(base); b[16:20]=struct.pack('>I',0xFFFFFFFF); mal.append(bytes(b))\nb = bytearray(base); b[16:20]=struct.pack('>I',100000); b[20:24]=struct.pack('>I',100000); mal.append(bytes(b))\nb = bytearray(base); b[12:16]=b'IHDX'; mal.append(bytes(b))    # no IHDR\n# palette color type without PLTE\nrows=[bytes([0])+bytes([3]*5) for _ in range(4)]\nmal.append(png(5,4,8,3,rows,plte=None))\n# corrupt zlib header\np = png(6,6,8,2,[bytes([0])+bytes(rnd.randrange(256) for _ in range(18)) for _ in range(6)])\ni = p.index(b'IDAT')+4\nb = bytearray(p); b[i]=0x09; mal.append(bytes(b))              # bad cm\nb = bytearray(p); b[i]=0x88; mal.append(bytes(b))              # window too big\nb = bytearray(p); b[i+1] |= 0x20; mal.append(bytes(b))         # preset dict\nb = bytearray(p); b[i+4] ^= 0xFF; mal.append(bytes(b))         # corrupt deflate body\nb = bytearray(p); b[i+5] ^= 0xFF; mal.append(bytes(b))\nb = bytearray(p); b[i+2] ^= 0xFF; mal.append(bytes(b))\n# tiny/zero IDAT\nmal.append(png(4,4,8,0,[bytes([0])+bytes(4) for _ in range(4)]).replace(b'IDAT',b'IDAT',1))\nb = png(4,4,8,0,[bytes([0])+bytes(4) for _ in range(4)])\nj = b.index(b'IDAT')-4\n# replace IDAT chunk with 2-byte one\nnewidat = chunk(b'IDAT', b'\\x78\\x9c')\nk = j+8+struct.unpack('>I', b[j:j+4])[0]+4\nmal.append(b[:j]+newidat+b[k:])\n# stored (uncompressed) deflate block png\nfor (w,h,ct) in ((5,5,0),(5,5,6),(9,3,2)):\n    bpp=bpp_of[ct]\n    raw=b''.join(bytes([0])+bytes(rnd.randrange(256) for _ in range(w*bpp)) for _ in range(h))\n    co=zlib.compressobj(0,zlib.DEFLATED,15)\n    comp=co.compress(raw)+co.flush()\n    out=b'\\x89PNG\\r\\n\\x1a\\n'+chunk(b'IHDR',struct.pack('>IIBBBBB',w,h,8,ct,0,0,0))+chunk(b'IDAT',comp)+chunk(b'IEND',b'')\n    cases.append(out)\n# random garbage\nfor i in range(40):\n    n=rnd.randrange(0,200)\n    mal.append(bytes(rnd.randrange(256) for _ in range(n)))\nfor i in range(20):\n    n=r