{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GCXW6sUrVsQcMBMPRqJYA4","type":"tool_result","content":"1\t//! Rust translation of the C library located in `c_src/`.\n2\t//!\n3\t//! The C library is a single-file PNG loader (cute_png style).  This\n4\t//! translation reproduces the *exact* observable behaviour of the C code,\n5\t//! including its quirks and bugs, and exports the very same public ABI:\n6\t//!\n7\t//!   * functions: `cp_inflate`, `load_png_mem`\n8\t//!   * data:      `cp_error_reason`, `cp_fixed_table`, `cp_permutation_order`,\n9\t//!                `cp_len_extra_bits`, `cp_len_base`, `cp_dist_extra_bits`,\n10\t//!                `cp_dist_base`\n11\t//!\n12\t//! The C sources are compiled with `NDEBUG` semantics in mind (the `assert()`\n13\t//! calls of the original are pure debugging aids and have no effect on the\n14\t//! produced output), therefore they are not reproduced here.\n15\t\n16\t#![allow(non_camel_case_types)]\n17\t#![allow(non_upper_case_globals)]\n18\t#![allow(non_snake_case)]\n19\t#![allow(unused_assignments)]\n20\t#![allow(unused_variables)]\n21\t\n22\tuse core::ffi::{c_char, c_int, c_void};\n23\tuse core::ptr;\n24\t\n25\textern \"C\" {\n26\t    fn malloc(size: usize) -> *mut c_void;\n27\t    fn calloc(nmemb: usize, size: usize) -> *mut c_void;\n28\t    fn free(ptr: *mut c_void);\n29\t    fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n30\t    fn memset(dst: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n31\t}\n32\t\n33\t// ---------------------------------------------------------------------------\n34\t// public types (see include/lib.h)\n35\t// ---------------------------------------------------------------------------\n36\t\n37\t#[repr(C)]\n38\t#[derive(Copy, Clone)]\n39\tpub struct cp_pixel_t {\n40\t    pub r: u8,\n41\t    pub g: u8,\n42\t    pub b: u8,\n43\t    pub a: u8,\n44\t}\n45\t\n46\t#[repr(C)]\n47\t#[derive(Copy, Clone)]\n48\tpub struct cp_image_t {\n49\t    pub