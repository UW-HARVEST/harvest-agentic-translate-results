= (*t).wrapping_add(v);\n690\t                    x = x.wrapping_add(1);\n691\t                }\n692\t            }\n693\t            2 => {\n694\t                x = 0;\n695\t                while x < bpp {\n696\t                    let v = *prev.wrapping_offset(x as isize);\n697\t                    let t = raw.wrapping_offset(x as isize);\n698\t                    *t = (*t).wrapping_add(v);\n699\t                    x = x.wrapping_add(1);\n700\t                }\n701\t                while x < len {\n702\t                    let v = *prev.wrapping_offset(x as isize);\n703\t                    let t = raw.wrapping_offset(x as isize);\n704\t                    *t = (*t).wrapping_add(v);\n705\t                    x = x.wrapping_add(1);\n706\t                }\n707\t            }\n708\t            3 => {\n709\t                x = 0;\n710\t                while x < bpp {\n711\t                    let v = *prev.wrapping_offset(x as isize) / 2;\n712\t                    let t = raw.wrapping_offset(x as isize);\n713\t                    *t = (*t).wrapping_add(v);\n714\t                    x = x.wrapping_add(1);\n715\t                }\n716\t                while x < len {\n717\t                    let a = *raw.wrapping_offset((x.wrapping_sub(bpp)) as isize) as c_int;\n718\t                    let b = *prev.wrapping_offset(x as isize) as c_int;\n719\t                    let v = (a.wrapping_add(b) / 2) as u8;\n720\t                    let t = raw.wrapping_offset(x as isize);\n721\t                    *t = (*t).wrapping_add(v);\n722\t                    x = x.wrapping_add(1);\n723\t                }\n724\t            }\n725\t            4 => {\n726\t                x = 0;\n727\t                while x < bpp {\n728\t                    let v = *prev.wrapping_offset(x as isize);\n729\t                    let t = raw.wrapping_offset(x as isize);\n730\t                    *t = (*t).wrapping_add(v);\n731\t                    x = x.wrapping_add(1);\n732\t                }\n733\t