            >= (*s).begin)\n433\t            {\n434\t                cp_set_error!(\"Attempted to write before out buffer (invalid backwards distance).\");\n435\t                return 0;\n436\t            }\n437\t            if !((*s).out.wrapping_offset(length as isize) <= (*s).out_end) {\n438\t                cp_set_error!(\"Attempted to overwrite out buffer while outputting a string.\");\n439\t                return 0;\n440\t            }\n441\t            let mut src = (*s).out.wrapping_offset(-(backwards_distance as isize));\n442\t            let mut dst = (*s).out;\n443\t            (*s).out = (*s).out.wrapping_offset(length as isize);\n444\t            match backwards_distance {\n445\t                1 => {\n446\t                    ptr::write_bytes(dst as *mut u8, *(src as *const u8), length as usize);\n447\t                }\n448\t                _ => {\n449\t                    let mut length = length;\n450\t                    while length != 0 {\n451\t                        length = length.wrapping_sub(1);\n452\t                        *dst = *src;\n453\t                        dst = dst.wrapping_offset(1);\n454\t                        src = src.wrapping_offset(1);\n455\t                    }\n456\t                }\n457\t            }\n458\t        } else {\n459\t            break;\n460\t        }\n461\t    }\n462\t    1\n463\t}\n464\t\n465\t#[unsafe(no_mangle)]\n466\tpub unsafe extern \"C\" fn cp_inflate(\n467\t    input: *mut c_void,\n468\t    in_bytes: c_int,\n469\t    out: *mut c_void,\n470\t    out_bytes: c_int,\n471\t) -> c_int {\n472\t    let s = calloc(1, core::mem::size_of::<cp_state_t>()) as *mut cp_state_t;\n473\t    (*s).bits = 0;\n474\t    (*s).count = 0;\n475\t    (*s).word_index = 0;\n476\t    (*s).bits_left = in_bytes.wrapping_mul(8);\n477\t    let in_addr = input as usize;\n478\t    let first_bytes: c_int = (((in_addr.wrapping_add(3)) & !3usize).wrapping_sub(in_addr)) as c_int;\n479\t    (*s).words = (input as *mut c_char).wrapping_offset(first_bytes as isize) as *mut u32;\n480\t    (*s).word_count = in_bytes.wrapping_sub(first_bytes) / 4;\n481\t    let last_bytes: c_int = in_bytes.wrapping_sub(first_bytes) & 3;\n482\t    {\n483\t        let mut i: c_int = 0;\n484\t        while i < first_bytes {\n485\t            let byte = *(input as *const u8).wrapping_offset(i as isize);\n486\t            (*s).bits |= (byte as u64).wrapping_shl((i.wrapping_mul(8)) as u32);\n487\t            i = i.wrapping_add(1);\n488\t        }\n489\t    }\n490\t    (*s).final_word_available = if last_bytes != 0 { 1 } else { 0 };\n491\t    (*s).final_word = 0;\n492\t    {\n493\t        let mut i: c_int = 0;\n494\t        while i < last_bytes {\n495\t            let byte = *(input as *const u8)\n496\t                .wrapping_offset((in_bytes.wrapping_sub(last_bytes).wrapping_add(i)) as isize);\n497\t            (*s).final_word |= (byte as u32).wrapping_shl((i.wrapping_mul(8)) as u32);\n498\t            i = i.wrapping_add(1);\n499\t        }\n500\t    }\n501\t    (*s).count = first_bytes.wrapping_mul(8);\n502\t    (*s).out = out as *mut c_char;\n503\t    (*s).out_end = (*s).out.wrapping_offset(out_bytes as isize);\n504\t    (*s).begin = out as *mut c_char;\n505\t\n506\t    let ok = cp_inflate_blocks(s);\n507\t    free(s as *mut c_void);\n508\t    ok\n509\t}\n510\t\n511\tunsafe fn cp_inflate_blocks(s: *mut cp_state_t) -> c_int {\n512\t    let mut count: c_int = 0;\n513\t    let mut bfinal: c_int;\n514\t    loop {\n515\t        bfinal = cp_read_bits(s, 1) as c_int;\n516\t        let btype = cp_read_bits(s, 2) as c_int;\n517\t        match btype {\n518\t            0 => {\n519\t                if cp_stored(s) == 0 {\n520\t                    return 0;\n521\t                }\n522\t            }\n523\t            1 => {\n524\t                cp_fixed(s);\n525\t                if cp_block(s) == 0 {\n526\t                    return 0;\n527\t                }\n528\t            }\n529\t            2 => {\n530\t                cp_dy