b'A'*10,len_override=65535),64))  # LEN huge\n# two stored blocks (triggers \"extends beyond end\")\ninf.append((stored_block(False,b'abc')+stored_block(True,b'def'),64))\n# block type 3\nbw=BW(); bw.w(1,1); bw.w(3,2); inf.append((bw.bytes(),64))\nbw=BW(); bw.w(0,1); bw.w(3,2); inf.append((bw.bytes(),64))\n# empty / tiny inputs\nfor n in range(0,9):\n    inf.append((bytes([0]*n),64))\n    inf.append((bytes([0xFF]*n),64))\n    inf.append((bytes(rnd.randrange(256) for _ in range(n)),64))\n# fixed huffman: literals + long match, small out buffer\ndef fixed_lit_match(lits, matches, final=True):\n    bw=BW(); bw.w(1 if final else 0,1); bw.w(1,2)\n    def lit(c):\n        if c<=143: bw.w_rev(c+0x30,8)\n        else: bw.w_rev(c-144+0x190,9)\n    def wrev(v,n):\n        for i in range(n-1,-1,-1): bw.bits.append((v>>i)&1)\n    bw.w_rev=lambda v,n: wrev(v,n)\n    for c in lits: lit(c)\n    for (length,dist) in matches:\n        # length codes 257..264 -> len 3..10 (no extra bits); code 257+ (len-3)\n        assert 3<=length<=10\n        code=257+(length-3)\n        wrev(code-256, 7)  # codes 256-279 -> 7 bits, values 0000000-0010111\n        # distance codes 0..3 -> dist 1..4, 5 bits\n        assert 1<=dist<=4\n        wrev(dist-1,5)\n    wrev(0,7)  # end of block (code 256)\n    return bw.bytes()\nfor ob in (1,2,3,4,5,8,64):\n    inf.append((fixed_lit_match([65],[(10,1)]*40), ob))\n    inf.append((fixed_lit_match([65,66,67],[(10,3)]*20), ob))\n    inf.append((fixed_lit_match(list(range(60)),[]), ob))\n    inf.append((fixed_lit_match([200,250,255,144,143],[(4,2)]), ob))\n# distance too far back\ninf.append((fixed_lit_match([65],[(3,4)]),64))\ninf.append((fixed_lit_match([65,66],[(3,4)]),64))\n# zlib-generated streams truncated at every length (deterministic, in-bounds)\nraw=bytes((i*13)%256 for i in range(500))\nco=zlib.compressobj(9,zlib.DEFLATED,15); comp=co.compress(raw)+co.flush(); body=comp[2:-4]\nfor t in range(0,len(body),7):\n    inf.append((body[:t],1024))\nraw2=b'AB