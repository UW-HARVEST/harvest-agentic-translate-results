{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016HPEbfqg16PDQpnyCB14nW","type":"tool_result","content":"1\t//! Simplex reduction (`c22`, `c23`), search direction, witness points and the GJK\n2\t//! distance routine itself.\n3\t\n4\tuse crate::fp;\n5\tuse crate::math::{\n6\t    c2Add, c2CCW90, c2Det2, c2Dot, c2Len, c2Mulvs, c2Mulxv, c2MulrvT, c2Neg, c2Norm, c2Skew,\n7\t    c2Sub, c2V, c2xIdentity,\n8\t};\n9\tuse crate::shapes::{c2MakeProxy, c2Support};\n10\tuse crate::types::{\n11\t    c2GJKCache, c2Proxy, c2Simplex, c2sv, c2v, c2x, C2_FLT_EPSILON, C2_FLT_MAX, C2_SIMPLEX_SLOTS,\n12\t    C2_TYPE,\n13\t};\n14\tuse core::ffi::{c_float, c_int, c_void};\n15\t\n16\t#[inline(never)]\n17\t#[unsafe(no_mangle)]\n18\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> c_float {\n19\t    unsafe {\n20\t        // C: `default:` falls into `case 1:`, so anything other than 2 or 3 yields 0.\n21\t        match (*s).count {\n22\t            2 => c2Len(c2Sub((*s).b.p, (*s).a.p)),\n23\t            3 => c2Det2(c2Sub((*s).b.p, (*s).a.p), c2Sub((*s).c.p, (*s).a.p)),\n24\t            _ => 0.0,\n25\t        }\n26\t    }\n27\t}\n28\t\n29\t/// Reduce a 2-vertex simplex.\n30\t#[inline(never)]\n31\t#[unsafe(no_mangle)]\n32\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n33\t    unsafe {\n34\t        let a = (*s).a.p;\n35\t        let b = (*s).b.p;\n36\t        let u = c2Dot(b, c2Sub(b, a));\n37\t        let v = c2Dot(a, c2Sub(a, b));\n38\t        if v <= 0.0 {\n39\t            (*s).a.u = 1.0;\n40\t            (*s).div = 1.0;\n41\t            (*s).count = 1;\n42\t        } else if u <= 0.0 {\n43\t            (*s).a = (*s).b;\n44\t            (*s).a.u = 1.0;\n45\t            (*s).div = 1.0;\n46\t            (*s).count = 1;\n47\t        } else {\n48\t            (*s).a.u = u;\n49\t            (*s).b.u = v;\n50\t            // GCC: `addss %xmm0,%xmm2` with u as destination.\n51\t            (*s).div = fp::add(u, v);\n52\t            (*s).count = 2;\n53\t        }\n54\t    }\n55\t}\n56\t\n57\t/// Reduce a 3-vertex simplex.\n58\t#[inline(never)]\n59\t#[unsafe(no_mangle)]\n60\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n61\t    unsafe {\n62\t        let a = (*s).a.p;\n63\t        let b = (*s).b.p;\n64\t        let c = (*s).c.p;\n65\t        let uAB = c2Dot(b, c2Sub(b, a));\n66\t        let vAB = c2Dot(a, c2Sub(a, b));\n67\t        let uBC = c2Dot(c, c2Sub(c, b));\n68\t        let vBC = c2Dot(b, c2Sub(b, c));\n69\t        let uCA = c2Dot(a, c2Sub(a, c));\n70\t        let vCA = c2Dot(c, c2Sub(c, a));\n71\t        let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n72\t        // GCC emits `mulss %xmm4,<det>` for all three, i.e. the c2Det2 result is the\n73\t        // destination operand and `area` is the source.\n74\t        let uABC = fp::mul(c2Det2(b, c), area);\n75\t        let vABC = fp::mul(c2Det2(c, a), area);\n76\t        let wABC = fp::mul(c2Det2(a, b), area);\n77\t        if vAB <= 0.0 && uCA <= 0.0 {\n78\t            (*s).a.u = 1.0;\n79\t            (*s).div = 1.0;\n80\t            (*s).count = 1;\n81\t        } else if uAB <= 0.0 && vBC <= 0.0 {\n82\t            (*s).a = (*s).b;\n83\t            (*s).a.u = 1.0;\n84\t            (*s).div = 1.0;\n85\t            (*s).count = 1;\n86\t        } else if uBC <= 0.0 && vCA <= 0.0 {\n87\t            (*s).a = (*s).c;\n88\t            (*s).a.u = 1.0;\n89\t            (*s).div = 1.0;\n90\t            (*s).count = 1;\n91\t        } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n92\t            (*s).a.u = uAB;\n93\t            (*s).b.u = vAB;\n94\t            // GCC: `addss %xmm3,%xmm2` with uAB as destination.\n95\t            (*s).div = fp::add(uAB, vAB);\n96\t            (*s).count = 2;\n97\t        } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n98\t            (*s).a = (*s).b;\n99\t            (*s).b = (*s).c;\n100\t            (*s).a.u = uBC;\n101\t            (*s).b.u = vBC;\n102\t            // GCC: `addss %xmm5,%xmm6` with vBC as destination -- operands reversed\n103\t            // with respect to the source order.\n104\t            (*s).div = fp::add(vBC, uBC);\n105\t            (*s).count = 2;\n106\t        } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n107\t            (*s).b = (*s).a;\n108\t            (*s).a = (*s).c;\n109\t            (*s).a.u = uCA;\n110\t            (*s).b.u = vCA;\n111\t            (*s).div = fp::add(uCA, vCA);\n112\t            (*s).count = 2;\n113\t        } else {\n114\t            (*s).a.u = uABC;\n115\t            (*s).b.u = vABC;\n116\t            (*s).c.u = wABC;\n117\t            // GCC: `addss %xmm3,%xmm2` (uABC+vABC) then `addss %xmm2,%xmm0` with\n118\t            // wABC as the destination of the outer add.\n119\t            (*s).div = fp::add(wABC, fp::add(uABC, vABC));\n120\t            (*s).count = 3;\n121\t        }\n122\t    }\n123\t}\n124\t\n125\t/// Next search direction.\n126\t#[inline(never)]\n127\t#[unsafe(no_mangle)]\n128\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n129\t    unsafe {\n130\t        match (*s).count {\n131\t            1 => c2Neg((*s).a.p),\n132\t            2 => {\n133\t                let ab = c2Sub((*s).b.p, (*s).a.p);\n134\t                if c2Det2(ab, c2Neg((*s).a.p)) > 0.0 {\n135\t                    c2Skew(ab)\n136\t                } else {\n137\t                    c2CCW90(ab)\n138\t                }\n139\t            }\n140\t            // C: `case 3: default:` both return c2V(0, 0)\n141\t            _ => c2V(0.0, 0.0),\n142\t        }\n143\t    }\n144\t}\n145\t\n146\t/// Closest points on each shape, in world space.\n147\t#[inline(never)]\n148\t#[unsafe(no_mangle)]\n149\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n150\t    unsafe {\n151\t        let den = 1.0 / (*s).div;\n152\t        match (*s).count {\n153\t            1 => {\n154\t                *a = (*s).a.sA;\n155\t                *b = (*s).a.sB;\n156\t            }\n157\t            2 => {\n158\t                *a = c2Add(\n159\t                    c2Mulvs((*s).a.sA, fp::mul(den, (*s).a.u)),\n160\t                    c2Mulvs((*s).b.sA, fp::mul(den, (*s).b.u)),\n161\t                );\n162\t                *b = c2Add(\n163\t                    c2Mulvs((*s).a.sB, fp::mul(den, (*s).a.u)),\n164\t                    c2Mulvs((*s).b.sB, fp::mul(den, (*s).b.u)),\n165\t                );\n166\t            }\n167\t            3 => {\n168\t                *a = c2Add(\n169\t                    c2Add(\n170\t                        c2Mulvs((*s).a.sA, fp::mul(den, (*s).a.u)),\n171\t                        c2Mulvs((*s).b.sA, fp::mul(den, (*s).b.u)),\n172\t                    ),\n173\t                    c2Mulvs((*s).c.sA, fp::mul(den, (*s).c.u)),\n174\t                );\n175\t                *b = c2Add(\n176\t                    c2Add(\n177\t                        c2Mulvs((*s).a.sB, fp::mul(den, (*s).a.u)),\n178\t                        c2Mulvs((*s).b.sB, fp::mul(den, (*s).b.u)),\n179\t                    ),\n180\t                    c2Mulvs((*s).c.sB, fp::mul(den, (*s).c.u)),\n181\t                );\n182\t            }\n183\t            _ => {\n184\t                *a = c2V(0.0, 0.0);\n185\t                *b = c2V(0.0, 0.0);\n186\t            }\n187\t        }\n188\t    }\n189\t}\n190\t\n191\t/// Closest point on the simplex to the origin, in Minkowski-difference space.\n192\t#[inline(never)]\n193\t#[unsafe(no_mangle)]\n194\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n195\t    unsafe {\n196\t        let den = 1.0 / (*s).div;\n197\t        match (*s).count {\n198\t            1 => (*s).a.p,\n199\t            // GCC is asymmetric here: for the b term it emits `mulss 0x3c(%rdi),%xmm1`\n200\t            // (den is the destination), but for the a term `mulss %xmm2,%xmm1` with\n201\t            // s->a.u as the destination.\n202\t            2 => c2Add(\n203\t                c2Mulvs((*s).a.p, fp::mul((*s).a.u, den)),\n204\t                c2Mulvs((*s).b.p, fp::mul(den, (*s).b.u)),\n205\t            ),\n206\t            _ => c2V(0.0, 0.0),\n207\t        }\n208\t    }\n209\t}\n210\t\n211\t/// GJK distance between two shapes.\n212\t///\n213\t/// # Uninitialized locals in the C original\n214\t///\n215\t/// C declares `c2Proxy pA, pB;` and `c2Simplex s;` without an initializer. Two of\n216\t/// those genuinely matter:\n217\t///\n218\t/// 1. `c2MakeProxy` has no `C2_TYPE_POLY` case, so when `typeA`/`typeB` is\n219\t///    `C2_TYPE_POLY` the corresponding proxy is never written. This is reachable\n220\t///    from the public API via `c2CapsuletoPolyManifold` (and therefore from\n221\t///    `c2AABBtoCapsuleManifold` / `omni_manifold`).\n222\t/// 2. `s.b.u` is read by `c2Witness` if the solver exits by exhausting all 20\n223\t///    iterations immediately after appending a vertex.\n224\t///\n225\t/// Measured against the compiled C library, both regions read back as all-zero\n226\t/// bytes (they sit on freshly-mapped, zero-filled stack pages, and no shallower\n227\t/// call in the library ever writes them). Verified directly: `c2GJK` with\n228\t/// `typeB == C2_TYPE_POLY` returns the distance to the *origin* with\n229\t/// `outB == (0, 0)` and `iterations == 0` — i.e. the polygon proxy behaves as a\n230\t/// single point at the origin with radius 0, which is precisely the all-zero\n231\t/// proxy. Zero-initialising here reproduces the C library's observable behaviour\n232\t/// exactly, without relying on undefined behaviour.\n233\t#[inline(never)]\n234\t#[unsafe(no_mangle)]\n235\tpub unsafe extern \"C\" fn c2GJK(\n236\t    A: *const c_void,\n237\t    typeA: C2_TYPE,\n238\t    ax_ptr: *const c2x,\n239\t    B: *const c_void,\n240\t    typeB: C2_TYPE,\n241\t    bx_ptr: *const c2x,\n242\t    outA: *mut c2v,\n243\t    outB: *mut c2v,\n244\t    use_radius: c_int,\n245\t    iterations: *mut c_int,\n246\t    cache: *mut c2GJKCache,\n247\t) -> c_float {\n248\t    unsafe {\n249\t        let ax: c2x = if ax_ptr.is_null() {\n250\t            c2xIdentity()\n251\t        } else {\n252\t            *ax_ptr\n253\t        };\n254\t        let bx: c2x = if bx_ptr.is_null() {\n255\t            c2xIdentity()\n256\t        } else {\n257\t            *bx_ptr\n258\t        };\n259\t\n260\t        let mut pA = c2Proxy::default();\n261\t        let mut pB = c2Proxy::default();\n262\t        c2MakeProxy(A, typeA, &mut pA);\n263\t        c2MakeProxy(B, typeB, &mut pB);\n264\t\n265\t        let mut s = c2Simplex::default();\n266\t        // C: `c2sv *verts = &s.a;` — the four c2sv slots are contiguous.\n267\t        let verts: *mut c2sv = &raw mut s.a;\n268\t\n269\t        let mut cache_was_read: c_int = 0;\n270\t        if !cache.is_null() {\n271\t            let cache_was_good = (*cache).count != 0;\n272\t            if cache_was_good {\n273\t                // `cache->iA` / `cache->iB` are indexed unchecked in C; use raw\n274\t                // pointers so an over-long cache aliases the same way it does there.\n275\t                let ia_base: *const c_int = (*cache).iA.as_ptr();\n276\t                let ib_base: *const c_int = (*cache).iB.as_ptr();\n277\t                let n = (*cache).count;\n278\t                let mut i: c_int = 0;\n279\t                while i < n {\n280\t                    let iA = *ia_base.offset(i as isize);\n281\t                    let iB = *ib_base.offset(i as isize);\n282\t                    let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n283\t                    let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n284\t                    // Only 4 c2sv slots exist; a cache produced by c2GJK never has\n285\t                    // count > 3, so this bound is never hit by valid input.\n286\t                    if (i as usize) < C2_SIMPLEX_SLOTS {\n287\t                        let v = verts.offset(i as isize);\n288\t                        (*v).iA = iA;\n289\t                        (*v).sA = sA;\n290\t                        (*v).iB = iB;\n291\t                        (*v).sB = sB;\n292\t                        (*v).p = c2Sub((*v).sB, (*v).sA);\n293\t                        (*v).u = 0.0;\n294\t                    }\n295\t                    i += 1;\n296\t                }\n297\t                s.count = (*cache).count;\n298\t                s.div = (*cache).div;\n299\t                let metric_old = (*cache).metric;\n300\t                let metric = c2GJKSimplexMetric(&mut s);\n301\t                let min_metric = if metric < metric_old { metric } else { metric_old };\n302\t                let max_metric = if metric > metric_old { metric } else { metric_old };\n303\t                // Reproduced verbatim, including the `metric < -1.0e8f` test which\n304\t                // makes the conjunction essentially always false.\n305\t                if !(min_metric < max_metric * 2.0 && metric < -1.0e8) {\n306\t                    cache_was_read = 1;\n307\t                }\n308\t            }\n309\t        }\n310\t        if cache_was_read == 0 {\n311\t            s.a.iA = 0;\n312\t            s.a.iB = 0;\n313\t            s.a.sA = c2Mulxv(ax, pA.verts[0]);\n314\t            s.a.sB = c2Mulxv(bx, pB.verts[0]);\n315\t            s.a.p = c2Sub(s.a.sB, s.a.sA);\n316\t            s.a.u = 1.0;\n317\t            s.div = 1.0;\n318\t            s.count = 1;\n319\t        }\n320\t\n321\t        // C: `int saveA[3], saveB[3];` — sized to the 4 available simplex slots so\n322\t        // that a hostile cache cannot corrupt the stack. Identical for count <= 3.\n323\t        let mut saveA = [0 as c_int; C2_SIMPLEX_SLOTS];\n324\t        let mut saveB = [0 as c_int; C2_SIMPLEX_SLOTS];\n325\t        let mut save_count: c_int = 0;\n326\t        let mut d0: c_float = C2_FLT_MAX;\n327\t        let mut d1: c_float;\n328\t        let mut iter: c_int = 0;\n329\t        let mut hit: c_int = 0;\n330\t\n331\t        while iter < 20 {\n332\t            save_count = s.count;\n333\t            let mut i: c_int = 0;\n334\t            while i < save_count {\n335\t                if (i as usize) < C2_SIMPLEX_SLOTS {\n336\t                    saveA[i as usize] = (*verts.offset(i as isize)).iA;\n337\t                    saveB[i as usize] = (*verts.offset(i as isize)).iB;\n338\t                }\n339\t                i += 1;\n340\t            }\n341\t\n342\t            match s.count {\n343\t                1 => {}\n344\t                2 => c22(&mut s),\n345\t                3 => c23(&mut s),\n346\t                _ => {}\n347\t            }\n348\t\n349\t            if s.count == 3 {\n350\t                hit = 1;\n351\t                break;\n352\t            }\n353\t\n354\t            let p = c2L(&mut s);\n355\t            d1 = c2Dot(p, p);\n356\t            if d1 > d0 {\n357\t                break;\n358\t            }\n359\t            d0 = d1;\n360\t\n361\t            let d = c2D(&mut s);\n362\t            if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n363\t                break;\n364\t            }\n365\t\n366\t            let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n367\t            let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n368\t            let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n369\t            let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n370\t\n371\t            if (s.count as usize) < C2_SIMPLEX_SLOTS {\n372\t                let v = verts.offset(s.count as isize);\n373\t                (*v).iA = iA;\n374\t                (*v).sA = sA;\n375\t                (*v).iB = iB;\n376\t                (*v).sB = sB;\n377\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n378\t            }\n379\t\n380\t            let mut dup: c_int = 0;\n381\t            let mut i: c_int = 0;\n382\t            while i < save_count {\n383\t                let (sa, sb) = if (i as usize) < C2_SIMPLEX_SLOTS {\n384\t                    (saveA[i as usize], saveB[i as usize])\n385\t                } else {\n386\t                    (0, 0)\n387\t                };\n388\t                if iA == sa && iB == sb {\n389\t                    dup = 1;\n390\t                    break;\n391\t                }\n392\t                i += 1;\n393\t            }\n394\t            if dup != 0 {\n395\t                break;\n396\t            }\n397\t\n398\t            s.count += 1;\n399\t            iter += 1;\n400\t        }\n401\t        let _ = save_count;\n402\t\n403\t        let mut a = c2v::default();\n404\t        let mut b = c2v::default();\n405\t        c2Witness(&mut s, &mut a, &mut b);\n406\t        let mut dist = c2Len(c2Sub(a, b));\n407\t\n408\t        if hit != 0 {\n409\t            a = b;\n410\t            dist = 0.0;\n411\t        } else if use_radius != 0 {\n412\t            let rA = pA.radius;\n413\t            let rB = pB.radius;\n414\t            if dist > fp::add(rA, rB) && dist > C2_FLT_EPSILON {\n415\t                dist -= fp::add(rA, rB);\n416\t                let n = c2Norm(c2Sub(b, a));\n417\t                a = c2Add(a, c2Mulvs(n, rA));\n418\t                b = c2Sub(b, c2Mulvs(n, rB));\n419\t                if a.x == b.x && a.y == b.y {\n420\t                    dist = 0.0;\n421\t                }\n422\t            } else {\n423\t                let p = c2Mulvs(c2Add(a, b), 0.5);\n424\t                a = p;\n425\t                b = p;\n426\t                dist = 0.0;\n427\t            }\n428\t        }\n429\t\n430\t        if !cache.is_null() {\n431\t            (*cache).metric = c2GJKSimplexMetric(&mut s);\n432\t            (*cache).count = s.count;\n433\t            let ia_base: *mut c_int = (*cache).iA.as_mut_ptr();\n434\t            let ib_base: *mut c_int = (*cache).iB.as_mut_ptr();\n435\t            let mut i: c_int = 0;\n436\t            while i < s.count {\n437\t                if (i as usize) < C2_SIMPLEX_SLOTS {\n438\t                    let v = verts.offset(i as isize);\n439\t                    *ia_base.offset(i as isize) = (*v).iA;\n440\t                    *ib_base.offset(i as isize) = (*v).iB;\n441\t                }\n442\t                i += 1;\n443\t            }\n444\t            (*cache).div = s.div;\n445\t        }\n446\t\n447\t        if !outA.is_null() {\n448\t            *outA = a;\n449\t        }\n450\t        if !outB.is_null() {\n451\t            *outB = b;\n452\t        }\n453\t        if !iterations.is_null() {\n454\t            *iterations = iter;\n455\t        }\n456\t        dist\n457\t    }\n458\t}\n459\t"}]},"parent_tool_use_id":null,"session_id":"27d6de7a-57e2-4fbc-9590-8efa6a5bf865","uuid":"79584b41-5f14-431b-b69f-8c2447443d4d","timestamp":"2026-08-20T11:51:22.388Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-4VIOLY/translated_rust/src/gjk.rs","content":"//! Simplex reduction (`c22`, `c23`), search direction, witness points and the GJK\n//! distance routine itself.\n\nuse crate::fp;\nuse crate::math::{\n    c2Add, c2CCW90, c2Det2, c2Dot, c2Len, c2Mulvs, c2Mulxv, c2MulrvT, c2Neg, c2Norm, c2Skew,\n    c2Sub, c2V, c2xIdentity,\n};\nuse crate::shapes::{c2MakeProxy, c2Support};\nuse crate::types::{\n    c2GJKCache, c2Proxy, c2Simplex, c2sv, c2v, c2x, C2_FLT_EPSILON, C2_FLT_MAX, C2_SIMPLEX_SLOTS,\n    C2_TYPE,\n};\nuse core::ffi::{c_float, c_int, c_void};\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> c_float {\n    unsafe {\n        // C: `default:` falls into `case 1:`, so anything other than 2 or 3 yields 0.\n        match (*s).count {\n            2 => c2Len(c2Sub((*s).b.p, (*s).a.p)),\n            3 => c2Det2(c2Sub((*s).b.p, (*s).a.p), c2Sub((*s).c.p, (*s).a.p)),\n            _ => 0.0,\n        }\n    }\n}\n\n/// Reduce a 2-vertex simplex.\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    unsafe {\n        let a = (*s).a.p;\n        let b = (*s).b.p;\n        let u = c2Dot(b, c2Sub(b, a));\n        let v = c2Dot(a, c2Sub(a, b));\n        if v <= 0.0 {\n            (*s).a.u = 1.0;\n            (*s).div = 1.0;\n            (*s).count = 1;\n        } else if u <= 0.0 {\n            (*s).a = (*s).b;\n            (*s).a.u = 1.0;\n            (*s).div = 1.0;\n            (*s).count = 1;\n        } else {\n            (*s).a.u = u;\n            (*s).b.u = v;\n            // GCC: `addss %xmm0,%xmm2` with u as destination.\n            (*s).div = fp::add(u, v);\n            (*s).count = 2;\n        }\n    }\n}\n\n/// Reduce a 3-vertex simplex.\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n    unsafe {\n        let a = (*s).a.p;\n        let b = (*s).b.p;\n        let c = (*s).c.p;\n        let uAB = c2Dot(b, c2Sub(b, a));\n        let vAB = c2Dot(a, c2Sub(a, b));\n        let uBC = c2Dot(c, c2Sub(c, b));\n        let vBC = c2Dot(b, c2Sub(b, c));\n        let uCA = c2Dot(a, c2Sub(a, c));\n        let vCA = c2Dot(c, c2Sub(c, a));\n        let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n        // GCC emits `mulss %xmm4,<det>` for all three, i.e. the c2Det2 result is the\n        // destination operand and `area` is the source.\n        let uABC = fp::mul(c2Det2(b, c), area);\n        let vABC = fp::mul(c2Det2(c, a), area);\n        let wABC = fp::mul(c2Det2(a, b), area);\n        if vAB <= 0.0 && uCA <= 0.0 {\n            (*s).a.u = 1.0;\n            (*s).div = 1.0;\n            (*s).count = 1;\n        } else if uAB <= 0.0 && vBC <= 0.0 {\n            (*s).a = (*s).b;\n            (*s).a.u = 1.0;\n            (*s).div = 1.0;\n            (*s).count = 1;\n        } else if uBC <= 0.0 && vCA <= 0.0 {\n            (*s).a = (*s).c;\n            (*s).a.u = 1.0;\n            (*s).div = 1.0;\n            (*s).count = 1;\n        } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n            (*s).a.u = uAB;\n            (*s).b.u = vAB;\n            // GCC: `addss %xmm3,%xmm2` with uAB as destination.\n            (*s).div = fp::add(uAB, vAB);\n            (*s).count = 2;\n        } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n            (*s).a = (*s).b;\n            (*s).b = (*s).c;\n            (*s).a.u = uBC;\n            (*s).b.u = vBC;\n            // GCC: `addss %xmm5,%xmm6` with vBC as destination -- operands reversed\n            // with respect to the source order.\n            (*s).div = fp::add(vBC, uBC);\n            (*s).count = 2;\n        } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n            (*s).b = (*s).a;\n            (*s).a = (*s).c;\n            (*s).a.u = uCA;\n            (*s).b.u = vCA;\n            (*s).div = fp::add(uCA, vCA);\n            (*s).count = 2;\n        } else {\n            (*s).a.u = uABC;\n            (*s).b.u = vABC;\n            (*s).c.u = wABC;\n            // GCC: `addss %xmm3,%xmm2` (uABC+vABC) then `addss %xmm2,%xmm0` with\n            // wABC as the destination of the outer add.\n            (*s).div = fp::add(wABC, fp::add(uABC, vABC));\n            (*s).count = 3;\n        }\n    }\n}\n\n/// Next search direction.\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    unsafe {\n        match (*s).count {\n            1 => c2Neg((*s).a.p),\n            2 => {\n                let ab = c2Sub((*s).b.p, (*s).a.p);\n                if c2Det2(ab, c2Neg((*s).a.p)) > 0.0 {\n                    c2Skew(ab)\n                } else {\n                    c2CCW90(ab)\n                }\n            }\n            // C: `case 3: default:` both return c2V(0, 0)\n            _ => c2V(0.0, 0.0),\n        }\n    }\n}\n\n/// Closest points on each shape, in world space.\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n    unsafe {\n        let den = 1.0 / (*s).div;\n        match (*s).count {\n            1 => {\n                *a = (*s).a.sA;\n                *b = (*s).a.sB;\n            }\n            2 => {\n                *a = c2Add(\n                    c2Mulvs((*s).a.sA, fp::m