{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CR1fqzBNWfq1YEX95Nmf6D","type":"tool_result","content":"1\t//! The dispatcher plus the two convenience entry points declared in `lib.h`.\n2\t\n3\tuse crate::manifold::{\n4\t    c2AABBtoAABBManifold, c2AABBtoCapsuleManifold, c2CapsuletoCapsuleManifold,\n5\t    c2CircletoAABBManifold, c2CircletoCapsuleManifold, c2CircletoCircleManifold,\n6\t};\n7\tuse crate::math::{c2Neg, c2V};\n8\tuse crate::types::{\n9\t    c2AABB, c2Capsule, c2Circle, c2Manifold, C2_TYPE, C2_TYPE_AABB, C2_TYPE_CAPSULE,\n10\t    C2_TYPE_CIRCLE,\n11\t};\n12\tuse core::ffi::{c_float, c_void};\n13\t\n14\tunsafe extern \"C\" {\n15\t    fn malloc(size: usize) -> *mut c_void;\n16\t}\n17\t\n18\t#[inline(never)]\n19\t#[unsafe(no_mangle)]\n20\tpub unsafe extern \"C\" fn c2Collide(\n21\t    A: *const c_void,\n22\t    typeA: C2_TYPE,\n23\t    B: *const c_void,\n24\t    typeB: C2_TYPE,\n25\t    m: *mut c2Manifold,\n26\t) {\n27\t    unsafe {\n28\t        (*m).count = 0;\n29\t        // No `C2_TYPE_POLY` case at either level, and no `default`: a polygon (or any\n30\t        // unrecognised C2_TYPE) leaves the manifold with just `count = 0` and every\n31\t        // other field exactly as the caller supplied it.\n32\t        match typeA {\n33\t            C2_TYPE_CIRCLE => match typeB {\n34\t                C2_TYPE_CIRCLE => c2CircletoCircleManifold(\n35\t                    core::ptr::read_unaligned(A as *const c2Circle),\n36\t                    core::ptr::read_unaligned(B as *const c2Circle),\n37\t                    m,\n38\t                ),\n39\t                C2_TYPE_AABB => c2CircletoAABBManifold(\n40\t                    core::ptr::read_unaligned(A as *const c2Circle),\n41\t                    core::ptr::read_unaligned(B as *const c2AABB),\n42\t                    m,\n43\t                ),\n44\t                C2_TYPE_CAPSULE => c2CircletoCapsuleManifold(\n45\t                    core::ptr::read_unaligned(A as *const c2Circle),\n46\t                    core::ptr::read_unaligned(B as *const c2Capsule),\n47\t                    m,\n48\t                ),\n49\t                _ => {}\n50\t            },\n51\t            C2_TYPE_AABB => match typeB {\n52\t                C2_TYPE_CIRCLE => {\n53\t                    c2CircletoAABBManifold(\n54\t                        core::ptr::read_unaligned(B as *const c2Circle),\n55\t                        core::ptr::read_unaligned(A as *const c2AABB),\n56\t                        m,\n57\t                    );\n58\t                    (*m).n = c2Neg((*m).n);\n59\t                }\n60\t                C2_TYPE_AABB => c2AABBtoAABBManifold(\n61\t                    core::ptr::read_unaligned(A as *const c2AABB),\n62\t                    core::ptr::read_unaligned(B as *const c2AABB),\n63\t                    m,\n64\t                ),\n65\t                C2_TYPE_CAPSULE => c2AABBtoCapsuleManifold(\n66\t                    core::ptr::read_unaligned(A as *const c2AABB),\n67\t                    core::ptr::read_unaligned(B as *const c2Capsule),\n68\t                    m,\n69\t                ),\n70\t                _ => {}\n71\t            },\n72\t            C2_TYPE_CAPSULE => match typeB {\n73\t                C2_TYPE_CIRCLE => {\n74\t                    c2CircletoCapsuleManifold(\n75\t                        core::ptr::read_unaligned(B as *const c2Circle),\n76\t                        core::ptr::read_unaligned(A as *const c2Capsule),\n77\t                        m,\n78\t                    );\n79\t                    (*m).n = c2Neg((*m).n);\n80\t                }\n81\t                C2_TYPE_AABB => {\n82\t                    c2AABBtoCapsuleManifold(\n83\t                        core::ptr::read_unaligned(B as *const c2AABB),\n84\t                        core::ptr::read_unaligned(A as *const c2Capsule),\n85\t                        m,\n86\t                    );\n87\t                    (*m).n = c2Neg((*m).n);\n88\t                }\n89\t                C2_TYPE_CAPSULE => c2CapsuletoCapsuleManifold(\n90\t                    core::ptr::read_unaligned(A as *const c2Capsule),\n91\t                    core::ptr::read_unaligned(B as *const c2Capsule),\n92\t                    m,\n93\t                ),\n94\t                _ => {}\n95\t            },\n96\t            _ => {}\n97\t        }\n98\t    }\n99\t}\n100\t\n101\t/// Heap-allocate a shape from five loose floats.\n102\t///\n103\t/// Uses `malloc` (not Rust's allocator) so that the returned pointer can be handed\n104\t/// to / freed by C exactly as before. The allocation is intentionally never freed:\n105\t/// `omni_manifold` leaks both shapes in the original too.\n106\t///\n107\t/// **Faithfully reproduces a bug in the C source**: there is no `C2_TYPE_POLY` case\n108\t/// and no `default`, so control falls off the end of the function without a `return`.\n109\t/// GCC compiles that path to `mov %r12, %rax`, i.e. it returns the *caller's* stale\n110\t/// callee-saved register — an indeterminate value that cannot be replicated. It is\n111\t/// unobservable in practice: `c2Collide` has no `C2_TYPE_POLY` case either, so the\n112\t/// pointer is never dereferenced for polygons. We return null.\n113\t#[inline(never)]\n114\t#[unsafe(no_mangle)]\n115\tpub unsafe extern \"C\" fn ptr_from_parts(\n116\t    typ: C2_TYPE,\n117\t    a: c_float,\n118\t    b: c_float,\n119\t    c: c_float,\n120\t    d: c_float,\n121\t    e: c_float,\n122\t) -> *mut c_void {\n123\t    unsafe {\n124\t        match typ {\n125\t            C2_TYPE_CIRCLE => {\n126\t                let circle = malloc(core::mem::size_of::<c2Circle>()) as *mut c2Circle;\n127\t                (*circle).p = c2V(a, b);\n128\t                (*circle).r = c;\n129\t                circle as *mut c_void\n130\t            }\n131\t            C2_TYPE_AABB => {\n132\t                let aabb = malloc(core::mem::size_of::<c2AABB>()) as *mut c2AABB;\n133\t                (*aabb).min = c2V(a, b);\n134\t                (*aabb).max =