a: v(3.0, 4.0), b: v(5.0, 6.0), r: 1.0 };\n    let poly = c2Poly::default();\n\n    // dirty the stack region below our frame\n    fn dirty(depth: u32) -> u64 {\n        let buf = [0xDEADBEEFu64; 64];\n        if depth == 0 { return buf.iter().sum(); }\n        std::hint::black_box(buf[0]).wrapping_add(dirty(depth - 1))\n    }\n    let _ = std::hint::black_box(dirty(40));\n\n    for trial in 0..4 {\n        let (mut ca, mut cb) = (c2v::default(), c2v::default());\n        let (mut ra, mut rb) = (c2v::default(), c2v::default());\n        let cd = unsafe { cf(&cap as *const _ as *const _, C2_TYPE_CAPSULE, std::ptr::null(),\n            &poly as *const _ as *const _, C2_TYPE_POLY, std::ptr::null(),\n            &mut ca, &mut cb, 0, std::ptr::null_mut(), std::ptr::null_mut()) };\n        let rd = unsafe { rf(&cap as *const _ as *const _, C2_TYPE_CAPSULE, std::ptr::null(),\n            &poly as *const _ as *const _, C2_TYPE_POLY, std::ptr::null(),\n            &mut ra, &mut rb, 0, std::ptr::null_mut(), std::ptr::null_mut()) };\n        println!(\"dirty trial {trial}: C d={cd:?} a={ca:?} b={cb:?} | RS d={rd:?} a={ra:?} b={rb:?}\");\n    }\n}\n\n/// Same question via the public AABB-vs-capsule path.\n#[test]\nfn probe_aabb_capsule_stability() {\n    type OM = unsafe extern \"C\" fn(*mut c2Manifold, C2_TYPE, f32,f32,f32,f32,f32, C2_TYPE, f32,f32,f32,f32,f32);\n    let l = libs();\n    let (cf, rf) = l.get::<OM>(\"omni_manifold\");\n    for trial in 0..6 {\n        let mut cm = poison_manifold(7);\n        let mut rm = poison_manifold(7);\n        unsafe { cf(&mut cm, C2_TYPE_AABB, -1.0,-1.0,1.0,1.0,0.0, C2_TYPE_CAPSULE, -2.0,0.0,2.0,0.0,0.5) };\n        unsafe { rf(&mut rm, C2_TYPE_AABB, -1.0,-1.0,1.0,1.0,0.0, C2_TYPE_CAPSULE, -2.0,0.0,2.0,0.0,0.5) };\n        println!(\"trial {trial}:\\n  C  {}\\n  RS {}\", hex(raw(&cm)), hex(raw(&rm)));\n    }\n}\nEOF\ntimeout 600 cargo test --offline --test probe -- --nocapture --test-threads=1 2>&1 | tail -50","description":"Probe unini