    let mut m = poison_manifold(31);\n    zero_stack();\n    unsafe {\n        f(cap, poly, bx.map_or(std::ptr::null(), |x| x as *const c2x), &mut m);\n    }\n    m\n}\n\n#[test]\nfn zeroing_the_stack_makes_the_c_poly_path_deterministic() {\n    let l = libs();\n    let (cf, rf) = l.get::<FnGJK>(\"c2GJK\");\n    let cap = c2Capsule { a: v(3.0, 4.0), b: v(5.0, 6.0), r: 1.0 };\n    let poly = c2Poly::default();\n\n    // Warm up so lazy PLT resolution inside the .so is done and does not dirty the\n    // stack during the measured calls.\n    for _ in 0..4 {\n        let (mut a, mut b) = (c2v::default(), c2v::default());\n        unsafe {\n            cf(&cap as *const _ as *const c_void, C2_TYPE_CAPSULE, std::ptr::null(),\n               &poly as *const _ as *const c_void, C2_TYPE_POLY, std::ptr::null(),\n               &mut a, &mut b, 0, std::ptr::null_mut(), std::ptr::null_mut());\n            rf(&cap as *const _ as *const c_void, C2_TYPE_CAPSULE, std::ptr::null(),\n               &poly as *const _ as *const c_void, C2_TYPE_POLY, std::ptr::null(),\n               &mut a, &mut b, 0, std::ptr::null_mut(), std::ptr::null_mut());\n        }\n    }\n\n    for trial in 0..8 {\n        let (mut ca, mut cb, mut cit) = (c2v::default(), c2v::default(), 0i32);\n        zero_stack();\n        let cd = unsafe {\n            cf(&cap as *const _ as *const c_void, C2_TYPE_CAPSULE, std::ptr::null(),\n               &poly as *const _ as *const c_void, C2_TYPE_POLY, std::ptr::null(),\n               &mut ca, &mut cb, 0, &mut cit, std::ptr::null_mut())\n        };\n        println!(\"trial {trial}: C after zero_stack -> d={cd} a={ca:?} b={cb:?} it={cit}\");\n        assert_eq!(cd, 5.0, \"C should now see the all-zero proxy\");\n        assert_eq!(cb, v(0.0, 0.0));\n        assert_eq!(cit, 0);\n    }\n}\n\n#[test]\nfn capsule_poly_matches_after_zeroing() {\n    let l = libs();\n    let (cf, rf) = l.get::<FnCapsulePoly>(\"c2CapsuletoPolyManifold\");\n    let mut rng = Rng::new(777);\n\n    // warm up\n    let warm = c2Poly::default();\n    for _ in 0..4 {\n        let _ = capsule_poly(&cf, c2Capsule { a: v(0.0, 0.0), b: v(1.0, 0.0), r: 1.0 }, &warm, None);\n        let _ = capsule_poly(&rf, c2Capsule { a: v(0.0, 0.0), b: v(1.0, 0.0), r: 1.0 }, &warm, None);\n    }\n\n    let mut agree = 0u32;\n    let mut disagree = 0u32;\n    for trial in 0..200 {\n        let count = 3 + (trial % 6);\n        let (rad, ctr) = (2.0 + rng.f_pos(4.0), rng.vec_norm(3.0));\n        let mut poly = convex_poly(&mut rng, count, rad, ctr);\n        fill_norms(&mut poly);\n        // capsule straddling the origin, so `d == 0 < 1e-6` under the zero proxy\n        let cap = c2Capsule { a: rng.vec_norm(4.0), b: rng.vec_norm(4.0), r: rng.f_pos(2.0) };\n        let cm = capsule_poly(&cf, cap, &poly, None);\n        let rm = capsule_poly(&rf, cap, &poly, None);\n        if raw(&cm) == raw(&rm) {\n            agree += 1;\n        } else {\n            disagree += 1;\n            if disagree <= 3 {\n                println!(\"trial {trial} DISAGREE\\n  cap={cap:?}\\n  poly.count={count}\\n  C  {}\\n  RS {}\",\n                    hex(raw(&cm)), hex(raw(&rm)));\n            }\n        }\n    }\n    println!(\"capsule_poly after zero_stack: agree={agree} disagree={disagree}\");\n    assert_eq!(disagree, 0, \"the zero-stack trick did not fully stabilise the C side\");\n}\n\n#[test]\nfn omni_aabb_capsule_matches_after_zeroing() {\n    let l = libs();\n    let (cf, rf) = l.get::<FnOmni>(\"omni_manifold\");\n    let mut rng = Rng::new(778);\n    // warm up\n    for _ in 0..4 {\n        let mut m = c2Manifold::default();\n        unsafe {\n            cf(&mut m, C2_TYPE_AABB, -1.0, -1.0, 1.0, 1.0, 0.0, C2_TYPE_CAPSULE, -2.0, 0.0, 2.0, 0.0, 0.5);\n            rf(&mut m, C2_TYPE_AABB, -1.0, -1.0, 1.0, 1.0, 0.0, C2_TYPE_CAPSULE, -2.0, 0.0, 2.0, 0.0, 0.5);\n        }\n    }\n    let mut agree = 0u32;\n    let mut disagree = 0u32;\n    for trial in 0..200 {\n        let a: [f32; 5] = [rng.f_half_lattice(3), rng.f_half_lattice(3), rng.f_half_lattice(3), rng.f_half_lattice(3), 0.0];\n        let b: [f32; 5] = [rng.f_half_lattice(3), rng.f_half_lattice(3), rng.f_half_lattice(3), rng.f_half_lattice(3), rng.f_pos(2.0)];\n        let mut cm = poison_manifold(5);\n        let mut rm = poison_manifold(5);\n        zero_stack();\n        unsafe { cf(&mut cm, C2_TYPE_AABB, a[0], a[1], a[2], a[3], a[4], C2_TYPE_CAPSULE, b[0], b[1], b[2], b[3], b[4]) };\n        zero_stack();\n        unsafe { rf(&mut rm, C2_TYPE_AABB, a[0], a[1], a[2], a[3], a[4], C2_TYPE_CAPSULE, b[0], b[1], b[2], b[3], b[4]) };\n        if raw(&cm) == raw(&rm) {\n            agree += 1;\n        } else {\n            disagree += 1;\n            if disagree <= 3 {\n                println!(\"trial {trial} DISAGREE a={a:?} b={b:?}\\n  C  {}\\n  RS {}\", hex(raw(&cm)), hex(raw(&rm)));\n            }\n        }\n    }\n    println!(\"omni AABB/CAPSULE after zero_stack: agree={agree} disagree={disagree}\");\n    assert_eq!(disagree, 0, \"the zero-stack trick did not fully stabilise the C side\");\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
