{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01SJPe9gmP35gsZLXKiHbXAS","type":"tool_result","content":"1\t//! Shape helpers: plane extraction, AABB corner expansion, proxy construction,\n2\t//! support mapping and edge-normal generation.\n3\t//!\n4\t//! These use raw pointer arithmetic rather than slice indexing because the C code\n5\t//! indexes arrays without bounds checks and several call sites legitimately rely on\n6\t//! that (see `c2Support` with `count == 0` below). Panicking across an `extern \"C\"`\n7\t//! boundary would be a behavioural difference, so we never introduce bounds checks\n8\t//! that C does not have.\n9\t\n10\tuse crate::math::{c2CCW90, c2Dot, c2Norm, c2Sub, c2V};\n11\tuse crate::types::{\n12\t    c2AABB, c2Capsule, c2Circle, c2Poly, c2Proxy, c2v, c2h, C2_TYPE, C2_TYPE_AABB,\n13\t    C2_TYPE_CAPSULE, C2_TYPE_CIRCLE,\n14\t};\n15\tuse core::ffi::{c_int, c_void};\n16\t\n17\t#[inline(never)]\n18\t#[unsafe(no_mangle)]\n19\tpub unsafe extern \"C\" fn c2PlaneAt(p: *const c2Poly, i: c_int) -> c2h {\n20\t    unsafe {\n21\t        let norms = (*p).norms.as_ptr();\n22\t        let verts = (*p).verts.as_ptr();\n23\t        // C indexes `p->norms[i]` / `p->verts[i]` unchecked.\n24\t        let n = *norms.offset(i as isize);\n25\t        c2h {\n26\t            n,\n27\t            d: c2Dot(*norms.offset(i as isize), *verts.offset(i as isize)),\n28\t        }\n29\t    }\n30\t}\n31\t\n32\t#[inline(never)]\n33\t#[unsafe(no_mangle)]\n34\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n35\t    unsafe {\n36\t        let min = (*bb).min;\n37\t        let max = (*bb).max;\n38\t        *out.offset(0) = min;\n39\t        *out.offset(1) = c2V(max.x, min.y);\n40\t        *out.offset(2) = max;\n41\t        *out.offset(3) = c2V(min.x, max.y);\n42\t    }\n43\t}\n44\t\n45\t/// Builds a GJK proxy for a shape.\n46\t///\n47\t/// **Faithfully reproduces a bug in the C source**: the `switch` has no\n48\t/// `C2_TYPE_POLY` case (and no `default`), so for a polygon — or for any\n49\t/// out-of-range `C2_TYPE` — this function writes *nothing at all* and leaves `*p`\n50\t/// exactly as the caller left it. `c2GJK` therefore operates on an untouched\n51\t/// proxy whenever `typeA`/`typeB` is `C2_TYPE_POLY`. See the comment in\n52\t/// `crate::gjk::c2GJK` for how that is handled.\n53\t#[inline(never)]\n54\t#[unsafe(no_mangle)]\n55\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: C2_TYPE, p: *mut c2Proxy) {\n56\t    unsafe {\n57\t        match type_ {\n58\t            C2_TYPE_CIRCLE => {\n59\t                let c = shape as *const c2Circle;\n60\t                (*p).radius = (*c).r;\n61\t                (*p).count = 1;\n62\t                (*p).verts[0] = (*c).p;\n63\t            }\n64\t            C2_TYPE_AABB => {\n65\t                let bb = shape as *mut c2AABB;\n66\t                (*p).radius = 0.0;\n67\t                (*p).count = 4;\n68\t                c2BBVerts((*p).verts.as_mut_ptr(), bb);\n69\t            }\n70\t            C2_TYPE_CAPSULE => {\n71\t                let c = shape as *const c2Capsule;\n72\t                (*p).radius = (*c).r;\n73\t                (*p).count = 2;\n74\t                (*p).verts[0] = (*c).a;\n75\t                (*p).verts[1] = (*c).b;\n76\t            }\n77\t            // C2_TYPE_POLY and any other value: no case matches, nothing is written.\n78\t            _ => {}\n79\t        }\n80\t    }\n81\t}\n82\t\n83\t/// Index of the vertex furthest along `d`.\n84\t///\n85\t/// Note that C reads `verts[0]` *before* testing the loop bound, so `count <= 0`\n86\t/// still dereferences `verts[0]` and returns `0`. That path is live: it is exactly\n87\t/// what happens for the all-zero polygon proxy described in `c2MakeProxy`.\n88\t#[inline(never)]\n89\t#[unsafe(no_mangle)]\n90\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n91\t    unsafe {\n92\t        let mut imax: c_int = 0;\n93\t        let mut dmax = c2Dot(*verts.offset(0), d);\n94\t        let mut i: c_int = 1;\n95\t        while i < count {\n96\t            let dot = c2Dot(*verts.offset(i as isize), d);\n97\t            if dot > dmax {\n98\t                imax = i;\n99\t                dmax = dot;\n100\t            }\n101\t            i += 1;\n102\t        }\n103\t        imax\n104\t    }\n105\t}\n106\t\n107\t#[inline(never)]\n108\t#[unsafe(no_mangle)]\n109\tpub unsafe extern \"C\" fn c2Norms(verts: *mut c2v, norms: *mut c2v, count: c_int) {\n110\t    unsafe {\n111\t        let mut i: c_int = 0;\n112\t        while i < count {\n113\t            let a = i;\n114\t            let b = if i + 1 < count { i + 1 } else { 0 };\n115\t            let e = c2Sub(*verts.offset(b as isize), *verts.offset(a as isize));\n116\t            *norms.offset(i as isize) = c2Norm(c2CCW90(e));\n117\t            i += 1;\n118\t        }\n119\t    }\n120\t}\n121\t"}]},"parent_tool_use_id":null,"session_id":"27d6de7a-57e2-4fbc-9590-8efa6a5bf865","uuid":"b095bc23-95fc-4746-a1a0-1460ddf7d9fe","timestamp":"2026-08-20T11:51:22.011Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-4VIOLY/translated_rust/src/shapes.rs","content":"//! Shape helpers: plane extraction, AABB corner expansion, proxy construction,\n//! support mapping and edge-normal generation.\n//!\n//! These use raw pointer arithmetic rather than slice indexing because the C code\n//! indexes arrays without bounds checks and several call sites legitimately rely on\n//! that (see `c2Support` with `count == 0` below). Panicking across an `extern \"C\"`\n//! boundary would be a behavioural difference, so we never introduce bounds checks\n//! that C does not have.\n\nuse crate::math::{c2CCW90, c2Dot, c2Norm, c2Sub, c2V};\nuse crate::types::{\n    c2AABB, c2Capsule, c2Circle, c2Poly, c2Proxy, c2v, c2h, C2_TYPE, C2_TYPE_AABB,\n    C2_TYPE_CAPSULE, C2_TYPE_CIRCLE,\n};\nuse core::ffi::{c_int, c_void};\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2PlaneAt(p: *const c2Poly, i: c_int) -> c2h {\n    unsafe {\n        let norms = (*p).norms.as_ptr();\n        let verts = (*p).verts.as_ptr();\n        // C indexes `p->norms[i]` / `p->verts[i]` unchecked.\n        let n = *norms.offset(i as isize);\n        c2h {\n            n,\n            d: c2Dot(*norms.offset(i as isize), *verts.offset(i as isize)),\n        }\n    }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    unsafe {\n        let min = (*bb).min;\n        let max = (*bb).max;\n        *out.offset(0) = min;\n        *out.offset(1) = c2V(max.x, min.y);\n        *out.offset(2) = max;\n        *out.offset(3) = c2V(min.x, max.y);\n    }\n}\n\n/// Builds a GJK proxy for a shape.\n///\n/// **Faithfully reproduces a bug in the C source**: the `switch` has no\n/// `C2_TYPE_POLY` case (and no `default`), so for a polygon — or for any\n/// out-of-range `C2_TYPE` — this function writes *nothing at all* and leaves `*p`\n/// exactly as the caller left it. `c2GJK` therefore operates on an untouched\n/// proxy whenever `typeA`/`typeB` is `C2_TYPE_POLY`. See the comment in\n/// `crate::gjk::c2GJK` for how that is handled.\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: C2_TYPE, p: *mut c2Proxy) {\n    unsafe {\n        match type_ {\n            C2_TYPE_CIRCLE => {\n                let c = shape as *const c2Circle;\n                (*p).radius = (*c).r;\n                (*p).count = 1;\n                (*p).verts[0] = (*c).p;\n            }\n            C2_TYPE_AABB => {\n                let bb = shape as *mut c2AABB;\n                (*p).radius = 0.0;\n                (*p).count = 4;\n                c2BBVerts((*p).verts.as_mut_ptr(), bb);\n            }\n            C2_TYPE_CAPSULE => {\n                let c = shape as *const c2Capsule;\n                (*p).radius = (*c).r;\n                (*p).count = 2;\n                (*p).verts[0] = (*c).a;\n                (*p).verts[1] = (*c).b;\n            }\n            // C2_TYPE_POLY and any other value: no case matches, nothing is written.\n            _ => {}\n        }\n    }\n}\n\n/// Index of the vertex furthest along `d`.\n///\n/// Note that C reads `verts[0]` *before* testing the loop bound, so `count <= 0`\n/// still dereferences `verts[0]` and returns `0`. That path is live: it is exactly\n/// what happens for the all-zero polygon proxy described in `c2MakeProxy`.\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    unsafe {\n        let mut imax: c_int = 0;\n        let mut dmax = c2Dot(*verts.offset(0), d);\n        let mut i: c_int = 1;\n        while i < count {\n            let dot = c2Dot(*verts.offset(i as isize), d);\n            if dot > dmax {\n                imax = i;\n                dmax = dot;\n            }\n            i += 1;\n        }\n        imax\n    }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Norms(verts: *mut c2v, norms: *mut c2v, count: c_int) {\n    unsafe {\n        let mut i: c_int = 0;\n        while i < count {\n            let a = i;\n            let b = if i + 1 < count { i + 1 } else { 0 };\n            let e = c2Sub(*verts.offset(b as isize), *verts.offset(a as isize));\n            *norms.offset(i as isize) = c2Norm(c2CCW90(e));\n            i += 1;\n        }\n    }\n}\n","numLines":121,"startLine":1,"totalLines":121}}}
