();\n    let bytes = unsafe {\n        std::slice::from_raw_parts_mut(\n            &mut m as *mut c2Manifold as *mut u8,\n            std::mem::size_of::<c2Manifold>(),\n        )\n    };\n    for (i, b) in bytes.iter_mut().enumerate() {\n        *b = seed.wrapping_add(i as u8).wrapping_mul(37) | 0x11;\n    }\n    m\n}\n\npub fn poison_proxy(seed: u8) -> c2Proxy {\n    let mut p = c2Proxy::default();\n    let bytes = unsafe {\n        std::slice::from_raw_parts_mut(\n            &mut p as *mut c2Proxy as *mut u8,\n            std::mem::size_of::<c2Proxy>(),\n        )\n    };\n    for (i, b) in bytes.iter_mut().enumerate() {\n        *b = seed.wrapping_add(i as u8).wrapping_mul(101) | 0x03;\n    }\n    p\n}\n\n/// Convex CCW polygon with `count` vertices on a circle of radius `r`, plus a\n/// random phase, with correct outward normals computed by the library under test.\npub fn convex_poly(rng: &mut Rng, count: i32, r: f32, center: c2v) -> c2Poly {\n    let mut p = c2Poly::default();\n    p.count = count;\n    let phase = rng.f_pos(std::f32::consts::TAU);\n    let n = count.max(1) as usize;\n    for i in 0..n.min(8) {\n        // CCW ordering\n        let t = phase + (i as f32) * std::f32::consts::TAU / (n as f32);\n        p.verts[i] = v(center.x + r * t.cos(), center.y + r * t.sin());\n    }\n    p\n}\n\n/// Fill `norms` using the *library's own* `c2Norms` so both sides start identical.\npub fn fill_norms_with(libs: &Libs, p: &mut c2Poly) {\n    type F = unsafe extern \"C\" fn(*mut c2v, *mut c2v, i32);\n    let (cf, _rf) = libs.get::<F>(\"c2Norms\");\n    unsafe { cf(p.verts.as_mut_ptr(), p.norms.as_mut_ptr(), p.count) };\n}\nEOF\ntimeout 300 cargo build --offline 2>&1 | tail -5","description":"Write test common module"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6380,"cache_read_input_tokens":87999,"cache_creation":{"ephemeral_5m_input_tokens":6380,"ephemeral_1h_input_tokens":0},"output_t