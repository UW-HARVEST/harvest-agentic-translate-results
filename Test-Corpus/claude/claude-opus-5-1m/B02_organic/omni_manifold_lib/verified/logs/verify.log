{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CcaVUxMC4KphNFod9EtPcL","type":"tool_result","content":"1\t//! Clipping helpers and the per-shape-pair manifold generators.\n2\t//!\n3\t//! `c2Clip`, `c2SidePlanes`, `c2SidePlanesFromPoly`, `c2KeepDeep` and `c2Incident`\n4\t//! are `static` in the C source and are therefore *not* exported here either — the\n5\t//! C shared object does not list them in its dynamic symbol table.\n6\t\n7\tuse crate::math::{\n8\t    c2Absv, c2Add, c2CCW90, c2Clampv, c2Dist, c2Dot, c2Intersect, c2Mulvs, c2Mulxv, c2MulxvT,\n9\t    c2Neg, c2Norm, c2Skew, c2Sub, c2V, c2xIdentity,\n10\t};\n11\tuse crate::shapes::{c2BBVerts, c2Norms, c2PlaneAt, c2Support};\n12\tuse crate::fp;\n13\tuse crate::gjk::c2GJK;\n14\tuse crate::types::{\n15\t    c2AABB, c2Capsule, c2Circle, c2Manifold, c2Poly, c2v, c2x, c2h, C2_FLT_MAX, C2_TYPE_CAPSULE,\n16\t    C2_TYPE_CIRCLE, C2_TYPE_POLY,\n17\t};\n18\tuse core::ffi::{c_float, c_int, c_void};\n19\t\n20\t/// Clip a 2-point segment against a half-space, keeping the negative side.\n21\t///\n22\t/// The C original declares `c2v out[2]` uninitialized and can push up to three\n23\t/// entries (when `d0 < 0`, `d1 < 0` and `d0 * d1` underflows to exactly `0`), so we\n24\t/// give the buffer four slots to avoid stepping outside it. Only `out[0]` and\n25\t/// `out[1]` are ever copied back, and whenever fewer than two entries were pushed\n26\t/// every caller bails out immediately and discards `seg`, so the initial contents\n27\t/// are not observable.\n28\tfn c2Clip(seg: *mut c2v, h: c2h) -> c_int {\n29\t    unsafe {\n30\t        let mut out = [c2v::default(); 4];\n31\t        let mut sp: usize = 0;\n32\t        let d0 = c2Dist(h, *seg.offset(0));\n33\t        if d0 < 0.0 {\n34\t            out[sp] = *seg.offset(0);\n35\t            sp += 1;\n36\t        }\n37\t        let d1 = c2Dist(h, *seg.offset(1));\n38\t        if d1 < 0.0 {\n39\t            out[sp] = *seg.offset(1);\n40\t            sp += 1;\n41\t        }\n42\t        if d0 == 0.0 && d1 == 0.0 {\n43\t            out[sp] = *seg.offset(0);\n44\t            sp += 1;\n45\t            out[sp] = *seg.offset(1);\n46\t            sp += 1;\n47\t        } else if d0 * d1 <= 0.0 {\n48\t            out[sp] = c2Intersect(*seg.offset(0), *seg.offset(1), d0, d1);\n49\t            sp += 1;\n50\t        }\n51\t        *seg.offset(0) = out[0];\n52\t        *seg.offset(1) = out[1];\n53\t        sp as c_int\n54\t    }\n55\t}\n56\t\n57\t/// Clip `seg` against the two planes bounding the edge `ra` -> `rb`.\n58\tfn c2SidePlanes(seg: *mut c2v, ra: c2v, rb: c2v, h: *mut c2h) -> c_int {\n59\t    unsafe {\n60\t        let in_ = c2Norm(c2Sub(rb, ra));\n61\t        let left = c2h {\n62\t            n: c2Neg(in_),\n63\t            d: c2Dot(c2Neg(in_), ra),\n64\t        };\n65\t        let right = c2h {\n66\t            n: in_,\n67\t            d: c2Dot(in_, rb),\n68\t        };\n69\t        if c2Clip(seg, left) < 2 {\n70\t            return 0;\n71\t        }\n72\t        if c2Clip(seg, right) < 2 {\n73\t            return 0;\n74\t        }\n75\t        if !h.is_null() {\n76\t            (*h).n = c2CCW90(in_);\n77\t            (*h).d = c2Dot(c2CCW90(in_), ra);\n78\t        }\n79\t        1\n80\t    }\n81\t}\n82\t\n83\tfn c2SidePlanesFromPoly(seg: *mut c2v, x: c2x, p: *const c2Poly, e: c_int, h: *mut c2h) -> c_int {\n84\t    unsafe {\n85\t        let verts = (*p).verts.as_ptr();\n86\t        let ra = c2Mulxv(x, *verts.offset(e as isize));\n87\t        let next = if e + 1 == (*p).count { 0 } else { e + 1 };\n88\t        let rb = c2Mulxv(x, *verts.offset(next as isize));\n89\t        c2SidePlanes(seg, ra, rb, h)\n90\t    }\n91\t}\n92\t\n93\t/// Keep whichever of the two segment points lie behind `h`.\n94\tfn c2KeepDeep(seg: *mut c2v, h: c2h, m: *mut c2Manifold) {\n95\t    unsafe {\n96\t        let mut cp: usize = 0;\n97\t        for i in 0..2usize {\n98\t            let p = *seg.add(i);\n99\t            let d = c2Dist(h, p);\n100\t            if d <= 0.0 {\n101\t                (*m).contact_points[cp] = p;\n102\t                (*m).depths[cp] = -d;\n103\t                cp += 1;\n104\t            }\n105\t        }\n106\t        (*m).count = cp as c_int;\n107\t        (*m).n = h.n;\n108\t    }\n109\t}\n110\t\n111\t/// Find the incident edge on `ip` most anti-parallel to `rn_in_incident_space`.\n112\t///\n113\t/// Faithfully keeps C's `int index = ~0;` initialiser. If `ip->count <= 0` the loop\n114\t/// never runs and `index` stays `-1`, so `ip->verts[-1]` is read out of bounds —\n115\t/// that is reachable through `c2CapsuletoPolyManifold` with an empty polygon, so the\n116\t/// raw offset is preserved rather than clamped.\n117\tfn c2Incident(incident: *mut c2v, ip: *const c2Poly, ix: c2x, rn_in_incident_space: c2v) {\n118\t    unsafe {\n119\t        let mut index: c_int = !0;\n120\t        let mut min_dot: c_float = C2_FLT_MAX;\n121\t        let norms = (*ip).norms.as_ptr();\n122\t        let verts = (*ip).verts.as_ptr();\n123\t        let count = (*ip).count;\n124\t        let mut i: c_int = 0;\n125\t        while i < count {\n126\t            let dot = c2Dot(rn_in_incident_space, *norms.offset(i as isize));\n127\t            if dot < min_dot {\n128\t                min_dot = dot;\n129\t                index = i;\n130\t            }\n131\t            i += 1;\n132\t        }\n133\t        *incident.offset(0) = c2Mulxv(ix, *verts.offset(index as isize));\n134\t        let next = if index + 1 == count { 0 } else { index + 1 };\n135\t        *incident.offset(1) = c2Mulxv(ix, *verts.offset(next as isize));\n136\t    }\n137\t}\n138\t\n139\t#[inline(never)]\n140\t#[unsafe(no_mangle)]\n141\tpub unsafe extern \"C\" fn c2CircletoCircleManifold(A: c2Circle, B: c2Circle, m: *mut c2Manifold) {\n142\t    unsafe {\n143\t        (*m).count = 0;\n144\t        let d = c2Sub(B.p, A.p);\n145\t        let d2 = c2Dot(d, d);\n146\t        let r = fp::add(A.r, B.r);\n147\t        if d2 < fp::mul(r, r) {\n148\t            let l = d2.sqrt();\n149\t            let n = if l != 0.0 {\n150\t                c2Mulvs(d, 1.0 / l)\n151\t            } else {\n152\t                c2V(0.0, 1.0)\n153\t            };\n154\t            (*m).count = 1;\n155\t            (*m).depths[0] = r - l;\n156\t            (*m).contact_points[0] = c2Sub(B.p, c2Mulvs(n, B.r));\n157\t            (*m).n = n;\n158\t        }\n159\t    }\n160\t}\n161\t\n162\t#[inline(never)]\n163\t#[unsafe(no_mangle)]\n164\tpub unsafe extern \"C\" fn c2CircletoAABBManifold(A: c2Circle, B: c2AABB, m: *mut c2Manifold) {\n165\t    unsafe {\n166\t        (*m).count = 0;\n167\t        let L = c2Clampv(A.p, B.min, B.max);\n168\t        let ab = c2Sub(L, A.p);\n169\t        let d2 = c2Dot(ab, ab);\n170\t        let r2 = fp::mul(A.r, A.r);\n171\t        if d2 < r2 {\n172\t            if d2 != 0.0 {\n173\t                let d = d2.sqrt();\n174\t                let n = c2Norm(ab);\n175\t                (*m).count = 1;\n176\t                (*m).depths[0] = A.r - d;\n177\t                (*m).contact_points[0] = c2Add(A.p, c2Mulvs(n, d));\n178\t                (*m).n = n;\n179\t            } else {\n180\t                let mid = c2Mulvs(c2Add(B.min, B.max), 0.5);\n181\t                let e = c2Mulvs(c2Sub(B.max, B.min), 0.5);\n182\t                let d = c2Sub(A.p, mid);\n183\t                let abs_d = c2Absv(d);\n184\t                let x_overlap = e.x - abs_d.x;\n185\t                let y_overlap = e.y - abs_d.y;\n186\t                let depth: c_float;\n187\t                let mut n: c2v;\n188\t                if x_overlap < y_overlap {\n189\t                    depth = x_overlap;\n190\t                    n = c2V(1.0, 0.0);\n191\t                    n = c2Mulvs(n, if d.x < 0.0 { 1.0 } else { -1.0 });\n192\t                } else {\n193\t                    depth = y_overlap;\n194\t                    n = c2V(0.0, 1.0);\n195\t                    n = c2Mulvs(n, if d.y < 0.0 { 1.0 } else { -1.0 });\n196\t                }\n197\t                (*m).count = 1;\n198\t                (*m).depths[0] = fp::add(A.r, depth);\n199\t                (*m).contact_points[0] = c2Sub(A.p, c2Mulvs(n, depth));\n200\t                (*m).n = n;\n201\t            }\n202\t        }\n203\t    }\n204\t}\n205\t\n206\t#[inline(never)]\n207\t#[unsafe(no_mangle)]\n208\tpub unsafe extern \"C\" fn c2CircletoCapsuleManifold(A: c2Circle, B: c2Capsule, m: *mut c2Manifold) {\n209\t    unsafe {\n210\t        (*m).count = 0;\n211\t        let mut a = c2v::default();\n212\t        let mut b = c2v::default();\n213\t        let r = fp::add(A.r, B.r);\n214\t        let d = c2GJK(\n215\t            &A as *const c2Circle as *const c_void,\n216\t            C2_TYPE_CIRCLE,\n217\t            core::ptr::null(),\n218\t            &B as *const c2Capsule as *const c_void,\n219\t            C2_TYPE_CAPSULE,\n220\t            core::ptr::null(),\n221\t            &mut a,\n222\t            &mut b,\n223\t            0,\n224\t            core::ptr::null_mut(),\n225\t            core::ptr::null_mut(),\n226\t        );\n227\t        if d < r {\n228\t            let n = if d == 0.0 {\n229\t                c2Norm(c2Skew(c2Sub(B.b, B.a)))\n230\t            } else {\n231\t                c2Norm(c2Sub(b, a))\n232\t            };\n233\t            (*m).count = 1;\n234\t            (*m).depths[0] = r - d;\n235\t            (*m).contact_points[0] = c2Sub(b, c2Mulvs(n, B.r));\n236\t            (*m).n = n;\n237\t        }\n238\t    }\n239\t}\n240\t\n241\t#[inline(never)]\n242\t#[unsafe(no_mangle)]\n243\tpub unsafe extern \"C\" fn c2AABBtoAABBManifold(A: c2AABB, B: c2AABB, m: *mut c2Manifold) {\n244\t    unsafe {\n245\t        (*m).count = 0;\n246\t        let mid_a = c2Mulvs(c2Add(A.min, A.max), 0.5);\n247\t        let mid_b = c2Mulvs(c2Add(B.min, B.max), 0.5);\n248\t        let eA = c2Absv(c2Mulvs(c2Sub(A.max, A.min), 0.5));\n249\t        let eB = c2Absv(c2Mulvs(c2Sub(B.max, B.min), 0.5));\n250\t        let d = c2Sub(mid_b, mid_a);\n251\t        // C: eA.x + eB.x - ((d.x) < 0 ? -(d.x) : (d.x))\n252\t        // GCC evaluates eA first, spills it, then computes eB and emits\n253\t        // `addss 0x18(%rsp),%xmm4` -- so eB is the destination operand, i.e. the\n254\t        // operands are reversed with respect to the source order.\n255\t        let dx = fp::add(eB.x, eA.x) - (if d.x < 0.0 { -d.x } else { d.x });\n256\t        if dx < 0.0 {\n257\t            return;\n258\t        }\n259\t        let dy = fp::add(eB.y, eA.y) - (if d.y < 0.0 { -d.y } else { d.y });\n260\t        if dy < 0.0 {\n261\t            return;\n262\t        }\n263\t        let n: c2v;\n264\t        let depth: c_float;\n265\t        let p: c2v;\n266\t        if dx < dy {\n267\t            depth = dx;\n268\t            if d.x < 0.0 {\n269\t                n = c2V(-1.0, 0.0);\n270\t                p = c2Sub(mid_a, c2V(eA.x, 0.0));\n271\t            } else {\n272\t                n = c2V(1.0, 0.0);\n273\t                p = c2Add(mid_a, c2V(eA.x, 0.0));\n274\t            }\n275\t        } else {\n276\t            depth = dy;\n277\t            if d.y < 0.0 {\n278\t                n = c2V(0.0, -1.0);\n279\t                p = c2Sub(mid_a, c2V(0.0, eA.y));\n280\t            } else {\n281\t                n = c2V(0.0, 1.0);\n282\t                p = c2Add(mid_a, c2V(0.0, eA.y));\n283\t            }\n284\t        }\n285\t        (*m).count = 1;\n286\t        (*m).contact_points[0] = p;\n287\t        (*m).depths[0] = depth;\n288\t        (*m).n = n;\n289\t    }\n290\t}\n291\t\n292\t#[inline(never)]\n293\t#[unsafe(no_mangle)]\n294\tpub unsafe extern \"C\" fn c2CapsuletoPolyManifold(\n295\t    A: c2Capsule,\n296\t    B: *const c2Poly,\n297\t    bx_ptr: *const c2x,\n298\t    m: *mut c2Manifold,\n299\t) {\n300\t    unsafe {\n301\t        (*m).count = 0;\n302\t        let mut a = c2v::default();\n303\t        let mut b = c2v::default();\n304\t        let d = c2GJK(\n305\t            &A as *const c2Capsule as *const c_void,\n306\t            C2_TYPE_CAPSULE,\n307\t            core::ptr::null(),\n308\t            B as *const c_void,\n309\t            C2_TYPE_POLY,\n310\t            bx_ptr,\n311\t            &mut a,\n312\t            &mut b,\n313\t            0,\n314\t            core::ptr::null_mut(),\n315\t            core::ptr::null_mut(),\n316\t        );\n317\t        if d < 1.0e-6 {\n318\t            let bx: c2x = if !bx_ptr.is_null() {\n319\t                *bx_ptr\n320\t            } else {\n321\t                c2xIdentity()\n322\t            };\n323\t            let mut A_in_B = c2Capsule::default();\n324\t            A_in_B.a = c2MulxvT(bx, A.a);\n325\t            A_in_B.b = c2MulxvT(bx, A.b);\n326\t            let ab = c2Norm(c2Sub(A_in_B.a, A_in_B.b));\n327\t\n328\t            let b_verts = (*B).verts.as_ptr();\n329\t            let b_count = (*B).count;\n330\t\n331\t            let mut ab_h0 = c2h::default();\n332\t            ab_h0.n = c2CCW90(ab);\n333\t            ab_h0.d = c2Dot(A_in_B.a, ab_h0.n);\n334\t            let v0 = c2Support(b_verts, b_count, c2Neg(ab_h0.n));\n335\t            let s0 = c2Dist(ab_h0, *b_verts.offset(v0 as isize));\n336\t\n337\t            let mut ab_h1 = c2h::default();\n338\t            ab_h1.n = c2Skew(ab);\n339\t            ab_h1.d = c2Dot(A_in_B.a, ab_h1.n);\n340\t            let v1 = c2Support(b_verts, b_count, c2Neg(ab_h1.n));\n341\t            let s1 = c2Dist(ab_h1, *b_verts.offset(v1 as isize));\n342\t\n343\t            let mut index: c_int = !0;\n344\t            let mut sep: c_float = -C2_FLT_MAX;\n345\t            let mut code: c_int = 0;\n346\t            let mut i: c_int = 0;\n347\t            while i < b_count {\n348\t                let h = c2PlaneAt(B, i);\n349\t                let da = c2Dot(A_in_B.a, c2Neg(h.n));\n350\t                let db = c2Dot(A_in_B.b, c2Neg(h.n));\n351\t                let d: c_float = if da > db {\n352\t                    c2Dist(h, A_in_B.a)\n353\t                } else {\n354\t                    c2Dist(h, A_in_B.b)\n355\t                };\n356\t                if d > sep {\n357\t                    sep = d;\n358\t                    index = i;\n359\t                }\n360\t                i += 1;\n361\t            }\n362\t            if s0 > sep {\n363\t                sep = s0;\n364\t                index = v0;\n365\t                code = 1;\n366\t            }\n367\t            if s1 > sep {\n368\t                sep = s1;\n369\t                index = v1;\n370\t                code = 2;\n371\t            }\n372\t            let _ = sep;\n373\t\n374\t            match code {\n375\t                0 => {\n376\t                    let mut seg: [c2v; 2] = [A.a, A.b];\n377\t                    let mut h = c2h::default();\n378\t                    if c2SidePlanesFromPoly(seg.as_mut_ptr(), bx, B, index, &mut h) == 0 {\n379\t                        return;\n380\t                    }\n381\t                    c2KeepDeep(seg.as_mut_ptr(), h, m);\n382\t                    (*m).n = c2Neg((*m).n);\n383\t                }\n384\t                1 => {\n385\t                    let mut incident = [c2v::default(); 2];\n386\t                    c2Incident(incident.as_mut_ptr(), B, bx, ab_h0.n);\n387\t                    let mut h = c2h::default();\n388\t                    if c2SidePlanes(incident.as_mut_ptr(), A_in_B.b, A_in_B.a, &mut h) == 0 {\n389\t                        return;\n390\t                    }\n391\t                    c2KeepDeep(incident.as_mut_ptr(), h, m);\n392\t                }\n393\t                2 => {\n394\t                    let mut incident = [c2v::default(); 2];\n395\t                    c2Incident(incident.as_mut_ptr(), B, bx, ab_h1.n);\n396\t                    let mut h = c2h::default();\n397\t                    if c2SidePlanes(incident.as_mut_ptr(), A_in_B.a, A_in_B.b, &mut h) == 0 {\n398\t                        return;\n399\t                    }\n400\t                    c2KeepDeep(incident.as_mut_ptr(), h, m);\n401\t                }\n402\t                _ => return,\n403\t            }\n404\t            let mut i: c_int = 0;\n405\t            while i < (*m).count {\n406\t                if (i as usize) < 2 {\n407\t                    (*m).depths[i as usize] =\n408\t                        fp::add((*m).depths[i as usize], A.r);\n409\t                }\n410\t                i += 1;\n411\t            }\n412\t        } else if d < A.r {\n413\t            (*m).count = 1;\n414\t            (*m).n = c2Norm(c2Sub(b, a));\n415\t            (*m).contact_points[0] = c2Add(a, c2Mulvs((*m).n, A.r));\n416\t            (*m).depths[0] = A.r - d;\n417\t        }\n418\t    }\n419\t}\n420\t\n421\t/// AABB vs capsule, by promoting the AABB to a 4-gon.\n422\t///\n423\t/// Note the trailing `m->n = c2Neg(m->n);`: when `c2CapsuletoPolyManifold` bails out\n424\t/// early it leaves `m->n` untouched, so this negates whatever the *caller* had in\n425\t/// that field. Reading through `m` reproduces that exactly.\n426\t#[inline(never)]\n427\t#[unsafe(no_mangle)]\n428\tpub unsafe extern \"C\" fn c2AABBtoCapsuleManifold(A: c2AABB, B: c2Capsule, m: *mut c2Manifold) {\n429\t    unsafe {\n430\t        (*m).count = 0;\n431\t        let mut p = c2Poly::default();\n432\t        let mut a_local = A;\n433\t        c2BBVerts(p.verts.as_mut_ptr(), &mut a_local);\n434\t        p.count = 4;\n435\t        c2Norms(p.verts.as_mut_ptr(), p.norms.as_mut_ptr(), 4);\n436\t        c2CapsuletoPolyManifold(B, &p, core::ptr::null(), m);\n437\t        (*m).n = c2Neg((*m).n);\n438\t    }\n439\t}\n440\t\n441\t#[inline(never)]\n442\t#[unsafe(no_mangle)]\n443\tpub unsafe extern \"C\" fn c2CapsuletoCapsuleManifold(\n444\t    A: c2Capsule,\n445\t    B: c2Capsule,\n446\t    m: *mut c2Manifold,\n447\t) {\n448\t    unsafe {\n449\t        (*m).count = 0;\n450\t        let mut a = c2v::default();\n451\t        let mut b = c2v::default();\n452\t        let r = fp::add(A.r, B.r);\n453\t        let d = c2GJK(\n454\t            &A as *const c2Capsule as *const c_void,\n455\t            C2_TYPE_CAPSULE,\n456\t            core::ptr::null(),\n457\t            &B as *const c2Capsule as *const c_void,\n458\t            C2_TYPE_CAPSULE,\n459\t            core::ptr::null(),\n460\t            &mut a,\n461\t            &mut b,\n462\t            0,\n463\t            core::ptr::null_mut(),\n464\t            core::ptr::null_mut(),\n465\t        );\n466\t        if d < r {\n467\t            let n = if d == 0.0 {\n468\t                c2Norm(c2Skew(c2Sub(A.b, A.a)))\n469\t            } else {\n470\t                c2Norm(c2Sub(b, a))\n471\t            };\n472\t            (*m).count = 1;\n473\t            (*m).depths[0] = r - d;\n474\t            (*m).contact_points[0] = c2Sub(b, c2Mulvs(n, B.r));\n475\t            (*m).n = n;\n476\t        }\n477\t    }\n478\t}\n479\t"}]},"parent_tool_use_id":null,"session_id":"27d6de7a-57e2-4fbc-9590-8efa6a5bf865","uuid":"d7063dff-dc1b-46f7-85e6-fe8012d6fcb7","timestamp":"2026-08-20T11:51:25.989Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-4VIOLY/translated_rust/src/manifold.rs","content":"//! Clipping helpers and the per-shape-pair manifold generators.\n//!\n//! `c2Clip`, `c2SidePlanes`, `c2SidePlanesFromPoly`, `c2KeepDeep` and `c2Incident`\n//! are `static` in the C source and are therefore *not* exported here either — the\n//! C shared object does not list them in its dynamic symbol table.\n\nuse crate::math::{\n    c2Absv, c2Add, c2CCW90, c2Clampv, c2Dist, c2Dot, c2Intersect, c2Mulvs, c2Mulxv, c2MulxvT,\n    c2Neg, c2Norm, c2Skew, c2Sub, c2V, c2xIdentity,\n};\nuse crate::shapes::{c2BBVerts, c2Norms, c2PlaneAt, c2Support};\nuse crate::fp;\nuse crate::gjk::c2GJK;\nuse crate::types::{\n    c2AABB, c2Capsule, c2Circle, c2Manifold, c2Poly, c2v, c2x, c2h, C2_FLT_MAX, C2_TYPE_CAPSULE,\n    C2_TYPE_CIRCLE, C2_TYPE_POLY,\n};\nuse core::ffi::{c_float, c_int, c_void};\n\n/// Clip a 2-point segment against a half-space, keeping the negative side.\n///\n/// The C original declares `c2v out[2]` uninitialized and can push up to three\n/// entries (when `d0 < 0`, `d1 < 0` and `d0 * d1` underflows to exactly `0`), so we\n/// give the buffer four slots to avoid stepping outside it. Only `out[0]` and\n/// `out[1]` are ever copied back, and whenever fewer than two entries were pushed\n/// every caller bails out immediately and discards `seg`, so the initial contents\n/// are not observable.\nfn c2Clip(seg: *mut c2v, h: c2h) -> c_int {\n    unsafe {\n        let mut out = [c2v::default(); 4];\n        let mut sp: usize = 0;\n        let d0 = c2Dist(h, *seg.offset(0));\n        if d0 < 0.0 {\n            out[sp] = *seg.offset(0);\n            sp += 1;\n        }\n        let d1 = c2Dist(h, *seg.offset(1));\n        if d1 < 0.0 {\n            out[sp] = *seg.offset(1);\n            sp += 1;\n        }\n        if d0 == 0.0 && d1 == 0.0 {\n            out[sp] = *seg.offset(0);\n            sp += 1;\n            out[sp] = *seg.offset(1);\n            sp += 1;\n        } else if d0 * d1 <= 0.0 {\n            out[sp] = c2Intersect(*seg.offset(0), *seg.offset(1), d0, d1);\n            sp += 1;\n        }\n        *seg.offset(0) = out[0];\n        *seg.offset(1) = out[1];\n        sp as c_int\n    }\n}\n\n/// Clip `seg` against the two planes bounding the edge `ra` -> `rb`.\nfn c2SidePlanes(seg: *mut c2v, ra: c2v, rb: c2v, h: *mut c2h) -> c_int {\n    unsafe {\n        let in_ = c2Norm(c2Sub(rb, ra));\n        let left = c2h {\n            n: c2Neg(in_),\n            d: c2Dot(c2Neg(in_), ra),\n        };\n        let right = c2h {\n            n: in_,\n            d: c2Dot(in_, rb),\n        };\n        if c2Clip(seg, left) < 2 {\n            return 0;\n        }\n        if c2Clip(seg, right) < 2 {\n            return 0;\n        }\n        if !h.is_null() {\n            (*h).n = c2CCW90(in_);\n            (*h).d = c2Dot(c2CCW90(in_), ra);\n        }\n        1\n    }\n}\n\nfn c2SidePlanesFromPoly(seg: *mut c2v, x: c2x, p: *const c2Poly, e: c_int, h: *mut c2h) -> c_int {\n    unsafe {\n        let verts = (*p).verts.as_ptr();\n        let ra = c2Mulxv(x, *verts.offset(e as isize));\n        let next = if e + 1 == (*p).count { 0 } else { e + 1 };\n        let rb = c2Mulxv(x, *verts.offset(next as isize));\n        c2SidePlanes(seg, ra, rb, h)\n    }\n}\n\n/// Keep whichever of the two segment points lie behind `h`.\nfn c2KeepDeep(seg: *mut c2v, h: c2h, m: *mut c2Manifold) {\n    unsafe {\n        let mut cp: usize = 0;\n        for i in 0..2usize {\n            let p = *seg.add(i);\n            let d = c2Dist(h, p);\n            if d <= 0.0 {\n                (*m).contact_points[cp] = p;\n                (*m).depths[cp] = -d;\n                cp += 1;\n            }\n        }\n        (*m).count = cp as c_int;\n        (*m).n = h.n;\n    }\n}\n\n/// Find the incident edge on `ip` most anti-parallel to `rn_in_incident_space`.\n///\n/// Faithfully keeps C's `int index = ~0;` initialiser. If `ip->count <= 0` the loop\n/// never runs and `index` stays `-1`, so `ip->verts[-1]` is read out of bounds —\n/// that is reachable through `c2CapsuletoPolyManifold` with an empty polygon, so the\n/// raw offset is preserved rather than clamped.\nfn c2Incident(incident: *mut c2v, ip: *const c2Poly, ix: c2x, rn_in_incident_space: c2v) {\n    unsafe {\n        let mut index: c_int = !0;\n        let mut min_dot: c_float = C2_FLT_MAX;\n        let norms = (*ip).norms.as_ptr();\n        let verts = (*ip).verts.as_ptr();\n        let count = (*ip).count;\n        let mut i: c_int = 0;\n        while i < count {\n            let dot = c2Dot(rn_in_incident_space, *norms.offset(i as isize));\n            if dot < min_dot {\n                min_dot = dot;\n                index = i;\n            }\n            i += 1;\n        }\n        *incident.offset(0) = c2Mulxv(ix, *verts.offset(index as isize));\n        let next = if index + 1 == count { 0 } else { index + 1 };\n        *incident.offset(1) = c2Mulxv(ix, *verts.offset(next as isize));\n    }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2CircletoCircleManifold(A: c2Circle, B: c2Circle, m: *mut c2Manifold) {\n    unsafe {\n        (*m).count = 0;\n        let d = c2Sub(B.p, A.p);\n        let d2 = c2Dot(d, d);\n        let r = fp::add(A.r, B.r);\n        if d2 < fp::mul(r, r) {\n            let l = d2.sqrt();\n            let n = if l != 0.0 {\n                c2Mulvs(d, 1.0 / l)\n            } else {\n                c2V(0.0, 1.0)\n            };\n            (*m).count = 1;\n            (*m).depths[0] = r - l;\n            (*m).contact_points[0] = c2Sub(B.p, c2Mulvs(n, B.r));\n            (*m).n = n;\n        }\n    }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2CircletoAABBManifold(A: c2Circle, B: c2AABB, m: *mut c2Manifold) {\n    unsafe {\n        (*m).count = 0;\n        let L = c2Clampv(A.p, B.min, B.max);\n        let ab = c2Sub(L, A.p);\n        let d2 = c2Dot(ab, ab);\n        let r2 = fp::mul(A.r, A.r);\n        if d2 < r2 {\n            if d2 != 0.0 {\n                let d = d2.sqrt();\n                let n = c2Norm(ab);\n                (*m).count = 1;\n                (*m).depths[0] = A.r - d;\n                (*m).contact_points[0] = c2Add(A.p, c2Mulvs(n, d));\n                (*m).n = n;\n            } else {\n                let mid = c2Mulvs(c2Add(B.min, B.max), 0.5);\n                let e = c2Mulvs(c2Sub(B.max, B.min), 0.5);\n                let d = c2Sub(A.p, mid);\n                let abs_d = c2Absv(d);\n                let x_overlap = e.x - abs_d.x;\n                let y_overlap = e.y - abs_d.y;\n                let depth: c_float;\n                let mut n: c2v;\n                if x_overlap < y_overlap {\n                    depth = x_overlap;\n                    n = c2V(1.0, 0.0);\n                    n = c2Mulvs(n, if d.x < 0.0 { 1.0 } else { -1.0 });\n                } else {\n                    depth = y_overlap;\n                    n = c2V(0.0, 1.0);\n                    n = c2Mulvs(n, if d.y < 0.0 { 1.0 } else { -1.0 });\n                }\n                (*m).count = 1;\n                (*m).depths[0] = fp::add(A.r, depth);\n                (*m).contact_points[0] = c2Sub(A.p, c2Mulvs(n, depth));\n                (*m).n = n;\n            }\n        }\n    }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2CircletoCapsuleManifold(A: c2Circle, B: c2Capsule, m: *mut c2Manifold) {\n    unsafe {\n        (*m).count = 0;\n        let mut a = c2v::default();\n        let mut b = c2v::default();\n        let r = fp::add(A.r, B.r);\n        let d = c2GJK(\n            &A as *const c2Circle as *const c_void,\n            C2_TYPE_CIRCLE,\n            core::ptr::null(),\n            &B as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            &mut a,\n            &mut b,\n            0,\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n        );\n        if d < r {\n            let n = if d == 0.0 {\n                c2Norm(c2Skew(c2Sub(B.b, B.a)))\n            } else {\n                c2Norm(c2Sub(b, a))\n            };\n            (*m).count = 1;\n            (*m).depths[0] = r - d;\n            (*m).contact_points[0] = c2Sub(b, c2Mulvs(n, B.r));\n            (*m).n = n;\n        }\n    }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2AABBtoAABBManifold(A: c2AABB, B: c2AABB, m: *mut c2Manifold) {\n    unsafe {\n        (*m).count = 0;\n        let mid_a = c2Mulvs(c2Add(A.min, A.max), 0.5);\n        let mid_b = c2Mulvs(c2Add(B.min, B.max), 0.5);\n        let eA = c2Absv(c2Mulvs(c2Sub(A.max, A.min), 0.5));\n        let eB = c2Absv(c2Mulvs(c2Sub(B.max, B.min), 0.5));\n        let d = c2Sub(mid_b, mid_a);\n        // C: eA.x + eB.x - ((d.x) < 0 ? -(d.x) : (d.x))\n        // GCC evaluates eA first, spills it, then computes eB and emits\n        // `addss 0x18(%rsp),%xmm4` -- so eB is the destination operand, i.e. the\n        // operands are reversed with respect to the source order.\n        let dx = fp::add(eB.x, eA.x) - (if d.x < 0.0 { -d.x } else { d.x });\n        if dx < 0.0 {\n            return;\n        }\n        let dy = fp::add(eB.y, eA.y) - (if d.y < 0.0 { -d.y } else { d.y });\n        if dy < 0.0 {\n            return;\n        }\n        let n: c2v;\n        let depth: c_float;\n        let p: c2v;\n        if dx < dy {\n            depth = dx;\n            if d.x < 0.0 {\n                n = c2V(-1.0, 0.0);\n                p = c2Sub(mid_a, c2V(eA.x, 0.0));\n            } else {\n                n = c2V(1.0, 0.0);\n                p = c2Add(mid_a, c2V(eA.x, 0.0));\n            }\n        } else {\n            depth = dy;\n            if d.y < 0.0 {\n                n = c2V(0.0, -1.0);\n                p = c2Sub(mid_a, c2V(0.0, eA.y));\n            } else {\n                n = c2V(0.0, 1.0);\n                p = c2Add(mid_a, c2V(0.0, eA.y));\n            }\n        }\n        (*m).count = 1;\n        (*m).contact_points[0] = p;\n        (*m).depths[0] = depth;\n        (*m).n = n;\n    }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2CapsuletoPolyManifold(\n    A: c2Capsule,\n    B: *const c2Poly,\n    bx_ptr: *const c2x,\n    m: *mut c2Manifold,\n) {\n    unsafe {\n        (*m).count = 0;\n        let mut a = c2v::default();\n        let mut b = c2v::default();\n        let d = c2GJK(\n            &A as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            B as *const c_void,\n            C2_TYPE_POLY,\n            bx_ptr,\n            &mut a,\n            &mut b,\n            0,\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n        );\n        if d < 1.0e-6 {\n            let bx: c2x = if !bx_ptr.is_null() {\n                *bx_ptr\n            } else {\n                c2xIdentity()\n            };\n            let mut A_in_B = c2Capsule::default();\n            A_in_B.a = c2MulxvT(bx, A.a);\n            A_in_B.b = c2MulxvT(bx, A.b);\n            let ab = c2Norm(c2Sub(A_in_B.a, A_in_B.b));\n\n            let b_verts = (*B).verts.as_ptr();\n            let b_count = (*B).count;\n\n            let mut ab_h0 = c2h::default();\n            ab_h0.n = c2CCW90(ab);\n            ab_h0.d = c2Dot(A_in_B.a, ab_h0.n);\n            let v0 = c2Support(b_verts, b_count, c2Neg(ab_h0.n));\n            let s0 = c2Dist(ab_h0, *b_verts.offset(v0 as isize));\n\n            let mut ab_h1 = c2h::default();\n            ab_h1.n = c2Skew(ab);\n            ab_h1.d = c2Dot(A_in_B.a, ab_h1.n);\n            let v1 = c2Support(b_verts, b_count, c2Neg(ab_h1.n));\n            let s1 = c2Dist(ab_h1, *b_verts.offset(v1 as isize));\n\n            let mut index: c_int = !0;\n            let mut sep: c_float = -C2_FLT_MAX;\n            let mut code: c_int = 0;\n            let mut i: c_int = 0;\n            while i < b_count {\n                let h = c2PlaneAt(B, i);\n                let da = c2Dot(A_in_B.a, c2Neg(h.n));\n                let db = c2Dot(A_in_B.b, c2Neg(h.n));\n                let d: c_float = if da > db {\n                    c2Dist(h, A_in_B.a)\n                } else {\n                    c2Dist(h, A_in_B.b)\n                };\n                if d > sep {\n                    sep = d;\n                    index = i;\n                }\n                i += 1;\n            }\n            if s0 > sep {\n                sep = s0;\n                index = v0;\n                code = 1;\n            }\n            if s1 > sep {\n                sep = s1;\n                index = v1;\n                code = 2;\n            }\n            let _ = sep;\n\n            match code {\n                0 => {\n                    let mut seg: [c2v; 2] = [A.a, A.b];\n                    let mut h = c2h::default();\n                    if c2SidePlanesFromPoly(seg.as_mut_ptr(), bx, B, index, &mut h) == 0 {\n                        return;\n                    }\n                    c2KeepDeep(seg.as_mut_ptr(), h, m);\n                    (*m).n = c2Neg((*m).n);\n                }\n                1 => {\n                    let mut incident = [c2v::default(); 2];\n                    c2Incident(incident.as_mut_ptr(), B, bx, ab_h0.n);\n                    let mut h = c2h::default();\n                    if c2SidePlanes(incident.as_mut_ptr(), A_in_B.b, A_in_B.a, &mut h) == 0 {\n                        return;\n                    }\n                    c2KeepDeep(incident.as_mut_ptr(), h, m);\n                }\n                2 => {\n                    let mut incident = [c2v::default(); 2];\n                    c2Incident(incident.as_mut_ptr(), B, bx, ab_h1.n);\n                    let mut h = c2h::default();\n                    if c2SidePlanes(incident.as_mut_ptr(), A_in_B.a, A_in_B.b, &mut h) == 0 {\n                        return;\n                    }\n                    c2KeepDeep(incident.as_mut_ptr(), h, m);\n                }\n                _ => return,\n            }\n            let mut i: c_int = 0;\n            while i < (*m).count {\n                if (i as usize) < 2 {\n                    (*m).depths[i as usize] =\n                        fp::add((*m).depths[i as usize], A.r);\n                }\n                i += 1;\n            }\n        } else if d < A.r {\n            (*m).count = 1;\n            (*m).n = c2Norm(c2Sub(b, a));\n            (*m).contact_points[0] = c2Add(a, c2Mulvs((*m).n, A.r));\n            (*m).depths[0] = A.r - d;\n        }\n    }\n}\n\n/// AABB vs capsule, by promoting the AABB to a 4-gon.\n///\n/// Note the trailing `m->n = c2Neg(m->n);`: when `c2CapsuletoPolyManifold` bails out\n/// early it leaves `m->n` untouched, so this negates whatever the *caller* had in\n/// that field. Reading through `m` reproduces that exactly.\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2AABBtoCapsuleManifold(A: c2AABB, B: c2Capsule, m: *mut c2Manifold) {\n    unsafe {\n        (*m).count = 0;\n        let mut p = c2Poly::default();\n        let mut a_local = A;\n        c2BBVerts(p.verts.as_mut_ptr(), &mut a_local);\n        p.count = 4;\n        c2Norms(p.verts.as_mut_ptr(), p.norms.as_mut_ptr(), 4);\n        c2CapsuletoPolyManifold(B, &p, core::ptr::null(), m);\n        (*m).n = c2Neg((*m).n);\n    }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2CapsuletoCapsuleManifold(\n    A: c2Capsule,\n    B: c2Capsule,\n    m: *mut c2Manifold,\n) {\n    unsafe {\n        (*m).count = 0;\n        let mut a = c2v::default();\n        let mut b = c2v::default();\n        let r = fp::add(A.r, B.r);\n        let d = c2GJK(\n            &A as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            &B as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            &mut a,\n            &mut b,\n            0,\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n        );\n        if d < r {\n            let n = if d == 0.0 {\n                c2Norm(c2Skew(c2Sub(A.b, A.a)))\n            } else {\n                c2Norm(c2Sub(b, a))\n            };\n            (*m).count = 1;\n            (*m).depths[0] = r - d;\n            (*m).contact_points[0] = c2Sub(b, c2Mulvs(n, B.r));\n            (*m).n = n;\n        }\n    }\n}\n","numLines":479,"startLine":1,"totalLines":479}}}
