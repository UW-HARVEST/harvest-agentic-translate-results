{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PyXQvKwhYRivTfqpo6HXgS","type":"tool_result","content":"1\t//! Scalar / vector / rotation primitives.\n2\t//!\n3\t//! Every one of these is a public symbol in the C shared object, so each gets\n4\t//! `#[unsafe(no_mangle)] extern \"C\"`.\n5\t//!\n6\t//! Bit-exactness notes:\n7\t//! * All arithmetic is `f32` and is written in the same association order as the C\n8\t//!   source. GCC does not reassociate floating point without `-ffast-math`, and\n9\t//!   neither target enables FMA (baseline x86-64 is SSE2 only), so results match\n10\t//!   instruction-for-instruction.\n11\t//! * `c2Maxv` / `c2Minv` / `c2Absv` deliberately use raw `>` / `<` / `< 0`\n12\t//!   comparisons rather than `f32::max` / `f32::min` / `f32::abs`. The C ternaries\n13\t//!   propagate NaN from the *second* operand and return `-0.0` unchanged for\n14\t//!   `-0.0`; the Rust library functions do neither.\n15\t\n16\tuse crate::fp;\n17\tuse crate::types::{c2r, c2v, c2x, c2h};\n18\tuse core::ffi::c_float;\n19\t\n20\t#[inline(never)]\n21\t#[unsafe(no_mangle)]\n22\tpub extern \"C\" fn c2V(x: c_float, y: c_float) -> c2v {\n23\t    c2v { x, y }\n24\t}\n25\t\n26\t#[inline(never)]\n27\t#[unsafe(no_mangle)]\n28\tpub extern \"C\" fn c2Mulvs(a: c2v, b: c_float) -> c2v {\n29\t    // C: `a.x *= b; a.y *= b;`\n30\t    // GCC vectorises this as `movsldup` (broadcast b) + `mulps %xmm2,%xmm0`, so the\n31\t    // *scalar* b is the destination operand in both lanes and its NaN wins.\n32\t    c2v {\n33\t        x: fp::mul(b, a.x),\n34\t        y: fp::mul(b, a.y),\n35\t    }\n36\t}\n37\t\n38\t#[inline(never)]\n39\t#[unsafe(no_mangle)]\n40\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n41\t    // C: c2V(((a.x) > (b.x) ? (a.x) : (b.x)), ((a.y) > (b.y) ? (a.y) : (b.y)))\n42\t    c2V(\n43\t        if a.x > b.x { a.x } else { b.x },\n44\t        if a.y > b.y { a.y } else { b.y },\n45\t    )\n46\t}\n47\t\n48\t#[inline(never)]\n49\t#[unsafe(no_mangle)]\n50\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n51\t    // C: c2V(((a.x) < (b.x) ? (a.x) : (b.x)), ((a.y) < (b.y) ? (a.y) : (b.y)))\n52\t    c2V(\n53\t        if a.x < b.x { a.x } else { b.x },\n54\t        if a.y < b.y { a.y } else { b.y },\n55\t    )\n56\t}\n57\t\n58\t#[inline(never)]\n59\t#[unsafe(no_mangle)]\n60\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n61\t    c2Maxv(lo, c2Minv(a, hi))\n62\t}\n63\t\n64\t#[inline(never)]\n65\t#[unsafe(no_mangle)]\n66\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n67\t    a.x -= b.x;\n68\t    a.y -= b.y;\n69\t    a\n70\t}\n71\t\n72\t#[inline(never)]\n73\t#[unsafe(no_mangle)]\n74\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> c_float {\n75\t    // GCC: mulss(dst=a.x, b.x); mulss(dst=a.y, b.y); addss(dst=first product).\n76\t    fp::add(fp::mul(a.x, b.x), fp::mul(a.y, b.y))\n77\t}\n78\t\n79\t#[inline(never)]\n80\t#[unsafe(no_mangle)]\n81\tpub extern \"C\" fn c2Dist(h: c2h, p: c2v) -> c_float {\n82\t    c2Dot(h.n, p) - h.d\n83\t}\n84\t\n85\t#[inline(never)]\n86\t#[unsafe(no_mangle)]\n87\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n88\t    c2r { c: 1.0, s: 0.0 }\n89\t}\n90\t\n91\t#[inline(never)]\n92\t#[unsafe(no_mangle)]\n93\tpub extern \"C\" fn c2xIdentity() -> c2x {\n94\t    c2x {\n95\t        p: c2V(0.0, 0.0),\n96\t        r: c2RotIdentity(),\n97\t    }\n98\t}\n99\t\n100\t#[inline(never)]\n101\t#[unsafe(no_mangle)]\n102\tpub extern \"C\" fn c2Len(a: c2v) -> c_float {\n103\t    // C: sqrtf(c2Dot(a, a))\n104\t    c2Dot(a, a).sqrt()\n105\t}\n106\t\n107\t#[inline(never)]\n108\t#[unsafe(no_mangle)]\n109\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> c_float {\n110\t    // GCC: mulss(dst=a.x, b.y); mulss(dst=a.y, b.x); subss (destination forced).\n111\t    fp::mul(a.x, b.y) - fp::mul(a.y, b.x)\n112\t}\n113\t\n114\t#[inline(never)]\n115\t#[unsafe(no_mangle)]\n116\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n117\t    // C: c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n118\t    // GCC's four mulss all take the rotation component as destination; note that for\n119\t    // the y lane it emits `addss %xmm5,%xmm1` with `a.c * b.y` as the destination,\n120\t    // i.e. the operands are the other way round from the source order.\n121\t    c2V(\n122\t        fp::mul(a.c, b.x) - fp::mul(a.s, b.y),\n123\t        fp::add(fp::mul(a.c, b.y), fp::mul(a.s, b.x)),\n124\t    )\n125\t}\n126\t\n127\t#[inline(never)]\n128\t#[unsafe(no_mangle)]\n129\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n130\t    // C: c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n131\t    // GCC folds the y lane's negate-then-add into `subss %xmm5,%xmm1`, i.e.\n132\t    // `(a.c * b.y) - (a.s * b.x)`. That is exactly equivalent for finite values and\n133\t    // signed zeros, and fixes the destination operand for the NaN case.\n134\t    c2V(\n135\t        fp::add(fp::mul(a.c, b.x), fp::mul(a.s, b.y)),\n136\t        fp::mul(a.c, b.y) - fp::mul(a.s, b.x),\n137\t    )\n138\t}\n139\t\n140\t#[inline(never)]\n141\t#[unsafe(no_mangle)]\n142\tpub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n143\t    // GCC: `addps %xmm1,%xmm0` — `a` is the destination in both lanes.\n144\t    c2v {\n145\t        x: fp::add(a.x, b.x),\n146\t        y: fp::add(a.y, b.y),\n147\t    }\n148\t}\n149\t\n150\t#[inline(never)]\n151\t#[unsafe(no_mangle)]\n152\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n153\t    c2Add(c2Mulrv(a.r, b), a.p)\n154\t}\n155\t\n156\t#[inline(never)]\n157\t#[unsafe(no_mangle)]\n158\tpub extern \"C\" fn c2MulxvT(a: c2x, b: c2v) -> c2v {\n159\t    c2MulrvT(a.r, c2Sub(b, a.p))\n160\t}\n161\t\n162\t#[inline(never)]\n163\t#[unsafe(no_mangle)]\n164\tpub extern \"C\" fn c2Intersect(a: c2v, b: c2v, da: c_float, db: c_float) -> c2v {\n165\t    c2Add(a, c2Mulvs(c2Sub(b, a), da / (da - db)))\n166\t}\n167\t\n168\t#[inline(never)]\n169\t#[unsafe(no_mangle)]\n170\tpub extern \"C\" fn c2Div(a: c2v, b: c_float) -> c2v {\n171\t    // Note: no divide-by-zero guard in C either; 1.0f/0.0f yields inf, which then\n172\t    // propagates. Reproduced verbatim.\n173\t    c2Mulvs(a, 1.0 / b)\n174\t}\n175\t\n176\t#[inline(never)]\n177\t#[unsafe(no_mangle)]\n178\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n179\t    c2Div(a, c2Len(a))\n180\t}\n181\t\n182\t#[inline(never)]\n183\t#[unsafe(no_mangle)]\n184\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n185\t    // IEEE negation: preserves the sign of zero, exactly like C's unary minus.\n186\t    c2V(-a.x, -a.y)\n187\t}\n188\t\n189\t#[inline(never)]\n190\t#[unsafe(no_mangle)]\n191\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n192\t    c2v { x: a.y, y: -a.x }\n193\t}\n194\t\n195\t#[inline(never)]\n196\t#[unsafe(no_mangle)]\n197\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n198\t    c2v { x: -a.y, y: a.x }\n199\t}\n200\t\n201\t#[inline(never)]\n202\t#[unsafe(no_mangle)]\n203\tpub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n204\t    // C: c2V(((a.x) < 0 ? -(a.x) : (a.x)), ((a.y) < 0 ? -(a.y) : (a.y)))\n205\t    // NOT f32::abs: this returns -0.0 for -0.0 and passes NaN through unchanged.\n206\t    c2V(\n207\t        if a.x < 0.0 { -a.x } else { a.x },\n208\t        if a.y < 0.0 { -a.y } else { a.y },\n209\t    )\n210\t}\n211\t"}]},"parent_tool_use_id":null,"session_id":"27d6de7a-57e2-4fbc-9590-8efa6a5bf865","uuid":"58066698-145c-46d8-9808-7aedf936d1e6","timestamp":"2026-08-20T11:51:18.058Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-4VIOLY/translated_rust/src/math.rs","content":"//! Scalar / vector / rotation primitives.\n//!\n//! Every one of these is a public symbol in the C shared object, so each gets\n//! `#[unsafe(no_mangle)] extern \"C\"`.\n//!\n//! Bit-exactness notes:\n//! * All arithmetic is `f32` and is written in the same association order as the C\n//!   source. GCC does not reassociate floating point without `-ffast-math`, and\n//!   neither target enables FMA (baseline x86-64 is SSE2 only), so results match\n//!   instruction-for-instruction.\n//! * `c2Maxv` / `c2Minv` / `c2Absv` deliberately use raw `>` / `<` / `< 0`\n//!   comparisons rather than `f32::max` / `f32::min` / `f32::abs`. The C ternaries\n//!   propagate NaN from the *second* operand and return `-0.0` unchanged for\n//!   `-0.0`; the Rust library functions do neither.\n\nuse crate::fp;\nuse crate::types::{c2r, c2v, c2x, c2h};\nuse core::ffi::c_float;\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: c_float, y: c_float) -> c2v {\n    c2v { x, y }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(a: c2v, b: c_float) -> c2v {\n    // C: `a.x *= b; a.y *= b;`\n    // GCC vectorises this as `movsldup` (broadcast b) + `mulps %xmm2,%xmm0`, so the\n    // *scalar* b is the destination operand in both lanes and its NaN wins.\n    c2v {\n        x: fp::mul(b, a.x),\n        y: fp::mul(b, a.y),\n    }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    // C: c2V(((a.x) > (b.x) ? (a.x) : (b.x)), ((a.y) > (b.y) ? (a.y) : (b.y)))\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    // C: c2V(((a.x) < (b.x) ? (a.x) : (b.x)), ((a.y) < (b.y) ? (a.y) : (b.y)))\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> c_float {\n    // GCC: mulss(dst=a.x, b.x); mulss(dst=a.y, b.y); addss(dst=first product).\n    fp::add(fp::mul(a.x, b.x), fp::mul(a.y, b.y))\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dist(h: c2h, p: c2v) -> c_float {\n    c2Dot(h.n, p) - h.d\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    c2r { c: 1.0, s: 0.0 }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    c2x {\n        p: c2V(0.0, 0.0),\n        r: c2RotIdentity(),\n    }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> c_float {\n    // C: sqrtf(c2Dot(a, a))\n    c2Dot(a, a).sqrt()\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> c_float {\n    // GCC: mulss(dst=a.x, b.y); mulss(dst=a.y, b.x); subss (destination forced).\n    fp::mul(a.x, b.y) - fp::mul(a.y, b.x)\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    // C: c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n    // GCC's four mulss all take the rotation component as destination; note that for\n    // the y lane it emits `addss %xmm5,%xmm1` with `a.c * b.y` as the destination,\n    // i.e. the operands are the other way round from the source order.\n    c2V(\n        fp::mul(a.c, b.x) - fp::mul(a.s, b.y),\n        fp::add(fp::mul(a.c, b.y), fp::mul(a.s, b.x)),\n    )\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    // C: c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n    // GCC folds the y lane's negate-then-add into `subss %xmm5,%xmm1`, i.e.\n    // `(a.c * b.y) - (a.s * b.x)`. That is exactly equivalent for finite values and\n    // signed zeros, and fixes the destination operand for the NaN case.\n    c2V(\n        fp::add(fp::mul(a.c, b.x), fp::mul(a.s, b.y)),\n        fp::mul(a.c, b.y) - fp::mul(a.s, b.x),\n    )\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n    // GCC: `addps %xmm1,%xmm0` — `a` is the destination in both lanes.\n    c2v {\n        x: fp::add(a.x, b.x),\n        y: fp::add(a.y, b.y),\n    }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulxvT(a: c2x, b: c2v) -> c2v {\n    c2MulrvT(a.r, c2Sub(b, a.p))\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Intersect(a: c2v, b: c2v, da: c_float, db: c_float) -> c2v {\n    c2Add(a, c2Mulvs(c2Sub(b, a), da / (da - db)))\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: c_float) -> c2v {\n    // Note: no divide-by-zero guard in C either; 1.0f/0.0f yields inf, which then\n    // propagates. Reproduced verbatim.\n    c2Mulvs(a, 1.0 / b)\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    // IEEE negation: preserves the sign of zero, exactly like C's unary minus.\n    c2V(-a.x, -a.y)\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    c2v { x: a.y, y: -a.x }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    c2v { x: -a.y, y: a.x }\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n    // C: c2V(((a.x) < 0 ? -(a.x) : (a.x)), ((a.y) < 0 ? -(a.y) : (a.y)))\n    // NOT f32::abs: this returns -0.0 for -0.0 and passes NaN through unchanged.\n    c2V(\n        if a.x < 0.0 { -a.x } else { a.x },\n        if a.y < 0.0 { -a.y } else { a.y },\n    )\n}\n","numLines":211,"startLine":1,"totalLines":211}}}
