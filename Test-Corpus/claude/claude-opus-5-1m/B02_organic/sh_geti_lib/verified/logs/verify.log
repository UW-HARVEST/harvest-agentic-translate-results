119\t    }\n120\t}\n121\t\n122\t/// `stbds_arrcap(a)`\n123\t#[inline]\n124\tpub unsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n125\t    if a.is_null() {\n126\t        0\n127\t    } else {\n128\t        (*stbds_header(a)).capacity\n129\t    }\n130\t}\n131\t\n132\t/// `STBDS_HASH_TO_ARR(x,elemsize)` == `((char *) (x) - (elemsize))`\n133\t#[inline]\n134\tpub fn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n135\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n136\t}\n137\t\n138\t/// `STBDS_ARR_TO_HASH(x,elemsize)` == `((char *) (x) + (elemsize))`\n139\t#[inline]\n140\tpub fn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n141\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n142\t}\n143\t\n144\t/// `stbds_hash_table(a)` == `((stbds_hash_index *) stbds_header(a)->hash_table)`\n145\t#[inline]\n146\tpub unsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n147\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n148\t}\n149\t\n150\t/// `(char *) base + elemsize*idx + off`\n151\t#[inline]\n152\tfn elem_byte_ptr(base: *mut c_void, elemsize: usize, idx: isize, off: usize) -> *mut u8 {\n153\t    (base as *mut u8)\n154\t        .wrapping_add(elemsize.wrapping_mul(idx as usize))\n155\t        .wrapping_add(off)\n156\t}\n157\t\n158\t#[inline]\n159\tfn rotate_left(val: usize, n: u32) -> usize {\n160\t    // (((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n))))\n161\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n162\t}\n163\t\n164\t#[inline]\n165\tfn rotate_right(val: usize, n: u32) -> usize {\n166\t    // (((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n))))\n167\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n168\t}\n169\t\n170\t// ---------------------------------------------------------------------------\n171\t// Dynamic array\n172\t// ---------------------------------------------------------------------------\n173\t\n174\t#[unsafe(no_mangle)]\n175\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n176\t    a: *mut c_void,\n177\t    elemsize: usize,\n178\t    addlen: usize,\n179\t    min_cap: usize,\n180\t) -> *mut c_void {\n181\t    let mut min_cap = min_cap;\n182\t    let b: *mut c_void;\n183\t    // size_t min_len = stbds_arrlen(a) + addlen;\n184\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n185\t\n186\t    if min_len > min_cap {\n187\t        min_cap = min_len;\n188\t    }\n189\t\n190\t    if min_cap <= stbds_arrcap(a) {\n191\t        return a;\n192\t    }\n193\t\n194\t    if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n195\t        min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n196\t    } else if min_cap < 4 {\n197\t        min_cap = 4;\n198\t    }\n199\t\n200\t    let old = if !a.is_null() {\n201\t        stbds_header(a) as *mut c_void\n202\t    } else {\n203\t        ptr::null_mut()\n204\t    };\n205\t    let raw = realloc(\n206\t        old,\n207\t        elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n208\t    );\n209\t    b = (raw as *mut u8).wrapping_add(HEADER_SIZE) as *mut c_void;\n210\t    if a.is_null() {\n211\t        (*stbds_header(b)).length = 0;\n212\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n213\t        (*stbds_header(b)).temp = 0;\n214\t    }\n215\t    (*stbds_header(b)).capacity = min_cap;\n216\t\n217\t    b\n218\t}\n219\t\n220\t#[unsafe(no_mangle)]\n221\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n222\t    free(stbds_header(a) as *mut c_void);\n223\t}\n224\t\n225\t// ---------------------------------------------------------------------------\n226\t// Hashing\n227\t// ---------------------------------------------------------------------------\n228\t\n229\tstatic mut stbds_hash_seed: usize = 0x31415926;\n230\t\n231\t#[inline]\n232\tfn hash_seed_ptr() -> *mut usize {\n233\t    &raw mut stbds_hash_seed\n234\t}\n235\t\n236\t#[unsafe(no_mangle)]\n237\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n238\t    *hash_seed_ptr() = seed;\n239\t}\n240\t\n241\t/// `stbds_probe_position`\n242\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n243\t    hash & (slot_count.wrapping_sub(1))\n244\t}\n245\t\n246\t/// `stbds_log2`\n247\tfn stbds_log2(slot_count: usize) -> usize {\n248\t    let mut slot_count = slot_count;\n249\t    let mut n: usize = 0;\n250\t    while slot_count > 1 {\n251\t        slot_count >>= 1;\n252\t        n += 1;\n253\t    }\n254\t    n\n255\t}\n256\t\n257\t#[unsafe(no_mangle)]\n258\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n259\t    let mut hash: usize = seed;\n260\t    let mut str_ = str_;\n261\t    while *str_ != 0 {\n262\t        hash = rotate_left(hash, 9).wrapping_add(*str_ as u8 as usize);\n263\t        str_ = str_.add(1);\n264\t    }\n265\t\n266\t    hash ^= seed;\n267\t    hash = (!hash).wrapping_add(hash << 18);\n268\t    hash ^= hash ^ rotate_right(hash, 31);\n269\t    hash = hash.wrapping_mul(21);\n270\t    hash ^= hash ^ rotate_right(hash, 11);\n271\t    hash = hash.wrapping_add(hash << 6);\n272\t    hash ^= rotate_right(hash, 22);\n273\t    hash.wrapping_add(seed)\n274\t}\n275\t\n276\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n277\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n278\t\n279\tmacro_rules! siphash_round {\n280\t    ($v0:ident, $v1:ident, $v2:ident, $v3:ident) => {{\n281\t        $v0 = $v0.wrapping_add($v1);\n282\t        $v1 = rotate_left($v1, 13);\n283\t        $v1 ^= $v0;\n284\t        $v0 = rotate_left($v0, STBDS_SIZE_T_BITS / 2);\n285\t        $v2 = $v2.wrapping_add($v3);\n286\t        $v3 = rotate_left($v3, 16);\n287\t        $v3 ^= $v2;\n288\t        $v2 = $v2.wrapping_add($v1);\n289\t        $v1 = rotate_left($v1, 17);\n290\t        $v1 ^= $v2;\n291\t        $v2 = rotate_left($v2, STBDS_SIZE_T_BITS / 2);\n292\t        $v0 = $v0.wrapping_add($v3);\n293\t        $v3 = rotate_left($v3, 21);\n294\t        $v3 ^= $v0;\n295\t    }};\n296\t}\n297\t\n298\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n299\t    let mut d = p as *const u8;\n300\t    let mut i: usize;\n301\t    let mut j: usize;\n302\t    let (mut v0, mut v1, mut v2, mut v3): (usize, usize, usize, usize);\n303\t    let mut data: usize;\n304\t\n305\t    v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n306\t    v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n307\t    v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n308\t    v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n309\t\n310\t    v0 ^= 0x0706050403020100u64 as usize ^ seed;\n311\t    v1 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n312\t    v2 ^= 0x0706050403020100u64 as usize ^ seed;\n313\t    v3 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n314\t\n315\t    i = 0;\n316\t    while i.wrapping_add(size_of::<usize>()) <= len {\n317\t        // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n318\t        //\n319\t        // NOTE: in C this whole expression has type `int`; when d[3] >= 0x80 the\n320\t        // result is negative and the conversion to `size_t` sign-extends. That\n321\t        // behaviour is part of the observable hash value, so reproduce it.\n322\t        let lo: c_int = (*d.add(0) as c_int)\n323\t            | ((*d.add(1) as c_int) << 8)\n324\t            | ((*d.add(2) as c_int) << 16)\n325\t            | ((*d.add(3) as c_int) << 24);\n326\t        data = lo as isize as usize;\n327\t        // data |= (size_t) (d[4] | (d[5] << 8) | (d[6] << 16) | (d[7] << 24)) << 16 << 16;\n328\t        let hi: c_int = (*d.add(4) as c_int)\n329\t            | ((*d.add(5) as c_int) << 8)\n330\t            | ((*d.add(6) as c_int) << 16)\n331\t            | ((*d.add(7) as c_int) << 24);\n332\t        data |= ((hi as isize as usize) << 16) << 16;\n333\t\n334\t        v3 ^= data;\n335\t        j = 0;\n336\t        while j < STBDS_SIPHASH_C_ROUNDS {\n337\t            siphash_round!(v0, v1, v2, v3);\n338\t            j += 1;\n339\t        }\n340\t        v0 ^= data;\n341\t\n342\t        i = i.wrapping_add(size_of::<usize>());\n343\t        d = d.add(size_of::<usize>());\n344\t    }\n345\t\n346\t    data = len << (STBDS_SIZE_T_BITS - 8);\n347\t    // switch (len - i) { case 7: ... case 0: break; } -- with fall-through.\n348\t    let rem = len.wrapping_sub(i);\n349\t    if rem >= 7 {\n350\t        data |= ((*d.add(6) as usize) << 24) << 24;\n351\t    }\n352\t    if rem >= 6 {\n353\t        data |= ((*d.add(5) as usize) << 20) << 20;\n354\t    }\n355\t    if rem >= 5 {\n356\t        data |= ((*d.add(4) as usize) << 16) << 16;\n357\t    }\n358\t    if rem >= 4 {\n359\t        // `data |= (d[3] << 24)` is an `int` expression in C, sign-extended.\n360\t        data |= ((*d.add(3) as c_int) << 24) as isize as usize;\n361\t    }\n362\t    if rem >= 3 {\n363\t        data |= ((*d.add(2) as c_int) << 16) as isize as usize;\n364\t    }\n365\t    if rem >= 2 {\n366\t        data |= ((*d.add(1) as c_int) << 8) as isize as usize;\n367\t    }\n368\t    if rem >= 1 {\n369\t        data |= (*d.add(0) as c_int) as isize as usize;\n370\t    }\n371\t\n372\t    v3 ^= data;\n373\t    j = 0;\n374\t    while j < STBDS_SIPHASH_C_ROUNDS {\n375\t        siphash_round!(v0, v1, v2, v3);\n376\t        j += 1;\n377\t    }\n378\t    v0 ^= data;\n379\t    v2 ^= 0xff;\n380\t    j = 0;\n381\t    while j < STBDS_SIPHASH_D_ROUNDS {\n382\t        siphash_round!(v0, v1, v2, v3);\n383\t        j += 1;\n384\t    }\n385\t\n386\t    v0 ^ v1 ^ v2 ^ v3\n387\t}\n388\t\n389\t#[unsafe(no_mangle)]\n390\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n391\t    stbds_siphash_bytes(p, len, seed)\n392\t}\n393\t\n394\t// ---------------------------------------------------------------------------\n395\t// Hash index\n396\t// ---------------------------------------------------------------------------\n397\t\n398\t/// `STBDS_ALIGN_FWD(n,a)`\n399\t#[inline]\n400\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n401\t    n.wrapping_add(a).wrapping_sub(1) & !(a.wrapping_sub(1))\n402\t}\n403\t\n404\t/// `stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)`\n405\t#[inline]\n406\tfn stbds_load_32_or_64(v32: usize, v64_hi: usize, v64_lo: usize) -> usize {\n407\t    let mut temp: usize = v64_lo ^ v32;\n408\t    temp <<= 16;\n409\t    temp <<= 16;\n410\t    temp >>= 16;\n411\t    temp >>= 16;\n412\t    let mut var: usize = v64_hi;\n413\t    var <<= 16;\n414\t    var <<= 16;\n415\t    var ^= temp ^ v32;\n416\t    var\n417\t}\n418\t\n419\tunsafe fn stbds_make_hash_index(\n420\t    slot_count: usize,\n421\t    ot: *mut stbds_hash_index,\n422\t) -> *mut stbds_hash_index {\n423\t    let t: *mut stbds_hash_index = realloc(\n424\t        ptr::null_mut(),\n425\t        (slot_count >> STBDS_BUCKET_SHIFT)\n426\t            .wrapping_mul(size_of::<stbds_hash_bucket>())\n427\t            .wrapping_add(size_of::<stbds_hash_index>())\n428\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n429\t    ) as *mut stbds_hash_index;\n430\t    (*t).storage = stbds_align_fwd(t.add(1) as usize, STBDS_CACHE_LINE_SIZE) as *mut stbds_hash_bucket;\n431\t    (*t).slot_count = slot_count;\n432\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n433\t    (*t).tombstone_count = 0;\n434\t    (*t).used_count = 0;\n435\t\n436\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n437\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n438\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n439\t\n440\t    if slot_count <= STBDS_BUCKET_LENGTH {\n441\t        (*t).used_count_shrink_threshold = 0;\n442\t    }\n443\t    stbds_assert(\n444\t        (*t).used_count_threshold.wrapping_add((*t).tombstone_count_threshold) < (*t).slot_count,\n445\t        \"assertion failed: t->used_count_threshold + t->tombstone_count_threshold < t->slot_count\\n\",\n446\t    );\n447\t\n448\t    if !ot.is_null() {\n449\t        (*t).string = (*ot).string;\n450\t        (*t).seed = (*ot).seed;\n451\t    } else {\n452\t        c_memzero(\n453\t            (&raw mut (*t).string) as *mut c_void,\n454\t            size_of::<stbds_string_arena>(),\n455\t        );\n456\t        (*t).seed = *hash_seed_ptr();\n457\t        let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n458\t        let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n459\t        *hash_seed_ptr() = (*hash_seed_ptr()).wrapping_mul(a).wrapping_add(b);\n460\t    }\n461\t\n462\t    {\n463\t        let mut i: usize = 0;\n464\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n465\t            let b: *mut stbds_hash_bucket = (*t).storage.add(i);\n466\t            let mut j: usize = 0;\n467\t            while j < STBDS_BUCKET_LENGTH {\n468\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n469\t                j += 1;\n470\t            }\n471\t            j = 0;\n472\t            while j < STBDS_BUCKET_LENGTH {\n473\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n474\t                j += 1;\n475\t            }\n476\t            i += 1;\n477\t        }\n478\t    }\n479\t\n480\t    if !ot.is_null() {\n481\t        (*t).used_count = (*ot).used_count;\n482\t        let mut i: usize = 0;\n483\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n484\t            let ob: *mut stbds_hash_bucket = (*ot).storage.add(i);\n485\t            let mut j: usize = 0;\n486\t            while j < STBDS_BUCKET_LENGTH {\n487\t                if (*ob).index[j] >= 0 {\n488\t                    let hash = (*ob).hash[j];\n489\t                    let mut pos =\n490\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n491\t                    let mut step = STBDS_BUCKET_LENGTH;\n492\t                    'done: loop {\n493\t                        let bucket: *mut stbds_hash_bucket = (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n494\t\n495\t                        let mut z = pos & STBDS_BUC