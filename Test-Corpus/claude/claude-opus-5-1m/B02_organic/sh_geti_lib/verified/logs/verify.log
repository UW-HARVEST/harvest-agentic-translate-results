{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019QDcTTMfXG8sb7Fz38xDVr","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (an amalgamation of `stb_ds.h`\n2\t//! plus a small test driver).\n3\t//!\n4\t//! The translation is deliberately literal: every quirk of the original C code\n5\t//! (including integer-promotion driven sign extension in the SipHash inner\n6\t//! loop, uninitialised fields, and the `printf` of a whole struct in\n7\t//! `sh_geti`) is reproduced bit for bit so that the resulting `cdylib` is a\n8\t//! drop-in replacement for the C shared object.\n9\t#![allow(non_camel_case_types)]\n10\t#![allow(non_snake_case)]\n11\t#![allow(non_upper_case_globals)]\n12\t\n13\tpub mod harness;\n14\tpub mod stb_ds;\n15\t\n16\tuse core::ffi::{c_char, c_int, c_void};\n17\t\n18\t// ---------------------------------------------------------------------------\n19\t// libc bindings\n20\t//\n21\t// `STBDS_REALLOC(c,p,s)` is `realloc(p,s)` and `STBDS_FREE(c,p)` is `free(p)`\n22\t// in the C source, so the real libc allocator must be used (blocks may be\n23\t// handed back and forth across the FFI boundary).\n24\t// ---------------------------------------------------------------------------\n25\textern \"C\" {\n26\t    pub fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n27\t    pub fn free(p: *mut c_void);\n28\t    pub fn printf(fmt: *const c_char, ...) -> c_int;\n29\t    pub fn abort() -> !;\n30\t    pub fn write(fd: c_int, buf: *const c_void, count: usize) -> isize;\n31\t}\n32\t\n33\t/// `STBDS_ASSERT` == `assert` in the C source (the CMake build does not define\n34\t/// `NDEBUG`, so the assertions are live).\n35\t#[inline]\n36\tpub(crate) fn stbds_assert(cond: bool, msg: &str) {\n37\t    if !cond {\n38\t        unsafe {\n39\t            write(2, msg.as_ptr() as *const c_void, msg.len());\n40\t            abort();\n41\t        }\n42\t    }\n43\t}\n44\t\n45\t// ---------------------------------------------------------------------------\n46\t// Small C runtime helpers, re-implemented so the crate has no non-libc deps.\n47\t// ---------------------------------------------------------------------------\n48\t\n49\t/// `strlen`\n50\t#[inline]\n51\tpub(crate) unsafe fn c_strlen(s: *const c_char) -> usize {\n52\t    let mut n: usize = 0;\n53\t    while *s.add(n) != 0 {\n54\t        n += 1;\n55\t    }\n56\t    n\n57\t}\n58\t\n59\t/// `0 == strcmp(a, b)`\n60\t#[inline]\n61\tpub(crate) unsafe fn c_str_eq(a: *const c_char, b: *const c_char) -> bool {\n62\t    let mut i: usize = 0;\n63\t    loop {\n64\t        let ca = *(a.add(i)) as u8;\n65\t        let cb = *(b.add(i)) as u8;\n66\t        if ca != cb {\n67\t            return false;\n68\t        }\n69\t        if ca == 0 {\n70\t            return true;\n71\t        }\n72\t        i += 1;\n73\t    }\n74\t}\n75\t\n76\t/// `0 == memcmp(a, b, n)`\n77\t#[inline]\n78\tpub(crate) unsafe fn c_mem_eq(a: *const c_void, b: *const c_void, n: usize) -> bool {\n79\t    let pa = a as *const u8;\n80\t    let pb = b as *const u8;\n81\t    let mut i: usize = 0;\n82\t    while i < n {\n83\t        if *pa.add(i) != *pb.add(i) {\n84\t            return false;\n85\t        }\n86\t        i += 1;\n87\t    }\n88\t    true\n89\t}\n90\t\n91\t/// `memmove`\n92\t#[inline]\n93\tpub(crate) unsafe fn c_memmove(dst: *mut c_void, src: *const c_void, n: usize) {\n94\t    core::ptr::copy(src as *const u8, dst as *mut u8, n);\n95\t}\n96\t\n97\t/// `memcpy`\n98\t#[inline]\n99\tpub(crate) unsafe fn c_memcpy(dst: *mut c_void, src: *const c_void, n: usize) {\n100\t    core::ptr::copy_nonoverlapping(src as *const u8, dst as *mut u8, n);\n101\t}\n102\t\n103\t/// `memset(dst, 0, n)`\n104\t#[inline]\n105\tpub(crate) unsafe fn c_memzero(dst: *mut c_void, n: usize) {\n106\t    core::ptr::write_bytes(dst as *mut u8, 0, n);\n107\t}\n108\t"}]},"parent_tool_use_id":null,"session_id":"0e5425a4-8ecc-4378-9224-5d24c05e87b1","uuid":"45dd4ea2-0d52-4a12-b5f1-3ba26f9bb690","time