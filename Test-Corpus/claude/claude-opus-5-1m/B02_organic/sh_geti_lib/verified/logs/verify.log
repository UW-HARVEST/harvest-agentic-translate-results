{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HyGAnphjcLULBhDsfzAAaR","type":"tool_result","content":"1\t//! Translation of the test-driver part of `c_src/src/lib.c` (`strkey` and\n2\t//! `sh_geti`), including the fully expanded `stbds_*` macros.\n3\t\n4\tuse core::ffi::{c_char, c_int, c_void};\n5\tuse core::mem::size_of;\n6\tuse core::ptr;\n7\t\n8\tuse crate::stb_ds::*;\n9\tuse crate::{printf, stbds_assert};\n10\t\n11\t// ---------------------------------------------------------------------------\n12\t// static char buffer[256];\n13\t// char *strkey(int n) { sprintf(buffer, \"test_%d\", n); return buffer; }\n14\t// ---------------------------------------------------------------------------\n15\t\n16\tstatic mut buffer: [c_char; 256] = [0; 256];\n17\t\n18\t#[inline]\n19\tfn buffer_ptr() -> *mut c_char {\n20\t    (&raw mut buffer) as *mut c_char\n21\t}\n22\t\n23\t#[unsafe(no_mangle)]\n24\tpub unsafe extern \"C\" fn strkey(n: c_int) -> *mut c_char {\n25\t    let buf = buffer_ptr() as *mut u8;\n26\t    let mut pos: usize = 0;\n27\t\n28\t    // \"test_\"\n29\t    for &c in b\"test_\" {\n30\t        *buf.add(pos) = c;\n31\t        pos += 1;\n32\t    }\n33\t\n34\t    // \"%d\" applied to an int\n35\t    let mut digits = [0u8; 24];\n36\t    let mut nd: usize = 0;\n37\t    let neg = n < 0;\n38\t    let mut v: u64 = if neg {\n39\t        (n as i64).unsigned_abs()\n40\t    } else {\n41\t        n as i64 as u64\n42\t    };\n43\t    if v == 0 {\n44\t        digits[nd] = b'0';\n45\t        nd += 1;\n46\t    }\n47\t    while v > 0 {\n48\t        digits[nd] = b'0' + (v % 10) as u8;\n49\t        nd += 1;\n50\t        v /= 10;\n51\t    }\n52\t    if neg {\n53\t        *buf.add(pos) = b'-';\n54\t        pos += 1;\n55\t    }\n56\t    while nd > 0 {\n57\t        nd -= 1;\n58\t        *buf.add(pos) = digits[nd];\n59\t        pos += 1;\n60\t    }\n61\t    *buf.add(pos) = 0;\n62\t\n63\t    buffer_ptr()\n64\t}\n65\t\n66\t// ---------------------------------------------------------------------------\n67\t// void sh_geti(int num)\n68\t//\n69\t//   struct { char *key; int value; } *strmap = NULL, s;\n70\t//\n71\t// The anonymous struct is 16 bytes wide (8 byte pointer + 4 byte int + 4 byte\n72\t// tail padding), so every macro expansion below uses `elemsize == 16` and\n73\t// `keysize == sizeof(t->key) == 8`.\n74\t// ---------------------------------------------------------------------------\n75\t\n76\t#[repr(C)]\n77\t#[derive(Clone, Copy)]\n78\tstruct ShEntry {\n79\t    key: *mut c_char,\n80\t    value: c_int,\n81\t}\n82\t\n83\tconst ELEMSIZE: usize = size_of::<ShEntry>();\n84\tconst KEYSIZE: usize = size_of::<*mut c_char>();\n85\t\n86\t/// `(t)-1` for a `ShEntry *`\n87\t#[inline]\n88\tfn minus_one(t: *mut ShEntry) -> *mut c_void {\n89\t    (t as *mut u8).wrapping_sub(ELEMSIZE) as *mut c_void\n90\t}\n91\t\n92\t/// `stbds_shgeti(t,k)`\n93\t#[inline]\n94\tunsafe fn shgeti(t: &mut *mut ShEntry, k: *const c_char) -> isize {\n95\t    *t = stbds_hmget_key(\n96\t        *t as *mut c_void,\n97\t        ELEMSIZE,\n98\t        k as *mut c_void,\n99\t        KEYSIZE,\n100\t        STBDS_HM_STRING,\n101\t    ) as *mut ShEntry;\n102\t    stbds_temp(minus_one(*t))\n103\t}\n104\t\n105\t/// `stbds_shput(t,k,v)`\n106\t#[inline]\n107\tunsafe fn shput(t: &mut *mut ShEntry, k: *const c_char, v: c_int) {\n108\t    *t = stbds_hmput_key(\n109\t        *t as *mut c_void,\n110\t        ELEMSIZE,\n111\t        k as *mut c_void,\n112\t        KEYSIZE,\n113\t        STBDS_HM_STRING,\n114\t    ) as *mut ShEntry;\n115\t    let idx = stbds_temp(minus_one(*t));\n116\t    (*(*t).offset(idx)).value = v;\n117\t}\n118\t\n119\t/// `stbds_shget(t,k)`\n120\t#[inline]\n121\tunsafe fn shget(t: &mut *mut ShEntry, k: *const c_char) -> c_int {\n122\t    let _ = shgeti(t, k);\n123\t    let idx = stbds_temp(minus_one(*t));\n124\t    (*(*t).offset(idx)).value\n125\t}\n126\t\n127\t/// `stbds_shdel(t,k)`\n128\t#[inline]\n129\tunsafe fn shdel(t: &mut *mut ShEntry, k: 