float sa = wild(), sb = wild();\n    CMP(\"r/c2V\",     C.c2V(sa,sb),      R.c2V(sa,sb));\n    CMP(\"r/c2Dot\",   C.c2Dot(a,b),      R.c2Dot(a,b));\n    CMP(\"r/c2Len\",   C.c2Len(a),        R.c2Len(a));\n    CMP(\"r/c2Add\",   C.c2Add(a,b),      R.c2Add(a,b));\n    CMP(\"r/c2Sub\",   C.c2Sub(a,b),      R.c2Sub(a,b));\n    CMP(\"r/c2Mulvs\", C.c2Mulvs(a,sa),   R.c2Mulvs(a,sa));\n    CMP(\"r/c2Div\",   C.c2Div(a,sa),     R.c2Div(a,sa));\n    CMP(\"r/c2Norm\",  C.c2Norm(a),       R.c2Norm(a));\n    CMP(\"r/c2Minv\",  C.c2Minv(a,b),     R.c2Minv(a,b));\n    CMP(\"r/c2Maxv\",  C.c2Maxv(a,b),     R.c2Maxv(a,b));\n    CMP(\"r/c2Skew\",  C.c2Skew(a),       R.c2Skew(a));\n    CMP(\"r/c2Absv\",  C.c2Absv(a),       R.c2Absv(a));\n    CMP(\"r/c2CCW90\", C.c2CCW90(a),      R.c2CCW90(a));\n    c2m M = { a, b };\n    CMP(\"r/c2MulmvT\", C.c2MulmvT(M,a), R.c2MulmvT(M,a));\n    CMP(\"r/c2MulmvT2\",C.c2MulmvT(M,b), R.c2MulmvT(M,b));\n    c2AABB A = { a, b }, B = { b, a };\n    CMP(\"r/c2AABBtoAABB\",  C.c2AABBtoAABB(A,B),  R.c2AABBtoAABB(A,B));\n    CMP(\"r/c2AABBtoPoint\", C.c2AABBtoPoint(A,b), R.c2AABBtoPoint(A,b));\n    c2Circle Ci = { a, sa };\n    CMP(\"r/c2CircleToPoint\", C.c2CircleToPoint(Ci,b), R.c2CircleToPoint(Ci,b));\n  }\n\n  /* ---- randomized raycasts, comparing return value AND the out-struct ---- */\"\"\"\nassert old2 in s\ns = s.replace(old2, new2, 1)\n\n# 3) also drive gen_ray through NaN/degenerate-prone inputs drawn from the table\nold3 = '  printf(\"checks=%ld fails=%ld\\\\n\", checks, fails);'\nnew3 = '''  /* ---- gen_ray with table values (degenerate: mp == ray.p, a == b, ...) ---- */\n  for (long it = 0; it < 400000; it++) {\n    float f[19];\n    for (int i = 0; i < 19; i++) f[i] = (rnd()%3) ? pick() : wild();\n    if (rnd()%4 == 0) { f[2] = f[0]; f[3] = f[1]; }   /* mp == ray.p  */\n    if (rnd()%4 == 0) { f[9] = f[7]; f[10] = f[8]; }  /* capsule a == b */\n    c2Raycast a1,a2,a3,b1,b2,b3;\n    memset(&a1,0x3C,sizeof a1); memset(&a2,0x3C,sizeof a2); memset