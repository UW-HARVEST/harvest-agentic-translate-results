t stream = dynamic_stream(&spec, &items);\n        let expect = Item::expand(&items);\n        let label = format!(\"C16 nlit=288 ndst=32 trial{trial}\");\n        assert_decodes(&label, &stream, &expect);\n        cases.push(\n            Case::new(&label, &stream, expect.len() as i32)\n                .in_off(trial % 4)\n                .out_pad(64),\n        );\n    }\n    assert_batch_matches(&cases);\n}\n\n'''\ns = s[:start] + new + s[end:]\n\n# --- C20/C34: a non-final stored block always errors, so put it last ---------\nold = '''        let mut w = BitWriter::new();\n        stored_block(&mut w, &stored, false);\n        fixed_block(&mut w, &fixed_items, false);\n        dynamic_block(&mut w, &spec, &dyn_items, true);\n        w.align();\n\n        let mut expect = stored.clone();\n        expect.extend(Item::expand(&fixed_items));\n        expect.extend(Item::expand(&dyn_items));'''\nnew = '''        // The stored block goes last: `cp_stored`'s inverted length check (E2)\n        // rejects any stored block that still has input after it.\n        let mut w = BitWriter::new();\n        fixed_block(&mut w, &fixed_items, false);\n        dynamic_block(&mut w, &spec, &dyn_items, false);\n        stored_block(&mut w, &stored, true);\n\n        let mut expect = Item::expand(&fixed_items);\n        expect.extend(Item::expand(&dyn_items));\n        expect.extend_from_slice(&stored);'''\nassert old in s\ns = s.replace(old, new)\nold = '''        let label = format!(\"C20/C34 mixed trial{trial}\");\n        assert_decodes(&label, &w.bytes, &expect);\n        cases.extend(all_alignments(&label, &w.bytes, expect.len() as i32));'''\nnew = '''        let label = format!(\"C20/C34 mixed trial{trial}\");\n        variants.push((w.bytes.clone(), expect.clone(), 0));\n        cases.extend(all_alignments(&label, &w.bytes, expect.len() as i32));'''\nassert old in s\ns = s.replace(old, new)\nold = '''    let mut rng = Rng::new(0xC20);\n    let mut cases = Vec::new();\n    for trial in 0..12 {\n        let nstored'''\nnew = '''    let mut rng = Rng::new(0xC20);\n    let mut cases = Vec::new();\n    let mut variants = Vec::new();\n    for trial in 0..12 {\n        let nstored'''\nassert old in s\ns = s.replace(old, new)\nold = '''        cases.extend(all_alignments(&label, &w.bytes, expect.len() as i32));\n    }\n    assert_batch_matches(&cases);\n}\n\n#[test]\nfn c21_c22_c23_final_word_shapes() {'''\nnew = '''        cases.extend(all_alignments(&label, &w.bytes, expect.len() as i32));\n    }\n    assert_some_decode(\"C20/C34 mixed block types\", &variants);\n    assert_batch_matches(&cases);\n}\n\n#[test]\nfn c21_c22_c23_final_word_shapes() {'''\nassert old in s\ns = s.replace(old, new)\n\n# --- C37: only claim correct decoding for btype 1/2 --------------------------\nold = '''        let label = format!(\n            \"C37 trial{trial} shape={shape} btype={btype} out={} bytes\",\n            expect.len()\n        );\n        assert_decodes(&label, &w.bytes, &expect);'''\nnew = '''        let label = format!(\n            \"C37 trial{trial} shape={shape} btype={btype} out={} bytes\",\n            expect.len()\n        );\n        if btype != 0 {\n            // stored blocks: see `assert_some_decode` -- the C's own stored path\n            // is size-dependent, so only agreement is asserted for them.\n            assert_decodes(&label, &w.bytes, &expect);\n            decoded += 1;\n        }'''\nassert old in s\ns = s.replace(old, new)\nold = '''    let mut rng = Rng::new(0x37);\n    let mut cases = Vec::new();\n    for trial in 0..320usize {'''\nnew = '''    let mut rng = Rng::new(0x37);\n    let mut cases = Vec::new();\n    let mut decoded = 0usize;\n    for trial in 0..320usize {'''\nassert old in s\ns = s.replace(old, new)\nold = '''                .out_pad(rng.range(0, 256)),\n        );\n    }\n    assert_batch_matches(&cases);\n}'''\nnew = '''                .out_pad(rng.range(0, 256)),\n        );\n    }\n    assert!(\n        de