{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AKe4DJZphBDuQm5Vms3xpZ","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (cute_c2-style 2D ray casting).\n2\t//!\n3\t//! Every public symbol exported by the C shared library is reproduced here with\n4\t//! the identical linker name, C ABI signature and bit-exact behaviour.\n5\t//!\n6\t//! Notes on fidelity:\n7\t//!  * All arithmetic is performed in `f32` (single precision), exactly like the C\n8\t//!    code which is compiled for SSE-based x86-64 (no x87 excess precision and\n9\t//!    no FMA contraction on the base target).\n10\t//!  * The C source expands min/max/abs as ternary expressions, whose NaN and\n11\t//!    signed-zero behaviour differs from `f32::min`/`f32::max`/`f32::abs`.\n12\t//!    The ternaries are reproduced literally so that e.g. `c2Absv(-0.0)` still\n13\t//!    returns `-0.0` and NaN operands propagate identically.\n14\t//!  * `c2Div` multiplies by the reciprocal (`1.0f / b`) rather than dividing,\n15\t//!    matching the C source.\n16\t//!  * No bugs are fixed: the write of `out->n` / `out->t` before the early-out\n17\t//!    checks in `c2RaytoCapsule`, the recomputation of the dot product in\n18\t//!    `c2RaytoAABB`, and the dead `return 0;` in `c2CastRay` are all preserved.\n19\t\n20\t#![allow(non_snake_case)]\n21\t#![allow(non_camel_case_types)]\n22\t\n23\tuse std::ffi::{c_int, c_void};\n24\t\n25\t/* -------------------------------------------------------------------------- */\n26\t/* Public types (from include/lib.h)                                          */\n27\t/* -------------------------------------------------------------------------- */\n28\t\n29\t#[repr(C)]\n30\t#[derive(Copy, Clone)]\n31\tpub struct c2v {\n32\t    pub x: f32,\n33\t    pub y: f32,\n34\t}\n35\t\n36\t#[repr(C)]\n37\t#[derive(Copy, Clone)]\n38\tpub struct c2Raycast {\n39\t    pub t: f32,\n40\t    pub n: c2v,\n41\t}\n42\t\n43\t/* -------------------------------------------------------------------------- */\n44\t/* Private types (from src/lib.c)                                             */\n45\t/* -------------------------------------------------------------------------- */\n46\t\n47\t// typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;\n48\tconst C2_TYPE_CIRCLE: c_int = 0;\n49\tconst C2_TYPE_AABB: c_int = 1;\n50\tconst C2_TYPE_CAPSULE: c_int = 2;\n51\t\n52\t#[repr(C)]\n53\t#[derive(Copy, Clone)]\n54\tpub struct c2Circle {\n55\t    pub p: c2v,\n56\t    pub r: f32,\n57\t}\n58\t\n59\t#[repr(C)]\n60\t#[derive(Copy, Clone)]\n61\tpub struct c2AABB {\n62\t    pub min: c2v,\n63\t    pub max: c2v,\n64\t}\n65\t\n66\t#[repr(C)]\n67\t#[derive(Copy, Clone)]\n68\tpub struct c2Capsule {\n69\t    pub a: c2v,\n70\t    pub b: c2v,\n71\t    pub r: f32,\n72\t}\n73\t\n74\t#[repr(C)]\n75\t#[derive(Copy, Clone)]\n76\tpub struct c2Ray {\n77\t    pub p: c2v,\n78\t    pub d: c2v,\n79\t    pub t: f32,\n80\t}\n81\t\n82\t#[repr(C)]\n83\t#[derive(Copy, Clone)]\n84\tpub struct c2m {\n85\t    pub x: c2v,\n86\t    pub y: c2v,\n87\t}\n88\t\n89\t/* -------------------------------------------------------------------------- */\n90\t/* Helpers reproducing the C ternary expansions verbatim                      */\n91\t/* -------------------------------------------------------------------------- */\n92\t\n93\t/// `(a) < 0 ? -(a) : (a)`\n94\t#[inline(always)]\n95\tfn tern_abs(a: f32) -> f32 {\n96\t    if a < 0.0 { -a } else { a }\n97\t}\n98\t\n99\t/// `(a) < (b) ? (a) : (b)`\n100\t#[inline(always)]\n101\tfn tern_min(a: f32, b: f32) -> f32 {\n102\t    if a < b { a } else { b }\n103\t}\n104\t\n105\t/// `(a) > (b) ? (a) : (b)`\n106\t#[inline(always)]\n107\tfn tern_max(a: f32, b: f32) -> f32 {\n108\t    if a > b { a } else { b }\n109\t}\n110\t\n111\t/* -------------------------------------------------------------------------- */\n112\t/* Vector math                                                                */\n113\t/* -------------------------------------------------------------------------- */\n114\t\n115\t#[unsafe(no_mangle)]\n116\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n117\t    c2v { x, y }\n118\t}\n119\t\n120\t#[unsafe(no_mangle)]\n121\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n122\t    a.x * b.x + a.y * b.y\n123\t}\n124\t\n125\t#[unsafe(no_mangle)]\n126\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n127\t    c2Dot(a, a).sqrt()\n128\t}\n129\t\n130\t#[unsafe(no_mangle)]\n131\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n132\t    a.x += b.x;\n133\t    a.y += b.y;\n134\t    a\n135\t}\n136\t\n137\t#[unsafe(no_mangle)]\n138\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n139\t    a.x -= b.x;\n140\t    a.y -= b.y;\n141\t    a\n142\t}\n143\t\n144\t#[unsafe(no_mangle)]\n145\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n146\t    a.x *= b;\n147\t    a.y *= b;\n148\t    a\n149\t}\n150\t\n151\t#[unsafe(no_mangle)]\n152\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n153\t    c2Mulvs(a, 1.0f32 / b)\n154\t}\n155\t\n156\t#[unsafe(no_mangle)]\n157\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n158\t    c2Div(a, c2Len(a))\n159\t}\n160\t\n161\t#[unsafe(no_mangle)]\n162\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n163\t    c2V(tern_min(a.x, b.x), tern_min(a.y, b.y))\n164\t}\n165\t\n166\t#[unsafe(no_mangle)]\n167\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n168\t    c2V(tern_max(a.x, b.x), tern_max(a.y, b.y))\n169\t}\n170\t\n171\t#[unsafe(no_mangle)]\n172\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n173\t    c2v { x: -a.y, y: a.x }\n174\t}\n175\t\n176\t#[unsafe(no_mangle)]\n177\tpub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n178\t    c2V(tern_abs(a.x), tern_abs(a.y))\n179\t}\n180\t\n181\t#[unsafe(no_mangle)]\n182\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n183\t    c2v { x: a.y, y: -a.x }\n184\t}\n185\t\n186\t#[unsafe(no_mangle)]\n187\tpub extern \"C\" fn c2MulmvT(a: c2m, b: c2v) -> c2v {\n188\t    c2v {\n189\t        x: a.x.x * b.x + a.x.y * b.y,\n190\t        y: a.y.x * b.x + a.y.y * b.y,\n191\t    }\n192\t}\n193\t\n194\t/* -------------------------------------------------------------------------- */\n195\t/* Overlap tests                                                              */\n196\t/* -------------------------------------------------------------------------- */\n197\t\n198\t#[unsafe(no_mangle)]\n199\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n200\t    let d0: c_int = (B.max.x < A.min.x) as c_int;\n201\t    let d1: c_int = (A.max.x < B.min.x) as c_int;\n202\t    let d2: c_int = (B.max.y < A.min.y) as c_int;\n203\t    let d3: c_int = (A.max.y < B.min.y) as c_int;\n204\t    // C: return !(d0 | d1 | d2 | d3);\n205\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n206\t}\n207\t\n208\t#[unsafe(no_mangle)]\n209\tpub extern \"C\" fn c2AABBtoPoint(A: c2AABB, B: c2v) -> c_int {\n210\t    let d0: c_int = (B.x < A.min.x) as c_int;\n211\t    let d1: c_int = (B.y < A.min.y) as c_int;\n212\t    let d2: c_int = (B.x > A.max.x) as c_int;\n213\t    let d3: c_int = (B.y > A.max.y) as c_int;\n214\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n215\t}\n216\t\n217\t#[unsafe(no_mangle)]\n218\tpub extern \"C\" fn c2CircleToPoint(A: c2Circle, B: c2v) -> c_int {\n219\t    let n = c2Sub(A.p, B);\n220\t    let d2 = c2Dot(n, n);\n221\t    (d2 < A.r * A.r) as c_int\n222\t}\n223\t\n224\t/* -------------------------------------------------------------------------- */\n225\t/* Ray casts                                                                  */\n226\t/* -------------------------------------------------------------------------- */\n227\t\n228\t#[unsafe(no_mangle)]\n229\tpub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n230\t    let p = B.p;\n231\t    let m = c2Sub(A.p, p);\n232\t    let c = c2Dot(m, m) - B.r * B.r;\n233\t    let b = c2Dot(m, A.d);\n234\t    let disc = b * b - c;\n235\t    if disc < 0.0 {\n236\t        return 0;\n237\t    }\n238\t    let t = -b - disc.sqrt();\n239\t    if t >= 0.0 && t <= A.t {\n240\t        unsafe { (*out).t = t };\n241\t        let impact = c2Add(A.p, c2Mulvs(A.d, t));\n242\t        unsafe { (*out).n = c2Norm(c2Sub(impact, p)) };\n243\t        return 1;\n244\t    }\n245\t    0\n246\t}\n247\t\n248\t/// `static inline float c2SignedDistPointToPlane_OneDimensional(float p, float n, float d)`\n249\t#[inline(always)]\n250\tfn c2SignedDistPointToPlane_OneDimensional(p: f32, n: f32, d: f32) -> f32 {\n251\t    p * n - d * n\n252\t}\n253\t\n254\t/// `static inline float c2RayToPlane_OneDimensional(float da, float db)`\n255\t#[inline(always)]\n256\tfn c2RayToPlane_OneDimensional(da: f32, db: f32) -> f32 {\n257\t    if da < 0.0 {\n258\t        0.0\n259\t    } else if da * db > 0.0 {\n260\t        1.0f32\n261\t    } else {\n262\t        let d = da - db;\n263\t        if d != 0.0 { da / d } else { 0.0 }\n264\t    }\n265\t}\n266\t\n267\t#[unsafe(no_mangle)]\n268\tpub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n269\t    let p0 = A.p;\n270\t    let p1 = c2Add(A.p, c2Mulvs(A.d, A.t));\n271\t    let a_box = c2AABB {\n272\t        min: c2Minv(p0, p1),\n273\t        max: c2Maxv(p0, p1),\n274\t    };\n275\t    if c2AABBtoAABB(a_box, B) == 0 {\n276\t        return 0;\n277\t    }\n278\t    let ab = c2Sub(p1, p0);\n279\t    let n = c2Skew(ab);\n280\t    let abs_n = c2Absv(n);\n281\t    let half_extents = c2Mulvs(c2Sub(B.max, B.min), 0.5f32);\n282\t    let center_of_b_box = c2Mulvs(c2Add(B.min, B.max), 0.5f32);\n283\t    let d = tern_abs(c2Dot(n, c2Sub(p0, center_of_b_box))) - c2Dot(abs_n, half_extents);\n284\t    if d > 0.0 {\n285\t        return 0;\n286\t    }\n287\t    let da0 = c2SignedDistPointToPlane_OneDimensional(p0.x, -1.0f32, B.min.x);\n288\t    let db0 = c2SignedDistPointToPlane_OneDimensional(p1.x, -1.0f32, B.min.x);\n289\t    let da1 = c2SignedDistPointToPlane_OneDimensional(p0.x, 1.0f32, B.max.x);\n290\t    let db1 = c2SignedDistPointToPlane_OneDimensional(p1.x, 1.0f32, B.max.x);\n291\t    let da2 = c2SignedDistPointToPlane_OneDimensional(p0.y, -1.0f32, B.min.y);\n292\t    let db2 = c2SignedDistPointToPlane_OneDimensional(p1.y, -1.0f32, B.min.y);\n293\t    let da3 = c2SignedDistPointToPlane_OneDimensional(p0.y, 1.0f32, B.max.y);\n294\t    let db3 = c2SignedDistPointToPlane_OneDimensional(p1.y, 1.0f32, B.max.y);\n295\t    let mut t0 = c2RayToPlane_OneDimensional(da0, db0);\n296\t    let mut t1 = c2RayToPlane_OneDimensional(da1, db1);\n297\t    let mut t2 = c2RayToPlane_OneDimensional(da2, db2);\n298\t    let mut t3 = c2RayToPlane_OneDimensional(da3, db3);\n299\t    let hit0: c_int = (t0 <= 1.0f32) as c_int;\n300\t    let hit1: c_int = (t1 <= 1.0f32) as c_int;\n301\t    let hit2: c_int = (t2 <= 1.0f32) as c_int;\n302\t    let hit3: c_int = (t3 <= 1.0f32) as c_int;\n303\t    let hit: c_int = hit0 | hit1 | hit2 | hit3;\n304\t    if hit != 0 {\n305\t        t0 = (hit0 as f32) * t0;\n306\t        t1 = (hit1 as f32) * t1;\n307\t        t2 = (hit2 as f32) * t2;\n308\t        t3 = (hit3 as f32) * t3;\n309\t        if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n310\t            unsafe {\n311\t                (*out).t = t0 * A.t;\n312\t                (*out).n = c2V(-1.0, 0.0);\n313\t            }\n314\t        } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n315\t            unsafe {\n316\t                (*out).t = t1 * A.t;\n317\t                (*out).n = c2V(1.0, 0.0);\n318\t            }\n319\t        } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n320\t            unsafe {\n321\t                (*out).t = t2 * A.t;\n322\t                (*out).n = c2V(0.0, -1.0);\n323\t            }\n324\t        } else {\n325\t            unsafe {\n326\t                (*out).t = t3 * A.t;\n327\t                (*out).n = c2V(0.0, 1.0);\n328\t            }\n329\t        }\n330\t        1\n331\t    } else {\n332\t        0\n333\t    }\n334\t}\n335\t\n336\t#[unsafe(no_mangle)]\n337\tpub unsafe extern \"C\" fn c2RaytoCapsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n338\t    let mut M = c2m {\n339\t        x: c2v { x: 0.0, y: 0.0 },\n340\t        y: c2v { x: 0.0, y: 0.0 },\n341\t    };\n342\t    M.y = c2Norm(c2Sub(B.b, B.a));\n343\t    M.x = c2CCW90(M.y);\n344\t    let cap_n = c2Sub(B.b, B.a);\n345\t    let yBb = c2MulmvT(M, cap_n);\n346\t    let yAp = c2MulmvT(M, c2Sub(A.p, B.a));\n347\t    let yAd = c2MulmvT(M, A.d);\n348\t    let yAe = c2Add(yAp, c2Mulvs(yAd, A.t));\n349\t    let capsule_bb = c2AABB {\n350\t        min: c2V(-B.r, 0.0),\n351\t        max: c2V(B.r, yBb.y),\n352\t    };\n353\t    unsafe {\n354\t        (*out).n = c2Norm(cap_n);\n355\t        (*out).t = 0.0;\n356\t    }\n357\t    if c2AABBtoPoint(capsule_bb, yAp) != 0 {\n358\t        return 1;\n359\t    } else {\n360\t        let capsule_a = c2Circle { p: B.a, r: B.r };\n361\t        let capsule_b = c2Circle { p: B.b, r: B.r };\n362\t        if c2CircleToPoint(capsule_a, A.p) != 0 {\n363\t            return 1;\n364\t        } else if c2CircleToPoint(capsule_b, A.p) != 0 {\n365\t            return 1;\n366\t        }\n367\t    }\n368\t    if yAe.x * yAp.x < 0.0 || tern_min(tern_abs(yAe.x), tern_abs(yAp.x)) < B.r {\n369\t        let Ca = c2Circle { p: B.a, r: B.r };\n370\t        let Cb = c2Circle { p: B.b, r: B.r };\n371\t        if tern_abs(yAp.x) < B.r {\n372\t            if yAp.y < 0.0 {\n373\t                return unsafe { c2RaytoCircle(A, Ca, out) };\n374\t            } else {\n375\t                return unsafe { c2RaytoCircle(A, Cb, out) };\n376\t            }\n377\t        } else {\n378\t            let c = if yAp.x > 0.0 { B.r } else { -B.r };\n379\t            let d = yAe.x - yAp.x;\n380\t            let t = (c - yAp.x) / d;\n381\t            let y = yAp.y + (yAe.y - yAp.y) * t;\n382\t            if y <= 0.0 {\n383\t                return unsafe { c2RaytoCircle(A, Ca, out) };\n384\t            }\n385\t            if y >= yBb.y {\n386\t                return unsafe { c2RaytoCircle(A, Cb, out) };\n387\t            } else {\n388\t                unsafe {\n389\t                    (*out).n = if c > 0.0 { M.x } else { c2Skew(M.y) };\n390\t                    (*out).t = t * A.t;\n391\t                }\n392\t                return 1;\n393\t            }\n394\t        }\n395\t    }\n396\t    0\n397\t}\n398\t\n399\t#[unsafe(no_mangle)]\n400\tpub unsafe extern \"C\" fn c2CastRay(\n401\t    A: c2Ray,\n402\t    B: *const c_void,\n403\t    typeB: c_int,\n404\t    out: *mut c2Raycast,\n405\t) -> c_int {\n406\t    match typeB {\n407\t        C2_TYPE_CIRCLE => unsafe { c2RaytoCircle(A, *(B as *const c2Circle), out) },\n408\t        C2_TYPE_AABB => unsafe { c2RaytoAABB(A, *(B as *const c2AABB), out) },\n409\t        C2_TYPE_CAPSULE => unsafe { c2RaytoCapsule(A, *(B as *const c2Capsule), out) },\n410\t        // The C function falls off the end of the switch for any other value\n411\t        // (undefined behaviour); the source's dead `return 0;` is used here.\n412\t        _ => 0,\n413\t    }\n414\t}\n415\t\n416\t/* -------------------------------------------------------------------------- */\n417\t/* Public entry point (include/lib.h)                                         */\n418\t/* -------------------------------------------------------------------------- */\n419\t\n420\t#[unsafe(no_mangle)]\n421\tpub unsafe extern \"C\" fn spec_ray(\n422\t    cast: *mut c2Raycast,\n423\t    mp_x: f32,\n424\t    mp_y: f32,\n425\t    c_p_x: f32,\n426\t    c_p_y: f32,\n427\t    c_r: f32,\n428\t    r_p_x: f32,\n429\t    r_p_y: f32,\n430\t) -> c_int {\n431\t    let mp = c2V(mp_x, mp_y);\n432\t\n433\t    let c = c2Circle {\n434\t        p: c2V(c_p_x, c_p_y),\n435\t        r: c_r,\n436\t    };\n437\t\n438\t    let mut ray = c2Ray {\n439\t        p: c2V(r_p_x, r_p_y),\n440\t        d: c2v { x: 0.0, y: 0.0 },\n441\t        t: 0.0,\n442\t    };\n443\t    ray.d = c2Norm(c2Sub(mp, ray.p));\n444\t    ray.t = c2Dot(mp, ray.d) - c2Dot(ray.p, ray.d);\n445\t\n446\t    let hit = unsafe {\n447\t        c2CastRay(\n448\t            ray,\n449\t            &c as *const c2Circle as *const c_void,\n450\t            C2_TYPE_CIRCLE,\n451\t            cast,\n452\t        )\n453\t    };\n454\t    hit\n455\t}\n456\t"}]},"parent_tool_use_id":null,"session_id":"403ec6da-be3e-47b1-a761-1c67d01f930a","uuid":"67c1fdc3-3bbb-4bb2-b2e1-01e5e2705ef0","timestamp":"2026-08-20T15:26:39.494Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-MNe1tR/translated_rust/src/lib.rs","content":"//! Rust translation of the C library in `c_src/` (cute_c2-style 2D ray casting).\n//!\n//! Every public symbol exported by the C shared library is reproduced here with\n//! the identical linker name, C ABI signature and bit-exact behaviour.\n//!\n//! Notes on fidelity:\n//!  * All arithmetic is performed in `f32` (single precision), exactly like the C\n//!    code which is compiled for SSE-based x86-64 (no x87 excess precision and\n//!    no FMA contraction on the base target).\n//!  * The C source expands min/max/abs as ternary expressions, whose NaN and\n//!    signed-zero behaviour differs from `f32::min`/`f32::max`/`f32::abs`.\n//!    The ternaries are reproduced literally so that e.g. `c2Absv(-0.0)` still\n//!    returns `-0.0` and NaN operands propagate identically.\n//!  * `c2Div` multiplies by the reciprocal (`1.0f / b`) rather than dividing,\n//!    matching the C source.\n//!  * No bugs are fixed: the write of `out->n` / `out->t` before the early-out\n//!    checks in `c2RaytoCapsule`, the recomputation of the dot product in\n//!    `c2RaytoAABB`, and the dead `return 0;` in `c2CastRay` are all preserved.\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n\nuse std::ffi::{c_int, c_void};\n\n/* -------------------------------------------------------------------------- */\n/* Public types (from include/lib.h)                                          */\n/* -------------------------------------------------------------------------- */\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Raycast {\n    pub t: f32,\n    pub n: c2v,\n}\n\n/* -------------------------------------------------------------------------- */\n/* Private types (from src/lib.c)                                             */\n/* -------------------------------------------------------------------------- */\n\n// typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;\nconst C2_TYPE_CIRCLE: c_int = 0;\nconst C2_TYPE_AABB: c_int = 1;\nconst C2_TYPE_CAPSULE: c_int = 2;\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Ray {\n    pub p: c2v,\n    pub d: c2v,\n    pub t: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2m {\n    pub x: c2v,\n    pub y: c2v,\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers reproducing the C ternary expansions verbatim                      */\n/* -------------------------------------------------------------------------- */\n\n/// `(a) < 0 ? -(a) : (a)`\n#[inline(always)]\nfn tern_abs(a: f32) -> f32 {\n    if a < 0.0 { -a } else { a }\n}\n\n/// `(a) < (b) ? (a) : (b)`\n#[inline(always)]\nfn tern_min(a: f32, b: f32) -> f32 {\n    if a < b { a } else { b }\n}\n\n/// `(a) > (b) ? (a) : (b)`\n#[inline(always)]\nfn tern_max(a: f32, b: f32) -> f32 {\n    if a > b { a } else { b }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Vector math                                                                */\n/* -------------------------------------------------------------------------- */\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    c2v { x, y }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    c2Dot(a, a).sqrt()\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(tern_min(a.x, b.x), tern_min(a.y, b.y))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(tern_max(a.x, b.x), tern_max(a.y, b.y))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    c2v { x: -a.y, y: a.x }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n    c2V(tern_abs(a.x), tern_abs(a.y))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    c2v { x: a.y, y: -a.x }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulmvT(a: c2m, b: c2v) -> c2v {\n    c2v {\n        x: a.x.x * b.x + a.x.y * b.y,\n        y: a.y.x * b.x + a.y.y * b.y,\n    }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Overlap tests                                                              */\n/* -------------------------------------------------------------------------- */\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n    let d0: c_int = (B.max.x < A.min.x) as c_int;\n    let d1: c_int = (A.max.x < B.min.x) as c_int;\n    let d2: c_int = (B.max.y < A.min.y) as c_int;\n    let d3: c_int = (A.max.y < B.min.y) as c_int;\n    // C: return !(d0 | d1 | d2 | d3);\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoPoint(A: c2AABB, B: c2v) -> c_int {\n    let d0: c_int = (B.x < A.min.x) as c_int;\n    let d1: c_int = (B.y < A.min.y) as c_int;\n    let d2: c_int = (B.x > A.max.x) as c_int;\n    let d3: c_int = (B.y > A.max.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircleToPoint(A: c2Circle, B: c2v) -> c_int {\n    let n = c2Sub(A.p, B);\n    let d2 = c2Dot(n, n);\n    (d2 < A.r * A.r) as c_int\n}\n\n/* -------------------------------------------------------------------------- */\n/* Ray casts                                                                  */\n/* -------------------------------------------------------------------------- */\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n    let p = B.p;\n    let m = c2Sub(A.p, p);\n    let c = c2Dot(m, m) - B.r * B.r;\n    let b = c2Dot(m, A.d);\n    let disc = b * b - c;\n    if disc < 0.0 {\n        return 0;\n    }\n    let t = -b - disc.sqrt();\n    if t >= 0.0 && t <= A.t {\n        unsafe { (*out).t = t };\n        let impact = c2Add(A.p, c2Mulvs(A.d, t));\n        unsafe { (*out).n = c2Norm(c2Sub(impact, p)) };\n        return 1;\n    }\n    0\n}\n\n/// `static inline float c2SignedDistPointToPlane_OneDimensional(float p, float n, float d)`\n#[inline(always)]\nfn c2SignedDistPointToPlane_OneDimensional(p: f32, n: f32, d: f32) -> f32 {\n    p * n - d * n\n}\n\n/// `static inline float c2RayToPlane_OneDimensional(float da, float db)`\n#[inline(always)]\nfn c2RayToPlane_OneDimensional(da: f32, db: f32) -> f32 {\n    if da < 0.0 {\n        0.0\n    } else if da * db > 0.0 {\n        1.0f32\n    } else {\n        let d = da - db;\n        if d != 0.0 { da / d } else { 0.0 }\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n    let p0 = A.p;\n    let p1 = c2Add(A.p, c2Mulvs(A.d, A.t));\n    let a_box = c2AABB {\n        min: c2Minv(p0, p1),\n        max: c2Maxv(p0, p1),\n    };\n    if c2AABBtoAABB(a_box, B) == 0 {\n        return 0;\n    }\n    let ab = c2Sub(p1, p0);\n    let n = c2Skew(ab);\n    let abs_n = c2Absv(n);\n    let half_extents = c2Mulvs(c2Sub(B.max, B.min), 0.5f32);\n    let center_of_b_box = c2Mulvs(c2Add(B.min, B.max), 0.5f32);\n    let d = tern_abs(c2Dot(n, c2Sub(p0, center_of_b_box))) - c2Dot(abs_n, half_extents);\n    if d > 0.0 {\n        return 0;\n    }\n    let da0 = c2SignedDistPointToPlane_OneDimensional(p0.x, -1.0f32, B.min.x);\n    let db0 = c2SignedDistPointToPlane_OneDimensional(p1.x, -1.0f32, B.min.x);\n    let da1 = c2SignedDistPointToPlane_OneDimensional(p0.x, 1.0f32, B.max.x);\n    let db1 = c2SignedDistPointToPlane_OneDimensional(p1.x, 1.0f32, B.max.x);\n    let da2 = c2SignedDistPointToPlane_OneDimensional(p0.y, -1.0f32, B.min.y);\n    let db2 = c2SignedDistPointToPlane_OneDimensional(p1.y, -1.0f32, B.min.y);\n    let da3 = c2SignedDistPointToPlane_OneDimensional(p0.y, 1.0f32, B.max.y);\n    let db3 = c2SignedDistPointToPlane_OneDimensional(p1.y, 1.0f32, B.max.y);\n    let mut t0 = c2RayToPlane_OneDimensional(da0, db0);\n    let mut t1 = c2RayToPlane_OneDimensional(da1, db1);\n    let mut t2 = c2RayToPlane_OneDimensional(da2, db2);\n    let mut t3 = c2RayToPlane_OneDimensional(da3, db3);\n    let hit0: c_int = (t0 <= 1.0f32) as c_int;\n    let hit1: c_int = (t1 <= 1.0f32) as c_int;\n    let hit2: c_int = (t2 <= 1.0f32) as c_int;\n    let hit3: c_int = (t3 <= 1.0f32) as c_int;\n    let hit: c_int = hit0 | hit1 | hit2 | hit3;\n    if hit != 0 {\n        t0 = (hit0 as f32) * t0;\n        t1 = (hit1 as f32) * t1;\n        t2 = (hit2 as f32) * t2;\n        t3 = (hit3 as f32