a.x = fadd(b.x, a.x);\n    a.y = fadd(b.y, a.y);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    // C: `a.x -= b.x; a.y -= b.y;`  (subss %xmm1,%xmm0 with xmm0 = a.x)\n    a.x = fsub(a.x, b.x);\n    a.y = fsub(a.y, b.y);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    // C: `a.x *= b; a.y *= b;`  (mulss -0xc(%rbp),%xmm0 with xmm0 = a.x, so the\n    // vector component is the destination — LLVM commutes this, hence `fmul`.)\n    a.x = fmul(a.x, b);\n    a.y = fmul(a.y, b);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    // C: `return c2Mulvs(a, 1.0f / b);`  (divss -0xc(%rbp),%xmm0, xmm0 = 1.0f)\n    c2Mulvs(a, fdiv(1.0f32, b))\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4049,"cache_read_input_tokens":154618,"cache_creation":{"ephemeral_5m_input_tokens":4049,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"403ec6da-be3e-47b1-a761-1c67d01f930a","uuid":"1f3598ca-3115-42f7-b45b-c55f0c704ff3","timestamp":"2026-08-20T15:42:52.307Z"}
