4\t    c2V(\n135\t        if a.x > b.x { a.x } else { b.x },\n136\t        if a.y > b.y { a.y } else { b.y },\n137\t    )\n138\t}\n139\t\n140\t#[unsafe(no_mangle)]\n141\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n142\t    c2V(\n143\t        if a.x < b.x { a.x } else { b.x },\n144\t        if a.y < b.y { a.y } else { b.y },\n145\t    )\n146\t}\n147\t\n148\t#[unsafe(no_mangle)]\n149\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n150\t    c2Maxv(lo, c2Minv(a, hi))\n151\t}\n152\t\n153\t#[unsafe(no_mangle)]\n154\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n155\t    let mut a = a;\n156\t    a.x -= b.x;\n157\t    a.y -= b.y;\n158\t    a\n159\t}\n160\t\n161\t#[unsafe(no_mangle)]\n162\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n163\t    a.x * b.x + a.y * b.y\n164\t}\n165\t\n166\t#[unsafe(no_mangle)]\n167\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n168\t    let mut r = c2r { c: 0.0, s: 0.0 };\n169\t    r.c = 1.0f32;\n170\t    r.s = 0.0;\n171\t    r\n172\t}\n173\t\n174\t#[unsafe(no_mangle)]\n175\tpub extern \"C\" fn c2xIdentity() -> c2x {\n176\t    let mut x = c2x::default();\n177\t    x.p = c2V(0.0, 0.0);\n178\t    x.r = c2RotIdentity();\n179\t    x\n180\t}\n181\t\n182\t// ---------------------------------------------------------------------------\n183\t// Shape helpers\n184\t// ---------------------------------------------------------------------------\n185\t\n186\t#[unsafe(no_mangle)]\n187\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n188\t    let bb = &*bb;\n189\t    *out.add(0) = bb.min;\n190\t    *out.add(1) = c2V(bb.max.x, bb.min.y);\n191\t    *out.add(2) = bb.max;\n192\t    *out.add(3) = c2V(bb.min.x, bb.max.y);\n193\t}\n194\t\n195\t#[unsafe(no_mangle)]\n196\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c2void, type_: c_int, p: *mut c2Proxy) {\n197\t    match type_ {\n198\t        C2_TYPE_CIRCLE => {\n199\t            let c = shape as *mut c2Circle;\n200\t            (*p).radius = (*c).r;\n201\t            (*p).count = 1;\n202\t            (*p).verts[0] = (*c).p;\n203\t        }\n204\t        C2_TYPE_AABB => {\n205\t            let bb = shape as *mut c2AABB;\n206\t            (*p).radius = 0.0;\n207\t            (*p).count = 4;\n208\t            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n209\t        }\n210\t        C2_TYPE_CAPSULE => {\n211\t            let c = shape as *mut c2Capsule;\n212\t            (*p).radius = (*c).r;\n213\t            (*p).count = 2;\n214\t            (*p).verts[0] = (*c).a;\n215\t            (*p).verts[1] = (*c).b;\n216\t        }\n217\t        _ => {}\n218\t    }\n219\t}\n220\t\n221\t/// Alias used purely to keep the `const void*` parameter spelling readable.\n222\tpub type c2void = c_void;\n223\t\n224\t// ---------------------------------------------------------------------------\n225\t// Simplex helpers\n226\t// ---------------------------------------------------------------------------\n227\t\n228\t#[unsafe(no_mangle)]\n229\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n230\t    sqrtf(c2Dot(a, a))\n231\t}\n232\t\n233\t#[inline]\n234\tfn sqrtf(v: f32) -> f32 {\n235\t    // IEEE-754 correctly-rounded single-precision square root, exactly as\n236\t    // C's sqrtf().\n237\t    v.sqrt()\n238\t}\n239\t\n240\t#[unsafe(no_mangle)]\n241\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n242\t    a.x * b.y - a.y * b.x\n243\t}\n244\t\n245\t#[unsafe(no_mangle)]\n246\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n247\t    let s = &mut *s;\n248\t    match s.count {\n249\t        2 => c2Len(c2Sub(s.verts[1].p, s.verts[0].p)),\n250\t        3 => c2Det2(\n251\t            c2Sub(s.verts[1].p, s.verts[0].p),\n252\t            c2Sub(s.verts[2].p, s.verts[0].p),\n253\t        ),\n254\t        // `default:` falls through into `case 1:` in the C source.\n255\t        _ => 0.0,\n256\t    }\n257\t}\n258\t\n259\t#[unsafe(no_mangle)]\n260\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n261\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n262\t}\n263\t\n264\t#[unsafe(no_mangle)]\n265\tpub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n266\t    let mut a = a;\n267\t    a.x += b.x;\n268\t    a.y += b.y;\n269\t    a\n270\t}\n271\t\n272\t#[unsafe(no_mangle)]\n273\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n274\t    c2Add(c2Mulrv(a.r, b), a.p)\n275\t}\n276\t\n277\t#[unsafe(no_mangle)]\n278\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n279\t    let s = &mut *s;\n280\t    let a = s.verts[0].p;\n281\t    let b = s.verts[1].p;\n282\t    let u = c2Dot(b, c2Sub(b, a));\n283\t    let v = c2Dot(a, c2Sub(a, b));\n284\t    if v <= 0.0 {\n285\t        s.verts[0].u = 1.0f32;\n286\t        s.div = 1.0f32;\n287\t        s.count = 1;\n288\t    } else if u <= 0.0 {\n289\t        s.verts[0] = s.verts[1];\n290\t        s.verts[0].u = 1.0f32;\n291\t        s.div = 1.0f32;\n292\t        s.count = 1;\n293\t    } else {\n294\t        s.verts[0].u = u;\n295\t        s.verts[1].u = v;\n296\t        s.div = u + v;\n297\t        s.count = 2;\n298\t    }\n299\t}\n300\t\n301\t#[unsafe(no_mangle)]\n302\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n303\t    let s = &mut *s;\n304\t    let a = s.verts[0].p;\n305\t    let b = s.verts[1].p;\n306\t    let c = s.verts[2].p;\n307\t    let uAB = c2Dot(b, c2Sub(b, a));\n308\t    let vAB = c2Dot(a, c2Sub(a, b));\n309\t    let uBC = c2Dot(c, c2Sub(c, b));\n310\t    let vBC = c2Dot(b, c2Sub(b, c));\n311\t    let uCA = c2Dot(a, c2Sub(a, c));\n312\t    let vCA = c2Dot(c, c2Sub(c, a));\n313\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n314\t    let uABC = c2Det2(b, c) * area;\n315\t    let vABC = c2Det2(c, a) * area;\n316\t    let wABC = c2Det2(a, b) * area;\n317\t    if vAB <= 0.0 && uCA <= 0.0 {\n318\t        s.verts[0].u = 1.0f32;\n319\t        s.div = 1.0f32;\n320\t        s.count = 1;\n321\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n322\t        s.verts[0] = s.verts[1];\n323\t        s.verts[0].u = 1.0f32;\n324\t        s.div = 1.0f32;\n325\t        s.count = 1;\n326\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n327\t        s.verts[0] = s.verts[2];\n328\t        s.verts[0].u = 1.0f32;\n329\t        s.div = 1.0f32;\n330\t        s.count = 1;\n331\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n332\t        s.verts[0].u = uAB;\n333\t        s.verts[1].u = vAB;\n334\t        s.div = uAB + vAB;\n335\t        s.count = 2;\n336\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n337\t        s.verts[0] = s.verts[1];\n338\t        s.verts[1] = s.verts[2];\n339\t        s.verts[0].u = uBC;\n340\t        s.verts[1].u = vBC;\n341\t        s.div = uBC + vBC;\n342\t        s.count = 2;\n343\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n344\t        s.verts[1] = s.verts[0];\n345\t        s.verts[0] = s.verts[2];\n346\t        s.verts[0].u = uCA;\n347\t        s.verts[1].u = vCA;\n348\t        s.div = uCA + vCA;\n349\t        s.count = 2;\n350\t    } else {\n351\t        s.verts[0].u = uABC;\n352\t        s.verts[1].u = vABC;\n353\t        s.verts[2].u = wABC;\n354\t        s.div = uABC + vABC + wABC;\n355\t        s.count = 3;\n356\t    }\n357\t}\n358\t\n359\t#[unsafe(no_mangle)]\n360\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n361\t    c2V(-a.x, -a.y)\n362\t}\n363\t\n364\t#[unsafe(no_mangle)]\n365\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n366\t    let mut b = c2v { x: 0.0, y: 0.0 };\n367\t    b.x = -a.y;\n368\t    b.y = a.x;\n369\t    b\n370\t}\n371\t\n372\t#[unsafe(no_mangle)]\n373\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n374\t    let mut b = c2v { x: 0.0, y: 0.0 };\n375\t    b.x = a.y;\n376\t    b.y = -a.x;\n377\t    b\n378\t}\n379\t\n380\t#[unsafe(no_mangle)]\n381\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n382\t    let s = &mut *s;\n383\t    match s.count {\n384\t        1 => c2Neg(s.verts[0].p),\n385\t        2 => {\n386\t            let ab = c2Sub(s.verts[1].p, s.verts[0].p);\n387\t            if c2Det2(ab, c2Neg(s.verts[0].p)) > 0.0 {\n388\t                return c2Skew(ab);\n389\t            }\n390\t            c2CCW90(ab)\n391\t        }\n392\t        // `case 3:` and `default:`\n393\t        _ => c2V(0.0, 0.0),\n394\t    }\n395\t}\n396\t\n397\t#[unsafe(no_mangle)]\n398\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n399\t    let mut imax: c_int = 0;\n400\t    let mut dmax = c2Dot(*verts.add(0), d);\n401\t    let mut i: c_int = 1;\n402\t    while i < count {\n403\t        let dot = c2Dot(*verts.offset(i as isize), d);\n404\t        if dot > dmax {\n405\t            imax = i;\n406\t            dmax = dot;\n407\t        }\n408\t        i += 1;\n409\t    }\n410\t    imax\n411\t}\n412\t\n413\t#[unsafe(no_mangle)]\n414\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n415\t    let s = &mut *s;\n416\t    let den = 1.0f32 / s.div;\n417\t    match s.count {\n418\t        1 => {\n419\t            *a = s.verts[0].sA;\n420\t            *b = s.verts[0].sB;\n421\t        }\n422\t        2 => {\n423\t            *a = c2Add(\n424\t                c2Mulvs(s.verts[0].sA, den * s.verts[0].u),\n425\t                c2Mulvs(s.verts[1].sA, den * s.verts[1].u),\n426\t            );\n427\t            *b = c2Add(\n428\t                c2Mulvs(s.verts[0].sB, den * s.verts[0].u),\n429\t                c2Mulvs(s.verts[1].sB, den * s.verts[1].u),\n430\t            );\n431\t        }\n432\t        3 => {\n433\t            *a = c2Add(\n434\t                c2Add(\n435\t                    c2Mulvs(s.verts[0].sA, den * s.verts[0].u),\n436\t                    c2Mulvs(s.verts[1].sA, den * s.verts[1].u),\n437\t                ),\n438\t                c2Mulvs(s.verts[2].sA, den * s.verts[2].u),\n439\t            );\n440\t            *b = c2Add(\n441\t                c2Add(\n442\t                    c2Mulvs(s.verts[0].sB, den * s.verts[0].u),\n443\t                    c2Mulvs(s.verts[1].sB, den * s.verts[1].u),\n444\t                ),\n445\t                c2Mulvs(s.verts[2].sB, den * s.verts[2].u),\n446\t            );\n447\t        }\n448\t        _ => {\n449\t            *a = c2V(0.0, 0.0);\n450\t            *b = c2V(0.0, 0.0);\n451\t        }\n452\t    }\n453\t}\n454\t\n455\t#[unsafe(no_mangle)]\n456\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n457\t    c2Mulvs(a, 1.0f32 / b)\n458\t}\n459\t\n460\t#[unsafe(no_mangle)]\n461\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n462\t    c2Div(a, c2Len(a))\n463\t}\n464\t\n465\t#[unsafe(no_mangle)]\n466\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n467\t    let s = &mut *s;\n468\t    let den = 1.0f32 / s.div;\n469\t    match s.count {\n470\t        1 => s.verts[0].p,\n471\t        2 => c2Add(\n472\t            c2Mulvs(s.verts[0].p, den * s.verts[0].u),\n473\t            c2Mulvs(s.verts[1].p, den * s.verts[1].u),\n474\t        ),\n475\t        _ => c2V(0.0, 0.0),\n476\t    }\n477\t}\n478\t\n479\t#[unsafe(no_mangle)]\n480\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n481\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n482\t}\n483\t\n484\t// ---------------------------------------------------------------------------\n485\t// GJK\n486\t// ---------------------------------------------------------------------------\n487\t\n488\tconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_6e38_f32; // FLT_MAX\n489\tconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7_f32; // FLT_EPSILON\n490\t\n491\t#[unsafe(no_mangle)]\n492\tpub unsafe extern \"C\" fn c2GJK(\n493\t    A: *const c2void,\n494\t    typeA: c_int,\n495\t    ax_ptr: *const c2x,\n496\t    B: *const c2void,\n497\t    typeB: c_int,\n498\t    bx_ptr: *const c2x,\n499\t    outA: *mut c2v,\n500\t    outB: *mut c2v,\n501\t    use_radius: c_int,\n502\t    iterations: *mut c_int,\n503\t    cache: *mut c2GJKCache,\n504\t) -> f32 {\n505\t    let ax: c2x;\n506\t    let bx: c2x;\n507\t    if ax_ptr.is_null() {\n508\t        ax = c2xIdentity();\n509\t    } else {\n510\t        ax = *ax_ptr;\n511\t    }\n512\t    if bx_ptr.is_null() {\n513\t        bx = c2xIdentity();\n514\t    } else {\n515\t        bx = *bx_ptr;\n516\t    }\n517\t    let mut pA = c2Proxy::default();\n518\t    let mut pB = c2Proxy::default();\n519\t    c2MakeProxy(A, typeA, &mut pA);\n520\t    c2MakeProxy(B, typeB, &mut pB);\n521\t    let mut s = c2Simplex::default();\n522\t    let verts: *mut c2sv = s.verts.as_mut_ptr();\n523\t    let mut cache_was_read: c_int = 0;\n524\t    if !cache.is_null() {\n525\t        let cache_was_good: c_int = ((*cache).count != 0) as c_int;\n526\t        if cache_was_good != 0 {\n527\t            let mut i: c_int = 0;\n528\t            while i < (*cache).count {\n529\t                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n530\t                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n531\t                let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n532\t                let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n533\t                let v = verts.offset(i as isize);\n534\t                (*v).iA = iA;\n535\t                (*v).sA = sA;\n536\t                (*v).iB = iB;\n537\t                (*v).sB = sB;\n538\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n539\t                (*v).u = 0.0;\n540\t                i += 1;\n541\t            }\n542\t            s.count = (*cache).count;\n543\t            s.div = (*cache).div;\n544\t            let metric_old = (*cache).metric;\n545\t            let metric = c2GJKSimplexMetric(&mut s);\n546\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n547\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n548\t            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n549\t                cache_was_read = 1;\n550\t            }\n551\t        }\n552\t    }\n553\t    if cache_was_read == 0 {\n554\t        s.verts[0].iA = 0;\n555\t        s.verts[0].iB = 0;\n556\t        s.verts[0].sA = c2Mulxv(ax, pA.verts[0]);\n557\t        s.verts[0].sB = c2Mulxv(bx, pB.verts[0]);\n558\t        s.verts[0].p = c2Sub(s.verts[0].sB, s.verts[0].sA);\n559\t        s.verts[0].u = 1.0f32;\n560\t        s.div = 1.0f32;\n561\t        s.count = 1;\n562\t    }\n563\t    let mut saveA: [c_int; 3] = [0; 3];\n564\t    let mut saveB: [c_int; 3] = [0; 3];\n565\t    let mut save_count: c_int = 0;\n566\t    let mut d0: f32 = C2_FLT_MAX;\n567\t    let mut d1: f32;\n568\t    let mut iter: c_int = 0;\n569\t    let mut hit: c_int = 0;\n570\t    while iter < 20 {\n571\t        save_count = s.count;\n572\t        let mut i: c_int = 0;\n573\t        while i < save_count {\n574\t            *saveA.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iA;\n575\t            *saveB.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iB;\n576\t            i += 1;\n577\t        }\n578\t        match s.count {\n579\t            1 => {}\n580\t            2 => c22(&mut s),\n581\t            3 => c23(&mut s),\n582\t            _ => {}\n583\t        }\n584\t        if s.count == 3 {\n585\t            hit = 1;\n586\t            break;\n587\t        }\n588\t        let p = c2L(&mut s);\n589\t        d1 = c2Dot(p, p);\n590\t        if d1 > d0 {\n591\t            break;\n592\t        }\n593\t        d0 = d1;\n594\t        let d = c2D(&mut s);\n595\t        if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n596\t            break;\n597\t        }\n598\t        let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n599\t        let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n600\t        let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n601\t        let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n602\t        let v = verts.offset(s.count as isize);\n603\t        (*v).iA = iA;\n604\t        (*v).sA = sA;\n605\t        (*v).iB = iB;\n606\t        (*v).sB = sB;\n607\t        (*v).p = c2Sub((*v).sB, (*v).sA);\n608\t        let mut dup: c_int = 0;\n609\t        let mut i: c_int = 0;\n610\t        while i < save_count {\n611\t            if iA == *saveA.as_ptr().offset(i as isize) && iB == *saveB.as_ptr().offset(i as isize) {\n612\t                dup = 1;\n613\t                break;\n614\t            }\n615\t            i += 1;\n616\t        }\n617\t        if dup != 0 {\n618\t            break;\n619\t        }\n620\t        s.count += 1;\n621\t        iter += 1;\n622\t    }\n623\t    let _ = save_count;\n624\t    let mut a = c2v { x: 0.0, y: 0.0 };\n625\t    let mut b = c2v { x: 0.0, y: 0.0 };\n626\t    c2Witness(&mut s, &mut a, &mut b);\n627\t    let mut dist = c2Len(c2Sub(a, b));\n628\t    if hit != 0 {\n629\t        a = b;\n630\t        dist = 0.0;\n631\t    } else if use_radius != 0 {\n632\t        let rA = pA.radius;\n633\t        let rB = pB.radius;\n634\t        if dist > rA + rB && dist > C2_FLT_EPSILON {\n635\t            dist -= rA + rB;\n636\t            let n = c2Norm(c2Sub(b, a));\n637\t            a = c2Add(a, c2Mulvs(n, rA));\n638\t            b = c2Sub(b, c2Mulvs(n, rB));\n639\t            if a.x == b.x && a.y == b.y {\n640\t                dist = 0.0;\n641\t            }\n642\t        } else {\n643\t            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n644\t            a = p;\n645\t            b = p;\n646\t            dist = 0.0;\n647\t        }\n648\t    }\n649\t    if !cache.is_null() {\n650\t        (*cache).metric = c2GJKSimplexMetric(&mut s);\n651\t        (*cache).count = s.count;\n652\t        let mut i: c_int = 0;\n653\t        while i < s.count {\n654\t            let v = verts.offset(i as isize);\n655\t            *(*cache).iA.as_mut_ptr().offset(i as isize) = (*v).iA;\n656\t            *(*cache).iB.as_mut_ptr().offset(i as isize) = (*v).iB;\n657\t            i += 1;\n658\t        }\n659\t        (*cache).div = s.div;\n660\t    }\n661\t    if !outA.is_null() {\n662\t        *outA = a;\n663\t    }\n664\t    if !outB.is_null() {\n665\t        *outB = b;\n666\t    }\n667\t    if !iterations.is_null() {\n668\t        *iterations = iter;\n669\t    }\n670\t    dist\n671\t}\n672\t\n673\t// ---------------------------------------------------------------------------\n674\t// Boolean collision routines\n675\t// ---------------------------------------------------------------------------\n676\t\n677\t#[unsafe(no_mangle)]\n678\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n679\t    let d0: c_int = (B.max.x < A.min.x) as c_int;\n680\t    let d1: c_int = (A.max.x < B.min.x) as c_int;\n681\t    let d2: c_int = (B.max.y < A.min.y) as c_int;\n682\t    let d3: c_int = (A.max.y < B.min.y) as c_int;\n683\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n684\t}\n685\t\n686\t#[unsafe(no_mangle)]\n687\tpub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n688\t    let mut A = A;\n689\t    let mut B = B;\n690\t    unsafe {\n691\t        if c2GJK(\n692\t            &mut A as *mut c2AABB as *const c2void,\n693\t            C2_TYPE_AABB,\n694\t            core::ptr::null(),\n695\t            &mut B as *mut c2Capsule as *const c2void,\n696\t            C2_TYPE_CAPSULE,\n697\t            core::ptr::null(),\n698\t            core::ptr::null_mut(),\n699\t            core::ptr::null_mut(),\n700\t            1,\n701\t            core::ptr::null_mut(),\n702\t            core::ptr::null_mut(),\n703\t        ) != 0.0\n704\t        {\n705\t            return 0;\n706\t        }\n707\t    }\n708\t    1\n709\t}\n710\t\n711\t#[unsafe(no_mangle)]\n712\tpub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n713\t    let mut A = A;\n714\t    let mut B = B;\n715\t    unsafe {\n716\t        if c2GJK(\n717\t            &mut A as *mut c2Capsule as *const c2void,\n718\t            C2_TYPE_CAPSULE,\n719\t            core::ptr::null(),\n720\t            &mut B as *mut c2Capsule as *const c2void,\n721\t            C2_TYPE_CAPSULE,\n722\t            core::ptr::null(),\n723\t            core::ptr::null_mut(),\n724\t            core::ptr::null_mut(),\n725\t            1,\n726\t            core::ptr::null_mut(),\n727\t            core::ptr::null_mut(),\n728\t        ) != 0.0\n729\t        {\n730\t            return 0;\n731\t        }\n732\t    }\n733\t    1\n734\t}\n735\t\n736\t#[unsafe(no_mangle)]\n737\tpub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n738\t    let c = c2Sub(B.p, A.p);\n739\t    let d2 = c2Dot(c, c);\n740\t    let mut r2 = A.r + B.r;\n741\t    r2 = r2 * r2;\n742\t    (d2 < r2) as c_int\n743\t}\n744\t\n745\t#[unsafe(no_mangle)]\n746\tpub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n747\t    let L = c2Clampv(A.p, B.min, B.max);\n748\t    let ab = c2Sub(A.p, L);\n749\t    let d2 = c2Dot(ab, ab);\n750\t    let r2 = A.r * A.r;\n751\t    (d2 < r2) as c_int\n752\t}\n753\t\n754\t#[unsafe(no_mangle)]\n755\tpub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n756\t    let n = c2Sub(B.b, B.a);\n757\t    let ap = c2Sub(A.p, B.a);\n758\t    let da = c2Dot(ap, n);\n759\t    let d2: f32;\n760\t    if da < 0.0 {\n761\t        d2 = c2Dot(ap, ap);\n762\t    } else {\n763\t        let db = c2Dot(c2Sub(A.p, B.b), n);\n764\t        if db < 0.0 {\n765\t            let e = c2Sub(ap, c2Mulvs(n, da / c2Dot(n, n)));\n766\t            d2 = c2Dot(e, e);\n767\t        } else {\n768\t            let bp = c2Sub(A.p, B.b);\n769\t            d2 = c2Dot(bp, bp);\n770\t        }\n771\t    }\n772\t    let r = A.r + B.r;\n773\t    (d2 < r * r) as c_int\n774\t}\n775\t\n776\t#[unsafe(no_mangle)]\n777\tpub unsafe extern \"C\" fn c2Collided(\n778\t    A: *const c2void,\n779\t    typeA: c_int,\n780\t    B: *const c2void,\n781\t    typeB: c_int,\n782\t) -> c_int {\n783\t    match typeA {\n784\t        C2_TYPE_CIRCLE => match typeB {\n785\t            C2_TYPE_CIRCLE => c2CircletoCircle(*(A as *const c2Circle), *(B as *const c2Circle)),\n786\t            C2_TYPE_AABB => c2CircletoAABB(*(A as *const c2Circle), *(B as *const c2AABB)),\n787\t            C2_TYPE_CAPSULE => c2CircletoCapsule(*(A as *const c2Circle), *(B as *const c2Capsule)),\n788\t            _ => 0,\n789\t        },\n790\t        C2_TYPE_AABB => match typeB {\n791\t            C2_TYPE_CIRCLE => c2CircletoAABB(*(B as *const c2Circle), *(A as *const c2AABB)),\n792\t            C2_TYPE_AABB => c2AABBtoAABB(*(A as *const c2AABB), *(B as *const c2AABB)),\n793\t            C2_TYPE_CAPSULE => c2AABBtoCapsule(*(A as *const c2AABB), *(B as *const c2Capsule)),\n794\t            _ => 0,\n795\t        },\n796\t        C2_TYPE_CAPSULE => match typeB {\n797\t            C2_TYPE_CIRCLE => c2CircletoCapsule(*(B as *const c2Circle), *(A as *const c2Capsule)),\n798\t            C2_TYPE_AABB => c2AABBtoCapsule(*(B as *const c2AABB), *(A as *const c2Capsule)),\n799\t            C2_TYPE_CAPSULE => {\n800\t                c2CapsuletoCapsule(*(A as *const c2Capsule), *(B as *const c2Capsule))\n801\t            }\n802\t            _ => 0,\n803\t        },\n804\t        _ => 0,\n805\t    }\n806\t}\n807\t\n808\t// ---------------------------------------------------------------------------\n809\t// Public entry point declared in include/lib.h\n810\t// ---------------------------------------------------------------------------\n811\t\n812\t#[unsafe(no_mangle)]\n813\tpub extern \"C\" fn reverse_collide(x: f32, y: f32, r: f32) -> c_int {\n814\t    let mut result: c_int = 0;\n815\t\n816\t    let mut circle_in = c2Circle::default();\n817\t    circle_in.p = c2V(x, y);\n818\t    circle_in.r = r;\n819\t\n820\t    let mut circle = c2Circle::default();\n821\t    circle.p = c2V(-70.0f32, 0.0);\n822\t    circle.r = 20.0f32;\n823\t\n824\t    let mut aabb = c2AABB::default();\n825\t    aabb.min = c2V(-40.0f32, -40.0f32);\n826\t    aabb.max = c2V(-15.0f32, -15.0f32);\n827\t\n828\t    let mut capsule = c2Capsule::default();\n829\t    capsule.a = c2V(-40.0f32, 40.0f32);\n830\t    capsule.b = c2V(-20.0f32, 100.0f32);\n831\t    capsule.r = 10.0f32;\n832\t\n833\t    unsafe {\n834\t        result += c2Collided(\n835\t            &mut circle as *mut c2Circle as *const c2void,\n836\t            C2_TYPE_CIRCLE,\n837\t            &mut circle_in as *mut c2Circle as *const c2void,\n838\t            C2_TYPE_CIRCLE,\n839\t        );\n840\t\n841\t        result += c2Collided(\n842\t            &mut aabb as *mut c2AABB as *const c2void,\n843\t            C2_TYPE_AABB,\n844\t            &mut circle_in as *mut c2Circle as *const c2void,\n845\t            C2_TYPE_CIRCLE,\n846\t        ) << 1;\n847\t\n848\t        result += c2Collided(\n849\t            &mut capsule as *mut c2Capsule as *const c2void,\n850\t            C2_TYPE_CAPSULE,\n851\t            &mut circle_in as *mut c2Circle as *const c2void,\n852\t            C2_TYPE_CIRCLE,\n853\t        ) << 2;\n854\t    }\n855\t\n856\t    result\n857\t}\n858\t"}]},"parent_tool_use_id":null,"session_id":"942ae4b7-49c2-4d5f-9440-34a2b94a5a02","uuid":"5682fd45-b15a-4088-9d79-ef235560d943","timestamp":"2026-08-20T13:33:41.879Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-J4diuV/translated_rust/src/lib.rs","content":"//! Rust translation of the C library in `c_src/` (a cute_c2 / tinyc2 derivative).\n//!\n//! Every public symbol exported by the C shared library is re-exported here with\n//! the identical linker name, C ABI, and bit-exact behaviour.  The original C is\n//! reproduced faithfully, including its quirks; no bugs are \"fixed\".\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n\nuse core::ffi::{c_int, c_void};\n\n// ---------------------------------------------------------------------------\n// C2_TYPE enum (a plain C enum => `int` in the ABI)\n// ---------------------------------------------------------------------------\n\npub const C2_TYPE_CIRCLE: c_int = 0;\npub const C2_TYPE_AABB: c_int = 1;\npub const C2_TYPE_CAPSULE: c_int = 2;\n\n// ---------------------------------------------------------------------------\n// Public structs (layout-compatible with the C definitions)\n// ---------------------------------------------------------------------------\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2GJKCache {\n    pub metric: f32,\n    pub count: c_int,\n    pub iA: [c_int; 3],\n    pub iB: [c_int; 3],\n    pub div: f32,\n}\n\n/// `typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;`\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2Proxy {\n    pub radius: f32,\n    pub count: c_int,\n    pub verts: [c2v; 8],\n}\n\n/// `typedef struct { c2v sA; c2v sB; c2v p; float u; int iA; int iB; } c2sv;`\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2sv {\n    pub sA: c2v,\n    pub sB: c2v,\n    pub p: c2v,\n    pub u: f32,\n    pub iA: c_int,\n    pub iB: c_int,\n}\n\n/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n///\n/// The four `c2sv` members are stored as an array because the C code walks them\n/// with pointer arithmetic (`c2sv* verts = &s.a;`).  The memory layout is\n/// identical to four consecutive `c2sv` fields.\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2Simplex {\n    pub verts: [c2sv; 4],\n    pub div: f32,\n    pub count: c_int,\n}\n\n// ---------------------------------------------------------------------------\n// Vector math\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a = c2v { x: 0.0, y: 0.0 };\n    a.x = x;\n    a.y = y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n    let mut a = a;\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    let mut r = c2r { c: 0.0, s: 0.0 };\n    r.c = 1.0f32;\n    r.s = 0.0;\n    r\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    let mut x = c2x::default();\n    x.p = c2V(0.0, 0.0);\n    x.r = c2RotIdentity();\n    x\n}\n\n// ---------------------------------------------------------------------------\n// Shape helpers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    let bb = &*bb;\n    *out.add(0) = bb.min;\n    *out.add(1) = c2V(bb.max.x, bb.min.y);\n    *out.add(2) = bb.max;\n    *out.add(3) = c2V(bb.min.x, bb.max.y);\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c2void, type_: c_int, p: *mut c2Proxy) {\n    match type_ {\n        C2_TYPE_CIRCLE => {\n            let c = shape as *mut c2Circle;\n            (*p).radius = (*c).r;\n            (*p).count = 1;\n            (*p).verts[0] = (*c).p;\n        }\n        C2_TYPE_AABB => {\n            let bb = shape as *mut c2AABB;\n            (*p).radius = 0.0;\n            (*p).count = 4;\n            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n        }\n        C2_TYPE_CAPSULE => {\n            let c = shape as *mut c2Capsule;\n            (*p).radius = (*c).r;\n            (*p).count = 2;\n            (*p).verts[0] = (*c).a;\n            (*p).verts[1] = (*c).b;\n        }\n        _ => {}\n    }\n}\n\n/// Alias used purely to keep the `const void*` parameter spelling readable.\npub type c2void = c_void;\n\n// ---------------------------------------------------------------------------\n// Simplex helpers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    sqrtf(c2Dot(a, a))\n}\n\n#[inline]\nfn sqrtf(v: f32) -> f32 {\n    // IEEE-754 correctly-rounded single-precision square root, exactly as\n    // C's sqrtf().\n    v.sqrt()\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    a.x * b.y - a.y * b.x\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    let s = &mut *s;\n    match s.count {\n        2 => c2Len(c2Sub(s.verts[1].p, s.verts[0].p)),\n        3 => c2Det2(\n            c2Sub(s.verts[1].p, s.verts[0].p),\n            c2Sub(s.verts[2].p, s.verts[0].p),\n        ),\n        // `default:` falls through into `case 1:` in the C source.\n        _ => 0.0,\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    let s = &mut *s;\n    let a = s.verts[0].p;\n    let b = s.verts[1].p;\n    let u = c2Dot(b, c2Sub(b, a));\n    let v = c2Dot(a, c2Sub(a, b));\n    if v <= 0.0 {\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    } else if u <= 0.0 {\n        s.verts[0] = s.verts[1];\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    } else {\n        s.verts[0].u = u;\n        s.verts[1].u = v;\n        s.div = u + v;\n        s.count = 2;\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n    let s = &mut *s;\n    let a = s.verts[0].p;\n    let b = s.verts[1].p;\n    let c = s.verts[2].p;\n    let uAB = c2Dot(b, c2Sub(b, a));\n    let vAB = c2Dot(a, c2Sub(a, b));\n    let uBC = c2Dot(c, c2Sub(c, b));\n    let vBC = c2Dot(b, c2Sub(b, c));\n    let uCA = c2Dot(a, c2Sub(a, c));\n    let vCA = c2Dot(c, c2Sub(c, a));\n    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n    let uABC = c2Det2(b, c) * area;\n    let vABC = c2Det2(c, a) * area;\n    let wABC = c2Det2(a, b) * area;\n    if vAB <= 0.0 && uCA <= 0.0 {\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    } else if uAB <= 0.0 && vBC <= 0.0 {\n        s.verts[0] = s.verts[1];\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    } else if uBC <= 0.0 && vCA <= 0.0 {\n        s.verts[0] = s.verts[2];\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n        s.verts[0].u = uAB;\n        s.verts[1].u = vAB;\n        s.div = uAB + vAB;\n        s.count = 2;\n    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n        s.verts[0] = s.verts[1];\n        s.verts[1] = s.verts[2];\n        s.verts[0].u = uBC;\n        s.verts[1].u = vBC;\n        s.div = uBC + vBC;\n        s.count = 2;\n    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n        s.verts[1] = s.verts[0];\n        s.verts[0] = s.verts[2];\n        s.verts[0].u = uCA;\n        s.verts[1].u = vCA;\n        s.div = uCA + vCA;\n        s.count = 2;\n    } else {\n        s.verts[0].u = uABC;\n        s.verts[1].u = vABC;\n        s.verts[2].u = wABC;\n        s.div = uABC + vABC + wABC;\n        s.count = 3;\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    c2V(-a.x, -a.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = -a.y;\n    b.y = a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = a.y;\n    b.y = -a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    let s = &mut *s;\n    match s.count {\n        1 => c2Neg(s.verts[0].p),\n        2 => {\n            let ab = c2Sub(s.verts[1].p, s.verts[0].p);\n            if c2Det2(ab, c2Neg(s.verts[0].p)) > 0.0 {\n                return c2Skew(ab);\n            }\n            c2CCW90(ab)\n        }\n        // `case 3:` and `default:`\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    let mut imax: c_int = 0;\n    let mut dmax = c2Dot(*verts.add(0), d);\n    let mut i: c_int = 1;\n    while i < count {\n        let dot = c2Dot(*verts.offset(i as isize), d);\n        if dot > dmax {\n            imax = i;\n            dmax = dot;\n        }\n        i += 1;\n    }\n    imax\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n    let s = &mut *s;\n    let den = 1.0f32 / s.div;\n    match s.count {\n        1 => {\n            *a = s.verts[0].sA;\n            *b = s.verts[0].sB;\n        }\n        2 => {\n            *a = c2Add(\n                c2Mulvs(s.verts[0].sA, den * s.verts[0].u),\n                c2Mulvs(s.verts[1].sA, den * s.verts[1].u),\n            );\n            *b = c2Add(\n                c2Mulvs(s.verts[0].sB, den * s.verts[0].u),\n                c2Mulvs(s.verts[1].sB, den * s.verts[1].u),\n            );\n        }\n        3 => {\n            *a = c2Add(\n                c2Add(\n                    c2Mulvs(s.verts[0].sA, den * s.verts[0].u),\n                    c2Mulvs(s.verts[1].sA, den * s.verts[1].u),\n                ),\n                c2Mulvs(s.verts[2].sA, den * s.verts[2].u),\n            );\n            *b = c2Add(\n                c2Add(\n                    c2Mulvs(s.verts[0].sB, den * s.verts[0].u),\n                    c2Mulvs(s.verts[1].sB, den * s.verts[1].u),\n                ),\n                c2Mulvs(s.verts[2].sB, den * s.verts[2].u),\n            );\n        }\n        _ => {\n            *a = c2V(0.0, 0.0);\n            *b = c2V(0.0, 0.0);\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n    let s = &mut *s;\n    let den = 1.0f32 / s.div;\n    match s.count {\n        1 => s.verts[0].p,\n        2 => c2Add(\n            c2Mulvs(s.verts[0].p, den * s.verts[0].u),\n            c2Mulvs(s.verts[1].p, den * s.verts[1].u),\n        ),\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n}\n\n// ---------------------------------------------------------------------------\n// GJK\n// ---------------------------------------------------------------------------\n\nconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_6e38_f32; // FLT_MAX\nconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7_f32; // FLT_EPSILON\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJK(\n    A: *const c2void,\n    typeA: c_int,\n    ax_ptr: *const c2x,\n    B: *const c2void,\n    typeB: c_int,\n    bx_ptr: *const c2x,\n    outA: *mut c2v,\n    outB: *mut c2v,\n    use_radius: c_int,\n    iterations: *mut c_int,\n    cache: *mut c2GJKCache,\n) -> f32 {\n    let ax: c2x;\n    let bx: c2x;\n    if ax_ptr.is_null() {\n        ax = c2xIdentity();\n    } else {\n        ax = *ax_ptr;\n    }\n    if bx_ptr.is_null() {\n        bx = c2xIdentity();\n    } else {\n        bx = *bx_ptr;\n    }\n    let mut pA = c2Proxy::default();\n    let mut pB = c2Proxy::default();\n    c2MakeProxy(A, typeA, &mut pA);\n    c2MakeProxy(B, typeB, &mut pB);\n    let mut s = c2Simplex::default();\n    let verts: *mut c2sv = s.verts.as_mut_ptr();\n    let mut cache_was_read: c_int = 0;\n    if !cache.is_null() {\n        let cache_was_good: c_int = ((*cache).count != 0) as c_int;\n        if cache_was_good != 0 {\n            let mut i: c_int = 0;\n            while i < (*cache).count {\n                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n                let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n                let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n                let v = verts.offset(i as isize);\n                (*v).iA = iA;\n                (*v).sA = sA;\n                (*v).iB = iB;\n                (*v).sB = sB;\n                (*v).p = c2Sub((*v).sB, (*v).sA);\n                (*v).u = 0.0;\n                i += 1;\n            }\n            s.count = (*cache).count;\n            s.div = (*cache).div;\n            let metric_old = (*cache).metric;\n            let metric = c2GJKSimplexMetric(&mut s);\n            let min_metric = if metric < metric_old { metric } else { metric_old };\n            let max_metric = if metric > metric_old { metric } else { metric_old };\n            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n                cache_was_read = 1;\n            }\n        }\n    }\n    if cache_was_read == 0 {\n        s.verts[0].iA = 0;\n        s.verts[0].iB = 0;\n        s.verts[0].sA = c2Mulxv(ax, pA.verts[0]);\n        s.verts[0].sB = c2Mulxv(bx, pB.verts[0]);\n        s.verts[0].p = c2Sub(s.verts[0].sB, s.verts[0].sA);\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    }\n    let mut saveA: [c_int; 3] = [0; 3];\n    let mut saveB: [c_int; 3] = [0; 3];\n    let mut save_count: c_int = 0;\n    let mut d0: f32 = C2_FLT_MAX;\n    let mut d1: f32;\n    let mut iter: c_int = 0;\n    let mut hit: c_int = 0;\n    while iter < 20 {\n        save_count = s.count;\n        let mut i: c_int = 0;\n        while i < save_count {\n            *saveA.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iA;\n            *saveB.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iB;\n            i += 1;\n        }\n        match s.count {\n            1 => {}\n            2 => c22(&mut s),\n            3 => c23(&mut s),\n            _ => {}\n        }\n        if s.count == 3 {\n            hit = 1;\n            break;\n        }\n        let p = c2L(&mut s);\n        d1 = c2Dot(p, p);\n        if d1 > d0 {\n            break;\n        }\n        d0 = d1;\n        let d = c2D(&mut s);\n        if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n            break;\n        }\n        let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n        let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n        let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n        let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n        let v = verts.offset(s.count as isize);\n        (*v).iA = iA;\n        (*v).sA = sA;\n        (*v).iB = iB;\n        (*v).sB = sB;\n        (*v).p = c2Sub((*v).sB, (*v).sA);\n        let mut dup: c_int = 0;\n        let mut i: c_int = 0;\n        while i < save_count {\n            if iA == *saveA.as_ptr().offset(i as isize) && iB == *saveB.as_ptr().offset(i as isize) {\n                dup = 1;\n                break;\n            }\n            i += 1;\n        }\n        if dup != 0 {\n            break;\n        }\n        s.count += 1;\n        iter += 1;\n    }\n    let _ = save_count;\n    let mut a = c2v { x: 0.0, y: 0.0 };\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    c2Witness(&mut s, &mut a, &mut b);\n    let mut dist = c2Len(c2Sub(a, b));\n    if hit != 0 {\n        a = b;\n        dist = 0.0;\n    } else if use_radius != 0 {\n        let rA = pA.radius;\n        let rB = pB.radius;\n        if dist > rA + rB && dist > C2_FLT_EPSILON {\n            dist -= rA + rB;\n            let n = c2Norm(c2Sub(b, a));\n            a = c2Add(a, c2Mulvs(n, rA));\n            b = c2Sub(b, c2Mulvs(n, rB));\n            if a.x == b.x && a.y == b.y {\n                dist = 0.0;\n            }\n        } else {\n            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n            a = p;\n            b = p;\n            dist = 0.0;\n        }\n    }\n    if !cache.is_null() {\n        (*cache).metric = c2GJKSimplexMetric(&mut s);\n        (*cache).count = s.count;\n        let mut i: c_int = 0;\n        while i < s.count {\n            let v = verts.offset(i as isize);\n            *(*cache).iA.as_mut_ptr().offset(i as isize) = (*v).iA;\n            *(*cache).iB.as_mut_ptr().offset(i as isize) = (*v).iB;\n            i += 1;\n        }\n        (*cache).div = s.div;\n    }\n    if !outA.is_null() {\n        *outA = a;\n    }\n    if !outB.is_null() {\n        *outB = b;\n    }\n    if !iterations.is_null() {\n        *iterations = iter;\n    }\n    dist\n}\n\n// ---------------------------------------------------------------------------\n// Boolean collision routines\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n    let d0: c_int = (B.max.x < A.min.x) as c_int;\n    let d1: c_int = (A.max.x < B.min.x) as c_int;\n    let d2: c_int = (B.max.y < A.min.y) as c_int;\n    let d3: c_int = (A.max.y < B.min.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n    let mut A = A;\n    let mut B = B;\n    unsafe {\n        if c2GJK(\n            &mut A as *mut c2AABB as *const c2void,\n            C2_TYPE_AABB,\n            core::ptr::null(),\n            &mut B as *mut c2Capsule as *const c2void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n            1,\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n        ) != 0.0\n        {\n            return 0;\n        }\n    }\n    1\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n    let mut A = A;\n    let mut B = B;\n    unsafe {\n        if c2GJK(\n            &mut A as *mut c2Capsule as *const c2void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            &mut B as *mut c2Capsule as *const c2void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n            1,\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n        ) != 0.0\n        {\n            return 0;\n        }\n    }\n    1\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n    let c = c2Sub(B.p, A.p);\n    let d2 = c2Dot(c, c);\n    let mut r2 = A.r + B.r;\n    r2 = r2 * r2;\n    (d2 < r2) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n    let L = c2Clampv(A.p, B.min, B.max);\n    let ab = c2Sub(A.p, L);\n    let d2 = c2Dot(ab, ab);\n    let r2 = A.r * A.r;\n    (d2 < r2) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n    let n = c2Sub(B.b, B.a);\n    let ap = c2Sub(A.p, B.a);\n    let da = c2Dot(ap, n);\n    let d2: f32;\n    if da < 0.0 {\n        d2 = c2Dot(ap, ap);\n    } else {\n        let db = c2Dot(c2Sub(A.p, B.b), n);\n        if db < 0.0 {\n            let e = c2Sub(ap, c2Mulvs(n, da / c2Dot(n, n)));\n            d2 = c2Dot(e, e);\n        } else {\n            let bp = c2Sub(A.p, B.b);\n            d2 = c2Dot(bp, bp);\n        }\n    }\n    let r = A.r + B.r;\n    (d2 < r * r) as c_int\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Collided(\n    A: *const c2void,\n    typeA: c_int,\n    B: *const c2void,\n    typeB: c_int,\n) -> c_int {\n    match typeA {\n        C2_TYPE_CIRCLE => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoCircle(*(A as *const c2Circle), *(B as *const c2Circle)),\n            C2_TYPE_AABB => c2CircletoAABB(*(A as *const c2Circle), *(B as *const c2AABB)),\n            C2_TYPE_CAPSULE => c2CircletoCapsule(*(A as *const c2Circle), *(B as *const c2Capsule)),\n            _ => 0,\n        },\n        C2_TYPE_AABB => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoAABB(*(B as *const c2Circle), *(A as *const c2AABB)),\n            C2_TYPE_AABB => c2AABBtoAABB(*(A as *const c2AABB), *(B as *const c2AABB)),\n            C2_TYPE_CAPSULE => c2AABBtoCapsule(*(A as *const c2AABB), *(B as *const c2Capsule)),\n            _ => 0,\n        },\n        C2_TYPE_CAPSULE => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoCapsule(*(B as *const c2Circle), *(A as *const c2Capsule)),\n            C2_TYPE_AABB => c2AABBtoCapsule(*(B as *const c2AABB), *(A as *const c2Capsule)),\n            C2_TYPE_CAPSULE => {\n                c2CapsuletoCapsule(*(A as *const c2Capsule), *(B as *const c2Capsule))\n            }\n            _ => 0,\n        },\n        _ => 0,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Public entry point declared in include/lib.h\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn reverse_collide(x: f32, y: f32, r: f32) -> c_int {\n    let mut result: c_int = 0;\n\n    let mut circle_in = c2Circle::default();\n    circle_in.p = c2V(x, y);\n    circle_in.r = r;\n\n    let mut circle = c2Circle::default();\n    circle.p = c2V(-70.0f32, 0.0);\n    circle.r = 20.0f32;\n\n    let mut aabb = c2AABB::default();\n    aabb.min = c2V(-40.0f32, -40.0f32);\n    aabb.max = c2V(-15.0f32, -15.0f32);\n\n    let mut capsule = c2Capsule::default();\n    capsule.a = c2V(-40.0f32, 40.0f32);\n    capsule.b = c2V(-20.0f32, 100.0f32);\n    capsule.r = 10.0f32;\n\n    unsafe {\n        result += c2Collided(\n            &mut circle as *mut c2Circle as *const c2void,\n            C2_TYPE_CIRCLE,\n            &mut circle_in as *mut c2Circle as *const c2void,\n            C2_TYPE_CIRCLE,\n        );\n\n        result += c2Collided(\n            &mut aabb as *mut c2AABB as *const c2void,\n            C2_TYPE_AABB,\n            &mut circle_in as *mut c2Circle as *const c2void,\n            C2_TYPE_CIRCLE,\n        ) << 1;\n\n        result += c2Collided(\n            &mut capsule as *mut c2Capsule as *const c2void,\n            C2_TYPE_CAPSULE,\n            &mut circle_in as *mut c2Circle as *const c2void,\n            C2_TYPE_CIRCLE,\n        ) << 2;\n    }\n\n    result\n}\n","numLines":858,"startLine":1,"totalLines":858}}}
