-------------------------------------------------- */\n/* 3. binary-key hash map                                              */\n/* ------------------------------------------------------------------ */\ntypedef struct { int key, value; } imap;\n\nstatic imap *im_put(imap *m, int k, int v)\n{\n  m = (imap*) p_hmput_key(m, sizeof *m, &k, sizeof k, 0);\n  m[HDR(m-1)->temp].key = k;\n  m[HDR(m-1)->temp].value = v;\n  return m;\n}\nstatic imap *im_get(imap *m, int k, ptrdiff_t *idx)\n{\n  m = (imap*) p_hmget_key(m, sizeof *m, &k, sizeof k, 0);\n  *idx = HDR(m-1)->temp;\n  return m;\n}\nstatic imap *im_del(imap *m, int k, ptrdiff_t *res)\n{\n  m = (imap*) p_hmdel_key(m, sizeof *m, &k, sizeof k, offsetof(imap, key), 0);\n  *res = m ? HDR(m-1)->temp : 0;\n  return m;\n}\nstatic void im_dump(const char *tag, imap *m)\n{\n  printf(\"%s len %td :\", tag, m ? (ptrdiff_t)HDR(m-1)->length - 1 : 0);\n  if (m) for (size_t i = 0; i < HDR(m-1)->length - 1; ++i)\n    printf(\" %d=%d\", m[i].key, m[i].value);\n  printf(\"\\n\");\n}\n\nstatic void test_imap(unsigned seed)\n{\n  printf(\"== imap seed %u ==\\n\", seed);\n  p_rand_seed(seed);\n  imap *m = NULL;\n  ptrdiff_t idx;\n\n  m = (imap*) p_hmput_default(m, sizeof *m);\n  m[-1].value = -999;\n  printf(\"default %d\\n\", m[-1].value);\n\n  for (int i = 0; i < 300; ++i) {\n    m = im_put(m, i * 7 - 100, i);\n    if (i % 37 == 0) im_dump(\"after-put\", m);\n  }\n  im_dump(\"filled\", m);\n\n  for (int i = -400; i < 400; i += 3) {\n    m = im_get(m, i, &idx);\n    printf(\"get %d -> %td (%d)\\n\", i, idx, idx >= 0 ? m[idx].value : m[-1].value);\n  }\n\n  for (int i = 0; i < 300; i += 2) {\n    ptrdiff_t r;\n    m = im_del(m, i * 7 - 100, &r);\n    if (i % 41 == 0) { printf(\"del %d -> %td\\n\", i * 7 - 100, r); im_dump(\"after-del\", m); }\n  }\n  im_dump(\"after-dels\", m);\n  for (int i = 0; i < 300; ++i) {\n    m = im_get(m, i * 7 - 100, &idx);\n    printf(\"g2 %d -> %td\\n\", i, idx);\n  }\n  /* re-insert to exercise tombstone reuse */\n  for (int i = 0; i < 300; i += 2) m = im_put(m, i * 7 - 100, 1000 + i);\n  im_dump(\"reinserted\", m);\n  /* delete everything (shrink path) */\n  for (int i = 299; i >= 0; --i) { ptrdiff_t r; m = im_del(m, i * 7 - 100, &r); }\n  im_dump(\"emptied\", m);\n  ptrdiff_t t;\n  m = im_get(m, 42, &t);\n  printf(\"get-miss %td\\n\", t);\n  m = (imap*) p_hmget_key_ts(m, sizeof *m, (void*)&t, sizeof(int), &t, 0);\n  printf(\"get_ts %td\\n\", t);\n  p_hmfree_func(m - 1, sizeof *m);\n\n  /* hmget_key_ts / hmdel_key on NULL maps */\n  ptrdiff_t tv = 77;\n  int k = 5;\n  void *n = p_hmget_key_ts(NULL, sizeof(imap), &k, sizeof k, &tv, 0);\n  printf(\"null-get_ts temp %td len %zu\\n\", tv, HDR((char*)n - sizeof(imap))->length);\n  p_hmfree_func((char*)n - sizeof(imap), sizeof(imap));\n  printf(\"null-del %p\\n\", p_hmdel_key(NULL, sizeof(imap), &k, sizeof k, 0, 0));\n\n  /* wide binary keys (16 bytes) */\n  typedef struct { int key[2]; int b, c; } wmap;\n  wmap *w = NULL;\n  for (int i = 0; i < 60; ++i) {\n    int kk[2] = { i, -i };\n    w = (wmap*) p_hmput_key(w, sizeof *w, kk, sizeof kk, 0);\n    w[HDR(w-1)->temp].key[0] = i; w[HDR(w-1)->temp].key[1] = -i;\n    w[HDR(w-1)->temp].b = i * 3; w[HDR(w-1)->temp].c = i * 5;\n  }\n  for (int i = 0; i < 60; ++i) {\n    int kk[2] = { i, -i };\n    w = (wmap*) p_hmget_key(w, sizeof *w, kk, sizeof kk, 0);\n    printf(\"w %d -> %td b=%d c=%d\\n\", i, HDR(w-1)->temp,\n           w[HDR(w-1)->temp].b, w[HDR(w-1)->temp].c);\n  }\n  for (int i = 0; i < 60; i += 4) {\n    int kk[2] = { i, -i };\n    w = (wmap*) p_hmdel_key(w, sizeof *w, kk, sizeof kk, offsetof(wmap, key), 0);\n    printf(\"wdel %d -> %td len %zu\\n\", i, HDR(w-1)->temp, HDR(w-1)->length);\n  }\n  p_hmfree_func(w - 1, sizeof *w);\n}\n\n/* ------------------------------------------------------------------ */\n/* 4. string maps                                                      */\n/* ------------------------------------------------------------------ */\ntypedef struct { char *key; int value; } smap;\n\nstatic char *keys[400];\nstatic void make_keys(void)\n{\n  for (int i = 0; i < 400; ++i) {\n    char tmp[64];\n    sprintf(tmp, \"key_%d_%s\", i, (i & 1) ? \"odd\" : \"even\");\n    keys[i] = strdup(tmp);\n  }\n}\n\nstatic void test_smap(int mode, int shmode)\n{\n  printf(\"== smap mode %d shmode %d ==\\n\", mode, shmode);\n  p_rand_seed(0x31415926);\n  smap *m = NULL;\n  if (shmode >= 0) m = (smap*) p_shmode_func(sizeof *m, shmode);\n\n  for (int i = 0; i < 400; ++i) {\n    /* shputs semantics: value then key replaced by temp_key */\n    m = (smap*) p_hmput_key(m, sizeof *m, keys[i], sizeof(char*), mode);\n    ptrdiff_t t = HDR(m-1)->temp;\n    m[t].value = i * 11;\n    m[t].key = *(char**)HDR(m-1)->hash_table;   /* temp_key */\n  }\n  printf(\"len %td\\n\", (ptrdiff_t)HDR(m-1)->length - 1);\n  for (int i = 0; i < 400; i += 7)\n    printf(\"elem %d: %s = %d\\n\", i, m[i].key, m[i].value);\n\n  for (int i = 0; i < 400; ++i) {\n    m = (smap*) p_hmget_key(m, sizeof *m, keys[i], sizeof(char*), mode);\n    ptrdiff_t t = HDR(m-1)->temp;\n    printf(\"sget %d -> %td %s %d\\n\", i, t, t >= 0 ? m[t].key : \"(null)\",\n           t >= 0 ? m[t].value : -1);\n  }\n  m = (smap*) p_hmget_key(m, sizeof *m, \"nope\", sizeof(char*), mode);\n  printf(\"smiss %td\\n\", HDR(m-1)->temp);\n\n  for (int i = 0; i < 400; i += 3) {\n    m = (smap*) p_hmdel_key(m, sizeof *m, keys[i], sizeof(char*),\n                            offsetof(smap, key), mode);\n    if (i % 51 == 0) printf(\"sdel %d -> %td len %zu\\n\", i, HDR(m-1)->temp, HDR(m-1)->length);\n  }\n  printf(\"after del len %td\\n\", (ptrdiff_t)HDR(m-1)->length - 1);\n  for (int i = 0; i < 400; ++i) {\n    m = (smap*) p_hmget_key(m, sizeof *m, keys[i], sizeof(char*), mode);\n    printf(\"sg2 %d -> %td\\n\", i, HDR(m-1)->temp);\n  }\n  for (size_t i = 0; i < HDR(m-1)->length - 1; ++i)\n    printf(\"final %zu %s %d\\n\", i, m[i].key, m[i].value);\n  p_hmfree_func(m - 1, sizeof *m);\n}\n\n/* ------------------------------------------------------------------ */\n/* 5. string arena                                                     */\n/* ------------------------------------------------------------------ */\nstatic void test_arena(void)\n{\n  printf(\"== arena ==\\n\");\n  arena a; memset(&a, 0, sizeof a);\n  char *prev = NULL;\n  for (int i = 0; i < 500; ++i) {\n    char tmp[2048];\n    int n = (i % 7 == 0) ? (i * 13) % 1500 : (i % 40);\n    memset(tmp, 'a' + (i % 26), n);\n    tmp[n] = 0;\n    char *p = p_stralloc(&a, tmp);\n    printf(\"sa %d len %d rem %zu blk %u eq %d delta %td\\n\", i, n, a.remaining,\n           a.block, strcmp(p, tmp) == 0,\n           prev && (p - prev) > -100000 && (p - prev) < 100000 ? p - prev : 0);\n    prev = p;\n  }\n  p_strreset(&a);\n  printf(\"reset rem %zu blk %u mode %u storage-null %d\\n\", a.remaining, a.block,\n         a.mode, a.storage == NULL);\n  /* reuse after reset */\n  char *q = p_stralloc(&a, \"hello\");\n  printf(\"post-reset %s rem %zu blk %u\\n\", q, a.remaining, a.block);\n  p_strreset(&a);\n}\n\n/* ------------------------------------------------------------------ */\n/* 6. exported test helpers                                            */\n/* ------------------------------------------------------------------ */\nstatic void test_helpers(void)\n{\n  printf(\"== helpers ==\\n\");\n  printf(\"strkey0 %s\\n\", p_strkey(0));\n  printf(\"strkey %s\\n\", p_strkey(12345));\n  printf(\"strkeyneg %s\\n\", p_strkey(-7));\n  char *x = p_strkey(1), *y = p_strkey(2);\n  printf(\"same-buffer %d contents %s\\n\", x == y, x);\n  fflush(stdout);\n  int nums[] = { 0, 1, 2, 5, 17, 200, -3 };\n  for (unsigned i = 0; i < sizeof nums / sizeof *nums; ++i) {\n    printf(\"str_put(%d):\\n\", nums[i]);\n    fflush(stdout);\n    p_str_put(nums[i]);\n    fflush(stdout);\n  }\n}\n\nint main(int argc, char **argv)\n{\n  if (argc < 2) { fprintf(stderr, \"usage: %s lib.so\\n\", argv[0]); return 1; }\n  load(argv[1]);\n  make_keys();\n  test_arr();\n  test_hash();\n  test_imap(0x31415926);\n  test_imap(1);\n  test_imap(0);\n  test_smap(1, -1);         /* SH_DEFAULT (key pointers stored as-is) */\n  test_smap(1, 2);          /* SH_STRDUP */\n  test_smap(1, 3);          /* SH_ARENA  */\n  test_arena();\n  test_helpers();\n  fflush(stdout);\n  return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
