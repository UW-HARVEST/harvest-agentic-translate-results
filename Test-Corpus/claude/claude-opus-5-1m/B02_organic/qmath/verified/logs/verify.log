\tvec4_t\t\tcolorGreen;\n303\textern\tvec4_t\t\tcolorBlue;\n304\textern\tvec4_t\t\tcolorYellow;\n305\textern\tvec4_t\t\tcolorMagenta;\n306\textern\tvec4_t\t\tcolorCyan;\n307\textern\tvec4_t\t\tcolorWhite;\n308\textern\tvec4_t\t\tcolorLtGrey;\n309\textern\tvec4_t\t\tcolorMdGrey;\n310\textern\tvec4_t\t\tcolorDkGrey;\n311\t\n312\t#define Q_COLOR_ESCAPE\t'^'\n313\t#define Q_IsColorString(p)\t( p && *(p) == Q_COLOR_ESCAPE && *((p)+1) && *((p)+1) != Q_COLOR_ESCAPE )\n314\t\n315\t#define COLOR_BLACK\t\t'0'\n316\t#define COLOR_RED\t\t'1'\n317\t#define COLOR_GREEN\t\t'2'\n318\t#define COLOR_YELLOW\t'3'\n319\t#define COLOR_BLUE\t\t'4'\n320\t#define COLOR_CYAN\t\t'5'\n321\t#define COLOR_MAGENTA\t'6'\n322\t#define COLOR_WHITE\t\t'7'\n323\t#define ColorIndex(c)\t( ( (c) - '0' ) & 7 )\n324\t\n325\t#define S_COLOR_BLACK\t\"^0\"\n326\t#define S_COLOR_RED\t\t\"^1\"\n327\t#define S_COLOR_GREEN\t\"^2\"\n328\t#define S_COLOR_YELLOW\t\"^3\"\n329\t#define S_COLOR_BLUE\t\"^4\"\n330\t#define S_COLOR_CYAN\t\"^5\"\n331\t#define S_COLOR_MAGENTA\t\"^6\"\n332\t#define S_COLOR_WHITE\t\"^7\"\n333\t\n334\textern vec4_t\tg_color_table[8];\n335\t\n336\t#define\tMAKERGB( v, r, g, b ) v[0]=r;v[1]=g;v[2]=b\n337\t#define\tMAKERGBA( v, r, g, b, a ) v[0]=r;v[1]=g;v[2]=b;v[3]=a\n338\t\n339\t#define DEG2RAD( a ) ( ( (a) * M_PI ) / 180.0F )\n340\t#define RAD2DEG( a ) ( ( (a) * 180.0f ) / M_PI )\n341\t\n342\tstruct cplane_s;\n343\t\n344\textern\tvec3_t\tvec3_origin;\n345\textern\tvec3_t\taxisDefault[3];\n346\t\n347\t#define\tnanmask (255<<23)\n348\t\n349\t#define\tIS_NAN(x) (((*(int *)&x)&nanmask)==nanmask)\n350\t\n351\tfloat Q_fabs( float f );\n352\tfloat Q_rsqrt( float f );\t\t// reciprocal square root\n353\t\n354\t#define SQRTFAST( x ) ( (x) * Q_rsqrt( x ) )\n355\t\n356\tsigned char ClampChar( int i );\n357\tsigned short ClampShort( int i );\n358\t\n359\t// this isn't a real cheap function to call!\n360\tint DirToByte( vec3_t dir );\n361\tvoid ByteToDir( int b, vec3_t dir );\n362\t\n363\t#if\t1\n364\t\n365\t#define DotProduct(x,y)\t\t\t((x)[0]*(y)[0]+(x)[1]*(y)[1]+(x)[2]*(y)[2])\n366\t#define VectorSubtract(a,b,c)\t((c)[0]=(a)[0]-(b)[0],(c)[1]=(a)[1]-(b)[1],(c)[2]=(a)[2]-(b)[2])\n367\t#define VectorAdd(a,b,c)\t\t((c)[0]=(a)[0]+(b)[0],(c)[1]=(a)[1]+(b)[1],(c)[2]=(a)[2]+(b)[2])\n368\t#define VectorCopy(a,b)\t\t\t((b)[0]=(a)[0],(b)[1]=(a)[1],(b)[2]=(a)[2])\n369\t#define\tVectorScale(v, s, o)\t((o)[0]=(v)[0]*(s),(o)[1]=(v)[1]*(s),(o)[2]=(v)[2]*(s))\n370\t#define\tVectorMA(v, s, b, o)\t((o)[0]=(v)[0]+(b)[0]*(s),(o)[1]=(v)[1]+(b)[1]*(s),(o)[2]=(v)[2]+(b)[2]*(s))\n371\t\n372\t#else\n373\t\n374\t#define DotProduct(x,y)\t\t\t_DotProduct(x,y)\n375\t#define VectorSubtract(a,b,c)\t_VectorSubtract(a,b,c)\n376\t#define VectorAdd(a,b,c)\t\t_VectorAdd(a,b,c)\n377\t#define VectorCopy(a,b)\t\t\t_VectorCopy(a,b)\n378\t#define\tVectorScale(v, s, o)\t_VectorScale(v,s,o)\n379\t#define\tVectorMA(v, s, b, o)\t_VectorMA(v,s,b,o)\n380\t#endif\n381\t\n382\t#define VectorClear(a)\t\t\t((a)[0]=(a)[1]=(a)[2]=0)\n383\t#define VectorNegate(a,b)\t\t((b)[0]=-(a)[0],(b)[1]=-(a)[1],(b)[2]=-(a)[2])\n384\t#define VectorSet(v, x, y, z)\t((v)[0]=(x), (v)[1]=(y), (v)[2]=(z))\n385\t#define Vector4Copy(a,b)\t\t((b)[0]=(a)[0],(b)[1]=(a)[1],(b)[2]=(a)[2],(b)[3]=(a)[3])\n386\t\n387\t#define\tSnapVector(v) {v[0]=((int)(v[0]));v[1]=((int)(v[1]));v[2]=((int)(v[2]));}\n388\t// just in case you do't want to use the macros\n389\tvec_t _DotProduct( const vec3_t v1, const vec3_t v2 );\n390\tvoid _VectorSubtract( const vec3_t veca, const vec3_t vecb, vec3_t out );\n391\tvoid _VectorAdd( const vec3_t veca, const vec3_t vecb, vec3_t out );\n392\tvoid _VectorCopy( const vec3_t in, vec3_t out );\n393\tvoid _VectorScale( const vec3_t in, float scale, vec3_t out );\n394\tvoid _VectorMA( const vec3_t veca, float scale, const vec3_t vecb, vec3_t vecc );\n395\t\n396\tunsigned ColorBytes3 (float r, float g, float b);\n397\tunsigned ColorBytes4 (float r, float g, float b, float a);\n398\t\n399\tfloat NormalizeColor( const vec3_t in, vec3_t out );\n400\t\n401\tfloat RadiusFromBounds( const vec3_t mins, const vec3_t maxs );\n402\tvoid ClearBounds( vec3_t mins, vec3_t maxs );\n403\tvoid AddPointToBounds( const vec3_t v, vec3_t mins, vec3_t maxs );\n404\t\n405\tstatic ID_INLINE int VectorCompare( const vec3_t v1, const vec3_t v2 ) {\n406\t\tif (v1[0] != v2[0] || v1[1] != v2[1] || v1[2] != v2[2]) {\n407\t\t\treturn 0;\n408\t\t}\n409\t\treturn 1;\n410\t}\n411\t\n412\tstatic ID_INLINE vec_t VectorLength( const vec3_t v ) {\n413\t\treturn (vec_t)sqrt (v[0]*v[0] + v[1]*v[1] + v[2]*v[2]);\n414\t}\n415\t\n416\tstatic ID_INLINE vec_t VectorLengthSquared( const vec3_t v ) {\n417\t\treturn (v[0]*v[0] + v[1]*v[1] + v[2]*v[2]);\n418\t}\n419\t\n420\tstatic ID_INLINE vec_t Distance( const vec3_t p1, const vec3_t p2 ) {\n421\t\tvec3_t\tv;\n422\t\n423\t\tVectorSubtract (p2, p1, v);\n424\t\treturn VectorLength( v );\n425\t}\n426\t\n427\tstatic ID_INLINE vec_t DistanceSquared( const vec3_t p1, const vec3_t p2 ) {\n428\t\tvec3_t\tv;\n429\t\n430\t\tVectorSubtract (p2, p1, v);\n431\t\treturn v[0]*v[0] + v[1]*v[1] + v[2]*v[2];\n432\t}\n433\t\n434\t// fast vector normalize routine that does not check to make sure\n435\t// that length != 0, nor does it return length, uses rsqrt approximation\n436\tstatic ID_INLINE void VectorNormalizeFast( vec3_t v )\n437\t{\n438\t\tfloat ilength;\n439\t\n440\t\tilength = Q_rsqrt( DotProduct( v, v ) );\n441\t\n442\t\tv[0] *= ilength;\n443\t\tv[1] *= ilength;\n444\t\tv[2] *= ilength;\n445\t}\n446\t\n447\tstatic ID_INLINE void VectorInverse( vec3_t v ){\n448\t\tv[0] = -v[0];\n449\t\tv[1] = -v[1];\n450\t\tv[2] = -v[2];\n451\t}\n452\t\n453\tstatic ID_INLINE void CrossProduct( const vec3_t v1, const vec3_t v2, vec3_t cross ) {\n454\t\tcross[0] = v1[1]*v2[2] - v1[2]*v2[1];\n455\t\tcross[1] = v1[2]*v2[0] - v1[0]*v2[2];\n456\t\tcross[2] = v1[0]*v2[1] - v1[1]*v2[0];\n457\t}\n458\t\n459\tvec_t VectorNormalize (vec3_t v);\t\t// returns vector length\n460\tvec_t VectorNormalize2( const vec3_t v, vec3_t out );\n461\tvoid Vector4Scale( const vec4_t in, vec_t scale, vec4_t out );\n462\tvoid VectorRotate( vec3_t in, vec3_t matrix[3], vec3_t out );\n463\tint Q_log2(int val);\n464\t\n465\tfloat Q_acos(float c);\n466\t\n467\tint\t\tQ_rand( int *seed );\n468\tfloat\tQ_random( int *seed );\n469\tfloat\tQ_crandom( int *seed );\n470\t\n471\t#define random()\t((rand () & 0x7fff) / ((float)0x7fff))\n472\t#define crandom()\t(2.0 * (random() - 0.5))\n473\t\n474\tvoid vectoangles( const vec3_t value1, vec3_t angles);\n475\tvoid AnglesToAxis( const vec3_t angles, vec3_t axis[3] );\n476\t\n477\tvoid AxisClear( vec3_t axis[3] );\n478\tvoid AxisCopy( vec3_t in[3], vec3_t out[3] );\n479\t\n480\tvoid SetPlaneSignbits( struct cplane_s *out );\n481\tint BoxOnPlaneSide (vec3_t emins, vec3_t emaxs, struct cplane_s *plane);\n482\t\n483\tfloat\tAngleMod(float a);\n484\tfloat\tLerpAngle (float from, float to, float frac);\n485\tfloat\tAngleSubtract( float a1, float a2 );\n486\tvoid\tAnglesSubtract( vec3_t v1, vec3_t v2, vec3_t v3 );\n487\t\n488\tfloat AngleNormalize360 ( float angle );\n489\tfloat AngleNormalize180 ( float angle );\n490\tfloat AngleDelta ( float angle1, float angle2 );\n491\t\n492\tqboolean PlaneFromPoints( vec4_t plane, const vec3_t a, const vec3_t b, const vec3_t c );\n493\tvoid ProjectPointOnPlane( vec3_t dst, const vec3_t p, const vec3_t normal );\n494\tvoid RotatePointAroundVector( vec3_t dst, const vec3_t dir, const vec3_t point, float degrees );\n495\tvoid RotateAroundDirection( vec3_t axis[3], float yaw );\n496\tvoid MakeNormalVectors( const vec3_t forward, vec3_t right, vec3_t up );\n497\t// perpendicular vector could be replaced by this\n498\t\n499\t//int\tPlaneTypeForNormal (vec3_t normal);\n500\t\n501\tvoid MatrixMultiply(float in1[3][3], float in2[3][3], float out[3][3]);\n502\tvoid AngleVectors( const vec3_t angles, vec3_t forward, vec3_t right, vec3_t up);\n503\tvoid PerpendicularVector( vec3_t dst, const vec3_t src );\n504\t\n505\t\n506\t//=============================================\n507\t\n508\tfloat Com_Clamp( float min, float max, float value );\n509\t\n510\tchar\t*COM_SkipPath( char *pathname );\n511\tvoid\tCOM_StripExtension( const char *in, char *out );\n512\tvoid\tCOM_DefaultExtension( char *path, int maxSize, const char *extension );\n513\t\n514\tvoid\tCOM_BeginParseSession( const char *name );\n515\tint\t\tCOM_GetCurrentParseLine( void );\n516\tchar\t*COM_Parse( char **data_p );\n517\tchar\t*COM_ParseExt( char **data_p, qboolean allowLineBreak );\n518\tint\t\tCOM_Compress( char *data_p );\n519\tvoid\tCOM_ParseError( char *format, ... );\n520\tvoid\tCOM_ParseWarning( char *format, ... );\n521\t//int\t\tCOM_ParseInfos( char *buf, int max, char infos[][MAX_INFO_STRING] );\n522\t\n523\t#define MAX_TOKENLENGTH\t\t1024\n524\t\n525\t#ifndef TT_STRING\n526\t//token types\n527\t#define TT_STRING\t\t\t\t\t1\t\t\t// string\n528\t#define TT_LITERAL\t\t\t\t\t2\t\t\t// literal\n529\t#define TT_NUMBER\t\t\t\t\t3\t\t\t// number\n530\t#define TT_NAME\t\t\t\t\t\t4\t\t\t// name\n531\t#define TT_PUNCTUATION\t\t\t\t5\t\t\t// punctuation\n532\t#endif\n533\t\n534\ttypedef struct pc_token_s\n535\t{\n536\t\tint type;\n537\t\tint subtype;\n538\t\tint intvalue;\n539\t\tfloat floatvalue;\n540\t\tchar string[MAX_TOKENLENGTH];\n541\t} pc_token_t;\n542\t\n543\t// data is an in/out parm, returns a parsed out token\n544\t\n545\tvoid\tCOM_MatchToken( char**buf_p, char *match );\n546\t\n547\tvoid SkipBracedSection (char **program);\n548\tvoid SkipRestOfLine ( char **data );\n549\t\n550\tvoid Parse1DMatrix (char **buf_p, int x, float *m);\n551\tvoid Parse2DMatrix (char **buf_p, int y, int x, float *m);\n552\tvoid Parse3DMatrix (char **buf_p, int z, int y, int x, float *m);\n553\t\n554\tvoid\tQDECL Com_sprintf (char *dest, int size, const char *fmt, ...);\n555\t\n556\t\n557\t// mode parm for FS_FOpenFile\n558\ttypedef enum {\n559\t\tFS_READ,\n560\t\tFS_WRITE,\n561\t\tFS_APPEND,\n562\t\tFS_APPEND_SYNC\n563\t} fsMode_t;\n564\t\n565\ttypedef enum {\n566\t\tFS_SEEK_CUR,\n567\t\tFS_SEEK_END,\n568\t\tFS_SEEK_SET\n569\t} fsOrigin_t;\n570\t\n571\t//=============================================\n572\t\n573\tint Q_isprint( int c );\n574\tint Q_islower( int c );\n575\tint Q_isupper( int c );\n576\tint Q_isalpha( int c );\n577\t\n578\t// portable case insensitive compare\n579\tint\t\tQ_stricmp (const char *s1, const char *s2);\n580\tint\t\tQ_strncmp (const char *s1, const char *s2, int n);\n581\tint\t\tQ_stricmpn (const char *s1, const char *s2, int n);\n582\tchar\t*Q_strlwr( char *s1 );\n583\tchar\t*Q_strupr( char *s1 );\n584\tchar\t*Q_strrchr( const char* string, int c );\n585\t\n586\t// buffer size safe library replacements\n587\tvoid\tQ_strncpyz( char *dest, const char *src, int destsize );\n588\tvoid\tQ_strcat( char *dest, int size, const char *src );\n589\t\n590\t// strlen that discounts Quake color sequences\n591\tint Q_PrintStrlen( const char *string );\n592\t// removes color sequences from string\n593\tchar *Q_CleanStr( char *string );\n594\t\n595\t//=============================================\n596\t\n597\t// 64-bit integers for global rankings interface\n598\t// implemented as a struct for qvm compatibility\n599\ttypedef struct\n600\t{\n601\t\tbyte\tb0;\n602\t\tbyte\tb1;\n603\t\tbyte\tb2;\n604\t\tbyte\tb3;\n605\t\tbyte\tb4;\n606\t\tbyte\tb5;\n607\t\tbyte\tb6;\n608\t\tbyte\tb7;\n609\t} qint64;\n610\t\n611\t//=============================================\n612\t/*\n613\tshort\tBigShort(short l);\n614\tshort\tLittleShort(short l);\n615\tint\t\tBigLong (int l);\n616\tint\t\tLittleLong (int l);\n617\tqint64  BigLong64 (qint64 l);\n618\tqint64  LittleLong64 (qint64 l);\n619\tfloat\tBigFloat (const float *l);\n620\tfloat\tLittleFloat (const float *l);\n621\t\n622\tvoid\tSwap_Init (void);\n623\t*/\n624\tchar\t* QDECL va(char *format, ...);\n625\t\n626\t//=============================================\n627\t\n628\t//\n629\t// key / value info strings\n630\t//\n631\tchar *Info_ValueForKey( const char *s, const char *key );\n632\tvoid Info_RemoveKey( char *s, const char *key );\n633\tvoid Info_RemoveKey_big( char *s, const char *key );\n634\tvoid Info_SetValueForKey( char *s, const char *key, const char *value );\n635\tvoid Info_SetValueForKey_Big( char *s, const char *key, const char *value );\n636\tqboolean Info_Validate( const char *s );\n637\tvoid Info_NextPair( const char **s, char *key, char *value );\n638\t\n639\t// this is only here so the functions in q_shared.c and bg_*.c can link\n640\tvoid\tQDECL Com_Error( int level, const char *error, ... );\n641\tvoid\tQDECL Com_Printf( const char *msg, ... );\n642\t\n643\t\n644\t/*\n645\t==========================================================\n646\t\n647\tCVARS (console variables)\n648\t\n649\tMany variables can be used for cheating purposes, so when\n650\tcheats is zero, force all unspecified variables to their\n651\tdefault values.\n652\t==========================================================\n653\t*/\n654\t\n655\t#define\tCVAR_ARCHIVE\t\t1\t// set to cause it to be saved to vars.rc\n656\t\t\t\t\t\t\t\t\t// used for system variables, not for player\n657\t\t\t\t\t\t\t\t\t// specific configurations\n658\t#define\tCVAR_USERINFO\t\t2\t// sent to server on connect or change\n659\t#define\tCVAR_SERVERINFO\t\t4\t// sent in response to front end requests\n660\t#define\tCVAR_SYSTEMINFO\t\t8\t// these cvars will be duplicated on all clients\n661\t#define\tCVAR_INIT\t\t\t16\t// don't allow change from console at all,\n662\t\t\t\t\t\t\t\t\t// but can be set from the command line\n663\t#define\tCVAR_LATCH\t\t\t32\t// will only change when C code next does\n664\t\t\t\t\t\t\t\t\t// a Cvar_Get(), so it can't be changed\n665\t\t\t\t\t\t\t\t\t// without proper initialization.  modified\n666\t\t\t\t\t\t\t\t\t// will be set, even though the value hasn't\n667\t\t\t\t\t\t\t\t\t// changed yet\n668\t#define\tCVAR_ROM\t\t\t64\t// display only, cannot be set by user at all\n669\t#define\tCVAR_USER_CREATED\t128\t// created by a set command\n670\t#define\tCVAR_TEMP\t\t\t256\t// can be set even when cheats are disabled, but is not archived\n671\t#define CVAR_CHEAT\t\t\t512\t// can not be changed if cheats are disabled\n672\t#define CVAR_NORESTART\t\t1024\t// do not clear when a cvar_restart is issued\n673\t\n674\t// nothing outside the Cvar_*() functions should modify these fields!\n675\ttypedef struct cvar_s {\n676\t\tchar\t\t*name;\n677\t\tchar\t\t*string;\n678\t\tchar\t\t*resetString;\t\t// cvar_restart will reset to this value\n679\t\tchar\t\t*latchedString;\t\t// for CVAR_LATCH vars\n680\t\tint\t\t\tflags;\n681\t\tqboolean\tmodified;\t\t\t// set each time the cvar is changed\n682\t\tint\t\t\tmodificationCount;\t// incremented each time the cvar is changed\n683\t\tfloat\t\tvalue;\t\t\t\t// atof( string )\n684\t\tint\t\t\tinteger;\t\t\t// atoi( string )\n685\t\tstruct cvar_s *next;\n686\t\tstruct cvar_s *hashNext;\n687\t} cvar_t;\n688\t\n689\t#define\tMAX_CVAR_VALUE_STRING\t256\n690\t\n691\ttypedef int\tcvarHandle_t;\n692\t\n693\t// the modules that run in the virtual machine can't access the cvar_t directly,\n694\t// so they must ask for structured updates\n695\ttypedef struct {\n696\t\tcvarHandle_t\thandle;\n697\t\tint\t\t\tmodificationCount;\n698\t\tfloat\t\tvalue;\n699\t\tint\t\t\tinteger;\n700\t\tchar\t\tstring[MAX_CVAR_VALUE_STRING];\n701\t} vmCvar_t;\n702\t\n703\t/*\n704\t==============================================================\n705\t\n706\tCOLLISION DETECTION\n707\t\n708\t==============================================================\n709\t*/\n710\t\n711\t#include \"surfaceflags.h\"\t\t\t// shared with the q3map utility\n712\t\n713\t// plane types are used to speed some tests\n714\t// 0-2 are axial planes\n715\t#define\tPLANE_X\t\t\t0\n716\t#define\tPLANE_Y\t\t\t1\n717\t#define\tPLANE_Z\t\t\t2\n718\t#define\tPLANE_NON_AXIAL\t3\n719\t\n720\t\n721\t/*\n722\t=================\n723\tPlaneTypeForNormal\n724\t=================\n725\t*/\n726\t\n727\t#define PlaneTypeForNormal(x) (x[0] == 1.0 ? PLANE_X : (x[1] == 1.0 ? PLANE_Y : (x[2] == 1.0 ? PLANE_Z : PLANE_NON_AXIAL) ) )\n728\t\n729\t// plane_t structure\n730\t// !!! if this is changed, it must be changed in asm code too !!!\n731\ttypedef struct cplane_s {\n732\t\tvec3_t\tnormal;\n733\t\tfloat\tdist;\n734\t\tbyte\ttype;\t\t\t// for fast side tests: 0,1,2 = axial, 3 = nonaxial\n735\t\tbyte\tsignbits;\t\t// signx + (signy<<1) + (signz<<2), used as lookup during collision\n736\t\tbyte\tpad[2];\n737\t} cplane_t;\n738\t\n739\t\n740\t// a trace is returned when a box is swept through the world\n741\ttypedef struct {\n742\t\tqboolean\tallsolid;\t// if true, plane is not valid\n743\t\tqboolean\tstartsolid;\t// if true, the initial point was in a solid area\n744\t\tfloat\t\tfraction;\t// time completed, 1.0 = didn't hit anything\n745\t\tvec3_t\t\tendpos;\t\t// final position\n746\t\tcplane_t\tplane;\t\t// surface normal at impact, transformed to world space\n747\t\tint\t\t\tsurfaceFlags;\t// surface hit\n748\t\tint\t\t\tcontents;\t// contents on other side of surface hit\n749\t\tint\t\t\tentityNum;\t// entity the contacted sirface is a part of\n750\t} trace_t;\n751\t\n752\t// trace->entityNum can also be 0 to (MAX_GENTITIES-1)\n753\t// or ENTITYNUM_NONE, ENTITYNUM_WORLD\n754\t\n755\t\n756\t// markfragments are returned by CM_MarkFragments()\n757\ttypedef struct {\n758\t\tint\t\tfirstPoint;\n759\t\tint\t\tnumPoints;\n760\t} markFragment_t;\n761\t\n762\t\n763\t\n764\ttypedef struct {\n765\t\tvec3_t\t\torigin;\n766\t\tvec3_t\t\taxis[3];\n767\t} orientation_t;\n768\t\n769\t//=====================================================================\n770\t\n771\t\n772\t// in order from highest priority to lowest\n773\t// if none of the catchers are active, bound key strings will be executed\n774\t#define KEYCATCH_CONSOLE\t\t0x0001\n775\t#define\tKEYCATCH_UI\t\t\t\t\t0x0002\n776\t#define\tKEYCATCH_MESSAGE\t\t0x0004\n777\t#define\tKEYCATCH_CGAME\t\t\t0x0008\n778\t\n779\t\n780\t// sound channels\n781\t// channel 0 never willingly overrides\n782\t// other channels will allways override a playing sound on that channel\n783\ttypedef enum {\n784\t\tCHAN_AUTO,\n785\t\tCHAN_LOCAL,\t\t// menu sounds, etc\n786\t\tCHAN_WEAPON,\n787\t\tCHAN_VOICE,\n788\t\tCHAN_ITEM,\n789\t\tCHAN_BODY,\n790\t\tCHAN_LOCAL_SOUND,\t// chat messages, etc\n791\t\tCHAN_ANNOUNCER\t\t// announcer voices, etc\n792\t} soundChannel_t;\n793\t\n794\t\n795\t/*\n796\t========================================================================\n797\t\n798\t  ELEMENTS COMMUNICATED ACROSS THE NET\n799\t\n800\t========================================================================\n801\t*/\n802\t\n803\t#define\tANGLE2SHORT(x)\t((int)((x)*65536/360) & 65535)\n804\t#define\tSHORT2ANGLE(x)\t((x)*(360.0/65536))\n805\t\n806\t#define\tSNAPFLAG_RATE_DELAYED\t1\n807\t#define\tSNAPFLAG_NOT_ACTIVE\t\t2\t// snapshot used during connection and for zombies\n808\t#define SNAPFLAG_SERVERCOUNT\t4\t// toggled every map_restart so transitions can be detected\n809\t\n810\t//\n811\t// per-level limits\n812\t//\n813\t#define\tMAX_CLIENTS\t\t\t64\t\t// absolute limit\n814\t#define MAX_LOCATIONS\t\t64\n815\t\n816\t#define\tGENTITYNUM_BITS\t\t10\t\t// don't need to send any more\n817\t#define\tMAX_GENTITIES\t\t(1<<GENTITYNUM_BITS)\n818\t\n819\t// entitynums are communicated with GENTITY_BITS, so any reserved\n820\t// values that are going to be communcated over the net need to\n821\t// also be in this range\n822\t#define\tENTITYNUM_NONE\t\t(MAX_GENTITIES-1)\n823\t#define\tENTITYNUM_WORLD\t\t(MAX_GENTITIES-2)\n824\t#define\tENTITYNUM_MAX_NORMAL\t(MAX_GENTITIES-2)\n825\t\n826\t\n827\t#define\tMAX_MODELS\t\t\t256\t\t// these are sent over the net as 8 bits\n828\t#define\tMAX_SOUNDS\t\t\t256\t\t// so they cannot be blindly increased\n829\t\n830\t\n831\t#define\tMAX_CONFIGSTRINGS\t1024\n832\t\n833\t// these are the only configstrings that the system reserves, all the\n834\t// other ones are strictly for servergame to clientgame communication\n835\t#define\tCS_SERVERINFO\t\t0\t\t// an info string with all the serverinfo cvars\n836\t#define\tCS_SYSTEMINFO\t\t1\t\t// an info string for server system to client system configuration (timescale, etc)\n837\t\n838\t#define\tRESERVED_CONFIGSTRINGS\t2\t// game can't modify below this, only the system can\n839\t\n840\t#define\tMAX_GAMESTATE_CHARS\t16000\n841\ttypedef struct {\n842\t\tint\t\t\tstringOffsets[MAX_CONFIGSTRINGS];\n843\t\tchar\t\tstringData[MAX_GAMESTATE_CHARS];\n844\t\tint\t\t\tdataCount;\n845\t} gameState_t;\n846\t\n847\t//=========================================================\n848\t\n849\t// bit field limits\n850\t#define\tMAX_STATS\t\t\t\t16\n851\t#define\tMAX_PERSISTANT\t\t\t16\n852\t#define\tMAX_POWERUPS\t\t\t16\n853\t#define\tMAX_WEAPONS\t\t\t\t16\n854\t\n855\t#define\tMAX_PS_EVENTS\t\t\t2\n856\t\n857\t#define PS_PMOVEFRAMECOUNTBITS\t6\n858\t\n859\t// playerState_t is the information needed by both the client and server\n860\t// to predict player motion and actions\n861\t// nothing outside of pmove should modify these, or some degree of prediction error\n862\t// will occur\n863\t\n864\t// you can't add anything to this without modifying the code in msg.c\n865\t\n866\t// playerState_t is a full superset of entityState_t as it is used by players,\n867\t// so if a playerState_t is transmitted, the entityState_t can be fully derived\n868\t// from it.\n869\ttypedef struct playerState_s {\n870\t\tint\t\t\tcommandTime;\t// cmd->serverTime of last executed command\n871\t\tint\t\t\tpm_type;\n872\t\tint\t\t\tbobCycle;\t\t// for view bobbing and footstep generation\n873\t\tint\t\t\tpm_flags;\t\t// ducked, jump_held, etc\n874\t\tint\t\t\tpm_time;\n875\t\n876\t\tvec3_t\t\torigin;\n877\t\tvec3_t\t\tvelocity;\n878\t\tint\t\t\tweaponTime;\n879\t\tint\t\t\tgravity;\n880\t\tint\t\t\tspeed;\n881\t\tint\t\t\tdelta_angles[3];\t// add to command angles to get view direction\n882\t\t\t\t\t\t\t\t\t\t// changed by spawns, rotating objects, and teleporters\n883\t\n884\t\tint\t\t\tgroundEntityNum;// ENTITYNUM_NONE = in air\n885\t\n886\t\tint\t\t\tlegsTimer;\t\t// don't change low priority animations until this runs out\n887\t\tint\t\t\tlegsAnim;\t\t// mask off ANIM_TOGGLEBIT\n888\t\n889\t\tint\t\t\ttorsoTimer;\t\t// don't change low priority animations until this runs out\n890\t\tint\t\t\ttorsoAnim;\t\t// mask off ANIM_TOGGLEBIT\n891\t\n892\t\tint\t\t\tmovementDir;\t// a number 0 to 7 that represents the reletive angle\n893\t\t\t\t\t\t\t\t\t// of movement to the view angle (axial and diagonals)\n894\t\t\t\t\t\t\t\t\t// when at rest, the value will remain unchanged\n895\t\t\t\t\t\t\t\t\t// used to twist the legs during strafing\n896\t\n897\t\tvec3_t\t\tgrapplePoint;\t// location of grapple to pull towards if PMF_GRAPPLE_PULL\n898\t\n899\t\tint\t\t\teFlags;\t\t\t// copied to entityState_t->eFlags\n900\t\n901\t\tint\t\t\teventSequence;\t// pmove generated events\n902\t\tint\t\t\tevents[MAX_PS_EVENTS];\n903\t\tint\t\t\teventParms[MAX_PS_EVENTS];\n904\t\n905\t\tint\t\t\texternalEvent;\t// events set on player from another source\n906\t\tint\t\t\texternalEventParm;\n907\t\tint\t\t\texternalEventTime;\n908\t\n909\t\tint\t\t\tclientNum;\t\t// ranges from 0 to MAX_CLIENTS-1\n910\t\tint\t\t\tweapon;\t\t\t// copied to entityState_t->weapon\n911\t\tint\t\t\tweaponstate;\n912\t\n913\t\tvec3_t\t\tviewangles;\t\t// for fixed views\n914\t\tint\t\t\tviewheight;\n915\t\n916\t\t// damage feedback\n917\t\tint\t\t\tdamageEvent;\t// when it changes, latch the other parms\n918\t\tint\t\t\tdamageYaw;\n919\t\tint\t\t\tdamagePitch;\n920\t\tint\t\t\tdamageCount;\n921\t\n922\t\tint\t\t\tstats[MAX_STATS];\n923\t\tint\t\t\tpersistant[MAX_PERSISTANT];\t// stats that aren't cleared on death\n924\t\tint\t\t\tpowerups[MAX_POWERUPS];\t// level.time that the powerup runs out\n925\t\tint\t\t\tammo[MAX_WEAPONS];\n926\t\n927\t\tint\t\t\tgeneric1;\n928\t\tint\t\t\tloopSound;\n929\t\tint\t\t\tjumppad_ent;\t// jumppad entity hit this frame\n930\t\n931\t\t// not communicated over the net at all\n932\t\tint\t\t\tping;\t\t\t// server to game info for scoreboard\n933\t\tint\t\t\tpmove_framecount;\t// FIXME: don't transmit over the network\n934\t\tint\t\t\tjumppad_frame;\n935\t\tint\t\t\tentityEventSequence;\n936\t} playerState_t;\n937\t\n938\t\n939\t//====================================================================\n940\t\n941\t\n942\t//\n943\t// usercmd_t->button bits, many of which are generated by the client system,\n944\t// so they aren't game/cgame only definitions\n945\t//\n946\t#define\tBUTTON_ATTACK\t\t1\n947\t#define\tBUTTON_TALK\t\t\t2\t\t\t// displays talk balloon and disables actions\n948\t#define\tBUTTON_USE_HOLDABLE\t4\n949\t#define\tBUTTON_GESTURE\t\t8\n950\t#define\tBUTTON_WALKING\t\t16\t\t\t// walking can't just be infered from MOVE_RUN\n951\t\t\t\t\t\t\t\t\t\t\t// because a key pressed late in the frame will\n952\t\t\t\t\t\t\t\t\t\t\t// only generate a small move value for that frame\n953\t\t\t\t\t\t\t\t\t\t\t// walking will use different animations and\n954\t\t\t\t\t\t\t\t\t\t\t// won't generate footsteps\n955\t#define BUTTON_AFFIRMATIVE\t32\n956\t#define\tBUTTON_NEGATIVE\t\t64\n957\t\n958\t#define BUTTON_GETFLAG\t\t128\n959\t#define BUTTON_GUARDBASE\t256\n960\t#define BUTTON_PATROL\t\t512\n961\t#define BUTTON_FOLLOWME\t\t1024\n962\t\n963\t#define\tBUTTON_ANY\t\t\t2048\t\t\t// any key whatsoever\n964\t\n965\t#define\tMOVE_RUN\t\t\t120\t\t\t// if forwardmove or rightmove are >= MOVE_RUN,\n966\t\t\t\t\t\t\t\t\t\t\t// then BUTTON_WALKING should be set\n967\t\n968\t// usercmd_t is sent to the server each client frame\n969\ttypedef struct usercmd_s {\n970\t\tint\t\t\t\tserverTime;\n971\t\tint\t\t\t\tangles[3];\n972\t\tint \t\t\tbuttons;\n973\t\tbyte\t\t\tweapon;           // weapon\n974\t\tsigned char\tforwardmove, rightmove, upmove;\n975\t} usercmd_t;\n976\t\n977\t//===================================================================\n978\t\n979\t// if entityState->solid == SOLID_BMODEL, modelindex is an inline model number\n980\t#define\tSOLID_BMODEL\t0xffffff\n981\t\n982\ttypedef enum {\n983\t\tTR_STATIONARY,\n984\t\tTR_INTERPOLATE,\t\t\t\t// non-parametric, but interpolate between snapshots\n985\t\tTR_LINEAR,\n986\t\tTR_LINEAR_STOP,\n987\t\tTR_SINE,\t\t\t\t\t// value = base + sin( time / duration ) * delta\n988\t\tTR_GRAVITY\n989\t} trType_t;\n990\t\n991\ttypedef struct {\n992\t\ttrType_t\ttrType;\n993\t\tint\t\ttrTime;\n994\t\tint\t\ttrDuration;\t\t\t// if non 0, trTime + trDuration = stop time\n995\t\tvec3_t\ttrBase;\n996\t\tvec3_t\ttrDelta;\t\t\t// velocity, etc\n997\t} trajectory_t;\n998\t\n999\t// entityState_t is the information conveyed from the server\n1000\t// in an update message about entities that the client will\n1001\t// need to render in some way\n1002\t// Different eTypes may use the information in different ways\n1003\t// The messages are delta compressed, so it doesn't really matter if\n1004\t// the structure size is fairly large\n1005\t\n1006\ttypedef struct entityState_s {\n1007\t\tint\t\tnumber;\t\t\t// entity index\n1008\t\tint\t\teType;\t\t\t// entityType_t\n1009\t\tint\t\teFlags;\n1010\t\n1011\t\ttrajectory_t\tpos;\t// for calculating position\n1012\t\ttrajectory_t\tapos;\t// for calculating angles\n1013\t\n1014\t\tint\t\ttime;\n1015\t\tint\t\ttime2;\n1016\t\n1017\t\tvec3_t\torigin;\n1018\t\tvec3_t\torigin2;\n1019\t\n1020\t\tvec3_t\tangles;\n1021\t\tvec3_t\tangles2;\n1022\t\n1023\t\tint\t\totherEntityNum;\t// shotgun sources, etc\n1024\t\tint\t\totherEntityNum2;\n1025\t\n1026\t\tint\t\tgroundEntityNum;\t// -1 = in air\n1027\t\n1028\t\tint\t\tconstantLight;\t// r + (g<<8) + (b<<16) + (intensity<<24)\n1029\t\tint\t\tloopSound;\t\t// constantly loop this sound\n1030\t\n1031\t\tint\t\tmodelindex;\n1032\t\tint\t\tmodelindex2;\n1033\t\tint\t\tclientNum;\t\t// 0 to (MAX_CLIENTS - 1), for players and corpses\n1034\t\tint\t\tframe;\n1035\t\n1036\t\tint\t\tsolid;\t\t\t// for client side prediction, trap_linkentity sets this properly\n1037\t\n1038\t\tint\t\tevent;\t\t\t// impulse events -- muzzle flashes, footsteps, etc\n1039\t\tint\t\teventParm;\n1040\t\n1041\t\t// for players\n1042\t\tint\t\tpowerups;\t\t// bit flags\n1043\t\tint\t\tweapon;\t\t\t// determines weapon and flash model, etc\n1044\t\tint\t\tlegsAnim;\t\t// mask off ANIM_TOGGLEBIT\n1045\t\tint\t\ttorsoAnim;\t\t// mask off ANIM_TOGGLEBIT\n1046\t\n1047\t\tint\t\tgeneric1;\n1048\t} entityState_t;\n1049\t\n1050\ttypedef enum {\n1051\t\tCA_UNINITIALIZED,\n1052\t\tCA_DISCONNECTED, \t// not talking to a server\n1053\t\tCA_AUTHORIZING,\t\t// not used any more, was checking cd key\n1054\t\tCA_CONNECTING,\t\t// sending request packets to the server\n1055\t\tCA_CHALLENGING,\t\t// sending challenge packets to the server\n1056\t\tCA_CONNECTED,\t\t// netchan_t established, getting gamestate\n1057\t\tCA_LOADING,\t\t\t// only during cgame initialization, never during main loop\n1058\t\tCA_PRIMED,\t\t\t// got gamestate, waiting for first frame\n1059\t\tCA_ACTIVE,\t\t\t// game views should be displayed\n1060\t\tCA_CINEMATIC\t\t// playing a cinematic or a static pic, not connected to a server\n1061\t} connstate_t;\n1062\t\n1063\t// font support\n1064\t\n1065\t#define GLYPH_START 0\n1066\t#define GLYPH_END 255\n1067\t#define GLYPH_CHARSTART 32\n1068\t#define GLYPH_CHAREND 127\n1069\t#define GLYPHS_PER_FONT GLYPH_END - GLYPH_START + 1\n1070\ttypedef struct {\n1071\t  int height;       // number of scan lines\n1072\t  int top;          // top of glyph in buffer\n1073\t  int bottom;       // bottom of glyph in buffer\n1074\t  int pitch;        // width for copying\n1075\t  int xSkip;        // x adjustment\n1076\t  int imageWidth;   // width of actual image\n1077\t  int imageHeight;  // height of actual image\n1078\t  float s;          // x offset in image where glyph starts\n1079\t  float t;          // y offset in image where glyph starts\n1080\t  float s2;\n1081\t  float t2;\n1082\t  qhandle_t glyph;  // handle to the shader with the glyph\n1083\t  char shaderName[32];\n1084\t} glyphInfo_t;\n1085\t\n1086\t