) -> (F,F);  both_w::<F>(name) -> (F,F)\n  cdata::<T>(name) -> *mut T;  rdata::<T>(name) -> *mut T\n  assert_f32 assert_f64 assert_vec assert_int check_f32 check_vec\n  INTERESTING: &[f32]\n  Rng::new(seed): next_u32, below(n), bool(), f32_any(), f32_finite(), f32_mag(mag),\n    f32_unit(), vec3_any(), vec3_finite(), vec3_mag(mag), dir(), i32_any()\n\nC TYPES / SIGNATURES:\n  typedef struct cplane_s { vec3_t normal; float dist; byte type; byte signbits;\n                            byte pad[2]; } cplane_t;   // 20 bytes\n  Declare it yourself in the test file as\n    #[repr(C)] #[derive(Clone,Copy,Debug,Default)]\n    struct CPlane { normal: [f32;3], dist: f32, type_: u8, signbits: u8, pad: [u8;2] }\n  int  PlaneFromPoints(vec4_t plane, const vec3_t a, const vec3_t b, const vec3_t c);\n       // returns qboolean (int) 0/1; writes plane[0..3], but plane[3] only on success\n  void SetPlaneSignbits(cplane_t *out);\n  int  BoxOnPlaneSide(vec3_t emins, vec3_t emaxs, struct cplane_s *p);\n  int  DirToByte(vec3_t dir);      // dir may be NULL -> returns 0\n  void ByteToDir(int b, vec3_t dir);\n  void w_CrossProduct(const vec3_t v1, const vec3_t v2, vec3_t cross);\n\nTEST FUNCTIONS TO WRITE (names EXACTLY these; referenced by CONFIGS.md 39-44, 48-49):\n  cross_product                    (row 39: all 9 ordered pairs of axis vectors,\n                                    parallel vectors, the same pointer twice, zero,\n                                    random, NaN, plus cross aliasing v1 or v2)\n  plane_from_points                (row 40: many non-degenerate random triangles\n                                    (must return 1) and degenerate ones: a==b,\n                                    b==c, a==c, all three equal, collinear points,\n                                    huge coordinates that overflow, NaN. Compare\n                                    the return value AND all four plane floats;\n                                    pre-fill the plane buffer with a sentinel so\n                                    \"plane[3] not written on failure\" is detected.)\n  set_plane_signbits               (row 41: all 8 sign combinations of normal,\n                                    -0.0 components, NaN components, random\n                                    normals, and a pre-set signbits value that\n                                    must be overwritten. Compare the WHOLE 20-byte\n                                    struct afterwards, not just signbits.)\n  box_on_plane_side_axial          (row 42: type = 0,1,2 and dist/emins/emaxs\n                                    arranged to hit each of the returns 1, 2 and 3)\n  box_on_plane_side_general        (row 43: type = 3 crossed with signbits = 0..7,\n                                    with random boxes and planes; make sure the\n                                    result values 0,1,2,3 all occur - count them\n                                    and assert each was seen)\n  box_on_plane_side_type_out_of_range   (row 44a: type = 3..255 x signbits 0..7)\n  box_on_plane_side_invalid_signbits    (row 44b: signbits = 8..255, i.e. the\n                                    `default:` branch where dist1=dist2=0; cross\n                                    with dist < 0, == 0, > 0, NaN)\n  box_on_plane_side_nan            (ERRORS.md row 22: NaN in emins/emaxs/dist ->\n                                    both comparisons false -> returns 0)\n  dir_to_byte                      (row 48: every one of the 162 bytedirs entries\n                                    read out of the C .so's `bytedirs` symbol via\n                                    cdata::<[[f32;3];162]>(\"bytedirs\"), their\n                                    negations, zero vector, random vectors, inf,\n                                    NaN, 20000 random)\n  byte_to_dir                      (row 49: b = 0..161, -1, 162, 163, INT_MIN,\n                                    INT_MAX; pre-fill dir with a sentinel)\n\nNotes:\n- `BoxOnPlaneSide` reads `p->type` (a byte!) and indexes emins[p->type] only when\n  type < 3, so type >= 3 is a normal input, not UB.\n- Initialise C and Rust output buffers identically so \"not written\" is caught.\n- Do not pass NULL to anything except DirToByte (other functions dereference\n  unconditionally and would crash the test process).\n\nWORKFLOW: write the file, then run\n  cd /local/home/scheschb/.harvest/work/harvest-work-MbXgVZ/translated_rust\n  ./build_c.sh >/dev/null && cargo build --offline 2>&1 | tail -3\n  timeout 600 cargo test --offline --test planes 2>&1 | tail -40\nIterate until it compiles. Report the final test summary, the list of test fns,\nand any divergence (exact inputs + bit patterns) WITHOUT fixing src/.","uuid":"28463ec0-0c3a-495e-b771-4e67aed7df77","session_id":"bf9d36cb-13a4-40a8-a93d-48ad7b006df9"}
