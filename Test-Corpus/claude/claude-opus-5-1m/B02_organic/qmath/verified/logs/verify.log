203\t}\n204\t\n205\tvoid ByteToDir( int b, vec3_t dir ) {\n206\t\tif ( b < 0 || b >= NUMVERTEXNORMALS ) {\n207\t\t\tVectorCopy( vec3_origin, dir );\n208\t\t\treturn;\n209\t\t}\n210\t\tVectorCopy (bytedirs[b], dir);\n211\t}\n212\t\n213\t\n214\tunsigned ColorBytes3 (float r, float g, float b) {\n215\t\tunsigned\ti;\n216\t\n217\t\t( (byte *)&i )[0] = r * 255;\n218\t\t( (byte *)&i )[1] = g * 255;\n219\t\t( (byte *)&i )[2] = b * 255;\n220\t\n221\t\treturn i;\n222\t}\n223\t\n224\tunsigned ColorBytes4 (float r, float g, float b, float a) {\n225\t\tunsigned\ti;\n226\t\n227\t\t( (byte *)&i )[0] = r * 255;\n228\t\t( (byte *)&i )[1] = g * 255;\n229\t\t( (byte *)&i )[2] = b * 255;\n230\t\t( (byte *)&i )[3] = a * 255;\n231\t\n232\t\treturn i;\n233\t}\n234\t\n235\tfloat NormalizeColor( const vec3_t in, vec3_t out ) {\n236\t\tfloat\tmax;\n237\t\n238\t\tmax = in[0];\n239\t\tif ( in[1] > max ) {\n240\t\t\tmax = in[1];\n241\t\t}\n242\t\tif ( in[2] > max ) {\n243\t\t\tmax = in[2];\n244\t\t}\n245\t\n246\t\tif ( !max ) {\n247\t\t\tVectorClear( out );\n248\t\t} else {\n249\t\t\tout[0] = in[0] / max;\n250\t\t\tout[1] = in[1] / max;\n251\t\t\tout[2] = in[2] / max;\n252\t\t}\n253\t\treturn max;\n254\t}\n255\t\n256\t\n257\t/*\n258\t=====================\n259\tPlaneFromPoints\n260\t\n261\tReturns false if the triangle is degenrate.\n262\tThe normal will point out of the clock for clockwise ordered points\n263\t=====================\n264\t*/\n265\tqboolean PlaneFromPoints( vec4_t plane, const vec3_t a, const vec3_t b, const vec3_t c ) {\n266\t\tvec3_t\td1, d2;\n267\t\n268\t\tVectorSubtract( b, a, d1 );\n269\t\tVectorSubtract( c, a, d2 );\n270\t\tCrossProduct( d2, d1, plane );\n271\t\tif ( VectorNormalize( plane ) == 0 ) {\n272\t\t\treturn qfalse;\n273\t\t}\n274\t\n275\t\tplane[3] = DotProduct( a, plane );\n276\t\treturn qtrue;\n277\t}\n278\t\n279\t/*\n280\t===============\n281\tRotatePointAroundVector\n282\t\n283\tThis is not implemented very well...\n284\t===============\n285\t*/\n286\tvoid RotatePointAroundVector( vec3_t dst, const vec3_t dir, const vec3_t point,\n287\t\t\t\t\t\t\t\t float degrees ) {\n288\t\tfloat\tm[3][3];\n289\t\tfloat\tim[3][3];\n290\t\tfloat\tzrot[3][3];\n291\t\tfloat\ttmpmat[3][3];\n292\t\tfloat\trot[3][3];\n293\t\tint\ti;\n294\t\tvec3_t vr, vup, vf;\n295\t\tfloat\trad;\n296\t\n297\t\tvf[0] = dir[0];\n298\t\tvf[1] = dir[1];\n299\t\tvf[2] = dir[2];\n300\t\n301\t\tPerpendicularVector( vr, dir );\n302\t\tCrossProduct( vr, vf, vup );\n303\t\n304\t\tm[0][0] = vr[0];\n305\t\tm[1][0] = vr[1];\n306\t\tm[2][0] = vr[2];\n307\t\n308\t\tm[0][1] = vup[0];\n309\t\tm[1][1] = vup[1];\n310\t\tm[2][1] = vup[2];\n311\t\n312\t\tm[0][2] = vf[0];\n313\t\tm[1][2] = vf[1];\n314\t\tm[2][2] = vf[2];\n315\t\n316\t\tmemcpy( im, m, sizeof( im ) );\n317\t\n318\t\tim[0][1] = m[1][0];\n319\t\tim[0][2] = m[2][0];\n320\t\tim[1][0] = m[0][1];\n321\t\tim[1][2] = m[2][1];\n322\t\tim[2][0] = m[0][2];\n323\t\tim[2][1] = m[1][2];\n324\t\n325\t\tmemset( zrot, 0, sizeof( zrot ) );\n326\t\tzrot[0][0] = zrot[1][1] = zrot[2][2] = 1.0F;\n327\t\n328\t\trad = DEG2RAD( degrees );\n329\t\tzrot[0][0] = cos( rad );\n330\t\tzrot[0][1] = sin( rad );\n331\t\tzrot[1][0] = -sin( rad );\n332\t\tzrot[1][1] = cos( rad );\n333\t\n334\t\tMatrixMultiply( m, zrot, tmpmat );\n335\t\tMatrixMultiply( tmpmat, im, rot );\n336\t\n337\t\tfor ( i = 0; i < 3; i++ ) {\n338\t\t\tdst[i] = rot[i][0] * point[0] + rot[i][1] * point[1] + rot[i][2] * point[2];\n339\t\t}\n340\t}\n341\t\n342\t/*\n343\t===============\n344\tRotateAroundDirection\n345\t===============\n346\t*/\n347\tvoid RotateAroundDirection( vec3_t axis[3], float yaw ) {\n348\t\n349\t\t// create an arbitrary axis[1]\n350\t\tPerpendicularVector( axis[1], axis[0] );\n351\t\n352\t\t// rotate it around axis[0] by yaw\n353\t\tif ( yaw ) {\n354\t\t\tvec3_t\ttemp;\n355\t\n356\t\t\tVectorCopy( axis[1], temp );\n357\t\t\tRotatePointAroundVector( axis[1], axis[0], temp, yaw );\n358\t\t}\n359\t\n360\t\t// cross to get axis[2]\n361\t\tCrossProduct( axis[0], axis[1], axis[2] );\n362\t}\n363\t\n364\t\n365\t\n366\tvoid vectoangles( const vec3_t value1, vec3_t angles ) {\n367\t\tfloat\tforward;\n368\t\tfloat\tyaw, pitch;\n369\t\n370\t\tif ( value1[1] == 0 && value1[0] == 0 ) {\n371\t\t\tyaw = 0;\n372\t\t\tif ( value1[2] > 0 ) {\n373\t\t\t\tpitch = 90;\n374\t\t\t}\n375\t\t\telse {\n376\t\t\t\tpitch = 270;\n377\t\t\t}\n378\t\t}\n379\t\telse {\n380\t\t\tif ( value1[0] ) {\n381\t\t\t\tyaw = ( atan2 ( value1[1], value1[0] ) * 180 / M_PI );\n382\t\t\t}\n383\t\t\telse if ( value1[1] > 0 ) {\n384\t\t\t\tyaw = 90;\n385\t\t\t}\n386\t\t\telse {\n387\t\t\t\tyaw = 270;\n388\t\t\t}\n389\t\t\tif ( yaw < 0 ) {\n390\t\t\t\tyaw += 360;\n391\t\t\t}\n392\t\n393\t\t\tforward = sqrt ( value1[0]*value1[0] + value1[1]*value1[1] );\n394\t\t\tpitch = ( atan2(value1[2], forward) * 180 / M_PI );\n395\t\t\tif ( pitch < 0 ) {\n396\t\t\t\tpitch += 360;\n397\t\t\t}\n398\t\t}\n399\t\n400\t\tangles[PITCH] = -pitch;\n401\t\tangles[YAW] = yaw;\n402\t\tangles[ROLL] = 0;\n403\t}\n404\t\n405\t\n406\t/*\n407\t=================\n408\tAnglesToAxis\n409\t=================\n410\t*/\n411\tvoid AnglesToAxis( const vec3_t angles, vec3_t axis[3] ) {\n412\t\tvec3_t\tright;\n413\t\n414\t\t// angle vectors returns \"right\" instead of \"y axis\"\n415\t\tAngleVectors( angles, axis[0], right, axis[2] );\n416\t\tVectorSubtract( vec3_origin, right, axis[1] );\n417\t}\n418\t\n419\tvoid AxisClear( vec3_t axis[3] ) {\n420\t\taxis[0][0] = 1;\n421\t\taxis[0][1] = 0;\n422\t\taxis[0][2] = 0;\n423\t\taxis[1][0] = 0;\n424\t\taxis[1][1] = 1;\n425\t\taxis[1][2] = 0;\n426\t\taxis[2][0] = 0;\n427\t\taxis[2][1] = 0;\n428\t\taxis[2][2] = 1;\n429\t}\n430\t\n431\tvoid AxisCopy( vec3_t in[3], vec3_t out[3] ) {\n432\t\tVectorCopy( in[0], out[0] );\n433\t\tVectorCopy( in[1], out[1] );\n434\t\tVectorCopy( in[2], out[2] );\n435\t}\n436\t\n437\tvoid ProjectPointOnPlane( vec3_t dst, const vec3_t p, const vec3_t normal )\n438\t{\n439\t\tfloat d;\n440\t\tvec3_t n;\n441\t\tfloat inv_denom;\n442\t\n443\t\tinv_denom =  DotProduct( normal, normal );\n444\t\tinv_denom = 1.0f / inv_denom;\n445\t\n446\t\td = DotProduct( normal, p ) * inv_denom;\n447\t\n448\t\tn[0] = normal[0] * inv_denom;\n449\t\tn[1] = normal[1] * inv_denom;\n450\t\tn[2] = normal[2] * inv_denom;\n451\t\n452\t\tdst[0] = p[0] - d * n[0];\n453\t\tdst[1] = p[1] - d * n[1];\n454\t\tdst[2] = p[2] - d * n[2];\n455\t}\n456\t\n457\t/*\n458\t================\n459\tMakeNormalVectors\n460\t\n461\tGiven a normalized forward vector, create two\n462\tother perpendicular vectors\n463\t================\n464\t*/\n465\tvoid MakeNormalVectors( const vec3_t forward, vec3_t right, vec3_t up) {\n466\t\tfloat\t\td;\n467\t\n468\t\t// this rotate and negate guarantees a vector\n469\t\t// not colinear with the original\n470\t\tright[1] = -forward[0];\n471\t\tright[2] = forward[1];\n472\t\tright[0] = forward[2];\n473\t\n474\t\td = DotProduct (right, forward);\n475\t\tVectorMA (right, -d, forward, right);\n476\t\tVectorNormalize (right);\n477\t\tCrossProduct (right, forward, up);\n478\t}\n479\t\n480\t\n481\tvoid VectorRotate( vec3_t in, vec3_t matrix[3], vec3_t out )\n482\t{\n483\t\tout[0] = DotProduct( in, matrix[0] );\n484\t\tout[1] = DotProduct( in, matrix[1] );\n485\t\tout[2] = DotProduct( in, matrix[2] );\n486\t}\n487\t\n488\t//============================================================================\n489\t\n490\t#if !idppc\n491\t/*\n492\t** float q_rsqrt( float number )\n493\t*/\n494\tfloat Q_rsqrt( float number )\n495\t{\n496\t\tuint32_t i;\n497\t    float x2, y;\n498\t    const float threehalfs = 1.5F;\n499\t\n500\t    x2 = number * 0.5F;\n501\t    y  = number;\n502\t\n503\t    memcpy(&i, &y, sizeof(float));\t\t\t\t\t\t// evil floating point bit level hacking\n504\t    i  = 0x5f3759dfu - (i >> 1);               // what the?\n505\t    memcpy(&y, &i, sizeof(float));\n506\t\n507\t    y  = y * (threehalfs - (x2 * y * y));   // 1st iteration\n508\t//\ty  = y * ( threehalfs - ( x2 * y * y ) );   // 2nd iteration, this can be removed\n509\t\n510\t/*\n511\t#ifndef Q3_VM\n512\t#ifdef __linux__\n513\t\tassert( !isnan(y) ); // bk010122 - FPE?\n514\t#endif\n515\t#endif\n516\t*/\n517\t\treturn y;\n518\t}\n519\t\n520\tfloat Q_fabs( float f ) {\n521\t\tint tmp = * ( int * ) &f;\n522\t\ttmp &= 0x7FFFFFFF;\n523\t\treturn * ( float * ) &tmp;\n524\t}\n525\t#endif\n526\t\n527\t//============================================================\n528\t\n529\t/*\n530\t===============\n531\tLerpAngle\n532\t\n533\t===============\n534\t*/\n535\tfloat LerpAngle (float from, float to, float frac) {\n536\t\tfloat\ta;\n537\t\n538\t\tif ( to - from > 180 ) {\n539\t\t\tto -= 360;\n540\t\t}\n541\t\tif ( to - from < -180 ) {\n542\t\t\tto += 360;\n543\t\t}\n544\t\ta = from + frac * (to - from);\n545\t\n546\t\treturn a;\n547\t}\n548\t\n549\t\n550\t/*\n551\t=================\n552\tAngleSubtract\n553\t\n554\tAlways returns a value from -180 to 180\n555\t=================\n556\t*/\n557\tfloat\tAngleSubtract( float a1, float a2 ) {\n558\t\tfloat\ta;\n559\t\n560\t\ta = a1 - a2;\n561\t\twhile ( a > 180 ) {\n562\t\t\ta -= 360;\n563\t\t}\n564\t\twhile ( a < -180 ) {\n565\t\t\ta += 360;\n566\t\t}\n567\t\treturn a;\n568\t}\n569\t\n570\t\n571\tvoid AnglesSubtract( vec3_t v1, vec3_t v2, vec3_t v3 ) {\n572\t\tv3[0] = AngleSubtract( v1[0], v2[0] );\n573\t\tv3[1] = AngleSubtract( v1[1], v2[1] );\n574\t\tv3[2] = AngleSubtract( v1[2], v2[2] );\n575\t}\n576\t\n577\t\n578\tfloat\tAngleMod(float a) {\n579\t\ta = (360.0/65536) * ((int)(a*(65536/360.0)) & 65535);\n580\t\treturn a;\n581\t}\n582\t\n583\t\n584\t/*\n585\t=================\n586\tAngleNormalize360\n587\t\n588\treturns angle normalized to the range [0 <= angle < 360]\n589\t=================\n590\t*/\n591\tfloat AngleNormalize360 ( float angle ) {\n592\t\treturn (360.0 / 65536) * ((int)(angle * (65536 / 360.0)) & 65535);\n593\t}\n594\t\n595\t\n596\t/*\n597\t=================\n598\tAngleNormalize180\n599\t\n600\treturns angle normalized to the range [-180 < angle <= 180]\n601\t=================\n602\t*/\n603\tfloat AngleNormalize180 ( float angle ) {\n604\t\tangle = AngleNormalize360( angle );\n605\t\tif ( angle > 180.0 ) {\n606\t\t\tangle -= 360.0;\n607\t\t}\n608\t\treturn angle;\n609\t}\n610\t\n611\t\n612\t/*\n613\t=================\n614\tAngleDelta\n615\t\n616\treturns the normalized delta from angle1 to angle2\n617\t=================\n618\t*/\n619\tfloat AngleDelta ( float angle1, float angle2 ) {\n620\t\treturn AngleNormalize180( angle1 - angle2 );\n621\t}\n622\t\n623\t\n624\t//============================================================\n625\t\n626\t\n627\t/*\n628\t=================\n629\tSetPlaneSignbits\n630\t=================\n631\t*/\n632\tvoid SetPlaneSignbits (cplane_t *out) {\n633\t\tint\tbits, j;\n634\t\n635\t\t// for fast box on planeside test\n636\t\tbits = 0;\n637\t\tfor (j=0 ; j<3 ; j++) {\n638\t\t\tif (out->normal[j] < 0) {\n639\t\t\t\tbits |= 1<<j;\n640\t\t\t}\n641\t\t}\n642\t\tout->signbits = bits;\n643\t}\n644\t\n645\t\n646\t/*\n647\t==================\n648\tBoxOnPlaneSide\n649\t\n650\tReturns 1, 2, or 1 + 2\n651\t\n652\t// this is the slow, general version\n653\tint BoxOnPlaneSide2 (vec3_t emins, vec3_t emaxs, struct cplane_s *p)\n654\t{\n655\t\tint\t\ti;\n656\t\tfloat\tdist1, dist2;\n657\t\tint\t\tsides;\n658\t\tvec3_t\tcorners[2];\n659\t\n660\t\tfor (i=0 ; i<3 ; i++)\n661\t\t{\n662\t\t\tif (p->normal[i] < 0)\n663\t\t\t{\n664\t\t\t\tcorners[0][i] = emins[i];\n665\t\t\t\tcorners[1][i] = emaxs[i];\n666\t\t\t}\n667\t\t\telse\n668\t\t\t{\n669\t\t\t\tcorners[1][i] = emins[i];\n670\t\t\t\tcorners[0][i] = emaxs[i];\n671\t\t\t}\n672\t\t}\n673\t\tdist1 = DotProduct (p->normal, corners[0]) - p->dist;\n674\t\tdist2 = DotProduct (p->normal, corners[1]) - p->dist;\n675\t\tsides = 0;\n676\t\tif (dist1 >= 0)\n677\t\t\tsides = 1;\n678\t\tif (dist2 < 0)\n679\t\t\tsides |= 2;\n680\t\n681\t\treturn sides;\n682\t}\n683\t\n684\t==================\n685\t*/\n686\t\n687\tint BoxOnPlaneSide (vec3_t emins, vec3_t emaxs, struct cplane_s *p)\n688\t{\n689\t\tfloat\tdist1, dist2;\n690\t\tint\t\tsides;\n691\t\n692\t// fast axial cases\n693\t\tif (p->type < 3)\n694\t\t{\n695\t\t\tif (p->dist <= emins[p->type])\n696\t\t\t\treturn 1;\n697\t\t\tif (p->dist >= emaxs[p->type])\n698\t\t\t\treturn 2;\n699\t\t\treturn 3;\n700\t\t}\n701\t\n702\t// general case\n703\t\tswitch (p->signbits)\n704\t\t{\n705\t\tcase 0:\n706\t\t\tdist1 = p->normal[0]*emaxs[0] + p->normal[1]*emaxs[1] + p->normal[2]*emaxs[2];\n707\t\t\tdist2 = p->normal[0]*emins[0] + p->normal[1]*emins[1] + p->normal[2]*emins[2];\n708\t\t\tbreak;\n709\t\tcase 1:\n710\t\t\tdist1 = p->normal[0]*emins[0] + p->normal[1]*emaxs[1] + p->normal[2]*emaxs[2];\n711\t\t\tdist2 = p->normal[0]*emaxs[0] + p->normal[1]*emins[1] + p->normal[2]*emins[2];\n712\t\t\tbreak;\n713\t\tcase 2:\n714\t\t\tdist1 = p->normal[0]*emaxs[0] + p->normal[1]*emins[1] + p->normal[2]*emaxs[2];\n715\t\t\tdist2 = p->normal[0]*emins[0] + p->normal[1]*emaxs[1] + p->normal[2]*emins[2];\n716\t\t\tbreak;\n717\t\tcase 3:\n718\t\t\tdist1 = p->normal[0]*emins[0] + p->normal[1]*emins[1] + p->normal[2]*emaxs[2];\n719\t\t\tdist2 = p->normal[0]*emaxs[0] + p->normal[1]*emaxs[1] + p->normal[2]*emins[2];\n720\t\t\tbreak;\n721\t\tcase 4:\n722\t\t\tdist1 = p->normal[0]*emaxs[0] + p->normal[1]*emaxs[1] + p->normal[2]*emins[2];\n723\t\t\tdist2 = p->normal[0]*emins[0] + p->normal[1]*emins[1] + p->normal[2]*emaxs[2];\n724\t\t\tbreak;\n725\t\tcase 5:\n726\t\t\tdist1 = p->normal[0]*emins[0] + p->normal[1]*emaxs[1] + p->normal[2]*emins[2];\n727\t\t\tdist2 = p->normal[0]*emaxs[0] + p->normal[1]*emins[1] + p->normal[2]*emaxs[2];\n728\t\t\tbreak;\n729\t\tcase 6:\n730\t\t\tdist1 = p->normal[0]*emaxs[0] + p->normal[1]*emins[1] + p->normal[2]*emins[2];\n731\t\t\tdist2 = p->normal[0]*emins[0] + p->normal[1]*emaxs[1] + p->normal[2]*emaxs[2];\n732\t\t\tbreak;\n733\t\tcase 7:\n734\t\t\tdist1 = p->normal[0]*emins[0] + p->normal[1]*emins[1] + p->normal[2]*emins[2];\n735\t\t\tdist2 = p->normal[0]*emaxs[0] + p->normal[1]*emaxs[1] + p->normal[2]*emaxs[2];\n736\t\t\tbreak;\n737\t\tdefault:\n738\t\t\tdist1 = dist2 = 0;\t\t// shut up compiler\n739\t\t\tbreak;\n740\t\t}\n741\t\n742\t\tsides = 0;\n743\t\tif (dist1 >= p->dist)\n744\t\t\tsides = 1;\n745\t\tif (dist2 < p->dist)\n746\t\t\tsides |= 2;\n747\t\n748\t\treturn sides;\n749\t}\n750\t\n751\t/*\n752\t=================\n753\tRadiusFromBounds\n754\t=================\n755\t*/\n756\tfloat RadiusFromBounds( const vec3_t mins, const vec3_t maxs ) {\n757\t\tint\t\ti;\n758\t\tvec3_t\tcorner;\n759\t\tfloat\ta, b;\n760\t\n761\t\tfor (i=0 ; i<3 ; i++) {\n762\t\t\ta = fabs( mins[i] );\n763\t\t\tb = fabs( maxs[i] );\n764\t\t\tcorner[i] = a > b ? a : b;\n765\t\t}\n766\t\n767\t\treturn VectorLength (corner);\n768\t}\n769\t\n770\t\n771\tvoid ClearBounds( vec3_t mins, vec3_t maxs ) {\n772\t\tmins[0] = mins[1] = mins[2] = 99999;\n773\t\tmaxs[0] = maxs[1] = maxs[2] = -99999;\n774\t}\n775\t\n776\tvoid AddPointToBounds( const vec3_t v, vec3_t mins, vec3_t maxs ) {\n777\t\tif ( v[0] < mins[0] ) {\n778\t\t\tmins[0] = v[0];\n779\t\t}\n780\t\tif ( v[0] > maxs[0]) {\n781\t\t\tmaxs[0] = v[0];\n782\t\t}\n783\t\n784\t\tif ( v[1] < mins[1] ) {\n785\t\t\tmins[1] = v[1];\n786\t\t}\n787\t\tif ( v[1] > maxs[1]) {\n788\t\t\tmaxs[1] = v[1];\n789\t\t}\n790\t\n791\t\tif ( v[2] < mins[2] ) {\n792\t\t\tmins[2] = v[2];\n793\t\t}\n794\t\tif ( v[2] > maxs[2]) {\n795\t\t\tmaxs[2] = v[2];\n796\t\t}\n797\t}\n798\t\n799\t\n800\tvec_t VectorNormalize( vec3_t v ) {\n801\t\t// NOTE: TTimo - Apple G4 altivec source uses double?\n802\t\tfloat\tlength, ilength;\n803\t\n804\t\tlength = v[0]*v[0] + v[1]*v[1] + v[2]*v[2];\n805\t\tlength = sqrt (length);\n806\t\n807\t\tif ( length ) {\n808\t\t\tilength = 1/length;\n809\t\t\tv[0] *= ilength;\n810\t\t\tv[1] *= ilength;\n811\t\t\tv[2] *= ilength;\n812\t\t}\n813\t\n814\t\treturn length;\n815\t}\n816\t\n817\tvec_t VectorNormalize2( const vec3_t v, vec3_t out) {\n818\t\tfloat\tlength, ilength;\n819\t\n820\t\tlength = v[0]*v[0] + v[1]*v[1] + v[2]*v[2];\n821\t\tlength = sqrt (length);\n822\t\n823\t\tif (length)\n824\t\t{\n825\t#ifndef Q3_VM // bk0101022 - FPE related\n826\t//\t  assert( ((Q_fabs(v[0])!=0.0f) || (Q_fabs(v[1])!=0.0f) || (Q_fabs(v[2])!=0.0f)) );\n827\t#endif\n828\t\t\tilength = 1/length;\n829\t\t\tout[0] = v[0]*ilength;\n830\t\t\tout[1] = v[1]*ilength;\n831\t\t\tout[2] = v[2]*ilength;\n832\t\t} else {\n833\t#ifndef Q3_VM // bk0101022 - FPE related\n834\t//\t  assert( ((Q_fabs(v[0])==0.0f) && (Q_fabs(v[1])==0.0f) && (Q_fabs(v[2])==0.0f)) );\n835\t#endif\n836\t\t\tVectorClear( out );\n837\t\t}\n838\t\n839\t\treturn length;\n840\t\n841\t}\n842\t\n843\tvoid _VectorMA( const vec3_t veca, float scale, const vec3_t vecb, vec3_t vecc) {\n844\t\tvecc[0] = veca[0] + scale*vecb[0];\n845\t\tvecc[1] = veca[1] + scale*vecb[1];\n846\t\tvecc[2] = veca[2] + scale*vecb[2];\n847\t}\n848\t\n849\t\n850\tvec_t _DotProduct( const vec3_t v1, const vec3_t v2 ) {\n851\t\treturn v1[0]*v2[0] + v1[1]*v2[1] + v1[2]*v2[2];\n852\t}\n853\t\n854\tvoid _VectorSubtract( const vec3_t veca, const vec3_t vecb, vec3_t out ) {\n855\t\tout[0] = veca[0]-vecb[0];\n856\t\tout[1] = veca[1]-vecb[1];\n857\t\tout[2] = veca[2]-vecb[2];\n858\t}\n859\t\n860\tvoid _VectorAdd( const vec3_t veca, const vec3_t vecb, vec3_t out ) {\n861\t\tout[0] = veca[0]+vecb[0];\n862\t\tout[1] = veca[1]+vecb[1];\n863\t\tout[2] = veca[2]+vecb[2];\n864\t}\n865\t\n866\tvoid _VectorCopy( const vec3_t in, vec3_t out ) {\n867\t\tout[0] = in[0];\n868\t\tout[1] = in[1];\n869\t\tout[2] = in[2];\n870\t}\n871\t\n872\tvoid _VectorScale( const vec3_t in, vec_t scale, vec3_t out ) {\n873\t\tout[0] = in[0]*scale;\n874\t\tout[1] = in[1]*scale;\n875\t\tout[2] = in[2]*scale;\n876\t}\n877\t\n878\tvoid Vector4Scale( const vec4_t in, vec_t scale, vec4_t out ) {\n879\t\tout[0] = in[0]*scale;\n880\t\tout[1] = in[1]*scale;\n881\t\tout[2] = in[2]*scale;\n882\t\tout[3] = in[3]*scale;\n883\t}\n884\t\n885\t\n886\tint Q_log2( int val ) {\n887\t\tint answer;\n888\t\n889\t\tanswer = 0;\n890\t\twhile ( ( val>>=1 ) != 0 ) {\n891\t\t\tanswer++;\n892\t\t}\n893\t\treturn answer;\n894\t}\n895\t\n896\t\n897\t\n898\t/*\n899\t=================\n900\tPlaneTypeForNormal\n901\t=================\n902\t*/\n903\t/*\n904\tint\tPlaneTypeForNormal (vec3_t normal) {\n905\t\tif ( normal[0] == 1.0 )\n906\t\t\treturn PLANE_X;\n907\t\tif ( normal[1] == 1.0 )\n908\t\t\treturn PLANE_Y;\n909\t\tif ( normal[2] == 1.0 )\n910\t\t\treturn PLANE_Z;\n911\t\n912\t\treturn PLANE_NON_AXIAL;\n913\t}\n914\t*/\n915\t\n916\t\n917\t/*\n918\t================\n919\tMatrixMultiply\n920\t================\n921\t*/\n922\tvoid MatrixMultiply(float in1[3][3], float in2[3][3], float out[3][3]) {\n923\t\tout[0][0] = in1[0][0] * in2[0][0] + in1[0][1] * in2[1][0] +\n924\t\t\t\t\tin1[0][2] * in2[2][0];\n925\t\tout[0][1] = in1[0][0] * in2[0][1] + in1[0][1] * in2[1][1] +\n926\t\t\t\t\tin1[0][2] * in2[2][1];\n927\t\tout[0][2] = in1[0][0] * in2[0][2] + in1[0][1] * in2[1][2] +\n928\t\t\t\t\tin1[0][2] * in2[2][2];\n929\t\tout[1][0] = in1[1][0] * in2[0][0] + in1[1][1] * in2[1][0] +\n930\t\t\t\t\tin1[1][2] * in2[2][0];\n931\t\tout[1][1] = in1[1][0] * in2[0][1] + in1[1][1] * in2[1][1] +\n932\t\t\t\t\tin1[1][2] * in2[2][1];\n933\t\tout[1][2] = in1[1][0] * in2[0][2] + in1[1][1] * in2[1][2] +\n934\t\t\t\t\tin1[1][2] * in2[2][2];\n935\t\tout[2][0] = in1[2][0] * in2[0][0] + in1[2][1] * in2[1][0] +\n936\t\t\t\t\tin1[2][2] * in2[2][0];\n937\t\tout[2][1] = in1[2][0] * in2[0][1] + in1[2][1] * in2[1][1] +\n938\t\t\t\t\tin1[2][2] * in2[2][1];\n939\t\tout[2][2] = in1[2][0] * in2[0][2] + in1[2][1] * in2[1][2] +\n940\t\t\t\t\tin1[2][2] * in2[2][2];\n941\t}\n942\t\n943\t\n944\tvoid AngleVectors( const vec3_t angles, vec3_t forward, vec3_t right, vec3_t up) {\n945\t\tfloat\t\tangle;\n946\t\tstatic float\t\tsr, sp, sy, cr, cp, cy;\n947\t\t// static to help MS compiler fp bugs\n948\t\n949\t\tangle = angles[YAW] * (M_PI*2 / 360);\n950\t\tsy = sin(angle);\n951\t\tcy = cos(angle);\n952\t\tangle = angles[PITCH] * (M_PI*2 / 360);\n953\t\tsp = sin(angle);\n954\t\tcp = cos(angle);\n955\t\tangle = angles[ROLL] * (M_PI*2 / 360);\n956\t\tsr = sin(angle);\n957\t\tcr = cos(angle);\n958\t\n959\t\tif (forward)\n960\t\t{\n961\t\t\tforward[0] = cp*cy;\n962\t\t\tforward[1] = cp*sy;\n963\t\t\tforward[2] = -sp;\n964\t\t}\n965\t\tif (right)\n966\t\t{\n967\t\t\tright[0] = (-1*sr*sp*cy+-1*cr*-sy);\n968\t\t\tright[1] = (-1*sr*sp*sy+-1*cr*cy);\n969\t\t\tright[2] = -1*sr*cp;\n970\t\t}\n971\t\tif (up)\n972\t\t{\n973\t\t\tup[0] = (cr*sp*cy+-sr*-sy);\n974\t\t\tup[1] = (cr*sp*sy+-sr*cy);\n975\t\t\tup[2] = cr*cp;\n976\t\t}\n977\t}\n978\t\n979\t/*\n980\t** assumes \"src\" is normalized\n981\t*/\n982\tvoid PerpendicularVector( vec3_t dst, const vec3_t src )\n983\t{\n984\t\tint\tpos;\n985\t\tint i;\n986\t\tfloat minelem = 1.0F;\n987\t\tvec3_t tempvec;\n988\t\n989\t\t/*\n990\t\t** find the smallest magnitude axially aligned vector\n991\t\t*/\n992\t\tfor ( pos = 0, i = 0; i < 3; i++ )\n993\t\t{\n994\t\t\tif ( fabs( src[i] ) < minelem )\n995\t\t\t{\n996\t\t\t\tpos = i;\n997\t\t\t\tminelem = fabs( src[i] );\n998\t\t\t}\n999\t\t}\n1000\t\ttempvec[0] = tempvec[1] = tempvec[2] = 0.0F;\n1001\t\ttempvec[pos] = 1.0F;\n1002\t\n1003\t\t/*\n1004\t\t** project the point onto the plane defined by src\n1005\t\t*/\n1006\t\tProjectPointOnPlane( dst, tempvec, src );\n1007\t\n1008\t\t/*\n1009\t\t** normalize the result\n1010\t\t*/\n1011\t\tVectorNormalize( dst );\n1012\t}\n1013\t"}]},"parent_tool_use_id":null,"session_id":"bf9d36cb-13a4-40a8-a93d-48ad7b006df9","uuid":"7aa658bb-f1f0-455f-aa4f-65842f551939","timestamp":"2026-08-20T13:17:27.331Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-MbXgVZ/translated_rust/c_src/src/q_math.c","content":"/*\n===========================================================================\nCopyright (C) 1999-2005 Id Software, Inc.\n\nThis file is part of Quake III Arena source code.\n\nQuake III Arena source code is free software; you can redistribute it\nand/or modify it under