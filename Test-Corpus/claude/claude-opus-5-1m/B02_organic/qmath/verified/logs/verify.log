{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MFJXneMX6ZgiUYjrudS6e4","type":"tool_result","content":"1\t/*\n2\t * Differential-test support code -- NOT part of the library under test.\n3\t *\n4\t * c_src/inc/q_shared.h implements a large part of the vector maths as\n5\t * function-like macros and `static ID_INLINE` functions.  Those have no\n6\t * external linkage, so they do not appear in the shared library's symbol table\n7\t * and cannot be reached with dlsym().  This file gives every one of them a\n8\t * `w_`-prefixed extern entry point by expanding the *real* header, so that the\n9\t * Rust translation of the header (src/q_shared.rs, exported through\n10\t * src/wrappers.rs) can be compared against the C preprocessor's own expansion.\n11\t *\n12\t * c_src/ is left untouched: this file only #includes it.\n13\t */\n14\t\n15\t#include \"q_shared.h\"\n16\t#include <stddef.h>\n17\t\n18\t/* --- macros ------------------------------------------------------------- */\n19\t\n20\tvec_t w_DotProduct(const vec3_t x, const vec3_t y) { return DotProduct(x, y); }\n21\tvoid w_VectorSubtract(const vec3_t a, const vec3_t b, vec3_t c) { VectorSubtract(a, b, c); }\n22\tvoid w_VectorAdd(const vec3_t a, const vec3_t b, vec3_t c) { VectorAdd(a, b, c); }\n23\tvoid w_VectorCopy(const vec3_t a, vec3_t b) { VectorCopy(a, b); }\n24\tvoid w_VectorScale(const vec3_t v, vec_t s, vec3_t o) { VectorScale(v, s, o); }\n25\tvoid w_VectorMA(const vec3_t v, vec_t s, const vec3_t b, vec3_t o) { VectorMA(v, s, b, o); }\n26\tvoid w_VectorClear(vec3_t a) { VectorClear(a); }\n27\tvoid w_VectorNegate(const vec3_t a, vec3_t b) { VectorNegate(a, b); }\n28\tvoid w_VectorSet(vec3_t v, vec_t x, vec_t y, vec_t z) { VectorSet(v, x, y, z); }\n29\tvoid w_Vector4Copy(const vec4_t a, vec4_t b) { Vector4Copy(a, b); }\n30\tvoid w_SnapVector(vec3_t v) { SnapVector(v); }\n31\t\n32\tint w_IS_NAN(float x) { return IS_NAN(x); }\n33\tfloat w_SQRTFAST(float x) { return SQRTFAST(x); }\n34\tdouble w_DEG2RAD(float a) { return DEG2RAD(a); }\n35\tdouble w_RAD2DEG(float a) { return RAD2DEG(a); }\n36\tint w_ANGLE2SHORT(float x) { return ANGLE2SHORT(x); }\n37\tdouble w_SHORT2ANGLE(int x) { return SHORT2ANGLE(x); }\n38\tint w_ColorIndex(int c) { return ColorIndex(c); }\n39\tfloat w_Square(float x) { return Square(x); }\n40\tint w_PlaneTypeForNormal(const vec3_t x) { return PlaneTypeForNormal(x); }\n41\tvoid w_MAKERGB(vec3_t v, vec_t r, vec_t g, vec_t b) { MAKERGB(v, r, g, b); }\n42\tvoid w_MAKERGBA(vec4_t v, vec_t r, vec_t g, vec_t b, vec_t a) { MAKERGBA(v, r, g, b, a); }\n43\t\n44\t/* --- static ID_INLINE functions ----------------------------------------- */\n45\t\n46\tint w_VectorCompare(const vec3_t v1, const vec3_t v2) { return VectorCompare(v1, v2); }\n47\tvec_t w_VectorLength(const vec3_t v) { return VectorLength(v); }\n48\tvec_t w_VectorLengthSquared(const vec3_t v) { return VectorLengthSquared(v); }\n49\tvec_t w_Distance(const vec3_t p1, const vec3_t p2) { return Distance(p1, p2); }\n50\tvec_t w_DistanceSquared(const vec3_t p1, const vec3_t p2) { return DistanceSquared(p1, p2); }\n51\tvoid w_VectorNormalizeFast(vec3_t v) { VectorNormalizeFast(v); }\n52\tvoid w_VectorInverse(vec3_t v) { VectorInverse(v); }\n53\tvoid w_CrossProduct(const vec3_t v1, const vec3_t v2, vec3_t cross) { CrossProduct(v1, v2, cross); }\n54\t\n55\t/* --- constants and layout ---------------------------------------------- */\n56\t\n57\tvoid w_layout(int *out) {\n58\t\tout[0] = (int)sizeof(cplane_t);\n59\t\tout[1] = (int)offsetof(cplane_t, normal);\n60\t\tout[2] = (int)offsetof(cplane_t, dist);\n61\t\tout[3] = (int)offsetof(cplane_t, type);\n62\t\tout[4] = (int)offsetof(cplane_t, signbits);\n63\t\tout[5] = (int)offsetof(cplane_t, pad);\n64\t\tout[6] = NUMVERTEXNORMALS;\n65\t\tout[7] = nanmask;\n66\t\tout[8] = (int)sizeof(vec_t);\n67\t}\n68\t\n69\tvoid w_angle_indexes(int *out) {\n70\t\tout[0] = PITCH;\n71\t\tout[1] = YAW;\n72\t\tout[2] = ROLL;\n73\t\tout[3] = PLANE_X;\n74\t\tout[4] = PLANE_Y;\n75\t\tout[5] = PLANE_Z;\n76\t\tout[6] = PLANE_NON_AXIAL;\n77\t\tout[7] = qfalse;\n78\t\tout[8] = qtrue;\n79\t\tout[9] = (int)sizeof(qboolean);\n80\t}\n81\t\n82\tdouble w_M_PI(void) { return M_PI; }\n83\t"}]},"parent_tool_use_id":"toolu_bdrk_01K5jGuJUfGMrBPtJB44XHbU","session_id":"bf9d36cb-13a4-40a8-a93d-48ad7b006df9","uuid":"cf0c74d4-68c0-4c6e-9240-900527716bc3","timestamp":"2026-08-20T13:45:14.808Z","subagent_type":"general-purpose","task_description":"Write q_shared wrapper + data tests"}
