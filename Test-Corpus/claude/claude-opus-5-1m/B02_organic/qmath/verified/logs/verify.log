{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015XVXZEuXhd3DUtdEXLWdsd","type":"tool_result","content":"1\t//! Exported test hooks for the parts of `c_src/inc/q_shared.h` that have no\n2\t//! external linkage in C: the function-like macros (`DotProduct`,\n3\t//! `VectorSubtract`, `SnapVector`, `ANGLE2SHORT`, ...) and the\n4\t//! `static ID_INLINE` functions (`VectorLength`, `CrossProduct`, ...).\n5\t//!\n6\t//! `tests/csupport/wrappers.c` defines byte-for-byte the same set of `w_*`\n7\t//! entry points on top of the real header, which lets the differential test\n8\t//! suite compare this translation of the header against the C preprocessor's\n9\t//! own expansion of it.  Nothing in the library itself calls these.\n10\t\n11\t#![allow(non_snake_case)]\n12\t#![allow(clippy::missing_safety_doc)]\n13\t\n14\tuse crate::q_shared::{self as qs, cplane_t, vec_t};\n15\tuse core::ffi::c_int;\n16\t\n17\t// --- macros -----------------------------------------------------------------\n18\t\n19\t#[no_mangle]\n20\tpub unsafe extern \"C\" fn w_DotProduct(x: *const vec_t, y: *const vec_t) -> vec_t {\n21\t    qs::DotProduct(x, y)\n22\t}\n23\t\n24\t#[no_mangle]\n25\tpub unsafe extern \"C\" fn w_VectorSubtract(a: *const vec_t, b: *const vec_t, c: *mut vec_t) {\n26\t    qs::VectorSubtract(a, b, c)\n27\t}\n28\t\n29\t#[no_mangle]\n30\tpub unsafe extern \"C\" fn w_VectorAdd(a: *const vec_t, b: *const vec_t, c: *mut vec_t) {\n31\t    qs::VectorAdd(a, b, c)\n32\t}\n33\t\n34\t#[no_mangle]\n35\tpub unsafe extern \"C\" fn w_VectorCopy(a: *const vec_t, b: *mut vec_t) {\n36\t    qs::VectorCopy(a, b)\n37\t}\n38\t\n39\t#[no_mangle]\n40\tpub unsafe extern \"C\" fn w_VectorScale(v: *const vec_t, s: vec_t, o: *mut vec_t) {\n41\t    qs::VectorScale(v, s, o)\n42\t}\n43\t\n44\t#[no_mangle]\n45\tpub unsafe extern \"C\" fn w_VectorMA(v: *const vec_t, s: vec_t, b: *const vec_t, o: *mut vec_t) {\n46\t    qs::VectorMA(v, s, b, o)\n47\t}\n48\t\n49\t#[no_mangle]\n50\tpub unsafe extern \"C\" fn w_VectorClear(a: *mut vec_t) {\n51\t    qs::VectorClear(a)\n52\t}\n53\t\n54\t#[no_mangle]\n55\tpub unsafe extern \"C\" fn w_VectorNegate(a: *const vec_t, b: *mut vec_t) {\n56\t    qs::VectorNegate(a, b)\n57\t}\n58\t\n59\t#[no_mangle]\n60\tpub unsafe extern \"C\" fn w_VectorSet(v: *mut vec_t, x: vec_t, y: vec_t, z: vec_t) {\n61\t    qs::VectorSet(v, x, y, z)\n62\t}\n63\t\n64\t#[no_mangle]\n65\tpub unsafe extern \"C\" fn w_Vector4Copy(a: *const vec_t, b: *mut vec_t) {\n66\t    qs::Vector4Copy(a, b)\n67\t}\n68\t\n69\t#[no_mangle]\n70\tpub unsafe extern \"C\" fn w_SnapVector(v: *mut vec_t) {\n71\t    qs::SnapVector(v)\n72\t}\n73\t\n74\t#[no_mangle]\n75\tpub extern \"C\" fn w_IS_NAN(x: vec_t) -> c_int {\n76\t    // The C macro evaluates to an `int` (0 or 1) inside the wrapper's `return`.\n77\t    qs::IS_NAN(x) as c_int\n78\t}\n79\t\n80\t#[no_mangle]\n81\tpub extern \"C\" fn w_SQRTFAST(x: vec_t) -> vec_t {\n82\t    qs::SQRTFAST(x)\n83\t}\n84\t\n85\t#[no_mangle]\n86\tpub extern \"C\" fn w_DEG2RAD(a: f32) -> f64 {\n87\t    qs::DEG2RAD(a)\n88\t}\n89\t\n90\t#[no_mangle]\n91\tpub extern \"C\" fn w_RAD2DEG(a: f32) -> f64 {\n92\t    qs::RAD2DEG(a)\n93\t}\n94\t\n95\t#[no_mangle]\n96\tpub extern \"C\" fn w_ANGLE2SHORT(x: f32) -> c_int {\n97\t    qs::ANGLE2SHORT(x)\n98\t}\n99\t\n100\t#[no_mangle]\n101\tpub extern \"C\" fn w_SHORT2ANGLE(x: c_int) -> f64 {\n102\t    qs::SHORT2ANGLE(x)\n103\t}\n104\t\n105\t#[no_mangle]\n106\tpub extern \"C\" fn w_ColorIndex(c: c_int) -> c_int {\n107\t    qs::ColorIndex(c)\n108\t}\n109\t\n110\t#[no_mangle]\n111\tpub extern \"C\" fn w_Square(x: f32) -> f32 {\n112\t    qs::Square(x)\n113\t}\n114\t\n115\t#[no_mangle]\n116\tpub unsafe extern \"C\" fn w_PlaneTypeForNormal(x: *const vec_t) -> c_int {\n117\t    qs::PlaneTypeForNormal(x)\n118\t}\n119\t\n120\t#[no_mangle]\n121\tpub unsafe extern \"C\" fn w_MAKERGB(v: *mut vec_t, r: vec_t, g: vec_t, b: vec_t) {\n122\t    qs::MAKERGB(v, r, g, b)\n123\t}\n124\t\n125\t#[no_mangle]\n126\tpub unsafe extern \"C\" fn w_MAKERGBA(v: *mut vec_t, r: vec_t, g: vec_t, b: vec_t, a: vec_t) {\n127\t    qs::MAKERGBA(v, r, g, b, a)\n128\t}\n129\t\n130\t// --- static ID_INLINE functions --------------------------------------------\n131\t\n132\t#[no_mangle]\n133\tpub unsafe extern \"C\" fn w_VectorCompare(v1: *const vec_t, v2: *const vec_t) -> c_int {\n134\t    qs::VectorCompare(v1, v2)\n135\t}\n136\t\n137\t#[no_mangle]\n138\tpub unsafe extern \"C\" fn w_VectorLength(v: *const vec_t) -> vec_t {\n139\t    qs::VectorLength(v)\n140\t}\n141\t\n142\t#[no_mangle]\n143\tpub unsafe extern \"C\" fn w_VectorLengthSquared(v: *const vec_t) -> vec_t {\n144\t    qs::VectorLengthSquared(v)\n145\t}\n146\t\n147\t#[no_mangle]\n148\tpub unsafe extern \"C\" fn w_Distance(p1: *const vec_t, p2: *const vec_t) -> vec_t {\n149\t    qs::Distance(p1, p2)\n150\t}\n151\t\n152\t#[no_mangle]\n153\tpub unsafe extern \"C\" fn w_DistanceSquared(p1: *const vec_t, p2: *const vec_t) -> vec_t {\n154\t    qs::DistanceSquared(p1, p2)\n155\t}\n156\t\n157\t#[no_mangle]\n158\tpub unsafe extern \"C\" fn w_VectorNormalizeFast(v: *mut vec_t) {\n159\t    qs::VectorNormalizeFast(v)\n160\t}\n161\t\n162\t#[no_mangle]\n163\tpub unsafe extern \"C\" fn w_VectorInverse(v: *mut vec_t) {\n164\t    qs::VectorInverse(v)\n165\t}\n166\t\n167\t#[no_mangle]\n168\tpub unsafe extern \"C\" fn w_CrossProduct(v1: *const vec_t, v2: *const vec_t, cross: *mut vec_t) {\n169\t    qs::CrossProduct(v1, v2, cross)\n170\t}\n171\t\n172\t// --- constants and layout --------------------------------------------------\n173\t\n174\t/// Fills `out[0..9]` with, in order: `sizeof(cplane_t)`, `offsetof(normal)`,\n175\t/// `offsetof(dist)`, `offsetof(type)`, `offsetof(signbits)`, `offsetof(pad)`,\n176\t/// `NUMVERTEXNORMALS`, `nanmask`, `sizeof(vec_t)`.\n177\t#[no_mangle]\n178\tpub unsafe extern \"C\" fn w_layout(out: *mut c_int) {\n179\t    *out.add(0) = core::mem::size_of::<cplane_t>() as c_int;\n180\t    *out.add(1) = core::mem::offset_of!(cplane_t, normal) as c_int;\n181\t    *out.add(2) = core::mem::offset_of!(cplane_t, dist) as c_int;\n182\t    *out.add(3) = core::mem::offset_of!(cplane_t, type_) as c_int;\n183\t    *out.add(4) = core::mem::offset_of!(cplane_t, signbits) as c_int;\n184\t    *out.add(5) = core::mem::offset_of!(cplane_t, pad) as c_int;\n185\t    *out.add(6) = qs::NUMVERTEXNORMALS as c_int;\n186\t    *out.add(7) = qs::nanmask;\n187\t    *out.add(8) = core::mem::size_of::<vec_t>() as c_int;\n188\t}\n189\t\n190\t/// `PITCH`, `YAW`, `ROLL`, `PLANE_X`, `PLANE_Y`, `PLANE_Z`, `PLANE_NON_AXIAL`,\n191\t/// `qfalse`, `qtrue`, `sizeof(qboolean)`.\n192\t#[no_mangle]\n193\tpub unsafe extern \"C\" fn w_angle_indexes(out: *mut c_int) {\n194\t    *out.add(0) = qs::PITCH as c_int;\n195\t    *out.add(1) = qs::YAW as c_int;\n196\t    *out.add(2) = qs::ROLL as c_int;\n197\t    *out.add(3) = qs::PLANE_X;\n198\t    *out.add(4) = qs::PLANE_Y;\n199\t    *out.add(5) = qs::PLANE_Z;\n200\t    *out.add(6) = qs::PLANE_NON_AXIAL;\n201\t    *out.add(7) = qs::qfalse;\n202\t    *out.add(8) = qs::qtrue;\n203\t    *out.add(9) = core::mem::size_of::<c_int>() as c_int;\n204\t}\n205\t\n206\t/// The value of `M_PI` as seen by the compiled code.\n207\t#[no_mangle]\n208\tpub extern \"C\" fn w_M_PI() -> f64 {\n209\t    qs::M_PI\n210\t}\n211\t"}]},"parent_tool_use_id":"toolu_bdrk_01K5jGuJUfGMrBPtJB44XHbU","session_id":"bf9d36cb-13a4-40a8-a93d-48ad7b006df9","uuid":"480fe286-64b3-4e1c-ac00-e28003f06874","timestamp":"2026-08-20T13:45:24.035Z","subagent_type":"general-purpose","task_description":"Write q_shared wrapper + data tests"}
