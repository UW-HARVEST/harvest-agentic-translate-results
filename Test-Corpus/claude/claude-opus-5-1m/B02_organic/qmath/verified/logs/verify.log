{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017fscuY4crD1mtiMRJ6kzy5","type":"tool_result","content":"1\t//! Differential-test harness.\n2\t//!\n3\t//! Loads THREE shared objects and calls everything through `dlsym`, so the\n4\t//! `#[no_mangle] extern \"C\"` export wrappers are exercised exactly like an\n5\t//! external consumer would exercise them:\n6\t//!\n7\t//! * `cbuild/libcdriver.so` -- the C library (`c_src/src/q_math.c` +\n8\t//!   `c_src/src/main.c`, the translation units from `c_src/CMakeLists.txt`).\n9\t//! * `cbuild/libcwrap.so`  -- `c_src/src/q_math.c` + `tests/csupport/wrappers.c`,\n10\t//!   which adds `w_*` entry points for the macros and `static ID_INLINE`\n11\t//!   functions of `c_src/inc/q_shared.h`.\n12\t//! * `target/<profile>/libdriver.so` -- the Rust translation, as a cdylib.\n13\t//!\n14\t//! Run `./build_c.sh && cargo build` before `cargo test`.\n15\t//!\n16\t//! Both libraries are opened with `RTLD_LOCAL` (libloading's default), so the C\n17\t//! library's internal PLT calls (e.g. `PlaneFromPoints` -> `VectorNormalize`)\n18\t//! can never be interposed by the Rust library's identically named exports, and\n19\t//! vice versa.\n20\t\n21\t#![allow(dead_code)]\n22\t\n23\tuse libloading::Library;\n24\tuse std::path::PathBuf;\n25\tuse std::sync::OnceLock;\n26\t\n27\tpub struct Libs {\n28\t    /// the C shared object (symbol-parity reference)\n29\t    pub c: Library,\n30\t    /// the C shared object + `w_*` wrappers around q_shared.h\n31\t    pub cw: Library,\n32\t    /// the Rust cdylib\n33\t    pub r: Library,\n34\t}\n35\t\n36\tfn manifest_dir() -> PathBuf {\n37\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n38\t}\n39\t\n40\t/// `target/<profile>/libdriver.so`, derived from the test binary's own location\n41\t/// (`target/<profile>/deps/<test>-<hash>`).\n42\tfn rust_so() -> PathBuf {\n43\t    let exe = std::env::current_exe().expect(\"current_exe\");\n44\t    let profile_dir = exe\n45\t        .parent()\n46\t        .and_then(|p| p.parent())\n47\t        .expect(\"target/<profile>\")\n48\t        .to_path_buf();\n49\t    let candidate = profile_dir.join(\"libdriver.so\");\n50\t    if candidate.exists() {\n51\t        return candidate;\n52\t    }\n53\t    manifest_dir().join(\"target/debug/libdriver.so\")\n54\t}\n55\t\n56\tpub fn libs() -> &'static Libs {\n57\t    static LIBS: OnceLock<Libs> = OnceLock::new();\n58\t    LIBS.get_or_init(|| {\n59\t        let cdriver = manifest_dir().join(\"cbuild/libcdriver.so\");\n60\t        let cwrap = manifest_dir().join(\"cbuild/libcwrap.so\");\n61\t        let rust = rust_so();\n62\t        for p in [&cdriver, &cwrap, &rust] {\n63\t            assert!(\n64\t                p.exists(),\n65\t                \"missing {}: run ./build_c.sh && cargo build first\",\n66\t                p.display()\n67\t            );\n68\t        }\n69\t        unsafe {\n70\t            Libs {\n71\t                c: Library::new(&cdriver).expect(\"dlopen libcdriver.so\"),\n72\t                cw: Library::new(&cwrap).expect(\"dlopen libcwrap.so\"),\n73\t                r: Library::new(&rust).expect(\"dlopen libdriver.so\"),\n74\t            }\n75\t        }\n76\t    })\n77\t}\n78\t\n79\t/// The C driver executable and the Rust driver executable.\n80\tpub fn drivers() -> (PathBuf, PathBuf) {\n81\t    let c = manifest_dir().join(\"cbuild/cdriver\");\n82\t    let exe = std::env::current_exe().expect(\"current_exe\");\n83\t    let profile_dir = exe.parent().and_then(|p| p.parent()).unwrap().to_path_buf();\n84\t    let r = profile_dir.join(\"driver\");\n85\t    (c, r)\n86\t}\n87\t\n88\tfn lookup<T: Copy>(lib: &Library, name: &str) -> T {\n89\t    let mut key: Vec<u8> = name.as_bytes().to_vec();\n90\t    key.push(0);\n91\t    unsafe {\n92\t        *lib.get::<T>(&key)\n93\t            .unwrap_or_else(|e| panic!(\"dlsym({name}): {e}\"))\n94\t    }\n95\t}\n96\t\n97\t/// A function pointer from the C library.\n98\tpub fn cfn<F: Copy>(name: &str) -> F {\n99\t    lookup(&libs().c, name)\n100\t}\n101\t\n102\t/// A function pointer from the Rust library.\n103\tpub fn rfn<F: Copy>(name: &str) -> F {\n104\t    lookup(&libs().r, name)\n105\t}\n106\t\n107\t/// A `w_*` function pointer from the C wrapper library.\n108\tpub fn cwfn<F: Copy>(name: &str) -> F {\n109\t    lookup(&libs().cw, name)\n110\t}\n111\t\n112\t/// The address of a data symbol in the C library.\n113\tpub fn cdata<T>(name: &str) -> *mut T {\n114\t    lookup::<*mut T>(&libs().c, name)\n115\t}\n116\t\n117\t/// The address of a data symbol in the Rust library.\n118\tpub fn rdata<T>(name: &str) -> *mut T {\n119\t    lookup::<*mut T>(&libs().r, name)\n120\t}\n121\t\n122\t/// Both implementations of the same symbol, C first.\n123\tpub fn both<F: Copy>(name: &str) -> (F, F) {\n124\t    (cfn(name), rfn(name))\n125\t}\n126\t\n127\t/// Both implementations of a `w_*` wrapper, C first.\n128\tpub fn both_w<F: Copy>(name: &str) -> (F, F) {\n129\t    (cwfn(name), rfn(name))\n130\t}\n131\t\n132\t// ---------------------------------------------------------------------------\n133\t// bit-exact comparisons\n134\t// ---------------------------------------------------------------------------\n135\t\n136\tpub fn f32_eq(a: f32, b: f32) -> bool {\n137\t    a.to_bits() == b.to_bits()\n138\t}\n139\t\n140\tpub fn f64_eq(a: f64, b: f64) -> bool {\n141\t    a.to_bits() == b.to_bits()\n142\t}\n143\t\n144\t#[track_caller]\n145\tpub fn assert_f32(ctx: &str, c: f32, r: f32) {\n146\t    assert!(\n147\t        f32_eq(c, r),\n148\t        \"{ctx}: C returned {c:?} (0x{:08x}) but Rust returned {r:?} (0x{:08x})\",\n149\t        c.to_bits(),\n150\t        r.to_bits()\n151\t    );\n152\t}\n153\t\n154\t#[track_caller]\n155\tpub fn assert_f64(ctx: &str, c: f64, r: f64) {\n156\t    assert!(\n157\t        f64_eq(c, r),\n158\t        \"{ctx}: C returned {c:?} (0x{:016x}) but Rust returned {r:?} (0x{:016x})\",\n159\t        c.to_bits(),\n160\t        r.to_bits()\n161\t    );\n162\t}\n163\t\n164\t#[track_caller]\n165\tpub fn assert_vec(ctx: &str, c: &[f32], r: &[f32]) {\n166\t    assert_eq!(c.len(), r.len());\n167\t    for i in 0..c.len() {\n168\t        assert!(\n169\t            f32_eq(c[i], r[i]),\n170\t            \"{ctx}: element {i} differs: C {:?} (0x{:08x}) vs Rust {:?} (0x{:08x})\\n  C   = {:?}\\n  Rust= {:?}\",\n171\t            c[i],\n172\t            c[i].to_bits(),\n173\t            r[i],\n174\t            r[i].to_bits(),\n175\t            c,\n176\t            r\n177\t        );\n178\t    }\n179\t}\n180\t\n181\t#[track_caller]\n182\tpub fn assert_int<T: PartialEq + std::fmt::Debug>(ctx: &str, c: T, r: T) {\n183\t    assert_eq!(c, r, \"{ctx}: C vs Rust\");\n184\t}\n185\t\n186\t// ---------------------------------------------------------------------------\n187\t// NaN payload ambiguity\n188\t// ---------------------------------------------------------------------------\n189\t//\n190\t// IEEE 754 and ISO C both leave it open which NaN a binary operation returns\n191\t// when *both* operands are NaN.  On x86-64 `addss`/`mulss` propagate the first\n192\t// source operand, and gcc -O0 does not choose the source operands in a\n193\t// consistent order (in `_DotProduct` the first product ends up as\n194\t// `mulss %xmm0,%xmm1` -- left operand first -- and the second as\n195\t// `mulss %xmm2,%xmm0` -- right operand first).  Reproducing that would mean\n196\t// encoding gcc's register allocation into the translation, so this suite\n197\t// compares NaN *payloads* only where the C result cannot be ambiguous.\n198\t//\n199\t// Two different NaN patterns can only meet when an operand NaN (whatever the\n200\t// caller passed in) meets a NaN manufactured by an invalid operation\n201\t// (`inf - inf`, `0 * inf`, ...), which on x86 is always the \"default\" NaN\n202\t// 0xffc00000.  That needs a NaN *and* an infinity (or a value whose square\n203\t// overflows to infinity) among the inputs; see NOTES.md.\n204\t\n205\t/// `|x| > 1.8e19` squares to +inf in `f32`.\n206\tconst OVERFLOWS_WHEN_SQUARED: f32 = 1.8e19;\n207\t\n208\t/// True when the inputs can make two *different* NaN bit patterns meet inside\n209\t/// one C expression, i.e. when the payload of the result is decided by gcc's\n210\t/// operand ordering rather than by the source code.\n211\tpub fn nan_payload_ambiguous(vals: &[f32]) -> bool {\n212\t    vals.iter().any(|v| v.is_nan())\n213\t        && vals\n214\t            .iter()\n215\t            .any(|v| v.is_infinite() || v.abs() > OVERFLOWS_WHEN_SQUARED)\n216\t}\n217\t\n218\t/// Bit-exact, except that two NaNs with different payloads compare equal.\n219\t#[track_caller]\n220\tpub fn assert_f32_soft(ctx: &str, c: f32, r: f32) {\n221\t    if c.is_nan() && r.is_nan() {\n222\t        return;\n223\t    }\n224\t    assert_f32(ctx, c, r);\n225\t}\n226\t\n227\t/// Bit-exact comparison of a result computed from `inputs`; falls back to\n228\t/// [`assert_f32_soft`] only when `inputs` make the NaN payload ambiguous.\n229\t#[track_caller]\n230\tpub fn check_f32(ctx: &str, inputs: &[f32], c: f32, r: f32) {\n231\t    if nan_payload_ambiguous(inputs) {\n232\t        assert_f32_soft(ctx, c, r);\n233\t    } else {\n234\t        assert_f32(ctx, c, r);\n235\t    }\n236\t}\n237\t\n238\t/// Vector flavour of [`check_f32`].\n239\t#[track_caller]\n240\tpub fn check_vec(ctx: &str, inputs: &[f32], c: &[f32], r: &[f32]) {\n241\t    if nan_payload_ambiguous(inputs) {\n242\t        assert_eq!(c.len(), r.len());\n243\t        for i in 0..c.len() {\n244\t            assert_f32_soft(&format!(\"{ctx}[{i}]\"), c[i], r[i]);\n245\t        }\n246\t    } else {\n247\t        assert_vec(ctx, c, r);\n248\t    }\n249\t}\n250\t\n251\t// ---------------------------------------------------------------------------\n252\t// deterministic randomness\n253\t// ---------------------------------------------------------------------------\n254\t\n255\t/// xorshift64* -- small, fast, fully reproducible from a fixed seed.\n256\tpub struct Rng(u64);\n257\t\n258\t/// Values that are interesting to every routine in the library: the identity\n259\t/// elements, both zeroes, both infinities, a canonical NaN, denormals, the\n260\t/// extremes of the exponent range, and the angle constants the code compares\n261\t/// against.\n262\t///\n263\t/// Only ONE NaN bit pattern appears here on purpose: when two NaNs with\n264\t/// different payloads meet in a single expression, which payload survives is\n265\t/// decided by the operand order the compiler happened to pick for `addss` /\n266\t/// `mulss`, and gcc -O0 does not even pick it consistently within one\n267\t/// expression (see `NOTES.md`).  Single-NaN propagation, which is what real\n268\t/// callers hit, is order independent and is covered here and by the dedicated\n269\t/// NaN-payload tests.\n270\tpub const INTERESTING: &[f32] = &[\n271\t    0.0,\n272\t    -0.0,\n273\t    1.0,\n274\t    -1.0,\n275\t    0.5,\n276\t    -0.5,\n277\t    2.0,\n278\t    -2.0,\n279\t    3.0,\n280\t    255.0,\n281\t    1.0 / 255.0,\n282\t    90.0,\n283\t    -90.0,\n284\t    180.0,\n285\t    -180.0,\n286\t    270.0,\n287\t    360.0,\n288\t    -360.0,\n289\t    99999.0,\n290\t    -99999.0,\n291\t    65536.0,\n292\t    32768.0,\n293\t    0.999_999_94,\n294\t    1.000_000_1,\n295\t    f32::MIN_POSITIVE,\n296\t    -f32::MIN_POSITIVE,\n297\t    1e-45, // smallest denormal\n298\t    -1e-45,\n299\t    1e-30,\n300\t    1e30,\n301\t    -1e30,\n302\t    f32::MAX,\n303\t    -f32::MAX,\n304\t    f32::INFINITY,\n305\t    f32::NEG_INFINITY,\n306\t    f32::NAN,\n307\t];\n308\t\n309\timpl Rng {\n310\t    pub fn new(seed: u64) -> Self {\n311\t        Rng(seed | 1)\n312\t    }\n313\t\n314\t    pub fn next_u64(&mut self) -> u64 {\n315\t        let mut x = self.0;\n316\t        x ^= x >> 12;\n317\t        x ^= x << 25;\n318\t        x ^= x >> 27;\n319\t        self.0 = x;\n320\t        x.wrapping_mul(0x2545_F491_4F6C_DD1D)\n321\t    }\n322\t\n323\t    pub fn next_u32(&mut self) -> u32 {\n324\t        (self.next_u64() >> 32) as u32\n325\t    }\n326\t\n327\t    /// uniform in `0..n`\n328\t    pub fn below(&mut self, n: u32) -> u32 {\n329\t        self.next_u32() % n\n330\t    }\n331\t\n332\t    pub fn bool(&mut self) -> bool {\n333\t        self.next_u32() & 1 != 0\n334\t    }\n335\t\n336\t    /// A float from [`INTERESTING`], or a random bit pattern with a random\n337\t    /// exponent (so denormals, huge and tiny values all show up), never a\n338\t    /// non-canonical NaN.\n339\t    pub fn f32_any(&mut self) -> f32 {\n340\t        match self.below(3) {\n341\t            0 => INTERESTING[self.below(INTERESTING.len() as u32) as usize],\n342\t            1 => {\n343\t                let bits = self.next_u32();\n344\t                let v = f32::from_bits(bits);\n345\t                if v.is_nan() {\n346\t                    f32::NAN\n347\t                } else {\n348\t                    v\n349\t                }\n350\t            }\n351\t            _ => self.f32_finite(),\n352\t        }\n353\t    }\n354\t\n355\t    /// A finite float with a random sign, a random exponent in a \"sane\" range\n356\t    /// and a random mantissa.\n357\t    pub fn f32_finite(&mut self) -> f32 {\n358\t        let sign = (self.next_u32() & 1) << 31;\n359\t        // biased exponent 1..=253 -> no infinities, no NaN\n360\t        let exp = 1 + self.below(253);\n361\t        let mant = self.next_u32() & 0x7f_ffff;\n362\t        f32::from_bits(sign | (exp << 23) | mant)\n363\t    }\n364\t\n365\t    /// A finite float in `[-mag, mag]`, uniform in the mantissa.\n366\t    pub fn f32_mag(&mut self, mag: f32) -> f32 {\n367\t        let u = (self.next_u32() >> 8) as f32 / (1u32 << 24) as f32; // [0,1)\n368\t        let v = mag * (2.0 * u - 1.0);\n369\t        if self.below(16) == 0 {\n370\t            // hit the exact boundaries now and then\n371\t            if self.bool() {\n372\t                mag\n373\t            } else {\n374\t                -mag\n375\t            }\n376\t        } else {\n377\t            v\n378\t        }\n379\t    }\n380\t\n381\t    /// A float in `[-1, 1]` (typical normalized-vector component).\n382\t    pub fn f32_unit(&mut self) -> f32 {\n383\t        self.f32_mag(1.0)\n384\t    }\n385\t\n386\t    pub fn vec3_any(&mut self) -> [f32; 3] {\n387\t        [self.f32_any(), self.f32_any(), self.f32_any()]\n388\t    }\n389\t\n390\t    pub fn vec3_finite(&mut self) -> [f32; 3] {\n391\t        [self.f32_finite(), self.f32_finite(), self.f32_finite()]\n392\t    }\n393\t\n394\t    pub fn vec3_mag(&mut self, mag: f32) -> [f32; 3] {\n395\t        [self.f32_mag(mag), self.f32_mag(mag), self.f32_mag(mag)]\n396\t    }\n397\t\n398\t    pub fn vec4_any(&mut self) -> [f32; 4] {\n399\t        [\n400\t            self.f32_any(),\n401\t            self.f32_any(),\n402\t            self.f32_any(),\n403\t            self.f32_any(),\n404\t        ]\n405\t    }\n406\t\n407\t    /// A vec3 that contains AT MOST one NaN (see [`INTERESTING`]).\n408\t    pub fn vec3_any_1nan(&mut self) -> [f32; 3] {\n409\t        let mut v = self.vec3_any();\n410\t        let mut seen = false;\n411\t        for x in v.iter_mut() {\n412\t            if x.is_nan() {\n413\t                if seen {\n414\t                    *x = 1.0;\n415\t                } else {\n416\t                    seen = true;\n417\t                }\n418\t            }\n419\t        }\n420\t        v\n421\t    }\n422\t\n423\t    /// A \"unit-ish\" direction vector, occasionally exactly axial or degenerate.\n424\t    pub fn dir(&mut self) -> [f32; 3] {\n425\t        match self.below(8) {\n426\t            0 => [1.0, 0.0, 0.0],\n427\t            1 => [0.0, 1.0, 0.0],\n428\t            2 => [0.0, 0.0, 1.0],\n429\t            3 => [0.0, 0.0, 0.0],\n430\t            4 => [-1.0, 0.0, 0.0],\n431\t            _ => {\n432\t                let v = [self.f32_unit(), self.f32_unit(), self.f32_unit()];\n433\t                v\n434\t            }\n435\t        }\n436\t    }\n437\t\n438\t    pub fn i32_any(&mut self) -> i32 {\n439\t        match self.below(4) {\n440\t            0 => {\n441\t                const POOL: &[i32] = &[\n442\t                    0,\n443\t                    1,\n444\t                    -1,\n445\t                    2,\n446\t                    -2,\n447\t                    3,\n448\t                    7,\n449\t                    8,\n450\t                    127,\n451\t                    128,\n452\t                    -128,\n453\t                    -129,\n454\t                    255,\n455\t                    256,\n456\t                    32767,\n457\t                    32768,\n458\t                    -32768,\n459\t                    -32769,\n460\t                    65535,\n461\t                    65536,\n462\t                    i32::MAX,\n463\t                    i32::MIN,\n464\t                    i32::MAX - 1,\n465\t                    i32::MIN + 1,\n466\t                ];\n467\t                POOL[self.below(POOL.len() as u32) as usize]\n468\t            }\n469\t            1 => self.next_u32() as i32,\n470\t            2 => (self.next_u32() % 512) as i32 - 256,\n471\t            _ => (self.next_u32() % 65536) as i32,\n472\t        }\n473\t    }\n474\t}\n475\t"}]},"parent_tool_use_id":"toolu_bdrk_01K5jGuJUfGMrBPtJB44XHbU","session_id":"bf9d36cb-13a4-40a8-a93d-48ad7b006df9","uuid":"5030aafc-c7cd-4987-9950-941858bdac8d","timestamp":"2026-08-20T13:45:05.439Z","subagent_type":"general-purpose","task_description":"Write q_shared wrapper + data tests"}
