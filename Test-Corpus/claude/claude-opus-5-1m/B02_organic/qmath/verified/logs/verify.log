        assert_int(&format!(\"PlaneFromPoints(all=={p:?}) qfalse\"), got, 0);\n343\t            degenerate_seen += 4;\n344\t        }\n345\t    }\n346\t    // collinear: c = a + t*(b - a)\n347\t    for _ in 0..2000 {\n348\t        let a = rng.vec3_mag(100.0);\n349\t        let d = rng.vec3_mag(100.0);\n350\t        let b = [a[0] + d[0], a[1] + d[1], a[2] + d[2]];\n351\t        let t = match rng.below(6) {\n352\t            0 => 2.0f32,\n353\t            1 => -1.0,\n354\t            2 => 0.5,\n355\t            3 => 3.0,\n356\t            4 => -0.25,\n357\t            _ => rng.f32_mag(4.0),\n358\t        };\n359\t        let cv = [a[0] + d[0] * t, a[1] + d[1] * t, a[2] + d[2] * t];"}]},"parent_tool_use_id":"toolu_bdrk_01PqgGZDVkADyukTKaEnPx7K","session_id":"bf9d36cb-13a4-40a8-a93d-48ad7b006df9","uuid":"e322f150-63f9-4867-a405-e6247ca14c5b","timestamp":"2026-08-20T13:53:00.415Z","subagent_type":"general-purpose","task_description":"Write plane/dir differential tests"}
