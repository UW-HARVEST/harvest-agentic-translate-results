{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017ZTCB9RwMdAxTXVWXHBn9S","type":"tool_result","content":"1\t//! Differential tests for the scalar entry points of `q_math.c`\n2\t//! (CONFIGS.md rows 1-16).\n3\t//!\n4\t//! Every call goes through `dlsym` on both shared objects.\n5\t\n6\tmod harness;\n7\t\n8\tuse core::ffi::{c_int, c_uint};\n9\tuse harness::*;\n10\t\n11\ttype F1 = unsafe extern \"C\" fn(f32) -> f32;\n12\ttype F2 = unsafe extern \"C\" fn(f32, f32) -> f32;\n13\ttype F3 = unsafe extern \"C\" fn(f32, f32, f32) -> f32;\n14\t\n15\t// ---------------------------------------------------------------------------\n16\t// Q_rand / Q_random / Q_crandom  -- stateful through an int* seed\n17\t// ---------------------------------------------------------------------------\n18\t\n19\t#[test]\n20\tfn q_rand_sequences() {\n21\t    type F = unsafe extern \"C\" fn(*mut c_int) -> c_int;\n22\t    let (c, r): (F, F) = both(\"Q_rand\");\n23\t\n24\t    // every interesting seed, then long random sequences: `69069 * seed + 1`\n25\t    // overflows a signed int, which is UB in C but wraps with gcc.\n26\t    let mut seeds: Vec<i32> = vec![\n27\t        0,\n28\t        1,\n29\t        -1,\n30\t        2,\n31\t        -2,\n32\t        1234,\n33\t        i32::MAX,\n34\t        i32::MIN,\n35\t        i32::MAX - 1,\n36\t        i32::MIN + 1,\n37\t        0x5f3759df,\n38\t        -0x5f3759df,\n39\t    ];\n40\t    let mut rng = Rng::new(0x9E3779B97F4A7C15);\n41\t    for _ in 0..64 {\n42\t        seeds.push(rng.i32_any());\n43\t    }\n44\t\n45\t    for s in seeds {\n46\t        let mut sc = s;\n47\t        let mut sr = s;\n48\t        for step in 0..200 {\n49\t            let vc = unsafe { c(&mut sc) };\n50\t            let vr = unsafe { r(&mut sr) };\n51\t            assert_int(&format!(\"Q_rand(seed={s}) step {step} result\"), vc, vr);\n52\t            assert_int(&format!(\"Q_rand(seed={s}) step {step} *seed\"), sc, sr);\n53\t        }\n54\t    }\n55\t}\n56\t\n57\t#[test]\n58\tfn q_random_and_crandom_sequences() {\n59\t    type F = unsafe extern \"C\" fn(*mut c_int) -> f32;\n60\t    let (crandom_c, crandom_r): (F, F) = both(\"Q_crandom\");\n61\t    let (random_c, random_r): (F, F) = both(\"Q_random\");\n62\t\n63\t    let mut rng = Rng::new(2);\n64\t    let mut seeds: Vec<i32> = vec![0, 1, -1, i32::MAX, i32::MIN, 42];\n65\t    for _ in 0..64 {\n66\t        seeds.push(rng.i32_any());\n67\t    }\n68\t\n69\t    for s in seeds {\n70\t        let (mut sc, mut sr) = (s, s);\n71\t        for step in 0..100 {\n72\t            let vc = unsafe { random_c(&mut sc) };\n73\t            let vr = unsafe { random_r(&mut sr) };\n74\t            assert_f32(&format!(\"Q_random(seed={s}) step {step}\"), vc, vr);\n75\t            assert_int(&format!(\"Q_random(seed={s}) step {step} *seed\"), sc, sr);\n76\t        }\n77\t        let (mut sc, mut sr) = (s, s);\n78\t        for step in 0..100 {\n79\t            let vc = unsafe { crandom_c(&mut sc) };\n80\t            let vr = unsafe { crandom_r(&mut sr) };\n81\t            assert_f32(&format!(\"Q_crandom(seed={s}) step {step}\"), vc, vr);\n82\t            assert_int(&format!(\"Q_crandom(seed={s}) step {step} *seed\"), sc, sr);\n83\t        }\n84\t    }\n85\t}\n86\t\n87\t// ---------------------------------------------------------------------------\n88\t// ClampChar / ClampShort  -- full boundary sweep\n89\t// ---------------------------------------------------------------------------\n90\t\n91\t#[test]\n92\tfn clamp_char() {\n93\t    type F = unsafe extern \"C\" fn(c_int) -> i8;\n94\t    let (c, r): (F, F) = both(\"ClampChar\");\n95\t\n96\t    let mut vals: Vec<i32> = (-300..=300).collect();\n97\t    vals.extend([i32::MIN, i32::MIN + 1, i32::MAX, i32::MAX - 1, -129, -128, 127, 128]);\n98\t    let mut rng = Rng::new(3);\n99\t    for _ in 0..2000 {\n100\t        vals.push(rng.i32_any());\n101\t    }\n102\t    for v in vals {\n103\t        assert_int(&format!(\"ClampChar({v})\"), unsafe { c(v) }, unsafe { r(v) });\n104\t    }\n105\t}\n106\t\n107\t#[test]\n108\tfn clamp_short() {\n109\t    type F = unsafe extern \"C\" fn(c_int) -> i16;\n110\t    let (c, r): (F, F) = both(\"ClampShort\");\n111\t\n112\t    let mut vals: Vec<i32> = (-40000..=-32000).step_by(7).collect();\n113\t    vals.extend((32000..=40000).step_by(7));\n114\t    vals.extend([\n115\t        i32::MIN,\n116\t        i32::MIN + 1,\n117\t        i32::MAX,\n118\t        i32::MAX - 1,\n119\t        -32769,\n120\t        -32768,\n121\t        32767,\n122\t        32768,\n123\t        0,\n124\t    ]);\n125\t    let mut rng = Rng::new(4);\n126\t    for _ in 0..2000 {\n127\t        vals.push(rng.i32_any());\n128\t    }\n129\t    for v in vals {\n130\t        assert_int(&format!(\"ClampShort({v})\"), unsafe { c(v) }, unsafe { r(v) });\n131\t    }\n132\t}\n133\t\n134\t// ---------------------------------------------------------------------------\n135\t// Q_rsqrt / Q_fabs\n136\t// ---------------------------------------------------------------------------\n137\t\n138\t#[test]\n139\tfn q_rsqrt_all_shapes() {\n140\t    let (c, r): (F1, F1) = both(\"Q_rsqrt\");\n141\t    let mut rng = Rng::new(5);\n142\t\n143\t    for &v in INTERESTING {\n144\t        assert_f32(&format!(\"Q_rsqrt({v:?})\"), unsafe { c(v) }, unsafe { r(v) });\n145\t    }\n146\t    for _ in 0..20000 {\n147\t        let v = rng.f32_any();\n148\t        assert_f32(&format!(\"Q_rsqrt(0x{:08x})\", v.to_bits()), unsafe { c(v) }, unsafe {\n149\t            r(v)\n150\t        });\n151\t    }\n152\t    // exhaustive-ish sweep of the exponent range, mantissa 0 and mantissa max\n153\t    for exp in 0u32..=255 {\n154\t        for mant in [0u32, 1, 0x400000, 0x7fffff] {\n155\t            for sign in [0u32, 1] {\n156\t                let v = f32::from_bits((sign << 31) | (exp << 23) | mant);\n157\t                assert_f32(\n158\t                    &format!(\"Q_rsqrt(0x{:08x})\", v.to_bits()),\n159\t                    unsafe { c(v) },\n160\t                    unsafe { r(v) },\n161\t                );\n162\t            }\n163\t        }\n164\t    }\n165\t}\n166\t\n167\t#[test]\n168\tfn q_fabs_all_shapes() {\n169\t    let (c, r): (F1, F1) = both(\"Q_fabs\");\n170\t    let mut rng = Rng::new(6);\n171\t\n172\t    for &v in INTERESTING {\n173\t        assert_f32(&format!(\"Q_fabs({v:?})\"), unsafe { c(v) }, unsafe { r(v) });\n174\t    }\n175\t    // Q_fabs is pure bit manipulation, so any bit pattern (including every\n176\t    // NaN payload) must round-trip identically.\n177\t    for _ in 0..20000 {\n178\t        let v = f32::from_bits(rng.next_u32());\n179\t        assert_f32(&format!(\"Q_fabs(0x{:08x})\", v.to_bits()), unsafe { c(v) }, unsafe {\n180\t            r(v)\n181\t        });\n182\t    }\n183\t}\n184\t\n185\t// ---------------------------------------------------------------------------\n186\t// angle helpers\n187\t// ---------------------------------------------------------------------------\n188\t\n189\t#[test]\n190\tfn lerp_angle() {\n191\t    let (c, r): (F3, F3) = both(\"LerpAngle\");\n192\t    let mut rng = Rng::new(7);\n193\t\n194\t    let interesting = [\n195\t        0.0f32, 1.0, -1.0, 180.0, -180.0, 180.000_01, -180.000_01, 179.999_98, 360.0, -360.0,\n196\t        90.0, 270.0, 1e30, -1e30, f32::INFINITY, f32::NEG_INFINITY, f32::NAN, -0.0,\n197\t    ];\n198\t    for &from in &interesting {\n199\t        for &to in &interesting {\n200\t            for &frac in &[0.0f32, 0.5, 1.0, -1.0, 2.0, f32::NAN, f32::INFINITY] {\n201\t                check_f32(\n202\t                    &format!(\"LerpAngle({from:?},{to:?},{frac:?})\"),\n203\t                    &[from, to, frac],\n204\t                    unsafe { c(from, to, frac) },\n205\t                    unsafe { r(from, to, frac) },\n206\t                );\n207\t            }\n208\t        }\n209\t    }\n210\t    for _ in 0..20000 {\n211\t        let (from, to, frac) = (rng.f32_any(), rng.f32_any(), rng.f32_any());\n212\t        check_f32(\n213\t            &format!(\"LerpAngle({from:?},{to:?},{frac:?})\"),\n214\t            &[from, to, frac],\n215\t            unsafe { c(from, to, frac) },\n216\t            unsafe { r(from, to, frac) },\n217\t        );\n218\t    }\n219\t}\n220\t\n221\t/// `AngleSubtract` loops `while (a > 180) a -= 360;`, so it only terminates for\n222\t/// arguments whose difference stays small enough that subtracting 360 changes\n223\t/// the value (see ERRORS.md row 13).  Everything in range is compared here.\n224\t#[test]\n225\tfn angle_subtract() {\n226\t    let (c, r): (F2, F2) = both(\"AngleSubtract\");\n227\t    let mut rng = Rng::new(8);\n228\t\n229\t    let interesting = [\n230\t        0.0f32, -0.0, 1.0, -1.0, 180.0, -180.0, 180.000_01, -180.000_01, 360.0, -360.0, 359.0,\n231\t        -359.0, 540.0, -540.0, 720.0, 1e6, -1e6, f32::NAN,\n232\t    ];\n233\t    for &a1 in &interesting {\n234\t        for &a2 in &interesting {\n235\t            if !(a1 - a2).is_nan() && (a1 - a2).abs() > 1e7 {\n236\t                continue; // would spin for a very long time in BOTH impls\n237\t            }\n238\t            assert_f32(\n239\t                &format!(\"AngleSubtract({a1:?},{a2:?})\"),\n240\t                unsafe { c(a1, a2) },\n241\t                unsafe { r(a1, a2) },\n242\t            );\n243\t        }\n244\t    }\n245\t    for _ in 0..20000 {\n246\t        let (a1, a2) = (rng.f32_mag(1e5), rng.f32_mag(1e5));\n247\t        assert_f32(\n248\t            &format!(\"AngleSubtract({a1:?},{a2:?})\"),\n249\t            unsafe { c(a1, a2) },\n250\t            unsafe { r(a1, a2) },\n251\t        );\n252\t    }\n253\t}\n254\t\n255\t#[test]\n256\tfn angles_subtract() {\n257\t    type F = unsafe extern \"C\" fn(*mut f32, *mut f32, *mut f32) -> ();\n258\t    let (c, r): (F, F) = both(\"AnglesSubtract\");\n259\t    let mut rng = Rng::new(9);\n260\t\n261\t    for _ in 0..5000 {\n262\t        let v1 = rng.vec3_mag(1e5);\n263\t        let v2 = rng.vec3_mag(1e5);\n264\t        let mut oc = [0.0f32; 3];\n265\t        let mut or_ = [0.0f32; 3];\n266\t        let (mut a, mut b) = (v1, v2);\n267\t        unsafe { c(a.as_mut_ptr(), b.as_mut_ptr(), oc.as_mut_ptr()) };\n268\t        let (mut a, mut b) = (v1, v2);\n269\t        unsafe { r(a.as_mut_ptr(), b.as_mut_ptr(), or_.as_mut_ptr()) };\n270\t        assert_vec(&format!(\"AnglesSubtract({v1:?},{v2:?})\"), &oc, &or_);\n271\t    }\n272\t}\n273\t\n274\t#[test]\n275\tfn angle_mod_normalize_delta() {\n276\t    let (mod_c, mod_r): (F1, F1) = both(\"AngleMod\");\n277\t    let (n360_c, n360_r): (F1, F1) = both(\"AngleNormalize360\");\n278\t    let (n180_c, n180_r): (F1, F1) = both(\"AngleNormalize180\");\n279\t    let (delta_c, delta_r): (F2, F2) = both(\"AngleDelta\");\n280\t    let mut rng = Rng::new(10);\n281\t\n282\t    // The `(int)` cast inside these functions overflows for |angle| >~ 1.18e7,\n283\t    // which is exactly where gcc's cvttsd2si returns 0x80000000; the sweep and\n284\t    // the INTERESTING pool both cross that boundary.\n285\t    let mut vals: Vec<f32> = INTERESTING.to_vec();\n286\t    vals.extend([\n287\t        11796480.0,   // 2^31 / 182.044...\n288\t        11796479.0,\n289\t        11796481.0,\n290\t        -11796480.0,\n291\t        -11796481.0,\n292\t        1.1796e7,\n293\t        2.0e7,\n294\t        -2.0e7,\n295\t        359.999_97,\n296\t        360.000_03,\n297\t        180.0,\n298\t        180.000_01,\n299\t        -180.0,\n300\t        1e-7,\n301\t    ]);\n302\t    for _ in 0..20000 {\n303\t        vals.push(match rng.below(3) {\n304\t            0 => rng.f32_any(),\n305\t            1 => rng.f32_mag(720.0),\n306\t            _ => rng.f32_mag(2.0e7),\n307\t        });\n308\t    }\n309\t\n310\t    for v in vals {\n311\t        let ctx = format!(\"({v:?} / 0x{:08x})\", v.to_bits());\n312\t        assert_f32(&format!(\"AngleMod{ctx}\"), unsafe { mod_c(v) }, unsafe { mod_r(v) });\n313\t        assert_f32(\n314\t            &format!(\"AngleNormalize360{ctx}\"),\n315\t            unsafe { n360_c(v) },\n316\t            unsafe { n360_r(v) },\n317\t        );\n318\t        assert_f32(\n319\t            &format!(\"AngleNormalize180{ctx}\"),\n320\t            unsafe { n180_c(v) },\n321\t            unsafe { n180_r(v) },\n322\t        );\n323\t    }\n324\t\n325\t    for _ in 0..20000 {\n326\t        let (a, b) = (rng.f32_any(), rng.f32_any());\n327\t        assert_f32(\n328\t            &format!(\"AngleDelta({a:?},{b:?})\"),\n329\t            unsafe { delta_c(a, b) },\n330\t            unsafe { delta_r(a, b) },\n331\t        );\n332\t    }\n333\t}\n334\t\n335\t// ---------------------------------------------------------------------------\n336\t// Q_log2\n337\t// ---------------------------------------------------------------------------\n338\t\n339\t/// Negative inputs make the C loop spin forever (`-1 >> 1 == -1`), see\n340\t/// ERRORS.md row 20 -- only non-negative values are compared.\n341\t#[test]\n342\tfn q_log2_non_negative() {\n343\t    type F = unsafe extern \"C\" fn(c_int) -> c_int;\n344\t    let (c, r): (F, F) = both(\"Q_log2\");\n345\t\n346\t    let mut vals: Vec<i32> = (0..=1024).collect();\n347\t    for b in 0..31 {\n348\t        vals.push(1 << b);\n349\t        vals.push((1 << b) - 1);\n350\t        vals.push((1 << b) + 1);\n351\t    }\n352\t    vals.push(i32::MAX);\n353\t    let mut rng = Rng::new(11);\n354\t    for _ in 0..2000 {\n355\t        vals.push((rng.next_u32() >> 1) as i32);\n356\t    }\n357\t    for v in vals {\n358\t        if v < 0 {\n359\t            continue;\n360\t        }\n361\t        assert_int(&format!(\"Q_log2({v})\"), unsafe { c(v) }, unsafe { r(v) });\n362\t    }\n363\t}\n364\t\n365\t// ---------------------------------------------------------------------------\n366\t// ColorBytes3 / ColorBytes4\n367\t// ---------------------------------------------------------------------------\n368\t\n369\t/// `ColorBytes3` never initialises the top byte of its result (see ERRORS.md\n370\t/// row 6), so only the 24 bits it does write are compared.\n371\t#[test]\n372\tfn color_bytes3() {\n373\t    type F = unsafe extern \"C\" fn(f32, f32, f32) -> c_uint;\n374\t    let (c, r): (F, F) = both(\"ColorBytes3\");\n375\t    let mut rng = Rng::new(12);\n376\t\n377\t    for _ in 0..20000 {\n378\t        let (a, b, d) = (rng.f32_any(), rng.f32_any(), rng.f32_any());\n379\t        let vc = unsafe { c(a, b, d) } & 0x00ff_ffff;\n380\t        let vr = unsafe { r(a, b, d) } & 0x00ff_ffff;\n381\t        assert_int(&format!(\"ColorBytes3({a:?},{b:?},{d:?})\"), vc, vr);\n382\t    }\n383\t    for &a in INTERESTING {\n384\t        for &b in &[0.0f32, 1.0, 0.5, -1.0, 1e30, f32::NAN] {\n385\t            let vc = unsafe { c(a, b, a) } & 0x00ff_ffff;\n386\t            let vr = unsafe { r(a, b, a) } & 0x00ff_ffff;\n387\t            assert_int(&format!(\"ColorBytes3({a:?},{b:?},{a:?})\"), vc, vr);\n388\t        }\n389\t    }\n390\t}\n391\t\n392\t#[test]\n393\tfn color_bytes4() {\n394\t    type F = unsafe extern \"C\" fn(f32, f32, f32, f32) -> c_uint;\n395\t    let (c, r): (F, F) = both(\"ColorBytes4\");\n396\t    let mut rng = Rng::new(13);\n397\t\n398\t    for _ in 0..20000 {\n399\t        let (a, b, d, e) = (rng.f32_any(), rng.f32_any(), rng.f32_any(), rng.f32_any());\n400\t        assert_int(\n401\t            &format!(\"ColorBytes4({a:?},{b:?},{d:?},{e:?})\"),\n402\t            unsafe { c(a, b, d, e) },\n403\t            unsafe { r(a, b, d, e) },\n404\t        );\n405\t    }\n406\t    // the exact 0..255 ramp used by real callers, plus the rounding boundaries\n407\t    for i in 0..=255 {\n408\t        let v = i as f32 / 255.0;\n409\t        assert_int(\n410\t            &format!(\"ColorBytes4(ramp {i})\"),\n411\t            unsafe { c(v, v, v, v) },\n412\t            unsafe { r(v, v, v, v) },\n413\t        );\n414\t    }\n415\t    for &v in &[\n416\t        -0.001f32, 0.0, 0.001, 0.5, 0.999, 1.0, 1.001, 1.5, 255.0, 256.0, 1e9, -1e9, f32::NAN,\n417\t        f32::INFINITY, f32::NEG_INFINITY,\n418\t    ] {\n419\t        assert_int(\n420\t            &format!(\"ColorBytes4({v:?})\"),\n421\t            unsafe { c(v, v, v, v) },\n422\t            unsafe { r(v, v, v, v) },\n423\t        );\n424\t    }\n425\t}\n426\t"}]},"parent_tool_use_id":"toolu_bdrk_01PqgGZDVkADyukTKaEnPx7K","session_id":"bf9d36cb-13a4-40a8-a93d-48ad7b006df9","uuid":"d551c13c-1cbb-4565-932b-3b0bef3cb9c9","timestamp":"2026-08-20T13:45:04.722Z","subagent_type":"general-purpose","task_description":"Write plane/dir differential tests"}
