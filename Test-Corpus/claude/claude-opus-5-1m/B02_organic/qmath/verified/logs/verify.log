{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01SzfUVGkfrH9pJfH8KDBNiX","type":"tool_result","content":"120\t}\n121\t\n122\t/// Both implementations of the same symbol, C first.\n123\tpub fn both<F: Copy>(name: &str) -> (F, F) {\n124\t    (cfn(name), rfn(name))\n125\t}\n126\t\n127\t/// Both implementations of a `w_*` wrapper, C first.\n128\tpub fn both_w<F: Copy>(name: &str) -> (F, F) {\n129\t    (cwfn(name), rfn(name))\n130\t}\n131\t\n132\t// ---------------------------------------------------------------------------\n133\t// bit-exact comparisons\n134\t// ---------------------------------------------------------------------------\n135\t\n136\tpub fn f32_eq(a: f32, b: f32) -> bool {\n137\t    a.to_bits() == b.to_bits()\n138\t}\n139\t\n140\tpub fn f64_eq(a: f64, b: f64) -> bool {\n141\t    a.to_bits() == b.to_bits()\n142\t}\n143\t\n144\t#[track_caller]\n145\tpub fn assert_f32(ctx: &str, c: f32, r: f32) {\n146\t    assert!(\n147\t        f32_eq(c, r),\n148\t        \"{ctx}: C returned {c:?} (0x{:08x}) but Rust returned {r:?} (0x{:08x})\",\n149\t        c.to_bits(),\n150\t        r.to_bits()\n151\t    );\n152\t}\n153\t\n154\t#[track_caller]\n155\tpub fn assert_f64(ctx: &str, c: f64, r: f64) {\n156\t    assert!(\n157\t        f64_eq(c, r),\n158\t        \"{ctx}: C returned {c:?} (0x{:016x}) but Rust returned {r:?} (0x{:016x})\",\n159\t        c.to_bits(),\n160\t        r.to_bits()\n161\t    );\n162\t}\n163\t\n164\t#[track_caller]\n165\tpub fn assert_vec(ctx: &str, c: &[f32], r: &[f32]) {\n166\t    assert_eq!(c.len(), r.len());\n167\t    for i in 0..c.len() {\n168\t        assert!(\n169\t            f32_eq(c[i], r[i]),\n170\t            \"{ctx}: element {i} differs: C {:?} (0x{:08x}) vs Rust {:?} (0x{:08x})\\n  C   = {:?}\\n  Rust= {:?}\",\n171\t            c[i],\n172\t            c[i].to_bits(),\n173\t            r[i],\n174\t            r[i].to_bits(),\n175\t            c,\n176\t            r\n177\t        );\n178\t    }\n179\t}\n180\t\n181\t#[track_caller]\n182\tpub fn assert_int<T: PartialEq + std::fmt::Debug>(ctx: &str, c: T, r: T) {\n183\t    assert_eq!(c, r, \"{ctx}: C vs Rust\");\n184\t}\n185\t\n186\t// ---------------------------------------------------------------------------\n187\t// NaN payload ambiguity\n188\t// ---------------------------------------------------------------------------\n189\t//\n190\t// IEEE 754 and ISO C both leave it open which NaN a binary operation returns\n191\t// when *both* operands are NaN.  On x86-64 `addss`/`mulss` propagate the first\n192\t// source operand, and gcc -O0 does not choose the source operands in a\n193\t// consistent order (in `_DotProduct` the first product ends up as\n194\t// `mulss %xmm0,%xmm1` -- left operand first -- and the second as\n195\t// `mulss %xmm2,%xmm0` -- right operand first).  Reproducing that would mean\n196\t// encoding gcc's register allocation into the translation, so this suite\n197\t// compares NaN *payloads* only where the C result cannot be ambiguous.\n198\t//\n199\t// Two different NaN patterns can meet in two ways, both of which need a\n200\t// non-finite (or overflowing) input: an invalid operation manufactures the x86\n201\t// \"default\" NaN 0xffc00000 (`inf - inf`, `0 * inf`, `sin(inf)`, ...), and a\n202\t// negation of a NaN (`-forward[0]`, `-d`, `-sp`, ...) flips its sign bit into\n203\t// another distinct pattern.  See NOTES.md.\n204\t\n205\t/// `|x| > 1.8e19` squares to +inf in `f32`.\n206\tconst OVERFLOWS_WHEN_SQUARED: f32 = 1.8e19;\n207\t\n208\t/// Bit-exact, except that two NaNs with different payloads compare equal.\n209\t#[track_caller]\n210\tpub fn assert_f32_soft(ctx: &str, c: f32, r: f32) {\n211\t    if c.is_nan() && r.is_nan() {\n212\t        return;\n213\t    }\n214\t    assert_f32(ctx, c, r);\n215\t}\n216\t\n217\t/// True when a *second* NaN bit pattern can appear in the computation, so that\n218\t/// the surviving payload is decided by gcc's operand ordering:\n219\t///\n220\t/// * a non-finite or overflowing input can manufacture the x86 default NaN\n221\t///   `0xffc00000` (`inf - inf`, `0 * inf`, `sin(inf)`, ...);\n222\t/// * a NaN input can be negated (`-forward[0]`, `-d`, `-sp`, `-1*cr*-sy`, ...),\n223\t///   which flips its sign bit and produces a second, different pattern.\n224\t///\n225\t/// Only finite, non-overflowing inputs can therefore be guaranteed to keep NaN\n226\t/// payloads reproducible -- and for those no NaN exists in the first place.\n227\tpub fn nan_payload_ambiguous(vals: &[f32]) -> bool {\n228\t    vals.iter()\n229\t        .any(|v| !v.is_finite() || v.abs() > OVERFLOWS_WHEN_SQUARED)\n230\t}\n231\t\n232\t/// Bit-exact comparison of a result computed from `inputs`.\n233\t///\n234\t/// The ONLY tolerated difference is the payload/sign of a NaN when both sides\n235\t/// produced a NaN *and* the inputs allow two different NaN patterns to meet in\n236\t/// one expression (see [`nan_payload_ambiguous`] and NOTES.md \"Deviation 1\").\n237\t/// Everything else -- the NaN-ness itself, every finite result, every sign of\n238\t/// zero, every infinity -- is compared bit for bit.\n239\t#[track_caller]\n240\tpub fn check_f32(ctx: &str, inputs: &[f32], c: f32, r: f32) {\n241\t    if c.is_nan() && r.is_nan() && nan_payload_ambiguous(inputs) {\n242\t        return;\n243\t    }\n244\t    assert_f32(ctx, c, r);\n245\t}\n246\t\n247\t/// Vector flavour of [`check_f32`].\n248\t#[track_caller]\n249\tpub fn check_vec(ctx: &str, inputs: &[f32], c: &[f32], r: &[f32]) {\n250\t    assert_eq!(c.len(), r.len());\n251\t    let ambiguous = nan_payload_ambiguous(inputs);\n252\t    for i in 0..c.len() {\n253\t        if ambiguous && c[i].is_nan() && r[i].is_nan() {\n254\t            continue;\n255\t        }\n256\t        assert!(\n257\t            f32_eq(c[i], r[i]),\n258\t            \"{ctx}: element {i} differs: C {:?} (0x{:08x}) vs Rust {:?} (0x{:08x})\\n  C   = {:?}\\n  Rust= {:?}\",\n259\t            c[i],\n260\t            c[i].to_bits(),\n261\t            r[i],\n262\t            r[i].to_bits(),\n263\t            c,\n264\t            r\n265\t        );\n266\t    }\n267\t}\n268\t\n269\t// ---------------------------------------------------------------------------\n270\t// non-reentrant C functions\n271\t// ---------------------------------------------------------------------------\n272\t\n273\t/// `AngleVectors` keeps its six intermediate sines and cosines in\n274\t/// **`static float`** variables (q_math.c:946: \"static to help MS compiler fp\n275\t/// bugs\"), so the C implementation is not reentrant: two threads calling it --\n276\t/// directly or through `AnglesToAxis` -- overwrite each other's `sy`/`cy`/... and\n277\t/// then read the other thread's values.  `cargo test` runs the tests of one\n278\t/// binary on parallel threads, so every test that reaches `AngleVectors` must\n279\t/// hold this lock to make the C side well defined.\n280\t///\n281\t/// (The six statics are always assigned before they are read, so for any single\n282\t/// call they behave exactly like locals, which is what the Rust translation\n283\t/// uses -- see NOTES.md.)\n284\tpub fn angle_vectors_guard() -> std::sync::MutexGuard<'static, ()> {\n285\t    static LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());\n286\t    LOCK.lock().unwrap_or_else(|e| e.into_inner())\n287\t}\n288\t\n289\t// ---------------------------------------------------------------------------\n290\t// deterministic randomness\n291\t// ---------------------------------------------------------------------------\n292\t\n293\t/// xorshift64* -- small, fast, fully reproducible from a fixed seed.\n294\tpub struct Rng(u64);\n295\t\n296\t/// Values that are interesting to every routine in the library: the identity\n297\t/// elements, both zeroes, both infinities, a canonical NaN, denormals, the\n298\t/// extremes of the exponent range, and the angle constants the code compares\n299\t/// against."}]},"parent_tool_use_id":"toolu_bdrk_01DyAy6ZjHwM1cxNNX7xT5F5","session_id":"bf9d36cb-13a4-40a8-a93d-48ad7b006df9","uuid":"8ee8a988-5e72-4096-9c64-da4e5800587c","timestamp":"2026-08-20T13:59:22.974Z","subagent_type":"general-purpose","task_description":"Write angle/matrix differential tests"}
