{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FE5LYhbBYKyjyuj3STPqxq","type":"tool_result","content":"1\t//! Translation of the parts of `c_src/inc/q_shared.h` that carry executable\n2\t//! meaning: the `typedef`s, the vector macros, the `static ID_INLINE`\n3\t//! functions and the numeric constants.\n4\t//!\n5\t//! Everything is expressed in `f32` (`typedef float vec_t;`) exactly like the C\n6\t//! code, so the results are bit-for-bit identical on targets where\n7\t//! `FLT_EVAL_METHOD == 0` (x86-64 SSE, aarch64).\n8\t//!\n9\t//! The `static ID_INLINE` functions have internal linkage in C, so they are not\n10\t//! part of the shared library's symbol table.  They are still translated here\n11\t//! (they are used by `q_math.c`) and additionally re-exported under a `w_`\n12\t//! prefix by [`crate::wrappers`] so that the differential test suite can reach\n13\t//! them.\n14\t\n15\t#![allow(non_camel_case_types)]\n16\t#![allow(non_snake_case)]\n17\t#![allow(non_upper_case_globals)]\n18\t\n19\tuse core::ffi::c_int;\n20\t\n21\t/// `typedef float vec_t;`\n22\tpub type vec_t = f32;\n23\t\n24\t// ---------------------------------------------------------------------------\n25\t// numeric constants\n26\t// ---------------------------------------------------------------------------\n27\t\n28\t/// `#define NUMVERTEXNORMALS 162`\n29\tpub const NUMVERTEXNORMALS: usize = 162;\n30\t\n31\t/// `#define PITCH 0` (up / down)\n32\tpub const PITCH: usize = 0;\n33\t/// `#define YAW 1` (left / right)\n34\tpub const YAW: usize = 1;\n35\t/// `#define ROLL 2` (fall over)\n36\tpub const ROLL: usize = 2;\n37\t\n38\t/// `#define nanmask (255<<23)`\n39\tpub const nanmask: i32 = 255 << 23;\n40\t\n41\t/// `q_shared.h` guards its own `M_PI` with `#ifndef M_PI`, and `<math.h>` is\n42\t/// included first, so the `double` `M_PI` from libm wins.  Every use of `M_PI`\n43\t/// in this library therefore happens in `f64`.\n44\tpub const M_PI: f64 = core::f64::consts::PI;\n45\t\n46\t/// `PLANE_X`\n47\tpub const PLANE_X: c_int = 0;\n48\t/// `PLANE_Y`\n49\tpub const PLANE_Y: c_int = 1;\n50\t/// `PLANE_Z`\n51\tpub const PLANE_Z: c_int = 2;\n52\t/// `PLANE_NON_AXIAL`\n53\tpub const PLANE_NON_AXIAL: c_int = 3;\n54\t\n55\t/// `typedef enum {qfalse, qtrue} qboolean;` — an `enum` is an `int` here.\n56\tpub const qfalse: c_int = 0;\n57\t/// see [`qfalse`]\n58\tpub const qtrue: c_int = 1;\n59\t\n60\t// ---------------------------------------------------------------------------\n61\t// structs\n62\t// ---------------------------------------------------------------------------\n63\t\n64\t/// ```c\n65\t/// typedef struct cplane_s {\n66\t///     vec3_t  normal;\n67\t///     float   dist;\n68\t///     byte    type;      // for fast side tests: 0,1,2 = axial, 3 = nonaxial\n69\t///     byte    signbits;  // signx + (signy<<1) + (signz<<2)\n70\t///     byte    pad[2];\n71\t/// } cplane_t;\n72\t/// ```\n73\t#[repr(C)]\n74\t#[derive(Clone, Copy, Debug, Default, PartialEq)]\n75\tpub struct cplane_t {\n76\t    pub normal: [vec_t; 3],\n77\t    pub dist: f32,\n78\t    pub type_: u8,\n79\t    pub signbits: u8,\n80\t    pub pad: [u8; 2],\n81\t}\n82\t\n83\t// ---------------------------------------------------------------------------\n84\t// C float -> integer conversion, with the exact behaviour of the generated\n85\t// x86-64 code\n86\t// ---------------------------------------------------------------------------\n87\t\n88\t/// `(int)f` for a `float` operand.\n89\t///\n90\t/// C leaves the result undefined when the truncated value does not fit into an\n91\t/// `int`; gcc emits `cvttss2si`, which yields the \"integer indefinite\" value\n92\t/// `0x80000000` for NaN and for every out-of-range operand.  Rust's `as i32`\n93\t/// saturates instead, so the conversion has to be spelled out.\n94\t#[inline]\n95\tpub fn f32_to_i32(f: f32) -> i32 {\n96\t    if f.is_nan() || f >= 2147483648.0f32 || f < -2147483648.0f32 {\n97\t        i32::MIN\n98\t    } else {\n99\t        f as i32\n100\t    }\n101\t}\n102\t\n103\t/// `(int)d` for a `double` operand (`cvttsd2si`), see [`f32_to_i32`].\n104\t#[inline]\n105\tpub fn f64_to_i32(d: f64) -> i32 {\n106\t    if d.is_nan() || d >= 2147483648.0f64 || d < -2147483648.0f64 {\n107\t        i32::MIN\n108\t    } else {\n109\t        d as i32\n110\t    }\n111\t}\n112\t\n113\t/// `(byte)f`: gcc emits `cvttss2si` into a 32-bit register and stores its low\n114\t/// byte, so an out-of-range or NaN operand produces `0x80000000 & 0xff == 0`.\n115\t#[inline]\n116\tpub fn f32_to_byte(f: f32) -> u8 {\n117\t    (f32_to_i32(f) & 0xff) as u8\n118\t}\n119\t\n120\t// ---------------------------------------------------------------------------\n121\t// the vector macros\n122\t// ---------------------------------------------------------------------------\n123\t//\n124\t// `#if 1` is taken in q_shared.h, so DotProduct/VectorSubtract/... are the\n125\t// macro versions (the `_`-prefixed functions in q_math.c are unused by the\n126\t// library itself but still exported).\n127\t\n128\t/// `#define DotProduct(x,y) ((x)[0]*(y)[0]+(x)[1]*(y)[1]+(x)[2]*(y)[2])`\n129\t#[inline]\n130\tpub unsafe fn DotProduct(x: *const vec_t, y: *const vec_t) -> vec_t {\n131\t    *x.add(0) * *y.add(0) + *x.add(1) * *y.add(1) + *x.add(2) * *y.add(2)\n132\t}\n133\t\n134\t/// `#define VectorSubtract(a,b,c) ((c)[0]=(a)[0]-(b)[0],...)`\n135\t#[inline]\n136\tpub unsafe fn VectorSubtract(a: *const vec_t, b: *const vec_t, c: *mut vec_t) {\n137\t    *c.add(0) = *a.add(0) - *b.add(0);\n138\t    *c.add(1) = *a.add(1) - *b.add(1);\n139\t    *c.add(2) = *a.add(2) - *b.add(2);\n140\t}\n141\t\n142\t/// `#define VectorAdd(a,b,c) ((c)[0]=(a)[0]+(b)[0],...)`\n143\t#[inline]\n144\tpub unsafe fn VectorAdd(a: *const vec_t, b: *const vec_t, c: *mut vec_t) {\n145\t    *c.add(0) = *a.add(0) + *b.add(0);\n146\t    *c.add(1) = *a.add(1) + *b.add(1);\n147\t    *c.add(2) = *a.add(2) + *b.add(2);\n148\t}\n149\t\n150\t/// `#define VectorCopy(a,b) ((b)[0]=(a)[0],(b)[1]=(a)[1],(b)[2]=(a)[2])`\n151\t#[inline]\n152\tpub unsafe fn VectorCopy(a: *const vec_t, b: *mut vec_t) {\n153\t    *b.add(0) = *a.add(0);\n154\t    *b.add(1) = *a.add(1);\n155\t    *b.add(2) = *a.add(2);\n156\t}\n157\t\n158\t/// `#define VectorScale(v,s,o) ((o)[0]=(v)[0]*(s),...)`\n159\t#[inline]\n160\tpub unsafe fn VectorScale(v: *const vec_t, s: vec_t, o: *mut vec_t) {\n161\t    *o.add(0) = *v.add(0) * s;\n162\t    *o.add(1) = *v.add(1) * s;\n163\t    *o.add(2) = *v.add(2) * s;\n164\t}\n165\t\n166\t/// `#define VectorMA(v,s,b,o) ((o)[0]=(v)[0]+(b)[0]*(s),...)`\n167\t#[inline]\n168\tpub unsafe fn VectorMA(v: *const vec_t, s: vec_t, b: *const vec_t, o: *mut vec_t) {\n169\t    *o.add(0) = *v.add(0) + *b.add(0) * s;\n170\t    *o.add(1) = *v.add(1) + *b.add(1) * s;\n171\t    *o.add(2) = *v.add(2) + *b.add(2) * s;\n172\t}\n173\t\n174\t/// `#define VectorClear(a) ((a)[0]=(a)[1]=(a)[2]=0)`\n175\t#[inline]\n176\tpub unsafe fn VectorClear(a: *mut vec_t) {\n177\t    *a.add(0) = 0.0;\n178\t    *a.add(1) = 0.0;\n179\t    *a.add(2) = 0.0;\n180\t}\n181\t\n182\t/// `#define VectorNegate(a,b) ((b)[0]=-(a)[0],(b)[1]=-(a)[1],(b)[2]=-(a)[2])`\n183\t#[inline]\n184\tpub unsafe fn VectorNegate(a: *const vec_t, b: *mut vec_t) {\n185\t    *b.add(0) = -*a.add(0);\n186\t    *b.add(1) = -*a.add(1);\n187\t    *b.add(2) = -*a.add(2);\n188\t}\n189\t\n190\t/// `#define VectorSet(v,x,y,z) ((v)[0]=(x),(v)[1]=(y),(v)[2]=(z))`\n191\t#[inline]\n192\tpub unsafe fn VectorSet(v: *mut vec_t, x: vec_t, y: vec_t, z: vec_t) {\n193\t    *v.add(0) = x;\n194\t    *v.add(1) = y;\n195\t    *v.add(2) = z;\n196\t}\n197\t\n198\t/// `#define Vector4Copy(a,b) ((b)[0]=(a)[0],...,(b)[3]=(a)[3])`\n199\t#[inline]\n200\tpub unsafe fn Vector4Copy(a: *const vec_t, b: *mut vec_t) {\n201\t    *b.add(0) = *a.add(0);\n202\t    *b.add(1) = *a.add(1);\n203\t    *b.add(2) = *a.add(2);\n204\t    *b.add(3) = *a.add(3);\n205\t}\n206\t\n207\t/// `#define SnapVector(v) {v[0]=((int)(v[0]));v[1]=((int)(v[1]));v[2]=((int)(v[2]));}`\n208\t#[inline]\n209\tpub unsafe fn SnapVector(v: *mut vec_t) {\n210\t    *v.add(0) = f32_to_i32(*v.add(0)) as vec_t;\n211\t    *v.add(1) = f32_to_i32(*v.add(1)) as vec_t;\n212\t    *v.add(2) = f32_to_i32(*v.add(2)) as vec_t;\n213\t}\n214\t\n215\t/// `#define IS_NAN(x) (((*(int *)&x)&nanmask)==nanmask)`\n216\t#[inline]\n217\tpub fn IS_NAN(x: vec_t) -> bool {\n218\t    ((x.to_bits() as i32) & nanmask) == nanmask\n219\t}\n220\t\n221\t/// `#define SQRTFAST(x) ((x) * Q_rsqrt(x))`\n222\t#[inline]\n223\tpub fn SQRTFAST(x: vec_t) -> vec_t {\n224\t    x * crate::q_math::Q_rsqrt(x)\n225\t}\n226\t\n227\t/// `#define DEG2RAD(a) (((a) * M_PI) / 180.0F)` — `M_PI` is a `double`, so the\n228\t/// whole expression is evaluated in `f64`.\n229\t#[inline]\n230\tpub fn DEG2RAD(a: f32) -> f64 {\n231\t    (a as f64 * M_PI) / 180.0f32 as f64\n232\t}\n233\t\n234\t/// `#define RAD2DEG(a) (((a) * 180.0f) / M_PI)`\n235\t#[inline]\n236\tpub fn RAD2DEG(a: f32) -> f64 {\n237\t    (a as f64 * 180.0f32 as f64) / M_PI\n238\t}\n239\t\n240\t/// `#define ANGLE2SHORT(x) ((int)((x)*65536/360) & 65535)`\n241\t#[inline]\n242\tpub fn ANGLE2SHORT(x: f32) -> c_int {\n243\t    // (x)*65536 is float*int -> float; /360 is float/int -> float.\n244\t    f32_to_i32(x * 65536.0f32 / 360.0f32) & 65535\n245\t}\n246\t\n247\t/// `#define SHORT2ANGLE(x) ((x)*(360.0/65536))`\n248\t#[inline]\n249\tpub fn SHORT2ANGLE(x: c_int) -> f64 {\n250\t    x as f64 * (360.0f64 / 65536.0f64)\n251\t}\n252\t\n253\t/// `#define ColorIndex(c) (((c) - '0') & 7)`\n254\t#[inline]\n255\tpub fn ColorIndex(c: c_int) -> c_int {\n256\t    (c - '0' as c_int) & 7\n257\t}\n258\t\n259\t/// `#define Square(x) ((x)*(x))`\n260\t#[inline]\n261\tpub fn Square(x: f32) -> f32 {\n262\t    x * x\n263\t}\n264\t\n265\t/// `#define PlaneTypeForNormal(x) (x[0] == 1.0 ? PLANE_X : (x[1] == 1.0 ? PLANE_Y : (x[2] == 1.0 ? PLANE_Z : PLANE_NON_AXIAL)))`\n266\t#[inline]\n267\tpub unsafe fn PlaneTypeForNormal(x: *const vec_t) -> c_int {\n268\t    if *x.add(0) as f64 == 1.0 {\n269\t        PLANE_X\n270\t    } else if *x.add(1) as f64 == 1.0 {\n271\t        PLANE_Y\n272\t    } else if *x.add(2) as f64 == 1.0 {\n273\t        PLANE_Z\n274\t    } else {\n275\t        PLANE_NON_AXIAL\n276\t    }\n277\t}\n278\t\n279\t/// `#define MAKERGB(v,r,g,b) v[0]=r;v[1]=g;v[2]=b`\n280\t#[inline]\n281\tpub unsafe fn MAKERGB(v: *mut vec_t, r: vec_t, g: vec_t, b: vec_t) {\n282\t    *v.add(0) = r;\n283\t    *v.add(1) = g;\n284\t    *v.add(2) = b;\n285\t}\n286\t\n287\t/// `#define MAKERGBA(v,r,g,b,a) v[0]=r;v[1]=g;v[2]=b;v[3]=a`\n288\t#[inline]\n289\tpub unsafe fn MAKERGBA(v: *mut vec_t, r: vec_t, g: vec_t, b: vec_t, a: vec_t) {\n290\t    *v.add(0) = r;\n291\t    *v.add(1) = g;\n292\t    *v.add(2) = b;\n293\t    *v.add(3) = a;\n294\t}\n295\t\n296\t// ---------------------------------------------------------------------------\n297\t// the `static ID_INLINE` functions\n298\t// ---------------------------------------------------------------------------\n299\t\n300\t/// ```c\n301\t/// static ID_INLINE int VectorCompare( const vec3_t v1, const vec3_t v2 ) {\n302\t///     if (v1[0] != v2[0] || v1[1] != v2[1] || v1[2] != v2[2]) {\n303\t///         return 0;\n304\t///     }\n305\t///     return 1;\n306\t/// }\n307\t/// ```\n308\t#[inline]\n309\tpub unsafe fn VectorCompare(v1: *const vec_t, v2: *const vec_t) -> c_int {\n310\t    if *v1.add(0) != *v2.add(0) || *v1.add(1) != *v2.add(1) || *v1.add(2) != *v2.add(2) {\n311\t        return 0;\n312\t    }\n313\t    1\n314\t}\n315\t\n316\t/// ```c\n317\t/// static ID_INLINE vec_t VectorLength( const vec3_t v ) {\n318\t///     return (vec_t)sqrt (v[0]*v[0] + v[1]*v[1] + v[2]*v[2]);\n319\t/// }\n320\t/// ```\n321\t#[inline]\n322\tpub unsafe fn VectorLength(v: *const vec_t) -> vec_t {\n323\t    ((*v.add(0) * *v.add(0) + *v.add(1) * *v.add(1) + *v.add(2) * *v.add(2)) as f64).sqrt() as vec_t\n324\t}\n325\t\n326\t/// ```c\n327\t/// static ID_INLINE vec_t VectorLengthSquared( const vec3_t v ) {\n328\t///     return (v[0]*v[0] + v[1]*v[1] + v[2]*v[2]);\n329\t/// }\n330\t/// ```\n331\t#[inline]\n332\tpub unsafe fn VectorLengthSquared(v: *const vec_t) -> vec_t {\n333\t    *v.add(0) * *v.add(0) + *v.add(1) * *v.add(1) + *v.add(2) * *v.add(2)\n334\t}\n335\t\n336\t/// ```c\n337\t/// static ID_INLINE vec_t Distance( const vec3_t p1, const vec3_t p2 ) {\n338\t///     vec3_t  v;\n339\t///     VectorSubtract (p2, p1, v);\n340\t///     return VectorLength( v );\n341\t/// }\n342\t/// ```\n343\t#[inline]\n344\tpub unsafe fn Distance(p1: *const vec_t, p2: *const vec_t) -> vec_t {\n345\t    let mut v: [vec_t; 3] = [0.0; 3];\n346\t    VectorSubtract(p2, p1, v.as_mut_ptr());\n347\t    VectorLength(v.as_ptr())\n348\t}\n349\t\n350\t/// ```c\n351\t/// static ID_INLINE vec_t DistanceSquared( const vec3_t p1, const vec3_t p2 ) {\n352\t///     vec3_t  v;\n353\t///     VectorSubtract (p2, p1, v);\n354\t///     return v[0]*v[0] + v[1]*v[1] + v[2]*v[2];\n355\t/// }\n356\t/// ```\n357\t#[inline]\n358\tpub unsafe fn DistanceSquared(p1: *const vec_t, p2: *const vec_t) -> vec_t {\n359\t    let mut v: [vec_t; 3] = [0.0; 3];\n360\t    VectorSubtract(p2, p1, v.as_mut_ptr());\n361\t    v[0] * v[0] + v[1] * v[1] + v[2] * v[2]\n362\t}\n363\t\n364\t/// ```c\n365\t/// static ID_INLINE void VectorNormalizeFast( vec3_t v )\n366\t/// {\n367\t///     float ilength;\n368\t///     ilength = Q_rsqrt( DotProduct( v, v ) );\n369\t///     v[0] *= ilength;\n370\t///     v[1] *= ilength;\n371\t///     v[2] *= ilength;\n372\t/// }\n373\t/// ```\n374\t#[inline]\n375\tpub unsafe fn VectorNormalizeFast(v: *mut vec_t) {\n376\t    let ilength: f32 = crate::q_math::Q_rsqrt(DotProduct(v, v));\n377\t\n378\t    *v.add(0) = *v.add(0) * ilength;\n379\t    *v.add(1) = *v.add(1) * ilength;\n380\t    *v.add(2) = *v.add(2) * ilength;\n381\t}\n382\t\n383\t/// ```c\n384\t/// static ID_INLINE void VectorInverse( vec3_t v ){\n385\t///     v[0] = -v[0];\n386\t///     v[1] = -v[1];\n387\t///     v[2] = -v[2];\n388\t/// }\n389\t/// ```\n390\t#[inline]\n391\tpub unsafe fn VectorInverse(v: *mut vec_t) {\n392\t    *v.add(0) = -*v.add(0);\n393\t    *v.add(1) = -*v.add(1);\n394\t    *v.add(2) = -*v.add(2);\n395\t}\n396\t\n397\t/// ```c\n398\t/// static ID_INLINE void CrossProduct( const vec3_t v1, const vec3_t v2, vec3_t cross ) {\n399\t///     cross[0] = v1[1]*v2[2] - v1[2]*v2[1];\n400\t///     cross[1] = v1[2]*v2[0] - v1[0]*v2[2];\n401\t///     cross[2] = v1[0]*v2[1] - v1[1]*v2[0];\n402\t/// }\n403\t/// ```\n404\t#[inline]\n405\tpub unsafe fn CrossProduct(v1: *const vec_t, v2: *const vec_t, cross: *mut vec_t) {\n406\t    *cross.add(0) = *v1.add(1) * *v2.add(2) - *v1.add(2) * *v2.add(1);\n407\t    *cross.add(1) = *v1.add(2) * *v2.add(0) - *v1.add(0) * *v2.add(2);\n408\t    *cross.add(2) = *v1.add(0) * *v2.add(1) - *v1.add(1) * *v2.add(0);\n409\t}\n410\t"}]},"parent_tool_use_id":"toolu_bdrk_01K5jGuJUfGMrBPtJB44XHbU","session_id":"bf9d36cb-13a4-40a8-a93d-48ad7b006df9","uuid":"318075a8-e659-4669-a36a-736d87c5bfd3","timestamp":"2026-08-20T13:45:24.496Z","subagent_type":"general-purpose","task_description":"Write q_shared wrapper + data tests"}
