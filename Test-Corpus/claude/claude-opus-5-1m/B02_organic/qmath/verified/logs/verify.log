{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01E4gCzp3LmJFKHGxEdyMiN1","type":"tool_result","content":"925\t            &vr,\n926\t        );\n927\t    }\n928\t}\n929\t\n930\t// ---------------------------------------------------------------------------\n931\t// row 47 -- RotateAroundDirection\n932\t// ---------------------------------------------------------------------------\n933\t\n934\t#[test]\n935\tfn rotate_around_direction() {\n936\t    let (c, r): (RotateDirFn, RotateDirFn) = both(\"RotateAroundDirection\");\n937\t    let mut rng = Rng::new(0x0047_000a);\n938\t\n939\t    // `axis[1]` and `axis[2]` start as sentinels: `if (yaw)` skipping the\n940\t    // rotation must still leave the raw PerpendicularVector result behind, and\n941\t    // both rows are always overwritten.\n942\t    let call = |f: RotateDirFn, a0: &[f32; 3], yaw: f32| -> [f32; 9] {\n943\t        let mut axis: [[f32; 3]; 3] = [*a0, SENT_R, SENT_U];\n944\t        unsafe { f(axis.as_mut_ptr(), yaw) };\n945\t        flat9(&axis)\n946\t    };\n947\t\n948\t    let yaws: &[f32] = &[\n949\t        0.0, // `if ( yaw )` false -> rotation skipped\n950\t        -0.0, // ditto (ERRORS.md row 40)\n951\t        1e-45, // smallest non-zero: rotation IS performed\n952\t        -1e-45,\n953\t        1.0,\n954\t        -1.0,\n955\t        45.0,\n956\t        90.0,\n957\t        -90.0,\n958\t        180.0,\n959\t        -180.0,\n960\t        270.0,\n961\t        360.0,\n962\t        -360.0,\n963\t        1e30,\n964\t        f32::MAX,\n965\t        f32::INFINITY,\n966\t        f32::NEG_INFINITY,\n967\t        f32::NAN,\n968\t    ];\n969\t\n970\t    let a0s = dir_shapes(&mut rng, 0);\n971\t    for a0 in &a0s {\n972\t        for &yaw in yaws {\n973\t            let vc = call(c, a0, yaw);\n974\t            let vr = call(r, a0, yaw);\n975\t            let inputs = [a0[0], a0[1], a0[2], yaw];\n976\t            check_vec(\n977\t                &format!(\n978\t                    \"RotateAroundDirection(axis[0]={a0:?}, yaw={yaw:?} (0x{:08x}))\",\n979\t                    yaw.to_bits()\n980\t                ),\n981\t                &inputs,\n982\t                &vc,\n983\t                &vr,\n984\t            );\n985\t            if yaw == 0.0 {\n986\t                // the rotation is skipped: axis[1] must be exactly what\n987\t                // PerpendicularVector wrote, in both implementations\n988\t                let (pc, pr): (PerpFn, PerpFn) = both(\"PerpendicularVector\");\n989\t                let mut sc = SENT_R;\n990\t                let mut sr = SENT_R;\n991\t                let ab = *a0;\n992\t                unsafe { pc(sc.as_mut_ptr(), ab.as_ptr()) };\n993\t                unsafe { pr(sr.as_mut_ptr(), ab.as_ptr()) };\n994\t                check_vec(\n995\t                    &format!(\"RotateAroundDirection(axis[0]={a0:?}, yaw={yaw:?}) axis[1] == PerpendicularVector\"),\n996\t                    &inputs,\n997\t                    &sc,\n998\t                    &vc[3..6],\n999\t                );\n1000\t                check_vec(\n1001\t                    &format!(\"RotateAroundDirection(axis[0]={a0:?}, yaw={yaw:?}) axis[1] == PerpendicularVector (Rust)\"),\n1002\t                    &inputs,\n1003\t                    &sr,\n1004\t                    &vr[3..6],\n1005\t                );\n1006\t            }\n1007\t        }\n1008\t    }\n1009\t\n1010\t    for iter in 0..6000 {\n1011\t        let a0 = match rng.below(4) {\n1012\t            0 => rng.dir(),\n1013\t            1 => rng.vec3_mag(1.0),\n1014\t            2 => rng.vec3_finite(),\n1015\t            _ => rng.vec3_any(),\n1016\t        };\n1017\t        let yaw = match rng.below(3) {\n1018\t            0 => rng.f32_mag(360.0),\n1019\t            1 => rng.f32_any(),\n1020\t            _ => yaws[rng.below(yaws.len() as u32) as usize],\n1021\t        };\n1022\t        let vc = call(c, &a0, yaw);\n1023\t        let vr = call(r, &a0, yaw);\n1024\t        let inputs = [a0[0], a0[1