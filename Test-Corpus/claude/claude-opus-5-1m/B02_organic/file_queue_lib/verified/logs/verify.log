d::env::current_exe().expect(\"current_exe\");\n    let dir = exe.parent().expect(\"exe dir\");\n    for cand in [dir.join(\"libdriver.so\"), dir.join(\"../libdriver.so\")] {\n        if cand.exists() {\n            return cand;\n        }\n    }\n    panic!(\"Rust libdriver.so not found next to {}\", exe.display());\n}\n\nstatic APIS: OnceLock<(Api, Api)> = OnceLock::new();\n\n/// `(c, rust)`\npub fn apis() -> (&'static Api, &'static Api) {\n    let (c, r) = APIS.get_or_init(|| unsafe {\n        (load(\"C\", c_so_path()), load(\"RUST\", rust_so_path()))\n    });\n    (c, r)\n}\n\n// ---------------------------------------------------------------------------\n// Comparable snapshots\n// ---------------------------------------------------------------------------\n\n#[derive(PartialEq, Eq, Clone)]\npub struct AlertSnap {","numLines":30,"startLine":233,"totalLines":959}}}
