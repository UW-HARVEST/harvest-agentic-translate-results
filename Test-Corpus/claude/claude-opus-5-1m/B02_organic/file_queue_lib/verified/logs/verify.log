{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WTrnt6N2UhLm6eE6D4j2wh","type":"tool_result","content":"1\t/* Copyright (C) 2015, Wazuh Inc.\n2\t * Copyright (C) 2009 Trend Micro Inc.\n3\t * All right reserved.\n4\t *\n5\t * This program is free software; you can redistribute it\n6\t * and/or modify it under the terms of the GNU General Public\n7\t * License (version 2) as published by the FSF - Free Software\n8\t * Foundation\n9\t */\n10\t\n11\t/* File monitoring functions */\n12\t\n13\t#include \"file-queue.h\"\n14\t#include \"read-alert.h\"\n15\t\n16\t#include <stdio.h>\n17\t#include <string.h>\n18\t#include <sys/time.h>\n19\t#include <errno.h>\n20\t\n21\t#define FSTAT_ERROR   \"(1118): Could not retrieve information of file '%s' due to [(%d)-(%s)].\"\n22\t#define FSEEK_ERROR   \"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\"\n23\t\n24\tvoid merror(const char *err_template, const char *file_name, int err, const char *err_msg) {\n25\t    char buffer[256];\n26\t    snprintf(buffer, sizeof(buffer), err_template, file_name, err, err_msg);\n27\t    fprintf(stderr, \"%s\\n\", buffer);\n28\t}\n29\t\n30\tstatic void file_sleep(void);\n31\tstatic void GetFile_Queue(file_queue *fileq) __attribute__((nonnull));\n32\tstatic int Handle_Queue(file_queue *fileq, int flags) __attribute__((nonnull));\n33\t\n34\t/* To translate between month (int) to month (char) */\n35\tstatic const char *(s_month[]) = {\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n36\t                                  \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"\n37\t                                 };\n38\t\n39\t\n40\tstatic void file_sleep() {\n41\t\n42\t    struct timeval fp_timeout;\n43\t\n44\t    fp_timeout.tv_sec = FQ_TIMEOUT;\n45\t    fp_timeout.tv_usec = 0;\n46\t\n47\t    /* Wait for the select timeout */\n48\t    select(0, NULL, NULL, NULL, &fp_timeout);\n49\t\n50\t    return;\n51\t}\n52\t\n53\t/* Get the file queue for that specific hour */\n54\tstatic void GetFile_Queue(file_queue *fileq)\n55\t{\n56\t    /* Create the logfile name */\n57\t    fileq->file_name[0] = '\\0';\n58\t    fileq->file_name[MAX_FQUEUE] = '\\0';\n59\t\n60\t    snprintf(fileq->file_name, MAX_FQUEUE, \"%s\", fileq->flags & CRALERT_FP_SET ? \"<stdin>\" : ALERTS_DAILY);\n61\t}\n62\t\n63\t/* Re Handle the file queue */\n64\tstatic int Handle_Queue(file_queue *fileq, int flags)\n65\t{\n66\t    /* Close if it is open */\n67\t    if (!(flags & CRALERT_FP_SET)) {\n68\t        if (fileq->fp) {\n69\t            fclose(fileq->fp);\n70\t            fileq->fp = NULL;\n71\t        }\n72\t\n73\t        /* We must be able to open the file, fseek and get the\n74\t         * time of change from it.\n75\t         */\n76\t        fileq->fp = fopen(fileq->file_name, \"r\");\n77\t        if (!fileq->fp) {\n78\t            /* Queue not available */\n79\t            return (0);\n80\t        }\n81\t    }\n82\t\n83\t    /* Seek to the end of the file */\n84\t    if (!(flags & CRALERT_READ_ALL)) {\n85\t        if (!fileq->fp) {\n86\t            return (0);\n87\t        }\n88\t\n89\t        if (fseek(fileq->fp, 0, SEEK_END) < 0) {\n90\t            merror(FSEEK_ERROR, fileq->file_name, errno, strerror(errno));\n91\t            fclose(fileq->fp);\n92\t            fileq->fp = NULL;\n93\t            return (-1);\n94\t        }\n95\t    }\n96\t\n97\t    /* File change time */\n98\t    if (fileq->fp) {\n99\t        if (fstat(fileno(fileq->fp), &fileq->f_status) < 0) {\n100\t            merror(FSTAT_ERROR, fileq->file_name, errno, strerror(errno));\n101\t            fclose(fileq->fp);\n102\t            fileq->fp = NULL;\n103\t            return (-1);\n104\t        }\n105\t    }\n106\t\n107\t    fileq->last_change = fileq->f_status.st_mtime;\n108\t\n109\t    return (1);\n110\t}\n111\t\n112\t/* Initiates the file monitoring */\n113\tint Init_FileQueue(file_queue *fileq, const struct tm *p, int flags)\n114\t{\n115\t    /* Initialize file_queue fields */\n116\t  