{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TCVqzJRu1zXkdEFKLgnMUg","type":"tool_result","content":"1\t//! Raw libc bindings and C-string helpers.\n2\t//!\n3\t//! The C library manipulates NUL terminated byte buffers with the classic\n4\t//! `<string.h>` primitives.  In order to guarantee byte-identical behaviour we\n5\t//! bind directly to libc for allocation / stdio (so that memory produced here\n6\t//! can be `free()`d by the caller, and so `FILE *` handles are interchangeable\n7\t//! with the ones the caller owns) and re-implement the pure scanning routines\n8\t//! as safe helpers over byte slices.\n9\t\n10\t#![allow(non_camel_case_types)]\n11\t\n12\tuse core::ffi::{c_char, c_int, c_long, c_uint, c_void};\n13\t\n14\t/// Opaque `FILE`.\n15\t#[repr(C)]\n16\tpub struct FILE {\n17\t    _private: [u8; 0],\n18\t}\n19\t\n20\tpub type time_t = i64;\n21\tpub type off_t = i64;\n22\t\n23\t#[repr(C)]\n24\t#[derive(Clone, Copy)]\n25\tpub struct timespec {\n26\t    pub tv_sec: i64,\n27\t    pub tv_nsec: i64,\n28\t}\n29\t\n30\t#[repr(C)]\n31\t#[derive(Clone, Copy)]\n32\tpub struct timeval {\n33\t    pub tv_sec: i64,\n34\t    pub tv_usec: i64,\n35\t}\n36\t\n37\t/// glibc x86_64 `struct stat` (size 144, `st_mtim` at offset 88).\n38\t#[repr(C)]\n39\t#[derive(Clone, Copy)]\n40\tpub struct stat {\n41\t    pub st_dev: u64,\n42\t    pub st_ino: u64,\n43\t    pub st_nlink: u64,\n44\t    pub st_mode: c_uint,\n45\t    pub st_uid: c_uint,\n46\t    pub st_gid: c_uint,\n47\t    pub __pad0: c_int,\n48\t    pub st_rdev: u64,\n49\t    pub st_size: off_t,\n50\t    pub st_blksize: i64,\n51\t    pub st_blocks: i64,\n52\t    pub st_atim: timespec,\n53\t    pub st_mtim: timespec,\n54\t    pub st_ctim: timespec,\n55\t    pub __glibc_reserved: [i64; 3],\n56\t}\n57\t\n58\t/// glibc `struct tm`.\n59\t#[repr(C)]\n60\t#[derive(Clone, Copy)]\n61\tpub struct tm {\n62\t    pub tm_sec: c_int,\n63\t    pub tm_min: c_int,\n64\t    pub tm_hour: c_int,\n65\t    pub tm_mday: c_int,\n66\t    pub tm_mon: c_int,\n67\t    pub tm_year: c_int,\n68\t    pub tm_wday: c_int,\n69\t    pub tm_yday: c_int,\n70\t    pub tm_isdst: c_int,\n71\t    pub tm_gmtoff: c_long,\n72\t    pub tm_zone: *const c_char,\n73\t}\n74\t\n75\tpub const SEEK_CUR: c_int = 1;\n76\tpub const SEEK_END: c_int = 2;\n77\tpub const EXIT_FAILURE: c_int = 1;\n78\t\n79\textern \"C\" {\n80\t    pub static mut stderr: *mut FILE;\n81\t\n82\t    pub fn calloc(num: usize, size: usize) -> *mut c_void;\n83\t    pub fn realloc(ptr: *mut c_void, new_size: usize) -> *mut c_void;\n84\t    pub fn free(ptr: *mut c_void);\n85\t    pub fn strdup(s: *const c_char) -> *mut c_char;\n86\t    pub fn strncpy(dst: *mut c_char, src: *const c_char, n: usize) -> *mut c_char;\n87\t    pub fn strerror(errnum: c_int) -> *mut c_char;\n88\t    pub fn strtol(nptr: *const c_char, endptr: *mut *mut c_char, base: c_int) -> c_long;\n89\t    pub fn exit(status: c_int) -> !;\n90\t\n91\t    pub fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;\n92\t    pub fn fclose(stream: *mut FILE) -> c_int;\n93\t    pub fn fgets(s: *mut c_char, size: c_int, stream: *mut FILE) -> *mut c_char;\n94\t    pub fn fseek(stream: *mut FILE, offset: c_long, whence: c_int) -> c_int;\n95\t    pub fn feof(stream: *mut FILE) -> c_int;\n96\t    pub fn clearerr(stream: *mut FILE);\n97\t    pub fn fileno(stream: *mut FILE) -> c_int;\n98\t    pub fn perror(s: *const c_char);\n99\t\n100\t    pub fn fstat(fd: c_int, buf: *mut stat) -> c_int;\n101\t    pub fn select(\n102\t        nfds: c_int,\n103\t        readfds: *mut c_void,\n104\t        writefds: *mut c_void,\n105\t        exceptfds: *mut c_void,\n106\t        timeout: *mut timeval,\n107\t    ) -> c_int;\n108\t\n109\t    pub fn __errno_location() -> *mut c_int;\n110\t\n111\t    pub fn fprintf(stream: *mut FILE, fmt: *const c_char, ...) -> c_int;\n112\t    pub fn snprintf(s: *mut c_char, n: usize, fmt: *const c_char, ...) -> c_int;\n113\t}\n114\t\n115\t/// `errno`\n116\t#[inline]\n117\tpub unsafe fn errno() -> c_int {\n118\t    *__errno_location()\n119\t}\n120\t\n121\t// ---------------------------------------------------------------------------\n122\t// Safe C-string helpers over a byte buffer.\n123\t//\n124\t// Every helper treats an out-of-range index as a NUL byte.  The buffers used by\n125\t// the translated code always have an explicit NUL terminator at their final\n126\t// index (mirroring `str[OS_MAXSTR] = '\\0'`), so a genuine C traversal can never\n127\t// walk past the end of the array; the fallback only exists to keep these\n128\t// helpers total.\n129\t// ---------------------------------------------------------------------------\n130\t\n131\t/// `strlen(&buf[start])`\n132\t#[inline]\n133\tpub fn c_len(buf: &[u8], start: usize) -> usize {\n134\t    let mut i = start;\n135\t    while i < buf.len() && buf[i] != 0 {\n136\t        i += 1;\n137\t    }\n138\t    i - start\n139\t}\n140\t\n141\t/// `strchr(&buf[start], ch)` -> index of the match.\n142\t///\n143\t/// Note that C's `strchr` can also match the terminating NUL; none of the call\n144\t/// sites in this library search for `'\\0'`, so searching stops at the\n145\t/// terminator.\n146\t#[inline]\n147\tpub fn c_chr(buf: &[u8], start: usize, ch: u8) -> Option<usize> {\n148\t    let mut i = start;\n149\t    while i < buf.len() && buf[i] != 0 {\n150\t        if buf[i] == ch {\n151\t            return Some(i);\n152\t        }\n153\t        i += 1;\n154\t    }\n155\t    None\n156\t}\n157\t\n158\t/// `strrchr(&buf[start], ch)` -> index of the last match.\n159\t#[inline]\n160\tpub fn c_rchr(buf: &[u8], start: usize, ch: u8) -> Option<usize> {\n161\t    let mut found = None;\n162\t    let mut i = start;\n163\t    while i < buf.len() && buf[i] != 0 {\n164\t        if buf[i] == ch {\n165\t            found = Some(i);\n166\t        }\n167\t        i += 1;\n168\t    }\n169\t    found\n170\t}\n171\t\n172\t/// `strstr(&buf[start], needle)` -> index of the match. `needle` must not be\n173\t/// empty and must not contain a NUL.\n174\tpub fn c_str_find(buf: &[u8], start: usize, needle: &[u8]) -> Option<usize> {\n175\t    let mut i = start;\n176\t    loop {\n177\t        // Try to match `needle` at `i`.\n178\t        let mut k = 0usize;\n179\t        loop {\n180\t            if k == needle.len() {\n181\t                return Some(i);\n182\t            }\n183\t            let b = if i + k < buf.len() { buf[i + k] } else { 0 };\n184\t            if b != needle[k] {\n185\t                break;\n186\t            }\n187\t            k += 1;\n188\t        }\n189\t        // No match here; advance unless we are sitting on the terminator.\n190\t        let b = if i < buf.len() { buf[i] } else { 0 };\n191\t        if b == 0 {\n192\t            return None;\n193\t        }\n194\t        i += 1;\n195\t    }\n196\t}\n197\t\n198\t/// `strncmp(lit, &buf[start], lit.len()) == 0`.\n199\t///\n200\t/// `lit` must not contain a NUL byte, which is true for every literal used by\n201\t/// the C sources; therefore the comparison is a plain prefix test with an\n202\t/// out-of-range byte behaving as a mismatching NUL.\n203\t#[inline]\n204\tpub fn c_ncmp_eq(buf: &[u8], start: usize, lit: &[u8]) -> bool {\n205\t    for (k, &want) in lit.iter().enumerate() {\n206\t        let got = match start.checked_add(k) {\n207\t            Some(i) if i < buf.len() => buf[i],\n208\t            _ => 0,\n209\t        };\n210\t        if got != want {\n211\t            return false;\n212\t        }\n213\t    }\n214\t    true\n215\t}\n216\t\n217\t/// `atoi(&buf[start])`.\n218\t///\n219\t/// GCC lowers `atoi` to `strtol(p, NULL, 10)` truncated to `int` (this is\n220\t/// visible in the compiled C object, whose only relocation for these calls is\n221\t/// against `strtol`).  Delegate to libc so that overflow clamping matches.\n222\t#[inline]\n223\tpub unsafe fn c_atoi(buf: &[u8], start: usize) -> c_int {\n224\t    debug_assert!(start < buf.len());\n225\t    strtol(\n226\t        buf.as_ptr().add(start) as *const c_char,\n227\t        core::ptr::null_mut(),\n228\t        10,\n229\t    ) as c_int\n230\t}\n231\t\n232\t// ---------------------------------------------------------------------------\n233\t// Raw-pointer helpers for heap allocated C strings.\n234\t// ---------------------------------------------------------------------------\n235\t\n236\t/// `strlen(p)`\n237\t#[inline]\n238\tpub unsafe fn raw_len(p: *const c_char) -> usize {\n239\t    let mut n = 0usize;\n240\t    while *p.add(n) != 0 {\n241\t        n += 1;\n242\t    }\n243\t    n\n244\t}\n245\t\n246\t/// `strrchr(p, ch)`\n247\t#[inline]\n248\tpub unsafe fn raw_rchr(p: *mut c_char, ch: u8) -> *mut c_char {\n249\t    let mut found: *mut c_char = core::ptr::null_mut();\n250\t    let mut i = 0usize;\n251\t    while *p.add(i) != 0 {\n252\t        if *p.add(i) as u8 == ch {\n253\t            found = p.add(i);\n254\t        }\n255\t        i += 1;\n256\t    }\n257\t    found\n258\t}\n259\t\n260\t/// `strstr(p, needle) != NULL`. `needle` must be non-empty and NUL free.\n261\tpub unsafe fn raw_contains(p: *const c_char, needle: &[u8]) -> bool {\n262\t    let hay_len = raw_len(p);\n263\t    if needle.len() > hay_len {\n264\t        return false;\n265\t    }\n266\t    'outer: for i in 0..=(hay_len - needle.len()) {\n267\t        for (k, &want) in needle.iter().enumerate() {\n268\t            if *p.add(i + k) as u8 != want {\n269\t                continue 'outer;\n270\t            }\n271\t        }\n272\t        return true;\n273\t    }\n274\t    false\n275\t}\n276\t\n277\t/// The `os_free(x)` macro: `if(x){free(x);x=NULL;};`\n278\t#[inline]\n279\tpub unsafe fn os_free_slot(slot: *mut *mut c_char) {\n280\t    if !(*slot).is_null() {\n281\t        free(*slot as *mut c_void);\n282\t        *slot = core::ptr::null_mut();\n283\t    }\n284\t}\n285\t"}]},"parent_tool_use_id":null,"session_id":"1ae76093-19c1-48bd-ad47-ef026a38794e","uuid":"8c48ef94-10df-4b78-aa96-6782056f1ae0","timestamp":"2026-08-20T08:29:07.409Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-I0kTQU/translated_rust/src/cbits.rs","content":"//! Raw libc bindings and C-string helpers.\n//!\n//! The C library manipulates NUL terminated byte buffers with the classic\n//! `<string.h>` primitives.  In order to guarantee byte-identical behaviour we\n//! bind directly to libc for allocation / stdio (so that memory produced here\n//! can be `free()`d by the caller, and so `FILE *` handles are interchangeable\n//! with the ones the caller owns) and re-implement the pure scanning routines\n//! as safe helpers over byte slices.\n\n#![allow(non_camel_case_types)]\n\nuse core::ffi::{c_char, c_int, c_long, c_uint, c_void};\n\n/// Opaque `FILE`.\n#[repr(C)]\npub struct FILE {\n    _private: [u8; 0],\n}\n\npub type time_t = i64;\npub type off_t = i64;\n\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct timespec {\n    pub tv_sec: i64,\n    pub tv_nsec: i64,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct timeval {\n    pub tv_sec: i64,\n    pub tv_usec: i64,\n}\n\n/// glibc x86_64 `struct stat` (size 144, `st_mtim` at offset 88).\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct stat {\n    pub st_dev: u64,\n    pub st_ino: u64,\n    pub st_nlink: u64,\n    pub st_mode: c_uint,\n    pub st_uid: c_uint,\n    pub st_gid: c_uint,\n    pub __pad0: c_int,\n    pub st_rdev: u64,\n    pub st_size: off_t,\n    pub st_blksize: i64,\n    pub st_blocks: i64,\n    pub st_atim: timespec,\n    pub st_mtim: timespec,\n    pub st_ctim: timespec,\n    pub __glibc_reserved: [i64; 3],\n}\n\n/// glibc `struct tm`.\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct tm {\n    pub tm_sec: c_int,\n    pub tm_min: c_int,\n    pub tm_hour: c_int,\n    pub tm_mday: c_int,\n    pub tm_mon: c_int,\n    pub tm_year: c_int,\n    pub tm_wday: c_int,\n    pub tm_yday: c_int,\n    pub tm_isdst: c_int,\n    pub tm_gmtoff: c_long,\n    pub tm_zone: *const c_char,\n}\n\npub const SEEK_CUR: c_int = 1;\npub const SEEK_END: c_int = 2;\npub const EXIT_FAILURE: c_int = 1;\n\nextern \"C\" {\n    pub static mut stderr: *mut FILE;\n\n    pub fn calloc(num: usize, size: usize) -> *mut c_void;\n    pub fn realloc(ptr: *mut c_void, new_size: usize) -> *mut c_void;\n    pub fn free(ptr: *mut c_void);\n    pub fn strdup(s: *const c_char) -> *mut c_char;\n    pub fn strncpy(dst: *mut c_char, src: *const c_char, n: usize) -> *mut c_char;\n    pub fn strerror(errnum: c_int) -> *mut c_char;\n    pub fn strtol(nptr: *const c_char, endptr: *mut *mut c_char, base: c_int) -> c_long;\n    pub fn exit(status: c_int) -> !;\n\n    pub fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;\n    pub fn fclose(stream: *mut FILE) -> c_int;\n    pub fn fgets(s: *mut c_char, size: c_int, stream: *mut FILE) -> *mut c_char;\n    pub fn fseek(stream: *mut FILE, offset: c_long, whence: c_int) -> c_int;\n    pub fn feof(stream: *mut FILE) -> c_int;\n    pub fn clearerr(stream: *mut FILE);\n    pub fn fileno(stream: *mut FILE) -> c_int;\n    pub fn perror(s: *const c_char);\n\n    pub fn fstat(fd: c_int, buf: *mut stat) -> c_int;\n    pub fn select(\n        nfds: c_int,\n        readfds: *mut c_void,\n        writefds: *mut c_void,\n        exceptfds: *mut c_void,\n        timeout: *mut timeval,\n    ) -> c_int;\n\n    pub fn __errno_location() -> *mut c_int;\n\n    pub fn fprintf(stream: *mut FILE, fmt: *const c_char, ...) -> c_int;\n    pub fn snprintf(s: *mut c_char, n: usize, fmt: *const c_char, ...) -> c_int;\n}\n\n/// `errno`\n#[inline]\npub unsafe fn errno() -> c_int {\n    *__errno_location()\n}\n\n// ---------------------------------------------------------------------------\n// Safe C-string helpers over a byte buffer.\n//\n// Every helper treats an out-of-range index as a NUL byte.  The buffers used by\n// the translated code always have an explicit NUL terminator at their final\n// index (mirroring `str[OS_MAXSTR] = '\\0'`), so a genuine C traversal can never\n// walk past the end of the array; the fallback only exists to keep these\n// helpers total.\n// ---------------------------------------------------------------------------\n\n/// `strlen(&buf[start])`\n#[inline]\npub fn c_len(buf: &[u8], start: usize) -> usize {\n    let mut i = start;\n    while i < buf.len() && buf[i] != 0 {\n        i += 1;\n    }\n    i - start\n}\n\n/// `strchr(&buf[start], ch)` -> index of the match.\n///\n/// Note that C's `strchr` can also match the terminating NUL; none of the call\n/// sites in this library search for `'\\0'`, so searching stops at the\n/// terminator.\n#[inline]\npub fn c_chr(buf: &[u8], start: usize, ch: u8) -> Option<usize> {\n    let mut i = start;\n    while i < buf.len() && buf[i] != 0 {\n        if buf[i] == ch {\n            return Some(i);\n        }\n        i += 1;\n    }\n    None\n}\n\n/// `strrchr(&buf[start], ch)` -> index of the last match.\n#[inline]\npub fn c_rchr(buf: &[u8], start: usize, ch: u8) -> Option<usize> {\n    let mut found = None;\n    let mut i = start;\n    while i < buf.len() && buf[i] != 0 {\n        if buf[i] == ch {\n            found = Some(i);\n        }\n        i += 1;\n    }\n    found\n}\n\n/// `strstr(&buf[start], needle)` -> index of the match. `needle` must not be\n/// empty and must not contain a NUL.\npub fn c_str_find(buf: &[u8], start: usize, needle: &[u8]) -> Option<usize> {\n    let mut i = start;\n    loop {\n        // Try to match `needle` at `i`.\n        let mut k = 0usize;\n        loop {\n            if k == needle.len() {\n                return Some(i);\n            }\n            let b = if i + k < buf.len() { buf[i + k] } else { 0 };\n            if b != needle[k] {\n                break;\n            }\n            k += 1;\n        }\n        // No match here; advance unless we are sitting on the terminator.\n        let b = if i < buf.len() { buf[i] } else { 0 };\n        if b == 0 {\n            return None;\n        }\n        i += 1;\n    }\n}\n\n/// `strncmp(lit, &buf[start], lit.len()) == 0`.\n///\n/// `lit` must not contain a NUL byte, which is true for every literal used by\n/// the C sources; therefore the comparison is a plain prefix test with an\n/// out-of-range byte behaving as a mismatching NUL.\n#[inline]\npub fn c_ncmp_eq(buf: &[u8], start: usize, lit: &[u8]) -> bool {\n    for (k, &want) in lit.iter().enumerate() {\n        let got = match start.checked_add(k) {\n            Some(i) if i < buf.len() => buf[i],\n            _ => 0,\n        };\n        if got != want {\n            return false;\n        }\n    }\n    true\n}\n\n/// `atoi(&buf[start])`.\n///\n/// GCC lowers `atoi` to `strtol(p, NULL, 10)` truncated to `int` (this is\n/// visible in the compiled C object, whose only relocation for these calls is\n/// against `strtol`).  Delegate to libc so that overflow clamping matches.\n#[inline]\npub unsafe fn c_atoi(buf: &[u8], start: usize) -> c_int {\n    debug_assert!(start < buf.len());\n    strtol(\n        buf.as_ptr().add(start) as *const c_char,\n        core::ptr::null_mut(),\n        10,\n    ) as c_int\n}\n\n// ---------------------------------------------------------------------------\n// Raw-pointer helpers for heap allocated C strings.\n// ---------------------------------------------------------------------------\n\n/// `strlen(p)`\n#[inline]\npub unsafe fn raw_len(p: *const c_char) -> usize {\n    let mut n = 0usize;\n    while *p.add(n) != 0 {\n        n += 1;\n    }\n    n\n}\n\n/// `strrchr(p, ch)`\n#[inline]\npub unsafe fn raw_rchr(p: *mut c_char, ch: u8) -> *mut c_char {\n    let mut found: *mut c_char = core::ptr::null_mut();\n    let mut i = 0usize;\n    while *p.add(i) != 0 {\n        if *p.add(i) as u8 == ch {\n            found = p.add(i);\n        }\n        i += 1;\n    }\n    found\n}\n\n/// `strstr(p, needle) != NULL`. `needle` must be non-empty and NUL free.\npub unsafe fn raw_contains(p: *const c_char, needle: &[u8]) -> bool {\n    let hay_len = raw_len(p);\n    if needle.len() > hay_len {\n       