{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UKKcz2aeoFPBUJMtPEzNse","type":"tool_result","content":"1\t//! Translation of `c_src/src/file-queue.c` + `c_src/include/file-queue.h`.\n2\t\n3\t#![allow(non_camel_case_types, non_snake_case)]\n4\t\n5\tuse core::ffi::{c_char, c_int, c_uint, c_void};\n6\tuse core::ptr;\n7\t\n8\tuse crate::cbits::*;\n9\tuse crate::read_alert::{alert_data, GetAlertData, ALERTS_DAILY, CRALERT_FP_SET, CRALERT_READ_ALL};\n10\t\n11\t// ---------------------------------------------------------------------------\n12\t// file-queue.h\n13\t// ---------------------------------------------------------------------------\n14\t\n15\t/// `#define MAX_FQUEUE 256`\n16\tpub const MAX_FQUEUE: usize = 256;\n17\t/// `#define FQ_TIMEOUT 5`\n18\tpub const FQ_TIMEOUT: i64 = 5;\n19\t\n20\t/// ```c\n21\t/// typedef struct file_queue {\n22\t///     time_t last_change;\n23\t///     int year;\n24\t///     int day;\n25\t///     int flags;\n26\t///\n27\t///     char mon[4];\n28\t///     char file_name[MAX_FQUEUE + 1];\n29\t///\n30\t///     FILE *fp;\n31\t///     struct stat f_status;\n32\t/// } file_queue;\n33\t/// ```\n34\t#[repr(C)]\n35\tpub struct file_queue {\n36\t    pub last_change: time_t,\n37\t    pub year: c_int,\n38\t    pub day: c_int,\n39\t    pub flags: c_int,\n40\t\n41\t    pub mon: [c_char; 4],\n42\t    pub file_name: [c_char; MAX_FQUEUE + 1],\n43\t\n44\t    pub fp: *mut FILE,\n45\t    pub f_status: stat,\n46\t}\n47\t\n48\tconst _: () = {\n49\t    assert!(core::mem::size_of::<stat>() == 144);\n50\t    assert!(core::mem::size_of::<file_queue>() == 440);\n51\t    assert!(core::mem::align_of::<file_queue>() == 8);\n52\t    assert!(core::mem::size_of::<tm>() == 56);\n53\t};\n54\t\n55\t// ---------------------------------------------------------------------------\n56\t// file-queue.c\n57\t// ---------------------------------------------------------------------------\n58\t\n59\tconst FSTAT_ERROR: &core::ffi::CStr =\n60\t    c\"(1118): Could not retrieve information of file '%s' due to [(%d)-(%s)].\";\n61\tconst FSEEK_ERROR: &core::ffi::CStr =\n62\t    c\"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\";\n63\t\n64\t/// ```c\n65\t/// void merror(const char *err_template, const char *file_name, int err, const char *err_msg) {\n66\t///     char buffer[256];\n67\t///     snprintf(buffer, sizeof(buffer), err_template, file_name, err, err_msg);\n68\t///     fprintf(stderr, \"%s\\n\", buffer);\n69\t/// }\n70\t/// ```\n71\t#[unsafe(no_mangle)]\n72\tpub unsafe extern \"C\" fn merror(\n73\t    err_template: *const c_char,\n74\t    file_name: *const c_char,\n75\t    err: c_int,\n76\t    err_msg: *const c_char,\n77\t) {\n78\t    let mut buffer = [0u8; 256];\n79\t    snprintf(\n80\t        buffer.as_mut_ptr() as *mut c_char,\n81\t        buffer.len(),\n82\t        err_template,\n83\t        file_name,\n84\t        err,\n85\t        err_msg,\n86\t    );\n87\t    fprintf(stderr, c\"%s\\n\".as_ptr(), buffer.as_ptr() as *const c_char);\n88\t}\n89\t\n90\t/// To translate between month (int) to month (char).\n91\t///\n92\t/// ```c\n93\t/// static const char *(s_month[]) = {\"Jan\", \"Feb\", ... \"Dec\"};\n94\t/// ```\n95\tstatic S_MONTH: [&core::ffi::CStr; 12] = [\n96\t    c\"Jan\", c\"Feb\", c\"Mar\", c\"Apr\", c\"May\", c\"Jun\", c\"Jul\", c\"Aug\", c\"Sep\", c\"Oct\", c\"Nov\", c\"Dec\",\n97\t];\n98\t\n99\t/// `strncpy(fileq->mon, s_month[p->tm_mon], 3)`\n100\t///\n101\t/// A `tm_mon` outside `0..=11` indexes `s_month` out of bounds in the original\n102\t/// C, which is undefined behaviour with no defined observable result.  The\n103\t/// `mon` field is never read back by any function in this library and is not\n104\t/// part of any returned value, so declining to write it for out-of-range\n105\t/// months preserves every observable output.\n106\t#[inline]\n107\tunsafe fn copy_mon(fileq: *mut file_queue, tm_mon: c_int) {\n108\t    if (0..12).contains(&tm_mon) {\n109\t        strncpy(\n110\t            (*fileq).mon.as_mut_ptr(),\n111\t            S_MONTH[tm_mon as usize].as_ptr(),\n112\t            3,\n113\t        );\n114\t    }\n115\t}\n116\t\n117\t/// ```c\n118\t/// static void file_sleep() {\n119\t///     struct timeval fp_timeout;\n120\t///     fp_timeout.tv_sec = FQ_TIMEOUT;\n121\t///     fp_timeout.tv_usec = 0;\n122\t///     select(0, NULL, NULL, NULL, &fp_timeout);\n123\t///     return;\n124\t/// }\n125\t/// ```\n126\tunsafe fn file_sleep() {\n127\t    let mut fp_timeout = timeval {\n128\t        tv_sec: FQ_TIMEOUT,\n129\t        tv_usec: 0,\n130\t    };\n131\t\n132\t    /* Wait for the select timeout */\n133\t    select(\n134\t        0,\n135\t        ptr::null_mut(),\n136\t        ptr::null_mut(),\n137\t        ptr::null_mut(),\n138\t        &mut fp_timeout,\n139\t    );\n140\t}\n141\t\n142\t/// Get the file queue for that specific hour.\n143\t///\n144\t/// ```c\n145\t/// static void GetFile_Queue(file_queue *fileq) {\n146\t///     fileq->file_name[0] = '\\0';\n147\t///     fileq->file_name[MAX_FQUEUE] = '\\0';\n148\t///     snprintf(fileq->file_name, MAX_FQUEUE, \"%s\",\n149\t///              fileq->flags & CRALERT_FP_SET ? \"<stdin>\" : ALERTS_DAILY);\n150\t/// }\n151\t/// ```\n152\tunsafe fn GetFile_Queue(fileq: *mut file_queue) {\n153\t    /* Create the logfile name */\n154\t    (*fileq).file_name[0] = 0;\n155\t    (*fileq).file_name[MAX_FQUEUE] = 0;\n156\t\n157\t    let src = if ((*fileq).flags & CRALERT_FP_SET) != 0 {\n158\t        c\"<stdin>\"\n159\t    } else {\n160\t        ALERTS_DAILY\n161\t    };\n162\t\n163\t    snprintf(\n164\t        (*fileq).file_name.as_mut_ptr(),\n165\t        MAX_FQUEUE,\n166\t        c\"%s\".as_ptr(),\n167\t        src.as_ptr(),\n168\t    );\n169\t}\n170\t\n171\t/// Re Handle the file queue.\n172\t///\n173\t/// ```c\n174\t/// static int Handle_Queue(file_queue *fileq, int flags);\n175\t/// ```\n176\tunsafe fn Handle_Queue(fileq: *mut file_queue, flags: c_int) -> c_int {\n177\t    /* Close if it is open */\n178\t    if (flags & CRALERT_FP_SET) == 0 {\n179\t        if !(*fileq).fp.is_null() {\n180\t            fclose((*fileq).fp);\n181\t            (*fileq).fp = ptr::null_mut();\n182\t        }\n183\t\n184\t        /* We must be able to open the file, fseek and get the\n185\t         * time of change from it.\n186\t         */\n187\t        (*fileq).fp = fopen((*fileq).file_name.as_ptr(), c\"r\".as_ptr());\n188\t        if (*fileq).fp.is_null() {\n189\t            /* Queue not available */\n190\t            return 0;\n191\t        }\n192\t    }\n193\t\n194\t    /* Seek to the end of the file */\n195\t    if (flags & CRALERT_READ_ALL) == 0 {\n196\t        if (*fileq).fp.is_null() {\n197\t            return 0;\n198\t        }\n199\t\n200\t        if fseek((*fileq).fp, 0, SEEK_END) < 0 {\n201\t            let e = errno();\n202\t            merror(\n203\t                FSEEK_ERROR.as_ptr(),\n204\t                (*fileq).file_name.as_ptr(),\n205\t                e,\n206\t                strerror(e),\n207\t            );\n208\t            fclose((*fileq).fp);\n209\t            (*fileq).fp = ptr::null_mut();\n210\t            return -1;\n211\t        }\n212\t    }\n213\t\n214\t    /* File change time */\n215\t    if !(*fileq).fp.is_null() {\n216\t        if fstat(fileno((*fileq).fp), &raw mut (*fileq).f_status) < 0 {\n217\t            let e = errno();\n218\t            merror(\n219\t                FSTAT_ERROR.as_ptr(),\n220\t                (*fileq).file_name.as_ptr(),\n221\t                e,\n222\t                strerror(e),\n223\t            );\n224\t            fclose((*fileq).fp);\n225\t            (*fileq).fp = ptr::null_mut();\n226\t            return -1;\n227\t        }\n228\t    }\n229\t\n230\t    (*fileq).last_change = (*fileq).f_status.st_mtim.tv_sec;\n231\t\n232\t    1\n233\t}\n234\t\n235\t/// Initiates the file monitoring.\n236\t///\n237\t/// ```c\n238\t/// int Init_FileQueue(file_queue *fileq, const struct tm *p, int flags);\n239\t/// ```\n240\t#[unsafe(no_mangle)]\n241\tpub unsafe extern \"C\" fn Init_FileQueue(\n242\t    fileq: *mut file_queue,\n243\t    p: *const tm,\n244\t    flags: c_int,\n245\t) -> c_int {\n246\t    /* Initialize file_queue fields */\n247\t    if (flags & CRALERT_FP_SET) == 0 {\n248\t        (*fileq).fp = ptr::null_mut();\n249\t    }\n250\t    (*fileq).last_change = 0;\n251\t    (*fileq).flags = 0;\n252\t\n253\t    (*fileq).day = (*p).tm_mday;\n254\t    (*fileq).year = (*p).tm_year.wrapping_add(1900);\n255\t\n256\t    copy_mon(fileq, (*p).tm_mon);\n257\t    ptr::write_bytes((*fileq).file_name.as_mut_ptr() as *mut u8, 0, MAX_FQUEUE + 1);\n258\t\n259\t    /* Set the supplied flags */\n260\t    (*fileq).flags = flags;\n261\t\n262\t    /* Get latest file */\n263\t    GetFile_Queue(fileq);\n264\t\n265\t    /* Always seek to the end when starting the queue */\n266\t    if Handle_Queue(fileq, (*fileq).flags) < 0 {\n267\t        return -1;\n268\t    }\n269\t\n270\t    0\n271\t}\n272\t\n273\t/// Reads from the monitored file.\n274\t///\n275\t/// ```c\n276\t/// alert_data *Read_FileMon(file_queue *fileq, const struct tm *p, unsigned int timeout);\n277\t/// ```\n278\t#[unsafe(no_mangle)]\n279\tpub unsafe extern \"C\" fn Read_FileMon(\n280\t    fileq: *mut file_queue,\n281\t    p: *const tm,\n282\t    timeout: c_uint,\n283\t) -> *mut alert_data {\n284\t    let mut i: c_uint = 0;\n285\t    let mut al_data: *mut alert_data;\n286\t\n287\t    /* If the file queue is not available, try to access it */\n288\t    if (*fileq).fp.is_null() {\n289\t        if Handle_Queue(fileq, 0) != 1 {\n290\t            file_sleep();\n291\t            return ptr::null_mut();\n292\t        }\n293\t    }\n294\t\n295\t    if (*fileq).fp.is_null() {\n296\t        return ptr::null_mut();\n297\t    }\n298\t\n299\t    al_data = GetAlertData((*fileq).flags, (*fileq).fp);\n300\t    if !al_data.is_null() {\n301\t        return al_data;\n302\t    }\n303\t\n304\t    (*fileq).day = (*p).tm_mday;\n305\t    (*fileq).year = (*p).tm_year.wrapping_add(1900);\n306\t    copy_mon(fileq, (*p).tm_mon);\n307\t\n308\t    /* Get latest file */\n309\t    GetFile_Queue(fileq);\n310\t\n311\t    if Handle_Queue(fileq, 0) != 1 {\n312\t        file_sleep();\n313\t        return ptr::null_mut();\n314\t    }\n315\t\n316\t    /* Try up to timeout times to get an event */\n317\t    while i < timeout {\n318\t        al_data = GetAlertData((*fileq).flags, (*fileq).fp);\n319\t        if !al_data.is_null() {\n320\t            return al_data;\n321\t        }\n322\t\n323\t        i += 1;\n324\t        file_sleep();\n325\t    }\n326\t\n327\t    /* Return NULL if timeout expires */\n328\t    ptr::null_mut()\n329\t}\n330\t\n331\t// Keep the `c_void` import meaningful for the raw-pointer casts above on all\n332\t// compiler versions.\n333\tconst _: Option<*mut c_void> = None;\n334\t"}]},"parent_tool_use_id":null,"session_id":"1ae76093-19c1-48bd-ad47-ef026a38794e","uuid":"413f2b55-2b1c-4ff4-a3b3-78c1486bd3e3","timestamp":"2026-08-20T08:29:19.605Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-I0kTQU/translated_rust/src/file_queue.rs","content":"//! Translation of `c_src/src/file-queue.c` + `c_src/include/file-queue.h`.\n\n#![allow(non_camel_case_types, non_snake_case)]\n\nuse core::ffi::{c_char, c_int, c_uint, c_void};\nuse core::ptr;\n\nuse crate::cbits::*;\nuse crate::read_alert::{alert_data, GetAlertData, ALERTS_DAILY, CRALERT_FP_SET, CRALERT_READ_ALL};\n\n// ---------------------------------------------------------------------------\n// file-queue.h\n// ---------------------------------------------------------------------------\n\n/// `#define MAX_FQUEUE 256`\npub const MAX_FQUEUE: usize = 256;\n/// `#define FQ_TIMEOUT 5`\npub const FQ_TIMEOUT: i64 = 5;\n\n/// ```c\n/// typedef struct file_queue {\n///     time_t last_change;\n///     int year;\n///     int day;\n///     int flags;\n///\n///     char mon[4];\n///     char file_name[MAX_FQUEUE + 1];\n///\n///     FILE *fp;\n///     struct stat f_status;\n/// } file_queue;\n/// ```\n#[repr(C)]\npub struct file_queue {\n    pub last_change: time_t,\n    pub year: c_int,\n    pub day: c_int,\n    pub flags: c_int,\n\n    pub mon: [c_char; 4],\n    pub file_name: [c_char; MAX_FQUEUE + 1],\n\n    pub fp: *mut FILE,\n    pub f_status: stat,\n}\n\nconst _: () = {\n    assert!(core::mem::size_of::<stat>() == 144);\n    assert!(core::mem::size_of::<file_queue>() == 440);\n    assert!(core::mem::align_of::<file_queue>() == 8);\n    assert!(core::mem::size_of::<tm>() == 56);\n};\n\n// ---------------------------------------------------------------------------\n// file-queue.c\n// ---------------------------------------------------------------------------\n\nconst FSTAT_ERROR: &core::ffi::CStr =\n    c\"(1118): Could not retrieve information of file '%s' due to [(%d)-(%s)].\";\nconst FSEEK_ERROR: &core::ffi::CStr =\n    c\"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\";\n\n/// ```c\n/// void merror(const char *err_template, const char *file_name, int err, const char *err_msg) {\n///     char buffer[256];\n///     snprintf(buffer, sizeof(buffer), err_template, file_name, err, err_msg);\n///     fprintf(stderr, \"%s\\n\", buffer);\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn merror(\n    err_template: *const c_char,\n    file_name: *const c_char,\n    err: c_int,\n    err_msg: *const c_char,\n) {\n    let mut buffer = [0u8; 256];\n    snprintf(\n        buffer.as_mut_ptr() as *mut c_char,\n        buffer.len(),\n        err_template,\n        file_name,\n        err,\n        err_msg,\n    );\n    fprintf(stderr, c\"%s\\n\".as_ptr(), buffer.as_ptr() as *const c_char);\n}\n\n/// To translate between month (int) to month (char).\n///\n/// ```c\n/// static const char *(s_month[]) = {\"Jan\", \"Feb\", ... \"Dec\"};\n/// ```\nstatic S_MONTH: [&core::ffi::CStr; 12] = [\n    c\"Jan\", c\"Feb\", c\"Mar\", c\"Apr\", c\"May\", c\"Jun\", c\"Jul\", c\"Aug\", c\"Sep\", c\"Oct\", c\"Nov\", c\"Dec\",\n];\n\n/// `strncpy(fileq->mon, s_month[p->tm_mon], 3)`\n///\n/// A `tm_mon` outside `0..=11` indexes `s_month` out of bounds in the original\n/// C, which is undefined behaviour with no defined observable result.  The\n/// `mon` field is never read back by any function in this library and is not\n/// part of any returned value, so declining to write it for out-of-range\n/// months preserves every observable output.\n#[inline]\nunsafe fn copy_mon(fileq: *mut file_queue, tm_mon: c_int) {\n    if (0..12).contains(&tm_mon) {\n        strncpy(\n            (*fileq).mon.as_mut_ptr(),\n            S_MONTH[tm_mon as usize].as_ptr(),\n            3,\n        );\n    }\n}\n\n/// ```c\n/// static void file_sleep() {\n///     struct timeval fp_timeout;\n///     fp_timeout.tv_sec = FQ_TIMEOUT;\n///     fp_timeout.tv_usec = 0;\n///     select(0, NULL, NULL, NULL, &fp_timeout);\n///     return;\n/// }\n/// ```\nunsafe fn file_sleep() {\n    let mut fp_timeout = timeval {\n        tv_sec: FQ_TIMEOUT,\n        tv_usec: 0,\n    };\n\n    /* Wait for the select timeout */\n    select(\n        0,\n        ptr::null_mut(),\n        ptr::null_mut(),\n        ptr::null_mut(),\n        &mut fp_timeout,\n    );\n}\n\n/// Get the file queue for that specific hour.\n///\n/// ```c\n/// static void GetFile_Queue(file_queue *fileq) {\n///     fileq->file_name[0] = '\\0';\n///     fileq->file_name[MAX_FQUEUE] = '\\0';\n///     snprintf(fileq->file_name, MAX_FQUEUE, \"%s\",\n///              fileq->flags & CRALERT_FP_SET ? \"<stdin>\" : ALERTS_DAILY);\n/// }\n/// ```\nunsafe fn GetFile_Queue(fileq: *mut file_queue) {\n    /* Create the logfile name */\n    (*fileq).file_name[0] = 0;\n    (*fileq).file_name[MAX_FQUEUE] = 0;\n\n    let src = if ((*fileq).flags & CRALERT_FP_SET) != 0 {\n        c\"<stdin>\"\n    } else {\n        ALERTS_DAILY\n    };\n\n    snprintf(\n        (*fileq).file_name.as_mut_ptr(),\n        MAX_FQUEUE,\n        c\"%s\".as_ptr(),\n        src.as_ptr(),\n    );\n}\n\n/// Re Handle the file queue.\n///\n/// ```c\n/// static int Handle_Queue(file_queue *fileq, int flags);\n/// ```\nunsafe fn Handle_Queue(fileq: *mut file_queue, flags: c_int) -> c_int {\n    /* Close if it is open */\n    if (flags & CRALERT_FP_SET) == 0 {\n        if !(*fileq).fp.is_null() {\n            fclose((*fileq).fp);\n            (*fileq).fp = ptr::null_mut();\n        }\n\n        /* We must be able to open the file, fseek and get the\n         * time of change from it.\n         */\n        (*fileq).fp = fopen((*fileq).file_name.as_ptr(), c\"r\".as_ptr());\n        if (*fileq).fp.is_null() {\n            /* Queue not available */\n            return 0;\n        }\n    }\n\n    /* Seek to the end of the file */\n    if (flags & CRALERT_READ_ALL) == 0 {\n        if (*fileq).fp.is_null() {\n            return 0;\n        }\n\n        if fseek((*fileq).fp, 0, SEEK_END) < 0 {\n            let e = errno();\n            merror(\n                FSEEK_ERROR.as_ptr(),\n                (*fileq).file_name.as_ptr(),\n                e,\n                strerror(e),\n            );\n            fclose((*fileq).fp);\n            (*fileq).fp = ptr::null_mut();\n            return -1;\n        }\n    }\n\n    /* File change time */\n    if !(*fileq).fp.is_null() {\n        if fstat(fileno((*fileq).fp), &raw mut (*fileq).f_status) < 0 {\n            let e = errno();\n            merror(\n                FSTAT_ERROR.as_ptr(),\n                (*fileq).file_name.as_ptr(),\n                e,\n                strerror(e),\n            );\n            fclose((*fileq).fp);\n            (*fileq).fp = ptr::null_mut();\n            return -1;\n        }\n    }\n\n    (*fileq).last_change = (*fileq).f_status.st_mtim.tv_sec;\n\n    1\n}\n\n/// Initiates the file monitoring.\n///\n/// ```c\n/// int Init_FileQueue(file_queue *fileq, const struct tm *p, int flags);\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn Init_FileQueue(\n    fileq: *mut file_queue,\n    p: *const tm,\n    flags: c_int,\n) -> c_int {\n    /* Initialize file_queue fields */\n    if (flags & CRALERT_FP_SET) == 0 {\n        (*fileq).fp = ptr::null_mut();\n    }\n    (*fileq).last_change = 0;\n    (*fileq).flags = 0;\n\n    (*fileq).day = (*p).tm_mday;\n    (*fileq).year = (*p).tm_year.wrapping_add(1900);\n\n    copy_mon(fileq, (*p).tm_mon);\n    ptr::write_bytes((*fileq).file_name.as_mut_ptr() as *mut u8, 0, MAX_FQUEUE + 1);\n\n    /* Set the supplied flags */\n    (*fileq).flags = flags;\n\n    /* Get latest file */\n    GetFile_Queue(fileq);\n\n    /* Always seek to the end when starting the queue */\n    if Handle_Queue(fileq, (*fileq).flags) < 0 {\n        return -1;\n    }\n\n    0\n}\n\n/// Reads from the monitored file.\n///\n/// ```c\n/// alert_data *Read_FileMon(file_queue *fileq, const struct tm *p, unsigned int timeout);\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn Read_FileMon(\n    fileq: *mut file_queue,\n    p: *const tm,\n    timeout: c_uint,\n) -> *mut alert_data {\n    let mut i: c_uint = 0;\n    let mut al_data: *mut alert_data;\n\n    /* If the file queue is not available, try to access it */\n    if (*fileq).fp.is_null() {\n        if Handle_Queue(fileq, 0) != 1 {\n            file_sleep();\n            return ptr::null_mut();\n        }\n    }\n\n    if (*fileq).fp.is_null() {\n        return ptr::null_mut();\n    }\n\n    al_data = GetAlertData((*fileq).flags, (*fileq).fp);\n    if !al_data.is_null() {\n        return al_data;\n    }\n\n    (*fileq).day = (*p).tm_mday;\n    (*fileq).year = (*p).tm_year.wrapping_add(1900);\n    copy_mon(fileq, (*p).tm_mon);\n\n    /* Get latest file */\n    GetFile_Queue(fileq);\n\n    if Handle_Queue(fileq, 0) != 1 {\n        file_sleep();\n        return ptr::null_mut();\n    }\n\n    /* Try up to timeout times to get an event */\n    while i < timeout {\n        al_data = GetAlertData((*fileq).flags, (*fileq).fp);\n        if !al_data.is_null() {\n            return al_data;\n        }\n\n        i += 1;\n        file_sleep();\n    }\n\n    /* Return NULL if timeout expires */\n    ptr::null_mut()\n}\n\n// Keep the `c_void` import meaningful for the raw-pointer casts above on all\n// compiler versions.\nconst _: Option<*mut c_void> = None;\n","numLines":334,"startLine":1,"totalLines":334}}}
