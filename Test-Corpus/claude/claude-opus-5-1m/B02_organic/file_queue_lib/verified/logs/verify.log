{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JNv7KpSsudqQbTpwM1DMLC","type":"tool_result","content":"1\t/* Copyright (C) 2015, Wazuh Inc.\n2\t * Copyright (C) 2009 Trend Micro Inc.\n3\t * All right reserved.\n4\t *\n5\t * This program is free software; you can redistribute it\n6\t * and/or modify it under the terms of the GNU General Public\n7\t * License (version 2) as published by the FSF - Free Software\n8\t * Foundation\n9\t */\n10\t\n11\t#ifndef CRALERT_H\n12\t#define CRALERT_H\n13\t\n14\t#include <stdio.h>\n15\t\n16\t#define ALERTS_DAILY \"alerts.log\"\n17\t\n18\t#define CRALERT_MAIL_SET    0x001\n19\t#define CRALERT_EXEC_SET    0x002\n20\t#define CRALERT_READ_ALL    0x004\n21\t#define CRALERT_READ_FAILED 0x008\n22\t#define CRALERT_FP_SET      0x010\n23\t\n24\t/* File queue */\n25\ttypedef struct alert_data {\n26\t    unsigned int rule;\n27\t    unsigned int level;\n28\t    char *alertid;\n29\t    char *date;\n30\t    char *location;\n31\t    char *comment;\n32\t    char *group;\n33\t    char *srcip;\n34\t    int srcport;\n35\t    char *dstip;\n36\t    int dstport;\n37\t    char *user;\n38\t    char *filename;\n39\t} alert_data;\n40\t\n41\talert_data *GetAlertData(int flag, FILE *fp) __attribute__((nonnull));\n42\tvoid        FreeAlertData(alert_data *al_data) __attribute__((nonnull));\n43\t\n44\t#endif /* CRALERT_H */\n45\t"}]},"parent_tool_use_id":null,"session_id":"1ae76093-19c1-48bd-ad47-ef026a38794e","uuid":"af257a7e-2577-44e3-9b0c-d252d3cf3a34","timestamp":"2026-08-20T08:28:56.990Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-I0kTQU/translated_rust/c_src/include/read-alert.h","content":"/* Copyright (C) 2015, Wazuh Inc.\n * Copyright (C) 2009 Trend Micro Inc.\n * All right reserved.\n *\n * This program is free software; you can redistribute it\n * and/or modify it under the terms of the GNU General Public\n * License (version 2) as published by the FSF - Free Software\n * Foundation\n */\n\n#ifndef CRALERT_H\n#define CRALERT_H\n\n#include <stdio.h>\n\n#define ALERTS_DAILY \"alerts.log\"\n\n#define CRALERT_MAIL_SET    0x001\n#define CRALERT_EXEC_SET    0x002\n#define CRALERT_READ_ALL    0x004\n#define CRALERT_READ_FAILED 0x008\n#define CRALERT_FP_SET      0x010\n\n/* File queue */\ntypedef struct alert_data {\n    unsigned int rule;\n    unsigned int level;\n    char *alertid;\n    char *date;\n    char *location;\n    char *comment;\n    char *group;\n    char *srcip;\n    int srcport;\n    char *dstip;\n    int dstport;\n    char *user;\n    char *filename;\n} alert_data;\n\nalert_data *GetAlertData(int flag, FILE *fp) __attribute__((nonnull));\nvoid        FreeAlertData(alert_data *al_data) __attribute__((nonnull));\n\n#endif /* CRALERT_H */\n","numLines":45,"startLine":1,"totalLines":45}}}
