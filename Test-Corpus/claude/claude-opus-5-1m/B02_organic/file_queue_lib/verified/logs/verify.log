     .collect()\n            };\n            assert_eq!(\n                norm(&cr.states),\n                norm(&rr.states),\n                \"[{tag}] kind={kind:?} flag={flag:#x} stream-state mismatch\\ninput = {:?}\",\n                String::from_utf8_lossy(bytes)\n            );\n        }\n    }","numLines":80,"startLine":895,"totalLines":976}}}
