e_slot(&raw mut (*al_data).dstip);\n348\t                (*al_data).dstip = os_strdup(str_buf.as_ptr().add(pi) as *const c_char);\n349\t            }\n350\t            /* dstport */\n351\t            else if c_ncmp_eq(&str_buf, 0, DSTPORT_BEGIN) {\n352\t                if let Some(nl) = c_rchr(&str_buf, 0, b'\\n') {\n353\t                    str_buf[nl] = 0;\n354\t                }\n355\t                let pi = DSTPORT_BEGIN_SZ;\n356\t                (*al_data).dstport = c_atoi(&str_buf, pi);\n357\t            }\n358\t            /* username */\n359\t            else if c_ncmp_eq(&str_buf, 0, USER_BEGIN) {\n360\t                if let Some(nl) = c_rchr(&str_buf, 0, b'\\n') {\n361\t                    str_buf[nl] = 0;\n362\t                }\n363\t                let pi = USER_BEGIN_SZ;\n364\t                os_free_slot(&raw mut (*al_data).user);\n365\t                (*al_data).user = os_strdup(str_buf.as_ptr().add(pi) as *const c_char);\n366\t            }\n367\t            /* It is a log message */\n368\t            else if log_size < LOG_LIMIT {\n369\t                if let Some(nl) = c_rchr(&str_buf, 0, b'\\n') {\n370\t                    str_buf[nl] = 0;\n371\t                }\n372\t                if issyscheck == 1 {\n373\t                    if c_ncmp_eq(&str_buf, 0, SYSCHECK_BEGIN) {\n374\t                        // NOTE: plain `strdup`, not `os_strdup`.\n375\t                        (*al_data).filename =\n376\t                            strdup(str_buf.as_ptr().add(SYSCHECK_BEGIN_SZ) as *const c_char);\n377\t                        if !(*al_data).filename.is_null() {\n378\t                            // Faithful reproduction of the original\n379\t                            // out-of-bounds write when the remainder is the\n380\t                            // empty string (`strlen(...) - 1` underflows).\n381\t                            let l = raw_len((*al_data).filename);\n382\t                            let target = (*al_data).filename.wrapping_offse