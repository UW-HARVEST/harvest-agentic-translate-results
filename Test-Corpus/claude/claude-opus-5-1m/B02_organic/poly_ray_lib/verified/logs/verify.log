{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DCbNNWiKDcb2Bz6krdbHzR","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! This is a faithful, behaviour-preserving translation of `c_src/src/lib.c`\n4\t//! (a subset of the `cute_c2` 2D collision routines) plus the public entry\n5\t//! point `poly_ray` declared in `c_src/include/lib.h`.\n6\t//!\n7\t//! Every function that the C shared library exports is re-exported here with\n8\t//! the identical linker symbol name, the identical C ABI signature and the\n9\t//! identical arithmetic (including the original code's quirks / bugs).\n10\t\n11\t#![allow(non_snake_case)]\n12\t#![allow(non_camel_case_types)]\n13\t\n14\tuse core::ffi::c_int;\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// Public types (from c_src/include/lib.h)\n18\t// ---------------------------------------------------------------------------\n19\t\n20\t/// `typedef struct c2v { float x; float y; } c2v;`\n21\t#[repr(C)]\n22\t#[derive(Copy, Clone, Debug, Default)]\n23\tpub struct c2v {\n24\t    pub x: f32,\n25\t    pub y: f32,\n26\t}\n27\t\n28\t/// `typedef struct c2Raycast { float t; c2v n; } c2Raycast;`\n29\t#[repr(C)]\n30\t#[derive(Copy, Clone, Debug, Default)]\n31\tpub struct c2Raycast {\n32\t    pub t: f32,\n33\t    pub n: c2v,\n34\t}\n35\t\n36\t// ---------------------------------------------------------------------------\n37\t// Private types (from c_src/src/lib.c)\n38\t// ---------------------------------------------------------------------------\n39\t\n40\t// typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE, C2_TYPE_POLY } C2_TYPE;\n41\tpub const C2_TYPE_CIRCLE: u32 = 0;\n42\tpub const C2_TYPE_AABB: u32 = 1;\n43\tpub const C2_TYPE_CAPSULE: u32 = 2;\n44\tpub const C2_TYPE_POLY: u32 = 3;\n45\t\n46\t/// `typedef struct c2r { float c; float s; } c2r;`\n47\t#[repr(C)]\n48\t#[derive(Copy, Clone, Debug, Default)]\n49\tpub struct c2r {\n50\t    pub c: f32,\n51\t    pub s: f32,\n52\t}\n53\t\n54\t/// `typedef struct c2x { c2v p; c2r r; } c2x;`\n55\t#[repr(C)]\n56\t#[derive(Copy, Clone, Debug, Default)]\n57\tpub struct c2x {\n58\t    pub p: c2v,\n59\t    pub r: c2r,\n60\t}\n61\t\n62\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n63\t#[repr(C)]\n64\t#[derive(Copy, Clone, Debug, Default)]\n65\tpub struct c2Circle {\n66\t    pub p: c2v,\n67\t    pub r: f32,\n68\t}\n69\t\n70\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n71\t#[repr(C)]\n72\t#[derive(Copy, Clone, Debug, Default)]\n73\tpub struct c2AABB {\n74\t    pub min: c2v,\n75\t    pub max: c2v,\n76\t}\n77\t\n78\t/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n79\t#[repr(C)]\n80\t#[derive(Copy, Clone, Debug, Default)]\n81\tpub struct c2Capsule {\n82\t    pub a: c2v,\n83\t    pub b: c2v,\n84\t    pub r: f32,\n85\t}\n86\t\n87\t/// `typedef struct c2Poly { int count; c2v verts[8]; c2v norms[8]; } c2Poly;`\n88\t#[repr(C)]\n89\t#[derive(Copy, Clone, Debug)]\n90\tpub struct c2Poly {\n91\t    pub count: c_int,\n92\t    pub verts: [c2v; 8],\n93\t    pub norms: [c2v; 8],\n94\t}\n95\t\n96\timpl Default for c2Poly {\n97\t    fn default() -> Self {\n98\t        c2Poly {\n99\t            count: 0,\n100\t            verts: [c2v::default(); 8],\n101\t            norms: [c2v::default(); 8],\n102\t        }\n103\t    }\n104\t}\n105\t\n106\t/// `typedef struct c2Ray { c2v p; c2v d; float t; } c2Ray;`\n107\t#[repr(C)]\n108\t#[derive(Copy, Clone, Debug, Default)]\n109\tpub struct c2Ray {\n110\t    pub p: c2v,\n111\t    pub d: c2v,\n112\t    pub t: f32,\n113\t}\n114\t\n115\t/// `typedef struct c2m { c2v x; c2v y; } c2m;`\n116\t#[repr(C)]\n117\t#[derive(Copy, Clone, Debug, Default)]\n118\tpub struct c2m {\n119\t    pub x: c2v,\n120\t    pub y: c2v,\n121\t}\n122\t\n123\t// ---------------------------------------------------------------------------\n124\t// Internal helpers reproducing the C ternary macros bit-for-bit.\n125\t//\n126\t// The C source expands `c2Abs`/`c2Min`/`c2Max` style macros into conditional\n127\t// expressions.  Those have subtly different semantics from `f32::abs`,\n128\t// `f32::min` and `f32::max` for NaN and signed zero, so replicate the\n129\t// conditional form exactly instead of using the library intrinsics.\n130\t// ---------------------------------------------------------------------------\n131\t\n132\t#[inline(always)]\n133\tfn c_abs(a: f32) -> f32 {\n134\t    if a < 0.0 { -a } else { a }\n135\t}\n136\t\n137\t#[inline(always)]\n138\tfn c_min(a: f32, b: f32) -> f32 {\n139\t    if a < b { a } else { b }\n140\t}\n141\t\n142\t#[inline(always)]\n143\tfn c_max(a: f32, b: f32) -> f32 {\n144\t    if a > b { a } else { b }\n145\t}\n146\t\n147\t// ---------------------------------------------------------------------------\n148\t// Vector math\n149\t// ---------------------------------------------------------------------------\n150\t\n151\t#[inline]\n152\tfn v(x: f32, y: f32) -> c2v {\n153\t    c2v { x, y }\n154\t}\n155\t\n156\t#[inline]\n157\tfn dot(a: c2v, b: c2v) -> f32 {\n158\t    a.x * b.x + a.y * b.y\n159\t}\n160\t\n161\t#[inline]\n162\tfn len(a: c2v) -> f32 {\n163\t    dot(a, a).sqrt()\n164\t}\n165\t\n166\t#[inline]\n167\tfn add(a: c2v, b: c2v) -> c2v {\n168\t    c2v {\n169\t        x: a.x + b.x,\n170\t        y: a.y + b.y,\n171\t    }\n172\t}\n173\t\n174\t#[inline]\n175\tfn sub(a: c2v, b: c2v) -> c2v {\n176\t    c2v {\n177\t        x: a.x - b.x,\n178\t        y: a.y - b.y,\n179\t    }\n180\t}\n181\t\n182\t#[inline]\n183\tfn mulvs(a: c2v, b: f32) -> c2v {\n184\t    c2v {\n185\t        x: a.x * b,\n186\t        y: a.y * b,\n187\t    }\n188\t}\n189\t\n190\t#[inline]\n191\tfn div(a: c2v, b: f32) -> c2v {\n192\t    mulvs(a, 1.0f32 / b)\n193\t}\n194\t\n195\t#[inline]\n196\tfn norm(a: c2v) -> c2v {\n197\t    div(a, len(a))\n198\t}\n199\t\n200\t#[inline]\n201\tfn minv(a: c2v, b: c2v) -> c2v {\n202\t    v(c_min(a.x, b.x), c_min(a.y, b.y))\n203\t}\n204\t\n205\t#[inline]\n206\tfn maxv(a: c2v, b: c2v) -> c2v {\n207\t    v(c_max(a.x, b.x), c_max(a.y, b.y))\n208\t}\n209\t\n210\t#[inline]\n211\tfn skew(a: c2v) -> c2v {\n212\t    c2v { x: -a.y, y: a.x }\n213\t}\n214\t\n215\t#[inline]\n216\tfn absv(a: c2v) -> c2v {\n217\t    v(c_abs(a.x), c_abs(a.y))\n218\t}\n219\t\n220\t#[inline]\n221\tfn ccw90(a: c2v) -> c2v {\n222\t    c2v { x: a.y, y: -a.x }\n223\t}\n224\t\n225\t#[inline]\n226\tfn mulmv_t(a: c2m, b: c2v) -> c2v {\n227\t    c2v {\n228\t        x: a.x.x * b.x + a.x.y * b.y,\n229\t        y: a.y.x * b.x + a.y.y * b.y,\n230\t    }\n231\t}\n232\t\n233\t#[inline]\n234\tfn rot_identity() -> c2r {\n235\t    c2r { c: 1.0f32, s: 0.0 }\n236\t}\n237\t\n238\t#[inline]\n239\tfn x_identity() -> c2x {\n240\t    c2x {\n241\t        p: v(0.0, 0.0),\n242\t        r: rot_identity(),\n243\t    }\n244\t}\n245\t\n246\t#[inline]\n247\tfn mulrv(a: c2r, b: c2v) -> c2v {\n248\t    v(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n249\t}\n250\t\n251\t#[inline]\n252\tfn mulrv_t(a: c2r, b: c2v) -> c2v {\n253\t    v(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n254\t}\n255\t\n256\t#[inline]\n257\tfn mulxv_t(a: c2x, b: c2v) -> c2v {\n258\t    mulrv_t(a.r, sub(b, a.p))\n259\t}\n260\t\n261\t// ---------------------------------------------------------------------------\n262\t// Exported vector math API\n263\t// ---------------------------------------------------------------------------\n264\t\n265\t/// `c2v c2V(float x, float y)`\n266\t#[unsafe(no_mangle)]\n267\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n268\t    c2v { x, y }\n269\t}\n270\t\n271\t/// `float c2Dot(c2v a, c2v b)`\n272\t#[unsafe(no_mangle)]\n273\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n274\t    a.x * b.x + a.y * b.y\n275\t}\n276\t\n277\t/// `float c2Len(c2v a)`\n278\t#[unsafe(no_mangle)]\n279\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n280\t    dot(a, a).sqrt()\n281\t}\n282\t\n283\t/// `c2v c2Add(c2v a, c2v b)`\n284\t#[unsafe(no_mangle)]\n285\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n286\t    a.x += b.x;\n287\t    a.y += b.y;\n288\t    a\n289\t}\n290\t\n291\t/// `c2v c2Sub(c2v a, c2v b)`\n292\t#[unsafe(no_mangle)]\n293\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n294\t    a.x -= b.x;\n295\t    a.y -= b.y;\n296\t    a\n297\t}\n298\t\n299\t/// `c2v c2Mulvs(c2v a, float b)`\n300\t#[unsafe(no_mangle)]\n301\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n302\t    a.x *= b;\n303\t    a.y *= b;\n304\t    a\n305\t}\n306\t\n307\t/// `c2v c2Div(c2v a, float b)`\n308\t#[unsafe(no_mangle)]\n309\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n310\t    mulvs(a, 1.0f32 / b)\n311\t}\n312\t\n313\t/// `c2v c2Norm(c2v a)`\n314\t#[unsafe(no_mangle)]\n315\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n316\t    div(a, len(a))\n317\t}\n318\t\n319\t/// `c2v c2Minv(c2v a, c2v b)`\n320\t#[unsafe(no_mangle)]\n321\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n322\t    v(c_min(a.x, b.x), c_min(a.y, b.y))\n323\t}\n324\t\n325\t/// `c2v c2Maxv(c2v a, c2v b)`\n326\t#[unsafe(no_mangle)]\n327\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n328\t    v(c_max(a.x, b.x), c_max(a.y, b.y))\n329\t}\n330\t\n331\t/// `c2v c2Skew(c2v a)`\n332\t#[unsafe(no_mangle)]\n333\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n334\t    c2v { x: -a.y, y: a.x }\n335\t}\n336\t\n337\t/// `c2v c2Absv(c2v a)`\n338\t#[unsafe(no_mangle)]\n339\tpub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n340\t    v(c_abs(a.x), c_abs(a.y))\n341\t}\n342\t\n343\t/// `c2v c2CCW90(c2v a)`\n344\t#[unsafe(no_mangle)]\n345\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n346\t    c2v { x: a.y, y: -a.x }\n347\t}\n348\t\n349\t/// `c2v c2MulmvT(c2m a, c2v b)`\n350\t#[unsafe(no_mangle)]\n351\tpub extern \"C\" fn c2MulmvT(a: c2m, b: c2v) -> c2v {\n352\t    c2v {\n353\t        x: a.x.x * b.x + a.x.y * b.y,\n354\t        y: a.y.x * b.x + a.y.y * b.y,\n355\t    }\n356\t}\n357\t\n358\t/// `c2r c2RotIdentity(void)`\n359\t#[unsafe(no_mangle)]\n360\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n361\t    c2r { c: 1.0f32, s: 0.0 }\n362\t}\n363\t\n364\t/// `c2x c2xIdentity(void)`\n365\t#[unsafe(no_mangle)]\n366\tpub extern \"C\" fn c2xIdentity() -> c2x {\n367\t    c2x {\n368\t        p: v(0.0, 0.0),\n369\t        r: rot_identity(),\n370\t    }\n371\t}\n372\t\n373\t/// `c2v c2Mulrv(c2r a, c2v b)`\n374\t#[unsafe(no_mangle)]\n375\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n376\t    v(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n377\t}\n378\t\n379\t/// `c2v c2MulrvT(c2r a, c2v b)`\n380\t#[unsafe(no_mangle)]\n381\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n382\t    v(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n383\t}\n384\t\n385\t/// `c2v c2MulxvT(c2x a, c2v b)`\n386\t#[unsafe(no_mangle)]\n387\tpub extern \"C\" fn c2MulxvT(a: c2x, b: c2v) -> c2v {\n388\t    mulrv_t(a.r, sub(b, a.p))\n389\t}\n390\t\n391\t// ---------------------------------------------------------------------------\n392\t// Overlap tests\n393\t// ---------------------------------------------------------------------------\n394\t\n395\t#[inline]\n396\tfn aabb_to_aabb(a: c2AABB, b: c2AABB) -> c_int {\n397\t    let d0 = (b.max.x < a.min.x) as c_int;\n398\t    let d1 = (a.max.x < b.min.x) as c_int;\n399\t    let d2 = (b.max.y < a.min.y) as c_int;\n400\t    let d3 = (a.max.y < b.min.y) as c_int;\n401\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n402\t}\n403\t\n404\t/// `int c2AABBtoAABB(c2AABB A, c2AABB B)`\n405\t#[unsafe(no_mangle)]\n406\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n407\t    aabb_to_aabb(A, B)\n408\t}\n409\t\n410\t#[inline]\n411\tfn aabb_to_point(a: c2AABB, b: c2v) -> c_int {\n412\t    let d0 = (b.x < a.min.x) as c_int;\n413\t    let d1 = (b.y < a.min.y) as c_int;\n414\t    let d2 = (b.x > a.max.x) as c_int;\n415\t    let d3 = (b.y > a.max.y) as c_int;\n416\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n417\t}\n418\t\n419\t/// `int c2AABBtoPoint(c2AABB A, c2v B)`\n420\t#[unsafe(no_mangle)]\n421\tpub extern \"C\" fn c2AABBtoPoint(A: c2AABB, B: c2v) -> c_int {\n422\t    aabb_to_point(A, B)\n423\t}\n424\t\n425\t#[inline]\n426\tfn circle_to_point(a: c2Circle, b: c2v) -> c_int {\n427\t    let n = sub(a.p, b);\n428\t    let d2 = dot(n, n);\n429\t    (d2 < a.r * a.r) as c_int\n430\t}\n431\t\n432\t/// `int c2CircleToPoint(c2Circle A, c2v B)`\n433\t#[unsafe(no_mangle)]\n434\tpub extern \"C\" fn c2CircleToPoint(A: c2Circle, B: c2v) -> c_int {\n435\t    circle_to_point(A, B)\n436\t}\n437\t\n438\t// ---------------------------------------------------------------------------\n439\t// Raycasts\n440\t// ---------------------------------------------------------------------------\n441\t\n442\t/// `static inline float c2SignedDistPointToPlane_OneDimensional(float p, float n, float d)`\n443\t#[inline(always)]\n444\tfn signed_dist_point_to_plane_one_dimensional(p: f32, n: f32, d: f32) -> f32 {\n445\t    p * n - d * n\n446\t}\n447\t\n448\t/// `static inline float c2RayToPlane_OneDimensional(float da, float db)`\n449\t#[inline(always)]\n450\tfn ray_to_plane_one_dimensional(da: f32, db: f32) -> f32 {\n451\t    if da < 0.0 {\n452\t        0.0\n453\t    } else if da * db > 0.0 {\n454\t        1.0f32\n455\t    } else {\n456\t        let d = da - db;\n457\t        if d != 0.0 { da / d } else { 0.0 }\n458\t    }\n459\t}\n460\t\n461\t/// Shared implementation of `c2RaytoCircle`.\n462\t///\n463\t/// # Safety\n464\t/// `out` must be a valid, writable pointer to a `c2Raycast` whenever the\n465\t/// function reaches a branch that stores through it (the C code dereferences\n466\t/// it unconditionally on a hit).\n467\tunsafe fn rayto_circle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n468\t    let p = B.p;\n469\t    let m = sub(A.p, p);\n470\t    let c = dot(m, m) - B.r * B.r;\n471\t    let b = dot(m, A.d);\n472\t    let disc = b * b - c;\n473\t    if disc < 0.0 {\n474\t        return 0;\n475\t    }\n476\t    let t = -b - disc.sqrt();\n477\t    if t >= 0.0 && t <= A.t {\n478\t        unsafe {\n479\t            (*out).t = t;\n480\t        }\n481\t        let impact = add(A.p, mulvs(A.d, t));\n482\t        unsafe {\n483\t            (*out).n = norm(sub(impact, p));\n484\t        }\n485\t        return 1;\n486\t    }\n487\t    0\n488\t}\n489\t\n490\t/// `int c2RaytoCircle(c2Ray A, c2Circle B, c2Raycast *out)`\n491\t#[unsafe(no_mangle)]\n492\tpub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n493\t    unsafe { rayto_circle(A, B, out) }\n494\t}\n495\t\n496\t/// Shared implementation of `c2RaytoAABB`.\n497\t///\n498\t/// # Safety\n499\t/// See [`rayto_circle`].\n500\tunsafe fn rayto_aabb(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n501\t    let p0 = A.p;\n502\t    let p1 = add(A.p, mulvs(A.d, A.t));\n503\t    let a_box = c2AABB {\n504\t        min: minv(p0, p1),\n505\t        max: maxv(p0, p1),\n506\t    };\n507\t    if aabb_to_aabb(a_box, B) == 0 {\n508\t        return 0;\n509\t    }\n510\t    let ab = sub(p1, p0);\n511\t    let n = skew(ab);\n512\t    let abs_n = absv(n);\n513\t    let half_extents = mulvs(sub(B.max, B.min), 0.5f32);\n514\t    let center_of_b_box = mulvs(add(B.min, B.max), 0.5f32);\n515\t    let d = c_abs(dot(n, sub(p0, center_of_b_box))) - dot(abs_n, half_extents);\n516\t    if d > 0.0 {\n517\t        return 0;\n518\t    }\n519\t    let da0 = signed_dist_point_to_plane_one_dimensional(p0.x, -1.0f32, B.min.x);\n520\t    let db0 = signed_dist_point_to_plane_one_dimensional(p1.x, -1.0f32, B.min.x);\n521\t    let da1 = signed_dist_point_to_plane_one_dimensional(p0.x, 1.0f32, B.max.x);\n522\t    let db1 = signed_dist_point_to_plane_one_dimensional(p1.x, 1.0f32, B.max.x);\n523\t    let da2 = signed_dist_point_to_plane_one_dimensional(p0.y, -1.0f32, B.min.y);\n524\t    let db2 = signed_dist_point_to_plane_one_dimensional(p1.y, -1.0f32, B.min.y);\n525\t    let da3 = signed_dist_point_to_plane_one_dimensional(p0.y, 1.0f32, B.max.y);\n526\t    let db3 = signed_dist_point_to_plane_one_dimensional(p1.y, 1.0f32, B.max.y);\n527\t    let mut t0 = ray_to_plane_one_dimensional(da0, db0);\n528\t    let mut t1 = ray_to_plane_one_dimensional(da1, db1);\n529\t    let mut t2 = ray_to_plane_one_dimensional(da2, db2);\n530\t    let mut t3 = ray_to_plane_one_dimensional(da3, db3);\n531\t    let hit0 = (t0 <= 1.0f32) as c_int;\n532\t    let hit1 = (t1 <= 1.0f32) as c_int;\n533\t    let hit2 = (t2 <= 1.0f32) as c_int;\n534\t    let hit3 = (t3 <= 1.0f32) as c_int;\n535\t    let hit = hit0 | hit1 | hit2 | hit3;\n536\t    if hit != 0 {\n537\t        t0 = (hit0 as f32) * t0;\n538\t        t1 = (hit1 as f32) * t1;\n539\t        t2 = (hit2 as f32) * t2;\n540\t        t3 = (hit3 as f32) * t3;\n541\t        if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n542\t            unsafe {\n543\t                (*out).t = t0 * A.t;\n544\t                (*out).n = v(-1.0, 0.0);\n545\t            }\n546\t        } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n547\t            unsafe {\n548\t                (*out).t = t1 * A.t;\n549\t                (*out).n = v(1.0, 0.0);\n550\t            }\n551\t        } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n552\t            unsafe {\n553\t                (*out).t = t2 * A.t;\n554\t                (*out).n = v(0.0, -1.0);\n555\t            }\n556\t        } else {\n557\t            unsafe {\n558\t                (*out).t = t3 * A.t;\n559\t                (*out).n = v(0.0, 1.0);\n560\t            }\n561\t        }\n562\t        1\n563\t    } else {\n564\t        0\n565\t    }\n566\t}\n567\t\n568\t/// `int c2RaytoAABB(c2Ray A, c2AABB B, c2Raycast *out)`\n569\t#[unsafe(no_mangle)]\n570\tpub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n571\t    unsafe { rayto_aabb(A, B, out) }\n572\t}\n573\t\n574\t/// Shared implementation of `c2RaytoCapsule`.\n575\t///\n576\t/// # Safety\n577\t/// See [`rayto_circle`].\n578\tunsafe fn rayto_capsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n579\t    let mut M = c2m::default();\n580\t    M.y = norm(sub(B.b, B.a));\n581\t    M.x = ccw90(M.y);\n582\t    let cap_n = sub(B.b, B.a);\n583\t    let yBb = mulmv_t(M, cap_n);\n584\t    let yAp = mulmv_t(M, sub(A.p, B.a));\n585\t    let yAd = mulmv_t(M, A.d);\n586\t    let yAe = add(yAp, mulvs(yAd, A.t));\n587\t    let capsule_bb = c2AABB {\n588\t        min: v(-B.r, 0.0),\n589\t        max: v(B.r, yBb.y),\n590\t    };\n591\t    unsafe {\n592\t        (*out).n = norm(cap_n);\n593\t        (*out).t = 0.0;\n594\t    }\n595\t    if aabb_to_point(capsule_bb, yAp) != 0 {\n596\t        return 1;\n597\t    } else {\n598\t        let capsule_a = c2Circle { p: B.a, r: B.r };\n599\t        let capsule_b = c2Circle { p: B.b, r: B.r };\n600\t        if circle_to_point(capsule_a, A.p) != 0 {\n601\t            return 1;\n602\t        } else if circle_to_point(capsule_b, A.p) != 0 {\n603\t            return 1;\n604\t        }\n605\t    }\n606\t    if yAe.x * yAp.x < 0.0 || c_min(c_abs(yAe.x), c_abs(yAp.x)) < B.r {\n607\t        let Ca = c2Circle { p: B.a, r: B.r };\n608\t        let Cb = c2Circle { p: B.b, r: B.r };\n609\t        if c_abs(yAp.x) < B.r {\n610\t            if yAp.y < 0.0 {\n611\t                return unsafe { rayto_circle(A, Ca, out) };\n612\t            } else {\n613\t                return unsafe { rayto_circle(A, Cb, out) };\n614\t            }\n615\t        } else {\n616\t            let c = if yAp.x > 0.0 { B.r } else { -B.r };\n617\t            let d = yAe.x - yAp.x;\n618\t            let t = (c - yAp.x) / d;\n619\t            let y = yAp.y + (yAe.y - yAp.y) * t;\n620\t            if y <= 0.0 {\n621\t                return unsafe { rayto_circle(A, Ca, out) };\n622\t            }\n623\t            if y >= yBb.y {\n624\t                return unsafe { rayto_circle(A, Cb, out) };\n625\t            } else {\n626\t                unsafe {\n627\t                    (*out).n = if c > 0.0 { M.x } else { skew(M.y) };\n628\t                    (*out).t = t * A.t;\n629\t                }\n630\t                return 1;\n631\t            }\n632\t        }\n633\t    }\n634\t    0\n635\t}\n636\t\n637\t/// `int c2RaytoCapsule(c2Ray A, c2Capsule B, c2Raycast *out)`\n638\t#[unsafe(no_mangle)]\n639\tpub unsafe extern \"C\" fn c2RaytoCapsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n640\t    unsafe { rayto_capsule(A, B, out) }\n641\t}\n642\t\n643\t/// Shared implementation of `c2RaytoPoly`.\n644\t///\n645\t/// # Safety\n646\t/// `B` must point to a valid `c2Poly` (the C code dereferences it\n647\t/// unconditionally).  `bx_ptr` may be null.  See [`rayto_circle`] for `out`.\n648\tunsafe fn rayto_poly(\n649\t    A: c2Ray,\n650\t    B: *const c2Poly,\n651\t    bx_ptr: *const c2x,\n652\t    out: *mut c2Raycast,\n653\t) -> c_int {\n654\t    let bx = if !bx_ptr.is_null() {\n655\t        unsafe { *bx_ptr }\n656\t    } else {\n657\t        x_identity()\n658\t    };\n659\t    let p = mulxv_t(bx, A.p);\n660\t    let d = mulrv_t(bx.r, A.d);\n661\t    let mut lo: f32 = 0.0;\n662\t    let mut hi: f32 = A.t;\n663\t    // `int index = ~0;` -> -1\n664\t    let mut index: c_int = !0;\n665\t\n666\t    let count = unsafe { (*B).count };\n667\t    // Reproduce C's unchecked array indexing (`B->verts[i]` / `B->norms[i]`).\n668\t    let verts = unsafe { (&raw const (*B).verts) as *const c2v };\n669\t    let norms = unsafe { (&raw const (*B).norms) as *const c2v };\n670\t\n671\t    let mut i: c_int = 0;\n672\t    while i < count {\n673\t        let ni = unsafe { *norms.offset(i as isize) };\n674\t        let vi = unsafe { *verts.offset(i as isize) };\n675\t        let num = dot(ni, sub(vi, p));\n676\t        let den = dot(ni, d);\n677\t        if den == 0.0 && num < 0.0 {\n678\t            return 0;\n679\t        } else {\n680\t            if den < 0.0 && num < lo * den {\n681\t                lo = num / den;\n682\t                index = i;\n683\t            } else if den > 0.0 && num < hi * den {\n684\t                hi = num / den;\n685\t            }\n686\t        }\n687\t        if hi < lo {\n688\t            return 0;\n689\t        }\n690\t        i += 1;\n691\t    }\n692\t    if index != !0 {\n693\t        unsafe {\n694\t            (*out).t = lo;\n695\t            (*out).n = mulrv(bx.r, *norms.offset(index as isize));\n696\t        }\n697\t        return 1;\n698\t    }\n699\t    0\n700\t}\n701\t\n702\t/// `int c2RaytoPoly(c2Ray A, const c2Poly *B, const c2x *bx_ptr, c2Raycast *out)`\n703\t#[unsafe(no_mangle)]\n704\tpub unsafe extern \"C\" fn c2RaytoPoly(\n705\t    A: c2Ray,\n706\t    B: *const c2Poly,\n707\t    bx_ptr: *const c2x,\n708\t    out: *mut c2Raycast,\n709\t) -> c_int {\n710\t    unsafe { rayto_poly(A, B, bx_ptr, out) }\n711\t}\n712\t\n713\t/// Shared implementation of `c2CastRay`.\n714\t///\n715\t/// # Safety\n716\t/// `B` must point to an object of the type selected by `typeB`.\n717\tunsafe fn cast_ray(\n718\t    A: c2Ray,\n719\t    B: *const core::ffi::c_void,\n720\t    bx: *const c2x,\n721\t    typeB: u32,\n722\t    out: *mut c2Raycast,\n723\t) -> c_int {\n724\t    unsafe {\n725\t        match typeB {\n726\t            C2_TYPE_CIRCLE => rayto_circle(A, *(B as *const c2Circle), out),\n727\t            C2_TYPE_AABB => rayto_aabb(A, *(B as *const c2AABB), out),\n728\t            C2_TYPE_CAPSULE => rayto_capsule(A, *(B as *const c2Capsule), out),\n729\t            C2_TYPE_POLY => rayto_poly(A, B as *const c2Poly, bx, out),\n730\t            _ => 0,\n731\t        }\n732\t    }\n733\t}\n734\t\n735\t/// `int c2CastRay(c2Ray A, const void *B, const c2x *bx, C2_TYPE typeB, c2Raycast *out)`\n736\t#[unsafe(no_mangle)]\n737\tpub unsafe extern \"C\" fn c2CastRay(\n738\t    A: c2Ray,\n739\t    B: *const core::ffi::c_void,\n740\t    bx: *const c2x,\n741\t    typeB: u32,\n742\t    out: *mut c2Raycast,\n743\t) -> c_int {\n744\t    unsafe { cast_ray(A, B, bx, typeB, out) }\n745\t}\n746\t\n747\t// ---------------------------------------------------------------------------\n748\t// Public entry point (c_src/include/lib.h)\n749\t// ---------------------------------------------------------------------------\n750\t\n751\t/// `int poly_ray(c2Raycast *cast1, c2Raycast *cast2)`\n752\t#[unsafe(no_mangle)]\n753\tpub unsafe extern \"C\" fn poly_ray(cast1: *mut c2Raycast, cast2: *mut c2Raycast) -> c_int {\n754\t    let mut hit: c_int = 0;\n755\t\n756\t    let mut p = c2Poly::default();\n757\t    p.verts[0] = v(0.875f32, -11.5f32);\n758\t    p.verts[1] = v(0.875f32, 11.5f32);\n759\t    p.verts[2] = v(-0.875f32, 11.5f32);\n760\t    p.verts[3] = v(-0.875f32, -11.5f32);\n761\t    p.norms[0] = v(1.0, 0.0);\n762\t    p.norms[1] = v(0.0, 1.0);\n763\t    p.norms[2] = v(-1.0, 0.0);\n764\t    p.norms[3] = v(0.0, -1.0);\n765\t    p.count = 4;\n766\t\n767\t    let ray0 = c2Ray {\n768\t        p: v(-3.869416f32, 13.0693407f32),\n769\t        d: v(1.0, 0.0),\n770\t        t: 4.0,\n771\t    };\n772\t    let ray1 = c2Ray {\n773\t        p: v(-3.869416f32, 13.0693407f32),\n774\t        d: v(0.0, -1.0),\n775\t        t: 4.0,\n776\t    };\n777\t\n778\t    let pp: *const c2Poly = &p;\n779\t    unsafe {\n780\t        hit += cast_ray(\n781\t            ray0,\n782\t            pp as *const core::ffi::c_void,\n783\t            core::ptr::null(),\n784\t            C2_TYPE_POLY,\n785\t            cast1,\n786\t        );\n787\t        hit += cast_ray(\n788\t            ray1,\n789\t            pp as *const core::ffi::c_void,\n790\t            core::ptr::null(),\n791\t            C2_TYPE_POLY,\n792\t            cast2,\n793\t        ) << 1;\n794\t    }\n795\t\n796\t    hit\n797\t}\n798\t"}]},"parent_tool_use_id":null,"session_id":"c09e83d0-98c3-47f2-aeb0-21e30c5abbe5","uuid":"1975deb7-2b2b-4a77-a44d-e53e9aadc352","timestamp":"2026-08-20T11:55:35.645Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-e68mjW/translated_rust/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! This is a faithful, behaviour-preserving translation of `c_src/src/lib.c`\n//! (a subset of the `cute_c2` 2D collision routines) plus the public entry\n//! point `poly_ray` declared in `c_src/include/lib.h`.\n//!\n//! Every function that the C shared library exports is re-exported here with\n//! the identical linker symbol name, the identical C ABI signature and the\n//! identical arithmetic (including the original code's quirks / bugs).\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n\nuse core::ffi::c_int;\n\n// ---------------------------------------------------------------------------\n// Public types (from c_src/include/lib.h)\n// ---------------------------------------------------------------------------\n\n/// `typedef struct c2v { float x; float y; } c2v;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n/// `typedef struct c2Raycast { float t; c2v n; } c2Raycast;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Raycast {\n    pub t: f32,\n    pub n: c2v,\n}\n\n// ---------------------------------------------------------------------------\n// Private types (from c_src/src/lib.c)\n// ---------------------------------------------------------------------------\n\n// typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE, C2_TYPE_POLY } C2_TYPE;\npub const C2_TYPE_CIRCLE: u32 = 0;\npub const C2_TYPE_AABB: u32 = 1;\npub const C2_TYPE_CAPSULE: u32 = 2;\npub const C2_TYPE_POLY: u32 = 3;\n\n/// `typedef struct c2r { float c; float s; } c2r;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n/// `typedef struct c2x { c2v p; c2r r; } c2x;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2Poly { int count; c2v verts[8]; c2v norms[8]; } c2Poly;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\npub struct c2Poly {\n    pub count: c_int,\n    pub verts: [c2v; 8],\n    pub norms: [c2v; 8],\n}\n\nimpl Default for c2Poly {\n    fn default() -> Self {\n        c2Poly {\n            count: 0,\n            verts: [c2v::default(); 8],\n            norms: [c2v::default(); 8],\n        }\n    }\n}\n\n/// `typedef struct c2Ray { c2v p; c2v d; float t; } c2Ray;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Ray {\n    pub p: c2v,\n    pub d: c2v,\n    pub t: f32,\n}\n\n/// `typedef struct c2m { c2v x; c2v y; } c2m;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2m {\n    pub x: c2v,\n    pub y: c2v,\n}\n\n// ---------------------------------------------------------------------------\n// Internal helpers reproducing the C ternary macros bit-for-bit.\n//\n// The C source expands `c2Abs`/`c2Min`/`c2Max` style macros into conditional\n// expressions.  Those have subtly different semantics from `f32::abs`,\n// `f32::min` and `f32::max` for NaN and signed zero, so replicate the\n// conditional form exactly instead of using the library intrinsics.\n// ---------------------------------------------------------------------------\n\n#[inline(always)]\nfn c_abs(a: f32) -> f32 {\n    if a < 0.0 { -a } else { a }\n}\n\n#[inline(always)]\nfn c_min(a: f32, b: f32) -> f32 {\n    if a < b { a } else { b }\n}\n\n#[inline(always)]\nfn c_max(a: f32, b: f32) -> f32 {\n    if a > b { a } else { b }\n}\n\n// ---------------------------------------------------------------------------\n// Vector math\n// ---------------------------------------------------------------------------\n\n#[inline]\nfn v(x: f32, y: f32) -> c2v {\n    c2v { x, y }\n}\n\n#[inline]\nfn dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n#[inline]\nfn len(a: c2v) -> f32 {\n    dot(a, a).sqrt()\n}\n\n#[inline]\nfn add(a: c2v, b: c2v) -> c2v {\n    c2v {\n        x: a.x + b.x,\n        y: a.y + b.y,\n    }\n}\n\n#[inline]\nfn sub(a: c2v, b: c2v) -> c2v {\n    c2v {\n        x: a.x - b.x,\n        y: a.y - b.y,\n    }\n}\n\n#[inline]\nfn mulvs(a: c2v, b: f32) -> c2v {\n    c2v {\n        x: a.x * b,\n        y: a.y * b,\n    }\n}\n\n#[inline]\nfn div(a: c2v, b: f32) -> c2v {\n    mulvs(a, 1.0f32 / b)\n}\n\n#[inline]\nfn norm(a: c2v) -> c2v {\n    div(a, len(a))\n}\n\n#[inline]\nfn minv(a: c2v, b: c2v) -> c2v {\n    v(c_min(a.x, b.x), c_min(a.y, b.y))\n}\n\n#[inline]\nfn maxv(a: c2v, b: c2v) -> c2v {\n    v(c_max(a.x, b.x), c_max(a.y, b.y))\n}\n\n#[inline]\nfn skew(a: c2v) -> c2v {\n    c2v { x: -a.y, y: a.x }\n}\n\n#[inline]\nfn absv(a: c2v) -> c2v {\n    v(c_abs(a.x), c_abs(a.y))\n}\n\n#[inline]\nfn ccw90(a: c2v) -> c2v {\n    c2v { x: a.y, y: -a.x }\n}\n\n#[inline]\nfn mulmv_t(a: c2m, b: c2v) -> c2v {\n    c2v {\n        x: a.x.x * b.x + a.x.y * b.y,\n        y: a.y.x * b.x + a.y.y * b.y,\n    }\n}\n\n#[inline]\nfn rot_identity() -> c2r {\n    c2r { c: 1.0f32, s: 0.0 }\n}\n\n#[inline]\nfn x_identity() -> c2x {\n    c2x {\n        p: v(0.0, 0.0),\n        r: rot_identity(),\n    }\n}\n\n#[inline]\nfn mulrv(a: c2r, b: c2v) -> c2v {\n    v(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n}\n\n#[inline]\nfn mulrv_t(a: c2r, b: c2v) -> c2v {\n    v(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n}\n\n#[inline]\nfn mulxv_t(a: c2x, b: c2v) -> c2v {\n    mulrv_t(a.r, sub(b, a.p))\n}\n\n// ---------------------------------------------------------------------------\n// Exported vector math API\n// ---------------------------------------------------------------------------\n\n/// `c2v c2V(float x, float y)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    c2v { x, y }\n}\n\n/// `float c2Dot(c2v a, c2v b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n/// `float c2Len(c2v a)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    dot(a, a).sqrt()\n}\n\n/// `c2v c2Add(c2v a, c2v b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n/// `c2v c2Sub(c2v a, c2v b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n/// `c2v c2Mulvs(c2v a, float b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n/// `c2v c2Div(c2v a, float b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    mulvs(a, 1.0f32 / b)\n}\n\n/// `c2v c2Norm(c2v a)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    div(a, len(a))\n}\n\n/// `c2v c2Minv(c2v a, c2v b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    v(c_min(a.x, b.x), c_min(a.y, b.y))\n}\n\n/// `c2v c2Maxv(c2v a, c2v b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    v(c_max(a.x, b.x), c_max(a.y, b.y))\n}\n\n/// `c2v c2Skew(c2v a)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    c2v { x: -a.y, y: a.x }\n}\n\n/// `c2v c2Absv(c2v a)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n    v(c_abs(a.x), c_abs(a.y))\n}\n\n/// `c2v c2CCW90(c2v a)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    c2v { x: a.y, y: -a.x }\n}\n\n/// `c2v c2MulmvT(c2m a, c2v b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulmvT(a: c2m, b: c2v) -> c2v {\n    c2v {\n        x: a.x.x * b.x + a.x.y * b.y,\n        y: a.y.x * b.x + a.y.y * b.y,\n    }\n}\n\n/// `c2r c2RotIdentity(void)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    c2r { c: 1.0f32, s: 0.0 }\n}\n\n/// `c2x c2xIdentity(void)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    c2x {\n        p: v(0.0, 0.0),\n        r: rot_identity(),\n    }\n}\n\n/// `c2v c2Mulrv(c2r a, c2v b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    v(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n}\n\n/// `c2v c2MulrvT(c2r a, c2v b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    v(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n}\n\n/// `c2v c2MulxvT(c2x a, c2v b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulxvT(a: c2x, b: c2v) -> c2v {\n    mulrv_t(a.r, sub(b, a.p))\n}\n\n// ---------------------------------------------------------------------------\n// Overlap tests\n// ---------------------------------------------------------------------------\n\n#[inline]\nfn aabb_to_aabb(a: c2AABB, b: c2AABB) -> c_int {\n    let d0 = (b.max.x < a.min.x) as c_int;\n    let d1 = (a.max.x < b.min.x) as c_int;\n    let d2 = (b.max.y < a.min.y) as c_int;\n    let d3 = (a.max.y < b.min.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n/// `int c2AABBtoAABB(c2AABB A, c2AABB B)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n    aabb_to_aabb(A, B)\n}\n\n#[inline]\nfn aabb_to_point(a: c2AABB, b: c2v) -> c_int {\n    let d0 = (b.x < a.min.x) as c_int;\n    let d1 = (b.y < a.min.y) as c_int;\n    let d2 = (b.x > a.max.x) as c_int;\n    let d3 = (b.y > a.max.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n/// `int c2AABBtoPoint(c2AABB A, c2v B)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoPoint(A: c2AABB, B: c2v) -> c_int {\n    aabb_to_point(A, B)\n}\n\n#[inline]\nfn circle_to_point(a: c2Circle, b: c2v) -> c_int {\n    let n = sub(a.p, b);\n    let d2 = dot(n, n);\n    (d2 < a.r * a.r) as c_int\n}\n\n/// `int c2CircleToPoint(c2Circle A, c2v B)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircleToPoint(A: c2Circle, B: c2v) -> c_int {\n    circle_to_point(A, B)\n}\n\n// ---------------------------------------------------------------------------\n// Raycasts\n// ---------------------------------------------------------------------------\n\n/// `static inline float c2SignedDistPointToPlane_OneDimensional(float p, float n, float d)`\n#[inline(always)]\nfn signed_dist_point_to_plane_one_dimensional(p: f32, n: f32, d: f32) -> f32 {\n    p * n - d * n\n}\n\n/// `static inline float c2RayToPlane_OneDimensional(float da, float db)`\n#[inline(always)]\nfn ray_to_plane_one_dimensional(da: f32, db: f32) -> f32 {\n    if da < 0.0 {\n        0.0\n    } else if da * db > 0.0 {\n        1.0f32\n    } else {\n        let d = da - db;\n        if d != 0.0 { da / d } else { 0.0 }\n    }\n}\n\n/// Shared implementation of `c2RaytoCircle`.\n///\n/// # Safety\n/// `out` must be a valid, writable pointer to a `c2Raycast` whenever the\n/// function reaches a branch that stores through it (the C code dereferences\n/// it unconditionally on a hit).\nunsafe fn rayto_circle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n    let p = B.p;\n    let m = sub(A.p, p);\n    let c = dot(m, m) - B.r * B.r;\n    let b = dot(m, A.d);\n    let disc = b * b - c;\n    if disc < 0.0 {\n        return 0;\n    }\n    let t = -b - disc.sqrt();\n    if t >= 0.0 && t <= A.t {\n        unsafe {\n            (*out).t = t;\n        }\n        let impact = add(A.p, mulvs(A.d, t));\n        unsafe {\n            (*out).n = norm(sub(impact, p));\n        }\n        return 1;\n    }\n    0\n}\n\n/// `int c2RaytoCircle(c2Ray A, c2Circle B, c2Raycast *out)`\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n    unsafe { rayto_circle(A, B, out) }\n}\n\n/// Shared implementation of `c2RaytoAABB`.\n///\n/// # Safety\n/// See [`rayto_circle`].\nunsafe fn rayto_aabb(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n    let p0 = A.p;\n    let p1 = add(A.p, mulvs(A.d, A.t));\n    let a_box = c2AABB {\n        min: minv(p0, p1),\n        max: maxv(p0, p1),\n    };\n    if aabb_to_aabb(a_box, B) == 0 {\n        return 0;\n    }\n    let ab = sub(p1, p0);\n    let n = skew(ab);\n    let abs_n = absv(n);\n    let half_extents = mulvs(sub(B.max, B.min), 0.5f32);\n    let center_of_b_box = mulvs(add(B.min, B.max), 0.5f32);\n    let d = c_abs(dot(n, sub(p0, center_of_b_box))) - dot(abs_n, half_extents);\n    if d > 0.0 {\n        return 0;\n    }\n    let da0 = signed_dist_point_to_plane_one_dimensional(p0.x, -1.0f32, B.min.x);\n    let db0 = signed_dist_point_to_plane_one_dimensional(p1.x, -1.0f32, B.min.x);\n    let da1 = signed_dist_point_to_plane_one_dimensional(p0.x, 1.0f32, B.max.x);\n    let db1 = signed_dist_point_to_plane_one_dimensional(p1.x, 1.0f32, B.max.x);\n    let da2 = signed_dist_point_to_plane_one_dimensional(p0.y, -1.0f32, B.min.y);\n    let db2 = signed_dist_point_to_plane_one_dimensional(p1.y, -1.0f32, B.min.y);\n    let da3 = signed_dist_point_to_plane_one_dimensional(p0.y, 1.0f32, B.max.y);\n    let db3 = signed_dist_point_to_plane_one_dimensional(p1.y, 1.0f32, B.max.y);\n    let mut t0 = ray_to_plane_one_dimensional(da0, db0);\n    let mut t1 = ray_to_plane_one_dimensional(da1, db1);\n    let mut t2 = ray_to_plane_one_dimensional(da2, db2);\n    let mut t3 = ray_to_plane_one_dimensional(da3, db3);\n    let hit0 = (t0 <= 1.0f32) as c_int;\n    let hit1 = (t1 <= 1.0f32) as c_int;\n    let hit2 = (t2 <= 1.0f32) as c_int;\n    let hit3 = (t3 <= 1.0f32) as c_int;\n    let hit = hit0 | hit1 | hit2 | hit3;\n    if hit != 0 {\n        t0 = (hit0 as f32) * t0;\n        t1 = (hit1 as f32) * t1;\n        t2 = (hit2 as f32) * t2;\n        t3 = (hit3 as f32) * t3;\n        if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n            unsafe {\n                (*out).t = t0 * A.t;\n                (*out).n = v(-1.0, 0.0);\n            }\n        } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n            unsafe {\n                (*out).t = t1 * A.t;\n                (*out).n = v(1.0, 0.0);\n            }\n        } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n            unsafe {\n                (*out).t = t2 * A.t;\n                (*out).n = v(0.0, -1.0);\n            }\n        } else {\n            unsafe {\n                (*out).t = t3 * A.t;\n                (*out).n = v(0.0, 1.0);\n            }\n        }\n        1\n    } else {\n        0\n    }\n}\n\n/// `int c2RaytoAABB(c2Ray A, c2AABB B, c2Raycast *out)`\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n    unsafe { rayto_aabb(A, B, out) }\n}\n\n/// Shared implementation of `c2RaytoCapsule`.\n///\n/// # Safety\n/// See [`rayto_circle`].\nunsafe fn rayto_capsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n    let mut M = c2m::default();\n    M.y = norm(sub(B.b, B.a));\n    M.x = ccw90(M.y);\n    let cap_n = sub(B.b, B.a);\n    let yBb = mulmv_t(M, cap_n);\n    let yAp = mulmv_t(M, sub(A.p, B.a));\n    let yAd = mulmv_t(M, A.d);\n    let yAe = add(yAp, mulvs(yAd, A.t));\n    let capsule_bb = c2AABB {\n        min: v(-B.r, 0.0),\n        max: v(B.r, yBb.y),\n    };\n    unsafe {\n        (*out).n = norm(cap_n);\n        (*out).t = 0.0;\n    }\n    if aabb_to_point(capsule_bb, yAp) != 0 {\n        return 1;\n    } else {\n        let capsule_a = c2Circle { p: B.a, r: B.r };\n        let capsule_b = c2Circle { p: B.b, r: B.r };\n        if circle_to_point(capsule_a, A.p) != 0 {\n            return 1;\n        } else if circle_to_point(capsule_b, A.p) != 0 {\n            return 1;\n        }\n    }\n    if yAe.x * yAp.x < 0.0 || c_min(c_abs(yAe.x), c_abs(yAp.x)) < B.r {\n        let Ca = c2Circle { p: B.a, r: B.r };\n        let Cb = c2Circle { p: B.b, r: B.r };\n        if c_abs(yAp.x) < B.r {\n            if yAp.y < 0.0 {\n                return unsafe { rayto_circle(A, Ca, out) };\n            } else {