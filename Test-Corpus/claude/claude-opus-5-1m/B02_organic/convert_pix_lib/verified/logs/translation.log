len_extra, R.len_extra, 31);\n  cmpmem(\"cp_dist_extra_bits\", C.dist_extra, R.dist_extra, 32);\n  cmpmem(\"cp_len_base\", C.len_base, R.len_base, 31*4);\n  cmpmem(\"cp_dist_base\", C.dist_base, R.dist_base, 32*4);\n  if (*C.error_reason != NULL || *R.error_reason != NULL) {\n    printf(\"MISMATCH initial cp_error_reason: %p / %p\\n\", (void*)*C.error_reason, (void*)*R.error_reason); fails++;\n  }\n\n  const char *dir = argv[3];\n  DIR *dp = opendir(dir); struct dirent *de;\n  char names[512][64]; int nn=0;\n  while ((de = readdir(dp))) {\n    size_t l = strlen(de->d_name);\n    if (l > 4 && !strcmp(de->d_name + l - 4, \".bin\")) snprintf(names[nn++], 64, \"%s\", de->d_name);\n  }\n  closedir(dp);\n  // sort names\n  for (int i=0;i<nn;i++) for (int j=i+1;j<nn;j++) if (strcmp(names[i],names[j])>0) { char t[64]; strcpy(t,names[i]); strcpy(names[i],names[j]); strcpy(names[j],t); }\n\n  size_t OUT = 1<<20;\n  for (int i=0;i<nn;i++) {\n    char path[512]; snprintf(path,sizeof path,\"%s/%s\",dir,names[i]);\n    FILE *f=fopen(path,\"rb\"); fseek(f,0,SEEK_END); long sz=ftell(f); fseek(f,0,SEEK_SET);\n    uint8_t *raw = malloc(sz?sz:1); if(sz) fread(raw,1,sz,f); fclose(f);\n    // expected raw\n    char rpath[512]; snprintf(rpath,sizeof rpath,\"%.*s.raw\",(int)(strlen(path)-4),path);\n    long esz=0; uint8_t *exp=NULL;\n    FILE *g=fopen(rpath,\"rb\");\n    if (g){ fseek(g,0,SEEK_END); esz=ftell(g); fseek(g,0,SEEK_SET); exp=malloc(esz?esz:1); if(esz) fread(exp,1,esz,g); fclose(g);}    \n    for (int off=0; off<4; off++) {\n      uint8_t *inC = malloc(sz+8), *inR = malloc(sz+8);\n      // ensure identical relative alignment: align base then add off\n      uint8_t *bc = (uint8_t*)((((uintptr_t)inC)+3)&~(uintptr_t)3) + off;\n      uint8_t *br = (uint8_t*)((((uintptr_t)inR)+3)&~(uintptr_t)3) + off;\n      memcpy(bc, raw, sz); memcpy(br, raw, sz);\n      uint8_t *oc = calloc(1,OUT), *orr = calloc(1,OUT);\n      *C.error_reason = NULL; *R.error_reason = NULL;\n      int rc = C.inflate(bc,(int)sz,oc,(int)OUT);\n      int rr = R.inflate(br,(int)sz,orr,(int)OUT);\n      if (rc != rr) { printf(\"MISMATCH ret %s off=%d: C=%d R=%d\\n\", names[i], off, rc, rr); fails++; }\n      if (memcmp(oc,orr,OUT)) {\n        size_t k; for(k=0;k<OUT;k++) if(oc[k]!=orr[k]) break;\n        printf(\"MISMATCH out %s off=%d at %zu: %02x vs %02x\\n\", names[i], off, k, oc[k], orr[k]); fails++;\n      }\n      const char *ec=*C.error_reason, *er=*R.error_reason;\n      if ((ec==NULL)!=(er==NULL) || (ec&&er&&strcmp(ec,er))) {\n        printf(\"MISMATCH err %s off=%d: '%s' vs '%s'\\n\", names[i], off, ec?ec:\"(null)\", er?er:\"(null)\"); fails++;\n      }\n      if (off==0 && rc==1 && exp && esz>0 && memcmp(oc,exp,esz)) {\n        printf(\"NOTE  %s: C output differs from zlib expectation\\n\", names[i]);\n      }\n      if (off==0 && rc==1 && exp) {\n        // report roundtrip correctness (informational)\n      }\n      free(inC); free(inR); free(oc); free(orr);\n    }\n    free(raw); free(exp);\n  }\n\n  // convert_pix differential\n  srand(99);\n  for (int bpp=0; bpp<=5; bpp++) {\n    for (int t=0;t<6;t++) {\n      int w = (t*3)%13, h = (t*5)%7;\n      int stride = w*(bpp?bpp:1)+1;\n      size_t sn = (size_t)(h?h:1)*stride + 64;\n      uint8_t *src = malloc(sn);\n      for (size_t k=0;k<sn;k++) src[k]=rand()&0xff;\n      size_t np = (size_t)(w>0?w:0)*(h>0?h:0)+8;\n      pix *pc = calloc(np,sizeof(pix)), *pr = calloc(np,sizeof(pix));\n      C.convert(bpp,w,h,src,pc); R.convert(bpp,w,h,src,pr);\n      if (memcmp(pc,pr,np*sizeof(pix))) { printf(\"MISMATCH convert_pix bpp=%d w=%d h=%d\\n\",bpp,w,h); fails++; }\n      free(src); free(pc); free(pr);\n    }\n  }\n\n  printf(fails? \"FAILURES: %d\\n\" : \"ALL MATCH (%d failures)\\n\", fails);\n  return fails!=0;\n}\nEOF\ngcc -O1 -o $TMPDIR/harness $TMPDIR/harness.c -ldl && $TMPDIR/harness $TMPDIR/cbuild/libc_ref.so $PWD/target/release/libtranslated_rust.so $TMPDIR/tc 2>&1 | tail -30","description":"Build and run differential