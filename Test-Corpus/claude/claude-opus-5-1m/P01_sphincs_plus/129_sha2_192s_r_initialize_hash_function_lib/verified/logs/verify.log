\t    while (mlen >= r) {\n725\t        /* XOR block to state */\n726\t        for (i = 0; i < r; ++i) {\n727\t            s[i] ^= m[i];\n728\t        }\n729\t        haraka512_perm(s, s, ctx);\n730\t        mlen -= r;\n731\t        m += r;\n732\t    }\n733\t\n734\t    for (i = 0; i < r; ++i) {\n735\t        t[i] = 0;\n736\t    }\n737\t    for (i = 0; i < mlen; ++i) {\n738\t        t[i] = m[i];\n739\t    }\n740\t    t[i] = p;\n741\t    t[r - 1] |= 128;\n742\t    for (i = 0; i < r; ++i) {\n743\t        s[i] ^= t[i];\n744\t    }\n745\t}\n746\t\n747\tstatic void haraka_S_squeezeblocks(unsigned char *h, unsigned long long nblocks,\n748\t                                   unsigned char *s, unsigned int r,\n749\t                                   const spx_ctx *ctx)\n750\t{\n751\t    while (nblocks > 0) {\n752\t        haraka512_perm(s, s, ctx);\n753\t        memcpy(h, s, HARAKAS_RATE);\n754\t        h += r;\n755\t        nblocks--;\n756\t    }\n757\t}\n758\t\n759\tvoid haraka_S_inc_init(uint8_t *s_inc)\n760\t{\n761\t    size_t i;\n762\t\n763\t    for (i = 0; i < 64; i++) {\n764\t        s_inc[i] = 0;\n765\t    }\n766\t    s_inc[64] = 0;\n767\t}\n768\t\n769\tvoid haraka_S_inc_absorb(uint8_t *s_inc, const uint8_t *m, size_t mlen,\n770\t        const spx_ctx *ctx)\n771\t{\n772\t    size_t i;\n773\t\n774\t    /* Recall that s_inc[64] is the non-absorbed bytes xored into the state */\n775\t    while (mlen + s_inc[64] >= HARAKAS_RATE) {\n776\t        for (i = 0; i < (size_t)(HARAKAS_RATE - s_inc[64]); i++) {\n777\t            /* Take the i'th byte from message\n778\t               xor with the s_inc[64] + i'th byte of the state */\n779\t            s_inc[s_inc[64] + i] ^= m[i];\n780\t        }\n781\t        mlen -= (size_t)(HARAKAS_RATE - s_inc[64]);\n782\t        m += HARAKAS_RATE - (uint8_t)s_inc[64];\n783\t        s_inc[64] = 0;\n784\t\n785\t        haraka512_perm(s_inc, s_inc, ctx);\n786\t    }\n787\t\n788\t    for (i = 0; i < mlen; i++) {\n789\t        s_inc[s_inc[64] + i