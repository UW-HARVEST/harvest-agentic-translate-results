), [int(x,16) for x in re.findall(r'0x[0-9a-fA-F]+', m.group(2))]\n\nciv256 = c_table('iv_256', c, 32)\nciv512 = c_table('iv_512', c, 64)\nn3, riv256 = r_table_u8('IV_256', r)\nn4, riv512 = r_table_u8('IV_512', r)\nprint(\"iv256 C len\",len(civ256),\"Rust decl\",n3,\"len\",len(riv256))\nprint(\"iv512 C len\",len(civ512),\"Rust decl\",n4,\"len\",len(riv512))\ndiff(civ256,riv256,'IV256',2)\ndiff(civ512,riv512,'IV512',2)\n\n# Cross-check IV bytes against known SHA-256/512 IVs\nsha256iv=[0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19]\nexp=b''.join(v.to_bytes(4,'big') for v in sha256iv)\nprint(\"IV256 matches FIPS:\", bytes(civ256)==exp, bytes(riv256)==exp)\nsha512iv=[0x6a09e667f3bcc908,0xbb67ae8584caa73b,0x3c6ef372fe94f82b,0xa54ff53a5f1d36f1,\n          0x510e527fade682d1,0x9b05688c2b3e6c1f,0x1f83d9abfb41bd6b,0x5be0cd19137e2179]\nexp5=b''.join(v.to_bytes(8,'big') for v in sha512iv)\nprint(\"IV512 matches FIPS:\", bytes(civ512)==exp5, bytes(riv512)==exp5)\n\n# Cross-check K tables against FIPS\nimport hashlib\n# FIPS K256 derived from cube roots\ndef frac_bits(p, bits):\n    import decimal\n    decimal.getcontext().prec=80\n    x = decimal.Decimal(p)**(decimal.Decimal(1)/decimal.Decimal(3))\n    fr = x - int(x)\n    return int(fr * (1<<bits))\nprimes=[]\nn_=2\nwhile len(primes)<80:\n    if all(n_%p for p in range(2,int(n_**0.5)+1)):\n        primes.append(n_)\n    n_+=1\nk256_fips=[frac_bits(p,32) for p in primes[:64]]\nk512_fips=[frac_bits(p,64) for p in primes[:80]]\nprint(\"K256 == FIPS:\", c256==k256_fips, r256==k256_fips)\nprint(\"K512 == FIPS:\", c512==k512_fips, r512==k512_fips)\nbad=[(i,hex(a),hex(b)) for i,(a,b) in enumerate(zip(c512,k512_fips)) if a!=b]\nprint(\"C K512 vs FIPS diffs:\", bad[:5])\nbad=[(i,hex(a),hex(b)) for i,(a,b) in enumerate(zip(r512,k512_fips)) if a!=b]\nprint(\"R K512 vs FIPS diffs:\", bad[:5])\nEOF","description":"Mechanically diff SHA constant tables"}}],"stop_reason":null,"stop_sequence":null,"st