{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FuaUQmSKbpv5pEF44eFvjB","type":"tool_result","content":"1\t//! Translation of `lib/shake/src/fips202.c`.\n2\t//!\n3\t//! The Keccak-f[1600] permutation is a standard, fixed function; this uses the\n4\t//! well-known compact formulation, which produces output identical to the\n5\t//! reference `KeccakF1600_StatePermute`. All the SHAKE/SHA3 wrappers are ported\n6\t//! directly from the C so their padding/rate handling is byte-for-byte the same.\n7\t\n8\tpub const SHAKE128_RATE: usize = 168;\n9\tpub const SHAKE256_RATE: usize = 136;\n10\tpub const SHA3_256_RATE: usize = 136;\n11\tpub const SHA3_512_RATE: usize = 72;\n12\t\n13\tconst NROUNDS: usize = 24;\n14\t\n15\t#[inline(always)]\n16\tfn rol(a: u64, offset: u32) -> u64 {\n17\t    (a << offset) ^ (a >> (64 - offset))\n18\t}\n19\t\n20\t#[inline(always)]\n21\tunsafe fn load64(x: *const u8) -> u64 {\n22\t    let mut r: u64 = 0;\n23\t    for i in 0..8 {\n24\t        r |= (*x.add(i) as u64) << (8 * i);\n25\t    }\n26\t    r\n27\t}\n28\t\n29\t#[inline(always)]\n30\tunsafe fn store64(x: *mut u8, u: u64) {\n31\t    for i in 0..8 {\n32\t        *x.add(i) = (u >> (8 * i)) as u8;\n33\t    }\n34\t}\n35\t\n36\tstatic KECCAK_F_ROUND_CONSTANTS: [u64; NROUNDS] = [\n37\t    0x0000000000000001,\n38\t    0x0000000000008082,\n39\t    0x800000000000808a,\n40\t    0x8000000080008000,\n41\t    0x000000000000808b,\n42\t    0x0000000080000001,\n43\t    0x8000000080008081,\n44\t    0x8000000000008009,\n45\t    0x000000000000008a,\n46\t    0x0000000000000088,\n47\t    0x0000000080008009,\n48\t    0x000000008000000a,\n49\t    0x000000008000808b,\n50\t    0x800000000000008b,\n51\t    0x8000000000008089,\n52\t    0x8000000000008003,\n53\t    0x8000000000008002,\n54\t    0x8000000000000080,\n55\t    0x000000000000800a,\n56\t    0x800000008000000a,\n57\t    0x8000000080008081,\n58\t    0x8000000000008080,\n59\t    0x0000000080000001,\n60\t    0x8000000080008008,\n61\t];\n62\t\n63\tconst ROTC: [u32; 24] = [\n64\t    1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 2, 14, 27, 41, 56, 8, 25, 43, 62, 18, 39, 61, 20, 44,\n65\t];\n66\tconst PILN: [usize; 24] = [\n67\t    10, 7, 11, 17, 18, 3, 5, 16, 8, 21, 24, 4, 15, 23, 19, 13, 12, 2, 20, 14, 22, 9, 6, 1,\n68\t];\n69\t\n70\t/// The Keccak-f[1600] permutation, operating on the 25 lanes at `state`.\n71\tunsafe fn keccak_f1600_state_permute(state: *mut u64) {\n72\t    let st = core::slice::from_raw_parts_mut(state, 25);\n73\t    let mut bc = [0u64; 5];\n74\t\n75\t    for r in 0..NROUNDS {\n76\t        // Theta\n77\t        for i in 0..5 {\n78\t            bc[i] = st[i] ^ st[i + 5] ^ st[i + 10] ^ st[i + 15] ^ st[i + 20];\n79\t        }\n80\t        for i in 0..5 {\n81\t            let t = bc[(i + 4) % 5] ^ rol(bc[(i + 1) % 5], 1);\n82\t            let mut j = 0;\n83\t            while j < 25 {\n84\t                st[j + i] ^= t;\n85\t                j += 5;\n86\t            }\n87\t        }\n88\t\n89\t        // Rho Pi\n90\t        let mut t = st[1];\n91\t        for i in 0..24 {\n92\t            let j = PILN[i];\n93\t            let tmp = st[j];\n94\t            st[j] = rol(t, ROTC[i]);\n95\t            t = tmp;\n96\t        }\n97\t\n98\t        // Chi\n99\t        let mut j = 0;\n100\t        while j < 25 {\n101\t            for i in 0..5 {\n102\t                bc[i] = st[j + i];\n103\t            }\n104\t            for i in 0..5 {\n105\t                st[j + i] ^= (!bc[(i + 1) % 5]) & bc[(i + 2) % 5];\n106\t            }\n107\t            j += 5;\n108\t        }\n109\t\n110\t        // Iota\n111\t        st[0] ^= KECCAK_F_ROUND_CONSTANTS[r];\n112\t    }\n113\t}\n114\t\n115\t/// Absorb step of Keccak; non-incremental, starts by zeroeing the state.\n116\tunsafe fn keccak_absorb(s: *mut u64, r: usize, mut m: *const u8, mut mlen: usize, p: u8) {\n117\t    let mut t = [0u8; 200];\n118\t\n119\t    for i in 0..25 {\n120\t        *s.add(i) = 0;\n121\t    }\n122\t\n123\t    while mlen >= r {\n124\t        for i in 0..(r / 8) {\n125\t            *s.add(i) ^= load64(m.add(8 * i));\n126\t        }\n127\t        keccak_f1600_state_permute(s);\n128\t        mlen -= r;\n129\t        m = m.add(r);\n130\t    }\n131\t\n132\t    for i in 0..r {\n133\t        t[i] = 0;\n134\t    }\n135\t    for i in 0..mlen {\n136\t        t[i] = *m.add(i);\n137\t    }\n138\t    t[mlen] = p;\n139\t    t[r - 1] |= 128;\n140\t    for i in 0..(r / 8) {\n141\t        *s.add(i) ^= load64(t.as_ptr().add(8 * i));\n142\t    }\n143\t}\n144\t\n145\t/// Squeeze step of Keccak. Squeezes full blocks of `r` bytes each.\n146\tunsafe fn keccak_squeezeblocks(mut h: *mut u8, mut nblocks: usize, s: *mut u64, r: usize) {\n147\t    while nblocks > 0 {\n148\t        keccak_f1600_state_permute(s);\n149\t        for i in 0..(r >> 3) {\n150\t            store64(h.add(8 * i), *s.add(i));\n151\t        }\n152\t        h = h.add(r);\n153\t        nblocks -= 1;\n154\t    }\n155\t}\n156\t\n157\t/// Initializes the incremental Keccak state to zero. `s_inc` has 26 lanes.\n158\tunsafe fn keccak_inc_init(s_inc: *mut u64) {\n159\t    for i in 0..25 {\n160\t        *s_inc.add(i) = 0;\n161\t    }\n162\t    *s_inc.add(25) = 0;\n163\t}\n164\t\n165\tunsafe fn keccak_inc_absorb(s_inc: *mut u64, r: usize, mut m: *const u8, mut mlen: usize) {\n166\t    // Recall that s_inc[25] is the non-absorbed bytes xored into the state.\n167\t    while mlen + (*s_inc.add(25)) as usize >= r {\n168\t        let pos = (*s_inc.add(25)) as usize;\n169\t        for i in 0..(r - pos) {\n170\t            let bitpos = pos + i;\n171\t            *s_inc.add(bitpos >> 3) ^= (*m.add(i) as u64) << (8 * (bitpos & 0x07));\n172\t        }\n173\t        mlen -= r - pos;\n174\t        m = m.add(r - pos);\n175\t        *s_inc.add(25) = 0;\n176\t\n177\t        keccak_f1600_state_permute(s_inc);\n178\t    }\n179\t\n180\t    let pos = (*s_inc.add(25)) as usize;\n181\t    for i in 0..mlen {\n182\t        let bitpos = pos + i;\n183\t        *s_inc.add(bitpos >> 3) ^= (*m.add(i) as u64) << (8 * (bitpos & 0x07));\n184\t    }\n185\t    *s_inc.add(25) += mlen as u64;\n186\t}\n187\t\n188\tunsafe fn keccak_inc_finalize(s_inc: *mut u64, r: usize, p: u8) {\n189\t    let pos = (*s_inc.add(25)) as usize;\n190\t    *s_inc.add(pos >> 3) ^= (p as u64) << (8 * (pos & 0x07));\n191\t    *s_inc.add((r - 1) >> 3) ^= 128u64 << (8 * ((r - 1) & 0x07));\n192\t    *s_inc.add(25) = 0;\n193\t}\n194\t\n195\tunsafe fn keccak_inc_squeeze(mut h: *mut u8, mut outlen: usize, s_inc: *mut u64, r: usize) {\n196\t    // First consume any bytes we still have sitting around.\n197\t    let mut i: usize = 0;\n198\t    while i < outlen && i < (*s_inc.add(25)) as usize {\n199\t        let pos = r - (*s_inc.add(25)) as usize + i;\n200\t        *h.add(i) = (*s_inc.add(pos >> 3) >> (8 * (pos & 0x07))) as u8;\n201\t        i += 1;\n202\t    }\n203\t    h = h.add(i);\n204\t    outlen -= i;\n205\t    *s_inc.add(25) -= i as u64;\n206\t\n207\t    // Then squeeze the remaining necessary blocks.\n208\t    while outlen > 0 {\n209\t        keccak_f1600_state_permute(s_inc);\n210\t\n211\t        let mut i2: usize = 0;\n212\t        while i2 < outlen && i2 < r {\n213\t            *h.add(i2) = (*s_inc.add(i2 >> 3) >> (8 * (i2 & 0x07))) as u8;\n214\t            i2 += 1;\n215\t        }\n216\t        h = h.add(i2);\n217\t        outlen -= i2;\n218\t        *s_inc.add(25) = (r - i2) as u64;\n219\t    }\n220\t}\n221\t\n222\t// ---- SHAKE128 --------------------------------------------------------------\n223\t\n224\t#[unsafe(no_mangle)]\n225\tpub unsafe extern \"C\" fn shake128_absorb(s: *mut u64, input: *const u8, inlen: usize) {\n226\t    keccak_absorb(s, SHAKE128_RATE, input, inlen, 0x1F);\n227\t}\n228\t\n229\t#[unsafe(no_mangle)]\n230\tpub unsafe extern \"C\" fn shake128_squeezeblocks(output: *mut u8, nblocks: usize, s: *mut u64) {\n231\t    keccak_squeezeblocks(output, nblocks, s, SHAKE128_RATE);\n232\t}\n233\t\n234\t#[unsafe(no_mangle)]\n235\tpub unsafe extern \"C\" fn shake128_inc_init