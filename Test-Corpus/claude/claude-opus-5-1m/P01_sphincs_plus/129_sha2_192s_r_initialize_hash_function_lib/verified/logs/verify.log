erential\nfor t in range(300):\n    L=random.randrange(0,5000)\n    d=bytes(random.randrange(256) for _ in range(L))\n    a=buf(32,0x11); b=buf(32,0x11)\n    C.sha256.argtypes=[ctypes.c_char_p,ctypes.c_char_p,ctypes.c_size_t]\n    R.sha256.argtypes=[ctypes.c_char_p,ctypes.c_char_p,ctypes.c_size_t]\n    C.sha512.argtypes=[ctypes.c_char_p,ctypes.c_char_p,ctypes.c_size_t]\n    R.sha512.argtypes=[ctypes.c_char_p,ctypes.c_char_p,ctypes.c_size_t]\n    C.sha256(a,d,L); R.sha256(b,d,L)\n    if a.raw!=b.raw: print(\"rand sha256 mismatch\",L); fails+=1\n    x=buf(64,0x11); y=buf(64,0x11)\n    C.sha512(x,d,L); R.sha512(y,d,L)\n    if x.raw!=y.raw: print(\"rand sha512 mismatch\",L); fails+=1\nprint(\"total fails:\", fails)\nPY","description":"Stress counter edge cases and random lengths"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1379,"cache_read_input_tokens":95801,"cache_creation":{"ephemeral_5m_input_tokens":1379,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01XUoVkG7eFJ5qnx2yCXCWnT","session_id":"0a57186a-e772-4c86-931a-f38c37ec34b0","uuid":"57a44cc3-3c3c-4c88-8749-eff6c2de785f","timestamp":"2026-08-21T13:29:03.279Z","subagent_type":"general-purpose","task_description":"Compare sha2 primitives C vs Rust"}
