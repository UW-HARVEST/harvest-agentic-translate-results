{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01NwfoTCL6cFoqXH4eVHyxvy","type":"tool_result","content":"1\t//! Translation of `lib/haraka/src/thash_haraka_robust.c` and\n2\t//! `lib/haraka/src/thash_haraka_simple.c`. Exactly one variant is compiled,\n3\t//! selected by the `simple` feature (otherwise `robust`, the default).\n4\t\n5\t#[cfg(not(feature = \"simple\"))]\n6\tuse super::haraka::SPX_haraka256;\n7\tuse super::haraka::{SPX_haraka512, SPX_haraka_S};\n8\tuse crate::context::SpxCtx;\n9\tuse crate::params::*;\n10\t\n11\t/// Robust `thash`. Takes an array of inblocks concatenated arrays of SPX_N\n12\t/// bytes.\n13\t#[cfg(not(feature = \"simple\"))]\n14\t#[unsafe(no_mangle)]\n15\tpub unsafe extern \"C\" fn SPX_thash(\n16\t    out: *mut u8,\n17\t    in_: *const u8,\n18\t    inblocks: u32,\n19\t    ctx: *const SpxCtx,\n20\t    addr: *mut u32,\n21\t) {\n22\t    let inblocks = inblocks as usize;\n23\t    let mut buf = vec![0u8; SPX_ADDR_BYTES + inblocks * SPX_N];\n24\t    let mut bitmask = vec![0u8; inblocks * SPX_N];\n25\t    let mut outbuf = [0u8; 32];\n26\t    let mut buf_tmp = [0u8; 64];\n27\t\n28\t    if inblocks == 1 {\n29\t        // F function\n30\t        // Since SPX_N may be smaller than 32, we need a temporary buffer.\n31\t        // `memset(buf_tmp, 0, 64)`: already zeroed at declaration.\n32\t        core::ptr::copy_nonoverlapping(addr as *const u8, buf_tmp.as_mut_ptr(), 32);\n33\t\n34\t        SPX_haraka256(outbuf.as_mut_ptr(), buf_tmp.as_ptr(), ctx);\n35\t        for i in 0..inblocks * SPX_N {\n36\t            buf_tmp[SPX_ADDR_BYTES + i] = *in_.add(i) ^ outbuf[i];\n37\t        }\n38\t        SPX_haraka512(outbuf.as_mut_ptr(), buf_tmp.as_ptr(), ctx);\n39\t        core::ptr::copy_nonoverlapping(outbuf.as_ptr(), out, SPX_N);\n40\t    } else {\n41\t        // All other tweakable hashes\n42\t        core::ptr::copy_nonoverlapping(addr as *const u8, buf.as_mut_ptr(), 32);\n43\t        SPX_haraka_S(\n44\t            bitmask.as_mut_ptr(),\n45\t            (inblocks * SPX_N) as u64,\n46\t            buf.as_ptr(),\n47\t            SPX_ADDR_BYTES as u64,\n48\t            ctx,\n49\t        );\n50\t\n51\t        for i in 0..inblocks * SPX_N {\n52\t            buf[SPX_ADDR_BYTES + i] = *in_.add(i) ^ bitmask[i];\n53\t        }\n54\t\n55\t        SPX_haraka_S(\n56\t            out,\n57\t            SPX_N as u64,\n58\t            buf.as_ptr(),\n59\t            (SPX_ADDR_BYTES + inblocks * SPX_N) as u64,\n60\t            ctx,\n61\t        );\n62\t    }\n63\t}\n64\t\n65\t/// Simple `thash`. Takes an array of inblocks concatenated arrays of SPX_N\n66\t/// bytes.\n67\t#[cfg(feature = \"simple\")]\n68\t#[unsafe(no_mangle)]\n69\tpub unsafe extern \"C\" fn SPX_thash(\n70\t    out: *mut u8,\n71\t    in_: *const u8,\n72\t    inblocks: u32,\n73\t    ctx: *const SpxCtx,\n74\t    addr: *mut u32,\n75\t) {\n76\t    let inblocks = inblocks as usize;\n77\t    let mut buf = vec![0u8; SPX_ADDR_BYTES + inblocks * SPX_N];\n78\t    let mut outbuf = [0u8; 32];\n79\t    let mut buf_tmp = [0u8; 64];\n80\t\n81\t    if inblocks == 1 {\n82\t        // F function\n83\t        // Since SPX_N may be smaller than 32, we need a temporary buffer.\n84\t        // `memset(buf_tmp, 0, 64)`: already zeroed at declaration.\n85\t        core::ptr::copy_nonoverlapping(addr as *const u8, buf_tmp.as_mut_ptr(), 32);\n86\t        core::ptr::copy_nonoverlapping(in_, buf_tmp.as_mut_ptr().add(SPX_ADDR_BYTES), SPX_N);\n87\t\n88\t        SPX_haraka512(outbuf.as_mut_ptr(), buf_tmp.as_ptr(), ctx);\n89\t        core::ptr::copy_nonoverlapping(outbuf.as_ptr(), out, SPX_N);\n90\t    } else {\n91\t        // All other tweakable hashes\n92\t        core::ptr::copy_nonoverlapping(addr as *const u8, buf.as_mut_ptr(), 32);\n93\t        core::ptr::copy_nonoverlapping(\n94\t            in_,\n95\t            buf.as_mut_ptr().add(SPX_ADDR_BYTES),\n96\t            inblocks * SPX_N,\n97\t        );\n98\t\n99\t        SPX_haraka_S(\n100\t            out,\n101\t            SPX_N as u64,\n102\t            buf.as_ptr(),\n103\t            (SPX_ADDR_BYTES + inblocks * SPX_N) as u64,\n104\t            ctx,\n105\t        );\n106\t    }\n107\t}\n108\t"}]},"parent_tool_use_id":"toolu_bdrk_01GdRdw95fm4JWe5RPT853Hb","session_id":"0a57186a-e772-4c86-931a-f38c37ec34b0","uuid":"36fe003d-ef26-4048-82a0-42ead2df11c5","timestamp":"2026-08-21T13:21:36.708Z","subagent_type":"general-purpose","task_description":"Compare haraka backend C vs Rust"}
