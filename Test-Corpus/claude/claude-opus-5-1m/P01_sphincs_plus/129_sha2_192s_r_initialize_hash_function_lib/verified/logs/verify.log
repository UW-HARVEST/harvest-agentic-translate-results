,e,f,g,h = st\n    inlen=len(data); off=0\n    while inlen>=blk:\n        ww=[int.from_bytes(data[off+i*nb:off+(i+1)*nb],'big') for i in range(16)]\n        ki=0\n        ngroups=rounds//16\n        for grp in range(ngroups):\n            if grp>0:\n                # EXPAND: in-place, index order 0..15 with the C operand pattern\n                for j in range(16):\n                    w14=ww[(j+14)%16]; w9=ww[(j+9)%16]; w1=ww[(j+1)%16]\n                    ww[j]=(s1(w14)+w9+s0(w1)+ww[j])&M\n            for j in range(16):\n                T1=(h+S1(e)+((e&f)^((~e&M)&g))+Ktab[ki]+ww[j])&M\n                T2=(S0(a)+((a&b)^(a&c)^(b&c)))&M\n                h=g;g=f;f=e;e=(d+T1)&M;d=c;c=b;b=a;a=(T1+T2)&M\n                ki+=1\n        a=(a+st[0])&M;b=(b+st[1])&M;c=(c+st[2])&M;d=(d+st[3])&M\n        e=(e+st[4])&M;f=(f+st[5])&M;g=(g+st[6])&M;h=(h+st[7])&M\n        st=[a,b,c,d,e,f,g,h]\n        off+=blk; inlen-=blk\n    out=b''.join(v.to_bytes(nb,'big') for v in st)\n    return out, inlen\n\ndef hashblocks_R(statebytes, data, w, Ktab, rounds, blk):\n    nb=w//8; M=(1<<w)-1\n    S0,S1,s0,s1=sig(w)\n    st=[int.from_bytes(statebytes[i*nb:(i+1)*nb],'big') for i in range(8)]\n    a,b,c,d,e,f,g,h=st\n    inlen=len(data); off=0\n    while inlen>=blk:\n        ww=[0]*rounds\n        for i in range(16): ww[i]=int.from_bytes(data[off+i*nb:off+(i+1)*nb],'big')\n        for i in range(16,rounds):\n            ww[i]=(s1(ww[i-2])+ww[i-7]+s0(ww[i-15])+ww[i-16])&M\n        for i in range(rounds):\n            T1=(h+S1(e)+((e&f)^((~e&M)&g))+Ktab[i]+ww[i])&M\n            T2=(S0(a)+((a&b)^(a&c)^(b&c)))&M\n            h=g;g=f;f=e;e=(d+T1)&M;d=c;c=b;b=a;a=(T1+T2)&M\n        a=(a+st[0])&M;b=(b+st[1])&M;c=(c+st[2])&M;d=(d+st[3])&M\n        e=(e+st[4])&M;f=(f+st[5])&M;g=(g+st[6])&M;h=(h+st[7])&M\n        st=[a,b,c,d,e,f,g,h]\n        off+=blk; inlen-=blk\n    return b''.join(v.to_bytes(nb,'big') for v in st), inlen\n\nK512=[0x428a2f98d728ae22,0x7137449123ef65cd,0xb5c0fbcfec4d3b2f,0xe9b5dba58189d