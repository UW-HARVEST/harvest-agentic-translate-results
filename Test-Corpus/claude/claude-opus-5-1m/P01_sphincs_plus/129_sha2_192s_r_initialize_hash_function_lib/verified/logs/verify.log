{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Fk7qkWoDJMT8vgqSoEmmtg","type":"tool_result","content":"1\t//! Translation of `lib/haraka/src/haraka.c`.\n2\t//!\n3\t//! Constant time implementation of the Haraka hash function.\n4\t//!\n5\t//! The bit-sliced implementation of the AES round functions are based on the\n6\t//! AES implementation in BearSSL written by Thomas Pornin <pornin@bolet.org>.\n7\t\n8\tuse crate::context::SpxCtx;\n9\tuse crate::params::SPX_N;\n10\t\n11\tconst HARAKAS_RATE: usize = 32;\n12\t\n13\t#[rustfmt::skip]\n14\tstatic haraka512_rc64: [[u64; 8]; 10] = [\n15\t    [0x24cf0ab9086f628b, 0xbdd6eeecc83b8382, 0xd96fb0306cdad0a7, 0xaace082ac8f95f89, 0x449d8e8870d7041f, 0x49bb2f80b2b3e2f8, 0x0569ae98d93bb258, 0x23dc9691e7d6a4b1],\n16\t    [0xd8ba10ede0fe5b6e, 0x7ecf7dbe424c7b8e, 0x6ea9949c6df62a31, 0xbf3f3c97ec9c313e, 0x241d03a196a1861e, 0xead3a51116e5a2ea, 0x77d479fcad9574e3, 0x18657a1af894b7a0],\n17\t    [0x10671e1a7f595522, 0xd9a00ff675d28c7b, 0x2f1edf0d2b9ba661, 0xb8ff58b8e3de45f9, 0xee29261da9865c02, 0xd1532aa4b50bdf43, 0x8bf858159b231bb1, 0xdf17439d22d4f599],\n18\t    [0xdd4b2f0870b918c0, 0x757a81f3b39b1bb6, 0x7a5c556898952e3f, 0x7dd70a16d915d87a, 0x3ae61971982b8301, 0xc3ab319e030412be, 0x17c0033ac094a8cb, 0x5a0630fc1a8dc4ef],\n19\t    [0x17708988c1632f73, 0xf92ddae090b44f4f, 0x11ac0285c43aa314, 0x509059941936b8ba, 0xd03e152fa2ce9b69, 0x3fbcbcb63a32998b, 0x6204696d692254f7, 0x915542ed93ec59b4],\n20\t    [0xf4ed94aa8879236e, 0xff6cb41cd38e03c0, 0x069b38602368aeab, 0x669495b820f0ddba, 0xf42013b1b8bf9e3d, 0xcf935efe6439734d, 0xbc1dcf42ca29e3f8, 0x7e6d3ed29f78ad67],\n21\t    [0xf3b0f6837ffcddaa, 0x3a76faef934ddf41, 0xcec7ae583a9c8e35, 0xe4dd18c68f0260af, 0x2c0e5df1ad398eaa, 0x478df5236ae22e8c, 0xfb944c46fe865f39, 0xaa48f82f028132ba],\n22\t    [0x231b9ae2b76aca77, 0x292a76a712db0b40, 0x5850625dc8134491, 0x73137dd469810fb5, 0x8a12a6a202a474fd, 0xd36fd9daa78bdb80, 0xb34c5e733505706f, 0xbaf1cdca818d9d96],\n23\t    [0x2e99781335e8c641, 0xbddfe5cce47d560e, 0xf74e9bf32e5e040c, 0x1d7a709d65996be9, 0x670df36a9cf66cdd, 0xd05ef84a176a2875, 0x0f888e828cb1c44e, 0x1a79e9c9727b052c],\n24\t    [0x83497348628d84de, 0x2e9387d51f22a754, 0xb000068da2f852d6, 0x378c9e1190fd6fe5, 0x870027c316de7293, 0xe51a9d4462e047bb, 0x90ecf7f8c6251195, 0x655953bfbed90a9c],\n25\t];\n26\t\n27\t#[inline]\n28\tunsafe fn br_dec32le(src: *const u8) -> u32 {\n29\t    (*src.add(0) as u32)\n30\t        | ((*src.add(1) as u32) << 8)\n31\t        | ((*src.add(2) as u32) << 16)\n32\t        | ((*src.add(3) as u32) << 24)\n33\t}\n34\t\n35\tunsafe fn br_range_dec32le(v: *mut u32, num: usize, src: *const u8) {\n36\t    let mut v = v;\n37\t    let mut src = src;\n38\t    let mut num = num;\n39\t    while num > 0 {\n40\t        num -= 1;\n41\t        *v = br_dec32le(src);\n42\t        v = v.add(1);\n43\t        src = src.add(4);\n44\t    }\n45\t}\n46\t\n47\t#[inline]\n48\tunsafe fn br_enc32le(dst: *mut u8, x: u32) {\n49\t    *dst.add(0) = x as u8;\n50\t    *dst.add(1) = (x >> 8) as u8;\n51\t    *dst.add(2) = (x >> 16) as u8;\n52\t    *dst.add(3) = (x >> 24) as u8;\n53\t}\n54\t\n55\tunsafe fn br_range_enc32le(dst: *mut u8, v: *const u32, num: usize) {\n56\t    let mut dst = dst;\n57\t    let mut v = v;\n58\t    let mut num = num;\n59\t    while num > 0 {\n60\t        num -= 1;\n61\t        br_enc32le(dst, *v);\n62\t        v = v.add(1);\n63\t        dst = dst.add(4);\n64\t    }\n65\t}\n66\t\n67\t// ---------------------------------------------------------------------------\n68\t// Bit-sliced AES S-box (identical circuit for the 64-bit and 32-bit variants)\n69\t// ---------------------------------------------------------------------------\n70\t\n71\t/// This S-box implementation is a straightforward translation of the circuit\n72\t/// described by Boyar and Peralta in \"A new combinational logic minimization\n73\t/// technique with applications to cryptology\"\n74\t/// (https://eprint.iacr.org/2009/191.pdf).\n75\t///\n76\t/// Note that variables x* (input) and s* (output) are numbered in \"reverse\"\n77\t/// order (x0 is the high bit, x7 is the low bit).\n78\tmacro_rules! def_bitslice_sbox {\n79\t    ($name:ident, $t:ty) => {\n80\t        fn $name(q: &mut [$t; 8]) {\n81\t            let x0: $t = q[7];\n82\t            let x1: $t = q[6];\n83\t            let x2: $t = q[5];\n84\t            let x3: $t = q[4];\n85\t            let x4: $t = q[3];\n86\t            let x5: $t = q[2];\n87\t            let x6: $t = q[1];\n88\t            let x7: $t = q[0];\n89\t\n90\t            // Top linear transformation.\n91\t            let y14 = x3 ^ x5;\n92\t            let y13 = x0 ^ x6;\n93\t            let y9 = x0 ^ x3;\n94\t            let y8 = x0 ^ x5;\n95\t            let t0 = x1 ^ x2;\n96\t            let y1 = t0 ^ x7;\n97\t            let y4 = y1 ^ x3;\n98\t            let y12 = y13 ^ y14;\n99\t            let y2 = y1 ^ x0;\n100\t            let y5 = y1 ^ x6;\n101\t            let y3 = y5 ^ y8;\n102\t            let t1 = x4 ^ y12;\n103\t            let y15 = t1 ^ x5;\n104\t            let y20 = t1 ^ x1;\n105\t            let y6 = y15 ^ x7;\n106\t            let y10 = y15 ^ t0;\n107\t            let y11 = y20 ^ y9;\n108\t            let y7 = x7 ^ y11;\n109\t            let y17 = y10 ^ y11;\n110\t            let y19 = y10 ^ y8;\n111\t            let y16 = t0 ^ y11;\n112\t            let y21 = y13 ^ y16;\n113\t            let y18 = x0 ^ y16;\n114\t\n115\t            // Non-linear section.\n116\t            let t2 = y12 & y15;\n117\t            let t3 = y3 & y6;\n118\t            let t4 = t3 ^ t2;\n119\t            let t5 = y4 & x7;\n120\t            let t6 = t5 ^ t2;\n121\t            let t7 = y13 & y16;\n122\t            let t8 = y5 & y1;\n123\t            let t9 = t8 ^ t7;\n124\t            let t10 = y2 & y7;\n125\t            let t11 = t10 ^ t7;\n126\t            let t12 = y9 & y11;\n127\t            let t13 = y14 & y17;\n128\t            let t14 = t13 ^ t12;\n129\t            let t15 = y8 & y10;\n130\t            let t16 = t15 ^ t12;\n131\t            let t17 = t4 ^ t14;\n132\t            let t18 = t6 ^ t16;\n133\t            let t19 = t9 ^ t14;\n134\t            let t20 = t11 ^ t16;\n135\t            let t21 = t17 ^ y20;\n136\t            let t22 = t18 ^ y19;\n137\t            let t23 = t19 ^ y21;\n138\t            let t24 = t20 ^ y18;\n139\t\n140\t            let t25 = t21 ^ t22;\n141\t            let t26 = t21 & t23;\n142\t            let t27 = t24 ^ t26;\n143\t            let t28 = t25 & t27;\n144\t            let t29 = t28 ^ t22;\n145\t            let t30 = t23 ^ t24;\n146\t            let t31 = t22 ^ t26;\n147\t            let t32 = t31 & t30;\n148\t            let t33 = t32 ^ t24;\n149\t            let t34 = t23 ^ t33;\n150\t            let t35 = t27 ^ t33;\n151\t            let t36 = t24 & t35;\n152\t            let t37 = t36 ^ t34;\n153\t            let t38 = t27 ^ t36;\n154\t            let t39 = t29 & t38;\n155\t            let t40 = t25 ^ t39;\n156\t\n157\t            let t41 = t40 ^ t37;\n158\t            let t42 = t29 ^ t33;\n159\t            let t43 = t29 ^ t40;\n160\t            let t44 = t33 ^ t37;\n161\t            let t45 = t42 ^ t41;\n162\t            let z0 = t44 & y15;\n163\t            let z1 = t37 & y6;\n164\t            let z2 = t33 & x7;\n165\t            let z3 = t43 & y16;\n166\t            let z4 = t40 & y1;\n167\t            let z5 = t29 & y7;\n168\t            let z6 = t42 & y11;\n169\t            let z7 = t45 & y17;\n170\t            let z8 = t41 & y10;\n171\t            let z9 = t44 & y12;\n172\t            let z10 = t37 & y3;\n173\t            let z11 = t33 & y4;\n174\t            let z12 = t43 & y13;\n175\t            let z13 = t40 & y5;\n176\t            let z14 = t29 & y2;\n177\t            let z15 = t42 & y9;\n178\t            let z16 = t45 & y14;\n179\t            let z17 = t41 & y8;\n180\t\n181\t            // Bottom linear transformation.\n182\t            let t46 = z15 ^ z16;\n183\t            let t47 = z10 ^ z11;\n184\t            let t48 = z5 ^ z13;\n185\t            let t49 = z9 ^ z10;\n186\t            let t50 = z2 ^ z12;\n187\t            let t51 = z2 ^ z5;\n188\t            let t52 = z7 ^ z8;\n189\t            let t53 = z0 ^ z3;\n190\t            let t54 = z6 ^ z7;\n191\t            let t55 = z16 ^ z17;\n192\t            let t56 = z12 ^ t48;\n193\t            let t57 = t50 ^ t53;\n194\t            let t58 = z4 ^ t46;\n195\t            let t59 = z3 ^ t54;\n196\t            let t60 = t46 ^ t57;\n197\t            let t61 = z14 ^ t57;\n198\t            let t62 = t52 ^ t58;\n199\t            let t63 = t49 ^ t58;\n200\t            let t64 = z4 ^ t59;\n201\t            let t65 = t61 ^ t62;\n202\t            let t66 = z1 ^ t63;\n203\t            let s0 = t59 ^ t63;\n204\t            let s6 = t56 ^ !t62;\n205\t            let s7 = t48 ^ !t60;\n206\t            let t67 = t64 ^ t65;\n207\t            let s3 = t53 ^ t66;\n208\t            let s4 = t51 ^ t66;\n209\t            let s5 = t47 ^ t65;\n210\t            let s1 = t64 ^ !s3;\n211\t            let s2 = t55 ^ !t67;\n212\t\n213\t            q[7] = s0;\n214\t            q[6] = s1;\n215\t            q[5] = s2;\n216\t            q[4] = s3;\n217\t            q[3] = s4;\n218\t            q[2] = s5;\n219\t            q[1] = s6;\n220\t            q[0] = s7;\n221\t        }\n222\t    };\n223\t}\n224\t\n225\tdef_bitslice_sbox!(br_aes_ct64_bitslice_Sbox, u64);\n226\tdef_bitslice_sbox!(br_aes_ct_bitslice_Sbox, u32);\n227\t\n228\t// ---------------------------------------------------------------------------\n229\t// 32-bit (haraka256) helpers\n230\t// ---------------------------------------------------------------------------\n231\t\n232\t#[inline]\n233\tfn swapn32(q: &mut [u32; 8], i: usize, j: usize, cl: u32, ch: u32, s: u32) {\n234\t    let a = q[i];\n235\t    let b = q[j];\n236\t    q[i] = (a & cl) | ((b & cl) << s);\n237\t    q[j] = ((a & ch) >> s) | (b & ch);\n238\t}\n239\t\n240\tfn br_aes_ct_ortho(q: &mut [u32; 8]) {\n241\t    // SWAP2_32\n242\t    swapn32(q, 0, 1, 0x55555555, 0xAAAAAAAA, 1);\n243\t    swapn32(q, 2, 3, 0x55555555, 0xAAAAAAAA, 1);\n244\t    swapn32(q, 4, 5, 0x55555555, 0xAAAAAAAA, 1);\n245\t    swapn32(q, 6, 7, 0x55555555, 0xAAAAAAAA, 1);\n246\t\n247\t    // SWAP4_32\n248\t    swapn32(q, 0, 2, 0x33333333, 0xCCCCCCCC, 2);\n249\t    swapn32(q, 1, 3, 0x33333333, 0xCCCCCCCC, 2);\n250\t    swapn32(q, 4, 6, 0x33333333, 0xCCCCCCCC, 2);\n251\t    swapn32(q, 5, 7, 0x33333333, 0xCCCCCCCC, 2);\n252\t\n253\t    // SWAP8_32\n254\t    swapn32(q, 0, 4, 0x0F0F0F0F, 0xF0F0F0F0, 4);\n255\t    swapn32(q, 1, 5, 0x0F0F0F0F, 0xF0F0F0F0, 4);\n256\t    swapn32(q, 2, 6, 0x0F0F0F0F, 0xF0F0F0F0, 4);\n257\t    swapn32(q, 3, 7, 0x0F0F0F0F, 0xF0F0F0F0, 4);\n258\t}\n259\t\n260\t#[inline]\n261\tfn add_round_key32(q: &mut [u32; 8], sk: &[u32; 8]) {\n262\t    q[0] ^= sk[0];\n263\t    q[1] ^= sk[1];\n264\t    q[2] ^= sk[2];\n265\t    q[3] ^= sk[3];\n266\t    q[4] ^= sk[4];\n267\t    q[5] ^= sk[5];\n268\t    q[6] ^= sk[6];\n269\t    q[7] ^= sk[7];\n270\t}\n271\t\n272\t#[inline]\n273\tfn shift_rows32(q: &mut [u32; 8]) {\n274\t    for i in 0..8 {\n275\t        let x = q[i];\n276\t        q[i] = (x & 0x000000FF)\n277\t            | ((x & 0x0000FC00) >> 2)\n278\t            | ((x & 0x00000300) << 6)\n279\t            | ((x & 0x00F00000) >> 4)\n280\t            | ((x & 0x000F0000) << 4)\n281\t            | ((x & 0xC0000000) >> 6)\n282\t            | ((x & 0x3F000000) << 2);\n283\t    }\n284\t}\n285\t\n286\t#[inline]\n287\tfn rotr16(x: u32) -> u32 {\n288\t    (x << 16) | (x >> 16)\n289\t}\n290\t\n291\t#[inline]\n292\tfn mix_columns32(q: &mut [u32; 8]) {\n293\t    let q0 = q[0];\n294\t    let q1 = q[1];\n295\t    let q2 = q[2];\n296\t    let q3 = q[3];\n297\t    let q4 = q[4];\n298\t    let q5 = q[5];\n299\t    let q6 = q[6];\n300\t    let q7 = q[7];\n301\t    let r0 = (q0 >> 8) | (q0 << 24);\n302\t    let r1 = (q1 >> 8) | (q1 << 24);\n303\t    let r2 = (q2 >> 8) | (q2 << 24);\n304\t    let r3 = (q3 >> 8) | (q3 << 24);\n305\t    let r4 = (q4 >> 8) | (q4 << 24);\n306\t    let r5 = (q5 >> 8) | (q5 << 24);\n307\t    let r6 = (q6 >> 8) | (q6 << 24);\n308\t    let r7 = (q7 >> 8) | (q7 << 24);\n309\t\n310\t    q[0] = q7 ^ r7 ^ r0 ^ rotr16(q0 ^ r0);\n311\t    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr16(q1 ^ r1);\n312\t    q[2] = q1 ^ r1 ^ r2 ^ rotr16(q2 ^ r2);\n313\t    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr16(q3 ^ r3);\n314\t    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr16(q4 ^ r4);\n315\t    q[5] = q4 ^ r4 ^ r5 ^ rotr16(q5 ^ r5);\n316\t    q[6] = q5 ^ r5 ^ r6 ^ rotr16(q6 ^ r6);\n317\t    q[7] = q6 ^ r6 ^ r7 ^ rotr16(q7 ^ r7);\n318\t}\n319\t\n320\t// ---------------------------------------------------------------------------\n321\t// 64-bit (haraka512) helpers\n322\t// ---------------------------------------------------------------------------\n323\t\n324\t#[inline]\n325\tfn swapn64(q: &mut [u64; 8], i: usize, j: usize, cl: u64, ch: u64, s: u32) {\n326\t    let a = q[i];\n327\t    let b = q[j];\n328\t    q[i] = (a & cl) | ((b & cl) << s);\n329\t    q[j] = ((a & ch) >> s) | (b & ch);\n330\t}\n331\t\n332\tfn br_aes_ct64_ortho(q: &mut [u64; 8]) {\n333\t    // SWAP2\n334\t    swapn64(q, 0, 1, 0x5555555555555555, 0xAAAAAAAAAAAAAAAA, 1);\n335\t    swapn64(q, 2, 3, 0x5555555555555555, 0xAAAAAAAAAAAAAAAA, 1);\n336\t    swapn64(q, 4, 5, 0x5555555555555555, 0xAAAAAAAAAAAAAAAA, 1);\n337\t    swapn64(q, 6, 7, 0x5555555555555555, 0xAAAAAAAAAAAAAAAA, 1);\n338\t\n339\t    // SWAP4\n340\t    swapn64(q, 0, 2, 0x3333333333333333, 0xCCCCCCCCCCCCCCCC, 2);\n341\t    swapn64(q, 1, 3, 0x3333333333333333, 0xCCCCCCCCCCCCCCCC, 2);\n342\t    swapn64(q, 4, 6, 0x3333333333333333, 0xCCCCCCCCCCCCCCCC, 2);\n343\t    swapn64(q, 5, 7, 0x3333333333333333, 0xCCCCCCCCCCCCCCCC, 2);\n344\t\n345\t    // SWAP8\n346\t    swapn64(q, 0, 4, 0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0, 4);\n347\t    swapn64(q, 1, 5, 0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0, 4);\n348\t    swapn64(q, 2, 6, 0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0, 4);\n349\t    swapn64(q, 3, 7, 0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0, 4);\n350\t}\n351\t\n352\t/// Returns `(*q0, *q1)` for the four 32-bit words at `w[off..off + 4]`.\n353\tfn br_aes_ct64_interleave_in(w: &[u32], off: usize) -> (u64, u64) {\n354\t    let mut x0 = w[off] as u64;\n355\t    let mut x1 = w[off + 1] as u64;\n356\t    let mut x2 = w[off + 2] as u64;\n357\t    let mut x3 = w[off + 3] as u64;\n358\t    x0 |= x0 << 16;\n359\t    x1 |= x1 << 16;\n360\t    x2 |= x2 << 16;\n361\t    x3 |= x3 << 16;\n362\t    x0 &= 0x0000FFFF0000FFFF;\n363\t    x1 &= 0x0000FFFF0000FFFF;\n364\t    x2 &= 0x0000FFFF0000FFFF;\n365\t    x3 &= 0x0000FFFF0000FFFF;\n366\t    x0 |= x0 << 8;\n367\t    x1 |= x1 << 8;\n368\t    x2 |= x2 << 8;\n369\t    x3 |= x3 << 8;\n370\t    x0 &= 0x00FF00FF00FF00FF;\n371\t    x1 &= 0x00FF00FF00FF00FF;\n372\t    x2 &= 0x00FF00FF00FF00FF;\n373\t    x3 &= 0x00FF00FF00FF00FF;\n374\t    (x0 | (x2 << 8), x1 | (x3 << 8))\n375\t}\n376\t\n377\t/// Writes the four de-interleaved 32-bit words into `w[off..off + 4]`.\n378\tfn br_aes_ct64_interleave_out(w: &mut [u32], off: usize, q0: u64, q1: u64) {\n379\t    let mut x0 = q0 & 0x00FF00FF00FF00FF;\n380\t    let mut x1 = q1 & 0x00FF00FF00FF00FF;\n381\t    let mut x2 = (q0 >> 8) & 0x00FF00FF00FF00FF;\n382\t    let mut x3 = (q1 >> 8) & 0x00FF00FF00FF00FF;\n383\t    x0 |= x0 >> 8;\n384\t    x1 |= x1 >> 8;\n385\t    x2 |= x2 >> 8;\n386\t    x3 |= x3 >> 8;\n387\t    x0 &= 0x0000FFFF0000FFFF;\n388\t    x1 &= 0x0000FFFF0000FFFF;\n389\t    x2 &= 0x0000FFFF0000FFFF;\n390\t    x3 &= 0x0000FFFF0000FFFF;\n391\t    w[off] = (x0 as u32) | ((x0 >> 16) as u32);\n392\t    w[off + 1] = (x1 as u32) | ((x1 >> 16) as u32);\n393\t    w[off + 2] = (x2 as u32) | ((x2 >> 16) as u32);\n394\t    w[off + 3] = (x3 as u32) | ((x3 >> 16) as u32);\n395\t}\n396\t\n397\t#[inline]\n398\tfn add_round_key(q: &mut [u64; 8], sk: &[u64; 8]) {\n399\t    q[0] ^= sk[0];\n400\t    q[1] ^= sk[1];\n401\t    q[2] ^= sk[2];\n402\t    q[3] ^= sk[3];\n403\t    q[4] ^= sk[4];\n404\t    q[5] ^= sk[5];\n405\t    q[6] ^= sk[6];\n406\t    q[7] ^= sk[7];\n407\t}\n408\t\n409\t#[inline]\n410\tfn shift_rows(q: &mut [u64; 8]) {\n411\t    for i in 0..8 {\n412\t        let x = q[i];\n413\t        q[i] = (x & 0x000000000000FFFF)\n414\t            | ((x & 0x00000000FFF00000) >> 4)\n415\t            | ((x & 0x00000000000F0000) << 12)\n416\t            | ((x & 0x0000FF0000000000) >> 8)\n417\t            | ((x & 0x000000FF00000000) << 8)\n418\t            | ((x & 0xF000000000000000) >> 12)\n419\t            | ((x & 0x0FFF000000000000) << 4);\n420\t    }\n421\t}\n422\t\n423\t#[inline]\n424\tfn rotr32(x: u64) -> u64 {\n425\t    (x << 32) | (x >> 32)\n426\t}\n427\t\n428\t#[inline]\n429\tfn mix_columns(q: &mut [u64; 8]) {\n430\t    let q0 = q[0];\n431\t    let q1 = q[1];\n432\t    let q2 = q[2];\n433\t    let q3 = q[3];\n434\t    let q4 = q[4];\n435\t    let q5 = q[5];\n436\t    let q6 = q[6];\n437\t    let q7 = q[7];\n438\t    let r0 = (q0 >> 16) | (q0 << 48);\n439\t    let r1 = (q1 >> 16) | (q1 << 48);\n440\t    let r2 = (q2 >> 16) | (q2 << 48);\n441\t    let r3 = (q3 >> 16) | (q3 << 48);\n442\t    let r4 = (q4 >> 16) | (q4 << 48);\n443\t    let r5 = (q5 >> 16) | (q5 << 48);\n444\t    let r6 = (q6 >> 16) | (q6 << 48);\n445\t    let r7 = (q7 >> 16) | (q7 << 48);\n446\t\n447\t    q[0] = q7 ^ r7 ^ r0 ^ rotr32(q0 ^ r0);\n448\t    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr32(q1 ^ r1);\n449\t    q[2] = q1 ^ r1 ^ r2 ^ rotr32(q2 ^ r2);\n450\t    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr32(q3 ^ r3);\n451\t    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr32(q4 ^ r4);\n452\t    q[5] = q4 ^ r4 ^ r5 ^ rotr32(q5 ^ r5);\n453\t    q[6] = q5 ^ r5 ^ r6 ^ rotr32(q6 ^ r6);\n454\t    q[7] = q6 ^ r6 ^ r7 ^ rotr32(q7 ^ r7);\n455\t}\n456\t\n457\t// ---------------------------------------------------------------------------\n458\t// Constant tweaking\n459\t// ---------------------------------------------------------------------------\n460\t\n461\tunsafe fn interleave_constant(out: &mut [u64; 8], in_: *const u8) {\n462\t    let mut tmp_32_constant = [0u32; 16];\n463\t\n464\t    br_range_dec32le(tmp_32_constant.as_mut_ptr(), 16, in_);\n465\t    for i in 0..4 {\n466\t        let (a, b) = br_aes_ct64_interleave_in(&tmp_32_constant, i << 2);\n467\t        out[i] = a;\n468\t        out[i + 4] = b;\n469\t    }\n470\t    br_aes_ct64_ortho(out);\n471\t}\n472\t\n473\tunsafe fn interleave_constant32(out: &mut [u32; 8], in_: *const u8) {\n474\t    for i in 0..4 {\n475\t        out[2 * i] = br_dec32le(in_.add(4 * i));\n476\t        out[2 * i + 1] = br_dec32le(in_.add(4 * i + 16));\n477\t    }\n478\t    br_aes_ct_ortho(out);\n479\t}\n480\t\n481\t#[unsafe(no_mangle)]\n482\tpub unsafe extern \"C\" fn SPX_tweak_constants(ctx: *mut SpxCtx) {\n483\t    let mut buf = [0u8; 40 * 16];\n484\t\n485\t    // Use the standard constants to generate tweaked ones.\n486\t    (*ctx).tweaked512_rc64 = haraka512_rc64;\n487\t\n488\t    // Constants for pk.seed\n489\t    SPX_haraka_S(\n490\t        buf.as_mut_ptr(),\n491\t        (40 * 16) as u64,\n492\t        (*ctx).pub_seed.as_ptr(),\n493\t        SPX_N as u64,\n494\t        ctx as *const SpxCtx,\n495\t    );\n496\t    for i in 0..10 {\n497\t        interleave_constant32(&mut (*ctx).tweaked256_rc32[i], buf.as_ptr().add(32 * i));\n498\t        interleave_constant(&mut (*ctx).tweaked512_rc64[i], buf.as_ptr().add(64 * i));\n499\t    }\n500\t}\n501\t\n502\t// ---------------------------------------------------------------------------\n503\t// Haraka sponge\n504\t// ---------------------------------------------------------------------------\n505\t\n506\tunsafe fn haraka_S_absorb(\n507\t    s: *mut u8,\n508\t    r: usize,\n509\t    m: *const u8,\n510\t    mlen: u64,\n511\t    p: u8,\n512\t    ctx: *const SpxCtx,\n513\t) {\n514\t    let mut m = m;\n515\t    let mut mlen = mlen;\n516\t    let mut t = vec![0u8; r];\n517\t\n518\t    while mlen >= r as u64 {\n519\t        // XOR block to state\n520\t        for i in 0..r {\n521\t            *s.add(i) ^= *m.add(i);\n522\t        }\n523\t        SPX_haraka512_perm(s, s, ctx);\n524\t        mlen -= r as u64;\n525\t        m = m.add(r);\n526\t    }\n527\t\n528\t    for i in 0..r {\n529\t        t[i] = 0;\n530\t    }\n531\t    let mut i: usize = 0;\n532\t    while (i as u64) < mlen {\n533\t        t[i] = *m.add(i);\n534\t        i += 1;\n535\t    }\n536\t    t[i] = p;\n537\t    t[r - 1] |= 128;\n538\t    for i in 0..r {\n539\t        *s.add(i) ^= t[i];\n540\t    }\n541\t}\n542\t\n543\tunsafe fn haraka_S_squeezeblocks(\n544\t    h: *mut u8,\n545\t    nblocks: u64,\n546\t    s: *mut u8,\n547\t    r: usize,\n548\t    ctx: *const SpxCtx,\n549\t) {\n550\t    let mut h = h;\n551\t    let mut nblocks = nblocks;\n552\t    while nblocks > 0 {\n553\t        SPX_haraka512_perm(s, s, ctx);\n554\t        core::ptr::copy_nonoverlapping(s as *const u8, h, HARAKAS_RATE);\n555\t        h = h.add(r);\n556\t        nblocks -= 1;\n557\t    }\n558\t}\n559\t\n560\t#[unsafe(no_mangle)]\n561\tpub unsafe extern \"C\" fn SPX_haraka_S_inc_init(s_inc: *mut u8) {\n562\t    for i in 0..64 {\n563\t        *s_inc.add(i) = 0;\n564\t    }\n565\t    *s_inc.add(64) = 0;\n566\t}\n567\t\n568\t#[unsafe(no_mangle)]\n569\tpub unsafe extern \"C\" fn SPX_haraka_S_inc_absorb(\n570\t    s_inc: *mut u8,\n571\t    m: *const u8,\n572\t    mlen: usize,\n573\t    ctx: *const SpxCtx,\n574\t) {\n575\t    let mut m = m;\n576\t    let mut mlen = mlen;\n577\t\n578\t    // Recall that s_inc[64] is the non-absorbed bytes xored into the state\n579\t    while mlen + (*s_inc.add(64)) as usize >= HARAKAS_RATE {\n580\t        let avail = HARAKAS_RATE - (*s_inc.add(64)) as usize;\n581\t        for i in 0..avail {\n582\t            // Take the i'th byte from message\n583\t            // xor with the s_inc[64] + i'th byte of the state\n584\t            let off = (*s_inc.add(64)) as usize + i;\n585\t            *s_inc.add(off) ^= *m.add(i);\n586\t        }\n587\t        mlen -= avail;\n588\t        m = m.add(HARAKAS_RATE - (*s_inc.add(64)) as usize);\n589\t        *s_inc.add(64) = 0;\n590\t\n591\t        SPX_haraka512_perm(s_inc, s_inc, ctx);\n592\t    }\n593\t\n594\t    for i in 0..mlen {\n595\t        let off = (*s_inc.add(64)) as usize + i;\n596\t        *s_inc.add(off) ^= *m.add(i);\n597\t    }\n598\t    *s_inc.add(64) = (*s_inc.add(64)).wrapping_add(mlen as u8);\n599\t}\n600\t\n601\t#[unsafe(no_mangle)]\n602\tpub unsafe extern \"C\" fn SPX_haraka_S_inc_finalize(s_inc: *mut u8) {\n603\t    // After haraka_S_inc_absorb, we are guaranteed that s_inc[64] < HARAKAS_RATE,\n604\t    // so we can always use one more byte for p in the current state.\n605\t    let off = (*s_inc.add(64)) as usize;\n606\t    *s_inc.add(off) ^= 0x1F;\n607\t    *s_inc.add(HARAKAS_RATE - 1) ^= 128;\n608\t    *s_inc.add(64) = 0;\n609\t}\n610\t\n611\t#[unsafe(no_mangle)]\n612\tpub unsafe extern \"C\" fn SPX_haraka_S_inc_squeeze(\n613\t    out: *mut u8,\n614\t    outlen: usize,\n615\t    s_inc: *mut u8,\n616\t    ctx: *const SpxCtx,\n617\t) {\n618\t    let mut out = out;\n619\t    let mut outlen = outlen;\n620\t\n621\t    // First consume any bytes we still have sitting around\n622\t    let mut i: usize = 0;\n623\t    while i < outlen && i < (*s_inc.add(64)) as usize {\n624\t        // There are s_inc[64] bytes left, so r - s_inc[64] is the first\n625\t        // available byte. We consume from there, i.e., up to r.\n626\t        *out.add(i) = *s_inc.add(HARAKAS_RATE - (*s_inc.add(64)) as usize + i);\n627\t        i += 1;\n628\t    }\n629\t    out = out.add(i);\n630\t    outlen -= i;\n631\t    *s_inc.add(64) = (*s_inc.add(64)).wrapping_sub(i as u8);\n632\t\n633\t    // Then squeeze the remaining necessary blocks\n634\t    while outlen > 0 {\n635\t        SPX_haraka512_perm(s_inc, s_inc, ctx);\n636\t\n637\t        i = 0;\n638\t        while i < outlen && i < HARAKAS_RATE {\n639\t            *out.add(i) = *s_inc.add(i);\n640\t            i += 1;\n641\t        }\n642\t        out = out.add(i);\n643\t        outlen -= i;\n644\t        *s_inc.add(64) = (HARAKAS_RATE - i) as u8;\n645\t    }\n646\t}\n647\t\n648\t#[unsafe(no_mangle)]\n649\tpub unsafe extern \"C\" fn SPX_haraka_S(\n650\t    out: *mut u8,\n651\t    outlen: u64,\n652\t    in_: *const u8,\n653\t    inlen: u64,\n654\t    ctx: *const SpxCtx,\n655\t) {\n656\t    let mut out = out;\n657\t    let mut s = [0u8; 64];\n658\t    let mut d = [0u8; 32];\n659\t\n660\t    for i in 0..64 {\n661\t        s[i] = 0;\n662\t    }\n663\t    haraka_S_absorb(s.as_mut_ptr(), 32, in_, inlen, 0x1F, ctx);\n664\t\n665\t    haraka_S_squeezeblocks(out, outlen / 32, s.as_mut_ptr(), 32, ctx);\n666\t    out = out.add(((outlen / 32) * 32) as usize);\n667\t\n668\t    if outlen % 32 != 0 {\n669\t        haraka_S_squeezeblocks(d.as_mut_ptr(), 1, s.as_mut_ptr(), 32, ctx);\n670\t        for i in 0..(outlen % 32) as usize {\n671\t            *out.add(i) = d[i];\n672\t        }\n673\t    }\n674\t}\n675\t\n676\t// ---------------------------------------------------------------------------\n677\t// Permutations\n678\t// ---------------------------------------------------------------------------\n679\t\n680\t/// Applies the 512-bit Haraka permutation to `in_`.\n681\t#[unsafe(no_mangle)]\n682\tpub unsafe extern \"C\" fn SPX_haraka512_perm(out: *mut u8, in_: *const u8, ctx: *const SpxCtx) {\n683\t    let mut w = [0u32; 16];\n684\t    let mut q = [0u64; 8];\n685\t\n686\t    br_range_dec32le(w.as_mut_ptr(), 16, in_);\n687\t    for i in 0..4 {\n688\t        let (a, b) = br_aes_ct64_interleave_in(&w, i << 2);\n689\t        q[i] = a;\n690\t        q[i + 4] = b;\n691\t    }\n692\t    br_aes_ct64_ortho(&mut q);\n693\t\n694\t    // AES rounds\n695\t    for i in 0..5 {\n696\t        for j in 0..2 {\n697\t            br_aes_ct64_bitslice_Sbox(&mut q);\n698\t            shift_rows(&mut q);\n699\t            mix_columns(&mut q);\n700\t            add_round_key(&mut q, &(*ctx).tweaked512_rc64[2 * i + j]);\n701\t        }\n702\t        // Mix states\n703\t        for j in 0..8 {\n704\t            let tmp_q = q[j];\n705\t            q[j] = (tmp_q & 0x0001000100010001) << 5\n706\t                | (tmp_q & 0x0002000200020002) << 12\n707\t                | (tmp_q & 0x0004000400040004) >> 1\n708\t                | (tmp_q & 0x0008000800080008) << 6\n709\t                | (tmp_q & 0x0020002000200020) << 9\n710\t                | (tmp_q & 0x0040004000400040) >> 4\n711\t                | (tmp_q & 0x0080008000800080) << 3\n712\t                | (tmp_q & 0x2100210021002100) >> 5\n713\t                | (tmp_q & 0x0210021002100210) << 2\n714\t                | (tmp_q & 0x0800080008000800) << 4\n715\t                | (tmp_q & 0x1000100010001000) >> 12\n716\t                | (tmp_q & 0x4000400040004000) >> 10\n717\t                | (tmp_q & 0x8400840084008400) >> 3;\n718\t        }\n719\t    }\n720\t\n721\t    br_aes_ct64_ortho(&mut q);\n722\t    for i in 0..4 {\n723\t        br_aes_ct64_interleave_out(&mut w, i << 2, q[i], q[i + 4]);\n724\t    }\n725\t    br_range_enc32le(out, w.as_ptr(), 16);\n726\t}\n727\t\n728\t/// Implementation of Haraka-512\n729\t#[unsafe(no_mangle)]\n730\tpub unsafe extern \"C\" fn SPX_haraka512(out: *mut u8, in_: *const u8, ctx: *const SpxCtx) {\n731\t    let mut buf = [0u8; 64];\n732\t\n733\t    SPX_haraka512_perm(buf.as_mut_ptr(), in_, ctx);\n734\t    // Feed-forward\n735\t    for i in 0..64 {\n736\t        buf[i] ^= *in_.add(i);\n737\t    }\n738\t\n739\t    // Truncated\n740\t    core::ptr::copy_nonoverlapping(buf.as_ptr().add(8), out, 8);\n741\t    core::ptr::copy_nonoverlapping(buf.as_ptr().add(24), out.add(8), 8);\n742\t    core::ptr::copy_nonoverlapping(buf.as_ptr().add(32), out.add(16), 8);\n743\t    core::ptr::copy_nonoverlapping(buf.as_ptr().add(48), out.add(24), 8);\n744\t}\n745\t\n746\t/// Implementation of Haraka-256\n747\t#[unsafe(no_mangle)]\n748\tpub unsafe extern \"C\" fn SPX_haraka256(out: *mut u8, in_: *const u8, ctx: *const SpxCtx) {\n749\t    let mut q = [0u32; 8];\n750\t\n751\t    for i in 0..4 {\n752\t        q[2 * i] = br_dec32le(in_.add(4 * i));\n753\t        q[2 * i + 1] = br_dec32le(in_.add(4 * i + 16));\n754\t    }\n755\t    br_aes_ct_ortho(&mut q);\n756\t\n757\t    // AES rounds\n758\t    for i in 0..5 {\n759\t        for j in 0..2 {\n760\t            br_aes_ct_bitslice_Sbox(&mut q);\n761\t            shift_rows32(&mut q);\n762\t            mix_columns32(&mut q);\n763\t            add_round_key32(&mut q, &(*ctx).tweaked256_rc32[2 * i + j]);\n764\t        }\n765\t\n766\t        // Mix states\n767\t        for j in 0..8 {\n768\t            let tmp_q = q[j];\n769\t            q[j] = (tmp_q & 0x81818181)\n770\t                | (tmp_q & 0x02020202) << 1\n771\t                | (tmp_q & 0x04040404) << 2\n772\t                | (tmp_q & 0x08080808) << 3\n773\t                | (tmp_q & 0x10101010) >> 3\n774\t                | (tmp_q & 0x20202020) >> 2\n775\t                | (tmp_q & 0x40404040) >> 1;\n776\t        }\n777\t    }\n778\t\n779\t    br_aes_ct_ortho(&mut q);\n780\t    for i in 0..4 {\n781\t        br_enc32le(out.add(4 * i), q[2 * i]);\n782\t        br_enc32le(out.add(4 * i + 16), q[2 * i + 1]);\n783\t    }\n784\t\n785\t    for i in 0..32 {\n786\t        *out.add(i) ^= *in_.add(i);\n787\t    }\n788\t}\n789\t"}]},"parent_tool_use_id":"toolu_bdrk_01GdRdw95fm4JWe5RPT853Hb","session_id":"0a57186a-e772-4c86-931a-f38c37ec34b0","uuid":"3d0c5dd6-e65f-4da1-838e-3451c40eba55","timestamp":"2026-08-21T13:21:26.326Z","subagent_type":"general-purpose","task_description":"Compare haraka backend C vs Rust"}
