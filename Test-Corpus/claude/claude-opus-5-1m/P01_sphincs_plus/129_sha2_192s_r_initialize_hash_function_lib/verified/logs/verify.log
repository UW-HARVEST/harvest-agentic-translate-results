    S.t[0]=(S.t[0]-mlbytes*8)&MW\n    U(bytes(msglen), mlbytes*8)\n    return b''.join(x.to_bytes(bits//8,'big') for x in S.h)\n\nIV256=[0x6A09E667,0xBB67AE85,0x3C6EF372,0xA54FF53A,0x510E527F,0x9B05688C,0x1F83D9AB,0x5BE0CD19]\nIV512=[0x6A09E667F3BCC908,0xBB67AE8584CAA73B,0x3C6EF372FE94F82B,0xA54FF53A5F1D36F1,\n       0x510E527FADE682D1,0x9B05688C2B3E6C1F,0x1F83D9ABFB41BD6B,0x5BE0CD19137E2179]\n\ndef r_blake256(m):\n    S=St(); S.h=list(IV256); S.s=[0]*4; S.t=[0,0]; S.buflen=0; S.nullt=0; S.buf=bytearray(64)\n    upd(S,m,(len(m)*8)&M64,64,32,comp256,True,False)\n    return final(S,32,64,comp256,PAD256,440,True,False,8)\n\ndef r_blake512(m):\n    S=St(); S.h=list(IV512); S.s=[0]*4; S.t=[0,0]; S.buflen=0; S.nullt=0; S.buf=bytearray(128)\n    upd(S,m,(len(m)*8)&M64,128,64,comp512,False,True)\n    return final(S,64,128,comp512,PAD512,888,False,True,16)\n\ndef r_mgf1(out_bytes, outlen, inp, blake, OB):\n    inbuf=bytearray(inp)+b'\\x00'*4\n    res=bytearray()\n    i=0\n    while (i+1)*OB<=outlen:\n        inbuf[len(inp):len(inp)+4]=i.to_bytes(4,'big')\n        res+=blake(bytes(inbuf))\n        i+=1\n    if outlen>i*OB:\n        inbuf[len(inp):len(inp)+4]=i.to_bytes(4,'big')\n        res+=blake(bytes(inbuf))[:outlen-i*OB]\n    return bytes(res[:outlen])\n\nrandom.seed(7)\nbad=0\nlens=list(range(0,210))+[254,255,256,257,511,512,513,1000,1023,1024,1025]\nfor n in lens:\n    msg=bytes(random.getrandbits(8) for _ in range(n))\n    for name,cf,rf in (('blake256',c_blake256,r_blake256),('blake512',c_blake512,r_blake512)):\n        a=cf(msg); b=rf(msg)\n        if a!=b:\n            print(\"%s MISMATCH len=%d\\n  C=%s\\n  R=%s\"%(name,n,a.hex(),b.hex())); bad+=1\nprint(\"blake256/512 hash differential over %d lengths: %s\"%(len(lens),\"OK\" if bad==0 else \"FAIL(%d)\"%bad))\nprint(\"  blake256('') =\", c_blake256(b'').hex())\nprint(\"  blake512('') =\", c_blake512(b'').hex())\n\nbad2=0\nfor inlen in [0,1,15,16,17,31,32,48,55,56,63,64,65,127,128,129]:\n    inp=bytes(random.getrand