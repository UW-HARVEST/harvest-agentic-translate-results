"OK\" if bad==0 else \"FAIL(%d)\"%bad)\n\n# multi-call incremental squeeze\nbad=0\nfor trial in range(200):\n    parts=[bytes(random.getrandbits(8) for _ in range(random.choice([0,5,32,136,200]))) for _ in range(random.randint(1,3))]\n    sq=[random.choice([1,3,16,32,135,136,137,300]) for _ in range(random.randint(1,4))]\n    st=(ctypes.c_uint64*26)()\n    lib.shake256_inc_init(st)\n    for p in parts: lib.shake256_inc_absorb(st,p,len(p))\n    lib.shake256_inc_finalize(st)\n    a=b''\n    for n in sq:\n        o=ctypes.create_string_buffer(n); lib.shake256_inc_squeeze(o,n,st); a+=o.raw[:n]\n    S=Inc()\n    for p in parts: r_inc_absorb(S,RATE,p)\n    r_inc_finalize(S,RATE,0x1F)\n    b=b''.join(r_inc_squeeze(S,n,RATE) for n in sq)\n    if a!=b: print(\"inc-squeeze MISMATCH\"); bad+=1\nprint(\"shake256 incremental multi-squeeze differential:\", \"OK\" if bad==0 else \"FAIL(%d)\"%bad)\nPYEOF\npython3 \"$TMPDIR/shake_diff.py\"","description":"Differential test fips202 shake256 C vs Rust-model"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5311,"cache_read_input_tokens":138589,"cache_creation":{"ephemeral_5m_input_tokens":5311,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01V1X68qp4eT95TXi73gkWBs","session_id":"0a57186a-e772-4c86-931a-f38c37ec34b0","uuid":"2253eb68-8d01-4db0-9f10-7f6a5492ef1c","timestamp":"2026-08-21T13:28:54.172Z","subagent_type":"general-purpose","task_description":"Compare shake and blake C vs Rust"}
