n        for i in range(5):\n            t=bc[(i+4)%5]^ROL(bc[(i+1)%5],1)\n            j=0\n            while j<25: st[j+i]^=t; j+=5\n        t=st[1]\n        for i in range(24):\n            j=PILN[i]; tmp=st[j]; st[j]=ROL(t,ROTC[i]); t=tmp\n        j=0\n        while j<25:\n            for i in range(5): bc[i]=st[j+i]\n            for i in range(5): st[j+i]^=((~bc[(i+1)%5])&M)&bc[(i+2)%5]\n            j+=5\n        st[0]^=RC[r]\n\nRATE=136\n# Rust keccak_absorb\ndef r_absorb(m, r, p):\n    s=[0]*25\n    off=0; mlen=len(m)\n    t=bytearray(200)\n    while mlen>=r:\n        for i in range(r//8):\n            s[i]^=int.from_bytes(m[off+8*i:off+8*i+8],'little')\n        perm(s); mlen-=r; off+=r\n    for i in range(r): t[i]=0\n    for i in range(mlen): t[i]=m[off+i]\n    t[mlen]=p\n    t[r-1]|=128\n    for i in range(r//8):\n        s[i]^=int.from_bytes(bytes(t[8*i:8*i+8]),'little')\n    return s\ndef r_squeezeblocks(s, nblocks, r):\n    out=bytearray()\n    while nblocks>0:\n        perm(s)\n        for i in range(r>>3): out+=s[i].to_bytes(8,'little')\n        nblocks-=1\n    return bytes(out)\ndef r_shake256(outlen, inp):\n    nblocks=outlen//RATE\n    s=r_absorb(inp,RATE,0x1F)\n    out=bytearray(r_squeezeblocks(s,nblocks,RATE))\n    rem=outlen-nblocks*RATE\n    if rem:\n        t=r_squeezeblocks(s,1,RATE)\n        out+=t[:rem]\n    return bytes(out[:outlen])\n\n# Rust incremental\nclass Inc:\n    def __init__(self): self.s=[0]*26\ndef r_inc_absorb(S, r, m):\n    off=0; mlen=len(m)\n    while mlen+S.s[25]>=r:\n        pos=S.s[25]\n        for i in range(r-pos):\n            bp=pos+i\n            S.s[bp>>3]^=m[off+i]<<(8*(bp&7))\n        mlen-=r-pos; off+=r-pos; S.s[25]=0\n        perm(S.s)\n    pos=S.s[25]\n    for i in range(mlen):\n        bp=pos+i\n        S.s[bp>>3]^=m[off+i]<<(8*(bp&7))\n    S.s[25]+=mlen\ndef r_inc_finalize(S, r, p):\n    pos=S.s[25]\n    S.s[pos>>3]^=p<<(8*(pos&7))\n    S.s[(r-1)>>3]^=128<<(8*((r-1)&7))\n    S.s[25]=0\ndef r_inc_squeeze(S, out