{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01J9MZA31tyvybQhzGm78gx5","type":"tool_result","content":"1\t//! Translation of `lib/sha2/src/sha2.c`.\n2\t//!\n3\t//! Based on the public domain implementation in `crypto_hash/sha512/ref/` from\n4\t//! <http://bench.cr.yp.to/supercop.html> by D. J. Bernstein.\n5\t//!\n6\t//! The incremental state layout mirrors the C one exactly: 32 bytes of\n7\t//! big-endian SHA-256 chaining state followed by an 8-byte big-endian byte\n8\t//! counter (40 bytes total), and 64 + 8 = 72 bytes for SHA-512.\n9\t\n10\tuse crate::context::SpxCtx;\n11\tuse crate::params::{SPX_N, SPX_SHA512};\n12\tuse crate::utils::SPX_u32_to_bytes;\n13\tuse core::ffi::c_ulong;\n14\t\n15\t// From `lib/sha2/include/sha2.h`.\n16\tpub const SPX_SHA256_BLOCK_BYTES: usize = 64;\n17\tpub const SPX_SHA256_OUTPUT_BYTES: usize = 32; // This does not necessarily equal SPX_N\n18\tpub const SPX_SHA512_BLOCK_BYTES: usize = 128;\n19\tpub const SPX_SHA512_OUTPUT_BYTES: usize = 64;\n20\t\n21\t// ---------------------------------------------------------------------------\n22\t// Big-endian load/store helpers\n23\t// ---------------------------------------------------------------------------\n24\t\n25\t#[inline(always)]\n26\tunsafe fn load_bigendian_32(x: *const u8) -> u32 {\n27\t    (*x.add(3) as u32)\n28\t        | ((*x.add(2) as u32) << 8)\n29\t        | ((*x.add(1) as u32) << 16)\n30\t        | ((*x.add(0) as u32) << 24)\n31\t}\n32\t\n33\t#[inline(always)]\n34\tunsafe fn load_bigendian_64(x: *const u8) -> u64 {\n35\t    (*x.add(7) as u64)\n36\t        | ((*x.add(6) as u64) << 8)\n37\t        | ((*x.add(5) as u64) << 16)\n38\t        | ((*x.add(4) as u64) << 24)\n39\t        | ((*x.add(3) as u64) << 32)\n40\t        | ((*x.add(2) as u64) << 40)\n41\t        | ((*x.add(1) as u64) << 48)\n42\t        | ((*x.add(0) as u64) << 56)\n43\t}\n44\t\n45\t#[inline(always)]\n46\tunsafe fn store_bigendian_32(x: *mut u8, mut u: u64) {\n47\t    *x.add(3) = u as u8;\n48\t    u >>= 8;\n49\t    *x.add(2) = u as u8;\n50\t    u >>= 8;\n51\t    *x.add(1) = u as u8;\n52\t    u >>= 8;\n53\t    *x.add(0) = u as u8;\n54\t}\n55\t\n56\t#[inline(always)]\n57\tunsafe fn store_bigendian_64(x: *mut u8, mut u: u64) {\n58\t    *x.add(7) = u as u8;\n59\t    u >>= 8;\n60\t    *x.add(6) = u as u8;\n61\t    u >>= 8;\n62\t    *x.add(5) = u as u8;\n63\t    u >>= 8;\n64\t    *x.add(4) = u as u8;\n65\t    u >>= 8;\n66\t    *x.add(3) = u as u8;\n67\t    u >>= 8;\n68\t    *x.add(2) = u as u8;\n69\t    u >>= 8;\n70\t    *x.add(1) = u as u8;\n71\t    u >>= 8;\n72\t    *x.add(0) = u as u8;\n73\t}\n74\t\n75\t// ---------------------------------------------------------------------------\n76\t// Round functions\n77\t// ---------------------------------------------------------------------------\n78\t\n79\t#[inline(always)]\n80\tfn ch_32(x: u32, y: u32, z: u32) -> u32 {\n81\t    (x & y) ^ (!x & z)\n82\t}\n83\t#[inline(always)]\n84\tfn maj_32(x: u32, y: u32, z: u32) -> u32 {\n85\t    (x & y) ^ (x & z) ^ (y & z)\n86\t}\n87\t#[inline(always)]\n88\tfn big_sigma0_32(x: u32) -> u32 {\n89\t    x.rotate_right(2) ^ x.rotate_right(13) ^ x.rotate_right(22)\n90\t}\n91\t#[inline(always)]\n92\tfn big_sigma1_32(x: u32) -> u32 {\n93\t    x.rotate_right(6) ^ x.rotate_right(11) ^ x.rotate_right(25)\n94\t}\n95\t#[inline(always)]\n96\tfn small_sigma0_32(x: u32) -> u32 {\n97\t    x.rotate_right(7) ^ x.rotate_right(18) ^ (x >> 3)\n98\t}\n99\t#[inline(always)]\n100\tfn small_sigma1_32(x: u32) -> u32 {\n101\t    x.rotate_right(17) ^ x.rotate_right(19) ^ (x >> 10)\n102\t}\n103\t\n104\t#[inline(always)]\n105\tfn ch_64(x: u64, y: u64, z: u64) -> u64 {\n106\t    (x & y) ^ (!x & z)\n107\t}\n108\t#[inline(always)]\n109\tfn maj_64(x: u64, y: u64, z: u64) -> u64 {\n110\t    (x & y) ^ (x & z) ^ (y & z)\n111\t}\n112\t#[inline(always)]\n113\tfn big_sigma0_64(x: u64) -> u64 {\n114\t    x.rotate_right(28) ^ x.rotate_right(34) ^ x.rotate_right(39)\n115\t}\n116\t#[inline(always)]\n117\tfn big