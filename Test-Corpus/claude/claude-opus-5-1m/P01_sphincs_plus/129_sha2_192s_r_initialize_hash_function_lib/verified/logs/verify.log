    store_bigendian_64(state + 32, bytes);\n500\t}\n501\t\n502\tvoid sha512_inc_blocks(uint8_t *state, const uint8_t *in, size_t inblocks) {\n503\t    uint64_t bytes = load_bigendian_64(state + 64);\n504\t\n505\t    crypto_hashblocks_sha512(state, in, 128 * inblocks);\n506\t    bytes += 128 * inblocks;\n507\t\n508\t    store_bigendian_64(state + 64, bytes);\n509\t}\n510\t\n511\tvoid sha256_inc_finalize(uint8_t *out, uint8_t *state, const uint8_t *in, size_t inlen) {\n512\t    uint8_t padded[128];\n513\t    uint64_t bytes = load_bigendian_64(state + 32) + inlen;\n514\t\n515\t    crypto_hashblocks_sha256(state, in, inlen);\n516\t    in += inlen;\n517\t    inlen &= 63;\n518\t    in -= inlen;\n519\t\n520\t    for (size_t i = 0; i < inlen; ++i) {\n521\t        padded[i] = in[i];\n522\t    }\n523\t    padded[inlen] = 0x80;\n524\t\n525\t    if (inlen < 56) {\n526\t        for (size_t i = inlen + 1; i < 56; ++i) {\n527\t            padded[i] = 0;\n528\t        }\n529\t        padded[56] = (uint8_t) (bytes >> 53);\n530\t        padded[57] = (uint8_t) (bytes >> 45);\n531\t        padded[58] = (uint8_t) (bytes >> 37);\n532\t        padded[59] = (uint8_t) (bytes >> 29);\n533\t        padded[60] = (uint8_t) (bytes >> 21);\n534\t        padded[61] = (uint8_t) (bytes >> 13);\n535\t        padded[62] = (uint8_t) (bytes >> 5);\n536\t        padded[63] = (uint8_t) (bytes << 3);\n537\t        crypto_hashblocks_sha256(state, padded, 64);\n538\t    } else {\n539\t        for (size_t i = inlen + 1; i < 120; ++i) {\n540\t            padded[i] = 0;\n541\t        }\n542\t        padded[120] = (uint8_t) (bytes >> 53);\n543\t        padded[121] = (uint8_t) (bytes >> 45);\n544\t        padded[122] = (uint8_t) (bytes >> 37);\n545\t        padded[123] = (uint8_t) (bytes >> 29);\n546\t        padded[124] = (uint8_t) (bytes >> 21);\n547\t        padded[125] = (uint8_t) (bytes >> 13);\n548\t        padded[126] = (uint8_t) (bytes >> 5);\n549\t        padded[127] = (uint8_t) (bytes << 3);\n550\t     