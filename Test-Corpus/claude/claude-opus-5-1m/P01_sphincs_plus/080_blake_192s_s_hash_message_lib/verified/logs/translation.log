{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FHHFyegRU8tPwUKbJduMzV","type":"tool_result","content":"1\t//! Build-time parameters, derived from the CMake cache variables\n2\t//! `HASH_BACKEND`, `THASH`, and `SECPAR`, which are mapped to Cargo features.\n3\t//!\n4\t//! The values here mirror the `app/params/params-sphincs-*.h` headers together\n5\t//! with the per-backend `*_offsets.h` files of the C project.\n6\t//!\n7\t//! Backend selection priority (matches the module gating in `lib.rs`):\n8\t//! `sha2` > `shake` > `blake` > `haraka` (default when no backend feature set).\n9\t//! THASH: `simple` if set, otherwise `robust`.\n10\t//! SECPAR: resolved from the six `128s/128f/192s/192f/256s/256f` features,\n11\t//! defaulting to `128s` when none are set.\n12\t\n13\t// --- Backend identification -------------------------------------------------\n14\t\n15\t/// True when the SHA2 backend is the active hash backend.\n16\tpub const IS_SHA2: bool = cfg!(feature = \"sha2\");\n17\t\n18\t// --- Security-parameter resolution ------------------------------------------\n19\t\n20\tconst N_IS_256: bool = cfg!(feature = \"256s\") || cfg!(feature = \"256f\");\n21\tconst N_IS_192: bool = cfg!(feature = \"192s\") || cfg!(feature = \"192f\");\n22\tconst IS_FAST: bool =\n23\t    cfg!(feature = \"128f\") || cfg!(feature = \"192f\") || cfg!(feature = \"256f\");\n24\t\n25\t/// Hash output length in bytes.\n26\tpub const SPX_N: usize = if N_IS_256 {\n27\t    32\n28\t} else if N_IS_192 {\n29\t    24\n30\t} else {\n31\t    16\n32\t};\n33\t\n34\t/// Height of the hypertree.\n35\tpub const SPX_FULL_HEIGHT: usize = if N_IS_256 {\n36\t    if IS_FAST {\n37\t        68\n38\t    } else {\n39\t        64\n40\t    }\n41\t} else if IS_FAST {\n42\t    66\n43\t} else {\n44\t    63\n45\t};\n46\t\n47\t/// Number of subtree layers.\n48\tpub const SPX_D: usize = if N_IS_256 {\n49\t    if IS_FAST {\n50\t        17\n51\t    } else {\n52\t        8\n53\t    }\n54\t} else if IS_FAST {\n55\t    22\n56\t} else {\n57\t    7\n58\t};\n59\t\n60\t/// FORS tree height.\n61\tpub const SPX_FORS_HEIGHT: usize = if N_IS_256 {\n62\t    if IS_FAST {\n63\t        9\n64\t    } else {\n65\t        14\n66\t    }\n67\t} else if N_IS_192 {\n68\t    if IS_FAST {\n69\t        8\n70\t    } else {\n71\t        14\n72\t    }\n73\t} else if IS_FAST {\n74\t    6\n75\t} else {\n76\t    12\n77\t};\n78\t\n79\t/// Number of FORS trees.\n80\tpub const SPX_FORS_TREES: usize = if N_IS_256 {\n81\t    if IS_FAST {\n82\t        35\n83\t    } else {\n84\t        22\n85\t    }\n86\t} else if N_IS_192 {\n87\t    if IS_FAST {\n88\t        33\n89\t    } else {\n90\t        17\n91\t    }\n92\t} else if IS_FAST {\n93\t    33\n94\t} else {\n95\t    14\n96\t};\n97\t\n98\t/// Winternitz parameter.\n99\tpub const SPX_WOTS_W: usize = 16;\n100\tpub const SPX_WOTS_LOGW: usize = 4;\n101\t\n102\t/// For clarity.\n103\tpub const SPX_ADDR_BYTES: usize = 32;\n104\t\n105\tpub const SPX_WOTS_LEN1: usize = 8 * SPX_N / SPX_WOTS_LOGW;\n106\tpub const SPX_WOTS_LEN2: usize = if SPX_N <= 8 {\n107\t    2\n108\t} else if SPX_N <= 136 {\n109\t    3\n110\t} else {\n111\t    4\n112\t};\n113\tpub const SPX_WOTS_LEN: usize = SPX_WOTS_LEN1 + SPX_WOTS_LEN2;\n114\tpub const SPX_WOTS_BYTES: usize = SPX_WOTS_LEN * SPX_N;\n115\tpub const SPX_WOTS_PK_BYTES: usize = SPX_WOTS_BYTES;\n116\t\n117\t/// Subtree size.\n118\tpub const SPX_TREE_HEIGHT: usize = SPX_FULL_HEIGHT / SPX_D;\n119\t\n120\t// FORS parameters.\n121\tpub const SPX_FORS_MSG_BYTES: usize = (SPX_FORS_HEIGHT * SPX_FORS_TREES + 7) / 8;\n122\tpub const SPX_FORS_BYTES: usize = (SPX_FORS_HEIGHT + 1) * SPX_FORS_TREES * SPX_N;\n123\tpub const SPX_FORS_PK_BYTES: usize = SPX_N;\n124\t\n125\t// Resulting SPX sizes.\n126\tpub const SPX_BYTES: usize =\n127\t    SPX_N + SPX_FORS_BYTES + SPX_D * SPX_WOTS_BYTES + SPX_FULL_HEIGHT * SPX_N;\n128\tpub const SPX_PK_BYTES: usize = 2 * SPX_N;\n129\tpub const SPX_SK_BYTES: usize = 2 * SPX_N + SPX_PK_BYTES;\n130\t\n131\t// API-level sizes.\n132\tpub const CRYPTO_SECRETKEYBYTES: usize = SPX_SK_BYTES;\n133\tpub const CRYPTO_PUBLICKEYBYTES: usize = SPX_PK_BYTES;\n134\tpub const CRYPTO_BYTES: usize = SPX_BYTES;\n135\tpub const CRYPTO_SEEDBYTES: usize = 3 * SPX_N;\n136\tpub const CRYPTO_ALGNAME: &str = \"SPHINCS+\";\n137\t\n138\t// Whether the SHA2/BLAKE backends use their 512-bit variant for the larger\n139\t// (n >= 24) parameter sets.\n140\tpub const SPX_SHA512: bool = SPX_N >= 24;\n141\tpub const SPX_BLAKE512: bool = SPX_N >= 24;\n142\t\n143\t// --- Address field offsets --------------------------------------------------\n144\t// SHA2 uses a compressed 22-byte address; the other backends use the full\n145\t// 32-byte address layout.\n146\t\n147\tpub const SPX_OFFSET_LAYER: usize = if IS_SHA2 { 0 } else { 3 };\n148\tpub const SPX_OFFSET_TREE: usize = if IS_SHA2 { 1 } else { 8 };\n149\tpub const SPX_OFFSET_TYPE: usize = if IS_SHA2 { 9 } else { 19 };\n150\tpub const SPX_OFFSET_KP_ADDR: usize = if IS_SHA2 { 10 } else { 20 };\n151\tpub const SPX_OFFSET_CHAIN_ADDR: usize = if IS_SHA2 { 17 } else { 27 };\n152\tpub const SPX_OFFSET_HASH_ADDR: usize = if IS_SHA2 { 21 } else { 31 };\n153\tpub const SPX_OFFSET_TREE_HGT: usize = if IS_SHA2 { 17 } else { 27 };\n154\tpub const SPX_OFFSET_TREE_INDEX: usize = if IS_SHA2 { 18 } else { 28 };\n155\t\n156\t// The SHA2 backend hashes a compressed 22-byte representation of the address.\n157\tpub const SPX_SHA256_ADDR_BYTES: usize = 22;\n158\t\n159\t// --- Address type constants (address.h) -------------------------------------\n160\t\n161\tpub const SPX_ADDR_TYPE_WOTS: u32 = 0;\n162\tpub const SPX_ADDR_TYPE_WOTSPK: u32 = 1;\n163\tpub const SPX_ADDR_TYPE_HASHTREE: u32 = 2;\n164\tpub const SPX_ADDR_TYPE_FORSTREE: u32 = 3;\n165\tpub const SPX_ADDR_TYPE_FORSPK: u32 = 4;\n166\tpub const SPX_ADDR_TYPE_WOTSPRF: u32 = 5;\n167\tpub const SPX_ADDR_TYPE_FORSPRF: u32 = 6;\n168\t\n169\t// --- Derived quantities used by hash_message --------------------------------\n170\t\n171\tpub const SPX_TREE_BITS: usize = SPX_TREE_HEIGHT * (SPX_D - 1);\n172\tpub const SPX_TREE_BYTES: usize = (SPX_TREE_BITS + 7) / 8;\n173\tpub const SPX_LEAF_BITS: usize = SPX_TREE_HEIGHT;\n174\tpub const SPX_LEAF_BYTES: usize = (SPX_LEAF_BITS + 7) / 8;\n175\tpub const SPX_DGST_BYTES: usize = SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES;\n176\t"}]},"parent_tool_use_id":"toolu_bdrk_01VDoZXbUPhSjfzYbLvs6hSm","session_id":"aef800b6-d4f4-4618-888e-2d3ce8d5ce3d","uuid":"dbee442f-9329-4b9c-aee3-eb368de738f7","timestamp":"2026-08-21T12:31:25.119Z","subagent_type":"general-purpose","task_description":"Translate SHA2 backend"}
