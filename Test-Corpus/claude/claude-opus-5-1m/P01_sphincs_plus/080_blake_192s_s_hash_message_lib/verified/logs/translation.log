     }\n        blake256_compress(s, (*s).buf.as_ptr());\n        data = data.add(fill as usize);\n        datalen = datalen.wrapping_sub((fill << 3) as u64);\n        left = 0;\n    }\n\n    while datalen >= 512 {\n        (*s).t[0] = (*s).t[0].wrapping_add(512);\n        if (*s).t[0] == 0 {\n            (*s).t[1] = (*s).t[1].wrapping_add(1);\n        }\n        blake256_compress(s, data);\n        data = data.add(64);\n        datalen -= 512;\n    }\n\n    if datalen > 0 {\n        core::ptr::copy_nonoverlapping(\n            data,\n            (*s).buf.as_mut_ptr().add(left as usize),\n            (datalen >> 3) as usize,\n        );\n        (*s).buflen = ((left << 3) as u64).wrapping_add(datalen) as i32;\n    } else {\n        (*s).buflen = 0;\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn blake256_final(s: *mut blakestate256, digest: *mut u8) {\n    let mut msglen = [0u8; 8];\n    let zo: u8 = 0x01;\n    let oo: u8 = 0x81;\n    let lo: u32 = (*s).t[0].wrapping_add((*s).buflen as u32);\n    let mut hi: u32 = (*s).t[1];\n    if lo < (*s).buflen as u32 {\n        hi = hi.wrapping_add(1);\n    }\n    u32to8(msglen.as_mut_ptr().add(0), hi);\n    u32to8(msglen.as_mut_ptr().add(4), lo);\n\n    if (*s).buflen == 440 {\n        /* one padding byte */\n        (*s).t[0] = (*s).t[0].wrapping_sub(8);\n        blake256_update(s, &oo as *const u8, 8);\n    } else {\n        if (*s).buflen < 440 {\n            /* enough space to fill the block  */\n            if (*s).buflen == 0 {\n                (*s).nullt = 1;\n            }\n            (*s).t[0] = (*s).t[0].wrapping_sub((440 - (*s).buflen) as u32);\n            blake256_update(s, PADDING.as_ptr(), (440 - (*s).buflen) as u64);\n        } else {\n            /* need 2 compressions */\n            (*s).t[0] = (*s).t[0].wrapping_sub((512 - (*s).buflen) as u32);\n            blake256_update(s, PADDING.as_ptr(), (512 - (*s).buflen) as u64);\n            (*s).t[0] = (*s).t[0].wrapping_sub(440);\n            blake256_update(s, PADDING.as_ptr().add(1), 440);\n            (*s).nullt = 1;\n        }\n        blake256_update(s, &zo as *const u8, 8);\n        (*s).t[0] = (*s).t[0].wrapping_sub(8);\n    }\n    (*s).t[0] = (*s).t[0].wrapping_sub(64);\n    blake256_update(s, msglen.as_ptr(), 64);\n\n    u32to8(digest.add(0), (*s).h[0]);\n    u32to8(digest.add(4), (*s).h[1]);\n    u32to8(digest.add(8), (*s).h[2]);\n    u32to8(digest.add(12), (*s).h[3]);\n    u32to8(digest.add(16), (*s).h[4]);\n    u32to8(digest.add(20), (*s).h[5]);\n    u32to8(digest.add(24), (*s).h[6]);\n    u32to8(digest.add(28), (*s).h[7]);\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn SPX_blake256_mgf1(\n    out: *mut u8,\n    outlen: c_ulong,\n    in_: *const u8,\n    inlen: c_ulong,\n) {\n    let mut inbuf = vec![0u8; inlen as usize + 4];\n    let mut outbuf = [0u8; SPX_BLAKE256_OUTPUT_BYTES];\n    let mut i: c_ulong;\n    let mut out = out;\n\n    core::ptr::copy_nonoverlapping(in_, inbuf.as_mut_ptr(), inlen as usize);\n\n    /* While we can fit in at least another full block of BLAKE256 output.. */\n    i = 0;\n    while (i + 1) * SPX_BLAKE256_OUTPUT_BYTES as c_ulong <= outlen {\n        SPX_u32_to_bytes(inbuf.as_mut_ptr().add(inlen as usize), i as u32);\n        blake256(out, inbuf.as_ptr(), inlen as u64 + 4);\n        out = out.add(SPX_BLAKE256_OUTPUT_BYTES);\n        i += 1;\n    }\n    /* Until we cannot anymore, and we fill the remainder. */\n    if outlen > i * SPX_BLAKE256_OUTPUT_BYTES as c_ulong {\n        SPX_u32_to_bytes(inbuf.as_mut_ptr().add(inlen as usize), i as u32);\n        blake256(outbuf.as_mut_ptr(), inbuf.as_ptr(), inlen as u64 + 4);\n        core::ptr::copy_nonoverlapping(\n            outbuf.as_ptr(),\n            out,\n            (outlen - i * SPX_BLAKE256_OUTPUT_BYTES as c_ulong) as usize,\n        );\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn blake256(out: *mut u8, in_: *const u8, inlen: u64) -> i32 {\n    let mut s = blakestate256::new_zeroed();\n    bl