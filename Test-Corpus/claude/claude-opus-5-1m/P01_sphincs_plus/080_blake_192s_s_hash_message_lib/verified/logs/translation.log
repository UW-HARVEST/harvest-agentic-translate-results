tore_bigendian_64(statebytes + 32,state[4]);\n497\t  store_bigendian_64(statebytes + 40,state[5]);\n498\t  store_bigendian_64(statebytes + 48,state[6]);\n499\t  store_bigendian_64(statebytes + 56,state[7]);\n500\t\n501\t  return inlen;\n502\t}\n503\t\n504\t\n505\tstatic const uint8_t iv_256[32] = {\n506\t    0x6a, 0x09, 0xe6, 0x67, 0xbb, 0x67, 0xae, 0x85,\n507\t    0x3c, 0x6e, 0xf3, 0x72, 0xa5, 0x4f, 0xf5, 0x3a,\n508\t    0x51, 0x0e, 0x52, 0x7f, 0x9b, 0x05, 0x68, 0x8c,\n509\t    0x1f, 0x83, 0xd9, 0xab, 0x5b, 0xe0, 0xcd, 0x19\n510\t};\n511\t\n512\tstatic const uint8_t iv_512[64] = {\n513\t    0x6a, 0x09, 0xe6, 0x67, 0xf3, 0xbc, 0xc9, 0x08, 0xbb, 0x67, 0xae,\n514\t    0x85, 0x84, 0xca, 0xa7, 0x3b, 0x3c, 0x6e, 0xf3, 0x72, 0xfe, 0x94,\n515\t    0xf8, 0x2b, 0xa5, 0x4f, 0xf5, 0x3a, 0x5f, 0x1d, 0x36, 0xf1, 0x51,\n516\t    0x0e, 0x52, 0x7f, 0xad, 0xe6, 0x82, 0xd1, 0x9b, 0x05, 0x68, 0x8c,\n517\t    0x2b, 0x3e, 0x6c, 0x1f, 0x1f, 0x83, 0xd9, 0xab, 0xfb, 0x41, 0xbd,\n518\t    0x6b, 0x5b, 0xe0, 0xcd, 0x19, 0x13, 0x7e, 0x21, 0x79\n519\t};\n520\t\n521\tvoid sha256_inc_init(uint8_t *state) {\n522\t    for (size_t i = 0; i < 32; ++i) {\n523\t        state[i] = iv_256[i];\n524\t    }\n525\t    for (size_t i = 32; i < 40; ++i) {\n526\t        state[i] = 0;\n527\t    }\n528\t}\n529\t\n530\tvoid sha512_inc_init(uint8_t *state) {\n531\t    for (size_t i = 0; i < 64; ++i) {\n532\t        state[i] = iv_512[i];\n533\t    }\n534\t    for (size_t i = 64; i < 72; ++i) {\n535\t        state[i] = 0;\n536\t    }\n537\t}\n538\t\n539\tvoid sha256_inc_blocks(uint8_t *state, const uint8_t *in, size_t inblocks) {\n540\t    uint64_t bytes = load_bigendian_64(state + 32);\n541\t\n542\t    crypto_hashblocks_sha256(state, in, 64 * inblocks);\n543\t    bytes += 64 * inblocks;\n544\t\n545\t    store_bigendian_64(state + 32, bytes);\n546\t}\n547\t\n548\tvoid sha512_inc_blocks(uint8_t *state, const uint8_t *in, size_t inblocks) {\n549\t    uint64_t bytes = load_bigendian_64(state + 64);\n550\t\n551\t    crypto_hashblocks_sha512(state, in, 128 * inblocks);\n552\t    bytes += 128 * inblocks;\n553\t\n554\t    store_bigendian_64(state + 64, bytes);\n555\t}\n556\t\n557\tvoid sha256_inc_finalize(uint8_t *out, uint8_t *state, const uint8_t *in, size_t inlen) {\n558\t    uint8_t padded[128];\n559\t    uint64_t bytes = load_bigendian_64(state + 32) + inlen;\n560\t\n561\t    crypto_hashblocks_sha256(state, in, inlen);\n562\t    in += inlen;\n563\t    inlen &= 63;\n564\t    in -= inlen;\n565\t\n566\t    for (size_t i = 0; i < inlen; ++i) {\n567\t        padded[i] = in[i];\n568\t    }\n569\t    padded[inlen] = 0x80;\n570\t\n571\t    if (inlen < 56) {\n572\t        for (size_t i = inlen + 1; i < 56; ++i) {\n573\t            padded[i] = 0;\n574\t        }\n575\t        padded[56] = (uint8_t) (bytes >> 53);\n576\t        padded[57] = (uint8_t) (bytes >> 45);\n577\t        padded[58] = (uint8_t) (bytes >> 37);\n578\t        padded[59] = (uint8_t) (bytes >> 29);\n579\t        padded[60] = (uint8_t) (bytes >> 21);\n580\t        padded[61] = (uint8_t) (bytes >> 13);\n581\t        padded[62] = (uint8_t) (bytes >> 5);\n582\t        padded[63] = (uint8_t) (bytes << 3);\n583\t        crypto_hashblocks_sha256(state, padded, 64);\n584\t    } else {\n585\t        for (size_t i = inlen + 1; i < 120; ++i) {\n586\t            padded[i] = 0;\n587\t        }\n588\t        padded[120] = (uint8_t) (bytes >> 53);\n589\t        padded[121] = (uint8_t) (bytes >> 45);\n590\t        padded[122] = (uint8_t) (bytes >> 37);\n591\t        padded[123] = (uint8_t) (bytes >> 29);\n592\t        padded[124] = (uint8_t) (bytes >> 21);\n593\t        padded[125] = (uint8_t) (bytes >> 13);\n594\t        padded[126] = (uint8_t) (bytes >> 5);\n595\t        padded[127] = (uint8_t) (bytes << 3);\n596\t        crypto_hashblocks_sha256(state, padded, 128);\n597\t    }\n598\t\n599\t    for (size_t i = 0; i < 32; ++i) {\n600\t        out[i] = state[i];\n601\t    }\n602\t\n603\t}\n604\t\n605\tvoid sha512_inc_finalize(uint8_t *out, uint8_t *state, const uint8_t *in, size_t inlen) {\n606\t    uint8_t padded[256];\n607\t    uint64_t bytes = load_bigendian_64(state + 64) + inlen;\n608\t\n609\t    crypto_hashblocks_sha512(state, in, inlen);\n610\t    in += inlen;\n611\t    inlen &= 127;\n612\t    in -= inlen;\n613\t\n614\t    for (size_t i = 0; i < inlen; ++i) {\n615\t        padded[i] = in[i];\n616\t    }\n617\t    padded[inlen] = 0x80;\n618\t\n619\t    if (inlen < 112) {\n620\t        for (size_t i = inlen + 1; i < 119; ++i) {\n621\t            padded[i] = 0;\n622\t        }\n623\t        padded[119] = (uint8_t) (bytes >> 61);\n624\t        padded[120] = (uint8_t) (bytes >> 53);\n625\t        padded[121] = (uint8_t) (bytes >> 45);\n626\t        padded[122] = (uint8_t) (bytes >> 37);\n627\t        padded[123] = (uint8_t) (bytes >> 29);\n628\t        padded[124] = (uint8_t) (bytes >> 21);\n629\t        padded[125] = (uint8_t) (bytes >> 13);\n630\t        padded[126] = (uint8_t) (bytes >> 5);\n631\t        padded[127] = (uint8_t) (bytes << 3);\n632\t        crypto_hashblocks_sha512(state, padded, 128);\n633\t    } else {\n634\t        for (size_t i = inlen + 1; i < 247; ++i) {\n635\t            padded[i] = 0;\n636\t        }\n637\t        padded[247] = (uint8_t) (bytes >> 61);\n638\t        padded[248] = (uint8_t) (bytes >> 53);\n639\t        padded[249] = (uint8_t) (bytes >> 45);\n640\t        padded[250] = (uint8_t) (bytes >> 37);\n641\t        padded[251] = (uint8_t) (bytes >> 29);\n642\t        padded[252] = (uint8_t) (bytes >> 21);\n643\t        padded[253] = (uint8_t) (bytes >> 13);\n644\t        padded[254] = (uint8_t) (bytes >> 5);\n645\t        padded[255] = (uint8_t) (bytes << 3);\n646\t        crypto_hashblocks_sha512(state, padded, 256);\n647\t    }\n648\t\n649\t    for (size_t i = 0; i < 64; ++i) {\n650\t        out[i] = state[i];\n651\t    }\n652\t}\n653\t\n654\tvoid sha256(uint8_t *out, const uint8_t *in, size_t inlen) {\n655\t    uint8_t state[40];\n656\t\n657\t    sha256_inc_init(state);\n658\t    sha256_inc_finalize(out, state, in, inlen);\n659\t}\n660\t\n661\tvoid sha512(uint8_t *out, const uint8_t *in, size_t inlen) {\n662\t    uint8_t state[72];\n663\t\n664\t    sha512_inc_init(state);\n665\t    sha512_inc_finalize(out, state, in, inlen);\n666\t}\n667\t\n668\t/**\n669\t * mgf1 function based on the SHA-256 hash function\n670\t * Note that inlen should be sufficiently small that it still allows for\n671\t * an array to be allocated on the stack. Typically 'in' is merely a seed.\n672\t * Outputs outlen number of bytes\n673\t */\n674\tvoid mgf1_256(unsigned char *out, unsigned long outlen,\n675\t          const unsigned char *in, unsigned long inlen)\n676\t{\n677\t    SPX_VLA(uint8_t, inbuf, inlen+4);\n678\t    unsigned char outbuf[SPX_SHA256_OUTPUT_BYTES];\n679\t    unsigned long i;\n680\t\n681\t    memcpy(inbuf, in, inlen);\n682\t\n683\t    /* While we can fit in at least another full block of SHA256 output.. */\n684\t    for (i = 0; (i+1)*SPX_SHA256_OUTPUT_BYTES <= outlen; i++) {\n685\t        u32_to_bytes(inbuf + inlen, i);\n686\t        sha256(out, inbuf, inlen + 4);\n687\t        out += SPX_SHA256_OUTPUT_BYTES;\n688\t    }\n689\t    /* Until we cannot anymore, and we fill the remainder. */\n690\t    if (outlen > i*SPX_SHA256_OUTPUT_BYTES) {\n691\t        u32_to_bytes(inbuf + inlen, i);\n692\t        sha256(outbuf, inbuf, inlen + 4);\n693\t        memcpy(out, outbuf, outlen - i*SPX_SHA256_OUTPUT_BYTES);\n694\t    }\n695\t}\n696\t\n697\t/*\n698\t * mgf1 function based on the SHA-512 hash function\n699\t */\n700\tvoid mgf1_512(unsigned char *out, unsigned long outlen,\n701\t          const unsigned char *in, unsigned long inlen)\n702\t{\n703\t    SPX_VLA(uint8_t, inbuf, inlen+4);\n704\t    unsigned char outbuf[SPX_SHA512_OUTPUT_BYTES];\n705\t    unsigned long i;\n706\t\n707\t    memcpy(inbuf, in, inlen);\n708\t\n709\t    /* While we can fit in at least another full block of SHA512 output.. */\n710\t    for (i = 0; (i+1)*SPX_SHA512_OUTPUT_BYTES <= outlen; i++) {\n711\t        u32_to_bytes(inbuf + inlen, i);\n712\t        sha512(out, inbuf, inlen + 4);\n713\t        out += SPX_SHA512_OUTPUT_BYTES;\n714\t    }\n715\t    /* Until we cannot anymore, and we fill the remainder. */\n716\t    if (outlen > i*SPX_SHA512_OUTPUT_BYTES) {\n717\t        u32_to_bytes(inbuf + inlen, i);\n718\t        sha512(outbuf, inbuf, inlen + 4);\n719\t        memcpy(out, outbuf, outlen - i*SPX_SHA512_OUTPUT_BYTES);\n720\t    }\n721\t}\n722\t\n723\t\n724\t/**\n725\t * Absorb the constant pub_seed using one round of the compression function\n726\t * This initializes state_seeded and state_seeded_512, which can then be\n727\t * reused in thash\n728\t **/\n729\tvoid seed_state(spx_ctx *ctx) {\n730\t    uint8_t block[SPX_SHA512_BLOCK_BYTES];\n731\t    size_t i;\n732\t\n733\t    for (i = 0; i < SPX_N; ++i) {\n734\t        block[i] = ctx->pub_seed[i];\n735\t    }\n736\t    for (i = SPX_N; i < SPX_SHA512_BLOCK_BYTES; ++i) {\n737\t        block[i] = 0;\n738\t    }\n739\t    /* block has been properly initialized for both SHA-256 and SHA-512 */\n740\t\n741\t    sha256_inc_init(ctx->state_seeded);\n742\t    sha256_inc_blocks(ctx->state_seeded, block, 1);\n743\t#if SPX_SHA512\n744\t    sha512_inc_init(ctx->state_seeded_512);\n745\t    sha512_inc_blocks(ctx->state_seeded_512, block, 1);\n746\t#endif\n747\t}\n748\t===== lib/sha2/src/hash_sha2.c =====\n749\t#include <stdint.h>\n750\t#include <string.h>\n751\t\n752\t#include \"../../../app/include/address.h\"\n753\t#include \"../../../app/include/hash.h\"\n754\t#include \"../../../app/include/params.h\"\n755\t#include \"../../../app/include/utils.h\"\n756\t\n757\t#include \"../include/sha2.h\"\n758\t\n759\t#if SPX_N >= 24\n760\t#define SPX_SHAX_OUTPUT_BYTES SPX_SHA512_OUTPUT_BYTES\n761\t#define SPX_SHAX_BLOCK_BYTES SPX_SHA512_BLOCK_BYTES\n762\t#define shaX_inc_init sha512_inc_init\n763\t#define shaX_inc_blocks sha512_inc_blocks\n764\t#define shaX_inc_finalize sha512_inc_finalize\n765\t#define shaX sha512\n766\t#define mgf1_X mgf1_512\n767\t#else\n768\t#define SPX_SHAX_OUTPUT_BYTES SPX_SHA256_OUTPUT_BYTES\n769\t#define SPX_SHAX_BLOCK_BYTES SPX_SHA256_BLOCK_BYTES\n770\t#define shaX_inc_init sha256_inc_init\n771\t#define shaX_inc_blocks sha256_inc_blocks\n772\t#define shaX_inc_finalize sha256_inc_finalize\n773\t#define shaX sha256\n774\t#define mgf1_X mgf1_256\n775\t#endif\n776\t\n777\t\n778\t/* For SHA, there is no immediate reason to initialize at the start,\n779\t   so this function is an empty operation. */\n780\tvoid initialize_hash_function(spx_ctx *ctx)\n781\t{\n782\t    seed_state(ctx);\n783\t}\n784\t\n785\t/*\n786\t * Computes PRF(pk_seed, sk_seed, addr).\n787\t */\n788\tvoid prf_addr(unsigned char *out, const spx_ctx *ctx,\n789\t              const uint32_t addr[8])\n790\t{\n791\t    uint8_t sha2_state[40];\n792\t    unsigned char buf[SPX_SHA256_ADDR_BYTES + SPX_N];\n793\t    unsigned char outbuf[SPX_SHA256_OUTPUT_BYTES];\n794\t\n795\t    /* Retrieve precomputed state containing pub_seed */\n796\t    memcpy(sha2_state, ctx->state_seeded, 40 * sizeof(uint8_t));\n797\t\n798\t    /* Remainder: ADDR^c ‖ SK.seed */\n799\t    memcpy(buf, addr, SPX_SHA256_ADDR_BYTES);\n800\t    memcpy(buf + SPX_SHA256_ADDR_BYTES, ctx->sk_seed, SPX_N);\n801\t\n802\t    sha256_inc_finalize(outbuf, sha2_state, buf, SPX_SHA256_ADDR_BYTES + SPX_N);\n803\t\n804\t    memcpy(out, outbuf, SPX_N);\n805\t}\n806\t\n807\t/**\n808\t * Computes the message-dependent randomness R, using a secret seed as a key\n809\t * for HMAC, and an optional randomization value prefixed to the message.\n810\t * This requires m to have at least SPX_SHAX_BLOCK_BYTES + SPX_N space\n811\t * available in front of the pointer, i.e. before the message to use for the\n812\t * prefix. This is necessary to prevent having to move the message around (and\n813\t * allocate memory for it).\n814\t */\n815\tvoid gen_message_random(unsigned char *R, const unsigned char *sk_prf,\n816\t                        const unsigned char *optrand,\n817\t                        const unsigned char *m, unsigned long long mlen,\n818\t                        const spx_ctx *ctx)\n819\t{\n820\t    (void)ctx;\n821\t\n822\t    unsigned char buf[SPX_SHAX_BLOCK_BYTES + SPX_SHAX_OUTPUT_BYTES];\n823\t    uint8_t state[8 + SPX_SHAX_OUTPUT_BYTES];\n824\t    int i;\n825\t\n826\t#if SPX_N > SPX_SHAX_BLOCK_BYTES\n827\t    #error \"Currently only supports SPX_N of at most SPX_SHAX_BLOCK_BYTES\"\n828\t#endif\n829\t\n830\t    /* This implements HMAC-SHA */\n831\t    for (i = 0; i < SPX_N; i++) {\n832\t        buf[i] = 0x36 ^ sk_prf[i];\n833\t    }\n834\t    memset(buf + SPX_N, 0x36, SPX_SHAX_BLOCK_BYTES - SPX_N);\n835\t\n836\t    shaX_inc_init(state);\n837\t    shaX_inc_blocks(state, buf, 1);\n838\t\n839\t    memcpy(buf, optrand, SPX_N);\n840\t\n841\t    /* If optrand + message cannot fill up an entire block */\n842\t    if (SPX_N + mlen < SPX_SHAX_BLOCK_BYTES) {\n843\t        memcpy(buf + SPX_N, m, mlen);\n844\t        shaX_inc_finalize(buf + SPX_SHAX_BLOCK_BYTES, state,\n845\t                            buf, mlen + SPX_N);\n846\t    }\n847\t    /* Otherwise first fill a block, so that finalize only uses the message */\n848\t    else {\n849\t        memcpy(buf + SPX_N, m, SPX_SHAX_BLOCK_BYTES - SPX_N);\n850\t        shaX_inc_blocks(state, buf, 1);\n851\t\n852\t        m += SPX_SHAX_BLOCK_BYTES - SPX_N;\n853\t        mlen -= SPX_SHAX_BLOCK_BYTES - SPX_N;\n854\t        shaX_inc_finalize(buf + SPX_SHAX_BLOCK_BYTES, state, m, mlen);\n855\t    }\n856\t\n857\t    for (i = 0; i < SPX_N; i++) {\n858\t        buf[i] = 0x5c ^ sk_prf[i];\n859\t    }\n860\t    memset(buf + SPX_N, 0x5c, SPX_SHAX_BLOCK_BYTES - SPX_N);\n861\t\n862\t    shaX(buf, buf, SPX_SHAX_BLOCK_BYTES + SPX_SHAX_OUTPUT_BYTES);\n863\t    memcpy(R, buf, SPX_N);\n864\t}\n865\t\n866\t/**\n867\t * Computes the message hash using R, the public key, and the message.\n868\t * Outputs the message digest and the index of the leaf. The index is split in\n869\t * the tree index and the leaf index, for convenient copying to an address.\n870\t */\n871\tvoid hash_message(unsigned char *digest, uint64_t *tree, uint32_t *leaf_idx,\n872\t                  const unsigned char *R, const unsigned char *pk,\n873\t                  const unsigned char *m, unsigned long long mlen,\n874\t                  const spx_ctx *ctx)\n875\t{\n876\t    (void)ctx;\n877\t#define SPX_TREE_BITS (SPX_TREE_HEIGHT * (SPX_D - 1))\n878\t#define SPX_TREE_BYTES ((SPX_TREE_BITS + 7) / 8)\n879\t#define SPX_LEAF_BITS SPX_TREE_HEIGHT\n880\t#define SPX_LEAF_BYTES ((SPX_LEAF_BITS + 7) / 8)\n881\t#define SPX_DGST_BYTES (SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES)\n882\t\n883\t    unsigned char seed[2*SPX_N + SPX_SHAX_OUTPUT_BYTES];\n884\t\n885\t    /* Round to nearest multiple of SPX_SHAX_BLOCK_BYTES */\n886\t#if (SPX_SHAX_BLOCK_BYTES & (SPX_SHAX_BLOCK_BYTES-1)) != 0\n887\t    #error \"Assumes that SPX_SHAX_BLOCK_BYTES is a power of 2\"\n888\t#endif\n889\t#define SPX_INBLOCKS (((SPX_N + SPX_PK_BYTES + SPX_SHAX_BLOCK_BYTES - 1) & \\\n890\t                        -SPX_SHAX_BLOCK_BYTES) / SPX_SHAX_BLOCK_BYTES)\n891\t    unsigned char inbuf[SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES];\n892\t\n893\t    unsigned char buf[SPX_DGST_BYTES];\n894\t    unsigned char *bufp = buf;\n895\t    uint8_t state[8 + SPX_SHAX_OUTPUT_BYTES];\n896\t\n897\t    shaX_inc_init(state);\n898\t\n899\t    // seed: SHA-X(R ‖ PK.seed ‖ PK.root ‖ M)\n900\t    memcpy(inbuf, R, SPX_N);\n901\t    memcpy(inbuf + SPX_N, pk, SPX_PK_BYTES);\n902\t\n903\t    /* If R + pk + message cannot fill up an entire block */\n904\t    if (SPX_N + SPX_PK_BYTES + mlen < SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES) {\n905\t        memcpy(inbuf + SPX_N + SPX_PK_BYTES, m, mlen);\n906\t        shaX_inc_finalize(seed + 2*SPX_N, state, inbuf, SPX_N + SPX_PK_BYTES + mlen);\n907\t    }\n908\t    /* Otherwise first fill a block, so that finalize only uses the message */\n909\t    else {\n910\t        memcpy(inbuf + SPX_N + SPX_PK_BYTES, m,\n911\t               SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES - SPX_N - SPX_PK_BYTES);\n912\t        shaX_inc_blocks(state, inbuf, SPX_INBLOCKS);\n913\t\n914\t        m += SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES - SPX_N - SPX_PK_BYTES;\n915\t        mlen -= SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES - SPX_N - SPX_PK_BYTES;\n916\t        shaX_inc_finalize(seed + 2*SPX_N, state, m, mlen);\n917\t    }\n918\t\n919\t    // H_msg: MGF1-SHA-X(R ‖ PK.seed ‖ seed)\n920\t    memcpy(seed, R, SPX_N);\n921\t    memcpy(seed + SPX_N, pk, SPX_N);\n922\t\n923\t    /* By doing this in two steps, we prevent hashing the message twice;\n924\t       otherwise each iteration in MGF1 would hash the message again. */\n925\t    mgf1_X(bufp, SPX_DGST_BYTES, seed, 2*SPX_N + SPX_SHAX_OUTPUT_BYTES);\n926\t\n927\t    memcpy(digest, bufp, SPX_FORS_MSG_BYTES);\n928\t    bufp += SPX_FORS_MSG_BYTES;\n929\t\n930\t#if SPX_TREE_BITS > 64\n931\t    #error For given height and depth, 64 bits cannot represent all subtrees\n932\t#endif\n933\t\n934\t    if (SPX_D == 1) {\n935\t\t*tree = 0;\n936\t    } else {\n937\t        *tree = bytes_to_ull(bufp, SPX_TREE_BYTES);\n938\t        *tree &= (~(uint64_t)0) >> (64 - SPX_TREE_BITS);\n939\t    }\n940\t    bufp += SPX_TREE_BYTES;\n941\t\n942\t    *leaf_idx = (uint32_t)bytes_to_ull(bufp, SPX_LEAF_BYTES);\n943\t    *leaf_idx &= (~(uint32_t)0) >> (32 - SPX_LEAF_BITS);\n944\t}\n945\t\n946\t\n947\t===== lib/sha2/src/thash_sha2_robust.c =====\n948\t#include <stdint.h>\n949\t#include <string.h>\n950\t\n951\t#include \"../../../app/include/address.h\"\n952\t#include \"../../../app/include/thash.h\"\n953\t#include \"../../../app/include/params.h\"\n954\t#include \"../../../app/include/utils.h\"\n955\t\n956\t#include \"../include/sha2.h\"\n957\t\n958\t#if SPX_SHA512\n959\tstatic void thash_512(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n960\t           const spx_ctx *ctx, uint32_t addr[8]);\n961\t#endif\n962\t\n963\t/**\n964\t * Takes an array of inblocks concatenated arrays of SPX_N bytes.\n965\t */\n966\tvoid thash(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n967\t           const spx_ctx *ctx, uint32_t addr[8])\n968\t{\n969\t#if SPX_SHA512\n970\t    if (inblocks > 1) {\n971\t\tthash_512(out, in, inblocks, ctx, addr);\n972\t        return;\n973\t    }\n974\t#endif\n975\t    unsigned char outbuf[SPX_SHA256_OUTPUT_BYTES];\n976\t    SPX_VLA(uint8_t, bitmask, inblocks * SPX_N);\n977\t    SPX_VLA(uint8_t, buf, SPX_N + SPX_SHA256_OUTPUT_BYTES + inblocks*SPX_N);\n978\t    uint8_t sha2_state[40];\n979\t    unsigned int i;\n980\t\n981\t    memcpy(buf, ctx->pub_seed, SPX_N);\n982\t    memcpy(buf + SPX_N, addr, SPX_SHA256_ADDR_BYTES);\n983\t    mgf1_256(bitmask, inblocks * SPX_N, buf, SPX_N + SPX_SHA256_ADDR_BYTES);\n984\t\n985\t    /* Retrieve precomputed state containing pub_seed */\n986\t    memcpy(sha2_state, ctx->state_seeded, 40 * sizeof(uint8_t));\n987\t\n988\t    for (i = 0; i < inblocks * SPX_N; i++) {\n989\t        buf[SPX_N + SPX_SHA256_ADDR_BYTES + i] = in[i] ^ bitmask[i];\n990\t    }\n991\t\n992\t    sha256_inc_finalize(outbuf, sha2_state, buf + SPX_N,\n993\t                        SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);\n994\t    memcpy(out, outbuf, SPX_N);\n995\t}\n996\t\n997\t#if SPX_SHA512\n998\tstatic void thash_512(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n999\t           const spx_ctx *ctx, uint32_t addr[8])\n1000\t{\n1001\t    unsigned char outbuf[SPX_SHA512_OUTPUT_BYTES];\n1002\t    SPX_VLA(uint8_t, bitmask, inblocks * SPX_N);\n1003\t    SPX_VLA(uint8_t, buf, SPX_N + SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);\n1004\t    uint8_t sha2_state[72];\n1005\t    unsigned int i;\n1006\t\n1007\t    memcpy(buf, ctx->pub_seed, SPX_N);\n1008\t    memcpy(buf + SPX_N, addr, SPX_SHA256_ADDR_BYTES);\n1009\t    mgf1_512(bitmask, inblocks * SPX_N, buf, SPX_N + SPX_SHA256_ADDR_BYTES);\n1010\t\n1011\t    /* Retrieve precomputed state containing pub_seed */\n1012\t    memcpy(sha2_state, ctx->state_seeded_512, 72 * sizeof(uint8_t));\n1013\t\n1014\t    for (i = 0; i < inblocks * SPX_N; i++) {\n1015\t        buf[SPX_N + SPX_SHA256_ADDR_BYTES + i] = in[i] ^ bitmask[i];\n1016\t    }\n1017\t\n1018\t    sha512_inc_finalize(outbuf, sha2_state, buf + SPX_N,\n1019\t                        SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);\n1020\t    memcpy(out, outbuf, SPX_N);\n1021\t}\n1022\t#endif\n1023\t===== lib/sha2/src/thash_sha2_simple.c =====\n1024\t#include <stdint.h>\n1025\t#include <string.h>\n1026\t\n1027\t#include \"../../../app/include/address.h\"\n1028\t#include \"../../../app/include/params.h\"\n1029\t#include \"../../../app/include/thash.h\"\n1030\t#include \"../../../app/include/utils.h\"\n1031\t\n1032\t#include \"../include/sha2.h\"\n1033\t\n1034\t#if SPX_SHA512\n1035\tstatic void thash_512(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n1036\t           const spx_ctx *ctx, uint32_t addr[8]);\n1037\t#endif\n1038\t\n1039\t/**\n1040\t * Takes an array of inblocks concatenated arrays of SPX_N bytes.\n1041\t */\n1042\tvoid thash(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n1043\t           const spx_ctx *ctx, uint32_t addr[8])\n1044\t{\n1045\t#if SPX_SHA512\n1046\t    if (inblocks > 1) {\n1047\t\tthash_512(out, in, inblocks, ctx, addr);\n1048\t        return;\n1049\t    }\n1050\t#endif\n1051\t\n1052\t    unsigned char outbuf[SPX_SHA256_OUTPUT_BYTES];\n1053\t    uint8_t sha2_state[40];\n1054\t    SPX_VLA(uint8_t, buf, SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);\n1055\t\n1056\t    /* Retrieve precomputed state containing pub_seed */\n1057\t    memcpy(sha2_state, ctx->state_seeded, 40 * sizeof(uint8_t));\n1058\t\n1059\t    memcpy(buf, addr, SPX_SHA256_ADDR_BYTES);\n1060\t    memcpy(buf + SPX_SHA256_ADDR_BYTES, in, inblocks * SPX_N);\n1061\t\n1062\t    sha256_inc_finalize(outbuf, sha2_state, buf, SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);\n1063\t    memcpy(out, outbuf, SPX_N);\n1064\t}\n1065\t\n1066\t#if SPX_SHA512\n1067\tstatic void thash_512(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n1068\t           const spx_ctx *ctx, uint32_t addr[8])\n1069\t{\n1070\t    unsigned char outbuf[SPX_SHA512_OUTPUT_BYTES];\n1071\t    uint8_t sha2_state[72];\n1072\t    SPX_VLA(uint8_t, buf, SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);\n1073\t\n1074\t    /* Retrieve precomputed state containing pub_seed */\n1075\t    memcpy(sha2_state, ctx->state_seeded_512, 72 * sizeof(uint8_t));\n1076\t\n1077\t    memcpy(buf, addr, SPX_SHA256_ADDR_BYTES);\n1078\t    memcpy(buf + SPX_SHA256_ADDR_BYTES, in, inblocks * SPX_N);\n1079\t\n1080\t    sha512_inc_finalize(outbuf, sha2_state, buf, SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);\n1081\t    memcpy(out, outbuf, SPX_N);\n1082\t}\n1083\t#endif\n1084\t"}]},"parent_tool_use_id":null,"session_id":"aef800b6-d4f4-4618-888e-2d3ce8d5ce3d","uuid":"517bcb64-1604-46a5-8fb9-e6473c544a20","timestamp":"2026-08-21T11:58:58.908Z","tool_use_result":{"type":"text","file":{"filePath":"/home/scheschb/.claude/projects/-local-home-scheschb--harvest-work-harvest-translate-EK0MTq-translated-rust/aef800b6-d4f4-4618-888e-2d3ce8d5ce3d/tool-results/boq7t1ncb.txt","content":"===== lib/sha2/include/sha2.h =====\n#ifndef SPX_SHA2_H\n#define SPX_SHA2_H\n\n#include \"../../../app/include/params.h\"\n#include \"../../../app/include/context.h\"\n\n#define SPX_SHA256_BLOCK_BYTES 64\n#define SPX_SHA256_OUTPUT_BYTES 32  /* This does not necessarily equal SPX_N */\n\n#define SPX_SHA512_BLOCK_BYTES 128\n#define SPX_SHA512_OUTPUT_BYTES 64\n\n#if SPX_SHA256_OUTPUT_BYTES < SPX_N\n    #error Linking against SHA-256 with N larger than 32 bytes is not supported\n#endif\n\n#define SPX_SHA256_ADDR_BYTES 22\n\n#include <stddef.h>\n#include <stdint.h>\n\nvoid sha256_inc_init(uint8_t *state);\nvoid sha256_inc_blocks(uint8_t *state, const uint8_t *in, size_t inblocks);\nvoid sha256_inc_finalize(uint8_t *out, uint8_t *state, const uint8_t *in, size_t inlen);\nvoid sha256(uint8_t *out, const uint8_t *in, size_t inlen);\n\nvoid sha512_inc_init(uint8_t *state);\nvoid sha512_inc_blocks(uint8_t *state, const uint8_t *in, size_t inblocks);\nvoid sha512_inc_finalize(uint8_t *out, uint8_t *state, const uint8_t *in, size_t inlen);\nvoid sha512(uint8_t *out, const uint8_t *in, size_t inlen);\n\n#define mgf1_256 SPX_NAMESPACE(mgf1_256)\nvoid mgf1_256(unsigned char *out, unsigned long outlen,\n          const unsigned char *in, unsigned long inlen);\n\n#define mgf1_512 SPX_NAMESPACE(mgf1_512)\nvoid mgf1_512(unsigned char *out, unsigned long outlen,\n          const unsigned char *in, unsigned long inlen);\n\n#define seed_state SPX_NAMESPACE(seed_state)\nvoid seed_state(spx_ctx *ctx);\n\n\n#endif\n===== lib/sha2/src/sha2.c =====\n/* Based on the public domain implementation in\n * crypto_hash/sha512/ref/ from http://bench.cr.yp.to/supercop.html\n * by D. J. Bernstein */\n\n#include <stddef.h>\n#include <stdint.h>\n#include <string.h>\n\n#include \"../../../app/include/utils.h\"\n\n#include \"../include/sha2.h\"\n\nstatic uint32_t load_bigendian_32(const uint8_t *x) {\n    return (uint32_t)(x[3]) | (((uint32_t)(x[2])) << 8) |\n           (((uint32_t)(x[1])) << 16) | (((uint32_t)(x[0])) << 24);\n}\n\nstatic uint64_t load_bigendian_64(const uint8_t *x) {\n    return (uint64_t)(x[7]) | (((uint64_t)(x[6])) << 8) |\n           (((uint64_t)(x[5])) << 16) | (((uint64_t)(x[4])) << 24) |\n           (((uint64_t)(x[3])) << 32) | (((uint64_t)(x[2])) << 40) |\n           (((uint64_t)(x[1])) << 48) | (((uint64_t)(x[0])) << 56);\n}\n\nstatic void store_bigendian_32(uint8_t *x, uint64_t u) {\n    x[3] = (uint8_t) u;\n    u >>= 8;\n    x[2] = (uint8_t) u;\n    u >>= 8;\n    x[1] = (uint8_t) u;\n    u >>= 8;\n    x[0] = (uint8_t) u;\n}\n\nstatic void store_bigendian_64(uint8_t *x, uint64_t u) {\n    x[7] = (uint8_t) u;\n    u >>= 8;\n    x[6] = (uint8_t) u;\n    u >>= 8;\n    x[5] = (uint8_t) u;\n    u >>= 8;\n    x[4] = (uint8_t) u;\n    u >>= 8;\n    x[3] = (uint8_t) u;\n    u >