{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01X9gak5x8DPnFFec8SRr4w1","type":"tool_result","content":"1\t//! Pure-Rust translation of the SPHINCS+ reference implementation.\n2\t//!\n3\t//! Build-time configurability (CMake cache variables `HASH_BACKEND`, `THASH`,\n4\t//! `SECPAR`) is preserved via Cargo features with the exact same lowercase\n5\t//! names. Exactly one hash backend module is compiled, selected with the\n6\t//! priority `sha2` > `shake` > `blake` > `haraka` (the last also being the\n7\t//! default when no backend feature is enabled), matching the CMake default of\n8\t//! `haraka`.\n9\t\n10\t#![allow(non_upper_case_globals)]\n11\t#![allow(non_camel_case_types)]\n12\t#![allow(non_snake_case)]\n13\t#![allow(clippy::missing_safety_doc)]\n14\t#![allow(clippy::too_many_arguments)]\n15\t#![allow(clippy::needless_range_loop)]\n16\t\n17\tpub mod address;\n18\tpub mod context;\n19\tpub mod fors;\n20\tpub mod merkle;\n21\tpub mod params;\n22\tpub mod randombytes;\n23\tpub mod rng;\n24\tpub mod sign;\n25\tpub mod utils;\n26\tpub mod utilsx1;\n27\tpub mod wots;\n28\tpub mod wotsx1;\n29\t\n30\t// --- Active hash backend (exactly one is compiled) --------------------------\n31\t\n32\t#[cfg(feature = \"sha2\")]\n33\t#[path = \"backends/sha2/mod.rs\"]\n34\tpub mod backend;\n35\t\n36\t#[cfg(all(feature = \"shake\", not(feature = \"sha2\")))]\n37\t#[path = \"backends/shake/mod.rs\"]\n38\tpub mod backend;\n39\t\n40\t#[cfg(all(feature = \"blake\", not(feature = \"sha2\"), not(feature = \"shake\")))]\n41\t#[path = \"backends/blake/mod.rs\"]\n42\tpub mod backend;\n43\t\n44\t#[cfg(all(\n45\t    not(feature = \"sha2\"),\n46\t    not(feature = \"shake\"),\n47\t    not(feature = \"blake\")\n48\t))]\n49\t#[path = \"backends/haraka/mod.rs\"]\n50\tpub mod backend;\n51\t\n52\tpub use context::SpxCtx;\n53\t"}]},"parent_tool_use_id":"toolu_bdrk_01VDoZXbUPhSjfzYbLvs6hSm","session_id":"aef800b6-d4f4-4618-888e-2d3ce8d5ce3d","uuid":"0104e5c5-13d7-470b-bb