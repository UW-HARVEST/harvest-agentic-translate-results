(), seed.len() as u64);\n414\t        }\n415\t\n416\t        tctx.absorb_label(\"count\");\n417\t        tctx.absorb_u64(i as u64);\n418\t        tctx.absorb_label(\"seed\");\n419\t        tctx.absorb_bytes(&seed);\n420\t\n421\t        let mlen = BASE_MLEN * (i + 1);\n422\t        if mlen > total {\n423\t            eprintln!(\"mlen overflow\");\n424\t            std::process::exit((-1i32) as u8 as i32);\n425\t        }\n426\t\n427\t        tctx.absorb_label(\"mlen\");\n428\t        tctx.absorb_u64(mlen as u64);\n429\t\n430\t        unsafe {\n431\t            randombytes(msg.as_mut_ptr(), mlen as u64);\n432\t        }\n433\t        tctx.absorb_label(\"msg\");\n434\t        tctx.absorb_bytes(&msg[..mlen]);\n435\t\n436\t        for b in m[..mlen].iter_mut() {\n437\t            *b = 0;\n438\t        }\n439\t        for b in m1[..mlen + CRYPTO_BYTES].iter_mut() {\n440\t            *b = 0;\n441\t        }\n442\t        for b in sm[..mlen + CRYPTO_BYTES].iter_mut() {\n443\t            *b = 0;\n444\t        }\n445\t        m[..mlen].copy_from_slice(&msg[..mlen]);\n446\t\n447\t        // Keypair\n448\t        let ret = unsafe { crypto_sign_keypair(pk.as_mut_ptr(), sk.as_mut_ptr()) };\n449\t        if ret != 0 {\n450\t            eprintln!(\"crypto_sign_keypair={}\", ret);\n451\t            std::process::exit((-2i32) as u8 as i32);\n452\t        }\n453\t        tctx.absorb_label(\"pk\");\n454\t        tctx.absorb_bytes(&pk);\n455\t        tctx.absorb_label(\"sk\");\n456\t        tctx.absorb_bytes(&sk);\n457\t\n458\t        // Sign\n459\t        let ret = unsafe {\n460\t            crypto_sign(\n461\t                sm.as_mut_ptr(),\n462\t                &mut smlen,\n463\t                m.as_ptr(),\n464\t                mlen as u64,\n465\t                sk.as_ptr(),\n466\t            )\n467\t        };\n468\t        if ret != 0 {\n469\t            eprintln!(\"crypto_sign={}\", ret);\n470\t            std::process::exit((-2i32) as u8 as i32);\n471\t        }\n472\t        tc