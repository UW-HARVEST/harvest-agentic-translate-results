locks,\n52\t           const spx_ctx *ctx, uint32_t addr[8])\n53\t{\n54\t    unsigned char outbuf[SPX_SHA512_OUTPUT_BYTES];\n55\t    SPX_VLA(uint8_t, bitmask, inblocks * SPX_N);\n56\t    SPX_VLA(uint8_t, buf, SPX_N + SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);\n57\t    uint8_t sha2_state[72];\n58\t    unsigned int i;\n59\t\n60\t    memcpy(buf, ctx->pub_seed, SPX_N);\n61\t    memcpy(buf + SPX_N, addr, SPX_SHA256_ADDR_BYTES);\n62\t    mgf1_512(bitmask, inblocks * SPX_N, buf, SPX_N + SPX_SHA256_ADDR_BYTES);\n63\t\n64\t    /* Retrieve precomputed state containing pub_seed */\n65\t    memcpy(sha2_state, ctx->state_seeded_512, 72 * sizeof(uint8_t));\n66\t\n67\t    for (i = 0; i < inblocks * SPX_N; i++) {\n68\t        buf[SPX_N + SPX_SHA256_ADDR_BYTES + i] = in[i] ^ bitmask[i];\n69\t    }\n70\t\n71\t    sha512_inc_finalize(outbuf, sha2_state, buf + SPX_N,\n72\t                        SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);\n73\t    memcpy(out, outbuf, SPX_N);\n74\t}\n75\t#endif\n76\t"}]},"parent_tool_use_id":"toolu_bdrk_01VDoZXbUPhSjfzYbLvs6hSm","session_id":"aef800b6-d4f4-4618-888e-2d3ce8d5ce3d","uuid":"cec509d0-cf7a-4cee-a019-373ffd123db7","timestamp":"2026-08-21T12:31:16.125Z","subagent_type":"general-purpose","task_description":"Translate SHA2 backend"}
