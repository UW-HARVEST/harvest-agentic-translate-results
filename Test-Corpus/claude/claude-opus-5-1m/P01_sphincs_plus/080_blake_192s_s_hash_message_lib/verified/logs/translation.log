                not(feature = \"sha2\"),\n                not(feature = \"shake\"),\n                not(feature = \"blake\")\n            ))]\n            tweaked512_rc64: [[0u64; 8]; 10],\n            #[cfg(all(\n                not(feature = \"sha2\"),\n                not(feature = \"shake\"),\n                not(feature = \"blake\")\n            ))]\n            tweaked256_rc32: [[0u32; 8]; 10],\n        }\n    }\n}\n\nimpl Default for SpxCtx {\n    fn default() -> Self {\n        Self::new()\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3087,"cache_read_input_tokens":237862,"cache_creation":{"ephemeral_5m_input_tokens":3087,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"aef800b6-d4f4-4618-888e-2d3ce8d5ce3d","uuid":"26ff4b7c-f1ab-423e-8975-d45a3c96671e","timestamp":"2026-08-21T12:09:06.091Z"}
