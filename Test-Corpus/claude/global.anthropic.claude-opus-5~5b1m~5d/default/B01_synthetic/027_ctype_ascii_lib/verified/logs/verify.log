{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016jHHBttca6S7MUWEn4m783","type":"tool_result","content":"1\t// Rust translation of the glibc `<ctype.h>` behaviour that the C library relies\n2\t// upon.\n3\t//\n4\t// The original C code in `c_src/src/driver.c` calls the standard `is*()`\n5\t// classification macros and prints their results with `printf(\"%d\")`.  On glibc\n6\t// those macros expand to\n7\t//\n8\t//     #define isalnum(c) __isctype((c), _ISalnum)\n9\t//     #define __isctype(c, type) ((*__ctype_b_loc ())[(int) (c)] & (type))\n10\t//\n11\t// so the value that reaches `printf` is *not* a normalised `0`/`1`; it is the\n12\t// raw bit that glibc stores in its `__ctype_b` table.  Those bits are produced\n13\t// by `_ISbit(n)`:\n14\t//\n15\t//     #define _ISbit(bit) ((bit) < 8 ? ((1 << (bit)) << 8) : ((1 << (bit)) >> 8))\n16\t//\n17\t// The resulting masks are reproduced below verbatim so that the printed numbers\n18\t// are byte-identical to the C library's output.\n19\t#![allow(dead_code)]\n20\t\n21\tuse core::ffi::c_int;\n22\t\n23\tpub const IS_UPPER: c_int = 0x0100; // _ISbit(0)  ->   256\n24\tpub const IS_LOWER: c_int = 0x0200; // _ISbit(1)  ->   512\n25\tpub const IS_ALPHA: c_int = 0x0400; // _ISbit(2)  ->  1024\n26\tpub const IS_DIGIT: c_int = 0x0800; // _ISbit(3)  ->  2048\n27\tpub const IS_XDIGIT: c_int = 0x1000; // _ISbit(4) ->  4096\n28\tpub const IS_SPACE: c_int = 0x2000; // _ISbit(5)  ->  8192\n29\tpub const IS_PRINT: c_int = 0x4000; // _ISbit(6)  -> 16384\n30\tpub const IS_GRAPH: c_int = 0x8000; // _ISbit(7)  -> 32768\n31\tpub const IS_BLANK: c_int = 0x0001; // _ISbit(8)  ->     1\n32\tpub const IS_CNTRL: c_int = 0x0002; // _ISbit(9)  ->     2\n33\tpub const IS_PUNCT: c_int = 0x0004; // _ISbit(10) ->     4\n34\tpub const IS_ALNUM: c_int = 0x0008; // _ISbit(11) ->     8\n35\t\n36\t/// The class bitmap of a single entry of glibc's `__ctype_b` table for the\n37\t/// `\"C\"` locale.\n38\t///\n39\t/// glibc's table is indexed from `-128` to `255`.  In the `\"C\"` locale every\n40\t/// slot below `0` (i.e. the region reachable through a *negative* `char`) is\n41\t/// completely empty, which means all of the `is*()` predicates yield `0` for\n42\t/// negative characters.  Only the 7-bit ASCII range carries classification\n43\t/// bits.\n44\tconst fn class_of(idx: c_int) -> c_int {\n45\t    if idx < 0 || idx > 127 {\n46\t        // Negative `char` values (and, defensively, anything past ASCII) have\n47\t        // an all-zero class entry in the \"C\" locale.\n48\t        return 0;\n49\t    }\n50\t\n51\t    let c = idx as u8;\n52\t    let mut mask: c_int = 0;\n53\t\n54\t    let is_cntrl = c < 32 || c == 127;\n55\t    let is_print = c >= 32 && c <= 126;\n56\t    let is_graph = c >= 33 && c <= 126;\n57\t    let is_space = matches!(c, b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r' | b' ');\n58\t    let is_blank = matches!(c, b'\\t' | b' ');\n59\t    let is_digit = c >= b'0' && c <= b'9';\n60\t    let is_upper = c >= b'A' && c <= b'Z';\n61\t    let is_lower = c >= b'a' && c <= b'z';\n62\t    let is_xdigit = is_digit || (c >= b'A' && c <= b'F') || (c >= b'a' && c <= b'f');\n63\t    let is_alpha = is_upper || is_lower;\n64\t    let is_alnum = is_alpha || is_digit;\n65\t    // In the \"C\" locale punctuation is every printable, non-alphanumeric,\n66\t    // non-space character.\n67\t    let is_punct = is_graph && !is_alnum;\n68\t\n69\t    if is_upper {\n70\t        mask |= IS_UPPER;\n71\t    }\n72\t    if is_lower {\n73\t        mask |= IS_LOWER;\n74\t    }\n75\t    if is_alpha {\n76\t        mask |= IS_ALPHA;\n77\t    }\n78\t    if is_digit {\n79\t        mask |= IS_DIGIT;\n80\t    }\n81\t    if is_xdigit {\n82\t        mask |= IS_XDIGIT;\n83\t    }\n84\t    if is_space {\n85\t        mask |= IS_SPACE;\n86\t    }\n87\t    if is_print {\n88\t        mask |= IS_PRINT;\n89\t    }\n90\t    if is_graph {\n91\t        mask |= IS_GRAPH;\n92\t    }\n93\t    if is_blank {\n94\t        mask |= IS_BLANK;\n95\t    }\n96\t    if is_cntrl {\n97\t        mask |= IS_CNTRL;\n98\t    }\n99\t    if is_punct {\n100\t        mask |= IS_PUNCT;\n101\t    }\n102\t    if is_alnum {\n103\t        mask |= IS_ALNUM;\n104\t    }\n105\t\n106\t    mask\n107\t}\n108\t\n109\t/// `__ctype_b`-equivalent lookup covering the indices `-128 ..= 255`, i.e. every\n110\t/// value a `char` (or an `unsigned char`) can take.\n111\tconst CTYPE_B: [c_int; 384] = {\n112\t    let mut table = [0; 384];\n113\t    let mut i = 0usize;\n114\t    while i < 384 {\n115\t        // Slot 0 corresponds to index -128, slot 128 to index 0.\n116\t        table[i] = class_of(i as c_int - 128);\n117\t        i += 1;\n118\t    }\n119\t    table\n120\t};\n121\t\n122\t#[inline]\n123\tfn class(c: c_int) -> c_int {\n124\t    if c >= -128 && c < 256 {\n125\t        CTYPE_B[(c + 128) as usize]\n126\t    } else {\n127\t        0\n128\t    }\n129\t}\n130\t\n131\t// The twelve classification helpers.  Each one returns the *masked bit*, exactly\n132\t// like glibc's `__isctype` macro does.\n133\t#[inline]\n134\tpub fn isalnum(c: c_int) -> c_int {\n135\t    class(c) & IS_ALNUM\n136\t}\n137\t#[inline]\n138\tpub fn isalpha(c: c_int) -> c_int {\n139\t    class(c) & IS_ALPHA\n140\t}\n141\t#[inline]\n142\tpub fn islower(c: c_int) -> c_int {\n143\t    class(c) & IS_LOWER\n144\t}\n145\t#[inline]\n146\tpub fn isupper(c: c_int) -> c_int {\n147\t    class(c) & IS_UPPER\n148\t}\n149\t#[inline]\n150\tpub fn isdigit(c: c_int) -> c_int {\n151\t    class(c) & IS_DIGIT\n152\t}\n153\t#[inline]\n154\tpub fn isxdigit(c: c_int) -> c_int {\n155\t    class(c) & IS_XDIGIT\n156\t}\n157\t#[inline]\n158\tpub fn iscntrl(c: c_int) -> c_int {\n159\t    class(c) & IS_CNTRL\n160\t}\n161\t#[inline]\n162\tpub fn isgraph(c: c_int) -> c_int {\n163\t    class(c) & IS_GRAPH\n164\t}\n165\t#[inline]\n166\tpub fn isspace(c: c_int) -> c_int {\n167\t    class(c) & IS_SPACE\n168\t}\n169\t#[inline]\n170\tpub fn isblank(c: c_int) -> c_int {\n171\t    class(c) & IS_BLANK\n172\t