4];\n    let mut i = 0usize;\n    while i < 384 {\n        let idx = i as c_int - 128;\n        table[i] = if idx >= b'a' as c_int && idx <= b'z' as c_int {\n            idx - 32\n        } else {\n            idx\n        };\n        i += 1;\n    }\n    table\n};\n\n#[inline]\npub fn tolower(c: c_int) -> c_int {\n    if c >= -128 && c < 256 {\n        CTYPE_TOLOWER[(c + 128) as usize]\n    } else {\n        c\n    }\n}\n\n#[inline]\npub fn toupper(c: c_int) -> c_int {\n    if c >= -128 && c < 256 {\n        CTYPE_TOUPPER[(c + 128) as usize]\n    } else {\n        c\n    }\n}\n","numLines":233,"startLine":1,"totalLines":233}}}
