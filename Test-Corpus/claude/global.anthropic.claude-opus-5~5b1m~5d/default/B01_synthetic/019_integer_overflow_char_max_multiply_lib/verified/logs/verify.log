\\\\\n\\\\\\\\0\\\".as_ptr() as *const c_char, promoted \\\\& 0xff);@\"\n  \"printline-drops-null-guard|s@if !line.is_null() {@if true {@\"\n  \"printline-prints-null-as-text|s@if !line.is_null() {@if line.is_null() { printf(b\\\"(null)\\\\\\\\n\\\\\\\\0\\\".as_ptr() as *const c_char); } else if true {@\"\n  \"goodb2g-honours-dead-store|s@^    data = CHAR_MAX as c_char;\\$@    // dead store honoured (mutant)@\"\n  \"goodb2g-uses-le-instead-of-lt|s@if (data as c_int) < (CHAR_MAX / 2) {@if (data as c_int) <= (CHAR_MAX / 2) {@\"\n  \"goodb2g-wrong-message|s@data value is too large to perform arithmetic safely@data value is too large to perform arithmetic safely.@\"\n  \"bad-saturates-instead-of-wrapping|s@let result: c_char = ((data as c_int) \\\\* 2) as c_char;\\\\n        printHexCharLine(result);@@\"\n  \"good-swaps-submode-order|s@    goodG2B();\\\\n    goodB2G();@    goodB2G();\\\\n    goodG2B();@\"\n)\n\npass=0\nfail=0\nprintf '%-42s %s\\n' \"MUTANT\" \"RESULT\"\nprintf '%-42s %s\\n' \"------------------------------------------\" \"------\"\n\nfor entry in \"${MUTANTS[@]}\"; do\n  name=\"${entry%%|*}\"\n  expr=\"${entry#*|}\"\n  cp \"$BACKUP\" \"$LIB\"\n  if ! perl -0777 -pe \"$expr\" -i \"$LIB\" 2>/dev/null; then\n    printf '%-42s %s\\n' \"$name\" \"SKIP (sed failed)\"\n    continue\n  fi\n  if cmp -s \"$BACKUP\" \"$LIB\"; then\n    printf '%-42s %s\\n' \"$name\" \"SKIP (no textual change)\"\n    continue\n  fi\n  if ! cargo build $CARGO_FLAGS >/dev/null 2>&1; then\n    printf '%-42s %s\\n' \"$name\" \"SKIP (mutant does not compile)\"\n    continue\n  fi\n  if cargo test $CARGO_FLAGS $TEST_FLAGS >/dev/null 2>&1; then\n    printf '%-42s %s\\n' \"$name\" \"*** NOT CAUGHT ***\"\n    fail=$((fail + 1))\n  else\n    printf '%-42s %s\\n' \"$name\" \"caught\"\n    pass=$((pass + 1))\n  fi\ndone\n\nrestore\ntrap - EXIT INT TERM\ncargo build $CARGO_FLAGS >/dev/null 2>&1\n\necho\necho \"caught: $pass    not caught: $fail\"\n[ \"$fail\" -eq 0 ]\n","userModified":false}}
