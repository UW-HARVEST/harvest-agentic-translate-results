rogram run first, then C) + repeated twice, to prove no cross-library / cross-call state | [x] |\n| C27 | all 5 | all rows above under feature set **default** (== none == all; `Cargo.toml` has no `[features]`), via `scripts/check_features.sh` | [x] |\n\nAll 27 rows pass. See `tests/differential.rs`.\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3074,"cache_read_input_tokens":29258,"cache_creation":{"ephemeral_5m_input_tokens":3074,"ephemeral_1h_input_tokens":0},"output_tokens":14,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"7f3fbfad-5cb7-48b0-a72c-fba62a0979d0","uuid":"3f2b10ce-693b-4f73-a0be-f45360098cbc","timestamp":"2026-08-28T13:20:10.543Z"}
