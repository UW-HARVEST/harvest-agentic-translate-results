{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_xhouyym5vp7zpbqjh5vtlypcrjndsxvwqri4hgmvtp27lliq7kpq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01TYfTqRcAgNidufpsRDUHQa","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-XV6Atq/translation/tests/phase_b_configs.rs","content":"//! Phase B — valid-path differential tests, one test per CONFIGS.md row.\n//!\n//! Every test drives BOTH shared objects through their exported C symbols\n//! (never the Rust crate directly) and compares results byte-for-byte, using\n//! many randomized inputs per row with a fixed seed.\n\nmod common;\n\nuse common::*;\nuse std::ffi::c_int;\n\n/// How many randomized inputs each row gets.\nconst ITERS: usize = 200;\n\n// ===========================================================================\n// Rows 1-5: `fma_array`, all pointers distinct, varying `len`\n// ===========================================================================\n\n#[test]\nfn row01_fma_len0_distinct_leaves_out_untouched() {\n    let mut rng = Rng::new(0x0000_0001);\n    for _ in 0..ITERS {\n        let a = gen(&mut rng, ValueClass::FullRandom, 8);\n        let b = gen(&mut rng, ValueClass::FullRandom, 8);\n        let c = gen(&mut rng, ValueClass::FullRandom, 8);\n        let o = gen(&mut rng, ValueClass::FullRandom, 8);\n        diff_fma(\"row01\", Alias::AllDistinct, 0, &a, &b, &c, &o);\n\n        // And confirm the shared semantics: nothing was written.\n        let l = libs();\n        let res = call_fma(&l.c, Alias::AllDistinct, 0, &a, &b, &c, &o);\n        assert_eq!(&res.buffers[0][..8], &o[..8], \"len=0 must not write to out\");\n    }\n}\n\n#[test]\nfn row02_fma_len1_distinct_random() {\n    let mut rng = Rng::new(0x0000_0002);\n    for _ in 0..ITERS {\n        let a = gen(&mut rng, ValueClass::FullRandom, 2);\n        let b = gen(&mut rng, ValueClass::FullRandom, 2);\n        let c = gen(&mut rng, ValueClass::FullRandom, 2);\n        let o = gen(&mut rng, ValueClass::FullRandom, 2);\n        diff_fma(\"row02\", Alias::AllDistinct, 1, &a, &b, &c, &o);\n    }\n}\n\n#[test]\nfn row03_fma_len2_distinct_random() {\n    let mut rng = Rng::new(0x0000_0003);\n    for _ in 0..ITERS {\n        let a = gen(&mut rng, ValueClass::FullRandom, 3);\n        let b = gen(&mut rng, ValueClass::FullRandom, 3);\n        let c = gen(&mut rng, ValueClass::FullRandom, 3);\n        let o = gen(&mut rng, ValueClass::FullRandom, 3);\n        diff_fma(\"row03\", Alias::AllDistinct, 2, &a, &b, &c, &o);\n    }\n}\n\n#[test]\nfn row04_fma_len_small_distinct_random() {\n    let mut rng = Rng::new(0x0000_0004);\n    for _ in 0..ITERS {\n        let n = rng.range_usize(2, 8);\n        let a = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let b = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let c = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let o = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        diff_fma(\"row04\", Alias::AllDistinct, n as c_int, &a, &b, &c, &o);\n    }\n}\n\n#[test]\nfn row05_fma_len_many_distinct_random() {\n    let mut rng = Rng::new(0x0000_0005);\n    for _ in 0..ITERS {\n        let n = rng.range_usize(64, 1024);\n        let a = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let b = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let c = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let o = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        diff_fma(\"row05\", Alias::AllDistinct, n as c_int, &a, &b, &c, &o);\n    }\n}\n\n// ===========================================================================\n// Rows 6-12: `fma_array`, len many, each value class (incl. both overflow kinds)\n// ===========================================================================\n\nfn fma_value_class_row(row: &str, seed: u64, class: ValueClass) {\n    let mut rng = Rng::new(seed);\n    for _ in 0..ITERS {\n        let n = rng.range_usize(64, 512);\n        let a = gen(&mut rng, class, n + 1);\n        let b = gen(&mut rng, class, n + 1);\n        let c = gen(&mut rng, class, n + 1);\n        let o = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        diff_fma(row, Alias::AllDistinct, n as c_int, &a, &b, &c, &o);\n    }\n}\n\n#[test]\nfn row06_fma_all_zeros() {\n    fma_value_class_row(\"row06\", 0x0000_0006, ValueClass::Zeros);\n}\n\n#[test]\nfn row07_fma_small_positive() {\n    fma_value_class_row(\"row07\", 0x0000_0007, ValueClass::SmallPos);\n}\n\n#[test]\nfn row08_fma_small_negative() {\n    fma_value_class_row(\"row08\", 0x0000_0008, ValueClass::SmallNeg);\n}\n\n#[test]\nfn row09_fma_mixed_sign_small() {\n    fma_value_class_row(\"row09\", 0x0000_0009, ValueClass::MixedSmall);\n}\n\n#[test]\nfn row10_fma_boundary_values_mul_and_add_wrap() {\n    fma_value_class_row(\"row10\", 0x0000_000A, ValueClass::Boundary);\n\n    // Also pin down the exhaustive boundary x boundary cross-product for the\n    // multiply, which random sampling would only hit probabilistically.\n    let n = BOUNDARY.len();\n    let mut a = Vec::new();\n    let mut b = Vec::new();\n    for &x in BOUNDARY {\n        for &y in BOUNDARY {\n            a.push(x);\n            b.push(y);\n        }\n    }\n    let total = n * n;\n    a.push(0);\n    b.push(0);\n    let mut rng = Rng::new(0xBEEF);\n    let c = gen(&mut rng, ValueClass::Boundary, total + 1);\n    let o = gen(&mut rng, ValueClass::FullRandom, total + 1);\n    diff_fma(\n        \"row10-exhaustive\",\n        Alias::AllDistinct,\n        total as c_int,\n        &a,\n        &b,\n        &c,\n        &o,\n    );\n}\n\n#[test]\nfn row11_fma_every_product_overflows() {\n    fma_value_class_row(\"row11\", 0x0000_000B, ValueClass::OverflowMul);\n}\n\n#[test]\nfn row12_fma_every_add_overflows() {\n    // mul1 = 1, mul2 = INT_MAX (or near), add = 1.. so the `+` overflows.\n    let mut rng = Rng::new(0x0000_000C);\n    for _ in 0..ITERS {\n        let n = rng.range_usize(64, 512);\n        let a: Vec<i32> = vec![1; n + 1];\n        let b = gen(&mut rng, ValueClass::OverflowAdd, n + 1);\n        let c: Vec<i32> = (0..n + 1).map(|_| rng.range_i32(1, 8)).collect();\n        let o = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        diff_fma(\"row12\", Alias::AllDistinct, n as c_int, &a, &b, &c, &o);\n    }\n}\n\n// ===========================================================================\n// Rows 13-18: `fma_array` aliasing schemes\n// ===========================================================================\n\nfn fma_alias_row(row: &str, seed: u64, alias: Alias) {\n    let mut rng = Rng::new(seed);\n    for _ in 0..ITERS {\n        let n = rng.range_usize(64, 512);\n        // Cycle through value classes so each aliasing scheme also sees\n        // overflowing and boundary data, not just benign randoms.\n        let class = rng.pick(ALL_VALUE_CLASSES);\n        let a = gen(&mut rng, class, n + 2);\n        let b = gen(&mut rng, class, n + 2);\n        let c = gen(&mut rng, class, n + 2);\n        let o = gen(&mut rng, ValueClass::FullRandom, n + 2);\n        diff_fma(row, alias, n as c_int, &a, &b, &c, &o);\n    }\n}\n\n#[test]\nfn row13_fma_alias_out_is_mul1() {\n    fma_alias_row(\"row13\", 0x0000_000D, Alias::OutIsMul1);\n}\n\n#[test]\nfn row14_fma_alias_out_is_add() {\n    fma_alias_row(\"row14\", 0x0000_000E, Alias::OutIsAdd);\n}\n\n#[test]\nfn row15_fma_alias_mul1_is_mul2_squaring() {\n    fma_alias_row(\"row15\", 0x0000_000F, Alias::Mul1IsMul2);\n}\n\n#[test]\nfn row16_fma_alias_all_four_same_inner_pattern() {\n    fma_alias_row(\"row16\", 0x0000_0010, Alias::AllSame);\n}\n\n#[test]\nfn row17_fma_alias_mul1_one_ahead_of_out() {\n    fma_alias_row(\"row17\", 0x0000_0011, Alias::Mul1AheadOfOut);\n}\n\n#[test]\nfn row18_fma_alias_out_one_ahead_of_mul1() {\n    fma_alias_row(\"row18\", 0x0000_0012, Alias::OutAheadOfMul1);\n}\n\n#[test]\nfn rows13_18_all_alias_schemes_across_all_lens() {\n    // Cross-product sweep: every aliasing scheme x a spread of lengths x every\n    // value class. This is the row 13-18 cross-check at small scale.\n    let mut rng = Rng::new(0x0000_1318);\n    for &alias in ALL_ALIASES {\n        for &class in ALL_VALUE_CLASSES {\n            for len in [0i32, 1, 2, 3, 5, 8, 17, 64, 129] {\n                let n = len.max(0) as usize;\n                let a = gen(&mut rng, class, n + 2);\n                let b = gen(&mut rng, class, n + 2);\n                let c = gen(&mut rng, class, n + 2);\n                let o = gen(&mut rng, ValueClass::FullRandom, n + 2);\n                diff_fma(\n                    &format!(\"sweep alias={alias:?} class={class:?}\"),\n                    alias,\n                    len,\n                    &a,\n                    &b,\n                    &c,\n                    &o,\n                );\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 19-28: `driver` (stdout compared byte-for-byte)\n// ===========================================================================\n\n#[test]\nfn row19_driver_len0_prints_nothing() {\n    let mut rng = Rng::new(0x0000_0013);\n    for _ in 0..32 {\n        let data = gen(&mut rng, ValueClass::FullRandom, 8);\n        let out = diff_driver(\"row19\", &data, 0);\n        assert!(\n            out.is_empty(),\n            \"driver(len=0) must print nothing, got {:?}\",\n            String::from_utf8_lossy(&out)\n        );\n    }\n}\n\n#[test]\nfn row20_driver_len1_random() {\n    let mut rng = Rng::new(0x0000_0014);\n    for _ in 0..ITERS {\n        let data = gen(&mut rng, ValueClass::FullRandom, 1);\n        let out = diff_driver(\"row20\", &data, 1);\n        assert_eq!(out, expected_driver_stdout(&data, 1));\n    }\n}\n\n#[test]\nfn row21_driver_len_small_random() {\n    let mut rng = Rng::new(0x0000_0015);\n    for _ in 0..ITERS {\n        let n = rng.range_usize(2, 8);\n        let data = gen(&mut rng, ValueClass::FullRandom, n);\n        let out = diff_driver(\"row21\", &data, n as c_int);\n        assert_eq!(out, expected_driver_stdout(&data, n as c_int));\n    }\n}\n\n#[test]\nfn row22_driver_len_many_random() {\n    let mut rng = Rng::new(0x0000_0016);\n    for _ in 0..64 {\n        let n = rng.range_usize(64, 1024);\n        let data = gen(&mut rng, ValueClass::FullRandom, n);\n        let out = diff_driver(\"row22\", &data, n as c_int);\n        assert_eq!(out, expected_driver_stdout(&data, n as c_int));\n    }\n}\n\nfn driver_value_class_row(row: &str, seed: u64, class: ValueClass) {\n    let mut rng = Rng::new(seed);\n    for _ in 0..64 {\n        let n = rng.range_usize(64, 512);\n        let data = gen(&mut rng, class, n);\n        let out = diff_driver(row, &data, n as c_int);\n        assert_eq!(out, expected_driver_stdout(&data, n as c_int));\n    }\n}\n\n#[test]\nfn row23_driver_all_zeros() {\n    driver_value_class_row(\"row23\", 0x0000_0017, ValueClass::Zeros);\n    // Explicit shape check: len copies of \"0\\n\".\n    let data = vec![0i32; 100];\n    let out = diff_driver(\"row23-shape\", &data, 100);\n    assert_eq!(out, b\"0\\n\".repeat(100));\n}\n\n#[test]\nfn row24_driver_small_positive() {\n    driver_value_class_row(\"row24\", 0x0000_0018, ValueClass::SmallPos);\n}\n\n#[test]\nfn row25_driver_small_negative_sign_formatting() {\n    driver_value_class_row(\"row25\", 0x0000_0019, ValueClass::SmallNeg);\n}\n\n#[test]\nfn row26_driver_boundary_values_and_int_min_formatting() {\n    driver_value_class_row(\"row26\", 0x0000_001A, ValueClass::Boundary);\n\n    // Exhaustive: every boundary value as a single-element driver call, so the\n    // exact decimal rendering of each wrapped result is pinned.\n    for &v in BOUNDARY {\n        let data = [v];\n        let out = diff_driver(&format!(\"row26-single v={v}\"), &data, 1);\n        assert_eq!(out, expected_driver_stdout(&data, 1));\n    }\n    // And all of them in one array, to pin the ordering of the print loop.\n    let data: Vec<i32> = BOUNDARY.to_vec();\n    let out = diff_driver(\"row26-all\", &data, data.len() as c_int);\n    assert_eq!(out, expected_driver_stdout(&data, data.len() as c_int));\n\n    // INT_MIN specifically: INT_MIN*INT_MIN wraps to 0, +INT_MIN = INT_MIN,\n    // which must print as \"-2147483648\".\n    let out = diff_driver(\"row26-intmin\", &[i32::MIN], 1);\n    assert_eq!(out, b\"-2147483648\\n\");\n}\n\n#[test]\nfn row27_driver_every_product_overflows() {\n    driver_value_class_row(\"row27\", 0x0000_001B, ValueClass::OverflowMul);\n}\n\n#[test]\nfn row28_driver_repeated_calls_are_stateless() {\n    // Interleave many calls of differing lengths against each library and\n    // confirm each call's stdout depends only on its own arguments.\n    let mut rng = Rng::new(0x0000_001C);\n    let l = libs();\n    let mut first_seen: Vec<(Vec<i32>, c_int, Vec<u8>)> = Vec::new();\n\n    for _ in 0..120 {\n        let n = rng.range_usize(0, 40);\n        let data = gen(&mut rng, ValueClass::Boundary, n.max(1));\n        let len = n as c_int;\n        let out = diff_driver(\"row28\", &data, len);\n        first_seen.push((data, len, out));\n    }\n\n    // Replay everything in reverse order; results must be unchanged, proving\n    // neither implementation carries state (e.g. a leaked VLA buffer) between\n    // calls.\n    for (data, len, expect) in first_seen.iter().rev() {\n        let oc = capture_stdout(|| unsafe { (l.c.driver)(data.as_ptr(), *len) });\n        let or = capture_stdout(|| unsafe { (l.rs.driver)(data.as_ptr(), *len) });\n        assert_eq!(&oc, expect, \"C driver not stateless at len={len}\");\n        assert_eq!(&or, expect, \"Rust driver not stateless at len={len}\");\n    }\n}\n\n// ===========================================================================\n// Row 29: composed pipeline vs. low-level primitive\n// ===========================================================================\n\n#[test]\nfn row29_driver_stdout_matches_fma_array_primitive() {\n    let mut rng = Rng::new(0x0000_001D);\n    let l = libs();\n\n    for _ in 0..ITERS {\n        let n = rng.range_usize(1, 128);\n        let class = rng.pick(ALL_VALUE_CLASSES);\n        let data = gen(&mut rng, class, n);\n        let len = n as c_int;\n\n        // Pipeline output from each library.\n        let out = diff_driver(\"row29\", &data, len);\n\n        // Low-level primitive, driven the same way `inner` drives it, from each\n        // library independently.\n        for imp in [&l.c, &l.rs] {\n            let mut buf = data.clone();\n            unsafe {\n                let p = buf.as_mut_ptr();\n                (imp.fma_array)(\n                    p,\n                    p as *const c_int,\n                    p as *const c_int,\n                    p as *const c_int,\n                    len,\n                );\n            }\n            let mut rendered = String::new();\n            for v in &buf {\n                rendered.push_str(&v.to_string());\n                rendered.push('\\n');\n            }\n            assert_eq!(\n                out,\n                rendered.as_bytes(),\n                \"{}: driver pipeline disagrees with its own fma_array primitive (len={len})\",\n                imp.name\n            );\n        }\n    }\n}\n\n// ===========================================================================\n// Row 30: exactly `len` elements written, nothing past the end\n// ===========================================================================\n\n#[test]\nfn row30_fma_writes_exactly_len_elements() {\n    let mut rng = Rng::new(0x0000_001E);\n    let l = libs();\n\n    for _ in 0..ITERS {\n        let n = rng.range_usize(1, 256);\n        let a = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let b = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let c = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        // out_init is deliberately shorter than the buffer so the tail stays\n        // SENTINEL in `call_fma`.\n        let o = vec![SENTINEL; 0];\n\n        // Differential first.\n        diff_fma(\"row30\", Alias::AllDistinct, n as c_int, &a, &b, &c, &o);\n\n        // Then the absolute check on both: everything at index >= len must\n        // still be the sentinel.\n        for imp in [&l.c, &l.rs] {\n            let res = call_fma(imp, Alias::AllDistinct, n as c_int, &a, &b, &c, &o);\n            let outbuf = &res.buffers[0];\n            for (i, &v) in outbuf.iter().enumerate().skip(n) {\n                assert_eq!(\n                    v, SENTINEL,\n                    \"{}: fma_array wrote past len={n} at index {i}\",\n                    imp.name\n                );\n            }\n            for i in 0..n {\n                let want = a[i].wrapping_mul(b[i]).wrapping_add(c[i]);\n                assert_eq!(outbuf[i], want, \"{}: wrong value at {i}\", imp.name);\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8358,"cache_read_input_tokens":36677,"cache_creation":{"ephemeral_5m_input_tokens":8358,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ff8d49d8-2e6c-4767-9cd4-46061465867f","uuid":"572d88ef-3177-4080-8d9c-38abca6f5138","timestamp":"2026-09-05T04:37:12.830Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TYfTqRcAgNidufpsRDUHQa","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-XV6Atq/translation/tests/phase_b_configs.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ff8d49d8-2e6c-4767-9cd4-46061465867f","uuid":"d6f8ab95-a9a1-4096-adba-c26e046b1adf","timestamp":"2026-09-05T04:37:12.844Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-XV6Atq/translation/tests/phase_b_configs.rs","content":"//! Phase B — valid-path differential tests, one test per CONFIGS.md row.\n//!\n//! Every test drives BOTH shared objects through their exported C symbols\n//! (never the Rust crate directly) and compares results byte-for-byte, using\n//! many randomized inputs per row with a fixed seed.\n\nmod common;\n\nuse common::*;\nuse std::ffi::c_int;\n\n/// How many randomized inputs each row gets.\nconst ITERS: usize = 200;\n\n// ===========================================================================\n// Rows 1-5: `fma_array`, all pointers distinct, varying `len`\n// ===========================================================================\n\n#[test]\nfn row01_fma_len0_distinct_leaves_out_untouched() {\n    let mut rng = Rng::new(0x0000_0001);\n    for _ in 0..ITERS {\n        let a = gen(&mut rng, ValueClass::FullRandom, 8);\n        let b = gen(&mut rng, ValueClass::FullRandom, 8);\n        let c = gen(&mut rng, ValueClass::FullRandom, 8);\n        let o = gen(&mut rng, ValueClass::FullRandom, 8);\n        diff_fma(\"row01\", Alias::AllDistinct, 0, &a, &b, &c, &o);\n\n        // And confirm the shared semantics: nothing was written.\n        let l = libs();\n        let res = call_fma(&l.c, Alias::AllDistinct, 0, &a, &b, &c, &o);\n        assert_eq!(&res.buffers[0][..8], &o[..8], \"len=0 must not write to out\");\n    }\n}\n\n#[test]\nfn row02_fma_len1_distinct_random() {\n    let mut rng = Rng::new(0x0000_0002);\n    for _ in 0..ITERS {\n        let a = gen(&mut rng, ValueClass::FullRandom, 2);\n        let b = gen(&mut rng, ValueClass::FullRandom, 2);\n        let c = gen(&mut rng, ValueClass::FullRandom, 2);\n        let o = gen(&mut rng, ValueClass::FullRandom, 2);\n        diff_fma(\"row02\", Alias::AllDistinct, 1, &a, &b, &c, &o);\n    }\n}\n\n#[test]\nfn row03_fma_len2_distinct_random() {\n    let mut rng = Rng::new(0x0000_0003);\n    for _ in 0..ITERS {\n        let a = gen(&mut rng, ValueClass::FullRandom, 3);\n        let b = gen(&mut rng, ValueClass::FullRandom, 3);\n        let c = gen(&mut rng, ValueClass::FullRandom, 3);\n        let o = gen(&mut rng, ValueClass::FullRandom, 3);\n        diff_fma(\"row03\", Alias::AllDistinct, 2, &a, &b, &c, &o);\n    }\n}\n\n#[test]\nfn row04_fma_len_small_distinct_random() {\n    let mut rng = Rng::new(0x0000_0004);\n    for _ in 0..ITERS {\n        let n = rng.range_usize(2, 8);\n        let a = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let b = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let c = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let o = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        diff_fma(\"row04\", Alias::AllDistinct, n as c_int, &a, &b, &c, &o);\n    }\n}\n\n#[test]\nfn row05_fma_len_many_distinct_random() {\n    let mut rng = Rng::new(0x0000_0005);\n    for _ in 0..ITERS {\n        let n = rng.range_usize(64, 1024);\n        let a = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let b = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let c = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let o = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        diff_fma(\"row05\", Alias::AllDistinct, n as c_int, &a, &b, &c, &o);\n    }\n}\n\n// ===========================================================================\n// Rows 6-12: `fma_array`, len many, each value class (incl. both overflow kinds)\n// ===========================================================================\n\nfn fma_value_class_row(row: &str, seed: u64, class: ValueClass) {\n    let mut rng = Rng::new(seed);\n    for _ in 0..ITERS {\n        let n = rng.range_usize(64, 512);\n        let a = gen(&mut rng, class, n + 1);\n        let b = gen(&mut rng, class, n + 1);\n        let c = gen(&mut rng, class, n + 1);\n        let o = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        diff_fma(row, Alias::AllDistinct, n as c_int, &a, &b, &c, &o);\n    }\n}\n\n#[test]\nfn row06_fma_all_zeros() {\n    fma_value_class_row(\"row06\", 0x0000_0006, ValueClass::Zeros);\n}\n\n#[test]\nfn row07_fma_small_positive() {\n    fma_value_class_row(\"row07\", 0x0000_0007, ValueClass::SmallPos);\n}\n\n#[test]\nfn row08_fma_small_negative() {\n    fma_value_class_row(\"row08\", 0x0000_0008, ValueClass::SmallNeg);\n}\n\n#[test]\nfn row09_fma_mixed_sign_small() {\n    fma_value_class_row(\"row09\", 0x0000_0009, ValueClass::MixedSmall);\n}\n\n#[test]\nfn row10_fma_boundary_values_mul_and_add_wrap() {\n    fma_value_class_row(\"row10\", 0x0000_000A, ValueClass::Boundary);\n\n    // Also pin down the exhaustive boundary x boundary cross-product for the\n    // multiply, which random sampling would only hit probabilistically.\n    let n = BOUNDARY.len();\n    let mut a = Vec::new();\n    let mut b = Vec::new();\n    for &x in BOUNDARY {\n        for &y in BOUNDARY {\n            a.push(x);\n            b.push(y);\n        }\n    }\n    let total = n * n;\n    a.push(0);\n    b.push(0);\n    let mut rng = Rng::new(0xBEEF);\n    let c = gen(&mut rng, ValueClass::Boundary, total + 1);\n    let o = gen(&mut rng, ValueClass::FullRandom, total + 1);\n    diff_fma(\n        \"row10-exhaustive\",\n        Alias::AllDistinct,\n        total as c_int,\n        &a,\n        &b,\n        &c,\n        &o,\n    );\n}\n\n#[test]\nfn row11_fma_every_product_overflows() {\n    fma_value_class_row(\"row11\", 0x0000_000B, ValueClass::OverflowMul);\n}\n\n#[test]\nfn row12_fma_every_add_overflows() {\n    // mul1 = 1, mul2 = INT_MAX (or near), add = 1.. so the `+` overflows.\n    let mut rng = Rng::new(0x0000_000C);\n    for _ in 0..ITERS {\n        let n = rng.range_usize(64, 512);\n        let a: Vec<i32> = vec![1; n + 1];\n        let b = gen(&mut rng, ValueClass::OverflowAdd, n + 1);\n        let c: Vec<i32> = (0..n + 1).map(|_| rng.range_i32(1, 8)).collect();\n        let o = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        diff_fma(\"row12\", Alias::AllDistinct, n as c_int, &a, &b, &c, &o);\n    }\n}\n\n// ===========================================================================\n// Rows 13-18: `fma_array` aliasing schemes\n// ===========================================================================\n\nfn fma_alias_row(row: &str, seed: u64, alias: Alias) {\n    let mut rng = Rng::new(seed);\n    for _ in 0..ITERS {\n        let n = rng.range_usize(64, 512);\n        // Cycle through value classes so each aliasing scheme also sees\n        // overflowing and boundary data, not just benign randoms.\n        let class = rng.pick(ALL_VALUE_CLASSES);\n        let a = gen(&mut rng, class, n + 2);\n        let b = gen(&mut rng, class, n + 2);\n        let c = gen(&mut rng, class, n + 2);\n        let o = gen(&mut rng, ValueClass::FullRandom, n + 2);\n        diff_fma(row, alias, n as c_int, &a, &b, &c, &o);\n    }\n}\n\n#[test]\nfn row13_fma_alias_out_is_mul1() {\n    fma_alias_row(\"row13\", 0x0000_000D, Alias::OutIsMul1);\n}\n\n#[test]\nfn row14_fma_alias_out_is_add() {\n    fma_alias_row(\"row14\", 0x0000_000E, Alias::OutIsAdd);\n}\n\n#[test]\nfn row15_fma_alias_mul1_is_mul2_squaring() {\n    fma_alias_row(\"row15\", 0x0000_000F, Alias::Mul1IsMul2);\n}\n\n#[test]\nfn row16_fma_alias_all_four_same_inner_pattern() {\n    fma_alias_row(\"row16\", 0x0000_0010, Alias::AllSame);\n}\n\n#[test]\nfn row17_fma_alias_mul1_one_ahead_of_out() {\n    fma_alias_row(\"row17\", 0x0000_0011, Alias::Mul1AheadOfOut);\n}\n\n#[test]\nfn row18_fma_alias_out_one_ahead_of_mul1() {\n    fma_alias_row(\"row18\", 0x0000_0012, Alias::OutAheadOfMul1);\n}\n\n#[test]\nfn rows13_18_all_alias_schemes_across_all_lens() {\n    // Cross-product sweep: every aliasing scheme x a spread of lengths x every\n    // value class. This is the row 13-18 cross-check at small scale.\n    let mut rng = Rng::new(0x0000_1318);\n    for &alias in ALL_ALIASES {\n        for &class in ALL_VALUE_CLASSES {\n            for len in [0i32, 1, 2, 3, 5, 8, 17, 64, 129] {\n                let n = len.max(0) as usize;\n                let a = gen(&mut rng, class, n + 2);\n                let b = gen(&mut rng, class, n + 2);\n                let c = gen(&mut rng, class, n + 2);\n                let o = gen(&mut rng, ValueClass::FullRandom, n + 2);\n                diff_fma(\n                    &format!(\"sweep alias={alias:?} class={class:?}\"),\n                    alias,\n                    len,\n                    &a,\n                    &b,\n                    &c,\n                    &o,\n                );\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 19-28: `driver` (stdout compared byte-for-byte)\n// ===========================================================================\n\n#[test]\nfn row19_driver_len0_prints_nothing() {\n    let mut rng = Rng::new(0x0000_0013);\n    for _ in 0..32 {\n        let data = gen(&mut rng, ValueClass::FullRandom, 8);\n        let out = diff_driver(\"row19\", &data, 0);\n        assert!(\n            out.is_empty(),\n            \"driver(len=0) must print nothing, got {:?}\",\n            String::from_utf8_lossy(&out)\n        );\n    }\n}\n\n#[test]\nfn row20_driver_len1_random() {\n    let mut rng = Rng::new(0x0000_0014);\n    for _ in 0..ITERS {\n        let data = gen(&mut rng, ValueClass::FullRandom, 1);\n        let out = diff_driver(\"row20\", &data, 1);\n        assert_eq!(out, expected_driver_stdout(&data, 1));\n    }\n}\n\n#[test]\nfn row21_driver_len_small_random() {\n    let mut rng = Rng::new(0x0000_0015);\n    for _ in 0..ITERS {\n        let n = rng.range_usize(2, 8);\n        let data = gen(&mut rng, ValueClass::FullRandom, n);\n        let out = diff_driver(\"row21\", &data, n as c_int);\n        assert_eq!(out, expected_driver_stdout(&data, n as c_int));\n    }\n}\n\n#[test]\nfn row22_driver_len_many_random() {\n    let mut rng = Rng::new(0x0000_0016);\n    for _ in 0..64 {\n        let n = rng.range_usize(64, 1024);\n        let data = gen(&mut rng, ValueClass::FullRandom, n);\n        let out = diff_driver(\"row22\", &data, n as c_int);\n        assert_eq!(out, expected_driver_stdout(&data, n as c_int));\n    }\n}\n\nfn driver_value_class_row(row: &str, seed: u64, class: ValueClass) {\n    let mut rng = Rng::new(seed);\n    for _ in 0..64 {\n        let n = rng.range_usize(64, 512);\n        let data = gen(&mut rng, class, n);\n        let out = diff_driver(row, &data, n as c_int);\n        assert_eq!(out, expected_driver_stdout(&data, n as c_int));\n    }\n}\n\n#[test]\nfn row23_driver_all_zeros() {\n    driver_value_class_row(\"row23\", 0x0000_0017, ValueClass::Zeros);\n    // Explicit shape check: len copies of \"0\\n\".\n    let data = vec![0i32; 100];\n    let out = diff_driver(\"row23-shape\", &data, 100);\n    assert_eq!(out, b\"0\\n\".repeat(100));\n}\n\n#[test]\nfn row24_driver_small_positive() {\n    driver_value_class_row(\"row24\", 0x0000_0018, ValueClass::SmallPos);\n}\n\n#[test]\nfn row25_driver_small_negative_sign_formatting() {\n    driver_value_class_row(\"row25\", 0x0000_0019, ValueClass::SmallNeg);\n}\n\n#[test]\nfn row26_driver_boundary_values_and_int_min_formatting() {\n    driver_value_class_row(\"row26\", 0x0000_001A, ValueClass::Boundary);\n\n    // Exhaustive: every boundary value as a single-element driver call, so the\n    // exact decimal rendering of each wrapped result is pinned.\n    for &v in BOUNDARY {\n        let data = [v];\n        let out = diff_driver(&format!(\"row26-single v={v}\"), &data, 1);\n        assert_eq!(out, expected_driver_stdout(&data, 1));\n    }\n    // And all of them in one array, to pin the ordering of the print loop.\n    let data: Vec<i32> = BOUNDARY.to_vec();\n    let out = diff_driver(\"row26-all\", &data, data.len() as c_int);\n    assert_eq!(out, expected_driver_stdout(&data, data.len() as c_int));\n\n    // INT_MIN specifically: INT_MIN*INT_MIN wraps to 0, +INT_MIN = INT_MIN,\n    // which must print as \"-2147483648\".\n    let out = diff_driver(\"row26-intmin\", &[i32::MIN], 1);\n    assert_eq!(out, b\"-2147483648\\n\");\n}\n\n#[test]\nfn row27_driver_every_product_overflows() {\n    driver_value_class_row(\"row27\", 0x0000_001B, ValueClass::OverflowMul);\n}\n\n#[test]\nfn row28_driver_repeated_calls_are_stateless() {\n    // Interleave many calls of differing lengths against each library and\n    // confirm each call's stdout depends only on its own arguments.\n    let mut rng = Rng::new(0x0000_001C);\n    let l = libs();\n    let mut first_seen: Vec<(Vec<i32>, c_int, Vec<u8>)> = Vec::new();\n\n    for _ in 0..120 {\n        let n = rng.range_usize(0, 40);\n        let data = gen(&mut rng, ValueClass::Boundary, n.max(1));\n        let len = n as c_int;\n        let out = diff_driver(\"row28\", &data, len);\n        first_seen.push((data, len, out));\n    }\n\n    // Replay everything in reverse order; results must be unchanged, proving\n    // neither implementation carries state (e.g. a leaked VLA buffer) between\n    // calls.\n    for (data, len, expect) in first_seen.iter().rev() {\n        let oc = capture_stdout(|| unsafe { (l.c.driver)(data.as_ptr(), *len) });\n        let or = capture_stdout(|| unsafe { (l.rs.driver)(data.as_ptr(), *len) });\n        assert_eq!(&oc, expect, \"C driver not stateless at len={len}\");\n        assert_eq!(&or, expect, \"Rust driver not stateless at len={len}\");\n    }\n}\n\n// ===========================================================================\n// Row 29: composed pipeline vs. low-level primitive\n// ===========================================================================\n\n#[test]\nfn row29_driver_stdout_matches_fma_array_primitive() {\n    let mut rng = Rng::new(0x0000_001D);\n    let l = libs();\n\n    for _ in 0..ITERS {\n        let n = rng.range_usize(1, 128);\n        let class = rng.pick(ALL_VALUE_CLASSES);\n        let data = gen(&mut rng, class, n);\n        let len = n as c_int;\n\n        // Pipeline output from each library.\n        let out = diff_driver(\"row29\", &data, len);\n\n        // Low-level primitive, driven the same way `inner` drives it, from each\n        // library independently.\n        for imp in [&l.c, &l.rs] {\n            let mut buf = data.clone();\n            unsafe {\n                let p = buf.as_mut_ptr();\n                (imp.fma_array)(\n                    p,\n                    p as *const c_int,\n                    p as *const c_int,\n                    p as *const c_int,\n                    len,\n                );\n            }\n            let mut rendered = String::new();\n            for v in &buf {\n                rendered.push_str(&v.to_string());\n                rendered.push('\\n');\n            }\n            assert_eq!(\n                out,\n                rendered.as_bytes(),\n                \"{}: driver pipeline disagrees with its own fma_array primitive (len={len})\",\n                imp.name\n            );\n        }\n    }\n}\n\n// ===========================================================================\n// Row 30: exactly `len` elements written, nothing past the end\n// ===========================================================================\n\n#[test]\nfn row30_fma_writes_exactly_len_elements() {\n    let mut rng = Rng::new(0x0000_001E);\n    let l = libs();\n\n    for _ in 0..ITERS {\n        let n = rng.range_usize(1, 256);\n        let a = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let b = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        let c = gen(&mut rng, ValueClass::FullRandom, n + 1);\n        // out_init is deliberately shorter than the buffer so the tail stays\n        // SENTINEL in `call_fma`.\n        let o = vec![SENTINEL; 0];\n\n        // Differential first.\n        diff_fma(\"row30\", Alias::AllDistinct, n as c_int, &a, &b, &c, &o);\n\n        // Then the absolute check on both: everything at index >= len must\n        // still be the sentinel.\n        for imp in [&l.c, &l.rs] {\n            let res = call_fma(imp, Alias::AllDistinct, n as c_int, &a, &b, &c, &o);\n            let outbuf = &res.buffers[0];\n            for (i, &v) in outbuf.iter().enumerate().skip(n) {\n                assert_eq!(\n                    v, SENTINEL,\n                    \"{}: fma_array wrote past len={n} at index {i}\",\n                    imp.name\n                );\n            }\n            for i in 0..n {\n                let want = a[i].wrapping_mul(b[i]).wrapping_add(c[i]);\n                assert_eq!(outbuf[i], want, \"{}: wrong value at {i}\", imp.name);\n            }\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
