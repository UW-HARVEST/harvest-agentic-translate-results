waitpid(pid, &mut status, 0);","-        assert!(r == pid, \"waitpid() failed\");","-        // Decode wait status without pulling in the libc crate.","-        if status & 0x7f == 0x7f {","-            // stopped — treat as signaled for our purposes","-            ChildOutcome::Signaled((status >> 8) & 0xff)","-        } else if status & 0x7f != 0 {","-            ChildOutcome::Signaled(status & 0x7f)","+","+        if null_ptrs {","+            match func {","+                \"driver\" => (imp.driver)(std::ptr::null(), len),","+                \"fma\" => (imp.fma_array)(","+                    std::ptr::null_mut(),","+                    std::ptr::null(),","+                    std::ptr::null(),","+                    std::ptr::null(),","+                    len,","+                ),","+                _ => panic!(\"bad func {func}\"),","+            }","         } else {","-            ChildOutcome::Exited((status >> 8) & 0xff)","+            let mut buf: Vec<c_int> = vec![7; alloc.max(1)];","+            match func {","+                \"driver\" => (imp.driver)(buf.as_ptr(), len),","+                \"fma\" => {","+                    let p = buf.as_mut_ptr();","+                    (imp.fma_array)(p, p as *const c_int, p as *const c_int, p as *const c_int, len)","+                }","+                _ => panic!(\"bad func {func}\"),","+            }","         }","+        fflush(std::ptr::null_mut());","+        _exit(0);","     }"," }"," ","+/// Runs one `CrashCase` in a fresh process and reports how it terminated.","+pub fn run_crash_case(case: &CrashCase, timeout: std::time::Duration) -> Outcome {","+    use std::os::unix::process::ExitStatusExt;","+","+    let spec = format!(","+        \"{}|{}|{}|{}|{}\",","+        case.which.tag(),","+        case.func,","+        case.len,","+        if case.null_ptrs { \"null\" } else { \"valid\" },","+        case.alloc,","+    );","+    let exe = std::env::current_exe().expect(\"current_exe\");","+    let mut child = {","+        let _g = spawn_lock().lock().unwrap_or_else(|e| e.into_inner());","+        std::process::Command::new(&exe)","+            .args([","+                \"--exact\",","+                CRASH_WORKER_TEST_NAME,","+                \"--test-threads=1\",","+                \"--quiet\",","+            ])","+            .env(CRASH_ENV, &spec)","+            .stdout(std::process::Stdio::null())","+            .stderr(std::process::Stdio::null())","+            .spawn()","+            .expect(\"spawn crash worker\")","+    };","+","+    let deadline = std::time::Instant::now() + timeout;","+    loop {","+        match child.try_wait().expect(\"try_wait\") {","+            Some(status) => {","+                return if let Some(sig) = status.signal() {","+                    Outcome::Signaled(sig)","+                } else {","+                    Outcome::Exited(status.code().unwrap_or(-1))","+                };","+            }","+            None => {","+                if std::time::Instant::now() >= deadline {","+                    let _ = child.kill();","+                    let _ = child.wait();","+                    return Outcome::TimedOut;","+                }","+                std::thread::sleep(std::time::Duration::from_millis(5));","+            }","+        }","+    }","+}","+","+/// Convenience: run the same case against both libraries.","+pub fn run_crash_both(","+    func: &'static str,","+    len: c_int,","+    null_ptrs: bool,","+    alloc: usize,","+    timeout: std::time::Duration,","+) -> (Outcome, Outcome) {","+    let mk = |which| CrashCase { which, func, len, null_ptrs, alloc };","+    (","+        run_crash_case(&mk(Which::C), timeout),","+        run_crash_case(&mk(Which::Rust), timeout),","+    )","+}","+","+/// True if the outcome is a hard fault (the shapes the C's UB takes).","+pub fn is_fault(o: Outcome) -> bool {","+    matches!(o, Outcome::Signaled(SIGSEGV) | Outcome::Signaled(SIGBUS) | Outcome::Signaled(SIGABRT))","+}","+