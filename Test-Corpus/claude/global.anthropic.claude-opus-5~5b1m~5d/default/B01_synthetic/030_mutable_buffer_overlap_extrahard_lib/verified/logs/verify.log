usize = 8 << 20; // 8 MiB\n\nfn crash_worker_body(which: &str, func: &str, len: c_int, null_mask: u32, alloc: usize) {\n    let l = libs();'''\nassert old in s\ns=s.replace(old,new)\n\n# the old body ended with `_exit(0)` inside; adjust the tail\nold_tail='''            _ => panic!(\"bad func {func}\"),\n        }\n        fflush(std::ptr::null_mut());\n        _exit(0);\n    }\n}'''\nnew_tail='''            _ => panic!(\"bad func {func}\"),\n        }\n        fflush(std::ptr::null_mut());\n    }\n}'''\nassert old_tail in s\ns=s.replace(old_tail,new_tail)\nopen(p,'w').write(s)\nprint(\"ok\")\nPY\ngrep -n 'let imp = if which' tests/common/mod.rs","description":"Run crash worker call on a fixed-size stack"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2351,"cache_read_input_tokens":124404,"cache_creation":{"ephemeral_5m_input_tokens":2351,"ephemeral_1h_input_tokens":0},"output_tokens":9,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ff8d49d8-2e6c-4767-9cd4-46061465867f","uuid":"47218ecd-a4ee-4348-83ee-b237bb7b8cab","timestamp":"2026-09-05T04:52:20.436Z"}
