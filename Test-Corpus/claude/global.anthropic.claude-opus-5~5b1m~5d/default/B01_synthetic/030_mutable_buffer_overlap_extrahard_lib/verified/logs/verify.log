{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017orRoDmfKurWJXhzsdLEcS","type":"tool_result","content":"190\t\n191\t// ---------------------------------------------------------------------------\n192\t// stdout capture. `driver` prints via libc `printf`, so the only faithful way\n193\t// to observe it is to redirect file descriptor 1 and compare the raw bytes.\n194\t//\n195\t// fd 1 is process-global, so all capturing is serialized behind this mutex.\n196\t// ---------------------------------------------------------------------------\n197\tfn capture_lock() -> &'static Mutex<()> {\n198\t    static L: OnceLock<Mutex<()>> = OnceLock::new();\n199\t    L.get_or_init(|| Mutex::new(()))\n200\t}\n201\t\n202\t/// Runs `f` with fd 1 redirected to a temporary file and returns everything\n203\t/// written to it (by libc stdio, from either shared object).\n204\tpub fn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n205\t    let _guard = capture_lock().lock().unwrap_or_else(|e| e.into_inner());\n206\t\n207\t    let mut tmp = std::env::temp_dir();\n208\t    tmp.push(format!(\n209\t        \"difftest-stdout-{}-{:p}.bin\",\n210\t        std::process::id(),\n211\t        &tmp as *const _\n212\t    ));\n213\t    let cpath = std::ffi::CString::new(tmp.to_str().unwrap()).unwrap();\n214\t\n215\t    unsafe {\n216\t        // Flush anything already buffered for the *real* stdout first, so it\n217\t        // does not end up in our capture file.\n218\t        fflush(std::ptr::null_mut());\n219\t\n220\t        let tmpfd = open(cpath.as_ptr(), O_RDWR | O_CREAT | O_TRUNC, 0o600 as c_int);\n221\t        assert!(tmpfd >= 0, \"open() of capture file failed\");\n222\t        let saved = dup(1);\n223\t        assert!(saved >= 0, \"dup(1) failed\");\n224\t        assert!(dup2(tmpfd, 1) >= 0, \"dup2 onto fd 1 failed\");\n225\t\n226\t        f();\n227\t\n228\t        // Push the library's buffered output into the capture file *before*\n229\t        // restoring fd 1."}]},"parent_tool_use_id":null,"session_id":"ff8d49d8-2e6c-4767-9cd4-46061465867f","uuid":"a38934b0-d357-4afe-804e-2185315f4a96","timestamp":"2026-09-05T04:39:41.485Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-XV6Atq/translation/tests/common/mod.rs","content":"\n// ---------------------------------------------------------------------------\n// stdout capture. `driver` prints via libc `printf`, so the only faithful way\n// to observe it is to redirect file descriptor 1 and compare the raw bytes.\n//\n// fd 1 is process-global, so all capturing is serialized behind this mutex.\n// ---------------------------------------------------------------------------\nfn capture_lock() -> &'static Mutex<()> {\n    static L: OnceLock<Mutex<()>> = OnceLock::new();\n    L.get_or_init(|| Mutex::new(()))\n}\n\n/// Runs `f` with fd 1 redirected to a temporary file and returns everything\n/// written to it (by libc stdio, from either shared object).\npub fn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    let _guard = capture_lock().lock().unwrap_or_else(|e| e.into_inner());\n\n    let mut tmp = std::env::temp_dir();\n    tmp.push(format!(\n        \"difftest-stdout-{}-{:p}.bin\",\n        std::process::id(),\n        &tmp as *const _\n    ));\n    let cpath = std::ffi::CString::new(tmp.to_str().unwrap()).unwrap();\n\n    unsafe {\n        // Flush anything already buffered for the *real* stdout first, so it\n        // does not end up in our capture file.\n        fflush(std::ptr::null_mut());\n\n        let tmpfd = open(cpath.as_ptr(), O_RDWR | O_CREAT | O_TRUNC, 0o600 as c_int);\n        assert!(tmpfd >= 0, \"open() of capture file failed\");\n        let saved = dup(1);\n        assert!(saved >= 0, \"dup(1) failed\");\n        assert!(dup2(tmpfd, 1) >= 0, \"dup2 onto fd 1 failed\");\n\n        f();\n\n        // Push the library's buffered output into the capture file *before*\n        // restoring fd 1.","numLines":40,"startLine":190,"totalLines":568}}}
