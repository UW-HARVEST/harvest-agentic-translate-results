w the four `fma_array` pointer arguments alias one another.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum Alias {\n    /// out, mul1, mul2, add are four independent buffers.\n    AllDistinct,\n    /// out == mul1\n    OutIsMul1,","numLines":50,"startLine":340,"totalLines":680}}}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_fkjehuu6xt7ddhexu7v6vylab3j5trc6usimshvm5dkvzwh3zvxq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01KpNkbomGvbd9ma7W8FNwpF","name":"Edit","input":{"replace_all":false,"file_path":"/local/home/scheschb/.harvest/work/harvest-work-XV6Atq/translation/tests/common/mod.rs","old_string":"/// Outcome of running a call in an isolated child process.\n#[derive(Debug, PartialEq, Eq, Clone, Copy)]\npub enum ChildOutcome {\n    Exited(i32),\n    Signaled(i32),\n}\n\n/// Runs `f` in a `fork()`ed child so that a hard crash (the C code's UB paths)\n/// cannot take the test process down. Returns how the child terminated.\npub fn run_isolated<F: FnOnce()>(f: F) -> ChildOutcome {\n    unsafe {\n        fflush(std::ptr::null_mut());\n        let pid = fork();\n        assert!(pid >= 0, \"fork() failed\");\n        if pid == 0 {\n            // Child: do the (possibly fatal) call, then leave immediately\n            // without running any atexit/TLS-destructor machinery.\n            f();\n            fflush(std::ptr::null_mut());\n            _exit(0);\n        }\n        let mut status: c_int = 0;\n        let r = waitpid(pid, &mut status, 0);\n        assert!(r == pid, \"waitpid() failed\");\n        // Decode wait status without pulling in the libc crate.\n        if status & 0x7f == 0x7f {\n            // stopped — treat as signaled for our purposes\n            ChildOutcome::Signaled((status >> 8) & 0xff)\n        } else if status & 0x7f != 0 {\n            ChildOutcome::Signaled(status & 0x7f)\n        } else {\n            ChildOutcome::Exited((status >> 8) & 0xff)\n        }\n    }\n}","new_string":"// ---------------------------------------------------------------------------\n// Crash isolation for the C code's undefined-behaviour paths (ERRORS.md rows\n// 10, 11, 14, 15). Those inputs make the C die outright, so they must run in a\n// separate process. As with stdout capture we re-exec this test binary rather\n// than `fork()`ing a multi-threaded process.\n// ---------------------------------------------------------------------------\n\n/// Which implementation to exercise in the isolated child.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum Which {\n    C,\n    Rust,\n}\n\nimpl Which {\n    pub fn tag(self) -> &'static str {\n        match self {\n            Which::C => \"C\",\n            Which::Rust => \"Rust\",\n        }\n    }\n}\n\n/// What the isolated child should do.\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct CrashCase {\n    pub which: Which,\n    /// `\"driver\"` or `\"fma\"`.\n    pub func: &'static str,\n    pub len: c_int,\n    /// Pass NULL for every pointer argument instead of a real buffer.\n    pub null_ptrs: bool,\n    /// Number of elements actually allocated when `null_ptrs` is false.\n    pub alloc: usize,\n}\n\n/// How the isolated child terminated.\n#[derive(Debug, PartialEq, Eq, Clone, Copy)]\npub enum Outcome {\n    /// Ran to completion with this exit code (0 == survived the call).\n    Exited(i32),\n    /// Killed by this signal (11 == SIGSEGV, 6 == SIGABRT, 4 == SIGILL).\n    Signaled(i32),\n    /// Still running when the deadline expired, so it was killed. Used for the\n    /// astronomically-large-`len` rows, where a surviving implementation would\n    /// print billions of lines.\n    TimedOut,\n}\n\npub const SIGSEGV: i32 = 11;\npub const SIGABRT: i32 = 6;\npub const SIGBUS: i32 = 7;\n\nconst CRASH_ENV: &str = \"DIFFTEST_CRASH_SPEC\";\npub const CRASH_WORKER_TEST_NAME: &str = \"zz_crash_worker\";\n\n/// Body of the `zz_crash_worker` test. No-op unless the env var is set.\npub fn crash_worker_main_if_requested() {\n    let Ok(spec) = std::env::var(CRASH_ENV) else {\n        return;\n    };\n    let parts: Vec<&str> = spec.split('|').collect();\n    assert_eq!(parts.len(), 5, \"bad crash spec {spec:?}\");\n    let which = parts[0];\n    let func = parts[1];\n    let len: c_int = parts[2].parse().expect(\"len\");\n    let null_ptrs = parts[3] == \"null\";\n    let alloc: usize = parts[4].parse().expect(\"alloc\");\n\n    let l = libs();\n    let imp = if which == \"C\" { &l.c } else { &l.rs };\n\n    unsafe {\n        // Send everything the call prints to /dev/null: these cases can print\n        // billions of lines and we only care about how the process terminates.\n        let devnull = std::ffi::CString::new(\"/dev/null\").unwrap();\n        let fd = open(devnull.as_ptr(), O_RDWR, 0 as c_int);\n        if fd >= 0 {\n            fflush(std::ptr::null_mut());\n            dup2(fd, 1);\n        }\n\n        if null_ptrs {\n            match func {\n                \"driver\" => (imp.driver)(std::ptr::null(), len),\n                \"fma\" => (imp.fma_array)(\n                    std::ptr::null_mut(),\n                    std::ptr::null(),\n                    std::ptr::null(),\n                    std::ptr::null(),\n                    len,\n                ),\n                _ => panic!(\"bad func {func}\"),\n            }\n        } else {\n            let mut buf: Vec<c_int> = vec![7; alloc.max(1)];\n            match func {\n                \"driver\" => (imp.driver)(buf.as_ptr(), len),\n                \"fma\" => {\n                    let p = buf.as_mut_ptr();\n                    (imp.fma_array)(p, p as *const c_int, p as *const c_int, p as *const c_int, len)\n                }\n                _ => panic!(\"bad func {func}\"),\n            }\n        }\n        fflush(std::ptr::null_mut());\n        _exit(0);\n    }\n}\n\n/// Runs one `CrashCase` in a fresh process and reports how it terminated.\npub fn run_crash_case(case: &CrashCase, timeout: std::time::Duration) -> Outcome {\n    use std::os::unix::process::ExitStatusExt;\n\n    let spec = format!(\n        \"{}|{}|{}|{}|{}\",\n        case.which.tag(),\n        case.func,\n        case.len,\n        if case.null_ptrs { \"null\" } else { \"valid\" },\n        case.alloc,\n    );\n    let exe = std::env::current_exe().expect(\"current_exe\");\n    let mut child = {\n        let _g = spawn_lock().lock().unwrap_or_else(|e| e.into_inner());\n        std::process::Command::new(&exe)\n            .args([\n                \"--exact\",\n                CRASH_WORKER_TEST_NAME,\n                \"--test-threads=1\",\n                \"--quiet\",\n            ])\n            .env(CRASH_ENV, &spec)\n            .stdout(std::process::Stdio::null())\n            .stderr(std::process::Stdio::null())\n            .spawn()\n            .expect(\"spawn crash worker\")\n    };\n\n    let deadline = std::time::Instant::now() + timeout;\n    loop {\n        match child.try_wait().expect(\"try_wait\") {\n            Some(status) => {\n                return if let Some(sig) = status.signal() {\n                    Outcome::Signaled(sig)\n                } else {\n                    Outcome::Exited(status.code().unwrap_or(-1))\n                };\n            }\n            None => {\n                if std::time::Instant::now() >= deadline {\n                    let _ = child.kill();\n                    let _ = child.wait();\n                    return Outcome::TimedOut;\n                }\n                std::thread::sleep(std::time::Duration::from_millis(5));\n            }\n        }\n    }\n}\n\n/// Convenience: run the same case against both libraries.\npub fn run_crash_both(\n    func: &'static str,\n    len: c_int,\n    null_ptrs: bool,\n    alloc: usize,\n    timeout: std::time::Duration,\n) -> (Outcome, Outcome) {\n    let mk = |which| CrashCase { which, func, len, null_ptrs, alloc };\n    (\n        run_crash_case(&mk(Which::C), timeout),\n        run_crash_case(&mk(Which::Rust), timeout),\n    )\n}\n\n/// True if the outcome is a hard fault (the shapes the C's UB takes).\npub fn is_fault(o: Outcome) -> bool {\n    matches!(o, Outcome::Signaled(SIGSEGV) | Outcome::Signaled(SIGBUS) | Outcome::Signaled(SIGABRT))\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3090,"cache_read_input_tokens":89146,"cache_creation":{"ephemeral_5m_input_tokens":3090,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ff8d49d8-2e6c-4767-9cd4-46061465867f","uuid":"49fb84af-9fef-4fa4-854f-453aa0802203","timestamp":"2026-09-05T04:42:14.035Z"}
