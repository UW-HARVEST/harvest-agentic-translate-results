\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n#![allow(non_snake_case)]\n\nuse core::ffi::{c_char, c_int};\n\n// The C source prints with `printf(\"%d\\n\", val)`. We call libc's printf\n// directly (rather than Rust's `println!`) so that the emitted bytes *and*\n// the stdio buffering/interleaving behaviour are identical to the C library.\nunsafe extern \"C\" {\n    #[link_name = \"printf\"]\n    safe_printf_shim: (),\n}\n\n// `unsafe extern` blocks cannot declare variadics with a nicer syntax, so\n// declare the C variadic function in its own block.\nunsafe extern \"C\" {\n    fn printf(fmt: *const c_char, ...) -> c_int;\n}\n\n/// `%d\\n` format string, NUL terminated, matching the C source exactly.\nstatic FMT: [c_char; 4] = [b'%' as c_char, b'd' as c_char, b'\\n' as c_char, 0];\n\n/*\nCount from a starting point,\nstopping when the count ends in 9 (base 10).\n*/\n#[unsafe(no_mangle)]\npub extern \"C\" fn sieve(val: c_int) {\n    let mut val = val;\n    loop {\n        unsafe {\n            printf(FMT.as_ptr(), val);\n        }\n        // C's `%` truncates toward zero, exactly like Rust's `%`, so negative\n        // inputs behave identically (e.g. -9 % 10 == -9, which is not 9).\n        if val % 10 == 9 {\n            break;\n        }\n        // Signed overflow is UB in C; in practice gcc/clang wrap on x86-64.\n        // Reproduce the wrapping behaviour instead of panicking.\n        val = val.wrapping_add(1);\n    }\n}\n","structuredPatch":[{"oldStart":31,"oldLines":13,"newStart":31,"newLines":6,"lines":[" // directly (rather than Rust's `println!`) so that the emitted bytes *and*"," // the stdio buffering/interleaving behaviour are identical to the C library."," unsafe extern \"C\" {","-    #[link_name = \"printf\"]","-    safe_printf_shim: (),","-}","-","-// `unsafe extern` blocks cannot declare variadics with a nicer syntax, so","-// declare the C variadic function in its own block.","-unsafe extern \"C\" {","     fn printf(fmt: *const c_char, ...) -> c_int;"," }"," "]}],"userModified":false,"replaceAll":false}}
