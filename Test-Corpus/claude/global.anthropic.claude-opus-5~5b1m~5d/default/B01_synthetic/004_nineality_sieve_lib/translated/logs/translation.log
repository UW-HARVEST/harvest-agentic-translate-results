 cannot declare variadics with a nicer syntax, so\n// declare the C variadic function in its own block.\nunsafe extern \"C\" {\n    fn printf(fmt: *const c_char, ...) -> c_int;\n}\n\n/// `%d\\n` format string, NUL terminated, matching the C source exactly.\nstatic FMT: [c_char; 4] = [b'%' as c_char, b'd' as c_char, b'\\n' as c_char, 0];\n\n/*\nCount from a starting point,\nstopping when the count ends in 9 (base 10).\n*/\n#[unsafe(no_mangle)]\npub extern \"C\" fn sieve(val: c_int) {\n    let mut val = val;\n    loop {\n        unsafe {\n            printf(FMT.as_ptr(), val);\n        }\n        // C's `%` truncates toward zero, exactly like Rust's `%`, so negative\n        // inputs behave identically (e.g. -9 % 10 == -9, which is not 9).\n        if val % 10 == 9 {\n            break;\n        }\n        // Signed overflow is UB in C; in practice gcc/clang wrap on x86-64.\n        // Reproduce the wrapping behaviour instead of panicking.\n        val = val.wrapping_add(1);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1359,"cache_read_input_tokens":16831,"cache_creation":{"ephemeral_5m_input_tokens":1359,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1eb97402-716e-4a3e-bc07-6f3a1bc95ea0","uuid":"5b5c9b20-db47-45e2-bd09-aeea95d81cd5","timestamp":"2026-08-28T09:08:40.254Z"}
