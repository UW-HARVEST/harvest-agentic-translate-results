= false;\n        cur = inp.next();\n        while let Some(b) = cur {\n            match hex_val(b) {\n                Some(d) => {\n                    any_digit = true;\n                    frac_seen = true;\n                    frac_count += 1;\n                    push(d, &mut mant, &mut sticky, &mut dropped_bits);\n                    cur = inp.next();\n                }\n                None => break,\n            }\n        }\n        if !any_digit {\n            // \"0x.\" with no digits at all: only the leading \"0\" is consumed.\n            inp.unget_opt(cur);\n            inp.unget_opt(save_dot);\n            inp.unget(b'x');\n            return if neg { -0.0 } else { 0.0 };\n        }\n        let _ = frac_seen;\n    }\n    if !any_digit {\n        // \"0x\" without hex digits: the subject sequence is just \"0\".\n        inp.unget_opt(cur);\n        inp.unget(b'x');\n        return if neg { -0.0 } else { 0.0 };\n    }\n\n    // Optional binary exponent, backtracked when no digits follow.\n    let mut pexp: i64 = 0;\n    if let Some(b) = cur {\n        if b == b'p' || b == b'P' {\n            let mut eaten: Vec<u8> = vec![b];\n            let mut c2 = inp.next();\n            let mut esign: i64 = 1;\n            if let Some(s) = c2 {\n                if s == b'+' || s == b'-' {\n                    eaten.push(s);\n                    if s == b'-' {\n                        esign = -1;\n                    }\n                    c2 = inp.next();\n                }\n            }\n            let mut have = false;\n            let mut value: i64 = 0;\n            while let Some(d) = c2 {\n                if d.is_ascii_digit() {\n                    have = true;\n                    eaten.push(d);\n                    if value < 1_000_000 {\n                        value = value * 10 + (d - b'0') as i64;\n                    }\n                    c2 = inp.next();\n                } else {\n                    break;\n                }\n            }\n            if !have {\n                inp.unget_opt(c2);\n                for &x in eaten.iter().rev() {\n                    inp.unget(x);\n                }\n            } else {\n                pexp = esign * value;\n                inp.unget_opt(c2);\n            }\n        } else {\n            inp.unget(b);\n        }\n    }\n\n    if mant == 0 {\n        return if neg { -0.0 } else { 0.0 };\n    }\n\n    let exp2 = pexp - 4 * frac_count + dropped_bits;\n    let bits = round_to_double(mant, sticky, exp2);\n    let v = f64::from_bits(bits);\n    if neg {\n        -v\n    } else {\n        v","numLines":120,"startLine":315,"totalLines":553}}}
