itions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include \"driver.h\"\n    25\t\n    26\t#include <stdio.h>\n    27\t#include <stdlib.h>\n    28\t#include <string.h>\n    29\t\n    30\tvoid printLine (const char * line)\n    31\t{\n    32\t    if(line != NULL) \n    33\t    {\n    34\t        printf(\"%s\\n\", line);\n    35\t    }\n    36\t}\n    37\t\n    38\tvoid driver(int data)\n    39\t{\n    40\t    char source[100];\n    41\t    char dest[100] = \"\";\n    42\t    memset(source, 'A', 100-1);\n    43\t    source[100-1] = '\\0';\n    44\t    if (data < 100)\n    45\t    {\n    46\t        strncpy(dest, source, data);\n    47\t        dest[data] = '\\0';\n    48\t    }\n    49\t    printLine(dest);\n    50\t}\n===== translation/Cargo.toml =====\n     1\t[package]\n     2\tname = \"driver\"\n     3\tversion = \"0.1.0\"\n     4\tedition = \"2024\"\n     5\t\n     6\t[lib]\n     7\tname = \"driver\"\n     8\tpath = \"src/lib.rs\"\n     9\tcrate-type = [\"cdylib\"]\n    10\t\n    11\t[profile.release]\n    12\tpanic = \"abort\"\n    13\t\n    14\t[workspace]\n===== translation/src/lib.rs =====\n     1\t// Rust translation of the C library in c_src/.\n     2\t//\n     3\t// Original copyright header from the C sources:\n     4\t//\n     5\t// Copyright 2025 MIT Lincoln Laboratory\n     6\t// Permission is hereby granted, free of charge,\n     7\t// to any person obtaining a copy of this software\n     8\t// and associated documentation files (the \"Software\"),\n     9\t// to deal in the Software without restriction,\n    10\t// including without limitation the rights to use, copy,\n    11\t// modify, merge, publish, distribute, sublicense,\n    12\t// and/or sell copies of the Software,\n    13\t// and to permit persons to whom the Software is furnished to do so,\n    14\t// subject to the following conditions:\n    15\t//\n    16\t// The above copyright notice and this permission notice\n    17\t// shall be included in all copies or substantial portions of the Software.\n    18\t//\n    19\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    20\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    21\t// THE WARRANTIES OF MERCHANTABILITY,\n    22\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    23\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    24\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    25\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    26\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    27\t\n    28\t#![allow(non_snake_case)]\n    29\t\n    30\tuse std::ffi::{c_char, c_int, c_void};\n    31\t\n    32\t// libc declarations. The C library writes its output through the C runtime's\n    33\t// `stdout`, so we go through the very same `printf` in order to keep the\n    34\t// byte stream (and its buffering behaviour) identical.\n    35\tunsafe extern \"C\" {\n    36\t    fn printf(fmt: *const c_char, ...) -> c_int;\n    37\t    fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n    38\t    fn strncpy(dst: *mut c_char, src: *const c_char, n: usize) -> *mut c_char;\n    39\t}\n    40\t\n    41\t/// Translation of:\n    42\t/// ```c\n    43\t/// void printLine (const char *