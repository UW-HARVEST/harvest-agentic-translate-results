T.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include \"driver.h\"\n    25\t\n    26\t#include <stdint.h>\n    27\t#include <stdio.h>\n    28\t\n    29\ttypedef union {\n    30\t    uint64_t x;\n    31\t    double f;\n    32\t} raw_double_t;\n    33\t\n    34\tvoid driver(double f) {\n    35\t    raw_double_t u = {.f = f};\n    36\t    printf(\"%llx %a %.4f\\n\", u.x, f, f);\n    37\t}=============== translation/Cargo.toml ===============\n     1\t[package]\n     2\tname = \"driver\"\n     3\tversion = \"0.1.0\"\n     4\tedition = \"2021\"\n     5\t\n     6\t[lib]\n     7\tname = \"driver\"\n     8\tpath = \"src/lib.rs\"\n     9\tcrate-type = [\"cdylib\"]\n    10\t\n    11\t[profile.release]\n    12\tpanic = \"abort\"\n    13\t\n    14\t[workspace]\n=============== translation/src/lib.rs ===============\n     1\t// Rust translation of the MIT Lincoln Laboratory `driver` C library.\n     2\t//\n     3\t// Original C library (c_src/):\n     4\t//   * include/driver.h  -- declares `void driver(double f);`\n     5\t//   * src/driver.c      -- defines it as:\n     6\t//\n     7\t//         typedef union { uint64_t x; double f; } raw_double_t;\n     8\t//\n     9\t//         void driver(double f) {\n    10\t//             raw_double_t u = {.f = f};\n    11\t//             printf(\"%llx %a %.4f\\n\", u.x, f, f);\n    12\t//         }\n    13\t//\n    14\t// The complete public ABI of the C shared library consists of the single\n    15\t// exported symbol `driver` (verified with `nm -D` on the CMake-built\n    16\t// libdriver.so). No namespace-renaming preprocessor macros are present in the\n    17\t// public header, so the linker symbol is plainly `driver`.\n    18\t//\n    19\t// Byte-identical output requirement\n    20\t// --------------------------------\n    21\t// The C code hands three conversions to the platform's `printf`:\n    22\t//   * `%llx`  -- the raw IEEE-754 bit pattern of the double, as hex\n    23\t//   * `%a`    -- the C99 hexadecimal-float form of the double\n    24\t//   * `%.4f`  -- fixed-point with four fractional digits\n    25\t//\n    26\t// `%a` and `%.4f` are exquisitely implementation-defined at the margins\n    27\t// (glibc trims trailing mantissa zeros for `%a`, renders subnormals with a\n    28\t// leading `0x0.` digit and a `p-1022` exponent, spells non-finite values as\n    29\t// `inf`/`-inf`/`nan`/`-nan` following the sign bit, and rounds `%.4f` off the\n    30\t// *exact* binary value using the current rounding mode -- round-half-to-even\n    31\t// at ties). Rather than re-deriving all of that, this translation delegates\n    32\t// the formatting to the very same libc `printf` the C library calls. That also\n    33\t// keeps stdout buffering, locale handling, and interleaving with any C caller's\n    34\t// own output bit-for-bit identical.\n    35\t\n    36\t#![allow(non_camel_case_types)]\n    37\t\n    38\tuse std::ffi::{c_char, c_int, c_uint};\n    39\t\n    40\textern \"C\" {\n    41\t    /// The platform `printf` from libc, which Rust's std already links.\n    42\t    fn printf(fmt: *const c_char, ...) -> c_int;\n    43\t}\n    44\t\n    45\t/// Mirror of the C translation unit's `raw_double_t`:\n    46\t///\n    47\t/// ```c\n    48\t/// typedef union {\n    49\t///     uint64_t x;\n    50\t///     double f;\n    51\t/// } raw_double_t;\n    52\t/// ```\n    53\t///\n    54\t/// Written to through the `.f` member and read back through `.x`, i.e. a\n    55\t/// straight type-pun of the double's storage bytes. On every target this\n    56\t/// library builds for, `double` and `uint64_t` are both 8 bytes with identical\n    57\t/// alignment, so the read is fully initialized and endianness-faithful --\n    58\t/// exactly what `f64::to_bits` gives us.\n    59\t#[repr(C)]\n    60\tunion raw_double_t {\n    61\t    x: u64,\n    62\t    f: f64,\n    63\t}\n    64\t\n    65\timpl raw_double_t {\n    66\t    /// `raw_double_t u = {.f = f};` followed by reading `u.x`.\n    67\t    #[inline]\n    68\t    fn from_f64(f: f64) -> Self {\n    69\t        raw_double_t { f }\n    70\t    }\n    71\t\n    72\t    #[inline]\n    73\t    fn bits(&self) -> u64 {\n    74\t        // Safe in practice: `f` occupies all 8 bytes of the union, so no\n    75\t        // padding is observed. Equivalent to the C `u.x` read.\n    76\t        unsafe { self.x }\n    77\t    }\n    78\t}\n    79\t\n    80\t/// The format string handed to `printf`, NUL-terminated for C.\n    81\t///\n    82\t/// `%llx` consumes an `unsigned long long`; `%a` and `%.4f` each consume a\n    83\t/// `double`. The variadic call below passes `u64` and `f64`, which match those\n    84\t/// C types on all supported platforms (`unsigned long long` is 64-bit\n    85\t/// everywhere Rust targets, and varargs promote `f64` to `double`\n    86\t/// unchanged).\n    87\tconst FMT: &[u8] = b\"%llx %a %.4f\\n\\0\";\n    88\t\n    89\t/// `void driver(double f);`\n    90\t///\n    91\t/// Prints the double's raw bit pattern, its hexadecimal-float form, and its\n    92\t/// fixed-point form with four fractional digits, separated by spaces and\n    93\t/// terminated by a newline.\n    94\t#[unsafe(no_mangle)]\n    95\tpub extern \"C\" fn driver(f: f64) {\n    96\t    let u = raw_double_t::from_f64(f);\n    97\t    let bits = u.bits();\n    98\t\n    99\t    // The C code's `printf` return value is discarded; do likewise.\n   100\t    unsafe {\n   101\t        printf(FMT.as_ptr() as *const c_char, bits, f, f);\n   102\t    }\n   103\t}\n   104\t\n   105\t// ---------------------------------------------------------------------------\n   106\t// A note on why `%llx` is passed a `u64` and not a `c_ulonglong` cast:\n   107\t// `c_ulonglong`