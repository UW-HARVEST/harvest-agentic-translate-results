itespace variants (tabs, CRLF, vertical tab/formfeed), negatives, `+` signs, junk-terminated input, `0x10`, leading zeros, bare `-`, `--5`, exactly 100 / 150 values, and overflow cases (`2147483648`, `LONG_MAX`, `LONG_MIN`, `LONG_MIN-1`, 30-digit values).\n- 400-case randomized fuzz comparing stdout and exit codes: 0 mismatches.\n\nTest binaries were removed afterward; `c_src/` is untouched."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":349,"cache_read_input_tokens":24949,"cache_creation":{"ephemeral_5m_input_tokens":349,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"08447f21-e5df-40e9-9bef-272faaffe9ff","uuid":"9186343c-1d81-41c8-a6b2-247ab4d1a13c","timestamp":"2026-08-28T15:08:53.158Z"}
