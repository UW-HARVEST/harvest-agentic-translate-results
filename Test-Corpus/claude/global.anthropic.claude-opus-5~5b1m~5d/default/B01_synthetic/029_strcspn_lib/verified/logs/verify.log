      assert_eq!(r.stdout, format!(\"{}\\n\", n - 1).into_bytes());","     }","+}"," ","-    eprintln!(\"--- s1 access order ---\");","-    // s1 unterminated with reject sets of length 0, 1, 2, 3 (glibc switches","-    // algorithm at reject length 2).","-    for m in 0..4usize {","+/// An unterminated `s1` still dies once the reject set is valid, for reject","+/// lengths on both sides of glibc's internal algorithm switch (0/1 vs >= 2).","+#[test]","+fn order_unterminated_s1_faults_for_every_reject_length() {","+    for m in 0..6usize {","         let s2 = CBuf::new(&vec![b'Z'; m]);","         let u = UnterminatedString::new(&vec![b'a'; 64]);","-        show(&format!(\"s1=unterminated(64)  s2=len {m}\"), u.ptr(), s2.ptr());","+        let r = both(u.ptr(), s2.ptr(), \"unterminated s1\");","+        assert_eq!(","+            r.outcome,","+            Outcome::Signaled(libc::SIGSEGV),","+            \"unterminated s1 should fault (reject len {m})\"","+        );","     }","-    // s1 = NULL with reject sets of length 0,1,2,3","-    for m in 0..4usize {","+}","+","+/// A NULL `s1` faults for every reject length, once `s2` has been consumed.","+#[test]","+fn order_null_s1_faults_for_every_reject_length() {","+    for m in 0..6usize {","         let s2 = CBuf::new(&vec![b'Z'; m]);","-        show(&format!(\"s1=NULL              s2=len {m}\"), nul, s2.ptr());","+        let r = both(NULLP, s2.ptr(), \"s1=NULL\");","+        assert_eq!(","+            r.outcome,","+            Outcome::Signaled(libc::SIGSEGV),","+            \"NULL s1 should fault (reject len {m})\"","+        );","     }","-","-    eprintln!(\"--- both degenerate ---\");","-    show(\"s1=NULL     s2=NULL\", nul, nul);","+    let r = both(NULLP, NULLP, \"both NULL\");","+    assert_eq!(r.outcome, Outcome::Signaled(libc::SIGSEGV));"," }"]}],"originalFile":"//! Temporary probe: determines the C implementation's argument-access ORDER\n//! empirically (which pointer is dereferenced first, and how much of it).\n//! Run with:  cargo test --test zz_probe -- --nocapture --test-threads=1\n\nmod common;\n\nuse common::*;\nuse std::ffi::c_char;\n\nfn show(name: &str, s1: *const c_char, s2: *const c_char) {\n    let c = fork_c(s1, s2);\n    let r = fork_rust(s1, s2);\n    eprintln!(\n        \"{name:<52} C={:?} out={:?}   RUST={:?} out={:?}   {}\",\n        c.outcome,\n        String::from_utf8_lossy(&c.stdout),\n        r.outcome,\n        String::from_utf8_lossy(&r.stdout),\n        if c.outcome == r.outcome && c.stdout == r.stdout {\n            \"SAME\"\n        } else {\n            \"**DIFFER**\"\n        }\n    );\n}\n\n#[test]\nfn probe() {\n    let empty = CBuf::new(b\"\");\n    let abc = CBuf::new(b\"abc\");\n    let nul: *const c_char = std::ptr::null();\n\n    eprintln!(\"--- s2 access order ---\");\n    show(\"s1=\\\"\\\"      s2=NULL\", empty.ptr(), nul);\n    show(\"s1=\\\"abc\\\"   s2=NULL\", abc.ptr(), nul);\n\n    // s2 unterminated, various lengths: does an empty s1 still fault?\n    for &n in &[1usize, 2, 3, 4096] {\n        let u = UnterminatedString::new(&vec![b'x'; n]);\n        show(&format!(\"s1=\\\"\\\"      s2=unterminated({n})\"), empty.ptr(), u.ptr());\n    }\n    for &n in &[1usize, 2, 3, 4096] {\n        let u = UnterminatedString::new(&vec![b'q'; n]);\n        show(&format!(\"s1=\\\"abc\\\"   s2=unterminated({n})\"), abc.ptr(), u.ptr());\n    }\n\n    // s2 properly terminated at a guard page, with EMPTY s1: how far is s2 read?\n    for n in 0..5usize {\n        let g = GuardedString::new(&vec![b'x'; n]);\n        show(&format!(\"s1=\\\"\\\"      s2=guarded(len {n})\"), empty.ptr(), g.ptr());\n    }\n\n    eprintln!(\"--- s1 access order ---\");\n    // s1 unterminated with reject sets of length 0, 1, 2, 3 (glibc switches\n    // algorithm at reject length 2).\n    for m in 0..4usize {\n        let s2 = CBuf::new(&vec![b'Z'; m]);\n        let u = UnterminatedString::new(&vec![b'a'; 64]);\n        show(&format!(\"s1=unterminated(64)  s2=len {m}\"), u.ptr(), s2.ptr());\n    }\n    // s1 = NULL with reject sets of length 0,1,2,3\n    for m in 0..4usize {\n        let s2 = CBuf::new(&vec![b'Z'; m]);\n        show(&format!(\"s1=NULL              s2=len {m}\"), nul, s2.ptr());\n    }\n\n    eprintln!(\"--- both degenerate ---\");\n    show(\"s1=NULL     s2=NULL\", nul, nul);\n}\n","userModified":false}}
