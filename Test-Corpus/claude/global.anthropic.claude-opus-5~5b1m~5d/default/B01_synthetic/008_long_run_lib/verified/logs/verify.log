{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_kvxmejxe3kxpoe2y7wzfx6qoeuwealdf2xwafnfxzjc5rurbhcfa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01KkL4uy2esex93n66bgAAT8","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-JEGIvd/translation/tests/long_exec_full.rs","content":"//! Full end-to-end `long_exec` differential tests (CONFIGS.md rows 17-20,\n//! ERRORS.md rows 1-7).\n//!\n//! A single `long_exec` call is `2000 * 262144 * 100 ~= 5.2e10` inner steps:\n//! about 470 s in the C build and 56 s in the Rust build. Every test here is\n//! therefore `#[ignore]`d and run explicitly, and each test runs its C and its\n//! Rust side on two threads so a test's wall time stays near the C cost.\n//!\n//! Two comparison strategies are used, both exact:\n//!  * `endtoend_*`  - compare the final 1 MiB `array` byte-for-byte. Since\n//!    `xor_result` is a pure fold over that array and both libraries call the\n//!    very same glibc `printf`, identical arrays imply an identical printed\n//!    line. These can run in parallel.\n//!  * `capture_*`   - actually redirect fd 1 and capture the printed bytes.\n//!    fd 1 is process-wide, so these must run one at a time\n//!    (`--test-threads=1`); they persist the captured line under\n//!    `target/long_cache/` and `compare_captured_lines` diffs the cache.\n\nmod common;\n\nuse common::*;\n\nfn cache_dir() -> std::path::PathBuf {\n    let d = std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n        .join(\"target\")\n        .join(\"long_cache\");\n    std::fs::create_dir_all(&d).expect(\"create cache dir\");\n    d\n}\n\n/// Run `long_exec(seed)` on both libraries (in parallel) and compare the\n/// resulting global `array` byte-for-byte.\nfn endtoend(seed: u32, poison: bool, what: &str) {\n    let c = Impl::c();\n    let r = Impl::rust();\n\n    if poison {\n        // CONFIGS 20 / ERRORS 7: deliberately dirty every element first. If\n        // `long_exec`'s `rand()` fill missed even one slot, the result would\n        // differ from the clean run - and `endtoend_seed42_clean` records that.\n        let mut rng = Rng::new(0xDEAD_BEEF_0BAD_F00D);\n        let dirt: Vec<i32> = (0..ARRAY_SIZE).map(|_| rng.hard_i32()).collect();\n        c.set_array(&dirt);\n        r.set_array(&dirt);\n    }\n\n    let cp = c.long_exec_addr as usize;\n    let rp = r.long_exec_addr as usize;\n    let hc = std::thread::spawn(move || unsafe {\n        let f: unsafe extern \"C\" fn(u32) = std::mem::transmute(cp);\n        f(seed)\n    });\n    let hr = std::thread::spawn(move || unsafe {\n        let f: unsafe extern \"C\" fn(u32) = std::mem::transmute(rp);\n        f(seed)\n    });\n    hc.join().expect(\"C long_exec panicked\");\n    hr.join().expect(\"Rust long_exec panicked\");\n\n    assert_arrays_eq(&c, &r, what);\n\n    // Record the xor fold (== the value the library prints) for cross-checking.\n    let xor = c.array().iter().fold(0i32, |a, &b| a ^ b);\n    let rxor = r.array().iter().fold(0i32, |a, &b| a ^ b);\n    assert_eq!(xor, rxor, \"{what}: xor fold\");\n    std::fs::write(cache_dir().join(format!(\"xor_{what}.txt\")), format!(\"{xor}\\n\")).unwrap();\n}\n\n// ------------------------------------------------- CONFIGS 17 / ERRORS 1\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_0() {\n    endtoend(0, false, \"seed_0\");\n}\n\n// ------------------------------------------------- ERRORS 2\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_1() {\n    endtoend(1, false, \"seed_1\");\n}\n\n// ------------------------------------------------- CONFIGS 18\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_42_clean() {\n    endtoend(42, false, \"seed_42_clean\");\n}\n\n// ------------------------------------------------- CONFIGS 20 / ERRORS 7\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_42_poisoned_array() {\n    endtoend(42, true, \"seed_42_poisoned\");\n}\n\n// ------------------------------------------------- ERRORS 5\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_int_max() {\n    endtoend(0x7FFF_FFFF, false, \"seed_int_max\");\n}\n\n// ------------------------------------------------- CONFIGS 19 / ERRORS 4\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_0x80000000() {\n    endtoend(0x8000_0000, false, \"seed_0x80000000\");\n}\n\n// ------------------------------------------------- CONFIGS 19 / ERRORS 3\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_uint_max() {\n    endtoend(0xFFFF_FFFF, false, \"seed_uint_max\");\n}\n\n// ------------------------------------------------- ERRORS 6 (reference run)\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_7() {\n    endtoend(7, false, \"seed_7\");\n}\n\n// ------------------------------------------------- ERRORS 6\n/// The ABI parameter is 32-bit, so a 64-bit value with garbage in the high\n/// half must behave exactly like its low 32 bits. Called through a\n/// deliberately mis-shaped `fn(u64, u64, u64)` pointer so the extra argument\n/// registers carry junk as well.\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_garbage_high_bits() {\n    let c = Impl::c();\n    let r = Impl::rust();\n    const JUNK_SEED: u64 = 0xDEAD_BEEF_0000_0007;\n\n    let cp = c.long_exec_addr as usize;\n    let rp = r.long_exec_addr as usize;\n    let hc = std::thread::spawn(move || unsafe {\n        let f: unsafe extern \"C\" fn(u64, u64, u64) -> i64 = std::mem::transmute(cp);\n        f(JUNK_SEED, u64::MAX, 0xA5A5_A5A5_A5A5_A5A5)\n    });\n    let hr = std::thread::spawn(move || unsafe {\n        let f: unsafe extern \"C\" fn(u64, u64, u64) -> i64 = std::mem::transmute(rp);\n        f(JUNK_SEED, u64::MAX, 0xA5A5_A5A5_A5A5_A5A5)\n    });\n    hc.join().unwrap();\n    hr.join().unwrap();\n\n    assert_arrays_eq(&c, &r, \"seed_garbage_high_bits\");\n    let xor = c.array().iter().fold(0i32, |a, &b| a ^ b);\n    std::fs::write(\n        cache_dir().join(\"xor_seed_garbage_high_bits.txt\"),\n        format!(\"{xor}\\n\"),\n    )\n    .unwrap();\n}\n\n/// ERRORS 6 cross-check: the garbage-high-bits run must equal the plain\n/// `seed = 7` run. Cheap; requires the two expensive tests above to have run.\n#[test]\nfn errors06_garbage_high_bits_equals_seed_7() {\n    let d = cache_dir();\n    let a = d.join(\"xor_seed_7.txt\");\n    let b = d.join(\"xor_seed_garbage_high_bits.txt\");\n    if !a.exists() || !b.exists() {\n        eprintln!(\n            \"SKIP: run `cargo test --release --test long_exec_full -- --ignored \\\n             endtoend_seed_7 endtoend_seed_garbage_high_bits` first\"\n        );\n        return;\n    }\n    assert_eq!(\n        std::fs::read_to_string(&a).unwrap(),\n        std::fs::read_to_string(&b).unwrap(),\n        \"long_exec(0xDEADBEEF_00000007) must equal long_exec(7): the high 32 bits \\\n         of the seed register must be ignored\"\n    );\n}\n\n// --------------------------------------------------------- stdout capture\nfn capture(which: &str, seed: u32) {\n    let imp = match which {\n        \"c\" => Impl::c(),\n        \"rust\" => Impl::rust(),\n        _ => unreachable!(),\n    };\n    let out = unsafe { imp.long_exec_capture(seed) };\n    assert!(!out.is_empty(), \"{which}: long_exec printed nothing\");\n    let path = cache_dir().join(format!(\"stdout_{which}_{seed}.bin\"));\n    std::fs::write(&path, &out).unwrap();\n    eprintln!(\n        \"{which} seed {seed} stdout = {:?} ({} bytes) -> {}\",\n        String::from_utf8_lossy(&out),\n        out.len(),\n        path.display()\n    );\n}\n\n#[test]\n#[ignore = \"~470 s; run with --ignored --test-threads=1\"]\nfn capture_c_seed_42() {\n    capture(\"c\", 42);\n}\n\n#[test]\n#[ignore = \"~56 s; run with --ignored --test-threads=1\"]\nfn capture_rust_seed_42() {\n    capture(\"rust\", 42);\n}\n\n#[test]\n#[ignore = \"~470 s; run with --ignored --test-threads=1\"]\nfn capture_c_seed_0() {\n    capture(\"c\", 0);\n}\n\n#[test]\n#[ignore = \"~56 s; run with --ignored --test-threads=1\"]\nfn capture_rust_seed_0() {\n    capture(\"rust\", 0);\n}\n\n/// Byte-for-byte comparison of what the two libraries actually wrote to\n/// stdout, plus a cross-check against the independently computed xor fold.\n#[test]\nfn compare_captured_stdout() {\n    let d = cache_dir();\n    let mut checked = 0;\n    for (seed, xor_name) in [(42u32, \"xor_seed_42_clean\"), (0, \"xor_seed_0\")] {\n        let cf = d.join(format!(\"stdout_c_{seed}.bin\"));\n        let rf = d.join(format!(\"stdout_rust_{seed}.bin\"));\n        if !cf.exists() || !rf.exists() {\n            continue;\n        }\n        let cb = std::fs::read(&cf).unwrap();\n        let rb = std::fs::read(&rf).unwrap();\n        assert_eq!(\n            cb,\n            rb,\n            \"seed {seed}: stdout differs\\n  C    = {:?}\\n  Rust = {:?}\",\n            String::from_utf8_lossy(&cb),\n            String::from_utf8_lossy(&rb)\n        );\n        let xf = d.join(format!(\"{xor_name}.txt\"));\n        if xf.exists() {\n            let expect = std::fs::read_to_string(&xf).unwrap();\n            assert_eq!(\n                String::from_utf8_lossy(&cb).trim(),\n                expect.trim(),\n                \"seed {seed}: printed value must equal the xor fold of the final array\"\n            );\n        }\n        checked += 1;\n    }\n    if checked == 0 {\n        eprintln!(\n            \"SKIP: no captures on disk; run `cargo test --release --test long_exec_full -- \\\n             --ignored --test-threads=1 capture_`\"\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":932,"cache_read_input_tokens":57993,"cache_creation":{"ephemeral_5m_input_tokens":932,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"cf2474fc-ee4d-4cff-8bf1-68a79c5ae5a9","uuid":"1e80580e-a8c3-4577-9bbc-3c508bedf392","timestamp":"2026-09-05T03:09:19.557Z"}
