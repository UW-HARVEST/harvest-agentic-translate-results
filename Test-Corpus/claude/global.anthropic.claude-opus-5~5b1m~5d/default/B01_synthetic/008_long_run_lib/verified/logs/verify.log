}_seed_7_junk_abi.bin\")));\n        let (plain, junk) = match (plain, junk) {\n            (Some(a), Some(b)) => (a, b),\n            _ => {\n                eprintln!(\"SKIP {which}: recordings missing - run ./record_long_exec.sh\");\n                continue;\n            }\n        };\n        assert_eq!(\n            plain, junk,\n            \"{which}: long_exec(0xDEADBEEF_00000007) must equal long_exec(7) - \\\n             the high 32 bits of the seed register must be ignored\"\n        );\n        let po = std::fs::read(d.join(format!(\"out_{which}_seed_7.bin\"))).unwrap();\n        let jo = std::fs::read(d.join(format!(\"out_{which}_seed_7_junk_abi.bin\"))).unwrap();\n        assert_eq!(po, jo, \"{which}: junk-ABI stdout differs from plain seed 7\");\n    }\n}\n\n/// CONFIGS 20 / ERRORS 7: a caller-dirtied `array` must not affect the result -\n/// `long_exec` overwrites every element from `rand()`. Holds per library, and\n/// the poisoned runs are already diffed C-vs-Rust above.\n#[test]\nfn configs20_errors07_dirty_array_does_not_affect_result() {\n    let d = cache_dir();\n    for which in [\"c\", \"rust\"] {\n        let clean = read_if(&d.join(format!(\"arr_{which}_seed_42.bin\")));\n        let poisoned = read_if(&d.join(format!(\"arr_{which}_seed_42_poisoned.bin\")));\n        let (clean, poisoned) = match (clean, poisoned) {\n            (Some(a), Some(b)) => (a, b),\n            _ => {\n                eprintln!(\"SKIP {which}: recordings missing - run ./record_long_exec.sh\");\n                continue;\n            }\n        };\n        assert_eq!(\n            clean, poisoned,\n            \"{which}: long_exec(42) result depends on the prior contents of `array` \\\n             (the rand() fill must cover all {ARRAY_SIZE} elements)\"\n        );\n    }\n}\n\n/// Distinct seeds must give distinct results - proves the tests are not all\n/// passing on some degenerate constant output.\n#[test]\nfn recorded_results_are_seed_dependent() {\n    let d = cache_dir();\n    let mut seen = std::collections::BTreeMap::new();\n    for tag in [\"seed_0\", \"seed_1\", \"seed_42\", \"seed_int_max\", \"seed_uint_max\"] {\n        if let Some(o) = read_if(&d.join(format!(\"out_c_{tag}.bin\"))) {\n            seen.insert(tag, String::from_utf8_lossy(&o).trim().to_string());\n        }\n    }\n    if seen.len() < 2 {\n        eprintln!(\"SKIP: not enough recordings\");\n        return;\n    }\n    let vals: std::collections::BTreeSet<_> = seen.values().collect();\n    assert!(\n        vals.len() > 1,\n        \"every seed produced the same output {seen:?} - the harness is not really \\\n         driving the library\"\n    );\n}\n","structuredPatch":[{"oldStart":2,"oldLines":24,"newStart":2,"newLines":30,"lines":[" //! ERRORS.md rows 1-7)."," //!"," //! A single `long_exec` call is `2000 * 262144 * 100 ~= 5.2e10` inner steps:","-//! about 470 s in the C build and 56 s in the Rust build. Every test here is","-//! therefore `#[ignore]`d and run explicitly, and each test runs its C and its","-//! Rust side on two threads so a test's wall time stays near the C cost.","+//! ~470 s in the C build, ~56 s in the Rust build. So every expensive test is","+//! `#[ignore]`d, records its result under `target/long_cache/`, and the cheap","+//! always-on tests at the bottom diff those recordings."," //!","-//! Two comparison strategies are used, both exact:","-//!  * `endtoend_*`  - compare the final 1 MiB `array` byte-for-byte. Since","-//!    `xor_result` is a pure fold over that array and both libraries call the","-//!    very same glibc `printf`, identical arrays imply an identical printed","-//!    line. These can run in parallel.","-//!  * `capture_*`   - actually redirect fd 1 and capture the printed bytes.","-//!    fd 1 is process-wide, so these must run one at a time","-//!    (`--test-threads=1`); they persist the captured line under","-//!    `target/long_cache/` and `compare_captured_lines` diffs the cache.","+//! IMPORTANT — why one `long_exec` per process:","+//! `long_exec` calls glibc `srand`/`rand`, whose state is a single","+//! process-global. Two `long_exec` calls running concurrently (even in","+//! different `.so`s — they share the one libc) interleave their `rand()` draws","+//! and produce garbage. Every recorder test therefore performs exactly ONE","+//! `long_exec`, guarded by a process-wide mutex, and the C side and the Rust","+//! side of a comparison are run in SEPARATE PROCESSES, communicating through","+//! the on-disk recordings. Run them with `--test-threads=1`.","+//!","+//! Driver: `./record_long_exec.sh` (repo root) launches all recorders and then","+//! the comparison."," "," mod common;"," "," use common::*;","+use std::sync::Mutex;"," ","+/// Serializes every `long_exec` in this process (glibc PRNG is global state).","+static PRNG: Mutex<()> = Mutex::new(());","+"," fn cache_dir() -> std::path::PathBuf {","     let d = std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))","         .join(\"target\")"]},{"oldStart":28,"oldLines":235,"newStart":34,"newLines":294,"lines":["     d"," }"," ","-/// Run `long_exec(seed)` on both libraries (in parallel) and compare the","-/// resulting global `array` byte-for-byte.","-fn endtoend(seed: u32, poison: bool, what: &str) {","-    let c = Impl::c();","-    let r = Impl::rust();","+/// Everything one recorder writes: the final 1 MiB `array` and the bytes the","+/// library actually printed to fd 1.","+fn record(which: &'static str, tag: &str, seed: u32, poison: bool, junk_abi: bool) {","+    let _g = PRNG.lock().unwrap();","+    let imp = match which {","+        \"c\" => Impl::c(),","+        \"rust\" => Impl::rust(),","+        _ => unreachable!(),","+    };"," ","     if poison {","-        // CONFIGS 20 / ERRORS 7: deliberately dirty every element first. If","-        // `long_exec`'s `rand()` fill missed even one slot, the result would","-        // differ from the clean run - and `endtoend_seed42_clean` records that.","+        // CONFIGS 20 / ERRORS 7: dirty every element first. `long_exec` must","+        // overwrite all of them from `rand()`, so the recording has to come out","+        // identical to the clean run for the same seed.","         let mut rng = Rng::new(0xDEAD_BEEF_0BAD_F00D);","         let dirt: Vec<i32> = (0..ARRAY_SIZE).map(|_| rng.hard_i32()).collect();","-        c.set_array(&dirt);","-        r.set_array(&dirt);","+        imp.set_array(&dirt);","     }"," ","-    let cp = c.long_exec_addr as usize;","-    let rp = r.long_exec_addr as usize;","-    let hc = std::thread::spawn(move || unsafe {","-        let f: unsafe extern \"C\" fn(u32) = std::mem::transmute(cp);","-        f(seed)","-    });","-    let hr = std::thread::spawn(move || unsafe {","-        let f: unsafe extern \"C\" fn(u32) = std::mem::transmute(rp);","-        f(seed)","-    });","-    hc.join().expect(\"C long_exec panicked\");","-    hr.join().expect(\"Rust long_exec panicked\");","+    let out = unsafe {","+        capture_stdout(|| {","+            if junk_abi {","+                // ERRORS 6: the ABI parameter is 32-bit. Call through a","+                // deliberately mis-shaped pointer so the high half of the seed","+                // register and the extra argument registers all carry junk.","+                let f: unsafe extern \"C\" fn(u64, u64, u64) -> i64 =","+                    std::mem::transmute(imp.long_exec_addr);","+                f(","+                    0xDEAD_BEEF_0000_0000u64 | seed as u64,","+                    u64::MAX,","+                    0xA5A5_A5A5_A5A5_A5A5,","+                );","+            } else {","+                imp.long_exec(seed);","+            }","+        })","+    };"," ","-    assert_arrays_eq(&c, &r, what);","-","-    // Record the xor fold (== the value the library prints) for cross-checking.","-    let xor = c.array().iter().fold(0i32, |a, &b| a ^ b);","-    let rxor = r.array().iter().fold(0i32, |a, &b| a ^ b);","-    assert_eq!(xor, rxor, \"{what}: xor fold\");","-    std::fs::write(cache_dir().join(format!(\"xor_{what}.txt\")), format!(\"{xor}\\n\")).unwrap();","+    let d = cache_dir();","+    std::fs::write(d.join(format!(\"arr_{which}_{tag}.bin\")), imp.array_bytes()).unwrap();","+    std::fs::write(d.join(format!(\"out_{which}_{tag}.bin\")), &out).unwrap();","+    eprintln!(","+        \"recorded {which}/{tag}: stdout = {:?}\",","+        String::from_utf8_lossy(&out)","+    );"," }"," ","-// ------------------------------------------------- CONFIGS 17 / ERRORS 1","-#[test]","-#[ignore = \"~470 s; run with --ignored\"]","-fn endtoend_seed_0() {","-    endtoend(0, false, \"seed_0\");","+macro_rules! recorders {","+    ($( $tag:ident : seed=$seed:expr, poison=$poison:expr, junk=$junk:expr ; )*) => {","+        $(","+            pastey_c!{$tag, $seed, $poison, $junk}","+        )*","+    };"," }","-","-// ------------------------------------------------- ERRORS 2","-#[test]","-#[ignore = \"~470 s; run with --ignored\"]","-fn endtoend_seed_1() {","-    endtoend(1, false, \"seed_1\");","+// (no proc-macro deps available offline: the recorders are spelled out below)","+macro_rules! pastey_c {","+    ($tag:ident, $seed:expr, $poison:expr, $junk:expr) => {};"," }","+recorders! {}"," ","-// ------------------------------------------------- CONFIGS 18","-#[test]","-#[ignore = \"~470 s; run with --ignored\"]","-fn endtoend_seed_42_clean() {","-    endtoend(42, false, \"seed_42_clean\");","-}","+// ---------------------------------------------------------------------------","+// Recorders. Tags mirror CONFIGS.md / ERRORS.md rows.","+// ---------------------------------------------------------------------------"," ","-// ------------------------------------------------- CONFIGS 20 / ERRORS 7","-#[test]","-#[ignore = \"~470 s; run with --ignored\"]","-fn endtoend_seed_42_poisoned_array() {","-    endtoend(42, true, \"seed_42_poisoned\");","+macro_rules! pair {","+    ($cname:ident, $rname:ident, $tag:literal, $seed:expr, $poison:expr, $junk:expr) => {","+        #[test]","+        #[ignore = \"~470 s; run one per process with --ignored --test-threads=1\"]","+        fn $cname() {","+            record(\"c\", $tag, $seed, $poison, $junk);","+        }","+        #[test]","+        #[ignore = \"~56 s; run with --ignored --test-threads=1\"]","+        fn $rname() {","+            record(\"rust\", $tag, $seed, $poison, $junk);","+        }","+    };"," }"," ","-// ------------------------------------------------- ERRORS 5","-#[test]","-#[ignore = \"~470 s; run with --ignored\"]","-fn endtoend_seed_int_max() {","-    endtoend(0x7FFF_FFFF, false, \"seed_int_max\");","-}","+// CONFIGS 17 / ERRORS 1","+pair!(rec_c_seed_0, rec_rust_seed_0, \"seed_0\", 0, false, false);","+// ERRORS 2","+pair!(rec_c_seed_1, rec_rust_seed_1, \"seed_1\", 1, false, false);","+// CONFIGS 18","+pair!(rec_c_seed_42, rec_rust_seed_42, \"seed_42\", 42, false, false);","+// CONFIGS 20 / ERRORS 7","+pair!(","+    rec_c_seed_42_poisoned,","+    rec_rust_seed_42_poisoned,","+    \"seed_42_poisoned\",","+    42,","+    true,","+    false","+);","+// ERRORS 6 reference","+pair!(rec_c_seed_7, rec_rust_seed_7, \"seed_7\", 7, false, false);","+// ERRORS 6","+pair!(","+    rec_c_seed_7_junk_abi,","+    rec_rust_seed_7_junk_abi,","+    \"seed_7_junk_abi\",","+    7,","+    false,","+    true","+);","+// ERRORS 5","+pair!(","+    rec_c_seed_int_max,","+    rec_rust_seed_int_max,","+    \"seed_int_max\",","+    0x7FFF_FFFF,","+    false,","+    false","+);","+// CONFIGS 19 / ERRORS 4","+pair!(","+    rec_c_seed_0x80000000,","+    rec_rust_seed_0x80000000,","+    \"seed_0x80000000\",","+    0x8000_0000,","+    false,","+    false","+);","+// CONFIGS 19 / ERRORS 3","+pair!(","+    rec_c_seed_uint_max,","+    rec_rust_seed_uint_max,","+    \"seed_uint_max\",","+    0xFFFF_FFFF,","+    false,","+    false","+);"," ","-// ------------------------------------------------- CONFIGS 19 / ERRORS 4","-#[test]","-#[ignore = \"~470 s; run with --ignored\"]","-fn endtoend_seed_0x80000000() {","-    endtoend(0x8000_0000, false, \"seed_0x80000000\");","-}","+// ---------------------------------------------------------------------------","+// Cheap comparison tests (always run).","+// ---------------------------------------------------------------------------"," ","-// ------------------------------------------------- CONFIGS 19 / ERRORS 3","-#[test]","-#[ignore = \"~470 s; run with --ignored\"]","-fn endtoend_seed_uint_max() {","-    endtoend(0xFFFF_FFFF, false, \"seed_uint_max\");","-}","+const TAGS: &[&str] = &[","+    \"seed_0\",","+    \"seed_1\",","+    \"seed_42\",","+    \"seed_42_poisoned\",","+    \"seed_7\",","+    \"seed_7_junk_abi\",","+    \"seed_int_max\",","+    \"seed_0x80000000\",","+    \"seed_uint_max\",","+];"," ","-// ------------------------------------------------- ERRORS 6 (reference run)","-#[test]","-#[ignore = \"~470 s; run with --ignored\"]","-fn endtoend_seed_7() {","-    endtoend(7, false, \"seed_7\");","+fn read_if(p: &std::path::Path) -> Option<Vec<u8>> {","+    if p.exists() {","+        Some(std::fs::read(p).unwrap())","+    } else {","+        None","+    }"," }"," ","-// ------------------------------------------------- ERRORS 6","-/// The ABI parameter is 32-bit, so a 64-bit value with garbage in the high","-/// half must behave exactly like its low 32 bits. Called through a","-/// deliberately mis-shaped `fn(u64, u64, u64)` pointer so the extra argument","-/// registers carry junk as well.","+/// The main end-to-end gate: for every recorded seed, the final `array` and the","+/// printed stdout bytes must be identical between C and Rust."," #[test]","-#[ignore = \"~470 s; run with --ignored\"]","-fn endtoend_seed_garbage_high_bits() {","-    let c = Impl::c();","-    let r = Impl::rust();","-    const JUNK_SEED: u64 = 0xDEAD_BEEF_0000_0007;","+fn compare_recorded_long_exec_runs() {","+    let d = cache_dir();","+    let mut compared = Vec::new();","+    let mut missing = Vec::new();"," ","-    let cp = c.long_exec_addr as usize;","-    let rp = r.long_exec_addr as usize;","-    let hc = std::thread::spawn(move || unsafe {","-        let f: unsafe extern \"C\" fn(u64, u64, u64) -> i64 = std::mem::transmute(cp);","-        f(JUNK_SEED, u64::MAX, 0xA5A5_A5A5_A5A5_A5A5)","-    });","-    let hr = std::thread::spawn(move || unsafe {","-        let f: unsafe extern \"C\" fn(u64, u64, u64) -> i64 = std::mem::transmute(rp);","-        f(JUNK_SEED, u64::MAX, 0xA5A5_A5A5_A5A5_A5A5)","-    });","-    hc.join().unwrap();","-    hr.join().unwrap();","+    for tag in TAGS {","+        let ca = read_if(&d.join(format!(\"arr_c_{tag}.bin\")));","+        let ra = read_if(&d.join(format!(\"arr_rust_{tag}.bin\")));","+        let co = read_if(&d.join(format!(\"out_c_{tag}.bin\")));","+        let ro = read_if(&d.join(format!(\"out_rust_{tag}.bin\")));","+        match (ca, ra, co, ro) {","+            (Some(ca), Some(ra), Some(co), Some(ro)) => {","+                assert_eq!(ca.len(), 0x10_0000, \"{tag}: C array recording size\");","+                assert_eq!(ra.len(), 0x10_0000, \"{tag}: Rust array recording size\");","+                if ca != ra {","+                    let cw: &[i32] =","+                        unsafe { std::slice::from_raw_parts(ca.as_ptr() as *const i32, ARRAY_SIZE) };","+                    let rw: &[i32] =","+                        unsafe { std::slice::from_raw_parts(ra.as_ptr() as *const i32, ARRAY_SIZE) };","+                    let i = (0..ARRAY_SIZE).find(|&i| cw[i] != rw[i]).unwrap();","+                    let n = (0..ARRAY_SIZE).filter(|&i| cw[i] != rw[i]).count();","+                    panic!(","+                        \"{tag}: final `array` diverged in {n}/{ARRAY_SIZE} elements; \\","+                         first at {i}: C = {} , Rust = {}\",","+                        cw[i], rw[i]","+                    );","+                }","+                assert_eq!(","+                    co,","+                    ro,","+                    \"{tag}: stdout differs\\n  C    = {:?}\\n  Rust = {:?}\",","+                    String::from_utf8_lossy(&co),","+                    String::from_utf8_lossy(&ro)","+                );","+                // Cross-check: the printed value IS the xor fold of the array.","+                let cw: &[i32] =","+                    unsafe { std::slice::from_raw_parts(ca.as_ptr() as *const i32, ARRAY_SIZE) };","+                let xor = cw.iter().fold(0i32, |a, &b| a ^ b);","+                assert_eq!(","+                    String::from_utf8_lossy(&co).trim(),","+                    xor.to_string(),","+                    \"{tag}: printed line must be the xor fold of the final array\"","+                );","+                compared.push((tag.to_string(), String::from_utf8_lossy(&co).trim().to_string()));","+            }","+            _ => missing.push(*tag),","+        }","+    }"," ","-    assert_arrays_eq(&c, &r, \"seed_garbage_high_bits\");","-    let xor = c.array().iter().fold(0i32, |a, &b| a ^ b);","-    std::fs::write(","-        cache_dir().join(\"xor_seed_garbage_high_bits.txt\"),","-        format!(\"{xor}\\n\"),","-    )","-    .unwrap();","+    for (tag, line) in &compared {","+        eprintln!(\"MATCH {tag}: printed {line}\");","+    }","+    assert!(","+        missing.is_empty(),","+        \"no recordings for {missing:?} - run ./record_long_exec.sh first\"","+    );","+    assert_eq!(compared.len(), TAGS.len());"," }"," ","-/// ERRORS 6 cross-check: the garbage-high-bits run must equal the plain","-/// `seed = 7` run. Cheap; requires the two expensive tests above to have run.","+/// ERRORS 6: a 64-bit seed argument with garbage in the high half must behave","+/// exactly like its low 32 bits, in both libraries."," #[test]","-fn errors06_garbage_high_bits_equals_seed_7() {","+fn errors06_junk_abi_equals_plain_seed_7() {","     let d = cache_dir();","-    let a = d.join(\"xor_seed_7.txt\");","-    let b = d.join(\"xor_seed_garbage_high_bits.txt\");","-    if !a.exists() || !b.exists() {","-        eprintln!(","-            \"SKIP: run `cargo test --release --test long_exec_full -- --ignored \\","-             endtoend_seed_7 endtoend_seed_garbage_high_bits` first\"","+    for which in [\"c\", \"rust\"] {","+        let plain = read_if(&d.join(format!(\"arr_{which}_seed_7.bin\")));","+        let junk = read_if(&d.join(format!(\"arr_{which}_seed_7_junk_abi.bin\")));","+        let (plain, junk) = match (plain, junk) {","+            (Some(a), Some(b)) => (a, b),","+            _ => {","+                eprintln!(\"SKIP {which}: recordings missing - run ./record_long_exec.sh\");","+                continue;","+            }","+        };","+        assert_eq!(","+            plain, junk,","+            \"{which}: long_exec(0xDEADBEEF_00000007) must equal long_exec(7) - \\","+             the high 32 bits of the seed register must be ignored\"","         );","-        return;","+        let po = std::fs::read(d.join(format!(\"out_{which}_seed_7.bin\"))).unwrap();","+        let jo = std::fs::read(d.join(format!(\"out_{which}_seed_7_junk_abi.bin\"))).unwrap();","+        assert_eq!(po, jo, \"{which}: junk-ABI stdout differs from plain seed 7\");","     }","-    assert_eq!(","-        std::fs::read_to_string(&a).unwrap(),","-        std::fs::read_to_string(&b).unwrap(),","-        \"long_exec(0xDEADBEEF_00000007) must equal long_exec(7): the high 32 bits \\","-         of the seed register must be ignored\"","-    );"," }"," ","-// --------------------------------------------------------- stdout capture","-fn capture(which: &str, seed: u32) {","-    let imp = match which {","-        \"c\" => Impl::c(),","-        \"rust\" => Impl::rust(),","-        _ => unreachable!(),","-    };","-    let out = unsafe { imp.long_exec_capture(seed) };","-    assert!(!out.is_empty(), \"{which}: long_exec printed nothing\");","-    let path = cache_dir().join(format!(\"stdout_{which}_{seed}.bin\"));","-    std::fs::write(&path, &out).unwrap();","-    eprintln!(","-        \"{which} seed {seed} stdout = {:?} ({} bytes) -> {}\",","-        String::from_utf8_lossy(&out),","-        out.len(),","-        path.display()","-    );","-}","-","+/// CONFIGS 20 / ERRORS 7: a caller-dirtied `array` must not affect the result -","+/// `long_exec` overwrites every element from `rand()`. Holds per library, and","+/// the poisoned runs are already diffed C-vs-Rust above."," #[test]","-#[ignore = \"~470 s; run with --ignored --test-threads=1\"]","-fn capture_c_seed_42() {","-    capture(\"c\", 42);","+fn configs20_errors07_dirty_array_does_not_affect_result() {","+    let d = cache_dir();","+    for which in [\"c\", \"rust\"] {","+        let clean = read_if(&d.join(format!(\"arr_{which}_seed_42.bin\")));","+        let poisoned = read_if(&d.join(format!(\"arr_{which}_seed_42_poisoned.bin\")));","+        let (clean, poisoned) = match (clean, poisoned) {","+            (Some(a), Some(b)) => (a, b),","+            _ => {","+                eprintln!(\"SKIP {which}: recordings missing - run ./record_long_exec.sh\");","+                continue;","+            }","+        };","+        assert_eq!(","+            clean, poisoned,","+            \"{which}: long_exec(42) result depends on the prior contents of `array` \\","+             (the rand() fill must cover all {ARRAY_SIZE} elements)\"","+        );","+    }"," }"," ","+/// Distinct seeds must give distinct results - proves the tests are not all","+/// passing on some degenerate constant output."," #[test]","-#[ignore = \"~56 s; run with --ignored --test-threads=1\"]","-fn capture_rust_seed_42() {","-    capture(\"rust\", 42);","-}","-","-#[test]","-#[ignore = \"~470 s; run with --ignored --test-threads=1\"]","-fn capture_c_seed_0() {","-    capture(\"c\", 0);","-}","-","-#[test]","-#[ignore = \"~56 s; run with --ignored --test-threads=1\"]","-fn capture_rust_seed_0() {","-    capture(\"rust\", 0);","-}","-","-/// Byte-for-byte comparison of what the two libraries actually wrote to","-/// stdout, plus a cross-check against the independently computed xor fold.","-#[test]","-fn compare_captured_stdout() {","+fn recorded_results_are_seed_dependent() {","     let d = cache_dir();","-    let mut checked = 0;","-    for (seed, xor_name) in [(42u32, \"xor_seed_42_clean\"), (0, \"xor_seed_0\")] {","-        let cf = d.join(format!(\"stdout_c_{seed}.bin\"));","-        let rf = d.join(format!(\"stdout_rust_{seed}.bin\"));","-        if !cf.exists() || !rf.exists() {","-            continue;","+    let mut seen = std::collections::BTreeMap::new();","+    for tag in [\"seed_0\", \"seed_1\", \"seed_42\", \"seed_int_max\", \"seed_uint_max\"] {","+        if let Some(o) = read_if(&d.join(format!(\"out_c_{tag}.bin\"))) {","+            seen.insert(tag, String::from_utf8_lossy(&o).trim().to_string());","         }","-        let cb = std::fs::read(&cf).unwrap();","-        let rb = std::fs::read(&rf).unwrap();","-        assert_eq!(","-            cb,","-            rb,","-            \"seed {seed}: stdout differs\\n  C    = {:?}\\n  Rust = {:?}\",","-            String::from_utf8_lossy(&cb),","-            String::from_utf8_lossy(&rb)","-        );","-        let xf = d.join(format!(\"{xor_name}.txt\"));","-        if xf.exists() {","-            let expect = std::fs::read_to_string(&xf).unwrap();","-            assert_eq!(","-                String::from_utf8_lossy(&cb).trim(),","-                expect.trim(),","-                \"seed {seed}: printed value must equal the xor fold of the final array\"","-            );","-        }","-        checked += 1;","     }","-    if checked == 0 {","-        eprintln!(","-            \"SKIP: no captures on disk; run `cargo test --release --test long_exec_full -- \\","-             --ignored --test-threads=1 capture_`\"","-        );","+    if seen.len() < 2 {","+        eprintln!(\"SKIP: not enough recordings\");","+        return;","     }","+    let vals: std::collections::BTreeSet<_> = seen.values().collect();","+    assert!(","+        vals.len() > 1,","+        \"every seed produced the same output {seen:?} - the harness is not really \\","+         driving the library\"","+    );"," }"]}],"originalFile":"//! Full end-to-end `long_exec` differential tests (CONFIGS.md rows 17-20,\n//! ERRORS.md rows 1-7).\n//!\n//! A single `long_exec` call is `2000 * 262144 * 100 ~= 5.2e10` inner steps:\n//! about 470 s in the C build and 56 s in the Rust build. Every test here is\n//! therefore `#[ignore]`d and run explicitly, and each test runs its C and its\n//! Rust side on two threads so a test's wall time stays near the C cost.\n//!\n//! Two comparison strategies are used, both exact:\n//!  * `endtoend_*`  - compare the final 1 MiB `array` byte-for-byte. Since\n//!    `xor_result` is a pure fold over that array and both libraries call the\n//!    very same glibc `printf`, identical arrays imply an identical printed\n//!    line. These can run in parallel.\n//!  * `capture_*`   - actually redirect fd 1 and capture the printed bytes.\n//!    fd 1 is process-wide, so these must run one at a time\n//!    (`--test-threads=1`); they persist the captured line under\n//!    `target/long_cache/` and `compare_captured_lines` diffs the cache.\n\nmod common;\n\nuse common::*;\n\nfn cache_dir() -> std::path::PathBuf {\n    let d = std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n        .join(\"target\")\n        .join(\"long_cache\");\n    std::fs::create_dir_all(&d).expect(\"create cache dir\");\n    d\n}\n\n/// Run `long_exec(seed)` on both libraries (in parallel) and compare the\n/// resulting global `array` byte-for-byte.\nfn endtoend(seed: u32, poison: bool, what: &str) {\n    let c = Impl::c();\n    let r = Impl::rust();\n\n    if poison {\n        // CONFIGS 20 / ERRORS 7: deliberately dirty every element first. If\n        // `long_exec`'s `rand()` fill missed even one slot, the result would\n        // differ from the clean run - and `endtoend_seed42_clean` records that.\n        let mut rng = Rng::new(0xDEAD_BEEF_0BAD_F00D);\n        let dirt: Vec<i32> = (0..ARRAY_SIZE).map(|_| rng.hard_i32()).collect();\n        c.set_array(&dirt);\n        r.set_array(&dirt);\n    }\n\n    let cp = c.long_exec_addr as usize;\n    let rp = r.long_exec_addr as usize;\n    let hc = std::thread::spawn(move || unsafe {\n        let f: unsafe extern \"C\" fn(u32) = std::mem::transmute(cp);\n        f(seed)\n    });\n    let hr = std::thread::spawn(move || unsafe {\n        let f: unsafe extern \"C\" fn(u32) = std::mem::transmute(rp);\n        f(seed)\n    });\n    hc.join().expect(\"C long_exec panicked\");\n    hr.join().expect(\"Rust long_exec panicked\");\n\n    assert_arrays_eq(&c, &r, what);\n\n    // Record the xor fold (== the value the library prints) for cross-checking.\n    let xor = c.array().iter().fold(0i32, |a, &b| a ^ b);\n    let rxor = r.array().iter().fold(0i32, |a, &b| a ^ b);\n    assert_eq!(xor, rxor, \"{what}: xor fold\");\n    std::fs::write(cache_dir().join(format!(\"xor_{what}.txt\")), format!(\"{xor}\\n\")).unwrap();\n}\n\n// ------------------------------------------------- CONFIGS 17 / ERRORS 1\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_0() {\n    endtoend(0, false, \"seed_0\");\n}\n\n// ------------------------------------------------- ERRORS 2\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_1() {\n    endtoend(1, false, \"seed_1\");\n}\n\n// ------------------------------------------------- CONFIGS 18\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_42_clean() {\n    endtoend(42, false, \"seed_42_clean\");\n}\n\n// ------------------------------------------------- CONFIGS 20 / ERRORS 7\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_42_poisoned_array() {\n    endtoend(42, true, \"seed_42_poisoned\");\n}\n\n// ------------------------------------------------- ERRORS 5\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_int_max() {\n    endtoend(0x7FFF_FFFF, false, \"seed_int_max\");\n}\n\n// ------------------------------------------------- CONFIGS 19 / ERRORS 4\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_0x80000000() {\n    endtoend(0x8000_0000, false, \"seed_0x80000000\");\n}\n\n// ------------------------------------------------- CONFIGS 19 / ERRORS 3\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_uint_max() {\n    endtoend(0xFFFF_FFFF, false, \"seed_uint_max\");\n}\n\n// ------------------------------------------------- ERRORS 6 (reference run)\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_7() {\n    endtoend(7, false, \"seed_7\");\n}\n\n// ------------------------------------------------- ERRORS 6\n/// The ABI parameter is 32-bit, so a 64-bit value with garbage in the high\n/// half must behave exactly like its low 32 bits. Called through a\n/// deliberately mis-shaped `fn(u64, u64, u64)` pointer so the extra argument\n/// registers carry junk as well.\n#[test]\n#[ignore = \"~470 s; run with --ignored\"]\nfn endtoend_seed_garbage_high_bits() {\n    let c = Impl::c();\n    let r = Impl::rust();\n    const JUNK_SEED: u64 = 0xDEAD_BEEF_0000_0007;\n\n    let cp = c.long_exec_addr as usize;\n    let rp = r.long_exec_addr as usize;\n    let hc = std::thread::spawn(move || unsafe {\n        let f: unsafe extern \"C\" fn(u64, u64, u64) -> i64 = std::mem::transmute(cp);\n        f(JUNK_SEED, u64::MAX, 0xA5A5_A5A5_A5A5_A5A5)\n    });\n    let hr = std::thread::spawn(move || unsafe {\n        let f: unsafe extern \"C\" fn(u64, u64, u64) -> i64 = std::mem::transmute(rp);\n        f(JUNK_SEED, u64::MAX, 0xA5A5_A5A5_A5A5_A5A5)\n    });\n    hc.join().unwrap();\n    hr.join().unwrap();\n\n    assert_arrays_eq(&c, &r, \"seed_garbage_high_bits\");\n    let xor = c.array().iter().fold(0i32, |a, &b| a ^ b);\n    std::fs::write(\n        cache_dir().join(\"xor_seed_garbage_high_bits.txt\"),\n        format!(\"{xor}\\n\"),\n    )\n    .unwrap();\n}\n\n/// ERRORS 6 cross-check: the garbage-high-bits run must equal the plain\n/// `seed = 7` run. Cheap; requires the two expensive tests above to have run.\n#[test]\nfn errors06_garbage_high_bits_equals_seed_7() {\n    let d = cache_dir();\n    let a = d.join(\"xor_seed_7.txt\");\n    let b = d.join(\"xor_seed_garbage_high_bits.txt\");\n    if !a.exists() || !b.exists() {\n        eprintln!(\n            \"SKIP: run `cargo test --release --test long_exec_full -- --ignored \\\n             endtoend_seed_7 endtoend_seed_garbage_high_bits` first\"\n        );\n        return;\n    }\n    assert_eq!(\n        std::fs::read_to_string(&a).unwrap(),\n        std::fs::read_to_string(&b).unwrap(),\n        \"long_exec(0xDEADBEEF_00000007) must equal long_exec(7): the high 32 bits \\\n         of the seed register must be ignored\"\n    );\n}\n\n// --------------------------------------------------------- stdout capture\nfn capture(which: &str, seed: u32) {\n    let imp = match which {\n        \"c\" => Impl::c(),\n        \"rust\" => Impl::rust(),\n        _ => unreachable!(),\n    };\n    let out = unsafe { imp.long_exec_capture(seed) };\n    assert!(!out.is_empty(), \"{which}: long_exec printed nothing\");\n    let path = cache_dir().join(format!(\"stdout_{which}_{seed}.bin\"));\n    std::fs::write(&path, &out).unwrap();\n    eprintln!(\n        \"{which} seed {seed} stdout = {:?} ({} bytes) -> {}\",\n        String::from_utf8_lossy(&out),\n        out.len(),\n        path.display()\n    );\n}\n\n#[test]\n#[ignore = \"~470 s; run with --ignored --test-threads=1\"]\nfn capture_c_seed_42() {\n    capture(\"c\", 42);\n}\n\n#[test]\n#[ignore = \"~56 s; run with --ignored --test-threads=1\"]\nfn capture_rust_seed_42() {\n    capture(\"rust\", 42);\n}\n\n#[test]\n#[ignore = \"~470 s; run with --ignored --test-threads=1\"]\nfn capture_c_seed_0() {\n    capture(\"c\", 0);\n}\n\n#[test]\n#[ignore = \"~56 s; run with --ignored --test-threads=1\"]\nfn capture_rust_seed_0() {\n    capture(\"rust\", 0);\n}\n\n/// Byte-for-byte comparison of what the two libraries actually wrote to\n/// stdout, plus a cross-check against the independently computed xor fold.\n#[test]\nfn compare_captured_stdout() {\n    let d = cache_dir();\n    let mut checked = 0;\n    for (seed, xor_name) in [(42u32, \"xor_seed_42_clean\"), (0, \"xor_seed_0\")] {\n        let cf = d.join(format!(\"stdout_c_{seed}.bin\"));\n        let rf = d.join(format!(\"stdout_rust_{seed}.bin\"));\n        if !cf.exists() || !rf.exists() {\n            continue;\n        }\n        let cb = std::fs::read(&cf).unwrap();\n        let rb = std::fs::read(&rf).unwrap();\n        assert_eq!(\n            cb,\n            rb,\n            \"seed {seed}: stdout differs\\n  C    = {:?}\\n  Rust = {:?}\",\n            String::from_utf8_lossy(&cb),\n            String::from_utf8_lossy(&rb)\n        );\n        let xf = d.join(format!(\"{xor_name}.txt\"));\n        if xf.exists() {\n            let expect = std::fs::read_to_string(&xf).unwrap();\n            assert_eq!(\n                String::from_utf8_lossy(&cb).trim(),\n                expect.trim(),\n                \"seed {seed}: printed value must equal the xor fold of the final array\"\n            );\n        }\n        checked += 1;\n    }\n    if checked == 0 {\n        eprintln!(\n            \"SKIP: no captures on disk; run `cargo test --release --test long_exec_full -- \\\n             --ignored --test-threads=1 capture_`\"\n        );\n    }\n}\n","userModified":false}}
