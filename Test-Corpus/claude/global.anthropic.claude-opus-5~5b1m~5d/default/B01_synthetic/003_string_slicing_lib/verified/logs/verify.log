{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_o33uiytpphscunuvx3vdc6qmcv3q4ecqyq3wi2ulpejeov5mekwa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01UE48ZWm4tzU3fiyqnfmy56","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-km0prT/translation/tests/phase_b_configs.rs","content":"//! Phase B — valid-path differential tests, one test per `CONFIGS.md` row.\n//!\n//! Every test drives BOTH `.so`s through their exported `slice` symbol and\n//! requires byte-identical stdout, an identical `int` return value, and an\n//! identical caller string buffer afterwards.\n\nmod common;\n\nuse common::*;\n\n/// Rows 1–5: pointer mode NN (both bounds omitted) across every length class.\n#[test]\nfn cfg_01_nn_len0() {\n    with_env(|e| {\n        e.diff(\"nn/len0\", b\"\", None, None);\n        // The empty string is the same value every time; a handful of repeats\n        // also pins down that the call is stateless.\n        for i in 0..8 {\n            e.diff(&format!(\"nn/len0/rep{i}\"), b\"\", None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_02_nn_len1() {\n    let mut rng = Rng::new(SEED ^ 2);\n    with_env(|e| {\n        // Every single-byte string, exhaustively (0x01..=0xFF).\n        for b in 1u16..=255 {\n            e.diff(&format!(\"nn/len1/{b:#04x}\"), &[b as u8], None, None);\n        }\n        for i in 0..64 {\n            let s = gen(&mut rng, 1, Content::Mixed);\n            e.diff(&format!(\"nn/len1/rand{i}\"), &s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_03_nn_small_ascii() {\n    let mut rng = Rng::new(SEED ^ 3);\n    with_env(|e| {\n        for i in 0..128 {\n            let len = LenClass::Small.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            e.diff(&format!(\"nn/small/{i}\"), &s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_04_nn_medium_ascii() {\n    let mut rng = Rng::new(SEED ^ 4);\n    with_env(|e| {\n        for i in 0..128 {\n            let len = LenClass::Medium.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            e.diff(&format!(\"nn/medium/{i}\"), &s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_05_nn_large_over_bufsiz() {\n    let mut rng = Rng::new(SEED ^ 5);\n    with_env(|e| {\n        for i in 0..32 {\n            let len = LenClass::Large.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            e.diff(&format!(\"nn/large/{i}(len={len})\"), &s, None, None);\n        }\n        // Exactly at and around BUFSIZ.\n        for len in [4094usize, 4095, 4096, 4097, 4098, 8191, 8192, 8193] {\n            let s = gen(&mut rng, len, Content::Ascii);\n            e.diff(&format!(\"nn/bufsiz/{len}\"), &s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_06_nn_high_bytes_invalid_utf8() {\n    let mut rng = Rng::new(SEED ^ 6);\n    with_env(|e| {\n        for i in 0..128 {\n            let len = SHORT_CLASSES[i % SHORT_CLASSES.len()].pick(&mut rng);\n            let s = gen(&mut rng, len, Content::HighBytes);\n            e.diff(&format!(\"nn/high/{i}\"), &s, None, None);\n        }\n        // Hand-picked invalid UTF-8 shapes.\n        for (n, s) in [\n            &b\"\\xff\"[..],\n            &b\"\\x80\"[..],\n            &b\"\\xc3\"[..],              // truncated 2-byte sequence\n            &b\"\\xe2\\x82\"[..],          // truncated 3-byte sequence\n            &b\"\\xf0\\x9f\\x92\"[..],      // truncated 4-byte sequence\n            &b\"\\xed\\xa0\\x80\"[..],      // surrogate encoding\n            &b\"\\xf4\\x90\\x80\\x80\"[..],  // > U+10FFFF\n            &b\"a\\xffb\\x80c\\xc3\\x28\"[..],\n            \"héllo wörld ✓\".as_bytes(),\n        ]\n        .iter()\n        .enumerate()\n        {\n            e.diff(&format!(\"nn/utf8shape/{n}\"), s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_07_nn_format_bait() {\n    let mut rng = Rng::new(SEED ^ 7);\n    with_env(|e| {\n        for s in [\n            &b\"%s\"[..],\n            &b\"%n\"[..],\n            &b\"%%\"[..],\n            &b\"%d %d %d %d %d %d\"[..],\n            &b\"%1000000f\"[..],\n            &b\"%.*s\"[..],\n            &b\"%p%p%p%p\"[..],\n            &b\"%hn%hhn%lln\"[..],\n            &b\"100%% sure\"[..],\n            &b\"%\"[..],\n        ] {\n            e.diff(\n                &format!(\"nn/bait/{}\", String::from_utf8_lossy(s)),\n                s,\n                None,\n                None,\n            );\n        }\n        for i in 0..96 {\n            let len = SHORT_CLASSES[i % SHORT_CLASSES.len()].pick(&mut rng);\n            let s = gen(&mut rng, len, Content::FormatBait);\n            e.diff(&format!(\"nn/bait/rand{i}\"), &s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_08_nn_byte_ramp_and_whitespace() {\n    let mut rng = Rng::new(SEED ^ 8);\n    with_env(|e| {\n        let r = ramp();\n        e.diff(\"nn/ramp\", &r, None, None);\n        for i in 0..96 {\n            let len = SHORT_CLASSES[i % SHORT_CLASSES.len()].pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Whitespace);\n            e.diff(&format!(\"nn/ws/{i}\"), &s, None, None);\n        }\n        for s in [\n            &b\"\\n\"[..],\n            &b\"\\n\\n\\n\"[..],\n            &b\"a\\nb\\nc\"[..],\n            &b\"\\t\\t\"[..],\n            &b\"\\r\\n\"[..],\n            &b\"   \"[..],\n        ] {\n            e.diff(\"nn/ws/fixed\", s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_09_nn_huge_1mib() {\n    let mut rng = Rng::new(SEED ^ 9);\n    with_env(|e| {\n        for (i, kind) in [Content::Ascii, Content::HighBytes, Content::AllBytes]\n            .iter()\n            .enumerate()\n        {\n            let s = gen(&mut rng, LenClass::Huge.pick(&mut rng), *kind);\n            e.diff(&format!(\"nn/huge/{i}\"), &s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_10_nn_call_sequence() {\n    let mut rng = Rng::new(SEED ^ 10);\n    let mut cases = Vec::new();\n    for _ in 0..200 {\n        let len = SHORT_CLASSES[rng.below(SHORT_CLASSES.len() as u64) as usize].pick(&mut rng);\n        let kind = ALL_CONTENT[rng.below(ALL_CONTENT.len() as u64) as usize];\n        cases.push((gen(&mut rng, len, kind), None, None));\n    }\n    with_env(|e| e.diff_sequence(\"nn/sequence\", &cases));\n}\n\n/// Rows 11–17: pointer mode SN (start supplied, stop omitted).\n#[test]\nfn cfg_11_sn_len0_start0() {\n    with_env(|e| {\n        for i in 0..8 {\n            e.diff(&format!(\"sn/len0/{i}\"), b\"\", Some(0), None);\n        }\n    });\n}\n\n#[test]\nfn cfg_12_sn_start_zero() {\n    let mut rng = Rng::new(SEED ^ 12);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            e.diff(&format!(\"sn/start0/{i}\"), &s, Some(0), None);\n        }\n        let big = gen(&mut rng, LenClass::Large.pick(&mut rng), Content::Mixed);\n        e.diff(\"sn/start0/large\", &big, Some(0), None);\n    });\n}\n\n#[test]\nfn cfg_13_sn_start_at_len_boundary() {\n    let mut rng = Rng::new(SEED ^ 13);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            // start == len is VALID and prints an empty slice.\n            e.diff(\n                &format!(\"sn/start==len/{i}(len={})\", s.len()),\n                &s,\n                Some(s.len() as i32),\n                None,\n            );\n        }\n        let big = gen(&mut rng, LenClass::Large.pick(&mut rng), Content::Ascii);\n        let n = big.len() as i32;\n        e.diff(\"sn/start==len/large\", &big, Some(n), None);\n    });\n}\n\n#[test]\nfn cfg_14_sn_start_at_last_byte() {\n    let mut rng = Rng::new(SEED ^ 14);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            e.diff(\n                &format!(\"sn/start==len-1/{i}\"),\n                &s,\n                Some(s.len() as i32 - 1),\n                None,\n            );\n        }\n    });\n}\n\n#[test]\nfn cfg_15_sn_random_start() {\n    let mut rng = Rng::new(SEED ^ 15);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[rng.below(ALL_CONTENT.len() as u64) as usize];\n            let s = gen(&mut rng, len, kind);\n            let start = rng.range_i32(0, s.len() as i32);\n            e.diff(&format!(\"sn/rand/{i}(start={start},len={})\", s.len()), &s, Some(start), None);\n        }\n    });\n}\n\n#[test]\nfn cfg_16_sn_random_start_large() {\n    let mut rng = Rng::new(SEED ^ 16);\n    with_env(|e| {\n        for i in 0..24 {\n            let len = LenClass::Large.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let start = rng.range_i32(0, s.len() as i32);\n            e.diff(&format!(\"sn/large/{i}(start={start},len={len})\"), &s, Some(start), None);\n        }\n        // One 1 MiB pass with a mid-string start.\n        let s = gen(&mut rng, LenClass::Huge.pick(&mut rng), Content::AllBytes);\n        let start = rng.range_i32(0, s.len() as i32);\n        e.diff(&format!(\"sn/huge(start={start})\"), &s, Some(start), None);\n    });\n}\n\n#[test]\nfn cfg_17_sn_random_start_high_bytes() {\n    let mut rng = Rng::new(SEED ^ 17);\n    with_env(|e| {\n        for i in 0..160 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::HighBytes);\n            let start = rng.range_i32(0, s.len() as i32);\n            e.diff(&format!(\"sn/high/{i}(start={start})\"), &s, Some(start), None);\n        }\n        // Deliberately split multi-byte UTF-8 sequences.\n        let s = \"αβγδε — ✓✗ 🎉🎊\".as_bytes().to_vec();\n        for start in 0..=s.len() as i32 {\n            e.diff(&format!(\"sn/utf8split/{start}\"), &s, Some(start), None);\n        }\n    });\n}\n\n/// Rows 18–22: pointer mode NS (start omitted ⇒ 0, stop supplied).\n#[test]\nfn cfg_18_ns_stop_at_len() {\n    let mut rng = Rng::new(SEED ^ 18);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            e.diff(\n                &format!(\"ns/stop==len/{i}\"),\n                &s,\n                None,\n                Some(s.len() as i32),\n            );\n        }\n    });\n}\n\n#[test]\nfn cfg_19_ns_stop_one() {\n    let mut rng = Rng::new(SEED ^ 19);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            e.diff(&format!(\"ns/stop==1/{i}\"), &s, None, Some(1));\n        }\n    });\n}\n\n#[test]\nfn cfg_20_ns_random_stop() {\n    let mut rng = Rng::new(SEED ^ 20);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[rng.below(ALL_CONTENT.len() as u64) as usize];\n            let s = gen(&mut rng, len, kind);\n            let stop = rng.range_i32(1, s.len() as i32);\n            e.diff(&format!(\"ns/rand/{i}(stop={stop},len={})\", s.len()), &s, None, Some(stop));\n        }\n    });\n}\n\n#[test]\nfn cfg_21_ns_random_stop_large_and_huge() {\n    let mut rng = Rng::new(SEED ^ 21);\n    with_env(|e| {\n        for i in 0..24 {\n            let len = LenClass::Large.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let stop = rng.range_i32(1, s.len() as i32);\n            e.diff(&format!(\"ns/large/{i}(stop={stop},len={len})\"), &s, None, Some(stop));\n        }\n        let s = gen(&mut rng, LenClass::Huge.pick(&mut rng), Content::Mixed);\n        for _ in 0..2 {\n            let stop = rng.range_i32(1, s.len() as i32);\n            e.diff(&format!(\"ns/huge(stop={stop})\"), &s, None, Some(stop));\n        }\n    });\n}\n\n#[test]\nfn cfg_22_ns_random_stop_high_bytes_and_bait() {\n    let mut rng = Rng::new(SEED ^ 22);\n    with_env(|e| {\n        for i in 0..160 {\n            let kind = if i % 2 == 0 {\n                Content::HighBytes\n            } else {\n                Content::FormatBait\n            };\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, kind);\n            let stop = rng.range_i32(1, s.len() as i32);\n            e.diff(&format!(\"ns/hb/{i}(stop={stop})\"), &s, None, Some(stop));\n        }\n    });\n}\n\n/// Rows 23–31: pointer mode SS (both bounds supplied).\n#[test]\nfn cfg_23_ss_full_window() {\n    let mut rng = Rng::new(SEED ^ 23);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            e.diff(\n                &format!(\"ss/full/{i}\"),\n                &s,\n                Some(0),\n                Some(s.len() as i32),\n            );\n        }\n    });\n}\n\n#[test]\nfn cfg_24_ss_minimal_head_window() {\n    let mut rng = Rng::new(SEED ^ 24);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            e.diff(&format!(\"ss/head/{i}\"), &s, Some(0), Some(1));\n        }\n    });\n}\n\n#[test]\nfn cfg_25_ss_minimal_tail_window() {\n    let mut rng = Rng::new(SEED ^ 25);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let n = s.len() as i32;\n            e.diff(&format!(\"ss/tail/{i}\"), &s, Some(n - 1), Some(n));\n        }\n    });\n}\n\n#[test]\nfn cfg_26_ss_random_window() {\n    let mut rng = Rng::new(SEED ^ 26);\n    with_env(|e| {\n        for i in 0..256 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng).max(1);\n            let kind = ALL_CONTENT[rng.below(ALL_CONTENT.len() as u64) as usize];\n            let s = gen(&mut rng, len, kind);\n            let n = s.len() as i32;\n            let start = rng.range_i32(0, n - 1);\n            let stop = rng.range_i32(start + 1, n);\n            e.diff(\n                &format!(\"ss/rand/{i}(start={start},stop={stop},len={n})\"),\n                &s,\n                Some(start),\n                Some(stop),\n            );\n        }\n    });\n}\n\n#[test]\nfn cfg_27_ss_random_window_large() {\n    let mut rng = Rng::new(SEED ^ 27);\n    with_env(|e| {\n        for i in 0..32 {\n            let len = LenClass::Large.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let n = s.len() as i32;\n            let start = rng.range_i32(0, n - 1);\n            let stop = rng.range_i32(start + 1, n);\n            e.diff(\n                &format!(\"ss/large/{i}(start={start},stop={stop},len={n})\"),\n                &s,\n                Some(start),\n                Some(stop),\n            );\n        }\n    });\n}\n\n#[test]\nfn cfg_28_ss_random_window_huge() {\n    let mut rng = Rng::new(SEED ^ 28);\n    with_env(|e| {\n        let s = gen(&mut rng, LenClass::Huge.pick(&mut rng), Content::AllBytes);\n        let n = s.len() as i32;\n        for i in 0..4 {\n            let start = rng.range_i32(0, n - 1);\n            let stop = rng.range_i32(start + 1, n);\n            e.diff(\n                &format!(\"ss/huge/{i}(start={start},stop={stop})\"),\n                &s,\n                Some(start),\n                Some(stop),\n            );\n        }\n        // Whole 1 MiB window through the explicit-bounds path.\n        e.diff(\"ss/huge/full\", &s, Some(0), Some(n));\n    });\n}\n\n#[test]\nfn cfg_29_ss_random_window_high_bytes() {\n    let mut rng = Rng::new(SEED ^ 29);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng).max(1);\n            let s = gen(&mut rng, len, Content::HighBytes);\n            let n = s.len() as i32;\n            let start = rng.range_i32(0, n - 1);\n            let stop = rng.range_i32(start + 1, n);\n            e.diff(&format!(\"ss/high/{i}\"), &s, Some(start), Some(stop));\n        }\n    });\n}\n\n#[test]\nfn cfg_30_ss_random_window_format_bait() {\n    let mut rng = Rng::new(SEED ^ 30);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng).max(1);\n            let s = gen(&mut rng, len, Content::FormatBait);\n            let n = s.len() as i32;\n            let start = rng.range_i32(0, n - 1);\n            let stop = rng.range_i32(start + 1, n);\n            e.diff(&format!(\"ss/bait/{i}\"), &s, Some(start), Some(stop));\n        }\n        // Windows that cut a conversion specifier in half.\n        let s = b\"%s%n%d%%%1000000f\".to_vec();\n        let n = s.len() as i32;\n        for start in 0..n {\n            for stop in (start + 1)..=n {\n                e.diff(&format!(\"ss/baitcut/{start}-{stop}\"), &s, Some(start), Some(stop));\n            }\n        }\n    });\n}\n\n#[test]\nfn cfg_31_ss_window_over_byte_ramp() {\n    with_env(|e| {\n        let s = ramp();\n        let n = s.len() as i32;\n        // Every window whose bounds are multiples of 5, plus the extremes.\n        let mut starts: Vec<i32> = (0..n).step_by(5).collect();\n        starts.push(n - 1);\n        for &start in &starts {\n            for stop in [start + 1, (start + 7).min(n), (start + 64).min(n), n] {\n                if stop > start && stop <= n {\n                    e.diff(&format!(\"ss/ramp/{start}-{stop}\"), &s, Some(start), Some(stop));\n                }\n            }\n        }\n    });\n}\n\n/// Row 32: exhaustive sweep of *all four* pointer modes and *all* bound values\n/// in `[0, L]` for every short length — the cross-product the C distinguishes,\n/// including the pairs it rejects.\n#[test]\nfn cfg_32_exhaustive_small_lengths() {\n    let mut rng = Rng::new(SEED ^ 32);\n    with_env(|e| {\n        for len in 0usize..=24 {\n            let s = gen(&mut rng, len, Content::Mixed);\n            let n = len as i32;\n            let bounds: Vec<Option<i32>> =\n                std::iter::once(None).chain((0..=n).map(Some)).collect();\n            for &start in &bounds {\n                for &stop in &bounds {\n                    e.diff(\n                        &format!(\"sweep/len={len}/start={start:?}/stop={stop:?}\"),\n                        &s,\n                        start,\n                        stop,\n                    );\n                }\n            }\n        }\n        note(&format!(\"cfg_32 performed {} differential checks\", e.checks));\n    });\n}\n\n/// Row 33: an interleaved sequence of accepted and rejected calls across all\n/// four pointer modes, compared as a single stdout blob — error text and slice\n/// text share one stream, so their ordering is observable.\n#[test]\nfn cfg_33_mixed_valid_and_rejected_sequence() {\n    let mut rng = Rng::new(SEED ^ 33);\n    let mut cases: Vec<(Vec<u8>, Option<i32>, Option<i32>)> = Vec::new();\n    for _ in 0..300 {\n        let class = SHORT_CLASSES[rng.below(SHORT_CLASSES.len() as u64) as usize];\n        let len = class.pick(&mut rng);\n        let kind = ALL_CONTENT[rng.below(ALL_CONTENT.len() as u64) as usize];\n        let s = gen(&mut rng, len, kind);\n        let n = s.len() as i32;\n        // Bounds drawn from a range that deliberately overshoots and undershoots.\n        let pick = |r: &mut Rng| -> Option<i32> {\n            match r.below(6) {\n                0 => None,\n                1 => Some(-1),\n                2 => Some(n + 1),\n                3 => Some(i32::MIN),\n                4 => Some(i32::MAX),\n                _ => Some(r.range_i32(0, n)),\n            }\n        };\n        let start = pick(&mut rng);\n        let stop = pick(&mut rng);\n        cases.push((s, start, stop));\n    }\n    with_env(|e| e.diff_sequence(\"mixed/sequence\", &cases));\n}\n\n/// Row 34: the bounds live in one `int[2]`, i.e. adjacent storage reached\n/// through two pointers into the same object.\n#[test]\nfn cfg_34_bounds_in_one_array() {\n    let mut rng = Rng::new(SEED ^ 34);\n    with_env(|e| {\n        for i in 0..128 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng).max(1);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let n = s.len() as i32;\n            let start = rng.range_i32(0, n - 1);\n            let stop = rng.range_i32(start + 1, n);\n            e.diff_adjacent(&format!(\"adjacent/{i}\"), &s, start, stop);\n        }\n        // Also the rejecting arrangements through the same shape.\n        e.diff_adjacent(\"adjacent/equal\", b\"abcdef\", 3, 3);\n        e.diff_adjacent(\"adjacent/reversed\", b\"abcdef\", 4, 2);\n        e.diff_adjacent(\"adjacent/offend\", b\"abcdef\", 0, 7);\n    });\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":639,"cache_read_input_tokens":62437,"cache_creation":{"ephemeral_5m_input_tokens":639,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1bb4f197-1782-4f38-9534-b9fc0dce3610","uuid":"59c25cce-d49e-4c22-b26e-5e59ed474dc8","timestamp":"2026-08-28T09:02:46.587Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UE48ZWm4tzU3fiyqnfmy56","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-km0prT/translation/tests/phase_b_configs.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1bb4f197-1782-4f38-9534-b9fc0dce3610","uuid":"3ffcf9de-0efe-4e5c-ac61-dcede6f1b0c5","timestamp":"2026-08-28T09:02:46.598Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-km0prT/translation/tests/phase_b_configs.rs","content":"//! Phase B — valid-path differential tests, one test per `CONFIGS.md` row.\n//!\n//! Every test drives BOTH `.so`s through their exported `slice` symbol and\n//! requires byte-identical stdout, an identical `int` return value, and an\n//! identical caller string buffer afterwards.\n\nmod common;\n\nuse common::*;\n\n/// Rows 1–5: pointer mode NN (both bounds omitted) across every length class.\n#[test]\nfn cfg_01_nn_len0() {\n    with_env(|e| {\n        e.diff(\"nn/len0\", b\"\", None, None);\n        // The empty string is the same value every time; a handful of repeats\n        // also pins down that the call is stateless.\n        for i in 0..8 {\n            e.diff(&format!(\"nn/len0/rep{i}\"), b\"\", None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_02_nn_len1() {\n    let mut rng = Rng::new(SEED ^ 2);\n    with_env(|e| {\n        // Every single-byte string, exhaustively (0x01..=0xFF).\n        for b in 1u16..=255 {\n            e.diff(&format!(\"nn/len1/{b:#04x}\"), &[b as u8], None, None);\n        }\n        for i in 0..64 {\n            let s = gen(&mut rng, 1, Content::Mixed);\n            e.diff(&format!(\"nn/len1/rand{i}\"), &s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_03_nn_small_ascii() {\n    let mut rng = Rng::new(SEED ^ 3);\n    with_env(|e| {\n        for i in 0..128 {\n            let len = LenClass::Small.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            e.diff(&format!(\"nn/small/{i}\"), &s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_04_nn_medium_ascii() {\n    let mut rng = Rng::new(SEED ^ 4);\n    with_env(|e| {\n        for i in 0..128 {\n            let len = LenClass::Medium.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            e.diff(&format!(\"nn/medium/{i}\"), &s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_05_nn_large_over_bufsiz() {\n    let mut rng = Rng::new(SEED ^ 5);\n    with_env(|e| {\n        for i in 0..32 {\n            let len = LenClass::Large.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            e.diff(&format!(\"nn/large/{i}(len={len})\"), &s, None, None);\n        }\n        // Exactly at and around BUFSIZ.\n        for len in [4094usize, 4095, 4096, 4097, 4098, 8191, 8192, 8193] {\n            let s = gen(&mut rng, len, Content::Ascii);\n            e.diff(&format!(\"nn/bufsiz/{len}\"), &s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_06_nn_high_bytes_invalid_utf8() {\n    let mut rng = Rng::new(SEED ^ 6);\n    with_env(|e| {\n        for i in 0..128 {\n            let len = SHORT_CLASSES[i % SHORT_CLASSES.len()].pick(&mut rng);\n            let s = gen(&mut rng, len, Content::HighBytes);\n            e.diff(&format!(\"nn/high/{i}\"), &s, None, None);\n        }\n        // Hand-picked invalid UTF-8 shapes.\n        for (n, s) in [\n            &b\"\\xff\"[..],\n            &b\"\\x80\"[..],\n            &b\"\\xc3\"[..],              // truncated 2-byte sequence\n            &b\"\\xe2\\x82\"[..],          // truncated 3-byte sequence\n            &b\"\\xf0\\x9f\\x92\"[..],      // truncated 4-byte sequence\n            &b\"\\xed\\xa0\\x80\"[..],      // surrogate encoding\n            &b\"\\xf4\\x90\\x80\\x80\"[..],  // > U+10FFFF\n            &b\"a\\xffb\\x80c\\xc3\\x28\"[..],\n            \"héllo wörld ✓\".as_bytes(),\n        ]\n        .iter()\n        .enumerate()\n        {\n            e.diff(&format!(\"nn/utf8shape/{n}\"), s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_07_nn_format_bait() {\n    let mut rng = Rng::new(SEED ^ 7);\n    with_env(|e| {\n        for s in [\n            &b\"%s\"[..],\n            &b\"%n\"[..],\n            &b\"%%\"[..],\n            &b\"%d %d %d %d %d %d\"[..],\n            &b\"%1000000f\"[..],\n            &b\"%.*s\"[..],\n            &b\"%p%p%p%p\"[..],\n            &b\"%hn%hhn%lln\"[..],\n            &b\"100%% sure\"[..],\n            &b\"%\"[..],\n        ] {\n            e.diff(\n                &format!(\"nn/bait/{}\", String::from_utf8_lossy(s)),\n                s,\n                None,\n                None,\n            );\n        }\n        for i in 0..96 {\n            let len = SHORT_CLASSES[i % SHORT_CLASSES.len()].pick(&mut rng);\n            let s = gen(&mut rng, len, Content::FormatBait);\n            e.diff(&format!(\"nn/bait/rand{i}\"), &s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_08_nn_byte_ramp_and_whitespace() {\n    let mut rng = Rng::new(SEED ^ 8);\n    with_env(|e| {\n        let r = ramp();\n        e.diff(\"nn/ramp\", &r, None, None);\n        for i in 0..96 {\n            let len = SHORT_CLASSES[i % SHORT_CLASSES.len()].pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Whitespace);\n            e.diff(&format!(\"nn/ws/{i}\"), &s, None, None);\n        }\n        for s in [\n            &b\"\\n\"[..],\n            &b\"\\n\\n\\n\"[..],\n            &b\"a\\nb\\nc\"[..],\n            &b\"\\t\\t\"[..],\n            &b\"\\r\\n\"[..],\n            &b\"   \"[..],\n        ] {\n            e.diff(\"nn/ws/fixed\", s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_09_nn_huge_1mib() {\n    let mut rng = Rng::new(SEED ^ 9);\n    with_env(|e| {\n        for (i, kind) in [Content::Ascii, Content::HighBytes, Content::AllBytes]\n            .iter()\n            .enumerate()\n        {\n            let s = gen(&mut rng, LenClass::Huge.pick(&mut rng), *kind);\n            e.diff(&format!(\"nn/huge/{i}\"), &s, None, None);\n        }\n    });\n}\n\n#[test]\nfn cfg_10_nn_call_sequence() {\n    let mut rng = Rng::new(SEED ^ 10);\n    let mut cases = Vec::new();\n    for _ in 0..200 {\n        let len = SHORT_CLASSES[rng.below(SHORT_CLASSES.len() as u64) as usize].pick(&mut rng);\n        let kind = ALL_CONTENT[rng.below(ALL_CONTENT.len() as u64) as usize];\n        cases.push((gen(&mut rng, len, kind), None, None));\n    }\n    with_env(|e| e.diff_sequence(\"nn/sequence\", &cases));\n}\n\n/// Rows 11–17: pointer mode SN (start supplied, stop omitted).\n#[test]\nfn cfg_11_sn_len0_start0() {\n    with_env(|e| {\n        for i in 0..8 {\n            e.diff(&format!(\"sn/len0/{i}\"), b\"\", Some(0), None);\n        }\n    });\n}\n\n#[test]\nfn cfg_12_sn_start_zero() {\n    let mut rng = Rng::new(SEED ^ 12);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            e.diff(&format!(\"sn/start0/{i}\"), &s, Some(0), None);\n        }\n        let big = gen(&mut rng, LenClass::Large.pick(&mut rng), Content::Mixed);\n        e.diff(\"sn/start0/large\", &big, Some(0), None);\n    });\n}\n\n#[test]\nfn cfg_13_sn_start_at_len_boundary() {\n    let mut rng = Rng::new(SEED ^ 13);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            // start == len is VALID and prints an empty slice.\n            e.diff(\n                &format!(\"sn/start==len/{i}(len={})\", s.len()),\n                &s,\n                Some(s.len() as i32),\n                None,\n            );\n        }\n        let big = gen(&mut rng, LenClass::Large.pick(&mut rng), Content::Ascii);\n        let n = big.len() as i32;\n        e.diff(\"sn/start==len/large\", &big, Some(n), None);\n    });\n}\n\n#[test]\nfn cfg_14_sn_start_at_last_byte() {\n    let mut rng = Rng::new(SEED ^ 14);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            e.diff(\n                &format!(\"sn/start==len-1/{i}\"),\n                &s,\n                Some(s.len() as i32 - 1),\n                None,\n            );\n        }\n    });\n}\n\n#[test]\nfn cfg_15_sn_random_start() {\n    let mut rng = Rng::new(SEED ^ 15);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[rng.below(ALL_CONTENT.len() as u64) as usize];\n            let s = gen(&mut rng, len, kind);\n            let start = rng.range_i32(0, s.len() as i32);\n            e.diff(&format!(\"sn/rand/{i}(start={start},len={})\", s.len()), &s, Some(start), None);\n        }\n    });\n}\n\n#[test]\nfn cfg_16_sn_random_start_large() {\n    let mut rng = Rng::new(SEED ^ 16);\n    with_env(|e| {\n        for i in 0..24 {\n            let len = LenClass::Large.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let start = rng.range_i32(0, s.len() as i32);\n            e.diff(&format!(\"sn/large/{i}(start={start},len={len})\"), &s, Some(start), None);\n        }\n        // One 1 MiB pass with a mid-string start.\n        let s = gen(&mut rng, LenClass::Huge.pick(&mut rng), Content::AllBytes);\n        let start = rng.range_i32(0, s.len() as i32);\n        e.diff(&format!(\"sn/huge(start={start})\"), &s, Some(start), None);\n    });\n}\n\n#[test]\nfn cfg_17_sn_random_start_high_bytes() {\n    let mut rng = Rng::new(SEED ^ 17);\n    with_env(|e| {\n        for i in 0..160 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::HighBytes);\n            let start = rng.range_i32(0, s.len() as i32);\n            e.diff(&format!(\"sn/high/{i}(start={start})\"), &s, Some(start), None);\n        }\n        // Deliberately split multi-byte UTF-8 sequences.\n        let s = \"αβγδε — ✓✗ 🎉🎊\".as_bytes().to_vec();\n        for start in 0..=s.len() as i32 {\n            e.diff(&format!(\"sn/utf8split/{start}\"), &s, Some(start), None);\n        }\n    });\n}\n\n/// Rows 18–22: pointer mode NS (start omitted ⇒ 0, stop supplied).\n#[test]\nfn cfg_18_ns_stop_at_len() {\n    let mut rng = Rng::new(SEED ^ 18);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            e.diff(\n                &format!(\"ns/stop==len/{i}\"),\n                &s,\n                None,\n                Some(s.len() as i32),\n            );\n        }\n    });\n}\n\n#[test]\nfn cfg_19_ns_stop_one() {\n    let mut rng = Rng::new(SEED ^ 19);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            e.diff(&format!(\"ns/stop==1/{i}\"), &s, None, Some(1));\n        }\n    });\n}\n\n#[test]\nfn cfg_20_ns_random_stop() {\n    let mut rng = Rng::new(SEED ^ 20);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[rng.below(ALL_CONTENT.len() as u64) as usize];\n            let s = gen(&mut rng, len, kind);\n            let stop = rng.range_i32(1, s.len() as i32);\n            e.diff(&format!(\"ns/rand/{i}(stop={stop},len={})\", s.len()), &s, None, Some(stop));\n        }\n    });\n}\n\n#[test]\nfn cfg_21_ns_random_stop_large_and_huge() {\n    let mut rng = Rng::new(SEED ^ 21);\n    with_env(|e| {\n        for i in 0..24 {\n            let len = LenClass::Large.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let stop = rng.range_i32(1, s.len() as i32);\n            e.diff(&format!(\"ns/large/{i}(stop={stop},len={len})\"), &s, None, Some(stop));\n        }\n        let s = gen(&mut rng, LenClass::Huge.pick(&mut rng), Content::Mixed);\n        for _ in 0..2 {\n            let stop = rng.range_i32(1, s.len() as i32);\n            e.diff(&format!(\"ns/huge(stop={stop})\"), &s, None, Some(stop));\n        }\n    });\n}\n\n#[test]\nfn cfg_22_ns_random_stop_high_bytes_and_bait() {\n    let mut rng = Rng::new(SEED ^ 22);\n    with_env(|e| {\n        for i in 0..160 {\n            let kind = if i % 2 == 0 {\n                Content::HighBytes\n            } else {\n                Content::FormatBait\n            };\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, kind);\n            let stop = rng.range_i32(1, s.len() as i32);\n            e.diff(&format!(\"ns/hb/{i}(stop={stop})\"), &s, None, Some(stop));\n        }\n    });\n}\n\n/// Rows 23–31: pointer mode SS (both bounds supplied).\n#[test]\nfn cfg_23_ss_full_window() {\n    let mut rng = Rng::new(SEED ^ 23);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            e.diff(\n                &format!(\"ss/full/{i}\"),\n                &s,\n                Some(0),\n                Some(s.len() as i32),\n            );\n        }\n    });\n}\n\n#[test]\nfn cfg_24_ss_minimal_head_window() {\n    let mut rng = Rng::new(SEED ^ 24);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            e.diff(&format!(\"ss/head/{i}\"), &s, Some(0), Some(1));\n        }\n    });\n}\n\n#[test]\nfn cfg_25_ss_minimal_tail_window() {\n    let mut rng = Rng::new(SEED ^ 25);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let n = s.len() as i32;\n            e.diff(&format!(\"ss/tail/{i}\"), &s, Some(n - 1), Some(n));\n        }\n    });\n}\n\n#[test]\nfn cfg_26_ss_random_window() {\n    let mut rng = Rng::new(SEED ^ 26);\n    with_env(|e| {\n        for i in 0..256 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng).max(1);\n            let kind = ALL_CONTENT[rng.below(ALL_CONTENT.len() as u64) as usize];\n            let s = gen(&mut rng, len, kind);\n            let n = s.len() as i32;\n            let start = rng.range_i32(0, n - 1);\n            let stop = rng.range_i32(start + 1, n);\n            e.diff(\n                &format!(\"ss/rand/{i}(start={start},stop={stop},len={n})\"),\n                &s,\n                Some(start),\n                Some(stop),\n            );\n        }\n    });\n}\n\n#[test]\nfn cfg_27_ss_random_window_large() {\n    let mut rng = Rng::new(SEED ^ 27);\n    with_env(|e| {\n        for i in 0..32 {\n            let len = LenClass::Large.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let n = s.len() as i32;\n            let start = rng.range_i32(0, n - 1);\n            let stop = rng.range_i32(start + 1, n);\n            e.diff(\n                &format!(\"ss/large/{i}(start={start},stop={stop},len={n})\"),\n                &s,\n                Some(start),\n                Some(stop),\n            );\n        }\n    });\n}\n\n#[test]\nfn cfg_28_ss_random_window_huge() {\n    let mut rng = Rng::new(SEED ^ 28);\n    with_env(|e| {\n        let s = gen(&mut rng, LenClass::Huge.pick(&mut rng), Content::AllBytes);\n        let n = s.len() as i32;\n        for i in 0..4 {\n            let start = rng.range_i32(0, n - 1);\n            let stop = rng.range_i32(start + 1, n);\n            e.diff(\n                &format!(\"ss/huge/{i}(start={start},stop={stop})\"),\n                &s,\n                Some(start),\n                Some(stop),\n            );\n        }\n        // Whole 1 MiB window through the explicit-bounds path.\n        e.diff(\"ss/huge/full\", &s, Some(0), Some(n));\n    });\n}\n\n#[test]\nfn cfg_29_ss_random_window_high_bytes() {\n    let mut rng = Rng::new(SEED ^ 29);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng).max(1);\n            let s = gen(&mut rng, len, Content::HighBytes);\n            let n = s.len() as i32;\n            let start = rng.range_i32(0, n - 1);\n            let stop = rng.range_i32(start + 1, n);\n            e.diff(&format!(\"ss/high/{i}\"), &s, Some(start), Some(stop));\n        }\n    });\n}\n\n#[test]\nfn cfg_30_ss_random_window_format_bait() {\n    let mut rng = Rng::new(SEED ^ 30);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng).max(1);\n            let s = gen(&mut rng, len, Content::FormatBait);\n            let n = s.len() as i32;\n            let start = rng.range_i32(0, n - 1);\n            let stop = rng.range_i32(start + 1, n);\n            e.diff(&format!(\"ss/bait/{i}\"), &s, Some(start), Some(stop));\n        }\n        // Windows that cut a conversion specifier in half.\n        let s = b\"%s%n%d%%%1000000f\".to_vec();\n        let n = s.len() as i32;\n        for start in 0..n {\n            for stop in (start + 1)..=n {\n                e.diff(&format!(\"ss/baitcut/{start}-{stop}\"), &s, Some(start), Some(stop));\n            }\n        }\n    });\n}\n\n#[test]\nfn cfg_31_ss_window_over_byte_ramp() {\n    with_env(|e| {\n        let s = ramp();\n        let n = s.len() as i32;\n        // Every window whose bounds are multiples of 5, plus the extremes.\n        let mut starts: Vec<i32> = (0..n).step_by(5).collect();\n        starts.push(n - 1);\n        for &start in &starts {\n            for stop in [start + 1, (start + 7).min(n), (start + 64).min(n), n] {\n                if stop > start && stop <= n {\n                    e.diff(&format!(\"ss/ramp/{start}-{stop}\"), &s, Some(start), Some(stop));\n                }\n            }\n        }\n    });\n}\n\n/// Row 32: exhaustive sweep of *all four* pointer modes and *all* bound values\n/// in `[0, L]` for every short length — the cross-product the C distinguishes,\n/// including the pairs it rejects.\n#[test]\nfn cfg_32_exhaustive_small_lengths() {\n    let mut rng = Rng::new(SEED ^ 32);\n    with_env(|e| {\n        for len in 0usize..=24 {\n            let s = gen(&mut rng, len, Content::Mixed);\n            let n = len as i32;\n            let bounds: Vec<Option<i32>> =\n                std::iter::once(None).chain((0..=n).map(Some)).collect();\n            for &start in &bounds {\n                for &stop in &bounds {\n                    e.diff(\n                        &format!(\"sweep/len={len}/start={start:?}/stop={stop:?}\"),\n                        &s,\n                        start,\n                        stop,\n                    );\n                }\n            }\n        }\n        note(&format!(\"cfg_32 performed {} differential checks\", e.checks));\n    });\n}\n\n/// Row 33: an interleaved sequence of accepted and rejected calls across all\n/// four pointer modes, compared as a single stdout blob — error text and slice\n/// text share one stream, so their ordering is observable.\n#[test]\nfn cfg_33_mixed_valid_and_rejected_sequence() {\n    let mut rng = Rng::new(SEED ^ 33);\n    let mut cases: Vec<(Vec<u8>, Option<i32>, Option<i32>)> = Vec::new();\n    for _ in 0..300 {\n        let class = SHORT_CLASSES[rng.below(SHORT_CLASSES.len() as u64) as usize];\n        let len = class.pick(&mut rng);\n        let kind = ALL_CONTENT[rng.below(ALL_CONTENT.len() as u64) as usize];\n        let s = gen(&mut rng, len, kind);\n        let n = s.len() as i32;\n        // Bounds drawn from a range that deliberately overshoots and undershoots.\n        let pick = |r: &mut Rng| -> Option<i32> {\n            match r.below(6) {\n                0 => None,\n                1 => Some(-1),\n                2 => Some(n + 1),\n                3 => Some(i32::MIN),\n                4 => Some(i32::MAX),\n                _ => Some(r.range_i32(0, n)),\n            }\n        };\n        let start = pick(&mut rng);\n        let stop = pick(&mut rng);\n        cases.push((s, start, stop));\n    }\n    with_env(|e| e.diff_sequence(\"mixed/sequence\", &cases));\n}\n\n/// Row 34: the bounds live in one `int[2]`, i.e. adjacent storage reached\n/// through two pointers into the same object.\n#[test]\nfn cfg_34_bounds_in_one_array() {\n    let mut rng = Rng::new(SEED ^ 34);\n    with_env(|e| {\n        for i in 0..128 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng).max(1);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let n = s.len() as i32;\n            let start = rng.range_i32(0, n - 1);\n            let stop = rng.range_i32(start + 1, n);\n            e.diff_adjacent(&format!(\"adjacent/{i}\"), &s, start, stop);\n        }\n        // Also the rejecting arrangements through the same shape.\n        e.diff_adjacent(\"adjacent/equal\", b\"abcdef\", 3, 3);\n        e.diff_adjacent(\"adjacent/reversed\", b\"abcdef\", 4, 2);\n        e.diff_adjacent(\"adjacent/offend\", b\"abcdef\", 0, 7);\n    });\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
