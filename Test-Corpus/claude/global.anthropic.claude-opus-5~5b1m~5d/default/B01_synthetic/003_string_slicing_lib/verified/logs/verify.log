nterleaving with any other C output in the host process — are\n35\t//! byte-for-byte identical to the original library.\n36\t\n37\t// The crate/library name mirrors the C target name (`libString_Slice.so`).\n38\t#![allow(non_snake_case)]\n39\t#![allow(clippy::missing_safety_doc)]\n40\t\n41\tuse core::ffi::{c_char, c_int};\n42\t\n43\tunsafe extern \"C\" {\n44\t    /// `size_t strlen(const char *s)`\n45\t    fn strlen(s: *const c_char) -> usize;\n46\t\n47\t    /// `int printf(const char *restrict format, ...)`\n48\t    fn printf(format: *const c_char, ...) -> c_int;\n49\t}\n50\t\n51\t// NUL-terminated format strings, byte-identical to the C source literals.\n52\tconst ERR_START_OFF_END: &[u8] = b\"Error: start is off the end of the string!\\n\\0\";\n53\tconst ERR_STOP_OFF_END: &[u8] = b\"Error: stop is off the end of the string!\\n\\0\";\n54\tconst ERR_STOP_BEFORE_START: &[u8] = b\"Error: stop must come after start!\\n\\0\";\n55\tconst FMT_SLICE: &[u8] = b\"%.*s\\n\\0\";\n56\t\n57\t/// Writes a NUL-terminated literal through the C library's `printf`.\n58\t///\n59\t/// The literals above contain no `%` conversions, so this reproduces the\n60\t/// original `printf(\"...\")` calls exactly.\n61\t#[inline]\n62\tfn print_literal(literal: &[u8]) {\n63\t    // SAFETY: `literal` is a `'static`, NUL-terminated byte string with no\n64\t    // format conversions.\n65\t    unsafe {\n66\t        printf(literal.as_ptr() as *const c_char);\n67\t    }\n68\t}\n69\t\n70\t/// Index into a passed string and print the substring indexed by\n71\t/// `[*start_ptr, *stop_ptr)`.\n72\t///\n73\t/// If there is no start, use 0. If there is no stop, use the end of the string.\n74\t///\n75\t/// Returns `0` on success and `1` if a bound was rejected.\n76\t///\n77\t/// # Safety\n78\t///\n79\t/// `mystr` must be a valid pointer to a NUL-terminated string, and\n80\t/// `start_ptr` / `stop_ptr` must each be either null or point to a readable\n81\t/// `int`. These are exactly the requirements imposed by the C original.\n82\t#[unsafe(no_mangle)]\n83\tpub unsafe extern \"C\" fn slice(\n84\t    mystr: *mut c_char,\n85\t    start_ptr: *mut c_int,\n86\t    stop_ptr: *mut c_int,\n87\t) -> c_int {\n88\t    // size_t len = strlen(mystr);\n89\t    let len: usize = unsafe { strlen(mystr) };\n90\t\n91\t    let start: c_int;\n92\t    let stop: c_int;\n93\t\n94\t    if !start_ptr.is_null() {\n95\t        // start = *start_ptr;\n96\t        start = unsafe { *start_ptr };\n97\t\n98\t        // C: `start > len` compares an `int` against a `size_t`. The usual\n99\t        // arithmetic conversions promote `start` to `size_t`, so a negative\n100\t        // `start` wraps to a huge unsigned value and is rejected here. Casting\n101\t        // `c_int` to `usize` in Rust sign-extends first, reproducing this.\n102\t        if (start as usize) > len {\n103\t            print_literal(ERR_START_OFF_END);\n104\t            return 1;\n105\t        }\n106\t    } else {\n107\t        start = 0;\n108\t    }\n109\t\n110\t    if !stop_ptr.is_null() {\n111\t        // stop = *stop_ptr;\n112\t        let requested_stop: c_int = unsafe { *stop_ptr };\n113\t\n114\t        // Same `int` vs. `size_t` comparison quirk as for `start`.\n115\t        if (requested_stop as usize) > len {\n116\t            print_literal(ERR_STOP_OFF_END);\n117\t            return 1;\n118\t        }\n119\t\n120\t        // This comparison, unlike the one above, is a plain signed `int`\n121\t        // comparison in the C source.\n122\t        if requested_stop <= start {\n123\t            print_literal(ERR_STOP_BEFORE_START);\n124\t            return 1;\n125\t        }\n126\t\n127\t        stop = requested_stop;\n128\t    } else {\n129\t        // single-line else statement just to make style checking sad\n130\t        // `stop = len;` truncates `size_t` to `int`.\n131\t        stop = len as c_int;\n132\t    }\n133\t\n134\t    // char arithmetic: skip ahead `start` characters in the array\n135\t    // printf(\"%.*s\\n\", stop - start, mystr + start);\n136\t    //\n137\t    // SAFETY: `start` is within `[0, len]` on every path that reaches here, so\n138\t    // `mystr + start` stays inside the string (one-past-the-end at worst), and\n139\t    // the precision `stop - start` never exceeds the remaining length.\n140\t    unsafe {\n141\t        printf(\n142\t            FMT_SLICE.as_ptr() as *const c_char,\n143\t            stop.wrapping_sub(start),\n144\t            mystr.wrapping_offset(start as isize),\n145\t        );\n146\t    }\n147\t\n148\t    0\n149\t}\n150\t"}]},"parent_tool_use_id":null,"session_id":"1bb4f197-1782-4f38-9534-b9fc0dce3610","uuid":"f0c750a1-443e-4be6-8a64-6542e582ba98","timestamp":"2026-08-28T08:54:14.531Z","tool_use_result":{"type":"text","file":{"filePath":"translation/src/lib.rs","content":"// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n//! Rust translation of the `String_Slice` C library (`c_src/src/slicing.c`).\n//!\n//! The single public entry point is [`slice`], which mirrors\n//! `int slice(char *mystr, int *start_ptr, int *stop_ptr)` exactly, including\n//! its diagnostic messages, its ordering of validation checks, and its quirks\n//! (notably the signed/unsigned comparison of `int` bounds against the\n//! `size_t` string length).\n//!\n//! Output is emitted through the platform C library's `printf` so that the\n//! bytes written to `stdout` — and the stream buffering behaviour that governs\n//! their interleaving with any other C output in the host process — are\n//! byte-for-byte identical to the original library.\n\n// The crate/library name mirrors the C target name (`libString_Slice.so`).\n#![allow(non_snake_case)]\n#![allow(clippy::missing_safety_doc)]\n\nuse core::ffi::{c_char, c_int};\n\nunsafe extern \"C\" {\n    /// `size_t strlen(const char *s)`\n    fn strlen(s: *const c_char) -> usize;\n\n    /// `int printf(const char *restrict format, ...)`\n    fn printf(format: *const c_char, ...) -> c_int;\n}\n\n// NUL-terminated format strings, byte-identical to the C source literals.\nconst ERR_START_OFF_END: &[u8] = b\"Error: start is off the end of the string!\\n\\0\";\nconst ERR_STOP_OFF_END: &[u8] = b\"Error: stop is off the end of the string!\\n\\0\";\nconst ERR_STOP_BEFORE_START: &[u8] = b\"Error: stop must come after start!\\n\\0\";\nconst FMT_SLICE: &[u8] = b\"%.*s\\n\\0\";\n\n/// Writes a NUL-terminated literal through the C library's `printf`.\n///\n/// The literals above contain no `%` conversions, so this reproduces the\n/// original `printf(\"...\")` calls exactly.\n#[inline]\nfn print_literal(literal: &[u8]) {\n    // SAFETY: `literal` is a `'static`, NUL-terminated byte string with no\n    // format conversions.\n    unsafe {\n        printf(literal.as_ptr() as *const c_char);\n    }\n}\n\n/// Index into a passed string and print the substring indexed by\n/// `[*start_ptr, *stop_ptr)`.\n///\n/// If there is no start,