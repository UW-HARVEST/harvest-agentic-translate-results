afe { *start_ptr }; if v < 0 { 0 } else { v } };'\n\nmutate \"stop bound compared as signed int (drops the size_t promotion quirk)\" \\\n       'if (requested_stop as usize) > len {' \\\n       'if requested_stop > len as c_int {'\n\nmutate \"ordering check '<=' -> '<' (would accept stop == start)\" \\\n       'if requested_stop <= start {' \\\n       'if requested_stop < start {'\n\nmutate \"the two stop checks evaluated in the opposite order\" \\\n       '        if (requested_stop as usize) > len {\n            print_literal(ERR_STOP_OFF_END);\n            return 1;\n        }' \\\n       '        if requested_stop <= start && (requested_stop as usize) <= len {\n            print_literal(ERR_STOP_BEFORE_START);\n            return 1;\n        }\n        if (requested_stop as usize) > len {\n            print_literal(ERR_STOP_OFF_END);\n            return 1;\n        }'\n\nmutate \"one byte changed in the 'stop must come after start' diagnostic\" \\\n       'b\"Error: stop must come after start!\\n\\0\"' \\\n       'b\"Error: stop must come after Start!\\n\\0\"'\n\nmutate \"default stop uses len - 1 instead of len\" \\\n       'stop = len as c_int;' \\\n       'stop = (len as c_int).saturating_sub(1).max(0);'\n\nmutate \"slice printed without the precision (whole tail instead of the window)\" \\\n       'FMT_SLICE: &[u8] = b\"%.*s\\n\\0\"' \\\n       'FMT_SLICE: &[u8] = b\"%s\\n\\0\"'\n\nmutate \"trailing newline dropped from the slice output\" \\\n       'FMT_SLICE: &[u8] = b\"%.*s\\n\\0\"' \\\n       'FMT_SLICE: &[u8] = b\"%.*s\\0\"'\n\nmutate \"success return value 1 instead of 0\" \\\n       '    0\n}' \\\n       '    1\n}'\n\nrestore\ntrap - EXIT\ncargo build --offline >/dev/null 2>&1\ncargo build --offline --release >/dev/null 2>&1\n\necho \"=== $n mutations attempted ===\"\nif [ \"$fail\" -ne 0 ]; then\n    echo \"RESULT: FAILED — at least one injected divergence slipped through.\"\n    exit 1\nfi\necho \"RESULT: all $n injected divergences were detected; the suite is not vacuous.\"\n","structuredPatch":[{"oldStart":62,"oldLines":12,"newStart":62,"newLines":12,"lines":["        'if requested_stop <= start {' \\","        'if requested_stop < start {'"," ","-mutate \"the two stop checks evaluated in the opposite order\" \\","+mutate \"the two stop checks evaluated in the opposite order (changes which diagnostic a negative stop gets)\" \\","        '        if (requested_stop as usize) > len {","             print_literal(ERR_STOP_OFF_END);","             return 1;","         }' \\","-       '        if requested_stop <= start && (requested_stop as usize) <= len {","+       '        if requested_stop <= start {","             print_literal(ERR_STOP_BEFORE_START);","             return 1;","         }"]},{"oldStart":76,"oldLines":6,"newStart":76,"newLines":16,"lines":["             return 1;","         }'"," ","+mutate \"start rejected before its bound is even read (start check moved after the stop checks)\" \\","+       'if (start as usize) > len {","+            print_literal(ERR_START_OFF_END);","+            return 1;","+        }' \\","+       'if (start as usize) > len && stop_ptr.is_null() {","+            print_literal(ERR_START_OFF_END);","+            return 1;","+        }'","+"," mutate \"one byte changed in the 'stop must come after start' diagnostic\" \\","        'b\"Error: stop must come after start!\\n\\0\"' \\","        'b\"Error: stop must come after Start!\\n\\0\"'"]}],"userModified":false,"replaceAll":false}}
