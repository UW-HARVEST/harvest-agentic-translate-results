#[test]\nfn err_19_empty_both_zero() {\n    with_env(|e| {\n        expect_c_rejection(e, \"empty/start=0/stop=0\", b\"\", Some(0), Some(0), E_ORDER);\n    });\n}\n\n#[test]\nfn err_20_both_at_len() {\n    let mut rng = Rng::new(SEED ^ 120);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let n = s.len() as i32;\n            expect_c_rejection(\n                e,\n                &format!(\"start=stop=len={n}/{i}\"),\n                &s,\n                Some(n),\n                Some(n),\n                E_ORDER,\n            );\n        }\n        let big = gen(&mut rng, 1 << 20, Content::Ascii);\n        let n = big.len() as i32;\n        expect_c_rejection(e, \"huge/start=stop=len\", &big, Some(n), Some(n), E_ORDER);\n    });\n}\n\n#[test]\nfn err_21_aliased_pointers() {\n    let mut rng = Rng::new(SEED ^ 121);\n    with_env(|e| {\n        for i in 0..128 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let v = rng.range_i32(0, s.len() as i32);\n            // start_ptr == stop_ptr ⇒ stop == start ⇒ the ordering rejection.\n            e.diff_aliased(&format!(\"aliased/{i}(v={v})\"), &s, v);\n        }\n        // Out-of-range aliased values take the earlier branches instead.\n        for v in [-1i32, i32::MIN, i32::MAX, 100] {\n            e.diff_aliased(&format!(\"aliased/oob/{v}\"), b\"abcdef\", v);\n        }\n    });\n}\n\n// ---------------------------------------------------------------------------\n// Rows 22–25: branch precedence\n// ---------------------------------------------------------------------------\n\n#[test]\nfn err_22_precedence_start_before_stop() {\n    let mut rng = Rng::new(SEED ^ 122);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let n = s.len() as i32;\n            // BOTH bounds are off the end; only the *start* message must appear.\n            expect_c_rejection(\n                e,\n                &format!(\"both=len+1/{i}\"),\n                &s,\n                Some(n + 1),\n                Some(n + 1),\n                E_START,\n            );\n            expect_c_rejection(\n                e,\n                &format!(\"start=len+1,stop=INT_MAX/{i}\"),\n                &s,\n                Some(n + 1),\n                Some(i32::MAX),\n                E_START,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_23_precedence_both_negative() {\n    let mut rng = Rng::new(SEED ^ 123);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            expect_c_rejection(\n                e,\n                &format!(\"both=-1/{i}\"),\n                &s,\n                Some(-1),\n                Some(-1),\n                E_START,\n            );\n            expect_c_rejection(\n                e,\n                &format!(\"both=INT_MIN/{i}\"),\n                &s,\n                Some(i32::MIN),\n                Some(i32::MIN),\n                E_START,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_24_precedence_stop_offend_before_order() {\n    let mut rng = Rng::new(SEED ^ 124);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng).max(1);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let n = s.len() as i32;\n            let start = rng.range_i32(0, n);\n            // stop = -1 is simultaneously \"off the end\" (unsigned promotion) and\n            // \"<= start\"; the off-the-end branch must win.\n            expect_c_rejection(\n                e,\n                &format!(\"start={start},stop=-1/{i}\"),\n                &s,\n                Some(start),\n                Some(-1),\n                E_STOP,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_25_precedence_stop_offend_at_top() {\n    let mut rng = Rng::new(SEED ^ 125);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let n = s.len() as i32;\n            // start == len (valid) and stop == len+1 (off the end).\n            expect_c_rejection(\n                e,\n                &format!(\"start=len,stop=len+1/{i}\"),\n                &s,\n                Some(n),\n                Some(n + 1),\n                E_STOP,\n            );\n        }\n    });\n}\n\n// ---------------------------------------------------------------------------\n// Row 26 + generic boundary G4: dense boundary sweep and the null string\n// ---------------------------------------------------------------------------\n\n/// One step past a valid range on both sides of both bounds, densely, for many\n/// lengths — the arithmetic of the three branches, exhaustively.\n#[test]\nfn err_boundary_sweep_one_past_range() {\n    let mut rng = Rng::new(SEED ^ 126);\n    with_env(|e| {\n        for len in 0usize..=12 {\n            let s = gen(&mut rng, len, Content::Mixed);\n            let n = len as i32;\n            let vals: Vec<Option<i32>> = [\n                None,\n                Some(i32::MIN),\n                Some(i32::MIN + 1),\n                Some(-2),\n                Some(-1),\n                Some(0),\n                Some(1),\n                Some(n - 1),\n                Some(n),\n                Some(n + 1),\n                Some(n + 2),\n                Some(i32::MAX - 1),\n                Some(i32::MAX),\n            ]\n            .into_iter()\n            .collect();\n            for &start in &vals {\n                for &stop in &vals {\n                    e.diff(\n                        &format!(\"bsweep/len={len}/start={start:?}/stop={stop:?}\"),\n                        &s,\n                        start,\n                        stop,\n                    );\n                }\n            }\n        }\n        note(&format!(\"boundary sweep performed {} checks\", e.checks));\n    });\n}\n\n/// `ERRORS.md` row 26 — `mystr == NULL`. `strlen(NULL)` dereferences the null\n/// page, so this is a fatal signal rather than a return value. Both `.so`s must\n/// die the same way, which can only be observed from a separate process, so the\n/// test re-executes itself as a child with a selector in the environment and\n/// compares the two children's terminations.\n#[test]\nfn err_26_null_string_segv() {\n    let c = run_null_child(\"c\");\n    let r = run_null_child(\"rust\");\n    assert_eq!(\n        c, r,\n        \"slice(NULL, ...) terminated differently: C child = {c:?}, Rust child = {r:?}\"\n    );\n    // Guard against the \"both merely failed\" trap: assert the shared outcome is\n    // the expected fatal signal (SIGSEGV = 11), not, say, a clean exit.\n    assert_eq!(\n        c,\n        ChildOutcome::Signal(11),\n        \"expected slice(NULL, ..) to raise SIGSEGV in both implementations, got {c:?}\"\n    );\n}\n\n#[derive(Debug, PartialEq, Eq)]\nenum ChildOutcome {\n    Exit(i32),\n    Signal(i32),\n}\n\nfn run_null_child(which: &str) -> ChildOutcome {\n    use std::os::unix::process::ExitStatusExt;\n    let exe = std::env::current_exe().expect(\"current_exe\");\n    let out = std::process::Command::new(exe)\n        .arg(\"--exact\")\n        .arg(\"phase_c_errors_null_child_helper\")\n        .env(\"SLICE_NULL_CHILD\", which)\n        .env(\"RUST_BACKTRACE\", \"0\")\n        .output()\n        .expect(\"spawn child\");\n    match out.status.code() {\n        Some(code) => ChildOutcome::Exit(code),\n        None => ChildOutcome::Signal(out.status.signal().unwrap_or(-1)),\n    }\n}\n\n/// Helper invoked only in the child process spawned by `err_26_null_string_segv`.\n/// In the parent it is a no-op, so it is harmless when the suite runs normally.\n#[test]\nfn phase_c_errors_null_child_helper() {\n    let which = match std::env::var(\"SLICE_NULL_CHILD\") {\n        Ok(v) => v,\n        Err(_) => return, // parent run: nothing to do\n    };\n    let f = pick_impl(&which);\n    // SAFETY: none — this is the point. The C library does the same thing.\n    let ret = unsafe { f(std::ptr::null_mut(), std::ptr::null_mut(), std::ptr::null_mut()) };\n    // If we get here the implementation did NOT fault; report that distinctly so\n    // the parent's comparison can see it.\n    std::process::exit(100 + (ret & 0x7f));\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
