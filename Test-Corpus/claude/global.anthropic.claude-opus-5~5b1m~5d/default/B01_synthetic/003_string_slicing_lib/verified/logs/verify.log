{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_njvcsrxqrbdc4ewoevhvwyhvzbxd57apgrre6a36jyqg5fzu4ixq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01JQHPoeJjSHrdv1qwfj4e8b","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-km0prT/translation/tests/phase_c_errors.rs","content":"//! Phase C — error-path differential tests, one test per `ERRORS.md` row.\n//!\n//! Each test constructs the exact rejecting condition, calls BOTH `.so`s and\n//! requires the SAME rejection: identical `int` return value *and* identical\n//! diagnostic bytes on stdout. Asserting only \"both failed\" would not\n//! distinguish `slice`'s three different `return 1` sites from one another,\n//! since they all return the same code and differ only in the message — so the\n//! message bytes are what pin the branch down.\n\nmod common;\n\nuse common::*;\n\nconst E_START: &[u8] = b\"Error: start is off the end of the string!\\n\";\nconst E_STOP: &[u8] = b\"Error: stop is off the end of the string!\\n\";\nconst E_ORDER: &[u8] = b\"Error: stop must come after start!\\n\";\n\n/// Sanity check that the C library really does return 1 and print the expected\n/// diagnostic, so that a Rust implementation which merely *also* rejected (with\n/// a different message or code) could not pass. Run once per label.\nfn expect_c_rejection(e: &mut Env, label: &str, s: &[u8], start: Option<i32>, stop: Option<i32>, msg: &[u8]) {\n    // Establish the C ground truth first, then let `diff` prove Rust matches.\n    let mut observed: Option<(i32, Vec<u8>)> = None;\n    {\n        let mut probe = |f: SliceFn| -> (i32, Vec<u8>) {\n            let mut buf = s.to_vec();\n            buf.push(0);\n            let mut sv = start.unwrap_or(0);\n            let mut tv = stop.unwrap_or(0);\n            let sp = if start.is_some() {\n                &mut sv as *mut i32\n            } else {\n                std::ptr::null_mut()\n            };\n            let tp = if stop.is_some() {\n                &mut tv as *mut i32\n            } else {\n                std::ptr::null_mut()\n            };\n            let ret = unsafe { f(buf.as_mut_ptr() as *mut std::ffi::c_char, sp, tp) };\n            buf.pop();\n            (ret, buf)\n        };\n        e.diff_raw_recording(label, &mut probe, &mut observed);\n    }\n    let (ret, out) = observed.expect(\"recorded outcome\");\n    assert_eq!(\n        ret, 1,\n        \"[{label}] the C library was expected to reject this input with 1, got {ret}\"\n    );\n    assert_eq!(\n        out,\n        msg,\n        \"[{label}] the C library printed {:?}, expected {:?}\",\n        String::from_utf8_lossy(&out),\n        String::from_utf8_lossy(msg)\n    );\n}\n\n// ---------------------------------------------------------------------------\n// Rows 1–7: `start` rejected by `if (start > len)` (L45)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn err_01_start_one_past_end() {\n    let mut rng = Rng::new(SEED ^ 101);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let start = s.len() as i32 + 1;\n            expect_c_rejection(e, &format!(\"start=len+1/{i}\"), &s, Some(start), None, E_START);\n            // …and with every stop arrangement: the start check fires first.\n            e.diff(&format!(\"start=len+1/{i}/stopnull\"), &s, Some(start), None);\n            e.diff(&format!(\"start=len+1/{i}/stop0\"), &s, Some(start), Some(0));\n            e.diff(\n                &format!(\"start=len+1/{i}/stoplen\"),\n                &s,\n                Some(start),\n                Some(s.len() as i32),\n            );\n        }\n    });\n}\n\n#[test]\nfn err_02_start_far_past_end() {\n    let mut rng = Rng::new(SEED ^ 102);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let start = s.len() as i32 + rng.range_i32(2, 1000);\n            expect_c_rejection(e, &format!(\"start>>len/{i}\"), &s, Some(start), None, E_START);\n        }\n        // Oversized bound against an oversized string (1 MiB).\n        let big = gen(&mut rng, 1 << 20, Content::Ascii);\n        let n = big.len() as i32;\n        for d in [1i32, 2, 1000, 1 << 20] {\n            expect_c_rejection(e, &format!(\"huge/start=len+{d}\"), &big, Some(n + d), None, E_START);\n        }\n    });\n}\n\n#[test]\nfn err_03_start_int_max() {\n    let mut rng = Rng::new(SEED ^ 103);\n    with_env(|e| {\n        for i in 0..32 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Mixed);\n            expect_c_rejection(e, &format!(\"start=INT_MAX/{i}\"), &s, Some(i32::MAX), None, E_START);\n            e.diff(&format!(\"start=INT_MAX/{i}/b\"), &s, Some(i32::MAX), Some(1));\n            e.diff(\n                &format!(\"start=INT_MAX/{i}/c\"),\n                &s,\n                Some(i32::MAX),\n                Some(i32::MAX),\n            );\n            e.diff(\n                &format!(\"start=INT_MAX-1/{i}\"),\n                &s,\n                Some(i32::MAX - 1),\n                None,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_04_start_negative_one() {\n    let mut rng = Rng::new(SEED ^ 104);\n    with_env(|e| {\n        for i in 0..48 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Mixed);\n            // NOTE: `-1` is rejected by the *off the end* branch, because the C\n            // compares `int` against `size_t`; it never reaches `stop <= start`.\n            expect_c_rejection(e, &format!(\"start=-1/{i}\"), &s, Some(-1), None, E_START);\n            e.diff(&format!(\"start=-1/{i}/stop1\"), &s, Some(-1), Some(1));\n            e.diff(\n                &format!(\"start=-1/{i}/stoplen\"),\n                &s,\n                Some(-1),\n                Some(s.len() as i32),\n            );\n        }\n    });\n}\n\n#[test]\nfn err_05_start_int_min() {\n    let mut rng = Rng::new(SEED ^ 105);\n    with_env(|e| {\n        for i in 0..32 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Mixed);\n            expect_c_rejection(e, &format!(\"start=INT_MIN/{i}\"), &s, Some(i32::MIN), None, E_START);\n            e.diff(\n                &format!(\"start=INT_MIN/{i}/stopmin\"),\n                &s,\n                Some(i32::MIN),\n                Some(i32::MIN),\n            );\n            e.diff(\n                &format!(\"start=INT_MIN+1/{i}\"),\n                &s,\n                Some(i32::MIN + 1),\n                None,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_06_start_random_negative() {\n    let mut rng = Rng::new(SEED ^ 106);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let start = rng.range_i32(i32::MIN, -1);\n            expect_c_rejection(\n                e,\n                &format!(\"start={start}/{i}\"),\n                &s,\n                Some(start),\n                None,\n                E_START,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_07_empty_start_one() {\n    with_env(|e| {\n        for start in [1i32, 2, 7, 1000, i32::MAX, -1, i32::MIN] {\n            expect_c_rejection(\n                e,\n                &format!(\"empty/start={start}\"),\n                b\"\",\n                Some(start),\n                None,\n                E_START,\n            );\n            e.diff(&format!(\"empty/start={start}/stop0\"), b\"\", Some(start), Some(0));\n        }\n    });\n}\n\n// ---------------------------------------------------------------------------\n// Rows 8–14: `stop` rejected by `if (stop > len)` (L55)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn err_08_stop_one_past_end() {\n    let mut rng = Rng::new(SEED ^ 108);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let stop = s.len() as i32 + 1;\n            // start omitted…\n            expect_c_rejection(e, &format!(\"stop=len+1/{i}/nostart\"), &s, None, Some(stop), E_STOP);\n            // …and with a valid explicit start, including the top boundary.\n            for start in [0i32, s.len() as i32] {\n                expect_c_rejection(\n                    e,\n                    &format!(\"stop=len+1/{i}/start={start}\"),\n                    &s,\n                    Some(start),\n                    Some(stop),\n                    E_STOP,\n                );\n            }\n        }\n    });\n}\n\n#[test]\nfn err_09_stop_far_past_end() {\n    let mut rng = Rng::new(SEED ^ 109);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let stop = s.len() as i32 + rng.range_i32(2, 1000);\n            expect_c_rejection(e, &format!(\"stop>>len/{i}\"), &s, None, Some(stop), E_STOP);\n        }\n        let big = gen(&mut rng, 1 << 20, Content::Ascii);\n        let n = big.len() as i32;\n        for d in [1i32, 2, 1000, 1 << 20] {\n            expect_c_rejection(e, &format!(\"huge/stop=len+{d}\"), &big, None, Some(n + d), E_STOP);\n        }\n    });\n}\n\n#[test]\nfn err_10_stop_int_max() {\n    let mut rng = Rng::new(SEED ^ 110);\n    with_env(|e| {\n        for i in 0..32 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Mixed);\n            expect_c_rejection(e, &format!(\"stop=INT_MAX/{i}\"), &s, None, Some(i32::MAX), E_STOP);\n            e.diff(\n                &format!(\"stop=INT_MAX-1/{i}\"),\n                &s,\n                Some(0),\n                Some(i32::MAX - 1),\n            );\n        }\n    });\n}\n\n#[test]\nfn err_11_stop_negative_one() {\n    let mut rng = Rng::new(SEED ^ 111);\n    with_env(|e| {\n        for i in 0..48 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Mixed);\n            // A negative stop looks like \"before start\" to a naive reader, but\n            // the C rejects it as *off the end* thanks to the size_t promotion.\n            expect_c_rejection(e, &format!(\"stop=-1/{i}/nostart\"), &s, None, Some(-1), E_STOP);\n            expect_c_rejection(\n                e,\n                &format!(\"stop=-1/{i}/start0\"),\n                &s,\n                Some(0),\n                Some(-1),\n                E_STOP,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_12_stop_int_min() {\n    let mut rng = Rng::new(SEED ^ 112);\n    with_env(|e| {\n        for i in 0..32 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Mixed);\n            expect_c_rejection(e, &format!(\"stop=INT_MIN/{i}\"), &s, None, Some(i32::MIN), E_STOP);\n            e.diff(\n                &format!(\"stop=INT_MIN+1/{i}\"),\n                &s,\n                Some(0),\n                Some(i32::MIN + 1),\n            );\n        }\n    });\n}\n\n#[test]\nfn err_13_stop_random_negative() {\n    let mut rng = Rng::new(SEED ^ 113);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let stop = rng.range_i32(i32::MIN, -1);\n            expect_c_rejection(e, &format!(\"stop={stop}/{i}\"), &s, None, Some(stop), E_STOP);\n        }\n    });\n}\n\n#[test]\nfn err_14_empty_stop_one() {\n    with_env(|e| {\n        for stop in [1i32, 2, 1000, i32::MAX, -1, i32::MIN] {\n            expect_c_rejection(e, &format!(\"empty/stop={stop}\"), b\"\", None, Some(stop), E_STOP);\n            expect_c_rejection(\n                e,\n                &format!(\"empty/start0/stop={stop}\"),\n                b\"\",\n                Some(0),\n                Some(stop),\n                E_STOP,\n            );\n        }\n    });\n}\n\n// ---------------------------------------------------------------------------\n// Rows 15–21: rejected by `if (stop <= start)` (L59)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn err_15_stop_equals_start() {\n    let mut rng = Rng::new(SEED ^ 115);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let v = rng.range_i32(0, s.len() as i32);\n            expect_c_rejection(\n                e,\n                &format!(\"stop==start={v}/{i}\"),\n                &s,\n                Some(v),\n                Some(v),\n                E_ORDER,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_16_stop_below_start() {\n    let mut rng = Rng::new(SEED ^ 116);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng).max(1);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let n = s.len() as i32;\n            let start = rng.range_i32(1, n);\n            let stop = rng.range_i32(0, start - 1);\n            expect_c_rejection(\n                e,\n                &format!(\"stop={stop}<start={start}/{i}\"),\n                &s,\n                Some(start),\n                Some(stop),\n                E_ORDER,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_17_null_start_stop_zero() {\n    let mut rng = Rng::new(SEED ^ 117);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            expect_c_rejection(\n                e,\n                &format!(\"nostart/stop=0/{i}\"),\n                &s,\n                None,\n                Some(0),\n                E_ORDER,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_18_empty_stop_zero() {\n    with_env(|e| {\n        expect_c_rejection(e, \"empty/nostart/stop=0\", b\"\", None, Some(0), E_ORDER);\n        for i in 0..4 {\n            e.diff(&format!(\"empty/nostart/stop=0/rep{i}\"), b\"\", None, Some(0));\n        }\n    });\n}\n\n#[test]\nfn err_19_empty_both_zero() {\n    with_env(|e| {\n        expect_c_rejection(e, \"empty/start=0/stop=0\", b\"\", Some(0), Some(0), E_ORDER);\n    });\n}\n\n#[test]\nfn err_20_both_at_len() {\n    let mut rng = Rng::new(SEED ^ 120);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let n = s.len() as i32;\n            expect_c_rejection(\n                e,\n                &format!(\"start=stop=len={n}/{i}\"),\n                &s,\n                Some(n),\n                Some(n),\n                E_ORDER,\n            );\n        }\n        let big = gen(&mut rng, 1 << 20, Content::Ascii);\n        let n = big.len() as i32;\n        expect_c_rejection(e, \"huge/start=stop=len\", &big, Some(n), Some(n), E_ORDER);\n    });\n}\n\n#[test]\nfn err_21_aliased_pointers() {\n    let mut rng = Rng::new(SEED ^ 121);\n    with_env(|e| {\n        for i in 0..128 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let v = rng.range_i32(0, s.len() as i32);\n            // start_ptr == stop_ptr ⇒ stop == start ⇒ the ordering rejection.\n            e.diff_aliased(&format!(\"aliased/{i}(v={v})\"), &s, v);\n        }\n        // Out-of-range aliased values take the earlier branches instead.\n        for v in [-1i32, i32::MIN, i32::MAX, 100] {\n            e.diff_aliased(&format!(\"aliased/oob/{v}\"), b\"abcdef\", v);\n        }\n    });\n}\n\n// ---------------------------------------------------------------------------\n// Rows 22–25: branch precedence\n// ---------------------------------------------------------------------------\n\n#[test]\nfn err_22_precedence_start_before_stop() {\n    let mut rng = Rng::new(SEED ^ 122);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let n = s.len() as i32;\n            // BOTH bounds are off the end; only the *start* message must appear.\n            expect_c_rejection(\n                e,\n                &format!(\"both=len+1/{i}\"),\n                &s,\n                Some(n + 1),\n                Some(n + 1),\n                E_START,\n            );\n            expect_c_rejection(\n                e,\n                &format!(\"start=len+1,stop=INT_MAX/{i}\"),\n                &s,\n                Some(n + 1),\n                Some(i32::MAX),\n                E_START,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_23_precedence_both_negative() {\n    let mut rng = Rng::new(SEED ^ 123);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            expect_c_rejection(\n                e,\n                &format!(\"both=-1/{i}\"),\n                &s,\n                Some(-1),\n                Some(-1),\n                E_START,\n            );\n            expect_c_rejection(\n                e,\n                &format!(\"both=INT_MIN/{i}\"),\n                &s,\n                Some(i32::MIN),\n                Some(i32::MIN),\n                E_START,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_24_precedence_stop_offend_before_order() {\n    let mut rng = Rng::new(SEED ^ 124);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = [LenClass::One, LenClass::Small, LenClass::Medium][i % 3];\n            let len = class.pick(&mut rng).max(1);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let n = s.len() as i32;\n            let start = rng.range_i32(0, n);\n            // stop = -1 is simultaneously \"off the end\" (unsigned promotion) and\n            // \"<= start\"; the off-the-end branch must win.\n            expect_c_rejection(\n                e,\n                &format!(\"start={start},stop=-1/{i}\"),\n                &s,\n                Some(start),\n                Some(-1),\n                E_STOP,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_25_precedence_stop_offend_at_top() {\n    let mut rng = Rng::new(SEED ^ 125);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let n = s.len() as i32;\n            // start == len (valid) and stop == len+1 (off the end).\n            expect_c_rejection(\n                e,\n                &format!(\"start=len,stop=len+1/{i}\"),\n                &s,\n                Some(n),\n                Some(n + 1),\n                E_STOP,\n            );\n        }\n    });\n}\n\n// ---------------------------------------------------------------------------\n// Row 26 + generic boundary G4: dense boundary sweep and the null string\n// ---------------------------------------------------------------------------\n\n/// One step past a valid range on both sides of both bounds, densely, for many\n/// lengths — the arithmetic of the three branches, exhaustively.\n#[test]\nfn err_boundary_sweep_one_past_range() {\n    let mut rng = Rng::new(SEED ^ 126);\n    with_env(|e| {\n        for len in 0usize..=12 {\n            let s = gen(&mut rng, len, Content::Mixed);\n            let n = len as i32;\n            let vals: Vec<Option<i32>> = [\n                None,\n                Some(i32::MIN),\n                Some(i32::MIN + 1),\n                Some(-2),\n                Some(-1),\n                Some(0),\n                Some(1),\n                Some(n - 1),\n                Some(n),\n                Some(n + 1),\n                Some(n + 2),\n                Some(i32::MAX - 1),\n                Some(i32::MAX),\n            ]\n            .into_iter()\n            .collect();\n            for &start in &vals {\n                for &stop in &vals {\n                    e.diff(\n                        &format!(\"bsweep/len={len}/start={start:?}/stop={stop:?}\"),\n                        &s,\n                        start,\n                        stop,\n                    );\n                }\n            }\n        }\n        note(&format!(\"boundary sweep performed {} checks\", e.checks));\n    });\n}\n\n/// `ERRORS.md` row 26 — `mystr == NULL`. `strlen(NULL)` dereferences the null\n/// page, so this is a fatal signal rather than a return value. Both `.so`s must\n/// die the same way, which can only be observed from a separate process, so the\n/// test re-executes itself as a child with a selector in the environment and\n/// compares the two children's terminations.\n#[test]\nfn err_26_null_string_segv() {\n    let c = run_null_child(\"c\");\n    let r = run_null_child(\"rust\");\n    assert_eq!(\n        c, r,\n        \"slice(NULL, ...) terminated differently: C child = {c:?}, Rust child = {r:?}\"\n    );\n    // Guard against the \"both merely failed\" trap: assert the shared outcome is\n    // the expected fatal signal (SIGSEGV = 11), not, say, a clean exit.\n    assert_eq!(\n        c,\n        ChildOutcome::Signal(11),\n        \"expected slice(NULL, ..) to raise SIGSEGV in both implementations, got {c:?}\"\n    );\n}\n\n#[derive(Debug, PartialEq, Eq)]\nenum ChildOutcome {\n    Exit(i32),\n    Signal(i32),\n}\n\nfn run_null_child(which: &str) -> ChildOutcome {\n    use std::os::unix::process::ExitStatusExt;\n    let exe = std::env::current_exe().expect(\"current_exe\");\n    let out = std::process::Command::new(exe)\n        .arg(\"--exact\")\n        .arg(\"phase_c_errors_null_child_helper\")\n        .env(\"SLICE_NULL_CHILD\", which)\n        .env(\"RUST_BACKTRACE\", \"0\")\n        .output()\n        .expect(\"spawn child\");\n    match out.status.code() {\n        Some(code) => ChildOutcome::Exit(code),\n        None => ChildOutcome::Signal(out.status.signal().unwrap_or(-1)),\n    }\n}\n\n/// Helper invoked only in the child process spawned by `err_26_null_string_segv`.\n/// In the parent it is a no-op, so it is harmless when the suite runs normally.\n#[test]\nfn phase_c_errors_null_child_helper() {\n    let which = match std::env::var(\"SLICE_NULL_CHILD\") {\n        Ok(v) => v,\n        Err(_) => return, // parent run: nothing to do\n    };\n    let f = pick_impl(&which);\n    // SAFETY: none — this is the point. The C library does the same thing.\n    let ret = unsafe { f(std::ptr::null_mut(), std::ptr::null_mut(), std::ptr::null_mut()) };\n    // If we get here the implementation did NOT fault; report that distinctly so\n    // the parent's comparison can see it.\n    std::process::exit(100 + (ret & 0x7f));\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4809,"cache_read_input_tokens":75064,"cache_creation":{"ephemeral_5m_input_tokens":4809,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1bb4f197-1782-4f38-9534-b9fc0dce3610","uuid":"c22ffad7-118c-4f5d-b3e0-ad58afe07cdc","timestamp":"2026-08-28T09:05:27.085Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JQHPoeJjSHrdv1qwfj4e8b","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-km0prT/translation/tests/phase_c_errors.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1bb4f197-1782-4f38-9534-b9fc0dce3610","uuid":"f25df145-c31f-4136-91a2-caab836e7265","timestamp":"2026-08-28T09:05:27.681Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-km0prT/translation/tests/phase_c_errors.rs","content":"//! Phase C — error-path differential tests, one test per `ERRORS.md` row.\n//!\n//! Each test constructs the exact rejecting condition, calls BOTH `.so`s and\n//! requires the SAME rejection: identical `int` return value *and* identical\n//! diagnostic bytes on stdout. Asserting only \"both failed\" would not\n//! distinguish `slice`'s three different `return 1` sites from one another,\n//! since they all return the same code and differ only in the message — so the\n//! message bytes are what pin the branch down.\n\nmod common;\n\nuse common::*;\n\nconst E_START: &[u8] = b\"Error: start is off the end of the string!\\n\";\nconst E_STOP: &[u8] = b\"Error: stop is off the end of the string!\\n\";\nconst E_ORDER: &[u8] = b\"Error: stop must come after start!\\n\";\n\n/// Sanity check that the C library really does return 1 and print the expected\n/// diagnostic, so that a Rust implementation which merely *also* rejected (with\n/// a different message or code) could not pass. Run once per label.\nfn expect_c_rejection(e: &mut Env, label: &str, s: &[u8], start: Option<i32>, stop: Option<i32>, msg: &[u8]) {\n    // Establish the C ground truth first, then let `diff` prove Rust matches.\n    let mut observed: Option<(i32, Vec<u8>)> = None;\n    {\n        let mut probe = |f: SliceFn| -> (i32, Vec<u8>) {\n            let mut buf = s.to_vec();\n            buf.push(0);\n            let mut sv = start.unwrap_or(0);\n            let mut tv = stop.unwrap_or(0);\n            let sp = if start.is_some() {\n                &mut sv as *mut i32\n            } else {\n                std::ptr::null_mut()\n            };\n            let tp = if stop.is_some() {\n                &mut tv as *mut i32\n            } else {\n                std::ptr::null_mut()\n            };\n            let ret = unsafe { f(buf.as_mut_ptr() as *mut std::ffi::c_char, sp, tp) };\n            buf.pop();\n            (ret, buf)\n        };\n        e.diff_raw_recording(label, &mut probe, &mut observed);\n    }\n    let (ret, out) = observed.expect(\"recorded outcome\");\n    assert_eq!(\n        ret, 1,\n        \"[{label}] the C library was expected to reject this input with 1, got {ret}\"\n    );\n    assert_eq!(\n        out,\n        msg,\n        \"[{label}] the C library printed {:?}, expected {:?}\",\n        String::from_utf8_lossy(&out),\n        String::from_utf8_lossy(msg)\n    );\n}\n\n// ---------------------------------------------------------------------------\n// Rows 1–7: `start` rejected by `if (start > len)` (L45)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn err_01_start_one_past_end() {\n    let mut rng = Rng::new(SEED ^ 101);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let start = s.len() as i32 + 1;\n            expect_c_rejection(e, &format!(\"start=len+1/{i}\"), &s, Some(start), None, E_START);\n            // …and with every stop arrangement: the start check fires first.\n            e.diff(&format!(\"start=len+1/{i}/stopnull\"), &s, Some(start), None);\n            e.diff(&format!(\"start=len+1/{i}/stop0\"), &s, Some(start), Some(0));\n            e.diff(\n                &format!(\"start=len+1/{i}/stoplen\"),\n                &s,\n                Some(start),\n                Some(s.len() as i32),\n            );\n        }\n    });\n}\n\n#[test]\nfn err_02_start_far_past_end() {\n    let mut rng = Rng::new(SEED ^ 102);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let start = s.len() as i32 + rng.range_i32(2, 1000);\n            expect_c_rejection(e, &format!(\"start>>len/{i}\"), &s, Some(start), None, E_START);\n        }\n        // Oversized bound against an oversized string (1 MiB).\n        let big = gen(&mut rng, 1 << 20, Content::Ascii);\n        let n = big.len() as i32;\n        for d in [1i32, 2, 1000, 1 << 20] {\n            expect_c_rejection(e, &format!(\"huge/start=len+{d}\"), &big, Some(n + d), None, E_START);\n        }\n    });\n}\n\n#[test]\nfn err_03_start_int_max() {\n    let mut rng = Rng::new(SEED ^ 103);\n    with_env(|e| {\n        for i in 0..32 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Mixed);\n            expect_c_rejection(e, &format!(\"start=INT_MAX/{i}\"), &s, Some(i32::MAX), None, E_START);\n            e.diff(&format!(\"start=INT_MAX/{i}/b\"), &s, Some(i32::MAX), Some(1));\n            e.diff(\n                &format!(\"start=INT_MAX/{i}/c\"),\n                &s,\n                Some(i32::MAX),\n                Some(i32::MAX),\n            );\n            e.diff(\n                &format!(\"start=INT_MAX-1/{i}\"),\n                &s,\n                Some(i32::MAX - 1),\n                None,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_04_start_negative_one() {\n    let mut rng = Rng::new(SEED ^ 104);\n    with_env(|e| {\n        for i in 0..48 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Mixed);\n            // NOTE: `-1` is rejected by the *off the end* branch, because the C\n            // compares `int` against `size_t`; it never reaches `stop <= start`.\n            expect_c_rejection(e, &format!(\"start=-1/{i}\"), &s, Some(-1), None, E_START);\n            e.diff(&format!(\"start=-1/{i}/stop1\"), &s, Some(-1), Some(1));\n            e.diff(\n                &format!(\"start=-1/{i}/stoplen\"),\n                &s,\n                Some(-1),\n                Some(s.len() as i32),\n            );\n        }\n    });\n}\n\n#[test]\nfn err_05_start_int_min() {\n    let mut rng = Rng::new(SEED ^ 105);\n    with_env(|e| {\n        for i in 0..32 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Mixed);\n            expect_c_rejection(e, &format!(\"start=INT_MIN/{i}\"), &s, Some(i32::MIN), None, E_START);\n            e.diff(\n                &format!(\"start=INT_MIN/{i}/stopmin\"),\n                &s,\n                Some(i32::MIN),\n                Some(i32::MIN),\n            );\n            e.diff(\n                &format!(\"start=INT_MIN+1/{i}\"),\n                &s,\n                Some(i32::MIN + 1),\n                None,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_06_start_random_negative() {\n    let mut rng = Rng::new(SEED ^ 106);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let start = rng.range_i32(i32::MIN, -1);\n            expect_c_rejection(\n                e,\n                &format!(\"start={start}/{i}\"),\n                &s,\n                Some(start),\n                None,\n                E_START,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_07_empty_start_one() {\n    with_env(|e| {\n        for start in [1i32, 2, 7, 1000, i32::MAX, -1, i32::MIN] {\n            expect_c_rejection(\n                e,\n                &format!(\"empty/start={start}\"),\n                b\"\",\n                Some(start),\n                None,\n                E_START,\n            );\n            e.diff(&format!(\"empty/start={start}/stop0\"), b\"\", Some(start), Some(0));\n        }\n    });\n}\n\n// ---------------------------------------------------------------------------\n// Rows 8–14: `stop` rejected by `if (stop > len)` (L55)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn err_08_stop_one_past_end() {\n    let mut rng = Rng::new(SEED ^ 108);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let stop = s.len() as i32 + 1;\n            // start omitted…\n            expect_c_rejection(e, &format!(\"stop=len+1/{i}/nostart\"), &s, None, Some(stop), E_STOP);\n            // …and with a valid explicit start, including the top boundary.\n            for start in [0i32, s.len() as i32] {\n                expect_c_rejection(\n                    e,\n                    &format!(\"stop=len+1/{i}/start={start}\"),\n                    &s,\n                    Some(start),\n                    Some(stop),\n                    E_STOP,\n                );\n            }\n        }\n    });\n}\n\n#[test]\nfn err_09_stop_far_past_end() {\n    let mut rng = Rng::new(SEED ^ 109);\n    with_env(|e| {\n        for i in 0..96 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Ascii);\n            let stop = s.len() as i32 + rng.range_i32(2, 1000);\n            expect_c_rejection(e, &format!(\"stop>>len/{i}\"), &s, None, Some(stop), E_STOP);\n        }\n        let big = gen(&mut rng, 1 << 20, Content::Ascii);\n        let n = big.len() as i32;\n        for d in [1i32, 2, 1000, 1 << 20] {\n            expect_c_rejection(e, &format!(\"huge/stop=len+{d}\"), &big, None, Some(n + d), E_STOP);\n        }\n    });\n}\n\n#[test]\nfn err_10_stop_int_max() {\n    let mut rng = Rng::new(SEED ^ 110);\n    with_env(|e| {\n        for i in 0..32 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Mixed);\n            expect_c_rejection(e, &format!(\"stop=INT_MAX/{i}\"), &s, None, Some(i32::MAX), E_STOP);\n            e.diff(\n                &format!(\"stop=INT_MAX-1/{i}\"),\n                &s,\n                Some(0),\n                Some(i32::MAX - 1),\n            );\n        }\n    });\n}\n\n#[test]\nfn err_11_stop_negative_one() {\n    let mut rng = Rng::new(SEED ^ 111);\n    with_env(|e| {\n        for i in 0..48 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Mixed);\n            // A negative stop looks like \"before start\" to a naive reader, but\n            // the C rejects it as *off the end* thanks to the size_t promotion.\n            expect_c_rejection(e, &format!(\"stop=-1/{i}/nostart\"), &s, None, Some(-1), E_STOP);\n            expect_c_rejection(\n                e,\n                &format!(\"stop=-1/{i}/start0\"),\n                &s,\n                Some(0),\n                Some(-1),\n                E_STOP,\n            );\n        }\n    });\n}\n\n#[test]\nfn err_12_stop_int_min() {\n    let mut rng = Rng::new(SEED ^ 112);\n    with_env(|e| {\n        for i in 0..32 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let s = gen(&mut rng, len, Content::Mixed);\n            expect_c_rejection(e, &format!(\"stop=INT_MIN/{i}\"), &s, None, Some(i32::MIN), E_STOP);\n            e.diff(\n                &format!(\"stop=INT_MIN+1/{i}\"),\n                &s,\n                Some(0),\n                Some(i32::MIN + 1),\n            );\n        }\n    });\n}\n\n#[test]\nfn err_13_stop_random_negative() {\n    let mut rng = Rng::new(SEED ^ 113);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.len()];\n            let s = gen(&mut rng, len, kind);\n            let stop = rng.range_i32(i32::MIN, -1);\n            expect_c_rejection(e, &format!(\"stop={stop}/{i}\"), &s, None, Some(stop), E_STOP);\n        }\n    });\n}\n\n#[test]\nfn err_14_empty_stop_one() {\n    with_env(|e| {\n        for stop in [1i32, 2, 1000, i32::MAX, -1, i32::MIN] {\n            expect_c_rejection(e, &format!(\"empty/stop={stop}\"), b\"\", None, Some(stop), E_STOP);\n            expect_c_rejection(\n                e,\n                &format!(\"empty/start0/stop={stop}\"),\n                b\"\",\n                Some(0),\n                Some(stop),\n                E_STOP,\n            );\n        }\n    });\n}\n\n// ---------------------------------------------------------------------------\n// Rows 15–21: rejected by `if (stop <= start)` (L59)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn err_15_stop_equals_start() {\n    let mut rng = Rng::new(SEED ^ 115);\n    with_env(|e| {\n        for i in 0..192 {\n            let class = SHORT_CLASSES[i % SHORT_CLASSES.len()];\n            let len = class.pick(&mut rng);\n            let kind = ALL_CONTENT[i % ALL_CONTENT.l