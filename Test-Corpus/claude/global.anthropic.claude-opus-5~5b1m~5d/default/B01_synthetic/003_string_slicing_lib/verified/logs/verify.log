{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_jltpo7vssikrrudgy3uhrl4cgfpsk7cmgdmalpperxbtwmik5tiq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_019r53pr5adJkL6SL6MhQp5t","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-km0prT/translation/tests/common/mod.rs","content":"//! Shared differential-testing harness.\n//!\n//! Both the C `libString_Slice.so` and the Rust `libString_Slice.so` are loaded\n//! with `libloading` and driven exclusively through their exported `slice`\n//! symbol — the Rust crate is never called directly, so the `#[no_mangle]`\n//! `extern \"C\"` wrapper is part of what is under test.\n//!\n//! `slice()` reports its result two ways: an `int` return value *and* bytes\n//! written to `stdout` via the C library's `printf`/`puts`. A comparison that\n//! only looked at the return value would miss the entire observable payload, so\n//! the harness redirects file descriptor 1 to a scratch file and captures the\n//! exact bytes each implementation emits per call.\n\n#![allow(dead_code)]\n\nuse std::ffi::{c_char, c_int, c_void, OsStr};\nuse std::fs::File;\nuse std::io::Write;\nuse std::os::unix::io::AsRawFd;\nuse std::path::PathBuf;\nuse std::sync::{Mutex, MutexGuard, OnceLock};\n\nuse libloading::{Library, Symbol};\n\n/// `int slice(char *mystr, int *start_ptr, int *stop_ptr);`\npub type SliceFn = unsafe extern \"C\" fn(*mut c_char, *mut c_int, *mut c_int) -> c_int;\n\n// ---------------------------------------------------------------------------\n// libc bits used for the fd-1 capture (declared directly; no `libc` crate dep)\n// ---------------------------------------------------------------------------\n\nunsafe extern \"C\" {\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    /// `fflush(NULL)` flushes *every* open output stream (POSIX), which is\n    /// exactly what we need: it drains whatever `stdout` `FILE` buffer the\n    /// library's `printf`/`puts` wrote into, without us having to name the\n    /// `stdout` global.\n    fn fflush(stream: *mut c_void) -> c_int;\n    fn lseek(fd: c_int, offset: i64, whence: c_int) -> i64;\n    fn pread(fd: c_int, buf: *mut c_void, count: usize, offset: i64) -> isize;\n}\n\nconst SEEK_CUR: c_int = 1;\n\n// ---------------------------------------------------------------------------\n// Locating the two shared objects\n// ---------------------------------------------------------------------------\n\nfn c_so_path() -> PathBuf {\n    if let Ok(p) = std::env::var(\"SLICE_C_SO\") {\n        return PathBuf::from(p);\n    }\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n        .join(\"..\")\n        .join(\"c_src\")\n        .join(\"build\")\n        .join(\"libString_Slice.so\")\n}\n\nfn rust_so_path() -> PathBuf {\n    if let Ok(p) = std::env::var(\"SLICE_RUST_SO\") {\n        return PathBuf::from(p);\n    }\n    // .../target/<profile>/deps/<test-exe>  ->  .../target/<profile>/lib*.so\n    if let Ok(exe) = std::env::current_exe() {\n        if let Some(deps) = exe.parent() {\n            let mut dir = deps.to_path_buf();\n            if dir.file_name() == Some(OsStr::new(\"deps\")) {\n                dir.pop();\n            }\n            let cand = dir.join(\"libString_Slice.so\");\n            if cand.exists() {\n                return cand;\n            }\n        }\n    }\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    for p in [\n        \"target/release/libString_Slice.so\",\n        \"target/debug/libString_Slice.so\",\n    ] {\n        let cand = manifest.join(p);\n        if cand.exists() {\n            return cand;\n        }\n    }\n    panic!(\n        \"cannot find the Rust cdylib. `cargo test` does not build a \\\n         crate-type=[\\\"cdylib\\\"] artifact, so run `cargo build` (and/or \\\n         `cargo build --release`) first, or set SLICE_RUST_SO.\"\n    );\n}\n\n// ---------------------------------------------------------------------------\n// The loaded implementations (process-global; the Library handles must outlive\n// every call made through the function pointers taken out of them)\n// ---------------------------------------------------------------------------\n\nstruct Impls {\n    c: SliceFn,\n    rust: SliceFn,\n    _c_lib: Library,\n    _rust_lib: Library,\n}\n\n// The handles are only ever read; calls are serialised by `LOCK`.\nunsafe impl Send for Impls {}\nunsafe impl Sync for Impls {}\n\nfn load(path: &PathBuf) -> (Library, SliceFn) {\n    // SAFETY: loading a shared object runs its initialisers; these two objects\n    // have none beyond the standard C runtime glue.\n    let lib = unsafe { Library::new(path) }\n        .unwrap_or_else(|e| panic!(\"failed to dlopen {}: {e}\", path.display()));\n    let f = {\n        // SAFETY: the symbol's signature matches `slicing.h`.\n        let sym: Symbol<SliceFn> = unsafe { lib.get(b\"slice\\0\") }\n            .unwrap_or_else(|e| panic!(\"no `slice` symbol in {}: {e}\", path.display()));\n        *sym\n    };\n    (lib, f)\n}\n\nfn impls() -> &'static Impls {\n    static IMPLS: OnceLock<Impls> = OnceLock::new();\n    IMPLS.get_or_init(|| {\n        let cp = c_so_path();\n        let rp = rust_so_path();\n        // `Library::new` uses RTLD_LOCAL, so the two identically-named `slice`\n        // symbols do not shadow one another; each `dlsym` resolves within its\n        // own handle.\n        let (c_lib, c) = load(&cp);\n        let (rust_lib, rust) = load(&rp);\n        Impls {\n            c,\n            rust,\n            _c_lib: c_lib,\n            _rust_lib: rust_lib,\n        }\n    })\n}\n\nstatic LOCK: Mutex<()> = Mutex::new(());\n\n// ---------------------------------------------------------------------------\n// stdout capture\n// ---------------------------------------------------------------------------\n\nstruct Capture {\n    saved: c_int,\n    fd: c_int,\n    pos: i64,\n    _file: File,\n    path: PathBuf,\n}\n\nimpl Capture {\n    fn new() -> Self {\n        // Flush anything already pending so it lands on the *real* stdout.\n        unsafe { fflush(std::ptr::null_mut()) };\n\n        let mut path = std::env::temp_dir();\n        path.push(format!(\n            \"slice_diff_{}_{:p}.out\",\n            std::process::id(),\n            &path as *const _\n        ));\n        let file = File::create(&path).expect(\"create capture file\");\n        let fd = file.as_raw_fd();\n\n        let saved = unsafe { dup(1) };\n        assert!(saved >= 0, \"dup(1) failed\");\n        assert!(unsafe { dup2(fd, 1) } >= 0, \"dup2 onto stdout failed\");\n\n        Capture {\n            saved,\n            fd,\n            pos: 0,\n            _file: file,\n            path,\n        }\n    }\n\n    /// Bytes written to fd 1 since the previous `take()`.\n    fn take(&mut self) -> Vec<u8> {\n        unsafe { fflush(std::ptr::null_mut()) };\n        let end = unsafe { lseek(self.fd, 0, SEEK_CUR) };\n        assert!(end >= self.pos, \"capture file offset went backwards\");\n        let n = (end - self.pos) as usize;\n        let mut buf = vec![0u8; n];\n        let mut done = 0usize;\n        while done < n {\n            let got = unsafe {\n                pread(\n                    self.fd,\n                    buf.as_mut_ptr().add(done) as *mut c_void,\n                    n - done,\n                    self.pos + done as i64,\n                )\n            };\n            assert!(got > 0, \"pread on capture file returned {got}\");\n            done += got as usize;\n        }\n        self.pos = end;\n        buf\n    }\n}\n\nimpl Drop for Capture {\n    fn drop(&mut self) {\n        unsafe {\n            fflush(std::ptr::null_mut());\n            dup2(self.saved, 1);\n            close(self.saved);\n        }\n        let _ = std::fs::remove_file(&self.path);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Test environment\n// ---------------------------------------------------------------------------\n\n/// One observation of a `slice()` call.\n#[derive(PartialEq, Eq)]\npub struct Outcome {\n    pub ret: c_int,\n    pub out: Vec<u8>,\n    /// The `char*` buffer after the call — `slice` takes `char *` (non-const),\n    /// so \"did it mutate the caller's string?\" is part of the observable\n    /// behaviour and is compared too.\n    pub buf: Vec<u8>,\n}\n\npub struct Env {\n    _guard: MutexGuard<'static, ()>,\n    cap: Capture,\n    c: SliceFn,\n    rust: SliceFn,\n    pub checks: usize,\n}\n\n/// Runs `body` with fd 1 redirected and both implementations loaded. The\n/// process-global fd-1 redirection means only one `Env` may exist at a time,\n/// which the mutex enforces.\npub fn with_env<R>(body: impl FnOnce(&mut Env) -> R) -> R {\n    let im = impls();\n    let guard = LOCK.lock().unwrap_or_else(|e| e.into_inner());\n    let mut env = Env {\n        _guard: guard,\n        cap: Capture::new(),\n        c: im.c,\n        rust: im.rust,\n        checks: 0,\n    };\n    body(&mut env)\n}\n\nimpl Env {\n    /// Lowest-level differential step: `invoke` is handed one implementation's\n    /// `slice` and performs the FFI call with whatever pointer arrangement the\n    /// row under test requires; it returns the call's `int` result and the\n    /// string buffer as it looked afterwards.\n    pub fn diff_raw(&mut self, label: &str, invoke: &mut dyn FnMut(SliceFn) -> (c_int, Vec<u8>)) {\n        let (c_ret, c_buf) = invoke(self.c);\n        let c_out = self.cap.take();\n        let (r_ret, r_buf) = invoke(self.rust);\n        let r_out = self.cap.take();\n\n        let c_res = Outcome {\n            ret: c_ret,\n            out: c_out,\n            buf: c_buf,\n        };\n        let r_res = Outcome {\n            ret: r_ret,\n            out: r_out,\n            buf: r_buf,\n        };\n        compare(label, &c_res, &r_res);\n        self.checks += 1;\n    }\n\n    /// The ordinary shape: a fresh NUL-terminated copy of `s`, with each bound\n    /// either omitted (null pointer) or supplied as a pointer to an `int`.\n    pub fn diff(&mut self, label: &str, s: &[u8], start: Option<i32>, stop: Option<i32>) {\n        let mut invoke = move |f: SliceFn| -> (c_int, Vec<u8>) {\n            let mut buf: Vec<u8> = Vec::with_capacity(s.len() + 1);\n            buf.extend_from_slice(s);\n            buf.push(0);\n            let mut sv: c_int = start.unwrap_or(0);\n            let mut tv: c_int = stop.unwrap_or(0);\n            let sp = if start.is_some() {\n                &mut sv as *mut c_int\n            } else {\n                std::ptr::null_mut()\n            };\n            let tp = if stop.is_some() {\n                &mut tv as *mut c_int\n            } else {\n                std::ptr::null_mut()\n            };\n            // SAFETY: `buf` is NUL-terminated; `sp`/`tp` are null or valid.\n            let ret = unsafe { f(buf.as_mut_ptr() as *mut c_char, sp, tp) };\n            buf.pop(); // drop the terminator for comparison purposes\n            (ret, buf)\n        };\n        self.diff_raw(label, &mut invoke);\n    }\n\n    /// Both bounds read through the *same* `int` object.\n    pub fn diff_aliased(&mut self, label: &str, s: &[u8], val: i32) {\n        let mut invoke = move |f: SliceFn| -> (c_int, Vec<u8>) {\n            let mut buf: Vec<u8> = Vec::with_capacity(s.len() + 1);\n            buf.extend_from_slice(s);\n            buf.push(0);\n            let mut v: c_int = val;\n            let p = &mut v as *mut c_int;\n            let ret = unsafe { f(buf.as_mut_ptr() as *mut c_char, p, p) };\n            buf.pop();\n            (ret, buf)\n        };\n        self.diff_raw(label, &mut invoke);\n    }\n\n    /// Bounds taken from two adjacent elements of one `int` array.\n    pub fn diff_adjacent(&mut self, label: &str, s: &[u8], start: i32, stop: i32) {\n        let mut invoke = move |f: SliceFn| -> (c_int, Vec<u8>) {\n            let mut buf: Vec<u8> = Vec::with_capacity(s.len() + 1);\n            buf.extend_from_slice(s);\n            buf.push(0);\n            let mut bounds: [c_int; 2] = [start, stop];\n            let ret = unsafe {\n                f(\n                    buf.as_mut_ptr() as *mut c_char,\n                    bounds.as_mut_ptr(),\n                    bounds.as_mut_ptr().add(1),\n                )\n            };\n            buf.pop();\n            (ret, buf)\n        };\n        self.diff_raw(label, &mut invoke);\n    }\n\n    /// A whole *sequence* of calls treated as one observation: the return codes\n    /// are collected and the stdout of the entire batch is compared as a single\n    /// blob. This is what catches stdio buffering / flush-ordering divergence,\n    /// which per-call comparisons cannot see.\n    pub fn diff_sequence(&mut self, label: &str, cases: &[(Vec<u8>, Option<i32>, Option<i32>)]) {\n        let mut invoke = |f: SliceFn| -> (c_int, Vec<u8>) {\n            let mut rets: Vec<u8> = Vec::with_capacity(cases.len());\n            for (s, start, stop) in cases {\n                let mut buf: Vec<u8> = Vec::with_capacity(s.len() + 1);\n                buf.extend_from_slice(s);\n                buf.push(0);\n                let mut sv: c_int = start.unwrap_or(0);\n                let mut tv: c_int = stop.unwrap_or(0);\n                let sp = if start.is_some() {\n                    &mut sv as *mut c_int\n                } else {\n                    std::ptr::null_mut()\n                };\n                let tp = if stop.is_some() {\n                    &mut tv as *mut c_int\n                } else {\n                    std::ptr::null_mut()\n                };\n                let ret = unsafe { f(buf.as_mut_ptr() as *mut c_char, sp, tp) };\n                rets.push(ret as u8);\n                buf.pop();\n                // A mutated input string would show up as a difference in the\n                // recorded return-code/buffer digest.\n                rets.extend_from_slice(&digest(&buf));\n            }\n            (0, rets)\n        };\n        self.diff_raw(label, &mut invoke);\n    }\n}\n\nfn digest(bytes: &[u8]) -> [u8; 8] {\n    // FNV-1a, purely to fold long buffers into the sequence signature.\n    let mut h: u64 = 0xcbf2_9ce4_8422_2325;\n    for &b in bytes {\n        h ^= b as u64;\n        h = h.wrapping_mul(0x0000_0100_0000_01b3);\n    }\n    h.to_le_bytes()\n}\n\nfn compare(label: &str, c: &Outcome, r: &Outcome) {\n    if c.ret != r.ret {\n        panic!(\n            \"[{label}] return value diverged: C returned {} but Rust returned {}\\n  \\\n             C stdout   = {}\\n  Rust stdout = {}\",\n            c.ret,\n            r.ret,\n            brief(&c.out),\n            brief(&r.out)\n        );\n    }\n    if c.out != r.out {\n        panic!(\n            \"[{label}] stdout diverged (C {} bytes, Rust {} bytes){}\\n  C    = {}\\n  Rust = {}\",\n            c.out.len(),\n            r.out.len(),\n            first_diff(&c.out, &r.out),\n            brief(&c.out),\n            brief(&r.out)\n        );\n    }\n    if c.buf != r.buf {\n        panic!(\n            \"[{label}] the input string buffer diverged after the call{}\\n  C    = {}\\n  Rust = {}\",\n            first_diff(&c.buf, &r.buf),\n            brief(&c.buf),\n            brief(&r.buf)\n        );\n    }\n}\n\nfn first_diff(a: &[u8], b: &[u8]) -> String {\n    let n = a.len().min(b.len());\n    for i in 0..n {\n        if a[i] != b[i] {\n            return format!(\n                \"\\n  first difference at byte {i}: C={:#04x} Rust={:#04x}\",\n                a[i], b[i]\n            );\n        }\n    }\n    if a.len() != b.len() {\n        return format!(\"\\n  common prefix of {n} bytes, then lengths differ\");\n    }\n    String::new()\n}\n\nfn brief(bytes: &[u8]) -> String {\n    let mut s = String::new();\n    let shown = bytes.len().min(96);\n    s.push('\"');\n    for &b in &bytes[..shown] {\n        match b {\n            b'\\n' => s.push_str(\"\\\\n\"),\n            b'\\t' => s.push_str(\"\\\\t\"),\n            b'\\r' => s.push_str(\"\\\\r\"),\n            b'\"' => s.push_str(\"\\\\\\\"\"),\n            b'\\\\' => s.push_str(\"\\\\\\\\\"),\n            0x20..=0x7e => s.push(b as char),\n            _ => s.push_str(&format!(\"\\\\x{b:02x}\")),\n        }\n    }\n    s.push('\"');\n    if bytes.len() > shown {\n        s.push_str(&format!(\" … (+{} more bytes)\", bytes.len() - shown));\n    }\n    s\n}\n\n// ---------------------------------------------------------------------------\n// Deterministic PRNG (SplitMix64) + content generators\n// ---------------------------------------------------------------------------\n\n/// Fixed seed so every run is reproducible.\npub const SEED: u64 = 0x5163_1EDA_7EA5_1CE5;\n\npub struct Rng(u64);\n\nimpl Rng {\n    pub fn new(seed: u64) -> Self {\n        Rng(seed)\n    }\n    pub fn next_u64(&mut self) -> u64 {\n        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n        let mut z = self.0;\n        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n        z ^ (z >> 31)\n    }\n    /// Uniform-ish value in `[0, n)`; `n == 0` yields 0.\n    pub fn below(&mut self, n: u64) -> u64 {\n        if n == 0 {\n            0\n        } else {\n            self.next_u64() % n\n        }\n    }\n    /// Inclusive range.\n    pub fn range(&mut self, lo: i64, hi: i64) -> i64 {\n        assert!(lo <= hi);\n        lo + self.below((hi - lo + 1) as u64) as i64\n    }\n    pub fn range_i32(&mut self, lo: i32, hi: i32) -> i32 {\n        self.range(lo as i64, hi as i64) as i32\n    }\n    pub fn byte(&mut self) -> u8 {\n        (self.next_u64() >> 13) as u8\n    }\n}\n\n/// Which class of bytes fills a generated string. Never `0x00`: the API takes a\n/// NUL-terminated C string, so an embedded NUL would just shorten it (and that\n/// shape is covered by generating a shorter string instead).\n#[derive(Copy, Clone, Debug)]\npub enum Content {\n    /// Printable ASCII.\n    Ascii,\n    /// High bytes, lone UTF-8 continuation bytes and truncated sequences.\n    HighBytes,\n    /// `printf` conversion specifiers embedded in the *data*.\n    FormatBait,\n    /// Whitespace and control characters, including embedded newlines.\n    Whitespace,\n    /// Every byte value `0x01..=0xFF`, cycled.\n    AllBytes,\n    /// A mixture of all of the above.\n    Mixed,\n}\n\npub const ALL_CONTENT: [Content; 6] = [\n    Content::Ascii,\n    Content::HighBytes,\n    Content::FormatBait,\n    Content::Whitespace,\n    Content::AllBytes,\n    Content::Mixed,\n];\n\nconst BAIT: [&[u8]; 10] = [\n    b\"%s\", b\"%n\", b\"%d\", b\"%%\", b\"%1000000f\", b\"%p\", b\"%hn\", b\"%.*s\", b\"%08x\", b\"%c\",\n];\n\npub fn gen(rng: &mut Rng, len: usize, kind: Content) -> Vec<u8> {\n    let mut v = Vec::with_capacity(len);\n    while v.len() < len {\n        match kind {\n            Content::Ascii => v.push(0x20 + (rng.below(0x5f) as u8)),\n            Content::HighBytes => {\n                let b = 0x80u8.wrapping_add(rng.byte() & 0x7f);\n                v.push(if b == 0 { 0x80 } else { b });\n            }\n            Content::Whitespace => {\n                const WS: [u8; 6] = [b' ', b'\\t', b'\\r', b'\\n', 0x0b, 0x0c];\n                v.push(WS[rng.below(WS.len() as u64) as usize]);\n            }\n            Content::AllBytes => {\n                let idx = (v.len() % 255) as u8;\n                v.push(idx.wrapping_add(1));\n            }\n            Content::FormatBait => {\n                let t = BAIT[rng.below(BAIT.len() as u64) as usize];\n                v.extend_from_slice(t);\n            }\n            Content::Mixed => {\n                let mut b = rng.byte();\n                if b == 0 {\n                    b = 1;\n                }\n                v.push(b);\n            }\n        }\n    }\n    v.truncate(len);\n    // Defensive: a stray NUL would silently shorten the C string.\n    for b in v.iter_mut() {\n        if *b == 0 {\n            *b = b'.';\n        }\n    }\n    v\n}\n\n/// The exact byte-value ramp `0x01..=0xFF` (255 bytes).\npub fn ramp() -> Vec<u8> {\n    (1u16..=255).map(|b| b as u8).collect()\n}\n\n/// Length classes the C code's `strlen`-derived bounds distinguish, including\n/// the `BUFSIZ` (4096) crossing that exercises the stdio write path.\n#[derive(Copy, Clone, Debug)]\npub enum LenClass {\n    Zero,\n    One,\n    Small,\n    Medium,\n    Large,\n    Huge,\n}\n\nimpl LenClass {\n    pub fn pick(self, rng: &mut Rng) -> usize {\n        match self {\n            LenClass::Zero => 0,\n            LenClass::One => 1,\n            LenClass::Small => rng.range(2, 16) as usize,\n            LenClass::Medium => rng.range(17, 512) as usize,\n            LenClass::Large => rng.range(4097, 9000) as usize,\n            LenClass::Huge => 1 << 20,\n        }\n    }\n}\n\npub const SHORT_CLASSES: [LenClass; 4] = [\n    LenClass::Zero,\n    LenClass::One,\n    LenClass::Small,\n    LenClass::Medium,\n];\n\npub const ALL_CLASSES: [LenClass; 6] = [\n    LenClass::Zero,\n    LenClass::One,\n    LenClass::Small,\n    LenClass::Medium,\n    LenClass::Large,\n    LenClass::Huge,\n];\n\n/// Emits a progress note on stderr (stdout is redirected during a test).\npub fn note(msg: &str) {\n    let _ = writeln!(std::io::stderr(), \"    {msg}\");\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":572,"cache_read_input_tokens":48977,"cache_creation":{"ephemeral_5m_input_tokens":572,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1bb4f197-1782-4f38-9534-b9fc0dce3610","uuid":"fe193404-e4f6-4f27-9660-d7ae2240d924","timestamp":"2026-08-28T09:01:13.575Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019r53pr5adJkL6SL6MhQp5t","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-km0prT/translation/tests/common/mod.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1bb4f197-1782-4f38-9534-b9fc0dce3610","uuid":"96035f76-5e0e-43a4-886a-c3f7a2810d69","timestamp":"2026-08-28T09:01:13.589Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-km0prT/translation/tests/common/mod.rs","content":"//! Shared differential-testing harness.\n//!\n//! Both the C `libString_Slice.so` and the Rust `libString_Slice.so` are loaded\n//! with `libloading` and driven exclusively through their exported `slice`\n//! symbol — the Rust crate is never called directly, so the `#[no_mangle]`\n//! `extern \"C\"` wrapper is part of what is under test.\n//!\n//! `slice()` reports its result two ways: an `int` return value *and* bytes\n//! written to `stdout` via the C library's `printf`/`puts`. A comparison that\n//! only looked at the return value would miss the entire observable payload, so\n//! the harness redirects file descriptor 1 to a scratch file and captures the\n//! exact bytes each implementation emits per call.\n\n#![allow(dead_code)]\n\nuse std::ffi::{c_char, c_int, c_void, OsStr};\nuse std::fs::File;\nuse std::io::Write;\nuse std::os::unix::io::AsRawFd;\nuse std::path::PathBuf;\nuse std::sync::{Mutex, MutexGuard, OnceLock};\n\nuse libloading::{Library, Symbol};\n\n/// `int slice(char *mystr, int *start_ptr, int *stop_ptr);`\npub type SliceFn = unsafe extern \"C\" fn(*mut c_char, *mut c_int, *mut c_int) -> c_int;\n\n// ---------------------------------------------------------------------------\n// libc bits used for the fd-1 capture (declared directly; no `libc` crate dep)\n// ---------------------------------------------------------------------------\n\nunsafe extern \"C\" {\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    /// `fflush(NULL)` flushes *every* open output stream (POSIX), which is\n    /// exactly what we need: it drains whatever `stdout` `FILE` buffer the\n    /// library's `printf`/`puts` wrote into, without us having to name the\n    /// `stdout` global.\n    fn fflush(stream: *mut c_void) -> c_int;\n    fn lseek(fd: c_int, offset: i64, whence: c_int) -> i64;\n    fn pread(fd: c_int, buf: *mut c_void, count: usize, offset: i64) -> isize;\n}\n\nconst SEEK_CUR: c_int = 1;\n\n// ---------------------------------------------------------------------------\n// Locating the two shared objects\n// ---------------------------------------------------------------------------\n\nfn c_so_path() -> PathBuf {\n    if let Ok(p) = std::env::var(\"SLICE_C_SO\") {\n        return PathBuf::from(p);\n    }\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n        .join(\"..\")\n        .join(\"c_src\")\n        .join(\"build\")\n        .join(\"libString_Slice.so\")\n}\n\nfn rust_so_path() -> PathBuf {\n    if let Ok(p) = std::env::var(\"SLICE_RUST_SO\") {\n        return PathBuf::from(p);\n    }\n    // .../target/<profile>/deps/<test-exe>  ->  .../target/<profile>/lib*.so\n    if let Ok(exe) = std::env::current_exe() {\n        if let Some(deps) = exe.parent() {\n            let mut dir = deps.to_path_buf();\n            if dir.file_name() == Some(OsStr::new(\"deps\")) {\n                dir.pop();\n            }\n            let cand = dir.join(\"libString_Slice.so\");\n            if cand.exists() {\n                return cand;\n            }\n        }\n    }\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    for p in [\n        \"target/release/libString_Slice.so\",\n        \"target/debug/libString_Slice.so\",\n    ] {\n        let cand = manifest.join(p);\n        if cand.exists() {\n            return cand;\n        }\n    }\n    panic!(\n        \"cannot find the Rust cdylib. `cargo test` does not build a \\\n         crate-type=[\\\"cdylib\\\"] artifact, so run `cargo build` (and/or \\\n         `cargo build --release`) first, or set SLICE_RUST_SO.\"\n    );\n}\n\n// ---------------------------------------------------------------------------\n// The loaded implementations (process-global; the Library handles must outlive\n// every call made through the function pointers taken out of them)\n// ---------------------------------------------------------------------------\n\nstruct Impls {\n    c: SliceFn,\n    rust: SliceFn,\n    _c_lib: Library,\n    _rust_lib: Library,\n}\n\n// The handles are only ever read; calls are serialised by `LOCK`.\nunsafe impl Send for Impls {}\nunsafe impl Sync for Impls {}\n\nfn load(path: &PathBuf) -> (Library, SliceFn) {\n    // SAFETY: loading a shared object runs its initialisers; these two objects\n    // have none beyond the standard C runtime glue.\n    let lib = unsafe { Library::new(path) }\n        .unwrap_or_else(|e| panic!(\"failed to dlopen {}: {e}\", path.display()));\n    let f = {\n        // SAFETY: the symbol's signature matches `slicing.h`.\n        let sym: Symbol<SliceFn> = unsafe { lib.get(b\"slice\\0\") }\n            .unwrap_or_else(|e| panic!(\"no `slice` symbol in {}: {e}\", path.display()));\n        *sym\n    };\n    (lib, f)\n}\n\nfn impls() -> &'static Impls {\n    static IMPLS: OnceLock<Impls> = OnceLock::new();\n    IMPLS.get_or_init(|| {\n        let cp = c_so_path();\n        let rp = rust_so_path();\n        // `Library::new` uses RTLD_LOCAL, so the two identically-named `slice`\n        // symbols do not shadow one another; each `dlsym` resolves within its\n        // own handle.\n        let (c_lib, c) = load(&cp);\n        let (rust_lib, rust) = load(&rp);\n        Impls {\n            c,\n            rust,\n            _c_lib: c_lib,\n            _rust_lib: rust_lib,\n        }\n    })\n}\n\nstatic LOCK: Mutex<()> = Mutex::new(());\n\n// ---------------------------------------------------------------------------\n// stdout capture\n// ---------------------------------------------------------------------------\n\nstruct Capture {\n    saved: c_int,\n    fd: c_int,\n    pos: i64,\n    _file: File,\n    path: PathBuf,\n}\n\nimpl Capture {\n    fn new() -> Self {\n        // Flush anything already pending so it lands on the *real* stdout.\n        unsafe { fflush(std::ptr::null_mut()) };\n\n        let mut path = std::env::temp_dir();\n        path.push(format!(\n            \"slice_diff_{}_{:p}.out\",\n            std::process::id(),\n            &path as *const _\n        ));\n        let file = File::create(&path).expect(\"create capture file\");\n        let fd = file.as_raw_fd();\n\n        let saved = unsafe { dup(1) };\n        assert!(saved >= 0, \"dup(1) failed\");\n        assert!(unsafe { dup2(fd, 1) } >= 0, \"dup2 onto stdout failed\");\n\n        Capture {\n            saved,\n            fd,\n            pos: 0,\n            _file: file,\n            path,\n        }\n    }\n\n    /// Bytes written to fd 1 since the previous `take()`.\n    fn take(&mut self) -> Vec<u8> {\n        unsafe { fflush(std::ptr::null_mut()) };\n        let end = unsafe { lseek(self.fd, 0, SEEK_CUR) };\n        assert!(end >= self.pos, \"capture file offset went backwards\");\n        let n = (end - self.pos) as usize;\n        let mut buf = vec![0u8; n];\n        let mut done = 0usize;\n        while done < n {\n            let got = unsafe {\n                pread(\n                    self.fd,\n                    buf.as_mut_ptr().add(done) as *mut c_void,\n                    n - done,\n                    self.pos + done as i64,\n                )\n            };\n            assert!(got > 0, \"pread on capture file returned {got}\");\n            done += got as usize;\n        }\n        self.pos = end;\n        buf\n    }\n}\n\nimpl Drop for Capture {\n    fn drop(&mut self) {\n        unsafe {\n            fflush(std::ptr::null_mut());\n            dup2(self.saved, 1);\n            close(self.saved);\n        }\n        let _ = std::fs::remove_file(&self.path);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Test environment\n// ---------------------------------------------------------------------------\n\n/// One observation of a `slice()` call.\n#[derive(PartialEq, Eq)]\npub struct Outcome {\n    pub ret: c_int,\n    pub out: Vec<u8>,\n    /// The `char*` buffer after the call — `slice` takes `char *` (non-const),\n    /// so \"did it mutate the caller's string?\" is part of the observable\n    /// behaviour and is compared too.\n    pub buf: Vec<u8>,\n}\n\npub struct Env {\n    _guard: MutexGuard<'static, ()>,\n    cap: Capture,\n    c: SliceFn,\n    rust: SliceFn,\n    pub checks: usize,\n}\n\n/// Runs `body` with fd 1 redirected and both implementations loaded. The\n/// process-global fd-1 redirection means only one `Env` may exist at a time,\n/// which the mutex enforces.\npub fn with_env<R>(body: impl FnOnce(&mut Env) -> R) -> R {\n    let im = impls();\n    let guard = LOCK.lock().unwrap_or_else(|e| e.into_inner());\n    let mut env = Env {\n        _guard: guard,\n        cap: Capture::new(),\n        c: im.c,\n        rust: im.rust,\n        checks: 0,\n    };\n    body(&mut env)\n}\n\nimpl Env {\n    /// Lowest-level differential step: `invoke` is handed one implementation's\n    /// `slice` and performs the FFI call with whatever pointer arrangement the\n    /// row under test requires; it returns the call's `int` result and the\n    /// string buffer as it looked afterwards.\n    pub fn diff_raw(&mut self, label: &str, invoke: &mut dyn FnMut(SliceFn) -> (c_int, Vec<u8>)) {\n        let (c_ret, c_buf) = invoke(self.c);\n        let c_out = self.cap.take();\n        let (r_ret, r_buf) = invoke(self.rust);\n        let r_out = self.cap.take();\n\n        let c_res = Outcome {\n            ret: c_ret,\n            out: c_out,\n            buf: c_buf,\n        };\n        let r_res = Outcome {\n            ret: r_ret,\n            out: r_out,\n            buf: r_buf,\n        };\n        compare(label, &c_res, &r_res);\n        self.checks += 1;\n    }\n\n    /// The ordinary shape: a fresh NUL-terminated copy of `s`, with each bound\n    /// either omitted (null pointer) or supplied as a pointer to an `int`.\n    pub fn diff(&mut self, label: &str, s: &[u8], start: Option<i32>, stop: Option<i32>) {\n        let mut invoke = move |f: SliceFn| -> (c_int, Vec<u8>) {\n            let mut buf: Vec<u8> = Vec::with_capacity(s.len() + 1);\n            buf.extend_from_slice(s);\n            buf.push(0);\n            let mut sv: c_int = start.unwrap_or(0);\n            let mut tv: c_int = stop.unwrap_or(0);\n            let sp = if start.is_some() {\n                &mut sv as *mut c_int\n            } else {\n                std::ptr::null_mut()\n            };\n            let tp = if stop.is_some() {\n                &mut tv as *mut c_int\n            } else {\n                std::ptr::null_mut()\n            };\n            // SAFETY: `buf` is NUL-terminated; `sp`/`tp` are null or valid.\n            let ret = unsafe { f(buf.as_mut_ptr() as *mut c_char, sp, tp) };\n            buf.pop(); // drop the terminator for comparison purposes\n            (ret, buf)\n        };\n        self.diff_raw(label, &mut invoke);\n    }\n\n    /// Both bounds read through the *same* `int` object.\n    pub fn diff_aliased(&mut self, label: &str, s: &[u8], val: i32) {\n        let mut invoke = move |f: SliceFn| -> (c_int, Vec<u8>) {\n            let mut buf: Vec<u8> = Vec::with_capacity(s.len() + 1);\n            buf.extend_from_slice(s);\n            buf.push(0);\n            let mut v: c_int = val;\n            let p = &mut v as *mut c_int;\n            let ret = unsafe { f(buf.as_mut_ptr() as *mut c_char, p, p) };\n            buf.pop();\n            (ret, buf)\n        };\n        self.diff_raw(label, &mut invoke);\n    }\n\n    /// Bounds taken from two adjacent elements of one `int` array.\n    pub fn diff_adjacent(&mut self, label: &str, s: &[u8], start: i32, stop: i32) {\n        let mut invoke = move |f: SliceFn| -> (c_int, Vec<u8>) {\n            let mut buf: Vec<u8> = Vec::with_capacity(s.len() + 1);\n            buf.extend_from_slice(s);\n            buf.push(0);\n            let mut bounds: [c_int; 2] = [start, stop];\n            let ret = unsafe {\n                f(\n                    buf.as_mut_ptr() as *mut c_char,\n                    bounds.as_mut_ptr(),\n                    bounds.as_mut_ptr().add(1),\n                )\n            };\n            buf.pop();\n            (ret, buf)\n        };\n        self.diff_raw(label, &mut invoke);\n    }\n\n    /// A whole *sequence* of calls treated as one observation: the return codes\n    /// are collected and the stdout of the entire batch is compared as a single\n    /// blob. This is what catches stdio buffering / flush-ordering divergence,\n    /// which per-call comparisons cannot see.\n    pub fn diff_sequence(&mut self, label: &str, cases: &[(Vec<u8>, Option<i32>, Option<i32>)]) {\n        let mut invoke = |f: SliceFn| -> (c_int, Vec<u8>) {\n            let mut rets: Vec<u8> = Vec::with_capacity(cases.len());\n            for (s, start, stop) in cases {\n                let mut buf: Vec<u8> = Vec::with_capacity(s.len() + 1);\n                buf.extend_from_slice(s);\n                buf.push(0);\n                let mut sv: c_int = start.unwrap_or(0);\n                let mut tv: c_int = stop.unwrap_or(0);\n                let sp = if start.is_some() {\n                    &mut sv as *mut c_int\n                } else {\n                    std::ptr::null_mut()\n                };\n                let tp = if stop.is_some() {\n                    &mut tv as *mut c_int\n                } else {\n                    std::ptr::null_mut()\n                };\n                let ret = unsafe { f(buf.as_mut_ptr() as *mut c_char, sp, tp) };\n                rets.push(ret as u8);\n                buf.pop();\n                // A mutated input string would show up as a difference in the\n                // recorded return-code/buffer digest.\n                rets.extend_from_slice(&digest(&buf));\n            }\n            (0, rets)\n        };\n        self.diff_raw(label, &mut invoke);\n    }\n}\n\nfn digest(bytes: &[u8]) -> [u8; 8] {\n    // FNV-1a, purely to fold long buffers into the sequence signature.\n    let mut h: u64 = 0xcbf2_9ce4_8422_2325;\n    for &b in bytes {\n        h ^= b as u64;\n        h = h.wrapping_mul(0x0000_0100_0000_01b3);\n    }\n    h.to_le_bytes()\n}\n\nfn compare(label: &str, c: &Outcome, r: &Outcome) {\n    if c.ret != r.ret {\n        panic!(\n            \"[{label}] return value diverged: C returned {} but Rust returned {}\\n  \\\n             C stdout   = {}\\n  Rust stdout = {}\",\n            c.ret,\n            r.ret,\n            brief(&c.out),\n            brief(&r.out)\n        );\n    }\n    if c.out != r.out {\n        panic!(\n            \"[{label}] stdout diverged (C {} bytes, Rust {} bytes){}\\n  C    = {}\\n  Rust = {}\",\n            c.out.len(),\n            r.out.len(),\n            first_diff(&c.out, &r.out),\n            brief(&c.out),\n            brief(&r.out)\n        );\n    }\n    if c.buf != r.buf {\n        panic!(\n            \"[{label}] the input string buffer diverged after the call{}\\n  C    = {}\\n  Rust = {}\",\n            first_diff(&c.buf, &r.buf),\n            brief(&c.buf),\n            brief(&r.buf)\n        );\n    }\n}\n\nfn first_diff(a: &[u8], b: &[u8]) -> String {\n    let n = a.len().min(b.len());\n    for i in 0..n {\n        if a[i] != b[i] {\n            return format!(\n                \"\\n  first difference at byte {i}: C={:#04x} Rust={:#04x}\",\n                a[i], b[i]\n            );\n        }\n    }\n    if a.len() != b.len() {\n        return format!(\"\\n  common prefix of {n} bytes, then lengths differ\");\n    }\n    String::new()\n}\n\nfn brief(bytes: &[u8]) -> String {\n    let mut s = String::new();\n    let shown = bytes.len().min(96);\n    s.push('\"');\n    for &b in &bytes[..shown] {\n        match b {\n            b'\\n' => s.push_str(\"\\\\n\"),\n            b'\\t' => s.push_str(\"\\\\t\"),\n            b'\\r' => s.push_str(\"\\\\r\"),\n            b'\"' => s.push_str(\"\\\\\\\"\"),\n            b'\\\\' => s.push_str(\"\\\\\\\\\"),\n            0x20..=0x7e => s.push(b as char),\n            _ => s.push_str(&format!(\"\\\\x{b:02x}\")),\n        }\n    }\n    s.push('\"');\n    if bytes.len() > shown {\n        s.push_str(&format!(\" … (+{} more bytes)\", bytes.len() - shown));\n    }\n    s\n}\n\n// ---------------------------------------------------------------------------\n// Deterministic PRNG (SplitMix64) + content generators\n// ---------------------------------------------------------------------------\n\n/// Fixed seed so every run is reproducible.\npub const SEED: u64 = 0x5163_1EDA_7EA5_1CE5;\n\npub struct Rng(u64);\n\nimpl Rng {\n    pub fn new(seed: u64) -> Self {\n        Rng(seed)\n    }\n    pub fn next_u64(&mut self) -> u64 {\n        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n        let mut z = self.0;\n        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n        z ^ (z >> 31)\n    }\n    /// Uniform-ish value in `[0, n)`; `n == 0` yields 0.\n    pub fn below(&mut self, n: u64) -> u64 {\n        if n == 0 {\n            0\n        } else {\n            self.next_u64() % n\n        }\n    }\n    /// Inclusive range.\n    pub fn range(&mut self, lo: i64, hi: i64) -> i64 {\n        assert!(lo <= hi);\n        lo + self.below((hi - lo + 1) as u64) as i64\n    }\n    pub fn range_i32(&mut self, lo: i32, hi: i32) -> i32 {\n        self.range(lo as i64, hi as i64) as i32\n    }\n    pub fn byte(&mut self) -> u8 {\n        (self.next_u64() >> 13) as u8\n    }\n}\n\n/// Which class of bytes fills a generated string. Never `0x00`: the API takes a\n/// NUL-terminated C string, so an embedded NUL would just shorten it (and that\n/// shape is covered by generating a shorter string instead).\n#[derive(Copy, Clone, Debug)]\npub enum Content {\n    /// Printable ASCII.\n    Ascii,\n    /// High bytes, lone UTF-8 continuation bytes and truncated sequences.\n    HighBytes,\n    /// `printf` conversion specifiers embedded in the *data*.\n    FormatBait,\n    /// Whitespace and control characters, including embedded newlines.\n    Whitespace,\n    /// Every byte value `0x01..=0xFF`, cycled.\n    AllBytes,\n    /// A mixture of all of the above.\n    Mixed,\n}\n\npub const ALL_CONTENT: [Content; 6] = [\n    Content::Ascii,\n    Content::HighBytes,\n    Content::FormatBait,\n    Content::Whitespace,\n    Content::AllBytes,\n    Content::Mixed,\n];\n\nconst BAIT: [&[u8]; 10] = [\n    b\"%s\", b\"%n\", b\"%d\", b\"%%\", b\"%1000000f\", b\"%p\", b\"%hn\", b\"%.*s\", b\"%08x\", b\"%c\",\n];\n\npub fn gen(rng: &mut Rng, len: usize, kind: Content) -> Vec<u8> {\n    let mut v = Vec::with_capacity(len);\n    while v.len() < len {\n        match kind {\n            Content::Ascii => v.push(0x20 + (rng.below(0x5f) as u8)),\n            Content::HighBytes => {\n                let b = 0x80u8.wrapping_add(rng.byte() & 0x7f);\n                v.push(if b == 0 { 0x80 } else { b });\n            }\n            Content::Whitespace => {\n                const WS: [u8; 6] = [b' ', b'\\t', b'\\r', b'\\n', 0x0b, 0x0c];\n                v.push(WS[rng.below(WS.len() as u64) as usize]);\n            }\n            Content::AllBytes => {\n                let idx = (v.len() % 255) as u8;\n                v.push(idx.wrapping_add(1));\n            }\n            Content::FormatBait => {\n                let t = BAIT[rng.below(BAIT.len() as u64) as usize];\n                v.extend_from_slice(t);\n            }\n            Content::Mixed => {\n                let mut b = rng.byte();\n                if b == 0 {\n                    b = 1;\n                }\n                v.push(b);\n            }\n        }\n    }\n    v.truncate(len);\n    // Defensive: a stray NUL would silently shorten the C string.\n    for b in v.iter_mut() {\n        if *b == 0 {\n            *b = b'.';\n        }\n    }\n    v\n}\n\n/// The exact byte-value ramp `0x01..=0xFF` (255 bytes).\npub fn ramp() -> Vec<u8> {\n    (1u16..=255).map(|b| b as u8).collect()\n}\n\n/// Length classes the C code's `strlen`-derived bounds distinguish, including\n/// the `BUFSIZ` (4096) crossing that exercises the stdio write path.\n#[derive(Copy, Clone, Debug)]\npub enum LenClass {\n    Zero,\n    One,\n    Small,\n    Medium,\n    Large,\n    Huge,\n}\n\nimpl LenClass {\n    pub fn pick(self, rng: &mut Rng) -> usize {\n        match self {\n            LenClass::Zero => 0,\n            LenClass::One => 1,\n            LenClass::Small => rng.range(2, 16) as usize,\n            LenClass::Medium => rng.range(17, 512) as usize,\n            LenClass::Large => rng.range(4097, 9000) as usize,\n            LenClass::Huge => 1 << 20,\n        }\n    }\n}\n\npub const SHORT_CLASSES: [LenClass; 4] = [\n    LenClass::Zero,\n    LenClass::One,\n    LenClass::Small,\n    LenClass::Medium,\n];\n\npub const ALL_CLASSES: [LenClass; 6] = [\n    LenClass::Zero,\n    LenClass::One,\n    LenClass::Small,\n    LenClass::Medium,\n    LenClass::Large,\n    LenClass::Huge,\n];\n\n/// Emits a progress note on stderr (stdout is redirected during a test).\npub fn note(msg: &str) {\n    let _ = writeln!(std::io::stderr(), \"    {msg}\");\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
