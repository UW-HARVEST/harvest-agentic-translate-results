int len)`\n    40\t///\n    41\t/// Not exported by the C shared library (it is `static`), so it stays private\n    42\t/// here as well.\n    43\tunsafe fn print_hex(p: *const c_uchar, len: c_int) {\n    44\t    let mut i: c_int = 0;\n    45\t    while i < len {\n    46\t        // printf(\"%02x\", p[i]); -- the unsigned char argument is promoted to int.\n    47\t        printf(\n    48\t            b\"%02x\\0\".as_ptr() as *const c_char,\n    49\t            *p.offset(i as isize) as c_int,\n    50\t        );\n    51\t        i += 1;\n    52\t    }\n    53\t    // printf(\"\\n\");\n    54\t    printf(b\"\\n\\0\".as_ptr() as *const c_char);\n    55\t}\n    56\t\n    57\t/// `void driver(int x)`\n    58\t#[unsafe(no_mangle)]\n    59\tpub extern \"C\" fn driver(x: c_int) {\n    60\t    unsafe {\n    61\t        print_hex(\n    62\t            &x as *const c_int as *const c_uchar,\n    63\t            core::mem::size_of::<c_int>() as c_int,\n    64\t        );\n    65\t    }\n    66\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
