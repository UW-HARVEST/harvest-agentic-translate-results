ldLines":7,"newStart":64,"newLines":27,"lines":["     helper_good();"," }"," ","+// The Rust runtime sets SIGPIPE to SIG_IGN before `main` runs, but a C program","+// inherits the default disposition (terminate). Without restoring SIG_DFL the","+// translation exits 0 on a broken pipe where the C program dies from SIGPIPE","+// (shell status 141). `signal` comes from libc, which is already linked.","+extern \"C\" {","+    fn signal(signum: i32, handler: usize) -> usize;","+}","+","+/// Value of `SIGPIPE` on Linux; `SIG_DFL` is the null handler.","+const SIGPIPE: i32 = 13;","+const SIG_DFL: usize = 0;","+","+fn restore_default_sigpipe() {","+    unsafe {","+        signal(SIGPIPE, SIG_DFL);","+    }","+}","+"," fn main() {","+    restore_default_sigpipe();","+","     print_line(Some(\"Calling good()...\"));","     good();","     print_line(Some(\"Finished good()\"));"]}],"userModified":false,"replaceAll":false}}
