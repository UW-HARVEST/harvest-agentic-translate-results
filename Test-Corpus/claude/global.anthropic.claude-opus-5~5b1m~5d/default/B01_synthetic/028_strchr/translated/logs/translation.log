op at 1000 bytes, which is the closest well-defined behavior; for inputs under 1000 bytes (the well-defined domain) the two are exactly equivalent."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":641,"cache_read_input_tokens":16413,"cache_creation":{"ephemeral_5m_input_tokens":641,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"3a036808-d0c0-427e-b088-ea6f2d60973f","uuid":"549c3754-f977-4c31-a05a-f8219fc26894","timestamp":"2026-08-28T14:43:34.539Z"}
