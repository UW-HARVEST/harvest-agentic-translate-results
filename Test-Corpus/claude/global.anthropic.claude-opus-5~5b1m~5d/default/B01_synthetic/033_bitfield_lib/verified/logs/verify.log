{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017abn2emh2QME7roM523JGD","type":"tool_result","content":"1\t// Rust translation of the C library in c_src/.\n2\t//\n3\t// Original copyright notice from the C sources:\n4\t//\n5\t// Copyright 2025 MIT Lincoln Laboratory\n6\t// Permission is hereby granted, free of charge,\n7\t// to any person obtaining a copy of this software\n8\t// and associated documentation files (the \"Software\"),\n9\t// to deal in the Software without restriction,\n10\t// including without limitation the rights to use, copy,\n11\t// modify, merge, publish, distribute, sublicense,\n12\t// and/or sell copies of the Software,\n13\t// and to permit persons to whom the Software is furnished to do so,\n14\t// subject to the following conditions:\n15\t//\n16\t// The above copyright notice and this permission notice\n17\t// shall be included in all copies or substantial portions of the Software.\n18\t//\n19\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n20\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n21\t// THE WARRANTIES OF MERCHANTABILITY,\n22\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n23\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n24\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n25\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n26\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n27\t\n28\tuse std::ffi::{c_char, c_int, c_uint};\n29\t\n30\textern \"C\" {\n31\t    // C's printf, used so that output formatting *and* stdio buffering\n32\t    // behaviour are byte-for-byte identical to the original library.\n33\t    fn printf(format: *const c_char, ...) -> c_int;\n34\t}\n35\t\n36\t/// Translation of\n37\t///\n38\t/// ```c\n39\t/// typedef struct {\n40\t///     unsigned int x : 2;\n41\t///     unsigned int y : 3;\n42\t///     bool b : 1;\n43\t///     int z;\n44\t/// } foo_t;\n45\t/// ```\n46\t///\n47\t/// On the SysV/ELF ABI (gcc & clang) the three bit-fields share the first\n48\t/// storage unit: `x` occupies bits 0..=1, `y` bits 2..=4 and `b` bit 5 of\n49\t/// byte 0.  Bits 6..=7 of byte 0 and bytes 1..=3 are padding, `z` lives at\n50\t/// offset 4.  `sizeof(foo_t) == 8`, `_Alignof(foo_t) == 4`.\n51\t#[repr(C)]\n52\t#[derive(Clone, Copy)]\n53\tpub struct foo_t {\n54\t    /// Packed bit-field storage unit (x: bits 0-1, y: bits 2-4, b: bit 5).\n55\t    bits: u8,\n56\t    /// int z; (offset 4 thanks to the repr(C) alignment padding)\n57\t    z: c_int,\n58\t}\n59\t\n60\timpl foo_t {\n61\t    #[inline]\n62\t    fn new(x: c_uint, y: c_uint, b: u8, z: c_int) -> Self {\n63\t        // Exactly what the C compiler emits for\n64\t        // `foo_t foo = {.x = x, .y = y, .b = b, .z = z};`\n65\t        let bits = ((x as u8) & 0x3) | (((y as u8) & 0x7) << 2) | ((b & 0x1) << 5);\n66\t        foo_t { bits, z }\n67\t    }\n68\t\n69\t    /// `foo->x` — 2-bit unsigned bit-field, promoted to `int` for the\n70\t    /// variadic call.\n71\t    #[inline]\n72\t    fn x(self) -> c_int {\n73\t        (self.bits & 0x3) as c_int\n74\t    }\n75\t\n76\t    /// `foo->y` — 3-bit unsigned bit-field, promoted to `int`.\n77\t    #[inline]\n78\t    fn y(self) -> c_int {\n79\t        ((self.bits >> 2) & 0x7) as c_int\n80\t    }\n81\t\n82\t    /// `foo->b` — 1-bit `bool` bit-field, promoted to `int`.\n83\t    #[inline]\n84\t    fn b(self) -> c_int {\n85\t        ((self.bits >> 5) & 0x1) as c_int\n86\t    }\n87\t}\n88\t\n89\t/// ```c\n90\t/// void print_foo(const foo_t *foo) {\n91\t///     printf(\"%u %u %d %d\\n\", foo->x, foo->y, foo->b, foo->z);\n92\t/// }\n93\t/// ```\n94\t#[unsafe(no_mangle)]\n95\tpub unsafe extern \"C\" fn print_foo(foo: *const foo_t) {\n96\t    // The C code dereferences unconditionally; do the same.\n97\t    let foo = unsafe { std::ptr::read(foo) };\n98\t    unsafe {\n99\t        printf(\n100\t            b\"%u %u %d %d\\n\\0\".as_ptr() as *const c_char,\n101\t            foo.x(),\n102\t            foo.y(),\n103\t            foo.b(),\n104\t            foo.z,\n105\t        );\n106\t    }\n107\t}\n108\t\n109\t/// ```c\n110\t/// void driver(unsigned int x, unsigned int y, bool b, int z) {\n111\t///     foo_t foo = {.x = x, .y = y, .b = b, .z = z};\n112\t///     print_foo(&foo);\n113\t/// }\n114\t/// ```\n115\t///\n116\t/// `b` is taken as a `u8` rather than a Rust `bool` so that the (technically\n117\t/// out-of-contract) case of a caller passing a byte other than 0/1 behaves\n118\t/// like the C code does — the bit-field assignment keeps only bit 0.\n119\t#[unsafe(no_mangle)]\n120\tpub unsafe extern \"C\" fn driver(x: c_uint, y: c_uint, b: u8, z: c_int) {\n121\t    let foo = foo_t::new(x, y, b, z);\n122\t    unsafe { print_foo(&foo as *const foo_t) };\n123\t}\n124\t"}]},"parent_tool_use_id":null,"session_id":"ee24cea0-fbc8-4eab-a7de-631d4ae2be7b","uuid":"82a33d7a-3e03-4c57-805e-f9bfcd12e7f4","timestamp":"2026-08-28T15:38:38.486Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-Yo2Wur/translation/src/lib.rs","content":"// Rust translation of the C library in c_src/.\n//\n// Original copyright notice from the C sources:\n//\n// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\nuse std::ffi::{c_char, c_int, c_uint};\n\nextern \"C\" {\n    // C's printf, used so that output formatting *and* stdio buffering\n    // behaviour are byte-for-byte identical to the original library.\n    fn printf(format: *const c_char, ...) -> c_int;\n}\n\n/// Translation of\n///\n/// ```c\n/// typedef struct {\n///     unsigned int x : 2;\n///     unsigned int y : 3;\n///     bool b : 1;\n///     int z;\n/// } foo_t;\n/// ```\n///\n/// On the SysV/ELF ABI (gcc & clang) the three bit-fields share the first\n/// storage unit: `x` occupies bits 0..=1, `y` bits 2..=4 and `b` bit 5 of\n/// byte 0.  Bits 6..=7 of byte 0 and bytes 1..=3 are padding, `z` lives at\n/// offset 4.  `sizeof(foo_t) == 8`, `_Alignof(foo_t) == 4`.\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct foo_t {\n    /// Packed bit-field storage unit (x: bits 0-1, y: bits 2-4, b: bit 5).\n    bits: u8,\n    /// int z; (offset 4 thanks to the repr(C) alignment padding)\n    z: c_int,\n}\n\nimpl foo_t {\n    #[inline]\n    fn new(x: c_uint, y: c_uint, b: u8, z: c_int) -> Self {\n        // Exactly what the C compiler emits for\n        // `foo_t foo = {.x = x, .y = y, .b = b, .z = z};`\n        let bits = ((x as u8) & 0x3) | (((y as u8) & 0x7) << 2) | ((b & 0x1) << 5);\n        foo_t { bits, z }\n    }\n\n    /// `foo->x` — 2-bit unsigned bit-field, promoted to `int` for the\n    /// variadic call.\n    #[inline]\n    fn x(self) -> c_int {\n        (self.bits & 0x3) as c_int\n    }\n\n    /// `foo->y` — 3-bit unsigned bit-field, promoted to `int`.\n    #[inline]\n    fn y(self) -> c_int {\n        ((self.bits >> 2) & 0x7) as c_int\n    }\n\n    /// `foo->b` — 1-bit `bool` bit-field, promoted to `int`.\n    #[inline]\n    fn b(self) -> c_int {\n        ((self.bits >> 5) & 0x1) as c_int\n    }\n}\n\n/// ```c\n/// void print_foo(const foo_t *foo) {\n///     printf(\"%u %u %d %d\\n\", foo->x, foo->y, foo->b, foo->z);\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn print_foo(foo: *const foo_t) {\n    // The C code dereferences unconditionally; do the same.\n    let foo = unsafe { std::ptr::read(foo) };\n    unsafe {\n        printf(\n            b\"%u %u %d %d\\n\\0\".as_ptr() as *const c_char,\n            foo.x(),\n            foo.y(),\n            foo.b(),\n            foo.z,\n        );\n    }\n}\n\n/// ```c\n/// void driver(unsigned int x, unsigned int y, bool b, int z) {\n///     foo_t foo = {.x = x, .y = y, .b = b, .z = z};\n///     print_foo(&foo);\n/// }\n/// ```\n///\n/// `b` is taken as a `u8` rather than a Rust `bool` so that the (technically\n/// out-of-contract) case of a caller passing a byte other than 0/1 behaves\n/// like the C code does — the bit-field assignment keeps only bit 0.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn driver(x: c_uint, y: c_uint, b: u8, z: c_int) {\n    let foo = foo_t::new(x, y, b, z);\n    unsafe { print_foo(&foo as *const foo_t) };\n}\n","numLines":124,"startLine":1,"totalLines":124}}}
