ed — in both implementations.\n        let straddle: usize = s.parse().expect(\"numeric DIFF_CRASH_STRADDLE\");\n        let base = unsafe {\n            mmap(\n                std::ptr::null_mut(),\n                2 * PAGE,\n                PROT_READ | PROT_WRITE,\n                MAP_PRIVATE | MAP_ANONYMOUS,\n                -1,\n                0,\n            )\n        };\n        assert!(base as isize > 0, \"mmap failed\");\n        unsafe {\n            std::ptr::write_bytes(base as *mut u8, 0x5A, 2 * PAGE);\n            assert_eq!(mprotect((base as *mut u8).add(PAGE).cast(), PAGE, PROT_NONE), 0);\n            f((base as *const u8).add(PAGE - straddle));\n        }\n        std::process::exit(0);\n    }\n\n    let addr: usize = std::env::var(\"DIFF_CRASH_ADDR\")\n        .expect(\"DIFF_CRASH_ADDR\")\n        .parse()\n        .expect(\"numeric DIFF_CRASH_ADDR\");\n    unsafe { f(addr as *const u8) };\n    // Reached only if the call did *not* fault.\n    std::process::exit(0);\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":321,"cache_read_input_tokens":79067,"cache_creation":{"ephemeral_5m_input_tokens":321,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ee24cea0-fbc8-4eab-a7de-631d4ae2be7b","uuid":"86f07a7a-8c1b-44cd-88ea-dff67b3baa94","timestamp":"2026-08-28T15:47:38.707Z"}
