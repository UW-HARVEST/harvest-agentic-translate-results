{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0172FoCa5a2JTcrb9CEsDBZ2","type":"tool_result","content":"1\t// Rust translation of c_src/src/main.c\n2\t//\n3\t// Original copyright notice from the C source:\n4\t//\n5\t// Copyright 2025 MIT Lincoln Laboratory\n6\t// Permission is hereby granted, free of charge,\n7\t// to any person obtaining a copy of this software\n8\t// and associated documentation files (the \"Software\"),\n9\t// to deal in the Software without restriction,\n10\t// including without limitation the rights to use, copy,\n11\t// modify, merge, publish, distribute, sublicense,\n12\t// and/or sell copies of the Software,\n13\t// and to permit persons to whom the Software is furnished to do so,\n14\t// subject to the following conditions:\n15\t//\n16\t// The above copyright notice and this permission notice\n17\t// shall be included in all copies or substantial portions of the Software.\n18\t//\n19\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n20\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n21\t// THE WARRANTIES OF MERCHANTABILITY,\n22\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n23\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n24\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n25\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n26\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n27\t\n28\tuse std::io::{Read, Write};\n29\t\n30\t/// Mirrors `void driver(int x)`.\n31\t///\n32\t/// `register int y = 2*x; y += 300; printf(\"%d\\n\", y);`\n33\t///\n34\t/// Signed overflow is UB in C; gcc/clang at the codegen level wrap on two's\n35\t/// complement hardware, so wrapping arithmetic reproduces the observed\n36\t/// behavior for extreme inputs.\n37\tfn driver(x: i32) {\n38\t    let mut y: i32 = 2i32.wrapping_mul(x);\n39\t    y = y.wrapping_add(300);\n40\t\n41\t    // printf(\"%d\\n\", y)\n42\t    let stdout = std::io::stdout();\n43\t    let mut out = stdout.lock();\n44\t    let _ = write!(out, \"{}\\n\", y);\n45\t    let _ = out.flush();\n46\t}\n47\t\n48\t/// A one-byte-lookahead reader over stdin, so that we consume exactly the\n49\t/// bytes `scanf` would consume (it pushes back the first non-matching byte).\n50\tstruct Scanner {\n51\t    src: std::io::Stdin,\n52\t    peeked: Option<u8>,\n53\t    eof: bool,\n54\t}\n55\t\n56\timpl Scanner {\n57\t    fn new() -> Self {\n58\t        Scanner {\n59\t            src: std::io::stdin(),\n60\t            peeked: None,\n61\t            eof: false,\n62\t        }\n63\t    }\n64\t\n65\t    fn peek(&mut self) -> Option<u8> {\n66\t        if let Some(b) = self.peeked {\n67\t            return Some(b);\n68\t        }\n69\t        if self.eof {\n70\t            return None;\n71\t        }\n72\t        let mut buf = [0u8; 1];\n73\t        match self.src.read(&mut buf) {\n74\t            Ok(0) => {\n75\t                self.eof = true;\n76\t                None\n77\t            }\n78\t            Ok(_) => {\n79\t                self.peeked = Some(buf[0]);\n80\t                Some(buf[0])\n81\t            }\n82\t            Err(_) => {\n83\t                self.eof = true;\n84\t                None\n85\t            }\n86\t        }\n87\t    }\n88\t\n89\t    fn bump(&mut self) {\n90\t        self.peeked = None;\n91\t    }\n92\t\n93\t    /// Emulates `scanf(\"%d\", &out)` for the C locale.\n94\t    ///\n95\t    /// Returns the number of successfully assigned items (1), 0 on a matching\n96\t    /// failure, or -1 (EOF) when input ends before any conversion begins.\n97\t    /// On failure `out` is left untouched, exactly like C.\n98\t    fn scan_int(&mut self, out: &mut i32) -> i32 {\n99\t        // Skip leading whitespace, as the %d directive does.\n100\t        loop {\n101\t            match self.peek() {\n102\t                Some(b) if is_c_space(b) => self.bump(),\n103\t                Some(_) => break,\n104\t                None => return -1, // EOF before any conversion\n105\t            }\n106\t        }\n107\t\n108\t        let mut negative = false;\n109\t        match self.peek() {\n110\t            Some(b'+') => self.bump(),\n111\t            Some(b'-') => {\n112\t                negative = true;\n113\t                self.bump();\n114\t            }\n115\t            Some(_) => {}\n116\t            None => return -1,\n117\t        }\n118\t\n119\t        // glibc builds up the numeric text and hands it to strtol, which\n120\t        // saturates at LONG_MIN/LONG_MAX on overflow; the long result is then\n121\t        // stored through an `int *`, i.e. truncated to 32 bits.\n122\t        let mut digits = 0usize;\n123\t        let mut acc: i64 = 0;\n124\t        let mut overflow = false;\n125\t        loop {\n126\t            match self.peek() {\n127\t                Some(b) if b.is_ascii_digit() => {\n128\t                    let d = i64::from(b - b'0');\n129\t                    if !overflow {\n130\t                        match acc.checked_mul(10).and_then(|v| v.checked_add(d)) {\n131\t                            Some(v) => acc = v,\n132\t                            None => overflow = true,\n133\t                        }\n134\t                    }\n135\t                    digits += 1;\n136\t                    self.bump();\n137\t                }\n138\t                _ => break,\n139\t            }\n140\t        }\n141\t\n142\t        if digits == 0 {\n143\t            // Matching failure: no digits were consumed.\n144\t            return 0;\n145\t        }\n146\t\n147\t        let value: i64 = if overflow {\n148\t            if negative {\n149\t                i64::MIN\n150\t            } else {\n151\t                i64::MAX\n152\t            }\n153\t        } else if negative {\n154\t            acc.wrapping_neg()\n155\t        } else {\n156\t            acc\n157\t        };\n158\t\n159\t        *out = value as i32; // truncating store through `int *`\n160\t        1\n161\