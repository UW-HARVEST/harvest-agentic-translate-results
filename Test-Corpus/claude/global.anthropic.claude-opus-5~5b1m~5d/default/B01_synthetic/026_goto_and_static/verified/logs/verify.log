{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015NoYobHMrapZQsjkGDPY7Y","type":"tool_result","content":"1\t// Translation of c_src/src/main.c to Rust.\n2\t//\n3\t// Original copyright notice from the C source:\n4\t//\n5\t// Copyright 2025 MIT Lincoln Laboratory\n6\t// Permission is hereby granted, free of charge,\n7\t// to any person obtaining a copy of this software\n8\t// and associated documentation files (the \"Software\"),\n9\t// to deal in the Software without restriction,\n10\t// including without limitation the rights to use, copy,\n11\t// modify, merge, publish, distribute, sublicense,\n12\t// and/or sell copies of the Software,\n13\t// and to permit persons to whom the Software is furnished to do so,\n14\t// subject to the following conditions:\n15\t//\n16\t// The above copyright notice and this permission notice\n17\t// shall be included in all copies or substantial portions of the Software.\n18\t//\n19\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n20\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n21\t// THE WARRANTIES OF MERCHANTABILITY,\n22\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n23\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n24\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n25\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n26\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n27\t\n28\t// The C source uses printf with trailing newlines; print! + \"\\n\" keeps the\n29\t// format strings byte-identical to the originals.\n30\t#![allow(clippy::print_with_newline)]\n31\t\n32\tuse std::io::{Read, Write};\n33\t\n34\t/// A buffered byte reader over stdin with one byte of push-back, used to\n35\t/// emulate C's `scanf` character consumption semantics (which reads across\n36\t/// newlines, treating all whitespace the same).\n37\tstruct Scanner {\n38\t    buf: Vec<u8>,\n39\t    pos: usize,\n40\t    eof: bool,\n41\t    src: std::io::Stdin,\n42\t}\n43\t\n44\timpl Scanner {\n45\t    fn new() -> Self {\n46\t        Scanner {\n47\t            buf: Vec::new(),\n48\t            pos: 0,\n49\t            eof: false,\n50\t            src: std::io::stdin(),\n51\t        }\n52\t    }\n53\t\n54\t    /// Returns the next byte without consuming it, or None at EOF.\n55\t    fn peek(&mut self) -> Option<u8> {\n56\t        if self.pos < self.buf.len() {\n57\t            return Some(self.buf[self.pos]);\n58\t        }\n59\t        if self.eof {\n60\t            return None;\n61\t        }\n62\t        let mut chunk = [0u8; 4096];\n63\t        loop {\n64\t            match self.src.read(&mut chunk) {\n65\t                Ok(0) => {\n66\t                    self.eof = true;\n67\t                    return None;\n68\t                }\n69\t                Ok(n) => {\n70\t                    self.buf.clear();\n71\t                    self.buf.extend_from_slice(&chunk[..n]);\n72\t                    self.pos = 0;\n73\t                    return Some(self.buf[0]);\n74\t                }\n75\t                Err(ref e) if e.kind() == std::io::ErrorKind::Interrupted => continue,\n76\t                Err(_) => {\n77\t                    self.eof = true;\n78\t                    return None;\n79\t                }\n80\t            }\n81\t        }\n82\t    }\n83\t\n84\t    /// Consumes the byte returned by the most recent `peek`.\n85\t    fn bump(&mut self) {\n86\t        if self.pos < self.buf.len() {\n87\t            self.pos += 1;\n88\t        }\n89\t    }\n90\t\n91\t    fn skip_whitespace(&mut self) {\n92\t        while let Some(c) = self.peek() {\n93\t            // C's isspace() for the default \"C\" locale.\n94\t            if c == b' ' || c == b'\\t' || c == b'\\n' || c == b'\\r' || c == 0x0b || c == 0x0c {\n95\t                self.bump();\n96\t            } else {\n97\t                break;\n98\t            }\n99\t        }\n100\t    }\n101\t\n102\t    /// Emulates a single `%d` conversion. Returns Some(value) on a successful\n103\t    /// conversion, or None on input failure (EOF) or matching failure, in which\n104\t    /// case the caller must leave its destination unmodified, exactly as scanf\n105\t    /// does.\n106\t    fn scan_int(&mut self) -> Option<i32> {\n107\t        self.skip_whitespace();\n108\t\n109\t        let mut negative = false;\n110\t        match self.peek() {\n111\t            None => return None, // input failure\n112\t            Some(b'-') => {\n113\t                negative = true;\n114\t                self.bump();\n115\t            }\n116\t            Some(b'+') => {\n117\t                self.bump();\n118\t            }\n119\t            Some(_) => {}\n120\t        }\n121\t\n122\t        let mut saw_digit = false;\n123\t        // glibc accumulates into a long and saturates on overflow (as strtol\n124\t        // does), then truncates the result to int.\n125\t        let mut acc: i64 = 0;\n126\t        let mut overflow = false;\n127\t        while let Some(c) = self.peek() {\n128\t            if !c.is_ascii_digit() {\n129\t                break;\n130\t            }\n131\t            saw_digit = true;\n132\t            self.bump();\n133\t            let d = (c - b'0') as i64;\n134\t            if !overflow {\n135\t                match acc.checked_mul(10).and_then(|v| v.checked_add(d)) {\n136\t                    Some(v) => acc = v,\n137\t                    None => overflow = true,\n138\t                }\n139\t            }\n140\t        }\n141\t\n142\t        if !saw_digit {\n143\t            return None; // matching failure\n144\t        }\n145\t\n146\t        if overflow {\n147\t            let saturated: i64 = if negative { i64::MIN } else { i64::MAX };\n148\t            return Some(saturated as i32);\n149\t        }\n150\t\n151\t        let value = if negative { acc.wrapping_neg() } else { acc };\n152\t        Some(value as i32)\n153\t    }\n154\t}\n155\t\n156\t// `static int y = 123;` — file-scope