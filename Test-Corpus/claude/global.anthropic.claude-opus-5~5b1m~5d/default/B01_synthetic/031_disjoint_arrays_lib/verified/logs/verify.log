ursor,\n                c\"%d%zn\".as_ptr(),\n                &mut data[i] as *mut c_int,\n                &mut nb as *mut usize,\n            )\n        };\n        if matched != 1 {\n            break;\n        }\n        // `in += nb` in C is plain pointer arithmetic; `wrapping_add` matches it\n        // without `add`'s debug-checked in-bounds precondition.\n        cursor = cursor.wrapping_add(nb);\n        i += 1;\n    }\n\n    let result = unsafe { call_fma(data.as_ptr(), i as c_int) };\n    unsafe {\n        printf(c\"%d\\n\".as_ptr(), result);\n    }\n}\n","structuredPatch":[{"oldStart":80,"oldLines":11,"newStart":80,"newLines":22,"lines":["             // disagree on how they die (see ERRORS.md rows 19-20).","             // `wrapping_offset` lowers to the same `lea`/`add` and keeps the","             // observable behaviour identical to C in every cargo profile.","-            let m1 = *mul1.wrapping_offset(idx);","-            let m2 = *mul2.wrapping_offset(idx);","-            let a = *add.wrapping_offset(idx);","+            //","+            // Likewise `ptr::read`/`ptr::write` rather than `*p` / `*p = v`:","+            // with `-C debug-assertions=on` rustc inserts a null-pointer check","+            // around a raw-pointer *place* expression, which aborts (SIGABRT)","+            // instead of faulting (SIGSEGV) the way the C build does.","+            // `ptr::read`/`ptr::write` carry no such check, so `driver`'s and","+            // `call_fma`'s NULL-pointer UB dies identically to C under both the","+            // dev and the release profile.","+            let m1 = core::ptr::read(mul1.wrapping_offset(idx));","+            let m2 = core::ptr::read(mul2.wrapping_offset(idx));","+            let a = core::ptr::read(add.wrapping_offset(idx));","             // Signed overflow is UB in C; gcc/clang emit wrapping arithmetic.","-            *out.wrapping_offset(idx) = m1.wrapping_mul(m2).wrapping_add(a);","+            core::ptr::write(","+         