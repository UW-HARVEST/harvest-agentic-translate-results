        assert_eq!(\n529\t                String::from_utf8_lossy(&c_printed),\n530\t                expect,\n531\t                \"C pipeline value unexpected for n={n}\"\n532\t            );\n533\t        }\n534\t    }\n535\t}\n536\t"}]},"parent_tool_use_id":null,"session_id":"f1fb958d-d1d5-4563-a891-35147c9ad97a","uuid":"82f86614-7a93-44ce-abae-9630f73fa8c5","timestamp":"2026-08-28T15:30:22.732Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-1VWvPf/translation/tests/phase_b.rs","content":"// ---------------------------------------------------------------------------\n// row 34 : the composed pipeline, all three exports together\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg34_pipeline_cross_check() {\n    let mut rng = Rng::new(SEED ^ 34);\n    for _ in 0..800 {\n        let n = rng.below(130);\n        let vals: Vec<i32> = (0..n).map(|_| rng.i32_full()).collect();\n        let text = join_space(&vals);\n\n        // top level\n        assert_driver_eq(text.as_bytes());\n\n        // mid level on the same data, as `driver` would call it\n        let capped = &vals[..n.min(100)];\n        assert_call_fma_eq(if capped.is_empty() { &[0] } else { capped }, capped.len() as i32);\n\n        // low level: reproduce call_fma's own internals (ones / zeros) by hand\n        if !capped.is_empty() {\n            let ones = vec![1i32; capped.len()];\n            let zeros = vec![0i32; capped.len()];\n            assert_fma_array_eq(\n                Alias::Distinct,\n                capped.len() as i32,\n                &vec![0i32; capped.len()],\n                &ones,\n                capped,\n                &zeros,\n            );\n        }\n\n        // and the whole chain must agree on the printed value\n        let cs = cstring(text.as_bytes());\n        let c_printed = capture_stdout(|| unsafe { (c_impl().driver)(cs.as_ptr()) });\n        let r_printed = capture_stdout(|| unsafe { (rust_impl().driver)(cs.as_ptr()) });\n        assert_eq!(c_printed, r_printed);\n        if !capped.is_empty() {\n            let expect = format!(\"{}\\n\", capped[capped.len() - 1]);\n            assert_eq!(\n                String::from_utf8_lossy(&c_printed),\n                expect,\n                \"C pipeline value unexpected for n={n}\"\n            );\n        }\n    }\n}\n","numLines":49,"startLine":488,"totalLines":536}}}
