 (int i = 0; i < len; i++) {\n        out[i] = mul1[i] * mul2[i] + add[i];\n    }\n}\n\nint call_fma(const int *data, int len) {\n    if (len == 0) return 0;\n    int out[len];\n    int ones[len];\n    int zeros[len];\n\n    out[0] = 0;\n    for (int i = 0; i < len; i++) {\n        ones[i] = 1;\n        zeros[i] = 0;\n    }\n\n    fma_array(out, ones, data, zeros, len);\n    return out[len-1];\n}\n\nvoid driver(const char *in) {\n    int data[100];\n    int i;\n    for (i = 0; i < 100; i++) {\n        size_t nb;\n        if (sscanf(in, \"%d%zn\", &data[i], &nb) != 1) {\n            break;\n        }\n        in += nb;\n    }\n\n    int result = call_fma(data, i);\n    printf(\"%d\\n\", result);\n}\n","numLines":64,"startLine":1,"totalLines":64}}}
