1 by\n//!    `dup2`-ing it onto a temporary file around each call sequence.\n//! 2. The library keeps *file-scope mutable state* (`static house_t\n//!    the_house`), which is never reset. To make a row reproducible we\n//!    `dlopen` a **private copy** of each `.so` (unique path => unique inode =>\n//!    glibc gives it a fresh set of statics) for every sequence we run.\n\n#![allow(dead_code)]\n\nuse std::ffi::{c_char, c_int, CString};\nuse std::io::Read;\nuse std::path::{Path, PathBuf};\nuse std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::{Mutex, MutexGuard, OnceLock};\n\n/// fd 1 is process-wide, so only one capture may be in flight at a time even\n/// though `cargo test` runs test functions on many threads.\nfn stdout_lock() -> MutexGuard<'static, ()> {\n    static L: OnceLock<Mutex<()>> = OnceLock::new();\n    match L.get_or_init(|| Mutex::new(())).lock() {\n        Ok(g) => g,\n        Err(p) => p.into_inner(),\n    }\n}\n\npub const C_LIB: &str = concat!(\n    env!(\"CARGO_MANIFEST_DIR\"),\n    \"/../c_src/build/libdriver.so\"\n);\n\n/// The Rust `cdylib` under test, located next to the test binary.\npub fn rust_lib() -> PathBuf {\n    // tests run from target/<profile>/deps/<bin>, the cdylib is in target/<profile>/\n    let mut p = std::env::current_exe().expect(\"current_exe\");\n    p.pop(); // deps/\n    if p.file_name().map(|f| f == \"deps\").unwrap_or(false) {\n        p.pop();\n    }\n    let candidate = p.join(\"libdriver.so\");\n    assert!(\n        candidate.exists(),\n        \"Rust cdylib not found at {candidate:?}; run `cargo build` first\"\n    );\n    candidate\n}\n\npub fn c_lib() -> PathBuf {\n    let p = PathBuf::from(C_LIB);\n    assert!(\n        p.exists(),\n        \"C shared library not found at {p:?}; build it with cmake first\"\n    );\n    p\n}\n\n/// A single call into the library.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum Op {\n    /// `driver(in)` with these NUL-terminated bytes (NUL appended by harness).\n    Driver(Vec<u8>),\n    /// `driver(in)` with a raw byte buffer used verbatim (must contain a NUL).\n    DriverRaw(Vec<u8>),\n    /// `run(extra_bedrooms)`\n    Run(c_int),\n    /// Set `errno` to this value immediately before the *next* op.\n    SetErrno(c_int),\n}\n\npub fn drv(s: &str) -> Op {\n    Op::Driver(s.as_bytes().to_vec())\n}\n\npub fn run_op(v: c_int) -> Op {\n    Op::Run(v)\n}\n\nextern \"C\" {\n    fn __errno_location() -> *mut c_int;\n}\n\nstatic COUNTER: AtomicU64 = AtomicU64::new(0);\n\nfn tmp_dir() -> PathBuf {\n    std::env::var_os(\"TMPDIR\")\n        .map(PathBuf::from)\n        .unwrap_or_else(std::env::temp_dir)\n}\n\n/// Copy `src` to a fresh unique path so `dlopen` treats it as a brand-new\n/// object with its own copy of `the_house`.\nfn private_copy(src: &Path, tag: &str) -> PathBuf {\n    let n = COUNTER.fetch_add(1, Ordering::SeqCst);\n    let dst = tmp_dir().join(format!(\n        \"difftest_{}_{}_{}_{}.so\",\n        tag,\n        std::process::id(),\n        n,\n        // keep names distinct even across threads\n        std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .map(|d| d.subsec_nanos())\n            .unwrap_or(0)\n    ));\n    std::fs::copy(src, &dst).unwrap_or_else(|e| panic!(\"copy {src:?} -> {dst:?}: {e}\"));\n    dst\n}\n\n/// Capture everything written to fd 1 (stdout) by `f`.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    unsafe {\n        // Flush whatever the test harness itself has buffered so it does not\n        // land in our capture file.\n        libc::fflush(std::ptr::null_mut());\n\n        let n = COUNTER.fetch_add(1, Ordering::SeqCst);\n        let path = tmp_dir().join(format!(\"difftest_out_{}_{}.txt\", std::process::id(), n));\n        let cpath = CString::new(path.as_os_str().as_encoded_bytes()).unwrap();\n\n        let saved = libc::dup(1);\n        assert!(saved >= 0, \"dup(1) failed\");\n        let fd = libc::open(\n            cpath.as_ptr(),\n            libc::O_RDWR | libc::O_CREAT | libc::O_TRUNC,\n            0o600 as libc::c_int,\n        );\n        assert!(fd >= 0, \"open({path:?}) failed\");\n        assert!(libc::dup2(fd, 1) >= 0, \"dup2 failed\");\n\n        f();\n\n        // The library's printf output is block-buffered now that fd 1 is a\n        // file; flush every stream before restoring.\n        libc::fflush(std::ptr::null_mut());\n        libc::dup2(saved, 1);\n        libc::close(saved);\n        libc::close(fd);\n\n        let mut buf = Vec::new();\n        std::fs::File::open(&path)\n            .expect(\"reopen capture file\")\n            .read_to_end(&mut buf)\n            .expect(\"read capture file\");\n        let _ = std::fs::remove_file(&path);\n        buf\n    }\n}\n\ntype DriverFn = unsafe extern \"C\" fn(*const c_char);\ntype RunFn = unsafe extern \"C\" fn(c_int);\n\n/// Load a *fresh* copy of `lib`, execute `ops` in order, return captured stdout.\npub fn exec(lib: &Path, tag: &str, ops: &[Op]) -> Vec<u8> {\n    let copy = private_copy(lib, tag);\n    let _guard = stdout_lock();\n    let out = unsafe {\n        let l = libloading::Library::new(&copy)\n            .unwrap_or_else(|e| panic!(\"dlopen {copy:?}: {e}\"));\n        let driver: libloading::Symbol<DriverFn> =\n            l.get(b\"driver\\0\").expect(\"symbol `driver` missing\");\n        let run: libloading::Symbol<RunFn> = l.get(b\"run\\0\").expect(\"symbol `run` missing\");\n\n        let out = capture_stdout(|| {\n            let mut pending_errno: Option<c_int> = None;\n            for op in ops {\n                if let Op::SetErrno(v) = op {\n                    pending_errno = Some(*v);\n                    continue;\n                }\n                if let Some(v) = pending_errno.take() {\n                    *__errno_location() = v;\n                }\n                match op {\n                    Op::Driver(bytes) => {\n                        let mut b = bytes.clone();\n                        b.push(0);\n                        driver(b.as_ptr() as *const c_char);\n                    }\n                    Op::DriverRaw(bytes) => {\n                        driver(bytes.as_ptr() as *const c_char);\n                    }\n                    Op::Run(v) => run(*v),\n                    Op::SetErrno(_) => unreachable!(),\n                }\n            }\n        });\n        drop(l);\n        out\n    };\n    let _ = std::fs::remove_file(&copy);\n    out\n}\n\n/// Run `ops` against both libraries and assert byte-identical stdout.\n#[track_caller]\npub fn assert_same(label: &str, ops: &[Op]) -> Vec<u8> {\n    let c = exec(&c_lib(), \"c\", ops);\n    let r = exec(&rust_lib(), \"rs\", ops);\n    if c != r {\n        panic!(\n            \"DIVERGENCE [{label}]\\n  ops:  {ops:?}\\n  C   : {:?}\\n  Rust: {:?}\",\n            String::from_utf8_lossy(&c),\n            String::from_utf8_lossy(&r)\n        );\n    }\n    // Sanity: the library always prints something.\n    assert!(!c.is_empty(), \"[{label}] no output at all from either library\");\n    c\n}\n\n/// Convenience for single-op rows.\n#[track_caller]\npub fn assert_same_one(label: &str, op: Op) -> Vec<u8> {\n    assert_same(label, std::slice::from_ref(&op))\n}\n\n// ---------------------------------------------------------------------------\n// Deterministic PRNG (xorshift64*), so every \"randomized\" row is reproducible.\n// ---------------------------------------------------------------------------\npub struct Rng(u64);\n\nimpl Rng {\n    pub fn new(seed: u64) -> Self {\n        Rng(if seed == 0 { 0x9E3779B97F4A7C15 } else { seed })\n    }\n    pub fn next_u64(&mut self) -> u64 {\n        let mut x = self.0;\n        x ^= x >> 12;\n        x ^= x << 25;\n        x ^= x >> 27;\n        self.0 = x;\n        x.wrapping_mul(0x2545F4914F6CDD1D)\n    }\n    pub fn next_u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n    pub fn next_i32(&mut self) -> i32 {\n        self.next_u32() as i32\n    }\n    /// Uniform in `lo..=hi`.\n    pub fn range_i32(&mut self, lo: i32, hi: i32) -> i32 {\n        debug_assert!(lo <= hi);\n        let span = (hi as i64 - lo as i64 + 1) as u64;\n        (lo as i64 + (self.next_u64() % span) as i64) as i32\n    }\n    pub fn below(&mut self, n: usize) -> usize {\n        (self.next_u64() % n as u64) as usize\n    }\n    pub fn pick<'a, T>(&mut self, xs: &'a [T]) -> &'a T {\n        &xs[self.below(xs.len())]\n    }\n}\n","structuredPatch":[{"oldStart":47,"oldLines":11,"newStart":47,"newLines":23,"lines":["         p.pop();","     }","     let candidate = p.join(\"libdriver.so\");","-    assert!(","-        candidate.exists(),","-        \"Rust cdylib not found at {candidate:?}; run `cargo build` first\"","+    if candidate.exists() {","+        return candidate;","+    }","+    // Fall back to the sibling profile directory (a `cargo test` invocation does","+    // not always re-emit the cdylib artifact).","+    if let Some(target) = p.parent() {","+        for prof in [\"debug\", \"release\"] {","+            let alt = target.join(prof).join(\"libdriver.so\");","+            if alt.exists() {","+                return alt;","+            }","+        }","+    }","+    panic!(","+        \"Rust cdylib not found at {candidate:?}; run `cargo build` (and \\","+         `cargo build --release`) before `cargo test`\"","     );","-    candidate"," }"," "," pub fn c_lib() -> PathBuf {"]}],"userModified":false,"replaceAll":false}}
