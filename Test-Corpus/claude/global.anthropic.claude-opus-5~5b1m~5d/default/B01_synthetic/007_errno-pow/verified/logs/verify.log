{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01F5iH7wK8NrYesgcqdFh8fa","type":"tool_result","content":"1\t//! A reimplementation of glibc's `strtod` for the C locale, including its\n2\t//! `endptr` and `ERANGE` behaviour.\n3\t//!\n4\t//! glibc sets `ERANGE` when the conversion overflows (the result is an\n5\t//! infinity) and when it underflows.  Underflow is reported when the\n6\t//! infinitely precise value, rounded to 53 significant bits with an unbounded\n7\t//! exponent, stays below `2^-1022` *and* the conversion to `double` was\n8\t//! inexact.  So exactly representable subnormals do not raise `ERANGE`, and\n9\t//! neither do tiny values whose plain 53 bit rounding already reaches the\n10\t//! smallest normal number.\n11\t\n12\tuse crate::bignum::Big;\n13\tuse std::cmp::Ordering;\n14\t\n15\tpub struct Conversion {\n16\t    /// Converted value (0.0 when no conversion could be performed).\n17\t    pub value: f64,\n18\t    /// Number of bytes consumed; 0 means \"no conversion\", i.e. `endptr == nptr`.\n19\t    pub consumed: usize,\n20\t    /// Whether `errno` would have been set to `ERANGE`.\n21\t    pub erange: bool,\n22\t}\n23\t\n24\tfn is_space(c: u8) -> bool {\n25\t    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n26\t}\n27\t\n28\tfn is_digit(c: u8) -> bool {\n29\t    c.is_ascii_digit()\n30\t}\n31\t\n32\tfn is_hex_digit(c: u8) -> bool {\n33\t    c.is_ascii_hexdigit()\n34\t}\n35\t\n36\tfn hex_val(c: u8) -> u32 {\n37\t    match c {\n38\t        b'0'..=b'9' => (c - b'0') as u32,\n39\t        b'a'..=b'f' => (c - b'a') as u32 + 10,\n40\t        _ => (c - b'A') as u32 + 10,\n41\t    }\n42\t}\n43\t\n44\tfn eq_ignore_case_prefix(s: &[u8], prefix: &[u8]) -> bool {\n45\t    s.len() >= prefix.len()\n46\t        && s[..prefix.len()]\n47\t            .iter()\n48\t            .zip(prefix.iter())\n49\t            .all(|(a, b)| a.to_ascii_lowercase() == *b)\n50\t}\n51\t\n52\tfn apply_sign(v: f64, neg: bool) -> f64 {\n53\t    if neg {\n54\t        -v\n55\t    } else {\n56\t        v\n57\t    }\n58\t}\n59\t\n60\t/// Parse a run of decimal digits into an exponent, saturating at a magnitude\n61\t/// far beyond anything that can influence the result.\n62\tfn parse_exp_digits(s: &[u8], mut i: usize, neg: bool) -> (i64, usize) {\n63\t    let mut val: i64 = 0;\n64\t    while i < s.len() && is_digit(s[i]) {\n65\t        if val < 1_000_000_000_000 {\n66\t            val = val * 10 + (s[i] - b'0') as i64;\n67\t        }\n68\t        i += 1;\n69\t    }\n70\t    (if neg { -val } else { val }, i)\n71\t}\n72\t\n73\tpub fn strtod(s: &[u8]) -> Conversion {\n74\t    let no_conversion = Conversion {\n75\t        value: 0.0,\n76\t        consumed: 0,\n77\t        erange: false,\n78\t    };\n79\t\n80\t    let mut i = 0usize;\n81\t    while i < s.len() && is_space(s[i]) {\n82\t        i += 1;\n83\t    }\n84\t\n85\t    let mut neg = false;\n86\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n87\t        neg = s[i] == b'-';\n88\t        i += 1;\n89\t    }\n90\t\n91\t    // Hexadecimal form: 0x / 0X\n92\t    if i + 1 < s.len() && s[i] == b'0' && (s[i + 1] | 0x20) == b'x' {\n93\t        let zero_pos = i; // the '0' itself\n94\t        let mut j = i + 2;\n95\t        let mut digits: Vec<u8> = Vec::new();\n96\t        let mut frac_len: usize = 0;\n97\t        while j < s.len() && is_hex_digit(s[j]) {\n98\t            digits.push(s[j]);\n99\t            j += 1;\n100\t        }\n101\t        if j < s.len() && s[j] == b'.' {\n102\t            let dot = j;\n103\t            j += 1;\n104\t            while j < s.len() && is_hex_digit(s[j]) {\n105\t                digits.push(s[j]);\n106\t                frac_len += 1;\n107\t                j += 1;\n108\t            }\n109\t            if digits.is_empty() {\n110\t                // \"0x.\": no digits at all, roll back to just before the dot.\n111\t                j = dot;\n112\t            }\n113\t        }\n114\t        if digits.is_empty() {\n115\t            // No hex digits: glibc converts just the leading \"0\".\n116\t            return Conversion {\n117\t                value: apply_sign(0.0, neg),\n118\t                consumed: zero_pos + 1,\n119\t                erange: false,\n120\t            };\n121\t        }\n122\t        // Optional binary exponent.\n123\t        let mut pexp: i64 = 0;\n124\t        if j < s.len() && (s[j] | 0x20) == b'p' {\n125\t            let mut k = j + 1;\n126\t            let mut eneg = false;\n127\t            if k < s.len() && (s[k] == b'+' || s[k] == b'-') {\n128\t                eneg = s[k] == b'-';\n129\t                k += 1;\n130\t            }\n131\t            if k < s.len() && is_digit(s[k]) {\n132\t                let (e, end) = parse_exp_digits(s, k, eneg);\n133\t                pexp = e;\n134\t                j = end;\n135\t            }\n136\t        }\n137\t        let (value, erange) = hex_value(&digits, frac_len, pexp);\n138\t        return Conversion {\n139\t            value: apply_sign(value, neg),\n140\t            consumed: j,\n141\t            erange,\n142\t        };\n143\t    }\n144\t\n145\t    // Infinity / NaN\n146\t    let rest = &s[i..];\n147\t    if eq_ignore_case_prefix(rest, b\"infinity\") {\n148\t        return Conversion {\n149\t            value: apply_sign(f64::INFINITY, neg),\n150\t            consumed: i + 8,\n151\t            erange: false,\n152\t        };\n153\t    }\n154\t    if eq_ignore_case_prefix(rest, b\"inf\") {\n155\t        return Conversion {\n156\t            value: apply_sign(f64::INFINITY, neg),\n157\t            consumed: i + 3,\n158\t            erange: false,\n159\t        };\n160\t    }\n161\t    if eq_ignore_case_prefix(rest, b\"nan\") {\n162\t        let mut j = i + 3;\n163\t        if j < s.len() && s[j] == b'(' {\n164\t            let mut k = j + 1;\n165\t            while k < s.len() && (s[k].is_ascii_alphanumeric() || s[k] == b'_') {\n166\t                k += 1;\n167\t            }\n168\t            if k < s.len() && s[k] == b')' {\n169\t                j = k + 1;\n170\t            }\n171\t        }\n172\t        return Conversion {\n173\t            value: apply_sign(f64::NAN, neg),\n174\t            consumed: j,\n175\t            erange: false,\n176\t        };\n177\t    }\n178\t\n179\t    // Decimal form\n180\t    let mut digits: Vec<u8> = Vec::new();\n181\t    let mut frac_len: usize = 0;\n182\t    let mut j = i;\n183\t    while j < s.len() && is_digit(s[j]) {\n184\t        digits.push(s[j]);\n185\t        j += 1;\n186\t    }\n187\t    if j < s.len() && s[j] == b'.' {\n188\t        let dot = j;\n189\t        j += 1;\n190\t        while j < s.len() && is_digit(s[j]) {\n191\t            digits.push(s[j]);\n192\t            frac_len += 1;\n193\t            j += 1;\n194\t        }\n195\t        if digits.is_empty() {\n196\t            // \".\": no digits at all, roll back to just before the dot.\n197\t            j = dot;\n198\t        }\n199\t    }\n200\t    if digits.is_empty() {\n201\t        return no_conversion;\n202\t    }\n203\t    let mut exp10: i64 = 0;\n204\t    if j < s.len() && (s[j] | 0x20) == b'e' {\n205\t        let mut k = j + 1;\n206\t        let mut eneg = false;\n207\t        if k < s.len() && (s[k] == b'+' || s[k] == b'-') {\n208\t            eneg = s[k] == b'-';\n209\t            k += 1;\n210\t        }\n211\t        if k < s.len() && is_digit(s[k]) {\n212\t            let (e, end) = parse_exp_digits(s, k, eneg);\n213\t            exp10 = e;\n214\t            j = end;\n215\t        }\n216\t    }\n217\t\n218\t    let (value, erange) = decimal_value(&digits, frac_len, exp10);\n219\t    Conversion {\n220\t        value: apply_sign(value, neg),\n221\t        consumed: j,\n222\t        erange,\n223\t    }\n224\t}\n225\t\n226\t/// Value of a decimal mantissa (`digits`, of which the last `frac_len` are\n227\t/// fractional) scaled by 10^`exp10`, together with the `ERANGE` flag.\n228\tfn decimal_value(digits: &[u8], frac_len: usize, exp10: i64) -> (f64, bool) {\n229\t    // Significant digits: strip leading and trailing zeros, folding the removed\n230\t    // trailing zeros into the decimal exponent.\n231\t    let first = digits.iter().position(|&c| c != b'0');\n232\t    let first = match first {\n233\t        Some(p) => p,\n234\t        None => return (0.0, false), // value is exactly zero\n235\t    };\n236\t    let last = digits.iter().rposition(|&c| c != b'0').unwrap();\n237\t    let sig = &digits[first..=last];\n238\t    let trailing_zeros = (digits.len() - 1 - last) as i64;\n239\t    let e10 = exp10\n240\t        .saturating_sub(frac_len as i64)\n241\t        .saturating_add(trailing_zeros);\n242\t\n243\t    // Correctly rounded conversion, with the exponent clamped to a value that\n244\t    // is guaranteed to produce the same infinity / zero result.\n245\t    let lo = -(sig.len() as i64 + 400);\n246\t    let hi = 400i64;\n247\t    let clamped = if e10 < lo {\n248\t        lo\n249\t    } else if e10 > hi {\n250\t        hi\n251\t    } else {\n252\t        e10\n253\t    };\n254\t    let mut text = String::with_capacity(sig.len() + 24);\n255\t    text.push_str(std::str::from_utf8(sig).unwrap());\n256\t    text.push('e');\n257\t    text.push_str(&clamped.to_string());\n258\t    let value: f64 = text.parse().unwrap_or(f64::INFINITY);\n259\t\n260\t    if value.is_infinite() {\n261\t        return (value, true); // overflow\n262\t    }\n263\t    // Underflow: glibc raises ERANGE when the exact value is below\n264\t    // `2^-1022 - 2^-1076` (i.e. rounding it at plain 53 bit precision does not\n265\t    // reach the smallest normal number) and it is not exactly representable on\n266\t    // the subnormal grid.\n267\t    if value.abs() < f64::MIN_POSITIVE {\n268\t        // The exact value is necessarily below the threshold here.\n269\t        if !is_exact_subnormal(sig, e10) {\n270\t            return (value, true);\n271\t        }\n272\t    } else if value.abs() == f64::MIN_POSITIVE && below_underflow_threshold(sig, e10) {\n273\t        return (value, true);\n274\t    }\n275\t    (value, false)\n276\t}\n277\t\n278\t/// Is `sig * 10^e10` (a positive value) strictly smaller than\n279\t/// `2^-1022 - 2^-1076` = `(2^54 - 1) * 2^-1076`?\n280\tfn below_underflow_threshold(sig: &[u8], e10: i64) -> bool {\n281\t    if e10 >= 0 {\n282\t        return false;\n283\t    }\n284\t    let f = -(e10 as i128);\n285\t    let len = sig.len() as i128;\n286\t    // value < 10^(len - f) and value >= 10^(len - 1 - f)\n287\t    if len - f <= -309 {\n288\t        return true;\n289\t    }\n290\t    if len - 1 - f >= -307 {\n291\t        return false;\n292\t    }\n293\t    // Borderline: compare sig * 2^1076 against (2^54 - 1) * 10^f exactly.\n294\t    let mut a = Big::from_digits(sig);\n295\t    a.shl_bits(1076);\n296\t    let mut b = Big::pow10(f as usize);\n297\t    b.mul_add_small(134_217_727, 0); // 2^27 - 1\n298\t    b.mul_add_small(134_217_729, 0); // 2^27 + 1\n299\t    a.cmp_big(&b) == Ordering::Less\n300\t}\n301\t\n302\t/// Is `sig * 10^e10` an exact integer multiple of 2^-1074 (i.e. exactly\n303\t/// representable as a subnormal double)?\n304\tfn is_exact_subnormal(sig: &[u8], e10: i64) -> bool {\n305\t    if e10 >= 0 {\n306\t        return true;\n307\t    }\n308\t    let f = -e10;\n309\t    // sig must be divisible by 5^f, which requires sig >= 5^f.\n310\t    if (sig.len() as f64) < 0.69897 * (f as f64) {\n311\t        return false;\n312\t    }\n313\t    let f = f as usize;\n314\t    let mut n = Big::from_digits(sig);\n315\t    let mut left = f;\n316\t    while left > 0 {\n317\t        let k = left.min(13);\n318\t        let mut d: u32 = 1;\n319\t        for _ in 0..k {\n320\t            d *= 5;\n321\t        }\n322\t        if n.divmod_small(d) != 0 {\n323\t            return false;\n324\t        }\n325\t        left -= k;\n326\t    }\n327\t    if f > 1074 {\n328\t        let mut bits = f - 1074;\n329\t        while bits > 0 {\n330\t            let k = bits.min(31);\n331\t            if n.divmod_small(1u32 << k) != 0 {\n332\t                return false;\n333\t            }\n334\t            bits -= k;\n335\t        }\n336\t    }\n337\t    true\n338\t}\n339\t\n340\t/// Value of a hexadecimal mantissa (`digits`, of which the last `frac_len` are\n341\t/// fractional) scaled by 2^`pexp`, together with the `ERANGE` flag.\n342\tfn hex_value(digits: &[u8], frac_len: usize, pexp: i64) -> (f64, bool) {\n343\t    let mut sig: u128 = 0;\n344\t    let mut sticky = false;\n345\t    let mut dropped_bits: i128 = 0;\n346\t    for &c in digits {\n347\t        let v = hex_val(c) as u128;\n348\t        if sig == 0 && v == 0 {\n349\t            continue;\n350\t        }\n351\t        if sig >> 120 != 0 {\n352\t            sticky |= v != 0;\n353\t            dropped_bits += 4;\n354\t        } else {\n355\t            sig = (sig << 4) | v;\n356\t        }\n357\t    }\n358\t    if sig == 0 {\n359\t        return (0.0, false);\n360\t    }\n361\t    let exp2 = (pexp as i128) - 4 * (frac_len as i128) + dropped_bits;\n362\t    round_to_double(sig, sticky, exp2)\n363\t}\n364\t\n365\t/// Round `sig * 2^exp2` (plus a sticky remainder below the last bit of `sig`)\n366\t/// to `keep` significant bits, to nearest with ties to even.  Returns the\n367\t/// rounded significand, its binary exponent and whether anything was lost.\n368\tfn round_keep(sig: u128, sticky: bool, exp2: i128, keep: i128) -> (u128, i128, bool) {\n369\t    let bl = (128 - sig.leading_zeros()) as i128;\n370\t    let shift = bl - keep;\n371\t    let (m, inexact) = if shift <= 0 {\n372\t        (sig << ((-shift) as u32), sticky)\n373\t    } else if shift >= 129 {\n374\t        (0u128, true)\n375\t    } else if shift == 128 {\n376\t        let half = 1u128 << 127;\n377\t        let up = sig > half || (sig == half && sticky);\n378\t        (if up { 1u128 } else { 0u128 }, true)\n379\t    } else {\n380\t        let sh = shift as u32;\n381\t        let dropped = sig & ((1u128 << sh) - 1);\n382\t        let half = 1u128 << (sh - 1);\n383\t        let q = sig >> sh;\n384\t        let up = dropped > half || (dropped == half && (sticky || (q & 1) == 1));\n385\t        (if up { q + 1 } else { q }, sticky || dropped != 0)\n386\t    };\n387\t    (m, exp2 + shift, inexact)\n388\t}\n389\t\n390\t/// Round `sig * 2^exp2` (plus a sticky remainder below the last bit of `sig`)\n391\t/// to the nearest double, reporting whether `ERANGE` would be raised.\n392\tfn round_to_double(sig: u128, sticky: bool, exp2: i128) -> (f64, bool) {\n393\t    let bl = (128 - sig.leading_zeros()) as i128;\n394\t    let e_msb = exp2 + bl - 1; // exponent of the most significant bit\n395\t    let tiny = e_msb < -1022;\n396\t\n397\t    if e_msb > 1024 {\n398\t        return (f64::INFINITY, true);\n399\t    }\n400\t\n401\t    // Rounding at full 53 bit precision (as if the exponent range were\n402\t    // unbounded).\n403\t    let (m53, e53, _) = round_keep(sig, sticky, exp2, 53);\n404\t\n405\t    if tiny {\n406\t        // If rounding at full precision already reaches the smallest normal\n407\t        // number, glibc does not consider the result tiny and raises nothing.\n408\t        let bl53 = (128 - m53.leading_zeros()) as i128;\n409\t        if m53 != 0 && e53 + bl53 - 1 >= -1022 {\n410\t            return (f64::MIN_POSITIVE, false);\n411\t        }\n412\t        // Otherwise round on the subnormal grid; ERANGE if that is inexact.\n413\t        let keep = e_msb + 1075;\n414\t        let (m, e, inexact) = round_keep(sig, sticky, exp2, keep);\n415\t        (build(m, e), inexact)\n416\t    } else {\n417\t        // Overflow check after rounding.\n418\t        let bl53 = (128 - m53.leading_zeros()) as i128;\n419\t        if e53 + bl53 - 1 > 1023 {\n420\t            return (f64::INFINITY, true);\n421\t        }\n422\t        (build(m53, e53), false)\n423\t    }\n424\t}\n425\t\n426\t/// Exactly `m * 2^e`, where the product is known to be representable.\n427\tfn build(mut m: u128, mut e: i128) -> f64 {\n428\t    if m == 0 {\n429\t        return 0.0;\n430\t    }\n431\t    while e < -1074 && m % 2 == 0 {\n432\t        m /= 2;\n433\t        e += 1;\n434\t    }\n435\t    if e < -1074 {\n436\t        // Unreachable: rounding always lands on a representable value.\n437\t        return 0.0;\n438\t    }\n439\t    (m as f64) * pow2(e as i32)\n440\t}\n441\t\n442\t/// Exact 2^e for -1074 <= e <= 1023.\n443\tfn pow2(e: i32) -> f64 {\n444\t    if e >= -1022 {\n445\t        f64::from_bits(((e + 1023) as u64) << 52)\n446\t    } else {\n447\t        f64::from_bits(1u64 << (e + 1074))\n448\t    }\n449\t}\n450\t\n451\t"}]},"parent_tool_use_id":null,"session_id":"7507347f-a3c4-487e-9901-385ddd2daa38","uuid":"3bc1646b-a7d3-498b-ad9d-36ff1e935112","timestamp":"2026-08-28T10:24:48.961Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-BkxWKo/translation/src/strtod.rs","content":"//! A reimplementation of glibc's `strtod` for the C locale, including its\n//! `endptr` and `ERANGE` behaviour.\n//!\n//! glibc sets `ERANGE` when the conversion overflows (the result is an\n//! infinity) and when it underflows.  Underflow is reported when the\n//! infinitely precise value, rounded to 53 significant bits with an unbounded\n//! exponent, stays below `2^-1022` *and* the conversion to `double` was\n//! inexact.  So exactly representable subnormals do not raise `ERANGE`, and\n//! neither do tiny values whose plain 53 bit rounding already reaches the\n//! smallest normal number.\n\nuse crate::bignum::Big;\nuse std::cmp::Ordering;\n\npub struct Conversion {\n    /// Converted value (0.0 when no conversion could be performed).\n    pub value: f64,\n    /// Number of bytes consumed; 0 means \"no conversion\", i.e. `endptr == nptr`.\n    pub consumed: usize,\n    /// Whether `errno` would have been set to `ERANGE`.\n    pub erange: bool,\n}\n\nfn is_space(c: u8) -> bool {\n    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n}\n\nfn is_digit(c: u8) -> bool {\n    c.is_ascii_digit()\n}\n\nfn is_hex_digit(c: u8) -> bool {\n    c.is_ascii_hexdigit()\n}\n\nfn hex_val(c: u8) -> u32 {\n    match c {\n        b'0'..=b'9' => (c - b'0') as u32,\n        b'a'..=b'f' => (c - b'a') as u32 + 10,\n        _ => (c - b'A') as u32 + 10,\n    }\n}\n\nfn eq_ignore_case_prefix(s: &[u8], prefix: &[u8]) -> bool {\n    s.len() >= prefix.len()\n        && s[..prefix.len()]\n            .iter()\n            .zip(prefix.iter())\n            .all(|(a, b)| a.to_ascii_lowercase() == *b)\n}\n\nfn apply_sign(v: f64, neg: bool) -> f64 {\n    if neg {\n        -v\n    } else {\n        v\n    }\n}\n\n/// Parse a run of decimal digits into an exponent, saturating at a magnitude\n/// far beyond anything that can influence the result.\nfn parse_exp_digits(s: &[u8], mut i: usize, neg: bool) -> (i64, usize) {\n    let mut val: i64 = 0;\n    while i < s.len() && is_digit(s[i]) {\n        if val < 1_000_000_000_000 {\n            val = val * 10 + (s[i] - b'0') as i64;\n        }\n        i += 1;\n    }\n    (if neg { -val } else { val }, i)\n}\n\npub fn strtod(s: &[u8]) -> Conversion {\n    let no_conversion = Conversion {\n        value: 0.0,\n        consumed: 0,\n        erange: false,\n    };\n\n    let mut i = 0usize;\n    while i < s.len() && is_space(s[i]) {\n        i += 1;\n    }\n\n    let mut neg = false;\n    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n        neg = s[i] == b'-';\n        i += 1;\n    }\n\n    // Hexadecimal form: 0x / 0X\n    if i + 1 < s.len() && s[i] == b'0' && (s[i + 1] | 0x20) == b'x' {\n        let zero_pos = i; // the '0' itself\n        let mut j = i + 2;\n        let mut digits: Vec<u8> = Vec::new();\n        let mut frac_len: usize = 0;\n        while j < s.len() && is_hex_digit(s[j]) {\n            digits.push(s[j]);\n            j += 1;\n        }\n        if j < s.len() && s[j] == b'.' {\n            let dot = j;\n            j += 1;\n            while j < s.len() && is_hex_digit(s[j]) {\n                digits.push(s[j]);\n                frac_len += 1;\n                j += 1;\n            }\n            if digits.is_empty() {\n                // \"0x.\": no digits at all, roll back to just before the dot.\n                j = dot;\n            }\n        }\n        if digits.is_empty() {\n            // No hex digits: glibc converts just the leading \"0\".\n            return Conversion {\n                value: apply_sign(0.0, neg),\n                consumed: zero_pos + 1,\n                erange: false,\n            };\n        }\n        // Optional binary exponent.\n        let mut pexp: i64 = 0;\n        if j < s.len() && (s[j] | 0x20) == b'p' {\n            let mut k = j + 1;\n            let mut eneg = false;\n            if k < s.len() && (s[k] == b'+' || s[k] == b'-') {\n                eneg = s[k] == b'-';\n                k += 1;\n            }\n            if k < s.len() && is_digit(s[k]) {\n                let (e, end) = parse_exp_digits(s, k, eneg);\n                pexp = e;\n                j = end;\n            }\n        }\n        let (value, erange) = hex_value(&digits, frac_len, pexp);\n        return Conversion {\n            value: apply_sign(value, neg),\n            consumed: j,\n            erange,\n        };\n    }\n\n    // Infinity / NaN\n    let rest = &s[i..];\n    if eq_ignore_case_prefix(rest, b\"infinity\") {\n        return Conversion {\n            value: apply_sign(f64::INFINITY, neg),\n            consumed: i + 8,\n            erange: false,\n        };\n    }\n    if eq_ignore_case_prefix(rest, b\"inf\") {\n        return Conversion {\n            value: apply_sign(f64::INFINITY, neg),\n            consumed: i + 3,\n            erange: false,\n        };\n    }\n    if eq_ignore_case_prefix(rest, b\"nan\") {\n        let mut j = i + 3;\n        if j < s.len() && s[j] == b'(' {\n            let mut k = j + 1;\n            while k < s.len() && (s[k].is_ascii_alphanumeric() || s[k] == b'_') {\n                k += 1;\n            }\n            if k < s.len() && s[k] == b')' {\n                j = k + 1;\n            }\n        }\n        return Conversion {\n            value: apply_sign(f64::NAN, neg),\n            consumed: j,\n            erange: false,\n        };\n    }\n\n    // Decimal form\n    let mut digits: Vec<u8> = Vec::new();\n    let mut frac_len: usize = 0;\n    let mut j = i;\n    while j < s.len() && is_digit(s[j]) {\n        digits.push(s[j]);\n        j += 1;\n    }\n    if j < s.len() && s[j] == b'.' {\n        let dot = j;\n        j += 1;\n        while j < s.len() && is_digit(s[j]) {\n            digits.push(s[j]);\n            frac_len += 1;\n            j += 1;\n        }\n        if digits.is_empty() {\n            // \".\": no digits at all, roll back to just before the dot.\n            j = dot;\n        }\n    }\n    if digits.is_empty() {\n        return no_conversion;\n    }\n    let mut exp10: i64 = 0;\n    if j < s.len() && (s[j] | 0x20) == b'e' {\n        let mut k = j + 1;\n        let mut eneg = false;\n        if k < s.len() && (s[k] == b'+' || s[k] == b'-') {\n            eneg = s[k] == b'-';\n            k += 1;\n        }\n        if k < s.len() && is_digit(s[k]) {\n            let (e, end) = parse_exp_digits(s, k, eneg);\n            exp10 = e;\n            j = end;\n        }\n    }\n\n    let (value, erange) = decimal_value(&digits, frac_len, exp10);\n    Conversion {\n        value: apply_sign(value, neg),\n        consumed: j,\n        erange,\n    }\n}\n\n/// Value of a decimal mantissa (`digits`, of which the last `frac_len` are\n/// fractional) scaled by 10^`exp10`, together with the `ERANGE` flag.\nfn decimal_value(digits: &[u8], frac_len: usize, exp10: i64) -> (f64, bool) {\n    // Significant digits: strip leading and trailing zeros, folding the removed\n    // trailing zeros into the decimal exponent.\n    let first = digits.iter().position(|&c| c != b'0');\n    let first = match first {\n        Some(p) => p,\n        None => return (0.0, false), // value is exactly zero\n    };\n    let last = digits.iter().rposition(|&c| c != b'0').unwrap();\n    let sig = &digits[first..=last];\n    let trailing_zeros = (digits.len() - 1 - last) as i64;\n    let e10 = exp10\n        .saturating_sub(frac_len as i64)\n        .saturating_add(trailing_zeros);\n\n    // Correctly rounded conversion, with the exponent clamped to a value that\n    // is guaranteed to produce the same infinity / zero result.\n    let lo = -(sig.len() as i64 + 400);\n    let hi = 400i64;\n    let clamped = if e10 < lo {\n        lo\n    } else if e10 > hi {\n        hi\n    } else {\n        e10\n    };\n    let mut text = String::with_capacity(sig.len() + 24);\n    text.push_str(std::str::from_utf8(sig).unwrap());\n    text.push('e');\n    text.push_str(&clamped.to_string());\n    let value: f64 = text.parse().unwrap_or(f64::INFINITY);\n\n    if value.is_infinite() {\n        return (value, true); // overflow\n    }\n    // Underflow: glibc raises ERANGE when the exact value is below\n    // `2^-1022 - 2^-1076` (i.e. rounding it at plain 53 bit precision does not\n    // reach the smallest normal number) and it is not exactly representable on\n    // the subnormal grid.\n    if value.abs() < f64::MIN_POSITIVE {\n        // The exact value is necessarily below the threshold here.\n        if !is_exact_subnormal(sig, e10) {\n            return (value, true);\n        }\n    } else if value.abs() == f64::MIN_POSITIVE && below_underflow_threshold(sig, e10) {\n        return (value, true);\n    }\n    (value, false)\n}\n\n/// Is `sig * 10^e10` (a positive value) strictly smaller than\n/// `2^-1022 - 2^-1076` = `(2^54 - 1) * 2^-1076`?\nfn below_underflow_threshold(sig: &[u8], e10: i64) -> bool {\n    if e10 >= 0 {\n        return false;\n    }\n    let f = -(e10 as i128);\n    let len = sig.len() as i128;\n    // value < 10^(len - f) and value >= 10^(len - 1 - f)\n    if len - f <= -309 {\n        return true;\n    }\n    if len - 1 - f >= -307 {\n        return false;\n    }\n    // Borderline: compare sig * 2^1076 against (2^54 - 1) * 10^f exactly.\n    let mut a = Big::from_digits(sig);\n    a.shl_bits(1076);\n    let mut b = Big::pow10(f as usize);\n    b.mul_add_small(134_217_727, 0); // 2^27 - 1\n    b.mul_add_small(134_217_729, 0); // 2^27 + 1\n    a.cmp_big(&b) == Ordering::Less\n}\n\n/// Is `sig * 10^e10` an exact integer multiple of 2^-1074 (i.e. exactly\n/// representable as a subnormal double)?\nfn is_exact_subnormal(sig: &[u8], e10: i64) -> bool {\n    if e10 >= 0 {\n        return true;\n    }\n    let f = -e10;\n    // sig must be divisible by 5^f, which requires sig >= 5^f.\n    if (sig.len() as f64) < 0.69897 * (f as f64) {\n        return false;\n    }\n    let f = f as usize;\n    let mut n = Big::from_digits(sig);\n    let mut left = f;\n    while left > 0 {\n        let k = left.min(13);\n        let mut d: u32 = 1;\n        for _ in 0..k {\n            d *= 5;\n        }\n        if n.divmod_small(d) != 0 {\n            return false;\n        }\n        left -= k;\n    }\n    if f > 1074 {\n        let mut bits = f - 1074;\n        while bits > 0 {\n            let k = bits.min(31);\n            if n.divmod_small(1u32 << k) != 0 {\n                return false;\n            }\n            bits -= k;\n        }\n    }\n    true\n}\n\n/// Value of a hexadecimal mantissa (`digits`, of which the last `frac_len` are\n/// fractional) scaled by 2^`pexp`, together with the `ERANGE` flag.\nfn hex_value(digits: &[u8], frac_len: usize, pexp: i64) -> (f64, bool) {\n    let mut sig: u128 = 0;\n    let mut sticky = false;\n    let mut dropped_bits: i128 = 0;\n    for &c in digits {\n        let v = hex_val(c) as u128;\n        if sig == 0 && v == 0 {\n            continue;\n        }\n        if sig >> 120 != 0 {\n            sticky |= v != 0;\n            dropped_bits += 4;\n        } else {\n            sig = (sig << 4) | v;\n        }\n    }\n    if sig == 0 {\n        return (0.0, false);\n    }\n    let exp2 = (pexp as i128) - 4 * (frac_len as i128) + dropped_bits;\n    round_to_double(sig, sticky, exp2)\n}\n\n/// Round `sig * 2^exp2` (plus a sticky remainder below the last bit of `sig`)\n/// to `keep` significant bits, to nearest with ties to even.  Returns the\n/// rounded significand, its binary exponent and whether anything was lost.\nfn round_keep(sig: u128, sticky: bool, exp2: i128, keep: i128) -> (u128, i128, bool) {\n    let bl = (128 - sig.leading_zeros()) as i128;\n    let shift = bl - keep;\n    let (m, inexact) = if shift <= 0 {\n        (sig << ((-shift) as u32), sticky)\n    } else if shift >= 129 {\n        (0u128, true)\n    } else if shift == 128 {\n        let half = 1u128 << 127;\n        let up = sig > half || (sig == half && sticky);\n        (if up { 1u128 } else { 0u128 }, true)\n    } else {\n        let sh = shift as u32;\n        let dropped = sig & ((1u128 << sh) - 1);\n        let half = 1u128 << (sh - 1);\n        let q = sig >> sh;\n        let up = dropped > half || (dropped == half && (sticky || (q & 1) == 1));\n        (if up { q + 1 } else { q }, sticky || dropped != 0)\n    };\n    (m, exp2 + shift, inexact)\n}\n\n/// Round `sig * 2^exp2` (plus a sticky remainder below the last bit of `sig`)\n/// to the nearest double, reporting whether `ERANGE` would be raised.\nfn round_to_double(sig: u128, sticky: bool, exp2: i128) -> (f64, bool) {\n    let bl = (128 - sig.leading_zeros()) as i128;\n    let e_msb = exp2 + bl - 1; // exponent of the most significant bit\n    let tiny = e_msb < -1022;\n\n    if e_msb > 1024 {\n        return (f64::INFINITY, true);\n    }\n\n    // Rounding at full 53 bit precision (as if the exponent range were\n    // unbounded).\n    let (m53, e53, _) = round_keep(sig, sticky, exp2, 53);\n\n    if tiny {\n        // If rounding at full precision already reaches the smallest normal\n        // number, glibc does not consider the result tiny and raises nothing.\n        let bl53 = (128 - m53.leading_zeros()) as i12