}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":305,"cache_read_input_tokens":16557,"cache_creation":{"ephemeral_5m_input_tokens":305,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"2e4df9b8-fa03-4b6e-9f3a-a7db0bf639e5","uuid":"5a024f37-2614-4016-b855-31cd66f2614c","timestamp":"2026-08-28T16:18:22.315Z"}
