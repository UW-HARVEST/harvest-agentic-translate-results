= impls();","     let expected = impls.c.run(x);"]},{"oldStart":181,"oldLines":16,"newStart":239,"newLines":15,"lines":["         let actual = r.run(x);","         if actual != expected {","             let at = expected","+                .out","                 .iter()","-                .zip(actual.iter())","+                .zip(actual.out.iter())","                 .position(|(a, b)| a != b)","-                .unwrap_or_else(|| expected.len().min(actual.len()));","+                .unwrap_or_else(|| expected.out.len().min(actual.out.len()));","             panic!(","-                \"divergence for driver({x}) between c and {}\\n  first differing byte offset: {at}\\n  \\","-                 C   : {}\\n  RUST: {}\",","-                r.name,","-                describe(&expected),","-                describe(&actual),","+                \"divergence for driver({x}) between c and {}\\n  first differing stdout byte \\","+                 offset: {at}\\n  C   : {expected:?}\\n  RUST: {actual:?}\",","+                r.name","             );","         }","     }"]},{"oldStart":202,"oldLines":10,"newStart":259,"newLines":10,"lines":["     }"," }"," ","-/// The exact bytes the C source specifies: `x` lines of `\"%d %d\\n\"` with","-/// `i` and `j == 2*i` (wrapping like the C build does on signed overflow).","-/// Used as an independent third opinion so a test cannot pass by both","-/// implementations being broken in the same way.","+/// The exact bytes `driver.c` specifies: `x` lines of `\"%d %d\\n\"` with `i` and","+/// `j == 2*i` (wrapping on signed overflow, as the `-O0` C build does). Used as","+/// an independent oracle so a test cannot pass by both implementations being","+/// broken in the same way."," pub fn model_output(x: c_int) -> Vec<u8> {","     let mut out = Vec::new();","     let mut i: c_int = 0;"]}],"originalFile":"//! Shared harness for the C-vs-Rust differential tests.\n//!\n//! Both implementations are loaded as shared objects through `libloading` and\n//! invoked only through their exported `driver` symbol — the Rust functions are\n//! never called directly, so the `#[no_mangle] extern \"C\"` export wrapper is\n//! part of what is under test.\n//!\n//! `driver` communicates solely by writing to `stdout` via libc `printf`, so a\n//! differential comparison means capturing fd 1 around each call. Both `.so`s\n//! share the test process's libc `stdout` stream, which makes the capture\n//! symmetric: flush, redirect fd 1 to a scratch file, call, flush, restore.\n\n#![allow(dead_code)]\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_int, c_void};\nuse std::os::unix::io::AsRawFd;\nuse std::path::{Path, PathBuf};\nuse std::sync::{Mutex, MutexGuard, OnceLock};\n\nextern \"C\" {\n    static mut stdout: *mut c_void;\n    fn fflush(stream: *mut c_void) -> c_int;\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n}\n\n/// Signature of the exported entry point: `void driver(int x)`.\npub type DriverFn = unsafe extern \"C\" fn(c_int);\n\npub struct Impl {\n    pub name: &'static str,\n    pub path: PathBuf,\n    lib: Library,\n}\n\nimpl Impl {\n    fn load(name: &'static str, path: PathBuf) -> Self {\n        let lib = unsafe { Library::new(&path) }\n            .unwrap_or_else(|e| panic!(\"failed to dlopen {} ({}): {e}\", name, path.display()));\n        // Fail loudly here if the export wrapper is missing entirely.\n        unsafe {\n            let _probe: Symbol<DriverFn> = lib\n                .get(b\"driver\\0\")\n                .unwrap_or_else(|e| panic!(\"{name}: {} does not export `driver`: {e}\", path.display()));\n        }\n        Impl { name, path, lib }\n    }\n\n    pub fn driver(&self) -> Symbol<'_, DriverFn> {\n        unsafe { self.lib.get(b\"driver\\0\") }.expect(\"symbol `driver` vanished\")\n    }\n\n    /// Call `driver(x)` through the `.so` and return everything it wrote to\n    /// stdout, byte for byte.\n    pub fn run(&self, x: c_int) -> Vec<u8> {\n        let f = self.driver();\n        capture_stdout(|| unsafe { f(x) })\n    }\n}\n\npub struct Impls {\n    pub c: Impl,\n    /// One entry per Rust build profile that is present on disk (release,\n    /// debug). Both are compared because `panic`/overflow-check settings differ\n    /// between profiles.\n    pub rust: Vec<Impl>,\n}\n\nfn manifest_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    if let Some(p) = std::env::var_os(\"C_DRIVER_SO\") {\n        return PathBuf::from(p);\n    }\n    let root = manifest_dir().parent().expect(\"crate has a parent dir\").to_path_buf();\n    root.join(\"c_src/build/libdriver.so\")\n}\n\npub fn impls() -> &'static Impls {\n    static IMPLS: OnceLock<Impls> = OnceLock::new();\n    IMPLS.get_or_init(|| {\n        let c_path = c_lib_path();\n        assert!(\n            c_path.exists(),\n            \"C shared library not found at {}. Build it with:\\n  \\\n             cd c_src && mkdir -p build && cd build && \\\n             cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\",\n            c_path.display()\n        );\n\n        let mut rust = Vec::new();\n        if let Some(p) = std::env::var_os(\"RUST_DRIVER_SO\") {\n            rust.push(Impl::load(\"rust(env)\", PathBuf::from(p)));\n        } else {\n            for (name, rel) in [\n                (\"rust(release)\", \"target/release/libdriver.so\"),\n                (\"rust(debug)\", \"target/debug/libdriver.so\"),\n            ] {\n                let p = manifest_dir().join(rel);\n                if p.exists() {\n                    rust.push(Impl::load(name, p));\n                }\n            }\n        }\n        assert!(\n            !rust.is_empty(),\n            \"no Rust shared library found under {}/target/{{release,debug}}. \\\n             Build it with `cargo build --release`.\",\n            manifest_dir().display()\n        );\n\n        Impls { c: Impl::load(\"c\", c_path), rust }\n    })\n}\n\n/// fd 1 is a process-wide resource, so captures must not overlap. Tests run in\n/// parallel threads by default; this mutex serialises the redirect window.\nfn capture_lock() -> MutexGuard<'static, ()> {\n    static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n    match LOCK.get_or_init(|| Mutex::new(())).lock() {\n        Ok(g) => g,\n        // Keep going even if some other test panicked inside the window.\n        Err(poisoned) => poisoned.into_inner(),\n    }\n}\n\nfn scratch_path() -> PathBuf {\n    use std::sync::atomic::{AtomicU64, Ordering};\n    static N: AtomicU64 = AtomicU64::new(0);\n    let n = N.fetch_add(1, Ordering::Relaxed);\n    std::env::temp_dir().join(format!(\"driver_diff_{}_{}.out\", std::process::id(), n))\n}\n\n/// Run `f` with fd 1 pointed at a scratch file and return the bytes written.\npub fn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    let _guard = capture_lock();\n    let path = scratch_path();\n\n    // Flush anything the harness itself buffered so it is not attributed to the\n    // library under test.\n    unsafe { fflush(stdout) };\n\n    let saved = unsafe { dup(1) };\n    assert!(saved >= 0, \"dup(1) failed\");\n\n    let file = std::fs::File::create(&path)\n        .unwrap_or_else(|e| panic!(\"cannot create scratch file {}: {e}\", path.display()));\n    assert!(unsafe { dup2(file.as_raw_fd(), 1) } >= 0, \"dup2 onto fd 1 failed\");\n\n    f();\n\n    // The library leaves its output in libc's stdout buffer; force it out\n    // before restoring the descriptor.\n    unsafe { fflush(stdout) };\n    assert!(unsafe { dup2(saved, 1) } >= 0, \"restoring fd 1 failed\");\n    unsafe { close(saved) };\n    drop(file);\n\n    let out = std::fs::read(&path)\n        .unwrap_or_else(|e| panic!(\"cannot read scratch file {}: {e}\", path.display()));\n    let _ = std::fs::remove_file(&path);\n    out\n}\n\nfn describe(bytes: &[u8]) -> String {\n    let text = String::from_utf8_lossy(bytes);\n    let shown: String = text.chars().take(300).collect();\n    format!(\"{} bytes, {} lines, starts: {:?}\", bytes.len(), text.lines().count(), shown)\n}\n\n/// Assert every Rust `.so` produces byte-identical stdout to the C `.so` for\n/// `driver(x)`.\npub fn assert_same(x: c_int) {\n    let impls = impls();\n    let expected = impls.c.run(x);\n    for r in &impls.rust {\n        let actual = r.run(x);\n        if actual != expected {\n            let at = expected\n                .iter()\n                .zip(actual.iter())\n                .position(|(a, b)| a != b)\n                .unwrap_or_else(|| expected.len().min(actual.len()));\n            panic!(\n                \"divergence for driver({x}) between c and {}\\n  first differing byte offset: {at}\\n  \\\n                 C   : {}\\n  RUST: {}\",\n                r.name,\n                describe(&expected),\n                describe(&actual),\n            );\n        }\n    }\n}\n\npub fn assert_same_all<I: IntoIterator<Item = c_int>>(xs: I) {\n    for x in xs {\n        assert_same(x);\n    }\n}\n\n/// The exact bytes the C source specifies: `x` lines of `\"%d %d\\n\"` with\n/// `i` and `j == 2*i` (wrapping like the C build does on signed overflow).\n/// Used as an independent third opinion so a test cannot pass by both\n/// implementations being broken in the same way.\npub fn model_output(x: c_int) -> Vec<u8> {\n    let mut out = Vec::new();\n    let mut i: c_int = 0;\n    let mut j: c_int = 0;\n    while i < x {\n        out.extend_from_slice(format!(\"{i} {j}\\n\").as_bytes());\n        i = i.wrapping_add(1);\n        j = j.wrapping_add(2);\n    }\n    out\n}\n\n/// Deterministic PRNG (SplitMix64) so randomised rows are reproducible.\npub struct Rng(u64);\n\nimpl Rng {\n    pub fn new(seed: u64) -> Self {\n        Rng(seed)\n    }\n    pub fn next_u64(&mut self) -> u64 {\n        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n        let mut z = self.0;\n        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n        z ^ (z >> 31)\n    }\n    /// Uniform in `lo..=hi`.\n    pub fn range_i32(&mut self, lo: i32, hi: i32) -> i32 {\n        debug_assert!(lo <= hi);\n        let span = (hi as i64 - lo as i64 + 1) as u64;\n        (lo as i64 + (self.next_u64() % span) as i64) as i32\n    }\n}\n","userModified":false}}
