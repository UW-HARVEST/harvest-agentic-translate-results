mestamp":"2026-08-28T12:27:21.947Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-YWB88y/translation/tests/common/mod.rs","content":"// ---------------------------------------------------------------------------\n// libc bits we need (declared directly so no extra dependency is required)\n// ---------------------------------------------------------------------------\n\nextern \"C\" {\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    fn fflush(stream: *mut c_void) -> c_int;\n    fn setvbuf(stream: *mut c_void, buf: *mut c_char, mode: c_int, size: usize) -> c_int;\n    static mut stdout: *mut c_void;\n}\n\n/// Read glibc's `stdout` `FILE*` without forming a reference to a `static mut`.\nunsafe fn c_stdout() -> *mut c_void {\n    std::ptr::read(std::ptr::addr_of!(stdout))\n}\n\npub const IOFBF: c_int = 0; // fully buffered\npub const IOLBF: c_int = 1; // line buffered\npub const IONBF: c_int = 2; // unbuffered\n\n/// Buffering mode applied to the shared libc `stdout` for a capture.\n#[derive(Copy, Clone, Debug, PartialEq, Eq)]\npub enum Buffering {\n    /// `A_pipe` — leave the stream alone (fully buffered onto a regular file).\n    Default,\n    /// `A_unbuf` — `setvbuf(stdout, NULL, _IONBF, 0)`.\n    Unbuffered,\n    /// `A_line` — `setvbuf(stdout, NULL, _IOLBF, 1024)`.\n    LineBuffered,\n    /// explicit `_IOFBF` with a 4 KiB buffer.\n    FullyBuffered,\n}\n\n// ---------------------------------------------------------------------------\n// Loading the two shared objects\n// ---------------------------------------------------------------------------\n\n/// Raw C-ABI entry points of one shared object.","numLines":40,"startLine":18,"totalLines":375}}}
