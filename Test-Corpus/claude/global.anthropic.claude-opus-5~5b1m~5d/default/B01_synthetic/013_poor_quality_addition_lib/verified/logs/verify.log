shed to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include \"driver.h\"\n    25\t\n    26\t#include <stdio.h>\n    27\t#include <stdlib.h>\n    28\t\n    29\tvoid printLine (const char * line)\n    30\t{\n    31\t    if(line != NULL) \n    32\t    {\n    33\t        printf(\"%s\\n\", line);\n    34\t    }\n    35\t}\n    36\t\n    37\tvoid printIntLine (int intNumber)\n    38\t{\n    39\t    printf(\"%d\\n\", intNumber);\n    40\t}\n    41\t\n    42\tvoid bad()\n    43\t{\n    44\t    int intOne = 1, intTwo = 1, intSum = 0;\n    45\t    printIntLine(intSum);\n    46\t    intOne + intTwo;\n    47\t    printIntLine(intSum);\n    48\t}\n    49\t\n    50\tvoid good()\n    51\t{\n    52\t    int intOne = 1, intTwo = 1, intSum = 0;\n    53\t    printIntLine(intSum);\n    54\t    intSum = intOne + intTwo;\n    55\t    printIntLine(intSum);\n    56\t}\n    57\t\n    58\tvoid driver()\n    59\t{\n    60\t    printLine(\"Calling good()...\");\n    61\t    good();\n    62\t    printLine(\"Finished good()\");\n    63\t    printLine(\"Calling bad()...\");\n    64\t    bad();\n    65\t    printLine(\"Finished bad()\");\n    66\t}\n=============== translation/Cargo.toml ===============\n     1\t[package]\n     2\tname = \"driver\"\n     3\tversion = \"0.1.0\"\n     4\tedition = \"2021\"\n     5\t\n     6\t[lib]\n     7\tname = \"driver\"\n     8\tpath = \"src/lib.rs\"\n     9\tcrate-type = [\"cdylib\"]\n    10\t\n    11\t[profile.release]\n    12\tpanic = \"abort\"\n    13\t\n    14\t[workspace]\n=============== translation/src/lib.rs ===============\n     1\t// Rust translation of c_src/src/driver.c (MIT Lincoln Laboratory, 2025).\n     2\t//\n     3\t// The original C library is built as a shared object exporting the symbols\n     4\t// `printLine`, `printIntLine`, `bad`, `good` and `driver`.  All of them are\n     5\t// re-exported here with identical signatures and identical observable output.\n     6\t//\n     7\t// Output is produced through the platform C `printf` so that the stdio stream,\n     8\t// its buffering mode and the resulting byte stream are exactly the same as for\n     9\t// the original library.\n    10\t\n    11\t#![allow(non_snake_case)]\n    12\t\n    13\tuse std::ffi::{c_char, c_int};\n    14\t\n    15\textern \"C\" {\n    16\t    fn printf(fmt: *const c_char, ...) -> c_int;\n    17\t}\n    18\t\n    19\t/// Format string `\"%s\\n\"` (NUL terminated), as used by the C source.\n    20\tconst FMT_STR: &[u8] = b\"%s\\n\\0\";\n    21\t/// Format string `\"%d\\n\"` (NUL terminated), as used by the C source.\n    22\tconst FMT_INT: &[u8] = b\"%d\\n\\0\";\n    23\t\n    24\t/// `void printLine(const char * line)`\n    25\t#[unsafe(no_mangle)]\n    26\tpub unsafe extern \"C\" fn printLine(line: *const c_char) {\n    27\t    if !line.is_null() {\n    28\t        printf(FMT_STR.as_ptr() as *const c_char, line);\n    29\t    }\n    30\t}\n    31\t\n    32\t/// `void printIntLine(int intNumber)`\n    33\t#[unsafe(no_mangle)]\n    34\tpub unsafe extern \"C\" fn printIntLine(intNumber: c_int) {\n    35\t    printf(FMT_INT.as_ptr() as *const c_char, intNumber);\n    36\t}\n    37\t\n    38\t/// `void bad(void)`\n    39\t///\n    40\t/// Faithfully reproduces the original CWE-482-style defect: the result of\n    41\t/// `intOne + intTwo` is computed and thrown away, so `intSum` stays 0 and the\n    42\t/// same value is printed twice.\n    43\t#[unsafe(no_mangle)]\n    44\tpub unsafe extern \"C\" fn bad() {\n    45\t    let int_one: c_int = 1;\n    46\t    let int_two: c_int = 1;\n    47\t    let int_sum: c_int = 0;\n    48\t    printIntLine(int_sum);\n    49\t    let _ = int_one.wrapping_add(int_two); // result intentionally discarded\n    50\t    printIntLine(int_sum);\n    51\t}\n    52\t\n    53\t/// `void good(void)`\n    54\t#[unsafe(no_mangle)]\n    55\tpub unsafe extern \"C\" fn good() {\n    56\t    let int_one: c_int = 1;\n    57\t    let int_two: c_int = 1;\n    58\t    let mut int_sum: c_int = 0;\n    59\t    printIntLine(int_sum);\n    60\t    int_sum = int_one.wrapping_add(int_two);\n    61\t    printIntLine(int_sum);\n    62\t}\n    63\t\n    64\t/// `void driver(void)`\n    65\t#[unsafe(no_mangle)]\n    66\tpub unsafe extern \"C\" fn driver() {\n    67\t    printLine(b\"Calling good()...\\0\".as_ptr() as *const c_char);\n    68\t    good();\n    69\t    printLine(b\"Finished good()\\0\".as_ptr() as *const c_char);\n    70\t    printLine(b\"Calling bad()...\\0\".as_ptr() as *const c_char);\n    71\t    bad();\n    72\t    printLine(b\"Finished bad()\\0\".as_ptr() as *const c_char);\n    73\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"ef1b08c7-50c6-4c7e-afda-148fc2328227","uuid":"8bd205f4-94cb-41a0-8c32-02e9ffb46289","timestamp":"2026-08-28T12:15:42.398Z","tool_use_result":{"stdout":"=============== c_src/CMakeLists.txt ===============\n     1\t# Copyright 2025 MIT Lincoln Laboratory\n     2\t# Permission is hereby granted, free of charge,\n     3\t# to any person obtaining a copy of this software\n     4\t# and associated documentation files (the “Software”),\n     5\t# to deal in the Software without restriction,\n     6\t# including without limitation the rights to use, copy,\n     7\t# modify, merge, pub