eeds from clean with no warnings.","ttft_ms":3117,"ttft_stream_ms":2988,"time_to_request_ms":52,"type":"result","duration_ms":174348,"uuid":"94122168-95ca-4429-97e1-765b55bce01d","queued_turn_count":0}
