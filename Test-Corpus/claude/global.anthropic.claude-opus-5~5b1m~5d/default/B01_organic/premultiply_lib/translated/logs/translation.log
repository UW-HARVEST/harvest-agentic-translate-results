ng)w*h; if (np < 0) np = 0;\n        long alloc = (np?np:1)*4;\n        uint8_t *a = calloc(1, alloc), *b = calloc(1, alloc);\n        for (long i=0;i<alloc;i++) a[i] = (uint8_t)rnd();\n        memcpy(b,a,alloc);\n        img_t ia={w,h,a}, ib={w,h,b};\n        fc(&ia); fr(&ib);\n        cases++;\n        if (memcmp(a,b,alloc)) { printf(\"MISMATCH w=%d h=%d\\n\",w,h); fails++; }\n        free(a); free(b);\n    }\n\n    /* many random buffers */\n    for (int t=0;t<2000;t++){\n        int w = 1 + (rnd()%37), h = 1 + (rnd()%37);\n        long alloc = (long)w*h*4;\n        uint8_t *a = malloc(alloc), *b = malloc(alloc);\n        for (long i=0;i<alloc;i++) a[i]=(uint8_t)rnd();\n        memcpy(b,a,alloc);\n        img_t ia={w,h,a}, ib={w,h,b};\n        fc(&ia); fr(&ib);\n        cases++;\n        if (memcmp(a,b,alloc)) { printf(\"MISMATCH random t=%d w=%d h=%d\\n\",t,w,h); fails++; }\n        free(a); free(b);\n    }\n\n    printf(\"cases=%d fails=%d\\n\", cases, fails);\n    return fails != 0;\n}\nEOF\ngcc -O2 $TMPDIR/cbuild/harness.c -o $TMPDIR/cbuild/harness -ldl && $TMPDIR/cbuild/harness $TMPDIR/cbuild/libc_src.so $PWD/target/release/libc_src.so","description":"Differential test C vs Rust implementations"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":795,"cache_read_input_tokens":19553,"cache_creation":{"ephemeral_5m_input_tokens":795,"ephemeral_1h_input_tokens":0},"output_tokens":16,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d829b3a7-72ec-4b6f-a449-722bbb1887b9","uuid":"e836b13c-b047-443c-accc-19b9d246c454","timestamp":"2026-08-27T00:23:48.090Z"}
