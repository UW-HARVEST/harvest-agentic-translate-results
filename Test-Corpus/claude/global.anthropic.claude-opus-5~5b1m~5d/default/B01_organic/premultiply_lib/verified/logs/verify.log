rsion that truncates toward zero.\n49\t#[unsafe(no_mangle)]\n50\tpub unsafe extern \"C\" fn premultiply(img: *mut cp_image_t) {\n51\t    let img = &mut *img;\n52\t    let w: c_int = img.w;\n53\t    let h: c_int = img.h;\n54\t    // int stride = w * sizeof(cp_pixel_t);\n55\t    let stride: c_int = w.wrapping_mul(PIXEL_SIZE as c_int);\n56\t    let data: *mut u8 = img.pix as *mut u8;\n57\t\n58\t    // for (int i = 0; i < (int)stride * h; i += sizeof(cp_pixel_t))\n59\t    let limit: c_int = stride.wrapping_mul(h);\n60\t    let mut i: c_int = 0;\n61\t    while i < limit {\n62\t        let base = data.offset(i as isize);\n63\t\n64\t        let a = f32::from(*base.add(3)) / 255.0f32;\n65\t        let mut r = f32::from(*base.add(0)) / 255.0f32;\n66\t        let mut g = f32::from(*base.add(1)) / 255.0f32;\n67\t        let mut b = f32::from(*base.add(2)) / 255.0f32;\n68\t\n69\t        r *= a;\n70\t        g *= a;\n71\t        b *= a;\n72\t\n73\t        *base.add(0) = c_float_to_u8(r * 255.0f32);\n74\t        *base.add(1) = c_float_to_u8(g * 255.0f32);\n75\t        *base.add(2) = c_float_to_u8(b * 255.0f32);\n76\t\n77\t        i = i.wrapping_add(PIXEL_SIZE as c_int);\n78\t    }\n79\t}\n80\t\n81\t/// C semantics for `(uint8_t)some_float`: truncate toward zero, then take the\n82\t/// value modulo 2^8. All values produced by `premultiply` are in `[0, 255]`, so\n83\t/// the wrapping path is never exercised, but it is spelled out to keep the\n84\t/// conversion faithful instead of relying on Rust's saturating `as` cast.\n85\t#[inline]\n86\tfn c_float_to_u8(v: f32) -> u8 {\n87\t    let t = v.trunc();\n88\t    if t >= 0.0 && t <= 255.0 {\n89\t        t as u8\n90\t    } else if t.is_finite() {\n91\t        // Emulate the usual two's-complement wrap of the underlying hardware.\n92\t        (t as i64 as u64 & 0xff) as u8\n93\t    } else {\n94\t        0\n95\t    }\n96\t}\n97\t"}]},"parent_tool_use_id":null,"session_id":"ba7d4a19-515a-4630-9d64-3f51b4797b61","uuid":"e3d2e91f-1110-40da-bb