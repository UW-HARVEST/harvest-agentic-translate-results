34].into_iter().collect::<std::collections::BTreeSet<i32>>()\n    );\n}\n","structuredPatch":[{"oldStart":201,"oldLines":7,"newStart":201,"newLines":8,"lines":["         let alloc = num_elem + rng.range(1, 5);","         let mut dst = make_dst(&mut rng, alloc, num_elem, Some(0));","         dst[0] = 0;","-        let src = make_src(&mut rng, num_elem * rng.range(2, 6) + rng.below(9));","+        let l = num_elem * rng.range(2, 6) + rng.below(9);","+        let src = make_src(&mut rng, l);","         let out = check_vs_model(&Case::new(\"cfg07\", dst.clone(), num_elem, Src::Buf(src)));","         assert_eq!(out.ret, 34);","         assert_eq!(&out.dst.unwrap()[num_elem..], &dst[num_elem..]);"]}],"userModified":false,"replaceAll":false}}
