3\\n}/'\n\nrun_mutation \"numElem==0 also zeroes dst[0] (wrong: C leaves dst untouched)\" \\\n    m 's/if dst\\.is_null\\(\\) \\|\\| num_elem == 0 \\{\\n        return 22;/if dst.is_null() || num_elem == 0 {\\n        if !dst.is_null() { unsafe { *dst = 0 }; }\\n        return 22;/'\n\nrun_mutation \"check !src BEFORE numElem==0 (wrong short-circuit order)\" \\\n    m 's/if dst\\.is_null\\(\\) \\|\\| num_elem == 0 \\{\\n        return 22;\\n    \\}\\n\\n    \\/\\/ if \\(!src\\) \\{ dst\\[0\\] = 0; return 22; \\}\\n    if src\\.is_null\\(\\) \\{\\n        unsafe \\{ \\*dst = 0 \\};\\n        return 22;\\n    \\}/if dst.is_null() {\\n        return 22;\\n    }\\n    if src.is_null() {\\n        unsafe { *dst = 0 };\\n        return 22;\\n    }\\n    if num_elem == 0 {\\n        return 22;\\n    }/'\n\nrun_mutation \"bounds ptr < end -> ptr <= end in the copy loop\" \\\n    m 's/    while ptr < end \\{\\n        let c/    while ptr <= end {\\n        let c/'\n\nrun_mutation \"bounds ptr < end -> ptr <= end in the scan loop\" \\\n    m 's/while ptr < end && unsafe \\{ \\*ptr \\} != 0/while ptr <= end \\&\\& unsafe { *ptr } != 0/'\n\nrun_mutation \"NUL-terminate on truncation at dst[numElem-1] instead of dst[0]\" \\\n    m 's/    \\/\\/ dst\\[0\\] = 0; return 34;\\n    unsafe \\{ \\*dst = 0 \\};\\n    34/    unsafe { *dst.wrapping_add(num_elem - 1) = 0 };\\n    34/'\n\nrun_mutation \"no write at all on truncation (drop the dst[0]=0)\" \\\n    m 's/    \\/\\/ dst\\[0\\] = 0; return 34;\\n    unsafe \\{ \\*dst = 0 \\};\\n    34/    34/'\n\nrun_mutation \"saturating instead of wrapping dst+numElem (misses the overflow case)\" \\\n    m 's/dst\\.wrapping_add\\(num_elem\\)/((dst as usize).saturating_add(num_elem.saturating_mul(4))) as *mut wchar_t/'\n\nrun_mutation \"off-by-one: end = dst + numElem - 1\" \\\n    m 's/let end: \\*mut wchar_t = dst\\.wrapping_add\\(num_elem\\);/let end: *mut wchar_t = dst.wrapping_add(num_elem).wrapping_sub(1);/'\n\nrun_mutation \"src advanced but terminator not copied (skip writing the NUL)\" \\\n    m 's/        unsafe \\{ \\*ptr = c \\};\\n        ptr = ptr\\.wrapping_add\\(1\\);\\n        if c == 0 \\{\\n            return 0;\\n        \\}/        if c == 0 {\\n            return 0;\\n        }\\n        unsafe { *ptr = c };\\n        ptr = ptr.wrapping_add(1);/'\n\nrun_mutation \"treat wchar_t as u32 AND stop the scan on negative values\" \\\n    m 's/while ptr < end && unsafe \\{ \\*ptr \\} != 0/while ptr < end \\&\\& unsafe { *ptr } > 0/'\n\nrestore\necho \"=== done: $FAILS mutation(s) escaped detection ===\"\nexit $FAILS\n","userModified":false}}
