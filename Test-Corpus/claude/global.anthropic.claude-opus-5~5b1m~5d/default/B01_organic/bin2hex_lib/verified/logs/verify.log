eration is carried out modulo\n45\t/// 2^32 in `unsigned int`. For `n < 10` the subtraction wraps around, the\n46\t/// right shift leaves `0x00ffffff`, and masking with `~38U` (`0xffffffd9`)\n47\t/// yields `0x00ffffd9`, so that `87 + n + 0x00ffffd9` truncates (via the\n48\t/// `(unsigned char)` cast) to `'0' + n`. For `10 <= n <= 15` the correction\n49\t/// term is zero and the result is `87 + n`, i.e. `'a' + n - 10`.\n50\t#[inline]\n51\tfn nibble_to_hex(n: c_int) -> c_uchar {\n52\t    let n = n as c_uint;\n53\t    let corrected = (87u32)\n54\t        .wrapping_add(n)\n55\t        .wrapping_add((n.wrapping_sub(10u32) >> 8) & !38u32);\n56\t    // The `(unsigned char)` cast keeps only the low 8 bits.\n57\t    corrected as c_uchar\n58\t}\n59\t\n60\t/// Byte-for-byte translation of `bin2hex` from `c_src/src/lib.c`.\n61\t///\n62\t/// # Safety\n63\t///\n64\t/// Same contract as the C function: `bin` must point to at least `bin_len`\n65\t/// readable bytes and `hex` must point to at least `bin_len * 2 + 1` writable\n66\t/// bytes (which the `hex_maxlen` check partially enforces, aborting otherwise).\n67\t#[unsafe(no_mangle)]\n68\tpub unsafe extern \"C\" fn bin2hex(\n69\t    hex: *mut c_char,\n70\t    hex_maxlen: usize,\n71\t    bin: *const u8,\n72\t    bin_len: usize,\n73\t) -> *mut c_char {\n74\t    // C: size_t i = (size_t)0U; unsigned int x; int b; int c;\n75\t    let mut i: usize = 0usize;\n76\t\n77\t    // if (bin_len >= (18446744073709551615UL) / 2 || hex_maxlen <= bin_len * 2U) {\n78\t    //     abort();\n79\t    // }\n80\t    //\n81\t    // Note the order of the checks and the short-circuiting `||`: the first\n82\t    // check guarantees that `bin_len * 2` cannot overflow. `bin_len * 2U`\n83\t    // promotes `2U` to `size_t`, so the product is computed in `size_t`.\n84\t    if bin_len >= C_SIZE_MAX / 2 || hex_maxlen <= bin_len.wrapping_mul(2usize) {\n85\t        unsafe { abort() };\n86\t    }\n87\t\n88\t    while i < bin_len {\n89\t        // c = bin[i] & 0xf;  b 