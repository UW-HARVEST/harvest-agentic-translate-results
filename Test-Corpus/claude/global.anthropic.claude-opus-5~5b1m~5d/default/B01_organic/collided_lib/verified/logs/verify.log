","+  [ ${caught_all} -eq 1 ] && echo \"caught: ${name}  (by: ${want})\""," done"," "," rm -rf \"${work}\""]}],"originalFile":"#!/usr/bin/env bash\n# Test-power check: deliberately break the Rust translation in ways that mimic\n# realistic mis-translations, point the harness at the broken .so via RUST_SO,\n# and assert that the suite FAILS. A differential suite that cannot fail proves\n# nothing, so every mutant listed here must be caught.\n#\n# Nothing in src/ or c_src/ is modified: each mutant is built from a copy.\nset -uo pipefail\ncd \"$(dirname \"$0\")\"\n\nwork=\"target/mutants\"\nrm -rf \"${work}\"; mkdir -p \"${work}/src\"\ncat > \"${work}/Cargo.toml\" <<'EOF'\n[package]\nname = \"mutant\"\nversion = \"0.1.0\"\nedition = \"2021\"\n[lib]\nname = \"collided_lib\"\npath = \"src/lib.rs\"\ncrate-type = [\"cdylib\"]\n[profile.release]\nopt-level = 3\n[workspace]\nEOF\n\n# name | sed program | tests that must fail\nmutants=(\n  \"touching_boundary|s/(d2 < r2) as c_int/(d2 <= r2) as c_int/|row14 row20 row13\"\n  \"nan_suppressing_min_max|s/if a.x > b.x { a.x } else { b.x }/a.x.max(b.x)/;s/if a.y > b.y { a.y } else { b.y }/a.y.max(b.y)/|row03\"\n  \"dot_operand_order|s/mulss(b.y, a.y)/mulss(a.y, b.y)/|row12\"\n  \"no_argument_swap|s/c2CircletoAABB(unsafe { read_circle(B) }, unsafe {\\\\n                read_aabb(A)/c2CircletoAABB(unsafe { read_circle(A) }, unsafe {\\\\n                read_aabb(B)/|row29\"\n  \"lenient_enum|s/^        _ => 0,$/        _ => c2AABBtoAABB(unsafe { read_aabb(A) }, unsafe { read_aabb(B) }),/|row01 row04\"\n  \"strict_separating_axis|s/(B.max.x < A.min.x) as c_int/(B.max.x <= A.min.x) as c_int/|row24 row25\"\n  \"sub_operand_order|s/a.x -= b.x;/a.x = b.x - a.x;/|row09 row10\"\n)\n\nstatus=0\nfor m in \"${mutants[@]}\"; do\n  name=${m%%|*}; rest=${m#*|}; prog=${rest%%|*}; want=${rest#*|}\n  perl -0pe \"${prog}\" src/lib.rs > \"${work}/src/lib.rs\"\n  if cmp -s src/lib.rs \"${work}/src/lib.rs\"; then\n    echo \"SKIP ${name}: mutation did not change the source (pattern out of date)\"\n    status=1; continue\n  fi\n  if ! (cd \"${work}\" && timeout 600 cargo build --release --target-dir build >/dev/null 2>&1); then\n    echo \"SKIP ${name}: mutant did not compile\"\n    status=1; continue\n  fi\n  so=\"${PWD}/${work}/build/release/libcollided_lib.so\"\n  caught_all=1\n  for t in ${want}; do\n    if RUST_SO=\"${so}\" timeout 600 cargo test --release --test phase_b_valid --test phase_c_errors \"${t}\" 2>&1 \\\n        | grep -qE \"^test result: FAILED\"; then\n      :\n    else\n      echo \"NOT CAUGHT: mutant '${name}' survives test '${t}'\"\n      caught_all=0; status=1\n    fi\n  done\n  [ ${caught_all} -eq 1 ] && echo \"caught: ${name} (by: ${want})\"\ndone\n\nrm -rf \"${work}\"\necho\nif [ ${status} -eq 0 ]; then echo \"ALL MUTANTS CAUGHT — the suite has real discriminating power\"; else echo \"SOME MUTANTS SURVIVED\"; fi\nexit ${status}\n","userModified":false}}
