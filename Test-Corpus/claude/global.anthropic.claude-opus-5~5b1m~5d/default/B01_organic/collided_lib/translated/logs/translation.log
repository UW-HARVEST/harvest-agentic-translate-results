  // +1, -1\n    0x7f7fffffu,                          // FLT_MAX\n};\n#define NP ((int)(sizeof(pool)/sizeof(pool[0])))\nstatic float ff(uint32_t u) { float f; memcpy(&f, &u, 4); return f; }\n\nint main(int argc, char **argv) {\n    if (argc != 4) { fprintf(stderr, \"usage: %s O0.so O2.so rust.so\\n\", argv[0]); return 2; }\n    fn_dot d0 = load(argv[1]), d2 = load(argv[2]), dr = load(argv[3]);\n\n    long n = 0, rust_vs_O0 = 0, rust_vs_O2 = 0, O0_vs_O2 = 0, unexplained = 0;\n    // full 4-D cross product over the pool: 15^4 = 50625 combinations\n    for (int i = 0; i < NP; i++)\n    for (int j = 0; j < NP; j++)\n    for (int k = 0; k < NP; k++)\n    for (int l = 0; l < NP; l++) {\n        c2v a = { ff(pool[i]), ff(pool[j]) };\n        c2v b = { ff(pool[k]), ff(pool[l]) };\n        uint32_t r0 = fb(d0(a, b)), r2 = fb(d2(a, b)), rr = fb(dr(a, b));\n        n++;\n        if (rr != r0) rust_vs_O0++;\n        if (rr != r2) rust_vs_O2++;\n        if (r0 != r2) O0_vs_O2++;\n        // a Rust-vs-O2 difference is only acceptable where C itself is unstable\n        if (rr != r2 && r0 == r2) {\n            if (unexplained++ < 10)\n                printf(\"UNEXPLAINED a=(%08x,%08x) b=(%08x,%08x) O0=%08x O2=%08x RS=%08x\\n\",\n                       pool[i], pool[j], pool[k], pool[l], r0, r2, rr);\n        }\n    }\n    printf(\"cases=%ld\\n\", n);\n    printf(\"  Rust != C(-O0) : %ld   <-- must be 0\\n\", rust_vs_O0);\n    printf(\"  C(-O0) != C(-O2): %ld   <-- inherent C ambiguity (unspecified NaN payload)\\n\", O0_vs_O2);\n    printf(\"  Rust != C(-O2) : %ld\\n\", rust_vs_O2);\n    printf(\"  unexplained    : %ld   <-- must be 0\\n\", unexplained);\n    return (rust_vs_O0 == 0 && unexplained == 0) ? 0 : 1;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
