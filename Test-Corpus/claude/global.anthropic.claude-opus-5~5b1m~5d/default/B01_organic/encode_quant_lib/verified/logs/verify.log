{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_7jbw4xaq4phuzvpmdsrthmr2zyk4i5ts4bdm7ljzlf4ugsl7cxiq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01J36kA69md2ST9n5WRYZMnS","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-jLNDdo/translation/tests/valid_paths.rs","content":"//! Phase B — valid-path differential tests, one test per CONFIGS.md row.\n//!\n//! Every test calls BOTH the C `.so` and the Rust `.so` through `libloading`\n//! and asserts the returned `int` matches byte-for-byte. Each row is driven\n//! with many randomized inputs from a fixed-seed PRNG.\n\nmod common;\nuse common::{check, Rng, LSBIT_MODES};\n\n/// Number of randomized cases per row.\nconst N: usize = 4000;\n\n/// Build a `uni` whose low 3 bits equal `low`, with randomized upper bits.\nfn uni_with_low3(rng: &mut Rng, low: i32) -> i32 {\n    let upper = rng.range_i32(-1 << 20, 1 << 20) & !7;\n    upper | (low & 7)\n}\n\n/// Build a `uni` with a chosen `uni & 7` and a chosen `uni & 8`.\nfn uni_with_low4(rng: &mut Rng, low3: i32, bit3_set: bool) -> i32 {\n    let upper = rng.range_i32(-1 << 20, 1 << 20) & !15;\n    let mut v = upper | (low3 & 7);\n    if bit3_set {\n        v |= 8;\n    }\n    v\n}\n\nfn typical_step(rng: &mut Rng) -> i32 {\n    rng.range_i32(-100_000, 100_000)\n}\n\nfn typical_target(rng: &mut Rng) -> i32 {\n    rng.range_i32(-1_000_000, 1_000_000)\n}\n\n// ---------------------------------------------------------------- row 1\n\n#[test]\nfn row01_baseline_lsbit0_mid_positive() {\n    let mut rng = Rng::new(0x0101);\n    for _ in 0..N {\n        let uni = uni_with_low4(&mut rng, rng.range_i32(1, 6), false);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            0,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 2\n\n#[test]\nfn row02_lsbit0_low3_zero_clamps_uni2() {\n    let mut rng = Rng::new(0x0202);\n    for _ in 0..N {\n        let uni = uni_with_low3(&mut rng, 0);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            0,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 3\n\n#[test]\nfn row03_lsbit0_low3_seven_clamps_uni1() {\n    let mut rng = Rng::new(0x0303);\n    for _ in 0..N {\n        let uni = uni_with_low3(&mut rng, 7);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            0,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 4\n\n#[test]\nfn row04_lsbit0_bit3_set_negates_diff() {\n    let mut rng = Rng::new(0x0404);\n    for _ in 0..N {\n        let uni = uni_with_low4(&mut rng, rng.range_i32(1, 6), true);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            0,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 5\n\n#[test]\nfn row05_low3_seven_and_bit3_set() {\n    let mut rng = Rng::new(0x0505);\n    for _ in 0..N {\n        let uni = uni_with_low4(&mut rng, 7, true);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            0,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 6\n\n#[test]\nfn row06_low3_zero_and_bit3_set() {\n    let mut rng = Rng::new(0x0606);\n    for _ in 0..N {\n        let uni = uni_with_low4(&mut rng, 0, true);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            0,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 7\n\n#[test]\nfn row07_mixed_sign_pattern_across_candidates() {\n    // uni&7 == 7 with bit3 clear => uni1 = uni+1 flips bit 3 *before* clamping\n    // is considered; uni&7 == 0 with bit3 set => uni2 = uni-1 flips bit 3.\n    // Sweep every low-4-bit pattern so all sign combinations occur.\n    let mut rng = Rng::new(0x0707);\n    for low4 in 0..16i32 {\n        for _ in 0..(N / 16).max(64) {\n            let upper = rng.range_i32(-1 << 20, 1 << 20) & !15;\n            let uni = upper | low4;\n            check(\n                uni,\n                typical_step(&mut rng),\n                typical_target(&mut rng),\n                typical_target(&mut rng),\n                typical_target(&mut rng),\n                0,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 8\n\n#[test]\nfn row08_lsbit_odd_forces_bit0_set() {\n    let mut rng = Rng::new(0x0808);\n    let odds = [1i32, 3, 5, 7, 9, 11, -1, -3, -5, -7];\n    for _ in 0..N {\n        let lsbit = rng.pick(&odds);\n        let uni = uni_with_low4(&mut rng, rng.range_i32(1, 6), rng.below(2) == 1);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 9\n\n#[test]\nfn row09_lsbit_odd_at_group_boundaries() {\n    let mut rng = Rng::new(0x0909);\n    let odds = [1i32, 3, 5, 7, 9, -1, -3, i32::MAX];\n    for _ in 0..N {\n        let lsbit = rng.pick(&odds);\n        let low3 = if rng.below(2) == 0 { 0 } else { 7 };\n        let uni = uni_with_low4(&mut rng, low3, rng.below(2) == 1);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 10\n\n#[test]\nfn row10_lsbit_even_nonzero_forces_bit0_clear() {\n    let mut rng = Rng::new(0x0a0a);\n    let evens = [2i32, 6, 8, 10, 12, -2, -4, -6];\n    for _ in 0..N {\n        let lsbit = rng.pick(&evens);\n        let uni = uni_with_low4(&mut rng, rng.range_i32(1, 6), rng.below(2) == 1);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 11\n\n#[test]\nfn row11_lsbit_even_at_group_boundaries() {\n    let mut rng = Rng::new(0x0b0b);\n    let evens = [2i32, 6, 8, 10, -2, -4, i32::MIN];\n    for _ in 0..N {\n        let lsbit = rng.pick(&evens);\n        let low3 = if rng.below(2) == 0 { 0 } else { 7 };\n        let uni = uni_with_low4(&mut rng, low3, rng.below(2) == 1);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 12\n\n#[test]\nfn row12_lsbit4_dither_positive_uni() {\n    let mut rng = Rng::new(0x0c0c);\n    for _ in 0..N {\n        let uni = rng.range_i32(0, 1 << 20);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            4,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 13\n\n#[test]\nfn row13_lsbit4_dither_negative_uni_arithmetic_shift() {\n    let mut rng = Rng::new(0x0d0d);\n    for _ in 0..N {\n        let uni = rng.range_i32(-(1 << 20), -1);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            4,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 14\n\n#[test]\nfn row14_lsbit4_at_group_boundaries() {\n    let mut rng = Rng::new(0x0e0e);\n    for _ in 0..N {\n        let low3 = if rng.below(2) == 0 { 0 } else { 7 };\n        let uni = uni_with_low4(&mut rng, low3, rng.below(2) == 1);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            4,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 15\n\n#[test]\nfn row15_lsbit4_exhaustive_low_bits() {\n    // Every bit pattern of (uni>>1)&(uni>>2)&1 over a full 0..=63 window,\n    // plus the negative mirror, with randomized step/targets.\n    let mut rng = Rng::new(0x0f0f);\n    for uni in -64..=64i32 {\n        for _ in 0..64 {\n            check(\n                uni,\n                typical_step(&mut rng),\n                typical_target(&mut rng),\n                typical_target(&mut rng),\n                typical_target(&mut rng),\n                4,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 16\n\n#[test]\nfn row16_step_zero_all_ties() {\n    let mut rng = Rng::new(0x1010);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        check(\n            rng.interesting_i32(),\n            0,\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 17\n\n#[test]\nfn row17_step_small_truncates_to_zero() {\n    let mut rng = Rng::new(0x1111);\n    for _ in 0..N {\n        let step = rng.range_i32(1, 7);\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let uni = uni_with_low4(&mut rng, rng.range_i32(0, 7), rng.below(2) == 1);\n        check(\n            uni,\n            step,\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 18\n\n#[test]\nfn row18_step_negative_division_truncates_toward_zero() {\n    let mut rng = Rng::new(0x1212);\n    for _ in 0..N {\n        let step = -rng.range_i32(1, 1_000_000);\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let uni = uni_with_low4(&mut rng, rng.range_i32(0, 7), rng.below(2) == 1);\n        check(\n            uni,\n            step,\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 19\n\n#[test]\nfn row19_step_int_max_multiplication_overflow() {\n    let mut rng = Rng::new(0x1313);\n    for lsbit in LSBIT_MODES {\n        for _ in 0..(N / 8).max(64) {\n            let uni = uni_with_low4(&mut rng, rng.range_i32(0, 7), rng.below(2) == 1);\n            check(\n                uni,\n                i32::MAX,\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                lsbit,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 20\n\n#[test]\nfn row20_step_int_min_overflow_and_negation() {\n    let mut rng = Rng::new(0x1414);\n    for lsbit in LSBIT_MODES {\n        for _ in 0..(N / 8).max(64) {\n            let uni = uni_with_low4(&mut rng, rng.range_i32(0, 7), rng.below(2) == 1);\n            check(\n                uni,\n                i32::MIN,\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                lsbit,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 21\n\n#[test]\nfn row21_zero_targets_all_lsbit_modes() {\n    let mut rng = Rng::new(0x1515);\n    for lsbit in LSBIT_MODES {\n        for _ in 0..(N / 8).max(64) {\n            check(rng.interesting_i32(), rng.interesting_i32(), 0, 0, 0, lsbit);\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 22\n\n#[test]\nfn row22_targets_near_int_max_subtraction_overflow() {\n    let mut rng = Rng::new(0x1616);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let pred = i32::MAX - rng.range_i32(0, 1000);\n        let tgt = i32::MAX - rng.range_i32(0, 1000);\n        let tgt2 = i32::MAX - rng.range_i32(0, 1000);\n        check(\n            rng.interesting_i32(),\n            typical_step(&mut rng),\n            pred,\n            tgt,\n            tgt2,\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 23\n\n#[test]\nfn row23_targets_near_int_min_subtraction_overflow() {\n    let mut rng = Rng::new(0x1717);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let pred = i32::MIN + rng.range_i32(0, 1000);\n        let tgt = i32::MIN + rng.range_i32(0, 1000);\n        let tgt2 = i32::MIN + rng.range_i32(0, 1000);\n        check(\n            rng.interesting_i32(),\n            typical_step(&mut rng),\n            pred,\n            tgt,\n            tgt2,\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 24\n\n#[test]\nfn row24_tgt2_equals_tgt_symmetric_penalty() {\n    let mut rng = Rng::new(0x1818);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let tgt = typical_target(&mut rng);\n        check(\n            rng.interesting_i32(),\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            tgt,\n            tgt,\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 25\n\n#[test]\nfn row25_secondary_penalty_vanishes() {\n    // Keep every |tgt2 - p| < 32 so that d3 >> 5 == 0.\n    let mut rng = Rng::new(0x1919);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let pred = rng.range_i32(-4, 4);\n        let step = rng.range_i32(-4, 4);\n        let tgt2 = pred.wrapping_add(rng.range_i32(-3, 3));\n        check(\n            rng.range_i32(-32, 32),\n            step,\n            pred,\n            typical_target(&mut rng),\n            tgt2,\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 26\n\n#[test]\nfn row26_secondary_penalty_dominates() {\n    let mut rng = Rng::new(0x1a1a);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let pred = rng.range_i32(-1000, 1000);\n        let tgt = pred.wrapping_add(rng.range_i32(-10, 10));\n        // tgt2 far away so the >>5 term is large relative to d0/d1/d2.\n        let tgt2 = pred.wrapping_add(rng.range_i32(100_000, 10_000_000));\n        check(\n            rng.range_i32(-64, 64),\n            rng.range_i32(-64, 64),\n            pred,\n            tgt,\n            tgt2,\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 27\n\n#[test]\nfn row27_secondary_penalty_negative_d3_arithmetic_shift() {\n    let mut rng = Rng::new(0x1b1b);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let pred = rng.range_i32(-1000, 1000);\n        let tgt = pred.wrapping_add(rng.range_i32(-10, 10));\n        // tgt2 far *below* pred so tgt2 - p is strongly negative.\n        let tgt2 = pred.wrapping_sub(rng.range_i32(100_000, 10_000_000));\n        check(\n            rng.range_i32(-64, 64),\n            rng.range_i32(-64, 64),\n            pred,\n            tgt,\n            tgt2,\n            lsbit,\n        );\n    }\n}\n\n// ------------------------------------------------------- rows 28-31\n\n/// Exercise the selection outcomes by scanning a dense grid where all four\n/// (`Gkeep`, `Gup`, `Gdown`, `Gboth`) outcomes are reachable, and assert the\n/// grid actually covered each outcome (using the C as oracle for which\n/// candidate was returned).\nfn selection_grid(seed: u64) -> [usize; 4] {\n    let p = common::pair();\n    let mut rng = Rng::new(seed);\n    let mut counts = [0usize; 4];\n    for _ in 0..N * 2 {\n        let uni = rng.range_i32(-64, 64);\n        let step = rng.range_i32(-256, 256);\n        let pred = rng.range_i32(-512, 512);\n        let tgt = rng.range_i32(-512, 512);\n        let tgt2 = rng.range_i32(-4096, 4096);\n        let lsbit = rng.pick(&LSBIT_MODES);\n        check(uni, step, pred, tgt, tgt2, lsbit);\n\n        // Classify against the C's own answer, to prove coverage.\n        let out = unsafe { (p.c)(uni, step, pred, tgt, tgt2, lsbit) };\n        // Recompute the conditioned uni / uni1 / uni2 the same way the C does,\n        // purely to classify which branch produced `out`.\n        let (cu, cu1, cu2) = conditioned(uni, lsbit);\n        if out == cu && out != cu1 && out != cu2 {\n            counts[0] += 1; // definitely kept\n        } else if out == cu1 && out != cu {\n            counts[1] += 1; // took uni1\n        } else if out == cu2 && out != cu {\n            counts[2] += 1; // took uni2\n        } else {\n            counts[3] += 1; // ambiguous (candidates coincide)\n        }\n    }\n    counts\n}\n\n/// Mirror of the C's candidate conditioning, used only for test classification.\nfn conditioned(uni: i32, lsbit: i32) -> (i32, i32, i32) {\n    let mut u = uni;\n    let mut u1 = uni.wrapping_add(1);\n    let mut u2 = uni.wrapping_sub(1);\n    if ((uni ^ u1) & !7) != 0 {\n        u1 = uni;\n    }\n    if ((uni ^ u2) & !7) != 0 {\n        u2 = uni;\n    }\n    if lsbit != 0 {\n        if lsbit == 4 {\n            u &= !1;\n            u1 &= !1;\n            u2 &= !1;\n            u |= (u >> 1) & (u >> 2) & 1;\n            u1 |= (u1 >> 1) & (u1 >> 2) & 1;\n            u2 |= (u2 >> 1) & (u2 >> 2) & 1;\n        } else if (lsbit & 1) != 0 {\n            u |= 1;\n            u1 |= 1;\n            u2 |= 1;\n        } else {\n            u &= !1;\n            u1 &= !1;\n            u2 &= !1;\n        }\n    }\n    (u, u1, u2)\n}\n\n#[test]\nfn row28to31_selection_outcomes_all_covered() {\n    let counts = selection_grid(0x1c1c);\n    assert!(counts[0] > 0, \"row 28 (Gkeep) never exercised: {counts:?}\");\n    assert!(counts[1] > 0, \"row 29 (Gup) never exercised: {counts:?}\");\n    assert!(counts[2] > 0, \"row 30 (Gdown) never exercised: {counts:?}\");\n}\n\n#[test]\nfn row31_both_better_second_if_wins() {\n    // Construct cases where BOTH d1<d0 and d2<d0, so the C's second `if`\n    // overwrites the first and uni2 must be returned. pred == tgt makes the\n    // zero-magnitude candidate worst, and both neighbours better.\n    let mut rng = Rng::new(0x1f1f);\n    let mut hits = 0usize;\n    let p = common::pair();\n    for _ in 0..N * 4 {\n        let uni = rng.range_i32(-64, 64);\n        let step = rng.range_i32(1, 4096);\n        let pred = rng.range_i32(-4096, 4096);\n        let tgt = rng.range_i32(-4096, 4096);\n        let tgt2 = rng.range_i32(-4096, 4096);\n        check(uni, step, pred, tgt, tgt2, 0);\n\n        let (cu, cu1, cu2) = conditioned(uni, 0);\n        let out = unsafe { (p.c)(uni, step, pred, tgt, tgt2, 0) };\n        if cu1 != cu && cu2 != cu && out == cu2 {\n            hits += 1;\n        }\n    }\n    assert!(hits > 0, \"row 31: never observed uni2 winning outright\");\n}\n\n// ---------------------------------------------------------------- row 32\n\n#[test]\nfn row32_negative_uni_all_lsbit_modes() {\n    let mut rng = Rng::new(0x2020);\n    for lsbit in LSBIT_MODES {\n        for _ in 0..(N / 4).max(128) {\n            let uni = -rng.range_i32(1, 1 << 24);\n            check(\n                uni,\n                typical_step(&mut rng),\n                typical_target(&mut rng),\n                typical_target(&mut rng),\n                typical_target(&mut rng),\n                lsbit,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 33\n\n#[test]\nfn row33_exhaustive_small_grid() {\n    // uni in -64..=64, lsbit in -4..=9, over a small step/target grid.\n    for uni in -64..=64i32 {\n        for lsbit in -4..=9i32 {\n            for step in [-9i32, -1, 0, 1, 3, 8, 17, 64] {\n                for pred in [-33i32, 0, 7, 100] {\n                    for tgt in [-100i32, 0, 5, 250] {\n                        for tgt2 in [-4096i32, -1, 0, 63, 4096] {\n                            check(uni, step, pred, tgt, tgt2, lsbit);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 34\n\n#[test]\nfn row34_full_range_uniform_fuzz() {\n    let mut rng = Rng::new(0xDEADBEEF);\n    for _ in 0..200_000 {\n        check(\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 35\n\n#[test]\nfn row35_structured_interesting_fuzz() {\n    let mut rng = Rng::new(0xC0FFEE);\n    for _ in 0..200_000 {\n        check(\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.lsbit(),\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3598,"cache_read_input_tokens":31400,"cache_creation":{"ephemeral_5m_input_tokens":3598,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"70e28745-9584-46db-9f42-c57a7e624ccc","uuid":"c202727f-16bb-41f9-a4db-094d5b785c4b","timestamp":"2026-09-05T00:09:41.101Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01J36kA69md2ST9n5WRYZMnS","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-jLNDdo/translation/tests/valid_paths.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"70e28745-9584-46db-9f42-c57a7e624ccc","uuid":"c448ac33-bc24-4b3e-81fb-f8068935362d","timestamp":"2026-09-05T00:09:41.112Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-jLNDdo/translation/tests/valid_paths.rs","content":"//! Phase B — valid-path differential tests, one test per CONFIGS.md row.\n//!\n//! Every test calls BOTH the C `.so` and the Rust `.so` through `libloading`\n//! and asserts the returned `int` matches byte-for-byte. Each row is driven\n//! with many randomized inputs from a fixed-seed PRNG.\n\nmod common;\nuse common::{check, Rng, LSBIT_MODES};\n\n/// Number of randomized cases per row.\nconst N: usize = 4000;\n\n/// Build a `uni` whose low 3 bits equal `low`, with randomized upper bits.\nfn uni_with_low3(rng: &mut Rng, low: i32) -> i32 {\n    let upper = rng.range_i32(-1 << 20, 1 << 20) & !7;\n    upper | (low & 7)\n}\n\n/// Build a `uni` with a chosen `uni & 7` and a chosen `uni & 8`.\nfn uni_with_low4(rng: &mut Rng, low3: i32, bit3_set: bool) -> i32 {\n    let upper = rng.range_i32(-1 << 20, 1 << 20) & !15;\n    let mut v = upper | (low3 & 7);\n    if bit3_set {\n        v |= 8;\n    }\n    v\n}\n\nfn typical_step(rng: &mut Rng) -> i32 {\n    rng.range_i32(-100_000, 100_000)\n}\n\nfn typical_target(rng: &mut Rng) -> i32 {\n    rng.range_i32(-1_000_000, 1_000_000)\n}\n\n// ---------------------------------------------------------------- row 1\n\n#[test]\nfn row01_baseline_lsbit0_mid_positive() {\n    let mut rng = Rng::new(0x0101);\n    for _ in 0..N {\n        let uni = uni_with_low4(&mut rng, rng.range_i32(1, 6), false);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            0,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 2\n\n#[test]\nfn row02_lsbit0_low3_zero_clamps_uni2() {\n    let mut rng = Rng::new(0x0202);\n    for _ in 0..N {\n        let uni = uni_with_low3(&mut rng, 0);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            0,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 3\n\n#[test]\nfn row03_lsbit0_low3_seven_clamps_uni1() {\n    let mut rng = Rng::new(0x0303);\n    for _ in 0..N {\n        let uni = uni_with_low3(&mut rng, 7);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            0,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 4\n\n#[test]\nfn row04_lsbit0_bit3_set_negates_diff() {\n    let mut rng = Rng::new(0x0404);\n    for _ in 0..N {\n        let uni = uni_with_low4(&mut rng, rng.range_i32(1, 6), true);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            0,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 5\n\n#[test]\nfn row05_low3_seven_and_bit3_set() {\n    let mut rng = Rng::new(0x0505);\n    for _ in 0..N {\n        let uni = uni_with_low4(&mut rng, 7, true);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            0,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 6\n\n#[test]\nfn row06_low3_zero_and_bit3_set() {\n    let mut rng = Rng::new(0x0606);\n    for _ in 0..N {\n        let uni = uni_with_low4(&mut rng, 0, true);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            0,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 7\n\n#[test]\nfn row07_mixed_sign_pattern_across_candidates() {\n    // uni&7 == 7 with bit3 clear => uni1 = uni+1 flips bit 3 *before* clamping\n    // is considered; uni&7 == 0 with bit3 set => uni2 = uni-1 flips bit 3.\n    // Sweep every low-4-bit pattern so all sign combinations occur.\n    let mut rng = Rng::new(0x0707);\n    for low4 in 0..16i32 {\n        for _ in 0..(N / 16).max(64) {\n            let upper = rng.range_i32(-1 << 20, 1 << 20) & !15;\n            let uni = upper | low4;\n            check(\n                uni,\n                typical_step(&mut rng),\n                typical_target(&mut rng),\n                typical_target(&mut rng),\n                typical_target(&mut rng),\n                0,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 8\n\n#[test]\nfn row08_lsbit_odd_forces_bit0_set() {\n    let mut rng = Rng::new(0x0808);\n    let odds = [1i32, 3, 5, 7, 9, 11, -1, -3, -5, -7];\n    for _ in 0..N {\n        let lsbit = rng.pick(&odds);\n        let uni = uni_with_low4(&mut rng, rng.range_i32(1, 6), rng.below(2) == 1);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 9\n\n#[test]\nfn row09_lsbit_odd_at_group_boundaries() {\n    let mut rng = Rng::new(0x0909);\n    let odds = [1i32, 3, 5, 7, 9, -1, -3, i32::MAX];\n    for _ in 0..N {\n        let lsbit = rng.pick(&odds);\n        let low3 = if rng.below(2) == 0 { 0 } else { 7 };\n        let uni = uni_with_low4(&mut rng, low3, rng.below(2) == 1);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 10\n\n#[test]\nfn row10_lsbit_even_nonzero_forces_bit0_clear() {\n    let mut rng = Rng::new(0x0a0a);\n    let evens = [2i32, 6, 8, 10, 12, -2, -4, -6];\n    for _ in 0..N {\n        let lsbit = rng.pick(&evens);\n        let uni = uni_with_low4(&mut rng, rng.range_i32(1, 6), rng.below(2) == 1);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 11\n\n#[test]\nfn row11_lsbit_even_at_group_boundaries() {\n    let mut rng = Rng::new(0x0b0b);\n    let evens = [2i32, 6, 8, 10, -2, -4, i32::MIN];\n    for _ in 0..N {\n        let lsbit = rng.pick(&evens);\n        let low3 = if rng.below(2) == 0 { 0 } else { 7 };\n        let uni = uni_with_low4(&mut rng, low3, rng.below(2) == 1);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 12\n\n#[test]\nfn row12_lsbit4_dither_positive_uni() {\n    let mut rng = Rng::new(0x0c0c);\n    for _ in 0..N {\n        let uni = rng.range_i32(0, 1 << 20);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            4,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 13\n\n#[test]\nfn row13_lsbit4_dither_negative_uni_arithmetic_shift() {\n    let mut rng = Rng::new(0x0d0d);\n    for _ in 0..N {\n        let uni = rng.range_i32(-(1 << 20), -1);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            4,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 14\n\n#[test]\nfn row14_lsbit4_at_group_boundaries() {\n    let mut rng = Rng::new(0x0e0e);\n    for _ in 0..N {\n        let low3 = if rng.below(2) == 0 { 0 } else { 7 };\n        let uni = uni_with_low4(&mut rng, low3, rng.below(2) == 1);\n        check(\n            uni,\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            4,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 15\n\n#[test]\nfn row15_lsbit4_exhaustive_low_bits() {\n    // Every bit pattern of (uni>>1)&(uni>>2)&1 over a full 0..=63 window,\n    // plus the negative mirror, with randomized step/targets.\n    let mut rng = Rng::new(0x0f0f);\n    for uni in -64..=64i32 {\n        for _ in 0..64 {\n            check(\n                uni,\n                typical_step(&mut rng),\n                typical_target(&mut rng),\n                typical_target(&mut rng),\n                typical_target(&mut rng),\n                4,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 16\n\n#[test]\nfn row16_step_zero_all_ties() {\n    let mut rng = Rng::new(0x1010);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        check(\n            rng.interesting_i32(),\n            0,\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 17\n\n#[test]\nfn row17_step_small_truncates_to_zero() {\n    let mut rng = Rng::new(0x1111);\n    for _ in 0..N {\n        let step = rng.range_i32(1, 7);\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let uni = uni_with_low4(&mut rng, rng.range_i32(0, 7), rng.below(2) == 1);\n        check(\n            uni,\n            step,\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 18\n\n#[test]\nfn row18_step_negative_division_truncates_toward_zero() {\n    let mut rng = Rng::new(0x1212);\n    for _ in 0..N {\n        let step = -rng.range_i32(1, 1_000_000);\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let uni = uni_with_low4(&mut rng, rng.range_i32(0, 7), rng.below(2) == 1);\n        check(\n            uni,\n            step,\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            typical_target(&mut rng),\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 19\n\n#[test]\nfn row19_step_int_max_multiplication_overflow() {\n    let mut rng = Rng::new(0x1313);\n    for lsbit in LSBIT_MODES {\n        for _ in 0..(N / 8).max(64) {\n            let uni = uni_with_low4(&mut rng, rng.range_i32(0, 7), rng.below(2) == 1);\n            check(\n                uni,\n                i32::MAX,\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                lsbit,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 20\n\n#[test]\nfn row20_step_int_min_overflow_and_negation() {\n    let mut rng = Rng::new(0x1414);\n    for lsbit in LSBIT_MODES {\n        for _ in 0..(N / 8).max(64) {\n            let uni = uni_with_low4(&mut rng, rng.range_i32(0, 7), rng.below(2) == 1);\n            check(\n                uni,\n                i32::MIN,\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                lsbit,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 21\n\n#[test]\nfn row21_zero_targets_all_lsbit_modes() {\n    let mut rng = Rng::new(0x1515);\n    for lsbit in LSBIT_MODES {\n        for _ in 0..(N / 8).max(64) {\n            check(rng.interesting_i32(), rng.interesting_i32(), 0, 0, 0, lsbit);\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 22\n\n#[test]\nfn row22_targets_near_int_max_subtraction_overflow() {\n    let mut rng = Rng::new(0x1616);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let pred = i32::MAX - rng.range_i32(0, 1000);\n        let tgt = i32::MAX - rng.range_i32(0, 1000);\n        let tgt2 = i32::MAX - rng.range_i32(0, 1000);\n        check(\n            rng.interesting_i32(),\n            typical_step(&mut rng),\n            pred,\n            tgt,\n            tgt2,\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 23\n\n#[test]\nfn row23_targets_near_int_min_subtraction_overflow() {\n    let mut rng = Rng::new(0x1717);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let pred = i32::MIN + rng.range_i32(0, 1000);\n        let tgt = i32::MIN + rng.range_i32(0, 1000);\n        let tgt2 = i32::MIN + rng.range_i32(0, 1000);\n        check(\n            rng.interesting_i32(),\n            typical_step(&mut rng),\n            pred,\n            tgt,\n            tgt2,\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 24\n\n#[test]\nfn row24_tgt2_equals_tgt_symmetric_penalty() {\n    let mut rng = Rng::new(0x1818);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let tgt = typical_target(&mut rng);\n        check(\n            rng.interesting_i32(),\n            typical_step(&mut rng),\n            typical_target(&mut rng),\n            tgt,\n            tgt,\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 25\n\n#[test]\nfn row25_secondary_penalty_vanishes() {\n    // Keep every |tgt2 - p| < 32 so that d3 >> 5 == 0.\n    let mut rng = Rng::new(0x1919);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let pred = rng.range_i32(-4, 4);\n        let step = rng.range_i32(-4, 4);\n        let tgt2 = pred.wrapping_add(rng.range_i32(-3, 3));\n        check(\n            rng.range_i32(-32, 32),\n            step,\n            pred,\n            typical_target(&mut rng),\n            tgt2,\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 26\n\n#[test]\nfn row26_secondary_penalty_dominates() {\n    let mut rng = Rng::new(0x1a1a);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let pred = rng.range_i32(-1000, 1000);\n        let tgt = pred.wrapping_add(rng.range_i32(-10, 10));\n        // tgt2 far away so the >>5 term is large relative to d0/d1/d2.\n        let tgt2 = pred.wrapping_add(rng.range_i32(100_000, 10_000_000));\n        check(\n            rng.range_i32(-64, 64),\n            rng.range_i32(-64, 64),\n            pred,\n            tgt,\n            tgt2,\n            lsbit,\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 27\n\n#[test]\nfn row27_secondary_penalty_negative_d3_arithmetic_shift() {\n    let mut rng = Rng::new(0x1b1b);\n    for _ in 0..N {\n        let lsbit = rng.pick(&LSBIT_MODES);\n        let pred = rng.range_i32(-1000, 1000);\n        let tgt = pred.wrapping_add(rng.range_i32(-10, 10));\n        // tgt2 far *below* pred so tgt2 - p is strongly negative.\n        let tgt2 = pred.wrapping_sub(rng.range_i32(100_000, 10_000_000));\n        check(\n            rng.range_i32(-64, 64),\n            rng.range_i32(-64, 64),\n            pred,\n            tgt,\n            tgt2,\n            lsbit,\n        );\n    }\n}\n\n// ------------------------------------------------------- rows 28-31\n\n/// Exercise the selection outcomes by scanning a dense grid where all four\n/// (`Gkeep`, `Gup`, `Gdown`, `Gboth`) outcomes are reachable, and assert the\n/// grid actually covered each outcome (using the C as oracle for which\n/// candidate was returned).\nfn selection_grid(seed: u64) -> [usize; 4] {\n    let p = common::pair();\n    let mut rng = Rng::new(seed);\n    let mut counts = [0usize; 4];\n    for _ in 0..N * 2 {\n        let uni = rng.range_i32(-64, 64);\n        let step = rng.range_i32(-256, 256);\n        let pred = rng.range_i32(-512, 512);\n        let tgt = rng.range_i32(-512, 512);\n        let tgt2 = rng.range_i32(-4096, 4096);\n        let lsbit = rng.pick(&LSBIT_MODES);\n        check(uni, step, pred, tgt, tgt2, lsbit);\n\n        // Classify against the C's own answer, to prove coverage.\n        let out = unsafe { (p.c)(uni, step, pred, tgt, tgt2, lsbit) };\n        // Recompute the conditioned uni / uni1 / uni2 the same way the C does,\n        // purely to classify which branch produced `out`.\n        let (cu, cu1, cu2) = conditioned(uni, lsbit);\n        if out == cu && out != cu1 && out != cu2 {\n            counts[0] += 1; // definitely kept\n        } else if out == cu1 && out != cu {\n            counts[1] += 1; // took uni1\n        } else if out == cu2 && out != cu {\n            counts[2] += 1; // took uni2\n        } else {\n            counts[3] += 1; // ambiguous (candidates coincide)\n        }\n    }\n    counts\n}\n\n/// Mirror of the C's candidate conditioning, used only for test classification.\nfn conditioned(uni: i32, lsbit: i32) -> (i32, i32, i32) {\n    let mut u = uni;\n    let mut u1 = uni.wrapping_add(1);\n    let mut u2 = uni.wrapping_sub(1);\n    if ((uni ^ u1) & !7) != 0 {\n        u1 = uni;\n    }\n    if ((uni ^ u2) & !7) != 0 {\n        u2 = uni;\n    }\n    if lsbit != 0 {\n        if lsbit == 4 {\n            u &= !1;\n            u1 &= !1;\n            u2 &= !1;\n            u |= (u >> 1) & (u >> 2) & 1;\n            u1 |= (u1 >> 1) & (u1 >> 2) & 1;\n            u2 |= (u2 >> 1) & (u2 >> 2) & 1;\n        } else if (lsbit & 1) != 0 {\n            u |= 1;\n            u1 |= 1;\n            u2 |= 1;\n        } else {\n            u &= !1;\n            u1 &= !1;\n            u2 &= !1;\n        }\n    }\n    (u, u1, u2)\n}\n\n#[test]\nfn row28to31_selection_outcomes_all_covered() {\n    let counts = selection_grid(0x1c1c);\n    assert!(counts[0] > 0, \"row 28 (Gkeep) never exercised: {counts:?}\");\n    assert!(counts[1] > 0, \"row 29 (Gup) never exercised: {counts:?}\");\n    assert!(counts[2] > 0, \"row 30 (Gdown) never exercised: {counts:?}\");\n}\n\n#[test]\nfn row31_both_better_second_if_wins() {\n    // Construct cases where BOTH d1<d0 and d2<d0, so the C's second `if`\n    // overwrites the first and uni2 must be returned. pred == tgt makes the\n    // zero-magnitude candidate worst, and both neighbours better.\n    let mut rng = Rng::new(0x1f1f);\n    let mut hits = 0usize;\n    let p = common::pair();\n    for _ in 0..N * 4 {\n        let uni = rng.range_i32(-64, 64);\n        let step = rng.range_i32(1, 4096);\n        let pred = rng.range_i32(-4096, 4096);\n        let tgt = rng.range_i32(-4096, 4096);\n        let tgt2 = rng.range_i32(-4096, 4096);\n        check(uni, step, pred, tgt, tgt2, 0);\n\n        let (cu, cu1, cu2) = conditioned(uni, 0);\n        let out = unsafe { (p.c)(uni, step, pred, tgt, tgt2, 0) };\n        if cu1 != cu && cu2 != cu && out == cu2 {\n            hits += 1;\n        }\n    }\n    assert!(hits > 0, \"row 31: never observed uni2 winning outright\");\n}\n\n// ---------------------------------------------------------------- row 32\n\n#[test]\nfn row32_negative_uni_all_lsbit_modes() {\n    let mut rng = Rng::new(0x2020);\n    for lsbit in LSBIT_MODES {\n        for _ in 0..(N / 4).max(128) {\n            let uni = -rng.range_i32(1, 1 << 24);\n            check(\n                uni,\n                typical_step(&mut rng),\n                typical_target(&mut rng),\n                typical_target(&mut rng),\n                typical_target(&mut rng),\n                lsbit,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 33\n\n#[test]\nfn row33_exhaustive_small_grid() {\n    // uni in -64..=64, lsbit in -4..=9, over a small step/target grid.\n    for uni in -64..=64i32 {\n        for lsbit in -4..=9i32 {\n            for step in [-9i32, -1, 0, 1, 3, 8, 17, 64] {\n                for pred in [-33i32, 0, 7, 100] {\n                    for tgt in [-100i32, 0, 5, 250] {\n                        for tgt2 in [-4096i32, -1, 0, 63, 4096] {\n                            check(uni, step, pred, tgt, tgt2, lsbit);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------- row 34\n\n#[test]\nfn row34_full_range_uniform_fuzz() {\n    let mut rng = Rng::new(0xDEADBEEF);\n    for _ in 0..200_000 {\n        check(\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n        );\n    }\n}\n\n// ---------------------------------------------------------------- row 35\n\n#[test]\nfn row35_structured_interesting_fuzz() {\n    let mut rng = Rng::new(0xC0FFEE);\n    for _ in 0..200_000 {\n        check(\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.lsbit(),\n        );\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_uhb2ihpho5fnguvw2ayzaf75d4jray5cjetiwznx7lzst7i7odua","type":"message","role":"assistant","content":[{"type":"text","text":"Now the Phase C error-path tests, one per ERRORS.md row."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9413,"cache_read_input_tokens":34998,"cache_creation":{"ephemeral_5m_input_tokens":9413,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"70e28745-9584-46db-9f42-c57a7e624ccc","uuid":"b95c2a02-f6e6-4282-b44c-4db0ef28198c","timestamp":"2026-09-05T00:09:43.833Z"}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_uhb2ihpho5fnguvw2ayzaf75d4jray5cjetiwznx7lzst7i7odua","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01MjKtAJYyCKiZH7SqdKrp9r","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-jLNDdo/translation/tests/error_paths.rs","content":"//! Phase C — error-path differential tests, one test per ERRORS.md row.\n//!\n//! `encode_quant` has no rejection surface (no pointers, no error return, no\n//! assert, no range check), so these rows cover the implicit boundary/overflow\n//! conditions: exactly the inputs where a non-wrapping Rust translation would\n//! panic instead of returning the C's wrapping value. Each test asserts the two\n//! `.so`s return the SAME `int`, and that neither traps.\n\nmod common;\nuse common::{check, pair, Rng, LSBIT_MODES};\n\nconst MIN: i32 = i32::MIN;\nconst MAX: i32 = i32::MAX;\n\n// -------------------------------------------------------------- row 1\n// No pointer arguments exist, so there is no null-pointer rejection to\n// mirror. The degenerate all-zero call must still return a value.\n\n#[test]\nfn row01_no_pointer_args_all_zero_call() {\n    let p = pair();\n    let c = unsafe { (p.c)(0, 0, 0, 0, 0, 0) };\n    let r = unsafe { (p.rust)(0, 0, 0, 0, 0, 0) };\n    assert_eq!(c, r, \"all-zero call diverged\");\n    assert_eq!(c, 0, \"C returns 0 for the all-zero call\");\n}\n\n// -------------------------------------------------------------- row 2\n// uni = INT_MAX  =>  uni1 = uni + 1 overflows.\n\n#[test]\nfn row02_uni_int_max_plus_one_overflow() {\n    let mut rng = Rng::new(0x0002);\n    for lsbit in LSBIT_MODES {\n        for _ in 0..256 {\n            check(\n                MAX,\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                lsbit,\n            );\n        }\n    }\n    // Also the immediate neighbourhood.\n    for uni in (MAX - 4)..=MAX {\n        for lsbit in LSBIT_MODES {\n            check(uni, 1, 0, 0, 0, lsbit);\n            check(uni, MAX, MAX, MIN, MAX, lsbit);\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 3\n// uni = INT_MIN  =>  uni2 = uni - 1 overflows.\n\n#[test]\nfn row03_uni_int_min_minus_one_overflow() {\n    let mut rng = Rng::new(0x0003);\n    for lsbit in LSBIT_MODES {\n        for _ in 0..256 {\n            check(\n                MIN,\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                lsbit,\n            );\n        }\n    }\n    for uni in MIN..=(MIN + 4) {\n        for lsbit in LSBIT_MODES {\n            check(uni, 1, 0, 0, 0, lsbit);\n            check(uni, MIN, MIN, MAX, MIN, lsbit);\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 4\n// step = INT_MAX with uni&7 == 7  =>  (2*7+1)*step overflows.\n\n#[test]\nfn row04_step_int_max_multiply_overflow() {\n    let mut rng = Rng::new(0x0004);\n    for low3 in 0..8i32 {\n        for lsbit in LSBIT_MODES {\n            for _ in 0..64 {\n                let uni = (rng.range_i32(-1 << 16, 1 << 16) & !7) | low3;\n                check(\n                    uni,\n                    MAX,\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    lsbit,\n                );\n            }\n        }\n    }\n    // step just below INT_MAX too.\n    for step in (MAX - 3)..=MAX {\n        for uni in 0..16i32 {\n            check(uni, step, 0, 0, 0, 0);\n            check(uni, step, MAX, MIN, MAX, 4);\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 5\n// step = INT_MIN  =>  overflow AND diff = -diff on INT_MIN.\n\n#[test]\nfn row05_step_int_min_overflow_and_negate() {\n    let mut rng = Rng::new(0x0005);\n    for low4 in 0..16i32 {\n        for lsbit in LSBIT_MODES {\n            for _ in 0..64 {\n                let uni = (rng.range_i32(-1 << 16, 1 << 16) & !15) | low4;\n                check(\n                    uni,\n                    MIN,\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    lsbit,\n                );\n            }\n        }\n    }\n    for step in MIN..=(MIN + 3) {\n        for uni in 0..16i32 {\n            check(uni, step, 0, 0, 0, 0);\n            check(uni, step, MIN, MAX, MIN, 4);\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 6\n// diff == INT_MIN and uni&8 set  =>  unary minus on INT_MIN.\n// (2*(uni&7)+1)*step)/8 == INT_MIN requires the product to be <= 8*INT_MIN\n// after wrapping; sweep step values that produce exactly INT_MIN/near it.\n\n#[test]\nfn row06_negate_int_min_diff() {\n    // For uni&7 == 0 the multiplier is 1, so diff = step/8. Pick step so\n    // step/8 == INT_MIN is impossible; instead rely on the wrapped product.\n    // Sweep the whole (low4, step) space that can wrap to INT_MIN.\n    let mut rng = Rng::new(0x0006);\n    let mut saw_int_min_diff = false;\n    for _ in 0..200_000 {\n        let low4 = rng.range_i32(8, 15); // bit 3 set => negation happens\n        let uni = low4;\n        let step = rng.next_i32();\n        check(uni, step, 0, 0, 0, 0);\n\n        let m = 2i32.wrapping_mul(uni & 7).wrapping_add(1);\n        let diff = m.wrapping_mul(step) / 8;\n        if diff == MIN {\n            saw_int_min_diff = true;\n            // Hammer this exact case with many pred/tgt/tgt2 combinations.\n            for pred in [MIN, -1, 0, 1, MAX] {\n                for tgt in [MIN, 0, MAX] {\n                    for tgt2 in [MIN, 0, MAX] {\n                        for lsbit in LSBIT_MODES {\n                            check(uni, step, pred, tgt, tgt2, lsbit);\n                        }\n                    }\n                }\n            }\n        }\n    }\n    // Directly construct one: multiplier 1 (uni&7==0), bit3 set (uni==8),\n    // step = INT_MIN gives diff = INT_MIN/8, not INT_MIN. Use multiplier 8?\n    // The multiplier is always odd, so the exact INT_MIN diff is reachable\n    // only via wrapping; assert we found it during the sweep.\n    assert!(\n        saw_int_min_diff,\n        \"row 6: never produced diff == INT_MIN to negate\"\n    );\n}\n\n// -------------------------------------------------------------- row 7\n// pred + diff overflows.\n\n#[test]\nfn row07_pred_plus_diff_overflow() {\n    let mut rng = Rng::new(0x0007);\n    for pred in [MIN, MIN + 1, MIN + 7, -1, 0, 1, MAX - 7, MAX - 1, MAX] {\n        for lsbit in LSBIT_MODES {\n            for _ in 0..128 {\n                check(\n                    rng.interesting_i32(),\n                    rng.next_i32(),\n                    pred,\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    lsbit,\n                );\n            }\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 8\n// tgt - p0 overflows (tgt = INT_MAX with p0 < 0, and the mirror).\n\n#[test]\nfn row08_tgt_minus_p_overflow() {\n    let mut rng = Rng::new(0x0008);\n    for &tgt in &[MIN, MIN + 1, MAX - 1, MAX] {\n        for lsbit in LSBIT_MODES {\n            for _ in 0..128 {\n                // pred with the opposite sign so the subtraction overflows.\n                let pred = if tgt > 0 { MIN + rng.range_i32(0, 64) } else { MAX - rng.range_i32(0, 64) };\n                check(\n                    rng.interesting_i32(),\n                    rng.next_i32(),\n                    pred,\n                    tgt,\n                    rng.interesting_i32(),\n                    lsbit,\n                );\n            }\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 9\n// tgt2 - p0 overflows.\n\n#[test]\nfn row09_tgt2_minus_p_overflow() {\n    let mut rng = Rng::new(0x0009);\n    for &tgt2 in &[MIN, MIN + 1, MAX - 1, MAX] {\n        for lsbit in LSBIT_MODES {\n            for _ in 0..128 {\n                let pred = if tgt2 > 0 { MIN + rng.range_i32(0, 64) } else { MAX - rng.range_i32(0, 64) };\n                check(\n                    rng.interesting_i32(),\n                    rng.next_i32(),\n                    pred,\n                    rng.interesting_i32(),\n                    tgt2,\n                    lsbit,\n                );\n            }\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 10\n// d0 ^ (d0 >> 31) where d0 == INT_MIN  =>  INT_MAX, not INT_MIN.\n// Sweep to guarantee we actually hit a d == INT_MIN.\n\n#[test]\nfn row10_xor_abs_of_int_min() {\n    let mut rng = Rng::new(0x000a);\n    let mut hits = 0usize;\n    for _ in 0..200_000 {\n        let uni = rng.range_i32(-16, 16);\n        let step = rng.next_i32();\n        let pred = rng.next_i32();\n        let tgt = rng.next_i32();\n        let tgt2 = rng.next_i32();\n        check(uni, step, pred, tgt, tgt2, 0);\n\n        // Recompute d0 to detect the INT_MIN case.\n        let m = 2i32.wrapping_mul(uni & 7).wrapping_add(1);\n        let mut diff = m.wrapping_mul(step) / 8;\n        if (uni & 8) != 0 {\n            diff = diff.wrapping_neg();\n        }\n        let p0 = pred.wrapping_add(diff);\n        if tgt.wrapping_sub(p0) == MIN {\n            hits += 1;\n            for lsbit in LSBIT_MODES {\n                check(uni, step, pred, tgt, tgt2, lsbit);\n            }\n        }\n    }\n    // Also construct it directly: tgt - p0 == INT_MIN when p0 == 0 and\n    // tgt == INT_MIN. uni&7 == 0 & step == 0 gives diff == 0, so p0 == pred.\n    for lsbit in LSBIT_MODES {\n        check(0, 0, 0, MIN, MIN, lsbit);\n        check(8, 0, 0, MIN, 0, lsbit);\n        check(0, 0, 0, 0, MIN, lsbit);\n    }\n    assert!(hits > 0, \"row 10: never produced d == INT_MIN via the sweep\");\n}\n\n// -------------------------------------------------------------- row 11\n// d3 >> 5 with d3 negative  =>  arithmetic shift.\n// d3 is xor-abs'd first, so it is negative only when it was INT_MIN... no:\n// d3 ^ (d3>>31) yields a non-negative value EXCEPT for INT_MIN -> INT_MAX.\n// So d3 >> 5 is negative only if d3 stayed negative, which cannot happen.\n// The row is still tested: assert the shift result matches for the whole\n// range including the INT_MIN edge, and separately cover negative >> in the\n// lsbit==4 dither path (row 15).\n\n#[test]\nfn row11_d3_shift_right_five_arithmetic() {\n    let mut rng = Rng::new(0x000b);\n    for _ in 0..100_000 {\n        // Force large |tgt2 - p| so the >>5 term is significant.\n        let pred = rng.range_i32(-1 << 28, 1 << 28);\n        let tgt2 = rng.range_i32(MIN, MAX);\n        check(\n            rng.range_i32(-32, 32),\n            rng.next_i32(),\n            pred,\n            rng.next_i32(),\n            tgt2,\n            rng.lsbit(),\n        );\n    }\n    // The exact INT_MIN -> INT_MAX >> 5 case.\n    for lsbit in LSBIT_MODES {\n        check(0, 0, 0, 0, MIN, lsbit);\n        check(0, 0, MAX, 0, MIN, lsbit);\n        check(0, 0, MIN, 0, MAX, lsbit);\n    }\n}\n\n// -------------------------------------------------------------- row 12\n// d0 += d3 >> 5 overflows.\n\n#[test]\nfn row12_penalty_add_overflow() {\n    let mut rng = Rng::new(0x000c);\n    let mut hits = 0usize;\n    for _ in 0..200_000 {\n        let uni = rng.range_i32(-16, 16);\n        let step = rng.next_i32();\n        let pred = rng.next_i32();\n        let tgt = rng.next_i32();\n        let tgt2 = rng.next_i32();\n        check(uni, step, pred, tgt, tgt2, rng.lsbit());\n\n        let m = 2i32.wrapping_mul(uni & 7).wrapping_add(1);\n        let mut diff = m.wrapping_mul(step) / 8;\n        if (uni & 8) != 0 {\n            diff = diff.wrapping_neg();\n        }\n        let p0 = pred.wrapping_add(diff);\n        let mut d0 = tgt.wrapping_sub(p0);\n        d0 ^= d0 >> 31;\n        let mut d3 = tgt2.wrapping_sub(p0);\n        d3 ^= d3 >> 31;\n        if d0.checked_add(d3 >> 5).is_none() {\n            hits += 1;\n            for lsbit in LSBIT_MODES {\n                check(uni, step, pred, tgt, tgt2, lsbit);\n            }\n        }\n    }\n    assert!(hits > 0, \"row 12: never triggered the penalty-add overflow\");\n}\n\n// -------------------------------------------------------------- row 13\n// ((2*(uni&7)+1)*step)/8 with a negative numerator: truncation toward zero.\n\n#[test]\nfn row13_division_truncates_toward_zero() {\n    // For every low-3-bit multiplier, sweep numerators whose remainder mod 8\n    // is nonzero and negative, so floor-division would differ from C's\n    // truncation.\n    for low3 in 0..8i32 {\n        let m = 2 * low3 + 1;\n        for r in 1..8i32 {\n            // step chosen so m*step == -(k*8 + r)\n            for k in 0..8i32 {\n                let target = -(k * 8 + r);\n                if target % m == 0 {\n                    let step = target / m;\n                    for bit3 in [0i32, 8] {\n                        for lsbit in LSBIT_MODES {\n                            check(low3 | bit3, step, 0, 0, 0, lsbit);\n                            check(low3 | bit3, step, 100, -100, 5000, lsbit);\n                        }\n                    }\n                }\n            }\n        }\n    }\n    // Broad negative-step sweep.\n    let mut rng = Rng::new(0x000d);\n    for _ in 0..100_000 {\n        let step = -rng.range_i32(1, 1 << 30);\n        check(\n            rng.range_i32(-64, 64),\n            step,\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.lsbit(),\n        );\n    }\n}\n\n// -------------------------------------------------------------- row 14\n// uni negative => uni & 7 / uni & 8 on the two's-complement pattern.\n\n#[test]\nfn row14_negative_uni_masks() {\n    for uni in -128..0i32 {\n        for lsbit in LSBIT_MODES {\n            for step in [-17i32, -1, 0, 1, 17, MAX, MIN] {\n                check(uni, step, 0, 0, 0, lsbit);\n                check(uni, step, -5, 9, -9999, lsbit);\n            }\n        }\n    }\n    let mut rng = Rng::new(0x000e);\n    for _ in 0..100_000 {\n        let uni = -rng.range_i32(1, MAX);\n        check(\n            uni,\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.lsbit(),\n        );\n    }\n}\n\n// -------------------------------------------------------------- row 15\n// uni >> 1, uni >> 2 with uni negative in the lsbit == 4 dither path.\n\n#[test]\nfn row15_lsbit4_negative_arithmetic_shift() {\n    for uni in -256..=0i32 {\n        for step in [-9i32, -1, 0, 1, 9, 64, MAX, MIN] {\n            check(uni, step, 0, 0, 0, 4);\n            check(uni, step, 77, -77, 123_456, 4);\n        }\n    }\n    // INT_MIN and INT_MAX in the dither path.\n    for &uni in &[MIN, MIN + 1, MIN + 2, MAX - 2, MAX - 1, MAX] {\n        for step in [0i32, 1, -1, MAX, MIN] {\n            check(uni, step, 0, 0, 0, 4);\n        }\n    }\n    let mut rng = Rng::new(0x000f);\n    for _ in 0..100_000 {\n        check(\n            -rng.range_i32(1, MAX),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            4,\n        );\n    }\n}\n\n// -------------------------------------------------------------- row 16\n// lsbit == 4 exactly takes the special branch (not the even branch).\n\n#[test]\nfn row16_lsbit_exactly_four() {\n    let mut rng = Rng::new(0x0010);\n    for _ in 0..20_000 {\n        check(\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            4,\n        );\n    }\n    // Prove 4 differs from its even neighbours somewhere (so the branch is\n    // genuinely distinct and both impls agree on the distinction).\n    let p = pair();\n    let mut differs = false;\n    let mut rng = Rng::new(0x1004);\n    for _ in 0..50_000 {\n        let (u, s, pr, t, t2) = (\n            rng.range_i32(-64, 64),\n            rng.range_i32(-64, 64),\n            rng.range_i32(-64, 64),\n            rng.range_i32(-64, 64),\n            rng.range_i32(-4096, 4096),\n        );\n        let a = unsafe { (p.c)(u, s, pr, t, t2, 4) };\n        let b = unsafe { (p.c)(u, s, pr, t, t2, 2) };\n        check(u, s, pr, t, t2, 4);\n        check(u, s, pr, t, t2, 2);\n        if a != b {\n            differs = true;\n        }\n    }\n    assert!(differs, \"lsbit==4 branch is never distinguishable from lsbit==2\");\n}\n\n// -------------------------------------------------------------- row 17\n// lsbit odd (and != 4), including negative odd and INT_MAX.\n\n#[test]\nfn row17_lsbit_odd_including_negative_and_int_max() {\n    let odds: Vec<i32> = (-11..=11i32)\n        .filter(|v| v % 2 != 0)\n        .chain([MAX, MIN + 1, 0x7FFF_FFFF, -0x7FFF_FFFF])\n        .collect();\n    let mut rng = Rng::new(0x0011);\n    for &lsbit in &odds {\n        assert!(lsbit & 1 != 0, \"{lsbit} must be odd\");\n        assert_ne!(lsbit, 4);\n        for _ in 0..512 {\n            check(\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                lsbit,\n            );\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 18\n// lsbit even, nonzero, != 4, including negative even and INT_MIN.\n\n#[test]\nfn row18_lsbit_even_nonzero_including_negative_and_int_min() {\n    let evens: Vec<i32> = (-12..=12i32)\n        .filter(|v| *v != 0 && *v != 4 && v % 2 == 0)\n        .chain([MIN, MAX - 1, -0x7FFF_FFFE, 0x7FFF_FFFE])\n        .collect();\n    let mut rng = Rng::new(0x0012);\n    for &lsbit in &evens {\n        assert_eq!(lsbit & 1, 0, \"{lsbit} must be even\");\n        assert_ne!(lsbit, 0);\n        assert_ne!(lsbit, 4);\n        for _ in 0..512 {\n            check(\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                lsbit,\n            );\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 19\n// lsbit == 0 skips the whole conditioning block.\n\n#[test]\nfn row19_lsbit_zero_skips_block() {\n    let mut rng = Rng::new(0x0013);\n    for _ in 0..50_000 {\n        check(\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            0,\n        );\n    }\n}\n\n// -------------------------------------------------------------- row 20\n// Out-of-enum-range lsbit: INT_MAX (odd) and INT_MIN (even). `lsbit` is a\n// plain C int, so any 32-bit value is a real input the C handles; assert the\n// Rust classifies them into the same branch.\n\n#[test]\nfn row20_lsbit_out_of_range_extremes() {\n    let p = pair();\n    let mut rng = Rng::new(0x0014);\n    for _ in 0..20_000 {\n        let (u, s, pr, t, t2) = (\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n        );\n        for &lsbit in &[MIN, MIN + 1, MAX, MAX - 1, -1, -2, 5, 6, 100, 101] {\n            check(u, s, pr, t, t2, lsbit);\n        }\n        // INT_MAX is odd => must behave like lsbit = 1.\n        let a = unsafe { (p.c)(u, s, pr, t, t2, MAX) };\n        let b = unsafe { (p.c)(u, s, pr, t, t2, 1) };\n        assert_eq!(a, b, \"C: INT_MAX lsbit should act like 1\");\n        let ar = unsafe { (p.rust)(u, s, pr, t, t2, MAX) };\n        assert_eq!(a, ar, \"Rust diverged for lsbit = INT_MAX\");\n        // INT_MIN is even and != 4 => must behave like lsbit = 2.\n        let c = unsafe { (p.c)(u, s, pr, t, t2, MIN) };\n        let d = unsafe { (p.c)(u, s, pr, t, t2, 2) };\n        assert_eq!(c, d, \"C: INT_MIN lsbit should act like 2\");\n        let cr = unsafe { (p.rust)(u, s, pr, t, t2, MIN) };\n        assert_eq!(c, cr, \"Rust diverged for lsbit = INT_MIN\");\n    }\n}\n\n// -------------------------------------------------------------- row 21\n// uni&7 == 7 => uni1 clamped back to uni.\n\n#[test]\nfn row21_uni1_clamped_at_group_top() {\n    let mut rng = Rng::new(0x0015);\n    for _ in 0..50_000 {\n        let uni = (rng.next_i32() & !7) | 7;\n        check(\n            uni,\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.lsbit(),\n        );\n    }\n    // Including the INT_MAX group top (…0x7FFFFFFF has low3 == 7).\n    for lsbit in LSBIT_MODES {\n        check(MAX, 1, 0, 0, 0, lsbit);\n        check(MAX, MAX, MAX, MIN, MAX, lsbit);\n        check(-1, 1, 0, 0, 0, lsbit); // -1 & 7 == 7\n    }\n}\n\n// -------------------------------------------------------------- row 22\n// uni&7 == 0 => uni2 clamped back to uni.\n\n#[test]\nfn row22_uni2_clamped_at_group_bottom() {\n    let mut rng = Rng::new(0x0016);\n    for _ in 0..50_000 {\n        let uni = rng.next_i32() & !7;\n        check(\n            uni,\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.lsbit(),\n        );\n    }\n    // Including the INT_MIN group bottom (0x80000000 has low3 == 0).\n    for lsbit in LSBIT_MODES {\n        check(MIN, 1, 0, 0, 0, lsbit);\n        check(MIN, MIN, MIN, MAX, MIN, lsbit);\n        check(0, 1, 0, 0, 0, lsbit);\n    }\n}\n\n// -------------------------------------------------------------- row 23\n// step == 0 => all diffs zero, everything ties.\n\n#[test]\nfn row23_step_zero_no_candidate_wins() {\n    let mut rng = Rng::new(0x0017);\n    for _ in 0..50_000 {\n        check(\n            rng.interesting_i32(),\n            0,\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.lsbit(),\n        );\n    }\n    // With step == 0 the C must return the *conditioned* uni unchanged.\n    let p = pair();\n    for uni in -64..=64i32 {\n        for lsbit in LSBIT_MODES {\n            let c = unsafe { (p.c)(uni, 0, 7, -7, 999, lsbit) };\n            let r = unsafe { (p.rust)(uni, 0, 7, -7, 999, lsbit) };\n            assert_eq!(c, r, \"step==0 diverged for uni={uni} lsbit={lsbit}\");\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 24\n// Tie: d1 == d0 and d2 == d0 => strict `<` keeps uni.\n\n#[test]\nfn row24_strict_less_than_keeps_uni_on_ties() {\n    // step == 0 forces p0 == p1 == p2, hence exact ties.\n    let mut rng = Rng::new(0x0018);\n    for _ in 0..20_000 {\n        let uni = rng.range_i32(-1024, 1024);\n        let pred = rng.range_i32(-1024, 1024);\n        for lsbit in LSBIT_MODES {\n            check(uni, 0, pred, pred, pred, lsbit);\n        }\n    }\n    // Small |step| that truncates to 0 for every multiplier also ties.\n    for uni in -64..=64i32 {\n        for step in 1..8i32 {\n            for lsbit in LSBIT_MODES {\n                check(uni, step, 0, 0, 0, lsbit);\n            }\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 25\n// Both d1 < d0 and d2 < d0 => the SECOND `if` wins (returns uni2), even\n// when d1 < d2. This is the C quirk; assert the Rust reproduces it.\n\n#[test]\nfn row25_both_better_second_if_overwrites() {\n    let p = pair();\n    let mut rng = Rng::new(0x0019);\n    let mut confirmed = 0usize;\n    for _ in 0..300_000 {\n        let uni = rng.range_i32(-64, 64);\n        let step = rng.range_i32(1, 8192);\n        let pred = rng.range_i32(-8192, 8192);\n        let tgt = rng.range_i32(-8192, 8192);\n        let tgt2 = rng.range_i32(-8192, 8192);\n        let c = unsafe { (p.c)(uni, step, pred, tgt, tgt2, 0) };\n        let r = unsafe { (p.rust)(uni, step, pred, tgt, tgt2, 0) };\n        assert_eq!(c, r, \"diverged at ({uni},{step},{pred},{tgt},{tgt2},0)\");\n\n        // Recompute d0/d1/d2 to find the \"both better\" cases.\n        let (d0, d1, d2, u1, u2) = distortions(uni, step, pred, tgt, tgt2);\n        if d1 < d0 && d2 < d0 && u1 != u2 {\n            assert_eq!(\n                c, u2,\n                \"C should return uni2 when both are better \\\n                 (d0={d0} d1={d1} d2={d2}) at ({uni},{step},{pred},{tgt},{tgt2})\"\n            );\n            confirmed += 1;\n        }\n    }\n    assert!(confirmed > 0, \"row 25: never hit the both-better case\");\n}\n\n/// Recompute the C's three distortions (lsbit == 0 path) for classification.\nfn distortions(uni: i32, step: i32, pred: i32, tgt: i32, tgt2: i32) -> (i32, i32, i32, i32, i32) {\n    let mut u1 = uni.wrapping_add(1);\n    let mut u2 = uni.wrapping_sub(1);\n    if ((uni ^ u1) & !7) != 0 {\n        u1 = uni;\n    }\n    if ((uni ^ u2) & !7) != 0 {\n        u2 = uni;\n    }\n    let dist = |u: i32| -> i32 {\n        let mut diff = 2i32.wrapping_mul(u & 7).wrapping_add(1).wrapping_mul(step) / 8;\n        if (u & 8) != 0 {\n            diff = diff.wrapping_neg();\n        }\n        pred.wrapping_add(diff)\n    };\n    let (p0, p1, p2) = (dist(uni), dist(u1), dist(u2));\n    let abs = |x: i32| x ^ (x >> 31);\n    let mut d0 = abs(tgt.wrapping_sub(p0));\n    let mut d1 = abs(tgt.wrapping_sub(p1));\n    let mut d2 = abs(tgt.wrapping_sub(p2));\n    d0 = d0.wrapping_add(abs(tgt2.wrapping_sub(p0)) >> 5);\n    d1 = d1.wrapping_add(abs(tgt2.wrapping_sub(p1)) >> 5);\n    d2 = d2.wrapping_add(abs(tgt2.wrapping_sub(p2)) >> 5);\n    (d0, d1, d2, u1, u2)\n}\n\n// -------------------------------------------------------------- row 26\n// All six args INT_MIN simultaneously.\n\n#[test]\nfn row26_all_args_int_min() {\n    let p = pair();\n    let c = unsafe { (p.c)(MIN, MIN, MIN, MIN, MIN, MIN) };\n    let r = unsafe { (p.rust)(MIN, MIN, MIN, MIN, MIN, MIN) };\n    assert_eq!(c, r, \"all-INT_MIN diverged: C={c:#x} Rust={r:#x}\");\n    // Every subset of args set to INT_MIN (2^6 combinations), others 0.\n    for mask in 0u32..64 {\n        let v = |bit: u32| if mask & (1 << bit) != 0 { MIN } else { 0 };\n        check(v(0), v(1), v(2), v(3), v(4), v(5));\n    }\n}\n\n// -------------------------------------------------------------- row 27\n// All six args INT_MAX simultaneously, plus every INT_MIN/INT_MAX subset.\n\n#[test]\nfn row27_all_args_int_max_and_extreme_cross_product() {\n    let p = pair();\n    let c = unsafe { (p.c)(MAX, MAX, MAX, MAX, MAX, MAX) };\n    let r = unsafe { (p.rust)(MAX, MAX, MAX, MAX, MAX, MAX) };\n    assert_eq!(c, r, \"all-INT_MAX diverged: C={c:#x} Rust={r:#x}\");\n\n    // Full cross-product of the extreme set over all six parameters.\n    const EX: [i32; 6] = [MIN, MIN + 1, -1, 0, 1, MAX];\n    for &a in &EX {\n        for &b in &EX {\n            for &cc in &EX {\n                for &d in &EX {\n                    for &e in &EX {\n                        for &f in &EX {\n                            check(a, b, cc, d, e, f);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------- generic boundaries\n\n/// Zero / oversized / one-past-range values for every parameter position,\n/// swept independently while the others are randomized.\n#[test]\nfn generic_per_parameter_boundary_sweep() {\n    const BOUNDS: [i32; 15] = [\n        MIN, MIN + 1, MIN + 2, -8, -7, -1, 0, 1, 2, 4, 5, 7, 8, MAX - 1, MAX,\n    ];\n    let mut rng = Rng::new(0xB0DE);\n    for pos in 0..6usize {\n        for &b in &BOUNDS {\n            for _ in 0..256 {\n                let mut a = [\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    rng.lsbit(),\n                ];\n                a[pos] = b;\n                check(a[0], a[1], a[2], a[3], a[4], a[5]);\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9413,"cache_read_input_tokens":34998,"cache_creation":{"ephemeral_5m_input_tokens":9413,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"70e28745-9584-46db-9f42-c57a7e624ccc","uuid":"b5d6e6d0-24aa-460c-8898-7f3af50681c9","timestamp":"2026-09-05T00:11:34.899Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MjKtAJYyCKiZH7SqdKrp9r","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-jLNDdo/translation/tests/error_paths.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"70e28745-9584-46db-9f42-c57a7e624ccc","uuid":"1ce51f2a-f1c8-4a18-9d67-0e26be0e2f4d","timestamp":"2026-09-05T00:11:34.909Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-jLNDdo/translation/tests/error_paths.rs","content":"//! Phase C — error-path differential tests, one test per ERRORS.md row.\n//!\n//! `encode_quant` has no rejection surface (no pointers, no error return, no\n//! assert, no range check), so these rows cover the implicit boundary/overflow\n//! conditions: exactly the inputs where a non-wrapping Rust translation would\n//! panic instead of returning the C's wrapping value. Each test asserts the two\n//! `.so`s return the SAME `int`, and that neither traps.\n\nmod common;\nuse common::{check, pair, Rng, LSBIT_MODES};\n\nconst MIN: i32 = i32::MIN;\nconst MAX: i32 = i32::MAX;\n\n// -------------------------------------------------------------- row 1\n// No pointer arguments exist, so there is no null-pointer rejection to\n// mirror. The degenerate all-zero call must still return a value.\n\n#[test]\nfn row01_no_pointer_args_all_zero_call() {\n    let p = pair();\n    let c = unsafe { (p.c)(0, 0, 0, 0, 0, 0) };\n    let r = unsafe { (p.rust)(0, 0, 0, 0, 0, 0) };\n    assert_eq!(c, r, \"all-zero call diverged\");\n    assert_eq!(c, 0, \"C returns 0 for the all-zero call\");\n}\n\n// -------------------------------------------------------------- row 2\n// uni = INT_MAX  =>  uni1 = uni + 1 overflows.\n\n#[test]\nfn row02_uni_int_max_plus_one_overflow() {\n    let mut rng = Rng::new(0x0002);\n    for lsbit in LSBIT_MODES {\n        for _ in 0..256 {\n            check(\n                MAX,\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                lsbit,\n            );\n        }\n    }\n    // Also the immediate neighbourhood.\n    for uni in (MAX - 4)..=MAX {\n        for lsbit in LSBIT_MODES {\n            check(uni, 1, 0, 0, 0, lsbit);\n            check(uni, MAX, MAX, MIN, MAX, lsbit);\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 3\n// uni = INT_MIN  =>  uni2 = uni - 1 overflows.\n\n#[test]\nfn row03_uni_int_min_minus_one_overflow() {\n    let mut rng = Rng::new(0x0003);\n    for lsbit in LSBIT_MODES {\n        for _ in 0..256 {\n            check(\n                MIN,\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                lsbit,\n            );\n        }\n    }\n    for uni in MIN..=(MIN + 4) {\n        for lsbit in LSBIT_MODES {\n            check(uni, 1, 0, 0, 0, lsbit);\n            check(uni, MIN, MIN, MAX, MIN, lsbit);\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 4\n// step = INT_MAX with uni&7 == 7  =>  (2*7+1)*step overflows.\n\n#[test]\nfn row04_step_int_max_multiply_overflow() {\n    let mut rng = Rng::new(0x0004);\n    for low3 in 0..8i32 {\n        for lsbit in LSBIT_MODES {\n            for _ in 0..64 {\n                let uni = (rng.range_i32(-1 << 16, 1 << 16) & !7) | low3;\n                check(\n                    uni,\n                    MAX,\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    lsbit,\n                );\n            }\n        }\n    }\n    // step just below INT_MAX too.\n    for step in (MAX - 3)..=MAX {\n        for uni in 0..16i32 {\n            check(uni, step, 0, 0, 0, 0);\n            check(uni, step, MAX, MIN, MAX, 4);\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 5\n// step = INT_MIN  =>  overflow AND diff = -diff on INT_MIN.\n\n#[test]\nfn row05_step_int_min_overflow_and_negate() {\n    let mut rng = Rng::new(0x0005);\n    for low4 in 0..16i32 {\n        for lsbit in LSBIT_MODES {\n            for _ in 0..64 {\n                let uni = (rng.range_i32(-1 << 16, 1 << 16) & !15) | low4;\n                check(\n                    uni,\n                    MIN,\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    lsbit,\n                );\n            }\n        }\n    }\n    for step in MIN..=(MIN + 3) {\n        for uni in 0..16i32 {\n            check(uni, step, 0, 0, 0, 0);\n            check(uni, step, MIN, MAX, MIN, 4);\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 6\n// diff == INT_MIN and uni&8 set  =>  unary minus on INT_MIN.\n// (2*(uni&7)+1)*step)/8 == INT_MIN requires the product to be <= 8*INT_MIN\n// after wrapping; sweep step values that produce exactly INT_MIN/near it.\n\n#[test]\nfn row06_negate_int_min_diff() {\n    // For uni&7 == 0 the multiplier is 1, so diff = step/8. Pick step so\n    // step/8 == INT_MIN is impossible; instead rely on the wrapped product.\n    // Sweep the whole (low4, step) space that can wrap to INT_MIN.\n    let mut rng = Rng::new(0x0006);\n    let mut saw_int_min_diff = false;\n    for _ in 0..200_000 {\n        let low4 = rng.range_i32(8, 15); // bit 3 set => negation happens\n        let uni = low4;\n        let step = rng.next_i32();\n        check(uni, step, 0, 0, 0, 0);\n\n        let m = 2i32.wrapping_mul(uni & 7).wrapping_add(1);\n        let diff = m.wrapping_mul(step) / 8;\n        if diff == MIN {\n            saw_int_min_diff = true;\n            // Hammer this exact case with many pred/tgt/tgt2 combinations.\n            for pred in [MIN, -1, 0, 1, MAX] {\n                for tgt in [MIN, 0, MAX] {\n                    for tgt2 in [MIN, 0, MAX] {\n                        for lsbit in LSBIT_MODES {\n                            check(uni, step, pred, tgt, tgt2, lsbit);\n                        }\n                    }\n                }\n            }\n        }\n    }\n    // Directly construct one: multiplier 1 (uni&7==0), bit3 set (uni==8),\n    // step = INT_MIN gives diff = INT_MIN/8, not INT_MIN. Use multiplier 8?\n    // The multiplier is always odd, so the exact INT_MIN diff is reachable\n    // only via wrapping; assert we found it during the sweep.\n    assert!(\n        saw_int_min_diff,\n        \"row 6: never produced diff == INT_MIN to negate\"\n    );\n}\n\n// -------------------------------------------------------------- row 7\n// pred + diff overflows.\n\n#[test]\nfn row07_pred_plus_diff_overflow() {\n    let mut rng = Rng::new(0x0007);\n    for pred in [MIN, MIN + 1, MIN + 7, -1, 0, 1, MAX - 7, MAX - 1, MAX] {\n        for lsbit in LSBIT_MODES {\n            for _ in 0..128 {\n                check(\n                    rng.interesting_i32(),\n                    rng.next_i32(),\n                    pred,\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    lsbit,\n                );\n            }\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 8\n// tgt - p0 overflows (tgt = INT_MAX with p0 < 0, and the mirror).\n\n#[test]\nfn row08_tgt_minus_p_overflow() {\n    let mut rng = Rng::new(0x0008);\n    for &tgt in &[MIN, MIN + 1, MAX - 1, MAX] {\n        for lsbit in LSBIT_MODES {\n            for _ in 0..128 {\n                // pred with the opposite sign so the subtraction overflows.\n                let pred = if tgt > 0 { MIN + rng.range_i32(0, 64) } else { MAX - rng.range_i32(0, 64) };\n                check(\n                    rng.interesting_i32(),\n                    rng.next_i32(),\n                    pred,\n                    tgt,\n                    rng.interesting_i32(),\n                    lsbit,\n                );\n            }\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 9\n// tgt2 - p0 overflows.\n\n#[test]\nfn row09_tgt2_minus_p_overflow() {\n    let mut rng = Rng::new(0x0009);\n    for &tgt2 in &[MIN, MIN + 1, MAX - 1, MAX] {\n        for lsbit in LSBIT_MODES {\n            for _ in 0..128 {\n                let pred = if tgt2 > 0 { MIN + rng.range_i32(0, 64) } else { MAX - rng.range_i32(0, 64) };\n                check(\n                    rng.interesting_i32(),\n                    rng.next_i32(),\n                    pred,\n                    rng.interesting_i32(),\n                    tgt2,\n                    lsbit,\n                );\n            }\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 10\n// d0 ^ (d0 >> 31) where d0 == INT_MIN  =>  INT_MAX, not INT_MIN.\n// Sweep to guarantee we actually hit a d == INT_MIN.\n\n#[test]\nfn row10_xor_abs_of_int_min() {\n    let mut rng = Rng::new(0x000a);\n    let mut hits = 0usize;\n    for _ in 0..200_000 {\n        let uni = rng.range_i32(-16, 16);\n        let step = rng.next_i32();\n        let pred = rng.next_i32();\n        let tgt = rng.next_i32();\n        let tgt2 = rng.next_i32();\n        check(uni, step, pred, tgt, tgt2, 0);\n\n        // Recompute d0 to detect the INT_MIN case.\n        let m = 2i32.wrapping_mul(uni & 7).wrapping_add(1);\n        let mut diff = m.wrapping_mul(step) / 8;\n        if (uni & 8) != 0 {\n            diff = diff.wrapping_neg();\n        }\n        let p0 = pred.wrapping_add(diff);\n        if tgt.wrapping_sub(p0) == MIN {\n            hits += 1;\n            for lsbit in LSBIT_MODES {\n                check(uni, step, pred, tgt, tgt2, lsbit);\n            }\n        }\n    }\n    // Also construct it directly: tgt - p0 == INT_MIN when p0 == 0 and\n    // tgt == INT_MIN. uni&7 == 0 & step == 0 gives diff == 0, so p0 == pred.\n    for lsbit in LSBIT_MODES {\n        check(0, 0, 0, MIN, MIN, lsbit);\n        check(8, 0, 0, MIN, 0, lsbit);\n        check(0, 0, 0, 0, MIN, lsbit);\n    }\n    assert!(hits > 0, \"row 10: never produced d == INT_MIN via the sweep\");\n}\n\n// -------------------------------------------------------------- row 11\n// d3 >> 5 with d3 negative  =>  arithmetic shift.\n// d3 is xor-abs'd first, so it is negative only when it was INT_MIN... no:\n// d3 ^ (d3>>31) yields a non-negative value EXCEPT for INT_MIN -> INT_MAX.\n// So d3 >> 5 is negative only if d3 stayed negative, which cannot happen.\n// The row is still tested: assert the shift result matches for the whole\n// range including the INT_MIN edge, and separately cover negative >> in the\n// lsbit==4 dither path (row 15).\n\n#[test]\nfn row11_d3_shift_right_five_arithmetic() {\n    let mut rng = Rng::new(0x000b);\n    for _ in 0..100_000 {\n        // Force large |tgt2 - p| so the >>5 term is significant.\n        let pred = rng.range_i32(-1 << 28, 1 << 28);\n        let tgt2 = rng.range_i32(MIN, MAX);\n        check(\n            rng.range_i32(-32, 32),\n            rng.next_i32(),\n            pred,\n            rng.next_i32(),\n            tgt2,\n            rng.lsbit(),\n        );\n    }\n    // The exact INT_MIN -> INT_MAX >> 5 case.\n    for lsbit in LSBIT_MODES {\n        check(0, 0, 0, 0, MIN, lsbit);\n        check(0, 0, MAX, 0, MIN, lsbit);\n        check(0, 0, MIN, 0, MAX, lsbit);\n    }\n}\n\n// -------------------------------------------------------------- row 12\n// d0 += d3 >> 5 overflows.\n\n#[test]\nfn row12_penalty_add_overflow() {\n    let mut rng = Rng::new(0x000c);\n    let mut hits = 0usize;\n    for _ in 0..200_000 {\n        let uni = rng.range_i32(-16, 16);\n        let step = rng.next_i32();\n        let pred = rng.next_i32();\n        let tgt = rng.next_i32();\n        let tgt2 = rng.next_i32();\n        check(uni, step, pred, tgt, tgt2, rng.lsbit());\n\n        let m = 2i32.wrapping_mul(uni & 7).wrapping_add(1);\n        let mut diff = m.wrapping_mul(step) / 8;\n        if (uni & 8) != 0 {\n            diff = diff.wrapping_neg();\n        }\n        let p0 = pred.wrapping_add(diff);\n        let mut d0 = tgt.wrapping_sub(p0);\n        d0 ^= d0 >> 31;\n        let mut d3 = tgt2.wrapping_sub(p0);\n        d3 ^= d3 >> 31;\n        if d0.checked_add(d3 >> 5).is_none() {\n            hits += 1;\n            for lsbit in LSBIT_MODES {\n                check(uni, step, pred, tgt, tgt2, lsbit);\n            }\n        }\n    }\n    assert!(hits > 0, \"row 12: never triggered the penalty-add overflow\");\n}\n\n// -------------------------------------------------------------- row 13\n// ((2*(uni&7)+1)*step)/8 with a negative numerator: truncation toward zero.\n\n#[test]\nfn row13_division_truncates_toward_zero() {\n    // For every low-3-bit multiplier, sweep numerators whose remainder mod 8\n    // is nonzero and negative, so floor-division would differ from C's\n    // truncation.\n    for low3 in 0..8i32 {\n        let m = 2 * low3 + 1;\n        for r in 1..8i32 {\n            // step chosen so m*step == -(k*8 + r)\n            for k in 0..8i32 {\n                let target = -(k * 8 + r);\n                if target % m == 0 {\n                    let step = target / m;\n                    for bit3 in [0i32, 8] {\n                        for lsbit in LSBIT_MODES {\n                            check(low3 | bit3, step, 0, 0, 0, lsbit);\n                            check(low3 | bit3, step, 100, -100, 5000, lsbit);\n                        }\n                    }\n                }\n            }\n        }\n    }\n    // Broad negative-step sweep.\n    let mut rng = Rng::new(0x000d);\n    for _ in 0..100_000 {\n        let step = -rng.range_i32(1, 1 << 30);\n        check(\n            rng.range_i32(-64, 64),\n            step,\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.lsbit(),\n        );\n    }\n}\n\n// -------------------------------------------------------------- row 14\n// uni negative => uni & 7 / uni & 8 on the two's-complement pattern.\n\n#[test]\nfn row14_negative_uni_masks() {\n    for uni in -128..0i32 {\n        for lsbit in LSBIT_MODES {\n            for step in [-17i32, -1, 0, 1, 17, MAX, MIN] {\n                check(uni, step, 0, 0, 0, lsbit);\n                check(uni, step, -5, 9, -9999, lsbit);\n            }\n        }\n    }\n    let mut rng = Rng::new(0x000e);\n    for _ in 0..100_000 {\n        let uni = -rng.range_i32(1, MAX);\n        check(\n            uni,\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.lsbit(),\n        );\n    }\n}\n\n// -------------------------------------------------------------- row 15\n// uni >> 1, uni >> 2 with uni negative in the lsbit == 4 dither path.\n\n#[test]\nfn row15_lsbit4_negative_arithmetic_shift() {\n    for uni in -256..=0i32 {\n        for step in [-9i32, -1, 0, 1, 9, 64, MAX, MIN] {\n            check(uni, step, 0, 0, 0, 4);\n            check(uni, step, 77, -77, 123_456, 4);\n        }\n    }\n    // INT_MIN and INT_MAX in the dither path.\n    for &uni in &[MIN, MIN + 1, MIN + 2, MAX - 2, MAX - 1, MAX] {\n        for step in [0i32, 1, -1, MAX, MIN] {\n            check(uni, step, 0, 0, 0, 4);\n        }\n    }\n    let mut rng = Rng::new(0x000f);\n    for _ in 0..100_000 {\n        check(\n            -rng.range_i32(1, MAX),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            4,\n        );\n    }\n}\n\n// -------------------------------------------------------------- row 16\n// lsbit == 4 exactly takes the special branch (not the even branch).\n\n#[test]\nfn row16_lsbit_exactly_four() {\n    let mut rng = Rng::new(0x0010);\n    for _ in 0..20_000 {\n        check(\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            4,\n        );\n    }\n    // Prove 4 differs from its even neighbours somewhere (so the branch is\n    // genuinely distinct and both impls agree on the distinction).\n    let p = pair();\n    let mut differs = false;\n    let mut rng = Rng::new(0x1004);\n    for _ in 0..50_000 {\n        let (u, s, pr, t, t2) = (\n            rng.range_i32(-64, 64),\n            rng.range_i32(-64, 64),\n            rng.range_i32(-64, 64),\n            rng.range_i32(-64, 64),\n            rng.range_i32(-4096, 4096),\n        );\n        let a = unsafe { (p.c)(u, s, pr, t, t2, 4) };\n        let b = unsafe { (p.c)(u, s, pr, t, t2, 2) };\n        check(u, s, pr, t, t2, 4);\n        check(u, s, pr, t, t2, 2);\n        if a != b {\n            differs = true;\n        }\n    }\n    assert!(differs, \"lsbit==4 branch is never distinguishable from lsbit==2\");\n}\n\n// -------------------------------------------------------------- row 17\n// lsbit odd (and != 4), including negative odd and INT_MAX.\n\n#[test]\nfn row17_lsbit_odd_including_negative_and_int_max() {\n    let odds: Vec<i32> = (-11..=11i32)\n        .filter(|v| v % 2 != 0)\n        .chain([MAX, MIN + 1, 0x7FFF_FFFF, -0x7FFF_FFFF])\n        .collect();\n    let mut rng = Rng::new(0x0011);\n    for &lsbit in &odds {\n        assert!(lsbit & 1 != 0, \"{lsbit} must be odd\");\n        assert_ne!(lsbit, 4);\n        for _ in 0..512 {\n            check(\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                lsbit,\n            );\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 18\n// lsbit even, nonzero, != 4, including negative even and INT_MIN.\n\n#[test]\nfn row18_lsbit_even_nonzero_including_negative_and_int_min() {\n    let evens: Vec<i32> = (-12..=12i32)\n        .filter(|v| *v != 0 && *v != 4 && v % 2 == 0)\n        .chain([MIN, MAX - 1, -0x7FFF_FFFE, 0x7FFF_FFFE])\n        .collect();\n    let mut rng = Rng::new(0x0012);\n    for &lsbit in &evens {\n        assert_eq!(lsbit & 1, 0, \"{lsbit} must be even\");\n        assert_ne!(lsbit, 0);\n        assert_ne!(lsbit, 4);\n        for _ in 0..512 {\n            check(\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                rng.interesting_i32(),\n                lsbit,\n            );\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 19\n// lsbit == 0 skips the whole conditioning block.\n\n#[test]\nfn row19_lsbit_zero_skips_block() {\n    let mut rng = Rng::new(0x0013);\n    for _ in 0..50_000 {\n        check(\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            0,\n        );\n    }\n}\n\n// -------------------------------------------------------------- row 20\n// Out-of-enum-range lsbit: INT_MAX (odd) and INT_MIN (even). `lsbit` is a\n// plain C int, so any 32-bit value is a real input the C handles; assert the\n// Rust classifies them into the same branch.\n\n#[test]\nfn row20_lsbit_out_of_range_extremes() {\n    let p = pair();\n    let mut rng = Rng::new(0x0014);\n    for _ in 0..20_000 {\n        let (u, s, pr, t, t2) = (\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n        );\n        for &lsbit in &[MIN, MIN + 1, MAX, MAX - 1, -1, -2, 5, 6, 100, 101] {\n            check(u, s, pr, t, t2, lsbit);\n        }\n        // INT_MAX is odd => must behave like lsbit = 1.\n        let a = unsafe { (p.c)(u, s, pr, t, t2, MAX) };\n        let b = unsafe { (p.c)(u, s, pr, t, t2, 1) };\n        assert_eq!(a, b, \"C: INT_MAX lsbit should act like 1\");\n        let ar = unsafe { (p.rust)(u, s, pr, t, t2, MAX) };\n        assert_eq!(a, ar, \"Rust diverged for lsbit = INT_MAX\");\n        // INT_MIN is even and != 4 => must behave like lsbit = 2.\n        let c = unsafe { (p.c)(u, s, pr, t, t2, MIN) };\n        let d = unsafe { (p.c)(u, s, pr, t, t2, 2) };\n        assert_eq!(c, d, \"C: INT_MIN lsbit should act like 2\");\n        let cr = unsafe { (p.rust)(u, s, pr, t, t2, MIN) };\n        assert_eq!(c, cr, \"Rust diverged for lsbit = INT_MIN\");\n    }\n}\n\n// -------------------------------------------------------------- row 21\n// uni&7 == 7 => uni1 clamped back to uni.\n\n#[test]\nfn row21_uni1_clamped_at_group_top() {\n    let mut rng = Rng::new(0x0015);\n    for _ in 0..50_000 {\n        let uni = (rng.next_i32() & !7) | 7;\n        check(\n            uni,\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.lsbit(),\n        );\n    }\n    // Including the INT_MAX group top (…0x7FFFFFFF has low3 == 7).\n    for lsbit in LSBIT_MODES {\n        check(MAX, 1, 0, 0, 0, lsbit);\n        check(MAX, MAX, MAX, MIN, MAX, lsbit);\n        check(-1, 1, 0, 0, 0, lsbit); // -1 & 7 == 7\n    }\n}\n\n// -------------------------------------------------------------- row 22\n// uni&7 == 0 => uni2 clamped back to uni.\n\n#[test]\nfn row22_uni2_clamped_at_group_bottom() {\n    let mut rng = Rng::new(0x0016);\n    for _ in 0..50_000 {\n        let uni = rng.next_i32() & !7;\n        check(\n            uni,\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.next_i32(),\n            rng.lsbit(),\n        );\n    }\n    // Including the INT_MIN group bottom (0x80000000 has low3 == 0).\n    for lsbit in LSBIT_MODES {\n        check(MIN, 1, 0, 0, 0, lsbit);\n        check(MIN, MIN, MIN, MAX, MIN, lsbit);\n        check(0, 1, 0, 0, 0, lsbit);\n    }\n}\n\n// -------------------------------------------------------------- row 23\n// step == 0 => all diffs zero, everything ties.\n\n#[test]\nfn row23_step_zero_no_candidate_wins() {\n    let mut rng = Rng::new(0x0017);\n    for _ in 0..50_000 {\n        check(\n            rng.interesting_i32(),\n            0,\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.interesting_i32(),\n            rng.lsbit(),\n        );\n    }\n    // With step == 0 the C must return the *conditioned* uni unchanged.\n    let p = pair();\n    for uni in -64..=64i32 {\n        for lsbit in LSBIT_MODES {\n            let c = unsafe { (p.c)(uni, 0, 7, -7, 999, lsbit) };\n            let r = unsafe { (p.rust)(uni, 0, 7, -7, 999, lsbit) };\n            assert_eq!(c, r, \"step==0 diverged for uni={uni} lsbit={lsbit}\");\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 24\n// Tie: d1 == d0 and d2 == d0 => strict `<` keeps uni.\n\n#[test]\nfn row24_strict_less_than_keeps_uni_on_ties() {\n    // step == 0 forces p0 == p1 == p2, hence exact ties.\n    let mut rng = Rng::new(0x0018);\n    for _ in 0..20_000 {\n        let uni = rng.range_i32(-1024, 1024);\n        let pred = rng.range_i32(-1024, 1024);\n        for lsbit in LSBIT_MODES {\n            check(uni, 0, pred, pred, pred, lsbit);\n        }\n    }\n    // Small |step| that truncates to 0 for every multiplier also ties.\n    for uni in -64..=64i32 {\n        for step in 1..8i32 {\n            for lsbit in LSBIT_MODES {\n                check(uni, step, 0, 0, 0, lsbit);\n            }\n        }\n    }\n}\n\n// -------------------------------------------------------------- row 25\n// Both d1 < d0 and d2 < d0 => the SECOND `if` wins (returns uni2), even\n// when d1 < d2. This is the C quirk; assert the Rust reproduces it.\n\n#[test]\nfn row25_both_better_second_if_overwrites() {\n    let p = pair();\n    let mut rng = Rng::new(0x0019);\n    let mut confirmed = 0usize;\n    for _ in 0..300_000 {\n        let uni = rng.range_i32(-64, 64);\n        let step = rng.range_i32(1, 8192);\n        let pred = rng.range_i32(-8192, 8192);\n        let tgt = rng.range_i32(-8192, 8192);\n        let tgt2 = rng.range_i32(-8192, 8192);\n        let c = unsafe { (p.c)(uni, step, pred, tgt, tgt2, 0) };\n        let r = unsafe { (p.rust)(uni, step, pred, tgt, tgt2, 0) };\n        assert_eq!(c, r, \"diverged at ({uni},{step},{pred},{tgt},{tgt2},0)\");\n\n        // Recompute d0/d1/d2 to find the \"both better\" cases.\n        let (d0, d1, d2, u1, u2) = distortions(uni, step, pred, tgt, tgt2);\n        if d1 < d0 && d2 < d0 && u1 != u2 {\n            assert_eq!(\n                c, u2,\n                \"C should return uni2 when both are better \\\n                 (d0={d0} d1={d1} d2={d2}) at ({uni},{step},{pred},{tgt},{tgt2})\"\n            );\n            confirmed += 1;\n        }\n    }\n    assert!(confirmed > 0, \"row 25: never hit the both-better case\");\n}\n\n/// Recompute the C's three distortions (lsbit == 0 path) for classification.\nfn distortions(uni: i32, step: i32, pred: i32, tgt: i32, tgt2: i32) -> (i32, i32, i32, i32, i32) {\n    let mut u1 = uni.wrapping_add(1);\n    let mut u2 = uni.wrapping_sub(1);\n    if ((uni ^ u1) & !7) != 0 {\n        u1 = uni;\n    }\n    if ((uni ^ u2) & !7) != 0 {\n        u2 = uni;\n    }\n    let dist = |u: i32| -> i32 {\n        let mut diff = 2i32.wrapping_mul(u & 7).wrapping_add(1).wrapping_mul(step) / 8;\n        if (u & 8) != 0 {\n            diff = diff.wrapping_neg();\n        }\n        pred.wrapping_add(diff)\n    };\n    let (p0, p1, p2) = (dist(uni), dist(u1), dist(u2));\n    let abs = |x: i32| x ^ (x >> 31);\n    let mut d0 = abs(tgt.wrapping_sub(p0));\n    let mut d1 = abs(tgt.wrapping_sub(p1));\n    let mut d2 = abs(tgt.wrapping_sub(p2));\n    d0 = d0.wrapping_add(abs(tgt2.wrapping_sub(p0)) >> 5);\n    d1 = d1.wrapping_add(abs(tgt2.wrapping_sub(p1)) >> 5);\n    d2 = d2.wrapping_add(abs(tgt2.wrapping_sub(p2)) >> 5);\n    (d0, d1, d2, u1, u2)\n}\n\n// -------------------------------------------------------------- row 26\n// All six args INT_MIN simultaneously.\n\n#[test]\nfn row26_all_args_int_min() {\n    let p = pair();\n    let c = unsafe { (p.c)(MIN, MIN, MIN, MIN, MIN, MIN) };\n    let r = unsafe { (p.rust)(MIN, MIN, MIN, MIN, MIN, MIN) };\n    assert_eq!(c, r, \"all-INT_MIN diverged: C={c:#x} Rust={r:#x}\");\n    // Every subset of args set to INT_MIN (2^6 combinations), others 0.\n    for mask in 0u32..64 {\n        let v = |bit: u32| if mask & (1 << bit) != 0 { MIN } else { 0 };\n        check(v(0), v(1), v(2), v(3), v(4), v(5));\n    }\n}\n\n// -------------------------------------------------------------- row 27\n// All six args INT_MAX simultaneously, plus every INT_MIN/INT_MAX subset.\n\n#[test]\nfn row27_all_args_int_max_and_extreme_cross_product() {\n    let p = pair();\n    let c = unsafe { (p.c)(MAX, MAX, MAX, MAX, MAX, MAX) };\n    let r = unsafe { (p.rust)(MAX, MAX, MAX, MAX, MAX, MAX) };\n    assert_eq!(c, r, \"all-INT_MAX diverged: C={c:#x} Rust={r:#x}\");\n\n    // Full cross-product of the extreme set over all six parameters.\n    const EX: [i32; 6] = [MIN, MIN + 1, -1, 0, 1, MAX];\n    for &a in &EX {\n        for &b in &EX {\n            for &cc in &EX {\n                for &d in &EX {\n                    for &e in &EX {\n                        for &f in &EX {\n                            check(a, b, cc, d, e, f);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------- generic boundaries\n\n/// Zero / oversized / one-past-range values for every parameter position,\n/// swept independently while the others are randomized.\n#[test]\nfn generic_per_parameter_boundary_sweep() {\n    const BOUNDS: [i32; 15] = [\n        MIN, MIN + 1, MIN + 2, -8, -7, -1, 0, 1, 2, 4, 5, 7, 8, MAX - 1, MAX,\n    ];\n    let mut rng = Rng::new(0xB0DE);\n    for pos in 0..6usize {\n        for &b in &BOUNDS {\n            for _ in 0..256 {\n                let mut a = [\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    rng.interesting_i32(),\n                    rng.lsbit(),\n                ];\n                a[pos] = b;\n                check(a[0], a[1], a[2], a[3], a[4], a[5]);\n            }\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
