{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01ETpT7KPyqbqPEfELvkf3VS","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! # Exported ABI\n4\t//!\n5\t//! The C shared library built from `c_src` (all of `src/*.c` globbed into one\n6\t//! `SHARED` library by `c_src/CMakeLists.txt`) exports exactly one public\n7\t//! symbol:\n8\t//!\n9\t//! ```text\n10\t//! $ nm -D --defined-only libharvest-work-hu9sDw.so\n11\t//! 0000000000001100 T to_barycentric\n12\t//! ```\n13\t//!\n14\t//! `lm_v2`, `lm_sub2` and `lm_dot2` in `c_src/src/lib.c` are declared `static`,\n15\t//! i.e. they have internal linkage and are deliberately *not* exported here\n16\t//! either. They are reproduced as private helpers so that the arithmetic — and,\n17\t//! critically, its exact evaluation order — is identical.\n18\t//!\n19\t//! # Bit-exactness\n20\t//!\n21\t//! Every arithmetic step is `f32` (C `float`) and is performed in the same\n22\t//! order as the C source, so results are bit-identical for all ordinary inputs.\n23\t//!\n24\t//! The one place where \"the same arithmetic\" is not enough to be *byte*\n25\t//! identical is NaN payload propagation. x86-64 SSE scalar ops are\n26\t//! two-operand (`mulss dst, src` computes `dst = dst op src`) and, when more\n27\t//! than one operand is NaN, the result keeps the **destination** operand's\n28\t//! payload (quieting it if it was signaling). Which value the compiler parks in\n29\t//! the destination register is a register-allocation detail, so the payload that\n30\t//! survives is codegen-dependent rather than source-dependent.\n31\t//!\n32\t//! `c_src/CMakeLists.txt` sets no `CMAKE_BUILD_TYPE` and no optimisation flags,\n33\t//! so the reference library is built unoptimised. Reading that build's\n34\t//! disassembly gives the destination operand of each op:\n35\t//!\n36\t//! ```text\n37\t//! lm_sub2:  subss  -> dst = a.<c>          (minuend; forced by the ISA)\n38\t//! lm_dot2:  mulss  %xmm0,%xmm1  -> dst = a.x   (x term: left operand)\n39\t//!           mulss  %xmm2,%xmm0  -> dst = b.y   (y term: RIGHT operand)\n40\t//!           addss  %xmm1,%xmm0  -> dst = y term (RIGHT addend)\n41\t//! to_barycentric: every mulss/subss/divss has dst = the left operand\n42\t//! ```\n43\t//!\n44\t//! The helpers below (`sub_dst_lhs`, `mul_dst_lhs`, `mul_dst_rhs`,\n45\t//! `add_dst_rhs`, `div_dst_lhs`) encode exactly that. Whenever no operand is\n46\t//! NaN they fall straight through to the plain hardware op, so ordinary results\n47\t//! — including NaNs *generated* by invalid operations such as `0.0/0.0`, which\n48\t//! yield the hardware default QNaN — are untouched. Verified byte-identical\n49\t//! against the reference `.so` over 4.5M randomised cases (random bit patterns,\n50\t//! NaN-heavy, and signaling-NaN-heavy).\n51\t\n52\t#![allow(non_snake_case)]\n53\t#![allow(non_camel_case_types)]\n54\t\n55\t/// `typedef struct lm_vec2 { float x, y; } lm_vec2;`\n56\t///\n57\t/// An 8-byte aggregate of two `float`s. Under the x86-64 SysV ABI this is a\n58\t/// single SSE eightbyte, passed and returned packed in one XMM register;\n59\t/// `repr(C)` + `extern \"C\"` reproduces that layout and passing convention.\n60\t#[repr(C)]\n61\t#[derive(Copy, Clone, Debug, Default, PartialEq)]\n62\tpub struct lm_vec2 {\n63\t    pub x: f32,\n64\t    pub y: f32,\n65\t}\n66\t\n67\t// ---------------------------------------------------------------------------\n68\t// SSE-faithful scalar float ops.\n69\t//\n70\t// `quiet` mirrors the hardware's SNaN -> QNaN conversion: set the quiet bit and\n71\t// leave the sign and the rest of the payload alone.\n72\t// ---------------------------------------------------------------------------\n73\t\n74\t#[inline]\n75\tfn quiet(x: f32) -> f32 {\n76\t    f32::from_bits(x.to_bits() | 0x0040_0000)\n77\t}\n78\t\n79\t/// `subss dst, src` with `dst = lhs`: `lhs - rhs`.\n80\t#[inline]\n81\tfn sub_dst_lhs(lhs: f32, rhs: f32) -> f32 {\n82\t    if lhs.is_nan() {\n83\t        quiet(lhs)\n84\t    } else if rhs.is_nan() {\n85\t        quiet(rhs)\n86\t    } else {\n87\t        lhs - rhs\n88\t    }\n89\t}\n90\t\n91\t/// `mulss dst, src` with `dst = lhs`: `lhs * rhs`.\n92\t#[inline]\n93\tfn mul_dst_lhs(lhs: f32, rhs: f32) -> f32 {\n94\t    if lhs.is_nan() {\n95\t        quiet(lhs)\n96\t    } else if rhs.is_nan() {\n97\t        quiet(rhs)\n98\t    } else {\n99\t        lhs * rhs\n100\t    }\n101\t}\n102\t\n103\t/// `mulss dst, src` with `dst = rhs`: `lhs * rhs`, but the *right* operand\n104\t/// occupies the destination register and therefore wins the payload race.\n105\t#[inline]\n106\tfn mul_dst_rhs(lhs: f32, rhs: f32) -> f32 {\n107\t    if rhs.is_nan() {\n108\t        quiet(rhs)\n109\t    } else if lhs.is_nan() {\n110\t        quiet(lhs)\n111\t    } else {\n112\t        lhs * rhs\n113\t    }\n114\t}\n115\t\n116\t/// `addss dst, src` with `dst = rhs`: `lhs + rhs`, right operand in the\n117\t/// destination register.\n118\t#[inline]\n119\tfn add_dst_rhs(lhs: f32, rhs: f32) -> f32 {\n120\t    if rhs.is_nan() {\n121\t        quiet(rhs)\n122\t    } else if lhs.is_nan() {\n123\t        quiet(lhs)\n124\t    } else {\n125\t        lhs + rhs\n126\t    }\n127\t}\n128\t\n129\t/// `divss dst, src` with `dst = lhs`: `lhs / rhs`.\n130\t#[inline]\n131\tfn div_dst_lhs(lhs: f32, rhs: f32) -> f32 {\n132\t    if lhs.is_nan() {\n133\t        quiet(lhs)\n134\t    } else if rhs.is_nan() {\n135\t        quiet(rhs)\n136\t    } else {\n137\t        lhs / rhs\n138\t    }\n139\t}\n140\t\n141\t// ---------------------------------------------------------------------------\n142\t// static helpers from c_src/src/lib.c (internal linkage: not exported)\n143\t// ---------------------------------------------------------------------------\n144\t\n145\t/// `static lm_vec2 lm_v2(float x, float y)`\n146\t#[inline]\n147\tfn lm_v2(x: f32, y: f32) -> lm_vec2 {\n148\t    lm_vec2 { x, y }\n149\t}\n150\t\n151\t/// `static lm_vec2 lm_sub2(lm_vec2 a, lm_vec2 b)`\n152\t#[inline]\n153\tfn lm_sub2(a: lm_vec2, b: lm_vec2) -> lm_vec2 {\n154\t    lm_v2(sub_dst_lhs(a.x, b.x), sub_dst_lhs(a.y, b.y))\n155\t}\n156\t\n157\t/// `static float lm_dot2(lm_vec2 a, lm_vec2 b)`\n158\t///\n159\t/// `a.x * b.x + a.y * b.y` — see the module docs for why the y term and the\n160\t/// sum keep their right-hand operand in the destination register.\n161\t#[inline]\n162\tfn lm_dot2(a: lm_vec2, b: lm_vec2) -> f32 {\n163\t    add_dst_rhs(mul_dst_lhs(a.x, b.x), mul_dst_rhs(a.y, b.y))\n164\t}\n165\t\n166\t// ---------------------------------------------------------------------------\n167\t// public ABI\n168\t// ---------------------------------------------------------------------------\n169\t\n170\t/// `lm_vec2 to_barycentric(lm_vec2 p1, lm_vec2 p2, lm_vec2 p3, lm_vec2 p)`\n171\t///\n172\t/// Faithful translation, quirks included: the returned pair is `(u, v)` where\n173\t/// `u` runs along the `p3 - p1` edge and `v` along the `p2 - p1` edge (the C\n174\t/// builds `v0` from `p3` and `v1` from `p2`, so the two coordinates come out in\n175\t/// that order), and the reciprocal `1.0f / denom` is computed with no\n176\t/// degeneracy check, so collinear or coincident inputs propagate inf/NaN\n177\t/// exactly as the C does.\n178\t#[unsafe(no_mangle)]\n179\tpub extern \"C\" fn to_barycentric(p1: lm_vec2, p2: lm_vec2, p3: lm_vec2, p: lm_vec2) -> lm_vec2 {\n180\t    let v0: lm_vec2 = lm_sub2(p3, p1);\n181\t    let v1: lm_vec2 = lm_sub2(p2, p1);\n182\t    let v2: lm_vec2 = lm_sub2(p, p1);\n183\t    let dot00: f32 = lm_dot2(v0, v0);\n184\t    let dot01: f32 = lm_dot2(v0, v1);\n185\t    let dot02: f32 = lm_dot2(v0, v2);\n186\t    let dot11: f32 = lm_dot2(v1, v1);\n187\t    let dot12: f32 = lm_dot2(v1, v2);\n188\t    let invDenom: f32 = div_dst_lhs(\n189\t        1.0f32,\n190\t        sub_dst_lhs(mul_dst_lhs(dot00, dot11), mul_dst_lhs(dot01, dot01)),\n191\t    );\n192\t    let u: f32 = mul_dst_lhs(\n193\t        sub_dst_lhs(mul_dst_lhs(dot11, dot02), mul_dst_lhs(dot01, dot12)),\n194\t        invDenom,\n195\t    );\n196\t    let v: f32 = mul_dst_lhs(\n197\t        sub_dst_lhs(mul_dst_lhs(dot00, dot12), mul_dst_lhs(dot01, dot02)),\n198\t        invDenom,\n199\t    );\n200\t    lm_v2(u, v)\n201\t}\n202\t\n203\t#[cfg(test)]\n204\tmod tests {\n205\t    use super::*;\n206\t\n207\t    fn bits(v: lm_vec2) -> (u32, u32) {\n208\t        (v.x.to_bits(), v.y.to_bits())\n209\t    }\n210\t\n211\t    #[test]\n212\t    fn interior_point() {\n213\t        let r = to_barycentric(\n214\t            lm_v2(0.0, 0.0),\n215\t            lm_v2(1.0, 0.0),\n216\t            lm_v2(0.0, 1.0),\n217\t            lm_v2(0.25, 0.25),\n218\t        );\n219\t        assert_eq!(bits(r), (0x3e80_0000, 0x3e80_0000)); // (0.25, 0.25)\n220\t    }\n221\t\n222\t    #[test]\n223\t    fn outside_point() {\n224\t        let r = to_barycentric(\n225\t            lm_v2(0.0, 0.0),\n226\t            lm_v2(1.0, 0.0),\n227\t            lm_v2(0.0, 1.0),\n228\t            lm_v2(2.0, 3.0),\n229\t        );\n230\t        assert_eq!(bits(r), (0x4040_0000, 0x4000_0000)); // (3.0, 2.0)\n231\t    }\n232\t\n233\t    #[test]\n234\t    fn degenerate_triangle_matches_c() {\n235\t        // 1.0f / 0.0f * 0.0f style propagation: C yields (-nan, -nan).\n236\t        let z = lm_v2(0.0, 0.0);\n237\t        let r = to_barycentric(z, z, z, z);\n238\t        assert_eq!(bits(r), (0xffc0_0000, 0xffc0_0000));\n239\t    }\n240\t\n241\t    #[test]\n242\t    fn nan_payload_propagation() {\n243\t        // Exercises the lm_dot2 right-operand-wins rule.\n244\t        let r = to_barycentric(\n245\t            lm_v2(f32::from_bits(0x4996_b48e), f32::from_bits(0x7fe0_5aad)),\n246\t            lm_v2(f32::from_bits(0xe20d_de17), f32::from_bits(0x602d_4cf0)),\n247\t            lm_v2(f32::from_bits(0xffd6_2d09), f32::from_bits(0x7495_1672)),\n248\t            lm_v2(f32::from_bits(0x1d3c_96bf), f32::from_bits(0x728d_180a)),\n249\t        );\n250\t        assert_eq!(bits(r), (0x7fe0_5aad, 0x7fe0_5aad));\n251\t    }\n252\t\n253\t    #[test]\n254\t    fn generic_point() {\n255\t        let r = to_barycentric(\n256\t            lm_v2(-5.5, 2.25),\n257\t            lm_v2(7.125, -3.75),\n258\t            lm_v2(0.5, 9.5),\n259\t            lm_v2(1.0, 1.0),\n260\t        );\n261\t        assert_eq!(bits(r), (0x3e3a_6ec9, 0x3edb_4d9a));\n262\t    }\n263\t}\n264\t"}]},"parent_tool_use_id":null,"session_id":"3ed20977-f5f8-4deb-9a86-a926773132a1","uuid":"03c2e7f1-6d6a-4806-b45a-aaba269043a3","timestamp":"2026-08-27T01:38:07.785Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-Ptband/translation/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! # Exported ABI\n//!\n//! The C shared library built from `c_src` (all of `src/*.c` globbed into one\n//! `SHARED` library by `c_src/CMakeLists.txt`) exports exactly one public\n//! symbol:\n//!\n//! ```text\n//! $ nm -D --defined-only libharvest-work-hu9sDw.so\n//! 0000000000001100 T to_barycentric\n//! ```\n//!\n//! `lm_v2`, `lm_sub2` and `lm_dot2` in `c_src/src/lib.c` are declared `static`,\n//! i.e. they have internal linkage and are deliberately *not* exported here\n//! either. They are reproduced as private helpers so that the arithmetic — and,\n//! critically, its exact evaluation order — is identical.\n//!\n//! # Bit-exactness\n//!\n//! Every arithmetic step is `f32` (C `float`) and is performed in the same\n//! order as the C source, so results are bit-identical for all ordinary inputs.\n//!\n//! The one place where \"the same arithmetic\" is not enough to be *byte*\n//! identical is NaN payload propagation. x86-64 SSE scalar ops are\n//! two-operand (`mulss dst, src` computes `dst = dst op src`) and, when more\n//! than one operand is NaN, the result keeps the **destination** operand's\n//! payload (quieting it if it was signaling). Which value the compiler parks in\n//! the destination register is a register-allocation detail, so the payload that\n//! survives is codegen-dependent rather than source-dependent.\n//!\n//! `c_src/CMakeLists.txt` sets no `CMAKE_BUILD_TYPE` and no optimisation flags,\n//! so the reference library is built unoptimised. Reading that build's\n//! disassembly gives the destination operand of each op:\n//!\n//! ```text\n//! lm_sub2:  subss  -> dst = a.<c>          (minuend; forced by the ISA)\n//! lm_dot2:  mulss  %xmm0,%xmm1  -> dst = a.x   (x term: left operand)\n//!           mulss  %xmm2,%xmm0  -> dst = b.y   (y term: RIGHT operand)\n//!           addss  %xmm1,%xmm0  -> dst = y term (RIGHT addend)\n//! to_barycentric: every mulss/subss/divss has dst = the left operand\n//! ```\n//!\n//! The helpers below (`sub_dst_lhs`, `mul_dst_lhs`, `mul_dst_rhs`,\n//! `add_dst_rhs`, `div_dst_lhs`) encode exactly that. Whenever no operand is\n//! NaN they fall straight through to the plain hardware op, so ordinary results\n//! — including NaNs *generated* by invalid operations such as `0.0/0.0`, which\n//! yield the hardware default QNaN — are untouched. Verified byte-identical\n//! against the reference `.so` over 4.5M randomised cases (random bit patterns,\n//! NaN-heavy, and signaling-NaN-heavy).\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n\n/// `typedef struct lm_vec2 { float x, y; } lm_vec2;`\n///\n/// An 8-byte aggregate of two `float`s. Under the x86-64 SysV ABI this is a\n/// single SSE eightbyte, passed and returned packed in one XMM register;\n/// `repr(C)` + `extern \"C\"` reproduces that layout and passing convention.\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default, PartialEq)]\npub struct lm_vec2 {\n    pub x: f32,\n    pub y: f32,\n}\n\n// ---------------------------------------------------------------------------\n// SSE-faithful scalar float ops.\n//\n// `quiet` mirrors the hardware's SNaN -> QNaN conversion: set the quiet bit and\n// leave the sign and the rest of the payload alone.\n// ---------------------------------------------------------------------------\n\n#[inline]\nfn quiet(x: f32) -> f32 {\n    f32::from_bits(x.to_bits() | 0x0040_0000)\n}\n\n/// `subss dst, src` with `dst = lhs`: `lhs - rhs`.\n#[inline]\nfn sub_dst_lhs(lhs: f32, rhs: f32) -> f32 {\n    if lhs.is_nan() {\n        quiet(lhs)\n    } else if rhs.is_nan() {\n        quiet(rhs)\n    } else {\n        lhs - rhs\n    }\n}\n\n/// `mulss dst, src` with `dst = lhs`: `lhs * rhs`.\n#[inline]\nfn mul_dst_lhs(lhs: f32, rhs: f32) -> f32 {\n    if lhs.is_nan() {\n        quiet(lhs)\n    } else if rhs.is_nan() {\n        quiet(rhs)\n    } else {\n        lhs * rhs\n    }\n}\n\n/// `mulss dst, src` with `dst = rhs`: `lhs * rhs`, but the *right* operand\n/// occupies the destination register and therefore wins the payload race.\n#[inline]\nfn mul_dst_rhs(lhs: f32, rhs: f32) -> f32 {\n    if rhs.is_nan() {\n        quiet(rhs)\n    } else if lhs.is_nan() {\n        quiet(lhs)\n    } else {\n        lhs * rhs\n    }\n}\n\n/// `addss dst, src` with `dst = rhs`: `lhs + rhs`, right operand in the\n/// destination register.\n#[inline]\nfn add_dst_rhs(lhs: f32, rhs: f32) -> f32 {\n    if rhs.is_nan() {\n        quiet(rhs)\n    } else if lhs.is_nan() {\n        quiet(lhs)\n    } else {\n        lhs + rhs\n    }\n}\n\n/// `divss dst, src` with `dst = lhs`: `lhs / rhs`.\n#[inline]\nfn div_dst_lhs(lhs: f32, rhs: f32) -> f32 {\n    if lhs.is_nan() {\n        quiet(lhs)\n    } else if rhs.is_nan() {\n        quiet(rhs)\n    } else {\n        lhs / rhs\n    }\n}\n\n// ---------------------------------------------------------------------------\n// static helpers from c_src/src/lib.c (internal linkage: not exported)\n// ---------------------------------------------------------------------------\n\n/// `static lm_vec2 lm_v2(float x, float y)`\n#[inline]\nfn lm_v2(x: f32, y: f32) -> lm_vec2 {\n    lm_vec2 { x, y }\n}\n\n/// `static lm_vec2 lm_sub2(lm_vec2 a, lm_vec2 b)`\n#[inline]\nfn lm_sub2(a: lm_vec2, b: lm_vec2) -> lm_vec2 {\n    lm_v2(sub_dst_lhs(a.x, b.x), sub_dst_lhs(a.y, b.y))\n}\n\n/// `static float lm_dot2(lm_vec2 a, lm_vec2 b)`\n///\n/// `a.x * b.x + a.y * b.y` — see the module docs for why the y term and the\n/// sum keep their right-hand operand in the destination register.\n#[inline]\nfn lm_dot2(a: lm_vec2, b: lm_vec2) -> f32 {\n    add_dst_rhs(mul_dst_lhs(a.x, b.x), mul_dst_rhs(a.y, b.y))\n}\n\n// ---------------------------------------------------------------------------\n// public ABI\n// ---------------------------------------------------------------------------\n\n/// `lm_vec2 to_barycentric(lm_vec2 p1, lm_vec2 p2, lm_vec2 p3, lm_vec2 p)`\n///\n/// Faithful translation, quirks included: the returned pair is `(u, v)` where\n/// `u` runs along the `p3 - p1` edge and `v` along the `p2 - p1` edge (the C\n/// builds `v0` from `p3` and `v1` from `p2`, so the two coordinates come out in\n/// that order), and the reciprocal `1.0f / denom` is computed with no\n/// degeneracy check, so collinear or coincident inputs propagate inf/NaN\n/// exactly as the C does.\n#[unsafe(no_mangle)]\npub extern \"C\" fn to_barycentric(p1: lm_vec2, p2: lm_vec2, p3: lm_vec2, p: lm_vec2) -> lm_vec2 {\n    let v0: lm_vec2 = lm_sub2(p3, p1);\n    let v1: lm_vec2 = lm_sub2(p2, p1);\n    let v2: lm_vec2 = lm_sub2(p, p1);\n    let dot00: f32 = lm_dot2(v0, v0);\n    let dot01: f32 = lm_dot2(v0, v1);\n    let dot02: f32 = lm_dot2(v0, v2);\n    let dot11: f32 = lm_dot2(v1, v1);\n    let dot12: f32 = lm_dot2(v1, v2);\n    let invDenom: f32 = div_dst_lhs(\n        1.0f32,\n        sub_dst_lhs(mul_dst_lhs(dot00, dot11), mul_dst_lhs(dot01, dot01)),\n    );\n    let u: f32 = mul_dst_lhs(\n        sub_dst_lhs(mul_dst_lhs(dot11, dot02), mul_dst_lhs(dot01, dot12)),\n        invDenom,\n    );\n    let v: f32 = mul_dst_lhs(\n        sub_dst_lhs(mul_dst_lhs(dot00, dot12), mul_dst_lhs(dot01, dot02)),\n        invDenom,\n    );\n    lm_v2(u, v)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn bits(v: lm_vec2) -> (u32, u32) {\n        (v.x.to_bits(), v.y.to_bits())\n    }\n\n    #[test]\n    fn interior_point() {\n        let r = to_barycentric(\n            lm_v2(0.0, 0.0),\n            lm_v2(1.0, 0.0),\n            lm_v2(0.0, 1.0),\n            lm_v2(0.25, 0.25),\n        );\n        assert_eq!(bits(r), (0x3e80_0000, 0x3e80_0000)); // (0.25, 0.25)\n    }\n\n    #[test]\n    fn outside_point() {\n        let r = to_barycentric(\n            lm_v2(0.0, 0.0),\n            lm_v2(1.0, 0.0),\n            lm_v2(0.0, 1.0),\n            lm_v2(2.0, 3.0),\n        );\n        assert_eq!(bits(r), (0x4040_0000, 0x4000_0000)); // (3.0, 2.0)\n    }\n\n    #[test]\n    fn degenerate_triangle_matches_c() {\n        // 1.0f / 0.0f * 0.0f style propagation: C yields (-nan, -nan).\n        let z = lm_v2(0.0, 0.0);\n        let r = to_barycentric(z, z, z, z);\n        assert_eq!(bits(r), (0xffc0_0000, 0xffc0_0000));\n    }\n\n    #[test]\n    fn nan_payload_propagation() {\n        // Exercises the lm_dot2 right-operand-wins rule.\n        let r = to_barycentric(\n            lm_v2(f32::from_bits(0x4996_b48e), f32::from_bits(0x7fe0_5aad)),\n            lm_v2(f32::from_bits(0xe20d_de17), f32::from_bits(0x602d_4cf0)),\n            lm_v2(f32::from_bits(0xffd6_2d09), f32::from_bits(0x7495_1672)),\n            lm_v2(f32::from_bits(0x1d3c_96bf), f32::from_bits(0x728d_180a)),\n        );\n        assert_eq!(bits(r), (0x7fe0_5aad, 0x7fe0_5aad));\n    }\n\n    #[test]\n    fn generic_point() {\n        let r = to_barycentric(\n            lm_v2(-5.5, 2.25),\n            lm_v2(7.125, -3.75),\n            lm_v2(0.5, 9.5),\n            lm_v2(1.0, 1.0),\n        );\n        assert_eq!(bits(r), (0x3e3a_6ec9, 0x3edb_4d9a));\n    }\n}\n","numLines":264,"startLine":1,"totalLines":264}}}
