. A row of \"CAUGHT\" for every mutant is what\n# makes \"all tests pass\" meaningful; without it, a suite that never fails is\n# indistinguishable from a suite that never checks anything.\n#\n# src/lib.rs is always restored from .verify/lib.rs.pristine, including on\n# interrupt.\nset -uo pipefail\ncd \"$(dirname \"$0\")\"\n\nPRISTINE=.verify/lib.rs.pristine\n[[ -f $PRISTINE ]] || { echo \"missing $PRISTINE\"; exit 1; }\n\nrestore() { cp \"$PRISTINE\" src/lib.rs; }\ntrap restore EXIT INT TERM\nrestore\n\nrun_tests() {\n  timeout 600 cargo test --offline -q --test phase_b_valid --test phase_c_errors \\\n    >\"$TMPDIR/mut.log\" 2>&1\n}\n\nmutate() { # <search> <replace>\n  python3 - \"$1\" \"$2\" <<'PY'\nimport sys\ns = open('src/lib.rs').read()\nold, new = sys.argv[1], sys.argv[2]\nif old not in s:\n    sys.exit(2)\nopen('src/lib.rs', 'w').write(s.replace(old, new, 1))\nPY\n}\n\ndeclare -a NAMES=() OLDS=() NEWS=()\nadd() { NAMES+=(\"$1\"); OLDS+=(\"$2\"); NEWS+=(\"$3\"); }\n\nadd \"M1 lm_dot2 y-term dst=left (payload)\" \\\n    'add_dst_rhs(mul_dst_lhs(a.x, b.x), mul_dst_rhs(a.y, b.y))' \\\n    'add_dst_rhs(mul_dst_lhs(a.x, b.x), mul_dst_lhs(a.y, b.y))'\n\nadd \"M2 lm_dot2 addss dst=left (payload)\" \\\n    'add_dst_rhs(mul_dst_lhs(a.x, b.x), mul_dst_rhs(a.y, b.y))' \\\n    'add_dst_lhs_MUT(mul_dst_lhs(a.x, b.x), mul_dst_rhs(a.y, b.y))'\n\nadd \"M3 lm_dot2 naive a*b+c*d\" \\\n    'add_dst_rhs(mul_dst_lhs(a.x, b.x), mul_dst_rhs(a.y, b.y))' \\\n    'a.x * b.x + a.y * b.y'\n\nadd \"M4 lm_sub2 naive subtraction\" \\\n    'lm_v2(sub_dst_lhs(a.x, b.x), sub_dst_lhs(a.y, b.y))' \\\n    'lm_v2(a.x - b.x, a.y - b.y)'\n\nadd \"M5 return (v,u) instead of (u,v)\" \\\n    '    lm_v2(u, v)\n}' \\\n    '    lm_v2(v, u)\n}'\n\nadd \"M6 swap v0/v1 (p2 <-> p3)\" \\\n    '    let v0: lm_vec2 = lm_sub2(p3, p1);\n    let v1: lm_vec2 = lm_sub2(p2, p1);' \\\n    '    let v0: lm_vec2 = lm_sub2(p2, p1);\n    let v1: lm_vec2 = lm_sub2(p3, p1);'\n\nadd \"M7 wrong quiet bit (0x0020_0000)\" \\\n    'f32::from_bits(x.to_bits() | 0x0040_0000)' \\\n    'f32::from_bits(x.to_bits() | 0x0020_0000)'\n\nadd \"M8 denominator mul dst=right\" \\\n    'sub_dst_lhs(mul_dst_lhs(dot00, dot11), mul_dst_lhs(dot01, dot01))' \\\n    'sub_dst_lhs(mul_dst_rhs(dot00, dot11), mul_dst_lhs(dot01, dot01))'\n\nadd \"M9 u-numerator operands commuted\" \\\n    'sub_dst_lhs(mul_dst_lhs(dot11, dot02), mul_dst_lhs(dot01, dot12))' \\\n    'sub_dst_lhs(mul_dst_lhs(dot02, dot11), mul_dst_lhs(dot12, dot01))'\n\nadd \"M10 divss dst=right (1.0/denom)\" \\\n    'div_dst_lhs(\n        1.0f32,' \\\n    'div_dst_rhs_MUT(\n        1.0f32,'\n\nadd \"M11 f64 intermediates (excess precision)\" \\\n    'add_dst_rhs(mul_dst_lhs(a.x, b.x), mul_dst_rhs(a.y, b.y))' \\\n    '((a.x as f64 * b.x as f64) + (a.y as f64 * b.y as f64)) as f32'\n\nadd \"M12 final multiply by invDenom dst=right\" \\\n    '    let u: f32 = mul_dst_lhs(\n        sub_dst_lhs(mul_dst_lhs(dot11, dot02), mul_dst_lhs(dot01, dot12)),\n        invDenom,\n    );' \\\n    '    let u: f32 = mul_dst_rhs(\n        sub_dst_lhs(mul_dst_lhs(dot11, dot02), mul_dst_lhs(dot01, dot12)),\n        invDenom,\n    );'\n\n# Helper fns some mutants reference; appended only when needed.\nHELPERS='\n#[inline]\nfn add_dst_lhs_MUT(lhs: f32, rhs: f32) -> f32 {\n    if lhs.is_nan() { quiet(lhs) } else if rhs.is_nan() { quiet(rhs) } else { lhs + rhs }\n}\n#[inline]\nfn div_dst_rhs_MUT(lhs: f32, rhs: f32) -> f32 {\n    if rhs.is_nan() { quiet(rhs) } else if lhs.is_nan() { quiet(lhs) } else { lhs / rhs }\n}\n'\n\ncaught=0\nsurvived=0\nskipped=0\nprintf '%-46s %s\\n' \"MUTANT\" \"RESULT\"\nprintf '%.0s-' {1..70}; echo\nfor i in \"${!NAMES[@]}\"; do\n  restore\n  if ! mutate \"${OLDS[$i]}\" \"${NEWS[$i]}\"; then\n    printf '%-46s %s\\n' \"${NAMES[$i]}\" \"SKIP (pattern not found)\"\n    skipped=$((skipped + 1))\n    continue\n  fi\n  if [[ \"${NEWS[$i]}\" == *_MUT* ]]; then\n    printf '%s' \"$HELPERS\" >> src/lib.rs\n  fi\n  if run_tests; then\n    printf '%-46s %s\\n' \"${NAMES[$i]}\" \"*** SURVIVED (suite is blind!) ***\"\n    survived=$((survived + 1))\n  else\n    n=$(grep -cE '^test .* FAILED|panicked' \"$TMPDIR/mut.log\" 2>/dev/null || echo 0)\n    printf '%-46s %s\\n' \"${NAMES[$i]}\" \"CAUGHT\"\n    caught=$((caught + 1))\n  fi\ndone\nrestore\n\nprintf '%.0s-' {1..70}; echo\necho \"caught=$caught survived=$survived skipped=$skipped\"\n[[ $survived -eq 0 && $skipped -eq 0 ]] || exit 1\n","userModified":false}}
