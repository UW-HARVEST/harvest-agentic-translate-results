d(2) };\n        i = i.wrapping_add(1);\n    }\n}\n","structuredPatch":[{"oldStart":259,"oldLines":7,"newStart":259,"newLines":7,"lines":[" ","         // NaN in either operand makes this false, selecting the `else` branch,","         // exactly as C's `<` does.","-        if s0 <= s1 {","+        if s0 < s1 {","             let dx2: f32 = s0;","             let dy2: f32 = s1;","             let dxy: f32 = s2;"]}],"userModified":false,"replaceAll":false}}
