      *dest.add(0) = fsub(dx2, lambda);\n                *dest.add(1) = dxy;\n            }\n        } else {\n            let dy2: f32 = s0;\n            let dx2: f32 = s1;\n            let dxy: f32 = s2;\n\n            let lambda: f32 = lambda_of(dx2, dy2, dxy);\n\n            unsafe {\n                *dest.add(0) = dxy;\n                *dest.add(1) = fsub(dx2, lambda);\n            }\n        }\n\n        src = unsafe { src.add(3) };\n        dest = unsafe { dest.add(2) };\n        i = i.wrapping_add(1);\n    }\n}\n","numLines":291,"startLine":1,"totalLines":291}}}
