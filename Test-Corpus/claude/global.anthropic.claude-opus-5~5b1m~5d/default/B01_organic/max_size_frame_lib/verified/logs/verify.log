  echo \"  SKIP (pattern missing)                     | $desc\"; return\n  fi\n  local det=no\n  timeout 600 cargo test          >/dev/null 2>&1 || det=yes\n  timeout 600 cargo test --release >/dev/null 2>&1 || det=yes\n  if [ \"$det\" = no ]; then\n    echo \"  SURVIVED as expected (equivalent)          | $desc\"\n  else\n    echo \"  *** FALSE POSITIVE *** (suite too strict)  | $desc\"\n    SURVIVORS+=(\"FALSE POSITIVE: $desc\"); FAILURES=$((FAILURES+1))\n  fi\n  restore\n}\n\necho \"=== baseline must PASS in both profiles ===\"''')\nopen(p,'w').write(s)\nPY\ntimeout 600 ./mutation_check.sh 2>&1 | tail -22","description":"Add equivalent-mutant checks and fix M22 pattern"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1368,"cache_read_input_tokens":92182,"cache_creation":{"ephemeral_5m_input_tokens":1368,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8140a92a-58e2-478c-b15c-f6f217d7aa13","uuid":"8f069abb-58ba-4b44-a3bd-d5aa4f0f9eea","timestamp":"2026-08-26T23:34:23.392Z"}
