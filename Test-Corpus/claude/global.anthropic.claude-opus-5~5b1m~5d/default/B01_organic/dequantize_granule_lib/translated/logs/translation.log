* ---- targeted: every bitalloc value 0..255, single active band ---- */","+    int skipped = 0;","     for (int b = 0; b <= 255; b++) {","-        for (int i = 0; i < 64; i++) { ba[i] = (uint8_t)b; sc[i] = (uint8_t)i; }","+        long long n4 = (b >= 17) ? 4LL * (long long)(int)nbits_of(b) : 4LL * 16;","+        if (n4 >= 2147483647LL) { skipped++; continue; }  /* C overflows pos -> UB */","+        memset(ba, 0, sizeof ba);","+        ba[0] = (uint8_t)b;","+        ba[1] = (uint8_t)b;","+        for (int i = 0; i < 64; i++) sc[i] = (uint8_t)i;","         for (size_t i = 0; i < SCI_PAD; i++) tail[i] = (uint8_t)i;","-        for (int gsi = 0; gsi < 4; gsi++) {","+        unsigned nb = (b >= 17) ? nbits_of(b) : 16;","+        int big_limit = (nb / 8u < BUF_N / 2u) ? (int)nb + 8 : 64;","+        for (int gsi = 0; gsi < (int)(sizeof gs_tab / sizeof *gs_tab); gsi++) {","             int gs = gs_tab[gsi];","-            run_case(fa, fb, gs, 2, 1, ba, sc, tail, SCI_PAD, 0, 1 << 16, \"ba-sweep\");","-            run_case(fa, fb, gs, 2, 1, ba, sc, tail, SCI_PAD, 5, 7, \"ba-sweep-tight\");","+            run_case(fa, fb, gs, 1, 1, ba, sc, tail, SCI_PAD, 0, big_limit, \"ba-long-read\");","+            run_case(fa, fb, gs, 1, 1, ba, sc, tail, SCI_PAD, 3, 7, \"ba-tight\");","             run_case(fa, fb, gs, 0, 0, ba, sc, tail, SCI_PAD, 3, 1000, \"zero-bands\");","         }","     }","-    /* pos alignment sweep */","-    for (int i = 0; i < 64; i++) { ba[i] = (uint8_t)(1 + (i % 17)); sc[i] = 0; }","+    printf(\"skipped %d bitalloc values that overflow bs->pos in the C code\\n\", skipped);","+","+    /* ---- pos/limit alignment sweep over all ba<17 widths ---- */","+    for (int i = 0; i < 64; i++) { ba[i] = (uint8_t)(1 + (i % 16)); sc[i] = 0; }","     for (size_t i = 0; i < SCI_PAD; i++) tail[i] = 0;","-    for (int p = 0; p < 64; p++)","-        for (int l = 0; l < 96; l++)","+    for (int p = -16; p < 64; p++)","+        for (int l = -8; l < 96; l++)","             run_case(fa, fb, 12, 4, 2, ba, sc, tail, SCI_PAD, p, p + l, \"align\");"," ","+    /* ---- every single ba width in isolation, all pos alignments ---- */","+    for (int w = 1; w <= 16; w++) {","+        memset(ba, 0, sizeof ba);","+        ba[0] = (uint8_t)w; ba[1] = (uint8_t)w;","+        for (int p = 0; p < 8; p++)","+            for (int gs = 0; gs <= 34; gs++)","+                run_case(fa, fb, gs, 1, 1, ba, sc, tail, SCI_PAD, p, p + 8 * (gs + 2) * w, \"width\");","+    }","+","     printf(\"cases=%d failures=%d\\n\", cases, failures);","     return failures ? 1 : 0;"," }"]}],"originalFile":"/* Differential test: C reference .so vs Rust .so, byte-exact comparison. */\n#define _GNU_SOURCE\n#include <dlfcn.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct {\n    const uint8_t *buf;\n    int pos, limit;\n} bs_t;\n\ntypedef struct {\n    float scf[3 * 64];\n    uint8_t total_bands, stereo_bands, bitalloc[64], scfcod[64];\n} L12_scale_info;\n\ntypedef int (*fn_t)(float *, bs_t *, L12_scale_info *, int);\n\n/* ---- deterministic PRNG ---- */\nstatic uint64_t rs;\nstatic uint32_t rnd(void) {\n    rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17;\n    return (uint32_t)(rs >> 32);\n}\n\n#define GRBUF_N   200000          /* floats */\n#define SCI_PAD   4096            /* bytes of slack after the struct */\n#define BUF_N     (1 << 20)\n#define BUF_PAD   4096\n\nstatic uint8_t bufmem[BUF_PAD + BUF_N + BUF_PAD];\n\nstatic float *grbuf_a, *grbuf_b;\nstatic uint8_t *sci_a, *sci_b;\n\nstatic int failures = 0, cases = 0;\n\nstatic void run_case(fn_t fa, fn_t fb, int group_size, int total_bands,\n                     int stereo_bands, const uint8_t *ba64, const uint8_t *scfcod64,\n                     const uint8_t *tail, size_t tail_n,\n                     int pos, int limit, const char *tag) {\n    size_t scisz = sizeof(L12_scale_info) + SCI_PAD;\n    /* init both sci copies identically (incl. padding, which the OOB reads hit) */\n    for (size_t i = 0; i < scisz; i++) sci_a[i] = (uint8_t)(rnd() & 0xFF);\n    memcpy(sci_b, sci_a, scisz);\n\n    L12_scale_info *sa = (L12_scale_info *)sci_a;\n    L12_scale_info *sb = (L12_scale_info *)sci_b;\n    sa->total_bands = (uint8_t)total_bands;\n    sa->stereo_bands = (uint8_t)stereo_bands;\n    memcpy(sa->bitalloc, ba64, 64);\n    memcpy(sa->scfcod, scfcod64, 64);\n    if (tail_n) memcpy(sci_a + sizeof(L12_scale_info), tail, tail_n);\n    memcpy(sci_b, sci_a, scisz);\n    (void)sb;\n\n    /* grbuf: identical random bytes (so untouched regions must stay equal) */\n    for (size_t i = 0; i < GRBUF_N; i++) ((uint32_t *)grbuf_a)[i] = rnd();\n    memcpy(grbuf_b, grbuf_a, GRBUF_N * 4);\n\n    bs_t bsa, bsb;\n    bsa.buf = bufmem + BUF_PAD;\n    bsa.pos = pos;\n    bsa.limit = limit;\n    bsb = bsa;\n\n    int ra = fa(grbuf_a, &bsa, (L12_scale_info *)sci_a, group_size);\n    int rb = fb(grbuf_b, &bsb, (L12_scale_info *)sci_b, group_size);\n\n    cases++;\n    int bad = 0;\n    if (ra != rb) { printf(\"[%s] return mismatch: C=%d RS=%d\\n\", tag, ra, rb); bad = 1; }\n    if (bsa.pos != bsb.pos || bsa.limit != bsb.limit) {\n        printf(\"[%s] bs mismatch: C pos=%d limit=%d  RS pos=%d limit=%d\\n\",\n               tag, bsa.pos, bsa.limit, bsb.pos, bsb.limit);\n        bad = 1;\n    }\n    if (memcmp(grbuf_a, grbuf_b, GRBUF_N * 4) != 0) {\n        for (size_t i = 0; i < GRBUF_N; i++) {\n            uint32_t x = ((uint32_t *)grbuf_a)[i], y = ((uint32_t *)grbuf_b)[i];\n            if (x != y) {\n                printf(\"[%s] grbuf[%zu] mismatch: C=%08x (%g) RS=%08x (%g)\\n\",\n                       tag, i, x, grbuf_a[i], y, grbuf_b[i]);\n                break;\n            }\n        }\n        bad = 1;\n    }\n    if (memcmp(sci_a, sci_b, scisz) != 0) { printf(\"[%s] sci mismatch\\n\", tag); bad = 1; }\n    if (bad) {\n        printf(\"   params: group_size=%d total_bands=%d pos=%d limit=%d\\n\",\n               group_size, total_bands, pos, limit);\n        if (++failures > 20) { printf(\"too many failures\\n\"); exit(1); }\n    }\n}\n\nint main(int argc, char **argv) {\n    if (argc < 3) { fprintf(stderr, \"usage: %s libC.so libRS.so [iters]\\n\", argv[0]); return 2; }\n    long iters = (argc > 3) ? atol(argv[3]) : 20000;\n\n    void *ha = dlopen(argv[1], RTLD_NOW);\n    if (!ha) { fprintf(stderr, \"dlopen A: %s\\n\", dlerror()); return 2; }\n    void *hb = dlopen(argv[2], RTLD_NOW);\n    if (!hb) { fprintf(stderr, \"dlopen B: %s\\n\", dlerror()); return 2; }\n    fn_t fa = (fn_t)dlsym(ha, \"dequantize_granule\");\n    fn_t fb = (fn_t)dlsym(hb, \"dequantize_granule\");\n    if (!fa || !fb) { fprintf(stderr, \"dlsym failed\\n\"); return 2; }\n\n    grbuf_a = malloc(GRBUF_N * 4);\n    grbuf_b = malloc(GRBUF_N * 4);\n    sci_a = malloc(sizeof(L12_scale_info) + SCI_PAD);\n    sci_b = malloc(sizeof(L12_scale_info) + SCI_PAD);\n\n    rs = 0x243F6A8885A308D3ULL;\n    for (size_t i = 0; i < sizeof bufmem; i++) bufmem[i] = (uint8_t)(rnd() & 0xFF);\n\n    static const int gs_tab[] = {0, 1, 2, 3, 4, 6, 8, 12, 18, 32, -1, -7, 5};\n    uint8_t ba[64], sc[64], tail[SCI_PAD];\n\n    for (long it = 0; it < iters; it++) {\n        int mode = (int)(rnd() % 6);\n        int group_size = gs_tab[rnd() % (sizeof gs_tab / sizeof *gs_tab)];\n        int total_bands, pos, limit;\n\n        switch (mode) {\n        case 0: /* typical layer-1/2 shapes, small allocations */\n            total_bands = (int)(rnd() % 33);\n            for (int i = 0; i < 64; i++) ba[i] = (uint8_t)(rnd() % 16);\n            pos = (int)(rnd() % 4096);\n            limit = pos + (int)(rnd() % 20000);\n            break;\n        case 1: /* grouped (ba >= 17) paths */\n            total_bands = (int)(rnd() % 33);\n            for (int i = 0; i < 64; i++) ba[i] = (uint8_t)(17 + rnd() % 5);\n            pos = (int)(rnd() % 4096);\n            limit = pos + (int)(rnd() % 20000);\n            break;\n        case 2: /* full 0..255 bit allocations, exercises masked shifts */\n            total_bands = (int)(rnd() % 33);\n            for (int i = 0; i < 64; i++) ba[i] = (uint8_t)(rnd() & 0xFF);\n            pos = (int)(rnd() % 4096);\n            limit = pos + (int)(rnd() % 4096);\n            break;\n        case 3: /* out-of-range total_bands -> OOB bitalloc reads */\n            total_bands = (int)(rnd() % 256);\n            for (int i = 0; i < 64; i++) ba[i] = (uint8_t)(rnd() % 20);\n            pos = (int)(rnd() % 1024);\n            limit = pos + (int)(rnd() % 8192);\n            break;\n        case 4: /* limit right at/around the read boundary */\n            total_bands = (int)(rnd() % 9);\n            for (int i = 0; i < 64; i++) ba[i] = (uint8_t)(rnd() % 18);\n            pos = (int)(rnd() % 64);\n            limit = pos + (int)(rnd() % 64);\n            break;\n        default: /* negative / weird pos & limit */\n            total_bands = (int)(rnd() % 17);\n            for (int i = 0; i < 64; i++) ba[i] = (uint8_t)(rnd() % 19);\n            pos = (int)(rnd() % 200) - 100;\n            limit = pos + (int)(rnd() % 300) - 100;\n            break;\n        }\n        for (int i = 0; i < 64; i++) sc[i] = (uint8_t)(rnd() & 0xFF);\n        for (size_t i = 0; i < SCI_PAD; i++) tail[i] = (uint8_t)(rnd() & 0xFF);\n\n        run_case(fa, fb, group_size, total_bands, (int)(rnd() & 0xFF), ba, sc,\n                 tail, SCI_PAD, pos, limit, \"fuzz\");\n    }\n\n    /* targeted edge cases */\n    for (int b = 0; b <= 255; b++) {\n        for (int i = 0; i < 64; i++) { ba[i] = (uint8_t)b; sc[i] = (uint8_t)i; }\n        for (size_t i = 0; i < SCI_PAD; i++) tail[i] = (uint8_t)i;\n        for (int gsi = 0; gsi < 4; gsi++) {\n            int gs = gs_tab[gsi];\n            run_case(fa, fb, gs, 2, 1, ba, sc, tail, SCI_PAD, 0, 1 << 16, \"ba-sweep\");\n            run_case(fa, fb, gs, 2, 1, ba, sc, tail, SCI_PAD, 5, 7, \"ba-sweep-tight\");\n            run_case(fa, fb, gs, 0, 0, ba, sc, tail, SCI_PAD, 3, 1000, \"zero-bands\");\n        }\n    }\n    /* pos alignment sweep */\n    for (int i = 0; i < 64; i++) { ba[i] = (uint8_t)(1 + (i % 17)); sc[i] = 0; }\n    for (size_t i = 0; i < SCI_PAD; i++) tail[i] = 0;\n    for (int p = 0; p < 64; p++)\n        for (int l = 0; l < 96; l++)\n            run_case(fa, fb, 12, 4, 2, ba, sc, tail, SCI_PAD, p, p + l, \"align\");\n\n    printf(\"cases=%d failures=%d\\n\", cases, failures);\n    return failures ? 1 : 0;\n}\n","userModified":false}}
