(bs: *mut bs_t, n: c_int) -> u32 {\n56\t    let mut cache: u32 = 0;\n57\t    // `bs->pos & 7`: bitwise and on the two's complement representation, so the\n58\t    // result is always in 0..=7 even for a negative `pos`.\n59\t    let s: u32 = ((*bs).pos & 7) as u32;\n60\t    // `int shl = n + s;`  -- `n` is converted to `unsigned` for the addition,\n61\t    // the (possibly wrapped) result is converted back to `int`.\n62\t    let mut shl: c_int = (n as u32).wrapping_add(s) as c_int;\n63\t    // `bs->buf + (bs->pos >> 3)`: `>>` on a signed int is an arithmetic shift.\n64\t    let mut p: *const u8 = (*bs).buf.wrapping_offset(((*bs).pos >> 3) as isize);\n65\t    (*bs).pos = (*bs).pos.wrapping_add(n);\n66\t    if (*bs).pos > (*bs).limit {\n67\t        return 0;\n68\t    }\n69\t    let mut next: u32 = (*p as u32) & (255u32 >> s);\n70\t    p = p.wrapping_offset(1);\n71\t    loop {\n72\t        shl = shl.wrapping_sub(8);\n73\t        if shl <= 0 {\n74\t            break;\n75\t        }\n76\t        cache |= next.wrapping_shl(shl as u32);\n77\t        next = *p as u32;\n78\t        p = p.wrapping_offset(1);\n79\t    }\n80\t    cache | next.wrapping_shr(shl.wrapping_neg() as u32)\n81\t}\n82\t\n83\t/// ```c\n84\t/// int dequantize_granule(float *grbuf, bs_t *bs, L12_scale_info *sci,\n85\t///                                   int group_size) {\n86\t///     int i, j, k, choff = 576;\n87\t///     for (j = 0; j < 4; j++) {\n88\t///         float *dst = grbuf + group_size * j;\n89\t///         for (i = 0; i < 2 * sci->total_bands; i++) {\n90\t///             int ba = sci->bitalloc[i];\n91\t///             if (ba != 0) {\n92\t///                 if (ba < 17) {\n93\t///                     int half = (1 << (ba - 1)) - 1;\n94\t///                     for (k = 0; k < group_size; k++) {\n95\t///                         dst[k] = (float)((int)get_bits(bs, ba) - half);\n96\t///                     }\n97\t///                 } else {\n98\t///                     unsigned mod = (2 << (ba - 17