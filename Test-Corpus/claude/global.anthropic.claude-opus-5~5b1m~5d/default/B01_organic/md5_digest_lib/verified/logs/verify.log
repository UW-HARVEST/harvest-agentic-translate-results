s([\n                *p,\n                *p.wrapping_add(1),\n                *p.wrapping_add(2),\n                *p.wrapping_add(3),\n            ]);\n            *out.wrapping_add($idx) = (v >> $shift) as tflac_u8;\n        }};\n    }"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":858,"cache_read_input_tokens":67964,"cache_creation":{"ephemeral_5m_input_tokens":858,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"79fb91f9-81f3-4a4c-8861-bc656a868b4a","uuid":"7604b8eb-448c-4058-b477-08be37710659","timestamp":"2026-09-05T01:15:19.730Z"}
