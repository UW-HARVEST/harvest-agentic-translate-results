sult' <<<\"$out\" | head -20\n        fail=1\n      else\n        echo \"ok ($(grep -c '^test .* \\.\\.\\. ok' <<<\"$out\") tests)\"\n      fi\n    done\n  done\ndone\n\necho\nif (( fail )); then echo \"RESULT: FAILURES PRESENT\"; exit 1; else echo \"RESULT: ALL CONFIGURATIONS PASS\"; fi\n","structuredPatch":[],"originalFile":null,"userModified":false}}
