ntf(stderr, \"dlopen C: %s\\n\", dlerror()); return 2; }\n    void *hr = dlopen(argv[2], RTLD_NOW);\n    if (!hr) { fprintf(stderr, \"dlopen RUST: %s\\n\", dlerror()); return 2; }\n    c_fn = (fn_t)dlsym(hc, \"contrast_ratio\");\n    r_fn = (fn_t)dlsym(hr, \"contrast_ratio\");\n    if (!c_fn || !r_fn) { fprintf(stderr, \"dlsym failed\\n\"); return 2; }\n\n    // 1) Exhaustive over all grayscale pairs: covers every one of the 256\n    //    channel byte values on both sides, including the 0.04045 branch\n    //    boundary (c=10 -> linear arm, c=11 -> pow arm) and black/black (0/0).\n    for (int i = 0; i < 256; i++)\n        for (int j = 0; j < 256; j++) {\n            cb_rgb_255 a = {(unsigned char)i, (unsigned char)i, (unsigned char)i};\n            cb_rgb_255 b = {(unsigned char)j, (unsigned char)j, (unsigned char)j};\n            check(a, b);\n        }\n\n    // 2) Exhaustive per-channel sweeps against fixed partners (isolates each\n    //    channel's weight and each channel's branch decision).\n    const unsigned char partners[] = {0, 1, 10, 11, 12, 127, 128, 254, 255};\n    for (int p = 0; p < (int)sizeof(partners); p++)\n        for (int c = 0; c < 256; c++) {\n            unsigned char v = (unsigned char)c, q = partners[p];\n            cb_rgb_255 aR = {v, q, q}, aG = {q, v, q}, aB = {q, q, v};\n            cb_rgb_255 bR = {q, v, v}, bG = {v, q, v}, bB = {v, v, q};\n            check(aR, bR); check(aG, bG); check(aB, bB);\n            check(bR, aR); check(bG, aG); check(bB, aB);\n        }\n\n    // 3) Identical-colour pairs (Ratio == 1.0, and 0/0 for pure black).\n    for (int i = 0; i < 256; i++) {\n        cb_rgb_255 a = {(unsigned char)i, (unsigned char)(255 - i),\n                        (unsigned char)(i * 7)};\n        check(a, a);\n    }\n\n    // 4) Large randomized sweep over the full 6-byte input space.\n    long n = (argc > 3) ? atol(argv[3]) : 20000000L;\n    for (long k = 0; k < n; k++) {\n        uint64_t x = rnd();\n        cb_rgb_255 a = {