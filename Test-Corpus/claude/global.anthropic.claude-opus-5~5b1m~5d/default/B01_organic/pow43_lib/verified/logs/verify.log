let sign: c_int;\n108\t    let mut mult: c_int = 256;\n109\t\n110\t    if x < 129 {\n111\t        return table(16i32.wrapping_add(x));\n112\t    }\n113\t    if x < 1024 {\n114\t        mult = 16;\n115\t        x = x.wrapping_shl(3);\n116\t    }\n117\t    // sign = 2 * x & 64;  ->  ((2 * x) & 64)\n118\t    sign = x.wrapping_mul(2) & 64;\n119\t    // frac = (float)((x & 63) - sign) / ((x & ~63) + sign);\n120\t    //\n121\t    // The numerator is cast to `float`; the integer denominator is then\n122\t    // converted to `float` by the usual arithmetic conversions, so the\n123\t    // division itself is a single-precision division.\n124\t    frac = ((x & 63).wrapping_sub(sign) as f32) / ((x & !63).wrapping_add(sign) as f32);\n125\t    // return g_pow43[16 + ((x + sign) >> 6)] *\n126\t    //        (1.f + frac * ((4.f / 3) + frac * (2.f / 9))) * mult;\n127\t    //\n128\t    // `*` is left associative, so the table entry is multiplied by the\n129\t    // polynomial first and that product is then scaled by `mult`.\n130\t    let poly: f32 = 1.0f32 + frac * ((4.0f32 / 3.0f32) + frac * (2.0f32 / 9.0f32));\n131\t    (table(16i32.wrapping_add((x.wrapping_add(sign)) >> 6)) * poly) * (mult as f32)\n132\t}\n133\t\n134\t#[cfg(test)]\n135\tmod tests {\n136\t    use super::pow43;\n137\t\n138\t    /// Raw IEEE-754 bit patterns captured from the original C library\n139\t    /// (`gcc`/`clang`, every optimisation level agrees on these).\n140\t    const REFERENCE: &[(i32, u32)] = &[\n141\t        (-16, 0x00000000),\n142\t        (-15, 0xbf800000),\n143\t        (-1, 0xc213f904),\n144\t        (0, 0x00000000),\n145\t        (1, 0x3f800000),\n146\t        (2, 0x40214517),\n147\t        (127, 0x441f979a),\n148\t        (128, 0x44214518),\n149\t        (129, 0x4422f3b5),\n150\t        (130, 0x4424a371),\n151\t        (255, 0x44ca2138),\n152\t        (256, 0x44cb2ff5),\n153\t        (1023, 0x46210f58),\n154\t        (1024, 0x46214518),\n155\t        (1025, 0x46217adb),\n156\t        (4096, 0x