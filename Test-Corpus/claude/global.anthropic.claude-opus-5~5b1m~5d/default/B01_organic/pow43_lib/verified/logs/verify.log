CH\" } else { \"DIFFER\" }\n        );\n    }\n}\n","structuredPatch":[{"oldStart":13,"oldLines":7,"newStart":13,"newLines":7,"lines":["     let mut runs: Vec<(i32, i32, bool)> = Vec::new();","     let probe = |x: i32| -> bool { l.c(x).to_bits() == l.rust(x).to_bits() };"," ","-    let mut x = -4096i32;","+    let mut x = -32i32;","     let mut start = x;","     let mut cur = probe(x);","     while x <= 20000 {"]}],"userModified":false,"replaceAll":false}}
