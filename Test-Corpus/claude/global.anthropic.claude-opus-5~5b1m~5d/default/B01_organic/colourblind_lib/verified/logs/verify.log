$name(dst: f32, src: f32) -> f32 {\n65\t                let mut d = dst;\n66\t                // SAFETY: SSE is part of the x86-64 baseline, so this\n67\t                // instruction is always available. It only reads/writes the two\n68\t                // named registers, touches no memory and clobbers no flags,\n69\t                // matching the declared options.\n70\t                unsafe {\n71\t                    core::arch::asm!(\n72\t                        concat!($mnemonic, \" {d}, {s}\"),\n73\t                        d = inout(xmm_reg) d,\n74\t                        s = in(xmm_reg) src,\n75\t                        options(pure, nomem, nostack, preserves_flags),\n76\t                    );\n77\t                }\n78\t                d\n79\t            }\n80\t        };\n81\t    }\n82\t\n83\t    #[cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))]\n84\t    scalar_op!(mul, \"mulss\");\n85\t    #[cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))]\n86\t    scalar_op!(add, \"addss\");\n87\t    #[cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))]\n88\t    scalar_op!(sub, \"subss\");\n89\t\n90\t    #[cfg(not(any(target_arch = \"x86\", target_arch = \"x86_64\")))]\n91\t    #[inline(always)]\n92\t    pub fn mul(dst: f32, src: f32) -> f32 {\n93\t        dst * src\n94\t    }\n95\t\n96\t    #[cfg(not(any(target_arch = \"x86\", target_arch = \"x86_64\")))]\n97\t    #[inline(always)]\n98\t    pub fn add(dst: f32, src: f32) -> f32 {\n99\t        dst + src\n100\t    }\n101\t\n102\t    #[cfg(not(any(target_arch = \"x86\", target_arch = \"x86_64\")))]\n103\t    #[inline(always)]\n104\t    pub fn sub(dst: f32, src: f32) -> f32 {\n105\t        dst - src\n106\t    }\n107\t}\n108\t\n109\tuse sse::{add, mul, sub};\n110\t\n111\t/// `typedef enum cb_impairment { cbProtanopia, cbDeuteranopia, cbTritanopia }`\n112\t///\n113\t/// The C enum's values are 0, 1 and 2; the compiler picks `unsigned int` as its\n114\t/// compatible type, which is what the ABI passes in the first integer register.\n115\tpub type cb_impairment = c_uint;\n116\t\n117\tpub const cbProtanopia: cb_impairment = 0;\n118\tpub const cbDeuteranopia: cb_impairment = 1;\n119\tpub const cbTritanopia: cb_impairment = 2;\n120\t\n121\t/// ```c\n122\t/// static void Protanopia(float *Red, float *Green, float *Blue) {\n123\t///     float R = *Red, G = *Green, B = *Blue;\n124\t///     *Red = 0.17055699213417f * R + 0.82944301379913f * G + 2.91188E-9f * B;\n125\t///     *Green = 0.17055699092998f * R + 0.82944300785005f * G - 5.98679E-10f * B;\n126\t///     *Blue = -0.00451714424166f * R + 0.00451714427397f * G + B;\n127\t/// }\n128\t/// ```\n129\tunsafe fn protanopia(red: *mut f32, green: *mut f32, blue: *mut f32) {\n130\t    let (r, g, b) = (*red, *green, *blue);\n131\t\n132\t    // t3 + (t1 + t2)\n133\t    let t1 = mul(r, 0.17055699213417f32);\n134\t    let t2 = mul(0.82944301379913f32, g);\n135\t    let t3 = mul(2.91188E-9f32, b);\n136\t    *red = add(t3, add(t1, t2));\n137\t\n138\t    // (t2 + t1) - t3\n139\t    let t1 = mul(r, 0.17055699092998f32);\n140\t    let t2 = mul(0.82944300785005f32, g);\n141\t    let t3 = mul(5.98679E-10f32, b);\n142\t    *green = sub(add(t2, t1), t3);\n143\t\n144\t    // (t2 + t1) + B\n145\t    let t1 = mul(r, -0.00451714424166f32);\n146\t    let t2 = mul(0.00451714427397f32, g);\n147\t    *blue = add(add(t2, t1), b);\n148\t}\n149\t\n150\t/// ```c\n151\t/// static void Deuteranopia(float *Red, float *Green, float *Blue) {\n152\t///     float R = *Red, G = *Green, B = *Blue;\n153\t///     *Red = 0.33066007266046f * R + 0.66933992517563f * G + 3.559314E-9f * B;\n154\t///     *Green = 0.33066007387760f * R + 0.66933992719147f * G - 1.758327E-9f * B;\n155\t///     *Blue = -0.02785538261323f * R + 0.02785538252318f * G + B;\n156\t/// }\n157\t/// ```\n158\tunsafe fn deuteranopia(red: *mut f32, green: *mut f32, blue: *mut f32) {\n159\t    let (r, g, b) = (*red, *green, *blue);\n160\t\n161\t    // t3 + (t1 + t2)\n162\t    let t1 = mul(r, 0.33066007266046f32);\n163\t    let t2 = mul(0.66933992517563f32, g);\n164\t    let t3 = mul(3.559314E-9f32, b);\n165\t    *red = add(t3, add(t1, t2));\n166\t\n167\t    // (t2 + t1) - t3\n168\t    let t1 = mul(r, 0.33066007387760f32);\n169\t    let t2 = mul(0.66933992719147f32, g);\n170\t    let t3 = mul(1.758327E-9f32, b);\n171\t    *green = sub(add(t2, t1), t3);\n172\t\n173\t    // (t2 + t1) + B\n174\t    let t1 = mul(r, -0.02785538261323f32);\n175\t    let t2 = mul(0.02785538252318f32, g);\n176\t    *blue = add(add(t2, t1), b);\n177\t}\n178\t\n179\t/// ```c\n180\t/// static void Tritanopia(float *Red, float *Green, float *Blue) {\n181\t///     float R = *Red, G = *Green, B = *Blue;\n182\t///     *Red = R + 0.12739886310880f * G - 0.12739886341072f * B;\n183\t///     *Green = -4.486E-11f * R + 0.87390929928361f * G + 0.12609070101523f * B;\n184\t///     *Blue = 3.1113E-10f * R + 0.87390929725848f * G + 0.12609070067115f * B;\n185\t/// }\n186\t/// ```\n187\tunsafe fn tritanopia(red: *mut f32, green: *mut f32, blue: *mut f32) {\n188\t    let (r, g, b) = (*red, *green, *blue);\n189\t\n190\t    // (tG + R) - tB\n191\t    let t_g = mul(0.12739886310880f32, g);\n192\t    let t_b = mul(0.12739886341072f32, b);\n193\t    *red = sub(add(t_g, r), t_b);\n194\t\n195\t    // t3 + (t1 + t2)\n196\t    let t1 = mul(r, -4.486E-11f32);\n197\t    let t2 = mul(0.87390929928361f32, g);\n198\t    let t3 = mul(0.12609070101523f32, b);\n199\t    *green = add(t3, add(t1, t2));\n200\t\n201\t    // t3 + (t1 + t2)\n202\t    let t1 = mul(r, 3.1113E-10f32);\n203\t    let t2 = mul(0.87390929725848f32, g);\n204\t    let t3 = mul(0.12609070067115f32, b);\n205\t    *blue = add(t3, add(t1, t2));\n206\t}\n207\t\n208\t/// `void colourblind(cb_impairment Impairment, float *R, float *G, float *B);`\n209\t#[unsafe(no_mangle)]\n210\tpub unsafe extern \"C\" fn colourblind(\n211\t    impairment: cb_impairment,\n212\t    r: *mut f32,\n213\t    g: *mut f32,\n214\t    b: *mut f32,\n215\t) {\n216\t    matc