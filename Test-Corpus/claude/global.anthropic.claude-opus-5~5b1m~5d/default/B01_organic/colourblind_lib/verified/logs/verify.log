 's/        _ => {}/        _ => protanopia(r, g, b),/' src/lib.rs\n\n# 5. store order changed: blue written before red (observable only when aliased)\nrun_mutant \"store order red<->blue swapped (protanopia)\" \\\n  perl -0pi -e 's/\\*blue = add\\(add\\(t2, t1\\), b\\);\\n\\}\\n\\n\\/\\/\\/ ```c\\n\\/\\/\\/ static void Deuteranopia/*blue = add(add(t2, t1), b);\\n    let t1 = mul(r, 0.17055699213417f32);\\n    let t2 = mul(0.82944301379913f32, g);\\n    let t3 = mul(2.91188E-9f32, b);\\n    *red = add(t3, add(t1, t2));\\n}\\n\\n\\/\\/\\/ ```c\\n\\/\\/\\/ static void Deuteranopia/' src/lib.rs\n\n# 6. read-after-write instead of pre-loading locals (observable only when aliased)\nrun_mutant \"protanopia re-reads *green after writing *red\" \\\n  perl -0pi -e 's/    \\/\\/ \\(t2 \\+ t1\\) - t3\\n    let t1 = mul\\(r, 0\\.17055699092998f32\\);/    \\/\\/ (t2 + t1) - t3\\n    let g = *green;\\n    let t1 = mul(r, 0.17055699092998f32);/' src/lib.rs\n\n# 7. use double precision internally (rounding differences)\nrun_mutant \"green uses f64 intermediate\" \\\n  perl -0pi -e 's/    \\*green = sub\\(add\\(t2, t1\\), t3\\);\\n\\}\\n\\n\\/\\/\\/ ```c\\n\\/\\/\\/ static void Deuteranopia/    *green = ((t2 as f64 + t1 as f64) - t3 as f64) as f32;\\n}\\n\\n\\/\\/\\/ ```c\\n\\/\\/\\/ static void Deuteranopia/' src/lib.rs\n\n# 8. treat the impairment as i32 and accept negatives as protanopia\nrun_mutant \"signed comparison for impairment\" \\\n  perl -0pi -e 's/    match impairment \\{/    let impairment = if (impairment as i32) < 0 { 0 } else { impairment };\\n    match impairment {/' src/lib.rs\n\n# 9. tritanopia red loses the raw R addend ordering (a*R with coefficient 1.0)\nrun_mutant \"tritanopia red uses mul(r,1.0) instead of raw R\" \\\n  perl -0pi -e 's/    \\*red = sub\\(add\\(t_g, r\\), t_b\\);/    *red = sub(add(t_g, mul(r, 1.0f32)), t_b);/' src/lib.rs\n\n# 10. clamp outputs to [0,1] (a plausible \"improvement\" the C does not do)\nrun_mutant \"clamp protanopia outputs to [0,1]\" \\\n  perl -0pi -e 's/    \\*blue = add\\(add\\(t2, t1\\), b\\);\\n\\}\\n\\n\\/\\/\\/ ```c\\n\\/\\/\\/ static void Deuteranopia/    *blue = add(add(t2, t1), b);\\n    *red = (*red).clamp(0.0, 1.0);\\n    *green = (*green).clamp(0.0, 1.0);\\n    *blue = (*blue).clamp(0.0, 1.0);\\n}\\n\\n\\/\\/\\/ ```c\\n\\/\\/\\/ static void Deuteranopia/' src/lib.rs\n\ncp \"$ORIG\" src/lib.rs\necho \"=== restored original lib.rs ===\"\nEOS\nchmod +x \"$TMPDIR/mutate.sh\" && timeout 600 \"$TMPDIR/mutate.sh\" 2>&1 | tail -40","uuid":"417038ce-ae56-4bec-9228-1f64a1507273","session_id":"e6f88a36-a7a8-4415-a6ac-c0933f14076b"}
