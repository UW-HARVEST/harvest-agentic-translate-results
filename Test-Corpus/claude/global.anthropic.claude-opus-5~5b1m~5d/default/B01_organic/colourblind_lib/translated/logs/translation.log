5.98679E-10f * B;","+///     *Blue = -0.00451714424166f * R + 0.00451714427397f * G + B;","+/// }","+/// ```"," unsafe fn protanopia(red: *mut f32, green: *mut f32, blue: *mut f32) {","     let (r, g, b) = (*red, *green, *blue);","-    *red = 0.17055699213417f32 * r + 0.82944301379913f32 * g + 2.91188E-9f32 * b;","-    *green = 0.17055699092998f32 * r + 0.82944300785005f32 * g - 5.98679E-10f32 * b;","-    *blue = -0.00451714424166f32 * r + 0.00451714427397f32 * g + b;","+","+    // t3 + (t1 + t2)","+    let t1 = mul(r, 0.17055699213417f32);","+    let t2 = mul(0.82944301379913f32, g);","+    let t3 = mul(2.91188E-9f32, b);","+    *red = add(t3, add(t1, t2));","+","+    // (t2 + t1) - t3","+    let t1 = mul(r, 0.17055699092998f32);","+    let t2 = mul(0.82944300785005f32, g);","+    let t3 = mul(5.98679E-10f32, b);","+    *green = sub(add(t2, t1), t3);","+","+    // (t2 + t1) + B","+    let t1 = mul(r, -0.00451714424166f32);","+    let t2 = mul(0.00451714427397f32, g);","+    *blue = add(add(t2, t1), b);"," }"," ","+/// ```c","+/// static void Deuteranopia(float *Red, float *Green, float *Blue) {","+///     float R = *Red, G = *Green, B = *Blue;","+///     *Red = 0.33066007266046f * R + 0.66933992517563f * G + 3.559314E-9f * B;","+///     *Green = 0.33066007387760f * R + 0.66933992719147f * G - 1.758327E-9f * B;","+///     *Blue = -0.02785538261323f * R + 0.02785538252318f * G + B;","+/// }","+/// ```"," unsafe fn deuteranopia(red: *mut f32, green: *mut f32, blue: *mut f32) {","     let (r, g, b) = (*red, *green, *blue);","-    *red = 0.33066007266046f32 * r + 0.66933992517563f32 * g + 3.559314E-9f32 * b;","-    *green = 0.33066007387760f32 * r + 0.66933992719147f32 * g - 1.758327E-9f32 * b;","-    *blue = -0.02785538261323f32 * r + 0.02785538252318f32 * g + b;","+","+    // t3 + (t1 + t2)","+    let t1 = mul(r, 0.33066007266046f32);","+    let t2 = mul(0.66933992517563f32, g);","+    let t3 = mul(3.559314E-9f32, b);","+    *red = add(t3, add(t1, t2));","+","+    // 