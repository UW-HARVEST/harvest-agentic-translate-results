, 1.0f, \"T: R-N,G+N\"},\n        {2, 1.0f,  pnan, nnan, \"T: G+N,B-N\"},\n        {0, INFINITY, -INFINITY, 1.0f, \"P: inf,-inf\"},\n        {1, INFINITY, -INFINITY, 1.0f, \"D: inf,-inf\"},\n        {2, INFINITY, -INFINITY, 1.0f, \"T: inf,-inf\"},\n        {0, 0.25f, 0.5f, 0.75f, \"P: normal\"},\n        {1, 0.25f, 0.5f, 0.75f, \"D: normal\"},\n        {2, 0.25f, 0.5f, 0.75f, \"T: normal\"},\n    };\n    for (int c = 0; c < (int)(sizeof(cases) / sizeof(cases[0])); c++) {\n        printf(\"%-12s \", cases[c].tag);\n        for (int i = 0; i < NL; i++) {\n            float r = cases[c].r, g = cases[c].g, b = cases[c].b;\n            fns[i](cases[c].imp, &r, &g, &b);\n            printf(\"| %s %08x %08x %08x \", names[i], bits(r), bits(g), bits(b));\n        }\n        printf(\"\\n\");\n    }\n    return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2366,"cache_read_input_tokens":32749,"cache_creation":{"ephemeral_5m_input_tokens":2366,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"32810b32-b6d0-4e48-8b8f-42ef900d5faf","uuid":"b607e4de-3991-4e52-80b2-aece442d9933","timestamp":"2026-08-26T20:02:06.992Z"}
