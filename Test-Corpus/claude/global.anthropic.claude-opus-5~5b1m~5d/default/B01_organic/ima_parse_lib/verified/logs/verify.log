umented loads, the Rust library aborts (SIGABRT) where the C library\n// faults (SIGSEGV) -- an observable divergence.  A raw packed-field\n// dereference compiles to exactly the uninstrumented `mov` the C compiler\n// emits, in every profile.\n\n/// One-byte-aligned wrapper: reading `.0` through a raw pointer performs an\n/// unaligned, uninstrumented load.\n#[repr(C, packed)]\nstruct Unaligned<T>(T);\n\n#[inline]\nunsafe fn load_u16(base: *const u8, offset: usize) -> ima_u16_t {\n    (*(base.wrapping_add(offset) as *const Unaligned<ima_u16_t>)).0\n}\n\n#[inline]\nunsafe fn load_u32(base: *const u8, offset: usize) -> ima_u32_t {\n    (*(base.wrapping_add(offset) as *const Unaligned<ima_u32_t>)).0\n}\n\n#[inline]\nunsafe fn load_u64(base: *const u8, offset: usize) -> ima_u64_t {\n    (*(base.wrapping_add(offset) as *const Unaligned<ima_u64_t>)).0\n}\n\n#[inline]\nunsafe fn load_f64(base: *const u8, offset: usize) -> ima_f64_t {\n    (*(base.wrapping_add(offset) as *const Unaligned<ima_f64_t>)).0\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2768,"cache_read_input_tokens":139204,"cache_creation":{"ephemeral_5m_input_tokens":2768,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d18ee8e3-b700-41cf-a197-c9291a65197b","uuid":"249fb9fa-711c-44a1-a6e9-f08252ef6f56","timestamp":"2026-08-26T23:18:51.013Z"}
