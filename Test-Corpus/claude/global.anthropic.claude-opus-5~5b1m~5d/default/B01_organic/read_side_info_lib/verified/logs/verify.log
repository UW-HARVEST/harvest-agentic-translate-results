| sed 's/^/   /'","+      fail=1","+    fi","   done"," done","-# --all-features is equivalent to the above when there are no features, but run","-# it anyway so the script stays correct if features are added later.","-run_suite \"--all-features\" \"--all-features\" debug","-run_suite \"--all-features\" \"--all-features\" release"," ","-echo","-echo \"==============================================================\"","-if [ \"$fail\" -eq 0 ]; then echo \" ALL PHASES PASSED\"; else echo \" FAILURES DETECTED\"; fi","-echo \"==============================================================\"","+# Restore the default-feature debug/release .so so a bare `cargo test` works.","+$CARGO build -q; $CARGO build --release -q","+","+hdr \"$([ \"$fail\" -eq 0 ] && echo 'ALL PHASES PASSED' || echo 'FAILURES DETECTED')\""," exit \"$fail\""]}],"originalFile":"#!/usr/bin/env bash\n# Phase D driver: rebuild both libraries, diff the exported symbols, and run the\n# full differential suite under every feature combination x both build profiles.\nset -uo pipefail\ncd \"$(dirname \"$0\")\"\nROOT=\"$(cd .. && pwd)\"\nCARGO=\"cargo --offline\"\nfail=0\n\necho \"==============================================================\"\necho \" 1. Build the C shared library\"\necho \"==============================================================\"\n( cd \"$ROOT/c_src\" && mkdir -p build && cd build \\\n  && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON >/dev/null \\\n  && cmake --build . >/dev/null ) || { echo \"C build FAILED\"; exit 1; }\nC_SO=$(ls \"$ROOT\"/c_src/build/lib*.so | head -1)\necho \"C  .so: $C_SO\"\n\necho\necho \"==============================================================\"\necho \" 2. Build the Rust shared library (both profiles)\"\necho \"==============================================================\"\n$CARGO build          -q || { echo \"rust debug build FAILED\";   exit 1; }\n$CARGO build --release -q || { echo \"rust release build FAILED\"; exit 1; }\nR_DBG=\"target/debug/libread_side_info_lib.so\"\nR_REL=\"target/release/libread_side_info_lib.so\"\nls -l \"$R_DBG\" \"$R_REL\"\n\necho\necho \"==============================================================\"\necho \" 3. Symbol parity (nm -D)\"\necho \"==============================================================\"\nsyms() { nm -D --defined-only \"$1\" | awk '{print $NF}' | sort -u; }\nfor R in \"$R_DBG\" \"$R_REL\"; do\n  MISSING=$(comm -23 <(syms \"$C_SO\") <(syms \"$R\"))\n  echo \"--- $R\"\n  if [ -n \"$MISSING\" ]; then\n    echo \"MISSING FROM RUST:\"; echo \"$MISSING\"; fail=1\n  else\n    echo \"OK: 0 symbols missing (C exports: $(syms \"$C_SO\" | wc -l))\"\n  fi\n  UNDEF=$(nm -D --undefined-only \"$R\" | awk '{print $NF}' \\\n          | grep -vE '^(__|_ITM_|_Unwind_|memcpy|memmove|memset|memcmp|malloc|free|realloc|calloc|abort|dl_iterate_phdr|getenv|write|writev|pthread_|sig|str|open|close|read$|mmap|munmap|poll|syscall|bcmp|posix_|_exit|exit|environ|stat|fstat|lseek|readlink|getcwd|sysconf|gettimeofday|clock_gettime|nanosleep|sched_|mprotect|madvise|realpath|dlsym|dlopen|dlclose|dlerror|qsort|calloc)' || true)\n  if [ -n \"$UNDEF\" ]; then echo \"non-libc undefined symbols:\"; echo \"$UNDEF\"; fi\ndone\n\necho\necho \"==============================================================\"\necho \" 4. Feature combinations declared in Cargo.toml\"\necho \"==============================================================\"\nFEATS=$(python3 - <<'PY'\nimport re\ns = open('Cargo.toml').read()\nm = re.search(r'^\\[features\\]\\s*$(.*?)(^\\[|\\Z)', s, re.M | re.S)\nnames = []\nif m:\n    for line in m.group(1).splitlines():\n        line = line.strip()\n        if line and not line.startswith('#') and '=' in line:\n            n = line.split('=')[0].strip()\n            if n != 'default':\n                names.append(n)\nprint(' '.join(names))\nPY\n)\nif [ -z \"$FEATS\" ]; then\n  echo \"No [features] section -> the only combination is the default (empty) one.\"\n  COMBOS=(\"default\")\nelse\n  echo \"features: $FEATS\"\n  COMBOS=(\"default\")\n  # power set\n  set -- $FEATS\n  n=$#; total=$((1<<n))\n  for ((mask=0; mask<total; mask++)); do\n    combo=\"\"\n    for ((i=0; i<n; i++)); do\n      if (( (mask>>i)&1 )); then eval \"f=\\${$((i+1))}\"; combo=\"$combo,$f\"; fi\n    done\n    COMBOS+=(\"nodefault:${combo#,}\")\n  done\nfi\n\necho\necho \"==============================================================\"\necho \" 5. Differential test suite\"\necho \"==============================================================\"\nrun_suite() { # $1 = cargo feature flags, $2 = label, $3 = RUST_SO_PROFILE\n  echo\n  echo \">>> [$2] profile=$3\"\n  RUST_SO_PROFILE=\"$3\" $CARGO test $1 -- --test-threads=4 2>&1 \\\n    | grep -E 'running |test result|^test .* FAILED|panicked|DIVERGENCE' \\\n    | sed 's/^/    /'\n  # shellcheck disable=SC2181\n  RUST_SO_PROFILE=\"$3\" $CARGO test $1 -q >/dev/null 2>&1 || fail=1\n}\n\nfor combo in \"${COMBOS[@]}\"; do\n  case \"$combo\" in\n    default)          FLAGS=\"\" ; LABEL=\"default features\" ;;\n    nodefault:)       FLAGS=\"--no-default-features\" ; LABEL=\"--no-default-features\" ;;\n    nodefault:*)      FLAGS=\"--no-default-features --features ${combo#nodefault:}\"\n                      LABEL=\"$FLAGS\" ;;\n  esac\n  for prof in debug release; do\n    run_suite \"$FLAGS\" \"$LABEL\" \"$prof\"\n  done\ndone\n# --all-features is equivalent to the above when there are no features, but run\n# it anyway so the script stays correct if features are added later.\nrun_suite \"--all-features\" \"--all-features\" debug\nrun_suite \"--all-features\" \"--all-features\" release\n\necho\necho \"==============================================================\"\nif [ \"$fail\" -eq 0 ]; then echo \" ALL PHASES PASSED\"; else echo \" FAILURES DETECTED\"; fi\necho \"==============================================================\"\nexit \"$fail\"\n","userModified":false}}
