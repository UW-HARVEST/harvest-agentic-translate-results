t: hex[i] = \"0123456789abcdef: \"[r % 18]; break;\n            }\n        }\n        /* leave the tail unterminated on purpose (hex_len drives the loop) */\n        size_t bin_maxlen = rnd() % 20;\n        const char *ign = ignores[rnd() % NIGN];\n        int use_end = rnd() % 2;\n\n        memset(binc, 0xAA, sizeof(binc));\n        memset(binr, 0xAA, sizeof(binr));\n        const char *endc = (const char *)0x1, *endr = (const char *)0x2;\n\n        int rc = c_fn(binc, bin_maxlen, hex, hex_len, ign, use_end ? &endc : NULL);\n        int rr = r_fn(binr, bin_maxlen, hex, hex_len, ign, use_end ? &endr : NULL);\n\n        cases++;\n        int bad = 0;\n        if (rc != rr) bad = 1;\n        if (memcmp(binc, binr, sizeof(binc)) != 0) bad = 2;\n        if (use_end && endc != endr) bad = 3;\n\n        if (bad) {\n            if (fails < 10) {\n                fprintf(stderr, \"MISMATCH(%d) hex_len=%zu bin_maxlen=%zu ign=%s use_end=%d rc=%d rr=%d hex=[\",\n                        bad, hex_len, bin_maxlen, ign ? \"set\" : \"NULL\", use_end, rc, rr);\n                for (size_t i = 0; i < hex_len; i++) fprintf(stderr, \"%02x \", (unsigned char)hex[i]);\n                fprintf(stderr, \"] endc=%td endr=%td\\n\",\n                        use_end ? endc - hex : 0, use_end ? endr - hex : 0);\n            }\n            fails++;\n        }\n    }\n\n    /* Exhaustive single/double character sweep with every ignore set. */\n    for (unsigned a = 0; a < 256; a++) {\n        for (unsigned b = 0; b < 256; b++) {\n            char h[2] = { (char)a, (char)b };\n            for (size_t ii = 0; ii < NIGN; ii++) {\n                for (size_t ml = 0; ml < 3; ml++) {\n                    for (int ue = 0; ue < 2; ue++) {\n                        memset(binc, 0xAA, sizeof(binc));\n                        memset(binr, 0xAA, sizeof(binr));\n                        const char *ec = NULL, *er = NULL;\n                        int rc = c_fn(binc, ml, h, 2, ignores[ii], ue ? &ec : NULL);\n     