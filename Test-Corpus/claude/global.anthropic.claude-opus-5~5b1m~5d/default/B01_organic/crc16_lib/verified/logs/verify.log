= (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n        z ^ (z >> 31)\n    }\n    pub fn next_u16(&mut self) -> u16 {\n        (self.next_u64() >> 32) as u16\n    }\n    pub fn next_u8(&mut self) -> u8 {\n        (self.next_u64() >> 40) as u8\n    }\n    /// Uniform-ish in `0..n` (n > 0).\n    pub fn below(&mut self, n: usize) -> usize {\n        (self.next_u64() % n as u64) as usize\n    }\n    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n        (0..n).map(|_| self.next_u8()).collect()\n    }\n    pub fn fill(&mut self, buf: &mut [u8]) {\n        for b in buf.iter_mut() {\n            *b = self.next_u8();\n        }\n    }\n}\n\n/// Seed values that sit on every interesting `u16` boundary.\npub const SEED_EXTREMES: [u16; 12] = [\n    0x0000, 0x0001, 0x00FF, 0x0100, 0x0101, 0x7FFF, 0x8000, 0x8001, 0xFF00, 0xFEFF, 0xFFFE, 0xFFFF,\n];\n","structuredPatch":[{"oldStart":182,"oldLines":9,"newStart":182,"newLines":10,"lines":[" /// Load (once) and return both implementations."," pub fn pair() -> &'static Pair {","     static PAIR: OnceLock<Pair> = OnceLock::new();","-    PAIR.get_or_init(|| Pair {","-        c: load(\"C\", c_so_path()),","-        rust: load(\"Rust\", rust_so_path()),","+    PAIR.get_or_init(|| {","+        let rust_so = rust_so_path();","+        assert_so_fresh(&rust_so);","+        Pair { c: load(\"C\", c_so_path()), rust: load(\"Rust\", rust_so) }","     })"," }"," "]}],"userModified":false,"replaceAll":false}}
