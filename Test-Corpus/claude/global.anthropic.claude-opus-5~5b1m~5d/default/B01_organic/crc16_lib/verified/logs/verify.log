{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KLUZo3LczLMrkjfkt8fcnQ","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The C library consists of a single translation unit (`src/lib.c`) plus one\n4\t//! public header (`include/lib.h`). The complete exported ABI is:\n5\t//!\n6\t//! ```c\n7\t//! typedef uint8_t  tflac_u8;\n8\t//! typedef uint16_t tflac_u16;\n9\t//! typedef uint32_t tflac_u32;\n10\t//!\n11\t//! tflac_u16 crc16(const tflac_u8 *d, tflac_u32 len, tflac_u16 crc16);\n12\t//! ```\n13\t//!\n14\t//! The `tflac_crc16_tables` array in the header is declared `static`, so it has\n15\t//! internal linkage and contributes no dynamic symbol; it is reproduced as a\n16\t//! crate-private table in [`tables`].\n17\t//!\n18\t//! No namespace/renaming preprocessor macros are present in the header, so the\n19\t//! linker symbol is plain `crc16`.\n20\t\n21\t#![deny(missing_docs)]\n22\t\n23\tmod tables;\n24\t\n25\tuse tables::TFLAC_CRC16_TABLES as T;\n26\t\n27\t/// `tflac_u8` — `uint8_t`.\n28\t#[allow(non_camel_case_types)]\n29\tpub type tflac_u8 = u8;\n30\t\n31\t/// `tflac_u16` — `uint16_t`.\n32\t#[allow(non_camel_case_types)]\n33\tpub type tflac_u16 = u16;\n34\t\n35\t/// `tflac_u32` — `uint32_t`.\n36\t#[allow(non_camel_case_types)]\n37\tpub type tflac_u32 = u32;\n38\t\n39\t/// Safe core of [`crc16`], operating on a byte slice.\n40\t///\n41\t/// This mirrors the C loop structure exactly:\n42\t///\n43\t/// * a slice-by-8 stage that consumes whole 8-byte groups while at least 8\n44\t///   bytes remain, and\n45\t/// * a byte-at-a-time stage for the tail.\n46\t///\n47\t/// All arithmetic is done in `u16`, which reproduces the C behaviour: the C code\n48\t/// integer-promotes the operands to `int`, computes, then truncates back into\n49\t/// the `tflac_u16` variable on assignment. Every intermediate value in this\n50\t/// routine fits in 16 bits after that truncation, and the only shift that can\n51\t/// discard bits (`crc16 << 8`) discards exactly the bits the C truncation would.\n52\tfn crc16_impl(d: &[u8], mut crc: u16) -> u16 {\n53\t    let mut pos = 0usize;\n54\t    let mut len = d.len();\n55\t\n56\t    // while (len >= 8) { ... d += 8; len -= 8; }\n57\t    while len >= 8 {\n58\t        let c = &d[pos..pos + 8];\n59\t\n60\t        // crc16 ^= d[0] << 8 | d[1];\n61\t        crc ^= ((c[0] as u16) << 8) | (c[1] as u16);\n62\t\n63\t        // crc16 = tables[7][crc16 >> 8] ^ tables[6][crc16 & 0xFF] ^ ...\n64\t        crc = T[7][(crc >> 8) as usize]\n65\t            ^ T[6][(crc & 0xFF) as usize]\n66\t            ^ T[5][c[2] as usize]\n67\t            ^ T[4][c[3] as usize]\n68\t            ^ T[3][c[4] as usize]\n69\t            ^ T[2][c[5] as usize]\n70\t            ^ T[1][c[6] as usize]\n71\t            ^ T[0][c[7] as usize];\n72\t\n73\t        pos += 8;\n74\t        len -= 8;\n75\t    }\n76\t\n77\t    // while (len--) { crc16 = (crc16 << 8) ^ tables[0][(crc16 >> 8) ^ *d++]; }\n78\t    //\n79\t    // Note the post-decrement in the C source also decrements `len` on the\n80\t    // failing test, wrapping it to UINT32_MAX; `len` is dead after the loop, so\n81\t    // that has no observable effect.\n82\t    while len > 0 {\n83\t        let idx = ((crc >> 8) as u8) ^ d[pos];\n84\t        crc = (crc << 8) ^ T[0][idx as usize];\n85\t        pos += 1;\n86\t        len -= 1;\n87\t    }\n88\t\n89\t    crc\n90\t}\n91\t\n92\t/// `tflac_u16 crc16(const tflac_u8 *d, tflac_u32 len, tflac_u16 crc16)`\n93\t///\n94\t/// Slice-by-8 CRC-16 (the FLAC frame CRC-16, polynomial `0x8005`) over `len`\n95\t/// bytes starting at `d`, seeded with `crc16`.\n96\t///\n97\t/// # Safety\n98\t///\n99\t/// `d` must point to at least `len` readable bytes, exactly as required by the\n100\t/// C original. When `len == 0` the pointer is never dereferenced.\n101\t#[unsafe(no_mangle)]\n102\tpub unsafe extern \"C\" fn crc16(d: *const tflac_u8, len: tflac_u32, crc16: tflac_u16) -> tflac_u16 {\n103\t    // The C code reads exactly `len` bytes and touches `d` not at all when\n104\t    // `len == 0`, so only build a slice for the non-empty case.\n105\t    if len == 0 {\n106\t        return crc16;\n107\t    }\n108\t\n109\t    let bytes = unsafe { core::slice::from_raw_parts(d, len as usize) };\n110\t    crc16_impl(bytes, crc16)\n111\t}\n112\t"}]},"parent_tool_use_id":null,"session_id":"977912f8-61bc-46ec-b4fa-051dff075de0","uuid":"5c85f02d-410e-40a9-8bd6-1184fb851ba1","timestamp":"2026-08-26T20:15:28.509Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-7ROkid/translation/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! The C library consists of a single translation unit (`src/lib.c`) plus one\n//! public header (`include/lib.h`). The complete exported ABI is:\n//!\n//! ```c\n//! typedef uint8_t  tflac_u8;\n//! typedef uint16_t tflac_u16;\n//! typedef uint32_t tflac_u32;\n//!\n//! tflac_u16 crc16(const tflac_u8 *d, tflac_u32 len, tflac_u16 crc16);\n//! ```\n//!\n//! The `tflac_crc16_tables` array in the header is declared `static`, so it has\n//! internal linkage and contributes no dynamic symbol; it is reproduced as a\n//! crate-private table in [`tables`].\n//!\n//! No namespace/renaming preprocessor macros are present in the header, so the\n//! linker symbol is plain `crc16`.\n\n#![deny(missing_docs)]\n\nmod tables;\n\nuse tables::TFLAC_CRC16_TABLES as T;\n\n/// `tflac_u8` — `uint8_t`.\n#[allow(non_camel_case_types)]\npub type tflac_u8 = u8;\n\n/// `tflac_u16` — `uint16_t`.\n#[allow(non_camel_case_types)]\npub type tflac_u16 = u16;\n\n/// `tflac_u32` — `uint32_t`.\n#[allow(non_camel_case_types)]\npub type tflac_u32 = u32;\n\n/// Safe core of [`crc16`], operating on a byte slice.\n///\n/// This mirrors the C loop structure exactly:\n///\n/// * a slice-by-8 stage that consumes whole 8-byte groups while at least 8\n///   bytes remain, and\n/// * a byte-at-a-time stage for the tail.\n///\n/// All arithmetic is done in `u16`, which reproduces the C behaviour: the C code\n/// integer-promotes the operands to `int`, computes, then truncates back into\n/// the `tflac_u16` variable on assignment. Every intermediate value in this\n/// routine fits in 16 bits after that truncation, and the only shift that can\n/// discard bits (`crc16 << 8`) discards exactly the bits the C truncation would.\nfn crc16_impl(d: &[u8], mut crc: u16) -> u16 {\n    let mut pos = 0usize;\n    let mut len = d.len();\n\n    // while (len >= 8) { ... d += 8; len -= 8; }\n    while len >= 8 {\n        let c = &d[pos..pos + 8];\n\n        // crc16 ^= d[0] << 8 | d[1];\n        crc ^= ((c[0] as u16) << 8) | (c[1] as u16);\n\n        // crc16 = tables[7][crc16 >> 8] ^ tables[6][crc16 & 0xFF] ^ ...\n        crc = T[7][(crc >> 8) as usize]\n            ^ T[6][(crc & 0xFF) as usize]\n            ^ T[5][c[2] as usize]\n            ^ T[4][c[3] as usize]\n            ^ T[3][c[4] as usize]\n            ^ T[2][c[5] as usize]\n            ^ T[1][c[6] as usize]\n            ^ T[0][c[7] as usize];\n\n        pos += 8;\n        len -= 8;\n    }\n\n    // while (len--) { crc16 = (crc16 << 8) ^ tables[0][(crc16 >> 8) ^ *d++]; }\n    //\n    // Note the post-decrement in the C source also decrements `len` on the\n    // failing test, wrapping it to UINT32_MAX; `len` is dead after the loop, so\n    // that has no observable effect.\n    while len > 0 {\n        let idx = ((crc >> 8) as u8) ^ d[pos];\n        crc = (crc << 8) ^ T[0][idx as usize];\n        pos += 1;\n        len -= 1;\n    }\n\n    crc\n}\n\n/// `tflac_u16 crc16(const tflac_u8 *d, tflac_u32 len, tflac_u16 crc16)`\n///\n/// Slice-by-8 CRC-16 (the FLAC frame CRC-16, polynomial `0x8005`) over `len`\n/// bytes starting at `d`, seeded with `crc16`.\n///\n/// # Safety\n///\n/// `d` must point to at least `len` readable bytes, exactly as required by the\n/// C original. When `len == 0` the pointer is never dereferenced.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn crc16(d: *const tflac_u8, len: tflac_u32, crc16: tflac_u16) -> tflac_u16 {\n    // The C code reads exactly `len` bytes and touches `d` not at all when\n    // `len == 0`, so only build a slice for the non-empty case.\n    if len == 0 {\n        return crc16;\n    }\n\n    let bytes = unsafe { core::slice::from_raw_parts(d, len as usize) };\n    crc16_impl(bytes, crc16)\n}\n","numLines":112,"startLine":1,"totalLines":112}}}
