nt is 0.49999985/0.50000101 vs 0.5, all of which truncate to 0.\",\n}\n\n# (name, [(old, new), ...], rationale)\nMUTANTS = ["}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1129,"cache_read_input_tokens":99010,"cache_creation":{"ephemeral_5m_input_tokens":1129,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"7c6b5ddc-198f-4d5c-ae07-c94e211c2ebc","uuid":"203bfcc9-e414-4655-a346-a88313fec80e","timestamp":"2026-08-27T02:28:02.788Z"}
