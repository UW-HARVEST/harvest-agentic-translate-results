\npub fn raise_sigfpe() -> ! {\n    die_with_signal(8)\n}\n\n/// The C program dies from SIGSEGV when an out-of-bounds table index reaches\n/// past the pages holding its static data.\npub fn raise_sigsegv() -> ! {\n    die_with_signal(11)\n}\n\nuse cscan::Scanner;\nuse stb_perlin::*;\n\n#[allow(clippy::too_many_arguments)]\nfn inner(\n    which: i32,\n    x: f32,\n    y: f32,\n    z: f32,\n    x_wrap: i32,\n    y_wrap: i32,\n    z_wrap: i32,\n    seed: i32,\n    lacunarity: f32,\n    gain: f32,\n    offset: f32,\n    octaves: i32,\n) -> f32 {\n    match which {\n        0 => stb_perlin_noise3(x, y, z, x_wrap, y_wrap, z_wrap),\n        1 => stb_perlin_noise3_seed(x, y, z, x_wrap, y_wrap, z_wrap, seed),\n        2 => stb_perlin_ridge_noise3(x, y, z, lacunarity, gain, offset, octaves),\n        3 => stb_perlin_fbm_noise3(x, y, z, lacunarity, gain, octaves),\n        4 => stb_perlin_turbulence_noise3(x, y, z, lacunarity, gain, octaves),\n        5 => stb_perlin_noise3_wrap_nonpow2(x, y, z, x_wrap, y_wrap, z_wrap, seed as u8),\n        _ => f32::NAN,\n    }\n}\n\nfn main() {\n    let mut which: i32 = 0;\n    let mut x: f32 = 0.0;\n    let mut y: f32 = 0.0;\n    let mut z: f32 = 0.0;\n    let mut x_wrap: i32 = 0;\n    let mut y_wrap: i32 = 0;\n    let mut z_wrap: i32 = 0;\n    let mut seed: i32 = 0;\n    let mut lacunarity: f32 = 0.0;\n    let mut gain: f32 = 0.0;\n    let mut offset: f32 = 0.0;\n    let mut octaves: i32 = 0;\n\n    let mut input = Vec::new();\n    let _ = std::io::stdin().read_to_end(&mut input);\n    let mut sc = Scanner::new(input);\n\n    // scanf(\"%d%f%f%f%d%d%d%d%f%f%f%d\", ...): conversions stop at the first\n    // matching/input failure, leaving the remaining variables untouched.\n    'scan: {\n        match sc.scan_int() {\n            Some(v) => which = v,\n            None => break 'scan,\n        }\n        match sc.scan_f32() {\n            Some(v) => x = v,\n            None => break 'scan,\n        }\n        match sc.scan_f32() {\n            Some(v) => y = v,\n            None => break 'scan,\n        }\n        match sc.scan_f32() {\n            Some(v) => z = v,\n            None => break 'scan,\n        }\n        match sc.scan_int() {\n            Some(v) => x_wrap = v,\n            None => break 'scan,\n        }\n        match sc.scan_int() {\n            Some(v) => y_wrap = v,\n            None => break 'scan,\n        }\n        match sc.scan_int() {\n            Some(v) => z_wrap = v,\n            None => break 'scan,\n        }\n        match sc.scan_int() {\n            Some(v) => seed = v,\n            None => break 'scan,\n        }\n        match sc.scan_f32() {\n            Some(v) => lacunarity = v,\n            None => break 'scan,\n        }\n        match sc.scan_f32() {\n            Some(v) => gain = v,\n            None => break 'scan,\n        }\n        match sc.scan_f32() {\n            Some(v) => offset = v,\n            None => break 'scan,\n        }\n        match sc.scan_int() {\n            Some(v) => octaves = v,\n            None => break 'scan,\n        }\n    }\n\n    let res = inner(\n        which, x, y, z, x_wrap, y_wrap, z_wrap, seed, lacunarity, gain, offset, octaves,\n    );\n\n    // printf(\"%.9g\\n\", res) -- res is promoted to double.\n    let out = cformat::format_g(res as f64, 9);\n    let stdout = std::io::stdout();\n    let mut lock = stdout.lock();\n    let _ = writeln!(lock, \"{}\", out);\n    let _ = lock.flush();\n}\n","structuredPatch":[{"oldStart":11,"oldLines":10,"newStart":11,"newLines":14,"lines":[" fn die_with_signal(sig: i32) -> ! {","     extern \"C\" {","         fn raise(sig: i32) -> i32;","+        fn signal(sig: i32, handler: usize) -> usize;","     }","-    // SAFETY: `raise` only sends a signal to this process; the signals used","-    // here are fatal by default, so this does not return.","+    // SAFETY: restoring the default disposition (SIG_DFL == 0) and then","+    // signalling this process; both signals are fatal by default, so the call","+    // to `raise` does not return. The Rust runtime installs a SIGSEGV handler","+    // for stack-overflow reporting, which has to be removed first.","     unsafe {","+        signal(sig, 0);","         raise(sig);","     }","     std::process::abort();"]}],"userModified":false,"replaceAll":false}}
