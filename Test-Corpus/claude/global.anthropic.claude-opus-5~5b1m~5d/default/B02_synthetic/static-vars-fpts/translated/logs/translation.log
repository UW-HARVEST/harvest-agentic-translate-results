atafile(\"exact8191.txt\", \"b\" * 8191)\nf_8193 = datafile(\"big8193.txt\", \"c\" * 8193)\nf_nul = datafile(\"withnul.bin\", b\"abc\\x00def ghi\\n\")\nf_hi = datafile(\"highbytes.bin\", bytes(range(128, 256)) + b\"\\n\")\nf_dir = os.path.join(data, \"adir\")\nos.makedirs(f_dir)\ndatafile(\"adir/inner.txt\", \"hello\\n\")\n\n# ---------------------------------------------------------------- cases\ncase(\"01_basic\", \"1\\nint x = 42; // hi\\nfloat y = 3.14;\\n\\n3\\n4\\n5\\nx\\n6\\nif (a==b) { c++; }\\n\\n7\\n\")\ncase(\"02_empty_stdin\", \"\")\ncase(\"03_only_newline\", \"\\n\")\ncase(\"04_invalid_input\", \"abc\\n\\nxyz\\n7\\n\")\ncase(\"05_invalid_choice\", \"0\\n8\\n-1\\n99\\n7\\n\")\ncase(\"06_eof_after_2\", \"2\\n\")\ncase(\"07_eof_after_5\", \"5\\n\")\ncase(\"08_eof_in_case1\", \"1\\nsome text here\\nmore text\")\ncase(\"09_eof_after_1\", \"1\\n\")\ncase(\"10_file_ok\", \"2\\n%s\\n3\\n4\\n7\\n\" % f_small)\ncase(\"11_file_missing\", \"2\\n/nonexistent/path/xyz\\n7\\n\")\ncase(\"12_file_empty\", \"2\\n%s\\n3\\n7\\n\" % f_empty)\ncase(\"13_file_8192\", \"2\\n%s\\n3\\n7\\n\" % f_8192)\ncase(\"14_file_8191\", \"2\\n%s\\n4\\n7\\n\" % f_8191)\ncase(\"15_file_8193\", \"2\\n%s\\n7\\n\" % f_8193)\ncase(\"16_file_nul\", \"2\\n%s\\n3\\n7\\n\" % f_nul)\ncase(\"17_file_highbytes\", \"2\\n%s\\n3\\n7\\n\" % f_hi)\ncase(\"18_file_dir\", \"2\\n%s\\n3\\n7\\n\" % f_dir)\ncase(\"19_file_code\", \"2\\n%s\\n3\\n4\\n5\\n\\n7\\n\" % f_code)\ncase(\"20_pattern_empty\", \"1\\nfoo bar foo\\n\\n5\\n\\n7\\n\")\ncase(\"21_pattern_multi\", \"1\\nalpha beta alphabet alpha\\n\\n5\\nalpha\\n5\\nzzz\\n7\\n\")\ncase(\"22_no_analysis_yet\", \"3\\n4\\n5\\nx\\n7\\n\")\n\n# long single line (fgets splits at 255)\nlong_line = \"w\" * 300 + \"\\n\"\ncase(\"23_long_line\", \"1\\n\" + long_line + \"\\n3\\n7\\n\")\n\n# identifier longer than MAX_TOKEN_LENGTH\ncase(\"24_long_token\", \"6\\n\" + \"i\" * 400 + \"\\n\\n7\\n\")\n\n# text longer than MAX_INPUT_SIZE (4096)\nbig_text = \"\".join(\"word%d \" % i for i in range(1200)) + \"\\n\"\ncase(\"25_big_text\", \"1\\n\" + big_text + \"\\n3\\n4\\n7\\n\")\n\n# more than 100 distinct words\nmany_words = \" \".join(\"w%d\" % i for i in range(150)) + \"\\n\"\ncase(\"26_many_words\", \"1\\n\" + many_words + \"\\n3\\n7\\n\")\n\n# repeated words with ties for the bubble sort\ncase(\n    \"27_word_ties\",\n    \"1\\na b c a b c a d e\\n\\n3\\n1\\na a b\\n\\n3\\n7\\n\",\n)\n\n# more than 100 tokens in interactive tokenizer\ntoks = \" \".join(\"t%d + \" % i for i in range(80)) + \"\\n\"\ncase(\"28_interactive_trunc\", \"6\\n\" + toks + \"\\n7\\n\")\n\n# multi-line comment spanning newlines -> negative columns\ncase(\"29_multiline_comment\", \"6\\n/* abc\\ndef */ x\\n\\n7\\n\")\n\n# unterminated string / char literals, escapes\ncase(\"30_strings\", \"6\\n\\\"abc\\\\\\\"def\\\" 'x' \\\"unterminated\\n\\n7\\n\")\n\n# operators and punctuation coverage\ncase(\"31_operators\", \"6\\n+ - * / % = < > ! & | ^ ~ ? : == != <= >= && || ++ -- -> << >>\\n\\n7\\n\")\ncase(\"32_punct\", \"6\\n( ) { } [ ] ; , . @ # $ ` \\\\ \\n\\n7\\n\")\n\n# numbers\ncase(\"33_numbers\", \"6\\n1 12.34 1.2.3 .5 0. 007 9999999999999999999\\n\\n7\\n\")\n\n# CRLF input\ncase(\"34_crlf\", \"1\\r\\nint x;\\r\\n\\r\\n3\\r\\n7\\r\\n\")\n\n# NUL bytes in stdin\ncase(\"35_nul_stdin\", b\"1\\nab\\x00cd\\nef\\n\\n3\\n7\\n\")\n\n# choice parsing oddities\ncase(\"36_choice_parsing\", \"  3\\n+4\\n3abc\\n7xyz\\n\")\ncase(\"37_choice_overflow\", \"99999999999999999999\\n-99999999999999999999\\n7\\n\")\ncase(\"38_choice_leading_ws\", \"\\t\\t 4 \\n7\\n\")\n\n# whitespace-only text for case 1\ncase(\"39_ws_text\", \"1\\n   \\t  \\n\\n3\\n7\\n\")\n\n# repeat analysis several times (cumulative statistics)\ncase(\"40_cumulative\", \"1\\nint a;\\n\\n1\\nfloat b;\\n\\n1\\nchar c;\\n\\n3\\n4\\n7\\n\")\n\n# high bytes typed interactively\ncase(\"41_high_bytes_stdin\", b\"6\\n\\xc3\\xa9\\xe2\\x82\\xac abc\\n\\n7\\n\")\n\n# exactly 100 tokens then 101 tokens\ncase(\"42_exactly_101\", \"6\\n\" + \" \".join([\"a\"] * 101) + \"\\n\\n7\\n\")\ncase(\"43_exactly_100\", \"6\\n\" + \" \".join([\"a\"] * 100) + \"\\n\\n7\\n\")\n\n# no trailing newline on last choice\ncase(\"44_no_trailing_nl\", \"3\\n4\\n7\")\n\n# choice 6 with immediate empty line\ncase(\"45_interactive_empty\", \"6\\n\\n7\\n\")\n\n# choice 1 with immediate empty line\ncase(\"46_analyze_empty\", \"1\\n\\n3\\n7\\n\")\n\n# string token that hits the 256 byte boundary exactly\ns = '\"' + \"x\" * 252 + '\"' + \"\\n\"\ncase(\"47_string_boundary\", \"6\\n\" + s + \"\\n7\\n\")\ns2 = '\"' + \"y\" * 253 + '\"' + \"\\n\"\ncase(\"48_string_boundary2\", \"6\\n\" + s2 + \"\\n7\\n\")\ns3 = '\"' + \"z\" * 254 + '\"' + \"\\n\"\ncase(\"49_string_boundary3\", \"6\\n\" + s3 + \"\\n7\\n\")\ns4 = '\"' + (\"a\" * 251) + \"\\\\\\\"\" + '\"' + \"\\n\"\ncase(\"50_string_escape_boundary\", \"6\\n\" + s4 + \"\\n7\\n\")\n\n# comment boundary cases\ncase(\"51_comment_boundary\", \"6\\n/*\" + \"c\" * 260 + \"*/\\n\\n7\\n\")\ncase(\"52_line_comment_boundary\", \"6\\n//\" + \"d\" * 300 + \"\\n\\n7\\n\")\ncase(\"53_lone_slash\", \"6\\na / b\\n\\n7\\n\")\n\n# pattern search with special chars\ncase(\"54_pattern_special\", \"1\\nx=y;\\n\\n5\\n=\\n5\\n;\\n7\\n\")\n\n# very many menu iterations\ncase(\"55_menu_spam\", \"\".join(\"3\\n4\\n\" for _ in range(5)) + \"7\\n\")\n\n# filename with trailing spaces / empty filename\ncase(\"56_empty_filename\", \"2\\n\\n7\\n\")\ncase(\"57_filename_ws\", \"2\\n   \\n7\\n\")\n\n# interactive tokenizer where load fails (text >= 4096 is impossible: capped)\ncase(\"58_interactive_big\", \"6\\n\" + big_text + \"\\n7\\n\")\n\n# keywords all\nkw = (\"if else while for return int char float double void struct typedef const \"\n      \"static extern auto register sizeof break continue switch case default do \"\n      \"goto enum union signed unsigned long short\\n\")\ncase(\"59_keywords\", \"1\\n\" + kw + \"\\n3\\n4\\n7\\n\")\n\n# mixed everything, several rounds\ncase(\n    \"60_mixed\",\n    \"1\\nint main() { /* c */ return \\\"s\\\"; }\\n\\n3\\n4\\n5\\nmain\\n6\\nx+y\\n\\n2\\n\"\n    + f_code\n    + \"\\n3\\n4\\n5\\n\\n7\\n\",\n)\nprint(\"cases:\", len(os.listdir(cases)))\n","structuredPatch":[{"oldStart":3,"oldLines":7,"newStart":3,"newLines":10,"lines":[" import os"," import shutil"," ","-base = os.path.join(os.getcwd(), \"_ref\")","+base = os.environ.get(","+    \"REFBASE\",","+    os.path.join(\"/local/home/scheschb/.harvest/work/harvest-work-f6bG1Z\", \"_ref\"),","+)"," cases = os.path.join(base, \"cases\")"," data = os.path.join(base, \"data\")"," shutil.rmtree(cases, ignore_errors=True)"]}],"userModified":false,"replaceAll":false}}
