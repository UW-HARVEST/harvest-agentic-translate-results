{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ulyo74ff6h4nf7vthunmujgpdg5v3xibaw3ouivacsy7zwg6jima","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01BqP4cUuxjfafUi2yt2oyLG","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-f6bG1Z/_ref/gen_cases2.py","content":"#!/usr/bin/env python3\n\"\"\"Second batch of differential-test inputs (boundary conditions).\"\"\"\nimport os\n\nbase = \"/local/home/scheschb/.harvest/work/harvest-work-f6bG1Z/_ref\"\ncases = os.path.join(base, \"cases\")\ndata = os.path.join(base, \"data\")\nos.makedirs(cases, exist_ok=True)\nos.makedirs(data, exist_ok=True)\n\n\ndef case(name, content):\n    with open(os.path.join(cases, name), \"wb\") as f:\n        f.write(content if isinstance(content, bytes) else content.encode())\n\n\ndef datafile(name, content):\n    p = os.path.join(data, name)\n    with open(p, \"wb\") as f:\n        f.write(content if isinstance(content, bytes) else content.encode())\n    return p\n\n\n# string whose scanned length reaches exactly 256 (1 byte past the C buffer)\ns256 = '\"' + \"a\" * 252 + \"\\\\q\" + '\"' + \"\\n\"\ncase(\"61_string_len256\", \"6\\n\" + s256 + \"\\n7\\n\")\n# and 255 / 254\ncase(\"62_string_len255\", \"6\\n\" + '\"' + \"b\" * 253 + '\"' + \"\\n\" + \"\\n7\\n\")\ncase(\"63_string_len254\", \"6\\n\" + '\"' + \"c\" * 252 + '\"' + \"\\n\" + \"\\n7\\n\")\n# escape at the very end of the buffer\ncase(\"64_string_escape_eof\", \"6\\n\\\"abc\\\\\", )\ncase(\"65_string_backslash_nl\", \"6\\n\\\"abc\\\\\\n\\n7\\n\")\n\n# identifier of exactly 255 / 256 characters\ncase(\"66_ident255\", \"6\\n\" + \"i\" * 255 + \"\\n\\n7\\n\")\ncase(\"67_ident256\", \"6\\n\" + \"j\" * 256 + \"\\n\\n7\\n\")\n\n# line comment hitting exactly 255\ncase(\"68_linecomment255\", \"6\\n//\" + \"e\" * 253 + \"\\n\\n7\\n\")\ncase(\"69_linecomment256\", \"6\\n//\" + \"f\" * 254 + \"\\n\\n7\\n\")\n\n# multi line comment hitting the 254/255 boundary\ncase(\"70_mlcomment\", \"6\\n/*\" + \"g\" * 251 + \"*/x\\n\\n7\\n\")\ncase(\"71_mlcomment2\", \"6\\n/*\" + \"h\" * 252 + \"*/x\\n\\n7\\n\")\ncase(\"72_mlcomment_unterminated\", \"6\\n/* not closed\\nstill\\n\\n7\\n\")\ncase(\"73_mlcomment_star\", \"6\\n/*a*b*/x\\n\\n7\\n\")\n\n# choice line longer than the 256 byte fgets buffer: the remainder is parsed\n# as the next choice\ncase(\"74_choice_split\", \"3\" + \"z\" * 300 + \"\\n7\\n\")\ncase(\"75_choice_split_num\", \"3\" + \" \" * 254 + \"4\\n7\\n\")\n\n# filename longer than the fgets buffer\ncase(\"76_filename_split\", \"2\\n\" + \"/tmp/\" + \"n\" * 300 + \"\\n7\\n\")\n\n# a line of exactly 255 characters plus newline in case 1 (fgets splits so the\n# continuation line starts with '\\n' and stops the loop)\ncase(\"77_line255\", \"1\\n\" + \"k\" * 255 + \"\\n\\n3\\n7\\n\")\ncase(\"78_line254\", \"1\\n\" + \"l\" * 254 + \"\\n\\n3\\n7\\n\")\ncase(\"79_line256\", \"1\\n\" + \"m\" * 256 + \"\\n\\n3\\n7\\n\")\n\n# \\v and \\f whitespace\ncase(\"80_vf_ws\", b\"6\\na\\x0bb\\x0cc\\td\\re\\n\\n7\\n\")\n\n# analyze, then a failing load, then pattern search over the stale buffer\nf8192 = os.path.join(data, \"exact8192.txt\")\ncase(\"81_stale_buffer\", \"1\\nint zz = 5;\\n\\n2\\n\" + f8192 + \"\\n5\\nzz\\n3\\n4\\n7\\n\")\n\n# pattern with high bytes and long pattern\ncase(\"82_pattern_high\", b\"1\\nabc\\n\\n5\\n\\xc3\\xa9\\n5\\n\" + b\"q\" * 200 + b\"\\n7\\n\")\n\n# interactive tokenizer with immediate EOF\ncase(\"83_interactive_eof\", \"6\\n\")\ncase(\"84_interactive_eof2\", \"6\")\n\n# empty text then distribution then complexity\ncase(\"85_empty_then_stats\", \"1\\n\\n3\\n4\\n1\\n\\n3\\n4\\n7\\n\")\n\n# 100 distinct words exactly, then more\ncase(\"86_words100\", \"1\\n\" + \" \".join(\"q%d\" % i for i in range(100)) + \"\\n\\n3\\n7\\n\")\ncase(\"87_words101\", \"1\\n\" + \" \".join(\"r%d\" % i for i in range(101)) + \"\\n\\n3\\n7\\n\")\n\n# words with counts to exercise the bubble sort ordering\nfreq = []\nfor i in range(12):\n    freq.extend([\"w%d\" % i] * (i + 1))\ncase(\"88_word_freq\", \"1\\n\" + \" \".join(freq) + \"\\n\\n3\\n3\\n7\\n\")\n\n# repeated distribution printing (sorting is destructive/persistent)\ncase(\"89_repeat_dist\", \"1\\na b b c c c\\n\\n3\\n3\\n3\\n7\\n\")\n\n# file with only newlines\nfnl = datafile(\"newlines.txt\", \"\\n\" * 50)\ncase(\"90_file_newlines\", \"2\\n\" + fnl + \"\\n3\\n4\\n7\\n\")\n\n# file with mixed binary\nfbin = datafile(\"bin.dat\", bytes(range(1, 128)) * 3)\ncase(\"91_file_bin\", \"2\\n\" + fbin + \"\\n3\\n4\\n7\\n\")\n\n# file exactly 4096 and 8000 bytes\nf4096 = datafile(\"f4096.txt\", \"int a; \" * 585 + \"x\")\ncase(\"92_file_4096\", \"2\\n\" + f4096 + \"\\n3\\n7\\n\")\nf8000 = datafile(\"f8000.txt\", (\"abc def \" * 1000)[:8000])\ncase(\"93_file_8000\", \"2\\n\" + f8000 + \"\\n3\\n4\\n7\\n\")\n\n# file that starts with NUL\nfnul0 = datafile(\"nulfirst.bin\", b\"\\x00abc def\\n\")\ncase(\"94_file_nul_first\", \"2\\n\" + fnul0 + \"\\n3\\n7\\n\")\n\n# choice 0 padded, negative, float-ish\ncase(\"95_choice_float\", \"1.9\\n7\\n\")\ncase(\"96_choice_minus0\", \"-0\\n7\\n\")\ncase(\"97_choice_plus7\", \"+7\\n\")\ncase(\"98_choice_space7\", \" 7 \\n\")\n\n# many rounds of everything\nseq = \"\"\nfor i in range(3):\n    seq += \"1\\nint v%d = %d; /* c%d */\\n\\n3\\n4\\n5\\nv\\n6\\nv%d++\\n\\n\" % (i, i, i, i)\nseq += \"7\\n\"\ncase(\"99_many_rounds\", seq)\n\n# unknown/error tokens\ncase(\"A0_error_tokens\", b\"6\\n@ # $ \\x01 \\x7f \\xff\\n\\n7\\n\")\n\n# text ending without newline in interactive mode\ncase(\"A1_no_nl_interactive\", \"6\\nabc\")\n\n# a quote as the last char\ncase(\"A2_quote_last\", \"6\\n\\\"\\n\\n7\\n\")\ncase(\"A3_single_quote\", \"6\\n'a' 'bc' '\\n\\n7\\n\")\n\nprint(\"total cases:\", len(os.listdir(cases)))\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":745,"cache_read_input_tokens":76829,"cache_creation":{"ephemeral_5m_input_tokens"