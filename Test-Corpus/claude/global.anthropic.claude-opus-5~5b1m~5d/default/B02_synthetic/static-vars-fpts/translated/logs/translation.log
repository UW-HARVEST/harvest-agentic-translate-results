keywords for recognition\n44\tstatic const char *keywords[] = {\n45\t    \"if\", \"else\", \"while\", \"for\", \"return\", \"int\", \"char\", \n46\t    \"float\", \"double\", \"void\", \"struct\", \"typedef\", \"const\",\n47\t    \"static\", \"extern\", \"auto\", \"register\", \"sizeof\", \"break\",\n48\t    \"continue\", \"switch\", \"case\", \"default\", \"do\", \"goto\",\n49\t    \"enum\", \"union\", \"signed\", \"unsigned\", \"long\", \"short\"\n50\t};\n51\tstatic const int num_keywords = sizeof(keywords) / sizeof(keywords[0]);\n52\t\n53\t// Static helper functions (internal to this file)\n54\tstatic int is_keyword(const char *str) {\n55\t    for (int i = 0; i < num_keywords; i++) {\n56\t        if (strcmp(str, keywords[i]) == 0) {\n57\t            return 1;\n58\t        }\n59\t    }\n60\t    return 0;\n61\t}\n62\t\n63\tstatic char peek_char(void) {\n64\t    if (current_position >= buffer_length) {\n65\t        return '\\0';\n66\t    }\n67\t    return input_buffer[current_position];\n68\t}\n69\t\n70\tstatic char advance_char(void) {\n71\t    if (current_position >= buffer_length) {\n72\t        return '\\0';\n73\t    }\n74\t    \n75\t    char c = input_buffer[current_position++];\n76\t    total_chars_processed++;\n77\t    \n78\t    if (c == '\\n') {\n79\t        current_line++;\n80\t        current_column = 1;\n81\t        total_lines_processed++;\n82\t    } else {\n83\t        current_column++;\n84\t    }\n85\t    \n86\t    return c;\n87\t}\n88\t\n89\tstatic void skip_whitespace(void) {\n90\t    while (peek_char() != '\\0' && isspace(peek_char()) && peek_char() != '\\n') {\n91\t        advance_char();\n92\t    }\n93\t}\n94\t\n95\tstatic token_t create_token(token_type_t type, const char *value, size_t length) {\n96\t    token_t token;\n97\t    token.type = type;\n98\t    token.length = length < MAX_TOKEN_LENGTH ? length : MAX_TOKEN_LENGTH - 1;\n99\t    strncpy(token.value, value, token.length);\n100\t    token.value[token.length] = '\\0';\n101\t    token.line =