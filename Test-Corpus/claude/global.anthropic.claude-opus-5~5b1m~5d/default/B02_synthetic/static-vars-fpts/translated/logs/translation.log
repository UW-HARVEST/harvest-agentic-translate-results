 256)) + b\"\\n\")\nf_dir = os.path.join(data, \"adir\")\nos.makedirs(f_dir)\ndatafile(\"adir/inner.txt\", \"hello\\n\")\n\n# ---------------------------------------------------------------- cases\ncase(\"01_basic\", \"1\\nint x = 42; // hi\\nfloat y = 3.14;\\n\\n3\\n4\\n5\\nx\\n6\\nif (a==b) { c++; }\\n\\n7\\n\")\ncase(\"02_empty_stdin\", \"\")\ncase(\"03_only_newline\", \"\\n\")\ncase(\"04_invalid_input\", \"abc\\n\\nxyz\\n7\\n\")\ncase(\"05_invalid_choice\", \"0\\n8\\n-1\\n99\\n7\\n\")\ncase(\"06_eof_after_2\", \"2\\n\")\ncase(\"07_eof_after_5\", \"5\\n\")\ncase(\"08_eof_in_case1\", \"1\\nsome text here\\nmore text\")\ncase(\"09_eof_after_1\", \"1\\n\")\ncase(\"10_file_ok\", \"2\\n%s\\n3\\n4\\n7\\n\" % f_small)\ncase(\"11_file_missing\", \"2\\n/nonexistent/path/xyz\\n7\\n\")\ncase(\"12_file_empty\", \"2\\n%s\\n3\\n7\\n\" % f_empty)\ncase(\"13_file_8192\", \"2\\n%s\\n3\\n7\\n\" % f_8192)\ncase(\"14_file_8191\", \"2\\n%s\\n4\\n7\\n\" % f_8191)\ncase(\"15_file_8193\", \"2\\n%s\\n7\\n\" % f_8193)\ncase(\"16_file_nul\", \"2\\n%s\\n3\\n7\\n\" % f_nul)\ncase(\"17_file_highbytes\", \"2\\n%s\\n3\\n7\\n\" % f_hi)\ncase(\"18_file_dir\", \"2\\n%s\\n3\\n7\\n\" % f_dir)\ncase(\"19_file_code\", \"2\\n%s\\n3\\n4\\n5\\n\\n7\\n\" % f_code)\ncase(\"20_pattern_empty\", \"1\\nfoo bar foo\\n\\n5\\n\\n7\\n\")\ncase(\"21_pattern_multi\", \"1\\nalpha beta alphabet alpha\\n\\n5\\nalpha\\n5\\nzzz\\n7\\n\")\ncase(\"22_no_analysis_yet\", \"3\\n4\\n5\\nx\\n7\\n\")\n\n# long single line (fgets splits at 255)\nlong_line = \"w\" * 300 + \"\\n\"\ncase(\"23_long_line\", \"1\\n\" + long_line + \"\\n3\\n7\\n\")\n\n# identifier longer than MAX_TOKEN_LENGTH\ncase(\"24_long_token\", \"6\\n\" + \"i\" * 400 + \"\\n\\n7\\n\")\n\n# text longer than MAX_INPUT_SIZE (4096)\nbig_text = \"\".join(\"word%d \" % i for i in range(1200)) + \"\\n\"\ncase(\"25_big_text\", \"1\\n\" + big_text + \"\\n3\\n4\\n7\\n\")\n\n# more than 100 distinct words\nmany_words = \" \".join(\"w%d\" % i for i in range(150)) + \"\\n\"\nc