ords: {}\\n\", result.keyword_count));\n    35\t    out_str(&format!(\"Operators: {}\\n\", result.operator_count));\n    36\t    out_str(&format!(\"Comments: {}\\n\", result.comment_count));\n    37\t    out_str(&format!(\"Strings: {}\\n\", result.string_count));\n    38\t    out_str(&format!(\"Lines: {}\\n\", result.line_count));\n    39\t    out_str(&format!(\"Characters: {}\\n\", result.char_count));\n    40\t}\n    41\t\n    42\t/// `strncat(dest, src, n)` where `dest` is a C string of capacity `capacity`.\n    43\tfn strncat(dest: &mut Vec<u8>, src: &[u8], n: usize) {\n    44\t    let src = c_str(src);\n    45\t    let take = src.len().min(n);\n    46\t    dest.extend_from_slice(&src[..take]);\n    47\t}\n    48\t\n    49\tfn interactive_tokenizer(ops: TokenizerOps) {\n    50\t    out_str(\"\\nEnter text (empty line to stop):\\n\");\n    51\t\n    52\t    let mut input: Vec<u8> = Vec::new();\n    53\t\n    54\t    while let Some(line) = fgets(256) {\n    55\t        if line[0] == b'\\n' {\n    56\t            break;\n    57\t        }\n    58\t        let remaining = MAX_INPUT_SIZE - input.len() - 1;\n    59\t        strncat(&mut input, &line, remaining);\n    60\t    }\n    61\t\n    62\t    if (ops.load_text)(&input) != 0 {\n    63\t        out_str(\"Failed to load text\\n\");\n    64\t        return;\n    65\t    }\n    66\t\n    67\t    out_str(\"\\n=== Tokens ===\\n\");\n    68\t\n    69\t    const TOKEN_TYPE_NAMES: [&str; 12] = [\n    70\t        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCT\", \"SPACE\", \"NEWLINE\", \"IDENT\", \"KEYWORD\", \"OPERATOR\",\n    71\t        \"STRING\", \"COMMENT\", \"ERROR\",\n    72\t    ];\n    73\t\n    74\t    let mut count = 0;\n    75\t\n    76\t    loop {\n    77\t        let token = (ops.next_token)();\n    78\t        if token.ttype == TokenType::Eof {\n    79\t            break;\n    80\t        }\n    81\t\n    82\t        out_str(&format!(\"[{}] '\", TOKEN_TYPE_NAMES[token.ttype.index()]));\n    83\t        out_bytes(&