UT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t#ifndef ANALYZER_H\n    26\t#define ANALYZER_H\n    27\t\n    28\t#include \"tokenizer.h\"\n    29\t\n    30\ttypedef struct {\n    31\t    size_t word_count;\n    32\t    size_t number_count;\n    33\t    size_t keyword_count;\n    34\t    size_t operator_count;\n    35\t    size_t comment_count;\n    36\t    size_t string_count;\n    37\t    size_t line_count;\n    38\t    size_t char_count;\n    39\t} analysis_result_t;\n    40\t\n    41\t// Initialize analyzer with tokenizer operations\n    42\tvoid analyzer_init(tokenizer_ops_t ops);\n    43\t\n    44\t// Perform analysis using function pointers\n    45\tanalysis_result_t analyze_text(const char *text);\n    46\t\n    47\t// Get detailed token statistics\n    48\tvoid print_token_distribution(void);\n    49\t\n    50\t// Analyze code complexity\n    51\tint calculate_complexity_score(void);\n    52\t\n    53\t// Find patterns in the text\n    54\tvoid find_patterns(const char *pattern);\n    55\t\n    56\t#endif // ANALYZER_H\n=========== c_src/include/tokenizer.h ===========\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t#ifndef TOKENIZER_H\n    26\t#define TOKENIZER_H\n    27\t\n    28\t#include <stddef.h>\n    29\t\n    30\t#define MAX_TOKEN_LENGTH 256\n    31\t#define MAX_BUFFER_SIZE 8192\n    32\t\n    33\ttypedef enum {\n    34\t    TOKEN_EOF = 0,\n    35\t    TOKEN_WORD,\n    36\t    TOKEN_NUMBER,\n    37\t    TOKEN_PUNCTUATION,\n    38\t    TOKEN_WHITESPACE,\n    39\t    TOKEN_NEWLINE,\n    40\t    TOKEN_IDENTIFIER,\n    41\t    TOKEN_KEYWORD,\n    42\t    TOKEN_OPERATOR,\n    43\t    TOKEN_STRING,\n    44\t    TOKEN_COMMENT,\n    45\t    TOKEN_ERROR\n    46\t} token_type_t;\n    47\t\n    48\ttypedef struct {\n    49\t    token_type_t type;\n    50\t    char value[MAX_TOKEN_LENGTH];\n    51\t    size_t length;\n    52\t    int line;\n    53\t    int column;\n    54\t} token_t;\n    55\t\n    56\t// Function pointer types for tokenizer operations\n    57\ttypedef token_t (*tokenizer_next_fn)(void);\n    58\ttypedef token_t (*tokenizer_peek_fn)(void);\n    59\ttypedef void (*tokenizer_reset_fn)(void);\n    60\ttypedef int (*tokenizer_load_fn)(const char *text);\n    61\ttypedef void (*tokenizer_get_stats_fn)(size_t *lines, size_t *tokens, size_t *chars);\n    62\t\n    63\t// Tokenizer operations structure\n    64\ttypedef struct {\n    65\t    tokenizer_next_fn next_token;\n    66\t    tokenizer_peek_fn peek_token;\n    67\t    tokenizer_reset_fn reset;\n    68\t    tokenizer_load_fn load_text;\n    69\t    tokenizer_get_stats_fn get_stats;\n    70\t} tokenizer_ops_t;\n    71\t\n    72\t// Get tokenizer operations (returns function pointers)\n    73\ttokenizer_ops_t get_tokenizer_ops(void);\n    74\t\n    75\t// Individual functions (can also be called directly)\n    76\ttoken_t tokenizer_next_token(void);\n    77\ttoken_t tokenizer_peek_token(void);\n    78\tvoid tokenizer_reset(void);\n    79\tint tokenizer_load_text(const char *text);\n    80\tvoid tokenizer_get_stats(size_t *lines, size_t *tokens, size_t *chars);\n    81\t\n    82\t#endif // TOKENIZER_H\n=========== c_src/src/main.c ===========\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t// main.c\n    26\t#include <stdio.h>\n    27\t#include <stdlib.h>\n    28\t#include <string.h>\n    29\t#include \"tokenizer.h\"\n    30\t#include \"analyzer.h\"\n    31\t\n    32\t#define MAX_INPUT_SIZE 4096\n    33\t\n    34\tvoid print_menu(void) {\n    35\t    printf(\"\\n=== Text Analyzer ===\\n\");\n    36\t    printf(\"1. Analyze text\\n\");\n    37\t    printf(\"2. Load text from file\\n\");\n    38\t    printf(\"3. Show token distribution\\n\");\n    39\t    printf(\"4. Calculate complexity score\\n\");\n    40\t    printf(\"5. Find pattern\\n\");\n    41\t    printf(\"6. Interactive tokenizer\\n\");\n    42\t    printf(\"7. Exit\\n\");\n    43\t    printf(\"Choice: \");\n    44\t}\n    45\t\n    46\tvoid print_analysis_result(analysis_result_t result) {\n    47\t    printf(\"\\n=== Analysis Results ===\\n\");\n    48\t    printf(\"Words/Identifiers: %zu\\n\", result.word_count);\n    49\t    printf(\"Numbers: %zu\\n\", result.number_count);\n    50\t    printf(\"Keywords: %zu\\n\", result.keyword_count);\n    51\t    printf(\"Operators: %zu\\n\", result.operator_count);\n    52\t    printf(\"Comments: %zu\\n\", result.comment_count);\n    53\t    printf(\"Strings: %zu\\n\", result.string_count);\n    54\t    printf(\"Lines: %zu\\n\", result.line_count);\n    55\t    printf(\"Characters: %zu\\n\", result.char_count);\n    56\t}\n    57\t\n    58\tvoid interactive_tokenizer(tokenizer_ops_t ops) {\n    59\t    printf(\"\\nEnter text (empty line to stop):\\n\");\n    60\t    \n    61\t    char input[MAX_INPUT_SIZE] = \"\";\n    62\t    char line[256];\n    63\t    \n    64\t    while (fgets(line, sizeof(line), stdin)) {\n    65\t        if (line[0] == '\\n') {\n    66\t            break;\n    67\t        }\n    68\t        strncat(input, line, MAX_INPUT_SIZE - strlen(input) - 1);\n    69\t    }\n    70\t    \n    71\t    if (ops.load_text(input) != 0) {\n    72\t        printf(\"Failed to load text\\n\");\n    73\t        return;\n    74\t    }\n    75\t    \n    76\t    printf(\"\\n=== Tokens ===\\n\");\n    77\t    \n    78\t    const char *token_type_names[] = {\n    79\t        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCT\", \"SPACE\",\n    80\t        \"NEWLINE\", \"IDENT\", \"KEYWORD\", \"OPERATOR\", \n    81\t        \"STRING\", \"COMMENT\", \"ERROR\"\n    82\t    };\n    83\t    \n    84\t    token_t token;\n    85\t    int count = 0;\n    86\t    \n    87\t    while ((token = ops.next_token()).type != TOKEN_EOF) {\n    88\t        printf(\"[%s] '%s' (L%d:C%d)\\n\",\n    89\t               token_type_names[token.type],\n    90\t               token.value,\n    91\t               token.line,\n    92\t               token.column);\n    93\t        count++;\n    94\t        \n    95\t        if (count > 100) {\n    96\t            printf(\"... (truncated, too many tokens)\\n\");\n    97\t            break;\n    98\t        }\n    99\t    }\n   100\t}\n   101\t\n   102\tchar* read_file(const char *filename) {\n   103\t    FILE *file = fopen(filename, \"r\");\n   104\t    if (!file) {\n   105\t        fprintf(stderr, \"Error: Could not open file '%s'\\n\", filename);\n   106\t        return NULL;\n   107\t    }\n   108\t    \n   109\t    fseek(file, 0, SEEK_END);\n   110\t    long size = ftell(file);\n   111\t    fseek(file, 0, SEEK_SET);\n   112\t    \n   113\t    if (size > MAX_BUFFER_SIZE) {\n   114\t        fprintf(stderr, \"Error: File too large\\n\");\n   115\t        fclose(file);\n   116\t        return NULL;\n   117\t    }\n   118\t    \n   119\t    char *content = malloc(size + 1);\n   120\t    if (!content) {\n   121\t        fprintf(stderr, \"Error: Memory allocation failed\\n\");\n   122\t        fclose(file);\n   123\t        return NULL;\n   124\t    }\n   125\t    \n   126\t    size_t read_size = fread(content, 1, size, file);\n   127\t    content[read_size] = '\\0';\n   128\t    \n   129\t    fclose(file);\n   130\t    return content;\n   131\t}\n   132\t\n   133\tint main(void) {\n   134\t    // Get tokenizer operations (function pointers)\n   135\t    tokenizer_ops_t ops = get_tokenizer_ops();\n   136\t    \n   137\t    // Initialize analyzer with function pointers\n   138\t    analyzer_init(ops);\n   139\t    \n   140\t    printf(\"Text Analysis and Tokenization System\\n\");\n   141\t    printf(\"This system demonstrates function pointers and static globals\\n\");\n   142\t    \n   143\t    char input[256];\n   144\t    int choice;\n   145\t    \n   146\t    while (1) {\n   147\t        print_menu();\n   148\t        \n   149\t        if (!fgets(input, sizeof(input), stdin)) {\n   150\t            break;\n   151\t        }\n   152\t        \n   153\t        if (sscanf(input, \"%d\", &choice) != 1) {\n   154\t            printf(\"Invalid input\\n\");\n   155\t            continue;\n   156\t        }\n   157\t        \n   158\t        switch (choice) {\n   159\t            case 1: {\n   160\t                printf(\"Enter text to analyze (empty line to stop):\\n\");\n   161\t                char text[MAX_INPUT_SIZE] = \"\";\n   162\t                char line[256];\n   163\t                \n   164\t                while (fgets(line, sizeof(line), stdin)) {\n   165\t                    if (line[0] == '\\n') {\n   166\t                        break;\n   167\t                    }\n   168\t                    strncat(text, line, MAX_INPUT_SIZE - strlen(text) - 1);\n   169\t                }\n   170\t                \n   171\t                analysis_result_t result = analyze_text(text);\n   172\t                print_analysis_result(result);\n   173\t                break;\n   174\t            }\n   175\t            \n   176\t            case 2: {\n   177\t                printf(\"Enter filename: \");\n   178\t                if (!fgets(input, sizeof(input), stdin)) {\n   179\t                    break;\n   180\t                }\n   181\t                input[strcspn(input, \"\\n\")] = 0;\n   182\t                \n   183\t                char *content = read_file(input);\n   184\t                if (content) {\n   185\t                    analysis_result_t result = analyze_text(content);\n   186\t                    print_analysis_result(result);\n   187\t                    free(content);\n   188\t                }\n   189\t                break;\n   190\t            }\n   191\t            \n   192\t            case 3: {\n   193\t                print_token_distribution();\n   194\t                break;\n   195\t            }\n   196\t            \n   197\t            case 4: {\n   198\t                int score = calculate_complexity_score();\n   199\t                printf(\"\\nComplexity Score: %d\\n\", score);\n   200\t                if (score < 10) {\n   201\t                    printf(\"Complexity: Low\\n\");\n   202\t                } else if (score < 50) {\n   203\t                    printf(\"Complexity: Medium\\n\");\n   204\t                } else {\n   205\t                    printf(\"Complexity: High\\n\");\n   206\t                }\n   207\t                break;\n   208\t            }\n   209\t            \n   210\t            case 5: {\n   211\t                printf(\"Enter pattern to search: \");\n   212\t                if (!fgets(input, sizeof(input), stdin)) {\n   213\t                    break;\n   214\t                }\n   215\t                input[strcspn(input, \"\\n\")] = 0;\n   216\t                \n   217\t                find_patterns(input);\n   218\t                break;\n   219\t            }\n   220\t            \n   221\t            case 6: {\n   222\t                interactive_tokenizer(ops);\n   223\t                break;\n   224\t            }\n   225\t            \n   226\t            case 7: {\n   227\t                printf(\"Goodbye!\\n\");\n   228\t                return 0;\n   229\t            }\n   230\t            \n   231\t            default:\n   232\t                printf(\"Invalid choice\\n\");\n   233\t                break;\n   234\t        }\n   235\t    }\n   236\t    \n   237\t    return 0;\n   238\t}\n=========== c_src/src/tokenizer.c ===========\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t#include \"tokenizer.h\"\n    26\t#include <stdio.h>\n    27\t#include <stdlib.h>\n    28\t#include <string.h>\n    29\t#include <ctype.h>\n    30\t\n    31\t// Static global variables (file-local scope)\n    32\tstatic char input_buffer[MAX_BUFFER_SIZE];\n    33\tstatic size_t buffer_length = 0;\n    34\tstatic size_t current_position = 0;\n    35\tstatic int current_line = 1;\n    36\tstatic int current_column = 1;\n    37\tstatic size_t total_tokens_processed = 0;\n    38\tstatic size_t total_lines_processed = 0;\n    39\tstatic size_t total_chars_processed = 0;\n    40\tstatic token_t lookahead_token;\n    41\tstatic int lookahead_valid = 0;\n    42\t\n    43\t// Static keywords for recognition\n    44\tstatic const char *keywords[] = {\n    45\t    \"if\", \"else\", \"while\", \"for\", \"return\", \"int\", \"char\", \n    46\t    \"float\", \"double\", \"void\", \"struct\", \"typedef\", \"const\",\n    47\t    \"static\", \"extern\", \"auto\", \"register\", \"sizeof\", \"break\",\n    48\t    \"continue\", \"switch\", \"case\", \"default\", \"do\", \"goto\",\n    49\t    \"enum\", \"union\", \"signed\", \"unsigned\", \"long\", \"short\"\n    50\t};\n    51\tstatic const int num_keywords = sizeof(keywords) / sizeof(keywords[0]);\n    52\t\n    53\t// Static helper functions (internal to this file)\n    54\tstatic int is_keyword(const char *str) {\n    55\t    for (int i = 0; i < num_keywords; i++) {\n    56\t        if (strcmp(str, keywords[i]) == 0) {\n    57\t            return 1;\n    58\t        }\n    59\t    }\n    60\t    return 0;\n    61\t}\n    62\t\n    63\tstatic char peek_char(void) {\n    64\t    if (current_position >= buffer_length) {\n    65\t        return '\\0';\n    66\t    }\n    67\t    return input_buffer[current_position];\n    68\t}\n    69\t\n    70\tstatic char advance_char(void) {\n    71\t    if (current_position >= buffer_length) {\n    72\t        return '\\0';\n    73\t    }\n    74\t    \n    75\t    char c = input_buffer[current_position++];\n    76\t    total_chars_processed++;\n    77\t    \n    78\t    if (c == '\\n') {\n    79\t        current_line++;\n    80\t        current_column = 1;\n    81\t        total_lines_processed++;\n    82\t    } else {\n    83\t        current_column++;\n    84\t    }\n    85\t    \n    86\t    return c;\n    87\t}\n    88\t\n    89\tstatic void skip_whitespace(void) {\n    90\t    while (peek_char() != '\\0' && isspace(peek_char()) && peek_char() != '\\n') {\n    91\t        advance_char();\n    92\t    }\n    93\t}\n    94\t\n    95\tstatic token_t create_token(token_type_t type, const char *value, size_t length) {\n    96\t    token_t token;\n    97\t    token.type = type;\n    98\t    token.length = length < MAX_TOKEN_LENGTH ? length : MAX_TOKEN_LENGTH - 1;\n    99\t    strncpy(token.value, value, token.length);\n   100\t    token.value[token.length] = '\\0';\n   101\t    token.line = current_line;\n   102\t    token.column = current_column - token.length;\n   103\t    total_tokens_processed++;\n   104\t    return token;\n   105\t}\n   106\t\n   107\tstatic token_t scan_word(void) {\n   108\t    char buffer[MAX_TOKEN_LENGTH];\n   109\t    size_t length = 0;\n   110\t    \n   111\t    while (peek_char() != '\\0' && \n   112\t           (isalnum(peek_char()) || peek_char() == '_') && \n   113\t           length < MAX_TOKEN_LENGTH - 1) {\n   114\t        buffer[length++] = advance_char();\n   115\t    }\n   116\t    \n   117\t    buffer[length] = '\\0';\n   118\t    \n   119\t    // Check if it's a keyword\n   120\t    if (is_keyword(buffer)) {\n   121\t        return create_token(TOKEN_KEYWORD, buffer, length);\n   122\t    }\n   123\t    \n   124\t    return create_token(TOKEN_IDENTIFIER, buffer, length);\n   125\t}\n   126\t\n   127\tstatic token_t scan_number(void) {\n   128\t    char buffer[MAX_TOKEN_LENGTH];\n   129\t    size_t length = 0;\n   130\t    int has_decimal = 0;\n   131\t    \n   132\t    while (peek_char() != '\\0' && \n   133\t           (isdigit(peek_char()) || peek_char() == '.') && \n   134\t           length < MAX_TOKEN_LENGTH - 1) {\n   135\t        \n   136\t        if (peek_char() == '.') {\n   137\t            if (has_decimal) {\n   138\t                break; // Second decimal point\n   139\t            }\n   140\t            has_decimal = 1;\n   141\t        }\n   142\t        \n   143\t        buffer[length++] = advance_char();\n   144\t    }\n   145\t    \n   146\t    buffer[length] = '\\0';\n   147\t    return create_token(TOKEN_NUMBER, buffer, length);\n   148\t}\n   149\t\n   150\tstatic token_t scan_string(void) {\n   151\t    char buffer[MAX_TOKEN_LENGTH];\n   152\t    size_t length = 0;\n   153\t    char quote = advance_char(); // Consume opening quote\n   154\t    \n   155\t    buffer[length++] = quote;\n   156\t    \n   157\t    while (peek_char() != '\\0' && \n   158\t           peek_char() != quote && \n   159\t           peek_char() != '\\n' &&\n   160\t           length < MAX_TOKEN_LENGTH - 2) {\n   161\t        \n   162\t        if (peek_char() == '\\\\') {\n   163\t            buffer[length++] = advance_char(); // Escape character\n   164\t            if (peek_char() != '\\0') {\n   165\t                buffer[length++] = advance_char(); // Escaped character\n   166\t            }\n   167\t        } else {\n   168\t            buffer[length++] = advance_char();\n   169\t        }\n   170\t    }\n   171\t    \n   172\t    if (peek_char() == quote) {\n   173\t        buffer[length++] = advance_char(); // Closing quote\n   174\t    }\n   175\t    \n   176\t    buffer[length] = '\\0';\n   177\t    return create_token(TOKEN_STRING, buffer, length);\n   178\t}\n   179\t\n   180\tstatic token_t scan_comment(void) {\n   181\t    char buffer[MAX_TOKEN_LENGTH];\n   182\t    size_t length = 0;\n   183\t    \n   184\t    // Assume we've seen '/'\n   185\t    buffer[length++] = advance_char(); // First '/'\n   186\t    \n   187\t    if (peek_char() == '/') {\n   188\t        // Single-line comment\n   189\t        buffer[length++] = advance_char(); // Second '/'\n   190\t        \n   191\t        while (peek_char() != '\\0' && \n   192\t               peek_char() != '\\n' && \n   193\t               length < MAX_TOKEN_LENGTH - 1) {\n   194\t            buffer[length++] = advance_char();\n   195\t        }\n   196\t    } else if (peek_char() == '*') {\n   197\t        // Multi-line comment\n   198\t        buffer[length++] = advance_char(); // '*'\n   199\t        \n   200\t        while (peek_char() != '\\0' && length < MAX_TOKEN_LENGTH - 2) {\n   201\t            if (peek_char() == '*') {\n   202\t  