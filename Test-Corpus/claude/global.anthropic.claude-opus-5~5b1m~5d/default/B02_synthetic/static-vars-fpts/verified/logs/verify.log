62\t        \n    63\t        switch (token.type) {\n    64\t            case TOKEN_WORD:\n    65\t            case TOKEN_IDENTIFIER:\n    66\t                result.word_count++;\n    67\t                track_word(token.value);\n    68\t                break;\n    69\t                \n    70\t            case TOKEN_NUMBER:\n    71\t                result.number_count++;\n    72\t                break;\n    73\t                \n    74\t            case TOKEN_KEYWORD:\n    75\t                result.keyword_count++;\n    76\t                break;\n    77\t                \n    78\t            case TOKEN_OPERATOR:\n    79\t                result.operator_count++;\n    80\t                break;\n    81\t                \n    82\t            case TOKEN_COMMENT:\n    83\t                result.comment_count++;\n    84\t                break;\n    85\t                \n    86\t            case TOKEN_STRING:\n    87\t                result.string_count++;\n    88\t                break;\n    89\t                \n    90\t            case TOKEN_NEWLINE:\n    91\t                result.line_count++;\n    92\t                break;\n    93\t                \n    94\t            default:\n    95\t                break;\n    96\t        }\n    97\t    }\n    98\t    \n    99\t    // Get final statistics using function pointer\n   100\t    size_t lines, tokens, chars;\n   101\t    tokenizer_ops.get_stats(&lines, &tokens, &chars);\n   102\t    \n   103\t    result.line_count = lines;\n   104\t    result.char_count = chars;\n   105\t    \n   106\t    return result;\n   107\t}\n   108\t\n   109\tvoid print_token_distribution(void) {\n   110\t    printf(\"\\n=== Token Distribution ===\\n\");\n   111\t    \n   112\t    const char *token_names[] = {\n   113\t        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCTUATION\", \"WHITESPACE\",\n   114\t        \"NEWLINE\", \"IDENTIFIER\", \"KEYWORD\", \"OPERATOR\", \n   115\t        \"STRING\", \"COMMENT\", \"ERROR\"\n   116\t    };\n   117\t    \n   118\t    for (int i = 0; i < 12; i++) {\n   119\t        if (token_type_counts[i] > 0) {\n   120\t            printf(\"%s: %d\\n\", token_names[i], token_type_counts[i]);\n   121\t        }\n   122\t    }\n   123\t    \n   124\t    printf(\"\\n=== Most Common Words ===\\n\");\n   125\t    \n   126\t    // Simple bubble sort for display\n   127\t    for (int i = 0; i < num_common_words - 1; i++) {\n   128\t        for (int j = 0; j < num_common_words - i - 1; j++) {\n   129\t            if (common_word_counts[j] < common_word_counts[j + 1]) {\n   130\t                // Swap counts\n   131\t                int temp_count = common_word_counts[j];\n   132\t                common_word_counts[j] = common_word_counts[j + 1];\n   133\t                common_word_counts[j + 1] = temp_count;\n   134\t                \n   135\t                // Swap words\n   136\t                char temp_word[MAX_TOKEN_LENGTH];\n   137\t                strcpy(temp_word, common_words[j]);\n   138\t                strcpy(common_words[j], common_words[j + 1]);\n   139\t                strcpy(common_words[j + 1], temp_word);\n   140\t            }\n   141\t        }\n   142\t    }\n   143\t    \n   144\t    // Print top 10\n   145\t    int limit = num_common_words < 10 ? num_common_words : 10;\n   146\t    for (int i = 0; i < limit; i++) {\n   147\t        printf(\"%d. %s: %d times\\n\", i + 1, common_words[i], common_word_counts[i]);\n   148\t    }\n   149\t}\n   150\t\n   151\tint calculate_complexity_score(void) {\n   152\t    int score = 0;\n   153\t    \n   154\t    // Base score on keyword density\n   155\t    score += token_type_counts[TOKEN_KEYWORD] * 2;\n   156\t    \n   157\t    // Add points for operators\n   158\t    score += token_type_counts[TOKEN_OPERATOR];\n   159\t    \n   160\t    // Nesting indicators (braces)\n   161\t    score += token_type_counts[TOKEN_PUNCTUATION] / 10;\n   162\t    \n   163\t    // Comments reduce complexity (good documentation)\n   164\t    score -= token_type_counts[TOKEN_COMMENT];\n   165\t    \n   166\t    if (score < 0) score = 0;\n   167\t    \n   168\t    return score;\n   169\t}\n   170\t\n   171\tvoid find_patterns(const char *pattern) {\n   172\t    if (!initialized || !pattern) {\n   173\t        return;\n   174\t    }\n   175\t    \n   176\t    printf(\"\\n=== Searching for pattern: '%s' ===\\n\", pattern);\n   177\t    \n   178\t    // Reset tokenizer using function pointer\n   179\t    tokenizer_ops.reset();\n   180\t    \n   181\t    int count = 0;\n   182\t    token_t token;\n   183\t    \n   184\t    while ((token = tokenizer_ops.next_token()).type != TOKEN_EOF) {\n   185\t        if (strstr(token.value, pattern) != NULL) {\n   186\t            printf(\"Line %d, Column %d: %s\\n\", \n   187\t                   token.line, token.column, token.value);\n   188\t            count++;\n   189\t        }\n   190\t    }\n   191\t    \n   192\t    printf(\"Found %d occurrences\\n\", count);\n   193\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
