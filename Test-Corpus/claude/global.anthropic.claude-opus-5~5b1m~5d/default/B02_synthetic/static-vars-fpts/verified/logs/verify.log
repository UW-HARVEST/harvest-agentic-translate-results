{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GasJ6i9RAbDicEVRVu1nAV","type":"tool_result","content":"     1\t//! Translation of `analyzer.c` / `analyzer.h`.\n     2\t\n     3\tuse std::cell::RefCell;\n     4\t\n     5\tuse crate::cio::{c_strstr, err_str, out_bytes, out_str};\n     6\tuse crate::tokenizer::{TokenType, TokenizerOps, MAX_TOKEN_LENGTH};\n     7\t\n     8\t#[derive(Default, Copy, Clone)]\n     9\tpub struct AnalysisResult {\n    10\t    pub word_count: usize,\n    11\t    pub number_count: usize,\n    12\t    pub keyword_count: usize,\n    13\t    pub operator_count: usize,\n    14\t    pub comment_count: usize,\n    15\t    pub string_count: usize,\n    16\t    pub line_count: usize,\n    17\t    pub char_count: usize,\n    18\t}\n    19\t\n    20\t// Static storage for tokenizer function pointers / static arrays for tracking\n    21\tstruct AnalyzerState {\n    22\t    tokenizer_ops: Option<TokenizerOps>,\n    23\t    initialized: bool,\n    24\t    token_type_counts: [i32; 20],\n    25\t    common_words: Vec<Vec<u8>>,\n    26\t    common_word_counts: Vec<i32>,\n    27\t    num_common_words: i32,\n    28\t}\n    29\t\n    30\timpl AnalyzerState {\n    31\t    fn new() -> AnalyzerState {\n    32\t        AnalyzerState {\n    33\t            tokenizer_ops: None,\n    34\t            initialized: false,\n    35\t            token_type_counts: [0; 20],\n    36\t            common_words: vec![Vec::new(); 100],\n    37\t            common_word_counts: vec![0; 100],\n    38\t            num_common_words: 0,\n    39\t        }\n    40\t    }\n    41\t\n    42\t    fn track_word(&mut self, word: &[u8]) {\n    43\t        // Find if word already exists\n    44\t        for i in 0..self.num_common_words as usize {\n    45\t            if self.common_words[i] == word {\n    46\t                self.common_word_counts[i] += 1;\n    47\t                return;\n    48\t            }\n    49\t        }\n    50\t\n    51\t        // Add new word\n    52\t        if self.num_common_words < 100 {\n    53\t            let idx = self.num_common_words as usize;\n    54\t            let copy_len = word.len().min(MAX_TOKEN_LENGTH - 1);\n    55\t            self.common_words[idx] = word[..copy_len].to_vec();\n    56\t            self.common_word_counts[idx] = 1;\n    57\t            self.num_common_words += 1;\n    58\t        }\n    59\t    }\n    60\t}\n    61\t\n    62\tthread_local! {\n    63\t    static STATE: RefCell<AnalyzerState> = RefCell::new(AnalyzerState::new());\n    64\t}\n    65\t\n    66\tpub fn analyzer_init(ops: TokenizerOps) {\n    67\t    STATE.with(|cell| {\n    68\t        let mut state = cell.borrow_mut();\n    69\t        state.tokenizer_ops = Some(ops);\n    70\t        state.initialized = true;\n    71\t\n    72\t        // Reset tracking arrays\n    73\t        state.token_type_counts = [0; 20];\n    74\t        for count in state.common_word_counts.iter_mut() {\n    75\t            *count = 0;\n    76\t        }\n    77\t        state.num_common_words = 0;\n    78\t    });\n    79\t}\n    80\t\n    81\tpub fn analyze_text(text: &[u8]) -> AnalysisResult {\n    82\t    let mut result = AnalysisResult::default();\n    83\t\n    84\t    let ops = STATE.with(|cell| {\n    85\t        let state = cell.borrow();\n    86\t        if !state.initialized {\n    87\t            None\n    88\t        } else {\n    89\t            state.tokenizer_ops\n    90\t        }\n    91\t    });\n    92\t\n    93\t    let ops = match ops {\n    94\t        Some(ops) => ops,\n    95\t        None => {\n    96\t            err_str(\"Error: Analyzer not initialized\\n\");\n    97\t            return result;\n    98\t        }\n    99\t    };\n   100\t\n   101\t    // Load text using function pointer\n   102\t    if (ops.load_text)(text) != 0 {\n   103\t        err_str(\"Error: Failed to load text\\n\");\n   104\t        return result;\n   105\t    }\n   106\t\n   107\t    // Process all tokens using function pointers\n   108\t    loop {\n   109\t        let token = (ops.next_token)();\n   110\t        if token.ttype == TokenType::Eof {\n   111\t            break;\n   112\t        }\n   113\t\n   114\t        // Update counts\n   115\t        STATE.with(|cell| {\n   116\t            let mut state = cell.borrow_mut();\n   117\t            state.token_type_counts[token.ttype.index()] += 1;\n   118\t\n   119\t            match token.ttype {\n   120\t                TokenType::Word | TokenType::Identifier => {\n   121\t                    result.word_count += 1;\n   122\t                    state.track_word(&token.value);\n   123\t                }\n   124\t\n   125\t                TokenType::Number => {\n   126\t                    result.number_count += 1;\n   127\t                }\n   128\t\n   129\t                TokenType::Keyword => {\n   130\t                    result.keyword_count += 1;\n   131\t                }\n   132\t\n   133\t                TokenType::Operator => {\n   134\t                    result.operator_count += 1;\n   135\t                }\n   136\t\n   137\t                TokenType::Comment => {\n   138\t                    result.comment_count += 1;\n   139\t                }\n   140\t\n   141\t                TokenType::Str => {\n   142\t                    result.string_count += 1;\n   143\t                }\n   144\t\n   145\t                TokenType::Newline => {\n   146\t                    result.line_count += 1;\n   147\t                }\n   148\t\n   149\t                _ => {}\n   150\t            }\n   151\t        });\n   152\t    }\n   153\t\n   154\t    // Get final statistics using function pointer\n   155\t    let (lines, _tokens, chars) = (ops.get_stats)();\n   156\t\n   157\t    result.line_count = lines;\n   158\t    result.char_count = chars;\n   159\t\n   160\t    result\n   161\t}\n   162\t\n   163\tpub fn print_token_distribution() {\n   164\t    out_str(\"\\n=== Token Distribution ===\\n\");\n   165\t\n   166\t    const TOKEN_NAMES: [&str; 12] = [\n   167\t        \"EOF\",\n   168\t        \"WORD\",\n   169\t        \"NUMBER\",\n   170\t        \"PUNCTUATION\",\n   171\t        \"WHITESPACE\",\n   172\t        \"NEWLINE\",\n   173\t        \"IDENTIFIER\",\n   174\t        \"KEYWORD\",\n   175\t        \"OPERATOR\",\n   176\t        \"STRING\",\n   177\t        \"COMMENT\",\n   178\t        \"ERROR\",\n   179\t    ];\n   180\t\n   181\t    STATE.with(|cell| {\n   182\t        let mut state = cell.borrow_mut();\n   183\t\n   184\t        for i in 0..12 {\n   185\t            if state.token_type_counts[i] > 0 {\n   186\t                out_str(&format!(\"{}: {}\\n\", TOKEN_NAMES[i], state.token_type_counts[i]));\n   187\t            }\n   188\t        }\n   189\t\n   190\t        out_str(\"\\n=== Most Common Words ===\\n\");\n   191\t\n   192\t        // Simple bubble sort for display\n   193\t        let num = state.num_common_words;\n   194\t        let mut i = 0i32;\n   195\t        while i < num - 1 {\n   196\t            let mut j = 0i32;\n   197\t            while j < num - i - 1 {\n   198\t                let a = j as usize;\n   199\t                let b = (j + 1) as usize;\n   200\t                if state.common_word_counts[a] < state.common_word_counts[b] {\n   201\t                    // Swap counts\n   202\t                    state.common_word_counts.swap(a, b);\n   203\t\n   204\t                    // Swap words\n   205\t                    state.common_words.swap(a, b);\n   206\t                }\n   207\t                j += 1;\n   208\t            }\n   209\t            i += 1;\n   210\t        }\n   211\t\n   212\t        // Print top 10\n   213\t        let limit = if state.num_common_words < 10 {\n   214\t            state.num_common_words\n   215\t        } else {\n   216\t            10\n   217\t        };\n   218\t        for i in 0..limit {\n   219\t            let idx = i as usize;\n   220\t            out_str(&format!(\"{}. \", i + 1));\n   221\t            out_bytes(&state.common_words[idx]);\n   222\t            out_str(&format!(\": {} times\\n\", state.common_word_counts[idx]));\n   223\t        }\n   224\t    });\n   225\t}\n   226\t\n   227\tpub fn calculate_complexity_score() -> i32 {\n   228\t    STATE.with(|cell| {\n   229\t        let state = cell.borrow();\n   230\t        let mut score: i32 = 0;\n   231\t\n   232\t        // Base score on keyword density\n   233\t        score += state.token_type_counts[TokenType::Keyword.index()] * 2;\n   234\t\n   235\t        // Add points for operators\n   236\t        score += state.token_type_counts[TokenType::Operator.index()];\n   237\t\n   238\t        // Nesting indicators (braces)\n   239\t        score += state.token_type_counts[TokenType::Punctuation.index()] / 10;\n   240\t\n   241\t        // Comments reduce complexity (good documentation)\n   242\t        score -= state.token_type_counts[TokenType::Comment.index()];\n   243\t\n   244\t        if score < 0 {\n   245\t            score = 0;\n   246\t        }\n   247\t\n   248\t        score\n   249\t    })\n   250\t}\n   251\t\n   252\tpub fn find_patterns(pattern: &[u8]) {\n   253\t    let ops = STATE.with(|cell| {\n   254\t        let state = cell.borrow();\n   255\t        if !state.initialized {\n   256\t            None\n   257\t        } else {\n   258\t            state.tokenizer_ops\n   259\t        }\n   260\t    });\n   261\t\n   262\t    let ops = match ops {\n   263\t        Some(ops) => ops,\n   264\t        None => return,\n   265\t    };\n   266\t\n   267\t    out_str(\"\\n=== Searching for pattern: '\");\n   268\t    out_bytes(pattern);\n   269\t    out_str(\"' ===\\n\");\n   270\t\n   271\t    // Reset tokenizer using function pointer\n   272\t    (ops.reset)();\n   273\t\n   274\t    let mut count: i32 = 0;\n   275\t\n   276\t    loop {\n   277\t        let token = (ops.next_token)();\n   278\t        if token.ttype == TokenType::Eof {\n   279\t            break;\n   280\t        }\