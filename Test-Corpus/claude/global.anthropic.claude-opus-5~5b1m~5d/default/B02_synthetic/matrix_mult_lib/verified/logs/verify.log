river                          (driver.c)\n    15\t//! ```\n    16\t//!\n    17\t//! There are no namespace/renaming macros in the headers, so the linker names\n    18\t//! are the source-level names.\n    19\t\n    20\tpub mod cffi;\n    21\tpub mod driver;\n    22\tpub mod matrix;\n    23\tpub mod write;\n########## translation/src/cffi.rs ##########\n     1\t//! Minimal hand-rolled bindings to the pieces of libc that the original C\n     2\t//! sources use.\n     3\t//!\n     4\t//! The C library hands `malloc`-ed pointers out across its public ABI (for\n     5\t//! example `matrix_to_string` returns a buffer that the caller releases with\n     6\t//! `free`), so the translation must use the *same* allocator rather than\n     7\t//! Rust's. Likewise all diagnostics are routed through the C `stderr` stream\n     8\t//! and `perror`/`strerror` so that the emitted bytes, their ordering, and the\n     9\t//! stream buffering behaviour are bit-for-bit identical to the C build.\n    10\t\n    11\t#![allow(non_camel_case_types)]\n    12\t\n    13\tuse core::ffi::{c_char, c_int, c_void};\n    14\t\n    15\t/// Opaque stand-in for C's `FILE`.\n    16\t#[repr(C)]\n    17\tpub struct FILE {\n    18\t    _opaque: [u8; 0],\n    19\t}\n    20\t\n    21\tunsafe extern \"C\" {\n    22\t    pub static mut stderr: *mut FILE;\n    23\t\n    24\t    pub fn malloc(size: usize) -> *mut c_void;\n    25\t    pub fn free(ptr: *mut c_void);\n    26\t\n    27\t    pub fn strdup(s: *const c_char) -> *mut c_char;\n    28\t    pub fn strcat(dest: *mut c_char, src: *const c_char) -> *mut c_char;\n    29\t    pub fn snprintf(buf: *mut c_char, size: usize, fmt: *const c_char, ...) -> c_int;\n    30\t    pub fn strtok_r(\n    31\t        s: *mut c_char,\n    32\t        delim: *const c_char,\n    33\t        saveptr: *mut *mut c_char,\n    34\t    ) -> *mut c_char;\n    35\t    pub fn strerror(errnum: c_int) -> *mut c_char;\n    36\t    pub fn atoi(s: *const c_char) -> c_int;\n    37\t\n    38\t    pub fn perror(s: *const c_char);\n    39\t    pub fn fprintf(stream: *mut FILE, fmt: *const c_char, ...) -> c_int;\n    40\t    pub fn fopen(filename: *const c_char, mode: *const c_char) -> *mut FILE;\n    41\t    pub fn fclose(stream: *mut FILE) -> c_int;\n    42\t\n    43\t    pub fn __errno_location() -> *mut c_int;\n    44\t}\n    45\t\n    46\t/// `errno`, read at the exact point the C code reads it.\n    47\t#[inline]\n    48\tpub fn errno() -> c_int {\n    49\t    unsafe { *__errno_location() }\n    50\t}\n    51\t\n    52\t/// The C `stderr` stream.\n    53\t#[inline]\n    54\tpub fn stderr_stream() -> *mut FILE {\n    55\t    unsafe { stderr }\n    56\t}\n    57\t\n    58\t/// `EINVAL` from `<errno.h>` on Linux/glibc.\n    59\tpub const EINVAL: c_int = 22;\n    60\t\n    61\t/// `EXIT_SUCCESS` from `<stdlib.h>`.\n    62\tpub const EXIT_SUCCESS: c_int = 0;\n    63\t\n    64\t/// `EXIT_FAILURE` from `<stdlib.h>`.\n    65\tpub const EXIT_FAILURE: c_int = 1;\n########## translation/src/matrix.rs ##########\n     1\t//! Translation of `c_src/src/matrix.c` (public surface in `c_src/include/matrix.h`).\n     2\t//!\n     3\t//! Note that `allocate_matrix` is *not* declared in the header, but it is not\n     4\t//! `static` either, so the C shared object exports it. It is reproduced here as\n     5\t//! a public `extern \"C\"` symbol for that reason.\n     6\t\n     7\t#![allow(non_camel_case_types)]\n     8\t\n     9\tuse core::ffi::{c_char, c_int, c_void};\n    10\tuse core::ptr;\n    11\t\n    12\tuse crate::cffi::{\n    13\t    atoi, fprintf, free, malloc, perror, snprintf, stderr_stream, strcat, strdup, strtok_r,\n    14\t};\n    15\t\n    16\t/// ```c\n    17\t/// typedef struct {\n    18\t///     int** matrix;\n    19\t///     int width;\n    20\t///     int height;\n    21\t/// } matrix_t;\n    22\t/// ```\n    23\t#[repr(C)]\n    24\tpub struct matrix_t {\n    25\t    pub matrix: *mut *mut c_int,\n    26\t    pub width: c_int,\n    27\t    pub height: c