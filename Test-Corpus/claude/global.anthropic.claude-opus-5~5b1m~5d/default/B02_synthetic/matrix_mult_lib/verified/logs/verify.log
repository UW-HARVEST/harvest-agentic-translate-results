ee(mat as *mut c_void);\n    99\t}\n   100\t\n   101\t#[unsafe(no_mangle)]\n   102\tpub unsafe extern \"C\" fn initialize_matrix_from_string(\n   103\t    input: *const c_char,\n   104\t    width: c_int,\n   105\t    height: c_int,\n   106\t) -> *mut matrix_t {\n   107\t    // The C code deliberately does not check `mat` for NULL here; preserved.\n   108\t    let mat = allocate_matrix(width, height);\n   109\t\n   110\t    let input_copy = strdup(input);\n   111\t    if input_copy.is_null() {\n   112\t        perror(c\"Failed to duplicate input string\".as_ptr());\n   113\t        free_matrix(mat);\n   114\t        return ptr::null_mut();\n   115\t    }\n   116\t\n   117\t    let mut saveptr_row: *mut c_char = ptr::null_mut();\n   118\t    let mut row_token = strtok_r(input_copy, c\"\\n\".as_ptr(), &mut saveptr_row);\n   119\t\n   120\t    let mut i: c_int = 0;\n   121\t    while i < height {\n   122\t        if row_token.is_null() {\n   123\t            fprintf(\n   124\t                stderr_stream(),\n   125\t                c\"Insufficient rows in input string.\\n\".as_ptr(),\n   126\t            );\n   127\t            free(input_copy as *mut c_void);\n   128\t            free_matrix(mat);\n   129\t            return ptr::null_mut();\n   130\t        }\n   131\t\n   132\t        let mut saveptr_col: *mut c_char = ptr::null_mut();\n   133\t        let mut col_token = strtok_r(row_token, c\" \".as_ptr(), &mut saveptr_col);\n   134\t\n   135\t        let mut j: c_int = 0;\n   136\t        while j < width {\n   137\t            if col_token.is_null() {\n   138\t                fprintf(\n   139\t                    stderr_stream(),\n   140\t                    c\"Insufficient columns in row %d.\\n\".as_ptr(),\n   141\t                    i.wrapping_add(1),\n   142\t                );\n   143\t                free(input_copy as *mut c_void);\n   144\t                free_matrix(mat);\n   145\t                return ptr::null_mut();\n   146\t            }\n   147\t  