".as_ptr(), content) < 0 {\n    29\t        let saved = errno();\n    30\t        fprintf(\n    31\t            stderr_stream(),\n    32\t            c\"Error writing to file '%s': %s\\n\".as_ptr(),\n    33\t            filename,\n    34\t            strerror(saved),\n    35\t        );\n    36\t        fclose(file);\n    37\t        return errno();\n    38\t    }\n    39\t\n    40\t    if fclose(file) != 0 {\n    41\t        let saved = errno();\n    42\t        fprintf(\n    43\t            stderr_stream(),\n    44\t            c\"Error closing file '%s': %s\\n\".as_ptr(),\n    45\t            filename,\n    46\t            strerror(saved),\n    47\t        );\n    48\t        return errno();\n    49\t    }\n    50\t\n    51\t    0\n    52\t}\n########## translation/src/driver.rs ##########\n     1\t//! Translation of `c_src/src/driver.c`.\n     2\t\n     3\tuse core::ffi::{c_char, c_int, c_void};\n     4\t\n     5\tuse crate::cffi::{free, EXIT_FAILURE, EXIT_SUCCESS};\n     6\tuse crate::matrix::{\n     7\t    free_matrix, initialize_matrix_from_string, matrix_to_string, multiply_matrices,\n     8\t};\n     9\tuse crate::write::write_to_file;\n    10\t\n    11\t/// `#define OUT_FILE \"matrix.txt\"`\n    12\tconst OUT_FILE: &core::ffi::CStr = c\"matrix.txt\";\n    13\t\n    14\t#[unsafe(no_mangle)]\n    15\tpub unsafe extern \"C\" fn driver(\n    16\t    width_a: c_int,\n    17\t    height_a: c_int,\n    18\t    matrix_a: *const c_char,\n    19\t    width_b: c_int,\n    20\t    height_b: c_int,\n    21\t    matrix_b: *const c_char,\n    22\t) -> c_int {\n    23\t    let mat_a = initialize_matrix_from_string(matrix_a, width_a, height_a);\n    24\t    if mat_a.is_null() {\n    25\t        return EXIT_FAILURE;\n    26\t    }\n    27\t    let mat_b = initialize_matrix_from_string(matrix_b, width_b, height_b);\n    28\t    if mat_b.is_null() {\n    29\t        free_matrix(mat_a);\n    30\t        return EXIT_FAILURE;\n    31\t    }\n    32\t\n    33\t    let res = multi