"SUMMARY\"\nif [ \"$fail\" -eq 0 ]; then\n  echo \"ALL CONFIGURATIONS PASSED\"\nelse\n  echo \"FAILURES PRESENT\"\nfi\nexit \"$fail\"\n","structuredPatch":[],"originalFile":null,"userModified":false}}
