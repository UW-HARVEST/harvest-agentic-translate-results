at->width = width;\n    41\t    mat->height = height;\n    42\t\n    43\t    mat->matrix = malloc(height * sizeof(int*));\n    44\t    if (mat->matrix == NULL) {\n    45\t        perror(\"Failed to allocate memory for matrix rows\");\n    46\t        free(mat);\n    47\t        return NULL;\n    48\t    }\n    49\t\n    50\t    for (int i = 0; i < height; i++) {\n    51\t        mat->matrix[i] = malloc(width * sizeof(int));\n    52\t        if (mat->matrix[i] == NULL) {\n    53\t            perror(\"Failed to allocate memory for matrix columns\");\n    54\t            for (int j = 0; j <= i; j++) {\n    55\t                free(mat->matrix[j]);\n    56\t            }\n    57\t            free(mat->matrix);\n    58\t            free(mat);\n    59\t            return NULL;\n    60\t        }\n    61\t    }\n    62\t\n    63\t    return mat;\n    64\t}\n    65\t\n    66\tvoid free_matrix(matrix_t* mat) {\n    67\t    if (mat == NULL) {\n    68\t        return;\n    69\t    }\n    70\t\n    71\t    for (int i = 0; i < mat->height; i++) {\n    72\t        free(mat->matrix[i]);\n    73\t    }\n    74\t    free(mat->matrix);\n    75\t    free(mat);\n    76\t}\n    77\t\n    78\tmatrix_t* initialize_matrix_from_string(const char* input, int width, int height) {\n    79\t    matrix_t* mat = allocate_matrix(width, height);\n    80\t\n    81\t    char* input_copy = strdup(input);\n    82\t    if (input_copy == NULL) {\n    83\t        perror(\"Failed to duplicate input string\");\n    84\t        free_matrix(mat);\n    85\t        return NULL;\n    86\t    }\n    87\t\n    88\t    char* saveptr_row;\n    89\t    char* row_token = strtok_r(input_copy, \"\\n\", &saveptr_row);\n    90\t    for (int i = 0; i < height; i++) {\n    91\t        if (row_token == NULL) {\n    92\t            fprintf(stderr, \"Insufficient rows in input string.\\n\");\n    93\t            free(input_copy);\n    94\t            free_matrix(mat);\n    95\t            return NULL;\n    96\t        }\n    9