ll() {\n   123\t            fprintf(\n   124\t                stderr_stream(),\n   125\t                c\"Insufficient rows in input string.\\n\".as_ptr(),\n   126\t            );\n   127\t            free(input_copy as *mut c_void);\n   128\t            free_matrix(mat);\n   129\t            return ptr::null_mut();\n   130\t        }\n   131\t\n   132\t        let mut saveptr_col: *mut c_char = ptr::null_mut();\n   133\t        let mut col_token = strtok_r(row_token, c\" \".as_ptr(), &mut saveptr_col);\n   134\t\n   135\t        let mut j: c_int = 0;\n   136\t        while j < width {\n   137\t            if col_token.is_null() {\n   138\t                fprintf(\n   139\t                    stderr_stream(),\n   140\t                    c\"Insufficient columns in row %d.\\n\".as_ptr(),\n   141\t                    i.wrapping_add(1),\n   142\t                );\n   143\t                free(input_copy as *mut c_void);\n   144\t                free_matrix(mat);\n   145\t                return ptr::null_mut();\n   146\t            }\n   147\t            *cell(mat, i, j) = atoi(col_token);\n   148\t            col_token = strtok_r(ptr::null_mut(), c\" \".as_ptr(), &mut saveptr_col);\n   149\t            j = j.wrapping_add(1);\n   150\t        }\n   151\t\n   152\t        row_token = strtok_r(ptr::null_mut(), c\"\\n\".as_ptr(), &mut saveptr_row);\n   153\t        i = i.wrapping_add(1);\n   154\t    }\n   155\t\n   156\t    free(input_copy as *mut c_void);\n   157\t    mat\n   158\t}\n   159\t\n   160\t#[unsafe(no_mangle)]\n   161\tpub unsafe extern \"C\" fn multiply_matrices(\n   162\t    mat_a: *mut matrix_t,\n   163\t    mat_b: *mut matrix_t,\n   164\t) -> *mut matrix_t {\n   165\t    if (*mat_a).width != (*mat_b).height {\n   166\t        fprintf(\n   167\t            stderr_stream(),\n   168\t            c\"Matrix dimensions do not allow multiplication.\\n\".as_ptr(),\n   169\t        );\n   170\t        return ptr::null_mut();\n   171\t    }\n   172\t\n   173\t   