turn ptr::null_mut();\n   220\t    }\n   221\t\n   222\t    *result.add(0) = 0;\n   223\t\n   224\t    // NOTE: the C sizing formula reserves `width * 11` bytes per row for the\n   225\t    // digits but only ONE extra byte per row for the `width - 1` separating\n   226\t    // spaces and the trailing newline. Any row wide enough to hold long numbers\n   227\t    // therefore runs off the end of the allocation and corrupts the heap.\n   228\t    //\n   229\t    // That is a genuine bug in the original and it is reproduced verbatim\n   230\t    // rather than papered over: this translation calls the very same\n   231\t    // `snprintf`/`strcat` against a block from the very same `malloc`, in the\n   232\t    // same allocation order, so an overrun scribbles over exactly the same\n   233\t    // bytes and glibc reacts exactly as it does for the C build. No\n   234\t    // intermediate Rust allocations are made here, precisely so the heap layout\n   235\t    // is not perturbed.\n   236\t    let mut i: c_int = 0;\n   237\t    while i < height {\n   238\t        let mut j: c_int = 0;\n   239\t        while j < width {\n   240\t            let mut buffer = [0 as c_char; 12];\n   241\t            snprintf(\n   242\t                buffer.as_mut_ptr(),\n   243\t                buffer.len(),\n   244\t                c\"%d\".as_ptr(),\n   245\t                *cell(mat, i, j),\n   246\t            );\n   247\t            strcat(result, buffer.as_ptr());\n   248\t\n   249\t            if j < width.wrapping_sub(1) {\n   250\t                strcat(result, c\" \".as_ptr());\n   251\t            }\n   252\t            j = j.wrapping_add(1);\n   253\t        }\n   254\t        strcat(result, c\"\\n\".as_ptr());\n   255\t        i = i.wrapping_add(1);\n   256\t    }\n   257\t\n   258\t    result\n   259\t}\n########## translation/src/write.rs ##########\n     1\t//! Translation of `c_src/src/write.c` (public surface in `c_src/include/write.h`).\n     2\t\n     3\tuse core::ffi::{c_char, c_int};\n     4\t\n     5\tuse crate::cffi::{errno, fclose, fopen, fprintf, stderr_stream, strerror, EINVAL};\n     6\t\n     7\t#[unsafe(no_mangle)]\n     8\tpub unsafe extern \"C\" fn write_to_file(filename: *const c_char, content: *const c_char) -> c_int {\n     9\t    if content.is_null() {\n    10\t        fprintf(stderr_stream(), c\"Error: Content is NULL.\\n\".as_ptr());\n    11\t        return EINVAL;\n    12\t    }\n    13\t\n    14\t    let file = fopen(filename, c\"w\".as_ptr());\n    15\t    if file.is_null() {\n    16\t        // `strerror(errno)` is evaluated before the fprintf call, but the\n    17\t        // `return errno;` that follows re-reads errno *after* it. Preserved.\n    18\t        let saved = errno();\n    19\t        fprintf(\n    20\t            stderr_stream(),\n    21\t            c\"Error opening file '%s': %s\\n\".as_ptr(),\n    22\t            filename,\n    23\t            strerror(saved),\n    24\t        );\n    25\t        return errno();\n    26\t    }\n    27\t\n    28\t    if fprintf(file, c\"%s\".as_ptr(), content) < 0 {\n    29\t        let saved = errno();\n    30\t        fprintf(\n    31\t            stderr_stream(),\n    32\t            c\"Error writing to file '%s': %s\\n\".as_ptr(),\n    33\t            filename,\n    34\t            strerror(saved),\n    35\t        );\n    36\t        fclose(file);\n    37\t        return errno();\n    38\t    }\n    39\t\n    40\t    if fclose(file) != 0 {\n    41\t        let saved = errno();\n    42\t        fprintf(\n    43\t            stderr_stream(),\n    44\t            c\"Error closing file '%s': %s\\n\".as_ptr(),\n    45\t            filename,\n    46\t            strerror(saved),\n    47\t        );\n    48\t        return errno();\n    49\t    }\n    50\t\n    51\t    0\n    52\t}\n########## translation/src/driver.rs ##########\n     1\t//! Translation of `c_src/src/driver.c`.\n     2\t\n     3\tuse core::ffi::{c_char, c_int, c_void};\n     4\t\n     5\tuse crate