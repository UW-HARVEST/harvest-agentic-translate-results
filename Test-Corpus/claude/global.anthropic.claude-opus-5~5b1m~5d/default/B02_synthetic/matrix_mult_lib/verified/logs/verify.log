  free_matrix(res);\n    65\t    free(res_str);\n    66\t\n    67\t    if (res_write != 0) {\n    68\t        return EXIT_FAILURE;\n    69\t    }\n    70\t\n    71\t    return EXIT_SUCCESS;\n    72\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
