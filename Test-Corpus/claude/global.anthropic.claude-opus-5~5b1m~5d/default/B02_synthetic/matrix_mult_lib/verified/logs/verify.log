so the C shared object exports it. It is reproduced here as\n     5\t//! a public `extern \"C\"` symbol for that reason.\n     6\t\n     7\t#![allow(non_camel_case_types)]\n     8\t\n     9\tuse core::ffi::{c_char, c_int, c_void};\n    10\tuse core::ptr;\n    11\t\n    12\tuse crate::cffi::{\n    13\t    atoi, fprintf, free, malloc, perror, snprintf, stderr_stream, strcat, strdup, strtok_r,\n    14\t};\n    15\t\n    16\t/// ```c\n    17\t/// typedef struct {\n    18\t///     int** matrix;\n    19\t///     int width;\n    20\t///     int height;\n    21\t/// } matrix_t;\n    22\t/// ```\n    23\t#[repr(C)]\n    24\tpub struct matrix_t {\n    25\t    pub matrix: *mut *mut c_int,\n    26\t    pub width: c_int,\n    27\t    pub height: c_int,\n    28\t}\n    29\t\n    30\t/// Read `mat->matrix[i][j]`.\n    31\t#[inline]\n    32\tunsafe fn cell(mat: *const matrix_t, i: c_int, j: c_int) -> *mut c_int {\n    33\t    (*(*mat).matrix.offset(i as isize)).offset(j as isize)\n    34\t}\n    35\t\n    36\t#[unsafe(no_mangle)]\n    37\tpub unsafe extern \"C\" fn allocate_matrix(width: c_int, height: c_int) -> *mut matrix_t {\n    38\t    // matrix_t* mat = malloc(sizeof(matrix_t));\n    39\t    let mat = malloc(core::mem::size_of::<matrix_t>()) as *mut matrix_t;\n    40\t    if mat.is_null() {\n    41\t        perror(c\"Failed to allocate memory for matrix struct\".as_ptr());\n    42\t        return ptr::null_mut();\n    43\t    }\n    44\t\n    45\t    (*mat).width = width;\n    46\t    (*mat).height = height;\n    47\t\n    48\t    // mat->matrix = malloc(height * sizeof(int*));\n    49\t    //\n    50\t    // `height` is an `int`; in C it is converted to `size_t` (sign extended)\n    51\t    // before being multiplied, and the product wraps. A negative `height`\n    52\t    // therefore turns into an enormous request that `malloc` rejects.\n    53\t    let row_bytes =\n    54\t        (height as isize as usize).wrapping_mul(core::mem::size_of::<*mut c_int>());\n    55\t    (*