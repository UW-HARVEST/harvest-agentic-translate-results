so 40M is a generous safety valve that still terminates quickly\n/// if `RLIMIT_AS` turns out not to be enforced.\nconst DRAIN_CAP: u64 = 40_000_000;\n\n/// Head of the drained block list; a `static` so that LLVM cannot prove the\n/// allocations dead. (With a purely local list, `-O` happily deletes the whole\n/// `malloc` loop as an unused allocation and folds `is_null()` to `false`, which\n/// silently turns the OOM injection into a no-op.)\nstatic mut DRAIN_HEAD: *mut c_void = std::ptr::null_mut();\n\n/// Drain the heap until `libc::malloc(chunk)` returns NULL.\n///\n/// Every block is threaded onto an intrusive linked list (the first 8 bytes of\n/// each block hold the previous head). Writing through each pointer both keeps\n/// the allocation observably alive for the optimizer and forces the pages to be\n/// faulted in, so `RLIMIT_AS` is really reached.\n///\n/// Returns `(mid1, mid2, hit_cap)`. The two `mid` pointers are chunks taken\n/// early in the drain, i.e. deep inside the heap and far from the top chunk.\n/// Releasing THOSE puts `chunk`-sized blocks back into tcache without letting\n/// them coalesce with the top chunk (which would enlarge the top, or trigger a\n/// `systrim` that hands address space back and undoes the whole exhaustion).\n///\n/// No Rust allocation may happen between this call and the `setrlimit` restore.\nunsafe fn drain(chunk: usize, label: &str) -> (*mut c_void, *mut c_void, bool) {\n    assert!(chunk >= std::mem::size_of::<*mut c_void>());\n    const MID1_AT: u64 = 4096;\n    const MID2_AT: u64 = 4097;\n    let mut mid1: *mut c_void = std::ptr::null_mut();\n    let mut mid2: *mut c_void = std::ptr::null_mut();\n    let mut n: u64 = 0;\n    loop {\n        let p = std::hint::black_box(unsafe { libc::malloc(chunk) });\n        if p.is_null() {\n            trace_num(label, n);\n            return (mid1, mid2, false);\n        }\n        unsafe {\n            // Thread onto the list: an actual store into the block.\n            (p as *mut *mut c_void).write(DRAIN_HEAD);\n            DRAIN_HEAD = p;\n        }\n        n += 1;\n        if n == MID1_AT {\n            mid1 = p;\n        } else if n == MID2_AT {\n            mid2 = p;\n        }\n        if n >= DRAIN_CAP {\n            trace_num(label, n);\n            return (mid1, mid2, true);\n        }\n    }\n}\n\n/// Unlink `p` from `DRAIN_HEAD`'s list, then `free` it. The block must not stay\n/// on the list (its first word is reused by the allocator once freed).\nunsafe fn unlink_and_free(p: *mut c_void) -> bool {\n    unsafe {\n        let mut prev: *mut *mut c_void = std::ptr::addr_of_mut!(DRAIN_HEAD);\n        loop {\n            let cur = *prev;\n            if cur.is_null() {\n                return false;\n            }\n            if cur == p {\n                *prev = *(cur as *mut *mut c_void);\n                libc::free(cur);\n                return true;\n            }\n            prev = cur as *mut *mut c_void;\n        }\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2891,"cache_read_input_tokens":155718,"cache_creation":{"ephemeral_5m_input_tokens":2891,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"603139dd-a66f-4d7a-9592-5ebc2faba3d7","uuid":"06e8ca42-d4b4-4a08-8415-31a7f091a31e","timestamp":"2026-08-28T00:01:42.204Z"}
