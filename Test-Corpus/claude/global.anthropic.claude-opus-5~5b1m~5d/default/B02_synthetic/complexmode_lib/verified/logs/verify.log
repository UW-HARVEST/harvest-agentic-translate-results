\n572\t}\n573\t\n574\tfn child_run(case: &str, lib: &Lib) -> ! {\n575\t    unsafe {\n576\t        // E4 needs no memory pressure: just deref NULL through the library.\n577\t        if case == \"e4\" {\n578\t            libc::printf(c\"%s\".as_ptr(), BEGIN.as_ptr() as *const c_char);\n579\t            libc::fflush(std::ptr::null_mut());\n580\t            let _ = (lib.multiply_with_log)(6, 7, std::ptr::null_mut());\n581\t            // Unreachable if the deref faulted as the C does.\n582\t            write_fd(2, b\"CHILDRESULT survived-null-outparam\\n\");\n583\t            libc::fflush(std::ptr::null_mut());\n584\t            libc::_exit(0);\n585\t        }\n586\t\n587\t        // Warm up stdout so that its FILE buffer is allocated BEFORE the heap\n588\t        // is drained (otherwise the library's own printf could not run).\n589\t        libc::printf(c\"%s\".as_ptr(), BEGIN.as_ptr() as *const c_char);\n590\t        libc::fflush(std::ptr::null_mut());\n591\t\n592\t        // Snapshot and lower the address-space limit so that draining is quick.\n593\t        let mut orig = libc::rlimit {\n594\t            rlim_cur: 0,\n595\t            rlim_max: 0,\n596\t        };\n597\t        assert_eq!(libc::getrlimit(libc::RLIMIT_AS, &mut orig), 0);\n598\t        let target = vsz_bytes() + 64 * 1024 * 1024;\n599\t        let capped = if orig.rlim_max == libc::RLIM_INFINITY {\n600\t            target\n601\t        } else {\n602\t            target.min(orig.rlim_max)\n603\t        };\n604\t        let tight = libc::rlimit {\n605\t            rlim_cur: capped,\n606\t            rlim_max: orig.rlim_max,\n607\t        };\n608\t        assert_eq!(libc::setrlimit(libc::RLIMIT_AS, &tight), 0);\n609\t\n610\t        // glibc chunk sizes: a 40-byte request needs a 48-byte chunk, a 64-byte\n611\t        // request needs an 80-byte chunk. Draining with 40-byte requests and\n612\t        // then releasing ONE of them therefore leaves room for\n613\t        // `malloc(sizeof(Result)) == malloc