ffering behaviour that determines their\n39\t// interleaving) are bit-for-bit identical to the original.\n40\t// ---------------------------------------------------------------------------\n41\t\n42\ttype FILE = c_void;\n43\t\n44\textern \"C\" {\n45\t    static mut stderr: *mut FILE;\n46\t\n47\t    fn getenv(name: *const c_char) -> *mut c_char;\n48\t    fn atoi(nptr: *const c_char) -> c_int;\n49\t    fn strchr(s: *const c_char, c: c_int) -> *mut c_char;\n50\t    fn memcpy(dest: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n51\t\n52\t    fn printf(format: *const c_char, ...) -> c_int;\n53\t    fn fprintf(stream: *mut FILE, format: *const c_char, ...) -> c_int;\n54\t    fn snprintf(str_: *mut c_char, size: usize, format: *const c_char, ...) -> c_int;\n55\t}\n56\t\n57\t// ---------------------------------------------------------------------------\n58\t// struct ConfigFlags {\n59\t//     unsigned int verbose       : 1;\n60\t//     unsigned int debug         : 1;\n61\t//     unsigned int optimize      : 1;\n62\t//     unsigned int cache_enabled : 1;\n63\t//     unsigned int log_level     : 3;\n64\t//     unsigned int reserved      : 1;\n65\t// };\n66\t//\n67\t// On the System V x86-64 ABI (little endian) all eight bits live in the first\n68\t// byte of a single 4-byte `unsigned int` allocation unit, laid out from the\n69\t// least significant bit upwards:\n70\t//\n71\t//   bit 0      -> verbose\n72\t//   bit 1      -> debug\n73\t//   bit 2      -> optimize\n74\t//   bit 3      -> cache_enabled\n75\t//   bits 4..6  -> log_level\n76\t//   bit 7      -> reserved\n77\t//   bits 8..31 -> unnamed padding (never touched by the C code)\n78\t//\n79\t// `sizeof(struct ConfigFlags) == 4`, `_Alignof(struct ConfigFlags) == 4`.\n80\t// ---------------------------------------------------------------------------\n81\t\n82\t#[repr(C, align(4))]\n83\tpub struct ConfigFlags {\n84\t    /// The 4-byte `unsigned int` allocation unit holding the bit-fields.\n85\t    storage: [u8; 4],\n86\t}\n87\t\n88\tconst VERBOSE_SHIFT: u32 = 0;\n89\tconst DEBUG_SHIFT: u32 = 1;\n90\tconst OPTIMIZE_SHIFT: u32 = 2;\n91\tconst CACHE_ENABLED_SHIFT: u32 = 3;\n92\tconst LOG_LEVEL_SHIFT: u32 = 4;\n93\tconst RESERVED_SHIFT: u32 = 7;\n94\t\n95\timpl ConfigFlags {\n96\t    #[inline]\n97\t    fn get(&self, shift: u32, width: u32) -> c_uint {\n98\t        ((self.storage[0] >> shift) as c_uint) & ((1u32 << width) - 1)\n99\t    }\n100\t\n101\t    /// Read-modify-write of byte 0 only, exactly as gcc codegens a bit-field\n102\t    /// store for this layout.\n103\t    #[inline]\n104\t    fn set(&mut self, shift: u32, width: u32, value: c_uint) {\n105\t        let mask = ((1u32 << width) - 1) as u8;\n106\t        let byte = self.storage[0];\n107\t        self.storage[0] = (byte & !(mask << shift)) | (((value as u8) & mask) << shift);\n108\t    }\n109\t\n110\t    #[inline]\n111\t    fn verbose(&self) -> c_uint {\n112\t        self.get(VERBOSE_SHIFT, 1)\n113\t    }\n114\t    #[inline]\n115\t    fn debug(&self) -> c_uint {\n116\t        self.get(DEBUG_SHIFT, 1)\n117\t    }\n118\t    #[inline]\n119\t    fn optimize(&self) -> c_uint {\n120\t        self.get(OPTIMIZE_SHIFT, 1)\n121\t    }\n122\t    #[inline]\n123\t    fn cache_enabled(&self) -> c_uint {\n124\t        self.get(CACHE_ENABLED_SHIFT, 1)\n125\t    }\n126\t    #[inline]\n127\t    fn log_level(&self) -> c_uint {\n128\t        self.get(LOG_LEVEL_SHIFT, 3)\n129\t    }\n130\t\n131\t    #[inline]\n132\t    fn set_verbose(&mut self, v: c_uint) {\n133\t        self.set(VERBOSE_SHIFT, 1, v)\n134\t    }\n135\t    #[inline]\n136\t    fn set_debug(&mut self, v: c_uint) {\n137\t        self.set(DEBUG_SHIFT, 1, v)\n138\t    }\n139\t    #[inline]\n140\t    fn set_optimize(&mut self, v: c_uint) {\n141\t        self.set(OPTIMIZE_SHIFT, 1, v)\n142\t    }\n143\t    #[inline]\n144\t    fn set_cache_enabled(&mut self, v: c_uint) {\n145\t        self.set(CACHE_ENABLED_SHIFT, 1, v)\n146\t    }\n147\t    #[inline]\n148\t    fn set_log_level