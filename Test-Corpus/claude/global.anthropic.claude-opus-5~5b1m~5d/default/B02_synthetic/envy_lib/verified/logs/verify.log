d | 0x0F;\n110\t    }\n111\t\n112\t    return adjusted;\n113\t}\n114\t\n115\tint envy(int param1, int param2, int param3, int param4) {\n116\t    struct ProcessState state;\n117\t    struct ProcessState state_backup;\n118\t    char buffer[BUFFER_SIZE];\n119\t    int result = 0;\n120\t\n121\t    init_config_from_env(&state.flags);\n122\t\n123\t    int base_offset = parse_env_numeric(\"PROG_BASE_OFFSET\", 0100);\n124\t    int multiplier = parse_env_numeric(\"PROG_MULTIPLIER\", 012);\n125\t\n126\t    if (state.flags.verbose) {\n127\t        printf(\"Verbose mode enabled\\n\");\n128\t        printf(\"Base offset: %d (from octal 0100)\\n\", base_offset);\n129\t        printf(\"Multiplier: %d (from octal 012)\\n\", multiplier);\n130\t    }\n131\t\n132\t    state.base_value = param1;\n133\t    state.multiplier = multiplier;\n134\t    state.operation = '+';\n135\t\n136\t    memcpy(&state_backup, &state, sizeof(struct ProcessState));\n137\t\n138\t    if (state.flags.debug) {\n139\t        printf(\"Debug: Created state backup using memcpy\\n\");\n140\t        printf(\"Debug: Backup base_value = %d\\n\", state_backup.base_value);\n141\t    }\n142\t\n143\t    result = perform_operation(param1, param2, &state.flags);\n144\t\n145\t    if (param3 != 0) {\n146\t        result += param3 * state.multiplier;\n147\t    }\n148\t\n149\t    if (param4 != 0) {\n150\t        result += param4 >> 2;\n151\t    }\n152\t\n153\t    result = apply_bit_operations(result, &state.flags);\n154\t\n155\t    result += base_offset;\n156\t\n157\t    snprintf(buffer, BUFFER_SIZE, \"Result:%d:Complete\", result);\n158\t\n159\t    char* colon_pos = strchr(buffer, ':');\n160\t    if (colon_pos != NULL) {\n161\t        if (state.flags.verbose) {\n162\t            printf(\"Found colon at position: %ld\\n\", colon_pos - buffer);\n163\t        }\n164\t\n165\t        char* second_colon = strchr(colon_pos + 1, ':');\n166\t        if (second_colon != NULL && state.flags.debug) {\n167\t            printf(\"Debug: Resu