47\t\n248\t    invalid_char = strchr(env_value, b';' as c_int);\n249\t    if !invalid_char.is_null() {\n250\t        fprintf(stderr, cstr(S_WARN_SEMICOLON), env_name);\n251\t        return default_val;\n252\t    }\n253\t\n254\t    atoi(env_value)\n255\t}\n256\t\n257\t// ---------------------------------------------------------------------------\n258\t// void init_config_from_env(struct ConfigFlags* flags)\n259\t// ---------------------------------------------------------------------------\n260\t\n261\t#[unsafe(no_mangle)]\n262\tpub unsafe extern \"C\" fn init_config_from_env(flags: *mut ConfigFlags) {\n263\t    let verbose_env: *mut c_char = getenv(cstr(S_PROG_VERBOSE));\n264\t    let debug_env: *mut c_char = getenv(cstr(S_PROG_DEBUG));\n265\t    let optimize_env: *mut c_char = getenv(cstr(S_PROG_OPTIMIZE));\n266\t\n267\t    let flags = &mut *flags;\n268\t\n269\t    flags.set_verbose(\n270\t        if !verbose_env.is_null() && !strchr(verbose_env, b'1' as c_int).is_null() {\n271\t            1\n272\t        } else {\n273\t            0\n274\t        },\n275\t    );\n276\t    flags.set_debug(\n277\t        if !debug_env.is_null() && !strchr(debug_env, b'1' as c_int).is_null() {\n278\t            1\n279\t        } else {\n280\t            0\n281\t        },\n282\t    );\n283\t    flags.set_optimize(if !optimize_env.is_null() { 1 } else { 0 });\n284\t    flags.set_cache_enabled(1);\n285\t    flags.set_log_level(0o3);\n286\t    flags.set_reserved(0);\n287\t}\n288\t\n289\t// ---------------------------------------------------------------------------\n290\t// int perform_operation(int val1, int val2, struct ConfigFlags* flags)\n291\t// ---------------------------------------------------------------------------\n292\t\n293\t#[unsafe(no_mangle)]\n294\t#[allow(unused_assignments)]\n295\tpub unsafe extern \"C\" fn perform_operation(\n296\t    val1: c_int,\n297\t    val2: c_int,\n298\t    flags: *mut ConfigFlags,\n299\t) -> c_int {\n300\t    // `int result = 0;` — immediately overwritten on both branches below, kept\n301\t    // for fidelity with the C source.\n302\t    let mut result: c_int = 0;\n303\t\n304\t    let operation_mode: c_int = 0o755;\n305\t\n306\t    let flags = &*flags;\n307\t\n308\t    if flags.optimize() != 0 {\n309\t        result = val1.wrapping_add(val2);\n310\t    } else {\n311\t        // The bit-field `log_level` (unsigned int : 3) undergoes the integer\n312\t        // promotions and becomes a plain `int` here.\n313\t        result = val1\n314\t            .wrapping_mul(flags.log_level() as c_int)\n315\t            .wrapping_add(val2.wrapping_div(2));\n316\t    }\n317\t\n318\t    if flags.debug() != 0 {\n319\t        printf(cstr(S_DBG_OPERATION_MODE), operation_mode);\n320\t        printf(cstr(S_DBG_RESULT_BEFORE), result);\n321\t    }\n322\t\n323\t    result\n324\t}\n325\t\n326\t// ---------------------------------------------------------------------------\n327\t// int apply_bit_operations(int value, struct ConfigFlags* flags)\n328\t// ---------------------------------------------------------------------------\n329\t\n330\t#[unsafe(no_mangle)]\n331\tpub unsafe extern \"C\" fn apply_bit_operations(\n332\t    value: c_int,\n333\t    flags: *mut ConfigFlags,\n334\t) -> c_int {\n335\t    let mut adjusted: c_int = value;\n336\t\n337\t    let flags = &*flags;\n338\t\n339\t    if flags.verbose() != 0 {\n340\t        adjusted = ((adjusted as u32) << 1) as c_int;\n341\t    }\n342\t\n343\t    if flags.cache_enabled() != 0 {\n344\t        adjusted |= 0x0F;\n345\t    }\n346\t\n347\t    adjusted\n348\t}\n349\t\n350\t// ---------------------------------------------------------------------------\n351\t// int envy(int param1, int param2, int param3, int param4)\n352\t// ---------------------------------------------------------------------------\n353\t\n354\t#[unsafe(no_mangle)]\n355\tpub unsafe extern \"C\" fn envy(\n356\t    param1: c_int,\n357\t    param2: c_int,\n358\t    param3: c_int,\n359\t    param4: c_int,\n360\t) -> c_int {\n361\t    // `struct ProcessState state, state_backup;` and `char buffer[256];` are\n362\t    // uninitialised automatic objects in the C original.  Reading uninitialised\n363\t    // memory is undefined behaviour in Rust (LLVM will happily fold it into an\n364\t    // `unreachable`), so the storage is zeroed here instead.  This is not\n365\t    // observable: every member and every buffer byte that the C code later\n366\t    // reads is unconditionally written first (`init_config_from_env` sets all\n367\t    // six bit-fields, `base_value`/`multiplier`/`operation` are assigned, and\n368\t    // `snprintf` NUL-terminates the buffer), so only never-read padding bytes\n369\t    // differ.\n370\t    let mut state_storage: ProcessState = ProcessState::zeroed();\n371\t    let mut backup_storage: ProcessState = ProcessState::zeroed();\n372\t    let state: *mut ProcessState = &mut state_storage;\n373\t    let state_backup: *mut ProcessState = &mut backup_storage;\n374\t\n375\t    let mut buffer: [c_char; BUFFER_SIZE] = [0; BUFFER_SIZE];\n376\t    let buffer_ptr: *mut c_char = buffer.as_mut_ptr();\n377\t\n378\t    let mut result: c_int;\n379\t\n380\t    init_config_from_env(core::ptr::addr_of_mut!((*state).flags));\n381\t\n382\t    let base_offset: c_int = parse_env_numeric(cstr(S_PROG_BASE_OFFSET), 0o100);\n383\t    let multiplier: c_int = parse_env_numeric(cstr(S_PROG_MULTIPLIER), 0o12);\n384\t\n385\t    if (*state).flags.verbose() != 0 {\n386\t        printf(cstr(S_VERBOSE_ENABLED));\n387\t        printf(cstr(S_BASE_OFFSET), base_offset);\n388\t        printf(cstr(S_MULTIPLIER), multiplier);\n389\t    }\n390\t\n391\t    (*state).base_value = param1;\n392\t    (*state).multiplier = multiplier;\n393\t    (*state).operation = b'+' as c_char;\n394\t\n395\t    memcpy(\n396\t        state_backup as *mut c_void,\n397\t        state as *const c_void,\n398\t        core::mem::size_of::<ProcessState>(),\n399\t    );\n400\t\n401\t    if (*state).flags.debug() != 0 {\n402\t    