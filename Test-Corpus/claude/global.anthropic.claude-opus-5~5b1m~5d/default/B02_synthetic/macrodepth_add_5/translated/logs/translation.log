grams.\n#[inline]\npub fn step(acc: c_int, i: c_int) -> c_int {\n    if cfg!(feature = \"mul\") {\n        acc.wrapping_mul(i.wrapping_add(1))\n    } else if cfg!(feature = \"sub\") {\n        acc.wrapping_sub(i)\n    } else {\n        acc.wrapping_add(i)\n    }\n}\n\n/// `(OP_FN(OP))(a, b)` — invoke the selected operation directly.\n#[inline]\npub fn op_fn(a: c_int, b: c_int) -> c_int {\n    if cfg!(feature = \"mul\") {\n        op_mul(a, b)\n    } else if cfg!(feature = \"sub\") {\n        op_sub(a, b)\n    } else {\n        op_add(a, b)\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
