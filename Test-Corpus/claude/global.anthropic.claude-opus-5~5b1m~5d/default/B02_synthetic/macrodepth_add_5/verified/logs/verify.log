\") || { echo \"C BUILD FAIL $cfg\"; fail=$((fail+1)); failed+=(\"$cfg(cbuild)\"); continue; }\n\n  if ! timeout 300 cargo build --release --offline --no-default-features --features \"$feats\" >\"$log\" 2>&1; then\n    echo \"RUST BUILD FAIL $cfg (see $log)\"; tail -n 15 \"$log\"; fail=$((fail+1)); failed+=(\"$cfg(rsbuild)\"); continue\n  fi\n  rs_so=\"$ROOT/cbuild/rs/libmacrodepth_${op}_${rep}.so\"\n  cp \"$ROOT/translation/target/release/libmacrodepth_add_5.so\" \"$rs_so\"\n\n  if MD_OP=\"$op\" MD_REPEAT=\"$rep\" MD_C_SO=\"$c_so\" MD_RUST_SO=\"$rs_so\" \\\n     timeout 600 cargo test --release --offline --no-default-features --features \"$feats\" \\\n       -- --test-threads=1 >>\"$log\" 2>&1; then\n    n=$(grep -c '^test .* ok$' \"$log\")\n    echo \"PASS $cfg  ($n tests)\"\n    pass=$((pass+1))\n  else\n    echo \"FAIL $cfg (see $log)\"\n    grep -E \"^(test .*FAILED|failures:|thread .* panicked)\" -A6 \"$log\" | head -n 40\n    fail=$((fail+1)); failed+=(\"$cfg\")\n  fi\ndone\n\necho \"==================================================\"\necho \"configurations passed: $pass   failed: $fail\"\n[ \"$fail\" -eq 0 ] || { printf 'failing configs: %s\\n' \"${failed[*]}\"; exit 1; }\n","structuredPatch":[{"oldStart":26,"oldLines":6,"newStart":26,"newLines":7,"lines":["   log=\"$ROOT/cbuild/logs/test_${op}_${rep}.log\""," ","   c_so=$(\"$ROOT/scripts/build_c_so.sh\" \"$op\" \"$rep\") || { echo \"C BUILD FAIL $cfg\"; fail=$((fail+1)); failed+=(\"$cfg(cbuild)\"); continue; }","+  c_exe=$(\"$ROOT/scripts/build_c_exe.sh\" \"$op\" \"$rep\") || { echo \"C EXE BUILD FAIL $cfg\"; fail=$((fail+1)); failed+=(\"$cfg(cexe)\"); continue; }"," ","   if ! timeout 300 cargo build --release --offline --no-default-features --features \"$feats\" >\"$log\" 2>&1; then","     echo \"RUST BUILD FAIL $cfg (see $log)\"; tail -n 15 \"$log\"; fail=$((fail+1)); failed+=(\"$cfg(rsbuild)\"); continue"]}],"userModified":false,"replaceAll":false}}
