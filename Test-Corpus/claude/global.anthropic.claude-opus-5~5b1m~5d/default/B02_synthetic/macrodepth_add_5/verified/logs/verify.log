{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016m4ASob611uaQTL65eTrmm","type":"tool_result","content":"1\t// Copyright 2025 MIT Lincoln Laboratory\n2\t// Permission is hereby granted, free of charge,\n3\t// to any person obtaining a copy of this software\n4\t// and associated documentation files (the \"Software\"),\n5\t// to deal in the Software without restriction,\n6\t// including without limitation the rights to use, copy,\n7\t// modify, merge, publish, distribute, sublicense,\n8\t// and/or sell copies of the Software,\n9\t// and to permit persons to whom the Software is furnished to do so,\n10\t// subject to the following conditions:\n11\t//\n12\t// The above copyright notice and this permission notice\n13\t// shall be included in all copies or substantial portions of the Software.\n14\t//\n15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n17\t// THE WARRANTIES OF MERCHANTABILITY,\n18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n23\t\n24\t//! Rust equivalent of `mdcore.c`.\n25\t\n26\tuse core::ffi::{c_char, c_int, CStr};\n27\t\n28\tuse crate::mdmacros::{op_fn, step, INIT_FOR, REPEAT};\n29\t\n30\t/* Define operations */\n31\t\n32\t/// `int op_add(int a, int b) { return a + b; }`\n33\t#[unsafe(no_mangle)]\n34\tpub extern \"C\" fn op_add(a: c_int, b: c_int) -> c_int {\n35\t    a.wrapping_add(b)\n36\t}\n37\t\n38\t/// `int op_sub(int a, int b) { return a - b; }`\n39\t#[unsafe(no_mangle)]\n40\tpub extern \"C\" fn op_sub(a: c_int, b: c_int) -> c_int {\n41\t    a.wrapping_sub(b)\n42\t}\n43\t\n44\t/// `int op_mul(int a, int b) { return a * b; }`\n45\t#[unsafe(no_mangle)]\n46\tpub extern \"C\" fn op_mul(a: c_int, b: c_int) -> c_int {\n47\t    a.wrapping_mul(b)\n48\t}\n49\t\n50\t/// Macro-generated accumulator for the selected OP: `DEFINE_ACCUM(OP)`.\n51\t///\n52\t/// The C `DISPATCH_REP` expands to `switch (n) { case 0..6: REPk; default: }`,\n53\t/// where each `REPk` applies `step` for indices `0..k`. Only cases `0..=6` are\n54\t/// handled; any other `n` (including `>= 7` or negative) falls through\n55\t/// `default:` and leaves the accumulator at its initial value.\n56\t///\n57\t/// This is `static` in C (file-local), so it has no exported linker symbol.\n58\tfn accum(n: c_int) -> c_int {\n59\t    let mut acc = INIT_FOR;\n60\t    if (0..=6).contains(&n) {\n61\t        let mut i: c_int = 0;\n62\t        while i < n {\n63\t            acc = step(acc, i);\n64\t            i += 1;\n65\t        }\n66\t    }\n67\t    acc\n68\t}\n69\t\n70\t/* Global macro uses at file scope (exercises expansion at global init) */\n71\t\n72\t/// `int (*G_OP)(int,int) = OP_FN(OP);` — pointer to the selected op function.\n73\t#[cfg(feature = \"mul\")]\n74\t#[unsafe(no_mangle)]\n75\tpub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = op_mul;\n76\t#[cfg(all(feature = \"sub\", not(feature = \"mul\")))]\n77\t#[unsafe(no_mangle)]\n78\tpub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = op_sub;\n79\t#[cfg(all(not(feature = \"mul\"), not(feature = \"sub\")))]\n80\t#[unsafe(no_mangle)]\n81\tpub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = op_add;\n82\t\n83\t/// `const char *G_OP_NAME = STR(OP);`\n84\t///\n85\t/// A raw C string pointer. `*const c_char` is not `Sync`, so it is wrapped in a\n86\t/// `#[repr(transparent)]` newtype (identical ABI to a bare pointer) whose\n87\t/// `Sync` impl we vouch for — the pointee is a `'static` NUL-terminated literal.\n88\t#[repr(transparent)]\n89\tpub struct CCharPtr(pub *const c_char);\n90\t// SAFETY: the wrapped pointer always refers to a read-only `'static` string\n91\t// literal, so sharing it across threads is sound.\n92\tunsafe impl Sync for CCharPtr {}\n93\t\n94\tconst G_OP_NAME_CSTR: &CStr = if cfg!(feature = \"mul\") {\n95\t    c\"mul\"\n96\t} else if cfg!(feature = \"sub\") {\n97\t    c\"sub\"\n98\t} else {\n99\t    c\"add\"\n100\t};\n101\t\n102\t#[unsafe(no_mangle)]\n103\tpub static G_OP_NAME: CCharPtr = CCharPtr(G_OP_NAME_CSTR.as_ptr());\n104\t\n105\t/* Helpers provided by md_core.c */\n106\t\n107\t/// ```c\n108\t/// int helper_call(int a, int b) {\n109\t///     int r = (OP_FN(OP))(a, b);\n110\t///     int acc = INIT_FOR(OP);\n111\t///     RUN_LOOP(OP, acc, REPEAT);\n112\t///     printf(\"helper.call=%d helper.acc=%d\\n\", r, acc);\n113\t///     return r + acc;\n114\t/// }\n115\t/// ```\n116\t///\n117\t/// `RUN_LOOP` statically unrolls exactly `REPEAT` steps over indices\n118\t/// `0..REPEAT` (the C `REP<REPEAT>` macro).\n119\t#[unsafe(no_mangle)]\n120\tpub extern \"C\" fn helper_call(a: c_int, b: c_int) -> c_int {\n121\t    let r = op_fn(a, b);\n122\t    let mut acc = INIT_FOR;\n123\t    let mut i: c_int = 0;\n124\t    while i < REPEAT {\n125\t        acc = step(acc, i);\n126\t        i += 1;\n127\t    }\n128\t    println!(\"helper.call={} helper.acc={}\", r, acc);\n129\t    r.wrapping_add(acc)\n130\t}\n131\t\n132\t/// ```c\n133\t/// int helper_ptr(int a, int b) {\n134\t///     int (*fp)(int,int) = OP_FN(OP);\n135\t///     int r = fp(a, b);\n136\t///     printf(\"helper.ptr=%d\\n\", r);\n137\t///     return r;\n138\t/// }\n139\t/// ```\n140\t#[unsafe(no_mangle)]\n141\tpub extern \"C\" fn helper_ptr(a: c_int, b: c_int) -> c_int {\n142\t    let fp: extern \"C\" fn(c_int, c_int) -> c_int = G_OP;\n143\t    let r = fp(a, b);\n144\t    println!(\"helper.ptr={}\", r);\n145\t    r\n146\t}\n147\t\n148\t/// ```c\n149\t/// int use_generated(int n) {\n150\t///     int r = (ACCUM_FN(OP))(n);\n151\t///     printf(\"gen.acc=%d\\n\", r);\n152\t///     return r;\n153\t/// }\n154\t/// ```\n155\t#[unsafe(no_mangle)]\n156\tpub extern \"C\" fn use_generated(n: c_int) -> c_int {\n157\t    let r = accum(n);\n158\t    println!(\"gen.acc={}\", r);\n159\t    r\n160\t}\n161\t"}]},"parent_tool_use_id":null,"session_id":"84a2ebe0-e7dc-4af0-aaa1-360d971abc09","uuid":"c99d548a-bc00-42d5-be95-a33150d89e99","timestamp":"2026-08-28T02:42:27.681Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-63P1IU/translation/src/mdcore.rs","content":"// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n//! Rust equivalent of `mdcore.c`.\n\nuse core::ffi::{c_char, c_int, CStr};\n\nuse crate::mdmacros::{op_fn, step, INIT_FOR, REPEAT};\n\n/* Define operations */\n\n/// `int op_add(int a, int b) { return a + b; }`\n#[unsafe(no_mangle)]\npub extern \"C\" fn op_add(a: c_int, b: c_int) -> c_int {\n    a.wrapping_add(b)\n}\n\n/// `int op_sub(int a, int b) { return a - b; }`\n#[unsafe(no_mangle)]\npub extern \"C\" fn op_sub(a: c_int, b: c_int) -> c_int {\n    a.wrapping_sub(b)\n}\n\n/// `int op_mul(int a, int b) { return a * b; }`\n#[unsafe(no_mangle)]\npub extern \"C\" fn op_mul(a: c_int, b: c_int) -> c_int {\n    a.wrapping_mul(b)\n}\n\n/// Macro-generated accumulator for the selected OP: `DEFINE_ACCUM(OP)`.\n///\n/// The C `DISPATCH_REP` expands to `switch (n) { case 0..6: REPk; default: }`,\n/// where each `REPk` applies `step` for indices `0..k`. Only cases `0..=6` are\n/// handled; any other `n` (including `>= 7` or negative) falls through\n/// `default:` and leaves the accumulator at its initial value.\n///\n/// This is `static` in C (file-local), so it has no exported linker symbol.\nfn accum(n: c_int) -> c_int {\n    let mut acc = INIT_FOR;\n    if (0..=6).contains(&n) {\n        let mut i: c_int = 0;\n        while i < n {\n            acc = step(acc, i);\n            i += 1;\n        }\n    }\n    acc\n}\n\n/* Global macro uses at file scope (exercises expansion at global init) */\n\n/// `int (*G_OP)(int,int) = OP_FN(OP);` — pointer to the selected op function.\n#[cfg(feature = \"mul\")]\n#[unsafe(no_mangle)]\npub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = op_mul;\n#[cfg(all(feature = \"sub\", not(feature = \"mul\")))]\n#[unsafe(no_mangle)]\npub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = op_sub;\n#[cfg(all(not(feature = \"mul\"), not(feature = \"sub\")))]\n#[unsafe(no_mangle)]\npub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = op_add;\n\n/// `const char *G_OP_NAME = STR(OP);`\n///\n/// A raw C string pointer. `*const c_char` is not `Sync`, so it is wrapped in a\n/// `#[repr(transparent)]` newtype (identical ABI to a bare pointer) whose\n/// `Sync` impl we vouch for — the pointee is a `'static` NUL-terminated literal.\n#[repr(transparent)]\npub struct CCharPtr(pub *const c_char);\n// SAFETY: the wrapped pointer always refers to a read-only `'static` string\n// literal, so sharing it across threads is sound.\nunsafe impl Sync for CCharPtr {}\n\nconst G_OP_NAME_CSTR: &CStr = if cfg!(feature = \"mul\") {\n    c\"mul\"\n} else if cfg!(feature = \"sub\") {\n    c\"sub\"\n} else {\n    c\"add\"\n};\n\n#[unsafe(no_mangle)]\npub static G_OP_NAME: CCharPtr = CCharPtr(G_OP_NAME_CSTR.as_ptr());\n\n/* Helpers provided by md_core.c */\n\n/// ```c\n/// int helper_call(int a, int b) {\n///     int r = (OP_FN(OP))(a, b);\n///     int acc = INIT_FOR(OP);\n///     RUN_LOOP(OP, acc, REPEAT);\n///     printf(\"helper.call=%d helper.acc=%d\\n\", r, acc);\n///     return r + acc;\n/// }\n/// ```\n///\n/// `RUN_LOOP` statically unrolls exactly `REPEAT` steps over indices\n/// `0..REPEAT` (the C `REP<REPEAT>` macro).\n#[unsafe(no_mangle)]\npub extern \"C\" fn helper_call(a: c_int, b: c_int) -> c_int {\n    let r = op_fn(a, b);\n    let mut acc = INIT_FOR;\n    let mut i: c_int = 0;\n    while i < REPEAT {\n        acc = step(acc, i);\n        i += 1;\n    }\n    println!(\"helper.call={} helper.acc={}\", r, acc);\n    r.wrapping_add(acc)\n}\n\n/// ```c\n/// int helper_ptr(int a, int b) {\n///     int (*fp)(int,int) = OP_FN(OP);\n///     int r = fp(a, b);\n///     printf(\"helper.ptr=%d\\n\", r);\n///     return r;\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn helper_ptr(a: c_int, b: c_int) -> c_int {\n    let fp: extern \"C\" fn(c_int, c_int) -> c_int = G_OP;\n    let r = fp(a, b);\n    println!(\"helper.ptr={}\", r);\n    r\n}\n\n/// ```c\n/// int use_generated(int n) {\n///     int r = (ACCUM_FN(OP))(n);\n///     printf(\"gen.acc=%d\\n\", r);\n///     return r;\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn use_generated(n: c_int) -> c_int {\n    let r = accum(n);\n    println!(\"gen.acc={}\", r);\n    r\n}\n","numLines":161,"startLine":1,"totalLines":161}}}
