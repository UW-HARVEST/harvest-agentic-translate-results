d\\0\";\n    31\t#[cfg(all(not(feature = \"add\"), feature = \"sub\"))]\n    32\tpub const OP_NAME_C: &[u8] = b\"sub\\0\";\n    33\t#[cfg(all(not(feature = \"add\"), not(feature = \"sub\"), feature = \"mul\"))]\n    34\tpub const OP_NAME_C: &[u8] = b\"mul\\0\";\n    35\t#[cfg(not(any(feature = \"add\", feature = \"sub\", feature = \"mul\")))]\n    36\tpub const OP_NAME_C: &[u8] = b\"add\\0\";\n    37\t\n    38\t/// `INIT_FOR(OP)`: INIT_add 0, INIT_sub 0, INIT_mul 1.\n    39\t#[cfg(all(not(feature = \"add\"), not(feature = \"sub\"), feature = \"mul\"))]\n    40\tpub const INIT: c_int = 1;\n    41\t#[cfg(not(all(not(feature = \"add\"), not(feature = \"sub\"), feature = \"mul\")))]\n    42\tpub const INIT: c_int = 0;\n    43\t\n    44\t/// `STEP_OP(OP, acc, i)`:\n    45\t///   STEP_add(acc, i) => acc += i\n    46\t///   STEP_sub(acc, i) => acc -= i\n    47\t///   STEP_mul(acc, i) => acc *= (i + 1)\n    48\t#[inline]\n    49\tpub fn step(acc: c_int, i: c_int) -> c_int {\n    50\t    #[cfg(all(not(feature = \"add\"), not(feature = \"sub\"), feature = \"mul\"))]\n    51\t    {\n    52\t        acc.wrapping_mul(i.wrapping_add(1))\n    53\t    }\n    54\t    #[cfg(all(not(feature = \"add\"), feature = \"sub\"))]\n    55\t    {\n    56\t        acc.wrapping_sub(i)\n    57\t    }\n    58\t    #[cfg(any(\n    59\t        feature = \"add\",\n    60\t        not(any(feature = \"add\", feature = \"sub\", feature = \"mul\"))\n    61\t    ))]\n    62\t    {\n    63\t        acc.wrapping_add(i)\n    64\t    }\n    65\t}\n    66\t\n    67\t/// `OP_FN(OP)`: the selected `op_<OP>` function.\n    68\t#[inline]\n    69\tpub const fn op_fn() -> extern \"C\" fn(c_int, c_int) -> c_int {\n    70\t    #[cfg(all(not(feature = \"add\"), not(feature = \"sub\"), feature = \"mul\"))]\n    71\t    {\n    72\t        crate::mdcore::op_mul\n    73\t    }\n    74\t    #[cfg(all(not(feature = \"add\"), feature = \"sub\"))]\n    75\t    {\n    76\t        crate::mdcore::op_sub\n    77\t    }\n    78\t    #[cfg(any(\n    79\t        feature = \"add\",\n    80\t        not(any(feature = \"add\", feature = \"sub\", feature = \"mul\"))\n    81\t    ))]\n    82\t    {\n    83\t        crate::mdcore::op_add\n    84\t    }\n    85\t}\n    86\t\n    87\t/* ---------------------------- REPEAT selection ---------------------------- */\n    88\t\n    89\t// Priority: the lowest explicitly requested value wins; the C default is 5.\n    90\t#[cfg(feature = \"0\")]\n    91\tpub const REPEAT: c_int = 0;\n    92\t#[cfg(all(not(feature = \"0\"), feature = \"1\"))]\n    93\tpub const REPEAT: c_int = 1;\n    94\t#[cfg(all(not(feature = \"0\"), not(feature = \"1\"), feature = \"2\"))]\n    95\tpub const REPEAT: c_int = 2;\n    96\t#[cfg(all(not(feature = \"0\"), not(feature = \"1\"), not(feature = \"2\"), feature = \"3\"))]\n    97\tpub const REPEAT: c_int = 3;\n    98\t#[cfg(all(\n    99\t    not(feature = \"0\"),\n   100\t    not(feature = \"1\"),\n   101\t    not(feature = \"2\"),\n   102\t    not(feature = \"3\"),\n   103\t    feature = \"4\"\n   104\t))]\n   105\tpub const REPEAT: c_int = 4;\n   106\t#[cfg(all(\n   107\t    not(feature = \"0\"),\n   108\t    not(feature = \"1\"),\n   109\t    not(feature = \"2\"),\n   110\t    not(feature = \"3\"),\n   111\t    not(feature = \"4\"),\n   112\t    feature = \"5\"\n   113\t))]\n   114\tpub const REPEAT: c_int = 5;\n   115\t#[cfg(all(\n   116\t    not(feature = \"0\"),\n   117\t    not(feature = \"1\"),\n   118\t    not(feature = \"2\"),\n   119\t    not(feature = \"3\"),\n   120\t    not(feature = \"4\"),\n   121\t    not(feature = \"5\"),\n   122\t    feature = \"6\"\n   123\t))]\n   124\tpub const REPEAT: c_int = 6;\n   125\t#[cfg(all(\n   126\t    not(feature = \"0\"),\n   127\t    not(feature = \"1\"),\n   128\t    not(feature = \"2\"),\n   129\t    not(feature = \"3\"),\n   130\t    not(feature = \"4\"),\n   131\t    not(feature = \"5\"),\n   132\t    not(feature = \"6\"),\n   133\t    feature = \"7\"\n   134\t))]\n   135\tpub const REPEAT: c_int = 7;\n   136\t#[cfg(not(any(\n   137\t    feature = \"0\",\n   138\t    feature = \"1\",\n   139\t    feature = \"2\",\n   140\t    feature = \"3\",\n   141\t    feature = \"4\",\n   142\t    feature = \"5\",\n   143\t    feature = \"6\",\n   144\t    feature = \"7\"\n   145\t)))]\n   146\tpub const REPEAT: c_int = 5;\n   147\t\n   148\t/// `RUN_LOOP(OP, acc, REPEAT)` == `REP<REPEAT>(OP, acc)`: the manually\n   149\t/// unrolled sequence `STEP_OP(op, acc, 0); ... STEP_OP(op, acc, REPEAT-1);`\n   150\t#[inline]\n   151\tpub fn run_loop(mut acc: c_int) -> c_int {\n   152\t    let mut i: c_int = 0;\n   153\t    while i < REPEAT {\n   154\t        acc = step(acc, i);\n   155\t        i += 1;\n   156\t    }\n   157\t    acc\n   158\t}\n   159\t\n   160\t/// `DISPATCH_REP(OP, acc, n)`: switch over n with cases 0..=6 that perform\n   161\t/// REPn; any other value leaves the accumulator untouched (`default: break`).\n   162\t#[inline]\n   163\tpub fn dispatch_rep(acc: c_int, n: c_int) -> c_int {\n   164\t    match n {\n   165\t        0..=6 => {\n   166\t            let mut a = acc;\n   167\t            let mut i: c_int = 0;\n   168\t            while i < n {\n   169\t                a = step(a, i);\n   170\t                i += 1;\n   171\t            }\n   172\t            a\n   173\t        }\n   174\t        _ => acc,\n   175\t    }\n   176\t}\n===== mdcore.rs =====\n     1\t// Translation of c_src/src/mdcore.c\n     2\t\n     3\tuse std::ffi::{c_char, c_int};\n     4\tuse std::io::Write;\n     5\t\n     6\tuse crate::mdconfig::{self, INIT, OP_NAME_C, REPEAT};\n     7\t\n     8\t/* Define operations */\n     9\t\n    10\t#[unsafe(no_mangle)]\n    11\tpub extern \"C\" fn op_add(a: c_int, b: c_int) -> c_int {\n    12\t    a.wrapping_add(b)\n    13\t}\n    14\t\n    15\t#[unsafe(no_mangle)]\n    16\tpub extern \"C\" fn op_sub(a: c_int, b: c_int) -> c_int {\n    17\t    a.wrapping_sub(b)\n    18\t}\n    19\t\n    20\t#[unsafe(no_mangle)]\n    21\tpub extern \"C\" fn op_mul(a: c_int, b: c_int) -> c_int {\n    22\t    a.wrapping_mul(b)\n    23\t}\n    24\t\n    25\t/* Define the macro-generated accumulator for the selected OP:\n    26\t *   DEFINE_ACCUM(OP) => static int accum_<OP>(int n)\n    27\t * It is `static` in C, so it stays private here. */\n    28\tfn accum(n: c_int) -> c_int {\n    29\t    let acc: c_int = INIT;\n    30\t    mdconfig::dispatch_rep(acc, n)\n    31\t}\n    32\t\n    33\t/* Global macro uses at file scope (exercises expansion at global init) */\n    34\t\n    35\t#[unsafe(no_mangle)]\n    36\tpub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = mdconfig::op_fn();\n    37\t\n    38\t#[repr(transparent)]\n    39\tpub struct CStrPtr(pub *const c_char);\n    40\tunsafe impl Sync for CStrPtr {}\n    41\t\n    42\t#[unsafe(no_mangle)]\n    43\tpub static G_OP_NAME: CStrPtr = CStrPtr(OP_NAME_C.as_ptr() as *const c_char);\n    44\t\n    45\t/// stdout writer mirroring printf's behaviour closely enough for\n    46\t/// byte-identical output.\n    47\tfn out(s: &str) {\n    48\t    let stdout = std::io::stdout();\n    49\t    let mut lock = stdout.lock();\n    50\t    let _ = lock.write_all(s.as_bytes());\n    51\t    let _ = lock.flush();\n    52\t}\n    53\t\n    54\t#[unsafe(no_mangle)]\n    55\tpub extern \"C\" fn helper_call(a: c_int, b: c_int) -> c_int {\n    56\t    let r = (mdconfig::op_fn())(a, b);\n    57\t    let mut acc: c_int = INIT;\n    58\t    acc = mdconfig::run_loop(acc);\n    59\t    out(&format!(\"helper.call={} helper.acc={}\\n\", r, acc));\n    60\t    r.wrapping_add(acc)\n    61\t}\n    62\t\n    63\t#[unsafe(no_mangle)]\n    64\tpub extern \"C\" fn helper_ptr(a: c_int, b: c_int) -> c_int {\n    65\t    let fp: extern \"C\" fn(c_int, c_int) -> c_int = mdconfig::op_fn();\n    66\t    let r = fp(a, b);\n    67\t    out(&format!(\"helper.ptr={}\\n\", r));\n    68\t    r\n    69\t}\n    70\t\n    71\t#[unsafe(no_mangle)]\n    72\tpub extern \"C\" fn use_generated(n: c_int) -> c_int {\n    73\t    let r = accum(n);\n    74\t    out(&format!(\"gen.acc={}\\n\", r));\n    75\t    r\n    76\t}\n    77\t\n    78\t/// Re-export of the compile-time REPEAT value for the driver.\n    79\tpub const REPEAT_VALUE: c_int = REPEAT;\n===== main.rs =====\n     1\t// Translation of c_src/src/mdmain.c\n     2\t//\n     3\t// The C build compiles mdcore.c and mdmain.c into the `driver` executable, so\n     4\t// the binary contains its own copy of the core module (mirrored here with\n     5\t// `#[path]` module declarations, since the library is a cdylib).\n     6\t\n     7\t#[path = \"mdconfig.rs\"]\n     8\tpub mod mdconfig;\n     9\t#[path = \"mdcore.rs\"]\n    10\tpub mod mdcore;\n    11\t\n    12\tuse std::ffi::c_int;\n    13\tuse std::io::Write;\n    14\tuse std::os::unix::ffi::OsStrExt;\n    15\t\n    16\tuse mdconfig::{INIT, OP_NAME, REPEAT};\n    17\t\n    18\t/// glibc `atoi(s)` == `(int)strtol(s, NULL, 10)`.\n    19\tfn atoi(bytes: &[u8]) -> c_int {\n    20\t    let mut idx = 0usize;\n    21\t    while idx < bytes.len()\n    22\t        && matches!(bytes[idx], b' ' | b'\\t' | b'\\n' | b'\\x0b' | b'\\x0c' | b'\\r')\n    23\t    {\n    24\t        idx += 1;\n    25\t    }\n    26\t    let mut negative = false;\n    27\t    if idx < bytes.len() && (bytes[idx] == b'+' || bytes[idx] == b'-') {\n    28\t        negative = bytes[idx] == b'-';\n    29\t        idx += 1;\n    30\t    }\n    31\t    let mut acc: i64 = 0;\n    32\t    let mut overflow = false;\n    33\t    while idx < bytes.len() && bytes[idx].is_ascii_digit() {\n    34\t        let d = (bytes[idx] - b'0') as i64;\n    35\t        if !overflow {\n    36\t            match acc.checked_mul(10).and_then(|v| v.checked_add(d)) {\n    37\t                Some(v) => acc = v,\n    38\t                None => overflow = true,\n    39\t            }\n    40\t        }\n    41\t        idx += 1;\n    42\t    }\n    43\t    let value: i64 = if overflow {\n    44\t        if negative {\n    45\t            i64::MIN\n    46\t        } else {\n    47\t            i64::MAX\n    48\t        }\n    49\t    } else if negative {\n    50\t        -acc\n    51\t    } else {\n    52\t        acc\n    53\t    };\n    54\t    value as c_int\n    55\t}\n    56\t\n    57\tfn main() {\n    58\t    let args: Vec<std::ffi::OsString> = std::env::args_os().collect();\n    59\t    let argc = args.len();\n    60\t\n    61\t    if argc < 3 {\n    62\t        let prog = args\n    63\t            .first()\n    64\t            .map(|s| String::from_utf8_lossy(s.as_bytes()).into_owned())\n    65\t            .unwrap_or_default();\n    66\t        let stderr = std::io::stderr();\n    67\t        let mut lock = stderr.lock();\n    68\t        let _ = write!(lock, \"usage: {} A B\\n\", prog);\n    69\t        let _ = lock.flush();\n    70\t        std::process::exit(2);\n    71\t    }\n    72\t\n    73\t    let a = atoi(args[1].as_bytes());\n    74\t    let b = atoi(args[2].as_bytes());\n    75\t\n    76\t    let r_call = (mdconfig::op_fn())(a, b);\n    77\t    let mut acc: c_int = INIT;\n    78\t    acc = mdconfig::run_loop(acc);\n    79\t\n    80\t    let x1 = mdcore::helper_call(a, b);\n    81\t    let x2 = mdcore::helper_ptr(a, b);\n    82\t    let x3 = mdcore::use_generated(REPEAT);\n    83\t    let g = (mdcore::G_OP)(a, b);\n    84\t\n    85\t    let summary = r_call\n    86\t        .wrapping_add(acc)\n    87\t        .wrapping_add(x1)\n    88\t        .wrapping_add(x2)\n    89\t        .wrapping_add(x3)\n    90\t        .wrapping_add(g);\n    91\t\n    92\t    let stdout = std::io::stdout();\n    93\t    let mut lock = stdout.lock();\n    94\t    let _ = write!(\n    95\t        lock,\n    96\t        \"op={} call={} acc={} g.call={}\\n\",\n    97\t        OP_NAME, r_call, acc, g\n    98\t    );\n    99\t    let _ = write!(lock, \"summary={}\\n\", summary);\n   100\t    let _ = lock.flush();\n   101\t    std::process::exit(0);\n   102\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
