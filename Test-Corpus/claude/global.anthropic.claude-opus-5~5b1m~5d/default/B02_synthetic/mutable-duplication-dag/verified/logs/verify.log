".join(out)+b\"\\n\"\ns0=int(sys.argv[1]); N=int(sys.argv[2]); buckets=collections.Counter(); ex={}\nfor s in range(s0,s0+N):\n    rng=random.Random(s); d=gen(rng,rng.randint(10,140))\n    try: a=run(C,d); b=run(R,d)\n    except subprocess.TimeoutExpired: buckets[\"TIMEOUT\"]+=1; ex.setdefault(\"TIMEOUT\",(s,d,None,None)); continue\n    r=eq(a,b)\n    if r is None: continue\n    buckets[r]+=1; ex.setdefault(r,(s,d,a,b))\nprint(dict(buckets))\nfor k,v in ex.items():\n    print(\"---\",k,\"seed\",v[0]); print(\"  input:\",v[1][:700])\n    if v[2]:\n        a,b=v[2],v[3]; print(\"  C st=%s out=%d ; R st=%s out=%d\"%(a[0],len(a[1]),b[0],len(b[1])))\n        if norm(a[2])!=norm(b[2]): print(\"  Cerr=%r\"%a[2][-300:]); print(\"  Rerr=%r\"%b[2][-300:])\n        x,y=norm(a[1]),norm(b[1])\n        for i in range(min(len(x),len(y))):\n            if x[i]!=y[i]: print(\"  @%d C=%r\"%(i,x[max(0,i-220):i+220])); print(\"       R=%r\"%(y[max(0,i-220):i+220])); break\nPYEOF\ntimeout 1500 python3 \"$TMPDIR/fz3.py\" 20000 300 14","is_backgrounded":false,"task_type":"local_bash","uuid":"c52b8bc5-6f74-428e-b3f6-cb15b7ffe6ea","session_id":"c291cb1f-2668-45aa-801e-ac393f2cc752"}
