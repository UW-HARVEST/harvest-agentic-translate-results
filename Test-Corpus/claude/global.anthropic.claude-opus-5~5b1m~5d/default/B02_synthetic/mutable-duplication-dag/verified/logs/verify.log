m.Random(seed)\n    bad = 0\n    skipped = 0\n    for _ in range(rounds):\n        data = gen(rng)\n        c1 = run(C, data)\n        r1 = run(R, data)\n        if c1 == r1:\n            continue\n        if any(run(C, data) != c1 for _ in range(3)):\n            skipped += 1\n            continue\n        bad += 1\n        print(\"=== MISMATCH (C is deterministic here) ===\")\n        print(\"input:\", data)\n        for name, a, b in ((\"stdout\", c1[0], r1[0]), (\"stderr\", c1[1], r1[1]),\n                           (\"status\", c1[2], r1[2])):\n            if a != b:\n                print(f\"  {name}: C={a!r}\\n         R={b!r}\")\n        if bad >= 3:\n            break\n    print(f\"rounds={rounds} mismatches={bad} nondeterministic_skipped={skipped}\")\n\n\nmain()\n","structuredPatch":[{"oldStart":1,"oldLines":8,"newStart":1,"newLines":5,"lines":["-written","-in/env python3","-\"\"\"Random differential fuzz: only report a mismatch when the C program agrees","-with itself across repeated runs (otherwise the input is in the known","-ASLR-dependent class and no translation could match it).\"\"\"","+#!/usr/bin/env python3","+\"\"\"Delete-heavy random differential fuzz (stresses the malloc/free model).\"\"\""," import random"," import subprocess"," import sys"]},{"oldStart":19,"oldLines":8,"newStart":16,"newLines":7,"lines":[" "," def gen(rng):","     cities = [\"N%d\" % k for k in range(1, 15)] + [\"H\"]","-    dists = [\"0\", \"1\", \"5\", \"-1\", \"2147483647\", \"2000000000\", \"abc\", \"\",","-             \"4294967301\", \"99999999999999999999\"]","+    dists = [\"0\", \"1\", \"5\", \"-1\", \"2147483647\", \"2000000000\", \"abc\"]","     out = []","     for _ in range(rng.randint(20, 90)):","         c = rng.choice([1, 1, 1, 1, 2, 2, 3, 4, 5, 6, 6, 7, 7, 7, 7, 8])"]},{"oldStart":28,"oldLines":8,"newStart":24,"newLines":8,"lines":["             out += [\"1\", rng.choice(cities)]","         elif c == 2:","             out += [\"2\", rng.choice(cities), rng.ch