 key  = &tcache\n];\n\n/// Backing store for every `malloc`ed `node_t`: one entry per distinct heap\n/// chunk, so a `NodeRef` behaves like the `node_t *` it stands for - including\n/// the fact that a chunk which is freed and allocated again yields the *same*\n/// pointer, which the C program's output exposes.\n///\n/// `malloc`/`free` for the single size class used by `node_t` (248-byte chunks)\n/// are modelled the way glibc 2.34 behaves for this program:\n///\n///   * `free()` pushes the chunk on the tcache bin (LIFO) while that bin holds\n///     fewer than `TCACHE_COUNT` chunks, so `malloc()` hands back the most\n///     recently freed chunk first.\n///   * once the bin is full the chunk goes to the unsorted bin / gets\n///     consolidated into the top chunk; those are handed out again in\n///     ascending address order, which is the arena index order here.\n///   * freeing a chunk that is already on a free list is a double free and\n///     glibc aborts the process instead of returning.\npub struct Arena {\n    pub nodes: Vec<Node>,\n    /// Chunks in the tcache bin, most recently freed last (LIFO).\n    tcache: Vec<NodeRef>,\n    /// Chunks that did not fit in the tcache bin, handed out lowest first.\n    overflow: Vec<NodeRef>,\n}\n\nimpl Arena {\n    pub fn new() -> Arena {\n        Arena {\n            nodes: Vec::new(),\n            tcache: Vec::new(),\n            overflow: Vec::new(),\n        }\n    }\n\n    /// `malloc(sizeof(node_t))`: reuse a chunk from the free lists if there is\n    /// one, otherwise carve a fresh one out of the top chunk.\n    fn malloc_node(&mut self) -> NodeRef {\n        if let Some(node) = self.tcache.pop() {\n            return node;\n        }\n        if !self.overflow.is_empty() {\n            let mut lowest = 0;\n            for i in 1..self.overflow.len() {\n                if self.overflow[i] < self.overflow[lowest] {\n                    lowest = i;\n                }\n            }\n            return self.overflow.remove(lowest);\n        }\n        self.nodes.push(Node {\n            city_name: [0u8; MAX_CITY_NAME],\n            ref_count: 0,\n            edges: Vec::new(),\n            edge_count: 0,\n            freed: false,\n        });\n        self.nodes.len() - 1\n    }\n\n    /// `free(node)`.\n    fn free_node(&mut self, node: NodeRef) {\n        if self.nodes[node].freed {\n            // glibc refuses to free a chunk that is already free.\n            if self.tcache.contains(&node) {\n                malloc_printerr(b\"free(): double free detected in tcache 2\\n\");\n            }\n            malloc_printerr(b\"double free or corruption (out)\\n\");\n        }\n\n        self.nodes[node].freed = true;\n        self.nodes[node].city_name[..FREE_LIST_METADATA.len()]\n            .copy_from_slice(&FREE_LIST_METADATA);\n\n        if self.tcache.len() < TCACHE_COUNT {\n            self.tcache.push(node);\n        } else {\n            self.overflow.push(node);\n        }\n    }\n\n    /// `malloc(sizeof(node_t))` + the initialisation performed by `add_node`.\n    fn alloc_node(&mut self, city_name: &[u8]) -> NodeRef {\n        let node = self.malloc_node();\n\n        // `malloc()` does not clear the chunk, but `strncpy(dst, src, 63)`\n        // writes all 63 bytes (NUL padded) and `city_name[63] = '\\0'` the last\n        // one, so the whole array is overwritten either way.\n        let mut buf = [0u8; MAX_CITY_NAME];\n        // strncpy(node->city_name, city_name, MAX_CITY_NAME - 1);\n        // node->city_name[MAX_CITY_NAME - 1] = '\\0';\n        let n = if city_name.len() < MAX_CITY_NAME - 1 {\n            city_name.len()\n        } else {\n            MAX_CITY_NAME - 1\n        };\n        buf[..n].copy_from_slice(&city_name[..n]);\n        buf[MAX_CITY_NAME - 1] = 0;\n\n        let slot = &mut self.nodes[node];\n        slot.city_name = buf;\n        slot.ref_count = 1;\n        // `edge_count = 0` hides the stale `edges` left over from the previous\n      