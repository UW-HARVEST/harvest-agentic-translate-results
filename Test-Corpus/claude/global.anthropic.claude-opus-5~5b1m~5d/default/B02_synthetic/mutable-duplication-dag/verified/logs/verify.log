{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011TKYby9zPV6Kbtz6LA7Mkt","type":"tool_result","content":"1\t//! Translation of `c_src/src/lib.c` / `c_src/include/dag_lib.h`.\n2\t//!\n3\t//! The C code hands out raw `node_t *` pointers, keeps them inside the graph\n4\t//! and (in `delete_node`) `free()`s a node while the graph still holds the\n5\t//! pointer.  Here every node lives in an arena (`Arena`) and a `node_t *` is\n6\t//! modelled as an index into that arena (`NodeRef`), so node identity\n7\t//! comparisons (`from->edges[i].destination == to`) keep working.  `free()` is\n8\t//! modelled as \"the storage stays valid and unchanged\", which keeps the\n9\t//! translation memory safe while preserving all observable output.\n10\t\n11\tuse crate::cio::{eput, COut};\n12\t\n13\tpub const MAX_CITY_NAME: usize = 64;\n14\tpub const MAX_EDGES: usize = 10;\n15\tpub const MAX_NODES: usize = 100;\n16\t\n17\t/// Stand-in for `node_t *`.\n18\tpub type NodeRef = usize;\n19\t\n20\t/// `struct edge_t`\n21\tpub struct Edge {\n22\t    pub destination: NodeRef,\n23\t    pub distance: i32,\n24\t}\n25\t\n26\t/// `struct node_t`\n27\tpub struct Node {\n28\t    /// `char city_name[MAX_CITY_NAME]`\n29\t    pub city_name: [u8; MAX_CITY_NAME],\n30\t    pub ref_count: i32,\n31\t    pub edges: Vec<Edge>,\n32\t    /// Kept explicitly so the `edge_count >= MAX_EDGES` check mirrors the C.\n33\t    pub edge_count: i32,\n34\t    /// Set once `free()` would have been called on the node.\n35\t    #[allow(dead_code)]\n36\t    pub freed: bool,\n37\t}\n38\t\n39\timpl Node {\n40\t    /// The value of the `city_name` C string (bytes up to the first NUL).\n41\t    pub fn name(&self) -> &[u8] {\n42\t        match self.city_name.iter().position(|&b| b == 0) {\n43\t            Some(i) => &self.city_name[..i],\n44\t            None => &self.city_name[..],\n45\t        }\n46\t    }\n47\t}\n48\t\n49\t/// Backing store for every `malloc`ed `node_t`.\n50\tpub struct Arena {\n51\t    pub nodes: Vec<Node>,\n52\t}\n53\t\n54\timpl Arena {\n55\t    pub fn new() -> Arena {\n56\t        Arena { nodes: Vec::new() }\n57\t    }\n58\t\n59\t    /// `malloc(sizeof(node_t))` + the initialisation performed by `add_node`.\n60\t    fn alloc_node(&mut self, city_name: &[u8]) -> NodeRef {\n61\t        let mut buf = [0u8; MAX_CITY_NAME];\n62\t        // strncpy(node->city_name, city_name, MAX_CITY_NAME - 1);\n63\t        // node->city_name[MAX_CITY_NAME - 1] = '\\0';\n64\t        let n = if city_name.len() < MAX_CITY_NAME - 1 {\n65\t            city_name.len()\n66\t        } else {\n67\t            MAX_CITY_NAME - 1\n68\t        };\n69\t        buf[..n].copy_from_slice(&city_name[..n]);\n70\t        buf[MAX_CITY_NAME - 1] = 0;\n71\t        self.nodes.push(Node {\n72\t            city_name: buf,\n73\t            ref_count: 1,\n74\t            edges: Vec::new(),\n75\t            edge_count: 0,\n76\t            freed: false,\n77\t        });\n78\t        self.nodes.len() - 1\n79\t    }\n80\t}\n81\t\n82\t/// `struct graph_t`\n83\tpub struct Graph {\n84\t    pub nodes: Vec<NodeRef>,\n85\t    pub node_count: i32,\n86\t}\n87\t\n88\t// Create a new empty graph\n89\tpub fn create_graph() -> Option<Graph> {\n90\t    Some(Graph {\n91\t        nodes: Vec::new(),\n92\t        node_count: 0,\n93\t    })\n94\t}\n95\t\n96\t// Add a node to the graph\n97\tpub fn add_node(arena: &mut Arena, graph: &mut Graph, city_name: &[u8]) -> Option<NodeRef> {\n98\t    if graph.node_count as usize >= MAX_NODES {\n99\t        eput(format!(\"Error: Graph is full (max {} nodes)\\n\", MAX_NODES).as_bytes());\n100\t        return None;\n101\t    }\n102\t\n103\t    // Check if node already exists\n104\t    for i in 0..graph.node_count as usize {\n105\t        if arena.nodes[graph.nodes[i]].name() == city_name {\n106\t            let mut msg: Vec<u8> = Vec::new();\n107\t            msg.extend_from_slice(b\"Error: Node '\");\n108\t            msg.extend_from_slice(city_name);\n109\t            msg.extend_from_slice(b\"' already exists\\n\");\n110\t            eput(&msg);\n111\t            return None;\n112\t        }\n113\t    }\n114\t\n115\t    let node = arena.alloc_node(city_name);\n116\t\n117\t    // Add to graph\n118\t    graph.nodes.push(node);\n119\t    graph.node_count += 1;\n120\t\n121\t    Some(node)\n122\t}\n123\t\n124\t// Add an edge between two nodes\n125\tpub fn add_edge(arena: &mut Arena, from: NodeRef, to: NodeRef, distance: i32) -> i32 {\n126\t    if arena.nodes[from].edge_count as usize >= MAX_EDGES {\n127\t        let mut msg: Vec<u8> = Vec::new();\n128\t        msg.extend_from_slice(b\"Error: Node '\");\n129\t        msg.extend_from_slice(arena.nodes[from].name());\n130\t        msg.extend_from_slice(b\"' has maximum edges\\n\");\n131\t        eput(&msg);\n132\t        return -1;\n133\t    }\n134\t\n135\t    if distance < 0 {\n136\t        eput(b\"Error: Negative distance not allowed\\n\");\n137\t        return -1;\n138\t    }\n139\t\n140\t    // Check for duplicate edge\n141\t    for i in 0..arena.nodes[from].edge_count as usize {\n142\t        if arena.nodes[from].edges[i].destination == to {\n143\t            eput(b\"Error: Edge already exists\\n\");\n144\t            return -1;\n145\t        }\n146\t    }\n147\t\n148\t    // Add edge\n149\t    arena.nodes[from].edges.push(Edge {\n150\t        destination: to,\n151\t        distance,\n152\t    });\n153\t    arena.nodes[from].edge_count += 1;\n154\t\n155\t    0\n156\t}\n157\t\n158\t// Delete a node (decrement ref count, free if 0)\n159\tpub fn delete_node(arena: &mut Arena, node: NodeRef) {\n160\t    arena.nodes[node].ref_count -= 1;\n161\t\n162\t    if arena.nodes[node].ref_count == 0 {\n163\t        // free(node): the storage is left untouched here, mirroring the\n164\t        // original program which keeps using the (dangling) pointer.\n165\t        arena.nodes[node].freed = true;\n166\t    }\n167\t}\n168\t\n169\t// Helper function to increment ref count recursively\n170\tfn increment_refs_recursive(arena: &mut Arena, node: NodeRef, visited: &mut Vec<NodeRef>) {\n171\t    // Check if already visited\n172\t    for i in 0..visited.len() {\n173\t        if visited[i] == node {\n174\t            return;\n175\t        }\n176\t    }\n177\t\n178\t    // Mark as visited\n179\t    if visited.len() < MAX_NODES {\n180\t        visited.push(node);\n181\t    }\n182\t\n183\t    // Increment ref count\n184\t    arena.nodes[node].ref_count += 1;\n185\t\n186\t    // Recursively process all connected nodes\n187\t    for i in 0..arena.nodes[node].edge_count as usize {\n188\t        let destination = arena.nodes[node].edges[i].destination;\n189\t        increment_refs_recursive(arena, destination, visited);\n190\t    }\n191\t}\n192\t\n193\t// Create shallow copy of subsection (increments ref counts)\n194\tpub fn shallow_copy(arena: &mut Arena, start: NodeRef) -> Option<NodeRef> {\n195\t    // Track visited nodes to avoid cycles\n196\t    let mut visited: Vec<NodeRef> = Vec::new();\n197\t\n198\t    // Increment ref counts for all reachable nodes\n199\t    increment_refs_recursive(arena, start, &mut visited);\n200\t\n201\t    Some(start)\n202\t}\n203\t\n204\t// Helper structure for shortest path algorithm\n205\tstruct DijkstraNode {\n206\t    node: NodeRef,\n207\t    distance: i32,\n208\t    previous: Option<NodeRef>,\n209\t    visited: bool,\n210\t}\n211\t\n212\t// Find shortest path using Dijkstra's algorithm\n213\tpub fn find_shortest_path(\n214\t    arena: &Arena,\n215\t    start: NodeRef,\n216\t    end: NodeRef,\n217\t    path_length: &mut i32,\n218\t) -> Option<Vec<NodeRef>> {\n219\t    // Initialize Dijkstra state\n220\t    let mut state: Vec<DijkstraNode> = Vec::new();\n221\t\n222\t    // Add start node\n223\t    state.push(DijkstraNode {\n224\t        node: start,\n225\t        distance: 0,\n226\t        previous: None,\n227\t        visited: false,\n228\t    });\n229\t\n230\t    let mut current: Option<NodeRef> = Some(start);\n231\t\n232\t    while let Some(cur) = current {\n233\t        // Find current node in state\n234\t        let mut current_idx: isize = -1;\n235\t        for i in 0..state.len() {\n236\t            if state[i].node == cur {\n237\t                current_idx = i as isize;\n238\t                break;\n239\t            }\n240\t        }\n241\t\n242\t        if current_idx == -1 {\n243\t            break;\n244\t        }\n245\t        let ci = current_idx as usize;\n246\t\n247\t        state[ci].visited = true;\n248\t\n249\t        // Check if we reached the end\n250\t        if cur == end {\n251\t            break;\n252\t        }\n253\t\n254\t        // Update distances for neighbors\n255\t        for i in 0..arena.nodes[cur].edge_count as usize {\n256\t            let neighbor = arena.nodes[cur].edges[i].destination;\n257\t            let new_distance = state[ci]\n258\t                .distance\n259\t                .wrapping_add(arena.nodes[cur].edges[i].distance);\n260\t\n261\t            // Find or add neighbor in state\n262\t            let mut neighbor_idx: isize = -1;\n263\t            for j in 0..state.len() {\n264\t                if state[j].node == neighbor {\n265\t                    neighbor_idx = j as isize;\n266\t                    break;\n267\t                }\n268\t            }\n269\t\n270\t            if neighbor_idx == -1 && state.len() < MAX_NODES {\n271\t                // Add new neighbor\n272\t                neighbor_idx = state.len() as isize;\n273\t                state.push(DijkstraNode {\n274\t                    node: neighbor,\n275\t                    distance: i32::MAX,\n276\t                    previous: None,\n277\t                    visited: false,\n278\t                });\n279\t            }\n280\t\n281\t            if neighbor_idx != -1 && new_distance < state[neighbor_idx as usize].distance {\n282\t                state[neighbor_idx as usize].distance = new_distance;\n283\t                state[neighbor_idx as usize].previous = Some(cur);\n284\t            }\n285\t        }\n286\t\n287\t        // Find next unvisited node with minimum distance\n288\t        let mut min_distance = i32::MAX;\n289\t        current = None;\n290\t        for i in 0..state.len() {\n291\t            if !state[i].visited && state[i].distance < min_distance {\n292\t                min_distance = state[i].distance;\n293\t                current = Some(state[i].node);\n294\t            }\n295\t        }\n296\t    }\n297\t\n298\t    // Find end node in state\n299\t    let mut end_idx: isize = -1;\n300\t    for i in 0..state.len() {\n301\t        if state[i].node == end {\n302\t            end_idx = i as isize;\n303\t            break;\n304\t        }\n305\t    }\n306\t\n307\t    if end_idx == -1 || state[end_idx as usize].distance == i32::MAX {\n308\t        eput(b\"No path found\\n\");\n309\t        *path_length = 0;\n310\t        return None;\n311\t    }\n312\t\n313\t    // Reconstruct path\n314\t    let mut path: Vec<NodeRef> = Vec::new();\n315\t    let mut current_node: Option<NodeRef> = Some(end);\n316\t\n317\t    while let Some(cn) = current_node {\n318\t        path.push(cn);\n319\t\n320\t        // Find previous node\n321\t        let mut current_state_idx: isize = -1;\n322\t        for i in 0..state.len() {\n323\t            if state[i].node == cn {\n324\t                current_state_idx = i as isize;\n325\t                break;\n326\t            }\n327\t        }\n328\t\n329\t        if current_state_idx == -1 {\n330\t            break;\n331\t        }\n332\t\n333\t        current_node = state[current_state_idx as usize].previous;\n334\t    }\n335\t\n336\t    let count = path.len();\n337\t\n338\t    // Reverse path\n339\t    let mut result: Vec<NodeRef> = Vec::with_capacity(count);\n340\t    for i in 0..count {\n341\t        result.push(path[count - 1 - i]);\n342\t    }\n343\t\n344\t    *path_length = count as i32;\n345\t    Some(result)\n346\t}\n347\t\n348\t// Get node by city name\n349\tpub fn get_node_by_name(arena: &Arena, graph: &Graph, city_name: &[u8]) -> Option<NodeRef> {\n350\t    for i in 0..graph.node_count as usize {\n351\t        if arena.nodes[graph.nodes[i]].name() == city_name {\n352\t            return Some(graph.nodes[i]);\n353\t        }\n354\t    }\n355\t\n356\t    None\n357\t}\n358\t\n359\t// Print node information\n360\tpub fn print_node(out: &mut COut, arena: &Arena, node: NodeRef) {\n361\t    let n = &arena.nodes[node];\n362\t    out.put(b\"City: \");\n363\t    out.put(n.name());\n364\t    out.put(format!(\" (ref_count: {})\\n\", n.ref_count).as_bytes());\n365\t    out.put(b\"  Edges:\\n\");\n366\t    for i in 0..n.edge_count as usize {\n367\t        out.put(b\"    -> \");\n368\t        out.put(arena.nodes[n.edges[i].destination].name());\n369\t        out.put(format!(\" (distance: {})\\n\", n.edges[i].distance).as_bytes());\n370\t    }\n371\t}\n372\t\n373\t// Print entire graph\n374\tpub fn print_graph(out: &mut COut, arena: &Arena, graph: &Graph) {\n375\t    out.put(format!(\"Graph with {} nodes:\\n\", graph.node_count).as_bytes());\n376\t    for i in 0..graph.node_count as usize {\n377\t        print_node(out, arena, graph.nodes[i]);\n378\t    }\n379\t}\n380\t\n381\t// Free the entire graph\n382\tpub fn free_graph(arena: &mut Arena, graph: &Graph) {\n383\t    // Decrement ref count for all nodes\n384\t    for i in 0..graph.node_count as usize {\n385\t        delete_node(arena, graph.nodes[i]);\n386\t    }\n387\t\n388\t    // free(graph)\n389\t}\n390\t"}]},"parent_tool_use_id":null,"session_id":"c291cb1f-2668-45aa-801e-ac393f2cc752","uuid":"7f10bda2-9fec-416c-86c5-07964898563b","timestamp":"2026-08-28T04:32:23.221Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-FbQLo9/translation/src/dag_lib.rs","content":"//! Translation of `c_src/src/lib.c` / `c_src/include/dag_lib.h`.\n//!\n//! The C code hands out raw `node_t *` pointers, keeps them inside the graph\n//! and (in `delete_node`) `free()`s a node while the graph still holds the\n//! pointer.  Here every node lives in an arena (`Arena`) and a `node_t *` is\n//! modelled as an index into that arena (`NodeRef`), so node identity\n//! comparisons (`from->edges[i].destination == to`) keep working.  `free()` is\n//! modelled as \"the storage stays valid and unchanged\", which keeps the\n//! translation memory safe while preserving all observable output.\n\nuse crate::cio::{eput, COut};\n\npub const MAX_CITY_NAME: usize = 64;\npub const MAX_EDGES: usize = 10;\npub const MAX_NODES: usize = 100;\n\n/// Stand-in for `node_t *`.\npub type NodeRef = usize;\n\n/// `struct edge_t`\npub struct Edge {\n    pub destination: NodeRef,\n    pub distance: i32,\n}\n\n/// `struct node_t`\npub struct Node {\n    /// `char city_name[MAX_CITY_NAME]`\n    pub city_name: [u8; MAX_CITY_NAME],\n    pub ref_count: i32,\n    pub edges: Vec<Edge>,\n    /// Kept explicitly so the `edge_count >= MAX_EDGES` check mirrors the C.\n    pub edge_count: i32,\n    /// Set once `free()` would have been called on the node.\n    #[allow(dead_code)]\n    pub freed: bool,\n}\n\nimpl Node {\n    /// The value of the `city_name` C string (bytes up to the first NUL).\n    pub fn name(&self) -> &[u8] {\n        match self.city_name.iter().position(|&b| b == 0) {\n            Some(i) => &self.city_name[..i],\n            None => &self.city_name[..],\n        }\n    }\n}\n\n/// Backing store for every `malloc`ed `node_t`.\npub struct Arena {\n    pub nodes: Vec<Node>,\n}\n\nimpl Arena {\n    pub fn new() -> Arena {\n        Arena { nodes: Vec::new() }\n    }\n\n    /// `malloc(sizeof(node_t))` + the initialisation performed by `add_node`.\n    fn alloc_node(&mut self, city_name: &[u8]) -> NodeRef {\n        let mut buf = [0u8; MAX_CITY_NAME];\n        // strncpy(node->city_name, city_name, MAX_CITY_NAME - 1);\n        // node->city_name[MAX_CITY_NAME - 1] = '\\0';\n        let n = if city_name.len() < MAX_CITY_NAME - 1 {\n            city_name.len()\n        } else {\n            MAX_CITY_NAME - 1\n        };\n        buf[..n].copy_from_slice(&city_name[..n]);\n        buf[MAX_CITY_NAME - 1] = 0;\n        self.nodes.push(Node {\n            city_name: buf,\n            ref_count: 1,\n            edges: Vec::new(),\n            edge_count: 0,\n            freed: false,\n        });\n        self.nodes.len() - 1\n    }\n}\n\n/// `struct graph_t`\npub struct Graph {\n    pub nodes: Vec<NodeRef>,\n    pub node_count: i32,\n}\n\n// Create a new empty graph\npub fn create_graph() -> Option<Graph> {\n    Some(Graph {\n        nodes: Vec::new(),\n        node_count: 0,\n    })\n}\n\n// Add a node to the graph\npub fn add_node(arena: &mut Arena, graph: &mut Graph, city_name: &[u8]) -> Option<NodeRef> {\n    if graph.node_count as usize >= MAX_NODES {\n        eput(format!(\"Error: Graph is full (max {} nodes)\\n\", MAX_NODES).as_bytes());\n        return None;\n    }\n\n    // Check if node already exists\n    for i in 0..graph.node_count as usize {\n        if arena.nodes[graph.nodes[i]].name() == city_name {\n            let mut msg: Vec<u8> = Vec::new();\n            msg.extend_from_slice(b\"Error: Node '\");\n            msg.extend_from_slice(city_name);\n            msg.extend_from_slice(b\"' already exists\\n\");\n            eput(&msg);\n            return None;\n        }\n    }\n\n    let node = arena.alloc_node(city_name);\n\n    // Add to graph\n    graph.nodes.push(node);\n    graph.node_count += 1;\n\n    Some(node)\n}\n\n// Add an edge between two nodes\npub fn add_edge(arena: &mut Arena, from: NodeRef, to: NodeRef, distance: i32) -> i32 {\n    if arena.nodes[from].edge_count as usize >= MAX_EDGES {\n        let mut msg: Vec<u8> = Vec::new();\n        msg.extend_from_slice(b\"Error: Node '\");\n        msg.extend_from_slice(arena.nodes[from].name());\n        msg.extend_from_slice(b\"' has maximum edges\\n\");\n        eput(&msg);\n        return -1;\n    }\n\n    if distance < 0 {\n        eput(b\"Error: Negative distance not allowed\\n\");\n        return -1;\n    }\n\n    // Check for duplicate edge\n    for i in 0..arena.nodes[from].edge_count as usize {\n        if arena.nodes[from].edges[i].destination == to {\n            eput(b\"Error: Edge already exists\\n\");\n            return -1;\n        }\n    }\n\n    // Add edge\n    arena.nodes[from].edges.push(Edge {\n        destination: to,\n        distance,\n    });\n    arena.nodes[from].edge_count += 1;\n\n    0\n}\n\n// Delete a node (decrement ref count, free if 0)\npub fn delete_node(arena: &mut Arena, node: NodeRef) {\n    arena.nodes[node].ref_count -= 1;\n\n    if arena.nodes[node].ref_count == 0 {\n        // free(node): the storage is left untouched here, mirroring the\n        // original program which keeps using the (dangling) pointer.\n        arena.nodes[node].freed = true;\n    }\n}\n\n// Helper function to increment ref count recursively\nfn increment_refs_recursive(arena: &mut Arena, node: NodeRef, visited: &mut Vec<NodeRef>) {\n    // Check if already visited\n    for i in 0..visited.len() {\n        if visited[i] == node {\n            return;\n        }\n    }\n\n    // Mark as visited\n    if visited.len() < MAX_NODES {\n        visited.push(node);\n    }\n\n    // Increment ref count\n    arena.nodes[node].ref_count += 1;\n\n    // Recursively process all connected nodes\n    for i in 0..arena.nodes[node].edge_count as usize {\n        let destination = arena.nodes[node].edges[i].destination;\n        increment_refs_recursive(arena, destination, visited);\n    }\n}\n\n// Create shallow copy of subsection (increments ref counts)\npub fn shallow_copy(arena: &mut Arena, start: NodeRef) -> Option<NodeRef> {\n    // Track visited nodes to avoid cycles\n    let mut visited: Vec<NodeRef> = Vec::new();\n\n    // Increment ref counts for all reachable nodes\n    increment_refs_recursive(arena, start, &mut visited);\n\n    Some(start)\n}\n\n// Helper structure for shortest path algorithm\nstruct DijkstraNode {\n    node: NodeRef,\n    distance: i32,\n    previous: Option<NodeRef>,\n    visited: bool,\n}\n\n// Find shortest path using Dijkstra's algorithm\npub fn find_shortest_path(\n    arena: &Arena,\n    start: NodeRef,\n    end: NodeRef,\n    path_length: &mut i32,\n) -> Option<Vec<NodeRef>> {\n    // Initialize Dijkstra state\n    let mut state: Vec<DijkstraNode> = Vec::new();\n\n    // Add start node\n    state.push(DijkstraNode {\n        node: start,\n        distance: 0,\n        previous: None,\n        visited: false,\n    });\n\n    let mut current: Option<NodeRef> = Some(start);\n\n    while let Some(cur) = current {\n        // Find current node in state\n        let mut current_idx: isize = -1;\n        for i in 0..state.len() {\n            if state[i].node == cur {\n                current_idx = i as isize;\n                break;\n            }\n        }\n\n        if current_idx == -1 {\n            break;\n        }\n        let ci = current_idx as usize;\n\n        state[ci].visited = true;\n\n        // Check if we reached the end\n        if cur == end {\n            break;\n        }\n\n        // Update distances for neighbors\n        for i in 0..arena.nodes[cur].edge_count as usize {\n            let neighbor = arena.nodes[cur].edges[i].destination;\n            let new_distance = state[ci]\n                .distance\n                .wrapping_add(arena.nodes[cur].edges[i].distance);\n\n            // Find or add neighbor in state\n            let mut neighbor_idx: isize = -1;\n            for j in 0..state.len() {\n                if state[j].node == neighbor {\n                    neighbor_idx = j as isize;\n                    break;\n                }\n            }\n\n            if neighbor_idx == -1 && state.len() < MAX_NODES {\n                // Add new neighbor\n                neighbor_idx = state.len() as isize;\n                state.push(DijkstraNode {\n                    node: neighbor,\n                    distance: i32::MAX,\n                    previous: None,\n                    visited: false,\n                });\n            }\n\n            if neighbor_idx != -1 && new_distance < state[neighbor_idx as usize].distance {\n                state[neighbor_idx as usize].distance = new_distance;\n                state[neighbor_idx as usize].previous = Some(cur);\n            }\n        }\n\n        // Find next unvisited node with minimum distance\n        let mut min_distance = i32::MAX;\n        current = None;\n        for i in 0..state.len() {\n            if !state[i].visited && state[i].distance < min_distance {\n                min_distance = state[i].distance;\n                current = Some(state[i].node);\n            }\n        }\n    }\n\n    // Find end node in state\n    let mut end_idx: isize = -1;\n    for i in 0..state.len() {\n        if state[i].node == end {\n            end_idx = i as isize;\n            break;\n        }\n    }\n\n    if end_idx == -1 || state[end_idx as usize].distance == i32::MAX {\n        eput(b\"No path found\\n\");\n        *path_length = 0;\n        return None;\n    }\n\n    // Reconstruct path\n    let mut path: Vec<NodeRef> = Vec::new();\n    let mut current_node: Option<NodeRef> = Some(end);\n\n    while let Some(cn) = current_node {\n        path.push(cn);\n\n        // Find previous node\n        let mut current_state_idx: isize = -1;\n        for i in 0..state.len() {\n            if state[i].node == cn {\n                current_state_idx = i as isize;\n                break;\n            }\n        }\n\n        if current_state_idx == -1 {\n            break;\n        }\n\n        current_node = state[current_state_idx as usize].previous;\n    }\n\n    let count = path.len();\n\n    // Reverse path\n    let mut result: Vec<NodeRef> = Vec::with_capacity(count);\n    for i in 0..count {\n        result.push(path[count - 1 - i]);\n    }\n\n    *path_length = count as i32;\n    Some(result)\n}\n\n// Get node by city name\npub fn get_node_by_name(arena: &Arena, graph: &Graph, city_name: &[u8]) -> Option<NodeRef> {\n    for i in 0..graph.node_count as usize {\n        if arena.nodes[graph.nodes[i]].name() == city_name {\n            return Some(graph.nodes[i]);\n        }\n    }\n\n    None\n}\n\n// Print node information\npub fn print_node(out: &mut COut, arena: &Arena, node: NodeRef) {\n    let n = &arena.nodes[node];\n    out.put(b\"City: \");\n    out.put(n.name());\n    out.put(format!(\" (ref_count: {})\\n\", n.ref_count).as_bytes());\n    out.put(b\"  Edges:\\n\");\n    for i in 0..n.edge_count as usize {\n        out.put(b\"    -> \");\n        out.put(arena.nodes[n.edges[i].destination].name());\n        out.put(format!(\" (distance: {})\\n\", n.edges[i].distance).as_bytes());\n    }\n}\n\n// Print entire graph\npub fn print_graph(out: &mut COut, arena: &Arena, graph: &Graph) {\n    out.put(format!(\"Graph with {} nodes:\\n\", graph.node_count).as_bytes());\n    for i in 0..graph.node_count as usize {\n        print_node(out, arena, graph.nodes[i]);\n    }\n}\n\n// Free the entire graph\npub fn free_graph(arena: &mut Arena, graph: &Graph) {\n    // Decrement ref count for all nodes\n    for i in 0..graph.node_count as usize {\n        delete_node(arena, graph.nodes[i]);\n    }\n\n    // free(graph)\n}\n","numLines":390,"startLine":1,"totalLines":390}}}
