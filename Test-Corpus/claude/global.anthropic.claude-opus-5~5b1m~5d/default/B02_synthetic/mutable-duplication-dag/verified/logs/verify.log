append(b\"8\"); return b\"\\n\".join(out)+b\"\\n\"\ns0=int(sys.argv[1]); N=int(sys.argv[2]); buckets=collections.Counter(); ex={}\nfor s in range(s0,s0+N):\n    rng=random.Random(s); d=gen(rng,rng.randint(10,140))\n    try: a=run(C,d); b=run(R,d)\n    except subprocess.TimeoutExpired: buckets[\"TIMEOUT\"]+=1; ex.setdefault(\"TIMEOUT\",(s,d,None,None)); continue\n    r=eq(a,b)\n    if r is None: continue\n    buckets[r]+=1; ex.setdefault(r,(s,d,a,b))\nprint(\"buckets:\",dict(buckets), \"of\", N)\nfor k,v in ex.items():\n    print(\"---\",k,\"seed\",v[0]); print(\"  input:\",v[1][:700])\n    if v[2]:\n        a,b=v[2],v[3]; print(\"  C st=%s out=%d ; R st=%s out=%d\"%(a[0],len(a[1]),b[0],len(b[1])))\n        xs,ys=toks(a[1]),toks(b[1])\n        if toks(a[2])!=toks(b[2]):\n            for i,(p,q) in enumerate(zip(toks(a[2]),toks(b[2]))):\n                if p!=q: print(\"  err line %d C=%r R=%r\"%(i,p,q)); break\n            else: print(\"  err len C=%d R=%d, extra C=%r R=%r\"%(len(toks(a[2])),len(toks(b[2])),toks(a[2])[len(toks(b[2])):][:5],toks(b[2])[len(toks(a[2])):][:5]))\n        for i,(p,q) in enumerate(zip(xs,ys)):\n            if p!=q: print(\"  out line %d\\n    C=%r\\n    R=%r\"%(i,p,q)); print(\"  ctx C=%r\"%xs[max(0,i-6):i+6]); print(\"  ctx R=%r\"%ys[max(0,i-6):i+6]); break\n        else:\n            print(\"  out nlines C=%d R=%d extraC=%r extraR=%r\"%(len(xs),len(ys),xs[len(ys):][:6],ys[len(xs):][:6]))\nPYEOF\ntimeout 1500 python3 \"$TMPDIR/fz4.py\" 20000 300 14","is_backgrounded":false,"task_type":"local_bash","uuid":"9fa845cc-17f5-484d-aa55-7ee10317c754","session_id":"c291cb1f-2668-45aa-801e-ac393f2cc752"}
