 end and suppress SIGPIPE entirely.\n    let guard = SPAWN_LOCK.write().expect(\"spawn lock poisoned\");\n    let mut fds = [-1i32; 2];\n    let write_end = unsafe {\n        assert_eq!(pipe(fds.as_mut_ptr()), 0, \"pipe(2) failed\");\n        // Drop the read end immediately: nothing will ever read this pipe.\n        assert_eq!(close(fds[0]), 0, \"close(2) failed\");\n        Stdio::from(std::fs::File::from_raw_fd(fds[1]))\n    };\n\n    let mut child = Command::new(exe)\n        .stdin(Stdio::piped())\n        .stdout(write_end)\n        .stderr(Stdio::piped())\n        .spawn()\n        .unwrap_or_else(|e| panic!(\"failed to spawn {}: {e}\", exe.display()));\n    drop(guard);\"\"\"\n    if stream == \"stderr\":\n        old = old.replace(\".stdout(write_end)\\n        .stderr(Stdio::piped())\",\n                          \".stdout(Stdio::piped())\\n        .stderr(write_end)\")\n        new = new.replace(\".stdout(write_end)\\n        .stderr(Stdio::piped())\",\n                          \".stdout(Stdio::piped())\\n        .stderr(write_end)\")\n    assert old in s, stream\n    s = s.replace(old, new, 1)\n\n# 3. temp files must live in the crate's own target dir (always readable/writable)\nold_tmp = '''    let dir = std::env::temp_dir().join(format!(\"driver_difftest_{}\", std::process::id()));'''\nnew_tmp = '''    // CARGO_TARGET_TMPDIR is inside the crate's target/ directory, so it is\n    // guaranteed writable and readable regardless of how TMPDIR is configured.\n    let dir = Path::new(env!(\"CARGO_TARGET_TMPDIR\")).join(\"file_stdin\");'''\nassert old_tmp in s; s = s.replace(old_tmp, new_tmp)\n\nopen(p,\"w\").write(s)\nprint(\"patched mod.rs\")\nPY\ncargo build --release --tests 2>&1 | tail -20","description":"Harden harness against fork/fd race and fix temp dir","timeout":300000}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1727,"cache_read_input_tokens":138997,"cache_creation":{"ephe