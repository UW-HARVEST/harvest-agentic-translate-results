all decisions)\n39\t///   * 3: validate sequence (checks pattern)\n40\t/// * `param` - Operation-specific parameter (logic operator, mode, etc)\n41\t///\n42\t/// Returns the operation result or an error code.\n43\t///\n44\t/// In C the first parameter is a `char *`; the `NULL` check is modelled with\n45\t/// `Option`.  Passing `None` corresponds to `decision_string == NULL`.\n46\tpub fn process_decisions(\n47\t    decision_string: Option<&[u8]>,\n48\t    length: usize,\n49\t    operation: i32,\n50\t    param: i32,\n51\t) -> i32 {\n52\t    let decision_string = match decision_string {\n53\t        None => return -1,\n54\t        Some(s) => {\n55\t            if length == 0 {\n56\t                return -1;\n57\t            }\n58\t            s\n59\t        }\n60\t    };\n61\t\n62\t    match operation {\n63\t        0 => {\n64\t            /* Apply permissions: read, write, execute */\n65\t            if length < 3 {\n66\t                return -2;\n67\t            }\n68\t\n69\t            let read = parse_bool(decision_string[0]);\n70\t            let write = parse_bool(decision_string[1]);\n71\t            let execute = parse_bool(decision_string[2]);\n72\t\n73\t            apply_permissions(read, write, execute)\n74\t        }\n75\t\n76\t        1 => {\n77\t            /* Evaluate logical conditions */\n78\t            if length < 3 {\n79\t                return -2;\n80\t            }\n81\t\n82\t            let cond1 = parse_bool(decision_string[0]);\n83\t            let cond2 = parse_bool(decision_string[1]);\n84\t            let cond3 = parse_bool(decision_string[2]);\n85\t\n86\t            /* param determines logic operation: 0=AND, 1=OR, 2=XOR, 3=NAND */\n87\t            evaluate_conditions(cond1, cond2, cond3, param)\n88\t        }\n89\t\n90\t        2 => {\n91\t            /* Configure flags from all decisions */\n92\t            let mut decisions = [false; 32];\n93\t            let count = if length < 32 { length } else { 32 };\n94\t\n95\t            for i in 0..count {\n96\t                decisions[i] = parse_bool(decision_string[i]);\n97\t            }\n98\t\n99\t            configure_flags(&decisions, count)\n100\t        }\n101\t\n102\t        3 => {\n103\t            /* Validate decision sequence */\n104\t            validate_sequence(decision_string, length)\n105\t        }\n106\t\n107\t        _ => -3,\n108\t    }\n109\t}\n110\t\n111\t/// Parse character to boolean\n112\t/// 'y' or 'Y' -> true\n113\t/// 'n' or 'N' -> false\n114\t/// anything else -> false\n115\tfn parse_bool(c: u8) -> bool {\n116\t    if c == b'y' || c == b'Y' {\n117\t        true\n118\t    } else if c == b'n' || c == b'N' {\n119\t        false\n120\t    } else {\n121\t        false /* Default to false for invalid input */\n122\t    }\n123\t}\n124\t\n125\t/// Apply permissions based on read/write/execute flags\n126\t/// Complex branching based on boolean combinations\n127\tfn apply_permissions(read: bool, write: bool, execute: bool) -> i32 {\n128\t    let mut permission_value: i32 = 0;\n129\t\n130\t    /* Base permission calculation */\n131\t    if read {\n132\t        permission_value += 4;\n133\t    }\n134\t    if write {\n135\t        permission_value += 2;\n136\t    }\n137\t    if execute {\n138\t        permission_value += 1;\n139\t    }\n140\t\n141\t    /* Complex decision tree based on combinations */\n142\t    if read && write && execute {\n143\t        /* Full permissions - special handling */\n144\t        return 100 + permission_value; /* 107 */\n145\t    } else if read && write {\n146\t        /* Read/write but no execute */\n147\t        if permission_value == 6 {\n148\t            return 50 + permission_value; /* 56 */\n149\t        }\n150\t    } else if read && execute {\n151\t        /* Read/execute but no write */\n152\t        return 30 + permission_value; /* 35 */\n153\t    } else if write && execute {\n154\t        /* Write/execute but no read - unusual case */\n155\t        return 20 + permission_value; /* 23 */\n156\t    } else if read {\n157\t        /* Read only */\n158\t        return 10 + permission_value; /* 14 */\n159\t    } else if write {\n160\t        /* Write only - dangerous */\n161\t        return -10;\n162\t    } else if execute {\n163\t        /* Execute only - very unusual */\n164\t        return -20;\n165\t    }\n166\t\n167\t    /* No permissions */\n168\t    0\n169\t}\n170\t\n171\t/// Evaluate three conditions with different logic operators\n172\tfn evaluate_conditions(cond1: bool, cond2: bool, cond3: bool, logic_op: i32) -> i32 {\n173\t    let result: bool;\n174\t\n175\t    match logic_op {\n176\t        0 => {\n177\t            /* AND - all must be true */\n178\t            result = cond1 && cond2 && cond3;\n179\t\n180\t            if result {\n181\t                100\n182\t            } else {\n183\t                /* Partial matches */\n184\t                if cond1 && cond2 {\n185\t                    return 50;\n186\t                }\n187\t                if cond1 && cond3 {\n188\t                    return 51;\n189\t                }\n190\t                if cond2 && cond3 {\n191\t                    return 52;\n192\t                }\n193\t                if cond1 {\n194\t                    return 10;\n195\t                }\n196\t                if cond2 {\n197\t                    return 11;\n198\t                }\n199\t                if cond3 {\n200\t                    return 12;\n201\t                }\n202\t                0\n203\t            }\n204\t        }\n205\t\n206\t        1 => {\n207\t            /* OR - at least one must be true */\n208\t            result = cond1 || cond2 || cond3;\n209\t\n210\t            if result {\n211\t                /* Count how many are true */\n212\t                let mut count: i32 = 0;\n213\t                if cond1 {\n214\t                    count += 1;\n215\t                }\n216\t                if cond2 {\n217\t                    count += 1;\n218\t                }\n219\t                if cond3 {\n220\t                    count += 1;\n221\t                }\n222\t                return 100 + count;\n223\t            }\n224\t            0\n225\t        }\n226\t\n227\t        2 => {\n228\t            /* XOR - odd number must be true */\n229\t            result = cond1 ^ cond2 ^ cond3;\n230\t\n231\t            if result {\n232\t                /* Determine which combination */\n233\t                if cond1 && !cond2 && !cond3 {\n234\t                    return 1;\n235\t                }\n236\t                if !cond1 && cond2 && !cond3 {\n237\t                    return 2;\n238\t                }\n239\t                if !cond1 && !cond2 && cond3 {\n240\t                    return 3;\n241\t                }\n242\t                if cond1 && cond2 && cond3 {\n243\t                    return 7;\n244\t                }\n245\t                return 90;\n246\t            }\n247\t            0\n248\t        }\n249\t\n250\t        3 => {\n251\t            /* NAND - not all true */\n252\t            result = !(cond1 && cond2 && cond3);\n253\t\n254\t            if result {\n255\t                /* Various false combinations */\n256\t                if !cond1 && !cond2 && !cond3 {\n257\t                    return 200;\n258\t                }\n259\t                if !cond1 {\n260\t                    return 150;\n261\t                }\n262\t                if !cond2 {\n263\t                    return 151;\n264\t                }\n265\t                if !cond3 {\n266\t                    return 152;\n267\t                }\n268\t                return 100;\n269\t            }\n270\t            0\n271\t        }\n272\t\n273\t        _ => -1,\n274\t    }\n275\t}\n276\t\n277\t/// Configure system flags based on array of decisions\n278\t/// Creates bitmask and applies various rules\n279\tfn configure_flags(decisions: &[bool], count: usize) -> i32 {\n280\t    let mut flags: u32 = 0;\n281\t    let mut special_count: i32 = 0;\n282\t\n283\t    /* Build flag bitmask */\n284\t    let mut i = 0usize;\n285\t    while i < count && i < 32 {\n286\t        if decisions[i] {\n287\t            flags |= 1u32 << i;\n288\t            special_count += 1;\n289\t        }\n290\t        i += 1;\n291\t    }\n292\t    /* `flags` is computed but never used by the C code either. */\n293\t    let _ = flags;\n294\t\n295\t    /* Apply rules based on flag patterns */\n296\t    if special_count == 0 {\n297\t        /* All false */\n298\t        return 0;\n299\t    } else if special_count as usize == count {\n300\t        /* All true */\n301\t        return 1000 + count as i32;\n302\t    } else if special_count == 1 {\n303\t        /* Exactly one true - find which one */\n304\t        for i in 0..count {\n305\t            if decisions[i] {\n306\t                return 100 + i as i32;\n307\t            }\n308\t        }\n309\t    } else if special_count as usize == count.wrapping_sub(1) {\n310\t        /* Exactly one false - find which one */\n311\t        for i in 0..count {\n312\t            if !decisions[i] {\n313\t                return 200 + i as i32;\n314\t            }\n315\t        }\n316\t    }\n317\t\n318\t    /* Check for alternating pattern */\n319\t    let mut alternating = true;\n320\t    for i in 1..count {\n321\t        if decisions[i] == decisions[i - 1] {\n322\t            alternating = false;\n323\t            break;\n324\t        }\n325\t    }\n326\t\n327\t    if alternating {\n328\t        return 500 + special_count;\n329\t    }\n330\t\n331\t    /* Check for consecutive true values */\n332\t    let mut max_consecutive: i32 = 0;\n333\t    let mut current_consecutive: i32 = 0;\n334\t    for i in 0..count {\n335\t        if decisions[i] {\n336\t            current_consecutive += 1;\n337\t            if current_consecutive > max_consecutive {\n338\t                max_consecutive = current_consecutive;\n339\t            }\n340\t        } else {\n341\t            current_consecutive = 0;\n342\t        }\n343\t    }\n344\t\n345\t    if max_consecutive >= 3 {\n346\t        return 300 + max_consecutive;\n347\t    }\n348\t\n349\t    /* Return count of true values */\n350\t    special_count\n351\t}\n352\t\n353\t/// Validate sequence has proper pattern\n354\t/// Checks various decision sequence rules\n355\tfn validate_sequence(sequence: &[u8], len: usize) -> i32 {\n356\t    if len == 0 {\n357\t        return 0;\n358\t    }\n359\t\n360\t    /* Convert all to bools.  The C code aliases the caller's `char` buffer\n361\t     * (`bool *bools = (bool*)sequence;`) and overwrites byte `i` right after\n362\t     * reading it, so no already-pending read is ever disturbed; an owned\n363\t     * buffer is therefore behaviourally identical. */\n364\t    let mut bools = vec![false; len];\n365\t    for i in 0..len {\n366\t        let val = parse_bool(sequence[i]);\n367\t        bools[i] = val;\n368\t    }\n369\t\n370\t    /* Rule 1: Must start with 'y' */\n371\t    if !bools[0] {\n372\t        return -10;\n373\t    }\n374\t\n375\t    /* Rule 2: Must end with 'n' if length > 1 */\n376\t    if len > 1 && bools[len - 1] {\n377\t        return -11;\n378\t    }\n379\t\n380\t    /* Rule 3: Cannot have more than 3 consecutive same values */\n381\t    let mut consecutive: i32 = 1;\n382\t    for i in 1..len {\n383\t        if bools[i] == bools[i - 1] {\n384\t            consecutive += 1;\n385\t            if consecutive > 3 {\n386\t                return -12;\n387\t            }\n388\t        } else {\n389\t            consecutive = 1;\n390\t        }\n391\t    }\n392\t\n393\t    /* Rule 4: Count transitions */\n394\t    let mut transitions: i32 = 0;\n395\t    for i in 1..len {\n396\t        if bools[i] != bools[i - 1] {\n397\t            transitions += 1;\n398\t        }\n399\t    }\n400\t\n401\t    /* Validate based on length */\n402\t    if len <= 3 {\n403\t        /* Short sequences - simple rules */\n404\t        if transitions == 0 {\n405\t            return 1; /* All same (but passes other rules) */\n406\t        }\n407\t        if transitions as usize == len - 1 {\n408\t            return 2; /* All different */\n409\t        }\n410\t        10 + transitions\n411\t    } else if len <= 10 {\n412\t        /* Medium sequences */\n413\t        if (transitions as usize) < len / 3 {\n414\t            return 20; /* Few transitions */\n415\t        }\n416\t        if transitions as usize > len / 2 {\n417\t            return 30; /* Many transitions */\n418\t        }\n419\t        25\n420\t    } else {\n421\t        /* Long sequences */\n422\t        if transitions < 3 {\n423\t            return 40;\n424\t        }\n425\t        if transitions as usize > len - 3 {\n426\t            return 50;\n427\t        }\n428\t        45\n429\t    }\n430\t}\n431\t"}]},"parent_tool_use_id":null,"session_id":"7ee0a0eb-9b2b-4bb3-9d24-60ee853026b6","uuid":"8803e501-ad6e-45d7-be0c-2bcff9804985","timestamp":"2026-08-27T22:45:15.323Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-AiWb4r/translation/src/lib.rs","content":"/*\n * Copyright 2025 MIT Lincoln Laboratory\n * Permission is hereby granted, free of charge,\n * to any person obtaining a copy of this software\n * and associated documentation files (the \"Software\"),\n * to deal in the Software without restriction,\n * including without limitation the rights to use, copy,\n * modify, merge, publish, distribute, sublicense,\n * and/or sell copies of the Software,\n * and to permit persons to whom the Software is furnished to do so,\n * subject to the following conditions:\n *\n * The above copyright notice and this permission notice\n * shall be included in all copies or substantial portions of the Software.\n *\n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n * THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n */\n\n//! Direct translation of `c_src/src/lib.c`.\n//!\n//! The C entry point is `process_decisions`, which dispatches on `operation`\n//! over a string of 'y'/'n' characters.\n\n/// Main entrance function - processes boolean decisions\n///\n/// * `decision_string` - String of 'y'/'n' characters representing decisions\n/// * `length` - Length of decision string\n/// * `operation` - Operation to perform:\n///   * 0: apply permissions (uses first 3 decisions)\n///   * 1: evaluate conditions with logic (uses first 3 decisions)\n///   * 2: configure flags (uses all decisions)\n///   * 3: validate sequence (checks pattern)\n/// * `param` - Operation-specific parameter (logic operator, mode, etc)\n///\n/// Returns the operation result or an error code.\n///\n/// In C the first parameter is a `char *`; the `NULL` check is modelled with\n/// `Option`.  Passing `None` corresponds to `decision_string == NULL`.\npub fn process_decisions(\n    decision_string: Option<&[u8]>,\n    length: usize,\n    operation: i32,\n    param: i32,\n) -> i32 {\n    let decision_string = match decision_string {\n        None => return -1,\n        Some(s) => {\n            if length == 0 {\n                return -1;\n            }\n            s\n        }\n    };\n\n    match operation {\n        0 => {\n            /* Apply permissions: read, write, execute */\n            if length < 3 {\n                return -2;\n            }\n\n            let read = parse_bool(decision_string[0]);\n            let write = parse_bool(decision_string[1]);\n            let execute = parse_bool(decision_string[2]);\n\n            apply_permissions(read, write, execute)\n        }\n\n        1 => {\n            /* Evaluate logical conditions */\n            if length < 3 {\n                return -2;\n            }\n\n            let cond1 = parse_bool(decision_string[0]);\n            let cond2 = parse_bool(decision_string[1]);\n            let cond3 = parse_bool(decision_string[2]);\n\n            /* param determines logic operation: 0=AND, 1=OR, 2=XOR, 3=NAND */\n            evaluate_conditions(cond1, cond2, cond3, param)\n        }\n\n        2 => {\n            /* Configure flags from all decisions */\n            let mut decisions = [false; 32];\n            let count = if length < 32 { length } else { 32 };\n\n            for i in 0..count {\n                decisions[i] = parse_bool(decision_string[i]);\n            }\n\n            configure_flags(&decisions, count)\n        }\n\n        3 => {\n            /* Validate decision sequence */\n            validate_sequence(decision_string, length)\n        }\n\n        _ => -3,\n    }\n}\n\n/// Parse character to boolean\n/// 'y' or 'Y' -> true\n/// 'n' or 'N' -> false\n/// anything else -> false\nfn parse_bool(c: u8) -> bool {\n    if c == b'y' || c == b'Y' {\n        true\n    } else if c == b'n' || c == b'N' {\n        false\n    } else {\n        false /* Default to false for invalid input */\n    }\n}\n\n/// Apply permissions based on read/write/execute flags\n/// Complex branching based on boolean combinations\nfn apply_permissions(read: bool, write: bool, execute: bool) -> i32 {\n    let mut permission_value: i32 = 0;\n\n    /* Base permission calculation */\n    if read {\n        permission_value += 4;\n    }\n    if write {\n        permission_value += 2;\n    }\n    if execute {\n        permission_value += 1;\n    }\n\n    /* Complex decision tree based on combinations */\n    if read && write && execute {\n        /* Full permissions - special handling */\n        return 100 + permission_value; /* 107 */\n    } else if read && write {\n        /* Read/write but no execute */\n        if permission_value == 6 {\n            return 50 + permission_value; /* 56 */\n        }\n    } else if read && execute {\n        /* Read/execute but no write */\n        return 30 + permission_value; /* 35 */\n    } else if write && execute {\n        /* Write/execute but no read - unusual case */\n        return 20 + permission_value; /* 23 */\n    } else if read {\n        /* Read only */\n        return 10 + permission_value; /* 14 */\n    } else if write {\n        /* Write only - dangerous */\n        return -10;\n    } else if execute {\n        /* Execute only - very unusual */\n        return -20;\n    }\n\n    /* No permissions */\n    0\n}\n\n/// Evaluate three conditions with different logic operators\nfn evaluate_conditions(cond1: bool, cond2: bool, cond3: bool, logic_op: i32) -> i32 {\n    let result: bool;\n\n    match logic_op {\n        0 => {\n            /* AND - all must be true */\n            result = cond1 && cond2 && cond3;\n\n            if result {\n                100\n            } else {\n                /* Partial matches */\n                if cond1 && cond2 {\n                    return 50;\n                }\n                if cond1 && cond3 {\n                    return 51;\n                }\n                if cond2 && cond3 {\n                    return 52;\n                }\n                if cond1 {\n                    return 10;\n                }\n                if cond2 {\n                    return 11;\n                }\n                if cond3 {\n                    return 12;\n                }\n                0\n            }\n        }\n\n        1 => {\n            /* OR - at least one must be true */\n            result = cond1 || cond2 || cond3;\n\n            if result {\n                /* Count how many are true */\n                let mut count: i32 = 0;\n                if cond1 {\n                    count += 1;\n                }\n                if cond2 {\n                    count += 1;\n                }\n                if cond3 {\n                    count += 1;\n                }\n                return 100 + count;\n            }\n            0\n        }\n\n        2 => {\n            /* XOR - odd number must be true */\n            result = cond1 ^ cond2 ^ cond3;\n\n            if result {\n                /* Determine which combination */\n                if cond1 && !cond2 && !cond3 {\n                    return 1;\n                }\n                if !cond1 && cond2 && !cond3 {\n                    return 2;\n                }\n                if !cond1 && !cond2 && cond3 {\n                    return 3;\n                }\n                if cond1 && cond2 && cond3 {\n                    return 7;\n                }\n                return 90;\n            }\n            0\n        }\n\n        3 => {\n            /* NAND - not all true */\n            result = !(cond1 && cond2 && cond3);\n\n            if result {\n                /* Various false combinations */\n                if !cond1 && !cond2 && !cond3 {\n                    return 200;\n                }\n                if !cond1 {\n                    return 150;\n                }\n                if !cond2 {\n                    return 151;\n                }\n                if !cond3 {\n                    return 152;\n                }\n                return 100;\n            }\n            0\n        }\n\n        _ => -1,\n    }\n}\n\n/// Configure system flags based on array of decisions\n/// Creates bitmask and applies various rules\nfn configure_flags(decisions: &[bool], count: usize) -> i32 {\n    let mut flags: u32 = 0;\n    let mut special_count: i32 = 0;\n\n    /* Build flag bitmask */\n    let mut i = 0usize;\n    while i < count && i < 32 {\n        if decisions[i] {\n            flags |= 1u32 << i;\n            special_count += 1;\n        }\n        i += 1;\n    }\n    /* `flags` is computed but never used by the C code either. */\n    let _ = flags;\n\n    /* Apply rules based on flag patterns */\n    if special_count == 0 {\n        /* All false */\n        return 0;\n    } else if special_count as usize == count {\n        /* All true */\n        return 1000 + count as i32;\n    } else if special_count == 1 {\n        /* Exactly one true - find which one */\n        for i in 0..count {\n            if decisions[i] {\n                return 100 + i as i32;\n            }\n        }\n    } else if special_count as usize == count.wrapping_sub(1) {\n        /* Exactly one false - find which one */\n        for i in 0..count {\n            if !decisions[i] {\n                return 200 + i as i32;\n            }\n        }\n    }\n\n    /* Check for alternating pattern */\n    let mut alternating = true;\n    for i in 1..count {\n        if decisions[i] == decisions[i - 1] {\n            alternating = false;\n            break;\n        }\n    }\n\n    if alternating {\n        return 500 + special_count;\n    }\n\n    /* Check for consecutive true values */\n    let mut max_consecutive: i32 = 0;\n    let mut current_consecutive: i32 = 0;\n    for i in 0..count {\n        if decisions[i] {\n            current_consecutive += 1;\n            if current_consecutive > max_consecutive {\n                max_consecutive = current_consecutive;\n            }\n        } else {\n            current_consecutive = 0;\n        }\n    }\n\n    if max_consecutive >= 3 {\n        return 300 + max_consecutive;\n    }\n\n    /* Return count of true values */\n    special_count\n}\n\n/// Validate sequence has proper pattern\n/// Checks various decision sequence rules\nfn validate_sequence(sequence: &[u8], len: usize) -> i32 {\n    if len == 0 {\n        return 0;\n    }\n\n    /* Convert all to bools.  The C code aliases the caller's `char` buffer\n     * (`bool *bools = (bool*)sequence;`) and overwrites byte `i` right after\n     * reading it, so no already-pending read is ever disturbed; an owned\n     * buffer is therefore behaviourally identical. */\n    let mut bools = vec![false; len];\n    for i in 0..len {\n        let val = parse_bool(sequence[i]);\n        bools[i] = val;\n    }\n\n    /* Rule 1: Must start with 'y' */\n    if !bools[0] {\n        return -10;\n    }\n\n    /* Rule 2: Must end with 'n' if length > 1 */\n    if len > 1 && bools[len - 1] {\n        return -11;\n    }\n\n    /* Rule 3: Cannot have more than 3 consecutive same values */\n    let mut consecutive: i32 = 1;\n    for i in 1..len {\n        if bools[i] == bools[i - 1] {\n            consecutive += 1;\n            if consecutive > 3 {\n                return -12;\n            }\n        } else {\n            consecutive = 1;\n        }\n    }\n\n    /* Rule 4: Count transitions */\n    let mut transitions: i32 = 0;\n    for i in 1..len {\n        if bools[i] != bools[i - 1] {\n            transitions += 1;\n        }\n    }\n\n    /* Validate based on length */\n    if len <= 3 {\n        /* Short sequences - simple rules */\n        if transitions == 0 {\n            return 1; /* All same (but passes other rules) */\n        }\n        if transitions as usize == len - 1 {\n            return 2; /* All different */\n        }\n        10 + transitions\n    } else if len <= 10 {\n        /* Medium sequences */\n        if (transitions as usize) < len / 3 {\n            return 20; /* Few transitions */\n        }\n        if transitions as usize > len / 2 {\n            return 30; /* Many transitions */\n        }\n        25\n    } else {\n        /* Long sequences */\n        if transitions < 3 {\n            return 40;\n        }\n        if transitions as usize > len - 3 {\n            return 50;\n        }\n        45\n    }\n}\n","numLines":431,"startLine":1,"totalLines":431}}}
