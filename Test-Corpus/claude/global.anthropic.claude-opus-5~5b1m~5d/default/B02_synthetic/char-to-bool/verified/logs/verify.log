{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QmN6oU4YJCWBz5J9yFSTY4","type":"tool_result","content":"228\t}\n229\t\n230\t/// Run `exe` with `input` on stdin but with **stdout connected to a pipe whose\n231\t/// reader has already been closed**, so the first write to stdout fails.\n232\t///\n233\t/// A C program has the default `SIGPIPE` disposition and is killed by signal\n234\t/// 13; the Rust program must behave the same way rather than panicking.\n235\t#[cfg(unix)]\n236\tpub fn run_with_broken_stdout(exe: &Path, input: &[u8]) -> Run {\n237\t    use std::os::unix::io::FromRawFd;\n238\t\n239\t    extern \"C\" {\n240\t        fn pipe(fds: *mut i32) -> i32;\n241\t        fn close(fd: i32) -> i32;\n242\t    }\n243\t\n244\t    let mut fds = [-1i32; 2];\n245\t    let write_end = unsafe {\n246\t        assert_eq!(pipe(fds.as_mut_ptr()), 0, \"pipe(2) failed\");\n247\t        // Drop the read end immediately: nothing will ever read this pipe.\n248\t        assert_eq!(close(fds[0]), 0, \"close(2) failed\");\n249\t        Stdio::from(std::fs::File::from_raw_fd(fds[1]))\n250\t    };\n251\t\n252\t    let mut child = Command::new(exe)\n253\t        .stdin(Stdio::piped())\n254\t        .stdout(write_end)\n255\t        .stderr(Stdio::piped())\n256\t        .spawn()\n257\t        .unwrap_or_else(|e| panic!(\"failed to spawn {}: {e}\", exe.display()));\n258\t\n259\t    {\n260\t        let mut stdin = child.stdin.take().expect(\"piped stdin\");\n261\t        let _ = stdin.write_all(input);\n262\t        let _ = stdin.flush();\n263\t    }\n264\t\n265\t    let out = child.wait_with_output().expect(\"wait_with_output\");\n266\t    use std::os::unix::process::ExitStatusExt;\n267\t    Run {\n268\t        stdout: Vec::new(),\n269\t        stderr: out.stderr,\n270\t        code: out.status.code(),\n271\t        signal: out.status.signal(),\n272\t    }\n273\t}\n274\t\n275\t/// Differential check with stdout pointing at a pipe that has no reader.\n276\t#[cfg(unix)]\n277\tpub fn check_broken_stdout(name: &str, input: &[u8]) {"}]},"parent_tool_use_id":null,"session_id":"7ee0a0eb-9b2b-4bb3-9d24-60ee853026b6","uuid":"b043f749-f6bb-4d3b-a691-a37df176970f","timestamp":"2026-08-27T23:26:05.721Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-AiWb4r/translation/tests/common/mod.rs","content":"}\n\n/// Run `exe` with `input` on stdin but with **stdout connected to a pipe whose\n/// reader has already been closed**, so the first write to stdout fails.\n///\n/// A C program has the default `SIGPIPE` disposition and is killed by signal\n/// 13; the Rust program must behave the same way rather than panicking.\n#[cfg(unix)]\npub fn run_with_broken_stdout(exe: &Path, input: &[u8]) -> Run {\n    use std::os::unix::io::FromRawFd;\n\n    extern \"C\" {\n        fn pipe(fds: *mut i32) -> i32;\n        fn close(fd: i32) -> i32;\n    }\n\n    let mut fds = [-1i32; 2];\n    let write_end = unsafe {\n        assert_eq!(pipe(fds.as_mut_ptr()), 0, \"pipe(2) failed\");\n        // Drop the read end immediately: nothing will ever read this pipe.\n        assert_eq!(close(fds[0]), 0, \"close(2) failed\");\n        Stdio::from(std::fs::File::from_raw_fd(fds[1]))\n    };\n\n    let mut child = Command::new(exe)\n        .stdin(Stdio::piped())\n        .stdout(write_end)\n        .stderr(Stdio::piped())\n        .spawn()\n        .unwrap_or_else(|e| panic!(\"failed to spawn {}: {e}\", exe.display()));\n\n    {\n        let mut stdin = child.stdin.take().expect(\"piped stdin\");\n        let _ = stdin.write_all(input);\n        let _ = stdin.flush();\n    }\n\n    let out = child.wait_with_output().expect(\"wait_with_output\");\n    use std::os::unix::process::ExitStatusExt;\n    Run {\n        stdout: Vec::new(),\n        stderr: out.stderr,\n        code: out.status.code(),\n        signal: out.status.signal(),\n    }\n}\n\n/// Differential check with stdout pointing at a pipe that has no reader.\n#[cfg(unix)]\npub fn check_broken_stdout(name: &str, input: &[u8]) {","numLines":50,"startLine":228,"totalLines":431}}}
