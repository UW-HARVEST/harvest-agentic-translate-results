647};\n    int vals[]  = {-2147483648, -70000, -1, 0, 1, 7, 65535, 65536, 2147483647};\n    int opts[]  = {-2147483648, -3, 0, 1, 2, 1000, 2147483647};\n    for (unsigned m = 0; m < sizeof(modes)/sizeof(*modes); m++) {\n        for (unsigned v = 0; v < sizeof(vals)/sizeof(*vals); v++) {\n            for (unsigned o = 0; o < sizeof(opts)/sizeof(*opts); o++) {\n                int o1 = opts[o];\n                int o2 = opts[(o + 3) % (sizeof(opts)/sizeof(*opts))];\n                printf(\"charinbuf(%d,%d,%d,%d) = %d\\n\", modes[m], vals[v], o1, o2,\n                       charinbuf(modes[m], vals[v], o1, o2));\n            }\n        }\n    }\n\n    /* ---- counter functions directly (shared static state) ---- */\n    printf(\"reset=%d\\n\", reset_counter(10));\n    for (int i = -3; i <= 3; i++) {\n        printf(\"inc(%d)=%d dec(%d)=%d mul(%d)=%d\\n\",\n               i, increment_counter(i), i, decrement_counter(i), i, multiply_counter(i));\n    }\n    printf(\"reset=%d\\n\", reset_counter(0x7fffffff));\n    printf(\"inc overflow=%d\\n\", increment_counter(1));\n    printf(\"mul overflow=%d\\n\", multiply_counter(3));\n    printf(\"reset min=%d\\n\", reset_counter(-2147483647 - 1));\n    printf(\"dec underflow=%d\\n\", decrement_counter(1));\n\n    /* ---- is_string_empty ---- */\n    printf(\"empty(NULL)=%d\\n\", is_string_empty(NULL));\n    printf(\"empty(\\\"\\\")=%d\\n\", is_string_empty(\"\"));\n    printf(\"empty(\\\"a\\\")=%d\\n\", is_string_empty(\"a\"));\n    printf(\"empty(\\\"\\\\0x\\\")=%d\\n\", is_string_empty(\"\\0x\"));\n    printf(\"empty(\\\" \\\")=%d\\n\", is_string_empty(\" \"));\n\n    /* ---- find_char_in_buffer ---- */\n    const char *buf = \"abc\\0def\\xff\\x80xyz\";\n    size_t buflen = 12;\n    printf(\"find(NULL)=%p\\n\", (void*)find_char_in_buffer(NULL, 5, 'a'));\n    int targets[] = {'a', 'c', 'd', 'z', 'Q', 0, (int)(signed char)0xff, (int)(signed char)0x80};\n    for (unsigned i = 0; i < sizeof(targets)/sizeof(*targets); i++) {\n     