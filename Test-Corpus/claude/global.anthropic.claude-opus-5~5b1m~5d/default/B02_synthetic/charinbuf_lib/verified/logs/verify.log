 extern \"C\" fn multiply_counter(value: c_int) -> c_int {\n89\t    unsafe {\n90\t        COUNTER = COUNTER.wrapping_mul(value);\n91\t        COUNTER\n92\t    }\n93\t}\n94\t\n95\t/// `int reset_counter(int value)`\n96\t#[unsafe(no_mangle)]\n97\tpub extern \"C\" fn reset_counter(value: c_int) -> c_int {\n98\t    unsafe {\n99\t        COUNTER = value;\n100\t        COUNTER\n101\t    }\n102\t}\n103\t\n104\t// ---------------------------------------------------------------------------\n105\t// String / buffer helpers\n106\t// ---------------------------------------------------------------------------\n107\t\n108\t/// `int is_string_empty(const char *str)`\n109\t///\n110\t/// Returns 1 for a NULL pointer or an empty string, 0 otherwise.\n111\t#[unsafe(no_mangle)]\n112\tpub unsafe extern \"C\" fn is_string_empty(str: *const c_char) -> c_int {\n113\t    if str.is_null() {\n114\t        return 1;\n115\t    }\n116\t    if *str != 0 {\n117\t        return 0;\n118\t    }\n119\t    1\n120\t}\n121\t\n122\t/// `char *find_char_in_buffer(const char *buffer, size_t size, char target)`\n123\t#[unsafe(no_mangle)]\n124\tpub unsafe extern \"C\" fn find_char_in_buffer(\n125\t    buffer: *const c_char,\n126\t    size: usize,\n127\t    target: c_char,\n128\t) -> *mut c_char {\n129\t    if buffer.is_null() {\n130\t        return ptr::null_mut();\n131\t    }\n132\t    // `target` is promoted to `int` (sign extended, `char` is signed on the\n133\t    // reference platform) exactly like the C call.\n134\t    memchr(buffer as *const c_void, target as c_int, size) as *mut c_char\n135\t}\n136\t\n137\t/// `char *create_buffer(const char *initial)`\n138\t///\n139\t/// Allocates with `malloc` so the result can be released with `free` by the\n140\t/// caller.  A failed allocation is propagated as NULL, and — as in the C — the\n141\t/// copy is only performed when the allocation succeeded.\n142\t#[unsafe(no_mangle)]\n143\tpub unsafe extern \"C\" fn create_buffer(initial: *const c_char) -> *mut c_char