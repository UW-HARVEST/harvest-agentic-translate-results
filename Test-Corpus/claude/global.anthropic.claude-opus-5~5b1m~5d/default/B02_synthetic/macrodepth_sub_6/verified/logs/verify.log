 THE SOFTWARE.\n    23\t\n    24\t//! Rust equivalent of `mdmacros.h`.\n    25\t//!\n    26\t//! The C header selects, at preprocessing time, an operation family (`OP`) and\n    27\t//! an iteration count (`REPEAT`) via `-D` defines supplied by CMake. Here those\n    28\t//! selections are resolved from Cargo features, using the exact same names in\n    29\t//! lowercase (`add`/`sub`/`mul` for `OP`; `0`..`7` for `REPEAT`).\n    30\t//!\n    31\t//! Feature semantics:\n    32\t//! * When no OP feature is enabled the default is `add`; when no REPEAT feature\n    33\t//!   is enabled the default is `5` (matching the CMake cache defaults).\n    34\t//! * Enabling several conflicting values still compiles (\"all combinations must\n    35\t//!   compile\"): OP priority is `mul > sub > add`, REPEAT priority is the highest\n    36\t//!   selected number.\n    37\t\n    38\tuse core::ffi::c_int;\n    39\t\n    40\tuse crate::mdcore::{op_add, op_mul, op_sub};\n    41\t\n    42\t/// `STR(OP)` — the textual name of the selected operation.\n    43\t///\n    44\t/// Selection priority mirrors the cfg cascade used throughout this module:\n    45\t/// `mul` > `sub` > `add` (with `add` as the default).\n    46\tpub const OP_NAME: &str = if cfg!(feature = \"mul\") {\n    47\t    \"mul\"\n    48\t} else if cfg!(feature = \"sub\") {\n    49\t    \"sub\"\n    50\t} else {\n    51\t    \"add\"\n    52\t};\n    53\t\n    54\t/// `INIT_FOR(OP)` — the initial accumulator value for the selected op\n    55\t/// (`INIT_add == 0`, `INIT_sub == 0`, `INIT_mul == 1`).\n    56\tpub const INIT_FOR: c_int = if cfg!(feature = \"mul\") { 1 } else { 0 };\n    57\t\n    58\t/// `REPEAT` — the iteration count baked in at build time.\n    59\t///\n    60\t/// The C macros define `REP0`..`REP7`, so valid values are `0..=7`; the CMake\n    61\t/// default is `5`. If several REPEAT features are enabled the largest wins.\n    62\tpub const REPEAT: c_int = if cfg!(feature = \"7\") {\n    63\t    7\n    64\t} else if cfg!(feature = \"6\") {\n    65\t    6\n    66\t} else if cfg!(feature = \"5\") {\n    67\t    5\n    68\t} else if cfg!(feature = \"4\") {\n    69\t    4\n    70\t} else if cfg!(feature = \"3\") {\n    71\t    3\n    72\t} else if cfg!(feature = \"2\") {\n    73\t    2\n    74\t} else if cfg!(feature = \"1\") {\n    75\t    1\n    76\t} else if cfg!(feature = \"0\") {\n    77\t    0\n    78\t} else {\n    79\t    5\n    80\t};\n    81\t\n    82\t/// `STEP_OP(OP, acc, i)` for the selected operation.\n    83\t///\n    84\t/// * `add`: `acc += i`\n    85\t/// * `sub`: `acc -= i`\n    86\t/// * `mul`: `acc *= (i + 1)`\n    87\t///\n    88\t/// Arithmetic wraps on overflow to match the two's-complement behavior produced\n    89\t/// by the C toolchain for these programs.\n    90\t#[inline]\n    91\tpub fn step(acc: c_int, i: c_int) -> c_int {\n    92\t    if cfg!(feature = \"mul\") {\n    93\t        acc.wrapping_mul(i.wrapping_add(1))\n    94\t    } else if cfg!(feature = \"sub\") {\n    95\t        acc.wrapping_sub(i)\n    96\t    } else {\n    97\t        acc.wrapping_add(i)\n    98\t    }\n    99\t}\n   100\t\n   101\t/// `(OP_FN(OP))(a, b)` — invoke the selected operation directly.\n   102\t#[inline]\n   103\tpub fn op_fn(a: c_int, b: c_int) -> c_int {\n   104\t    if cfg!(feature = \"mul\") {\n   105\t        op_mul(a, b)\n   106\t    } else if cfg!(feature = \"sub\") {\n   107\t        op_sub(a, b)\n   108\t    } else {\n   109\t        op_add(a, b)\n   110\t    }\n   111\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
