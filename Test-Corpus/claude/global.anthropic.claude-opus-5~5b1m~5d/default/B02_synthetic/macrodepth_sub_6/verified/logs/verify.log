t    {\n    24\t        idx += 1;\n    25\t    }\n    26\t    let mut negative = false;\n    27\t    if idx < bytes.len() && (bytes[idx] == b'+' || bytes[idx] == b'-') {\n    28\t        negative = bytes[idx] == b'-';\n    29\t        idx += 1;\n    30\t    }\n    31\t    let mut acc: i64 = 0;\n    32\t    let mut overflow = false;\n    33\t    while idx < bytes.len() && bytes[idx].is_ascii_digit() {\n    34\t        let d = (bytes[idx] - b'0') as i64;\n    35\t        if !overflow {\n    36\t            match acc.checked_mul(10).and_then(|v| v.checked_add(d)) {\n    37\t                Some(v) => acc = v,\n    38\t                None => overflow = true,\n    39\t            }\n    40\t        }\n    41\t        idx += 1;\n    42\t    }\n    43\t    let value: i64 = if overflow {\n    44\t        if negative {\n    45\t            i64::MIN\n    46\t        } else {\n    47\t            i64::MAX\n    48\t        }\n    49\t    } else if negative {\n    50\t        -acc\n    51\t    } else {\n    52\t        acc\n    53\t    };\n    54\t    value as c_int\n    55\t}\n    56\t\n    57\tfn main() {\n    58\t    let args: Vec<std::ffi::OsString> = std::env::args_os().collect();\n    59\t    let argc = args.len();\n    60\t\n    61\t    if argc < 3 {\n    62\t        let prog = args\n    63\t            .first()\n    64\t            .map(|s| String::from_utf8_lossy(s.as_bytes()).into_owned())\n    65\t            .unwrap_or_default();\n    66\t        let stderr = std::io::stderr();\n    67\t        let mut lock = stderr.lock();\n    68\t        let _ = write!(lock, \"usage: {} A B\\n\", prog);\n    69\t        let _ = lock.flush();\n    70\t        std::process::exit(2);\n    71\t    }\n    72\t\n    73\t    let a = atoi(args[1].as_bytes());\n    74\t    let b = atoi(args[2].as_bytes());\n    75\t\n    76\t    let r_call = (mdconfig::op_fn())(a, b);\n    77\t    let mut acc: c_int = INIT;\n    78\t    acc = mdconfig::run_loop(acc);\n    79\t\n    80\t    let x1 = mdcore