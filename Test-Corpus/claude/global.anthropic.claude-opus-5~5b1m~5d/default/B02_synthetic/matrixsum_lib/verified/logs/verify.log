failed\"\n    fi\n  done\n\n  if [ \"$compiled\" -eq 0 ]; then\n    echo \"  [$name] mutant did not compile (skipped)\"; return\n  fi\n\n  if [ -n \"$killed_by\" ]; then\n    echo \"  [$name] KILLED  <- $killed_by\"\n    if is_equivalent \"$name\"; then\n      echo \"  [$name] *** UNEXPECTEDLY KILLED — this mutant is semantics-preserving,\"\n      echo \"         so a test that fails on it is asserting something wrong ***\"\n      SURVIVORS+=(\"$name (equivalent mutant was killed)\")\n    fi\n  elif is_equivalent \"$name\"; then\n    echo \"  [$name] survived — EXPECTED (provably semantics-preserving)\"\n  else\n    echo \"  [$name] *** SURVIVED *** (blind spot!)\"\n    SURVIVORS+=(\"$name\")\n  fi\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2429,"cache_read_input_tokens":198681,"cache_creation":{"ephemeral_5m_input_tokens":2429,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8d463897-d2e4-446a-b9bb-aaf6d62cb9b1","uuid":"7276cd75-516b-4f35-85e4-3141bd41e237","timestamp":"2026-08-28T03:56:12.558Z"}
