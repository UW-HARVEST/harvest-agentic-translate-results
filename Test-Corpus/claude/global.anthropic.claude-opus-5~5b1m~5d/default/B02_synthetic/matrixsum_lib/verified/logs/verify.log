loc(size: size_t) -> *mut c_void;\n42\t    fn realloc(ptr: *mut c_void, size: size_t) -> *mut c_void;\n43\t    fn free(ptr: *mut c_void);\n44\t}\n45\t\n46\t// ---------------------------------------------------------------------------\n47\t// Global data\n48\t// ---------------------------------------------------------------------------\n49\t\n50\t// int matrix[3][4] = {\n51\t//     {0x01, 0x02, 0x03, 0x04},\n52\t//     {0x10, 0x20, 0x30, 0x40},\n53\t//     {0xA1, 0xB2, 0xC3, 0xD4}\n54\t// };\n55\t//\n56\t// This is a mutable, externally visible data object in the C library, so it is\n57\t// exported here as a `static mut` with the identical name and layout.\n58\t#[unsafe(no_mangle)]\n59\tpub static mut matrix: [[c_int; 4]; 3] = [\n60\t    [0x01, 0x02, 0x03, 0x04],\n61\t    [0x10, 0x20, 0x30, 0x40],\n62\t    [0xA1, 0xB2, 0xC3, 0xD4],\n63\t];\n64\t\n65\t// ---------------------------------------------------------------------------\n66\t// Macros\n67\t// ---------------------------------------------------------------------------\n68\t\n69\tconst FLAG_READ: c_int = 0b0000_0001;\n70\tconst FLAG_WRITE: c_int = 0b0000_0010;\n71\tconst FLAG_EXECUTE: c_int = 0b0000_0100;\n72\tconst FLAG_DELETE: c_int = 0b0000_1000;\n73\t\n74\t// ---------------------------------------------------------------------------\n75\t// typedef struct { int *data; size_t size; size_t capacity; } DynamicArray;\n76\t// ---------------------------------------------------------------------------\n77\t\n78\t#[repr(C)]\n79\tpub struct DynamicArray {\n80\t    pub data: *mut c_int,\n81\t    pub size: size_t,\n82\t    pub capacity: size_t,\n83\t}\n84\t\n85\t/// Size in bytes of one `int`, as `sizeof(int)` in the C source.\n86\tconst SIZEOF_INT: size_t = core::mem::size_of::<c_int>();\n87\t\n88\t// ---------------------------------------------------------------------------\n89\t// DynamicArray* init_array(size_t initial_capacity)\n90\t// ---------------------------------------------------------------------------\n91\t#[unsafe(no_mangle)]\n92\tpub unsafe extern \"C\" fn init_array(initial_capacity: size_t) -> *mut DynamicArray {\n93\t    let arr = malloc(core::mem::size_of::<DynamicArray>()) as *mut DynamicArray;\n94\t    if arr.is_null() {\n95\t        return core::ptr::null_mut();\n96\t    }\n97\t\n98\t    // `initial_capacity * sizeof(int)` is an unsigned (size_t) multiplication in\n99\t    // C, so it wraps on overflow rather than trapping.\n100\t    let bytes = initial_capacity.wrapping_mul(SIZEOF_INT);\n101\t    let data = malloc(bytes) as *mut c_int;\n102\t    (*arr).data = data;\n103\t    if (*arr).data.is_null() {\n104\t        free(arr as *mut c_void);\n105\t        return core::ptr::null_mut();\n106\t    }\n107\t\n108\t    (*arr).size = 0;\n109\t    (*arr).capacity = initial_capacity;\n110\t    arr\n111\t}\n112\t\n113\t// ---------------------------------------------------------------------------\n114\t// int expand_array(DynamicArray *arr)\n115\t// ---------------------------------------------------------------------------\n116\t#[unsafe(no_mangle)]\n117\tpub unsafe extern \"C\" fn expand_array(arr: *mut DynamicArray) -> c_int {\n118\t    if arr.is_null() {\n119\t        return 0;\n120\t    }\n121\t\n122\t    let new_capacity = (*arr).capacity.wrapping_mul(2);\n123\t    let new_data =\n124\t        realloc((*arr).data as *mut c_void, new_capacity.wrapping_mul(SIZEOF_INT)) as *mut c_int;\n125\t\n126\t    if new_data.is_null() {\n127\t        return 0;\n128\t    }\n129\t\n130\t    (*arr).data = new_data;\n131\t    (*arr).capacity = new_capacity;\n132\t    1\n133\t}\n134\t\n135\t// ---------------------------------------------------------------------------\n136\t// int add_element(DynamicArray *arr, int value)\n137\t// ---------------------------------------------------------------------------\n138\t#[unsafe(no_mangle)]\n139\tpub unsafe extern \"C\" fn add_element(arr: *mut DynamicArray, value: c_int) -> c_int {\n140\t    if arr.is_null() {\n141\t        return 0;\n142\t    }\n143\t\n144\t    if (*arr).size >= (*arr).capacity {\n145\t        if expand_array(arr) == 0 {\n146\t            return 0;\n147\t        }\n148\t    }\n149\t\n150\t    let idx = (*arr).size;\n151\t    *(*arr).data.add(idx) = value;\n152\t    (*arr).size = idx.wrapping_add(1);\n153\t    1\n154\t}\n155\t\n156\t// ---------------------------------------------------------------------------\n157\t// void free_array(DynamicArray *arr)\n158\t// ---------------------------------------------------------------------------\n159\t#[unsafe(no_mangle)]\n160\tpub unsafe extern \"C\" fn free_array(arr: *mut DynamicArray) {\n161\t    if !arr.is_null() {\n162\t        free((*arr).data as *mut c_void);\n163\t        free(arr as *mut c_void);\n164\t    }\n165\t}\n166\t\n167\t// ---------------------------------------------------------------------------\n168\t// int process_flags(int flags)\n169\t// ---------------------------------------------------------------------------\n170\t#[unsafe(no_mangle)]\n171\tpub extern \"C\" fn process_flags(flags: c_int) -> c_int {\n172\t    let count: c_int;\n173\t\n174\t    let has_read = flags & FLAG_READ;\n175\t    let read_enabled = (has_read != 0) as c_int;\n176\t\n177\t    let has_write = flags & FLAG_WRITE;\n178\t    let write_enabled = (has_write != 0) as c_int;\n179\t\n180\t    let has_execute = flags & FLAG_EXECUTE;\n181\t    let execute_enabled = (has_execute != 0) as c_int;\n182\t\n183\t    let has_delete = flags & FLAG_DELETE;\n184\t    let delete_enabled = (has_delete != 0) as c_int;\n185\t\n186\t    count = read_enabled\n187\t        .wrapping_add(write_enabled)\n188\t        .wrapping_add(execute_enabled)\n189\t        .wrapping_add(delete_enabled);\n190\t\n191\t    count\n192\t}\n193\t\n194\t// ---------------------------------------------------------------------------\n195\t// int calculate_matrix_checksum()\n196\t//\n197\t// Note: declared with an empty (unprototyped) parameter list in C; the ABI for\n198\t// a call with no arguments is identical to `extern \"C\" fn() -> c_int`.\n199\t// ---------------------------------------------------------------------------\n200\t#[unsafe(no_mangle)]\n201\tpub extern \"C\" fn calculate_matrix_checksum() -> c_int {\n202\t    let mut sum: c_int = 0;\n203\t\n204\t    let m = &raw const matrix;\n205\t    let mut i: c_int = 0;\n206\t    while i < 3 {\n207\t        let mut j: c_int = 0;\n208\t        while j < 4 {\n209\t            // Read through a raw pointer: `matrix` is publicly mutable data.\n210\t            let v = unsafe { (*m)[i as usize][j as usize] };\n211\t            sum = sum.wrapping_add(v);\n212\t            j += 1;\n213\t        }\n214\t        i += 1;\n215\t    }\n216\t\n217\t    sum\n218\t}\n219\t\n220\t// ---------------------------------------------------------------------------\n221\t// int matrixsum(int param1, int param2, int param3, int param4)\n222\t// ---------------------------------------------------------------------------\n223\t#[unsafe(no_mangle)]\n224\tpub unsafe extern \"C\" fn matrixsum(\n225\t    param1: c_int,\n226\t    param2: c_int,\n227\t    param3: c_int,\n228\t    param4: c_int,\n229\t) -> c_int {\n230\t    let result: c_int;\n231\t\n232\t    let hex_base: c_int = 0xFF;\n233\t    let hex_multiplier: c_int = 0x10;\n234\t\n235\t    let mut permissions: c_int = 0b0000;\n236\t\n237\t    let check1 = param1;\n238\t    let valid1 = (check1 != 0) as c_int;\n239\t\n240\t    let check2 = param2;\n241\t    let valid2 = (check2 != 0) as c_int;\n242\t\n243\t    let check3 = param3;\n244\t    let valid3 = (check3 != 0) as c_int;\n245\t\n246\t    let check4 = param4;\n247\t    let valid4 = (check4 != 0) as c_int;\n248\t\n249\t    if valid1 != 0 {\n250\t        permissions |= FLAG_READ;\n251\t    }\n252\t    if valid2 != 0 {\n253\t        permissions |= FLAG_WRITE;\n254\t    }\n255\t    if valid3 != 0 {\n256\t        permissions |= FLAG_EXECUTE;\n257\t    }\n258\t    if valid4 != 0 {\n259\t        permissions |= FLAG_DELETE;\n260\t    }\n261\t\n262\t    let arr = init_array(2);\n263\t    if arr.is_null() {\n264\t        return -1;\n265\t    }\n266\t\n267\t    add_element(arr, param1);\n268\t    add_element(arr, param2);\n269\t    add_element(arr, param3);\n270\t    add_element(arr, param4);\n271\t\n272\t    let mut sum: c_int = 0;\n273\t    let mut i: size_t = 0;\n274\t    while i < (*arr).size {\n275\t        sum = sum.wrapping_add(*(*arr).data.add(i));\n276\t        i += 1;\n277\t    }\n278\t\n279\t    let flag_count = process_flags(permissions);\n280\t\n281\t    let matrix_sum = calculate_matrix_checksum();\n282\t\n283\t    result = sum\n284\t        .wrapping_mul(hex_multiplier)\n285\t        .wrapping_add(flag_count.wrapping_mul(hex_base))\n286\t        .wrapping_add(matrix_sum & 0xFFF);\n287\t\n288\t    free_array(arr);\n289\t\n290\t    result\n291\t}\n292\t"}]},"parent_tool_use_id":"toolu_bdrk_01BKEg3WjMYzasdUnF8hLuaZ","session_id":"8d463897-d2e4-446a-b9bb-aaf6d62cb9b1","uuid":"27fd6543-b564-4a54-8e80-4c9a49586e69","timestamp":"2026-08-28T03:38:02.826Z","subagent_type":"general-purpose","task_description":"Adversarial C-vs-Rust divergence audit"}
