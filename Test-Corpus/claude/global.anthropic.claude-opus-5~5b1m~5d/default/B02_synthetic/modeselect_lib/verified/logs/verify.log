of the\n    35\t    /// formatted output (including `%.2e` rounding and `%X` casing) is produced\n    36\t    /// by the exact same code path as the original C library.\n    37\t    #[link_name = \"printf\"]\n    38\t    unsafe fn c_printf(format: *const c_char, ...) -> c_int;\n    39\t\n    40\t    #[link_name = \"strcmp\"]\n    41\t    unsafe fn c_strcmp(s1: *const c_char, s2: *const c_char) -> c_int;\n    42\t\n    43\t    #[link_name = \"time\"]\n    44\t    unsafe fn c_time(tloc: *mut time_t) -> time_t;\n    45\t}\n    46\t\n    47\t// ---------------------------------------------------------------------------\n    48\t// String literals (NUL terminated, exactly as emitted by the C compiler).\n    49\t// ---------------------------------------------------------------------------\n    50\t\n    51\tconst S_STANDARD: &[u8] = b\"standard\\0\";\n    52\tconst S_ENHANCED: &[u8] = b\"enhanced\\0\";\n    53\tconst S_TURBO: &[u8] = b\"turbo\\0\";\n    54\tconst S_EXTREME: &[u8] = b\"extreme\\0\";\n    55\t\n    56\tconst FMT_SELECTED_MODE: &[u8] = b\"Selected mode: %s (0x%X)\\n\\0\";\n    57\tconst FMT_COMPLEXITY: &[u8] = b\"Complexity level: %d, Multiplier: 0x%X\\n\\0\";\n    58\tconst FMT_MODIFIED_TIME: &[u8] = b\"Modified time: %ld, Hash: 0x%X\\n\\0\";\n    59\tconst FMT_CONVERT_OVERFLOW: &[u8] = b\"Converting double %.2e to int (may overflow)...\\n\\0\";\n    60\tconst FMT_CONVERT_UNDERFLOW: &[u8] = b\"Converting double %.2e to int (may underflow)...\\n\\0\";\n    61\tconst FMT_RESULT1: &[u8] = b\"Result 1: %d (0x%X)\\n\\0\";\n    62\tconst FMT_RESULT2: &[u8] = b\"Result 2: %d (0x%X)\\n\\0\";\n    63\tconst FMT_FINAL: &[u8] = b\"\\nFinal result: %d (0x%X)\\n\\0\";\n    64\t\n    65\t#[inline(always)]\n    66\tfn cstr(bytes: &'static [u8]) -> *const c_char {\n    67\t    bytes.as_ptr() as *const c_char\n    68\t}\n    69\t\n    70\t// ---------------------------------------------------------------------------\n    71\t// Helpers reproducing C's (undefined-behaviour-laden) arithmetic exactly as it\n    72\t// behaves on x86-64 with gcc.\n    73\t// ---------------------------------------------------------------------------\n    74\t\n    75\t/// `(int)double` on x86-64: `cvttsd2si` truncates toward zero and yields the\n    76\t/// \"integer indefinite\" value 0x80000000 when the result is not representable\n    77\t/// (this includes NaN and infinities).  C says this is undefined behaviour; the\n    78\t/// original library relies on it, so we reproduce it bit for bit instead of\n    79\t/// saturating the way Rust's `as` operator would.\n    80\t#[inline]\n    81\tfn d2i(v: c_double) -> c_int {\n    82\t    if v.is_nan() {\n    83\t        return c_int::MIN;\n    84\t    }\n    85\t    let truncated = v.trunc();\n    86\t    if truncated >= -2147483648.0_f64 && truncated <= 2147483647.0_f64 {\n    87\t        truncated as c_int\n    88\t    } else {\n    89\t        c_int::MIN\n    90\t    }\n    91\t}\n    92\t\n    93\t// ---------------------------------------------------------------------------\n    94\t// int classify_mode(const char *mode)\n    95\t// ---------------------------------------------------------------------------\n    96\t\n    97\t#[unsafe(no_mangle)]\n    98\tpub unsafe extern \"C\" fn classify_mode(mode: *const c_char) -> c_int {\n    99\t    unsafe {\n   100\t        if c_strcmp(mode, cstr(S_STANDARD)) == 0 {\n   101\t            0x10\n   102\t        } else if c_strcmp(mode, cstr(S_ENHANCED)) == 0 {\n   103\t            0x20\n   104\t        } else if c_strcmp(mode, cstr(S_TURBO)) == 0 {\n   105\t            0x30\n   106\t        } else if c_strcmp(mode, cstr(S_EXTREME)) == 0 {\n   107\t            0x40\n   108\t        } else {\n   109\t            0x00\n   110\t        }\n   111\t    }\n   112\t}\n   113\t\n   114\t// ---------------------------------------------------------------------------\n   115\t// int apply_multiplier(int base, int level)\n   116\t//\n   117\t// The C switch deliberately falls through from case 4 down to case 0.\n   118\t// ---------------------------------------------------------------------------\n   119\t\n   120\t#[unsafe(no_mangle)]\n   121\tpub extern \"C\" fn apply_multiplier(base: c_int, level: c_int) -> c_int {\n   122\t    let mut result: c_int = base;\n   123\t\n   124\t    match level {\n   125\t        4 => {\n   126\t            result = result.wrapping_add(0xFF);\n   127\t            result = result.wrapping_add(0xAB);\n   128\t            result = result.wrapping_add(0x7E);\n   129\t            result = result.wrapping_add(0x1C);\n   130\t            result = result.wrapping_add(0x05);\n   131\t        }\n   132\t        3 => {\n   133\t            result = result.wrapping_add(0xAB);\n   134\t            result = result.wrapping_add(0x7E);\n   135\t            result = result.wrapping_add(0x1C);\n   136\t            result = result.wrapping_add(0x05);\n   137\t        }\n   138\t        2 => {\n   139\t            result = result.wrapping_add(0x7E);\n   140\t            result = result.wrapping_add(0x1C);\n   141\t            result = result.wrapping_add(0x05);\n   142\t        }\n   143\t        1 => {\n   144\t            result = result.wrapping_add(0x1C);\n   145\t            result = result.wrapping_add(0x05);\n   146\t        }\n   147\t        0 => {\n   148\t            result = result.wrapping_add(0x05);\n   149\t        }\n   150\t        _ => {\n   151\t            result = 0xDEAD;\n   152\t        }\n   153\t    }\n   154\t\n   155\t    result\n   156\t}\n   157\t\n   158\t// ---------------------------------------------------------------------------\n   159\t// int convert_time_factor(double factor)\n   160\t// ---------------------------------------------------------------------------\n   161\t\n   162\t#[unsafe(no_mangle)]\n   163\tpub extern \"C\" fn convert_time_factor(factor: c_double) -> c_int {\n   164\t    let scaled: c_double = factor * 1e12;\n   165\t    let result: c_int = d2i(scaled);\n   166\t\n   167\t    result\n   168\t}\n   169\t\n   170\t// ---------------------------------------------------------------------------\n   171\t// int convert_negative_overflow(double value)\n   172\t// ---------------------------------------------------------------------------\n   173\t\n   174\t#[unsafe(no_mangle)]\n   175\tpub extern \"C\" fn convert_negative_overflow(value: c_double) -> c_int {\n   176\t    let extreme: c_double = value * -1e15;\n   177\t    let result: c_int = d2i(extreme);\n   178\t\n   179\t    result\n   180\t}\n   181\t\n   182\t// ---------------------------------------------------------------------------\n   183\t// time_t get_modified_time(int offset_days, int offset_hours)\n   184\t// ---------------------------------------------------------------------------\n   185\t\n   186\t#[unsafe(no_mangle)]\n   187\tpub unsafe extern \"C\" fn get_modified_time(offset_days: c_int, offset_hours: c_int) -> time_t {\n   188\t    let mut current: time_t = unsafe { c_time(std::ptr::null_mut()) };\n   189\t    // Arithmetic (sign propagating) shift, as for a signed C integer type.\n   190\t    current >>= 29;\n   191\t    // The two products and their sum are evaluated in `int` in C and only then\n   192\t    // widened to `time_t`; signed overflow wraps on the target ABI.\n   193\t    let offset: time_t = offset_days\n   194\t        .wrapping_mul(86400)\n   195\t        .wrapping_add(offset_hours.wrapping_mul(3600)) as time_t;\n   196\t    current.wrapping_add(offset)\n   197\t}\n   198\t\n   199\t// ---------------------------------------------------------------------------\n   200\t// int hash_time_value(time_t t)\n   201\t// ---------------------------------------------------------------------------\n   202\t\n   203\t#[unsafe(no_mangle)]\n   204\tpub extern \"C\" fn hash_time_value(t: time_t) -> c_int {\n   205\t    // `hash` is a signed int in C, but every operation performed on it (xor,\n   206\t    // multiply, and finally masking with 0x7FFFFFFF) is bit-identical to the\n   207\t    // wrapping unsigned computation below.\n   208\t    let mut hash: u32 = 0x5A5A_5A5A;\n   209\t    let bytes: [u8; std::mem::size_of::<time_t>()] = t.to_ne_bytes();\n   210\t\n   211\t    for i in 0..std::mem::size_of::<time_t>() {\n   212\t        hash ^= (bytes[i] as u32) << ((i % 4) * 8);\n   213\t        hash = hash.wrapping_mul(0x1F);\n   214\t    }\n   215\t\n   216\t    (hash & 0x7FFF_FFFF) as c_int\n   217\t}\n   218\t\n   219\t// ---------------------------------------------------------------------------\n   220\t// int modeselect(int mode_selector, int time_offset, int complexity, int seed)\n   221\t// ---------------------------------------------------------------------------\n   222\t\n   223\t#[unsafe(no_mangle)]\n   224\tpub unsafe extern \"C\" fn modeselect(\n   225\t    mode_selector: c_int,\n   226\t    time_offset: c_int,\n   227\t    complexity: c_int,\n   228\t    seed: c_int,\n   229\t) -> c_int {\n   230\t    unsafe {\n   231\t        let mut result: c_int = 0;\n   232\t        let modes: [*const c_char; 4] = [\n   233\t            cstr(S_STANDARD),\n   234\t            cstr(S_ENHANCED),\n   235\t            cstr(S_TURBO),\n   236\t            cstr(S_EXTREME),\n   237\t        ];\n   238\t\n   239\t        // C's `%` truncates toward zero, so a negative `mode_selector` yields a\n   240\t        // negative index and an out-of-bounds read -- reproduced verbatim.\n   241\t        let mode_index: c_int = mode_selector % 4;\n   242\t        let selected_mode: *const c_char =\n   243\t            std::ptr::read_volatile(modes.as_ptr().offset(mode_index as isize));\n   244\t        let mode_value: c_int = classify_mode(selected_mode);\n   245\t\n   246\t        c_printf(\n   247\t            cstr(FMT_SELECTED_MODE),\n   248\t            selected_mode as *const c_void,\n   249\t            mode_value,\n   250\t        );\n   251\t        result = result.wrapping_add(mode_value);\n   252\t\n   253\t        let complexity_level: c_int = complexity % 5;\n   254\t        let multiplier: c_int = apply_multiplier(0xA0, complexity_level);\n   255\t\n   256\t        c_printf(cstr(FMT_COMPLEXITY), complexity_level, multiplier);\n   257\t        result = result.wrapping_add(multiplier);\n   258\t\n   259\t        let modified_time: time_t = get_modified_time(time_offset, seed % 24);\n   260\t        let time_hash: c_int = hash_time_value(modified_time);\n   261\t\n   262\t        c_printf(\n   263\t            cstr(FMT_MODIFIED_TIME),\n   264\t            modified_time as c_long,\n   265\t            time_hash,\n   266\t        );\n   267\t        result = result.wrapping_add(time_hash % 0x1000);\n   268\t\n   269\t        let factor1: c_double = (seed as c_double) * 1e8;\n   270\t        let factor2: c_double = (time_offset as c_double) * -1e7;\n   271\t\n   272\t        c_printf(cstr(FMT_CONVERT_OVERFLOW), factor1);\n   273\t\n   274\t        let result1: c_int = convert_time_factor(factor1);\n   275\t        c_printf(cstr(FMT_RESULT1), result1, result1);\n   276\t\n   277\t        c_printf(cstr(FMT_CONVERT_UNDERFLOW), factor2);\n   278\t        let result2: c_int = convert_negative_overflow(factor2);\n   279\t        c_printf(cstr(FMT_RESULT2), result2, result2);\n   280\t\n   281\t        result ^= result1 & 0xFF;\n   282\t        result ^= result2 & 0xFF00;\n   283\t\n   284\t        result = result.wrapping_mul(0x10).wrapping_add(0xBEEF);\n   285\t\n   286\t        c_printf(cstr(FMT_FINAL), result, result);\n   287\t\n   288\t        result\n   289\t    }\n   290\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
