{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DhZt8MGikknzHJEUvfwhMw","type":"tool_result","content":"515\t}\n516\t\n517\t#[test]\n518\tfn e23_hash_never_negative() {\n519\t    let l = libs();\n520\t    let mut rng = Rng::new(SEED ^ 0xE23);\n521\t    let mut cases: Vec<i64> = vec![-1, i64::MIN, i64::MAX, -2, -0x8000_0000_0000_0000];\n522\t    for _ in 0..2000 {\n523\t        cases.push(-(rng.next_i64().abs().max(1)));\n524\t    }\n525\t    for t in cases {\n526\t        let (c, rs) = unsafe { ((l.c.hash_time_value)(t), (l.rs.hash_time_value)(t)) };\n527\t        eq_int(\"E23\", t, c, rs);\n528\t        assert!(\n529\t            c >= 0 && c <= 0x7FFF_FFFF,\n530\t            \"E23: hash_time_value({t}) = {c} is outside [0, 0x7FFFFFFF]\"\n531\t        );\n532\t    }\n533\t}\n534\t\n535\t// ===========================================================================\n536\t// E24 -- modeselect with a negative array index: both must die with SIGSEGV\n537\t// ===========================================================================\n538\t\n539\t#[test]\n540\tfn e24_modeselect_negative_index_segfaults_identically() {\n541\t    let l = libs();\n542\t    for ms in [-1i32, -2, -3, -5, -6, -7, -9, -1001, i32::MAX.wrapping_neg()] {\n543\t        assert_ne!(ms % 4, 0, \"test bug: {ms} % 4 == 0\");\n544\t        let c = run_isolated(|| unsafe { (l.c.modeselect)(ms, 1, 1, 1) as i64 });\n545\t        let rs = run_isolated(|| unsafe { (l.rs.modeselect)(ms, 1, 1, 1) as i64 });\n546\t        assert!(\n547\t            c.crashed_with(11),\n548\t            \"E24: expected C to die with SIGSEGV for mode_selector={ms}, got {c:?}\"\n549\t        );\n550\t        assert_eq!(\n551\t            c.status, rs.status,\n552\t            \"E24: mode_selector={ms}: C terminated with {} but Rust with {} (C={c:?}, Rust={rs:?})\",\n553\t            c.status, rs.status\n554\t        );\n555\t        eq_bytes(\"E24\", ms, &c.stdout, &rs.stdout);\n556\t    }\n557\t}\n558\t\n559\t// ===========================================================================\n560\t// E25 -- negative mode_selector that is a multiple of 4 is a *valid* input\n561\t// ===========================================================================\n562\t\n563\t#[test]\n564\tfn e25_modeselect_negative_multiple_of_four() {"}]},"parent_tool_use_id":null,"session_id":"5cc07b24-a1a6-4436-bcd1-d9e9880595e3","uuid":"2bf9590f-9c87-428e-bee0-77902428770e","timestamp":"2026-08-28T04:34:46.617Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-lpPs9a/translation/tests/phase_c_errors.rs","content":"}\n\n#[test]\nfn e23_hash_never_negative() {\n    let l = libs();\n    let mut rng = Rng::new(SEED ^ 0xE23);\n    let mut cases: Vec<i64> = vec![-1, i64::MIN, i64::MAX, -2, -0x8000_0000_0000_0000];\n    for _ in 0..2000 {\n        cases.push(-(rng.next_i64().abs().max(1)));\n    }\n    for t in cases {\n        let (c, rs) = unsafe { ((l.c.hash_time_value)(t), (l.rs.hash_time_value)(t)) };\n        eq_int(\"E23\", t, c, rs);\n        assert!(\n            c >= 0 && c <= 0x7FFF_FFFF,\n            \"E23: hash_time_value({t}) = {c} is outside [0, 0x7FFFFFFF]\"\n        );\n    }\n}\n\n// ===========================================================================\n// E24 -- modeselect with a negative array index: both must die with SIGSEGV\n// ===========================================================================\n\n#[test]\nfn e24_modeselect_negative_index_segfaults_identically() {\n    let l = libs();\n    for ms in [-1i32, -2, -3, -5, -6, -7, -9, -1001, i32::MAX.wrapping_neg()] {\n        assert_ne!(ms % 4, 0, \"test bug: {ms} % 4 == 0\");\n        let c = run_isolated(|| unsafe { (l.c.modeselect)(ms, 1, 1, 1) as i64 });\n        let rs = run_isolated(|| unsafe { (l.rs.modeselect)(ms, 1, 1, 1) as i64 });\n        assert!(\n            c.crashed_with(11),\n            \"E24: expected C to die with SIGSEGV for mode_selector={ms}, got {c:?}\"\n        );\n        assert_eq!(\n            c.status, rs.status,\n            \"E24: mode_selector={ms}: C terminated with {} but Rust with {} (C={c:?}, Rust={rs:?})\",\n            c.status, rs.status\n        );\n        eq_bytes(\"E24\", ms, &c.stdout, &rs.stdout);\n    }\n}\n\n// ===========================================================================\n// E25 -- negative mode_selector that is a multiple of 4 is a *valid* input\n// ===========================================================================\n\n#[test]\nfn e25_modeselect_negative_multiple_of_four() {","numLines":50,"startLine":515,"totalLines":823}}}
