4 = 0;\n        loop {\n            let c = *p.offset(i) as u8;\n            if !c.is_ascii_digit() {\n                break;\n            }\n            acc = acc.wrapping_mul(10).wrapping_add((c - b'0') as i64);\n            i += 1;\n        }\n        if neg {\n            acc.wrapping_neg()\n        } else {\n            acc\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn time(tloc: *mut c_long) -> c_long {\n    let v = fake_value();\n    if !tloc.is_null() {\n        unsafe { *tloc = v };\n    }\n    v\n}\n\nfn main() {}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
