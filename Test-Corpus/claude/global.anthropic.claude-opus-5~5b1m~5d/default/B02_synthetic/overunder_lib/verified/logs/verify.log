\t#[unsafe(no_mangle)]\n89\tpub extern \"C\" fn process_with_fallthrough(code: c_int, base_value: c_int) -> c_int {\n90\t    let mut result: c_int = base_value;\n91\t\n92\t    match code {\n93\t        5 => {\n94\t            result = result.wrapping_add(50);\n95\t            result = result.wrapping_add(40);\n96\t            result = result.wrapping_add(30);\n97\t            result = result.wrapping_add(20);\n98\t            result = result.wrapping_add(10);\n99\t        }\n100\t        4 => {\n101\t            result = result.wrapping_add(40);\n102\t            result = result.wrapping_add(30);\n103\t            result = result.wrapping_add(20);\n104\t            result = result.wrapping_add(10);\n105\t        }\n106\t        3 => {\n107\t            result = result.wrapping_add(30);\n108\t            result = result.wrapping_add(20);\n109\t            result = result.wrapping_add(10);\n110\t        }\n111\t        2 => {\n112\t            result = result.wrapping_add(20);\n113\t            result = result.wrapping_add(10);\n114\t        }\n115\t        1 => {\n116\t            result = result.wrapping_add(10);\n117\t        }\n118\t        0 => {\n119\t            result = 0;\n120\t        }\n121\t        _ => {\n122\t            result = -1;\n123\t        }\n124\t    }\n125\t\n126\t    result\n127\t}\n128\t\n129\t// ---------------------------------------------------------------------------\n130\t// void copy_data_block(DataBlock *dest, const DataBlock *src)\n131\t//\n132\t// memcpy(dest, src, sizeof(DataBlock))\n133\t// ---------------------------------------------------------------------------\n134\t#[unsafe(no_mangle)]\n135\tpub unsafe extern \"C\" fn copy_data_block(dest: *mut DataBlock, src: *const DataBlock) {\n136\t    unsafe {\n137\t        core::ptr::copy_nonoverlapping(src.cast::<u8>(), dest.cast::<u8>(), size_of::<DataBlock>());\n138\t    }\n139\t}\n140\t\n141\t// ---------------------------------------------------------------------------\n142\t// int