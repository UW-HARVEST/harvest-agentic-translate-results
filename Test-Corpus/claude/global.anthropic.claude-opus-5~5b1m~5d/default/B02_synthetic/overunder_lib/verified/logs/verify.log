0]; } DataBlock;`\n39\t///\n40\t/// On the LP64 SysV ABI this is 40 bytes: `id` at 0, 4 bytes of padding,\n41\t/// `value` at 8, `label` at 16, then 4 trailing pad bytes for 8-byte alignment.\n42\t#[repr(C)]\n43\t#[derive(Clone, Copy)]\n44\tpub struct DataBlock {\n45\t    pub id: c_int,\n46\t    pub value: c_double,\n47\t    pub label: [c_char; 20],\n48\t}\n49\t\n50\timpl DataBlock {\n51\t    /// Mimics C's declaration of an automatic aggregate: the storage exists but\n52\t    /// holds no meaningful value yet. Zeroing keeps Rust's semantics defined\n53\t    /// without changing any observable behaviour of the translated code.\n54\t    const fn uninit() -> DataBlock {\n55\t        DataBlock {\n56\t            id: 0,\n57\t            value: 0.0,\n58\t            label: [0; 20],\n59\t        }\n60\t    }\n61\t}\n62\t\n63\t// ---------------------------------------------------------------------------\n64\t// int safe_double_to_int(double d)\n65\t// ---------------------------------------------------------------------------\n66\t#[unsafe(no_mangle)]\n67\tpub extern \"C\" fn safe_double_to_int(d: c_double) -> c_int {\n68\t    if d > c_int::MAX as c_double {\n69\t        c_int::MAX\n70\t    } else if d < c_int::MIN as c_double {\n71\t        c_int::MIN\n72\t    } else if d.is_nan() {\n73\t        0\n74\t    } else {\n75\t        // The two range tests above guarantee that the value is in\n76\t        // [INT_MIN, INT_MAX], so truncation toward zero matches C's cast.\n77\t        d as c_int\n78\t    }\n79\t}\n80\t\n81\t// ---------------------------------------------------------------------------\n82\t// int process_with_fallthrough(int code, int base_value)\n83\t//\n84\t// The C switch deliberately falls through from 5 -> 4 -> 3 -> 2 -> 1, so the\n85\t// accumulated additions are performed in exactly that order (wrapping, which\n86\t// is what the C compiler emits for signed overflow).\n87\t// ---------------------------------------------------------------------------\n88\t#[unsafe(no_mangle)]\n89\tpub extern \"C\" fn process_with_fallthrough(code: c_int, base_value: c_int) -> c_int {\n90\t    let mut result: c_int = base_value;\n91\t\n92\t    match code {\n93\t        5 => {\n94\t            result = result.wrapping_add(50);\n95\t            result = result.wrapping_add(40);\n96\t            result = result.wrapping_add(30);\n97\t            result = result.wrapping_add(20);\n98\t            result = result.wrapping_add(10);\n99\t        }\n100\t        4 => {\n101\t            result = result.wrapping_add(40);\n102\t            result = result.wrapping_add(30);\n103\t            result = result.wrapping_add(20);\n104\t            result = result.wrapping_add(10);\n105\t        }\n106\t        3 => {\n107\t            result = result.wrapping_add(30);\n108\t            result = result.wrapping_add(20);\n109\t            result = result.wrapping_add(10);\n110\t        }\n111\t        2 => {\n112\t            result = result.wrapping_add(20);\n113\t            result = result.wrapping_add(10);\n114\t        }\n115\t        1 => {\n116\t            result = result.wrapping_add(10);\n117\t        }\n118\t        0 => {\n119\t            result = 0;\n120\t        }\n121\t        _ => {\n122\t            result = -1;\n123\t        }\n124\t    }\n125\t\n126\t    result\n127\t}\n128\t\n129\t// ---------------------------------------------------------------------------\n130\t// void copy_data_block(DataBlock *dest, const DataBlock *src)\n131\t//\n132\t// memcpy(dest, src, sizeof(DataBlock))\n133\t// ---------------------------------------------------------------------------\n134\t#[unsafe(no_mangle)]\n135\tpub unsafe extern \"C\" fn copy_data_block(dest: *mut DataBlock, src: *const DataBlock) {\n136\t    unsafe {\n137\t        core::ptr::copy_nonoverlapping(src.cast::<u8>(), dest.cast::<u8>(), size_of::<DataBlock>());\n138\t    }\n139\t}\n140\t\n141\t// ---------------------------------------------------------------------------\n142\t// int