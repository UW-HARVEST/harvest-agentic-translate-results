c_int, c: c_int) -> f64 {\n    11\t    let mut result = 0.0_f64;\n    12\t\n    13\t    // Guarding on `b != 0` leaves `result` at 0.0 for a zero divisor rather\n    14\t    // than producing an infinity.\n    15\t    if b != 0 {\n    16\t        result = f64::from(a) / f64::from(b);\n    17\t    }\n    18\t\n    19\t    // `c % 10` truncates toward zero in C, so a negative `c` gives a negative\n    20\t    // exponent. Rust's `%` matches. libm's `pow` is called directly to keep the\n    21\t    // floating point result bit-identical.\n    22\t    let exponent = f64::from(c % 10);\n    23\t    result *= unsafe { ffi::pow(10.0, exponent) };\n    24\t\n    25\t    result\n    26\t}\n    27\t\n    28\t/// C: `double calculate_with_doubles(int a, int b, int c)`\n    29\t#[unsafe(no_mangle)]\n    30\tpub extern \"C\" fn calculate_with_doubles(a: c_int, b: c_int, c: c_int) -> f64 {\n    31\t    calculate(a, b, c)\n    32\t}\n=============== translation/src/doubleneg.rs\n     1\t//! Translation of `doubleneg` from `c_src/src/lib.c`.\n     2\t//!\n     3\t//! This is the library's headline entry point (the only one declared in\n     4\t//! `include/lib.h`). It is a driver that prints a running commentary while\n     5\t//! exercising the other helpers, so the translation reproduces every `printf`\n     6\t//! call, in order, with the identical format string -- output is produced by the\n     7\t//! very same libc `printf` the C code used.\n     8\t\n     9\tuse core::ffi::c_char;\n    10\tuse core::ffi::c_int;\n    11\tuse core::ffi::c_long;\n    12\t\n    13\tuse crate::buffer;\n    14\tuse crate::cvt;\n    15\tuse crate::dmath;\n    16\tuse crate::ffi;\n    17\tuse crate::ffi::cstr;\n    18\t\n    19\t/// C: `int doubleneg(int param1, int param2, int param3, int param4)`\n    20\t#[unsafe(no_mangle)]\n    21\tpub extern \"C\" fn doubleneg(\n    22\t    param1: c_int,\n    23\t    param2: c_int,\n    24\t    param3: c_int,\n    25\t    param4: c_int,\n    26\t) -> c_int {\n    27\t    let mut result: c_int = 0;\n    28\t    // C: `char buffer[256];` -- declared uninitialised, but\n    29\t    // `create_numeric_buffer` below writes all 256 bytes before any read.\n    30\t    let mut buf: [c_char; 256] = [0; 256];\n    31\t\n    32\t    unsafe {\n    33\t        ffi::printf(cstr!(\"=== Starting foo() execution ===\\n\"));\n    34\t        ffi::printf(\n    35\t            cstr!(\"Parameters: %d, %d, %d, %d\\n\"),\n    36\t            param1,\n    37\t            param2,\n    38\t            param3,\n    39\t            param4,\n    40\t        );\n    41\t\n    42\t        ffi::printf(cstr!(\"\\n--- Integer Negation Test ---\\n\"));\n    43\t        let negation_test: c_int = param1;\n    44\t        let negation_result: c_int = c_int::from(negation_test != 0);\n    45\t        ffi::printf(cstr!(\"Original value: %d\\n\"), negation_test);\n    46\t        ffi::printf(cstr!(\"After !!negation: %d\\n\"), negation_result);\n    47\t        result = result.wrapping_add(negation_result.wrapping_mul(10));\n    48\t\n    49\t        let neg_p2: c_int = c_int::from(param2 != 0);\n    50\t        let neg_p3: c_int = c_int::from(param3 != 0);\n    51\t        let neg_p4: c_int = c_int::from(param4 != 0);\n    52\t        ffi::printf(\n    53\t            cstr!(\"Double negation results: %d, %d, %d\\n\"),\n    54\t            neg_p2,\n    55\t            neg_p3,\n    56\t            neg_p4,\n    57\t        );\n    58\t        result = result\n    59\t            .wrapping_add(neg_p2)\n    60\t            .wrapping_add(neg_p3)\n    61\t            .wrapping_add(neg_p4);\n    62\t\n    63\t        ffi::printf(cstr!(\"\\n--- Double to Int Conversion Test ---\\n\"));\n    64\t\n    65\t        let large_double = dmath::calculate(param1, param2, param3);\n    66\t        ffi::printf(cstr!(\"Calculated double value: %e\\n\"), large_double);\n    67\t\n    68\t        let converted_int = cvt::convert(large_double);\n    69\t        ffi::printf(cstr!(\"Converted to int (may be UB): %d\\n\"), converted_int);\n    70\t\n    71\t        let negative_large = -1.0_f64 * ffi::pow(2.0, 40.0);\n    72\t        ffi::printf(cstr!(\"Very large negative double: %e\\n\"), negative_large);\n    73\t        let converted_neg = cvt::convert(negative_large);\n    74\t        ffi::printf(cstr!(\"Converted to int (UB likely): %d\\n\"), converted_neg);\n    75\t\n    76\t        // Both remainders truncate toward zero; `INT_MIN % 1000` is `-648`.\n    77\t        result = result\n    78\t            .wrapping_add(converted_int % 1000)\n    79\t            .wrapping_add(converted_neg % 1000);\n    80\t\n    81\t        ffi::printf(cstr!(\"\\n--- Memchr Search Test ---\\n\"));\n    82\t\n    83\t        buffer::create_numeric_buffer(buf.as_mut_ptr(), 256, param1);\n    84\t\n    85\t        let search_values: [c_int; 4] = [param2 % 256, param3 % 256, param4 % 256, 42];\n    86\t        let num_searches = search_values.len();\n    87\t\n    88\t        ffi::printf(cstr!(\"Searching buffer for values...\\n\"));\n    89\t        for i in 0..num_searches {\n    90\t            let pos = buffer::find_value_in_buffer(buf.as_ptr(), 256, search_values[i]);\n    91\t            if pos >= 0 {\n    92\t                ffi::printf(\n    93\t                    cstr!(\"Found value %d at position %d\\n\"),\n    94\t                    search_values[i],\n    95\t                    pos,\n    96\t                );\n    97\t                result = result.wrapping_add(pos);\n    98\t            } else {\n    99\t                ffi::printf(cstr!(\"Value %d not found\\n\"), search_values[i]);\n   100\t            }\n   101\t        }\n   102\t\n   103\t        // C: `char *direct_search = (char*)memchr(buffer, 100, 256);`\n   104\t        let direct_search = buffer::memchr(buf.as_ptr(), 100, 256);\n   105\t        if let Some(offset) = direct_search {\n   106\t            ffi::printf(\n   107\t                cstr!(\"Direct memchr found byte 100 at offset: %ld\\n\"),\n   108\t                offset as c_long,\n   109\t            );\n   110\t            result = result.wrapping_add(offset as c_int);\n   111\t        }\n   112\t\n   113\t        ffi::printf(cstr!(\"\\n--- Combined Feature Test ---\\n\"));\n   114\t        for i in 0..10_i32 {\n   115\t            let search_byte: c_int = param1.wrapping_add(i.wrapping_mul(param2)) % 256;\n   116\t            let found = buffer::memchr(buf.as_ptr(), search_byte as u8, 256);\n   117\t            // C: `int found_flag = !!found;` -- double negation on a pointer.\n   118\t            let found_flag: c_int = c_int::from(found.is_some());\n   119\t            ffi::printf(\n   120\t                cstr!(\"Search %d: byte=%d, found=%d\\n\"),\n   121\t                i,\n   122\t                search_byte,\n   123\t                found_flag,\n   124\t            );\n   125\t            result = result.wrapping_add(found_flag);\n   126\t        }\n   127\t\n   128\t        let infinity_val = f64::INFINITY;\n   129\t        let nan_val = f64::NAN;\n   130\t\n   131\t        ffi::printf(cstr!(\"\\n--- Special Double Values ---\\n\"));\n   132\t        ffi::printf(cstr!(\"Converting INFINITY to int: \"));\n   133\t        let inf_as_int = cvt::convert(infinity_val);\n   134\t        ffi::printf(cstr!(\"%d (undefined behavior)\\n\"), inf_as_int);\n   135\t\n   136\t        ffi::printf(cstr!(\"Converting NAN to int: \"));\n   137\t        let nan_as_int = cvt::convert(nan_val);\n   138\t        ffi::printf(cstr!(\"%d (undefined behavior)\\n\"), nan_as_int);\n   139\t\n   140\t        ffi::printf(cstr!(\"\\n=== Final Result ===\\n\"));\n   141\t        ffi::printf(cstr!(\"Accumulated result: %d\\n\"), result);\n   142\t    }\n   143\t\n   144\t    result\n   145\t}\n=============== translation/src/ffi.rs\n     1\t//! Direct bindings to the C runtime routines that the original library relies\n     2\t//! on.\n     3\t//!\n     4\t//! `lib.c` links against libc and libm (`target