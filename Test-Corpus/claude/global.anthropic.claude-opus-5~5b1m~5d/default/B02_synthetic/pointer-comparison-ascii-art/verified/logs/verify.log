{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012hovfdwDDfxBKezLsX4dx2","type":"tool_result","content":"1\t//! Emulation of the small subset of C's <stdio.h> / <stdlib.h> behaviour that\n2\t//! the original program relies on:\n3\t//!\n4\t//!   * `fgets()`   - stops at (and keeps) a newline, never reads past it\n5\t//!   * `getchar()` - single byte reads from the very same stream position\n6\t//!   * `scanf(\"%d\")` / `fscanf(\"%d\")` / `sscanf(\"%d\")` - whitespace skipping,\n7\t//!     `long`-width accumulation with saturation, truncation to `int`, and the\n8\t//!     push back of the first non matching character\n9\t//!   * a fully buffered `stdout` (which is what glibc uses when stdout is not a\n10\t//!     terminal), so that the byte stream produced on stdout is identical and\n11\t//!     unflushed data is lost when the process is killed - exactly like the C\n12\t//!     original.\n13\t\n14\tuse std::io::{self, Read, Write};\n15\t\n16\tpub const EOF: i32 = -1;\n17\t\n18\t/// `isspace()` in the \"C\" locale.\n19\tpub fn is_space(c: u8) -> bool {\n20\t    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n21\t}\n22\t\n23\t/// A source of characters that supports pushing one character back, mirroring\n24\t/// the `FILE*` behaviour used by the C scanf family.\n25\tpub trait CharSrc {\n26\t    fn next_char(&mut self) -> i32;\n27\t    fn unget_char(&mut self, c: u8);\n28\t}\n29\t\n30\t/// The program's `stdin` (a `FILE*` in C).  Bytes are pulled from the real\n31\t/// stdin in blocks, so a byte is never consumed before it is needed.\n32\tpub struct CStdin {\n33\t    buf: Vec<u8>,\n34\t    pos: usize,\n35\t    eof: bool,\n36\t    pushback: Option<u8>,\n37\t}\n38\t\n39\timpl CStdin {\n40\t    pub fn new() -> CStdin {\n41\t        CStdin {\n42\t            buf: Vec::new(),\n43\t            pos: 0,\n44\t            eof: false,\n45\t            pushback: None,\n46\t        }\n47\t    }\n48\t\n49\t    /// Make sure at least one byte is available; `false` means end of file.\n50\t    fn fill(&mut self) -> bool {\n51\t        if self.pos < self.buf.len() {\n52\t            return true;\n53\t        }\n54\t        if self.eof {\n55\t            // The EOF indicator of a C stream is sticky until clearerr().\n56\t            return false;\n57\t        }\n58\t        let mut tmp = [0u8; 4096];\n59\t        loop {\n60\t            match io::stdin().read(&mut tmp) {\n61\t                Ok(0) => {\n62\t                    self.eof = true;\n63\t                    return false;\n64\t                }\n65\t                Ok(n) => {\n66\t                    self.buf.clear();\n67\t                    self.buf.extend_from_slice(&tmp[..n]);\n68\t                    self.pos = 0;\n69\t                    return true;\n70\t                }\n71\t                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n72\t                Err(_) => {\n73\t                    self.eof = true;\n74\t                    return false;\n75\t                }\n76\t            }\n77\t        }\n78\t    }\n79\t\n80\t    /// `getchar()`\n81\t    pub fn getchar(&mut self) -> i32 {\n82\t        if let Some(c) = self.pushback.take() {\n83\t            return c as i32;\n84\t        }\n85\t        if !self.fill() {\n86\t            return EOF;\n87\t        }\n88\t        let c = self.buf[self.pos];\n89\t        self.pos += 1;\n90\t        c as i32\n91\t    }\n92\t\n93\t    /// `fgets(buf, size, stdin)`.  Returns the bytes that were stored (the\n94\t    /// terminating NUL is not part of the returned data) or `None` when NULL\n95\t    /// would have been returned.\n96\t    pub fn fgets(&mut self, size: usize) -> Option<Vec<u8>> {\n97\t        if size == 0 {\n98\t            return None;\n99\t        }\n100\t        let max = size - 1;\n101\t        let mut out: Vec<u8> = Vec::new();\n102\t        while out.len() < max {\n103\t            let c = self.getchar();\n104\t            if c == EOF {\n105\t                break;\n106\t            }\n107\t            out.push(c as u8);\n108\t            if c == b'\\n' as i32 {\n109\t                break;\n110\t            }\n111\t        }\n112\t        if out.is_empty() {\n113\t            None\n114\t        } else {\n115\t            Some(out)\n116\t        }\n117\t    }\n118\t\n119\t    /// `scanf(\"%d\", &x)`: `Some(v)` when the conversion succeeded (return value\n120\t    /// 1), `None` for a matching failure or EOF (return value 0 or -1).\n121\t    pub fn scanf_int(&mut self) -> Option<i32> {\n122\t        scan_int(self)\n123\t    }\n124\t\n125\t    /// `while (getchar() != '\\n');`\n126\t    ///\n127\t    /// At end of file glibc's `getchar()` keeps returning EOF, so the original\n128\t    /// C program loops forever here.  That behaviour is reproduced (without\n129\t    /// burning a CPU core): no further output is produced and the pending\n130\t    /// stdout buffer is never flushed.\n131\t    pub fn discard_line(&mut self) {\n132\t        loop {\n133\t            let c = self.getchar();\n134\t            if c == b'\\n' as i32 {\n135\t                return;\n136\t            }\n137\t            if c == EOF {\n138\t                loop {\n139\t                    std::thread::sleep(std::time::Duration::from_secs(3600));\n140\t                }\n141\t            }\n142\t        }\n143\t    }\n144\t}\n145\t\n146\timpl CharSrc for CStdin {\n147\t    fn next_char(&mut self) -> i32 {\n148\t        self.getchar()\n149\t    }\n150\t    fn unget_char(&mut self, c: u8) {\n151\t        self.pushback = Some(c);\n152\t    }\n153\t}\n154\t\n155\t/// A `FILE*` opened on an in memory byte buffer (used for the scene files) and\n156\t/// also the backing store for `sscanf()`.\n157\tpub struct ByteSrc<'a> {\n158\t    data: &'a [u8],\n159\t    pos: usize,\n160\t}\n161\t\n162\timpl<'a> ByteSrc<'a> {\n163\t    pub fn new(data: &'a [u8]) -> ByteSrc<'a> {\n164\t        ByteSrc { data, pos: 0 }\n165\t    }\n166\t\n167\t    /// `fgets(buf, size, file)`\n168\t    pub fn fgets(&mut self, size: usize) -> Option<Vec<u8>> {\n169\t        if size == 0 {\n170\t            return None;\n171\t        }\n172\t        let max = size - 1;\n173\t        let mut out: Vec<u8> = Vec::new();\n174\t        while out.len() < max && self.pos < self.data.len() {\n175\t            let c = self.data[self.pos];\n176\t            self.pos += 1;\n177\t            out.push(c);\n178\t            if c == b'\\n' {\n179\t                break;\n180\t            }\n181\t        }\n182\t        if out.is_empty() {\n183\t            None\n184\t        } else {\n185\t            Some(out)\n186\t        }\n187\t    }\n188\t\n189\t    /// `fscanf(file, \"%d\\n\", &x)` - the trailing whitespace directive consumes\n190\t    /// any run of whitespace that follows the converted number.\n191\t    pub fn fscanf_int_nl(&mut self) -> Option<i32> {\n192\t        let v = scan_int(self);\n193\t        // Whitespace directive: skip whitespace, push back the first non-space.\n194\t        loop {\n195\t            let c = self.next_char();\n196\t            if c == EOF {\n197\t                break;\n198\t            }\n199\t            if !is_space(c as u8) {\n200\t                self.unget_char(c as u8);\n201\t                break;\n202\t            }\n203\t        }\n204\t        v\n205\t    }\n206\t}\n207\t\n208\timpl<'a> CharSrc for ByteSrc<'a> {\n209\t    fn next_char(&mut self) -> i32 {\n210\t        if self.pos < self.data.len() {\n211\t            let c = self.data[self.pos];\n212\t            self.pos += 1;\n213\t            c as i32\n214\t        } else {\n215\t            self.pos = self.data.len() + 1; // remember that EOF was hit\n216\t            EOF\n217\t        }\n218\t    }\n219\t    fn unget_char(&mut self, _c: u8) {\n220\t        if self.pos > 0 && self.pos <= self.data.len() {\n221\t            self.pos -= 1;\n222\t        }\n223\t    }\n224\t}\n225\t\n226\t/// `sscanf(s, \"%d\", &x)`\n227\tpub fn sscanf_int(s: &[u8]) -> Option<i32> {\n228\t    let mut src = ByteSrc::new(s);\n229\t    scan_int(&mut src)\n230\t}\n231\t\n232\t/// The `%d` conversion of the C scanf family: an optionally signed decimal\n233\t/// number accumulated with `long` width (saturating on overflow, like strtol)\n234\t/// and finally truncated to `int`.\n235\tfn scan_int<S: CharSrc + ?Sized>(src: &mut S) -> Option<i32> {\n236\t    let mut c = src.next_char();\n237\t    while c != EOF && is_space(c as u8) {\n238\t        c = src.next_char();\n239\t    }\n240\t    if c == EOF {\n241\t        return None; // input failure -> scanf returns EOF\n242\t    }\n243\t\n244\t    let mut neg = false;\n245\t    if c == b'+' as i32 || c == b'-' as i32 {\n246\t        neg = c == b'-' as i32;\n247\t        c = src.next_char();\n248\t    }\n249\t\n250\t    let mut digits = 0usize;\n251\t    let mut acc: i128 = 0;\n252\t    let mut over = false;\n253\t    while c != EOF && (c as u8).is_ascii_digit() {\n254\t        digits += 1;\n255\t        if !over {\n256\t            acc = acc * 10 + ((c as u8) - b'0') as i128;\n257\t            if acc > (i64::MAX as i128) + 1 {\n258\t                over = true;\n259\t            }\n260\t        }\n261\t        c = src.next_char();\n262\t    }\n263\t\n264\t    // The character that stopped the conversion is pushed back onto the stream.\n265\t    if c != EOF {\n266\t        src.unget_char(c as u8);\n267\t    }\n268\t\n269\t    if digits == 0 {\n270\t        return None; // matching failure -> scanf returns 0\n271\t    }\n272\t\n273\t    let v: i64 = if over {\n274\t        if neg {\n275\t            i64::MIN\n276\t        } else {\n277\t            i64::MAX\n278\t        }\n279\t    } else {\n280\t        let signed: i128 = if neg { -acc } else { acc };\n281\t        if signed > i64::MAX as i128 {\n282\t            i64::MAX\n283\t        } else if signed < i64::MIN as i128 {\n284\t            i64::MIN\n285\t        } else {\n286\t            signed as i64\n287\t        }\n288\t    };\n289\t    Some(v as i32)\n290\t}\n291\t\n292\t/// The fully buffered `stdout` of the C program.\n293\t///\n294\t/// glibc gives a non-tty stdout a buffer of one block (4096 bytes) and flushes\n295\t/// it only when it is completely full, splitting a write across the boundary if\n296\t/// necessary.  Reproducing that exactly means the bytes that reach fd 1 at any\n297\t/// point in time - and therefore also the output that survives when the process\n298\t/// is killed before its buffer is flushed - are the same as in C.\n299\tpub struct COut {\n300\t    buf: Vec<u8>,\n301\t    cap: usize,\n302\t}\n303\t\n304\timpl COut {\n305\t    pub fn new() -> COut {\n306\t        COut {\n307\t            buf: Vec::with_capacity(4096),\n308\t            cap: 4096,\n309\t        }\n310\t    }\n311\t\n312\t    /// `printf`-style raw byte output (errors are ignored, just like the C code\n313\t    /// ignores printf's return value).\n314\t    pub fn put(&mut self, bytes: &[u8]) {\n315\t        let mut rest = bytes;\n316\t        while !rest.is_empty() {\n317\t            let space = self.cap - self.buf.len();\n318\t            let n = if space < rest.len() { space } else { rest.len() };\n319\t            self.buf.extend_from_slice(&rest[..n]);\n320\t            rest = &rest[n..];\n321\t            if self.buf.len() >= self.cap {\n322\t                self.flush();\n323\t            }\n324\t        }\n325\t    }\n326\t\n327\t    pub fn puts(&mut self, s: &str) {\n328\t        self.put(s.as_bytes());\n329\t    }\n330\t\n331\t    pub fn flush(&mut self) {\n332\t        if !self.buf.is_empty() {\n333\t            write_fd1(&self.buf);\n334\t            self.buf.clear();\n335\t        }\n336\t    }\n337\t}\n338\t\n339\t/// Write straight to file descriptor 1, bypassing Rust's own (line buffered)\n340\t/// stdout so that the buffering behaviour above is the only one in effect.\n341\t#[cfg(unix)]\n342\tfn write_fd1(data: &[u8]) {\n343\t    use std::os::unix::io::FromRawFd;\n344\t    let file = unsafe { std::fs::File::from_raw_fd(1) };\n345\t    let mut file = std::mem::ManuallyDrop::new(file); // must not close fd 1\n346\t    let _ = file.write_all(data);\n347\t}\n348\t\n349\t#[cfg(not(unix))]\n350\tfn write_fd1(data: &[u8]) {\n351\t    let out = io::stdout();\n352\t    let mut lock = out.lock();\n353\t    let _ = lock.write_all(data);\n354\t    let _ = lock.flush();\n355\t}\n356\t\n357\t/// `fprintf(stderr, ...)` - stderr is unbuffered in C.\n358\tpub fn err(s: &[u8]) {\n359\t    let mut e = io::stderr();\n360\t    let _ = e.write_all(s);\n361\t    let _ = e.flush();\n362\t}\n363\t\n364\t/// Truncate at the first NUL byte: the bytes that `%s` / `strlen` would see.\n365\tpub fn c_str(bytes: &[u8]) -> &[u8] {\n366\t    match bytes.iter().position(|&b| b == 0) {\n367\t        Some(i) => &bytes[..i],\n368\t        None => bytes,\n369\t    }\n370\t}\n371\t\n372\t/// `buf[strcspn(buf, \"\\n\")] = 0;` applied to a freshly `fgets`ed buffer.\n373\tpub fn strip_newline(bytes: &[u8]) -> Vec<u8> {\n374\t    let s = c_str(bytes);\n375\t    match s.iter().position(|&b| b == b'\\n') {\n376\t        Some(i) => s[..i].to_vec(),\n377\t        None => s.to_vec(),\n378\t    }\n379\t}\n380\t"}]},"parent_tool_use_id":null,"session_id":"c2908699-fad4-41d5-8683-e58fb1172ba9","uuid":"ff5f7a21-9457-4f18-99ee-6c0b182ba728","timestamp":"2026-08-28T05:28:17.367Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-CESiqj/translation/src/cio.rs","content":"//! Emulation of the small subset of C's <stdio.h> / <stdlib.h> behaviour that\n//! the original program relies on:\n//!\n//!   * `fgets()`   - stops at (and keeps) a newline, never reads past it\n//!   * `getchar()` - single byte reads from the very same stream position\n//!   * `scanf(\"%d\")` / `fscanf(\"%d\")` / `sscanf(\"%d\")` - whitespace skipping,\n//!     `long`-width accumulation with saturation, truncation to `int`, and the\n//!     push back of the first non matching character\n//!   * a fully buffered `stdout` (which is what glibc uses when stdout is not a\n//!     terminal), so that the byte stream produced on stdout is identical and\n//!     unflushed data is lost when the process is killed - exactly like the C\n//!     original.\n\nuse std::io::{self, Read, Write};\n\npub const EOF: i32 = -1;\n\n/// `isspace()` in the \"C\" locale.\npub fn is_space(c: u8) -> bool {\n    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n}\n\n/// A source of characters that supports pushing one character back, mirroring\n/// the `FILE*` behaviour used by the C scanf family.\npub trait CharSrc {\n    fn next_char(&mut self) -> i32;\n    fn unget_char(&mut self, c: u8);\n}\n\n/// The program's `stdin` (a `FILE*` in C).  Bytes are pulled from the real\n/// stdin in blocks, so a byte is never consumed before it is needed.\npub struct CStdin {\n    buf: Vec<u8>,\n    pos: usize,\n    eof: bool,\n    pushback: Option<u8>,\n}\n\nimpl CStdin {\n    pub fn new() -> CStdin {\n        CStdin {\n            buf: Vec::new(),\n            pos: 0,\n            eof: false,\n            pushback: None,\n        }\n    }\n\n    /// Make sure at least one byte is available; `false` means end of file.\n    fn fill(&mut self) -> bool {\n        if self.pos < self.buf.len() {\n            return true;\n        }\n        if self.eof {\n            // The EOF indicator of a C stream is sticky until clearerr().\n            return false;\n        }\n        let mut tmp = [0u8; 4096];\n        loop {\n            match io::stdin().read(&mut tmp) {\n                Ok(0) => {\n                    self.eof = true;\n                    return false;\n                }\n                Ok(n) => {\n                    self.buf.clear();\n                    self.buf.extend_from_slice(&tmp[..n]);\n                    self.pos = 0;\n                    return true;\n                }\n                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n                Err(_) => {\n                    self.eof = true;\n                    return false;\n                }\n            }\n        }\n    }\n\n    /// `getchar()`\n    pub fn getchar(&mut self) -> i32 {\n        if let Some(c) = self.pushback.take() {\n            return c as i32;\n        }\n        if !self.fill() {\n            return EOF;\n        }\n        let c = self.buf[self.pos];\n        self.pos += 1;\n        c as i32\n    }\n\n    /// `fgets(buf, size, stdin)`.  Returns the bytes that were stored (the\n    /// terminating NUL is not part of the returned data) or `None` when NULL\n    /// would have been returned.\n    pub fn fgets(&mut self, size: usize) -> Option<Vec<u8>> {\n        if size == 0 {\n            return None;\n        }\n        let max = size - 1;\n        let mut out: Vec<u8> = Vec::new();\n        while out.len() < max {\n            let c = self.getchar();\n            if c == EOF {\n                break;\n            }\n            out.push(c as u8);\n            if c == b'\\n' as i32 {\n                break;\n            }\n        }\n        if out.is_empty() {\n            None\n        } else {\n            Some(out)\n        }\n    }\n\n    /// `scanf(\"%d\", &x)`: `Some(v)` when the conversion succeeded (return value\n    /// 1), `None` for a matching failure or EOF (return value 0 or -1).\n    pub fn scanf_int(&mut self) -> Option<i32> {\n        scan_int(self)\n    }\n\n    /// `while (getchar() != '\\n');`\n    ///\n    /// At end of file glibc's `getchar()` keeps returning EOF, so the original\n    /// C program loops forever here.  That behaviour is reproduced (without\n    /// burning a CPU core): no further output is produced and the pending\n    /// stdout buffer is never flushed.\n    pub fn discard_line(&mut self) {\n        loop {\n            let c = self.getchar();\n            if c == b'\\n' as i32 {\n                return;\n            }\n            if c == EOF {\n                loop {\n                    std::thread::sleep(std::time::Duration::from_secs(3600));\n                }\n            }\n        }\n    }\n}\n\nimpl CharSrc for CStdin {\n    fn next_char(&mut self) -> i32 {\n        self.getchar()\n    }\n    fn unget_char(&mut self, c: u8) {\n        self.pushback = Some(c);\n    }\n}\n\n/// A `FILE*` opened on an in memory byte buffer (used for the scene files) and\n/// also the backing store for `sscanf()`.\npub struct ByteSrc<'a> {\n    data: &'a [u8],\n    pos: usize,\n}\n\nimpl<'a> ByteSrc<'a> {\n    pub fn new(data: &'a [u8]) -> ByteSrc<'a> {\n        ByteSrc { data, pos: 0 }\n    }\n\n    /// `fgets(buf, size, file)`\n    pub fn fgets(&mut self, size: usize) -> Option<Vec<u8>> {\n        if size == 0 {\n            return None;\n        }\n        let max = size - 1;\n        let mut out: Vec<u8> = Vec::new();\n        while out.len() < max && self.pos < self.data.len() {\n            let c = self.data[self.pos];\n            self.pos += 1;\n            out.push(c);\n            if c == b'\\n' {\n                break;\n            }\n        }\n        if out.is_empty() {\n            None\n        } else {\n            Some(out)\n        }\n    }\n\n    /// `fscanf(file, \"%d\\n\", &x)` - the trailing whitespace directive consumes\n    /// any run of whitespace that follows the converted number.\n    pub fn fscanf_int_nl(&mut self) -> Option<i32> {\n        let v = scan_int(self);\n        // Whitespace directive: skip whitespace, push back the first non-space.\n        loop {\n            let c = self.next_char();\n            if c == EOF {\n                break;\n            }\n            if !is_space(c as u8) {\n                self.unget_char(c as u8);\n                break;\n            }\n        }\n        v\n    }\n}\n\nimpl<'a> CharSrc for ByteSrc<'a> {\n    fn next_char(&mut self) -> i32 {\n        if self.pos < self.data.len() {\n            let c = self.data[self.pos];\n            self.pos += 1;\n            c as i32\n        } else {\n            self.pos = self.data.len() + 1; // remember that EOF was hit\n            EOF\n        }\n    }\n    fn unget_char(&mut self, _c: u8) {\n        if self.pos > 0 && self.pos <= self.data.len() {\n            self.pos -= 1;\n        }\n    }\n}\n\n/// `sscanf(s, \"%d\", &x)`\npub fn sscanf_int(s: &[u8]) -> Option<i32> {\n    let mut src = ByteSrc::new(s);\n    scan_int(&mut src)\n}\n\n/// The `%d` conversion of the C scanf family: an optionally signed decimal\n/// number accumulated with `long` width (saturating on overflow, like strtol)\n/// and finally truncated to `int`.\nfn scan_int<S: CharSrc + ?Sized>(src: &mut S) -> Option<i32> {\n    let mut c = src.next_char();\n    while c != EOF && is_space(c as u8) {\n        c = src.next_char();\n    }\n    if c == EOF {\n        return None; // input failure -> scanf returns EOF\n    }\n\n    let mut neg = false;\n    if c == b'+' as i32 || c == b'-' as i32 {\n        neg = c == b'-' as i32;\n        c = src.next_char();\n    }\n\n    let mut digits = 0usize;\n    let mut acc: i128 = 0;\n    let mut over = false;\n    while c != EOF && (c as u8).is_ascii_digit() {\n        digits += 1;\n        if !over {\n            acc = acc * 10 + ((c as u8) - b'0') as i128;\n            if acc > (i64::MAX as i128) + 1 {\n                over = true;\n            }\n        }\n        c = src.next_char();\n    }\n\n    // The character that stopped the conversion is pushed back onto the stream.\n    if c != EOF {\n        src.unget_char(c as u8);\n    }\n\n    if digits == 0 {\n        return None; // matching failure -> scanf returns 0\n    }\n\n    let v: i64 = if over {\n        if neg {\n            i64::MIN\n        } else {\n            i64::MAX\n        }\n    } else {\n        let signed: i128 = if neg { -acc } else { acc };\n        if signed > i64::MAX as i128 {\n            i64::MAX\n        } else if signed < i64::MIN as i128 {\n            i64::MIN\n        } else {\n            signed as i64\n        }\n    };\n    Some(v as i32)\n}\n\n/// The fully buffered `stdout` of the C program.\n///\n/// glibc gives a non-tty stdout a buffer of one block (4096 bytes) and flushes\n/// it only when it is completely full, splitting a write across the boundary if\n/// necessary.  Reproducing that exactly means the bytes that reach fd 1 at any\n/// point in time - and therefore also the output that survives when the process\n/// is killed before its buffer is flushed - are the same as in C.\npub struct COut {\n    buf: Vec<u8>,\n    cap: usize,\n}\n\nimpl COut {\n    pub fn new() -> COut {\n        COut {\n            buf: Vec::with_capacity(4096),\n            cap: 4096,\n        }\n    }\n\n    /// `printf`-style raw byte output (errors are ignored, just like the C code\n    /// ignores printf's return value).\n    pub fn put(&mut self, bytes: &[u8]) {\n        let mut rest = bytes;\n        while !rest.is_empty() {\n            let space = self.cap - self.buf.len();\n            let n = if space < rest.len() { space } else { rest.len() };\n            self.buf.extend_from_slice(&rest[..n]);\n            rest = &rest[n..];\n            if self.buf.len() >= self.cap {\n                self.flush();\n            }\n        }\n    }\n\n    pub fn puts(&mut self, s: &str) {\n        self.put(s.as_bytes());\n    }\n\n    pub fn flush(&mut self) {\n        if !self.buf.is_empty() {\n            write_fd1(&self.buf);\n            self.buf.clear();\n        }\n    }\n}\n\n/// Write straight to file descriptor 1, bypassing Rust's own (line buffered)\n/// stdout so that the buffering behaviour above is the only one in effect.\n#[cfg(unix)]\nfn write_fd1(data: &[u8]) {\n    use std::os::unix::io::FromRawFd;\n    let file = unsafe { std::fs::File::from_raw_fd(1) };\n    let mut file = std::mem::ManuallyDrop::new(file); // must not close fd 1\n    let _ = file.write_all(data);\n}\n\n#[cfg(not(unix))]\nfn write_fd1(data: &[u8]) {\n    let out = io::stdout();\n    let mut lock = out.lock();\n    let _ = lock.write_all(data);\n    let _ = lock.flush();\n}\n\n/// `fprintf(stderr, ...)` - stderr is unbuffered in C.\npub fn err(s: &[u8]) {\n    let mut e = io::stderr();\n    let _ = e.write_all(s);\n    let _ = e.flush();\n}\n\n/// Truncate at the first NUL byte: the bytes that `%s` / `strlen` would see.\npub fn c_str(bytes: &[u8]) -> &[u8] {\n    match bytes.iter().position(|&b| b == 0) {\n        Some(i) => &bytes[..i],\n        None => bytes,\n    }\n}\n\n/// `buf[strcspn(buf, \"\\n\")] = 0;` applied to a freshly `fgets`ed buffer.\npub fn strip_newline(bytes: &[u8]) -> Vec<u8> {\n    let s = c_str(bytes);\n    match s.iter().position(|&b| b == b'\\n') {\n        Some(i) => s[..i].to_vec(),\n        None => s.to_vec(),\n    }\n}\n","numLines":380,"startLine":1,"totalLines":380}}}
