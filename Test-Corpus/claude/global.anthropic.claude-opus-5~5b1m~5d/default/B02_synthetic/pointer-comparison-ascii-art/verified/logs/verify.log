from main, so there is nothing\n216\t/// observable to reproduce here.\n217\tpub fn shape_manager_cleanup() {}\n218\t\n219\t/// Get a shape by type (returns the singleton instance)\n220\tpub fn shape_get(stype: i32) -> Option<&'static Shape> {\n221\t    if stype < 0 || stype >= SHAPE_COUNT {\n222\t        return None;\n223\t    }\n224\t    SHAPES.get().map(|v| v[stype as usize])\n225\t}\n226\t\n227\t/// The address that C would print with `%p` for this shape.\n228\tpub fn shape_ptr(shape: &Shape) -> String {\n229\t    format!(\"{:p}\", shape as *const Shape)\n230\t}\n231\t\n232\t/// Print a shape to stdout\n233\tpub fn shape_print(out: &mut COut, shape: Option<&Shape>) {\n234\t    let shape = match shape {\n235\t        None => {\n236\t            out.puts(\"(null shape)\\n\");\n237\t            return;\n238\t        }\n239\t        Some(s) => s,\n240\t    };\n241\t\n242\t    out.put(&shape.name);\n243\t    out.puts(\":\\n\");\n244\t    for i in 0..shape.height {\n245\t        out.put(&shape.art[i as usize]);\n246\t        out.puts(\"\\n\");\n247\t    }\n248\t}\n249\t\n250\t/// Compare two shapes (equal if the pointers are identical)\n251\tpub fn shape_equals(s1: Option<&Shape>, s2: Option<&Shape>) -> i32 {\n252\t    if shape_same(s1, s2) {\n253\t        1\n254\t    } else {\n255\t        0\n256\t    }\n257\t}\n258\t\n259\t/// `s1 == s2` on the raw pointers.\n260\tpub fn shape_same(s1: Option<&Shape>, s2: Option<&Shape>) -> bool {\n261\t    match (s1, s2) {\n262\t        (Some(a), Some(b)) => std::ptr::eq(a as *const Shape, b as *const Shape),\n263\t        (None, None) => true,\n264\t        _ => false,\n265\t    }\n266\t}\n267\t\n268\t/// Get shape type name\n269\tpub fn shape_type_name(stype: i32) -> &'static str {\n270\t    match stype {\n271\t        SHAPE_TREE => \"Tree\",\n272\t        SHAPE_TRACTOR => \"Tractor\",\n273\t        SHAPE_HOUSE => \"House\",\n274\t        SHAPE_SUN => \"Sun\",\n275\t        SHAPE_CLOUD => \"Cloud\",\n276\t        SHAPE_FLOWER => 