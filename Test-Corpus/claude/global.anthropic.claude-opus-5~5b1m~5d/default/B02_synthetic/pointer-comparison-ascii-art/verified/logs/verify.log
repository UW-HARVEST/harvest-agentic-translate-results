{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ep543r4igpkfnu547ra53fvn4bbm5vkwzye6ihiwo3frg3kd7soa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_018Nx2JqGDZiUCAFUFqXB9Nz","name":"Edit","input":{"replace_all":false,"file_path":"/local/home/scheschb/.harvest/work/harvest-work-CESiqj/translation/tests/differential.rs","old_string":"        // 99999999999 truncates to 1215752191, so the load runs out of numbers.\n        case(\"count_overflows_int\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", \"S\\n99999999999\\n1\\n\"),","new_string":"        // 99999999999 truncates to 1215752191, so the load runs out of numbers.\n        case(\"count_overflows_int\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", \"S\\n99999999999\\n1\\n\"),\n        // fscanf(\"%d\") truncates to int: 4294967298 -> 2, so this file loads.\n        case(\"count_truncates_to_two\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\")\n            .file(\"f.txt\", \"S\\n4294967298\\n1\\n2\\n\"),\n        // 4294967295 -> -1: the loop body never runs, the scene loads empty.\n        case(\"count_truncates_to_minus_one\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\")\n            .file(\"f.txt\", \"S\\n4294967295\\n1\\n2\\n\"),\n        // 4294967296 -> 0 == SHAPE_TREE, so a Tree really is added.\n        case(\"shape_type_truncates_to_zero\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\")\n            .file(\"f.txt\", \"S\\n1\\n4294967296\\n\"),"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2121,"cache_read_input_tokens":157685,"cache_creation":{"ephemeral_5m_input_tokens":2121,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c2908699-fad4-41d5-8683-e58fb1172ba9","uuid":"57efbc04-4170-467b-bcea-2082e03cd50a","timestamp":"2026-08-28T05:53:21.328Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018Nx2JqGDZiUCAFUFqXB9Nz","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-work-CESiqj/translation/tests/differential.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"c2908699-fad4-41d5-8683-e58fb1172ba9","uuid":"868952b3-bbb8-458a-a597-fbc907d4e370","timestamp":"2026-08-28T05:53:21.343Z","tool_use_result":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-CESiqj/translation/tests/differential.rs","oldString":"        // 99999999999 truncates to 1215752191, so the load runs out of numbers.\n        case(\"count_overflows_int\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", \"S\\n99999999999\\n1\\n\"),","newString":"        // 99999999999 truncates to 1215752191, so the load runs out of numbers.\n        case(\"count_overflows_int\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", \"S\\n99999999999\\n1\\n\"),\n        // fscanf(\"%d\") truncates to int: 4294967298 -> 2, so this file loads.\n        case(\"count_truncates_to_two\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\")\n            .file(\"f.txt\", \"S\\n4294967298\\n1\\n2\\n\"),\n        // 4294967295 -> -1: the loop body never runs, the scene loads empty.\n        case(\"count_truncates_to_minus_one\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\")\n            .file(\"f.txt\", \"S\\n4294967295\\n1\\n2\\n\"),\n        // 4294967296 -> 0 == SHAPE_TREE, so a Tree really is added.\n        case(\"shape_type_truncates_to_zero\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\")\n            .file(\"f.txt\", \"S\\n1\\n4294967296\\n\"),","originalFile":"//! Differential tests: the C program in `../c_src` is the ground truth and the\n//! Rust binary produced by this crate must behave identically.\n//!\n//! Both are executed as subprocesses; stdout, stderr, the exit status and the\n//! files left in the working directory are compared for every input.\n\nmod harness;\n\nuse harness::{case, check_all, Case};\n\nfn rep(s: &str, n: usize) -> String {\n    s.repeat(n)\n}\n\nfn cat(parts: &[&[u8]]) -> Vec<u8> {\n    let mut v = Vec::new();\n    for p in parts {\n        v.extend_from_slice(p);\n    }\n    v\n}\n\n// --- input builders -------------------------------------------------------\n//\n// The menu handlers consume a different number of lines each (`fgets` for\n// names and filenames, `scanf` + a getchar drain for numbers), so building the\n// byte stream with these helpers keeps a multi-step session correct by\n// construction.\n\n/// 1. View all available shapes\nconst SHAPES: &str = \"1\\n\";\n/// 2. Create new scene\nfn create(name: &str) -> String {\n    format!(\"2\\n{name}\\n\")\n}\n/// 3. Add shape to scene\nfn add(scene: i32, shape: i32) -> String {\n    format!(\"3\\n{scene}\\n{shape}\\n\")\n}\n/// 4. Remove shape from scene (1-based shape number)\nfn remove(scene: i32, shape_no: i32) -> String {\n    format!(\"4\\n{scene}\\n{shape_no}\\n\")\n}\n/// 5. View scene\nfn view(scene: i32) -> String {\n    format!(\"5\\n{scene}\\n\")\n}\n/// 6. List all scenes\nconst LIST: &str = \"6\\n\";\n/// 7. Save scene\nfn save(scene: i32, file: &str) -> String {\n    format!(\"7\\n{scene}\\n{file}\\n\")\n}\n/// 8. Load scene\nfn load(file: &str) -> String {\n    format!(\"8\\n{file}\\n\")\n}\n/// 9. Compare two shapes\nfn cmp_shapes(a: i32, b: i32) -> String {\n    format!(\"9\\n{a}\\n{b}\\n\")\n}\n/// 10. Compare two scenes\nfn cmp_scenes(a: i32, b: i32) -> String {\n    format!(\"10\\n{a}\\n{b}\\n\")\n}\n/// 11. Delete scene\nfn del(scene: i32) -> String {\n    format!(\"11\\n{scene}\\n\")\n}\n/// 12. Exit\nconst EXIT: &str = \"12\\n\";\n\n/// A scene file as `scene_save` writes it: name line, count line, shape types.\nfn scene_file(name: &str, types: &[i32]) -> Vec<u8> {\n    let mut s = format!(\"{name}\\n{}\\n\", types.len());\n    for t in types {\n        s.push_str(&format!(\"{t}\\n\"));\n    }\n    s.into_bytes()\n}\n\nfn join(parts: &[String]) -> String {\n    parts.concat()\n}\n\n// ---------------------------------------------------------------------------\n// main(): the menu loop.  fgets(input, 256, stdin) + sscanf(input, \"%d\")\n// ---------------------------------------------------------------------------\n\n#[test]\nfn menu_loop_and_choice_parsing() {\n    let cases: Vec<Case> = vec![\n        // fgets returns NULL straight away -> the loop breaks, exit 0.\n        case(\"empty_stdin\", \"\"),\n        // A blank line is a matching failure for sscanf -> \"Invalid input\".\n        case(\"blank_line_then_eof\", \"\\n\"),\n        case(\"non_numeric\", \"x\\n12\\n\"),\n        case(\"only_sign\", \"-\\n12\\n\"),\n        case(\"choice_zero\", \"0\\n12\\n\"),\n        case(\"choice_13\", \"13\\n12\\n\"),\n        case(\"choice_negative\", \"-1\\n12\\n\"),\n        case(\"choice_int_min\", \"-2147483648\\n12\\n\"),\n        case(\"exit_immediately\", \"12\\n\"),\n        case(\"exit_without_trailing_newline\", \"12\"),\n        case(\"digits_then_text\", \"12abc\\n\"),\n        case(\"surrounding_spaces\", \"  12  \\n\"),\n        case(\"tab_prefix\", \"\\t12\\n\"),\n        case(\"crlf_line_ending\", \"12\\r\\n\"),\n        // sscanf stops at the NUL, so nothing is converted.\n        case(\"nul_before_digits\", cat(&[b\"\\x0012\\n\", b\"12\\n\"])),\n        case(\"plus_sign\", \"+6\\n12\\n\"),\n        // \"0x3\" converts as 0 -> \"Invalid choice\".\n        case(\"hex_looking\", \"0x3\\n12\\n\"),\n        // %d overflows: glibc clamps to LONG_MAX and truncates to int (-1).\n        case(\"overflow_to_minus_one\", \"99999999999999999999\\n12\\n\"),\n        // Fits in long, truncated to int: 4294967298 -> 2 (create scene).\n        case(\"truncates_to_two\", \"4294967298\\nName\\n6\\n12\\n\"),\n        // A line longer than the 255-byte fgets buffer is split in two reads.\n        case(\"line_longer_than_buffer\", format!(\"{}\\n12\\n\", rep(\"1\", 300))),\n        case(\"line_exactly_255_digits\", format!(\"{}\\n12\\n\", rep(\"1\", 255))),\n        case(\"many_invalid_choices\", format!(\"{}12\\n\", rep(\"0\\n\", 12))),\n        // Every menu entry, in order.\n        case(\n            \"all_menu_entries\",\n            join(&[\n                SHAPES.into(),\n                create(\"S\"),\n                add(0, 0),\n                remove(0, 1),\n                view(0),\n                LIST.into(),\n                save(0, \"save.txt\"),\n                load(\"save.txt\"),\n                cmp_shapes(0, 0),\n                cmp_scenes(0, 1),\n                del(0),\n                EXIT.into(),\n            ]),\n        ),\n    ];\n    check_all(\"menu\", cases);\n}\n\n// ---------------------------------------------------------------------------\n// 1. view_all_shapes()\n// ---------------------------------------------------------------------------\n\n#[test]\nfn view_all_shapes() {\n    let cases = vec![\n        case(\"once\", \"1\\n12\\n\"),\n        case(\"twice\", \"1\\n1\\n12\\n\"),\n        case(\"then_eof\", \"1\\n\"),\n    ];\n    check_all(\"view_shapes\", cases);\n}\n\n// ---------------------------------------------------------------------------\n// 2. create_new_scene(): fgets(name, MAX_SCENE_NAME=64, stdin)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn create_scene() {\n    let cases = vec![\n        case(\"simple\", \"2\\nMy Scene\\n6\\n12\\n\"),\n        case(\"empty_name\", \"2\\n\\n6\\n5\\n0\\n12\\n\"),\n        // fgets returns NULL at the name prompt -> silent return.\n        case(\"eof_at_name_prompt\", \"2\"),\n        case(\"eof_at_name_prompt_with_newline\", \"2\\n\"),\n        case(\"name_62_chars\", format!(\"2\\n{}\\n6\\n12\\n\", rep(\"A\", 62))),\n        // 63 chars fill the buffer, so the newline is left for the next fgets.\n        case(\"name_63_chars\", format!(\"2\\n{}\\n6\\n12\\n\", rep(\"A\", 63))),\n        // Longer names are truncated and the rest becomes the next menu line.\n        case(\"name_70_chars\", format!(\"2\\n{}\\n6\\n12\\n\", rep(\"A\", 70))),\n        case(\n            \"name_70_digits_tail\",\n            format!(\"2\\n{}{}\\n6\\n12\\n\", rep(\"N\", 60), \"12345678\"),\n        ),\n        case(\"name_with_cr\", \"2\\nA\\r\\n6\\n5\\n0\\n12\\n\"),\n        case(\"name_with_tab\", \"2\\n\\tA B\\t\\n6\\n12\\n\"),\n        // strcspn() stops at the NUL, so only \"A\" becomes the name.\n        case(\"nul_in_name\", cat(&[b\"2\\nA\\x00B\\n\", b\"6\\n12\\n\"])),\n        case(\"non_utf8_name\", cat(&[b\"2\\n\\xff\\xfe raw\\n\", b\"6\\n5\\n0\\n12\\n\"])),\n        // MAX_SCENES == 10.\n        case(\n            \"eleven_scenes\",\n            format!(\n                \"{}{LIST}{EXIT}\",\n                (0..11).map(|i| create(&format!(\"S{i}\"))).collect::<String>()\n            ),\n        ),\n        case(\n            \"duplicate_names\",\n            join(&[create(\"X\"), create(\"X\"), LIST.into(), cmp_scenes(0, 1), EXIT.into()]),\n        ),\n    ];\n    check_all(\"create_scene\", cases);\n}\n\n// ---------------------------------------------------------------------------\n// 3. add_shape_to_scene(): scanf(\"%d\") twice, each followed by a getchar drain\n// ---------------------------------------------------------------------------\n\n#[test]\nfn add_shape() {\n    let cases = vec![\n        case(\"no_scenes\", \"3\\n12\\n\"),\n        case(\"invalid_scene_input\", \"2\\nA\\n3\\nx\\n12\\n\"),\n        case(\"invalid_scene_input_sign_only\", \"2\\nA\\n3\\n+x\\n12\\n\"),\n        case(\"scene_index_negative\", \"2\\nA\\n3\\n-1\\n12\\n\"),\n        case(\"scene_index_too_large\", \"2\\nA\\n3\\n1\\n12\\n\"),\n        case(\"scene_index_int_min\", \"2\\nA\\n3\\n-2147483648\\n12\\n\"),\n        case(\"invalid_shape_input\", \"2\\nA\\n3\\n0\\nq\\n12\\n\"),\n        case(\"shape_type_equals_count\", \"2\\nA\\n3\\n0\\n10\\n12\\n\"),\n        case(\"shape_type_negative\", \"2\\nA\\n3\\n0\\n-5\\n12\\n\"),\n        case(\"shape_type_huge\", \"2\\nA\\n3\\n0\\n99999999999999999999\\n12\\n\"),\n        case(\n            \"first_shape\",\n            join(&[create(\"A\"), add(0, 0), view(0), EXIT.into()]),\n        ),\n        case(\n            \"last_shape\",\n            join(&[create(\"A\"), add(0, 9), view(0), EXIT.into()]),\n        ),\n        case(\n            \"all_shape_types\",\n            format!(\n                \"{}{}{}{EXIT}\",\n                create(\"A\"),\n                (0..10).map(|i| add(0, i)).collect::<String>(),\n                view(0)\n            ),\n        ),\n        case(\n            \"same_shape_twice\",\n            join(&[create(\"A\"), add(0, 4), add(0, 4), view(0), EXIT.into()]),\n        ),\n        // scanf skips arbitrary whitespace, including newlines.\n        case(\"blank_lines_between_numbers\", \"2\\nA\\n3\\n\\n\\n0\\n\\n0\\n5\\n0\\n12\\n\"),\n        // The getchar drain throws away the rest of the line.\n        case(\"two_numbers_on_one_line\", \"2\\nA\\n3\\n0 1\\n12\\n\"),\n        case(\"digits_then_text\", \"2\\nA\\n3\\n0abc\\n0\\n5\\n0\\n12\\n\"),\n        // MAX_SHAPES_IN_SCENE == 50: the 51st add fails on stderr and stdout.\n        case(\n            \"fifty_one_shapes\",\n            format!(\n                \"{}{}{LIST}{EXIT}\",\n                create(\"A\"),\n                rep(&add(0, 0), 51)\n            ),\n        ),\n        case(\n            \"fifty_shapes_exactly\",\n            format!(\"{}{}{LIST}{EXIT}\", create(\"A\"), rep(&add(0, 7), 50)),\n        ),\n        case(\n            \"add_to_second_scene\",\n            join(&[\n                create(\"A\"),\n                create(\"B\"),\n                add(1, 7),\n                view(1),\n                view(0),\n                EXIT.into(),\n            ]),\n        ),\n    ];\n    check_all(\"add_shape\", cases);\n}\n\n// ---------------------------------------------------------------------------\n// 4. remove_shape_from_scene()\n// ---------------------------------------------------------------------------\n\n#[test]\nfn remove_shape() {\n    let cases = vec![\n        case(\"no_scenes\", \"4\\n12\\n\"),\n        case(\"invalid_scene_input\", \"2\\nA\\n4\\nx\\n12\\n\"),\n        case(\"scene_index_negative\", \"2\\nA\\n4\\n-3\\n12\\n\"),\n        case(\"scene_index_too_large\", \"2\\nA\\n4\\n9\\n12\\n\"),\n        // An empty scene is listed first, then rejected.\n        case(\"empty_scene\", \"2\\nA\\n4\\n0\\n12\\n\"),\n        case(\n            \"invalid_shape_input\",\n            format!(\"{}{}4\\n0\\nz\\n{EXIT}\", create(\"A\"), add(0, 0)),\n        ),\n        case(\n            \"remove_only_shape\",\n            join(&[create(\"A\"), add(0, 0), remove(0, 1), view(0), EXIT.into()]),\n        ),\n        // index 0 becomes -1 in scene_remove_shape -> error.\n        case(\n            \"remove_index_zero\",\n            join(&[create(\"A\"), add(0, 0), remove(0, 0), EXIT.into()]),\n        ),\n        case(\n            \"remove_index_past_end\",\n            join(&[create(\"A\"), add(0, 0), remove(0, 2), EXIT.into()]),\n        ),\n        case(\n            \"remove_index_negative\",\n            join(&[create(\"A\"), add(0, 0), remove(0, -7), EXIT.into()]),\n        ),\n        // shape_idx - 1 overflows to INT_MAX.\n        case(\n            \"remove_index_int_min\",\n            join(&[create(\"A\"), add(0, 0), remove(0, -2147483648), EXIT.into()]),\n        ),\n        case(\n            \"remove_middle_then_view\",\n            join(&[\n                create(\"A\"),\n                add(0, 0),\n                add(0, 1),\n                add(0, 2),\n                remove(0, 2),\n                view(0),\n                EXIT.into(),\n            ]),\n        ),\n        case(\n            \"remove_first_then_view\",\n            join(&[\n                create(\"A\"),\n                add(0, 0),\n                add(0, 1),\n                remove(0, 1),\n                view(0),\n                EXIT.into(),\n            ]),\n        ),\n        case(\n            \"remove_last_then_view\",\n            join(&[\n                create(\"A\"),\n                add(0, 0),\n                add(0, 1),\n                remove(0, 2),\n                view(0),\n                EXIT.into(),\n            ]),\n        ),\n        case(\n            \"remove_until_empty\",\n            join(&[\n                create(\"A\"),\n                add(0, 0),\n                add(0, 1),\n                remove(0, 1),\n                remove(0, 1),\n                remove(0, 1),\n                EXIT.into(),\n            ]),\n        ),\n        case(\n            \"remove_from_fifty\",\n            format!(\n                \"{}{}{}{LIST}{EXIT}\",\n                create(\"A\"),\n                rep(&add(0, 3), 50),\n                remove(0, 50)\n            ),\n        ),\n    ];\n    check_all(\"remove_shape\", cases);\n}\n\n// ---------------------------------------------------------------------------\n// 5. view_scene() / 6. list_all_scenes()\n// ---------------------------------------------------------------------------\n\n#[test]\nfn view_and_list_scenes() {\n    let cases = vec![\n        case(\"view_no_scenes\", \"5\\n12\\n\"),\n        case(\"view_invalid_input\", \"2\\nA\\n5\\nx\\n12\\n\"),\n        case(\"view_bad_index\", \"2\\nA\\n5\\n4\\n12\\n\"),\n        case(\"view_negative_index\", \"2\\nA\\n5\\n-1\\n12\\n\"),\n        case(\"view_empty_scene\", \"2\\nA\\n5\\n0\\n12\\n\"),\n        case(\n            \"view_scene_with_shapes\",\n            join(&[create(\"A\"), add(0, 0), add(0, 1), view(0), EXIT.into()]),\n        ),\n        case(\n            \"view_twice\",\n            join(&[create(\"A\"), add(0, 7), view(0), view(0), EXIT.into()]),\n        ),\n        case(\"list_none\", \"6\\n12\\n\"),\n        case(\n            \"list_three\",\n            join(&[create(\"A\"), create(\"B\"), create(\"C\"), LIST.into(), EXIT.into()]),\n        ),\n        case(\n            \"list_after_delete\",\n            join(&[\n                create(\"A\"),\n                create(\"B\"),\n                create(\"C\"),\n                del(1),\n                LIST.into(),\n                EXIT.into(),\n            ]),\n        ),\n        case(\n            \"list_counts\",\n            join(&[create(\"A\"), add(0, 0), create(\"B\"), LIST.into(), EXIT.into()]),\n        ),\n    ];\n    check_all(\"view_list\", cases);\n}\n\n// ---------------------------------------------------------------------------\n// 7. save_scene_to_file() / scene_save()\n// ---------------------------------------------------------------------------\n\n#[test]\nfn save_scene() {\n    let cases = vec![\n        case(\"no_scenes\", \"7\\n12\\n\"),\n        case(\"invalid_input\", \"2\\nA\\n7\\nx\\n12\\n\"),\n        case(\"bad_index\", \"2\\nA\\n7\\n5\\n12\\n\"),\n        case(\"negative_index\", \"2\\nA\\n7\\n-1\\n12\\n\"),\n        // fgets at the filename prompt hits end of file -> silent return.\n        case(\"eof_at_filename\", \"2\\nA\\n7\\n0\\n\"),\n        // fopen(\"\", \"w\") fails.\n        case(\"empty_filename\", \"2\\nA\\n7\\n0\\n\\n12\\n\"),\n        case(\n            \"save_empty_scene\",\n            join(&[create(\"Empty\"), save(0, \"empty.txt\"), EXIT.into()]),\n        ),\n        case(\n            \"save_with_shapes\",\n            join(&[\n                create(\"With Shapes\"),\n                add(0, 0),\n                add(0, 1),\n                add(0, 9),\n                save(0, \"out.txt\"),\n                EXIT.into(),\n            ]),\n        ),\n        case(\n            \"save_fifty_shapes\",\n            format!(\n                \"{}{}{}{EXIT}\",\n                create(\"Fifty\"),\n                rep(&add(0, 2), 50),\n                save(0, \"fifty.txt\")\n            ),\n        ),\n        case(\n            \"overwrite_existing\",\n            join(&[create(\"A\"), add(0, 2), save(0, \"f.txt\"), EXIT.into()]),\n        )\n        .file(\"f.txt\", \"much longer previous content\\n\"),\n        case(\"filename_is_directory\", \"2\\nA\\n7\\n0\\n.\\n12\\n\"),\n        case(\"nonexistent_directory\", \"2\\nA\\n7\\n0\\nsub/f.txt\\n12\\n\"),\n        case(\"readonly_target\", \"2\\nA\\n7\\n0\\nro.txt\\n12\\n\").file_mode(\"ro.txt\", \"keep\\n\", 0o444),\n        case(\n            \"filename_255_chars\",\n            format!(\"2\\nA\\n7\\n0\\n{}\\n6\\n12\\n\", rep(\"f\", 255)),\n        ),\n        // Only the first 255 bytes are read; the tail becomes the next menu line.\n        case(\n            \"filename_longer_than_buffer\",\n            format!(\"2\\nA\\n7\\n0\\n{}\\n6\\n12\\n\", rep(\"g\", 300)),\n        ),\n        case(\n            \"non_utf8_filename\",\n            cat(&[b\"2\\nA\\n3\\n0\\n3\\n7\\n0\\n\\xff\\xfe.txt\\n\", b\"12\\n\"]),\n        ),\n        case(\n            \"name_with_spaces\",\n            join(&[create(\"A\"), save(0, \"with space.txt\"), EXIT.into()]),\n        ),\n        case(\n            \"save_scene_with_long_name\",\n            join(&[create(&rep(\"L\", 63)), save(0, \"long.txt\"), EXIT.into()]),\n        ),\n        case(\n            \"save_then_reload\",\n            join(&[\n                create(\"A\"),\n                add(0, 5),\n                save(0, \"rt.txt\"),\n                load(\"rt.txt\"),\n                LIST.into(),\n                view(1),\n                cmp_scenes(0, 1),\n                EXIT.into(),\n            ]),\n        ),\n    ];\n    check_all(\"save_scene\", cases);\n}\n\n// ---------------------------------------------------------------------------\n// 8. load_scene_from_file() / scene_load()\n// ---------------------------------------------------------------------------\n\n#[test]\nfn load_scene() {\n    let fifty: Vec<i32> = (0..50).map(|i| i % 10).collect();\n    let fifty_five: Vec<i32> = (0..55).map(|i| i % 10).collect();\n    let cases = vec![\n        case(\"missing_file\", \"8\\nnope.txt\\n12\\n\"),\n        case(\"empty_filename\", \"8\\n\\n12\\n\"),\n        case(\"eof_at_filename\", \"8\"),\n        case(\"eof_at_filename_with_newline\", \"8\\n\"),\n        case(\"directory\", \"8\\n.\\n12\\n\"),\n        // fgets on an empty file returns NULL: no message at all.\n        case(\"empty_file\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", \"\"),\n        case(\"name_only\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", \"Only A Name\\n\"),\n        case(\"name_without_newline\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", \"NoNewline\"),\n        case(\"count_not_a_number\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", \"S\\nabc\\n\"),\n        case(\"count_zero\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\").file(\"f.txt\", \"S\\n0\\n\"),\n        case(\"count_negative\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\").file(\"f.txt\", \"S\\n-3\\n\"),\n        case(\"count_more_than_entries\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", \"S\\n4\\n1\\n2\\n\"),\n        case(\"count_junk_suffix\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", \"S\\n3junk\\n\"),\n        case(\"count_with_plus\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\").file(\"f.txt\", \"S\\n+2\\n1\\n2\\n\"),\n        case(\"count_with_spaces\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\").file(\"f.txt\", \"S\\n  2  \\n 1 \\n 2 \\n\"),\n        // 99999999999 truncates to 1215752191, so the load runs out of numbers.\n        case(\"count_overflows_int\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", \"S\\n99999999999\\n1\\n\"),\n        case(\"shape_type_out_of_range\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\").file(\"f.txt\", \"S\\n2\\n1\\n77\\n\"),\n        case(\"shape_type_negative\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\").file(\"f.txt\", \"S\\n2\\n-4\\n3\\n\"),\n        case(\"types_on_one_line\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\").file(\"f.txt\", \"S\\n3\\n2 1 3\\n\"),\n        case(\"crlf_file\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\").file(\"f.txt\", \"S\\r\\n2\\r\\n1\\r\\n2\\r\\n\"),\n        case(\"trailing_whitespace\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\").file(\"f.txt\", \"S\\n1\\n1\\n   \\n\\n\"),\n        case(\"extra_trailing_junk\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\").file(\"f.txt\", \"S\\n1\\n1\\nextra\\n\"),\n        // fgets stops after 63 bytes; the rest of the name line is parsed as the\n        // shape count.\n        case(\"name_longer_than_63\", \"8\\nf.txt\\n6\\n12\\n\")\n            .file(\"f.txt\", format!(\"{}\\n1\\n3\\n\", rep(\"N\", 70))),\n        case(\"name_63_then_digits\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\")\n            .file(\"f.txt\", format!(\"{}7\\n2\\n0\\n1\\n\", rep(\"N\", 63))),\n        case(\"name_exactly_63\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\")\n            .file(\"f.txt\", format!(\"{}\\n1\\n2\\n\", rep(\"N\", 63))),\n        case(\"nul_in_name\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", cat(&[b\"A\\x00B\\n1\\n0\\n\"])),\n        case(\"non_utf8_name\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\").file(\"f.txt\", cat(&[b\"\\xff\\xfe\\n1\\n0\\n\"])),\n        case(\"all_ten_types\", \"8\\nf.txt\\n6\\n5\\n0\\n12\\n\")\n            .file(\"f.txt\", scene_file(\"Every Shape\", &(0..10).collect::<Vec<i32>>())),\n        case(\"exactly_fifty\", \"8\\nf.txt\\n6\\n12\\n\").file(\"f.txt\", scene_file(\"Fifty\", &fifty)),\n        // Past MAX_SHAPES_IN_SCENE scene_add_shape complains on stderr.\n        case(\"fifty_five_shapes\", \"8\\nf.txt\\n6\\n12\\n\")\n            .file(\"f.txt\", scene_file(\"TooMany\", &fifty_five)),\n        case(\"unreadable_file\", \"8\\nf.txt\\n6\\n12\\n\").file_mode(\"f.txt\", \"S\\n1\\n0\\n\", 0o000),\n        case(\"eleven_loads\", format!(\"{}{LIST}{EXIT}\", rep(&load(\"f.txt\"), 11)))\n            .file(\"f.txt\", scene_file(\"Loaded\", &[1, 2])),\n        case(\n            \"load_then_add_and_remove\",\n            join(&[\n                load(\"f.txt\"),\n                add(0, 4),\n                remove(0, 1),\n                view(0),\n                EXIT.into(),\n            ]),\n        )\n        .file(\"f.txt\", scene_file(\"Mixed\", &[8, 9])),\n    ];\n    check_all(\"load_scene\", cases);\n}\n\n// ---------------------------------------------------------------------------\n// 9. compare_shapes()\n// ---------------------------------------------------------------------------\n\n#[test]\nfn compare_shapes() {\n    let cases = vec![\n        case(\"invalid_first_input\", \"9\\nx\\n12\\n\"),\n        case(\"invalid_second_input\", \"9\\n0\\ny\\n12\\n\"),\n        case(\"first_type_out_of_range\", \"9\\n10\\n0\\n12\\n\"),\n        case(\"second_type_out_of_range\", \"9\\n0\\n10\\n12\\n\"),\n        case(\"first_type_negative\", \"9\\n-1\\n0\\n12\\n\"),\n        case(\"second_type_negative\", \"9\\n0\\n-1\\n12\\n\"),\n        case(\"both_out_of_range\", \"9\\n99\\n99\\n12\\n\"),\n        case(\"same_type\", \"9\\n0\\n0\\n12\\n\"),\n        case(\"same_type_last\", \"9\\n9\\n9\\n12\\n\"),\n        case(\"different_types\", \"9\\n0\\n1\\n12\\n\"),\n        case(\"different_types_reversed\", \"9\\n9\\n3\\n12\\n\"),\n        case(\"int_min_types\", \"9\\n-2147483648\\n0\\n12\\n\"),\n        case(\"overflowing_types\", \"9\\n99999999999999999999\\n0\\n12\\n\"),\n        case(\"numbers_on_one_line\", \"9\\n0 5\\n1\\n12\\n\"),\n        case(\"twice_in_a_row\", \"9\\n2\\n2\\n9\\n2\\n3\\n12\\n\"),\n        // Every pair of distinct shapes must report distinct addresses.\n        case(\n            \"all_pairs\",\n            format!(\n                \"{}{EXIT}\",\n                (0..10)\n                    .flat_map(|a| (0..10).map(move |b| cmp_shapes(a, b)))\n                    .collect::<String>()\n            ),\n        ),\n    ];\n    check_all(\"compare_shapes\", cases);\n}\n\n// ---------------------------------------------------------------------------\n// 10. compare_scenes()\n// ---------------------------------------------------------------------------\n\n#[test]\nfn compare_scenes() {\n    let fifty: Vec<i32> = (0..50).map(|i| i % 10).collect();\n    let fifty_rev: Vec<i32> = (0..50).map(|i| 9 - i % 10).collect();\n    let fifty_off: Vec<i32> = (0..50).map(|i| i % 9).collect();\n    let cases = vec![\n        case(\"no_scenes\", \"10\\n12\\n\"),\n        case(\"one_scene\", \"2\\nA\\n10\\n12\\n\"),\n        case(\"invalid_first_input\", \"2\\nA\\n2\\nB\\n10\\nx\\n12\\n\"),\n        case(\"invalid_second_input\", \"2\\nA\\n2\\nB\\n10\\n0\\ny\\n12\\n\"),\n        case(\"first_index_bad\", \"2\\nA\\n2\\nB\\n10\\n5\\n0\\n12\\n\"),\n        case(\"second_index_bad\", \"2\\nA\\n2\\nB\\n10\\n0\\n5\\n12\\n\"),\n        case(\"first_index_negative\", \"2\\nA\\n2\\nB\\n10\\n-1\\n0\\n12\\n\"),\n        case(\n            \"both_empty\",\n            join(&[create(\"A\"), create(\"B\"), cmp_scenes(0, 1), EXIT.into()]),\n        ),\n        case(\n            \"same_index\",\n            join(&[create(\"A\"), add(0, 3), create(\"B\"), cmp_scenes(0, 0), EXIT.into()]),\n        ),\n        case(\n            \"identical_contents\",\n            join(&[\n                create(\"A\"),\n                add(0, 0),\n                create(\"B\"),\n                add(1, 0),\n                cmp_scenes(0, 1),\n                EXIT.into(),\n            ]),\n        ),\n        case(\n            \"permuted_contents\",\n            join(&[\n                create(\"A\"),\n                add(0, 0),\n                add(0, 1),\n                create(\"B\"),\n                add(1, 1),\n                add(1, 0),\n                cmp_scenes(0, 1),\n                EXIT.into(),\n            ]),\n        ),\n        case(\n            \"different_shape_counts\",\n            join(&[create(\"A\"), add(0, 0), create(\"B\"), cmp_scenes(0, 1), EXIT.into()]),\n        ),\n        case(\n            \"same_count_different_shapes\",\n            join(&[\n                create(\"A\"),\n                add(0, 0),\n                create(\"B\"),\n                add(1, 1),\n                cmp_scenes(0, 1),\n                EXIT.into(),\n           