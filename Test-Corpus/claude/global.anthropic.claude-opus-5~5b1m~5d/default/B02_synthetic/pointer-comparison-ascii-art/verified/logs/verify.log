  41\t        strcpy(scene->name, \"Untitled Scene\");\n    42\t    }\n    43\t    \n    44\t    scene->shape_count = 0;\n    45\t    \n    46\t    return scene;\n    47\t}\n    48\t\n    49\tvoid scene_destroy(scene_t *scene) {\n    50\t    if (scene) {\n    51\t        // Note: We don't free the shapes themselves\n    52\t        // because they are singletons managed by shape_manager\n    53\t        free(scene);\n    54\t    }\n    55\t}\n    56\t\n    57\tint scene_add_shape(scene_t *scene, shape_t *shape) {\n    58\t    if (!scene || !shape) {\n    59\t        return -1;\n    60\t    }\n    61\t    \n    62\t    if (scene->shape_count >= MAX_SHAPES_IN_SCENE) {\n    63\t        fprintf(stderr, \"Error: Scene is full\\n\");\n    64\t        return -1;\n    65\t    }\n    66\t    \n    67\t    scene->shapes[scene->shape_count++] = shape;\n    68\t    return 0;\n    69\t}\n    70\t\n    71\tint scene_remove_shape(scene_t *scene, int index) {\n    72\t    if (!scene || index < 0 || index >= scene->shape_count) {\n    73\t        return -1;\n    74\t    }\n    75\t    \n    76\t    // Shift remaining shapes\n    77\t    for (int i = index; i < scene->shape_count - 1; i++) {\n    78\t        scene->shapes[i] = scene->shapes[i + 1];\n    79\t    }\n    80\t    \n    81\t    scene->shape_count--;\n    82\t    return 0;\n    83\t}\n    84\t\n    85\tvoid scene_print(const scene_t *scene) {\n    86\t    if (!scene) {\n    87\t        printf(\"(null scene)\\n\");\n    88\t        return;\n    89\t    }\n    90\t    \n    91\t    printf(\"\\n=== Scene: %s ===\\n\", scene->name);\n    92\t    printf(\"Contains %d shape(s)\\n\\n\", scene->shape_count);\n    93\t    \n    94\t    for (int i = 0; i < scene->shape_count; i++) {\n    95\t        printf(\"Shape #%d:\\n\", i + 1);\n    96\t        shape_print(scene->shapes[i]);\n    97\t        printf(\"\\n\");\n    98\t    }\n    99\t}\n   100\t\n   101\tint scene_equals(const scene_t *s1, const scene_t *s2) {\n   102\t    if (!s1 || !s2) {\n   103\t        return 0;\n   104\t    }\n   105\t    \n   106\t    // Scenes are equal if there's a 1:1 correspondence\n   107\t    if (s1->shape_count != s2->shape_count) {\n   108\t        return 0;\n   109\t    }\n   110\t    \n   111\t    // For each shape in s1, find a matching shape in s2\n   112\t    int matched[MAX_SHAPES_IN_SCENE] = {0};\n   113\t    \n   114\t    for (int i = 0; i < s1->shape_count; i++) {\n   115\t        int found = 0;\n   116\t        for (int j = 0; j < s2->shape_count; j++) {\n   117\t            if (!matched[j] && shape_equals(s1->shapes[i], s2->shapes[j])) {\n   118\t                matched[j] = 1;\n   119\t                found = 1;\n   120\t                break;\n   121\t            }\n   122\t        }\n   123\t        if (!found) {\n   124\t            return 0;\n   125\t        }\n   126\t    }\n   127\t    \n   128\t    return 1;\n   129\t}\n   130\t\n   131\tint scene_save(const scene_t *scene, const char *filename) {\n   132\t    if (!scene || !filename) {\n   133\t        return -1;\n   134\t    }\n   135\t    \n   136\t    FILE *file = fopen(filename, \"w\");\n   137\t    if (!file) {\n   138\t        fprintf(stderr, \"Error: Could not open file '%s' for writing\\n\", filename);\n   139\t        return -1;\n   140\t    }\n   141\t    \n   142\t    // Write scene name\n   143\t    fprintf(file, \"%s\\n\", scene->name);\n   144\t    \n   145\t    // Write shape count\n   146\t    fprintf(file, \"%d\\n\", scene->shape_count);\n   147\t    \n   148\t    // Write shape types (not the shapes themselves, just their types)\n   149\t    for (int i = 0; i < scene->shape_count; i++) {\n   150\t        fprintf(file, \"%d\\n\", scene->shapes[i]->type);\n   151\t    }\n   152\t    \n   153\t    fclose(file);\n   154\t    printf(\"Scene saved to '%s'\\n\", filename);\n   155\t    return 0;\n   156\t}\n   157\t\n   158\tscene_t* scene_load(const char *filename) {\n   159\t    if (!filename) {\n   160\t        return NULL;\n   161\t    }\n   162\t    \n   163\t    FILE *file = fopen(filename, \"r\");\n   164\t    if (!file) {\n   165\t        fprintf(stderr, \"Error: Could not open file '%s' for reading\\n\", filename);\n   166\t        return NULL;\n   167\t    }\n   168\t    \n   169\t    char name[MAX_SCENE_NAME];\n   170\t    if (fgets(name, MAX_SCENE_NAME, file) == NULL) {\n   171\t        fclose(file);\n   172\t        return NULL;\n   173\t    }\n   174\t    \n   175\t    // Remove newline\n   176\t    name[strcspn(name, \"\\n\")] = 0;\n   177\t    \n   178\t    scene_t *scene = scene_create(name);\n   179\t    if (!scene) {\n   180\t        fclose(file);\n   181\t        return NULL;\n   182\t    }\n   183\t    \n   184\t    int shape_count;\n   185\t    if (fscanf(file, \"%d\\n\", &shape_count) != 1) {\n   186\t        scene_destroy(scene);\n   187\t        fclose(file);\n   188\t        return NULL;\n   189\t    }\n   190\t    \n   191\t    for (int i = 0; i < shape_count; i++) {\n   192\t        int type;\n   193\t        if (fscanf(file, \"%d\\n\", &type) != 1) {\n   194\t            scene_destroy(scene);\n   195\t            fclose(file);\n   196\t            return NULL;\n   197\t        }\n   198\t        \n   199\t        shape_t *shape = shape_get((shape_type_t)type);\n   200\t        if (shape) {\n   201\t            scene_add_shape(scene, shape);\n   202\t        }\n   203\t    }\n   204\t    \n   205\t    fclose(file);\n   206\t    printf(\"Scene loaded from '%s'\\n\", filename);\n   207\t    return scene;\n   208\t}\n   209\t\n   210\tvoid scene_list_shapes(const scene_t *scene) {\n   211\t    if (!scene) {\n   212\t        printf(\"(null scene)\\n\");\n   213\t        return;\n   214\t    }\n   215\t    \n   216\t    printf(\"\\nScene: %s\\n\", scene->name);\n   217\t    printf(\"Shapes (%d):\\n\", scene->shape_count);\n   218\t    \n   219\t    for (int i = 0; i < scene->shape_count; i++) {\n   220\t        printf(\"  %d. %s (ptr: %p)\\n\", i + 1, \n   221\t     