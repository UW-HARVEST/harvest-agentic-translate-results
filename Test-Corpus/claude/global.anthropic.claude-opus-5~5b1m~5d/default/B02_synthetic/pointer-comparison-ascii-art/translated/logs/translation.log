{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014BfdLMensEppgn9hBu7ykX","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-guOqWi/_work/run_all.py (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"98073a6b-861e-4508-bd1d-8e26e0c3a0a1","uuid":"82ead46a-4cf2-475d-beca-4d3a96595122","timestamp":"2026-08-28T05:17:16.877Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-guOqWi/_work/run_all.py","content":"#!/usr/bin/env python3\n\"\"\"Differential test driver: run the C reference and the Rust translation on the\nsame stdin and compare stdout / stderr / exit status / produced files.\n\nHeap addresses printed with %p are replaced by identity tokens (first-appearance\norder), so pointer *identity* is still checked while the actual (necessarily\ndifferent) address values are not.\"\"\"\nimport os, re, shutil, subprocess, sys, glob\n\nROOT = os.path.dirname(os.path.abspath(__file__))\nC_BIN = os.path.join(ROOT, 'driver')\nR_BIN = os.path.abspath(os.path.join(ROOT, '..', 'translation', 'target', 'release', 'driver'))\nRUN = os.path.join(ROOT, 'run')\nTIMEOUT = 2.0\n\n\ndef norm(data):\n    ids = {}\n    def repl(m):\n        k = m.group(0)\n        if k not in ids:\n            ids[k] = b'P%d' % len(ids)\n        return ids[k]\n    return re.sub(rb'0x[0-9a-f]+', repl, data)\n\n\ndef run(binary, inp, seed, wd):\n    shutil.rmtree(wd, ignore_errors=True)\n    os.makedirs(wd)\n    if seed:\n        shutil.copytree(seed, wd, dirs_exist_ok=True)\n    try:\n        p = subprocess.run([binary], stdin=open(inp, 'rb'), cwd=wd,\n                           stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n                           timeout=TIMEOUT)\n        out, err, rc = p.stdout, p.stderr, p.returncode\n    except subprocess.TimeoutExpired as e:\n        out, err, rc = e.stdout or b'', e.stderr or b'', 'TIMEOUT'\n    files = {}\n    for f in sorted(os.listdir(wd)):\n        path = os.path.join(wd, f)\n        files[f] = open(path, 'rb').read() if os.path.isfile(path) else '<dir>'\n    return norm(out), norm(err), rc, files\n\n\ndef main(tests, seed):\n    npass = nfail = nto = 0\n    for t in tests:\n        co, ce, crc, cf = run(C_BIN, t, seed, os.path.join(RUN, 'c'))\n        ro, re_, rrc, rf = run(R_BIN, t, seed, os.path.join(RUN, 'r'))\n        problems = []\n        if co != ro:\n            problems.append('stdout (%d vs %d bytes)' % (len(co), len(ro)))\n        if ce != re_:\n            problems.append('stderr (%r vs %r)' % (ce[:200], re_[:200]))\n        if crc != rrc:\n            problems.append('exit (%s vs %s)' % (crc, rrc))\n        if cf != rf:\n            problems.append('files (%s vs %s)' % (sorted(cf), sorted(rf)))\n        if problems:\n            nfail += 1\n            print('FAIL', t, '|', '; '.join(problems))\n            if co != ro:\n                import difflib\n                a = co.decode('latin1').splitlines(True)\n                b = ro.decode('latin1').splitlines(True)\n                sys.stdout.writelines(list(difflib.unified_diff(a, b, 'C', 'RUST'))[:25])\n            for k in cf:\n                if k in rf and cf[k] != rf[k]:\n                    print('  file %r: C=%r RUST=%r' % (k, cf[k][:200], rf[k][:200]))\n        else:\n            npass += 1\n            if crc == 'TIMEOUT':\n                nto += 1\n    print('pass=%d fail=%d (timeouts=%d)' % (npass, nfail, nto))\n    return 1 if nfail else 0\n\n\nif __name__ == '__main__':\n    pats = sys.argv[1:] or ['in/*.txt', 'fuzz/*.txt']\n    tests = []\n    for p in pats:\n        tests += sorted(glob.glob(os.path.join(ROOT, p)))\n    sys.exit(main(tests, os.path.join(ROOT, 'seed')))\n","structuredPatch":[],"originalFile":null,"userModified":false}}
