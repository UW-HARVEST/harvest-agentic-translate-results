}\n\n#[test]\nfn soak_tree_mode2_full_offset_flag_grid() {\n    let (p, _g) = ready();\n    const LIM: c_int = 134_000_000;\n    let mut rng = Rng::new(0x2222_6666);\n    for &id in &ALL_IDS {\n        for d in 0..=17 {\n            for f in [-LIM, -1000, -16, -1, 0, 1, 16, 1000, LIM] {\n                p.assert_same_eq(0o2, id, d, f, model_mode2(id, d, f));\n            }\n            for _ in 0..200 {\n                let f = rng.i32_range(-LIM, LIM);\n                p.assert_same_eq(0o2, id, d, f, model_mode2(id, d, f));\n            }\n        }\n    }\n}\n\n// --- row 24 ---------------------------------------------------------------"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":418,"cache_read_input_tokens":114222,"cache_creation":{"ephemeral_5m_input_tokens":418,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8aa1068f-07f1-4d4f-8336-7fd5e05f263c","uuid":"e3ff15f9-fe76-43ec-9d41-6a432a22f4fa","timestamp":"2026-08-28T02:44:31.073Z"}
