{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ws66m44vo5722svhlqmqhpgso7kigroiqmzxgs7wkszbzlhd7qxa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01CwqPjxJsZbPi7gHSkwqDGP","name":"Edit","input":{"replace_all":false,"file_path":"/local/home/scheschb/.harvest/work/harvest-work-nTzw79/translation/tests/symbols.rs","old_string":"fn is_libc_ish(sym: &str) -> bool {\n    let base = sym.split('@').next().unwrap_or(sym);\n    // Toolchain / loader / libc / libm / libgcc / pthread symbols that any\n    // shared object legitimately imports.\n    const ALLOWED: &[&str] = &[\n        \"sprintf\", \"snprintf\", \"strlen\", \"memcpy\", \"memmove\", \"memset\", \"memcmp\", \"sqrt\", \"sqrtf\",\n        \"malloc\", \"calloc\", \"realloc\", \"free\", \"abort\", \"write\", \"writev\", \"sigaltstack\",\n        \"sysconf\", \"pthread_getattr_np\", \"pthread_attr_getstack\", \"pthread_attr_destroy\",\n        \"pthread_self\", \"mmap\", \"munmap\", \"mprotect\", \"getenv\", \"dl_iterate_phdr\", \"bcmp\",\n        \"posix_memalign\", \"__errno_location\", \"syscall\", \"readlink\", \"open64\", \"close\", \"read\",\n        \"poll\", \"stat64\", \"fstat64\", \"strerror_r\", \"sigaction\", \"sigemptyset\", \"raise\",\n    ];\n    base.starts_with(\"__\")\n        || base.starts_with(\"_ITM_\")\n        || base.starts_with(\"_Unwind_\")\n        || base.starts_with(\"_dl_\")\n        || base.is_empty()\n        || ALLOWED.contains(&base)\n}","new_string":"/// A symbol is \"provided by the platform\" if the linker gave it a glibc/GCC\n/// version tag, or it is one of the weak toolchain hooks. Anything else (in\n/// particular a Rust-mangled `_ZN...` or a plain untagged name) would be a\n/// genuinely unresolved dependency.\nfn is_libc_ish(sym: &str) -> bool {\n    const WEAK_TOOLCHAIN: &[&str] = &[\n        \"_ITM_deregisterTMCloneTable\",\n        \"_ITM_registerTMCloneTable\",\n        \"__gmon_start__\",\n        \"__tls_get_a