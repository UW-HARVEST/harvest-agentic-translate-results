});\n        rs.push(unsafe { (r.compare_allocations)(1, 2) });\n    }\n    println!(\"interleaved C: {cs:?}\");\n    println!(\"interleaved R: {rs:?}\");\n\n    let mut cs2 = Vec::new();\n    for _ in 0..8 {\n        cs2.push(unsafe { (c.compare_allocations)(1, 2) });\n    }\n    let mut rs2 = Vec::new();\n    for _ in 0..8 {\n        rs2.push(unsafe { (r.compare_allocations)(1, 2) });\n    }\n    println!(\"blocked C: {cs2:?}\");\n    println!(\"blocked R: {rs2:?}\");\n\n    // Same probe through arity4 (which calls compare_allocations once).\n    let mut ca = Vec::new();\n    let mut ra = Vec::new();\n    for _ in 0..8 {\n        ca.push(unsafe { (c.arity4)(1, 2, 0, 0) });\n        ra.push(unsafe { (r.arity4)(1, 2, 0, 0) });\n    }\n    println!(\"arity4 interleaved C: {ca:?}\");\n    println!(\"arity4 interleaved R: {ra:?}\");\n}\n","userModified":false}}
