|catch\"\n  \"shift_array guard positions<size -> <=|s/if positions > 0 \\&\\& positions < size {/if positions > 0 \\&\\& positions <= size {/|catch\"\n  \"shift_array guard positions>0 -> >=0|s/if positions > 0 \\&\\& positions < size {/if positions >= 0 \\&\\& positions < size {/|catch\"\n  \"shift_array zero-fills positions+1 slots|s/while i < positions {/while i <= positions {/|catch\"\n  \"shift_array moves size instead of size-positions elements|s/let elems = size.wrapping_sub(positions) as isize;/let elems = size as isize;/|catch\"\n  \"arity4 uses Euclidean modulo instead of C remainder|s/param1.wrapping_rem(4)/param1.rem_euclid(4)/|catch\"\n  \"arity4 divides by 101 instead of 100|s/wrapping_div(100)/wrapping_div(101)/|catch\"\n  \"arity4 reads matrix[2][2] instead of [2][3]|s/.wrapping_add(matrix\\[2\\]\\[3\\])/.wrapping_add(matrix[2][2])/|catch\"\n  \"arity4 shifts by 2 instead of 1|s/shift_array(block.values.as_mut_ptr(), 4, 1)/shift_array(block.values.as_mut_ptr(), 4, 2)/|catch\"\n  \"arity4 param3 guard != 0 -> > 0|s/if param3 != 0 {/if param3 > 0 {/|catch\"\n  \"arity4 param4 guard != 0 -> > 0|s/if param4 != 0 {/if param4 > 0 {/|catch\"\n  \"init_matrix last element 12 -> 13|s/\\[9, 10, 11, 12\\]/[9, 10, 11, 13]/|catch\"\n  \"init_matrix writes column-major|s/write_volatile(matrix.add(i \\* 4 + j), temp\\[i\\]\\[j\\]);/write_volatile(matrix.add(j * 3 + i), temp[i][j]);/|catch\"\n  \"process_string guard inverted|s/if unsafe { read_volatile(str) } != 0 {/if unsafe { read_volatile(str) } == 0 {/|catch\"\n  \"compare_allocations bonus test > 0 -> >= 0|s/if unsafe { read_volatile(uninit_ptr) } > 0 {/if unsafe { read_volatile(uninit_ptr) } >= 0 {/|catch\"\n  \"compare_allocations bonus 10 -> 11|s/^        10$/        11/|catch\"\n  \"compare_allocations malloc-failure returns 0 instead of -1|s/        return -1;/        return 0;/|catch\"\n  \"compare_allocations equal-pointer branch returns 4 instead of 3|s/result = 3;/result = 4;/|catch\"\n  \"compare_allocations bonus reads val1 instead of the stored memory|s/unsafe { read_volatile(uninit_ptr) } > 0/val1 > 0/|catch\"\n  \"arity3 forwards param4=1 instead of 0|s/arity4(p1, p2, p3, 0)/arity4(p1, p2, p3, 1)/|catch\"\n  \"arity2 forwards param3=1 instead of 0|s/arity4(p1, p2, 0, 0)/arity4(p1, p2, 1, 0)/|catch\"\n  \"plain deref instead of volatile in process_string (null-fault mode)|s/if unsafe { read_volatile(str) } != 0 {/if unsafe { *str } != 0 {/|catch\"\n  \"plain deref instead of volatile in arity (null-fault mode)|s/read_volatile(params.offset(0))/*params.offset(0)/|catch\"\n  \"plain write instead of volatile in init_matrix (null-fault mode)|s/write_volatile(matrix.add(i \\* 4 + j), temp\\[i\\]\\[j\\]);/*matrix.add(i * 4 + j) = temp[i][j];/|catch\"\n  # --- provably behaviour-preserving mutants: surviving is the correct outcome\n  \"EQUIVALENT: process_string always calls strlen (strlen(\\\"\\\")==0 anyway)|s/if unsafe { read_volatile(str) } != 0 {/if true {/|equivalent\"\n  \"EQUIVALENT: signed pointer compare (no x86-64 user address has bit 63 set)|s/if (ptr1 as usize) < (ptr2 as usize) {/if (ptr1 as isize) < (ptr2 as isize) {/|equivalent\"\n)\n\ncaught=0; ok_survivors=0; bad_survivors=0; skipped=0\ndeclare -a BAD=()\n\nprintf '%-76s %s\\n' \"MUTATION\" \"RESULT\"\nprintf '%.0s-' {1..110}; printf '\\n'\n\nfor entry in \"${MUTATIONS[@]}\"; do\n  name=${entry%%|*}\n  rest=${entry#*|}\n  expr=${rest%|*}\n  expect=${rest##*|}\n  restore\n  sed -i \"$expr\" \"$SRC\"\n  if cmp -s \"$SRC\" \"$BAK\"; then\n    printf '%-76s %s\\n' \"$name\" \"!! SKIPPED (sed pattern did not match)\"\n    skipped=$((skipped+1)); BAD+=(\"$name -> sed pattern did not match\"); continue\n  fi\n  if ! cargo build $PROFILE >target/mut-build.log 2>&1; then\n    printf '%-76s %s\\n' \"$name\" \"!! SKIPPED (does not compile)\"\n    skipped=$((skipped+1)); BAD+=(\"$name -> does not compile\"); continue\n  fi\n  if cargo test $PROFILE --tests >target/mut-test.log 2>&1; then\n    if [ \"$expect\" = equivalent ]; then\n      printf '%-76s %s\\n' \"$name\" \"survived (expected: equivalent)\"\n      ok_survivors=$((ok_survivors+1))\n    else\n      printf '%-76s %s\\n' \"$name\" \"*** SURVIVED - BLIND SPOT ***\"\n      bad_survivors=$((bad_survivors+1)); BAD+=(\"$name -> survived\")\n    fi\n  else\n    failing=$(grep -hoE '^test [a-z0-9_]+ \\.\\.\\. FAILED' target/mut-test.log \\\n              | sed 's/^test //; s/ \\.\\.\\. FAILED//' | head -4 | tr '\\n' ' ')\n    n=$(grep -cE '^test [a-z0-9_]+ \\.\\.\\. FAILED' target/mut-test.log || true)\n    if [ \"$expect\" = equivalent ]; then\n      printf '%-76s %s\\n' \"$name\" \"!! FAILED although marked equivalent: $failing\"\n      bad_survivors=$((bad_survivors+1)); BAD+=(\"$name -> failed but marked equivalent\")\n    else\n      printf '%-76s %s\\n' \"$name\" \"caught by $n test(s): ${failing:-<see log>}\"\n      caught=$((caught+1))\n    fi\n  fi\ndone\n\nrestore\ncargo build $PROFILE >/dev/null 2>&1\n\nprintf '%.0s-' {1..110}; printf '\\n'\necho \"caught: $caught   equivalent-survivors: $ok_survivors   blind spots: $bad_survivors   skipped: $skipped\"\nif [ \"${#BAD[@]-0}\" -ne 0 ]; then\n  echo \"PROBLEMS:\"; for s in \"${BAD[@]}\"; do echo \"  - $s\"; done; exit 1\nfi\necho \"OK: every non-equivalent injected bug was detected by the differential suite.\"\n","userModified":false}}
