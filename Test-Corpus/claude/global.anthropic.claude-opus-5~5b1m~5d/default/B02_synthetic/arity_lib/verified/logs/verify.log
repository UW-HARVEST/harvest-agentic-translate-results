1|s/shift_array(block.values.as_mut_ptr(), 4, 1)/shift_array(block.values.as_mut_ptr(), 4, 2)/\"\n  \"init_matrix last element 12 -> 13|s/\\[9, 10, 11, 12\\]/[9, 10, 11, 13]/\"\n  \"process_string returns strlen for the empty string|s/if unsafe { read_volatile(str) } != 0 {/if true {/\"\n  \"compare_allocations bonus test > 0 -> >= 0|s/if unsafe { read_volatile(uninit_ptr) } > 0 {/if unsafe { read_volatile(uninit_ptr) } >= 0 {/\"\n  \"compare_allocations malloc-failure returns 0 instead of -1|s/        return -1;/        return 0;/\"\n  \"compare_allocations signed pointer comparison|s/if (ptr1 as usize) < (ptr2 as usize) {/if (ptr1 as isize) < (ptr2 as isize) {/\"\n  \"arity3 forwards param4=1 instead of 0|s/arity4(p1, p2, p3, 0)/arity4(p1, p2, p3, 1)/\"\n  \"arity2 forwards param3=1 instead of 0|s/arity4(p1, p2, 0, 0)/arity4(p1, p2, 1, 0)/\"\n  \"plain deref instead of volatile in process_string (null-fault mode)|s/if unsafe { read_volatile(str) } != 0 {/if unsafe { *str } != 0 {/\"\n  \"plain deref instead of volatile in arity (null-fault mode)|s/read_volatile(params.offset(0))/*params.offset(0)/\"\n)\n\ncaught=0\nsurvived=0\nsurvivors=()\n\nprintf '%-72s %s\\n' \"MUTATION\" \"RESULT\"\nprintf '%.0s-' {1..90}; printf '\\n'\n\nfor entry in \"${MUTATIONS[@]}\"; do\n  name=${entry%%|*}\n  expr=${entry#*|}\n  restore\n  sed -i \"$expr\" \"$SRC\"\n  if cmp -s \"$SRC\" \"$BAK\"; then\n    printf '%-72s %s\\n' \"$name\" \"SKIPPED (sed did not apply)\"\n    survived=$((survived+1)); survivors+=(\"$name (sed no-op)\")\n    continue\n  fi\n  if ! cargo build $PROFILE >target/mut-build.log 2>&1; then\n    printf '%-72s %s\\n' \"$name\" \"SKIPPED (does not compile)\"\n    survived=$((survived+1)); survivors+=(\"$name (build error)\")\n    continue\n  fi\n  if cargo test $PROFILE --tests >target/mut-test.log 2>&1; then\n    printf '%-72s %s\\n' \"$name\" \"*** SURVIVED (blind spot!) ***\"\n    survived=$((survived+1)); survivors+=(\"$name\")\n  else\n    failing=$(grep -hoE '^(test [a-z0-9_]+) \\.\\.\\. FAILED' target/mut-test.log | sed 's/^test //; s/ \\.\\.\\. FAILED//' | tr '\\n' ' ')\n    printf '%-72s %s\\n' \"$name\" \"caught by: ${failing:-<see log>}\"\n    caught=$((caught+1))\n  fi\ndone\n\nrestore\ncargo build $PROFILE >/dev/null 2>&1\n\nprintf '%.0s-' {1..90}; printf '\\n'\necho \"caught: $caught   survived: $survived\"\nif [ \"$survived\" -ne 0 ]; then\n  echo \"SURVIVORS:\"\n  for s in \"${survivors[@]}\"; do echo \"  - $s\"; done\n  exit 1\nfi\necho \"All injected bugs were detected by the differential suite.\"\n","userModified":false}}
