rintln!(\"RESULT {which} mode={mode} C={},{} Rust={},{}\", cv.0, cv.1, rv.0, rv.1);","     assert_eq!(cv, rv, \"malloc-failure mismatch for {which} mode {mode}\");"," }"," "]}],"userModified":false,"replaceAll":false}}
