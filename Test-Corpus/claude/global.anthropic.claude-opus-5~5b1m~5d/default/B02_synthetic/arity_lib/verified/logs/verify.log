 => panic!(\"bad MALLOC_FAIL_TARGET {other}\"),\n    };\n    println!(\"RESULT {which} mode={mode} C={cv} Rust={rv}\");\n    assert_eq!(cv, rv, \"malloc-failure mismatch for {which} mode {mode}\");","new_string":"    let (c, r) = both();\n    let which = std::env::var(\"MALLOC_FAIL_TARGET\").unwrap_or_else(|_| \"cmp\".into());\n    let p: [c_int; 4] = [7, -9, 3, 5];\n\n    // Each measurement is a *pair* of single-call windows. `set_mode` resets the\n    // shim's counter, so every window sees the same failure pattern; and two\n    // windows leave the allocator in its original state, which keeps the\n    // pass-through mode (`mode == 0`) comparison parity-invariant exactly like\n    // the in-process tests. Nothing allocates inside a window.\n    let call = |api: &common::Api| -> (c_int, c_int) {\n        let one = |api: &common::Api| unsafe {\n            set_mode(mode);\n            let v = match which.as_str() {\n                \"cmp\" => (api.compare_allocations)(1, 2),\n                \"arity4\" => (api.arity4)(p[0], p[1], p[2], p[3]),\n                \"arity2\" => (api.arity2)(p[0], p[1]),\n                \"arity3\" => (api.arity3)(p[0], p[1], p[2]),\n                \"arity\" => (api.arity)(4, p.as_ptr()),\n                other => panic!(\"bad MALLOC_FAIL_TARGET {other}\"),\n            };\n            set_mode(0);\n            v\n        };\n        (one(api), one(api))\n    };\n\n    let cv = call(c);\n    let rv = call(r);\n    println!(\"RESULT {which} mode={mode} C={},{} Rust={},{}\", cv.0, cv.1, rv.0, rv.1);\n    assert_eq!(cv, rv, \"malloc-failure mismatch for {which} mode {mode}\");"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":814,"cache_read_input_tokens":122522,"cache_creation":{"ephemeral_5m_input_tokens":814,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fbb3b3de-b324-47ff