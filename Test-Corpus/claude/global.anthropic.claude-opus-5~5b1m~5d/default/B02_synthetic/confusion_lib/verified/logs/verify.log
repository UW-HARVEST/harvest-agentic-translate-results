e original library.\n39\t// ---------------------------------------------------------------------------\n40\tunsafe extern \"C\" {\n41\t    fn malloc(size: usize) -> *mut c_void;\n42\t    fn free(ptr: *mut c_void);\n43\t    fn printf(fmt: *const c_char, ...) -> c_int;\n44\t    fn snprintf(s: *mut c_char, n: usize, fmt: *const c_char, ...) -> c_int;\n45\t    fn strlen(s: *const c_char) -> usize;\n46\t    fn memchr(s: *const c_void, c: c_int, n: usize) -> *mut c_void;\n47\t}\n48\t\n49\t// ---------------------------------------------------------------------------\n50\t// typedef struct { unsigned int flag1:1, flag2:1, flag3:1, counter:5,\n51\t//                               mode:3, status:5, reserved:16; } PackedFlags;\n52\t//\n53\t// System V / GCC on little-endian targets allocates bit-fields from the least\n54\t// significant bit of the storage unit upwards, so the layout of the single\n55\t// 32-bit allocation unit is:\n56\t//\n57\t//   bit  0      flag1\n58\t//   bit  1      flag2\n59\t//   bit  2      flag3\n60\t//   bits 3..8   counter  (5 bits)\n61\t//   bits 8..11  mode     (3 bits)\n62\t//   bits 11..16 status   (5 bits)\n63\t//   bits 16..32 reserved (16 bits)\n64\t// ---------------------------------------------------------------------------\n65\t#[repr(C)]\n66\t#[derive(Clone, Copy)]\n67\tpub struct PackedFlags {\n68\t    bits: u32,\n69\t}\n70\t\n71\tmacro_rules! bitfield {\n72\t    ($get:ident, $set:ident, $offset:expr, $width:expr) => {\n73\t        #[inline]\n74\t        fn $get(&self) -> c_uint {\n75\t            ((self.bits >> $offset) & ((1u32 << $width) - 1)) as c_uint\n76\t        }\n77\t        #[inline]\n78\t        fn $set(&mut self, value: c_uint) {\n79\t            let mask: u32 = ((1u32 << $width) - 1) << $offset;\n80\t            self.bits = (self.bits & !mask) | (((value as u32) << $offset) & mask);\n81\t        }\n82\t    };\n83\t}\n84\t\n85\t#[allow(dead_code)]\n86\timpl PackedFlags {\n87\t    bitfield!(flag1, set_flag1, 0, 1);\n88\t    bitfield!(flag2, set_flag2, 1, 1);\n89\t    bitfield!(flag3, set_flag3, 2, 1);\n90\t    bitfield!(counter, set_counter, 3, 5);\n91\t    bitfield!(mode, set_mode, 8, 3);\n92\t    bitfield!(status, set_status, 11, 5);\n93\t    bitfield!(reserved, set_reserved, 16, 16);\n94\t}\n95\t\n96\t// ---------------------------------------------------------------------------\n97\t// typedef union { int int_val; float float_val; unsigned int uint_val;\n98\t//                 char bytes[4]; } TypeConfusion;\n99\t//\n100\t// All four members occupy the same four bytes; the union is modelled as the\n101\t// raw 32-bit storage and every member is a reinterpretation of those bytes.\n102\t// ---------------------------------------------------------------------------\n103\t#[repr(C)]\n104\t#[derive(Clone, Copy)]\n105\tpub struct TypeConfusion {\n106\t    raw: u32,\n107\t}\n108\t\n109\timpl TypeConfusion {\n110\t    #[inline]\n111\t    fn int_val(&self) -> c_int {\n112\t        self.raw as c_int\n113\t    }\n114\t    #[inline]\n115\t    fn set_int_val(&mut self, value: c_int) {\n116\t        self.raw = value as u32;\n117\t    }\n118\t    #[inline]\n119\t    fn float_val(&self) -> f32 {\n120\t        f32::from_bits(self.raw)\n121\t    }\n122\t    #[inline]\n123\t    fn uint_val(&self) -> c_uint {\n124\t        self.raw as c_uint\n125\t    }\n126\t    #[inline]\n127\t    fn bytes(&self) -> [c_char; 4] {\n128\t        let b = self.raw.to_ne_bytes();\n129\t        [\n130\t            b[0] as c_char,\n131\t            b[1] as c_char,\n132\t            b[2] as c_char,\n133\t            b[3] as c_char,\n134\t        ]\n135\t    }\n136\t}\n137\t\n138\t// ---------------------------------------------------------------------------\n139\t// typedef struct { PackedFlags flags; TypeConfusion data;\n140\t//                  char* buffer; int capacity; } ProcessState;\n141\t//\n142\t// offsetof: flags 0, data 4, buffer 8, capacity 16; sizeof 24, alignof 8.\n143\t// ---------------------------------------------------------------------------\n144\t#[repr(C)]\n145\tpub struct ProcessState {\n146\t    flags: PackedFlags,\n147\t    data: TypeConfusion,\n148\t    buffer: *mut c_char,\n149\t    capacity: c_int,\n150\t}\n151\t\n152\t/// Reproduces the x86-64 `(int)float` conversion (`cvttss2si`) that GCC emits,\n153\t/// including the \"integer indefinite\" result for NaN / out-of-range values.\n154\t/// Rust's `as` would saturate instead, which does not match the C code.\n155\t#[inline]\n156\tfn f32_to_c_int(value: f32) -> c_int {\n157\t    let truncated = value.trunc();\n158\t    if truncated.is_nan()\n159\t        || truncated >= 2147483648.0_f32\n160\t        || truncated < -2147483648.0_f32\n161\t    {\n162\t        c_int::MIN\n163\t    } else {\n164\t        truncated as c_int\n165\t    }\n166\t}\n167\t\n168\t// ---------------------------------------------------------------------------\n169\t// ProcessState* create_state(int initial_val, int capacity)\n170\t// ---------------------------------------------------------------------------\n171\t#[unsafe(no_mangle)]\n172\tpub unsafe extern \"C\" fn create_state(initial_val: c_int, capacity: c_int) -> *mut ProcessState {\n173\t    let state = unsafe { malloc(size_of::<ProcessState>()) } as *mut ProcessState;\n174\t\n175\t    if state.is_null() {\n176\t        unsafe { printf(c\"Error: Failed to allocate memory for state\\n\".as_ptr()) };\n177\t        return ptr::null_mut();\n178\t    }\n179\t\n180\t    // The bit-field assignments below cover every bit of the 32-bit allocation\n181\t    // unit, so the resulting word is fully determined (0x00007b05) exactly as\n182\t    // in the C original, which read-modify-writes the malloc'd storage.\n183\t    let mut flags = PackedFlags { bits: 0 };\n184\t    flags.set_flag1(1);\n185\t    flags.set_flag2(0);\n186\t    flags.set_flag3(1);\n187\t    flags.set_counter(0);\n188\t    flags.set_mode(3);\n189\t    flags.set_status(15);\n190\t    flags.set_reserved(0);\n191\t    unsafe {