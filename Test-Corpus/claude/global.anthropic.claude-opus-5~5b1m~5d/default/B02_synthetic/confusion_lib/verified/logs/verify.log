)]\n240\tpub unsafe extern \"C\" fn process_buffer(state: *mut ProcessState, target: c_char) -> c_int {\n241\t    if state.is_null() || unsafe { (*state).buffer }.is_null() {\n242\t        unsafe { printf(c\"Error: Null pointer in process_buffer\\n\".as_ptr()) };\n243\t        return -1;\n244\t    }\n245\t\n246\t    let mut count: c_int = 0;\n247\t    let mut ptr_cur: *mut c_char = unsafe { (*state).buffer };\n248\t    let mut remaining: usize = unsafe { strlen((*state).buffer) };\n249\t\n250\t    while remaining > 0 {\n251\t        let found = unsafe { memchr(ptr_cur as *const c_void, target as c_int, remaining) }\n252\t            as *mut c_char;\n253\t\n254\t        if found.is_null() {\n255\t            break;\n256\t        }\n257\t\n258\t        count = count.wrapping_add(1);\n259\t        unsafe {\n260\t            printf(\n261\t                c\"Operation: memchr_found with value %d\\n\".as_ptr(),\n262\t                count as c_int,\n263\t            )\n264\t        };\n265\t\n266\t        let consumed = (found as usize - ptr_cur as usize) + 1;\n267\t        remaining = remaining.wrapping_sub(consumed);\n268\t        ptr_cur = unsafe { found.add(1) };\n269\t    }\n270\t\n271\t    count\n272\t}\n273\t\n274\t// ---------------------------------------------------------------------------\n275\t// void update_flags(ProcessState* state, int param)\n276\t// ---------------------------------------------------------------------------\n277\t#[unsafe(no_mangle)]\n278\tpub unsafe extern \"C\" fn update_flags(state: *mut ProcessState, param: c_int) {\n279\t    if state.is_null() {\n280\t        return;\n281\t    }\n282\t\n283\t    let state_ref = unsafe { &mut *state };\n284\t\n285\t    // 5-bit counter\n286\t    let next_counter = (state_ref.flags.counter() as c_int).wrapping_add(1) & 0x1F;\n287\t    state_ref.flags.set_counter(next_counter as c_uint);\n288\t    state_ref.flags.set_flag1((param & 1) as c_uint);\n289\t    state_ref.flags.set_flag2(((param & 2) >> 1) as