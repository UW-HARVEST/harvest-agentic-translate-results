  buffer[n] = 0;\n214\t}\n215\t\n216\t/// `int memchra2(int a, int b, int c, int d)` — the library's only exported\n217\t/// symbol.\n218\t#[unsafe(no_mangle)]\n219\tpub extern \"C\" fn memchra2(a: c_int, b: c_int, c: c_int, d: c_int) -> c_int {\n220\t    let mut result: c_int = 0;\n221\t\n222\t    // char buffer[64];\n223\t    // snprintf(buffer, sizeof(buffer), \"test%d-%d-%d-%d\", a, b, c, d);\n224\t    let mut buffer = [0u8; 64];\n225\t    let mut formatted = String::new();\n226\t    let _ = write!(formatted, \"test{}-{}-{}-{}\", a, b, c, d);\n227\t    snprintf_into(&mut buffer, &formatted);\n228\t\n229\t    let dash_count = count_occurrences(Some(&buffer), b'-');\n230\t    result = result.wrapping_add(dash_count.wrapping_mul(10));\n231\t\n232\t    let values: [c_int; 4] = [a, b, c, d];\n233\t    let sum = safe_sum_array(Some(&values), 4);\n234\t    result = result.wrapping_add(sum);\n235\t\n236\t    let test_strings: [Option<&[u8]>; 4] = [\n237\t        Some(b\"test1\\0\"),\n238\t        Some(b\"test2\\0\"),\n239\t        Some(b\"testing\\0\"),\n240\t        Some(b\"other\\0\"),\n241\t    ];\n242\t\n243\t    let matches = process_strings(Some(&test_strings), 4, b\"test\");\n244\t    result = result.wrapping_add(matches.wrapping_mul(5));\n245\t\n246\t    let f = int_to_float_bits(a);\n247\t    if f > 0.0f32 && f < 1000.0f32 {\n248\t        // (int)f — truncation toward zero; f is known to be in (0, 1000) here.\n249\t        result = result.wrapping_add(f as c_int);\n250\t    }\n251\t\n252\t    // int buf_sum = process_buffer(buffer, strlen(buffer));\n253\t    let buf_len = buffer.iter().position(|&x| x == 0).unwrap_or(buffer.len());\n254\t    let buf_sum = process_buffer(Some(&buffer), buf_len);\n255\t    if buf_sum > 0 {\n256\t        result = result.wrapping_add(buf_sum % 256);\n257\t    }\n258\t\n259\t    let mut bytes = [0u8; 4];\n260\t    bytes[0] = (b & 0xFF) as u8;\n261\t    bytes[1] = (c & 0xFF) as u8;\n262\t    bytes[2] = (d & 0xFF) as u8;\n263\t    byt