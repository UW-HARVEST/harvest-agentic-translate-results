151\t        None => return 0,\n152\t        Some(b) => {\n153\t            if len < std::mem::size_of::<c_int>() {\n154\t                return 0;\n155\t            }\n156\t            b\n157\t        }\n158\t    };\n159\t\n160\t    let mut raw = [0u8; 4];\n161\t    raw.copy_from_slice(&bytes[..4]);\n162\t    c_int::from_le_bytes(raw)\n163\t}\n164\t\n165\t/// `static int count_occurrences(const char *text, char ch)`\n166\tfn count_occurrences(text: Option<&[u8]>, ch: u8) -> c_int {\n167\t    let text = match text {\n168\t        None => return 0,\n169\t        Some(t) => {\n170\t            if t.first().copied().unwrap_or(0) == 0 {\n171\t                return 0;\n172\t            }\n173\t            t\n174\t        }\n175\t    };\n176\t\n177\t    // size_t len = strlen(text);\n178\t    let len = text.iter().position(|&b| b == 0).unwrap_or(text.len());\n179\t    memchra(text, ch as c_int, len)\n180\t}\n181\t\n182\t/// `static int complex_iteration(int *data, size_t count)`\n183\tfn complex_iteration(data: Option<&[c_int]>, count: usize) -> c_int {\n184\t    let data = match data {\n185\t        None => return -1,\n186\t        Some(d) => {\n187\t            if count == 0 {\n188\t                return -1;\n189\t            }\n190\t            d\n191\t        }\n192\t    };\n193\t\n194\t    let mut result: c_int = 0;\n195\t    for idx in 0..count {\n196\t        let u = data[idx] as u32;\n197\t        result ^= (u & 0xFF) as c_int;\n198\t    }\n199\t    result\n200\t}\n201\t\n202\t/// Emulates `snprintf(buffer, size, ...)` into a fixed-size C character array:\n203\t/// at most `size - 1` bytes of `text` are copied and a NUL terminator is\n204\t/// always appended (when `size != 0`).\n205\tfn snprintf_into(buffer: &mut [u8], text: &str) {\n206\t    let size = buffer.len();\n207\t    if size == 0 {\n208\t        return;\n209\t    }\n210\t    let src = text.as_bytes();\n211\t    let n = src.len().min(size - 1);\n212\t    buffer[..n].copy_from_slice(&src[..n]);\n213\t  