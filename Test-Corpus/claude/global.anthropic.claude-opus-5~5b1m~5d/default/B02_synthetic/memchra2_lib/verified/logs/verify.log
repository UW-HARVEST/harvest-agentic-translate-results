37\t/// `static int memchra(const char *str, int c, size_t n)`\n38\t///\n39\t/// Counts how many of the first `n` bytes of `str` equal `(char)c`.\n40\t/// The C comparison is performed after truncating `c` to `char`, so only the\n41\t/// low 8 bits of `c` participate.\n42\tfn memchra(str_: &[u8], c: c_int, n: usize) -> c_int {\n43\t    let mut count: c_int = 0;\n44\t    let needle = c as u8; // (char)c — narrowing conversion, compared bitwise\n45\t    for i in 0..n {\n46\t        if str_[i] == needle {\n47\t            count = count.wrapping_add(1);\n48\t        }\n49\t    }\n50\t    count\n51\t}\n52\t\n53\t/// `static int process_buffer(char *buffer, size_t len)`\n54\t///\n55\t/// Returns -1 for a NULL or empty buffer, otherwise the sum of the byte values\n56\t/// (as signed `char`, i.e. sign-extended on x86-64) up to `len` bytes or the\n57\t/// first NUL, whichever comes first.\n58\tfn process_buffer(buffer: Option<&[u8]>, len: usize) -> c_int {\n59\t    let buffer = match buffer {\n60\t        None => return -1,\n61\t        Some(b) => {\n62\t            // `*buffer == '\\0'`\n63\t            if b.first().copied().unwrap_or(0) == 0 {\n64\t                return -1;\n65\t            }\n66\t            b\n67\t        }\n68\t    };\n69\t\n70\t    let mut result: c_int = 0;\n71\t    for idx in 0..len {\n72\t        let byte = buffer[idx];\n73\t        if byte == 0 {\n74\t            break;\n75\t        }\n76\t        // `result += (int)(*i)` where `*i` has type `char` (signed on x86-64).\n77\t        result = result.wrapping_add(byte as i8 as c_int);\n78\t    }\n79\t    result\n80\t}\n81\t\n82\t/// `static float int_to_float_bits(int value)`\n83\t///\n84\t/// Type pun through a union: reinterprets the object representation of an\n85\t/// `int` as a `float`.\n86\tfn int_to_float_bits(value: c_int) -> f32 {\n87\t    f32::from_bits(value as u32)\n88\t}\n89\t\n90\t/// `static int process_strings(char **strings, int count, const char *target)`\n91\t///\n92\t/// Counts the