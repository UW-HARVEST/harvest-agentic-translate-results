49\t    parent_id: 0,\n50\t    left_child_id: 0,\n51\t    right_child_id: 0,\n52\t    label: [0; 32],\n53\t};\n54\t\n55\t// `TreeNode node_table[MAX_NODES];` and `int node_count = 0;` are non-static\n56\t// definitions in the C translation unit, so they are part of the exported ABI.\n57\t#[unsafe(no_mangle)]\n58\tpub static mut node_table: [TreeNode; MAX_NODES] = [EMPTY_NODE; MAX_NODES];\n59\t\n60\t#[unsafe(no_mangle)]\n61\tpub static mut node_count: c_int = 0;\n62\t\n63\t#[inline]\n64\tfn table_ptr() -> *mut TreeNode {\n65\t    ptr::addr_of_mut!(node_table) as *mut TreeNode\n66\t}\n67\t\n68\t// ---------------------------------------------------------------------------\n69\t// libc helpers, replicated so that byte-level behaviour matches exactly.\n70\t// ---------------------------------------------------------------------------\n71\t\n72\t/// `strchr(s, c)` — the terminating NUL is part of the searched string.\n73\tunsafe fn c_strchr(s: *const c_char, c: c_int) -> *const c_char {\n74\t    let needle = c as u8 as c_char;\n75\t    let mut p = s;\n76\t    loop {\n77\t        let cur = *p;\n78\t        if cur == needle {\n79\t            return p;\n80\t        }\n81\t        if cur == 0 {\n82\t            return ptr::null();\n83\t        }\n84\t        p = p.add(1);\n85\t    }\n86\t}\n87\t\n88\t/// `strncpy(dst, src, n)` — copies at most `n` bytes, stops reading after the\n89\t/// source NUL, and NUL-pads the remainder of the destination.\n90\tunsafe fn c_strncpy(dst: *mut c_char, src: *const c_char, n: usize) {\n91\t    let mut i = 0usize;\n92\t    while i < n {\n93\t        let ch = *src.add(i);\n94\t        *dst.add(i) = ch;\n95\t        if ch == 0 {\n96\t            break;\n97\t        }\n98\t        i += 1;\n99\t    }\n100\t    while i < n {\n101\t        *dst.add(i) = 0;\n102\t        i += 1;\n103\t    }\n104\t}\n105\t\n106\t// ---------------------------------------------------------------------------\n107\t// Operation implementations\n108\t// ----------------