{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_yk7riiumjnnic2nqp7m446hnnobkouvjkygughlaas5wmi7hexja","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01JR82YAWScTyGxxoHthZKWp","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-Iq61VS/translation/tests/phase_b_valid.rs","content":"//! Phase B — valid-path differential tests, one test per `CONFIGS.md` row.\n//! Every call crosses the FFI boundary into BOTH the C `.so` and the Rust `.so`.\n\nmod common;\nuse common::*;\nuse std::ffi::c_int;\n\nconst SEED: u64 = 0xC0FFEE_1234_5678;\n\n// ---------------------------------------------------------------------------\n// C1..C5 — create_block: name shapes and the full `flags` domain\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_c1_create_block_empty_name() {\n    let mut rng = Rng::new(SEED ^ 1);\n    for i in 0..500 {\n        diff_create_block(&format!(\"C1[{}]\", i), rng.i32(), b\"\", rng.u8());\n    }\n    // Explicit boundary ids too.\n    for id in [0, 1, -1, i32::MIN, i32::MAX] {\n        for flags in [0u8, 1, 0x7F, 0x80, 0xFF] {\n            diff_create_block(\"C1/boundary\", id, b\"\", flags);\n        }\n    }\n}\n\n#[test]\nfn cfg_c2_create_block_len1() {\n    let mut rng = Rng::new(SEED ^ 2);\n    for i in 0..500 {\n        let ch = [rng.u8() | 1]; // any non-NUL byte\n        diff_create_block(&format!(\"C2[{}]\", i), rng.i32(), &ch, rng.u8());\n    }\n    for id in [i32::MIN, i32::MAX, 0] {\n        diff_create_block(\"C2/boundary\", id, b\"A\", 0xAA);\n    }\n}\n\n#[test]\nfn cfg_c3_create_block_mid_len() {\n    let mut rng = Rng::new(SEED ^ 3);\n    for i in 0..2000 {\n        let len = rng.range_usize(2, 30);\n        let mut name = Vec::with_capacity(len);\n        for _ in 0..len {\n            name.push(rng.u8() | 1); // non-NUL so strlen == len\n        }\n        diff_create_block(&format!(\"C3[{}] len={}\", i, len), rng.i32(), &name, rng.u8());\n    }\n}\n\n#[test]\nfn cfg_c4_create_block_len31() {\n    let mut rng = Rng::new(SEED ^ 4);\n    for i in 0..500 {\n        let mut name = [0u8; 31];\n        for b in name.iter_mut() {\n            *b = rng.u8() | 1;\n        }\n        // strcpy writes 31 bytes + NUL == exactly the whole array.\n        diff_create_block(&format!(\"C4[{}]\", i), rng.i32(), &name, rng.u8());\n    }\n}\n\n#[test]\nfn cfg_c5_create_block_all_flags() {\n    for f in 0u16..=255 {\n        diff_create_block(&format!(\"C5 flags={}\", f), 42, b\"Block_Alpha\", f as u8);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// C6..C10 — allocate_block / free_block: count and init_value shapes\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_c6_allocate_zero_count() {\n    let mut rng = Rng::new(SEED ^ 6);\n    for i in 0..200 {\n        let snap = diff_allocate(&format!(\"C6[{}]\", i), 0, rng.i32())\n            .expect(\"calloc(0,4) returns a unique non-NULL pointer\");\n        assert_eq!(snap.0, 0, \"size must be 0\");\n        assert!(!snap.2, \"data must be non-NULL for count == 0\");\n        assert!(snap.1.is_empty());\n    }\n}\n\n#[test]\nfn cfg_c7_allocate_one() {\n    let mut rng = Rng::new(SEED ^ 7);\n    for init in [0, 1, -1, 7, -7, i32::MIN, i32::MAX, i32::MAX - 1] {\n        let s = diff_allocate(\"C7/boundary\", 1, init).expect(\"non-NULL\");\n        assert_eq!(s.1, vec![init]);\n    }\n    for i in 0..1000 {\n        diff_allocate(&format!(\"C7[{}]\", i), 1, rng.i32());\n    }\n}\n\n#[test]\nfn cfg_c8_allocate_many() {\n    let mut rng = Rng::new(SEED ^ 8);\n    for i in 0..1500 {\n        let count = rng.range_usize(2, 64);\n        diff_allocate(&format!(\"C8[{}] count={}\", i, count), count, rng.i32());\n    }\n    // Deliberate wrap-around inits with many elements.\n    for init in [i32::MAX - 3, i32::MIN + 3, -1, -64, 0] {\n        for count in [2usize, 3, 5, 14, 63, 64] {\n            diff_allocate(\"C8/boundary\", count, init);\n        }\n    }\n}\n\n#[test]\nfn cfg_c9_allocate_large() {\n    for count in [4096usize, 65536, 1 << 20] {\n        for init in [0, -1, i32::MAX, i32::MIN] {\n            let s = diff_allocate(&format!(\"C9 count={} init={}\", count, init), count, init)\n                .expect(\"allocatable\");\n            assert_eq!(s.0, count);\n            assert_eq!(s.1.len(), count);\n        }\n    }\n}\n\n#[test]\nfn cfg_c10_allocate_wrap_at_int_max() {\n    // init_value + i is computed in size_t and truncated to int, so the\n    // sequence wraps from INT_MAX to INT_MIN.\n    let s = diff_allocate(\"C10\", 8, i32::MAX - 2).expect(\"non-NULL\");\n    assert_eq!(\n        s.1,\n        vec![\n            i32::MAX - 2,\n            i32::MAX - 1,\n            i32::MAX,\n            i32::MIN,\n            i32::MIN + 1,\n            i32::MIN + 2,\n            i32::MIN + 3,\n            i32::MIN + 4\n        ]\n    );\n    // Negative init crossing zero.\n    let s = diff_allocate(\"C10/neg\", 6, -3).expect(\"non-NULL\");\n    assert_eq!(s.1, vec![-3, -2, -1, 0, 1, 2]);\n}\n\n// ---------------------------------------------------------------------------\n// C11..C15 — compute_hash: all 9 pointer-ordering combinations\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_c11_compute_hash_9_orderings() {\n    // Two `MemoryBlock`s in a known address order, plus three data pointers in\n    // a known order, lets us hit every (data cmp) x (struct cmp) combination.\n    let mut arena: Vec<MemoryBlock> = vec![\n        MemoryBlock {\n            data: std::ptr::null_mut(),\n            size: 0\n        };\n        2\n    ];\n    let lo_ptr = arena.as_mut_ptr();\n    let hi_ptr = unsafe { arena.as_mut_ptr().add(1) };\n    assert!(lo_ptr < hi_ptr);\n\n    let mut ints: Vec<c_int> = vec![0; 4];\n    let d_lo = ints.as_mut_ptr();\n    let d_hi = unsafe { ints.as_mut_ptr().add(2) };\n    assert!(d_lo < d_hi);\n\n    // (data ordering, struct ordering) -> expected hash\n    let data_cases: [(*mut c_int, *mut c_int, c_int); 3] =\n        [(d_lo, d_hi, 100), (d_hi, d_lo, 200), (d_lo, d_lo, 0)];\n    let struct_cases: [(bool, bool, c_int); 3] = [\n        (false, true, 10),  // mb1 = lo, mb2 = hi  => mb1 < mb2\n        (true, false, 20),  // mb1 = hi, mb2 = lo  => mb1 > mb2\n        (false, false, 0),  // mb1 == mb2\n    ];\n\n    for (d1, d2, dh) in data_cases {\n        for (s1_hi, s2_hi, sh) in struct_cases {\n            let a = if s1_hi { hi_ptr } else { lo_ptr };\n            let b = if s2_hi { hi_ptr } else { lo_ptr };\n            unsafe {\n                // When a == b the single struct can only carry one data ptr;\n                // the C reads mb1->data and mb2->data from the same object, so\n                // the data comparison degenerates to \"equal\".\n                (*a).data = d1;\n                (*b).data = d2;\n                let expect_data = if a == b {\n                    0\n                } else if (*a).data < (*b).data {\n                    100\n                } else if (*a).data > (*b).data {\n                    200\n                } else {\n                    0\n                };\n                let _ = dh;\n                diff_compute_hash(\n                    &format!(\"C11 a_hi={} b_hi={}\", s1_hi, s2_hi),\n                    a,\n                    b,\n                    Some(expect_data + sh),\n                );\n            }\n        }\n    }\n}\n\n#[test]\nfn cfg_c12_c13_c14_compute_hash_randomized_orderings() {\n    // Randomised addresses from a larger arena so the < / > / == branches on\n    // BOTH pointers are hit in every combination, many times.\n    let mut rng = Rng::new(SEED ^ 11);\n    let mut arena: Vec<MemoryBlock> = vec![\n        MemoryBlock {\n            data: std::ptr::null_mut(),\n            size: 0\n        };\n        16\n    ];\n    let mut ints: Vec<c_int> = vec![0; 16];\n    let base = arena.as_mut_ptr();\n    let ibase = ints.as_mut_ptr();\n\n    for i in 0..3000 {\n        let ia = rng.range_usize(0, 15);\n        let ib = rng.range_usize(0, 15);\n        let da = rng.range_usize(0, 15);\n        let db = rng.range_usize(0, 15);\n        unsafe {\n            let a = base.add(ia);\n            let b = base.add(ib);\n            (*a).data = ibase.add(da);\n            (*a).size = rng.range_usize(0, 99);\n            (*b).data = ibase.add(db);\n            (*b).size = rng.range_usize(0, 99);\n\n            let dh = if (*a).data < (*b).data {\n                100\n            } else if (*a).data > (*b).data {\n                200\n            } else {\n                0\n            };\n            let sh = if a < b {\n                10\n            } else if a > b {\n                20\n            } else {\n                0\n            };\n            diff_compute_hash(&format!(\"C12-14[{}]\", i), a, b, Some(dh + sh));\n        }\n    }\n}\n\n#[test]\nfn cfg_c15_compute_hash_real_heap() {\n    // Operands produced by the library's own allocator, both argument orders.\n    // Each library hashes ITS OWN pair, so the comparison is of the resulting\n    // hash values, which is what `betagamma` observes.\n    let l = libs();\n    let mut rng = Rng::new(SEED ^ 15);\n    for i in 0..200 {\n        let n = rng.range_usize(0, 32);\n        unsafe {\n            let ca = (l.c.allocate_block)(n, rng.i32());\n            let cb = (l.c.allocate_block)(n, rng.i32());\n            let ra = (l.rs.allocate_block)(n, 1);\n            let rb = (l.rs.allocate_block)(n, 2);\n            assert!(!ca.is_null() && !cb.is_null() && !ra.is_null() && !rb.is_null());\n\n            let hc = (l.c.compute_hash)(ca, cb);\n            let hr = (l.rs.compute_hash)(ra, rb);\n            assert_eq!(\n                hc, hr,\n                \"C15[{}] forward: C={} Rust={} (heap ordering diverged)\",\n                i, hc, hr\n            );\n\n            let hc2 = (l.c.compute_hash)(cb, ca);\n            let hr2 = (l.rs.compute_hash)(rb, ra);\n            assert_eq!(hc2, hr2, \"C15[{}] reversed: C={} Rust={}\", i, hc2, hr2);\n            // Reversing must flip both comparisons.\n            assert_eq!(hc + hc2, 330, \"C15[{}] forward+reverse invariant\", i);\n\n            (l.c.free_block)(ca);\n            (l.c.free_block)(cb);\n            (l.rs.free_block)(ra);\n            (l.rs.free_block)(rb);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// C16..C19 — betagamma: every `param1 % 10` residue class\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_c16_betagamma_residue_sweep() {\n    let mut rng = Rng::new(SEED ^ 16);\n    // Cover every residue of param1 % 10 in {-9..9}: block_size in {-4..14}.\n    for r in -9i32..=9 {\n        let mut hits = 0;\n        for k in 0..60 {\n            let p1 = r + 10 * k * if r < 0 { -1 } else { 1 };\n            if p1 % 10 != r {\n                continue;\n            }\n            hits += 1;\n            let res = diff_betagamma((p1, rng.i32(), rng.i32(), rng.i32()));\n            let expect_err = (r % 10) + 5 < 0;\n            if expect_err {\n                assert_eq!(res, -1, \"residue {} (p1={}) must take the error path\", r, p1);\n            }\n            // small params too, so flag_contribution stays in range\n            diff_betagamma((\n                p1,\n                rng.range_i32(-40, 40),\n                rng.range_i32(-40, 40),\n                rng.range_i32(-40, 40),\n            ));\n        }\n        assert!(hits > 0, \"residue {} was never exercised\", r);\n    }\n}\n\n#[test]\nfn cfg_c20_betagamma_corner_vectors() {\n    // All-zero, +-1 on each axis, and INT_MIN/INT_MAX in every position.\n    diff_betagamma((0, 0, 0, 0));\n    let vals = [0i32, 1, -1, 2, -2, 10, -10, i32::MAX, i32::MIN, i32::MAX - 1, i32::MIN + 1];\n    for &a in &vals {\n        for &b in &vals {\n            diff_betagamma((a, b, 0, 0));\n            diff_betagamma((a, 0, b, 0));\n            diff_betagamma((a, 0, 0, b));\n            diff_betagamma((0, a, b, 0));\n            diff_betagamma((0, 0, a, b));\n        }\n    }\n}\n\n#[test]\nfn cfg_c23_betagamma_negative_division() {\n    // sum1 - sum2 negative and not a multiple of 10 => C truncates toward zero.\n    let mut rng = Rng::new(SEED ^ 23);\n    for _ in 0..2000 {\n        let p1 = rng.range_i32(0, 9) + 10 * rng.range_i32(0, 5); // block_size 5..14\n        let p2 = p1 + rng.range_i32(1, 97); // sum2 > sum1 => negative numerator\n        diff_betagamma((p1, p2, rng.range_i32(-20, 20), rng.range_i32(-20, 20)));\n    }\n    // Hand-picked: difference of -1..-9 and -11..-19 (truncation visible).\n    for d in 1..=19 {\n        diff_betagamma((5, 5 + d, 0, 0));\n        diff_betagamma((5, 5 - d, 0, 0));\n    }\n}\n\n#[test]\nfn cfg_c24_betagamma_equal_params() {\n    // param1 == param2 => identical element sums => (sum1-sum2)/10 == 0.\n    for p in [0i32, 1, -1, 5, -5, 9, -9, 1234, -1234, i32::MAX, i32::MIN] {\n        diff_betagamma((p, p, p, p));\n        diff_betagamma((p, p, 0, 0));\n    }\n}\n\n#[test]\nfn cfg_c25_betagamma_overflow_sums() {\n    // Large magnitudes so sum1/sum2 and result overflow inside the C loops.\n    let big = [\n        1 << 30,\n        -(1 << 30),\n        1 << 24,\n        -(1 << 24),\n        i32::MAX,\n        i32::MIN,\n        i32::MAX / 3,\n        i32::MIN / 3,\n    ];\n    for &a in &big {\n        for &b in &big {\n            for &c in &big {\n                diff_betagamma((a, b, c, 0));\n                diff_betagamma((a, b, 0, c));\n            }\n        }\n    }\n}\n\n#[test]\nfn cfg_c26_betagamma_random_full_range() {\n    let mut rng = Rng::new(SEED ^ 26);\n    for _ in 0..4000 {\n        diff_betagamma((rng.i32(), rng.i32(), rng.i32(), rng.i32()));\n    }\n}\n\n#[test]\nfn cfg_c27_betagamma_random_small() {\n    let mut rng = Rng::new(SEED ^ 27);\n    for _ in 0..4000 {\n        diff_betagamma((\n            rng.range_i32(-50, 50),\n            rng.range_i32(-50, 50),\n            rng.range_i32(-50, 50),\n            rng.range_i32(-50, 50),\n        ));\n    }\n    // Exhaustive over the small square that drives every flags mask.\n    for a in -12i32..=12 {\n        for b in -3i32..=3 {\n            diff_betagamma((a, b, -b, b));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// C28..C30 — composed pipeline / multi-block / ABI\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_c28_manual_pipeline() {\n    // Re-drive the exact low-level pipeline `betagamma` composes, from the\n    // test, on both libraries: allocate, hash, sum, free.\n    let l = libs();\n    let mut rng = Rng::new(SEED ^ 28);\n    for i in 0..500 {\n        let p1 = rng.range_i32(-1000, 1000);\n        let p2 = rng.range_i32(-1000, 1000);\n        let bs = (p1 % 10) + 5;\n        if bs < 0 {\n            continue; // error path is Phase C\n        }\n        let bs = bs as usize;\n        unsafe {\n            let c1 = (l.c.allocate_block)(bs, p1);\n            let c2 = (l.c.allocate_block)(bs, p2);\n            let r1 = (l.rs.allocate_block)(bs, p1);\n            let r2 = (l.rs.allocate_block)(bs, p2);\n            assert!(!c1.is_null() && !c2.is_null() && !r1.is_null() && !r2.is_null());\n\n            let hc = (l.c.compute_hash)(c1, c2);\n            let hr = (l.rs.compute_hash)(r1, r2);\n            assert_eq!(hc, hr, \"C28[{}] hash\", i);\n\n            let mut cs1: c_int = 0;\n            let mut cs2: c_int = 0;\n            let mut rs1: c_int = 0;\n            let mut rs2: c_int = 0;\n            for k in 0..bs {\n                cs1 = cs1.wrapping_add(*(*c1).data.add(k));\n                cs2 = cs2.wrapping_add(*(*c2).data.add(k));\n                rs1 = rs1.wrapping_add(*(*r1).data.add(k));\n                rs2 = rs2.wrapping_add(*(*r2).data.add(k));\n            }\n            assert_eq!((cs1, cs2), (rs1, rs2), \"C28[{}] sums\", i);\n            assert_eq!((*c1).size, (*r1).size, \"C28[{}] size1\", i);\n            assert_eq!((*c2).size, (*r2).size, \"C28[{}] size2\", i);\n\n            (l.c.free_block)(c1);\n            (l.c.free_block)(c2);\n            (l.rs.free_block)(r1);\n            (l.rs.free_block)(r2);\n        }\n        // And the one-shot wrapper must agree with itself across libs.\n        diff_betagamma((p1, p2, rng.range_i32(-9, 9), rng.range_i32(-9, 9)));\n    }\n}\n\n#[test]\nfn cfg_c29_multi_block_pairwise() {\n    // Many live blocks at once, pairwise hashes, freed in reverse order.\n    let l = libs();\n    let mut rng = Rng::new(SEED ^ 29);\n    const N: usize = 8;\n    for round in 0..50 {\n        unsafe {\n            let mut cv = [std::ptr::null_mut(); N];\n            let mut rv = [std::ptr::null_mut(); N];\n            let counts: Vec<usize> = (0..N).map(|_| rng.range_usize(0, 20)).collect();\n            let inits: Vec<c_int> = (0..N).map(|_| rng.i32()).collect();\n            for k in 0..N {\n                cv[k] = (l.c.allocate_block)(counts[k], inits[k]);\n                rv[k] = (l.rs.allocate_block)(counts[k], inits[k]);\n                assert!(!cv[k].is_null() && !rv[k].is_null());\n                // element-wise identity\n                for j in 0..counts[k] {\n                    assert_eq!(\n                        *(*cv[k]).data.add(j),\n                        *(*rv[k]).data.add(j),\n                        \"C29 round {} block {} elem {}\",\n                        round,\n                        k,\n                        j\n                    );\n                }\n            }\n            // Self-consistent hashes: compare relative-order-derived value.\n            for a in 0..N {\n                for b in 0..N {\n                    let hc = (l.c.compute_hash)(cv[a], cv[b]);\n                    let hr = (l.rs.compute_hash)(rv[a], rv[b]);\n                    // The hash encodes ordering only; a==b must give 0 in both.\n                    if a == b {\n                        assert_eq!(hc, 0, \"C29 self-hash C\");\n                        assert_eq!(hr, 0, \"C29 self-hash Rust\");\n                    }\n                    // Cross-library: also verify each library agrees when given\n                    // the *other* library's blocks (pure pointer arithmetic).\n                    let x = (l.c.compute_hash)(cv[a], rv[b]);\n                    let y = (l.rs.compute_hash)(cv[a], rv[b]);\n                    assert_eq!(x, y, \"C29 mixed operands round {} {} {}\", round, a, b);\n                }\n            }\n            for k in (0..N).rev() {\n                (l.c.free_block)(cv[k]);\n                (l.rs.free_block)(rv[k]);\n            }\n        }\n    }\n}\n\n#[test]\nfn cfg_c30_abi_layout() {\n    assert_eq!(std::mem::size_of::<DataBlock>(), 40, \"DataBlock size\");\n    assert_eq!(std::mem::align_of::<DataBlock>(), 4, \"DataBlock align\");\n    assert_eq!(std::mem::size_of::<MemoryBlock>(), 16, \"MemoryBlock size\");\n    assert_eq!(std::mem::align_of::<MemoryBlock>(), 8, \"MemoryBlock align\");\n\n    // sret return path: both libs must fill id/name/flags at the same offsets.\n    let l = libs();\n    unsafe {\n        let c = (l.c.create_block)(0x11223344, b\"Layout\\0\".as_ptr(), 0x5A);\n        let r = (l.rs.create_block)(0x11223344, b\"Layout\\0\".as_ptr(), 0x5A);\n        assert_datablock_eq(\"C30\", &c, &r, 7);\n        assert_eq!(c.id, 0x11223344);\n        assert_eq!(&c.name[..7], b\"Layout\\0\");\n        assert_eq!(c.flags, 0x5A);\n\n        // MemoryBlock read back through the FFI at the same offsets.\n        let cm = (l.c.allocate_block)(3, 7);\n        let rm = (l.rs.allocate_block)(3, 7);\n        assert_eq!((*cm).size, 3);\n        assert_eq!((*rm).size, 3);\n        assert_eq!([*(*cm).data, *(*cm).data.add(1), *(*cm).data.add(2)], [7, 8, 9]);\n        assert_eq!([*(*rm).data, *(*rm).data.add(1), *(*rm).data.add(2)], [7, 8, 9]);\n        (l.c.free_block)(cm);\n        (l.rs.free_block)(rm);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4773,"cache_read_input_tokens":41014,"cache_creation":{"ephemeral_5m_input_tokens":4773,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"425fa0a8-ee71-4fe0-b59e-ddf257611f7b","uuid":"1380083b-126d-4d94-94b3-50244a70f6b5","timestamp":"2026-09-05T13:17:32.163Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JR82YAWScTyGxxoHthZKWp","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-Iq61VS/translation/tests/phase_b_valid.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"425fa0a8-ee71-4fe0-b59e-ddf257611f7b","uuid":"0af85e8b-6d41-4d7d-83e7-578df4422815","timestamp":"2026-09-05T13:17:32.178Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-Iq61VS/translation/tests/phase_b_valid.rs","content":"//! Phase B — valid-path differential tests, one test per `CONFIGS.md` row.\n//! Every call crosses the FFI boundary into BOTH the C `.so` and the Rust `.so`.\n\nmod common;\nuse common::*;\nuse std::ffi::c_int;\n\nconst SEED: u64 = 0xC0FFEE_1234_5678;\n\n// ---------------------------------------------------------------------------\n// C1..C5 — create_block: name shapes and the full `flags` domain\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_c1_create_block_empty_name() {\n    let mut rng = Rng::new(SEED ^ 1);\n    for i in 0..500 {\n        diff_create_block(&format!(\"C1[{}]\", i), rng.i32(), b\"\", rng.u8());\n    }\n    // Explicit boundary ids too.\n    for id in [0, 1, -1, i32::MIN, i32::MAX] {\n        for flags in [0u8, 1, 0x7F, 0x80, 0xFF] {\n            diff_create_block(\"C1/boundary\", id, b\"\", flags);\n        }\n    }\n}\n\n#[test]\nfn cfg_c2_create_block_len1() {\n    let mut rng = Rng::new(SEED ^ 2);\n    for i in 0..500 {\n        let ch = [rng.u8() | 1]; // any non-NUL byte\n        diff_create_block(&format!(\"C2[{}]\", i), rng.i32(), &ch, rng.u8());\n    }\n    for id in [i32::MIN, i32::MAX, 0] {\n        diff_create_block(\"C2/boundary\", id, b\"A\", 0xAA);\n    }\n}\n\n#[test]\nfn cfg_c3_create_block_mid_len() {\n    let mut rng = Rng::new(SEED ^ 3);\n    for i in 0..2000 {\n        let len = rng.range_usize(2, 30);\n        let mut name = Vec::with_capacity(len);\n        for _ in 0..len {\n            name.push(rng.u8() | 1); // non-NUL so strlen == len\n        }\n        diff_create_block(&format!(\"C3[{}] len={}\", i, len), rng.i32(), &name, rng.u8());\n    }\n}\n\n#[test]\nfn cfg_c4_create_block_len31() {\n    let mut rng = Rng::new(SEED ^ 4);\n    for i in 0..500 {\n        let mut name = [0u8; 31];\n        for b in name.iter_mut() {\n            *b = rng.u8() | 1;\n        }\n        // strcpy writes 31 bytes + NUL == exactly the whole array.\n        diff_create_block(&format!(\"C4[{}]\", i), rng.i32(), &name, rng.u8());\n    }\n}\n\n#[test]\nfn cfg_c5_create_block_all_flags() {\n    for f in 0u16..=255 {\n        diff_create_block(&format!(\"C5 flags={}\", f), 42, b\"Block_Alpha\", f as u8);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// C6..C10 — allocate_block / free_block: count and init_value shapes\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_c6_allocate_zero_count() {\n    let mut rng = Rng::new(SEED ^ 6);\n    for i in 0..200 {\n        let snap = diff_allocate(&format!(\"C6[{}]\", i), 0, rng.i32())\n            .expect(\"calloc(0,4) returns a unique non-NULL pointer\");\n        assert_eq!(snap.0, 0, \"size must be 0\");\n        assert!(!snap.2, \"data must be non-NULL for count == 0\");\n        assert!(snap.1.is_empty());\n    }\n}\n\n#[test]\nfn cfg_c7_allocate_one() {\n    let mut rng = Rng::new(SEED ^ 7);\n    for init in [0, 1, -1, 7, -7, i32::MIN, i32::MAX, i32::MAX - 1] {\n        let s = diff_allocate(\"C7/boundary\", 1, init).expect(\"non-NULL\");\n        assert_eq!(s.1, vec![init]);\n    }\n    for i in 0..1000 {\n        diff_allocate(&format!(\"C7[{}]\", i), 1, rng.i32());\n    }\n}\n\n#[test]\nfn cfg_c8_allocate_many() {\n    let mut rng = Rng::new(SEED ^ 8);\n    for i in 0..1500 {\n        let count = rng.range_usize(2, 64);\n        diff_allocate(&format!(\"C8[{}] count={}\", i, count), count, rng.i32());\n    }\n    // Deliberate wrap-around inits with many elements.\n    for init in [i32::MAX - 3, i32::MIN + 3, -1, -64, 0] {\n        for count in [2usize, 3, 5, 14, 63, 64] {\n            diff_allocate(\"C8/boundary\", count, init);\n        }\n    }\n}\n\n#[test]\nfn cfg_c9_allocate_large() {\n    for count in [4096usize, 65536, 1 << 20] {\n        for init in [0, -1, i32::MAX, i32::MIN] {\n            let s = diff_allocate(&format!(\"C9 count={} init={}\", count, init), count, init)\n                .expect(\"allocatable\");\n            assert_eq!(s.0, count);\n            assert_eq!(s.1.len(), count);\n        }\n    }\n}\n\n#[test]\nfn cfg_c10_allocate_wrap_at_int_max() {\n    // init_value + i is computed in size_t and truncated to int, so the\n    // sequence wraps from INT_MAX to INT_MIN.\n    let s = diff_allocate(\"C10\", 8, i32::MAX - 2).expect(\"non-NULL\");\n    assert_eq!(\n        s.1,\n        vec![\n            i32::MAX - 2,\n            i32::MAX - 1,\n            i32::MAX,\n            i32::MIN,\n            i32::MIN + 1,\n            i32::MIN + 2,\n            i32::MIN + 3,\n            i32::MIN + 4\n        ]\n    );\n    // Negative init crossing zero.\n    let s = diff_allocate(\"C10/neg\", 6, -3).expect(\"non-NULL\");\n    assert_eq!(s.1, vec![-3, -2, -1, 0, 1, 2]);\n}\n\n// ---------------------------------------------------------------------------\n// C11..C15 — compute_hash: all 9 pointer-ordering combinations\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_c11_compute_hash_9_orderings() {\n    // Two `MemoryBlock`s in a known address order, plus three data pointers in\n    // a known order, lets us hit every (data cmp) x (struct cmp) combination.\n    let mut arena: Vec<MemoryBlock> = vec![\n        MemoryBlock {\n            data: std::ptr::null_mut(),\n            size: 0\n        };\n        2\n    ];\n    let lo_ptr = arena.as_mut_ptr();\n    let hi_ptr = unsafe { arena.as_mut_ptr().add(1) };\n    assert!(lo_ptr < hi_ptr);\n\n    let mut ints: Vec<c_int> = vec![0; 4];\n    let d_lo = ints.as_mut_ptr();\n    let d_hi = unsafe { ints.as_mut_ptr().add(2) };\n    assert!(d_lo < d_hi);\n\n    // (data ordering, struct ordering) -> expected hash\n    let data_cases: [(*mut c_int, *mut c_int, c_int); 3] =\n        [(d_lo, d_hi, 100), (d_hi, d_lo, 200), (d_lo, d_lo, 0)];\n    let struct_cases: [(bool, bool, c_int); 3] = [\n        (false, true, 10),  // mb1 = lo, mb2 = hi  => mb1 < mb2\n        (true, false, 20),  // mb1 = hi, mb2 = lo  => mb1 > mb2\n        (false, false, 0),  // mb1 == mb2\n    ];\n\n    for (d1, d2, dh) in data_cases {\n        for (s1_hi, s2_hi, sh) in struct_cases {\n            let a = if s1_hi { hi_ptr } else { lo_ptr };\n            let b = if s2_hi { hi_ptr } else { lo_ptr };\n            unsafe {\n                // When a == b the single struct can only carry one data ptr;\n                // the C reads mb1->data and mb2->data from the same object, so\n                // the data comparison degenerates to \"equal\".\n                (*a).data = d1;\n                (*b).data = d2;\n                let expect_data = if a == b {\n                    0\n                } else if (*a).data < (*b).data {\n                    100\n                } else if (*a).data > (*b).data {\n                    200\n                } else {\n                    0\n                };\n                let _ = dh;\n                diff_compute_hash(\n                    &format!(\"C11 a_hi={} b_hi={}\", s1_hi, s2_hi),\n                    a,\n                    b,\n                    Some(expect_data + sh),\n                );\n            }\n        }\n    }\n}\n\n#[test]\nfn cfg_c12_c13_c14_compute_hash_randomized_orderings() {\n    // Randomised addresses from a larger arena so the < / > / == branches on\n    // BOTH pointers are hit in every combination, many times.\n    let mut rng = Rng::new(SEED ^ 11);\n    let mut arena: Vec<MemoryBlock> = vec![\n        MemoryBlock {\n            data: std::ptr::null_mut(),\n            size: 0\n        };\n        16\n    ];\n    let mut ints: Vec<c_int> = vec![0; 16];\n    let base = arena.as_mut_ptr();\n    let ibase = ints.as_mut_ptr();\n\n    for i in 0..3000 {\n        let ia = rng.range_usize(0, 15);\n        let ib = rng.range_usize(0, 15);\n        let da = rng.range_usize(0, 15);\n        let db = rng.range_usize(0, 15);\n        unsafe {\n            let a = base.add(ia);\n            let b = base.add(ib);\n            (*a).data = ibase.add(da);\n            (*a).size = rng.range_usize(0, 99);\n            (*b).data = ibase.add(db);\n            (*b).size = rng.range_usize(0, 99);\n\n            let dh = if (*a).data < (*b).data {\n                100\n            } else if (*a).data > (*b).data {\n                200\n            } else {\n                0\n            };\n            let sh = if a < b {\n                10\n            } else if a > b {\n                20\n            } else {\n                0\n            };\n            diff_compute_hash(&format!(\"C12-14[{}]\", i), a, b, Some(dh + sh));\n        }\n    }\n}\n\n#[test]\nfn cfg_c15_compute_hash_real_heap() {\n    // Operands produced by the library's own allocator, both argument orders.\n    // Each library hashes ITS OWN pair, so the comparison is of the resulting\n    // hash values, which is what `betagamma` observes.\n    let l = libs();\n    let mut rng = Rng::new(SEED ^ 15);\n    for i in 0..200 {\n        let n = rng.range_usize(0, 32);\n        unsafe {\n            let ca = (l.c.allocate_block)(n, rng.i32());\n            let cb = (l.c.allocate_block)(n, rng.i32());\n            let ra = (l.rs.allocate_block)(n, 1);\n            let rb = (l.rs.allocate_block)(n, 2);\n            assert!(!ca.is_null() && !cb.is_null() && !ra.is_null() && !rb.is_null());\n\n            let hc = (l.c.compute_hash)(ca, cb);\n            let hr = (l.rs.compute_hash)(ra, rb);\n            assert_eq!(\n                hc, hr,\n                \"C15[{}] forward: C={} Rust={} (heap ordering diverged)\",\n                i, hc, hr\n            );\n\n            let hc2 = (l.c.compute_hash)(cb, ca);\n            let hr2 = (l.rs.compute_hash)(rb, ra);\n            assert_eq!(hc2, hr2, \"C15[{}] reversed: C={} Rust={}\", i, hc2, hr2);\n            // Reversing must flip both comparisons.\n            assert_eq!(hc + hc2, 330, \"C15[{}] forward+reverse invariant\", i);\n\n            (l.c.free_block)(ca);\n            (l.c.free_block)(cb);\n            (l.rs.free_block)(ra);\n            (l.rs.free_block)(rb);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// C16..C19 — betagamma: every `param1 % 10` residue class\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_c16_betagamma_residue_sweep() {\n    let mut rng = Rng::new(SEED ^ 16);\n    // Cover every residue of param1 % 10 in {-9..9}: block_size in {-4..14}.\n    for r in -9i32..=9 {\n        let mut hits = 0;\n        for k in 0..60 {\n            let p1 = r + 10 * k * if r < 0 { -1 } else { 1 };\n            if p1 % 10 != r {\n                continue;\n            }\n            hits += 1;\n            let res = diff_betagamma((p1, rng.i32(), rng.i32(), rng.i32()));\n            let expect_err = (r % 10) + 5 < 0;\n            if expect_err {\n                assert_eq!(res, -1, \"residue {} (p1={}) must take the error path\", r, p1);\n            }\n            // small params too, so flag_contribution stays in range\n            diff_betagamma((\n                p1,\n                rng.range_i32(-40, 40),\n                rng.range_i32(-40, 40),\n                rng.range_i32(-40, 40),\n            ));\n        }\n        assert!(hits > 0, \"residue {} was never exercised\", r);\n    }\n}\n\n#[test]\nfn cfg_c20_betagamma_corner_vectors() {\n    // All-zero, +-1 on each axis, and INT_MIN/INT_MAX in every position.\n    diff_betagamma((0, 0, 0, 0));\n    let vals = [0i32, 1, -1, 2, -2, 10, -10, i32::MAX, i32::MIN, i32::MAX - 1, i32::MIN + 1];\n    for &a in &vals {\n        for &b in &vals {\n            diff_betagamma((a, b, 0, 0));\n            diff_betagamma((a, 0, b, 0));\n            diff_betagamma((a, 0, 0, b));\n            diff_betagamma((0, a, b, 0));\n            diff_betagamma((0, 0, a, b));\n        }\n    }\n}\n\n#[test]\nfn cfg_c23_betagamma_negative_division() {\n    // sum1 - sum2 negative and not a multiple of 10 => C truncates toward zero.\n    let mut rng = Rng::new(SEED ^ 23);\n    for _ in 0..2000 {\n        let p1 = rng.range_i32(0, 9) + 10 * rng.range_i32(0, 5); // block_size 5..14\n        let p2 = p1 + rng.range_i32(1, 97); // sum2 > sum1 => negative numerator\n        diff_betagamma((p1, p2, rng.range_i32(-20, 20), rng.range_i32(-20, 20)));\n    }\n    // Hand-picked: difference of -1..-9 and -11..-19 (truncation visible).\n    for d in 1..=19 {\n        diff_betagamma((5, 5 + d, 0, 0));\n        diff_betagamma((5, 5 - d, 0, 0));\n    }\n}\n\n#[test]\nfn cfg_c24_betagamma_equal_params() {\n    // param1 == param2 => identical element sums => (sum1-sum2)/10 == 0.\n    for p in [0i32, 1, -1, 5, -5, 9, -9, 1234, -1234, i32::MAX, i32::MIN] {\n        diff_betagamma((p, p, p, p));\n        diff_betagamma((p, p, 0, 0));\n    }\n}\n\n#[test]\nfn cfg_c25_betagamma_overflow_sums() {\n    // Large magnitudes so sum1/sum2 and result overflow inside the C loops.\n    let big = [\n        1 << 30,\n        -(1 << 30),\n        1 << 24,\n        -(1 << 24),\n        i32::MAX,\n        i32::MIN,\n        i32::MAX / 3,\n        i32::MIN / 3,\n    ];\n    for &a in &big {\n        for &b in &big {\n            for &c in &big {\n                diff_betagamma((a, b, c, 0));\n                diff_betagamma((a, b, 0, c));\n            }\n        }\n    }\n}\n\n#[test]\nfn cfg_c26_betagamma_random_full_range() {\n    let mut rng = Rng::new(SEED ^ 26);\n    for _ in 0..4000 {\n        diff_betagamma((rng.i32(), rng.i32(), rng.i32(), rng.i32()));\n    }\n}\n\n#[test]\nfn cfg_c27_betagamma_random_small() {\n    let mut rng = Rng::new(SEED ^ 27);\n    for _ in 0..4000 {\n        diff_betagamma((\n            rng.range_i32(-50, 50),\n            rng.range_i32(-50, 50),\n            rng.range_i32(-50, 50),\n            rng.range_i32(-50, 50),\n        ));\n    }\n    // Exhaustive over the small square that drives every flags mask.\n    for a in -12i32..=12 {\n        for b in -3i32..=3 {\n            diff_betagamma((a, b, -b, b));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// C28..C30 — composed pipeline / multi-block / ABI\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_c28_manual_pipeline() {\n    // Re-drive the exact low-level pipeline `betagamma` composes, from the\n    // test, on both libraries: allocate, hash, sum, free.\n    let l = libs();\n    let mut rng = Rng::new(SEED ^ 28);\n    for i in 0..500 {\n        let p1 = rng.range_i32(-1000, 1000);\n        let p2 = rng.range_i32(-1000, 1000);\n        let bs = (p1 % 10) + 5;\n        if bs < 0 {\n            continue; // error path is Phase C\n        }\n        let bs = bs as usize;\n        unsafe {\n            let c1 = (l.c.allocate_block)(bs, p1);\n            let c2 = (l.c.allocate_block)(bs, p2);\n            let r1 = (l.rs.allocate_block)(bs, p1);\n            let r2 = (l.rs.allocate_block)(bs, p2);\n            assert!(!c1.is_null() && !c2.is_null() && !r1.is_null() && !r2.is_null());\n\n            let hc = (l.c.compute_hash)(c1, c2);\n            let hr = (l.rs.compute_hash)(r1, r2);\n            assert_eq!(hc, hr, \"C28[{}] hash\", i);\n\n            let mut cs1: c_int = 0;\n            let mut cs2: c_int = 0;\n            let mut rs1: c_int = 0;\n            let mut rs2: c_int = 0;\n            for k in 0..bs {\n                cs1 = cs1.wrapping_add(*(*c1).data.add(k));\n                cs2 = cs2.wrapping_add(*(*c2).data.add(k));\n                rs1 = rs1.wrapping_add(*(*r1).data.add(k));\n                rs2 = rs2.wrapping_add(*(*r2).data.add(k));\n            }\n            assert_eq!((cs1, cs2), (rs1, rs2), \"C28[{}] sums\", i);\n            assert_eq!((*c1).size, (*r1).size, \"C28[{}] size1\", i);\n            assert_eq!((*c2).size, (*r2).size, \"C28[{}] size2\", i);\n\n            (l.c.free_block)(c1);\n            (l.c.free_block)(c2);\n            (l.rs.free_block)(r1);\n            (l.rs.free_block)(r2);\n        }\n        // And the one-shot wrapper must agree with itself across libs.\n        diff_betagamma((p1, p2, rng.range_i32(-9, 9), rng.range_i32(-9, 9)));\n    }\n}\n\n#[test]\nfn cfg_c29_multi_block_pairwise() {\n    // Many live blocks at once, pairwise hashes, freed in reverse order.\n    let l = libs();\n    let mut rng = Rng::new(SEED ^ 29);\n    const N: usize = 8;\n    for round in 0..50 {\n        unsafe {\n            let mut cv = [std::ptr::null_mut(); N];\n            let mut rv = [std::ptr::null_mut(); N];\n            let counts: Vec<usize> = (0..N).map(|_| rng.range_usize(0, 20)).collect();\n            let inits: Vec<c_int> = (0..N).map(|_| rng.i32()).collect();\n            for k in 0..N {\n                cv[k] = (l.c.allocate_block)(counts[k], inits[k]);\n                rv[k] = (l.rs.allocate_block)(counts[k], inits[k]);\n                assert!(!cv[k].is_null() && !rv[k].is_null());\n                // element-wise identity\n                for j in 0..counts[k] {\n                    assert_eq!(\n                        *(*cv[k]).data.add(j),\n                        *(*rv[k]).data.add(j),\n                        \"C29 round {} block {} elem {}\",\n                        round,\n                        k,\n                        j\n                    );\n                }\n            }\n            // Self-consistent hashes: compare relative-order-derived value.\n            for a in 0..N {\n                for b in 0..N {\n                    let hc = (l.c.compute_hash)(cv[a], cv[b]);\n                    let hr = (l.rs.compute_hash)(rv[a], rv[b]);\n                    // The hash encodes ordering only; a==b must give 0 in both.\n                    if a == b {\n                        assert_eq!(hc, 0, \"C29 self-hash C\");\n                        assert_eq!(hr, 0, \"C29 self-hash Rust\");\n                    }\n                    // Cross-library: also verify each library agrees when given\n                    // the *other* library's blocks (pure pointer arithmetic).\n                    let x = (l.c.compute_hash)(cv[a], rv[b]);\n                    let y = (l.rs.compute_hash)(cv[a], rv[b]);\n                    assert_eq!(x, y, \"C29 mixed operands round {} {} {}\", round, a, b);\n                }\n            }\n            for k in (0..N).rev() {\n                (l.c.free_block)(cv[k]);\n                (l.rs.free_block)(rv[k]);\n            }\n        }\n    }\n}\n\n#[test]\nfn cfg_c30_abi_layout() {\n    assert_eq!(std::mem::size_of::<DataBlock>(), 40, \"DataBlock size\");\n    assert_eq!(std::mem::align_of::<DataBlock>(), 4, \"DataBlock align\");\n    assert_eq!(std::mem::size_of::<MemoryBlock>(), 16, \"MemoryBlock size\");\n    assert_eq!(std::mem::align_of::<MemoryBlock>(), 8, \"MemoryBlock align\");\n\n    // sret return path: both libs must fill id/name/flags at the same offsets.\n    let l = libs();\n    unsafe {\n        let c = (l.c.create_block)(0x11223344, b\"Layout\\0\".as_ptr(), 0x5A);\n        let r = (l.rs.create_block)(0x11223344, b\"Layout\\0\".as_ptr(), 0x5A);\n        assert_datablock_eq(\"C30\", &c, &r, 7);\n        assert_eq!(c.id, 0x11223344);\n        assert_eq!(&c.name[..7], b\"Layout\\0\");\n        assert_eq!(c.flags, 0x5A);\n\n        // MemoryBlock read back through the FFI at the same offsets.\n        let cm = (l.c.allocate_block)(3, 7);\n        let rm = (l.rs.allocate_block)(3, 7);\n        assert_eq!((*cm).size, 3);\n        assert_eq!((*rm).size, 3);\n        assert_eq!([*(*cm).data, *(*cm).data.add(1), *(*cm).data.add(2)], [7, 8, 9]);\n        assert_eq!([*(*rm).data, *(*rm).data.add(1), *(*rm).data.add(2)], [7, 8, 9]);\n        (l.c.free_block)(cm);\n        (l.rs.free_block)(rm);\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
