sing exactly the same allocator as the C build,\n39\t// so malloc/calloc/free are used directly rather than Rust's allocator.\n40\t// ---------------------------------------------------------------------------\n41\textern \"C\" {\n42\t    fn malloc(size: usize) -> *mut c_void;\n43\t    fn calloc(nmemb: usize, size: usize) -> *mut c_void;\n44\t    fn free(ptr: *mut c_void);\n45\t    fn strcpy(dest: *mut c_char, src: *const c_char) -> *mut c_char;\n46\t}\n47\t\n48\t// typedef struct {\n49\t//     int id;\n50\t//     char name[32];\n51\t//     uint8_t flags;\n52\t// } DataBlock;\n53\t#[repr(C)]\n54\t#[derive(Clone, Copy)]\n55\tpub struct DataBlock {\n56\t    pub id: c_int,\n57\t    pub name: [c_char; 32],\n58\t    pub flags: u8,\n59\t}\n60\t\n61\t// typedef struct {\n62\t//     int *data;\n63\t//     size_t size;\n64\t// } MemoryBlock;\n65\t#[repr(C)]\n66\t#[derive(Clone, Copy)]\n67\tpub struct MemoryBlock {\n68\t    pub data: *mut c_int,\n69\t    pub size: usize,\n70\t}\n71\t\n72\t/// Build a `DataBlock` literal the way the C initialisers do:\n73\t/// `{id, \"literal\", flags}` zero-fills the remainder of `name`.\n74\tconst fn data_block_lit(id: c_int, name: &[u8], flags: u8) -> DataBlock {\n75\t    let mut buf = [0 as c_char; 32];\n76\t    let mut i = 0usize;\n77\t    while i < name.len() {\n78\t        buf[i] = name[i] as c_char;\n79\t        i += 1;\n80\t    }\n81\t    DataBlock {\n82\t        id,\n83\t        name: buf,\n84\t        flags,\n85\t    }\n86\t}\n87\t\n88\t// ---------------------------------------------------------------------------\n89\t// DataBlock create_block(int id, const char *name, uint8_t flags)\n90\t// ---------------------------------------------------------------------------\n91\t#[unsafe(no_mangle)]\n92\tpub unsafe extern \"C\" fn create_block(id: c_int, name: *const c_char, flags: u8) -> DataBlock {\n93\t    // DataBlock block;  -- deliberately left uninitialised, exactly as in C.\n94\t    let mut block: MaybeUninit<DataBlock> = MaybeUninit::uninit();\n95\t    let p = block.as_mut_ptr();\n96\t\n97\t    // block.id = id;\n98\t    core::ptr::addr_of_mut!((*p).id).write(id);\n99\t\n100\t    // strcpy(block.name, name);\n101\t    strcpy(core::ptr::addr_of_mut!((*p).name) as *mut c_char, name);\n102\t\n103\t    // block.flags = flags;\n104\t    core::ptr::addr_of_mut!((*p).flags).write(flags);\n105\t\n106\t    // return block;\n107\t    block.assume_init()\n108\t}\n109\t\n110\t// ---------------------------------------------------------------------------\n111\t// MemoryBlock* allocate_block(size_t count, int init_value)\n112\t// ---------------------------------------------------------------------------\n113\t#[unsafe(no_mangle)]\n114\tpub unsafe extern \"C\" fn allocate_block(count: usize, init_value: c_int) -> *mut MemoryBlock {\n115\t    let mb = malloc(core::mem::size_of::<MemoryBlock>()) as *mut MemoryBlock;\n116\t    if mb.is_null() {\n117\t        return core::ptr::null_mut();\n118\t    }\n119\t\n120\t    let data = calloc(count, core::mem::size_of::<c_int>()) as *mut c_int;\n121\t    core::ptr::addr_of_mut!((*mb).data).write(data);\n122\t    if data.is_null() {\n123\t        free(mb as *mut c_void);\n124\t        return core::ptr::null_mut();\n125\t    }\n126\t\n127\t    core::ptr::addr_of_mut!((*mb).size).write(count);\n128\t\n129\t    // for (size_t i = 0; i < count; i++) mb->data[i] = init_value + i;\n130\t    //\n131\t    // `init_value + i` is computed in size_t (the int operand is converted\n132\t    // to the unsigned type) and then truncated on assignment to int.\n133\t    let mut i: usize = 0;\n134\t    while i < count {\n135\t        let v = (init_value as usize).wrapping_add(i);\n136\t        data.add(i).write(v as u32 as c_int);\n137\t        i += 1;\n138\t    }\n139\t\n140\t    mb\n141\t}\n142\t\n143\t// ---------------------------------------------------------------------------\n144\t// void free_block(MemoryBlock *mb)\n145\t// -------------------------------------------------------