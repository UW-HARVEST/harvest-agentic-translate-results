_t tree_height)\n94\t    93\t{\n95\t    94\t    ((unsigned char *)addr)[SPX_OFFSET_TREE_HGT] = (unsigned char)tree_height;\n96\t    95\t}\n97\t    96\t\n98\t    97\t/*\n99\t    98\t * Specify the distance from the left edge of the node in the Merkle/FORS tree\n100\t    99\t * (the tree index)\n101\t   100\t */\n102\t   101\tvoid set_tree_index(uint32_t addr[8], uint32_t tree_index)\n103\t   102\t{\n104\t   103\t    u32_to_bytes(&((unsigned char *)addr)[SPX_OFFSET_TREE_INDEX], tree_index );\n105\t   104\t}\n106\t===== utils.c =====\n107\t     1\t#include <string.h>\n108\t     2\t\n109\t     3\t#include \"../include/address.h\"\n110\t     4\t#include \"../include/hash.h\"\n111\t     5\t#include \"../include/params.h\"\n112\t     6\t#include \"../include/thash.h\"\n113\t     7\t#include \"../include/utils.h\"\n114\t     8\t\n115\t     9\t/**\n116\t    10\t * Converts the value of 'in' to 'outlen' bytes in big-endian byte order.\n117\t    11\t */\n118\t    12\tvoid ull_to_bytes(unsigned char *out, unsigned int outlen,\n119\t    13\t                  unsigned long long in)\n120\t    14\t{\n121\t    15\t    int i;\n122\t    16\t\n123\t    17\t    /* Iterate over out in decreasing order, for big-endianness. */\n124\t    18\t    for (i = (signed int)outlen - 1; i >= 0; i--) {\n125\t    19\t        out[i] = in & 0xff;\n126\t    20\t        in = in >> 8;\n127\t    21\t    }\n128\t    22\t}\n129\t    23\t\n130\t    24\tvoid u32_to_bytes(unsigned char *out, uint32_t in)\n131\t    25\t{\n132\t    26\t    out[0] = (unsigned char)(in >> 24);\n133\t    27\t    out[1] = (unsigned char)(in >> 16);\n134\t    28\t    out[2] = (unsigned char)(in >> 8);\n135\t    29\t    out[3] = (unsigned char)in;\n136\t    30\t}\n137\t    31\t\n138\t    32\t/**\n139\t    33\t * Converts the inlen bytes in 'in' from big-endian byte order to an integer.\n140\t    34\t */\n141\t    35\tunsigned long long bytes_to_ull(const unsigned char *in, unsigned int inlen)\n142\t    36\t{\n143\t    37\t    unsigned long long retval = 0;\n144\t    38\t    unsigned int i;\n145\t    39\t\n146\t    40\t    for (i = 0; i < inlen; i++) {\n147\t    41\t        retval |= ((unsigned long long)in[i]) << (8*(inlen - 1 - i));\n148\t    42\t    }\n149\t    43\t    return retval;\n150\t    44\t}\n151\t    45\t\n152\t    46\t/**\n153\t    47\t * Computes a root node given a leaf and an auth path.\n154\t    48\t * Expects address to be complete other than the tree_height and tree_index.\n155\t    49\t */\n156\t    50\tvoid compute_root(unsigned char *root, const unsigned char *leaf,\n157\t    51\t                  uint32_t leaf_idx, uint32_t idx_offset,\n158\t    52\t                  const unsigned char *auth_path, uint32_t tree_height,\n159\t    53\t                  const spx_ctx *ctx, uint32_t addr[8])\n160\t    54\t{\n161\t    55\t    uint32_t i;\n162\t    56\t    unsigned char buffer[2 * SPX_N];\n163\t    57\t\n164\t    58\t    /* If leaf_idx is odd (last bit = 1), current path element is a right child\n165\t    59\t       and auth_path has to go left. Otherwise it is the other way around. */\n166\t    60\t    if (leaf_idx & 1) {\n167\t    61\t        memcpy(buffer + SPX_N, leaf, SPX_N);\n168\t    62\t        memcpy(buffer, auth_path, SPX_N);\n169\t    63\t    }\n170\t    64\t    else {\n171\t    65\t        memcpy(buffer, leaf, SPX_N);\n172\t    66\t        memcpy(buffer + SPX_N, auth_path, SPX_N);\n173\t    67\t    }\n174\t    68\t    auth_path += SPX_N;\n175\t    69\t\n176\t    70\t    for (i = 0; i < tree_height - 1; i++) {\n177\t    71\t        leaf_idx >>= 1;\n178\t    72\t        idx_offset >>= 1;\n179\t    73\t        /* Set the address of the node we're creating. */\n180\t    74\t        set_tree_height(addr, i + 1);\n181\t    75\t        set_tree_index(addr, leaf_idx + idx_offset);\n182\t    76\t\n183\t    77\t        /* Pick the right or left neighbor, depending on parity of the node. */\n184\t    78\t        if (leaf_idx & 1) {\n185\t    79\t            thash(buffer + SPX_N, buffer, 2, ctx, addr);\n186\t    80\t            memcpy(buffer, auth_path, SPX_N);\n187\t    81\t        }\n188\t    82\t        else {\n189\t    83\t            thash(buffer, buffer, 2, ctx, addr);\n190\t    84\t            memcpy(buffer + SPX_N, auth_path, SPX_N);\n191\t    85\t        }\n192\t    86\t        auth_path += SPX_N;\n193\t    87\t    }\n194\t    88\t\n195\t    89\t    /* The last iteration is exceptional; we do not copy an auth_path node. */\n196\t    90\t    leaf_idx >>= 1;\n197\t    91\t    idx_offset >>= 1;\n198\t    92\t    set_tree_height(addr, tree_height);\n199\t    93\t    set_tree_index(addr, leaf_idx + idx_offset);\n200\t    94\t    thash(root, buffer, 2, ctx, addr);\n201\t    95\t}\n202\t    96\t\n203\t    97\t/**\n204\t    98\t * For a given leaf index, computes the authentication path and the resulting\n205\t    99\t * root node using Merkle's TreeHash algorithm.\n206\t   100\t * Expects the layer and tree parts of the tree_addr to be set, as well as the\n207\t   101\t * tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE).\n208\t   102\t * Applies the offset idx_offset to indices before building addresses, so that\n209\t   103\t * it is possible to continue counting indices across trees.\n210\t   104\t */\n211\t   105\tvoid treehash(unsigned char *root, unsigned char *auth_path, const spx_ctx* ctx,\n212\t   106\t              uint32_t leaf_idx, uint32_t idx_offset, uint32_t tree_height,\n213\t   107\t              void (*gen_leaf)(\n214\t   108\t                 unsigned char* /* leaf */,\n215\t   109\t                 const spx_ctx* /* ctx */,\n216\t   110\t                 uint32_t /* addr_idx */, const uint32_t[8] /* tree_addr */),\n217\t   111\t              uint32_t tree_addr[8])\n218\t   112\t{\n219\t   113\t    SPX_VLA(uint8_t, stack, (tree_height+1)*SPX_N);\n220\t   114\t    SPX_VLA(unsigned int, heights, tree_height+1);\n221\t   115\t    unsigned int offset = 0;\n222\t   116\t    uint32_t idx;\n223\t   117\t    uint32_t tree_idx;\n224\t   118\t\n225\t   119\t    for (idx = 0; idx < (uint32_t)(1 << tree_height); idx++) {\n226\t   120\t        /* Add the next leaf node to the stack. */\n227\t   121\t        gen_leaf(stack + offset*SPX_N, ctx, idx + idx_offset, tree_addr);\n228\t   122\t        offset++;\n229\t   123\t        heights[offset - 1] = 0;\n230\t   124\t\n231\t   125\t        /* If this is a node we need for the auth path.. */\n232\t   126\t        if ((leaf_idx ^ 0x1) == idx) {\n233\t   127\t            memcpy(auth_path, stack + (offset - 1)*SPX_N, SPX_N);\n234\t   128\t        }\n235\t   129\t\n236\t   130\t        /* While the top-most nodes are of equal height.. */\n237\t   131\t        while (offset >= 2 && heights[offset - 1] == heights[offset - 2]) {\n238\t   132\t            /* Compute index of the new node, in the next layer. */\n239\t   133\t            tree_idx = (idx >> (heights[offset - 1] + 1));\n240\t   134\t\n241\t   135\t            /* Set the address of the node we're creating. */\n242\t   136\t            set_tree_height(tree_addr, heights[offset - 1] + 1);\n243\t   137\t            set_tree_index(tree_addr,\n244\t   138\t                           tree_idx + (idx_offset >> (heights[offset-1] + 1)));\n245\t   139\t            /* Hash the top-most nodes from the stack together. */\n246\t   140\t            thash(stack + (offset - 2)*SPX_N,\n247\t   141\t                  stack + (offset - 2)*SPX_N, 2, ctx, tree_addr);\n248\t   142\t            offset--;\n249\t   143\t            /* Note that the top-most node is now one layer higher. */\n250\t   144\t            heights[offset - 1]++;\n251\t   145\t\n252\t   146\t            /* If this is a node we need for the auth path.. */\n253\t   147\t            if (((leaf_idx >> heights[offset - 1]) ^ 0x1) == tree_idx) {\n254\t   148\t                memcpy(auth_path + heights[offset - 1]*SPX_N,\n255\t   149\t                       stack + (offset - 1)*SPX_N, SPX_N);\n256\t   150\t            }\n257\t   151\t        }\n258\t   152\t    }\n259\t   153\t    memcpy(root, stack, SPX_N);\n260\t   154\t}\n261\t===== utilsx1.c =====\n262\t     1\t#include <string.h>\n263\t     2\t\n264\t     3\t#include \"../include/address.h\"\n265\t     4\t#include \"../include/params.h\"\n266\t     5\t#include \"../include/forsx1.h\"\n267\t     6\t#include \"../include/thash.h\"\n268\t     7\t#include \"../include/utils.h\"\n269\t     8\t#include \"../include/utilsx1.h\"\n270\t     9\t\n271\t    10\t/*\n272\t    11\t * Generate the entire Merkle tree, computing the authentication path for\n273\t    12\t * leaf_idx, and the resulting root node using Merkle's TreeHash algorithm.\n274\t    13\t * Expects the layer and tree parts of the tree_addr to be set, as well as the\n275\t    14\t * tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE)\n276\t    15\t *\n277\t    16\t * This expects tree_addr to be initialized to the addr structures for the\n278\t    17\t * Merkle tree nodes\n279\t    18\t *\n280\t    19\t * Applies the offset idx_offset to indices before building addresses, so that\n281\t    20\t * it is possible to continue counting indices across trees.\n282\t    21\t *\n283\t    22\t * This works by using the standard Merkle tree building algorithm,\n284\t    23\t */\n285\t    24\tvoid wots_treehashx1(unsigned char *root, unsigned char *auth_path,\n286\t    25\t\t\t     const spx_ctx* ctx,\n287\t    26\t\t\t     uint32_t leaf_idx, uint32_t idx_offset,\n288\t    27\t\t\t     uint32_t tree_height,\n289\t    28\t\t\t     uint32_t tree_addr[8],\n290\t    29\t\t\t     leaf_info_x1 *info)\n291\t    30\t{\n292\t    31\t    /* This is where we keep the intermediate nodes */\n293\t    32\t    SPX_VLA(uint8_t, stack, tree_height*SPX_N);\n294\t    33\t\n295\t    34\t    uint32_t idx;\n296\t    35\t    uint32_t max_idx = (uint32_t)((1 << tree_height) - 1);\n297\t    36\t    for (idx = 0;; idx++) {\n298\t    37\t        unsigned char current[2*SPX_N];   /* Current logical node is at */\n299\t    38\t            /* index[SPX_N].  We do this to minimize the number of copies */\n300\t    39\t            /* needed during a thash */\n301\t    40\t        wots_gen_leafx1( &current[SPX_N], ctx, idx + idx_offset,\n302\t    41\t\t\t\t info );\n303\t    42\t\n304\t    43\t        /* Now combine the freshly generated right node with previously */\n305\t    44\t        /* generated left ones */\n306\t    45\t        uint32_t internal_idx_offset = idx_offset;\n307\t    46\t        uint32_t internal_idx = idx;\n308\t    47\t        uint32_t internal_leaf = leaf_idx;\n309\t    48\t        uint32_t h;     /* The height we are in the Merkle tree */\n310\t    49\t        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {\n311\t    50\t\n312\t    51\t            /* Check if we hit the top of the tree */\n313\t    52\t            if (h == tree_height) {\n314\t    53\t                /* We hit the root; return it */\n315\t    54\t                memcpy( root, &current[SPX_N], SPX_N );\n316\t    55\t                return;\n317\t    56\t            }\n318\t    57\t\n319\t    58\t            /*\n320\t    59\t             * Check if the node we have is a part of the\n321\t    60\t             * authentication path; if it is, write it out\n322\t    61\t             */\n323\t    62\t            if ((internal_idx ^ internal_leaf) == 0x01) {\n324\t    63\t                memcpy( &auth_path[ h * SPX_N ],\n325\t    64\t                        &current[SPX_N],\n326\t    65\t                        SPX_N );\n327\t    66\t            }\n328\t    67\t\n329\t    68\t            /*\n330\t    69\t             * Check if we're at a left child; if so, stop going up the stack\n331\t    70\t             * Exception: if we've reached the end of the tree, keep on going\n332\t    71\t             * (so we combine the last 4 nodes into the one root node in two\n333\t    72\t             * more iterations)\n334\t    73\t             */\n335\t    74\t            if ((internal_idx & 1) == 0 && idx < max_idx) {\n336\t    75\t                break;\n337\t    76\t            }\n338\t    77\t\n339\t    78\t            /* Ok, we're at a right node */\n340\t    79\t            /* Now combine the left and right logical nodes together */\n341\t    80\t\n342\t    81\t            /* Set the address of the node we're creating. */\n343\t    82\t            internal_idx_offset >>= 1;\n344\t    83\t            set_tree_height(tree_addr, h + 1);\n345\t    84\t            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\n346\t    85\t\n347\t    86\t            unsigned char *left = &stack[h * SPX_N];\n348\t    87\t            memcpy( &current[0], left, SPX_N );\n349\t    88\t            thash( &current[1 * SPX_N],\n350\t    89\t                   &current[0 * SPX_N],\n351\t    90\t                   2, ctx, tree_addr);\n352\t    91\t        }\n353\t    92\t\n354\t    93\t        /* We've hit a left child; save the current for when we get the */\n355\t    94\t        /* corresponding right right */\n356\t    95\t        memcpy( &stack[h * SPX_N], &current[SPX_N], SPX_N);\n357\t    96\t    }\n358\t    97\t}\n359\t    98\t\n360\t    99\tvoid fors_treehashx1(unsigned char *root, unsigned char *auth_path,\n361\t   100\t\t\t     const spx_ctx* ctx,\n362\t   101\t\t\t     uint32_t leaf_idx, uint32_t idx_offset,\n363\t   102\t\t\t     uint32_t tree_height,\n364\t   103\t\t\t     uint32_t tree_addr[8],\n365\t   104\t\t\t     leaf_info_x1 *info)\n366\t   105\t{\n367\t   106\t    /* This is where we keep the intermediate nodes */\n368\t   107\t    SPX_VLA(uint8_t, stack, tree_height*SPX_N);\n369\t   108\t\n370\t   109\t    uint32_t idx;\n371\t   110\t    uint32_t max_idx = (uint32_t)((1 << tree_height) - 1);\n372\t   111\t    for (idx = 0;; idx++) {\n373\t   112\t        unsigned char current[2*SPX_N];   /* Current logical node is at */\n374\t   113\t            /* index[SPX_N].  We do this to minimize the number of copies */\n375\t   114\t            /* needed during a thash */\n376\t   115\t\n377\t   116\t\t// IAN TODO: WARNING ON INFO PARAMETER\n378\t   117\t        fors_gen_leafx1( &current[SPX_N], ctx, idx + idx_offset,\n379\t   118\t\t\t\t info );\n380\t   119\t\n381\t   120\t        /* Now combine the freshly generated right node with previously */\n382\t   121\t        /* generated left ones */\n383\t   122\t        uint32_t internal_idx_offset = idx_offset;\n384\t   123\t        uint32_t internal_idx = idx;\n385\t   124\t        uint32_t internal_leaf = leaf_idx;\n386\t   125\t        uint32_t h;     /* The height we are in the Merkle tree */\n387\t   126\t        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {\n388\t   127\t\n389\t   128\t            /* Check if we hit the top of the tree */\n390\t   129\t            if (h == tree_height) {\n391\t   130\t                /* We hit the root; return it */\n392\t   131\t                memcpy( root, &current[SPX_N], SPX_N );\n393\t   132\t                return;\n394\t   133\t            }\n395\t   134\t\n396\t   135\t            /*\n397\t   136\t             * Check if the node we have is a part of the\n398\t   137\t             * authentication path; if it is, write it out\n399\t   138\t             */\n400\t   139\t            if ((internal_idx ^ internal_leaf) == 0x01) {\n401\t   140\t                memcpy( &auth_path[ h * SPX_N ],\n402\t   141\t                        &current[SPX_N],\n403\t   142\t                        SPX_N );\n404\t   143\t            }\n405\t   144\t\n406\t   145\t            /*\n407\t   146\t             * Check if we're at a left child; if so, stop going up the stack\n408\t   147\t             * Exception: if we've reached the end of the tree, keep on going\n409\t   148\t             * (so we combine the last 4 nodes into the one root node in two\n410\t   149\t             * more iterations)\n411\t   150\t             */\n412\t   151\t            if ((internal_idx & 1) == 0 && idx < max_idx) {\n413\t   152\t                break;\n414\t   153\t            }\n415\t   154\t\n416\t   155\t            /* Ok, we're at a right node */\n417\t   156\t            /* Now combine the left and right logical nodes together */\n418\t   157\t\n419\t   158\t            /* Set the address of the node we're creating. */\n420\t   159\t            internal_idx_offset >>= 1;\n421\t   160\t            set_tree_height(tree_addr, h + 1);\n422\t   161\t            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\n423\t   162\t\n424\t   163\t            unsigned char *left = &stack[h * SPX_N];\n425\t   164\t            memcpy( &current[0], left, SPX_N );\n426\t   165\t            thash( &current[1 * SPX_N],\n427\t   166\t                   &current[0 * SPX_N],\n428\t   167\t                   2, ctx, tree_addr);\n429\t   168\t        }\n430\t   169\t\n431\t   170\t        /* We've hit a left child; save the current for when we get the */\n432\t   171\t        /* corresponding right right */\n433\t   172\t        memcpy( &stack[h * SPX_N], &current[SPX_N], SPX_N);\n434\t   173\t    }\n435\t   174\t}\n436\t===== wots.c =====\n437\t     1\t#include <stdint.h>\n438\t     2\t#include <string.h>\n439\t     3\t\n440\t     4\t#include \"../include/address.h\"\n441\t     5\t#include \"../include/hash.h\"\n442\t     6\t#include \"../include/params.h\"\n443\t     7\t#include \"../include/thash.h\"\n444\t     8\t#include \"../include/utils.h\"\n445\t     9\t#include \"../include/utilsx1.h\"\n446\t    10\t#include \"../include/wots.h\"\n447\t    11\t#include \"../include/wotsx1.h\"\n448\t    12\t\n449\t    13\t// TODO clarify address expectations, and make them more uniform.\n450\t    14\t// TODO i.e. do we expect types to be set already?\n451\t    15\t// TODO and do we expect modifications or copies?\n452\t    16\t\n453\t    17\t/**\n454\t    18\t * Computes the chaining function.\n455\t    19\t * out and in have to be n-byte arrays.\n456\t    20\t *\n457\t    21\t * Interprets in as start-th value of the chain.\n458\t    22\t * addr has to contain the address of the chain.\n459\t    23\t */\n460\t    24\tstatic void gen_chain(unsigned char *out, const unsigned char *in,\n461\t    25\t                      unsigned int start, unsigned int steps,\n462\t    26\t                      const spx_ctx *ctx, uint32_t addr[8])\n463\t    27\t{\n464\t    28\t    uint32_t i;\n465\t    29\t\n466\t    30\t    /* Initialize out with the value at position 'start'. */\n467\t    31\t    memcpy(out, in, SPX_N);\n468\t    32\t\n469\t    33\t    /* Iterate 'steps' calls to the hash function. */\n470\t    34\t    for (i = start; i < (start+steps) && i < SPX_WOTS_W; i++) {\n471\t    35\t        set_hash_addr(addr, i);\n472\t    36\t        thash(out, out, 1, ctx, addr);\n473\t    37\t    }\n474\t    38\t}\n475\t    39\t\n476\t    40\t/**\n477\t    41\t * base_w algorithm as described in draft.\n478\t    42\t * Interprets an array of bytes as integers in base w.\n479\t    43\t * This only works when log_w is a divisor of 8.\n480\t    44\t */\n481\t    45\tstatic void base_w(unsigned int *output, const int out_len,\n482\t    46\t                   const unsigned char *input)\n483\t    47\t{\n484\t    48\t    int in = 0;\n485\t    49\t    int out = 0;\n486\t    50\t    unsigned char total;\n487\t    51\t    int bits = 0;\n488\t    52\t    int consumed;\n489\t    53\t\n490\t    54\t    for (consumed = 0; consumed < out_len; consumed++) {\n491\t    55\t        if (bits == 0) {\n492\t    56\t            total = input[in];\n493\t    57\t            in++;\n494\t    58\t            bits += 8;\n495\t    59\t        }\n496\t    60\t        bits -= SPX_WOTS_LOGW;\n497\t    61\t        output[out] = (total >> bits) & (SPX_WOTS_W - 1);\n498\t    62\t        out++;\n499\t    63\t    }\n500\t    64\t}\n501\t    65\t\n502\t    66\t/* Computes the WOTS+ checksum over a message (in base_w). */\n503\t    67\tstatic void wots_checksum(unsigned int *csum_base_w,\n504\t    68\t                          const unsigned int *msg_base_w)\n505\t    69\t{\n506\t    70\t    unsigned int csum = 0;\n507\t    71\t    unsigned char csum_bytes[(SPX_WOTS_LEN2 * SPX_WOTS_LOGW + 7) / 8];\n508\t    72\t    unsigned int i;\n509\t    73\t\n510\t    74\t    /* Compute checksum. */\n511\t    75\t    for (i = 0; i < SPX_WOTS_LEN1; i++) {\n512\t    76\t        csum += SPX_WOTS_W - 1 - msg_base_w[i];\n513\t    77\t    }\n514\t    78\t\n515\t    79\t    /* Convert checksum to base_w. */\n516\t    80\t    /* Make sure expected empty zero bits are the least significant bits. */\n517\t    81\t    csum = csum << ((8 - ((SPX_WOTS_LEN2 * SPX_WOTS_LOGW) % 8)) % 8);\n518\t    82\t    ull_to_bytes(csum_bytes, sizeof(csum_bytes), csum);\n519\t    83\t    base_w(csum_base_w, SPX_WOTS_LEN2, csum_bytes);\n520\t    84\t}\n521\t    85\t\n522\t    86\t/* Takes a message and derives the matching chain lengths. */\n523\t    87\tvoid chain_lengths(unsigned int *lengths, const unsigned char *msg)\n524\t    88\t{\n525\t    89\t    base_w(lengths, SPX_WOTS_LEN1, msg);\n526\t    90\t    wots_checksum(lengths + SPX_WOTS_LEN1, lengths);\n527\t    91\t}\n528\t    92\t\n529\t    93\t/**\n530\t    94\t * Takes a WOTS signature and an n-byte message, computes a WOTS public key.\n531\t    95\t *\n532\t    96\t * Writes the computed public key to 'pk'.\n533\t    97\t */\n534\t    98\tvoid wots_pk_from_sig(unsigned char *pk,\n535\t    99\t                      const unsigned char *sig, const unsigned char *msg,\n536\t   100\t                      const spx_ctx *ctx, uint32_t addr[8])\n537\t   101\t{\n538\t   102\t    unsigned int lengths[SPX_WOTS_LEN];\n539\t   103\t    uint32_t i;\n540\t   104\t\n541\t   105\t    chain_lengths(lengths, msg);\n542\t   106\t\n543\t   107\t    for (i = 0; i < SPX_WOTS_LEN; i++) {\n544\t   108\t        set_chain_addr(addr, i);\n545\t   109\t        gen_chain(pk + i*SPX_N, sig + i*SPX_N,\n546\t   110\t                  lengths[i], SPX_WOTS_W - 1 - lengths[i], ctx, addr);\n547\t   111\t    }\n548\t   112\t}\n549\t===== wotsx1.c =====\n550\t     1\t#include <stdint.h>\n551\t     2\t#include <string.h>\n552\t     3\t\n553\t     4\t#include \"../include/address.h\"\n554\t     5\t#include \"../include/hash.h\"\n555\t     6\t#include \"../include/params.h\"\n556\t     7\t#include \"../include/thash.h\"\n557\t     8\t#include \"../include/utils.h\"\n558\t     9\t#include \"../include/wots.h\"\n559\t    10\t#include \"../include/wotsx1.h\"\n560\t    11\t\n561\t    12\t/*\n562\t    13\t * This generates a WOTS public key\n563\t    14\t * It also generates the WOTS signature if leaf_info indicates\n564\t    15\t * that we're signing with this WOTS key\n565\t    16\t */\n566\t    17\tvoid wots_gen_leafx1(unsigned char *dest,\n567\t    18\t                   const spx_ctx *ctx,\n568\t    19\t                   uint32_t leaf_idx, leaf_info_x1 *v_info) {\n569\t    20\t    struct leaf_info_x1 *info = v_info;\n570\t    21\t    uint32_t *leaf_addr = info->leaf_addr;\n571\t    22\t    uint32_t *pk_addr = info->pk_addr;\n572\t    23\t    unsigned int i, k;\n573\t    24\t    unsigned char pk_buffer[ SPX_WOTS_BYTES ];\n574\t    25\t    unsigned char *buffer;\n575\t    26\t    uint32_t wots_k_mask;\n576\t    27\t\n577\t    28\t    if (leaf_idx == info->wots_sign_leaf) {\n578\t    29\t        /* We're traversing the leaf that's signing; generate the WOTS */\n579\t    30\t        /* signature */\n580\t    31\t        wots_k_mask = 0;\n581\t    32\t    } else {\n582\t    33\t        /* Nope, we're just generating pk's; turn off the signature logic */\n583\t    34\t        wots_k_mask = (uint32_t)~0;\n584\t    35\t    }\n585\t    36\t\n586\t    37\t    set_keypair_addr( leaf_addr, leaf_idx );\n587\t    38\t    set_keypair_addr( pk_addr, leaf_idx );\n588\t    39\t\n589\t    40\t    for (i = 0, buffer = pk_buffer; i < SPX_WOTS_LEN; i++, buffer += SPX_N) {\n590\t    41\t        uint32_t wots_k = info->wots_steps[i] | wots_k_mask; /* Set wots_k to */\n591\t    42\t            /* the step if we're generating a signature, ~0 if we're not */\n592\t    43\t\n593\t    44\t        /* Start with the secret seed */\n594\t    45\t        set_chain_addr(leaf_addr, i);\n595\t    46\t        set_hash_addr(leaf_addr, 0);\n596\t    47\t        set_type(leaf_addr, SPX_ADDR_TYPE_WOTSPRF);\n597\t    48\t\n598\t    49\t        prf_addr(buffer, ctx, leaf_addr);\n599\t    50\t\n600\t    51\t        set_type(leaf_addr, SPX_ADDR_TYPE_WOTS);\n601\t    52\t\n602\t    53\t        /* Iterate down the WOTS chain */\n603\t    54\t        for (k=0;; k++) {\n604\t    55\t            /* Check if this is the value that needs to be saved as a */\n605\t    56\t            /* part of the WOTS signature */\n606\t    57\t            if (k == wots_k) {\n607\t    58\t                memcpy( info->wots_sig + i * SPX_N, buffer, SPX_N );\n608\t    59\t            }\n609\t    60\t\n610\t    61\t            /* Check if we hit the top of the chain */\n611\t    62\t            if (k == SPX_WOTS_W - 1) break;\n612\t    63\t\n613\t    64\t            /* Iterate one step on the chain */\n614\t    65\t            set_hash_addr(leaf_addr, k);\n615\t    66\t\n616\t    67\t            thash(buffer, buffer, 1, ctx, leaf_addr);\n617\t    68\t        }\n618\t    69\t    }\n619\t    70\t\n620\t    71\t    /* Do the final thash to generate the public keys */\n621\t    72\t    thash(dest, pk_buffer, SPX_WOTS_LEN, ctx, pk_addr);\n622\t    73\t}\n623\t===== fors.c =====\n624\t     1\t#include <stdlib.h>\n625\t     2\t#include <stdint.h>\n626\t     3\t#include <string.h>\n627\t     4\t\n628\t     5\t#include \"../include/address.h\"\n629\t     6\t#include \"../include/fors.h\"\n630\t     7\t#include \"../include/forsx1.h\"\n631\t     8\t#include \"../include/hash.h\"\n632\t     9\t#include \"../include/thash.h\"\n633\t    10\t#include \"../include/utils.h\"\n634\t    11\t#include \"../include/utilsx1.h\"\n635\t    12\t\n636\t    13\tstatic void fors_gen_sk(unsigned char *sk, const spx_ctx *ctx,\n637\t    14\t                        uint32_t fors_leaf_addr[8])\n638\t    15\t{\n639\t    16\t    prf_addr(sk, ctx, fors_leaf_addr);\n640\t    17\t}\n641\t    18\t\n642\t    19\tstatic void fors_sk_to_leaf(unsigned char *leaf, const unsigned char *sk,\n643\t    20\t                            const spx_ctx *ctx,\n644\t    21\t                            uint32_t fors_leaf_addr[8])\n645\t    22\t{\n646\t    23\t    thash(leaf, sk, 1, ctx, fors_leaf_addr);\n647\t    24\t}\n648\t    25\t\n649\t    26\tvoid fors_gen_leafx1(unsigned char *leaf,\n650\t    27\t                            const spx_ctx *ctx,\n651\t    28\t                            uint32_t addr_idx, fors_gen_leaf_info *info)\n652\t    29\t{\n653\t    30\t    struct fors_gen_leaf_info *fors_info = info;\n654\t    31\t    uint32_t *fors_leaf_addr = fors_info->leaf_addrx;\n655\t    32\t\n656\t    33\t    /* Only set the parts that the caller doesn't set */\n657\t    34\t    set_tree_index(fors_leaf_addr, addr_idx);\n658\t    35\t    set_type(fors_leaf_addr, SPX_ADDR_TYPE_FORSPRF);\n659\t    36\t    fors_gen_sk(leaf, ctx, fors_leaf_addr);\n660\t    37\t\n661\t    38\t    set_type(fors_leaf_addr, SPX_ADDR_TYPE_FORSTREE);\n662\t    39\t    fors_sk_to_leaf(leaf, leaf,\n663\t    40\t                    ctx, fors_leaf_addr);\n664\t    41\t}\n665\t    42\t\n666\t    43\t/**\n667\t    44\t * Interprets m as SPX_FORS_HEIGHT-bit unsigned integers.\n668\t    45\t * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.\n669\t    46\t * Assumes indices has space for SPX_FORS_TREES integers.\n670\t    47\t */\n671\t    48\tstatic void message_to_indices(uint32_t *indices, const unsigned char *m)\n672\t    49\t{\n673\t    50\t    unsigned int i, j;\n674\t    51\t    unsigned int offset = 0;\n675\t    52\t\n676\t    53\t    for (i = 0; i < SPX_FORS_TREES; i++) {\n677\t    54\t        indices[i] = 0;\n678\t    55\t        for (j = 0; j < SPX_FORS_HEIGHT; j++) {\n679\t    56\t            indices[i] ^= ((m[offset >> 3] >> (offset & 0x7)) & 1u) << j;\n680\t    57\t            offset++;\n681\t    58\t        }\n682\t    59\t    }\n683\t    60\t}\n684\t    61\t\n685\t    62\t/**\n686\t    63\t * Signs a message m, deriving the secret key from sk_seed and the FTS address.\n687\t    64\t * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.\n688\t    65\t */\n689\t    66\tvoid fors_sign(unsigned char *sig, unsigned char *pk,\n690\t    67\t               const unsigned char *m,\n691\t    68\t               const spx_ctx *ctx,\n692\t    69\t               const uint32_t fors_addr[8])\n693\t    70\t{\n694\t    71\t    uint32_t indices[SPX_FORS_TREES];\n695\t    72\t    unsigned char roots[SPX_FORS_TREES * SPX_N];\n696\t    73\t    uint32_t fors_tree_addr[8] = {0};\n697\t    74\t    struct fors_gen_leaf_info fors_info = {0};\n698\t    75\t    uint32_t *fors_leaf_addr = fors_info.leaf_addrx;\n699\t    76\t    uint32_t fors_pk_addr[8] = {0};\n700\t    77\t    uint32_t idx_offset;\n701\t    78\t    unsigned int i;\n702\t    79\t\n703\t    80\t    copy_keypair_addr(fors_tree_addr, fors_addr);\n704\t    81\t    copy_keypair_addr(fors_leaf_addr, fors_addr);\n705\t    82\t\n706\t    83\t    copy_keypair_addr(fors_pk_addr, fors_addr);\n707\t    84\t    set_type(fors_pk_addr, SPX_ADDR_TYPE_FORSPK);\n708\t    85\t\n709\t    86\t    message_to_indices(indices, m);\n710\t    87\t\n711\t    88\t    for (i = 0; i < SPX_FORS_TREES; i++) {\n712\t    89\t        idx_offset = i * (1 << SPX_FORS_HEIGHT);\n713\t    90\t\n714\t    91\t        set_tree_height(fors_tree_addr, 0);\n715\t    92\t        set_tree_index(fors_tree_addr, indices[i] + idx_offset);\n716\t    93\t        set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSPRF);\n717\t    94\t\n718\t    95\t        /* Include the secret key part that produces the selected leaf node. */\n719\t    96\t        fors_gen_sk(sig, ctx, fors_tree_addr);\n720\t    97\t        set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);\n721\t    98\t        sig += SPX_N;\n722\t    99\t\n723\t   100\t        /* Compute the authentication path for this leaf node. */\n724\t   101\t        fors_treehashx1(roots + i*SPX_N, sig, ctx,\n725\t   102\t                 indices[i], idx_offset, SPX_FORS_HEIGHT,\n726\t   103\t                 fors_tree_addr, &fors_info);\n727\t   104\t\n728\t   105\t        sig += SPX_N * SPX_FORS_HEIGHT;\n729\t   106\t    }\n730\t   107\t\n731\t   108\t    /* Hash horizontally across all tree roots to derive the public key. */\n732\t   109\t    thash(pk, roots, SPX_FORS_TREES, ctx, fors_pk_addr);\n733\t   110\t}\n734\t   111\t\n735\t   112\t/**\n736\t   113\t * Derives the FORS public key from a signature.\n737\t   114\t * This can be used for verification by comparing to a known public key, or to\n738\t   115\t * subsequently verify a signature on the derived public key. The latter is the\n739\t   116\t * typical use-case when used as an FTS below an OTS in a hypertree.\n740\t   117\t * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.\n741\t   118\t */\n742\t   119\tvoid fors_pk_from_sig(unsigned char *pk,\n743\t   120\t                      const unsigned char *sig, const unsigned char *m,\n744\t   121\t                      const spx_ctx* ctx,\n745\t   122\t                      const uint32_t fors_addr[8])\n746\t   123\t{\n747\t   124\t    uint32_t indices[SPX_FORS_TREES];\n748\t   125\t    unsigned char roots[SPX_FORS_TREES * SPX_N];\n749\t   126\t    unsigned char leaf[SPX_N];\n750\t   127\t    uint32_t fors_tree_addr[8] = {0};\n751\t   128\t    uint32_t fors_pk_addr[8] = {0};\n752\t   129\t    uint32_t idx_offset;\n753\t   130\t    unsigned int i;\n754\t   131\t\n755\t   132\t    copy_keypair_addr(fors_tree_addr, fors_addr);\n756\t   133\t    copy_keypair_addr(fors_pk_addr, fors_addr);\n757\t   134\t\n758\t   135\t    set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);\n759\t   136\t    set_type(fors_pk_addr, SPX_ADDR_TYPE_FORSPK);\n760\t   137\t\n761\t   138\t    message_to_indices(indices, m);\n762\t   139\t\n763\t   140\t    for (i = 0; i < SPX_FORS_TREES; i++) {\n764\t   141\t        idx_offset = i * (1 << SPX_FORS_HEIGHT);\n765\t   142\t\n766\t   143\t        set_tree_height(fors_tree_addr, 0);\n767\t   144\t        set_tree_index(fors_tree_addr, indices[i] + idx_offset);\n768\t   145\t\n769\t   146\t        /* Derive the leaf from the included secret key part. */\n770\t   147\t        fors_sk_to_leaf(leaf, sig, ctx, fors_tree_addr);\n771\t   148\t        sig += SPX_N;\n772\t   149\t\n773\t   150\t        /* Derive the corresponding root node of this tree. */\n774\t   151\t        compute_root(roots + i*SPX_N, leaf, indices[i], idx_offset,\n775\t   152\t                     sig, SPX_FORS_HEIGHT, ctx, fors_tree_addr);\n776\t   153\t        sig += SPX_N * SPX_FORS_HEIGHT;\n777\t   154\t    }\n778\t   155\t\n779\t   156\t    /* Hash horizontally across all tree roots to derive the public key. */\n780\t   157\t    thash(pk, roots, SPX_FORS_TREES, ctx, fors_pk_addr);\n781\t   158\t}\n782\t===== merkle.c =====\n783\t     1\t#include <stdint.h>\n784\t     2\t#include <string.h>\n785\t     3\t\n786\t     4\t#include \"../include/address.h\"\n787\t     5\t#include \"../include/merkle.h\"\n788\t     6\t#include \"../include/params.h\"\n789\t     7\t#include \"../include/utils.h\"\n790\t     8\t#include \"../include/utilsx1.h\"\n791\t     9\t#include \"../include/wots.h\"\n792\t    10\t#include \"../include/wotsx1.h\"\n793\t    11\t\n794\t    12\t/*\n795\t    13\t * This generates a Merkle signature (WOTS signature followed by the Merkle\n796\t    14\t * authentication path).  This is in this file because most of the complexity\n797\t    15\t * is involved with the WOTS signature; the Merkle authentication path logic\n798\t    16\t * is mostly hidden in treehashx4\n799\t    17\t */\n800\t    18\tvoid merkle_sign(uint8_t *sig, unsigned char *root,\n801\t    19\t                 const spx_ctx *ctx,\n802\t    20\t                 uint32_t wots_addr[8], uint32_t tree_addr[8],\n803\t    21\t                 uint32_t idx_leaf)\n804\t    22\t{\n805\t    23\t    unsigned char *auth_path = sig + SPX_WOTS_BYTES;\n806\t    24\t    struct leaf_info_x1 info = { 0 };\n807\t    25\t    unsigned steps[ SPX_WOTS_LEN ];\n808\t    26\t\n809\t    27\t    info.wots_sig = sig;\n810\t    28\t    chain_lengths(steps, root);\n811\t    29\t    info.wots_steps = steps;\n812\t    30\t\n813\t    31\t    set_type(&tree_addr[0], SPX_ADDR_TYPE_HASHTREE);\n814\t    32\t    set_type(&info.pk_addr[0], SPX_ADDR_TYPE_WOTSPK);\n815\t    33\t    copy_subtree_addr(&info.leaf_addr[0], wots_addr);\n816\t    34\t    copy_subtree_addr(&info.pk_addr[0], wots_addr);\n817\t    35\t\n818\t    36\t    info.wots_sign_leaf = idx_leaf;\n819\t    37\t\n820\t    38\t    wots_treehashx1(root, auth_path, ctx,\n821\t    39\t                idx_leaf, 0,\n822\t    40\t                SPX_TREE_HEIGHT,\n823\t    41\t                tree_addr, &info);\n824\t    42\t}\n825\t    43\t\n826\t    44\t/* Compute root node of the top-most subtree. */\n827\t    45\tvoid merkle_gen_root(unsigned char *root, const spx_ctx *ctx)\n828\t    46\t{\n829\t    47\t    /* We do not need the auth path in key generation, but it simplifies the\n830\t    48\t       code to have just one treehash routine that computes both root and path\n831\t    49\t       in one function. */\n832\t    50\t    unsigned char auth_path[SPX_TREE_HEIGHT * SPX_N + SPX_WOTS_BYTES];\n833\t    51\t    uint32_t top_tree_addr[8] = {0};\n834\t    52\t    uint32_t wots_addr[8] = {0};\n835\t    53\t\n836\t    54\t    set_layer_addr(top_tree_addr, SPX_D - 1);\n837\t    55\t    set_layer_addr(wots_addr, SPX_D - 1);\n838\t    56\t\n839\t    57\t    merkle_sign(auth_path, root, ctx,\n840\t    58\t                wots_addr, top_tree_addr,\n841\t    59\t                (uint32_t)~0 /* ~0 means \"don't bother generating an auth path */ );\n842\t    60\t}\n843\t===== sign.c =====\n844\t     1\t#include <stddef.h>\n845\t     2\t#include <string.h>\n846\t     3\t#include <stdint.h>\n847\t     4\t\n848\t     5\t#include \"../include/address.h\"\n849\t     6\t#include \"../include/api.h\"\n850\t     7\t#include \"../include/fors.h\"\n851\t     8\t#include \"../include/hash.h\"\n852\t     9\t#include \"../include/merkle.h\"\n853\t    10\t#include \"../include/params.h\"\n854\t    11\t#include \"../include/randombytes.h\"\n855\t    12\t#include \"../include/thash.h\"\n856\t    13\t#include \"../include/utils.h\"\n857\t    14\t#include \"../include/wots.h\"\n858\t    15\t\n859\t    16\t/*\n860\t    17\t * Returns the length of a secret key, in bytes\n861\t    18\t */\n862\t    19\tunsigned long long crypto_sign_secretkeybytes(void)\n863\t    20\t{\n864\t    21\t    return CRYPTO_SECRETKEYBYTES;\n865\t    22\t}\n866\t    23\t\n867\t    24\t/*\n868\t    25\t * Returns the length of a public key, in bytes\n869\t    26\t */\n870\t    27\tunsigned long long crypto_sign_publickeybytes(void)\n871\t    28\t{\n872\t    29\t    return CRYPTO_PUBLICKEYBYTES;\n873\t    30\t}\n874\t    31\t\n875\t    32\t/*\n876\t    33\t * Returns the length of a signature, in bytes\n877\t    34\t */\n878\t    35\tunsigned long long crypto_sign_bytes(void)\n879\t    36\t{\n880\t    37\t    return CRYPTO_BYTES;\n881\t    38\t}\n882\t    39\t\n883\t    40\t/*\n884\t    41\t * Returns the length of the seed required to generate a key pair, in bytes\n885\t    42\t */\n886\t    43\tunsigned long long crypto_sign_seedbytes(void)\n887\t    44\t{\n888\t    45\t    return CRYPTO_SEEDBYTES;\n889\t    46\t}\n890\t    47\t\n891\t    48\t/*\n892\t    49\t * Generates an SPX key pair given a seed of length\n893\t    50\t * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]\n894\t    51\t * Format pk: [PUB_SEED || root]\n895\t    52\t */\n896\t    53\tint crypto_sign_seed_keypair(unsigned char *pk, unsigned char *sk,\n897\t    54\t                             const unsigned char *seed)\n898\t    55\t{\n899\t    56\t    spx_ctx ctx;\n900\t    57\t\n901\t    58\t    /* Initialize SK_SEED, SK_PRF and PUB_SEED from seed. */\n902\t    59\t    memcpy(sk, seed, CRYPTO_SEEDBYTES);\n903\t    60\t\n904\t    61\t    memcpy(pk, sk + 2*SPX_N, SPX_N);\n905\t    62\t\n906\t    63\t    memcpy(ctx.pub_seed, pk, SPX_N);\n907\t    64\t    memcpy(ctx.sk_seed, sk, SPX_N);\n908\t    65\t\n909\t    66\t    /* This hook allows the hash function instantiation to do whatever\n910\t    67\t       preparation or computation it needs, based on the public seed. */\n911\t    68\t    initialize_hash_function(&ctx);\n912\t    69\t\n913\t    70\t    /* Compute root node of the top-most subtree. */\n914\t    71\t    merkle_gen_root(sk + 3*SPX_N, &ctx);\n915\t    72\t\n916\t    73\t    memcpy(pk + SPX_N, sk + 3*SPX_N, SPX_N);\n917\t    74\t\n918\t    75\t    return 0;\n919\t    76\t}\n920\t    77\t\n921\t    78\t/*\n922\t    79\t * Generates an SPX key pair.\n923\t    80\t * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]\n924\t    81\t * Format pk: [PUB_SEED || root]\n925\t    82\t */\n926\t    83\tint crypto_sign_keypair(unsigned char *pk, unsigned char *sk)\n927\t    84\t{\n928\t    85\t  unsigned char seed[CRYPTO_SEEDBYTES];\n929\t    86\t  randombytes(seed, CRYPTO_SEEDBYTES);\n930\t    87\t  crypto_sign_seed_keypair(pk, sk, seed);\n931\t    88\t\n932\t    89\t  return 0;\n933\t    90\t}\n934\t    91\t\n935\t    92\t/**\n936\t    93\t * Returns an array containing a detached signature.\n937\t    94\t */\n938\t    95\tint crypto_sign_signature(uint8_t *sig, size_t *siglen,\n939\t    96\t                          const uint8_t *m, size_t mlen, const uint8_t *sk)\n940\t    97\t{\n941\t    98\t    spx_ctx ctx;\n942\t    99\t\n943\t   100\t    const unsigned char *sk_prf = sk + SPX_N;\n944\t   101\t    const unsigned char *pk = sk + 2*SPX_N;\n945\t   102\t\n946\t   103\t    unsigned char optrand[SPX_N];\n947\t   104\t    unsigned char mhash[SPX_FORS_MSG_BYTES];\n948\t   105\t    unsigned char root[SPX_N];\n949\t   106\t    uint32_t i;\n950\t   107\t    uint64_t tree;\n951\t   108\t    uint32_t idx_leaf;\n952\t   109\t    uint32_t wots_addr[8] = {0};\n953\t   110\t    uint32_t tree_addr[8] = {0};\n954\t   111\t\n955\t   112\t    memcpy(ctx.sk_seed, sk, SPX_N);\n956\t   113\t    memcpy(ctx.pub_seed, pk, SPX_N);\n957\t   114\t\n958\t   115\t    /* This hook allows the hash function instantiation to do whatever\n959\t   116\t       preparation or computation it needs, based on the public seed. */\n960\t   117\t    initialize_hash_function(&ctx);\n961\t   118\t\n962\t   119\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n963\t   120\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n964\t   121\t\n965\t   122\t    /* Optionally, signing can be made non-deterministic using optrand.\n966\t   123\t       This can help counter side-channel attacks that would benefit from\n967\t   124\t       getting a large number of traces when the signer uses the same nodes. */\n968\t   125\t    randombytes(optrand, SPX_N);\n969\t   126\t    /* Compute the digest randomization value. */\n970\t   127\t    gen_message_random(sig, sk_prf, optrand, m, mlen, &ctx);\n971\t   128\t\n972\t   129\t    /* Derive the message digest and leaf index from R, PK and M. */\n973\t   130\t    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);\n974\t   131\t    sig += SPX_N;\n975\t   132\t\n976\t   133\t    set_tree_addr(wots_addr, tree);\n977\t   134\t    set_keypair_addr(wots_addr, idx_leaf);\n978\t   135\t\n979\t   136\t    /* Sign the message hash using FORS. */\n980\t   137\t    fors_sign(sig, root, mhash, &ctx, wots_addr);\n981\t   138\t    sig += SPX_FORS_BYTES;\n982\t   139\t\n983\t   140\t    for (i = 0; i < SPX_D; i++) {\n984\t   141\t        set_layer_addr(tree_addr, i);\n985\t   142\t        set_tree_addr(tree_addr, tree);\n986\t   143\t\n987\t   144\t        copy_subtree_addr(wots_addr, tree_addr);\n988\t   145\t        set_keypair_addr(wots_addr, idx_leaf);\n989\t   146\t\n990\t   147\t        merkle_sign(sig, root, &ctx, wots_addr, tree_addr, idx_leaf);\n991\t   148\t        sig += SPX_WOTS_BYTES + SPX_TREE_HEIGHT * SPX_N;\n992\t   149\t\n993\t   150\t        /* Update the indices for the next layer. */\n994\t   151\t        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));\n995\t   152\t        tree = tree >> SPX_TREE_HEIGHT;\n996\t   153\t    }\n997\t   154\t\n998\t   155\t    *siglen = SPX_BYTES;\n999\t   156\t\n1000\t   157\t    return 0;\n1001\t   158\t}\n1002\t   159\t\n1003\t   160\t/**\n1004\t   161\t * Verifies a detached signature and message under a given public key.\n1005\t   162\t */\n1006\t   163\tint crypto_sign_verify(const uint8_t *sig, size_t siglen,\n1007\t   164\t                       const uint8_t *m, size_t mlen, const uint8_t *pk)\n1008\t   165\t{\n1009\t   166\t    spx_ctx ctx;\n1010\t   167\t    const unsigned char *pub_root = pk + SPX_N;\n1011\t   168\t    unsigned char mhash[SPX_FORS_MSG_BYTES];\n1012\t   169\t    unsigned char wots_pk[SPX_WOTS_BYTES];\n1013\t   170\t    unsigned char root[SPX_N];\n1014\t   171\t    unsigned char leaf[SPX_N];\n1015\t   172\t    unsigned int i;\n1016\t   173\t    uint64_t tree;\n1017\t   174\t    uint32_t idx_leaf;\n1018\t   175\t    uint32_t wots_addr[8] = {0};\n1019\t   176\t    uint32_t tree_addr[8] = {0};\n1020\t   177\t    uint32_t wots_pk_addr[8] = {0};\n1021\t   178\t\n1022\t   179\t    if (siglen != SPX_BYTES) {\n1023\t   180\t        return -1;\n1024\t   181\t    }\n1025\t   182\t\n1026\t   183\t    memcpy(ctx.pub_seed, pk, SPX_N);\n1027\t   184\t\n1028\t   185\t    /* This hook allows the hash function instantiation to do whatever\n1029\t   186\t       preparation or computation it needs, based on the public seed. */\n1030\t   187\t    initialize_hash_function(&ctx);\n1031\t   188\t\n1032\t   189\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n1033\t   190\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n1034\t   191\t    set_type(wots_pk_addr, SPX_ADDR_TYPE_WOTSPK);\n1035\t   192\t\n1036\t   193\t    /* Derive the message digest and leaf index from R || PK || M. */\n1037\t   194\t    /* The additional SPX_N is a result of the hash domain separator. */\n1038\t   195\t    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);\n1039\t   196\t    sig += SPX_N;\n1040\t   197\t\n1041\t   198\t    /* Layer correctly defaults to 0, so no need to set_layer_addr */\n1042\t   199\t    set_tree_addr(wots_addr, tree);\n1043\t   200\t    set_keypair_addr(wots_addr, idx_leaf);\n1044\t   201\t\n1045\t   202\t    fors_pk_from_sig(root, sig, mhash, &ctx, wots_addr);\n1046\t   203\t    sig += SPX_FORS_BYTES;\n1047\t   204\t\n1048\t   205\t    /* For each subtree.. */\n1049\t   206\t    for (i = 0; i < SPX_D; i++) {\n1050\t   207\t        set_layer_addr(tree_addr, i);\n1051\t   208\t        set_tree_addr(tree_addr, tree);\n1052\t   209\t\n1053\t   210\t        copy_subtree_addr(wots_addr, tree_addr);\n1054\t   211\t        set_keypair_addr(wots_addr, idx_leaf);\n1055\t   212\t\n1056\t   213\t        copy_keypair_addr(wots_pk_addr, wots_addr);\n1057\t   214\t\n1058\t   215\t        /* The WOTS public key is only correct if the signature was correct. */\n1059\t   216\t        /* Initially, root is the FORS pk, but on subsequent iterations it is\n1060\t   217\t           the root of the subtree below the currently processed subtree. */\n1061\t   218\t        wots_pk_from_sig(wots_pk, sig, root, &ctx, wots_addr);\n1062\t   219\t        sig += SPX_WOTS_BYTES;\n1063\t   220\t\n1064\t   221\t        /* Compute the leaf node using the WOTS public key. */\n1065\t   222\t        thash(leaf, wots_pk, SPX_WOTS_LEN, &ctx, wots_pk_addr);\n1066\t   223\t\n1067\t   224\t        /* Compute the root node of this subtree. */\n1068\t   225\t        compute_root(root, leaf, idx_leaf, 0, sig, SPX_TREE_HEIGHT,\n1069\t   226\t                     &ctx, tree_addr);\n1070\t   227\t        sig += SPX_TREE_HEIGHT * SPX_N;\n1071\t   228\t\n1072\t   229\t        /* Update the indices for the next layer. */\n1073\t   230\t        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));\n1074\t   231\t        tree = tree >> SPX_TREE_HEIGHT;\n1075\t   232\t    }\n1076\t   233\t\n1077\t   234\t    /* Check if the root node equals the root node in the public key. */\n1078\t   235\t    if (memcmp(root, pub_root, SPX_N)) {\n1079\t   236\t        return -1;\n1080\t   237\t    }\n1081\t   238\t\n1082\t   239\t    return 0;\n1083\t   240\t}\n1084\t   241\t\n1085\t   242\t\n1086\t   243\t/**\n1087\t   244\t * Returns an array containing the signature followed by the message.\n1088\t   245\t */\n1089\t   246\tint crypto_sign(unsigned char *sm, unsigned long long *smlen,\n1090\t   247\t                const unsigned char *m, unsigned long long mlen,\n1091\t   248\t                const unsigned char *sk)\n1092\t   249\t{\n1093\t   250\t    size_t siglen;\n1094\t   251\t\n1095\t   252\t    crypto_sign_signature(sm, &siglen, m, (size_t)mlen, sk);\n1096\t   253\t\n1097\t   254\t    memmove(sm + SPX_BYTES, m, mlen);\n1098\t   255\t    *smlen = siglen + mlen;\n1099\t   256\t\n1100\t   257\t    return 0;\n1101\t   258\t}\n1102\t   259\t\n1103\t   260\t/**\n1104\t   261\t * Verifies a given signature-message pair under a given public key.\n1105\t   262\t */\n1106\t   263\tint crypto_sign_open(unsigned char *m, unsigned long long *mlen,\n1107\t   264\t                     const unsigned char *sm, unsigned long long smlen,\n1108\t   265\t                     const unsigned char *pk)\n1109\t   266\t{\n1110\t   267\t    /* The API caller does not necessarily know what size a signature should be\n1111\t   268\t       but SPHINCS+ signatures are always exactly SPX_BYTES. */\n1112\t   269\t    if (smlen < SPX_BYTES) {\n1113\t   270\t        memset(m, 0, smlen);\n1114\t   271\t        *mlen = 0;\n1115\t   272\t        return -1;\n1116\t   273\t    }\n1117\t   274\t\n1118\t   275\t    *mlen = smlen - SPX_BYTES;\n1119\t   276\t\n1120\t   277\t    if (crypto_sign_verify(sm, SPX_BYTES, sm + SPX_BYTES, (size_t)*mlen, pk)) {\n1121\t   278\t        memset(m, 0, smlen);\n1122\t   279\t        *mlen = 0;\n1123\t   280\t        return -1;\n1124\t   281\t    }\n1125\t   282\t\n1126\t   283\t    /* If verification was successful, move the message to the right place. */\n1127\t   284\t    memmove(m, sm + SPX_BYTES, *mlen);\n1128\t   285\t\n1129\t   286\t    return 0;\n1130\t   287\t}\n1131\t"}]},"parent_tool_use_id":null,"session_id":"562c112f-521a-4b18-b7fd-2e147d3d0f73","uuid":"35ec6419-c8d2-4c05-9b1d-28bbf14a1653","timestamp":"2026-08-28T22:30:57.109Z","tool_use_result":{"type":"text","file":{"filePath":"/home/scheschb/.claude/projects/-local-home-scheschb--harvest-work-harvest-work-KaAXuz/562c112f-521a-4b18-b7fd-2e147d3d0f73/tool-results/b48z0ra1f.txt","content":"===== address.c =====\n     1\t#include <stdint.h>\n     2\t#include <string.h>\n     3\t\n     4\t#include \"../include/address.h\"\n     5\t#include \"../include/params.h\"\n     6\t#include \"../include/utils.h\"\n     7\t\n     8\t/*\n     9\t * Specify which level of Merkle tree (the \"layer\") we're working on\n    10\t */\n    11\tvoid set_layer_addr(uint32_t addr[8], uint32_t layer)\n    12\t{\n    13\t    ((unsigned char *)addr)[SPX_OFFSET_LAYER] = (unsigned char)layer;\n    14\t}\n    15\t\n    16\t/*\n    17\t * Specify which Merkle tree within the level (the \"tree address\") we're working on\n    18\t */\n    19\tvoid set_tree_addr(uint32_t addr[8], uint64_t tree)\n    20\t{\n    21\t#if (SPX_TREE_HEIGHT * (SPX_D - 1)) > 64\n    22\t    #error Subtree addressing is currently limited to at most 2^64 trees\n    23\t#endif\n    24\t    ull_to_bytes(&((unsigned char *)addr)[SPX_OFFSET_TREE], 8, tree );\n    25\t}\n    26\t\n    27\t/*\n    28\t * Specify the reason we'll use this address structure for, that is, what\n    29\t * hash will we compute with it.  This is used so that unrelated types of\n    30\t * hashes don't accidentally get the same address structure.  The type will be\n    31\t * one of the SPX_ADDR_TYPE constants\n    32\t */\n    33\tvoid set_type(uint32_t addr[8], uint32_t type)\n    34\t{\n    35\t    ((unsigned char *)addr)[SPX_OFFSET_TYPE] = (unsigned char)type;\n    36\t}\n    37\t\n    38\t/*\n    39\t * Copy the layer and tree fields of the address structure.  This is used\n    40\t * when we're doing multiple types of hashes within the same Merkle tree\n    41\t */\n    42\tvoid copy_subtree_addr(uint32_t out[8], const uint32_t in[8])\n    43\t{\n    44\t    memcpy( out, in, SPX_OFFSET_TREE+8 );\n    45\t}\n    46\t\n    47\t/* These functions are used for OTS addresses. */\n    48\t\n    49\t/*\n    50\t * Specify which Merkle leaf we're working on; that is, which OTS keypair\n    51\t * we're talking about.\n    52\t */\n    53\tvoid set_keypair_addr(uint32_t addr[8], uint32_t keypair)\n    54\t{\n    55\t    u32_to_bytes(&((unsigned char *)addr)[SPX_OFFSET_KP_ADDR], keypair);\n    56\t}\n    57\t\n    58\t/*\n    59\t * Copy the layer, tree and keypair fields of the address structure.  This is\n    60\t * used when we're doing multiple things within the same OTS keypair\n    61\t */\n    62\tvoid copy_keypair_addr(uint32_t out[8], const uint32_t in[8])\n    63\t{\n    64\t    memcpy( out, in, SPX_OFFSET_TREE+8 );\n    65\t    memcpy( (unsigned char *)out + SPX_OFFSET_KP_ADDR, (unsigned char *)in + SPX_OFFSET_KP_ADDR, 4); \n    66\t}\n    67\t\n    68\t/*\n    69\t * Specify which Merkle chain within the OTS we're working with\n    70\t * (the chain address)\n    71\t */\n    72\tvoid set_chain_addr(uint32_t addr[8], uint32_t chain)\n    73\t{\n    74\t    ((unsigned char *)addr)[SPX_OFFSET_CHAIN_ADDR] = (unsigned char)chain;\n    75\t}\n    76\t\n    77\t/*\n    78\t * Specify where in the Merkle chain we are\n    79\t* (the hash address)\n    80\t */\n    81\tvoid set_hash_addr(uint32_t addr[8], uint32_t hash)\n    82\t{\n    83\t    ((unsigned char *)addr)[SPX_OFFSET_HASH_ADDR] = (unsigned char)hash;\n    84\t}\n    85\t\n    86\t/* These functions are used for all hash tree addresses (including FORS). */\n    87\t\n    88\t/*\n    89\t * Specify the height of the node in the Merkle/FORS tree we are in\n    90\t * (the tree height)\n    91\t */\n    92\tvoid set_tree_height(uint32_t addr[8], uint32_t tree_height)\n    93\t{\n    94\t    ((unsigned char *)addr)[SPX_OFFSET_TREE_HGT] = (unsigned char)tree_height;\n    95\t}\n    96\t\n    97\t/*\n    98\t * Specify the distance from the left edge of the node in the Merkle/FORS tree\n    99\t * (the tree index)\n   100\t */\n   101\tvoid set_tree_index(uint32_t addr[8], uint32_t tree_index)\n   102\t{\n   103\t    u32_to_bytes(&((unsigned char *)addr)[SPX_OFFSET_TREE_INDEX], tree_index );\n   104\t}\n===== utils.c =====\n     1\t#include <string.h>\n     2\t\n     3\t#include \"../include/address.h\"\n     4\t#include \"../include/hash.h\"\n     5\t#include \"../include/params.h\"\n     6\t#include \"../include/thash.h\"\n     7\t#include \"../include/utils.h\"\n     8\t\n     9\t/**\n    10\t * Converts the value of 'in' to 'outlen' bytes in big-endian byte order.\n    11\t */\n    12\tvoid ull_to_bytes(unsigned char *out, unsigned int outlen,\n    13\t                  unsigned long long in)\n    14\t{\n    15\t    int i;\n    16\t\n    17\t    /* Iterate over out in decreasing order, for big-endianness. */\n    18\t    for (i = (signed int)outlen - 1; i >= 0; i--) {\n    19\t        out[i] = in & 0xff;\n    20\t        in = in >> 8;\n    21\t    }\n    22\t}\n    23\t\n    24\tvoid u32_to_bytes(unsigned char *out, uint32_t in)\n    25\t{\n    26\t    out[0] = (unsigned char)(in >> 24);\n    27\t    out[1] = (unsigned char)(in >> 16);\n    28\t    out[2] = (unsigned char)(in >> 8);\n    29\t    out[3] = (unsigned char)in;\n    30\t}\n    31\t\n    32\t/**\n    33\t * Converts the inlen bytes in 'in' from big-endian byte order to an integer.\n    34\t */\n    35\tunsigned long long bytes_to_ull(const unsigned char *in, unsigned int inlen)\n    36\t{\n    37\t    unsigned long long retval = 0;\n    38\t    unsigned int i;\n    39\t\n    40\t    for (i = 0; i < inlen; i++) {\n    41\t        retval |= ((unsigned long long)in[i]) << (8*(inlen - 1 - i));\n    42\t    }\n    43\t    return retval;\n    44\t}\n    45\t\n    46\t/**\n    47\t * Computes a root node given a leaf and an auth path.\n    48\t * Expects address to be complete other than the tree_height and tree_index.\n    49\t */\n    50\tvoid compute_root(unsigned char *root, const unsigned char *leaf,\n    51\t                  uint32_t leaf_idx, uint32_t idx_offset,\n    52\t                  const unsigned char *auth_path, uint32_t tree_height,\n    53\t                  const spx_ctx *ctx, uint32_t addr[8])\n    54\t{\n    55\t    uint32_t i;\n    56\t    unsigned char buffer[2 * SPX_N];\n    57\t\n    58\t    /* If leaf_idx is odd (last bit = 1), current path element is a right child\n    59\t       and auth_path has to go left. Otherwise it is the other way around. */\n    60\t    if (leaf_idx & 1) {\n    61\t        memcpy(buffer + SPX_N, leaf, SPX_N);\n    62\t        memcpy(buffer, auth_path, SPX_N);\n    63\t    }\n    64\t    else {\n    65\t        memcpy(buffer, leaf, SPX_N);\n    66\t        memcpy(buffer + SPX_N, auth_path, SPX_N);\n    67\t    }\n    68\t    auth_path += SPX_N;\n    69\t\n    70\t    for (i = 0; i < tree_height - 1; i++) {\n    71\t        leaf_idx >>= 1;\n    72\t        idx_offset >>= 1;\n    73\t        /* Set the address of the node we're creating. */\n    74\t        set_tree_height(addr, i + 1);\n    75\t        set_tree_index(addr, leaf_idx + idx_offset);\n    76\t\n    77\t        /* Pick the right or left neighbor, depending on parity of the node. */\n    78\t        if (leaf_idx & 1) {\n    79\t            thash(buffer + SPX_N, buffer, 2, ctx, addr);\n    80\t            memcpy(buffer, auth_path, SPX_N);\n    81\t        }\n    82\t        else {\n    83\t            thash(buffer, buffer, 2, ctx, addr);\n    84\t            memcpy(buffer + SPX_N, auth_path, SPX_N);\n    85\t        }\n    86\t        auth_path += SPX_N;\n    87\t    }\n    88\t\n    89\t    /* The last iteration is exceptional; we do not copy an auth_path node. */\n    90\t    leaf_idx >>= 1;\n    91\t    idx_offset >>= 1;\n    92\t    set_tree_height(addr, tree_height);\n    93\t    set_tree_index(addr, leaf_idx + idx_offset);\n    94\t    thash(root, buffer, 2, ctx, addr);\n    95\t}\n    96\t\n    97\t/**\n    98\t * For a given leaf index, computes the authentication path and the resulting\n    99\t * root node using Merkle's TreeHash algorithm.\n   100\t * Expects the layer and tree parts of the tree_addr to be set, as well as the\n   101\t * tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE).\n   102\t * Applies the offset idx_offset to indices before building addresses, so that\n   103\t * it is possible to continue counting indices across trees.\n   104\t */\n   105\tvoid treehash(unsigned char *root, unsigned char *auth_path, const spx_ctx* ctx,\n   106\t              uint32_t leaf_idx, uint32_t idx_offset, uint32_t tree_height,\n   107\t              void (*gen_leaf)(\n   108\t                 unsigned char* /* leaf */,\n   109\t                 const spx_ctx* /* ctx */,\n   110\t                 uint32_t /* addr_idx */, const uint32_t[8] /* tree_addr */),\n   111\t              uint32_t tree_addr[8])\n   112\t{\n   113\t    SPX_VLA(uint8_t, stack, (tree_height+1)*SPX_N);\n   114\t    SPX_VLA(unsigned int, heights, tree_height+1);\n   115\t    unsigned int offset = 0;\n   116\t    uint32_t idx;\n   117\t    uint32_t tree_idx;\n   118\t\n   119\t    for (idx = 0; idx < (uint32_t)(1 << tree_height); idx++) {\n   120\t        /* Add the next leaf node to the stack. */\n   121\t        gen_leaf(stack + offset*SPX_N, ctx, idx + idx_offset, tree_addr);\n   122\t        offset++;\n   123\t        heights[offset - 1] = 0;\n   124\t\n   125\t        /* If this is a node we need for the auth path.. */\n   126\t        if ((leaf_idx ^ 0x1) == idx) {\n   127\t            memcpy(auth_path, stack + (offset - 1)*SPX_N, SPX_N);\n   128\t        }\n   129\t\n   130\t        /* While the top-most nodes are of equal height.. */\n   131\t        while (offset >= 2 && heights[offset - 1] == heights[offset - 2]) {\n   132\t            /* Compute index of the new node, in the next layer. */\n   133\t            tree_idx = (idx >> (heights[offset - 1] + 1));\n   134\t\n   135\t            /* Set the address of the node we're creating. */\n   136\t            set_tree_height(tree_addr, heights[offset - 1] + 1);\n   137\t            set_tree_index(tree_addr,\n   138\t                           tree_idx + (idx_offset >> (heights[offset-1] + 1)));\n   139\t            /* Hash the top-most nodes from the stack together. */\n   140\t            thash(stack + (offset - 2)*SPX_N,\n   141\t                  stack + (offset - 2)*SPX_N, 2, ctx, tree_addr);\n   142\t            offset--;\n   143\t            /* Note that the top-most node is now one layer higher. */\n   144\t            heights[offset - 1]++;\n   145\t\n   146\t            /* If this is a node we need for the auth path.. */\n   147\t            if (((leaf_idx >> heights[offset - 1]) ^ 0x1) == tree_idx) {\n   148\t                memcpy(auth_path + heights[offset - 1]*SPX_N,\n   149\t                       stack + (offset - 1)*SPX_N, SPX_N);\n   150\t            }\n   151\t        }\n   152\t    }\n   153\t    memcpy(root, stack, SPX_N);\n   154\t}\n===== utilsx1.c =====\n     1\t#include <string.h>\n     2\t\n     3\t#include \"../include/address.h\"\n     4\t#include \"../include/params.h\"\n     5\t#include \"../include/forsx1.h\"\n     6\t#include \"../include/thash.h\"\n     7\t#include \"../include/utils.h\"\n     8\t#include \"../include/utilsx1.h\"\n     9\t\n    10\t/*\n    11\t * Generate the entire Merkle tree, computing the authentication path for\n    12\t * leaf_idx, and the resulting root node using Merkle's TreeHash algorithm.\n    13\t * Expects the layer and tree parts of the tree_addr to be set, as well as the\n    14\t * tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE)\n    15\t *\n    16\t * This expects tree_addr to be initialized to the addr structures for the\n    17\t * Merkle tree nodes\n    18\t *\n    19\t * Applies the offset idx_offset to indices before building addresses, so that\n    20\t * it is possible to continue counting indices across trees.\n    21\t *\n    22\t * This works by using the standard Merkle tree building algorithm,\n    23\t */\n    24\tvoid wots_treehashx1(unsigned char *root, unsigned char *auth_path,\n    25\t\t\t     const spx_ctx* ctx,\n    26\t\t\t     uint32_t leaf_idx, uint32_t idx_offset,\n    27\t\t\t     uint32_t tree_height,\n    28\t\t\t     uint32_t tree_addr[8],\n    29\t\t\t     leaf_info_x1 *info)\n    30\t{\n    31\t    /* This is where we keep the intermediate nodes */\n    32\t    SPX_VLA(uint8_t, stack, tree_height*SPX_N);\n    33\t\n    34\t    uint32_t idx;\n    35\t    uint32_t max_idx = (uint32_t)((1 << tree_height) - 1);\n    36\t    for (idx = 0;; idx++) {\n    37\t        unsigned char current[2*SPX_N];   /* Current logical node is at */\n    38\t            /* index[SPX_N].  We do this to minimize the number of copies */\n    39\t            /* needed during a thash */\n    40\t        wots_gen_leafx1( &current[SPX_N], ctx, idx + idx_offset,\n    41\t\t\t\t info );\n    42\t\n    43\t        /* Now combine the freshly generated right node with previously */\n    44\t        /* generated left ones */\n    45\t        uint32_t internal_idx_offset = idx_offset;\n    46\t        uint32_t internal_idx = idx;\n    47\t        uint32_t internal_leaf = leaf_idx;\n    48\t        uint32_t h;     /* The height we are in the Merkle tree */\n    49\t        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {\n    50\t\n    51\t            /* Check if we hit the top of the tree */\n    52\t            if (h == tree_height) {\n    53\t                /* We hit the root; return it */\n    54\t                memcpy( root, &current[SPX_N], SPX_N );\n    55\t                return;\n    56\t            }\n    57\t\n    58\t            /*\n    59\t             * Check if the node we have is a part of the\n    60\t             * authentication path; if it is, write it out\n    61\t             */\n    62\t            if ((internal_idx ^ internal_leaf) == 0x01) {\n    63\t                memcpy( &auth_path[ h * SPX_N ],\n    64\t                        &current[SPX_N],\n    65\t                        SPX_N );\n    66\t            }\n    67\t\n    68\t            /*\n    69\t             * Check if we're at a left child; if so, stop going up the stack\n    70\t             * Exception: if we've reached the end of the tree, keep on going\n    71\t             * (so we combine the last 4 nodes into the one root node in two\n    72\t             * more iterations)\n    73\t             */\n    74\t            if ((internal_idx & 1) == 0 && idx < max_idx) {\n    75\t                break;\n    76\t            }\n    77\t\n    78\t            /* Ok, we're at a right node */\n    79\t            /* Now combine the left and right logical nodes together */\n    80\t\n    81\t            /* Set the address of the node we're creating. */\n    82\t            internal_idx_offset >>= 1;\n    83\t            set_tree_height(tree_addr, h + 1);\n    84\t            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\n    85\t\n    86\t            unsigned char *left = &stack[h * SPX_N];\n    87\t            memcpy( &current[0], left, SPX_N );\n    88\t            thash( &current[1 * SPX_N],\n    89\t                   &current[0 * SPX_N],\n    90\t                   2, ctx, tree_addr);\n    91\t        }\n    92\t\n    93\t        /* We've hit a left child; save the current for when we get the */\n    94\t        /* corresponding right right */\n    95\t        memcpy( &stack[h * SPX_N], &current[SPX_N], SPX_N);\n    96\t    }\n    97\t}\n    98\t\n    99\tvoid fors_treehashx1(unsigned char *root, unsigned char *auth_path,\n   100\t\t\t     const spx_ctx* ctx,\n   101\t\t\t     uint32_t leaf_idx, uint32_t idx_offset,\n   102\t\t\t     uint32_t tree_height,\n   103\t\t\t     uint32_t tree_addr[8],\n   104\t\t\t     leaf_info_x1 *info)\n   105\t{\n   106\t    /* This is where we keep the intermediate nodes */\n   107\t    SPX_VLA(uint8_t, stack, tree_height*SPX_N);\n   108\t\n   109\t    uint32_t idx;\n   110\t    uint32_t max_idx = (uint32_t)((1 << tree_height) - 1);\n   111\t    for (idx = 0;; idx++) {\n   112\t        unsigned char current[2*SPX_N];   /* Current logical node is at */\n   113\t            /* index[SPX_N].  We do this to minimize the number of copies */\n   114\t            /* needed during a thash */\n   115\t\n   116\t\t// IAN TODO: WARNING ON INFO PARAMETER\n   117\t        fors_gen_leafx1( &current[SPX_N], ctx, idx + idx_offset,\n   118\t\t\t\t info );\n   119\t\n   120\t        /* Now combine the freshly generated right node with previously */\n   121\t        /* generated left ones */\n   122\t        uint32_t internal_idx_offset = idx_offset;\n   123\t        uint32_t internal_idx = idx;\n   124\t        uint32_t internal_leaf = leaf_idx;\n   125\t        uint32_t h;     /* The height we are in the Merkle tree */\n   126\t        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {\n   127\t\n   128\t            /* Check if we hit the top of the tree */\n   129\t            if (h == tree_height) {\n   130\t                /* We hit the root; return it */\n   131\t                memcpy( root, &current[SPX_N], SPX_N );\n   132\t                return;\n   133\t            }\n   134\t\n   135\t            /*\n   136\t             * Check if the node we have is a part of the\n   137\t             * authentication path; if it is, write it out\n   138\t             */\n   139\t            if ((internal_idx ^ internal_leaf) == 0x01) {\n   140\t                memcpy( &auth_path[ h * SPX_N ],\n   141\t                        &current[SPX_N],\n   142\t                        SPX_N );\n   143\t            }\n   144\t\n   145\t            /*\n   146\t             * Check if we're at a left child; if so, stop going up the stack\n   147\t             * Exception: if we've reached the end of the tree, keep on going\n   148\t             * (so we combine the last 4 nodes into the one root node in two\n   149\t             * more iterations)\n   150\t             */\n   151\t            if ((internal_idx & 1) == 0 && idx < max_idx) {\n   152\t                break;\n   153\t            }\n   154\t\n   155\t            /* Ok, we're at a right node */\n   156\t            /* Now combine the left and right logical nodes together */\n   157\t\n   158\t            /* Set the address of the node we're creating. */\n   159\t            internal_idx_offset >>= 1;\n   160\t            set_tree_height(tree_addr, h + 1);\n   161\t            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\n   162\t\n   163\t            unsigned char *left = &stack[h * SPX_N];\n   164\t            memcpy( &current[0], left, SPX_N );\n   165\t            thash( &current[1 * SPX_N],\n   166\t                   &current[0 * SPX_N],\n   167\t                   2, ctx, tree_addr);\n   168\t        }\n   169\t\n   170\t        /* We've hit a left child; save the current for when we get the */\n   171\t        /* corresponding right right */\n   172\t        memcpy( &stack[h * SPX_N], &current[SPX_N], SPX_N);\n   173\t    }\n   174\t}\n===== wots.c =====\n     1\t#include <stdint.h>\n     2\t#include <string.h>\n     3\t\n     4\t#include \"../include/address.h\"\n     5\t#include \"../include/hash.h\"\n     6\t#include \"../include/params.h\"\n     7\t#include \"../include/thash.h\"\n     8\t#include \"../include/utils.h\"\n     9\t#include \"../include/utilsx1.h\"\n    10\t#include \"../include/wots.h\"\n    11\t#include \"../include/wotsx1.h\"\n    12\t\n    13\t// TODO clarify address expectations, and make them more uniform.\n    14\t// TODO i.e. do we expect types to be set already?\n    15\t// TODO and do we expect modifications or copies?\n    16\t\n    17\t/**\n    18\t * Computes the chaining function.\n    19\t * out and in have to be n-byte arrays.\n    20\t *\n    21\t * Interprets in as start-th value of the chain.\n    22\t * addr has to contain the address of the chain.\n    23\t */\n    24\tstatic void gen_chain(unsigned char *out, const unsigned char *in,\n    25\t                      unsigned int start, unsigned int steps,\n    26\t                      const spx_ctx *ctx, uint32_t addr[8])\n    27\t{\n    28\t    uint32_t i;\n    29\t\n    30\t    /* Initialize out with the value at position 'start'. */\n    31\t    memcpy(out, in, SPX_N);\n    32\t\n    33\t    /* Iterate 'steps' calls to the hash function. */\n    34\t    for (i = start; i < (start+steps) && i < SPX_WOTS_W; i++) {\n    35\t        set_hash_addr(addr, i);\n    36\t        thash(out, out, 1, ctx, addr);\n    37\t    }\n    38\t}\n    39\t\n    40\t/**\n    41\t * base_w algorithm as described in draft.\n    42\t * Interprets an array of bytes as integers in base w.\n    43\t * This only works when log_w is a divisor of 8.\n    44\t */\n    45\tstatic void base_w(unsigned int *output, const int out_len,\n    46\t                   const unsigned char *input)\n    47\t{\n    48\t    int in = 0;\n    49\t    int out = 0;\n    50\t    unsigned char total;\n    51\t    int bits = 0;\n    52\t    int consumed;\n    53\t\n    54\t    for (consumed = 0; consumed < out_len; consumed++) {\n    55\t        if (bits == 0) {\n    56\t            total = input[in];\n    57\t            in++;\n    58\t            bits += 8;\n    59\t        }\n    60\t        bits -= SPX_WOTS_LOGW;\n    61\t        output[out] = (total >> bits) & (SPX_WOTS_W - 1);\n    62\t        out++;\n    63\t    }\n    64\t}\n    65\t\n    66\t/* Computes the WOTS+ checksum over a message (in base_w). */\n    67\tstatic void wots_checksum(unsigned int *csum_base_w,\n    68\t                          const unsigned int *msg_base_w)\n    69\t{\n    70\t    unsigned int csum = 0;\n    71\t    unsigned char csum_bytes[(SPX_WOTS_LEN2 * SPX_WOTS_LOGW + 7) / 8];\n    72\t    unsigned int i;\n    73\t\n    74\t    /* Compute checksum. */\n    75\t    for (i = 0; i < SPX_WOTS_LEN1; i++) {\n    76\t        csum += SPX_WOTS_W - 1 - msg_base_w[i];\n    77\t    }\n    78\t\n    79\t    /* Convert checksum to base_w. */\n    80\t    /* Make sure expected empty zero bits are the least significant bits. */\n    81\t    csum = csum << ((8 - ((SPX_WOTS_LEN2 * SPX_WOTS_LOGW) % 8)) % 8);\n    82\t    ull_to_bytes(csum_bytes, sizeof(csum_bytes), csum);\n    83\t    base_w(csum_base_w, SPX_WOTS_LEN2, csum_bytes);\n    84\t}\n    85\t\n    86\t/* Takes a message and derives the matching chain lengths. */\n    87\tvoid chain_lengths(unsigned int *lengths, const unsigned char *msg)\n    88\t{\n    89\t    base_w(lengths, SPX_WOTS_LEN1, msg);\n    90\t    wots_checksum(lengths + SPX_WOTS_LEN1, lengths);\n    91\t}\n    92\t\n    93\t/**\n    94\t * Takes a WOTS signature and an n-byte message, computes a WOTS public key.\n    95\t *\n    96\t * Writes the computed public key to 'pk'.\n    97\t */\n    98\tvoid wots_pk_from_sig(unsigned char *pk,\n    99\t                      const unsigned char *sig, const unsigned char *msg,\n   100\t                      const spx_ctx *ctx, uint32_t addr[8])\n   101\t{\n   102\t    unsigned int lengths[SPX_WOTS_LEN];\n   103\t    uint32_t i;\n   104\t\n   105\t    chain_lengths(lengths, msg);\n   106\t\n   107\t    for (i = 0; i < SPX_WOTS_LEN; i++) {\n   108\t        set_chain_addr(addr, i);\n   109\t        gen_chain(pk + i*SPX_N, sig + i*SPX_N,\n   110\t                  lengths[i], SPX_WOTS_W - 1 - lengths[i], ctx, addr);\n   111\t    }\n   112\t}\n===== wotsx1.c =====\n     1\t#include <stdint.h>\n     2\t#include <string.h>\n     3\t\n     4\t#include \"../include/address.h\"\n     5\t#include \"../include/hash.h\"\n     6\t#include \"../include/params.h\"\n     7\t#include \"../include/thash.h\"\n     8\t#include \"../include/utils.h\"\n     9\t#include \"../include/wots.h\"\n    10\t#include \"../include/wotsx1.h\"\n    11\t\n    12\t/*\n    13\t * This generates a WOTS public key\n    14\t * It also generates the WOTS signature if leaf_info indicates\n    15\t * that we're signing with this WOTS key\n    16\t */\n    17\tvoid wots_gen_leafx1(unsigned char *dest,\n    18\t                   const spx_ctx *ctx,\n    19\t                   uint32_t leaf_idx, leaf_info_x1 *v_info) {\n    20\t    struct leaf_info_x1 *info = v_info;\n    21\t    uint32_t *leaf_addr = info->leaf_addr;\n    22\t    uint32_t *pk_addr = info->pk_addr;\n    23\t    unsigned int i, k;\n    24\t    unsigned char pk_buffer[ SPX_WOTS_BYTES ];\n    25\t    unsigned char *buffer;\n    26\t    uint32_t wots_k_mask;\n    27\t\n    28\t    if (leaf_idx == info->wots_sign_leaf) {\n    29\t        /* We're traversing the leaf that's signing; generate the WOTS */\n    30\t        /* signature */\n    31\t        wots_k_mask = 0;\n    32\t    } else {\n    33\t        /* Nope, we're just generating pk's; turn off the signature logic */\n    34\t        wots_k_mask = (uint32_t)~0;\n    35\t    }\n    36\t\n    37\t    set_keypair_addr( leaf_addr, leaf_idx );\n    38\t    set_keypair_addr( pk_addr, leaf_idx );\n    39\t\n    40\t    for (i = 0, buffer = pk_buffer; i < SPX_WOTS_LEN; i++, buffer += SPX_N) {\n    41\t        uint32_t wots_k = info->wots_steps[i] | wots_k_mask; /* Set wots_k to */\n    42\t            /* the step if we're generating a signature, ~0 if we're not */\n    43\t\n    44\t        /* Start with the secret seed */\n    45\t        set_chain_addr(leaf_addr, i);\n    46\t        set_hash_addr(leaf_addr, 0);\n    47\t        set_type(leaf_addr, SPX_ADDR_TYPE_WOTSPRF);\n    48\t\n    49\t        prf_addr(buffer, ctx, leaf_addr);\n    50\t\n    51\t        set_type(leaf_addr, SPX_ADDR_TYPE_WOTS);\n    52\t\n    53\t        /* Iterate down the WOTS chain */\n    54\t        for (k=0;; k++) {\n    55\t            /* Check if this is the value that needs to be saved as a */\n    56\t            /* part of the WOTS signature */\n    57\t            if (k == wots_k) {\n    58\t                memcpy( info->wots_sig + i * SPX_N, buffer, SPX_N );\n    59\t            }\n    60\t\n    61\t            /* Check if we hit the top of the chain */\n    62\t            if (k == SPX_WOTS_W - 1) break;\n    63\t\n    64\t            /* Iterate one step on the chain */\n    65\t            set_hash_addr(leaf_addr, k);\n    66\t\n    67\t            thash(buffer, buffer, 1, ctx, leaf_addr);\n    68\t        }\n    69\t    }\n    70\t\n    71\t    /* Do the final thash to generate the public keys */\n    72\t    thash(dest, pk_buffer, SPX_WOTS_LEN, ctx, pk_addr);\n    73\t}\n===== fors.c =====\n     1\t#include <stdlib.h>\n     2\t#include <stdint.h>\n     3\t#include <string.h>\n     4\t\n     5\t#include \"../include/address.h\"\n     6\t#include \"../include/fors.h\"\n     7\t#include \"../include/forsx1.h\"\n     8\t#include \"../include/hash.h\"\n     9\t#include \"../include/thash.h\"\n    10\t#include \"../include/utils.h\"\n    11\t#include \"../include/utilsx1.h\"\n    12\t\n    13\tstatic void fors_gen_sk(unsigned char *sk, const spx_ctx *ctx,\n    14\t                        uint32_t fors_leaf_addr[8])\n    15\t{\n    16\t    prf_addr(sk, ctx, fors_leaf_addr);\n    17\t}\n    18\t\n    19\tstatic void fors_sk_to_leaf(unsigned char *leaf, const unsigned char *sk,\n    20\t                            const spx_ctx *ctx,\n    21\t                            uint32_t fors_leaf_addr[8])\n    22\t{\n    23\t    thash(leaf, sk, 1, ctx, fors_leaf_addr);\n    24\t}\n    25\t\n    26\tvoid fors_gen_leafx1(unsigned char *leaf,\n    27\t                            const spx_ctx *ctx,\n    28\t                            uint32_t addr_idx, fors_gen_leaf_info *info)\n    29\t{\n    30\t    struct fors_gen_leaf_info *fors_info = info;\n    31\t    uint32_t *fors_leaf_addr = fors_info->leaf_addrx;\n    32\t\n    33\t    /* Only set the parts that the caller doesn't set */\n    34\t    set_tree_index(fors_leaf_addr, addr_idx);\n    35\t    set_type(fors_leaf_addr, SPX_ADDR_TYPE_FORSPRF);\n    36\t    fors_gen_sk(leaf, ctx, fors_leaf_addr);\n    37\t\n    38\t    set_type(fors_leaf_addr, SPX_ADDR_TYPE_FORSTREE);\n    39\t    fors_sk_to_leaf(leaf, leaf,\n    40\t                    ctx, fors_leaf_addr);\n    41\t}\n    42\t\n    43\t/**\n    44\t * Interprets m as SPX_FORS_HEIGHT-bit unsigned integers.\n    45\t * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.\n    46\t * Assumes indices has space for SPX_FORS_TREES integers.\n    47\t */\n    48\tstatic void message_to_indices(uint32_t *indices, const unsigned char *m)\n    49\t{\n    50\t    unsigned int i, j;\n    51\t    unsigned int offset = 0;\n    52\t\n    53\t    for (i = 0; i < SPX_FORS_TREES; i++) {\n    54\t        indices[i] = 0;\n    55\t        for (j = 0; j < SPX_FORS_HEIGHT; j++) {\n    56\t            indices[i] ^= ((m[offset >> 3] >> (offset & 0x7)) & 1u) << j;\n    57\t            offset++;\n    58\t        }\n    59\t    }\n    60\t}\n    61\t\n    62\t/**\n    63\t * Signs a message m, deriving the secret key from sk_seed and the FTS address.\n    64\t * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.\n    65\t */\n    66\tvoid fors_sign(unsigned char *sig, unsigned char *pk,\n    67\t               const unsigned char *m,\n    68\t               const spx_ctx *ctx,\n    69\t               const uint32_t fors_addr[8])\n    70\t{\n    71\t    uint32_t indices[SPX_FORS_TREES];\n    72\t    unsigned char roots[SPX_FORS_TREES * SPX_N];\n    73\t    uint32_t fors_tree_addr[8] = {0};\n    74\t    struct fors_gen_leaf_info fors_info = {0};\n    75\t    uint32_t *fors_leaf_addr = fors_info.leaf_addrx;\n    76\t    uint32_t fors_pk_addr[8] = {0};\n    77\t    uint32_t idx_offset;\n    78\t    unsigned int i;\n    79\t\n    80\t    copy_keypair_addr(fors_tree_addr, fors_addr);\n    81\t    copy_keypair_addr(fors_leaf_addr, fors_addr);\n    82\t\n    83\t    copy_keypair_addr(fors_pk_addr, fors_addr);\n    84\t    set_type(fors_pk_addr, SPX_ADDR_TYPE_FORSPK);\n    85\t\n    86\t    message_to_indices(indices, m);\n    87\t\n    88\t    for (i = 0; i < SPX_FORS_TREES; i++) {\n    89\t        idx_offset = i * (1 << SPX_FORS_HEIGHT);\n    90\t\n    91\t        set_tree_height(fors_tree_addr, 0);\n    92\t        set_tree_index(fors_tree_addr, indices[i] + idx_offset);\n    93\t        set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSPRF);\n    94\t\n    95\t        /* Include the secret key part that produces the selected leaf node. */\n    96\t        fors_gen_sk(sig, ctx, fors_tree_addr);\n    97\t        set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);\n    98\t        sig += SPX_N;\n    99\t\n   100\t        /* Compute the authentication path for this leaf node. */\n   101\t        fors_treehashx1(roots + i*SPX_N, sig, ctx,\n   102\t                 indices[i], idx_offset, SPX_FORS_HEIGHT,\n   103\t                 fors_tree_addr, &fors_info);\n   104\t\n   105\t        sig += SPX_N * SPX_FORS_HEIGHT;\n   106\t    }\n   107\t\n   108\t    /* Hash horizontally across all tree roots to derive the public key. */\n   109\t    thash(pk, roots, SPX_FORS_TREES, ctx, fors_pk_addr);\n   110\t}\n   111\t\n   112\t/**\n   113\t * Derives the FORS public key from a signature.\n   114\t * This can be used for verification by comparing to a known public key, or to\n   115\t * subsequently verify a signature on the derived public key. The latter is the\n   116\t * typical use-case when used as an FTS below an OTS in a hypertree.\n   117\t * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.\n   118\t */\n   119\tvoid fors_pk_from_sig(unsigned char *pk,\n   120\t                      const unsigned char *sig, const unsigned char *m,\n   121\t                      const spx_ctx* ctx,\n   122\t                      const uint32_t fors_addr[8])\n   123\t{\n   124\t    uint32_t indices[SPX_FORS_TREES];\n   125\t    unsigned char roots[SPX_FORS_TREES * SPX_N];\n   126\t    unsigned char leaf[SPX_N];\n   127\t    uint32_t fors_tree_addr[8] = {0};\n   128\t    uint32_t fors_pk_addr[8] = {0};\n   129\t    uint32_t idx_offset;\n   130\t    unsigned int i;\n   131\t\n   132\t    copy_keypair_addr(fors_tree_addr, fors_addr);\n   133\t    copy_keypair_addr(fors_pk_addr, fors_addr);\n   134\t\n   135\t    set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);\n   136\t    set_type(fors_pk_addr, SPX_ADDR_TYPE_FORSPK);\n   137\t\n   138\t    message_to_indices(indices, m);\n   139\t\n   140\t    for (i = 0; i < SPX_FORS_TREES; i++) {\n   141\t        idx_offset = i * (1 << SPX_FORS_HEIGHT);\n   142\t\n   143\t        set_tree_height(fors_tree_addr, 0);\n   144\t        set_tree_index(fors_tree_addr, indices[i] + idx_offset);\n   145\t\n   146\t        /* Derive the leaf from the included secret key part. */\n   147\t        fors_sk_to_leaf(leaf, sig, ctx, fors_tree_addr);\n   148\t        sig += SPX_N;\n   149\t\n   150\t        /* Derive the corresponding root node of this tree. */\n   151\t        compute_root(roots + i*SPX_N, leaf, indices[i], idx_offset,\n   152\t                     sig, SPX_FORS_HEIGHT, ctx, fors_tree_addr);\n   153\t        sig += SPX_N * SPX_FORS_HEIGHT;\n   154\t    }\n   155\t\n   156\t    /* Hash horizontally across all tree roots to derive the public key. */\n   157\t    thash(pk, roots, SPX_FORS_TREES, ctx, fors_pk_addr);\n   158\t}\n===== merkle.c =====\n     1\t#include <stdint.h>\n     2\t#include <string.h>\n     3\t\n     4\t#include \"../include/address.h\"\n     5\t#include \"../include/merkle.h\"\n     6\t#include \"../include/params.h\"\n     7\t#include \"../include/utils.h\"\n     8\t#include \"../include/utilsx1.h\"\n     9\t#include \"../include/wots.h\"\n    10\t#include \"../include/wotsx1.h\"\n    11\t\n    12\t/*\n    13\t * This generates a Merkle signature (WOTS signature followed by the Merkle\n    14\t * authentication path).  This is in this file because most of the complexity\n    15\t * is involved with the WOTS signature; the Merkle authentication path logic\n    16\t * is mostly hidden in treehashx4\n    17\t */\n    18\tvoid merkle_sign(uint8_t *sig, unsigned char *root,\n    19\t                 const spx_ctx *ctx,\n    20\t                 uint32_t wots_addr[8], uint32_t tree_addr[8],\n    21\t                 uint32_t idx_leaf)\n    22\t{\n    23\t    unsigned char *auth_path = sig + SPX_WOTS_BYTES;\n    24\t    struct leaf_info_x1 info = { 0 };\n    25\t    unsigned steps[ SPX_WOTS_LEN ];\n    26\t\n    27\t    info.wots_sig = sig;\n    28\t    chain_lengths(steps, root);\n    29\t    info.wots_steps = steps;\n    30\t\n    31\t    set_type(&tree_addr[0], SPX_ADDR_TYPE_HASHTREE);\n    32\t    set_type(&info.pk_addr[0], SPX_ADDR_TYPE_WOTSPK);\n    33\t    copy_subtree_addr(&info.leaf_addr[0], wots_addr);\n    34\t    copy_subtree_addr(&info.pk_addr[0], wots_addr);\n    35\t\n    36\t    info.wots_sign_leaf = idx_leaf;\n    37\t\n    38\t    wots_treehashx1(root, auth_path, ctx,\n    39\t                idx_leaf, 0,\n    40\t                SPX_TREE_HEIGHT,\n    41\t                tree_addr, &info);\n    42\t}\n    43\t\n    44\t/* Compute root node of the top-most subtree. */\n    45\tvoid merkle_gen_root(unsigned char *root, const spx_ctx *ctx)\n    46\t{\n    47\t    /* We do not need the auth path in key generation, but it simplifies the\n    48\t       code to have just one treehash routine that computes both root and path\n    49\t       in one function. */\n    50\t    unsigned char auth_path[SPX_TREE_HEIGHT * SPX_N + SPX_WOTS_BYTES];\n    51\t    uint32_t top_tree_addr[8] = {0};\n    52\t    uint32_t wots_addr[8] = {0};\n    53\t\n    54\t    set_layer_addr(top_tree_addr, SPX_D - 1);\n    55\t    set_layer_addr(wots_addr, SPX_D - 1);\n    56\t\n    57\t    merkle_sign(auth_path, root, ctx,\n    58\t                wots_addr, top_tree_addr,\n    59\t                (uint32_t)~0 /* ~0 means \"don't bother generating an auth path */ );\n    60\t}\n===== sign.c =====\n     1\t#include <stddef.h>\n     2\t#include <string.h>\n     3\t#include <stdint.h>\n     4\t\n     5\t#include \"../include/address.h\"\n     6\t#include \"../include/api.h\"\n     7\t#include \"../include/fors.h\"\n     8\t#include \"../include/hash.h\"\n     9\t#include \"../include/merkle.h\"\n    10\t#include \"../include/params.h\"\n    11\t#include \"../include/randombytes.h\"\n    12\t#include \"../include/thash.h\"\n    13\t#include \"../include/utils.h\"\n    14\t#include \"../include/wots.h\"\n    15\t\n    16\t/*\n    17\t * Returns the length of a secret key, in bytes\n    18\t */\n    19\tunsigned long long crypto_sign_secretkeybytes(void)\n    20\t{\n    21\t    return CRYPTO_SECRETKEYBYTES;\n    22\t}\n    23\t\n    24\t/*\n    25\t * Returns the length of a public key, in bytes\n    26\t */\n    27\tunsigned long long crypto_sign_publickeybytes(void)\n    28\t{\n    29\t    return CRYPTO_PUBLICKEYBYTES;\n    30\t}\n    31\t\n    32\t/*\n    33\t * Returns the length of a signature, in bytes\n    34\t */\n    35\tunsigned long long crypto_sign_bytes(void)\n    36\t{\n    37\t    return CRYPTO_BYTES;\n    38\t}\n    39\t\n    40\t/*\n    41\t * Returns the length of the seed required to generate a key pair, in bytes\n    42\t */\n    43\tunsigned long long crypto_sign_seedbytes(void)\n    44\t{\n    45\t    return CRYPTO_SEEDBYTES;\n    46\t}\n    47\t\n    48\t/*\n    49\t * Generates an SPX key pair given a seed of length\n    50\t * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]\n    51\t * Format pk: [PUB_SEED || root]\n    52\t */\n    53\tint crypto_sign_seed_keypair(unsigned char *pk, unsigned char *sk,\n    54\t                             const unsigned char *seed)\n    55\t{\n    56\t    spx_ctx ctx;\n    57\t\n    58\t    /* Initialize SK_SEED, SK_PRF and PUB_SEED from seed. */\n    59\t    memcpy(sk, seed, CRYPTO_SEEDBYTES);\n    60\t\n    61\t    memcpy(pk, sk + 2*SPX_N, SPX_N);\n    62\t\n    63\t    memcpy(ctx.pub_seed, pk, SPX_N);\n    64\t    memcpy(ctx.sk_seed, sk, SPX_N);\n    65\t\n    66\t    /* This hook allows the hash function instantiation to do whatever\n    67\t       preparation or computation it needs, based on the public seed. */\n    68\t    initialize_hash_function(&ctx);\n    69\t\n    70\t    /* Compute root node of the top-most subtree. */\n    71\t    merkle_gen_root(sk + 3*SPX_N, &ctx);\n    72\t\n    73\t    memcpy(pk + SPX_N, sk + 3*SPX_N, SPX_N);\n    74\t\n    75\t    return 0;\n    76\t}\n    77\t\n    78\t/*\n    79\t * Generates an SPX key pair.\n    80\t * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]\n    81\t * Format pk: [PUB_SEED || root]\n    82\t */\n    83\tint crypto_sign_keypair(unsigned char *pk, unsigned char *sk)\n    84\t{\n    85\t  unsigned char seed[CRYPTO_SEEDBYTES];\n    86\t  randombytes(seed, CRYPTO_SEEDBYTES);\n    87\t  crypto_sign_seed_keypair(pk, sk, seed);\n    88\t\n    89\t  return 0;\n    90\t}\n    91\t\n    92\t/**\n    93\t * Returns an array containing a detached signature.\n    94\t */\n    95\tint crypto_sign_signature(uint8_t *sig, size_t *siglen,\n    96\t                          const uint8_t *m, size_t mlen, const uint8_t *sk)\n    97\t{\n    98\t    spx_ctx ctx;\n    99\t\n   100\t    const unsigned char *sk_prf = sk + SPX_N;\n   101\t    const unsigned char *pk = sk + 2*SPX_N;\n   102\t\n   103\t    unsigned char optrand[SPX_N];\n   104\t    unsigned char mhash[SPX_FORS_MSG_BYTES];\n   105\t    unsigned char root[SPX_N];\n   106\t    uint32_t i;\n   107\t    uint64_t tree;\n   108\t    uint32_t idx_leaf;\n   109\t    uint32_t wots_addr[8] = {0};\n   110\t    uint32_t tree_addr[8] = {0};\n   111\t\n   112\t    memcpy(ctx.sk_seed, sk, SPX_N);\n   113\t    memcpy(ctx.pub_seed, pk, SPX_N);\n   114\t\n   115\t    /* This hook allows the hash function instantiation to do whatever\n   116\t       preparation or computation it needs, based on the public seed. */\n   117\t    initialize_hash_function(&ctx);\n   118\t\n   119\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n   120\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n   121\t\n   122\t    /* Optionally, signing can be made non-deterministic using optrand.\n   123\t       This can help counter side-channel attacks that would benefit from\n   124\t       getting a large number of traces when the signer uses the same nodes. */\n   125\t    randombytes(optrand, SPX_N);\n   126\t    /* Compute the digest randomization value. */\n   127\t    gen_message_random(sig, sk_prf, optrand, m, mlen, &ctx);\n   128\t\n   129\t    /* Derive the message digest and leaf index from R, PK and M. */\n   130\t    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);\n   131\t    sig += SPX_N;\n   132\t\n   133\t    set_tree_addr(wots_addr, tree);\n   134\t    set_keypair_addr(wots_addr, idx_leaf);\n   135\t\n   136\t    /* Sign the message hash using FORS. */\n   137\t    fors_sign(sig, root, mhash, &ctx, wots_addr);\n   138\t    sig += SPX_FORS_BYTES;\n   139\t\n   140\t    for (i = 0; i < SPX_D; i++) {\n   141\t        set_layer_addr(tree_addr, i);\n   142\t        set_tree_addr(tree_addr, tree);\n   143\t\n   144\t        copy_subtree_addr(wots_addr, tree_addr);\n   145\t        set_keypair_addr(wots_addr, idx_leaf);\n   146\t\n   147\t        merkle_sign(sig, root, &ctx, wots_addr, tree_addr, idx_leaf);\n   148\t        sig += SPX_WOTS_BYTES + SPX_TREE_HEIGHT * SPX_N;\n   149\t\n   150\t        /* Update the indices for the next layer. */\n   151\t        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));\n   152\t        tree = tree >> SPX_TREE_HEIGHT;\n   153\t    }\n   154\t\n   155\t    *siglen = SPX_BYTES;\n   156\t\n   157\t    return 0;\n   158\t}\n   159\t\n   160\t/**\n   161\t * Verifies a detached signature and message under a given public key.\n   162\t */\n   163\tint crypto_sign_verify(const uint8_t *sig, size_t siglen,\n   164\t                       const uint8_t *m, size_t mlen, const uint8_t *pk)\n   165\t{\n   166\t    spx_ctx ctx;\n   167\t    const unsigned char *pub_root = pk + SPX_N;\n   168\t    unsigned char mhash[SPX_FORS_MSG_BYTES];\n   169\t    unsigned char wots_pk[SPX_WOTS_BYTES];\n   170\t    unsigned char root[SPX_N];\n   171\t    unsigned char leaf[SPX_N];\n   172\t    unsigned int i;\n   173\t    uint64_t tree;\n   174\t    uint32_t idx_leaf;\n   175\t    uint32_t wots_addr[8] = {0};\n   176\t    uint32_t tree_addr[8] = {0};\n   177\t    uint32_t wots_pk_addr[8] = {0};\n   178\t\n   179\t    if (siglen != SPX_BYTES) {\n   180\t        return -1;\n   181\t    }\n   182\t\n   183\t    memcpy(ctx.pub_seed, pk, SPX_N);\n   184\t\n   185\t    /* This hook allows the hash function instantiation to do whatever\n   186\t       preparation or computation it needs, based on the public seed. */\n   187\t    initialize_hash_function(&ctx);\n   188\t\n   189\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n   190\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n   191\t    set_type(wots_pk_addr, SPX_ADDR_TYPE_WOTSPK);\n   192\t\n   193\t    /* Derive the message digest and leaf index from R || PK || M. */\n   194\t    /* The additional SPX_N is a result of the hash domain separator. */\n   195\t    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);\n   196\t    sig += SPX_N;\n   197\t\n   198\t    /* Layer correctly defaults to 0, so no need to set_layer_addr */\n   199\t    set_tree_addr(wots_addr, tree);\n   200\t    set_keypair_addr(wots_addr, idx_leaf);\n   201\t\n   202\t    fors_pk_from_sig(root, sig, mhash, &ctx, wots_addr);\n   203\t    sig += SPX_FORS_BYTES;\n   204\t\n   205\t    /* For each subtree.. */\n   206\t    for (i = 0; i < SPX_D; i++) {\n   207\t        set_layer_addr(tree_addr, i);\n   208\t        set_tree_addr(tree_addr, tree);\n   209\t\n   210\t        copy_subtree_addr(wots_addr, tree_addr);\n   211\t        set_keypair_addr(wots_addr, idx_leaf);\n   212\t\n   213\t        copy_keypair_addr(wots_pk_addr, wots_addr);\n   214\t\n   215\t        /* The WOTS public key is only correct if the signature was correct. */\n   216\t        /* Initially, root is the FORS pk, but on subsequent iterations it is\n   217\t           the root of the subtree below the currently processed subtree. */\n   218\t        wots_pk_from_sig(wots_pk, sig, root, &ctx, wots_addr);\n   219\t        sig += SPX_WOTS_BYTES;\n   220\t\n   221\t        /* Compute the leaf node using the WOTS public key. */\n   222\t        thash(leaf, wots_pk, SPX_WOTS_LEN, &ctx, wots_pk_addr);\n   223\t\n   224\t        /* Compute the root node of this subtree. */\n   225\t        compute_root(root, leaf, idx_leaf, 0, sig, SPX_TREE_HEIGHT,\n   226\t                     &ctx, tree_addr);\n   227\t        sig += SPX_TREE_HEIGHT * SPX_N;\n   228\t\n   229\t        /* Update the indices for the next layer. */\n   230\t        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));\n   231\t        tree = tree >> SPX_TREE_HEIGHT;\n   232\t    }\n   233\t\n   234\t    /* Check if the root node equals the root node in the public key. */\n   235\t    if (memcmp(root, pub_root, SPX_N)) {\n   236\t        return -1;\n   237\t    }\n   238\t\n   239\t    return 0;\n   240\t}\n   241\t\n   242\t\n   243\t/**\n   244\t * Returns an array containing the signature followed by the message.\n   245\t */\n   246\tint crypto_sign(unsigned char *sm, unsigned long long *smlen,\n   247\t                const unsigned char *m, unsigned long long mlen,\n   248\t                const unsigned char *sk)\n   249\t{\n   250\t    size_t siglen;\n   251\t\n   252\t    crypto_sign_signature(sm, &siglen, m, (size_t)mlen, sk);\n   253\t\n   254\t    memmove(sm + SPX_BYTES, m, mlen);\n   255\t    *smlen = siglen + mlen;\n   256\t\n   257\t    return 0;\n   258\t}\n   259\t\n   260\t/**\n   261\t * Verifies a given signature-message pair under a given public key.\n   262\t */\n   263\tint crypto_sign_open(unsigned char *m, unsigned long long *mlen,\n   264\t                     const unsigned char *sm, unsigned long long smlen,\n   265\t                     const unsigned char *pk)\n   266\t{\n   267\t    /* The API caller does not necessarily know what size a signature should be\n   268\t       but SPHINCS+ signatures are always exactly SPX_BYTES. */\n   269\t    if (smlen < SPX_BYTES) {\n   270\t        memset(m, 0, smlen);\n   271\t        *mlen = 0;\n   272\t        return -1;\n   273\t    }\n   274\t\n   275\t    *mlen = smlen - SPX_BYTES;\n   276\t\n   277\t    if (crypto_sign_verify(sm, SPX_BYTES, sm + SPX_BYTES, (size_t)*mlen, pk)) {\n   278\t        memset(m, 0, smlen);\n   279\t        *mlen = 0;\n   280\t        return -1;\n   281\t    }\n   282\t\n   283\t    /* If verification was successful, move the message to the right place. */\n   284\t    memmove(m, sm + SPX_BYTES, *mlen);\n   285\t\n   286\t    return 0;\n   287\t}\n","numLines":1131,"startLine":1,"totalLines":1131}}}
