\n    } else {\n        let ps = &*(personalization_string as *const [u8; 48]);\n        randombytes_init(ent, Some(ps));\n    }\n}\n\n#[export_name = \"randombytes\"]\npub unsafe extern \"C\" fn c_randombytes(x: *mut u8, xlen: core::ffi::c_ulonglong) -> core::ffi::c_int {\n    let s = core::slice::from_raw_parts_mut(x, xlen as usize);\n    randombytes(s)\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1566,"cache_read_input_tokens":340414,"cache_creation":{"ephemeral_5m_input_tokens":1566,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"562c112f-521a-4b18-b7fd-2e147d3d0f73","uuid":"69bd4a02-81df-4260-9263-324087f2e09a","timestamp":"2026-08-28T23:04:51.709Z"}
