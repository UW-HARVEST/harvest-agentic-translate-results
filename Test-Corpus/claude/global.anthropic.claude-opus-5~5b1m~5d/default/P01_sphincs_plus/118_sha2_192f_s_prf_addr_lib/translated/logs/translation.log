7\t\n    88\t/*\n    89\t * Specify the height of the node in the Merkle/FORS tree we are in\n    90\t * (the tree height)\n    91\t */\n    92\tvoid set_tree_height(uint32_t addr[8], uint32_t tree_height)\n    93\t{\n    94\t    ((unsigned char *)addr)[SPX_OFFSET_TREE_HGT] = (unsigned char)tree_height;\n    95\t}\n    96\t\n    97\t/*\n    98\t * Specify the distance from the left edge of the node in the Merkle/FORS tree\n    99\t * (the tree index)\n   100\t */\n   101\tvoid set_tree_index(uint32_t addr[8], uint32_t tree_index)\n   102\t{\n   103\t    u32_to_bytes(&((unsigned char *)addr)[SPX_OFFSET_TREE_INDEX], tree_index );\n   104\t}\n===== utils.c =====\n     1\t#include <string.h>\n     2\t\n     3\t#include \"../include/address.h\"\n     4\t#include \"../include/hash.h\"\n     5\t#include \"../include/params.h\"\n     6\t#include \"../include/thash.h\"\n     7\t#include \"../include/utils.h\"\n     8\t\n     9\t/**\n    10\t * Converts the value of 'in' to 'outlen' bytes in big-endian byte order.\n    11\t */\n    12\tvoid ull_to_bytes(unsigned char *out, unsigned int outlen,\n    13\t                  unsigned long long in)\n    14\t{\n    15\t    int i;\n    16\t\n    17\t    /* Iterate over out in decreasing order, for big-endianness. */\n    18\t    for (i = (signed int)outlen - 1; i >= 0; i--) {\n    19\t        out[i] = in & 0xff;\n    20\t        in = in >> 8;\n    21\t    }\n    22\t}\n    23\t\n    24\tvoid u32_to_bytes(unsigned char *out, uint32_t in)\n    25\t{\n    26\t    out[0] = (unsigned char)(in >> 24);\n    27\t    out[1] = (unsigned char)(in >> 16);\n    28\t    out[2] = (unsigned char)(in >> 8);\n    29\t    out[3] = (unsigned char)in;\n    30\t}\n    31\t\n    32\t/**\n    33\t * Converts the inlen bytes in 'in' from big-endian byte order to an integer.\n    34\t */\n    35\tunsigned long long bytes_to_ull(const unsigned char *in, unsigned int inlen)\n    36\t{\n    37\t    unsigned long long retval = 0;\n    38\t    unsigned int i;\n    39\t\n    40\t    for (i = 0; i < inlen; i++) {\n    41\t        retval |= ((unsigned long long)in[i]) << (8*(inlen - 1 - i));\n    42\t    }\n    43\t    return retval;\n    44\t}\n    45\t\n    46\t/**\n    47\t * Computes a root node given a leaf and an auth path.\n    48\t * Expects address to be complete other than the tree_height and tree_index.\n    49\t */\n    50\tvoid compute_root(unsigned char *root, const unsigned char *leaf,\n    51\t                  uint32_t leaf_idx, uint32_t idx_offset,\n    52\t                  const unsigned char *auth_path, uint32_t tree_height,\n    53\t                  const spx_ctx *ctx, uint32_t addr[8])\n    54\t{\n    55\t    uint32_t i;\n    56\t    unsigned char buffer[2 * SPX_N];\n    57\t\n    58\t    /* If leaf_idx is odd (last bit = 1), current path element is a right child\n    59\t       and auth_path has to go left. Otherwise it is the other way around. */\n    60\t    if (leaf_idx & 1) {\n    61\t        memcpy(buffer + SPX_N, leaf, SPX_N);\n    62\t        memcpy(buffer, auth_path, SPX_N);\n    63\t    }\n    64\t    else {\n    65\t        memcpy(buffer, leaf, SPX_N);\n    66\t        memcpy(buffer + SPX_N, auth_path, SPX_N);\n    67\t    }\n    68\t    auth_path += SPX_N;\n    69\t\n    70\t    for (i = 0; i < tree_height - 1; i++) {\n    71\t        leaf_idx >>= 1;\n    72\t        idx_offset >>= 1;\n    73\t        /* Set the address of the node we're creating. */\n    74\t        set_tree_height(addr, i + 1);\n    75\t        set_tree_index(addr, leaf_idx + idx_offset);\n    76\t\n    77\t        /* Pick the right or left neighbor, depending on parity of the node. */\n    78\t        if (leaf_idx & 1) {\n    79\t            thash(buffer + SPX_N, buffer, 2, ctx, addr);\n    80\t            memcpy(buffer, auth_path, SPX_N);\n    81\t        }\n    82\t        else {\n    83\t            thash(buffer, buffer, 2, ctx, addr);\n    84\t            memcpy(buffer + SPX_N, auth_path, SPX_N);\n    85\t        }\n    86\t        auth_path += SPX_N;\n    87\t    }\n    88\t\n    89\t    /* The last iteration is exceptional; we do not copy an auth_path node. */\n    90\t    leaf_idx >>= 1;\n    91\t    idx_offset >>= 1;\n    92\t    set_tree_height(addr, tree_height);\n    93\t    set_tree_index(addr, leaf_idx + idx_offset);\n    94\t    thash(root, buffer, 2, ctx, addr);\n    95\t}\n    96\t\n    97\t/**\n    98\t * For a given leaf index, computes the authentication path and the resulting\n    99\t * root node using Merkle's TreeHash algorithm.\n   100\t * Expects the layer and tree parts of the tree_addr to be set, as well as the\n   101\t * tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE).\n   102\t * Applies the offset idx_offset to indices before building addresses, so that\n   103\t * it is possible to continue counting indices across trees.\n   104\t */\n   105\tvoid treehash(unsigned char *root, unsigned char *auth_path, const spx_ctx* ctx,\n   106\t              uint32_t leaf_idx, uint32_t idx_offset, uint32_t tree_height,\n   107\t              void (*gen_leaf)(\n   108\t                 unsigned char* /* leaf */,\n   109\t                 const spx_ctx* /* ctx */,\n   110\t                 uint32_t /* addr_idx */, const uint32_t[8] /* tree_addr */),\n   111\t              uint32_t tree_addr[8])\n   112\t{\n   113\t    SPX_VLA(uint8_t, stack, (tree_height+1)*SPX_N);\n   114\t    SPX_VLA(unsigned int, heights, tree_height+1);\n   115\t    unsigned int offset = 0;\n   116\t    uint32_t idx;\n   117\t    uint32_t tree_idx;\n   118\t\n   119\t    for (idx = 0; idx < (uint32_t)(1 << tree_height); idx++) {\n   120\t        /* Add the next leaf node to the stack. */\n   121\t        gen_leaf(stack + offset*SPX_N, ctx, idx + idx_offset, tree_addr);\n   122\t        offset++;\n   123\t        heights[offset - 1] = 0;\n   124\t\n   125\t        /* If this is a node we need for the auth path.. */\n   126\t        if ((leaf_idx ^ 0x1) == idx) {\n   127\t            memcpy(auth_path, stack + (offset - 1)*SPX_N, SPX_N);\n   128\t        }\n   129\t\n   130\t        /* While the top-most nodes are of equal height.. */\n   131\t        while (offset >= 2 && heights[offset - 1] == heights[offset - 2]) {\n   132\t            /* Compute index of the new node, in the next layer. */\n   133\t            tree_idx = (idx >> (heights[offset - 1] + 1));\n   134\t\n   135\t            /* Set the address of the node we're creating. */\n   136\t            set_tree_height(tree_addr, heights[offset - 1] + 1);\n   137\t            set_tree_index(tree_addr,\n   138\t                           tree_idx + (idx_offset >> (heights[offset-1] + 1)));\n   139\t            /* Hash the top-most nodes from the stack together. */\n   140\t            thash(stack + (offset - 2)*SPX_N,\n   141\t                  stack + (offset - 2)*SPX_N, 2, ctx, tree_addr);\n   142\t            offset--;\n   143\t            /* Note that the top-most node is now one layer higher. */\n   144\t            heights[offset - 1]++;\n   145\t\n   146\t            /* If this is a node we need for the auth path.. */\n   147\t            if (((leaf_idx >> heights[offset - 1]) ^ 0x1) == tree_idx) {\n   148\t                memcpy(auth_path + heights[offset - 1]*SPX_N,\n   149\t                       stack + (offset - 1)*SPX_N, SPX_N);\n   150\t            }\n   151\t        }\n   152\t    }\n   153\t    memcpy(root, stack, SPX_N);\n   154\t}\n===== utilsx1.c =====\n     1\t#include <string.h>\n     2\t\n     3\t#include \"../include/address.h\"\n     4\t#include \"../include/params.h\"\n     5\t#include \"../include/forsx1.h\"\n     6\t#include \"../include/thash.h\"\n     7\t#include \"../include/utils.h\"\n     8\t#include \"../include/utilsx1.h\"\n     9\t\n    10\t/*\n    11\t * Generate the entire Merkle tree, computing the authentication path for\n    12\t * leaf_idx, and the resulting root node using Merkle's TreeHash algorithm.\n    13\t * Expects the layer and tree parts of the tree_addr to be set, as well as the\n    14\t * tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE)\n    15\t *\n    16\t * This expects tree_addr to be initialized to the addr structures for the\n    17\t * Merkle tree nodes\n    18\t *\n    19\t * Applies the offset idx_offset to indices before building addresses, so that\n    20\t * it is possible to continue counting indices across trees.\n    21\t *\n    22\t * This works by using the standard Merkle tree building algorithm,\n    23\t */\n    24\tvoid wots_treehashx1(unsigned char *root, unsigned char *auth_path,\n    25\t\t\t     const spx_ctx* ctx,\n    26\t\t\t     uint32_t leaf_idx, uint32_t idx_offset,\n    27\t\t\t     uint32_t tree_height,\n    28\t\t\t     uint32_t tree_addr[8],\n    29\t\t\t     leaf_info_x1 *info)\n    30\t{\n    31\t    /* This is where we keep the intermediate nodes */\n    32\t    SPX_VLA(uint8_t, stack, tree_height*SPX_N);\n    33\t\n    34\t    uint32_t idx;\n    35\t    uint32_t max_idx = (uint32_t)((1 << tree_height) - 1);\n    36\t    for (idx = 0;; idx++) {\n    37\t        unsigned char current[2*SPX_N];   /* Current logical node is at */\n    38\t            /* index[SPX_N].  We do this to minimize the number of copies */\n    39\t            /* needed during a thash */\n    40\t        wots_gen_leafx1( &current[SPX_N], ctx, idx + idx_offset,\n    41\t\t\t\t info );\n    42\t\n    43\t        /* Now combine the freshly generated right node with previously */\n    44\t        /* generated left ones */\n    45\t        uint32_t internal_idx_offset = idx_offset;\n    46\t        uint32_t internal_idx = idx;\n    47\t        uint32_t internal_leaf = leaf_idx;\n    48\t        uint32_t h;     /* The height we are in the Merkle tree */\n    49\t        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {\n    50\t\n    51\t            /* Check if we hit the top of the tree */\n    52\t            if (h == tree_height) {\n    53\t                /* We hit the root; return it */\n    54\t                memcpy( root, &current[SPX_N], SPX_N );\n    55\t                return;\n    56\t            }\n    57\t\n    58\t            /*\n    59\t             * Check if the node we have is a part of the\n    60\t             * authentication path; if it is, write it out\n    61\t             */\n    62\t            if ((internal_idx ^ internal_leaf) == 0x01) {\n    63\t                memcpy( &auth_path[ h * SPX_N ],\n    64\t                        &current[SPX_N],\n    65\t                        SPX_N );\n    66\t            }\n    67\t\n    68\t            /*\n    69\t             * Check if we're at a left child; if so, stop going up the stack\n    70\t             * Exception: if we've reached the end of the tree, keep on going\n    71\t             * (so we combine the last 4 nodes into the one root node in two\n    72\t             * more iterations)\n    73\t             */\n    74\t            if ((internal_idx & 1) == 0 && idx < max_idx) {\n    75\t                break;\n    76\t            }\n    77\t\n    78\t            /* Ok, we're at a right node */\n    79\t            /* Now combine the left and right logical nodes together */\n    80\t\n    81\t            /* Set the address of the node we're creating. */\n    82\t            internal_idx_offset >>= 1;\n    83\t            set_tree_height(tree_addr, h + 1);\n    84\t            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\n    85\t\n    86\t            unsigned char *left = &stack[h * SPX_N];\n    87\t            memcpy( &current[0], left, SPX_N );\n    88\t            thash( &current[1 * SPX_N],\n    89\t                   &current[0 * SPX_N],\n    90\t                   2, ctx, tree_addr);\n    91\t        }\n    92\t\n    93\t        /* We've hit a left child; save the current for when we get the */\n    94\t        /* corresponding right right */\n    95\t        memcpy( &stack[h * SPX_N], &current[SPX_N], SPX_N);\n    96\t    }\n    97\t}\n    98\t\n    99\tvoid fors_treehashx1(unsigned char *root, unsigned char *auth_path,\n   100\t\t\t     const spx_ctx* ctx,\n   101\t\t\t     uint32_t leaf_idx, uint32_t idx_offset,\n   102\t\t\t     uint32_t tree_height,\n   103\t\t\t     uint32_t tree_addr[8],\n   104\t\t\t     leaf_info_x1 *info)\n   105\t{\n   106\t    /* This is where we keep the intermediate nodes */\n   107\t    SPX_VLA(uint8_t, stack, tree_height*SPX_N);\n   108\t\n   109\t    uint32_t idx;\n   110\t    uint32_t max_idx = (uint32_t)((1 << tree_height) - 1);\n   111\t    for (idx = 0;; idx++) {\n   112\t        unsigned char current[2*SPX_N];   /* Current logical node is at */\n   113\t            /* index[SPX_N].  We do this to minimize the number of copies */\n   114\t            /* needed during a thash */\n   115\t\n   116\t\t// IAN TODO: WARNING ON INFO PARAMETER\n   117\t        fors_gen_leafx1( &current[SPX_N], ctx, idx + idx_offset,\n   118\t\t\t\t info );\n   119\t\n   120\t        /* Now combine the freshly generated right node with previously */\n   121\t        /* generated left ones */\n   122\t        uint32_t internal_idx_offset = idx_offset;\n   123\t        uint32_t internal_idx = idx;\n   124\t        uint32_t internal_leaf = leaf_idx;\n   125\t        uint32_t h;     /* The height we are in the Merkle tree */\n   126\t        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {\n   127\t\n   128\t            /* Check if we hit the top of the tree */\n   129\t            if (h == tree_height) {\n   130\t                /* We hit the root; return it */\n   131\t                memcpy( root, &current[SPX_N], SPX_N );\n   132\t                return;\n   133\t            }\n   134\t\n   135\t            /*\n   136\t             * Check if the node we have is a part of the\n   137\t             * authentication path; if it is, write it out\n   138\t             */\n   139\t            if ((internal_idx ^ internal_leaf) == 0x01) {\n   140\t                memcpy( &auth_path[ h * SPX_N ],\n   141\t                        &current[SPX_N],\n   142\t                        SPX_N );\n   143\t            }\n   144\t\n   145\t            /*\n   146\t             * Check if we're at a left child; if so, stop going up the stack\n   147\t             * Exception: if we've reached the end of the tree, keep on going\n   148\t             * (so we combine the last 4 nodes into the one root node in two\n   149\t             * more iterations)\n   150\t             */\n   151\t            if ((internal_idx & 1) == 0 && idx < max_idx) {\n   152\t                break;\n   153\t            }\n   154\t\n   155\t            /* Ok, we're at a right node */\n   156\t            /* Now combine the left and right logical nodes together */\n   157\t\n   158\t            /* Set the address of the node we're creating. */\n   159\t            internal_idx_offset >>= 1;\n   160\t            set_tree_height(tree_addr, h + 1);\n   161\t            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\n   162\t\n   163\t            unsigned char *left = &stack[h * SPX_N];\n   164\t            memcpy( &current[0], left, SPX_N );\n   165\t            thash( &current[1 * SPX_N],\n   166\t                   &current[0 * SPX_N],\n   167\t                   2, ctx, tree_addr);\n   168\t        }\n   169\t\n   170\t        /* We've hit a left child; save the current for when we get the */\n   171\t        /* corresponding right right */\n   172\t        memcpy( &stack[h * SPX_N], &current[SPX_N], SPX_N);\n   173\t    }\n   174\t}\n===== wots.c =====\n     1\t#include <stdint.h>\n     2\t#include <string.h>\n     3\t\n     4\t#include \"../include/address.h\"\n     5\t#include \"../include/hash.h\"\n     6\t#include \"../include/params.h\"\n     7\t#include \"../include/thash.h\"\n     8\t#include \"../include/utils.h\"\n     9\t#include \"../include/utilsx1.h\"\n    10\t#include \"../include/wots.h\"\n    11\t#include \"../include/wotsx1.h\"\n    12\t\n    13\t// TODO clarify address expectations, and make them more uniform.\n    14\t// TODO i.e. do we expect types to be set already?\n    15\t// TODO and do we expect modifications or copies?\n    16\t\n    17\t/**\n    18\t * Computes the chaining function.\n    19\t * out and in have to be n-byte arrays.\n    20\t *\n    21\t * Interprets in as start-th value of the chain.\n    22\t * addr has to contain the address of the chain.\n    23\t */\n    24\tstatic void gen_chain(unsigned char *out, const unsigned char *in,\n    25\t                      unsigned int start, unsigned int steps,\n    26\t                      const spx_ctx *ctx, uint32_t addr[8])\n    27\t{\n    28\t    uint32_t i;\n    29\t\n    30\t    /* Initialize out with the value at position 'start'. */\n    31\t    memcpy(out, in, SPX_N);\n    32\t\n    33\t    /* Iterate 'steps' calls to the hash function. */\n    34\t    for (i = start; i < (start+steps) && i < SPX_WOTS_W; i++) {\n    35\t        set_hash_addr(addr, i);\n    36\t        thash(out, out, 1, ctx, addr);\n    37\t    }\n    38\t}\n    39\t\n    40\t/**\n    41\t * base_w algorithm as described in draft.\n    42\t * Interprets an array of bytes as integers in base w.\n    43\t * This only works when log_w is a divisor of 8.\n    44\t */\n    45\tstatic void base_w(unsigned int *output, const int out_len,\n    46\t                   const unsigned char *input)\n    47\t{\n    48\t    int in = 0;\n    49\t    int out = 0;\n    50\t    unsigned char total;\n    51\t    int bits = 0;\n    52\t    int consumed;\n    53\t\n    54\t    for (consumed = 0; consumed < out_len; consumed++) {\n    55\t        if (bits == 0) {\n    56\t            total = input[in];\n    57\t            in++;\n    58\t            bits += 8;\n    59\t        }\n    60\t        bits -= SPX_WOTS_LOGW;\n    61\t        output[out] = (total >> bits) & (SPX_WOTS_W - 1);\n    62\t        out++;\n    63\t    }\n    64\t}\n    65\t\n    66\t/* Computes the WOTS+ checksum over a message (in base_w). */\n    67\tstatic void wots_checksum(unsigned int *csum_base_w,\n    68\t                          const unsigned int *msg_base_w)\n    69\t{\n    70\t    unsigned int csum = 0;\n    71\t    unsigned char csum_bytes[(SPX_WOTS_LEN2 * SPX_WOTS_LOGW + 7) / 8];\n    72\t    unsigned int i;\n    73\t\n    74\t    /* Compute checksum. */\n    75\t    for (i = 0; i < SPX_WOTS_LEN1; i++) {\n    76\t        csum += SPX_WOTS_W - 1 - msg_base_w[i];\n    77\t    }\n    78\t\n    79\t    /* Convert checksum to base_w. */\n    80\t    /* Make sure expected empty zero bits are the least significant bits. */\n    81\t    csum = csum << ((8 - ((SPX_WOTS_LEN2 * SPX_WOTS_LOGW) % 8)) % 8);\n    82\t    ull_to_bytes(csum_bytes, sizeof(csum_bytes), csum);\n    83\t    base_w(csum_base_w, SPX_WOTS_LEN2, csum_bytes);\n    84\t}\n    85\t\n    86\t/* Takes a message and derives the matching chain lengths. */\n    87\tvoid chain_lengths(unsigned int *lengths, const unsigned char *msg)\n    88\t{\n    89\t    base_w(lengths, SPX_WOTS_LEN1, msg);\n    90\t    wots_checksum(lengths + SPX_WOTS_LEN1, lengths);\n    91\t}\n    92\t\n    93\t/**\n    94\t * Takes a WOTS signature and an n-byte message, computes a WOTS public key.\n    95\t *\n    96\t * Writes the computed public key to 'pk'.\n    97\t */\n    98\tvoid wots_pk_from_sig(unsigned char *pk,\n    99\t                      const unsigned char *sig, const unsigned char *msg,\n   100\t                      const spx_ctx *ctx, uint32_t addr[8])\n   101\t{\n   102\t    unsigned int lengths[SPX_WOTS_LEN];\n   103\t    uint32_t i;\n   104\t\n   105\t    chain_lengths(lengths, msg);\n   106\t\n   107\t    for (i = 0; i < SPX_WOTS_LEN; i++) {\n   108\t        set_chain_addr(addr, i);\n   109\t        gen_chain(pk + i*SPX_N, sig + i*SPX_N,\n   110\t                  lengths[i], SPX_WOTS_W - 1 - lengths[i], ctx, addr);\n   111\t    }\n   112\t}\n===== wotsx1.c =====\n     1\t#include <stdint.h>\n     2\t#include <string.h>\n     3\t\n     4\t#include \"../include/address.h\"\n     5\t#include \"../include/hash.h\"\n     6\t#include \"../include/params.h\"\n     7\t#include \"../include/thash.h\"\n     8\t#include \"../include/utils.h\"\n     9\t#include \"../include/wots.h\"\n    10\t#include \"../include/wotsx1.h\"\n    11\t\n    12\t/*\n    13\t * This generates a WOTS public key\n    14\t * It also generates the WOTS signature if leaf_info indicates\n    15\t * that we're signing with this WOTS key\n    16\t */\n    17\tvoid wots_gen_leafx1(unsigned char *dest,\n    18\t                   const spx_ctx *ctx,\n    19\t                   uint32_t leaf_idx, leaf_info_x1 *v_info) {\n    20\t    struct leaf_info_x1 *info = v_info;\n    21\t    uint32_t *leaf_addr = info->leaf_addr;\n    22\t    uint32_t *pk_addr = info->pk_addr;\n    23\t    unsigned int i, k;\n    24\t    unsigned char pk_buffer[ SPX_WOTS_BYTES ];\n    25\t    unsigned char *buffer;\n    26\t    uint32_t wots_k_mask;\n    27\t\n    28\t    if (leaf_idx == info->wots_sign_leaf) {\n    29\t        /* We're traversing the leaf that's signing; generate the WOTS */\n    30\t        /* signature */\n    31\t        wots_k_mask = 0;\n    32\t    } else {\n    33\t        /* Nope, we're just generating pk's; turn off the signature logic */\n    34\t        wots_k_mask = (uint32_t)~0;\n    35\t    }\n    36\t\n    37\t    set_keypair_addr( leaf_addr, leaf_idx );\n    38\t    set_keypair_addr( pk_addr, leaf_idx );\n    39\t\n    40\t    for (i = 0, buffer = pk_buffer; i < SPX_WOTS_LEN; i++, buffer += SPX_N) {\n    41\t        uint32_t wots_k = info->wots_steps[i] | wots_k_mask; /* Set wots_k to */\n    42\t            /* the step if we're generating a signature, ~0 if we're not */\n    43\t\n    44\t        /* Start with the secret seed */\n    45\t        set_chain_addr(leaf_addr, i);\n    46\t        set_hash_addr(leaf_addr, 0);\n    47\t        set_type(leaf_addr, SPX_ADDR_TYPE_WOTSPRF);\n    48\t\n    49\t       