;\n    46\t\n    47\t  blake256(outbuf, buf, SPX_N + SPX_ADDR_BYTES);\n    48\t\n    49\t  memcpy(out, outbuf, SPX_N);\n    50\t}\n    51\t\n    52\t/**\n    53\t * Computes the message-dependent randomness R, using a secret seed and an\n    54\t * optional randomization value as well as the message.\n    55\t */\n    56\tvoid gen_message_random(unsigned char *R, const unsigned char *sk_prf,\n    57\t\t\t\tconst unsigned char *optrand,\n    58\t\t\t\tconst unsigned char *m, unsigned long long mlen,\n    59\t\t\t\tconst spx_ctx *ctx)\n    60\t{\n    61\t  (void)ctx;\n    62\t  blakestateX S;\n    63\t\n    64\t  blakeX_init(&S);\n    65\t  blakeX_update(&S, sk_prf, SPX_N);\n    66\t  blakeX_update(&S, optrand, SPX_N);\n    67\t  blakeX_update(&S, m, mlen);\n    68\t  blakeX_final(&S, R);\n    69\t}\n    70\t\n    71\t/**\n    72\t * Computes the message hash using R, the public key, and the message.\n    73\t * Outputs the message digest and the index of the leaf. The index is split in\n    74\t * the tree index and the leaf index, for convenient copying to an address.\n    75\t */\n    76\tvoid hash_message(unsigned char *digest, uint64_t *tree, uint32_t *leaf_idx,\n    77\t\t\t  const unsigned char *R, const unsigned char *pk,\n    78\t\t\t  const unsigned char *m, unsigned long long mlen,\n    79\t\t\t  const spx_ctx *ctx)\n    80\t{\n    81\t  (void)ctx;\n    82\t#define SPX_TREE_BITS (SPX_TREE_HEIGHT * (SPX_D - 1))\n    83\t#define SPX_TREE_BYTES ((SPX_TREE_BITS + 7) / 8)\n    84\t#define SPX_LEAF_BITS SPX_TREE_HEIGHT\n    85\t#define SPX_LEAF_BYTES ((SPX_LEAF_BITS + 7) / 8)\n    86\t#define SPX_DGST_BYTES (SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES)\n    87\t\n    88\t  unsigned char buf[SPX_DGST_BYTES];\n    89\t  unsigned char *bufp = buf;\n    90\t  unsigned char seed[2*SPX_N + SPX_BLAKEX_OUTPUT_BYTES];\n    91\t  \n    92\t  blakestateX S;\n    93\t  blakeX_init(&S);\n    94\t  \n    95\t  blakeX_update(&S, R, SPX_N);\n    96\t  blakeX_update(&S, pk, SPX_PK_BYTES);\n    97\t  blakeX_update(&S, m, mlen);\n    98\t\n    99\t  blakeX_final(&S, seed+ 2 * SPX_N);\n   100\t\n   101\t  memcpy(seed, R, SPX_N);\n   102\t  memcpy(seed + SPX_N, pk, SPX_N);\n   103\t  \n   104\t  blakeX_mgf1(bufp, SPX_DGST_BYTES, seed, 2*SPX_N + SPX_BLAKEX_OUTPUT_BYTES);\n   105\t\n   106\t  memcpy(digest, bufp, SPX_FORS_MSG_BYTES);\n   107\t  bufp += SPX_FORS_MSG_BYTES;\n   108\t\n   109\t#if SPX_TREE_BITS > 64\n   110\t#error For given height and depth, 64 bits cannot represent all subtrees\n   111\t#endif\n   112\t\n   113\t  if (SPX_D == 1) {\n   114\t    *tree = 0;\n   115\t  } else {\n   116\t    *tree = bytes_to_ull(bufp, SPX_TREE_BYTES);\n   117\t    *tree &= (~(uint64_t)0) >> (64 - SPX_TREE_BITS);\n   118\t  }\n   119\t  bufp += SPX_TREE_BYTES;\n   120\t\n   121\t  *leaf_idx = (uint32_t)bytes_to_ull(bufp, SPX_LEAF_BYTES);\n   122\t  *leaf_idx &= (~(uint32_t)0) >> (32 - SPX_LEAF_BITS);\n   123\t}\n///// /local/home/scheschb/.harvest/work/harvest-work-QQSMlQ/c_src/lib/blake/src/thash_blake_simple.c\n     1\t#include <stdint.h>\n     2\t#include <string.h>\n     3\t\n     4\t#include \"../../../app/include/address.h\"\n     5\t#include \"../../../app/include/params.h\"\n     6\t#include \"../../../app/include/thash.h\"\n     7\t#include \"../../../app/include/utils.h\"\n     8\t\n     9\t#include \"../include/blake.h\"\n    10\t\n    11\t#if SPX_BLAKE512\n    12\tstatic void thash_512(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n    13\t\t\t      const spx_ctx *ctx, uint32_t addr[8]);\n    14\t#endif\n    15\t\n    16\t/**\n    17\t * Takes an array of inblocks concatenated arrays of SPX_N bytes.\n    18\t */\n    19\tvoid thash(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n    20\t           const spx_ctx *ctx, uint32_t addr[8])\n    21\t{\n    22\t#if SPX_BLAKE512\n    23\t    if (inblocks > 1) {\n    24\t\tthash_512(out, in, inblocks, ctx, addr);\n    25\t        return;\n    26\t 