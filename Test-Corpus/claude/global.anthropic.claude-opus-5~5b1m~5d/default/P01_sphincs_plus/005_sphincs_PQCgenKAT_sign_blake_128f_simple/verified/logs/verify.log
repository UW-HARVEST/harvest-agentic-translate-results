= [0u8; 48];\n            ps_copy.copy_from_slice(core::slice::from_raw_parts(personalization_string, 48));\n            super::randombytes_init(&ei_copy, Some(&ps_copy));\n        }\n    }\n\n    /// C ABI: `int randombytes(unsigned char *x, unsigned long long xlen)`\n    #[unsafe(no_mangle)]\n    pub unsafe extern \"C\" fn randombytes(x: *mut u8, xlen: u64) -> c_int {\n        let xs = core::slice::from_raw_parts_mut(x, xlen as usize);\n        super::randombytes(xs) as c_int\n    }\n}\n","structuredPatch":[{"oldStart":83,"oldLines":9,"newStart":83,"newLines":11,"lines":["     }"," }"," ","-/// `AES256_CTR_DRBG_struct DRBG_ctx;` -- a zero-initialised file-scope global in","-/// the C translation unit.","-static mut DRBG_CTX: Aes256CtrDrbgStruct = Aes256CtrDrbgStruct {","+/// `AES256_CTR_DRBG_struct DRBG_ctx;` -- a zero-initialised, *externally","+/// visible* file-scope global in the C translation unit (it is not `static`,","+/// so `libsphincs_core_det.so` exports the symbol `DRBG_ctx`).","+#[unsafe(no_mangle)]","+pub static mut DRBG_ctx: Aes256CtrDrbgStruct = Aes256CtrDrbgStruct {","     Key: [0u8; 32],","     V: [0u8; 16],","     reseed_counter: 0,"]},{"oldStart":95,"oldLines":7,"newStart":97,"newLines":7,"lines":[" /// `DRBG_ctx` directly.  Single-threaded use only, matching the C original."," #[inline]"," fn drbg_ctx() -> &'static mut Aes256CtrDrbgStruct {","-    unsafe { &mut *core::ptr::addr_of_mut!(DRBG_CTX) }","+    unsafe { &mut *core::ptr::addr_of_mut!(DRBG_ctx) }"," }"," "," // Use whatever AES implementation you have. (The C reference uses OpenSSL.)"]}],"userModified":false,"replaceAll":false}}
