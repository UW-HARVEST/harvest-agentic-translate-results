ght - 1; i++) {\n    71\t        leaf_idx >>= 1;\n    72\t        idx_offset >>= 1;\n    73\t        /* Set the address of the node we're creating. */\n    74\t        set_tree_height(addr, i + 1);\n    75\t        set_tree_index(addr, leaf_idx + idx_offset);\n    76\t\n    77\t        /* Pick the right or left neighbor, depending on parity of the node. */\n    78\t        if (leaf_idx & 1) {\n    79\t            thash(buffer + SPX_N, buffer, 2, ctx, addr);\n    80\t            memcpy(buffer, auth_path, SPX_N);\n    81\t        }\n    82\t        else {\n    83\t            thash(buffer, buffer, 2, ctx, addr);\n    84\t            memcpy(buffer + SPX_N, auth_path, SPX_N);\n    85\t        }\n    86\t        auth_path += SPX_N;\n    87\t    }\n    88\t\n    89\t    /* The last iteration is exceptional; we do not copy an auth_path node. */\n    90\t    leaf_idx >>= 1;\n    91\t    idx_offset >>= 1;\n    92\t    set_tree_height(addr, tree_height);\n    93\t    set_tree_index(addr, leaf_idx + idx_offset);\n    94\t    thash(root, buffer, 2, ctx, addr);\n    95\t}\n    96\t\n    97\t/**\n    98\t * For a given leaf index, computes the authentication path and the resulting\n    99\t * root node using Merkle's TreeHash algorithm.\n   100\t * Expects the layer and tree parts of the tree_addr to be set, as well as the\n   101\t * tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE).\n   102\t * Applies the offset idx_offset to indices before building addresses, so that\n   103\t * it is possible to continue counting indices across trees.\n   104\t */\n   105\tvoid treehash(unsigned char *root, unsigned char *auth_path, const spx_ctx* ctx,\n   106\t              uint32_t leaf_idx, uint32_t idx_offset, uint32_t tree_height,\n   107\t              void (*gen_leaf)(\n   108\t                 unsigned char* /* leaf */,\n   109\t                 const spx_ctx* /* ctx */,\n   110\t                 uint32_t /* addr_idx */, const uint32_t[8] /* tree_addr */),\n   111\t  