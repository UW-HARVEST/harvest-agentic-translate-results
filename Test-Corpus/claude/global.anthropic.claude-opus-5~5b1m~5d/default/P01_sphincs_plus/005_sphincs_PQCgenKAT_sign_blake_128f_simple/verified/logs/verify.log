nctions are used for OTS addresses. */\n    48\t\n    49\t/*\n    50\t * Specify which Merkle leaf we're working on; that is, which OTS keypair\n    51\t * we're talking about.\n    52\t */\n    53\tvoid set_keypair_addr(uint32_t addr[8], uint32_t keypair)\n    54\t{\n    55\t    u32_to_bytes(&((unsigned char *)addr)[SPX_OFFSET_KP_ADDR], keypair);\n    56\t}\n    57\t\n    58\t/*\n    59\t * Copy the layer, tree and keypair fields of the address structure.  This is\n    60\t * used when we're doing multiple things within the same OTS keypair\n    61\t */\n    62\tvoid copy_keypair_addr(uint32_t out[8], const uint32_t in[8])\n    63\t{\n    64\t    memcpy( out, in, SPX_OFFSET_TREE+8 );\n    65\t    memcpy( (unsigned char *)out + SPX_OFFSET_KP_ADDR, (unsigned char *)in + SPX_OFFSET_KP_ADDR, 4); \n    66\t}\n    67\t\n    68\t/*\n    69\t * Specify which Merkle chain within the OTS we're working with\n    70\t * (the chain address)\n    71\t */\n    72\tvoid set_chain_addr(uint32_t addr[8], uint32_t chain)\n    73\t{\n    74\t    ((unsigned char *)addr)[SPX_OFFSET_CHAIN_ADDR] = (unsigned char)chain;\n    75\t}\n    76\t\n    77\t/*\n    78\t * Specify where in the Merkle chain we are\n    79\t* (the hash address)\n    80\t */\n    81\tvoid set_hash_addr(uint32_t addr[8], uint32_t hash)\n    82\t{\n    83\t    ((unsigned char *)addr)[SPX_OFFSET_HASH_ADDR] = (unsigned char)hash;\n    84\t}\n    85\t\n    86\t/* These functions are used for all hash tree addresses (including FORS). */\n    87\t\n    88\t/*\n    89\t * Specify the height of the node in the Merkle/FORS tree we are in\n    90\t * (the tree height)\n    91\t */\n    92\tvoid set_tree_height(uint32_t addr[8], uint32_t tree_height)\n    93\t{\n    94\t    ((unsigned char *)addr)[SPX_OFFSET_TREE_HGT] = (unsigned char)tree_height;\n    95\t}\n    96\t\n    97\t/*\n    98\t * Specify the distance from the left edge of the node in the Merkle/FORS tree\n    99\t * (the tree index)\n   100\t */\n   101\tvoid set_tree