6],\n51\t        }\n52\t    }\n53\t}\n54\t\n55\timpl Default for AesXofStruct {\n56\t    fn default() -> Self {\n57\t        Self::new()\n58\t    }\n59\t}\n60\t\n61\t/// `AES256_CTR_DRBG_struct` from `rng.h`.\n62\t#[repr(C)]\n63\t#[derive(Clone)]\n64\tpub struct Aes256CtrDrbgStruct {\n65\t    pub Key: [u8; 32],\n66\t    pub V: [u8; 16],\n67\t    pub reseed_counter: i32,\n68\t}\n69\t\n70\timpl Aes256CtrDrbgStruct {\n71\t    pub fn new() -> Self {\n72\t        Aes256CtrDrbgStruct {\n73\t            Key: [0u8; 32],\n74\t            V: [0u8; 16],\n75\t            reseed_counter: 0,\n76\t        }\n77\t    }\n78\t}\n79\t\n80\timpl Default for Aes256CtrDrbgStruct {\n81\t    fn default() -> Self {\n82\t        Self::new()\n83\t    }\n84\t}\n85\t\n86\t/// `AES256_CTR_DRBG_struct DRBG_ctx;` -- a zero-initialised file-scope global in\n87\t/// the C translation unit.\n88\tstatic mut DRBG_CTX: Aes256CtrDrbgStruct = Aes256CtrDrbgStruct {\n89\t    Key: [0u8; 32],\n90\t    V: [0u8; 16],\n91\t    reseed_counter: 0,\n92\t};\n93\t\n94\t/// Borrow the module-global DRBG state, exactly as the C code touches\n95\t/// `DRBG_ctx` directly.  Single-threaded use only, matching the C original.\n96\t#[inline]\n97\tfn drbg_ctx() -> &'static mut Aes256CtrDrbgStruct {\n98\t    unsafe { &mut *core::ptr::addr_of_mut!(DRBG_CTX) }\n99\t}\n100\t\n101\t// Use whatever AES implementation you have. (The C reference uses OpenSSL.)\n102\t//    key    - 256-bit AES key\n103\t//    ctr    - a 128-bit plaintext value\n104\t//    buffer - a 128-bit ciphertext value\n105\tfn aes256_ecb(key: &[u8; 32], ctr: &[u8; 16], buffer: &mut [u8; 16]) {\n106\t    let cipher = Aes256::new(GenericArray::from_slice(key));\n107\t    let mut blk = *GenericArray::from_slice(ctr);\n108\t    cipher.encrypt_block(&mut blk);\n109\t    buffer.copy_from_slice(blk.as_slice());\n110\t}\n111\t\n112\t/// `seedexpander_init()`\n113\t///\n114\t/// * `ctx`         - stores the current state of an instance of the seed expander\n115\t/// * `seed`        - a 32 byte random value\n116\t/// * `diversifier` - an 8 byte diversifier\n117\t/// * `maxlen`      - maximum number of bytes (less than 2**32) generated under\n118\t///   this seed and diversifier\n119\tpub fn seedexpander_init(\n120\t    ctx: &mut AesXofStruct,\n121\t    seed: &[u8],\n122\t    diversifier: &[u8],\n123\t    maxlen: u64,\n124\t) -> i32 {\n125\t    if maxlen >= 0x1_0000_0000u64 {\n126\t        return RNG_BAD_MAXLEN;\n127\t    }\n128\t\n129\t    ctx.length_remaining = maxlen;\n130\t\n131\t    ctx.key.copy_from_slice(&seed[..32]);\n132\t\n133\t    ctx.ctr[..8].copy_from_slice(&diversifier[..8]);\n134\t    let mut maxlen = maxlen;\n135\t    ctx.ctr[11] = (maxlen % 256) as u8;\n136\t    maxlen >>= 8;\n137\t    ctx.ctr[10] = (maxlen % 256) as u8;\n138\t    maxlen >>= 8;\n139\t    ctx.ctr[9] = (maxlen % 256) as u8;\n140\t    maxlen >>= 8;\n141\t    ctx.ctr[8] = (maxlen % 256) as u8;\n142\t    for b in ctx.ctr[12..16].iter_mut() {\n143\t        *b = 0x00;\n144\t    }\n145\t\n146\t    ctx.buffer_pos = 16;\n147\t    ctx.buffer = [0x00u8; 16];\n148\t\n149\t    RNG_SUCCESS\n150\t}\n151\t\n152\t/// `seedexpander()`\n153\t///\n154\t/// * `ctx` - stores the current state of an instance of the seed expander\n155\t/// * `x`   - returns the XOF data (`xlen` in C is `x.len()` here)\n156\t///\n157\t/// The C `x == NULL` -> `RNG_BAD_OUTBUF` check cannot trigger through this safe\n158\t/// entry point; it is preserved in the `extern \"C\"` wrapper below.\n159\tpub fn seedexpander(ctx: &mut AesXofStruct, x: &mut [u8]) -> i32 {\n160\t    let mut xlen: u64 = x.len() as u64;\n161\t\n162\t    if xlen >= ctx.length_remaining {\n163\t        return RNG_BAD_REQ_LEN;\n164\t    }\n165\t\n166\t    ctx.length_remaining -= xlen;\n167\t\n168\t    let mut offset: u64 = 0;\n169\t    while xlen > 0 {\n170\t        // 16 - ctx->buffer_pos  (unsigned long arithmetic; buffer_pos <= 16)\n171\t        let avail: u64 = 16u64.wrapping_sub(ctx.buffer_pos);\n172\t\n173\t        if xlen <= avail {\n174\t            // buffer has what we need\n175\t            let bp = ctx.buffer_pos as usize;\n176\t            let n = xlen as usize;\n177\t            let off = offset as usize;\n178\t            x[off..off + n].copy_from_slice(&ctx.buffer[bp..bp + n]);\n179\t            ctx.buffer_pos += xlen;\n180\t\n181\t            return RNG_SUCCESS;\n182\t        }\n183\t\n184\t        // take what's in the buffer\n185\t        {\n186\t            let bp = ctx.buffer_pos as usize;\n187\t            let n = avail as usize;\n188\t            let off = offset as usize;\n189\t            x[off..off + n].copy_from_slice(&ctx.buffer[bp..bp + n]);\n190\t        }\n191\t        xlen -= avail;\n192\t        offset += avail;\n193\t\n194\t        let key = ctx.key;\n195\t        let ctr = ctx.ctr;\n196\t        aes256_ecb(&key, &ctr, &mut ctx.buffer);\n197\t        ctx.buffer_pos = 0;\n198\t\n199\t        // increment the counter\n200\t        let mut i: i32 = 15;\n201\t        while i >= 12 {\n202\t            if ctx.ctr[i as usize] == 0xff {\n203\t                ctx.ctr[i as usize] = 0x00;\n204\t            } else {\n205\t                ctx.ctr[i as usize] = ctx.ctr[i as usize].wrapping_add(1);\n206\t                break;\n207\t            }\n208\t            i -= 1;\n209\t        }\n210\t    }\n211\t\n212\t    RNG_SUCCESS\n213\t}\n214\t\n215\t/// `randombytes_init(unsigned char *entropy_input, unsigned char *personalization_string)`\n216\t///\n217\t/// Note the NIST API variant used here takes no `security_strength` argument.\n218\tpub fn randombytes_init(entropy_input: &[u8], personalization_string: Option<&[u8]>) {\n219\t    let mut seed_material = [0u8; 48];\n220\t\n221\t    seed_material.copy_from_slice(&entropy_input[..48]);\n222\t    if let Some(ps) = personalization_string {\n223\t        for i in 0..48 {\n224\t            seed_material[i] ^= ps[i];\n225\t        }\n226\t    }\n227\t\n228\t    let ctx = drbg_ctx();\n229\t    ctx.Key = [0x00u8; 32];\n230\t    ctx.V = [0x00u8; 16];\n231\t    AES256_CTR_DRBG_Update(Some(&seed_material), &mut ctx.Key, &mut ctx.V);\n232\t    ctx.reseed_counter = 1;\n233\t}\n234\t\n235\t/// `randombytes(unsigned char *x, unsigned long long xlen)`\n236\tpub fn randombytes(x: &mut [u8]) -> i32 {\n237\t    let mut block = [0u8; 16];\n238\t    let mut i: usize = 0;\n239\t    let mut xlen: u64 = x.len() as u64;\n240\t\n241\t    let ctx = drbg_ctx();\n242\t\n243\t    while xlen > 0 {\n244\t        // increment V\n245\t        let mut j: i32 = 15;\n246\t        while j >= 0 {\n247\t            if ctx.V[j as usize] == 0xff {\n248\t                ctx.V[j as usize] = 0x00;\n249\t            } else {\n250\t                ctx.V[j as usize] = ctx.V[j as usize].wrapping_add(1);\n251\t                break;\n252\t            }\n253\t            j -= 1;\n254\t        }\n255\t\n256\t        let key = ctx.Key;\n257\t        let v = ctx.V;\n258\t        aes256_ecb(&key, &v, &mut block);\n259\t\n260\t        if xlen > 15 {\n261\t            x[i..i + 16].copy_from_slice(&block);\n262\t            i += 16;\n263\t            xlen -= 16;\n264\t        } else {\n265\t            let n = xlen as usize;\n266\t            x[i..i + n].copy_from_slice(&block[..n]);\n267\t            xlen = 0;\n268\t        }\n269\t    }\n270\t\n271\t    AES256_CTR_DRBG_Update(None, &mut ctx.Key, &mut ctx.V);\n272\t    ctx.reseed_counter = ctx.reseed_counter.wrapping_add(1);\n273\t\n274\t    RNG_SUCCESS\n275\t}\n276\t\n277\t/// `AES256_CTR_DRBG_Update(unsigned char *provided_data, unsigned char *Key, unsigned char *V)`\n278\tpub fn AES256_CTR_DRBG_Update(provided_data: Option<&[u8]>, key: &mut [u8], v: &mut [u8]) {\n279\t    let mut temp = [0u8; 48];\n280\t\n281\t    for i in 0..3usize {\n282\t        // increment V\n283\t        let mut j: i32 = 15;\n284\t        while j >= 0 {\n285\t            if v[j as usize] == 0xff {\n286\t                v[j as usize] = 0x00;\n287\t            } else {\n288\t                v[j as usize] = v[j as usize].wrapping_add(1);\n289\t                break;\n290\t            }\n291\t            j -= 1;\n292\t        }\n293\t\n294\t        let mut k = [0u8; 32];\n295\t        k.copy_from_slice(&key[..32]);\n296\t        let mut c = [0u8; 16];\n297\t        c.copy_from_slice(&v[..16]);\n298\t        let mut out = [0u8; 16];\n299\t        aes256_ecb(&k, &c, &mut out);\n300\t        temp[16 * i..16 * i + 16].copy_from_slice(&out);\n301\t    }\n302\t\n303\t    if provided_data.is_some() {\n304\t        let pd = provided_data.unwrap();\n305\t        for i in 0..48 {\n306\t            temp[i] ^= pd[i];\n307\t        }\n308\t    }\n309\t\n310\t    key[..32].copy_from_slice(&temp[..32]);\n311\t    v[..16].copy_from_slice(&temp[32..48]);\n312\t}\n313\t\n314\t// ---------------------------------------------------------------------------\n315\t// C ABI exports.  `rng.h` declares these with plain (non-namespaced) names --\n316\t// there are no `SPX_NAMESPACE` macros in that header -- so the exported symbols\n317\t// are the bare C identifiers.  They live in a nested module purely so the Rust\n318\t// item names can match the C names exactly without colliding with the safe\n319\t// wrappers above.\n320\t// ---------------------------------------------------------------------------\n321\tpub mod ffi {\n322\t    use super::{AesXofStruct, RNG_BAD_OUTBUF};\n323\t    use core::ffi::c_int;\n324\t\n325\t    /// C ABI: `void AES256_CTR_DRBG_Update(unsigned char *provided_data, unsigned char *Key, unsigned char *V)`\n326\t    #[unsafe(no_mangle)]\n327\t    pub unsafe extern \"C\" fn AES256_CTR_DRBG_Update(\n328\t        provided_data: *mut u8,\n329\t        Key: *mut u8,\n330\t        V: *mut u8,\n331\t    ) {\n332\t        let key = core::slice::from_raw_parts_mut(Key, 32);\n333\t        let v = core::slice::from_raw_parts_mut(V, 16);\n334\t        if provided_data.is_null() {\n335\t            super::AES256_CTR_DRBG_Update(None, key, v);\n336\t        } else {\n337\t            // `pr