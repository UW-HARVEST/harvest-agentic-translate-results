ays of SPX_N bytes.\n    18\t */\n    19\tvoid thash(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n    20\t           const spx_ctx *ctx, uint32_t addr[8])\n    21\t{\n    22\t#if SPX_SHA512\n    23\t    if (inblocks > 1) {\n    24\t\tthash_512(out, in, inblocks, ctx, addr);\n    25\t        return;\n    26\t    }\n    27\t#endif\n    28\t    unsigned char outbuf[SPX_SHA256_OUTPUT_BYTES];\n    29\t    SPX_VLA(uint8_t, bitmask, inblocks * SPX_N);\n    30\t    SPX_VLA(uint8_t, buf, SPX_N + SPX_SHA256_OUTPUT_BYTES + inblocks*SPX_N);\n    31\t    uint8_t sha2_state[40];\n    32\t    unsigned int i;\n    33\t\n    34\t    memcpy(buf, ctx->pub_seed, SPX_N);\n    35\t    memcpy(buf + SPX_N, addr, SPX_SHA256_ADDR_BYTES);\n    36\t    mgf1_256(bitmask, inblocks * SPX_N, buf, SPX_N + SPX_SHA256_ADDR_BYTES);\n    37\t\n    38\t    /* Retrieve precomputed state containing pub_seed */\n    39\t    memcpy(sha2_state, ctx->state_seeded, 40 * sizeof(uint8_t));\n    40\t\n    41\t    for (i = 0; i < inblocks * SPX_N; i++) {\n    42\t        buf[SPX_N + SPX_SHA256_ADDR_BYTES + i] = in[i] ^ bitmask[i];\n    43\t    }\n    44\t\n    45\t    sha256_inc_finalize(outbuf, sha2_state, buf + SPX_N,\n    46\t                        SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);\n    47\t    memcpy(out, outbuf, SPX_N);\n    48\t}\n    49\t\n    50\t#if SPX_SHA512\n    51\tstatic void thash_512(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n    52\t           const spx_ctx *ctx, uint32_t addr[8])\n    53\t{\n    54\t    unsigned char outbuf[SPX_SHA512_OUTPUT_BYTES];\n    55\t    SPX_VLA(uint8_t, bitmask, inblocks * SPX_N);\n    56\t    SPX_VLA(uint8_t, buf, SPX_N + SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);\n    57\t    uint8_t sha2_state[72];\n    58\t    unsigned int i;\n    59\t\n    60\t    memcpy(buf, ctx->pub_seed, SPX_N);\n    61\t    memcpy(buf + SPX_N, addr, SPX_SHA256_ADDR_BYTES);\n    62\t    mgf1_512(bitmask, inblocks * SPX_N, buf, SPX_N + SPX_SH