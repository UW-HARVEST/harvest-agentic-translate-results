 32\tvoid initialize_hash_function(spx_ctx *ctx)\n    33\t{\n    34\t    seed_state(ctx);\n    35\t}\n    36\t\n    37\t/*\n    38\t * Computes PRF(pk_seed, sk_seed, addr).\n    39\t */\n    40\tvoid prf_addr(unsigned char *out, const spx_ctx *ctx,\n    41\t              const uint32_t addr[8])\n    42\t{\n    43\t    uint8_t sha2_state[40];\n    44\t    unsigned char buf[SPX_SHA256_ADDR_BYTES + SPX_N];\n    45\t    unsigned char outbuf[SPX_SHA256_OUTPUT_BYTES];\n    46\t\n    47\t    /* Retrieve precomputed state containing pub_seed */\n    48\t    memcpy(sha2_state, ctx->state_seeded, 40 * sizeof(uint8_t));\n    49\t\n    50\t    /* Remainder: ADDR^c ‖ SK.seed */\n    51\t    memcpy(buf, addr, SPX_SHA256_ADDR_BYTES);\n    52\t    memcpy(buf + SPX_SHA256_ADDR_BYTES, ctx->sk_seed, SPX_N);\n    53\t\n    54\t    sha256_inc_finalize(outbuf, sha2_state, buf, SPX_SHA256_ADDR_BYTES + SPX_N);\n    55\t\n    56\t    memcpy(out, outbuf, SPX_N);\n    57\t}\n    58\t\n    59\t/**\n    60\t * Computes the message-dependent randomness R, using a secret seed as a key\n    61\t * for HMAC, and an optional randomization value prefixed to the message.\n    62\t * This requires m to have at least SPX_SHAX_BLOCK_BYTES + SPX_N space\n    63\t * available in front of the pointer, i.e. before the message to use for the\n    64\t * prefix. This is necessary to prevent having to move the message around (and\n    65\t * allocate memory for it).\n    66\t */\n    67\tvoid gen_message_random(unsigned char *R, const unsigned char *sk_prf,\n    68\t                        const unsigned char *optrand,\n    69\t                        const unsigned char *m, unsigned long long mlen,\n    70\t                        const spx_ctx *ctx)\n    71\t{\n    72\t    (void)ctx;\n    73\t\n    74\t    unsigned char buf[SPX_SHAX_BLOCK_BYTES + SPX_SHAX_OUTPUT_BYTES];\n    75\t    uint8_t state[8 + SPX_SHAX_OUTPUT_BYTES];\n    76\t    int i;\n    77\t\n    78\t#if SPX_N > SPX_SHAX_BLOCK_BYTES\n    79\t    #error \"Currently only supports SPX_N of at most SPX_SHAX_BLOCK_BYTES\"\n    80\t#endif\n    81\t\n    82\t    /* This implements HMAC-SHA */\n    83\t    for (i = 0; i < SPX_N; i++) {\n    84\t        buf[i] = 0x36 ^ sk_prf[i];\n    85\t    }\n    86\t    memset(buf + SPX_N, 0x36, SPX_SHAX_BLOCK_BYTES - SPX_N);\n    87\t\n    88\t    shaX_inc_init(state);\n    89\t    shaX_inc_blocks(state, buf, 1);\n    90\t\n    91\t    memcpy(buf, optrand, SPX_N);\n    92\t\n    93\t    /* If optrand + message cannot fill up an entire block */\n    94\t    if (SPX_N + mlen < SPX_SHAX_BLOCK_BYTES) {\n    95\t        memcpy(buf + SPX_N, m, mlen);\n    96\t        shaX_inc_finalize(buf + SPX_SHAX_BLOCK_BYTES, state,\n    97\t                            buf, mlen + SPX_N);\n    98\t    }\n    99\t    /* Otherwise first fill a block, so that finalize only uses the message */\n   100\t    else {\n   101\t        memcpy(buf + SPX_N, m, SPX_SHAX_BLOCK_BYTES - SPX_N);\n   102\t        shaX_inc_blocks(state, buf, 1);\n   103\t\n   104\t        m += SPX_SHAX_BLOCK_BYTES - SPX_N;\n   105\t        mlen -= SPX_SHAX_BLOCK_BYTES - SPX_N;\n   106\t        shaX_inc_finalize(buf + SPX_SHAX_BLOCK_BYTES, state, m, mlen);\n   107\t    }\n   108\t\n   109\t    for (i = 0; i < SPX_N; i++) {\n   110\t        buf[i] = 0x5c ^ sk_prf[i];\n   111\t    }\n   112\t    memset(buf + SPX_N, 0x5c, SPX_SHAX_BLOCK_BYTES - SPX_N);\n   113\t\n   114\t    shaX(buf, buf, SPX_SHAX_BLOCK_BYTES + SPX_SHAX_OUTPUT_BYTES);\n   115\t    memcpy(R, buf, SPX_N);\n   116\t}\n   117\t\n   118\t/**\n   119\t * Computes the message hash using R, the public key, and the message.\n   120\t * Outputs the message digest and the index of the leaf. The index is split in\n   121\t * the tree index and the leaf index, for convenient copying to an address.\n   122\t */\n   123\tvoid hash_message(unsigned char *digest, uint64_t *tree, uint32_t *leaf_idx,\n   124\t                  const unsigned char *R, const unsigned char *pk,\n   125\t                  const unsigned char *m, unsigned long long mlen,\n   126\t                  const spx_ctx *ctx)\n   127\t{\n   128\t    (void)ctx;\n   129\t#define SPX_TREE_BITS (SPX_TREE_HEIGHT * (SPX_D - 1))\n   130\t#define SPX_TREE_BYTES ((SPX_TREE_BITS + 7) / 8)\n   131\t#define SPX_LEAF_BITS SPX_TREE_HEIGHT\n   132\t#define SPX_LEAF_BYTES ((SPX_LEAF_BITS + 7) / 8)\n   133\t#define SPX_DGST_BYTES (SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES)\n   134\t\n   135\t    unsigned char seed[2*SPX_N + SPX_SHAX_OUTPUT_BYTES];\n   136\t\n   137\t    /* Round to nearest multiple of SPX_SHAX_BLOCK_BYTES */\n   138\t#if (SPX_SHAX_BLOCK_BYTES & (SPX_SHAX_BLOCK_BYTES-1)) != 0\n   139\t    #error \"Assumes that SPX_SHAX_BLOCK_BYTES is a power of 2\"\n   140\t#endif\n   141\t#define SPX_INBLOCKS (((SPX_N + SPX_PK_BYTES + SPX_SHAX_BLOCK_BYTES - 1) & \\\n   142\t                        -SPX_SHAX_BLOCK_BYTES) / SPX_SHAX_BLOCK_BYTES)\n   143\t    unsigned char inbuf[SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES];\n   144\t\n   145\t    unsigned char buf[SPX_DGST_BYTES];\n   146\t    unsigned char *bufp = buf;\n   147\t    uint8_t state[8 + SPX_SHAX_OUTPUT_BYTES];\n   148\t\n   149\t    shaX_inc_init(state);\n   150\t\n   151\t    // seed: SHA-X(R ‖ PK.seed ‖ PK.root ‖ M)\n   152\t    memcpy(inbuf, R, SPX_N);\n   153\t    memcpy(inbuf + SPX_N, pk, SPX_PK_BYTES);\n   154\t\n   155\t    /* If R + pk + message cannot fill up an entire block */\n   156\t    if (SPX_N + SPX_PK_BYTES + mlen < SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES) {\n   157\t        memcpy(inbuf + SPX_N + SPX_PK_BYTES, m, mlen);\n   158\t        shaX_inc_finalize(seed + 2*SPX_N, state, inbuf, SPX_N + SPX_PK_BYTES + mlen);\n   159\t    }\n   160\t    /* Otherwise first fill a block, so that finalize only uses the message */\n   161\t    else {\n   162\t        memcpy(inbuf + SPX_N + SPX_PK_BYTES, m,\n   163\t               SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES - SPX_N - SPX_PK_BYTES);\n   164\t        shaX_inc_blocks(state, inbuf,