at one\n#\n# For each combination it\n#   1. builds the C reference .so's for the matching CMake configuration,\n#   2. builds the Rust cdylib with the matching cargo features,\n#   3. runs the integration tests, which dlopen BOTH and compare.\nR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\ncd \"$R/translation\"\n\nBACKENDS=${BACKENDS:-\"haraka sha2 shake shake256 blake\"}\nTHASHES=${THASHES:-\"robust simple\"}\nSECPARS=${SECPARS:-\"128s 128f 192s 192f 256s 256f\"}\n\nif [ $# -eq 3 ]; then\n  BACKENDS=$1; SECPARS=$2; THASHES=$3\nfi\n\nfail=0\npass=0\nfor b in $BACKENDS; do for t in $THASHES; do for s in $SECPARS; do\n  # `shake256` is a cargo-only alias for `shake`; the C build has no such name.\n  cb=$b; [ \"$b\" = \"shake256\" ] && cb=shake\n  \"$R/build_c.sh\" \"$cb\" \"$s\" \"$t\" > /dev/null 2>&1 || { echo \"C BUILD FAIL $cb-$s-$t\"; fail=$((fail+1)); continue; }\n  cargo build --release --offline --no-default-features --features \"$b,$t,$s\" > /dev/null 2>&1 \\\n    || { echo \"RUST BUILD FAIL $b-$s-$t\"; fail=$((fail+1)); continue; }\n  out=$(SPX_C_BUILD=\"$R/cbuild/$cb-$s-$t\" \\\n        SPX_RUST_SO=\"$R/translation/target/release/libsphincs_core_det.so\" \\\n        cargo test --offline --no-default-features --features \"$b,$t,$s\" -- --test-threads=1 2>&1)\n  if echo \"$out\" | grep -qE '^test result: FAILED|error\\[|SIGSEGV|SIGABRT|panicked'; then\n    echo \"FAIL $b/$t/$s\"\n    echo \"$out\" | grep -vE '^\\s*$' | tail -30\n    fail=$((fail+1))\n  else\n    n=$(echo \"$out\" | grep -oE '^test result: ok\\. [0-9]+' | awk '{s+=$5} END {print s}')\n    echo \"ok   $b/$t/$s  ($n assertions groups passed)\"\n    pass=$((pass+1))\n  fi\ndone; done; done\necho \"-----------------------------------------\"\necho \"combinations passed: $pass   failed: $fail\"\nexit $((fail > 0))\n","structuredPatch":[{"oldStart":35,"oldLines":8,"newStart":35,"newLines":22,"lines":["     echo \"$out\" | grep -vE '^\\s*$' | tail -30","     fail=$((fail+1))","   else","-    n=$(echo \"$out\" | grep -oE '^test result: ok\\. [0-9]+' | awk '{s+=$5} END {print s}')","-    echo \"ok   $b/$t/$s  ($n assertions groups passed)\"","+    n=$(echo \"$out\" | grep -oE 'ok\\. [0-9]+ passed' | awk '{s+=$2} END {print s+0}')","+    # CONFIGS.md row 56: the KAT driver transcript digest, C vs Rust vs the","+    # recorded reference_outputs.txt.","+    cdrv=$(\"$R/cbuild/$cb-$s-$t/app/driver\"); cst=$?","+    cargo build --release --offline --no-default-features --features \"$b,$t,$s\" --bin driver >/dev/null 2>&1","+    rdrv=$(\"$R/translation/target/release/driver\"); rst=$?","+    ref=$(grep -P \"^$cb\\t$t\\t$s\\t\" \"$R/reference_outputs.txt\" | cut -f4)","+    if [ \"$cdrv\" != \"$rdrv\" ] || [ \"$cst\" != \"$rst\" ]; then","+      echo \"FAIL $b/$t/$s driver: C='$cdrv'(exit=$cst) Rust='$rdrv'(exit=$rst)\"","+      fail=$((fail+1)); continue","+    fi","+    if [ -n \"$ref\" ] && [ \"$ref\" != \"$cdrv\" ]; then","+      echo \"FAIL $b/$t/$s driver vs reference_outputs.txt: got='$cdrv' want='$ref'\"","+      fail=$((fail+1)); continue","+    fi","+    echo \"ok   $b/$t/$s  ($n tests, driver digest matches${ref:+ + reference})\"","     pass=$((pass+1))","   fi"," done; done; done"]}],"userModified":false,"replaceAll":false}}
