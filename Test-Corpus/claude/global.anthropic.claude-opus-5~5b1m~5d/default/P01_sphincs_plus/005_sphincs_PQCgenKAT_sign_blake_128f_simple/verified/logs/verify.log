PX_DGST_BYTES, seed, 2*SPX_N + SPX_SHAX_OUTPUT_BYTES);\n   178\t\n   179\t    memcpy(digest, bufp, SPX_FORS_MSG_BYTES);\n   180\t    bufp += SPX_FORS_MSG_BYTES;\n   181\t\n   182\t#if SPX_TREE_BITS > 64\n   183\t    #error For given height and depth, 64 bits cannot represent all subtrees\n   184\t#endif\n   185\t\n   186\t    if (SPX_D == 1) {\n   187\t\t*tree = 0;\n   188\t    } else {\n   189\t        *tree = bytes_to_ull(bufp, SPX_TREE_BYTES);\n   190\t        *tree &= (~(uint64_t)0) >> (64 - SPX_TREE_BITS);\n   191\t    }\n   192\t    bufp += SPX_TREE_BYTES;\n   193\t\n   194\t    *leaf_idx = (uint32_t)bytes_to_ull(bufp, SPX_LEAF_BYTES);\n   195\t    *leaf_idx &= (~(uint32_t)0) >> (32 - SPX_LEAF_BITS);\n   196\t}\n   197\t\n   198\t\n///// /local/home/scheschb/.harvest/work/harvest-work-QQSMlQ/c_src/lib/sha2/src/thash_sha2_simple.c\n     1\t#include <stdint.h>\n     2\t#include <string.h>\n     3\t\n     4\t#include \"../../../app/include/address.h\"\n     5\t#include \"../../../app/include/params.h\"\n     6\t#include \"../../../app/include/thash.h\"\n     7\t#include \"../../../app/include/utils.h\"\n     8\t\n     9\t#include \"../include/sha2.h\"\n    10\t\n    11\t#if SPX_SHA512\n    12\tstatic void thash_512(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n    13\t           const spx_ctx *ctx, uint32_t addr[8]);\n    14\t#endif\n    15\t\n    16\t/**\n    17\t * Takes an array of inblocks concatenated arrays of SPX_N bytes.\n    18\t */\n    19\tvoid thash(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n    20\t           const spx_ctx *ctx, uint32_t addr[8])\n    21\t{\n    22\t#if SPX_SHA512\n    23\t    if (inblocks > 1) {\n    24\t\tthash_512(out, in, inblocks, ctx, addr);\n    25\t        return;\n    26\t    }\n    27\t#endif\n    28\t\n    29\t    unsigned char outbuf[SPX_SHA256_OUTPUT_BYTES];\n    30\t    uint8_t sha2_state[40];\n    31\t    SPX_VLA(uint8_t, buf, SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);\n  