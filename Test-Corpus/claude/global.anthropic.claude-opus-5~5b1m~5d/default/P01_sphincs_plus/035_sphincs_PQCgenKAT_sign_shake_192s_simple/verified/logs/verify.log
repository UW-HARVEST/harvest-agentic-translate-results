py_from_slice(&ctx.state_seeded[..40]);\n201\t\n202\t        buf[..SPX_SHA256_ADDR_BYTES].copy_from_slice(&addr_bytes(addr)[..SPX_SHA256_ADDR_BYTES]);\n203\t        buf[SPX_SHA256_ADDR_BYTES..SPX_SHA256_ADDR_BYTES + n].copy_from_slice(&input[..n]);\n204\t\n205\t        sha256_inc_finalize(&mut outbuf, &mut sha2_state, buf);\n206\t        out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n207\t    }\n208\t\n209\t    // `ctx` is only read for `state_seeded_512`, which exists solely when\n210\t    // SPX_SHA512 == 1 (the whole function is `#if SPX_SHA512` in the C).\n211\t    #[allow(unused_variables)]\n212\t    fn thash_512(out: &mut [u8], input: &[u8], inblocks: u32, ctx: &SpxCtx, addr: &mut [u32; 8]) {\n213\t        let n = inblocks as usize * SPX_N;\n214\t\n215\t        let mut outbuf = [0u8; SPX_SHA512_OUTPUT_BYTES];\n216\t        let mut sha2_state = [0u8; 72];\n217\t\n218\t        let buflen = SPX_SHA256_ADDR_BYTES + n;\n219\t        let mut stack_buf = [0u8; BUF_CAP];\n220\t        let mut heap_buf: Vec<u8>;\n221\t        let buf: &mut [u8] = if buflen <= BUF_CAP {\n222\t            &mut stack_buf[..buflen]\n223\t        } else {\n224\t            heap_buf = vec![0u8; buflen];\n225\t            &mut heap_buf[..]\n226\t        };\n227\t\n228\t        /* Retrieve precomputed state containing pub_seed */\n229\t        // The whole enclosing `thash_512` is inside `#if SPX_SHA512` in the C,\n230\t        // so `state_seeded_512` is guaranteed to exist here.\n231\t        #[cfg(spx_big_hash)]\n232\t        sha2_state.copy_from_slice(&ctx.state_seeded_512[..72]);\n233\t\n234\t        buf[..SPX_SHA256_ADDR_BYTES].copy_from_slice(&addr_bytes(addr)[..SPX_SHA256_ADDR_BYTES]);\n235\t        buf[SPX_SHA256_ADDR_BYTES..SPX_SHA256_ADDR_BYTES + n].copy_from_slice(&input[..n]);\n236\t\n237\t        sha512_inc_finalize(&mut outbuf, &mut sha2_state, buf);\n238\t        out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n239\t    }\n240\t}\n241\t\n242\t#[cfg(not(feature = \"simple\"))]\n243\tpub use robust_impl::thash;\n244\t#[cfg(feature = \"simple\")]\n245\tpub use simple_impl::thash;\n246\t\n247\t// ---------------------------------------------------------------------------\n248\t// C ABI wrapper -- app/include/thash.h\n249\t// ---------------------------------------------------------------------------\n250\t\n251\t#[unsafe(no_mangle)]\n252\tpub extern \"C\" fn SPX_thash(\n253\t    out: *mut u8,\n254\t    input: *const u8,\n255\t    inblocks: core::ffi::c_uint,\n256\t    ctx: *const SpxCtx,\n257\t    addr: *mut u32,\n258\t) {\n259\t    unsafe {\n260\t        thash(\n261\t            core::slice::from_raw_parts_mut(out, SPX_N),\n262\t            core::slice::from_raw_parts(input, inblocks as usize * SPX_N),\n263\t            inblocks as u32,\n264\t            &*ctx,\n265\t            &mut *(addr as *mut [u32; 8]),\n266\t        );\n267\t    }\n268\t}\n269\t"}]},"parent_tool_use_id":"toolu_bdrk_01FLLY3ipeDMFqC3FLTBAHag","session_id":"ea246c20-3a08-49a0-aeed-8ef41fe5c703","uuid":"13ac9f33-9d43-44f3-be00-d34647c9dbc3","timestamp":"2026-09-02T13:26:56.619Z","subagent_type":"general-purpose","task_description":"Review sha2 backend translation"}
