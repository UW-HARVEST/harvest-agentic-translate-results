56(&mut outbuf, &buf[..SPX_N + SPX_ADDR_BYTES + n]);\n127\t        out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n128\t    }\n129\t\n130\t    fn thash_512(out: &mut [u8], input: &[u8], inblocks: u32, ctx: &SpxCtx, addr: &mut [u32; 8]) {\n131\t        let n = inblocks as usize * SPX_N;\n132\t        let mut outbuf = [0u8; SPX_BLAKE512_OUTPUT_BYTES];\n133\t\n134\t        let mut buf_arr = [0u8; SCRATCH_MAX];\n135\t        let mut buf_heap: Vec<u8> = Vec::new();\n136\t        let buf = scratch(&mut buf_arr, &mut buf_heap, SPX_N + SPX_ADDR_BYTES + n);\n137\t\n138\t        buf[..SPX_N].copy_from_slice(&ctx.pub_seed);\n139\t        buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(&addr_bytes(addr)[..SPX_ADDR_BYTES]);\n140\t        buf[SPX_N + SPX_ADDR_BYTES..SPX_N + SPX_ADDR_BYTES + n].copy_from_slice(&input[..n]);\n141\t\n142\t        blake512(&mut outbuf, &buf[..SPX_N + SPX_ADDR_BYTES + n]);\n143\t        out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n144\t    }\n145\t}\n146\t\n147\t#[cfg(not(feature = \"simple\"))]\n148\tpub use robust_impl::thash;\n149\t#[cfg(feature = \"simple\")]\n150\tpub use simple_impl::thash;\n151\t\n152\t/// `void thash(unsigned char *out, const unsigned char *in,\n153\t///             unsigned int inblocks, const spx_ctx *ctx, uint32_t addr[8])`\n154\t#[unsafe(no_mangle)]\n155\tpub extern \"C\" fn SPX_thash(\n156\t    out: *mut u8,\n157\t    input: *const u8,\n158\t    inblocks: u32,\n159\t    ctx: *const SpxCtx,\n160\t    addr: *mut u32,\n161\t) {\n162\t    unsafe {\n163\t        let out = core::slice::from_raw_parts_mut(out, SPX_N);\n164\t        let input = core::slice::from_raw_parts(input, inblocks as usize * SPX_N);\n165\t        thash(out, input, inblocks, &*ctx, &mut *(addr as *mut [u32; 8]))\n166\t    }\n167\t}\n168\t"}]},"parent_tool_use_id":"toolu_bdrk_013k63L9tSrdLTvcrNntbKZX","session_id":"ea246c20-3a08-49a0-aeed-8ef41fe5c703","uuid":"86bfa9e3-e00e-430e-a0f3-377740e9495c","timestamp":"2026-09-02T13:27:52.920Z","subagent_type