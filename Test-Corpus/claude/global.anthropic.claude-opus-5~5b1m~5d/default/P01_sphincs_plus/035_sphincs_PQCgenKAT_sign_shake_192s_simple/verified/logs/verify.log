d (*ifn_c)(uint64_t*), (*ifn_r)(uint64_t*); G(ifn,\"shake256_inc_finalize\");\n  void (*iq_c)(uint8_t*,size_t,uint64_t*), (*iq_r)(uint8_t*,size_t,uint64_t*); G(iq,\"shake256_inc_squeeze\");\n\n  static uint8_t in[4096], oc[4096], or_[4096];\n  for(int it=0; it<3000; it++){\n    size_t inlen = rb() + 256*(rb()%3);\n    size_t outlen = 1 + (rb()%255) + 256*(rb()%3);\n    for(size_t i=0;i<inlen;i++) in[i]=rb();\n    memset(oc,0xAA,sizeof oc); memset(or_,0x55,sizeof or_);\n    shake256_c(oc,outlen,in,inlen); shake256_r(or_,outlen,in,inlen);\n    cmp(\"shake256\",it,oc,or_,outlen);\n\n    uint64_t sc[25], sr[25];\n    shake256_absorb_c(sc,in,inlen); shake256_absorb_r(sr,in,inlen);\n    cmp(\"absorb-state\",it,sc,sr,sizeof sc);\n    size_t nb = 1 + rb()%4;\n    memset(oc,0,sizeof oc); memset(or_,0,sizeof or_);\n    shake256_squeezeblocks_c(oc,nb,sc); shake256_squeezeblocks_r(or_,nb,sr);\n    cmp(\"squeezeblocks\",it,oc,or_,nb*136);\n    cmp(\"squeezeblocks-state\",it,sc,sr,sizeof sc);\n\n    uint64_t ic[26], ir[26];\n    ii_c(ic); ii_r(ir);\n    cmp(\"inc_init\",it,ic,ir,sizeof ic);\n    int na = 1+rb()%5; size_t off=0;\n    for(int k=0;k<na;k++){\n      size_t l = rb()%200; if(off+l>sizeof in) l=0;\n      ia_c(ic,in+off,l); ia_r(ir,in+off,l); off+=l;\n      cmp(\"inc_absorb\",it,ic,ir,sizeof ic);\n    }\n    ifn_c(ic); ifn_r(ir);\n    cmp(\"inc_finalize\",it,ic,ir,sizeof ic);\n    int nq=1+rb()%5; size_t qo=0;\n    for(int k=0;k<nq;k++){\n      size_t l = 1+rb()%200;\n      memset(oc+qo,0xAA,l); memset(or_+qo,0x55,l);\n      iq_c(oc+qo,l,ic); iq_r(or_+qo,l,ir);\n      cmp(\"inc_squeeze\",it,oc+qo,or_+qo,l);\n      cmp(\"inc_squeeze-state\",it,ic,ir,sizeof ic);\n      qo+=l;\n    }\n  }\n  printf(\"SHAKE fails=%d\\n\",fails);\n  return fails!=0;\n}\nEOF\ngcc -O1 -o .scratch/fuzz_shake .scratch/fuzz_shake.c -ldl && ./.scratch/fuzz_shake cbuild/shake-robust-128s/libcsphincs_all.so translation/target/release/libsphincs_core_det.so 2>&1 | head -40","description":"Build and ru