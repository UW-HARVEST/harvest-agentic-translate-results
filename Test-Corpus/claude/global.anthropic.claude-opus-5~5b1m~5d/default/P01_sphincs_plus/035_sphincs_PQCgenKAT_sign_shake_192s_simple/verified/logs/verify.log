{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01E3sSn5iJPJSYhpecs1vHhk","type":"tool_result","content":"1\t//! Translation of `c_src/lib/sha2/src/thash_sha2_robust.c` (THASH=robust, the\n2\t//! CMake default) and `c_src/lib/sha2/src/thash_sha2_simple.c` (THASH=simple).\n3\t\n4\tuse crate::context::SpxCtx;\n5\tuse crate::params::SPX_N;\n6\t\n7\t/// Upper bound on the `inblocks` argument used anywhere in SPHINCS+\n8\t/// (`1`, `2`, `SPX_WOTS_LEN` and `SPX_FORS_TREES`). Used to size the stack\n9\t/// scratch buffers that replace the C VLAs; larger values fall back to the\n10\t/// heap so that the safe Rust API stays total.\n11\tconst MAX_INBLOCKS: usize = {\n12\t    let a = if crate::params::SPX_FORS_TREES > crate::params::SPX_WOTS_LEN {\n13\t        crate::params::SPX_FORS_TREES\n14\t    } else {\n15\t        crate::params::SPX_WOTS_LEN\n16\t    };\n17\t    if a > 2 {\n18\t        a\n19\t    } else {\n20\t        2\n21\t    }\n22\t};\n23\t\n24\t// ===========================================================================\n25\t// THASH = robust\n26\t// ===========================================================================\n27\t\n28\t#[cfg(not(feature = \"simple\"))]\n29\tmod robust_impl {\n30\t    use super::MAX_INBLOCKS;\n31\t    use crate::address::addr_bytes;\n32\t    use crate::backend::sha2::{\n33\t        mgf1_256, mgf1_512, sha256_inc_finalize, sha512_inc_finalize, SPX_SHA256_ADDR_BYTES,\n34\t        SPX_SHA256_OUTPUT_BYTES, SPX_SHA512_OUTPUT_BYTES,\n35\t    };\n36\t    use crate::context::SpxCtx;\n37\t    use crate::params::{SPX_N, SPX_SHA512};\n38\t\n39\t    const BITMASK_CAP: usize = MAX_INBLOCKS * SPX_N;\n40\t    const BUF_CAP_256: usize = SPX_N + SPX_SHA256_OUTPUT_BYTES + MAX_INBLOCKS * SPX_N;\n41\t    const BUF_CAP_512: usize = SPX_N + SPX_SHA256_ADDR_BYTES + MAX_INBLOCKS * SPX_N;\n42\t\n43\t    /// Takes an array of `inblocks` concatenated arrays of SPX_N bytes.\n44\t    pub fn thash(\n45\t        out: &mut [u8],\n46\t        input: &[u8],\n47\t        inblocks: u32,\n48\t        ctx: &SpxCtx,\n49\t        addr: &mut [u32; 8],\n50\t    ) {\n51\t        if SPX_SHA512 == 1 && inblocks > 1 {\n52\t            thash_512(out, input, inblocks, ctx, addr);\n53\t            return;\n54\t        }\n55\t\n56\t        let n = inblocks as usize * SPX_N;\n57\t\n58\t        let mut outbuf = [0u8; SPX_SHA256_OUTPUT_BYTES];\n59\t\n60\t        let mut stack_bitmask = [0u8; BITMASK_CAP];\n61\t        let mut heap_bitmask: Vec<u8>;\n62\t        let bitmask: &mut [u8] = if n <= BITMASK_CAP {\n63\t            &mut stack_bitmask[..n]\n64\t        } else {\n65\t            heap_bitmask = vec![0u8; n];\n66\t            &mut heap_bitmask[..]\n67\t        };\n68\t\n69\t        let buflen = SPX_N + SPX_SHA256_OUTPUT_BYTES + n;\n70\t        let mut stack_buf = [0u8; BUF_CAP_256];\n71\t        let mut heap_buf: Vec<u8>;\n72\t        let buf: &mut [u8] = if buflen <= BUF_CAP_256 {\n73\t            &mut stack_buf[..buflen]\n74\t        } else {\n75\t            heap_buf = vec![0u8; buflen];\n76\t            &mut heap_buf[..]\n77\t        };\n78\t\n79\t        let mut sha2_state = [0u8; 40];\n80\t\n81\t        buf[..SPX_N].copy_from_slice(&ctx.pub_seed[..SPX_N]);\n82\t        buf[SPX_N..SPX_N + SPX_SHA256_ADDR_BYTES]\n83\t            .copy_from_slice(&addr_bytes(addr)[..SPX_SHA256_ADDR_BYTES]);\n84\t        mgf1_256(bitmask, &buf[..SPX_N + SPX_SHA256_ADDR_BYTES]);\n85\t\n86\t        /* Retrieve precomputed state containing pub_seed */\n87\t        sha2_state.copy_from_slice(&ctx.state_seeded[..40]);\n88\t\n89\t        for i in 0..n {\n90\t            buf[SPX_N + SPX_SHA256_ADDR_BYTES + i] = input[i] ^ bitmask[i];\n91\t        }\n92\t\n93\t        sha256_inc_finalize(\n94\t            &mut outbuf,\n95\t            &mut sha2_state,\n96\t            &buf[SPX_N..SPX_N + SPX_SHA256_ADDR_BYTES + n],\n97\t        );\n98\t        out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n99\t    }\n100\t\n101\t    // `ctx` is on