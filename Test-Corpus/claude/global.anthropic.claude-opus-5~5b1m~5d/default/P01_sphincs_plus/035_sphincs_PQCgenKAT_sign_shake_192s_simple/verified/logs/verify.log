{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013z1iA6bqA3UddGGxn9T1LM","type":"tool_result","content":"1\t//! Translation of `c_src/lib/haraka/src/hash_haraka.c`\n2\t\n3\tuse crate::address::addr_bytes;\n4\tuse crate::backend::haraka::{\n5\t    haraka512, haraka_S_inc_absorb, haraka_S_inc_finalize, haraka_S_inc_init,\n6\t    haraka_S_inc_squeeze, tweak_constants,\n7\t};\n8\tuse crate::context::SpxCtx;\n9\tuse crate::params::{\n10\t    SPX_ADDR_BYTES, SPX_D, SPX_FORS_MSG_BYTES, SPX_N, SPX_TREE_HEIGHT,\n11\t};\n12\tuse crate::utils::bytes_to_ull;\n13\t\n14\tpub fn initialize_hash_function(ctx: &mut SpxCtx) {\n15\t    tweak_constants(ctx);\n16\t}\n17\t\n18\t/// Computes PRF(key, addr), given a secret key of SPX_N bytes and an address\n19\tpub fn prf_addr(out: &mut [u8], ctx: &SpxCtx, addr: &[u32; 8]) {\n20\t    /* Since SPX_N may be smaller than 32, we need temporary buffers. */\n21\t    let mut outbuf = [0u8; 32];\n22\t    let mut buf = [0u8; 64];\n23\t\n24\t    buf[..SPX_ADDR_BYTES].copy_from_slice(&addr_bytes(addr)[..SPX_ADDR_BYTES]);\n25\t    buf[SPX_ADDR_BYTES..SPX_ADDR_BYTES + SPX_N].copy_from_slice(&ctx.sk_seed[..SPX_N]);\n26\t\n27\t    haraka512(&mut outbuf, &buf, ctx);\n28\t    out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n29\t}\n30\t\n31\t/// Computes the message-dependent randomness R, using a secret seed and an\n32\t/// optional randomization value as well as the message.\n33\tpub fn gen_message_random(r: &mut [u8], sk_prf: &[u8], optrand: &[u8], m: &[u8], ctx: &SpxCtx) {\n34\t    let mut s_inc = [0u8; 65];\n35\t\n36\t    haraka_S_inc_init(&mut s_inc);\n37\t    haraka_S_inc_absorb(&mut s_inc, &sk_prf[..SPX_N], ctx);\n38\t    haraka_S_inc_absorb(&mut s_inc, &optrand[..SPX_N], ctx);\n39\t    haraka_S_inc_absorb(&mut s_inc, m, ctx);\n40\t    haraka_S_inc_finalize(&mut s_inc);\n41\t    haraka_S_inc_squeeze(&mut r[..SPX_N], &mut s_inc, ctx);\n42\t}\n43\t\n44\tconst SPX_TREE_BITS: usize = SPX_TREE_HEIGHT * (SPX_D - 1);\n45\tconst SPX_TREE_BYTES: usize = (SPX_TREE_BITS + 7) / 8;\n46\tconst SPX_LEAF_BITS: usize = SPX_TREE_HEIGHT;\n47\tconst SPX_LEAF_BYTES: usize = (SPX_LEAF_BITS + 7) / 8;\n48\tconst SPX_DGST_BYTES: usize = SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES;\n49\t\n50\t/// `(~(uint64_t)0) >> (64 - SPX_TREE_BITS)`; the `SPX_TREE_BITS == 0` arm is\n51\t/// only there to keep the (dead, `SPX_D == 1`) shift from being rejected by\n52\t/// rustc's constant-shift-overflow lint.\n53\tconst SPX_TREE_MASK: u64 = if SPX_TREE_BITS == 0 {\n54\t    0\n55\t} else {\n56\t    (!0u64) >> (64 - SPX_TREE_BITS)\n57\t};\n58\t/// `(~(uint32_t)0) >> (32 - SPX_LEAF_BITS)`\n59\tconst SPX_LEAF_MASK: u32 = if SPX_LEAF_BITS == 0 {\n60\t    0\n61\t} else {\n62\t    (!0u32) >> (32 - SPX_LEAF_BITS)\n63\t};\n64\t\n65\t/// Computes the message hash using R, the public key, and the message.\n66\t/// Outputs the message digest and the index of the leaf. The index is split in\n67\t/// the tree index and the leaf index, for convenient copying to an address.\n68\tpub fn hash_message(\n69\t    digest: &mut [u8],\n70\t    tree: &mut u64,\n71\t    leaf_idx: &mut u32,\n72\t    r: &[u8],\n73\t    pk: &[u8],\n74\t    m: &[u8],\n75\t    ctx: &SpxCtx,\n76\t) {\n77\t    let mut buf = [0u8; SPX_DGST_BYTES];\n78\t    let mut s_inc = [0u8; 65];\n79\t\n80\t    haraka_S_inc_init(&mut s_inc);\n81\t    haraka_S_inc_absorb(&mut s_inc, &r[..SPX_N], ctx);\n82\t    // Only absorb root part of pk\n83\t    haraka_S_inc_absorb(&mut s_inc, &pk[SPX_N..SPX_N + SPX_N], ctx);\n84\t    haraka_S_inc_absorb(&mut s_inc, m, ctx);\n85\t    haraka_S_inc_finalize(&mut s_inc);\n86\t    haraka_S_inc_squeeze(&mut buf[..SPX_DGST_BYTES], &mut s_inc, ctx);\n87\t\n88\t    let mut bufp: usize = 0;\n89\t\n90\t    digest[..SPX_FORS_MSG_BYTES].copy_from_slice(&buf[bufp..bufp + SPX_FORS_MSG_BYTES]);\n91\t    bufp += SPX_FORS_MSG_BYTES;\n92\t\n93\t    // #if SPX_TREE_BITS > 64\n94\t    //     #error For given height and depth, 64 bits cannot represent all subtrees\n95\t    // #endif\n96\t    const _: () = assert!(SPX_TREE_BITS <= 64);\n97\t\n98\t    if SPX_D == 1 {\n99\t        *tree = 0;\n100\t    } else {\n101\t        *tree = bytes_to_ull(&buf[bufp..], SPX_TREE_BYTES as u32);\n102\t        *tree &= SPX_TREE_MASK;\n103\t    }\n104\t    bufp += SPX_TREE_BYTES;\n105\t\n106\t    *leaf_idx = bytes_to_ull(&buf[bufp..], SPX_LEAF_BYTES as u32) as u32;\n107\t    *leaf_idx &= SPX_LEAF_MASK;\n108\t}\n109\t\n110\t// ---------------------------------------------------------------------------\n111\t// C ABI wrappers (app/include/hash.h)\n112\t// ---------------------------------------------------------------------------\n113\t\n114\t#[unsafe(no_mangle)]\n115\tpub extern \"C\" fn SPX_initialize_hash_function(ctx: *mut SpxCtx) {\n116\t    unsafe { initialize_hash_function(&mut *ctx) }\n117\t}\n118\t\n119\t#[unsafe(no_mangle)]\n120\tpub extern \"C\" fn SPX_prf_addr(out: *mut u8, ctx: *const SpxCtx, addr: *const u32) {\n121\t    unsafe {\n122\t        prf_addr(\n123\t            core::slice::from_raw_parts_mut(out, SPX_N),\n124\t            &*ctx,\n125\t            &*(addr as *const [u32; 8]),\n126\t        )\n127\t    }\n128\t}\n129\t\n130\t#[unsafe(no_mangle)]\n131\tpub extern \"C\" fn SPX_gen_message_random(\n132\t    r: *mut u8,\n133\t    sk_prf: *const u8,\n134\t    optrand: *const u8,\n135\t    m: *const u8,\n136\t    mlen: u64,\n137\t    ctx: *const SpxCtx,\n138\t) {\n139\t    unsafe {\n140\t        gen_message_random(\n141\t            core::slice::from_raw_parts_mut(r, SPX_N),\n142\t            core::slice::from_raw_parts(sk_prf, SPX_N),\n143\t            core::slice::from_raw_parts(optrand, SPX_N),\n144\t            core::slice::from_raw_parts(m, mlen as usize),\n145\t            &*ctx,\n146\t        )\n147\t    }\n148\t}\n149\t\n150\t#[unsafe(no_mangle)]\n151\tpub extern \"C\" fn SPX_hash_message(\n152\t    digest: *mut u8,\n153\t    tree: *mut u64,\n154\t    leaf_idx: *mut u32,\n155\t    r: *const u8,\n156\t    pk: *const u8,\n157\t    m: *const u8,\n158\t    mlen: u64,\n159\t    ctx: *const SpxCtx,\n160\t) {\n161\t    unsafe {\n162\t        hash_message(\n163\t            core::slice::from_raw_parts_mut(digest, SPX_FORS_MSG_BYTES),\n164\t            &mut *tree,\n165\t            &mut *leaf_idx,\n166\t            core::slice::from_raw_parts(r, SPX_N),\n167\t            core::slice::from_raw_parts(pk, 2 * SPX_N),\n168\t            core::slice::from_raw_parts(m, mlen as usize),\n169\t            &*ctx,\n170\t        )\n171\t    }\n172\t}\n173\t"}]},"parent_tool_use_id":"toolu_bdrk_01KsN8KTe8GxcDs8FuWWEDTY","session_id":"ea246c20-3a08-49a0-aeed-8ef41fe5c703","uuid":"c97f2503-f38e-4d07-acec-a788872e2e88","timestamp":"2026-09-02T13:28:11.237Z","subagent_type":"general-purpose","task_description":"Review shake+haraka backend translation"}
