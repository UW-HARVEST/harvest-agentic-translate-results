{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MiZTde5UmsockoE8cSpzej","type":"tool_result","content":"1\t//! Translation of `c_src/lib/shake/src/thash_shake_robust.c` (THASH=robust,\n2\t//! the CMake default) and `c_src/lib/shake/src/thash_shake_simple.c`\n3\t//! (THASH=simple).\n4\t//!\n5\t//! The C code uses `SPX_VLA` (a C99 variable-length array) for the scratch\n6\t//! buffers.  `inblocks` is bounded by `max(SPX_WOTS_LEN, SPX_FORS_TREES)` at\n7\t//! every call site, so we use fixed-size stack arrays of that upper bound and\n8\t//! only ever touch the leading `inblocks * SPX_N` bytes.\n9\t\n10\tuse crate::context::SpxCtx;\n11\tuse crate::params::{SPX_ADDR_BYTES, SPX_FORS_TREES, SPX_N, SPX_WOTS_LEN};\n12\t\n13\t/// Upper bound on the `inblocks` argument over all call sites.\n14\tconst MAX_INBLOCKS: usize = if SPX_WOTS_LEN > SPX_FORS_TREES {\n15\t    SPX_WOTS_LEN\n16\t} else {\n17\t    SPX_FORS_TREES\n18\t};\n19\t\n20\t#[cfg(not(feature = \"simple\"))]\n21\tmod robust_impl {\n22\t    use super::{MAX_INBLOCKS, SPX_ADDR_BYTES, SPX_N};\n23\t    use crate::address::addr_bytes;\n24\t    use crate::backend::fips202;\n25\t    use crate::context::SpxCtx;\n26\t\n27\t    const BUF_MAX: usize = SPX_N + SPX_ADDR_BYTES + MAX_INBLOCKS * SPX_N;\n28\t    const BITMASK_MAX: usize = MAX_INBLOCKS * SPX_N;\n29\t\n30\t    /**\n31\t     * Takes an array of inblocks concatenated arrays of SPX_N bytes.\n32\t     */\n33\t    pub fn thash(out: &mut [u8], input: &[u8], inblocks: u32, ctx: &SpxCtx, addr: &mut [u32; 8]) {\n34\t        let inblocks = inblocks as usize;\n35\t        let buflen = SPX_N + SPX_ADDR_BYTES + inblocks * SPX_N;\n36\t        let masklen = inblocks * SPX_N;\n37\t\n38\t        let mut buf = [0u8; BUF_MAX];\n39\t        let mut bitmask = [0u8; BITMASK_MAX];\n40\t\n41\t        buf[..SPX_N].copy_from_slice(&ctx.pub_seed[..SPX_N]);\n42\t        buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(&addr_bytes(addr)[..SPX_ADDR_BYTES]);\n43\t\n44\t        fips202::shake256(\n45\t            &mut bitmask[..masklen],\n46\t            &buf[..SPX_N + SPX_ADDR_BYTES],\n47\t        );\n48\t\n49\t        for i in 0..masklen {\n50\t            buf[SPX_N + SPX_ADDR_BYTES + i] = input[i] ^ bitmask[i];\n51\t        }\n52\t\n53\t        fips202::shake256(&mut out[..SPX_N], &buf[..buflen]);\n54\t    }\n55\t}\n56\t\n57\t#[cfg(feature = \"simple\")]\n58\tmod simple_impl {\n59\t    use super::{MAX_INBLOCKS, SPX_ADDR_BYTES, SPX_N};\n60\t    use crate::address::addr_bytes;\n61\t    use crate::backend::fips202;\n62\t    use crate::context::SpxCtx;\n63\t\n64\t    const BUF_MAX: usize = SPX_N + SPX_ADDR_BYTES + MAX_INBLOCKS * SPX_N;\n65\t\n66\t    /**\n67\t     * Takes an array of inblocks concatenated arrays of SPX_N bytes.\n68\t     */\n69\t    pub fn thash(out: &mut [u8], input: &[u8], inblocks: u32, ctx: &SpxCtx, addr: &mut [u32; 8]) {\n70\t        let inblocks = inblocks as usize;\n71\t        let buflen = SPX_N + SPX_ADDR_BYTES + inblocks * SPX_N;\n72\t\n73\t        let mut buf = [0u8; BUF_MAX];\n74\t\n75\t        buf[..SPX_N].copy_from_slice(&ctx.pub_seed[..SPX_N]);\n76\t        buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(&addr_bytes(addr)[..SPX_ADDR_BYTES]);\n77\t        buf[SPX_N + SPX_ADDR_BYTES..SPX_N + SPX_ADDR_BYTES + inblocks * SPX_N]\n78\t            .copy_from_slice(&input[..inblocks * SPX_N]);\n79\t\n80\t        fips202::shake256(&mut out[..SPX_N], &buf[..buflen]);\n81\t    }\n82\t}\n83\t\n84\t#[cfg(not(feature = \"simple\"))]\n85\tpub use robust_impl::thash;\n86\t\n87\t#[cfg(feature = \"simple\")]\n88\tpub use simple_impl::thash;\n89\t\n90\t// ---------------------------------------------------------------------------\n91\t// C ABI wrapper (`thash` is namespaced in `app/include/thash.h`)\n92\t// ---------------------------------------------------------------------------\n93\t\n94\t#[unsafe(no_mangle)]\n95\tpub extern \"C\" fn SPX_thash(\n96\t    out: *mut u8,\n97\t    input: *const u8,\n98\t    inblocks: core::ffi::c_uint,\n99\t    ctx: *const SpxCtx,\n100\t    addr: *mut u32,\n101\t) {\n102\t    unsafe {\n103\t        let inlen = (inblocks as usize) * SPX_N;\n104\t        // `thash(out, out, ...)` is a legal (and used) C call pattern, so copy\n105\t        // the input out of the way before handing out a `&mut` to `out`.\n106\t        let mut in_copy = [0u8; MAX_INBLOCKS * SPX_N];\n107\t        if inlen != 0 {\n108\t            in_copy[..inlen].copy_from_slice(core::slice::from_raw_parts(input, inlen));\n109\t        }\n110\t        thash(\n111\t            core::slice::from_raw_parts_mut(out, SPX_N),\n112\t            &in_copy[..inlen],\n113\t            inblocks as u32,\n114\t            &*ctx,\n115\t            &mut *(addr as *mut [u32; 8]),\n116\t        )\n117\t    }\n118\t}\n119\t"}]},"parent_tool_use_id":"toolu_bdrk_01KsN8KTe8GxcDs8FuWWEDTY","session_id":"ea246c20-3a08-49a0-aeed-8ef41fe5c703","uuid":"c45a7f56-2fe0-47fe-9bef-9165574380df","timestamp":"2026-09-02T13:27:18.577Z","subagent_type":"general-purpose","task_description":"Review shake+haraka backend translation"}
