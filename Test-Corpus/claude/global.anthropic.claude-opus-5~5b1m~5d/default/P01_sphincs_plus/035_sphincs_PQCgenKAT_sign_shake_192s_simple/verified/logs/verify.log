       q[i] = (x & 0x000000FF)\n372\t            | ((x & 0x0000FC00) >> 2)\n373\t            | ((x & 0x00000300) << 6)\n374\t            | ((x & 0x00F00000) >> 4)\n375\t            | ((x & 0x000F0000) << 4)\n376\t            | ((x & 0xC0000000) >> 6)\n377\t            | ((x & 0x3F000000) << 2);\n378\t    }\n379\t}\n380\t\n381\t#[inline]\n382\tfn rotr16(x: u32) -> u32 {\n383\t    (x << 16) | (x >> 16)\n384\t}\n385\t\n386\t#[inline]\n387\tfn mix_columns32(q: &mut [u32]) {\n388\t    let q0 = q[0];\n389\t    let q1 = q[1];\n390\t    let q2 = q[2];\n391\t    let q3 = q[3];\n392\t    let q4 = q[4];\n393\t    let q5 = q[5];\n394\t    let q6 = q[6];\n395\t    let q7 = q[7];\n396\t    let r0 = (q0 >> 8) | (q0 << 24);\n397\t    let r1 = (q1 >> 8) | (q1 << 24);\n398\t    let r2 = (q2 >> 8) | (q2 << 24);\n399\t    let r3 = (q3 >> 8) | (q3 << 24);\n400\t    let r4 = (q4 >> 8) | (q4 << 24);\n401\t    let r5 = (q5 >> 8) | (q5 << 24);\n402\t    let r6 = (q6 >> 8) | (q6 << 24);\n403\t    let r7 = (q7 >> 8) | (q7 << 24);\n404\t\n405\t    q[0] = q7 ^ r7 ^ r0 ^ rotr16(q0 ^ r0);\n406\t    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr16(q1 ^ r1);\n407\t    q[2] = q1 ^ r1 ^ r2 ^ rotr16(q2 ^ r2);\n408\t    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr16(q3 ^ r3);\n409\t    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr16(q4 ^ r4);\n410\t    q[5] = q4 ^ r4 ^ r5 ^ rotr16(q5 ^ r5);\n411\t    q[6] = q5 ^ r5 ^ r6 ^ rotr16(q6 ^ r6);\n412\t    q[7] = q6 ^ r6 ^ r7 ^ rotr16(q7 ^ r7);\n413\t}\n414\t\n415\tmacro_rules! swap2_64 {\n416\t    ($q:expr, $i:expr, $j:expr) => {\n417\t        swapn!(\n418\t            u64,\n419\t            0x5555555555555555u64,\n420\t            0xAAAAAAAAAAAAAAAAu64,\n421\t            1,\n422\t            $q,\n423\t            $i,\n424\t            $j\n425\t        )\n426\t    };\n427\t}\n428\tmacro_rules! swap4_64 {\n429\t    ($q:expr, $i:expr, $j:expr) => {\n430\t        swapn!(\n431\t            u64,\n432\t            0x3333333333333333u64,\n433\t            0xCCCCCCCCCCCCCCCCu64,\n434\t            2,\n435\t            $q,\n436\t            $i,\n437\t            $j\n438\t        )\n439\t    };\n440\t}\n441\tmacro_rules! swap8_64 {\n442\t    ($q:expr, $i:expr, $j:expr) => {\n443\t        swapn!(\n444\t            u64,\n445\t            0x0F0F0F0F0F0F0F0Fu64,\n446\t            0xF0F0F0F0F0F0F0F0u64,\n447\t            4,\n448\t            $q,\n449\t            $i,\n450\t            $j\n451\t        )\n452\t    };\n453\t}\n454\t\n455\tfn br_aes_ct64_ortho(q: &mut [u64]) {\n456\t    swap2_64!(q, 0, 1);\n457\t    swap2_64!(q, 2, 3);\n458\t    swap2_64!(q, 4, 5);\n459\t    swap2_64!(q, 6, 7);\n460\t\n461\t    swap4_64!(q, 0, 2);\n462\t    swap4_64!(q, 1, 3);\n463\t    swap4_64!(q, 4, 6);\n464\t    swap4_64!(q, 5, 7);\n465\t\n466\t    swap8_64!(q, 0, 4);\n467\t    swap8_64!(q, 1, 5);\n468\t    swap8_64!(q, 2, 6);\n469\t    swap8_64!(q, 3, 7);\n470\t}\n471\t\n472\tfn br_aes_ct64_interleave_in(q0: &mut u64, q1: &mut u64, w: &[u32]) {\n473\t    let mut x0: u64;\n474\t    let mut x1: u64;\n475\t    let mut x2: u64;\n476\t    let mut x3: u64;\n477\t\n478\t    x0 = w[0] as u64;\n479\t    x1 = w[1] as u64;\n480\t    x2 = w[2] as u64;\n481\t    x3 = w[3] as u64;\n482\t    x0 |= x0 << 16;\n483\t    x1 |= x1 << 16;\n484\t    x2 |= x2 << 16;\n485\t    x3 |= x3 << 16;\n486\t    x0 &= 0x0000FFFF0000FFFFu64;\n487\t    x1 &= 0x0000FFFF0000FFFFu64;\n488\t    x2 &= 0x0000FFFF0000FFFFu64;\n489\t    x3 &= 0x0000FFFF0000FFFFu64;\n490\t    x0 |= x0 << 8;\n491\t    x1 |= x1 << 8;\n492\t    x2 |= x2 << 8;\n493\t    x3 |= x3 << 8;\n494\t    x0 &= 0x00FF00FF00FF00FFu64;\n495\t    x1 &= 0x00FF00FF00FF00FFu64;\n496\t    x2 &= 0x00FF00FF00FF00FFu64;\n497\t    x3 &= 0x00FF00FF00FF00FFu64;\n498\t    *q0 = x0 | (x2 << 8);\n499\t    *q1 = x1 | (x3 << 8);\n500\t}\n501\t\n502\tfn br_aes_ct64_interleave_out(w: &mut [u32], q0: u64, q1: u64) {\n503\t    let mut x0: u64;\n504\t    let mut x1: u64;\n505\t    let mut x2: u64;\n506\t    let mut x3: u64;\n507\t\n508\t    x0 = q0 & 0x00FF00FF00FF00FFu64;\n509\t    x1 = q1 & 0x00FF00FF00FF00FFu64;\n510\t    x2 = (q0 >> 8) & 0x00FF00FF00FF00FFu64;\n511\t    x3 = (q1 >> 8) & 0x00FF00FF00FF00FFu64;\n512\t    x0 |= x0 >> 8;\n513\t    x1 |= x1 >> 8;\n514\t    x2 |= x2 >> 8;\n515\t    x3 |= x3 >> 8;\n516\t    x0 &= 0x0000FFFF0000FFFFu64;\n517\t    x1 &= 0x0000FFFF0000FFFFu64;\n518\t    x2 &= 0x0000FFFF0000FFFFu64;\n519\t    x3 &= 0x0000FFFF0000FFFFu64;\n520\t    w[0] = (x0 as u32) | ((x0 >> 16) as u32);\n521\t    w[1] = (x1 as u32) | ((x1 >> 16) as u32);\n522\t    w[2] = (x2 as u32) | ((x2 >> 16) as u32);\n523\t    w[3] = (x3 as u32) | ((x3 >> 16) as u32);\n524\t}\n525\t\n526\t#[inline]\n527\tfn add_round_key(q: &mut [u64], sk: &[u64]) {\n528\t    q[0] ^= sk[0];\n529\t    q[1] ^= sk[1];\n530\t    q[2] ^= sk[2];\n531\t    q[3] ^= sk[3];\n532\t    q[4] ^= sk[4];\n533\t    q[5] ^= sk[5];\n534\t    q[6] ^= sk[6];\n535\t    q[7] ^= sk[7];\n536\t}\n537\t\n538\t#[inline]\n539\tfn shift_rows(q: &mut [u64]) {\n540\t    for i in 0..8 {\n541\t        let x: u64 = q[i];\n542\t        q[i] = (x & 0x000000000000FFFFu64)\n543\t            | ((x & 0x00000000FFF00000u64) >> 4)\n544\t            | ((x & 0x00000000000F0000u64) << 12)\n545\t            | ((x & 0x0000FF0000000000u64) >> 8)\n546\t            | ((x & 0x000000FF00000000u64) << 8)\n547\t            | ((x & 0xF000000000000000u64) >> 12)\n548\t            | ((x & 0x0FFF000000000000u64) << 4);\n549\t    }\n550\t}\n551\t\n552\t#[inline]\n553\tfn rotr32(x: u64) -> u64 {\n554\t    (x << 32) | (x >> 32)\n555\t}\n556\t\n557\t#[inline]\n558\tfn mix_columns(q: &mut [u64]) {\n559\t    let q0 = q[0];\n560\t    let q1 = q[1];\n561\t    let q2 = q[2];\n562\t    let q3 = q[3];\n563\t    let q4 = q[4];\n564\t    let q5 = q[5];\n565\t    let q6 = q[6];\n566\t    let q7 = q[7];\n567\t    let r0 = (q0 >> 16) | (q0 << 48);\n568\t    let r1 = (q1 >> 16) | (q1 << 48);\n569\t    let r2 = (q2 >> 16) | (q2 << 48);\n570\t    let r3 = (q3 >> 16) | (q3 << 48);\n571\t    let r4 = (q4 >> 16) | (q4 << 48);\n572\t    let r5 = (q5 >> 16) | (q5 << 48);\n573\t    let r6 = (q6 >> 16) | (q6 << 48);\n574\t    let r7 = (q7 >> 16) | (q7 << 48);\n575\t\n576\t    q[0] = q7 ^ r7 ^ r0 ^ rotr32(q0 ^ r0);\n577\t    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr32(q1 ^ r1);\n578\t    q[2] = q1 ^ r1 ^ r2 ^ rotr32(q2 ^ r2);\n579\t    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr32(q3 ^ r3);\n580\t    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr32(q4 ^ r4);\n581\t    q[5] = q4 ^ r4 ^ r5 ^ rotr32(q5 ^ r5);\n582\t    q[6] = q5 ^ r5 ^ r6 ^ rotr32(q6 ^ r6);\n583\t    q[7] = q6 ^ r6 ^ r7 ^ rotr32(q7 ^ r7);\n584\t}\n585\t\n586\tfn interleave_constant(out: &mut [u64; 8], input: &[u8]) {\n587\t    let mut tmp_32_constant = [0u32; 16];\n588\t\n589\t    br_range_dec32le(&mut tmp_32_constant, 16, input);\n590\t    for i in 0..4 {\n591\t        // br_aes_ct64_interleave_in(&out[i], &out[i + 4], tmp_32_constant + (i << 2));\n592\t        let mut a: u64 = out[i];\n593\t        let mut b: u64 = out[i + 4];\n594\t        br_aes_ct64_interleave_in(&mut a, &mut b, &tmp_32_constant[(i << 2)..]);\n595\t        out[i] = a;\n596\t        out[i + 4] = b;\n597\t    }\n598\t    br_aes_ct64_ortho(out);\n599\t}\n600\t\n601\tfn interleave_constant32(out: &mut [u32; 8], input: &[u8]) {\n602\t    for i in 0..4 {\n603\t        out[2 * i] = br_dec32le(&input[4 * i..]);\n604\t        out[2 * i + 1] = br_dec32le(&input[4 * i + 16..]);\n605\t    }\n606\t    br_aes_ct_ortho(out);\n607\t}\n608\t\n609\tpub fn tweak_constants(ctx: &mut SpxCtx) {\n610\t    let mut buf = [0u8; 40 * 16];\n611\t\n612\t    /* Use the standard constants to generate tweaked ones. */\n613\t    ctx.tweaked512_rc64 = HARAKA512_RC64;\n614\t\n615\t    /* Constants for pk.seed */\n616\t    let pub_seed = ctx.pub_seed;\n617\t    haraka_S(&mut buf, &pub_seed, ctx);\n618\t    for i in 0..10 {\n619\t        let mut rc32 = [0u32; 8];\n620\t        interleave_constant32(&mut rc32, &buf[32 * i..]);\n621\t        ctx.tweaked256_rc32[i] = rc32;\n622\t\n623\t        let mut rc64 = [0u64; 8];\n624\t        interleave_constant(&mut rc64, &buf[64 * i..]);\n625\t        ctx.tweaked512_rc64[i] = rc64;\n626\t    }\n627\t}\n628\t\n629\tfn haraka_S_absorb(s: &mut [u8], r: usize, m: &[u8], mlen: usize, p: u8, ctx: &SpxCtx) {\n630\t    let mut t_buf = [0u8; HARAKAS_RATE];\n631\t    let t = &mut t_buf[..r];\n632\t\n633\t    let mut mlen = mlen;\n634\t    let mut moff: usize = 0;\n635\t\n636\t    while mlen >= r {\n637\t        /* XOR block to state */\n638\t        for i in 0..r {\n639\t            s[i] ^= m[moff + i];\n640\t        }\n641\t        haraka512_perm_inplace(s, ctx);\n642\t        mlen -= r;\n643\t        moff += r;\n644\t    }\n645\t\n646\t    for i in 0..r {\n647\t        t[i] = 0;\n648\t    }\n649\t    for i in 0..mlen {\n650\t        t[i] = m[moff + i];\n651\t    }\n652\t    t[mlen] = p;\n653\t    t[r - 1] |= 128;\n654\t    for i in 0..r {\n655\t        s[i] ^= t[i];\n656\t    }\n657\t}\n658\t\n659\tfn haraka_S_squeezeblocks(h: &mut [u8], nblocks: u64, s: &mut [u8], r: usize, ctx: &SpxCtx) {\n660\t    let mut nblocks = nblocks;\n661\t    let mut hoff: usize = 0;\n662\t    while nblocks > 0 {\n663\t        haraka512_perm_inplace(s, ctx);\n664\t        h[hoff..hoff + HARAKAS_RATE].copy_from_slice(&s[..HARAKAS_RATE]);\n665\t        hoff += r;\n666\t        nblocks -= 1;\n667\t    }\n668\t}\n669\t\n670\tpub fn haraka_S_inc_init(s_inc: &mut [u8]) {\n671\t    for i in 0..64 {\n672\t        s_inc[i] = 0;\n673\t    }\n674\t    s_inc[64] = 0;\n675\t}\n676\t\n677\tpub fn haraka_S_inc_absorb(s_inc: &mut [u8], m: &[u8], ctx: &SpxCtx) {\n678\t    let mut mlen: usize = m.len();\n679\t    let mut moff: usize = 0;\n680\t\n681\t    /* Recall that s_inc[64] is the non-absorbed bytes xored into the state */\n682\t    while mlen + (s_inc[64] as usize) >= HARAKAS_RATE {\n683\t        for i in 0..(HARAKAS_RATE - s_inc[64] as usize) {\n684\t            /* Take the i'th byte from message\n685\t               xor with the s_inc[64] + i'th byte of the state */\n686\t            let idx = s_inc[64] as usize + i;\n687\t            s_inc[idx] ^= m[moff + i];\n688\t        }\n689\t        mlen -= HARAKAS_RATE - (s_inc[64] as usize);\n690\t        moff += HARAKAS_RATE - (s_inc[64] as usize);\n691\t        s_inc[64] = 0;\n692\t\n693\t        haraka512_perm_inplace(s_inc, ctx);\n694\t    }\n695\t\n696\t    for i in 0..mlen {\n697\t        let idx = s_inc[64] as usize + i;\n698\t        s_inc[idx] ^= m[moff + i];\n699\t    }\n700\t    s_inc[64] = s_inc[64].wrapping_add(mlen as u8);\n701\t}\n702\t\n703\tpub fn haraka_S_inc_finalize(s_inc: &mut [u8]) {\n704\t    /* After haraka_S_inc_absorb, we are guaranteed that s_inc[64] < HARAKAS_RATE,\n705\t       so we can always use one more byte for p in the current state. */\n706\t    let idx = s_inc[64] as usize;\n707\t    s_inc[idx] ^= 0x1F;\n708\t    s_inc[HARAKAS_RATE - 1] ^= 128;\n709\t    s_inc[64] = 0;\n710\t}\n711\t\n712\tpub fn haraka_S_inc_squeeze(out: &mut [u8], s_inc: &mut [u8], ctx: &SpxCtx) {\n713\t    let mut outlen: usize = out.len();\n714\t    let mut outoff: usize = 0;\n715\t    let mut i: usize;\n716\t\n717\t    /* First consume any bytes we still have sitting around */\n718\t    i = 0;\n719\t    while i < outlen && i < s_inc[64] as usize {\n720\t        /* There are s_inc[64] bytes left, so r - s_inc[64] is the first\n721\t           available byte. We consume from there, i.e., up to r. */\n722\t        out[outoff + i] = s_inc[HARAKAS_RATE - s_inc[64] as usize + i];\n723\t        i += 1;\n724\t    }\n725\t    outoff += i;\n726\t    outlen -= i;\n727\t    s_inc[64] = s_inc[64].wrapping_sub(i as u8);\n728\t\n729\t    /* Then squeeze the remaining necessary blocks */\n730\t    while outlen > 0 {\n731\t        haraka512_perm_inplace(s_inc, ctx);\n732\t\n733\t        i = 0;\n734\t        while i < outlen && i < HARAKAS_RATE {\n735\t            out[outoff + i] = s_inc[i];\n736\t            i += 1;\n737\t        }\n738\t        outoff += i;\n739\t        outlen -= i;\n740\t        s_inc[64] = (HARAKAS_RATE - i) as u8;\n741\t    }\n742\t}\n743\t\n744\tpub fn haraka_S(out: &mut [u8], input: &[u8], ctx: &SpxCtx) {\n745\t    let outlen: usize = out.len();\n746\t    let inlen: usize = input.len();\n747\t    let mut s = [0u8; 64];\n748\t    let mut d = [0u8; 32];\n749\t\n750\t    for i in 0..64 {\n751\t        s[i] = 0;\n752\t    }\n753\t    haraka_S_absorb(&mut s, 32, input, inlen, 0x1F, ctx);\n754\t\n755\t    let nblocks = outlen / 32;\n756\t    haraka_S_squeezeblocks(&mut out[..nblocks * 32], nblocks as u64, &mut s, 32, ctx);\n757\t    let outoff = nblocks * 32;\n758\t\n759\t    if outlen % 32 != 0 {\n760\t        haraka_S_squeezeblocks(&mut d, 1, &mut s, 32, ctx);\n761\t        for i in 0..(outlen % 32) {\n762\t            out[outoff + i] = d[i];\n763\t        }\n764\t    }\n765\t}\n766\t\n767\t/// In-place variant of [`haraka512_perm`]; the C code calls\n768\t/// `haraka512_perm(s, s, ctx)` with aliasing pointers, which is well-defined\n769\t/// there because the entire input is decoded before any output byte is written.\n770\tfn haraka512_perm_inplace(buf: &mut [u8], ctx: &SpxCtx) {\n771\t    let mut tmp = [0u8; 64];\n772\t    tmp.copy_from_slice(&buf[..64]);\n773\t    haraka512_perm(&mut buf[..64], &tmp, ctx);\n774\t}\n775\t\n776\tpub fn haraka512_perm(out: &mut [u8], input: &[u8], ctx: &SpxCtx) {\n777\t    let mut w = [0u32; 16];\n778\t    let mut q = [0u64; 8];\n779\t    let mut tmp_q: u64;\n780\t\n781\t    br_range_dec32le(&mut w, 16, input);\n782\t    for i in 0..4 {\n783\t        let mut a: u64 = q[i];\n784\t        let mut b: u64 = q[i + 4];\n785\t        br_aes_ct64_interleave_in(&mut a, &mut b, &w[(i << 2)..]);\n786\t        q[i] = a;\n787\t        q[i + 4] = b;\n788\t    }\n789\t    br_aes_ct64_ortho(&mut q);\n790\t\n791\t    /* AES rounds */\n792\t    for i in 0..5 {\n793\t        for j in 0..2 {\n794\t            br_aes_ct64_bitslice_sbox(&mut q);\n795\t            shift_rows(&mut q);\n796\t            mix_columns(&mut q);\n797\t            add_round_key(&mut q, &ctx.tweaked512_rc64[2 * i + j]);\n798\t        }\n799\t        /* Mix states */\n800\t        for j in 0..8 {\n801\t            tmp_q = q[j];\n802\t            q[j] = (tmp_q & 0x0001000100010001u64) << 5\n803\t                | (tmp_q & 0x0002000200020002u64) << 12\n804\t                | (tmp_q & 0x0004000400040004u64) >> 1\n805\t                | (tmp_q & 0x0008000800080008u64) << 6\n806\t                | (tmp_q & 0x0020002000200020u64) << 9\n807\t                | (tmp_q & 0x0040004000400040u64) >> 4\n808\t                | (tmp_q & 0x0080008000800080u64) << 3\n809\t                | (tmp_q & 0x2100210021002100u64) >> 5\n810\t                | (tmp_q & 0x0210021002100210u64) << 2\n811\t                | (tmp_q & 0x0800080008000800u64) << 4\n812\t                | (tmp_q & 0x1000100010001000u64) >> 12\n813\t                | (tmp_q & 0x4000400040004000u64) >> 10\n814\t                | (tmp_q & 0x8400840084008400u64) >> 3;\n815\t        }\n816\t    }\n817\t\n818\t    br_aes_ct64_ortho(&mut q);\n819\t    for i in 0..4 {\n820\t        let a = q[i];\n821\t        let b = q[i + 4];\n822\t        br_aes_ct64_interleave_out(&mut w[(i << 2)..], a, b);\n823\t    }\n824\t    br_range_enc32le(out, &w, 16);\n825\t}\n826\t\n827\tpub fn haraka512(out: &mut [u8], input: &[u8], ctx: &SpxCtx) {\n828\t    let mut buf = [0u8; 64];\n829\t\n830\t    haraka512_perm(&mut buf, input, ctx);\n831\t    /* Feed-forward */\n832\t    for i in 0..64 {\n833\t        buf[i] = buf[i] ^ input[i];\n834\t    }\n835\t\n836\t    /* Truncated */\n837\t    out[0..8].copy_from_slice(&buf[8..16]);\n838\t    out[8..16].copy_from_slice(&buf[24..32]);\n839\t    out[16..24].copy_from_slice(&buf[32..40]);\n840\t    out[24..32].copy_from_slice(&buf[48..56]);\n841\t}\n842\t\n843\tpub fn haraka256(out: &mut [u8], input: &[u8], ctx: &SpxCtx) {\n844\t    let mut q = [0u32; 8];\n845\t    let mut tmp_q: u32;\n846\t\n847\t    for i in 0..4 {\n848\t        q[2 * i] = br_dec32le(&input[4 * i..])