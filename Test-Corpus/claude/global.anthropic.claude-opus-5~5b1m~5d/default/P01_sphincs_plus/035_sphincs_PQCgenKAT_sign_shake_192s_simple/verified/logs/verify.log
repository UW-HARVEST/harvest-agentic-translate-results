unsigned char *)addr)[SPX_OFFSET_TREE_INDEX], tree_index );\n   104\t}\n==== address.h\n     1\t#ifndef SPX_ADDRESS_H\n     2\t#define SPX_ADDRESS_H\n     3\t\n     4\t#include <stdint.h>\n     5\t\n     6\t#include \"params.h\"\n     7\t\n     8\t/* The hash types that are passed to set_type */\n     9\t#define SPX_ADDR_TYPE_WOTS 0\n    10\t#define SPX_ADDR_TYPE_WOTSPK 1\n    11\t#define SPX_ADDR_TYPE_HASHTREE 2\n    12\t#define SPX_ADDR_TYPE_FORSTREE 3\n    13\t#define SPX_ADDR_TYPE_FORSPK 4\n    14\t#define SPX_ADDR_TYPE_WOTSPRF 5\n    15\t#define SPX_ADDR_TYPE_FORSPRF 6\n    16\t\n    17\t#define set_layer_addr SPX_NAMESPACE(set_layer_addr)\n    18\tvoid set_layer_addr(uint32_t addr[8], uint32_t layer);\n    19\t\n    20\t#define set_tree_addr SPX_NAMESPACE(set_tree_addr)\n    21\tvoid set_tree_addr(uint32_t addr[8], uint64_t tree);\n    22\t\n    23\t#define set_type SPX_NAMESPACE(set_type)\n    24\tvoid set_type(uint32_t addr[8], uint32_t type);\n    25\t\n    26\t/* Copies the layer and tree part of one address into the other */\n    27\t#define copy_subtree_addr SPX_NAMESPACE(copy_subtree_addr)\n    28\tvoid copy_subtree_addr(uint32_t out[8], const uint32_t in[8]);\n    29\t\n    30\t/* These functions are used for WOTS and FORS addresses. */\n    31\t\n    32\t#define set_keypair_addr SPX_NAMESPACE(set_keypair_addr)\n    33\tvoid set_keypair_addr(uint32_t addr[8], uint32_t keypair);\n    34\t\n    35\t#define set_chain_addr SPX_NAMESPACE(set_chain_addr)\n    36\tvoid set_chain_addr(uint32_t addr[8], uint32_t chain);\n    37\t\n    38\t#define set_hash_addr SPX_NAMESPACE(set_hash_addr)\n    39\tvoid set_hash_addr(uint32_t addr[8], uint32_t hash);\n    40\t\n    41\t#define copy_keypair_addr SPX_NAMESPACE(copy_keypair_addr)\n    42\tvoid copy_keypair_addr(uint32_t out[8], const uint32_t in[8]);\n    43\t\n    44\t/* These functions are used for all hash tree addresses (including FORS). */\n    45\t\n    46\t#define set_tree_height SPX_NAMESPACE(set_tree_heigh