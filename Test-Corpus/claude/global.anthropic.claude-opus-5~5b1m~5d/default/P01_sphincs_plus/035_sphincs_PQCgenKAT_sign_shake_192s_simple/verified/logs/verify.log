{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012bDEgzRF4FRPGigZ99Vgd5","type":"tool_result","content":"1\t//! Translation of `lib/blake/src/hash_blake.c`.\n2\t\n3\tuse crate::address::addr_bytes;\n4\tuse crate::backend::blake256::{BlakeState256, SPX_BLAKE256_OUTPUT_BYTES};\n5\tuse crate::backend::blake512::BlakeState512;\n6\tuse crate::context::SpxCtx;\n7\tuse crate::params::{\n8\t    SPX_ADDR_BYTES, SPX_D, SPX_FORS_MSG_BYTES, SPX_N, SPX_PK_BYTES, SPX_TREE_HEIGHT,\n9\t};\n10\tuse crate::utils::bytes_to_ull;\n11\t\n12\t// ---------------------------------------------------------------------------\n13\t// #if SPX_N >= 24  ->  blakeX == blake512, else blakeX == blake256\n14\t// ---------------------------------------------------------------------------\n15\t#[cfg(any(\n16\t    feature = \"192s\",\n17\t    feature = \"192f\",\n18\t    feature = \"256s\",\n19\t    feature = \"256f\"\n20\t))]\n21\tmod blakex {\n22\t    pub use crate::backend::blake512::{\n23\t        blake512_final as blakex_final, blake512_init as blakex_init,\n24\t        blake512_mgf1 as blakex_mgf1, blake512_update_bits as blakex_update_bits,\n25\t        BlakeState512 as BlakestateX, SPX_BLAKE512_OUTPUT_BYTES as SPX_BLAKEX_OUTPUT_BYTES,\n26\t    };\n27\t}\n28\t\n29\t#[cfg(not(any(\n30\t    feature = \"192s\",\n31\t    feature = \"192f\",\n32\t    feature = \"256s\",\n33\t    feature = \"256f\"\n34\t)))]\n35\tmod blakex {\n36\t    pub use crate::backend::blake256::{\n37\t        blake256_final as blakex_final, blake256_init as blakex_init,\n38\t        blake256_mgf1 as blakex_mgf1, blake256_update_bits as blakex_update_bits,\n39\t        BlakeState256 as BlakestateX, SPX_BLAKE256_OUTPUT_BYTES as SPX_BLAKEX_OUTPUT_BYTES,\n40\t    };\n41\t}\n42\t\n43\tuse blakex::*;\n44\t\n45\tpub fn initialize_hash_function(_ctx: &mut SpxCtx) {\n46\t    /* (void)ctx; */\n47\t}\n48\t\n49\t/// Computes PRF(key, addr), given a secret key of SPX_N bytes and an address.\n50\tpub fn prf_addr(out: &mut [u8], ctx: &SpxCtx, addr: &[u32; 8]) {\n51\t    let mut buf = [0u8; 2 * SPX_N + SPX_ADDR_BYTES];\n52\t    let mut outbuf = [0u8; SPX_BLAKE256_OUTPUT_BYTES];\n53\t\n54\t    buf[..SPX_N].copy_from_slice(&ctx.pub_seed);\n55\t    buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(&addr_bytes(addr)[..SPX_ADDR_BYTES]);\n56\t    buf[SPX_N + SPX_ADDR_BYTES..2 * SPX_N + SPX_ADDR_BYTES].copy_from_slice(&ctx.sk_seed);\n57\t\n58\t    /* NOTE: as in the C reference, only the first SPX_N + SPX_ADDR_BYTES bytes\n59\t     * are hashed (the appended sk_seed is not covered). */\n60\t    crate::backend::blake256::blake256(&mut outbuf, &buf[..SPX_N + SPX_ADDR_BYTES]);\n61\t\n62\t    out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n63\t}\n64\t\n65\t/// Computes the message-dependent randomness R, using a secret seed and an\n66\t/// optional randomization value as well as the message.\n67\t///\n68\t/// NOTE: `blakeX_update` takes its length in **bits**, but the C reference hands\n69\t/// it *byte* counts (`SPX_N`, `mlen`). This is faithfully reproduced: only\n70\t/// `len / 8` bytes of each input are actually absorbed.\n71\tpub fn gen_message_random(r: &mut [u8], sk_prf: &[u8], optrand: &[u8], m: &[u8], _ctx: &SpxCtx) {\n72\t    let mut s = BlakestateX::new();\n73\t\n74\t    blakex_init(&mut s);\n75\t    blakex_update_bits(&mut s, &sk_prf[..SPX_N], SPX_N as u64);\n76\t    blakex_update_bits(&mut s, &optrand[..SPX_N], SPX_N as u64);\n77\t    blakex_update_bits(&mut s, m, m.len() as u64);\n78\t\n79\t    /* `blakeX_final` unconditionally emits SPX_BLAKEX_OUTPUT_BYTES bytes, which\n80\t     * is more than SPX_N whenever SPX_N < SPX_BLAKEX_OUTPUT_BYTES. The C\n81\t     * reference passes `R` (a pointer into the signature buffer) directly, so\n82\t     * the surplus bytes spill past R into the following region of the\n83\t     * signature. Those bytes are subsequently overwritten in full by the FORS\n84\t     * signature, so they never reach the output. Finalizing into a local buffer\n85\t     * and copying back only what fits in `r` is therefore byte-identical to the\n86\t     * C original, while staying inside Rust's bounds. */\n87\t    let mut outbuf = [0u8; SPX_BLAKEX_OUTPUT_BYTES];\n88\t    blakex_final(&mut s, &mut outbuf);\n89\t\n90\t    let n = core::cmp::min(r.len(), SPX_BLAKEX_OUTPUT_BYTES);\n91\t    r[..n].copy_from_slice(&outbuf[..n]);\n92\t}\n93\t\n94\tconst SPX_TREE_BITS: usize = SPX_TREE_HEIGHT * (SPX_D - 1);\n95\tconst SPX_TREE_BYTES: usize = (SPX_TREE_BITS + 7) / 8;\n96\tconst SPX_LEAF_BITS: usize = SPX_TREE_HEIGHT;\n97\tconst SPX_LEAF_BYTES: usize = (SPX_LEAF_BITS + 7) / 8;\n98\tconst SPX_DGST_BYTES: usize = SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES;\n99\t\n100\t/// Computes the message hash using R, the public key, and the message.\n101\t/// Outputs the message digest and the index of the leaf. The index is split in\n102\t/// the tree index and the leaf index, for convenient copying to an address.\n103\tpub fn hash_message(\n104\t    digest: &mut [u8],\n105\t    tree: &mut u64,\n106\t    leaf_idx: &mut u32,\n107\t    r: &[u8],\n108\t    pk: &[u8],\n109\t    m: &[u8],\n110\t    _ctx: &SpxCtx,\n111\t) {\n112\t    let mut buf = [0u8; SPX_DGST_BYTES];\n113\t    let mut seed = [0u8; 2 * SPX_N + SPX_BLAKEX_OUTPUT_BYTES];\n114\t\n115\t    let mut s = BlakestateX::new();\n116\t    blakex_init(&mut s);\n117\t\n118\t    /* NOTE: byte counts handed to a bit-count API, exactly as in the C. */\n119\t    blakex_update_bits(&mut s, &r[..SPX_N], SPX_N as u64);\n120\t    blakex_update_bits(&mut s, &pk[..SPX_PK_BYTES], SPX_PK_BYTES as u64);\n121\t    blakex_update_bits(&mut s, m, m.len() as u64);\n122\t\n123\t    blakex_final(&mut s, &mut seed[2 * SPX_N..]);\n124\t\n125\t    seed[..SPX_N].copy_from_slice(&r[..SPX_N]);\n126\t    seed[SPX_N..2 * SPX_N].copy_from_slice(&pk[..SPX_N]);\n127\t\n128\t    blakex_mgf1(&mut buf[..SPX_DGST_BYTES], &seed);\n129\t\n130\t    digest[..SPX_FORS_MSG_BYTES].copy_from_slice(&buf[..SPX_FORS_MSG_BYTES]);\n131\t    let mut bufp = SPX_FORS_MSG_BYTES;\n132\t\n133\t    /* #if SPX_TREE_BITS > 64 -> #error (checked at compile time in C) */\n134\t\n135\t    if SPX_D == 1 {\n136\t        *tree = 0;\n137\t    } else {\n138\t        *tree = bytes_to_ull(&buf[bufp..], SPX_TREE_BYTES as u32);\n139\t        *tree &= u64::MAX.wrapping_shr((64 - SPX_TREE_BITS) as u32);\n140\t    }\n141\t    bufp += SPX_TREE_BYTES;\n142\t\n143\t    *leaf_idx = bytes_to_ull(&buf[bufp..], SPX_LEAF_BYTES as u32) as u32;\n144\t    *leaf_idx &= u32::MAX.wrapping_shr((32 - SPX_LEAF_BITS) as u32);\n145\t}\n146\t\n147\t// ===========================================================================\n148\t// C ABI wrappers\n149\t// ===========================================================================\n150\t\n151\t// --- lib/blake/include/blake.h (non-namespaced) -----------------------------\n152\t\n153\t/// `int blake256(unsigned char *out, const unsigned char *in, unsigned long long inlen)`\n154\t#[unsafe(no_mangle)]\n155\tpub extern \"C\" fn blake256(out: *mut u8, input: *const u8, inlen: u64) -> i32 {\n156\t    unsafe {\n157\t        let out = core::slice::from_raw_parts_mut(out, SPX_BLAKE256_OUTPUT_BYTES);\n158\t        let input = core::slice::from_raw_parts(input, inlen as usize);\n159\t        crate::backend::blake256::blake256(out, input)\n160\t    }\n161\t}\n162\t\n163\t/// `void blake256_init(blakestate256 *S)`\n164\t#[unsafe(no_mangle)]\n165\tpub extern \"C\" fn blake256_init(s: *mut BlakeState256) {\n166\t    unsafe { crate::backend::blake256::blake256_init(&mut *s) }\n167\t}\n168\t\n169\t/// `void blake256_compress(blakestate256 *S, const unsigned char *block)`\n170\t#[unsafe(no_mangle)]\n171\tpub extern \"C\" fn blake256_compress(s: *mut BlakeState256, block: *const u8) {\n172\t    unsafe {\n173\t        let block = core::slice::from_raw_parts(block, 64);\n174\t        crate::backend::blake256::blake256_compress(&mut *s, block)\n175\t    }\n176\t}\n177\t\n178\t/// `void blake256_update(blakestate256 *S, const unsigned char *in, unsigned long long inlen)`\n179\t/// (`inlen` is a *bit* count, as in the C source.)\n180\t#[unsafe(no_mangle)]\n181\tpub extern \"C\" fn blake256_update(s: *mut BlakeState256, input: *const u8, inlen: u64) {\n182\t    unsafe {\n183\t        let input = core::slice::from_raw_parts(input, (inlen >> 3) as usize);\n184\t        crate::backend::blake256::blake256_update_bits(&mut *s, input, inlen)\n185\t    }\n186\t}\n187\t\n188\t/// `void blake256_final(blakestate256 *S, unsigned char *out)`\n189\t#[unsafe(no_mangle)]\n190\tpub extern \"C\" fn blake256_final(s: *mut BlakeState256, out: *mut u8) {\n191\t    unsafe {\n192\t        let out = core::slice::from_raw_parts_mut(out, SPX_BLAKE256_OUTPUT_BYTES);\n193\t        crate::backend::blake256::blake256_final(&mut *s, out)\n194\t    }\n195\t}\n196\t\n197\t/// `int blake512(uint8_t *out, const unsigned char *in, unsigned long long inlen)`\n198\t#[unsafe(no_mangle)]\n199\tpub extern \"C\" fn blake512(out: *mut u8, input: *const u8, inlen: u64) -> i32 {\n200\t    unsafe {\n201\t        let out = core::slice::from_raw_parts_mut(\n202\t            out,\n203\t            crate::backend::blake512::SPX_BLAKE512_OUTPUT_BYTES,\n204\t        );\n205\t        let input = core::slice::from_raw_parts(input, inlen as usize);\n206\t        crate::backend::blake512::blake512(out, input)\n207\t    }\n208\t}\n209\t\n210\t/// `void blake512_init(blakestate512 *S)`\n211\t#[unsafe(no_mangle)]\n212\tpub extern \"C\" fn blake512_init(s: *mut BlakeState512) {\n213\t    unsafe { crate::backend::blake512::blake512_init(&mut *s) }\n214\t}\n215\t\n216\t/// `void blake512_compress(blakestate512 *S, const unsigned char *block)`\n217\t#[unsafe(no_mangle)]\n218\tpub extern \"C\" fn blake512_compress(s: *mut BlakeState512, block: *const u8) {\n219\t    unsafe {\n220\t        let block = core::slice::from_raw_parts(block, 128);\n221\t        crate::backend::blake512::blake512_compress(&mut *s, block)\n222\t    }\n223\t}\n224\t\n225\t/// `void blake512_update(blakestate512 *S, const unsigned char *in, unsigned long long inlen)`\n226\t/// (`inlen` is a *bit* count, as in the C source.)\n227\t#[unsafe(no_mangle)]\n228\tpub extern \"C\" fn blake512_update(s: *mut BlakeState512, input: *const u8, inlen: u64) {\n229\t    unsafe {\n230\t        let input = core::slice::from_raw_parts(input, (inlen >> 3) as usize);\n231\t        crate::backend::blake512::blake512_update_bits(&mut *s, input, inlen)\n232\t    }\n233\t}\n234\t\n235\t/// `void blake512_final(blakestate512 *S, unsigned char *out)`\n236\t#[unsafe(no_mangle)]\n237\tpub extern \"C\" fn blake512_final(s: *mut BlakeState512, out: *mut u8) {\n238\t    unsafe {\n239\t        let out = core::slice::from_raw_parts_mut(\n240\t            out,\n241\t            crate::backend::blake512::SPX_BLAKE512_OUTPUT_BYTES,\n242\t        );\n243\t        crate::backend::blake512::blake512_final(&mut *s, out)\n244\t    }\n245\t}\n246\t\n247\t/// `void blake256_mgf1(unsigned char *out, unsigned long outlen,\n248\t///                     const unsigned char *in, unsigned long inlen)`\n249\t#[unsafe(no_mangle)]\n250\tpub extern \"C\" fn SPX_blake256_mgf1(out: *mut u8, outlen: u64, input: *const u8, inlen: u64) {\n251\t    unsafe {\n252\t        let out = core::slice::from_raw_parts_mut(out, outlen as usize);\n253\t        let input = core::slice::from_raw_parts(input, inlen as usize);\n254\t        crate::backend::blake256::blake256_mgf1(out, input)\n255\t    }\n256\t}\n257\t\n258\t/// `void blake512_mgf1(unsigned char *out, unsigned long outlen,\n259\t///                     const unsigned char *in, unsigned long inlen)`\n260\t#[unsafe(no_mangle)]\n261\tpub extern \"C\" fn SPX_blake512_mgf1(out: *mut u8, outlen: u64, input: *const u8, inlen: u64) {\n262\t    unsafe {\n263\t        let out = core::slice::from_raw_parts_mut(out, outlen as usize);\n264\t        let input = core::slice::from_raw_parts(input, inlen as usize);\n265\t        crate::backend::blake512::blake512_mgf1(out, input)\n266\t    }\n267\t}\n268\t\n269\t// --- app/include/hash.h (namespaced) ---------------------------------------\n270\t\n271\t#[unsafe(no_mangle)]\n272\tpub extern \"C\" fn SPX_initialize_hash_function(ctx: *mut SpxCtx) {\n273\t    unsafe { initialize_hash_function(&mut *ctx) }\n274\t}\n275\t\n276\t#[unsafe(no_mangle)]\n277\tpub extern \"C\" fn SPX_prf_addr(out: *mut u8, ctx: *const SpxCtx, addr: *const u32) {\n278\t    unsafe {\n279\t        let out = core::slice::from_raw_parts_mut(out, SPX_N);\n280\t        prf_addr(out, &*ctx, &*(addr as *const [u32; 8]))\n281\t    }\n282\t}\n283\t\n284\t#[unsafe(no_mangle)]\n285\tpub extern \"C\" fn SPX_gen_message_random(\n286\t    r: *mut u8,\n287\t    sk_prf: *const u8,\n288\t    optrand: *const u8,\n289\t    m: *const u8,\n290\t    mlen: u64,\n291\t    ctx: *const SpxCtx,\n292\t) {\n293\t    unsafe {\n294\t        let r = core::slice::from_raw_parts_mut(r, SPX_BLAKEX_OUTPUT_BYTES);\n295\t        let sk_prf = core::slice::from_raw_parts(sk_prf, SPX_N);\n296\t        let optrand = core::slice::from_raw_parts(optrand, SPX_N);\n297\t        let m = core::slice::from_raw_parts(m, mlen as usize);\n298\t        gen_message_random(r, sk_prf, optrand, m, &*ctx)\n299\t    }\n300\t}\n301\t\n302\t#[unsafe(no_mangle)]\n303\tpub extern \"C\" fn SPX_hash_message(\n304\t    digest: *mut u8,\n305\t    tree: *mut u64,\n306\t    leaf_idx: *mut u32,\n307\t    r: *const u8,\n308\t    pk: *const u8,\n309\t    m: *const u8,\n310\t    mlen: u64,\n311\t    ctx: *const SpxCtx,\n312\t) {\n313\t    unsafe {\n314\t        let digest = core::slice::from_raw_parts_mut(digest, SPX_FORS_MSG_BYTES);\n315\t        let r = core::slice::from_raw_parts(r, SPX_N);\n316\t        let pk = core::slice::from_raw_parts(pk, SPX_PK_BYTES);\n317\t        let m = core::slice::from_raw_parts(m, mlen as usize);\n318\t        hash_message(digest, &mut *tree, &mut *leaf_idx, r, pk, m, &*ctx)\n319\t    }\n320\t}\n321\t"}]},"parent_tool