c_init(state: &mut [u8]) {\n440\t    for i in 0..64 {\n441\t        state[i] = IV_512[i];\n442\t    }\n443\t    for i in 64..72 {\n444\t        state[i] = 0;\n445\t    }\n446\t}\n447\t\n448\t/// `sha256_inc_blocks`\n449\tpub fn sha256_inc_blocks(state: &mut [u8], input: &[u8], inblocks: usize) {\n450\t    let mut bytes = load_bigendian_64(&state[32..]);\n451\t\n452\t    crypto_hashblocks_sha256(state, input, 64 * inblocks);\n453\t    bytes = bytes.wrapping_add((64 * inblocks) as u64);\n454\t\n455\t    store_bigendian_64(&mut state[32..], bytes);\n456\t}\n457\t\n458\t/// `sha512_inc_blocks`\n459\tpub fn sha512_inc_blocks(state: &mut [u8], input: &[u8], inblocks: usize) {\n460\t    let mut bytes = load_bigendian_64(&state[64..]);\n461\t\n462\t    crypto_hashblocks_sha512(state, input, (128 * inblocks) as u64);\n463\t    bytes = bytes.wrapping_add((128 * inblocks) as u64);\n464\t\n465\t    store_bigendian_64(&mut state[64..], bytes);\n466\t}\n467\t\n468\t/// `sha256_inc_finalize` -- `inlen` is `input.len()`.\n469\tpub fn sha256_inc_finalize(out: &mut [u8], state: &mut [u8], input: &[u8]) {\n470\t    let mut padded = [0u8; 128];\n471\t    let inlen_full = input.len();\n472\t    let bytes = load_bigendian_64(&state[32..]).wrapping_add(inlen_full as u64);\n473\t\n474\t    crypto_hashblocks_sha256(state, input, inlen_full);\n475\t    /* in += inlen; inlen &= 63; in -= inlen; */\n476\t    let inlen = inlen_full & 63;\n477\t    let tail = &input[inlen_full - inlen..];\n478\t\n479\t    for i in 0..inlen {\n480\t        padded[i] = tail[i];\n481\t    }\n482\t    padded[inlen] = 0x80;\n483\t\n484\t    if inlen < 56 {\n485\t        for i in inlen + 1..56 {\n486\t            padded[i] = 0;\n487\t        }\n488\t        padded[56] = (bytes >> 53) as u8;\n489\t        padded[57] = (bytes >> 45) as u8;\n490\t        padded[58] = (bytes >> 37) as u8;\n491\t        padded[59] = (bytes >> 29) as u8;\n492\t        padded[60] = (bytes >> 21) as u8;\n493\t        padded[61] = (bytes >> 13