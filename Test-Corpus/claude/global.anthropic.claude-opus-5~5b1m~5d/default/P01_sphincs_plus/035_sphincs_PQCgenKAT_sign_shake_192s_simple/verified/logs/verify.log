{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01M3C8SSMRpYznoG9bi4gjqA","type":"tool_result","content":"1\t//! Translation of `app/src/rng.c` + `app/include/rng.h`.\n2\t//!\n3\t//! This is the NIST KAT AES-256-CTR-DRBG used by the *deterministic*\n4\t//! `sphincs_core_det` library variant.  The original C implementation obtains a\n5\t//! single-block AES-256 ECB encryption from OpenSSL's `EVP_aes_256_ecb`; here we\n6\t//! use the pure-Rust `aes` crate instead.  The observable byte stream is\n7\t//! identical: `EVP_EncryptUpdate` over exactly one 16-byte block with no padding\n8\t//! emitted is just the raw ECB block encryption.\n9\t//!\n10\t//! Original header:\n11\t//! ```text\n12\t//!   rng.c\n13\t//!   Created by Bassham, Lawrence E (Fed) on 8/29/17.\n14\t//!   Copyright (c) 2017 Bassham, Lawrence E (Fed). All rights reserved.\n15\t//! ```\n16\t\n17\tuse aes::cipher::{generic_array::GenericArray, BlockEncrypt, KeyInit};\n18\tuse aes::Aes256;\n19\t\n20\t// #define RNG_SUCCESS      0\n21\t// #define RNG_BAD_MAXLEN  -1\n22\t// #define RNG_BAD_OUTBUF  -2\n23\t// #define RNG_BAD_REQ_LEN -3\n24\tpub const RNG_SUCCESS: i32 = 0;\n25\tpub const RNG_BAD_MAXLEN: i32 = -1;\n26\tpub const RNG_BAD_OUTBUF: i32 = -2;\n27\tpub const RNG_BAD_REQ_LEN: i32 = -3;\n28\t\n29\t/// `AES_XOF_struct` from `rng.h`.\n30\t///\n31\t/// `unsigned long` is 64 bits on the LP64 targets the reference implementation\n32\t/// is built for, hence `u64` for `buffer_pos` / `length_remaining`.\n33\t#[repr(C)]\n34\t#[derive(Clone)]\n35\tpub struct AesXofStruct {\n36\t    pub buffer: [u8; 16],\n37\t    pub buffer_pos: u64,\n38\t    pub length_remaining: u64,\n39\t    pub key: [u8; 32],\n40\t    pub ctr: [u8; 16],\n41\t}\n42\t\n43\timpl AesXofStruct {\n44\t    pub fn new() -> Self {\n45\t        AesXofStruct {\n46\t            buffer: [0u8; 16],\n47\t            buffer_pos: 0,\n48\t            length_remaining: 0,\n49\t            key: [0u8; 32],\n50\t            ctr: [0u8; 16],\n51\t        }\n52\t    }\n53\t}\n54\t\n55\timpl Default for AesXofStruct {\n56\t    fn default() -> Self {\n57\t        Self::new()\n58\t    }\n59\t}\n60\t\n61\t/// `AES256_CTR_DRBG_struct` from `rng.h`.\n62\t#[repr(C)]\n63\t#[derive(Clone)]\n64\tpub struct Aes256CtrDrbgStruct {\n65\t    pub Key: [u8; 32],\n66\t    pub V: [u8; 16],\n67\t    pub reseed_counter: i32,\n68\t}\n69\t\n70\timpl Aes256CtrDrbgStruct {\n71\t    pub fn new() -> Self {\n72\t        Aes256CtrDrbgStruct {\n73\t            Key: [0u8; 32],\n74\t            V: [0u8; 16],\n75\t            reseed_counter: 0,\n76\t        }\n77\t    }\n78\t}\n79\t\n80\timpl Default for Aes256CtrDrbgStruct {\n81\t    fn default() -> Self {\n82\t        Self::new()\n83\t    }\n84\t}\n85\t\n86\t/// `AES256_CTR_DRBG_struct DRBG_ctx;` -- a zero-initialised file-scope global in\n87\t/// the C translation unit.  It is *not* `static` in `rng.c`, so the C\n88\t/// `libsphincs_core_det.so` exports it as a writable data symbol named\n89\t/// `DRBG_ctx`; we export the very same storage under that exact name so an\n90\t/// external consumer can inspect / seed the DRBG state just like with the C\n91\t/// library.\n92\t#[unsafe(no_mangle)]\n93\tpub static mut DRBG_ctx: Aes256CtrDrbgStruct = Aes256CtrDrbgStruct {\n94\t    Key: [0u8; 32],\n95\t    V: [0u8; 16],\n96\t    reseed_counter: 0,\n97\t};\n98\t\n99\t/// Borrow the module-global DRBG state, exactly as the C code touches\n100\t/// `DRBG_ctx` directly.  Single-threaded use only, matching the C original.\n101\t#[inline]\n102\tfn drbg_ctx() -> &'static mut Aes256CtrDrbgStruct {\n103\t    unsafe { &mut *core::ptr::addr_of_mut!(DRBG_ctx) }\n104\t}\n105\t\n106\t// Use whatever AES implementation you have. (The C reference uses OpenSSL.)\n107\t//    key    - 256-bit AES key\n108\t//    ctr    - a 128-bit plaintext value\n109\t//    buffer - a 128-bit ciphertext value\n110\tpub fn aes256_ecb(key: &[u8; 32], ctr: &[u8; 16], buffer: &mut [u8; 16]) {\n111\t    let cipher = Aes256::new(GenericArray::from_slice(key));\n112\t    let mut blk = *GenericArray::from_slice(ctr);\n113\t    cipher.encrypt_block(&mut blk);\n114\t    buffer.copy_from_slice(blk.as_slice());\n115\t}\n116\t\n117\t/// `seedexpander_init()`\n118\t///\n119\t/// * `ctx`         - stores the current state of an instance of the seed expander\n120\t/// * `seed`        - a 32 byte random value\n121\t/// * `diversifier` - an 8 byte diversifier\n122\t/// * `maxlen`      - maximum number of bytes (less than 2**32) generated under\n123\t///   this seed and diversifier\n124\tpub fn seedexpander_init(\n125\t    ctx: &mut AesXofStruct,\n126\t    seed: &[u8],\n127\t    diversifier: &[u8],\n128\t    maxlen: u64,\n129\t) -> i32 {\n130\t    if maxlen >= 0x1_0000_0000u64 {\n131\t        return RNG_BAD_MAXLEN;\n132\t    }\n133\t\n134\t    ctx.length_remaining = maxlen;\n135\t\n136\t    ctx.key.copy_from_slice(&seed[..32]);\n137\t\n138\t    ctx.ctr[..8].copy_from_slice(&diversifier[..8]);\n139\t    let mut maxlen = maxlen;\n140\t    ctx.ctr[11] = (maxlen % 256) as u8;\n141\t    maxlen >>= 8;\n142\t    ctx.ctr[10] = (maxlen % 256) as u8;\n143\t    maxlen >>= 8;\n144\t    ctx.ctr[9] = (maxlen % 256) as u8;\n145\t    maxlen >>= 8;\n146\t    ctx.ctr[8] = (maxlen % 256) as u8;\n147\t    for b in ctx.ctr[12..16].iter_mut() {\n148\t        *b = 0x00;\n149\t    }\n150\t\n151\t    ctx.buffer_pos = 16;\n152\t    ctx.buffer = [0x00u8; 16];\n153\t\n154\t    RNG_SUCCESS\n155\t}\n156\t\n157\t/// `seedexpander()`\n158\t///\n159\t/// * `ctx` - stores the current state of an instance of the seed expander\n160\t/// * `x`   - returns the XOF data (`xlen` in C is `x.len()` here)\n161\t///\n162\t/// The C `x == NULL` -> `RNG_BAD_OUTBUF` check cannot trigger through this safe\n163\t/// entry point; it is preserved in the `extern \"C\"` wrapper below.\n164\tpub fn seedexpander(ctx: &mut AesXofStruct, x: &mut [u8]) -> i32 {\n165\t    let mut xlen: u64 = x.len() as u64;\n166\t\n167\t    if xlen >= ctx.length_remaining {\n168\t        return RNG_BAD_REQ_LEN;\n169\t    }\n170\t\n171\t    ctx.length_remaining -= xlen;\n172\t\n173\t    let mut offset: u64 = 0;\n174\t    while xlen > 0 {\n175\t        // 16 - ctx->buffer_pos  (unsigned long arithmetic; buffer_pos <= 16)\n176\t        let avail: u64 = 16u64.wrapping_sub(ctx.buffer_pos);\n177\t\n178\t        if xlen <= avail {\n179\t            // buffer has what we need\n180\t            let bp = ctx.buffer_pos as usize;\n181\t            let n = xlen as usize;\n182\t            let off = offset as usize;\n183\t            x[off..off + n].copy_from_slice(&ctx.buffer[bp..bp + n]);\n184\t            ctx.buffer_pos += xlen;\n185\t\n186\t            return RNG_SUCCESS;\n187\t        }\n188\t\n189\t        // take what's in the buffer\n190\t        {\n191\t            let bp = ctx.buffer_pos as usize;\n192\t            let n = avail as usize;\n193\t            let off = offset as usize;\n194\t            x[off..off + n].copy_from_slice(&ctx.buffer[bp..bp + n]);\n195\t        }\n196\t        xlen -= avail;\n197\t        offset += avail;\n198\t\n199\t        let key = ctx.key;\n200\t        let ctr = ctx.ctr;\n201\t        aes256_ecb(&key, &ctr, &mut ctx.buffer);\n202\t        ctx.buffer_pos = 0;\n203\t\n204\t        // increment the counter\n205\t        let mut i: i32 = 15;\n206\t        while i >= 12 {\n207\t            if ctx.ctr[i as usize] == 0xff {\n208\t                ctx.ctr[i as usize] = 0x00;\n209\t            } else {\n210\t                ctx.ctr[i as usize] = ctx.ctr[i as usize].wrapping_add(1);\n211\t                break;\n212\t            }\n213\t            i -= 1;\n214\t        }\n215\t    }\n216\t\n217\t    RNG_SUCCESS\n218\t}\n219\t\n220\t/// `randombytes_init(unsigned char *entropy_input, unsigned char *personalization_string)`\n221\t///\n222\t/// Note the NIST API variant used here takes no `security_strength` argument.\n223\tpub fn randombytes_init(entropy_input: &[u8], personalization_string: Option<&[u8]>) {\n224\t    let mut seed_material = [0u8; 48];\n225\t\n226\t    seed_material.copy_from_slice(&entropy_input[..48]);\n227\t    if let Some(ps) = personalization_string {\n228\t        for i in 0..48 {\n229\t            seed_material[i] ^= ps[i];\n230\t        }\n231\t    }\n232\t\n233\t    let ctx = drbg_ctx();\n234\t    ctx.Key = [0x00u8; 32];\n235\t    ctx.V = [0x00u8; 16];\n236\t    AES256_CTR_DRBG_Update(Some(&seed_material), &mut ctx.Key, &mut ctx.V);\n237\t    ctx.reseed_counter = 1;\n238\t}\n239\t\n240\t/// `randombytes(unsigned char *x, unsigned long long xlen)`\n241\tpub fn randombytes(x: &mut [u8]) -> i32 {\n242\t    let mut block = [0u8; 16];\n243\t    let mut i: usize = 0;\n244\t    let mut xlen: u64 = x.len() as u64;\n245\t\n246\t    let ctx = drbg_ctx();\n247\t\n248\t    while xlen > 0 {\n249\t        // increment V\n250\t        let mut j: i32 = 15;\n251\t        while j >= 0 {\n252\t            if ctx.V[j as usize] == 0xff {\n253\t                ctx.V[j as usize] = 0x00;\n254\t            } else {\n255\t                ctx.V[j as usize] = ctx.V[j as usize].wrapping_add(1);\n256\t                break;\n257\t            }\n258\t            j -= 1;\n259\t        }\n260\t\n261\t        let key = ctx.Key;\n262\t        let v = ctx.V;\n263\t        aes256_ecb(&key, &v, &mut block);\n264\t\n265\t        if xlen > 15 {\n266\t            x[i..i + 16].copy_from_slice(&block);\n267\t            i += 16;\n268\t            xlen -= 16;\n269\t        } else {\n270\t            let n = xlen as usize;\n271\t            x[i..i + n].copy_from_slice(&block[..n]);\n272\t            xlen = 0;\n273\t        }\n274\t    }\n275\t\n276\t    AES256_CTR_DRBG_Update(None, &mut ctx.Key, &mut ctx.V);\n277\t    ctx.reseed_counter = ctx.reseed_counter.wrapping_add(1);\n278\t\n279\t    RNG_SUCCESS\n280\t}\n281\t\n282\t/// `AES256_CTR_DRBG_Update(unsigned char *provided_data, unsigned char *Key, unsigned char *V)`\n283\tpub fn AES256_CTR_DRBG_Update(provided_data: Option<&[u8]>, key: &mut [u8], v: &mut [u8]) {\n284\t    let mut temp = [0u8; 48];\n285\t\n286\t    for i in 0..3usize {\n287\t        // increment V\n288\t        let mut j: i32 = 15;\n289\t        while j >= 0 {\n290\t            if v[j as usize] == 0xff {\n291\t                v[j as usize] = 0x00;\n292\t            } else {\n293\t                v[j as usize] = v[j as usize].wrapping_add(1);\n294\t                break;\n295\t            }\n296\t            j -= 1;\n297\t        }\n298\t\n299\t        let mut k = [0u8; 32];\n300\t        k.copy_from_slice(&key[..32]);\n301\t        let mut c = [0u8; 16];\n302\t        c.copy_from_slice(&v[..16]);\n303\t        let mut out = [0u8; 16];\n304\t        aes256_ecb(&k, &c, &mut out);\n305\t        temp[16 * i..16 * i + 16].copy_from_slice(&out);\n306\t    }\n307\t\n308\t    if provided_data.is_some() {\n309\t        let pd = provided_data.unwrap();\n310\t        for i in 0..48 {\n311\t            temp[i] ^= pd[i];\n312\t        }\n313\t    }\n314\t\n315\t    key[..32].copy_from_slice(&temp[..32]);\n316\t    v[..16].copy_from_slice(&temp[32..48]);\n317\t}\n318\t\n319\t// ---------------------------------------------------------------------------\n320\t// C ABI exports.  `rng.h` declares these with plain (non-namespaced) names --\n321\t// there are no `SPX_NAMESPACE` macros in that header -- so the exported symbols\n322\t// are the bare C identifiers.  They live in a nested module purely so the Rust\n323\t// item names can match the C names exactly without colliding with the safe\n324\t// wrappers above.\n325\t// ---------------------------------------------------------------------------\n326\tpub mod ffi {\n327\t    use super::{AesXofStruct, RNG_BAD_OUTBUF};\n328\t    use core::ffi::c_int;\n329\t\n330\t    /// C ABI: `void AES256_ECB(unsigned char *key, unsigned char *ctr, unsigned char *buffer)`\n331\t    ///\n332\t    /// `rng.c` declares this at file scope without `static`, so it is a public\n333\t    /// symbol of the C `libsphincs_core_det.so` even though `rng.h` does not\n334\t    /// declare it.  key = 256-bit AES key, ctr = 128-bit plaintext block,\n335\t    /// buffer = 128-bit ciphertext block.\n336\t    #[unsafe(no_mangle)]\n337\t    pub unsafe extern \"C\" fn AES256_ECB(key: *mut u8, ctr: *mut u8, buffer: *mut u8) {\n338\t        let mut k = [0u8; 32];\n339\t        k.copy_from_slice(core::slice::from_raw_parts(key, 32));\n340\t        let mut c = [0u8; 16];\n341\t        c.copy_from_slice(core::slice::from_raw_parts(ctr, 16));\n342\t        let mut out = [0u8; 16];\n343\t        super::aes256_ecb(&k, &c, &mut out);\n344\t        core::slice::from_raw_parts_mut(buffer, 16).copy_from_slice(&out);\n345\t    }\n346\t\n347\t    /// C ABI: `void AES256_CTR_DRBG_Update(unsigned char *provided_data, unsigned char *Key, unsigned char *V)`\n348\t    #[unsafe(no_mangle)]\n349\t    pub unsafe extern \"C\" fn AES256_CTR_DRBG_Update(\n350\t        provided_data: *mut u8,\n351\t        Key: *mut u8,\n352\t        V: *mut u8,\n353\t    ) {\n354\t        let key = core::slice::from_raw_parts_mut(Key, 32);\n355\t        let v = core::slice::from_raw_parts_mut(V, 16);\n356\t        if provided_data.is_null() {\n357\t            super::AES256_CTR_DRBG_Update(None, key, v);\n358\t        } else {\n359\t            // `provided_data` never aliases Key/V in any caller, mirroring C;\n360\t            // copy anyway so the borrow checker is satisfied.\n361\t            let mut pd_copy = [0u8; 48];\n362\t            pd_copy.copy_from_slice(core::slice::from_raw_parts(provided_data, 48));\n363\t            super::AES256_CTR_DRBG_Update(Some(&pd_copy), key, v);\n364\t        }\n365\t    }\n366\t\n367\t    /// C ABI: `int seedexpander_init(AES_XOF_struct *ctx, unsigned char *seed, unsigned char *diversifier, unsigned long maxlen)`\n368\t    #[unsafe(no_mangle)]\n369\t    pub unsafe extern \"C\" fn seedexpander_init(\n370\t        ctx: *mut AesXofStruct,\n371\t        seed: *mut u8,\n372\t        diversifier: *mut u8,\n373\t        maxlen: u64,\n374\t    ) -> c_int {\n375\t        let seed_s = core::slice::from_raw_parts(seed, 32);\n376\t        let div_s = core::slice::from_raw_parts(diversifier, 8);\n377\t        super::seedexpander_init(&mut *ctx, seed_s, div_s, maxlen) as c_int\n378\t    }\n379\t\n380\t    /// C ABI: `int seedexpander(AES_XOF_struct *ctx, unsigned char *x, unsigned long xlen)`\n381\t    #[unsafe(no_mangle)]\n382\t    pub unsafe extern \"C\" fn seedexpander(\n383\t        ctx: *mut AesXofStruct,\n384\t        x: *mut u8,\n385\t        xlen: u64,\n386\t    ) -> c_int {\n387\t        if x.is_null() {\n388\t            return RNG_BAD_OUTBUF as c_int;\n389\t        }\n390\t        let xs = core::slice::from_raw_parts_mut(x, xlen as usize);\n391\t        super::seedexpander(&mut *ctx, xs) as c_int\n392\t    }\n393\t\n394\t    /// C ABI: `void randombytes_init(unsigned char *entropy_input, unsigned char *personalization_string)`\n395\t    #[unsafe(no_mangle)]\n396\t    pub unsafe extern \"C\" fn randombytes_init(\n397\t        entropy_input: *mut u8,\n398\t        personalization_string: *mut u8,\n399\t    ) {\n400\t        let mut ei_copy = [0u8; 48];\n401\t        ei_copy.copy_from_slice(core::slice::from_raw_parts(entropy_input, 48));\n402\t        if personalization_string.is_null() {\n403\t            super::randombytes_init(&ei_copy, None);\n404\t        } else {\n405\t            let mut ps_copy = [0u8; 48];\n406\t            ps_copy.copy_from_slice(core::slice::from_raw_parts(personalization_string, 48));\n407\t            super::randombytes_init(&ei_copy, Some(&ps_copy));\n408\t        }\n409\t    }\n410\t\n411\t    /// C ABI: `int randombytes(unsigned char *x, unsigned long long xlen)`\n412\t    #[unsafe(no_mangle)]\n413\t    pub unsafe extern \"C\" fn randombytes(x: *mut u8, xlen: u64) -> c_int {\n414\t        let xs = core::slice::from_raw_parts_mut(x, xlen as usize);\n415\t        super::randombytes(xs) as c_int\n416\t    }\n417\t}\n418\t"}]},"parent_tool_use_id