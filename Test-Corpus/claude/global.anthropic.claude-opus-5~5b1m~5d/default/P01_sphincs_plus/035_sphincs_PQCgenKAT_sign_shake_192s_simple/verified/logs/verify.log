{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RCBZUErwWGWx1ubkFy87ES","type":"tool_result","content":"1\t//! Translation of `c_src/lib/sha2/src/hash_sha2.c`.\n2\t\n3\tuse crate::address::addr_bytes;\n4\tuse crate::backend::sha2;\n5\tuse crate::backend::sha2::{\n6\t    SPX_SHA256_ADDR_BYTES, SPX_SHA256_BLOCK_BYTES, SPX_SHA256_OUTPUT_BYTES, SPX_SHA512_BLOCK_BYTES,\n7\t    SPX_SHA512_OUTPUT_BYTES,\n8\t};\n9\tuse crate::context::SpxCtx;\n10\tuse crate::params::{\n11\t    SPX_D, SPX_FORS_MSG_BYTES, SPX_N, SPX_PK_BYTES, SPX_TREE_HEIGHT,\n12\t};\n13\tuse crate::utils::bytes_to_ull;\n14\t\n15\t// ---------------------------------------------------------------------------\n16\t// `#if SPX_N >= 24` -- select between SHA-512 and SHA-256 for `shaX`.\n17\t// ---------------------------------------------------------------------------\n18\t\n19\t/// `SPX_N >= 24` in the C preprocessor.\n20\tconst USE_512: bool = SPX_N >= 24;\n21\t\n22\tpub const SPX_SHAX_OUTPUT_BYTES: usize = if USE_512 {\n23\t    SPX_SHA512_OUTPUT_BYTES\n24\t} else {\n25\t    SPX_SHA256_OUTPUT_BYTES\n26\t};\n27\tpub const SPX_SHAX_BLOCK_BYTES: usize = if USE_512 {\n28\t    SPX_SHA512_BLOCK_BYTES\n29\t} else {\n30\t    SPX_SHA256_BLOCK_BYTES\n31\t};\n32\t\n33\t/// `uint8_t state[8 + SPX_SHAX_OUTPUT_BYTES]`\n34\tconst SPX_SHAX_STATE_BYTES: usize = 8 + SPX_SHAX_OUTPUT_BYTES;\n35\t\n36\t#[inline]\n37\tfn shax_inc_init(state: &mut [u8]) {\n38\t    if USE_512 {\n39\t        sha2::sha512_inc_init(state);\n40\t    } else {\n41\t        sha2::sha256_inc_init(state);\n42\t    }\n43\t}\n44\t\n45\t#[inline]\n46\tfn shax_inc_blocks(state: &mut [u8], input: &[u8], inblocks: usize) {\n47\t    if USE_512 {\n48\t        sha2::sha512_inc_blocks(state, input, inblocks);\n49\t    } else {\n50\t        sha2::sha256_inc_blocks(state, input, inblocks);\n51\t    }\n52\t}\n53\t\n54\t#[inline]\n55\tfn shax_inc_finalize(out: &mut [u8], state: &mut [u8], input: &[u8]) {\n56\t    if USE_512 {\n57\t        sha2::sha512_inc_finalize(out, state, input);\n58\t    } else {\n59\t        sha2::sha256_inc_finalize(out, state, input);\n60\t    }\n61\t}\n62\t\n63\t#[inline]\n64\tfn shax(out: &mut [u8], input: &[u8]) {\n65\t    if USE_512 {\n66\t        sha2::sha512(out, input);\n67\t    } else {\n68\t        sha2::sha256(out, input);\n69\t    }\n70\t}\n71\t\n72\t#[inline]\n73\tfn mgf1_x(out: &mut [u8], input: &[u8]) {\n74\t    if USE_512 {\n75\t        sha2::mgf1_512(out, input);\n76\t    } else {\n77\t        sha2::mgf1_256(out, input);\n78\t    }\n79\t}\n80\t\n81\t// ---------------------------------------------------------------------------\n82\t// hash.h API\n83\t// ---------------------------------------------------------------------------\n84\t\n85\t/// For SHA, there is no immediate reason to initialize at the start, so this\n86\t/// function is an empty operation.\n87\tpub fn initialize_hash_function(ctx: &mut SpxCtx) {\n88\t    sha2::seed_state(ctx);\n89\t}\n90\t\n91\t/// Computes PRF(pk_seed, sk_seed, addr).\n92\tpub fn prf_addr(out: &mut [u8], ctx: &SpxCtx, addr: &[u32; 8]) {\n93\t    let mut sha2_state = [0u8; 40];\n94\t    let mut buf = [0u8; SPX_SHA256_ADDR_BYTES + SPX_N];\n95\t    let mut outbuf = [0u8; SPX_SHA256_OUTPUT_BYTES];\n96\t\n97\t    /* Retrieve precomputed state containing pub_seed */\n98\t    sha2_state.copy_from_slice(&ctx.state_seeded[..40]);\n99\t\n100\t    /* Remainder: ADDR^c ‖ SK.seed */\n101\t    buf[..SPX_SHA256_ADDR_BYTES].copy_from_slice(&addr_bytes(addr)[..SPX_SHA256_ADDR_BYTES]);\n102\t    buf[SPX_SHA256_ADDR_BYTES..SPX_SHA256_ADDR_BYTES + SPX_N].copy_from_slice(&ctx.sk_seed[..SPX_N]);\n103\t\n104\t    sha2::sha256_inc_finalize(&mut outbuf, &mut sha2_state, &buf);\n105\t\n106\t    out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n107\t}\n108\t\n109\t/// Computes the message-dependent randomness R, using a secret seed as a key\n110\t/// for HMAC, and an optional randomization value prefixed to the message.\n111\tpub fn gen_message_random(r: &mut [u8], sk_prf: &[u8], optrand: &[u8], m: &[u8], ctx: &SpxCtx) {\n112\t    let _ = ctx;\n113\t\n114\t    let mut buf = [0u8; SPX_SHAX_BLOCK_BYTES + SPX_SHAX_OUTPUT_BYTES];\n115\t    let mut state = [0u8; SPX_SHAX_STATE_BYTES];\n116\t\n117\t    let mlen = m.len() as u64;\n118\t\n119\t    /* This implements HMAC-SHA */\n120\t    for i in 0..SPX_N {\n121\t        buf[i] = 0x36 ^ sk_prf[i];\n122\t    }\n123\t    for i in SPX_N..SPX_SHAX_BLOCK_BYTES {\n124\t        buf[i] = 0x36;\n125\t    }\n126\t\n127\t    shax_inc_init(&mut state);\n128\t    shax_inc_blocks(&mut state, &buf, 1);\n129\t\n130\t    buf[..SPX_N].copy_from_slice(&optrand[..SPX_N]);\n131\t\n132\t    /* If optrand + message cannot fill up an entire block */\n133\t    if (SPX_N as u64) + mlen < SPX_SHAX_BLOCK_BYTES as u64 {\n134\t        let ml = mlen as usize;\n135\t        buf[SPX_N..SPX_N + ml].copy_from_slice(&m[..ml]);\n136\t        let (inpart, outpart) = buf.split_at_mut(SPX_SHAX_BLOCK_BYTES);\n137\t        shax_inc_finalize(outpart, &mut state, &inpart[..ml + SPX_N]);\n138\t    }\n139\t    /* Otherwise first fill a block, so that finalize only uses the message */\n140\t    else {\n141\t        buf[SPX_N..SPX_SHAX_BLOCK_BYTES]\n142\t            .copy_from_slice(&m[..SPX_SHAX_BLOCK_BYTES - SPX_N]);\n143\t        shax_inc_blocks(&mut state, &buf, 1);\n144\t\n145\t        let m2 = &m[SPX_SHAX_BLOCK_BYTES - SPX_N..];\n146\t        let (_, outpart) = buf.split_at_mut(SPX_SHAX_BLOCK_BYTES);\n147\t        shax_inc_finalize(outpart, &mut state, m2);\n148\t    }\n149\t\n150\t    for i in 0..SPX_N {\n151\t        buf[i] = 0x5c ^ sk_prf[i];\n152\t    }\n153\t    for i in SPX_N..SPX_SHAX_BLOCK_BYTES {\n154\t        buf[i] = 0x5c;\n155\t    }\n156\t\n157\t    /* `shaX(buf, buf, ...)` in C: the whole input is consumed before the\n158\t       output is written, so this in-place call is well defined. */\n159\t    let mut tmp = [0u8; SPX_SHAX_OUTPUT_BYTES];\n160\t    shax(&mut tmp, &buf);\n161\t    buf[..SPX_SHAX_OUTPUT_BYTES].copy_from_slice(&tmp);\n162\t\n163\t    r[..SPX_N].copy_from_slice(&buf[..SPX_N]);\n164\t}\n165\t\n166\t// ---------------------------------------------------------------------------\n167\t// hash_message\n168\t// ---------------------------------------------------------------------------\n169\t\n170\tconst SPX_TREE_BITS: usize = SPX_TREE_HEIGHT * (SPX_D - 1);\n171\tconst SPX_TREE_BYTES: usize = (SPX_TREE_BITS + 7) / 8;\n172\tconst SPX_LEAF_BITS: usize = SPX_TREE_HEIGHT;\n173\tconst SPX_LEAF_BYTES: usize = (SPX_LEAF_BITS + 7) / 8;\n174\tconst SPX_DGST_BYTES: usize = SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES;\n175\t\n176\t/* Round to nearest multiple of SPX_SHAX_BLOCK_BYTES; assumes that\n177\t   SPX_SHAX_BLOCK_BYTES is a power of 2 (the `& -SPX_SHAX_BLOCK_BYTES` in C). */\n178\tconst SPX_INBLOCKS: usize = ((SPX_N + SPX_PK_BYTES + SPX_SHAX_BLOCK_BYTES - 1)\n179\t    & !(SPX_SHAX_BLOCK_BYTES - 1))\n180\t    / SPX_SHAX_BLOCK_BYTES;\n181\t\n182\t/// `(~(uint64_t)0) >> (64 - SPX_TREE_BITS)`; only used when `SPX_D != 1`, in\n183\t/// which case `SPX_TREE_BITS` is in `1..=64`.\n184\tconst TREE_MASK: u64 = if SPX_TREE_BITS == 0 || SPX_TREE_BITS >= 64 {\n185\t    u64::MAX\n186\t} else {\n187\t    u64::MAX >> (64 - SPX_TREE_BITS)\n188\t};\n189\t\n190\t/// `(~(uint32_t)0) >> (32 - SPX_LEAF_BITS)`\n191\tconst LEAF_MASK: u32 = if SPX_LEAF_BITS == 0 || SPX_LEAF_BITS >= 32 {\n192\t    u32::MAX\n193\t} else {\n194\t    u32::MAX >> (32 - SPX_LEAF_BITS)\n195\t};\n196\t\n197\t/// Computes the message hash using R, the public key, and the message.\n198\t/// Outputs the message digest and the index of the leaf. The index is split in\n199\t/// the tree index and the leaf index, for convenient copying to an address.\n200\tpub fn hash_message(\n201\t    digest: &mut [u8],\n202\t    tree: &mut u64,\n203\t    leaf_idx: &mut u32,\n204\t    r: &[u8],\n205\t    pk: &[u8],\n206\t    m: &[u8],\n207\t    ctx: &SpxCtx,\n208\t) {\n209\t    let _ = ctx;\n210\t\n211\t    let mut seed = [0u8; 2 * SPX_N + SPX_SHAX_OUTPUT_BYTES];\n212\t    let mut inbuf = [0u8; SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES];\n213\t    let mut buf = [0u8; SPX_DGST_BYTES];\n214\t    let mut state = [0u8; SPX_SHAX_STATE_BYTES];\n215\t\n216\t    let mlen = m.len() as u64;\n217\t\n218\t    shax_inc_init(&mut state);\n219\t\n220\t    // seed: SHA-X(R ‖ PK.seed ‖ PK.root ‖ M)\n221\t    inbuf[..SPX_N].copy_from_slice(&r[..SPX_N]);\n222\t    inbuf[SPX_N..SPX_N + SPX_PK_BYTES].copy_from_slice(&pk[..SPX_PK_BYTES]);\n223\t\n224\t    /* If R + pk + message cannot fill up an entire block */\n225\t    if (SPX_N + SPX_PK_BYTES) as u64 + mlen < (SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES) as u64 {\n226\t        let ml = mlen as usize;\n227\t        inbuf[SPX_N + SPX_PK_BYTES..SPX_N + SPX_PK_BYTES + ml].copy_from_slice(&m[..ml]);\n228\t        shax_inc_finalize(\n229\t            &mut seed[2 * SPX_N..],\n230\t            &mut state,\n231\t            &inbuf[..SPX_N + SPX_PK_BYTES + ml],\n232\t        );\n233\t    }\n234\t    /* Otherwise first fill a block, so that finalize only uses the message */\n235\t    else {\n236\t        let take = SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES - SPX_N - SPX_PK_BYTES;\n237\t        inbuf[SPX_N + SPX_PK_BYTES..].copy_from_slice(&m[..take]);\n238\t        shax_inc_blocks(&mut state, &inbuf, SPX_INBLOCKS);\n239\t\n240\t        let m2 = &m[take..];\n241\t        shax_inc_finalize(&mut seed[2 * SPX_N..], &mut state, m2);\n242\t    }\n243\t\n244\t    // H_msg: MGF1-SHA-X(R ‖ PK.seed ‖ seed)\n245\t    seed[..SPX_N].copy_from_slice(&r[..SPX_N]);\n246\t    seed[SPX_N..2 * SPX_N].copy_from_slice(&pk[..SPX_N]);\n247\t\n248\t    /* By doing this in two steps, we prevent hashing the message twice;\n249\t       otherwise each iteration in MGF1 would hash the message again. */\n250\t    mgf1_x(&mut buf, &seed);\n251\t\n252\t    digest[..SPX_FORS_MSG_BYTES].copy_from_slice(&buf[..SPX_FORS_MSG_BYTES]);\n253\t    let mut bufp = SPX_FORS_MSG_BYTES;\n254\t\n255\t    if SPX_D == 1 {\n256\t        *tree = 0;\n257\t    } else {\n258\t        *tree = bytes_to_ull(&buf[bufp..], SPX_TREE_BYTES as u32);\n259\t        *tree &= TREE_MASK;\n260\t    }\n261\t    bufp += SPX_TREE_BYTES;\n262\t\n263\t    *leaf_idx = bytes_to_ull(&buf[bufp..], SPX_LEAF_BYTES as u32) as u32;\n264\t    *leaf_idx &= LEAF_MASK;\n265\t}\n266\t\n267\t// ---------------------------------------------------------------------------\n268\t// C ABI wrappers -- app/include/hash.h\n269\t// ---------------------------------------------------------------------------\n270\t\n271\t#[unsafe(no_mangle)]\n272\tpub extern \"C\" fn SPX_initialize_hash_function(ctx: *mut SpxCtx) {\n273\t    unsafe {\n274\t        initialize_hash_function(&mut *ctx);\n275\t    }\n276\t}\n277\t\n278\t#[unsafe(no_mangle)]\n279\tpub extern \"C\" fn SPX_prf_addr(out: *mut u8, ctx: *const SpxCtx, addr: *const u32) {\n280\t    unsafe {\n281\t        let addr_ref = &*(addr as *const [u32; 8]);\n282\t        prf_addr(\n283\t            core::slice::from_raw_parts_mut(out, SPX_N),\n284\t            &*ctx,\n285\t            addr_ref,\n286\t        );\n287\t    }\n288\t}\n289\t\n290\t#[unsafe(no_mangle)]\n291\tpub extern \"C\" fn SPX_gen_message_random(\n292\t    r: *mut u8,\n293\t    sk_prf: *const u8,\n294\t    optrand: *const u8,\n295\t    m: *const u8,\n296\t    mlen: u64,\n297\t    ctx: *const SpxCtx,\n298\t) {\n299\t    unsafe {\n300\t        gen_message_random(\n301\t            core::slice::from_raw_parts_mut(r, SPX_N),\n302\t            core::slice::from_raw_parts(sk_prf, SPX_N),\n303\t            core::slice::from_raw_parts(optrand, SPX_N),\n304\t            core::slice::from_raw_parts(m, mlen as usize),\n305\t            &*ctx,\n306\t        );\n307\t    }\n308\t}\n309\t\n310\t#[unsafe(no_mangle)]\n311\tpub extern \"C\" fn SPX_hash_message(\n312\t    digest: *mut u8,\n313\t    tree: *mut u64,\n314\t    leaf_idx: *mut u32,\n315\t    r: *const u8,\n316\t    pk: *const u8,\n317\t    m: *const u8,\n318\t    mlen: u64,\n319\t    ctx: *const SpxCtx,\n320\t) {\n321\t    unsafe {\n322\t        hash_message(\n323\t            core::slice::from_raw_parts_mut(digest, SPX_FORS_MSG_BYTES),\n324\t            &mut *tree,\n325\t            &mut *leaf_idx,\n326\t            core::slice::from_raw_parts(r, SPX_N),\n327\t            core::slice::from_raw_parts(pk, SPX_PK_BYTES),\n328\t            core::slice::from_raw_parts(m, mlen as usize),\n329\t            &*ctx,\n330\t        );\n331\t    }\n332\t}\n333\t\n334\t// ---------------------------------------------------------------------------\n335\t// C ABI wrappers -- lib/sha2/include/sha2.h\n336\t//\n337\t// `sha256*`/`sha512*` are NOT namespaced in the C header, so they keep their\n338\t// plain names; `mgf1_256`, `mgf1_512` and `seed_state` are namespaced.\n339\t// ---------------------------------------------------------------------------\n340\t\n341\t#[unsafe(no_mangle)]\n342\tpub extern \"C\" fn sha256_inc_init(state: *mut u8) {\n343\t    unsafe {\n344\t        sha2::sha256_inc_init(core::slice::from_raw_parts_mut(state, 40));\n345\t    }\n346\t}\n347\t\n348\t#[unsafe(no_mangle)]\n349\tpub extern \"C\" fn sha256_inc_blocks(state: *mut u8, input: *const u8, inblocks: usize) {\n350\t    unsafe {\n351\t        sha2::sha256_inc_blocks(\n352\t            core::slice::from_raw_parts_mut(state, 40),\n353\t            core::slice::from_raw_parts(input, 64 * inblocks),\n354\t            inblocks,\n355\t        );\n356\t    }\n357\t}\n358\t\n359\t#[unsafe(no_mangle)]\n360\tpub extern \"C\" fn sha256_inc_finalize(\n361\t    out: *mut u8,\n362\t    state: *mut u8,\n363\t    input: *const u8,\n364\t    inlen: usize,\n365\t) {\n366\t    unsafe {\n367\t        sha2::sha256_inc_finalize(\n368\t            core::slice::from_raw_parts_mut(out, 32),\n369\t            core::slice::from_raw_parts_mut(state, 40),\n370\t            core::slice::from_raw_parts(input, inlen),\n371\t        );\n372\t    }\n373\t}\n374\t\n375\t#[unsafe(no_mangle)]\n376\tpub extern \"C\" fn sha256(out: *mut u8, input: *const u8, inlen: usize) {\n377\t    unsafe {\n378\t        sha2::sha256(\n379\t            core::slice::from_raw_parts_mut(out, 32),\n380\t            core::slice::from_raw_parts(input, inlen),\n381\t        );\n382\t    }\n383\t}\n384\t\n385\t#[unsafe(no_mangle)]\n386\tpub extern \"C\" fn sha512_inc_init(state: *mut u8) {\n387\t    unsafe {\n388\t        sha2::sha512_inc_init(core::slice::from_raw_parts_mut(state, 72));\n389\t    }\n390\t}\n391\t\n392\t#[unsafe(no_mangle)]\n393\tpub extern \"C\" fn sha512_inc_blocks(state: *mut u8, input: *const u8, inblocks: usize) {\n394\t    unsafe {\n395\t        sha2::sha512_inc_blocks(\n396\t            core::slice::from_raw_parts_mut(state, 72),\n397\t            core::slice::from_raw_parts(input, 128 * inblocks),\n398\t            inblocks,\n399\t        );\n400\t    }\n401\t}\n402\t\n403\t#[unsafe(no_mangle)]\n404\tpub extern \"C\" fn sha512_inc_finalize(\n405\t    out: *mut u8,\n406\t    state: *mut u8,\n407\t    input: *const u8,\n408\t    inlen: usize,\n409\t) {\n410\t    unsafe {\n411\t        sha2::sha512_inc_finalize(\n412\t            core::slice::from_raw_parts_mut(out, 64),\n413\t            core::slice::from_raw_parts_mut(state, 72),\n414\t            core::slice::from_raw_parts(input, inlen),\n415\t        );\n416\t    }\n417\t}\n418\t\n419\t#[unsafe(no_mangle)]\n420\tpub extern \"C\" fn sha512(out: *mut u8, input: *const u8, inlen: usize) {\n421\t    unsafe {\n422\t        sha2::sha512(\n423\t            core::slice::from_raw_parts_mut(out, 64),\n424\t            core::slice::from_raw_parts(input, inlen),\n425\t        );\n426\t    }\n427\t}\n428\t\n429\t#[unsafe(no_mangle)]\n430\tpub extern \"C\" fn SPX_mgf1_256(out: *mut u8, outlen: u64, input: *const u8, inlen: u64) {\n431\t    unsafe {\n432\t        sha2::mgf1_256(\n433\t            core::slice::from_raw_parts_mut(out, outlen as usize),\n434\t            core::slice::from_raw_parts(input, inlen as usize),\n435\t        