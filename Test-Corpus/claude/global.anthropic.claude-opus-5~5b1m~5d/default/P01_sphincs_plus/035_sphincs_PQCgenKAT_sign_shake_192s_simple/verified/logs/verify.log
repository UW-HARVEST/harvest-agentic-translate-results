f(!hc){fprintf(stderr,\"%s\\n\",dlerror());return 2;}\n  void*hr=dlopen(argv[2],RTLD_NOW|RTLD_LOCAL); if(!hr){fprintf(stderr,\"%s\\n\",dlerror());return 2;}\n  N=atoi(argv[3]); BIG=atoi(argv[4]); FORS_TREES=atoi(argv[5]); WOTS_LEN=atoi(argv[6]); FORSMSG=atoi(argv[7]);\n  PK=2*N; CTXSZ = 2*N + 40 + (BIG?72:0);\n  (void)PK;\n\n  struct { f_state i256,i512; f_blocks b256,b512; f_fin fi256,fi512; f_hash h256,h512;\n           f_mgf1 m256,m512; f_seed ss; f_prf prf; f_gmr gmr; f_hm hm; f_thash th; } L[2];\n  void*hs[2]={hc,hr};\n  for(int k=0;k<2;k++){ void*h=hs[k];\n    L[k].i256=(f_state)dlsym(h,\"sha256_inc_init\");\n    L[k].i512=(f_state)dlsym(h,\"sha512_inc_init\");\n    L[k].b256=(f_blocks)dlsym(h,\"sha256_inc_blocks\");\n    L[k].b512=(f_blocks)dlsym(h,\"sha512_inc_blocks\");\n    L[k].fi256=(f_fin)dlsym(h,\"sha256_inc_finalize\");\n    L[k].fi512=(f_fin)dlsym(h,\"sha512_inc_finalize\");\n    L[k].h256=(f_hash)dlsym(h,\"sha256\");\n    L[k].h512=(f_hash)dlsym(h,\"sha512\");\n    L[k].m256=(f_mgf1)dlsym(h,\"SPX_mgf1_256\");\n    L[k].m512=(f_mgf1)dlsym(h,\"SPX_mgf1_512\");\n    L[k].ss=(f_seed)dlsym(h,\"SPX_seed_state\");\n    L[k].prf=(f_prf)dlsym(h,\"SPX_prf_addr\");\n    L[k].gmr=(f_gmr)dlsym(h,\"SPX_gen_message_random\");\n    L[k].hm=(f_hm)dlsym(h,\"SPX_hash_message\");\n    L[k].th=(f_thash)dlsym(h,\"SPX_thash\");\n    if(!L[k].i256||!L[k].m512||!L[k].ss||!L[k].th){fprintf(stderr,\"sym missing k=%d\\n\",k);return 2;}\n  }\n\n  /* 1. inc_init */\n  { uint8_t s[2][80]; for(int k=0;k<2;k++){memset(s[k],0xAA,80); L[k].i256(s[k]);} cmp(\"sha256_inc_init\",0,s[0],s[1],40);\n    for(int k=0;k<2;k++){memset(s[k],0xAA,80); L[k].i512(s[k]);} cmp(\"sha512_inc_init\",0,s[0],s[1],72); }\n\n  /* 2. inc_blocks */\n  for(int nb=0;nb<=4;nb++){\n    uint8_t in[4*128]; fill(in,sizeof in);\n    uint8_t s0[80]; fill(s0,80);\n    uint8_t s[2][80];\n    for(int k=0;k<2;k++){memcpy(s[k],s0,80); L[k].b256(s[k],in,nb);} cmp(\"sha256_inc_blocks\",nb,s[0],s[1],40);\n    for(int k=0;k<2