{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QRiw33kejQYzNZuHRGng4S","type":"tool_result","content":"1\t//! Shared harness for the C-vs-Rust differential tests.\n2\t//!\n3\t//! BOTH implementations are reached only through `dlopen`/`dlsym` on their\n4\t//! shared objects — the Rust side is *never* called through the linked rlib, so\n5\t//! the `#[no_mangle] extern \"C\"` export wrappers are part of what is under test.\n6\t//!\n7\t//! * C side   : `../cbuild/<combo>/libcsphincs_all.so`\n8\t//!   (all the translation units CMake puts into `libsphincs_core_det.so` +\n9\t//!   `lib<backend>.so`, linked into one object so the two libraries' circular\n10\t//!   symbol references do not have to be resolved through `RTLD_GLOBAL`;\n11\t//!   `build_c_all.sh` asserts the exported symbol set is identical.)\n12\t//! * Rust side: `../rbuild/<combo>/libsphincs_core_det.so`\n13\t//!\n14\t//! Both are opened `RTLD_NOW | RTLD_LOCAL` so that the two definitions of e.g.\n15\t//! `crypto_sign` can coexist in one process without interposing on each other.\n16\t\n17\t#![allow(dead_code)]\n18\t#![allow(non_snake_case)]\n19\t#![allow(non_upper_case_globals)]\n20\t#![allow(unused_imports)]\n21\t\n22\tuse libloading::os::unix::{Library, Symbol};\n23\tuse std::path::PathBuf;\n24\tuse std::sync::{Mutex, MutexGuard};\n25\t\n26\t/// `DRBG_ctx` is a *process-global* in both libraries, so any test that seeds it\n27\t/// or consumes randomness from it must not run concurrently with another such\n28\t/// test.  Cargo runs `#[test]`s on multiple threads by default, hence this lock.\n29\tstatic DRBG_LOCK: Mutex<()> = Mutex::new(());\n30\t\n31\t#[must_use]\n32\tpub fn drbg_guard() -> MutexGuard<'static, ()> {\n33\t    DRBG_LOCK.lock().unwrap_or_else(|e| e.into_inner())\n34\t}\n35\t\n36\t// ---------------------------------------------------------------------------\n37\t// Which configuration are we compiled for?  Mirrors the precedence in\n38\t// src/backend/mod.rs, src/backend/thash_*.rs and src/params.rs exactly.\n39\t// ---------------------------------------------------------------------------\n40\t\n41\tpub const BACKEND: &str = if cfg!(feature = \"sha2\") {\n42\t    \"sha2\"\n43\t} else if cfg!(feature = \"shake\") {\n44\t    \"shake\"\n45\t} else if cfg!(feature = \"blake\") {\n46\t    \"blake\"\n47\t} else {\n48\t    \"haraka\"\n49\t};\n50\t\n51\tpub const THASH: &str = if cfg!(feature = \"simple\") {\n52\t    \"simple\"\n53\t} else {\n54\t    \"robust\"\n55\t};\n56\t\n57\tpub const SECPAR: &str = if cfg!(feature = \"256f\") {\n58\t    \"256f\"\n59\t} else if cfg!(feature = \"256s\") {\n60\t    \"256s\"\n61\t} else if cfg!(feature = \"192f\") {\n62\t    \"192f\"\n63\t} else if cfg!(feature = \"192s\") {\n64\t    \"192s\"\n65\t} else if cfg!(feature = \"128f\") {\n66\t    \"128f\"\n67\t} else {\n68\t    \"128s\"\n69\t};\n70\t\n71\t// ---------------------------------------------------------------------------\n72\t// Parameters.  Taken from the crate's own `params` module (which is compiled\n73\t// with the very same features) and cross-checked at run time against the four\n74\t// `crypto_sign_*bytes()` entry points of BOTH shared objects, so a wrong\n75\t// constant here cannot silently weaken a test.\n76\t// ---------------------------------------------------------------------------\n77\t\n78\tpub use sphincs_core_det::params::{\n79\t    CRYPTO_SEEDBYTES, SPX_ADDR_BYTES, SPX_BYTES, SPX_D, SPX_FORS_BYTES, SPX_FORS_HEIGHT,\n80\t    SPX_FORS_MSG_BYTES, SPX_FORS_TREES, SPX_FULL_HEIGHT, SPX_N, SPX_PK_BYTES, SPX_SK_BYTES,\n81\t    SPX_TREE_HEIGHT, SPX_WOTS_BYTES, SPX_WOTS_LEN, SPX_WOTS_W,\n82\t};\n83\t\n84\t/// `SPX_BLAKE512` / `SPX_SHA512` — 1 for the 192/256-bit parameter sets.\n85\tpub const BIG_HASH: bool = cfg!(spx_big_hash);\n86\t\n87\t/// `sizeof(spx_ctx)`, recomputed from `context.h` independently of the Rust\n88\t/// struct so that a layout regression in `SpxCtx` is caught rather than hidden.\n89\tpub const CTX_BYTES: usize = if cfg!(feature = \"sha2\") {\n90\t    2 * SPX_N + 40 + if BIG_HASH { 72 } else { 0 }\n91\t} else if cfg!(feature = \"shake\") || cfg!(feature = \"blake\") {\n92\t    2 * SPX_N\n93\t} else {\n94\t    // haraka: uint64_t[10][8] + uint32_t[10][8]; 2*SPX_N is already 8-aligned\n95\t    2 * SPX_N + 640 + 320\n96\t};\n97\t\n98\tpub const SPX_TREE_BITS: usize = SPX_TREE_HEIGHT * (SPX_D - 1);\n99\tpub const SPX_TREE_BYTES: usize = (SPX_TREE_BITS + 7) / 8;\n100\tpub const SPX_LEAF_BYTES: usize = (SPX_TREE_HEIGHT + 7) / 8;\n101\tpub const SPX_DGST_BYTES: usize = SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES;\n102\t\n103\t// ---------------------------------------------------------------------------\n104\t// Deterministic PRNG (SplitMix64) — fixed seed, so every run is reproducible.\n105\t// ---------------------------------------------------------------------------\n106\t\n107\tpub struct Rng(u64);\n108\t\n109\timpl Rng {\n110\t    pub fn new(seed: u64) -> Self {\n111\t        Rng(seed ^ 0x9E3779B97F4A7C15)\n112\t    }\n113\t    pub fn next_u64(&mut self) -> u64 {\n114\t        self.0 = self.0.wrapping_add(0x9E3779B97F4A7C15);\n115\t        let mut z = self.0;\n116\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);\n117\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB);\n118\t        z ^ (z >> 31)\n119\t    }\n120\t    pub fn next_u32(&mut self) -> u32 {\n121\t        self.next_u64() as u32\n122\t    }\n123\t    pub fn byte(&mut self) -> u8 {\n124\t        self.next_u64() as u8\n125\t    }\n126\t    pub fn fill(&mut self, buf: &mut [u8]) {\n127\t        for b in buf.iter_mut() {\n128\t            *b = self.byte();\n129\t        }\n130\t    }\n131\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n132\t        let mut v = vec![0u8; n];\n133\t        self.fill(&mut v);\n134\t        v\n135\t    }\n136\t    pub fn addr(&mut self) -> [u32; 8] {\n137\t        let mut a = [0u32; 8];\n138\t        for x in a.iter_mut() {\n139\t            *x = self.next_u32();\n140\t        }\n141\t        a\n142\t    }\n143\t    /// Uniform-ish value in `0..n` (n > 0).\n144\t    pub fn below(&mut self, n: u32) -> u32 {\n145\t        self.next_u32() % n\n146\t    }\n147\t}\n148\t\n149\t// ---------------------------------------------------------------------------\n150\t// C struct mirrors\n151\t// ---------------------------------------------------------------------------\n152\t\n153\t/// `leaf_info_x1` from `app/include/wotsx1.h`.\n154\t#[repr(C)]\n155\t#[derive(Clone, Copy)]\n156\tpub struct LeafInfoX1 {\n157\t    pub wots_sig: *mut u8,\n158\t    pub wots_sign_leaf: u32,\n159\t    pub wots_steps: *mut u32,\n160\t    pub leaf_addr: [u32; 8],\n161\t    pub pk_addr: [u32; 8],\n162\t}\n163\t\n164\timpl LeafInfoX1 {\n165\t    pub fn zeroed() -> Self {\n166\t        LeafInfoX1 {\n167\t            wots_sig: core::ptr::null_mut(),\n168\t            wots_sign_leaf: 0,\n169\t            wots_steps: core::ptr::null_mut(),\n170\t            leaf_addr: [0; 8],\n171\t            pk_addr: [0; 8],\n172\t        }\n173\t    }\n174\t    /// The parts of the struct the callee may mutate (`leaf_addr`, `pk_addr`).\n175\t    pub fn addrs(&self) -> ([u32; 8], [u32; 8]) {\n176\t        (self.leaf_addr, self.pk_addr)\n177\t    }\n178\t}\n179\t\n180\t/// `fors_gen_leaf_info` from `app/include/fors.h`.\n181\t#[repr(C)]\n182\t#[derive(Clone, Copy)]\n183\tpub struct ForsGenLeafInfo {\n184\t    pub leaf_addrx: [u32; 8],\n185\t}\n186\t\n187\t/// `AES_XOF_struct` from `app/include/rng.h`.\n188\t#[repr(C)]\n189\t#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n190\tpub struct AesXofStruct {\n191\t    pub buffer: [u8; 16],\n192\t    pub buffer_pos: u64,\n193\t    pub length_remaining: u64,\n194\t    pub key: [u8; 32],\n195\t    pub ctr: [u8; 16],\n196\t}\n197\t\n198\timpl AesXofStruct {\n199\t    pub fn zeroed() -> Self {\n200\t        AesXofStruct {\n201\t            buffer: [0; 16],\n202\t            buffer_pos: 0,\n203\t            length_remaining: 0,\n204\t            key: [0; 32],\n205\t            ctr: [0; 16],\n206\t        }\n207\t    }\n208\t}\n209\t\n210\t/// `AES256_CTR_DRBG_struct` from `app/include/rng.h`.\n211\t#[repr(C)]\n212\t#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n213\tpub struct Drbg {\n214\t    pub Key: [u8; 32],\n215\t    pub V: [u8; 16],\n216\t    pub reseed_counter: i32,\n217\t}\n218\t\n219\t/// `blakestate256` from `lib/blake/include/blake.h`.\n220\t#[repr(C)]\n221\t#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n222\tpub struct BlakeState256 {\n223\t    pub h: [u32; 8],\n224\t    pub s: [u32; 4],\n225\t    pub t: [u32; 2],\n226\t    pub buflen: i32,\n227\t    pub nullt: i32,\n228\t    pub buf: [u8; 64],\n229\t}\n230\t\n231\timpl BlakeState256 {\n232\t    pub fn zeroed() -> Self {\n233\t        BlakeState256 {\n234\t            h: [0; 8],\n235\t            s: [0; 4],\n236\t            t: [0; 2],\n237\t            buflen: 0,\n238\t            nullt: 0,\n239\t            buf: [0; 64],\n240\t        }\n241\t    }\n242\t}\n243\t\n244\t/// `blakestate512` from `lib/blake/include/blake.h`.\n245\t#[repr(C)]\n246\t#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n247\tpub struct BlakeState512 {\n248\t    pub h: [u64; 8],\n249\t    pub s: [u64; 4],\n250\t    pub t: [u64; 2],\n251\t    pub buflen: i32,\n252\t    pub nullt: i32,\n253\t    pub buf: [u8; 128],\n254\t}\n255\t\n256\timpl BlakeState512 {\n257\t    pub fn zeroed() -> Self {\n258\t        BlakeState512 {\n259\t            h: [0; 8],\n260\t            s: [0; 4],\n261\t            t: [0; 2],\n262\t            buflen: 0,\n263\t            nullt: 0,\n264\t            buf: [0; 128],\n265\t        }\n266\t    }\n267\t}\n268\t\n269\t// ---------------------------------------------------------------------------\n270\t// Library loading\n271\t// ---------------------------------------------------------------------------\n272\t\n273\tpub fn combo() -> String {\n274\t    format!(\"{}-{}-{}\", BACKEND, THASH, SECPAR)\n275\t}\n276\t\n277\tfn repo_root() -> PathBuf {\n278\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n279\t        .parent()\n280\t        .expect(\"crate has a parent directory\")\n281\t        .to_path_buf()\n282\t}\n283\t\n284\tfn open(path: &PathBuf) -> Library {\n285\t    assert!(\n286\t        path.exists(),\n287\t        \"shared object {} does not exist.\\n\\\n288\t         Run ./build_c_all.sh and ./build_rust_all.sh from the repository root \\\n289\t         (or use ./run_all.sh, which does both) before running the tests.\",\n290\t        path.display()\n291\t    );\n292\t    // RTLD_NOW so a missing symbol fails loudly here rather than at first call;\n293\t    // RTLD_LOCAL so the C and the Rust definitions of identically-named symbols\n294\t    // stay in separate namespaces.\n295\t    unsafe { Library::open(Some(path), libc_RTLD_NOW | libc_RTLD_LOCAL) }\n296\t        .unwrap_or_else(|e| panic!(\"dlopen({}) failed: {e}\", path.display()))\n297\t}\n298\t\n299\t// libloading does not re-export the flags; these are the glibc/x86-64 values.\n300\tconst libc_RTLD_NOW: i32 = 0x2;\n301\tconst libc_RTLD_LOCAL: i32 = 0x0;\n302\t\n303\t/// One loaded implementation (either the C one or the Rust one).\n304\tpub struct Impl {\n305\t    pub name: &'static str,\n306\t    lib: Library,\n307\t}\n308\t\n309\timpl Impl {\n310\t    pub fn sym<T>(&self, name: &str) -> Symbol<T> {\n311\t        unsafe { self.lib.get(name.as_bytes()) }\n312\t            .unwrap_or_else(|e| panic!(\"{}: dlsym({name}) failed: {e}\", self.name))\n313\t    }\n314\t    /// Address of a data symbol (e.g. `DRBG_ctx`, `cst`).\n315\t    ///\n316\t    /// `libloading`'s unix `Symbol<T>` reinterprets its stored `dlsym` result as\n317\t    /// `T`, so `Symbol<*mut T>` dereferences to the address of the object.\n318\t    pub fn data<T>(&self, name: &str) -> *mut T {\n319\t        let s: Symbol<*mut T> = unsafe { self.lib.get(name.as_bytes()) }\n320\t            .unwrap_or_else(|e| panic!(\"{}: dlsym({name}) failed: {e}\", self.name));\n321\t        *s\n322\t    }\n323\t}\n324\t\n325\t/// The C implementation and the Rust implementation, side by side.\n326\tpub struct Pair {\n327\t    pub c: Impl,\n328\t    pub r: Impl,\n329\t}\n330\t\n331\tpub fn load() -> Pair {\n332\t    let root = repo_root();\n333\t    let combo = combo();\n334\t\n335\t    let c_path = std::env::var(\"SPX_C_LIB\")\n336\t        .map(PathBuf::from)\n337\t        .unwrap_or_else(|_| root.join(\"cbuild\").join(&combo).join(\"libcsphincs_all.so\"));\n338\t    let r_path = std::env::var(\"SPX_RUST_LIB\")\n339\t        .map(PathBuf::from)\n340\t        .unwrap_or_else(|_| {\n341\t            root.join(\"rbuild\")\n342\t                .join(&combo)\n343\t                .join(\"libsphincs_core_det.so\")\n344\t        });\n345\t\n346\t    let pair = Pair {\n347\t        c: Impl {\n348\t            name: \"C\",\n349\t            lib: open(&c_path),\n350\t        },\n351\t        r: Impl {\n352\t            name: \"Rust\",\n353\t            lib: open(&r_path),\n354\t        },\n355\t    };\n356\t\n357\t    // Sanity gate: the four size constants must agree between the two shared\n358\t    // objects AND with the constants this harness sizes its buffers with.\n359\t    for imp in [&pair.c, &pair.r] {\n360\t        let f: Symbol<unsafe extern \"C\" fn() -> u64> = imp.sym(\"crypto_sign_secretkeybytes\");\n361\t        assert_eq!(\n362\t            unsafe { f() } as usize,\n363\t            SPX_SK_BYTES,\n364\t            \"{}: crypto_sign_secretkeybytes mismatch for {combo}\",\n365\t            imp.name\n366\t        );\n367\t        let f: Symbol<unsafe extern \"C\" fn() -> u64> = imp.sym(\"crypto_sign_publickeybytes\");\n368\t        assert_eq!(unsafe { f() } as usize, SPX_PK_BYTES, \"{}\", imp.name);\n369\t        let f: Symbol<unsafe extern \"C\" fn() -> u64> = imp.sym(\"crypto_sign_bytes\");\n370\t        assert_eq!(unsafe { f() } as usize, SPX_BYTES, \"{}\", imp.name);\n371\t        let f: Symbol<unsafe extern \"C\" fn() -> u64> = imp.sym(\"crypto_sign_seedbytes\");\n372\t        assert_eq!(unsafe { f() } as usize, CRYPTO_SEEDBYTES, \"{}\", imp.name);\n373\t    }\n374\t\n375\t    pair\n376\t}\n377\t\n378\t// ---------------------------------------------------------------------------\n379\t// Assertion helpers\n380\t// ---------------------------------------------------------------------------\n381\t\n382\tpub fn hex(b: &[u8]) -> String {\n383\t    let mut s = String::with_capacity(2 * b.len().min(64));\n384\t    for (i, x) in b.iter().enumerate() {\n385\t        if i == 64 {\n386\t            s.push_str(\"...\");\n387\t            break;\n388\t        }\n389\t        s.push_str(&format!(\"{x:02x}\"));\n390\t    }\n391\t    s\n392\t}\n393\t\n394\t#[track_caller]\n395\tpub fn eq_bytes(what: &str, c: &[u8], r: &[u8]) {\n396\t    if c != r {\n397\t        let first = c\n398\t            .iter()\n399\t            .zip(r.iter())\n400\t            .position(|(a, b)| a != b)\n401\t            .unwrap_or(c.len().min(r.len()));\n402\t        panic!(\n403\t            \"{what} differs (config {}) at byte {first}\\n  C   : {}\\n  Rust: {}\",\n404\t            combo(),\n405\t            hex(c),\n406\t            hex(r)\n407\t        );\n408\t    }\n409\t}\n410\t\n411\t#[track_caller]\n412\tpub fn eq_u32s(what: &str, c: &[u32], r: &[u32]) {\n413\t    assert_eq!(c, r, \"{what} differs (config {})\", combo());\n414\t}\n415\t\n416\t#[track_caller]\n417\tpub fn eq<T: PartialEq + std::fmt::Debug>(what: &str, c: T, r: T) {\n418\t    assert_eq!(c, r, \"{what} differs (config {})\", combo());\n419\t}\n420\t\n421\t/// A freshly zeroed `spx_ctx`-sized byte buffer, 8-byte aligned (the haraka\n422\t/// variant contains `uint64_t` arrays).\n423\tpub fn new_ctx_buf() -> CtxBuf {\n424\t    CtxBuf {\n425\t        words: vec![0u64; (CTX_BYTES + 7) / 8],\n426\t    }\n427\t}\n428\t\n429\tpub struct CtxBuf {\n430\t    words: Vec<u64>,\n431\t}\n432\t\n433\timpl CtxBuf {\n434\t    pub fn as_ptr(&self) -> *const u8 {\n435\t        self.words.as_ptr() as *const u8\n436\t    }\n437\t    pub fn as_mut_ptr(&mut self) -> *mut u8 {\n438\t        self.words.as_mut_ptr() as *mut u8\n439\t    }\n440\t    pub fn bytes(&self) -> &[u8] {\n441\t        unsafe { core::slice::from_raw_parts(self.as_ptr(), CTX_BYTES) }\n442\t    }\n443\t    pub fn bytes_mut(&mut self) -> &mut [u8] {\n444\t        unsafe { core::slice::from_raw_parts_mut(self.as_mut_ptr(), CTX_BYTES) }\n445\t    }\n446\t    /// Write `pub_seed` and `sk_seed` (the only fields a caller sets in C).\n447\t    pub fn set_seeds(&mut self, pub_seed: &[u8], sk_seed: &[u8]) {\n448\t        self.bytes_mut()[..SPX_N].copy_from_slice(&pub_seed[..SPX_N]);\n449\t        self.bytes_mut()[SPX_N..2 * SPX_N].copy_from_slice(&sk_seed[..SPX_N]);\n450\t    }\n451\t}\n452\t\n453\timpl Clone for CtxBuf {\n454\t    fn clone(&self) -> Self {\n455\t        CtxBuf {\n456\t            words: self.words.clone(),\n457\t        }\n458\t    }\n459\t}\n460\t\n461\t/// Build a `spx_ctx` in BOTH libraries from the same seeds, running each\n462\t/// library's own `SPX_initialize_hash_function`, and assert the two resulting\n463\t/// context images are byte-identical.  Returns the (c_ctx, r_ctx) pair.\n464\tpub fn init_ctx_pair(p: &Pair, rng: &mut Rng) -> (CtxBuf, CtxBuf) {\n465\t    let pub_seed = rng.bytes(SPX_N);\n466\t    let sk_seed = rng.bytes(SPX_N);\n467\t    init_ctx_pair_from(p, &pub_seed, &sk_seed)\n468\t}\n469\t\n470\tpub fn init_ctx_pair_from(p: &Pair, pub_seed: &[u8], sk_seed: &[u8]) -> (CtxBuf, CtxBuf) {\n471\t    let mut cc = new_ctx_buf();\n472\t    let mut rc = new_ctx_buf();\n473\t    cc.set_seeds(pub_seed, sk_seed);\n474\t    rc.set_seeds(pub_seed, sk_seed);\n475\t    type InitFn = unsafe extern \"C\" fn(*mut u8);\n476\t    let f: Symbol<InitFn> = p.c.sym(\"SPX_initialize_hash_function\");\n477\t    unsafe { f(cc.as_mut_ptr()) };\n478\t    let f: Symbol<InitFn> = p.r.sym(\"SPX_initialize_hash_function\");\n479\t    unsafe { f(rc.as_mut_ptr()) };\n480\t    eq_bytes(\"spx_ctx after initialize_hash_function\", cc.bytes(), rc.bytes());\n481\t    (cc, rc)\n482\t}\n483\t\n484\t/// Seed both libraries' DRBG (`randombytes_init`) with the same input so that\n485\t/// subsequent `randombytes()`-consuming entry points are comparable.\n486\tpub fn seed_drbg(p: &Pair, entropy: &[u8; 48], pers: Option<&[u8; 48]>) {\n487\t    type InitFn = unsafe extern \"C\" fn(*mut u8, *mut u8);\n488\t    let mut e = *entropy;\n489\t    let mut ps = pers.copied().unwrap_or([0u8; 48]);\n490\t    let ps_ptr = if pers.is_some() {\n491\t        ps.as_mut_ptr()\n492\t    } else {\n493\t        core::ptr::null_mut()\n494\t    };\n495\t    for imp in [&p.c, &p.r] {\n496\t        let f: Symbol<InitFn> = imp.sym(\"randombytes_init\");\n497\t        unsafe { f(e.as_mut_ptr(), ps_ptr) };\n498\t    }\n499\t    let _ = &mut e;\n500\t    let _ = &mut ps;\n501\t}\n502\t\n503\t/// Read the `DRBG_ctx` global out of one implementation.\n504\tpub fn read_drbg(imp: &Impl) -> Drbg {\n505\t    unsafe { *imp.data::<Drbg>(\"DRBG_ctx\") }\n506\t}\n507\t\n508\tpub fn eq_drbg(p: &Pair, what: &str) {\n509\t    eq(what, read_drbg(&p.c), read_drbg(&p.r));\n510\t}\n511\t"}]},"parent_tool_use_id":"toolu_bdrk_01TVfXZwqjfFGjnaaEeLdMeZ","session_id":"ea246c20-3a08-49a0-aeed-8ef41fe5c703","uuid":"5a6f4dd5-b9d3-4eb1-a50e-e108b39bff46","timestamp":"2026-09-02T13:35:09.507Z","subagent_type":"general-purpose","task_description":"Review app core translation"}
