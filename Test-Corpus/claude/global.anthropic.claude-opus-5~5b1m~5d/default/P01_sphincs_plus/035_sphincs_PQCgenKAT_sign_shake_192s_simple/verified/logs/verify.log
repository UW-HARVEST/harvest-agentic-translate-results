{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AJVfffpXhpoqe9eN5xiXv2","type":"tool_result","content":"1\t//! Translation of `lib/blake/src/thash_blake_robust.c` (THASH=robust, the CMake\n2\t//! default) and `lib/blake/src/thash_blake_simple.c` (THASH=simple).\n3\t\n4\tuse crate::context::SpxCtx;\n5\tuse crate::params::{SPX_ADDR_BYTES, SPX_FORS_TREES, SPX_N, SPX_WOTS_LEN};\n6\t\n7\t/// Upper bound on `inblocks` for the in-tree callers; used to size the stack\n8\t/// scratch buffers that stand in for the C `SPX_VLA(...)` variable length\n9\t/// arrays. Larger values transparently fall back to the heap.\n10\tconst MAX_INBLOCKS: usize = if SPX_WOTS_LEN > SPX_FORS_TREES {\n11\t    SPX_WOTS_LEN\n12\t} else {\n13\t    SPX_FORS_TREES\n14\t};\n15\tconst SCRATCH_MAX: usize = SPX_N + SPX_ADDR_BYTES + MAX_INBLOCKS * SPX_N;\n16\t\n17\t/// Hands out a zeroed scratch buffer of `len` bytes, preferring the stack\n18\t/// array `arr` and falling back to `heap` for oversized requests.\n19\t#[inline]\n20\tfn scratch<'a>(arr: &'a mut [u8; SCRATCH_MAX], heap: &'a mut Vec<u8>, len: usize) -> &'a mut [u8] {\n21\t    if len <= SCRATCH_MAX {\n22\t        &mut arr[..len]\n23\t    } else {\n24\t        heap.resize(len, 0);\n25\t        &mut heap[..]\n26\t    }\n27\t}\n28\t\n29\t// ---------------------------------------------------------------------------\n30\t// THASH = robust\n31\t// ---------------------------------------------------------------------------\n32\t#[cfg(not(feature = \"simple\"))]\n33\tmod robust_impl {\n34\t    use super::{scratch, SCRATCH_MAX};\n35\t    use crate::address::addr_bytes;\n36\t    use crate::backend::blake256::{blake256, blake256_mgf1, SPX_BLAKE256_OUTPUT_BYTES};\n37\t    use crate::backend::blake512::{blake512, blake512_mgf1, SPX_BLAKE512_OUTPUT_BYTES};\n38\t    use crate::context::SpxCtx;\n39\t    use crate::params::{SPX_ADDR_BYTES, SPX_BLAKE512, SPX_N};\n40\t\n41\t    /// Takes an array of inblocks concatenated arrays of SPX_N bytes.\n42\t    pub fn thash(out: &mut [u8], input: &[u8], inblocks: u32, ctx: &SpxCtx, addr: &mut [u32; 8]) {\n43\t        if SPX_BLAKE512 == 1 && inblocks > 1 {\n44\t            thash_512(out, input, inblocks, ctx, addr);\n45\t            return;\n46\t        }\n47\t        let n = inblocks as usize * SPX_N;\n48\t        let mut outbuf = [0u8; SPX_BLAKE256_OUTPUT_BYTES];\n49\t\n50\t        let mut bitmask_arr = [0u8; SCRATCH_MAX];\n51\t        let mut bitmask_heap: Vec<u8> = Vec::new();\n52\t        let bitmask = scratch(&mut bitmask_arr, &mut bitmask_heap, n);\n53\t\n54\t        let mut buf_arr = [0u8; SCRATCH_MAX];\n55\t        let mut buf_heap: Vec<u8> = Vec::new();\n56\t        let buf = scratch(&mut buf_arr, &mut buf_heap, SPX_N + SPX_ADDR_BYTES + n);\n57\t\n58\t        buf[..SPX_N].copy_from_slice(&ctx.pub_seed);\n59\t        buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(&addr_bytes(addr)[..SPX_ADDR_BYTES]);\n60\t\n61\t        blake256_mgf1(bitmask, &buf[..SPX_N + SPX_ADDR_BYTES]);\n62\t\n63\t        for i in 0..n {\n64\t            buf[SPX_N + SPX_ADDR_BYTES + i] = input[i] ^ bitmask[i];\n65\t        }\n66\t\n67\t        blake256(&mut outbuf, &buf[SPX_N..SPX_N + SPX_ADDR_BYTES + n]);\n68\t        out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n69\t    }\n70\t\n71\t    fn thash_512(out: &mut [u8], input: &[u8], inblocks: u32, ctx: &SpxCtx, addr: &mut [u32; 8]) {\n72\t        let n = inblocks as usize * SPX_N;\n73\t        let mut outbuf = [0u8; SPX_BLAKE512_OUTPUT_BYTES];\n74\t\n75\t        let mut bitmask_arr = [0u8; SCRATCH_MAX];\n76\t        let mut bitmask_heap: Vec<u8> = Vec::new();\n77\t        let bitmask = scratch(&mut bitmask_arr, &mut bitmask_heap, n);\n78\t\n79\t        let mut buf_arr = [0u8; SCRATCH_MAX];\n80\t        let mut buf_heap: Vec<u8> = Vec::new();\n81\t        let buf = scratch(&mut buf_arr, &mut buf_heap, SPX_N + SPX_ADDR_BYTES + n);\n82\t\n83\t        buf[..SPX_N].copy_from_slice(&ctx.pub_seed);\n84\t        buf[SPX_N..SPX_N