;\n    45\t    }\n    46\t}\n===== c_src/lib/haraka/src/thash_haraka_simple.c\n     1\t#include <stdint.h>\n     2\t#include <string.h>\n     3\t\n     4\t#include \"../../../app/include/address.h\"\n     5\t#include \"../../../app/include/thash.h\"\n     6\t#include \"../../../app/include/params.h\"\n     7\t#include \"../../../app/include/utils.h\"\n     8\t\n     9\t#include \"../include/haraka.h\"\n    10\t\n    11\t/**\n    12\t * Takes an array of inblocks concatenated arrays of SPX_N bytes.\n    13\t */\n    14\tvoid thash(unsigned char *out, const unsigned char *in, unsigned int inblocks,\n    15\t           const spx_ctx *ctx, uint32_t addr[8])\n    16\t{\n    17\t    SPX_VLA(uint8_t, buf, SPX_ADDR_BYTES + inblocks*SPX_N);\n    18\t    unsigned char outbuf[32];\n    19\t    unsigned char buf_tmp[64];\n    20\t\n    21\t    if (inblocks == 1) {\n    22\t        /* F function */\n    23\t        /* Since SPX_N may be smaller than 32, we need a temporary buffer. */\n    24\t        memset(buf_tmp, 0, 64);\n    25\t        memcpy(buf_tmp, addr, 32);\n    26\t        memcpy(buf_tmp + SPX_ADDR_BYTES, in, SPX_N);\n    27\t\n    28\t        haraka512(outbuf, buf_tmp, ctx);\n    29\t        memcpy(out, outbuf, SPX_N);\n    30\t    } else {\n    31\t        /* All other tweakable hashes*/\n    32\t        memcpy(buf, addr, 32);\n    33\t        memcpy(buf + SPX_ADDR_BYTES, in, inblocks * SPX_N);\n    34\t\n    35\t        haraka_S(out, SPX_N, buf, SPX_ADDR_BYTES + inblocks*SPX_N, ctx);\n    36\t    }\n    37\t}","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01KsN8KTe8GxcDs8FuWWEDTY","session_id":"ea246c20-3a08-49a0-aeed-8ef41fe5c703","uuid":"18fcc94c-bed7-4895-b9cf-cd30ba624a7d","timestamp":"2026-09-02T13:28:19.362Z","subagent_type":"general-purpose","task_description":"Review shake+haraka backend translation"}
