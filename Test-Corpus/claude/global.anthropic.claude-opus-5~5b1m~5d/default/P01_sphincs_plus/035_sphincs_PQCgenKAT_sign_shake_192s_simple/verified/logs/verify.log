_leaf` callback.\n100\tpub type GenLeafFn = fn(&mut [u8], &SpxCtx, u32, &[u32; 8]);\n101\t\n102\t/// Core of `treehash`, generic over the leaf generator so that both the safe\n103\t/// wrapper and the C ABI wrapper can share the implementation.\n104\tfn treehash_impl<F>(\n105\t    root: &mut [u8],\n106\t    auth_path: &mut [u8],\n107\t    ctx: &SpxCtx,\n108\t    leaf_idx: u32,\n109\t    idx_offset: u32,\n110\t    tree_height: u32,\n111\t    mut gen_leaf: F,\n112\t    tree_addr: &mut [u32; 8],\n113\t) where\n114\t    F: FnMut(&mut [u8], &SpxCtx, u32, &[u32; 8]),\n115\t{\n116\t    // SPX_VLA(uint8_t, stack, (tree_height+1)*SPX_N);\n117\t    let mut stack: Vec<u8> = vec![0u8; (tree_height as usize + 1) * SPX_N];\n118\t    // SPX_VLA(unsigned int, heights, tree_height+1);\n119\t    let mut heights: Vec<u32> = vec![0u32; tree_height as usize + 1];\n120\t    let mut offset: u32 = 0;\n121\t    let mut tree_idx: u32;\n122\t\n123\t    let count: u32 = 1u32.wrapping_shl(tree_height);\n124\t    let mut idx: u32 = 0;\n125\t    while idx < count {\n126\t        /* Add the next leaf node to the stack. */\n127\t        let base = offset as usize * SPX_N;\n128\t        gen_leaf(\n129\t            &mut stack[base..],\n130\t            ctx,\n131\t            idx.wrapping_add(idx_offset),\n132\t            tree_addr,\n133\t        );\n134\t        offset += 1;\n135\t        heights[offset as usize - 1] = 0;\n136\t\n137\t        /* If this is a node we need for the auth path.. */\n138\t        if (leaf_idx ^ 0x1) == idx {\n139\t            let src = (offset as usize - 1) * SPX_N;\n140\t            auth_path[..SPX_N].copy_from_slice(&stack[src..src + SPX_N]);\n141\t        }\n142\t\n143\t        /* While the top-most nodes are of equal height.. */\n144\t        while offset >= 2 && heights[offset as usize - 1] == heights[offset as usize - 2] {\n145\t            /* Compute index of the new node, in the next layer. */\n146\t            tree_idx = idx >> (heights[offset as usize - 1] + 1);\n147\t\n148\t            /* Set the address of the node we're creating. */\n149\t            set_tree_height(tree_addr, heights[offset as usize - 1] + 1);\n150\t            set_tree_index(\n151\t                tree_addr,\n152\t                tree_idx.wrapping_add(idx_offset >> (heights[offset as usize - 1] + 1)),\n153\t            );\n154\t            /* Hash the top-most nodes from the stack together. */\n155\t            let base = (offset as usize - 2) * SPX_N;\n156\t            let mut tmp = [0u8; 2 * SPX_N];\n157\t            tmp.copy_from_slice(&stack[base..base + 2 * SPX_N]);\n158\t            thash(&mut stack[base..base + SPX_N], &tmp, 2, ctx, tree_addr);\n159\t            offset -= 1;\n160\t            /* Note that the top-most node is now one layer higher. */\n161\t            heights[offset as usize - 1] += 1;\n162\t\n163\t            /* If this is a node we need for the auth path.. */\n164\t            if ((leaf_idx >> heights[offset as usize - 1]) ^ 0x1) == tree_idx {\n165\t                let dst = heights[offset as usize - 1] as usize * SPX_N;\n166\t                let src = (offset as usize - 1) * SPX_N;\n167\t                auth_path[dst..dst + SPX_N].copy_from_slice(&stack[src..src + SPX_N]);\n168\t            }\n169\t        }\n170\t        idx += 1;\n171\t    }\n172\t    root[..SPX_N].copy_from_slice(&stack[..SPX_N]);\n173\t}\n174\t\n175\t/// For a given leaf index, computes the authentication path and the resulting\n176\t/// root node using Merkle's TreeHash algorithm.\n177\tpub fn treehash(\n178\t    root: &mut [u8],\n179\t    auth_path: &mut [u8],\n180\t    ctx: &SpxCtx,\n181\t    leaf_idx: u32,\n182\t    idx_offset: u32,\n183\t    tree_height: u32,\n184\t    gen_leaf: GenLeafFn,\n185\t    tree_addr: &mut [u32; 8],\n186\t) {\n187\t    treehash_impl(\n188\t        root,\n189\t        auth_path,\n190\t        ctx,\n191\t        leaf_idx,\n192\t        idx_offset,\n193\t        tree_height,\n194\t        |leaf, c, addr_idx, ta| gen_leaf(leaf, c, addr_idx, ta),\n195\t        tree_addr,\n196\t    );\n197\t}\n198\t\n199\t// ---------------------------------------------------------------------------\n200\t// C ABI wrappers (exported linker symbols carry the `SPX_` namespace prefix)\n201\t// ---------------------------------------------------------------------------\n202\t\n203\t#[unsafe(no_mangle)]\n204\tpub extern \"C\" fn SPX_ull_to_bytes(out: *mut u8, outlen: core::ffi::c_uint, input: u64) {\n205\t    unsafe {\n206\t        let mut input = input;\n207\t        let mut i = outlen as i32 - 1;\n208\t        while i >= 0 {\n209\t            *out.add(i as usize) = (input & 0xff) as u8;\n210\t            input >>= 8;\n211\t            i -= 1;\n212\t        }\n213\t    }\n214\t}\n215\t\n216\t#[unsafe(no_mangle)]\n217\tpub extern \"C\" fn SPX_u32_to_bytes(out: *mut u8, input: u32) {\n218\t    unsafe {\n219\t        u32_to_bytes(core::slice::from_raw_parts_mut(out, 4), input);\n220\t    }\n221\t}\n222\t\n223\t#[unsafe(no_mangle)]\n224\tpub extern \"C\" fn SPX_bytes_to_ull(input: *const u8, inlen: core::ffi::c_uint) -> u64 {\n225\t    unsafe { bytes_to_ull(core::slice::from_raw_parts(input, inlen as usize), inlen) }\n226\t}\n227\t\n228\t#[unsafe(no_mangle)]\n229\tpub extern \"C\" fn SPX_compute_root(\n230\t    root: *mut u8,\n231\t    leaf: *const u8,\n232\t    leaf_idx: u32,\n233\t    idx_offset: u32,\n234\t    auth_path: *const u8,\n235\t    tree_height: u32,\n236\t    ctx: *const SpxCtx,\n237\t    addr: *mut u32,\n238\t) {\n239\t    unsafe {\n240\t        // compute_root consumes tree_height * SPX_N bytes of auth_path.\n241\t        let ap_len = (tree_height as usize).saturating_mul(SPX_N);\n242\t        compute_root(\n243\t            core::slice::from_raw_parts_mut(root, SPX_N),\n244\t            core::slice::from_raw_parts(leaf, SPX_N),\n245\t            leaf_idx,\n246\t            idx_offset,\n247\t            core::slice::from_raw_parts(auth_path, ap_len),\n248\t            tree_height,\n249\t            &*ctx,\n250\t            &mut *(addr as *mut [u32; 8]),\n251\t        );\n252\t    }\n253\t}\n254\t\n255\ttype CGenLeaf = extern \"C\" fn(*mut u8, *const SpxCtx, u32, *const u32);\n256\t\n257\t#[unsafe(no_mangle)]\n258\tpub extern \"C\" fn SPX_treehash(\n259\t    root: *mut u8,\n260\t    auth_path: *mut u8,\n261\t    ctx: *const SpxCtx,\n262\t    leaf_idx: u32,\n263\t    idx_offset: u32,\n264\t    tree_height: u32,\n265\t    gen_leaf: Option<CGenLeaf>,\n266\t    tree_addr: *mut u32,\n267\t) {\n268\t    unsafe {\n269\t        let f = gen_leaf.expect(\"treehash: NULL gen_leaf callback\");\n270\t        let ctx_ptr = ctx;\n271\t        treehash_impl(\n272\t            core::slice::from_raw_parts_mut(root, SPX_N),\n273\t            // `treehash` performs no bounds checks at all: it writes\n274\t            // `auth_path[heights[offset-1] * SPX_N ..][..SPX_N]`, and\n275\t            // `heights[offset-1]` reaches `tree_height` on the final merge, so\n276\t            // the extent the C can touch is `(tree_height + 1) * SPX_N` — the\n277\t            // last node only for a `leaf_idx` outside `0 .. 2^tree_height`\n278\t            // (which the C happily accepts, overrunning the caller's buffer).\n279\t            // The Rust wrapper must not impose a bound the C does not have, or\n280\t            // it would panic where the C writes.\n281\t            core::slice::from_raw_parts_mut(auth_path, (tree_height as usize + 1) * SPX_N),\n282\t            &*ctx,\n283\t            leaf_idx,\n284\t            idx_offset,\n285\t            tree_height,\n286\t            move |leaf: &mut [u8], _c: &SpxCtx, addr_idx: u32, ta: &[u32; 8]| {\n287\t                f(leaf.as_mut_ptr(), ctx_ptr, addr_idx, ta.as_ptr())\n288\t            },\n289\t            &mut *(tree_addr as *mut [u32; 8]),\n290\t        );\n291\t    }\n292\t}\n293\t"}]},"parent_tool_use_id":"toolu_bdrk_013k63L9tSrdLTvcrNntbKZX","session_id":"ea246c20-3a08-49a0-aeed-8ef41fe5c703","uuid":"9d481324-7b9c-4892-8aef-e257b21f2