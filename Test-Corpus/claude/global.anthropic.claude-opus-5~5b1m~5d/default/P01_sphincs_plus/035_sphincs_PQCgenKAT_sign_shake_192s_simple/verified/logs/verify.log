o_hashblocks_sha256`\n233\tfn crypto_hashblocks_sha256(statebytes: &mut [u8], input: &[u8], inlen: usize) -> usize {\n234\t    let mut state = [0u32; 8];\n235\t\n236\t    let mut a = load_bigendian_32(&statebytes[0..]);\n237\t    state[0] = a;\n238\t    let mut b = load_bigendian_32(&statebytes[4..]);\n239\t    state[1] = b;\n240\t    let mut c = load_bigendian_32(&statebytes[8..]);\n241\t    state[2] = c;\n242\t    let mut d = load_bigendian_32(&statebytes[12..]);\n243\t    state[3] = d;\n244\t    let mut e = load_bigendian_32(&statebytes[16..]);\n245\t    state[4] = e;\n246\t    let mut f = load_bigendian_32(&statebytes[20..]);\n247\t    state[5] = f;\n248\t    let mut g = load_bigendian_32(&statebytes[24..]);\n249\t    state[6] = g;\n250\t    let mut h = load_bigendian_32(&statebytes[28..]);\n251\t    state[7] = h;\n252\t\n253\t    let mut off: usize = 0;\n254\t    let mut inlen = inlen;\n255\t\n256\t    while inlen >= 64 {\n257\t        let mut w = [0u32; 64];\n258\t        for i in 0..16 {\n259\t            w[i] = load_bigendian_32(&input[off + 4 * i..]);\n260\t        }\n261\t        // The `EXPAND_32` macro, applied three times, expands the schedule\n262\t        // exactly like the standard recurrence.\n263\t        for i in 16..64 {\n264\t            w[i] = small_sigma1_32(w[i - 2])\n265\t                .wrapping_add(w[i - 7])\n266\t                .wrapping_add(small_sigma0_32(w[i - 15]))\n267\t                .wrapping_add(w[i - 16]);\n268\t        }\n269\t\n270\t        for i in 0..64 {\n271\t            let t1 = h\n272\t                .wrapping_add(big_sigma1_32(e))\n273\t                .wrapping_add(ch_32(e, f, g))\n274\t                .wrapping_add(K_256[i])\n275\t                .wrapping_add(w[i]);\n276\t            let t2 = big_sigma0_32(a).wrapping_add(maj_32(a, b, c));\n277\t            h = g;\n278\t            g = f;\n279\t            f = e;\n280\t            e = d.wrapping_add(t1);\n281\t            d = c;\n282\t            c = b;\n283\t            b = a;\n284\t            a = t1.wrapping_add(t2);\n285\t        }\n286\t\n287\t        a = a.wrapping_add(state[0]);\n288\t        b = b.wrapping_add(state[1]);\n289\t        c = c.wrapping_add(state[2]);\n290\t        d = d.wrapping_add(state[3]);\n291\t        e = e.wrapping_add(state[4]);\n292\t        f = f.wrapping_add(state[5]);\n293\t        g = g.wrapping_add(state[6]);\n294\t        h = h.wrapping_add(state[7]);\n295\t\n296\t        state[0] = a;\n297\t        state[1] = b;\n298\t        state[2] = c;\n299\t        state[3] = d;\n300\t        state[4] = e;\n301\t        state[5] = f;\n302\t        state[6] = g;\n303\t        state[7] = h;\n304\t\n305\t        off += 64;\n306\t        inlen -= 64;\n307\t    }\n308\t\n309\t    store_bigendian_32(&mut statebytes[0..], state[0] as u64);\n310\t    store_bigendian_32(&mut statebytes[4..], state[1] as u64);\n311\t    store_bigendian_32(&mut statebytes[8..], state[2] as u64);\n312\t    store_bigendian_32(&mut statebytes[12..], state[3] as u64);\n313\t    store_bigendian_32(&mut statebytes[16..], state[4] as u64);\n314\t    store_bigendian_32(&mut statebytes[20..], state[5] as u64);\n315\t    store_bigendian_32(&mut statebytes[24..], state[6] as u64);\n316\t    store_bigendian_32(&mut statebytes[28..], state[7] as u64);\n317\t\n318\t    inlen\n319\t}\n320\t\n321\t/// `crypto_hashblocks_sha512`\n322\tfn crypto_hashblocks_sha512(statebytes: &mut [u8], input: &[u8], inlen: u64) -> u64 {\n323\t    let mut state = [0u64; 8];\n324\t\n325\t    let mut a = load_bigendian_64(&statebytes[0..]);\n326\t    state[0] = a;\n327\t    let mut b = load_bigendian_64(&statebytes[8..]);\n328\t    state[1] = b;\n329\t    let mut c = load_bigendian_64(&statebytes[16..]);\n330\t    state[2] = c;\n331\t    let mut d = load_bigendian_64(&statebytes[24..]);\n332\t    state[3] = d;\n333\t    let mut e = load_bigendian_64(&statebytes[32..]);\n334\t    state[4] = e;\n335\t    let mut f = load_bigendian_64(&statebytes[40..]);\n336\t    state[5] = f;\n337\t    let mut g = load_bigendian_64(&statebytes[48..]);\n338\t    state[6] = g;\n339\t    let mut h = load_bigendian_64(&statebytes[56..]);\n340\t    state[7] = h;\n341\t\n342\t    let mut off: usize = 0;\n343\t    let mut inlen = inlen;\n344\t\n345\t    while inlen >= 128 {\n346\t        let mut w = [0u64; 80];\n347\t        for i in 0..16 {\n348\t            w[i] = load_bigendian_64(&input[off + 8 * i..]);\n349\t        }\n350\t        for i in 16..80 {\n351\t            w[i] = small_sigma1_64(w[i - 2])\n352\t                .wrapping_add(w[i - 7])\n353\t                .wrapping_add(small_sigma0_64(w[i - 15]))\n354\t                .wrapping_add(w[i - 16]);\n355\t        }\n356\t\n357\t        for i in 0..80 {\n358\t            let t1 = h\n359\t                .wrapping_add(big_sigma1_64(e))\n360\t                .wrapping_add(ch_64(e, f, g))\n361\t                .wrapping_add(K_512[i])\n362\t                .wrapping_add(w[i]);\n363\t            let t2 = big_sigma0_64(a).wrapping_add(maj_64(a, b, c));\n364\t            h = g;\n365\t            g = f;\n366\t            f = e;\n367\t            e = d.wrapping_add(t1);\n368\t            d = c;\n369\t            c = b;\n370\t            b = a;\n371\t            a = t1.wrapping_add(t2);\n372\t        }\n373\t\n374\t        a = a.wrapping_add(state[0]);\n375\t        b = b.wrapping_add(state[1]);\n376\t        c = c.wrapping_add(state[2]);\n377\t        d = d.wrapping_add(state[3]);\n378\t        e = e.wrapping_add(state[4]);\n379\t        f = f.wrapping_add(state[5]);\n380\t        g = g.wrapping_add(state[6]);\n381\t        h = h.wrapping_add(state[7]);\n382\t\n383\t        state[0] = a;\n384\t        state[1] = b;\n385\t        state[2] = c;\n386\t        state[3] = d;\n387\t        state[4] = e;\n388\t        state[5] = f;\n389\t        state[6] = g;\n390\t        state[7] = h;\n391\t\n392\t        off += 128;\n393\t        inlen -= 128;\n394\t    }\n395\t\n396\t    store_bigendian_64(&mut stateb