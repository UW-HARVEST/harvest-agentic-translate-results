{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019UFcuqpj72CLWappu4gErV","type":"tool_result","content":"1\t//\n2\t//  rng.c\n3\t//\n4\t//  Created by Bassham, Lawrence E (Fed) on 8/29/17.\n5\t//  Copyright © 2017 Bassham, Lawrence E (Fed). All rights reserved.\n6\t//\n7\t\n8\t#include <string.h>\n9\t#include <openssl/conf.h>\n10\t#include <openssl/evp.h>\n11\t#include <openssl/err.h>\n12\t\n13\t#include \"../include/rng.h\"\n14\t\n15\tAES256_CTR_DRBG_struct  DRBG_ctx;\n16\t\n17\tvoid    AES256_ECB(unsigned char *key, unsigned char *ctr, unsigned char *buffer);\n18\t\n19\t/*\n20\t seedexpander_init()\n21\t ctx            - stores the current state of an instance of the seed expander\n22\t seed           - a 32 byte random value\n23\t diversifier    - an 8 byte diversifier\n24\t maxlen         - maximum number of bytes (less than 2**32) generated under this seed and diversifier\n25\t */\n26\tint\n27\tseedexpander_init(AES_XOF_struct *ctx,\n28\t                  unsigned char *seed,\n29\t                  unsigned char *diversifier,\n30\t                  unsigned long maxlen)\n31\t{\n32\t    if ( maxlen >= 0x100000000 )\n33\t        return RNG_BAD_MAXLEN;\n34\t    \n35\t    ctx->length_remaining = maxlen;\n36\t    \n37\t    memcpy(ctx->key, seed, 32);\n38\t    \n39\t    memcpy(ctx->ctr, diversifier, 8);\n40\t    ctx->ctr[11] = (unsigned char)(maxlen % 256);\n41\t    maxlen >>= 8;\n42\t    ctx->ctr[10] = (unsigned char)(maxlen % 256);\n43\t    maxlen >>= 8;\n44\t    ctx->ctr[9] = (unsigned char)(maxlen % 256);\n45\t    maxlen >>= 8;\n46\t    ctx->ctr[8] = (unsigned char)(maxlen % 256);\n47\t    memset(ctx->ctr+12, 0x00, 4);\n48\t    \n49\t    ctx->buffer_pos = 16;\n50\t    memset(ctx->buffer, 0x00, 16);\n51\t    \n52\t    return RNG_SUCCESS;\n53\t}\n54\t\n55\t/*\n56\t seedexpander()\n57\t    ctx  - stores the current state of an instance of the seed expander\n58\t    x    - returns the XOF data\n59\t    xlen - number of bytes to return\n60\t */\n61\tint\n62\tseedexpander(AES_XOF_struct *ctx, unsigned char *x, unsigned long xlen)\n63\t{\n64\t    unsigned long   offset;\n65\t    \n66\t    if ( x == NULL )\n67\t        return RNG_BAD_OUTBUF;\n68\t    if ( xlen >= ctx->length_remaining )\n69\t        return RNG_BAD_REQ_LEN;\n70\t    \n71\t    ctx->length_remaining -= xlen;\n72\t    \n73\t    offset = 0;\n74\t    while ( xlen > 0 ) {\n75\t        if ( xlen <= (16-ctx->buffer_pos) ) { // buffer has what we need\n76\t            memcpy(x+offset, ctx->buffer+ctx->buffer_pos, xlen);\n77\t            ctx->buffer_pos += xlen;\n78\t            \n79\t            return RNG_SUCCESS;\n80\t        }\n81\t        \n82\t        // take what's in the buffer\n83\t        memcpy(x+offset, ctx->buffer+ctx->buffer_pos, 16-ctx->buffer_pos);\n84\t        xlen -= 16-ctx->buffer_pos;\n85\t        offset += 16-ctx->buffer_pos;\n86\t        \n87\t        AES256_ECB(ctx->key, ctx->ctr, ctx->buffer);\n88\t        ctx->buffer_pos = 0;\n89\t        \n90\t        //increment the counter\n91\t        for (int i=15; i>=12; i--) {\n92\t            if ( ctx->ctr[i] == 0xff )\n93\t                ctx->ctr[i] = 0x00;\n94\t            else {\n95\t                ctx->ctr[i]++;\n96\t                break;\n97\t            }\n98\t        }\n99\t        \n100\t    }\n101\t    \n102\t    return RNG_SUCCESS;\n103\t}\n104\t\n105\t\n106\tstatic void handleErrors(void)\n107\t{\n108\t    ERR_print_errors_fp(stderr);\n109\t    abort();\n110\t}\n111\t\n112\t// Use whatever AES implementation you have. This uses AES from openSSL library\n113\t//    key - 256-bit AES key\n114\t//    ctr - a 128-bit plaintext value\n115\t//    buffer - a 128-bit ciphertext value\n116\tvoid\n117\tAES256_ECB(unsigned char *key, unsigned char *ctr, unsigned char *buffer)\n118\t{\n119\t    EVP_CIPHER_CTX *ctx;\n120\t    \n121\t    int len;\n122\t    \n123\t    /* Create and initialise the context */\n124\t    if(!(ctx = EVP_CIPHER_CTX_new())) handleErrors();\n125\t    \n126\t    if(1 != EVP_EncryptInit_ex(ctx, EVP_aes_256_ecb(), NULL, key, NULL))\n127\t        handleErrors();\n128\t    \n129\t    if(1 != EVP_EncryptUpdate(ctx, buffer, &len, ctr, 16))\n130\t        handleErrors();\n131\t    \n132\t    /* Clean up */\n133\t    EVP_CIPHER_CTX_free(ctx);\n134\t}\n135\t\n136\tvoid\n137\trandombytes_init(unsigned char *entropy_input,\n138\t                 unsigned char *personalization_string)\n139\t{\n140\t    unsigned char   seed_material[48];\n141\t    \n142\t    memcpy(seed_material, entropy_input, 48);\n143\t    if (personalization_string)\n144\t        for (int i=0; i<48; i++)\n145\t            seed_material[i] ^= personalization_string[i];\n146\t    memset(DRBG_ctx.Key, 0x00, 32);\n147\t    memset(DRBG_ctx.V, 0x00, 16);\n148\t    AES256_CTR_DRBG_Update(seed_material, DRBG_ctx.Key, DRBG_ctx.V);\n149\t    DRBG_ctx.reseed_counter = 1;\n150\t}\n151\t\n152\tint\n153\trandombytes(unsigned char *x, unsigned long long xlen)\n154\t{\n155\t    unsigned char   block[16];\n156\t    int             i = 0;\n157\t    \n158\t    while ( xlen > 0 ) {\n159\t        //increment V\n160\t        for (int j=15; j>=0; j--) {\n161\t            if ( DRBG_ctx.V[j] == 0xff )\n162\t                DRBG_ctx.V[j] = 0x00;\n163\t            else {\n164\t                DRBG_ctx.V[j]++;\n165\t                break;\n166\t            }\n167\t        }\n168\t        AES256_ECB(DRBG_ctx.Key, DRBG_ctx.V, block);\n169\t        if ( xlen > 15 ) {\n170\t            memcpy(x+i, block, 16);\n171\t            i += 16;\n172\t            xlen -= 16;\n173\t        }\n174\t        else {\n175\t            memcpy(x+i, block, xlen);\n176\t            xlen = 0;\n177\t        }\n178\t    }\n179\t    AES256_CTR_DRBG_Update(NULL, DRBG_ctx.Key, DRBG_ctx.V);\n180\t    DRBG_ctx.reseed_counter++;\n181\t    \n182\t    return RNG_SUCCESS;\n183\t}\n184\t\n185\tvoid\n186\tAES256_CTR_DRBG_Update(unsigned char *provided_data,\n187\t                       unsigned char *Key,\n188\t                       unsigned char *V)\n189\t{\n190\t    unsigned char   temp[48];\n191\t    \n192\t    for (int i=0; i<3; i++) {\n193\t        //increment V\n194\t        for (int j=15; j>=0; j--) {\n195\t            if ( V[j] == 0xff )\n196\t                V[j] = 0x00;\n197\t            else {\n198\t                V[j]++;\n199\t                break;\n200\t            }\n201\t        }\n202\t        \n203\t        AES256_ECB(Key, V, temp+16*i);\n204\t    }\n205\t    if ( provided_data != NULL )\n206\t        for (int i=0; i<48; i++)\n207\t            temp[i] ^= provided_data[i];\n208\t    memcpy(Key, temp, 32);\n209\t    memcpy(V, temp+32, 16);\n210\t}\n211\t\n212\t\n213\t\n214\t\n215\t\n216\t\n217\t\n218\t\n219\t\n220\t"}]},"parent_tool_use_id":"toolu_bdrk_01TVfXZwqjfFGjnaaEeLdMeZ","session_id":"ea246c20-3a08-49a0-aeed-8ef41fe5c703","uuid":"17235ed0-75ed-4fb6-95d5-f25fdd21c57e","timestamp":"2026-09-02T13:29:16.547Z","subagent_type":"general-purpose","task_description":"Review app core translation"}
