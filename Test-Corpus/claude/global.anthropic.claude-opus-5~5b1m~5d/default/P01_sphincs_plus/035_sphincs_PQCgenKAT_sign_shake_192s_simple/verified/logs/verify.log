 {\n45\t        /* Current logical node is at index[SPX_N].  We do this to minimize the\n46\t           number of copies needed during a thash */\n47\t        let mut current = [0u8; 2 * SPX_N];\n48\t        gen_leafx1(\n49\t            &mut current[SPX_N..],\n50\t            ctx,\n51\t            idx.wrapping_add(idx_offset),\n52\t            info,\n53\t        );\n54\t\n55\t        /* Now combine the freshly generated right node with previously */\n56\t        /* generated left ones */\n57\t        let mut internal_idx_offset: u32 = idx_offset;\n58\t        let mut internal_idx: u32 = idx;\n59\t        let mut internal_leaf: u32 = leaf_idx;\n60\t        let mut h: u32 = 0; /* The height we are in the Merkle tree */\n61\t        loop {\n62\t            /* Check if we hit the top of the tree */\n63\t            if h == tree_height {\n64\t                /* We hit the root; return it */\n65\t                root[..SPX_N].copy_from_slice(&current[SPX_N..2 * SPX_N]);\n66\t                return;\n67\t            }\n68\t\n69\t            /*\n70\t             * Check if the node we have is a part of the\n71\t             * authentication path; if it is, write it out\n72\t             */\n73\t            if (internal_idx ^ internal_leaf) == 0x01 {\n74\t                let dst = h as usize * SPX_N;\n75\t                auth_path[dst..dst + SPX_N].copy_from_slice(&current[SPX_N..2 * SPX_N]);\n76\t            }\n77\t\n78\t            /*\n79\t             * Check if we're at a left child; if so, stop going up the stack\n80\t             * Exception: if we've reached the end of the tree, keep on going\n81\t             * (so we combine the last 4 nodes into the one root node in two\n82\t             * more iterations)\n83\t             */\n84\t            if (internal_idx & 1) == 0 && idx < max_idx {\n85\t                break;\n86\t            }\n87\t\n88\t            /* Ok, we're at a right node */\n89\t            /* Now combine the left and right logical nodes together */\n90\t\n91\t            /* Set the address of the node we're creating. */\n92\t            internal_idx_offset >>= 1;\n93\t            set_tree_height(tree_addr, h.wrapping_add(1));\n94\t            set_tree_index(\n95\t                tree_addr,\n96\t                (internal_idx / 2).wrapping_add(internal_idx_offset),\n97\t            );\n98\t\n99\t            let left = h as usize * SPX_N;\n100\t            current[..SPX_N].copy_from_slice(&stack[left..left + SPX_N]);\n101\t            // thash(&current[SPX_N], &current[0], 2, ...) -- out and in overlap.\n102\t            let tmp = current;\n103\t            thash(&mut current[SPX_N..2 * SPX_N], &tmp, 2, ctx, tree_addr);\n104\t\n105\t            h = h.wrapping_add(1);\n106\t            internal_idx >>= 1;\n107\t            internal_leaf >>= 1;\n108\t        }\n109\t\n110\t        /* We've hit a left child; save the current for when we get the */\n111\t        /* corresponding right right */\n112\t        let dst = h as usize * SPX_N;\n113\t        stack[dst..dst + SPX_N].copy_from_slice(&current[SPX_N..2 * SPX_N]);\n114\t\n115\t        idx = idx.wrapping_add(1);\n116\t    }\n117\t}\n118\t\n119\tpub fn wots_treehashx1(\n120\t    root: &mut [u8],\n121\t    auth_path: &mut [u8],\n122\t    ctx: &SpxCtx,\n123\t    leaf_idx: u32,\n124\t    idx_offset: u32,\n125\t    tree_height: u32,\n126\t    tree_addr: &mut [u32; 8],\n127\t    info: &mut LeafInfoX1,\n128\t) {\n129\t    treehashx1(\n130\t        root,\n131\t        auth_path,\n132\t        ctx,\n133\t        leaf_idx,\n134\t        idx_offset,\n135\t        tree_height,\n136\t        tree_addr,\n137\t        info,\n138\t        |leaf, c, addr_idx, i| wots_gen_leafx1(leaf, c, addr_idx, i),\n139\t    );\n140\t}\n141\t\n142\tpub fn fors_treehashx1(\n143\t    root: &mut [u8],\n144\t    auth_path: &mut [u8],\n145\t    ctx: &SpxCtx,\n146\t    leaf_idx: u32,\n147\t    idx_offset: u32,\n148\t    tree_height: u32,\n149\t    tree_addr: &mut [u32; 8],\n150\t    info: &mut ForsGen