{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015YA8DXuT9So9jL9xuCmgnU","type":"tool_result","content":"1\t//! Translation of `c_src/lib/shake/src/fips202.c` and\n2\t//! `c_src/lib/shake/include/fips202.h`.\n3\t//!\n4\t//! Based on the public domain implementation in\n5\t//! crypto_hash/keccakc512/simple/ from http://bench.cr.yp.to/supercop.html\n6\t//! by Ronny Van Keer\n7\t//! and the public domain \"TweetFips202\" implementation\n8\t//! from https://twitter.com/tweetfips202\n9\t//! by Gilles Van Assche, Daniel J. Bernstein, and Peter Schwabe\n10\t\n11\tconst NROUNDS: usize = 24;\n12\t\n13\t/// `ROL(a, offset) (((a) << (offset)) ^ ((a) >> (64 - (offset))))`\n14\t///\n15\t/// Every call site uses a rotation amount in `1..=62`, so this is exactly a\n16\t/// 64-bit rotate-left.\n17\t#[inline(always)]\n18\tfn rol(a: u64, offset: u32) -> u64 {\n19\t    (a << offset) ^ (a >> (64 - offset))\n20\t}\n21\t\n22\tpub const SHAKE128_RATE: usize = 168;\n23\tpub const SHAKE256_RATE: usize = 136;\n24\tpub const SHA3_256_RATE: usize = 136;\n25\tpub const SHA3_512_RATE: usize = 72;\n26\t\n27\t/*************************************************\n28\t * Name:        load64\n29\t *\n30\t * Description: Load 8 bytes into uint64_t in little-endian order\n31\t **************************************************/\n32\t#[inline]\n33\tfn load64(x: &[u8]) -> u64 {\n34\t    let mut r: u64 = 0;\n35\t    for i in 0..8 {\n36\t        r |= (x[i] as u64) << (8 * i);\n37\t    }\n38\t    r\n39\t}\n40\t\n41\t/*************************************************\n42\t * Name:        store64\n43\t *\n44\t * Description: Store a 64-bit integer to a byte array in little-endian order\n45\t **************************************************/\n46\t#[inline]\n47\tfn store64(x: &mut [u8], u: u64) {\n48\t    for i in 0..8 {\n49\t        x[i] = (u >> (8 * i)) as u8;\n50\t    }\n51\t}\n52\t\n53\t/* Keccak round constants */\n54\tstatic KECCAK_F_ROUND_CONSTANTS: [u64; NROUNDS] = [\n55\t    0x0000000000000001,\n56\t    0x0000000000008082,\n57\t    0x800000000000808a,\n58\t    0x8000000080008000,\n59\t    0x000000000000808b,\n60\t    0x0000000080000001,\n61\t    0x8000000080008081,\n62\t    0x8000000000008009,\n63\t    0x000000000000008a,\n64\t    0x0000000000000088,\n65\t    0x0000000080008009,\n66\t    0x000000008000000a,\n67\t    0x000000008000808b,\n68\t    0x800000000000008b,\n69\t    0x8000000000008089,\n70\t    0x8000000000008003,\n71\t    0x8000000000008002,\n72\t    0x8000000000000080,\n73\t    0x000000000000800a,\n74\t    0x800000008000000a,\n75\t    0x8000000080008081,\n76\t    0x8000000000008080,\n77\t    0x0000000080000001,\n78\t    0x8000000080008008,\n79\t];\n80\t\n81\t/*************************************************\n82\t * Name:        KeccakF1600_StatePermute\n83\t *\n84\t * Description: The Keccak F1600 Permutation\n85\t *\n86\t * Arguments:   - uint64_t *state: pointer to input/output Keccak state\n87\t **************************************************/\n88\t#[allow(clippy::needless_range_loop)]\n89\t#[allow(unused_assignments)]\n90\tfn keccak_f1600_state_permute(state: &mut [u64]) {\n91\t    let (mut bca, mut bce, mut bci, mut bco, mut bcu): (u64, u64, u64, u64, u64) = (0, 0, 0, 0, 0);\n92\t    let (mut eba, mut ebe, mut ebi, mut ebo, mut ebu): (u64, u64, u64, u64, u64) = (0, 0, 0, 0, 0);\n93\t    let (mut ega, mut ege, mut egi, mut ego, mut egu): (u64, u64, u64, u64, u64) = (0, 0, 0, 0, 0);\n94\t    let (mut eka, mut eke, mut eki, mut eko, mut eku): (u64, u64, u64, u64, u64) = (0, 0, 0, 0, 0);\n95\t    let (mut ema, mut eme, mut emi, mut emo, mut emu): (u64, u64, u64, u64, u64) = (0, 0, 0, 0, 0);\n96\t    let (mut esa, mut ese, mut esi, mut eso, mut esu): (u64, u64, u64, u64, u64) = (0, 0, 0, 0, 0);\n97\t\n98\t    // copyFromState(A, state)\n99\t    let mut aba = state[0];\n100\t    let mut abe = state[1];\n101\t    let mut abi = state[2];\n102\t    let mut abo = state[3];\n103\t    let mut abu = state[4];\n104\t    let mut aga = state[5];\n105\t    let mut age = state[6];\n106\t    let mut agi = state[7];\n107\t    let mut ago = state[8];\n108\t    let mut agu = state[9];\n109\t    let mut aka = state[10];\n110\t    let mut ake = state[11];\n111\t    let mut aki = state[12];\n112\t    let mut ako = state[13];\n113\t    let mut aku = state[14];\n114\t    let mut ama = state[15];\n115\t    let mut ame = state[16];\n116\t    let mut ami = state[17];\n117\t    let mut amo = state[18];\n118\t    let mut amu = state[19];\n119\t    let mut asa = state[20];\n120\t    let mut ase = state[21];\n121\t    let mut asi = state[22];\n122\t    let mut aso = state[23];\n123\t    let mut asu = state[24];\n124\t\n125\t    let mut round = 0usize;\n126\t    while round < NROUNDS {\n127\t        //    prepareTheta\n128\t        bca = aba ^ aga ^ aka ^ ama ^ asa;\n129\t        bce = abe ^ age ^ ake ^ ame ^ ase;\n130\t        bci = abi ^ agi ^ aki ^ ami ^ asi;\n131\t        bco = abo ^ ago ^ ako ^ amo ^ aso;\n132\t        bcu = abu ^ agu ^ aku ^ amu ^ asu;\n133\t\n134\t        // thetaRhoPiChiIotaPrepareTheta(round  , A, E)\n135\t        let da = bcu ^ rol(bce, 1);\n136\t        let de = bca ^ rol(bci, 1);\n137\t        let di = bce ^ rol(bco, 1);\n138\t        let dob = bci ^ rol(bcu, 1);\n139\t        let du = bco ^ rol(bca, 1);\n140\t\n141\t        aba ^= da;\n142\t        bca = aba;\n143\t        age ^= de;\n144\t        bce = rol(age, 44);\n145\t        aki ^= di;\n146\t        bci = rol(aki, 43);\n147\t        amo ^= dob;\n148\t        bco = rol(amo, 21);\n149\t        asu ^= du;\n150\t        bcu = rol(asu, 14);\n151\t        eba = bca ^ ((!bce) & bci);\n152\t        eba ^= KECCAK_F_ROUND_CONSTANTS[round];\n153\t        ebe = bce ^ ((!bci) & bco);\n154\t        ebi = bci ^ ((!bco) & bcu);\n155\t        ebo = bco ^ ((!bcu) & bca);\n156\t        ebu = bcu ^ ((!bca) & bce);\n157\t\n158\t        abo ^= dob;\n159\t        bca = rol(abo, 28);\n160\t        agu ^= du;\n161\t        bce = rol(agu, 20);\n162\t        aka ^= da;\n163\t        bci = rol(aka, 3);\n164\t        ame ^= de;\n165\t        bco = rol(ame, 45);\n166\t        asi ^= di;\n167\t        bcu = rol(asi, 61);\n168\t        ega = bca ^ ((!bce) & bci);\n169\t        ege = bce ^ ((!bci) & bco);\n170\t        egi = bci ^ ((!bco) & bcu);\n171\t        ego = bco ^ ((!bcu) & bca);\n172\t        egu = bcu ^ ((!bca) & bce);\n173\t\n174\t        abe ^= de;\n175\t        bca = rol(abe, 1);\n176\t        agi ^= di;\n177\t        bce = rol(agi, 6);\n178\t        ako ^= dob;\n179\t        bci = rol(ako, 25);\n180\t        amu ^= du;\n181\t        bco = rol(amu, 8);\n182\t        asa ^= da;\n183\t        bcu = rol(asa, 18);\n184\t        eka = bca ^ ((!bce) & bci);\n185\t        eke = bce ^ ((!bci) & bco);\n186\t        eki = bci ^ ((!bco) & bcu);\n187\t        eko = bco ^ ((!bcu) & bca);\n188\t        eku = bcu ^ ((!bca) & bce);\n189\t\n190\t        abu ^= du;\n191\t        bca = rol(abu, 27);\n192\t        aga ^= da;\n193\t        bce = rol(aga, 36);\n194\t        ake ^= de;\n195\t        bci = rol(ake, 10);\n196\t        ami ^= di;\n197\t        bco = rol(ami, 15);\n198\t        aso ^= dob;\n199\t        bcu = rol(aso, 56);\n200\t        ema = bca ^ ((!bce) & bci);\n201\t        eme = bce ^ ((!bci) & bco);\n202\t        emi = bci ^ ((!bco) & bcu);\n203\t        emo = bco ^ ((!bcu) & bca);\n204\t        emu = bcu ^ ((!bca) & bce);\n205\t\n206\t        abi ^= di;\n207\t        bca = rol(abi, 62);\n208\t        ago ^= dob;\n209\t        bce = rol(ago, 55);\n210\t        aku ^= du;\n211\t        bci = rol(aku, 39);\n212\t        ama ^= da;\n213\t        bco = rol(ama, 41);\n214\t        ase ^= de;\n215\t        bcu = rol(ase, 2);\n216\t        esa = bca ^ ((!bce) & bci);\n217\t        ese = bce ^ ((!bci) & bco);\n218\t        esi = bci ^ ((!bco) & bcu);\n219\t        eso = bco ^ ((!bcu) & bca);\n220\t        esu = bcu ^ ((!bca) & bce);\n221\t\n222\t        //    prepareTheta\n223\t        bca = eba ^ ega ^ eka ^ ema ^ esa;\n224\t        bce = ebe ^ ege ^ eke ^ eme ^ ese;\n225\t        bci = ebi ^ egi ^ eki ^ emi ^ esi;\n226\t        bco = ebo ^ ego ^ eko ^ emo ^ eso;\n227\t        bcu = ebu ^ egu ^ eku ^ emu ^ esu;\n228\t\n229\t        // thetaRhoPiChiIotaPrepareTheta(round+1, E, A)\n230\t        let da2 = bcu ^ rol(bce, 1);\n231\t        let de2 = bca ^ rol(bci, 1);\n232\t        let di2 = bce ^ rol(bco, 1);\n233\t        let do2 = bci ^ rol(bcu, 1);\n234\t        let du2 = bco ^ rol(bca, 1);\n235\t\n236\t        eba ^= da2;\n237\t        bca = eba;\n238\t        ege ^= de2;\n239\t        bce = rol(ege, 44);\n240\t        eki ^= di2;\n241\t        bci = rol(eki, 43);\n242\t        emo ^= do2;\n243\t        bco = rol(emo, 21);\n244\t        esu ^= du2;\n245\t        bcu = rol(esu, 14);\n246\t        aba = bca ^ ((!bce) & bci);\n247\t        aba ^= KECCAK_F_ROUND_CONSTANTS[round + 1];\n248\t        abe = bce ^ ((!bci) & bco);\n249\t        abi = bci ^ ((!bco) & bcu);\n250\t        abo = bco ^ ((!bcu) & bca);\n251\t        abu = bcu ^ ((!bca) & bce);\n252\t\n253\t        ebo ^= do2;\n254\t        bca = rol(ebo, 28);\n255\t        egu ^= du2;\n256\t        bce = rol(egu, 20);\n257\t        eka ^= da2;\n258\t        bci = rol(eka, 3);\n259\t        eme ^= de2;\n260\t        bco = rol(eme, 45);\n261\t        esi ^= di2;\n262\t        bcu = rol(esi, 61);\n263\t        aga = bca ^ ((!bce) & bci);\n264\t        age = bce ^ ((!bci) & bco);\n265\t        agi = bci ^ ((!bco) & bcu);\n266\t        ago = bco ^ ((!bcu) & bca);\n267\t        agu = bcu ^ ((!bca) & bce);\n268\t\n269\t        ebe ^= de2;\n270\t        bca = rol(ebe, 1);\n271\t        egi ^= di2;\n272\t        bce = rol(egi, 6);\n273\t        eko ^= do2;\n274\t        bci = rol(eko, 25);\n275\t        emu ^= du2;\n276\t        bco = rol(emu, 8);\n277\t        esa ^= da2;\n278\t        bcu = rol(esa, 18);\n279\t        aka = bca ^ ((!bce) & bci);\n280\t        ake = bce ^ ((!bci) & bco);\n281\t        aki = bci ^ ((!bco) & bcu);\n282\t        ako = bco ^ ((!bcu) & bca);\n283\t        aku = bcu ^ ((!bca) & bce);\n284\t\n285\t        ebu ^= du2;\n286\t        bca = rol(ebu, 27);\n287\t        ega ^= da2;\n288\t        bce = rol(ega, 36);\n289\t        eke ^= de2;\n290\t        bci = rol(eke, 10);\n291\t        emi ^= di2;\n292\t        bco = rol(emi, 15);\n293\t        eso ^= do2;\n294\t        bcu = rol(eso, 56);\n295\t        ama = bca ^ ((!bce) & bci);\n296\t        ame = bce ^ ((!bci) & bco);\n297\t        ami = bci ^ ((!bco) & bcu);\n298\t        amo = bco ^ ((!bcu) & bca);\n299\t        amu = bcu ^ ((!bca) & bce);\n300\t\n301\t        ebi ^= di2;\n302\t        bca = rol(ebi, 62);\n303\t        ego ^= do2;\n304\t        bce = rol(ego, 55);\n305\t        eku ^= du2;\n306\t        bci = rol(eku, 39);\n307\t        ema ^= da2;\n308\t        bco = rol(ema, 41);\n309\t        ese ^= de2;\n310\t        bcu = rol(ese, 2);\n311\t        asa = bca ^ ((!bce) & bci);\n312\t        ase = bce ^ ((!bci) & bco);\n313\t        asi = bci ^ ((!bco) & bcu);\n314\t        aso = bco ^ ((!bcu) & bca);\n315\t        asu = bcu ^ ((!bca) & bce);\n316\t\n317\t        round += 2;\n318\t    }\n319\t\n320\t    // copyToState(state, A)\n321\t    state[0] = aba;\n322\t    state[1] = abe;\n323\t    state[2] = abi;\n324\t    state[3] = abo;\n325\t    state[4] = abu;\n326\t    state[5] = aga;\n327\t    state[6] = age;\n328\t    state[7] = agi;\n329\t    state[8] = ago;\n330\t    state[9] = agu;\n331\t    state[10] = aka;\n332\t    state[11] = ake;\n333\t    state[12] = aki;\n334\t    state[13] = ako;\n335\t    state[14] = aku;\n336\t    state[15] = ama;\n337\t    state[16] = ame;\n338\t    state[17] = ami;\n339\t    state[18] = amo;\n340\t    state[19] = amu;\n341\t    state[20] = asa;\n342\t    state[21] = ase;\n343\t    state[22] = asi;\n344\t    state[23] = aso;\n345\t    state[24] = asu;\n346\t}\n347\t\n348\t/*************************************************\n349\t * Name:        keccak_absorb\n350\t *\n351\t * Description: Absorb step of Keccak;\n352\t *              non-incremental, starts by zeroeing the state.\n353\t **************************************************/\n354\tfn keccak_absorb(s: &mut [u64], r: usize, m: &[u8], p: u8) {\n355\t    let mut t = [0u8; 200];\n356\t\n357\t    /* Zero state */\n358\t    for i in 0..25 {\n359\t        s[i] = 0;\n360\t    }\n361\t\n362\t    let mut off: usize = 0;\n363\t    let mut mlen: usize = m.len();\n364\t\n365\t    while mlen >= r {\n366\t        for i in 0..(r / 8) {\n367\t            s[i] ^= load64(&m[off + 8 * i..]);\n368\t        }\n369\t\n370\t        keccak_f1600_state_permute(s);\n371\t        mlen -= r;\n372\t        off += r;\n373\t    }\n374\t\n375\t    for i in 0..r {\n376\t        t[i] = 0;\n377\t    }\n378\t    for i in 0..mlen {\n379\t        t[i] = m[off + i];\n380\t    }\n381\t    t[mlen] = p;\n382\t    t[r - 1] |= 128;\n383\t    for i in 0..(r / 8) {\n384\t        s[i] ^= load64(&t[8 * i..]);\n385\t    }\n386\t}\n387\t\n388\t/*************************************************\n389\t * Name:        keccak_squeezeblocks\n390\t *\n391\t * Description: Squeeze step of Keccak. Squeezes full blocks of r bytes each.\n392\t *              Modifies the state. Can be called multiple times to keep\n393\t *              squeezing, i.e., is incremental.\n394\t **************************************************/\n395\tfn keccak_squeezeblocks(h: &mut [u8], mut nblocks: usize, s: &mut [u64], r: usize) {\n396\t    let mut off: usize = 0;\n397\t    while nblocks > 0 {\n398\t        keccak_f1600_state_permute(s);\n399\t        for i in 0..(r >> 3) {\n400\t            let v = s[i];\n401\t            store64(&mut h[off + 8 * i..], v);\n402\t        }\n403\t        off += r;\n404\t        nblocks -= 1;\n405\t    }\n406\t}\n407\t\n408\t/*************************************************\n409\t * Name:        keccak_inc_init\n410\t *\n411\t * Description: Initializes the incremental Keccak state to zero.\n412\t **************************************************/\n413\tfn keccak_inc_init(s_inc: &mut [u64]) {\n414\t    for i in 0..25 {\n415\t        s_inc[i] = 0;\n416\t    }\n417\t    s_inc[25] = 0;\n418\t}\n419\t\n420\t/*************************************************\n421\t * Name:        keccak_inc_absorb\n422\t *\n423\t * Description: Incremental keccak absorb\n424\t *              Preceded by keccak_inc_init, succeeded by keccak_inc_finalize\n425\t **************************************************/\n426\tfn keccak_inc_absorb(s_inc: &mut [u64], r: usize, m: &[u8]) {\n427\t    let mut off: usize = 0;\n428\t    let mut mlen: u64 = m.len() as u64;\n429\t\n430\t    /* Recall that s_inc[25] is the non-absorbed bytes xored into the state */\n431\t    while mlen + s_inc[25] >= r as u64 {\n432\t        let n = r as u64 - s_inc[25];\n433\t        let mut i: u64 = 0;\n434\t        while i < n {\n435\t            /* Take the i'th byte from message\n436\t               xor with the s_inc[25] + i'th byte of the state; little-endian */\n437\t            let idx = s_inc[25] + i;\n438\t            s_inc[(idx >> 3) as usize] ^=\n439\t                (m[off + i as usize] as u64) << (8 * (idx & 0x07));\n440\t            i += 1;\n441\t        }\n442\t        mlen -= n;\n443\t        off += n as usize;\n444\t        s_inc[25] = 0;\n445\t\n446\t        keccak_f1600_state_permute(s_inc);\n447\t    }\n448\t\n449\t    let mut i: u64 = 0;\n450\t    while i < mlen {\n451\t        let idx = s_inc[25] + i;\n452\t        s_inc[(idx >> 3) as usize] ^= (m[off + i as usize] as u64) << (8 * (idx & 0x07));\n453\t        i += 1;\n454\t    }\n455\t    s_inc[25] += mlen;\n456\t}\n457\t\n458\t/*************************************************\n459\t * Name:        keccak_inc_finalize\n460\t *\n461\t * Description: Finalizes Keccak absorb phase, prepares for squeezing\n462\t **************************************************/\n463\tfn keccak_inc_finalize(s_inc: &mut [u64], r: usize, p: u8) {\n464\t    /* After keccak_inc_absorb, we are guaranteed that s_inc[25] < r,\n465\t       so we can always use one more byte for p in the current state. */\n466\t    let c = s_inc[25];\n467\t    s_inc[(c >> 3) as usize] ^= (p as u64) << (8 * (c & 0x07));\n468\t    s_inc[(r - 1) >> 3] ^= 128u64 << (8 * ((r - 1) & 0x07));\n469\t    s_inc[25] = 0;\n470\t}\n471\t\n472\t/*************************************************\n473\t * Name:        keccak_inc_squeeze\n474\t *\n475\t * Description: Incremental Keccak squeeze; can be called on byte-level\n476\t **************************************************/\n477\tfn keccak_inc_squeeze(h: &mut [u8], mut outlen: usize, s_inc: &mut [u64], r: usize) {\n478\t    let mut hoff: usize = 0;\n479\t\n480\t    /* First consume any bytes we still have sitting around */\n481\t    let mut i: u64 = 0;\n482\t    while (i as usize) < outlen && i < s_inc[25] {\n483\t        /* There are s_inc[25] bytes left, so r - s_inc[25] is the first\n484\t           available byte. We consume from there, i.e., up to r. */\n485\t        let idx = r as u64 - s_inc[25] + i;\n486\t        h[hoff + i as usize] = (s_inc[(idx >> 3) as usize] >> (8 * (idx & 0x07))) as u8;\n487\t        i += 1;\n488\t    }\n489\t    hoff += i as usize;\n490\t    outlen -= i as usize;\n491\t    s_inc[25] -= i;\n492\t\n493\t    /* Then squeeze the remaining necessary blocks */\n494\t    while outlen > 0 {\n495\t        keccak_f1600_state_permute(s_inc);\n496\t\n497\t        let mut i: usize = 0;\n498\t        while i < outlen && i < r {\n499\t            h[hoff + i] = (s_inc[i >> 3] >> (8 * (i & 0x07))) as u8;\n500\t            i += 1;\n501\t        }\n502\t        hoff += i;\n503\t        outlen -= i;\n504\t        s_inc[25] = (r - i) as u64;\n505\t    }\n506\t}\n507\t\n508\t// ---------------------------------------------------------------------------\n509\t// SHAKE128\n510\t// ---------------------------------------------------------------------------\n511\t\n512\tpub fn shake128_absorb(s: &mut [u64], input: &[u8]) {\n513\t    keccak_absorb(s, SHAKE128_RATE, input, 0x1F);\n514\t}\n515\t\n516\tpub fn shake128_squeezeblocks(output: &mut [u8], nblocks: usize, s: &mut [u64]) {\n517\t    keccak_squeezeblocks(output, nblocks, s, SHAKE128_RATE);\n518\t}\n519\t\n520\tpub fn shake128_inc_init(s_inc: &mut [u64]) {\n521\t    keccak_inc_init(s_inc);\n522\t}\n523\t\n524\tpub fn shake128_inc_absorb(s_inc: &mut [u64], input: &[u8]) {\n525\t    keccak_inc_absorb(s_inc, SHAKE128_RATE, input);\n526\t}\n527\t\n528\tpub fn shake128_inc_finalize(s_inc: &mut [u64]) {\n529\t    keccak_inc_finalize(s_inc, SHAKE128_RATE, 0x1F);\n530\t}\n531\t\n532\tpub fn shake128_inc_squeeze(output: &mut [u8], s_inc: &mut [u64]) {\n533\t    let outlen = output.len();\n534\t    keccak_inc_squeeze(output, outlen, s_inc, SHAKE128_RATE);\n535\t}\n536\t\n537\t/*************************************************\n538\t * Name:        shake128\n539\t *\n540\t * Description: SHAKE128 XOF with non-incremental API\n541\t **************************************************/\n542\tpub fn shake128(output: &mut [u8], input: &[u8]) {\n543\t    let mut outlen = output.len();\n544\t    let nblocks = outlen / SHAKE128_RATE;\n545\t    let mut t = [0u8; SHAKE128_RATE];\n546\t    let mut s = [0u64; 25];\n547\t\n548\t    shake128_absorb(&mut s, input);\n549\t    shake128_squeezeblocks(&mut output[..nblocks * SHAKE128_RATE], nblocks, &mut s);\n550\t\n551\t    let off = nblocks * SHAKE128_RATE;\n552\t    outlen -= nblocks * SHAKE128_RATE;\n553\t\n554\t    if outlen != 0 {\n555\t        shake128_squeezeblocks(&mut t, 1, &mut s);\n556\t        for i in 0..outlen {\n557\t            output[off + i] = t[i];\n558\t        }\n559\t    }\n560\t}\n561\t\n562\t// ---------------------------------------------------------------------------\n563\t// SHAKE256\n564\t// ---------------------------------------------------------------------------\n565\t\n566\tpub fn shake256_inc_init(s_inc: &mut [u64]) {\n567\t    keccak_inc_init(s_inc);\n568\t}\n569\t\n570\tpub fn shake256_inc_absorb(s_inc: &mut [u64], input: &[u8]) {\n571\t    keccak_inc_absorb(s_inc, SHAKE256_RATE, input);\n572\t}\n573\t\n574\tpub fn shake256_inc_finalize(s_inc: &mut [u64]) {\n575\t    keccak_inc_finalize(s_inc, SHAKE256_RATE, 0x1F);\n576\t}\n577\t\n578\tpub fn shake256_inc_squeeze(output: &mut [u8], s_inc: &mut [u64]) {\n579\t    let outlen = output.len();\n580\t    keccak_inc_squeeze(output, outlen, s_inc, SHAKE256_RATE);\n581\t}\n582\t\n583\t/*************************************************\n584\t * Name:        shake256_absorb\n585\t *\n586\t * Description: Absorb step of the SHAKE256 XOF.\n587\t *              non-incremental, starts by zeroeing the state.\n588\t **************************************************/\n589\tpub fn shake256_absorb(s: &mut [u64], input: &[u8]) {\n590\t    keccak_absorb(s, SHAKE256_RATE, input, 0x1F);\n591\t}\n592\t\n593\t/*************************************************\n594\t * Name:        shake256_squeezeblocks\n595\t *\n596\t * Description: Squeeze step of SHAKE256 XOF. Squeezes full blocks of\n597\t *              SHAKE256_RATE bytes each. Modifies the state. Can be called\n598\t *              multiple times to keep squeezing, i.e., is incremental.\n599\t **************************************************/\n600\tpub fn shake256_squeezeblocks(output: &mut [u8], nblocks: usize, s: &mut [u64]) {\n601\t    keccak_squeezeblocks(output, nblocks, s, SHAKE256_RATE);\n602\t}\n603\t\n604\t/*************************************************\n605\t * Name:        shake256\n606\t *\n607\t * Description: SHAKE256 XOF with non-incremental API\n608\t **************************************************/\n609\tpub fn shake256(output: &mut [u8], input: &[u8]) {\n610\t    let mut outlen = output.len();\n611\t    let nblocks = outlen / SHAKE256_RATE;\n612\t    let mut t = [0u8; SHAKE256_RATE];\n613\t    let mut s = [0u64; 25];\n614\t\n615\t    shake256_absorb(&mut s, input);\n616\t    shake256_squeezeblocks(&mut output[..nblocks * SHAKE256_RATE], nblocks, &mut s);\n617\t\n618\t    let off = nblocks * SHAKE256_RATE;\n619\t    outlen -= nblocks * SHAKE256_RATE;\n620\t\n621\t    if outlen != 0 {\n622\t        shake256_squeezeblocks(&mut t, 1, &mut s);\n623\t        for i in 0..outlen {\n624\t            output[off + i] = t[i];\n625\t        }\n626\t    }\n627\t}\n628\t\n629\t// ---------------------------------------------------------------------------\n630\t// SHA3-256\n631\t// ---------------------------------------------------------------------------\n632\t\n633\tpub fn sha3_256_inc_init(s_inc: &mut [u64]) {\n634\t    keccak_inc_init(s_inc);\n635\t}\n636\t\n637\tpub fn sha3_256_inc_absorb(s_inc: &mut [u64], input: &[u8]) {\n638\t    keccak_inc_absorb(s_inc, SHA3_256_RATE, input);\n639\t}\n640\t\n641\tpub fn sha3_256_inc_finalize(output: &mut [u8], s_inc: &mut [u64]) {\n642\t    let mut t = [0u8; SHA3_256_RATE];\n643\t    keccak_inc_finalize(s_inc, SHA3_256_RATE, 0x06);\n644\t\n645\t    keccak_squeezeblocks(&mut t, 1, s_inc, SHA3_256_RATE);\n646\t\n647\t    for i in 0..32 {\n648\t        output[i] = t[i];\n649\t    }\n650\t}\n651\t\n652\tpub fn sha3_256(output: &mut [u8], input: &[u8]) {\n653\t    let mut s = [0u64; 25];\n654\t    let mut t = [0u8; SHA3_256_RATE];\n655\t\n656\t    /* Absorb input */\n657\t    keccak_absorb(&mut s, SHA3_256_RATE, input, 0x06);\n658\t\n659\t    /* Squeeze output */\n660\t    keccak_squeezeblocks(&mut t, 1, &mut s, SHA3_256_RATE);\n661\t\n662\t    for i in 0..32 {\n663\t        output[i] = t[i];\n664\t    }\n665\t}\n666\t\n667\t// ---------------------------------------------------------------------------\n668\t// SHA3-512\n669\t// ---------------------------------------------------------------------------\n670\t\n671\tpub fn sha3_512_inc_init(s_inc: &mut [u64]) {\n672\t    keccak_inc_init(s_inc);\n673\t}\n674\t\n675\tpub fn sha3_512_inc_absorb(s_inc: &mut [u64], input: &[u8]) {\n676\t    keccak_inc_absorb(s_inc, SHA3_512_RATE, input);\n677\t}\n678\t\n679\tpub fn sha3_512_inc_finalize(output: &mut [u8], s_inc: &mut [u64]) {\n680\t    let mut t = [0u8; SHA3_512_RATE];\n681\t    keccak_inc_finalize(s_inc, SHA3_512_RATE, 0x06);\n682\t\n683\t    keccak_squeezeblocks(&mut t, 1, s_inc, SHA3_512_RATE);\n684\t\n685\t    for i in 0..64 {\n686\t        output[i] = t[i];\n687\t    }\n688\t}\n689\t\n690\tpub fn sha3_512(output: &mut [u8], input: &[u8]) {\n691\t    let mut s = [0u64; 25];\n692\t    let mut t = [0u8; SHA3_512_RATE];\n693\t\n694\t    /* Absorb input */\n695\t    keccak_absorb(&mut s, SHA3_512_RATE, input, 0x06);\n696\t\n697\t    /* Squeeze output */\n698\t    keccak_squeezeblocks(&mut t, 1, &mut s, SHA3_512_RATE);\n699\t\n700\t    for i in 0..64 {\n701\t        output[i] = t[i];\n702\t    }\n703\t}\n704\t"}]},"parent_tool_use_id":"toolu_bdrk_01KsN8KTe8GxcDs8FuWWEDTY","session_id":"ea246c20-3a08-49a0-aeed-8ef41fe5c703","uuid":"18713ae0-f07c-4adf-9780-66162d5cb9ad","timestamp":"2026-09-02T13:26:39.098Z","subagent_type":"general-purpose","task_description":"Review shake+haraka backend translation"}
