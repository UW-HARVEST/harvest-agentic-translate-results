array to be allocated on the stack. Typically `input` is merely a\n598\t/// seed. Outputs `out.len()` number of bytes.\n599\tpub fn mgf1_256(out: &mut [u8], input: &[u8]) {\n600\t    let outlen = out.len();\n601\t    let inlen = input.len();\n602\t\n603\t    let mut stack_inbuf = [0u8; MGF1_INBUF_CAP];\n604\t    let mut heap_inbuf: Vec<u8>;\n605\t    let inbuf: &mut [u8] = if inlen + 4 <= MGF1_INBUF_CAP {\n606\t        &mut stack_inbuf[..inlen + 4]\n607\t    } else {\n608\t        heap_inbuf = vec![0u8; inlen + 4];\n609\t        &mut heap_inbuf[..]\n610\t    };\n611\t\n612\t    let mut outbuf = [0u8; SPX_SHA256_OUTPUT_BYTES];\n613\t\n614\t    inbuf[..inlen].copy_from_slice(input);\n615\t\n616\t    let mut i: u64 = 0;\n617\t    let mut o: usize = 0;\n618\t\n619\t    /* While we can fit in at least another full block of SHA256 output.. */\n620\t    while ((i as usize) + 1) * SPX_SHA256_OUTPUT_BYTES <= outlen {\n621\t        u32_to_bytes(&mut inbuf[inlen..], i as u32);\n622\t        sha256(&mut out[o..], inbuf);\n623\t        o += SPX_SHA256_OUTPUT_BYTES;\n624\t        i += 1;\n625\t    }\n626\t    /* Until we cannot anymore, and we fill the remainder. */\n627\t    if outlen > (i as usize) * SPX_SHA256_OUTPUT_BYTES {\n628\t        u32_to_bytes(&mut inbuf[inlen..], i as u32);\n629\t        sha256(&mut outbuf, inbuf);\n630\t        let rem = outlen - (i as usize) * SPX_SHA256_OUTPUT_BYTES;\n631\t        out[o..o + rem].copy_from_slice(&outbuf[..rem]);\n632\t    }\n633\t}\n634\t\n635\t/// mgf1 function based on the SHA-512 hash function.\n636\tpub fn mgf1_512(out: &mut [u8], input: &[u8]) {\n637\t    let outlen = out.len();\n638\t    let inlen = input.len();\n639\t\n640\t    let mut stack_inbuf = [0u8; MGF1_INBUF_CAP];\n641\t    let mut heap_inbuf: Vec<u8>;\n642\t    let inbuf: &mut [u8] = if inlen + 4 <= MGF1_INBUF_CAP {\n643\t        &mut stack_inbuf[..inlen + 4]\n644\t    } else {\n645\t        heap_inbuf = vec![0u8; inlen + 4];\n646\t        &mut heap_inbuf[..]\n647\t    };\n648\t\n649\t    let mut outbuf = [0u8; SPX_SHA512_OUTPUT_BYTES];\n650\t\n651\t    inbuf[..inlen].copy_from_slice(input);\n652\t\n653\t    let mut i: u64 = 0;\n654\t    let mut o: usize = 0;\n655\t\n656\t    /* While we can fit in at least another full block of SHA512 output.. */\n657\t    while ((i as usize) + 1) * SPX_SHA512_OUTPUT_BYTES <= outlen {\n658\t        u32_to_bytes(&mut inbuf[inlen..], i as u32);\n659\t        sha512(&mut out[o..], inbuf);\n660\t        o += SPX_SHA512_OUTPUT_BYTES;\n661\t        i += 1;\n662\t    }\n663\t    /* Until we cannot anymore, and we fill the remainder. */\n664\t    if outlen > (i as usize) * SPX_SHA512_OUTPUT_BYTES {\n665\t        u32_to_bytes(&mut inbuf[inlen..], i as u32);\n666\t        sha512(&mut outbuf, inbuf);\n667\t        let rem = outlen - (i as usize) * SPX_SHA512_OUTPUT_BYTES;\n668\t        out[o..o + rem].copy_from_slice(&outbuf[..rem]);\n669\t    }\n670\t}\n671\t\n672\t// ---------------------------------------------------------------------------\n673\t// seed_state\n674\t// ---------------------------------------------------------------------------\n675\t\n676\t/// Absorb the constant `pub_seed` using one round of the compression function.\n677\t/// This initializes `state_seeded` and `state_seeded_512`, which can then be\n678\t/// reused in `thash`.\n679\tpub fn seed_state(ctx: &mut SpxCtx) {\n680\t    let mut block = [0u8; SPX_SHA512_BLOCK_BYTES];\n681\t\n682\t    for i in 0..SPX_N {\n683\t        block[i] = ctx.pub_seed[i];\n684\t    }\n685\t    for i in SPX_N..SPX_SHA512_BLOCK_BYTES {\n686\t        block[i] = 0;\n687\t    }\n688\t    /* block has been properly initialized for both SHA-256 and SHA-512 */\n689\t\n690\t    sha256_inc_init(&mut ctx.state_seeded);\n691\t    sha256_inc_blocks(&mut ctx.state_seeded, &block, 1);\n692\t    // `#if SPX_SHA512` in `hash_sha2.c`: the field only exists (and is only\n693\t    // seeded) for the 192/256-bit parameter sets.\n694\t    #[cfg(spx_big_hash)]\n695\t    {\