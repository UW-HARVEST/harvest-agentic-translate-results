   crypto_hashblocks_sha256(state, padded, 128);\n551\t    }\n552\t\n553\t    for (size_t i = 0; i < 32; ++i) {\n554\t        out[i] = state[i];\n555\t    }\n556\t\n557\t}\n558\t\n559\tvoid sha512_inc_finalize(uint8_t *out, uint8_t *state, const uint8_t *in, size_t inlen) {\n560\t    uint8_t padded[256];\n561\t    uint64_t bytes = load_bigendian_64(state + 64) + inlen;\n562\t\n563\t    crypto_hashblocks_sha512(state, in, inlen);\n564\t    in += inlen;\n565\t    inlen &= 127;\n566\t    in -= inlen;\n567\t\n568\t    for (size_t i = 0; i < inlen; ++i) {\n569\t        padded[i] = in[i];\n570\t    }\n571\t    padded[inlen] = 0x80;\n572\t\n573\t    if (inlen < 112) {\n574\t        for (size_t i = inlen + 1; i < 119; ++i) {\n575\t            padded[i] = 0;\n576\t        }\n577\t        padded[119] = (uint8_t) (bytes >> 61);\n578\t        padded[120] = (uint8_t) (bytes >> 53);\n579\t        padded[121] = (uint8_t) (bytes >> 45);\n580\t        padded[122] = (uint8_t) (bytes >> 37);\n581\t        padded[123] = (uint8_t) (bytes >> 29);\n582\t        padded[124] = (uint8_t) (bytes >> 21);\n583\t        padded[125] = (uint8_t) (bytes >> 13);\n584\t        padded[126] = (uint8_t) (bytes >> 5);\n585\t        padded[127] = (uint8_t) (bytes << 3);\n586\t        crypto_hashblocks_sha512(state, padded, 128);\n587\t    } else {\n588\t        for (size_t i = inlen + 1; i < 247; ++i) {\n589\t            padded[i] = 0;\n590\t        }\n591\t        padded[247] = (uint8_t) (bytes >> 61);\n592\t        padded[248] = (uint8_t) (bytes >> 53);\n593\t        padded[249] = (uint8_t) (bytes >> 45);\n594\t        padded[250] = (uint8_t) (bytes >> 37);\n595\t        padded[251] = (uint8_t) (bytes >> 29);\n596\t        padded[252] = (uint8_t) (bytes >> 21);\n597\t        padded[253] = (uint8_t) (bytes >> 13);\n598\t        padded[254] = (uint8_t) (bytes >> 5);\n599\t        padded[255] = (uint8_t) (bytes << 3);\n600\t        crypto_hashblocks_sha512(state, padded, 256);\n601\t    }\n602\t\n603\t    for (size_t i = 0; i < 64; ++i) {\n604\t        out[i] = state[i];\n605\t    }\n606\t}\n607\t\n608\tvoid sha256(uint8_t *out, const uint8_t *in, size_t inlen) {\n609\t    uint8_t state[40];\n610\t\n611\t    sha256_inc_init(state);\n612\t    sha256_inc_finalize(out, state, in, inlen);\n613\t}\n614\t\n615\tvoid sha512(uint8_t *out, const uint8_t *in, size_t inlen) {\n616\t    uint8_t state[72];\n617\t\n618\t    sha512_inc_init(state);\n619\t    sha512_inc_finalize(out, state, in, inlen);\n620\t}\n621\t\n622\t/**\n623\t * mgf1 function based on the SHA-256 hash function\n624\t * Note that inlen should be sufficiently small that it still allows for\n625\t * an array to be allocated on the stack. Typically 'in' is merely a seed.\n626\t * Outputs outlen number of bytes\n627\t */\n628\tvoid mgf1_256(unsigned char *out, unsigned long outlen,\n629\t          const unsigned char *in, unsigned long inlen)\n630\t{\n631\t    SPX_VLA(uint8_t, inbuf, inlen+4);\n632\t    unsigned char outbuf[SPX_SHA256_OUTPUT_BYTES];\n633\t    unsigned long i;\n634\t\n635\t    memcpy(inbuf, in, inlen);\n636\t\n637\t    /* While we can fit in at least another full block of SHA256 output.. */\n638\t    for (i = 0; (i+1)*SPX_SHA256_OUTPUT_BYTES <= outlen; i++) {\n639\t        u32_to_bytes(inbuf + inlen, i);\n640\t        sha256(out, inbuf, inlen + 4);\n641\t        out += SPX_SHA256_OUTPUT_BYTES;\n642\t    }\n643\t    /* Until we cannot anymore, and we fill the remainder. */\n644\t    if (outlen > i*SPX_SHA256_OUTPUT_BYTES) {\n645\t        u32_to_bytes(inbuf + inlen, i);\n646\t        sha256(outbuf, inbuf, inlen + 4);\n647\t        memcpy(out, outbuf, outlen - i*SPX_SHA256_OUTPUT_BYTES);\n648\t    }\n649\t}\n650\t\n651\t/*\n652\t * mgf1 function based on the SHA-512 hash function\n653\t */\n654\tvoid mgf1_512(unsigned char *out, unsigned long outlen,\n655\t          const unsigned char *in, unsigned long inlen)\n656\t{\n657\t    SPX_VLA(uint8_t, inbuf, inlen+4);\n658\t    unsigned char outbuf[SPX_SHA512_OUTPUT_BYTES];\n659\t    unsigned long i;\n660\t\n661\t    memcpy(inbuf, in, inlen);\n662\t\n663\t    /* While we can fit in at least another full block of SHA512 output.. */\n664\t    for (i = 0; (i+1)*SPX_SHA512_OUTPUT_BYTES <= outlen; i++) {\n665\t        u32_to_bytes(inbuf + inlen, i);\n666\t        sha512(out, inbuf, inlen + 4);\n667\t        out += SPX_SHA512_OUTPUT_BYTES;\n668\t    }\n669\t    /* Until we cannot anymore, and we fill the remainder. */\n670\t    if (outlen > i*SPX_SHA512_OUTPUT_BYTES) {\n671\t        u32_to_bytes(inbuf + inlen, i);\n672\t        sha512(outbuf, inbuf, inlen + 4);\n673\t        memcpy(out, outbuf, outlen - i*SPX_SHA512_OUTPUT_BYTES);\n674\t    }\n675\t}\n676\t\n677\t\n678\t/**\n679\t * Absorb the constant pub_seed using one round of the compression function\n680\t * This initializes state_seeded and state_seeded_512, which can then be\n681\t * reused in thash\n682\t **/\n683\tvoid seed_state(spx_ctx *ctx) {\n684\t    uint8_t block[SPX_SHA512_BLOCK_BYTES];\n685\t    size_t i;\n686\t\n687\t    for (i = 0; i < SPX_N; ++i) {\n688\t        block[i] = ctx->pub_seed[i];\n689\t    }\n690\t    for (i = SPX_N; i < SPX_SHA512_BLOCK_BYTES; ++i) {\n691\t        block[i] = 0;\n692\t    }\n693\t    /* block has been properly initialized for both SHA-256 and SHA-512 */\n694\t\n695\t    sha256_inc_init(ctx->state_seeded);\n696\t    sha256_inc_blocks(ctx->state_seeded, block, 1);\n697\t#if SPX_SHA512\n698\t    sha512_inc_init(ctx->state_seeded_512);\n699\t    sha512_inc_blocks(ctx->state_seeded_512, block, 1);\n700\t#endif\n701\t}\n702\t"}]},"parent_tool_use_id":"toolu_bdrk_01FLLY3ipeDMFqC3FLTBAHag","session_id":"ea246c20-3a08-49a0-aeed-8ef41fe5c703","uuid":"15394970-d299-4946-88a2-2c9af441f115","timestamp":"2026-09-02T13:26:17.604Z","subagent_type":"general-purpose","task_description":"Review sha2 backend translation"}
