{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Sno8gTo2G6vC52rX8dJH2V","type":"tool_result","content":"1\t//! Translation of `c_src/lib/sha2/src/sha2.c` (+ `c_src/lib/sha2/include/sha2.h`).\n2\t//!\n3\t//! Based on the public domain implementation in `crypto_hash/sha512/ref/` from\n4\t//! <http://bench.cr.yp.to/supercop.html> by D. J. Bernstein.\n5\t\n6\tuse crate::context::SpxCtx;\n7\tuse crate::params::SPX_N;\n8\tuse crate::utils::u32_to_bytes;\n9\t\n10\t// ---------------------------------------------------------------------------\n11\t// sha2.h\n12\t// ---------------------------------------------------------------------------\n13\t\n14\tpub const SPX_SHA256_BLOCK_BYTES: usize = 64;\n15\t/// This does not necessarily equal SPX_N\n16\tpub const SPX_SHA256_OUTPUT_BYTES: usize = 32;\n17\t\n18\tpub const SPX_SHA512_BLOCK_BYTES: usize = 128;\n19\tpub const SPX_SHA512_OUTPUT_BYTES: usize = 64;\n20\t\n21\tpub const SPX_SHA256_ADDR_BYTES: usize = 22;\n22\t\n23\t// ---------------------------------------------------------------------------\n24\t// Load / store helpers\n25\t// ---------------------------------------------------------------------------\n26\t\n27\t#[inline]\n28\tfn load_bigendian_32(x: &[u8]) -> u32 {\n29\t    (x[3] as u32) | ((x[2] as u32) << 8) | ((x[1] as u32) << 16) | ((x[0] as u32) << 24)\n30\t}\n31\t\n32\t#[inline]\n33\tfn load_bigendian_64(x: &[u8]) -> u64 {\n34\t    (x[7] as u64)\n35\t        | ((x[6] as u64) << 8)\n36\t        | ((x[5] as u64) << 16)\n37\t        | ((x[4] as u64) << 24)\n38\t        | ((x[3] as u64) << 32)\n39\t        | ((x[2] as u64) << 40)\n40\t        | ((x[1] as u64) << 48)\n41\t        | ((x[0] as u64) << 56)\n42\t}\n43\t\n44\t#[inline]\n45\tfn store_bigendian_32(x: &mut [u8], u: u64) {\n46\t    let mut u = u;\n47\t    x[3] = u as u8;\n48\t    u >>= 8;\n49\t    x[2] = u as u8;\n50\t    u >>= 8;\n51\t    x[1] = u as u8;\n52\t    u >>= 8;\n53\t    x[0] = u as u8;\n54\t}\n55\t\n56\t#[inline]\n57\tfn store_bigendian_64(x: &mut [u8], u: u64) {\n58\t    let mut u = u;\n59\t    x[7] = u as u8;\n60\t    u >>= 8;\n61\t    x[6] = u as u8;\n62\t    u >>= 8;\n63\t    x[5] = u as u8;\n64\t    u >>= 8;\n65\t    x[4] = u as u8;\n66\t    u >>= 8;\n67\t    x[3] = u as u8;\n68\t    u >>= 8;\n69\t    x[2] = u as u8;\n70\t    u >>= 8;\n71\t    x[1] = u as u8;\n72\t    u >>= 8;\n73\t    x[0] = u as u8;\n74\t}\n75\t\n76\t// ---------------------------------------------------------------------------\n77\t// SHA-2 primitives (macros in the C source)\n78\t// ---------------------------------------------------------------------------\n79\t\n80\t#[inline(always)]\n81\tfn ch_32(x: u32, y: u32, z: u32) -> u32 {\n82\t    (x & y) ^ (!x & z)\n83\t}\n84\t#[inline(always)]\n85\tfn maj_32(x: u32, y: u32, z: u32) -> u32 {\n86\t    (x & y) ^ (x & z) ^ (y & z)\n87\t}\n88\t#[inline(always)]\n89\tfn big_sigma0_32(x: u32) -> u32 {\n90\t    x.rotate_right(2) ^ x.rotate_right(13) ^ x.rotate_right(22)\n91\t}\n92\t#[inline(always)]\n93\tfn big_sigma1_32(x: u32) -> u32 {\n94\t    x.rotate_right(6) ^ x.rotate_right(11) ^ x.rotate_right(25)\n95\t}\n96\t#[inline(always)]\n97\tfn small_sigma0_32(x: u32) -> u32 {\n98\t    x.rotate_right(7) ^ x.rotate_right(18) ^ (x >> 3)\n99\t}\n100\t#[inline(always)]\n101\tfn small_sigma1_32(x: u32) -> u32 {\n102\t    x.rotate_right(17) ^ x.rotate_right(19) ^ (x >> 10)\n103\t}\n104\t\n105\t#[inline(always)]\n106\tfn ch_64(x: u64, y: u64, z: u64) -> u64 {\n107\t    (x & y) ^ (!x & z)\n108\t}\n109\t#[inline(always)]\n110\tfn maj_64(x: u64, y: u64, z: u64) -> u64 {\n111\t    (x & y) ^ (x & z) ^ (y & z)\n112\t}\n113\t#[inline(always)]\n114\tfn big_sigma0_64(x: u64) -> u64 {\n115\t    x.rotate_right(28) ^ x.rotate_right(34) ^ x.rotate_right(39)\n116\t}\n117\t#[inline(always)]\n118\tfn big_sigma1_64(x: u64) -> u64 {\n119\t    x.rotate_right(14) ^ x.rotate_right(18) ^ x.rotate_right(41)\n120\t}\n121\t#[inline(always)]\n122\tfn small_sigma0_64(x: u64) -> u64 {\n123\t    x.rotate_right(1) ^ x.rotate_right(8) ^ (x >> 7)\n124\t}\n125\t#[inline(always)]\n126\tfn small_sigma1_64(x: u64) -> u64 {\n127\t    x.rotate_right(19) ^ x.rotate_right(61) ^ (x >> 6)\n128\t}\n129\t\n130\t/// The 64 SHA-256 round constants, in the order in which the `F_32` macro is\n131\t/// invoked in the C source.\n132\tconst K_256: [u32; 64] = [\n133\t    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,\n134\t    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,\n135\t    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,\n136\t    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,\n137\t    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,\n138\t    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,\n139\t    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,\n140\t    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,\n141\t];\n142\t\n143\t/// The 80 SHA-512 round constants, in the order in which the `F_64` macro is\n144\t/// invoked in the C source.\n145\tconst K_512: [u64; 80] = [\n146\t    0x428a2f98d728ae22,\n147\t    0x7137449123ef65cd,\n148\t    0xb5c0fbcfec4d3b2f,\n149\t    0xe9b5dba58189dbbc,\n150\t    0x3956c25bf348b538,\n151\t    0x59f111f1b605d019,\n152\t    0x923f82a4af194f9b,\n153\t    0xab1c5ed5da6d8118,\n154\t    0xd807aa98a3030242,\n155\t    0x12835b0145706fbe,\n156\t    0x243185be4ee4b28c,\n157\t    0x550c7dc3d5ffb4e2,\n158\t    0x72be5d74f27b896f,\n159\t    0x80deb1fe3b1696b1,\n160\t    0x9bdc06a725c71235,\n161\t    0xc19bf174cf692694,\n162\t    0xe49b69c19ef14ad2,\n163\t    0xefbe4786384f25e3,\n164\t    0x0fc19dc68b8cd5b5,\n165\t    0x240ca1cc77ac9c65,\n166\t    0x2de92c6f592b0275,\n167\t    