to do whatever\n   116\t       preparation or computation it needs, based on the public seed. */\n   117\t    initialize_hash_function(&ctx);\n   118\t\n   119\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n   120\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n   121\t\n   122\t    /* Optionally, signing can be made non-deterministic using optrand.\n   123\t       This can help counter side-channel attacks that would benefit from\n   124\t       getting a large number of traces when the signer uses the same nodes. */\n   125\t    randombytes(optrand, SPX_N);\n   126\t    /* Compute the digest randomization value. */\n   127\t    gen_message_random(sig, sk_prf, optrand, m, mlen, &ctx);\n   128\t\n   129\t    /* Derive the message digest and leaf index from R, PK and M. */\n   130\t    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);\n   131\t    sig += SPX_N;\n   132\t\n   133\t    set_tree_addr(wots_addr, tree);\n   134\t    set_keypair_addr(wots_addr, idx_leaf);\n   135\t\n   136\t    /* Sign the message hash using FORS. */\n   137\t    fors_sign(sig, root, mhash, &ctx, wots_addr);\n   138\t    sig += SPX_FORS_BYTES;\n   139\t\n   140\t    for (i = 0; i < SPX_D; i++) {\n   141\t        set_layer_addr(tree_addr, i);\n   142\t        set_tree_addr(tree_addr, tree);\n   143\t\n   144\t        copy_subtree_addr(wots_addr, tree_addr);\n   145\t        set_keypair_addr(wots_addr, idx_leaf);\n   146\t\n   147\t        merkle_sign(sig, root, &ctx, wots_addr, tree_addr, idx_leaf);\n   148\t        sig += SPX_WOTS_BYTES + SPX_TREE_HEIGHT * SPX_N;\n   149\t\n   150\t        /* Update the indices for the next layer. */\n   151\t        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));\n   152\t        tree = tree >> SPX_TREE_HEIGHT;\n   153\t    }\n   154\t\n   155\t    *siglen = SPX_BYTES;\n   156\t\n   157\t    return 0;\n   158\t}\n   159\t\n   160\t/**\n   161\t * Verifies a detached signature and message under a given public key.\n   162\t */\n   163\tint crypto_sign_verify(const uint8_t *sig, size_t siglen,\n   164\t                       const uint8_t *m, size_t mlen, const uint8_t *pk)\n   165\t{\n   166\t    spx_ctx ctx;\n   167\t    const unsigned char *pub_root = pk + SPX_N;\n   168\t    unsigned char mhash[SPX_FORS_MSG_BYTES];\n   169\t    unsigned char wots_pk[SPX_WOTS_BYTES];\n   170\t    unsigned char root[SPX_N];\n   171\t    unsigned char leaf[SPX_N];\n   172\t    unsigned int i;\n   173\t    uint64_t tree;\n   174\t    uint32_t idx_leaf;\n   175\t    uint32_t wots_addr[8] = {0};\n   176\t    uint32_t tree_addr[8] = {0};\n   177\t    uint32_t wots_pk_addr[8] = {0};\n   178\t\n   179\t    if (siglen != SPX_BYTES) {\n   180\t        return -1;\n   181\t    }\n   182\t\n   183\t    memcpy(ctx.pub_seed, pk, SPX_N);\n   184\t\n   185\t    /* This hook allows the hash function instantiation to do whatever\n   186\t       preparation or computation it needs, based on the public seed. */\n   187\t    initialize_hash_function(&ctx);\n   188\t\n   189\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n   190\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n   191\t    set_type(wots_pk_addr, SPX_ADDR_TYPE_WOTSPK);\n   192\t\n   193\t    /* Derive the message digest and leaf index from R || PK || M. */\n   194\t    /* The additional SPX_N is a result of the hash domain separator. */\n   195\t    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);\n   196\t    sig += SPX_N;\n   197\t\n   198\t    /* Layer correctly defaults to 0, so no need to set_layer_addr */\n   199\t    set_tree_addr(wots_addr, tree);\n   200\t    set_keypair_addr(wots_addr, idx_leaf);\n   201\t\n   202\t    fors_pk_from_sig(root, sig, mhash, &ctx, wots_addr);\n   203\t    sig += SPX_FORS_BYTES;\n   204\t\n   205\t    /* For each subtree.. */\n   206\t    for (i = 0; i < SPX_D; i++) {\n   207\t        set_layer_addr(tree_addr, i);\n   208\t        set_tree_addr(tree_addr, tree);\n   209\t\n   210\t        copy_subtree_addr(wots_addr, tree_addr);\n   211\t        set_keypair_addr(wots_addr, idx_leaf);\n   212\t\n   213\t        copy_keypair_addr(wots_pk_addr, wots_addr);\n   214\t\n   215\t        /* The WOTS public key is only correct if the signature was correct. */\n   216\t        /* Initially, root is the FORS pk, but on subsequent iterations it is\n   217\t           the root of the subtree below the currently processed subtree. */\n   218\t        wots_pk_from_sig(wots_pk, sig, root, &ctx, wots_addr);\n   219\t        sig += SPX_WOTS_BYTES;\n   220\t\n   221\t        /* Compute the leaf node using the WOTS public key. */\n   222\t        thash(leaf, wots_pk, SPX_WOTS_LEN, &ctx, wots_pk_addr);\n   223\t\n   224\t        /* Compute the root node of this subtree. */\n   225\t        compute_root(root, leaf, idx_leaf, 0, sig, SPX_TREE_HEIGHT,\n   226\t                     &ctx, tree_addr);\n   227\t        sig += SPX_TREE_HEIGHT * SPX_N;\n   228\t\n   229\t        /* Update the indices for the next layer. */\n   230\t        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));\n   231\t        tree = tree >> SPX_TREE_HEIGHT;\n   232\t    }\n   233\t\n   234\t    /* Check if the root node equals the root node in the public key. */\n   235\t    if (memcmp(root, pub_root, SPX_N)) {\n   236\t        return -1;\n   237\t    }\n   238\t\n   239\t    return 0;\n   240\t}\n   241\t\n   242\t\n   243\t/**\n   244\t * Returns an array containing the signature followed by the message.\n   245\t */\n   246\tint crypto_sign(unsigned char *sm, unsigned long long *smlen,\n   247\t                const unsigned char *m, unsigned long long mlen,\n   248\t                const unsigned char *sk)\n   249\t{\n   250\t    size_t siglen;\n   251\t\n   252\t    crypto_sign_signature(sm, &siglen, m, (size_t)mlen, sk);\n   253\t\n   254\t    memmove(sm + SPX_BYTES, m, mlen);\n   255\t    *smlen = siglen + mlen;\n   256\t\n   257\t    return 0;\n   258\t}\n   259\t\n   260\t/**\n   261\t * Verifies a given signature-message pair under a given public key.\n   262\t */\n   263\tint crypto_sign_open(unsigned char *m, unsigned long long *mlen,\n   264\t                     const unsigned char *sm, unsigned long long smlen,\n   265\t                     const unsigned char *pk)\n   266\t{\n   267\t    /* The API caller does not necessarily know what size a signature should be\n   268\t       but SPHINCS+ signatures are always exactly SPX_BYTES. */\n   269\t    if (smlen < SPX_BYTES) {\n   270\t        memset(m, 0, smlen);\n   271\t        *mlen = 0;\n   272\t        return -1;\n   273\t    }\n   274\t\n   275\t    *mlen = smlen - SPX_BYTES;\n   276\t\n   277\t    if (crypto_sign_verify(sm, SPX_BYTES, sm + SPX_BYTES, (size_t)*mlen, pk)) {\n   278\t        memset(m, 0, smlen);\n   279\t        *mlen = 0;\n   280\t        return -1;\n   281\t    }\n   282\t\n   283\t    /* If verification was successful, move the message to the right place. */\n   284\t    memmove(m, sm + SPX_BYTES, *mlen);\n   285\t\n   286\t    return 0;\n   287\t}\n===== src/utils.c =====\n     1\t#include <string.h>\n     2\t\n     3\t#include \"../include/address.h\"\n     4\t#include \"../include/hash.h\"\n     5\t#include \"../include/params.h\"\n     6\t#include \"../include/thash.h\"\n     7\t#include \"../include/utils.h\"\n     8\t\n     9\t/**\n    10\t * Converts the value of 'in' to 'outlen' bytes in big-endian byte order.\n    11\t */\n    12\tvoid ull_to_bytes(unsigned char *out, unsigned int outlen,\n    13\t                  unsigned long long in)\n    14\t{\n    15\t    int i;\n    16\t\n    17\t    /* Iterate over out in decreasing order, for big-endianness. */\n    18\t    for (i = (signed int)outlen - 1; i >= 0; i--) {\n    19\t        out[i] = in & 0xff;\n    20\t        in = in >> 8;\n    21\t    }\n    22\t}\n    23\t\n    24\tvoid u32_to_bytes(unsigned char *out, uint32_t in)\n    25\t{\n    26\t    out[0] = (unsigned char)(in >> 24);\n    27\t    out[1] = (unsigned char)(in >> 16);\n    28\t    out[2] = (unsigned char)(in >> 8);\n    29\t    out[3] = (unsigned char)in;\n    30\t}\n    31\t\n    32\t/**\n    33\t * Converts the inlen bytes in 'in' from big-endian byte order to an integer.\n    34\t */\n    35\tunsigned long long bytes_to_ull(const unsigned char *in, unsigned int inlen)\n    36\t{\n    37\t    unsigned long long retval = 0;\n    38\t    unsigned int i;\n    39\t\n    40\t    for (i = 0; i < inlen; i++) {\n    41\t        retval |= ((unsigned long long)in[i]) << (8*(inlen - 1 - i));\n    42\t    }\n    43\t    return retval;\n    44\t}\n    45\t\n    46\t/**\n    47\t * Computes a root node given a leaf and an auth path.\n    48\t * Expects address to be complete other than the tree_height and tree_index.\n    49\t */\n    50\tvoid compute_root(unsigned char *root, const unsigned char *leaf,\n    51\t                  uint32_t leaf_idx, uint32_t idx_offset,\n    52\t                  const unsigned char *auth_path, uint32_t tree_height,\n    53\t                  const spx_ctx *ctx, uint32_t addr[8])\n    54\t{\n    55\t    uint32_t i;\n    56\t    unsigned char buffer[2 * SPX_N];\n    57\t\n    58\t    /* If leaf_idx is odd (last bit = 1), current path element is a right child\n    59\t       and auth_path has to go left. Otherwise it is the other way around. */\n    60\t    if (leaf_idx & 1) {\n    61\t        memcpy(buffer + SPX_N, leaf, SPX_N);\n    62\t        memcpy(buffer, auth_path, SPX_N);\n    63\t    }\n    64\t    else {\n    65\t        memcpy(buffer, leaf, SPX_N);\n    66\t        memcpy(buffer + SPX_N, auth_path, SPX_N);\n    67\t    }\n    68\t    auth_path += SPX_N;\n    69\t\n    70\t    for (i = 0; i < tree_height - 1; i++) {\n    71\t        leaf_idx >>= 1;\n    72\t        idx_offset >>= 1;\n    73\t        /* Set the address of the node we're creating. */\n    74\t        set_tree_height(addr, i + 1);\n    75\t        set_tree_index(addr, leaf_idx + idx_offset);\n    76\t\n    77\t        /* Pick the right or left neighbor, depending on parity of the node. */\n    78\t        if (leaf_idx & 1) {\n    79\t            thash(buffer + SPX_N, buffer, 2, ctx, addr);\n    80\t            memcpy(buffer, auth_path, SPX_N);\n    81\t        }\n    82\t        else {\n    83\t            thash(buffer, buffer, 2, ctx, addr);\n    84\t            memcpy(buffer + SPX_N, auth_path, SPX_N);\n    85\t        }\n    86\t        auth_path += SPX_N;\n    87\t    }\n    88\t\n    89\t    /* The last iteration is exceptional; we do not copy an auth_path node. */\n    90\t    leaf_idx >>= 1;\n    91\t    idx_offset >>= 1;\n    92\t    set_tree_height(addr, tree_height);\n    93\t    set_tree_index(addr, leaf_idx + idx_offset);\n    94\t    thash(root, buffer, 2, ctx, addr);\n    95\t}\n    96\t\n    97\t/**\n    98\t * For a given leaf index, computes the authentication path and the resulting\n    99\t * root node using Merkle's TreeHash algorithm.\n   100\t * Expects the layer and tree parts of the tree_addr to be set, as well as the\n   101\t * tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE).\n   102\t * Applies the offset idx_offset to indices before building addresses, so that\n   103\t * it is possible to continue counting indices across trees.\n   104\t */\n   105\tvoid treehash(unsigned char *root, unsigned char *auth_path, const spx_ctx* ctx,\n   106\t              uint32_t leaf_idx, uint32_t idx_offset, uint32_t tree_height,\n   107\t              void (*gen_leaf)(\n   108\t                 unsigned char* /* leaf */,\n   109\t                 const spx_ctx* /* ctx */,\n   110\t                 uint32_t /* addr_idx */, const uint32_t[8] /* tree_addr */),\n   111\t              uint32_t tree_addr[8])\n   112\t{\n   113\t    SPX_VLA(uint8_t, stack, (tree_height+1)*SPX_N);\n   114\t    SPX_VLA(unsigned int, heights, tree_height+1);\n   115\t    unsigned int offset = 0;\n   116\t    uint32_t idx;\n   117\t    uint32_t tree_idx;\n   118\t\n   119\t    for (idx = 0; idx < (uint32_t)(1 << tree_height); idx++) {\n   120\t        /* Add the next leaf node to the stack. */\n   121\t        gen_leaf(stack + offset*SPX_N, ctx, idx + idx_offset, tree_addr);\n   122\t        offset++;\n   123\t        heights[offset - 1] = 0;\n   124\t\n   125\t        /* If this is a node we need for the auth path.. */\n   126\t        if ((leaf_idx ^ 0x1) == idx) {\n   127\t            memcpy(auth_path, stack + (offset - 1)*SPX_N, SPX_N);\n   128\t        }\n   129\t\n   130\t        /* While the top-most nodes are of equal height.. */\n   131\t        while (offset >= 2 && heights[offset - 1] == heights[offset - 2]) {\n   132\t            /* Compute index of the new node, in the next layer. */\n   133\t            tree_idx = (idx >> (heights[offset - 1] + 1));\n   134\t\n   135\t            /* Set the address of the node we're creating. */\n   136\t            set_tree_height(tree_addr, heights[offset - 1] + 1);\n   137\t            set_tree_index(tree_addr,\n   138\t                           tree_idx + (idx_offset >> (heights[offset-1] + 1)));\n   139\t            /* Hash the top-most nodes from the stack together. */\n   140\t            thash(stack + (offset - 2)*SPX_N,\n   141\t                  stack + (offset - 2)*SPX_N, 2, ctx, tree_addr);\n   142\t            offset--;\n   143\t            /* Note that the top-most node is now one layer higher. */\n   144\t            heights[offset - 1]++;\n   145\t\n   146\t            /* If this is a node we need for the auth path.. */\n   147\t            if (((leaf_idx >> heights[offset - 1]) ^ 0x1) == tree_idx) {\n   148\t                memcpy(auth_path + heights[offset - 1]*SPX_N,\n   149\t                       stack + (offset - 1)*SPX_N, SPX_N);\n   150\t            }\n   151\t        }\n   152\t    }\n   153\t    memcpy(root, stack, SPX_N);\n   154\t}\n===== src/utilsx1.c =====\n     1\t#include <string.h>\n     2\t\n     3\t#include \"../include/address.h\"\n     4\t#include \"../include/params.h\"\n     5\t#include \"../include/forsx1.h\"\n     6\t#include \"../include/thash.h\"\n     7\t#include \"../include/utils.h\"\n     8\t#include \"../include/utilsx1.h\"\n     9\t\n    10\t/*\n    11\t * Generate the entire Merkle tree, computing the authentication path for\n    12\t * leaf_idx, and the resulting root node using Merkle's TreeHash algorithm.\n    13\t * Expects the layer and tree parts of the tree_addr to be set, as well as the\n    14\t * tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE)\n    15\t *\n    16\t * This expects tree_addr to be initialized to the addr structures for the\n    17\t * Merkle tree nodes\n    18\t *\n    19\t * Applies the offset idx_offset to indices before building addresses, so that\n    20\t * it is possible to continue counting indices across trees.\n    21\t *\n    22\t * This works by using the standard Merkle tree building algorithm,\n    23\t */\n    24\tvoid wots_treehashx1(unsigned char *root, unsigned char *auth_path,\n    25\t\t\t     const spx_ctx* ctx,\n    26\t\t\t     uint32_t leaf_idx, uint32_t idx_offset,\n    27\t\t\t     uint32_t tree_height,\n    28\t\t\t     uint32_t tree_addr[8],\n    29\t\t\t     leaf_info_x1 *info)\n    30\t{\n    31\t    /* This is where we keep the intermediate nodes */\n    32\t    SPX_VLA(uint8_t, stack, tree_height*SPX_N);\n    33\t\n    34\t    uint32_t idx;\n    35\t    uint32_t max_idx = (uint32_t)((1 << tree_height) - 1);\n    36\t    for (idx = 0;; idx++) {\n    37\t        unsigned char current[2*SPX_N];   /* Current logical node is at */\n    38\t            /* index[SPX_N].  We do this to minimize the number of copies */\n    39\t            /* needed during a thash */\n    40\t        wots_gen_leafx1( &current[SPX_N], ctx, idx + idx_offset,\n    41\t\t\t\t info );\n    42\t\n    43\t        /* Now combine the freshly generated right node with previously */\n    44\t        /* generated left ones */\n    45\t        uint32_t internal_idx_offset = idx_offset;\n    46\t        uint32_t internal_idx = idx;\n    47\t        uint32_t internal_leaf = leaf_idx;\n    48\t        uint32_t h;     /* The height we are in the Merkle tree */\n    49\t        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {\n    50\t\n    51\t            /* Check if we hit the top of the tree */\n    52\t            if (h == tree_height) {\n    53\t                /* We hit the root; return it */\n    54\t                memcpy( root, &current[SPX_N], SPX_N );\n    55\t                return;\n    56\t            }\n    57\t\n    58\t            /*\n    59\t             * Check if the node we have is a part of the\n    60\t             * authentication path; if it is, write it out\n    61\t             */\n    62\t            if ((internal_idx ^ internal_leaf) == 0x01) {\n    63\t                memcpy( &auth_path[ h * SPX_N ],\n    64\t                        &current[SPX_N],\n    65\t                        SPX_N );\n    66\t            }\n    67\t\n    68\t            /*\n    69\t             * Check if we're at a left child; if so, stop going up the stack\n    70\t             * Exception: if we've reached the end of the tree, keep on going\n    71\t             * (so we combine the last 4 nodes into the one root node in two\n    72\t             * more iterations)\n    73\t             */\n    74\t            if ((internal_idx & 1) == 0 && idx < max_idx) {\n    75\t                break;\n    76\t            }\n    77\t\n    78\t            /* Ok, we're at a right node */\n    79\t            /* Now combine the left and right logical nodes together */\n    80\t\n    81\t            /* Set the address of the node we're creating. */\n    82\t            internal_idx_offset >>= 1;\n    83\t            set_tree_height(tree_addr, h + 1);\n    84\t            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\n    85\t\n    86\t            unsigned char *left = &stack[h * SPX_N];\n    87\t            memcpy( &current[0], left, SPX_N );\n    88\t            thash( &current[1 * SPX_N],\n    89\t                   &current[0 * SPX_N],\n    90\t                   2, ctx, tree_addr);\n    91\t        }\n    92\t\n    93\t        /* We've hit a left child; save the current for when we get the */\n    94\t        /* corresponding right right */\n    95\t        memcpy( &stack[h * SPX_N], &current[SPX_N], SPX_N);\n    96\t    }\n    97\t}\n    98\t\n    99\tvoid fors_treehashx1(unsigned char *root, unsigned char *auth_path,\n   100\t\t\t     const spx_ctx* ctx,\n   101\t\t\t     uint32_t leaf_idx, uint32_t idx_offset,\n   102\t\t\t     uint32_t tree_height,\n   103\t\t\t     uint32_t tree_addr[8],\n   104\t\t\t     leaf_info_x1 *info)\n   105\t{\n   106\t    /* This is where we keep the intermediate nodes */\n   107\t    SPX_VLA(uint8_t, stack, tree_height*SPX_N);\n   108\t\n   109\t    uint32_t idx;\n   110\t    uint32_t max_idx = (uint32_t)((1 << tree_height) - 1);\n   111\t    for (idx = 0;; idx++) {\n   112\t        unsigned char current[2*SPX_N];   /* Current logical node is at */\n   113\t            /* index[SPX_N].  We do this to minimize the number of copies */\n   114\t            /* needed during a thash */\n   115\t\n   116\t\t// IAN TODO: WARNING ON INFO PARAMETER\n   117\t        fors_gen_leafx1( &current[SPX_N], ctx, idx + idx_offset,\n   118\t\t\t\t info );\n   119\t\n   120\t        /* Now combine the freshly generated right node with previously */\n   121\t        /* generated left ones */\n   122\t        uint32_t internal_idx_offset = idx_offset;\n   123\t        uint32_t internal_idx = idx;\n   124\t        uint32_t internal_leaf = leaf_idx;\n   125\t        uint32_t h;     /* The height we are in the Merkle tree */\n   126\t        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {\n   127\t\n   128\t            /* Check if we hit the top of the tree */\n   129\t            if (h == tree_height) {\n   130\t                /* We hit the root; return it */\n   131\t                memcpy( root, &current[SPX_N], SPX_N );\n   132\t                return;\n   133\t            }\n   134\t\n   135\t            /*\n   136\t             * Check if the node we have is a part of the\n   137\t             * authentication path; if it is, write it out\n   138\t             */\n   139\t            if ((internal_idx ^ internal_leaf) == 0x01) {\n   140\t                memcpy( &auth_path[ h * SPX_N ],\n   141\t                        &current[SPX_N],\n   142\t                        SPX_N );\n   143\t            }\n   144\t\n   145\t            /*\n   146\t             * Check if we're at a left child; if so, stop going up the stack\n   147\t             * Exception: if we've reached the end of the tree, keep on going\n   148\t             * (so we combine the last 4 nodes into the one root node in two\n   149\t             * more iterations)\n   150\t             */\n   151\t            if ((internal_idx & 1) == 0 && idx < max_idx) {\n   152\t                break;\n   153\t            }\n   154\t\n   155\t            /* Ok, we're at a right node */\n   156\t            /* Now combine the left and right logical nodes together */\n   157\t\n   158\t            /* Set the address of the node we're creating. */\n   159\t            internal_idx_offset >>= 1;\n   160\t            set_tree_height(tree_addr, h + 1);\n   161\t            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\n   162\t\n   163\t            unsigned char *left = &stack[h * SPX_N];\n   164\t            memcpy( &current[0], left, SPX_N );\n   165\t            thash( &current[1 * SPX_N],\n   166\t                   &current[0 * SPX_N],\n   167\t                   2, ctx, tree_addr);\n   168\t        }\n   169\t\n   170\t        /* We've hit a left child; save the current for when we get the */\n   171\t        /* corresponding right right */\n   172\t        memcpy( &stack[h * SPX_N], &current[SPX_N], SPX_N);\n   173\t    }\n   174\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"6f585a29-7725-4f54-ba8d-bf3ce186bd20","uuid":"76c678f5-4eb6-49d8-977c-146a66fd9e0e","timestamp":"2026-08-29T14:51:56.773Z","tool_use_result":{"stdout":"===== src/sign.c =====\n     1\t#include <stddef.h>\n     2\t#include <string.h>\n     3\t#include <stdint.h>\n     4\t\n     5\t#include \"../include/address.h\"\n     6\t#include \"../include/api.h\"\n     7\t#include \"../include/fors.h\"\n     8\t#include \"../include/hash.h\"\n     9\t#include \"../include/merkle.h\"\n    10\t#include \"../include/params.h\"\n    11\t#include \"../include/randombytes.h\"\n    12\t#include \"../include/thash.h\"\n    13\t#include \"../include/utils.h\"\n    14\t#include \"../include/wots.h\"\n    15\t\n    16\t/*\n    17\t * Returns the length of a secret key, in bytes\n    18\t */\n    19\tunsigned long long crypto_sign_secretkeybytes(void)\n    20\t{\n    21\t    return CRYPTO_SECRETKEYBYTES;\n    22\t}\n    23\t\n    24\t/*\n    25\t * Returns the length of a public key, in bytes\n    26\t */\n    27\tunsigned long long crypto_sign_publickeybytes(void)\n    28\t{\n    29\t    return CRYPTO_PUBLICKEYBYTES;\n    30\t}\n    31\t\n    32\t/*\n    33\t * Returns the length of a signature, in bytes\n    34\t */\n    35\tunsigned long long crypto_sign_bytes(void)\n    36\t{\n    37\t    return CRYPTO_BYTES;\n    38\t}\n    39\t\n    40\t/*\n    41\t * Returns the length of the seed required to generate a key pair, in bytes\n    42\t */\n    43\tunsigned long long crypto_sign_seedbytes(void)\n    44\t{\n    45\t    return CRYPTO_SEEDBYTES;\n    46\t}\n    47\t\n    48\t/*\n    49\t * Generates an SPX key pair given a seed of length\n    50\t * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]\n    51\t * Format pk: [PUB_SEED || root]\n    52\t */\n    53\tint crypto_sign_seed_keypair(unsigned char *pk, unsigned char *sk,\n    54\t                             const unsigned char *seed)\n    55\t{\n    56\t    spx_ctx ctx;\n    57\t\n    58\t    /* Initialize SK_SEED, SK_PRF and PUB_SEED from seed. */\n    59\t    memcpy(sk, seed, CRYPTO_SEEDBYTES);\n    60\t\n    61\t    memcpy(pk, sk + 2*SPX_N, SPX_N);\n    62\t\n    63\t    memcpy(ctx.pub_seed, pk, SPX_N);\n    64\t    memcpy(ctx.sk_seed, sk, SPX_N);\n    65\t\n    66\t    /* This hook allows the hash function instantiation to do whatever\n    67\t       preparation or computation it needs, based on the public seed. */\n    68\t    initialize_hash_function(&ctx);\n    69\t\n    70\t    /* Compute root node of the top-most subtree. */\n    71\t    merkle_gen_root(sk + 3*SPX_N, &ctx);\n    72\t\n    73\t    memcpy(pk + SPX_N, sk + 3*SPX_N, SPX_N);\n    74\t\n    75\t    return 0;\n    76\t}\n    77\t\n    78\t/*\n    79\t * Generates an SPX key pair.\n    80\t * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]\n    81\t * Format pk: [PUB_SEED || root]\n    82\t */\n    83\tint crypto_sign_keypair(unsigned char *pk, unsigned char *sk)\n    84\t{\n    85\t  unsigned char seed[CRYPTO_SEEDBYTES];\n    86\t  randombytes(seed, CRYPTO_SEEDBYTES);\n    87\t  crypto_sign_seed_keypair(pk, sk, seed);\n    88\t\n    89\t  return 0;\n    90\t}\n    91\t\n    92\t/**\n    93\t * Returns an array containing a detached signature.\n    94\t */\n    95\tint crypto_sign_signature(uint8_t *sig, size_t *siglen,\n    96\t                          const uint8_t *m, size_t mlen, const uint8_t *sk)\n    97\t{\n    98\t    spx_ctx ctx;\n    99\t\n   100\t    const unsigned char *sk_prf = sk + SPX_N;\n   101\t    const unsigned char *pk = sk + 2*SPX_N;\n   102\t\n   103\t    unsigned char optrand[SPX_N];\n   104\t    unsigned char mhash[SPX_FORS_MSG_BYTES];\n   105\t    unsigned char root[SPX_N];\n   106\t    uint32_t i;\n   107\t    uint64_t tree;\n   108\t    uint32_t idx_leaf;\n   109\t    uint32_t wots_addr[8] = {0};\n   110\t    uint32_t tree_addr[8] = {0};\n   111\t\n   112\t    memcpy(ctx.sk_seed, sk, SPX_N);\n   113\t    memcpy(ctx.pub_seed, pk, SPX_N);\n   114\t\n   115\t    /* This hook allows the hash function instantiation to do whatever\n   116\t       preparation or computation it needs, based on the public seed. */\n   117\t    initialize_hash_function(&ctx);\n   118\t\n   119\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n   120\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n   121\t\n   122\t    /* Optionally, signing can be made non-deterministic using optrand.\n   123\t       This can help counter side-channel attacks that would benefit from\n   124\t       getting a large number of traces when the signer uses the same nodes. */\n   125\t    randombytes(optrand, SPX_N);\n   126\t    /* Compute the digest randomization value. */\n   127\t    gen_message_random(sig, sk_prf, optrand, m, mlen, &ctx);\n   128\t\n   129\t    /* Derive the message digest and leaf index from R, PK and M. */\n   130\t    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);\n   131\t    sig += SPX_N;\n   132\t\n   133\t    set_tree_addr(wots_addr, tree);\n   134\t    set_keypair_addr(wots_addr, idx_leaf);\n   135\t\n   136\t    /* Sign the message hash using FORS. */\n   137\t    fors_sign(sig, root, mhash, &ctx, wots_addr);\n   138\t    sig += SPX_FORS_BYTES;\n   139\t\n   140\t    for (i = 0; i < SPX_D; i++) {\n   141\t        set_layer_addr(tree_addr, i);\n   142\t        set_tree_addr(tree_addr, tree);\n   143\t\n   144\t        copy_subtree_addr(wots_addr, tree_addr);\n   145\t        set_keypair_addr(wots_addr, idx_leaf);\n   146\t\n   147\t        merkle_sign(sig, root, &ctx, wots_addr, tree_addr, idx_leaf);\n   148\t        sig += SPX_WOTS_BYTES + SPX_TREE_HEIGHT * SPX_N;\n   149\t\n   150\t        /* Update the indices for the next layer. */\n   151\t        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));\n   152\t        tree = tree >> SPX_TREE_HEIGHT;\n   153\t    }\n   154\t\n   155\t    *siglen = SPX_BYTES;\n   156\t\n   157\t    return 0;\n   158\t}\n   159\t\n   160\t/**\n   161\t * Verifies a detached signature and message under a given public key.\n   162\t */\n   163\tint crypto_sign_verify(const uint8_t *sig, size_t siglen,\n   164\t                       const uint8_t *m, size_t mlen, const uint8_t *pk)\n   165\t{\n   166\t    spx_ctx ctx;\n   167\t    const unsigned char *pub_root = pk + SPX_N;\n   168\t    unsigned char mhash[SPX_FORS_MSG_BYTES];\n   169\t    unsigned char wots_pk[SPX_WOTS_BYTES];\n   170\t    unsigned char root[SPX_N];\n   171\t    unsigned char leaf[SPX_N];\n   172\t    unsigned int i;\n   173\t    uint64_t tree;\n   174\t    uint32_t idx_leaf;\n   175\t    uint32_t wots_addr[8] = {0};\n   176\t    uint32_t tree_addr[8] = {0};\n   177\t    uint32_t wots_pk_addr[8] = {0};\n   178\t\n   179\t    if (siglen != SPX_BYTES) {\n   180\t        return -1;\n   181\t    }\n   182\t\n   183\t    memcpy(ctx.pub_seed, pk, SPX_N);\n   184\t\n   185\t    /* This hook allows the hash function instantiation to do whatever\n   186\t       preparation or computation it needs, based on the public seed. */\n   187\t    initialize_hash_function(&ctx);\n   188\t\n   189\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n   190\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n   191\t    set_type(wots_pk_addr, SPX_ADDR_TYPE_WOTSPK);\n   192\t\n   193\t    /* Derive the message digest and leaf index from R || PK || M. */\n   194\t    /* The additional SPX_N is a result of the hash domain separator. */\n   195\t    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);\n   196\t    sig += SPX_N;\n   197\t\n   198\t    /* Layer correctly defaults to 0, so no need to set_layer_addr */\n   199\t    set_tree_addr(wots_addr, tree);\n   200\t    set_keypair_addr(wots_addr, idx_leaf);\n   201\t\n   202\t    fors_pk_from_sig(root, sig, mhash, &ctx, wots_addr);\n   203\t    sig += SPX_FORS_BYTES;\n   204\t\n   205\t    /* For each subtree.. */\n   206\t    for (i = 0; i < SPX_D; i++) {\n   207\t        set_layer_addr(tree_addr, i);\n   208\t        set_tree_addr(tree_addr, tree);\n   209\t\n   210\t        copy_subtree_addr(wots_addr, tree_addr);\n   211\t        set_keypair_addr(wots_addr, idx_leaf);\n   212\t\n   213\t        copy_keypair_addr(wots_pk_addr, wots_addr);\n   214\t\n   215\t        /* The WOTS public key is only correct if the signature was correct. */\n   216\t        /* Initially, root is the FORS pk, but on subsequent iterations it is\n   217\t           the root of the subtree below the currently processed subtree. */\n   218\t        wots_pk_from_sig(wots_pk, sig, root, &ctx, wots_addr);\n   219\t        sig += SPX_WOTS_BYTES;\n   220\t\n   221\t        /* Compute the leaf node using the WOTS public key. */\n   222\t        thash(leaf, wots_pk, SPX_WOTS_LEN, &ctx, wots_pk_addr);\n   223\t\n   224\t        /* Compute the root node of this subtree. */\n   225\t        compute_root(root, leaf, idx_leaf, 0, sig, SPX_TREE_HEIGHT,\n   226\t                     &ctx, tree_addr);\n   227\t        sig += SPX_TREE_HEIGHT * SPX_N;\n   228\t\n   229\t        /* Update the indices for the next layer. */\n   230\t        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));\n   231\t        tree = tree >> SPX_TREE_HEIGHT;\n   232\t    }\n   233\t\n   234\t    /* Check if the root node equals the root node in the public key. */\n   235\t    if (memcmp(root, pub_root, SPX_N)) {\n   236\t        return -1;\n   237\t    }\n   238\t\n   239\t    return 0;\n   240\t}\n   241\t\n   242\t\n   243\t/**\n   244\t * Returns an array containing the signature followed by the message.\n   245\t */\n   246\tint crypto_sign(unsigned char *sm, unsigned long long *smlen,\n   247\t                const unsigned char *m, unsigned long long mlen,\n   248\t                const unsigned char *sk)\n   249\t{\n   250\t    size_t siglen;\n   251\t\n   252\t    crypto_sign_signature(sm, &siglen, m, (size_t)mlen, sk);\n   253\t\n   254\t    memmove(sm + SPX_BYTES, m, mlen);\n   255\t    *smlen = siglen + mlen;\n   256\t\n   257\t    return 0;\n   258\t}\n   259\t\n   260\t/**\n   261\t * Verifies a given signature-message pair under a given public key.\n   262\t */\n   263\tint crypto_sign_open(unsigned char *m, unsigned long long *mlen,\n   264\t                     const unsigned char *sm, unsigned long long smlen,\n   265\t                     const unsigned char *pk)\n   266\t{\n   267\t    /* The API caller does not necessarily know what size a signature should be\n   268\t       but SPHINCS+ signatures are always exactly SPX_BYTES. */\n   269\t    if (smlen < SPX_BYTES) {\n   270\t        memset(m, 0, smlen);\n   271\t        *mlen = 0;\n   272\t        return -1;\n   273\t    }\n   274\t\n   275\t    *mlen = smlen - SPX_BYTES;\n   276\t\n   277\t    if (crypto_sign_verify(sm, SPX_BYTES, sm + SPX_BYTES, (size_t)*mlen, pk)) {\n   278\t        memset(m, 0, smlen);\n   279\t        *mlen = 0;\n   280\t        return -1;\n   281\t    }\n   282\t\n   283\t    /* If verification was successful, move the message to the right place. */\n   284\t    memmove(m, sm + SPX_BYTES, *mlen);\n   285\t\n   286\t    return 0;\n   287\t}\n===== src/utils.c =====\n     1\t#include <string.h>\n     2\t\n     3\t#include \"../include/address.h\"\n     4\t#include \"../include/hash.h\"\n     5\t#include \"../include/params.h\"\n     6\t#include \"../include/thash.h\"\n     7\t#include \"../include/utils.h\"\n     8\t\n     9\t/**\n    10\t * Converts the value of 'in' to 'outlen' bytes in big-endian byte order.\n    11\t */\n    12\tvoid ull_to_bytes(unsigned char *out, unsigned int outlen,\n    13\t                  unsigned long long in)\n    14\t{\n    15\t    int i;\n    16\t\n    17\t    /* Iterate over out in decreasing order, for big-endianness. */\n    18\t    for (i = (signed int)outlen - 1; i >= 0; i--) {\n    19\t        out[i] = in & 0xff;\n    20\t        in = in >> 8;\n    21\t    }\n    22\t}\n    23\t\n    24\tvoid u32_to_bytes(unsigned char *out, uint32_t in)\n    25\t{\n    26\t    out[0] = (unsigned char)(in >> 24);\n    27\t    out[1] = (unsigned char)(