igned char *out, const unsigned char *in,\n    25\t                      unsigned int start, unsigned int steps,\n    26\t                      const spx_ctx *ctx, uint32_t addr[8])\n    27\t{\n    28\t    uint32_t i;\n    29\t\n    30\t    /* Initialize out with the value at position 'start'. */\n    31\t    memcpy(out, in, SPX_N);\n    32\t\n    33\t    /* Iterate 'steps' calls to the hash function. */\n    34\t    for (i = start; i < (start+steps) && i < SPX_WOTS_W; i++) {\n    35\t        set_hash_addr(addr, i);\n    36\t        thash(out, out, 1, ctx, addr);\n    37\t    }\n    38\t}\n    39\t\n    40\t/**\n    41\t * base_w algorithm as described in draft.\n    42\t * Interprets an array of bytes as integers in base w.\n    43\t * This only works when log_w is a divisor of 8.\n    44\t */\n    45\tstatic void base_w(unsigned int *output, const int out_len,\n    46\t                   const unsigned char *input)\n    47\t{\n    48\t    int in = 0;\n    49\t    int out = 0;\n    50\t    unsigned char total;\n    51\t    int bits = 0;\n    52\t    int consumed;\n    53\t\n    54\t    for (consumed = 0; consumed < out_len; consumed++) {\n    55\t        if (bits == 0) {\n    56\t            total = input[in];\n    57\t            in++;\n    58\t            bits += 8;\n    59\t        }\n    60\t        bits -= SPX_WOTS_LOGW;\n    61\t        output[out] = (total >> bits) & (SPX_WOTS_W - 1);\n    62\t        out++;\n    63\t    }\n    64\t}\n    65\t\n    66\t/* Computes the WOTS+ checksum over a message (in base_w). */\n    67\tstatic void wots_checksum(unsigned int *csum_base_w,\n    68\t                          const unsigned int *msg_base_w)\n    69\t{\n    70\t    unsigned int csum = 0;\n    71\t    unsigned char csum_bytes[(SPX_WOTS_LEN2 * SPX_WOTS_LOGW + 7) / 8];\n    72\t    unsigned int i;\n    73\t\n    74\t    /* Compute checksum. */\n    75\t    for (i = 0; i < SPX_WOTS_LEN1; i++) {\n    76\t        csum += SPX_WOTS_W - 1 - msg_base_w[i];\n    77\t    }\n    78\t\n    79\t    /* Convert checksum to base_w. */\n    80\t    /* Make sure expected empty zero bits are the least significant bits. */\n    81\t    csum = csum << ((8 - ((SPX_WOTS_LEN2 * SPX_WOTS_LOGW) % 8)) % 8);\n    82\t    ull_to_bytes(csum_bytes, sizeof(csum_bytes), csum);\n    83\t    base_w(csum_base_w, SPX_WOTS_LEN2, csum_bytes);\n    84\t}\n    85\t\n    86\t/* Takes a message and derives the matching chain lengths. */\n    87\tvoid chain_lengths(unsigned int *lengths, const unsigned char *msg)\n    88\t{\n    89\t    base_w(lengths, SPX_WOTS_LEN1, msg);\n    90\t    wots_checksum(lengths + SPX_WOTS_LEN1, lengths);\n    91\t}\n    92\t\n    93\t/**\n    94\t * Takes a WOTS signature and an n-byte message, computes a WOTS public key.\n    95\t *\n    96\t * Writes the computed public key to 'pk'.\n    97\t */\n    98\tvoid wots_pk_from_sig(unsigned char *pk,\n    99\t                      const unsigned char *sig, const unsigned char *msg,\n   100\t                      const spx_ctx *ctx, uint32_t addr[8])\n   101\t{\n   102\t    unsigned int lengths[SPX_WOTS_LEN];\n   103\t    uint32_t i;\n   104\t\n   105\t    chain_lengths(lengths, msg);\n   106\t\n   107\t    for (i = 0; i < SPX_WOTS_LEN; i++) {\n   108\t        set_chain_addr(addr, i);\n   109\t        gen_chain(pk + i*SPX_N, sig + i*SPX_N,\n   110\t                  lengths[i], SPX_WOTS_W - 1 - lengths[i], ctx, addr);\n   111\t    }\n   112\t}\n===== src/wotsx1.c =====\n     1\t#include <stdint.h>\n     2\t#include <string.h>\n     3\t\n     4\t#include \"../include/address.h\"\n     5\t#include \"../include/hash.h\"\n     6\t#include \"../include/params.h\"\n     7\t#include \"../include/thash.h\"\n     8\t#include \"../include/utils.h\"\n     9\t#include \"../include/wots.h\"\n    10\t#include \"../include/wotsx1.h\"\n    11\t\n    12\t/*\n    13\t * This generates a WOTS public key\n    14\t * It also generates the WOTS signature if leaf_info indicates\n    15\t * that we're signing with this WOTS key\n    16\t */\n    17\tvoid wots_gen_leafx1(unsigned char *dest,\n    18\t                   const spx_ctx *ctx,\n    19\t                   uint32_t leaf_idx, leaf_info_x1 *v_info) {\n    20\t    struct leaf_info_x1 *info = v_info;\n    21\t    uint32_t *leaf_addr = info->leaf_addr;\n    22\t    uint32_t *pk_addr = info->pk_addr;\n    23\t    unsigned int i, k;\n    24\t    unsigned char pk_buffer[ SPX_WOTS_BYTES ];\n    25\t    unsigned char *buffer;\n    26\t    uint32_t wots_k_mask;\n    27\t\n    28\t    if (leaf_idx == info->wots_sign_leaf) {\n    29\t        /* We're traversing the leaf that's signing; generate the WOTS */\n    30\t        /* signature */\n    31\t        wots_k_mask = 0;\n    32\t    } else {\n    33\t        /* Nope, we're just generating pk's; turn off the signature logic */\n    34\t        wots_k_mask = (uint32_t)~0;\n    35\t    }\n    36\t\n    37\t    set_keypair_addr( leaf_addr, leaf_idx );\n    38\t    set_keypair_addr( pk_addr, leaf_idx );\n    39\t\n    40\t    for (i = 0, buffer = pk_buffer; i < SPX_WOTS_LEN; i++, buffer += SPX_N) {\n    41\t        uint32_t wots_k = info->wots_steps[i] | wots_k_mask; /* Set wots_k to */\n    42\t            /* the step if we're generating a signature, ~0 if we're not */\n    43\t\n    44\t        /* Start with the secret seed */\n    45\t        set_chain_addr(leaf_addr, i);\n    46\t        set_hash_addr(leaf_addr, 0);\n    47\t        set_type(leaf_addr, SPX_ADDR_TYPE_WOTSPRF);\n    48\t\n    49\t        prf_addr(buffer, ctx, leaf_addr);\n    50\t\n    51\t        set_type(leaf_addr, SPX_ADDR_TYPE_WOTS);\n    52\t\n    53\t        /* Iterate down the WOTS chain */\n    54\t        for (k=0;; k++) {\n    55\t            /* Check if this is the value that needs to be saved as a */\n    56\t            /* part of the WOTS signature */\n    57\t            if (k == wots_k) {\n    58\t                memcpy( info->wots_sig + i * SPX_N, buffer, SPX_N );\n    59\t            }\n    60\t\n    61\t            /* Check if we hit the top of the chain */\n    62\t            if (k == SPX_WOTS_W - 1) break;\n    63\t\n    64\t            /* Iterate one step on the chain */\n    65\t            set_hash_addr(leaf_addr, k);\n    66\t\n    67\t            thash(buffer, buffer, 1, ctx, leaf_addr);\n    68\t        }\n    69\t    }\n    70\t\n    71\t    /* Do the final thash to generate the public keys */\n    72\t    thash(dest, pk_buffer, SPX_WOTS_LEN, ctx, pk_addr);\n    73\t}\n===== src/fors.c =====\n     1\t#include <stdlib.h>\n     2\t#include <stdint.h>\n     3\t#include <string.h>\n     4\t\n     5\t#include \"../include/address.h\"\n     6\t#include \"../include/fors.h\"\n     7\t#include \"../include/forsx1.h\"\n     8\t#include \"../include/hash.h\"\n     9\t#include \"../include/thash.h\"\n    10\t#include \"../include/utils.h\"\n    11\t#include \"../include/utilsx1.h\"\n    12\t\n    13\tstatic void fors_gen_sk(unsigned char *sk, const spx_ctx *ctx,\n    14\t                        uint32_t fors_leaf_addr[8])\n    15\t{\n    16\t    prf_addr(sk, ctx, fors_leaf_addr);\n    17\t}\n    18\t\n    19\tstatic void fors_sk_to_leaf(unsigned char *leaf, const unsigned char *sk,\n    20\t                            const spx_ctx *ctx,\n    21\t                            uint32_t fors_leaf_addr[8])\n    22\t{\n    23\t    thash(leaf, sk, 1, ctx, fors_leaf_addr);\n    24\t}\n    25\t\n    26\tvoid fors_gen_leafx1(unsigned char *leaf,\n    27\t                            const spx_ctx *ctx,\n    28\t                            uint32_t addr_idx, fors_gen_leaf_info *info)\n    29\t{\n    30\t    struct fors_gen_leaf_info *fors_info = info;\n    31\t    uint32_t *fors_leaf_addr = fors_info->leaf_addrx;\n    32\t\n    33\t    /* Only set the parts that the caller doesn't set */\n    34\t    set_tree_index(fors_leaf_addr, addr_idx);\n    35\t    set_type(fors_leaf_addr, SPX_ADDR_TYPE_FORSPRF);\n    36\t    fors_gen_sk(leaf, ctx, fors_leaf_addr);\n    37\t\n    38\t    set_type(fors_leaf_addr, SPX_ADDR_TYPE_FORSTREE);\n    39\t    fors_sk_to_leaf(leaf, leaf,\n    40\t                    ctx, fors_leaf_addr);\n    41\t}\n    42\t\n    43\t/**\n    44\t * Interprets m as SPX_FORS_HEIGHT-bit unsigned integers.\n    45\t * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.\n    46\t * Assumes indices has space for SPX_FORS_TREES integers.\n    47\t */\n    48\tstatic void message_to_indices(uint32_t *indices, const unsigned char *m)\n    49\t{\n    50\t    unsigned int i, j;\n    51\t    unsigned int offset = 0;\n    52\t\n    53\t    for (i = 0; i < SPX_FORS_TREES; i++) {\n    54\t        indices[i] = 0;\n    55\t        for (j = 0; j < SPX_FORS_HEIGHT; j++) {\n    56\t            indices[i] ^= ((m[offset >> 3] >> (offset & 0x7)) & 1u) << j;\n    57\t            offset++;\n    58\t        }\n    59\t    }\n    60\t}\n    61\t\n    62\t/**\n    63\t * Signs a message m, deriving the secret key from sk_seed and the FTS address.\n    64\t * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.\n    65\t */\n    66\tvoid fors_sign(unsigned char *sig, unsigned char *pk,\n    67\t               const unsigned char *m,\n    68\t               const spx_ctx *ctx,\n    69\t               const uint32_t fors_addr[8])\n    70\t{\n    71\t    uint32_t indices[SPX_FORS_TREES];\n    72\t    unsigned char roots[SPX_FORS_TREES * SPX_N];\n    73\t    uint32_t fors_tree_addr[8] = {0};\n    74\t    struct fors_gen_leaf_info fors_info = {0};\n    75\t    uint32_t *fors_leaf_addr = fors_info.leaf_addrx;\n    76\t    uint32_t fors_pk_addr[8] = {0};\n    77\t    uint32_t idx_offset;\n    78\t    unsigned int i;\n    79\t\n    80\t    copy_keypair_addr(fors_tree_addr, fors_addr);\n    81\t    copy_keypair_addr(fors_leaf_addr, fors_addr);\n    82\t\n    83\t    copy_keypair_addr(fors_pk_addr, fors_addr);\n    84\t    set_type(fors_pk_addr, SPX_ADDR_TYPE_FORSPK);\n    85\t\n    86\t    message_to_indices(indices, m);\n   