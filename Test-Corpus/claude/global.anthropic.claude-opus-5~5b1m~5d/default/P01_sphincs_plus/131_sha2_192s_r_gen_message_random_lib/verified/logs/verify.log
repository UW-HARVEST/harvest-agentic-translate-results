ut s, m, mlen as u64);\n    50\t        blake256_final(&mut s, &mut scratch);\n    51\t    }\n    52\t    r[..SPX_N].copy_from_slice(&scratch[..SPX_N]);\n    53\t}\n    54\t\n    55\tpub fn hash_message(\n    56\t    digest: &mut [u8],\n    57\t    tree: &mut u64,\n    58\t    leaf_idx: &mut u32,\n    59\t    r: &[u8],\n    60\t    pk: &[u8],\n    61\t    m: &[u8],\n    62\t    _ctx: &SpxCtx,\n    63\t) {\n    64\t    let mut buf = [0u8; SPX_DGST_BYTES];\n    65\t    let mut seed = [0u8; 2 * SPX_N + BLAKEX_OUTPUT];\n    66\t    let mlen = m.len();\n    67\t\n    68\t    if SPX_N >= 24 {\n    69\t        let mut s = BlakeState512::new();\n    70\t        blake512_init(&mut s);\n    71\t        blake512_update(&mut s, &r[..SPX_N], SPX_N as u64);\n    72\t        blake512_update(&mut s, &pk[..SPX_PK_BYTES], SPX_PK_BYTES as u64);\n    73\t        blake512_update(&mut s, m, mlen as u64);\n    74\t        blake512_final(&mut s, &mut seed[2 * SPX_N..]);\n    75\t    } else {\n    76\t        let mut s = BlakeState256::new();\n    77\t        blake256_init(&mut s);\n    78\t        blake256_update(&mut s, &r[..SPX_N], SPX_N as u64);\n    79\t        blake256_update(&mut s, &pk[..SPX_PK_BYTES], SPX_PK_BYTES as u64);\n    80\t        blake256_update(&mut s, m, mlen as u64);\n    81\t        blake256_final(&mut s, &mut seed[2 * SPX_N..]);\n    82\t    }\n    83\t\n    84\t    seed[..SPX_N].copy_from_slice(&r[..SPX_N]);\n    85\t    seed[SPX_N..2 * SPX_N].copy_from_slice(&pk[..SPX_N]);\n    86\t\n    87\t    if SPX_N >= 24 {\n    88\t        blake512_mgf1(&mut buf, SPX_DGST_BYTES, &seed, 2 * SPX_N + BLAKEX_OUTPUT);\n    89\t    } else {\n    90\t        blake256_mgf1(&mut buf, SPX_DGST_BYTES, &seed, 2 * SPX_N + BLAKEX_OUTPUT);\n    91\t    }\n    92\t\n    93\t    digest[..SPX_FORS_MSG_BYTES].copy_from_slice(&buf[..SPX_FORS_MSG_BYTES]);\n    94\t    let mut bufp = SPX_FORS_MSG_BYTES;\n    95\t\n    96\t    if SPX_D == 1 {\n    97\t        *tree = 0;\n    98\t    } else {\n    99\t        *tree = bytes_to_ull(&buf[bufp..], SPX_TREE_BYTES);\n   100\t        *tree &= (!0u64) >> (64 - SPX_TREE_BITS);\n   101\t    }\n   102\t    bufp += SPX_TREE_BYTES;\n   103\t\n   104\t    *leaf_idx = bytes_to_ull(&buf[bufp..], SPX_LEAF_BYTES) as u32;\n   105\t    *leaf_idx &= (!0u32) >> (32 - SPX_LEAF_BITS);\n   106\t}\n   107\t\n   108\t// ------------------------------------------------------------------\n   109\t// Exported C ABI wrappers.\n   110\t// ------------------------------------------------------------------\n   111\t\n   112\t#[no_mangle]\n   113\tpub unsafe extern \"C\" fn SPX_initialize_hash_function(ctx: *mut SpxCtx) {\n   114\t    initialize_hash_function(&mut *ctx);\n   115\t}\n   116\t#[no_mangle]\n   117\tpub unsafe extern \"C\" fn SPX_prf_addr(out: *mut u8, ctx: *const SpxCtx, addr: *const u32) {\n   118\t    prf_addr(core::slice::from_raw_parts_mut(out, SPX_N), &*ctx, &*(addr as *const [u32; 8]));\n   119\t}\n   120\t#[no_mangle]\n   121\tpub unsafe extern \"C\" fn SPX_gen_message_random(\n   122\t    r: *mut u8,\n   123\t    sk_prf: *const u8,\n   124\t    optrand: *const u8,\n   125\t    m: *const u8,\n   126\t    mlen: core::ffi::c_ulonglong,\n   127\t    ctx: *const SpxCtx,\n   128\t) {\n   129\t    gen_message_random(\n   130\t        core::slice::from_raw_parts_mut(r, SPX_N),\n   131\t        core::slice::from_raw_parts(sk_prf, SPX_N),\n   132\t        core::slice::from_raw_parts(optrand, SPX_N),\n   133\t        core::slice::from_raw_parts(m, mlen as usize),\n   134\t        &*ctx,\n   135\t    );\n   136\t}\n   137\t#[no_mangle]\n   138\tpub unsafe extern \"C\" fn SPX_hash_message(\n   139\t    digest: *mut u8,\n   140\t    tree: *mut u64,\n   141\t    leaf_idx: *mut u32,\n   142\t    r: *const u8,\n   143\t    pk: *const u8,\n   144\t    m: *const u8,\n   145\t    mlen: core::ffi::c_ulonglong,\n   146\t    ctx: *const SpxCtx,\n   147\t) {\n   148\t    hash_message(\n   149\t        core::slice::from_raw_parts_mut(digest, SPX_F