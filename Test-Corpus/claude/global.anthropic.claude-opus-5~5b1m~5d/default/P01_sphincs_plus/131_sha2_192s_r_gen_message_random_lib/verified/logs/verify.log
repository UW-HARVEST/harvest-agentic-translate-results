the message around (and\n    65\t * allocate memory for it).\n    66\t */\n    67\tvoid gen_message_random(unsigned char *R, const unsigned char *sk_prf,\n    68\t                        const unsigned char *optrand,\n    69\t                        const unsigned char *m, unsigned long long mlen,\n    70\t                        const spx_ctx *ctx)\n    71\t{\n    72\t    (void)ctx;\n    73\t\n    74\t    unsigned char buf[SPX_SHAX_BLOCK_BYTES + SPX_SHAX_OUTPUT_BYTES];\n    75\t    uint8_t state[8 + SPX_SHAX_OUTPUT_BYTES];\n    76\t    int i;\n    77\t\n    78\t#if SPX_N > SPX_SHAX_BLOCK_BYTES\n    79\t    #error \"Currently only supports SPX_N of at most SPX_SHAX_BLOCK_BYTES\"\n    80\t#endif\n    81\t\n    82\t    /* This implements HMAC-SHA */\n    83\t    for (i = 0; i < SPX_N; i++) {\n    84\t        buf[i] = 0x36 ^ sk_prf[i];\n    85\t    }\n    86\t    memset(buf + SPX_N, 0x36, SPX_SHAX_BLOCK_BYTES - SPX_N);\n    87\t\n    88\t    shaX_inc_init(state);\n    89\t    shaX_inc_blocks(state, buf, 1);\n    90\t\n    91\t    memcpy(buf, optrand, SPX_N);\n    92\t\n    93\t    /* If optrand + message cannot fill up an entire block */\n    94\t    if (SPX_N + mlen < SPX_SHAX_BLOCK_BYTES) {\n    95\t        memcpy(buf + SPX_N, m, mlen);\n    96\t        shaX_inc_finalize(buf + SPX_SHAX_BLOCK_BYTES, state,\n    97\t                            buf, mlen + SPX_N);\n    98\t    }\n    99\t    /* Otherwise first fill a block, so that finalize only uses the message */\n   100\t    else {\n   101\t        memcpy(buf + SPX_N, m, SPX_SHAX_BLOCK_BYTES - SPX_N);\n   102\t        shaX_inc_blocks(state, buf, 1);\n   103\t\n   104\t        m += SPX_SHAX_BLOCK_BYTES - SPX_N;\n   105\t        mlen -= SPX_SHAX_BLOCK_BYTES - SPX_N;\n   106\t        shaX_inc_finalize(buf + SPX_SHAX_BLOCK_BYTES, state, m, mlen);\n   107\t    }\n   108\t\n   109\t    for (i = 0; i < SPX_N; i++) {\n   110\t        buf[i] = 0x5c ^ sk_prf[i];\n   111\t    }\n   112\t    memset(buf + SPX_N, 0x5c, SPX_SHAX_BL