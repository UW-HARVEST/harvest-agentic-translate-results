 block, mode; };\n\ntypedef struct {\n  char *temp_key;\n  size_t slot_count, used_count, used_count_threshold, used_count_shrink_threshold;\n  size_t tombstone_count, tombstone_count_threshold, seed, slot_count_log2;\n  struct stbds_string_arena string;\n  void *storage;\n} hi_t;\n\nstatic void dump_arr(const char *tag, void *a)\n{\n  if (!a) { printf(\"%s: NULL\\n\", tag); return; }\n  printf(\"%s: len=%zu cap=%zu ht=%d temp=%td\\n\", tag, HDR(a)->length, HDR(a)->capacity,\n         HDR(a)->hash_table != NULL, HDR(a)->temp);\n}\n\nstatic void dump_table(const char *tag, void *a)\n{\n  hi_t *t = (hi_t *) HDR(a)->hash_table;\n  if (!t) { printf(\"%s: no table\\n\", tag); return; }\n  printf(\"%s: slots=%zu log2=%zu used=%zu ucT=%zu ucST=%zu tomb=%zu tombT=%zu seed=%016zx mode=%d aligned=%d\\n\",\n         tag, t->slot_count, t->slot_count_log2, t->used_count, t->used_count_threshold,\n         t->used_count_shrink_threshold, t->tombstone_count, t->tombstone_count_threshold,\n         t->seed, t->string.mode, ((size_t) t->storage % 64) == 0);\n}\n\nint main(void)\n{\n  /* --- arrgrowf edge cases --- */\n  {\n    void *a;\n    a = stbds_arrgrowf(NULL, 4, 0, 0);\n    printf(\"grow(NULL,4,0,0) = %s\\n\", a ? \"nonnull\" : \"NULL\");\n    a = stbds_arrgrowf(NULL, 4, 0, 1); dump_arr(\"grow(NULL,4,0,1)\", a);\n    a = stbds_arrgrowf(a, 4, 1, 0);    dump_arr(\"grow(a,4,1,0)\", a);\n    a = stbds_arrgrowf(a, 4, 0, 3);    dump_arr(\"grow(a,4,0,3)\", a);\n    a = stbds_arrgrowf(a, 4, 0, 5);    dump_arr(\"grow(a,4,0,5)\", a);\n    a = stbds_arrgrowf(a, 4, 0, 9);    dump_arr(\"grow(a,4,0,9)\", a);\n    a = stbds_arrgrowf(a, 4, 100, 0);  dump_arr(\"grow(a,4,100,0)\", a);\n    HDR(a)->length = 50;\n    a = stbds_arrgrowf(a, 4, 1, 0);    dump_arr(\"grow(len50,+1)\", a);\n    a = stbds_arrgrowf(a, 4, 0, 1000); dump_arr(\"grow(a,4,0,1000)\", a);\n    stbds_arrfreef(a);\n    a = stbds_arrgrowf(NULL, 1, 0, 1); dump_arr(\"grow(NULL,1,0,1)\", a);\n    a = stbds_arrgrowf(a, 1, 3, 0);    dump_arr(\"grow(a,1,3,0)\", a);\n    stbds_arrfreef(a);\n    a = stbds_arrgrowf(NULL, 200, 0, 1); dump_arr(\"grow(NULL,200,0,1)\", a);\n    stbds_arrfreef(a);\n  }\n\n  /* --- hmput_default on NULL and on an existing map --- */\n  {\n    void *m = stbds_hmput_default(NULL, 16);\n    dump_arr(\"hmput_default(NULL)\", (char*)m - 16);\n    void *m2 = stbds_hmput_default(m, 16);\n    printf(\"hmput_default again same=%d\\n\", m == m2);\n    HDR((char*)m - 16)->length = 0;\n    m2 = stbds_hmput_default(m, 16);\n    dump_arr(\"hmput_default(len0)\", (char*)m2 - 16);\n    stbds_hmfree_func((char*)m2 - 16, 16);\n  }\n\n  /* --- hmget_key / hmget_key_ts on NULL and table-less maps --- */\n  {\n    int key = 5;\n    ptrdiff_t temp = 12345;\n    void *m = stbds_hmget_key_ts(NULL, 8, &key, sizeof key, &temp, 0);\n    printf(\"hmget_key_ts(NULL) temp=%td\\n\", temp);\n    dump_arr(\"after get_ts(NULL)\", (char*)m - 8);\n    temp = 999;\n    m = stbds_hmget_key_ts(m, 8, &key, sizeof key, &temp, 0);\n    printf(\"hmget_key_ts(no table) temp=%td\\n\", temp);\n    m = stbds_hmget_key(m, 8, &key, sizeof key, 0);\n    dump_arr(\"after get(no table)\", (char*)m - 8);\n    stbds_hmfree_func((char*)m - 8, 8);\n\n    void *n = stbds_hmget_key(NULL, 8, &key, sizeof key, 0);\n    dump_arr(\"hmget_key(NULL)\", (char*)n - 8);\n    stbds_hmfree_func((char*)n - 8, 8);\n  }\n\n  /* --- hmdel_key on NULL / table-less / missing key --- */\n  {\n    int key = 7;\n    printf(\"hmdel_key(NULL) = %s\\n\", stbds_hmdel_key(NULL, 8, &key, 4, 0, 0) ? \"nonnull\" : \"NULL\");\n    void *m = stbds_hmput_default(NULL, 8);\n    void *r = stbds_hmdel_key(m, 8, &key, 4, 0, 0);\n    printf(\"hmdel_key(no table) same=%d temp=%td\\n\", r == m, HDR((char*)m-8)->temp);\n    stbds_hmfree_func((char*)m - 8, 8);\n  }\n\n  /* --- hmfree_func on NULL --- */\n  stbds_hmfree_func(NULL, 16);\n  printf(\"hmfree(NULL) ok\\n\");\n\n  /* --- binary map with 8-byte keys, growth/shrink tracing --- */\n  {\n    typedef struct { long key; long value; } E;\n    void *m = NULL;\n    long k;\n    int i;\n    for (i = 0; i < 40; ++i) {\n      k = i * 1000003L;\n      m = stbds_hmput_key(m, sizeof(E), &k, sizeof k, 0);\n      E *e = (E*)m;\n      ptrdiff_t t = HDR((char*)m - sizeof(E))->temp;\n      e[t].key = k; e[t].value = i;\n      if (i % 8 == 0) { char tag[32]; sprintf(tag, \"put %d\", i); dump_table(tag, (char*)m - sizeof(E)); }\n    }\n    for (i = 0; i < 40; ++i) {\n      k = i * 1000003L;\n      m = stbds_hmdel_key(m, sizeof(E), &k, sizeof k, 0, 0);\n      if (i % 8 == 0) { char tag[32]; sprintf(tag, \"del %d\", i); dump_table(tag, (char*)m - sizeof(E)); }\n    }\n    dump_arr(\"final\", (char*)m - sizeof(E));\n    stbds_hmfree_func((char*)m - sizeof(E), sizeof(E));\n  }\n\n  /* --- keyoffset != 0 on delete (key not the first member) --- */\n  {\n    typedef struct { long value; long key; } E2;\n    void *m = NULL;\n    long k;\n    int i;\n    /* hmput_key always writes the key at offset 0, mirroring stb_ds. */\n    for (i = 0; i < 20; ++i) {\n      k = i;\n      m = stbds_hmput_key(m, sizeof(E2), &k, sizeof k, 0);\n      E2 *e = (E2*)m;\n      ptrdiff_t t = HDR((char*)m - sizeof(E2))->temp;\n      e[t].value = i; e[t].key = i;\n    }\n    for (i = 0; i < 20; i += 3) {\n      k = i;\n      m = stbds_hmdel_key(m, sizeof(E2), &k, sizeof k, offsetof(E2, key), 0);\n      printf(\"del keyoffset i=%d temp=%td len=%zu\\n\", i, HDR((char*)m - sizeof(E2))->temp,\n             HDR((char*)m - sizeof(E2))->length);\n    }\n    stbds_hmfree_func((char*)m - sizeof(E2), sizeof(E2));\n  }\n\n  /* --- shmode_func for all modes --- */\n  {\n    int mode;\n    for (mode = 0; mode <= 3; ++mode) {\n      void *m = stbds_shmode_func(16, mode);\n      dump_arr(\"shmode\", (char*)m - 16);\n      dump_table(\"shmode table\", (char*)m - 16);\n      stbds_hmfree_func((char*)m - 16, 16);\n    }\n  }\n\n  /* --- rand_seed determinism of generated table seeds --- */\n  {\n    int i;\n    stbds_rand_seed(0);\n    for (i = 0; i < 5; ++i) {\n      void *m = stbds_shmode_func(16, 1);\n      dump_table(\"seed walk\", (char*)m - 16);\n      stbds_hmfree_func((char*)m - 16, 16);\n    }\n    stbds_rand_seed(0xffffffffffffffffULL);\n    for (i = 0; i < 5; ++i) {\n      void *m = stbds_shmode_func(16, 1);\n      dump_table(\"seed walk2\", (char*)m - 16);\n      stbds_hmfree_func((char*)m - 16, 16);\n    }\n    stbds_rand_seed(0x31415926);\n  }\n\n  /* --- unaligned + long hash_bytes --- */\n  {\n    unsigned char big[300];\n    size_t i;\n    for (i = 0; i < sizeof big; ++i) big[i] = (unsigned char)(i * 31 + 7);\n    for (i = 0; i < 300; i += 7)\n      printf(\"hb(%zu) = %016zx\\n\", i, stbds_hash_bytes(big + (i % 8), i, i * 3));\n    printf(\"hb empty = %016zx\\n\", stbds_hash_bytes(big, 0, 0));\n    printf(\"hs empty = %016zx\\n\", stbds_hash_string(\"\", 0));\n  }\n\n  /* --- arena: exact-fit / oversize / block growth --- */\n  {\n    struct stbds_string_arena sa;\n    char buf[2100];\n    int i;\n    memset(&sa, 0, sizeof sa);\n    printf(\"arena start remaining=%zu block=%d\\n\", sa.remaining, sa.block);\n    for (i = 0; i < 6; ++i) {\n      memset(buf, 'a' + i, 500 + i * 300);\n      buf[500 + i * 300] = 0;\n      char *p = stbds_stralloc(&sa, buf);\n      printf(\"  alloc len=%zu -> first=%c remaining=%zu block=%d\\n\",\n             strlen(p), p[0], sa.remaining, sa.block);\n    }\n    for (i = 0; i < 30; ++i) {\n      char *p = stbds_stralloc(&sa, strkey(i));\n      printf(\"  small %s remaining=%zu block=%d\\n\", p, sa.remaining, sa.block);\n    }\n    stbds_strreset(&sa);\n    printf(\"arena reset remaining=%zu block=%d storage=%s\\n\", sa.remaining, sa.block,\n           sa.storage ? \"nonnull\" : \"NULL\");\n    /* empty string into a fresh arena */\n    memset(&sa, 0, sizeof sa);\n    printf(\"empty alloc = '%s' remaining=%zu block=%d\\n\", stbds_stralloc(&sa, \"\"), sa.remaining, sa.block);\n    stbds_strreset(&sa);\n    /* strreset on an already-empty arena */\n    stbds_