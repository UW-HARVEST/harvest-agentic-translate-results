um);\n\n/* ---- private layout, duplicated exactly as stb_ds.h does ---- */\ntypedef struct {\n  size_t      length;\n  size_t      capacity;\n  void      * hash_table;\n  ptrdiff_t   temp;\n} stbds_array_header;\n\ntypedef struct stbds_string_block\n{\n  struct stbds_string_block *next;\n  char storage[8];\n} stbds_string_block;\n\nstruct stbds_string_arena\n{\n  stbds_string_block *storage;\n  size_t remaining;\n  unsigned char block;\n  unsigned char mode;\n};\n\n#define STBDS_HM_BINARY 0\n#define STBDS_HM_STRING 1\nenum { STBDS_SH_NONE, STBDS_SH_DEFAULT, STBDS_SH_STRDUP, STBDS_SH_ARENA };\n\n#define stbds_header(t)  ((stbds_array_header *) (t) - 1)\n#define stbds_temp(t)    stbds_header(t)->temp\n#define stbds_temp_key(t) (*(char **) stbds_header(t)->hash_table)\n\n#define stbds_arrgrow(a,b,c)   ((a) = stbds_arrgrowf((a), sizeof *(a), (b), (c)))\n#define stbds_arrsetcap(a,n)   (stbds_arrgrow(a,0,n))\n#define stbds_arrcap(a)        ((a) ? stbds_header(a)->capacity : 0)\n#define stbds_arrlen(a)        ((a) ? (ptrdiff_t) stbds_header(a)->length : 0)\n#define stbds_arrmaybegrow(a,n)  ((!(a) || stbds_header(a)->length + (n) > stbds_header(a)->capacity) \\\n                                  ? (stbds_arrgrow(a,n,0),0) : 0)\n#define stbds_arrput(a,v)      (stbds_arrmaybegrow(a,1), (a)[stbds_header(a)->length++] = (v))\n#define stbds_arrpop(a)        (stbds_header(a)->length--, (a)[stbds_header(a)->length])\n#define stbds_arrfree(a)       ((void) ((a) ? free(stbds_header(a)) : (void)0), (a)=NULL)\n#define stbds_arraddnptr(a,n)  (stbds_arrmaybegrow(a,n), (n) ? (stbds_header(a)->length += (n), &(a)[stbds_header(a)->length-(n)]) : (a))\n#define stbds_arrlast(a)       ((a)[stbds_header(a)->length-1])\n#define stbds_arrdeln(a,i,n)   (memmove(&(a)[i], &(a)[(i)+(n)], sizeof *(a) * (stbds_header(a)->length-(n)-(i))), stbds_header(a)->length -= (n))\n#define stbds_arrdelswap(a,i)  ((a)[i] = stbds_arrlast(a), stbds_header(a)->length -= 1)\n#define stbds_arrsetlen(a,n)   ((stbds_arrcap(a) < (size_t) (n) ? stbds_arrsetcap((a),(size_t)(n)),0 : 0), (a) ? stbds_header(a)->length = (size_t) (n) : 0)\n\n#define STBDS_ADDRESSOF(typevar, value)  ((__typeof__(typevar)[1]){value})\n#define STBDS_OFFSETOF(var,field)        ((char *) &(var)->field - (char *) (var))\n\n#define stbds_hmput(t, k, v) \\\n    ((t) = stbds_hmput_key((t), sizeof *(t), (void*) STBDS_ADDRESSOF((t)->key, (k)), sizeof (t)->key, 0),   \\\n     (t)[stbds_temp((t)-1)].key = (k),    \\\n     (t)[stbds_temp((t)-1)].value = (v))\n#define stbds_hmputs(t, s) \\\n    ((t) = stbds_hmput_key((t), sizeof *(t), &(s).key, sizeof (s).key, STBDS_HM_BINARY), \\\n     (t)[stbds_temp((t)-1)] = (s))\n#define stbds_hmgeti(t,k) \\\n    ((t) = stbds_hmget_key((t), sizeof *(t), (void*) STBDS_ADDRESSOF((t)->key, (k)), sizeof (t)->key, STBDS_HM_BINARY), \\\n      stbds_temp((t)-1))\n#define stbds_hmgeti_ts(t,k,temp) \\\n    ((t) = stbds_hmget_key_ts((t), sizeof *(t), (void*) STBDS_ADDRESSOF((t)->key, (k)), sizeof (t)->key, &(temp), STBDS_HM_BINARY), \\\n      (temp))\n#define stbds_hmgetp(t, k)   ((void) stbds_hmgeti(t,k), &(t)[stbds_temp((t)-1)])\n#define stbds_hmgetp_ts(t, k, temp) ((void) stbds_hmgeti_ts(t,k,temp), &(t)[temp])\n#define stbds_hmdel(t,k) \\\n    (((t) = stbds_hmdel_key((t),sizeof *(t), (void*) STBDS_ADDRESSOF((t)->key, (k)), sizeof (t)->key, STBDS_OFFSETOF((t),key), STBDS_HM_BINARY)),(t)?stbds_temp((t)-1):0)\n#define stbds_hmdefault(t, v) ((t) = stbds_hmput_default((t), sizeof *(t)), (t)[-1].value = (v))\n#define stbds_hmdefaults(t, s) ((t) = stbds_hmput_default((t), sizeof *(t)), (t)[-1] = (s))\n#define stbds_hmfree(p) ((void) ((p) != NULL ? stbds_hmfree_func((p)-1,sizeof*(p)),0 : 0),(p)=NULL)\n#define stbds_hmgets(t, k)    (*stbds_hmgetp(t,k))\n#define stbds_hmget(t, k)     (stbds_hmgetp(t,k)->value)\n#define stbds_hmget_ts(t,k,temp) (stbds_hmgetp_ts(t,k,temp)->value)\n#define stbds_hmlen(t)        ((t) ? (ptrdiff_t) stbds_header((t)-1)->length-1 : 0)\n#define stbds_hmgetp_null(t,k)  (stbds_hmgeti(t,k) == -1 ? NULL : &(t)[stbds_temp((t)-1)])\n\n#define stbds_shput(t, k, v) \\\n    ((t) = stbds_hmput_key((t), sizeof *(t), (void*) (k), sizeof (t)->key, STBDS_HM_STRING),   \\\n     (t)[stbds_temp((t)-1)].value = (v))\n#define stbds_shputi(t, k, v) \\\n    ((t) = stbds_hmput_key((t), sizeof *(t), (void*) (k), sizeof (t)->key, STBDS_HM_STRING),   \\\n     (t)[stbds_temp((t)-1)].value = (v), stbds_temp((t)-1))\n#define stbds_shputs(t, s) \\\n    ((t) = stbds_hmput_key((t), sizeof *(t), (void*) (s).key, sizeof (s).key, STBDS_HM_STRING), \\\n     (t)[stbds_temp((t)-1)] = (s), \\\n     (t)[stbds_temp((t)-1)].key = stbds_temp_key((t)-1))\n#define stbds_shgeti(t,k) \\\n     ((t) = stbds_hmget_key((t), sizeof *(t), (void*) (k), sizeof (t)->key, STBDS_HM_STRING), \\\n      stbds_temp((t)-1))\n#define stbds_shgetp(t, k) ((void) stbds_shgeti(t,k), &(t)[stbds_temp((t)-1)])\n#define stbds_shdel(t,k) \\\n    (((t) = stbds_hmdel_key((t),sizeof *(t), (void*) (k), sizeof (t)->key, STBDS_OFFSETOF((t),key), STBDS_HM_STRING)),(t)?stbds_temp((t)-1):0)\n#define stbds_sh_new_arena(t)  ((t) = stbds_shmode_func(sizeof *(t), STBDS_SH_ARENA))\n#define stbds_sh_new_strdup(t) ((t) = stbds_shmode_func(sizeof *(t), STBDS_SH_STRDUP))\n#define stbds_shget(t, k)  (stbds_shgetp(t,k)->value)\n#define stbds_shgets(t, k) (*stbds_shgetp(t,k))\n#define stbds_shgetp_null(t,k) (stbds_shgeti(t,k) == -1 ? NULL : &(t)[stbds_temp((t)-1)])\n#define stbds_shlen stbds_hmlen\n#define stbds_shfree stbds_hmfree\n\n/* ============================ tests ============================ */\n\nstatic void test_hashes(void)\n{\n  static const char *strs[] = { \"\", \"a\", \"ab\", \"abc\", \"abcd\", \"abcde\", \"abcdef\",\n    \"abcdefg\", \"abcdefgh\", \"abcdefghi\", \"0123456789abcdef0123456789\",\n    \"\\xff\\xfe\\x80\\x01\", \"\\x80\", \"\\x7f\\x80\\x81\\xff\\x00zz\", \"test_12345\",\n    \"The quick brown fox jumps over the lazy dog\" };\n  size_t seeds[] = { 0, 1, 2, 0x31415926, 0xdeadbeefcafebabeULL, (size_t)-1, 0x8000000000000000ULL };\n  unsigned char buf[64];\n  int i, j;\n\n  for (i = 0; i < (int)(sizeof strs / sizeof *strs); ++i)\n    for (j = 0; j < (int)(sizeof seeds / sizeof *seeds); ++j)\n      printf(\"hash_string(%d,%d) = %016zx\\n\", i, j, stbds_hash_string((char*)strs[i], seeds[j]));\n\n  /* bytes: every length 0..64, with high-bit bytes to catch sign extension */\n  for (i = 0; i < 64; ++i) buf[i] = (unsigned char)(i*7 + 128);\n  for (i = 0; i <= 64; ++i)\n    for (j = 0; j < (int)(sizeof seeds / sizeof *seeds); ++j)\n      printf(\"hash_bytes_hi(%d,%d) = %016zx\\n\", i, j, stbds_hash_bytes(buf, (size_t)i, seeds[j]));\n  for (i = 0; i < 64; ++i) buf[i] = (unsigned char)(i*3);\n  for (i = 0; i <= 64; ++i)\n    for (j = 0; j < (int)(sizeof seeds / sizeof *seeds); ++j)\n      printf(\"hash_bytes_lo(%d,%d) = %016zx\\n\", i, j, stbds_hash_bytes(buf, (size_t)i, seeds[j]));\n  for (i = 0; i < 64; ++i) buf[i] = 0xff;\n  for (i = 0; i <= 64; ++i)\n    printf(\"hash_bytes_ff(%d) = %016zx\\n\", i, stbds_hash_bytes(buf, (size_t)i, 12345));\n  for (i = 0; i < 64; ++i) buf[i] = 0;\n  for (i = 0; i <= 64; ++i)\n    printf(\"hash_bytes_00(%d) = %016zx\\n\", i, stbds_hash_bytes(buf, (size_t)i, 999));\n\n  /* rand_seed affects the seed generated for new tables */\n  stbds_rand_seed(0);\n  printf(\"after rand_seed(0)\\n\");\n}\n\nstatic void test_arrays(void)\n{\n  int *a = NULL;\n  int i;\n  for (i = 0; i < 1000; ++i)\n    stbds_arrput(a, i*i);\n  printf(\"arr len=%td cap=%zu last=%d\\n\", stbds_arrlen(a), stbds_arrcap(a), stbds_arrlast(a));\n  for (i = 0; i < 10; ++i) printf(\"  arr[%d]=%d\\n\", i*97, a[i*97]);\n  for (i = 0; i < 100; ++i) (void) stbds_arrpop(a);\n  printf(\"arr after pops len=%td cap=%zu\\n\", stbds_arrlen(a), stbds_arrcap(a));\n  stbds_arrdeln(a, 5, 10);\n  printf(\"arr after deln len=%td a[5]=%d\\n\", stbds_arrlen(a), a[5]);\n  stbds_arrdelswap(a, 0);\n  printf(\"arr after delswap len=%td a[0]=%d\\n\", stbds_arrlen(a), a[0]);\n  stbds_arrsetlen(a, 2000);\n  printf(\"arr after setlen len=%td cap=%zu\\n\", stbds_arrlen(a), stbds_arrcap(a));\n  stbds_arrsetcap(a, 5000);\n  printf(\"arr after setcap len=%td cap=%zu\\n\", stbds_arrlen(a), stbds_arrcap(a));\n  {\n    int *p = stbds_arraddnptr(a, 3);\n    p[0]=1; p[1]=2; p[2]=3;\n    printf(\"arr after addnptr len=%td\\n\", stbds_arrlen(a));\n  }\n  stbds_arrfreef(a);\n  a = NULL;\n\n  /* char array + struct array */\n  {\n    struct big { char c[37]; } *b = NULL;\n    struct big t;\n    memset(&t, 'x', sizeof t);\n    for (i = 0; i < 50; ++i) { t.c[0] = (char)i; stbds_arrput(b, t); }\n    printf(\"big len=%td cap=%zu first=%d last=%d\\n\", stbds_arrlen(b), stbds_arrcap(b), b[0].c[0], stbds_arrlast(b).c[0]);\n    stbds_arrfree(b);\n  }\n}\n\nstatic void test_intmap(void)\n{\n  struct { int key; int value; } *m = NULL;\n  int i;\n  stbds_hmdefault(m, -777);\n  for (i = 0; i < 500; ++i)\n    stbds_hmput(m, i*3, i*i+1);\n  printf(\"hm len=%td\\n\", stbds_hmlen(m));\n  for (i = 0; i < 520; ++i)\n    printf(\"  hmget(%d)=%d geti=%td\\n\", i, stbds_hmget(m, i), stbds_hmgeti(m, i));\n  /* overwrite */\n  for (i = 0; i < 500; i += 7)\n    stbds_hmput(m, i*3, -i);\n  printf(\"hm after overwrite len=%td\\n\", stbds_hmlen(m));\n  /* delete lots (forces tombstone rebuild + shrink) */\n  for (i = 0; i < 500; i += 2)\n    printf(\"  hmdel(%d)=%td\\n\", i*3, stbds_hmdel(m, i*3));\n  printf(\"hm after del len=%td\\n\", stbds_hmlen(m));\n  for (i = 0; i < 500; ++i) {\n    ptrdiff_t t;\n    printf(\"  post hmget(%d)=%d ts=%d\\n\", i*3, stbds_hmget(m, i*3), stbds_hmget_ts(m, i*3, t));\n  }\n  for (i = 0; i < (int) stbds_hmlen(m); ++i)\n    printf(\"  slot %d: key=%d value=%d\\n\", i, m[i].key, m[i].value);\n  /* delete the rest */\n  for (i = 1; i < 500; i += 2)\n    (void) stbds_hmdel(m, i*3);\n  printf(\"hm empty len=%td\\n\", stbds_hmlen(m));\n  (void) stbds_hmdel(m, 99999);\n  printf(\"hm del missing len=%td get=%d\\n\", stbds_hmlen(m), stbds_hmget(m, 12));\n  stbds_hmfree(m);\n\n  /* struct keys (binary mode, larger key) */\n  {\n    struct { struct { int a, b; char c; } key; double value; } *k = NULL, e;\n    for (i = 0; i < 200; ++i) {\n      memset(&e, 0, sizeof e);\n      e.key.a = i; e.key.b = -i; e.key.c = (char)i;\n      e.value = i * 0.5;\n      stbds_hmputs(k, e);\n    }\n    printf(\"structmap len=%td\\n\", stbds_hmlen(k));\n    for (i = 0; i < 200; i += 17) {\n      memset(&e, 0, sizeof e);\n      e.key.a = i; e.key.b = -i; e.key.c = (char)i;\n      printf(\"  structmap[%d] = %.3f (i=%td)\\n\", i, stbds_hmgets(k, e.key).value, stbds_hmgeti(k, e.key));\n    }\n    stbds_hmfree(k);\n  }\n\n  /* hmgetp_null / defaults struct */\n  {\n    struct { int key; int value; } *n = NULL, d;\n    d.key = 0; d.value = 42;\n    stbds_hmdefaults(n, d);\n    printf(\"default value=%d getp_null(5)=%p\\n\", stbds_hmget(n, 5), (void*)stbds_hmgetp_null(n, 5));\n    stbds_hmput(n, 5, 6);\n    printf(\"getp_null(5)->value=%d\\n\", stbds_hmgetp_null(n, 5)->value);\n    stbds_hmfree(n);\n  }\n}\n\nstatic void test_strmap(int mode)\n{\n  struct { char *key; int value; } *m = NULL, s;\n  int i;\n  char kb[64];\n\n  if (mode == STBDS_SH_STRDUP) stbds_sh_new_strdup(m);\n  else if (mode == STBDS_SH_ARENA) stbds_sh_new_arena(m);\n\n  for (i = 0; i < 300; ++i) {\n    sprintf(kb, \"key_%d\", i);\n    if (mode == STBDS_SH_DEFAULT) {\n      char *p = malloc(strlen(kb)+1);\n      strcpy(p, kb);\n      stbds_shput(m, p, i);\n    } else {\n      stbds_shput(m, kb, i);\n    }\n  }\n  printf(\"sh(%d) len=%td\\n\", mode, stbds_shlen(m));\n  for (i = 0; i < 320; ++i) {\n    sprintf(kb, \"key_%d\", i);\n    printf(\"  shget(%s)=%d i=%td null=%d\\n\", kb, stbds_shget(m, kb), stbds_shgeti(m, kb),\n           stbds_shgetp_null(m, kb) ? 1 : 0);\n  }\n  for (i = 0; i < 300; i += 3) {\n    sprintf(kb, \"key_%d\", i);\n    printf(\"  shdel(%s)=%td\\n\", kb, stbds_shdel(m, kb));\n  }\n  printf(\"sh(%d) after del len=%td\\n\", mode, stbds_shlen(m));\n  for (i = 0; i < 300; ++i) {\n    sprintf(kb, \"key_%d\", i);\n    printf(\"  post shget(%s)=%d\\n\", kb, stbds_shget(m, kb));\n  }\n  for (i = 0; i < (int) stbds_shlen(m); ++i)\n    printf(\"  slot %d: %s=%d\\n\", i, m[i].key, m[i].value);\n\n  s.key = \"zzz\"; s.value = 4242;\n  stbds_shputs(m, s);\n  printf(\"shputs zzz -> %d key=%s same=%d\\n\", stbds_shget(m, \"zzz\"), m[stbds_shgeti(m,\"zzz\")].key,\n         m[stbds_shgeti(m,\"zzz\")].key == s.key);\n  printf(\"shputi again = %td\\n\", (ptrdiff_t) stbds_shputi(m, \"zzz\", 1));\n  stbds_shfree(m);\n}\n\nstatic void test_arena(void)\n{\n  stbds_string_arena sa = { 0 };\n  char *p[400];\n  char buf[4096];\n  int i;\n  for (i = 0; i < 400; ++i)\n    p[i] = stbds_stralloc(&sa, strkey(i));\n  for (i = 0; i < 400; ++i)\n    printf(\"arena[%d]=%s\\n\", i, p[i]);\n  printf(\"arena remaining=%zu block=%d\\n\", sa.remaining, sa.block);\n  /* huge string forces the oversize path */\n  memset(buf, 'q', sizeof buf); buf[sizeof buf - 1] = 0;\n  printf(\"arena big len=%zu first=%c\\n\", strlen(stbds_stralloc(&sa, buf)), *stbds_stralloc(&sa, buf));\n  printf(\"arena remaining=%zu block=%d\\n\", sa.remaining, sa.block);\n  for (i = 0; i < 40; ++i)\n    printf(\"arena more[%d]=%s\\n\", i, stbds_stralloc(&sa, strkey(i*1000)));\n  printf(\"arena remaining=%zu block=%d\\n\", sa.remaining, sa.block);\n  stbds_strreset(&sa);\n  printf(\"after reset storage=%p remaining=%zu block=%d mode=%d\\n\",\n         (void*)sa.storage, sa.remaining, sa.block, sa.mode);\n  /* reuse after reset */\n  printf(\"reuse=%s\\n\", stbds_stralloc(&sa, \"hello world\"));\n  stbds_strreset(&sa);\n}\n\nstatic void test_strkey(void)\n{\n  int i;\n  int vals[] = { 0, 1, -1, 7, 12345, -98765, 2147483647, -2147483648 };\n  for (i = 0; i < (int)(sizeof vals / sizeof *vals); ++i)\n    printf(\"strkey(%d)=%s\\n\", vals[i], strkey(vals[i]));\n  printf(\"strkey stable=%d\\n\", strkey(1) == strkey(2));\n}\n\nint main(void)\n{\n  test_hashes();\n  test_arrays();\n  test_intmap();\n  test_strmap(ST