;\n  stbds_shputs(m, s);\n  printf(\"shputs zzz -> %d key=%s same=%d\\n\", stbds_shget(m, \"zzz\"), m[stbds_shgeti(m,\"zzz\")].key,\n         m[stbds_shgeti(m,\"zzz\")].key == s.key);\n  printf(\"shputi again = %td\\n\", (ptrdiff_t) stbds_shputi(m, \"zzz\", 1));\n  stbds_shfree(m);\n}\n\nstatic void test_arena(void)\n{\n  stbds_string_arena sa = { 0 };\n  char *p[400];\n  char buf[4096];\n  int i;\n  for (i = 0; i < 400; ++i)\n    p[i] = stbds_stralloc(&sa, strkey(i));\n  for (i = 0; i < 400; ++i)\n    printf(\"arena[%d]=%s\\n\", i, p[i]);\n  printf(\"arena remaining=%zu block=%d\\n\", sa.remaining, sa.block);\n  /* huge string forces the oversize path */\n  memset(buf, 'q', sizeof buf); buf[sizeof buf - 1] = 0;\n  printf(\"arena big len=%zu first=%c\\n\", strlen(stbds_stralloc(&sa, buf)), *stbds_stralloc(&sa, buf));\n  printf(\"arena remaining=%zu block=%d\\n\", sa.remaining, sa.block);\n  for (i = 0; i < 40; ++i)\n    printf(\"arena more[%d]=%s\\n\", i, stbds_stralloc(&sa, strkey(i*1000)));\n  printf(\"arena remaining=%zu block=%d\\n\", sa.remaining, sa.block);\n  stbds_strreset(&sa);\n  printf(\"after reset storage=%p remaining=%zu block=%d mode=%d\\n\",\n         (void*)sa.storage, sa.remaining, sa.block, sa.mode);\n  /* reuse after reset */\n  printf(\"reuse=%s\\n\", stbds_stralloc(&sa, \"hello world\"));\n  stbds_strreset(&sa);\n}\n\nstatic void test_strkey(void)\n{\n  int i;\n  int vals[] = { 0, 1, -1, 7, 12345, -98765, 2147483647, -2147483648 };\n  for (i = 0; i < (int)(sizeof vals / sizeof *vals); ++i)\n    printf(\"strkey(%d)=%s\\n\", vals[i], strkey(vals[i]));\n  printf(\"strkey stable=%d\\n\", strkey(1) == strkey(2));\n}\n\nint main(void)\n{\n  test_hashes();\n  test_arrays();\n  test_intmap();\n  test_strmap(STBDS_SH_DEFAULT);\n  test_strmap(STBDS_SH_STRDUP);\n  test_strmap(STBDS_SH_ARENA);\n  test_arena();\n  test_strkey();\n  str_dups(0);\n  str_dups(1);\n  str_dups(2);\n  str_dups(37);\n  str_dups(1000);\n  str_dups(-5);\n  fflush(stdout);\n  return 