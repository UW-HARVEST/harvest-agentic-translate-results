bucket).hash[z] == 0 {\n489\t                                (*bucket).hash[z] = hash;\n490\t                                (*bucket).index[z] = (*ob).index[j];\n491\t                                break 'search;\n492\t                            }\n493\t                            z += 1;\n494\t                        }\n495\t\n496\t                        let limit = pos & STBDS_BUCKET_MASK;\n497\t                        let mut z = 0usize;\n498\t                        while z < limit {\n499\t                            if (*bucket).hash[z] == 0 {\n500\t                                (*bucket).hash[z] = hash;\n501\t                                (*bucket).index[z] = (*ob).index[j];\n502\t                                break 'search;\n503\t                            }\n504\t                            z += 1;\n505\t                        }\n506\t\n507\t                        pos = pos.wrapping_add(step);\n508\t                        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n509\t                        pos &= (*t).slot_count.wrapping_sub(1);\n510\t                    }\n511\t                }\n512\t            }\n513\t            i += 1;\n514\t        }\n515\t    }\n516\t\n517\t    t\n518\t}\n519\t\n520\t// ---------------------------------------------------------------------------\n521\t// hash map internals\n522\t// ---------------------------------------------------------------------------\n523\t\n524\tunsafe fn stbds_is_key_equal(\n525\t    a: *mut c_void,\n526\t    elemsize: usize,\n527\t    key: *mut c_void,\n528\t    keysize: usize,\n529\t    keyoffset: usize,\n530\t    mode: c_int,\n531\t    i: usize,\n532\t) -> c_int {\n533\t    if mode >= STBDS_HM_STRING {\n534\t        let slot = padd(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset)) as *mut *mut c_char;\n535\t        (0 == strcmp(key as *const c_char, *slot as *const c_char)) as c_int\n536\t    } else {\n537\t        let slot = padd(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset));\n538\t        (0 == memcmp(key as *const c_void, slot as *const c_void, keysize)) as c_int\n539\t    }\n540\t}\n541\t\n542\t#[unsafe(no_mangle)]\n543\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n544\t    if a.is_null() {\n545\t        return;\n546\t    }\n547\t    if !stbds_hash_table(a).is_null() {\n548\t        if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP {\n549\t            let mut i: usize = 1;\n550\t            while i < (*stbds_header(a)).length {\n551\t                free(*(padd(a, elemsize.wrapping_mul(i)) as *mut *mut c_char) as *mut c_void);\n552\t                i += 1;\n553\t            }\n554\t        }\n555\t        stbds_strreset(ptr::addr_of_mut!((*stbds_hash_table(a)).string));\n556\t    }\n557\t    free((*stbds_header(a)).hash_table);\n558\t    free(stbds_header(a) as *mut c_void);\n559\t}\n560\t\n561\tunsafe fn stbds_hm_find_slot(\n562\t    a: *mut c_void,\n563\t    elemsize: usize,\n564\t    key: *mut c_void,\n565\t    keysize: usize,\n566\t    keyoffset: usize,\n567\t    mode: c_int,\n568\t) -> isize {\n569\t    let raw_a = stbds_hash_to_arr(a, elemsize);\n570\t    let table = stbds_hash_table(raw_a);\n571\t    let mut hash = if mode >= STBDS_HM_STRING {\n572\t        stbds_hash_string(key as *mut c_char, (*table).seed)\n573\t    } else {\n574\t        stbds_hash_bytes(key, keysize, (*table).seed)\n575\t    };\n576\t    let mut step = STBDS_BUCKET_LENGTH;\n577\t\n578\t    if hash < 2 {\n579\t        hash = hash.wrapping_add(2);\n580\t    }\n581\t\n582\t    let mut pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n583\t\n584\t    loop {\n585\t        let bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);\n586\t\n587\t        let mut i = pos & STBDS_BUCKET_MASK;\n588\t        while i < STBDS_BUCKET_LENGTH {\n589\t            if (*bucket).hash[i] == hash {\n590\t                if stbds_is_key_equal(\n591\t                    a,\n592\t                    elemsize,\n593\t                    key,\n594\t                    keysize,\n595\t                    keyoffset,\n596\t                    mode,\n597\t                    (*bucket).index[i] as usize,\n598\t                ) != 0\n599\t                {\n600\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n601\t                }\n602\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n603\t                return -1;\n604\t            }\n605\t            i += 1;\n606\t        }\n607\t\n608\t        let limit = pos & STBDS_BUCKET_MASK;\n609\t        let mut i = 0usize;\n610\t        while i < limit {\n611\t            if (*bucket).hash[i] == hash {\n612\t                if stbds_is_key_equal(\n613\t                    a,\n614\t                    elemsize,\n615\t                    key,\n616\t                    keysize,\n617\t                    keyoffset,\n618\t                    mode,\n619\t                    (*bucket).index[i] as usize,\n620\t                ) != 0\n621\t                {\n622\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n623\t                }\n624\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n625\t                return -1;\n626\t            }\n627\t            i += 1;\n628\t        }\n629\t\n630\t        pos = pos.wrapping_add(step);\n631\t        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n632\t        pos &= (*table).slot_count.wrapping_sub(1);\n633\t    }\n634\t}\n635\t\n636\t#[unsafe(no_mangle)]\n637\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n638\t    a: *mut c_void,\n639\t    elemsize: usize,\n640\t    key: *mut c_void,\n641\t    keysize: usize,\n642\t    temp: *mut isize,\n643\t    mode: c_int,\n644\t) -> *mut c_void {\n645\t    let keyoffset: usize = 0;\n646\t    if a.is_null() {\n647\t        let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n648\t        (*stbds_header(a)).length = (*stbds_header(a)).length.wrapping_add(1);\n649\t        memset(a, 0, elemsize);\n650\t        *temp = STBDS_INDEX_EMPTY;\n651\t        stbds_arr_to_hash(a, elemsize)\n652\t    } else {\n653\t        let raw_a = stbds_hash_to_arr(a, elemsize);\n654\t        let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n655\t        if table.is_null() {\n656\t            *temp = -1;\n657\t        } else {\n658\t            let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n659\t            if slot < 0 {\n660\t                *temp = STBDS_INDEX_EMPTY;\n661\t            } else {\n662\t                let b = (*table).storage.offset(slot >> STBDS_BUCKET_SHIFT);\n663\t                *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n664\t            }\n665\t        }\n666\t        a\n667\t    }\n668\t}\n669\t\n670\t#[unsafe(no_mangle)]\n671\tpub unsafe extern \"C\" fn stbds_hmget_key(\n672\t    a: *mut c_void,\n673\t    elemsize: usize,\n674\t    key: *mut c_void,\n675\t    keysize: usize,\n676\t    mode: c_int,\n677\t) -> *mut c_void {\n678\t    let mut temp: isize = 0;\n679\t    let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &mut temp, mode);\n680\t    (*stbds_header(stbds_hash_to_arr(p, elemsize))).temp = temp;\n681\t    p\n682\t}\n683\t\n684\t#[unsafe(no_mangle)]\n685\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n686\t    let mut a = a;\n687\t    if a.is_null() || (*stbds_header(stbds_hash_to_arr(a, elemsize))).length == 0 {\n688\t        a = stbds_arrgrowf(\n689\t            if !a.is_null() {\n690\t                stbds_hash_to_arr(a, elemsize)\n691\t            } else {\n692\t                ptr::null_mut()\n693\t            },\n694\t            elemsize,\n695\t            0,\n696\t            1,\n697\t        );\n698\t        (*stbds_header(a)).length = (*stbds_header(a)).length.wrapping_add(1);\n699\t        memset(a, 0, elemsize);\n700\t        a = stbds_arr_to_hash(a, elemsize);\n701\t    }\n702\t    a\n703\t}\n704\t\n705\tunsafe fn stbds_strdup(str_: *mut c_char) -> *mut c_char {\n706\t    let len = strlen(str_).wrapping_add(1);\n707\t    let p = realloc(ptr::null_mut(), len) as *mut c_char;\n708\t    memmove(p as *mut c_void, str_ as *const c_void, len);\n709\t    p\n710\t}\n711\t\n712\t#[unsafe(no_mangle)]\n713\tpub unsafe extern \"C\" fn stbds_hmput_key(\n714\t    a: *mut c_void,\n715\t    elemsize: usize,\n716\t    key: *mut c_void,\n717\t    keysize: usize,\n718\t    mode: c_int,\n719\t) -> *mut c_void {\n720\t    let keyoffset: usize = 0;\n721\t    let mut a = a;\n722\t    let mut raw_a: *mut c_void;\n723\t    let mut table: *mut stbds_hash_index;\n724\t\n725\t    if a.is_null() {\n726\t        a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n727\t        memset(a, 0, elemsize);\n728\t        (*stbds_header(a)).length = (*stbds_header(a)).length.wrapping_add(1);\n729\t        a = stbds_arr_to_hash(a, elemsize);\n730\t    }\n731\t\n732\t    raw_a = a;\n733\t    a = stbds_hash_to_arr(a, elemsize);\n734\t\n735\t    table = (*stbds_header(a)).hash_table as *mut stbds_hash_index;\n736\t\n737\t    if table.is_null() || (*table).used_count >= (*table).used_count_threshold {\n738\t        let slot_count = if table.is_null() {\n739\t            STBDS_BUCKET_LENGTH\n740\t        } else {\n741\t            (*table).slot_count.wrapping_mul(2)\n742\t        };\n743\t        let nt = stbds_make_hash_index(slot_count, table);\n744\t        if !table.is_null() {\n745\t            free(table as *mut c_void);\n746\t        } else {\n747\t            (*nt).string.mode = if mode >= STBDS_HM_STRING {\n748\t                STBDS_SH_DEFAULT\n749\t            } else {\n750\t                STBDS_SH_NONE\n751\t            };\n752\t        }\n753\t        table = nt;\n754\t        (*stbds_header(a)).hash_table = table as *mut c_void;\n755\t    }\n756\t\n757\t    {\n758\t        let mut hash = if mode >= STBDS_HM_STRING {\n759\t            stbds_hash_string(key as *mut c_char, (*table).seed)\n760\t        } else {\n761\t            stbds_hash_bytes(key, keysize, (*table).seed)\n762\t        };\n763\t        let mut step = STBDS_BUCKET_LENGTH;\n764\t        let mut pos: usize;\n765\t        let mut tombstone: isize = -1;\n766\t        let mut bucket: *mut stbds_hash_bucket;\n767\t\n768\t        if hash < 2 {\n769\t            hash = hash.wrapping_add(2);\n770\t        }\n771\t\n772\t        pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n773\t\n774\t        'found_empty_slot: loop {\n775\t            bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);\n776\t\n777\t            let mut i = pos & STBDS_BUCKET_MASK;\n778\t            while i < STBDS_BUCKET_LENGTH {\n779\t                if (*bucket).hash[i] == hash {\n780\t                    if stbds_is_key_equal(\n781\t                        raw_a,\n782\t                        elemsize,\n783\t                        key,\n784\t                        keysize,\n785\t                        keyoffset,\n786\t                        mode,\n787\t                        (*bucket).index[i] as usize,\n788\t                    ) != 0\n789\t                    {\n790\t                        (*stbds_header(a)).temp = (*bucket).index[i];\n791\t                        if mode >= STBDS_HM_STRING {\n792\t                            let src = padd(\n793\t                                raw_a,\n794\t                                elemsize\n795\t                                    .wrapping_mul((*bucket).index[i] as usize)\n796\t                                    .wrapping_add(keyoffset),\n797\t                            ) as *mut *mut c_char;\n798\t                            (*stbds_hash_table(a)).temp_key = *src;\n799\t                        }\n800\t                        return stbds_arr_to_hash(a, elemsize);\n801\t                    }\n802\t                } else if (*bucket).hash[i] == 0 {\n803\t                    pos = (pos & !STBDS_BUCKET_MASK).wr