{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01E4iUZ3EHRn4CTpqAKYkKRX","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (an stb_ds-derived data\n2\t//! structure library plus the `str_dups` / `strkey` test helpers).\n3\t//!\n4\t//! The translation is deliberately literal: every arithmetic quirk, integer\n5\t//! promotion, sign extension and check ordering of the original C is\n6\t//! reproduced, including behaviour that would be considered a bug.\n7\t\n8\t#![allow(non_camel_case_types)]\n9\t#![allow(non_snake_case)]\n10\t#![allow(non_upper_case_globals)]\n11\t#![allow(clippy::missing_safety_doc)]\n12\t#![allow(dead_code)]\n13\t#![allow(unused_assignments)]\n14\t\n15\tuse core::ptr;\n16\tuse std::ffi::{c_char, c_int, c_void};\n17\t\n18\t// ---------------------------------------------------------------------------\n19\t// libc bindings (the C code uses realloc/free/str*/mem* and printf/sprintf)\n20\t// ---------------------------------------------------------------------------\n21\t\n22\textern \"C\" {\n23\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n24\t    fn free(p: *mut c_void);\n25\t    fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n26\t    fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n27\t    fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n28\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n29\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n30\t    fn strlen(s: *const c_char) -> usize;\n31\t    fn printf(fmt: *const c_char, ...) -> c_int;\n32\t    fn sprintf(s: *mut c_char, fmt: *const c_char, ...) -> c_int;\n33\t    fn write(fd: c_int, buf: *const c_void, n: usize) -> isize;\n34\t    fn abort() -> !;\n35\t}\n36\t\n37\t// ---------------------------------------------------------------------------\n38\t// `STBDS_ASSERT` == `assert` from <assert.h>.\n39\t//\n40\t// The C library is compiled WITHOUT `-DNDEBUG` (see `c_src/CMakeLists.txt`,\n41\t// which sets no build type), so `nm -D` on the C `.so` really does show\n42\t// `U __assert_fail`: a failing assertion prints a diagnostic and `abort()`s.\n43\t// That is externally observable behaviour (SIGABRT), so the translation has to\n44\t// reproduce it rather than silently continuing with corrupted state.\n45\t// ---------------------------------------------------------------------------\n46\t\n47\t#[cold]\n48\t#[inline(never)]\n49\tunsafe fn stbds_assert_fail(expr: &str, line: u32) -> ! {\n50\t    // Written straight to fd 2, mirroring glibc's `__assert_fail`, without\n51\t    // relying on any Rust runtime state.\n52\t    let msg = format!(\"lib.c:{}: Assertion `{}' failed.\\n\", line, expr);\n53\t    write(2, msg.as_ptr() as *const c_void, msg.len());\n54\t    abort()\n55\t}\n56\t\n57\tmacro_rules! STBDS_ASSERT {\n58\t    ($cond:expr, $line:expr) => {\n59\t        if !($cond) {\n60\t            stbds_assert_fail(stringify!($cond), $line);\n61\t        }\n62\t    };\n63\t}\n64\t\n65\t// ---------------------------------------------------------------------------\n66\t// Types (layouts must match the C structs exactly)\n67\t// ---------------------------------------------------------------------------\n68\t\n69\t#[repr(C)]\n70\t#[derive(Copy, Clone)]\n71\tstruct stbds_array_header {\n72\t    length: usize,\n73\t    capacity: usize,\n74\t    hash_table: *mut c_void,\n75\t    temp: isize,\n76\t}\n77\t\n78\t#[repr(C)]\n79\t#[derive(Copy, Clone)]\n80\tstruct stbds_string_block {\n81\t    next: *mut stbds_string_block,\n82\t    storage: [c_char; 8],\n83\t}\n84\t\n85\t#[repr(C)]\n86\t#[derive(Copy, Clone)]\n87\tpub struct stbds_string_arena {\n88\t    storage: *mut stbds_string_block,\n89\t    remaining: usize,\n90\t    block: u8,\n91\t    mode: u8,\n92\t}\n93\t\n94\t#[repr(C)]\n95\t#[derive(Copy, Clone)]\n96\tstruct stbds_hash_bucket {\n97\t    hash: [usize; STBDS_BUCKET_LENGTH],\n98\t    index: [isize; STBDS_BUCKET_LENGTH],\n99\t}\n100\t\n101\t#[repr(C)]\n102\t#[derive(Copy, Clone)]\n103\tstruct stbds_hash_index {\n104\t    temp_key: *mut c_char,\n105\t    slot_count: usize,\n106\t    used_count: usize,\n107\t    used_count_threshold: usize,\n108\t    used_count_shrink_threshold: usize,\n109\t    tombstone_count: usize,\n110\t    tombstone_count_threshold: usize,\n111\t    seed: usize,\n112\t    slot_count_log2: usize,\n113\t    string: stbds_string_arena,\n114\t    storage: *mut stbds_hash_bucket,\n115\t}\n116\t\n117\t// ---------------------------------------------------------------------------\n118\t// Constants\n119\t// ---------------------------------------------------------------------------\n120\t\n121\tconst STBDS_HM_BINARY: c_int = 0;\n122\tconst STBDS_HM_STRING: c_int = 1;\n123\t\n124\tconst STBDS_SH_NONE: u8 = 0;\n125\tconst STBDS_SH_DEFAULT: u8 = 1;\n126\tconst STBDS_SH_STRDUP: u8 = 2;\n127\tconst STBDS_SH_ARENA: u8 = 3;\n128\t\n129\tconst STBDS_BUCKET_LENGTH: usize = 8;\n130\tconst STBDS_BUCKET_SHIFT: usize = 3;\n131\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n132\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n133\t\n134\tconst STBDS_INDEX_EMPTY: isize = -1;\n135\tconst STBDS_INDEX_DELETED: isize = -2;\n136\t\n137\tconst STBDS_HASH_EMPTY: usize = 0;\n138\tconst STBDS_HASH_DELETED: usize = 1;\n139\t\n140\tconst STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() as u32) * 8;\n141\t\n142\tconst HDR_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n143\t\n144\tconst STBDS_STRING_ARENA_BLOCKSIZE_MIN: usize = 512;\n145\tconst STBDS_STRING_ARENA_BLOCKSIZE_MAX: usize = 1usize << 20;\n146\t\n147\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n148\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n149\t\n150\t// ---------------------------------------------------------------------------\n151\t// Small helpers mirroring the C macros\n152\t// ---------------------------------------------------------------------------\n153\t\n154\t#[inline(always)]\n155\tfn padd(p: *mut c_void, off: usize) -> *mut c_void {\n156\t    (p as *mut u8).wrapping_add(off) as *mut c_void\n157\t}\n158\t\n159\t#[inline(always)]\n160\tfn psub(p: *mut c_void, off: usize) -> *mut c_void {\n161\t    (p as *mut u8).wrapping_sub(off) as *mut c_void\n162\t}\n163\t\n164\t/// `stbds_header(t)`\n165\t#[inline(always)]\n166\tfn stbds_header(a: *mut c_void) -> *mut stbds_array_header {\n167\t    psub(a, HDR_SIZE) as *mut stbds_array_header\n168\t}\n169\t\n170\t/// `stbds_arrlen(a)`\n171\t#[inline(always)]\n172\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n173\t    if a.is_null() {\n174\t        0\n175\t    } else {\n176\t        (*stbds_header(a)).length as isize\n177\t    }\n178\t}\n179\t\n180\t/// `stbds_arrcap(a)`\n181\t#[inline(always)]\n182\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n183\t    if a.is_null() {\n184\t        0\n185\t    } else {\n186\t        (*stbds_header(a)).capacity\n187\t    }\n188\t}\n189\t\n190\t/// `stbds_hash_table(a)`\n191\t#[inline(always)]\n192\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n193\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n194\t}\n195\t\n196\t/// `STBDS_HASH_TO_ARR(x, elemsize)`\n197\t#[inline(always)]\n198\tfn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n199\t    psub(x, elemsize)\n200\t}\n201\t\n202\t/// `STBDS_ARR_TO_HASH(x, elemsize)`\n203\t#[inline(always)]\n204\tfn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n205\t    padd(x, elemsize)\n206\t}\n207\t\n208\t#[inline(always)]\n209\tfn stbds_rotate_left(val: usize, n: u32) -> usize {\n210\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n211\t}\n212\t\n213\t#[inline(always)]\n214\tfn stbds_rotate_right(val: usize, n: u32) -> usize {\n215\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n216\t}\n217\t\n218\t#[inline(always)]\n219\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n220\t    n.wrapping_add(a - 1) & !(a - 1)\n221\t}\n222\t\n223\t// ---------------------------------------------------------------------------\n224\t// stbds_arrgrowf / stbds_arrfreef\n225\t// ---------------------------------------------------------------------------\n226\t\n227\t#[unsafe(no_mangle)]\n228\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n229\t    a: *mut c_void,\n230\t    elemsize: usize,\n231\t    addlen: usize,\n232\t    min_cap: usize,\n233\t) -> *mut c_void {\n234\t    let mut min_cap = min_cap;\n235\t    let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n236\t\n237\t    if min_len > min_cap {\n238\t        min_cap = min_len;\n239\t    }\n240\t\n241\t    if min_cap <= stbds_arrcap(a) {\n242\t        return a;\n243\t    }\n244\t\n245\t    if min_cap < stbds_arrcap(a).wrapping_mul(2) {\n246\t        min_cap = stbds_arrcap(a).wrapping_mul(2);\n247\t    } else if min_cap < 4 {\n248\t        min_cap = 4;\n249\t    }\n250\t\n251\t    let old = if !a.is_null() {\n252\t        stbds_header(a) as *mut c_void\n253\t    } else {\n254\t        ptr::null_mut()\n255\t    };\n256\t    let mut b = realloc(old, elemsize.wrapping_mul(min_cap).wrapping_add(HDR_SIZE));\n257\t    b = padd(b, HDR_SIZE);\n258\t    if a.is_null() {\n259\t        (*stbds_header(b)).length = 0;\n260\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n261\t        (*stbds_header(b)).temp = 0;\n262\t    }\n263\t    (*stbds_header(b)).capacity = min_cap;\n264\t\n265\t    b\n266\t}\n267\t\n268\t#[unsafe(no_mangle)]\n269\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n270\t    free(stbds_header(a) as *mut c_void);\n271\t}\n272\t\n273\t// ---------------------------------------------------------------------------\n274\t// hashing\n275\t// ---------------------------------------------------------------------------\n276\t\n277\tstatic mut stbds_hash_seed: usize = 0x31415926;\n278\t\n279\t#[unsafe(no_mangle)]\n280\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n281\t    stbds_hash_seed = seed;\n282\t}\n283\t\n284\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n285\t    hash & (slot_count.wrapping_sub(1))\n286\t}\n287\t\n288\tfn stbds_log2(slot_count: usize) -> usize {\n289\t    let mut slot_count = slot_count;\n290\t    let mut n: usize = 0;\n291\t    while slot_count > 1 {\n292\t        slot_count >>= 1;\n293\t        n += 1;\n294\t    }\n295\t    n\n296\t}\n297\t\n298\t#[unsafe(no_mangle)]\n299\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n300\t    let mut s = str_;\n301\t    let mut hash = seed;\n302\t    while *s != 0 {\n303\t        hash = stbds_rotate_left(hash, 9).wrapping_add(*(s as *const u8) as usize);\n304\t        s = s.add(1);\n305\t    }\n306\t\n307\t    hash ^= seed;\n308\t    hash = (!hash).wrapping_add(hash << 18);\n309\t    hash ^= hash ^ stbds_rotate_right(hash, 31);\n310\t    hash = hash.wrapping_mul(21);\n311\t    hash ^= hash ^ stbds_rotate_right(hash, 11);\n312\t    hash = hash.wrapping_add(hash << 6);\n313\t    hash ^= stbds_rotate_right(hash, 22);\n314\t    hash.wrapping_add(seed)\n315\t}\n316\t\n317\tmacro_rules! siphash_round {\n318\t    ($v0:ident, $v1:ident, $v2:ident, $v3:ident) => {{\n319\t        $v0 = $v0.wrapping_add($v1);\n320\t        $v1 = stbds_rotate_left($v1, 13);\n321\t        $v1 ^= $v0;\n322\t        $v0 = stbds_rotate_left($v0, STBDS_SIZE_T_BITS / 2);\n323\t        $v2 = $v2.wrapping_add($v3);\n324\t        $v3 = stbds_rotate_left($v3, 16);\n325\t        $v3 ^= $v2;\n326\t        $v2 = $v2.wrapping_add($v1);\n327\t        $v1 = stbds_rotate_left($v1, 17);\n328\t        $v1 ^= $v2;\n329\t        $v2 = stbds_rotate_left($v2, STBDS_SIZE_T_BITS / 2);\n330\t        $v0 = $v0.wrapping_add($v3);\n331\t        $v3 = stbds_rotate_left($v3, 21);\n332\t        $v3 ^= $v0;\n333\t    }};\n334\t}\n335\t\n336\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n337\t    let mut d = p as *const u8;\n338\t    let mut data: usize;\n339\t\n340\t    let mut v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n341\t    let mut v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n342\t    let mut v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n343\t    let mut v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n344\t\n345\t    v0 ^= 0x0706050403020100u64 as usize ^ seed;\n346\t    v1 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n347\t    v2 ^= 0x0706050403020100u64 as usize ^ seed;\n348\t    v3 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n349\t\n350\t    let mut i: usize = 0;\n351\t    while i + core::mem::size_of::<usize>() <= len {\n352\t        // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n353\t        // All operands are promoted to `int`, so the result is a *signed* int\n354\t        // that is then sign-extended when stored into the size_t `data`.\n355\t        let lo: i32 = (*d.add(0) as i32)\n356\t            | ((*d.add(1) as i32) << 8)\n357\t            | ((*d.add(2) as i32) << 16)\n358\t            | ((*d.add(3) as i32).wrapping_shl(24));\n359\t        data = lo as i64 as u64 as usize;\n360\t        let hi: i32 = (*d.add(4) as i32)\n361\t            | ((*d.add(5) as i32) << 8)\n362\t            | ((*d.add(6) as i32) << 16)\n363\t            | ((*d.add(7) as i32).wrapping_shl(24));\n364\t        data |= ((((hi as i64 as u64 as usize) << 16) as usize) << 16) as usize;\n365\t\n366\t        v3 ^= data;\n367\t        for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n368\t            siphash_round!(v0, v1, v2, v3);\n369\t        }\n370\t        v0 ^= data;\n371\t\n372\t        i += core::mem::size_of::<usize>();\n373\t        d = d.add(core::mem::size_of::<usize>());\n374\t    }\n375\t\n376\t    data = len.wrapping_shl(STBDS_SIZE_T_BITS - 8);\n377\t    let rem = len.wrapping_sub(i);\n378\t    // Fallthrough switch: case 7 falls into 6, 5, ... 1.\n379\t    if rem >= 7 {\n380\t        data |= ((*d.add(6) as usize) << 24) << 24;\n381\t    }\n382\t    if rem >= 6 {\n383\t        data |= ((*d.add(5) as usize) << 20) << 20;\n384\t    }\n385\t    if rem >= 5 {\n386\t        data |= ((*d.add(4) as usize) << 16) << 16;\n387\t    }\n388\t    if rem >= 4 {\n389\t        data |= ((*d.add(3) as i32).wrapping_shl(24)) as i64 as u64 as usize;\n390\t    }\n391\t    if rem >= 3 {\n392\t        data |= ((*d.add(2) as i32) << 16) as i64 as u64 as usize;\n393\t    }\n394\t    if rem >= 2 {\n395\t        data |= ((*d.add(1) as i32) << 8) as i64 as u64 as usize;\n396\t    }\n397\t    if rem >= 1 {\n398\t        data |= (*d.add(0) as i32) as i64 as u64 as usize;\n399\t    }\n400\t\n401\t    v3 ^= data;\n402\t    for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n403\t        siphash_round!(v0, v1, v2, v3);\n404\t    }\n405\t    v0 ^= data;\n406\t    v2 ^= 0xff;\n407\t    for _ in 0..STBDS_SIPHASH_D_ROUNDS {\n408\t        siphash_round!(v0, v1, v2, v3);\n409\t    }\n410\t\n411\t    v0 ^ v1 ^ v2 ^ v3\n412\t}\n413\t\n414\t#[unsafe(no_mangle)]\n415\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n416\t    stbds_siphash_bytes(p, len, seed)\n417\t}\n418\t\n419\t// ---------------------------------------------------------------------------\n420\t// hash index construction\n421\t// ---------------------------------------------------------------------------\n422\t\n423\tunsafe fn stbds_make_hash_index(\n424\t    slot_count: usize,\n425\t    ot: *mut stbds_hash_index,\n426\t) -> *mut stbds_hash_index {\n427\t    let t = realloc(\n428\t        ptr::null_mut(),\n429\t        (slot_count >> STBDS_BUCKET_SHIFT)\n430\t            .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n431\t            .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n432\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n433\t    ) as *mut stbds_hash_index;\n434\t\n435\t    (*t).storage = stbds_align_fwd(t.add(1) as usize, STBDS_CACHE_LINE_SIZE) as *mut stbds_hash_bucket;\n436\t    (*t).slot_count = slot_count;\n437\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n438\t    (*t).tombstone_count = 0;\n439\t    (*t).used_count = 0;\n440\t\n441\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n442\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n443\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n444\t\n445\t    if slot_count <= STBDS_BUCKET_LENGTH {\n446\t        (*t).used_count_shrink_threshold = 0;\n447\t    }\n448\t    // c_src/src/lib.c:401\n449\t    STBDS_ASSERT!(\n450\t        (*t).used_count_threshold.wrapping_add((*t).tombstone_count_threshold) < (*t).slot_count,\n451\t        401\n452\t    );\n453\t\n454\t    if !ot.is_null() {\n455\t        (*t).string = (*ot).string;\n456\t        (*t).seed = (*ot).seed;\n457\t    } else {\n458\t        memset(\n459\t            ptr::addr_of_mut!((*t).string) as *mut c_void,\n460\t            0,\n461\t            core::mem::size_of::<stbds_string_arena>(),\n462\t        );\n463\t        (*t).seed = stbds_hash_seed;\n464\t        // stbds_load_32_or_64(a, temp, 2147001325, 0x27bb2ee6, 0x87b0b0fd);\n465\t        let a: usize = {\n466\t            let mut temp: usize = (0x87b0b0fdu32 ^ 2147001325u32) as usize;\n467\t            temp <<= 16;\n468\t            temp <<= 16;\n469\t            temp >>= 16;\n470\t            temp >>= 16;\n471\t            let mut var: usize = 0x27bb2ee6usize;\n472\t            var <<= 16;\n473\t            var <<= 16;\n474\t            var ^= temp ^ 2147001325usize;\n475\t            var\n476\t        };\n477\t        // stbds_load_32_or_64(b, temp, 715136305, 0, 0xb504f32d);\n478\t        let b: usize = {\n479\t            let mut temp: usize = (0xb504f32du32 ^ 715136305u32) as usize;\n480\t            temp <<= 16;\n481\t            temp <<= 16;\n482\t            temp >>= 16;\n483\t            temp >>= 16;\n484\t            let mut var: usize = 0usize;\n485\t            var <<= 16;\n486\t            var <<= 16;\n487\t            var ^= temp ^ 715136305usize;\n488\t            var\n489\t        };\n490\t        stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n491\t    }\n492\t\n493\t    {\n494\t        let mut i: usize = 0;\n495\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n496\t            let b = (*t).storage.add(i);\n497\t            for j in 0..STBDS_BUCKET_LENGTH {\n498\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n499\t            }\n500\t            for j in 0..STBDS_BUCKET_LENGTH {\n501\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n502\t            }\n503\t            i += 1;\n504\t        }\n505\t    }\n506\t\n507\t    if !ot.is_null() {\n508\t        (*t).used_count = (*ot).used_count;\n509\t        let mut i: usize = 0;\n510\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n511\t            let ob = (*ot).storage.add(i);\n512\t            for j in 0..STBDS_BUCKET_LENGTH {\n513\t                if (*ob).index[j] >= 0 {\n514\t                    let hash = (*ob).hash[j];\n515\t                    let mut pos =\n516\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n517\t                    let mut step = STBDS_BUCKET_LENGTH;\n518\t                    'search: loop {\n519\t                        let bucket = (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n520\t\n521\t                        let mut z = pos & STBDS_BUCKET_MASK;\n522\t                        while z < STBDS_BUCKET_LENGTH {\n523\t                            if (*bucket).hash[z] == 0 {\n524\t                                (*bucket).hash[z] = hash;\n525\t                                (*bucket).index[z] = (*ob).index[j];\n526\t                                break 'search;\n527\t                            }\n528\t                            z += 1;\n529\t                        }\n530\t\n531\t                        let limit = pos & STBDS_BUCKET_MASK;\n532\t                        let mut z = 0usize;\n533\t                        while z < limit {\n534\t                            if (*bucket).hash[z] == 0 {\n535\t                                (*bucket).hash[z] = hash;\n536\t                                (*bucket).index[z] = (*ob).index[j];\n537\t                                break 'search;\n538\t                            }\n539\t                            z += 1;\n540\t                        }\n541\t\n542\t                        pos = pos.wrapping_add(step);\n543\t                        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n544\t                        pos &= (*t).slot_count.wrapping_sub(1);\n545\t                    }\n546\t                }\n547\t            }\n548\t            i += 1;\n549\t        }\n550\t    }\n551\t\n552\t    t\n553\t}\n554\t\n555\t// ---------------------------------------------------------------------------\n556\t// hash map internals\n557\t// ---------------------------------------------------------------------------\n558\t\n559\tunsafe fn stbds_is_key_equal(\n560\t    a: *mut c_void,\n561\t    elemsize: usize,\n562\t    key: *mut c_void,\n563\t    keysize: usize,\n564\t    keyoffset: usize,\n565\t    mode: c_int,\n566\t    i: usize,\n567\t) -> c_int {\n568\t    if mode >= STBDS_HM_STRING {\n569\t        let slot = padd(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset)) as *mut *mut c_char;\n570\t        (0 == strcmp(key as *const c_char, *slot as *const c_char)) as c_int\n571\t    } else {\n572\t        let slot = padd(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset));\n573\t        (0 == memcmp(key as *const c_void, slot as *const c_void, keysize)) as c_int\n574\t    }\n575\t}\n576\t\n577\t#[unsafe(no_mangle)]\n578\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n579\t    if a.is_null() {\n580\t        return;\n581\t    }\n582\t    if !stbds_hash_table(a).is_null() {\n583\t        if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP {\n584\t            let mut i: usiz