171\t\n172\t/// `STBDS_ARR_TO_HASH(x, elemsize)`\n173\t#[inline(always)]\n174\tfn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n175\t    padd(x, elemsize)\n176\t}\n177\t\n178\t#[inline(always)]\n179\tfn stbds_rotate_left(val: usize, n: u32) -> usize {\n180\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n181\t}\n182\t\n183\t#[inline(always)]\n184\tfn stbds_rotate_right(val: usize, n: u32) -> usize {\n185\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n186\t}\n187\t\n188\t#[inline(always)]\n189\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n190\t    n.wrapping_add(a - 1) & !(a - 1)\n191\t}\n192\t\n193\t// ---------------------------------------------------------------------------\n194\t// stbds_arrgrowf / stbds_arrfreef\n195\t// ---------------------------------------------------------------------------\n196\t\n197\t#[unsafe(no_mangle)]\n198\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n199\t    a: *mut c_void,\n200\t    elemsize: usize,\n201\t    addlen: usize,\n202\t    min_cap: usize,\n203\t) -> *mut c_void {\n204\t    let mut min_cap = min_cap;\n205\t    let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n206\t\n207\t    if min_len > min_cap {\n208\t        min_cap = min_len;\n209\t    }\n210\t\n211\t    if min_cap <= stbds_arrcap(a) {\n212\t        return a;\n213\t    }\n214\t\n215\t    if min_cap < stbds_arrcap(a).wrapping_mul(2) {\n216\t        min_cap = stbds_arrcap(a).wrapping_mul(2);\n217\t    } else if min_cap < 4 {\n218\t        min_cap = 4;\n219\t    }\n220\t\n221\t    let old = if !a.is_null() {\n222\t        stbds_header(a) as *mut c_void\n223\t    } else {\n224\t        ptr::null_mut()\n225\t    };\n226\t    let mut b = realloc(old, elemsize.wrapping_mul(min_cap).wrapping_add(HDR_SIZE));\n227\t    b = padd(b, HDR_SIZE);\n228\t    if a.is_null() {\n229\t        (*stbds_header(b)).length = 0;\n230\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n231\t        (*stbds_header(b)).temp = 0;\n232\t    }\n233\t    (*stbds_header(b)).capacity = min_cap;\n234\t\n235\t    b\n236\t}\n237\t\n238\t#[unsafe(no_mangle)]\n239\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n240\t    free(stbds_header(a) as *mut c_void);\n241\t}\n242\t\n243\t// ---------------------------------------------------------------------------\n244\t// hashing\n245\t// ---------------------------------------------------------------------------\n246\t\n247\tstatic mut stbds_hash_seed: usize = 0x31415926;\n248\t\n249\t#[unsafe(no_mangle)]\n250\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n251\t    stbds_hash_seed = seed;\n252\t}\n253\t\n254\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n255\t    hash & (slot_count.wrapping_sub(1))\n256\t}\n257\t\n258\tfn stbds_log2(slot_count: usize) -> usize {\n259\t    let mut slot_count = slot_count;\n260\t    let mut n: usize = 0;\n261\t    while slot_count > 1 {\n262\t        slot_count >>= 1;\n263\t        n += 1;\n264\t    }\n265\t    n\n266\t}\n267\t\n268\t#[unsafe(no_mangle)]\n269\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n270\t    let mut s = str_;\n271\t    let mut hash = seed;\n272\t    while *s != 0 {\n273\t        hash = stbds_rotate_left(hash, 9).wrapping_add(*(s as *const u8) as usize);\n274\t        s = s.add(1);\n275\t    }\n276\t\n277\t    hash ^= seed;\n278\t    hash = (!hash).wrapping_add(hash << 18);\n279\t    hash ^= hash ^ stbds_rotate_right(hash, 31);\n280\t    hash = hash.wrapping_mul(21);\n281\t    hash ^= hash ^ stbds_rotate_right(hash, 11);\n282\t    hash = hash.wrapping_add(hash << 6);\n283\t    hash ^= stbds_rotate_right(hash, 22);\n284\t    hash.wrapping_add(seed)\n285\t}\n286\t\n287\tmacro_rules! siphash_round {\n288\t    ($v0:ident, $v1:ident, $v2:ident, $v3:ident) => {{\n289\t        $v0 = $v0.wrapping_add($v1);\n290\t        $v1 = stbds_rotate_left($v1, 13);\n291\t        $v1 ^= $v0;\n292\t        $v0 = stbds_rotate_left($v0, STBDS_SIZE_T_BITS / 2);\n293\t        $v2 = $v2.wrapping_add($v3);\n294\t        $v3 = stbds_rotate_left($v3, 16);\n295\t        $v3 ^= $v2;\n296\t        $v2 = $v2.wrapping_add($v1);\n297\t        $v1 = stbds_rotate_left($v1, 17);\n298\t        $v1 ^= $v2;\n299\t        $v2 = stbds_rotate_left($v2, STBDS_SIZE_T_BITS / 2);\n300\t        $v0 = $v0.wrapping_add($v3);\n301\t        $v3 = stbds_rotate_left($v3, 21);\n302\t        $v3 ^= $v0;\n303\t    }};\n304\t}\n305\t\n306\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n307\t    let mut d = p as *const u8;\n308\t    let mut data: usize;\n309\t\n310\t    let mut v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n311\t    let mut v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n312\t    let mut v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n313\t    let mut v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n314\t\n315\t    v0 ^= 0x0706050403020100u64 as usize ^ seed;\n316\t    v1 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n317\t    v2 ^= 0x0706050403020100u64 as usize ^ seed;\n318\t    v3 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n319\t\n320\t    let mut i: usize = 0;\n321\t    while i + core::mem::size_of::<usize>() <= len {\n322\t        // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n323\t        // All operands are promoted to `int`, so the result is a *signed* int\n324\t        // that is then sign-extended when stored into the size_t `data`.\n325\t        let lo: i32 = (*d.add(0) as i32)\n326\t            | ((*d.add(1) as i32) << 8)\n327\t            | ((*d.add(2) as i32) << 16)\n328\t            | ((*d.add(3) as i32).wrapping_shl(24));\n329\t        data = lo as i64 as u64 as usize;\n330\t        let hi: i32 = (*d.add(4) as i32)\n331\t            | ((*d.add(5) as i32) << 8)\n332\t            | ((*d.add(6) as i32) << 16)\n333\t            | ((*d.add(7) as i32).wrapping_shl(24));\n334\t        data |= ((((hi as i64 as u64 as usize) << 16) as usize) << 16) as usize;\n335\t\n336\t        v3 ^= data;\n337\t        for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n338\t            siphash_round!(v0, v1, v2, v3);\n339\t        }\n340\t        v0 ^= data;\n341\t\n342\t        i += core::mem::size_of::<usize>();\n343\t        d = d.add(core::mem::size_of::<usize>());\n344\t    }\n345\t\n346\t    data = len.wrapping_shl(STBDS_SIZE_T_BITS - 8);\n347\t    let rem = len.wrapping_sub(i);\n348\t    // Fallthrough switch: case 7 falls into 6, 5, ... 1.\n349\t    if rem >= 7 {\n350\t        data |= ((*d.add(6) as usize) << 24) << 24;\n351\t    }\n352\t    if rem >= 6 {\n353\t        data |= ((*d.add(5) as usize) << 20) << 20;\n354\t    }\n355\t    if rem >= 5 {\n356\t        data |= ((*d.add(4) as usize) << 16) << 16;\n357\t    }\n358\t    if rem >= 4 {\n359\t        data |= ((*d.add(3) as i32).wrapping_shl(24)) as i64 as u64 as usize;\n360\t    }\n361\t    if rem >= 3 {\n362\t        data |= ((*d.add(2) as i32) << 16) as i64 as u64 as usize;\n363\t    }\n364\t    if rem >= 2 {\n365\t        data |= ((*d.add(1) as i32) << 8) as i64 as u64 as usize;\n366\t    }\n367\t    if rem >= 1 {\n368\t        data |= (*d.add(0) as i32) as i64 as u64 as usize;\n369\t    }\n370\t\n371\t    v3 ^= data;\n372\t    for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n373\t        siphash_round!(v0, v1, v2, v3);\n374\t    }\n375\t    v0 ^= data;\n376\t    v2 ^= 0xff;\n377\t    for _ in 0..STBDS_SIPHASH_D_ROUNDS {\n378\t        siphash_round!(v0, v1, v2, v3);\n379\t    }\n380\t\n381\t    v0 ^ v1 ^ v2 ^ v3\n382\t}\n383\t\n384\t#[unsafe(no_mangle)]\n385\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n386\t    stbds_siphash_bytes(p, len, seed)\n387\t}\n388\t\n389\t// ---------------------------------------------------------------------------\n390\t// hash index construction\n391\t// ---------------------------------------------------------------------------\n392\t\n393\tunsafe fn stbds_make_hash_index(\n394\t    slot_count: usize,\n395\t    ot: *mut stbds_hash_index,\n396\t) -> *mut stbds_hash_index {\n397\t    let t = realloc(\n398\t        ptr::null_mut(),\n399\t        (slot_count >> STBDS_BUCKET_SHIFT)\n400\t            .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n401\t            .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n402\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n403\t    ) as *mut stbds_hash_index;\n404\t\n405\t    (*t).storage = stbds_align_fwd(t.add(1) as usize, STBDS_CACHE_LINE_SIZE) as *mut stbds_hash_bucket;\n406\t    (*t).slot_count = slot_count;\n407\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n408\t    (*t).tombstone_count = 0;\n409\t    (*t).used_count = 0;\n410\t\n411\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n412\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n413\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n414\t\n415\t    if slot_count <= STBDS_BUCKET_LENGTH {\n416\t        (*t).used_count_shrink_threshold = 0;\n417\t    }\n418\t\n419\t    if !ot.is_null() {\n420\t        (*t).string = (*ot).string;\n421\t        (*t).seed = (*ot).seed;\n422\t    } else {\n423\t        memset(\n424\t            ptr::addr_of_mut!((*t).string) as *mut c_void,\n425\t            0,\n426\t            core::mem::size_of::<stbds_string_arena>(),\n427\t        );\n428\t        (*t).seed = stbds_hash_seed;\n429\t        // stbds_load_32_or_64(a, temp, 2147001325, 0x27bb2ee6, 0x87b0b0fd);\n430\t        let a: usize = {\n431\t            let mut temp: usize = (0x87b0b0fdu32 ^ 2147001325u32) as usize;\n432\t            temp <<= 16;\n433\t            temp <<= 16;\n434\t            temp >>= 16;\n435\t            temp >>= 16;\n436\t            let mut var: usize = 0x27bb2ee6usize;\n437\t            var <<= 16;\n438\t            var <<= 16;\n439\t            var ^= temp ^ 2147001325usize;\n440\t            var\n441\t        };\n442\t        // stbds_load_32_or_64(b, temp, 715136305, 0, 0xb504f32d);\n443\t        let b: usize = {\n444\t            let mut temp: usize = (0xb504f32du32 ^ 715136305u32) as usize;\n445\t            temp <<= 16;\n446\t            temp <<= 16;\n447\t            temp >>= 16;\n448\t            temp >>= 16;\n449\t            let mut var: usize = 0usize;\n450\t            var <<= 16;\n451\t            var <<= 16;\n452\t            var ^= temp ^ 715136305usize;\n453\t            var\n454\t        };\n455\t        stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n456\t    }\n457\t\n458\t    {\n459\t        let mut i: usize = 0;\n460\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n461\t            let b = (*t).storage.add(i);\n462\t            for j in 0..STBDS_BUCKET_LENGTH {\n463\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n464\t            }\n465\t            for j in 0..STBDS_BUCKET_LENGTH {\n466\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n467\t            }\n468\t            i += 1;\n469\t        }\n470\t    }\n471\t\n472\t    if !ot.is_null() {\n473\t        (*t).used_count = (*ot).used_count;\n474\t        let mut i: usize = 0;\n475\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n476\t            let ob = (*ot).storage.add(i);\n477\t            for j in 0..STBDS_BUCKET_LENGTH {\n478\t                if (*ob).index[j] >= 0 {\n479\t                    let hash = (*ob).hash[j];\n480\t                    let mut pos =\n481\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n482\t                    let mut step = STBDS_BUCKET_LENGTH;\n483\t                    'search: loop {\n484\t                        let bucket = (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n485\t\n486\t                        let mut z = pos & STBDS_BUCKET_MASK;\n487\t                        while z < STBDS_BUCKET_LENGTH {\n488\t                            if (*bucket).hash[z] == 0 {\n489\t                                (*bucket).hash[z] = hash;\n490\t                                (*bucket).index[z] = (*ob).index[j];\n491\t                                break 'search;\n492\t                            }\n493\t                            z += 1;\n494\t                        }\n495\t\n496\t                        let limit = pos & STBDS_BUCKET_MASK;\n497\t                        let mut z = 0usize;\n498\t                        while z < limit {\n499\t                            if (*bucket).hash[z] == 0 {\n500\t                                (*bucket).hash[z] = hash;\n501\t                                (*bucket).index[z] = (*ob).index[j];\n502\t                                break 'search;\n503\t                            }\n504\t                            z += 1;\n505\t                        }\n506\t\n507\t                        pos = pos.wrapping_add(step);\n508\t                        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n509\t                        pos &= (*t).slot_count.wrapping_sub(1);\n510\t                    }\n511\t                }\n512\t            }\n513\t            i += 1;\n514\t        }\n515\t    }\n516\t\n517\t    t\n518\t}\n519\t\n520\t// ---------------------------------------------------------------------------\n521\t// hash map internals\n522\t// ---------------------------------------------------------------------------\n523\t\n524\tunsafe fn stbds_is_key_equal(\n525\t    a: *mut c_void,\n526\t    elemsize: usize,\n527\t    key: *mut c_void,\n528\t    keysize: usize,\n529\t    keyoffset: usize,\n530\t    mode: c_int,\n531\t    i: usize,\n532\t) -> c_int {\n533\t    if mode >= STBDS_HM_STRING {\n534\t        let slot = padd(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset)) as *mut *mut c_char;\n535\t        (0 == strcmp(key as *const c_char, *slot as *const c_char)) as c_int\n536\t    } else {\n537\t        let slot = padd(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset));\n538\t        (0 == memcmp(key as *const c_void, slot as *const c_void, keysize)) as c_int\n539\t    }\n540\t}\n541\t\n542\t#[unsafe(no_mangle)]\n543\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n544\t    if a.is_null() {\n545\t        return;\n546\t    }\n547\t    if !stbds_hash_table(a).is_null() {\n548\t        if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP {\n549\t            let mut i: usize = 1;\n550\t            while i < (*stbds_header(a)).length {\n551\t                free(*(padd(a, elemsize.wrapping_mul(i)) as *mut *mut c_char) as *mut c_void);\n552\t                i += 1;\n553\t            }\n554\t        }\n555\t        stbds_strreset(ptr::addr_of_mut!((*stbds_hash_table(a)).string));\n556\t    }\n557\t    free((*stbds_header(a)).hash_table);\n558\t    free(stbds_header(a) as *mut c_void);\n559\t}\n560\t\n561\tunsafe fn stbds_hm_find_slot(\n562\t    a: *mut c_void,\n563\t    elemsize: usize,\n564\t    key: *mut c_void,\n565\t    keysize: usize,\n566\t    keyoffset: usize,\n567\t    mode: c_int,\n568\t) -> isize {\n569\t    let raw_a = stbds_hash_to_arr(a, elemsize);\n570\t    let table = stbds_hash_table(raw_a);\n571\t    let mut hash = if mode >= STBDS_HM_STRING {\n572\t        stbds_hash_string(key as *mut c_char, (*table).seed)\n573\t    } else {\n574\t        stbds_hash_bytes(key, keysize, (*table).seed)\n575\t    };\n576\t    let mut step = STBDS_BUCKET_LENGTH;\n577\t\n578\t    if hash < 2 {\n579\t        hash = hash.wrapping_add(2);\n580\t    }\n581\t\n582\t    let mut pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n583\t\n584\t    loop {\n585\t        let bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);\n586\t\n587\t        let mut i = pos & STBDS_BUCKET_MASK;\n588\t        while i < STBDS_BUCKET_LENGTH {\n589\t            if (*bucket).hash[i] == hash {\n590\t                if stbds_is_key_equal(\n591\t                    a,\n592\t                    elemsize,\n593\t                    key,\n594\t                    keysize,\n595\t                    keyoffset,\n596\t                    mode,\n597\t                    (*bucket).index[i] as usize,\n598\t                ) != 0\n599\t                {\n600\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n601\t                }\n602\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n603\t                return -1;\n604\t            }\n605\t            i += 1;\n606\t        }\n607\t\n608\t        let limit = pos & STBDS_BUCKET_MASK;\n609\t        let mut i = 0usize;\n610\t        while i < limit {\n611\t            if (*bucket).hash[i] == hash {\n612\t                if stbds_is_key_equal(\n613\t                    a,\n614\t                    elemsize,\n615\t                    key,\n616\t                    keysize,\n617\t                    keyoffset,\n618\t                    mode,\n619\t                    (*bucket).index[i] as usize,\n620\t                ) != 0\n621\t                {\n622\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n623\t                }\n624\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n625\t                return -1;\n626\t            }\n627\t            i += 1;\n628\t        }\n629\t\n630\t        pos = pos.wrapping_add(step);\n631\t        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n632\t        pos &= (*table).slot_count.wrapping_sub(1);\n633\t    }\n634\t}\n635\t\n636\t#[unsafe(no_mangle)]\n637\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n638\t    a: *mut c_void,\n639\t    elemsize: usize,\n640\t    key: *mut c_void,\n641\t    keysize: usize,\n642\t    temp: *mut isize,\n643\t    mode: c_int,\n644\t) -> *mut c_void {\n645\t    let keyoffset: usize = 0;\n646\t    if a.is_null() {\n647\t        let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n648\t        (*stbds_header(a)).length = (*stbds_header(a)).length.wrapping_add(