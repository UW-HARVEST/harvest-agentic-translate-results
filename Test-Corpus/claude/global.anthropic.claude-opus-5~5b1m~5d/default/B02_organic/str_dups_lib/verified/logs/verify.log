---------\n392\t\n393\tunsafe fn stbds_make_hash_index(\n394\t    slot_count: usize,\n395\t    ot: *mut stbds_hash_index,\n396\t) -> *mut stbds_hash_index {\n397\t    let t = realloc(\n398\t        ptr::null_mut(),\n399\t        (slot_count >> STBDS_BUCKET_SHIFT)\n400\t            .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n401\t            .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n402\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n403\t    ) as *mut stbds_hash_index;\n404\t\n405\t    (*t).storage = stbds_align_fwd(t.add(1) as usize, STBDS_CACHE_LINE_SIZE) as *mut stbds_hash_bucket;\n406\t    (*t).slot_count = slot_count;\n407\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n408\t    (*t).tombstone_count = 0;\n409\t    (*t).used_count = 0;\n410\t\n411\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n412\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n413\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n414\t\n415\t    if slot_count <= STBDS_BUCKET_LENGTH {\n416\t        (*t).used_count_shrink_threshold = 0;\n417\t    }\n418\t\n419\t    if !ot.is_null() {\n420\t        (*t).string = (*ot).string;\n421\t        (*t).seed = (*ot).seed;\n422\t    } else {\n423\t        memset(\n424\t            ptr::addr_of_mut!((*t).string) as *mut c_void,\n425\t            0,\n426\t            core::mem::size_of::<stbds_string_arena>(),\n427\t        );\n428\t        (*t).seed = stbds_hash_seed;\n429\t        // stbds_load_32_or_64(a, temp, 2147001325, 0x27bb2ee6, 0x87b0b0fd);\n430\t        let a: usize = {\n431\t            let mut temp: usize = (0x87b0b0fdu32 ^ 2147001325u32) as usize;\n432\t            temp <<= 16;\n433\t            temp <<= 16;\n434\t            temp >>= 16;\n435\t            temp >>= 16;\n436\t            let mut var: usize = 0x27bb2ee6usize;\n437\t            var <<= 16;\n438\t            var <<= 16;\n439\t            var ^= temp ^ 2147001325usiz