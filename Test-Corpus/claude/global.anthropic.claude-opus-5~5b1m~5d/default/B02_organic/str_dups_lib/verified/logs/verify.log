     );\n893\t                }\n894\t            }\n895\t        }\n896\t        stbds_arr_to_hash(a, elemsize)\n897\t    }\n898\t}\n899\t\n900\t#[unsafe(no_mangle)]\n901\tpub unsafe extern \"C\" fn stbds_shmode_func(elemsize: usize, mode: c_int) -> *mut c_void {\n902\t    let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n903\t    memset(a, 0, elemsize);\n904\t    (*stbds_header(a)).length = 1;\n905\t    let h = stbds_make_hash_index(STBDS_BUCKET_LENGTH, ptr::null_mut());\n906\t    (*stbds_header(a)).hash_table = h as *mut c_void;\n907\t    (*h).string.mode = mode as u8;\n908\t    stbds_arr_to_hash(a, elemsize)\n909\t}\n910\t\n911\t#[unsafe(no_mangle)]\n912\tpub unsafe extern \"C\" fn stbds_hmdel_key(\n913\t    a: *mut c_void,\n914\t    elemsize: usize,\n915\t    key: *mut c_void,\n916\t    keysize: usize,\n917\t    keyoffset: usize,\n918\t    mode: c_int,\n919\t) -> *mut c_void {\n920\t    if a.is_null() {\n921\t        ptr::null_mut()\n922\t    } else {\n923\t        let raw_a = stbds_hash_to_arr(a, elemsize);\n924\t        let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n925\t        (*stbds_header(raw_a)).temp = 0;\n926\t        if table.is_null() {\n927\t            a\n928\t        } else {\n929\t            let mut slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n930\t            if slot < 0 {\n931\t                a\n932\t            } else {\n933\t                let mut b = (*table).storage.offset(slot >> STBDS_BUCKET_SHIFT);\n934\t                let mut i: c_int = ((slot as usize) & STBDS_BUCKET_MASK) as c_int;\n935\t                let old_index = (*b).index[i as usize];\n936\t                let final_index: isize = stbds_arrlen(raw_a) - 1 - 1;\n937\t                (*table).used_count = (*table).used_count.wrapping_sub(1);\n938\t                (*table).tombstone_count = (*table).tombstone_count.wrapping_add(1);\n939\t                (*stbds_header(raw_a)).temp = 1;\n940\t                (*b).hash