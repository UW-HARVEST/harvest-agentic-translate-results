ned down by\n    // `cfg43_string_duplicates_temp_key`, which never deletes.)\n    let snap_tk = !allow_del;\n    let mut inserted_any = false;\"\"\"\nassert old_body in s\ns = s.replace(old_body, new_body)\n\nold_snap = \"\"\"        if inserted_any && (sh_mode == SH_DEFAULT || sh_mode == SH_STRDUP || sh_mode == SH_ARENA) {\n            snap_map_tk(log, t, elemsize, KeyKind::StringAt(0));\n        } else {\n            snap_map(log, t, elemsize, KeyKind::StringAt(0));\n        }\"\"\"\nnew_snap = \"\"\"        if snap_tk\n            && inserted_any\n            && (sh_mode == SH_DEFAULT || sh_mode == SH_STRDUP || sh_mode == SH_ARENA)\n        {\n            snap_map_tk(log, t, elemsize, KeyKind::StringAt(0));\n        } else {\n            snap_map(log, t, elemsize, KeyKind::StringAt(0));\n        }\"\"\"\nassert old_snap in s\ns = s.replace(old_snap, new_snap)\n\n# 2. callers: remove bisect hooks, add allow_del arg, add no-delete variant\nold_call = \"\"\"        let only_sh: i32 = std::env::var(\"FZ_SH\").ok().and_then(|v| v.parse().ok()).unwrap_or(-1);\n        let only_mode: i32 = std::env::var(\"FZ_MODE\").ok().and_then(|v| v.parse().ok()).unwrap_or(-99);\n        for &sh in &[SH_DEFAULT, SH_STRDUP, SH_ARENA] {\n            for &mode in &[HM_BINARY, HM_STRING, 2] {\n                let hs = rng.next_u64() as usize;\n                if only_sh >= 0 && sh != only_sh { continue; }\n                if only_mode != -99 && mode != only_mode { continue; }\n                eprintln!(\"[fuzz_string] lib={} sh={} mode={}\", lib.name, sh, mode);\n                log.i32v(\"sh\", sh);\n                log.i32v(\"mode\", mode);\n                fuzz_string(lib, log, &mut rng, hs, 16, sh, mode, 600);\n            }\n        }\"\"\"\nnew_call = \"\"\"        for &sh in &[SH_DEFAULT, SH_STRDUP, SH_ARENA] {\n            for &mode in &[HM_BINARY, HM_STRING, 2] {\n                let hs = rng.next_u64() as usize;\n                log.i32v(\"sh\", sh);\n                log.i32v(\"mode\", mode);\n                fuzz_string(lib, log, &mut rng, hs, 16, sh, mode, 600, true);\n            }\n        }\"\"\"\nassert old_call in s\ns = s.replace(old_call, new_call)\n\ns = s.replace(\"fuzz_string(lib, log, &mut rng, hs, elemsize, sh, mode, 200);\",\n              \"fuzz_string(lib, log, &mut rng, hs, elemsize, sh, mode, 200, true);\")\n\n# 3. append a delete-free variant that DOES compare temp_key\ns += \"\"\"\n/// Delete-free string streams. Because nothing can free a key, this variant can\n/// additionally compare `hash_index::temp_key` after every single operation,\n/// covering both the refresh (first-loop duplicate hit / fresh insert) and the\n/// deliberate no-refresh (wrap-around duplicate hit) branches.\n#[test]\nfn cfg54c_fuzz_string_streams_no_delete_with_temp_key() {\n    diff(\"cfg54c\", |lib, log| unsafe {\n        let mut rng = Rng::new(SEED ^ 0x54C);\n        for &sh in &[SH_DEFAULT, SH_STRDUP, SH_ARENA] {\n            for &mode in &[HM_BINARY, HM_STRING, 2, 255, c_int::MAX] {\n                let hs = rng.next_u64() as usize;\n                log.i32v(\"sh\", sh);\n                log.i32v(\"mode\", mode);\n                fuzz_string(lib, log, &mut rng, hs, 24, sh, mode, 400, false);\n            }\n        }\n    });\n}\n\"\"\"\nopen(p,'w').write(s)\nprint(\"ok\")\nPY\ntimeout 600 cargo test --offline --test phase_b_top -- --test-threads=1 2>&1 | tail -30","description":"Restructure string fuzz and rerun"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3752,"cache_read_input_tokens":236978,"cache_creation":{"ephemeral_5m_input_tokens":3752,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"7ccbcf35-f98e-4533-a9d0-8fa1633f055f","uuid":"97d9bd21-cadf-4777-ae55-6bd7dcb7f0b5","timestamp":"2026-08-27T18:12:55.239Z"}
