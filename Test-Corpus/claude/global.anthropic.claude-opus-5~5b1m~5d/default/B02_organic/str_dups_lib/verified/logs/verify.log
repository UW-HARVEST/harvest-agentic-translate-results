const STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() as u32) * 8;\n111\t\n112\tconst HDR_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n113\t\n114\tconst STBDS_STRING_ARENA_BLOCKSIZE_MIN: usize = 512;\n115\tconst STBDS_STRING_ARENA_BLOCKSIZE_MAX: usize = 1usize << 20;\n116\t\n117\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n118\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n119\t\n120\t// ---------------------------------------------------------------------------\n121\t// Small helpers mirroring the C macros\n122\t// ---------------------------------------------------------------------------\n123\t\n124\t#[inline(always)]\n125\tfn padd(p: *mut c_void, off: usize) -> *mut c_void {\n126\t    (p as *mut u8).wrapping_add(off) as *mut c_void\n127\t}\n128\t\n129\t#[inline(always)]\n130\tfn psub(p: *mut c_void, off: usize) -> *mut c_void {\n131\t    (p as *mut u8).wrapping_sub(off) as *mut c_void\n132\t}\n133\t\n134\t/// `stbds_header(t)`\n135\t#[inline(always)]\n136\tfn stbds_header(a: *mut c_void) -> *mut stbds_array_header {\n137\t    psub(a, HDR_SIZE) as *mut stbds_array_header\n138\t}\n139\t\n140\t/// `stbds_arrlen(a)`\n141\t#[inline(always)]\n142\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n143\t    if a.is_null() {\n144\t        0\n145\t    } else {\n146\t        (*stbds_header(a)).length as isize\n147\t    }\n148\t}\n149\t\n150\t/// `stbds_arrcap(a)`\n151\t#[inline(always)]\n152\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n153\t    if a.is_null() {\n154\t        0\n155\t    } else {\n156\t        (*stbds_header(a)).capacity\n157\t    }\n158\t}\n159\t\n160\t/// `stbds_hash_table(a)`\n161\t#[inline(always)]\n162\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n163\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n164\t}\n165\t\n166\t/// `STBDS_HASH_TO_ARR(x, elemsize)`\n167\t#[inline(always)]\n168\tfn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n169\t    psub(x, elemsize)\n170\t}\n