{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0192j21cEHpQe2iDkPhkmMRE","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The C library (`c_src/src/lib.c` + `c_src/include/lib.h`) is a extracted\n4\t//! driver around cJSON's `parse_number`. Its complete public ABI, as reported by\n5\t//! `nm -D libdriver.so`, is a single exported symbol:\n6\t//!\n7\t//! ```text\n8\t//! parse_number\n9\t//! ```\n10\t//!\n11\t//! The header declares no namespace/renaming macros, so the linker name equals\n12\t//! the source-level name.\n13\t//!\n14\t//! This translation is deliberately literal: allocation is performed through\n15\t//! libc `malloc`/`free` and number conversion through libc `strtod` so that\n16\t//! behaviour (including allocation-failure handling, locale-dependent parsing,\n17\t//! rounding and `endptr` placement) is byte-for-byte identical to the C build.\n18\t//! Original bugs/quirks are preserved, notably the missing `item == NULL` check.\n19\t\n20\t#![allow(non_camel_case_types)]\n21\t#![allow(non_upper_case_globals)]\n22\t\n23\tuse core::ffi::{c_char, c_double, c_int, c_uchar, c_void};\n24\t\n25\t/* ---------------------------------------------------------------------------\n26\t * include/lib.h\n27\t * ------------------------------------------------------------------------- */\n28\t\n29\t/// `typedef int cJSON_bool;`\n30\tpub type cJSON_bool = c_int;\n31\t\n32\t/// `#define true ((cJSON_bool)1)`\n33\tconst CJSON_TRUE: cJSON_bool = 1;\n34\t/// `#define false ((cJSON_bool)0)`\n35\tconst CJSON_FALSE: cJSON_bool = 0;\n36\t\n37\t/// `#define INT_MAX __INT_MAX__`\n38\tconst INT_MAX: c_int = 2147483647;\n39\t/// `#define INT_MIN (-__INT_MAX__ - 1)`\n40\tconst INT_MIN: c_int = -2147483647 - 1;\n41\t\n42\t/// `#define cJSON_Number (1 << 3)`\n43\tconst cJSON_Number: c_int = 1 << 3;\n44\t\n45\t/// ```c\n46\t/// typedef struct\n47\t/// {\n48\t///     const unsigned char *content;\n49\t///     size_t length;\n50\t///     size_t offset;\n51\t///     size_t depth;\n52\t/// } parse_buffer;\n53\t/// ```\n54\t#[repr(C)]\n55\tpub struct parse_buffer {\n56\t    pub content: *const c_uchar,\n57\t    pub length: usize,\n58\t    pub offset: usize,\n59\t    /// How deeply nested (in arrays/objects) is the input at the current offset.\n60\t    pub depth: usize,\n61\t}\n62\t\n63\t/// ```c\n64\t/// typedef struct {\n65\t///     int type;\n66\t///     int valueint;\n67\t///     double valuedouble;\n68\t/// } cJSON;\n69\t/// ```\n70\t#[repr(C)]\n71\tpub struct cJSON {\n72\t    /// The type of the item, as above.\n73\t    pub type_: c_int,\n74\t    /// writing to valueint is DEPRECATED, use cJSON_SetNumberValue instead\n75\t    pub valueint: c_int,\n76\t    /// The item's number, if type==cJSON_Number\n77\t    pub valuedouble: c_double,\n78\t}\n79\t\n80\t/* ---------------------------------------------------------------------------\n81\t * libc bindings (stdlib.h / string.h)\n82\t * ------------------------------------------------------------------------- */\n83\t\n84\tunsafe extern \"C\" {\n85\t    fn malloc(size: usize) -> *mut c_void;\n86\t    fn free(ptr: *mut c_void);\n87\t    fn strtod(nptr: *const c_char, endptr: *mut *mut c_char) -> c_double;\n88\t}\n89\t\n90\t/* ---------------------------------------------------------------------------\n91\t * src/lib.c helper macros\n92\t * ------------------------------------------------------------------------- */\n93\t\n94\t/// `#define can_access_at_index(buffer, index) \\\n95\t///      ((buffer != NULL) && (((buffer)->offset + index) < (buffer)->length))`\n96\t#[inline]\n97\tunsafe fn can_access_at_index(buffer: *const parse_buffer, index: usize) -> bool {\n98\t    if buffer.is_null() {\n99\t        return false;\n100\t    }\n101\t    // C `size_t` arithmetic wraps; mirror that instead of panicking.\n102\t    unsafe { (*buffer).offset.wrapping_add(index) < (*buffer).length }\n103\t}\n104\t\n105\t/// `#define buffer_at_o