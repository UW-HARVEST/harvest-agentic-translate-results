     case '.':\n53\t                number_string_length++;\n54\t                has_decimal_point = true;\n55\t                break;\n56\t\n57\t            default:\n58\t                goto loop_end;\n59\t        }\n60\t    }\n61\tloop_end:\n62\t    /* malloc for temporary buffer, add 1 for '\\0' */\n63\t    number_c_string = (unsigned char *) malloc(number_string_length + 1);\n64\t    if (number_c_string == NULL)\n65\t    {\n66\t        return false; /* allocation failure */\n67\t    }\n68\t\n69\t    memcpy(number_c_string, buffer_at_offset(input_buffer), number_string_length);\n70\t    number_c_string[number_string_length] = '\\0';\n71\t\n72\t    if (has_decimal_point)\n73\t    {\n74\t        for (i = 0; i < number_string_length; i++)\n75\t        {\n76\t            if (number_c_string[i] == '.')\n77\t            {\n78\t                /* replace '.' with the decimal point of the current locale (for strtod) */\n79\t                number_c_string[i] = decimal_point;\n80\t            }\n81\t        }\n82\t    }\n83\t\n84\t    number = strtod((const char*)number_c_string, (char**)&after_end);\n85\t    if (number_c_string == after_end)\n86\t    {\n87\t        /* free the temporary buffer */\n88\t        free(number_c_string);\n89\t        return false; /* parse_error */\n90\t    }\n91\t\n92\t    item->valuedouble = number;\n93\t\n94\t    /* use saturation in case of overflow */\n95\t    if (number >= INT_MAX)\n96\t    {\n97\t        item->valueint = INT_MAX;\n98\t    }\n99\t    else if (number <= (double)INT_MIN)\n100\t    {\n101\t        item->valueint = INT_MIN;\n102\t    }\n103\t    else\n104\t    {\n105\t        item->valueint = (int)number;\n106\t    }\n107\t\n108\t    item->type = cJSON_Number;\n109\t\n110\t    input_buffer->offset += (size_t)(after_end - number_c_string);\n111\t    /* free the temporary buffer */\n112\t    free(number_c_string);\n113\t    return true;\n114\t}\n115\t"}]},"parent_tool_use_id":"toolu_bdrk_01ThJbwNsR6LWc2Y12Wd69Gw","session_id"