{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016NnoDM376FSFKB3jVFRt2y","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The C library (`c_src/src/lib.c` + `c_src/include/lib.h`) is a extracted\n4\t//! driver around cJSON's `parse_number`. Its complete public ABI, as reported by\n5\t//! `nm -D libdriver.so`, is a single exported symbol:\n6\t//!\n7\t//! ```text\n8\t//! parse_number\n9\t//! ```\n10\t//!\n11\t//! The header declares no namespace/renaming macros, so the linker name equals\n12\t//! the source-level name.\n13\t//!\n14\t//! This translation is deliberately literal: allocation is performed through\n15\t//! libc `malloc`/`free` and number conversion through libc `strtod` so that\n16\t//! behaviour (including allocation-failure handling, locale-dependent parsing,\n17\t//! rounding and `endptr` placement) is byte-for-byte identical to the C build.\n18\t//! Original bugs/quirks are preserved, notably the missing `item == NULL` check.\n19\t\n20\t#![allow(non_camel_case_types)]\n21\t#![allow(non_upper_case_globals)]\n22\t\n23\tuse core::ffi::{c_char, c_double, c_int, c_uchar, c_void};\n24\t\n25\t/* ---------------------------------------------------------------------------\n26\t * include/lib.h\n27\t * ------------------------------------------------------------------------- */\n28\t\n29\t/// `typedef int cJSON_bool;`\n30\tpub type cJSON_bool = c_int;\n31\t\n32\t/// `#define true ((cJSON_bool)1)`\n33\tconst CJSON_TRUE: cJSON_bool = 1;\n34\t/// `#define false ((cJSON_bool)0)`\n35\tconst CJSON_FALSE: cJSON_bool = 0;\n36\t\n37\t/// `#define INT_MAX __INT_MAX__`\n38\tconst INT_MAX: c_int = 2147483647;\n39\t/// `#define INT_MIN (-__INT_MAX__ - 1)`\n40\tconst INT_MIN: c_int = -2147483647 - 1;\n41\t\n42\t/// `#define cJSON_Number (1 << 3)`\n43\tconst cJSON_Number: c_int = 1 << 3;\n44\t\n45\t/// ```c\n46\t/// typedef struct\n47\t/// {\n48\t///     const unsigned char *content;\n49\t///     size_t length;\n50\t///     size_t offset;\n51\t///     size_t depth;\n52\t/// } parse_buffer;\n53\t/// ```\n54\t#[repr(C)]\n55\tpub struct parse_buffer {\n56\t    pub content: *const c_uchar,\n57\t    pub length: usize,\n58\t    pub offset: usize,\n59\t    /// How deeply nested (in arrays/objects) is the input at the current offset.\n60\t    pub depth: usize,\n61\t}\n62\t\n63\t/// ```c\n64\t/// typedef struct {\n65\t///     int type;\n66\t///     int valueint;\n67\t///     double valuedouble;\n68\t/// } cJSON;\n69\t/// ```\n70\t#[repr(C)]\n71\tpub struct cJSON {\n72\t    /// The type of the item, as above.\n73\t    pub type_: c_int,\n74\t    /// writing to valueint is DEPRECATED, use cJSON_SetNumberValue instead\n75\t    pub valueint: c_int,\n76\t    /// The item's number, if type==cJSON_Number\n77\t    pub valuedouble: c_double,\n78\t}\n79\t\n80\t/* ---------------------------------------------------------------------------\n81\t * libc bindings (stdlib.h / string.h)\n82\t * ------------------------------------------------------------------------- */\n83\t\n84\tunsafe extern \"C\" {\n85\t    fn malloc(size: usize) -> *mut c_void;\n86\t    fn free(ptr: *mut c_void);\n87\t    fn strtod(nptr: *const c_char, endptr: *mut *mut c_char) -> c_double;\n88\t}\n89\t\n90\t/* ---------------------------------------------------------------------------\n91\t * src/lib.c helper macros\n92\t * ------------------------------------------------------------------------- */\n93\t\n94\t/// `#define can_access_at_index(buffer, index) \\\n95\t///      ((buffer != NULL) && (((buffer)->offset + index) < (buffer)->length))`\n96\t#[inline]\n97\tunsafe fn can_access_at_index(buffer: *const parse_buffer, index: usize) -> bool {\n98\t    if buffer.is_null() {\n99\t        return false;\n100\t    }\n101\t    // C `size_t` arithmetic wraps; mirror that instead of panicking.\n102\t    unsafe { (*buffer).offset.wrapping_add(index) < (*buffer).length }\n103\t}\n104\t\n105\t/// `#define buffer_at_offset(buffer) ((buffer)->content + (buffer)->offset)`\n106\t#[inline]\n107\tunsafe fn buffer_at_offset(buffer: *const parse_buffer) -> *const c_uchar {\n108\t    unsafe { (*buffer).content.wrapping_add((*buffer).offset) }\n109\t}\n110\t\n111\t/* ---------------------------------------------------------------------------\n112\t * Public ABI\n113\t * ------------------------------------------------------------------------- */\n114\t\n115\t/// Parse the input text to generate a number, and populate the result into item.\n116\t///\n117\t/// ```c\n118\t/// cJSON_bool parse_number(cJSON * const item, parse_buffer * const input_buffer);\n119\t/// ```\n120\t#[unsafe(no_mangle)]\n121\tpub unsafe extern \"C\" fn parse_number(\n122\t    item: *mut cJSON,\n123\t    input_buffer: *mut parse_buffer,\n124\t) -> cJSON_bool {\n125\t    let number: c_double;\n126\t    let mut after_end: *mut c_uchar = core::ptr::null_mut();\n127\t    let number_c_string: *mut c_uchar;\n128\t    let decimal_point: c_uchar = b'.';\n129\t    let mut i: usize;\n130\t    let mut number_string_length: usize = 0;\n131\t    let mut has_decimal_point: cJSON_bool = CJSON_FALSE;\n132\t\n133\t    if input_buffer.is_null() || unsafe { (*input_buffer).content }.is_null() {\n134\t        return CJSON_FALSE;\n135\t    }\n136\t\n137\t    /* copy the number into a temporary buffer and replace '.' with the decimal point\n138\t     * of the current locale (for strtod)\n139\t     * This also takes care of '\\0' not necessarily being available for marking the end of the input */\n140\t    i = 0;\n141\t    while unsafe { can_access_at_index(input_buffer, i) } {\n142\t        let c = unsafe { *buffer_at_offset(input_buffer).wrapping_add(i) };\n143\t        match c {\n144\t            b'0' | b'1' | b'2' | b'3' | b'4' | b'5' | b'6' | b'7' | b'8' | b'9' | b'+' | b'-'\n145\t            | b'e' | b'E' => {\n146\t                number_string_length += 1;\n147\t            }\n148\t\n149\t            b'.' => {\n150\t                number_string_length += 1;\n151\t                has_decimal_point = CJSON_TRUE;\n152\t            }\n153\t\n154\t            _ => break, /* goto loop_end */\n155\t        }\n156\t        i = i.wrapping_add(1);\n157\t    }\n158\t    /* loop_end: */\n159\t\n160\t    /* malloc for temporary buffer, add 1 for '\\0' */\n161\t    number_c_string = unsafe { malloc(number_string_length.wrapping_add(1)) } as *mut c_uchar;\n162\t    if number_c_string.is_null() {\n163\t        return CJSON_FALSE; /* allocation failure */\n164\t    }\n165\t\n166\t    unsafe {\n167\t        core::ptr::copy_nonoverlapping(\n168\t            buffer_at_offset(input_buffer),\n169\t            number_c_string,\n170\t            number_string_length,\n171\t        );\n172\t        *number_c_string.wrapping_add(number_string_length) = b'\\0';\n173\t    }\n174\t\n175\t    if has_decimal_point != CJSON_FALSE {\n176\t        i = 0;\n177\t        while i < number_string_length {\n178\t            if unsafe { *number_c_string.wrapping_add(i) } == b'.' {\n179\t                /* replace '.' with the decimal point of the current locale (for strtod) */\n180\t                unsafe { *number_c_string.wrapping_add(i) = decimal_point };\n181\t            }\n182\t            i += 1;\n183\t        }\n184\t    }\n185\t\n186\t    number = unsafe {\n187\t        strtod(\n188\t            number_c_string as *const c_char,\n189\t            &mut after_end as *mut *mut c_uchar as *mut *mut c_char,\n190\t        )\n191\t    };\n192\t    if number_c_string == after_end {\n193\t        /* free the temporary buffer */\n194\t        unsafe { free(number_c_string as *mut c_void) };\n195\t        return CJSON_FALSE; /* parse_error */\n196\t    }\n197\t\n198\t    // NOTE: the original C never checks `item != NULL`; dereferencing a NULL\n199\t    // `item` faults there and faults here too. Bug preserved intentionally.\n200\t    unsafe { (*item).valuedouble = number };\n201\t\n202\t    /* use saturation in case of overflow */\n203\t    if number >= INT_MAX as c_double {\n204\t        unsafe { (*item).valueint = INT_MAX };\n205\t    } else if number <= INT_MIN as c_double {\n206\t        unsafe { (*item).valueint = INT_MIN };\n207\t    } else {\n208\t        /* C's `(int)` cast truncates toward zero; the branches above guarantee\n209\t         * the value is representable, so a plain `as` cast is exact. NaN cannot\n210\t         * reach here (the scanner above only admits [0-9+-eE.]), but mirror the\n211\t         * x86-64 `cvttsd2si` result for it anyway rather than Rust's 0. */\n212\t        let truncated = if number.is_nan() {\n213\t            INT_MIN\n214\t        } else {\n215\t            number as c_int\n216\t        };\n217\t        unsafe { (*item).valueint = truncated };\n218\t    }\n219\t\n220\t    unsafe { (*item).type_ = cJSON_Number };\n221\t\n222\t    unsafe {\n223\t        (*input_buffer).offset = (*input_buffer)\n224\t            .offset\n225\t            .wrapping_add((after_end as usize).wrapping_sub(number_c_string as usize));\n226\t    }\n227\t    /* free the temporary buffer */\n228\t    unsafe { free(number_c_string as *mut c_void) };\n229\t    CJSON_TRUE\n230\t}\n231\t"}]},"parent_tool_use_id":"toolu_bdrk_01ThJbwNsR6LWc2Y12Wd69Gw","session_id":"fa2a6c58-7039-4842-8ce7-d61e45eba7ee","uuid":"e8a1bbda-ce9c-44d1-bf2a-cc04029c0e3c","timestamp":"2026-09-05T09:30:08.445Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust line by line"}
