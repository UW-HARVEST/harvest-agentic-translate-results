{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014LYDabCGaNmpGKTepV1rJk","type":"tool_result","content":"1\t//! Port of the inline helpers from `q_shared.h` used by the driver.\n2\t\n3\tuse crate::fpu;\n4\tuse crate::q_math::q_rsqrt;\n5\t\n6\t/// `vec3_t` -- three C `float`s.\n7\tpub type Vec3 = [f32; 3];\n8\t\n9\t/// `#define DotProduct(x,y) ((x)[0]*(y)[0]+(x)[1]*(y)[1]+(x)[2]*(y)[2])`\n10\t///\n11\t/// Evaluated left to right in single precision, exactly like the C macro.\n12\tpub fn dot_product(x: &Vec3, y: &Vec3) -> f32 {\n13\t    fpu::add(\n14\t        fpu::add(fpu::mul(x[0], y[0]), fpu::mul(x[1], y[1])),\n15\t        fpu::mul(x[2], y[2]),\n16\t    )\n17\t}\n18\t\n19\t/// fast vector normalize routine that does not check to make sure\n20\t/// that length != 0, nor does it return length, uses rsqrt approximation\n21\tpub fn vector_normalize_fast(v: &mut Vec3) {\n22\t    let ilength: f32 = q_rsqrt(dot_product(v, v));\n23\t\n24\t    v[0] = fpu::mul(v[0], ilength);\n25\t    v[1] = fpu::mul(v[1], ilength);\n26\t    v[2] = fpu::mul(v[2], ilength);\n27\t}\n28\t"}]},"parent_tool_use_id":null,"session_id":"5d27ebf1-e727-4f79-ae2e-169df46ae7cb","uuid":"cef23bd7-1c9f-41da-92fb-e3e461e37e81","timestamp":"2026-08-27T15:27:49.504Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-QM7tPW/translation/src/q_shared.rs","content":"//! Port of the inline helpers from `q_shared.h` used by the driver.\n\nuse crate::fpu;\nuse crate::q_math::q_rsqrt;\n\n/// `vec3_t` -- three C `float`s.\npub type Vec3 = [f32; 3];\n\n/// `#define DotProduct(x,y) ((x)[0]*(y)[0]+(x)[1]*(y)[1]+(x)[2]*(y)[2])`\n///\n/// Evaluated left to right in single precision, exactly like the C macro.\npub fn dot_product(x: &Vec3, y: &Vec3) -> f32 {\n    fpu::add(\n        fpu::add(fpu::mul(x[0], y[0]), fpu::mul(x[1], y[1])),\n        fpu::mul(x[2], y[2]),\n    )\n}\n\n/// fast vector normalize routine that does not check to make sure\n/// that length != 0, nor does it return length, uses rsqrt approximation\npub fn vector_normalize_fast(v: &mut Vec3) {\n    let ilength: f32 = q_rsqrt(dot_product(v, v));\n\n    v[0] = fpu::mul(v[0], ilength);\n    v[1] = fpu::mul(v[1], ilength);\n    v[2] = fpu::mul(v[2], ilength);\n}\n","numLines":28,"startLine":1,"totalLines":28}}}
