{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BWr3hWLeQDZGEhAxmXTuno","type":"tool_result","content":"1\t//! Small re-implementations of the C standard library facilities used by the\n2\t//! original program: `atof()` (i.e. `strtod()` semantics) and the subset of\n3\t//! `printf()` conversion used for `\"%f\"`.\n4\t//!\n5\t//! These are needed because Rust's own float parsing/formatting differ from C\n6\t//! in several observable ways (leading whitespace, trailing garbage, hex\n7\t//! floats, `nan`/`inf` spelling, ...).\n8\t\n9\t/// C `isspace()` for the \"C\" locale.\n10\tfn is_space(c: u8) -> bool {\n11\t    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n12\t}\n13\t\n14\tfn is_digit(c: u8) -> bool {\n15\t    c.is_ascii_digit()\n16\t}\n17\t\n18\tfn hex_val(c: u8) -> Option<u32> {\n19\t    match c {\n20\t        b'0'..=b'9' => Some((c - b'0') as u32),\n21\t        b'a'..=b'f' => Some((c - b'a') as u32 + 10),\n22\t        b'A'..=b'F' => Some((c - b'A') as u32 + 10),\n23\t        _ => None,\n24\t    }\n25\t}\n26\t\n27\t/// Case-insensitive check whether `s[at..]` starts with `pat` (`pat` must be\n28\t/// lowercase ASCII).\n29\tfn starts_with_ci(s: &[u8], at: usize, pat: &[u8]) -> bool {\n30\t    if s.len() < at + pat.len() {\n31\t        return false;\n32\t    }\n33\t    s[at..at + pat.len()]\n34\t        .iter()\n35\t        .zip(pat.iter())\n36\t        .all(|(a, b)| a.to_ascii_lowercase() == *b)\n37\t}\n38\t\n39\tconst POS_NAN_BITS: u64 = 0x7ff8_0000_0000_0000;\n40\tconst NEG_NAN_BITS: u64 = 0xfff8_0000_0000_0000;\n41\t\n42\tfn signed_nan(neg: bool) -> f64 {\n43\t    f64::from_bits(if neg { NEG_NAN_BITS } else { POS_NAN_BITS })\n44\t}\n45\t\n46\t/// `nan(n-char-sequence)`: glibc stores the parsed number in the mantissa bits\n47\t/// (keeping the quiet bit set).\n48\tfn nan_with_payload(neg: bool, payload: u64) -> f64 {\n49\t    let mantissa = (payload & 0x000f_ffff_ffff_ffff) | 0x0008_0000_0000_0000;\n50\t    let sign = if neg { 1u64 << 63 } else { 0 };\n51\t    f64::from_bits(sign | 0x7ff0_0000_0000_0000 | mantissa)\n52\t}\n53\t\n54\t/// C `strtoull(s, &end, 0)` restricted to what a `nan(...)` payload may hold:\n55\t/// the whole slice must be a valid unsigned integer (no sign, no whitespace).\n56\t/// Overflow saturates at `ULLONG_MAX`, like `strtoull` does.\n57\tfn strtoull_base0(s: &[u8]) -> Option<u64> {\n58\t    if s.is_empty() {\n59\t        return None;\n60\t    }\n61\t    let (digits, base): (&[u8], u64) = if s.len() > 1 && s[0] == b'0' && (s[1] | 0x20) == b'x' {\n62\t        (&s[2..], 16)\n63\t    } else if s[0] == b'0' {\n64\t        (&s[1..], 8)\n65\t    } else {\n66\t        (s, 10)\n67\t    };\n68\t    if digits.is_empty() {\n69\t        // \"0\" is a valid (octal) zero; \"0x\" is not a complete number.\n70\t        return if base == 8 { Some(0) } else { None };\n71\t    }\n72\t    let mut acc: u64 = 0;\n73\t    let mut overflow = false;\n74\t    for &c in digits {\n75\t        let d = match hex_val(c) {\n76\t            Some(d) if (d as u64) < base => d as u64,\n77\t            _ => return None,\n78\t        };\n79\t        match acc.checked_mul(base).and_then(|v| v.checked_add(d)) {\n80\t            Some(v) => acc = v,\n81\t            None => overflow = true,\n82\t        }\n83\t    }\n84\t    if overflow {\n85\t        Some(u64::MAX)\n86\t    } else {\n87\t        Some(acc)\n88\t    }\n89\t}\n90\t\n91\tfn signed_inf(neg: bool) -> f64 {\n92\t    if neg {\n93\t        f64::NEG_INFINITY\n94\t    } else {\n95\t        f64::INFINITY\n96\t    }\n97\t}\n98\t\n99\tfn signed_zero(neg: bool) -> f64 {\n100\t    if neg {\n101\t        -0.0\n102\t    } else {\n103\t        0.0\n104\t    }\n105\t}\n106\t\n107\t/// C `atof()`: `strtod()` while ignoring the end pointer and errors.\n108\tpub fn atof(s: &[u8]) -> f64 {\n109\t    strtod(s).0\n110\t}\n111\t\n112\t/// C `strtod()`. Returns the converted value and the number of bytes consumed\n113\t/// (0 when no conversion could be performed).\n114\tpub fn strtod(s: &[u8]) -> (f64, usize) {\n115\t    let len = s.len();\n116\t    let mut i = 0usize;\n117\t\n118\t    while i < len && is_space(s[i]) {\n119\t        i += 1;\n120\t    }\n121\t\n122\t    let mut neg = false;\n123\t    if i < len && (s[i] == b'+' || s[i] == b'-') {\n124\t        neg = s[i] == b'-';\n125\t        i += 1;\n126\t    }\n127\t\n128\t    // inf / infinity\n129\t    if starts_with_ci(s, i, b\"infinity\") {\n130\t        return (signed_inf(neg), i + 8);\n131\t    }\n132\t    if starts_with_ci(s, i, b\"inf\") {\n133\t        return (signed_inf(neg), i + 3);\n134\t    }\n135\t\n136\t    // nan / nan(n-char-sequence)\n137\t    if starts_with_ci(s, i, b\"nan\") {\n138\t        let mut end = i + 3;\n139\t        let mut payload: Option<u64> = None;\n140\t        if end < len && s[end] == b'(' {\n141\t            let mut k = end + 1;\n142\t            while k < len && (s[k].is_ascii_alphanumeric() || s[k] == b'_') {\n143\t                k += 1;\n144\t            }\n145\t            if k < len && s[k] == b')' {\n146\t                payload = strtoull_base0(&s[end + 1..k]);\n147\t                end = k + 1;\n148\t            }\n149\t        }\n150\t        return match payload {\n151\t            Some(p) => (nan_with_payload(neg, p), end),\n152\t            None => (signed_nan(neg), end),\n153\t        };\n154\t    }\n155\t\n156\t    // hexadecimal floating point: 0x... / 0X...\n157\t    if i + 1 < len && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X') {\n158\t        if let Some(r) = parse_hex(s, i + 2, neg) {\n159\t            return r;\n160\t        }\n161\t        // No hex digits after the prefix: the longest valid subject sequence is\n162\t        // just \"0\", which converts to (signed) zero.\n163\t        return (signed_zero(neg), i + 1);\n164\t    }\n165\t\n166\t    parse_decimal(s, i, neg)\n167\t}\n168\t\n169\t/// Decimal form: `digits [ '.' digits ] [ ('e'|'E') [sign] digits ]`\n170\tfn parse_decimal(s: &[u8], start: usize, neg: bool) -> (f64, usize) {\n171\t    let len = s.len();\n172\t    let mut i = start;\n173\t    let mut ndigits = 0usize;\n174\t\n175\t    let int_start = i;\n176\t    while i < len && is_digit(s[i]) {\n177\t        i += 1;\n178\t        ndigits += 1;\n179\t    }\n180\t    let int_end = i;\n181\t\n182\t    let mut frac_start = i;\n183\t    let mut frac_end = i;\n184\t    if i < len && s[i] == b'.' {\n185\t        i += 1;\n186\t        frac_start = i;\n187\t        while i < len && is_digit(s[i]) {\n188\t            i += 1;\n189\t            ndigits += 1;\n190\t        }\n191\t        frac_end = i;\n192\t    }\n193\t\n194\t    if ndigits == 0 {\n195\t        // No conversion performed.\n196\t        return (0.0, 0);\n197\t    }\n198\t\n199\t    let mut end = i;\n200\t    let mut exp_text: &[u8] = b\"\";\n201\t    if i < len && (s[i] == b'e' || s[i] == b'E') {\n202\t        let mut j = i + 1;\n203\t        if j < len && (s[j] == b'+' || s[j] == b'-') {\n204\t            j += 1;\n205\t        }\n206\t        if j < len && is_digit(s[j]) {\n207\t            while j < len && is_digit(s[j]) {\n208\t                j += 1;\n209\t            }\n210\t            exp_text = &s[i + 1..j];\n211\t            end = j;\n212\t        }\n213\t    }\n214\t\n215\t    // Rebuild a string that Rust's float parser accepts (it is correctly\n216\t    // rounded, just like glibc's strtod).\n217\t    let mut text = String::with_capacity(ndigits + 8);\n218\t    if int_end > int_start {\n219\t        text.push_str(core::str::from_utf8(&s[int_start..int_end]).unwrap_or(\"0\"));\n220\t    } else {\n221\t        text.push('0');\n222\t    }\n223\t    text.push('.');\n224\t    if frac_end > frac_start {\n225\t        text.push_str(core::str::from_utf8(&s[frac_start..frac_end]).unwrap_or(\"\"));\n226\t    } else {\n227\t        text.push('0');\n228\t    }\n229\t    if !exp_text.is_empty() {\n230\t        text.push('e');\n231\t        text.push_str(core::str::from_utf8(exp_text).unwrap_or(\"0\"));\n232\t    }\n233\t\n234\t    let mut value: f64 = match text.parse::<f64>() {\n235\t        Ok(v) => v,\n236\t        Err(_) => 0.0,\n237\t    };\n238\t    if neg {\n239\t        value = -value;\n240\t    }\n241\t    (value, end)\n242\t}\n243\t\n244\t/// Hexadecimal form: `hexdigits [ '.' hexdigits ] [ ('p'|'P') [sign] digits ]`.\n245\t/// `start` points just past the `0x` prefix. Returns `None` when there is no\n246\t/// hex digit at all.\n247\tfn parse_hex(s: &[u8], start: usize, neg: bool) -> Option<(f64, usize)> {\n248\t    let len = s.len();\n249\t    let mut i = start;\n250\t\n251\t    // Mantissa collected as an integer `m` (with a sticky bit for dropped low\n252\t    // digits) scaled by 2^extra, and the number of fractional hex digits.\n253\t    let mut m: u128 = 0;\n254\t    let mut sticky = false;\n255\t    let mut extra: i64 = 0;\n256\t    let mut frac_digits: i64 = 0;\n257\t    let mut any = false;\n258\t\n259\t    const CAP: u128 = 1u128 << 100;\n260\t\n261\t    let push = |d: u32, m: &mut u128, sticky: &mut bool, extra: &mut i64| {\n262\t        if *m < CAP {\n263\t            *m = *m * 16 + d as u128;\n264\t        } else {\n265\t            *extra += 4;\n266\t            if d != 0 {\n267\t                *sticky = true;\n268\t            }\n269\t        }\n270\t    };\n271\t\n272\t    while i < len {\n273\t        match hex_val(s[i]) {\n274\t            Some(d) => {\n275\t                push(d, &mut m, &mut sticky, &mut extra);\n276\t                any = true;\n277\t                i += 1;\n278\t            }\n279\t            None => break,\n280\t        }\n281\t    }\n282\t    if i < len && s[i] == b'.' {\n283\t        i += 1;\n284\t        while i < len {\n285\t            match hex_val(s[i]) {\n286\t                Some(d) => {\n287\t                    push(d, &mut m, &mut sticky, &mut extra);\n288\t                    frac_digits += 1;\n289\t                    any = true;\n290\t                    i += 1;\n291\t                }\n292\t                None => break,\n293\t            }\n294\t        }\n295\t    }\n296\t    if !any {\n297\t        return None;\n298\t    }\n299\t\n300\t    let mut end = i;\n301\t    let mut pexp: i64 = 0;\n302\t    if i < len && (s[i] == b'p' || s[i] == b'P') {\n303\t        let mut j = i + 1;\n304\t        let mut esign: i64 = 1;\n305\t        if j < len && (s[j] == b'+' || s[j] == b'-') {\n306\t            if s[j] == b'-' {\n307\t                esign = -1;\n308\t            }\n309\t            j += 1;\n310\t        }\n311\t        if j < len && is_digit(s[j]) {\n312\t            let mut v: i64 = 0;\n313\t            while j < len && is_digit(s[j]) {\n314\t                v = (v * 10 + (s[j] - b'0') as i64).min(1_000_000);\n315\t                j += 1;\n316\t            }\n317\t            pexp = esign * v;\n318\t            end = j;\n319\t        }\n320\t    }\n321\t\n322\t    let exp = (pexp + extra - 4 * frac_digits).clamp(-2_000_000, 2_000_000) as i32;\n323\t    Some((make_f64(neg, m, sticky, exp), end))\n324\t}\n325\t\n326\t/// Round `(-1)^neg * m * 2^exp` (with `sticky` marking discarded nonzero low\n327\t/// bits) to the nearest `f64`, ties to even.\n328\tfn make_f64(neg: bool, m: u128, sticky: bool, exp: i32) -> f64 {\n329\t    let mut m = m;\n330\t    let mut sticky = sticky;\n331\t    let mut exp: i64 = exp as i64;\n332\t\n333\t    if m == 0 {\n334\t        // Digits are only ever dropped once `m` is huge, so `sticky` cannot be\n335\t        // set here: the value really is zero.\n336\t        return signed_zero(neg);\n337\t    }\n338\t\n339\t    // Make room so the sticky bit can be folded into bit 0 without changing the\n340\t    // rounding decision, then keep the mantissa reasonably small.\n341\t    let bl = |v: u128| -> i64 { 128 - v.leading_zeros() as i64 };\n342\t\n343\t    if bl(m) < 56 {\n344\t        let sh = 56 - bl(m);\n345\t        m <<= sh as u32;\n346\t        exp -= sh;\n347\t    }\n348\t    if bl(m) > 64 {\n349\t        let sh = bl(m) - 64;\n350\t        let mask = (1u128 << sh as u32) - 1;\n351\t        if m & mask != 0 {\n352\t            sticky = true;\n353\t        }\n354\t        m >>= sh as u32;\n355\t        exp += sh;\n356\t    }\n357\t    if sticky {\n358\t        m |= 1;\n359\t    }\n360\t\n361\t    let mlen = bl(m); // 56 ..= 64\n362\t    let e_unbiased = exp + mlen - 1;\n363\t\n364\t    // Number of low bits to discard.\n365\t    let mut drop = mlen - 53;\n366\t    if e_unbiased < -1022 {\n367\t        // Subnormal result: quantum is 2^-1074.\n368\t        drop = -1074 - exp;\n369\t        if drop >= mlen + 2 {\n370\t            return signed_zero(neg);\n371\t        }\n372\t        if drop <= 0 {\n373\t            drop = 0;\n374\t        }\n375\t    }\n376\t\n377\t    let mut q: u128;\n378\t    let e2: i64;\n379\t    if drop <= 0 {\n380\t        q = m;\n381\t        e2 = exp;\n382\t    } else {\n383\t        let shift = drop as u32;\n384\t        let lost = m & ((1u128 << shift) - 1);\n385\t        let half = 1u128 << (shift - 1);\n386\t        q = m >> shift;\n387\t        if lost > half || (lost == half && (q & 1) == 1) {\n388\t            q += 1;\n389\t        }\n390\t        e2 = exp + drop;\n391\t    }\n392\t\n393\t    if q == 0 {\n394\t        return signed_zero(neg);\n395\t    }\n396\t\n397\t    let qlen = bl(q);\n398\t    let e = e2 + qlen - 1; // unbiased exponent of the rounded value\n399\t\n400\t    let sign_bits: u64 = if neg { 1u64 << 63 } else { 0 };\n401\t\n402\t    if e > 1023 {\n403\t        return signed_inf(neg);\n404\t    }\n405\t    if e >= -1022 {\n406\t        // Normal number: q has at most 53 significant bits here.\n407\t        let frac = if qlen >= 53 {\n408\t            (q >> (qlen - 53) as u32) as u64\n409\t        } else {\n410\t            (q as u64) << (53 - qlen) as u32\n411\t        } & ((1u64 << 52) - 1);\n412\t        let biased = (e + 1023) as u64;\n413\t        f64::from_bits(sign_bits | (biased << 52) | frac)\n414\t    } else {\n415\t        // Subnormal: value is q * 2^e2 with e2 >= -1074.\n416\t        let sh = e2 + 1074;\n417\t        let bits = if sh >= 0 {\n418\t            (q as u64) << sh as u32\n419\t        } else {\n420\t            (q >> (-sh) as u32) as u64\n421\t        };\n422\t        f64::from_bits(sign_bits | (bits & ((1u64 << 52) - 1)))\n423\t    }\n424\t}\n425\t\n426\t/// `printf(\"%f\", x)` where the argument is a C `float` that the default\n427\t/// argument promotions widen to `double`. The sign of a NaN is taken from the\n428\t/// `float` itself so that nothing depends on how a float-to-double cast treats\n429\t/// NaN payloads.\n430\tpub fn printf_f_float(x: f32) -> String {\n431\t    if x.is_nan() {\n432\t        return if x.is_sign_negative() {\n433\t            \"-nan\".to_string()\n434\t        } else {\n435\t            \"nan\".to_string()\n436\t        };\n437\t    }\n438\t    printf_f(x as f64)\n439\t}\n440\t\n441\t/// Format a `double` the way glibc's `printf(\"%f\", x)` does.\n442\tpub fn printf_f(x: f64) -> String {\n443\t    if x.is_nan() {\n444\t        return if x.is_sign_negative() {\n445\t            \"-nan\".to_string()\n446\t        } else {\n447\t            \"nan\".to_string()\n448\t        };\n449\t    }\n450\t    if x.is_infinite() {\n451\t        return if x.is_sign_negative() {\n452\t            \"-inf\".to_string()\n453\t        } else {\n454\t            \"inf\".to_string()\n455\t        };\n456\t    }\n457\t    format!(\"{:.6}\", x)\n458\t}\n459\t"}]},"parent_tool_use_id":null,"session_id":"5d27ebf1-e727-4f79-ae2e-169df46ae7cb","uuid":"ccb64332-adb1-4bb9-993b-d6b1d4c304e3","timestamp":"2026-08-27T15:27:53.837Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-QM7tPW/translation/src/cstd.rs","content":"//! Small re-implementations of the C standard library facilities used by the\n//! original program: `atof()` (i.e. `strtod()` semantics) and the subset of\n//! `printf()` conversion used for `\"%f\"`.\n//!\n//! These are needed because Rust's own float parsing/formatting differ from C\n//! in several observable ways (leading whitespace, trailing garbage, hex\n//! floats, `nan`/`inf` spelling, ...).\n\n/// C `isspace()` for the \"C\" locale.\nfn is_space(c: u8) -> bool {\n    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n}\n\nfn is_digit(c: u8) -> bool {\n    c.is_ascii_digit()\n}\n\nfn hex_val(c: u8) -> Option<u32> {\n    match c {\n        b'0'..=b'9' => Some((c - b'0') as u32),\n        b'a'..=b'f' => Some((c - b'a') as u32 + 10),\n        b'A'..=b'F' => Some((c - b'A') as u32 + 10),\n        _ => None,\n    }\n}\n\n/// Case-insensitive check whether `s[at..]` starts with `pat` (`pat` must be\n/// lowercase ASCII).\nfn starts_with_ci(s: &[u8], at: usize, pat: &[u8]) -> bool {\n    if s.len() < at + pat.len() {\n        return false;\n    }\n    s[at..at + pat.len()]\n        .iter()\n        .zip(pat.iter())\n        .all(|(a, b)| a.to_ascii_lowercase() == *b)\n}\n\nconst POS_NAN_BITS: u64 = 0x7ff8_0000_0000_0000;\nconst NEG_NAN_BITS: u64 = 0xfff8_0000_0000_0000;\n\nfn signed_nan(neg: bool) -> f64 {\n    f64::from_bits(if neg { NEG_NAN_BITS } else { POS_NAN_BITS })\n}\n\n/// `nan(n-char-sequence)`: glibc stores the parsed number in the mantissa bits\n/// (keeping the quiet bit set).\nfn nan_with_payload(neg: bool, payload: u64) -> f64 {\n    let mantissa = (payload & 0x000f_ffff_ffff_ffff) | 0x0008_0000_0000_0000;\n    let sign = if neg { 1u64 << 63 } else { 0 };\n    f64::from_bits(sign | 0x7ff0_0000_0000_0000 | mantissa)\n}\n\n/// C `strtoull(s, &end, 0)` restricted to what a `nan(...)` payload may hold:\n/// the whole slice must be a valid unsigned integer (no sign, no whitespace).\n/// Overflow saturates at `ULLONG_MAX`, like `strtoull` does.\nfn strtoull_base0(s: &[u8]) -> Option<u64> {\n    if s.is_empty() {\n        return None;\n    }\n    let (digits, base): (&[u8], u64) = if s.len() > 1 && s[0] == b'0' && (s[1] | 0x20) == b'x' {\n        (&s[2..], 16)\n    } else if s[0] == b'0' {\n        (&s[1..], 8)\n    } else {\n        (s, 10)\n    };\n    if digits.is_empty() {\n        // \"0\" is a valid (octal) zero; \"0x\" is not a complete number.\n        return if base == 8 { Some(0) } else { None };\n    }\n    let mut acc: u64 = 0;\n    let mut overflow = false;\n    for &c in digits {\n        let d = match hex_val(c) {\n            Some(d) if (d as u64) < base => d as u64,\n            _ => return None,\n        };\n        match acc.checked_mul(base).and_then(|v| v.checked_add(d)) {\n            Some(v) => acc = v,\n            None => overflow = true,\n        }\n    }\n    if overflow {\n        Some(u64::MAX)\n    } else {\n        Some(acc)\n    }\n}\n\nfn signed_inf(neg: bool) -> f64 {\n    if neg {\n        f64::NEG_INFINITY\n    } else {\n        f64::INFINITY\n    }\n}\n\nfn signed_zero(neg: bool) -> f64 {\n    if neg {\n        -0.0\n    } else {\n        0.0\n    }\n}\n\n/// C `atof()`: `strtod()` while ignoring the end pointer and errors.\npub fn atof(s: &[u8]) -> f64 {\n    strtod(s).0\n}\n\n/// C `strtod()`. Returns the converted value and the number of bytes consumed\n/// (0 when no conversion could be performed).\npub fn strtod(s: &[u8]) -> (f64, usize) {\n    let len = s.len();\n    let mut i = 0usize;\n\n    while i < len && is_space(s[i]) {\n        i += 1;\n    }\n\n    let mut neg = false;\n    if i < len && (s[i] == b'+' || s[i] == b'-') {\n        neg = s[i] == b'-';\n        i += 1;\n    }\n\n    // inf / infinity\n    if starts_with_ci(s, i, b\"infinity\") {\n        return (signed_inf(neg), i + 8);\n    }\n    if starts_with_ci(s, i, b\"inf\") {\n        return (signed_inf(neg), i + 3);\n    }\n\n    // nan / nan(n-char-sequence)\n    if starts_with_ci(s, i, b\"nan\") {\n        let mut end = i + 3;\n        let mut payload: Option<u64> = None;\n        if end < len && s[end] == b'(' {\n            let mut k = end + 1;\n            while k < len && (s[k].is_ascii_alphanumeric() || s[k] == b'_') {\n                k += 1;\n            }\n            if k < len && s[k] == b')' {\n                payload = strtoull_base0(&s[end + 1..k]);\n                end = k + 1;\n            }\n        }\n        return match payload {\n            Some(p) => (nan_with_payload(neg, p), end),\n            None => (signed_nan(neg), end),\n        };\n    }\n\n    // hexadecimal floating point: 0x... / 0X...\n    if i + 1 < len && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X') {\n        if let Some(r) = parse_hex(s, i + 2, neg) {\n            return r;\n        }\n        // No hex digits after the prefix: the longest valid subject sequence is\n        // just \"0\", which converts to (signed) zero.\n        return (signed_zero(neg), i + 1);\n    }\n\n    parse_decimal(s, i, neg)\n}\n\n/// Decimal form: `digits [ '.' digits ] [ ('e'|'E') [sign] digits ]`\nfn parse_decimal(s: &[u8], start: usize, neg: bool) -> (f64, usize) {\n    let len = s.len();\n    let mut i = start;\n    let mut ndigits = 0usize;\n\n    let int_start = i;\n    while i < len && is_digit(s[i]) {\n        i += 1;\n        ndigits += 1;\n    }\n    let int_end = i;\n\n    let mut frac_start = i;\n    let mut frac_end = i;\n    if i < len && s[i] == b'.' {\n        i += 1;\n        frac_start = i;\n        while i < len && is_digit(s[i]) {\n            i += 1;\n            ndigits += 1;\n        }\n        frac_end = i;\n    }\n\n    if ndigits == 0 {\n        // No conversion performed.\n        return (0.0, 0);\n    }\n\n    let mut end = i;\n    let mut exp_text: &[u8] = b\"\";\n    if i < len && (s[i] == b'e' || s[i] == b'E') {\n        let mut j = i + 1;\n        if j < len && (s[j] == b'+' || s[j] == b'-') {\n            j += 1;\n        }\n        if j < len && is_digit(s[j]) {\n            while j < len && is_digit(s[j]) {\n                j += 1;\n            }\n            exp_text = &s[i + 1..j];\n            end = j;\n        }\n    }\n\n    // Rebuild a string that Rust's float parser accepts (it is correctly\n    // rounded, just like glibc's strtod).\n    let mut text = String::with_capacity(ndigits + 8);\n    if int_end > int_start {\n        text.push_str(core::str::from_utf8(&s[int_start..int_end]).unwrap_or(\"0\"));\n    } else {\n        text.push('0');\n    }\n    text.push('.');\n    if frac_end > frac_start {\n        text.push_str(core::str::from_utf8(&s[frac_start..frac_end]).unwrap_or(\"\"));\n    } else {\n        text.push('0');\n    }\n    if !exp_text.is_empty() {\n        text.push('e');\n        text.push_str(core::str::from_utf8(exp_text).unwrap_or(\"0\"));\n    }\n\n    let mut value: f64 = match text.parse::<f64>() {\n        Ok(v) => v,\n        Err(_) => 0.0,\n    };\n    if neg {\n        value = -value;\n    }\n    (value, end)\n}\n\n/// Hexadecimal form: `hexdigits [ '.' hexdigits ] [ ('p'|'P') [sign] digits ]`.\n/// `start` points just past the `0x` prefix. Returns `None` when there is no\n/// hex digit at all.\nfn parse_hex(s: &[u8], start: usize, neg: bool) -> Option<(f64, usize)> {\n    let len = s.len();\n    let mut i = start;\n\n    // Mantissa collected as an integer `m` (with a sticky bit for dropped low\n    // digits) scaled by 2^extra, and the number of fractional hex digits.\n    let mut m: u128 = 0;\n    let mut sticky = false;\n    let mut extra: i64 = 0;\n    let mut frac_digits: i64 = 0;\n    let mut any = false;\n\n    const CAP: u128 = 1u128 << 100;\n\n    let push = |d: u32, m: &mut u128, sticky: &mut bool, extra: &mut i64| {\n        if *m < CAP {\n            *m = *m * 16 + d as u128;\n        } else {\n            *extra += 4;\n            if d != 0 {\n                *sticky = true;\n            }\n        }\n    };\n\n    while i < len {\n        match hex_val(s[i]) {\n            Some(d) => {\n                push(d, &mut m, &mut sticky, &mut extra);\n                any = true;\n                i += 1;\n            }\n            None => break,\n        }\n    }\n    if i < len && s[i] == b'.' {\n        i += 1;\n        while i < len {\n            match hex_val(s[i]) {\n                Some(d) => {\n                    push(d, &mut m, &mut sticky, &mut extra);\n                    frac_digits += 1;\n                    any = true;\n                    i += 1;\n                }\n                None => break,\n            }\n        }\n    }\n    if !any {\n        return None;\n    }\n\n    let mut end = i;\n    let mut pexp: i64 = 0;\n    if i < len && (s[i] == b'p' || s[i] == b'P') {\n        let mut j = i + 1;\n        let mut esign: i64 = 1;\n        if j < len && (s[j] == b'+' || s[j] == b'-') {\n            if s[j] == b'-' {\n                esign = -1;\n            }\n            j += 1;\n        }\n        if j < len && is_digit(s[j]) {\n            let mut v: i64 = 0;\n            while j < len && is_digit(s[j]) {\n                v = (v * 10 + (s[j] - b'0') as i64).min(1_000_000);\n                j += 1;\n            }\n            pexp = esign * v;\n            end = j;\n        }\n    }\n\n    let exp = (pexp + extra - 4 * frac_digits).clamp(-2_000_000, 2_000_000) as i32;\n    Some((make_f64(neg, m, sticky, exp), end))\n}\n\n/// Round `(-1)^neg * m * 2^exp` (with `sticky` marking discarded nonzero low\n/// bits) to the nearest `f64`, ties to even.\nfn make_f64(neg: bool, m: u128, sticky: bool, exp: i32) -> f64 {\n    let mut m = m;\n    let mut sticky = sticky;\n    let mut exp: i64 = exp as i64;\n\n    if m == 0 {\n        // Digits are only ever dropped once `m` is huge, so `sticky` cannot be\n        // set here: the value really is zero.\n        return signed_zero(neg);\n    }\n\n    // Make room so the sticky bit can be folded into bit 0 without changing the\n    // rounding decision, then keep the mantissa reasonably small.\n    let bl = |v: u128| -> i64 { 128 - v.leading_zeros() as i64 };\n\n    if bl(m) < 56 {\n        let sh = 56 - bl(m);\n        m <<= sh as u32;\n        exp -= sh;\n    }\n    if bl(m) > 64 {\n        let sh = bl(m) - 64;\n        let mask = (1u128 << sh as u32) - 1;\n        if m & mask != 0 {\n            sticky = true;\n        }\n        m >>= sh as u32;\n        exp += sh;\n    }\n    if sticky {\n        m |= 1;\n    }\n\n    let mlen = bl(m); // 56 ..= 64\n    let e_unbiased = exp + mlen - 1;\n\n    // Number of low bits to discard.\n    let mut drop = mlen - 53;\n    if e_unbiased < -1022 {\n        // Subnormal result: quantum is 2^-1074.\n        drop = -1074 - exp;\n        if drop >= mlen + 2 {\n            return signed_zero(neg);\n        }\n        if drop <= 0 {\n            drop = 0;\n        }\n    }\n\n    let mut q: u128;\n    let e2: i64;\n    if drop <= 0 {\n        q = m;\n        e2 = exp;\n    } else {\n        let shift = drop as u32;\n        let lost = m & ((1u128 << shift) - 1);\n        let half = 1u128 << (shift - 1);\n        q = m >> shift;\n        if lost > half || (lost == half && (q & 1) == 1) {\n            q += 1;\n        }\n        e2 = exp + drop;\n    }\n\n    if q == 0 {\n        return signed_zero(neg);\n    }\n\n    let qlen = bl(q);\n    let e = e2 + qlen - 1; // unbiased exponent of the rounded value\n\n    let sign_bits: u64 = if neg { 1u64 << 63 } else { 0 };\n\n    if e > 1023 {\n        return signed_inf(neg);\n    }\n    if e >= -1022 {\n        // Normal number: q has at most 53 significant bits here.\n        let frac = if qlen >= 53 {\n            (q >> (qlen - 53) as u32) as u64\n        } else {\n            (q as u64) << (53 - qlen) as u32\n        } & ((1u64 << 52) - 1);\n        let biased = (e + 1023) as u64;\n        f64::from_bits(sign_bits | (biased << 52) | frac)\n    } else {\n        // Subnormal: value is q * 2^e2 with e2 >= -1074.\n        let sh = e2 + 1074;\n        let bits = if sh >= 0 {\n            (q as u64) << sh as u32\n        } else {\n            (q >> (-sh) as u32) as u64\n        };\n        f64::from_bits(sign_bits | (bits & ((1u64 << 52) - 1)))\n    }\n}\n\n/// `printf(\"%f\", x)` where the argument is a C `float` that the default\n/// argument promotions widen to `double`. The sign of a NaN is taken from the\n/// `float` itself so that nothing depends on how a float-to-double cast treats\n/// NaN payloads.\npub fn printf_f_float(x: f32) -> String {\n    if x.is_nan() {\n        return if x.is_sign_negative() {\n            \"-nan\".to_string()\n        } else {\n            \"nan\".to_string()\n        };\n    }\n    printf_f(x as f64)\n}\n\n/// Format a `double` the way glibc's `printf(\"%f\", x)` does.\npub fn printf_f(x: f64) -> String {\n    if x.is_nan() {\n        return if x.is_sign_negative() {\n            \"-nan\".to_string()\n        } else {\n            \"nan\".to_string()\n        };\n    }\n    if x.is_infinite() {\n        return if x.is_sign_negative() {\n            \"-inf\".to_string()\n        } else {\n            \"inf\".to_string()\n        };\n    }\n    format!(\"{:.6}\", x)\n}\n","numLines":459,"startLine":1,"totalLines":459}}}
