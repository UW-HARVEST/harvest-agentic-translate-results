        ((t_index *) stbds_header((char*)m - sizeof *m)->hash_table)->slot_count);\n    45\t  dump_table(m, sizeof *m, \"emptied\");\n    46\t  hmfree(m);\n    47\t  printf(\"freed=%d len=%td\\n\", m == NULL, hmlen(m));\n    48\t}\n    49\t\n    50\tstatic void test_hmap_struct(void)\n    51\t{\n    52\t\n    53\tstatic void test_smap(int mode)\n    54\t{\n    55\t  struct { char *key; int value; } *m = NULL;\n    56\t  int i;\n    57\t  printf(\"== smap mode %d ==\\n\", mode);\n    58\t  stbds_rand_seed(0x1234abcd);\n    59\t  if (mode == STBDS_SH_ARENA) sh_new_arena(m);\n    60\t  else if (mode == STBDS_SH_STRDUP) sh_new_strdup(m);\n    61\t  dump_table(m, sizeof *m, \"fresh\");\n    62\t  for (i = 0; i < 30; ++i) {\n    63\t    char *k = skey(i);\n    64\t    shput(m, k, i * 11);\n    65\t    printf(\"shput %2d '%s': len=%td temp=%td samekey=%d\\n\", i, k, shlen(m),\n    66\t           stbds_temp(m - 1), m[stbds_temp(m - 1)].key == k);\n    67\t  }\n    68\t  dump_table(m, sizeof *m, \"s30\");\n    69\t  printf(\"order:\"); for (i = 0; i < shlen(m); ++i) printf(\" %s=%d\", m[i].key, m[i].value); printf(\"\\n\");\n    70\t  for (i = 0; i < 35; ++i) {\n    71\t    char *k = skey(i);\n    72\t    printf(\"shgeti %2d = %td get=%d null=%d\\n\", i, shgeti(m, k), shget(m, k), shgetp_null(m, k) != NULL);\n    73\t  }\n    74\t  printf(\"shputi again: %td\\n\", (ptrdiff_t) shputi(m, skey(3), 77));\n    75\t  printf(\"get3=%d\\n\", shget(m, skey(3)));\n    76\t  for (i = 0; i < 30; i += 3) printf(\"shdel %2d -> %td len=%td\\n\", i, (ptrdiff_t) shdel(m, skey(i)), shlen(m));\n    77\t  dump_table(m, sizeof *m, \"s30-del\");\n    78\t  printf(\"order:\"); for (i = 0; i < shlen(m); ++i) printf(\" %s=%d\", m[i].key, m[i].value); printf(\"\\n\");\n    79\t  for (i = 0; i < 30; ++i) printf(\"post shgeti %2d = %td\\n\", i, shgeti(m, skey(i)));\n    80\t  /* re-insert */\n    81\t  for (i = 0; i < 30; i += 3) shput(m, skey(i), 1000 + i);\n    82\t  dump_table(m, sizeof *m, \"s30-re\");\n    83\t  printf(\"order:\"); for (i = 0; i < shlen(m); ++i) printf(\" %s=%d\", m[i].key, m[i].value); printf(\"\\n\");\n    84\t  /* shputs */\n    85\t  {\n    86\t    struct { char *key; int value; } e;\n    87\t    e.key = skey(500); e.value = 5000;\n    88\t    shputs(m, e);\n    89\t    printf(\"shputs: len=%td key='%s' owned=%d\\n\", shlen(m), m[stbds_temp(m-1)].key,\n    90\t           m[stbds_temp(m-1)].key != e.key);\n    91\t  }\n    92\t  /* long keys to stress the arena */\n    93\t  {\n    94\t    static char big[600];\n    95\t    size_t j;\n    96\t    for (j = 0; j < sizeof big - 1; ++j) big[j] = (char) ('a' + (j % 26));\n    97\t    big[sizeof big - 1] = 0;\n    98\t    shput(m, big, 4242);\n    99\t    printf(\"bigkey: len=%td get=%d len_of_key=%zu\\n\", shlen(m), shget(m, big),\n   100\t           strlen(m[stbds_temp(m-1)].key));\n   101\t    big[300] = 0;\n   102\t    shput(m, big, 4343);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
