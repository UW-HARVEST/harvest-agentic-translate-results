key(a) = *(char **) ((char *) a + elemsize*i) = (char *) key; break;\n789\t         default:                memcpy((char *) a + elemsize*i, key, keysize); break;\n790\t      }\n791\t    }\n792\t    return STBDS_ARR_TO_HASH(a,elemsize);\n793\t  }\n794\t}\n795\t\n796\tvoid * stbds_shmode_func(size_t elemsize, int mode)\n797\t{\n798\t  void *a = stbds_arrgrowf(0, elemsize, 0, 1);\n799\t  stbds_hash_index *h;\n800\t  memset(a, 0, elemsize);\n801\t  stbds_header(a)->length = 1;\n802\t  stbds_header(a)->hash_table = h = (stbds_hash_index *) stbds_make_hash_index(STBDS_BUCKET_LENGTH, NULL);\n803\t  h->string.mode = (unsigned char) mode;\n804\t  return STBDS_ARR_TO_HASH(a,elemsize);\n805\t}\n806\t\n807\tvoid * stbds_hmdel_key(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode)\n808\t{\n809\t  if (a == NULL) {\n810\t    return 0;\n811\t  } else {\n812\t    stbds_hash_index *table;\n813\t    void *raw_a = STBDS_HASH_TO_ARR(a,elemsize);\n814\t    table = (stbds_hash_index *) stbds_header(raw_a)->hash_table;\n815\t    stbds_temp(raw_a) = 0;\n816\t    if (table == 0) {\n817\t      return a;\n818\t    } else {\n819\t      ptrdiff_t slot;\n820\t      slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n821\t      if (slot < 0)\n822\t        return a;\n823\t      else {\n824\t        stbds_hash_bucket *b = &table->storage[slot >> STBDS_BUCKET_SHIFT];\n825\t        int i = slot & STBDS_BUCKET_MASK;\n826\t        ptrdiff_t old_index = b->index[i];\n827\t        ptrdiff_t final_index = (ptrdiff_t) stbds_arrlen(raw_a)-1-1;\n828\t        STBDS_ASSERT(slot < (ptrdiff_t) table->slot_count);\n829\t        --table->used_count;\n830\t        ++table->tombstone_count;\n831\t        stbds_temp(raw_a) = 1;\n832\t        STBDS_ASSERT(table->used_count >= 0);\n833\t        b->hash[i] = STBDS_HASH_DELETED;\n834\t        b->index[i] = STBDS_INDEX_DELETED;\n835\t\n836\t        if (mode == STBDS_HM_STRING && table->string.mode == STBDS_SH_STRDUP)\n837\t          STBDS_FREE(NULL, *(char**) ((char *) a+elemsize*old_index));\n838\t\n839\t        if (old_index != final_index) {\n840\t          memmove((char*) a + elemsize*old_index, (char*) a + elemsize*final_index, elemsize);\n841\t\n842\t          if (mode == STBDS_HM_STRING)\n843\t            slot = stbds_hm_find_slot(a, elemsize, *(char**) ((char *) a+elemsize*old_index + keyoffset), keysize, keyoffset, mode);\n844\t          else\n845\t            slot = stbds_hm_find_slot(a, elemsize,  (char* ) a+elemsize*old_index + keyoffset, keysize, keyoffset, mode);\n846\t          STBDS_ASSERT(slot >= 0);\n847\t          b = &table->storage[slot >> STBDS_BUCKET_SHIFT];\n848\t          i = slot & STBDS_BUCKET_MASK;\n849\t          STBDS_ASSERT(b->index[i] == final_index);\n850\t          b->index[i] = old_index;\n851\t        }\n852\t        stbds_header(raw_a)->length -= 1;\n853\t\n854\t        if (table->used_count < table->used_count_shrink_threshold && table->slot_count > STBDS_BUCKET_LENGTH) {\n855\t          stbds_header(raw_a)->hash_table = stbds_make_hash_index(table->slot_count>>1, table);\n856\t          STBDS_FREE(NULL, table);\n857\t          STBDS_STATS(++stbds_hash_shrink);\n858\t        } else if (table->tombstone_count > table->tombstone_count_threshold) {\n859\t          stbds_header(raw_a)->hash_table = stbds_make_hash_index(table->slot_count   , table);\n860\t          STBDS_FREE(NULL, table);\n861\t          STBDS_STATS(++stbds_hash_rebuild);\n862\t        }\n863\t\n864\t        return a;\n865\t      }\n866\t    }\n867\t  }\n868\t}\n869\t\n870\tstatic char *stbds_strdup(char *str)\n871\t{\n872\t  size_t len = strlen(str)+1;\n873\t  char *p = (char*) STBDS_REALLOC(NULL, 0, len);\n874\t  memmove(p, str, len);\n875\t  return p;\n876\t}\n877\t\n878\t#define STBDS_STRING_ARENA_BLOCKSIZE_MIN  512u\n879\t#define STBDS_STRING_ARENA_BLOCKSIZE_MAX  (1u<<20)\n880\t\n881\tchar *stbds_stralloc(stbds_string_arena *a, char *str)\n882\t{\n883\t  char *p;\n884\t  size_t len = strlen(str)+1;\n885\t  if (len > a->remaining) {\n886\t    size_t blocksize = a->block;\n887\t\n888\t    blocksize = (size_t) (STBDS_STRING_ARENA_BLOCKSIZE_MIN) << (blocksize>>1);\n889\t\n890\t    if (blocksize < (size_t)(STBDS_STRING_ARENA_BLOCKSIZE_MAX))\n891\t      ++a->block;\n892\t\n893\t    if (len > blocksize) {\n894\t      stbds_string_block *sb = (stbds_string_block *) STBDS_REALLOC(NULL, 0, sizeof(*sb)-8 + len);\n895\t      memmove(sb->storage, str, len);\n896\t      if (a->storage) {\n897\t        sb->next = a->storage->next;\n898\t        a->storage->next = sb;\n899\t      } else {\n900\t        sb->next = 0;\n901\t        a->storage = sb;\n902\t        a->remaining = 0;\n903\t      }\n904\t      return sb->storage;\n905\t    } else {\n906\t      stbds_string_block *sb = (stbds_string_block *) STBDS_REALLOC(NULL, 0, sizeof(*sb)-8 + blocksize);\n907\t      sb->next = a->storage;\n908\t      a->storage = sb;\n909\t      a->remaining = blocksize;\n910\t    }\n911\t  }\n912\t\n913\t  STBDS_ASSERT(len <= a->remaining);\n914\t  p = a->storage->storage + a->remaining - len;\n915\t  a->remaining -= len;\n916\t  memmove(p, str, len);\n917\t  return p;\n918\t}\n919\t\n920\tvoid stbds_strreset(stbds_string_arena *a)\n921\t{\n922\t  stbds_string_block *x,*y;\n923\t  x = a->storage;\n924\t  while (x) {\n925\t    y = x->next;\n926\t    STBDS_FREE(NULL, x);\n927\t    x = y;\n928\t  }\n929\t  memset(a, 0, sizeof(*a));\n930\t}\n931\t\n932\t#include <stdio.h>\n933\t#include <assert.h>\n934\t\n935\ttypedef struct { int key,b,c,d; } stbds_struct;\n936\ttypedef struct { int key[2],b,c,d; } stbds_struct2;\n937\t\n938\tstatic char buffer[256];\n939\tchar *strkey(int n)\n940\t{\n941\t   sprintf(buffer, \"test_%d\", n);\n942\t   return buffer;\n943\t}\n944\t\n945\tvoid arr_push(int num)\n946\t{\n947\t  int *arr=NULL;\n948\t  int i,j;\n949\t\n950\t  STBDS_ASSERT(arrlen(arr)==0);\n951\t  for (i=0; i < num; i += 50) {\n952\t    for (j=0; j < i; ++j)\n953\t      arrpush(arr,j)