{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016aZvu3fehRaxWhXVbN36Yi","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-work-4nlDhF/_test/harness.c has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"8c82c996-e8ab-4c72-9ae0-43a5e7416901","uuid":"1edb62f8-67a0-4304-8201-3fb7f44685dc","timestamp":"2026-08-27T05:04:59.486Z","tool_use_result":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-4nlDhF/_test/harness.c","oldString":"          void *v = stbds_arrgrowf(NULL, es[x], add[y], mc[z]);\n          stbds_array_header *h = stbds_header(v);\n          printf(\"grow(%zu,%zu,%zu): len=%zu cap=%zu temp=%td ht=%d\",","newString":"          void *v = stbds_arrgrowf(NULL, es[x], add[y], mc[z]);\n          stbds_array_header *h;\n          if (v == NULL) { printf(\"grow(%zu,%zu,%zu): NULL\\n\", es[x], add[y], mc[z]); continue; }\n          h = stbds_header(v);\n          printf(\"grow(%zu,%zu,%zu): len=%zu cap=%zu temp=%td ht=%d\",","originalFile":"/* Differential test harness: linked against either the C or the Rust .so.\n   Prints only deterministic, address-independent data.\n   The SAME object file is linked against both libraries, so any\n   evaluation-order choices are identical for both runs. */\n#include <stdio.h>\n#include <stdint.h>\n#include \"stbds.h\"\n\n/* mirror of the internal hash index so we can dump exact internal state */\n#define BL 8\ntypedef struct { size_t hash[BL]; ptrdiff_t index[BL]; } t_bucket;\ntypedef struct {\n  char * temp_key;\n  size_t slot_count, used_count, used_count_threshold, used_count_shrink_threshold;\n  size_t tombstone_count, tombstone_count_threshold, seed, slot_count_log2;\n  struct stbds_string_arena string;\n  t_bucket *storage;\n} t_index;\n\ntypedef struct { int key,b,c,d; } stbds_struct;\ntypedef struct { int key[2],b,c,d; } stbds_struct2;\ntypedef struct { int key; int value; } imap;\ntypedef struct { char *key; int value; } smap;\n\nstatic void dump_hdr(void *arrbase, const char *tag)\n{\n  stbds_array_header *h = stbds_header(arrbase);\n  printf(\"  [%s] len=%zu cap=%zu temp=%td ht=%d\\n\", tag, h->length, h->capacity, h->temp,\n         h->hash_table != NULL);\n}\n\nstatic t_index *tbl(void *hashptr, size_t elemsize)\n{\n  char *arrbase = (char *) hashptr - elemsize;\n  return (t_index *) stbds_header(arrbase)->hash_table;\n}\n\nstatic void dump_table(void *hashptr, size_t elemsize, const char *tag)\n{\n  char *arrbase = (char *) hashptr - elemsize;\n  stbds_array_header *h = stbds_header(arrbase);\n  t_index *t = (t_index *) h->hash_table;\n  size_t i, j;\n  printf(\"  [%s] len=%zu cap=%zu temp=%td\\n\", tag, h->length, h->capacity, h->temp);\n  if (!t) { printf(\"  [%s] table=NULL\\n\", tag); return; }\n  printf(\"  [%s] slots=%zu log2=%zu used=%zu ut=%zu ust=%zu tomb=%zu tt=%zu seed=%016zx\\n\",\n         tag, t->slot_count, t->slot_count_log2, t->used_count, t->used_count_threshold,\n         t->used_count_shrink_threshold, t->tombstone_count, t->tombstone_count_threshold, t->seed);\n  printf(\"  [%s] str.mode=%u str.block=%u str.remaining=%zu str.has_storage=%d align_ok=%d span_ok=%d\\n\",\n         tag, (unsigned) t->string.mode, (unsigned) t->string.block, t->string.remaining,\n         t->string.storage != NULL,\n         (((size_t) t->storage) & 63u) == 0,\n         (size_t)((char *) t->storage - (char *) t) >= sizeof(t_index));\n  for (i = 0; i < t->slot_count >> 3; ++i) {\n    printf(\"  [%s] b%02zu:\", tag, i);\n    for (j = 0; j < BL; ++j) printf(\" %016zx/%td\", t->storage[i].hash[j], t->storage[i].index[j]);\n    printf(\"\\n\");\n  }\n}\n\n/* ------------------------------------------------------------------ */\nstatic void test_hash_string(void)\n{\n  static const char *strs[] = {\n    \"\", \"a\", \"b\", \"ab\", \"abc\", \"abcd\", \"abcde\", \"abcdef\", \"abcdefg\", \"abcdefgh\",\n    \"abcdefghi\", \"hello world\", \"test_0\", \"test_1\", \"test_10\", \"test_100000\",\n    \"\\x80\", \"\\xff\", \"\\x7f\\x80\\x81\", \"\\xff\\xfe\\xfd\\xfc\\xfb\\xfa\\xf9\\xf8\\xf7\",\n    \"The quick brown fox jumps over the lazy dog 0123456789\",\n    \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n  };\n  static const size_t seeds[] = { 0, 1, 2, 0x31415926u, 0xdeadbeefu, 0xffffffffu,\n                                  (size_t) 0x0123456789abcdefULL, (size_t) ~0ULL };\n  size_t i, s;\n  printf(\"== hash_string ==\\n\");\n  for (i = 0; i < sizeof strs / sizeof *strs; ++i)\n    for (s = 0; s < sizeof seeds / sizeof *seeds; ++s)\n      printf(\"hs[%2zu][%2zu] = %016zx\\n\", i, s, stbds_hash_string((char *) strs[i], seeds[s]));\n}\n\nstatic void test_hash_bytes(void)\n{\n  unsigned char buf[80], zeros[80], ffs[80];\n  size_t len, s, i;\n  static const size_t seeds[] = { 0, 1, 0x31415926u, (size_t) 0x0123456789abcdefULL, (size_t) ~0ULL };\n  printf(\"== hash_bytes ==\\n\");\n  for (i = 0; i < 80; ++i) { buf[i] = (unsigned char) (i * 37 + 128); zeros[i] = 0; ffs[i] = 0xff; }\n  for (len = 0; len <= 72; ++len)\n    for (s = 0; s < sizeof seeds / sizeof *seeds; ++s) {\n      size_t h1 = stbds_hash_bytes(buf, len, seeds[s]);\n      size_t h2 = stbds_hash_bytes(zeros, len, seeds[s]);\n      size_t h3 = stbds_hash_bytes(ffs, len, seeds[s]);\n      printf(\"hb[%2zu][%zu] = %016zx %016zx %016zx\\n\", len, s, h1, h2, h3);\n    }\n  /* every possible byte value (exercises the int sign-extension quirks) */\n  for (i = 0; i < 256; ++i) {\n    unsigned char b1[8];\n    size_t k, a1, a3, a4, a5, a8;\n    for (k = 0; k < 8; ++k) b1[k] = (unsigned char) i;\n    a1 = stbds_hash_bytes(b1, 1, 7);\n    a3 = stbds_hash_bytes(b1, 3, 7);\n    a4 = stbds_hash_bytes(b1, 4, 7);\n    a5 = stbds_hash_bytes(b1, 5, 7);\n    a8 = stbds_hash_bytes(b1, 8, 7);\n    printf(\"hb1[%3zu] = %016zx %016zx %016zx %016zx %016zx\\n\", i, a1, a3, a4, a5, a8);\n  }\n  /* single high byte at each position of a 8..15 byte buffer */\n  for (i = 0; i < 16; ++i) {\n    unsigned char b2[16];\n    size_t k, r;\n    for (k = 0; k < 16; ++k) b2[k] = 0;\n    b2[i] = 0x80;\n    for (len = 8; len <= 16; ++len) {\n      r = stbds_hash_bytes(b2, len, 3);\n      printf(\"hb2[%2zu][%2zu] = %016zx\\n\", i, len, r);\n    }\n  }\n}\n\n/* ------------------------------------------------------------------ */\nstatic void test_arrays(void)\n{\n  int *a = NULL;\n  int i;\n  int *p;\n  ptrdiff_t n;\n  printf(\"== arrays ==\\n\");\n  printf(\"empty: len=%td lenu=%zu cap=%zu\\n\", arrlen(a), arrlenu(a), arrcap(a));\n  for (i = 0; i < 33; ++i) {\n    int last;\n    arrput(a, i * 3);\n    last = arrlast(a);\n    printf(\"put %2d: len=%td cap=%zu last=%d\\n\", i, arrlen(a), arrcap(a), last);\n  }\n  printf(\"contents:\"); for (i = 0; i < arrlen(a); ++i) printf(\" %d\", a[i]); printf(\"\\n\");\n  for (i = 0; i < 5; ++i) {\n    int v = arrpop(a);\n    printf(\"pop=%d len=%td cap=%zu\\n\", v, arrlen(a), arrcap(a));\n  }\n  arrins(a, 3, 999);\n  printf(\"ins3: len=%td cap=%zu:\", arrlen(a), arrcap(a));\n  for (i = 0; i < arrlen(a); ++i) printf(\" %d\", a[i]); printf(\"\\n\");\n  arrinsn(a, 5, 4);\n  for (i = 0; i < 4; ++i) a[5+i] = 700+i;\n  printf(\"insn5x4: len=%td cap=%zu:\", arrlen(a), arrcap(a));\n  for (i = 0; i < arrlen(a); ++i) printf(\" %d\", a[i]); printf(\"\\n\");\n  arrdel(a, 2);\n  arrdeln(a, 4, 3);\n  arrdelswap(a, 1);\n  printf(\"dels: len=%td cap=%zu:\", arrlen(a), arrcap(a));\n  for (i = 0; i < arrlen(a); ++i) printf(\" %d\", a[i]); printf(\"\\n\");\n  arrsetlen(a, 40);\n  printf(\"setlen40: len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetlen(a, 7);\n  printf(\"setlen7: len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetcap(a, 200);\n  printf(\"setcap200: len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetcap(a, 3);\n  printf(\"setcap3: len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  p = arraddnptr(a, 10);\n  for (i = 0; i < 10; ++i) p[i] = 1000 + i;\n  printf(\"addnptr10: len=%td cap=%zu idx=%td:\", arrlen(a), arrcap(a), (ptrdiff_t)(p - a));\n  for (i = 0; i < arrlen(a); ++i) printf(\" %d\", a[i]); printf(\"\\n\");\n  n = (ptrdiff_t) arraddnindex(a, 5);\n  printf(\"addnindex5=%td len=%td cap=%zu\\n\", n, arrlen(a), arrcap(a));\n  n = (ptrdiff_t) arraddnindex(a, 0);\n  printf(\"addnindex0=%td len=%td cap=%zu\\n\", n, arrlen(a), arrcap(a));\n  p = arraddnptr(a, 0);\n  printf(\"addnptr0 same=%d\\n\", p == a);\n  dump_hdr(a, \"arr\");\n  arrfree(a);\n  printf(\"freed: a=%d len=%td\\n\", a == NULL, arrlen(a));\n\n  /* stbds_arrfreef + direct arrgrowf exercises */\n  {\n    static const size_t es[] = { 1, 2, 4, 8, 13, 16, 64 };\n    static const size_t add[] = { 0, 1, 2, 7, 100 };\n    static const size_t mc[] = { 0, 1, 3, 4, 5, 17, 1000 };\n    size_t x, y, z;\n    for (x = 0; x < sizeof es / sizeof *es; ++x)\n      for (y = 0; y < sizeof add / sizeof *add; ++y)\n        for (z = 0; z < sizeof mc / sizeof *mc; ++z) {\n          void *v = stbds_arrgrowf(NULL, es[x], add[y], mc[z]);\n          stbds_array_header *h = stbds_header(v);\n          printf(\"grow(%zu,%zu,%zu): len=%zu cap=%zu temp=%td ht=%d\",\n                 es[x], add[y], mc[z], h->length, h->capacity, h->temp, h->hash_table != NULL);\n          h->length = add[y] > h->capacity ? h->capacity : add[y];\n          v = stbds_arrgrowf(v, es[x], 1, 0);\n          h = stbds_header(v);\n          printf(\" -> len=%zu cap=%zu\", h->length, h->capacity);\n          v = stbds_arrgrowf(v, es[x], 0, 0);\n          h = stbds_header(v);\n          printf(\" -> len=%zu cap=%zu\\n\", h->length, h->capacity);\n          stbds_arrfreef(v);\n        }\n  }\n  /* char array */\n  {\n    char *s = NULL;\n    const char *msg = \"hello, stretchy buffer world!\";\n    size_t k;\n    for (k = 0; msg[k]; ++k) arrput(s, msg[k]);\n    arrput(s, 0);\n    printf(\"charr: len=%td cap=%zu '%s'\\n\", arrlen(s), arrcap(s), s);\n    arrfree(s);\n  }\n  /* double array */\n  {\n    double *d = NULL;\n    int k;\n    for (k = 0; k < 10; ++k) arrput(d, k * 0.5);\n    printf(\"dblarr: len=%td cap=%zu\", arrlen(d), arrcap(d));\n    for (k = 0; k < arrlen(d); ++k) printf(\" %.3f\", d[k]);\n    printf(\"\\n\");\n    arrfree(d);\n  }\n  /* many pushes: exercise the growth sequence */\n  {\n    int *big = NULL;\n    int k;\n    size_t prevcap = 0;\n    for (k = 0; k < 5000; ++k) {\n      arrput(big, k);\n      if (arrcap(big) != prevcap) {\n        prevcap = arrcap(big);\n        printf(\"growth at len=%td cap=%zu\\n\", arrlen(big), prevcap);\n      }\n    }\n    printf(\"sum check: %d %d %td\\n\", big[0], big[4999], arrlen(big));\n    arrfree(big);\n  }\n}\n\n/* ------------------------------------------------------------------ */\nstatic void test_hmap_int(void)\n{\n  imap *m = NULL;\n  int i;\n  ptrdiff_t idx, d1, d2;\n  printf(\"== hmap int ==\\n\");\n  stbds_rand_seed(0x31415926);\n  idx = hmgeti(m, 5);\n  printf(\"get on NULL: %td\\n\", idx);\n  dump_table(m, sizeof *m, \"afterget\");\n  hmfree(m);\n  m = NULL;\n\n  hmdefault(m, -7);\n  {\n    ptrdiff_t l = hmlen(m);\n    int g = hmget(m, 3);\n    ptrdiff_t gi = hmgeti(m, 3);\n    int nn = hmgetp_null(m, 3) != NULL;\n    printf(\"default: len=%td get(3)=%d geti(3)=%td null(3)=%d\\n\", l, g, gi, nn);\n  }\n  dump_table(m, sizeof *m, \"onlydefault\");\n  for (i = 0; i < 40; ++i) {\n    ptrdiff_t t;\n    hmput(m, i * 7, i * i);\n    t = stbds_temp(m - 1);\n    printf(\"put %2d: len=%td temp=%td\\n\", i, hmlen(m), t);\n  }\n  dump_table(m, sizeof *m, \"int40\");\n  printf(\"order:\"); for (i = 0; i < hmlen(m); ++i) printf(\" %d=%d\", m[i].key, m[i].value); printf(\"\\n\");\n  for (i = -5; i < 300; ++i) {\n    int g, nn;\n    idx = hmgeti(m, i);\n    g = hmget(m, i);\n    nn = hmgetp_null(m, i) != NULL;\n    printf(\"geti(%3d)=%td get=%d null=%d\\n\", i, idx, g, nn);\n  }\n  {\n    ptrdiff_t tmp;\n    for (i = 0; i < 12; ++i) {\n      ptrdiff_t ti = hmgeti_ts(m, i * 7, tmp);\n      int tv = hmget_ts(m, i * 7, tmp);\n      printf(\"ts(%d): i=%td v=%d\\n\", i * 7, ti, tv);\n    }\n  }\n  /* delete every other key */\n  for (i = 0; i < 40; i += 2) {\n    d1 = (ptrdiff_t) hmdel(m, i * 7);\n    printf(\"del %2d -> %td len=%td\\n\", i * 7, d1, hmlen(m));\n  }\n  dump_table(m, sizeof *m, \"afterdel\");\n  printf(\"order:\"); for (i = 0; i < hmlen(m); ++i) printf(\" %d=%d\", m[i].key, m[i].value); printf(\"\\n\");\n  for (i = 0; i < 40; ++i) {\n    idx = hmgeti(m, i * 7);\n    printf(\"post geti(%2d)=%td\\n\", i * 7, idx);\n  }\n  d1 = (ptrdiff_t) hmdel(m, 12345);\n  d2 = (ptrdiff_t) hmdel(m, 0);\n  printf(\"del missing: %td %td\\n\", d1, d2);\n  /* re-add to force tombstone reuse */\n  for (i = 0; i < 40; i += 2) hmput(m, i * 7, -i);\n  dump_table(m, sizeof *m, \"readd\");\n  printf(\"order:\"); for (i = 0; i < hmlen(m); ++i) printf(\" %d=%d\", m[i].key, m[i].value); printf(\"\\n\");\n  /* delete everything (drives the shrink path) */\n  for (i = 39; i >= 0; --i) {\n    size_t sc;\n    d1 = (ptrdiff_t) hmdel(m, i * 7);\n    sc = tbl(m, sizeof *m)->slot_count;\n    printf(\"del2 %2d -> %td len=%td slots=%zu\\n\", i * 7, d1, hmlen(m), sc);\n  }\n  dump_table(m, sizeof *m, \"emptied\");\n  hmfree(m);\n  printf(\"freed=%d len=%td\\n\", m == NULL, hmlen(m));\n\n  /* big map: 2000 keys, then delete in a different order */\n  {\n    imap *b = NULL;\n    int k;\n    stbds_rand_seed(777);\n    for (k = 0; k < 2000; ++k) hmput(b, k * 3 + 1, k);\n    printf(\"big: len=%td slots=%zu used=%zu\\n\", hmlen(b), tbl(b, sizeof *b)->slot_count,\n           tbl(b, sizeof *b)->used_count);\n    for (k = 0; k < 2000; ++k) {\n      int g = hmget(b, k * 3 + 1);\n      if (g != k) printf(\"MISMATCH at %d: %d\\n\", k, g);\n    }\n    for (k = 1999; k >= 0; k -= 3) hmdel(b, k * 3 + 1);\n    printf(\"big after del: len=%td slots=%zu used=%zu tomb=%zu\\n\", hmlen(b),\n           tbl(b, sizeof *b)->slot_count, tbl(b, sizeof *b)->used_count,\n           tbl(b, sizeof *b)->tombstone_count);\n    for (k = 0; k < 2000; ++k) {\n      ptrdiff_t gi = hmgeti(b, k * 3 + 1);\n      printf(\"bg %4d %td\\n\", k, gi);\n    }\n    printf(\"checksum:\"); for (k = 0; k < hmlen(b); k += 97) printf(\" %d/%d\", b[k].key, b[k].value);\n    printf(\"\\n\");\n    hmfree(b);\n  }\n}\n\nstatic void test_hmap_struct(void)\n{\n  stbds_struct *m = NULL;\n  stbds_struct2 *m2 = NULL;\n  int i;\n  printf(\"== hmap struct ==\\n\");\n  stbds_rand_seed(0xabcdef01);\n  for (i = 0; i < 24; ++i) {\n    stbds_struct s;\n    ptrdiff_t t;\n    s.key = i * 3; s.b = i; s.c = i * i; s.d = -i;\n    hmputs(m, s);\n    t = stbds_temp(m - 1);\n    printf(\"puts %d: len=%td temp=%td\\n\", i, hmlen(m), t);\n  }\n  dump_table(m, sizeof *m, \"structmap\");\n  for (i = 0; i < 24; ++i) {\n    stbds_struct v = hmgets(m, i * 3);\n    ptrdiff_t gi = hmgeti(m, i * 3);\n    printf(\"gets %d: %d %d %d %d idx=%td\\n\", i, v.key, v.b, v.c, v.d, gi);\n  }\n  printf(\"order:\"); for (i = 0; i < hmlen(m); ++i) printf(\" %d/%d\", m[i].key, m[i].c); printf(\"\\n\");\n  for (i = 0; i < 24; i += 3) {\n    ptrdiff_t d = (ptrdiff_t) hmdel(m, i * 3);\n    printf(\"del %d -> %td\\n\", i * 3, d);\n  }\n  dump_table(m, sizeof *m, \"structmap2\");\n  printf(\"order:\"); for (i = 0; i < hmlen(m); ++i) printf(\" %d/%d\", m[i].key, m[i].c); printf(\"\\n\");\n  hmfree(m);\n\n  for (i = 0; i < 20; ++i) {\n    stbds_struct2 s;\n    s.key[0] = i; s.key[1] = i * 100; s.b = i; s.c = 0; s.d = 1;\n    hmputs(m2, s);\n  }\n  dump_table(m2, sizeof *m2, \"struct2map\");\n  for (i = 0; i < 20; ++i) {\n    ptrdiff_t idx;\n    int kk[2]; kk[0] = i; kk[1] = i * 100;\n    m2 = (stbds_struct2 *) stbds_hmget_key(m2, sizeof *m2, kk, sizeof kk, STBDS_HM_BINARY);\n    idx = stbds_temp(m2 - 1);\n    printf(\"s2 get %d -> %td b=%d\\n\", i, idx, idx >= 0 ? m2[idx].b : -1);\n  }\n  hmfree(m2);\n}\n\nstatic void test_hmap_keysizes(void)\n{\n  typedef struct { unsigned char key[40]; int value; } bigk;\n  size_t ks;\n  printf(\"== hmap keysizes ==\\n\");\n  stbds_rand_seed(12345);\n  for (ks = 1; ks <= 40; ++ks) {\n    bigk *m = NULL;\n    int i;\n    for (i = 0; i < 20; ++i) {\n      unsigned char kb[40];\n      size_t j;\n      ptrdiff_t idx;\n      for (j = 0; j < 40; ++j) kb[j] = (unsigned char) (i * 31 + j * 7 + 129);\n      m = (bigk *) stbds_hmput_key(m, sizeof *m, kb, ks, STBDS_HM_BINARY);\n      idx = stbds_temp(m - 1);\n      m[idx].value = i * 1000;\n      printf(\"ks%02zu put%02d idx=%td len=%zu\\n\", ks, i, idx,\n             stbds_header((char*)m - sizeof *m)->length);\n    }\n    for (i = 19; i >= 0; --i) {\n      unsigned char kb[40];\n      size_t j;\n      ptrdiff_t idx;\n      for (j = 0; j < 40; ++j) kb[j] = (unsigned char) (i * 31 + j * 7 + 129);\n      m = (bigk *) stbds_hmget_key(m, sizeof *m, kb, ks, STBDS_HM_BINARY);\n      idx = stbds_temp(m - 1);\n      printf(\"ks%02zu get%02d idx=%td val=%d\\n\", ks, i, idx, idx >= 0 ? m[idx].value : -1);\n    }\n    dump_table(m, sizeof *m, \"bigk\");\n    for (i = 0; i < 20; i += 2) {\n      unsigned char kb[40];\n      size_t j;\n      ptrdiff_t r;\n      for (j = 0; j < 40; ++j) kb[j] = (unsigned char) (i * 31 + j * 7 + 129);\n      m = (bigk *) stbds_hmdel_key(m, sizeof *m, kb, ks, 0, STBDS_HM_BINARY);\n      r = stbds_temp(m - 1);\n      printf(\"ks%02zu del%02d res=%td\\n\", ks, i, r);\n    }\n    dump_table(m, sizeof *m, \"bigk-del\");\n    stbds_hmfree_func((char *) m - sizeof *m, sizeof *m);\n  }\n}\n\n/* ------------------------------------------------------------------ */\n/* stable, distinct key strings (\"test_%d\"), unlike strkey()'s shared buffer */\nstatic char stable_keys[80][24];\nstatic char *skey(int n)\n{\n  sprintf(stable_keys[n % 80], \"test_%d\", n);\n  return stable_keys[n % 80];\n}\n\nstatic void test_smap(int mode)\n{\n  smap *m = NULL;\n  int i;\n  printf(\"== smap mode %d ==\\n\", mode);\n  stbds_rand_seed(0x1234abcd);\n  if (mode == STBDS_SH_ARENA) sh_new_arena(m);\n  else if (mode == STBDS_SH_STRDUP) sh_new_strdup(m);\n  if (m) dump_table(m, sizeof *m, \"fresh\");\n  for (i = 0; i < 30; ++i) {\n    char *k = skey(i);\n    ptrdiff_t t;\n    int same;\n    shput(m, k, i * 11);\n    t = stbds_temp(m - 1);\n    same = m[t].key == k;\n    printf(\"shput %2d '%s': len=%td temp=%td samekey=%d\\n\", i, k, shlen(m), t, same);\n  }\n  dump_table(m, sizeof *m, \"s30\");\n  printf(\"order:\"); for (i = 0; i < shlen(m); ++i) printf(\" %s=%d\", m[i].key, m[i].value); printf(\"\\n\");\n  for (i = 0; i < 35; ++i) {\n    char *k = skey(i);\n    ptrdiff_t gi = shgeti(m, k);\n    int g = shget(m, k);\n    int nn = shgetp_null(m, k) != NULL;\n    printf(\"shgeti %2d = %td get=%d null=%d\\n\", i, gi, g, nn);\n  }\n  {\n    ptrdiff_t r = (ptrdiff_t) shputi(m, skey(3), 77);\n    int g = shget(m, skey(3));\n    printf(\"shputi again: %td get3=%d\\n\", r, g);\n  }\n  for (i = 0; i < 30; i += 3) {\n    ptrdiff_t r = (ptrdiff_t) shdel(m, skey(i));\n    printf(\"shdel %2d -> %td len=%td\\n\", i, r, shlen(m));\n  }\n  dump_table(m, sizeof *m, \"s30-del\");\n  printf(\"order:\"); for (i = 0; i < shlen(m); ++i) printf(\" %s=%d\", m[i].key, m[i].value); printf(\"\\n\");\n  for (i = 0; i < 30; ++i) {\n    ptrdiff_t gi = shgeti(m, skey(i));\n    printf(\"post shgeti %2d = %td\\n\", i, gi);\n  }\n  /* re-insert */\n  for (i = 0; i < 30; i += 3) shput(m, skey(i), 1000 + i);\n  dump_table(m, sizeof *m, \"s30-re\");\n  printf(\"order:\"); for (i = 0; i < shlen(m); ++i) printf(\" %s=%d\", m[i].key, m[i].value); printf(\"\\n\");\n  /* shputs */\n  {\n    smap e;\n    ptrdiff_t t;\n    e.key = skey(50); e.value = 5000;\n    shputs(m, e);\n    t = stbds_temp(m - 1);\n    printf(\"shputs: len=%td key='%s' copied=%d\\n\", shlen(m), m[t].key, m[t].key != e.key);\n  }\n  /* long keys (stresses the arena block logic in arena mode) */\n  {\n    static char big[600];\n    size_t j;\n    ptrdiff_t t;\n    int g;\n    for (j = 0; j < sizeof big - 1; ++j) big[j] = (char) ('a' + (j % 26));\n    big[sizeof big - 1] = 0;\n    shput(m, big, 4242);\n    t = stbds_temp(m - 1);\n    g = shget(m, big);\n    printf(\"bigkey: len=%td get=%d keylen=%zu\\n\", shlen(m), g, strlen(m[t].key));\n    shput(m, \"z\", 4343);\n    g = shget(m, \"z\");\n    printf(\"smallkey: len=%td get=%d\\n\", shlen(m), g);\n  }\n  dump_table(m, sizeof *m, \"final\");\n  /* many keys to force table growth in string mode */\n  for (i = 0; i < 79; ++i) shput(m, skey(i), i);\n  printf(\"after79: len=%td slots=%zu\\n\", shlen(m), tbl(m, sizeof *m)->slot_count);\n  printf(\"order:\"); for (i = 0; i < shlen(m); ++i) printf(\" %s=%d\", m[i].key, m[i].value); printf(\"\\n\");\n  shfree(m);\n  printf(\"freed=%d\\n\", m == NULL);\n}\n\nstatic void test_arena(void)\n{\n  struct stbds_string_arena a;\n  int i;\n  printf(\"== arena ==\\n\");\n  /* phase A: strings that always fit in a fresh block -> offsets stay inside\n     the head block and are fully deterministic */\n  memset(&a, 0, sizeof a);\n  for (i = 0; i < 120; ++i) {\n    char tmp[512];\n    int n = (i * 37) % 400;\n    int j;\n    char *p;\n    for (j = 0; j < n; ++j) tmp[j] = (char) ('A' + (j % 26));\n    tmp[n] = 0;\n    p = stralloc(&a, tmp);\n    printf(\"stralloc %3d len=%3d off=%td rem=%zu block=%u eq=%d\\n\", i, n,\n           (ptrdiff_t) (p - (char *) a.storage), a.remaining, (unsigned) a.block,\n           strcmp(p, tmp) == 0);\n  }\n  strreset(&a);\n  printf(\"reset: storage=%d rem=%zu block=%u mode=%u\\n\", a.storage != NULL, a.remaining,\n         (unsigned) a.block, (unsigned) a.mode);\n  /* phase B: mixed huge strings (separate blocks) -- no pointer arithmetic */\n  memset(&a, 0, sizeof a);\n  for (i = 0; i < 40; ++i) {\n    static char tmp[4096];\n    int n = (i * 811) % 3000;\n    int j;\n    char *p;\n    for (j = 0; j < n; ++j) tmp[j] = (char) ('a' + (j % 26));\n    tmp[n] = 0;\n    p = stralloc(&a, tmp);\n    printf(\"bigalloc %2d len=%4d rem=%zu block=%u eq=%d\\n\", i, n, a.remaining,\n           (unsigned) a.block, strcmp(p, tmp) == 0);\n  }\n  strreset(&a);\n  printf(\"reset2: storage=%d rem=%zu block=%u\\n\", a.storage != NULL, a.remaining, (unsigned) a.block);\n  /* phase C: many short strings, watch the block growth schedule */\n  memset(&a, 0, sizeof a);\n  for (i = 0; i < 2000; ++i) {\n    char tmp[24];\n    sprintf(tmp, \"s%d\", i);\n    stralloc(&a, tmp);\n    if (i % 97 == 0) printf(\"short %4d rem=%zu block=%u\\n\", i, a.remaining, (unsigned) a.block);\n  }\n  printf(\"many: rem=%zu block=%u\\n\", a.remaining, (unsigned) a.block);\n  strreset(&a);\n  printf(\"reset3: storage=%d rem=%zu block=%u\\n\", a.storage != NULL, a.remaining, (unsigned) a.block);\n  /* empty string */\n  memset(&a, 0, sizeof a);\n  {\n    char *p = stralloc(&a, \"\");\n    printf(\"empty: rem=%zu block=%u len=%zu off=%td\\n\", a.remaining, (unsigned) a.block,\n           strlen(p), (ptrdiff_t) (p - (char *) a.storage));\n  }\n  strreset(&a);\n}\n\nstatic void test_misc(void)\n{\n  int i;\n  static const int ns[] = { 0, 1, -1, 9, 10, 99, 100, 12345, -12345, 2147483647, -2147483647 - 1 };\n  printf(\"== misc ==\\n\");\n  for (i = 0; i < (int) (sizeof ns / sizeof *ns); ++i) {\n    char *k = strkey(ns[i]);\n    printf(\"strkey(%d)='%s' len=%zu\\n\", ns[i], k, strlen(k));\n  }\n  for (i = 0; i < 6; ++i) { arr_push(i * 47); printf(\"arr_push(%d) ok\\n\", i * 47); }\n  arr_push(200);\n  printf(\"arr_push(200) ok\\n\");\n  arr_push(-5);\n  printf(\"arr_push(-5) ok\\n\");\n  /* seed sequence: fresh tables pick up successive global seeds */\n  stbds_rand_seed(1);\n  for (i = 0; i < 8; ++i) {\n    void *h = stbds_shmode_func(16, STBDS_SH_DEFAULT);\n    t_index *t = tbl(h, 16);\n    printf(\"seed[%d]=%016zx slots=%zu mode=%u\\n\", i, t->seed, t->slot_count,\n           (unsigned) t->string.mode);\n    stbds_hmfree_func((char *) h - 16, 16);\n  }\n  stbds_rand_seed(0);\n  for (i = 0; i < 4; ++i) {\n    void *h = stbds_shmode_func(24, STBDS_SH_STRDUP);\n    t_index *t = tbl(h, 24);\n    printf(\"seed0[%d]=%016zx mode=%u\\n\", i, t->seed, (unsigned) t->string.mode);\n    stbds_hmfree_func((char *) h - 24, 24);\n  }\n  /* hmput_default on a NULL map, twice, plus hmdefaults */\n  {\n    imap *m = NULL;\n    m = (imap *) stbds_hmput_default(m, sizeof *m);\n    printf(\"dflt1 len=%zu val=%d\\n\", stbds_header((char*)m - sizeof *m)->length, m[-1].value);\n    m[-1].value = 99;\n    m = (imap *) stbds_hmput_default(m, sizeof *m);\n    printf(\"dflt2 len=%zu val=%d\\n\", stbds_header((char*)m - sizeof *m)->length, m[-1].value);\n    {\n      imap tmp = m[-1];\n      tmp.value = 55;\n      hmdefaults(m, tmp);\n    }\n    printf(\"dflt3 len=%zu val=%d\\n\", stbds_header((char*)m - sizeof *m)->length, m[-1].value);\n    hmfree(m);\n  }\n  /* hmget_key_ts on NULL */\n  {\n    ptrdiff_t temp = 12345;\n    int key = 7;\n    void *p = stbds_hmget_key_ts(NULL, 8, &key, sizeof key, &temp, STBDS_HM_BINARY);\n    printf(\"ts NULL: temp=%td len=%zu\\n\", temp, stbds_header((char *) p - 8)->length);\n    stbds_hmfree_func((char *) p - 8, 8);\n  }\n  /* hmdel_key on NULL */\n  printf(\"del NULL = %d\\n\", stbds_hmdel_key(NULL, 8, NULL, 4, 0, STBDS_HM_BINARY) == NULL);\n  /* hmfree_func on NULL */\n  stbds_hmfree_func(NULL, 8);\n  printf(\"hmfree NULL ok\\n\");\n  /* shmode_func for every mode */\n  for (i = 0; i < 4; ++i) {\n    void *h = stbds_shmode_func(32, i);\n    t_index *t = tbl(h, 32);\n    printf(\"shmode %d: mode=%u slots=%zu len=%zu\\n\", i, (unsigned) t->string.mode,\n           t->slot_count, stbds_header((char *) h - 32)->length);\n    stbds_hmfree_func((char *) h - 32, 32);\n  }\n}\n\nint main(void)\n{\n  test_hash_string();\n  test_hash_bytes();\n  test_arrays();\n  test_hmap_int();\n  test_hmap_struct();\n  test_hmap_keysizes();\n  test_smap(STBDS_SH_DEFAULT);\n  test_smap(STBDS_SH_STRDUP);\n  test_smap(STBDS_SH_ARENA);\n  test_arena();\n  test_misc();\n  printf(\"done\\n\");\n  return 0;\n}\n","structuredPatch":[{"oldStart":180,"oldLines":7,"newStart":180,"newLines":9,"lines":["       for (y = 0; y < sizeof add / sizeof *add; ++y)","         for 