-------------------------------------------------\n652\t\n653\tunsafe fn stbds_is_key_equal(\n654\t    a: *mut c_void,\n655\t    elemsize: usize,\n656\t    key: *mut c_void,\n657\t    keysize: usize,\n658\t    keyoffset: usize,\n659\t    mode: c_int,\n660\t    i: usize,\n661\t) -> c_int {\n662\t    if mode >= STBDS_HM_STRING {\n663\t        let other = *(elem_ptr(a, elemsize, i, keyoffset) as *mut *mut c_char);\n664\t        c_str_eq(key as *const c_char, other) as c_int\n665\t    } else {\n666\t        c_mem_eq(\n667\t            key as *const u8,\n668\t            elem_ptr(a, elemsize, i, keyoffset) as *const u8,\n669\t            keysize,\n670\t        ) as c_int\n671\t    }\n672\t}\n673\t\n674\t#[unsafe(no_mangle)]\n675\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n676\t    if a.is_null() {\n677\t        return;\n678\t    }\n679\t    if !stbds_hash_table(a).is_null() {\n680\t        if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP {\n681\t            let mut i: usize = 1;\n682\t            while i < (*stbds_header(a)).length {\n683\t                stbds_free(*(elem_ptr(a, elemsize, i, 0) as *mut *mut c_void));\n684\t                i += 1;\n685\t            }\n686\t        }\n687\t        stbds_strreset(&raw mut (*stbds_hash_table(a)).string);\n688\t    }\n689\t    stbds_free((*stbds_header(a)).hash_table);\n690\t    stbds_free(stbds_header(a) as *mut c_void);\n691\t}\n692\t\n693\tunsafe fn stbds_hm_find_slot(\n694\t    a: *mut c_void,\n695\t    elemsize: usize,\n696\t    key: *mut c_void,\n697\t    keysize: usize,\n698\t    keyoffset: usize,\n699\t    mode: c_int,\n700\t) -> isize {\n701\t    let raw_a = stbds_hash_to_arr(a, elemsize);\n702\t    let table = stbds_hash_table(raw_a);\n703\t    let mut hash: usize = if mode >= STBDS_HM_STRING {\n704\t        stbds_hash_string(key as *mut c_char, (*table).seed)\n705\t    } else {\n706\t        stbds_hash_bytes(key, keysize, (*table).seed)\n707\t    };\n708\t    let mut s