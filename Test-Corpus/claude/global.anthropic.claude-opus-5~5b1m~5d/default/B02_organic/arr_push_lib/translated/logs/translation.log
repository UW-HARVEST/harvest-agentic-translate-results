{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QrPhGAthDyTWUZKkVvxkQF","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (an stb_ds.h derived\n2\t//! dynamic-array / hash-map implementation plus the small test helpers\n3\t//! `strkey()` and `arr_push()`).\n4\t//!\n5\t//! The translation is bit-for-bit faithful to the C original:\n6\t//!   * all data structures use the identical `#[repr(C)]` layout so that the\n7\t//!     `stb_ds.h` macros (which poke at the array header directly) keep working,\n8\t//!   * all allocations go through the C library's `realloc`/`free` so that\n9\t//!     memory allocated here can be released by C code (and vice versa),\n10\t//!   * every arithmetic quirk of the original (including implicit `int`\n11\t//!     promotions that sign-extend into `size_t`) is reproduced exactly,\n12\t//!   * the order of all checks/branches is preserved.\n13\t\n14\t#![allow(non_camel_case_types)]\n15\t#![allow(clippy::missing_safety_doc)]\n16\t\n17\tuse core::ffi::{c_char, c_int, c_void};\n18\tuse core::ptr;\n19\t\n20\t// ---------------------------------------------------------------------------\n21\t// libc bindings (STBDS_REALLOC / STBDS_FREE map onto realloc/free)\n22\t// ---------------------------------------------------------------------------\n23\t\n24\tunsafe extern \"C\" {\n25\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n26\t    fn free(p: *mut c_void);\n27\t}\n28\t\n29\t/// `STBDS_REALLOC(c,p,s)  ->  realloc(p,s)`\n30\t#[inline]\n31\tunsafe fn stbds_realloc(p: *mut c_void, size: usize) -> *mut c_void {\n32\t    realloc(p, size)\n33\t}\n34\t\n35\t/// `STBDS_FREE(c,p)  ->  free(p)`\n36\t#[inline]\n37\tunsafe fn stbds_free(p: *mut c_void) {\n38\t    free(p)\n39\t}\n40\t\n41\t// ---------------------------------------------------------------------------\n42\t// Small C string / memory helpers (equivalent to strlen/memcmp/strcmp/...)\n43\t// ---------------------------------------------------------------------------\n44\t\n45\t#[inline]\n46\tunsafe fn c_strlen(s: *const c_char) -> usize {\n47\t    let mut n: usize = 0;\n48\t    let mut p = s as *const u8;\n49\t    while *p != 0 {\n50\t        n += 1;\n51\t        p = p.add(1);\n52\t    }\n53\t    n\n54\t}\n55\t\n56\t/// `0 == strcmp(a, b)`\n57\t#[inline]\n58\tunsafe fn c_str_eq(a: *const c_char, b: *const c_char) -> bool {\n59\t    let mut pa = a as *const u8;\n60\t    let mut pb = b as *const u8;\n61\t    loop {\n62\t        let ca = *pa;\n63\t        let cb = *pb;\n64\t        if ca != cb {\n65\t            return false;\n66\t        }\n67\t        if ca == 0 {\n68\t            return true;\n69\t        }\n70\t        pa = pa.add(1);\n71\t        pb = pb.add(1);\n72\t    }\n73\t}\n74\t\n75\t/// `0 == memcmp(a, b, n)`\n76\t#[inline]\n77\tunsafe fn c_mem_eq(a: *const u8, b: *const u8, n: usize) -> bool {\n78\t    let mut i: usize = 0;\n79\t    while i < n {\n80\t        if *a.add(i) != *b.add(i) {\n81\t            return false;\n82\t        }\n83\t        i += 1;\n84\t    }\n85\t    true\n86\t}\n87\t\n88\t/// `memmove(dst, src, n)`\n89\t#[inline]\n90\tunsafe fn c_memmove(dst: *mut u8, src: *const u8, n: usize) {\n91\t    if n != 0 {\n92\t        ptr::copy(src, dst, n);\n93\t    }\n94\t}\n95\t\n96\t/// `memcpy(dst, src, n)`\n97\t#[inline]\n98\tunsafe fn c_memcpy(dst: *mut u8, src: *const u8, n: usize) {\n99\t    if n != 0 {\n100\t        ptr::copy_nonoverlapping(src, dst, n);\n101\t    }\n102\t}\n103\t\n104\t/// `memset(dst, 0, n)`\n105\t#[inline]\n106\tunsafe fn c_memzero(dst: *mut u8, n: usize) {\n107\t    if n != 0 {\n108\t        ptr::write_bytes(dst, 0, n);\n109\t    }\n110\t}\n111\t\n112\t/// `STBDS_ASSERT(x)` -- the original relies on `assert()`, which is compiled\n113\t/// out in release builds; the conditions are internal invariants only.\n114\t#[inline]\n115\tfn stbds_assert(_cond: bool) {}\n116\t\n117\t// ---------------------------------------------------------------------------\n118\t// Data structures (layout identical to the C originals)\n119\t// ---------------------------------------------------------------------------\n120\t\n121\t#[repr(C)]\n122\t#[derive(Clone, Copy)]\n123\tpub struct stbds_array_header {\n124\t    pub length: usize,\n125\t    pub capacity: usize,\n126\t    pub hash_table: *mut c_void,\n127\t    pub temp: isize,\n128\t}\n129\t\n130\t#[repr(C)]\n131\t#[derive(Clone, Copy)]\n132\tpub struct stbds_string_block {\n133\t    pub next: *mut stbds_string_block,\n134\t    pub storage: [c_char; 8],\n135\t}\n136\t\n137\t#[repr(C)]\n138\t#[derive(Clone, Copy)]\n139\tpub struct stbds_string_arena {\n140\t    pub storage: *mut stbds_string_block,\n141\t    pub remaining: usize,\n142\t    pub block: u8,\n143\t    pub mode: u8,\n144\t}\n145\t\n146\tconst STBDS_BUCKET_LENGTH: usize = 8;\n147\tconst STBDS_BUCKET_SHIFT: usize = 3; // STBDS_BUCKET_LENGTH == 8 ? 3 : 2\n148\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n149\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n150\t\n151\t#[repr(C)]\n152\t#[derive(Clone, Copy)]\n153\tpub struct stbds_hash_bucket {\n154\t    pub hash: [usize; STBDS_BUCKET_LENGTH],\n155\t    pub index: [isize; STBDS_BUCKET_LENGTH],\n156\t}\n157\t\n158\t#[repr(C)]\n159\t#[derive(Clone, Copy)]\n160\tpub struct stbds_hash_index {\n161\t    pub temp_key: *mut c_char,\n162\t    pub slot_count: usize,\n163\t    pub used_count: usize,\n164\t    pub used_count_threshold: usize,\n165\t    pub used_count_shrink_threshold: usize,\n166\t    pub tombstone_count: usize,\n167\t    pub tombstone_count_threshold: usize,\n168\t    pub seed: usize,\n169\t    pub slot_count_log2: usize,\n170\t    pub string: stbds_string_arena,\n171\t    pub storage: *mut stbds_hash_bucket,\n172\t}\n173\t\n174\t// Compile-time confirmation that the layouts match the C compiler's.\n175\tconst _: () = assert!(core::mem::size_of::<stbds_array_header>() == 32);\n176\tconst _: () = assert!(core::mem::size_of::<stbds_string_block>() == 16);\n177\tconst _: () = assert!(core::mem::size_of::<stbds_string_arena>() == 24);\n178\tconst _: () = assert!(core::mem::size_of::<stbds_hash_bucket>() == 128);\n179\tconst _: () = assert!(core::mem::size_of::<stbds_hash_index>() == 104);\n180\tconst _: () = assert!(core::mem::offset_of!(stbds_hash_index, string) == 72);\n181\tconst _: () = assert!(core::mem::offset_of!(stbds_hash_index, storage) == 96);\n182\tconst _: () = assert!(core::mem::offset_of!(stbds_string_arena, block) == 16);\n183\tconst _: () = assert!(core::mem::offset_of!(stbds_string_arena, mode) == 17);\n184\t\n185\tconst HEADER_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n186\t\n187\tconst STBDS_HM_BINARY: c_int = 0;\n188\tconst STBDS_HM_STRING: c_int = 1;\n189\t\n190\tconst STBDS_SH_NONE: u8 = 0;\n191\t#[allow(dead_code)]\n192\tconst STBDS_SH_DEFAULT: u8 = 1;\n193\tconst STBDS_SH_STRDUP: u8 = 2;\n194\tconst STBDS_SH_ARENA: u8 = 3;\n195\t\n196\tconst STBDS_INDEX_EMPTY: isize = -1;\n197\tconst STBDS_INDEX_DELETED: isize = -2;\n198\t\n199\tconst STBDS_HASH_EMPTY: usize = 0;\n200\tconst STBDS_HASH_DELETED: usize = 1;\n201\t\n202\t#[inline]\n203\tfn stbds_index_in_use(x: isize) -> bool {\n204\t    x >= 0\n205\t}\n206\t\n207\t// ---------------------------------------------------------------------------\n208\t// Header / array accessor helpers (the stb_ds.h macros)\n209\t// ---------------------------------------------------------------------------\n210\t\n211\t/// `stbds_header(t)  ->  ((stbds_array_header *) (t) - 1)`\n212\t#[inline]\n213\tfn stbds_header(a: *mut c_void) -> *mut stbds_array_header {\n214\t    (a as *mut u8).wrapping_sub(HEADER_SIZE) as *mut stbds_array_header\n215\t}\n216\t\n217\t/// `stbds_arrlen(a)`\n218\t#[inline]\n219\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n220\t    if a.is_null() {\n221\t        0\n222\t    } else {\n223\t        (*stbds_header(a)).length as isize\n224\t    }\n225\t}\n226\t\n227\t/// `stbds_arrcap(a)`\n228\t#[inline]\n229\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n230\t    if a.is_null() {\n231\t        0\n232\t    } else {\n233\t        (*stbds_header(a)).capacity\n234\t    }\n235\t}\n236\t\n237\t/// `stbds_temp(t) = v`\n238\t#[inline]\n239\tunsafe fn set_stbds_temp(a: *mut c_void, v: isize) {\n240\t    (*stbds_header(a)).temp = v;\n241\t}\n242\t\n243\t/// `stbds_temp_key(t) = v`  (i.e. `*(char **) stbds_header(t)->hash_table = v`)\n244\t#[inline]\n245\tunsafe fn set_stbds_temp_key(a: *mut c_void, v: *mut c_char) {\n246\t    *((*stbds_header(a)).hash_table as *mut *mut c_char) = v;\n247\t}\n248\t\n249\t/// `stbds_hash_table(a)  ->  ((stbds_hash_index *) stbds_header(a)->hash_table)`\n250\t#[inline]\n251\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n252\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n253\t}\n254\t\n255\t/// `STBDS_HASH_TO_ARR(x,elemsize)  ->  ((char *) (x) - (elemsize))`\n256\t#[inline]\n257\tfn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n258\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n259\t}\n260\t\n261\t/// `STBDS_ARR_TO_HASH(x,elemsize)  ->  ((char *) (x) + (elemsize))`\n262\t#[inline]\n263\tfn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n264\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n265\t}\n266\t\n267\t/// `(char *) a + elemsize * i + keyoffset`\n268\t#[inline]\n269\tfn elem_ptr(a: *mut c_void, elemsize: usize, i: usize, keyoffset: usize) -> *mut u8 {\n270\t    (a as *mut u8)\n271\t        .wrapping_add(elemsize.wrapping_mul(i))\n272\t        .wrapping_add(keyoffset)\n273\t}\n274\t\n275\t// ---------------------------------------------------------------------------\n276\t// stbds_arrgrowf / stbds_arrfreef\n277\t// ---------------------------------------------------------------------------\n278\t\n279\t#[unsafe(no_mangle)]\n280\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n281\t    a: *mut c_void,\n282\t    elemsize: usize,\n283\t    addlen: usize,\n284\t    min_cap: usize,\n285\t) -> *mut c_void {\n286\t    let mut min_cap = min_cap;\n287\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n288\t\n289\t    if min_len > min_cap {\n290\t        min_cap = min_len;\n291\t    }\n292\t\n293\t    if min_cap <= stbds_arrcap(a) {\n294\t        return a;\n295\t    }\n296\t\n297\t    if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n298\t        min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n299\t    } else if min_cap < 4 {\n300\t        min_cap = 4;\n301\t    }\n302\t\n303\t    let old: *mut c_void = if !a.is_null() {\n304\t        stbds_header(a) as *mut c_void\n305\t    } else {\n306\t        ptr::null_mut()\n307\t    };\n308\t    let b = stbds_realloc(\n309\t        old,\n310\t        elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n311\t    );\n312\t    let b = (b as *mut u8).wrapping_add(HEADER_SIZE) as *mut c_void;\n313\t    if a.is_null() {\n314\t        (*stbds_header(b)).length = 0;\n315\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n316\t        (*stbds_header(b)).temp = 0;\n317\t    }\n318\t    (*stbds_header(b)).capacity = min_cap;\n319\t\n320\t    b\n321\t}\n322\t\n323\t#[unsafe(no_mangle)]\n324\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n325\t    stbds_free(stbds_header(a) as *mut c_void);\n326\t}\n327\t\n328\t// ---------------------------------------------------------------------------\n329\t// Hash seed / hash index construction\n330\t// ---------------------------------------------------------------------------\n331\t\n332\tstatic mut STBDS_HASH_SEED: usize = 0x31415926;\n333\t\n334\t#[inline]\n335\tunsafe fn hash_seed_get() -> usize {\n336\t    *(&raw const STBDS_HASH_SEED)\n337\t}\n338\t\n339\t#[inline]\n340\tunsafe fn hash_seed_set(v: usize) {\n341\t    *(&raw mut STBDS_HASH_SEED) = v;\n342\t}\n343\t\n344\t#[unsafe(no_mangle)]\n345\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n346\t    hash_seed_set(seed);\n347\t}\n348\t\n349\tconst STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() * 8) as u32;\n350\t\n351\t/// `STBDS_ALIGN_FWD(n,a)  ->  (((n) + (a) - 1) & ~((a)-1))`\n352\t#[inline]\n353\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n354\t    n.wrapping_add(a - 1) & !(a - 1)\n355\t}\n356\t\n357\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n358\t    hash & slot_count.wrapping_sub(1)\n359\t}\n360\t\n361\tfn stbds_log2(slot_count: usize) -> usize {\n362\t    let mut slot_count = slot_count;\n363\t    let mut n: usize = 0;\n364\t    while slot_count > 1 {\n365\t        slot_count >>= 1;\n366\t        n += 1;\n367\t    }\n368\t    n\n369\t}\n370\t\n371\tunsafe fn stbds_make_hash_index(\n372\t    slot_count: usize,\n373\t    ot: *mut stbds_hash_index,\n374\t) -> *mut stbds_hash_index {\n375\t    let t: *mut stbds_hash_index = stbds_realloc(\n376\t        ptr::null_mut(),\n377\t        (slot_count >> STBDS_BUCKET_SHIFT)\n378\t            .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n379\t            .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n380\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n381\t    ) as *mut stbds_hash_index;\n382\t\n383\t    (*t).storage = stbds_align_fwd(\n384\t        (t as *mut u8).wrapping_add(core::mem::size_of::<stbds_hash_index>()) as usize,\n385\t        STBDS_CACHE_LINE_SIZE,\n386\t    ) as *mut stbds_hash_bucket;\n387\t    (*t).slot_count = slot_count;\n388\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n389\t    (*t).tombstone_count = 0;\n390\t    (*t).used_count = 0;\n391\t\n392\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n393\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n394\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n395\t\n396\t    if slot_count <= STBDS_BUCKET_LENGTH {\n397\t        (*t).used_count_shrink_threshold = 0;\n398\t    }\n399\t    stbds_assert(\n400\t        (*t).used_count_threshold.wrapping_add((*t).tombstone_count_threshold) < (*t).slot_count,\n401\t    );\n402\t\n403\t    if !ot.is_null() {\n404\t        (*t).string = (*ot).string;\n405\t        (*t).seed = (*ot).seed;\n406\t    } else {\n407\t        c_memzero(\n408\t            (&raw mut (*t).string) as *mut u8,\n409\t            core::mem::size_of::<stbds_string_arena>(),\n410\t        );\n411\t        (*t).seed = hash_seed_get();\n412\t        // stbds_load_32_or_64(a, temp, 2147001325, 0x27bb2ee6, 0x87b0b0fd);\n413\t        let mut temp: usize;\n414\t        temp = (0x87b0b0fdu32 ^ 2147001325u32) as usize;\n415\t        temp <<= 16;\n416\t        temp <<= 16;\n417\t        temp >>= 16;\n418\t        temp >>= 16;\n419\t        let mut a: usize = 0x27bb2ee6usize;\n420\t        a <<= 16;\n421\t        a <<= 16;\n422\t        a ^= temp ^ 2147001325usize;\n423\t        // stbds_load_32_or_64(b, temp, 715136305, 0, 0xb504f32d);\n424\t        temp = (0xb504f32du32 ^ 715136305u32) as usize;\n425\t        temp <<= 16;\n426\t        temp <<= 16;\n427\t        temp >>= 16;\n428\t        temp >>= 16;\n429\t        let mut b: usize = 0usize;\n430\t        b <<= 16;\n431\t        b <<= 16;\n432\t        b ^= temp ^ 715136305usize;\n433\t        hash_seed_set(hash_seed_get().wrapping_mul(a).wrapping_add(b));\n434\t    }\n435\t\n436\t    {\n437\t        let mut i: usize = 0;\n438\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n439\t            let b: *mut stbds_hash_bucket = (*t).storage.add(i);\n440\t            let mut j: usize = 0;\n441\t            while j < STBDS_BUCKET_LENGTH {\n442\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n443\t                j += 1;\n444\t            }\n445\t            let mut j: usize = 0;\n446\t            while j < STBDS_BUCKET_LENGTH {\n447\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n448\t                j += 1;\n449\t            }\n450\t            i += 1;\n451\t        }\n452\t    }\n453\t\n454\t    if !ot.is_null() {\n455\t        (*t).used_count = (*ot).used_count;\n456\t        let mut i: usize = 0;\n457\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n458\t            let ob: *mut stbds_hash_bucket = (*ot).storage.add(i);\n459\t            let mut j: usize = 0;\n460\t            while j < STBDS_BUCKET_LENGTH {\n461\t                if stbds_index_in_use((*ob).index[j]) {\n462\t                    let hash = (*ob).hash[j];\n463\t                    let mut pos =\n464\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n465\t                    let mut step = STBDS_BUCKET_LENGTH;\n466\t                    'probe: loop {\n467\t                        let bucket: *mut stbds_hash_bucket =\n468\t                            (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n469\t\n470\t                        let mut z: usize = pos & STBDS_BUCKET_MASK;\n471\t                        while z < STBDS_BUCKET_LENGTH {\n472\t                            if (*bucket).hash[z] == 0 {\n473\t                                (*bucket).hash[z] = hash;\n474\t                                (*bucket).index[z] = (*ob).index[j];\n475\t                                break 'probe;\n476\t                            }\n477\t                            z += 1;\n478\t                        }\n479\t\n480\t                        let limit: usize = pos & STBDS_BUCKET_MASK;\n481\t                        let mut z: usize = 0;\n482\t                        while z < limit {\n483\t                            if (*bucket).hash[z] == 0 {\n484\t                                (*bucket).hash[z] = hash;\n485\t                                (*bucket).index[z] = (*ob).index[j];\n486\t                                break 'probe;\n487\t                            }\n488\t                            z += 1;\n489\t                        }\n490\t\n491\t                        pos = pos.wrapping_add(step);\n492\t                        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n493\t                        pos &= (*t).slot_count.wrapping_sub(1);\n494\t                    }\n495\t                }\n496\t                j += 1;\n497\t            }\n498\t            i += 1;\n499\t        }\n500\t    }\n501\t\n502\t    t\n503\t}\n504\t\n505\t// ---------------------------------------------------------------------------\n506\t// Hash functions\n507\t// ---------------------------------------------------------------------------\n508\t\n509\t#[inline]\n510\tfn stbds_rotate_left(val: usize, n: u32) -> usize {\n511\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n512\t}\n513\t\n514\t#[inline]\n515\tfn stbds_rotate_right(val: usize, n: u32) -> usize {\n516\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n517\t}\n518\t\n519\t#[unsafe(no_mangle)]\n520\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n521\t    let mut hash: usize = seed;\n522\t    let mut str_ = str_ as *const u8;\n523\t    while *str_ != 0 {\n524\t        hash = stbds_rotate_left(hash, 9).wrapping_add(*str_ as usize);\n525\t        str_ = str_.add(1);\n526\t    }\n527\t\n528\t    hash ^= seed;\n529\t    hash = (!hash).wrapping_add(hash << 18);\n530\t    hash ^= hash ^ stbds_rotate_right(hash, 31);\n531\t    hash = hash.wrapping_mul(21);\n532\t    hash ^= hash ^ stbds_rotate_right(hash, 11);\n533\t    hash = hash.wrapping_add(hash << 6);\n534\t    hash ^= stbds_rotate_right(hash, 22);\n535\t    hash.wrapping_add(seed)\n536\t}\n537\t\n538\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n539\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n540\t\n541\t#[inline]\n542\tfn stbds_sipround(v0: &mut usize, v1: &mut usize, v2: &mut usize, v3: &mut usize) {\n543\t    *v0 = v0.wrapping_add(*v1);\n544\t    *v1 = stbds_rotate_left(*v1, 13);\n545\t    *v1 ^= *v0;\n546\t    *v0 = stbds_rotate_left(*v0, STBDS_SIZE_T_BITS / 2);\n547\t    *v2 = v2.wrapping_add(*v3);\n548\t    *v3 = stbds_rotate_left(*v3, 16);\n549\t    *v3 ^= *v2;\n550\t    *v2 = v2.wrapping_add(*v1);