ader(a)->hash_table;\n697\t\n698\t  if (table == NULL || table->used_count >= table->used_count_threshold) {\n699\t    stbds_hash_index *nt;\n700\t    size_t slot_count;\n701\t\n702\t    slot_count = (table == NULL) ? STBDS_BUCKET_LENGTH : table->slot_count*2;\n703\t    nt = stbds_make_hash_index(slot_count, table);\n704\t    if (table)\n705\t      STBDS_FREE(NULL, table);\n706\t    else\n707\t      nt->string.mode = mode >= STBDS_HM_STRING ? STBDS_SH_DEFAULT : 0;\n708\t    stbds_header(a)->hash_table = table = nt;\n709\t    STBDS_STATS(++stbds_hash_grow);\n710\t  }\n711\t\n712\t  {\n713\t    size_t hash = mode >= STBDS_HM_STRING ? stbds_hash_string((char*)key,table->seed) : stbds_hash_bytes(key, keysize,table->seed);\n714\t    size_t step = STBDS_BUCKET_LENGTH;\n715\t    size_t pos;\n716\t    ptrdiff_t tombstone = -1;\n717\t    stbds_hash_bucket *bucket;\n718\t\n719\t    if (hash < 2) hash += 2;\n720\t\n721\t    pos = stbds_probe_position(hash, table->slot_count, table->slot_count_log2);\n722\t\n723\t    for (;;) {\n724\t      size_t limit, i;\n725\t      STBDS_STATS(++stbds_hash_probes);\n726\t      bucket = &table->storage[pos >> STBDS_BUCKET_SHIFT];\n727\t\n728\t      for (i=pos & STBDS_BUCKET_MASK; i < STBDS_BUCKET_LENGTH; ++i) {\n729\t        if (bucket->hash[i] == hash) {\n730\t          if (stbds_is_key_equal(raw_a, elemsize, key, keysize, keyoffset, mode, bucket->index[i])) {\n731\t            stbds_temp(a) = bucket->index[i];\n732\t            if (mode >= STBDS_HM_STRING)\n733\t              stbds_temp_key(a) = * (char **) ((char *) raw_a + elemsize*bucket->index[i] + keyoffset);\n734\t            return STBDS_ARR_TO_HASH(a,elemsize);\n735\t          }\n736\t        } else if (bucket->hash[i] == 0) {\n737\t          pos = (pos & ~STBDS_BUCKET_MASK) + i;\n738\t          goto found_empty_slot;\n739\t        } else if (tombstone < 0) {\n740\t          if (bucket->index[i] == STBDS_INDEX_DELETED)\n741\t            tombstone = (ptrdiff_t) ((pos & ~STBDS_BUCKET_