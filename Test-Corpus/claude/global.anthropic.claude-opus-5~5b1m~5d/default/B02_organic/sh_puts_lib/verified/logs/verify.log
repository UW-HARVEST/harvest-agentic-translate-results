).hash_table as *mut stbds_hash_index }\n224\t}\n225\t\n226\t/// `#define STBDS_HASH_TO_ARR(x,elemsize) ((char *) (x) - (elemsize))`\n227\t#[inline]\n228\tfn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n229\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n230\t}\n231\t\n232\t/// `#define STBDS_ARR_TO_HASH(x,elemsize) ((char *) (x) + (elemsize))`\n233\t#[inline]\n234\tfn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n235\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n236\t}\n237\t\n238\t#[inline]\n239\tfn byte_ptr(a: *mut c_void, off: usize) -> *mut u8 {\n240\t    (a as *mut u8).wrapping_add(off)\n241\t}\n242\t\n243\t// C library string/memory primitives, reimplemented so no extra dependency is\n244\t// needed.  Semantics are identical to the C originals.\n245\t#[inline]\n246\tunsafe fn c_strlen(s: *const c_char) -> usize {\n247\t    let mut n = 0usize;\n248\t    unsafe {\n249\t        while *s.add(n) != 0 {\n250\t            n += 1;\n251\t        }\n252\t    }\n253\t    n\n254\t}\n255\t\n256\t#[inline]\n257\tunsafe fn c_strcmp_eq(a: *const c_char, b: *const c_char) -> bool {\n258\t    let mut i = 0usize;\n259\t    unsafe {\n260\t        loop {\n261\t            let ca = *a.add(i) as u8;\n262\t            let cb = *b.add(i) as u8;\n263\t            if ca != cb {\n264\t                return false;\n265\t            }\n266\t            if ca == 0 {\n267\t                return true;\n268\t            }\n269\t            i += 1;\n270\t        }\n271\t    }\n272\t}\n273\t\n274\t#[inline]\n275\tunsafe fn c_memcmp_eq(a: *const u8, b: *const u8, n: usize) -> bool {\n276\t    let mut i = 0usize;\n277\t    unsafe {\n278\t        while i < n {\n279\t            if *a.add(i) != *b.add(i) {\n280\t                return false;\n281\t            }\n282\t            i += 1;\n283\t        }\n284\t    }\n285\t    true\n286\t}\n287\t\n288\t#[inline]\n289\tunsafe fn c_memmove(dst: *mut u8, src: *const u8, n: usize) {\