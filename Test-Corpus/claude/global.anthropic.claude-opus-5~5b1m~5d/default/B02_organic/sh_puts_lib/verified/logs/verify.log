at would trip a live C `assert` and take the whole test process down.\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1330,"cache_read_input_tokens":68407,"cache_creation":{"ephemeral_5m_input_tokens":1330,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"85c67007-c1a0-4312-93b1-f33e2c0c2f6e","uuid":"9d111535-85e6-4741-884a-3835364b1598","timestamp":"2026-08-27T16:39:58.332Z"}
