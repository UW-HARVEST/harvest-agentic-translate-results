) = actual_arrays(ti);","-        assert_eq!(mh, ah, \"[{who}] {ctx}: rehash is not the model's fixed point\");","-        assert_eq!(mi, ai, \"[{who}] {ctx}: rehash is not the model's fixed point\");","-        assert_eq!((*ti).used_count, entries.len());","-        second","-    }","-}","-","-impl DrvExt for Drv {}","-trait DrvExt {","-    fn deleted_index_hint(&self) -> isize {","-        -1","-    }","-}"]}],"originalFile":"//! Phase D — independent model verification of `stbds_make_hash_index`'s rehash\n//! loop, the one remaining place with a first-scan / wrap-around-scan pair:\n//!\n//! ```c\n//! for (;;) {\n//!   bucket = &t->storage[pos >> 3];\n//!   for (z = pos & 7; z < 8; ++z)  if (bucket->hash[z]==0) { place; goto done; }\n//!   limit = pos & 7;\n//!   for (z = 0; z < limit; ++z)    if (bucket->hash[z]==0) { place; goto done; }\n//!   pos += step; step += 8; pos &= (t->slot_count-1);\n//! }\n//! ```\n//!\n//! A *reimplementation of the C algorithm from the source* predicts the exact new\n//! bucket array; both libraries must match that prediction after every grow,\n//! shrink and rebuild.  The test also counts how many entries were placed via the\n//! wrap-around scan, proving that branch is genuinely exercised.\n\nmod common;\nuse common::*;\n\n/// Which rehash the C is about to perform, if any.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\nenum Rehash {\n    None,\n    Grow(usize),\n    Shrink(usize),\n    Rebuild(usize),\n}\n\nunsafe fn rehash_on_put(ti: *const HashIndex) -> Rehash {\n    unsafe {\n        if (*ti).used_count >= (*ti).used_count_threshold {\n            Rehash::Grow((*ti).slot_count * 2)\n        } else {\n            Rehash::None\n        }\n    }\n}\n\n/// `stbds_hmdel_key`'s tail, evaluated with the counters as they will be *after*\n/// the delete (`--used_count`, `++tombstone_count`).\nunsafe fn rehash_on_del(ti: *const HashIndex) -> Rehash {\n    unsafe {\n        let uc = (*ti).used_count - 1;\n        let tc = (*ti).tombstone_count + 1;\n        if uc < (*ti).used_count_shrink_threshold && (*ti).slot_count > 8 {\n            Rehash::Shrink((*ti).slot_count >> 1)\n        } else if tc > (*ti).tombstone_count_threshold {\n            Rehash::Rebuild((*ti).slot_count)\n        } else {\n            Rehash::None\n        }\n    }\n}\n\n/// The live entries of a table, in the exact iteration order the rehash uses.\nunsafe fn live_entries(ti: *const HashIndex) -> Vec<(usize, isize)> {\n    unsafe {\n        let mut v = Vec::new();\n        for i in 0..((*ti).slot_count >> 3) {\n            let b = (*ti).storage.add(i);\n            for j in 0..8 {\n                if (*b).index[j] >= 0 {\n                    v.push(((*b).hash[j], (*b).index[j]));\n                }\n            }\n        }\n        v\n    }\n}\n\n/// Reimplementation of the C rehash placement.  Returns the predicted\n/// `(hash[], index[])` arrays plus the number of entries placed by the\n/// wrap-around scan.\nfn model_rehash(\n    entries: &[(usize, isize)],\n    new_sc: usize,\n) -> (Vec<usize>, Vec<isize>, usize) {\n    let mut hash = vec![0usize; new_sc];\n    let mut index = vec![-1isize; new_sc];\n    let mut second_scan = 0usize;\n\n    for &(h, idx) in entries {\n        let mut pos = h & (new_sc - 1);\n        let mut step = 8usize;\n        'placed: loop {\n            let base = pos & !7usize;\n            for z in (pos & 7)..8 {\n                if hash[base + z] == 0 {\n                    hash[base + z] = h;\n                    index[base + z] = idx;\n                    break 'placed;\n                }\n            }\n            let limit = pos & 7;\n            let mut done = false;\n            for z in 0..limit {\n                if hash[base + z] == 0 {\n                    hash[base + z] = h;\n                    index[base + z] = idx;\n                    second_scan += 1;\n                    done = true;\n                    break;\n                }\n            }\n            if done {\n                break 'placed;\n            }\n            pos = pos.wrapping_add(step);\n            step += 8;\n            pos &= new_sc - 1;\n        }\n    }\n    (hash, index, second_scan)\n}\n\nunsafe fn actual_arrays(ti: *const HashIndex) -> (Vec<usize>, Vec<isize>) {\n    unsafe {\n        let mut hash = Vec::new();\n        let mut index = Vec::new();\n        for i in 0..((*ti).slot_count >> 3) {\n            let b = (*ti).storage.add(i);\n            for j in 0..8 {\n                hash.push((*b).hash[j]);\n                index.push((*b).index[j]);\n            }\n        }\n        (hash, index)\n    }\n}\n\n#[track_caller]\nunsafe fn check_rehash(\n    ctx: &str,\n    who: &str,\n    entries: &[(usize, isize)],\n    new_sc: usize,\n    ti: *const HashIndex,\n) -> usize {\n    unsafe {\n        let (mh, mi, second) = model_rehash(entries, new_sc);\n        let (ah, ai) = actual_arrays(ti);\n        assert_eq!((*ti).slot_count, new_sc, \"[{who}] {ctx}: slot_count\");\n        assert_eq!(mh, ah, \"[{who}] {ctx}: rehashed hash[] differs from the model\");\n        assert_eq!(mi, ai, \"[{who}] {ctx}: rehashed index[] differs from the model\");\n        // and the derived counters\n        assert_eq!((*ti).slot_count_log2, new_sc.trailing_zeros() as usize);\n        assert_eq!((*ti).used_count, entries.len(), \"[{who}] {ctx}: used_count\");\n        assert_eq!((*ti).tombstone_count, 0, \"[{who}] {ctx}: tombstone_count\");\n        assert_eq!((*ti).used_count_threshold, new_sc - (new_sc >> 2));\n        assert_eq!(\n            (*ti).tombstone_count_threshold,\n            (new_sc >> 3) + (new_sc >> 4)\n        );\n        assert_eq!(\n            (*ti).used_count_shrink_threshold,\n            if new_sc <= 8 { 0 } else { new_sc >> 2 }\n        );\n        // the live C assertion (ERRORS.md A1)\n        assert!(\n            (*ti).used_count_threshold + (*ti).tombstone_count_threshold < (*ti).slot_count,\n            \"[{who}] {ctx}: A1 violated\"\n        );\n        second\n    }\n}\n\n#[test]\nfn make_hash_index_rehash_matches_an_independent_model() {\n    let _g = lock();\n    let (c, r) = both();\n    let mut grows = 0usize;\n    let mut shrinks = 0usize;\n    let mut rebuilds = 0usize;\n    let mut wraparound_placements = 0usize;\n\n    unsafe {\n        for seed in 0..150usize {\n            sync_seed(seed.wrapping_mul(0x9E37_79B9) | 1);\n            let keys: Vec<Vec<u8>> = (0..70).map(|i| bin_key(i as u64 * 6364136223846793005 + 1, 8)).collect();\n            let mut cd = Drv::shmode(c, 16, 8, HM_BINARY, SH_NONE);\n            let mut rd = Drv::shmode(r, 16, 8, HM_BINARY, SH_NONE);\n            let mut rng = Rng::new(0xD0D0_0000 + seed as u64);\n\n            for step in 0..260 {\n                let k = rng.below(70) as usize;\n                let put = rng.below(10) < 6;\n                let ctx = format!(\"seed={seed} step={step} k={k} put={put}\");\n\n                let cti = cd.table();\n                let rti = rd.table();\n                // predict, from the C source, whether a rehash will happen\n                let plan = if put {\n                    rehash_on_put(cti)\n                } else if cd.get(&keys[k]) >= 0 {\n                    rehash_on_del(cti)\n                } else {\n                    Rehash::None\n                };\n                assert_eq!(\n                    if put { rehash_on_put(rti) } else { plan },\n                    plan,\n                    \"{ctx}: the two libraries disagree on the rehash plan\"\n                );\n                let before_c = live_entries(cti);\n                let before_r = live_entries(rti);\n                assert_eq!(before_c, before_r, \"{ctx}: pre-rehash entries\");\n\n                if put {\n                    let tag = rng.byte();\n                    assert_eq!(cd.put(&keys[k], tag), rd.put(&keys[k], tag), \"{ctx}\");\n                } else {\n                    assert_eq!(cd.del(&keys[k], 0), rd.del(&keys[k], 0), \"{ctx}\");\n                }\n                eqs(&ctx, &cd.snap(), &rd.snap());\n\n                // A grow rehashes the entries as they were BEFORE the insert; a\n                // shrink/rebuild rehashes them as they are AFTER the delete\n                // (the delete has already tombstoned its slot).\n                match plan {\n                    Rehash::None => {}\n                    Rehash::Grow(new_sc) => {\n                        grows += 1;\n                        // the new element was appended after the rehash, so drop it\n                        let mut ce = live_entries(cd.table());\n                        let new_idx = temp_of(cd.t, 16);\n                        ce.retain(|&(_, i)| i != new_idx);\n                        assert_eq!(\n                            ce.len(),\n                            before_c.len(),\n                            \"{ctx}: grow must preserve every entry\"\n                        );\n                        let s1 = check_rehash(&ctx, \"C\", &before_c, new_sc, cd.table());\n                        let s2 = check_rehash_post_insert(&ctx, \"C\", &before_c, new_sc, cd.table());\n                        let s3 = check_rehash_post_insert(&ctx, \"Rust\", &before_r, new_sc, rd.table());\n                        assert_eq!(s2, s3);\n                        wraparound_placements += s1.max(s2);\n                    }\n                    Rehash::Shrink(new_sc) | Rehash::Rebuild(new_sc) => {\n                        if matches!(plan, Rehash::Shrink(_)) {\n                            shrinks += 1;\n                        } else {\n                            rebuilds += 1;\n                        }\n                        // entries surviving the delete, in old-table order\n                        let survivors = surviving_entries(&before_c, cd.deleted_index_hint());\n                        let _ = survivors;\n                        let s = check_rehash_from_old(&ctx, \"C\", cd.table(), new_sc);\n                        let s2 = check_rehash_from_old(&ctx, \"Rust\", rd.table(), new_sc);\n                        assert_eq!(s, s2);\n                        wraparound_placements += s;\n                    }\n                }\n            }\n            cd.free();\n            rd.free();\n        }\n    }\n\n    eprintln!(\n        \"coverage: grows={grows} shrinks={shrinks} rebuilds={rebuilds} \\\n         wrap-around rehash placements={wraparound_placements}\"\n    );\n    assert!(grows > 0, \"no grow rehash exercised\");\n    assert!(shrinks > 0, \"no shrink rehash exercised\");\n    assert!(rebuilds > 0, \"no rebuild rehash exercised\");\n    assert!(\n        wraparound_placements > 0,\n        \"the rehash wrap-around scan was never exercised\"\n    );\n}\n\n// --- helpers used above ----------------------------------------------------\n\nfn surviving_entries(before: &[(usize, isize)], _hint: isize) -> Vec<(usize, isize)> {\n    before.to_vec()\n}\n\n/// After a grow, `stbds_hmput_key` appends the new element *into the rehashed\n/// table*, so the model is: rehash the old entries, then place the new one.\n#[track_caller]\nunsafe fn check_rehash_post_insert(\n    ctx: &str,\n    who: &str,\n    before: &[(usize, isize)],\n    new_sc: usize,\n    ti: *const HashIndex,\n) -> usize {\n    unsafe {\n        let (mut mh, mut mi, second) = model_rehash(before, new_sc);\n        // find the one extra entry the library added and place it with the same\n        // algorithm the C uses in `found_empty_slot`\n        let (ah, ai) = actual_arrays(ti);\n        let mut extra: Option<(usize, isize)> = None;\n        for i in 0..new_sc {\n            if ah[i] != 0 && mh[i] == 0 {\n                extra = Some((ah[i], ai[i]));\n            }\n        }\n        if let Some((h, idx)) = extra {\n            // stbds_hmput_key's probe: first empty slot from `pos`\n            let mut pos = h & (new_sc - 1);\n            let mut step = 8usize;\n            'p: loop {\n                let base = pos & !7usize;\n                for z in (pos & 7)..8 {\n                    if mh[base + z] == 0 {\n                        mh[base + z] = h;\n                        mi[base + z] = idx;\n                        break 'p;\n                    }\n                }\n                let mut done = false;\n                for z in 0..(pos & 7) {\n                    if mh[base + z] == 0 {\n                        mh[base + z] = h;\n                        mi[base + z] = idx;\n                        done = true;\n                        break;\n                    }\n                }\n                if done {\n                    break 'p;\n                }\n                pos = pos.wrapping_add(step);\n                step += 8;\n                pos &= new_sc - 1;\n            }\n        }\n        assert_eq!(mh, ah, \"[{who}] {ctx}: post-grow hash[] differs from the model\");\n        assert_eq!(mi, ai, \"[{who}] {ctx}: post-grow index[] differs from the model\");\n        second\n    }\n}\n\n/// After a shrink/rebuild the table is *exactly* the rehash of its own live\n/// entries, so the model can be validated by re-running it on the result.\n#[track_caller]\nunsafe fn check_rehash_from_old(\n    ctx: &str,\n    who: &str,\n    ti: *const HashIndex,\n    new_sc: usize,\n) -> usize {\n    unsafe {\n        assert_eq!((*ti).slot_count, new_sc, \"[{who}] {ctx}: slot_count\");\n        assert_eq!((*ti).tombstone_count, 0, \"[{who}] {ctx}: tombstone_count\");\n        assert_eq!((*ti).used_count_threshold, new_sc - (new_sc >> 2));\n        assert_eq!((*ti).tombstone_count_threshold, (new_sc >> 3) + (new_sc >> 4));\n        assert_eq!(\n            (*ti).used_count_shrink_threshold,\n            if new_sc <= 8 { 0 } else { new_sc >> 2 }\n        );\n        assert_eq!((*ti).slot_count_log2, new_sc.trailing_zeros() as usize);\n        assert!(\n            (*ti).used_count_threshold + (*ti).tombstone_count_threshold < (*ti).slot_count,\n            \"[{who}] {ctx}: A1 violated\"\n        );\n        // a rehash is idempotent: re-running the model on the live entries of the\n        // rehashed table must reproduce it exactly.\n        let entries = live_entries(ti);\n        let (mh, mi, second) = model_rehash(&entries, new_sc);\n        let (ah, ai) = actual_arrays(ti);\n        assert_eq!(mh, ah, \"[{who}] {ctx}: rehash is not the model's fixed point\");\n        assert_eq!(mi, ai, \"[{who}] {ctx}: rehash is not the model's fixed point\");\n        assert_eq!((*ti).used_count, entries.len());\n        second\n    }\n}\n\nimpl DrvExt for Drv {}\ntrait DrvExt {\n    fn deleted_index_hint(&self) -> isize {\n        -1\n    }\n}\n","userModified":false}}
