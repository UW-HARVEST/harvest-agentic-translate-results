94\t#[repr(C)]\n95\t#[derive(Clone, Copy)]\n96\tpub struct cp_pixel_t {\n97\t    pub r: u8,\n98\t    pub g: u8,\n99\t    pub b: u8,\n100\t    pub a: u8,\n101\t}\n102\t\n103\t// ---------------------------------------------------------------------------\n104\t// src/lib.c\n105\t// ---------------------------------------------------------------------------\n106\t\n107\t/// `typedef struct cp_image_t { int w; int h; cp_pixel_t *pix; } cp_image_t;`\n108\t#[repr(C)]\n109\t#[derive(Clone, Copy)]\n110\tpub struct cp_image_t {\n111\t    pub w: c_int,\n112\t    pub h: c_int,\n113\t    pub pix: *mut cp_pixel_t,\n114\t}\n115\t\n116\t#[inline]\n117\tfn cp_make_pixel_a(r: u8, g: u8, b: u8, a: u8) -> cp_pixel_t {\n118\t    let mut p = cp_pixel_t { r: 0, g: 0, b: 0, a: 0 };\n119\t    p.r = r;\n120\t    p.g = g;\n121\t    p.b = b;\n122\t    p.a = a;\n123\t    p\n124\t}\n125\t\n126\t#[inline]\n127\tfn cp_make_pixel(r: u8, g: u8, b: u8) -> cp_pixel_t {\n128\t    let mut p = cp_pixel_t { r: 0, g: 0, b: 0, a: 0 };\n129\t    p.r = r;\n130\t    p.g = g;\n131\t    p.b = b;\n132\t    p.a = 0xFF;\n133\t    p\n134\t}\n135\t\n136\t// --- exported globals ------------------------------------------------------\n137\t\n138\t/// `const char *cp_error_reason;`\n139\t#[unsafe(no_mangle)]\n140\tpub static mut cp_error_reason: *const c_char = ptr::null();\n141\t\n142\tconst fn cp_build_fixed_table() -> [u8; 288 + 32] {\n143\t    // 144 * 8, 112 * 9, 24 * 7, 8 * 8, 32 * 5  (verified against the C object)\n144\t    let mut t = [0u8; 288 + 32];\n145\t    let mut i = 0usize;\n146\t    while i < 144 {\n147\t        t[i] = 8;\n148\t        i += 1;\n149\t    }\n150\t    while i < 256 {\n151\t        t[i] = 9;\n152\t        i += 1;\n153\t    }\n154\t    while i < 280 {\n155\t        t[i] = 7;\n156\t        i += 1;\n157\t    }\n158\t    while i < 288 {\n159\t        t[i] = 8;\n160\t        i += 1;\n161\t    }\n162\t    while i < 288 + 32 {\n163\t        t[i] = 5;\n164\t        i += 1;\n165\t    }\n166\t    t\