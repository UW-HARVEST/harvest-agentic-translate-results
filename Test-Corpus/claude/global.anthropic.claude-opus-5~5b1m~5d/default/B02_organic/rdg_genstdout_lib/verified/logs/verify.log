-----------------------------------------------------\n43\t\n44\t/// Equivalent of `strlen(s)`.\n45\t///\n46\t/// # Safety\n47\t/// `s` must point to a NUL terminated string.\n48\tunsafe fn strlen(s: *const c_char) -> usize {\n49\t    let mut len = 0usize;\n50\t    // SAFETY: guaranteed by the caller; walks until the terminating NUL.\n51\t    while unsafe { *s.add(len) } != 0 {\n52\t        len += 1;\n53\t    }\n54\t    len\n55\t}\n56\t\n57\t/// Equivalent of `strrchr(s, c)`.\n58\t///\n59\t/// As mandated by the C standard, the terminating NUL byte is considered to be\n60\t/// part of the string, so `strrchr(s, 0)` yields a pointer to that NUL byte.\n61\t///\n62\t/// # Safety\n63\t/// `s` must point to a NUL terminated string.\n64\tunsafe fn strrchr(s: *const c_char, c: c_char) -> *const c_char {\n65\t    // SAFETY: guaranteed by the caller.\n66\t    let len = unsafe { strlen(s) };\n67\t    let mut i = len as isize;\n68\t    while i >= 0 {\n69\t        // SAFETY: `i` stays within `0..=len`, i.e. inside the string including\n70\t        // its terminator.\n71\t        if unsafe { *s.offset(i) } == c {\n72\t            return unsafe { s.offset(i) };\n73\t        }\n74\t        i -= 1;\n75\t    }\n76\t    core::ptr::null()\n77\t}\n78\t\n79\t/// Equivalent of `memcpy(dst, src, n)`.\n80\t///\n81\t/// # Safety\n82\t/// The `n` bytes at `src` and at `dst` must be valid and non-overlapping.\n83\tunsafe fn memcpy(dst: *mut c_char, src: *const c_char, n: usize) {\n84\t    // SAFETY: guaranteed by the caller.\n85\t    unsafe { core::ptr::copy_nonoverlapping(src, dst, n) };\n86\t}\n87\t\n88\t// ---------------------------------------------------------------------------\n89\t// Public ABI\n90\t// ---------------------------------------------------------------------------\n91\t\n92\t/// ```c\n93\t/// const char* extractFilename(const char* path, char separator)\n94\t/// ```\n95\t///\n96\t/// Returns the portion of `path` following the last occurrence of `separator`,\n97\t/// or `