rust() {\n    let cs = defined_symbols(&c_so());\n    let rs = defined_symbols(&rust_so());\n    assert!(!cs.is_empty(), \"no symbols found in the C .so\");\n    let missing: Vec<&String> = cs.iter().filter(|s| !rs.contains(s)).collect();\n    assert!(\n        missing.is_empty(),\n        \"symbols exported by C but MISSING from Rust: {missing:?}\\nC={cs:?}\\nRust={rs:?}\"\n    );\n}\n\n#[test]\nfn d2_expected_symbol_set() {\n    let cs = defined_symbols(&c_so());\n    assert_eq!(\n        cs,\n        vec![\n            \"FIO_createFilename_fromOutDir\".to_string(),\n            \"extractFilename\".to_string()\n        ],\n        \"the C symbol set changed; SYMBOLS.md must be regenerated\"\n    );\n}\n\n#[test]\nfn d3_rust_so_has_no_unresolved_non_libc_symbols() {\n    let so = rust_so();\n    let out = Command::new(\"nm\")\n        .args([\"-D\", \"--undefined-only\", so.to_str().unwrap()])\n        .output()\n        .expect(\"nm\");\n    let undef: Vec<String> = String::from_utf8_lossy(&out.stdout)\n        .lines()\n        .filter_map(|l| l.split_whitespace().last().map(str::to_string))\n        .collect();\n    // Everything the Rust .so imports must come from libc / the dynamic loader.\n    let allowed_prefixes = [\n        \"__\", \"_ITM\", \"_Unwind\", \"abort\", \"calloc\", \"exit\", \"fprintf\", \"free\", \"malloc\",\n        \"memcpy\", \"memset\", \"realloc\", \"strerror\", \"stderr\", \"posix_\", \"pthread_\", \"dl\",\n        \"getenv\", \"write\", \"sigaction\", \"raise\", \"syscall\", \"memcmp\", \"memmove\", \"bcmp\",\n        \"strlen\", \"gnu_get_libc_version\",\n    ];\n    let bad: Vec<&String> = undef\n        .iter()\n        .filter(|s| !allowed_prefixes.iter().any(|p| s.starts_with(p)))\n        .collect();\n    assert!(\n        bad.is_empty(),\n        \"Rust .so has unresolved non-libc symbols: {bad:?}\\nall undefined: {undef:?}\"\n    );\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
