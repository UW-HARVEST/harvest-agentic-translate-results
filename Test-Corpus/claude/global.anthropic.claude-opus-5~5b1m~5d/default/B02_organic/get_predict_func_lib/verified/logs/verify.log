{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CcKUBvzwww8x1sMZW973MM","type":"tool_result","content":"474\t#[cfg(feature = \"difftest\")]\n475\t#[unsafe(no_mangle)]\n476\tpub unsafe extern \"C\" fn __difftest_predict(\n477\t    which: c_int,\n478\t    psamp: *mut c_int,\n479\t    idx: c_int,\n480\t    pfcn: c_int,\n481\t    ridx: *mut btac1c_idxstate,\n482\t) -> c_int {\n483\t    let f: PredictFn = match which {\n484\t        0 => BTAC1C2_PredictSample_Pfn0,\n485\t        1 => BTAC1C2_PredictSample_Pfn1,\n486\t        2 => BTAC1C2_PredictSample_Pfn2,\n487\t        3 => BTAC1C2_PredictSample_Pfn3,\n488\t        4 => BTAC1C2_PredictSample_Pfn4,\n489\t        5 => BTAC1C2_PredictSample_Pfn5,\n490\t        6 => BTAC1C2_PredictSample_Pfn6,\n491\t        7 => BTAC1C2_PredictSample_Pfn7,\n492\t        8 => BTAC1C2_PredictSample_Pfn8,\n493\t        9 => BTAC1C2_PredictSample_Pfn9,\n494\t        10 => BTAC1C2_PredictSample_Pfn10,\n495\t        11 => BTAC1C2_PredictSample_Pfn11,\n496\t        _ => BTAC1C2_PredictSample,\n497\t    };\n498\t    unsafe { f(psamp, idx, pfcn, ridx) }\n499\t}\n500\t\n501\t/// Verification-only hook, `difftest` feature only.  Reports WHICH internal\n502\t/// predictor `BTAC1C2_GetPredictFunc(pfcn)` selected, as an index: `0..=11` for\n503\t/// the corresponding `BTAC1C2_PredictSample_PfnN`, or `-1` for the generic\n504\t/// `BTAC1C2_PredictSample` (the `default:` arm).\n505\t///\n506\t/// This lets the differential tests observe the dispatcher's choice directly,\n507\t/// rather than only through `get_predict_func`'s collapsed 1/0 answer.  The C\n508\t/// side is observed the same way, by mapping the `void *` that\n509\t/// `BTAC1C2_GetPredictFunc` returns onto the addresses `nm` reports for the\n510\t/// corresponding `static` functions.\n511\t#[cfg(feature = \"difftest\")]\n512\t#[unsafe(no_mangle)]\n513\tpub extern \"C\" fn __difftest_getpredict_index(pfcn: c_int) -> c_int {\n514\t    let fcn = BTAC1C2_GetPredictFunc(pfcn);\n515\t    let table: [PredictFn; 12] = [\n516\t        BTAC1C2_PredictSample_Pfn0,\n517\t        BTAC1C2_PredictSample_Pfn1,\n518\t        BTAC1C2_PredictSample_Pfn2,\n519\t        BTAC1C2_PredictSample_Pfn3,\n520\t        BTAC1C2_PredictSample_Pfn4,\n521\t        BTAC1C2_PredictSample_Pfn5,\n522\t        BTAC1C2_PredictSample_Pfn6,\n523\t        BTAC1C2_PredictSample_Pfn7,\n524\t        BTAC1C2_PredictSample_Pfn8,\n525\t        BTAC1C2_PredictSample_Pfn9,\n526\t        BTAC1C2_PredictSample_Pfn10,\n527\t        BTAC1C2_PredictSample_Pfn11,\n528\t    ];\n529\t    for (i, f) in table.iter().enumerate() {\n530\t        if fcn == *f as *const () {\n531\t            return i as c_int;\n532\t        }\n533\t    }\n534\t    if fcn == BTAC1C2_PredictSample as PredictFn as *const () {\n535\t        return -1;\n536\t    }\n537\t    -2 // unreachable: dispatcher returned an unrecognised pointer\n538\t}\n539\t"}]},"parent_tool_use_id":null,"session_id":"9cc3d074-7e08-4b72-9c53-7efe80847659","uuid":"0b8a8549-0640-41a6-9ea2-565b12fada3d","timestamp":"2026-08-27T09:04:09.274Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-M3fAKX/translation/src/lib.rs","content":"#[cfg(feature = \"difftest\")]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn __difftest_predict(\n    which: c_int,\n    psamp: *mut c_int,\n    idx: c_int,\n    pfcn: c_int,\n    ridx: *mut btac1c_idxstate,\n) -> c_int {\n    let f: PredictFn = match which {\n        0 => BTAC1C2_PredictSample_Pfn0,\n        1 => BTAC1C2_PredictSample_Pfn1,\n        2 => BTAC1C2_PredictSample_Pfn2,\n        3 => BTAC1C2_PredictSample_Pfn3,\n        4 => BTAC1C2_PredictSample_Pfn4,\n        5 => BTAC1C2_PredictSample_Pfn5,\n        6 => BTAC1C2_PredictSample_Pfn6,\n        7 => BTAC1C2_PredictSample_Pfn7,\n        8 => BTAC1C2_PredictSample_Pfn8,\n        9 => BTAC1C2_PredictSample_Pfn9,\n        10 => BTAC1C2_PredictSample_Pfn10,\n        11 => BTAC1C2_PredictSample_Pfn11,\n        _ => BTAC1C2_PredictSample,\n    };\n    unsafe { f(psamp, idx, pfcn, ridx) }\n}\n\n/// Verification-only hook, `difftest` feature only.  Reports WHICH internal\n/// predictor `BTAC1C2_GetPredictFunc(pfcn)` selected, as an index: `0..=11` for\n/// the corresponding `BTAC1C2_PredictSample_PfnN`, or `-1` for the generic\n/// `BTAC1C2_PredictSample` (the `default:` arm).\n///\n/// This lets the differential tests observe the dispatcher's choice directly,\n/// rather than only through `get_predict_func`'s collapsed 1/0 answer.  The C\n/// side is observed the same way, by mapping the `void *` that\n/// `BTAC1C2_GetPredictFunc` returns onto the addresses `nm` reports for the\n/// corresponding `static` functions.\n#[cfg(feature = \"difftest\")]\n#[unsafe(no_mangle)]\npub extern \"C\" fn __difftest_getpredict_index(pfcn: c_int) -> c_int {\n    let fcn = BTAC1C2_GetPredictFunc(pfcn);\n    let table: [PredictFn; 12] = [\n        BTAC1C2_PredictSample_Pfn0,\n        BTAC1C2_PredictSample_Pfn1,\n        BTAC1C2_PredictSample_Pfn2,\n        BTAC1C2_PredictSample_Pfn3,\n        BTAC1C2_PredictSample_Pfn4,\n        BTAC1C2_PredictSample_Pfn5,\n        BTAC1C2_PredictSample_Pfn6,\n        BTAC1C2_PredictSample_Pfn7,\n        BTAC1C2_PredictSample_Pfn8,\n        BTAC1C2_PredictSample_Pfn9,\n        BTAC1C2_PredictSample_Pfn10,\n        BTAC1C2_PredictSample_Pfn11,\n    ];\n    for (i, f) in table.iter().enumerate() {\n        if fcn == *f as *const () {\n            return i as c_int;\n        }\n    }\n    if fcn == BTAC1C2_PredictSample as PredictFn as *const () {\n        return -1;\n    }\n    -2 // unreachable: dispatcher returned an unrecognised pointer\n}\n","numLines":66,"startLine":474,"totalLines":539}}}
