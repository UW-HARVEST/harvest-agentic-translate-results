{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_wb4efr3jmhdcagyliscr7amk2tofthqmbpvtparok6bledx3g72a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Abpi2MLr3uMoXNtcJwkwUG","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-M3fAKX/translation/tests/smoke.rs","content":"//! Harness self-check: proves the `nm`-anchored address recovery actually lands\n//! on the real C `static` functions before any behavioural conclusions are drawn\n//! from it.  If this file fails, every \"deep\" differential result is meaningless.\n\nmod common;\n\nuse common::*;\n\n#[test]\nfn both_libraries_load_and_export_get_predict_func() {\n    let p = Pair::load();\n    // Public symbol reachable in both, through dlsym only.\n    assert_eq!(unsafe { (p.c.get_predict_func())(0) }, 1);\n    assert_eq!(unsafe { (p.r.get_predict_func())(0) }, 1);\n}\n\n#[test]\nfn nm_reports_all_fifteen_internal_c_functions() {\n    let c = CLib::load();\n    for name in PFN_NAMES.iter() {\n        let a = c.addr_of(name);\n        assert!(a > 0, \"{name} resolved to a null address\");\n    }\n    assert!(c.addr_of(GENERIC_NAME) > 0);\n    assert!(c.addr_of(DISPATCH_NAME) > 0);\n}\n\n#[test]\nfn recovered_addresses_are_distinct() {\n    // If the C compiler had folded identical function bodies together, the\n    // address-identity semantics of get_predict_func would change.  Confirm the\n    // 14 predictors really are 14 distinct addresses.\n    let c = CLib::load();\n    let mut addrs: Vec<usize> = PFN_NAMES.iter().map(|n| c.addr_of(n)).collect();\n    addrs.push(c.addr_of(GENERIC_NAME));\n    let mut sorted = addrs.clone();\n    sorted.sort_unstable();\n    sorted.dedup();\n    assert_eq!(sorted.len(), addrs.len(), \"C folded some predictors together\");\n}\n\n#[test]\nfn recovered_c_dispatcher_agrees_with_public_symbol() {\n    // Cross-validate the address arithmetic: BTAC1C2_GetPredictFunc, reached via\n    // the reconstructed address, must select exactly the predictor that the\n    // publicly-exported get_predict_func reports success for.\n    let c = CLib::load();\n    let public = c.get_predict_func();\n    for pfcn in -20..=20i32 {\n        let idx = c.getpredict_index(pfcn);\n        let pub_result = unsafe { public(pfcn) };\n        if (0..=11).contains(&pfcn) {\n            assert_eq!(idx, pfcn, \"dispatcher picked the wrong predictor for {pfcn}\");\n            assert_eq!(pub_result, 1, \"get_predict_func({pfcn}) should be 1\");\n        } else {\n            assert_eq!(idx, -1, \"pfcn={pfcn} should select the generic predictor\");\n            assert_eq!(pub_result, 0, \"get_predict_func({pfcn}) should be 0\");\n        }\n    }\n}\n\n#[test]\nfn recovered_c_predictor_computes_something_sane() {\n    // Pfn0 is `psamp[(idx-1) & 7]`, a pure select: easy ground truth for\n    // validating that we really called the intended C function.\n    let c = CLib::load();\n    let f = c.pfn(0);\n    let mut buf: [i32; 8] = [10, 20, 30, 40, 50, 60, 70, 80];\n    for idx in 0..8i32 {\n        let got = unsafe { f(buf.as_mut_ptr(), idx, 0, std::ptr::null_mut()) };\n        let want = buf[((idx - 1) & 7) as usize];\n        assert_eq!(got, want, \"Pfn0 mismatch at idx={idx}\");\n    }\n}\n\n#[test]\nfn difftest_hook_presence_matches_feature() {\n    let r = RLib::load();\n    if cfg!(feature = \"difftest\") {\n        assert!(\n            r.difftest_predict().is_some(),\n            \"difftest feature on, but __difftest_predict missing from the .so\"\n        );\n        assert!(r.difftest_getpredict_index().is_some());\n    } else {\n        assert!(\n            r.difftest_predict().is_none(),\n            \"default build must not export __difftest_predict\"\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8823,"cache_read_input_tokens":53366,"cache_creation":{"ephemeral_5m_input_tokens":8823,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9cc3d074-7e08-4b72-9c53-7efe80847659","uuid":"353598ff-733e-4bf1-9237-43dafc9d75b8","timestamp":"2026-08-27T09:03:49.189Z"}
