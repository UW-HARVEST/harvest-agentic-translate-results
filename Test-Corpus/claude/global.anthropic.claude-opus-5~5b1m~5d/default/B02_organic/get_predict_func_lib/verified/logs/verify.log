b idx: btac1c_u16,\n47\t    pub lpred: btac1c_s16,\n48\t    pub rpred: btac1c_s16,\n49\t    pub tag: btac1c_byte,\n50\t    pub bcfcn: btac1c_byte,\n51\t    pub bsfcn: btac1c_byte,\n52\t    pub usefx: btac1c_byte,\n53\t    pub firfx: [[btac1c_s16; 8]; 4],\n54\t}\n55\t\n56\t/// The common signature shared by `BTAC1C2_PredictSample` and every\n57\t/// `BTAC1C2_PredictSample_PfnN` helper:\n58\t/// `int f(int *psamp, int idx, int pfcn, btac1c_idxstate *ridx)`.\n59\ttype PredictFn =\n60\t    unsafe extern \"C\" fn(*mut c_int, c_int, c_int, *mut btac1c_idxstate) -> c_int;\n61\t\n62\t// ---------------------------------------------------------------------------\n63\t// helpers\n64\t// ---------------------------------------------------------------------------\n65\t\n66\t/// `psamp[(i - k) & 7]` — the C code masks a possibly-negative index with 7,\n67\t/// which on two's-complement hardware always yields a value in `0..=7`.\n68\t#[inline(always)]\n69\tunsafe fn s(psamp: *const c_int, i: c_int, k: c_int) -> c_int {\n70\t    let off = (i.wrapping_sub(k)) & 7;\n71\t    unsafe { *psamp.offset(off as isize) }\n72\t}\n73\t\n74\t// ---------------------------------------------------------------------------\n75\t// static int BTAC1C2_PredictSample(int *psamp, int idx, int pfcn,\n76\t//                                  btac1c_idxstate *ridx)\n77\t// ---------------------------------------------------------------------------\n78\t\n79\t#[inline(never)]\n80\tunsafe extern \"C\" fn BTAC1C2_PredictSample(\n81\t    psamp: *mut c_int,\n82\t    idx: c_int,\n83\t    pfcn: c_int,\n84\t    ridx: *mut btac1c_idxstate,\n85\t) -> c_int {\n86\t    let pred: c_int;\n87\t    let p0: c_int;\n88\t    let p1: c_int;\n89\t    let i: c_int = idx;\n90\t\n91\t    unsafe {\n92\t        match pfcn {\n93\t            0 => {\n94\t                pred = s(psamp, i, 1);\n95\t            }\n96\t            1 => {\n97\t                pred = 2i32\n98\t                    .wrapping_mul(s(psamp, i, 1))\n99\t                    .wrapping_sub(s(psamp, i, 2));\n100\t            }\n101\t            2 => {\n102\t                pred = (3i32\n103\t                    .wrapping_mul(s(psamp, i, 1))\n104\t                    .wrapping_sub(s(psamp, i, 2)))\n105\t                    >> 1;\n106\t            }\n107\t            3 => {\n108\t                pred = (5i32\n109\t                    .wrapping_mul(s(psamp, i, 1))\n110\t                    .wrapping_sub(s(psamp, i, 2)))\n111\t                    >> 2;\n112\t            }\n113\t            4 => {\n114\t                p0 = s(psamp, i, 1).wrapping_add(s(psamp, i, 2));\n115\t                p1 = s(psamp, i, 2).wrapping_add(s(psamp, i, 3));\n116\t                pred = p0.wrapping_sub(p1 >> 1);\n117\t            }\n118\t            5 => {\n119\t                p0 = s(psamp, i, 1).wrapping_add(s(psamp, i, 2));\n120\t                p1 = s(psamp, i, 2).wrapping_add(s(psamp, i, 3));\n121\t                pred = (3i32.wrapping_mul(p0).wrapping_sub(p1)) >> 2;\n122\t            }\n123\t            6 => {\n124\t                p0 = s(psamp, i, 1).wrapping_add(s(psamp, i, 2));\n125\t                p1 = s(psamp, i, 2).wrapping_add(s(psamp, i, 3));\n126\t                pred = (5i32.wrapping_mul(p0).wrapping_sub(p1)) >> 3;\n127\t            }\n128\t            7 => {\n129\t                pred = (18i32\n130\t                    .wrapping_mul(s(psamp, i, 1))\n131\t                    .wrapping_sub(4i32.wrapping_mul(s(psamp, i, 2)))\n132\t                    .wrapping_add(3i32.wrapping_mul(s(psamp, i, 3)))\n133\t                    .wrapping_sub(2i32.wrapping_mul(s(psamp, i, 4)))\n134\t                    .wrapping_add(1i32.wrapping_mul(s(psamp, i, 5))))\n135\t                    .wrapping_div(16);\n136\t            }\n137\t            8 => {\n138\t                pred = (72i32\n139\t                    .wrapping_mul(s(psamp, i, 1))\n140\t                    .wrapping_sub(16i32.wrapping_mul(s(psamp, i, 2)))\n141\t                    .wrapping_a