psamp, i, 5)\n178\t                    .wrapping_add(s(psamp, i, 6))\n179\t                    .wrapping_add(s(psamp, i, 7))\n180\t                    .wrapping_add(s(psamp, i, 8));\n181\t                pred = (p0.wrapping_add(p1)) >> 3;\n182\t            }\n183\t            12 | 13 | 14 | 15 => {\n184\t                let row = &(*ridx).firfx[(pfcn - 12) as usize];\n185\t                let mut acc: c_int = (row[0] as c_int).wrapping_mul(s(psamp, i, 1));\n186\t                acc = acc.wrapping_add((row[1] as c_int).wrapping_mul(s(psamp, i, 2)));\n187\t                acc = acc.wrapping_add((row[2] as c_int).wrapping_mul(s(psamp, i, 3)));\n188\t                acc = acc.wrapping_add((row[3] as c_int).wrapping_mul(s(psamp, i, 4)));\n189\t                acc = acc.wrapping_add((row[4] as c_int).wrapping_mul(s(psamp, i, 5)));\n190\t                acc = acc.wrapping_add((row[5] as c_int).wrapping_mul(s(psamp, i, 6)));\n191\t                acc = acc.wrapping_add((row[6] as c_int).wrapping_mul(s(psamp, i, 7)));\n192\t                acc = acc.wrapping_add((row[7] as c_int).wrapping_mul(s(psamp, i, 8)));\n193\t                pred = acc.wrapping_div(256);\n194\t            }\n195\t            _ => {\n196\t                pred = 0;\n197\t            }\n198\t        }\n199\t    }\n200\t\n201\t    pred\n202\t}\n203\t\n204\t// ---------------------------------------------------------------------------\n205\t// The twelve specialised predictors.  Each keeps the four-parameter C signature\n206\t// even though `pfcn` and `ridx` go unused, because the address of each one is\n207\t// stored into a `void *` of that shape.\n208\t// ---------------------------------------------------------------------------\n209\t\n210\t#[inline(never)]\n211\tunsafe extern \"C\" fn BTAC1C2_PredictSample_Pfn0(\n212\t    psamp: *mut c_int,\n213\t    idx: c_int,\n214\t    _pfcn: c_int,\n215\t    _ridx: *mut btac1c_idxstate,\n216\t) -> c_int {\n217\t    unsafe { s(psamp, idx, 1) }\n218\t}\n219\t\n220\