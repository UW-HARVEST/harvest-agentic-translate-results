\t    }\n342\t}\n343\t\n344\t#[inline(never)]\n345\tunsafe extern \"C\" fn BTAC1C2_PredictSample_Pfn9(\n346\t    psamp: *mut c_int,\n347\t    idx: c_int,\n348\t    _pfcn: c_int,\n349\t    _ridx: *mut btac1c_idxstate,\n350\t) -> c_int {\n351\t    unsafe {\n352\t        (76i32\n353\t            .wrapping_mul(s(psamp, idx, 1))\n354\t            .wrapping_sub(17i32.wrapping_mul(s(psamp, idx, 2)))\n355\t            .wrapping_add(10i32.wrapping_mul(s(psamp, idx, 3)))\n356\t            .wrapping_sub(7i32.wrapping_mul(s(psamp, idx, 4)))\n357\t            .wrapping_add(5i32.wrapping_mul(s(psamp, idx, 5)))\n358\t            .wrapping_sub(4i32.wrapping_mul(s(psamp, idx, 6)))\n359\t            .wrapping_add(4i32.wrapping_mul(s(psamp, idx, 7)))\n360\t            .wrapping_sub(3i32.wrapping_mul(s(psamp, idx, 8))))\n361\t            .wrapping_div(64)\n362\t    }\n363\t}\n364\t\n365\t/// NOTE: the C source shifts by 3 here, while `case 10` of\n366\t/// `BTAC1C2_PredictSample` shifts by 4.  Reproduced verbatim.\n367\t#[inline(never)]\n368\tunsafe extern \"C\" fn BTAC1C2_PredictSample_Pfn10(\n369\t    psamp: *mut c_int,\n370\t    idx: c_int,\n371\t    _pfcn: c_int,\n372\t    _ridx: *mut btac1c_idxstate,\n373\t) -> c_int {\n374\t    unsafe {\n375\t        let p0 = s(psamp, idx, 1)\n376\t            .wrapping_add(s(psamp, idx, 2))\n377\t            .wrapping_add(s(psamp, idx, 3))\n378\t            .wrapping_add(s(psamp, idx, 4));\n379\t        let p1 = s(psamp, idx, 5)\n380\t            .wrapping_add(s(psamp, idx, 6))\n381\t            .wrapping_add(s(psamp, idx, 7))\n382\t            .wrapping_add(s(psamp, idx, 8));\n383\t        (5i32.wrapping_mul(p0).wrapping_sub(p1)) >> 3\n384\t    }\n385\t}\n386\t\n387\t/// NOTE: the C source shifts by 1 here, while `case 11` of\n388\t/// `BTAC1C2_PredictSample` shifts by 3.  Reproduced verbatim.\n389\t#[inline(never)]\n390\tunsafe extern \"C\" fn BTAC1C2_PredictSample_Pfn11(\n391\t    psamp: *mut c_int,\n392\t    idx: c_int,\n393\t    _pfcn: c_int,\n394\t    _ridx: *mut btac1c_idxstate,\n395\t) -> c_int {\n396\t    unsafe {\n397\t        let p0 = s(psamp, idx, 1)\n398\t            .wrapping_add(s(psamp, idx, 2))\n399\t            .wrapping_add(s(psamp, idx, 3))\n400\t            .wrapping_add(s(psamp, idx, 4));\n401\t        let p1 = s(psamp, idx, 5)\n402\t            .wrapping_add(s(psamp, idx, 6))\n403\t            .wrapping_add(s(psamp, idx, 7))\n404\t            .wrapping_add(s(psamp, idx, 8));\n405\t        (p0.wrapping_add(p1)) >> 1\n406\t    }\n407\t}\n408\t\n409\t// ---------------------------------------------------------------------------\n410\t// static void *BTAC1C2_GetPredictFunc(int pfcn)\n411\t// ---------------------------------------------------------------------------\n412\t\n413\t#[inline(never)]\n414\tfn BTAC1C2_GetPredictFunc(pfcn: c_int) -> *const () {\n415\t    let fcn: PredictFn = match pfcn {\n416\t        0 => BTAC1C2_PredictSample_Pfn0,\n417\t        1 => BTAC1C2_PredictSample_Pfn1,\n418\t        2 => BTAC1C2_PredictSample_Pfn2,\n419\t        3 => BTAC1C2_PredictSample_Pfn3,\n420\t        4 => BTAC1C2_PredictSample_Pfn4,\n421\t        5 => BTAC1C2_PredictSample_Pfn5,\n422\t        6 => BTAC1C2_PredictSample_Pfn6,\n423\t        7 => BTAC1C2_PredictSample_Pfn7,\n424\t        8 => BTAC1C2_PredictSample_Pfn8,\n425\t        9 => BTAC1C2_PredictSample_Pfn9,\n426\t        10 => BTAC1C2_PredictSample_Pfn10,\n427\t        11 => BTAC1C2_PredictSample_Pfn11,\n428\t        _ => BTAC1C2_PredictSample,\n429\t    };\n430\t    fcn as *const ()\n431\t}\n432\t\n433\t// ---------------------------------------------------------------------------\n434\t// int get_predict_func(int pfcn)   <-- the library's only exported symbol\n435\t// ---------------------------------------------------------------------------\n436\t\n437\t/// `int get_predict_func(int pfcn);` from `include/lib.h`.\n438\t///\n439\t/// Returns 1 when `BTAC1C2_GetPredictFunc(pfcn)` hands back exactly the\n440\t/// specialised predictor that corresponds to `pfcn`, and 0 otherwise (which\n441\t/// includes every `pfcn` outside `0..=11`, where the `default:` arm leaves\n442\t/// `result` at its initial value of 0).\n443\t#[unsafe(no_mangle)]\n444\tpub extern \"C\" fn get_predict_func(pfcn: c_int) -> c_int {\n445\t    let mut result: c_int = 0;\n446\t    let fcn: *const () = BTAC1C2_GetPredictFunc(pfcn);\n447\t\n448\t    match pfcn {\n449\t        0 => result = (fcn == BTAC1C2_PredictSample_Pfn0 as *const ()) as c_int,\n450\t        1 => result = (fcn == BTAC1C2_PredictSample_Pfn1 as *const ()) as c_int,\n451\t        2 => result = (fcn == BTAC1C2_PredictSample_Pfn2 as *const ()) as c_int,\n452\t        3 => result = (fcn == BTAC1C2_PredictSample_Pfn3 as *const ()) as c_int,\n453\t        4 => result = (fcn == BTAC1C2_PredictSample_Pfn4 as *const ()) as c_int,\n454\t        5 => result = (fcn == BTAC1C2_PredictSample_Pfn5 as *const ()) as c_int,\n455\t        6 => result = (fcn == BTAC1C2_PredictSample_Pfn6 as *const ()) as c_int,\n456\t        7 => result = (fcn == BTAC1C2_PredictSample_Pfn7 as *const ()) as c_int,\n457\t        8 => result = (fcn == BTAC1C2_PredictSample_Pfn8 as *const ()) as c_int,\n458\t        9 => result = (fcn == BTAC1C2_PredictSample_Pfn9 as *const ()) as c_int,\n459\t        10 => result = (fcn == BTAC1C2_PredictSample_Pfn10 as *const ()) as c_int,\n460\t        11 => result = (fcn == BTAC1C2_PredictSample_Pfn11 as *const ()) as c_int,\n461\t        _ => {}\n462\t    }\n463\t\n464\t    result\n465\t}\n466\t\n467\t// ---------------------------------------------------------------------------\n468\t// Verification-only hook.  Not part of the library's ABI: it is compiled only\n469\t// when the `difftest` feature is enabled, which the default build never does,\n470\t// so the shipped cdylib exports `get_predict_func` and nothing else.  It exists\n471\t// so the internal predictors -- unreachable through the public ABI -- can be\n472\t// differentially tested against the original C translation unit.\n473\t// ---------------------------------------------------------------------------\n474\t#[cfg(feature = \"difftest\")]\n475\t#[unsafe(no_mangle)]\n476\tpub unsafe extern \"C\" fn __difftest_predict(\n477\t    which: c_int,\n478\t    psamp: *mut c_int,\n479\t    idx: c_int,\n480\t    pfcn: c_int,\n481\t    ridx: *mut btac1c_idxstate,\n482\t) -> c_int {\n483\t    let f: PredictFn = match which {\n484\t        0 => BTAC1C2_PredictSample_Pfn0,\n485\t        1 => BTAC1C2_PredictSample_Pfn1,\n486\t        2 => BTAC1C2_PredictSample_Pfn2,\n487\t        3 => BTAC1C2_PredictSample_Pfn3,\n488\t        4 => BTAC1C2_PredictSample_Pfn4,\n489\t        5 => BTAC1C2_PredictSample_Pfn5,\n490\t        6 => BTAC1C2_PredictSample_Pfn6,\n491\t        7 => BTAC1C2_PredictSample_Pfn7,\n492\t        8 => BTAC1C2_PredictSample_Pfn8,\n493\t        9 => BTAC1C2_PredictSample_Pfn9,\n494\t        10 => BTAC1C2_PredictSample_Pfn10,\n495\t        11 => BTAC1C2_PredictSample_Pfn11,\n496\t        _ => BTAC1C2_PredictSample,\n497\t    };\n498\t    unsafe { f(psamp, idx, pfcn, ridx) }\n499\t}\n500\t"}]},"parent_tool_use_id":null,"session_id":"9cc3d074-7e08-4b72-9c53-7efe80847659","uuid":"9e444daa-0ace-4151-93a7-adda1d795fbd","timestamp":"2026-08-27T08:58:31.471Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-M3fAKX/translation/src/lib.rs","content":"//! Rust translation of `c_src/src/lib.c`.\n//!\n//! The C translation unit compiles to a shared library that exports exactly one\n//! public symbol, `get_predict_func` (declared in `c_src/include/lib.h`).  Every\n//! other function in the translation unit is `static`, i.e. internal linkage, so\n//! it is reproduced here as a private Rust function.  The internal functions are\n//! nevertheless translated faithfully because `get_predict_func`'s result is\n//! derived from comparing their addresses.\n//!\n//! All arithmetic below is translated verbatim, including the quirks of the\n//! original code (for example `Pfn10`/`Pfn11` use different shift amounts than\n//! the corresponding `case 10`/`case 11` arms of `BTAC1C2_PredictSample`).  Such\n//! discrepancies are *not* fixed: they are reproduced exactly.\n\n#![allow(non_camel_case_types)]\n#![allow(non_snake_case)]\n#![allow(clippy::missing_safety_doc)]\n\nuse core::ffi::c_int;\n\n// ---------------------------------------------------------------------------\n// typedefs / struct layout from lib.c\n// ---------------------------------------------------------------------------\n\n/// `typedef unsigned short btac1c_u16;`\npub type btac1c_u16 = u16;\n/// `typedef signed short btac1c_s16;`\npub type btac1c_s16 = i16;\n/// `typedef unsigned char btac1c_byte;`\npub type btac1c_byte = u8;\n\n/// ```c\n/// struct btac1c_idxstate_s {\n///     btac1c_u16  idx;\n///     btac1c_s16  lpred;\n///     btac1c_s16  rpred;\n///     btac1c_byte tag;\n///     btac1c_byte bcfcn;\n///     btac1c_byte bsfcn;\n///     btac1c_byte usefx;\n///     btac1c_s16  firfx[4][8];\n/// };\n/// ```\n#[repr(C)]\npub struct btac1c_idxstate {\n    pub idx: btac1c_u16,\n    pub lpred: btac1c_s16,\n    pub rpred: btac1c_s16,\n    pub tag: btac1c_byte,\n    pub bcfcn: btac1c_byte,\n    pub bsfcn: btac1c_byte,\n    pub usefx: btac1c_byte,\n    pub firfx: [[btac1c_s16; 8]; 4],\n}\n\n/// The common signature shared by `BTAC1C2_PredictSample` and every\n/// `BTAC1C2_PredictSample_PfnN` helper:\n/// `int f(int *psamp, int idx, int pfcn, btac1c_idxstate *ridx)`.\ntype PredictFn =\n    unsafe extern \"C\" fn(*mut c_int, c_int, c_int, *mut btac1c_idxstate) -> c_int;\n\n// ---------------------------------------------------------------------------\n// helpers\n// ---------------------------------------------------------------------------\n\n/// `psamp[(i - k) & 7]` — the C code masks a possibly-negative index with 7,\n/// which on two's-complement hardware always yields a value in `0..=7`.\n#[inline(always)]\nunsafe fn s(psamp: *const c_int, i: c_int, k: c_int) -> c_int {\n    let off = (i.wrapping_sub(k)) & 7;\n    unsafe { *psamp.offset(off as isize) }\n}\n\n// ---------------------------------------------------------------------------\n// static int BTAC1C2_PredictSample(int *psamp, int idx, int pfcn,\n//                                  btac1c_idxstate *ridx)\n// ---------------------------------------------------------------------------\n\n#[inline(never)]\nunsafe extern \"C\" fn BTAC1C2_PredictSample(\n    psamp: *mut c_int,\n    idx: c_int,\n    pfcn: c_int,\n    ridx: *mut btac1c_idxstate,\n) -> c_int {\n    let pred: c_int;\n    let p0: c_int;\n    let p1: c_int;\n    let i: c_int = idx;\n\n    unsafe {\n        match pfcn {\n            0 => {\n                pred = s(psamp, i, 1);\n            }\n            1 => {\n                pred = 2i32\n                    .wrapping_mul(s(psamp, i, 1))\n                    .wrapping_sub(s(psamp, i, 2));\n            }\n            2 => {\n                pred = (3i32\n                    .wrapping_mul(s(psamp, i, 1))\n                    .wrapping_sub(s(psamp, i, 2)))\n                    >> 1;\n            }\n            3 => {\n                pred = (5i32\n                    .wrapping_mul(s(psamp, i, 1))\n                    .wrapping_sub(s(psamp, i, 2)))\n                    >> 2;\n            }\n            4 => {\n                p0 = s(psamp, i, 1).wrapping_add(s(psamp, i, 2));\n                p1 = s(psamp, i, 2).wrapping_add(s(psamp, i, 3));\n                pred = p0.wrapping_sub(p1 >> 1);\n            }\n            5 => {\n                p0 = s(psamp, i, 1).wrapping_add(s(psamp, i, 2));\n                p1 = s(psamp, i, 2).wrapping_add(s(psamp, i, 3));\n                pred = (3i32.wrapping_mul(p0).wrapping_sub(p1)) >> 2;\n            }\n            6 => {\n                p0 = s(psamp, i, 1).wrapping_add(s(psamp, i, 2));\n                p1 = s(psamp, i, 2).wrapping_add(s(psamp, i, 3));\n                pred = (5i32.wrapping_mul(p0).wrapping_sub(p1)) >> 3;\n            }\n            7 => {\n                pred = (18i32\n                    .wrapping_mul(s(psamp, i, 1))\n                    .wrapping_sub(4i32.wrapping_mul(s(psamp, i, 2)))\n                    .wrapping_add(3i32.wrapping_mul(s(psamp, i, 3)))\n                    .wrapping_sub(2i32.wrapping_mul(s(psamp, i, 4)))\n                    .wrapping_add(1i32.wrapping_mul(s(psamp, i, 5))))\n                    .wrapping_div(16);\n            }\n            8 => {\n                pred = (72i32\n                    .wrapping_mul(s(psamp, i, 1))\n                    .wrapping_sub(16i32.wrapping_mul(s(psamp, i, 2)))\n                    .wrapping_add(12i32.wrapping_mul(s(psamp, i, 3)))\n                    .wrapping_sub(8i32.wrapping_mul(s(psamp, i, 4)))\n                    .wrapping_add(5i32.wrapping_mul(s(psamp, i, 5)))\n                    .wrapping_sub(3i32.wrapping_mul(s(psamp, i, 6)))\n                    .wrapping_add(3i32.wrapping_mul(s(psamp, i, 7)))\n                    .wrapping_sub(1i32.wrapping_mul(s(psamp, i, 8))))\n                    .wrapping_div(64);\n            }\n            9 => {\n                pred = (76i32\n                    .wrapping_mul(s(psamp, i, 1))\n                    .wrapping_sub(17i32.wrapping_mul(s(psamp, i, 2)))\n                    .wrapping_add(10i32.wrapping_mul(s(psamp, i, 3)))\n                    .wrapping_sub(7i32.wrapping_mul(s(psamp, i, 4)))\n                    .wrapping_add(5i32.wrapping_mul(s(psamp, i, 5)))\n                    .wrapping_sub(4i32.wrapping_mul(s(psamp, i, 6)))\n                    .wrapping_add(4i32.wrapping_mul(s(psamp, i, 7)))\n                    .wrapping_sub(3i32.wrapping_mul(s(psamp, i, 8))))\n                    .wrapping_div(64);\n            }\n            10 => {\n                p0 = s(psamp, i, 1)\n                    .wrapping_add(s(psamp, i, 2))\n                    .wrapping_add(s(psamp, i, 3))\n                    .wrapping_add(s(psamp, i, 4));\n                p1 = s(psamp, i, 5)\n                    .wrapping_add(s(psamp, i, 6))\n                    .wrapping_add(s(psamp, i, 7))\n                    .wrapping_add(s(psamp, i, 8));\n                pred = (5i32.wrapping_mul(p0).wrapping_sub(p1)) >> 4;\n            }\n            11 => {\n                p0 = s(psamp, i, 1)\n                    .wrapping_add(s(psamp, i, 2))\n                    .wrapping_add(s(psamp, i, 3))\n                    .wrapping_add(s(psamp, i, 4));\n                p1 = s(psamp, i, 5)\n                    .wrapping_add(s(psamp, i, 6))\n                    .wrapping_add(s(psamp, i, 7))\n                    .wrapping_add(s(psamp, i, 8));\n                pred = (p0.wrapping_add(p1)) >> 3;\n            }\n            12 | 13 | 14 | 15 => {\n                let row = &(*ridx).firfx[(pfcn - 12) as usize];\n                let mut acc: c_int = (row[0] as c_int).wrapping_mul(s(psamp, i, 1));\n                acc = acc.wrapping_add((row[1] as c_int).wrapping_mul(s(psamp, i, 2)));\n                acc = acc.wrapping_add((row[2] as c_int).wrapping_mul(s(psamp, i, 3)));\n                acc = acc.wrapping_add((row[3] as c_int).wrapping_mul(s(psamp, i, 4)));\n                acc = acc.wrapping_add((row[4] as c_int).wrapping_mul(s(psamp, i, 5)));\n                acc = acc.wrapping_add((row[5] as c_int).wrapping_mul(s(psamp, i, 6)));\n                acc = acc.wrapping_add((row[6] as c_int).wrapping_mul(s(psamp, i, 7)));\n                acc = acc.wrapping_add((row[7] as c_int).wrapping_mul(s(psamp, i, 8)));\n                pred = acc.wrapping_div(256);\n            }\n            _ => {\n                pred = 0;\n            }\n        }\n    }\n\n    pred\n}\n\n// ---------------------------------------------------------------------------\n// The twelve specialised predictors.  Each keeps the four-parameter C signature\n// even though `pfcn` and `ridx` go unused, because the address of each one is\n// stored into a `void *` of that shape.\n// -------