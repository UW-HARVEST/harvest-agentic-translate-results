463325252ULL;\nstatic unsigned long long xr(void) {\n  rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17; return rs;\n}\nstatic unsigned rnd(unsigned n) { return (unsigned)(xr() % n); }\n\ntypedef struct { int key, value; } ie;\ntypedef struct { char *key; long value; } se;\n\nstatic hdr *raw_of(void *hp, size_t es) { return (hdr*)(((char*)hp) - es) - 1; }\nstatic ptrdiff_t tempof(void *hp, size_t es) { return raw_of(hp, es)->temp; }\n\nstatic unsigned long long fold(const void *p, size_t n, unsigned long long h) {\n  const unsigned char *b = p;\n  for (size_t i = 0; i < n; i++) { h ^= b[i]; h *= 1099511628211ULL; }\n  return h;\n}\n\nstatic unsigned long long map_sig(void *hp, size_t es) {\n  hdr *h = raw_of(hp, es);\n  hindex *t = (hindex*)h->hash_table;\n  unsigned long long s = 1469598103934665603ULL;\n  s = fold(&h->length, sizeof h->length, s);\n  s = fold(&h->capacity, sizeof h->capacity, s);\n  s = fold(&h->temp, sizeof h->temp, s);\n  if (t) {\n    s = fold(&t->slot_count, sizeof t->slot_count, s);\n    s = fold(&t->used_count, sizeof t->used_count, s);\n    s = fold(&t->tombstone_count, sizeof t->tombstone_count, s);\n    s = fold(&t->seed, sizeof t->seed, s);\n    s = fold(&t->string.mode, 1, s);\n    s = fold(&t->string.block, 1, s);\n    s = fold(&t->string.remaining, sizeof t->string.remaining, s);\n    /* full bucket table contents: hashes and indices */\n    s = fold(t->storage, (t->slot_count >> 3) * (8 * sizeof(size_t) + 8 * sizeof(ptrdiff_t)), s);\n  }\n  return s;\n}\n\nstatic void fuzz_intmap(int iters, int keyspace) {\n  printf(\"-- fuzz intmap iters=%d ks=%d --\\n\", iters, keyspace);\n  ie *m = NULL;\n  for (int i = 0; i < iters; i++) {\n    unsigned op = rnd(10);\n    int k = (int)rnd(keyspace) - (int)(keyspace / 2);\n    if (op < 5) {\n      m = p_hmput_key(m, sizeof(ie), &k, sizeof(int), 0);\n      ptrdiff_t t = tempof(m, sizeof(ie));\n      m[t].key = k; m[t].value = i;\n      printf(\"put %d t=%td\\n\", k, t);\n    } else if (op < 7) {\n      m = p_hmget_key(m, sizeof(ie), &k, sizeof(int), 0);\n      ptrdiff_t t = tempof(m, sizeof(ie));\n      printf(\"get %d t=%td v=%d\\n\", k, t, m[t].value);\n    } else if (op < 8) {\n      ptrdiff_t t = -7;\n      m = p_hmget_key_ts(m, sizeof(ie), &k, sizeof(int), &t, 0);\n      printf(\"gts %d t=%td\\n\", k, t);\n    } else if (op < 9) {\n      m = p_hmdel_key(m, sizeof(ie), &k, sizeof(int), offsetof(ie, key), 0);\n      printf(\"del %d t=%td\\n\", k, m ? tempof(m, sizeof(ie)) : -999);\n    } else {\n      m = p_hmput_default(m, sizeof(ie));\n      m[-1].value = i;\n      printf(\"dfl %d\\n\", i);\n    }\n    if (m) {\n      printf(\"   sig=%llx len=%zu\\n\", map_sig(m, sizeof(ie)), raw_of(m, sizeof(ie))->length);\n      ie *base = (ie*)((char*)m - sizeof(ie));\n      unsigned long long es = 1469598103934665603ULL;\n      for (size_t j = 0; j < raw_of(m, sizeof(ie))->length; j++) {\n        es = fold(&base[j].key, sizeof(int), es);\n        es = fold(&base[j].value, sizeof(int), es);\n      }\n      printf(\"   elems=%llx\\n\", es);\n    }\n  }\n  if (m) p_hmfree_func((char*)m - sizeof(ie), sizeof(ie));\n}\n\nstatic char *mkkey(unsigned n) {\n  static char b[128];\n  unsigned len = 1 + n % 40;\n  for (unsigned i = 0; i < len; i++) b[i] = (char)('A' + ((n * 31 + i * 7) % 60));\n  b[len] = 0;\n  return b;\n}\n\nstatic void fuzz_strmap(int mode, int iters, int keyspace) {\n  printf(\"-- fuzz strmap mode=%d iters=%d ks=%d --\\n\", mode, iters, keyspace);\n  se *m = NULL;\n  if (mode > 1) m = p_shmode_func(sizeof(se), mode);\n  char *held[4096];\n  int nheld = 0;\n  for (int i = 0; i < iters; i++) {\n    unsigned op = rnd(10);\n    unsigned kn = rnd(keyspace);\n    char *k = mkkey(kn);\n    if (op < 5) {\n      char *kk = (mode == 1) ? strdup(k) : k;   /* default mode borrows the key */\n      if (mode == 1) held[nheld++] = kk;\n      m = p_hmput_key(m, sizeof(se), kk, sizeof(char*), 1);\n      ptrdiff_t t = tempof(m, sizeof(se));\n      m[t].value = i;\n      printf(\"sput %u t=%td key=\\\"%s\\\"\\n\", kn, t, m[t].key);\n    } else if (op < 7) {\n      m = p_hmget_key(m, sizeof(se), k, sizeof(char*), 1);\n      ptrdiff_t t = tempof(m, sizeof(se));\n      printf(\"sget %u t=%td v=%ld\\n\", kn, t, m[t].value);\n    } else if (op < 9) {\n      m = p_hmdel_key(m, sizeof(se), k, sizeof(char*), offsetof(se, key), 1);\n      printf(\"sdel %u t=%td\\n\", kn, m ? tempof(m, sizeof(se)) : -999);\n    } else {\n      ptrdiff_t t = -7;\n      m = p_hmget_key_ts(m, sizeof(se), k, sizeof(char*), &t, 1);\n      printf(\"sgts %u t=%td\\n\", kn, t);\n    }\n    if (m) {\n      printf(\"   sig=%llx len=%zu\\n\", map_sig(m, sizeof(se)), raw_of(m, sizeof(se))->length);\n      se *base = (se*)((char*)m - sizeof(se));\n      unsigned long long es = 1469598103934665603ULL;\n      for (size_t j = 1; j < raw_of(m, sizeof(se))->length; j++) {\n        es = fold(base[j].key, strlen(base[j].key) + 1, es);\n        es = fold(&base[j].value, sizeof(long), es);\n      }\n      printf(\"   elems=%llx\\n\", es);\n    }\n  }\n  if (m) p_hmfree_func((char*)m - sizeof(se), sizeof(se));\n  for (int i = 0; i < nheld; i++) free(held[i]);\n}\n\nstatic void fuzz_hash(int iters) {\n  printf(\"-- fuzz hash iters=%d --\\n\", iters);\n  unsigned char buf[128];\n  for (int i = 0; i < iters; i++) {\n    size_t len = rnd(100);\n    for (size_t j = 0; j < len; j++) buf[j] = (unsigned char)rnd(256);\n    size_t seed = (size_t)xr();\n    printf(\"hb %zu %zx -> %zx\\n\", len, seed, p_hash_bytes(buf, len, seed));\n    /* NUL-terminated variant for hash_string */\n    for (size_t j = 0; j < len; j++) if (!buf[j]) buf[j] = 1;\n    buf[len] = 0;\n    printf(\"hs %zu %zx -> %zx\\n\", len, seed, p_hash_string((char*)buf, seed));\n  }\n}\n\nstatic void fuzz_arena(int iters) {\n  printf(\"-- fuzz arena iters=%d --\\n\", iters);\n  arena a;\n  memset(&a, 0, sizeof a);\n  char tmp[8192];\n  for (int i = 0; i < iters; i++) {\n    size_t len = 1 + rnd(3000);\n    for (size_t j = 0; j < len; j++) tmp[j] = (char)('a' + rnd(26));\n    tmp[len] = 0;\n    char *p = p_stralloc(&a, tmp);\n    printf(\"sa len=%zu ok=%d rem=%zu blk=%u off=%td\\n\", len, strcmp(p, tmp) == 0,\n           a.remaining, a.block, (ptrdiff_t)(p - (char*)a.storage));\n    if (rnd(20) == 0) {\n      p_strreset(&a);\n      printf(\"sa reset st=%d rem=%zu blk=%u mode=%u\\n\", a.storage == NULL, a.remaining,\n             a.block, a.mode);\n    }\n  }\n  p_strreset(&a);\n}\n\nstatic void fuzz_arr(int iters) {\n  printf(\"-- fuzz arr iters=%d --\\n\", iters);\n  void *a = NULL;\n  size_t elemsize[] = {1, 2, 3, 4, 8, 12, 16, 40};\n  for (int i = 0; i < iters; i++) {\n    size_t es = elemsize[rnd(8)];\n    a = NULL;\n    for (int j = 0; j < 30; j++) {\n      size_t addlen = rnd(5), mincap = rnd(50);\n      a = p_arrgrowf(a, es, addlen, mincap);\n      if (!a) { printf(\"arr es=%zu add=%zu min=%zu -> NULL\\n\", es, addlen, mincap); continue; }\n      printf(\"arr es=%zu add=%zu min=%zu len=%zu cap=%zu\\n\", es, addlen, mincap,\n             ((hdr*)a - 1)->length, ((hdr*)a - 1)->capacity);\n      ((hdr*)a - 1)->length += addlen;\n    }\n    if (a) p_arrfreef(a);\n  }\n}\n\n#define LOAD(v, n) do { *(void**)&v = dlsym(h, n); \\\n  if (!v) { fprintf(stderr, \"missing %s\\n\", n); exit(2); } } while (0)\n\nint main(int argc, char **argv) {\n  void *h = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n  if (!h) { fprintf(stderr, \"dlopen: %s\\n\", dlerror()); return 1; }\n  LOAD(p_arrgrowf, \"stbds_arrgrowf\");\n  LOAD(p_arrfreef, \"stbds_arrfreef\");\n  LOAD(p_rand_seed, \"stbds_rand_seed\");\n  LOAD(p_hash_bytes, \"stbds_hash_bytes\");\n  LOAD(p_hash_string, \"stbds_hash_string\");\n  LOAD(p_hmfree_func, \"stbds_hmfree_func\");\n  LOAD(p_hmget_key, \"stbds_hmget_key\");\n  LOAD(p_hmget_key_ts, \"stbds_hmget_key_ts\");\n  LOAD(p_hmput_default, \"stbds_hmput_default\");\n  LOAD(p_hmput_key, \"stbds_hmput_key\");\n  LOAD(p_hmdel_key, \"stbds_hmdel_key\");\n  LOAD(p_shmode_func, \"stbds_shmode_func\");\n  LOAD(p_stralloc, \"stbds_stralloc\");\n  LOAD(p_strreset, \"stbds_strreset\");\n  LOAD(p_strkey, \"strkey\");\n  if (argc > 2) rs = strtoull(argv[2], 0, 0);\n\n  fuzz_hash(400);\n  fuzz_arr(20);\n  fuzz_arena(300);\n  fuzz_intmap(1500, 8);\n  fuzz_intmap(1500, 64);\n  fuzz_intmap(2000, 5000);\n  p_rand_seed(12345);\n  fuzz_intmap(1500, 40);\n  fuzz_strmap(1, 800, 30);\n  fuzz_strmap(2, 800, 30);\n  fuzz_strmap(3, 800, 30);\n  fuzz_strmap(2, 1200, 400);\n  fuzz_strmap(3, 1200, 400);\n  fuzz_strmap(1, 1200, 400);\n  printf(\"FUZZDONE\\n\");\n  return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
