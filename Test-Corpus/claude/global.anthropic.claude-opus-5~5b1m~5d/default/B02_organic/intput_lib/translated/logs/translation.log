{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_lh2atmascwqiquykdozrajjuwuearanz7urvvbfio7e4xitscrxa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_018QaBPxd9oKGtwMJNYKr1TM","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-J8K08Y/_cbuild/harness.c","content":"// Differential harness: dlopen a stb_ds-style .so and print a deterministic\n// trace of its behaviour + internal structure state.\n#define _GNU_SOURCE\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <limits.h>\n#include <dlfcn.h>\n\ntypedef struct { size_t length, capacity; void *hash_table; ptrdiff_t temp; } hdr;\ntypedef struct { void *storage; size_t remaining; unsigned char block, mode; } arena;\ntypedef struct {\n  char *temp_key;\n  size_t slot_count, used_count, used_count_threshold, used_count_shrink_threshold;\n  size_t tombstone_count, tombstone_count_threshold, seed, slot_count_log2;\n  arena string;\n  void *storage;\n} hindex;\n\n#define HDR(p) (((hdr*)(p)) - 1)\n\nstatic void *(*p_arrgrowf)(void*,size_t,size_t,size_t);\nstatic void  (*p_arrfreef)(void*);\nstatic void  (*p_rand_seed)(size_t);\nstatic size_t(*p_hash_bytes)(void*,size_t,size_t);\nstatic size_t(*p_hash_string)(char*,size_t);\nstatic void  (*p_hmfree_func)(void*,size_t);\nstatic void *(*p_hmget_key)(void*,size_t,void*,size_t,int);\nstatic void *(*p_hmget_key_ts)(void*,size_t,void*,size_t,ptrdiff_t*,int);\nstatic void *(*p_hmput_default)(void*,size_t);\nstatic void *(*p_hmput_key)(void*,size_t,void*,size_t,int);\nstatic void *(*p_hmdel_key)(void*,size_t,void*,size_t,size_t,int);\nstatic void *(*p_shmode_func)(size_t,int);\nstatic char *(*p_stralloc)(void*,char*);\nstatic void  (*p_strreset)(void*);\nstatic char *(*p_strkey)(int);\nstatic void  (*p_intput)(int);\n\ntypedef struct { int key, value; } ie;\ntypedef struct { char *key; int value; } se;\ntypedef struct { int key[2]; int b, c, d; } s2;\n\nstatic hdr *raw_of(void *hashptr, size_t elemsize) {\n  return (hdr*)(((char*)hashptr) - elemsize) - 1;\n}\n\nstatic void dump_table(void *hashptr, size_t elemsize, const char *tag) {\n  hdr *h = raw_of(hashptr, elemsize);\n  hindex *t = (hindex*)h->hash_table;\n  printf(\"%s len=%zu cap=%zu temp=%td\", tag, h->length, h->capacity, h->temp);\n  if (t)\n    printf(\" | slots=%zu used=%zu tomb=%zu uct=%zu ucst=%zu tct=%zu log2=%zu seed=%zx amode=%u ablock=%u arem=%zu\\n\",\n        t->slot_count, t->used_count, t->tombstone_count, t->used_count_threshold,\n        t->used_count_shrink_threshold, t->tombstone_count_threshold, t->slot_count_log2,\n        t->seed, t->string.mode, t->string.block, t->string.remaining);\n  else\n    printf(\" | table=NULL\\n\");\n}\n\n/* ---- macro emulation ---- */\nstatic ptrdiff_t tempof(void *hashptr, size_t elemsize) {\n  return raw_of(hashptr, elemsize)->temp;\n}\n\nstatic void test_hashing(void) {\n  printf(\"== hashing ==\\n\");\n  unsigned char buf[64];\n  for (int i = 0; i < 64; i++) buf[i] = (unsigned char)(i * 37 + 129); /* many >= 0x80 */\n  for (size_t len = 0; len <= 40; len++) {\n    for (size_t s = 0; s < 3; s++) {\n      size_t seed = (size_t)(s * 0x9e3779b97f4a7c15ULL + 1);\n      printf(\"hb len=%2zu seed=%zx -> %zx\\n\", len, seed, p_hash_bytes(buf, len, seed));\n    }\n  }\n  /* all-zero and 0x7f/0x80 boundary patterns */\n  unsigned char b2[16];\n  for (int pat = 0; pat < 4; pat++) {\n    static const unsigned char vals[4] = {0x00, 0x7f, 0x80, 0xff};\n    memset(b2, vals[pat], sizeof b2);\n    for (size_t len = 0; len <= 16; len++)\n      printf(\"hb pat=%02x len=%2zu -> %zx\\n\", vals[pat], len, p_hash_bytes(b2, len, 0x1234));\n  }\n  /* single high byte in each position */\n  for (int pos = 0; pos < 8; pos++) {\n    memset(b2, 0, sizeof b2);\n    b2[pos] = 0xff;\n    for (size_t len = 1; len <= 12; len++)\n      printf(\"hb pos=%d len=%2zu -> %zx\\n\", pos, len, p_hash_bytes(b2, len, 0xabcdef));\n  }\n  static char *strs[] = { \"\", \"a\", \"ab\", \"abc\", \"test_0\", \"test_123456\",\n                          \"\\x80\\xff\\x7f\", \"the quick brown fox jumps over the lazy dog\" };\n  for (unsigned i = 0; i < sizeof strs / sizeof *strs; i++)\n    for (size_t s = 0; s < 3; s++)\n      printf(\"hs \\\"%s\\\" seed=%zu -> %zx\\n\", strs[i], s, p_hash_string(strs[i], s * 7919));\n  /* int keys as bytes (what hmput uses) */\n  for (int k = -5; k <= 5; k++) {\n    int kk = k;\n    printf(\"hb int %d -> %zx\\n\", k, p_hash_bytes(&kk, sizeof kk, 0x31415926));\n  }\n}\n\nstatic void test_arrgrow(void) {\n  printf(\"== arrgrowf ==\\n\");\n  void *a = NULL;\n  for (int i = 0; i < 25; i++) {\n    a = p_arrgrowf(a, 4, 1, 0);\n    HDR(a)->length++;\n    printf(\"grow1 i=%d len=%zu cap=%zu temp=%td ht=%d\\n\", i, HDR(a)->length,\n           HDR(a)->capacity, HDR(a)->temp, HDR(a)->hash_table != NULL);\n  }\n  p_arrfreef(a);\n  a = NULL;\n  size_t ns[] = {0, 1, 3, 4, 5, 7, 8, 100, 101, 4095};\n  for (unsigned i = 0; i < sizeof ns / sizeof *ns; i++) {\n    a = p_arrgrowf(a, 8, ns[i], 0);\n    printf(\"growN n=%zu len=%zu cap=%zu\\n\", ns[i], HDR(a)->length, HDR(a)->capacity);\n    HDR(a)->length += ns[i];\n  }\n  p_arrfreef(a);\n  a = NULL;\n  for (unsigned i = 0; i < sizeof ns / sizeof *ns; i++) {\n    a = p_arrgrowf(a, 16, 0, ns[i]);\n    printf(\"growCap min=%zu len=%zu cap=%zu\\n\", ns[i], HDR(a)->length, HDR(a)->capacity);\n  }\n  p_arrfreef(a);\n}\n\nstatic void test_intmap(int nkeys, int seedmode) {\n  printf(\"== intmap n=%d sm=%d ==\\n\", nkeys, seedmode);\n  if (seedmode) p_rand_seed(0xdeadbeefU);\n  ie *m = NULL;\n  for (int i = 0; i < nkeys; i++) {\n    int k = (i * 7919) % 1000;\n    m = p_hmput_key(m, sizeof(ie), &k, sizeof(int), 0);\n    ptrdiff_t t = tempof(m, sizeof(ie));\n    m[t].key = k; m[t].value = i;\n    if (i % 8 == 0) dump_table(m, sizeof(ie), \"put\");\n  }\n  dump_table(m, sizeof(ie), \"after-puts\");\n  for (ptrdiff_t i = 0; i < (ptrdiff_t)raw_of(m, sizeof(ie))->length; i++)\n    printf(\"  elem[%td] key=%d val=%d\\n\", i, ((ie*)((char*)m - sizeof(ie)))[i].key,\n           ((ie*)((char*)m - sizeof(ie)))[i].value);\n  /* lookups (hit and miss) */\n  for (int k = -3; k < 1000; k += 37) {\n    int kk = k;\n    m = p_hmget_key(m, sizeof(ie), &kk, sizeof(int), 0);\n    ptrdiff_t t = tempof(m, sizeof(ie));\n    printf(\"  get %d -> t=%td val=%d\\n\", k, t, m[t].value);\n  }\n  /* _ts lookups */\n  for (int k = 0; k < 100; k += 13) {\n    int kk = k; ptrdiff_t t = -99;\n    m = p_hmget_key_ts(m, sizeof(ie), &kk, sizeof(int), &t, 0);\n    printf(\"  get_ts %d -> t=%td\\n\", k, t);\n  }\n  /* deletions */\n  for (int i = 0; i < nkeys; i += 3) {\n    int k = (i * 7919) % 1000;\n    m = p_hmdel_key(m, sizeof(ie), &k, sizeof(int), offsetof(ie, key), 0);\n    printf(\"  del %d -> temp=%td len=%zu\\n\", k, tempof(m, sizeof(ie)),\n           raw_of(m, sizeof(ie))->length);\n    if (i % 9 == 0) dump_table(m, sizeof(ie), \"  after-del\");\n  }\n  dump_table(m, sizeof(ie), \"after-dels\");\n  for (ptrdiff_t i = 0; i < (ptrdiff_t)raw_of(m, sizeof(ie))->length; i++)\n    printf(\"  elem2[%td] key=%d val=%d\\n\", i, ((ie*)((char*)m - sizeof(ie)))[i].key,\n           ((ie*)((char*)m - sizeof(ie)))[i].value);\n  /* delete missing keys */\n  for (int k = 1001; k < 1010; k++) {\n    m = p_hmdel_key(m, sizeof(ie), &k, sizeof(int), offsetof(ie, key), 0);\n    printf(\"  delmiss %d -> temp=%td len=%zu\\n\", k, tempof(m, sizeof(ie)),\n           raw_of(m, sizeof(ie))->length);\n  }\n  /* re-insert to exercise tombstones */\n  for (int i = 0; i < nkeys; i += 3) {\n    int k = (i * 7919) % 1000;\n    m = p_hmput_key(m, sizeof(ie), &k, sizeof(int), 0);\n    ptrdiff_t t = tempof(m, sizeof(ie));\n    m[t].key = k; m[t].value = 1000 + i;\n  }\n  dump_table(m, sizeof(ie), \"after-reinsert\");\n  for (ptrdiff_t i = 0; i < (ptrdiff_t)raw_of(m, sizeof(ie))->length; i++)\n    printf(\"  elem3[%td] key=%d val=%d\\n\", i, ((ie*)((char*)m - sizeof(ie)))[i].key,\n           ((ie*)((char*)m - sizeof(ie)))[i].value);\n  p_hmfree_func((char*)m - sizeof(ie), sizeof(ie));\n}\n\nstatic void test_hmdel_null_and_default(void) {\n  printf(\"== misc ==\\n\");\n  int k = 5;\n  void *r = p_hmdel_key(NULL, sizeof(ie), &k, sizeof(int), offsetof(ie, key), 0);\n  printf(\"hmdel(NULL) -> %d\\n\", r == NULL);\n  ie *m = NULL;\n  m = p_hmput_default(m, sizeof(ie));\n  dump_table(m, sizeof(ie), \"hmput_default\");\n  m[-1].value = 42;\n  printf(\"default value %d key %d\\n\", m[-1].value, m[-1].key);\n  m = p_hmput_default(m, sizeof(ie));\n  dump_table(m, sizeof(ie), \"hmput_default2\");\n  int kk = 3;\n  m = p_hmget_key(m, sizeof(ie), &kk, sizeof(int), 0);\n  printf(\"miss default -> t=%td val=%d\\n\", tempof(m, sizeof(ie)), m[tempof(m,sizeof(ie))].value);\n  m = p_hmput_key(m, sizeof(ie), &kk, sizeof(int), 0);\n  ptrdiff_t t = tempof(m, sizeof(ie));\n  m[t].key = kk; m[t].value = 77;\n  dump_table(m, sizeof(ie), \"after put on default\");\n  kk = 3;\n  m = p_hmget_key(m, sizeof(ie), &kk, sizeof(int), 0);\n  printf(\"hit -> t=%td val=%d\\n\", tempof(m, sizeof(ie)), m[tempof(m,sizeof(ie))].value);\n  p_hmfree_func((char*)m - sizeof(ie), sizeof(ie));\n\n  /* get on empty map */\n  ie *e = NULL;\n  int z = 1;\n  ptrdiff_t tt = -55;\n  e = p_hmget_key_ts(e, sizeof(ie), &z, sizeof(int), &tt, 0);\n  printf(\"get_ts on NULL -> t=%td len=%zu cap=%zu\\n\", tt, raw_of(e,sizeof(ie))->length,\n         raw_of(e,sizeof(ie))->capacity);\n  p_hmfree_func((char*)e - sizeof(ie), sizeof(ie));\n\n  /* 2-int key struct (larger keysize, binary mode) */\n  s2 *m2 = NULL;\n  for (int i = 0; i < 40; i++) {\n    int key[2] = { i % 7, i % 5 };\n    m2 = p_hmput_key(m2, sizeof(s2), key, sizeof key, 0);\n    ptrdiff_t q = tempof(m2, sizeof(s2));\n    m2[q].key[0] = key[0]; m2[q].key[1] = key[1]; m2[q].b = i;\n  }\n  dump_table(m2, sizeof(s2), \"s2\");\n  for (ptrdiff_t i = 0; i < (ptrdiff_t)raw_of(m2, sizeof(s2))->length; i++) {\n    s2 *base = (s2*)((char*)m2 - sizeof(s2));\n    printf(\"  s2[%td] k={%d,%d} b=%d\\n\", i, base[i].key[0], base[i].key[1], base[i].b);\n  }\n  p_hmfree_func((char*)m2 - sizeof(s2), sizeof(s2));\n}\n\nstatic char *keystr(int n) { static char b[64]; sprintf(b, \"key_%d_%*s\", n, n % 17, \"\"); return b; }\n\nstatic void test_strmap(int mode, int nkeys) {\n  printf(\"== strmap mode=%d n=%d ==\\n\", mode, nkeys);\n  se *m = NULL;\n  if (mode > 1) m = p_shmode_func(sizeof(se), mode); /* 2=strdup 3=arena */\n  if (m) dump_table(m, sizeof(se), \"shmode\");\n  char *owned[512];\n  for (int i = 0; i < nkeys; i++) {\n    char *k = strdup(keystr(i * 13 % nkeys));\n    owned[i] = k;\n    m = p_hmput_key(m, sizeof(se), k, sizeof(char*), 1);\n    ptrdiff_t t = tempof(m, sizeof(se));\n    m[t].value = i;\n    if (i % 10 == 0) dump_table(m, sizeof(se), \"sput\");\n  }\n  dump_table(m, sizeof(se), \"after-sputs\");\n  se *base = (se*)((char*)m - sizeof(se));\n  for (ptrdiff_t i = 1; i < (ptrdiff_t)raw_of(m, sizeof(se))->length; i++) {\n    int is_borrowed = 0;\n    for (int j = 0; j < nkeys; j++) if (base[i].key == owned[j]) is_borrowed = 1;\n    printf(\"  s[%td] key=\\\"%s\\\" val=%d borrowed=%d\\n\", i, base[i].key, base[i].value, is_borrowed);\n  }\n  for (int i = 0; i < nkeys; i++) {\n    m = p_hmget_key(m, sizeof(se), keystr(i), sizeof(char*), 1);\n    ptrdiff_t t = tempof(m, sizeof(se));\n    printf(\"  sget \\\"%s\\\" -> t=%td val=%d\\n\", keystr(i), t, m[t].value);\n  }\n  for (int i = 0; i < nkeys; i += 2) {\n    m = p_hmdel_key(m, sizeof(se), keystr(i), sizeof(char*), offsetof(se, key), 1);\n    printf(\"  sdel \\\"%s\\\" -> temp=%td len=%zu\\n\", keystr(i), tempof(m, sizeof(se)),\n           raw_of(m, sizeof(se))->length);\n  }\n  dump_table(m, sizeof(se), \"after-sdels\");\n  base = (se*)((char*)m - sizeof(se));\n  for (ptrdiff_t i = 1; i < (ptrdiff_t)raw_of(m, sizeof(se))->length; i++)\n    printf(\"  s2[%td] key=\\\"%s\\\" val=%d\\n\", i, base[i].key, base[i].value);\n  p_hmfree_func((char*)m - sizeof(se), sizeof(se));\n  for (int i = 0; i < nkeys; i++) if (mode != 1) free(owned[i]);\n}\n\nstatic void test_arena(void) {\n  printf(\"== arena ==\\n\");\n  arena a;\n  memset(&a, 0, sizeof a);\n  char tmp[4096];\n  for (int i = 0; i < 60; i++) {\n    size_t len = (size_t)((i * 97) % 900) + 1;\n    memset(tmp, 'a' + (i % 26), len);\n    tmp[len] = 0;\n    char *p = p_stralloc(&a, tmp);\n    printf(\"alloc len=%zu ok=%d off=%td rem=%zu block=%u\\n\", len, strcmp(p, tmp) == 0,\n           (ptrdiff_t)(p - (char*)a.storage), a.remaining, a.block);\n  }\n  /* huge string */\n  memset(tmp, 'Z', 4000); tmp[4000] = 0;\n  char *p = p_stralloc(&a, tmp);\n  printf(\"alloc huge ok=%d rem=%zu block=%u\\n\", strcmp(p, tmp) == 0, a.remaining, a.block);\n  p_strreset(&a);\n  printf(\"reset storage=%d rem=%zu block=%u mode=%u\\n\", a.storage == NULL, a.remaining,\n         a.block, a.mode);\n  /* fresh arena, tiny strings only */\n  memset(&a, 0, sizeof a);\n  for (int i = 0; i < 300; i++) {\n    sprintf(tmp, \"s%d\", i);\n    char *q = p_stralloc(&a, tmp);\n    if (i % 17 == 0)\n      printf(\"tiny i=%d ok=%d off=%td rem=%zu block=%u\\n\", i, strcmp(q, tmp) == 0,\n             (ptrdiff_t)(q - (char*)a.storage), a.remaining, a.block);\n  }\n  p_strreset(&a);\n  printf(\"reset2 storage=%d rem=%zu block=%u\\n\", a.storage == NULL, a.remaining, a.block);\n}\n\nstatic void test_seed_evolution(void) {\n  printf(\"== seed evolution ==\\n\");\n  size_t seeds[] = {0, 1, 0x31415926, (size_t)-1, 0xdeadbeefcafe1234ULL};\n  for (unsigned s = 0; s < sizeof seeds / sizeof *seeds; s++) {\n    p_rand_seed(seeds[s]);\n    for (int i = 0; i < 4; i++) {\n      ie *m = NULL;\n      int k = i;\n      m = p_hmput_key(m, sizeof(ie), &k, sizeof(int), 0);\n      ptrdiff_t t = tempof(m, sizeof(ie));\n      m[t].key = k; m[t].value = i;\n      hindex *ti = (hindex*)raw_of(m, sizeof(ie))->hash_table;\n      printf(\"seed[%u][%d] = %zx\\n\", s, i, ti->seed);\n      p_hmfree_func((char*)m - sizeof(ie), sizeof(ie));\n    }\n  }\n  p_rand_seed(0x31415926);\n}\n\nstatic void test_strkey_intput(void) {\n  printf(\"== strkey / intput ==\\n\");\n  int ns[] = {0, 1, -1, 9, 11, 42, 12345, -98765, INT_MAX, INT_MIN, 100, 999999};\n  for (unsigned i = 0; i < sizeof ns / sizeof *ns; i++) {\n    char *s = p_strkey(ns[i]);\n    printf(\"strkey(%d) = \\\"%s\\\" len=%zu\\n\", ns[i], s, strlen(s));\n  }\n  /* strkey buffer is reused: pointer must be stable */\n  printf(\"stable=%d\\n\", p_strkey(1) == p_strkey(2));\n  int vals[] = {0, 1, -1, 2, 8, 10, 12, 100, 1000, -5, INT_MAX, INT_MIN};\n  for (unsigned i = 0; i < sizeof vals / sizeof *vals; i++) {\n    p_intput(vals[i]);\n    printf(\"intput(%d) ok\\n\", vals[i]);\n  }\n}\n\n#define LOAD(v, n) do { \\\n    *(void**)&v = dlsym(h, n); \\\n    if (!v) { fprintf(stderr, \"missing %s\\n\", n); exit(2); } } while (0)\n\nint main(int argc, char **argv) {\n  void *h = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n  if (!h) { fprintf(stderr, \"dlopen: %s\\n\", dlerror()); return 1; }\n  LOAD(p_arrgrowf, \"stbds_arrgrowf\");\n  LOAD(p_arrfreef, \"stbds_arrfreef\");\n  LOAD(p_rand_seed, \"stbds_rand_seed\");\n  LOAD(p_hash_bytes, \"stbds_hash_bytes\");\n  LOAD(p_hash_string, \"stbds_hash_string\");\n  LOAD(p_hmfree_func, \"stbds_hmfree_func\");\n  LOAD(p_hmget_key, \"stbds_hmget_key\");\n  LOAD(p_hmget_key_ts, \"stbds_hmget_key_ts\");\n  LOAD(p_hmput_default, \"stbds_hmput_default\");\n  LOAD(p_hmput_key, \"stbds_hmput_key\");\n  LOAD(p_hmdel_key, \"stbds_hmdel_key\");\n  LOAD(p_shmode_func, \"stbds_shmode_func\");\n  LOAD(p_stralloc, \"stbds_stralloc\");\n  LOAD(p_strreset, \"stbds_strreset\");\n  LOAD(p_strkey, \"strkey\");\n  LOAD(p_intput, \"intput\");\n  (void)argc;\n\n  test_hashing();\n  test_arrgrow();\n  test_intmap(1, 0);\n  test_intmap(7, 0);\n  test_intmap(64, 0);\n  test_intmap(300, 0);\n  test_intmap(300, 1);\n  test_hmdel_null_and_default();\n  test_strmap(1, 40);\n  test_strmap(2, 40);\n  test_strmap(3, 40);\n  test_strmap(2, 200);\n  test_strmap(3, 200);\n  test_arena();\n  test_seed_evolution();\n  test_strkey_intput();\n  printf(\"DONE\\n\");\n  return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":465,"cache_read_input_tokens":81058,"cache_creation":{"ephemeral_5m_input_tokens":465,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e21fcab8-2ac4-4b21-a4be-98151a65b796","uuid":"71c43443-d413-47f9-8cca-afc675b760bf","timestamp":"2026-08-27T10:34:11.675Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018QaBPxd9oKGtwMJNYKr1TM","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-J8K08Y/_cbuild/harness.c (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"e21fcab8-2ac4-4b21-a4be-98151a65b796","uuid":"64a15b8c-1e4a-4b41-80e9-e2f927120e63","timestamp":"2026-08-27T10:34:11.686Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-J8K08Y/_cbuild/harness.c","content":"// Differential harness: dlopen a stb_ds-style .so and print a deterministic\n// trace of its behaviour + internal structure state.\n#define _GNU_SOURCE\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <limits.h>\n#include <dlfcn.h>\n\ntypedef struct { size_t length, capacity; void *hash_table; ptrdiff_t temp; } hdr;\ntypedef struct { void *storage; size_t remaining; unsigned char block, mode; } arena;\ntypedef struct {\n  char *temp_key;\n  size_t slot_count, used_count, used_count_threshold, used_count_shrink_threshold;\n  size_t tombstone_count, tombstone_count_threshold, seed, slot_count_log2;\n  arena string;\n  void *storage;\n} hindex;\n\n#define HDR(p) (((hdr*)(p)) - 1)\n\nstatic void *(*p_arrgrowf)(void*,size_t,size_t,size_t);\nstatic void  (*p_arrfreef)(void*);\nstatic void  (*p_rand_seed)(size_t);\nstatic size_t(*p_hash_bytes)(void*,size_t,size_t);\nstatic size_t(*p_hash_string)(char*,size_t);\nstatic void  (*p_hmfree_func)(void*,size_t);\nstatic void *(*p_hmget_key)(void*,size_t,void*,size_t,int);\nstatic void *(*p_hmget_key_ts)(void*,size_t,void*,size_t,ptrdiff_t*,int);\nstatic void *(*p_hmput_default)(void*,size_t);\nstatic void *(*p_hmput_key)(void*,size_t,void*,size_t,int);\nstatic void *(*p_hmdel_key)(void*,size_t,void*,size_t,size_t,int);\nstatic void *(*p_shmode_func)(size_t,int);\nstatic char *(*p_stralloc)(void*,char*);\nstatic void  (*p_strreset)(void*);\nstatic char *(*p_strkey)(int);\nstatic void  (*p_intput)(int);\n\ntypedef struct { int key, value; } ie;\ntypedef struct { char *key; int value; } se;\ntypedef struct { int key[2]; int b, c, d; } s2;\n\nstatic hdr *raw_of(void *hashptr, size_t elemsize) {\n  return (hdr*)(((char*)hashptr) - elemsize) - 1;\n}\n\nstatic void dump_table(void *hashptr, size_t elemsize, const char *tag) {\n  hdr *h = raw_of(hashptr, elemsize);\n  hindex *t = (hindex*)h->hash_table;\n  printf(\"%s len=%zu cap=%zu temp=%td\", tag, h->length, h->capacity, h->temp);\n  if (t)\n    printf(\" | slots=%zu used=%zu tomb=%zu uct=%zu ucst=%zu tct=%zu log2=%zu seed=%zx amode=%u ablock=%u arem=%zu\\n\",\n        t->slot_count, t->used_count, t->tombstone_count, t->used_count_threshold,\n        t->used_count_shrink_threshold, t->tombstone_count_threshold, t->slot_count_log2,\n        t->seed, t->string.mode, t->string.block, t->string.remaining);\n  else\n    printf(\" | table=NULL\\n\");\n}\n\n/* ---- macro emulation ---- */\nstatic ptrdiff_t tempof(void *hashptr, size_t elemsize) {\n  return raw_of(hashptr, elemsize)->temp;\n}\n\nstatic void test_hashing(void) {\n  printf(\"== hashing ==\\n\");\n  unsigned char buf[64];\n  for (int i = 0; i < 64; i++) buf[i] = (unsigned char)(i * 37 + 129); /* many >= 0x80 */\n  for (size_t len = 0; len <= 40; len++) {\n    for (size_t s = 0; s < 3; s++) {\n      size_t seed = (size_t)(s * 0x9e3779b97f4a7c15ULL + 1);\n      printf(\"hb len=%2zu seed=%zx -> %zx\\n\", len, seed, p_hash_bytes(buf, len, seed));\n    }\n  }\n  /* all-zero and 0x7f/0x80 boundary patterns */\n  unsigned char b2[16];\n  for (int pat = 0; pat < 4; pat++) {\n    static const unsigned char vals[4] = {0x00, 0x7f, 0x80, 0xff};\n    memset(b2, vals[pat], sizeof b2);\n    for (size_t len = 0; len <= 16; len++)\n      printf(\"hb pat=%02x len=%2zu -> %zx\\n\", vals[pat], len, p_hash_bytes(b2, len, 0x1234));\n  }\n  /* single high byte in each position */\n  for (int pos = 0; pos < 8; pos++) {\n    memset(b2, 0, sizeof b2);\n    b2[pos] = 0xff;\n    for (size_t len = 1; len <= 12; len++)\n      printf(\"hb pos=%d len=%2zu -> %zx\\n\", pos, len, p_hash_bytes(b2, len, 0xabcdef));\n  }\n  static char *strs[] = { \"\", \"a\", \"ab\", \"abc\", \"test_0\", \"test_123456\",\n                          \"\\x80\\xff\\x7f\", \"the quick brown fox jumps over the lazy dog\" };\n  for (unsigned i = 0; i < sizeof strs / sizeof *strs; i++)\n    for (size_t s = 0; s < 3; s++)\n      printf(\"hs \\\"%s\\\" seed=%zu -> %zx\\n\", strs[i], s, p_hash_string(strs[i], s * 7919));\n  /* int keys as bytes (what hmput uses) */\n  for (int k = -5; k <= 5; k++) {\n    int kk = k;\n    printf(\"hb int %d -> %zx\\n\", k, p_hash_bytes(&kk, sizeof kk, 0x31415926));\n  }\n}\n\nstatic void test_arrgrow(void) {\n  printf(\"== arrgrowf ==\\n\");\n  void *a = NULL;\n  for (int i = 0; i < 25; i++) {\n    a = p_arrgrowf(a, 4, 1, 0);\n    HDR(a)->length++;\n    printf(\"grow1 i=%d len=%zu cap=%zu temp=%td ht=%d\\n\", i, HDR(a)->length,\n           HDR(a)->capacity, HDR(a)->temp, HDR(a)->hash_table != NULL);\n  }\n  p_arrfreef(a);\n  a = NULL;\n  size_t ns[] = {0, 1, 3, 4, 5, 7, 8, 100, 101, 4095};\n  for (unsigned i = 0; i < sizeof ns / sizeof *ns; i++) {\n    a = p_arrgrowf(a, 8, ns[i], 0);\n    printf(\"growN n=%zu len=%zu cap=%zu\\n\", ns[i], HDR(a)->length, HDR(a)->capacity);\n    HDR(a)->length += ns[i];\n  }\n  p_arrfreef(a);\n  a = NULL;\n  for (unsigned i = 0; i < sizeof ns / sizeof *ns; i++) {\n    a = p_arrgrowf(a, 16, 0, ns[i]);\n    printf(\"growCap min=%zu len=%zu cap=%zu\\n\", ns[i], HDR(a)->length, HDR(a)->capacity);\n  }\n  p_arrfreef(a);\n}\n\nstatic void test_intmap(int nkeys, int seedmode) {\n  printf(\"== intmap n=%d sm=%d ==\\n\", nkeys, seedmode);\n  if (seedmode) p_rand_seed(0xdeadbeefU);\n  ie *m = NULL;\n  for (int i = 0; i < nkeys; i++) {\n    int k = (i * 7919) % 1000;\n    m = p_hmput_key(m, sizeof(ie), &k, sizeof(int), 0);\n    ptrdiff_t t = tempof(m, sizeof(ie));\n    m[t].key = k; m[t].value = i;\n    if (i % 8 == 0) dump_table(m, sizeof(ie), \"put\");\n  }\n  dump_table(m, sizeof(ie), \"after-puts\");\n  for (ptrdiff_t i = 0; i < (ptrdiff_t)raw_of(m, sizeof(ie))->length; i++)\n    printf(\"  elem[%td] key=%d val=%d\\n\", i, ((ie*)((char*)m - sizeof(ie)))[i].key,\n           ((ie*)((char*)m - sizeof(ie)))[i].value);\n  /* lookups (hit and miss) */\n  for (int k = -3; k < 1000; k += 37) {\n    int kk = k;\n    m = p_hmget_key(m, sizeof(ie), &kk, sizeof(int), 0);\n    ptrdiff_t t = tempof(m, sizeof(ie));\n    printf(\"  get %d -> t=%td val=%d\\n\", k, t, m[t].value);\n  }\n  /* _ts lookups */\n  for (int k = 0; k < 100; k += 13) {\n    int kk = k; ptrdiff_t t = -99;\n    m = p_hmget_key_ts(m, sizeof(ie), &kk, sizeof(int), &t, 0);\n    printf(\"  get_ts %d -> t=%td\\n\", k, t);\n  }\n  /* deletions */\n  for (int i = 0; i < nkeys; i += 3) {\n    int k = (i * 7919) % 1000;\n    m = p_hmdel_key(m, sizeof(ie), &k, sizeof(int), offsetof(ie, key), 0);\n    printf(\"  del %d -> temp=%td len=%zu\\n\", k, tempof(m, sizeof(ie)),\n           raw_of(m, sizeof(ie))->length);\n    if (i % 9 == 0) dump_table(m, sizeof(ie), \"  after-del\");\n  }\n  dump_table(m, sizeof(ie), \"after-dels\");\n  for (ptrdiff_t i = 0; i < (ptrdiff_t)raw_of(m, sizeof(ie))->length; i++)\n    printf(\"  elem2[%td] key=%d val=%d\\n\", i, ((ie*)((char*)m - sizeof(ie)))[i].key,\n           ((ie*)((char*)m - sizeof(ie)))[i].value);\n  /* delete missing keys */\n  for (int k = 1001; k < 1010; k++) {\n    m = p_hmdel_key(m, sizeof(ie), &k, sizeof(int), offsetof(ie, key), 0);\n    printf(\"  delmiss %d -> temp=%td len=%zu\\n\", k, tempof(m, sizeof(ie)),\n           raw_of(m, sizeof(ie))->length);\n  }\n  /* re-insert to exercise tombstones */\n  for (int i = 0; i < nkeys; i += 3) {\n    int k = (i * 7919) % 1000;\n    m = p_hmput_key(m, sizeof(ie), &k, sizeof(int), 0);\n    ptrdiff_t t = tempof(m, sizeof(ie));\n    m[t].key = k; m[t].value = 1000 + i;\n  }\n  dump_table(m, sizeof(ie), \"after-reinsert\");\n  for (ptrdiff_t i = 0; i < (ptrdiff_t)raw_of(m, sizeof(ie))->length; i++)\n    printf(\"  elem3[%td] key=%d val=%d\\n\", i, ((ie*)((char*)m - sizeof(ie)))[i].key,\n           ((ie*)((char*)m - sizeof(ie)))[i].value);\n  p_hmfree_func((char*)m - sizeof(ie), sizeof(ie));\n}\n\nstatic void test_hmdel_null_and_default(void) {\n  printf(\"== misc ==\\n\");\n  int k = 5;\n  void *r = p_hmdel_key(NULL, sizeof(ie), &k, sizeof(int), offsetof(ie, key), 0);\n  printf(\"hmdel(NULL) -> %d\\n\", r == NULL);\n  ie *m = NULL;\n  m = p_hmput_default(m, sizeof(ie));\n  dump_table(m, sizeof(ie), \"hmput_default\");\n  m[-1].value = 42;\n  printf(\"default value %d key %d\\n\", m[-1].value, m[-1].key);\n  m = p_hmput_default(m, sizeof(ie));\n  dump_table(m, sizeof(ie), \"hmput_default2\");\n  int kk = 3;\n  m = p_hmget_key(m, sizeof(ie), &kk, sizeof(int), 0);\n  printf(\"miss default -> t=%td val=%d\\n\", tempof(m, sizeof(ie)), m[tempof(m,sizeof(ie))].value);\n  m = p_hmput_key(m, sizeof(ie), &kk, sizeof(int), 0);\n  ptrdiff_t t = tempof(m, sizeof(ie));\n  m[t].key = kk; m[t].value = 77;\n  dump_table(m, sizeof(ie), \"after put on default\");\n  kk = 3;\n  m = p_hmget_key(m, sizeof(ie), &kk, sizeof(int), 0);\n  printf(\"hit -> t=%td val=%d\\n\", tempof(m, sizeof(ie)), m[tempof(m,sizeof(ie))].value);\n  p_hmfree_func((char*)m - sizeof(ie), sizeof(ie));\n\n  /* get on empty map */\n  ie *e = NULL;\n  int z = 1;\n  ptrdiff_t tt = -55;\n  e = p_hmget_key_ts(e, sizeof(ie), &z, sizeof(int), &tt, 0);\n  printf(\"get_ts on NULL -> t=%td len=%zu cap=%zu\\n\", tt, raw_of(e,sizeof(ie))->length,\n         raw_of(e,sizeof(ie))->capacity);\n  p_hmfree_func((char*)e - sizeof(ie), sizeof(ie));\n\n  /* 2-int key struct (larger keysize, binary mode) */\n  s2 *m2 = NULL;\n  for (int i = 0; i < 40; i++) {\n    int key[2] = { i % 7, i % 5 };\n    m2 = p_hmput_key(m2, sizeof(s2), key, sizeof key, 0);\n    ptrdiff_t q = tempof(m2, sizeof(s2));\n    m2[q].key[0] = key[0]; m2[q].key[1] = key[1]; m2[q].b = i;\n  }\n  dump_table(m2, sizeof(s2), \"s2\");\n  for (ptrdiff_t i = 0; i < (ptrdiff_t)raw_of(m2, sizeof(s2))->length; i++) {\n    s2 *base = (s2*)((char*)m2 - sizeof(s2));\n    printf(\"  s2[%td] k={%d,%d} b=%d\\n\", i, base[i].key[0], base[i].key[1], base[i].b);\n  }\n  p_hmfree_func((char*)m2 - sizeof(s2), sizeof(s2));\n}\n\nstatic char *keystr(int n) { static char b[64]; sprintf(b, \"key_%d_%*s\", n, n % 17, \"\"); return b; }\n\nstatic void test_strmap(int mode, int nkeys) {\n  printf(\"== strmap mode=%d n=%d ==\\n\", mode, nkeys);\n  se *m = NULL;\n  if (mode > 1) m = p_shmode_func(sizeof(se), mode); /* 2=strdup 3=arena */\n  if (m) dump_table(m, sizeof(se), \"shmode\");\n  char *owned[512];\n  for (int i = 0; i < nkeys; i++) {\n    char *k = strdup(keystr(i * 13 % nkeys));\n    owned[i] = k;\n    m = p_hmput_key(m, sizeof(se), k, sizeof(char*), 1);\n    ptrdiff_t t = tempof(m, sizeof(se));\n    m[t].value = i;\n    if (i % 10 == 0) dump_table(m, sizeof(se), \"sput\");\n  }\n  dump_table(m, sizeof(se), \"after-sputs\");\n  se *base = (se*)((char*)m - sizeof(se));\n  for (ptrdiff_t i = 1; i < (ptrdiff_t)raw_of(m, sizeof(se))->length; i++) {\n    int is_borrowed = 0;\n    for (int j = 0; j < nkeys; j++) if (base[i].key == owned[j]) is_borrowed = 1;\n    printf(\"  s[%td] key=\\\"%s\\\" val=%d borrowed=%d\\n\", i, base[i].key, base[i].value, is_borrowed);\n  }\n  for (int i = 0; i < nkeys; i++) {\n    m = p_hmget_key(m, sizeof(se), keystr(i), sizeof(char*), 1);\n    ptrdiff_t t = tempof(m, sizeof(se));\n    printf(\"  sget \\\"%s\\\" -> t=%td val=%d\\n\", keystr(i), t, m[t].value);\n  }\n  for (int i = 0; i < nkeys; i += 2) {\n    m = p_hmdel_key(m, sizeof(se), keystr(i), sizeof(char*), offsetof(se, key), 1);\n    printf(\"  sdel \\\"%s\\\" -> temp=%td len=%zu\\n\", keystr(i), tempof(m, sizeof(se)),\n           raw_of(m, sizeof(se))->length);\n  }\n  dump_table(m, sizeof(se), \"after-sdels\");\n  base = (se*)((char*)m - sizeof(se));\n  for (ptrdiff_t i = 1; i < (ptrdiff_t)raw_of(m, sizeof(se))->length; i++)\n    printf(\"  s2[%td] key=\\\"%s\\\" val=%d\\n\", i, base[i].key, base[i].value);\n  p_hmfree_func((char*)m - sizeof(se), sizeof(se));\n  for (int i = 0; i < nkeys; i++) if (mode != 1) free(owned[i]);\n}\n\nstatic void test_arena(void) {\n  printf(\"== arena ==\\n\");\n  arena a;\n  memset(&a, 0, sizeof a);\n  char tmp[4096];\n  for (int i = 0; i < 60; i++) {\n    size_t len = (size_t)((i * 97) % 900) + 1;\n    memset(tmp, 'a' + (i % 26), len);\n    tmp[len] = 0;\n    char *p = p_stralloc(&a, tmp);\n    printf(\"alloc len=%zu ok=%d off=%td rem=%zu block=%u\\n\", len, strcmp(p, tmp) == 0,\n           (ptrdiff_t)(p - (char*)a.storage), a.remaining, a.block);\n  }\n  /* huge string */\n  memset(tmp, 'Z', 4000); tmp[4000] = 0;\n  char *p = p_stralloc(&a, tmp);\n  printf(\"alloc huge ok=%d rem=%zu block=%u\\n\", strcmp(p, tmp) == 0, a.remaining, a.block);\n  p_strreset(&a);\n  printf(\"reset storage=%d rem=%zu block=%u mode=%u\\n\", a.storage == NULL, a.remaining,\n         a.block, a.mode);\n  /* fresh arena, tiny strings only */\n  memset(&a, 0, sizeof a);\n  for (int i = 0; i < 300; i++) {\n    sprintf(tmp, \"s%d\", i);\n    char *q = p_stralloc(&a, tmp);\n    if (i % 17 == 0)\n      printf(\"tiny i=%d ok=%d off=%td rem=%zu block=%u\\n\", i, strcmp(q, tmp) == 0,\n             (ptrdiff_t)(q - (char*)a.storage), a.remaining, a.block);\n  }\n  p_strreset(&a);\n  printf(\"reset2 storage=%d rem=%zu block=%u\\n\", a.storage == NULL, a.remaining, a.block);\n}\n\nstatic void test_seed_evolution(void) {\n  printf(\"== seed evolution ==\\n\");\n  size_t seeds[] = {0, 1, 0x31415926, (size_t)-1, 0xdeadbeefcafe1234ULL};\n  for (unsigned s = 0; s < sizeof seeds / sizeof *seeds; s++) {\n    p_rand_seed(seeds[s]);\n    for (int i = 0; i < 4; i++) {\n      ie *m = NULL;\n      int k = i;\n      m = p_hmput_key(m, sizeof(ie), &k, sizeof(int), 0);\n      ptrdiff_t t = tempof(m, sizeof(ie));\n      m[t].key = k; m[t].value = i;\n      hindex *ti = (hindex*)raw_of(m, sizeof(ie))->hash_table;\n      printf(\"seed[%u][%d] = %zx\\n\", s, i, ti->seed);\n      p_hmfree_func((char*)m - sizeof(ie), sizeof(ie));\n    }\n  }\n  p_rand_seed(0x31415926);\n}\n\nstatic void test_strkey_intput(void) {\n  printf(\"== strkey / intput ==\\n\");\n  int ns[] = {0, 1, -1, 9, 11, 42, 12345, -98765, INT_MAX, INT_MIN, 100, 999999};\n  for (unsigned i = 0; i < sizeof ns / sizeof *ns; i++) {\n    char *s = p_strkey(ns[i]);\n    printf(\"strkey(%d) = \\\"%s\\\" len=%zu\\n\", ns[i], s, strlen(s));\n  }\n  /* strkey buffer is reused: pointer must be stable */\n  printf(\"stable=%d\\n\", p_strkey(1) == p_strkey(2));\n  int vals[] = {0, 1, -1, 2, 8, 10, 12, 100, 1000, -5, INT_MAX, INT_MIN};\n  for (unsigned i = 0; i < sizeof vals / sizeof *vals; i++) {\n    p_intput(vals[i]);\n    printf(\"intput(%d) ok\\n\", vals[i]);\n  }\n}\n\n#define LOAD(v, n) do { \\\n    *(void**)&v = dlsym(h, n); \\\n    if (!v) { fprintf(stderr, \"missing %s\\n\", n); exit(2); } } while (0)\n\nint main(int argc, char **argv) {\n  void *h = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n  if (!h) { fprintf(stderr, \"dlopen: %s\\n\", dlerror()); return 1; }\n  LOAD(p_arrgrowf, \"stbds_arrgrowf\");\n  LOAD(p_arrfreef, \"stbds_arrfreef\");\n  LOAD(p_rand_seed, \"stbds_rand_seed\");\n  LOAD(p_hash_bytes, \"stbds_hash_bytes\");\n  LOAD(p_hash_string, \"stbds_hash_string\");\n  LOAD(p_hmfree_func, \"stbds_hmfree_func\");\n  LOAD(p_hmget_key, \"stbds_hmget_key\");\n  LOAD(p_hmget_key_ts, \"stbds_hmget_key_ts\");\n  LOAD(p_hmput_default, \"stbds_hmput_default\");\n  LOAD(p_hmput_key, \"stbds_hmput_key\");\n  LOAD(p_hmdel_key, \"stbds_hmdel_key\");\n  LOAD(p_shmode_func, \"stbds_shmode_func\");\n  LOAD(p_stralloc, \"stbds_stralloc\");\n  LOAD(p_strreset, \"stbds_strreset\");\n  LOAD(p_strkey, \"strkey\");\n  LOAD(p_intput, \"intput\");\n  (void)argc;\n\n  test_hashing();\n  test_arrgrow();\n  test_intmap(1, 0);\n  test_intmap(7, 0);\n  test_intmap(64, 0);\n  test_intmap(300, 0);\n  test_intmap(300, 1);\n  test_hmdel_null_and_default();\n  test_strmap(1, 40);\n  test_strmap(2, 40);\n  test_strmap(3, 40);\n  test_strmap(2, 200);\n  test_strmap(3, 200);\n  test_arena();\n  test_seed_evolution();\n  test_strkey_intput();\n  printf(\"DONE\\n\");\n  return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
