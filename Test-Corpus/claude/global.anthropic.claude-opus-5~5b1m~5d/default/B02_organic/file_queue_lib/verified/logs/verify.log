{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Jo3poRJxjfd5tq3KiG9VA4","type":"tool_result","content":"1\t//! Translation of `c_src/src/file-queue.c` (+ `c_src/include/file-queue.h`).\n2\t\n3\tuse core::ffi::{c_char, c_int, c_long, c_uint};\n4\tuse core::ptr;\n5\t\n6\tuse crate::cbind::*;\n7\tuse crate::read_alert::{alert_data, GetAlertData, ALERTS_DAILY, CRALERT_FP_SET, CRALERT_READ_ALL};\n8\t\n9\t/* ---------------------------------------------------------------- */\n10\t/* file-queue.h                                                     */\n11\t/* ---------------------------------------------------------------- */\n12\t\n13\t/// `#define MAX_FQUEUE 256`\n14\tpub const MAX_FQUEUE: usize = 256;\n15\t/// `#define FQ_TIMEOUT 5`\n16\tpub const FQ_TIMEOUT: c_long = 5;\n17\t\n18\t/// ```c\n19\t/// typedef struct file_queue {\n20\t///     time_t last_change;\n21\t///     int year;\n22\t///     int day;\n23\t///     int flags;\n24\t///     char mon[4];\n25\t///     char file_name[MAX_FQUEUE + 1];\n26\t///     FILE *fp;\n27\t///     struct stat f_status;\n28\t/// } file_queue;\n29\t/// ```\n30\t#[repr(C)]\n31\tpub struct file_queue {\n32\t    pub last_change: c_long,\n33\t    pub year: c_int,\n34\t    pub day: c_int,\n35\t    pub flags: c_int,\n36\t    pub mon: [c_char; 4],\n37\t    pub file_name: [c_char; MAX_FQUEUE + 1],\n38\t    pub fp: *mut FILE,\n39\t    pub f_status: stat,\n40\t}\n41\t\n42\t/* ---------------------------------------------------------------- */\n43\t/* file-queue.c                                                     */\n44\t/* ---------------------------------------------------------------- */\n45\t\n46\tconst FSTAT_ERROR: &[u8] =\n47\t    b\"(1118): Could not retrieve information of file '%s' due to [(%d)-(%s)].\\0\";\n48\tconst FSEEK_ERROR: &[u8] = b\"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\\0\";\n49\t\n50\t/// ```c\n51\t/// void merror(const char *err_template, const char *file_name, int err, const char *err_msg)\n52\t/// ```\n53\t#[unsafe(no_mangle)]\n54\tpub unsafe extern \"C\" fn merror(\n55\t    err_template: *const c_char,\n56\t    file_name: *const c_char,\n57\t    err: c_int,\n58\t    err_msg: *const c_char,\n59\t) {\n60\t    let mut buffer = [0 as c_char; 256];\n61\t    snprintf(\n62\t        buffer.as_mut_ptr(),\n63\t        core::mem::size_of_val(&buffer),\n64\t        err_template,\n65\t        file_name,\n66\t        err,\n67\t        err_msg,\n68\t    );\n69\t    fprintf(stderr, cs(b\"%s\\n\\0\"), buffer.as_ptr());\n70\t}\n71\t\n72\t/// `static const char *(s_month[]) = {\"Jan\", ... \"Dec\"};`\n73\tstatic S_MONTH: [&[u8]; 12] = [\n74\t    b\"Jan\\0\", b\"Feb\\0\", b\"Mar\\0\", b\"Apr\\0\", b\"May\\0\", b\"Jun\\0\", b\"Jul\\0\", b\"Aug\\0\", b\"Sep\\0\",\n75\t    b\"Oct\\0\", b\"Nov\\0\", b\"Dec\\0\",\n76\t];\n77\t\n78\t/// `strncpy(fileq->mon, s_month[p->tm_mon], 3);`\n79\t///\n80\t/// The C code indexes `s_month` without validating `tm_mon`; an out-of-range\n81\t/// month is undefined behaviour there (it reads past the end of a 12 element\n82\t/// table).  There is nothing meaningful to mirror, so the copy is skipped.\n83\t#[inline]\n84\tunsafe fn copy_month(fileq: *mut file_queue, tm_mon: c_int) {\n85\t    if tm_mon >= 0 && (tm_mon as usize) < 12 {\n86\t        strncpy(\n87\t            (*fileq).mon.as_mut_ptr(),\n88\t            cs(S_MONTH[tm_mon as usize]),\n89\t            3,\n90\t        );\n91\t    }\n92\t}\n93\t\n94\t/// ```c\n95\t/// static void file_sleep(void)\n96\t/// ```\n97\tunsafe fn file_sleep() {\n98\t    let mut fp_timeout = timeval {\n99\t        tv_sec: FQ_TIMEOUT,\n100\t        tv_usec: 0,\n101\t    };\n102\t\n103\t    /* Wait for the select timeout */\n104\t    select(\n105\t        0,\n106\t        ptr::null_mut(),\n107\t        ptr::null_mut(),\n108\t        ptr::null_mut(),\n109\t        &mut fp_timeout,\n110\t    );\n111\t}\n112\t\n113\t/// ```c\n114\t/// static void GetFile_Queue(file_queue *fileq)\n115\t/// ```\