{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TJkgEK8De47CXWKFwQmpHN","type":"tool_result","content":"1\t//! Translation of `c_src/src/file-queue.c` (+ `c_src/include/file-queue.h`).\n2\t\n3\tuse core::ffi::{c_char, c_int, c_long, c_uint};\n4\tuse core::ptr;\n5\t\n6\tuse crate::cbind::*;\n7\tuse crate::read_alert::{alert_data, GetAlertData, ALERTS_DAILY, CRALERT_FP_SET, CRALERT_READ_ALL};\n8\t\n9\t/* ---------------------------------------------------------------- */\n10\t/* file-queue.h                                                     */\n11\t/* ---------------------------------------------------------------- */\n12\t\n13\t/// `#define MAX_FQUEUE 256`\n14\tpub const MAX_FQUEUE: usize = 256;\n15\t/// `#define FQ_TIMEOUT 5`\n16\tpub const FQ_TIMEOUT: c_long = 5;\n17\t\n18\t/// ```c\n19\t/// typedef struct file_queue {\n20\t///     time_t last_change;\n21\t///     int year;\n22\t///     int day;\n23\t///     int flags;\n24\t///     char mon[4];\n25\t///     char file_name[MAX_FQUEUE + 1];\n26\t///     FILE *fp;\n27\t///     struct stat f_status;\n28\t/// } file_queue;\n29\t/// ```\n30\t#[repr(C)]\n31\tpub struct file_queue {\n32\t    pub last_change: c_long,\n33\t    pub year: c_int,\n34\t    pub day: c_int,\n35\t    pub flags: c_int,\n36\t    pub mon: [c_char; 4],\n37\t    pub file_name: [c_char; MAX_FQUEUE + 1],\n38\t    pub fp: *mut FILE,\n39\t    pub f_status: stat,\n40\t}\n41\t\n42\t/* ---------------------------------------------------------------- */\n43\t/* file-queue.c                                                     */\n44\t/* ---------------------------------------------------------------- */\n45\t\n46\tconst FSTAT_ERROR: &[u8] =\n47\t    b\"(1118): Could not retrieve information of file '%s' due to [(%d)-(%s)].\\0\";\n48\tconst FSEEK_ERROR: &[u8] = b\"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\\0\";\n49\t\n50\t/// ```c\n51\t/// void merror(const char *err_template, const char *file_name, int err, const char *err_msg)\n52\t/// ```\n53\t#[unsafe(no_mangle)]\n54\tpub unsafe extern \"C\" fn merror(\n55\t    err_template: *const c_char,\n56\t    file_name: *const c_char,\n57\t    err: c_int,\n58\t    err_msg: *const c_char,\n59\t) {\n60\t    let mut buffer = [0 as c_char; 256];\n61\t    snprintf(\n62\t        buffer.as_mut_ptr(),\n63\t        core::mem::size_of_val(&buffer),\n64\t        err_template,\n65\t        file_name,\n66\t        err,\n67\t        err_msg,\n68\t    );\n69\t    fprintf(stderr, cs(b\"%s\\n\\0\"), buffer.as_ptr());\n70\t}\n71\t\n72\t/// `static const char *(s_month[]) = {\"Jan\", ... \"Dec\"};`\n73\tstatic S_MONTH: [&[u8]; 12] = [\n74\t    b\"Jan\\0\", b\"Feb\\0\", b\"Mar\\0\", b\"Apr\\0\", b\"May\\0\", b\"Jun\\0\", b\"Jul\\0\", b\"Aug\\0\", b\"Sep\\0\",\n75\t    b\"Oct\\0\", b\"Nov\\0\", b\"Dec\\0\",\n76\t];\n77\t\n78\t/// `strncpy(fileq->mon, s_month[p->tm_mon], 3);`\n79\t///\n80\t/// The C code indexes `s_month` without validating `tm_mon`; an out-of-range\n81\t/// month is undefined behaviour there (it reads past the end of a 12 element\n82\t/// table).  There is nothing meaningful to mirror, so the copy is skipped.\n83\t#[inline]\n84\tunsafe fn copy_month(fileq: *mut file_queue, tm_mon: c_int) {\n85\t    if tm_mon >= 0 && (tm_mon as usize) < 12 {\n86\t        strncpy(\n87\t            (*fileq).mon.as_mut_ptr(),\n88\t            cs(S_MONTH[tm_mon as usize]),\n89\t            3,\n90\t        );\n91\t    }\n92\t}\n93\t\n94\t/// ```c\n95\t/// static void file_sleep(void)\n96\t/// ```\n97\tunsafe fn file_sleep() {\n98\t    let mut fp_timeout = timeval {\n99\t        tv_sec: FQ_TIMEOUT,\n100\t        tv_usec: 0,\n101\t    };\n102\t\n103\t    /* Wait for the select timeout */\n104\t    select(\n105\t        0,\n106\t        ptr::null_mut(),\n107\t        ptr::null_mut(),\n108\t        ptr::null_mut(),\n109\t        &mut fp_timeout,\n110\t    );\n111\t}\n112\t\n113\t/// ```c\n114\t/// static void GetFile_Queue(file_queue *fileq)\n115\t/// ```\n116\t#[allow(non_snake_case)]\n117\tunsafe fn GetFile_Queue(fileq: *mut file_queue) {\n118\t    /* Create the logfile name */\n119\t    (*fileq).file_name[0] = 0;\n120\t    (*fileq).file_name[MAX_FQUEUE] = 0;\n121\t\n122\t    let src = if (*fileq).flags & CRALERT_FP_SET != 0 {\n123\t        cs(b\"<stdin>\\0\")\n124\t    } else {\n125\t        cs(ALERTS_DAILY)\n126\t    };\n127\t\n128\t    snprintf(\n129\t        (*fileq).file_name.as_mut_ptr(),\n130\t        MAX_FQUEUE,\n131\t        cs(b\"%s\\0\"),\n132\t        src,\n133\t    );\n134\t}\n135\t\n136\t/// ```c\n137\t/// static int Handle_Queue(file_queue *fileq, int flags)\n138\t/// ```\n139\t#[allow(non_snake_case)]\n140\tunsafe fn Handle_Queue(fileq: *mut file_queue, flags: c_int) -> c_int {\n141\t    /* Close if it is open */\n142\t    if flags & CRALERT_FP_SET == 0 {\n143\t        if !(*fileq).fp.is_null() {\n144\t            fclose((*fileq).fp);\n145\t            (*fileq).fp = ptr::null_mut();\n146\t        }\n147\t\n148\t        /* We must be able to open the file, fseek and get the\n149\t         * time of change from it.\n150\t         */\n151\t        (*fileq).fp = fopen((*fileq).file_name.as_ptr(), cs(b\"r\\0\"));\n152\t        if (*fileq).fp.is_null() {\n153\t            /* Queue not available */\n154\t            return 0;\n155\t        }\n156\t    }\n157\t\n158\t    /* Seek to the end of the file */\n159\t    if flags & CRALERT_READ_ALL == 0 {\n160\t        if (*fileq).fp.is_null() {\n161\t            return 0;\n162\t        }\n163\t\n164\t        if fseek((*fileq).fp, 0, SEEK_END) < 0 {\n165\t            merror(\n166\t                cs(FSEEK_ERROR),\n167\t                (*fileq).file_name.as_ptr(),\n168\t                errno(),\n169\t                strerror(errno()),\n170\t            );\n171\t            fclose((*fileq).fp);\n172\t            (*fileq).fp = ptr::null_mut();\n173\t            return -1;\n174\t        }\n175\t    }\n176\t\n177\t    /* File change time */\n178\t    if !(*fileq).fp.is_null() {\n179\t        if fstat(fileno((*fileq).fp), &mut (*fileq).f_status) < 0 {\n180\t            merror(\n181\t                cs(FSTAT_ERROR),\n182\t                (*fileq).file_name.as_ptr(),\n183\t                errno(),\n184\t                strerror(errno()),\n185\t            );\n186\t            fclose((*fileq).fp);\n187\t            (*fileq).fp = ptr::null_mut();\n188\t            return -1;\n189\t        }\n190\t    }\n191\t\n192\t    (*fileq).last_change = (*fileq).f_status.st_mtim.tv_sec;\n193\t\n194\t    1\n195\t}\n196\t\n197\t/// ```c\n198\t/// int Init_FileQueue(file_queue *fileq, const struct tm *p, int flags)\n199\t/// ```\n200\t#[allow(non_snake_case)]\n201\t#[unsafe(no_mangle)]\n202\tpub unsafe extern \"C\" fn Init_FileQueue(\n203\t    fileq: *mut file_queue,\n204\t    p: *const tm,\n205\t    flags: c_int,\n206\t) -> c_int {\n207\t    /* Initialize file_queue fields */\n208\t    if flags & CRALERT_FP_SET == 0 {\n209\t        (*fileq).fp = ptr::null_mut();\n210\t    }\n211\t    (*fileq).last_change = 0;\n212\t    (*fileq).flags = 0;\n213\t\n214\t    (*fileq).day = (*p).tm_mday;\n215\t    // `fileq->year = p->tm_year + 1900;` -- the C performs plain `int`\n216\t    // addition, which simply wraps on the target; `wrapping_add` keeps that\n217\t    // behaviour instead of panicking in an overflow-checked Rust build.\n218\t    (*fileq).year = (*p).tm_year.wrapping_add(1900);\n219\t\n220\t    copy_month(fileq, (*p).tm_mon);\n221\t    memset(\n222\t        (*fileq).file_name.as_mut_ptr() as *mut core::ffi::c_void,\n223\t        0,\n224\t        MAX_FQUEUE + 1,\n225\t    );\n226\t\n227\t    /* Set the supplied flags */\n228\t    (*fileq).flags = flags;\n229\t\n230\t    /* Get latest file */\n231\t    GetFile_Queue(fileq);\n232\t\n233\t    /* Always seek to the end when starting the queue */\n234\t    if Handle_Queue(fileq, (*fileq).flags) < 0 {\n235\t        return -1;\n236\t    }\n237\t\n238\t    0\n239\t}\n240\t\n241\t/// ```c\n242\t/// alert_data *Read_FileMon(file_queue *fileq, const struct tm *p, unsigned int timeout)\n243\t/// ```\n244\t#[allow(non_snake_case)]\n245\t#[unsafe(no_mangle)]\n246\tpub unsafe extern \"C\" fn Read_FileMon(\n247\t    fileq: *mut file_queue,\n248\t    p: *const tm,\n249\t    timeout: c_uint,\n250\t) -> *mut alert_data {\n251\t    let mut i: c_uint = 0;\n252\t    let mut al_data: *mut alert_data;\n253\t\n254\t    /* If the file queue is not available, try to access it */\n255\t    if (*fileq).fp.is_null() {\n256\t        if Handle_Queue(fileq, 0) != 1 {\n257\t            file_sleep();\n258\t            return ptr::null_mut();\n259\t        }\n260\t    }\n261\t\n262\t    if (*fileq).fp.is_null() {\n263\t        return ptr::null_mut();\n264\t    }\n265\t\n266\t    al_data = GetAlertData((*fileq).flags, (*fileq).fp);\n267\t    if !al_data.is_null() {\n268\t        return al_data;\n269\t    }\n270\t\n271\t    (*fileq).day = (*p).tm_mday;\n272\t    // `fileq->year = p->tm_year + 1900;` -- the C performs plain `int`\n273\t    // addition, which simply wraps on the target; `wrapping_add` keeps that\n274\t    // behaviour instead of panicking in an overflow-checked Rust build.\n275\t    (*fileq).year = (*p).tm_year.wrapping_add(1900);\n276\t    copy_month(fileq, (*p).tm_mon);\n277\t\n278\t    /* Get latest file */\n279\t    GetFile_Queue(fileq);\n280\t\n281\t    if Handle_Queue(fileq, 0) != 1 {\n282\t        file_sleep();\n283\t        return ptr::null_mut();\n284\t    }\n285\t\n286\t    /* Try up to timeout times to get an event */\n287\t    while i < timeout {\n288\t        al_data = GetAlertData((*fileq).flags, (*fileq).fp);\n289\t        if !al_data.is_null() {\n290\t            return al_data;\n291\t        }\n292\t\n293\t        i += 1;\n294\t        file_sleep();\n295\t    }\n296\t\n297\t    /* Return NULL if timeout expires */\n298\t    ptr::null_mut()\n299\t}\n300\t"}]},"parent_tool_use_id":"toolu_bdrk_011abv3A4WDsgFDgy5Pdqaiq","session_id":"dfdd5a05-e83a-434c-8b7c-5594ebbb8fbc"