{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017Th2cF2BMtsGcgT8aMyEMZ","type":"tool_result","content":"1\t/* Copyright (C) 2015, Wazuh Inc.\n2\t * Copyright (C) 2009 Trend Micro Inc.\n3\t * All right reserved.\n4\t *\n5\t * This program is free software; you can redistribute it\n6\t * and/or modify it under the terms of the GNU General Public\n7\t * License (version 2) as published by the FSF - Free Software\n8\t * Foundation\n9\t */\n10\t\n11\t/* File monitoring functions */\n12\t\n13\t#include \"file-queue.h\"\n14\t#include \"read-alert.h\"\n15\t\n16\t#include <stdio.h>\n17\t#include <string.h>\n18\t#include <sys/time.h>\n19\t#include <errno.h>\n20\t\n21\t#define FSTAT_ERROR   \"(1118): Could not retrieve information of file '%s' due to [(%d)-(%s)].\"\n22\t#define FSEEK_ERROR   \"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\"\n23\t\n24\tvoid merror(const char *err_template, const char *file_name, int err, const char *err_msg) {\n25\t    char buffer[256];\n26\t    snprintf(buffer, sizeof(buffer), err_template, file_name, err, err_msg);\n27\t    fprintf(stderr, \"%s\\n\", buffer);\n28\t}\n29\t\n30\tstatic void file_sleep(void);\n31\tstatic void GetFile_Queue(file_queue *fileq) __attribute__((nonnull));\n32\tstatic int Handle_Queue(file_queue *fileq, int flags) __attribute__((nonnull));\n33\t\n34\t/* To translate between month (int) to month (char) */\n35\tstatic const char *(s_month[]) = {\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n36\t                                  \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"\n37\t                                 };\n38\t\n39\t\n40\tstatic void file_sleep() {\n41\t\n42\t    struct timeval fp_timeout;\n43\t\n44\t    fp_timeout.tv_sec = FQ_TIMEOUT;\n45\t    fp_timeout.tv_usec = 0;\n46\t\n47\t    /* Wait for the select timeout */\n48\t    select(0, NULL, NULL, NULL, &fp_timeout);\n49\t\n50\t    return;\n51\t}\n52\t\n53\t/* Get the file queue for that specific hour */\n54\tstatic void GetFile_Queue(file_queue *fileq)\n55\t{\n56\t    /* Create the logfile name */\n57\t    fileq->file_name[0] = '\\0';\n58\t    fileq->file_name[MAX_FQUEUE] = '\\0';\n59\t\n60\t    snprintf(fileq->file_name, MAX_FQUEUE, \"%s\", fileq->flags & CRALERT_FP_SET ? \"<stdin>\" : ALERTS_DAILY);\n61\t}\n62\t\n63\t/* Re Handle the file queue */\n64\tstatic int Handle_Queue(file_queue *fileq, int flags)\n65\t{\n66\t    /* Close if it is open */\n67\t    if (!(flags & CRALERT_FP_SET)) {\n68\t        if (fileq->fp) {\n69\t            fclose(fileq->fp);\n70\t            fileq->fp = NULL;\n71\t        }\n72\t\n73\t        /* We must be able to open the file, fseek and get the\n74\t         * time of change from it.\n75\t         */\n76\t        fileq->fp = fopen(fileq->file_name, \"r\");\n77\t        if (!fileq->fp) {\n78\t            /* Queue not available */\n79\t            return (0);\n80\t        }\n81\t    }\n82\t\n83\t    /* Seek to the end of the file */\n84\t    if (!(flags & CRALERT_READ_ALL)) {\n85\t        if (!fileq->fp) {\n86\t            return (0);\n87\t        }\n88\t\n89\t        if (fseek(fileq->fp, 0, SEEK_END) < 0) {\n90\t            merror(FSEEK_ERROR, fileq->file_name, errno, strerror(errno));\n91\t            fclose(fileq->fp);\n92\t            fileq->fp = NULL;\n93\t            return (-1);\n94\t        }\n95\t    }\n96\t\n97\t    /* File change time */\n98\t    if (fileq->fp) {\n99\t        if (fstat(fileno(fileq->fp), &fileq->f_status) < 0) {\n100\t            merror(FSTAT_ERROR, fileq->file_name, errno, strerror(errno));\n101\t            fclose(fileq->fp);\n102\t            fileq->fp = NULL;\n103\t            return (-1);\n104\t        }\n105\t    }\n106\t\n107\t    fileq->last_change = fileq->f_status.st_mtime;\n108\t\n109\t    return (1);\n110\t}\n111\t\n112\t/* Initiates the file monitoring */\n113\tint Init_FileQueue(file_queue *fileq, const struct tm *p, int flags)\n114\t{\n115\t    /* Initialize file_queue fields */\n116\t    if (!(flags & CRALERT_FP_SET)) {\n117\t        fileq->fp = NULL;\n118\t    }\n119\t    fileq->last_change = 0;\n120\t    fileq->flags = 0;\n121\t\n122\t    fileq->day = p->tm_mday;\n123\t    fileq->year = p->tm_year + 1900;\n124\t\n125\t    strncpy(fileq->mon, s_month[p->tm_mon], 3);\n126\t    memset(fileq->file_name, '\\0', MAX_FQUEUE + 1);\n127\t\n128\t    /* Set the supplied flags */\n129\t    fileq->flags = flags;\n130\t\n131\t    /* Get latest file */\n132\t    GetFile_Queue(fileq);\n133\t\n134\t    /* Always seek to the end when starting the queue */\n135\t    if (Handle_Queue(fileq, fileq->flags) < 0) {\n136\t        return (-1);\n137\t    }\n138\t\n139\t    return (0);\n140\t}\n141\t\n142\t/* Reads from the monitored file */\n143\talert_data *Read_FileMon(file_queue *fileq, const struct tm *p, unsigned int timeout)\n144\t{\n145\t    unsigned int i = 0;\n146\t    alert_data *al_data;\n147\t\n148\t    /* If the file queue is not available, try to access it */\n149\t    if (!fileq->fp) {\n150\t        if (Handle_Queue(fileq, 0) != 1) {\n151\t            file_sleep();\n152\t            return (NULL);\n153\t        }\n154\t    }\n155\t\n156\t    if(!fileq->fp){\n157\t        return (NULL);\n158\t    }\n159\t\n160\t    if (al_data = GetAlertData(fileq->flags, fileq->fp), al_data) {\n161\t        return al_data;\n162\t    }\n163\t\n164\t    fileq->day = p->tm_mday;\n165\t    fileq->year = p->tm_year + 1900;\n166\t    strncpy(fileq->mon, s_month[p->tm_mon], 3);\n167\t\n168\t    /* Get latest file */\n169\t    GetFile_Queue(fileq);\n170\t\n171\t    if (Handle_Queue(fileq, 0) != 1) {\n172\t        file_sleep();\n173\t        return (NULL);\n174\t    }\n175\t\n176\t    /* Try up to timeout times to get an event */\n177\t    while (i < timeout) {\n178\t        al_data = GetAlertData(fileq->flags, fileq->fp);\n179\t        if (al_data) {\n180\t            return (al_data);\n181\t        }\n182\t\n183\t        i++;\n184\t        file_sleep();\n185\t    }\n186\t\n187\t    /* Return NULL if timeout expires */\n188\t    return (NULL);\n189\t}\n190\t"}]},"parent_tool_use_id":null,"session_id":"dfdd5a05-e83a-434c-8b7c-5594ebbb8fbc","uuid":"dbedf264-0797-47f7-8ec7-5f55d43a8a13","timestamp":"2026-08-27T07:41:26.869Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-ZzKDGm/c_src/src/file-queue.c","content":"/* Copyright (C) 2015, Wazuh Inc.\n * Copyright (C) 2009 Trend Micro Inc.\n * All right reserved.\n *\n * This program is free software; you can redistribute it\n * and/or modify it under the terms of the GNU General Public\n * License (version 2) as published by the FSF - Free Software\n * Foundation\n */\n\n/* File monitoring functions */\n\n#include \"file-queue.h\"\n#include \"read-alert.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <sys/time.h>\n#include <errno.h>\n\n#define FSTAT_ERROR   \"(1118): Could not retrieve information of file '%s' due to [(%d)-(%s)].\"\n#define FSEEK_ERROR   \"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\"\n\nvoid merror(const char *err_template, const char *file_name, int err, const char *err_msg) {\n    char buffer[256];\n    snprintf(buffer, sizeof(buffer), err_template, file_name, err, err_msg);\n    fprintf(stderr, \"%s\\n\", buffer);\n}\n\nstatic void file_sleep(void);\nstatic void GetFile_Queue(file_queue *fileq) __attribute__((nonnull));\nstatic int Handle_Queue(file_queue *fileq, int flags) __attribute__((nonnull));\n\n/* To translate between month (int) to month (char) */\nstatic const char *(s_month[]) = {\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n                                  \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"\n                                 };\n\n\nstatic void file_sleep() {\n\n    struct timeval fp_timeout;\n\n    fp_timeout.tv_sec = FQ_TIMEOUT;\n    fp_timeout.tv_usec = 0;\n\n    /* Wait for the select timeout */\n    select(0, NULL, NULL, NULL, &fp_timeout);\n\n    return;\n}\n\n/* Get the file queue for that specific hour */\nstatic void GetFile_Queue(file_queue *fileq)\n{\n    /* Create the logfile name */\n    fileq->file_name[0] = '\\0';\n    fileq->file_name[MAX_FQUEUE] = '\\0';\n\n    snprintf(fileq->file_name, MAX_FQUEUE, \"%s\", fileq->flags & CRALERT_FP_SET ? \"<stdin>\" : ALERTS_DAILY);\n}\n\n/* Re Handle the file queue */\nstatic int Handle_Queue(file_queue *fileq, int flags)\n{\n    /* Close if it is open */\n    if (!(flags & CRALERT_FP_SET)) {\n        if (fileq->fp) {\n            fclose(fileq->fp);\n            fileq->fp = NULL;\n        }\n\n        /* We must be able to open the file, fseek and get the\n         * time of change from it.\n         */\n        fileq->fp = fopen(fileq->file_name, \"r\");\n        if (!fileq->fp) {\n            /* Queue not available */\n            return (0);\n        }\n    }\n\n    /* Seek to the end of the file */\n    if (!(flags & CRALERT_READ_ALL)) {\n        if (!fileq->fp) {\n            return (0);\n        }\n\n        if (fseek(fileq->fp, 0, SEEK_END) < 0) {\n            merror(FSEEK_ERROR, fileq->file_name, errno, strerror(errno));\n            fclose(fileq->fp);\n            fileq->fp = NULL;\n            return (-1);\n        }\n    }\n\n    /* File change time */\n    if (fileq->fp) {\n        if (fstat(fileno(fileq->fp), &fileq->f_status) < 0) {\n            merror(FSTAT_ERROR, fileq->file_name, errno, strerror(errno));\n            fclose(fileq->fp);\n            fileq->fp = NULL;\n            return (-1);\n        }\n    }\n\n    fileq->last_change = fileq->f_status.st_mtime;\n\n    return (1);\n}\n\n/* Initiates the file monitoring */\nint Init_FileQueue(file_queue *fileq, const struct tm *p, int flags)\n{\n    /* Initialize file_queue fields */\n    if (!(flags & CRALERT_FP_SET)) {\n        fileq->fp = NULL;\n    }\n    fileq->last_change = 0;\n    fileq->flags = 0;\n\n    fileq->day = p->tm_mday;\n    fileq->year = p->tm_year + 1900;\n\n    strncpy(fileq->mon, s_month[p->tm_mon], 3);\n    memset(fileq->file_name, '\\0', MAX_FQUEUE + 1);\n\n    /* Set the supplied flags */\n    fileq->flags = flags;\n\n    /* Get latest file */\n    GetFile_Queue(fileq);\n\n    /* Always seek to the end when starting the queue */\n    if (Handle_Queue(fileq, fileq->flags) < 0) {\n        return (-1);\n    }\n\n    return (0);\n}\n\n/* Reads from the monitored file */\nalert_data *Read_FileMon(file_queue *fileq, const struct tm *p, unsigned int timeout)\n{\n    unsigned int i = 0;\n    alert_data *al_data;\n\n    /* If the file queue is not available, try to access it */\n    if (!fileq->fp) {\n        if (Handle_Queue(fileq, 0) != 1) {\n            file_sleep();\n            return (NULL);\n        }\n    }\n\n    if(!fileq->fp){\n        return (NULL);\n    }\n\n    if (al_data = GetAlertData(fileq->flags, fileq->fp), al_data) {\n        return al_data;\n    }\n\n    fileq->day = p->tm_mday;\n    fileq->year = p->tm_year + 1900;\n    strncpy(fileq->mon, s_month[p->tm_mon], 3);\n\n    /* Get latest file */\n    GetFile_Queue(fileq);\n\n    if (Handle_Queue(fileq, 0) != 1) {\n        file_sleep();\n        return (NULL);\n    }\n\n    /* Try up to timeout times to get an event */\n    while (i < timeout) {\n        al_data = GetAlertData(fileq->flags, fileq->fp);\n        if (al_data) {\n            return (al_data);\n        }\n\n        i++;\n        file_sleep();\n    }\n\n    /* Return NULL if timeout expires */\n    return (NULL);\n}\n","numLines":190,"startLine":1,"totalLines":190}}}
