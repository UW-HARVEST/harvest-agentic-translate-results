n    alert_data*a=drv(day,mon,yr,to,flags); printf(\"driver:\"); pra(a); printf(\"\\n\");\n  } else {\n    file_queue fq; memset(&fq,0,sizeof fq);\n    struct tm t; memset(&t,0,sizeof t); t.tm_mday=day;t.tm_mon=mon;t.tm_year=yr;\n    int r=init(&fq,&t,flags);\n    printf(\"init=%d year=%d day=%d flags=%d mon=%02x%02x%02x%02x name=<%s> fp?%d lc_set?%d\\n\",\n      r,fq.year,fq.day,fq.flags,(unsigned char)fq.mon[0],(unsigned char)fq.mon[1],\n      (unsigned char)fq.mon[2],(unsigned char)fq.mon[3],fq.file_name,fq.fp!=NULL,fq.last_change!=0);\n    if(r>=0){ alert_data*a=rfm(&fq,&t,to); printf(\"rfm:\"); pra(a);\n      printf(\" | year=%d day=%d mon=%02x%02x%02x%02x name=<%s> fp?%d\\n\",fq.year,fq.day,\n       (unsigned char)fq.mon[0],(unsigned char)fq.mon[1],(unsigned char)fq.mon[2],(unsigned char)fq.mon[3],fq.file_name,fq.fp!=NULL); }\n    if(fq.fp) fclose(fq.fp);\n  }\n  fflush(stdout); return 0; }\nEOF\ngcc -O0 -o \"$D/fq\" \"$D/fq.c\" -ldl\nQ=\"'\"\ncd \"$D\"\nprintf \"** Alert 1234.5: mail  - syscheck,\\n2006 Apr 13 16:15:17 /var/log/auth.log\\nRule: 550 (level 7) -> ${Q}Integrity changed${Q}\\nSrc IP: 1.2.3.4\\nSrc Port: 22\\nDst IP: 5.6.7.8\\nDst Port: 80\\nUser: root\\nIntegrity checksum changed for: ${Q}/etc/passwd${Q}\\n** Alert 2: mail - g\\nd2: l2\\nRule: 1 a b ${Q}z${Q}\\n\" > alerts.log\nC=/local/home/scheschb/.harvest/work/harvest-work-ZzKDGm/c_src/build/libdriver.so\nR=/local/home/scheschb/.harvest/work/harvest-work-ZzKDGm/translation/target/debug/libdriver.so\ndiffs=0\nfor mode in 0 1; do\nfor day in 0 1 31; do\nfor mon in 0 3 11; do\nfor yr in -1900 0 70 125 2147483647; do\nfor flags in 0 1 4 5 16 17 20 21 8 2; do\n  co=$(\"$D/fq\" $C $mode $day $mon $yr 0 $flags 2>&1); cs=$?\n  ro=$(\"$D/fq\" $R $mode $day $mon $yr 0 $flags 2>&1); rs=$?\n  if [ \"$co\" != \"$ro\" ] || [ \"$cs\" != \"$rs\" ]; then\n    diffs=$((diffs+1))\n    echo \"=== DIFF mode=$mode day=$day mon=$mon yr=$yr flags=$flags Cexit=$cs Rexit=$rs\"\n    echo \" C: $(echo \"$co\"|tr '\\n' '