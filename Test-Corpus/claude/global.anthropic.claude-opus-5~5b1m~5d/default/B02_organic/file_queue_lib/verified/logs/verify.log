{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01J9S9TGrnFCaYtNRPVWBPdp","type":"tool_result","content":"1\t//! Translation of `c_src/include/shared.h`.\n2\t//!\n3\t//! The header defines (not just declares) `os_calloc`, `os_realloc` and\n4\t//! `os_strdup` with external linkage, so the shared object exports them.\n5\t\n6\tuse core::ffi::{c_char, c_void};\n7\t\n8\tuse crate::cbind::*;\n9\t\n10\t/// `#define OS_MAXSTR 1024`\n11\tpub const OS_MAXSTR: usize = 1024;\n12\t\n13\t/// `#define os_free(x) if(x){free(x);x=NULL;};`\n14\t///\n15\t/// Takes a mutable place expression holding a `*mut T`.\n16\tmacro_rules! os_free {\n17\t    ($x:expr) => {{\n18\t        if !$x.is_null() {\n19\t            $crate::cbind::free($x as *mut core::ffi::c_void);\n20\t            $x = core::ptr::null_mut();\n21\t        }\n22\t    }};\n23\t}\n24\t\n25\t/// `#define os_clearnl(x,p) if((p = strrchr(x, '\\n')))*p = '\\0';`\n26\tmacro_rules! os_clearnl {\n27\t    ($x:expr, $p:expr) => {{\n28\t        $p = $crate::cbind::strrchr($x, b'\\n' as core::ffi::c_int);\n29\t        if !$p.is_null() {\n30\t            *$p = 0;\n31\t        }\n32\t    }};\n33\t}\n34\t\n35\tpub(crate) use os_clearnl;\n36\tpub(crate) use os_free;\n37\t\n38\t/// ```c\n39\t/// void *os_calloc(size_t num, size_t size)\n40\t/// ```\n41\t#[allow(non_snake_case)]\n42\t#[unsafe(no_mangle)]\n43\tpub unsafe extern \"C\" fn os_calloc(num: usize, size: usize) -> *mut c_void {\n44\t    let out = calloc(num, size);\n45\t    if out.is_null() {\n46\t        fprintf(stderr, cs(b\"Memory allocation failed in os_calloc\\0\"));\n47\t        exit(EXIT_FAILURE);\n48\t    }\n49\t    out\n50\t}\n51\t\n52\t/// ```c\n53\t/// void *os_realloc(void *ptr, size_t new_size)\n54\t/// ```\n55\t#[allow(non_snake_case)]\n56\t#[unsafe(no_mangle)]\n57\tpub unsafe extern \"C\" fn os_realloc(ptr: *mut c_void, new_size: usize) -> *mut c_void {\n58\t    let out = realloc(ptr, new_size);\n59\t    if out.is_null() {\n60\t        fprintf(stderr, cs(b\"Memory allocation failed in os_realloc\\0\"));\n61\t        exit(EXIT_FAILURE);\n62\t    }\n63\t    out\n64\t}\n65\t\n66\t/// ```c\n67\t/// char *os_strdup(const char *str)\n68\t/// ```\n69\t#[allow(non_snake_case)]\n70\t#[unsafe(no_mangle)]\n71\tpub unsafe extern \"C\" fn os_strdup(str_: *const c_char) -> *mut c_char {\n72\t    if str_.is_null() {\n73\t        fprintf(stderr, cs(b\"NULL string passed to os_strdup\\0\"));\n74\t        exit(EXIT_FAILURE);\n75\t    }\n76\t    let dup = strdup(str_);\n77\t    if dup.is_null() {\n78\t        fprintf(stderr, cs(b\"Memory allocation failed in os_strdup\\0\"));\n79\t        exit(EXIT_FAILURE);\n80\t    }\n81\t    dup\n82\t}\n83\t"}]},"parent_tool_use_id":"toolu_bdrk_011abv3A4WDsgFDgy5Pdqaiq","session_id":"dfdd5a05-e83a-434c-8b7c-5594ebbb8fbc","uuid":"f0532f6c-bca7-4a81-92a1-110f4dad9fed","timestamp":"2026-08-27T08:23:18.656Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust semantic parity"}
