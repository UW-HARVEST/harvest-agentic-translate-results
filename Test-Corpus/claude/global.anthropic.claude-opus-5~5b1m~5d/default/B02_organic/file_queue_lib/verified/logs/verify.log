/* ---------------------------------------------------------------- */\n59\t/* read-alert.c preprocessor constants                              */\n60\t/* ---------------------------------------------------------------- */\n61\t\n62\tconst ALERT_BEGIN: &[u8] = b\"** Alert\\0\";\n63\tconst ALERT_BEGIN_SZ: usize = 8;\n64\tconst RULE_BEGIN: &[u8] = b\"Rule: \\0\";\n65\tconst RULE_BEGIN_SZ: usize = 6;\n66\tconst SRCIP_BEGIN: &[u8] = b\"Src IP: \\0\";\n67\tconst SRCIP_BEGIN_SZ: usize = 8;\n68\tconst SRCPORT_BEGIN: &[u8] = b\"Src Port: \\0\";\n69\tconst SRCPORT_BEGIN_SZ: usize = 10;\n70\tconst DSTIP_BEGIN: &[u8] = b\"Dst IP: \\0\";\n71\tconst DSTIP_BEGIN_SZ: usize = 8;\n72\tconst DSTPORT_BEGIN: &[u8] = b\"Dst Port: \\0\";\n73\tconst DSTPORT_BEGIN_SZ: usize = 10;\n74\tconst USER_BEGIN: &[u8] = b\"User: \\0\";\n75\tconst USER_BEGIN_SZ: usize = 6;\n76\tconst ALERT_MAIL: &[u8] = b\"mail\\0\";\n77\tconst ALERT_MAIL_SZ: usize = 4;\n78\t\n79\t// The remaining *_BEGIN macros of the original file are unused by the code.\n80\t#[allow(dead_code)]\n81\tmod unused_macros {\n82\t    pub const OLDMD5_BEGIN: &[u8] = b\"Old md5sum was: \\0\";\n83\t    pub const OLDMD5_BEGIN_SZ: usize = 16;\n84\t    pub const NEWMD5_BEGIN: &[u8] = b\"New md5sum is : \\0\";\n85\t    pub const NEWMD5_BEGIN_SZ: usize = 16;\n86\t    pub const OLDSHA1_BEGIN: &[u8] = b\"Old sha1sum was: \\0\";\n87\t    pub const OLDSHA1_BEGIN_SZ: usize = 17;\n88\t    pub const NEWSHA1_BEGIN: &[u8] = b\"New sha1sum is : \\0\";\n89\t    pub const NEWSHA1_BEGIN_SZ: usize = 17;\n90\t    pub const OLDSHA256_BEGIN: &[u8] = b\"Old sha256sum was: \\0\";\n91\t    pub const OLDSHA256_BEGIN_SZ: usize = 19;\n92\t    pub const NEWSHA256_BEGIN: &[u8] = b\"New sha256sum is : \\0\";\n93\t    pub const NEWSHA256_BEGIN_SZ: usize = 19;\n94\t    pub const SIZE_BEGIN: &[u8] = b\"Size changed from \\0\";\n95\t    pub const SIZE_BEGIN_SZ: usize = 18;\n96\t    pub const OWNER_BEGIN: &[u8] = b\"Ownership was \\0\";\n97\t    pub const OWNER_BEGIN_SZ: usize = 14;\n98\t    pub const GROUP_BEGIN: &[u8] = b\"Group ownership was \\0\";\n99\t    pub const GROUP_BEGIN_SZ: usize = 20;\n100\t    pub const PERM_BEGIN: &[u8] = b\"Permissions changed from \\0\";\n101\t    pub const PERM_BEGIN_SZ: usize = 25;\n102\t}\n103\t\n104\tconst LOG_LIMIT: usize = 100;\n105\t\n106\tconst INTEGRITY_PREFIX: &[u8] = b\"Integrity checksum changed for: '\\0\";\n107\tconst INTEGRITY_PREFIX_SZ: usize = 33;\n108\t\n109\t/* ---------------------------------------------------------------- */\n110\t\n111\t/// ```c\n112\t/// void FreeAlertData(alert_data *al_data)\n113\t/// ```\n114\t#[allow(non_snake_case)]\n115\t#[unsafe(no_mangle)]\n116\tpub unsafe extern \"C\" fn FreeAlertData(al_data: *mut alert_data) {\n117\t    // `char **p;` in the original is unused.\n118\t\n119\t    os_free!((*al_data).alertid);\n120\t    os_free!((*al_data).date);\n121\t    os_free!((*al_data).location);\n122\t    os_free!((*al_data).comment);\n123\t    os_free!((*al_data).group);\n124\t    os_free!((*al_data).srcip);\n125\t    os_free!((*al_data).dstip);\n126\t    os_free!((*al_data).user);\n127\t    os_free!((*al_data).filename);\n128\t\n129\t    /* \"9/19/2016 - Sivakumar Nellurandi - parsing additions\" */\n130\t    // The `al_data->log` cleanup is commented out in the original.\n131\t\n132\t    // al_data can't be NULL\n133\t    free(al_data as *mut c_void);\n134\t    // `al_data = NULL;` -- assignment to the local parameter, no effect.\n135\t}\n136\t\n137\t/// ```c\n138\t/// alert_data *GetAlertData(int flag, FILE *fp)\n139\t/// ```\n140\t#[allow(non_snake_case)]\n141\t#[allow(unused_assignments)]\n142\t#[unsafe(no_mangle)]\n143\tpub unsafe extern \"C\" fn GetAlertData(flag: c_int, fp: *mut FILE) -> *mut alert_data {\n144\t    let al_data: *mut alert_data =\n145\t        os_calloc(1, core::mem::size_of::<alert_data>()) as *mut alert_data;\n146\t\n147\t    let mut _r: c_int = 0;\n148\t    let mut issyscheck: c_int = 0;\n149\t    let mut log_size: usize = 0;\n150\t    let mut p: *mut c_char;\n151\t    // `char str[OS_MAXSTR + 1]; str[OS_MAXSTR] = '\\0';`\n152\t    let mut str_buf = [0 as c_char; OS_MAXSTR + 1];\n153\t    let str = str_buf.as_mut_ptr();\n154\t    *str.add(OS_MAXSTR) = 0;\n155\t\n156\t    'l_error: {\n157\t        while !fgets(str, OS_MAXSTR as c_int, fp).is_null() {\n158\t            /* End of alert */\n159\t            if strncmp(cs(ALERT_BEGIN), str, ALERT_BEGIN_SZ) == 0 {\n160\t                let m: *mut c_char;\n161\t                let z: usize;\n162\t\n163\t                /* End of the alert. */\n164\t                if _r == 2 {\n165\t                    // `fseek(fp, -strlen(str), SEEK_CUR)`: the negated size_t\n166\t                    // is converted to `long`, which yields -(long)strlen(str).\n167\t                    let off = (0usize.wrapping_sub(strlen(str))) as c_long;\n168\t                    if fseek(fp, off, SEEK_CUR) != -1 {\n169\t                        return al_data;\n170\t                    } else {\n171\t                        break 'l_error;\n172\t                    }\n173\t                }\n174\t\n175\t                p = str.add(ALERT_BEGIN_SZ + 1);\n176\t\n177\t                m = strstr(p, cs(b\":\\0\"));\n178\t                if m.is_null() {\n179\t                    continue;\n180\t                }\n181\t\n182\t                z = strlen(p) - strlen(m);\n183\t                (*al_data).alertid = os_realloc(\n184\t                    (*al_data).alertid as *mut c_void,\n185\t                    (z + 1) * core::mem::size_of::<c_char>(),\n186\t                ) as *mut c_char;\n187\t                strncpy((*al_data).alertid, p, z);\n188\t                *(*al_data).alertid.add(z) = 0;\n189\t\n190\t                /* Search for email flag */\n191\t                p = strchr(p, b' ' as c_int);\n192\t                if p.is_null() {\n193\t                    continue;\n194\t                }\n195\t\n196\t                p = p.add(1);\n197\t\n198\t                /* Check for the flags */\n199\t                if (flag & CRALERT_MAIL_SET) != 0\n200\t                    && strncmp(cs(ALERT_MAIL), p, ALERT_MAIL_SZ) != 0\n201\t                {\n202\t                    continue;\n203\t                }\n204\t\n205\t                p = strchr(p, b'-' as c_int);\n206\t                if !p.is_null() {\n207\t                    p = p.add(1);\n208\t                    /* Skip leading spaces */\n209\t                    while *p == b' ' as c_char {\n210\t                        p = p.add(1);\n211\t                    }\n212\t                    os_free!((*al_data).group);\n213\t                    (*al_data).group = os_strdup(p);\n214\t\n215\t                    /* Clean newline from group */\n216\t                    os_clearnl!((*al_data).group, p);\n217\t                    if !(*al_data).group.is_null()\n218\t                        && !strstr((*al_data).group, cs(b\"syscheck\\0\")).is_null()\n219\t                    {\n220\t                        issyscheck = 1;\n221\t                    }\n222\t                }\n223\t\n224\t                /* Search for active-response flag */\n225\t                _r = 1;\n226\t                continue;\n227\t            }\n228\t\n229\t            if _r < 1 {\n230\t                continue;\n231\t            }\n232\t\n233\t            /*** Extract information from the event ***/\n234\t\n235\t            /* r1 means: 2006 Apr 13 16:15:17 /var/log/auth.log */\n236\t            if _r == 1 {\n237\t                /* Clear newline */\n238\t                os_clearnl!(str, p);\n239\t\n240\t                p = strchr(str, b':' as c_int);\n241\t                if !p.is_null() {\n242\t                    p = strchr(p, b' ' as c_int);\n243\t                    if !p.is_null() {\n244\t                        *p = 0;\n245\t                        p = p.add(1);\n246\t                    } else {\n247\t                        /* If p is null it is because strchr failed */\n248\t                        perror(cs(b\"date of location not NULL\\0\"));\n249\t                        break 'l_error;\n250\t                    }\n251\t                }\n252\t\n253\t                /* If not, str is date and p is the location */\n254\t                if !(*al_data).date.is_null() || !(*al_data).location.is_null() || p.is_null() {\n255\t                    perror(cs(b\"date or location not NULL or p is NULL\\0\"));\n256\t                    break 'l_error;\n257\t                }\n258\t\n259\t                (*al_data).date = os_strdup(str);\n260\t                (*al_data).location = os_strdup(p);\n261\t                _r = 2;\n262\t                log_size = 0;\n263\t                continue;\n264\t            } else if _r == 2 {\n265\t                /* Rule begin */\n266\t                if strncmp(cs(RULE_BEGIN), str, RULE_BEGIN_SZ) == 0 {\n267\t                    os_clearnl!(str, p);\n268\t\n269\t                    p = str.add(RULE_BEGIN_SZ);\n270\t                    (*al_data).rule = atoi(p) as c_uint;\n271\t\n272\t                    p = strchr(p, b' ' as c_int);\n273\t                    if !p.is_null() {\n274\t                        p = p.add(1);\n275\t                        p = strchr(p, b' ' as c_int);\n276\t                        if !p.is_null() {\n277\t                            p = p.add(1);\n278\t                        }\n279\t                    }\n280\t\n281\t                    if p.is_null() {\n282\t                        break 'l_error;\n283\t                    }\n284\t\n285\t                    (*al_data).level = atoi(p) as c_uint;\n286\t\n287\t                    /* Get the comment */\n288\t                    p = strchr(p, b'\\'' as c_int);\n289\t                    if p.is_null() {\n290\t                        break 'l_error;\n291\t                    }\n292\t\n293\t                    p = p.add(1);\n294\t                    os_free!((*al_data).comment);\n295\t                    (*al_data).comment = os_strdup(p);\n296\t\n297\t                    /* Must have the closing \\' */\n298\t                    p = strrchr((*al_data).comment, b'\\'' as c_int);\n299\t                    if !p.is_null() {\n300\t                        *p = 0;\n301\t                    } else {\n302\t                        break 'l_error;\n303\t                    }\n304\t                }\n305\t                /* srcip */\n306\t                else if strncmp(cs(SRCIP_BEGIN), str, SRCIP_BEGIN_SZ) == 0 {\n307\t                    os_clearnl!(str, p);\n308\t\n309\t                    p = str.add(SRCIP_BEGIN_SZ);\n310\t                    os_free!((*al_data).srcip);\n311\t                    (*al_data).srcip = os_strdup(p);\n312\t                }\n313\t                /* srcport */\n314\t                else if strncmp(cs(SRCPORT_BEGIN), str, SRCPORT_BEGIN_SZ) == 0 {\n315\t                    os_clearnl!(str, p);\n316\t\n317\t                    p = str.add(SRCPORT_BEGIN_SZ);\n318\t                    (*al_data).srcport = atoi(p);\n319\t                }\n320\t                /* dstip */\n321\t                else if strncmp(cs(DSTIP_BEGIN), str, DSTIP_BEGIN_SZ) == 0 {\n322\t                    os_clearnl!(str, p);\n323\t\n324\t                    p = str.add(DSTIP_BEGIN_SZ);\n325\t                    os_free!((*al_data).dstip);\n326\t                    (*al_data).dstip = os_strdup(p);\n327\t                }\n328\t                /* dstport */\n329\t                else if strncmp(cs(DSTPORT_BEGIN), str, DSTPORT_BEGIN_SZ) == 0 {\n330\t                    os_clearnl!(str, p);\n331\t\n332\t                    p = str.add(DSTPORT_BEGIN_SZ);\n333\t                    (*al_data).dstport = atoi(p);\n334\t                }\n335\t                /* username */\n336\t                else if strncmp(cs(USER_BEGIN), str, USER_BEGIN_SZ) == 0 {\n337\t                    os_clearnl!(str, p);\n338\t\n339\t                    p = str.add(USER_BEGIN_SZ);\n340\t                    os_free!((*al_data).user);\n341\t                    (*al_data).user = os_strdup(p);\n342\t                }\n343\t                /* \"9/19/2016 - Sivakumar Nellurandi - parsing additions\" */\n344\t                /* It is a log message */\n345\t                else if log_size < LOG_LIMIT {\n346\t                    os_clearnl!(str, p);\n347\t                    if issyscheck == 1 {\n348\t                        if strncmp(str, cs(INTEGRITY_PREFIX), INTEGRITY_PREFIX_SZ) == 0 {\n349\t                            (*al_data).filename = strdup(str.add(INTEGRITY_PREFIX_SZ));\n350\t                            if !(*al_data).filename.is_null() {\n351\t                                let f = (*al_data).filename;\n352\t                                // Faithful reproduction of the original\n353\t                                // `filename[strlen(filename) - 1] = '\\0';`\n354\t                                // (underflows by one byte for an empty name).\n355\t                                *f.wrapping_add(strlen(f).wrapping_sub(1)) = 0;\n356\t                            }\n357\t                        }\n358\t                        issyscheck = 0;\n359\t                    }\n360\t\n361\t                    // al_data->log bookkeeping is commented out upstream.\n362\t                }\n363\t            }\n364\t        }\n365\t\n366\t        // We reached the end of the alert and the information is saved.\n367\t        if feof(fp) != 0 && _r == 2 {\n368\t            return al_data;\n369\t        }\n370\t    }\n371\t\n372\t    /* l_error: */\n373\t    /* Free the memory */\n374\t    FreeAlertData(al_data);\n375\t    /* We need to clean end of file before returning */\n376\t    clearerr(fp);\n377\t    ptr::null_mut()\n378\t}\n379\t"}]},"parent_tool_use_id":null,"session_id":"dfdd5a05-e83a-434c-8b7c-5594ebbb8fbc","uuid":"4367e79e-ac98-439b-9105-18c1c7517f80","timestamp":"2026-08-27T07:41:40.378Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-ZzKDGm/translation/src/read_alert.rs","content":"//! Tr