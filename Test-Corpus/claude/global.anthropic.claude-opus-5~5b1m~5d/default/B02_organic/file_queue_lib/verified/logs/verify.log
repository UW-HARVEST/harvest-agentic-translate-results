intf(stderr, cs(b\"Memory allocation failed in os_realloc\\0\"));\n61\t        exit(EXIT_FAILURE);\n62\t    }\n63\t    out\n64\t}\n65\t\n66\t/// ```c\n67\t/// char *os_strdup(const char *str)\n68\t/// ```\n69\t#[allow(non_snake_case)]\n70\t#[unsafe(no_mangle)]\n71\tpub unsafe extern \"C\" fn os_strdup(str_: *const c_char) -> *mut c_char {\n72\t    if str_.is_null() {\n73\t        fprintf(stderr, cs(b\"NULL string passed to os_strdup\\0\"));\n74\t        exit(EXIT_FAILURE);\n75\t    }\n76\t    let dup = strdup(str_);\n77\t    if dup.is_null() {\n78\t        fprintf(stderr, cs(b\"Memory allocation failed in os_strdup\\0\"));\n79\t        exit(EXIT_FAILURE);\n80\t    }\n81\t    dup\n82\t}\n83\t"}]},"parent_tool_use_id":null,"session_id":"dfdd5a05-e83a-434c-8b7c-5594ebbb8fbc","uuid":"91da7795-804d-40ac-bd59-5ef353959fc6","timestamp":"2026-08-27T07:41:35.076Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-ZzKDGm/translation/src/shared.rs","content":"//! Translation of `c_src/include/shared.h`.\n//!\n//! The header defines (not just declares) `os_calloc`, `os_realloc` and\n//! `os_strdup` with external linkage, so the shared object exports them.\n\nuse core::ffi::{c_char, c_void};\n\nuse crate::cbind::*;\n\n/// `#define OS_MAXSTR 1024`\npub const OS_MAXSTR: usize = 1024;\n\n/// `#define os_free(x) if(x){free(x);x=NULL;};`\n///\n/// Takes a mutable place expression holding a `*mut T`.\nmacro_rules! os_free {\n    ($x:expr) => {{\n        if !$x.is_null() {\n            $crate::cbind::free($x as *mut core::ffi::c_void);\n            $x = core::ptr::null_mut();\n        }\n    }};\n}\n\n/// `#define os_clearnl(x,p) if((p = strrchr(x, '\\n')))*p = '\\0';`\nmacro_rules! os_clearnl {\n    ($x:expr, $p:expr) => {{\n        $p = $crate::cbind::strrchr($x, b'\\n' as core::ffi::c_int);\n        if !$p.is_null() {\n            *$p = 0;\n        }\n    }};\n}\n\npub(crate) use os_clearnl;\npub(crate) use os_free;\n\n/// ```c\n///