{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DbwC9NxFZGMaVVU7aCaDSE","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! Public ABI reproduced exactly (see `nm -D` on the C `libdriver.so`):\n4\t//!   * `get_os_arch`\n5\t//!   * `w_regexec`\n6\t//!   * `parse_uname_string`\n7\t//!\n8\t//! The original C code performs in-place mutation of caller-owned strings and\n9\t//! returns `malloc`-allocated buffers that the caller must `free`, so the libc\n10\t//! routines it used (`malloc`, `strdup`, `strstr`, `strlen`, `snprintf`,\n11\t//! `free`, `regcomp`, `regexec`, `regfree`, `fprintf`) are reused verbatim.\n12\t//! This guarantees byte-identical output (including POSIX regex semantics and\n13\t//! the exact allocator the caller frees with) and reproduces every quirk of the\n14\t//! original, bugs included.\n15\t\n16\t#![allow(non_camel_case_types)]\n17\t#![allow(clippy::missing_safety_doc)]\n18\t\n19\tuse core::ffi::{c_char, c_int, c_void};\n20\t\n21\t// ---------------------------------------------------------------------------\n22\t// libc / POSIX regex bindings\n23\t// ---------------------------------------------------------------------------\n24\t\n25\t/// `regmatch_t` from `<regex.h>`: two `regoff_t` (== `int` on glibc) fields.\n26\t#[repr(C)]\n27\t#[derive(Clone, Copy)]\n28\tpub struct regmatch_t {\n29\t    pub rm_so: c_int,\n30\t    pub rm_eo: c_int,\n31\t}\n32\t\n33\t/// Opaque, over-sized stand-in for glibc's `regex_t` (64 bytes on x86_64).\n34\t/// Extra tail padding is harmless: `regcomp` only touches the real fields.\n35\t#[repr(C, align(16))]\n36\tstruct regex_t {\n37\t    _opaque: [u8; 128],\n38\t}\n39\t\n40\timpl regex_t {\n41\t    #[inline]\n42\t    fn new() -> Self {\n43\t        regex_t { _opaque: [0u8; 128] }\n44\t    }\n45\t    #[inline]\n46\t    fn as_ptr(&mut self) -> *mut c_void {\n47\t        self as *mut regex_t as *mut c_void\n48\t    }\n49\t}\n50\t\n51\t/// `REG_EXTENDED` from `<regex.h>`.\n52\tconst REG_EXTENDED: c_int = 1;\n53\t\n54\tunsafe extern \"C\" {\n55\t    fn malloc(size: usize) -> *mut c_void;\n56\t    fn free(ptr: *mut c_void);\n57\t    fn strdup(s: *const c_char) -> *mut c_char;\n58\t    fn strlen(s: *const c_char) -> usize;\n59\t    fn strstr(haystack: *const c_char, needle: *const c_char) -> *mut c_char;\n60\t    fn snprintf(s: *mut c_char, n: usize, fmt: *const c_char, ...) -> c_int;\n61\t    fn fprintf(stream: *mut c_void, fmt: *const c_char, ...) -> c_int;\n62\t\n63\t    fn regcomp(preg: *mut c_void, pattern: *const c_char, cflags: c_int) -> c_int;\n64\t    fn regexec(\n65\t        preg: *const c_void,\n66\t        string: *const c_char,\n67\t        nmatch: usize,\n68\t        pmatch: *mut regmatch_t,\n69\t        eflags: c_int,\n70\t    ) -> c_int;\n71\t    fn regfree(preg: *mut c_void);\n72\t\n73\t    static mut stderr: *mut c_void;\n74\t}\n75\t\n76\t// ---------------------------------------------------------------------------\n77\t// Public types (from include/lib.h)\n78\t// ---------------------------------------------------------------------------\n79\t\n80\t/// `typedef struct os_data { ... } os_data;` from `include/lib.h`.\n81\t#[repr(C)]\n82\tpub struct os_data {\n83\t    pub os_name: *mut c_char,\n84\t    pub os_version: *mut c_char,\n85\t    pub os_major: *mut c_char,\n86\t    pub os_minor: *mut c_char,\n87\t    pub os_codename: *mut c_char,\n88\t    pub os_platform: *mut c_char,\n89\t    pub os_build: *mut c_char,\n90\t    pub os_uname: *mut c_char,\n91\t    pub os_arch: *mut c_char,\n92\t}\n93\t\n94\t// ---------------------------------------------------------------------------\n95\t// Helpers\n96\t// ---------------------------------------------------------------------------\n97\t\n98\t/// Reproduces the C expression `*(p + strlen(p) - 1) = '\\0';`.\n99\t///\n100\t/// Note: when `p` points at an empty string the C code writes one byte *before*\n101\t/// the buffer. That (buggy) behaviour 