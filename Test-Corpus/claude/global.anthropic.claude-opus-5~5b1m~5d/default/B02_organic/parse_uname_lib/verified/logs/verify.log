.as_ptr()|c\"!\".as_ptr()'\n  'osd_null_guard_removed|    if osd.is_null() {\\n        return;\\n    }|    if false {\\n        return;\\n    }'\n)\n\npass=0; caught=0; survived=0; skipped=0\nfor m in \"${MUTANTS[@]}\"; do\n  name=${m%%|*}; rest=${m#*|}; old=${rest%%|*}; new=${rest#*|}\n  cp \"$BACKUP\" \"$SRC\"\n  if ! perl -0777 -pe \"BEGIN{\\$o=qq{$old}; \\$n=qq{$new}} \\$c += (\\$_ =~ s/\\Q\\$o\\E/\\$n/); END{exit(\\$c?0:1)}\" \\\n        -i \"$SRC\" 2>/dev/null; then\n    echo \"SKIP     $name  (pattern not found in $SRC)\"\n    skipped=$((skipped+1)); continue\n  fi\n  if ! cargo build --offline >/dev/null 2>&1; then\n    echo \"SKIP     $name  (mutant does not compile)\"\n    skipped=$((skipped+1)); continue\n  fi\n  if timeout 600 cargo test --offline -q >/dev/null 2>&1; then\n    echo \"SURVIVED $name  <-- tests did NOT detect this bug\"\n    survived=$((survived+1))\n  else\n    echo \"CAUGHT   $name\"\n    caught=$((caught+1))\n  fi\ndone\n\ncp \"$BACKUP\" \"$SRC\"\ncargo build --offline >/dev/null 2>&1\necho\necho \"caught=$caught survived=$survived skipped=$skipped\"\n[ \"$survived\" -eq 0 ] || exit 1\n[ \"$caught\" -gt 0 ] || exit 1\necho \"OK: every applicable mutant was detected by the differential suite.\"\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5779,"cache_read_input_tokens":117336,"cache_creation":{"ephemeral_5m_input_tokens":5779,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"22b379f9-876d-41fe-b19f-bdcb2c5959be","uuid":"8ce49346-b45c-4d10-9745-54baaf7138ac","timestamp":"2026-08-27T13:37:52.719Z"}
