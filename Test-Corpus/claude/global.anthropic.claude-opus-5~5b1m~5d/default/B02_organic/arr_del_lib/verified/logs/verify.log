len = strlen(str)+1;\n885\t  if (len > a->remaining) {\n886\t    size_t blocksize = a->block;\n887\t\n888\t    blocksize = (size_t) (STBDS_STRING_ARENA_BLOCKSIZE_MIN) << (blocksize>>1);\n889\t\n890\t    if (blocksize < (size_t)(STBDS_STRING_ARENA_BLOCKSIZE_MAX))\n891\t      ++a->block;\n892\t\n893\t    if (len > blocksize) {\n894\t      stbds_string_block *sb = (stbds_string_block *) STBDS_REALLOC(NULL, 0, sizeof(*sb)-8 + len);\n895\t      memmove(sb->storage, str, len);\n896\t      if (a->storage) {\n897\t        sb->next = a->storage->next;\n898\t        a->storage->next = sb;\n899\t      } else {\n900\t        sb->next = 0;\n901\t        a->storage = sb;\n902\t        a->remaining = 0;\n903\t      }\n904\t      return sb->storage;\n905\t    } else {\n906\t      stbds_string_block *sb = (stbds_string_block *) STBDS_REALLOC(NULL, 0, sizeof(*sb)-8 + blocksize);\n907\t      sb->next = a->storage;\n908\t      a->storage = sb;\n909\t      a->remaining = blocksize;\n910\t    }\n911\t  }\n912\t\n913\t  STBDS_ASSERT(len <= a->remaining);\n914\t  p = a->storage->storage + a->remaining - len;\n915\t  a->remaining -= len;\n916\t  memmove(p, str, len);\n917\t  return p;\n918\t}\n919\t\n920\tvoid stbds_strreset(stbds_string_arena *a)\n921\t{\n922\t  stbds_string_block *x,*y;\n923\t  x = a->storage;\n924\t  while (x) {\n925\t    y = x->next;\n926\t    STBDS_FREE(NULL, x);\n927\t    x = y;\n928\t  }\n929\t  memset(a, 0, sizeof(*a));\n930\t}\n931\t\n932\t#include <stdio.h>\n933\t#include <assert.h>\n934\t\n935\ttypedef struct { int key,b,c,d; } stbds_struct;\n936\ttypedef struct { int key[2],b,c,d; } stbds_struct2;\n937\t\n938\tstatic char buffer[256];\n939\tchar *strkey(int n)\n940\t{\n941\t   sprintf(buffer, \"test_%d\", n);\n942\t   return buffer;\n943\t}\n944\t\n945\tvoid arr_del(int num)\n946\t{\n947\t  int *arr=NULL;\n948\t  int i,j;\n949\t\n950\t  for (i=0; i < 4; ++i) {\n951\t    arrpush(arr,num); arrpush(arr,2); arrpush(arr,3); arrpush(arr,4);\n952\t    arrdel(arr,i);\n9