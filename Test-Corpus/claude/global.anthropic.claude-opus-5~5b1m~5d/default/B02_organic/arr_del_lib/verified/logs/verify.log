SHIFT);\n671\t\n672\t            let mut i = pos & STBDS_BUCKET_MASK;\n673\t            while i < STBDS_BUCKET_LENGTH {\n674\t                if (*bucket).hash[i] == hash {\n675\t                    if stbds_is_key_equal(\n676\t                        a,\n677\t                        elemsize,\n678\t                        key,\n679\t                        keysize,\n680\t                        keyoffset,\n681\t                        mode,\n682\t                        (*bucket).index[i] as usize,\n683\t                    ) != 0\n684\t                    {\n685\t                        return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n686\t                    }\n687\t                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n688\t                    return -1;\n689\t                }\n690\t                i += 1;\n691\t            }\n692\t\n693\t            let limit = pos & STBDS_BUCKET_MASK;\n694\t            let mut i: usize = 0;\n695\t            while i < limit {\n696\t                if (*bucket).hash[i] == hash {\n697\t                    if stbds_is_key_equal(\n698\t                        a,\n699\t                        elemsize,\n700\t                        key,\n701\t                        keysize,\n702\t                        keyoffset,\n703\t                        mode,\n704\t                        (*bucket).index[i] as usize,\n705\t                    ) != 0\n706\t                    {\n707\t                        return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n708\t                    }\n709\t                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n710\t                    return -1;\n711\t                }\n712\t                i += 1;\n713\t            }\n714\t\n715\t            pos = pos.wrapping_add(step);\n716\t            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n717\t            pos &= (*table).slot_count.wrapping_sub(1);\n718\t        }\n719\t    }\n720\t}\n721\t\n722\t// ---------------------------------------------------------------------------\n723\t// stbds_hmget_key_ts / stbds_hmget_key\n724\t// ---------------------------------------------------------------------------\n725\t\n726\t#[unsafe(no_mangle)]\n727\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n728\t    a: *mut c_void,\n729\t    elemsize: usize,\n730\t    key: *mut c_void,\n731\t    keysize: usize,\n732\t    temp: *mut isize,\n733\t    mode: c_int,\n734\t) -> *mut c_void {\n735\t    unsafe {\n736\t        let keyoffset: usize = 0;\n737\t        if a.is_null() {\n738\t            let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n739\t            (*stbds_header(a)).length += 1;\n740\t            memset(a, 0, elemsize);\n741\t            *temp = STBDS_INDEX_EMPTY;\n742\t            stbds_arr_to_hash(a, elemsize)\n743\t        } else {\n744\t            let raw_a = stbds_hash_to_arr(a, elemsize);\n745\t            let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n746\t            if table.is_null() {\n747\t                *temp = -1;\n748\t            } else {\n749\t                let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n750\t                if slot < 0 {\n751\t                    *temp = STBDS_INDEX_EMPTY;\n752\t                } else {\n753\t                    let b = (*table)\n754\t                        .storage\n755\t                        .wrapping_add((slot >> STBDS_BUCKET_SHIFT) as usize);\n756\t                    *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n757\t                }\n758\t            }\n759\t            a\n760\t        }\n761\t    }\n762\t}\n763\t\n764\t#[unsafe(no_mangle)]\n765\tpub unsafe extern \"C\" fn stbds_hmget_key(\n766\t    a: *mut c_void,\n767\t    elemsize: usize,\n768\t    key: *mut c_void,\n769\t    keysize: usize,\n770\t    mode: c_int,\n771\t) -> *mut c_void {\n772\t    unsafe {\n773\t        let mut temp: isize = 0;\n774\t        let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &raw mut temp, mode);\n775\t        set_stbds_temp(stbds_hash_to_arr(p, elemsize), temp);\n776\t        p\n777\t    }\n778\t}\n779\t\n780\t// ---------------------------------------------------------------------------\n781\t// stbds_hmput_default\n782\t// ---------------------------------------------------------------------------\n783\t\n784\t#[unsafe(no_mangle)]\n785\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n786\t    unsafe {\n787\t        let mut a = a;\n788\t        if a.is_null() || (*stbds_header(stbds_hash_to_arr(a, elemsize))).length == 0 {\n789\t            let old = if !a.is_null() {\n790\t                stbds_hash_to_arr(a, elemsize)\n791\t            } else {\n792\t                ptr::null_mut()\n793\t            };\n794\t            a = stbds_arrgrowf(old, elemsize, 0, 1);\n795\t            (*stbds_header(a)).length += 1;\n796\t            memset(a, 0, elemsize);\n797\t            a = stbds_arr_to_hash(a, elemsize);\n798\t        }\n799\t        a\n800\t    }\n801\t}\n802\t\n803\t// ---------------------------------------------------------------------------\n804\t// stbds_hmput_key\n805\t// ---------------------------------------------------------------------------\n806\t\n807\t#[unsafe(no_mangle)]\n808\tpub unsafe extern \"C\" fn stbds_hmput_key(\n809\t    a: *mut c_void,\n810\t    elemsize: usize,\n811\t    key: *mut c_void,\n812\t    keysize: usize,\n813\t    mode: c_int,\n814\t) -> *mut c_void {\n815\t    unsafe {\n816\t        let keyoffset: usize = 0;\n817\t        let mut a = a;\n818\t        let mut raw_a: *mut c_void;\n819\t        let mut table: *mut stbds_hash_index;\n820\t\n821\t        if a.is_null() {\n822\t            a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n823\t            memset(a, 0, elemsize);\n824\t            (*stbds_header(a)).length += 1;\n825\t            a = stbds_arr_to_hash(a, elemsize);\n826\t        }\n827\t\n828\t        raw_a = a;\n829\t        a = stbds_hash_to_arr(a, elemsize);\n830\t\n831\t        table = (*stbds_header(a)).hash_table as *mut stbds_hash_index;\n832\t\n833\t        if table.is_null() || (*table).used_count >= (*table).used_count_threshold {\n834\t            let slot_count = if table.is_null() {\n835\t                STBDS_BUCKET_LENGTH\n836\t            } else {\n837\t                (*table).slot_count.wrapping_mul(2)\n838\t            };\n839\t            let nt = stbds_make_hash_index(slot_count, table);\n840\t            if !table.is_null() {\n841\t                stbds_free(table as *mut c_void);\n842\t            } else {\n843\t                (*nt).string.mode = if mode >= STBDS_HM_STRING {\n844\t                    STBDS_SH_DEFAULT\n845\t                } else {\n846\t                    STBDS_SH_NONE\n847\t                };\n848\t            }\n849\t            table = nt;\n850\t            (*stbds_header(a)).hash_table = table as *mut c_void;\n851\t        }\n852\t\n853\t        {\n854\t            let mut hash = if mode >= STBDS_HM_STRING {\n855\t                stbds_hash_string(key as *mut c_char, (*table).seed)\n856\t            } else {\n857\t                stbds_hash_bytes(key, keysize, (*table).seed)\n858\t            };\n859\t            let mut step = STBDS_BUCKET_LENGTH;\n860\t            let mut pos: usize;\n861\t            let mut tombstone: isize = -1;\n862\t            let mut bucket: *mut stbds_hash_bucket;\n863\t\n864\t            if hash < 2 {\n865\t                hash = hash.wrapping_add(2);\n866\t            }\n867\t\n868\t            pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n869\t\n870\t            'found_empty_slot: loop {\n871\t                bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n872\t\n873\t                let mut i = pos & STBDS_BUCKET_MASK;\n874\t                while i < STBDS_BUCKET_LENGTH {\n875\t                    if (*bucket).hash[i] == hash {\n876\t                        if stbds_is_key_equal(\n877\t                            raw_a,\n878\t                            elemsize,\n879\t                            key,\n880\t                            keysize,\n881\t                            keyoffset,\n882\t                            mode,\n883\t                            (*bucket).index[i] as usize,\n884\t                        ) != 0\n885\t                        {\n886\t                            set_stbds_temp(a, (*bucket).index[i]);\n887\t                            if mode >= STBDS_HM_STRING {\n888\t                                let k = *(elem_at(\n889\t                                    raw_a,\n890\t                                    elemsize,\n891\t                                    (*bucket).index[i] as usize,\n892\t                                    keyoffset,\n893\t                                ) as *mut *mut c_char);\n894\t                                set_stbds_temp_key(a, k);\n895\t                            }\n896\t                            return stbds_arr_to_hash(a, elemsize);\n897\t                        }\n898\t                    } else if (*bucket).hash[i] == 0 {\n899\t                        pos = (pos & !STBDS_BUCKET_MASK).wrapping_add(i);\n900\t                        break 'found_empty_slot;\n901\t                    } else if tombstone < 0 {\n902\t                        if (*bucket).index[i] == STBDS_INDEX_DELETED {\n903\t                            tombstone = ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n904\t                        }\n905\t                    }\n906\t                    i += 1;\n907\t                }\n908\t\n909\t                let limit = pos & STBDS_BUCKET_MASK;\n910\t                let mut i: usize = 0;\n911\t                while i < limit {\n912\t                    if (*bucket).hash[i] == hash {\n913\t                        if stbds_is_key_equal(\n914\t                            raw_a,\n915\t                            elemsize,\n