06\tconst STBDS_HM_BINARY: c_int = 0;\n107\tconst STBDS_HM_STRING: c_int = 1;\n108\t\n109\tconst STBDS_SH_NONE: u8 = 0;\n110\tconst STBDS_SH_DEFAULT: u8 = 1;\n111\tconst STBDS_SH_STRDUP: u8 = 2;\n112\tconst STBDS_SH_ARENA: u8 = 3;\n113\t\n114\tconst STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() * 8) as u32;\n115\t\n116\t/// `sizeof(stbds_array_header)`\n117\tconst HDR_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n118\t\n119\t// ---------------------------------------------------------------------------\n120\t// Macro helpers from the header.\n121\t// ---------------------------------------------------------------------------\n122\t\n123\t/// `stbds_header(t)  ((stbds_array_header *) (t) - 1)`\n124\t#[inline]\n125\tunsafe fn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n126\t    (t as *mut u8).wrapping_sub(HDR_SIZE) as *mut stbds_array_header\n127\t}\n128\t\n129\t/// `stbds_arrlen(a)`\n130\t#[inline]\n131\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n132\t    if a.is_null() {\n133\t        0\n134\t    } else {\n135\t        unsafe { (*stbds_header(a)).length as isize }\n136\t    }\n137\t}\n138\t\n139\t/// `stbds_arrcap(a)`\n140\t#[inline]\n141\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n142\t    if a.is_null() {\n143\t        0\n144\t    } else {\n145\t        unsafe { (*stbds_header(a)).capacity }\n146\t    }\n147\t}\n148\t\n149\t/// `stbds_temp(t) = v`\n150\t#[inline]\n151\tunsafe fn set_stbds_temp(t: *mut c_void, v: isize) {\n152\t    unsafe {\n153\t        (*stbds_header(t)).temp = v;\n154\t    }\n155\t}\n156\t\n157\t/// `stbds_temp_key(t) = v`  ->  `*(char **) stbds_header(t)->hash_table = v`\n158\t#[inline]\n159\tunsafe fn set_stbds_temp_key(t: *mut c_void, v: *mut c_char) {\n160\t    unsafe {\n161\t        *((*stbds_header(t)).hash_table as *mut *mut c_char) = v;\n162\t    }\n163\t}\n164\t\n165\t/// `STBDS_HASH_TO_ARR(x,elemsize)  ((char *) (x) - (elemsize))`\n166\t#[inline]\n167\tfn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n168\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n169\t}\n170\t\n171\t/// `STBDS_ARR_TO_HASH(x,elemsize)  ((char *) (x) + (elemsize))`\n172\t#[inline]\n173\tfn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n174\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n175\t}\n176\t\n177\t/// `stbds_hash_table(a)  ((stbds_hash_index *) stbds_header(a)->hash_table)`\n178\t#[inline]\n179\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n180\t    unsafe { (*stbds_header(a)).hash_table as *mut stbds_hash_index }\n181\t}\n182\t\n183\t/// `(char *) a + elemsize*i + keyoffset`\n184\t#[inline]\n185\tfn elem_at(a: *mut c_void, elemsize: usize, i: usize, keyoffset: usize) -> *mut u8 {\n186\t    (a as *mut u8)\n187\t        .wrapping_add(elemsize.wrapping_mul(i))\n188\t        .wrapping_add(keyoffset)\n189\t}\n190\t\n191\t/// `STBDS_ALIGN_FWD(n,a)   (((n) + (a) - 1) & ~((a)-1))`\n192\t#[inline]\n193\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n194\t    n.wrapping_add(a).wrapping_sub(1) & !(a - 1)\n195\t}\n196\t\n197\t/// `STBDS_ROTATE_LEFT(val, n)`\n198\t#[inline]\n199\tfn rotate_left(val: usize, n: u32) -> usize {\n200\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n201\t}\n202\t\n203\t/// `STBDS_ROTATE_RIGHT(val, n)`\n204\t#[inline]\n205\tfn rotate_right(val: usize, n: u32) -> usize {\n206\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n207\t}\n208\t\n209\t// ---------------------------------------------------------------------------\n210\t// stbds_arrgrowf / stbds_arrfreef\n211\t// ---------------------------------------------------------------------------\n212\t\n213\t#[unsafe(no_mangle)]\n214\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n215\t    a: *mut c_void,\n216\t    elemsize: usize,\n217\t    addlen: usize,\n218\t    min_cap: usize,\n219\t) -> *mut c_void {\n220\t    unsafe {\n221\t        let mut min_cap = min_cap;\n222\t        let b: *mut c_void;\n223\t        // size_t min_len = stbds_arrlen(a) + addlen;\n224\t        let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n225\t\n226\t        if min_len > min_cap {\n227\t            min_cap = min_len;\n228\t        }\n229\t\n230\t        if min_cap <= stbds_arrcap(a) {\n231\t            return a;\n232\t        }\n233\t\n234\t        if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n235\t            min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n236\t        } else if min_cap < 4 {\n237\t            min_cap = 4;\n238\t        }\n239\t\n240\t        let old = if a.is_null() {\n241\t            ptr::null_mut()\n242\t        } else {\n243\t            stbds_header(a) as *mut c_void\n244\t        };\n245\t        let raw = stbds_realloc(old, elemsize.wrapping_mul(min_cap).wrapping_add(HDR_SIZE));\n246\t        b = (raw as *mut u8).wrapping_add(HDR_SIZE) as *mut c_void;\n247\t        if a.is_null() {\n248\t            (*stbds_header(b)).length = 0;\n249\t            (*stbds_header(b)).hash_table = ptr::null_mut();\n250\t            (*stbds_header(b)).temp = 0;\n251\t        }\n252\t        (*stbds_header(b)).capacity = min_cap;\n253\t\n254\t        b\n255\t    }\n256\t}\n257\t\n258\t#[unsafe(no_mangle)]\n259\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n260\t    unsafe {\n261\t        stbds_free(stbds_header(a) as *mut c_void);\n262\t    }\n263\t}\n264\t\n265\t// ---------------------------------------------------------------------------\n266\t// Hash seed / random state\n267\t// ---------------------------------------------------------------------------\n268\t\n269\tstatic mut stbds_hash_seed: usize = 0x31415926;\n270\t\n271\t#[unsafe(no_mangle)]\n272\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n273\t    unsafe {\n274\t        stbds_hash_seed = seed;\n275\t    }\n276\t}\n277\t\n278\t// ---------------------------------------------------------------------------\n279\t// stbds_probe_position / stbds_log2 / stbds_make_hash_index\n280\t// ---------------------------------------------------------------------------\n281\t\n282\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n283\t    hash & (slot_count.wrapping_sub(1))\n284\t}\n285\t\n286\tfn stbds_log2(slot_count: usize) -> usize {\n287\t    let mut slot_count = slot_count;\n288\t    let mut n: usize = 0;\n289\t    while slot_count > 1 {\n290\t        slot_count >>= 1;\n291\t        n += 1;\n292\t    }\n293\t    n\n294\t}\n295\t\n296\t/// Reproduces the `stbds_load_32_or_64` macro.\n297\t#[inline]\n298\tfn stbds_load_32_or_64(v32: u32, v64_hi: u32, v64_lo: u32) -> usize {\n299\t    // temp = v64_lo ^ v32, temp <<= 16, temp <<= 16, temp >>= 16, temp >>= 16\n300\t    let mut temp: usize = (v64_lo ^ v32) as usize;\n301\t    temp <<= 16;\n302\t    temp <<= 16;\n303\t    temp >>= 16;\n304\t    temp >>= 16;\n305\t    // var = v64_hi, var <<= 16, var <<= 16\n306\t    let mut var: usize = v64_hi as usize;\n307\t    var <<= 16;\n308\t    var <<= 16;\n309\t    // var ^= temp ^ v32\n310\t    var ^= temp ^ (v32 as usize);\n311\t    var\n312\t}\n313\t\n314\tunsafe fn stbds_make_hash_index(\n315\t    slot_count: usize,\n316\t    ot: *mut stbds_hash_index,\n317\t) -> *mut stbds_hash_index {\n318\t    unsafe {\n319\t        let t: *mut stbds_hash_index = stbds_realloc(\n320\t            ptr::null_mut(),\n321\t            (slot_count >> STBDS_BUCKET_SHIFT)\n322\t                .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n323\t                .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n324\t                .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n325\t        ) as *mut stbds_hash_index;\n326\t\n327\t        (*t).storage =\n328\t            stbds_align_fwd(t.wrapping_add(1) as usize, STBDS_CACHE_LINE_SIZE) as *mut stbds_hash_bucket;\n329\t        (*t).slot_count = slot_count;\n330\t        (*t).slot_count_log2 = stbds_log2(slot_count);\n331\t        (*t).tombstone_count = 0;\n332\t        (*t).used_count = 0;\n333\t\n334\t        (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n335\t        (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n336\t        (*t).used_count_shrink_threshold = slot_count >> 2;\n337\t\n338\t        if slot_count <= STBDS_BUCKET_LENGTH {\n339\t            (*t).used_count_shrink_threshold = 0;\n340\t        }\n341\t        // STBDS_ASSERT(used_count_threshold + tombstone_count_threshold < slot_count)\n342\t\n343\t        if !ot.is_null() {\n344\t            (*t).string = stbds_string_arena {\n345\t                storage: (*ot).string.storage,\n346\t                remaining: (*ot).string.remaining,\n347\t                block: (*ot).string.block,\n348\t                mode: (*ot).string.mode,\n349\t            };\n350\t            (*t).seed = (*ot).seed;\n351\t        } else {\n352\t            memset(\n353\t                &raw mut (*t).string as *mut c_void,\n354\t                0,\n355\t                core::mem::size_of::<stbds_string_arena>(),\n356\t            );\n357\t            (*t).seed = stbds_hash_seed;\n358\t            let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n359\t            let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n360\t            stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n361\t        }\n362\t\n363\t        {\n364\t            let nbuckets = slot_count >> STBDS_BUCKET_SHIFT;\n365\t            let mut i: usize = 0;\n366\t            while i < nbuckets {\n367\t                let b = (*t).storage.wrapping_add(i);\n368\t                let mut j: usize = 0;\n369\t                while j < STBDS_BUCKET_LENGTH {\n370\t                    (*b).hash[j] = STBDS_HASH_EMPTY;\n371\t                    j += 1;\n372\t                }\n373\t                let mut j: usize = 0;\n374\t                while j < STBDS_BUCKET_LENGTH {\n375\t                    (*b).index[j] = STBDS_INDEX_EMPTY;\n376\t                    j += 1;\n377\t                }\n378\t                i += 1;\n379\t            }\n380\t        }\n381\t\n382\t        if !ot.is_null() {\n383\t            (*t).used_count = (*ot).used_count;\n384\t            let nbuckets = (*ot).slot_count >> STBDS_BUCKET_SHIFT;\n385\t            let mut i: usize = 0;\n386\t            while i < nbuckets {\n387\t                let ob = (*ot).storage.wrapping_add(i);\n388\t                let mut j: usize = 0;\n389\t                while j < STBDS_BUCKET_LENGTH {\n390\t                    if (*ob).index[j] >= 0 {\n391\t                        let hash = (*ob).hash[j];\n392\t                        let mut pos =\n393\t                            stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n394\t                        let mut step = STBDS_BUCKET_LENGTH;\n395\t                        'done: loop {\n396\t                            let bucket = (*t).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n397\t\n398\t                            let mut z = pos & STBDS_BUCKET_MASK;\n399\t                            while z < STBDS_BUCKET_LENGTH {\n400\t                                if (*bucket).hash[z] == 0 {\n401\t                                    (*bucket).hash[z] = hash;\n402\t                                    (*bucket).index[z] = (*ob).index[j];\n403\t                                    break 'done;\n404\t                                }\n405\t                                z += 1;\n406\t                            }\n407\t\n408\t                            let limit = pos & STBDS_BUCKET_MASK;\n409\t                            let mut z: usize = 0;\n410\t                            while z < limit {\n411\t                                if (*bucket).hash[z] == 0 {\n412\t                                    (*bucket).hash[z] = hash;\n413\t                                    (*bucket).index[z] = (*ob).index[j];\n414\t                                    break 'done;\n415\t                                }\n416\t                                z += 1;\n417\t                            }\n418\t\n419\t                            pos = pos.wrapping_add(step);\n420\t                            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n421\t                            pos &= (*t).slot_count.wrapping_sub(1);\n422\t                        }\n423\t                    }\n424\t                    j += 1;\n425\t                }\n426\t                i += 1;\n427\t            }\n428\t        }\n429\t\n430\t        t\n431\t    }\n432\t}\n433\t\n434\t// ---------------------------------------------------------------------------\n435\t// stbds_hash_string\n436\t// ---------------------------------------------------------------------------\n437\t\n438\t#[unsafe(no_mangle)]\n439\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n440\t    unsafe {\n441\t        let mut hash: usize = seed;\n442\t        let mut s = str_ as *const u8;\n443\t        while *s != 0 {\n444\t            hash = rotate_left(hash, 9).wrapping_add(*s as usize);\n445\t            s = s.wrapping_add(1);\n446\t        }\n447\t\n448\t        hash ^= seed;\n449\t        hash = (!hash).wrapping_add(hash << 18);\n450\t        hash = hash ^ hash ^ rotate_right(hash, 31);\n451\t        hash = hash.wrapping_mul(21);\n452\t        hash = hash ^ hash ^ rotate_right(hash, 11);\n453\t        hash = hash.wrapping_add(hash << 6);\n454\t        hash ^= rotate_right(hash, 22);\n455\t        hash.wrapping_add(seed)\n456\t    }\n457\t}\n458\t\n459\t// ---------------------------------------------------------------------------\n460\t// SipHash\n461\t// ---------------------------------------------------------------------------\n462\t\n463\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n464\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n465\t\n466\tmacro_rules! stbds_sipround {\n467\t    ($v0:ident, $v1:ident, $v2:ident, $v3:ident) => {{\n468\t        $v0 = $v0.wrapping_add($v1);\n469\t        $v1 = rotate_left($v1, 13);\n470\t        $v1 ^= $v0;\n471\t        $v0 = rotate_left($v0, STBDS_SIZE_T_BITS / 2);\n472\t        $v2 = $v2.wrapping_add($v3);\n473\t        $v3 = rotate_left($v3, 16);\n474\t        $v3 ^= $v2;\n475\t        $v2 = $v2.wrapping_add($v1);\n476\t        $v1 = rotate_left($v1, 17);\n477\t        $v1 ^= $v2;\n478\t        $v2 = rotate_left($v2, STBDS_SIZE_T_BITS / 2);\n479\t        $v0 = $v0.wrapping_add($v3);\n480\t        $v3 = rotate_left($v3, 21);\n481\t        $v3 ^= $v0;\n482\t    }};\n483\t}\n484\t\n485\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n486\t    unsafe {\n487\t        let mut d = p as *const u8;\n488\t        let mut i: usize;\n489\t        let mut j: usize;\n490\t        let mut v0: usize;\n491\t        let mut v1: usize;\n492\t        let mut v2: usize;\n493\t        let mut v3: usize;\n494\t        let mut data: usize;\n495\t\n496\t        v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n497\t        v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n498\t        v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n499\t        v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n500\t\n501\t        v0 ^= 0x0706050403020100u64 as usize ^ seed;\n502\t        v1 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n503\t        v2 ^= 0x0706050403020100u64 as usize ^ seed;\n504\t        v3 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n505\t\n506\t        i = 0;\n507\t        while i.wrapping_add(core::mem::size_of::<usize>()) <= len {\n508\t            // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n509\t            //\n510\t            // NOTE: in C this expression has type `int`; if d[3] >= 0x80 the\n511\t            // result is negative and the conversion to `size_t` sign-extends.\n512\t            // That behaviour is reproduced verbatim here.\n513\t            let lo: u32 = (*d.wrapping_add(0) as u32)\n514\t                | ((*d.wrapping_add(1) as u32) << 8)\n515\t                | ((*d.wrapping_add(2) as u32) << 16)\n516\t                | ((*d.wrapping_add(3) as u32) << 24);\n517\t            data = (lo as i32) as usize;\n518\t\n519\t            // data |= (size_t) (d[4] | (d[5] << 8) | (d[6] << 16) | (d[7] << 24)) << 16 << 16;\n520\t            let hi: u32 = (*d.wrapping_add(4) as u32)\n521\t                | ((*d.wrapping_add(5) as u32) << 8)\n522\t                | ((*d.wrapping_add(6) as u32) << 16)\n523\t                | ((*d.wrapping_add(7) as u32) << 24);\n524\t            data |= (((hi as i32) as usize) << 16) << 16;\n525\t\n526\t            v3 ^= data;\n527\t            j = 0;\n528\t            while j < STBDS_SIPHASH_C_ROUNDS {\n529\t                stbds_sipround!(v0, v1, v2, v3);\n530\t                j += 1;\n531\t            }\n532\t            v0 ^= data;\n533\t\n534\t            i = i.wrapping_add(core::mem::size_of::<usize>());\n535\t            d = d.wrapping_add(core::mem::size_of::<usize>());\n536\t        }\n537\t\n538\t        data = len << (STBDS_SIZE_T_BITS - 8);\n539\t        let rem = len.wrapping_sub(i);\n540\t        // switch (len - i) with fall-through from case 7 down to case 1.\n541\t        if rem >= 7 {\n542\t            data |= ((*d.wrapping_add(6) as usize) << 24) << 24;\n543\t        }\n544\t        if rem >= 6 {\n545\t            data |= ((*d.wrapping_add(5) as usize) << 20) << 20;\n546\t        }\n547\t        if rem >= 5 {\n548\t            data |= ((*d.wrapping_add(4) as usize) << 16) << 16;\n549\t        }\n550\t        if rem >= 4 {\n551\t            // `d[3] << 24` is an `int` in C -> may sign-extend when widened.\n552\t            data |= (((*d.wrapping_add(3) as u32) << 24) as i32) as usize;\n553\t        }\n554\t        if rem >= 3 {\n555\t            data |= (*d.wrapping_add(2) as usize) << 16;\n556\t        }\n557\t        if rem >= 2 {\n558\t            data |= (*d.wrapping_add(1) as usize) << 8;\n559\t        }\n560\t        if rem >= 1 {\n561\t            data |= *d.wrapping_add(0) as usize;\n562\t        }\n563\t\n564\t        v3 ^= data;\n565\t        j = 0;\n566\t        while j < STBDS_SIPHASH_C_ROUNDS {\n567\t            stbds_sipround!(v0, v1, v2, v3);\n568\t            j += 1;\n569\t        }\n570\t        v0 ^= data;\n571\t        v2 ^= 0xff;\n572\t        j = 0;\n573\t        while j < STBDS_SIPHASH_D_ROUNDS {\n574\t            stbds_sipround!(v0, v1, v2, v3);\n575\t            j += 1;\n576\t        }\n577\t\n578\t        v0 ^ v1 ^ v2 ^ v3\n579\t    }\n580\t}\n581\t\n582\t#[unsafe(no_mangle)]\n583\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n584\t    unsafe { stbds_siphash_bytes(p, len, seed) }\n585\t}\n586\t\n587\t// ---------------------------------------------------------------------------\n588\t// stbds_is_key_equal\n589\t// ---------------------------------------------------------------------------\n590\t\n591\tunsafe fn stbds_is_key_equal(\n592\t    a: *mut c_void,\n593\t    elemsize: usize,\n594\t    key: *mut c_void,\n595\t    keysize: usize,\n596\t    keyoffset: usize,\n597\t    mode: c_int,\n598\t    i: usize,\n599\t) -> c_int {\n600\t    unsafe {\n601\t        if mode >= STBDS_HM_STRING {\n602\t            let stored = *(elem_at(a, elemsize, i, keyoffset) as *mut *mut c_char);\n603\t            (strcmp(key as *const c_char, stored) == 0) as c_int\n604\t        } else {\n605\t            (memcmp(\n606\t                key as *const c_void,\n607\t                elem_at(a, elemsize, i, keyoffset) as *const c_void,\n608\t                keysize,\n609\t            ) == 0) as c_int\n610\t        }\n611\t    }\n612\t}\n613\t\n614\t// ---------------------------------------------------------------------------\n615\t// stbds_hmfree_func\n616\t// ---------------------------------------------------------------------------\n617\t\n618\t#[unsafe(no_mangle)]\n619\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n620\t    unsafe {\n621\t        if a.is_null() {\n622\t            return;\n623\t        }\n624\t        if !stbds_hash_table(a).is_null() {\n625\t            if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP {\n626\t                let mut i: usize = 1;\n627\t                while i < (*stbds_header(a)).length {\n628\t                    stbds_free(*(elem_at(a, elemsize, i, 0) as *mut *mut c_char) as *mut c_void);\n629\t                    i += 1;\n630\t                }\n631\t            }\n632\t            stbds_strreset(&raw mut (*stbds_hash_table(a)).string);\n633\t        }\n634\t        stbds_free((*stbds_header(a)).hash_table);\n635\t        stbds_free(stbds_header(a) as *mut c_void);\n636\t    }\n637\t}\n638\t\n639\t// ---------------------------------------------------------------------------\n640\t// stbds_hm_find_slot\n641\t// ---------------------------------------------------------------------------\n642\t\n643\tunsafe fn stbds_hm_find_slot(\n644\t    a: *mut c_void,\n645\t    elemsize: usize,\n646\t    key: *mut c_void,\n647\t    keysize: usize,\n648\t    keyoffset: usize,\n649\t    mode: c_int,\n650\t) -> isize {\n651\t    unsafe {\n652\t        let raw_a = stbds_hash_to_arr(a, elemsize);\n653\t        let table = stbds_hash_table(raw_a);\n654\t        let mut hash = if mode >= STBDS_HM_STRING {\n655\t            stbds_hash_string(key as *mut c_char, (*table).seed)\n656\t        } else {\n657\t            stbds_hash_bytes(key, keysize, (*table).seed)\n658\t        };\n659\t        let mut step = STBDS_BUCKET_LENGTH;\n660\t        let mut pos: usize;\n661\t        let mut bucket: *mut stbds_hash_bucket;\n662\t\n663\t        if hash < 2 {\n664\t            hash = hash.wrapping_add(2);\n665\t        }\n666\t\n667\t        pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n668\t\n669\t        loop {\n670\t            bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n671\t\n672\t            let mut i = pos & STBDS_BUCKET_MASK;\n673\t            while i < STBDS_BUCKET_LENGTH {\n674\t                if (*bucket).hash[i] == hash {\n675\t                    if stbds_is_key_equal(\n676\t                        a,\n677\t                        elemsize,\n678\t                        key,\n679\t                        keysize,\n680\t                        keyoffset,\n681\t                        mode,\n682\t                        (*bucket).index[i] as usize,\n683\t                    ) != 0\n684\t                    {\n685\t                        return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n686\t                    }\n687\t                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n688\t                    return -1;\n689\t                }\n690\t                i += 1;\n691\t            }\n692\t\n693\t            let limit = pos & STBDS_BUCKET_MASK;\n694\t            let mut i: usize = 0;\n695\t            while i < limit {\n696\t                if (*bucket).hash[i] == hash {\n697\t                    if stbds_is_key_equal(\n698\t                        a,\n699\t                        elemsize,\n700\t                        key,\n701\t                        keysize,\n702\t                        keyoffset,\n703\t                        mode,\n704\t                        (*bucket).index[i] as usize,\n705\t                    ) != 0\n706\t                    {\n707\t                        return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n708\t                    }\n709\t                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n710\t                    return -1;\n711\t                }\n712\t                i += 1;\n713\t            }\n714\t\n715\t            pos = pos.wrapping_add(step);\n716\t            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n717\t            pos &= (*table).slot_count.wrapping_sub(1);\n718\t        }\n719\t    }\n720\t}\n721\t\n722\t// ---------------------------------------------------------------------------\n723\t// stbds_hmget_key_ts / stbds_hmget_key\n724\t// ---------------------------------------------------------------------------\n725\t\n726\t#[unsafe(no_mangle)]\n727\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n728\t    a: *mut c_void,\n729\t    elemsize: usize,\n730\t    key: *mut c_void,\n731\t    keysize: usize,\n732\t    temp: *mut isize,\n733\t    mode: c_int,\n734\t) -> *mut c_void {\n735\t    unsafe {\n736\t        let keyoffset: usize = 0;\n737\t        if a.is_null() {\n738\t            let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n739\t            (*stbds_header(a)).length += 1;\n740\t            memset(a, 0, elemsize);\n741\t            *temp = STBDS_INDEX_EMPTY;\n742\t            stbds_arr_to_hash(a, elemsize)\n743\t        } else {\n744\t            let raw_a = stbds_hash_to_arr(a, elemsize);\n745\t            let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n746\t            if table.is_null() {\n747\t                *temp = -1;\n748\t            } else {\n749\t                let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n750\t                if slot < 0 {\n751\t                    *temp = STBDS_INDEX_EMPTY;\n752\t                } else {\n753\t                    let b = (*table)\n754\t                        .storage\n755\t                        .wrapping_add((slot >> STBDS_BUCKET_SHIFT) as usize);\n756\t                    *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n757\t                }\n758\t            }\n759\t            a\n760\t        }\n761\t    }\n762\t}\n763\t\n764\t#[unsafe(no_mangle)]\n765\tpub unsafe extern \"C\" fn stbds_hmget_key(\n766\t    a: *mut c_void,\n767\t    elemsize: usize,\n768\t    key: *mut c_void,\n769\t    keysize: usize,\n770\t    mode: c_int,\n771\t) -> *mut c_void {\n772\t    unsafe {\n773\t        let mut temp: isize = 0;\n774\t        let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &raw mut temp, mode);\n775\t        set_stbds_temp(stbds_hash_to_arr(p, elemsize), temp);\n776\t        p\n777\t    }\n778\t}\n779\t\n780\t// ---------------------------------------------------------------------------\n781\t// stbds_hmput_default\n782\t// ---------------------------------------------------------------------------\n783\t\n784\t#[unsafe(no_mangle)]\n785\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n786\t    unsafe {\n787\t        let mut a = a;\n788\t        if a.is_null() || (*stbds_header(stbds_hash_to_arr(a, elemsize))).length == 0 {\n789\t            let old = if !a.is_null() {\n790\t                stbds_hash_to_arr(a, elemsize)\n791\t            } else {\n792\t                ptr::null_mut()\n793\t            };\n794\t            a = stbds_arrgrowf(old, elemsize, 0, 1);\n795\t            (*stbds_header(a)).length += 1;\n796\t            memset(a, 0, elemsize);\n797\t            a = stbds_arr_to_hash(a, elemsize);\n798\t        }\n799\t        a\n800\t    }\n801\t}\n802\t\n803\t// ---------------------------------------------------------------------------\n804\t// stbds_hmput_key\n805\t// ---------------------------------------------------------------------------\n806\t\n807\t#[unsafe(no_mangle)]\n808\tpub unsafe extern \"C\" fn stbds_hmput_key(\n809\t    a: *mut c_void,\n810\t    elemsize: usize,\n811\t    key: *mut c_void,\n812\t    keysize: usize,\n813\t    mode: c_int,\n814\t) -> *mut c_void {\n815\t    unsafe {\n816\t        let keyoffset: usize = 0;\n817\t        let mut a = a;\n818\t        let mut raw_a: *mut c_void;\n819\t        let mut table: *mut stbds_hash_index;\n820\t\n821\t        if a.is_null() {\n822\t            a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n823\t            memset(a, 0, elemsize);\n824\t            (*stbds_header(a)).length += 1;\n825\t            a = stbds_arr_to_hash(a, elemsize);\n826\t        }\n827\t\n828\t        raw_a = a;\n829\t        a = stbds_hash_to_arr(a, elemsize);\n830\t\n831\t        table = (*stbds_header(a)).hash_table as *mut stbds_hash_index;\n832\t\n833\t        if table.is_null() || (*table).used_count >= (*table).used_count_threshold {\n834\t            let slot_count = if table.is_null() {\n835\t                STBDS_BUCKET_LENGTH\n836\t            } else {\n837\t                (*table).slot_count.wrapping_mul(2)\n838\t            };\n839\t            let nt = stbds_make_hash_index(slot_count, table);\n840\t            if !table.is_null() {\n841\t                stbds_free(table as *mut c_void);\n842\t            } else {\n843\t                (*nt).string.mode = if mode >= STBDS_HM_STRING {\n844\t                    STBDS_SH_DEFAULT\n845\t                } else {\n846\t                    STBDS_SH_NONE\n847\t                };\n848\t            }\n849\t            table = nt;\n850\t            (*stbds_header(a)).hash_table = table as *mut c_void;\n851\t        }\n852\t\n853\t        {\n854\t            let mut hash = if mode >= STBDS_HM_STRING {\n855\t                stbds_hash_string(key as *mut c_char, (*table).seed)\n856\t            } else {\n857\t                stbds_hash_bytes(key, keysize, (*table).seed)\n858\t            };\n859\t            let mut step = STBDS_BUCKET_LENGTH;\n860\t            let mut pos: usize;\n861\t            let mut tombstone: isize = -1;\n862\t            let mut bucket: *mut stbds_hash_bucket;\n863\t\n864\t            if hash < 2 {\n865\t                hash = hash.wrapping_add(2);\n866\t            }\n867\t\n868\t            pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n869\t\n870\t            'found_empty_slot: loop {\n871\t                bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n872\t\n873\t                let mut i = pos & STBDS_BUCKET_MASK;\n874\t                while i < STBDS_BUCKET_LENGTH {\n875\t                    if (*bucket).hash[i] == hash {\n876\t                        if stbds_is_key_equal(\n877\t                            raw_a,\n878\t                            elemsize,\n879\t                            key,\n880\t                            keysize,\n881\t                            keyoffset,\n882\t                            mode,\n883\t                            (*bucket).index[i] as usize,\n884\t                        ) != 0\n885\t                        {\n886\t                            set_stbds_temp(a, (*bucket).index[i]);\n887\t                            if mode >= STBDS_HM_STRING {\n888\t                                let k = *(elem_at(\n889\t                                    raw_a,\n890\t                                    elemsize,\n891\t                                    (*bucket).index[i] as usize,\n892\t                                    keyoffset,\n893\t                                ) as *mut *mut c_char);\n894\t                                set_stbds_temp_key(a, k);\n895\t                            }\n896\t                            return stbds_arr_to_hash(a, elemsize);\n897\t                        }\n898\t                    } else if (*bucket).hash[i] == 0 {\n899\t                        pos = (pos & !STBDS_BUCKET_MASK).wrapping_add(i);\n900\t                        break 'found_empty_slot;\n901\t                    } else if tombstone < 0 {\n902\t                        if (*bucket).index[i] == STBDS_INDEX_DELETED {\n903\t                            tombstone = ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n904\t                        }\n905\t                    }\n906\t                    i += 1;\n907\t                }\n908\t\n909\t                let limit = pos & STBDS_BUCKET_MASK;\n910\t                let mut i: usize = 0;\n911\t                while i < limit {\n912\t                    if (*bucket).hash[i] == hash {\n913\t                        if stbds_is_key_equal(\n914\t                            raw_a,\n915\t                            elemsize,\n916\t                            key,\n917\t                            keysize,\n918\t                            keyoffset,\n919\t                            mode,\n920\t                            (*bucket).index[i] as usize,\n921\t                        ) != 0\n922\t                        {\n923\t                            // NOTE: unlike the loop above, the original C does\n924\t                            // *not* update stbds_temp_key here.\n925\t                            set_stbds_temp(a, (*bucket).index[i]);\n926\t                            return stbds_arr_to_hash(a, elemsize);\n927\t                        }\n928\t                    } else if (*bucket).hash[i] == 0 {\n929\t                        pos = (pos & !STBDS_BUCKET_MASK).wrapping_add(i);\n930\t                        break 'found_empty_slot;\n931\t                    } else if tombstone < 0 {\n932\t                        if (*bucket).index[i] == STBDS_INDEX_DELETED {\n933\t                            tombstone = ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n934\t                        }\n935\t                    }\n936\t                    i += 1;\n937\t                }\n938\t\n939\t                pos = pos.wrapping_add(step);\n940\t                step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n941\t                pos &= (*table).slot_count.wrapping_sub(1);\n942\t            }\n943\t\n944\t            // found_empty_slot:\n945\t            if tombstone >= 0 {\n946\t                pos = tombstone as usize;\n947\t                (*table).tombstone_count = (*table).tombstone_count.wrapping_sub(1);\n948\t            }\n949\t            (*table).used_count = (*table).used_count.wrapping_add(1);\n950\t\n951\t            {\n952\t                let i: isize = stbds_arrlen(a);\n953\t                if (i as usize).wrapping_add(1) > stbds_arrcap(a) {\n954\t                    a = stbds_arrgrowf(a, elemsize, 1, 0);\n955\t                }\n956\t                raw_a = stbds_arr_to_ha