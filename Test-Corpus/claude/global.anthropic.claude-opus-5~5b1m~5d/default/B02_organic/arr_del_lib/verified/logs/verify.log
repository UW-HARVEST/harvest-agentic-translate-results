{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01SCSXUYLxRJkbayq48hdimr","type":"tool_result","content":"1\t//! Rust translation of c_src/src/lib.c (stb_ds.h implementation, public domain / MIT,\n2\t//! Sean Barrett) plus the `strkey` / `arr_del` helpers defined in that file.\n3\t//!\n4\t//! The translation is deliberately literal: every quirk of the original C\n5\t//! (including integer promotion / sign-extension artefacts in the SipHash\n6\t//! byte-gathering code, and the missing `temp_key` store in the second probe\n7\t//! loop of `stbds_hmput_key`) is reproduced bit-for-bit.\n8\t\n9\t#![allow(non_camel_case_types)]\n10\t#![allow(non_snake_case)]\n11\t#![allow(non_upper_case_globals)]\n12\t#![allow(unused_assignments)]\n13\t#![allow(unused_variables)]\n14\t#![allow(clippy::missing_safety_doc)]\n15\t\n16\tuse core::ffi::{c_char, c_int, c_void};\n17\tuse core::ptr;\n18\t\n19\t/// `#define STBDS_ASSERT assert` (c_src/src/lib.c:3). The C is compiled without\n20\t/// `NDEBUG`, so these are live and `abort()` on violation; `panic!` under an\n21\t/// `extern \"C\"` fn likewise aborts, so the two libraries fail identically.\n22\t/// Deliberately `assert!` and not `debug_assert!`, so the checks exist in every\n23\t/// profile just as they do in the C build.\n24\tmacro_rules! stbds_assert {\n25\t    ($cond:expr, $what:literal) => {\n26\t        assert!($cond, concat!(\"stbds_assert: \", $what))\n27\t    };\n28\t}\n29\t\n30\t// ---------------------------------------------------------------------------\n31\t// libc bindings (we use the platform allocator so that memory returned by this\n32\t// library is interchangeable with memory from the original C library).\n33\t// ---------------------------------------------------------------------------\n34\t\n35\tunsafe extern \"C\" {\n36\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n37\t    fn free(p: *mut c_void);\n38\t    fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n39\t    fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n40\t    fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n41\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n42\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n43\t    fn strlen(s: *const c_char) -> usize;\n44\t}\n45\t\n46\t/// `STBDS_REALLOC(c,p,s)` -> `realloc(p,s)`\n47\t#[inline]\n48\tunsafe fn stbds_realloc(p: *mut c_void, s: usize) -> *mut c_void {\n49\t    unsafe { realloc(p, s) }\n50\t}\n51\t\n52\t/// `STBDS_FREE(c,p)` -> `free(p)`\n53\t#[inline]\n54\tunsafe fn stbds_free(p: *mut c_void) {\n55\t    unsafe { free(p) }\n56\t}\n57\t\n58\t// ---------------------------------------------------------------------------\n59\t// Data structures (layout must match the C structs exactly).\n60\t// ---------------------------------------------------------------------------\n61\t\n62\t#[repr(C)]\n63\tpub struct stbds_array_header {\n64\t    pub length: usize,\n65\t    pub capacity: usize,\n66\t    pub hash_table: *mut c_void,\n67\t    pub temp: isize,\n68\t}\n69\t\n70\t#[repr(C)]\n71\tpub struct stbds_string_block {\n72\t    pub next: *mut stbds_string_block,\n73\t    pub storage: [c_char; 8],\n74\t}\n75\t\n76\t#[repr(C)]\n77\tpub struct stbds_string_arena {\n78\t    pub storage: *mut stbds_string_block,\n79\t    pub remaining: usize,\n80\t    pub block: u8,\n81\t    pub mode: u8,\n82\t}\n83\t\n84\tconst STBDS_BUCKET_LENGTH: usize = 8;\n85\tconst STBDS_BUCKET_SHIFT: usize = 3; // STBDS_BUCKET_LENGTH == 8 ? 3 : 2\n86\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n87\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n88\t\n89\t#[repr(C)]\n90\tpub struct stbds_hash_bucket {\n91\t    pub hash: [usize; STBDS_BUCKET_LENGTH],\n92\t    pub index: [isize; STBDS_BUCKET_LENGTH],\n93\t}\n94\t\n95\t#[repr(C)]\n96\tpub struct stbds_hash_index {\n97\t    pub temp_key: *mut c_char,\n98\t    pub slot_count: usize,\n99\t    pub used_count: usize,\n100\t    pub used_count_threshold: usize,\n101\t    pub used_count_shrink_threshold: usize,\n102\t    pub tombstone_count: usize,\n103\t    pub tombstone_count_threshold: usize,\n104\t    pub seed: usize,\n105\t    pub slot_count_log2: usize,\n106\t    pub string: stbds_string_arena,\n107\t    pub storage: *mut stbds_hash_bucket,\n108\t}\n109\t\n110\tconst STBDS_INDEX_EMPTY: isize = -1;\n111\tconst STBDS_INDEX_DELETED: isize = -2;\n112\t\n113\tconst STBDS_HASH_EMPTY: usize = 0;\n114\tconst STBDS_HASH_DELETED: usize = 1;\n115\t\n116\t#[allow(dead_code)]\n117\tconst STBDS_HM_BINARY: c_int = 0;\n118\tconst STBDS_HM_STRING: c_int = 1;\n119\t\n120\tconst STBDS_SH_NONE: u8 = 0;\n121\tconst STBDS_SH_DEFAULT: u8 = 1;\n122\tconst STBDS_SH_STRDUP: u8 = 2;\n123\tconst STBDS_SH_ARENA: u8 = 3;\n124\t\n125\tconst STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() * 8) as u32;\n126\t\n127\t/// `sizeof(stbds_array_header)`\n128\tconst HDR_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n129\t\n130\t// ---------------------------------------------------------------------------\n131\t// Macro helpers from the header.\n132\t// ---------------------------------------------------------------------------\n133\t\n134\t/// `stbds_header(t)  ((stbds_array_header *) (t) - 1)`\n135\t#[inline]\n136\tunsafe fn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n137\t    (t as *mut u8).wrapping_sub(HDR_SIZE) as *mut stbds_array_header\n138\t}\n139\t\n140\t/// `stbds_arrlen(a)`\n141\t#[inline]\n142\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n143\t    if a.is_null() {\n144\t        0\n145\t    } else {\n146\t        unsafe { (*stbds_header(a)).length as isize }\n147\t    }\n148\t}\n149\t\n150\t/// `stbds_arrcap(a)`\n151\t#[inline]\n152\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n153\t    if a.is_null() {\n154\t        0\n155\t    } else {\n156\t        unsafe { (*stbds_header(a)).capacity }\n157\t    }\n158\t}\n159\t\n160\t/// `stbds_temp(t) = v`\n161\t#[inline]\n162\tunsafe fn set_stbds_temp(t: *mut c_void, v: isize) {\n163\t    unsafe {\n164\t        (*stbds_header(t)).temp = v;\n165\t    }\n166\t}\n167\t\n168\t/// `stbds_temp_key(t) = v`  ->  `*(char **) stbds_header(t)->hash_table = v`\n169\t#[inline]\n170\tunsafe fn set_stbds_temp_key(t: *mut c_void, v: *mut c_char) {\n171\t    unsafe {\n172\t        *((*stbds_header(t)).hash_table as *mut *mut c_char) = v;\n173\t    }\n174\t}\n175\t\n176\t/// `STBDS_HASH_TO_ARR(x,elemsize)  ((char *) (x) - (elemsize))`\n177\t#[inline]\n178\tfn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n179\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n180\t}\n181\t\n182\t/// `STBDS_ARR_TO_HASH(x,elemsize)  ((char *) (x) + (elemsize))`\n183\t#[inline]\n184\tfn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n185\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n186\t}\n187\t\n188\t/// `stbds_hash_table(a)  ((stbds_hash_index *) stbds_header(a)->hash_table)`\n189\t#[inline]\n190\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n191\t    unsafe { (*stbds_header(a)).hash_table as *mut stbds_hash_index }\n192\t}\n193\t\n194\t/// `(char *) a + elemsize*i + keyoffset`\n195\t#[inline]\n196\tfn elem_at(a: *mut c_void, elemsize: usize, i: usize, keyoffset: usize) -> *mut u8 {\n197\t    (a as *mut u8)\n198\t        .wrapping_add(elemsize.wrapping_mul(i))\n199\t        .wrapping_add(keyoffset)\n200\t}\n201\t\n202\t/// `STBDS_ALIGN_FWD(n,a)   (((n) + (a) - 1) & ~((a)-1))`\n203\t#[inline]\n204\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n205\t    n.wrapping_add(a).wrapping_sub(1) & !(a - 1)\n206\t}\n207\t\n208\t/// `STBDS_ROTATE_LEFT(val, n)`\n209\t#[inline]\n210\tfn rotate_left(val: usize, n: u32) -> usize {\n211\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n212\t}\n213\t\n214\t/// `STBDS_ROTATE_RIGHT(val, n)`\n215\t#[inline]\n216\tfn rotate_right(val: usize, n: u32) -> usize {\n217\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n218\t}\n219\t\n220\t// ---------------------------------------------------------------------------\n221\t// stbds_arrgrowf / stbds_arrfreef\n222\t// ---------------------------------------------------------------------------\n223\t\n224\t#[unsafe(no_mangle)]\n225\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n226\t    a: *mut c_void,\n227\t    elemsize: usize,\n228\t    addlen: usize,\n229\t    min_cap: usize,\n230\t) -> *mut c_void {\n231\t    unsafe {\n232\t        let mut min_cap = min_cap;\n233\t        let b: *mut c_void;\n234\t        // size_t min_len = stbds_arrlen(a) + addlen;\n235\t        let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n236\t\n237\t        if min_len > min_cap {\n238\t            min_cap = min_len;\n239\t        }\n240\t\n241\t        if min_cap <= stbds_arrcap(a) {\n242\t            return a;\n243\t        }\n244\t\n245\t        if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n246\t            min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n247\t        } else if min_cap < 4 {\n248\t            min_cap = 4;\n249\t        }\n250\t\n251\t        let old = if a.is_null() {\n252\t            ptr::null_mut()\n253\t        } else {\n254\t            stbds_header(a) as *mut c_void\n255\t        };\n256\t        let raw = stbds_realloc(old, elemsize.wrapping_mul(min_cap).wrapping_add(HDR_SIZE));\n257\t        b = (raw as *mut u8).wrapping_add(HDR_SIZE) as *mut c_void;\n258\t        if a.is_null() {\n259\t            (*stbds_header(b)).length = 0;\n260\t            (*stbds_header(b)).hash_table = ptr::null_mut();\n261\t            (*stbds_header(b)).temp = 0;\n262\t        }\n263\t        (*stbds_header(b)).capacity = min_cap;\n264\t\n265\t        b\n266\t    }\n267\t}\n268\t\n269\t#[unsafe(no_mangle)]\n270\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n271\t    unsafe {\n272\t        stbds_free(stbds_header(a) as *mut c_void);\n273\t    }\n274\t}\n275\t\n276\t// ---------------------------------------------------------------------------\n277\t// Hash seed / random state\n278\t// ---------------------------------------------------------------------------\n279\t\n280\tstatic mut stbds_hash_seed: usize = 0x31415926;\n281\t\n282\t#[unsafe(no_mangle)]\n283\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n284\t    unsafe {\n285\t        stbds_hash_seed = seed;\n286\t    }\n287\t}\n288\t\n289\t// ---------------------------------------------------------------------------\n290\t// stbds_probe_position / stbds_log2 / stbds_make_hash_index\n291\t// ---------------------------------------------------------------------------\n292\t\n293\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n294\t    hash & (slot_count.wrapping_sub(1))\n295\t}\n296\t\n297\tfn stbds_log2(slot_count: usize) -> usize {\n298\t    let mut slot_count = slot_count;\n299\t    let mut n: usize = 0;\n300\t    while slot_count > 1 {\n301\t        slot_count >>= 1;\n302\t        n += 1;\n303\t    }\n304\t    n\n305\t}\n306\t\n307\t/// Reproduces the `stbds_load_32_or_64` macro.\n308\t#[inline]\n309\tfn stbds_load_32_or_64(v32: u32, v64_hi: u32, v64_lo: u32) -> usize {\n310\t    // temp = v64_lo ^ v32, temp <<= 16, temp <<= 16, temp >>= 16, temp >>= 16\n311\t    let mut temp: usize = (v64_lo ^ v32) as usize;\n312\t    temp <<= 16;\n313\t    temp <<= 16;\n314\t    temp >>= 16;\n315\t    temp >>= 16;\n316\t    // var = v64_hi, var <<= 16, var <<= 16\n317\t    let mut var: usize = v64_hi as usize;\n318\t    var <<= 16;\n319\t    var <<= 16;\n320\t    // var ^= temp ^ v32\n321\t    var ^= temp ^ (v32 as usize);\n322\t    var\n323\t}\n324\t\n325\tunsafe fn stbds_make_hash_index(\n326\t    slot_count: usize,\n327\t    ot: *mut stbds_hash_index,\n328\t) -> *mut stbds_hash_index {\n329\t    unsafe {\n330\t        let t: *mut stbds_hash_index = stbds_realloc(\n331\t            ptr::null_mut(),\n332\t            (slot_count >> STBDS_BUCKET_SHIFT)\n333\t                .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n334\t                .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n335\t                .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n336\t        ) as *mut stbds_hash_index;\n337\t\n338\t        (*t).storage =\n339\t            stbds_align_fwd(t.wrapping_add(1) as usize, STBDS_CACHE_LINE_SIZE) as *mut stbds_hash_bucket;\n340\t        (*t).slot_count = slot_count;\n341\t        (*t).slot_count_log2 = stbds_log2(slot_count);\n342\t        (*t).tombstone_count = 0;\n343\t        (*t).used_count = 0;\n344\t\n345\t        (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n346\t        (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n347\t        (*t).used_count_shrink_threshold = slot_count >> 2;\n348\t\n349\t        if slot_count <= STBDS_BUCKET_LENGTH {\n350\t            (*t).used_count_shrink_threshold = 0;\n351\t        }\n352\t        stbds_assert!(\n353\t            (*t)\n354\t                .used_count_threshold\n355\t                .wrapping_add((*t).tombstone_count_threshold)\n356\t                < (*t).slot_count,\n357\t            \"lib.c:401: stbds_make_hash_index: used_count_threshold + tombstone_count_threshold < slot_count\"\n358\t        );\n359\t\n360\t        if !ot.is_null() {\n361\t            (*t).string = stbds_string_arena {\n362\t                storage: (*ot).string.storage,\n363\t                remaining: (*ot).string.remaining,\n364\t                block: (*ot).string.block,\n365\t                mode: (*ot).string.mode,\n366\t            };\n367\t            (*t).seed = (*ot).seed;\n368\t        } else {\n369\t            memset(\n370\t                &raw mut (*t).string as *mut c_void,\n371\t                0,\n372\t                core::mem::size_of::<stbds_string_arena>(),\n373\t            );\n374\t            (*t).seed = stbds_hash_seed;\n375\t            let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n376\t            let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n377\t            stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n378\t        }\n379\t\n380\t        {\n381\t            let nbuckets = slot_count >> STBDS_BUCKET_SHIFT;\n382\t            let mut i: usize = 0;\n383\t            while i < nbuckets {\n384\t                let b = (*t).storage.wrapping_add(i);\n385\t                let mut j: usize = 0;\n386\t                while j < STBDS_BUCKET_LENGTH {\n387\t                    (*b).hash[j] = STBDS_HASH_EMPTY;\n388\t                    j += 1;\n389\t                }\n390\t                let mut j: usize = 0;\n391\t                while j < STBDS_BUCKET_LENGTH {\n392\t                    (*b).index[j] = STBDS_INDEX_EMPTY;\n393\t                    j += 1;\n394\t                }\n395\t                i += 1;\n396\t            }\n397\t        }\n398\t\n399\t        if !ot.is_null() {\n400\t            (*t).used_count = (*ot).used_count;\n401\t            let nbuckets = (*ot).slot_count >> STBDS_BUCKET_SHIFT;\n402\t            let mut i: usize = 0;\n403\t            while i < nbuckets {\n404\t                let ob = (*ot).storage.wrapping_add(i);\n405\t                let mut j: usize = 0;\n406\t                while j < STBDS_BUCKET_LENGTH {\n407\t                    if (*ob).index[j] >= 0 {\n408\t                        let hash = (*ob).hash[j];\n409\t                        let mut pos =\n410\t                            stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n411\t                        let mut step = STBDS_BUCKET_LENGTH;\n412\t                        'done: loop {\n413\t                            let bucket = (*t).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n414\t\n415\t                            let mut z = pos & STBDS_BUCKET_MASK;\n416\t                            while z < STBDS_BUCKET_LENGTH {\n417\t                                if (*bucket).hash[z] == 0 {\n418\t                                    (*bucket).hash[z] = hash;\n419\t                                    (*bucket).index[z] = (*ob).index[j];\n420\t                                    break 'done;\n421\t                                }\n422\t                                z += 1;\n423\t                            }\n424\t\n425\t                            let limit = pos & STBDS_BUCKET_MASK;\n426\t                            let mut z: usize = 0;\n427\t                            while z < limit {\n428\t                                if (*bucket).hash[z] == 0 {\n429\t                                    (*bucket).hash[z] = hash;\n430\t                                    (*bucket).index[z] = (*ob).index[j];\n431\t                                    break 'done;\n432\t                                }\n433\t                                z += 1;\n434\t                            }\n435\t\n436\t                            pos = pos.wrapping_add(step);\n437\t                            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n438\t                            pos &= (*t).slot_count.wrapping_sub(1);\n439\t                        }\n440\t                    }\n441\t                    j += 1;\n442\t                }\n443\t                i += 1;\n444\t            }\n445\t        }\n446\t\n447\t        t\n448\t    }\n449\t}\n450\t\n451\t// ---------------------------------------------------------------------------\n452\t// stbds_hash_string\n453\t// ---------------------------------------------------------------------------\n454\t\n455\t#[unsafe(no_mangle)]\n456\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n457\t    unsafe {\n458\t        let mut hash: usize = seed;\n459\t        let mut s = str_ as *const u8;\n460\t        while *s != 0 {\n461\t            hash = rotate_left(hash, 9).wrapping_add(*s as usize);\n462\t            s = s.wrapping_add(1);\n463\t        }\n464\t\n465\t        hash ^= seed;\n466\t        hash = (!hash).wrapping_add(hash << 18);\n467\t        hash = hash ^ hash ^ rotate_right(hash, 31);\n468\t        hash = hash.wrapping_mul(21);\n469\t        hash = hash ^ hash ^ rotate_right(hash, 11);\n470\t        hash = hash.wrapping_add(hash << 6);\n471\t        hash ^= rotate_right(hash, 22);\n472\t        hash.wrapping_add(seed)\n473\t    }\n474\t}\n475\t\n476\t// ---------------------------------------------------------------------------\n477\t// SipHash\n478\t// ---------------------------------------------------------------------------\n479\t\n480\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n481\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n482\t\n483\tmacro_rules! stbds_sipround {\n484\t    ($v0:ident, $v1:ident, $v2:ident, $v3:ident) => {{\n485\t        $v0 = $v0.wrapping_add($v1);\n486\t        $v1 = rotate_left($v1, 13);\n487\t        $v1 ^= $v0;\n488\t        $v0 = rotate_left($v0, STBDS_SIZE_T_BITS / 2);\n489\t        $v2 = $v2.wrapping_add($v3);\n490\t        $v3 = rotate_left($v3, 16);\n491\t        $v3 ^= $v2;\n492\t        $v2 = $v2.wrapping_add($v1);\n493\t        $v1 = rotate_left($v1, 17);\n494\t        $v1 ^= $v2;\n495\t        $v2 = rotate_left($v2, STBDS_SIZE_T_BITS / 2);\n496\t        $v0 = $v0.wrapping_add($v3);\n497\t        $v3 = rotate_left($v3, 21);\n498\t        $v3 ^= $v0;\n499\t    }};\n500\t}\n501\t\n502\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n503\t    unsafe {\n504\t        let mut d = p as *const u8;\n505\t        let mut i: usize;\n506\t        let mut j: usize;\n507\t        let mut v0: usize;\n508\t        let mut v1: usize;\n509\t        let mut v2: usize;\n510\t        let mut v3: usize;\n511\t        let mut data: usize;\n512\t\n513\t        v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n514\t        v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n515\t        v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n516\t        v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n517\t\n518\t        v0 ^= 0x0706050403020100u64 as usize ^ seed;\n519\t        v1 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n520\t        v2 ^= 0x0706050403020100u64 as usize ^ seed;\n521\t        v3 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n522\t\n523\t        i = 0;\n524\t        while i.wrapping_add(core::mem::size_of::<usize>()) <= len {\n525\t            // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n526\t            //\n527\t            // NOTE: in C this expression has type `int`; if d[3] >= 0x80 the\n528\t            // result is negative and the conversion to `size_t` sign-extends.\n529\t            // That behaviour is reproduced verbatim here.\n530\t            let lo: u32 = (*d.wrapping_add(0) as u32)\n531\t                | ((*d.wrapping_add(1) as u32) << 8)\n532\t                | ((*d.wrapping_add(2) as u32) << 16)\n533\t                | ((*d.wrapping_add(3) as u32) << 24);\n534\t            data = (lo as i32) as usize;\n535\t\n536\t            // data |= (size_t) (d[4] | (d[5] << 8) | (d[6] << 16) | (d[7] << 24)) << 16 << 16;\n537\t            let hi: u32 = (*d.wrapping_add(4) as u32)\n538\t                | ((*d.wrapping_add(5) as u32) << 8)\n539\t                | ((*d.wrapping_add(6) as u32) << 16)\n540\t                | ((*d.wrapping_add(7) as u32) << 24);\n541\t            data |= (((hi as i32) as usize) << 16) << 16;\n542\t\n543\t            v3 ^= data;\n544\t            j = 0;\n545\t            while j < STBDS_SIPHASH_C_ROUNDS {\n546\t                stbds_sipround!(v0, v1, v2, v3);\n547\t                j += 1;\n548\t            }\n549\t            v0 ^= data;\n550\t\n551\t            i = i.wrapping_add(core::mem::size_of::<usize>());\n552\t            d = d.wrapping_add(core::mem::size_of::<usize>());\n553\t        }\n554\t\n555\t        data = len << (STBDS_SIZE_T_BITS - 8);\n556\t        let rem = len.wrapping_sub(i);\n557\t        // switch (len - i) with fall-through from case 7 down to case 1.\n558\t        if rem >= 7 {\n559\t            data |= ((*d.wrapping_add(6) as usize) << 24) << 24;\n560\t        }\n561\t        if rem >= 6 {\n562\t            data |= ((*d.wrapping_add(5) as usize) << 20) << 20;\n563\t        }\n564\t        if rem >= 5 {\n565\t            data |= ((*d.wrapping_add(4) as usize) << 16) << 16;\n566\t        }\n567\t        if rem >= 4 {\n568\t            // `d[3] << 24` is an `int` in C -> may sign-extend when widened.\n569\t            data |= (((*d.wrapping_add(3) as u32) << 24) as i32) as usize;\n570\t        }\n571\t        if rem >= 3 {\n572\t            data |= (*d.wrapping_add(2) as usize) << 16;\n573\t        }\n574\t        if rem >= 2 {\n575\t            data |= (*d.wrapping_add(1) as usize) << 8;\n576\t        }\n577\t        if rem >= 1 {\n578\t            data |= *d.wrapping_add(0) as usize;\n579\t        }\n580\t\n581\t        v3 ^= data;\n582\t        j = 0;\n583\t        while j < STBDS_SIPHASH_C_ROUNDS {\n584\t            stbds_sipround!(v0, v1, v2, v3);\n585\t            j += 1;\n586\t        }\n587\t        v0 ^= data;\n588\t        v2 ^= 0xff;\n589\t        j = 0;\n590\t        while j < STBDS_SIPHASH_D_ROUNDS {\n591\t            stbds_sipround!(v0, v1, v2, v3);\n592\t            j += 1;\n593\t        }\n594\t\n595\t        v0 ^ v1 ^ v2 ^ v3\n596\t    }\n597\t}\n598\t\n599\t#[unsafe(no_mangle)]\n600\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n601\t    unsafe { stbds_siphash_bytes(p, len, seed) }\n602\t}\n603\t\n604\t// ---------------------------------------------------------------------------\n605\t// stbds_is_key_equal\n606\t// ---------------------------------------------------------------------------\n607\t\n608\tunsafe fn stbds_is_key_equal(\n609\t    a: *mut c_void,\n610\t    elemsize: usize,\n611\t    key: *mut c_void,\n612\t    keysize: usize,\n613\t    keyoffset: usize,\n614\t    mode: c_int,\n615\t    i: usize,\n616\t) -> c_int {\n617\t    unsafe {\n618\t        if mode >= STBDS_HM_STRING {\n619\t            let stored = *(elem_at(a, elemsize, i, keyoffset) as *mut *mut c_char);\n620\t            (strcmp(key as *const c_char, stored) == 0) as c_int\n621\t        } else {\n622\t            (memcmp(\n623\t                key as *const c_void,\n624\t                elem_at(a, elemsize, i, keyoffset) as *const c_void,\n625\t                keysize,\n626\t            ) == 0) as c_int\n627\t        }\n628\t    }\n629\t}\n630\t\n631\t// ---------------------------------------------------------------------------\n632\t// stbds_hmfree_func\n633\t// ---------------------------------------------------------------------------\n634\t\n635\t#[unsafe(no_mangle)]\n636\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n637\t    unsafe {\n638\t        if a.is_null() {\n639\t            return;\n640\t        }\n641\t        if !stbds_hash_table(a).is_null() {\n642\t            if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP {\n643\t                let mut i: usize = 1;\n644\t                while i < (*stbds_header(a)).length {\n645\t                    stbds_free(*(elem_at(a, elemsize, i, 0) as *mut *mut c_char) as *mut c_void);\n646\t                    i += 1;\n647\t                }\n648\t            }\n649\t            stbds_strreset(&raw mut (*stbds_hash_table(a)).string);\n650\t        }\n651\t        stbds_free((*stbds_header(a)).hash_table);\n652\t        stbds_free(stbds_header(a) as *mut c_void);\n653\t    }\n654\t}\n655\t\n656\t// ---------------------------------------------------------------------------\n657\t// stbds_hm_find_slot\n658\t// ---------------------------------------------------------------------------\n659\t\n660\tunsafe fn stbds_hm_find_slot(\n661\t    a: *mut c_void,\n662\t    elemsize: usize,\n663\t    key: *mut c_void,\n664\t    keysize: usize,\n665\t    keyoffset: usize,\n666\t    mode: c_int,\n667\t) -> isize {\n668\t    unsafe {\n669\t        let raw_a = stbds_hash_to_arr(a, elemsize);\n670\t        let table = stbds_hash_table(raw_a);\n671\t        let mut hash = if mode >= STBDS_HM_STRING {\n672\t            stbds_hash_string(key as *mut c_char, (*table).seed)\n673\t        } else {\n674\t            stbds_hash_bytes(key, keysize, (*table).seed)\n675\t        };\n676\t        let mut step = STBDS_BUCKET_LENGTH;\n677\t        let mut pos: usize;\n678\t        let mut bucket: *mut stbds_hash_bucket;\n679\t\n680\t        if hash < 2 {\n681\t            hash = hash.wrapping_add(2);\n682\t        }\n683\t\n684\t        pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n685\t\n686\t        loop {\n687\t            bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n688\t\n689\t            let mut i = pos & STBDS_BUCKET_MASK;\n690\t            while i < STBDS_BUCKET_LENGTH {\n691\t                if (*bucket).hash[i] == hash {\n692\t                    if stbds_is_key_equal(\n693\t                        a,\n694\t                        elemsize,\n695\t                        key,\n696\t                        keysize,\n697\t                        keyoffset,\n698\t                        mode,\n699\t                        (*bucket).index[i] as usize,\n700\t                    ) != 0\n701\t                    {\n702\t                        return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n703\t                    }\n704\t                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n705\t                    return -1;\n706\t                }\n707\t                i += 1;\n708\t            }\n709\t\n710\t            let limit = pos & STBDS_BUCKET_MASK;\n711\t            let mut i: usize = 0;\n712\t            while i < limit {\n713\t                if (*bucket).hash[i] == hash {\n714\t                    if stbds_is_key_equal(\n715\t                        a,\n716\t                        elemsize,\n717\t                        key,\n718\t                        keysize,\n719\t                        keyoffset,\n720\t                        mode,\n721\t                        (*bucket).index[i] as usize,\n722\t                    ) != 0\n723\t                    {\n724\t                        return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n725\t                    }\n726\t                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n727\t                    return -1;\n728\t                }\n729\t                i += 1;\n730\t            }\n731\t\n732\t            pos = pos.wrapping_add(step);\n733\t            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n734\t            pos &= (*table).slot_count.wrapping_sub(1);\n735\t        }\n736\t    }\n737\t}\n738\t\n739\t// ---------------------------------------------------------------------------\n740\t// stbds_hmget_key_ts / stbds_hmget_key\n741\t// ---------------------------------------------------------------------------\n742\t\n743\t#[unsafe(no_mangle)]\n744\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n745\t    a: *mut c_void,\n746\t    elemsize: usize,\n747\t    key: *mut c_void,\n748\t    keysize: usize,\n749\t    temp: *mut isize,\n750\t    mode: c_int,\n751\t) -> *mut c_void {\n752\t    unsafe {\n753\t        let keyoffset: usize = 0;\n754\t        if a.is_null() {\n755\t            let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n756\t            (*stbds_header(a)).length += 1;\n757\t            memset(a, 0, elemsize);\n758\t            *temp = STBDS_INDEX_EMPTY;\n759\t            stbds_arr_to_hash(a, elemsize)\n760\t        } else {\n761\t            let raw_a = stbds_hash_to_arr(a, elemsize);\n762\t            let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n763\t            if table.is_null() {\n764\t                *temp = -1;\n765\t            } else {\n766\t                let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n767\t                if slot < 0 {\n768\t                    *temp = STBDS_INDEX_EMPTY;\n769\t                } else {\n770\t                    let b = (*table)\n771\t                        .storage\n772\t                        .wrapping_add((slot >> STBDS_BUCKET_SHIFT) as usize);\n773\t                    *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n774\t                }\n775\t            }\n776\t            a\n777\t        }\n778\t    }\n779\t}\n780\t\n781\t#[unsafe(no_mangle)]\n782\tpub unsafe extern \"C\" fn stbds_hmget_key(\n783\t    a: *mut c_void,\n784\t    elemsize: usize,\n785\t    key: *mut c_void,\n786\t    keysize: usize,\n787\t    mode: c_int,\n788\t) -> *mut c_void {\n789\t    unsafe {\n790\t        let mut temp: isize = 0;\n791\t        let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &raw mut temp, mode);\n792\t        set_stbds_temp(stbds_hash_to_arr(p, elemsize), temp);\n793\t        p\n794\t    }\n795\t}\n796\t\n797\t// ---------------------------------------------------------------------------\n798\t// stbds_hmput_default\n799\t// ---------------------------------------------------------------------------\n800\t\n801\t#[unsafe(no_mangle)]\n802\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n803\t    unsafe {\n804\t        let mut a = a;\n805\t        if a.is_null() || (*stbds_header(stbds_hash_to_arr(a, elemsize))).length == 0 {\n806\t            let old = if !a.is_null() {\n807\t                stbds_hash_to_arr(a, elemsize)\n808\t            } else {\n809\t                ptr::null_mut()\n810\t            };\n811\t            a = stbds_arrgrowf(old, elemsize, 0, 1);\n812\t            (*stbds_header(a)).length += 1;\n813\t            memset(a, 0, elemsize);\n814\t            a = stbds_arr_to_hash(a, elemsize);\n815\t        }\n816\t        a\n817\t    }\n818\t}\n819\t\n820\t// ---------------------------------------------------------------------------\n821\t// stbds_hmput_key\n822\t// ---------------------------------------------------------------------------\n823\t\n824\t#[unsafe(no_mangle)]\n825\tpub unsafe extern \"C\" fn stbds_hmput_key(\n826\t    a: *mut c_void,\n827\t    elemsize: usize,\n828\t    key: *mut c_void,\n829\t    keysize: usize,\n830\t    mode: c_int,\n831\t) -> *mut c_void {\n832\t    unsafe {\n833\t        let keyoffset: usize = 0;\n834\t        let mut a = a;\n835\t        let mut raw_a: *mut c_void;\n836\t        let mut table: *mut stbds_hash_index;\n837\t\n838\t        if a.is_null() {\n839\t            a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n840\t            memset(a, 0, elemsize);\n841\t            (*stbds_header(a)).length += 1;\n842\t            a = stbds_arr_to_hash(a, elemsize);\n843\t        }\n844\t\n845\t        raw_a = a;\n846\t        a = stbds_hash_to_arr(a, elemsize);\n847\t\n848\t        table = (*stbds_header(a)).hash_table as *mut stbds_hash_index;\n849\t\n850\t        if table.is_null() || (*table).used_count >= (*table).used_count_threshold {\n851\t            let slot_count = if table.is_null() {\n852\t                STBDS_BUCKET_LENGTH\n853\t            } else {\n854\t                (*table).slot_count.wrapping_mul(2)\n855\t            };\n856\t            let nt = stbds_make_hash_index(slot_count, table);\n857\t            if !table.is_null() {\n858\t                stbds_free(table as *mut c_void);\n859\t            } else {\n860\t                (*nt).string.mode = if mode >= STBDS_HM_STRING {\n861\t                    STBDS_SH_DEFAULT\n862\t                } else {\n863\t                    STBDS_SH_NONE\n864\t                };\n865\t            }\n866\t            table = nt;\n867\t            (*stbds_header(a)).hash_table = table as *mut c_void;\n868\t        }\n869\t\n870\t        {\n871\t            let mut hash = if mode >= STBDS_HM_STRING {\n872\t                stbds_hash_string(key as *mut c_char, (*table).seed)\n873\t            } else {\n874\t                st