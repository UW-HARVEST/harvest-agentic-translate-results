{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Udi5V4YwKYug4Ew2hFX9rU","type":"tool_result","content":"1\t//! Rust translation of c_src/src/lib.c (tinyc2-style 2D GJK routines).\n2\t//!\n3\t//! The C library is compiled by CMake as one shared object that exports every\n4\t//! non-static function in `src/lib.c`.  This crate reproduces that exact ABI:\n5\t//! same symbol names, same C signatures, same struct layouts, and bit-for-bit\n6\t//! identical floating point behaviour (all arithmetic is plain IEEE-754\n7\t//! single precision, no fused operations, no reassociation).\n8\t//!\n9\t//! Bugs / quirks in the original C are preserved verbatim, including:\n10\t//!   * the inverted cache-validity test in `c2GJK`\n11\t//!   * `gjk_cache` never writing through its `a9` / `b9` out-parameters\n12\t//!   * NaN-propagating min/max ordering in `c2Maxv` / `c2Minv`\n13\t\n14\t#![allow(non_snake_case)]\n15\t#![allow(non_camel_case_types)]\n16\t#![allow(non_upper_case_globals)]\n17\t\n18\tuse core::ffi::{c_char, c_int, c_uint, c_void};\n19\tuse core::ptr;\n20\t\n21\t// ---------------------------------------------------------------------------\n22\t// C2_TYPE (C enum -> unsigned int on the SysV x86-64 ABI)\n23\t// ---------------------------------------------------------------------------\n24\t\n25\tpub const C2_TYPE_CIRCLE: c_uint = 0;\n26\tpub const C2_TYPE_AABB: c_uint = 1;\n27\tpub const C2_TYPE_CAPSULE: c_uint = 2;\n28\t\n29\t// ---------------------------------------------------------------------------\n30\t// Public / internal structs.  Layouts verified against the C compiler:\n31\t//   c2v = 8, c2r = 8, c2x = 16, c2Circle = 12, c2AABB = 16, c2Capsule = 20,\n32\t//   c2GJKCache = 36 (div @ 32), c2Proxy = 72 (verts @ 8),\n33\t//   c2sv = 36, c2Simplex = 152 (b @ 36, div @ 144, count @ 148)\n34\t// ---------------------------------------------------------------------------\n35\t\n36\t#[repr(C)]\n37\t#[derive(Copy, Clone)]\n38\tpub struct c2v {\n39\t    pub x: f32,\n40\t    pub y: f32,\n41\t}\n42\t\n43\t#[repr(C)]\n44\t#[derive(Copy, Clone)]\n45\tpub struct c2r {\n46\t    pub c: f32,\n47\t    pub s: f32,\n48\t}\n49\t\n50\t#[repr(C)]\n51\t#[derive(Copy, Clone)]\n52\tpub struct c2x {\n53\t    pub p: c2v,\n54\t    pub r: c2r,\n55\t}\n56\t\n57\t#[repr(C)]\n58\t#[derive(Copy, Clone)]\n59\tpub struct c2Circle {\n60\t    pub p: c2v,\n61\t    pub r: f32,\n62\t}\n63\t\n64\t#[repr(C)]\n65\t#[derive(Copy, Clone)]\n66\tpub struct c2AABB {\n67\t    pub min: c2v,\n68\t    pub max: c2v,\n69\t}\n70\t\n71\t#[repr(C)]\n72\t#[derive(Copy, Clone)]\n73\tpub struct c2Capsule {\n74\t    pub a: c2v,\n75\t    pub b: c2v,\n76\t    pub r: f32,\n77\t}\n78\t\n79\t#[repr(C)]\n80\t#[derive(Copy, Clone)]\n81\tpub struct c2GJKCache {\n82\t    pub metric: f32,\n83\t    pub count: c_int,\n84\t    pub iA: [c_int; 3],\n85\t    pub iB: [c_int; 3],\n86\t    pub div: f32,\n87\t}\n88\t\n89\t#[repr(C)]\n90\t#[derive(Copy, Clone)]\n91\tpub struct c2Proxy {\n92\t    pub radius: f32,\n93\t    pub count: c_int,\n94\t    pub verts: [c2v; 8],\n95\t}\n96\t\n97\t#[repr(C)]\n98\t#[derive(Copy, Clone)]\n99\tpub struct c2sv {\n100\t    pub sA: c2v,\n101\t    pub sB: c2v,\n102\t    pub p: c2v,\n103\t    pub u: f32,\n104\t    pub iA: c_int,\n105\t    pub iB: c_int,\n106\t}\n107\t\n108\t/// The C declaration is `c2sv a, b, c, d;` -- four consecutive `c2sv` values,\n109\t/// which `c2GJK` walks with `c2sv *verts = &s.a;`.  The array below is\n110\t/// layout-identical.\n111\t#[repr(C)]\n112\t#[derive(Copy, Clone)]\n113\tpub struct c2Simplex {\n114\t    pub verts: [c2sv; 4],\n115\t    pub div: f32,\n116\t    pub count: c_int,\n117\t}\n118\t\n119\tconst ZERO_V: c2v = c2v { x: 0.0, y: 0.0 };\n120\t\n121\tconst ZERO_SV: c2sv = c2sv {\n122\t    sA: ZERO_V,\n123\t    sB: ZERO_V,\n124\t    p: ZERO_V,\n125\t    u: 0.0,\n126\t    iA: 0,\n127\t    iB: 0,\n128\t};\n129\t\n130\t// FLT_MAX as spelled in the C source.\n131\tconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_6e38_f32;\n132\t// FLT_EPSILON as spelled in the C source.\n133\tconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7_f32;\n134\t\n135\t// ---------------------------------------------------------------------------\n136\t// Vector helpers\n137\t// ---------------------------------------------------------------------------\n138\t\n139\t#[unsafe(no_mangle)]\n140\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n141\t    let mut a = ZERO_V;\n142\t    a.x = x;\n143\t    a.y = y;\n144\t    a\n145\t}\n146\t\n147\t#[unsafe(no_mangle)]\n148\tpub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n149\t    let mut a = a;\n150\t    a.x *= b;\n151\t    a.y *= b;\n152\t    a\n153\t}\n154\t\n155\t#[unsafe(no_mangle)]\n156\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n157\t    c2V(\n158\t        if a.x > b.x { a.x } else { b.x },\n159\t        if a.y > b.y { a.y } else { b.y },\n160\t    )\n161\t}\n162\t\n163\t#[unsafe(no_mangle)]\n164\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n165\t    c2V(\n166\t        if a.x < b.x { a.x } else { b.x },\n167\t        if a.y < b.y { a.y } else { b.y },\n168\t    )\n169\t}\n170\t\n171\t#[unsafe(no_mangle)]\n172\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n173\t    c2Maxv(lo, c2Minv(a, hi))\n174\t}\n175\t\n176\t#[unsafe(no_mangle)]\n177\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n178\t    let mut a = a;\n179\t    a.x -= b.x;\n180\t    a.y -= b.y;\n181\t    a\n182\t}\n183\t\n184\t#[unsafe(no_mangle)]\n185\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n186\t    a.x * b.x + a.y * b.y\n187\t}\n188\t\n189\t#[unsafe(no_mangle)]\n190\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n191\t    let mut r = c2r { c: 0.0, s: 0.0 };\n192\t    r.c = 1.0f32;\n193\t    r.s = 0.0;\n194\t    r\n195\t}\n196\t\n197\t#[unsafe(no_mangle)]\n198\tpub extern \"C\" fn c2xIdentity() -> c2x {\n199\t    let mut x = c2x {\n200\t        p: ZERO_V,\n201\t        r: c2r { c: 0.0, s: 0.0 },\n202\t    };\n203\t    x.p = c2V(0.0, 0.0);\n204\t    x.r = c2RotIdentity();\n205\t    x\n206\t}\n207\t\n208\t// ---------------------------------------------------------------------------\n209\t// Proxies\n210\t// ---------------------------------------------------------------------------\n211\t\n212\t#[unsafe(no_mangle)]\n213\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n214\t    *out.offset(0) = (*bb).min;\n215\t    *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n216\t    *out.offset(2) = (*bb).max;\n217\t    *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n218\t}\n219\t\n220\t#[unsafe(no_mangle)]\n221\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, r#type: c_uint, p: *mut c2Proxy) {\n222\t    match r#type {\n223\t        C2_TYPE_CIRCLE => {\n224\t            let c = shape as *mut c2Circle;\n225\t            (*p).radius = (*c).r;\n226\t            (*p).count = 1;\n227\t            (*p).verts[0] = (*c).p;\n228\t        }\n229\t        C2_TYPE_AABB => {\n230\t            let bb = shape as *mut c2AABB;\n231\t            (*p).radius = 0.0;\n232\t            (*p).count = 4;\n233\t            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n234\t        }\n235\t        C2_TYPE_CAPSULE => {\n236\t            let c = shape as *mut c2Capsule;\n237\t            (*p).radius = (*c).r;\n238\t            (*p).count = 2;\n239\t            (*p).verts[0] = (*c).a;\n240\t            (*p).verts[1] = (*c).b;\n241\t        }\n242\t        // No `default:` label in the C switch -- nothing is written.\n243\t        _ => {}\n244\t    }\n245\t}\n246\t\n247\t// ---------------------------------------------------------------------------\n248\t// Simplex helpers\n249\t// ---------------------------------------------------------------------------\n250\t\n251\t#[unsafe(no_mangle)]\n252\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n253\t    sqrtf(c2Dot(a, a))\n254\t}\n255\t\n256\t#[unsafe(no_mangle)]\n257\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n258\t    a.x * b.y - a.y * b.x\n259\t}\n260\t\n261\t#[unsafe(no_mangle)]\n262\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n263\t    match (*s).count {\n264\t        2 => c2Len(c2Sub((*s).verts[1].p, (*s).verts[0].p)),\n265\t        3 => c2Det2(\n266\t            c2Sub((*s).verts[1].p, (*s).verts[0].p),\n267\t            c2Sub((*s).verts[2].p, (*s).verts[0].p),\n268\t        ),\n269\t        // `default:` falls through to `case 1:` in the C source.\n270\t        _ => 0.0,\n271\t    }\n272\t}\n273\t\n274\t#[unsafe(no_mangle)]\n275\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n276\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n277\t}\n278\t\n279\t#[unsafe(no_mangle)]\n280\tpub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n281\t    let mut a = a;\n282\t    a.x += b.x;\n283\t    a.y += b.y;\n284\t    a\n285\t}\n286\t\n287\t#[unsafe(no_mangle)]\n288\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n289\t    c2Add(c2Mulrv(a.r, b), a.p)\n290\t}\n291\t\n292\t#[unsafe(no_mangle)]\n293\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n294\t    let a = (*s).verts[0].p;\n295\t    let b = (*s).verts[1].p;\n296\t    let u = c2Dot(b, c2Sub(b, a));\n297\t    let v = c2Dot(a, c2Sub(a, b));\n298\t    if v <= 0.0 {\n299\t        (*s).verts[0].u = 1.0f32;\n300\t        (*s).div = 1.0f32;\n301\t        (*s).count = 1;\n302\t    } else if u <= 0.0 {\n303\t        (*s).verts[0] = (*s).verts[1];\n304\t        (*s).verts[0].u = 1.0f32;\n305\t        (*s).div = 1.0f32;\n306\t        (*s).count = 1;\n307\t    } else {\n308\t        (*s).verts[0].u = u;\n309\t        (*s).verts[1].u = v;\n310\t        (*s).div = u + v;\n311\t        (*s).count = 2;\n312\t    }\n313\t}\n314\t\n315\t#[unsafe(no_mangle)]\n316\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n317\t    let a = (*s).verts[0].p;\n318\t    let b = (*s).verts[1].p;\n319\t    let c = (*s).verts[2].p;\n320\t    let uAB = c2Dot(b, c2Sub(b, a));\n321\t    let vAB = c2Dot(a, c2Sub(a, b));\n322\t    let uBC = c2Dot(c, c2Sub(c, b));\n323\t    let vBC = c2Dot(b, c2Sub(b, c));\n324\t    let uCA = c2Dot(a, c2Sub(a, c));\n325\t    let vCA = c2Dot(c, c2Sub(c, a));\n326\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n327\t    let uABC = c2Det2(b, c) * area;\n328\t    let vABC = c2Det2(c, a) * area;\n329\t    let wABC = c2Det2(a, b) * area;\n330\t    if vAB <= 0.0 && uCA <= 0.0 {\n331\t        (*s).verts[0].u = 1.0f32;\n332\t        (*s).div = 1.0f32;\n333\t        (*s).count = 1;\n334\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n335\t        (*s).verts[0] = (*s).verts[1];\n336\t        (*s).verts[0].u = 1.0f32;\n337\t        (*s).div = 1.0f32;\n338\t        (*s).count = 1;\n339\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n340\t        (*s).verts[0] = (*s).verts[2];\n341\t        (*s).verts[0].u = 1.0f32;\n342\t        (*s).div = 1.0f32;\n343\t        (*s).count = 1;\n344\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n345\t        (*s).verts[0].u = uAB;\n346\t        (*s).verts[1].u = vAB;\n347\t        (*s).div = uAB + vAB;\n348\t        (*s).count = 2;\n349\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n350\t        (*s).verts[0] = (*s).verts[1];\n351\t        (*s).verts[1] = (*s).verts[2];\n352\t        (*s).verts[0].u = uBC;\n353\t        (*s).verts[1].u = vBC;\n354\t        (*s).div = uBC + vBC;\n355\t        (*s).count = 2;\n356\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n357\t        (*s).verts[1] = (*s).verts[0];\n358\t        (*s).verts[0] = (*s).verts[2];\n359\t        (*s).verts[0].u = uCA;\n360\t        (*s).verts[1].u = vCA;\n361\t        (*s).div = uCA + vCA;\n362\t        (*s).count = 2;\n363\t    } else {\n364\t        (*s).verts[0].u = uABC;\n365\t        (*s).verts[1].u = vABC;\n366\t        (*s).verts[2].u = wABC;\n367\t        (*s).div = uABC + vABC + wABC;\n368\t        (*s).count = 3;\n369\t    }\n370\t}\n371\t\n372\t#[unsafe(no_mangle)]\n373\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n374\t    c2V(-a.x, -a.y)\n375\t}\n376\t\n377\t#[unsafe(no_mangle)]\n378\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n379\t    let mut b = ZERO_V;\n380\t    b.x = -a.y;\n381\t    b.y = a.x;\n382\t    b\n383\t}\n384\t\n385\t#[unsafe(no_mangle)]\n386\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n387\t    let mut b = ZERO_V;\n388\t    b.x = a.y;\n389\t    b.y = -a.x;\n390\t    b\n391\t}\n392\t\n393\t#[unsafe(no_mangle)]\n394\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n395\t    match (*s).count {\n396\t        1 => c2Neg((*s).verts[0].p),\n397\t        2 => {\n398\t            let ab = c2Sub((*s).verts[1].p, (*s).verts[0].p);\n399\t            if c2Det2(ab, c2Neg((*s).verts[0].p)) > 0.0 {\n400\t                return c2Skew(ab);\n401\t            }\n402\t            c2CCW90(ab)\n403\t        }\n404\t        // case 3 and default\n405\t        _ => c2V(0.0, 0.0),\n406\t    }\n407\t}\n408\t\n409\t#[unsafe(no_mangle)]\n410\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n411\t    let mut imax: c_int = 0;\n412\t    let mut dmax = c2Dot(*verts.offset(0), d);\n413\t    let mut i: c_int = 1;\n414\t    while i < count {\n415\t        let dot = c2Dot(*verts.offset(i as isize), d);\n416\t        if dot > dmax {\n417\t            imax = i;\n418\t            dmax = dot;\n419\t        }\n420\t        i += 1;\n421\t    }\n422\t    imax\n423\t}\n424\t\n425\t#[unsafe(no_mangle)]\n426\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n427\t    let den = 1.0f32 / (*s).div;\n428\t    match (*s).count {\n429\t        1 => {\n430\t            *a = (*s).verts[0].sA;\n431\t            *b = (*s).verts[0].sB;\n432\t        }\n433\t        2 => {\n434\t            *a = c2Add(\n435\t                c2Mulvs((*s).verts[0].sA, den * (*s).verts[0].u),\n436\t                c2Mulvs((*s).verts[1].sA, den * (*s).verts[1].u),\n437\t            );\n438\t            *b = c2Add(\n439\t                c2Mulvs((*s).verts[0].sB, den * (*s).verts[0].u),\n440\t                c2Mulvs((*s).verts[1].sB, den * (*s).verts[1].u),\n441\t            );\n442\t        }\n443\t        3 => {\n444\t            *a = c2Add(\n445\t                c2Add(\n446\t                    c2Mulvs((*s).verts[0].sA, den * (*s).verts[0].u),\n447\t                    c2Mulvs((*s).verts[1].sA, den * (*s).verts[1].u),\n448\t                ),\n449\t                c2Mulvs((*s).verts[2].sA, den * (*s).verts[2].u),\n450\t            );\n451\t            *b = c2Add(\n452\t                c2Add(\n453\t                    c2Mulvs((*s).verts[0].sB, den * (*s).verts[0].u),\n454\t                    c2Mulvs((*s).verts[1].sB, den * (*s).verts[1].u),\n455\t                ),\n456\t                c2Mulvs((*s).verts[2].sB, den * (*s).verts[2].u),\n457\t            );\n458\t        }\n459\t        _ => {\n460\t            *a = c2V(0.0, 0.0);\n461\t            *b = c2V(0.0, 0.0);\n462\t        }\n463\t    }\n464\t}\n465\t\n466\t#[unsafe(no_mangle)]\n467\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n468\t    c2Mulvs(a, 1.0f32 / b)\n469\t}\n470\t\n471\t#[unsafe(no_mangle)]\n472\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n473\t    c2Div(a, c2Len(a))\n474\t}\n475\t\n476\t#[unsafe(no_mangle)]\n477\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n478\t    let den = 1.0f32 / (*s).div;\n479\t    match (*s).count {\n480\t        1 => (*s).verts[0].p,\n481\t        2 => c2Add(\n482\t            c2Mulvs((*s).verts[0].p, den * (*s).verts[0].u),\n483\t            c2Mulvs((*s).verts[1].p, den * (*s).verts[1].u),\n484\t        ),\n485\t        _ => c2V(0.0, 0.0),\n486\t    }\n487\t}\n488\t\n489\t#[unsafe(no_mangle)]\n490\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n491\t    // `opaque` stops LLVM from rewriting `(-a.s) * b.x + a.c * b.y` into\n492\t    // `a.c * b.y - a.s * b.x`: it likes to sink the `fneg` out of the `fmul`\n493\t    // and then fold `fadd (fneg x), y` into `fsub y, x`.  That rewrite is\n494\t    // bit-exact for finite values, but it changes the sign of a propagated\n495\t    // NaN, so the negation is pinned down here and happens first, exactly as\n496\t    // the C source spells it.\n497\t    c2V(a.c * b.x + a.s * b.y, opaque(-a.s) * b.x + a.c * b.y)\n498\t}\n499\t\n500\t// ---------------------------------------------------------------------------\n501\t// GJK\n502\t// ---------------------------------------------------------------------------\n503\t\n504\t// `save_count`'s and `d1`'s initial values are dead stores in the C as well\n505\t// (`int save_count = 0;` / `float d1 = FLT_MAX;`); they are kept so that the\n506\t// declarations line up one-for-one with the original.\n507\t#[allow(unused_assignments)]\n508\t#[unsafe(no_mangle)]\n509\tpub unsafe extern \"C\" fn c2GJK(\n510\t    A: *const c_void,\n511\t    typeA: c_uint,\n512\t    ax_ptr: *const c2x,\n513\t    B: *const c_void,\n514\t    typeB: c_uint,\n515\t    bx_ptr: *const c2x,\n516\t    outA: *mut c2v,\n517\t    outB: *mut c2v,\n518\t    use_radius: c_int,\n519\t    iterations: *mut c_int,\n520\t    cache: *mut c2GJKCache,\n521\t) -> f32 {\n522\t    let ax: c2x;\n523\t    let bx: c2x;\n524\t    if ax_ptr.is_null() {\n525\t        ax = c2xIdentity();\n526\t    } else {\n527\t        ax = *ax_ptr;\n528\t    }\n529\t    if bx_ptr.is_null() {\n530\t        bx = c2xIdentity();\n531\t    } else {\n532\t        bx = *bx_ptr;\n533\t    }\n534\t\n535\t    let mut pA = c2Proxy {\n536\t        radius: 0.0,\n537\t        count: 0,\n538\t        verts: [ZERO_V; 8],\n539\t    };\n540\t    let mut pB = c2Proxy {\n541\t        radius: 0.0,\n542\t        count: 0,\n543\t        verts: [ZERO_V; 8],\n544\t    };\n545\t    c2MakeProxy(A, typeA, &mut pA);\n546\t    c2MakeProxy(B, typeB, &mut pB);\n547\t\n548\t    let mut simplex = c2Simplex {\n549\t        verts: [ZERO_SV; 4],\n550\t        div: 0.0,\n551\t        count: 0,\n552\t    };\n553\t    let s: *mut c2Simplex = &raw mut simplex;\n554\t    let verts: *mut c2sv = (*s).verts.as_mut_ptr();\n555\t\n556\t    let mut cache_was_read: c_int = 0;\n557\t    if !cache.is_null() {\n558\t        let cache_was_good = (*cache).count != 0;\n559\t        if cache_was_good {\n560\t            let mut i: c_int = 0;\n561\t            while i < (*cache).count {\n562\t                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n563\t                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n564\t                let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n565\t                let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n566\t                let v: *mut c2sv = verts.offset(i as isize);\n567\t                (*v).iA = iA;\n568\t                (*v).sA = sA;\n569\t                (*v).iB = iB;\n570\t                (*v).sB = sB;\n571\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n572\t                (*v).u = 0.0;\n573\t                i += 1;\n574\t            }\n575\t            (*s).count = (*cache).count;\n576\t            (*s).div = (*cache).div;\n577\t            let metric_old = (*cache).metric;\n578\t            let metric = c2GJKSimplexMetric(s);\n579\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n580\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n581\t            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n582\t                cache_was_read = 1;\n583\t            }\n584\t        }\n585\t    }\n586\t\n587\t    if cache_was_read == 0 {\n588\t        (*verts.offset(0)).iA = 0;\n589\t        (*verts.offset(0)).iB = 0;\n590\t        (*verts.offset(0)).sA = c2Mulxv(ax, pA.verts[0]);\n591\t        (*verts.offset(0)).sB = c2Mulxv(bx, pB.verts[0]);\n592\t        (*verts.offset(0)).p = c2Sub((*verts.offset(0)).sB, (*verts.offset(0)).sA);\n593\t        (*verts.offset(0)).u = 1.0f32;\n594\t        (*s).div = 1.0f32;\n595\t        (*s).count = 1;\n596\t    }\n597\t\n598\t    let mut saveA: [c_int; 3] = [0; 3];\n599\t    let mut saveB: [c_int; 3] = [0; 3];\n600\t    let mut save_count: c_int = 0;\n601\t    let mut d0: f32 = C2_FLT_MAX;\n602\t    let mut d1: f32 = C2_FLT_MAX;\n603\t    let mut iter: c_int = 0;\n604\t    let mut hit: c_int = 0;\n605\t    while iter < 20 {\n606\t        save_count = (*s).count;\n607\t        let mut i: c_int = 0;\n608\t        while i < save_count {\n609\t            *saveA.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iA;\n610\t            *saveB.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iB;\n611\t            i += 1;\n612\t        }\n613\t\n614\t        match (*s).count {\n615\t            1 => {}\n616\t            2 => c22(s),\n617\t            3 => c23(s),\n618\t            _ => {}\n619\t        }\n620\t\n621\t        if (*s).count == 3 {\n622\t            hit = 1;\n623\t            break;\n624\t        }\n625\t\n626\t        let p = c2L(s);\n627\t        d1 = c2Dot(p, p);\n628\t        if d1 > d0 {\n629\t            break;\n630\t        }\n631\t        d0 = d1;\n632\t\n633\t        let d = c2D(s);\n634\t        if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n635\t            break;\n636\t        }\n637\t\n638\t        let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n639\t        let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n640\t        let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n641\t        let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n642\t        let v: *mut c2sv = verts.offset((*s).count as isize);\n643\t        (*v).iA = iA;\n644\t        (*v).sA = sA;\n645\t        (*v).iB = iB;\n646\t        (*v).sB = sB;\n647\t        (*v).p = c2Sub((*v).sB, (*v).sA);\n648\t\n649\t        let mut dup: c_int = 0;\n650\t        let mut i: c_int = 0;\n651\t        while i < save_count {\n652\t            if iA == *saveA.as_ptr().offset(i as isize) && iB == *saveB.as_ptr().offset(i as isize) {\n653\t                dup = 1;\n654\t                break;\n655\t            }\n656\t            i += 1;\n657\t        }\n658\t        if dup != 0 {\n659\t            break;\n660\t        }\n661\t\n662\t        (*s).count += 1;\n663\t        iter += 1;\n664\t    }\n665\t\n666\t    let mut a = ZERO_V;\n667\t    let mut b = ZERO_V;\n668\t    c2Witness(s, &mut a, &mut b);\n669\t    let mut dist = c2Len(c2Sub(a, b));\n670\t    if hit != 0 {\n671\t        a = b;\n672\t        dist = 0.0;\n673\t    } else if use_radius != 0 {\n674\t        let rA = pA.radius;\n675\t        let rB = pB.radius;\n676\t        if dist > rA + rB && dist > C2_FLT_EPSILON {\n677\t            dist -= rA + rB;\n678\t            let n = c2Norm(c2Sub(b, a));\n679\t            a = c2Add(a, c2Mulvs(n, rA));\n680\t            b = c2Sub(b, c2Mulvs(n, rB));\n681\t            if a.x == b.x && a.y == b.y {\n682\t                dist = 0.0;\n683\t            }\n684\t        } else {\n685\t            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n686\t            a = p;\n687\t            b = p;\n688\t            dist = 0.0;\n689\t        }\n690\t    }\n691\t\n692\t    if !cache.is_null() {\n693\t        (*cache).metric = c2GJKSimplexMetric(s);\n694\t        (*cache).count = (*s).count;\n695\t        let mut i: c_int = 0;\n696\t        while i < (*s).count {\n697\t            let v: *mut c2sv = verts.offset(i as isize);\n698\t            *(*cache).iA.as_mut_ptr().offset(i as isize) = (*v).iA;\n699\t            *(*cache).iB.as_mut_ptr().offset(i as isize) = (*v).iB;\n700\t            i += 1;\n701\t        }\n702\t        (*cache).div = (*s).div;\n703\t    }\n704\t\n705\t    if !outA.is_null() {\n706\t        *outA = a;\n707\t    }\n708\t    if !outB.is_null() {\n709\t        *outB = b;\n710\t    }\n711\t    if !iterations.is_null() {\n712\t        *iterations = iter;\n713\t    }\n714\t    dist\n715\t}\n716\t\n717\t// ---------------------------------------------------------------------------\n718\t// Public entry point declared in include/lib.h\n719\t// ---------------------------------------------------------------------------\n720\t\n721\t#[unsafe(no_mangle)]\n722\tpub unsafe extern \"C\" fn gjk_cache(\n723\t    reverse: c_char,\n724\t    a9: *mut c2v,\n725\t    b9: *mut c2v,\n726\t    a1: f32,\n727\t    a2: f32,\n728\t    a3: f32,\n729\t    a4: f32,\n730\t    b1: f32,\n731\t    b2: f32,\n732\t    b3: f32,\n733\t    b4: f32,\n734\t    b5: f32,\n735\t) {\n736\t    // `cache` is an uninitialised automatic in the C; only `count` is set, and\n737\t    // because `count == 0` none of the other members are ever read before\n738\t    // being written, so starting from zeros is behaviourally identical.\n739\t    let mut cache = c2GJKCache {\n740\t        metric: 0.0,\n741\t        count: 0,\n742\t        iA: [0; 3],\n743\t        iB: [0; 3],\n744\t        div: 0.0,\n745\t    };\n746\t    cache.count = 0;\n747\t\n748\t    let A = c2Circle {\n749\t        p: c2v { x: 0.0, y: 0.0 },\n750\t        r: 15.0f32,\n751\t    };\n752\t\n753\t    let B = c2Capsule {\n754\t        a: c2v { x: 100.0, y: -25.0 },\n755\t        b: c2v { x: 75.0, y: 100.0 },\n756\t        r: 10.0,\n757\t    };\n758\t\n759\t    let mut a0 = ZERO_V;\n760\t    let mut b0 = ZERO_V;\n761\t    let mut a = ZERO_V;\n762\t    let mut b = ZERO_V;\n763\t\n764\t    let mut iterations: c_int = -1;\n765\t    let mut cached_iterations: c_int = -1;\n766\t    let d0 = c2GJK(\n767\t        &A as *const c2Circle as *const c_void,\n768\t        C2_TYPE_CIRCLE,\n769\t        ptr::null(),\n770\t        &B as *const c2Capsule as *const c_void,\n771\t        C2_TYPE_CAPSULE,\n772\t        ptr::null(),\n773\t        &mut a0,\n774\t        &mut b0,\n775\t        1,\n776\t        &mut iterations,\n777\t        &mut cache,\n778\t    );\n779\t    let d1 = c2GJK(\n780\t        &A as *const c2Circle as *const c_void,\n781\t        C2_TYPE_CIRCLE,\n782\t        ptr::null(),\n783\t        &B as *const c2Capsule as *const c_void,\n784\t        C2_TYPE_CAPSULE,\n785\t        ptr::null(),\n786\t        &mut a,\n787\t        &mut b,\n788\t        1,\n789\t        &mut cached_iterations,\n790\t        &mut cache,\n791\t    );\n792\t    let _ = (d0, d1);\n793\t\n794\t    let mut bb = c2AABB {\n795\t        min: ZERO_V,\n796\t        max: ZERO_V,\n797\t    };\n798\t    bb.min = c2V(a1, a2);\n799\t    bb.max = c2V(a3, a4);\n800\t\n801\t    let mut cap = c2Capsule {\n802\t        a: ZERO_V,\n803\t        b: ZERO_V,\n804\t        r: 0.0,\n805\t    };\n806\t    cap.a = c2V(b1, b2);\n807\t    cap.b = c2V(b3, b4);\n808\t    cap.r = b5;\n809\t\n810\t    if reverse != 0 {\n811\t        c2GJK(\n812\t            &cap as *const c2Capsule as *const c_void,\n813\t            C2_TYPE_CAPSULE,\n814\t            ptr::null(),\n815\t            &bb as *const c2AABB as *const c_void,\n816\t            C2_TYPE_AABB,\n817\t            ptr::null(),\n818\t            &mut a,\n819\t            &mut b,\n820\t            1,\n821\t            ptr::null_mut(),\n822\t            ptr::null_mut(),\n823\t        );\n824\t    } else {\n825\t        c2GJK(\n826\t            &bb as *const c2AABB as *const c_void,\n827\t            C2_TYPE_AABB,\n828\t            ptr::null(),\n829\t            &cap as *const c2Capsule as *const c_void,\n830\t            C2_TYPE_CAPSULE,\n831\t            ptr::null(),\n832\t            &mut a,\n833\t            &mut b,\n834\t            1,\n835\t            ptr::null_mut(),\n836\t            ptr::null_mut(),\n837\t        );\n838\t    }\n839\t\n840\t    // The C never dereferences `a9` / `b9`; neither do we.\n841\t    let _ = (a9, b9);\n842\t}\n843\t\n844\t// ---------------------------------------------------------------------------\n845\t// math\n846\t// ---------------------------------------------------------------------------\n847\t\n848\t/// Single-precision square root, matching libm's `sqrtf` bit for bit\n849\t/// (`sqrtss` on x86-64, correctly rounded per IEEE-754).\n850\t#[inline]\n851\tfn sqrtf(x: f32) -> f32 {\n852\t    x.sqrt()\n853\t}\n854\t\n855\t/// Identity that is opaque to the optimiser: used to pin down the evaluation\n856\t/// order of a float expression so that it matches what the C compiler emits.\n857\t/// A volatile read is a language-level guarantee (unlike an optimiser hint):\n858\t/// the value must really be materialised before it is read back.\n859\t#[inline(always)]\n860\tfn opaque(x: f32) -> f32 {\n861\t    let slot = x;\n862\t    unsafe { ptr::read_volatile(&slot) }\n863\t}\n864\t"}]},"parent_tool_use_id":null,"session_id":"6c917cb3-3512-41c1-87cf-ea90c6ebff2f","uuid":"7ad815c6-3695-467d-bcf6-d96e7ff323fe","timestamp":"2026-09-05T07:58:25.390Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-D30ByW/translation/src/lib.rs","content":"//! Rust translation of c_src/src/lib.c (tinyc2-style 2D GJK routines).\n//!\n//! The C library is compiled by CMake as one shared object that exports every\n//! non-static function in `src/lib.c`.  This crate reproduces that exact ABI:\n//! same symbol names, same C signatures, same struct layouts, and bit-for-bit\n//! identical floating point behaviour (all arithmetic is plain IEEE-754\n//! single precision, no fused operations, no reassociation).\n//!\n//! Bugs / quirks in the original C are preserved verbatim, including:\n//!   * the inverted cache-validity test in `c2GJK`\n//!   * `gjk_cache` never writing through its `a9` / `b9` out-parameters\n//!   * NaN-propagating min/max ordering in `c2Maxv` / `c2Minv`\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n\nuse core::ffi::{c_char, c_int, c_uint, c_void};\nuse core::ptr;\n\n// ---------------------------------------------------------------------------\n// C2_TYPE (C enum -> unsigned int on the SysV x86-64 ABI)\n// ---------------------------------------------------------------------------\n\npub const C2_TYPE_CIRCLE: c_uint = 0;\npub const C2_TYPE_AABB: c_uint = 1;\npub const C2_TYPE_CAPSULE: c_uint = 2;\n\n// ---------------------------------------------------------------------------\n// Public / internal structs.  Layouts verified against the C compiler:\n//   c2v = 8, c2r = 8, c2x = 16, c2Circle = 12, c2AABB = 16, c2Capsule = 20,\n//   c2GJKCache = 36 (div @ 32), c2Proxy = 72 (verts @ 8),\n//   c2sv = 36, c2Simplex = 152 (b @ 36, div @ 144, count @ 148)\n// ---------------------------------------------------------------------------\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2GJKCache {\n    pub metric: f32,\n    pub count: c_int,\n    pub iA: [c_int; 3],\n    pub iB: [c_int; 3],\n    pub div: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Proxy {\n    pub radius: f32,\n    pub count: c_int,\n    pub verts: [c2v; 8],\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2sv {\n    pub sA: c2v,\n    pub sB: c2v,\n    pub p: c2v,\n    pub u: f32,\n    pub iA: c_int,\n    pub iB: c_int,\n}\n\n/// The C declaration is `c2sv a, b, c, d;` -- four consecutive `c2sv` values,\n/// which `c2GJK` walks with `c2sv *verts = &s.a;`.  The array below is\n/// layout-identical.\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Simplex {\n    pub verts: [c2sv; 4],\n    pub div: f32,\n    pub count: c_int,\n}\n\nconst ZERO_V: c2v = c2v { x: 0.0, y: 0.0 };\n\nconst ZERO_SV: c2sv = c2sv {\n    sA: ZERO_V,\n    sB: ZERO_V,\n    p: ZERO_V,\n    u: 0.0,\n    iA: 0,\n    iB: 0,\n};\n\n// FLT_MAX as spelled in the C source.\nconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_6e38_f32;\n// FLT_EPSILON as spelled in the C source.\nconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7_f32;\n\n// ---------------------------------------------------------------------------\n// Vector helpers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a = ZERO_V;\n    a.x = x;\n    a.y = y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n    let mut a = a;\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    let mut r = c2r { c: 0.0, s: 0.0 };\n    r.c = 1.0f32;\n    r.s = 0.0;\n    r\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    let mut x = c2x {\n        p: ZERO_V,\n        r: c2r { c: 0.0, s: 0.0 },\n    };\n    x.p = c2V(0.0, 0.0);\n    x.r = c2RotIdentity();\n    x\n}\n\n// ---------------------------------------------------------------------------\n// Proxies\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    *out.offset(0) = (*bb).min;\n    *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n    *out.offset(2) = (*bb).max;\n    *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, r#type: c_uint, p: *mut c2Proxy) {\n    match r#type {\n        C2_TYPE_CIRCLE => {\n            let c = shape as *mut c2Circle;\n            (*p).radius = (*c).r;\n            (*p).count = 1;\n            (*p).verts[0] = (*c).p;\n        }\n        C2_TYPE_AABB => {\n            let bb = shape as *mut c2AABB;\n            (*p).radius = 0.0;\n            (*p).count = 4;\n            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n        }\n        C2_TYPE_CAPSULE => {\n            let c = shape as *mut c2Capsule;\n            (*p).radius = (*c).r;\n            (*p).count = 2;\n            (*p).verts[0] = (*c).a;\n            (*p).verts[1] = (*c).b;\n        }\n        // No `default:` label in the C switch -- nothing is written.\n        _ => {}\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Simplex helpers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    sqrtf(c2Dot(a, a))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    a.x * b.y - a.y * b.x\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    match (*s).count {\n        2 => c2Len(c2Sub((*s).verts[1].p, (*s).verts[0].p)),\n        3 => c2Det2(\n            c2Sub((*s).verts[1].p, (*s).verts[0].p),\n            c2Sub((*s).verts[2].p, (*s).verts[0].p),\n        ),\n        // `default:` falls through to `case 1:` in the C source.\n        _ => 0.0,\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    let a = (*s).verts[0].p;\n    let b = (*s).verts[1].p;\n    let u = c2Dot(b, c2Sub(b, a));\n    let v = c2Dot(a, c2Sub(a, b));\n    if v <= 0.0 {\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if u <= 0.0 {\n        (*s).verts[0] = (*s).verts[1];\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else {\n        (*s).verts[0].u = u;\n        (*s).verts[1].u = v;\n        (*s).div = u + v;\n        (*s).count = 2;\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n    let a = (*s).verts[0].p;\n    let b = (*s).verts[1].p;\n    let c = (*s).verts[2].p;\n    let uAB = c2Dot(b, c2Sub(b, a));\n    let vAB = c2Dot(a, c2Sub(a, b));\n    let uBC = c2Dot(c, c2Sub(c, b));\n    let vBC = c2Dot(b, c2Sub(b, c));\n    let uCA = c2Dot(a, c2Sub(a, c));\n    let vCA = c2Dot(c, c2Sub(c, a));\n    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n    let uABC = c2Det2(b, c) * area;\n    let vABC = c2Det2(c, a) * area;\n    let wABC = c2Det2(a, b) * area;\n    if vAB <= 0.0 && uCA <= 0.0 {\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uAB <= 0.0 && vBC <= 0.0 {\n        (*s).verts[0] = (*s).verts[1];\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uBC <= 0.0 && vCA <= 0.0 {\n        (*s).verts[0] = (*s).verts[2];\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n        (*s).verts[0].u = uAB;\n        (*s).verts[1].u = vAB;\n        (*s).div = uAB + vAB;\n        (*s).count = 2;\n    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n        (*s).verts[0] = (*s).verts[1];\n        (*s).verts[1] = (*s).verts[2];\n        (*s).verts[0].u = uBC;\n        (*s).verts[1].u = vBC;\n        (*s).div = uBC + vBC;\n        (*s).count = 2;\n    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n        (*s).verts[1] = (*s).verts[0];\n        (*s).verts[0] = (*s).verts[2];\n        (*s).verts[0].u = uCA;\n        (*s).verts[1].u = vCA;\n        (*s).div = uCA + vCA;\n        (*s).count = 2;\n    } else {\n        (*s).verts[0].u = uABC;\n        (*s).verts[1].u = vABC;\n        (*s).verts[2].u = wABC;\n        (*s).div = uABC + vABC + wABC;\n        (*s).count = 3;\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    c2V(-a.x, -a.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    let mut b = ZERO_V;\n    b.x = -a.y;\n    b.y = a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    let mut b = ZERO_V;\n    b.x = a.y;\n    b.y = -a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    match (*s).count {\n        1 => c2Neg((*s).verts[0].p),\n        2 => {\n            let ab = c2Sub((*s).verts[1].p, (*s).verts[0].p);\n            if c2Det2(ab, c2Neg((*s).verts[0].p)) > 0.0 {\n                return c2Skew(ab);\n            }\n            c2CCW90(ab)\n        }\n        // case 3 and default\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    let mut imax: c_int = 0;\n    let mut dmax = c2Dot(*verts.offset(0), d);\n    let mut i: c_int = 1;\n    while i < count {\n        let dot = c2Dot(*verts.offset(i as isize), d);\n        if dot > dmax {\n            imax = i;\n            dmax = dot;\n        }\n        i += 1;\n    }\n    imax\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n    let den = 1.0f32 / (*s).div;\n    match (*s).count {\n        1 => {\n            *a = (*s).verts[0].sA;\n            *b = (*s).verts[0].sB;\n        }\n        2 => {\n            *a = c2Add(\n                c2Mulvs((*s).verts[0].sA, den * (*s).verts[0].u),\n                c2Mulvs((*s).verts[1].sA, den * (*s).verts[1].u),\n            );\n            *b = c2Add(\n                c2Mulvs((*s).verts[0].sB, den * (*s).verts[0].u),\n                c2Mulvs((*s).verts[1].sB, den * (*s).verts[1].u),\n            );\n        }\n        3 => {\n            *a = c2Add(\n                c2Add(\n                    c2Mulvs((*s).verts[0].sA, den * (*s).verts[0].u),\n                    c2Mulvs((*s).verts[1].sA, den * (*s).verts[1].u),\n                ),\n                c2Mulvs((*s).verts[2].sA, den * (*s).verts[2].u),\n            );\n            *b = c2Add(\n                c2Add(\n                    c2Mulvs((*s).verts[0].sB, den * (*s).verts[0].u),\n                    c2Mulvs((*s).verts[1].sB, den * (*s).verts[1].u),\n                ),\n                c2Mulvs((*s).verts[2].sB, den * (*s).verts[2].u),\n            );\n        }\n        _ => {\n            *a = c2V(0.0, 0.0);\n            *b = c2V(0.0, 0.0);\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n    let den = 1.0f32 / (*s).div;\n    match (*s).count {\n        1 => (*s).verts[0].p,\n        2 => c2Add(\n            c2Mulvs((*s).verts[0].p, den * (*s).verts[0].u),\n            c2Mulvs((*s).verts[1].p, den * (*s).verts[1].u),\n        ),\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    // `opaque` stops