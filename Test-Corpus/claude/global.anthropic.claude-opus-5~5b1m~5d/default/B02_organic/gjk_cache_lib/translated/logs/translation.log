n\tcase 4: r = (float)(int32_t)rnd() / 65536.0f; break;\n\tcase 5: { uint32_t u = 0x7f800000u; float f; memcpy(&f, &u, 4);\n\t\t  r = (rnd() & 1) ? f : -f; break; }                /* +-inf */\n\tcase 6: { uint32_t u = 0x7fc00000u; memcpy(&r, &u, 4); break; }  /* nan */\n\tdefault: r = (float)((double)(int32_t)rnd() / 2147483.0); break;\n\t}\n\tif (nanmode < 2) {\n\t\tif (is_nan(r)) {\n\t\t\tif (nanmode == 0) return 1.5f;\n\t\t\tuint32_t u = 0x7fc00000u; memcpy(&r, &u, 4); return r;\n\t\t}\n\t\tif (nanmode == 0 && is_inf(r)) return 2.5f;\n\t}\n\treturn r;\n}","originalFile":"/* Differential tester: dlopen the C .so and the Rust .so, call every exported\n * symbol with identical (bit-for-bit) inputs, compare all outputs bitwise. */\n#define _GNU_SOURCE\n#include <dlfcn.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n\ntypedef struct c2v { float x, y; } c2v;\ntypedef struct c2r { float c, s; } c2r;\ntypedef struct c2x { c2v p; c2r r; } c2x;\ntypedef struct c2Circle { c2v p; float r; } c2Circle;\ntypedef struct c2AABB { c2v min, max; } c2AABB;\ntypedef struct c2Capsule { c2v a, b; float r; } c2Capsule;\ntypedef struct { float metric; int count; int iA[3]; int iB[3]; float div; } c2GJKCache;\ntypedef struct { float radius; int count; c2v verts[8]; } c2Proxy;\ntypedef struct { c2v sA, sB, p; float u; int iA, iB; } c2sv;\ntypedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;\n\ntypedef c2v  (*fn_vff)(float, float);\ntypedef c2v  (*fn_vvf)(c2v, float);\ntypedef c2v  (*fn_vvv)(c2v, c2v);\ntypedef c2v  (*fn_vvvv)(c2v, c2v, c2v);\ntypedef c2v  (*fn_vv)(c2v);\ntypedef float(*fn_fvv)(c2v, c2v);\ntypedef float(*fn_fv)(c2v);\ntypedef c2r  (*fn_r0)(void);\ntypedef c2x  (*fn_x0)(void);\ntypedef void (*fn_bbv)(c2v *, c2AABB *);\ntypedef void (*fn_mkproxy)(const void *, unsigned, c2Proxy *);\ntypedef float(*fn_fsimp)(c2Simplex *);\ntypedef c2v  (*fn_rv)(c2r, c2v);\ntypedef c2v  (*fn_xv)(c2x, c2v);\ntypedef void (*fn_simp)(c2Simplex *);\ntypedef c2v  (*fn_vsimp)(c2Simplex *);\ntypedef int  (*fn_support)(const c2v *, int, c2v);\ntypedef void (*fn_witness)(c2Simplex *, c2v *, c2v *);\ntypedef float(*fn_gjk)(const void *, unsigned, const c2x *, const void *, unsigned,\n                       const c2x *, c2v *, c2v *, int, int *, c2GJKCache *);\ntypedef void (*fn_gjkcache)(char, c2v *, c2v *, float, float, float, float,\n                            float, float, float, float, float);\n\nstatic void *hc, *hr;\nstatic long failures = 0, checks = 0;\n\n/* per-name failure tally */\n#define MAXN 64\nstatic const char *names[MAXN];\nstatic long ncnt[MAXN];\nstatic int nnames = 0;\nstatic void tally(const char *what) {\n\tfor (int i = 0; i < nnames; ++i)\n\t\tif (strcmp(names[i], what) == 0) { ncnt[i]++; return; }\n\tif (nnames < MAXN) { names[nnames] = what; ncnt[nnames] = 1; nnames++; }\n}\nstatic void report(void) {\n\tfor (int i = 0; i < nnames; ++i)\n\t\tfprintf(stderr, \"  %-24s %ld\\n\", names[i], ncnt[i]);\n}\n\nstatic void *sym(void *h, const char *n) {\n\tvoid *p = dlsym(h, n);\n\tif (!p) { fprintf(stderr, \"missing symbol %s: %s\\n\", n, dlerror()); exit(2); }\n\treturn p;\n}\n\nstatic void cmp(const char *what, const void *a, const void *b, size_t n) {\n\t++checks;\n\tif (memcmp(a, b, n) != 0) {\n\t\t++failures;\n\t\ttally(what);\n\t\tif (failures <= 12) {\n\t\t\tconst unsigned char *pa = a, *pb = b;\n\t\t\tfprintf(stderr, \"MISMATCH %s: C=\", what);\n\t\t\tfor (size_t i = 0; i < n; ++i) fprintf(stderr, \"%02x\", pa[i]);\n\t\t\tfprintf(stderr, \" R=\");\n\t\t\tfor (size_t i = 0; i < n; ++i) fprintf(stderr, \"%02x\", pb[i]);\n\t\t\tfprintf(stderr, \"\\n\");\n\t\t}\n\t}\n}\n\n/* ---- deterministic RNG ---- */\nstatic uint64_t st = 0x243F6A8885A308D3ULL;\nstatic uint32_t rnd(void) {\n\tst ^= st << 13; st ^= st >> 7; st ^= st << 17;\n\treturn (uint32_t)(st >> 32);\n}\n\nstatic const float pool[] = {\n\t0.0f, -0.0f, 1.0f, -1.0f, 0.5f, -0.5f, 15.0f, 10.0f, 100.0f, -25.0f, 75.0f,\n\t1e-8f, -1e-8f, 1e8f, -1e8f, 1.1920929e-7f, 3.4028235e38f, -3.4028235e38f,\n\t1.4e-45f, -1.4e-45f, 1e-30f, 3.0f, -3.0f, 0.1f, -0.1f, 1e20f, -1e20f,\n\t1e-20f, 2.0f, -2.0f, 1e30f, 123.456f, -987.654f, 0.3333333f,\n};\n#define NPOOL (sizeof(pool)/sizeof(pool[0]))\n\nstatic float rf(void) {\n\tuint32_t k = rnd();\n\tswitch (k % 10) {\n\tcase 0: case 1: case 2: return pool[rnd() % NPOOL];\n\tcase 3: { /* raw random bits (may be nan/inf/denormal) */\n\t\tuint32_t u = rnd(); float f; memcpy(&f, &u, 4); return f; }\n\tcase 4: { float f = (float)(int32_t)rnd() / 65536.0f; return f; }\n\tcase 5: { uint32_t u = 0x7f800000u; float f; memcpy(&f, &u, 4);\n\t\t  return (rnd() & 1) ? f : -f; }                    /* +-inf */\n\tcase 6: { uint32_t u = 0x7fc00000u; float f; memcpy(&f, &u, 4); return f; } /* nan */\n\tdefault: return (float)((double)(int32_t)rnd() / 2147483.0);\n\t}\n}\nstatic c2v rv(void) { c2v v; v.x = rf(); v.y = rf(); return v; }\nstatic c2r rr(void) { c2r r; r.c = rf(); r.s = rf(); return r; }\nstatic c2x rx(void) { c2x x; x.p = rv(); x.r = rr(); return x; }\n\nstatic void rand_simplex(c2Simplex *s) {\n\tunsigned char *p = (unsigned char *)s;\n\tfor (size_t i = 0; i < sizeof(*s); ++i) p[i] = (unsigned char)rnd();\n\t/* make the float members \"reasonable\" often, keep count in a sane range */\n\tc2sv *v = &s->a;\n\tfor (int i = 0; i < 4; ++i) {\n\t\tif (rnd() & 3) { v[i].sA = rv(); v[i].sB = rv(); v[i].p = rv(); v[i].u = rf(); }\n\t\tv[i].iA = (int)(rnd() % 8);\n\t\tv[i].iB = (int)(rnd() % 8);\n\t}\n\tif (rnd() & 3) s->div = rf();\n\ts->count = (int)(rnd() % 6) - 1;   /* -1..4 exercises default: branches */\n}\n\nint main(void) {\n\thc = dlopen(\"./libharvest-work-d3wA6F.so\", RTLD_NOW | RTLD_LOCAL);\n\tif (!hc) { fprintf(stderr, \"C: %s\\n\", dlerror()); return 2; }\n\thr = dlopen(\"../translation/target/release/libtranslation.so\", RTLD_NOW | RTLD_LOCAL);\n\tif (!hr) { fprintf(stderr, \"R: %s\\n\", dlerror()); return 2; }\n\n#define P(name, T) T name##_c = (T)sym(hc, #name), name##_r = (T)sym(hr, #name)\n\tP(c2V, fn_vff); P(c2Mulvs, fn_vvf); P(c2Maxv, fn_vvv); P(c2Minv, fn_vvv);\n\tP(c2Clampv, fn_vvvv); P(c2Sub, fn_vvv); P(c2Dot, fn_fvv);\n\tP(c2RotIdentity, fn_r0); P(c2xIdentity, fn_x0); P(c2BBVerts, fn_bbv);\n\tP(c2MakeProxy, fn_mkproxy); P(c2Len, fn_fv); P(c2Det2, fn_fvv);\n\tP(c2GJKSimplexMetric, fn_fsimp); P(c2Mulrv, fn_rv); P(c2Add, fn_vvv);\n\tP(c2Mulxv, fn_xv); P(c22, fn_simp); P(c23, fn_simp); P(c2Neg, fn_vv);\n\tP(c2Skew, fn_vv); P(c2CCW90, fn_vv); P(c2D, fn_vsimp); P(c2Support, fn_support);\n\tP(c2Witness, fn_witness); P(c2Div, fn_vvf); P(c2Norm, fn_vv); P(c2L, fn_vsimp);\n\tP(c2MulrvT, fn_rv); P(c2GJK, fn_gjk); P(gjk_cache, fn_gjkcache);\n#undef P\n\n\t/* ---- nullary ---- */\n\t{ c2r a = c2RotIdentity_c(), b = c2RotIdentity_r(); cmp(\"c2RotIdentity\", &a, &b, sizeof a); }\n\t{ c2x a = c2xIdentity_c(), b = c2xIdentity_r(); cmp(\"c2xIdentity\", &a, &b, sizeof a); }\n\n\tfor (int t = 0; t < 300000; ++t) {\n\t\tfloat f1 = rf(), f2 = rf();\n\t\tc2v v1 = rv(), v2 = rv(), v3 = rv();\n\t\tc2r r1 = rr();\n\t\tc2x x1 = rx();\n\n\t\t{ c2v a = c2V_c(f1, f2),        b = c2V_r(f1, f2);        cmp(\"c2V\", &a, &b, 8); }\n\t\t{ c2v a = c2Mulvs_c(v1, f1),    b = c2Mulvs_r(v1, f1);    cmp(\"c2Mulvs\", &a, &b, 8); }\n\t\t{ c2v a = c2Maxv_c(v1, v2),     b = c2Maxv_r(v1, v2);     cmp(\"c2Maxv\", &a, &b, 8); }\n\t\t{ c2v a = c2Minv_c(v1, v2),     b = c2Minv_r(v1, v2);     cmp(\"c2Minv\", &a, &b, 8); }\n\t\t{ c2v a = c2Clampv_c(v1,v2,v3), b = c2Clampv_r(v1,v2,v3); cmp(\"c2Clampv\", &a, &b, 8); }\n\t\t{ c2v a = c2Sub_c(v1, v2),      b = c2Sub_r(v1, v2);      cmp(\"c2Sub\", &a, &b, 8); }\n\t\t{ c2v a = c2Add_c(v1, v2),      b = c2Add_r(v1, v2);      cmp(\"c2Add\", &a, &b, 8); }\n\t\t{ c2v a = c2Neg_c(v1),          b = c2Neg_r(v1);          cmp(\"c2Neg\", &a, &b, 8); }\n\t\t{ c2v a = c2Skew_c(v1),         b = c2Skew_r(v1);         cmp(\"c2Skew\", &a, &b, 8); }\n\t\t{ c2v a = c2CCW90_c(v1),        b = c2CCW90_r(v1);        cmp(\"c2CCW90\", &a, &b, 8); }\n\t\t{ c2v a = c2Div_c(v1, f1),      b = c2Div_r(v1, f1);      cmp(\"c2Div\", &a, &b, 8); }\n\t\t{ c2v a = c2Norm_c(v1),         b = c2Norm_r(v1);         cmp(\"c2Norm\", &a, &b, 8); }\n\t\t{ c2v a = c2Mulrv_c(r1, v1),    b = c2Mulrv_r(r1, v1);    cmp(\"c2Mulrv\", &a, &b, 8); }\n\t\t{ c2v a = c2MulrvT_c(r1, v1),   b = c2MulrvT_r(r1, v1);   cmp(\"c2MulrvT\", &a, &b, 8); }\n\t\t{ c2v a = c2Mulxv_c(x1, v1),    b = c2Mulxv_r(x1, v1);    cmp(\"c2Mulxv\", &a, &b, 8); }\n\t\t{ float a = c2Dot_c(v1, v2),  b = c2Dot_r(v1, v2);  cmp(\"c2Dot\", &a, &b, 4); }\n\t\t{ float a = c2Det2_c(v1, v2), b = c2Det2_r(v1, v2); cmp(\"c2Det2\", &a, &b, 4); }\n\t\t{ float a = c2Len_c(v1),      b = c2Len_r(v1);      cmp(\"c2Len\", &a, &b, 4); }\n\n\t\t/* c2BBVerts */\n\t\t{\n\t\t\tc2AABB bb; bb.min = v1; bb.max = v2;\n\t\t\tc2v oa[4], ob[4];\n\t\t\tmemset(oa, 0xA5, sizeof oa); memset(ob, 0xA5, sizeof ob);\n\t\t\tc2BBVerts_c(oa, &bb); c2BBVerts_r(ob, &bb);\n\t\t\tcmp(\"c2BBVerts\", oa, ob, sizeof oa);\n\t\t}\n\n\t\t/* c2MakeProxy over all shape types plus out-of-range type values */\n\t\t{\n\t\t\tunsigned ty = rnd() % 6;\n\t\t\tunsigned char shape[32];\n\t\t\tfor (size_t i = 0; i < sizeof shape; ++i) shape[i] = (unsigned char)rnd();\n\t\t\tif (rnd() & 1) { /* well-formed floats */\n\t\t\t\tc2Capsule cp; cp.a = v1; cp.b = v2; cp.r = f1;\n\t\t\t\tmemcpy(shape, &cp, sizeof cp);\n\t\t\t}\n\t\t\tc2Proxy pa, pb;\n\t\t\tmemset(&pa, 0x5C, sizeof pa); memset(&pb, 0x5C, sizeof pb);\n\t\t\tc2MakeProxy_c(shape, ty, &pa); c2MakeProxy_r(shape, ty, &pb);\n\t\t\tcmp(\"c2MakeProxy\", &pa, &pb, sizeof pa);\n\t\t}\n\n\t\t/* c2Support */\n\t\t{\n\t\t\tc2v vs[8]; for (int i = 0; i < 8; ++i) vs[i] = rv();\n\t\t\tint n = (int)(rnd() % 8) + 1;\n\t\t\tint a = c2Support_c(vs, n, v1), b = c2Support_r(vs, n, v1);\n\t\t\tcmp(\"c2Support\", &a, &b, sizeof a);\n\t\t}\n\n\t\t/* simplex mutators / accessors: identical byte-for-byte input state */\n\t\t{\n\t\t\tc2Simplex s0; rand_simplex(&s0);\n\t\t\tc2Simplex sa = s0, sb = s0;\n\t\t\tc22_c(&sa); c22_r(&sb); cmp(\"c22\", &sa, &sb, sizeof sa);\n\t\t}\n\t\t{\n\t\t\tc2Simplex s0; rand_simplex(&s0);\n\t\t\tc2Simplex sa = s0, sb = s0;\n\t\t\tc23_c(&sa); c23_r(&sb); cmp(\"c23\", &sa, &sb, sizeof sa);\n\t\t}\n\t\t{\n\t\t\tc2Simplex s0; rand_simplex(&s0);\n\t\t\tc2Simplex sa = s0, sb = s0;\n\t\t\tfloat ra = c2GJKSimplexMetric_c(&sa), rb = c2GJKSimplexMetric_r(&sb);\n\t\t\tcmp(\"c2GJKSimplexMetric\", &ra, &rb, 4);\n\t\t\tcmp(\"c2GJKSimplexMetric/state\", &sa, &sb, sizeof sa);\n\t\t}\n\t\t{\n\t\t\tc2Simplex s0; rand_simplex(&s0);\n\t\t\tc2Simplex sa = s0, sb = s0;\n\t\t\tc2v ra = c2D_c(&sa), rb = c2D_r(&sb);\n\t\t\tcmp(\"c2D\", &ra, &rb, 8); cmp(\"c2D/state\", &sa, &sb, sizeof sa);\n\t\t}\n\t\t{\n\t\t\tc2Simplex s0; rand_simplex(&s0);\n\t\t\tc2Simplex sa = s0, sb = s0;\n\t\t\tc2v ra = c2L_c(&sa), rb = c2L_r(&sb);\n\t\t\tcmp(\"c2L\", &ra, &rb, 8); cmp(\"c2L/state\", &sa, &sb, sizeof sa);\n\t\t}\n\t\t{\n\t\t\tc2Simplex s0; rand_simplex(&s0);\n\t\t\tc2Simplex sa = s0, sb = s0;\n\t\t\tc2v oa[2], ob[2];\n\t\t\tmemset(oa, 0x3C, sizeof oa); memset(ob, 0x3C, sizeof ob);\n\t\t\tc2Witness_c(&sa, &oa[0], &oa[1]);\n\t\t\tc2Witness_r(&sb, &ob[0], &ob[1]);\n\t\t\tcmp(\"c2Witness\", oa, ob, sizeof oa);\n\t\t\tcmp(\"c2Witness/state\", &sa, &sb, sizeof sa);\n\t\t}\n\t}\n\n\t/* ---- c2GJK: full end-to-end, all shape/type/transform/cache combos ---- */\n\tfor (int t = 0; t < 200000; ++t) {\n\t\tunsigned char sa_[32], sb_[32];\n\t\tunsigned tya = rnd() % 3, tyb = rnd() % 3;\n\t\tc2Circle ci; c2AABB bb; c2Capsule cp;\n\t\tci.p = rv(); ci.r = rf();\n\t\tbb.min = rv(); bb.max = rv();\n\t\tcp.a = rv(); cp.b = rv(); cp.r = rf();\n\t\tmemset(sa_, 0, sizeof sa_); memset(sb_, 0, sizeof sb_);\n\t\tif (tya == 0) memcpy(sa_, &ci, sizeof ci);\n\t\telse if (tya == 1) memcpy(sa_, &bb, sizeof bb);\n\t\telse memcpy(sa_, &cp, sizeof cp);\n\t\tc2Circle ci2; c2AABB bb2; c2Capsule cp2;\n\t\tci2.p = rv(); ci2.r = rf();\n\t\tbb2.min = rv(); bb2.max = rv();\n\t\tcp2.a = rv(); cp2.b = rv