nst u8 {\n641\t    unsafe {\n642\t        let len = cp_make32((*png).p);\n643\t        let start = (*png).p;\n644\t        if memcmp(\n645\t            start.wrapping_offset(4) as *const c_void,\n646\t            chunk.as_ptr() as *const c_void,\n647\t            4,\n648\t        ) == 0\n649\t            && len >= minlen\n650\t        {\n651\t            // C: `int offset = len + 12;` -- signed, so it sign-extends.\n652\t            let offset = len.wrapping_add(12) as c_int;\n653\t            if (*png).p.wrapping_offset(offset as isize) <= (*png).end {\n654\t                (*png).p = (*png).p.wrapping_offset(offset as isize);\n655\t                return start.wrapping_offset(8);\n656\t            }\n657\t        }\n658\t        ptr::null()\n659\t    }\n660\t}\n661\t\n662\t/// `static const uint8_t *cp_find(cp_raw_png_t *png, const char *chunk, uint32_t minlen)`\n663\tunsafe fn cp_find(png: *mut cp_raw_png_t, chunk: &[u8; 4], minlen: u32) -> *const u8 {\n664\t    unsafe {\n665\t        while (*png).p < (*png).end {\n666\t            let len = cp_make32((*png).p);\n667\t            let start = (*png).p;\n668\t            // C: `png->p += len + 12;` -- unsigned, so it zero-extends.\n669\t            (*png).p = (*png).p.wrapping_add(len.wrapping_add(12) as usize);\n670\t            if memcmp(\n671\t                start.wrapping_offset(4) as *const c_void,\n672\t                chunk.as_ptr() as *const c_void,\n673\t                4,\n674\t            ) == 0\n675\t                && len >= minlen\n676\t                && (*png).p <= (*png).end\n677\t            {\n678\t                return start.wrapping_offset(8);\n679\t            }\n680\t        }\n681\t        ptr::null()\n682\t    }\n683\t}\n684\t\n685\t/// `static int cp_unfilter(int w, int h, int bpp, uint8_t *raw)`\n686\tunsafe fn cp_unfilter(w: c_int, h: c_int, bpp: c_int, raw: *mut u8) -> c_int {\n687\t    unsafe {\n688\t        let len = w.wrapping_mul(bpp);\n689\t        let mut raw = raw;\n690\t        let mut prev: *mut u8;\n691\t        let mut x: c_int;\n692\t        if h > 0 {\n693\t            let filter = *raw;\n694\t            raw = raw.wrapping_offset(1);\n695\t            match filter {\n696\t                0 => {}\n697\t                1 => {\n698\t                    x = bpp;\n699\t                    while x < len {\n700\t                        *raw.offset(x as isize) = (*raw.offset(x as isize))\n701\t                            .wrapping_add(*raw.offset((x - bpp) as isize));\n702\t                        x += 1;\n703\t                    }\n704\t                }\n705\t                2 => {}\n706\t                3 => {\n707\t                    x = bpp;\n708\t                    while x < len {\n709\t                        *raw.offset(x as isize) = (*raw.offset(x as isize))\n710\t                            .wrapping_add(*raw.offset((x - bpp) as isize) / 2);\n711\t                        x += 1;\n712\t                    }\n713\t                }\n714\t                4 => {\n715\t                    x = bpp;\n716\t                    while x < len {\n717\t                        *raw.offset(x as isize) = (*raw.offset(x as isize))\n718\t                            .wrapping_add(cp_paeth(*raw.offset((x - bpp) as isize), 0, 0));\n719\t                        x += 1;\n720\t                    }\n721\t                }\n722\t                _ => return 0,\n723\t            }\n724\t        }\n725\t        prev = raw;\n726\t        raw = raw.wrapping_offset(len as isize);\n727\t        let mut y: c_int = 1;\n728\t        while y < h {\n729\t            let filter = *raw;\n730\t            raw = raw.wrapping_offset(1);\n731\t            match filter {\n732\t                0 => {}\n733\t                1 => {\n734\t                    x = 0;\n735\t                    while x < bpp {\n736\t                        *raw.offset(x as isize) = (*raw.offset(x as isize)).wrapping_add(0);\n737\t                        x += 1;\n738\t                    }\n739\t                    while x < len {\n740\t                        *raw.offset(x as isize) = (*raw.offset(x as isize))\n741\t                            .wrapping_add(*raw.offset((x - bpp) as isize));\n742\t                        x += 1;\n743\t                    }\n744\t                }\n745\t                2 => {\n746\t                    x = 0;\n747\t                    while x < bpp {\n748\t                        *raw.offset(x as isize) =\n749\t                            (*raw.offset(x as isize)).wrapping_add(*prev.offset(x as isize));\n750\t                        x += 1;\n751\t                    }\n752\t                    while x < len {\n753\t                        *raw.offset(x as isize) =\n754\t                            (*raw.offset(x as isize)).wrapping_add(*prev.offset(x as isize));\n755\t                        x += 1;\n756\t                    }\n757\t                }\n758\t                3 => {\n759\t                    x = 0;\n760\t                    while x < bpp {\n761\t                        *raw.offset(x as isize) =\n762\t                            (*raw.offset(x as isize)).wrapping_add(*prev.offset(x as isize) / 2);\n763\t                        x += 1;\n764\t                    }\n765\t                    while x < len {\n766\t                        let sum = *raw.offset((x - bpp) as isize) as c_int\n767\t                            + *prev.offset(x as isize) as c_int;\n768\t                        *raw.offset(x as isize) =\n769\t                            (*raw.offset(x as isize)).wrapping_add((sum / 2) as u8);\n770\t                        x += 1;\n771\t                    }\n772\t                }\n773\t                4 => {\n774\t                    x = 0;\n775\t                    while x < bpp {\n776\t                        *raw.offset(x as isize) =\n777\t                            (*raw.offset(x as isize)).wrapping_add(*prev.offset(x as isize));\n778\t                        x += 1;\n779\t                    }\n780\t                    while x < len {\n781\t                        *raw.offset(x as isize) = (*raw.offset(x as isize)).wrapping_add(cp_paeth(\n782\t                            *raw.offset((x - bpp) as isize),\n783\t                            *prev.offset(x as isize),\n784\t                            *prev.offset((x - bpp) as isize),\n785\t                        ));\n786\t                        x += 1;\n787\t                    }\n788\t                }\n789\t                _ => return 0,\n790\t            }\n791\t            y += 1;\n792\t            prev = raw;\n793\t            raw = raw.wrapping_offset(len as isize);\n794\t        }\n795\t        1\n796\t    }\n797\t}\n798\t\n799\t/// `static void cp_convert(int bpp, int w, int h, uint8_t *src, cp_pixel_t *dst)`\n800\tunsafe fn cp_convert(bpp: c_int, w: c_int, h: c_int, src: *mut u8, dst: *mut cp_pixel_t) {\n801\t    unsafe {\n802\t        let mut src = src;\n803\t        let mut dst = dst;\n804\t        for _y in 0..h {\n805\t            src = src.wrapping_offset(1);\n806\t            let mut x: c_int = 0;\n807\t            while x < w {\n808\t                match bpp {\n809\t                    1 => {\n810\t                        *dst = cp_make_pixel(*src, *src, *src);\n811\t                        dst = dst.wrapping_offset(1);\n812\t                    }\n813\t                    2 => {\n814\t                        *dst = cp_make_pixel_a(*src, *src, *src, *src.offset(1));\n815\t                        dst = dst.wrapping_offset(1);\n816\t                    }\n817\t                    3 => {\n818\t                        *dst = cp_make_pixel(*src, *src.offset(1), *src.offset(2));\n819\t                        dst = dst.wrapping_offset(1);\n820\t                    }\n821\t                    4 => {\n822\t                        *dst =\n823\t                            cp_make_pixel_a(*src, *src.offset(1), *src.offset(2), *src.offset(3));\n824\t                        dst = dst.wrapping_offset(1);\n825\t                    }\n826\t                    _ => {}\n827\t                }\n828\t                x += 1;\n829\t                src = src.wrapping_offset(bpp as isize);\n830\t            }\n831\t        }\n832\t    }\n833\t}\n834\t\n835\t/// `static uint8_t cp_get_alpha_for_indexed_image(int index, const uint8_t *trns, uint32_t trns_len)`\n836\tunsafe fn cp_get_alpha_for_indexed_image(index: c_int, trns: *const u8, trns_len: u32) -> u8 {\n837\t    unsafe {\n838\t        if trns.is_null() {\n839\t            255\n840\t        } else if (index as u32) >= trns_len {\n841\t            255\n842\t        } else {\n843\t            *trns.offset(index as isize)\n844\t        }\n845\t    }\n846\t}\n847\t\n848\t/// `static void cp_depalette(int w, int h, uint8_t *src, cp_pixel_t *dst, const uint8_t *plte, const uint8_t *trns, uint32_t trns_len)`\n849\tunsafe fn cp_depalette(\n850\t    w: c_int,\n851\t    h: c_int,\n852\t    src: *mut u8,\n853\t    dst: *mut cp_pixel_t,\n854\t    plte: *const u8,\n855\t    trns: *const u8,\n856\t    trns_len: u32,\n857\t) {\n858\t    unsafe {\n859\t        let mut src = src;\n860\t        let mut dst = dst;\n861\t        for _y in 0..h {\n862\t            src = src.wrapping_offset(1);\n863\t            let mut x: c_int = 0;\n864\t            while x < w {\n865\t                let c = *src as c_int;\n866\t                let r = *plte.offset((c * 3) as isize);\n867\t                let g = *plte.offset((c * 3 + 1) as isize);\n868\t                let b = *plte.offset((c * 3 + 2) as isize);\n869\t                let a = cp_get_alpha_for_indexed_image(c, trns, trns_len);\n870\t                *dst = cp_make_pixel_a(r, g, b, a);\n871\t                dst = dst.wrapping_offset(1);\n872\t                x += 1;\n873\t                src = src.wrapping_offset(1);\n874\t            }\n875\t        }\n876\t    }\n877\t}\n878\t\n879\t/// `static uint32_t cp_get_chunk_byte_length(const uint8_t *chunk)`\n880\tunsafe fn cp_get_chunk_byte_length(chunk: *const u8) -> u32 {\n881\t    unsafe { cp_make32(chunk.wrapping_offset(-8)) }\n882\t}\n883\t\n884\t/// `static int cp_out_size(cp_image_t *img, int bpp)`\n885\tfn cp_out_size(img: &cp_image_t, bpp: c_int) -> c_int {\n886\t    img.w.wrapping_add(1).wrapping_mul(img.h).wrapping_mul(bpp)\n887\t}\n888\t\n889\t/// `cp_image_t load_png_mem(const uint8_t *png_data, int png_length)`\n890\t#[unsafe(no_mangle)]\n891\tpub unsafe extern \"C\" fn load_png_mem(png_data: *const u8, png_length: c_int) -> cp_image_t {\n892\t    unsafe {\n893\t        const SIG: &[u8; 8] = b\"\\x89PNG\\r\\n\\x1a\\n\";\n894\t        let ihdr: *const u8;\n895\t        let mut first: *const u8;\n896\t        let plte: *const u8;\n897\t        let trns: *const u8;\n898\t        let bit_depth: c_int;\n899\t        let color_type: c_int;\n900\t        let mut bpp: c_int = 0;\n901\t        let w: c_int;\n902\t        let h: c_int;\n903\t        let pix_bytes: c_int;\n904\t        let compression: c_int;\n905\t        let filter: c_int;\n906\t        let interlace: c_int;\n907\t        let mut datalen: c_int;\n908\t        let mut offset: c_int;\n909\t        let out: *mut u8;\n910\t        let mut img = cp_image_t {\n911\t            w: 0,\n912\t            h: 0,\n913\t            pix: ptr::null_mut(),\n914\t        };\n915\t        let mut data: *mut u8 = ptr::null_mut();\n916\t        let mut png = cp_raw_png_t {\n917\t            p: png_data,\n918\t            end: png_data.wrapping_offset(png_length as isize),\n919\t        };\n920\t\n921\t        macro_rules! fail {\n922\t            ($msg:expr) => {{\n923\t                set_error_reason($msg);\n924\t                free(data as *mut c_void);\n925\t                free(img.pix as *mut c_void);\n926\t                img.pix = ptr::null_mut();\n927\t                return img;\n928\t            }};\n929\t        }\n930\t\n931\t        if memcmp(\n932\t            png.p as *const c_void,\n933\t            SIG.as_ptr() as *const c_void,\n934\t            8