           set_error_reason(\n492\t                        c\"Attempted to write before out buffer (invalid backwards distance).\",\n493\t                    );\n494\t                    return 0;\n495\t                }\n496\t                if !((*s).out.wrapping_offset(length as isize) <= (*s).out_end) {\n497\t                    set_error_reason(\n498\t                        c\"Attempted to overwrite out buffer while outputting a string.\",\n499\t                    );\n500\t                    return 0;\n501\t                }\n502\t                let mut src = (*s).out.wrapping_offset(-(backwards_distance as isize));\n503\t                let mut dst = (*s).out;\n504\t                (*s).out = (*s).out.wrapping_offset(length as isize);\n505\t                let mut length = length;\n506\t                match backwards_distance {\n507\t                    1 => {\n508\t                        memset(dst as *mut c_void, *src as c_int, length as usize);\n509\t                    }\n510\t                    _ => {\n511\t                        while length != 0 {\n512\t                            *dst = *src;\n513\t                            dst = dst.wrapping_offset(1);\n514\t                            src = src.wrapping_offset(1);\n515\t                            length -= 1;\n516\t                        }\n517\t                    }\n518\t                }\n519\t            } else {\n520\t                break;\n521\t            }\n522\t        }\n523\t        1\n524\t    }\n525\t}\n526\t\n527\t/// `int cp_inflate(void *in, int in_bytes, void *out, int out_bytes)`\n528\t#[unsafe(no_mangle)]\n529\tpub unsafe extern \"C\" fn cp_inflate(\n530\t    in_: *mut c_void,\n531\t    in_bytes: c_int,\n532\t    out: *mut c_void,\n533\t    out_bytes: c_int,\n534\t) -> c_int {\n535\t    unsafe {\n536\t        let s = calloc(1, core::mem::size_of::<cp_state_t>()) as *mut cp_state_t;\n537\t        (*s).bits = 0;\n538\t        (*s).count = 0;\n539\t        (*s).word_index