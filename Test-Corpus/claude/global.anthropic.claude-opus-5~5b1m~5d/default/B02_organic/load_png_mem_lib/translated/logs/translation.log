","+                .collect();","+            let lb: Vec<u8> = (*(&raw const cp_len_base))","+                .iter()","+                .flat_map(|v| v.to_le_bytes())","+                .collect();","+            put(&mut expect, OFF_DIST_BASE, &db);","+            put(&mut expect, OFF_DIST_EXTRA_BITS, &*(&raw const cp_dist_extra_bits));","+            put(&mut expect, OFF_LEN_BASE, &lb);","+            put(&mut expect, OFF_LEN_EXTRA_BITS, &*(&raw const cp_len_extra_bits));","+            put(","+                &mut expect,","+                OFF_PERMUTATION_ORDER,","+                &*(&raw const cp_permutation_order),","+            );","+            put(&mut expect, OFF_FIXED_TABLE, &*(&raw const cp_fixed_table));","+            for off in 0..DATA_BLOB_LEN {","+                assert_eq!(blob_byte(off), expect[off], \"blob byte {off}\");","+            }","+            assert_eq!(blob_byte(DATA_BLOB_LEN), 0);","+            // values the reference library returns for these out-of-range reads","+            assert_eq!(at_u8(OFF_DIST_EXTRA_BITS, 32), 3); // cp_len_base[0] LSB","+            assert_eq!(at_u32(OFF_DIST_BASE, 32), 0); // cp_dist_extra_bits[0..4]","+            assert_eq!(at_u8(OFF_LEN_EXTRA_BITS, 31), 0); // alignment gap","+            assert_eq!(at_u8(OFF_LEN_EXTRA_BITS, 32), 16); // cp_permutation_order[0]","+            assert_eq!(at_u32(OFF_LEN_BASE, 31), 0); // alignment gap","+            // in-range reads still read the tables","+            for i in 0..31 {","+                assert_eq!(at_u8(OFF_LEN_EXTRA_BITS, i), (*(&raw const cp_len_extra_bits))[i as usize]);","+                assert_eq!(at_u32(OFF_LEN_BASE, i), (*(&raw const cp_len_base))[i as usize]);","+            }","+            for i in 0..32 {","+                assert_eq!(at_u8(OFF_DIST_EXTRA_BITS, i), (*(&raw const cp_dist_extra_bits))[i as usize]);","+                assert_eq!(at_u32(OFF_DIST_BASE, i), (*(&raw const cp_dist_base))[i as usize]);","+            }","+       