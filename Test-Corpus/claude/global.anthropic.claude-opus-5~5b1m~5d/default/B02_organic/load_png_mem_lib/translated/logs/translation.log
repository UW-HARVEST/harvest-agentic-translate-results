ix);\n1077\t        }\n1078\t        free(data as *mut c_void);\n1079\t        img\n1080\t    }\n1081\t}\n1082\t\n1083\t#[cfg(test)]\n1084\tmod tests {\n1085\t    use super::*;\n1086\t\n1087\t    #[test]\n1088\t    fn state_layout_matches_c() {\n1089\t        assert_eq!(core::mem::size_of::<cp_state_t>(), 2464);\n1090\t        assert_eq!(core::mem::align_of::<cp_state_t>(), 8);\n1091\t        assert_eq!(core::mem::offset_of!(cp_state_t, out), 48);\n1092\t        assert_eq!(core::mem::offset_of!(cp_state_t, lookup), 72);\n1093\t        assert_eq!(core::mem::offset_of!(cp_state_t, lit), 1096);\n1094\t        assert_eq!(core::mem::offset_of!(cp_state_t, dst), 2248);\n1095\t        assert_eq!(core::mem::offset_of!(cp_state_t, len), 2376);\n1096\t        assert_eq!(core::mem::offset_of!(cp_state_t, nlit), 2452);\n1097\t    }\n1098\t\n1099\t    #[test]\n1100\t    fn image_layout_matches_c() {\n1101\t        assert_eq!(core::mem::size_of::<cp_image_t>(), 16);\n1102\t        assert_eq!(core::mem::size_of::<cp_pixel_t>(), 4);\n1103\t    }\n1104\t}\n1105\t"}]},"parent_tool_use_id":"toolu_bdrk_01MzviAnfW1BCxC5rhJ3DoEi","session_id":"c031a2da-b27d-432d-a969-e6749a9c4624","uuid":"05c7893b-b4d5-4f9d-9926-d333a8da0e43","timestamp":"2026-08-27T11:35:52.086Z","subagent_type":"general-purpose","task_description":"Audit C-to-Rust fidelity"}
