offset(11) as c_int;\n984\t        interlace = *ihdr.offset(12) as c_int;\n985\t        if !(compression == 0) {\n986\t            fail!(c\"only standard compression DEFLATE is supported\");\n987\t        }\n988\t        if !(filter == 0) {\n989\t            fail!(c\"only standard adaptive filtering is supported\");\n990\t        }\n991\t        if !(interlace == 0) {\n992\t            fail!(c\"interlacing is not supported\");\n993\t        }\n994\t        first = png.p;\n995\t        plte = cp_find(&raw mut png, b\"PLTE\", 0);\n996\t        if plte.is_null() {\n997\t            png.p = first;\n998\t        } else {\n999\t            first = png.p;\n1000\t        }\n1001\t        trns = cp_find(&raw mut png, b\"tRNS\", 0);\n1002\t        if trns.is_null() {\n1003\t            png.p = first;\n1004\t        } else {\n1005\t            first = png.p;\n1006\t        }\n1007\t        datalen = 0;\n1008\t        {\n1009\t            let mut idat = cp_find(&raw mut png, b\"IDAT\", 0);\n1010\t            while !idat.is_null() {\n1011\t                let len = cp_get_chunk_byte_length(idat);\n1012\t                datalen = (datalen as u32).wrapping_add(len) as c_int;\n1013\t                idat = cp_chunk(&raw mut png, b\"IDAT\", 0);\n1014\t            }\n1015\t        }\n1016\t        png.p = first;\n1017\t        data = malloc(datalen as usize) as *mut u8;\n1018\t        offset = 0;\n1019\t        {\n1020\t            let mut idat = cp_find(&raw mut png, b\"IDAT\", 0);\n1021\t            while !idat.is_null() {\n1022\t                let len = cp_get_chunk_byte_length(idat);\n1023\t                memcpy(\n1024\t                    data.wrapping_offset(offset as isize) as *mut c_void,\n1025\t                    idat as *const c_void,\n1026\t                    len as usize,\n1027\t                );\n1028\t                offset = (offset as u32).wrapping_add(len) as c_int;\n1029\t                idat = cp_chunk(&raw mut png, b\"IDAT\", 0);\n1030\t            }\n1031\t  