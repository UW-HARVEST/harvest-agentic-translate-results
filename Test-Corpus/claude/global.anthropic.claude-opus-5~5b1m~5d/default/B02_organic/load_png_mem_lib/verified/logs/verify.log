   match o {\n            CaseOutcome::Pass => {}\n            CaseOutcome::Fail(m) => msgs.push(format!(\"  case {i}: MISMATCH {m}\")),\n            CaseOutcome::Killed(s) => msgs.push(format!(\"  case {i}: CRASHED (signal {s})\")),\n            CaseOutcome::NotRun => msgs.push(format!(\"  case {i}: not run\")),\n        }\n        if msgs.len() >= 12 {\n            msgs.push(\"  ...\".into());\n            break;\n        }\n    }\n    if !msgs.is_empty() {\n        panic!(\n            \"{label}: {} of {} cases failed\\n{}\",\n            out.iter().filter(|o| **o != CaseOutcome::Pass).count(),\n            out.len(),\n            msgs.join(\"\\n\")\n        );\n    }\n}\n","structuredPatch":[{"oldStart":9,"oldLines":6,"newStart":9,"newLines":7,"lines":[" use std::ffi::{CStr, OsStr, c_char, c_int, c_void};"," use std::path::PathBuf;"," ","+pub mod diff;"," pub mod gen;"," "," // ---------------------------------------------------------------------------"]}],"userModified":false,"replaceAll":false}}
