bpp) as isize));\n826\t                        x += 1;\n827\t                    }\n828\t                }\n829\t                2 => {\n830\t                    x = 0;\n831\t                    while x < bpp {\n832\t                        *raw.offset(x as isize) =\n833\t                            (*raw.offset(x as isize)).wrapping_add(*prev.offset(x as isize));\n834\t                        x += 1;\n835\t                    }\n836\t                    while x < len {\n837\t                        *raw.offset(x as isize) =\n838\t                            (*raw.offset(x as isize)).wrapping_add(*prev.offset(x as isize));\n839\t                        x += 1;\n840\t                    }\n841\t                }\n842\t                3 => {\n843\t                    x = 0;\n844\t                    while x < bpp {\n845\t                        *raw.offset(x as isize) =\n846\t                            (*raw.offset(x as isize)).wrapping_add(*prev.offset(x as isize) / 2);\n847\t                        x += 1;\n848\t                    }\n849\t                    while x < len {\n850\t                        let sum = *raw.offset((x - bpp) as isize) as c_int\n851\t                            + *prev.offset(x as isize) as c_int;\n852\t                        *raw.offset(x as isize) =\n853\t                            (*raw.offset(x as isize)).wrapping_add((sum / 2) as u8);\n854\t                        x += 1;\n855\t                    }\n856\t                }\n857\t                4 => {\n858\t                    x = 0;\n859\t                    while x < bpp {\n860\t                        *raw.offset(x as isize) =\n861\t                            (*raw.offset(x as isize)).wrapping_add(*prev.offset(x as isize));\n862\t                        x += 1;\n863\t                    }\n864\t                    while x < len {\n865\t                        *raw.offset(x as isize) = (*raw.offset(x as isize)).wrapping_add(cp_paeth(\n866\t                            *raw.offset