0 {\n            close(rd);\n            for i in start..n {\n                let mut rec = [0u8; REC];\n                rec[0] = 1;\n                rec[1..5].copy_from_slice(&(i as u32).to_le_bytes());\n                write(wr, rec.as_ptr(), REC);\n                let r = f(i);\n                let mut rec = [0u8; REC];\n                match r {\n                    Ok(()) => rec[0] = 2,\n                    Err(m) => {\n                        rec[0] = 3;\n                        let b = m.as_bytes();\n                        let k = b.len().min(MSG_CAP - 1);\n                        rec[5] = (k & 0xFF) as u8;\n                        rec[6] = (k >> 8) as u8;\n                        rec[8..8 + k].copy_from_slice(&b[..k]);\n                    }\n                }\n                rec[1..5].copy_from_slice(&(i as u32).to_le_bytes());\n                write(wr, rec.as_ptr(), REC);\n            }\n            close(wr);\n            _exit(0);\n        }\n        close(wr);\n        // Drain the pipe as the child runs so it never blocks on a full pipe.\n        let mut raw = Vec::new();\n        let mut buf = vec![0u8; 1 << 16];\n        loop {\n            let got = read(rd, buf.as_mut_ptr(), buf.len());\n            if got <= 0 {\n                break;\n            }\n            raw.extend_from_slice(&buf[..got as usize]);\n        }\n        close(rd);\n        let mut status = 0i32;\n        waitpid(pid, &mut status, 0);\n\n        let mut got = Vec::new();\n        let mut in_flight: Option<usize> = None;\n        for rec in raw.chunks(REC) {\n            if rec.len() < REC {\n                break;\n            }\n            let idx = u32::from_le_bytes([rec[1], rec[2], rec[3], rec[4]]) as usize;\n            if idx >= n {\n                break;\n            }\n            match rec[0] {\n                1 => in_flight = Some(idx),\n                2 => {\n                    got.push((idx, CaseOutcome::Pass));\n                    in_flight = None;\n                }\n                3 => {\n                    let k = (rec[5] as usize) | ((rec[6] as usize) << 8);\n                    let k = k.min(MSG_CAP - 1);\n                    got.push((\n                        idx,\n                        CaseOutcome::Fail(String::from_utf8_lossy(&rec[8..8 + k]).into_owned()),\n                    ));\n                    in_flight = None;\n                }\n                _ => break,\n            }\n        }\n        let sig = status & 0x7f;\n        if let Some(i) = in_flight {\n            got.push((i, CaseOutcome::Killed(if sig != 0 { sig } else { 255 })));\n            return (got, Some(i));\n        }\n        (got, None)\n    }\n}\n\n'''\ns = s[:old_start] + new + s[old_end:]\np.write_text(s)\nprint(\"ok\")\nPY\ntimeout 300 cargo check --tests 2>&1 | tail -20","description":"Add crash-resume to run_isolated"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1568,"cache_read_input_tokens":194339,"cache_creation":{"ephemeral_5m_input_tokens":1568,"ephemeral_1h_input_tokens":0},"output_tokens":21,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ca950163-4526-4c83-bcdb-90a4f8c566ab","uuid":"5e2b4434-b3cb-48c2-986c-fbb5c9033011","timestamp":"2026-08-27T13:07:08.511Z"}
