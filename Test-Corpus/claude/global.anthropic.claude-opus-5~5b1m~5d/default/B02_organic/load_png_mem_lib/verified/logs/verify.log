1070\t            fail!(c\"only standard compression DEFLATE is supported\");\n1071\t        }\n1072\t        if !(filter == 0) {\n1073\t            fail!(c\"only standard adaptive filtering is supported\");\n1074\t        }\n1075\t        if !(interlace == 0) {\n1076\t            fail!(c\"interlacing is not supported\");\n1077\t        }\n1078\t        first = png.p;\n1079\t        plte = cp_find(&raw mut png, b\"PLTE\", 0);\n1080\t        if plte.is_null() {\n1081\t            png.p = first;\n1082\t        } else {\n1083\t            first = png.p;\n1084\t        }\n1085\t        trns = cp_find(&raw mut png, b\"tRNS\", 0);\n1086\t        if trns.is_null() {\n1087\t            png.p = first;\n1088\t        } else {\n1089\t            first = png.p;\n1090\t        }\n1091\t        datalen = 0;\n1092\t        {\n1093\t            let mut idat = cp_find(&raw mut png, b\"IDAT\", 0);\n1094\t            while !idat.is_null() {\n1095\t                let len = cp_get_chunk_byte_length(idat);\n1096\t                datalen = (datalen as u32).wrapping_add(len) as c_int;\n1097\t                idat = cp_chunk(&raw mut png, b\"IDAT\", 0);\n1098\t            }\n1099\t        }\n1100\t        png.p = first;\n1101\t        data = malloc(datalen as usize) as *mut u8;\n1102\t        offset = 0;\n1103\t        {\n1104\t            let mut idat = cp_find(&raw mut png, b\"IDAT\", 0);\n1105\t            while !idat.is_null() {\n1106\t                let len = cp_get_chunk_byte_length(idat);\n1107\t                memcpy(\n1108\t                    data.wrapping_offset(offset as isize) as *mut c_void,\n1109\t                    idat as *const c_void,\n1110\t                    len as usize,\n1111\t                );\n1112\t                offset = (offset as u32).wrapping_add(len) as c_int;\n1113\t                idat = cp_chunk(&raw mut png, b\"IDAT\", 0);\n1114\t            }\n1115\t        }\n1116\t        if !(!data.is_null() && datalen >= 6) {\n1117\t            fail!(c\"corrupt z