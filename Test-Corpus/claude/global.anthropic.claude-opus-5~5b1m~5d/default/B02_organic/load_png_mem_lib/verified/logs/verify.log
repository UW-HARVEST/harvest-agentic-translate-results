{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_kpvn4kstiqp2jbid3jnqn2wwmkuvm5f6snua6gfndkscpijilvla","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01RUTeCusD2oPfRYY534dXRg","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/valid_inflate.rs","content":"//! Phase B — valid-path differential tests for `cp_inflate`, the lowest-level\n//! public entry point. Rows C1..C24 of `CONFIGS.md`.\n//!\n//! Every case allocates a fresh input at a chosen alignment mod 4 and a fresh\n//! output buffer with 256 bytes of slack, calls both `.so`s, and requires the\n//! return value, `cp_error_reason` and **every byte of the whole output\n//! allocation** (slack included, so an overrun is caught) to be identical.\n\nmod common;\n\nuse common::diff::Pair;\nuse common::mk::*;\nuse common::*;\n\nconst SEED: u64 = 0x5eed_1234_abcd_0001;\n\nfn lit_toks(data: &[u8]) -> Vec<Tok> {\n    data.iter().map(|&b| Tok::Lit(b)).collect()\n}\n\n// ---------------------------------------------------------------------------\n// C1 / C2 — stored blocks\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c1_stored_blocks_every_length_and_alignment() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED);\n    let sizes = [0usize, 1, 2, 3, 4, 5, 6, 7, 8, 17, 255, 256, 1024];\n    let mut cases = Vec::new();\n    for &n in &sizes {\n        for ia in 0..4 {\n            for _ in 0..6 {\n                cases.push((rng.bytes(n), ia));\n            }\n        }\n    }\n    expect_all_pass(\"C1\", cases.len(), |i| {\n        let (data, ia) = &cases[i];\n        let s = deflate_stored(data);\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n#[test]\nfn c2_stored_blocks_with_output_slack() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 2);\n    let mut cases = Vec::new();\n    for n in [0usize, 1, 5, 33, 200] {\n        for extra in [1i32, 2, 7, 64, 500] {\n            for oa in 0..4 {\n                cases.push((rng.bytes(n), extra, oa));\n            }\n        }\n    }\n    expect_all_pass(\"C2\", cases.len(), |i| {\n        let (data, extra, oa) = &cases[i];\n        let s = deflate_stored(data);\n        p.inflate(&s, s.len() as i32, data.len() as i32 + extra, 0, *oa)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C3 — fixed blocks, literals only\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c3_fixed_literals_all_code_ranges() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 3);\n    let mut cases: Vec<(Vec<u8>, usize)> = Vec::new();\n    // deliberate coverage of the four fixed-code length classes\n    cases.push(((0u8..=143).collect(), 0));\n    cases.push(((144u8..=255).collect(), 1));\n    cases.push((vec![0u8; 300], 2));\n    cases.push((vec![255u8; 300], 3));\n    for _ in 0..160 {\n        let n = rng.below(301) as usize;\n        let mode = rng.below(3);\n        let data: Vec<u8> = (0..n)\n            .map(|_| match mode {\n                0 => rng.byte() & 0x7F,        // 8-bit codes\n                1 => 144 + (rng.byte() % 112), // 9-bit codes\n                _ => rng.byte(),\n            })\n            .collect();\n        cases.push((data, rng.below(4) as usize));\n    }\n    expect_all_pass(\"C3\", cases.len(), |i| {\n        let (data, ia) = &cases[i];\n        let s = deflate_fixed_literals(data);\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C4 / C5 / C6 — back-references\n// ---------------------------------------------------------------------------\n\n/// Builds a fixed block that emits `seed` literally, then one match.\nfn one_match(seed: &[u8], len: u16, dist: u16) -> (Vec<u8>, usize) {\n    let mut bw = BitWriter::new();\n    let mut toks = lit_toks(seed);\n    toks.push(Tok::Match { len, dist });\n    fixed_block(&mut bw, true, &toks);\n    (bw.finish(), seed.len() + len as usize)\n}\n\n#[test]\nfn c4_fixed_match_distance_one_memset_path_every_length() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 4);\n    let cases: Vec<u16> = (3u16..=258).collect();\n    expect_all_pass(\"C4\", cases.len(), |i| {\n        let len = cases[i];\n        let seed = [rng.byte() | 1];\n        let (s, out) = one_match(&seed, len, 1);\n        p.inflate(&s, s.len() as i32, out as i32, i % 4, (i / 4) % 4)\n    });\n}\n\n#[test]\nfn c5_fixed_match_every_distance_symbol() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 5);\n    // one case per distance symbol, with random in-range extra bits\n    let mut cases = Vec::new();\n    for sym in 0..30usize {\n        for _ in 0..8 {\n            let base = common::mk::DIST_BASE[sym] as u32;\n            let span = 1u32 << common::mk::DIST_EXTRA[sym];\n            let dist = (base + rng.below(span)) as u16;\n            let len = 3 + rng.below(256) as u16;\n            cases.push((dist, len));\n        }\n    }\n    expect_all_pass(\"C5\", cases.len(), |i| {\n        let (dist, len) = cases[i];\n        let seed: Vec<u8> = (0..dist as usize).map(|k| (k as u8) ^ 0x3C).collect();\n        let (s, out) = one_match(&seed, len, dist);\n        p.inflate(&s, s.len() as i32, out as i32, i % 4, (i / 3) % 4)\n    });\n}\n\n#[test]\nfn c6_fixed_match_every_length_symbol() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 6);\n    let mut cases = Vec::new();\n    for sym in 0..29usize {\n        for _ in 0..8 {\n            let base = common::mk::LEN_BASE[sym] as u32;\n            let span = 1u32 << common::mk::LEN_EXTRA[sym];\n            let mut len = base + rng.below(span);\n            len = len.min(258);\n            let dist = 1 + rng.below(40) as u16;\n            cases.push((len as u16, dist));\n        }\n    }\n    expect_all_pass(\"C6\", cases.len(), |i| {\n        let (len, dist) = cases[i];\n        let seed: Vec<u8> = (0..dist as usize).map(|k| (k as u8).wrapping_mul(37)).collect();\n        let (s, out) = one_match(&seed, len, dist);\n        p.inflate(&s, s.len() as i32, out as i32, i % 4, 0)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C7..C13 — dynamic blocks\n// ---------------------------------------------------------------------------\n\n/// A dynamic block whose literal alphabet is exactly `used` (which must contain\n/// 256) with `nlit` entries, and whose distance alphabet has `ndst` entries.\nfn dyn_spec(nlit: usize, used: &[usize], ndst: usize, dused: &[usize], skew: bool) -> DynSpec {\n    let lit_lens = if skew {\n        skewed_lens_for(nlit, used)\n    } else {\n        lens_for(nlit, used)\n    };\n    let dist_lens = if dused.is_empty() {\n        vec![0u8; ndst]\n    } else {\n        lens_for(ndst, dused)\n    };\n    DynSpec::new(lit_lens, dist_lens)\n}\n\n#[test]\nfn c7_dynamic_minimum_header() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 7);\n    let mut cases = Vec::new();\n    for _ in 0..40 {\n        let n = rng.below(60) as usize;\n        let data: Vec<u8> = (0..n).map(|_| rng.byte() & 0x0F).collect();\n        cases.push(data);\n    }\n    expect_all_pass(\"C7\", cases.len(), |i| {\n        let data = &cases[i];\n        let mut used: Vec<usize> = data.iter().map(|&b| b as usize).collect();\n        used.push(256);\n        used.sort_unstable();\n        used.dedup();\n        let spec = dyn_spec(257, &used, 1, &[0], false);\n        assert_eq!(spec.lit_lens.len(), 257);\n        assert_eq!(spec.dist_lens.len(), 1);\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, i % 4, 0)\n    });\n}\n\n#[test]\nfn c8_dynamic_maximum_header() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 8);\n    // nlit == 288, ndst == 32: complete codes over the whole alphabets.\n    let used: Vec<usize> = (0..288).collect();\n    let dused: Vec<usize> = (0..32).collect();\n    let spec = dyn_spec(288, &used, 32, &dused, false);\n    let mut cases = Vec::new();\n    for _ in 0..40 {\n        let n = rng.below(80) as usize;\n        cases.push(rng.bytes(n));\n    }\n    expect_all_pass(\"C8\", cases.len(), |i| {\n        let data = &cases[i];\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, i % 4, i % 3)\n    });\n}\n\n#[test]\nfn c9_dynamic_random_nlit_ndst() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 9);\n    let mut cases = Vec::new();\n    for _ in 0..200 {\n        let nlit = 257 + rng.below(32) as usize;\n        let ndst = 1 + rng.below(32) as usize;\n        // random non-empty subset of 0..nlit that contains 256\n        let mut used: Vec<usize> = vec![256];\n        let extra = 1 + rng.below(40) as usize;\n        for _ in 0..extra {\n            used.push(rng.below(nlit as u32) as usize);\n        }\n        used.sort_unstable();\n        used.dedup();\n        let mut dused: Vec<usize> = Vec::new();\n        for _ in 0..(1 + rng.below(4)) {\n            dused.push(rng.below(ndst as u32) as usize);\n        }\n        dused.sort_unstable();\n        dused.dedup();\n        let n = rng.below(60) as usize;\n        let pool: Vec<u8> = used\n            .iter()\n            .filter(|&&s| s < 256)\n            .map(|&s| s as u8)\n            .collect();\n        let data: Vec<u8> = if pool.is_empty() {\n            Vec::new()\n        } else {\n            (0..n).map(|_| pool[rng.below(pool.len() as u32) as usize]).collect()\n        };\n        cases.push((nlit, used, ndst, dused, data, rng.below(4) as usize));\n    }\n    expect_all_pass(\"C9\", cases.len(), |i| {\n        let (nlit, used, ndst, dused, data, ia) = &cases[i];\n        let spec = dyn_spec(*nlit, used, *ndst, dused, false);\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n#[test]\nfn c10_dynamic_code_lengths_above_nine() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 10);\n    // skewed_lengths(m) => 1,2,..,m-1,m-1, so m = 13..16 reaches 12..15 bits,\n    // above cp_build's `len <= 9` s->lookup fast path.\n    let mut cases = Vec::new();\n    for m in 11..=16usize {\n        for _ in 0..12 {\n            let mut used: Vec<usize> = vec![256];\n            while used.len() < m {\n                let s = rng.below(255) as usize;\n                if !used.contains(&s) {\n                    used.push(s);\n                }\n            }\n            used.sort_unstable();\n            let pool: Vec<u8> = used.iter().filter(|&&s| s < 256).map(|&s| s as u8).collect();\n            let n = rng.below(50) as usize;\n            let data: Vec<u8> = (0..n)\n                .map(|_| pool[rng.below(pool.len() as u32) as usize])\n                .collect();\n            cases.push((used, data, rng.below(4) as usize));\n        }\n    }\n    expect_all_pass(\"C10\", cases.len(), |i| {\n        let (used, data, ia) = &cases[i];\n        let spec = dyn_spec(257, used, 1, &[0], true);\n        assert!(spec.lit_lens.iter().any(|&l| l > 9), \"no long code produced\");\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n#[test]\nfn c11_dynamic_with_run_length_code_length_symbols() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 11);\n    let mut cases = Vec::new();\n    for _ in 0..120 {\n        let nlit = 257 + rng.below(32) as usize;\n        let ndst = 1 + rng.below(32) as usize;\n        let mut used: Vec<usize> = vec![256];\n        // long stretches of zero lengths => symbols 17 and 18 (runs 3..10, 11..138)\n        // and repeated equal lengths => symbol 16 (runs 3..6)\n        let block = rng.below(20) as usize + 1;\n        let start = rng.below(nlit as u32 - block as u32 - 1) as usize;\n        for k in 0..block {\n            used.push(start + k);\n        }\n        used.sort_unstable();\n        used.dedup();\n        let dused: Vec<usize> = (0..ndst.min(1 + rng.below(3) as usize)).collect();\n        let pool: Vec<u8> = used.iter().filter(|&&s| s < 256).map(|&s| s as u8).collect();\n        let n = rng.below(40) as usize;\n        let data: Vec<u8> = if pool.is_empty() {\n            Vec::new()\n        } else {\n            (0..n).map(|_| pool[rng.below(pool.len() as u32) as usize]).collect()\n        };\n        cases.push((nlit, used, ndst, dused, data, rng.below(4) as usize));\n    }\n    expect_all_pass(\"C11\", cases.len(), |i| {\n        let (nlit, used, ndst, dused, data, ia) = &cases[i];\n        let spec = dyn_spec(*nlit, used, *ndst, dused, false).with_runs();\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n/// Maximum-length runs of every run-length symbol (16 => 6, 17 => 10, 18 => 138).\n#[test]\nfn c11b_dynamic_maximum_runs() {\n    let p = Pair::new();\n    // 288 + 32 == 320 lengths; a single 18-run covers 138, so three of them\n    // plus the tail exercises the longest form.\n    let used: Vec<usize> = vec![0, 1, 2, 256];\n    let spec = dyn_spec(288, &used, 32, &[0, 1], false).with_runs();\n    let data: Vec<u8> = vec![0, 1, 2, 2, 1, 0, 0, 0, 1, 2];\n    expect_all_pass(\"C11b\", 4, |i| {\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(&data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, i, 0)\n    });\n}\n\n#[test]\nfn c12_dynamic_every_hclen() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 12);\n    // HCLEN+4 must still cover every code-length symbol actually used; using\n    // only lengths that map to early permutation slots keeps `need` small.\n    let mut cases = Vec::new();\n    for nlen in 4..=19usize {\n        for _ in 0..6 {\n            let mut used: Vec<usize> = vec![256];\n            for _ in 0..(1 + rng.below(6)) {\n                used.push(rng.below(256) as usize);\n            }\n            used.sort_unstable();\n            used.dedup();\n            let pool: Vec<u8> = used.iter().filter(|&&s| s < 256).map(|&s| s as u8).collect();\n            let n = rng.below(30) as usize;\n            let data: Vec<u8> = (0..n)\n                .map(|_| pool[rng.below(pool.len() as u32) as usize])\n                .collect();\n            cases.push((nlen, used, data));\n        }\n    }\n    let mut skipped = 0usize;\n    let out = run_isolated(cases.len(), |i| {\n        let (nlen, used, data) = &cases[i];\n        let spec = dyn_spec(257, used, 1, &[0], false);\n        // only emit if this HCLEN can carry the symbols we need\n        let mut all = spec.lit_lens.clone();\n        all.extend_from_slice(&spec.dist_lens);\n        let mut need = 4usize;\n        const PERM: [usize; 19] = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15];\n        let mut seen: Vec<usize> = all.iter().map(|&l| l as usize).collect();\n        seen.sort_unstable();\n        seen.dedup();\n        for s in seen {\n            need = need.max(PERM.iter().position(|&x| x == s).unwrap() + 1);\n        }\n        if *nlen < need {\n            return Ok(()); // combination not expressible; covered by other nlen\n        }\n        let spec = spec.hclen(*nlen);\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, i % 4, 0)\n    });\n    report(\"C12\", &out);\n    let _ = &mut skipped;\n}\n\n#[test]\nfn c13_dynamic_with_back_references() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 13);\n    let mut cases: Vec<Vec<u8>> = Vec::new();\n    for _ in 0..120 {\n        let n = 1 + rng.below(400) as usize;\n        let mode = rng.below(4);\n        let data: Vec<u8> = match mode {\n            0 => vec![rng.byte(); n],                            // long dist-1 runs\n            1 => (0..n).map(|k| (k % 3) as u8).collect(),         // short period\n            2 => (0..n).map(|k| (k / 7) as u8).collect(),         // long runs\n            _ => {\n                let base = rng.bytes(1 + rng.below(20) as usize);\n                (0..n).map(|k| base[k % base.len()]).collect()\n            }\n        };\n        cases.push(data);\n    }\n    expect_all_pass(\"C13\", cases.len(), |i| {\n        let data = &cases[i];\n        let s = deflate_dynamic_lz(data, i % 2 == 0);\n        p.inflate(&s, s.len() as i32, data.len() as i32, i % 4, i % 3)?;\n        let s2 = deflate_fixed_lz(data);\n        p.inflate(&s2, s2.len() as i32, data.len() as i32, (i + 1) % 4, 0)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C14 / C15 — multi-block streams\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c14_multi_block_every_type_sequence() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 14);\n    // 1 = fixed, 2 = dynamic\n    let mut seqs: Vec<Vec<u8>> = vec![\n        vec![1, 1],\n        vec![1, 2],\n        vec![2, 1],\n        vec![2, 2],\n        vec![1, 1, 1],\n        vec![2, 2, 2],\n        vec![1, 2, 1, 2],\n        vec![2, 1, 2, 1, 2],\n    ];\n    for _ in 0..20 {\n        let n = 2 + rng.below(5) as usize;\n        seqs.push((0..n).map(|_| 1 + (rng.below(2) as u8)).collect());\n    }\n    let mut cases = Vec::new();\n    for s in &seqs {\n        let chunks: Vec<Vec<u8>> = s\n            .iter()\n            .map(|_| rng.bytes(rng.below(40) as usize))\n            .collect();\n        cases.push((s.clone(), chunks));\n    }\n    expect_all_pass(\"C14\", cases.len(), |i| {\n        let (seq, chunks) = &cases[i];\n        let mut bw = BitWriter::new();\n        let mut total = 0usize;\n        for (k, &ty) in seq.iter().enumerate() {\n            let last = k + 1 == seq.len();\n            let data = &chunks[k];\n            total += data.len();\n            if ty == 1 {\n                fixed_block(&mut bw, last, &lit_toks(data));\n            } else {\n                let mut used: Vec<usize> = data.iter().map(|&b| b as usize).collect();\n                used.push(256);\n                used.sort_unstable();\n                used.dedup();\n                let spec = dyn_spec(257, &used, 1, &[0], false);\n                dynamic_block(&mut bw, last, &spec, &lit_toks(data));\n            }\n        }\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, total as i32, i % 4, 0)\n    });\n}\n\n#[test]\nfn c15_multi_block_ending_in_stored() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 15);\n    let mut cases = Vec::new();\n    for _ in 0..40 {\n        cases.push((\n            rng.bytes(rng.below(30) as usize),\n            rng.bytes(rng.below(40) as usize),\n        ));\n    }\n    // The C's `s->bits_left / 8 <= LEN` test means a stored block is only\n    // accepted as the very last thing in the stream; leading non-final blocks\n    // are fine, so this shape must work in both.\n    expect_all_pass(\"C15\", cases.len(), |i| {\n        let (a, b) = &cases[i];\n        let mut bw = BitWriter::new();\n        fixed_block(&mut bw, false, &lit_toks(a));\n        stored_block(&mut bw, true, b);\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, (a.len() + b.len()) as i32, i % 4, 0)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C16 / C17 / C18 — bit-reader geometry\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c16_every_alignment_and_final_word_combination() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 16);\n    let mut cases = Vec::new();\n    for ia in 0..4usize {\n        for pad in 0..4usize {\n            for _ in 0..14 {\n                cases.push((rng.bytes(rng.below(70) as usize), ia, pad, rng.byte()));\n            }\n        }\n    }\n    expect_all_pass(\"C16\", cases.len(), |i| {\n        let (data, ia, pad, fill) = &cases[i];\n        // trailing bytes after the final block are never examined, so padding\n        // only moves `first_bytes` / `word_count` / `last_bytes` around\n        let mut s = deflate_fixed_literals(data);\n        s.extend(std::iter::repeat_n(*fill, *pad));\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n#[test]\nfn c17_streams_ending_exactly_on_a_word_boundary() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 17);\n    let mut cases = Vec::new();\n    for _ in 0..250 {\n        let n = rng.below(64) as usize;\n        cases.push((rng.bytes(n), rng.below(4) as usize));\n    }\n    expect_all_pass(\"C17\", cases.len(), |i| {\n        let (data, ia) = &cases[i];\n        let s = deflate_fixed_literals(data);\n        // truncate the declared length to each of the four residues, so the\n        // final-word path is entered with 0..3 leftover bytes\n        for cut in 0..4usize {\n            if s.len() > cut {\n                let n = s.len() - cut;\n                if n % 4 == 0 || cut == 0 {\n                    p.inflate(&s, n as i32, data.len() as i32, *ia, 0)?;\n                }\n            }\n        }\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n#[test]\nfn c18_output_alignment() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 18);\n    let mut cases = Vec::new();\n    for oa in 0..8usize {\n        for _ in 0..20 {\n            cases.push((rng.bytes(1 + rng.below(60) as usize), oa));\n        }\n    }\n    expect_all_pass(\"C18\", cases.len(), |i| {\n        let (data, oa) = &cases[i];\n        let s = deflate_fixed_lz(data);\n        p.inflate(&s, s.len() as i32, data.len() as i32, 0, *oa)?;\n        let s2 = deflate_stored(data);\n        p.inflate(&s2, s2.len() as i32, data.len() as i32, 0, *oa)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C19 — repeated calls\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c19_repeated_calls_keep_agreeing() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 19);\n    let data = rng.bytes(64);\n    let good = deflate_fixed_literals(&data);\n    let bad = {\n        // btype 3: sets cp_error_reason, which is sticky across later calls\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(3, 2);\n        bw.finish()\n    };\n    expect_all_pass(\"C19\", 40, |i| {\n        if i % 3 == 2 {\n            p.inflate(&bad, bad.len() as i32, 64, i % 4, 0)\n        } else {\n            p.inflate(&good, good.len() as i32, data.len() as i32, i % 4, 0)\n        }\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C20 / C21 / C22 — caller-mutated exported tables\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c20_mutated_cp_fixed_table() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 20);\n    // Replace the fixed code with other *complete* codes and feed a block\n    // encoded with the replacement; both libraries must decode it the same.\n    let mut cases = Vec::new();\n    for _ in 0..60 {\n        let mut used: Vec<usize> = vec![256];\n        for _ in 0..(1 + rng.below(30)) {\n            used.push(rng.below(288) as usize);\n        }\n        used.sort_unstable();\n        used.dedup();\n        let lit = lens_for(288, &used);\n        let dused: Vec<usize> = (0..(1 + rng.below(8) as usize)).collect();\n        let dst = lens_for(32, &dused);\n        let pool: Vec<u8> = used.iter().filter(|&&s| s < 256).map(|&s| s as u8).collect();\n        let n = rng.below(40) as usize;\n        let data: Vec<u8> = if pool.is_empty() {\n            Vec::new()\n        } else {\n            (0..n).map(|_| pool[rng.below(pool.len() as u32) as usize]).collect()\n        };\n        cases.push((lit, dst, data));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (lit, dst, data) = &cases[i];\n        for l in [&p.c, &p.r] {\n            unsafe {\n                std::ptr::copy_nonoverlapping(lit.as_ptr(), l.cp_fixed_table, 288);\n                std::ptr::copy_nonoverlapping(dst.as_ptr(), l.cp_fixed_table.add(288), 32);\n            }\n        }\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(1, 2);\n        emit_tokens(&mut bw, &lit_toks(data), lit, dst);\n        emit_tokens(&mut bw, &[Tok::End], lit, dst);\n        let s = bw.finish();\n        let r = p.inflate(&s, s.len() as i32, data.len() as i32, i % 4, 0);\n        p.reset();\n        r\n    });\n    p.reset();\n    report(\"C20\", &out);\n}\n\n#[test]\nfn c21_mutated_length_and_distance_tables() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 21);\n    let mut cases = Vec::new();\n    for _ in 0..80 {\n        // arbitrary (still small) replacements for the four tables\n        let le: Vec<u8> = (0..31).map(|_| rng.byte() % 6).collect();\n        let lb: Vec<u32> = (0..31).map(|_| 1 + rng.below(40)).collect();\n        let de: Vec<u8> = (0..32).map(|_| rng.byte() % 6).collect();\n        let db: Vec<u32> = (0..32).map(|_| 1 + rng.below(16)).collect();\n        cases.push((le, lb, de, db, rng.bytes(1 + rng.below(50) as usize)));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (le, lb, de, db, data) = &cases[i];\n        for l in [&p.c, &p.r] {\n            unsafe {\n                std::ptr::copy_nonoverlapping(le.as_ptr(), l.cp_len_extra_bits, 31);\n                std::ptr::copy_nonoverlapping(lb.as_ptr(), l.cp_len_base, 31);\n                std::ptr::copy_nonoverlapping(de.as_ptr(), l.cp_dist_extra_bits, 32);\n                std::ptr::copy_nonoverlapping(db.as_ptr(), l.cp_dist_base, 32);\n            }\n        }\n        let s = deflate_fixed_lz(data);\n        // the mutated tables change lengths/distances, so the result is not the\n        // original data any more -- but it must be the *same* wrong thing\n        let r = p.inflate(&s, s.len() as i32, data.len() as i32 + 64, i % 4, i % 3);\n        p.reset();\n        r\n    });\n    p.reset();\n    report(\"C21\", &out);\n}\n\n#[test]\nfn c22_mutated_cp_permutation_order() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 22);\n    let mut cases = Vec::new();\n    for _ in 0..60 {\n        // a random permutation of 0..19 -- still in range, so the stream stays\n        // decodable, but the 3-bit fields land in different slots\n        let mut perm: Vec<u8> = (0..19u8).collect();\n        for k in (1..19).rev() {\n            let j = rng.below(k as u32 + 1) as usize;\n            perm.swap(k, j);\n        }\n        cases.push((perm, rng.bytes(1 + rng.below(40) as usize)));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (perm, data) = &cases[i];\n        for l in [&p.c, &p.r] {\n            unsafe { std::ptr::copy_nonoverlapping(perm.as_ptr(), l.cp_permutation_order, 19) };\n        }\n        let s = deflate_dynamic_literals(data, i % 2 == 0);\n        let r = p.inflate(&s, s.len() as i32, data.len() as i32 + 32, i % 4, 0);\n        p.reset();\n        r\n    });\n    p.reset();\n    report(\"C22\", &out);\n}\n\n// ---------------------------------------------------------------------------\n// C23 — randomised fuzz around the valid corpus\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c23_bit_flips_inside_valid_streams() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 23);\n    let mut cases = Vec::new();\n    for _ in 0..1500 {\n        let data = rng.bytes(1 + rng.below(48) as usize);\n        let mut s = match rng.below(4) {\n            0 => deflate_stored(&data),\n            1 => deflate_fixed_literals(&data),\n            2 => deflate_dynamic_literals(&data, rng.bool()),\n            _ => deflate_fixed_lz(&data),\n        };\n        let flips = rng.below(3);\n        for _ in 0..flips {\n            let k = rng.below(s.len() as u32) as usize;\n            s[k] ^= 1 << rng.below(8);\n        }\n        cases.push((s, data.len(), rng.below(4) as usize, rng.below(4) as usize));\n    }\n    // Flipped bits routinely make the C (with asserts compiled out) walk into\n    // undefined territory, so this runs under fork isolation; the NDEBUG C and\n    // the Rust must still agree byte for byte whenever the C stays alive.\n    let out = run_isolated(cases.len(), |i| {\n        let (s, n, ia, oa) = &cases[i];\n        p.inflate(s, s.len() as i32, *n as i32, *ia, *oa)\n    });\n    let bad: Vec<String> = out\n        .iter()\n        .enumerate()\n        .filter_map(|(i, o)| match o {\n            CaseOutcome::Fail(m) => Some(format!(\"case {i}: {m}\")),\n            _ => None,\n        })\n        .collect();\n    assert!(bad.is_empty(), \"C23 mismatches:\\n{}\", bad.join(\"\\n\"));\n    let crashed = out\n        .iter()\n        .filter(|o| matches!(o, CaseOutcome::Killed(_)))\n        .count();\n    eprintln!(\n        \"C23: {} cases compared, {} skipped after a C-side crash\",\n        out.iter().filter(|o| **o == CaseOutcome::Pass).count(),\n        crashed + out.iter().filter(|o| **o == CaseOutcome::NotRun).count()\n    );\n}\n\n// ---------------------------------------------------------------------------\n// C24 — empty Huffman trees (`cp_decode` reads `tree[-1]`)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c24_empty_literal_tree_reads_tree_minus_one() {\n    let p = Pair::new();\n    // All 257 literal lengths zero => cp_build returns 0 => cp_decode runs with\n    // hi == 0 and reads s->lit[-1], i.e. the last two entries of s->lookup.\n    let spec = DynSpec::new(vec![0u8; 257], vec![0u8; 1]);\n    expect_all_pass(\"C24-lit\", 16, |i| {\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(2, 2);\n        dynamic_header(&mut bw, &spec);\n        for _ in 0..(i % 4) {\n            bw.bits(0xAB, 8);\n        }\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, (i as i32 % 5) * 3, i % 4, i % 3)\n    });\n}\n\n#[test]\nfn c24_empty_distance_tree_reads_lit_287() {\n    let p = Pair::new();\n    // nlit = 288 with a complete code (so s->lit is fully populated) and an\n    // empty distance tree => cp_decode(s, s->dst, 0) reads s->dst[-1], which is\n    // s->lit[287]. Requires cp_state_t's field offsets to match the C exactly.\n    let used: Vec<usize> = (0..288).collect();\n    let spec = DynSpec::new(lens_for(288, &used), vec![0u8; 1]);\n    let mut rng = Rng::new(SEED ^ 24);\n    let mut cases = Vec::new();\n    for _ in 0..40 {\n        let seed: Vec<u8> = rng.bytes(1 + rng.below(20) as usize);\n        let len = 3 + rng.below(30) as u16;\n        cases.push((seed, len, rng.below(4) as usize, rng.below(200) as i32));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (seed, len, ia, out_bytes) = &cases[i];\n        let mut toks = lit_toks(seed);\n        toks.push(Tok::Match { len: *len, dist: 1 });\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &toks);\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, *out_bytes, *ia, 0)\n    });\n    let bad: Vec<String> = out\n        .iter()\n        .enumerate()\n        .filter_map(|(i, o)| match o {\n            CaseOutcome::Fail(m) => Some(format!(\"case {i}: {m}\")),\n            _ => None,\n        })\n        .collect();\n    assert!(bad.is_empty(), \"C24-dst mismatches:\\n{}\", bad.join(\"\\n\"));\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6167,"cache_read_input_tokens":165820,"cache_creation":{"ephemeral_5m_input_tokens":6167,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ca950163-4526-4c83-bcdb-90a4f8c566ab","uuid":"32bbd3af-eddf-4a75-8ff0-484eeb710375","timestamp":"2026-08-27T13:00:41.469Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RUTeCusD2oPfRYY534dXRg","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/valid_inflate.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ca950163-4526-4c83-bcdb-90a4f8c566ab","uuid":"e79bfb35-2b72-44fe-9cdc-9b2174f5ca63","timestamp":"2026-08-27T13:00:41.479Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/valid_inflate.rs","content":"//! Phase B — valid-path differential tests for `cp_inflate`, the lowest-level\n//! public entry point. Rows C1..C24 of `CONFIGS.md`.\n//!\n//! Every case allocates a fresh input at a chosen alignment mod 4 and a fresh\n//! output buffer with 256 bytes of slack, calls both `.so`s, and requires the\n//! return value, `cp_error_reason` and **every byte of the whole output\n//! allocation** (slack included, so an overrun is caught) to be identical.\n\nmod common;\n\nuse common::diff::Pair;\nuse common::mk::*;\nuse common::*;\n\nconst SEED: u64 = 0x5eed_1234_abcd_0001;\n\nfn lit_toks(data: &[u8]) -> Vec<Tok> {\n    data.iter().map(|&b| Tok::Lit(b)).collect()\n}\n\n// ---------------------------------------------------------------------------\n// C1 / C2 — stored blocks\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c1_stored_blocks_every_length_and_alignment() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED);\n    let sizes = [0usize, 1, 2, 3, 4, 5, 6, 7, 8, 17, 255, 256, 1024];\n    let mut cases = Vec::new();\n    for &n in &sizes {\n        for ia in 0..4 {\n            for _ in 0..6 {\n                cases.push((rng.bytes(n), ia));\n            }\n        }\n    }\n    expect_all_pass(\"C1\", cases.len(), |i| {\n        let (data, ia) = &cases[i];\n        let s = deflate_stored(data);\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n#[test]\nfn c2_stored_blocks_with_output_slack() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 2);\n    let mut cases = Vec::new();\n    for n in [0usize, 1, 5, 33, 200] {\n        for extra in [1i32, 2, 7, 64, 500] {\n            for oa in 0..4 {\n                cases.push((rng.bytes(n), extra, oa));\n            }\n        }\n    }\n    expect_all_pass(\"C2\", cases.len(), |i| {\n        let (data, extra, oa) = &cases[i];\n        let s = deflate_stored(data);\n        p.inflate(&s, s.len() as i32, data.len() as i32 + extra, 0, *oa)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C3 — fixed blocks, literals only\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c3_fixed_literals_all_code_ranges() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 3);\n    let mut cases: Vec<(Vec<u8>, usize)> = Vec::new();\n    // deliberate coverage of the four fixed-code length classes\n    cases.push(((0u8..=143).collect(), 0));\n    cases.push(((144u8..=255).collect(), 1));\n    cases.push((vec![0u8; 300], 2));\n    cases.push((vec![255u8; 300], 3));\n    for _ in 0..160 {\n        let n = rng.below(301) as usize;\n        let mode = rng.below(3);\n        let data: Vec<u8> = (0..n)\n            .map(|_| match mode {\n                0 => rng.byte() & 0x7F,        // 8-bit codes\n                1 => 144 + (rng.byte() % 112), // 9-bit codes\n                _ => rng.byte(),\n            })\n            .collect();\n        cases.push((data, rng.below(4) as usize));\n    }\n    expect_all_pass(\"C3\", cases.len(), |i| {\n        let (data, ia) = &cases[i];\n        let s = deflate_fixed_literals(data);\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C4 / C5 / C6 — back-references\n// ---------------------------------------------------------------------------\n\n/// Builds a fixed block that emits `seed` literally, then one match.\nfn one_match(seed: &[u8], len: u16, dist: u16) -> (Vec<u8>, usize) {\n    let mut bw = BitWriter::new();\n    let mut toks = lit_toks(seed);\n    toks.push(Tok::Match { len, dist });\n    fixed_block(&mut bw, true, &toks);\n    (bw.finish(), seed.len() + len as usize)\n}\n\n#[test]\nfn c4_fixed_match_distance_one_memset_path_every_length() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 4);\n    let cases: Vec<u16> = (3u16..=258).collect();\n    expect_all_pass(\"C4\", cases.len(), |i| {\n        let len = cases[i];\n        let seed = [rng.byte() | 1];\n        let (s, out) = one_match(&seed, len, 1);\n        p.inflate(&s, s.len() as i32, out as i32, i % 4, (i / 4) % 4)\n    });\n}\n\n#[test]\nfn c5_fixed_match_every_distance_symbol() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 5);\n    // one case per distance symbol, with random in-range extra bits\n    let mut cases = Vec::new();\n    for sym in 0..30usize {\n        for _ in 0..8 {\n            let base = common::mk::DIST_BASE[sym] as u32;\n            let span = 1u32 << common::mk::DIST_EXTRA[sym];\n            let dist = (base + rng.below(span)) as u16;\n            let len = 3 + rng.below(256) as u16;\n            cases.push((dist, len));\n        }\n    }\n    expect_all_pass(\"C5\", cases.len(), |i| {\n        let (dist, len) = cases[i];\n        let seed: Vec<u8> = (0..dist as usize).map(|k| (k as u8) ^ 0x3C).collect();\n        let (s, out) = one_match(&seed, len, dist);\n        p.inflate(&s, s.len() as i32, out as i32, i % 4, (i / 3) % 4)\n    });\n}\n\n#[test]\nfn c6_fixed_match_every_length_symbol() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 6);\n    let mut cases = Vec::new();\n    for sym in 0..29usize {\n        for _ in 0..8 {\n            let base = common::mk::LEN_BASE[sym] as u32;\n            let span = 1u32 << common::mk::LEN_EXTRA[sym];\n            let mut len = base + rng.below(span);\n            len = len.min(258);\n            let dist = 1 + rng.below(40) as u16;\n            cases.push((len as u16, dist));\n        }\n    }\n    expect_all_pass(\"C6\", cases.len(), |i| {\n        let (len, dist) = cases[i];\n        let seed: Vec<u8> = (0..dist as usize).map(|k| (k as u8).wrapping_mul(37)).collect();\n        let (s, out) = one_match(&seed, len, dist);\n        p.inflate(&s, s.len() as i32, out as i32, i % 4, 0)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C7..C13 — dynamic blocks\n// ---------------------------------------------------------------------------\n\n/// A dynamic block whose literal alphabet is exactly `used` (which must contain\n/// 256) with `nlit` entries, and whose distance alphabet has `ndst` entries.\nfn dyn_spec(nlit: usize, used: &[usize], ndst: usize, dused: &[usize], skew: bool) -> DynSpec {\n    let lit_lens = if skew {\n        skewed_lens_for(nlit, used)\n    } else {\n        lens_for(nlit, used)\n    };\n    let dist_lens = if dused.is_empty() {\n        vec![0u8; ndst]\n    } else {\n        lens_for(ndst, dused)\n    };\n    DynSpec::new(lit_lens, dist_lens)\n}\n\n#[test]\nfn c7_dynamic_minimum_header() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 7);\n    let mut cases = Vec::new();\n    for _ in 0..40 {\n        let n = rng.below(60) as usize;\n        let data: Vec<u8> = (0..n).map(|_| rng.byte() & 0x0F).collect();\n        cases.push(data);\n    }\n    expect_all_pass(\"C7\", cases.len(), |i| {\n        let data = &cases[i];\n        let mut used: Vec<usize> = data.iter().map(|&b| b as usize).collect();\n        used.push(256);\n        used.sort_unstable();\n        used.dedup();\n        let spec = dyn_spec(257, &used, 1, &[0], false);\n        assert_eq!(spec.lit_lens.len(), 257);\n        assert_eq!(spec.dist_lens.len(), 1);\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, i % 4, 0)\n    });\n}\n\n#[test]\nfn c8_dynamic_maximum_header() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 8);\n    // nlit == 288, ndst == 32: complete codes over the whole alphabets.\n    let used: Vec<usize> = (0..288).collect();\n    let dused: Vec<usize> = (0..32).collect();\n    let spec = dyn_spec(288, &used, 32, &dused, false);\n    let mut cases = Vec::new();\n    for _ in 0..40 {\n        let n = rng.below(80) as usize;\n        cases.push(rng.bytes(n));\n    }\n    expect_all_pass(\"C8\", cases.len(), |i| {\n        let data = &cases[i];\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, i % 4, i % 3)\n    });\n}\n\n#[test]\nfn c9_dynamic_random_nlit_ndst() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 9);\n    let mut cases = Vec::new();\n    for _ in 0..200 {\n        let nlit = 257 + rng.below(32) as usize;\n        let ndst = 1 + rng.below(32) as usize;\n        // random non-empty subset of 0..nlit that contains 256\n        let mut used: Vec<usize> = vec![256];\n        let extra = 1 + rng.below(40) as usize;\n        for _ in 0..extra {\n            used.push(rng.below(nlit as u32) as usize);\n        }\n        used.sort_unstable();\n        used.dedup();\n        let mut dused: Vec<usize> = Vec::new();\n        for _ in 0..(1 + rng.below(4)) {\n            dused.push(rng.below(ndst as u32) as usize);\n        }\n        dused.sort_unstable();\n        dused.dedup();\n        let n = rng.below(60) as usize;\n        let pool: Vec<u8> = used\n            .iter()\n            .filter(|&&s| s < 256)\n            .map(|&s| s as u8)\n            .collect();\n        let data: Vec<u8> = if pool.is_empty() {\n            Vec::new()\n        } else {\n            (0..n).map(|_| pool[rng.below(pool.len() as u32) as usize]).collect()\n        };\n        cases.push((nlit, used, ndst, dused, data, rng.below(4) as usize));\n    }\n    expect_all_pass(\"C9\", cases.len(), |i| {\n        let (nlit, used, ndst, dused, data, ia) = &cases[i];\n        let spec = dyn_spec(*nlit, used, *ndst, dused, false);\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n#[test]\nfn c10_dynamic_code_lengths_above_nine() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 10);\n    // skewed_lengths(m) => 1,2,..,m-1,m-1, so m = 13..16 reaches 12..15 bits,\n    // above cp_build's `len <= 9` s->lookup fast path.\n    let mut cases = Vec::new();\n    for m in 11..=16usize {\n        for _ in 0..12 {\n            let mut used: Vec<usize> = vec![256];\n            while used.len() < m {\n                let s = rng.below(255) as usize;\n                if !used.contains(&s) {\n                    used.push(s);\n                }\n            }\n            used.sort_unstable();\n            let pool: Vec<u8> = used.iter().filter(|&&s| s < 256).map(|&s| s as u8).collect();\n            let n = rng.below(50) as usize;\n            let data: Vec<u8> = (0..n)\n                .map(|_| pool[rng.below(pool.len() as u32) as usize])\n                .collect();\n            cases.push((used, data, rng.below(4) as usize));\n        }\n    }\n    expect_all_pass(\"C10\", cases.len(), |i| {\n        let (used, data, ia) = &cases[i];\n        let spec = dyn_spec(257, used, 1, &[0], true);\n        assert!(spec.lit_lens.iter().any(|&l| l > 9), \"no long code produced\");\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n#[test]\nfn c11_dynamic_with_run_length_code_length_symbols() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 11);\n    let mut cases = Vec::new();\n    for _ in 0..120 {\n        let nlit = 257 + rng.below(32) as usize;\n        let ndst = 1 + rng.below(32) as usize;\n        let mut used: Vec<usize> = vec![256];\n        // long stretches of zero lengths => symbols 17 and 18 (runs 3..10, 11..138)\n        // and repeated equal lengths => symbol 16 (runs 3..6)\n        let block = rng.below(20) as usize + 1;\n        let start = rng.below(nlit as u32 - block as u32 - 1) as usize;\n        for k in 0..block {\n            used.push(start + k);\n        }\n        used.sort_unstable();\n        used.dedup();\n        let dused: Vec<usize> = (0..ndst.min(1 + rng.below(3) as usize)).collect();\n        let pool: Vec<u8> = used.iter().filter(|&&s| s < 256).map(|&s| s as u8).collect();\n        let n = rng.below(40) as usize;\n        let data: Vec<u8> = if pool.is_empty() {\n            Vec::new()\n        } else {\n            (0..n).map(|_| pool[rng.below(pool.len() as u32) as usize]).collect()\n        };\n        cases.push((nlit, used, ndst, dused, data, rng.below(4) as usize));\n    }\n    expect_all_pass(\"C11\", cases.len(), |i| {\n        let (nlit, used, ndst, dused, data, ia) = &cases[i];\n        let spec = dyn_spec(*nlit, used, *ndst, dused, false).with_runs();\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n/// Maximum-length runs of every run-length symbol (16 => 6, 17 => 10, 18 => 138).\n#[test]\nfn c11b_dynamic_maximum_runs() {\n    let p = Pair::new();\n    // 288 + 32 == 320 lengths; a single 18-run covers 138, so three of them\n    // plus the tail exercises the longest form.\n    let used: Vec<usize> = vec![0, 1, 2, 256];\n    let spec = dyn_spec(288, &used, 32, &[0, 1], false).with_runs();\n    let data: Vec<u8> = vec![0, 1, 2, 2, 1, 0, 0, 0, 1, 2];\n    expect_all_pass(\"C11b\", 4, |i| {\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(&data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, i, 0)\n    });\n}\n\n#[test]\nfn c12_dynamic_every_hclen() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 12);\n    // HCLEN+4 must still cover every code-length symbol actually used; using\n    // only lengths that map to early permutation slots keeps `need` small.\n    let mut cases = Vec::new();\n    for nlen in 4..=19usize {\n        for _ in 0..6 {\n            let mut used: Vec<usize> = vec![256];\n            for _ in 0..(1 + rng.below(6)) {\n                used.push(rng.below(256) as usize);\n            }\n            used.sort_unstable();\n            used.dedup();\n            let pool: Vec<u8> = used.iter().filter(|&&s| s < 256).map(|&s| s as u8).collect();\n            let n = rng.below(30) as usize;\n            let data: Vec<u8> = (0..n)\n                .map(|_| pool[rng.below(pool.len() as u32) as usize])\n                .collect();\n            cases.push((nlen, used, data));\n        }\n    }\n    let mut skipped = 0usize;\n    let out = run_isolated(cases.len(), |i| {\n        let (nlen, used, data) = &cases[i];\n        let spec = dyn_spec(257, used, 1, &[0], false);\n        // only emit if this HCLEN can carry the symbols we need\n        let mut all = spec.lit_lens.clone();\n        all.extend_from_slice(&spec.dist_lens);\n        let mut need = 4usize;\n        const PERM: [usize; 19] = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15];\n        let mut seen: Vec<usize> = all.iter().map(|&l| l as usize).collect();\n        seen.sort_unstable();\n        seen.dedup();\n        for s in seen {\n            need = need.max(PERM.iter().position(|&x| x == s).unwrap() + 1);\n        }\n        if *nlen < need {\n            return Ok(()); // combination not expressible; covered by other nlen\n        }\n        let spec = spec.hclen(*nlen);\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &lit_toks(data));\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, data.len() as i32, i % 4, 0)\n    });\n    report(\"C12\", &out);\n    let _ = &mut skipped;\n}\n\n#[test]\nfn c13_dynamic_with_back_references() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 13);\n    let mut cases: Vec<Vec<u8>> = Vec::new();\n    for _ in 0..120 {\n        let n = 1 + rng.below(400) as usize;\n        let mode = rng.below(4);\n        let data: Vec<u8> = match mode {\n            0 => vec![rng.byte(); n],                            // long dist-1 runs\n            1 => (0..n).map(|k| (k % 3) as u8).collect(),         // short period\n            2 => (0..n).map(|k| (k / 7) as u8).collect(),         // long runs\n            _ => {\n                let base = rng.bytes(1 + rng.below(20) as usize);\n                (0..n).map(|k| base[k % base.len()]).collect()\n            }\n        };\n        cases.push(data);\n    }\n    expect_all_pass(\"C13\", cases.len(), |i| {\n        let data = &cases[i];\n        let s = deflate_dynamic_lz(data, i % 2 == 0);\n        p.inflate(&s, s.len() as i32, data.len() as i32, i % 4, i % 3)?;\n        let s2 = deflate_fixed_lz(data);\n        p.inflate(&s2, s2.len() as i32, data.len() as i32, (i + 1) % 4, 0)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C14 / C15 — multi-block streams\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c14_multi_block_every_type_sequence() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 14);\n    // 1 = fixed, 2 = dynamic\n    let mut seqs: Vec<Vec<u8>> = vec![\n        vec![1, 1],\n        vec![1, 2],\n        vec![2, 1],\n        vec![2, 2],\n        vec![1, 1, 1],\n        vec![2, 2, 2],\n        vec![1, 2, 1, 2],\n        vec![2, 1, 2, 1, 2],\n    ];\n    for _ in 0..20 {\n        let n = 2 + rng.below(5) as usize;\n        seqs.push((0..n).map(|_| 1 + (rng.below(2) as u8)).collect());\n    }\n    let mut cases = Vec::new();\n    for s in &seqs {\n        let chunks: Vec<Vec<u8>> = s\n            .iter()\n            .map(|_| rng.bytes(rng.below(40) as usize))\n            .collect();\n        cases.push((s.clone(), chunks));\n    }\n    expect_all_pass(\"C14\", cases.len(), |i| {\n        let (seq, chunks) = &cases[i];\n        let mut bw = BitWriter::new();\n        let mut total = 0usize;\n        for (k, &ty) in seq.iter().enumerate() {\n            let last = k + 1 == seq.len();\n            let data = &chunks[k];\n            total += data.len();\n            if ty == 1 {\n                fixed_block(&mut bw, last, &lit_toks(data));\n            } else {\n                let mut used: Vec<usize> = data.iter().map(|&b| b as usize).collect();\n                used.push(256);\n                used.sort_unstable();\n                used.dedup();\n                let spec = dyn_spec(257, &used, 1, &[0], false);\n                dynamic_block(&mut bw, last, &spec, &lit_toks(data));\n            }\n        }\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, total as i32, i % 4, 0)\n    });\n}\n\n#[test]\nfn c15_multi_block_ending_in_stored() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 15);\n    let mut cases = Vec::new();\n    for _ in 0..40 {\n        cases.push((\n            rng.bytes(rng.below(30) as usize),\n            rng.bytes(rng.below(40) as usize),\n        ));\n    }\n    // The C's `s->bits_left / 8 <= LEN` test means a stored block is only\n    // accepted as the very last thing in the stream; leading non-final blocks\n    // are fine, so this shape must work in both.\n    expect_all_pass(\"C15\", cases.len(), |i| {\n        let (a, b) = &cases[i];\n        let mut bw = BitWriter::new();\n        fixed_block(&mut bw, false, &lit_toks(a));\n        stored_block(&mut bw, true, b);\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, (a.len() + b.len()) as i32, i % 4, 0)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C16 / C17 / C18 — bit-reader geometry\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c16_every_alignment_and_final_word_combination() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 16);\n    let mut cases = Vec::new();\n    for ia in 0..4usize {\n        for pad in 0..4usize {\n            for _ in 0..14 {\n                cases.push((rng.bytes(rng.below(70) as usize), ia, pad, rng.byte()));\n            }\n        }\n    }\n    expect_all_pass(\"C16\", cases.len(), |i| {\n        let (data, ia, pad, fill) = &cases[i];\n        // trailing bytes after the final block are never examined, so padding\n        // only moves `first_bytes` / `word_count` / `last_bytes` around\n        let mut s = deflate_fixed_literals(data);\n        s.extend(std::iter::repeat_n(*fill, *pad));\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n#[test]\nfn c17_streams_ending_exactly_on_a_word_boundary() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 17);\n    let mut cases = Vec::new();\n    for _ in 0..250 {\n        let n = rng.below(64) as usize;\n        cases.push((rng.bytes(n), rng.below(4) as usize));\n    }\n    expect_all_pass(\"C17\", cases.len(), |i| {\n        let (data, ia) = &cases[i];\n        let s = deflate_fixed_literals(data);\n        // truncate the declared length to each of the four residues, so the\n        // final-word path is entered with 0..3 leftover bytes\n        for cut in 0..4usize {\n            if s.len() > cut {\n                let n = s.len() - cut;\n                if n % 4 == 0 || cut == 0 {\n                    p.inflate(&s, n as i32, data.len() as i32, *ia, 0)?;\n                }\n            }\n        }\n        p.inflate(&s, s.len() as i32, data.len() as i32, *ia, 0)\n    });\n}\n\n#[test]\nfn c18_output_alignment() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 18);\n    let mut cases = Vec::new();\n    for oa in 0..8usize {\n        for _ in 0..20 {\n            cases.push((rng.bytes(1 + rng.below(60) as usize), oa));\n        }\n    }\n    expect_all_pass(\"C18\", cases.len(), |i| {\n        let (data, oa) = &cases[i];\n        let s = deflate_fixed_lz(data);\n        p.inflate(&s, s.len() as i32, data.len() as i32, 0, *oa)?;\n        let s2 = deflate_stored(data);\n        p.inflate(&s2, s2.len() as i32, data.len() as i32, 0, *oa)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C19 — repeated calls\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c19_repeated_calls_keep_agreeing() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 19);\n    let data = rng.bytes(64);\n    let good = deflate_fixed_literals(&data);\n    let bad = {\n        // btype 3: sets cp_error_reason, which is sticky across later calls\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(3, 2);\n        bw.finish()\n    };\n    expect_all_pass(\"C19\", 40, |i| {\n        if i % 3 == 2 {\n            p.inflate(&bad, bad.len() as i32, 64, i % 4, 0)\n        } else {\n            p.inflate(&good, good.len() as i32, data.len() as i32, i % 4, 0)\n        }\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C20 / C21 / C22 — caller-mutated exported tables\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c20_mutated_cp_fixed_table() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 20);\n    // Replace the fixed code with other *complete* codes and feed a block\n    // encoded with the replacement; both libraries must decode it the same.\n    let mut cases = Vec::new();\n    for _ in 0..60 {\n        let mut used: Vec<usize> = vec![256];\n        for _ in 0..(1 + rng.below(30)) {\n            used.push(rng.below(288) as usize);\n        }\n        used.sort_unstable();\n        used.dedup();\n        let lit = lens_for(288, &used);\n        let dused: Vec<usize> = (0..(1 + rng.below(8) as usize)).collect();\n        let dst = lens_for(32, &dused);\n        let pool: Vec<u8> = used.iter().filter(|&&s| s < 256).map(|&s| s as u8).collect();\n        let n = rng.below(40) as usize;\n        let data: Vec<u8> = if pool.is_empty() {\n            Vec::new()\n        } else {\n            (0..n).map(|_| pool[rng.below(pool.len() as u32) as usize]).collect()\n        };\n        cases.push((lit, dst, data));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (lit, dst, data) = &cases[i];\n        for l in [&p.c, &p.r] {\n            unsafe {\n                std::ptr::copy_nonoverlapping(lit.as_ptr(), l.cp_fixed_table, 288);\n                std::ptr::copy_nonoverlapping(dst.as_ptr(), l.cp_fixed_table.add(288), 32);\n            }\n        }\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(1, 2);\n        emit_tokens(&mut bw, &lit_toks(data), lit, dst);\n        emit_tokens(&mut bw, &[Tok::End], lit, dst);\n        let s = bw.finish();\n        let r = p.inflate(&s, s.len() as i32, data.len() as i32, i % 4, 0);\n        p.reset();\n        r\n    });\n    p.reset();\n    report(\"C20\", &out);\n}\n\n#[test]\nfn c21_mutated_length_and_distance_tables() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 21);\n    let mut cases = Vec::new();\n    for _ in 0..80 {\n        // arbitrary (still small) replacements for the four tables\n        let le: Vec<u8> = (0..31).map(|_| rng.byte() % 6).collect();\n        let lb: Vec<u32> = (0..31).map(|_| 1 + rng.below(40)).collect();\n        let de: Vec<u8> = (0..32).map(|_| rng.byte() % 6).collect();\n        let db: Vec<u32> = (0..32).map(|_| 1 + rng.below(16)).collect();\n        cases.push((le, lb, de, db, rng.bytes(1 + rng.below(50) as usize)));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (le, lb, de, db, data) = &cases[i];\n        for l in [&p.c, &p.r] {\n            unsafe {\n                std::ptr::copy_nonoverlapping(le.as_ptr(), l.cp_len_extra_bits, 31);\n                std::ptr::copy_nonoverlapping(lb.as_ptr(), l.cp_len_base, 31);\n                std::ptr::copy_nonoverlapping(de.as_ptr(), l.cp_dist_extra_bits, 32);\n                std::ptr::copy_nonoverlapping(db.as_ptr(), l.cp_dist_base, 32);\n            }\n        }\n        let s = deflate_fixed_lz(data);\n        // the mutated tables change lengths/distances, so the result is not the\n        // original data any more -- but it must be the *same* wrong thing\n        let r = p.inflate(&s, s.len() as i32, data.len() as i32 + 64, i % 4, i % 3);\n        p.reset();\n        r\n    });\n    p.reset();\n    report(\"C21\", &out);\n}\n\n#[test]\nfn c22_mutated_cp_permutation_order() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 22);\n    let mut cases = Vec::new();\n    for _ in 0..60 {\n        // a random permutation of 0..19 -- still in range, so the stream stays\n        // decodable, but the 3-bit fields land in different slots\n        let mut perm: Vec<u8> = (0..19u8).collect();\n        for k in (1..19).rev() {\n            let j = rng.below(k as u32 + 1) as usize;\n            perm.swap(k, j);\n        }\n        cases.push((perm, rng.bytes(1 + rng.below(40) as usize)));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (perm, data) = &cases[i];\n        for l in [&p.c, &p.r] {\n            unsafe { std::ptr::copy_nonoverlapping(perm.as_ptr(), l.cp_permutation_order, 19) };\n        }\n        let s = deflate_dynamic_literals(data, i % 2 == 0);\n        let r = p.inflate(&s, s.len() as i32, data.len() as i32 + 32, i % 4, 0);\n        p.reset();\n        r\n    });\n    p.reset();\n    report(\"C22\", &out);\n}\n\n// ---------------------------------------------------------------------------\n// C23 — randomised fuzz around the valid corpus\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c23_bit_flips_inside_valid_streams() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 23);\n    let mut cases = Vec::new();\n    for _ in 0..1500 {\n        let data = rng.bytes(1 + rng.below(48) as usize);\n        let mut s = match rng.below(4) {\n            0 => deflate_stored(&data),\n            1 => deflate_fixed_literals(&data),\n            2 => deflate_dynamic_literals(&data, rng.bool()),\n            _ => deflate_fixed_lz(&data),\n        };\n        let flips = rng.below(3);\n        for _ in 0..flips {\n            let k = rng.below(s.len() as u32) as usize;\n            s[k] ^= 1 << rng.below(8);\n        }\n        cases.push((s, data.len(), rng.below(4) as usize, rng.below(4) as usize));\n    }\n    // Flipped bits routinely make the C (with asserts compiled out) walk into\n    // undefined territory, so this runs under fork isolation; the NDEBUG C and\n    // the Rust must still agree byte for byte whenever the C stays alive.\n    let out = run_isolated(cases.len(), |i| {\n        let (s, n, ia, oa) = &cases[i];\n        p.inflate(s, s.len() as i32, *n as i32, *ia, *oa)\n    });\n    let bad: Vec<String> = out\n        .iter()\n        .enumerate()\n        .filter_map(|(i, o)| match o {\n            CaseOutcome::Fail(m) => Some(format!(\"case {i}: {m}\")),\n            _ => None,\n        })\n        .collect();\n    assert!(bad.is_empty(), \"C23 mismatches:\\n{}\", bad.join(\"\\n\"));\n    let crashed = out\n        .iter()\n        .filter(|o| matches!(o, CaseOutcome::Killed(_)))\n        .count();\n    eprintln!(\n        \"C23: {} cases compared, {} skipped after a C-side crash\",\n        out.iter().filter(|o| **o == CaseOutcome::Pass).count(),\n        crashed + out.iter().filter(|o| **o == CaseOutcome::NotRun).count()\n    );\n}\n\n// ---------------------------------------------------------------------------\n// C24 — empty Huffman trees (`cp_decode` reads `tree[-1]`)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c24_empty_literal_tree_reads_tree_minus_one() {\n    let p = Pair::new();\n    // All 257 literal lengths zero => cp_build returns 0 => cp_decode runs with\n    // hi == 0 and reads s->lit[-1], i.e. the last two entries of s->lookup.\n    let spec = DynSpec::new(vec![0u8; 257], vec![0u8; 1]);\n    expect_all_pass(\"C24-lit\", 16, |i| {\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(2, 2);\n        dynamic_header(&mut bw, &spec);\n        for _ in 0..(i % 4) {\n            bw.bits(0xAB, 8);\n        }\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, (i as i32 % 5) * 3, i % 4, i % 3)\n    });\n}\n\n#[test]\nfn c24_empty_distance_tree_reads_lit_287() {\n    let p = Pair::new();\n    // nlit = 288 with a complete code (so s->lit is fully populated) and an\n    // empty distance tree => cp_decode(s, s->dst, 0) reads s->dst[-1], which is\n    // s->lit[287]. Requires cp_state_t's field offsets to match the C exactly.\n    let used: Vec<usize> = (0..288).collect();\n    let spec = DynSpec::new(lens_for(288, &used), vec![0u8; 1]);\n    let mut rng = Rng::new(SEED ^ 24);\n    let mut cases = Vec::new();\n    for _ in 0..40 {\n        let seed: Vec<u8> = rng.bytes(1 + rng.below(20) as usize);\n        let len = 3 + rng.below(30) as u16;\n        cases.push((seed, len, rng.below(4) as usize, rng.below(200) as i32));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (seed, len, ia, out_bytes) = &cases[i];\n        let mut toks = lit_toks(seed);\n        toks.push(Tok::Match { len: *len, dist: 1 });\n        let mut bw = BitWriter::new();\n        dynamic_block(&mut bw, true, &spec, &toks);\n        let s = bw.finish();\n        p.inflate(&s, s.len() as i32, *out_bytes, *ia, 0)\n    });\n    let bad: Vec<String> = out\n        .iter()\n        .enumerate()\n        .filter_map(|(i, o)| match o {\n            CaseOutcome::Fail(m) => Some(format!(\"case {i}: {m}\")),\n            _ => None,\n        })\n        .collect();\n    assert!(bad.is_empty(), \"C24-dst mismatches:\\n{}\", bad.join(\"\\n\"));\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
