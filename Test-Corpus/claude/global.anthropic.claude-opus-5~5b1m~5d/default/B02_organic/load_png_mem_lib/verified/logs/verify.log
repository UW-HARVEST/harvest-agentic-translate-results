nd therefore `abort()`s on a\n331\t// good number of malformed inputs; malformed input can also make it read or\n332\t// write outside an object. Running each batch of cases in a forked child keeps\n333\t// the test process alive and tells us exactly which case died and how.\n334\t// ---------------------------------------------------------------------------\n335\t\n336\t#[derive(Debug, Clone, PartialEq, Eq)]\n337\tpub enum CaseOutcome {\n338\t    Pass,\n339\t    Fail(String),\n340\t    /// The child died on this case (signal number).\n341\t    Killed(i32),\n342\t    /// Never reached (an earlier case killed the child).\n343\t    NotRun,\n344\t}\n345\t\n346\t/// Runs `f(i)` for `i` in `0..n` inside a forked child, streaming one result\n347\t/// per case back to the parent. A crash is attributed to the case that was in\n348\t/// flight. `f` must be deterministic and self-contained.\n349\tpub fn run_isolated<F>(n: usize, mut f: F) -> Vec<CaseOutcome>\n350\twhere\n351\t    F: FnMut(usize) -> Result<(), String>,\n352\t{\n353\t    const MSG_CAP: usize = 512;\n354\t    const REC: usize = 4 + MSG_CAP;\n355\t    unsafe {\n356\t        let mut fds = [0i32; 2];\n357\t        assert_eq!(pipe(fds.as_mut_ptr()), 0, \"pipe failed\");\n358\t        let (rd, wr) = (fds[0], fds[1]);\n359\t        let pid = fork();"}]},"parent_tool_use_id":null,"session_id":"ca950163-4526-4c83-bcdb-90a4f8c566ab","uuid":"bd00acb1-df00-4edc-b70c-a2f2a5812e2e","timestamp":"2026-08-27T13:06:49.670Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/common/mod.rs","content":"}\n\n// ---------------------------------------------------------------------------\n// Buffers with controlled alignment\n// ---------------------------------------------------------------------------\n\n/// A heap buffer whose start address has a chosen value mod 4.\npub struct AlignedBuf {\n    base: *mut u8,\n    pub ptr: *mut u8,\n    pub len: usize,\n}\n\nimpl AlignedBuf {\n    pub fn new(len: usize, misalign: usize) -> AlignedBuf {\n        unsafe {\n            let mut base: *mut c_void = std::ptr::null_mut();\n            let cap = len + 64;\n            assert_eq!(posix_memalign(&mut base, 64, cap.max(64)), 0);\n            memset(base, 0, cap.max(64));\n            let ptr = (base as *mut u8).add(misalign & 63);\n            AlignedBuf {\n                base: base as *mut u8,\n                ptr,\n                len,\n            }\n        }\n    }\n    pub fn from_slice(data: &[u8], misalign: usize) -> AlignedBuf {\n        let b = AlignedBuf::new(data.len(), misalign);\n        unsafe { std::ptr::copy_nonoverlapping(data.as_ptr(), b.ptr, data.len()) };\n        b\n    }\n    pub fn as_slice(&self) -> &[u8] {\n        unsafe { std::slice::from_raw_parts(self.ptr, self.len) }\n    }\n    pub fn fill(&self, v: u8) {\n        unsafe { memset(self.ptr as *mut c_void, v as c_int, self.len) };\n    }\n}\n\nimpl Drop for AlignedBuf {\n    fn drop(&mut self) {\n        unsafe { free(self.base as *mut c_void) }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Fork isolation\n//\n// The reference C library has `assert()` enabled and therefore `abort()`s on a\n// good number of malformed inputs; malformed input can also make it read or\n// write outside an object. Running each batch of cases in a forked child keeps\n// the test process alive and tells us exactly which case died and how.\n// ---------------------------------------------------------------------------\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum CaseOutcome {\n    Pass,\n    Fail(String),\n    /// The child died on this case (signal number).\n    Killed(i32),\n    /// Never reached (an earlier case killed the child).\n    NotRun,\n}\n\n/// Runs `f(i)` for `i` in `0..n` inside a forked child, streaming one result\n/// per case back to the parent. A crash is attributed to the case that was in\n/// flight. `f` must be deterministic and self-contained.\npub fn run_isolated<F>(n: usize, mut f: F) -> Vec<CaseOutcome>\nwhere\n    F: FnMut(usize) -> Result<(), String>,\n{\n    const MSG_CAP: usize = 512;\n    const REC: usize = 4 + MSG_CAP;\n    unsafe {\n        let mut fds = [0i32; 2];\n        assert_eq!(pipe(fds.as_mut_ptr()), 0, \"pipe failed\");\n        let (rd, wr) = (fds[0], fds[1]);\n        let pid = fork();","numLines":80,"startLine":280,"totalLines":469}}}
