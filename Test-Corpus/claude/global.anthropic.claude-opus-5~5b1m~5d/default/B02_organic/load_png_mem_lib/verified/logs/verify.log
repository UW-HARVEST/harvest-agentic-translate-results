{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_wogwpwrvfrk2e6ilc77femgq37n3lmsvddycjawoa3uvnsjzq7ma","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01EhneuDidZtvz7bRvEv39Qr","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/errors.rs","content":"//! Phase C — error-path differential tests, one per row of `ERRORS.md`.\n//!\n//! Each test constructs the exact invalid input the C checks for, then requires\n//! that\n//!   * the C actually produces *that* rejection (the exact `cp_error_reason`\n//!     string, so the test cannot silently drift onto a different branch), and\n//!   * the Rust produces the same sentinel, the same string, the same\n//!     `img.w`/`img.h`, and the same output bytes.\n\nmod common;\n\nuse common::diff::Pair;\nuse common::mk::*;\nuse common::*;\n\nconst SEED: u64 = 0xE770_0000_1234_5678;\n\n// ===========================================================================\n// E1 / E2 — cp_stored\n// ===========================================================================\n\n#[test]\nfn e1_stored_len_nlen_not_complements() {\n    let p = Pair::new();\n    let reason = \"Failed to find LEN and NLEN as complements within \\\n                  stored (uncompressed) stream.\";\n    let mut rng = Rng::new(SEED ^ 1);\n    let mut cases = Vec::new();\n    for n in [0u16, 1, 3, 8, 64] {\n        for bad in [0u16, 0xFFFF, 1, 0x1234] {\n            if bad == !n {\n                continue;\n            }\n            cases.push((n, bad, rng.below(4) as usize));\n        }\n    }\n    expect_all_pass(\"E1\", cases.len(), |i| {\n        let (n, nlen, ia) = cases[i];\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(0, 2);\n        bw.align();\n        bw.bits(n as u32, 16);\n        bw.bits(nlen as u32, 16); // deliberately not ~LEN\n        bw.raw(&vec![0xEE; n as usize]);\n        let s = bw.finish();\n        p.inflate_expect_err(&s, s.len() as i32, n as i32 + 8, ia, reason)\n    });\n}\n\n#[test]\nfn e2_stored_block_extends_beyond_input() {\n    let p = Pair::new();\n    let reason = \"Stored block extends beyond end of input stream.\";\n    let mut cases = Vec::new();\n    for n in [0usize, 1, 3, 16, 100] {\n        for extra in [1usize, 2, 3, 4, 9] {\n            for ia in 0..4 {\n                cases.push((n, extra, ia));\n            }\n        }\n    }\n    expect_all_pass(\"E2\", cases.len(), |i| {\n        let (n, extra, ia) = cases[i];\n        // A stored block is only accepted when it is the last thing in the\n        // stream: `s->bits_left / 8 <= LEN`. Any trailing byte breaks that.\n        let mut s = deflate_stored(&vec![0x5C; n]);\n        s.extend(std::iter::repeat_n(0xAAu8, extra));\n        p.inflate_expect_err(&s, s.len() as i32, n as i32 + 16, ia, reason)\n    });\n}\n\n#[test]\nfn e2b_non_final_stored_block() {\n    let p = Pair::new();\n    let reason = \"Stored block extends beyond end of input stream.\";\n    expect_all_pass(\"E2b\", 8, |i| {\n        // bfinal = 0 on a stored block: another block must follow, so the\n        // `bits_left / 8 <= LEN` test necessarily fails.\n        let mut bw = BitWriter::new();\n        stored_block(&mut bw, false, &vec![0x11; i * 3]);\n        fixed_block(&mut bw, true, &[Tok::Lit(1)]);\n        let s = bw.finish();\n        p.inflate_expect_err(&s, s.len() as i32, 64, i % 4, reason)\n    });\n}\n\n// ===========================================================================\n// E3 / E4 / E5 — cp_block\n// ===========================================================================\n\n#[test]\nfn e3_literal_overruns_the_output_buffer() {\n    let p = Pair::new();\n    let reason = \"Attempted to overwrite out buffer while outputting a symbol.\";\n    let mut rng = Rng::new(SEED ^ 3);\n    let mut cases = Vec::new();\n    for out_bytes in [0i32, 1, 2, 5, 17] {\n        for extra in [1usize, 2, 9] {\n            for ia in 0..4 {\n                let n = out_bytes.max(0) as usize + extra;\n                cases.push((rng.bytes(n), out_bytes, ia));\n            }\n        }\n    }\n    expect_all_pass(\"E3\", cases.len(), |i| {\n        let (data, out_bytes, ia) = &cases[i];\n        for s in [\n            deflate_fixed_literals(data),\n            deflate_dynamic_literals(data, false),\n            deflate_dynamic_literals(data, true),\n        ] {\n            p.inflate_expect_err(&s, s.len() as i32, *out_bytes, *ia, reason)?;\n        }\n        Ok(())\n    });\n}\n\n#[test]\nfn e4_back_reference_before_the_output_buffer() {\n    let p = Pair::new();\n    let reason = \"Attempted to write before out buffer (invalid backwards distance).\";\n    let mut cases = Vec::new();\n    for produced in [0usize, 1, 2, 7] {\n        for dist in [1u16, 2, 3, 17, 258, 32768] {\n            if (dist as usize) <= produced {\n                continue;\n            }\n            for ia in 0..4 {\n                cases.push((produced, dist, ia));\n            }\n        }\n    }\n    expect_all_pass(\"E4\", cases.len(), |i| {\n        let (produced, dist, ia) = cases[i];\n        let seed: Vec<u8> = (0..produced).map(|k| 0x40 | k as u8).collect();\n        let mut toks: Vec<Tok> = seed.iter().map(|&b| Tok::Lit(b)).collect();\n        toks.push(Tok::Match { len: 3, dist });\n        let mut bw = BitWriter::new();\n        fixed_block(&mut bw, true, &toks);\n        let s = bw.finish();\n        p.inflate_expect_err(&s, s.len() as i32, 1 << 16, ia, reason)\n    });\n}\n\n#[test]\nfn e5_back_reference_overruns_the_output_buffer() {\n    let p = Pair::new();\n    let reason = \"Attempted to overwrite out buffer while outputting a string.\";\n    let mut cases = Vec::new();\n    for len in [3u16, 4, 17, 100, 258] {\n        for slack in [0i32, 1, 2] {\n            for ia in 0..4 {\n                cases.push((len, slack, ia));\n            }\n        }\n    }\n    expect_all_pass(\"E5\", cases.len(), |i| {\n        let (len, slack, ia) = cases[i];\n        let seed = [0x77u8, 0x88];\n        let mut toks: Vec<Tok> = seed.iter().map(|&b| Tok::Lit(b)).collect();\n        toks.push(Tok::Match { len, dist: 2 });\n        let mut bw = BitWriter::new();\n        fixed_block(&mut bw, true, &toks);\n        let s = bw.finish();\n        // room for the two literals plus `slack` of the `len` copied bytes\n        let out_bytes = seed.len() as i32 + slack;\n        p.inflate_expect_err(&s, s.len() as i32, out_bytes, ia, reason)\n    });\n}\n\n// ===========================================================================\n// E6 / E7 — cp_inflate block dispatch\n// ===========================================================================\n\n#[test]\nfn e6_unknown_block_type() {\n    let p = Pair::new();\n    let reason = \"Detected unknown block type within input stream.\";\n    let mut rng = Rng::new(SEED ^ 6);\n    let mut cases = Vec::new();\n    for bfinal in [0u32, 1] {\n        for ia in 0..4 {\n            for pad in 0..4usize {\n                cases.push((bfinal, ia, rng.bytes(pad)));\n            }\n        }\n    }\n    expect_all_pass(\"E6\", cases.len(), |i| {\n        let (bfinal, ia, pad) = &cases[i];\n        let mut bw = BitWriter::new();\n        bw.bits(*bfinal, 1);\n        bw.bits(3, 2); // btype == 3\n        let mut s = bw.finish();\n        s.extend_from_slice(pad);\n        p.inflate_expect_err(&s, s.len() as i32, 32, *ia, reason)\n    });\n}\n\n#[test]\nfn e6b_unknown_block_type_after_a_good_block() {\n    let p = Pair::new();\n    let reason = \"Detected unknown block type within input stream.\";\n    expect_all_pass(\"E6b\", 8, |i| {\n        let mut bw = BitWriter::new();\n        fixed_block(&mut bw, false, &[Tok::Lit(1), Tok::Lit(2)]);\n        bw.bits(1, 1);\n        bw.bits(3, 2);\n        let s = bw.finish();\n        p.inflate_expect_err(&s, s.len() as i32, 32, i % 4, reason)\n    });\n}\n\n#[test]\nfn e7_inner_failure_propagates_out_of_a_multi_block_stream() {\n    let p = Pair::new();\n    expect_all_pass(\"E7\", 12, |i| {\n        // block 1 is fine, block 2 overruns the output => the *inner* reason is\n        // what cp_inflate leaves behind (load_png_mem later overwrites it).\n        let mut bw = BitWriter::new();\n        fixed_block(&mut bw, false, &[Tok::Lit(0xA1), Tok::Lit(0xA2)]);\n        fixed_block(&mut bw, true, &vec![Tok::Lit(0xB0); 8]);\n        let s = bw.finish();\n        p.inflate_expect_err(\n            &s,\n            s.len() as i32,\n            4,\n            i % 4,\n            \"Attempted to overwrite out buffer while outputting a symbol.\",\n        )\n    });\n}\n\n// ===========================================================================\n// E8 / E9 / E13 — cp_chunk and cp_find returning NULL\n// ===========================================================================\n\nfn tiny_raw(rng: &mut Rng, w: usize, h: usize, bpp: usize) -> Vec<u8> {\n    raw_image(rng, w, h, bpp, &[0])\n}\n\n#[test]\nfn e8_e13_ihdr_chunk_not_found() {\n    let p = Pair::new();\n    let reason = \"unable to find IHDR chunk\";\n    let mut rng = Rng::new(SEED ^ 8);\n    let raw = tiny_raw(&mut rng, 2, 2, 3);\n    let ihdr_payload = {\n        let mut v = Vec::new();\n        v.extend_from_slice(&2u32.to_be_bytes());\n        v.extend_from_slice(&2u32.to_be_bytes());\n        v.extend_from_slice(&[8, 2, 0, 0, 0]);\n        v\n    };\n    let idat = chunk(b\"IDAT\", &zlib_default(&deflate_fixed_literals(&raw)));\n\n    let mut cases: Vec<(String, Vec<u8>, i32)> = Vec::new();\n    let mut add = |name: &str, body: Vec<u8>, len: Option<i32>| {\n        let n = len.unwrap_or(body.len() as i32);\n        cases.push((name.to_string(), body, n));\n    };\n\n    // E8a: the first chunk is not an IHDR\n    for kind in [b\"iHDR\", b\"IHDr\", b\"PLTE\", b\"IDAT\", b\"\\0\\0\\0\\0\"] {\n        let mut v = SIG.to_vec();\n        v.extend_from_slice(&chunk(kind, &ihdr_payload));\n        v.extend_from_slice(&idat);\n        add(\"E8a wrong type\", v, None);\n    }\n    // E8b: IHDR shorter than minlen 13\n    for l in 0u32..13 {\n        let mut v = SIG.to_vec();\n        v.extend_from_slice(&chunk(b\"IHDR\", &ihdr_payload[..l.min(13) as usize]));\n        v.extend_from_slice(&idat);\n        add(\"E8b len<13\", v, None);\n    }\n    // E8c: declared length runs past png.end\n    for declared in [13u32, 14, 100, 0x7FFF_FFFF, 0x8000_0000, 0xFFFF_FFF3] {\n        let mut v = SIG.to_vec();\n        v.extend_from_slice(&chunk_raw_len(b\"IHDR\", declared, &ihdr_payload));\n        let n = v.len() as i32;\n        if declared != 13 {\n            add(\"E8c overruns end\", v, Some(n));\n        }\n    }\n    // ... and a correctly-declared IHDR whose file is truncated\n    for cut in 1..=12usize {\n        let mut v = SIG.to_vec();\n        v.extend_from_slice(&chunk(b\"IHDR\", &ihdr_payload));\n        let n = v.len() as i32 - cut as i32;\n        add(\"E8c truncated\", v, Some(n));\n    }\n    // nothing but the signature\n    add(\"only signature\", SIG.to_vec(), None);\n\n    expect_all_pass(\"E8/E13\", cases.len(), |i| {\n        let (name, body, len) = &cases[i];\n        p.png_expect_err(body, *len, reason)\n            .map_err(|e| format!(\"[{name}] {e}\"))\n    });\n}\n\n#[test]\nfn e9_cp_find_walks_off_the_end() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 9);\n    // No IDAT at all => cp_find returns NULL => datalen 0 => E23.\n    let raw = tiny_raw(&mut rng, 3, 2, 3);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let mut cases = Vec::new();\n    for filler in [\n        vec![],\n        vec![chunk(b\"tEXt\", b\"x\")],\n        vec![chunk(b\"IDAt\", &z)],\n        vec![chunk(b\"tEXt\", b\"x\"), chunk(b\"gAMA\", &[1, 2, 3, 4])],\n        // a chunk whose declared length runs past the end: cp_find advances p\n        // past png.end and stops\n        vec![chunk_raw_len(b\"tEXt\", 10_000, b\"short\")],\n    ] {\n        let mut spec = PngSpec::new(3, 2, 2, Vec::new());\n        spec.pre_chunks = filler;\n        spec.idat = Vec::new();\n        let mut v = spec.build();\n        // strip the (empty) IDAT that PngSpec always emits\n        v = {\n            let empty = chunk(b\"IDAT\", &[]);\n            let pos = v\n                .windows(empty.len())\n                .position(|w| w == empty.as_slice())\n                .unwrap();\n            let mut out = v[..pos].to_vec();\n            out.extend_from_slice(&v[pos + empty.len()..]);\n            out\n        };\n        cases.push(v);\n    }\n    expect_all_pass(\"E9\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, \"corrupt zlib structure in DEFLATE stream\")\n    });\n}\n\n/// `cp_find` advances with `png->p += len + 12` in **`uint32_t`** arithmetic, so\n/// a declared chunk length of `0xFFFFFFF4` makes `len + 12` wrap to 0 and the\n/// pointer never moves: the C loops for ever. The translation reproduces the\n/// same wrap and hangs identically -- which is what this test asserts.\n#[test]\nfn e9b_chunk_length_that_wraps_the_cp_find_stride_hangs_both() {\n    let p = Pair::new();\n    let mut v = SIG.to_vec();\n    {\n        let mut ihdr = Vec::new();\n        ihdr.extend_from_slice(&2u32.to_be_bytes());\n        ihdr.extend_from_slice(&2u32.to_be_bytes());\n        ihdr.extend_from_slice(&[8, 2, 0, 0, 0]);\n        v.extend_from_slice(&chunk(b\"IHDR\", &ihdr));\n    }\n    // type is not PLTE/tRNS/IDAT, so cp_find keeps looking -- for ever\n    v.extend_from_slice(&chunk_raw_len(b\"tEXt\", 0xFFFF_FFF4, b\"\"));\n    v.extend_from_slice(&chunk(b\"IEND\", &[]));\n\n    let fate = |l: &Lib| {\n        let o = run_isolated(1, |_| {\n            let buf = AlignedBuf::from_slice(&v, 0);\n            let q = common::diff::probe_png_raw(l, buf.ptr, v.len() as i32);\n            Err(format!(\"{q:?}\"))\n        });\n        o.into_iter().next().unwrap()\n    };\n    let c = fate(&p.c);\n    let r = fate(&p.r);\n    assert_eq!(c, CaseOutcome::Killed(14), \"expected the C to hang: {c:?}\");\n    assert_eq!(r, CaseOutcome::Killed(14), \"the Rust must hang too: {r:?}\");\n    // and the same for the reference (assert-enabled) build\n    assert_eq!(fate(&p.ca), CaseOutcome::Killed(14));\n}\n\n// ===========================================================================\n// E10 / E11 / E30 / G12 — cp_unfilter\n// ===========================================================================\n\n#[test]\nfn e10_e30_invalid_filter_byte_on_row_zero() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 10);\n    let reason = \"invalid filter byte found\";\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for f in 5u16..=255 {\n            let bpp = bpp_of(ct);\n            let (w, h) = (3usize, 2usize);\n            let mut raw = raw_image(&mut rng, w, h, bpp, &[0]);\n            raw[0] = f as u8;\n            let mut spec =\n                PngSpec::new(w as u32, h as u32, ct, zlib_default(&deflate_fixed_literals(&raw)));\n            if ct == 3 {\n                spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n            }\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"E10/E30\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n#[test]\nfn e11_invalid_filter_byte_on_a_later_row() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 11);\n    let reason = \"invalid filter byte found\";\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for f in [5u8, 6, 7, 100, 128, 200, 254, 255] {\n            for row in 1..4usize {\n                let bpp = bpp_of(ct);\n                let (w, h) = (4usize, 4usize);\n                let stride = w * bpp + 1;\n                let mut raw = raw_image(&mut rng, w, h, bpp, &[0, 1, 2, 3]);\n                raw[row * stride] = f;\n                let mut spec = PngSpec::new(\n                    w as u32,\n                    h as u32,\n                    ct,\n                    zlib_default(&deflate_fixed_literals(&raw)),\n                );\n                if ct == 3 {\n                    spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                }\n                cases.push(spec.build());\n            }\n        }\n    }\n    expect_all_pass(\"E11\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n/// `h > 0` guards row 0's filter switch, so the *first* filter byte of a\n/// one-row image is the only one examined; `h == 1` never reaches the second\n/// loop. Both edges, all 256 filter values.\n#[test]\nfn g12_every_filter_byte_value() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 0x12);\n    let mut cases = Vec::new();\n    for f in 0u16..=255 {\n        for &(w, h) in &[(1usize, 1usize), (4, 1), (4, 3)] {\n            let mut raw = raw_image(&mut rng, w, h, 3, &[0]);\n            raw[0] = f as u8;\n            cases.push(\n                PngSpec::new(w as u32, h as u32, 2, zlib_default(&deflate_fixed_literals(&raw)))\n                    .build(),\n            );\n        }\n    }\n    expect_all_pass(\"G12\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n// ===========================================================================\n// E12 — signature\n// ===========================================================================\n\n#[test]\nfn e12_bad_signature() {\n    let p = Pair::new();\n    let reason = \"incorrect file signature (is this a png file?)\";\n    let mut rng = Rng::new(SEED ^ 12);\n    let mut cases: Vec<(Vec<u8>, i32)> = Vec::new();\n    // every single-byte corruption of the signature\n    for k in 0..8usize {\n        for delta in [1u8, 0x80, 0xFF] {\n            let mut v = SIG.to_vec();\n            v[k] ^= delta;\n            v.extend_from_slice(&rng.bytes(40));\n            let n = v.len() as i32;\n            cases.push((v, n));\n        }\n    }\n    // shorter than the signature (the C memcmp's 8 bytes regardless)\n    for n in 0..8i32 {\n        let mut v = SIG.to_vec();\n        v[7] ^= 1; // make sure it really is wrong\n        v.extend_from_slice(&rng.bytes(20));\n        cases.push((v, n));\n    }\n    cases.push((Vec::new(), 0));\n    cases.push((b\"not a png\".to_vec(), 9));\n    cases.push((vec![0u8; 64], 64));\n    cases.push((vec![0xFFu8; 64], 64));\n    expect_all_pass(\"E12\", cases.len(), |i| {\n        let (v, n) = &cases[i];\n        p.png_expect_err(v, *n, reason)\n    });\n}\n\n/// G2/G3/G4: a *correct* signature with a length that stops short of, or runs\n/// past, the buffer. The C never looks at `png_length` before the `memcmp`.\n#[test]\nfn g2_g3_g4_png_length_edges() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 0x24);\n    let raw = tiny_raw(&mut rng, 3, 2, 3);\n    let good = PngSpec::new(3, 2, 2, zlib_default(&deflate_fixed_literals(&raw))).build();\n    let mut cases: Vec<(Vec<u8>, i32)> = Vec::new();\n    for n in [\n        0i32,\n        1,\n        7,\n        8,\n        9,\n        12,\n        20,\n        24,\n        25,\n        26,\n        good.len() as i32 - 1,\n        good.len() as i32,\n        good.len() as i32 + 1,\n        good.len() as i32 + 1000,\n        -1,\n        -2,\n        -1000,\n        i32::MIN,\n        i32::MAX,\n    ] {\n        cases.push((good.clone(), n));\n    }\n    // only the signature, with every plausible length\n    for n in -4..12i32 {\n        cases.push((SIG.to_vec(), n));\n    }\n    expect_all_pass(\"G2/G3/G4\", cases.len(), |i| {\n        let (v, n) = &cases[i];\n        p.png(v, *n)\n    });\n}\n\n// ===========================================================================\n// E14 / E15 / E20 / E21 / E22 / G11 — every IHDR option byte, all 256 values\n// ===========================================================================\n\nfn ihdr_option_sweep(label: &str, field: usize, expect: &dyn Fn(u8) -> Option<&'static str>) {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ (0x100 + field as u64));\n    let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let plte = chunk(b\"PLTE\", &rng.bytes(768));\n    let mut cases = Vec::new();\n    for v in 0u16..=255 {\n        let mut spec = PngSpec::new(3, 2, 2, z.clone());\n        // field 0 = bit_depth, 1 = colour_type, 2 = compression,\n        // 3 = filter, 4 = interlace\n        match field {\n            0 => spec.bit_depth = v as u8,\n            1 => spec.color_type = v as u8,\n            2 => spec.compression = v as u8,\n            3 => spec.filter = v as u8,\n            _ => spec.interlace = v as u8,\n        }\n        spec.pre_chunks.push(plte.clone());\n        cases.push((v as u8, spec.build()));\n    }\n    expect_all_pass(label, cases.len(), |i| {\n        let (v, body) = &cases[i];\n        match expect(*v) {\n            Some(reason) => p\n                .png_expect_err(body, body.len() as i32, reason)\n                .map_err(|e| format!(\"[field {field} = {v}] {e}\")),\n            None => p\n                .png(body, body.len() as i32)\n                .map_err(|e| format!(\"[field {field} = {v}] {e}\")),\n        }\n    });\n}\n\n#[test]\nfn e14_g11_every_bit_depth() {\n    ihdr_option_sweep(\"E14\", 0, &|v| {\n        if v == 8 {\n            None\n        } else {\n            Some(\"only bit-depth of 8 is supported\")\n        }\n    });\n}\n\n#[test]\nfn e15_g11_every_colour_type() {\n    // The raw stream in the sweep is sized for bpp 3; other colour types decode\n    // a differently sized image, which is a *valid* configuration -- it just may\n    // read uninitialised heap, which `Pair::png` detects and skips.\n    ihdr_option_sweep(\"E15\", 1, &|v| {\n        if matches!(v, 0 | 2 | 3 | 4 | 6) {\n            None\n        } else {\n            Some(\"unknown color type\")\n        }\n    });\n}\n\n#[test]\nfn e20_g11_every_compression_byte() {\n    ihdr_option_sweep(\"E20\", 2, &|v| {\n        if v == 0 {\n            None\n        } else {\n            Some(\"only standard compression DEFLATE is supported\")\n        }\n    });\n}\n\n#[test]\nfn e21_g11_every_filter_method_byte() {\n    ihdr_option_sweep(\"E21\", 3, &|v| {\n        if v == 0 {\n            None\n        } else {\n            Some(\"only standard adaptive filtering is supported\")\n        }\n    });\n}\n\n#[test]\nfn e22_g11_every_interlace_byte() {\n    ihdr_option_sweep(\"E22\", 4, &|v| {\n        if v == 0 {\n            None\n        } else {\n            Some(\"interlacing is not supported\")\n        }\n    });\n}\n\n// ===========================================================================\n// E16 / E17 / E18 — width, height, size cap\n// ===========================================================================\n\n#[test]\nfn e16_width_less_than_one() {\n    let p = Pair::new();\n    let reason = \"invalid IHDR chunk found, image width was less than 1\";\n    let mut rng = Rng::new(SEED ^ 16);\n    let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    // w = cp_make32(ihdr) + 1 as int, so the rejected field values are those\n    // giving w == 0 (0xFFFFFFFF) or w < 0 (0x7FFFFFFF ..= 0xFFFFFFFE).\n    let mut cases = Vec::new();\n    for width in [\n        0x7FFF_FFFFu32,\n        0x8000_0000,\n        0x8000_0001,\n        0xC000_0000,\n        0xFFFF_FFFE,\n        0xFFFF_FFFF,\n    ] {\n        let mut spec = PngSpec::new(width, 2, 2, z.clone());\n        spec.width = width;\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"E16\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n#[test]\nfn e17_height_less_than_one() {\n    let p = Pair::new();\n    let reason = \"invalid IHDR chunk found, image height was less than 1\";\n    let mut rng = Rng::new(SEED ^ 17);\n    let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let mut cases = Vec::new();\n    for height in [\n        0u32,\n        0x8000_0000,\n        0x8000_0001,\n        0xC000_0000,\n        0xFFFF_FFFF,\n        0xFFFF_FFFE,\n    ] {\n        let mut spec = PngSpec::new(3, height, 2, z.clone());\n        spec.height = height;\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"E17\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n#[test]\nfn e18_image_too_large() {\n    let p = Pair::new();\n    let reason = \"image too large\";\n    let mut rng = Rng::new(SEED ^ 18);\n    let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    // (int64)w * h * 4 must be < INT_MAX, and the `sizeof` makes the comparison\n    // unsigned. w is the IHDR field + 1.\n    let mut cases = Vec::new();\n    for (wf, h) in [\n        (0x7FFF_FFFEu32, 1u32),        // w = INT_MAX      -> 4*INT_MAX\n        (0x7FFF_FFFEu32, 2),\n        (0x0000_7FFF, 0x0000_8000),    // 32768 * 32768 * 4 == 2^32\n        (0x0000_7FFF, 0x0001_0000),\n        (0x0001_FFFF, 0x0000_2000),\n        (536_870_911, 1),              // w = 2^29 -> 4*2^29 == 2^31 > INT_MAX\n        (0x0000_FFFF, 0x0000_2000),\n        (1, 0x2000_0000),\n    ] {\n        let mut spec = PngSpec::new(wf, h, 2, z.clone());\n        spec.width = wf;\n        spec.height = h;\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"E18\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n/// The largest size E18 lets through, i.e. right at the boundary. Whether the\n/// following `malloc` succeeds is up to the allocator (row E19); either way the\n/// two libraries must agree.\n#[test]\nfn e18b_e19_largest_accepted_size() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 19);\n    let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let mut cases = Vec::new();\n    for (wf, h) in [\n        (536_870_910u32, 1u32), // w = 2^29-1 -> 4*(2^29-1) < INT_MAX\n        (0x0000_7FFE, 0x0000_8000),\n        (23_000, 23_000),\n    ] {\n        let mut spec = PngSpec::new(wf, h, 2, z.clone());\n        spec.width = wf;\n        spec.height = h;\n        cases.push(spec.build());\n    }\n    // Under fork isolation: a ~2 GiB malloc can legitimately fail, and either\n    // outcome must be the same in both libraries.\n    let out = run_isolated(cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n    expect_no_mismatch(\"E18b/E19\", &out);\n}\n\n// ===========================================================================\n// E23 / E24 / E25 / E26 — the zlib header\n// ===========================================================================\n\n#[test]\nfn e23_corrupt_zlib_structure() {\n    let p = Pair::new();\n    let reason = \"corrupt zlib structure in DEFLATE stream\";\n    let mut rng = Rng::new(SEED ^ 23);\n    let mut cases = Vec::new();\n    // datalen 0..5 (and no IDAT at all)\n    for n in 0usize..6 {\n        let mut spec = PngSpec::new(3, 2, 2, rng.bytes(n));\n        spec.idat_pieces = 1;\n        cases.push(spec.build());\n    }\n    // the same total split over several chunks\n    for n in 1usize..6 {\n        let mut spec = PngSpec::new(3, 2, 2, rng.bytes(n));\n        spec.idat_pieces = n;\n        cases.push(spec.build());\n    }\n    // several empty IDATs\n    for k in 1usize..4 {\n        let mut spec = PngSpec::new(3, 2, 2, Vec::new());\n        for _ in 0..k {\n            spec.pre_chunks.push(chunk(b\"IDAT\", &[]));\n        }\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"E23\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n#[test]\nfn e24_e25_e26_zlib_header_bytes() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 24);\n    let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n    let d = deflate_fixed_literals(&raw);\n    let mut cases: Vec<(u8, u8, Option<&'static str>)> = Vec::new();\n    for cmf in 0u16..=255 {\n        let expected = if (cmf & 0x0f) != 0x08 {\n            Some(\"only zlib compression method (RFC 1950) is supported\")\n        } else if (cmf & 0xf0) > 0x70 {\n            Some(\"innapropriate window size detected\")\n        } else {\n            None\n        };\n        cases.push((cmf as u8, 0x9C, expected));\n    }\n    for flg in 0u16..=255 {\n        let expected = if (flg & 0x20) != 0 {\n            Some(\"preset dictionary is present and not supported\")\n        } else {\n            None\n        };\n        cases.push((0x78, flg as u8, expected));\n    }\n    expect_all_pass(\"E24/E25/E26\", cases.len(), |i| {\n        let (cmf, flg, expected) = cases[i];\n        let png = PngSpec::new(3, 2, 2, zlib(&d, cmf, flg)).build();\n        match expected {\n            Some(reason) => p\n                .png_expect_err(&png, png.len() as i32, reason)\n                .map_err(|e| format!(\"[cmf={cmf:#04x} flg={flg:#04x}] {e}\")),\n            None => p\n                .png(&png, png.len() as i32)\n                .map_err(|e| format!(\"[cmf={cmf:#04x} flg={flg:#04x}] {e}\")),\n        }\n    });\n}\n\n// ===========================================================================\n// E27 / E28 — proved unreachable\n// ===========================================================================\n\n/// `cp_out_size(img, n) == w * h * n` with `w, h >= 1` (E16/E17) and\n/// `w * h * 4 < INT_MAX` (E18), so `cp_out_size` is always `>= 1` for every\n/// `bpp` the five accepted colour types produce (1, 2, 3, 4). This test proves\n/// the \"invalid image size found\" string is never reachable by driving every\n/// `(w, h, colour type)` that survives the earlier checks at the boundary.\n#[test]\nfn e27_e28_invalid_image_size_is_unreachable() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 27);\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for (wf, h) in [\n            (0u32, 1u32),\n            (0, 0x7FFF_FFFF),\n            (0x7FFF_FFFE, 1),\n            (536_870_909, 1),\n            (0x0000_7FFD, 0x0000_8000),\n            (1, 1),\n        ] {\n            let mut spec = PngSpec::new(wf, h, ct, rng.bytes(4));\n            spec.width = wf;\n            spec.height = h;\n            cases.push(spec.build());\n        }\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let png = &cases[i];\n        let q = common::diff::probe_png(&p.c, png, png.len() as i32);\n        if q.err.as_deref() == Some(\"invalid image size found\") {\n            return Err(format!(\n                \"E27/E28 was reached after all: {q:?} for png={}\",\n                common::diff::hexdump(png)\n            ));\n        }\n        p.png(png, png.len() as i32)\n    });\n    expect_no_mismatch(\"E27/E28\", &out);\n}\n\n// ===========================================================================\n// E29 — cp_inflate failure seen from load_png_mem\n// ===========================================================================\n\n#[test]\nfn e29_deflate_algorithm_failed_overwrites_the_inner_reason() {\n    let p = Pair::new();\n    let reason = \"DEFLATE algorithm failed\";\n    let mut rng = Rng::new(SEED ^ 29);\n    let mut cases = Vec::new();\n    // btype 3 straight after the zlib header\n    {\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(3, 2);\n        let d = bw.finish();\n        let mut spec = PngSpec::new(3, 2, 2, zlib_default(&d));\n        spec.idat_pieces = 1;\n        cases.push(spec.build());\n    }\n    // far too much output for the buffer\n    {\n        let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n        let mut big = raw.clone();\n        big.extend(rng.bytes(4096));\n        let mut spec = PngSpec::new(3, 2, 2, zlib_default(&deflate_fixed_literals(&big)));\n        spec.idat_pieces = 2;\n        cases.push(spec.build());\n    }\n    // a stored block that is not the last thing in the stream\n    {\n        let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n        let mut d = deflate_stored(&raw);\n        d.push(0);\n        cases.push(PngSpec::new(3, 2, 2, zlib_default(&d)).build());\n    }\n    // a back-reference reaching before the output buffer\n    {\n        let mut bw = BitWriter::new();\n        fixed_block(&mut bw, true, &[Tok::Match { len: 3, dist: 5 }]);\n        let d = bw.finish();\n        cases.push(PngSpec::new(3, 2, 2, zlib_default(&d)).build());\n    }\n    expect_all_pass(\"E29\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n// ===========================================================================\n// E31 — indexed colour without a palette\n// ===========================================================================\n\n#[test]\nfn e31_indexed_without_plte() {\n    let p = Pair::new();\n    let reason = \"color type of indexed requires a PLTE chunk\";\n    let mut rng = Rng::new(SEED ^ 31);\n    let mut cases = Vec::new();\n    for &(w, h) in &[(1usize, 1usize), (3, 2), (16, 5)] {\n        for extra in [\n            vec![],\n            vec![chunk(b\"tRNS\", &rng.bytes(16))],\n            vec![chunk(b\"PLTe\", &rng.bytes(768))],\n            vec![chunk(b\"plte\", &rng.bytes(768))],\n        ] {\n            let raw = raw_image(&mut rng, w, h, 1, &[0]);\n            let mut spec = PngSpec::new(\n                w as u32,\n                h as u32,\n                3,\n                zlib_default(&deflate_fixed_literals(&raw)),\n            );\n            spec.pre_chunks = extra;\n            cases.push(spec.build());\n        }\n    }\n    // ... and a PLTE that appears only *after* the IDATs, where cp_find never\n    // looks for it\n    {\n        let raw = raw_image(&mut rng, 4, 2, 1, &[0]);\n        let mut spec =\n            PngSpec::new(4, 2, 3, zlib_default(&deflate_fixed_literals(&raw)));\n        spec.post_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"E31\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n// ===========================================================================\n// G1 / G5..G10 / G13 / G14 — FFI-boundary arguments\n// ===========================================================================\n\n#[test]\nfn g1_null_png_data() {\n    let p = Pair::new();\n    for len in [0i32, 1, 8, 64, -1] {\n        p.same_fate_png(std::ptr::null(), len, &format!(\"load_png_mem(NULL, {len})\"))\n            .unwrap();\n    }\n}\n\n#[test]\nfn g5_g6_g7_g8_g10_cp_inflate_degenerate_sizes() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 0x56);\n    let good = deflate_fixed_literals(&rng.bytes(8));\n    let mut cases: Vec<(Vec<u8>, i32, i32, usize)> = Vec::new();\n    for input in [Vec::new(), vec![0u8], vec![0xFFu8; 4], good.clone()] {\n        for &in_bytes in &[0i32, 1, 2, 3, 4, -1, -2, -7, i32::MIN, input.len() as i32] {\n            for &out_bytes in &[0i32, 1, 8, -1, -8, i32::MIN] {\n                for ia in 0..2usize {\n                    cases.push((input.clone(), in_bytes, out_bytes, ia));\n                }\n            }\n        }\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (input, in_bytes, out_bytes, ia) = &cases[i];\n        p.inflate(input, *in_bytes, *out_bytes, *ia, 0)\n    });\n    expect_no_mismatch(\"G5-G10\", &out);\n}\n\n#[test]\nfn g10_null_in_and_out_pointers() {\n    let p = Pair::new();\n    // in == NULL with in_bytes == 0: first_bytes is 0 and no word is ever read,\n    // so nothing is dereferenced. out == NULL with out_bytes == 0 makes\n    // out_end == out == begin, so the first literal is rejected by E3.\n    let mut cases: Vec<(bool, bool, i32, i32)> = Vec::new();\n    for &in_null in &[true, false] {\n        for &out_null in &[true, false] {\n            for &(ib, ob) in &[(0i32, 0i32), (0, 8), (4, 0)] {\n                cases.push((in_null, out_null, ib, ob));\n            }\n        }\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (in_null, out_null, ib, ob) = cases[i];\n        let inbuf = AlignedBuf::from_slice(&[0x78u8, 0x9C, 0x01, 0x00], 0);\n        let outbuf = AlignedBuf::new(64, 0);\n        outbuf.fill(0x33);\n        let ip = if in_null {\n            std::ptr::null_mut()\n        } else {\n            inbuf.ptr as *mut std::ffi::c_void\n        };\n        let op = if out_null {\n            std::ptr::null_mut()\n        } else {\n            outbuf.ptr as *mut std::ffi::c_void\n        };\n        let a = common::diff::probe_inflate_raw(&p.c, ip, ib, op, ob);\n        let b = common::diff::probe_inflate_raw(&p.r, ip, ib, op, ob);\n        if a == b {\n            Ok(())\n        } else {\n            Err(format!(\n                \"cp_inflate(in_null={in_null} out_null={out_null} {ib} {ob}): {a:?} vs {b:?}\"\n            ))\n        }\n    });\n    expect_no_mismatch(\"G10\", &out);\n}\n\n#[test]\nfn g13_every_block_type() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 0x13);\n    let mut cases = Vec::new();\n    for btype in 0u32..4 {\n        for bfinal in 0u32..2 {\n            for ia in 0..4usize {\n                cases.push((btype, bfinal, ia, rng.bytes(24)));\n            }\n        }\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (btype, bfinal, ia, tail) = &cases[i];\n        let mut bw = BitWriter::new();\n        bw.bits(*bfinal, 1);\n        bw.bits(*btype, 2);\n        let mut s = bw.finish();\n        s.extend_from_slice(tail);\n        p.inflate(&s, s.len() as i32, 40, *ia, 0)\n    });\n    expect_no_mismatch(\"G13\", &out);\n}\n\n#[test]\nfn g14_tables_mutated_to_out_of_range_values() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 0x14);\n    let raw = raw_image(&mut rng, 6, 3, 3, &[0, 1, 2]);\n    let png =\n        PngSpec::new(6, 3, 2, zlib_default(&deflate_fixed_lz(&raw))).build();\n    let stream = deflate_dynamic_lz(&raw, true);\n    let mut cases = Vec::new();\n    for _ in 0..200 {\n        cases.push((\n            rng.below(6) as usize,\n            rng.bytes(320),\n            (0..31).map(|_| rng.next_u32()).collect::<Vec<u32>>(),\n            (0..32).map(|_| rng.next_u32()).collect::<Vec<u32>>(),\n            rng.bool(),\n        ));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (which, bytes, lb, db, use_png) = &cases[i];\n        for l in [&p.c, &p.r] {\n            unsafe {\n                match which {\n                    // wholly out-of-range values, including code lengths >= 16\n                    // and permutation indices >= 19\n                    0 => std::ptr::copy_nonoverlapping(bytes.as_ptr(), l.cp_fixed_table, 320),\n                    1 => std::ptr::copy_nonoverlapping(bytes.as_ptr(), l.cp_permutation_order, 19),\n                    2 => std::ptr::copy_nonoverlapping(bytes.as_ptr(), l.cp_len_extra_bits, 31),\n                    3 => std::ptr::copy_nonoverlapping(lb.as_ptr(), l.cp_len_base, 31),\n                    4 => std::ptr::copy_nonoverlapping(bytes.as_ptr(), l.cp_dist_extra_bits, 32),\n                    _ => std::ptr::copy_nonoverlapping(db.as_ptr(), l.cp_dist_base, 32),\n                }\n            }\n        }\n        let r = if *use_png {\n            p.png(&png, png.len() as i32)\n        } else {\n            p.inflate(&stream, stream.len() as i32, raw.len() as i32 + 64, i % 4, 0)\n        };\n        p.reset();\n        r\n    });\n    p.reset();\n    expect_no_mismatch(\"G14\", &out);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4401,"cache_read_input_tokens":293039,"cache_creation":{"ephemeral_5m_input_tokens":4401,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ca950163-4526-4c83-bcdb-90a4f8c566ab","uuid":"e42f674d-183a-4492-9b6b-bc6ed07063ab","timestamp":"2026-08-27T13:39:04.638Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EhneuDidZtvz7bRvEv39Qr","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/errors.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ca950163-4526-4c83-bcdb-90a4f8c566ab","uuid":"6b7ccfe1-a04d-480e-af29-4607943d100c","timestamp":"2026-08-27T13:39:04.651Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/errors.rs","content":"//! Phase C — error-path differential tests, one per row of `ERRORS.md`.\n//!\n//! Each test constructs the exact invalid input the C checks for, then requires\n//! that\n//!   * the C actually produces *that* rejection (the exact `cp_error_reason`\n//!     string, so the test cannot silently drift onto a different branch), and\n//!   * the Rust produces the same sentinel, the same string, the same\n//!     `img.w`/`img.h`, and the same output bytes.\n\nmod common;\n\nuse common::diff::Pair;\nuse common::mk::*;\nuse common::*;\n\nconst SEED: u64 = 0xE770_0000_1234_5678;\n\n// ===========================================================================\n// E1 / E2 — cp_stored\n// ===========================================================================\n\n#[test]\nfn e1_stored_len_nlen_not_complements() {\n    let p = Pair::new();\n    let reason = \"Failed to find LEN and NLEN as complements within \\\n                  stored (uncompressed) stream.\";\n    let mut rng = Rng::new(SEED ^ 1);\n    let mut cases = Vec::new();\n    for n in [0u16, 1, 3, 8, 64] {\n        for bad in [0u16, 0xFFFF, 1, 0x1234] {\n            if bad == !n {\n                continue;\n            }\n            cases.push((n, bad, rng.below(4) as usize));\n        }\n    }\n    expect_all_pass(\"E1\", cases.len(), |i| {\n        let (n, nlen, ia) = cases[i];\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(0, 2);\n        bw.align();\n        bw.bits(n as u32, 16);\n        bw.bits(nlen as u32, 16); // deliberately not ~LEN\n        bw.raw(&vec![0xEE; n as usize]);\n        let s = bw.finish();\n        p.inflate_expect_err(&s, s.len() as i32, n as i32 + 8, ia, reason)\n    });\n}\n\n#[test]\nfn e2_stored_block_extends_beyond_input() {\n    let p = Pair::new();\n    let reason = \"Stored block extends beyond end of input stream.\";\n    let mut cases = Vec::new();\n    for n in [0usize, 1, 3, 16, 100] {\n        for extra in [1usize, 2, 3, 4, 9] {\n            for ia in 0..4 {\n                cases.push((n, extra, ia));\n            }\n        }\n    }\n    expect_all_pass(\"E2\", cases.len(), |i| {\n        let (n, extra, ia) = cases[i];\n        // A stored block is only accepted when it is the last thing in the\n        // stream: `s->bits_left / 8 <= LEN`. Any trailing byte breaks that.\n        let mut s = deflate_stored(&vec![0x5C; n]);\n        s.extend(std::iter::repeat_n(0xAAu8, extra));\n        p.inflate_expect_err(&s, s.len() as i32, n as i32 + 16, ia, reason)\n    });\n}\n\n#[test]\nfn e2b_non_final_stored_block() {\n    let p = Pair::new();\n    let reason = \"Stored block extends beyond end of input stream.\";\n    expect_all_pass(\"E2b\", 8, |i| {\n        // bfinal = 0 on a stored block: another block must follow, so the\n        // `bits_left / 8 <= LEN` test necessarily fails.\n        let mut bw = BitWriter::new();\n        stored_block(&mut bw, false, &vec![0x11; i * 3]);\n        fixed_block(&mut bw, true, &[Tok::Lit(1)]);\n        let s = bw.finish();\n        p.inflate_expect_err(&s, s.len() as i32, 64, i % 4, reason)\n    });\n}\n\n// ===========================================================================\n// E3 / E4 / E5 — cp_block\n// ===========================================================================\n\n#[test]\nfn e3_literal_overruns_the_output_buffer() {\n    let p = Pair::new();\n    let reason = \"Attempted to overwrite out buffer while outputting a symbol.\";\n    let mut rng = Rng::new(SEED ^ 3);\n    let mut cases = Vec::new();\n    for out_bytes in [0i32, 1, 2, 5, 17] {\n        for extra in [1usize, 2, 9] {\n            for ia in 0..4 {\n                let n = out_bytes.max(0) as usize + extra;\n                cases.push((rng.bytes(n), out_bytes, ia));\n            }\n        }\n    }\n    expect_all_pass(\"E3\", cases.len(), |i| {\n        let (data, out_bytes, ia) = &cases[i];\n        for s in [\n            deflate_fixed_literals(data),\n            deflate_dynamic_literals(data, false),\n            deflate_dynamic_literals(data, true),\n        ] {\n            p.inflate_expect_err(&s, s.len() as i32, *out_bytes, *ia, reason)?;\n        }\n        Ok(())\n    });\n}\n\n#[test]\nfn e4_back_reference_before_the_output_buffer() {\n    let p = Pair::new();\n    let reason = \"Attempted to write before out buffer (invalid backwards distance).\";\n    let mut cases = Vec::new();\n    for produced in [0usize, 1, 2, 7] {\n        for dist in [1u16, 2, 3, 17, 258, 32768] {\n            if (dist as usize) <= produced {\n                continue;\n            }\n            for ia in 0..4 {\n                cases.push((produced, dist, ia));\n            }\n        }\n    }\n    expect_all_pass(\"E4\", cases.len(), |i| {\n        let (produced, dist, ia) = cases[i];\n        let seed: Vec<u8> = (0..produced).map(|k| 0x40 | k as u8).collect();\n        let mut toks: Vec<Tok> = seed.iter().map(|&b| Tok::Lit(b)).collect();\n        toks.push(Tok::Match { len: 3, dist });\n        let mut bw = BitWriter::new();\n        fixed_block(&mut bw, true, &toks);\n        let s = bw.finish();\n        p.inflate_expect_err(&s, s.len() as i32, 1 << 16, ia, reason)\n    });\n}\n\n#[test]\nfn e5_back_reference_overruns_the_output_buffer() {\n    let p = Pair::new();\n    let reason = \"Attempted to overwrite out buffer while outputting a string.\";\n    let mut cases = Vec::new();\n    for len in [3u16, 4, 17, 100, 258] {\n        for slack in [0i32, 1, 2] {\n            for ia in 0..4 {\n                cases.push((len, slack, ia));\n            }\n        }\n    }\n    expect_all_pass(\"E5\", cases.len(), |i| {\n        let (len, slack, ia) = cases[i];\n        let seed = [0x77u8, 0x88];\n        let mut toks: Vec<Tok> = seed.iter().map(|&b| Tok::Lit(b)).collect();\n        toks.push(Tok::Match { len, dist: 2 });\n        let mut bw = BitWriter::new();\n        fixed_block(&mut bw, true, &toks);\n        let s = bw.finish();\n        // room for the two literals plus `slack` of the `len` copied bytes\n        let out_bytes = seed.len() as i32 + slack;\n        p.inflate_expect_err(&s, s.len() as i32, out_bytes, ia, reason)\n    });\n}\n\n// ===========================================================================\n// E6 / E7 — cp_inflate block dispatch\n// ===========================================================================\n\n#[test]\nfn e6_unknown_block_type() {\n    let p = Pair::new();\n    let reason = \"Detected unknown block type within input stream.\";\n    let mut rng = Rng::new(SEED ^ 6);\n    let mut cases = Vec::new();\n    for bfinal in [0u32, 1] {\n        for ia in 0..4 {\n            for pad in 0..4usize {\n                cases.push((bfinal, ia, rng.bytes(pad)));\n            }\n        }\n    }\n    expect_all_pass(\"E6\", cases.len(), |i| {\n        let (bfinal, ia, pad) = &cases[i];\n        let mut bw = BitWriter::new();\n        bw.bits(*bfinal, 1);\n        bw.bits(3, 2); // btype == 3\n        let mut s = bw.finish();\n        s.extend_from_slice(pad);\n        p.inflate_expect_err(&s, s.len() as i32, 32, *ia, reason)\n    });\n}\n\n#[test]\nfn e6b_unknown_block_type_after_a_good_block() {\n    let p = Pair::new();\n    let reason = \"Detected unknown block type within input stream.\";\n    expect_all_pass(\"E6b\", 8, |i| {\n        let mut bw = BitWriter::new();\n        fixed_block(&mut bw, false, &[Tok::Lit(1), Tok::Lit(2)]);\n        bw.bits(1, 1);\n        bw.bits(3, 2);\n        let s = bw.finish();\n        p.inflate_expect_err(&s, s.len() as i32, 32, i % 4, reason)\n    });\n}\n\n#[test]\nfn e7_inner_failure_propagates_out_of_a_multi_block_stream() {\n    let p = Pair::new();\n    expect_all_pass(\"E7\", 12, |i| {\n        // block 1 is fine, block 2 overruns the output => the *inner* reason is\n        // what cp_inflate leaves behind (load_png_mem later overwrites it).\n        let mut bw = BitWriter::new();\n        fixed_block(&mut bw, false, &[Tok::Lit(0xA1), Tok::Lit(0xA2)]);\n        fixed_block(&mut bw, true, &vec![Tok::Lit(0xB0); 8]);\n        let s = bw.finish();\n        p.inflate_expect_err(\n            &s,\n            s.len() as i32,\n            4,\n            i % 4,\n            \"Attempted to overwrite out buffer while outputting a symbol.\",\n        )\n    });\n}\n\n// ===========================================================================\n// E8 / E9 / E13 — cp_chunk and cp_find returning NULL\n// ===========================================================================\n\nfn tiny_raw(rng: &mut Rng, w: usize, h: usize, bpp: usize) -> Vec<u8> {\n    raw_image(rng, w, h, bpp, &[0])\n}\n\n#[test]\nfn e8_e13_ihdr_chunk_not_found() {\n    let p = Pair::new();\n    let reason = \"unable to find IHDR chunk\";\n    let mut rng = Rng::new(SEED ^ 8);\n    let raw = tiny_raw(&mut rng, 2, 2, 3);\n    let ihdr_payload = {\n        let mut v = Vec::new();\n        v.extend_from_slice(&2u32.to_be_bytes());\n        v.extend_from_slice(&2u32.to_be_bytes());\n        v.extend_from_slice(&[8, 2, 0, 0, 0]);\n        v\n    };\n    let idat = chunk(b\"IDAT\", &zlib_default(&deflate_fixed_literals(&raw)));\n\n    let mut cases: Vec<(String, Vec<u8>, i32)> = Vec::new();\n    let mut add = |name: &str, body: Vec<u8>, len: Option<i32>| {\n        let n = len.unwrap_or(body.len() as i32);\n        cases.push((name.to_string(), body, n));\n    };\n\n    // E8a: the first chunk is not an IHDR\n    for kind in [b\"iHDR\", b\"IHDr\", b\"PLTE\", b\"IDAT\", b\"\\0\\0\\0\\0\"] {\n        let mut v = SIG.to_vec();\n        v.extend_from_slice(&chunk(kind, &ihdr_payload));\n        v.extend_from_slice(&idat);\n        add(\"E8a wrong type\", v, None);\n    }\n    // E8b: IHDR shorter than minlen 13\n    for l in 0u32..13 {\n        let mut v = SIG.to_vec();\n        v.extend_from_slice(&chunk(b\"IHDR\", &ihdr_payload[..l.min(13) as usize]));\n        v.extend_from_slice(&idat);\n        add(\"E8b len<13\", v, None);\n    }\n    // E8c: declared length runs past png.end\n    for declared in [13u32, 14, 100, 0x7FFF_FFFF, 0x8000_0000, 0xFFFF_FFF3] {\n        let mut v = SIG.to_vec();\n        v.extend_from_slice(&chunk_raw_len(b\"IHDR\", declared, &ihdr_payload));\n        let n = v.len() as i32;\n        if declared != 13 {\n            add(\"E8c overruns end\", v, Some(n));\n        }\n    }\n    // ... and a correctly-declared IHDR whose file is truncated\n    for cut in 1..=12usize {\n        let mut v = SIG.to_vec();\n        v.extend_from_slice(&chunk(b\"IHDR\", &ihdr_payload));\n        let n = v.len() as i32 - cut as i32;\n        add(\"E8c truncated\", v, Some(n));\n    }\n    // nothing but the signature\n    add(\"only signature\", SIG.to_vec(), None);\n\n    expect_all_pass(\"E8/E13\", cases.len(), |i| {\n        let (name, body, len) = &cases[i];\n        p.png_expect_err(body, *len, reason)\n            .map_err(|e| format!(\"[{name}] {e}\"))\n    });\n}\n\n#[test]\nfn e9_cp_find_walks_off_the_end() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 9);\n    // No IDAT at all => cp_find returns NULL => datalen 0 => E23.\n    let raw = tiny_raw(&mut rng, 3, 2, 3);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let mut cases = Vec::new();\n    for filler in [\n        vec![],\n        vec![chunk(b\"tEXt\", b\"x\")],\n        vec![chunk(b\"IDAt\", &z)],\n        vec![chunk(b\"tEXt\", b\"x\"), chunk(b\"gAMA\", &[1, 2, 3, 4])],\n        // a chunk whose declared length runs past the end: cp_find advances p\n        // past png.end and stops\n        vec![chunk_raw_len(b\"tEXt\", 10_000, b\"short\")],\n    ] {\n        let mut spec = PngSpec::new(3, 2, 2, Vec::new());\n        spec.pre_chunks = filler;\n        spec.idat = Vec::new();\n        let mut v = spec.build();\n        // strip the (empty) IDAT that PngSpec always emits\n        v = {\n            let empty = chunk(b\"IDAT\", &[]);\n            let pos = v\n                .windows(empty.len())\n                .position(|w| w == empty.as_slice())\n                .unwrap();\n            let mut out = v[..pos].to_vec();\n            out.extend_from_slice(&v[pos + empty.len()..]);\n            out\n        };\n        cases.push(v);\n    }\n    expect_all_pass(\"E9\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, \"corrupt zlib structure in DEFLATE stream\")\n    });\n}\n\n/// `cp_find` advances with `png->p += len + 12` in **`uint32_t`** arithmetic, so\n/// a declared chunk length of `0xFFFFFFF4` makes `len + 12` wrap to 0 and the\n/// pointer never moves: the C loops for ever. The translation reproduces the\n/// same wrap and hangs identically -- which is what this test asserts.\n#[test]\nfn e9b_chunk_length_that_wraps_the_cp_find_stride_hangs_both() {\n    let p = Pair::new();\n    let mut v = SIG.to_vec();\n    {\n        let mut ihdr = Vec::new();\n        ihdr.extend_from_slice(&2u32.to_be_bytes());\n        ihdr.extend_from_slice(&2u32.to_be_bytes());\n        ihdr.extend_from_slice(&[8, 2, 0, 0, 0]);\n        v.extend_from_slice(&chunk(b\"IHDR\", &ihdr));\n    }\n    // type is not PLTE/tRNS/IDAT, so cp_find keeps looking -- for ever\n    v.extend_from_slice(&chunk_raw_len(b\"tEXt\", 0xFFFF_FFF4, b\"\"));\n    v.extend_from_slice(&chunk(b\"IEND\", &[]));\n\n    let fate = |l: &Lib| {\n        let o = run_isolated(1, |_| {\n            let buf = AlignedBuf::from_slice(&v, 0);\n            let q = common::diff::probe_png_raw(l, buf.ptr, v.len() as i32);\n            Err(format!(\"{q:?}\"))\n        });\n        o.into_iter().next().unwrap()\n    };\n    let c = fate(&p.c);\n    let r = fate(&p.r);\n    assert_eq!(c, CaseOutcome::Killed(14), \"expected the C to hang: {c:?}\");\n    assert_eq!(r, CaseOutcome::Killed(14), \"the Rust must hang too: {r:?}\");\n    // and the same for the reference (assert-enabled) build\n    assert_eq!(fate(&p.ca), CaseOutcome::Killed(14));\n}\n\n// ===========================================================================\n// E10 / E11 / E30 / G12 — cp_unfilter\n// ===========================================================================\n\n#[test]\nfn e10_e30_invalid_filter_byte_on_row_zero() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 10);\n    let reason = \"invalid filter byte found\";\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for f in 5u16..=255 {\n            let bpp = bpp_of(ct);\n            let (w, h) = (3usize, 2usize);\n            let mut raw = raw_image(&mut rng, w, h, bpp, &[0]);\n            raw[0] = f as u8;\n            let mut spec =\n                PngSpec::new(w as u32, h as u32, ct, zlib_default(&deflate_fixed_literals(&raw)));\n            if ct == 3 {\n                spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n            }\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"E10/E30\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n#[test]\nfn e11_invalid_filter_byte_on_a_later_row() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 11);\n    let reason = \"invalid filter byte found\";\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for f in [5u8, 6, 7, 100, 128, 200, 254, 255] {\n            for row in 1..4usize {\n                let bpp = bpp_of(ct);\n                let (w, h) = (4usize, 4usize);\n                let stride = w * bpp + 1;\n                let mut raw = raw_image(&mut rng, w, h, bpp, &[0, 1, 2, 3]);\n                raw[row * stride] = f;\n                let mut spec = PngSpec::new(\n                    w as u32,\n                    h as u32,\n                    ct,\n                    zlib_default(&deflate_fixed_literals(&raw)),\n                );\n                if ct == 3 {\n                    spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                }\n                cases.push(spec.build());\n            }\n        }\n    }\n    expect_all_pass(\"E11\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n/// `h > 0` guards row 0's filter switch, so the *first* filter byte of a\n/// one-row image is the only one examined; `h == 1` never reaches the second\n/// loop. Both edges, all 256 filter values.\n#[test]\nfn g12_every_filter_byte_value() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 0x12);\n    let mut cases = Vec::new();\n    for f in 0u16..=255 {\n        for &(w, h) in &[(1usize, 1usize), (4, 1), (4, 3)] {\n            let mut raw = raw_image(&mut rng, w, h, 3, &[0]);\n            raw[0] = f as u8;\n            cases.push(\n                PngSpec::new(w as u32, h as u32, 2, zlib_default(&deflate_fixed_literals(&raw)))\n                    .build(),\n            );\n        }\n    }\n    expect_all_pass(\"G12\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n// ===========================================================================\n// E12 — signature\n// ===========================================================================\n\n#[test]\nfn e12_bad_signature() {\n    let p = Pair::new();\n    let reason = \"incorrect file signature (is this a png file?)\";\n    let mut rng = Rng::new(SEED ^ 12);\n    let mut cases: Vec<(Vec<u8>, i32)> = Vec::new();\n    // every single-byte corruption of the signature\n    for k in 0..8usize {\n        for delta in [1u8, 0x80, 0xFF] {\n            let mut v = SIG.to_vec();\n            v[k] ^= delta;\n            v.extend_from_slice(&rng.bytes(40));\n            let n = v.len() as i32;\n            cases.push((v, n));\n        }\n    }\n    // shorter than the signature (the C memcmp's 8 bytes regardless)\n    for n in 0..8i32 {\n        let mut v = SIG.to_vec();\n        v[7] ^= 1; // make sure it really is wrong\n        v.extend_from_slice(&rng.bytes(20));\n        cases.push((v, n));\n    }\n    cases.push((Vec::new(), 0));\n    cases.push((b\"not a png\".to_vec(), 9));\n    cases.push((vec![0u8; 64], 64));\n    cases.push((vec![0xFFu8; 64], 64));\n    expect_all_pass(\"E12\", cases.len(), |i| {\n        let (v, n) = &cases[i];\n        p.png_expect_err(v, *n, reason)\n    });\n}\n\n/// G2/G3/G4: a *correct* signature with a length that stops short of, or runs\n/// past, the buffer. The C never looks at `png_length` before the `memcmp`.\n#[test]\nfn g2_g3_g4_png_length_edges() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 0x24);\n    let raw = tiny_raw(&mut rng, 3, 2, 3);\n    let good = PngSpec::new(3, 2, 2, zlib_default(&deflate_fixed_literals(&raw))).build();\n    let mut cases: Vec<(Vec<u8>, i32)> = Vec::new();\n    for n in [\n        0i32,\n        1,\n        7,\n        8,\n        9,\n        12,\n        20,\n        24,\n        25,\n        26,\n        good.len() as i32 - 1,\n        good.len() as i32,\n        good.len() as i32 + 1,\n        good.len() as i32 + 1000,\n        -1,\n        -2,\n        -1000,\n        i32::MIN,\n        i32::MAX,\n    ] {\n        cases.push((good.clone(), n));\n    }\n    // only the signature, with every plausible length\n    for n in -4..12i32 {\n        cases.push((SIG.to_vec(), n));\n    }\n    expect_all_pass(\"G2/G3/G4\", cases.len(), |i| {\n        let (v, n) = &cases[i];\n        p.png(v, *n)\n    });\n}\n\n// ===========================================================================\n// E14 / E15 / E20 / E21 / E22 / G11 — every IHDR option byte, all 256 values\n// ===========================================================================\n\nfn ihdr_option_sweep(label: &str, field: usize, expect: &dyn Fn(u8) -> Option<&'static str>) {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ (0x100 + field as u64));\n    let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let plte = chunk(b\"PLTE\", &rng.bytes(768));\n    let mut cases = Vec::new();\n    for v in 0u16..=255 {\n        let mut spec = PngSpec::new(3, 2, 2, z.clone());\n        // field 0 = bit_depth, 1 = colour_type, 2 = compression,\n        // 3 = filter, 4 = interlace\n        match field {\n            0 => spec.bit_depth = v as u8,\n            1 => spec.color_type = v as u8,\n            2 => spec.compression = v as u8,\n            3 => spec.filter = v as u8,\n            _ => spec.interlace = v as u8,\n        }\n        spec.pre_chunks.push(plte.clone());\n        cases.push((v as u8, spec.build()));\n    }\n    expect_all_pass(label, cases.len(), |i| {\n        let (v, body) = &cases[i];\n        match expect(*v) {\n            Some(reason) => p\n                .png_expect_err(body, body.len() as i32, reason)\n                .map_err(|e| format!(\"[field {field} = {v}] {e}\")),\n            None => p\n                .png(body, body.len() as i32)\n                .map_err(|e| format!(\"[field {field} = {v}] {e}\")),\n        }\n    });\n}\n\n#[test]\nfn e14_g11_every_bit_depth() {\n    ihdr_option_sweep(\"E14\", 0, &|v| {\n        if v == 8 {\n            None\n        } else {\n            Some(\"only bit-depth of 8 is supported\")\n        }\n    });\n}\n\n#[test]\nfn e15_g11_every_colour_type() {\n    // The raw stream in the sweep is sized for bpp 3; other colour types decode\n    // a differently sized image, which is a *valid* configuration -- it just may\n    // read uninitialised heap, which `Pair::png` detects and skips.\n    ihdr_option_sweep(\"E15\", 1, &|v| {\n        if matches!(v, 0 | 2 | 3 | 4 | 6) {\n            None\n        } else {\n            Some(\"unknown color type\")\n        }\n    });\n}\n\n#[test]\nfn e20_g11_every_compression_byte() {\n    ihdr_option_sweep(\"E20\", 2, &|v| {\n        if v == 0 {\n            None\n        } else {\n            Some(\"only standard compression DEFLATE is supported\")\n        }\n    });\n}\n\n#[test]\nfn e21_g11_every_filter_method_byte() {\n    ihdr_option_sweep(\"E21\", 3, &|v| {\n        if v == 0 {\n            None\n        } else {\n            Some(\"only standard adaptive filtering is supported\")\n        }\n    });\n}\n\n#[test]\nfn e22_g11_every_interlace_byte() {\n    ihdr_option_sweep(\"E22\", 4, &|v| {\n        if v == 0 {\n            None\n        } else {\n            Some(\"interlacing is not supported\")\n        }\n    });\n}\n\n// ===========================================================================\n// E16 / E17 / E18 — width, height, size cap\n// ===========================================================================\n\n#[test]\nfn e16_width_less_than_one() {\n    let p = Pair::new();\n    let reason = \"invalid IHDR chunk found, image width was less than 1\";\n    let mut rng = Rng::new(SEED ^ 16);\n    let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    // w = cp_make32(ihdr) + 1 as int, so the rejected field values are those\n    // giving w == 0 (0xFFFFFFFF) or w < 0 (0x7FFFFFFF ..= 0xFFFFFFFE).\n    let mut cases = Vec::new();\n    for width in [\n        0x7FFF_FFFFu32,\n        0x8000_0000,\n        0x8000_0001,\n        0xC000_0000,\n        0xFFFF_FFFE,\n        0xFFFF_FFFF,\n    ] {\n        let mut spec = PngSpec::new(width, 2, 2, z.clone());\n        spec.width = width;\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"E16\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n#[test]\nfn e17_height_less_than_one() {\n    let p = Pair::new();\n    let reason = \"invalid IHDR chunk found, image height was less than 1\";\n    let mut rng = Rng::new(SEED ^ 17);\n    let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let mut cases = Vec::new();\n    for height in [\n        0u32,\n        0x8000_0000,\n        0x8000_0001,\n        0xC000_0000,\n        0xFFFF_FFFF,\n        0xFFFF_FFFE,\n    ] {\n        let mut spec = PngSpec::new(3, height, 2, z.clone());\n        spec.height = height;\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"E17\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n#[test]\nfn e18_image_too_large() {\n    let p = Pair::new();\n    let reason = \"image too large\";\n    let mut rng = Rng::new(SEED ^ 18);\n    let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    // (int64)w * h * 4 must be < INT_MAX, and the `sizeof` makes the comparison\n    // unsigned. w is the IHDR field + 1.\n    let mut cases = Vec::new();\n    for (wf, h) in [\n        (0x7FFF_FFFEu32, 1u32),        // w = INT_MAX      -> 4*INT_MAX\n        (0x7FFF_FFFEu32, 2),\n        (0x0000_7FFF, 0x0000_8000),    // 32768 * 32768 * 4 == 2^32\n        (0x0000_7FFF, 0x0001_0000),\n        (0x0001_FFFF, 0x0000_2000),\n        (536_870_911, 1),              // w = 2^29 -> 4*2^29 == 2^31 > INT_MAX\n        (0x0000_FFFF, 0x0000_2000),\n        (1, 0x2000_0000),\n    ] {\n        let mut spec = PngSpec::new(wf, h, 2, z.clone());\n        spec.width = wf;\n        spec.height = h;\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"E18\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n/// The largest size E18 lets through, i.e. right at the boundary. Whether the\n/// following `malloc` succeeds is up to the allocator (row E19); either way the\n/// two libraries must agree.\n#[test]\nfn e18b_e19_largest_accepted_size() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 19);\n    let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let mut cases = Vec::new();\n    for (wf, h) in [\n        (536_870_910u32, 1u32), // w = 2^29-1 -> 4*(2^29-1) < INT_MAX\n        (0x0000_7FFE, 0x0000_8000),\n        (23_000, 23_000),\n    ] {\n        let mut spec = PngSpec::new(wf, h, 2, z.clone());\n        spec.width = wf;\n        spec.height = h;\n        cases.push(spec.build());\n    }\n    // Under fork isolation: a ~2 GiB malloc can legitimately fail, and either\n    // outcome must be the same in both libraries.\n    let out = run_isolated(cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n    expect_no_mismatch(\"E18b/E19\", &out);\n}\n\n// ===========================================================================\n// E23 / E24 / E25 / E26 — the zlib header\n// ===========================================================================\n\n#[test]\nfn e23_corrupt_zlib_structure() {\n    let p = Pair::new();\n    let reason = \"corrupt zlib structure in DEFLATE stream\";\n    let mut rng = Rng::new(SEED ^ 23);\n    let mut cases = Vec::new();\n    // datalen 0..5 (and no IDAT at all)\n    for n in 0usize..6 {\n        let mut spec = PngSpec::new(3, 2, 2, rng.bytes(n));\n        spec.idat_pieces = 1;\n        cases.push(spec.build());\n    }\n    // the same total split over several chunks\n    for n in 1usize..6 {\n        let mut spec = PngSpec::new(3, 2, 2, rng.bytes(n));\n        spec.idat_pieces = n;\n        cases.push(spec.build());\n    }\n    // several empty IDATs\n    for k in 1usize..4 {\n        let mut spec = PngSpec::new(3, 2, 2, Vec::new());\n        for _ in 0..k {\n            spec.pre_chunks.push(chunk(b\"IDAT\", &[]));\n        }\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"E23\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n#[test]\nfn e24_e25_e26_zlib_header_bytes() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 24);\n    let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n    let d = deflate_fixed_literals(&raw);\n    let mut cases: Vec<(u8, u8, Option<&'static str>)> = Vec::new();\n    for cmf in 0u16..=255 {\n        let expected = if (cmf & 0x0f) != 0x08 {\n            Some(\"only zlib compression method (RFC 1950) is supported\")\n        } else if (cmf & 0xf0) > 0x70 {\n            Some(\"innapropriate window size detected\")\n        } else {\n            None\n        };\n        cases.push((cmf as u8, 0x9C, expected));\n    }\n    for flg in 0u16..=255 {\n        let expected = if (flg & 0x20) != 0 {\n            Some(\"preset dictionary is present and not supported\")\n        } else {\n            None\n        };\n        cases.push((0x78, flg as u8, expected));\n    }\n    expect_all_pass(\"E24/E25/E26\", cases.len(), |i| {\n        let (cmf, flg, expected) = cases[i];\n        let png = PngSpec::new(3, 2, 2, zlib(&d, cmf, flg)).build();\n        match expected {\n            Some(reason) => p\n                .png_expect_err(&png, png.len() as i32, reason)\n                .map_err(|e| format!(\"[cmf={cmf:#04x} flg={flg:#04x}] {e}\")),\n            None => p\n                .png(&png, png.len() as i32)\n                .map_err(|e| format!(\"[cmf={cmf:#04x} flg={flg:#04x}] {e}\")),\n        }\n    });\n}\n\n// ===========================================================================\n// E27 / E28 — proved unreachable\n// ===========================================================================\n\n/// `cp_out_size(img, n) == w * h * n` with `w, h >= 1` (E16/E17) and\n/// `w * h * 4 < INT_MAX` (E18), so `cp_out_size` is always `>= 1` for every\n/// `bpp` the five accepted colour types produce (1, 2, 3, 4). This test proves\n/// the \"invalid image size found\" string is never reachable by driving every\n/// `(w, h, colour type)` that survives the earlier checks at the boundary.\n#[test]\nfn e27_e28_invalid_image_size_is_unreachable() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 27);\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for (wf, h) in [\n            (0u32, 1u32),\n            (0, 0x7FFF_FFFF),\n            (0x7FFF_FFFE, 1),\n            (536_870_909, 1),\n            (0x0000_7FFD, 0x0000_8000),\n            (1, 1),\n        ] {\n            let mut spec = PngSpec::new(wf, h, ct, rng.bytes(4));\n            spec.width = wf;\n            spec.height = h;\n            cases.push(spec.build());\n        }\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let png = &cases[i];\n        let q = common::diff::probe_png(&p.c, png, png.len() as i32);\n        if q.err.as_deref() == Some(\"invalid image size found\") {\n            return Err(format!(\n                \"E27/E28 was reached after all: {q:?} for png={}\",\n                common::diff::hexdump(png)\n            ));\n        }\n        p.png(png, png.len() as i32)\n    });\n    expect_no_mismatch(\"E27/E28\", &out);\n}\n\n// ===========================================================================\n// E29 — cp_inflate failure seen from load_png_mem\n// ===========================================================================\n\n#[test]\nfn e29_deflate_algorithm_failed_overwrites_the_inner_reason() {\n    let p = Pair::new();\n    let reason = \"DEFLATE algorithm failed\";\n    let mut rng = Rng::new(SEED ^ 29);\n    let mut cases = Vec::new();\n    // btype 3 straight after the zlib header\n    {\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(3, 2);\n        let d = bw.finish();\n        let mut spec = PngSpec::new(3, 2, 2, zlib_default(&d));\n        spec.idat_pieces = 1;\n        cases.push(spec.build());\n    }\n    // far too much output for the buffer\n    {\n        let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n        let mut big = raw.clone();\n        big.extend(rng.bytes(4096));\n        let mut spec = PngSpec::new(3, 2, 2, zlib_default(&deflate_fixed_literals(&big)));\n        spec.idat_pieces = 2;\n        cases.push(spec.build());\n    }\n    // a stored block that is not the last thing in the stream\n    {\n        let raw = raw_image(&mut rng, 3, 2, 3, &[0]);\n        let mut d = deflate_stored(&raw);\n        d.push(0);\n        cases.push(PngSpec::new(3, 2, 2, zlib_default(&d)).build());\n    }\n    // a back-reference reaching before the output buffer\n    {\n        let mut bw = BitWriter::new();\n        fixed_block(&mut bw, true, &[Tok::Match { len: 3, dist: 5 }]);\n        let d = bw.finish();\n        cases.push(PngSpec::new(3, 2, 2, zlib_default(&d)).build());\n    }\n    expect_all_pass(\"E29\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n// ===========================================================================\n// E31 — indexed colour without a palette\n// ===========================================================================\n\n#[test]\nfn e31_indexed_without_plte() {\n    let p = Pair::new();\n    let reason = \"color type of indexed requires a PLTE chunk\";\n    let mut rng = Rng::new(SEED ^ 31);\n    let mut cases = Vec::new();\n    for &(w, h) in &[(1usize, 1usize), (3, 2), (16, 5)] {\n        for extra in [\n            vec![],\n            vec![chunk(b\"tRNS\", &rng.bytes(16))],\n            vec![chunk(b\"PLTe\", &rng.bytes(768))],\n            vec![chunk(b\"plte\", &rng.bytes(768))],\n        ] {\n            let raw = raw_image(&mut rng, w, h, 1, &[0]);\n            let mut spec = PngSpec::new(\n                w as u32,\n                h as u32,\n                3,\n                zlib_default(&deflate_fixed_literals(&raw)),\n            );\n            spec.pre_chunks = extra;\n            cases.push(spec.build());\n        }\n    }\n    // ... and a PLTE that appears only *after* the IDATs, where cp_find never\n    // looks for it\n    {\n        let raw = raw_image(&mut rng, 4, 2, 1, &[0]);\n        let mut spec =\n            PngSpec::new(4, 2, 3, zlib_default(&deflate_fixed_literals(&raw)));\n        spec.post_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"E31\", cases.len(), |i| {\n        p.png_expect_err(&cases[i], cases[i].len() as i32, reason)\n    });\n}\n\n// ===========================================================================\n// G1 / G5..G10 / G13 / G14 — FFI-boundary arguments\n// ===========================================================================\n\n#[test]\nfn g1_null_png_data() {\n    let p = Pair::new();\n    for len in [0i32, 1, 8, 64, -1] {\n        p.same_fate_png(std::ptr::null(), len, &format!(\"load_png_mem(NULL, {len})\"))\n            .unwrap();\n    }\n}\n\n#[test]\nfn g5_g6_g7_g8_g10_cp_inflate_degenerate_sizes() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 0x56);\n    let good = deflate_fixed_literals(&rng.bytes(8));\n    let mut cases: Vec<(Vec<u8>, i32, i32, usize)> = Vec::new();\n    for input in [Vec::new(), vec![0u8], vec![0xFFu8; 4], good.clone()] {\n        for &in_bytes in &[0i32, 1, 2, 3, 4, -1, -2, -7, i32::MIN, input.len() as i32] {\n            for &out_bytes in &[0i32, 1, 8, -1, -8, i32::MIN] {\n                for ia in 0..2usize {\n                    cases.push((input.clone(), in_bytes, out_bytes, ia));\n                }\n            }\n        }\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (input, in_bytes, out_bytes, ia) = &cases[i];\n        p.inflate(input, *in_bytes, *out_bytes, *ia, 0)\n    });\n    expect_no_mismatch(\"G5-G10\", &out);\n}\n\n#[test]\nfn g10_null_in_and_out_pointers() {\n    let p = Pair::new();\n    // in == NULL with in_bytes == 0: first_bytes is 0 and no word is ever read,\n    // so nothing is dereferenced. out == NULL with out_bytes == 0 makes\n    // out_end == out == begin, so the first literal is rejected by E3.\n    let mut cases: Vec<(bool, bool, i32, i32)> = Vec::new();\n    for &in_null in &[true, false] {\n        for &out_null in &[true, false] {\n            for &(ib, ob) in &[(0i32, 0i32), (0, 8), (4, 0)] {\n                cases.push((in_null, out_null, ib, ob));\n            }\n        }\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (in_null, out_null, ib, ob) = cases[i];\n        let inbuf = AlignedBuf::from_slice(&[0x78u8, 0x9C, 0x01, 0x00], 0);\n        let outbuf = AlignedBuf::new(64, 0);\n        outbuf.fill(0x33);\n        let ip = if in_null {\n            std::ptr::null_mut()\n        } else {\n            inbuf.ptr as *mut std::ffi::c_void\n        };\n        let op = if out_null {\n            std::ptr::null_mut()\n        } else {\n            outbuf.ptr as *mut std::ffi::c_void\n        };\n        let a = common::diff::probe_inflate_raw(&p.c, ip, ib, op, ob);\n        let b = common::diff::probe_inflate_raw(&p.r, ip, ib, op, ob);\n        if a == b {\n            Ok(())\n        } else {\n            Err(format!(\n                \"cp_inflate(in_null={in_null} out_null={out_null} {ib} {ob}): {a:?} vs {b:?}\"\n            ))\n        }\n    });\n    expect_no_mismatch(\"G10\", &out);\n}\n\n#[test]\nfn g13_every_block_type() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 0x13);\n    let mut cases = Vec::new();\n    for btype in 0u32..4 {\n        for bfinal in 0u32..2 {\n            for ia in 0..4usize {\n                cases.push((btype, bfinal, ia, rng.bytes(24)));\n            }\n        }\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (btype, bfinal, ia, tail) = &cases[i];\n        let mut bw = BitWriter::new();\n        bw.bits(*bfinal, 1);\n        bw.bits(*btype, 2);\n        let mut s = bw.finish();\n        s.extend_from_slice(tail);\n        p.inflate(&s, s.len() as i32, 40, *ia, 0)\n    });\n    expect_no_mismatch(\"G13\", &out);\n}\n\n#[test]\nfn g14_tables_mutated_to_out_of_range_values() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 0x14);\n    let raw = raw_image(&mut rng, 6, 3, 3, &[0, 1, 2]);\n    let png =\n        PngSpec::new(6, 3, 2, zlib_default(&deflate_fixed_lz(&raw))).build();\n    let stream = deflate_dynamic_lz(&raw, true);\n    let mut cases = Vec::new();\n    for _ in 0..200 {\n        cases.push((\n            rng.below(6) as usize,\n            rng.bytes(320),\n            (0..31).map(|_| rng.next_u32()).collect::<Vec<u32>>(),\n            (0..32).map(|_| rng.next_u32()).collect::<Vec<u32>>(),\n            rng.bool(),\n        ));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (which, bytes, lb, db, use_png) = &cases[i];\n        for l in [&p.c, &p.r] {\n            unsafe {\n                match which {\n                    // wholly out-of-range values, including code lengths >= 16\n                    // and permutation indices >= 19\n                    0 => std::ptr::copy_nonoverlapping(bytes.as_ptr(), l.cp_fixed_table, 320),\n                    1 => std::ptr::copy_nonoverlapping(bytes.as_ptr(), l.cp_permutation_order, 19),\n                    2 => std::ptr::copy_nonoverlapping(bytes.as_ptr(), l.cp_len_extra_bits, 31),\n                    3 => std::ptr::copy_nonoverlapping(lb.as_ptr(), l.cp_len_base, 31),\n                    4 => std::ptr::copy_nonoverlapping(bytes.as_ptr(), l.cp_dist_extra_bits, 32),\n                    _ => std::ptr::copy_nonoverlapping(db.as_ptr(), l.cp_dist_base, 32),\n                }\n            }\n        }\n        let r = if *use_png {\n            p.png(&png, png.len() as i32)\n        } else {\n            p.inflate(&stream, stream.len() as i32, raw.len() as i32 + 64, i % 4, 0)\n        };\n        p.reset();\n        r\n    });\n    p.reset();\n    expect_no_mismatch(\"G14\", &out);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
