{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_tuzjvwqyzlt5wnvz4gzjy3c24ot7ehikkf4j4vc3zcklsw2paowa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01WrVS9UBsZnCs28Mi4JfJ5K","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/symbols.rs","content":"//! Phase D — symbol parity.\n//!\n//! Every symbol the C `.so` exports must also be exported by the Rust `.so`,\n//! with the same name, the same section class and (for objects) the same size.\n//! The diff must be *empty* in both directions.\n\nmod common;\n\nuse common::*;\nuse std::path::PathBuf;\nuse std::process::Command;\n\nfn cbuild(stem: &str) -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(format!(\"tests/cbuild/{stem}.so\"))\n}\n\nfn rust_cdylib() -> PathBuf {\n    let exe = std::env::current_exe().unwrap();\n    let mut dir = exe.parent().unwrap().to_path_buf();\n    if dir.file_name() == Some(std::ffi::OsStr::new(\"deps\")) {\n        dir.pop();\n    }\n    for c in [\n        dir.join(\"libload_png_mem_lib.so\"),\n        PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"target/release/libload_png_mem_lib.so\"),\n        PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"target/debug/libload_png_mem_lib.so\"),\n    ] {\n        if c.exists() {\n            return c;\n        }\n    }\n    panic!(\"Rust cdylib not found; run ./build_diff.sh\");\n}\n\n/// `(name, kind, size)` for every dynamic, defined symbol.\nfn dynamic_defined(path: &PathBuf) -> Vec<(String, char, u64)> {\n    let out = Command::new(\"nm\")\n        .args([\"-D\", \"-S\", \"--defined-only\"])\n        .arg(path)\n        .output()\n        .expect(\"nm not available\");\n    assert!(\n        out.status.success(),\n        \"nm failed on {}: {}\",\n        path.display(),\n        String::from_utf8_lossy(&out.stderr)\n    );\n    let text = String::from_utf8_lossy(&out.stdout);\n    let mut v: Vec<(String, char, u64)> = Vec::new();\n    for line in text.lines() {\n        let f: Vec<&str> = line.split_whitespace().collect();\n        // \"<addr> <size> <kind> <name>\"  or  \"<addr> <kind> <name>\"\n        match f.len() {\n            4 => {\n                let size = u64::from_str_radix(f[1], 16).unwrap_or(0);\n                v.push((f[3].to_string(), f[2].chars().next().unwrap(), size));\n            }\n            3 => v.push((f[2].to_string(), f[1].chars().next().unwrap(), 0)),\n            _ => {}\n        }\n    }\n    v.sort();\n    v\n}\n\nfn undefined(path: &PathBuf) -> Vec<String> {\n    let out = Command::new(\"nm\")\n        .args([\"-D\", \"--undefined-only\"])\n        .arg(path)\n        .output()\n        .expect(\"nm\");\n    String::from_utf8_lossy(&out.stdout)\n        .lines()\n        .filter_map(|l| l.split_whitespace().last().map(|s| s.to_string()))\n        .filter(|s| !s.is_empty())\n        .collect()\n}\n\n#[test]\nfn rust_exports_every_c_symbol() {\n    let c = dynamic_defined(&cbuild(\"libc_assert\"));\n    let r = dynamic_defined(&rust_cdylib());\n    assert!(!c.is_empty(), \"nm found no exports in the C library\");\n\n    let cnames: Vec<&String> = c.iter().map(|(n, _, _)| n).collect();\n    let rnames: Vec<&String> = r.iter().map(|(n, _, _)| n).collect();\n\n    let missing: Vec<&&String> = cnames.iter().filter(|n| !rnames.contains(n)).collect();\n    assert!(\n        missing.is_empty(),\n        \"symbols exported by the C .so but MISSING from the Rust .so: {missing:?}\\n\\\n         the Rust .so exports: {rnames:?}\"\n    );\n\n    // ...and nothing extra either, so the ABI surface is exactly the same.\n    let extra: Vec<&&String> = rnames.iter().filter(|n| !cnames.contains(n)).collect();\n    assert!(\n        extra.is_empty(),\n        \"symbols the Rust .so exports that the C .so does not: {extra:?}\"\n    );\n\n    // section class and object size must line up too\n    for (name, kind, size) in &c {\n        let (_, rkind, rsize) = r.iter().find(|(n, _, _)| n == name).unwrap();\n        assert_eq!(\n            kind, rkind,\n            \"{name}: C is section class {kind}, Rust is {rkind}\"\n        );\n        if *kind != 'T' && *kind != 't' {\n            assert_eq!(size, rsize, \"{name}: C size {size:#x}, Rust size {rsize:#x}\");\n        }\n    }\n    eprintln!(\"symbol diff is empty; {} exports:\", c.len());\n    for (n, k, s) in &c {\n        eprintln!(\"  {k} {n} (size {s:#x})\");\n    }\n}\n\n/// `SYMBOLS.md` must list exactly the symbols that actually exist -- otherwise\n/// the artifact silently rots.\n#[test]\nfn symbols_md_matches_reality() {\n    let md = std::fs::read_to_string(\n        PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"SYMBOLS.md\"),\n    )\n    .expect(\"SYMBOLS.md\");\n    for (name, _, _) in dynamic_defined(&cbuild(\"libc_assert\")) {\n        assert!(\n            md.contains(&format!(\"`{name}`\")),\n            \"SYMBOLS.md does not mention `{name}`\"\n        );\n    }\n    // the private C helpers must be listed too, so a whole skipped module would\n    // be visible\n    let cstatics = [\n        \"cp_make_pixel_a\", \"cp_make_pixel\", \"cp_would_overflow\", \"cp_ptr\",\n        \"cp_peak_bits\", \"cp_consume_bits\", \"cp_read_bits\", \"cp_rev16\", \"cp_build\",\n        \"cp_stored\", \"cp_fixed\", \"cp_decode\", \"cp_dynamic\", \"cp_block\", \"cp_paeth\",\n        \"cp_make32\", \"cp_chunk\", \"cp_find\", \"cp_unfilter\", \"cp_convert\",\n        \"cp_get_alpha_for_indexed_image\", \"cp_depalette\",\n        \"cp_get_chunk_byte_length\", \"cp_out_size\",\n    ];\n    for f in cstatics {\n        assert!(\n            md.contains(&format!(\"`{f}`\")),\n            \"SYMBOLS.md does not mention the C helper `{f}`\"\n        );\n    }\n}\n\n/// Everything the Rust `.so` imports must be resolvable: `dlopen` with\n/// `RTLD_NOW` fails outright on an unresolved symbol, which is a stronger check\n/// than reading `nm` output.\n#[test]\nfn rust_so_has_no_unresolved_imports() {\n    let u = undefined(&rust_cdylib());\n    let allowed_prefixes = [\n        \"_ITM_\", \"__cxa_\", \"__gmon_\", \"_Unwind_\", \"__tls_get_addr\", \"__errno_location\",\n        \"gettid\", \"statx\",\n    ];\n    let libc_ish: Vec<&String> = u\n        .iter()\n        .filter(|s| {\n            !allowed_prefixes.iter().any(|p| s.starts_with(p)) && !s.contains(\"@GLIBC\")\n        })\n        .collect();\n    assert!(\n        libc_ish.is_empty(),\n        \"unresolved non-libc imports in the Rust .so: {libc_ish:?}\"\n    );\n    // and prove it by loading with RTLD_NOW\n    unsafe extern \"C\" {\n        fn dlopen(f: *const std::ffi::c_char, flag: std::ffi::c_int) -> *mut std::ffi::c_void;\n        fn dlerror() -> *const std::ffi::c_char;\n        fn dlclose(h: *mut std::ffi::c_void) -> std::ffi::c_int;\n    }\n    const RTLD_NOW: std::ffi::c_int = 2;\n    let path = std::ffi::CString::new(rust_cdylib().to_str().unwrap()).unwrap();\n    unsafe {\n        let h = dlopen(path.as_ptr(), RTLD_NOW);\n        if h.is_null() {\n            let e = dlerror();\n            panic!(\n                \"dlopen(RTLD_NOW) failed: {}\",\n                std::ffi::CStr::from_ptr(e).to_string_lossy()\n            );\n        }\n        dlclose(h);\n    }\n}\n\n/// The exported data symbols must be writable and must actually be the storage\n/// the decoder reads -- a `#[no_mangle]` static that the implementation ignores\n/// would be a lie that `nm` cannot detect.\n#[test]\nfn exported_tables_are_the_storage_the_decoder_reads() {\n    let c = c_lib();\n    let r = rust_lib();\n    let mut rng = Rng::new(7);\n    let raw = common::mk::raw_image(&mut rng, 8, 4, 3, &[0, 1, 2, 3]);\n    let png = common::mk::PngSpec::new(\n        8,\n        4,\n        2,\n        common::mk::zlib_default(&common::mk::deflate_fixed_lz(&raw)),\n    )\n    .build();\n\n    for l in [&c, &r] {\n        l.reset_tables();\n        let before = common::diff::probe_png(l, &png, png.len() as i32);\n        assert!(!before.null, \"{}: baseline decode failed\", l.name);\n        let mut changed = 0;\n        for (name, poke) in [\n            (\"cp_fixed_table\", 0usize),\n            (\"cp_permutation_order\", 1),\n            (\"cp_len_extra_bits\", 2),\n            (\"cp_len_base\", 3),\n            (\"cp_dist_extra_bits\", 4),\n            (\"cp_dist_base\", 5),\n        ] {\n            l.reset_tables();\n            unsafe {\n                match poke {\n                    0 => *l.cp_fixed_table.add(3) = 9,\n                    1 => *l.cp_permutation_order.add(0) = 3,\n                    2 => *l.cp_len_extra_bits.add(0) = 4,\n                    3 => *l.cp_len_base.add(0) = 9,\n                    4 => *l.cp_dist_extra_bits.add(0) = 4,\n                    _ => *l.cp_dist_base.add(0) = 9,\n                }\n            }\n            let after = common::diff::probe_png(l, &png, png.len() as i32);\n            if after != before {\n                changed += 1;\n            } else {\n                eprintln!(\"  {}: writing {name} changed nothing\", l.name);\n            }\n            l.reset_tables();\n        }\n        assert!(\n            changed >= 4,\n            \"{}: only {changed}/6 exported tables affected the decode; \\\n             at least one is not the storage the implementation uses\",\n            l.name\n        );\n    }\n}\n\n/// There are no Cargo features, so \"every feature combination\" is one\n/// combination. This test fails if a feature is ever added without extending the\n/// Phase B/C runs to cover it.\n#[test]\nfn crate_has_no_feature_flags() {\n    let toml = std::fs::read_to_string(\n        PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"Cargo.toml\"),\n    )\n    .unwrap();\n    let has_features = toml\n        .lines()\n        .any(|l| l.trim() == \"[features]\" || l.trim().starts_with(\"[features.\"));\n    assert!(\n        !has_features,\n        \"Cargo.toml now declares [features]; run the whole suite for every \\\n         combination (see run_all.sh) and update this test\"\n    );\n    // ... and no `#[cfg(feature = ...)]` in the library either\n    let src = std::fs::read_to_string(\n        PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"src/lib.rs\"),\n    )\n    .unwrap();\n    assert!(\n        !src.contains(\"cfg(feature\"),\n        \"src/lib.rs is feature-gated but Cargo.toml declares no features\"\n    );\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":948,"cache_read_input_tokens":394936,"cache_creation":{"ephemeral_5m_input_tokens":948,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ca950163-4526-4c83-bcdb-90a4f8c566ab","uuid":"9fe28315-589c-4df2-a5d6-e0ad3e2bb082","timestamp":"2026-08-27T14:18:08.055Z"}
