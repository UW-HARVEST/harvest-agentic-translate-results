.len());\n            v.extend_from_slice(&chunk(b\"IDAT\", &self.idat[off..end]));\n            off = end;\n            n += 1;\n            if n < pieces {\n                for c in &self.interleave {\n                    v.extend_from_slice(c);\n                }\n            }\n            if off >= self.idat.len() {\n                break;\n            }\n        }\n        if self.idat.is_empty() {\n            // `pieces` loop above already emitted one empty IDAT\n        }\n        for c in &self.post_chunks {\n            v.extend_from_slice(c);\n        }\n        if self.iend {\n            v.extend_from_slice(&chunk(b\"IEND\", &[]));\n        }\n        v\n    }\n}\n\n/// Bytes per pixel the C derives from a colour type (0 for invalid ones).\npub fn bpp_of(color_type: u8) -> usize {\n    match color_type {\n        0 => 1,\n        2 => 3,\n        3 => 1,\n        4 => 2,\n        6 => 4,\n        _ => 0,\n    }\n}\n\n/// A raw (filtered) image stream: one filter byte plus `w * bpp` bytes per row.\n/// `filters` supplies the per-row filter byte.\npub fn raw_image(rng: &mut Rng, w: usize, h: usize, bpp: usize, filters: &[u8]) -> Vec<u8> {\n    let mut v = Vec::with_capacity((w * bpp + 1) * h);\n    for y in 0..h {\n        v.push(filters[y % filters.len().max(1)]);\n        for _ in 0..w * bpp {\n            v.push(rng.byte());\n        }\n    }\n    v\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
