{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_drj2ab2s4bh7m2w4gjrry4ha6x3fnymggkvf6da3tr5y6i5beoxq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_019hDYV2AnmCouF9ZLXQC79a","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/valid_png.rs","content":"//! Phase B — valid-path differential tests for `load_png_mem`.\n//! Rows C25..C51 of `CONFIGS.md`.\n//!\n//! The whole pipeline runs end to end: chunk walking, IDAT concatenation, zlib\n//! header validation, DEFLATE, `cp_unfilter`, then `cp_convert` or\n//! `cp_depalette`. Every case compares `img.w`, `img.h`, `img.pix == NULL`,\n//! `cp_error_reason` and all `w*h` output pixels.\n\nmod common;\n\nuse common::diff::Pair;\nuse common::mk::*;\nuse common::*;\n\nconst SEED: u64 = 0xC0FFEE_1234_5678;\n\n/// The five deflate encodings a raw image stream can be wrapped in.\n#[derive(Copy, Clone, Debug)]\nenum Enc {\n    Stored,\n    Fixed,\n    FixedLz,\n    Dynamic,\n    DynamicRuns,\n    DynamicLz,\n}\n\nfn encode(raw: &[u8], e: Enc) -> Vec<u8> {\n    match e {\n        Enc::Stored => deflate_stored(raw),\n        Enc::Fixed => deflate_fixed_literals(raw),\n        Enc::FixedLz => deflate_fixed_lz(raw),\n        Enc::Dynamic => deflate_dynamic_literals(raw, false),\n        Enc::DynamicRuns => deflate_dynamic_literals(raw, true),\n        Enc::DynamicLz => deflate_dynamic_lz(raw, true),\n    }\n}\n\nconst ENCS: [Enc; 6] = [\n    Enc::Stored,\n    Enc::Fixed,\n    Enc::FixedLz,\n    Enc::Dynamic,\n    Enc::DynamicRuns,\n    Enc::DynamicLz,\n];\n\n/// A complete PNG for `w * h` with the given colour type and per-row filters.\nfn make_png(\n    rng: &mut Rng,\n    w: usize,\n    h: usize,\n    color_type: u8,\n    filters: &[u8],\n    e: Enc,\n    pieces: usize,\n) -> Vec<u8> {\n    let bpp = bpp_of(color_type);\n    let raw = raw_image(rng, w, h, bpp, filters);\n    let mut spec = PngSpec::new(w as u32, h as u32, color_type, zlib_default(&encode(&raw, e)));\n    spec.idat_pieces = pieces;\n    if color_type == 3 {\n        spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n    }\n    spec.build()\n}\n\nconst SIZES: [(usize, usize); 20] = [\n    (1, 1), (1, 2), (1, 3), (1, 7),\n    (2, 1), (2, 2), (2, 3), (2, 7),\n    (3, 1), (3, 2), (3, 3), (3, 7),\n    (5, 1), (5, 2), (5, 3), (5, 7),\n    (16, 1), (16, 2), (16, 3), (16, 7),\n];\n\n// ---------------------------------------------------------------------------\n// C25..C28, C35, C36 — the size grid for each non-indexed colour type\n// ---------------------------------------------------------------------------\n\nfn size_grid_test(label: &str, color_type: u8, seed: u64) {\n    let p = Pair::new();\n    let mut rng = Rng::new(seed);\n    let mut cases = Vec::new();\n    for &(w, h) in &SIZES {\n        for e in ENCS {\n            cases.push(make_png(&mut rng, w, h, color_type, &[0], e, 1));\n        }\n    }\n    expect_all_pass(label, cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c25_colour_type_0_grey() {\n    size_grid_test(\"C25\", 0, SEED ^ 25);\n}\n\n#[test]\nfn c26_colour_type_2_rgb() {\n    size_grid_test(\"C26\", 2, SEED ^ 26);\n}\n\n#[test]\nfn c27_colour_type_4_grey_alpha() {\n    size_grid_test(\"C27\", 4, SEED ^ 27);\n}\n\n#[test]\nfn c28_colour_type_6_rgba() {\n    size_grid_test(\"C28\", 6, SEED ^ 28);\n}\n\n// ---------------------------------------------------------------------------\n// C29..C31 — indexed images\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c29_indexed_without_trns() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 29);\n    let mut cases = Vec::new();\n    for &(w, h) in &SIZES {\n        for e in [Enc::Stored, Enc::Fixed, Enc::Dynamic, Enc::DynamicRuns] {\n            cases.push(make_png(&mut rng, w, h, 3, &[0], e, 1));\n        }\n    }\n    expect_all_pass(\"C29\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c30_indexed_with_trns_of_every_length() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 30);\n    let mut cases = Vec::new();\n    for trns_len in [0usize, 1, 2, 17, 128, 255, 256, 300, 768] {\n        for &(w, h) in &[(1usize, 1usize), (3, 2), (5, 3), (16, 7), (64, 5)] {\n            for e in [Enc::Fixed, Enc::DynamicRuns] {\n                let raw = raw_image(&mut rng, w, h, 1, &[0]);\n                let mut spec =\n                    PngSpec::new(w as u32, h as u32, 3, zlib_default(&encode(&raw, e)));\n                spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                spec.pre_chunks.push(chunk(b\"tRNS\", &rng.bytes(trns_len)));\n                cases.push(spec.build());\n            }\n        }\n    }\n    expect_all_pass(\"C30\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c31_indexed_with_short_palette_reads_past_the_chunk() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 31);\n    // `cp_depalette` indexes `plte[c*3 .. c*3+2]` with no bound on `c`, so a\n    // short PLTE makes the C read the bytes that follow it in the file.\n    let mut cases = Vec::new();\n    for plte_len in [0usize, 3, 6, 33, 96, 255, 384] {\n        for &(w, h) in &[(4usize, 2usize), (16, 3)] {\n            let raw = raw_image(&mut rng, w, h, 1, &[0]);\n            let mut spec = PngSpec::new(\n                w as u32,\n                h as u32,\n                3,\n                zlib_default(&deflate_fixed_literals(&raw)),\n            );\n            spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(plte_len)));\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C31\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C32..C34 — the filter code, which differs between row 0 and rows >= 1\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c32_every_filter_on_row_zero() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 32);\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for f0 in 0u8..=4 {\n            for &(w, h) in &[(1usize, 1usize), (2, 1), (3, 1), (5, 1), (9, 2), (16, 4)] {\n                let bpp = bpp_of(ct);\n                let mut raw = raw_image(&mut rng, w, h, bpp, &[0]);\n                raw[0] = f0; // row 0's filter byte\n                let mut spec =\n                    PngSpec::new(w as u32, h as u32, ct, zlib_default(&deflate_fixed_literals(&raw)));\n                if ct == 3 {\n                    spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                }\n                cases.push(spec.build());\n            }\n        }\n    }\n    expect_all_pass(\"C32\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c33_every_filter_on_later_rows() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 33);\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for f in 0u8..=4 {\n            for &(w, h) in &[(1usize, 2usize), (2, 2), (3, 3), (5, 4), (16, 5)] {\n                let bpp = bpp_of(ct);\n                let stride = w * bpp + 1;\n                let mut raw = raw_image(&mut rng, w, h, bpp, &[0]);\n                for y in 1..h {\n                    raw[y * stride] = f;\n                }\n                let mut spec =\n                    PngSpec::new(w as u32, h as u32, ct, zlib_default(&deflate_fixed_literals(&raw)));\n                if ct == 3 {\n                    spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                }\n                cases.push(spec.build());\n            }\n        }\n    }\n    expect_all_pass(\"C33\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c34_randomised_mixed_filters() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 34);\n    let mut cases = Vec::new();\n    for _ in 0..400 {\n        let ct = [0u8, 2, 3, 4, 6][rng.below(5) as usize];\n        let bpp = bpp_of(ct);\n        let w = 1 + rng.below(20) as usize;\n        let h = 1 + rng.below(9) as usize;\n        let filters: Vec<u8> = (0..h).map(|_| rng.byte() % 5).collect();\n        let raw = raw_image(&mut rng, w, h, bpp, &filters);\n        let e = ENCS[rng.below(6) as usize];\n        let mut spec = PngSpec::new(w as u32, h as u32, ct, zlib_default(&encode(&raw, e)));\n        spec.idat_pieces = 1 + rng.below(4) as usize;\n        if ct == 3 {\n            spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n            if rng.bool() {\n                let n = rng.below(300) as usize;\n                spec.pre_chunks.push(chunk(b\"tRNS\", &rng.bytes(n)));\n            }\n        }\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"C34\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c35_c36_width_one_and_height_one() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 35);\n    // w == 1 makes `len == bpp`, so each filter's second loop is empty;\n    // h == 1 skips the `for y in 1..h` loop entirely.\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for f in 0u8..=4 {\n            for &(w, h) in &[(1usize, 1usize), (1, 2), (1, 5), (2, 1), (7, 1), (64, 1)] {\n                let bpp = bpp_of(ct);\n                let raw = raw_image(&mut rng, w, h, bpp, &[f]);\n                let mut spec =\n                    PngSpec::new(w as u32, h as u32, ct, zlib_default(&deflate_fixed_literals(&raw)));\n                if ct == 3 {\n                    spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                }\n                cases.push(spec.build());\n            }\n        }\n    }\n    expect_all_pass(\"C35/C36\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C37..C43, C47, C48 — the chunk walker\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c37_idat_split_over_many_chunks() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 37);\n    let mut cases = Vec::new();\n    for pieces in [1usize, 2, 3, 5, 8, 17, 64] {\n        for ct in [0u8, 2, 4, 6] {\n            let bpp = bpp_of(ct);\n            let (w, h) = (16usize, 5usize);\n            let raw = raw_image(&mut rng, w, h, bpp, &[0, 1, 2, 3, 4]);\n            let mut spec = PngSpec::new(\n                w as u32,\n                h as u32,\n                ct,\n                zlib_default(&deflate_fixed_literals(&raw)),\n            );\n            spec.idat_pieces = pieces;\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C37\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c38_empty_idat_chunks() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 38);\n    let (w, h) = (8usize, 3usize);\n    let raw = raw_image(&mut rng, w, h, 3, &[0, 1, 2]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let empty = chunk(b\"IDAT\", &[]);\n    let mut cases = Vec::new();\n    for place in 0..3 {\n        let mut spec = PngSpec::new(w as u32, h as u32, 2, z.clone());\n        spec.idat_pieces = 3;\n        match place {\n            0 => spec.pre_chunks.push(empty.clone()),\n            1 => spec.interleave.push(empty.clone()),\n            _ => spec.post_chunks.push(empty.clone()),\n        }\n        cases.push(spec.build());\n    }\n    // two empty IDATs in a row, and an all-empty file\n    let mut spec = PngSpec::new(w as u32, h as u32, 2, z.clone());\n    spec.pre_chunks.push(empty.clone());\n    spec.pre_chunks.push(empty.clone());\n    cases.push(spec.build());\n    expect_all_pass(\"C38\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c39_ancillary_chunk_between_idats_breaks_the_chain() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 39);\n    // The C finds the first IDAT with `cp_find` and then walks with `cp_chunk`,\n    // which requires the *next* chunk to be an IDAT too. A chunk in between\n    // therefore truncates the DEFLATE stream.\n    let (w, h) = (8usize, 3usize);\n    let raw = raw_image(&mut rng, w, h, 3, &[0, 1, 2]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let mut cases = Vec::new();\n    for filler in [\n        chunk(b\"tEXt\", b\"hello\"),\n        chunk(b\"gAMA\", &[0, 1, 2, 3]),\n        chunk(b\"IDAt\", b\"x\"),\n        chunk(b\"idat\", b\"x\"),\n        chunk(b\"iDAT\", &[]),\n    ] {\n        for pieces in [2usize, 3, 5] {\n            let mut spec = PngSpec::new(w as u32, h as u32, 2, z.clone());\n            spec.idat_pieces = pieces;\n            spec.interleave.push(filler.clone());\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C39\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c40_ancillary_chunks_around_the_palette() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 40);\n    let (w, h) = (6usize, 3usize);\n    let raw = raw_image(&mut rng, w, h, 1, &[0, 2, 4]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let plte = chunk(b\"PLTE\", &rng.bytes(768));\n    let trns = chunk(b\"tRNS\", &rng.bytes(200));\n    let junk = chunk(b\"tEXt\", b\"a comment\");\n    let mut cases = Vec::new();\n    for order in 0..6 {\n        let mut spec = PngSpec::new(w as u32, h as u32, 3, z.clone());\n        spec.pre_chunks = match order {\n            0 => vec![plte.clone(), trns.clone()],\n            1 => vec![junk.clone(), plte.clone(), trns.clone()],\n            2 => vec![plte.clone(), junk.clone(), trns.clone()],\n            3 => vec![plte.clone(), trns.clone(), junk.clone()],\n            4 => vec![junk.clone(), plte.clone(), junk.clone(), trns.clone(), junk.clone()],\n            _ => vec![trns.clone(), plte.clone()], // C42: tRNS first\n        };\n        spec.post_chunks.push(junk.clone());\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"C40/C42\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c41_palette_chunks_present_for_non_indexed_types() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 41);\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 4, 6] {\n        for which in 0..3 {\n            let bpp = bpp_of(ct);\n            let (w, h) = (5usize, 3usize);\n            let raw = raw_image(&mut rng, w, h, bpp, &[0, 1, 3]);\n            let mut spec = PngSpec::new(\n                w as u32,\n                h as u32,\n                ct,\n                zlib_default(&deflate_fixed_literals(&raw)),\n            );\n            if which != 1 {\n                spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n            }\n            if which != 0 {\n                spec.pre_chunks.push(chunk(b\"tRNS\", &rng.bytes(64)));\n            }\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C41\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c43_ihdr_longer_than_thirteen_bytes() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 43);\n    let mut cases = Vec::new();\n    for extra in [0usize, 1, 4, 40] {\n        for ct in [0u8, 2, 6] {\n            let bpp = bpp_of(ct);\n            let (w, h) = (7usize, 3usize);\n            let raw = raw_image(&mut rng, w, h, bpp, &[0, 1, 2]);\n            let mut spec = PngSpec::new(\n                w as u32,\n                h as u32,\n                ct,\n                zlib_default(&deflate_fixed_literals(&raw)),\n            );\n            spec.ihdr_extra = rng.bytes(extra);\n            spec.ihdr_len = 13 + extra as u32;\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C43\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c47_c48_iend_placement_and_declared_length() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 47);\n    let (w, h) = (6usize, 4usize);\n    let raw = raw_image(&mut rng, w, h, 3, &[0, 1, 2, 3]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let mut variants: Vec<Vec<u8>> = Vec::new();\n\n    let mut base = PngSpec::new(w as u32, h as u32, 2, z.clone());\n    variants.push(base.build());\n    base.iend = false;\n    variants.push(base.build()); // no IEND\n    let mut with_pre_iend = PngSpec::new(w as u32, h as u32, 2, z.clone());\n    with_pre_iend.pre_chunks.push(chunk(b\"IEND\", &[]));\n    variants.push(with_pre_iend.build());\n    let mut trailing = PngSpec::new(w as u32, h as u32, 2, z.clone());\n    trailing.post_chunks.push(chunk(b\"tEXt\", b\"after\"));\n    let mut t = trailing.build();\n    t.extend_from_slice(b\"trailing garbage bytes\");\n    variants.push(t);\n\n    let mut cases: Vec<(Vec<u8>, i32)> = Vec::new();\n    for v in variants {\n        let n = v.len() as i32;\n        cases.push((v.clone(), n));\n        cases.push((v.clone(), n + 1));\n        cases.push((v.clone(), n + 64));\n        cases.push((v, n + 512));\n    }\n    expect_all_pass(\"C47/C48\", cases.len(), |i| {\n        let (v, n) = &cases[i];\n        p.png(v, *n)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C44..C46 — zlib header and stream size\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c44_every_accepted_zlib_header() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 44);\n    let (w, h) = (5usize, 3usize);\n    let raw = raw_image(&mut rng, w, h, 3, &[0, 1, 2]);\n    let d = deflate_fixed_literals(&raw);\n    let mut cases = Vec::new();\n    for cinfo in 0u8..8 {\n        for flg in [0x00u8, 0x01, 0x1F, 0xDF, 0xFF & !0x20] {\n            let cmf = (cinfo << 4) | 0x08;\n            let mut spec = PngSpec::new(w as u32, h as u32, 2, zlib(&d, cmf, flg));\n            spec.idat_pieces = 1 + (cinfo as usize % 3);\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C44\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c45_all_block_types_through_the_png_path() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 45);\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        let bpp = bpp_of(ct);\n        let (w, h) = (12usize, 4usize);\n        let raw = raw_image(&mut rng, w, h, bpp, &[0, 1, 2, 3]);\n        for e in ENCS {\n            let mut spec = PngSpec::new(w as u32, h as u32, ct, zlib_default(&encode(&raw, e)));\n            if ct == 3 {\n                spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n            }\n            cases.push(spec.build());\n        }\n        // two DEFLATE blocks\n        let half = raw.len() / 2;\n        let two = deflate_multi_fixed(&[&raw[..half], &raw[half..]]);\n        let mut spec = PngSpec::new(w as u32, h as u32, ct, zlib_default(&two));\n        if ct == 3 {\n            spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n        }\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"C45\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c46_stream_longer_than_the_image_needs() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 46);\n    // `out_bytes` is `(w+1)*h*4` but the image only needs `(w*bpp+1)*h`, so\n    // `h*(bpp-1)` extra bytes can be produced and are then ignored. Anything\n    // beyond that overruns `img.pix`, which is C undefined behaviour and is\n    // covered separately in tests/errors.rs.\n    let mut cases = Vec::new();\n    for ct in [2u8, 4, 6] {\n        let bpp = bpp_of(ct);\n        for &(w, h) in &[(4usize, 3usize), (9, 5), (16, 4)] {\n            let need = (w * bpp + 1) * h;\n            let slack = h * (bpp - 1);\n            for extra in [0usize, 1, slack / 2, slack] {\n                let mut raw = raw_image(&mut rng, w, h, bpp, &[0, 1, 2, 3, 4]);\n                raw.extend(rng.bytes(extra));\n                assert_eq!(raw.len(), need + extra);\n                let mut spec = PngSpec::new(\n                    w as u32,\n                    h as u32,\n                    ct,\n                    zlib_default(&deflate_fixed_literals(&raw)),\n                );\n                spec.idat_pieces = 2;\n                cases.push(spec.build());\n            }\n        }\n    }\n    expect_all_pass(\"C46\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C49..C51\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c49_repeated_calls_and_sticky_error_reason() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 49);\n    let (w, h) = (5usize, 3usize);\n    let raw = raw_image(&mut rng, w, h, 3, &[0, 1, 2]);\n    let good = PngSpec::new(\n        w as u32,\n        h as u32,\n        2,\n        zlib_default(&deflate_fixed_literals(&raw)),\n    )\n    .build();\n    let bad = b\"not a png at all\".to_vec();\n    expect_all_pass(\"C49\", 30, |i| {\n        // A failing call sets cp_error_reason; the C never clears it on success,\n        // so the interleaving of good and bad calls is itself observable.\n        match i % 3 {\n            0 => p.png(&good, good.len() as i32),\n            1 => p.png(&bad, bad.len() as i32),\n            _ => p.png(&good, good.len() as i32),\n        }\n    });\n}\n\n#[test]\nfn c50_mutated_tables_through_the_png_path() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 50);\n    let (w, h) = (8usize, 4usize);\n    let raw = raw_image(&mut rng, w, h, 3, &[0, 1, 2, 3]);\n    let png = PngSpec::new(\n        w as u32,\n        h as u32,\n        2,\n        zlib_default(&deflate_fixed_lz(&raw)),\n    )\n    .build();\n    let mut cases = Vec::new();\n    for _ in 0..60 {\n        cases.push((\n            rng.below(6) as usize,\n            rng.bytes(320),\n            rng.bytes(19),\n            rng.bytes(31),\n            (0..31).map(|_| rng.below(64)).collect::<Vec<u32>>(),\n            rng.bytes(32),\n            (0..32).map(|_| 1 + rng.below(24)).collect::<Vec<u32>>(),\n        ));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (which, ft, po, le, lb, de, db) = &cases[i];\n        for l in [&p.c, &p.r] {\n            unsafe {\n                match which {\n                    // cp_fixed_table: keep the values in 0..=15 so cp_build's\n                    // own assert() is not the thing being tested here\n                    0 => {\n                        let v: Vec<u8> = ft.iter().map(|b| b % 10).collect();\n                        std::ptr::copy_nonoverlapping(v.as_ptr(), l.cp_fixed_table, 320);\n                    }\n                    1 => {\n                        let v: Vec<u8> = po.iter().map(|b| b % 19).collect();\n                        std::ptr::copy_nonoverlapping(v.as_ptr(), l.cp_permutation_order, 19);\n                    }\n                    2 => {\n                        let v: Vec<u8> = le.iter().map(|b| b % 6).collect();\n                        std::ptr::copy_nonoverlapping(v.as_ptr(), l.cp_len_extra_bits, 31);\n                    }\n                    3 => std::ptr::copy_nonoverlapping(lb.as_ptr(), l.cp_len_base, 31),\n                    4 => {\n                        let v: Vec<u8> = de.iter().map(|b| b % 6).collect();\n                        std::ptr::copy_nonoverlapping(v.as_ptr(), l.cp_dist_extra_bits, 32);\n                    }\n                    _ => std::ptr::copy_nonoverlapping(db.as_ptr(), l.cp_dist_base, 32),\n                }\n            }\n        }\n        let r = p.png(&png, png.len() as i32);\n        p.reset();\n        r\n    });\n    p.reset();\n    expect_no_mismatch(\"C50\", &out);\n}\n\n#[test]\nfn c51_larger_images() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 51);\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for &(w, h) in &[(64usize, 17usize), (37, 23), (128, 3), (3, 128)] {\n            let bpp = bpp_of(ct);\n            let filters: Vec<u8> = (0..h).map(|_| rng.byte() % 5).collect();\n            let raw = raw_image(&mut rng, w, h, bpp, &filters);\n            let e = if ct % 2 == 0 { Enc::DynamicLz } else { Enc::Fixed };\n            let mut spec = PngSpec::new(w as u32, h as u32, ct, zlib_default(&encode(&raw, e)));\n            spec.idat_pieces = 3;\n            if ct == 3 {\n                spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                spec.pre_chunks.push(chunk(b\"tRNS\", &rng.bytes(200)));\n            }\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C51\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7655,"cache_read_input_tokens":221087,"cache_creation":{"ephemeral_5m_input_tokens":7655,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ca950163-4526-4c83-bcdb-90a4f8c566ab","uuid":"a59e8381-abf2-4d83-8264-885f2be88922","timestamp":"2026-08-27T13:25:47.033Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019hDYV2AnmCouF9ZLXQC79a","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/valid_png.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ca950163-4526-4c83-bcdb-90a4f8c566ab","uuid":"eb9ada55-3558-4960-9d4a-c280a3cdcf89","timestamp":"2026-08-27T13:25:47.045Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/valid_png.rs","content":"//! Phase B — valid-path differential tests for `load_png_mem`.\n//! Rows C25..C51 of `CONFIGS.md`.\n//!\n//! The whole pipeline runs end to end: chunk walking, IDAT concatenation, zlib\n//! header validation, DEFLATE, `cp_unfilter`, then `cp_convert` or\n//! `cp_depalette`. Every case compares `img.w`, `img.h`, `img.pix == NULL`,\n//! `cp_error_reason` and all `w*h` output pixels.\n\nmod common;\n\nuse common::diff::Pair;\nuse common::mk::*;\nuse common::*;\n\nconst SEED: u64 = 0xC0FFEE_1234_5678;\n\n/// The five deflate encodings a raw image stream can be wrapped in.\n#[derive(Copy, Clone, Debug)]\nenum Enc {\n    Stored,\n    Fixed,\n    FixedLz,\n    Dynamic,\n    DynamicRuns,\n    DynamicLz,\n}\n\nfn encode(raw: &[u8], e: Enc) -> Vec<u8> {\n    match e {\n        Enc::Stored => deflate_stored(raw),\n        Enc::Fixed => deflate_fixed_literals(raw),\n        Enc::FixedLz => deflate_fixed_lz(raw),\n        Enc::Dynamic => deflate_dynamic_literals(raw, false),\n        Enc::DynamicRuns => deflate_dynamic_literals(raw, true),\n        Enc::DynamicLz => deflate_dynamic_lz(raw, true),\n    }\n}\n\nconst ENCS: [Enc; 6] = [\n    Enc::Stored,\n    Enc::Fixed,\n    Enc::FixedLz,\n    Enc::Dynamic,\n    Enc::DynamicRuns,\n    Enc::DynamicLz,\n];\n\n/// A complete PNG for `w * h` with the given colour type and per-row filters.\nfn make_png(\n    rng: &mut Rng,\n    w: usize,\n    h: usize,\n    color_type: u8,\n    filters: &[u8],\n    e: Enc,\n    pieces: usize,\n) -> Vec<u8> {\n    let bpp = bpp_of(color_type);\n    let raw = raw_image(rng, w, h, bpp, filters);\n    let mut spec = PngSpec::new(w as u32, h as u32, color_type, zlib_default(&encode(&raw, e)));\n    spec.idat_pieces = pieces;\n    if color_type == 3 {\n        spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n    }\n    spec.build()\n}\n\nconst SIZES: [(usize, usize); 20] = [\n    (1, 1), (1, 2), (1, 3), (1, 7),\n    (2, 1), (2, 2), (2, 3), (2, 7),\n    (3, 1), (3, 2), (3, 3), (3, 7),\n    (5, 1), (5, 2), (5, 3), (5, 7),\n    (16, 1), (16, 2), (16, 3), (16, 7),\n];\n\n// ---------------------------------------------------------------------------\n// C25..C28, C35, C36 — the size grid for each non-indexed colour type\n// ---------------------------------------------------------------------------\n\nfn size_grid_test(label: &str, color_type: u8, seed: u64) {\n    let p = Pair::new();\n    let mut rng = Rng::new(seed);\n    let mut cases = Vec::new();\n    for &(w, h) in &SIZES {\n        for e in ENCS {\n            cases.push(make_png(&mut rng, w, h, color_type, &[0], e, 1));\n        }\n    }\n    expect_all_pass(label, cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c25_colour_type_0_grey() {\n    size_grid_test(\"C25\", 0, SEED ^ 25);\n}\n\n#[test]\nfn c26_colour_type_2_rgb() {\n    size_grid_test(\"C26\", 2, SEED ^ 26);\n}\n\n#[test]\nfn c27_colour_type_4_grey_alpha() {\n    size_grid_test(\"C27\", 4, SEED ^ 27);\n}\n\n#[test]\nfn c28_colour_type_6_rgba() {\n    size_grid_test(\"C28\", 6, SEED ^ 28);\n}\n\n// ---------------------------------------------------------------------------\n// C29..C31 — indexed images\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c29_indexed_without_trns() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 29);\n    let mut cases = Vec::new();\n    for &(w, h) in &SIZES {\n        for e in [Enc::Stored, Enc::Fixed, Enc::Dynamic, Enc::DynamicRuns] {\n            cases.push(make_png(&mut rng, w, h, 3, &[0], e, 1));\n        }\n    }\n    expect_all_pass(\"C29\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c30_indexed_with_trns_of_every_length() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 30);\n    let mut cases = Vec::new();\n    for trns_len in [0usize, 1, 2, 17, 128, 255, 256, 300, 768] {\n        for &(w, h) in &[(1usize, 1usize), (3, 2), (5, 3), (16, 7), (64, 5)] {\n            for e in [Enc::Fixed, Enc::DynamicRuns] {\n                let raw = raw_image(&mut rng, w, h, 1, &[0]);\n                let mut spec =\n                    PngSpec::new(w as u32, h as u32, 3, zlib_default(&encode(&raw, e)));\n                spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                spec.pre_chunks.push(chunk(b\"tRNS\", &rng.bytes(trns_len)));\n                cases.push(spec.build());\n            }\n        }\n    }\n    expect_all_pass(\"C30\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c31_indexed_with_short_palette_reads_past_the_chunk() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 31);\n    // `cp_depalette` indexes `plte[c*3 .. c*3+2]` with no bound on `c`, so a\n    // short PLTE makes the C read the bytes that follow it in the file.\n    let mut cases = Vec::new();\n    for plte_len in [0usize, 3, 6, 33, 96, 255, 384] {\n        for &(w, h) in &[(4usize, 2usize), (16, 3)] {\n            let raw = raw_image(&mut rng, w, h, 1, &[0]);\n            let mut spec = PngSpec::new(\n                w as u32,\n                h as u32,\n                3,\n                zlib_default(&deflate_fixed_literals(&raw)),\n            );\n            spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(plte_len)));\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C31\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C32..C34 — the filter code, which differs between row 0 and rows >= 1\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c32_every_filter_on_row_zero() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 32);\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for f0 in 0u8..=4 {\n            for &(w, h) in &[(1usize, 1usize), (2, 1), (3, 1), (5, 1), (9, 2), (16, 4)] {\n                let bpp = bpp_of(ct);\n                let mut raw = raw_image(&mut rng, w, h, bpp, &[0]);\n                raw[0] = f0; // row 0's filter byte\n                let mut spec =\n                    PngSpec::new(w as u32, h as u32, ct, zlib_default(&deflate_fixed_literals(&raw)));\n                if ct == 3 {\n                    spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                }\n                cases.push(spec.build());\n            }\n        }\n    }\n    expect_all_pass(\"C32\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c33_every_filter_on_later_rows() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 33);\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for f in 0u8..=4 {\n            for &(w, h) in &[(1usize, 2usize), (2, 2), (3, 3), (5, 4), (16, 5)] {\n                let bpp = bpp_of(ct);\n                let stride = w * bpp + 1;\n                let mut raw = raw_image(&mut rng, w, h, bpp, &[0]);\n                for y in 1..h {\n                    raw[y * stride] = f;\n                }\n                let mut spec =\n                    PngSpec::new(w as u32, h as u32, ct, zlib_default(&deflate_fixed_literals(&raw)));\n                if ct == 3 {\n                    spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                }\n                cases.push(spec.build());\n            }\n        }\n    }\n    expect_all_pass(\"C33\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c34_randomised_mixed_filters() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 34);\n    let mut cases = Vec::new();\n    for _ in 0..400 {\n        let ct = [0u8, 2, 3, 4, 6][rng.below(5) as usize];\n        let bpp = bpp_of(ct);\n        let w = 1 + rng.below(20) as usize;\n        let h = 1 + rng.below(9) as usize;\n        let filters: Vec<u8> = (0..h).map(|_| rng.byte() % 5).collect();\n        let raw = raw_image(&mut rng, w, h, bpp, &filters);\n        let e = ENCS[rng.below(6) as usize];\n        let mut spec = PngSpec::new(w as u32, h as u32, ct, zlib_default(&encode(&raw, e)));\n        spec.idat_pieces = 1 + rng.below(4) as usize;\n        if ct == 3 {\n            spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n            if rng.bool() {\n                let n = rng.below(300) as usize;\n                spec.pre_chunks.push(chunk(b\"tRNS\", &rng.bytes(n)));\n            }\n        }\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"C34\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c35_c36_width_one_and_height_one() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 35);\n    // w == 1 makes `len == bpp`, so each filter's second loop is empty;\n    // h == 1 skips the `for y in 1..h` loop entirely.\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for f in 0u8..=4 {\n            for &(w, h) in &[(1usize, 1usize), (1, 2), (1, 5), (2, 1), (7, 1), (64, 1)] {\n                let bpp = bpp_of(ct);\n                let raw = raw_image(&mut rng, w, h, bpp, &[f]);\n                let mut spec =\n                    PngSpec::new(w as u32, h as u32, ct, zlib_default(&deflate_fixed_literals(&raw)));\n                if ct == 3 {\n                    spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                }\n                cases.push(spec.build());\n            }\n        }\n    }\n    expect_all_pass(\"C35/C36\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C37..C43, C47, C48 — the chunk walker\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c37_idat_split_over_many_chunks() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 37);\n    let mut cases = Vec::new();\n    for pieces in [1usize, 2, 3, 5, 8, 17, 64] {\n        for ct in [0u8, 2, 4, 6] {\n            let bpp = bpp_of(ct);\n            let (w, h) = (16usize, 5usize);\n            let raw = raw_image(&mut rng, w, h, bpp, &[0, 1, 2, 3, 4]);\n            let mut spec = PngSpec::new(\n                w as u32,\n                h as u32,\n                ct,\n                zlib_default(&deflate_fixed_literals(&raw)),\n            );\n            spec.idat_pieces = pieces;\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C37\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c38_empty_idat_chunks() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 38);\n    let (w, h) = (8usize, 3usize);\n    let raw = raw_image(&mut rng, w, h, 3, &[0, 1, 2]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let empty = chunk(b\"IDAT\", &[]);\n    let mut cases = Vec::new();\n    for place in 0..3 {\n        let mut spec = PngSpec::new(w as u32, h as u32, 2, z.clone());\n        spec.idat_pieces = 3;\n        match place {\n            0 => spec.pre_chunks.push(empty.clone()),\n            1 => spec.interleave.push(empty.clone()),\n            _ => spec.post_chunks.push(empty.clone()),\n        }\n        cases.push(spec.build());\n    }\n    // two empty IDATs in a row, and an all-empty file\n    let mut spec = PngSpec::new(w as u32, h as u32, 2, z.clone());\n    spec.pre_chunks.push(empty.clone());\n    spec.pre_chunks.push(empty.clone());\n    cases.push(spec.build());\n    expect_all_pass(\"C38\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c39_ancillary_chunk_between_idats_breaks_the_chain() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 39);\n    // The C finds the first IDAT with `cp_find` and then walks with `cp_chunk`,\n    // which requires the *next* chunk to be an IDAT too. A chunk in between\n    // therefore truncates the DEFLATE stream.\n    let (w, h) = (8usize, 3usize);\n    let raw = raw_image(&mut rng, w, h, 3, &[0, 1, 2]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let mut cases = Vec::new();\n    for filler in [\n        chunk(b\"tEXt\", b\"hello\"),\n        chunk(b\"gAMA\", &[0, 1, 2, 3]),\n        chunk(b\"IDAt\", b\"x\"),\n        chunk(b\"idat\", b\"x\"),\n        chunk(b\"iDAT\", &[]),\n    ] {\n        for pieces in [2usize, 3, 5] {\n            let mut spec = PngSpec::new(w as u32, h as u32, 2, z.clone());\n            spec.idat_pieces = pieces;\n            spec.interleave.push(filler.clone());\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C39\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c40_ancillary_chunks_around_the_palette() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 40);\n    let (w, h) = (6usize, 3usize);\n    let raw = raw_image(&mut rng, w, h, 1, &[0, 2, 4]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let plte = chunk(b\"PLTE\", &rng.bytes(768));\n    let trns = chunk(b\"tRNS\", &rng.bytes(200));\n    let junk = chunk(b\"tEXt\", b\"a comment\");\n    let mut cases = Vec::new();\n    for order in 0..6 {\n        let mut spec = PngSpec::new(w as u32, h as u32, 3, z.clone());\n        spec.pre_chunks = match order {\n            0 => vec![plte.clone(), trns.clone()],\n            1 => vec![junk.clone(), plte.clone(), trns.clone()],\n            2 => vec![plte.clone(), junk.clone(), trns.clone()],\n            3 => vec![plte.clone(), trns.clone(), junk.clone()],\n            4 => vec![junk.clone(), plte.clone(), junk.clone(), trns.clone(), junk.clone()],\n            _ => vec![trns.clone(), plte.clone()], // C42: tRNS first\n        };\n        spec.post_chunks.push(junk.clone());\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"C40/C42\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c41_palette_chunks_present_for_non_indexed_types() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 41);\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 4, 6] {\n        for which in 0..3 {\n            let bpp = bpp_of(ct);\n            let (w, h) = (5usize, 3usize);\n            let raw = raw_image(&mut rng, w, h, bpp, &[0, 1, 3]);\n            let mut spec = PngSpec::new(\n                w as u32,\n                h as u32,\n                ct,\n                zlib_default(&deflate_fixed_literals(&raw)),\n            );\n            if which != 1 {\n                spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n            }\n            if which != 0 {\n                spec.pre_chunks.push(chunk(b\"tRNS\", &rng.bytes(64)));\n            }\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C41\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c43_ihdr_longer_than_thirteen_bytes() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 43);\n    let mut cases = Vec::new();\n    for extra in [0usize, 1, 4, 40] {\n        for ct in [0u8, 2, 6] {\n            let bpp = bpp_of(ct);\n            let (w, h) = (7usize, 3usize);\n            let raw = raw_image(&mut rng, w, h, bpp, &[0, 1, 2]);\n            let mut spec = PngSpec::new(\n                w as u32,\n                h as u32,\n                ct,\n                zlib_default(&deflate_fixed_literals(&raw)),\n            );\n            spec.ihdr_extra = rng.bytes(extra);\n            spec.ihdr_len = 13 + extra as u32;\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C43\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c47_c48_iend_placement_and_declared_length() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 47);\n    let (w, h) = (6usize, 4usize);\n    let raw = raw_image(&mut rng, w, h, 3, &[0, 1, 2, 3]);\n    let z = zlib_default(&deflate_fixed_literals(&raw));\n    let mut variants: Vec<Vec<u8>> = Vec::new();\n\n    let mut base = PngSpec::new(w as u32, h as u32, 2, z.clone());\n    variants.push(base.build());\n    base.iend = false;\n    variants.push(base.build()); // no IEND\n    let mut with_pre_iend = PngSpec::new(w as u32, h as u32, 2, z.clone());\n    with_pre_iend.pre_chunks.push(chunk(b\"IEND\", &[]));\n    variants.push(with_pre_iend.build());\n    let mut trailing = PngSpec::new(w as u32, h as u32, 2, z.clone());\n    trailing.post_chunks.push(chunk(b\"tEXt\", b\"after\"));\n    let mut t = trailing.build();\n    t.extend_from_slice(b\"trailing garbage bytes\");\n    variants.push(t);\n\n    let mut cases: Vec<(Vec<u8>, i32)> = Vec::new();\n    for v in variants {\n        let n = v.len() as i32;\n        cases.push((v.clone(), n));\n        cases.push((v.clone(), n + 1));\n        cases.push((v.clone(), n + 64));\n        cases.push((v, n + 512));\n    }\n    expect_all_pass(\"C47/C48\", cases.len(), |i| {\n        let (v, n) = &cases[i];\n        p.png(v, *n)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C44..C46 — zlib header and stream size\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c44_every_accepted_zlib_header() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 44);\n    let (w, h) = (5usize, 3usize);\n    let raw = raw_image(&mut rng, w, h, 3, &[0, 1, 2]);\n    let d = deflate_fixed_literals(&raw);\n    let mut cases = Vec::new();\n    for cinfo in 0u8..8 {\n        for flg in [0x00u8, 0x01, 0x1F, 0xDF, 0xFF & !0x20] {\n            let cmf = (cinfo << 4) | 0x08;\n            let mut spec = PngSpec::new(w as u32, h as u32, 2, zlib(&d, cmf, flg));\n            spec.idat_pieces = 1 + (cinfo as usize % 3);\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C44\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c45_all_block_types_through_the_png_path() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 45);\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        let bpp = bpp_of(ct);\n        let (w, h) = (12usize, 4usize);\n        let raw = raw_image(&mut rng, w, h, bpp, &[0, 1, 2, 3]);\n        for e in ENCS {\n            let mut spec = PngSpec::new(w as u32, h as u32, ct, zlib_default(&encode(&raw, e)));\n            if ct == 3 {\n                spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n            }\n            cases.push(spec.build());\n        }\n        // two DEFLATE blocks\n        let half = raw.len() / 2;\n        let two = deflate_multi_fixed(&[&raw[..half], &raw[half..]]);\n        let mut spec = PngSpec::new(w as u32, h as u32, ct, zlib_default(&two));\n        if ct == 3 {\n            spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n        }\n        cases.push(spec.build());\n    }\n    expect_all_pass(\"C45\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n#[test]\nfn c46_stream_longer_than_the_image_needs() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 46);\n    // `out_bytes` is `(w+1)*h*4` but the image only needs `(w*bpp+1)*h`, so\n    // `h*(bpp-1)` extra bytes can be produced and are then ignored. Anything\n    // beyond that overruns `img.pix`, which is C undefined behaviour and is\n    // covered separately in tests/errors.rs.\n    let mut cases = Vec::new();\n    for ct in [2u8, 4, 6] {\n        let bpp = bpp_of(ct);\n        for &(w, h) in &[(4usize, 3usize), (9, 5), (16, 4)] {\n            let need = (w * bpp + 1) * h;\n            let slack = h * (bpp - 1);\n            for extra in [0usize, 1, slack / 2, slack] {\n                let mut raw = raw_image(&mut rng, w, h, bpp, &[0, 1, 2, 3, 4]);\n                raw.extend(rng.bytes(extra));\n                assert_eq!(raw.len(), need + extra);\n                let mut spec = PngSpec::new(\n                    w as u32,\n                    h as u32,\n                    ct,\n                    zlib_default(&deflate_fixed_literals(&raw)),\n                );\n                spec.idat_pieces = 2;\n                cases.push(spec.build());\n            }\n        }\n    }\n    expect_all_pass(\"C46\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n// ---------------------------------------------------------------------------\n// C49..C51\n// ---------------------------------------------------------------------------\n\n#[test]\nfn c49_repeated_calls_and_sticky_error_reason() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 49);\n    let (w, h) = (5usize, 3usize);\n    let raw = raw_image(&mut rng, w, h, 3, &[0, 1, 2]);\n    let good = PngSpec::new(\n        w as u32,\n        h as u32,\n        2,\n        zlib_default(&deflate_fixed_literals(&raw)),\n    )\n    .build();\n    let bad = b\"not a png at all\".to_vec();\n    expect_all_pass(\"C49\", 30, |i| {\n        // A failing call sets cp_error_reason; the C never clears it on success,\n        // so the interleaving of good and bad calls is itself observable.\n        match i % 3 {\n            0 => p.png(&good, good.len() as i32),\n            1 => p.png(&bad, bad.len() as i32),\n            _ => p.png(&good, good.len() as i32),\n        }\n    });\n}\n\n#[test]\nfn c50_mutated_tables_through_the_png_path() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 50);\n    let (w, h) = (8usize, 4usize);\n    let raw = raw_image(&mut rng, w, h, 3, &[0, 1, 2, 3]);\n    let png = PngSpec::new(\n        w as u32,\n        h as u32,\n        2,\n        zlib_default(&deflate_fixed_lz(&raw)),\n    )\n    .build();\n    let mut cases = Vec::new();\n    for _ in 0..60 {\n        cases.push((\n            rng.below(6) as usize,\n            rng.bytes(320),\n            rng.bytes(19),\n            rng.bytes(31),\n            (0..31).map(|_| rng.below(64)).collect::<Vec<u32>>(),\n            rng.bytes(32),\n            (0..32).map(|_| 1 + rng.below(24)).collect::<Vec<u32>>(),\n        ));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (which, ft, po, le, lb, de, db) = &cases[i];\n        for l in [&p.c, &p.r] {\n            unsafe {\n                match which {\n                    // cp_fixed_table: keep the values in 0..=15 so cp_build's\n                    // own assert() is not the thing being tested here\n                    0 => {\n                        let v: Vec<u8> = ft.iter().map(|b| b % 10).collect();\n                        std::ptr::copy_nonoverlapping(v.as_ptr(), l.cp_fixed_table, 320);\n                    }\n                    1 => {\n                        let v: Vec<u8> = po.iter().map(|b| b % 19).collect();\n                        std::ptr::copy_nonoverlapping(v.as_ptr(), l.cp_permutation_order, 19);\n                    }\n                    2 => {\n                        let v: Vec<u8> = le.iter().map(|b| b % 6).collect();\n                        std::ptr::copy_nonoverlapping(v.as_ptr(), l.cp_len_extra_bits, 31);\n                    }\n                    3 => std::ptr::copy_nonoverlapping(lb.as_ptr(), l.cp_len_base, 31),\n                    4 => {\n                        let v: Vec<u8> = de.iter().map(|b| b % 6).collect();\n                        std::ptr::copy_nonoverlapping(v.as_ptr(), l.cp_dist_extra_bits, 32);\n                    }\n                    _ => std::ptr::copy_nonoverlapping(db.as_ptr(), l.cp_dist_base, 32),\n                }\n            }\n        }\n        let r = p.png(&png, png.len() as i32);\n        p.reset();\n        r\n    });\n    p.reset();\n    expect_no_mismatch(\"C50\", &out);\n}\n\n#[test]\nfn c51_larger_images() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 51);\n    let mut cases = Vec::new();\n    for ct in [0u8, 2, 3, 4, 6] {\n        for &(w, h) in &[(64usize, 17usize), (37, 23), (128, 3), (3, 128)] {\n            let bpp = bpp_of(ct);\n            let filters: Vec<u8> = (0..h).map(|_| rng.byte() % 5).collect();\n            let raw = raw_image(&mut rng, w, h, bpp, &filters);\n            let e = if ct % 2 == 0 { Enc::DynamicLz } else { Enc::Fixed };\n            let mut spec = PngSpec::new(w as u32, h as u32, ct, zlib_default(&encode(&raw, e)));\n            spec.idat_pieces = 3;\n            if ct == 3 {\n                spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                spec.pre_chunks.push(chunk(b\"tRNS\", &rng.bytes(200)));\n            }\n            cases.push(spec.build());\n        }\n    }\n    expect_all_pass(\"C51\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
