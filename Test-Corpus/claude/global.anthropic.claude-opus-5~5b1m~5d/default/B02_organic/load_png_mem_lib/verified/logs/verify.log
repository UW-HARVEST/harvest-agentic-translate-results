    }\n915\t        }\n916\t    }\n917\t}\n918\t\n919\t/// `static uint8_t cp_get_alpha_for_indexed_image(int index, const uint8_t *trns, uint32_t trns_len)`\n920\tunsafe fn cp_get_alpha_for_indexed_image(index: c_int, trns: *const u8, trns_len: u32) -> u8 {\n921\t    unsafe {\n922\t        if trns.is_null() {\n923\t            255\n924\t        } else if (index as u32) >= trns_len {\n925\t            255\n926\t        } else {\n927\t            *trns.offset(index as isize)\n928\t        }\n929\t    }\n930\t}\n931\t\n932\t/// `static void cp_depalette(int w, int h, uint8_t *src, cp_pixel_t *dst, const uint8_t *plte, const uint8_t *trns, uint32_t trns_len)`\n933\tunsafe fn cp_depalette(\n934\t    w: c_int,\n935\t    h: c_int,\n936\t    src: *mut u8,\n937\t    dst: *mut cp_pixel_t,\n938\t    plte: *const u8,\n939\t    trns: *const u8,\n940\t    trns_len: u32,\n941\t) {\n942\t    unsafe {\n943\t        let mut src = src;\n944\t        let mut dst = dst;\n945\t        for _y in 0..h {\n946\t            src = src.wrapping_offset(1);\n947\t            let mut x: c_int = 0;\n948\t            while x < w {\n949\t                let c = *src as c_int;\n950\t                let r = *plte.offset((c * 3) as isize);\n951\t                let g = *plte.offset((c * 3 + 1) as isize);\n952\t                let b = *plte.offset((c * 3 + 2) as isize);\n953\t                let a = cp_get_alpha_for_indexed_image(c, trns, trns_len);\n954\t                *dst = cp_make_pixel_a(r, g, b, a);\n955\t                dst = dst.wrapping_offset(1);\n956\t                x += 1;\n957\t                src = src.wrapping_offset(1);\n958\t            }\n959\t        }\n960\t    }\n961\t}\n962\t\n963\t/// `static uint32_t cp_get_chunk_byte_length(const uint8_t *chunk)`\n964\tunsafe fn cp_get_chunk_byte_length(chunk: *const u8) -> u32 {\n965\t    unsafe { cp_make32(chunk.wrapping_offset(-8)) }\n966\t}\n967\t\n968\t/// `static int cp_out_size(cp_image_t *img, int bpp)`\n969\tfn cp_out_size(img: &cp_im