=> deflate_fixed_lz(&raw),\n                    3 => deflate_dynamic_literals(&raw, false),\n                    4 => deflate_dynamic_literals(&raw, true),\n                    _ => deflate_dynamic_lz(&raw, true),\n                };\n                let mut spec = PngSpec::new(w as u32, h as u32, ct, zlib_default(&d));\n                spec.idat_pieces = 1 + (enc % 3);\n                if ct == 3 {\n                    spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                    if enc % 2 == 0 {\n                        spec.pre_chunks.push(chunk(b\"tRNS\", &rng.bytes(120)));\n                    }\n                }\n                v.push(spec.build());\n            }\n        }\n    }\n    v\n}\n\nfn mutate(rng: &mut Rng, base: &[u8]) -> Vec<u8> {\n    let mut s = base.to_vec();\n    match rng.below(8) {\n        // single/multi bit flips\n        0 | 1 => {\n            for _ in 0..1 + rng.below(6) {\n                let k = rng.below(s.len() as u32) as usize;\n                s[k] ^= 1 << rng.below(8);\n            }\n        }\n        // byte overwrites, biased to interesting values\n        2 => {\n            for _ in 0..1 + rng.below(6) {\n                let k = rng.below(s.len() as u32) as usize;\n                s[k] = [0u8, 1, 0x7F, 0x80, 0xFE, 0xFF][rng.below(6) as usize];\n            }\n        }\n        // truncation\n        3 => {\n            let n = rng.below(s.len() as u32) as usize;\n            s.truncate(n);\n        }\n        // deletion of a run\n        4 => {\n            if s.len() > 8 {\n                let at = rng.below(s.len() as u32 - 4) as usize;\n                let n = 1 + rng.below(8) as usize;\n                let end = (at + n).min(s.len());\n                s.drain(at..end);\n            }\n        }\n        // insertion\n        5 => {\n            let at = rng.below(s.len() as u32 + 1) as usize;\n            let ins = rng.bytes(1 + rng.below(8) as usize);\n            for (i, b) in ins.into_iter().en