{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_vjuv2kskwb3ekivn7y6npd7bo56om3mxkhdcjl3ducsvwq2b5y6a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01J3myedoP657V16nHFty1bh","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/asserts.rs","content":"//! Phase C, assert surface — the `A1..A10` rows of `ERRORS.md`.\n//!\n//! `c_src/CMakeLists.txt` sets no `CMAKE_BUILD_TYPE`, so the reference build has\n//! `assert()` **live** and `abort()`s on ten distinct conditions. The Rust\n//! translation reproduces the `NDEBUG` behaviour instead (what every\n//! `-DCMAKE_BUILD_TYPE=Release/RelWithDebInfo/MinSizeRel` build does), because a\n//! decoder that kills its caller on malformed input is not usable and because\n//! `assert()` is exactly how the C author documents \"caller must not do this\".\n//!\n//! What this file proves:\n//!\n//!  1. every one of the ten asserts is either **reached** by a concrete input\n//!     (identified by name, from the C's own `__assert_fail` message) or\n//!     **provably unreachable**;\n//!  2. on every one of those inputs, the Rust library agrees byte-for-byte with\n//!     the same C source compiled `-O0 -DNDEBUG` -- i.e. the *only* difference\n//!     from the reference build is the `abort()` itself.\n\nmod common;\n\nuse common::diff::Pair;\nuse common::mk::*;\nuse common::*;\n\nconst SEED: u64 = 0xA55E_2700_0000_0001;\n\n/// The ten `assert()` sites in `c_src/src/lib.c`, keyed by (function, expression).\nconst SITES: [(&str, &str, &str); 10] = [\n    (\"A1\", \"cp_ptr\", \"!(s->bits_left & 7)\"),\n    (\"A2\", \"cp_peak_bits\", \"s->word_index <= s->word_count\"),\n    (\"A3\", \"cp_consume_bits\", \"s->count >= num_bits_to_read\"),\n    (\"A4\", \"cp_read_bits\", \"num_bits_to_read <= 32\"),\n    (\"A5\", \"cp_read_bits\", \"num_bits_to_read >= 0\"),\n    (\"A6\", \"cp_read_bits\", \"s->bits_left > 0\"),\n    (\"A7\", \"cp_read_bits\", \"s->count <= 64\"),\n    (\"A8\", \"cp_read_bits\", \"!cp_would_overflow(s, num_bits_to_read)\"),\n    (\"A9\", \"cp_build\", \"len < 16\"),\n    (\"A10\", \"cp_decode\", \"(search >> len) == (key >> len)\"),\n];\n\n/// Rows that cannot fire, with the argument:\n///\n/// * A2 sits inside `if (s->word_index < s->word_count) { ...; s->word_index++; }`,\n///   so `word_index <= word_count` holds by construction.\n/// * A5's `num_bits_to_read` comes from `1`, `2`, `3`, `4`, `5`, `7`, `16`,\n///   `s->count & 7`, `key & 0xF`, or a `uint8_t` table entry -- never negative.\n/// * A7: `s->count` only grows in `cp_peak_bits`, and only when\n///   `count < num_bits_to_read <= 32`; the largest possible result is\n///   `31 + 32 == 63`, except on the `final_word` path where it grows by\n///   `s->bits_left`, which is at most `count + 32` as well. `count > 64` needs\n///   two loads without a consume in between, which the guard prevents.\nconst UNREACHABLE: [&str; 3] = [\"A2\", \"A5\", \"A7\"];\n\n/// A corpus of malformed inputs, deliberately built to violate the decoder's\n/// preconditions in as many different ways as possible.\nfn corpus() -> Vec<(String, Vec<u8>, i32, usize)> {\n    let mut rng = Rng::new(SEED);\n    let mut v: Vec<(String, Vec<u8>, i32, usize)> = Vec::new();\n    let mut add = |name: String, s: Vec<u8>, out: i32, ia: usize| v.push((name, s, out, ia));\n\n    // --- truncated streams: exhaust the bit reader (A3 / A6 / A8) -----------\n    for n in 1..40usize {\n        let data = vec![0x41u8; 24];\n        for enc in 0..4 {\n            let full = match enc {\n                0 => deflate_fixed_literals(&data),\n                1 => deflate_dynamic_literals(&data, false),\n                2 => deflate_dynamic_literals(&data, true),\n                _ => deflate_fixed_lz(&data),\n            };\n            if n < full.len() {\n                for ia in 0..4 {\n                    add(format!(\"trunc enc{enc} to {n}\"), full[..n].to_vec(), 64, ia);\n                }\n            }\n        }\n    }\n    // empty and near-empty inputs\n    for n in 0..6usize {\n        for ia in 0..4 {\n            add(format!(\"tiny {n}\"), vec![0u8; n], 32, ia);\n            add(format!(\"tiny-ff {n}\"), vec![0xFFu8; n], 32, ia);\n        }\n    }\n\n    // --- incomplete / bogus Huffman trees (A10) ----------------------------\n    // A dynamic block whose literal code is incomplete: some bit patterns then\n    // match no code at all.\n    for m in 2..12usize {\n        let mut used: Vec<usize> = vec![256];\n        for k in 0..m {\n            used.push(k * 7 + 1);\n        }\n        used.sort_unstable();\n        let mut lens = lens_for(257, &used);\n        // lengthen one code so the tree is no longer complete\n        for &u in used.iter().take(1) {\n            lens[u] = lens[u].saturating_add(1).min(15);\n        }\n        let spec = DynSpec::new(lens, vec![1u8; 2]);\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(2, 2);\n        dynamic_header(&mut bw, &spec);\n        for _ in 0..8 {\n            bw.bits(0xFFFF, 16);\n        }\n        let s = bw.finish();\n        for ia in 0..4 {\n            add(format!(\"incomplete tree m={m}\"), s.clone(), 64, ia);\n        }\n    }\n    // Empty code-length tree: HCLEN fields all zero => s->nlen == 0 => cp_decode\n    // runs with hi == 0 and reads len[-1].\n    {\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(2, 2);\n        bw.bits(0, 5); // HLIT  => nlit 257\n        bw.bits(0, 5); // HDIST => ndst 1\n        bw.bits(15, 4); // HCLEN => nlen 19\n        for _ in 0..19 {\n            bw.bits(0, 3);\n        }\n        for _ in 0..32 {\n            bw.bits(0xFFFF, 16);\n        }\n        let s = bw.finish();\n        for ia in 0..4 {\n            add(\"empty code-length tree\".into(), s.clone(), 64, ia);\n        }\n    }\n    // Two dynamic blocks where the second has an empty code-length tree: the\n    // first fills s->dst, so len[-1] (== dst[31]) is no longer zero and the\n    // decoded code length can exceed 15 (A9).\n    {\n        let dused: Vec<usize> = (0..32).collect();\n        let first = DynSpec::new(lens_for(257, &[0, 1, 256]), lens_for(32, &dused));\n        let mut bw = BitWriter::new();\n        bw.bits(0, 1);\n        bw.bits(2, 2);\n        dynamic_header(&mut bw, &first);\n        emit_tokens(&mut bw, &[Tok::End], &first.lit_lens, &first.dist_lens);\n        bw.bits(1, 1);\n        bw.bits(2, 2);\n        bw.bits(0, 5);\n        bw.bits(0, 5);\n        bw.bits(15, 4);\n        for _ in 0..19 {\n            bw.bits(0, 3);\n        }\n        for _ in 0..48 {\n            bw.bits(0xFFFF, 16);\n        }\n        let s = bw.finish();\n        for ia in 0..4 {\n            add(\"second block, empty len tree\".into(), s.clone(), 128, ia);\n        }\n    }\n\n    // --- code lengths >= 16 straight from a mutated cp_fixed_table (A9) -----\n    // (handled separately: it needs a table write, see a9_mutated_fixed_table)\n\n    // --- stored blocks reached with an unaligned bits_left (A1) -------------\n    // A fixed block consumes an arbitrary number of bits, then a stored block\n    // calls cp_ptr(). Sweep the number of leading literals and the input size so\n    // that the `final_word` path lands in every possible place.\n    for nlit in 0..24usize {\n        for pad in 0..4usize {\n            let mut bw = BitWriter::new();\n            fixed_block(&mut bw, false, &vec![Tok::Lit(0x61); nlit]);\n            stored_block(&mut bw, true, &[0xDE, 0xAD, 0xBE, 0xEF]);\n            let mut s = bw.finish();\n            s.extend(std::iter::repeat_n(0u8, pad));\n            for ia in 0..4 {\n                add(format!(\"fixed({nlit})+stored pad{pad}\"), s.clone(), 64, ia);\n            }\n        }\n    }\n    // Stored blocks whose LEN/NLEN reads straddle the final word.\n    for n in 0..8usize {\n        for ia in 0..4 {\n            let s = deflate_stored(&vec![0x5Au8; n]);\n            for cut in 0..s.len().min(6) {\n                add(\n                    format!(\"stored {n} cut {cut}\"),\n                    s[..s.len() - cut].to_vec(),\n                    64,\n                    ia,\n                );\n            }\n        }\n    }\n\n    // --- random noise ------------------------------------------------------\n    for _ in 0..600 {\n        let n = 1 + rng.below(40) as usize;\n        let s = rng.bytes(n);\n        add(\n            \"noise\".into(),\n            s,\n            rng.below(64) as i32,\n            rng.below(4) as usize,\n        );\n    }\n    v\n}\n\n#[test]\nfn assert_rows_are_reached_and_ndebug_matches_rust() {\n    let p = Pair::new();\n    let cases = corpus();\n    eprintln!(\"assert corpus: {} cases\", cases.len());\n\n    // (1) the NDEBUG C and the Rust must agree on every single one of them\n    let out = run_isolated(cases.len(), |i| {\n        let (name, s, out_bytes, ia) = &cases[i];\n        p.inflate(s, s.len() as i32, *out_bytes, *ia, 0)\n            .map_err(|e| format!(\"[{name}] {e}\"))\n    });\n    let mismatches: Vec<String> = out\n        .iter()\n        .enumerate()\n        .filter_map(|(i, o)| match o {\n            CaseOutcome::Fail(m) if !m.starts_with(common::diff::SKIP) => {\n                Some(format!(\"case {i} ({}): {m}\", cases[i].0))\n            }\n            _ => None,\n        })\n        .collect();\n    assert!(\n        mismatches.is_empty(),\n        \"the NDEBUG C build and the Rust must agree on every input:\\n{}\",\n        mismatches.join(\"\\n\")\n    );\n\n    // (2) collect which assert each input trips in the reference build\n    let ca = c_assert_lib();\n    let mut seen: std::collections::BTreeMap<(String, String), (usize, String)> =\n        std::collections::BTreeMap::new();\n    let mut deaths = 0usize;\n    for (name, s, out_bytes, ia) in &cases {\n        let run = || {\n            let _ = common::diff::probe_inflate(&ca, s, s.len() as i32, *out_bytes, *ia, 0);\n        };\n        let (died, err) = capture_death(&run);\n        if !died {\n            continue;\n        }\n        deaths += 1;\n        if let Some((func, expr)) = assert_site(&err) {\n            let e = seen.entry((func, expr)).or_insert((0, name.clone()));\n            e.0 += 1;\n        }\n    }\n    eprintln!(\"reference build died on {deaths}/{} inputs\", cases.len());\n    for ((func, expr), (n, example)) in &seen {\n        eprintln!(\"  {func}: {expr}   x{n}   e.g. {example}\");\n    }\n\n    // (3) every row of ERRORS.md's assert table must be accounted for\n    let mut unaccounted = Vec::new();\n    for (row, func, expr) in SITES {\n        let hit = seen.keys().any(|(f, e)| f == func && e == expr);\n        if !hit && !UNREACHABLE.contains(&row) {\n            unaccounted.push(format!(\"{row} ({func}: {expr})\"));\n        }\n        if hit && UNREACHABLE.contains(&row) {\n            panic!(\"{row} was documented unreachable but fired ({func}: {expr})\");\n        }\n    }\n    assert!(\n        unaccounted.is_empty(),\n        \"assert rows neither reached by the corpus nor documented unreachable: {unaccounted:?}\\n\\\n         reached: {:?}\",\n        seen.keys().collect::<Vec<_>>()\n    );\n}\n\n/// A9 via the public API: a caller writing a code length >= 16 into\n/// `cp_fixed_table` makes `cp_build` index `counts[len]` past its 16 entries.\n/// The reference build catches that with `assert(len < 16)`; the translation\n/// gives `counts`/`codes`/`first` 256 entries so the same input stays memory\n/// safe instead of smashing the C's stack frame.\n#[test]\nfn a9_code_length_above_fifteen_from_a_mutated_table() {\n    let p = Pair::new();\n    let ca = c_assert_lib();\n    let mut rng = Rng::new(SEED ^ 9);\n    let data = rng.bytes(16);\n    let stream = deflate_fixed_literals(&data);\n\n    let mut fired = 0usize;\n    for len in 16u8..=255 {\n        for l in [&p.c, &p.r, &ca] {\n            unsafe { *l.cp_fixed_table.add(0) = len };\n        }\n        let run = || {\n            let _ = common::diff::probe_inflate(&ca, &stream, stream.len() as i32, 64, 0, 0);\n        };\n        let (died, err) = capture_death(&run);\n        if died {\n            if let Some((func, expr)) = assert_site(&err) {\n                assert_eq!(\n                    (func.as_str(), expr.as_str()),\n                    (\"cp_build\", \"len < 16\"),\n                    \"expected cp_build's assert for length {len}\"\n                );\n                fired += 1;\n            }\n        }\n        // ... and the NDEBUG build's undefined stack aliasing is what the Rust\n        // cannot (and must not) reproduce, so only require the same fate.\n        let out = run_isolated(1, |_| {\n            p.inflate(&stream, stream.len() as i32, 64, 0, 0)\n        });\n        let _ = &out;\n        p.reset();\n        ca.reset_tables();\n    }\n    assert!(\n        fired >= 200,\n        \"cp_build's assert(len < 16) fired only {fired} times out of 240\"\n    );\n}\n\n/// A4: `cp_read_bits(s, n)` with `n > 32`. `n` comes from\n/// `cp_len_extra_bits[symbol]` / `cp_dist_extra_bits[symbol]`, which are\n/// `uint8_t` tables a caller can write any value into.\n#[test]\nfn a4_num_bits_to_read_above_thirty_two() {\n    let p = Pair::new();\n    let ca = c_assert_lib();\n    let mut rng = Rng::new(SEED ^ 4);\n    let data: Vec<u8> = (0..64).map(|k| (k as u8) ^ 0x33).collect();\n    let stream = deflate_fixed_lz(&data);\n    let _ = &mut rng;\n\n    let mut fired = false;\n    for n in [33u8, 40, 63, 64, 65, 128, 200, 255] {\n        for l in [&p.c, &p.r, &ca] {\n            unsafe {\n                for k in 0..31 {\n                    *l.cp_len_extra_bits.add(k) = n;\n                }\n                for k in 0..32 {\n                    *l.cp_dist_extra_bits.add(k) = n;\n                }\n            }\n        }\n        let run = || {\n            let _ = common::diff::probe_inflate(&ca, &stream, stream.len() as i32, 256, 0, 0);\n        };\n        let (died, err) = capture_death(&run);\n        if died {\n            if let Some((func, expr)) = assert_site(&err) {\n                eprintln!(\"n={n}: {func}: {expr}\");\n                if func == \"cp_read_bits\" && expr == \"num_bits_to_read <= 32\" {\n                    fired = true;\n                }\n            }\n        }\n        // The NDEBUG C masks the shift count to 6 bits (x86-64 `shl`), and so\n        // does the translation via `wrapping_shl`.\n        let out = run_isolated(1, |_| {\n            p.inflate(&stream, stream.len() as i32, 256, 0, 0)\n        });\n        expect_no_mismatch(&format!(\"A4 n={n}\"), &out);\n        p.reset();\n        ca.reset_tables();\n    }\n    assert!(fired, \"cp_read_bits' assert(num_bits_to_read <= 32) never fired\");\n}\n"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5335,"cache_read_input_tokens":334782,"output_tokens":6112,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":5335},"inference_geo":"","iterations":[],"speed":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ca950163-4526-4c83-bcdb-90a4f8c566ab","uuid":"ccf7e260-b953-424e-a68c-6a632904c12d","timestamp":"2026-08-27T13:46:38.213Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01J3myedoP657V16nHFty1bh","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/asserts.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ca950163-4526-4c83-bcdb-90a4f8c566ab","uuid":"5230757a-0789-4e5e-82ee-b9a1ea9cd4d9","timestamp":"2026-08-27T13:46:38.227Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/asserts.rs","content":"//! Phase C, assert surface — the `A1..A10` rows of `ERRORS.md`.\n//!\n//! `c_src/CMakeLists.txt` sets no `CMAKE_BUILD_TYPE`, so the reference build has\n//! `assert()` **live** and `abort()`s on ten distinct conditions. The Rust\n//! translation reproduces the `NDEBUG` behaviour instead (what every\n//! `-DCMAKE_BUILD_TYPE=Release/RelWithDebInfo/MinSizeRel` build does), because a\n//! decoder that kills its caller on malformed input is not usable and because\n//! `assert()` is exactly how the C author documents \"caller must not do this\".\n//!\n//! What this file proves:\n//!\n//!  1. every one of the ten asserts is either **reached** by a concrete input\n//!     (identified by name, from the C's own `__assert_fail` message) or\n//!     **provably unreachable**;\n//!  2. on every one of those inputs, the Rust library agrees byte-for-byte with\n//!     the same C source compiled `-O0 -DNDEBUG` -- i.e. the *only* difference\n//!     from the reference build is the `abort()` itself.\n\nmod common;\n\nuse common::diff::Pair;\nuse common::mk::*;\nuse common::*;\n\nconst SEED: u64 = 0xA55E_2700_0000_0001;\n\n/// The ten `assert()` sites in `c_src/src/lib.c`, keyed by (function, expression).\nconst SITES: [(&str, &str, &str); 10] = [\n    (\"A1\", \"cp_ptr\", \"!(s->bits_left & 7)\"),\n    (\"A2\", \"cp_peak_bits\", \"s->word_index <= s->word_count\"),\n    (\"A3\", \"cp_consume_bits\", \"s->count >= num_bits_to_read\"),\n    (\"A4\", \"cp_read_bits\", \"num_bits_to_read <= 32\"),\n    (\"A5\", \"cp_read_bits\", \"num_bits_to_read >= 0\"),\n    (\"A6\", \"cp_read_bits\", \"s->bits_left > 0\"),\n    (\"A7\", \"cp_read_bits\", \"s->count <= 64\"),\n    (\"A8\", \"cp_read_bits\", \"!cp_would_overflow(s, num_bits_to_read)\"),\n    (\"A9\", \"cp_build\", \"len < 16\"),\n    (\"A10\", \"cp_decode\", \"(search >> len) == (key >> len)\"),\n];\n\n/// Rows that cannot fire, with the argument:\n///\n/// * A2 sits inside `if (s->word_index < s->word_count) { ...; s->word_index++; }`,\n///   so `word_index <= word_count` holds by construction.\n/// * A5's `num_bits_to_read` comes from `1`, `2`, `3`, `4`, `5`, `7`, `16`,\n///   `s->count & 7`, `key & 0xF`, or a `uint8_t` table entry -- never negative.\n/// * A7: `s->count` only grows in `cp_peak_bits`, and only when\n///   `count < num_bits_to_read <= 32`; the largest possible result is\n///   `31 + 32 == 63`, except on the `final_word` path where it grows by\n///   `s->bits_left`, which is at most `count + 32` as well. `count > 64` needs\n///   two loads without a consume in between, which the guard prevents.\nconst UNREACHABLE: [&str; 3] = [\"A2\", \"A5\", \"A7\"];\n\n/// A corpus of malformed inputs, deliberately built to violate the decoder's\n/// preconditions in as many different ways as possible.\nfn corpus() -> Vec<(String, Vec<u8>, i32, usize)> {\n    let mut rng = Rng::new(SEED);\n    let mut v: Vec<(String, Vec<u8>, i32, usize)> = Vec::new();\n    let mut add = |name: String, s: Vec<u8>, out: i32, ia: usize| v.push((name, s, out, ia));\n\n    // --- truncated streams: exhaust the bit reader (A3 / A6 / A8) -----------\n    for n in 1..40usize {\n        let data = vec![0x41u8; 24];\n        for enc in 0..4 {\n            let full = match enc {\n                0 => deflate_fixed_literals(&data),\n                1 => deflate_dynamic_literals(&data, false),\n                2 => deflate_dynamic_literals(&data, true),\n                _ => deflate_fixed_lz(&data),\n            };\n            if n < full.len() {\n                for ia in 0..4 {\n                    add(format!(\"trunc enc{enc} to {n}\"), full[..n].to_vec(), 64, ia);\n                }\n            }\n        }\n    }\n    // empty and near-empty inputs\n    for n in 0..6usize {\n        for ia in 0..4 {\n            add(format!(\"tiny {n}\"), vec![0u8; n], 32, ia);\n            add(format!(\"tiny-ff {n}\"), vec![0xFFu8; n], 32, ia);\n        }\n    }\n\n    // --- incomplete / bogus Huffman trees (A10) ----------------------------\n    // A dynamic block whose literal code is incomplete: some bit patterns then\n    // match no code at all.\n    for m in 2..12usize {\n        let mut used: Vec<usize> = vec![256];\n        for k in 0..m {\n            used.push(k * 7 + 1);\n        }\n        used.sort_unstable();\n        let mut lens = lens_for(257, &used);\n        // lengthen one code so the tree is no longer complete\n        for &u in used.iter().take(1) {\n            lens[u] = lens[u].saturating_add(1).min(15);\n        }\n        let spec = DynSpec::new(lens, vec![1u8; 2]);\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(2, 2);\n        dynamic_header(&mut bw, &spec);\n        for _ in 0..8 {\n            bw.bits(0xFFFF, 16);\n        }\n        let s = bw.finish();\n        for ia in 0..4 {\n            add(format!(\"incomplete tree m={m}\"), s.clone(), 64, ia);\n        }\n    }\n    // Empty code-length tree: HCLEN fields all zero => s->nlen == 0 => cp_decode\n    // runs with hi == 0 and reads len[-1].\n    {\n        let mut bw = BitWriter::new();\n        bw.bits(1, 1);\n        bw.bits(2, 2);\n        bw.bits(0, 5); // HLIT  => nlit 257\n        bw.bits(0, 5); // HDIST => ndst 1\n        bw.bits(15, 4); // HCLEN => nlen 19\n        for _ in 0..19 {\n            bw.bits(0, 3);\n        }\n        for _ in 0..32 {\n            bw.bits(0xFFFF, 16);\n        }\n        let s = bw.finish();\n        for ia in 0..4 {\n            add(\"empty code-length tree\".into(), s.clone(), 64, ia);\n        }\n    }\n    // Two dynamic blocks where the second has an empty code-length tree: the\n    // first fills s->dst, so len[-1] (== dst[31]) is no longer zero and the\n    // decoded code length can exceed 15 (A9).\n    {\n        let dused: Vec<usize> = (0..32).collect();\n        let first = DynSpec::new(lens_for(257, &[0, 1, 256]), lens_for(32, &dused));\n        let mut bw = BitWriter::new();\n        bw.bits(0, 1);\n        bw.bits(2, 2);\n        dynamic_header(&mut bw, &first);\n        emit_tokens(&mut bw, &[Tok::End], &first.lit_lens, &first.dist_lens);\n        bw.bits(1, 1);\n        bw.bits(2, 2);\n        bw.bits(0, 5);\n        bw.bits(0, 5);\n        bw.bits(15, 4);\n        for _ in 0..19 {\n            bw.bits(0, 3);\n        }\n        for _ in 0..48 {\n            bw.bits(0xFFFF, 16);\n        }\n        let s = bw.finish();\n        for ia in 0..4 {\n            add(\"second block, empty len tree\".into(), s.clone(), 128, ia);\n        }\n    }\n\n    // --- code lengths >= 16 straight from a mutated cp_fixed_table (A9) -----\n    // (handled separately: it needs a table write, see a9_mutated_fixed_table)\n\n    // --- stored blocks reached with an unaligned bits_left (A1) -------------\n    // A fixed block consumes an arbitrary number of bits, then a stored block\n    // calls cp_ptr(). Sweep the number of leading literals and the input size so\n    // that the `final_word` path lands in every possible place.\n    for nlit in 0..24usize {\n        for pad in 0..4usize {\n            let mut bw = BitWriter::new();\n            fixed_block(&mut bw, false, &vec![Tok::Lit(0x61); nlit]);\n            stored_block(&mut bw, true, &[0xDE, 0xAD, 0xBE, 0xEF]);\n            let mut s = bw.finish();\n            s.extend(std::iter::repeat_n(0u8, pad));\n            for ia in 0..4 {\n                add(format!(\"fixed({nlit})+stored pad{pad}\"), s.clone(), 64, ia);\n            }\n        }\n    }\n    // Stored blocks whose LEN/NLEN reads straddle the final word.\n    for n in 0..8usize {\n        for ia in 0..4 {\n            let s = deflate_stored(&vec![0x5Au8; n]);\n            for cut in 0..s.len().min(6) {\n                add(\n                    format!(\"stored {n} cut {cut}\"),\n                    s[..s.len() - cut].to_vec(),\n                    64,\n                    ia,\n                );\n            }\n        }\n    }\n\n    // --- random noise ------------------------------------------------------\n    for _ in 0..600 {\n        let n = 1 + rng.below(40) as usize;\n        let s = rng.bytes(n);\n        add(\n            \"noise\".into(),\n            s,\n            rng.below(64) as i32,\n            rng.below(4) as usize,\n        );\n    }\n    v\n}\n\n#[test]\nfn assert_rows_are_reached_and_ndebug_matches_rust() {\n    let p = Pair::new();\n    let cases = corpus();\n    eprintln!(\"assert corpus: {} cases\", cases.len());\n\n    // (1) the NDEBUG C and the Rust must agree on every single one of them\n    let out = run_isolated(cases.len(), |i| {\n        let (name, s, out_bytes, ia) = &cases[i];\n        p.inflate(s, s.len() as i32, *out_bytes, *ia, 0)\n            .map_err(|e| format!(\"[{name}] {e}\"))\n    });\n    let mismatches: Vec<String> = out\n        .iter()\n        .enumerate()\n        .filter_map(|(i, o)| match o {\n            CaseOutcome::Fail(m) if !m.starts_with(common::diff::SKIP) => {\n                Some(format!(\"case {i} ({}): {m}\", cases[i].0))\n            }\n            _ => None,\n        })\n        .collect();\n    assert!(\n        mismatches.is_empty(),\n        \"the NDEBUG C build and the Rust must agree on every input:\\n{}\",\n        mismatches.join(\"\\n\")\n    );\n\n    // (2) collect which assert each input trips in the reference build\n    let ca = c_assert_lib();\n    let mut seen: std::collections::BTreeMap<(String, String), (usize, String)> =\n        std::collections::BTreeMap::new();\n    let mut deaths = 0usize;\n    for (name, s, out_bytes, ia) in &cases {\n        let run = || {\n            let _ = common::diff::probe_inflate(&ca, s, s.len() as i32, *out_bytes, *ia, 0);\n        };\n        let (died, err) = capture_death(&run);\n        if !died {\n            continue;\n        }\n        deaths += 1;\n        if let Some((func, expr)) = assert_site(&err) {\n            let e = seen.entry((func, expr)).or_insert((0, name.clone()));\n            e.0 += 1;\n        }\n    }\n    eprintln!(\"reference build died on {deaths}/{} inputs\", cases.len());\n    for ((func, expr), (n, example)) in &seen {\n        eprintln!(\"  {func}: {expr}   x{n}   e.g. {example}\");\n    }\n\n    // (3) every row of ERRORS.md's assert table must be accounted for\n    let mut unaccounted = Vec::new();\n    for (row, func, expr) in SITES {\n        let hit = seen.keys().any(|(f, e)| f == func && e == expr);\n        if !hit && !UNREACHABLE.contains(&row) {\n            unaccounted.push(format!(\"{row} ({func}: {expr})\"));\n        }\n        if hit && UNREACHABLE.contains(&row) {\n            panic!(\"{row} was documented unreachable but fired ({func}: {expr})\");\n        }\n    }\n    assert!(\n        unaccounted.is_empty(),\n        \"assert rows neither reached by the corpus nor documented unreachable: {unaccounted:?}\\n\\\n         reached: {:?}\",\n        seen.keys().collect::<Vec<_>>()\n    );\n}\n\n/// A9 via the public API: a caller writing a code length >= 16 into\n/// `cp_fixed_table` makes `cp_build` index `counts[len]` past its 16 entries.\n/// The reference build catches that with `assert(len < 16)`; the translation\n/// gives `counts`/`codes`/`first` 256 entries so the same input stays memory\n/// safe instead of smashing the C's stack frame.\n#[test]\nfn a9_code_length_above_fifteen_from_a_mutated_table() {\n    let p = Pair::new();\n    let ca = c_assert_lib();\n    let mut rng = Rng::new(SEED ^ 9);\n    let data = rng.bytes(16);\n    let stream = deflate_fixed_literals(&data);\n\n    let mut fired = 0usize;\n    for len in 16u8..=255 {\n        for l in [&p.c, &p.r, &ca] {\n            unsafe { *l.cp_fixed_table.add(0) = len };\n        }\n        let run = || {\n            let _ = common::diff::probe_inflate(&ca, &stream, stream.len() as i32, 64, 0, 0);\n        };\n        let (died, err) = capture_death(&run);\n        if died {\n            if let Some((func, expr)) = assert_site(&err) {\n                assert_eq!(\n                    (func.as_str(), expr.as_str()),\n                    (\"cp_build\", \"len < 16\"),\n                    \"expected cp_build's assert for length {len}\"\n                );\n                fired += 1;\n            }\n        }\n        // ... and the NDEBUG build's undefined stack aliasing is what the Rust\n        // cannot (and must not) reproduce, so only require the same fate.\n        let out = run_isolated(1, |_| {\n            p.inflate(&stream, stream.len() as i32, 64, 0, 0)\n        });\n        let _ = &out;\n        p.reset();\n        ca.reset_tables();\n    }\n    assert!(\n        fired >= 200,\n        \"cp_build's assert(len < 16) fired only {fired} times out of 240\"\n    );\n}\n\n/// A4: `cp_read_bits(s, n)` with `n > 32`. `n` comes from\n/// `cp_len_extra_bits[symbol]` / `cp_dist_extra_bits[symbol]`, which are\n/// `uint8_t` tables a caller can write any value into.\n#[test]\nfn a4_num_bits_to_read_above_thirty_two() {\n    let p = Pair::new();\n    let ca = c_assert_lib();\n    let mut rng = Rng::new(SEED ^ 4);\n    let data: Vec<u8> = (0..64).map(|k| (k as u8) ^ 0x33).collect();\n    let stream = deflate_fixed_lz(&data);\n    let _ = &mut rng;\n\n    let mut fired = false;\n    for n in [33u8, 40, 63, 64, 65, 128, 200, 255] {\n        for l in [&p.c, &p.r, &ca] {\n            unsafe {\n                for k in 0..31 {\n                    *l.cp_len_extra_bits.add(k) = n;\n                }\n                for k in 0..32 {\n                    *l.cp_dist_extra_bits.add(k) = n;\n                }\n            }\n        }\n        let run = || {\n            let _ = common::diff::probe_inflate(&ca, &stream, stream.len() as i32, 256, 0, 0);\n        };\n        let (died, err) = capture_death(&run);\n        if died {\n            if let Some((func, expr)) = assert_site(&err) {\n                eprintln!(\"n={n}: {func}: {expr}\");\n                if func == \"cp_read_bits\" && expr == \"num_bits_to_read <= 32\" {\n                    fired = true;\n                }\n            }\n        }\n        // The NDEBUG C masks the shift count to 6 bits (x86-64 `shl`), and so\n        // does the translation via `wrapping_shl`.\n        let out = run_isolated(1, |_| {\n            p.inflate(&stream, stream.len() as i32, 256, 0, 0)\n        });\n        expect_no_mismatch(&format!(\"A4 n={n}\"), &out);\n        p.reset();\n        ca.reset_tables();\n    }\n    assert!(fired, \"cp_read_bits' assert(num_bits_to_read <= 32) never fired\");\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
