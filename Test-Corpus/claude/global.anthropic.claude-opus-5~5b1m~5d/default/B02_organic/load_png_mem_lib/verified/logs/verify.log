#[test]\nfn fuzz_load_png_mem_structured_random() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 1);\n    // random IHDR fields + random chunk soup behind a valid signature\n    let mut cases: Vec<Vec<u8>> = Vec::new();\n    let kinds: [&[u8; 4]; 8] = [\n        b\"IHDR\", b\"PLTE\", b\"tRNS\", b\"IDAT\", b\"IEND\", b\"tEXt\", b\"gAMA\", b\"zzzz\",\n    ];\n    for _ in 0..2500 {\n        let mut v = SIG.to_vec();\n        let mut ihdr = Vec::new();\n        ihdr.extend_from_slice(&[0u32, 1, 2, 3, 7, 0xFFFF_FFFF, rng.next_u32()][rng.below(7) as usize].to_be_bytes());\n        ihdr.extend_from_slice(&[0u32, 1, 2, 5, 0xFFFF_FFFF, rng.next_u32()][rng.below(6) as usize].to_be_bytes());\n        ihdr.push([8u8, 1, 2, 4, 16, rng.byte()][rng.below(6) as usize]);\n        ihdr.push([0u8, 2, 3, 4, 6, 1, 5, rng.byte()][rng.below(8) as usize]);\n        ihdr.push([0u8, 1, rng.byte()][rng.below(3) as usize]);\n        ihdr.push([0u8, 1, rng.byte()][rng.below(3) as usize]);\n        ihdr.push([0u8, 1, rng.byte()][rng.below(3) as usize]);\n        v.extend_from_slice(&chunk(b\"IHDR\", &ihdr));\n        for _ in 0..rng.below(6) {\n            let kind = kinds[rng.below(8) as usize];\n            let payload = rng.bytes(rng.below(48) as usize);\n            if rng.below(4) == 0 {\n                let declared = rng.next_u32() & 0xFF;\n                v.extend_from_slice(&chunk_raw_len(kind, declared, &payload));\n            } else {\n                v.extend_from_slice(&chunk(kind, &payload));\n            }\n        }\n        // usually give it something zlib-shaped to chew on\n        if rng.below(3) != 0 {\n            let mut z = vec![\n                [0x78u8, 0x08, 0x18, 0x88, 0xF8, rng.byte()][rng.below(6) as usize],\n                [0x9Cu8, 0x00, 0x20, 0xFF, rng.byte()][rng.below(5) as usize],\n            ];\n            z.extend(rng.bytes(1 + rng.below(60) as usize));\n            v.extend_from_slice(&chunk(b\"IDAT\", &z));\n        }\n        v.extend_from_slice(&chunk(b\"IEND\", &[]));\n        cases.push(v);\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let s = &cases[i];\n        p.png(s, s.len() as i32)\n    });\n    expect_no_mismatch(\"fuzz-png-random\", &out);\n}\n\n#[test]\nfn fuzz_cp_inflate_random_streams() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 2);\n    let mut cases: Vec<(Vec<u8>, i32, i32, usize, usize)> = Vec::new();\n    for _ in 0..4000 {\n        let s = match rng.below(4) {\n            // pure noise\n            0 => rng.bytes_1_upto(64),\n            // noise with a plausible block header\n            1 => {\n                let mut bw = BitWriter::new();\n                bw.bits(rng.below(2), 1);\n                bw.bits(rng.below(4), 2);\n                let mut v = bw.finish();\n                v.extend(rng.bytes_1_upto(48));\n                v\n            }\n            // a valid stream with its tail replaced\n            2 => {\n                let d = rng.bytes_1_upto(32);\n                let mut v = deflate_fixed_lz(&d);\n                let cut = rng.below(v.len() as u32) as usize;\n                v.truncate(cut);\n                v.extend(rng.bytes_upto(16));\n                v\n            }\n            // a dynamic header followed by noise\n            _ => {\n                let d = rng.bytes_1_upto(24);\n                let mut v = deflate_dynamic_literals(&d, rng.bool());\n                for _ in 0..1 + rng.below(4) {\n                    let k = rng.below(v.len() as u32) as usize;\n                    v[k] ^= 1 << rng.below(8);\n                }\n                v\n            }\n        };\n        let in_bytes = match rng.below(6) {\n            0 => s.len() as i32,\n            1 => s.len() as i32,\n            2 => s.len() as i32,\n            3 => rng.below(s.len() as u32 + 1) as i32,\n            4 => -(rng.below(8) as i32),\n            _ => s.len() as i32 + rng.below(4) as i32,\n        };\n        let out_bytes = match rng.below(5) {\n            0 => 0,\n            1 => rng.below(8) as i32,\n            2 => rng.below(256) as i32,\n            3 => -(rng.below(8) as i32),\n            _ => 1024,\n        };\n        cases.push((\n            s,\n            in_bytes,\n            out_bytes,\n            rng.below(4) as usize,\n            rng.below(4) as usize,\n        ));\n    }\n    let out = run_isolated(cases.len(), |i| {\n        let (s, ib, ob, ia, oa) = &cases[i];\n        p.inflate(s, *ib, *ob, *ia, *oa)\n    });\n    expect_no_mismatch(\"fuzz-inflate\", &out);\n}\n\n/// High-volume coverage of `cp_unfilter`/`cp_paeth`: filter 4 on rows >= 1 uses\n/// `cp_paeth(raw[x-bpp], prev[x], prev[x-bpp])`, whose three-way comparison has\n/// branches that a handful of hand-picked images will not all reach.\n#[test]\nfn fuzz_filter_and_paeth() {\n    let p = Pair::new();\n    let mut rng = Rng::new(SEED ^ 3);\n    let mut cases = Vec::new();\n    for _ in 0..1200 {\n        let ct = [0u8, 2, 4, 6][rng.below(4) as usize];\n        let bpp = bpp_of(ct);\n        let w = 1 + rng.below(48) as usize;\n        let h = 1 + rng.below(6) as usize;\n        // bias towards filters 3 and 4, the two that combine three inputs\n        let filters: Vec<u8> = (0..h)\n            .map(|_| [0u8, 1, 2, 3, 4, 3, 4, 4][rng.below(8) as usize])\n            .collect();\n        let raw = raw_image(&mut rng, w, h, bpp, &filters);\n        let png = PngSpec::new(\n            w as u32,\n            h as u32,\n            ct,\n            zlib_default(&deflate_fixed_literals(&raw)),\n        )\n        .build();\n        cases.push(png);\n    }\n    expect_all_pass(\"fuzz-filter\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n\n/// The same, driven so that `cp_paeth`'s inputs sweep systematically rather than\n/// randomly: row 0 holds every byte value, and each later row re-filters it.\n#[test]\nfn paeth_sweeps_every_left_and_above_byte() {\n    let p = Pair::new();\n    let (w, h) = (256usize, 6usize);\n    let mut cases = Vec::new();\n    for step in [1usize, 3, 5, 17, 85, 129, 255] {\n        for f in [3u8, 4] {\n            let mut raw = Vec::new();\n            for y in 0..h {\n                raw.push(if y == 0 { 0 } else { f });\n                for x in 0..w {\n                    raw.push(((x * step + y * 37) % 256) as u8);\n                }\n            }\n            cases.push(\n                PngSpec::new(\n                    w as u32,\n                    h as u32,\n                    0,\n                    zlib_default(&deflate_fixed_literals(&raw)),\n                )\n                .build(),\n            );\n        }\n    }\n    expect_all_pass(\"paeth-sweep\", cases.len(), |i| {\n        p.png(&cases[i], cases[i].len() as i32)\n    });\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
