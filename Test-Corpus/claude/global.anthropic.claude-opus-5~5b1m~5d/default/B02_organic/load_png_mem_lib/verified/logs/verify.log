test]\nfn valid_png_decodes_identically_and_correctly() {\n    let (w, h) = (4usize, 3usize);\n    let mut raw = Vec::new();\n    let mut expect = Vec::new();\n    for y in 0..h {\n        raw.push(0u8);\n        for x in 0..w {\n            let v = (y * 16 + x) as u8;\n            raw.push(v);\n            expect.extend_from_slice(&[v, v, v, 0xFF]);\n        }\n    }\n    let png = PngSpec::new(w as u32, h as u32, 0, zlib_default(&deflate_fixed_literals(&raw)))\n        .build();\n\n    let c = c_lib();\n    let p = common::diff::probe_png(&c, &png, png.len() as i32);\n    assert_eq!((p.w, p.h, p.null), (w as i32, h as i32, false), \"{p:?}\");\n    assert_eq!(p.pix, expect, \"C decoded pixels wrong: {p:?}\");\n\n    let pair = common::diff::Pair::new();\n    pair.png(&png, png.len() as i32).unwrap();\n}\n\n#[test]\nfn all_three_deflate_block_types_round_trip() {\n    let raw: Vec<u8> = (0..16u8).map(|i| i.wrapping_mul(17)).collect();\n    for (name, stream) in [\n        (\"stored\", deflate_stored(&raw)),\n        (\"fixed\", deflate_fixed_literals(&raw)),\n        (\"dynamic\", deflate_dynamic_literals(&raw, false)),\n        (\"dynamic+runs\", deflate_dynamic_literals(&raw, true)),\n        (\"fixed-lz\", deflate_fixed_lz(&[7u8; 40])),\n        (\"dynamic-lz\", deflate_dynamic_lz(&[7u8; 40], true)),\n    ] {\n        let c = c_lib();\n        let want = if name.ends_with(\"lz\") { 40 } else { raw.len() };\n        let p = common::diff::probe_inflate(&c, &stream, stream.len() as i32, want as i32, 0, 0);\n        assert_eq!(p.ret, 1, \"{name}: C rejected its own stream: {p:?}\");\n        let expect: Vec<u8> = if name.ends_with(\"lz\") {\n            vec![7u8; 40]\n        } else {\n            raw.clone()\n        };\n        assert_eq!(&p.out[..want], &expect[..], \"{name}: wrong output {p:?}\");\n        let pair = common::diff::Pair::new();\n        pair.inflate(&stream, stream.len() as i32, want as i32, 0, 0)\n            .unwrap_or_else(|e| panic!(\"{name}: {e}\"));\n    }\n}\n\n/// The fork harness must actually notice a crash and a mismatch.\n#[test]\nfn isolation_detects_crash_and_failure() {\n    let out = run_isolated(4, |i| match i {\n        0 => Ok(()),\n        1 => Err(\"boom\".into()),\n        2 => unsafe {\n            std::ptr::null_mut::<u8>().write(1);\n            Ok(())\n        },\n        _ => Ok(()),\n    });\n    assert_eq!(out[0], CaseOutcome::Pass);\n    assert_eq!(out[1], CaseOutcome::Fail(\"boom\".into()));\n    assert!(matches!(out[2], CaseOutcome::Killed(_)), \"{:?}\", out[2]);\n    assert_eq!(out[3], CaseOutcome::NotRun);\n}\n","structuredPatch":[{"oldStart":92,"oldLines":5,"newStart":92,"newLines":6,"lines":["     assert_eq!(out[0], CaseOutcome::Pass);","     assert_eq!(out[1], CaseOutcome::Fail(\"boom\".into()));","     assert!(matches!(out[2], CaseOutcome::Killed(_)), \"{:?}\", out[2]);","-    assert_eq!(out[3], CaseOutcome::NotRun);","+    // a crash must not hide the cases after it: the batch resumes in a new child","+    assert_eq!(out[3], CaseOutcome::Pass);"," }"]}],"userModified":false,"replaceAll":false}}
