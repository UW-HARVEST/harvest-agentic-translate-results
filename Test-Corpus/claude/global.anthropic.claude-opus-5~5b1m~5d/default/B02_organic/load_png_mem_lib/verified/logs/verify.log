{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_2y3hfzw7l4gsqqnwg7d6753momw4o4vmojqi4juctijj3s6jrgsq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01HGiaxGz78aMg6yE118A9Fe","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-QGr4ci/translation/tests/corpus_coverage.rs","content":"//! Guards against a vacuous Phase B: if the \"valid\" corpus stopped decoding\n//! (e.g. a generator bug made every PNG malformed) the differential tests would\n//! still pass while comparing nothing but error returns. These tests assert the\n//! corpus really does drive the full pipeline.\n\nmod common;\n\nuse common::mk::*;\nuse common::*;\n\n#[test]\nfn the_valid_png_corpus_actually_decodes() {\n    let c = c_lib();\n    let mut rng = Rng::new(1);\n    let mut total = 0usize;\n    let mut ok = 0usize;\n    let mut nontrivial = 0usize;\n    for ct in [0u8, 2, 3, 4, 6] {\n        let bpp = bpp_of(ct);\n        for &(w, h) in &[(1usize, 1usize), (3, 2), (5, 3), (16, 7), (64, 17)] {\n            for e in 0..6 {\n                let filters: Vec<u8> = (0..h).map(|_| rng.byte() % 5).collect();\n                let raw = raw_image(&mut rng, w, h, bpp, &filters);\n                let d = match e {\n                    0 => deflate_stored(&raw),\n                    1 => deflate_fixed_literals(&raw),\n                    2 => deflate_fixed_lz(&raw),\n                    3 => deflate_dynamic_literals(&raw, false),\n                    4 => deflate_dynamic_literals(&raw, true),\n                    _ => deflate_dynamic_lz(&raw, true),\n                };\n                let mut spec = PngSpec::new(w as u32, h as u32, ct, zlib_default(&d));\n                if ct == 3 {\n                    spec.pre_chunks.push(chunk(b\"PLTE\", &rng.bytes(768)));\n                }\n                let png = spec.build();\n                let p = common::diff::probe_png(&c, &png, png.len() as i32);\n                total += 1;\n                if !p.null {\n                    ok += 1;\n                    assert_eq!((p.w, p.h), (w as i32, h as i32), \"{ct} {w}x{h} e={e}\");\n                    assert_eq!(p.pix.len(), w * h * 4);\n                    if p.pix.iter().any(|&b| b != 0) && p.pix.windows(2).any(|s| s[0] != s[1]) {\n                        nontrivial += 1;\n                    }\n                } else {\n                    panic!(\n                        \"corpus PNG rejected by the C: ct={ct} {w}x{h} enc={e} err={:?}\",\n                        p.err\n                    );\n                }\n            }\n        }\n    }\n    assert_eq!(ok, total, \"every corpus PNG must decode\");\n    assert!(\n        nontrivial * 10 >= total * 9,\n        \"only {nontrivial}/{total} decodes produced varied pixel data\"\n    );\n    eprintln!(\"corpus: {ok}/{total} decoded, {nontrivial} with varied pixels\");\n}\n\n#[test]\nfn the_valid_inflate_corpus_actually_inflates() {\n    let c = c_lib();\n    let mut rng = Rng::new(2);\n    let mut ok = 0usize;\n    let mut total = 0usize;\n    for _ in 0..200 {\n        let data = rng.bytes_1_upto(200);\n        for e in 0..6 {\n            let d = match e {\n                0 => deflate_stored(&data),\n                1 => deflate_fixed_literals(&data),\n                2 => deflate_fixed_lz(&data),\n                3 => deflate_dynamic_literals(&data, false),\n                4 => deflate_dynamic_literals(&data, true),\n                _ => deflate_dynamic_lz(&data, true),\n            };\n            let p = common::diff::probe_inflate(&c, &d, d.len() as i32, data.len() as i32, 0, 0);\n            total += 1;\n            if p.ret == 1 && p.out[..data.len()] == data[..] {\n                ok += 1;\n            } else {\n                panic!(\"enc {e} failed to round-trip through the C: {p:?}\");\n            }\n        }\n    }\n    assert_eq!(ok, total);\n    eprintln!(\"inflate corpus: {ok}/{total} round-tripped through the C\");\n}\n\n/// The differential harness must be able to *fail*. A deliberately wrong\n/// \"translation\" (the C library compared against a C library with a patched\n/// table) has to be reported as a mismatch, otherwise a green run means nothing.\n#[test]\nfn the_harness_detects_a_planted_difference() {\n    let a = c_lib();\n    let b = rust_lib();\n    let mut rng = Rng::new(3);\n    let raw = raw_image(&mut rng, 8, 4, 3, &[0, 1, 2, 3]);\n    let png = PngSpec::new(8, 4, 2, zlib_default(&deflate_fixed_literals(&raw))).build();\n\n    // identical to begin with\n    let pa = common::diff::probe_png(&a, &png, png.len() as i32);\n    let pb = common::diff::probe_png(&b, &png, png.len() as i32);\n    assert_eq!(pa, pb, \"baseline must agree\");\n    assert!(!pa.null);\n\n    // now perturb ONE library's exported table and require a difference\n    unsafe { *b.cp_fixed_table.add(0) = 7 };\n    let pb2 = common::diff::probe_png(&b, &png, png.len() as i32);\n    assert_ne!(pa, pb2, \"harness failed to notice a one-byte table change\");\n    b.reset_tables();\n\n    // ... and the same through cp_inflate\n    let stream = deflate_fixed_literals(&raw);\n    let ia = common::diff::probe_inflate(&a, &stream, stream.len() as i32, raw.len() as i32, 0, 0);\n    unsafe { *b.cp_fixed_table.add(0) = 7 };\n    let ib = common::diff::probe_inflate(&b, &stream, stream.len() as i32, raw.len() as i32, 0, 0);\n    assert_ne!(ia, ib, \"harness failed to notice it through cp_inflate\");\n    b.reset_tables();\n    let ib2 = common::diff::probe_inflate(&b, &stream, stream.len() as i32, raw.len() as i32, 0, 0);\n    assert_eq!(ia, ib2, \"reset_tables must restore agreement\");\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":963,"cache_read_input_tokens":240377,"cache_creation":{"ephemeral_5m_input_tokens":963,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent