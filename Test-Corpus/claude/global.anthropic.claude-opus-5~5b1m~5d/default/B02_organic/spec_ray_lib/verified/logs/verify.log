  };\n    ray.p = c2V(r_p_x, r_p_y);\n    ray.d = c2Norm(c2Sub(mp, ray.p));\n    ray.t = c2Dot(mp, ray.d) - c2Dot(ray.p, ray.d);\n\n    let hit: c_int = unsafe {\n        c2CastRay(\n            ray,\n            &c as *const c2Circle as *const c_void,\n            C2_TYPE_CIRCLE,\n            cast,\n        )\n    };\n    hit\n}\n\n/* -------------------------------------------------------------------------- */\n/*                                  helpers                                   */\n/* -------------------------------------------------------------------------- */\n\n/// `sqrtf` from `<math.h>`: a single-precision IEEE-754 square root.\n#[inline(always)]\nfn sqrtf(x: f32) -> f32 {\n    x.sqrt()\n}\n","structuredPatch":[{"oldStart":618,"oldLines":7,"newStart":618,"newLines":10,"lines":["             } else {","                 unsafe {","                     (*out).n = if c > 0.0 { M.x } else { c2Skew(M.y) };","-                    (*out).t = t * A.t;","+                    /* C: out->t = t * A.t;","+                     *   movss 0x20(%rbp)(A.t),%xmm0 ; mulss -0x1c(t),%xmm0","+                     *   -> dst = A.t (the right-hand C operand)             */","+                    (*out).t = fmul(A.t, t);","                 }","                 return 1;","             }"]}],"userModified":false,"replaceAll":false}}
