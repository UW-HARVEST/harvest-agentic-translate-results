: f32,\n    61\t}\n    62\t\n    63\t/// `typedef struct c2Raycast { float t; c2v n; } c2Raycast;`\n    64\t#[repr(C)]\n    65\t#[derive(Copy, Clone, Debug)]\n    66\tpub struct c2Raycast {\n    67\t    pub t: f32,\n    68\t    pub n: c2v,\n    69\t}\n    70\t\n    71\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n    72\t#[repr(C)]\n    73\t#[derive(Copy, Clone, Debug)]\n    74\tpub struct c2Circle {\n    75\t    pub p: c2v,\n    76\t    pub r: f32,\n    77\t}\n    78\t\n    79\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n    80\t#[repr(C)]\n    81\t#[derive(Copy, Clone, Debug)]\n    82\tpub struct c2AABB {\n    83\t    pub min: c2v,\n    84\t    pub max: c2v,\n    85\t}\n    86\t\n    87\t/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n    88\t#[repr(C)]\n    89\t#[derive(Copy, Clone, Debug)]\n    90\tpub struct c2Capsule {\n    91\t    pub a: c2v,\n    92\t    pub b: c2v,\n    93\t    pub r: f32,\n    94\t}\n    95\t\n    96\t/// `typedef struct c2Ray { c2v p; c2v d; float t; } c2Ray;`\n    97\t#[repr(C)]\n    98\t#[derive(Copy, Clone, Debug)]\n    99\tpub struct c2Ray {\n   100\t    pub p: c2v,\n   101\t    pub d: c2v,\n   102\t    pub t: f32,\n   103\t}\n   104\t\n   105\t/// `typedef struct c2m { c2v x; c2v y; } c2m;`\n   106\t#[repr(C)]\n   107\t#[derive(Copy, Clone, Debug)]\n   108\tpub struct c2m {\n   109\t    pub x: c2v,\n   110\t    pub y: c2v,\n   111\t}\n   112\t\n   113\t/* `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;` */\n   114\tpub const C2_TYPE_CIRCLE: c_int = 0;\n   115\tpub const C2_TYPE_AABB: c_int = 1;\n   116\tpub const C2_TYPE_CAPSULE: c_int = 2;\n   117\t\n   118\t/* -------------------------------------------------------------------------- */\n   119\t/*                      C ternary helpers (bit-exact)                         */\n   120\t/* -------------------------------------------------------------------------- */\n   121\t\n   122\t/// `a < b ? a : b`\n   123\t#[inline(always)]\n   124\tfn c_min(a: f32, b: f32) -> f32 {\n   125\t    if a < b {\n   126\t        a\n   127\t    } else {\n   128\t        b\n   129\t    }\n   130\t}\n   131\t\n   132\t/// `a > b ? a : b`\n   133\t#[inline(always)]\n   134\tfn c_max(a: f32, b: f32) -> f32 {\n   135\t    if a > b {\n   136\t        a\n   137\t    } else {\n   138\t        b\n   139\t    }\n   140\t}\n   141\t\n   142\t/// `a < 0 ? -a : a`\n   143\t#[inline(always)]\n   144\tfn c_abs(a: f32) -> f32 {\n   145\t    if a < 0.0 {\n   146\t        -a\n   147\t    } else {\n   148\t        a\n   149\t    }\n   150\t}\n   151\t\n   152\t/* -------------------------------------------------------------------------- */\n   153\t/*                              vector helpers                                */\n   154\t/* -------------------------------------------------------------------------- */\n   155\t\n   156\t#[inline(never)]\n   157\t#[unsafe(no_mangle)]\n   158\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n   159\t    let mut a = c2v { x: 0.0, y: 0.0 };\n   160\t    a.x = x;\n   161\t    a.y = y;\n   162\t    a\n   163\t}\n   164\t\n   165\t#[inline(never)]\n   166\t#[unsafe(no_mangle)]\n   167\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n   168\t    a.x * b.x + a.y * b.y\n   169\t}\n   170\t\n   171\t#[inline(never)]\n   172\t#[unsafe(no_mangle)]\n   173\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n   174\t    sqrtf(c2Dot(a, a))\n   175\t}\n   176\t\n   177\t#[inline(never)]\n   178\t#[unsafe(no_mangle)]\n   179\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n   180\t    a.x += b.x;\n   181\t    a.y += b.y;\n   182\t    a\n   183\t}\n   184\t\n   185\t#[inline(never)]\n   186\t#[unsafe(no_mangle)]\n   187\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n   188\t    a.x -= b.x;\n   189\t    a.y -= b.y;\n   190\t    a\n   191\t}\n   192\t\n   193\t#[inline(never)]\n   194\t#[unsafe(no_mangle)]\n   195\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n   196\t    a.x *= b;\n   197\t    a.y *= b;\n   198\t    a\n   199\t}\n   200\t\n   201\t#[inline(never)]\n   202\t#[unsafe(no_mangle)]\n   203\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n   204\t    c2Mulvs(a, 1.0f32 / b)\n   205\t}\n   206\t\n   207\t#[inline(never)]\n   208\t#[unsafe(no_mangle)]\n   209\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n   210\t    c2Div(a, c2Len(a))\n   211\t}\n   212\t\n   213\t#[inline(never)]\n   214\t#[unsafe(no_mangle)]\n   215\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n   216\t    c2V(c_min(a.x, b.x), c_min(a.y, b.y))\n   217\t}\n   218\t\n   219\t#[inline(never)]\n   220\t#[unsafe(no_mangle)]\n   221\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n   222\t    c2V(c_max(a.x, b.x), c_max(a.y, b.y))\n   223\t}\n   224\t\n   225\t#[inline(never)]\n   226\t#[unsafe(no_mangle)]\n   227\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n   228\t    let mut b = c2v { x: 0.0, y: 0.0 };\n   229\t    b.x = -a.y;\n   230\t    b.y = a.x;\n   231\t    b\n   232\t}\n   233\t\n   234\t#[inline(never)]\n   235\t#[unsafe(no_mangle)]\n   236\tpub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n   237\t    c2V(c_abs(a.x), c_abs(a.y))\n   238\t}\n   239\t\n   240\t#[inline(never)]\n   241\t#[unsafe(no_mangle)]\n   242\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n   243\t    let mut b = c2v { x: 0.0, y: 0.0 };\n   244\t    b.x = a.y;\n   245\t    b.y = -a.x;\n   246\t    b\n   247\t}\n   248\t\n   249\t#[inline(never)]\n   250\t#[unsafe(no_mangle)]\n   251\tpub extern \"C\" fn c2MulmvT(a: c2m, b: c2v) -> c2v {\n   252\t    let mut c = c2v { x: 0.0, y: 0.0 };\n   253\t    c.x = a.x.x * b.x + a.x.y * b.y;\n   254\t    c.y = a.y.x * b.x + a.y.y * b.y;\n   255\t    c\n   256\t}\n   257\t\n   258\t/* -------------------------------------------------------------------------- */\n   259\t/*                                  queries                                   */\n   260\t/* -------------------------------------------------------------------------- */\n   261\t\n   262\t#[inline(never)]\n   263\t#[unsafe(no_mangle)]\n   264\tpub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n   265\t    let p: c2v = B.p;\n   266\t    let m: c2v = c2Sub(A.p, p);\n   267\t    let c: f32 = c2Dot(m, m) - B.r * B.r;\n   268\t    let b: f32 = c2Dot(m, A.d);\n   269\t    let disc: f32 = b * b - c;\n   270\t    if disc < 0.0 {\n   271\t        return 0;\n   272\t    }\n   273\t    let t: f32 = -b - sqrtf(disc);\n   274\t    if t >= 0.0 && t <= A.t {\n   275\t        unsafe {\n   276\t            (*out).t = t;\n   277\t        }\n   278\t        let impact: c2v = c2Add(A.p, c2Mulvs(A.d, t));\n   279\t        unsafe {\n   280\t            (*out).n = c2Norm(c2Sub(impact, p));\n   281\t        }\n   282\t        return 1;\n   283\t    }\n   284\t    0\n   285\t}\n   286\t\n   287\t#[inline(never)]\n   288\t#[unsafe(no_mangle)]\n   289\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n   290\t    let d0: c_int = (B.max.x < A.min.x) as c_int;\n   291\t    let d1: c_int = (A.max.x < B.min.x) as c_int;\n   292\t    let d2: c_int = (B.max.y < A.min.y) as c_int;\n   293\t    let d3: c_int = (A.max.y < B.min.y) as c_int;\n   294\t    /* C: return !(d0 | d1 | d2 | d3); */\n   295\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n   296\t}\n   297\t\n   298\t/// `static inline float c2SignedDistPointToPlane_OneDimensional(float, float, float)`\n   299\t#[inline(always)]\n   300\tfn c2SignedDistPointToPlane_OneDimensional(p: f32, n: f32, d: f32) -> f32 {\n   301\t    p * n - d * n\n   302\t}\n   303\t\n   304\t/// `static inline float c2RayToPlane_OneDimensional(float, float)`\n   305\t#[inline(always)]\n   306\tfn c2RayToPlane_OneDimensional(da: f32, db: f32) -> f32 {\n   307\t    if da < 0.0 {\n   308\t        0.0\n   309\t    } else if da * db > 0.0 {\n   310\t        1.0f32\n   311\t    } else {\n   312\t        let d: f32 = da - db;\n   313\t        if d != 0.0 {\n   314\t            da / d\n   315\t        } else {\n   316\t            0.0\n   317\t        }\n   318\t    }\n   319\t}\n   320\t\n   321\t#[inline(never)]\n   322\t#[unsafe(no_mangle)]\n   323\tpub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n   324\t    let p0: c2v = A.p;\n   325\t    let p1: c2v = c2Add(A.p, c2Mulvs(A.d, A.t));\n   326\t    let mut a_box = c2AABB {\n   327\t        min: c2v { x: 0.0, y: 0.0 },\n   328\t        max: c2v { x: 0.0, y: 0.0 },\n   329\t    };\n   330\t    a_box.min = c2Minv(p0, p1);\n   331\t    a_box.max = c2Maxv(p0, p1);\n   332\t    if c2AABBtoAABB(a_box, B) == 0 {\n   333\t        return 0;\n   334\t    }\n   335\t    let ab: c2v = c2Sub(p1, p0);\n   336\t    let n: c2v = c2Skew(ab);\n   337\t    let abs_n: c2v = c2Absv(n);\n   338\t    let half_extents: c2v = c2Mulvs(c2Sub(B.max, B.min), 0.5f32);\n   339\t    let center_of_b_box: c2v = c2Mulvs(c2Add(B.min, B.max), 0.5f32);\n   340\t    let d: f32 = c_abs(c2Dot(n, c2Sub(p0, center_of_b_box))) - c2Dot(abs_n, half_extents);\n   341\t    if d > 0.0 {\n   342\t        return 0;\n   343\t    }\n   344\t    let da0: f32 = c2SignedDistPointToPlane_OneDimensional(p0.x, -1.0f32, B.min.x);\n   345\t    let db0: f32 = c2SignedDistPointToPlane_OneDimensional(p1.x, -1.0f32, B.min.x);\n   346\t    let da1: f32 = c2SignedDistPointToPlane_OneDimensional(p0.x, 1.0f32, B.max.x);\n   347\t    let db1: f32 = c2SignedDistPointToPlane_OneDimensional(p1.x, 1.0f32, B.max.x);\n   348\t    let da2: f32 = c2SignedDistPointToPlane_OneDimensional(p0.y, -1.0f32, B.min.y);\n   349\t    let db2: f32 = c2SignedDistPointToPlane_OneDimensional(p1.y, -1.0f32, B.min.y);\n   350\t    let da3: f32 = c2SignedDistPointToPlane_OneDimensional(p0.y, 1.0f32, B.max.y);\n   351\t    let db3: f32 = c2SignedDistPointToPlane_OneDimensional(p1.y, 1.0f32, B.max.y);\n   352\t    let mut t0: f32 = c2RayToPlane_OneDimensional(da0, db0);\n   353\t    let mut t1: f32 = c2RayToPlane_OneDimensional(da1, db1);\n   354\t    let mut t2: f32 = c2RayToPlane_OneDimensional(da2, db2);\n   355\t    let mut t3: f32 = c2RayToPlane_OneDimensional(da3, db3);\n   356\t    let hit0: c_int = (t0 <= 1.0f32) as c_int;\n   357\t    let hit1: c_int = (t1 <= 1.0f32) as c_int;\n   358\t    let hit2: c_int = (t2 <= 1.0f32) as c_int;\n   359\t    let hit3: c_int = (t3 <= 1.0f32) as c_int;\n   360\t    let hit: c_int = hit0 | hit1 | hit2 | hit3;\n   361\t    if hit != 0 {\n   362\t        t0 = (hit0 as f32) * t0;\n   363\t        t1 = (hit1 as f32) * t1;\n   364\t        t2 = (hit2 as f32) * t2;\n   365\t        t3 = (hit3 as f32) * t3;\n   366\t        if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n   367\t            unsafe {\n   368\t                (*out).t = t0 * A.t;\n   369\t                (*out).n = c2V(-1.0, 0.0);\n   370\t            }\n   371\t        } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n   372\t            unsafe {\n   373\t                (*out).t = t1 * A.t;\n   374\t                (*out).n = c2V(1.0, 0.0);\n   375\t            }\n   376\t        } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n   377\t            unsafe {\n   378\t                (*out).t = t2 * A.t;\n   379\t                (*out).n = c2V(0.0, -1.0);\n   380\t            }\n   381\t        } else {\n   382\t            unsafe {\n   383\t                (*out).t = t3 * A.t;\n   384\t                (*out).n = c2V(0.0, 1.0);\n   385\t            }\n   386\t        }\n   387\t        1\n   388\t    } else {\n   389\t        0\n   390\t    }\n   391\t}\n   392\t\n   393\t#[inline(never)]\n   394\t#[unsafe(no_mangle)]\n   395\tpub extern \"C\" fn c2AABBtoPoint(A: c2AABB, B: c2v) -> c_int {\n   396\t    let d0: c_int = (B.x < A.min.x) as c_int;\n   397\t    let d1: c_int = (B.y < A.min.y) as c_int;\n   398\t    let d2: c_int = (B.x > A.max.x) as c_int;\n   399\t    let d3: c_int = (B.y > A.max.y) as c_int;\n   400\t    /* C: return !(d0 | d1 | d2 | d3); */\n   401\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n   402\t}\n   403\t\n   404\t#[inline(never)]\n   405\t#[unsafe(no_mangle)]\n   406\tpub extern \"C\" fn c2CircleToPoint(A: c2Circle, B: c2v) -> c_int {\n   407\t    let n: c2v = c2Sub(A.p, B);\n   408\t    let d2: f32 = c2Dot(n, n);\n   409\t    (d2 < A.r * A.r) as c_int\n   410\t}\n   411\t\n   412\t#[inline(never)]\n   413\t#[unsafe(no_mangle)]\n   414\tpub unsafe extern \"C\" fn c2RaytoCapsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n   415\t    let mut M = c2m {\n   416\t        x: c2v { x: 0.0, y: 0.0 },\n   417\t        y: c2v { x: 0.0, y: 0.0 },\n   418\t    };\n   419\t    M.y = c2Norm(c2Sub(B.b, B.a));\n   420\t    M.x = c2CCW90(M.y);\n   421\t    let cap_n: c2v = c2Sub(B.b, B.a);\n   422\t    let yBb: c2v = c2MulmvT(M, cap_n);\n   423\t    let yAp: c2v = c2MulmvT(M, c2Sub(A.p, B.a));\n   424\t    let yAd: c2v = c2MulmvT(M, A.d);\n   425\t    let yAe: c2v = c2Add(yAp, c2Mulvs(yAd, A.t));\n   426\t    let mut capsule_bb = c2AABB {\n   427\t        min: c2v { x: 0.0, y: 0.0 },\n   428\t        max: c2v { x: 0.0, y: 0.0 },\n   429\t    };\n   430\t    capsule_bb.min = c2V(-B.r, 0.0);\n   431\t    capsule_bb.max = c2V(B.r, yBb.y);\n   432\t    unsafe {\n   433\t        (*out).n = c2Norm(cap_n);\n   434\t        (*out).t = 0.0;\n   435\t    }\n   436\t    if c2AABBtoPoint(capsule_bb, yAp) != 0 {\n   437\t        return 1;\n   438\t    } else {\n   439\t        let mut capsule_a = c2Circle {\n   440\t            p: c2v { x: 0.0, y: 0.0 },\n   441\t            r: 0.0,\n   442\t        };\n   443\t        let mut capsule_b = c2Circle {\n   444\t            p: c2v { x: 0.0, y: 0.0 },\n   445\t            r: 0.0,\n   446\t        };\n   447\t        capsule_a.p = B.a;\n   448\t        capsule_a.r = B.r;\n   449\t        capsule_b.p = B.b;\n   450\t        capsule_b.r = B.r;\n   451\t        if c2CircleToPoint(capsule_a, A.p) != 0 {\n   452\t            return 1;\n   453\t        } else if c2CircleToPoint(capsule_b, A.p) != 0 {\n   454\t            return 1;\n   455\t        }\n   456\t    }\n   457\t    if yAe.x * yAp.x < 0.0 || c_min(c_abs(yAe.x), c_abs(yAp.x)) < B.r {\n   458\t        let mut Ca = c2Circle {\n   459\t            p: c2v { x: 0.0, y: 0.0 },\n   460\t            r: 0.0,\n   461\t        };\n   462\t        let mut Cb = c2Circle {\n   463\t            p: c2v { x: 0.0, y: 0.0 },\n   464\t            r: 0.0,\n   465\t        };\n   466\t        Ca.p = B.a;\n   467\t        Ca.r = B.r;\n   468\t        Cb.p = B.b;\n   469\t        Cb.r = B.r;\n   470\t        if c_abs(yAp.x) < B.r {\n   471\t            if yAp.y < 0.0 {\n   472\t                return unsafe { c2RaytoCircle(A, Ca, out) };\n   473\t            } else {\n   474\t                return unsafe { c2RaytoCircle(A, Cb, out) };\n   475\t            }\n   476\t        } else {\n   477\t            let c: f32 = if yAp.x > 0.0 { B.r } else { -B.r };\n   478\t            let d: f32 = yAe.x - yAp.x;\n   479\t            let t: f32 = (c - yAp.x) / d;\n   480\t            let y: f32 = yAp.y + (yAe.y - yAp.y) * t;\n   481\t            if y <= 0.0 {\n   482\t                return unsafe { c2RaytoCircle(A, Ca, out) };\n   483\t            }\n   484\t            if y >= yBb.y {\n   485\t                return unsafe { c2RaytoCircle(A, Cb, out) };\n   486\t            } else {\n   487\t                unsafe {\n   488\t                    (*out).n = if c > 0.0 { M.x } else { c2Skew(M.y) };\n   489\t                    (*out).t = t * A.t;\n   490\t                }\n   491\t                return 1;\n   492\t            }\n   493\t        }\n   494\t    }\n   495\t    0\n   496\t}\n   497\t\n   498\t#[inline(never)]\n   499\t#[unsafe(no_mangle)]\n   500\tpub unsafe extern \"C\" fn c2CastRay(\n   501\t    A: c2Ray,\n   502\t    B: *const c_void,\n   503\t    typeB: c_int,\n   504\t    out: *mut c2Raycast,\n   505\t) -> c_int {\n   506\t    match typeB {\n   507\t        C2_TYPE_CIRCLE => unsafe { c2RaytoCircle(A, *(B as *const c2Circle), out) },\n   508\t        C2_TYPE_AABB => unsafe { c2RaytoAABB(A, *(B as *const c2AABB), out) },\n   509\t        C2_TYPE_CAPSULE => unsafe { c2RaytoCapsule(A, *(B as *const c2Capsule), out) },\n   510\t        /* The C switch has no default case and falls off the end of the\n   511\t         * function (undefined behaviour / indeterminate return value). */\n   512\t        _ => 0,\n   513\t    }\n   514\t}\n   515\t\n   516\t/* -------------------------------------------------------------------------- */\n   517\t/*                              public spec entry                             */\n   518\t/* -------------------------------------------------------------------------- */\n   519\t\n   520\t#[inline(never)]\n   521\t#[unsafe(no_mangle)]\n   522\tpub unsafe extern \"C\" fn spec_ray(\n   523\t    cast: *mut c2Raycast,\n   524\t    mp_x: f32,\n   525\t    mp_y: f32,\n   526\t    c_p_x: f32,\n   527\t    c_p_y: f32,\n   528\t    c_r: f32,\n   529\t    r_p_x: f32,\n   530\t    r_p_y: f32,\n   531\t) -> c_int {\n   532\t    let mp: c2v = c2V(mp_x, mp_y);\n   533\t\n   534\t    let mut c = c2Circle {\n   535\t        p: c2v { x: 0.0, y: 0.0 },\n   536\t        r: 0.0,\n   537\t    };\n   538\t    c.p = c2V(c_p_x, c_p_y);\n   539\t    c.r = c_r;\n   540\t\n   541\t    let mut ray = c2Ray {\n   542\t        p: c2v { x: 0.0, y: 0.0 },\n   543\t        d: c2v { x: 0.0, y: 0.0 },\n   544\t        t: 0.0,\n   545\t    };\n   546\t    ray.p = c2V(r_p_x, r_p_y);\n   547\t    ray.d = c2Norm(c2Sub(mp, ray.p));\n   548\t    ray.t = c2Dot(mp, ray.d) - c2Dot(ray.p, ray.d);\n   549\t\n   550\t    let hit: c_int = unsafe {\n   551\t        c2CastRay(\n   552\t            ray,\n   553\t            &c as *const c2Circle as *const c_void,\n   554\t            C2_TYPE_CIRCLE,\n   555\t            cast,\n   556\t        )\n   557\t    };\n   558\t    hit\n   559\t}\n   560\t\n   561\t/* -------------------------------------------------------------------------- */\n   562\t/*                                  helpers                                   */\n   563\t/* -------------------------------------------------------------------------- */\n   564\t\n   565\t/// `sqrtf` from `<math.h>`: a single-precision IEEE-754 square root.\n   566\t#[inline(always)]\n   567\tfn sqrtf(x: f32) -> f32 {\n   568\t    x.sqrt()\n   569\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"88fe3e95-e99c-4c8e-a206-30b9bab42fd1","uuid":"f1b313c7-a1f4-48be-9d9e-4774b3e4f2ed","timestamp":"2026-09-05T11:36:51.880Z","tool_use_result":{"stdout":"     1\t//! Rust translation of the C library in `c_src/`.\n     2\t//!\n     3\t//! This is a faithful, behaviour-preserving translation of `c_src/src/lib.c`\n     4\t//! (a cut-down version of the `cute_c2` 2D collision routines).  Every\n     5\t//! non-`static` function of the C translation unit is re-exported here with the\n     6\t//! exact same linker symbol name, the exact same C signature and the exact same\n     7\t//! floating point evaluation order so that the resulting `cdylib` is a drop-in\n     8\t//! replacement for the C shared library and produces byte-identical results.\n     9\t//!\n    10\t//! Notes on fidelity:\n    11\t//!  * All arithmetic is performed in `f32` exactly like the C code (no\n    12\t//!    intermediate promotion to `f64`, no reassociation, no use of `fma`).\n    13\t//!  * The C source uses expanded `min`/`max`/`abs` ternaries\n    14\t//!    (`a < b ? a : b`, `a < 0 ? -a : a`).  Those are reproduced with explicit\n    15\t//!    comparisons instead of `f32::min`/`f32::max`/`f32::abs` because the\n    16\t//!    library functions differ from the C ternaries for NaN / signed-zero\n    17\t//!    inputs.\n    18\t//!  * `c2Div` multiplies by the reciprocal (`a * (1.0f / b)`) just like the C\n    19\t//!    code -- this is *not* the same as a division and is preserved verbatim.\n    20\t//!  * Out parameters are written in exactly the same order (and in the same\n    21\t//!    early-return