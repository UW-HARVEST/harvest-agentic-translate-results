p2   */\n    let p1 = fmul(a.x, b.x);\n    let p2 = fmul(b.y, a.y);\n    fadd(p2, p1)\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    sqrtf(c2Dot(a, a))\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n    /* C: a.x += b.x; a.y += b.y;\n     *   movss a.x,%xmm1 ; movss b.x,%xmm0 ; addss %xmm1,%xmm0  -> dst = b.x\n     *   movss a.y,%xmm1 ; movss b.y,%xmm0 ; addss %xmm1,%xmm0  -> dst = b.y  */\n    a.x = fadd(b.x, a.x);\n    a.y = fadd(b.y, a.y);\n    a\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    /* C: a.x -= b.x; a.y -= b.y;   `subss %xmm1,%xmm0` with dst = a.{x,y} */\n    a.x = fsub(a.x, b.x);\n    a.y = fsub(a.y, b.y);\n    a\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    /* C: a.x *= b; a.y *= b;   `mulss -0xc(%rbp),%xmm0` with dst = a.{x,y} */\n    a.x = fmul(a.x, b);\n    a.y = fmul(a.y, b);\n    a\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    /* C: return c2Mulvs(a, 1.0f / b);\n     *   movss 1.0f,%xmm0 ; divss -0xc(%rbp),%xmm0  -> dst = 1.0f, src = b   */\n    c2Mulvs(a, fdiv(1.0f32, b))\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(c_min(a.x, b.x), c_min(a.y, b.y))\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(c_max(a.x, b.x), c_max(a.y, b.y))\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = -a.y;\n    b.y = a.x;\n    b\n}\n\n#[inline(never)]\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n    c2V(c_abs(a.x), c_abs(a.y))\n}\n\n#[inline(never)]