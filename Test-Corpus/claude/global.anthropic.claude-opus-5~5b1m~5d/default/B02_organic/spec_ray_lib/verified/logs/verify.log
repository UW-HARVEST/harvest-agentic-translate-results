-------------------------------- */\n    52\t/*                                   types                                    */\n    53\t/* -------------------------------------------------------------------------- */\n    54\t\n    55\t/// `typedef struct c2v { float x; float y; } c2v;`\n    56\t#[repr(C)]\n    57\t#[derive(Copy, Clone, Debug)]\n    58\tpub struct c2v {\n    59\t    pub x: f32,\n    60\t    pub y: f32,\n    61\t}\n    62\t\n    63\t/// `typedef struct c2Raycast { float t; c2v n; } c2Raycast;`\n    64\t#[repr(C)]\n    65\t#[derive(Copy, Clone, Debug)]\n    66\tpub struct c2Raycast {\n    67\t    pub t: f32,\n    68\t    pub n: c2v,\n    69\t}\n    70\t\n    71\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n    72\t#[repr(C)]\n    73\t#[derive(Copy, Clone, Debug)]\n    74\tpub struct c2Circle {\n    75\t    pub p: c2v,\n    76\t    pub r: f32,\n    77\t}\n    78\t\n    79\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n    80\t#[repr(C)]\n    81\t#[derive(Copy, Clone, Debug)]\n    82\tpub struct c2AABB {\n    83\t    pub min: c2v,\n    84\t    pub max: c2v,\n    85\t}\n    86\t\n    87\t/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n    88\t#[repr(C)]\n    89\t#[derive(Copy, Clone, Debug)]\n    90\tpub struct c2Capsule {\n    91\t    pub a: c2v,\n    92\t    pub b: c2v,\n    93\t    pub r: f32,\n    94\t}\n    95\t\n    96\t/// `typedef struct c2Ray { c2v p; c2v d; float t; } c2Ray;`\n    97\t#[repr(C)]\n    98\t#[derive(Copy, Clone, Debug)]\n    99\tpub struct c2Ray {\n   100\t    pub p: c2v,\n   101\t    pub d: c2v,\n   102\t    pub t: f32,\n   103\t}\n   104\t\n   105\t/// `typedef struct c2m { c2v x; c2v y; } c2m;`\n   106\t#[repr(C)]\n   107\t#[derive(Copy, Clone, Debug)]\n   108\tpub struct c2m {\n   109\t    pub x: c2v,\n   110\t    pub y: c2v,\n   111\t}\n   112\t\n   113\t/* `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;` */\n   114\tpub const C2_TYPE_CIRCLE: c_int = 0