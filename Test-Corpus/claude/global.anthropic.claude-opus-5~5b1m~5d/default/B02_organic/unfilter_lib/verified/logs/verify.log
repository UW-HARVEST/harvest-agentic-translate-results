{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01S22rrXkYwE5d8fz4LsM2zQ","type":"tool_result","content":"130\t];\n131\t\n132\t// Error strings, byte-for-byte identical to the C string literals.\n133\tmacro_rules! cstr {\n134\t    ($s:expr) => {\n135\t        concat!($s, \"\\0\").as_ptr() as *const c_char\n136\t    };\n137\t}\n138\t\n139\tconst ERR_STORED_LEN_NLEN: *const c_char =\n140\t    cstr!(\"Failed to find LEN and NLEN as complements within stored (uncompressed) stream.\");\n141\tconst ERR_STORED_BEYOND: *const c_char = cstr!(\"Stored block extends beyond end of input stream.\");\n142\tconst ERR_OUT_SYMBOL: *const c_char =\n143\t    cstr!(\"Attempted to overwrite out buffer while outputting a symbol.\");\n144\tconst ERR_BACKWARDS: *const c_char =\n145\t    cstr!(\"Attempted to write before out buffer (invalid backwards distance).\");\n146\tconst ERR_OUT_STRING: *const c_char =\n147\t    cstr!(\"Attempted to overwrite out buffer while outputting a string.\");\n148\tconst ERR_UNKNOWN_BLOCK: *const c_char =\n149\t    cstr!(\"Detected unknown block type within input stream.\");\n150\t\n151\t#[inline]\n152\tunsafe fn set_error(msg: *const c_char) {\n153\t    cp_error_reason = msg;\n154\t}\n155\t\n156\t// Helpers that read the (publicly mutable) tables through raw pointers so that\n157\t// external writes to the exported symbols are observed exactly as in C.\n158\t#[inline]\n159\tunsafe fn fixed_table_ptr() -> *mut u8 {\n160\t    (&raw mut cp_fixed_table) as *mut u8\n161\t}\n162\t#[inline]\n163\tunsafe fn permutation_order(i: c_int) -> u8 {\n164\t    *((&raw const cp_permutation_order) as *const u8).wrapping_offset(i as isize)\n165\t}\n166\t#[inline]\n167\tunsafe fn len_extra_bits(i: c_int) -> u8 {\n168\t    *((&raw const cp_len_extra_bits) as *const u8).wrapping_offset(i as isize)\n169\t}\n170\t#[inline]\n171\tunsafe fn len_base(i: c_int) -> u32 {\n172\t    *((&raw const cp_len_base) as *const u32).wrapping_offset(i as isize)\n173\t}\n174\t#[inline]\n175\tunsafe fn dist_extra_bits(i: c_int) -> u8 {\n176\t    *((&raw const cp_dist_extra_bits) as *const u8).wrapping_offset(i as isize)\n177\t}\n178\t#[inline]\n179\tunsafe fn dist_base(i: c_int) -> u32 {\n180\t    *((&raw const cp_dist_base) as *const u32).wrapping_offset(i as isize)\n181\t}\n182\t\n183\t// ---------------------------------------------------------------------------\n184\t// Inflate state\n185\t// ---------------------------------------------------------------------------\n186\t\n187\t#[repr(C)]\n188\tstruct cp_state_t {\n189\t    bits: u64,\n190\t    count: c_int,\n191\t    words: *mut u32,\n192\t    word_count: c_int,\n193\t    word_index: c_int,\n194\t    bits_left: c_int,\n195\t    final_word_available: c_int,\n196\t    final_word: u32,\n197\t    out: *mut c_char,\n198\t    out_end: *mut c_char,\n199\t    begin: *mut c_char,\n200\t    lookup: [u16; 1 << 9],\n201\t    lit: [u32; 288],\n202\t    dst: [u32; 32],\n203\t    len: [u32; 19],\n204\t    nlit: u32,\n205\t    ndst: u32,\n206\t    nlen: u32,\n207\t}\n208\t\n209\t// All of the sub-array pointers are derived from the base of the whole state\n210\t// allocation, so that (in)famous out-of-range accesses such as `tree[lo - 1]`\n211\t// in `cp_decode()` touch the same memory the C code touches.\n212\t#[inline]\n213\tunsafe fn lookup_ptr(s: *mut cp_state_t) -> *mut u16 {\n214\t    (s as *mut u8).wrapping_add(offset_of!(cp_state_t, lookup)) as *mut u16\n215\t}\n216\t#[inline]\n217\tunsafe fn lit_ptr(s: *mut cp_state_t) -> *mut u32 {\n218\t    (s as *mut u8).wrapping_add(offset_of!(cp_state_t, lit)) as *mut u32\n219\t}\n220\t#[inline]\n221\tunsafe fn dst_ptr(s: *mut cp_state_t) -> *mut u32 {\n222\t    (s as *mut u8).wrapping_add(offset_of!(cp_state_t, dst)) as *mut u32\n223\t}\n224\t#[inline]\n225\tunsafe fn len_ptr(s: *mut cp_state_t) -> *mut u32 {\n226\t    (s as *mut u8).wrapping_add(offset_of!(cp_state_t, len)) as *mut u32\n227\t}\n228\t\n229\t/// `static int cp_would_overflow(cp