              );\n                        n += 1;\n                        if n > 24 {\n                            println!(\"  ...\");\n                            break;\n                        }\n                    }\n                }\n                println!(\"  out_off={out_off} in_off={in_off} in_len={}\", stream.len());\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1353,"cache_read_input_tokens":319547,"cache_creation":{"ephemeral_5m_input_tokens":1353,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"28b3a684-8905-4a82-aea2-ff9018e78198","uuid":"e4cbc6c0-8733-454d-8035-a0f3e3bce743","timestamp":"2026-08-27T20:40:27.739Z"}
