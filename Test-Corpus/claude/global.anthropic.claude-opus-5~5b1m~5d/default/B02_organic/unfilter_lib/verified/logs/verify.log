;\n        // Zeroing exactly `HDR_SIZE + scratch_len + 4096` keeps the bytes\n        // *around* the nominal buffers identical for the two libraries, which is\n        // what makes the C code's over-reads comparable.\n        unsafe { std::ptr::write_bytes(self.base, 0, HDR_SIZE + scratch_len + 4096) };\n    }\n    fn hdr(&self) -> *mut Hdr {\n        self.base as *mut Hdr\n    }\n    /// Page-aligned start of the scratch region.\n    fn scratch(&self) -> *mut u8 {\n        unsafe { self.base.add(HDR_SIZE) }\n    }\n}\n\n/// Serialises every `run()`: only one `fork()` at a time, and the scratch\n/// region is single-instance.\nstatic SHM: std::sync::Mutex<Shm> =\n    std::sync::Mutex::new(Shm { base: std::ptr::null_mut(), total: 0, scratch_len: 0 });\n\n'''\ns = s.replace(old, new)\nopen(p,'w').write(s)\nPY\ngrep -n \"static SHM\" tests/common/mod.rs","description":"Replace per-case mmap with one reused region"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4997,"cache_read_input_tokens":416708,"cache_creation":{"ephemeral_5m_input_tokens":4997,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"28b3a684-8905-4a82-aea2-ff9018e78198","uuid":"c6fe9e0a-0c22-4e5c-8841-0361c4f0a7ca","timestamp":"2026-08-27T21:08:21.682Z"}
