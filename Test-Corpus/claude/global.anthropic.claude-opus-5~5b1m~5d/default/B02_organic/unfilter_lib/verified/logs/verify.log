{\n404\t    // `uint8_t lenlens[19] = {0};` - padded so that a corrupted\n405\t    // `cp_permutation_order` cannot trap the translation.\n406\t    let mut lenlens_buf = [0u8; 19 + 256];\n407\t    let lenlens = lenlens_buf.as_mut_ptr();\n408\t\n409\t    let nlit: c_int = 257i32.wrapping_add(cp_read_bits(s, 5) as c_int);\n410\t    let ndst: c_int = 1i32.wrapping_add(cp_read_bits(s, 5) as c_int);\n411\t    let nlen: c_int = 4i32.wrapping_add(cp_read_bits(s, 4) as c_int);\n412\t    let mut i: c_int = 0;\n413\t    while i < nlen {\n414\t        *lenlens.wrapping_offset(permutation_order(i) as isize) = cp_read_bits(s, 3) as u8;\n415\t        i += 1;\n416\t    }\n417\t    (*s).nlen = cp_build(ptr::null_mut(), len_ptr(s), lenlens, 19) as u32;\n418\t\n419\t    // `uint8_t lens[288 + 32];` - uninitialised in C.  A leading slack byte\n420\t    // stands in for the `lens[-1]` read that the `case 16` path can perform\n421\t    // when `n == 0`, and trailing slack absorbs run-length overshoot.\n422\t    let mut lens_buf = [0u8; 8 + 288 + 32 + 512];\n423\t    let lens = lens_buf.as_mut_ptr().wrapping_add(8);\n424\t\n425\t    let mut n: c_int = 0;\n426\t    while n < nlit.wrapping_add(ndst) {\n427\t        let sym = cp_decode(s, len_ptr(s), (*s).nlen as c_int);\n428\t        match sym {\n429\t            16 => {\n430\t                let mut i = 3i32.wrapping_add(cp_read_bits(s, 2) as c_int);\n431\t                while i != 0 {\n432\t                    *lens.wrapping_offset(n as isize) =\n433\t                        *lens.wrapping_offset((n.wrapping_sub(1)) as isize);\n434\t                    i = i.wrapping_sub(1);\n435\t                    n = n.wrapping_add(1);\n436\t                }\n437\t            }\n438\t            17 => {\n439\t                let mut i = 3i32.wrapping_add(cp_read_bits(s, 3) as c_int);\n440\t                while i != 0 {\n441\t                    *lens.wrapping_offset(n as isize) = 0;\n442\t                    i = i.wrapping_sub(1);\n443\t          