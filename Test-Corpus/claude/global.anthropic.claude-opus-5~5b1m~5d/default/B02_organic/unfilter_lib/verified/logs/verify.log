payload);","-                }","-                1 => {","-                    write_fixed_block(&mut w, last, &lits(&payload));","-                    plain.extend_from_slice(&payload);","-                }","-                _ => {","-                    let mut lit_lens = vec![8u8; 257];","-                    lit_lens[255] = 0;","-                    let dst_lens = vec![1u8; 1];","-                    dynamic_block_auto(&mut w, last, &lit_lens, &dst_lens, &{","-                        let p: Vec<u8> = payload.iter().map(|&b| b.min(254)).collect();","-                        plain.extend_from_slice(&p);","-                        lits(&p)","-                    });","-                }","+                0 => write_stored_block(&mut w, last, &payload),","+                1 => write_fixed_block(&mut w, last, &lits(&payload)),","+                _ => dynamic_block_auto(&mut w, last, &dyn_lit, &dyn_dst, &lits(&payload)),","             }","+            plain.extend_from_slice(&payload);","         }","         let s = w.finish();","         cases.push(Case::new("]},{"oldStart":508,"oldLines":16,"newStart":451,"newLines":20,"lines":[" fn row28_input_alignment_and_tail() {","     let mut r = rng(28);","     let (mut cases, mut exp) = (Vec::new(), Vec::new());","+    let mut seen = std::collections::BTreeSet::new();","     for misalign in 0usize..4 {","-        // vary the payload so the stream length hits every residue mod 4","         for extra in 0usize..8 {","             let payload: Vec<u8> = (0..(4 + extra)).map(|_| r.gen::<u8>()).collect();","             let s = fixed_stream(&lits(&payload));","-            let lastb = (s.len() as i64 - misalign as i64).rem_euclid(4);","+            // the harness places `in` at (16-aligned + misalign), so the C code","+            // computes first_bytes = (4 - misalign) % 4","+            let first_bytes = (4 - misalign) % 4;","+            let last_bytes = (s.len() - first_bytes) % 4;","+            seen.insert((first_byte