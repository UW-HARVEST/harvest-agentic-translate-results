er instead of the arena slot.","+    pub null_out: bool,","+}","+","+impl Case {","+    pub fn new(label: impl Into<String>, input: Vec<u8>, out_bytes: i32) -> Case {","+        let in_bytes = input.len() as i32;","+        Case {","+            label: label.into(),","+            input,","+            in_bytes,","+            out_bytes,","+            out_cap: out_bytes.max(0) as usize + 32,","+            misalign: 0,","+            null_in: false,","+            null_out: false,","+        }","     }","-    // 257+13 == 270 .. 272 stay 0 (a 3-long zero run  -> code-length sym 17)","-    v[273] = 15; // the second depth-15 leaf","-                 // 274..287 stay 0 (a 14-long zero run -> code-length sym 18)","-    assert!(is_complete(&v), \"lit_lens_deep is not a complete tree\");","-    v","+    pub fn misaligned(mut self, m: usize) -> Case {","+        self.misalign = m;","+        self","+    }","+    pub fn in_bytes(mut self, n: i32) -> Case {","+        self.in_bytes = n;","+        self","+    }","+    pub fn out_cap(mut self, n: usize) -> Case {","+        self.out_cap = n;","+        self","+    }","+    pub fn null_in(mut self) -> Case {","+        self.null_in = true;","+        self","+    }","+    pub fn null_out(mut self) -> Case {","+        self.null_out = true;","+        self","+    }"," }"," ","-/// A complete distance alphabet whose codes span depths 1..15.","-/// Kraft: sum(2^-l for l in 1..=14) + 2^-15 + 2^-15 == 1.","-pub fn dst_lens_deep() -> Vec<u8> {","-    let mut v: Vec<u8> = (1u8..=14).collect();","-    v.push(15);","-    v.push(15);","-    assert_eq!(v.len(), 16);","-    assert!(is_complete(&v), \"dst_lens_deep is not a complete tree\");","-    v","+#[derive(Clone, Debug, PartialEq, Eq)]","+pub struct CaseResult {","+    /// false => the callee died (signal / non-zero exit) before finishing.","+    pub completed: bool,","+    /// raw `waitpid` status of the child that was running this case (only","+    /// meaningful when `completed =