al to the C string literals.\n   133\tmacro_rules! cstr {\n   134\t    ($s:expr) => {\n   135\t        concat!($s, \"\\0\").as_ptr() as *const c_char\n   136\t    };\n   137\t}\n   138\t\n   139\tconst ERR_STORED_LEN_NLEN: *const c_char =\n   140\t    cstr!(\"Failed to find LEN and NLEN as complements within stored (uncompressed) stream.\");\n   141\tconst ERR_STORED_BEYOND: *const c_char = cstr!(\"Stored block extends beyond end of input stream.\");\n   142\tconst ERR_OUT_SYMBOL: *const c_char =\n   143\t    cstr!(\"Attempted to overwrite out buffer while outputting a symbol.\");\n   144\tconst ERR_BACKWARDS: *const c_char =\n   145\t    cstr!(\"Attempted to write before out buffer (invalid backwards distance).\");\n   146\tconst ERR_OUT_STRING: *const c_char =\n   147\t    cstr!(\"Attempted to overwrite out buffer while outputting a string.\");\n   148\tconst ERR_UNKNOWN_BLOCK: *const c_char =\n   149\t    cstr!(\"Detected unknown block type within input stream.\");\n   150\t\n   151\t#[inline]\n   152\tunsafe fn set_error(msg: *const c_char) {\n   153\t    cp_error_reason = msg;\n   154\t}\n   155\t\n   156\t// Helpers that read the (publicly mutable) tables through raw pointers so that\n   157\t// external writes to the exported symbols are observed exactly as in C.\n   158\t#[inline]\n   159\tunsafe fn fixed_table_ptr() -> *mut u8 {\n   160\t    (&raw mut cp_fixed_table) as *mut u8\n   161\t}\n   162\t#[inline]\n   163\tunsafe fn permutation_order(i: c_int) -> u8 {\n   164\t    *((&raw const cp_permutation_order) as *const u8).wrapping_offset(i as isize)\n   165\t}\n   166\t#[inline]\n   167\tunsafe fn len_extra_bits(i: c_int) -> u8 {\n   168\t    *((&raw const cp_len_extra_bits) as *const u8).wrapping_offset(i as isize)\n   169\t}\n   170\t#[inline]\n   171\tunsafe fn len_base(i: c_int) -> u32 {\n   172\t    *((&raw const cp_len_base) as *const u32).wrapping_offset(i as isize)\n   173\t}\n   174\t#[inline]\n   175\tunsafe fn dist_extra_bits(i: c_int) -> u8 {\n   176\t    *((&raw const cp_dist_extra_bits) as *const u8).wrapping_offset(i as isize)\n   177\t}\n   178\t#[inline]\n   179\tunsafe fn dist_base(i: c_int) -> u32 {\n   180\t    *((&raw const cp_dist_base) as *const u32).wrapping_offset(i as isize)\n   181\t}\n   182\t\n   183\t// ---------------------------------------------------------------------------\n   184\t// Inflate state\n   185\t// ---------------------------------------------------------------------------\n   186\t\n   187\t#[repr(C)]\n   188\tstruct cp_state_t {\n   189\t    bits: u64,\n   190\t    count: c_int,\n   191\t    words: *mut u32,\n   192\t    word_count: c_int,\n   193\t    word_index: c_int,\n   194\t    bits_left: c_int,\n   195\t    final_word_available: c_int,\n   196\t    final_word: u32,\n   197\t    out: *mut c_char,\n   198\t    out_end: *mut c_char,\n   199\t    begin: *mut c_char,\n   200\t    lookup: [u16; 1 << 9],\n   201\t    lit: [u32; 288],\n   202\t    dst: [u32; 32],\n   203\t    len: [u32; 19],\n   204\t    nlit: u32,\n   205\t    ndst: u32,\n   206\t    nlen: u32,\n   207\t}\n   208\t\n   209\t// All of the sub-array pointers are derived from the base of the whole state\n   210\t// allocation, so that (in)famous out-of-range accesses such as `tree[lo - 1]`\n   211\t// in `cp_decode()` touch the same memory the C code touches.\n   212\t#[inline]\n   213\tunsafe fn lookup_ptr(s: *mut cp_state_t) -> *mut u16 {\n   214\t    (s as *mut u8).wrapping_add(offset_of!(cp_state_t, lookup)) as *mut u16\n   215\t}\n   216\t#[inline]\n   217\tunsafe fn lit_ptr(s: *mut cp_state_t) -> *mut u32 {\n   218\t    (s as *mut u8).wrapping_add(offset_of!(cp_state_t, lit)) as *mut u32\n   219\t}\n   220\t#[inline]\n   221\tunsafe fn dst_ptr(s: *mut cp_state_t) -> *mut u32 {\n   222\t    (s as *mut u8).wrapping_add(offset_of!(cp_state_t, dst)) as *mut u32\n   223\t}\n   224\t#[inline]\n   225\tunsafe fn len_ptr(s: *mut cp_state_t) -> *mut u32 {\n   226\t    (s as *mut u8).wrapping_add(offset_of!(cp_state_t, len)) as *mut u32\n   227\t}\n   228\t\n   229\t/// `static int cp_would_overflow(cp_state_t *s, int num_bits)`\n   230\t/// (only referenced from asserts in the C source)\n   231\t#[allow(dead_code)]\n   232\tunsafe fn cp_would_overflow(s: *mut cp_state_t, num_bits: c_int) -> c_int {\n   233\t    (((*s).bits_left.wrapping_add((*s).count)).wrapping_sub(num_bits) < 0) as c_int\n   234\t}\n   235\t\n   236\t/// `static char *cp_ptr(cp_state_t *s)`\n   237\tunsafe fn cp_ptr(s: *mut cp_state_t) -> *mut c_char {\n   238\t    ((*s).words.wrapping_offset((*s).word_index as isize) as *mut c_char)\n   239\t        .wrapping_offset(-(((*s).count / 8) as isize))\n   240\t}\n   241\t\n   242\t/// `static uint64_t cp_peak_bits(cp_state_t *s, int num_bits_to_read)`\n   243\tunsafe fn cp_peak_bits(s: *mut cp_state_t, num_bits_to_read: c_int) -> u64 {\n   244\t    if (*s).count < num_bits_to_read {\n   245\t        if (*s).word_index < (*s).word_count {\n   246\t            let word = ptr::read_unaligned((*s).words.wrapping_offset((*s).word_index as isize));\n   247\t            (*s).word_index = (*s).word_index.wrapping_add(1);\n   248\t            (*s).bits |= (word as u64).wrapping_shl((*s).count as u32);\n   249\t            (*s).count = (*s).count.wrapping_add(32);\n   250\t        } else if (*s).final_word_available != 0 {\n   251\t            let word = (*s).final_word;\n   252\t            (*s).bits |= (word as u64).wrapping_shl((*s).count as u32);\n   253\t            (*s).count = (*s).count.wrapping_add((*s).bits_left);\n   254\t            (*s).final_word_available = 0;\n   255\t        }\n   256\t    }\n   257\t    (*s).bits\n   258\t}\n   259\t\n   260\t/// `static uint32_t cp_consume_bits(cp_state_t *s, int num_bits_to_read)`\n   261\tunsafe fn cp_consume_bits(s: *mut cp_state_t, num_bits_to_read: c_int) -> u32 {\n   262\t    let mask = 1u64\n   263\t        .wrapping_shl(num_bits_to_read as u32)\n   264\t        .wrapping_sub(1);\n   265\t    let bits = ((*s).bits & mask) as u32;\n   266\t    (*s).bits = (*s).bits.wrapping_shr(num_bits_to_read as u32);\n   267\t    (*s).count = (*s).count.wrapping_sub(num_bits_to_read);\n   268\t    (*s).bits_left = (*s).bits_left.wrapping_sub(num_bits_to_read);\n   269\t    bits\n   270\t}\n   271\t\n   272\t/// `static uint32_t cp_read_bits(cp_state_t *s, int num_bits_to_read)`\n   273\tunsafe fn cp_read_bits(s: *mut cp_state_t, num_bits_to_read: c_int) -> u32 {\n   274\t    cp_peak_bits(s, num_bits_to_read);\n   275\t    cp_consume_bits(s, num_bits_to_read)\n   276\t}\n   277\t\n   278\t/// `static uint32_t cp_rev16(uint32_t a)`\n   279\tfn cp_rev16(a: u32) -> u32 {\n   280\t    let mut a = a;\n   281\t    a = ((a & 0xAAAA) >> 1) | ((a & 0x5555) << 1);\n   282\t    a = ((a & 0xCCCC) >> 2) | ((a & 0x3333) << 2);\n   283\t    a = ((a & 0xF0F0) >> 4) | ((a & 0x0F0F) << 4);\n   284\t    a = ((a & 0xFF00) >> 8) | ((a & 0x00FF) << 8);\n   285\t    a\n   286\t}\n   287\t\n   288\t/// `static int cp_build(cp_state_t *s, uint32_t *tree, uint8_t *lens, int sym_count)`\n   289\t///\n   290\t/// The C code declares `codes[16]`, `first[16]`, `counts[16]` and indexes them\n   291\t/// with the code lengths.  Well-formed input keeps every length below 16; the\n   292\t/// tables here are over-sized (and zero filled) purely so that malformed input\n   293\t/// cannot make the translation trap where C would silently scribble on its\n   294\t/// stack frame.\n   295\tunsafe fn cp_build(\n   296\t    s: *mut cp_state_t,\n   297\t    tree: *mut u32,\n   298\t    lens: *const u8,\n   299\t    sym_count: c_int,\n   300\t) -> c_int {\n   301\t    let mut codes = [0i32; 256];\n   302\t    let mut first = [0i32; 256];\n   303\t    let mut counts = [0i32; 256];\n   304\t\n   305\t    let mut n: c_int = 0;\n   306\t    while n < sym_count {\n   307\t        let idx = *lens.wrapping_offset(n as isize) as usize;\n   308\t        counts[idx] = counts[idx].wrapping_add(1);\n   309\t        n += 1;\n   310\t    }\n   311\t    counts[0] = 0;\n   312\t    codes[0] = 0;\n   313\t    first[0] = 0;\n   314\t    n = 1;\n   315\t    while n <= 15 {\n   316\t        let i = n as usize;\n   317\t        codes[i] = (codes[i - 1].wrapping_add(counts[i - 1])) << 1;\n   318\t        first[i] = first[i - 1].wrapping_add(counts[i - 1]);\n   319\t        n += 1;\n   320\t    }\n   321\t    if !s.is_null() {\n   322\t        ptr::write_bytes(lookup_ptr(s), 0, 1 << 9);\n   323\t    }\n   324\t    let mut i: c_int = 0;\n   325\t    while i < sym_count {\n   326\t        let len = *lens.wrapping_offset(i as isize) as c_int;\n   327\t        if len != 0 {\n   328\t            let li = len as usize;\n   329\t            let code = codes[li] as u32;\n   330\t            codes[li] = codes[li].wrapping_add(1);\n   331\t            let slot = first[li] as u32;\n   332\t            first[li] = first[li].wrapping_add(1);\n   333\t            *tree.wrapping_offset(slot as i32 as isize) = code\n   334\t                .wrapping_shl((32i32.wrapping_sub(len)) as u32)\n   335\t                | ((i as u32) << 4)\n   336\t                | (len as u32);\n   337\t            if !s.is_null() && len <= 9 {\n   338\t                let mut j = (cp_rev16(code) >> ((16i32.wrapping_sub(len)) as u32 & 31)) as c_int;\n   339\t                let lut = lookup_ptr(s);\n   340\t                while j < (1 << 9) {\n   341\t                    *lut.wrapping_offset(j as isize) = (((len << 9) | i) as u32) as u16;\n   342\t                    j = j.wrapping_add(1 << (len & 31));\n   343\t                }\n   344\t            }\n   345\t        }\n   346\t        i += 1;\n   347\t    }\n   348\t    first[15]\n   349\t}\n   350\t\n   351\t/// `static int cp_stored(cp_state_t *s)`\n   352\tunsafe fn cp_stored(s: *mut cp_state_t) -> c_int {\n   353\t    cp_read_bits(s, (*s).count & 7);\n   354\t    let LEN = cp_read_bits(s, 16) as u16;\n   355\t    let NLEN = cp_read_bits(s, 16) as u16;\n   356\t    if !(LEN == !NLEN) {\n   357\t        set_error(ERR_STORED_LEN_NLEN);\n   358\t        return 0;\n   359\t    }\n   360\t    if !((*s).bits_left / 8 <= LEN as c_int) {\n   361\t        set_error(ERR_STORED_BEYOND);\n   362\t        return 0;\n   363\t    }\n   364\t    let p = cp_ptr(s);\n   365\t    ptr::copy(p as *const u8, (*s).out as *mut u8, LEN as usize);\n   366\t    (*s).out = (*s).out.wrapping_offset(LEN as isize);\n   367\t    1\n   368\t}\n   369\t\n   370\t/// `static int cp_fixed(cp_state_t *s)`\n   371\tunsafe fn cp_fixed(s: *mut cp_state_t) -> c_int {\n   372\t    (*s).nlit = cp_build(s, lit_ptr(s), fixed_table_ptr(), 288) as u32;\n   373\t    (*s).ndst = cp_build(\n   374\t        ptr::null_mut(),\n   375\t        dst_ptr(s),\n   376\t        fixed_table_ptr().wrapping_add(288),\n   377\t        32,\n   378\t    ) as u32;\n   379\t    1\n   380\t}\n   381\t\n   382\t/// `static int cp_decode(cp_state_t *s, uint32_t *tree, int hi)`\n   383\tunsafe fn cp_decode(s: *mut cp_state_t, tree: *mut u32, hi: c_int) -> c_int {\n   384\t    let bits = cp_peak_bits(s, 16);\n   385\t    let search = (cp_rev16(bits as u32) << 16) | 0xFFFF;\n   386\t    let mut lo: c_int = 0;\n   387\t    let mut hi = hi;\n   388\t    while lo < hi {\n   389\t        let guess = (lo.wrapping_add(hi)) >> 1;\n   390\t        if search < *tree.wrapping_offset(guess as isize) {\n   391\t            hi = guess;\n   392\t        } else {\n   393\t            lo = guess.wrapping_add(1);\n   394\t        }\n   395\t    }\n   396\t    let key = *tree.wrapping_offset((lo.wrapping_sub(1)) as isize);\n   397\t    let _len = 32u32.wrapping_sub(key & 0xF);\n   398\t    let _code = cp_consume_bits(s, (key & 0xF) as c_int);\n   399\t    (((key >> 4) & 0xFFF) as i32) as c_int\n   400\t}\n   401\t\n   402\t/// `static int cp_dynamic(cp_state_t *s)`\n   403\tunsafe fn cp_dynamic(s: *mut cp_state_t) -> c_int {\n   404\t    // `uint8_t lenlens[19] = {0};` - padded so that a corrupted\n   405\t    // `cp_permutation_order` cannot trap the translation.\n   406\t    let mut lenlens_buf = [0u8; 19 + 256];\n   407\t    let lenlens = lenlens_buf.as_mut_ptr();\n   408\t\n   409\t    let nlit: c_int = 257i32.wrapping_add(cp_read_bits(s, 5) as c_int);\n   410\t    let ndst: c_int = 1i32.wrapping_add(cp_read_bits(s, 5) as c_int);\n   411\t    let nlen: c_int = 4i32.wrapping_add(cp_read_bits(s, 4) as c_int);\n   412\t    let mut i: c_int = 0;\n   413\t    while i < nlen {\n   414\t        *lenlens.wrapping_offset(permutation_order(i) as isize) = cp_read_bits(s, 3) as u8;\n   415\t        i += 1;\n   416\t    }\n   417\t    (*s).nlen = cp_build(ptr::null_mut(), len_ptr(s), lenlens, 19) as u32;\n   418\t\n   419\t    // `uint8_t lens[288 + 32];` - uninitialised in C.  A leading slack byte\n   420\t    // stands in for the `lens[-1]` read that the `case 16` path can perform\n   421\t    // when `n == 0`, and trailing slack absorbs run-length overshoot.\n   422\t    let mut lens_buf = [0u8; 8 + 288 + 32 + 512];\n   423\t    let lens = lens_buf.as_mut_ptr().wrapping_add(8);\n   424\t\n   425\t    let mut n: c_int = 0;\n   426\t    while n < nlit.wrapping_add(ndst) {\n   427\t        let sym = cp_decode(s, len_ptr(s), (*s).nlen as c_int);\n   428\t        match sym {\n   429\t            16 => {\n   430\t                let mut i = 3i32.wrapping_add(cp_read_bits(s, 2) as c_int);\n   431\t                while i != 0 {\n   432\t                    *lens.wrapping_offset(n as isize) =\n   433\t                        *lens.wrapping_offset((n.wrapping_sub(1)) as isize);\n   434\t                    i = i.wrapping_sub(1);\n   435\t                    n = n.wrapping_add(1);\n   436\t                }\n   437\t            }\n   438\t            17 => {\n   439\t                let mut i = 3i32.wrapping_add(cp_read_bits(s, 3) as c_int);\n   440\t                while i != 0 {\n   441\t                    *lens.wrapping_offset(n as isize) = 0;\n   442\t                    i = i.wrapping_sub(1);\n   443\t          