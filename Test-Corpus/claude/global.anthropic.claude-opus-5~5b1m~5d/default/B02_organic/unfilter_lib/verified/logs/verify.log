.record(&a, &b, || format!(\"pos={pos} bit={bit} stream={}\", hex(&sv)));","         }","     }","-    println!(\"fuzz03 histogram: {hist:#?}\");","-    for s in &samples {","-        println!(\"  {s}\");","+    rep.finish(\"fuzz04_mutated_valid_streams\");","+}","+","+/// Randomized *structurally valid* dynamic-block headers with randomized code","+/// length vectors - the richest source of `cp_build` / `cp_decode` states.","+#[test]","+fn fuzz05_random_dynamic_headers() {","+    let mut rng = Rng::new(0xF05);","+    let mut rep = Report::new();","+    let t = Tables::default();","+    for i in 0..400 {","+        let nlit = rng.range(257, 288) as usize;","+        let ndst = rng.range(1, 32) as usize;","+        // a random (possibly Kraft-incomplete) length vector","+        let maxlen = rng.range(1, 15) as u8;","+        let lit_lens: Vec<u8> =","+            (0..nlit).map(|_| if rng.below(3) == 0 { rng.range(1, maxlen as i32) as u8 } else { 0 }).collect();","+        let dist_lens: Vec<u8> =","+            (0..ndst).map(|_| if rng.below(2) == 0 { rng.range(1, maxlen as i32) as u8 } else { 0 }).collect();","+        let mut spec = DynSpec::new(lit_lens, dist_lens);","+        spec.cl_mode = rng.pick(&[ClMode::LITERAL, ClMode::R16, ClMode::R17, ClMode::R18, ClMode::ALL]);","+        let mut bw = BitWriter::new();","+        // no symbols: just the header, then whatever the padding decodes to","+        emit_dynamic_header_only(&mut bw, &spec);","+        let mut stream = bw.finish();","+        stream.extend(rng.bytes(rng.below(40) as usize + 8));","+        let (a, b) = run_stream(&stream, rng.pick(&[0i32, 64, 4096]), 0, rng.next_u64());","+        rep.record(&a, &b, || format!(\"#{i} nlit={nlit} ndst={ndst} maxlen={maxlen}\"));","+        let _ = &t;","     }","-    assert_eq!(diverged, 0, \"{diverged} divergences on mutated streams\");","+    rep.finish(\"fuzz05_random_dynamic_headers\");"," }","+","+/// Random `unfilter` arguments, for symmetry (its whole input space is scalars","+/// plus one buffer, so this is a genuine fuzz of the public header's API).","+#[test]","+fn fuzz06_unfilter_random_arguments() {","+    let mut rng = Rng::new(0xF06);","+    let mut divergences = 0usize;","+    for _ in 0..4000 {","+        let w = rng.range(-6, 40);","+        let bpp = rng.range(-6, 10);","+        let h = rng.range(-2, 20);","+        let len = w.wrapping_mul(bpp);","+        let rows = if h > 0 { h as i64 } else { 0 } + 2;","+        let span = (rows * ((len as i64).abs() + 2) + 64) as usize;","+        let pad = span as isize;","+        let total = 2 * span + span;","+        let mut scratch: Vec<u8> = (0..total).map(|_| rng.u8()).collect();","+        // random filter bytes, valid *and* invalid","+        for r in 0..h.max(0) {","+            let off = pad + (r as isize) * (len as isize + 1);","+            if off >= 0 && (off as usize) < total {","+                scratch[off as usize] =","+                    if rng.below(4) == 0 { rng.u8() } else { rng.below(5) as u8 };","+            }","+        }","+        let case = Case::unfilter(scratch, w, h, bpp, pad);","+        let a = run(c_ref(), &case);","+        let b = run(rust_lib(), &case);","+        if a != b {","+            divergences += 1;","+            if divergences < 4 {","+                println!(\"unfilter divergence: {:?}\\n  C={a:?}\\n  R={b:?}\", case.call);","+            }","+        }","+    }","+    assert_eq!(divergences, 0, \"{divergences} unfilter divergences\");","+}"]}],"originalFile":"//! Broad corrupt-input fuzzing of `cp_inflate`.\n//!\n//! `cp_inflate` validates almost nothing, so a corrupt stream can drive the C\n//! code into genuinely undefined behaviour (see the last section of\n//! `ERRORS.md`).  These tests therefore do two jobs:\n//!\n//!  * they check C/Rust parity for every input they generate, and\n//!  * they *classify* the outcomes, so that the classes are visible and the\n//!    reachable `assert()` sites of `ERRORS.md` rows 22..27 are demonstrably\n//!    hit.\n//!\n//! Run with `--nocapture` to see the histogram.\n\nmod common;\n\nuse common::deflate::*;\nuse common::*;\nuse std::collections::BTreeMap;\n\nfn run_stream(stream: &[u8], out_bytes: i32, skew: usize, seed: u64) -> (Outcome, Outcome) {\n    let mut rng = Rng::new(seed);\n    let in_off = 64 + skew;\n    let out_off = (in_off + stream.len() + 128) & !15;\n    let total = out_off + out_bytes.max(0) as usize + 4096;\n    let mut scratch: Vec<u8> = (0..total).map(|_| rng.u8()).collect();\n    scratch[in_off..in_off + stream.len()].copy_from_slice(stream);\n    let case = Case::inflate(scratch, in_off as isize, stream.len() as i32, out_off as isize, out_bytes);\n    (run(c_ref(), &case), run(rust_lib(), &case))\n}\n\nfn classify(o: &Outcome) -> String {\n    match (&o.status, &o.assert_msg) {\n        (Status::Signaled(s), Some(m)) => {\n            // keep only the \"func: Assertion `expr'\" part\n            let short = m.splitn(2, \": \").nth(1).unwrap_or(m);\n            format!(\"sig{s} {short}\")\n        }\n        (Status::Signaled(s), None) => format!(\"sig{s}\"),\n        (Status::Exited(_), _) => match (&o.ret, &o.err) {\n            (1, _) => \"ok\".to_string(),\n            (_, Some(e)) => format!(\"err: {}\", &String::from_utf8_lossy(e)[..20.min(e.len())]),\n            _ => \"ret0\".to_string(),\n        },\n    }\n}\n\n/// Purely random bytes.\n#[test]\nfn fuzz01_random_bytes() {\n    let mut rng = Rng::new(0xF01);\n    let mut hist: BTreeMap<String, usize> = BTreeMap::new();\n    let mut diverged: Vec<String> = vec![];\n    for i in 0..1500 {\n        let n = rng.below(40) as usize + 1;\n        let stream = rng.bytes(n);\n        let out_bytes = rng.pick(&[0i32, 1, 16, 256, 4096]);\n        let skew = rng.below(4) as usize;\n        let (a, b) = run_stream(&stream, out_bytes, skew, rng.next_u64());\n        *hist.entry(classify(&a)).or_default() += 1;\n        if a != b {\n            if diverged.len() < 10 {\n                diverged.push(format!(\n                    \"#{i} n={n} out={out_bytes} skew={skew} stream={}\\n    C={:?}\\n    R={:?}\",\n                    hex(&stream),\n                    a,\n                    b\n                ));\n            } else {\n                diverged.push(String::new());\n            }\n        }\n    }\n    println!(\"fuzz01 histogram: {hist:#?}\");\n    println!(\"fuzz01 divergences: {}\", diverged.len());\n    for d in diverged.iter().filter(|d| !d.is_empty()) {\n        println!(\"  {d}\");\n    }\n    assert!(diverged.is_empty(), \"{} divergences on random bytes\", diverged.len());\n}\n\n/// Truncations of valid streams: the classic \"ran out of input\" family.\n#[test]\nfn fuzz02_truncated_valid_streams() {\n    let mut rng = Rng::new(0xF02);\n    let mut hist: BTreeMap<String, usize> = BTreeMap::new();\n    let mut diverged = 0usize;\n    let mut samples: Vec<String> = vec![];\n    for _ in 0..120 {\n        let n = rng.below(30) as usize + 1;\n        let syms: Vec<Sym> = (0..n).map(|_| Sym::Lit(rng.u8())).collect();\n        let t = Tables::default();\n        for kind in 0..3 {\n            let mut bw = BitWriter::new();\n            match kind {\n                0 => emit_fixed(&mut bw, &syms, true),\n                1 => {\n                    let spec = dyn_spec_for(&syms, 288, 32, &t);\n                    emit_dynamic(&mut bw, &spec, &syms, true, &t)\n                }\n                _ => emit_stored(&mut bw, &rng.bytes(n), true),\n            }\n            let full = bw.finish();\n            for cut in 1..=full.len().min(12) {\n                let s = &full[..full.len() - cut];\n                if s.is_empty() {\n                    continue;\n                }\n                let (a, b) = run_stream(s, 4096, 0, rng.next_u64());\n                *hist.entry(classify(&a)).or_default() += 1;\n                if a != b {\n                    diverged += 1;\n                    if samples.len() < 6 {\n                        samples.push(format!(\n                            \"kind={kind} cut={cut} stream={}\\n    C={a:?}\\n    R={b:?}\",\n                            hex(s)\n                        ));\n                    }\n                }\n            }\n        }\n    }\n    println!(\"fuzz02 histogram: {hist:#?}\");\n    for s in &samples {\n        println!(\"  {s}\");\n    }\n    assert_eq!(diverged, 0, \"{diverged} divergences on truncated streams\");\n}\n\n/// Single-byte mutations of valid streams.\n#[test]\nfn fuzz03_mutated_valid_streams() {\n    let mut rng = Rng::new(0xF03);\n    let mut hist: BTreeMap<String, usize> = BTreeMap::new();\n    let mut diverged = 0usize;\n    let mut samples: Vec<String> = vec![];\n    let t = Tables::default();\n    for _ in 0..400 {\n        let n = rng.below(30) as usize + 1;\n        let syms: Vec<Sym> = (0..n).map(|_| Sym::Lit(rng.u8())).collect();\n        let mut bw = BitWriter::new();\n        match rng.below(3) {\n            0 => emit_fixed(&mut bw, &syms, true),\n            1 => {\n                let spec = dyn_spec_for(&syms, 288, 32, &t);\n                emit_dynamic(&mut bw, &spec, &syms, true, &t)\n            }\n            _ => {\n                let d = rng.bytes(n);\n                emit_stored(&mut bw, &d, true)\n            }\n        }\n        let full = bw.finish();\n        for _ in 0..4 {\n            let mut s = full.clone();\n            let pos = rng.below(s.len() as u32) as usize;\n            s[pos] ^= 1 << rng.below(8);\n            let (a, b) = run_stream(&s, 4096, rng.below(4) as usize, rng.next_u64());\n            *hist.entry(classify(&a)).or_default() += 1;\n            if a != b {\n                diverged += 1;\n                if samples.len() < 6 {\n                    samples.push(format!(\"pos={pos} stream={}\\n    C={a:?}\\n    R={b:?}\", hex(&s)));\n                }\n            }\n        }\n    }\n    println!(\"fuzz03 histogram: {hist:#?}\");\n    for s in &samples {\n        println!(\"  {s}\");\n    }\n    assert_eq!(diverged, 0, \"{diverged} divergences on mutated streams\");\n}\n","userModified":false}}
