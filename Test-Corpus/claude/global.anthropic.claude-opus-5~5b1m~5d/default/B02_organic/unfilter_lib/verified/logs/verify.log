k() {","     let mut r = rng(30);","     let (mut cases, mut exp) = (Vec::new(), Vec::new());","-    for _ in 0..40 {","+    for _ in 0..30 {","         let n = r.gen_range(1..=200usize);","         let payload: Vec<u8> = (0..n).map(|_| r.gen::<u8>()).collect();","         for s in [deflate_raw(&payload, 9), fixed_stream(&lits(&payload))] {","             for slack in [0usize, 1, 7, n] {","                 let ob = (n + slack) as i32;","-                cases.push(Case::new(format!(\"slack={slack} n={n}\"), s.clone(), ob).out_cap(","-                    ob as usize + 32,","-                ));","+                cases.push(","+                    Case::new(format!(\"slack={slack} n={n}\"), s.clone(), ob)","+                        .out_cap(ob as usize + 32),","+                );","                 exp.push(payload.clone());","             }","         }"]},{"oldStart":627,"oldLines":15,"newStart":567,"newLines":13,"lines":["     for n in [1usize, 2, 3, 259, 4096, 64 * 1024] {","         let payload = vec![0x5Au8; n];","         for level in [1u32, 9] {","-            let s = deflate_raw(&payload, level);","             cases.push(Case::new(","                 format!(\"run n={n} level={level}\"),","-                s,","+                deflate_raw(&payload, level),","                 n as i32,","             ));","             exp.push(payload.clone());","         }","-        // and a hand-built chain of 258-long dist-1 matches","         if n >= 259 {","             let mut items = vec![Item::Lit(0x5A)];","             let mut have = 1usize;"]},{"oldStart":692,"oldLines":8,"newStart":630,"newLines":11,"lines":[" #[test]"," fn row34_inflate_then_unfilter_pipeline() {","     let mut r = rng(34);","+    let mut cases = Vec::new();","+    let mut plains = Vec::new();","+    let mut geom = Vec::new();","     for _ in 0..40 {","-        let bpp = *[1i32, 2, 3, 4].iter().nth(r.gen_range(0..4)).unwrap();","+        let bpp = [1i32, 2, 3, 4][r.gen_range(0..4)];","         let w = r.gen_range(1..=64i32);","         let h = r.gen_range(1..=16i32);","         let stride = 1 + (w * bpp) as usize;"]},{"oldStart":701,"oldLines":20,"newStart":642,"newLines":21,"lines":["         for y in 0..h as usize {","             filtered[y * stride] = r.gen_range(0..=4u8);","         }","-        let s = deflate_raw(&filtered, 9);","-        let case = Case::new(","+        cases.push(Case::new(","             format!(\"png w={w} h={h} bpp={bpp}\"),","-            s,","+            deflate_raw(&filtered, 9),","             filtered.len() as i32,","-        );","-        let cases = vec![case];","-        let rep = diff_inflate_batch(rel(), &cases);","-        rep.assert_all_decoded(&cases, &[filtered.clone()]);","-        // second stage: unfilter the *inflated* bytes on both sides","-        let inflated = &rep.c[0].out[..filtered.len()];","-        assert_eq!(inflated, &filtered[..]);","+        ));","+        plains.push(filtered);","+        geom.push((w, h, bpp));","+    }","+    let rep = run(cases.clone(), plains.clone());","+    // second stage: unfilter the *inflated* bytes on both sides","+    for (i, &(w, h, bpp)) in geom.iter().enumerate() {","+        let inflated = &rep.c[i].out[..plains[i].len()];","+        assert_eq!(inflated, &plains[i][..]);","         diff_unfilter(","-            rel(),","+            pair_release(),","             &format!(\"pipeline w={w} h={h} bpp={bpp}\"),","             w,","             h,"]}],"originalFile":"//! Phase B — valid-path differential tests for `cp_inflate`.\n//!\n//! One test per row of `CONFIGS.md` §`cp_inflate` (rows 16..34).  Every case is\n//! run through both `.so`s' exported `cp_inflate` in a forked child, and the\n//! return value, the *whole* output buffer and `cp_error_reason` are compared.\n//! Happy-path rows additionally assert that the decode really succeeded and\n//! produced the expected plaintext, so \"both sides fail identically\" can never\n//! masquerade as a pass.\n\nmod common;\n\nuse common::*;\nuse rand::rngs::StdRng;\nuse rand::{Rng, SeedableRng};\n\nconst SEED: u64 = 0x5EED_1234;\n\nfn rng(row: u64) -> StdRng {\n    StdRng::seed_from_u64(SEED ^ (row << 40) ^ 0xA5A5)\n}\n\n/// The C library the translation targets (`NDEBUG`).  Rows that provably never\n/// trip an `assert()` are also checked against the assert-enabled build.\nfn rel() -> &'static Pair {\n    pair_release()\n}\n\nfn run(cases: Vec<Case>, expected: Vec<Vec<u8>>) -> BatchReport {\n    assert_eq!(cases.len(), expected.len());\n    let rep = diff_inflate_batch(rel(), &cases);\n    rep.assert_all_decoded(&cases, &expected);\n    // The assert-enabled C build must agree too on these valid streams.\n    let rep2 = diff_inflate_batch(pair_asserts(), &cases);\n    rep2.assert_all_decoded(&cases, &expected);\n    rep\n}\n\nfn fixed_stream(items: &[Item]) -> Vec<u8> {\n    let mut w = BitWriter::new();\n    write_fixed_block(&mut w, true, items);\n    w.finish()\n}\n\nfn lits(data: &[u8]) -> Vec<Item> {\n    data.iter().map(|&b| Item::Lit(b)).collect()\n}\n\n// ---------------------------------------------------------------------- row 16\n#[test]\nfn row16_stored_block() {\n    let mut r = rng(16);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for _ in 0..120 {\n        let n = r.gen_range(1..=200);\n        let payload: Vec<u8> = (0..n).map(|_| r.gen::<u8>()).collect();\n        let mut w = BitWriter::new();\n        write_stored_block(&mut w, true, &payload);\n        let s = w.finish();\n        cases.push(Case::new(format!(\"stored n={n}\"), s, payload.len() as i32));\n        exp.push(payload);\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 17\n#[test]\nfn row17_stored_block_len_zero() {\n    let mut w = BitWriter::new();\n    write_stored_block(&mut w, true, &[]);\n    let s = w.finish();\n    let cases = vec![Case::new(\"stored LEN=0\", s.clone(), 0).out_cap(32)];\n    run(cases, vec![vec![]]);\n}\n\n// ---------------------------------------------------------------------- row 18\n#[test]\nfn row18_fixed_literals_only() {\n    let mut r = rng(18);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    // every byte value at least once\n    let all: Vec<u8> = (0..=255u8).collect();\n    cases.push(Case::new(\n        \"fixed all-256-literals\",\n        fixed_stream(&lits(&all)),\n        256,\n    ));\n    exp.push(all);\n    for _ in 0..150 {\n        let n = r.gen_range(1..=300);\n        let payload: Vec<u8> = (0..n).map(|_| r.gen::<u8>()).collect();\n        cases.push(Case::new(\n            format!(\"fixed lits n={n}\"),\n            fixed_stream(&lits(&payload)),\n            payload.len() as i32,\n        ));\n        exp.push(payload);\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 19\n// distance == 1 -> the memset() fast path, exhaustive over every length.\n#[test]\nfn row19_distance_one_memset_path() {\n    let mut r = rng(19);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for length in 3u32..=258 {\n        let seed_byte = r.gen::<u8>();\n        let items = vec![Item::Lit(seed_byte), Item::Match(length, 1)];\n        let plain = expand(&items, &[]);\n        cases.push(Case::new(\n            format!(\"dist=1 len={length}\"),\n            fixed_stream(&items),\n            plain.len() as i32,\n        ));\n        exp.push(plain);\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 20\n// distance 2..64 -> the byte-at-a-time (possibly overlapping) copy.\n#[test]\nfn row20_distance_byte_copy_path() {\n    let mut r = rng(20);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for dist in 2u32..=64 {\n        for _ in 0..4 {\n            let length = r.gen_range(3u32..=258);\n            let seed: Vec<u8> = (0..dist).map(|_| r.gen::<u8>()).collect();\n            let mut items = lits(&seed);\n            items.push(Item::Match(length, dist));\n            let plain = expand(&items, &[]);\n            cases.push(Case::new(\n                format!(\"dist={dist} len={length}\"),\n                fixed_stream(&items),\n                plain.len() as i32,\n            ));\n            exp.push(plain);\n        }\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 21\n// every cp_len_extra_bits class, exhaustive over the 29 length symbols.\n#[test]\nfn row21_all_length_symbols() {\n    let mut r = rng(21);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for ls in 0usize..29 {\n        let nextra = LEN_EXTRA[ls];\n        let variants: Vec<u32> = if nextra == 0 {\n            vec![LEN_BASE[ls]]\n        } else {\n            vec![\n                LEN_BASE[ls],\n                LEN_BASE[ls] + (1 << nextra) - 1,\n                LEN_BASE[ls] + r.gen_range(0..(1u32 << nextra)),\n            ]\n        };\n        for length in variants {\n            let dist = 300u32.min(length.max(3));\n            let seed: Vec<u8> = (0..dist).map(|_| r.gen::<u8>()).collect();\n            let mut items = lits(&seed);\n            items.push(Item::Match(length, dist));\n            let plain = expand(&items, &[]);\n            cases.push(Case::new(\n                format!(\"lensym={ls} len={length} dist={dist}\"),\n                fixed_stream(&items),\n                plain.len() as i32,\n            ));\n            exp.push(plain);\n        }\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 22\n// every cp_dist_extra_bits class, exhaustive over the 30 distance symbols.\n#[test]\nfn row22_all_distance_symbols() {\n    let mut r = rng(22);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for ds in 0usize..30 {\n        let nextra = DIST_EXTRA[ds];\n        let variants: Vec<u32> = if nextra == 0 {\n            vec![DIST_BASE[ds]]\n        } else {\n            vec![\n                DIST_BASE[ds],\n                DIST_BASE[ds] + (1 << nextra) - 1,\n                DIST_BASE[ds] + r.gen_range(0..(1u32 << nextra)),\n            ]\n        };\n        for dist in variants {\n            // a run of literals long enough that `dist` is legal\n            let seed: Vec<u8> = (0..dist).map(|_| r.gen::<u8>()).collect();\n            let length = r.gen_range(3u32..=258);\n            let mut items = lits(&seed);\n            items.push(Item::Match(length, dist));\n            let plain = expand(&items, &[]);\n            let n = plain.len() as i32;\n            cases.push(Case::new(\n                format!(\"distsym={ds} dist={dist} len={length}\"),\n                fixed_stream(&items),\n                n,\n            ));\n            exp.push(plain);\n        }\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 23\n// literals >= 144 only -> the 9-bit half of the fixed table.\n#[test]\nfn row23_fixed_nine_bit_literals() {\n    let mut r = rng(23);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for _ in 0..60 {\n        let n = r.gen_range(1..=200);\n        let payload: Vec<u8> = (0..n).map(|_| r.gen_range(144..=255u8)).collect();\n        cases.push(Case::new(\n            format!(\"fixed 9-bit lits n={n}\"),\n            fixed_stream(&lits(&payload)),\n            payload.len() as i32,\n        ));\n        exp.push(payload);\n    }\n    // and the 8-bit tail symbols 280..287 are only reachable as length codes\n    // 280-257=23 .. 287-257=30; 23..28 are real lengths.\n    for ls in 23usize..=28 {\n        let length = LEN_BASE[ls];\n        let seed: Vec<u8> = (0..length.max(3)).map(|_| r.gen::<u8>()).collect();\n        let mut items = lits(&seed);\n        items.push(Item::Match(length, seed.len() as u32));\n        let plain = expand(&items, &[]);\n        cases.push(Case::new(\n            format!(\"fixed litsym={} (len {length})\", 257 + ls),\n            fixed_stream(&items),\n            plain.len() as i32,\n        ));\n        exp.push(plain);\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 24\n// real dynamic-Huffman streams from miniz.\n#[test]\nfn row24_dynamic_real_streams() {\n    let mut r = rng(24);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for _ in 0..80 {\n        let n = r.gen_range(1..=4096);\n        // mix of random and repetitive so miniz emits matches and deep trees\n        let payload: Vec<u8> = (0..n)\n            .map(|i| {\n                if r.gen_bool(0.5) {\n                    r.gen::<u8>()\n                } else {\n                    b\"abcdefghij\"[(i % 10) as usize]\n                }\n            })\n            .collect();\n        let s = deflate_raw(&payload, 9);\n        cases.push(Case::new(\n            format!(\"miniz-9 n={n} ({} bytes)\", s.len()),\n            s,\n            payload.len() as i32,\n        ));\n        exp.push(payload);\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 25\n// hand-built dynamic header at the minimum extremes.\n#[test]\nfn row25_dynamic_header_minimum() {\n    let mut r = rng(25);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n\n    // HLIT == 257, HDIST == 1, HCLEN == 4.\n    // With HCLEN == 4 only code-length symbols {16,17,18,0} have declared\n    // lengths, so the code-length alphabet must be built out of those four.\n    // 18 (zero run) + 0 (a literal zero) + one real length is enough if we can\n    // also express the non-zero lengths -- we cannot, so instead we use\n    // HCLEN == 4 with a complete 2-bit tree over {16,17,18,0} and encode a\n    // literal table where every length is 0 except... which is impossible.\n    // => HCLEN == 4 can only describe an all-zero table, which the C code\n    // happily \"builds\" (nlit == 0) and then decodes garbage from, so the\n    // minimum *useful* header is HCLEN == 5 (adds symbol 8).  Both are\n    // exercised: the useful one here, the degenerate one in Phase C.\n    //\n    // HCLEN == 5 => order[0..5] = {16,17,18,0,8}: 8-bit codes for everything.\n    let hlit = 257usize;\n    let hdist = 1usize;\n    let mut lit_lens = vec![0u8; hlit];\n    for i in 0..256 {\n        lit_lens[i] = 8;\n    }\n    lit_lens[256] = 8; // 257 symbols of 8 bits = 257 leaves > 256: incomplete\n                       // => make 256 (EOB) 8 bits and drop literal 255\n    lit_lens[255] = 0;\n    let dst_lens = vec![1u8; hdist]; // single distance symbol, 1-bit code\n\n    let mut clen_lens = [0u8; 19];\n    clen_lens[16] = 2;\n    clen_lens[17] = 2;\n    clen_lens[18] = 2;\n    clen_lens[0] = 3;\n    clen_lens[8] = 3;\n    let clen_items = rle_code_lengths(\n        &lit_lens\n            .iter()\n            .chain(dst_lens.iter())\n            .copied()\n            .collect::<Vec<u8>>(),\n    );\n    let enc = HuffEnc::new(lit_lens.clone(), dst_lens.clone());\n\n    for _ in 0..20 {\n        let n = r.gen_range(1..=64);\n        let payload: Vec<u8> = (0..n).map(|_| r.gen_range(0..=254u8)).collect();\n        let mut w = BitWriter::new();\n        write_dynamic_block(\n            &mut w,\n            true,\n            hlit,\n            hdist,\n            5,\n            &clen_lens,\n            &clen_items,\n            &enc,\n            &lits(&payload),\n        );\n        let s = w.finish();\n        cases.push(Case::new(\n            format!(\"dyn HLIT=257 HDIST=1 HCLEN=5 n={n}\"),\n            s,\n            payload.len() as i32,\n        ));\n        exp.push(payload);\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 26\n// hand-built dynamic header at the maximum extremes, using 16/17/18.\n#[test]\nfn row26_dynamic_header_maximum() {\n    let mut r = rng(26);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    let hlit = 288usize;\n    let hdist = 32usize;\n\n    // A complete 9-bit tree over 288 symbols needs 512 leaves; use lengths\n    // 9 for 224 symbols and 10 for 64 -> 224/512 + 64/1024 ... simpler: build\n    // a length vector and repair it with the Kraft fixer.\n    let mut lit_lens = vec![9u8; hlit];\n    // deliberately create runs so the RLE uses 16 (copy previous 3..6)\n    for i in 200..260 {\n        lit_lens[i] = 0; // long zero run -> symbol 18\n    }\n    lit_lens[256] = 9; // EOB must exist\n    let mut dst_lens = vec![5u8; hdist];\n    for i in 20..32 {\n        dst_lens[i] = 0;\n    }\n    fix_kraft_pub(&mut lit_lens);\n    fix_kraft_pub(&mut dst_lens);\n    assert!(lit_lens[256] > 0, \"EOB must be codeable\");\n\n    let all: Vec<u8> = lit_lens.iter().chain(dst_lens.iter()).copied().collect();\n    let clen_items = rle_code_lengths(&all);\n    let used: Vec<usize> = {\n        let mut u = std::collections::BTreeSet::new();\n        for &(s, _) in &clen_items {\n            u.insert(s);\n        }\n        u.into_iter().collect()\n    };\n    assert!(\n        used.contains(&18) && used.contains(&16),\n        \"row 26 must exercise code-length symbols 16 and 18, got {used:?}\"\n    );\n    // complete 5-bit tree over all 19 code-length symbols is impossible (19\n    // != 32), so build 19 lengths and repair with Kraft.\n    let mut clen_lens_v = vec![5u8; 19];\n    fix_kraft_pub(&mut clen_lens_v);\n    let mut clen_lens = [0u8; 19];\n    clen_lens.copy_from_slice(&clen_lens_v);\n\n    let enc = HuffEnc::new(lit_lens.clone(), dst_lens.clone());\n    let codeable: Vec<u8> = (0..=255u8).filter(|&b| lit_lens[b as usize] > 0).collect();\n    for _ in 0..20 {\n        let n = r.gen_range(1..=80);\n        let payload: Vec<u8> = (0..n)\n            .map(|_| codeable[r.gen_range(0..codeable.len())])\n            .collect();\n        let mut w = BitWriter::new();\n        write_dynamic_block(\n            &mut w,\n            true,\n            hlit,\n            hdist,\n            19,\n            &clen_lens,\n            &clen_items,\n            &enc,\n            &lits(&payload),\n        );\n        let s = w.finish();\n        cases.push(Case::new(\n            format!(\"dyn HLIT=288 HDIST=32 HCLEN=19 n={n}\"),\n            s,\n            payload.len() as i32,\n        ));\n        exp.push(payload);\n    }\n    run(cases, exp);\n}\n\n/// Re-export of the Kraft repair used by `common` (kept here to avoid making it\n/// part of the harness API).\nfn fix_kraft_pub(lens: &mut Vec<u8>) {\n    if lens.len() == 1 {\n        lens[0] = 1;\n        return;\n    }\n    let maxl = 15u32;\n    loop {\n        let denom = 1u64 << maxl;\n        let sum: u64 = lens.iter().map(|&l| if l == 0 { 0 } else { denom >> l }).sum();\n        if sum == denom {\n            return;\n        }\n        if sum < denom {\n            let i = lens.iter().rposition(|&l| l > 1).unwrap();\n            lens[i] -= 1;\n        } else {\n            let i = lens.iter().rposition(|&l| l > 0 && l < 15).unwrap();\n            lens[i] += 1;\n        }\n    }\n}\n\n// ---------------------------------------------------------------------- row 27\n// BFINAL chains of 2..5 blocks mixing BTYPE 1 and 2, optionally ending in a\n// stored block (a stored block can only be last: cp_stored rejects any stream\n// where more than LEN bytes of input remain -- ERRORS.md row 4).\n#[test]\nfn row27_multi_block_chains() {\n    let mut r = rng(27);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for _ in 0..60 {\n        let nblocks = r.gen_range(2..=5);\n        let mut w = BitWriter::new();\n        let mut plain: Vec<u8> = Vec::new();\n        let mut kinds = Vec::new();\n        for b in 0..nblocks {\n            let last = b == nblocks - 1;\n            let n = r.gen_range(1..=64);\n            let payload: Vec<u8> = (0..n).map(|_| r.gen::<u8>()).collect();\n            let kind = if last {\n                r.gen_range(0..3)\n            } else {\n                1 + r.gen_range(0..2)\n            };\n            kinds.push(kind);\n            match kind {\n                0 => {\n                    write_stored_block(&mut w, last, &payload);\n                    plain.extend_from_slice(&payload);\n                }\n                1 => {\n                    write_fixed_block(&mut w, last, &lits(&payload));\n                    plain.extend_from_slice(&payload);\n                }\n                _ => {\n                    let mut lit_lens = vec![8u8; 257];\n                    lit_lens[255] = 0;\n                    let dst_lens = vec![1u8; 1];\n                    dynamic_block_auto(&mut w, last, &lit_lens, &dst_lens, &{\n                        let p: Vec<u8> = payload.iter().map(|&b| b.min(254)).collect();\n                        plain.extend_from_slice(&p);\n                        lits(&p)\n                    });\n                }\n            }\n        }\n        let s = w.finish();\n        cases.push(Case::new(\n            format!(\"chain {kinds:?} ({} bytes)\", s.len()),\n            s,\n            plain.len() as i32,\n        ));\n        exp.push(plain);\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 28\n// all 16 (first_bytes, last_bytes) alignment/tail combinations, exhaustive.\n#[test]\nfn row28_input_alignment_and_tail() {\n    let mut r = rng(28);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for misalign in 0usize..4 {\n        // vary the payload so the stream length hits every residue mod 4\n        for extra in 0usize..8 {\n            let payload: Vec<u8> = (0..(4 + extra)).map(|_| r.gen::<u8>()).collect();\n            let s = fixed_stream(&lits(&payload));\n            let lastb = (s.len() as i64 - misalign as i64).rem_euclid(4);\n            cases.push(\n                Case::new(\n                    format!(\n                        \"align misalign={misalign} inlen={} last_bytes={lastb}\",\n                        s.len()\n                    ),\n                    s,\n                    payload.len() as i32,\n                )\n                .misaligned(misalign),\n            );\n            exp.push(payload);\n        }\n    }\n    let rep = run(cases.clone(), exp);\n    // prove we really covered all 16 combinations\n    let mut seen = std::collections::BTreeSet::new();\n    for c in &cases {\n        let fb = (4 - c.misalign % 4) % 4; // first_bytes for a 4-aligned base + misalign\n        let lb = (c.in_bytes as usize).saturating_sub(fb) % 4;\n        seen.insert((fb, lb));\n    }\n    assert_eq!(\n        seen.len(),\n        16,\n        \"expected all 16 (first_bytes, last_bytes) combos, got {seen:?}\"\n    );\n    assert_eq!(rep.compared, cases.len());\n}\n\n// ---------------------------------------------------------------------- row 29\n// word_count == 0: everything comes from `bits` + `final_word`.\n#[test]\nfn row29_word_count_zero() {\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    // The shortest possible stream: a fixed block with one literal.\n    for misalign in 0usize..4 {\n        for lit in [0u8, 1, 0x41, 0xFF] {\n            let s = fixed_stream(&[Item::Lit(lit)]);\n            assert!(s.len() <= 4, \"stream should be tiny, got {}\", s.len());\n            cases.push(\n                Case::new(\n                    format!(\"tiny misalign={misalign} lit={lit:#02x} len={}\", s.len()),\n                    s,\n                    1,\n                )\n                .misaligned(misalign),\n            );\n            exp.push(vec![lit]);\n        }\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 30\n// out_bytes slack.\n#[test]\nfn row30_out_buffer_slack() {\n    let mut r = rng(30);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for _ in 0..40 {\n        let n = r.gen_range(1..=200usize);\n        let payload: Vec<u8> = (0..n).map(|_| r.gen::<u8>()).collect();\n        for s in [deflate_raw(&payload, 9), fixed_stream(&lits(&payload))] {\n            for slack in [0usize, 1, 7, n] {\n                let ob = (n + slack) as i32;\n                cases.push(Case::new(format!(\"slack={slack} n={n}\"), s.clone(), ob).out_cap(\n                    ob as usize + 32,\n                ));\n                exp.push(payload.clone());\n            }\n        }\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 31\n// large payloads across miniz compression levels (level 0 => stored blocks).\n#[test]\nfn row31_large_payloads_all_levels() {\n    let mut r = rng(31);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for &n in &[8usize * 1024, 20 * 1024, 64 * 1024] {\n        let payload: Vec<u8> = (0..n)\n            .map(|i| {\n                if r.gen_bool(0.3) {\n                    r.gen::<u8>()\n                } else {\n                    b\"the quick brown fox jumps over the lazy dog \"[i % 44]\n                }\n            })\n            .collect();\n        for level in [0u32, 1, 6, 9] {\n            let s = deflate_raw(&payload, level);\n            cases.push(Case::new(\n                format!(\"miniz-{level} n={n} ({} bytes)\", s.len()),\n                s,\n                n as i32,\n            ));\n            exp.push(payload.clone());\n        }\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 32\n// one repeated byte: maximal distance==1 memset runs / length==258 chains.\n#[test]\nfn row32_repeated_byte_runs() {\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for n in [1usize, 2, 3, 259, 4096, 64 * 1024] {\n        let payload = vec![0x5Au8; n];\n        for level in [1u32, 9] {\n            let s = deflate_raw(&payload, level);\n            cases.push(Case::new(\n                format!(\"run n={n} level={level}\"),\n                s,\n                n as i32,\n            ));\n            exp.push(payload.clone());\n        }\n        // and a hand-built chain of 258-long dist-1 matches\n        if n >= 259 {\n            let mut items = vec![Item::Lit(0x5A)];\n            let mut have = 1usize;\n            while have < n {\n                let take = (n - have).min(258);\n                if take < 3 {\n                    for _ in 0..take {\n                        items.push(Item::Lit(0x5A));\n                    }\n                    have = n;\n                } else {\n                    items.push(Item::Match(take as u32, 1));\n                    have += take;\n                }\n            }\n            let plain = expand(&items, &[]);\n            assert_eq!(plain.len(), n);\n            cases.push(Case::new(\n                format!(\"hand dist1 chain n={n}\"),\n                fixed_stream(&items),\n                n as i32,\n            ));\n            exp.push(plain);\n        }\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 33\n// 32 KiB back-references (distance symbols 28 and 29).\n#[test]\nfn row33_far_back_references() {\n    let mut r = rng(33);\n    let (mut cases, mut exp) = (Vec::new(), Vec::new());\n    for &dist in &[16385u32, 20000, 24577, 30000, 32768] {\n        let seed: Vec<u8> = (0..dist).map(|_| r.gen::<u8>()).collect();\n        for &length in &[3u32, 100, 258] {\n            let mut items = lits(&seed);\n            items.push(Item::Match(length, dist));\n            let plain = expand(&items, &[]);\n            cases.push(Case::new(\n                format!(\"dist={dist} len={length} sym={}\", dist_symbol(dist)),\n                fixed_stream(&items),\n                plain.len() as i32,\n            ));\n            exp.push(plain);\n        }\n    }\n    run(cases, exp);\n}\n\n// ---------------------------------------------------------------------- row 34\n// the composed pipeline: cp_inflate then unfilter, PNG style.\n#[test]\nfn row34_inflate_then_unfilter_pipeline() {\n    let mut r = rng(34);\n    for _ in 0..40 {\n        let bpp = *[1i32, 2, 3, 4].iter().nth(r.gen_range(0..4)).unwrap();\n        let w = r.gen_range(1..=64i32);\n        let h = r.gen_range(1..=16i32);\n        let stride = 1 + (w * bpp) as usize;\n        let mut filtered: Vec<u8> = (0..h as usize * stride).map(|_| r.gen::<u8>()).collect();\n        for y in 0..h as usize {\n            filtered[y * stride] = r.gen_range(0..=4u8);\n        }\n        let s = deflate_raw(&filtered, 9);\n        let case = Case::new(\n            format!(\"png w={w} h={h} bpp={bpp}\"),\n            s,\n            filtered.len() as i32,\n        );\n        let cases = vec![case];\n        let rep = diff_inflate_batch(rel(), &cases);\n        rep.assert_all_decoded(&cases, &[filtered.clone()]);\n        // second stage: unfilter the *inflated* bytes on both sides\n        let inflated = &rep.c[0].out[..filtered.len()];\n        assert_eq!(inflated, &filtered[..]);\n        diff_unfilter(\n            rel(),\n            &format!(\"pipeline w={w} h={h} bpp={bpp}\"),\n            w,\n            h,\n            bpp,\n            inflated,\n        );\n        diff_unfilter(\n            pair_asserts(),\n            &format!(\"pipeline(assert) w={w} h={h} bpp={bpp}\"),\n            w,\n            h,\n            bpp,\n            inflated,\n        );\n    }\n}\n","userModified":false}}
