n mul_keep_lhs_nan(a: f32, b: f32) -> f32 {\n    a * b\n}\n\n/// `addss dst, src` with `dst = a`: propagates `a`'s NaN in preference to `b`'s.\n///\n/// Matches GCC's `addss %xmm(b),%xmm(a)` in `c2Dot`.\n#[cfg(target_arch = \"x86_64\")]\n#[inline(always)]\nfn add_keep_lhs_nan(a: f32, b: f32) -> f32 {\n    use core::arch::x86_64::{_mm_add_ss, _mm_cvtss_f32, _mm_set_ss};\n    // SAFETY: SSE/SSE2 are baseline features of the x86_64 target.\n    unsafe { _mm_cvtss_f32(_mm_add_ss(_mm_set_ss(a), _mm_set_ss(b))) }\n}\n\n#[cfg(not(target_arch = \"x86_64\"))]\n#[inline(always)]\nfn add_keep_lhs_nan(a: f32, b: f32) -> f32 {\n    a + b\n}\n\n// ---------------------------------------------------------------------------\n// Vector helpers\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// c2v c2V(float x, float y) {"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3927,"cache_read_input_tokens":37327,"cache_creation":{"ephemeral_5m_input_tokens":3927,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"18c86d6a-f819-4259-98aa-2d66fbf769ee","uuid":"94ad4978-0a66-40ac-b65f-e35efa3aff00","timestamp":"2026-08-27T06:34:52.972Z"}
