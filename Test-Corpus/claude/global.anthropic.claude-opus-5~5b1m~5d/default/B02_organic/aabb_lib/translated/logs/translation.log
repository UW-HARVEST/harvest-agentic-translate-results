edef struct c2r { float c, s; } c2r;\ntypedef struct c2x { c2v p; c2r r; } c2x;\ntypedef struct c2Circle { c2v p; float r; } c2Circle;\ntypedef struct c2AABB { c2v min, max; } c2AABB;\ntypedef struct c2Capsule { c2v a, b; float r; } c2Capsule;\ntypedef struct c2GJKCache { float metric; int count; int iA[3]; int iB[3]; float div; } c2GJKCache;\ntypedef struct { float radius; int count; c2v verts[8]; } c2Proxy;\ntypedef struct { c2v sA, sB, p; float u; int iA, iB; } c2sv;\ntypedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;\n\ntypedef struct {\n\tc2v   (*c2V)(float, float);\n\tc2v   (*c2Mulvs)(c2v, float);\n\tc2v   (*c2Maxv)(c2v, c2v);\n\tc2v   (*c2Minv)(c2v, c2v);\n\tc2v   (*c2Clampv)(c2v, c2v, c2v);\n\tc2v   (*c2Sub)(c2v, c2v);\n\tfloat (*c2Dot)(c2v, c2v);\n\tc2r   (*c2RotIdentity)(void);\n\tc2x   (*c2xIdentity)(void);\n\tvoid  (*c2BBVerts)(c2v *, c2AABB *);\n\tvoid  (*c2MakeProxy)(const void *, C2_TYPE, c2Proxy *);\n\tfloat (*c2Len)(c2v);\n\tfloat (*c2Det2)(c2v, c2v);\n\tfloat (*c2GJKSimplexMetric)(c2Simplex *);\n\tc2v   (*c2Mulrv)(c2r, c2v);\n\tc2v   (*c2Add)(c2v, c2v);\n\tc2v   (*c2Mulxv)(c2x, c2v);\n\tvoid  (*c22)(c2Simplex *);\n\tvoid  (*c23)(c2Simplex *);\n\tc2v   (*c2Neg)(c2v);\n\tc2v   (*c2Skew)(c2v);\n\tc2v   (*c2CCW90)(c2v);\n\tc2v   (*c2D)(c2Simplex *);\n\tint   (*c2Support)(const c2v *, int, c2v);\n\tvoid  (*c2Witness)(c2Simplex *, c2v *, c2v *);\n\tc2v   (*c2Div)(c2v, float);\n\tc2v   (*c2Norm)(c2v);\n\tc2v   (*c2L)(c2Simplex *);\n\tc2v   (*c2MulrvT)(c2r, c2v);\n\tfloat (*c2GJK)(const void *, C2_TYPE, const c2x *, const void *, C2_TYPE,\n\t               const c2x *, c2v *, c2v *, int, int *, c2GJKCache *);\n\tint   (*c2AABBtoAABB)(c2AABB, c2AABB);\n\tint   (*c2AABBtoCapsule)(c2AABB, c2Capsule);\n\tint   (*c2CapsuletoCapsule)(c2Capsule, c2Capsule);\n\tint   (*c2CircletoCircle)(c2Circle, c2Circle);\n\tint   (*c2CircletoAABB)(c2Circle, c2AABB);\n\tint   (*c2CircletoCapsule)(c2Circle, c2Capsule);\n\tint   (*c2Collided)(const void *, C2_TYPE, const void *, C2_TYPE);\n\tint   (*aabb)(float, float, float, float);\n} API;\n\nstatic long failures = 0;\nstatic long checks = 0;\n\nstatic void *must(void *h, const char *n) {\n\tvoid *p = dlsym(h, n);\n\tif (!p) { fprintf(stderr, \"missing symbol %s: %s\\n\", n, dlerror()); exit(2); }\n\treturn p;\n}\n\n#define LOAD(f) api->f = (void*)must(h, #f)\n\nstatic void load(API *api, void *h) {\n\tLOAD(c2V); LOAD(c2Mulvs); LOAD(c2Maxv); LOAD(c2Minv); LOAD(c2Clampv);\n\tLOAD(c2Sub); LOAD(c2Dot); LOAD(c2RotIdentity); LOAD(c2xIdentity);\n\tLOAD(c2BBVerts); LOAD(c2MakeProxy); LOAD(c2Len); LOAD(c2Det2);\n\tLOAD(c2GJKSimplexMetric); LOAD(c2Mulrv); LOAD(c2Add); LOAD(c2Mulxv);\n\tLOAD(c22); LOAD(c23); LOAD(c2Neg); LOAD(c2Skew); LOAD(c2CCW90); LOAD(c2D);\n\tLOAD(c2Support); LOAD(c2Witness); LOAD(c2Div); LOAD(c2Norm); LOAD(c2L);\n\tLOAD(c2MulrvT); LOAD(c2GJK); LOAD(c2AABBtoAABB); LOAD(c2AABBtoCapsule);\n\tLOAD(c2CapsuletoCapsule); LOAD(c2CircletoCircle); LOAD(c2CircletoAABB);\n\tLOAD(c2CircletoCapsule); LOAD(c2Collided); LOAD(aabb);\n}\n\nstatic void cmp(const char *what, const void *a, const void *b, size_t n) {\n\t++checks;\n\tif (memcmp(a, b, n) != 0) {\n\t\tif (failures < 25) {\n\t\t\tfprintf(stderr, \"MISMATCH %s:\\n  C  =\", what);\n\t\t\tfor (size_t i = 0; i < n; ++i) fprintf(stderr, \" %02x\", ((const unsigned char*)a)[i]);\n\t\t\tfprintf(stderr, \"\\n  RS =\");\n\t\t\tfor (size_t i = 0; i < n; ++i) fprintf(stderr, \" %02x\", ((const unsigned char*)b)[i]);\n\t\t\tfprintf(stderr, \"\\n\");\n\t\t}\n\t\t++failures;\n\t}\n}\n\nstatic uint64_t rng_state = 0x853c49e6748fea9bULL;\nstatic uint32_t rnd(void) {\n\trng_state = rng_state * 6364136223846793005ULL + 1442695040888963407ULL;\n\treturn (uint32_t)(rng_state >> 33);\n}\nstatic const float pool[] = {\n\t0.0f, -0.0f, 1.0f, -1.0f, 0.5f, -0.5f, 1e-8f, -1e-8f, 1e8f, -1e8f,\n\t20.0f, -70.0f, 40.0f, -40.0f, 15.0f, -15.0f, 100.0f, 3.4028235e38f,\n\t-3.4028235e38f, 1.1920929e-7f, 2.5f, -2.5f, 7.125f, -7.125f, 1e-45f,\n\tINFINITY, -INFINITY, NAN,\n};\nstatic float rf(void) {\n\tuint32_t r = rnd();\n\tif ((r & 7) == 0) return pool[rnd() % (sizeof(pool)/sizeof(pool[0]))];\n\t/* generic float in a broad range */\n\tfloat f = (float)((int32_t)rnd() % 400000) / 1000.0f;\n\tif (r & 8) f *= 1e3f;\n\tif (r & 16) f *= 1e-6f;\n\treturn f;\n}\nstatic float rf_tame(void) {\n\tuint32_t r = rnd();\n\tif ((r & 15) == 0) return pool[rnd() % 24]; /* skip inf/nan */\n\treturn (float)((int32_t)rnd() % 200000) / 1000.0f;\n}\nstatic c2v rv(void) { c2v a; a.x = rf(); a.y = rf(); return a; }\nstatic c2v rv_tame(void) { c2v a; a.x = rf_tame(); a.y = rf_tame(); return a; }\n\nstatic c2Simplex rsimplex(void) {\n\tc2Simplex s;\n\tunsigned char *raw = (unsigned char *)&s;\n\tfor (size_t i = 0; i < sizeof s; ++i) raw[i] = (unsigned char)rnd();\n\tc2sv *v = &s.a;\n\tfor (int i = 0; i < 4; ++i) {\n\t\tv[i].sA = rv_tame(); v[i].sB = rv_tame(); v[i].p = rv_tame();\n\t\tv[i].u  = rf_tame(); v[i].iA = (int)(rnd() % 8); v[i].iB = (int)(rnd() % 8);\n\t}\n\ts.div = ((rnd() & 7) == 0) ? 0.0f : rf_tame();\n\ts.count = (int)(rnd() % 6);           /* 0..5 exercises default branches */\n\tif (rnd() & 1) s.count = 1 + (int)(rnd() % 3);\n\treturn s;\n}\n\nint main(int argc, char **argv) {\n\tif (argc != 3) { fprintf(stderr, \"usage: %s libC.so libRust.so\\n\", argv[0]); return 2; }\n\tvoid *hc = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n\tif (!hc) { fprintf(stderr, \"dlopen C: %s\\n\", dlerror()); return 2; }\n\tvoid *hr = dlopen(argv[2], RTLD_NOW | RTLD_LOCAL);\n\tif (!hr) { fprintf(stderr, \"dlopen Rust: %s\\n\", dlerror()); return 2; }\n\tAPI C, R; load(&C, hc); load(&R, hr);\n\n\t/* zero-arg functions */\n\t{ c2r a = C.c2RotIdentity(), b = R.c2RotIdentity(); cmp(\"c2RotIdentity\", &a, &b, sizeof a); }\n\t{ c2x a = C.c2xIdentity(),   b = R.c2xIdentity();   cmp(\"c2xIdentity\",   &a, &b, sizeof a); }\n\n\tconst int N = 200000;\n\tfor (int it = 0; it < N; ++it) {\n\t\tfloat f1 = rf(), f2 = rf();\n\t\tc2v a = rv(), b = rv(), c = rv();\n