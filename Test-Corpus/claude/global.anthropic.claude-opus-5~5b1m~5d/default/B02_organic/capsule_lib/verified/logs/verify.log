         assert_eq!(cv, r(a, b), \"E62 NaN slot={slot}\");\n                assert_eq!(cv, 0, \"E62 NaN must reject, got {cv}\");'''\nnew = '''                let cv = c(a, b);\n                assert_eq!(cv, r(a, b), \"E62 NaN slot={slot}\");\n                assert_eq!(\n                    cv,\n                    ref_circle_to_circle(a, b),\n                    \"E62 slot={slot}: C source prescribes a different value\"\n                );\n                assert_eq!(cv, 0, \"E62 NaN must reject, got {cv}\");'''\nassert old in t; t = t.replace(old, new, 1)\n\nold = '''            assert_eq!(c(inv, other), r(inv, other), \"E66 inverted A\");\n            assert_eq!(c(other, inv), r(other, inv), \"E66 inverted B\");\n            assert_eq!(c(inv, inv), r(inv, inv), \"E66 both inverted\");'''\nnew = '''            assert_eq!(c(inv, other), r(inv, other), \"E66 inverted A\");\n            assert_eq!(c(other, inv), r(other, inv), \"E66 inverted B\");\n            assert_eq!(c(inv, inv), r(inv, inv), \"E66 both inverted\");\n            assert_eq!(c(inv, other), ref_aabb_to_aabb(inv, other), \"E66 vs C source\");\n            assert_eq!(c(other, inv), ref_aabb_to_aabb(other, inv), \"E66 vs C source\");'''\nassert old in t; t = t.replace(old, new, 1)\n\nold = '''            let cv = c(a, inv);\n            assert_eq!(cv, r(a, inv), \"E63 inverted AABB\");'''\nnew = '''            let cv = c(a, inv);\n            assert_eq!(cv, r(a, inv), \"E63 inverted AABB\");\n            assert_eq!(cv, ref_circle_to_aabb(a, inv), \"E63 vs C source\");'''\nassert old in t; t = t.replace(old, new, 1)\n\np.write_text(t)\nprint(\"patched\")\nPY\ntimeout 600 cargo test --offline --release --test phase_c_errors 2>&1 | grep -vE '^warning:|^\\s+\\||^\\s+-->|^\\s+=|^\\s*$|help:|^note' | tail -40","description":"Patch Phase C with C-derived reference predicates and run"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4908,"