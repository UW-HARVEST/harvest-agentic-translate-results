{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01C47Zaw7ZLcZjWoj7n4AgnV","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (a cute_c2 derived 2D\n2\t//! collision library plus the `capsule` entry point declared in `include/lib.h`).\n3\t//!\n4\t//! Every non-static C function is reproduced with the exact same linker name,\n5\t//! signature and observable behaviour, including its quirks (fall-through\n6\t//! `switch` labels, the inverted GJK cache-validity test, reading a shape\n7\t//! through an unchecked `void*` cast, ...).\n8\t//!\n9\t//! Bit-exactness note: all arithmetic is single precision, evaluated in the\n10\t//! same association order as the C.  On top of that, the tiny `*_ss` helpers\n11\t//! below reproduce x86 SSE NaN-propagation (the *destination* operand of\n12\t//! `mulss`/`addss`/`subss`/`divss` wins, a signalling NaN is quieted, and an\n13\t//! invalid operation on two non-NaN operands yields the \"indefinite\" QNaN\n14\t//! `0xFFC00000`).  The destination operand chosen at each call site mirrors the\n15\t//! instruction GCC emits for the original source, so even NaN payloads and\n16\t//! sign bits come out identical.\n17\t\n18\t#![allow(\n19\t    non_snake_case,\n20\t    non_camel_case_types,\n21\t    non_upper_case_globals,\n22\t    unused_assignments,\n23\t    unused_variables,\n24\t    unused_mut\n25\t)]\n26\t\n27\tuse std::ffi::{c_int, c_void};\n28\t\n29\t// ---------------------------------------------------------------------------\n30\t// typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;\n31\t// ---------------------------------------------------------------------------\n32\tpub const C2_TYPE_CIRCLE: c_int = 0;\n33\tpub const C2_TYPE_AABB: c_int = 1;\n34\tpub const C2_TYPE_CAPSULE: c_int = 2;\n35\t\n36\t/// `FLT_MAX`, spelled exactly as in the C source.\n37\tconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38;\n38\t/// `FLT_EPSILON`, spelled exactly as in the C source.\n39\tconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7;\n40\t/// `FLT_EPSILON * FLT_EPSILON` (exactly 2^-46, matching GCC's constant folding).\n41\tconst C2_FLT_EPSILON_SQ: f32 = C2_FLT_EPSILON * C2_FLT_EPSILON;\n42\t\n43\t// ---------------------------------------------------------------------------\n44\t// x86 SSE scalar arithmetic helpers (see the bit-exactness note above)\n45\t// ---------------------------------------------------------------------------\n46\t\n47\t#[inline(always)]\n48\tfn quiet_nan(x: f32) -> f32 {\n49\t    // x86 turns a signalling NaN into a quiet one by setting the significand MSB\n50\t    // while preserving the sign bit and the rest of the payload.\n51\t    f32::from_bits(x.to_bits() | 0x0040_0000)\n52\t}\n53\t\n54\t/// `mulss dst, src`\n55\t#[inline(always)]\n56\tfn mul_ss(dst: f32, src: f32) -> f32 {\n57\t    if dst.is_nan() {\n58\t        quiet_nan(dst)\n59\t    } else if src.is_nan() {\n60\t        quiet_nan(src)\n61\t    } else {\n62\t        // Neither operand is a NaN, so the hardware result no longer depends on\n63\t        // which operand is the destination.\n64\t        dst * src\n65\t    }\n66\t}\n67\t\n68\t/// `addss dst, src`\n69\t#[inline(always)]\n70\tfn add_ss(dst: f32, src: f32) -> f32 {\n71\t    if dst.is_nan() {\n72\t        quiet_nan(dst)\n73\t    } else if src.is_nan() {\n74\t        quiet_nan(src)\n75\t    } else {\n76\t        dst + src\n77\t    }\n78\t}\n79\t\n80\t/// `subss dst, src` (computes `dst - src`)\n81\t#[inline(always)]\n82\tfn sub_ss(dst: f32, src: f32) -> f32 {\n83\t    if dst.is_nan() {\n84\t        quiet_nan(dst)\n85\t    } else if src.is_nan() {\n86\t        quiet_nan(src)\n87\t    } else {\n88\t        dst - src\n89\t    }\n90\t}\n91\t\n92\t/// `divss dst, src` (computes `dst / src`)\n93\t#[inline(always)]\n94\tfn div_ss(dst: f32, src: f32) -> f32 {\n95\t    if dst.is_nan() {\n96\t        quiet_nan(dst)\n97\t    } else if src.is_nan() {\n98\t        quiet_nan(src)\n99\t    } else {\n100\t        dst / src\n101\t    }\n102\t}\n103\t\n104\t// ---------------------------------------------------------------------------\n105\t// Plain-old-data types (layout identical to the C structs)\n106\t// ---------------------------------------------------------------------------\n107\t\n108\t#[repr(C)]\n109\t#[derive(Copy, Clone, Default, Debug)]\n110\tpub struct c2v {\n111\t    pub x: f32,\n112\t    pub y: f32,\n113\t}\n114\t\n115\t#[repr(C)]\n116\t#[derive(Copy, Clone, Default, Debug)]\n117\tpub struct c2r {\n118\t    pub c: f32,\n119\t    pub s: f32,\n120\t}\n121\t\n122\t#[repr(C)]\n123\t#[derive(Copy, Clone, Default, Debug)]\n124\tpub struct c2x {\n125\t    pub p: c2v,\n126\t    pub r: c2r,\n127\t}\n128\t\n129\t#[repr(C)]\n130\t#[derive(Copy, Clone, Default, Debug)]\n131\tpub struct c2Circle {\n132\t    pub p: c2v,\n133\t    pub r: f32,\n134\t}\n135\t\n136\t#[repr(C)]\n137\t#[derive(Copy, Clone, Default, Debug)]\n138\tpub struct c2AABB {\n139\t    pub min: c2v,\n140\t    pub max: c2v,\n141\t}\n142\t\n143\t#[repr(C)]\n144\t#[derive(Copy, Clone, Default, Debug)]\n145\tpub struct c2Capsule {\n146\t    pub a: c2v,\n147\t    pub b: c2v,\n148\t    pub r: f32,\n149\t}\n150\t\n151\t#[repr(C)]\n152\t#[derive(Copy, Clone, Default, Debug)]\n153\tpub struct c2GJKCache {\n154\t    pub metric: f32,\n155\t    pub count: c_int,\n156\t    pub iA: [c_int; 3],\n157\t    pub iB: [c_int; 3],\n158\t    pub div: f32,\n159\t}\n160\t\n161\t/// `typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;`\n162\t#[repr(C)]\n163\t#[derive(Copy, Clone, Default, Debug)]\n164\tpub struct c2Proxy {\n165\t    pub radius: f32,\n166\t    pub count: c_int,\n167\t    pub verts: [c2v; 8],\n168\t}\n169\t\n170\t/// `typedef struct { c2v sA, sB, p; float u; int iA, iB; } c2sv;`\n171\t#[repr(C)]\n172\t#[derive(Copy, Clone, Default, Debug)]\n173\tpub struct c2sv {\n174\t    pub sA: c2v,\n175\t    pub sB: c2v,\n176\t    pub p: c2v,\n177\t    pub u: f32,\n178\t    pub iA: c_int,\n179\t    pub iB: c_int,\n180\t}\n181\t\n182\t/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n183\t///\n184\t/// The four `c2sv` members are held in an array so that the C idiom\n185\t/// `c2sv* verts = &s.a; verts[i]` can be reproduced verbatim; the memory layout\n186\t/// is byte-for-byte identical to the C declaration (4 * 36 + 4 + 4 = 152 bytes).\n187\t#[repr(C)]\n188\t#[derive(Copy, Clone, Default, Debug)]\n189\tpub struct c2Simplex {\n190\t    pub verts: [c2sv; 4],\n191\t    pub div: f32,\n192\t    pub count: c_int,\n193\t}\n194\t\n195\t// ---------------------------------------------------------------------------\n196\t// Basic vector maths\n197\t// ---------------------------------------------------------------------------\n198\t\n199\t#[unsafe(no_mangle)]\n200\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n201\t    let mut a = c2v::default();\n202\t    a.x = x;\n203\t    a.y = y;\n204\t    a\n205\t}\n206\t\n207\t#[unsafe(no_mangle)]\n208\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n209\t    a.x = mul_ss(a.x, b);\n210\t    a.y = mul_ss(a.y, b);\n211\t    a\n212\t}\n213\t\n214\t#[unsafe(no_mangle)]\n215\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n216\t    c2V(\n217\t        if a.x > b.x { a.x } else { b.x },\n218\t        if a.y > b.y { a.y } else { b.y },\n219\t    )\n220\t}\n221\t\n222\t#[unsafe(no_mangle)]\n223\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n224\t    c2V(\n225\t        if a.x < b.x { a.x } else { b.x },\n226\t        if a.y < b.y { a.y } else { b.y },\n227\t    )\n228\t}\n229\t\n230\t#[unsafe(no_mangle)]\n231\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n232\t    c2Maxv(lo, c2Minv(a, hi))\n233\t}\n234\t\n235\t#[unsafe(no_mangle)]\n236\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n237\t    a.x = sub_ss(a.x, b.x);\n238\t    a.y = sub_ss(a.y, b.y);\n239\t    a\n240\t}\n241\t\n242\t#[unsafe(no_mangle)]\n243\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n244\t    // mulss dst=a.x ; mulss dst=b.y ; addss dst=(a.y*b.y term)\n245\t    let p1 = mul_ss(a.x, b.x);\n246\t    let p2 = mul_ss(b.y, a.y);\n247\t    add_ss(p2, p1)\n248\t}\n249\t\n250\t#[unsafe(no_mangle)]\n251\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n252\t    let mut r = c2r::default();\n253\t    r.c = 1.0f32;\n254\t    r.s = 0.0;\n255\t    r\n256\t}\n257\t\n258\t#[unsafe(no_mangle)]\n259\tpub extern \"C\" fn c2xIdentity() -> c2x {\n260\t    let mut x = c2x::default();\n261\t    x.p = c2V(0.0, 0.0);\n262\t    x.r = c2RotIdentity();\n263\t    x\n264\t}\n265\t\n266\t// ---------------------------------------------------------------------------\n267\t// Proxies\n268\t// ---------------------------------------------------------------------------\n269\t\n270\t#[unsafe(no_mangle)]\n271\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n272\t    *out.add(0) = (*bb).min;\n273\t    *out.add(1) = c2V((*bb).max.x, (*bb).min.y);\n274\t    *out.add(2) = (*bb).max;\n275\t    *out.add(3) = c2V((*bb).min.x, (*bb).max.y);\n276\t}\n277\t\n278\t#[unsafe(no_mangle)]\n279\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n280\t    match type_ {\n281\t        C2_TYPE_CIRCLE => {\n282\t            let c = shape as *mut c2Circle;\n283\t            (*p).radius = (*c).r;\n284\t            (*p).count = 1;\n285\t            (*p).verts[0] = (*c).p;\n286\t        }\n287\t        C2_TYPE_AABB => {\n288\t            let bb = shape as *mut c2AABB;\n289\t            (*p).radius = 0.0;\n290\t            (*p).count = 4;\n291\t            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n292\t        }\n293\t        C2_TYPE_CAPSULE => {\n294\t            let c = shape as *mut c2Capsule;\n295\t            (*p).radius = (*c).r;\n296\t            (*p).count = 2;\n297\t            (*p).verts[0] = (*c).a;\n298\t            (*p).verts[1] = (*c).b;\n299\t        }\n300\t        // The C `switch` has no `default:` label, so nothing is written.\n301\t        _ => {}\n302\t    }\n303\t}\n304\t\n305\t// ---------------------------------------------------------------------------\n306\t// Simplex helpers\n307\t// ---------------------------------------------------------------------------\n308\t\n309\t#[unsafe(no_mangle)]\n310\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n311\t    // sqrtf(c2Dot(a, a)) -- `sqrtss`, so a negative operand yields the\n312\t    // indefinite QNaN and a NaN operand is merely quieted.\n313\t    c2Dot(a, a).sqrt()\n314\t}\n315\t\n316\t#[unsafe(no_mangle)]\n317\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n318\t    // mulss dst=b.y ; mulss dst=b.x ; subss dst=first term\n319\t    let t1 = mul_ss(b.y, a.x);\n320\t    let t2 = mul_ss(b.x, a.y);\n321\t    sub_ss(t1, t2)\n322\t}\n323\t\n324\t#[unsafe(no_mangle)]\n325\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n326\t    match (*s).count {\n327\t        2 => c2Len(c2Sub((*s).verts[1].p, (*s).verts[0].p)),\n328\t        3 => c2Det2(\n329\t            c2Sub((*s).verts[1].p, (*s).verts[0].p),\n330\t            c2Sub((*s).verts[2].p, (*s).verts[0].p),\n331\t        ),\n332\t        // `default:` falls through into `case 1:`, which returns 0.\n333\t        _ => 0.0,\n334\t    }\n335\t}\n336\t\n337\t#[unsafe(no_mangle)]\n338\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n339\t    // x = a.c * b.x - a.s * b.y  ->  subss(mulss dst=b.x, mulss dst=b.y)\n340\t    // y = a.s * b.x + a.c * b.y  ->  addss(mulss dst=a.s, mulss dst=b.y)\n341\t    let x = sub_ss(mul_ss(b.x, a.c), mul_ss(b.y, a.s));\n342\t    let y = add_ss(mul_ss(a.s, b.x), mul_ss(b.y, a.c));\n343\t    c2V(x, y)\n344\t}\n345\t\n346\t#[unsafe(no_mangle)]\n347\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n348\t    // addss dst=b.x / dst=b.y\n349\t    a.x = add_ss(b.x, a.x);\n350\t    a.y = add_ss(b.y, a.y);\n351\t    a\n352\t}\n353\t\n354\t#[unsafe(no_mangle)]\n355\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n356\t    c2Add(c2Mulrv(a.r, b), a.p)\n357\t}\n358\t\n359\t#[unsafe(no_mangle)]\n360\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n361\t    let a = (*s).verts[0].p;\n362\t    let b = (*s).verts[1].p;\n363\t    let u = c2Dot(b, c2Sub(b, a));\n364\t    let v = c2Dot(a, c2Sub(a, b));\n365\t    if v <= 0.0 {\n366\t        (*s).verts[0].u = 1.0f32;\n367\t        (*s).div = 1.0f32;\n368\t        (*s).count = 1;\n369\t    } else if u <= 0.0 {\n370\t        (*s).verts[0] = (*s).verts[1];\n371\t        (*s).verts[0].u = 1.0f32;\n372\t        (*s).div = 1.0f32;\n373\t        (*s).count = 1;\n374\t    } else {\n375\t        (*s).verts[0].u = u;\n376\t        (*s).verts[1].u = v;\n377\t        (*s).div = add_ss(u, v);\n378\t        (*s).count = 2;\n379\t    }\n380\t}\n381\t\n382\t#[unsafe(no_mangle)]\n383\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n384\t    let a = (*s).verts[0].p;\n385\t    let b = (*s).verts[1].p;\n386\t    let c = (*s).verts[2].p;\n387\t    let uAB = c2Dot(b, c2Sub(b, a));\n388\t    let vAB = c2Dot(a, c2Sub(a, b));\n389\t    let uBC = c2Dot(c, c2Sub(c, b));\n390\t    let vBC = c2Dot(b, c2Sub(b, c));\n391\t    let uCA = c2Dot(a, c2Sub(a, c));\n392\t    let vCA = c2Dot(c, c2Sub(c, a));\n393\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n394\t    let uABC = mul_ss(c2Det2(b, c), area);\n395\t    let vABC = mul_ss(c2Det2(c, a), area);\n396\t    let wABC = mul_ss(c2Det2(a, b), area);\n397\t    if vAB <= 0.0 && uCA <= 0.0 {\n398\t        (*s).verts[0].u = 1.0f32;\n399\t        (*s).div = 1.0f32;\n400\t        (*s).count = 1;\n401\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n402\t        (*s).verts[0] = (*s).verts[1];\n403\t        (*s).verts[0].u = 1.0f32;\n404\t        (*s).div = 1.0f32;\n405\t        (*s).count = 1;\n406\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n407\t        (*s).verts[0] = (*s).verts[2];\n408\t        (*s).verts[0].u = 1.0f32;\n409\t        (*s).div = 1.0f32;\n410\t        (*s).count = 1;\n411\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n412\t        (*s).verts[0].u = uAB;\n413\t        (*s).verts[1].u = vAB;\n414\t        (*s).div = add_ss(uAB, vAB);\n415\t        (*s).count = 2;\n416\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n417\t        (*s).verts[0] = (*s).verts[1];\n418\t        (*s).verts[1] = (*s).verts[2];\n419\t        (*s).verts[0].u = uBC;\n420\t        (*s).verts[1].u = vBC;\n421\t        (*s).div = add_ss(uBC, vBC);\n422\t        (*s).count = 2;\n423\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n424\t        (*s).verts[1] = (*s).verts[0];\n425\t        (*s).verts[0] = (*s).verts[2];\n426\t        (*s).verts[0].u = uCA;\n427\t        (*s).verts[1].u = vCA;\n428\t        (*s).div = add_ss(uCA, vCA);\n429\t        (*s).count = 2;\n430\t    } else {\n431\t        (*s).verts[0].u = uABC;\n432\t        (*s).verts[1].u = vABC;\n433\t        (*s).verts[2].u = wABC;\n434\t        (*s).div = add_ss(add_ss(uABC, vABC), wABC);\n435\t        (*s).count = 3;\n436\t    }\n437\t}\n438\t\n439\t#[unsafe(no_mangle)]\n440\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n441\t    // `xorps` with the sign mask: flips the sign bit of NaNs too.\n442\t    c2V(-a.x, -a.y)\n443\t}\n444\t\n445\t#[unsafe(no_mangle)]\n446\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n447\t    let mut b = c2v::default();\n448\t    b.x = -a.y;\n449\t    b.y = a.x;\n450\t    b\n451\t}\n452\t\n453\t#[unsafe(no_mangle)]\n454\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n455\t    let mut b = c2v::default();\n456\t    b.x = a.y;\n457\t    b.y = -a.x;\n458\t    b\n459\t}\n460\t\n461\t#[unsafe(no_mangle)]\n462\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n463\t    match (*s).count {\n464\t        1 => c2Neg((*s).verts[0].p),\n465\t        2 => {\n466\t            let ab = c2Sub((*s).verts[1].p, (*s).verts[0].p);\n467\t            if c2Det2(ab, c2Neg((*s).verts[0].p)) > 0.0 {\n468\t                return c2Skew(ab);\n469\t            }\n470\t            c2CCW90(ab)\n471\t        }\n472\t        // `case 3:` and `default:`\n473\t        _ => c2V(0.0, 0.0),\n474\t    }\n475\t}\n476\t\n477\t#[unsafe(no_mangle)]\n478\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n479\t    let mut imax: c_int = 0;\n480\t    let mut dmax = c2Dot(*verts.add(0), d);\n481\t    let mut i: c_int = 1;\n482\t    while i < count {\n483\t        let dot = c2Dot(*verts.offset(i as isize), d);\n484\t        if dot > dmax {\n485\t            imax = i;\n486\t            dmax = dot;\n487\t        }\n488\t        i += 1;\n489\t    }\n490\t    imax\n491\t}\n492\t\n493\t#[unsafe(no_mangle)]\n494\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n495\t    let den = div_ss(1.0f32, (*s).div);\n496\t    match (*s).count {\n497\t        1 => {\n498\t            *a = (*s).verts[0].sA;\n499\t            *b = (*s).verts[0].sB;\n500\t        }\n501\t        2 => {\n502\t            *a = c2Add(\n503\t                c2Mulvs((*s).verts[0].sA, mul_ss((*s).verts[0].u, den)),\n504\t                c2Mulvs((*s).verts[1].sA, mul_ss((*s).verts[1].u, den)),\n505\t            );\n506\t            *b = c2Add(\n507\t                c2Mulvs((*s).verts[0].sB, mul_ss((*s).verts[0].u, den)),\n508\t                c2Mulvs((*s).verts[1].sB, mul_ss((*s).verts[1].u, den)),\n509\t            );\n510\t        }\n511\t        3 => {\n512\t            *a = c2Add(\n513\t                c2Add(\n514\t                    c2Mulvs((*s).verts[0].sA, mul_ss((*s).verts[0].u, den)),\n515\t                    c2Mulvs((*s).verts[1].sA, mul_ss((*s).verts[1].u, den)),\n516\t                ),\n517\t                c2Mulvs((*s).verts[2].sA, mul_ss((*s).verts[2].u, den)),\n518\t            );\n519\t            *b = c2Add(\n520\t                c2Add(\n521\t                    c2Mulvs((*s).verts[0].sB, mul_ss((*s).verts[0].u, den)),\n522\t                    c2Mulvs((*s).verts[1].sB, mul_ss((*s).verts[1].u, den)),\n523\t                ),\n524\t                c2Mulvs((*s).verts[2].sB, mul_ss((*s).verts[2].u, den)),\n525\t            );\n526\t        }\n527\t        _ => {\n528\t            *a = c2V(0.0, 0.0);\n529\t            *b = c2V(0.0, 0.0);\n530\t        }\n531\t    }\n532\t}\n533\t\n534\t#[unsafe(no_mangle)]\n535\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n536\t    c2Mulvs(a, div_ss(1.0f32, b))\n537\t}\n538\t\n539\t#[unsafe(no_mangle)]\n540\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n541\t    c2Div(a, c2Len(a))\n542\t}\n543\t\n544\t#[unsafe(no_mangle)]\n545\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n546\t    let den = div_ss(1.0f32, (*s).div);\n547\t    match (*s).count {\n548\t        1 => (*s).verts[0].p,\n549\t        2 => c2Add(\n550\t            c2Mulvs((*s).verts[0].p, mul_ss((*s).verts[0].u, den)),\n551\t            c2Mulvs((*s).verts[1].p, mul_ss((*s).verts[1].u, den)),\n552\t        ),\n553\t        _ => c2V(0.0, 0.0),\n554\t    }\n555\t}\n556\t\n557\t#[unsafe(no_mangle)]\n558\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n559\t    // x =  a.c * b.x + a.s * b.y  ->  addss(mulss dst=a.c, mulss dst=b.y)\n560\t    // y = -a.s * b.x + a.c * b.y  ->  addss(mulss dst=(-a.s), mulss dst=b.y)\n561\t    let x = add_ss(mul_ss(a.c, b.x), mul_ss(b.y, a.s));\n562\t    let y = add_ss(mul_ss(-a.s, b.x), mul_ss(b.y, a.c));\n563\t    c2V(x, y)\n564\t}\n565\t\n566\t// ---------------------------------------------------------------------------\n567\t// GJK\n568\t// ---------------------------------------------------------------------------\n569\t\n570\t#[unsafe(no_mangle)]\n571\tpub unsafe extern \"C\" fn c2GJK(\n572\t    A: *const c_void,\n573\t    typeA: c_int,\n574\t    ax_ptr: *const c2x,\n575\t    B: *const c_void,\n576\t    typeB: c_int,\n577\t    bx_ptr: *const c2x,\n578\t    outA: *mut c2v,\n579\t    outB: *mut c2v,\n580\t    use_radius: c_int,\n581\t    iterations: *mut c_int,\n582\t    cache: *mut c2GJKCache,\n583\t) -> f32 {\n584\t    let ax: c2x;\n585\t    let bx: c2x;\n586\t    if ax_ptr.is_null() {\n587\t        ax = c2xIdentity();\n588\t    } else {\n589\t        ax = *ax_ptr;\n590\t    }\n591\t    if bx_ptr.is_null() {\n592\t        bx = c2xIdentity();\n593\t    } else {\n594\t        bx = *bx_ptr;\n595\t    }\n596\t    let mut pA = c2Proxy::default();\n597\t    let mut pB = c2Proxy::default();\n598\t    c2MakeProxy(A, typeA, &mut pA);\n599\t    c2MakeProxy(B, typeB, &mut pB);\n600\t    // Raw views of the fixed-size C arrays: the original indexes them without\n601\t    // any bounds check, so Rust must not introduce a panicking one either.\n602\t    let pAv: *const c2v = pA.verts.as_ptr();\n603\t    let pBv: *const c2v = pB.verts.as_ptr();\n604\t    let mut s = c2Simplex::default();\n605\t    let sp: *mut c2Simplex = &mut s;\n606\t    let verts: *mut c2sv = (*sp).verts.as_mut_ptr();\n607\t    let mut cache_was_read: c_int = 0;\n608\t    if !cache.is_null() {\n609\t        let cache_iA: *const c_int = (*cache).iA.as_ptr();\n610\t        let cache_iB: *const c_int = (*cache).iB.as_ptr();\n611\t        let cache_was_good: c_int = ((*cache).count != 0) as c_int;\n612\t        if cache_was_good != 0 {\n613\t            let mut i: c_int = 0;\n614\t            while i < (*cache).count {\n615\t                let iA = *cache_iA.offset(i as isize);\n616\t                let iB = *cache_iB.offset(i as isize);\n617\t                let sA = c2Mulxv(ax, *pAv.offset(iA as isize));\n618\t                let sB = c2Mulxv(bx, *pBv.offset(iB as isize));\n619\t                let v: *mut c2sv = verts.offset(i as isize);\n620\t                (*v).iA = iA;\n621\t                (*v).sA = sA;\n622\t                (*v).iB = iB;\n623\t                (*v).sB = sB;\n624\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n625\t                (*v).u = 0.0;\n626\t                i += 1;\n627\t            }\n628\t            (*sp).count = (*cache).count;\n629\t            (*sp).div = (*cache).div;\n630\t            let metric_old = (*cache).metric;\n631\t            let metric = c2GJKSimplexMetric(sp);\n632\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n633\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n634\t            // NOTE: reproduced verbatim from the C -- the `metric < -1.0e8f`\n635\t            // term makes this test almost always true.\n636\t            if !(min_metric < mul_ss(max_metric, 2.0f32) && metric < -1.0e8f32) {\n637\t                cache_was_read = 1;\n638\t            }\n639\t        }\n640\t    }\n641\t    if cache_was_read == 0 {\n642\t        (*sp).verts[0].iA = 0;\n643\t        (*sp).verts[0].iB = 0;\n644\t        (*sp).verts[0].sA = c2Mulxv(ax, *pAv.offset(0));\n645\t        (*sp).verts[0].sB = c2Mulxv(bx, *pBv.offset(0));\n646\t        (*sp).verts[0].p = c2Sub((*sp).verts[0].sB, (*sp).verts[0].sA);\n647\t        (*sp).verts[0].u = 1.0f32;\n648\t        (*sp).div = 1.0f32;\n649\t        (*sp).count = 1;\n650\t    }\n651\t    let mut saveA: [c_int; 3] = [0; 3];\n652\t    let mut saveB: [c_int; 3] = [0; 3];\n653\t    let sA_p: *mut c_int = saveA.as_mut_ptr();\n654\t    let sB_p: *mut c_int = saveB.as_mut_ptr();\n655\t    let mut save_count: c_int = 0;\n656\t    let mut d0: f32 = C2_FLT_MAX;\n657\t    let mut d1: f32 = C2_FLT_MAX;\n658\t    let mut iter: c_int = 0;\n659\t    let mut hit: c_int = 0;\n660\t    while iter < 20 {\n661\t        save_count = (*sp).count;\n662\t        let mut i: c_int = 0;\n663\t        while i < save_count {\n664\t            *sA_p.offset(i as isize) = (*verts.offset(i as isize)).iA;\n665\t            *sB_p.offset(i as isize) = (*verts.offset(i as isize)).iB;\n666\t            i += 1;\n667\t        }\n668\t        match (*sp).count {\n669\t            1 => {}\n670\t            2 => c22(sp),\n671\t            3 => c23(sp),\n672\t            _ => {}\n673\t        }\n674\t        if (*sp).count == 3 {\n675\t            hit = 1;\n676\t            break;\n677\t        }\n678\t        let p = c2L(sp);\n679\t        d1 = c2Dot(p, p);\n680\t        if d1 > d0 {\n681\t            break;\n682\t        }\n683\t        d0 = d1;\n684\t        let d = c2D(sp);\n685\t        if c2Dot(d, d) < C2_FLT_EPSILON_SQ {\n686\t            break;\n687\t        }\n688\t        let iA = c2Support(pAv, pA.count, c2MulrvT(ax.r, c2Neg(d)));\n689\t        let sA = c2Mulxv(ax, *pAv.offset(iA as isize));\n690\t        let iB = c2Support(pBv, pB.count, c2MulrvT(bx.r, d));\n691\t        let sB = c2Mulxv(bx, *pBv.offset(iB as isize));\n692\t        let v: *mut c2sv = verts.offset((*sp).count as isize);\n693\t        (*v).iA = iA;\n694\t        (*v).sA = sA;\n695\t        (*v).iB = iB;\n696\t        (*v).sB = sB;\n697\t        (*v).p = c2Sub((*v).sB, (*v).sA);\n698\t        let mut dup: c_int = 0;\n699\t        let mut i: c_int = 0;\n700\t        while i < save_count {\n701\t            if iA == *sA_p.offset(i as isize) && iB == *sB_p.offset(i as isize) {\n702\t                dup = 1;\n703\t                break;\n704\t            }\n705\t            i += 1;\n706\t        }\n707\t        if dup != 0 {\n708\t            break;\n709\t        }\n710\t        (*sp).count += 1;\n711\t        iter += 1;\n712\t    }\n713\t    let mut a = c2v::default();\n714\t    let mut b = c2v::default();\n715\t    c2Witness(sp, &mut a, &mut b);\n716\t    let mut dist = c2Len(c2Sub(a, b));\n717\t    if hit != 0 {\n718\t        a = b;\n719\t        dist = 0.0;\n720\t    } else if use_radius != 0 {\n721\t        let rA = pA.radius;\n722\t        let rB = pB.radius;\n723\t        if dist > add_ss(rA, rB) && dist > C2_FLT_EPSILON {\n724\t            dist = sub_ss(dist, add_ss(rA, rB));\n725\t            let n = c2Norm(c2Sub(b, a));\n726\t            a = c2Add(a, c2Mulvs(n, rA));\n727\t            b = c2Sub(b, c2Mulvs(n, rB));\n728\t            if a.x == b.x && a.y == b.y {\n729\t                dist = 0.0;\n730\t            }\n731\t        } else {\n732\t            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n733\t            a = p;\n734\t            b = p;\n735\t            dist = 0.0;\n736\t        }\n737\t    }\n738\t    if !cache.is_null() {\n739\t        (*cache).metric = c2GJKSimplexMetric(sp);\n740\t        (*cache).count = (*sp).count;\n741\t        let out_iA: *mut c_int = (*cache).iA.as_mut_ptr();\n742\t        let out_iB: *mut c_int = (*cache).iB.as_mut_ptr();\n743\t        let mut i: c_int = 0;\n744\t        while i < (*sp).count {\n745\t            let v: *mut c2sv = verts.offset(i as isize);\n746\t            *out_iA.offset(i as isize) = (*v).iA;\n747\t            *out_iB.offset(i as isize) = (*v).iB;\n748\t            i += 1;\n749\t        }\n750\t        (*cache).div = (*sp).div;\n751\t    }\n752\t    if !outA.is_null() {\n753\t        *outA = a;\n754\t    }\n755\t    if !outB.is_null() {\n756\t        *outB = b;\n757\t    }\n758\t    if !iterations.is_null() {\n759\t        *iterations = iter;\n760\t    }\n761\t    dist\n762\t}\n763\t\n764\t// ---------------------------------------------------------------------------\n765\t// Boolean collision routines\n766\t// ---------------------------------------------------------------------------\n767\t\n768\t#[unsafe(no_mangle)]\n769\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n770\t    let d0: c_int = (B.max.x < A.min.x) as c_int;\n771\t    let d1: c_int = (A.max.x < B.min.x) as c_int;\n772\t    let d2: c_int = (B.max.y < A.min.y) as c_int;\n773\t    let d3: c_int = (A.max.y < B.min.y) as c_int;\n774\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n775\t}\n776\t\n777\t#[unsafe(no_mangle)]\n778\tpub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n779\t    let a = A;\n780\t    let b = B;\n781\t    unsafe {\n782\t        if c2GJK(\n783\t            &a as *const c2AABB as *const c_void,\n784\t            C2_TYPE_AABB,\n785\t            std::ptr::null(),\n786\t            &b as *const c2Capsule as *const c_void,\n787\t            C2_TYPE_CAPSULE,\n788\t            std::ptr::null(),\n789\t            std::ptr::null_mut(),\n790\t            std::ptr::null_mut(),\n791\t            1,\n792\t            std::ptr::null_mut(),\n793\t            std::ptr::null_mut(),\n794\t        ) != 0.0\n795\t        {\n796\t            return 0;\n797\t        }\n798\t    }\n799\t    1\n800\t}\n801\t\n802\t#[unsafe(no_mangle)]\n803\tpub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n804\t    let a = A;\n805\t    let b = B;\n806\t    unsafe {\n807\t        if c2GJK(\n808\t            &a as *const c2Capsule as *const c_void,\n809\t            C2_TYPE_CAPSULE,\n810\t            std::ptr::null(),\n811\t            &b as *const c2Capsule as *const c_void,\n812\t            C2_TYPE_CAPSULE,\n813\t            std::ptr::null(),\n814\t            std::ptr::null_mut(),\n815\t            std::ptr::null_mut(),\n816\t            1,\n817\t            std::ptr::null_mut(),\n818\t            std::ptr::null_mut(),\n819\t        ) != 0.0\n820\t        {\n821\t            return 0;\n822\t        }\n823\t    }\n824\t    1\n825\t}\n826\t\n827\t#[unsafe(no_mangle)]\n828\tpub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n829\t    let c = c2Sub(B.p, A.p);\n830\t    let d2 = c2Dot(c, c);\n831\t    let mut r2 = add_ss(A.r, B.r);\n832\t    r2 = mul_ss(r2, r2);\n833\t    (d2 < r2) as c_int\n834\t}\n835\t\n836\t#[unsafe(no_mangle)]\n837\tpub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n838\t    let L = c2Clampv(A.p, B.min, B.max);\n839\t    let ab = c2Sub(A.p, L);\n840\t    let d2 = c2Dot(ab, ab);\n841\t    let r2 = mul_ss(A.r, A.r);\n842\t    (d2 < r2) as c_int\n843\t}\n844\t\n845\t#[unsafe(no_mangle)]\n846\tpub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n847\t    let n = c2Sub(B.b, B.a);\n848\t    let ap = c2Sub(A.p, B.a);\n849\t    let da = c2Dot(ap, n);\n850\t    let d2: f32;\n851\t    if da < 0.0 {\n852\t        d2 = c2Dot(ap, ap);\n853\t    } else {\n854\t        let db = c2Dot(c2Sub(A.p, B.b), n);\n855\t        if db < 0.0 {\n856\t            let e = c2Sub(ap, c2Mulvs(n, div_ss(da, c2Dot(n, n))));\n857\t            d2 = c2Dot(e, e);\n858\t        } else {\n859\t            let bp = c2Sub(A.p, B.b);\n860\t            d2 = c2Dot(bp, bp);\n861\t        }\n862\t    }\n863\t    let r = add_ss(A.r, B.r);\n864\t    (d2 < mul_ss(r, r)) as c_int\n865\t}\n866\t\n867\t#[unsafe(no_mangle)]\n868\tpub unsafe extern \"C\" fn c2Collided(\n869\t    A: *const c_void,\n870\t    typeA: c_int,\n871\t    B: *const c_void,\n872\t    typeB: c_int,\n873\t) -> c_int {\n874\t    match typeA {\n875\t        C2_TYPE_CIRCLE => match typeB {\n876\t            C2_TYPE_CIRCLE => c2CircletoCircle(\n877\t                (A as *const c2Circle).read_unaligned(),\n878\t                (B as *const c2Circle).read_unaligned(),\n879\t            ),\n880\t            C2_TYPE_AABB => c2CircletoAABB(\n881\t                (A as *const c2Circle).read_unaligned(),\n882\t                (B as *const c2AABB).read_unaligned(),\n883\t            ),\n884\t            C2_TYPE_CAPSULE => c2CircletoCapsule(\n885\t                (A as *const c2Circle).read_unaligned(),\n886\t                (B as *const c2Capsule).read_unaligned(),\n887\t            ),\n888\t            _ => 0,\n889\t        },\n890\t        C2_TYPE_AABB => match typeB {\n891\t            C2_TYPE_CIRCLE => c2CircletoAABB(\n892\t                (B as *const c2Circle).read_unaligned(),\n893\t                (A as *const c2AABB).read_unaligned(),\n894\t            ),\n895\t            C2_TYPE_AABB => c2AABBtoAABB(\n896\t                (A as *const c2AABB).read_unaligned(),\n897\t                (B as *const c2AABB).read_unaligned(),\n898\t            ),\n899\t            C2_TYPE_CAPSULE => c2AABBtoCapsule(\n900\t                (A as *const c2AABB).read_unaligned(),\n901\t                (B as *const c2Capsule).read_unaligned(),\n902\t            ),\n903\t            _ => 0,\n904\t        },\n905\t        C2_TYPE_CAPSULE => match typeB {\n906\t            C2_TYPE_CIRCLE => c2CircletoCapsule(\n907\t                (B as *const c2Circle).read_unaligned(),\n908\t                (A as *const c2Capsule).read_unaligned(),\n909\t            ),\n910\t            C2_TYPE_AABB => c2AABBtoCapsule(\n911\t                (B as *const c2AABB).read_unaligned(),\n912\t                (A as *const c2Capsule).read_unaligned(),\n913\t            ),\n914\t            C2_TYPE_CAPSULE => c2CapsuletoCapsule(\n915\t                (A as *const c2Capsule).read_unaligned(),\n916\t                (B as *const c2Capsule).read_unaligned(),\n917\t            ),\n918\t            _ => 0,\n919\t        },\n920\t        _ => 0,\n921\t    }\n922\t}\n923\t\n924\t// ---------------------------------------------------------------------------\n925\t// Public entry point declared in include/lib.h\n926\t// ---------------------------------------------------------------------------\n927\t\n928\t#[unsafe(no_mangle)]\n929\tpub extern \"C\" fn capsule(min_x: f32, min_y: f32, max_x: f32, max_y: f32, r: f32) -> c_int {\n930\t    let mut result: c_int = 0;\n931\t\n932\t    let mut capsule_in = c2Capsule::default();\n933\t    capsule_in.a = c2V(min_x, min_y);\n934\t    capsule_in.b = c2V(max_x, max_y);\n935\t    capsule_in.r = r;\n936\t\n937\t    let mut circle = c2Circle::default();\n938\t    circle.p = c2V(-70.0f32, 0.0);\n939\t    circle.r = 20.0f32;\n940\t\n941\t    let mut aabb = c2AABB::default();\n942\t    aabb.min = c2V(-40.0f32, -40.0f32);\n943\t    aabb.max = c2V(-15.0f32, -15.0f32);\n944\t\n945\t    // Named `capsule` in the C source, where it shadows the function name.\n946\t    let mut capsule_local = c2Capsule::default();\n947\t    capsule_local.a = c2V(-40.0f32, 40.0f32);\n948\t    capsule_local.b = c2V(-20.0f32, 100.0f32);\n949\t    capsule_local.r = 10.0f32;\n950\t\n951\t    unsafe {\n952\t        result += c2Collided(\n953\t            &circle as *const c2Circle as *const c_void,\n954\t            C2_TYPE_CIRCLE,\n955\t            &capsule_in as *const c2Capsule as *const c_void,\n956\t            C2_TYPE_CAPSULE,\n957\t        );\n958\t\n959\t        result += c2Collided(\n960\t            &aabb as *const c2AABB as *const c_void,\n961\t            C2_TYPE_AABB,\n962\t            &capsule_in as *const c2Capsule as *const c_void,\n963\t            C2_TYPE_CAPSULE,\n964\t        ) << 1;\n965\t\n966\t        result += c2Collided(\n967\t            &capsule_local as *const c2Capsule as *const c_void,\n968\t            C2_TYPE_CAPSULE,\n969\t            &capsule_in as *const c2Capsule as *const c_void,\n970\t            C2_TYPE_CAPSULE,\n971\t        ) << 2;\n972\t    }\n973\t\n974\t    result\n975\t}\n976\t"}]},"parent_tool_use_id":null,"session_id":"7ed8914d-6817-4736-8f37-e5881dd5b50c","uuid":"53c378d8-3d25-4755-a931-958fbda2ed51","timestamp":"2026-09-05T06:38:24.167Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-sQlHPw/translation/src/lib.rs","content":"//! Rust translation of the C library in `c_src/` (a cute_c2 derived 2D\n//! collision library plus the `capsule` entry point declared in `include/lib.h`).\n//!\n//! Every non-static C function is reproduced with the exact same linker name,\n//! signature and observable behaviour, including its quirks (fall-through\n//! `switch` labels, the inverted GJK cache-validity test, reading a shape\n//! through an unchecked `void*` cast, ...).\n//!\n//! Bit-exactness note: all arithmetic is single precision, evaluated in the\n//! same association order as the C.  On top of that, the tiny `*_ss` helpers\n//! below reproduce x86 SSE NaN-propagation (the *destination* operand of\n//! `mulss`/`addss`/`subss`/`divss` wins, a signalling NaN is quieted, and an\n//! invalid operation on two non-NaN operands yields the \"indefinite\" QNaN\n//! `0xFFC00000`).  The destination operand chosen at each call site mirrors the\n//! instruction GCC emits for the original source, so even NaN payloads and\n//! sign bits come out identical.\n\n#![allow(\n    non_snake_case,\n    non_camel_case_types,\n    non_upper_case_globals,\n    unused_assignments,\n    unused_variables,\n    unused_mut\n)]\n\nuse std::ffi::{c_int, c_void};\n\n// ---------------------------------------------------------------------------\n// typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;\n// ---------------------------------------------------------------------------\npub const C2_TYPE_CIRCLE: c_int = 0;\npub const C2_TYPE_AABB: c_int = 1;\npub const C2_TYPE_CAPSULE: c_int = 2;\n\n/// `FLT_MAX`, spelled exactly as in the C source.\nconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38;\n/// `FLT_EPSILON`, spelled exactly as in the C source.\nconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7;\n/// `FLT_EPSILON * FLT_EPSILON` (exactly 2^-46, matching GCC's constant folding).\nconst C2_FLT_EPSILON_SQ: f32 = C2_FLT_EPSILON * C2_FLT_EPSILON;\n\n// ---------------------------------------------------------------------------\n// x86 SSE scalar arithmetic helpers (see the bit-exactness note above)\n// ---------------------------------------------------------------------------\n\n#[inline(always)]\nfn quiet_nan(x: f32) -> f32 {\n    // x86 turns a signalling NaN into a quiet one by setting the significand MSB\n    // while preserving the sign bit and the rest of the payload.\n    f32::from_bits(x.to_bits() | 0x0040_0000)\n}\n\n/// `mulss dst, src`\n#[inline(always)]\nfn mul_ss(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet_nan(dst)\n    } else if src.is_nan() {\n        quiet_nan(src)\n    } else {\n        // Neither operand is a NaN, so the hardware result no longer depends on\n        // which operand is the destination.\n        dst * src\n    }\n}\n\n/// `addss dst, src`\n#[inline(always)]\nfn add_ss(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet_nan(dst)\n    } else if src.is_nan() {\n        quiet_nan(src)\n    } else {\n        dst + src\n    }\n}\n\n/// `subss dst, src` (computes `dst - src`)\n#[inline(always)]\nfn sub_ss(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet_nan(dst)\n    } else if src.is_nan() {\n        quiet_nan(src)\n    } else {\n        dst - src\n    }\n}\n\n/// `divss dst, src` (computes `dst / src`)\n#[inline(always)]\nfn div_ss(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet_nan(dst)\n    } else if src.is_nan() {\n        quiet_nan(src)\n    } else {\n        dst / src\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Plain-old-data types (layout identical to the C structs)\n// ---------------------------------------------------------------------------\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\npub struct c2GJKCache {\n    pub metric: f32,\n    pub count: c_int,\n    pub iA: [c_int; 3],\n    pub iB: [c_int; 3],\n    pub div: f32,\n}\n\n/// `typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;`\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\npub struct c2Proxy {\n    pub radius: f32,\n    pub count: c_int,\n    pub verts: [c2v; 8],\n}\n\n/// `typedef struct { c2v sA, sB, p; float u; int iA, iB; } c2sv;`\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\npub struct c2sv {\n    pub sA: c2v,\n    pub sB: c2v,\n    pub p: c2v,\n    pub u: f32,\n    pub iA: c_int,\n    pub iB: c_int,\n}\n\n/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n///\n/// The four `c2sv` members are held in an array so that the C idiom\n/// `c2sv* verts = &s.a; verts[i]` can be reproduced verbatim; the memory layout\n/// is byte-for-byte identical to the C declaration (4 * 36 + 4 + 4 = 152 bytes).\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\npub struct c2Simplex {\n    pub verts: [c2sv; 4],\n    pub div: f32,\n    pub count: c_int,\n}\n\n// ---------------------------------------------------------------------------\n// Basic vector maths\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a = c2v::default();\n    a.x = x;\n    a.y = y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x = mul_ss(a.x, b);\n    a.y = mul_ss(a.y, b);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    a.x = sub_ss(a.x, b.x);\n    a.y = sub_ss(a.y, b.y);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    // mulss dst=a.x ; mulss dst=b.y ; addss dst=(a.y*b.y term)\n    let p1 = mul_ss(a.x, b.x);\n    let p2 = mul_ss(b.y, a.y);\n    add_ss(p2, p1)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    let mut r = c2r::default();\n    r.c = 1.0f32;\n    r.s = 0.0;\n    r\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    let mut x = c2x::default();\n    x.p = c2V(0.0, 0.0);\n    x.r = c2RotIdentity();\n    x\n}\n\n// ---------------------------------------------------------------------------\n// Proxies\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    *out.add(0) = (*bb).min;\n    *out.add(1) = c2V((*bb).max.x, (*bb).min.y);\n    *out.add(2) = (*bb).max;\n    *out.add(3) = c2V((*bb).min.x, (*bb).max.y);\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n    match type_ {\n        C2_TYPE_CIRCLE => {\n            let c = shape as *mut c2Circle;\n            (*p).radius = (*c).r;\n            (*p).count = 1;\n            (*p).verts[0] = (*c).p;\n        }\n        C2_TYPE_AABB => {\n            let bb = shape as *mut c2AABB;\n            (*p).radius = 0.0;\n            (*p).count = 4;\n            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n        }\n        C2_TYPE_CAPSULE => {\n            let c = shape as *mut c2Capsule;\n            (*p).radius = (*c).r;\n            (*p).count = 2;\n            (*p).verts[0] = (*c).a;\n            (*p).verts[1] = (*c).b;\n        }\n        // The C `switch` has no `default:` label, so nothing is written.\n        _ => {}\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Simplex helpers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    // sqrtf(c2Dot(a, a)) -- `sqrtss`, so a negative operand yields the\n    // indefinite QNaN and a NaN operand is merely quieted.\n    c2Dot(a, a).sqrt()\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    // mulss dst=b.y ; mulss dst=b.x ; subss dst=first term\n    let t1 = mul_ss(b.y, a.x);\n    let t2 = mul_ss(b.x, a.y);\n    sub_ss(t1, t2)\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    match (*s).count {\n        2 => c2Len(c2Sub((*s).verts[1].p, (*s).verts[0].p)),\n        3 => c2Det2(\n            c2Sub((*s).verts[1].p, (*s).verts[0].p),\n            c2Sub((*s).verts[2].p, (*s).verts[0].p),\n        ),\n        // `default:` falls through into `case 1:`, which returns 0.\n        _ => 0.0,\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    // x = a.c * b.x - a.s * b.y  ->  subss(mulss dst=b.x, mulss dst=b.y)\n    // y = a.s * b.x + a.c * b.y  ->  addss(mulss dst=a.s, mulss dst=b.y)\n    let x = sub_ss(mul_ss(b.x, a.c), mul_ss(b.y, a.s));\n    let y = add_ss(mul_ss(a.s, b.x), mul_ss(b.y, a.c));\n    c2V(x, y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n    // addss dst=b.x / dst=b.y\n    a.x = add_ss(b.x, a.x);\n    a.y = add_ss(b.y, a.y);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    let a = (*s).verts[0].p;\n    let b = (*s).verts[1].p;\n    let u = c2Dot(b, c2Sub(b, a));\n    let v = c2Dot(a, c2Sub(a, b));\n    if v <= 0.0 {\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if u <= 0.0 {\n        (*s).verts[0] = (*s).verts[1];\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else {\n        (*s).verts[0].u = u;\n        (*s).verts[1].u = v;\n        (*s).div = add_ss(u, v);\n        (*s).count = 2;\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n    let a = (*s).verts[0].p;\n    let b = (*s).verts[1].p;\n    let c = (*s).verts[2].p;\n    let uAB = c2Dot(b, c2Sub(b, a));\n    let vAB = c2Dot(a, c2Sub(a, b));\n    let uBC = c2Dot(c, c2Sub(c, b));\n    let vBC = c2Dot(b, c2Sub(b, c));\n    let uCA = c2Dot(a, c2Sub(a, c));\n    let vCA = c2Dot(c, c2Sub(c, a));\n    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n    let uABC = mul_ss(c2Det2(b, c), area);\n    let vABC = mul_ss(c2Det2(c, a), area);\n    let wABC = mul_ss(c2Det2(a, b), area);\n    if vAB <= 0.0 && uCA <= 0.0 {\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uAB <= 0.0 && vBC <= 0.0 {\n        (*s).verts[0] = (*s).verts[1];\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uBC <= 0.0 && vCA <= 0.0 {\n        (*s).verts[0] = (*s).verts[2];\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n        (*s).verts[0].u = uAB;\n        (*s).verts[1].u = vAB;\n        (*s).div = add_ss(uAB, vAB);\n        (*s).count = 2;\n    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n        (*s).verts[0] = (*s).verts[1];\n        (*s).verts[1] = (*s).verts[2];\n        (*s).verts[0].u = uBC;\n        (*s).verts[1].u = vBC;\n        (*s).div = add_ss(uBC, vBC);\n        (*s).count = 2;\n    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n        (*s).verts[1] = (*s).verts[0];\n        (*s).verts[0] = (*s).verts[2];\n        (*s).verts[0].u = uCA;\n        (*s).verts[1].u = vCA;\n        (*s).div = add_ss(uCA, vCA);\n        (*s).count = 2;\n    } else {\n        (*s).verts[0].u = uABC;\n        (*s).verts[1].u = vABC;\n        (*s).verts[2].u = wABC;\n        (*s).div = add_ss(add_ss(uABC, vABC), wABC);\n        (*s).count = 3;\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    // `xorps` with the sign mask: flips the sign bit of NaNs too.\n    c2V(-a.x, -a.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    let mut b = c2v::default();\n    b.x = -a.y;\n    b.y = a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    let mut b = c2v::default();\n    b.x = a.y;\n    b.y = -a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    match (*s).count {\n        1 => c2Neg((*s).verts[0].p),\n        2 => {\n            let ab = c2Sub((*s).verts[1].p, (*s).verts[0].p);\n            if c2Det2(ab, c2Neg((*s).verts[0].p)) > 0.0 {\n                return c2Skew(ab);\n            }\n            c2CCW90(ab)\n        }\n        // `case 3:` and `default:`\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    let mut imax: c_int = 0;\n    let mut dmax = c2Dot(*verts.add(0), d);\n    let mut i: c_int = 1;\n    while i < count {\n        let dot = c2Dot(*verts.offset(i as isize), d);\n        if dot > dmax {\n            imax = i;\n            dmax = dot;\n        }\n        i += 1;\n    }\n    imax\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n    let den = div_ss(1.0f32, (*s).div);\n    match (*s).count {\n        1 => {\n            *a = (*s).verts[0].sA;\n            *b = (*s).verts[0].sB;\n        }\n        2 => {\n            *a = c2Add(\n                c2Mulvs((*s).verts[0].sA, mul_ss((*s).verts[0].u, den)),\n                c2Mulvs((*s).verts[1].sA, mul_ss((*s).verts[1].u, den)),\n            );\n            *b = c2Add(\n                c2Mulvs((*s).verts[0].sB, mul_ss((*s).verts[0].u, den)),\n                c2Mulvs((*s).verts[1].sB, mul_ss((*s).verts[1].u, den)),\n            );\n        }\n        3 => {\n            *a = c2Add(\n                c2Add(\n                    c2Mulvs((*s).verts[0].sA, mul_ss((*s).verts[0].u, den)),\n                    c2Mulvs((*s).verts[1].sA, mul_ss((*s).verts[1].u, den)),\n                ),\n                c2Mulvs((*s).verts[2].sA, mul_ss((*s).verts[2].u, den)),\n            );\n            *b = c2Add(\n                c2Add(\n                    c2Mulvs((*s).verts[0].sB, mul_ss((*s).verts[0].u, den)),\n                    c2Mulvs((*s).verts[1].sB, mul_ss((*s).verts[1].u, den)),\n                ),\n                c2Mulvs((*s).verts[2].sB, mul_ss((*s).verts[2].u, den)),\n            );\n        }\n        _ => {\n            *a = c2V(0.0, 0.0);\n            *b = c2V(0.0, 0.0);\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, div_ss(1.0f32, b))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n    let den = div_ss(1.0f32, (*s).div);\n    match (*s).count {\n        1 => (*s).verts[0].p,\n        2 => c2Add(\n            c2Mulvs((*s).verts[0].p, mul_ss((*s).verts[0].u, den)),\n            c2Mulvs((*s).verts[1].p, mul_ss((*s).verts[1].u, den)),\n        ),\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    // x =  a.c * b.x + a.s * b.y  ->  addss(mulss dst=a.c, mulss dst=b.y)\n    // y = -a.s * b.x + a.c * b.y  ->  addss(mulss dst=(-a.s), mulss dst=b.y)\n    let x = add_ss(mul_ss(a.c, b.x), mul_ss(b.y, a.s));\n    let y = add_ss(mul_ss(-a.s, b.x), mul_ss(b.y, a.c));\n    c2V(x, y)\n}\n\n// ---------------------------------------------------------------------------\n// GJK\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJK(\n    A: *const c_void,\n    typeA: c_int,\n    ax_ptr: *const c2x,\n    B: *const c_void,\n    typeB: c_int,\n    bx_ptr: *const c2x,\n    outA: *mut c2v,\n    outB: *mut c2v,\n    use_radius: c_int,\n    iterations: *mut c_int,\n    cache: *mut c2GJKCache,\n) -> f32 {\n    let ax: c2x;\n    let bx: c2x;\n    if ax_ptr.is_null() {\n        ax = c2xIdentity();\n    } else {\n        ax = *ax_ptr;\n    }\n    if bx_ptr.is_null() {\n        bx = c2xIdentity();\n    } else {\n        bx = *bx_ptr;\n    }\n    let mut pA = c2Proxy::default();\n    let mut pB = c2Proxy::default();\n    c2MakeProxy(A, typeA, &mut pA);\n    c2MakeProxy(B, typeB, &mut pB);\n    // Raw views of the fixed-size C arrays: the original indexes them without\n    // any bounds check, so Rust must not introduce a panicking one either.\n    let pAv: *const c2v = pA.verts.as_ptr();\n    let pBv: *const c2v = pB.verts.as_ptr();\n    let mut s = c2Simplex::default();\n    let sp: *mut c2Simplex = &mut s;\n    let verts: *mut c2sv = (*sp).verts.as_mut_ptr();\n    let mut cache_was_read: c_int = 0;\n    if !cache.is_null() {\n        let cache_iA: *const c_int = (*cache).iA.as_ptr();\n        let cache_iB: *const c_int = (*cache).iB.as_ptr();\n        let cache_was_good: c_int = ((*cache).count != 0) as c_int;\n        if cache_was_good != 0 {\n            let mut i: c_int = 0;\n            while i < (*cache).count {\n                let iA = *cache_iA.offset(i as isize);\n                let iB = *cache_iB.offset(i as isize);\n                let sA = c2Mulxv(ax, *pAv.offset(iA as isize));\n                let sB = c2Mulxv(bx, *pBv.offset(iB as isize));\n                let v: *mut c2sv = verts.offset(i as isize);\n                (*v).iA = iA;\n                (*v).sA = sA;\n                (*v).iB = iB;\n                (*v).sB = sB;\n                (*v).p = c2Sub((*v).sB, (*v).sA);\n                (*v).u = 0.0;\n                i += 1;\n            }\n            (*sp).count = (*cache).count;\n            (*sp).div = (*cache).div;\n            let metric_old = (*cache).metric;\n            let metric = c2GJKSimplexMetric(sp);\n            let min_metric = if metric < metric_old { metric } else { metric_old };\n            let max_metric = if metric > metric_old { metric } else { metric_old };\n            // NOTE: reproduced verbatim from the C -- the `metric < -1.0e8f`\n            // term makes this test almost always true.\n            if !(min_metric < mul_ss(max_metric, 2.0f32) && metric < -1.0e8f32) {\n                cache_was_read = 1;\n            }\n        }\n    }\n    if cache_was_read == 0 {\n        (*sp).verts[0].iA = 0;\n        (*sp).verts[0].iB = 0;\n        (*sp).verts[0].sA = c2Mulxv(ax, *pAv.offset(0));\n        (*sp).verts[0].sB = c2Mulxv(bx, *pBv.offset(0));\n        (*sp).verts[0].p = c2Sub((*sp).verts[0].sB, (*sp).verts[0].sA);\n        (*sp).verts[0].u = 1.0f32;\n        (*sp).div = 1.0f32;\n        (*sp).count = 1;\n    }\n    let mut saveA: [c_int; 3] = [0; 3];\n    let mut saveB: [c_int; 3] = [0; 3];\n    let sA_p: *mut c_int = saveA.as_mut_ptr();\n    let sB_p: *mut c_int = saveB.as_mut_ptr();\n    let mut save_count: c_int = 0;\n    let mut d0: f32 = C2_FLT_MAX;\n    let mut d1: f32 = C2_FLT_MAX;\n    let mut iter: c_int = 0;\n    let mut hit: c_int = 0;\n    while iter < 20 {\n        save_count = (*sp).count;\n        let mut i: c_int = 0;\n        while i < save_count {\n            *sA_p.offset(i as isize) = (*verts.offset(i as isize)).iA;\n            *sB_p.offset(i as isize) = (*verts.offset(i as isize)).iB;\n            i += 1;\n        }\n        match (*sp).count {\n            1 => {}\n            2 => c22(sp),\n            3 => c23(sp),\n            _ => {}\n        }\n        if (*sp).count == 3 {\n            hit = 1;\n            break;\n        }\n        let p = c2L(sp);\n        d1 = c2Dot(p, p);\n        if d1 > d0 {\n            break;\n        }\n        d0 = d1;\n        let d = c2D(sp);\n        if c2Dot(d, d) < C2_FLT_EPSILON_SQ {\n            break;\n        }\n        let iA = c2Support(pAv, pA.count, c2MulrvT(ax.r, c2Neg(d)));\n        let sA = c2Mulxv(ax, *pAv.offset(iA as isize));\n        let iB = c2Support(pBv, pB.count, c2MulrvT(bx.r, d));\n        let sB = c2Mulxv(bx, *pBv.offset(iB as isize));\n        let v: *mut c2sv = verts.offset((*sp).count as isize);\n        (*v).iA = iA;\n        (*v).sA = sA;\n        (*v).iB = iB;\n        (*v).sB = sB;\n        (*v).p = c2Sub((*v).sB, (*v).sA);\n        let mut dup: c_int = 0;\n        let mut i: c_int = 0;\n        while i < save_count {\n            if iA == *sA_p.offset(i as isize) && iB == *sB_p.offset(i as isize) {\n                dup = 1;\n                break;\n            }\n            i += 1;\n        }\n        if dup != 0 {\n            break;\n        }\n        (*sp).count += 1;\n        iter += 1;\n    }\n    let mut a = c2v::default();\n    let mut b = c2v::default();\n    c2Witness(sp, &mut a, &mut b);\n    let mut dist = c2Len(c2Sub(a, b));\n    if hit != 0 {\n        a = b;\n        dist = 0.0;\n    } else if use_radius != 0 {\n        let rA = pA.radius;\n        let rB = pB.radius;\n        if dist > add_ss(rA, rB) && dist > C2_FLT_EPSILON {\n            dist = sub_ss(dist, add_ss(rA, rB));\n            let n = c2Norm(c2Sub(b, a));\n            a = c2Add(a, c2Mulvs(n, rA));\n            b = c2Sub(b, c2Mulvs(n, rB));\n            if a.x == b.x && a.y == b.y {\n                dist = 0.0;\n            }\n        } else {\n            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n            a = p;\n            b = p;\n            dist = 0.0;\n        }\n    }\n    if !cache.is_null() {\n        (*cache).metric = c2GJKSimplexMetric(sp);\n        (*cache).count = (*sp).count;\n        let out_iA: *mut c_int = (*cache).iA.as_mut_ptr();\n        let out_iB: *mut c_int = (*cache).iB.as_mut_ptr();\n        let mut i: c_int = 0;\n        while i < (*sp).count {\n            let v: *mut c2sv = verts.offset(i as isize);\n            *out_iA.offset(i as isize) = (*v).iA;\n            *out_iB.offset(i as isize) = (*v).iB;\n            i += 1;\n        }\n        (*cache).div = (*sp).div;\n    }\n    if !outA.is_null() {\n        *outA = a;\n    }\n    if !outB.is_null() {\n        *outB = b;\n    }\n    if !iterations.is_null() {\n        *iterations = iter;\n    }\n    dist\n}\n\n// ---------------------------------------------------------------------------\n// Boolean collision routines\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n    let d0: c_int = (B.max.x < A.min.x) as c_int;\n    let d1: c_int = (A.max.x < B.min.x) as c_int;\n    let d2: c_int = (B.max.y < A.min.y) as c_int;\n    let d3: c_int = (A.max.y < B.min.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n    let a = A;\n    let b = B;\n    unsafe {\n        if c2GJK(\n            &a as *const c2AABB as *const c_void,\n            C2_TYPE_AABB,\n            std::ptr::null(),\n            &b as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            std::ptr::null(),\n            std::ptr::null_mut(),\n            std::ptr::null_mut(),\n            1,\n            std::ptr::null_mut(),\n            std::ptr::null_mut(),\n        ) != 0.0\n        {\n            return 0;\n        }\n    }\n    1\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n    let a = A;\n    let b = B;\n    unsafe {\n        if c2GJK(\n            &a as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            std::ptr::null(),\n            &b as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            std::ptr::null(),\n            std::ptr::null_mut(),\n            std::ptr::null_mut(),\n            1,\n            std::ptr::null_mut(),\n            std::ptr::null_mut(),\n        ) != 0.0\n        {\n            return 0;\n        }\n    }\n    1\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n    let c = c2Sub(B.p, A.p);\n    let d2 = c2Dot(c, c);\n    let mut r2 = add_ss(A.r, B.r);\n    r2 = mul_ss(r2, r2);\n    (d2 < r2) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n    let L = c2Clampv(A.p, B.min, B.max);\n    let ab = c2Sub(A.p, L);\n    let d2 = c2Dot(ab, ab);\n    let r2 = mul_ss(A.r, A.r);\n    (d2 < r2) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n    let n = c2Sub(B.b, B.a);\n    let ap = c2Sub(A.p, B.a);\n    let da = c2Dot(ap, n);\n    let d2: f32;\n    if da < 0.0 {\n        d2 = c2Dot(ap, ap);\n    } else {\n        let db = c2Dot(c2Sub(A.p, B.b), n);\n        if db < 0.0 {\n            let e = c2Sub(ap, c2Mulvs(n, div_ss(da, c2Dot(n, n))));\n            d2 = c2Dot(e, e);\n        } else {\n            let bp = c2Sub(A.p, B.b);\n            d2 = c2Dot(bp, bp);\n        }\n    }\n    let r = add_ss(A.r, B.r);\n    (d2 < mul_ss(r, r)) as c_int\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Collided(\n    A: *const c_void,\n    typeA: c_int,\n    B: *const c_void,\n    typeB: c_int,\n) -> c_int {\n    match typeA {\n        C2_TYPE_CIRCLE => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoCircle(\n                (A as *const c2Circle).read_unaligned(),\n                (B as *const c2Circle).read_unaligned(),\n            ),\n            C2_TYPE_AABB => c2CircletoAABB(\n                (A as *const c2Circle).read_unaligned(),\n                (B as *const c2AABB).read_unaligned(),\n            ),\n            C2_TYPE_CAPSULE => c2CircletoCapsule(\n                (A as *const c2Circle).read_unaligned(),\n                (B as *const c2Capsule).read_unaligned(),\n            ),\n            _ => 0,\n        },\n        C2_TYPE_AABB => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoAABB(\n                (B as *const c2Circle).read_unaligned(),\n                (A as *const c2AABB).read_unaligned(),\n            ),\n            C2_TYPE_AABB => c2AABBtoAABB(\n                (A as *const c2AABB).read_unaligned(),\n                (B as *const c2AABB).read_unaligned(),\n            ),\n            C2_TYPE_CAPSULE => c2AABBtoCapsule(\n                (A as *const c2AABB).read_unaligned(),\n                (B as *const c2Capsule).read_unaligned(),\n            ),\n            _ => 0,\n        },\n        C2_TYPE_CAPSULE => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoCapsule(\n                (B as *const c2Circle).read_unaligned(),\n                (A as *const c2Capsule).read_unaligned(),\n            ),\n            C2_TYPE_AABB => c2AABBtoCapsule(\n                (B as *const c2AABB).read_unaligned(),\n                (A as *const c2Capsule).read_unaligned(),\n            ),\n            C2_TYPE_CAPSULE => c2CapsuletoCapsule(\n                (A as *const c2Capsule).read_unaligned(),\n                (B as *const c2Capsule).read_unaligned(),\n            ),\n            _ => 0,\n        },\n        _ => 0,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Public entry point declared in include/lib.h\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn capsule(min_x: f32, min_y: f32, max_x: f32, max_y: f32, r: f32) -> c_int {\n    let mut result: c_int = 0;\n\n    let mut capsule_in = c2Capsule::default();\n    capsule_in.a = c2V(min_x, min_y);\n    capsule_in.b = c2V(max_x, max_y);\n    capsule_in.r = r;\n\n    let mut circle = c2Circle::default();\n    circle.p = c2V(-70.0f32, 0.0);\n    circle.r = 20.0f32;\n\n    let mut aabb = c2AABB::default();\n    aabb.min = c2V(-40.0f32, -40.0f32);\n    aabb.max = c2V(-15.0f32, -15.0f32);\n\n    // Named `capsule` in the C source, where it shadows the function name.\n    let mut capsule_local = c2Capsule::default();\n    capsule_local.a = c2V(-40.0f32, 40.0f32);\n    capsule_local.b = c2V(-20.0f32, 100.0f32);\n    capsule_local.r = 10.0f32;\n\n    unsafe {\n        result += c2Collided(\n            &circle as *const c2Circle as *const c_void,\n            C2_TYPE_CIRCLE,\n            &capsule_in as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n        );\n\n        result += c2Collided(\n            &aabb as *const c2AABB as *const c_void,\n            C2_TYPE_AABB,\n            &capsule_in as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n        ) << 1;\n\n        result += c2Collided(\n            &capsule_local as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            &capsule_in as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n        ) << 2;\n    }\n\n    result\n}\n","numLines":976,"startLine":1,"totalLines":976}}}
