Handmade(2),\n        CacheMode::Handmade(3),\n    ];\n    let mut n = 0usize;\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for &ur in &[0i32, 1] {\n                for &axm in &xmodes {\n                    for &bxm in &xmodes {\n                        for &cm in &cmodes {\n                            for _ in 0..n_cases(8) {\n                                let sa = rand_shape(&mut rng, ta);\n                                let sb = rand_shape(&mut rng, tb);\n                                gjk_case(\n                                    &mut rng,\n                                    sa,\n                                    sb,\n                                    axm,\n                                    bxm,\n                                    GjkCfg { use_radius: ur, ..Default::default() },\n                                    cm,\n                                );\n                                n += 1;\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n    assert!(n >= 1900, \"cross product too small: {n}\");\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
