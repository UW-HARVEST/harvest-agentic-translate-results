parating axis dropped|||    let d3 = (B.y > A.max.y) as c_int;|||    let d3 = 0 as c_int;\""," \"c2Skew: negate the wrong lane|||    b.x = -a.y;","     b.y = a.x;|||    b.x = a.y;","     b.y = -a.x;\"","-\"c2Len: sqrt of the wrong thing (abs of dot)|||    fsqrt(dot(a, a))|||    fsqrt(abs_ternary(dot(a, a)))\"","+\"c2CCW90: negate the wrong lane|||    b.x = a.y;","+    b.y = -a.x;|||    b.x = -a.y;","+    b.y = a.x;\"","+\"c2RaytoCapsule: capsule_bb.min uses +B.r|||    capsule_bb.min = c2v_new(-B.r, 0.0);|||    capsule_bb.min = c2v_new(B.r, 0.0);\"","+\"c2RaytoCapsule: out->n pre-set skipped|||        (*out).n = norm(cap_n);","+        (*out).t = 0.0;|||        (*out).t = 0.0;\"","+\"c2CastRay: return 0 for out-of-range typeB instead of preserving %eax|||        \\\"cmp esi, 2\\\",","+        \\\"ja 2f\\\",|||        \\\"cmp esi, 2\\\",","+        \\\"ja 8f\\\",","+        \\\"jmp {dispatch}\\\",","+        \\\"8:\\\",","+        \\\"xor eax, eax\\\",","+        \\\"ret\\\",","+        \\\"ja 2f\\\",\"","+\"c2CastRay: signed range check (accepts negative typeB)|||        \\\"cmp esi, 2\\\",","+        \\\"ja 2f\\\",|||        \\\"cmp esi, 2\\\",","+        \\\"jg 2f\\\",\"","+\"gen_ray: capsule result shifted by 3 instead of 1|||        } << 1,|||        } << 3,\"","+\"gen_ray: aabb result shifted by 1 instead of 2|||C2_TYPE_AABB, cast3) } << 2,|||C2_TYPE_AABB, cast3) } << 1,\"","+\"gen_ray: cast1/cast2 out-pointers swapped|||C2_TYPE_CIRCLE, cast1)|||C2_TYPE_CIRCLE, cast2)\"","+\"gen_ray: ray.d not normalised|||    ray.d = norm(sub(mp, ray.p));|||    ray.d = sub(mp, ray.p);\""," )"," ","-printf '%-72s %s\\n' \"MUTATION\" \"RESULT\"","-printf '%.0s-' {1..86}; echo","+printf '%-74s %s\\n' \"MUTATION\" \"RESULT\"","+printf '%.0s-' {1..100}; echo"," ","+survivors=0","+killed=0","+skipped=0","+bad_survivors=()","+"," for m in \"${mutations[@]}\"; do","     desc=\"${m%%|||*}\"","     rest=\"${m#*|||}\""]},{"oldStart":77,"oldLines":29,"newStart":173,"newLines":38,"lines":[" import sys"," path, frm, to = sys.argv[1], sys.argv[2], sys.argv[3]"," s = open(path).read()","-n = s.count(frm)","-if n == 0:","+if s.count(frm) != 1:","     sys.exit(2)"," open(path, 'w').write(s.replace(frm, to, 1))"," PY","     then","-        printf '%-72s %s\\n' \"$desc\" \"SKIP (pattern not found)\"","+        printf '%-74s %s\\n' \"$desc\" \"SKIP (pattern not unique/found)\"","+        skipped=$((skipped + 1))","         continue","     fi"," ","     if ! cargo build --offline --release >\"$LOGDIR/mut_build.log\" 2>&1; then","-        printf '%-72s %s\\n' \"$desc\" \"KILLED (compile error)\"","+        printf '%-74s %s\\n' \"$desc\" \"KILLED (compile error)\"","         killed=$((killed + 1))","         continue","     fi"," ","     if cargo test --offline --release >\"$LOGDIR/mut_test.log\" 2>&1; then","-        printf '%-72s %s\\n' \"$desc\" \"*** SURVIVED ***\"","+        if [[ -n \"${EXPECTED_SURVIVOR[$desc]:-}\" ]]; then","+            printf '%-74s %s\\n' \"$desc\" \"survived (EXPECTED: equivalent mutant)\"","+        else","+            printf '%-74s %s\\n' \"$desc\" \"*** SURVIVED — BLIND SPOT ***\"","+            bad_survivors+=(\"$desc\")","+        fi","         survivors=$((survivors + 1))","     else","         first=$(grep -oE '^---- [a-z0-9_]+' \"$LOGDIR/mut_test.log\" | head -n1 | sed 's/---- //')","-        printf '%-72s %s\\n' \"$desc\" \"killed by ${first:-a test}\"","+        printf '%-74s %s\\n' \"$desc\" \"killed by ${first:-a test}\"","         killed=$((killed + 1))","+        if [[ -n \"${EXPECTED_SURVIVOR[$desc]:-}\" ]]; then","+            echo \"    NOTE: this was listed as an equivalent mutant but was killed —\"","+            echo \"          the allowlist entry can be removed.\"","+        fi","     fi"," done"," "]},{"oldStart":107,"oldLines":9,"newStart":212,"newLines":16,"lines":[" cargo build --offline --release >/dev/null 2>&1"," "," echo","-echo \"killed: $killed    survived: $survivors\"","-if [[ $survivors -ne 0 ]]; then","-    echo \"WARNING: $survivors mutation(s) were NOT detected — the suite has a blind spot.\"","+echo \"mutations: $((killed + survivors + skipped))   killed: $killed   survived: $survivors   skipped: $skipped\"","+if [[ ${#bad_survivors[@]} -ne 0 ]]; then","+    echo","+    echo \"FAIL: ${#bad_survivors[@]} unexplained survivor(s) — the suite has a blind spot:\"","+    printf '  - %s\\n' \"${bad_survivors[@]}\"","     exit 1"," fi","-echo \"All injected divergences were detected by the differential suite.\"","+if [[ $skipped -ne 0 ]]; then","+    echo \"FAIL: $skipped mutation pattern(s) did not apply — the script is stale.\"","+    exit 1","+fi","+echo \"PASS: every observable injected divergence was detected; all survivors are\"","+echo \"      documented equivalent mutants.\""]}],"originalFile":"#!/usr/bin/env bash\n# Verification-of-the-verification: inject each known-wrong variant into\n# src/lib.rs one at a time and confirm the differential suite CATCHES it.\n# A mutation that survives means the test suite has a blind spot.\nset -uo pipefail\n\nhere=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\ncd \"$here\" || exit 1\n\nLOGDIR=\"${TMPDIR:-$here/target}/verify-logs\"\nmkdir -p \"$LOGDIR\" || LOGDIR=\"$here/target\"\n\nSRC=src/lib.rs\nBAK=\"$LOGDIR/lib.rs.orig\"\ncp \"$SRC\" \"$BAK\"\nrestore() { cp \"$BAK\" \"$SRC\"; }\ntrap restore EXIT\n\nsurvivors=0\nkilled=0\n\n# Each mutation is \"description|||from|||to\"\nmutations=(\n\"c2Dot: addss destination = x-product instead of y-product|||    fadd(y_prod, x_prod)|||    fadd(x_prod, y_prod)\"\n\"c2Dot: y mulss destination = a.y instead of b.y|||    let y_prod = fmul(b.y, a.y);|||    let y_prod = fmul(a.y, b.y);\"\n\"c2Add: addss destination = a instead of b|||    a.x = fadd(b.x, a.x);\n    a.y = fadd(b.y, a.y);|||    a.x = fadd(a.x, b.x);\n    a.y = fadd(a.y, b.y);\"\n\"c2Mulvs: y mulss destination = b instead of a.y|||    a.y = fmul(a.y, b);|||    a.y = fmul(b, a.y);\"\n\"c2MulmvT: row-0 addss destination swapped|||    c.x = fadd(x1, x0);|||    c.x = fadd(x0, x1);\"\n\"c2MulmvT: row-1 mulss destination swapped|||    let y1 = fmul(b.y, a.y.y);|||    let y1 = fmul(a.y.y, b.y);\"\n\"c2RaytoAABB: out->t mulss destination = t0 instead of A.t|||                (*out).t = fmul(A.t, t0);|||                (*out).t = fmul(t0, A.t);\"\n\"c2RaytoCapsule: y addss destination swapped|||    let y = fadd(fmul(fsub(yAe.y, yAp.y), t), yAp.y);|||    let y = fadd(yAp.y, fmul(fsub(yAe.y, yAp.y), t));\"\n\"c2RaytoCapsule: out->t mulss destination = t instead of A.t|||                    (*out).t = fmul(A.t, t);|||                    (*out).t = fmul(t, A.t);\"\n\"c2Absv: use f32::abs instead of the C ternary|||    if a < 0.0 { -a } else { a }|||    a.abs()\"\n\"c2Minv: use f32::min instead of the C ternary|||    if a < b { a } else { b }|||    a.min(b)\"\n\"c2Maxv: use f32::max instead of the C ternary|||    if a > b { a } else { b }|||    a.max(b)\"\n\"c2Div: real division instead of the reciprocal multiply|||    mulvs(a, fdiv(1.0f32, b))|||    mulvs(a, 1.0f32 / b)\"\n\"c2Div: divide each lane directly|||    mulvs(a, fdiv(1.0f32, b))|||    c2v { x: fdiv(a.x, b), y: fdiv(a.y, b) }\"\n\"c2RaytoCircle: disc guard uses <= instead of <|||    if disc < 0.0 {|||    if disc <= 0.0 {\"\n\"c2RaytoCircle: t guard uses > 0 instead of >= 0|||    if t >= 0.0 && t <= A.t {|||    if t > 0.0 && t <= A.t {\"\n\"c2RaytoAABB: SAT guard uses >= instead of >|||    if d > 0.0 {|||    if d >= 0.0 {\"\n\"c2RayToPlane_OneDimensional: zero-denominator guard removed|||        if d != 0.0 { fdiv(da, d) } else { 0.0 }|||        fdiv(da, d)\"\n\"c2AABBtoAABB: one separating axis dropped|||    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n/// \\`c2AABBtoPoint\\`|||    ((d0 | d1 | d2) == 0) as c_int\n}\n\n/// \\`c2AABBtoPoint\\`\"\n\"c2CastRay: return 0 for out-of-range typeB instead of preserving %eax|||        \\\"cmp esi, 2\\\",\n        \\\"ja 2f\\\",\n        \\\"jmp {dispatch}\\\",|||        \\\"cmp esi, 2\\\",\n        \\\"ja 3f\\\",\n        \\\"jmp {dispatch}\\\",\n        \\\"3:\\\",\n        \\\"xor eax, eax\\\",\n        \\\"ret\\\",\"\n\"gen_ray: shift the capsule result by 2 instead of 1|||            } << 1,|||            } << 2,\"\n\"c2Skew: negate the wrong lane|||    b.x = -a.y;\n    b.y = a.x;|||    b.x = a.y;\n    b.y = -a.x;\"\n\"c2Len: sqrt of the wrong thing (abs of dot)|||    fsqrt(dot(a, a))|||    fsqrt(abs_ternary(dot(a, a)))\"\n)\n\nprintf '%-72s %s\\n' \"MUTATION\" \"RESULT\"\nprintf '%.0s-' {1..86}; echo\n\nfor m in \"${mutations[@]}\"; do\n    desc=\"${m%%|||*}\"\n    rest=\"${m#*|||}\"\n    from=\"${rest%%|||*}\"\n    to=\"${rest#*|||}\"\n\n    restore\n    if ! python3 - \"$SRC\" \"$from\" \"$to\" <<'PY'\nimport sys\npath, frm, to = sys.argv[1], sys.argv[2], sys.argv[3]\ns = open(path).read()\nn = s.count(frm)\nif n == 0:\n    sys.exit(2)\nopen(path, 'w').write(s.replace(frm, to, 1))\nPY\n    then\n        printf '%-72s %s\\n' \"$desc\" \"SKIP (pattern not found)\"\n        continue\n    fi\n\n    if ! cargo build --offline --release >\"$LOGDIR/mut_build.log\" 2>&1; then\n        printf '%-72s %s\\n' \"$desc\" \"KILLED (compile error)\"\n        killed=$((killed + 1))\n        continue\n    fi\n\n    if cargo test --offline --release >\"$LOGDIR/mut_test.log\" 2>&1; then\n        printf '%-72s %s\\n' \"$desc\" \"*** SURVIVED ***\"\n        survivors=$((survivors + 1))\n    else\n        first=$(grep -oE '^---- [a-z0-9_]+' \"$LOGDIR/mut_test.log\" | head -n1 | sed 's/---- //')\n        printf '%-72s %s\\n' \"$desc\" \"killed by ${first:-a test}\"\n        killed=$((killed + 1))\n    fi\ndone\n\nrestore\ncargo build --offline --release >/dev/null 2>&1\n\necho\necho \"killed: $killed    survived: $survivors\"\nif [[ $survivors -ne 0 ]]; then\n    echo \"WARNING: $survivors mutation(s) were NOT detected — the suite has a blind spot.\"\n    exit 1\nfi\necho \"All injected divergences were detected by the differential suite.\"\n","userModified":false}}
