;\n        }\n    }\n    for _ in 0..100_000 {\n        let ci = c2Circle { p: rng.vec_bits(), r: rng.any_bits() };\n        let pt = rng.vec_bits();\n        d.eq_i(\n            || format!(\"c2CircleToPoint({:?}, {})\", ci, vs(pt)),\n            unsafe { (p.c.c2CircleToPoint)(ci, pt) },\n            unsafe { (p.r.c2CircleToPoint)(ci, pt) },\n        );\n    }\n    d.finish();\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
