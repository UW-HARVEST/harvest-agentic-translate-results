of: $UND\"; }\ndone\n\necho\nif [ \"$FAIL\" -eq 0 ]; then\n    echo \"ALL DIFFERENTIAL TESTS + SYMBOL PARITY PASSED\"\nelse\n    echo \"FAILURES DETECTED\"; exit 1\nfi\n","structuredPatch":[{"oldStart":1,"oldLines":58,"newStart":1,"newLines":78,"lines":[" #!/usr/bin/env bash","-# Differential-test driver.","+# Differential-test driver (Phase B + C + D)."," #","-# `cargo test` does NOT rebuild the `cdylib` (an integration test target does","-# not depend on it), so the cdylib MUST be built explicitly first — otherwise","-# the tests silently `dlopen` a stale `libgen_ray_lib.so`.","-#","-# Usage: ./run_diff_tests.sh [extra cargo args...]","+# `cargo test` does NOT rebuild the `cdylib` (an integration test target does not","+# depend on it), so the cdylib MUST be built explicitly before each test run --","+# otherwise the tests silently `dlopen` a stale `libgen_ray_lib.so`."," set -euo pipefail"," cd \"$(dirname \"$0\")\""," export CARGO_NET_OFFLINE=true","+WORK=$(mktemp -d \"${TMPDIR:-/tmp}/diffsyms.XXXXXX\" 2>/dev/null || mktemp -d ./.diffsyms.XXXXXX)","+trap 'rm -rf \"$WORK\"' EXIT"," ","-# 1. Build the C reference shared object.","-if [ ! -d ../c_src/build ]; then","+# ---------------------------------------------------------------- C reference","+if [ ! -f ../c_src/build/CMakeCache.txt ]; then","     mkdir -p ../c_src/build","     (cd ../c_src/build && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON >/dev/null)"," fi"," cmake --build ../c_src/build >/dev/null","+C_SO=$(echo ../c_src/build/*.so)","+echo \"C reference: $C_SO\""," ","-# 2. Enumerate feature combinations. Cargo.toml declares no [features], so the","-#    only combination is the (empty) default; the loop is written generically so","-#    it keeps working if features are ever added.","-FEATURES=$(cargo metadata --offline --format-version 1 --no-deps \\","-    | tr '{}' '\\n' | grep -o '\"features\":[^}]*' | head -1 || true)","-echo \"declared features: ${FEATURES:-none}\"","+# ----------------------------