{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GNPKQ732KJm8hrH7kzbiRy","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (a trimmed-down `cute_c2`\n2\t//! style 2D raycast library).\n3\t//!\n4\t//! Every public symbol exported by the C shared object is re-exported here with\n5\t//! the identical name, C ABI and bit-for-bit identical floating-point\n6\t//! behaviour.  The original C source is *not* corrected: its quirks are\n7\t//! reproduced exactly, including\n8\t//!\n9\t//!   * `c2Div` multiplying by `1.0f / b` instead of dividing,\n10\t//!   * `fabsf`/`fminf`/`fmaxf` spelled as ternaries (so `-0.0` and `-NaN` keep\n11\t//!     their sign, unlike the real libm functions),\n12\t//!   * the missing `default:`/trailing `return` in `c2CastRay`.\n13\t//!\n14\t//! ## Why the `f*` arithmetic helpers exist\n15\t//!\n16\t//! `mulss`/`addss` return the *destination* operand when both operands are\n17\t//! NaN, and LLVM is free to commute the operands of `fmul`/`fadd` (it considers\n18\t//! NaN payload/sign propagation non-deterministic).  That makes plain `a * b`\n19\t//! observably different from C for inputs such as `±inf` or NaN.  The helpers\n20\t//! below pin each operand to the role it has in the C source so the emitted\n21\t//! instruction sequence matches the reference build operand-for-operand.\n22\t\n23\t#![allow(non_snake_case)]\n24\t#![allow(non_camel_case_types)]\n25\t\n26\tuse std::ffi::{c_int, c_void};\n27\t\n28\t// ---------------------------------------------------------------------------\n29\t// Order-preserving scalar float arithmetic\n30\t// ---------------------------------------------------------------------------\n31\t\n32\tmacro_rules! ordered_binop {\n33\t    ($name:ident, $mnemonic:literal, $fallback:expr) => {\n34\t        #[inline(always)]\n35\t        fn $name(a: f32, b: f32) -> f32 {\n36\t            #[cfg(target_arch = \"x86_64\")]\n37\t            {\n38\t                let mut r = a;\n39\t                // SAFETY: a pure, memory-free SSE scalar instruction on two\n40\t                // `f32` values held in `xmm` registers.\n41\t                unsafe {\n42\t                    core::arch::asm!(\n43\t                        concat!($mnemonic, \" {0}, {1}\"),\n44\t                        inout(xmm_reg) r,\n45\t                        in(xmm_reg) b,\n46\t                        options(pure, nomem, nostack, preserves_flags),\n47\t                    );\n48\t                }\n49\t                r\n50\t            }\n51\t            #[cfg(not(target_arch = \"x86_64\"))]\n52\t            {\n53\t                let f: fn(f32, f32) -> f32 = $fallback;\n54\t                f(a, b)\n55\t            }\n56\t        }\n57\t    };\n58\t}\n59\t\n60\tordered_binop!(fadd, \"addss\", |a, b| a + b);\n61\tordered_binop!(fsub, \"subss\", |a, b| a - b);\n62\tordered_binop!(fmul, \"mulss\", |a, b| a * b);\n63\tordered_binop!(fdiv, \"divss\", |a, b| a / b);\n64\t\n65\t/// `sqrtf(a)` — identical result to glibc's `sqrtf` (both are a single\n66\t/// `sqrtss`, including the `-NaN` produced for negative arguments).\n67\t#[inline(always)]\n68\tfn fsqrt(a: f32) -> f32 {\n69\t    a.sqrt()\n70\t}\n71\t\n72\t/// Reproduces the C source's inlined `fabsf` idiom `((a) < 0 ? -(a) : (a))`.\n73\t///\n74\t/// Differs from `f32::abs` for `-0.0` and `-NaN` (which are returned\n75\t/// unchanged, because `x < 0` is false for both) — the C behaviour is kept.\n76\t#[inline(always)]\n77\tfn abs_ternary(a: f32) -> f32 {\n78\t    if a < 0.0 { -a } else { a }\n79\t}\n80\t\n81\t/// Reproduces `((a) < (b) ? (a) : (b))`.\n82\t#[inline(always)]\n83\tfn min_ternary(a: f32, b: f32) -> f32 {\n84\t    if a < b { a } else { b }\n85\t}\n86\t\n87\t/// Reproduces `((a) > (b) ? (a) : (b))`.\n88\t#[inline(always)]\n89\tfn max_ternary(a: f32, b: f32) -> f32 {\n90\t    if a > b { a } else { b }\n91\t}\n92\t\n93\t// ---------------------------------------------------------------------------\n94\t// Public types (include/lib.h)\n95\t// ---------------------------------------------------------------------------\n96\t\n97\t/// `typedef struct c2v { float x; float y; } c2v;`\n98\t#[repr(C)]\n99\t#[derive(Copy, Clone, Debug, Default)]\n100\tpub struct c2v {\n101\t    pub x: f32,\n102\t    pub y: f32,\n103\t}\n104\t\n105\t/// `typedef struct c2Raycast { float t; c2v n; } c2Raycast;`\n106\t#[repr(C)]\n107\t#[derive(Copy, Clone, Debug, Default)]\n108\tpub struct c2Raycast {\n109\t    pub t: f32,\n110\t    pub n: c2v,\n111\t}\n112\t\n113\t// ---------------------------------------------------------------------------\n114\t// Private types (src/lib.c)\n115\t// ---------------------------------------------------------------------------\n116\t\n117\t/// `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;`\n118\tpub const C2_TYPE_CIRCLE: c_int = 0;\n119\tpub const C2_TYPE_AABB: c_int = 1;\n120\tpub const C2_TYPE_CAPSULE: c_int = 2;\n121\t\n122\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n123\t#[repr(C)]\n124\t#[derive(Copy, Clone, Debug, Default)]\n125\tpub struct c2Circle {\n126\t    pub p: c2v,\n127\t    pub r: f32,\n128\t}\n129\t\n130\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n131\t#[repr(C)]\n132\t#[derive(Copy, Clone, Debug, Default)]\n133\tpub struct c2AABB {\n134\t    pub min: c2v,\n135\t    pub max: c2v,\n136\t}\n137\t\n138\t/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n139\t#[repr(C)]\n140\t#[derive(Copy, Clone, Debug, Default)]\n141\tpub struct c2Capsule {\n142\t    pub a: c2v,\n143\t    pub b: c2v,\n144\t    pub r: f32,\n145\t}\n146\t\n147\t/// `typedef struct c2Ray { c2v p; c2v d; float t; } c2Ray;`\n148\t#[repr(C)]\n149\t#[derive(Copy, Clone, Debug, Default)]\n150\tpub struct c2Ray {\n151\t    pub p: c2v,\n152\t    pub d: c2v,\n153\t    pub t: f32,\n154\t}\n155\t\n156\t/// `typedef struct c2m { c2v x; c2v y; } c2m;`\n157\t#[repr(C)]\n158\t#[derive(Copy, Clone, Debug, Default)]\n159\tpub struct c2m {\n160\t    pub x: c2v,\n161\t    pub y: c2v,\n162\t}\n163\t\n164\t// ---------------------------------------------------------------------------\n165\t// Internal implementations.  The exported `extern \"C\"` wrappers further down\n166\t// are thin shims over these, so the internal call graph mirrors the C one.\n167\t// ---------------------------------------------------------------------------\n168\t\n169\t/// `c2V`\n170\t#[inline(always)]\n171\tfn c2v_new(x: f32, y: f32) -> c2v {\n172\t    let mut a = c2v { x: 0.0, y: 0.0 };\n173\t    a.x = x;\n174\t    a.y = y;\n175\t    a\n176\t}\n177\t\n178\t/// `c2Dot`\n179\t#[inline(always)]\n180\tfn dot(a: c2v, b: c2v) -> f32 {\n181\t    fadd(fmul(a.x, b.x), fmul(a.y, b.y))\n182\t}\n183\t\n184\t/// `c2Len`\n185\t#[inline(always)]\n186\tfn len(a: c2v) -> f32 {\n187\t    fsqrt(dot(a, a))\n188\t}\n189\t\n190\t/// `c2Add`\n191\t#[inline(always)]\n192\tfn add(mut a: c2v, b: c2v) -> c2v {\n193\t    a.x = fadd(a.x, b.x);\n194\t    a.y = fadd(a.y, b.y);\n195\t    a\n196\t}\n197\t\n198\t/// `c2Sub`\n199\t#[inline(always)]\n200\tfn sub(mut a: c2v, b: c2v) -> c2v {\n201\t    a.x = fsub(a.x, b.x);\n202\t    a.y = fsub(a.y, b.y);\n203\t    a\n204\t}\n205\t\n206\t/// `c2Mulvs`\n207\t///\n208\t/// The reference build keeps `a.x` as the `mulss` destination for the `x` lane\n209\t/// but uses `b` as the destination for the `y` lane, which is observable when\n210\t/// both operands are NaN (the destination wins).  Mirrored here.\n211\t#[inline(always)]\n212\tfn mulvs(mut a: c2v, b: f32) -> c2v {\n213\t    a.x = fmul(a.x, b);\n214\t    a.y = fmul(b, a.y);\n215\t    a\n216\t}\n217\t\n218\t/// `c2Div` — note the reciprocal multiply, which is observable in the low bits.\n219\t#[inline(always)]\n220\tfn div(a: c2v, b: f32) -> c2v {\n221\t    mulvs(a, fdiv(1.0f32, b))\n222\t}\n223\t\n224\t/// `c2Norm`\n225\t#[inline(always)]\n226\tfn norm(a: c2v) -> c2v {\n227\t    div(a, len(a))\n228\t}\n229\t\n230\t/// `c2Minv`\n231\t#[inline(always)]\n232\tfn minv(a: c2v, b: c2v) -> c2v {\n233\t    c2v_new(min_ternary(a.x, b.x), min_ternary(a.y, b.y))\n234\t}\n235\t\n236\t/// `c2Maxv`\n237\t#[inline(always)]\n238\tfn maxv(a: c2v, b: c2v) -> c2v {\n239\t    c2v_new(max_ternary(a.x, b.x), max_ternary(a.y, b.y))\n240\t}\n241\t\n242\t/// `c2Skew`\n243\t#[inline(always)]\n244\tfn skew(a: c2v) -> c2v {\n245\t    let mut b = c2v { x: 0.0, y: 0.0 };\n246\t    b.x = -a.y;\n247\t    b.y = a.x;\n248\t    b\n249\t}\n250\t\n251\t/// `c2Absv`\n252\t#[inline(always)]\n253\tfn absv(a: c2v) -> c2v {\n254\t    c2v_new(abs_ternary(a.x), abs_ternary(a.y))\n255\t}\n256\t\n257\t/// `c2CCW90`\n258\t#[inline(always)]\n259\tfn ccw90(a: c2v) -> c2v {\n260\t    let mut b = c2v { x: 0.0, y: 0.0 };\n261\t    b.x = a.y;\n262\t    b.y = -a.x;\n263\t    b\n264\t}\n265\t\n266\t/// `c2MulmvT`\n267\t#[inline(always)]\n268\tfn mulmv_t(a: c2m, b: c2v) -> c2v {\n269\t    let mut c = c2v { x: 0.0, y: 0.0 };\n270\t    c.x = fadd(fmul(a.x.x, b.x), fmul(a.x.y, b.y));\n271\t    c.y = fadd(fmul(a.y.x, b.x), fmul(a.y.y, b.y));\n272\t    c\n273\t}\n274\t\n275\t/// `c2AABBtoAABB`\n276\t#[inline(always)]\n277\tfn aabb_to_aabb(A: c2AABB, B: c2AABB) -> c_int {\n278\t    let d0 = (B.max.x < A.min.x) as c_int;\n279\t    let d1 = (A.max.x < B.min.x) as c_int;\n280\t    let d2 = (B.max.y < A.min.y) as c_int;\n281\t    let d3 = (A.max.y < B.min.y) as c_int;\n282\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n283\t}\n284\t\n285\t/// `c2AABBtoPoint`\n286\t#[inline(always)]\n287\tfn aabb_to_point(A: c2AABB, B: c2v) -> c_int {\n288\t    let d0 = (B.x < A.min.x) as c_int;\n289\t    let d1 = (B.y < A.min.y) as c_int;\n290\t    let d2 = (B.x > A.max.x) as c_int;\n291\t    let d3 = (B.y > A.max.y) as c_int;\n292\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n293\t}\n294\t\n295\t/// `c2CircleToPoint`\n296\t#[inline(always)]\n297\tfn circle_to_point(A: c2Circle, B: c2v) -> c_int {\n298\t    let n = sub(A.p, B);\n299\t    let d2 = dot(n, n);\n300\t    (d2 < fmul(A.r, A.r)) as c_int\n301\t}\n302\t\n303\t/// `static inline float c2SignedDistPointToPlane_OneDimensional(float p, float n, float d)`\n304\t#[inline(always)]\n305\tfn signed_dist_point_to_plane_one_dimensional(p: f32, n: f32, d: f32) -> f32 {\n306\t    fsub(fmul(p, n), fmul(d, n))\n307\t}\n308\t\n309\t/// `static inline float c2RayToPlane_OneDimensional(float da, float db)`\n310\t#[inline(always)]\n311\tfn ray_to_plane_one_dimensional(da: f32, db: f32) -> f32 {\n312\t    if da < 0.0 {\n313\t        0.0\n314\t    } else if fmul(da, db) > 0.0 {\n315\t        1.0f32\n316\t    } else {\n317\t        let d = fsub(da, db);\n318\t        if d != 0.0 { fdiv(da, d) } else { 0.0 }\n319\t    }\n320\t}\n321\t\n322\t/// `c2RaytoCircle`\n323\t///\n324\t/// # Safety\n325\t/// `out` must be a valid, writable pointer to a `c2Raycast` (the C code\n326\t/// dereferences it unconditionally on the hit path).\n327\tunsafe fn ray_to_circle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n328\t    let p = B.p;\n329\t    let m = sub(A.p, p);\n330\t    let c = fsub(dot(m, m), fmul(B.r, B.r));\n331\t    let b = dot(m, A.d);\n332\t    let disc = fsub(fmul(b, b), c);\n333\t    if disc < 0.0 {\n334\t        return 0;\n335\t    }\n336\t    let t = fsub(-b, fsqrt(disc));\n337\t    if t >= 0.0 && t <= A.t {\n338\t        unsafe {\n339\t            (*out).t = t;\n340\t        }\n341\t        let impact = add(A.p, mulvs(A.d, t));\n342\t        unsafe {\n343\t            (*out).n = norm(sub(impact, p));\n344\t        }\n345\t        return 1;\n346\t    }\n347\t    0\n348\t}\n349\t\n350\t/// `c2RaytoAABB`\n351\t///\n352\t/// # Safety\n353\t/// `out` must be a valid, writable pointer to a `c2Raycast`.\n354\tunsafe fn ray_to_aabb(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n355\t    let p0 = A.p;\n356\t    let p1 = add(A.p, mulvs(A.d, A.t));\n357\t    let mut a_box = c2AABB::default();\n358\t    a_box.min = minv(p0, p1);\n359\t    a_box.max = maxv(p0, p1);\n360\t    if aabb_to_aabb(a_box, B) == 0 {\n361\t        return 0;\n362\t    }\n363\t    let ab = sub(p1, p0);\n364\t    let n = skew(ab);\n365\t    let abs_n = absv(n);\n366\t    let half_extents = mulvs(sub(B.max, B.min), 0.5f32);\n367\t    let center_of_b_box = mulvs(add(B.min, B.max), 0.5f32);\n368\t    let d = fsub(\n369\t        abs_ternary(dot(n, sub(p0, center_of_b_box))),\n370\t        dot(abs_n, half_extents),\n371\t    );\n372\t    if d > 0.0 {\n373\t        return 0;\n374\t    }\n375\t    let da0 = signed_dist_point_to_plane_one_dimensional(p0.x, -1.0f32, B.min.x);\n376\t    let db0 = signed_dist_point_to_plane_one_dimensional(p1.x, -1.0f32, B.min.x);\n377\t    let da1 = signed_dist_point_to_plane_one_dimensional(p0.x, 1.0f32, B.max.x);\n378\t    let db1 = signed_dist_point_to_plane_one_dimensional(p1.x, 1.0f32, B.max.x);\n379\t    let da2 = signed_dist_point_to_plane_one_dimensional(p0.y, -1.0f32, B.min.y);\n380\t    let db2 = signed_dist_point_to_plane_one_dimensional(p1.y, -1.0f32, B.min.y);\n381\t    let da3 = signed_dist_point_to_plane_one_dimensional(p0.y, 1.0f32, B.max.y);\n382\t    let db3 = signed_dist_point_to_plane_one_dimensional(p1.y, 1.0f32, B.max.y);\n383\t    let mut t0 = ray_to_plane_one_dimensional(da0, db0);\n384\t    let mut t1 = ray_to_plane_one_dimensional(da1, db1);\n385\t    let mut t2 = ray_to_plane_one_dimensional(da2, db2);\n386\t    let mut t3 = ray_to_plane_one_dimensional(da3, db3);\n387\t    let hit0 = (t0 <= 1.0f32) as c_int;\n388\t    let hit1 = (t1 <= 1.0f32) as c_int;\n389\t    let hit2 = (t2 <= 1.0f32) as c_int;\n390\t    let hit3 = (t3 <= 1.0f32) as c_int;\n391\t    let hit = hit0 | hit1 | hit2 | hit3;\n392\t    if hit != 0 {\n393\t        t0 = fmul(hit0 as f32, t0);\n394\t        t1 = fmul(hit1 as f32, t1);\n395\t        t2 = fmul(hit2 as f32, t2);\n396\t        t3 = fmul(hit3 as f32, t3);\n397\t        if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n398\t            unsafe {\n399\t                (*out).t = fmul(t0, A.t);\n400\t                (*out).n = c2v_new(-1.0, 0.0);\n401\t            }\n402\t        } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n403\t            unsafe {\n404\t                (*out).t = fmul(t1, A.t);\n405\t                (*out).n = c2v_new(1.0, 0.0);\n406\t            }\n407\t        } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n408\t            unsafe {\n409\t                (*out).t = fmul(t2, A.t);\n410\t                (*out).n = c2v_new(0.0, -1.0);\n411\t            }\n412\t        } else {\n413\t            unsafe {\n414\t                (*out).t = fmul(t3, A.t);\n415\t                (*out).n = c2v_new(0.0, 1.0);\n416\t            }\n417\t        }\n418\t        1\n419\t    } else {\n420\t        0\n421\t    }\n422\t}\n423\t\n424\t/// `c2RaytoCapsule`\n425\t///\n426\t/// # Safety\n427\t/// `out` must be a valid, writable pointer to a `c2Raycast`.\n428\tunsafe fn ray_to_capsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n429\t    let mut M = c2m::default();\n430\t    M.y = norm(sub(B.b, B.a));\n431\t    M.x = ccw90(M.y);\n432\t    let cap_n = sub(B.b, B.a);\n433\t    let yBb = mulmv_t(M, cap_n);\n434\t    let yAp = mulmv_t(M, sub(A.p, B.a));\n435\t    let yAd = mulmv_t(M, A.d);\n436\t    let yAe = add(yAp, mulvs(yAd, A.t));\n437\t    let mut capsule_bb = c2AABB::default();\n438\t    capsule_bb.min = c2v_new(-B.r, 0.0);\n439\t    capsule_bb.max = c2v_new(B.r, yBb.y);\n440\t    unsafe {\n441\t        (*out).n = norm(cap_n);\n442\t        (*out).t = 0.0;\n443\t    }\n444\t    if aabb_to_point(capsule_bb, yAp) != 0 {\n445\t        return 1;\n446\t    } else {\n447\t        let mut capsule_a = c2Circle::default();\n448\t        let mut capsule_b = c2Circle::default();\n449\t        capsule_a.p = B.a;\n450\t        capsule_a.r = B.r;\n451\t        capsule_b.p = B.b;\n452\t        capsule_b.r = B.r;\n453\t        if circle_to_point(capsule_a, A.p) != 0 {\n454\t            return 1;\n455\t        } else if circle_to_point(capsule_b, A.p) != 0 {\n456\t            return 1;\n457\t        }\n458\t    }\n459\t    if fmul(yAe.x, yAp.x) < 0.0\n460\t        || min_ternary(abs_ternary(yAe.x), abs_ternary(yAp.x)) < B.r\n461\t    {\n462\t        let mut Ca = c2Circle::default();\n463\t        let mut Cb = c2Circle::default();\n464\t        Ca.p = B.a;\n465\t        Ca.r = B.r;\n466\t        Cb.p = B.b;\n467\t        Cb.r = B.r;\n468\t        if abs_ternary(yAp.x) < B.r {\n469\t            if yAp.y < 0.0 {\n470\t                return unsafe { ray_to_circle(A, Ca, out) };\n471\t            } else {\n472\t                return unsafe { ray_to_circle(A, Cb, out) };\n473\t            }\n474\t        } else {\n475\t            let c = if yAp.x > 0.0 { B.r } else { -B.r };\n476\t            let d = fsub(yAe.x, yAp.x);\n477\t            let t = fdiv(fsub(c, yAp.x), d);\n478\t            let y = fadd(yAp.y, fmul(fsub(yAe.y, yAp.y), t));\n479\t            if y <= 0.0 {\n480\t                return unsafe { ray_to_circle(A, Ca, out) };\n481\t            }\n482\t            if y >= yBb.y {\n483\t                return unsafe { ray_to_circle(A, Cb, out) };\n484\t            } else {\n485\t                unsafe {\n486\t                    (*out).n = if c > 0.0 { M.x } else { skew(M.y) };\n487\t                    (*out).t = fmul(t, A.t);\n488\t                }\n489\t                return 1;\n490\t            }\n491\t        }\n492\t    }\n493\t    0\n494\t}\n495\t\n496\t// ---------------------------------------------------------------------------\n497\t// Exported C ABI surface\n498\t// ---------------------------------------------------------------------------\n499\t\n500\t#[unsafe(no_mangle)]\n501\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n502\t    c2v_new(x, y)\n503\t}\n504\t\n505\t#[unsafe(no_mangle)]\n506\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n507\t    dot(a, b)\n508\t}\n509\t\n510\t#[unsafe(no_mangle)]\n511\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n512\t    len(a)\n513\t}\n514\t\n515\t/// The reference build emits `addss` with `b` as the destination for both\n516\t/// lanes of the standalone `c2Add`, which is observable when both addends are\n517\t/// NaN (the destination operand wins).  Mirrored here.\n518\t#[unsafe(no_mangle)]\n519\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n520\t    a.x = fadd(b.x, a.x);\n521\t    a.y = fadd(b.y, a.y);\n522\t    a\n523\t}\n524\t\n525\t#[unsafe(no_mangle)]\n526\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n527\t    sub(a, b)\n528\t}\n529\t\n530\t#[unsafe(no_mangle)]\n531\tpub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n532\t    mulvs(a, b)\n533\t}\n534\t\n535\t#[unsafe(no_mangle)]\n536\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n537\t    div(a, b)\n538\t}\n539\t\n540\t#[unsafe(no_mangle)]\n541\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n542\t    norm(a)\n543\t}\n544\t\n545\t#[unsafe(no_mangle)]\n546\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n547\t    minv(a, b)\n548\t}\n549\t\n550\t#[unsafe(no_mangle)]\n551\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n552\t    maxv(a, b)\n553\t}\n554\t\n555\t#[unsafe(no_mangle)]\n556\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n557\t    skew(a)\n558\t}\n559\t\n560\t#[unsafe(no_mangle)]\n561\tpub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n562\t    absv(a)\n563\t}\n564\t\n565\t/// # Safety\n566\t/// `out` must point to a writable `c2Raycast`.\n567\t#[unsafe(no_mangle)]\n568\tpub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n569\t    unsafe { ray_to_circle(A, B, out) }\n570\t}\n571\t\n572\t#[unsafe(no_mangle)]\n573\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n574\t    aabb_to_aabb(A, B)\n575\t}\n576\t\n577\t/// # Safety\n578\t/// `out` must point to a writable `c2Raycast`.\n579\t#[unsafe(no_mangle)]\n580\tpub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n581\t    unsafe { ray_to_aabb(A, B, out) }\n582\t}\n583\t\n584\t#[unsafe(no_mangle)]\n585\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n586\t    ccw90(a)\n587\t}\n588\t\n589\t/// In the standalone `c2MulmvT` the reference build happens to use `b` as the\n590\t/// `mulss` destination for the first row and `a.y` for the second; that is\n591\t/// observable when both factors are NaN.  Mirrored here.\n592\t#[unsafe(no_mangle)]\n593\tpub extern \"C\" fn c2MulmvT(a: c2m, b: c2v) -> c2v {\n594\t    let mut c = c2v { x: 0.0, y: 0.0 };\n595\t    c.x = fadd(fmul(b.x, a.x.x), fmul(b.y, a.x.y));\n596\t    c.y = fadd(fmul(a.y.x, b.x), fmul(a.y.y, b.y));\n597\t    c\n598\t}\n599\t\n600\t#[unsafe(no_mangle)]\n601\tpub extern \"C\" fn c2AABBtoPoint(A: c2AABB, B: c2v) -> c_int {\n602\t    aabb_to_point(A, B)\n603\t}\n604\t\n605\t#[unsafe(no_mangle)]\n606\tpub extern \"C\" fn c2CircleToPoint(A: c2Circle, B: c2v) -> c_int {\n607\t    circle_to_point(A, B)\n608\t}\n609\t\n610\t/// # Safety\n611\t/// `out` must point to a writable `c2Raycast`.\n612\t#[unsafe(no_mangle)]\n613\tpub unsafe extern \"C\" fn c2RaytoCapsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n614\t    unsafe { ray_to_capsule(A, B, out) }\n615\t}\n616\t\n617\t/// # Safety\n618\t/// `B` must point to a `c2Circle`, `c2AABB` or `c2Capsule` matching `typeB`,\n619\t/// and `out` must point to a writable `c2Raycast`.\n620\t///\n621\t/// The C original has neither a `default:` label nor a `return` after the\n622\t/// `switch`, so an out-of-range `typeB` falls off the end of the function.  On\n623\t/// the reference build that leaves `eax` holding the low 32 bits of the `B`\n624\t/// pointer; that (undefined) behaviour is mirrored rather than \"fixed\".\n625\t#[unsafe(no_mangle)]\n626\tpub unsafe extern \"C\" fn c2CastRay(\n627\t    A: c2Ray,\n628\t    B: *const c_void,\n629\t    typeB: c_int,\n630\t    out: *mut c2Raycast,\n631\t) -> c_int {\n632\t    unsafe {\n633\t        match typeB {\n634\t            C2_TYPE_CIRCLE => ray_to_circle(A, *(B as *const c2Circle), out),\n635\t            C2_TYPE_AABB => ray_to_aabb(A, *(B as *const c2AABB), out),\n636\t            C2_TYPE_CAPSULE => ray_to_capsule(A, *(B as *const c2Capsule), out),\n637\t            // Falls off the end of the C `switch`: garbage return value.\n638\t            _ => (B as usize as u32) as c_int,\n639\t        }\n640\t    }\n641\t}\n642\t\n643\t/// # Safety\n644\t/// `cast1`, `cast2` and `cast3` must point to writable `c2Raycast` values.\n645\t#[unsafe(no_mangle)]\n646\tpub unsafe extern \"C\" fn gen_ray(\n647\t    cast1: *mut c2Raycast,\n648\t    cast2: *mut c2Raycast,\n649\t    cast3: *mut c2Raycast,\n650\t    mp_x: f32,\n651\t    mp_y: f32,\n652\t    r_p_x: f32,\n653\t    r_p_y: f32,\n654\t    c_p_x: f32,\n655\t    c_p_y: f32,\n656\t    c_r: f32,\n657\t    cap_a_x: f32,\n658\t    cap_a_y: f32,\n659\t    cap_b_x: f32,\n660\t    cap_b_y: f32,\n661\t    cap_r: f32,\n662\t    bb_min_x: f32,\n663\t    bb_min_y: f32,\n664\t    bb_max_x: f32,\n665\t    bb_max_y: f32,\n666\t) -> c_int {\n667\t    let mut hit: c_int = 0;\n668\t\n669\t    let mp = c2v_new(mp_x, mp_y);\n670\t\n671\t    let mut ray = c2Ray::default();\n672\t    ray.p = c2v_new(r_p_x, r_p_y);\n673\t    ray.d = norm(sub(mp, ray.p));\n674\t    ray.t = fsub(dot(mp, ray.d), dot(ray.p, ray.d));\n675\t\n676\t    let mut c = c2Circle::default();\n677\t    c.p = c2v_new(c_p_x, c_p_y);\n678\t    c.r = c_r;\n679\t\n680\t    hit = hit.wrapping_add(unsafe {\n681\t        c2CastRay(ray, (&raw const c) as *const c_void, C2_TYPE_CIRCLE, cast1)\n682\t    });\n683\t\n684\t    let mut cap = c2Capsule::default();\n685\t    cap.a = c2v_new(cap_a_x, cap_a_y);\n686\t    cap.b = c2v_new(cap_b_x, cap_b_y);\n687\t    cap.r = cap_r;\n688\t\n689\t    hit = hit.wrapping_add(\n690\t        unsafe {\n691\t            c2CastRay(\n692\t                ray,\n693\t                (&raw const cap) as *const c_void,\n694\t                C2_TYPE_CAPSULE,\n695\t                cast2,\n696\t            )\n697\t        } << 1,\n698\t    );\n699\t\n700\t    let mut bb = c2AABB::default();\n701\t    bb.min = c2v_new(bb_min_x, bb_min_y);\n702\t    bb.max = c2v_new(bb_max_x, bb_max_y);\n703\t\n704\t    hit = hit.wrapping_add(\n705\t        unsafe { c2CastRay(ray, (&raw const bb) as *const c_void, C2_TYPE_AABB, cast3) } << 2,\n706\t    );\n707\t\n708\t    hit\n709\t}\n710\t"}]},"parent_tool_use_id":null,"session_id":"20cfd266-ad25-4bd4-8d50-d08897c4517a","uuid":"54621801-b402-4fec-baf7-bde785597a33","timestamp":"2026-08-27T08:05:03.192Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-wVEwSX/translation/src/lib.rs","content":"//! Rust translation of the C library in `c_src/` (a trimmed-down `cute_c2`\n//! style 2D raycast library).\n//!\n//! Every public symbol exported by the C shared object is re-exported here with\n//! the identical name, C ABI and bit-for-bit identical floating-point\n//! behaviour.  The original C source is *not* corrected: its quirks are\n//! reproduced exactly, including\n//!\n//!   * `c2Div` multiplying by `1.0f / b` instead of dividing,\n//!   * `fabsf`/`fminf`/`fmaxf` spelled as ternaries (so `-0.0` and `-NaN` keep\n//!     their sign, unlike the real libm functions),\n//!   * the missing `default:`/trailing `return` in `c2CastRay`.\n//!\n//! ## Why the `f*` arithmetic helpers exist\n//!\n//! `mulss`/`addss` return the *destination* operand when both operands are\n//! NaN, and LLVM is free to commute the operands of `fmul`/`fadd` (it considers\n//! NaN payload/sign propagation non-deterministic).  That makes plain `a * b`\n//! observably different from C for inputs such as `±inf` or NaN.  The helpers\n//! below pin each operand to the role it has in the C source so the emitted\n//! instruction sequence matches the reference build operand-for-operand.\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n\nuse std::ffi::{c_int, c_void};\n\n// ---------------------------------------------------------------------------\n// Order-preserving scalar float arithmetic\n// ---------------------------------------------------------------------------\n\nmacro_rules! ordered_binop {\n    ($name:ident, $mnemonic:literal, $fallback:expr) => {\n        #[inline(always)]\n        fn $name(a: f32, b: f32) -> f32 {\n            #[cfg(target_arch = \"x86_64\")]\n            {\n                let mut r = a;\n                // SAFETY: a pure, memory-free SSE scalar instruction on two\n                // `f32` values held in `xmm` registers.\n                unsafe {\n                    core::arch::asm!(\n                        concat!($mnemonic, \" {0}, {1}\"),\n                        inout(xmm_reg) r,\n                        in(xmm_reg) b,\n                        options(pure, nomem, nostack, preserves_flags),\n                    );\n                }\n                r\n            }\n            #[cfg(not(target_arch = \"x86_64\"))]\n            {\n                let f: fn(f32, f32) -> f32 = $fallback;\n                f(a, b)\n            }\n        }\n    };\n}\n\nordered_binop!(fadd, \"addss\", |a, b| a + b);\nordered_binop!(fsub, \"subss\", |a, b| a - b);\nordered_binop!(fmul, \"mulss\", |a, b| a * b);\nordered_binop!(fdiv, \"divss\", |a, b| a / b);\n\n/// `sqrtf(a)` — identical result to glibc's `sqrtf` (both are a single\n/// `sqrtss`, including the `-NaN` produced for negative arguments).\n#[inline(always)]\nfn fsqrt(a: f32) -> f32 {\n    a.sqrt()\n}\n\n/// Reproduces the C source's inlined `fabsf` idiom `((a) < 0 ? -(a) : (a))`.\n///\n/// Differs from `f32::abs` for `-0.0` and `-NaN` (which are returned\n/// unchanged, because `x < 0` is false for both) — the C behaviour is kept.\n#[inline(always)]\nfn abs_ternary(a: f32) -> f32 {\n    if a < 0.0 { -a } else { a }\n}\n\n/// Reproduces `((a) < (b) ? (a) : (b))`.\n#[inline(always)]\nfn min_ternary(a: f32, b: f32) -> f32 {\n    if a < b { a } else { b }\n}\n\n/// Reproduces `((a) > (b) ? (a) : (b))`.\n#[inline(always)]\nfn max_ternary(a: f32, b: f32) -> f32 {\n    if a > b { a } else { b }\n}\n\n// ---------------------------------------------------------------------------\n// Public types (include/lib.h)\n// ---------------------------------------------------------------------------\n\n/// `typedef struct c2v { float x; float y; } c2v;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n/// `typedef struct c2Raycast { float t; c2v n; } c2Raycast;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Raycast {\n    pub t: f32,\n    pub n: c2v,\n}\n\n// ---------------------------------------------------------------------------\n// Private types (src/lib.c)\n// ---------------------------------------------------------------------------\n\n/// `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;`\npub const C2_TYPE_CIRCLE: c_int = 0;\npub const C2_TYPE_AABB: c_int = 1;\npub const C2_TYPE_CAPSULE: c_int = 2;\n\n/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2Ray { c2v p; c2v d; float t; } c2Ray;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Ray {\n    pub p: c2v,\n    pub d: c2v,\n    pub t: f32,\n}\n\n/// `typedef struct c2m { c2v x; c2v y; } c2m;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2m {\n    pub x: c2v,\n    pub y: c2v,\n}\n\n// ---------------------------------------------------------------------------\n// Internal implementations.  The exported `extern \"C\"` wrappers further down\n// are thin shims over these, so the internal call graph mirrors the C one.\n// ---------------------------------------------------------------------------\n\n/// `c2V`\n#[inline(always)]\nfn c2v_new(x: f32, y: f32) -> c2v {\n    let mut a = c2v { x: 0.0, y: 0.0 };\n    a.x = x;\n    a.y = y;\n    a\n}\n\n/// `c2Dot`\n#[inline(always)]\nfn dot(a: c2v, b: c2v) -> f32 {\n    fadd(fmul(a.x, b.x), fmul(a.y, b.y))\n}\n\n/// `c2Len`\n#[inline(always)]\nfn len(a: c2v) -> f32 {\n    fsqrt(dot(a, a))\n}\n\n/// `c2Add`\n#[inline(always)]\nfn add(mut a: c2v, b: c2v) -> c2v {\n    a.x = fadd(a.x, b.x);\n    a.y = fadd(a.y, b.y);\n    a\n}\n\n/// `c2Sub`\n#[inline(always)]\nfn sub(mut a: c2v, b: c2v) -> c2v {\n    a.x = fsub(a.x, b.x);\n    a.y = fsub(a.y, b.y);\n    a\n}\n\n/// `c2Mulvs`\n///\n/// The reference build keeps `a.x` as the `mulss` destination for the `x` lane\n/// but uses `b` as the destination for the `y` lane, which is observable when\n/// both operands are NaN (the destination wins).  Mirrored here.\n#[inline(always)]\nfn mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x = fmul(a.x, b);\n    a.y = fmul(b, a.y);\n    a\n}\n\n/// `c2Div` — note the reciprocal multiply, which is observable in the low bits.\n#[inline(always)]\nfn div(a: c2v, b: f32) -> c2v {\n    mulvs(a, fdiv(1.0f32, b))\n}\n\n/// `c2Norm`\n#[inline(always)]\nfn norm(a: c2v) -> c2v {\n    div(a, len(a))\n}\n\n/// `c2Minv`\n#[inline(always)]\nfn minv(a: c2v, b: c2v) -> c2v {\n    c2v_new(min_ternary(a.x, b.x), min_ternary(a.y, b.y))\n}\n\n/// `c2Maxv`\n#[inline(always)]\nfn maxv(a: c2v, b: c2v) -> c2v {\n    c2v_new(max_ternary(a.x, b.x), max_ternary(a.y, b.y))\n}\n\n/// `c2Skew`\n#[inline(always)]\nfn skew(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = -a.y;\n    b.y = a.x;\n    b\n}\n\n/// `c2Absv`\n#[inline(always)]\nfn absv(a: c2v) -> c2v {\n    c2v_new(abs_ternary(a.x), abs_ternary(a.y))\n}\n\n/// `c2CCW90`\n#[inline(always)]\nfn ccw90(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = a.y;\n    b.y = -a.x;\n    b\n}\n\n/// `c2MulmvT`\n#[inline(always)]\nfn mulmv_t(a: c2m, b: c2v) -> c2v {\n    let mut c = c2v { x: 0.0, y: 0.0 };\n    c.x = fadd(fmul(a.x.x, b.x), fmul(a.x.y, b.y));\n    c.y = fadd(fmul(a.y.x, b.x), fmul(a.y.y, b.y));\n    c\n}\n\n/// `c2AABBtoAABB`\n#[inline(always)]\nfn aabb_to_aabb(A: c2AABB, B: c2AABB) -> c_int {\n    let d0 = (B.max.x < A.min.x) as c_int;\n    let d1 = (A.max.x < B.min.x) as c_int;\n    let d2 = (B.max.y < A.min.y) as c_int;\n    let d3 = (A.max.y < B.min.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n/// `c2AABBtoPoint`\n#[inline(always)]\nfn aabb_to_point(A: c2AABB, B: c2v) -> c_int {\n    let d0 = (B.x < A.min.x) as c_int;\n    let d1 = (B.y < A.min.y) as c_int;\n    let d2 = (B.x > A.max.x) as c_int;\n    let d3 = (B.y > A.max.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n/// `c2CircleToPoint`\n#[inline(always)]\nfn circle_to_point(A: c2Circle, B: c2v) -> c_int {\n    let n = sub(A.p, B);\n    let d2 = dot(n, n);\n    (d2 < fmul(A.r, A.r)) as c_int\n}\n\n/// `static inline float c2SignedDistPointToPlane_OneDimensional(float p, float n, float d)`\n#[inline(always)]\nfn signed_dist_point_to_plane_one_dimensional(p: f32, n: f32, d: f32) -> f32 {\n    fsub(fmul(p, n), fmul(d, n))\n}\n\n/// `static inline float c2RayToPlane_OneDimensional(float da, float db)`\n#[inline(always)]\nfn ray_to_plane_one_dimensional(da: f32, db: f32) -> f32 {\n    if da < 0.0 {\n        0.0\n    } else if fmul(da, db) > 0.0 {\n        1.0f32\n    } else {\n        let d = fsub(da, db);\n        if d != 0.0 { fdiv(da, d) } else { 0.0 }\n    }\n}\n\n/// `c2RaytoCircle`\n///\n/// # Safety\n/// `out` must be a valid, writable pointer to a `c2Raycast` (the C code\n/// dereferences it unconditionally on the hit path).\nunsafe fn ray_to_circle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n    let p = B.p;\n    let m = sub(A.p, p);\n    let c = fsub(dot(m, m), fmul(B.r, B.r));\n    let b = dot(m, A.d);\n    let disc = fsub(fmul(b, b), c);\n    if disc < 0.0 {\n        return 0;\n    }\n    let t = fsub(-b, fsqrt(disc));\n    if t >= 0.0 && t <= A.t {\n        unsafe {\n            (*out).t = t;\n        }\n        let impact = add(A.p, mulvs(A.d, t));\n        unsafe {\n            (*out).n = norm(sub(impact, p));\n        }\n        return 1;\n    }\n    0\n}\n\n/// `c2RaytoAABB`\n///\n/// # Safety\n/// `out` must be a valid, writable pointer to a `c2Raycast`.\nunsafe fn ray_to_aabb(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n    let p0 = A.p;\n    let p1 = add(A.p, mulvs(A.d, A.t));\n    let mut a_box = c2AABB::default();\n    a_box.min = minv(p0, p1);\n    a_box.max = maxv(p0, p1);\n    if aabb_to_aabb(a_box, B) == 0 {\n        return 0;\n    }\n    let ab = sub(p1, p0);\n    let n = skew(ab);\n    let abs_n = absv(n);\n    let half_extents = mulvs(sub(B.max, B.min), 0.5f32);\n    let center_of_b_box = mulvs(add(B.min, B.max), 0.5f32);\n    let d = fsub(\n        abs_ternary(dot(n, sub(p0, center_of_b_box))),\n        dot(abs_n, half_extents),\n    );\n    if d > 0.0 {\n        return 0;\n    }\n    let da0 = signed_dist_point_to_plane_one_dimensional(p0.x, -1.0f32, B.min.x);\n    let db0 = signed_dist_point_to_plane_one_dimensional(p1.x, -1.0f32, B.min.x);\n    let da1 = signed_dist_point_to_plane_one_dimensional(p0.x, 1.0f32, B.max.x);\n    let db1 = signed_dist_point_to_plane_one_dimensional(p1.x, 1.0f32, B.max.x);\n    let da2 = signed_dist_point_to_plane_one_dimensional(p0.y, -1.0f32, B.min.y);\n    let db2 = signed_dist_point_to_plane_one_dimensional(p1.y, -1.0f32, B.min.y);\n    let da3 = signed_dist_point_to_plane_one_dimensional(p0.y, 1.0f32, B.max.y);\n    let db3 = signed_dist_point_to_plane_one_dimensional(p1.y, 1.0f32, B.max.y);\n    let mut t0 = ray_to_plane_one_dimensional(da0, db0);\n    let mut t1 = ray_to_plane_one_dimensional(da1, db1);\n    let mut t2 = ray_to_plane_one_dimensional(da2, db2);\n    let mut t3 = ray_to_plane_one_dimensional(da3, db3);\n    let hit0 = (t0 <= 1.0f32) as c_int;\n    let hit1 = (t1 <= 1.0f32) as c_int;\n    let hit2 = (t2 <= 1.0f32) as c_int;\n    let hit3 = (t3 <= 1.0f32) as c_int;\n    let hit = hit0 | hit1 | hit2 | hit3;\n    if hit != 0 {\n        t0 = fmul(hit0 as f32, t0);\n        t1 = fmul(hit1 as f32, t1);\n        t2 = fmul(hit2 as f32, t2);\n        t3 = fmul(hit3 as f32, t3);\n        if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n            unsafe {\n                (*out).t = fmul(t0, A.t);\n                (*out).n = c2v_new(-1.0, 0.0);\n            }\n        } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n            unsafe {\n                (*out).t = fmul(t1, A.t);\n                (*out).n = c2v_new(1.0, 0.0);\n            }\n        } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n            unsafe {\n                (*out).t = fmul(t2, A.t);\n                (*out).n = c2v_new(0.0, -1.0);\n            }\n        } else {\n            unsafe {\n                (*out).t = fmul(t3, A.t);\n                (*out).n = c2v_new(0.0, 1.0);\n            }\n        }\n        1\n    } else {\n        0\n    }\n}\n\n/// `c2RaytoCapsule`\n///\n/// # Safety\n/// `out` must be a valid, writable pointer to a `c2Raycast`.\nunsafe fn ray_to_capsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n    let mut M = c2m::default();\n    M.y = norm(sub(B.b, B.a));\n    M.x = ccw90(M.y);\n    let cap_n = sub(B.b, B.a);\n    let yBb = mulmv_t(M, cap_n);\n    let yAp = mulmv_t(M, sub(A.p, B.a));\n    let yAd = mulmv_t(M, A.d);\n    let yAe = add(yAp, mulvs(yAd, A.t));\n    let mut capsule_bb = c2AABB::default();\n    capsule_bb.min = c2v_new(-B.r, 0.0);\n    capsule_bb.max = c2v_new(B.r, yBb.y);\n    unsafe {\n        (*out).n = norm(cap_n);\n        (*out).t = 0.0;\n    }\n    if aabb_to_point(capsule_bb, yAp) != 0 {\n        return 1;\n    } else {\n        let mut capsule_a = c2Circle::default();\n        let mut capsule_b = c2Circle::default();\n        capsule_a.p = B.a;\n        capsule_a.r = B.r;\n        capsule_b.p = B.b;\n        capsule_b.r = B.r;\n        if circle_to_point(capsule_a, A.p) != 0 {\n            return 1;\n        } else if circle_to_point(capsule_b, A.p) != 0 {\n            return 1;\n        }\n    }\n    if fmul(yAe.x, yAp.x) < 0.0\n        || min_ternary(abs_ternary(yAe.x), abs_ternary(yAp.x)) < B.r\n    {\n        let mut Ca = c2Circle::default();\n        let mut Cb = c2Circle::default();\n        Ca.p = B.a;\n        Ca.r = B.r;\n        Cb.p = B.b;\n        Cb.r = B.r;\n        if abs_ternary(yAp.x) < B.r {\n            if yAp.y < 0.0 {\n                return unsafe { ray_to_circle(A, Ca, out) };\n            } else {\n                return unsafe { ray_to_circle(A, Cb, out) };\n            }\n        } else {\n            let c = if yAp.x > 0.0 { B.r } else { -B.r };\n            let d = fsub(yAe.x, yAp.x);\n            let t = fdiv(fsub(c, yAp.x), d);\n            let y = fadd(yAp.y, fmul(fsub(yAe.y, yAp.y), t));\n            if y <= 0.0 {\n                return unsafe { ray_to_circle(A, Ca, out) };\n            }\n            if y >= yBb.y {\n                return unsafe { ray_to_circle(A, Cb, out) };\n            } else {\n                unsafe {\n                    (*out).n = if c > 0.0 { M.x } else { skew(M.y) };\n                    (*out).t = fmul(t, A.t);\n                }\n                return 1;\n            }\n        }\n    }\n    0\n}\n\n// ---------------------------------------------------------------------------\n// Exported C ABI surface\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    c2v_new(x, y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    dot(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    len(a)\n}\n\n/// The reference build emits `addss` with `b` as the destination for both\n/// lanes of the standalone `c2Add`, which is observable when both addends are\n/// NaN (the destination operand wins).  Mirrored here.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n    a.x = fadd(b.x, a.x);\n    a.y = fadd(b.y, a.y);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n    sub(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n    mulvs(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    div(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    norm(a)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    minv(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    maxv(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    skew(a)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n    absv(a)\n}\n\n/// # Safety\n/// `out` must point to a writable `c2Raycast`.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n    unsafe { ray_to_circle(A, B, out) }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n    aabb_to_aabb(A, B)\n}\n\n/// # Safety\n/// `out` must point to a writable `c2Raycast`.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n    unsafe { ray_to_aabb(A, B, out) }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    ccw90(a)\n}\n\n/// In the standalone `c2MulmvT` the reference build happens to use `b` as the\n/// `mulss` destination for the first row and `a.y` for the second; that is\n/// observable when both factors are NaN.  Mirrored here.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulmvT(a: c2m, b: c2v) -> c2v {\n    let mut c = c2v { x: 0.0, y: 0.0 };\n    c.x = fadd(fmul(b.x, a.x.x), fmul(b.y, a.x.y));\n    c.y = fadd(fmul(a.y.x, b.x), fmul(a.y.y, b.y));\n    c\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoPoint(A: c2AABB, B: c2v) -> c_int {\n    aabb_to_point(A, B)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircleToPoint(A: c2Circle, B: c2v) -> c_int {\n    circle_to_point(A, B)\n}\n\n/// # Safety\n/// `out` must point to a writable `c2Raycast`.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2RaytoCapsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n    unsafe { ray_to_capsule(A, B, out) }\n}\n\n/// # Safety\n/// `B` must point to a `c2Circle`, `c2AABB` or `c2Capsule` matching `typeB`,\n/// and `out` must point to a writable `c2Raycast`.\n///\n/// The C original has neither a `default:` label nor a `return` after the\n/// `switch`, so an out-of-range `typeB` falls off the end of the function.  On\n/// the reference build that leaves `eax` holding the low 32 bits of the `B`\n/// pointer; that (undefined) behaviour is mirrored rather than \"fixed\".\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2CastRay(\n    A: c2Ray,\n    B: *const c_void,\n    typeB: c_int,\n    out: *mut c2Raycast,\n) -> c_int {\n    unsafe {\n        match typeB {\n            C2_TYPE_CIRCLE => ray_to_circle(A, *(B as *const c2Circle), out),\n            C2_TYPE_AABB => ray_to_aabb(A, *(B as *const c2AABB), out),\n            C2_TYPE_CAPSULE => ray_to_capsule(A, *(B as *const c2Capsule), out),\n            // Falls off the end of the C `switch`: garbage return value.\n            _ => (B as usize as u32) as c_int,\n        }\n    }\n}\n\n/// # Safety\n/// `cast1`, `cast2` and `cast3` must point to writable `c2Raycast` values.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn gen_ray(\n    cast1: *mut c2Raycast,\n    cast2: *mut c2Raycast,\n    cast3: *mut c2Raycast,\n    mp_x: f32,\n    mp_y: f32,\n    r_p_x: f32,\n    r_p_y: f32,\n    c_p_x: f32,\n    c_p_y: f32,\n    c_r: f32,\n    cap_a_x: f32,\n    cap_a_y: f32,\n    cap_b_x: f32,\n    cap_b_y: f32,\n    cap_r: f32,\n    bb_min_x: f32,\n    bb_min_y: f32,\n    bb_max_x: f32,\n    bb_max_y: f32,\n) -> c_int {\n    let mut hit: c_int = 0;\n\n    let mp = c2v_new(mp_x, mp_y);\n\n    let mut ray = c2Ray::default();\n    ray.p = c2v_new(r_p_x, r_p_y);\n    ray.d = norm(sub(mp, ray.p));\n    ray.t = fsub(dot(mp, ray.d), dot(ray.p, ray.d));\n\n    let mut c = c2Circle::default();\n    c.p = c2v_new(c_p_x, c_p_y);\n    c.r = c_r;\n\n    hit = hit.wrapping_add(unsafe {\n        c2CastRay(ray, (&raw const c) as *const c_void, C2_TYPE_CIRCLE, cast1)\n    });\n\n    let mut cap = c2Capsule::default();\n    cap.a = c2v_new(cap_a_x, cap_a_y);\n    cap.b = c2v_new(cap_b_x, cap_b_y);\n    cap.r = cap_r;\n\n    hit = hit.wrapping_add(\n        unsafe {\n            c2CastRay(\n                ray,\n                (&raw const cap) as *const c_void,\n                C2_TYPE_CAPSULE,\n                cast2,\n            )\n        } << 1,\n    );\n\n    let mut bb = c2AABB::default();\n    bb.min = c2v_new(bb_min_x, bb_min_y);\n    bb.max = c2v_new(bb_max_x, bb_max_y);\n\n    hit = hit.wrapping_add(\n        unsafe { c2CastRay(ray, (&raw const bb) as *const c_void, C2_TYPE_AABB, cast3) } << 2,\n    );\n\n    hit\n}\n","numLines":710,"startLine":1,"totalLines":710}}}
