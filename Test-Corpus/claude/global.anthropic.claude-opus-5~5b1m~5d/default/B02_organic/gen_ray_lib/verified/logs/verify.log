n    hit = hit.wrapping_add(\n        unsafe { c2CastRay(ray, (&raw const bb) as *const c_void, C2_TYPE_AABB, cast3) } << 2,\n    );\n\n    hit\n}\n","structuredPatch":[{"oldStart":176,"oldLines":9,"newStart":176,"newLines":22,"lines":[" }"," "," /// `c2Dot`","+///","+/// gcc -O0 emits, in order:","+/// ```text","+///   movss a.x,%xmm1 ; movss b.x,%xmm0 ; mulss %xmm0,%xmm1   -> dest = a.x","+///   movss a.y,%xmm2 ; movss b.y,%xmm0 ; mulss %xmm2,%xmm0   -> dest = b.y","+///   addss %xmm1,%xmm0                                       -> dest = y-product","+/// ```","+/// so the `y` product and the sum both take their *second* source operand as","+/// the `mulss`/`addss` destination. That is observable whenever both operands","+/// are NaN (the destination's payload wins), hence the deliberate argument","+/// order below."," #[inline(always)]"," fn dot(a: c2v, b: c2v) -> f32 {","-    fadd(fmul(a.x, b.x), fmul(a.y, b.y))","+    let x_prod = fmul(a.x, b.x);","+    let y_prod = fmul(b.y, a.y);","+    fadd(y_prod, x_prod)"," }"," "," /// `c2Len`"]}],"userModified":false,"replaceAll":false}}
