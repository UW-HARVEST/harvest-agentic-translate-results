{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Bq2JvdTLyK9D4rejHQ7p9j","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (a trimmed-down `cute_c2`\n2\t//! style 2D raycast library).\n3\t//!\n4\t//! Every public symbol exported by the C shared object is re-exported here with\n5\t//! the identical name, C ABI and bit-for-bit identical floating-point\n6\t//! behaviour.  The original C source is *not* corrected: its quirks are\n7\t//! reproduced exactly, including\n8\t//!\n9\t//!   * `c2Div` multiplying by `1.0f / b` instead of dividing,\n10\t//!   * `fabsf`/`fminf`/`fmaxf` spelled as ternaries (so `-0.0` and `-NaN` keep\n11\t//!     their sign, unlike the real libm functions),\n12\t//!   * the missing `default:`/trailing `return` in `c2CastRay`.\n13\t//!\n14\t//! ## Why the `f*` arithmetic helpers exist\n15\t//!\n16\t//! `mulss`/`addss` return the *destination* operand when both operands are\n17\t//! NaN, and LLVM is free to commute the operands of `fmul`/`fadd` (it considers\n18\t//! NaN payload/sign propagation non-deterministic).  That makes plain `a * b`\n19\t//! observably different from C for inputs such as `±inf` or NaN.  The helpers\n20\t//! below pin each operand to the role it has in the C source so the emitted\n21\t//! instruction sequence matches the reference build operand-for-operand.\n22\t\n23\t#![allow(non_snake_case)]\n24\t#![allow(non_camel_case_types)]\n25\t\n26\tuse std::ffi::{c_int, c_void};\n27\t\n28\t// ---------------------------------------------------------------------------\n29\t// Order-preserving scalar float arithmetic\n30\t// ---------------------------------------------------------------------------\n31\t\n32\tmacro_rules! ordered_binop {\n33\t    ($name:ident, $mnemonic:literal, $fallback:expr) => {\n34\t        #[inline(always)]\n35\t        fn $name(a: f32, b: f32) -> f32 {\n36\t            #[cfg(target_arch = \"x86_64\")]\n37\t            {\n38\t                let mut r = a;\n39\t                // SAFETY: a pure, memory-free SSE scalar instruction on two\n40\t                // `f32` values held in `xmm` registers.\n41\t                unsafe {\n42\t                    core::arch::asm!(\n43\t                        concat!($mnemonic, \" {0}, {1}\"),\n44\t                        inout(xmm_reg) r,\n45\t                        in(xmm_reg) b,\n46\t                        options(pure, nomem, nostack, preserves_flags),\n47\t                    );\n48\t                }\n49\t                r\n50\t            }\n51\t            #[cfg(not(target_arch = \"x86_64\"))]\n52\t            {\n53\t                let f: fn(f32, f32) -> f32 = $fallback;\n54\t                f(a, b)\n55\t            }\n56\t        }\n57\t    };\n58\t}\n59\t\n60\tordered_binop!(fadd, \"addss\", |a, b| a + b);\n61\tordered_binop!(fsub, \"subss\", |a, b| a - b);\n62\tordered_binop!(fmul, \"mulss\", |a, b| a * b);\n63\tordered_binop!(fdiv, \"divss\", |a, b| a / b);\n64\t\n65\t/// `sqrtf(a)` — identical result to glibc's `sqrtf` (both are a single\n66\t/// `sqrtss`, including the `-NaN` produced for negative arguments).\n67\t#[inline(always)]\n68\tfn fsqrt(a: f32) -> f32 {\n69\t    a.sqrt()\n70\t}\n71\t\n72\t/// Reproduces the C source's inlined `fabsf` idiom `((a) < 0 ? -(a) : (a))`.\n73\t///\n74\t/// Differs from `f32::abs` for `-0.0` and `-NaN` (which are returned\n75\t/// unchanged, because `x < 0` is false for both) — the C behaviour is kept.\n76\t#[inline(always)]\n77\tfn abs_ternary(a: f32) -> f32 {\n78\t    if a < 0.0 { -a } else { a }\n79\t}\n80\t\n81\t/// Reproduces `((a) < (b) ? (a) : (b))`.\n82\t#[inline(always)]\n83\tfn min_ternary(a: f32, b: f32) -> f32 {\n84\t    if a < b { a } else { b }\n85\t}\n86\t\n87\t/// Reproduces `((a) > (b) ? (a) : (b))`.\n88\t#[inline(always)]\n89\tfn max_ternary(a: f32, b: f32) -> f32 {\n90\t    if a > b { a } else { b }\n91\t}\n92\t\n93\t// ---------------------------------------------------------------------------\n94\t// Public types (include/lib.h)\n95\t// ---------------------------------------------------------------------------\n96\t\n97\t/// `typedef struct c2v { float x; float y; } c2v;`\n98\t#[repr(C)]\n99\t#[derive(Copy, Clone, Debug, Default)]\n100\tpub struct c2v {\n101\t    pub x: f32,\n102\t    pub y: f32,\n103\t}\n104\t\n105\t/// `typedef struct c2Raycast { float t; c2v n; } c2Raycast;`\n106\t#[repr(C)]\n107\t#[derive(Copy, Clone, Debug, Default)]\n108\tpub struct c2Raycast {\n109\t    pub t: f32,\n110\t    pub n: c2v,\n111\t}\n112\t\n113\t// ---------------------------------------------------------------------------\n114\t// Private types (src/lib.c)\n115\t// ---------------------------------------------------------------------------\n116\t\n117\t/// `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;`\n118\tpub const C2_TYPE_CIRCLE: c_int = 0;\n119\tpub const C2_TYPE_AABB: c_int = 1;\n120\tpub const C2_TYPE_CAPSULE: c_int = 2;\n121\t\n122\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n123\t#[repr(C)]\n124\t#[derive(Copy, Clone, Debug, Default)]\n125\tpub struct c2Circle {\n126\t    pub p: c2v,\n127\t    pub r: f32,\n128\t}\n129\t\n130\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n131\t#[repr(C)]\n132\t#[derive(Copy, Clone, Debug, Default)]\n133\tpub struct c2AABB {\n134\t    pub min: c2v,\n135\t    pub max: c2v,\n136\t}\n137\t\n138\t/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n139\t#[repr(C)]\n140\t#[derive(Copy, Clone, Debug, Default)]\n141\tpub struct c2Capsule {\n142\t    pub a: c2v,\n143\t    pub b: c2v,\n144\t    pub r: f32,\n145\t}\n146\t\n147\t/// `typedef struct c2Ray { c2v p; c2v d; float t; } c2Ray;`\n148\t#[repr(C)]\n149\t#[derive(Copy, Clone, Debug, Default)]\n150\tpub struct c2Ray {\n151\t    pub p: c2v,\n152\t    pub d: c2v,\n153\t    pub t: f32,\n154\t}\n155\t\n156\t/// `typedef struct c2m { c2v x; c2v y; } c2m;`\n157\t#[repr(C)]\n158\t#[derive(Copy, Clone, Debug, Default)]\n159\tpub struct c2m {\n160\t    pub x: c2v,\n161\t    pub y: c2v,\n162\t}\n163\t\n164\t// ---------------------------------------------------------------------------\n165\t// Internal implementations.  The exported `extern \"C\"` wrappers further down\n166\t// are thin shims over these, so the internal call graph mirrors the C one.\n167\t// ---------------------------------------------------------------------------\n168\t\n169\t/// `c2V`\n170\t#[inline(always)]\n171\tfn c2v_new(x: f32, y: f32) -> c2v {\n172\t    let mut a = c2v { x: 0.0, y: 0.0 };\n173\t    a.x = x;\n174\t    a.y = y;\n175\t    a\n176\t}\n177\t\n178\t/// `c2Dot`\n179\t#[inline(always)]\n180\tfn dot(a: c2v, b: c2v) -> f32 {\n181\t    fadd(fmul(a.x, b.x), fmul(a.y, b.y))\n182\t}\n183\t\n184\t/// `c2Len`\n185\t#[inline(always)]\n186\tfn len(a: c2v) -> f32 {\n187\t    fsqrt(dot(a, a))\n188\t}\n189\t\n190\t/// `c2Add`\n191\t#[inline(always)]\n192\tfn add(mut a: c2v, b: c2v) -> c2v {\n193\t    a.x = fadd(a.x, b.x);\n194\t    a.y = fadd(a.y, b.y);\n195\t    a\n196\t}\n197\t\n198\t/// `c2Sub`\n199\t#[inline(always)]\n200\tfn sub(mut a: c2v, b: c2v) -> c2v {\n201\t    a.x = fsub(a.x, b.x);\n202\t    a.y = fsub(a.y, b.y);\n203\t    a\n204\t}\n205\t\n206\t/// `c2Mulvs`\n207\t///\n208\t/// The reference build keeps `a.x` as the `mulss` destination for the `x` lane\n209\t/// but uses `b` as the destination for the `y` lane, which is observable when\n210\t/// both operands are NaN (the destination wins).  Mirrored here.\n211\t#[inline(always)]\n212\tfn mulvs(mut a: c2v, b: f32) -> c2v {\n213\t    a.x = fmul(a.x, b);\n214\t    a.y = fmul(b, a.y);\n215\t    a\n216\t}\n217\t\n218\t/// `c2Div` — note the reciprocal multiply, which is observable in the low bits.\n219\t#[inline(always)]\n220\tfn div(a: c2v, b: f32) -> c2v {\n221\t    mulvs(a, fdiv(1.0f32, b))\n222\t}\n223\t\n224\t/// `c2Norm`\n225\t#[inline(always)]\n226\tfn norm(a: c2v) -> c2v {\n227\t    div(a, len(a))\n228\t}\n229\t\n230\t/// `c2Minv`\n231\t#[inline(always)]\n232\tfn minv(a: c2v, b: c2v) -> c2v {\n233\t    c2v_new(min_ternary(a.x, b.x), min_ternary(a.y, b.y))\n234\t}\n235\t\n236\t/// `c2Maxv`\n237\t#[inline(always)]\n238\tfn maxv(a: c2v, b: c2v) -> c2v {\n239\t    c2v_new(max_ternary(a.x, b.x), max_ternary(a.y, b.y))\n240\t}\n241\t\n242\t/// `c2Skew`\n243\t#[inline(always)]\n244\tfn skew(a: c2v) -> c2v {\n245\t    let mut b = c2v { x: 0.0, y: 0.0 };\n246\t    b.x = -a.y;\n247\t    b.y = a.x;\n248\t    b\n249\t}\n250\t\n251\t/// `c2Absv`\n252\t#[inline(always)]\n253\tfn absv(a: c2v) -> c2v {\n254\t    c2v_new(abs_ternary(a.x), abs_ternary(a.y))\n255\t}\n256\t\n257\t/// `c2CCW90`\n258\t#[inline(always)]\n259\tfn ccw90(a: c2v) -> c2v {\n260\t    let mut b = c2v { x: 0.0, y: 0.0 };\n261\t    b.x = a.y;\n262\t    b.y = -a.x;\n263\t    b\n264\t}\n265\t\n266\t/// `c2MulmvT`\n267\t#[inline(always)]\n268\tfn mulmv_t(a: c2m, b: c2v) -> c2v {\n269\t    let mut c = c2v { x: 0.0, y: 0.0 };\n270\t    c.x = fadd(fmul(a.x.x, b.x), fmul(a.x.y, b.y));\n271\t    c.y = fadd(fmul(a.y.x, b.x), fmul(a.y.y, b.y));\n272\t    c\n273\t}\n274\t\n275\t/// `c2AABBtoAABB`\n276\t#[inline(always)]\n277\tfn aabb_to_aabb(A: c2AABB, B: c2AABB) -> c_int {\n278\t    let d0 = (B.max.x < A.min.x) as c_int;\n279\t    let d1 = (A.max.x < B.min.x) as c_int;\n280\t    let d2 = (B.max.y < A.min.y) as c_int;\n281\t    let d3 = (A.max.y < B.min.y) as c_int;\n282\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n283\t}\n284\t\n285\t/// `c2AABBtoPoint`\n286\t#[inline(always)]\n287\tfn aabb_to_point(A: c2AABB, B: c2v) -> c_int {\n288\t    let d0 = (B.x < A.min.x) as c_int;\n289\t    let d1 = (B.y < A.min.y) as c_int;\n290\t    let d2 = (B.x > A.max.x) as c_int;\n291\t    let d3 = (B.y > A.max.y) as c_int;\n292\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n293\t}\n294\t\n295\t/// `c2CircleToPoint`\n296\t#[inline(always)]\n297\tfn circle_to_point(A: c2Circle, B: c2v) -> c_int {\n298\t    let n = sub(A.p, B);\n299\t    let d2 = dot(n, n);\n300\t    (d2 < fmul(A.r, A.r)) as c_int\n301\t}\n302\t\n303\t/// `static inline float c2SignedDistPointToPlane_OneDimensional(float p, float n, float d)`\n304\t#[inline(always)]\n305\tfn signed_dist_point_to_plane_one_dimensional(p: f32, n: f32, d: f32) -> f32 {\n306\t    fsub(fmul(p, n), fmul(d, n))\n307\t}\n308\t\n309\t/// `static inline float c2RayToPlane_OneDimensional(float da, float db)`\n310\t#[inline(always)]\n311\tfn ray_to_plane_one_dimensional(da: f32, db: f32) -> f32 {\n312\t    if da < 0.0 {\n313\t        0.0\n314\t    } else if fmul(da, db) > 0.0 {\n315\t        1.0f32\n316\t    } else {\n317\t        let d = fsub(da, db);\n318\t        if d != 0.0 { fdiv(da, d) } else { 0.0 }\n319\t    }\n320\t}\n321\t\n322\t/// `c2RaytoCircle`\n323\t///\n324\t/// # Safety\n325\t/// `out` must be a valid, writable pointer to a `c2Raycast` (the C code\n326\t/// dereferences it unconditionally on the hit path).\n327\tunsafe fn ray_to_circle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n328\t    let p = B.p;\n329\t    let m = sub(A.p, p);\n330\t    let c = fsub(dot(m, m), fmul(B.r, B.r));\n331\t    let b = dot(m, A.d);\n332\t    let disc = fsub(fmul(b, b), c);\n333\t    if disc < 0.0 {\n334\t        return 0;\n335\t    }\n336\t    let t = fsub(-b, fsqrt(disc));\n337\t    if t >= 0.0 && t <= A.t {\n338\t        unsafe {\n339\t            (*out).t = t;\n340\t        }\n341\t        let impact = add(A.p, mulvs(A.d, t));\n342\t        unsafe {\n343\t            (*out).n = norm(sub(impact, p));\n344\t        }\n345\t        return 1;\n346\t    }\n347\t    0\n348\t}\n349\t\n350\t/// `c2RaytoAABB`\n351\t///\n352\t/// # Safety\n353\t/// `out` must be a valid, writable pointer to a `c2Raycast`.\n354\tunsafe fn ray_to_aabb(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n355\t    let p0 = A.p;\n356\t    let p1 = add(A.p, mulvs(A.d, A.t));\n357\t    let mut a_box = c2AABB::default();\n358\t    a_box.min = minv(p0, p1);\n359\t    a_box.max = maxv(p0, p1);\n360\t    if aabb_to_aabb(a_box, B) == 0 {\n361\t        return 0;\n362\t    }\n363\t    let ab = sub(p1, p0);\n364\t    let n = skew(ab);\n365\t    let abs_n = absv(n);\n366\t    let half_extents = mulvs(sub(B.max, B.min), 0.5f32);\n367\t    let center_of_b_box = mulvs(add(B.min, B.max), 0.5f32);\n368\t    let d = fsub(\n369\t        abs_ternary(dot(n, sub(p0, center_of_b_box))),\n370\t        dot(abs_n, half_extents),\n371\t    );\n372\t    if d > 0.0 {\n373\t        return 0;\n374\t    }\n375\t    let da0 = signed_dist_point_to_plane_one_dimensional(p0.x, -1.0f32, B.min.x);\n376\t    let db0 = signed_dist_point_to_plane_one_dimensional(p1.x, -1.0f32, B.min.x);\n377\t    let da1 = signed_dist_point_to_plane_one_dimensional(p0.x, 1.0f32, B.max.x);\n378\t    let db1 = signed_dist_point_to_plane_one_dimensional(p1.x, 1.0f32, B.max.x);\n379\t    let da2 = signed_dist_point_to_plane_one_dimensional(p0.y, -1.0f32, B.min.y);\n380\t    let db2 = signed_dist_point_to_plane_one_dimensional(p1.y, -1.0f32, B.min.y);\n381\t    let da3 = signed_dist_point_to_plane_one_dimensional(p0.y, 1.0f32, B.max.y);\n382\t    let db3 = signed_dist_point_to_plane_one_dimensional(p1.y, 1.0f32, B.max.y);\n383\t    let mut t0 = ray_to_plane_one_dimensional(da0, db0);\n384\t    let mut t1 = ray_to_plane_one_dimensional(da1, db1);\n385\t    let mut t2 = ray_to_plane_one_dimensional(da2, db2);\n386\t    let mut t3 = ray_to_plane_one_dimensional(da3, db3);\n387\t    let hit0 = (t0 <= 1.0f32) as c_int;\n388\t    let hit1 = (t1 <= 1.0f32) as c_int;\n389\t    let hit2 = (t2 <= 1.0f32) as c_int;\n390\t    let hit3 = (t3 <= 1.0f32) as c_int;\n391\t    let hit = hit0 | hit1 | hit2 | hit3;\n392\t    if hit != 0 {\n393\t        t0 = fmul(hit0 as f32, t0);\n394\t        t1 = fmul(hit1 as f32, t1);\n395\t        t2 = fmul(hit2 as f32, t2);\n396\t        t3 = fmul(hit3 as f32, t3);\n397\t        if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n398\t            unsafe {\n399\t                (*out).t = fmul(t0, A.t);\n400\t                (*out).n = c2v_new(-1.0, 0.0);\n401\t            }\n402\t        } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n403\t            unsafe {\n404\t                (*out).t = fmul(t1, A.t);\n405\t                (*out).n = c2v_new(1.0, 0.0);\n406\t            }\n407\t        } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n408\t            unsafe {\n409\t                (*out).t = fmul(t2, A.t);\n410\t                (*out).n = c2v_new(0.0, -1.0);\n411\t            }\n412\t        } else {\n413\t            unsafe {\n414\t                (*out).t = fmul(t3, A.t);\n415\t                (*out).n = c2v_new(0.0, 1.0);\n416\t            }\n417\t        }\n418\t        1\n419\t    } else {\n420\t        0\n421\t    }\n422\t}\n423\t\n424\t/// `c2RaytoCapsule`\n425\t///\n426\t/// # Safety\n427\t/// `out` must be a valid, writable pointer to a `c2Raycast`.\n428\tunsafe fn ray_to_capsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n429\t    let mut M = c2m::default();\n430\t    M.y = norm(sub(B.b, B.a));\n431\t    M.x = ccw90(M.y);\n432\t    let cap_n = sub(B.b, B.a);\n433\t    let yBb = mulmv_t(M, cap_n);\n434\t    let yAp = mulmv_t(M, sub(A.p, B.a));\n435\t    let yAd = mulmv_t(M, A.d);\n436\t    let yAe = add(yAp, mulvs(yAd, A.t));\n437\t    let mut capsule_bb = c2AABB::default();\n438\t    capsule_bb.min = c2v_new(-B.r, 0.0);\n439\t    capsule_bb.max = c2v_new(B.r, yBb.y);\n440\t    unsafe {\n441\t        (*out).n = norm(cap_n);\n442\t        (*out).t = 0.0;\n443\t    }\n444\t    if aabb_to_point(capsule_bb, yAp) != 0 {\n445\t        return 1;\n446\t    } else {\n447\t        let mut capsule_a = c2Circle::default();\n448\t        let mut capsule_b = c2Circle::default();\n449\t        capsule_a.p = B.a;\n450\t        capsule_a.r = B.r;\n451\t        capsule_b.p = B.b;\n452\t        capsule_b.r = B.r;\n453\t        if circle_to_point(capsule_a, A.p) != 0 {\n454\t            return 1;\n455\t        } else if circle_to_point(capsule_b, A.p) != 0 {\n456\t            return 1;\n457\t        }\n458\t    }\n459\t    if fmul(yAe.x, yAp.x) < 0.0\n460\t        || min_ternary(abs_ternary(yAe.x), abs_ternary(yAp.x)) < B.r\n461\t    {\n462\t        let mut Ca = c2Circle::default();\n463\t        let mut Cb = c2Circle::default();\n464\t        Ca.p = B.a;\n465\t        Ca.r = B.r;\n466\t        Cb.p = B.b;\n467\t        Cb.r = B.r;\n468\t        if abs_ternary(yAp.x) < B.r {\n469\t            if yAp.y < 0.0 {\n470\t                return unsafe { ray_to_circle(A, Ca, out) };\n471\t            } else {\n472\t                return unsafe { ray_to_circle(A, Cb, out) };\n473\t            }\n474\t        } else {\n475\t            let c = if yAp.x > 0.0 { B.r } else { -B.r };\n476\t            let d = fsub(yAe.x, yAp.x);\n477\t            let t = fdiv(fsub(c, yAp.x), d);\n478\t            let y = fadd(yAp.y, fmul(fsub(yAe.y, yAp.y), t));\n479\t            if y <= 0.0 {\n480\t                return unsafe { ray_to_circle(A, Ca, out) };\n481\t            }\n482\t            if y >= yBb.y {\n483\t                return unsafe { ray_to_circle(A, Cb, out) };\n484\t            } else {\n485\t                unsafe {\n486\t                    (*out).n = if c > 0.0 { M.x } else { skew(M.y) };\n487\t                    (*out).t = fmul(t, A.t);\n488\t                }\n489\t                return 1;\n490\t            }\n491\t        }\n492\t    }\n493\t    0\n494\t}\n495\t\n496\t// ---------------------------------------------------------------------------\n497\t// Exported C ABI surface\n498\t// ---------------------------------------------------------------------------\n499\t\n500\t#[unsafe(no_mangle)]\n501\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n502\t    c2v_new(x, y)\n503\t}\n504\t\n505\t#[unsafe(no_mangle)]\n506\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n507\t    dot(a, b)\n508\t}\n509\t\n510\t#[unsafe(no_mangle)]\n511\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n512\t    len(a)\n513\t}\n514\t\n515\t/// The reference build emits `addss` with `b` as the destination for both\n516\t/// lanes of the standalone `c2Add`, which is observable when both addends are\n517\t/// NaN (the destination operand wins).  Mirrored here.\n518\t#[unsafe(no_mangle)]\n519\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n520\t    a.x = fadd(b.x, a.x);\n521\t    a.y = fadd(b.y, a.y);\n522\t    a\n523\t}\n524\t\n525\t#[unsafe(no_mangle)]\n526\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n527\t    sub(a, b)\n528\t}\n529\t\n530\t#[unsafe(no_mangle)]\n531\tpub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n532\t    mulvs(a, b)\n533\t}\n534\t\n535\t#[unsafe(no_mangle)]\n536\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n537\t    div(a, b)\n538\t}\n539\t\n540\t#[unsafe(no_mangle)]\n541\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n542\t    norm(a)\n543\t}\n544\t\n545\t#[unsafe(no_mangle)]\n546\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n547\t    minv(a, b)\n548\t}\n549\t\n550\t#[unsafe(no_mangle)]\n551\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n552\t    maxv(a, b)\n553\t}\n554\t\n555\t#[unsafe(no_mangle)]\n556\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n557\t    skew(a)\n558\t}\n559\t\n560\t#[unsafe(no_mangle)]\n561\tpub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n562\t    absv(a)\n563\t}\n564\t\n565\t/// # Safety\n566\t/// `out` must point to a writable `c2Raycast`.\n567\t#[unsafe(no_mangle)]\n568\tpub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n569\t    unsafe { ray_to_circle(A, B, out) }\n570\t}\n571\t\n572\t#[unsafe(no_mangle)]\n573\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n574\t    aabb_to_aabb(A, B)\n575\t}\n576\t\n577\t/// # Safety\n578\t/// `out` must point to a writable `c2Raycast`.\n579\t#[unsafe(no_mangle)]\n580\tpub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n581\t    unsafe { ray_to_aabb(A, B, out) }\n582\t}\n583\t\n584\t#[unsafe(no_mangle)]\n585\tpub extern \"C\" fn c2CCW90(a