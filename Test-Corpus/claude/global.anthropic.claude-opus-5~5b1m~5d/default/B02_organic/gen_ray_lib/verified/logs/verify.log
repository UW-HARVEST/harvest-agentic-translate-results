PARITY PASSED\"","+else","+    echo \"FAILURES DETECTED\"; exit 1","+fi"]}],"originalFile":"#!/usr/bin/env bash\n# Differential-test driver.\n#\n# `cargo test` does NOT rebuild the `cdylib` (an integration test target does\n# not depend on it), so the cdylib MUST be built explicitly first — otherwise\n# the tests silently `dlopen` a stale `libgen_ray_lib.so`.\n#\n# Usage: ./run_diff_tests.sh [extra cargo args...]\nset -euo pipefail\ncd \"$(dirname \"$0\")\"\nexport CARGO_NET_OFFLINE=true\n\n# 1. Build the C reference shared object.\nif [ ! -d ../c_src/build ]; then\n    mkdir -p ../c_src/build\n    (cd ../c_src/build && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON >/dev/null)\nfi\ncmake --build ../c_src/build >/dev/null\n\n# 2. Enumerate feature combinations. Cargo.toml declares no [features], so the\n#    only combination is the (empty) default; the loop is written generically so\n#    it keeps working if features are ever added.\nFEATURES=$(cargo metadata --offline --format-version 1 --no-deps \\\n    | tr '{}' '\\n' | grep -o '\"features\":[^}]*' | head -1 || true)\necho \"declared features: ${FEATURES:-none}\"\n\nCOMBOS=(\"--no-default-features\" \"\")   # {} and {default}\nPROFILES=(\"\" \"--release\")\n\nfor combo in \"${COMBOS[@]}\"; do\n  for profile in \"${PROFILES[@]}\"; do\n    echo \"==============================================================\"\n    echo \"== features: '${combo:-default}'   profile: '${profile:-debug}'\"\n    echo \"==============================================================\"\n    # shellcheck disable=SC2086\n    cargo build --offline $combo $profile\n    # shellcheck disable=SC2086\n    cargo test --offline $combo $profile \"$@\" -- --test-threads=4\n  done\ndone\n\n# 3. Symbol parity gate.\necho \"==============================================================\"\necho \"== symbol parity\"\necho \"==============================================================\"\nnm -D --defined-only ../c_src/build/*.so | awk '{print $3}' | sort > /dev/shm/.c_syms.$$ 2>/dev/null \\\n  || nm -D --defined-only ../c_src/build/*.so | awk '{print $3}' | sort > ./.c_syms.$$\nCS=$( [ -f /dev/shm/.c_syms.$$ ] && echo /dev/shm/.c_syms.$$ || echo ./.c_syms.$$ )\nnm -D --defined-only target/release/libgen_ray_lib.so | awk '{print $3}' | sort > \"${CS%.c_syms*}.r_syms.$$\" 2>/dev/null || true\nRS=\"$(dirname \"$CS\")/.r_syms.$$\"\nnm -D --defined-only target/release/libgen_ray_lib.so | awk '{print $3}' | sort > \"$RS\"\nMISSING=$(comm -23 \"$CS\" \"$RS\")\nEXTRA=$(comm -13 \"$CS\" \"$RS\")\nrm -f \"$CS\" \"$RS\"\nif [ -n \"$MISSING\" ]; then echo \"MISSING FROM RUST:\"; echo \"$MISSING\"; exit 1; fi\nif [ -n \"$EXTRA\" ]; then echo \"EXTRA IN RUST: $EXTRA\"; fi\necho \"symbol parity OK (0 missing)\"\necho \"ALL DIFFERENTIAL TESTS PASSED\"\n","userModified":false}}
