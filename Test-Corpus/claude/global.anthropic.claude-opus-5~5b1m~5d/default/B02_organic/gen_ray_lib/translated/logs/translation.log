C2_TYPE;`\npub const C2_TYPE_CIRCLE: c_int = 0;\npub const C2_TYPE_AABB: c_int = 1;\npub const C2_TYPE_CAPSULE: c_int = 2;\n\n/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2Ray { c2v p; c2v d; float t; } c2Ray;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Ray {\n    pub p: c2v,\n    pub d: c2v,\n    pub t: f32,\n}\n\n/// `typedef struct c2m { c2v x; c2v y; } c2m;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2m {\n    pub x: c2v,\n    pub y: c2v,\n}\n\n// ---------------------------------------------------------------------------\n// Helpers mirroring the C source's macro-expanded expressions\n// ---------------------------------------------------------------------------\n\n/// Reproduces the C source's inlined `fabsf` idiom `((a) < 0 ? -(a) : (a))`.\n///\n/// Note that this differs from `f32::abs` for `-0.0` (returns `-0.0`, because\n/// `-0.0 < 0` is false) — the C behaviour is preserved deliberately.\n#[inline]\nfn abs_ternary(a: f32) -> f32 {\n    if a < 0.0 { -a } else { a }\n}\n\n/// Reproduces `((a) < (b) ? (a) : (b))`.\n#[inline]\nfn min_ternary(a: f32, b: f32) -> f32 {\n    if a < b { a } else { b }\n}\n\n/// Reproduces `((a) > (b) ? (a) : (b))`.\n#[inline]\nfn max_ternary(a: f32, b: f32) -> f32 {\n    if a > b { a } else { b }\n}\n\n// ---------------------------------------------------------------------------\n// Internal (non-ABI) implementations.  The exported `extern \"C\"` wrappers below\n// are thin shims over these so the internal call graph mirrors the C one.\n// ---------------------------------------------------------------------------\n\n#[inline]\nfn c2v_new(x: f32, y: f32) -> c2v {\n    let mut a = c2v::default();\n    a.x = x;\n    a.y = y;\n    a\n}\n\n#[inline]\nfn dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n#[inline]\nfn len(a: c2v) -> f32 {\n    dot(a, a).sqrt()\n}\n\n#[inline]\nfn add(mut a: c2v, b: c2v) -> c2v {\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[inline]\nfn sub(mut a: c2v, b: c2v) -> c2v {\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[inline]\nfn mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n/// `c2Div` multiplies by the reciprocal (`1.0f / b`) rather than dividing —\n/// this is observable in the low bits, so it is preserved.\n#[inline]\nfn div(a: c2v, b: f32) -> c2v {\n    mulvs(a, 1.0f32 / b)\n}\n\n#[inline]\nfn norm(a: c2v) -> c2v {\n    div(a, len(a))\n}\n\n#[inline]\nfn minv(a: c2v, b: c2v) -> c2v {\n    c2v_new(min_ternary(a.x, b.x), min_ternary(a.y, b.y))\n}\n\n#[inline]\nfn maxv(a: c2v, b: c2v) -> c2v {\n    c2v_new(max_ternary(a.x, b.x), max_ternary(a.y, b.y))\n}\n\n#[inline]\nfn skew(a: c2v) -> c2v {\n    let mut b = c2v::default();\n    b.x = -a.y;\n    b.y = a.x;\n    b\n}\n\n#[inline]\nfn absv(a: c2v) -> c2v {\n    c2v_new(abs_ternary(a.x), abs_ternary(a.y))\n}\n\n#[inline]\nfn ccw90(a: c2v) -> c2v {\n    let mut b = c2v::default();\n    b.x = a.y;\n    b.y = -a.x;\n    b\n}\n\n#[inline]\nfn mulmv_t(a: c2m, b: c2v) -> c2v {\n    let mut c = c2v::default();\n    c.x = a.x.x * b.x + a.x.y * b.y;\n    c.y = a.y.x * b.x + a.y.y * b.y;\n    c\n}\n\n#[inline]\nfn aabb_to_aabb(A: c2AABB, B: c2AABB) -> c_int {\n    let d0 = (B.max.x < A.min.x) as c_int;\n    let d1 = (A.max.x < B.min.x) as c_int;\n    let d2 = (B.max.y < A.min.y) as c_int;\n    let d3 = (A.max.y < B.min.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n#[inline]\nfn aabb_to_point(A: c2AABB,