ldLines":6,"newStart":401,"newLines":172,"lines":["   for (int r = 0; r < 5; ++r) { a->hm_geti(50 + r * 13); fprintf(o, \"hm_geti chain %d ok\\n\", r); }"," }"," ","+/* ---------------- edge cases from the uncovered branches ---------------- */","+static void test_edges(FILE *o, API *a) {","+  fprintf(o, \"== edges ==\\n\");","+  a->rand_seed(4242);","+  size_t es = sizeof(ipair);","+","+  /* hmput_default on a NULL map (allocates the default slot) */","+  ipair *t = a->hmput_default(NULL, es);","+  t[-1].value = -777;","+  fprintf(o, \"default-on-null: len=%zu cap=%zu tmp=%td def=%d ht=%d\\n\",","+          LEN(t, es), CAP(t, es), TMP(t, es), t[-1].value, HT(t, es) != NULL);","+  /* hmdel on a map that has no hash table yet -> returns a unchanged */","+  ptrdiff_t tmp;","+  ipair *before = t;","+  t = ihmdel(a, t, 5, &tmp);","+  fprintf(o, \"del-no-table: same=%d ret=%td tmp=%td len=%zu\\n\",","+          before == t, tmp, TMP(t, es), LEN(t, es));","+  /* hmget_key on a map with no table */","+  t = ihmgeti(a, t, 5, &tmp);","+  fprintf(o, \"get-no-table: %td\\n\", tmp);","+  ptrdiff_t t2 = 12345;","+  t = ihmgeti_ts(a, t, 5, &t2);","+  fprintf(o, \"get_ts-no-table: %td\\n\", t2);","+  a->hmfree_func((char*)t - es, es);","+","+  /* hmdel_key on NULL */","+  void *r = a->hmdel_key(NULL, es, &(int){3}, sizeof(int), 0, STBDS_HM_BINARY);","+  fprintf(o, \"del-null -> %d\\n\", r == NULL);","+","+  /* hmget_key_ts on NULL creates the array; then hmput_default sees length!=0 */","+  ptrdiff_t tt = 999;","+  ipair *m = a->hmget_key_ts(NULL, es, &(int){1}, sizeof(int), &tt, STBDS_HM_BINARY);","+  fprintf(o, \"get_ts-null: tmp=%td len=%zu cap=%zu ht=%d\\n\", tt, LEN(m, es), CAP(m, es), HT(m, es) != NULL);","+  ipair *m2 = a->hmput_default(m, es);","+  fprintf(o, \"default-on-existing: same=%d len=%zu\\n\", m == m2, LEN(m2, es));","+  a->hmfree_func((char*)m2 - es, es);","+","+  /* shmode_func for every mode value */","+  for (int mode = 0; mode <= 3; ++mode) {","+    void *s = a->shmode_func(sizeof(spair), mode);","+    fprintf(o, \"shmode(%d): len=%zu cap=%zu\", LEN(s, sizeof(spair)), CAP(s, sizeof(spair)), mode);","+    dump_table(o, s, sizeof(spair));","+    fprintf(o, \"\\n\");","+    a->hmfree_func((char*)s - sizeof(spair), sizeof(spair));","+  }","+}","+","+/* stralloc: strings longer than the current block size take the \"big\" path */","+static void test_arena_big(FILE *o, API *a) {","+  fprintf(o, \"== arena big ==\\n\");","+  unsigned char arena[24];","+  struct SA { void *storage; size_t remaining; unsigned char block, mode; };","+  struct SA *sa = (struct SA*)arena;","+  static char big[8192];","+","+  memset(arena, 0, sizeof arena);","+  /* first alloc is huge and the arena is empty -> storage==NULL branch */","+  for (int round = 0; round < 6; ++round) {","+    size_t l = (size_t)(5000 - round * 700);","+    for (size_t j = 0; j < l; ++j) big[j] = (char)('A' + ((round + j) % 26));","+    big[l] = 0;","+    char *p = a->stralloc(sa, big);","+    fprintf(o, \"big %d len=%zu eq=%d rem=%zu block=%u\\n\",","+            round, l, strcmp(p, big) == 0, sa->remaining, (unsigned)sa->block);","+    /* small alloc in between to populate storage */","+    char s[32];","+    snprintf(s, sizeof s, \"small%d\", round);","+    char *q = a->stralloc(sa, s);","+    fprintf(o, \"  small %d eq=%d rem=%zu block=%u\\n\", round, strcmp(q, s) == 0,","+            sa->remaining, (unsigned)sa->block);","+  }","+  a->strreset(sa);","+  fprintf(o, \"big reset storage=%d rem=%zu block=%u\\n\", sa->storage != NULL, sa->remaining, (unsigned)sa->block);","+","+  /* push block size all the way to the 1MB cap */","+  memset(arena, 0, sizeof arena);","+  for (int i = 0; i < 4000; ++i) {","+    size_t l = 400;","+    for (size_t j = 0; j < l; ++j) big[j] = (char)('a' + ((i + j) % 26));","+    big[l] = 0;","+    char *p = a->stralloc(sa, big);","+    if (p == NULL || strcmp(p, big) != 0) { fprintf(o, \"MISMATCH at %d\\n\", i); break; }","+    if (i % 250 == 0) fprintf(o, \"cap-walk %d rem=%zu block=%u\\n\", i, sa->remaining, (unsigned)sa->block);","+  }","+  fprintf(o, \"cap-walk final rem=%zu block=%u\\n\", sa->remaining, (unsigned)sa->block);","+  a->strreset(sa);","+}","+","+/* deterministic insert/delete churn: hits tombstone reuse in both probe loops,","+   plus the rebuild and shrink paths */","+static unsigned long lcg_state;","+static unsigned lcg(void) { lcg_state = lcg_state * 6364136223846793005ULL + 1442695040888963407ULL; return (unsigned)(lcg_state >> 33); }","+","+static void test_churn(FILE *o, API *a, size_t seed, int ops, int space) {","+  fprintf(o, \"== churn seed=%zu ops=%d space=%d ==\\n\", seed, ops, space);","+  a->rand_seed(seed);","+  lcg_state = seed ^ 0x9e3779b97f4a7c15ULL;","+  size_t es = sizeof(ipair);","+  ipair *t = NULL;","+  ptrdiff_t tmp;","+  t = a->hmput_default(NULL, es);","+  t[-1].value = -1;","+  for (int i = 0; i < ops; ++i) {","+    unsigned r = lcg();","+    int k = (int)(r % (unsigned)space);","+    if ((r >> 20) % 3 == 0) {","+      t = ihmdel(a, t, k, &tmp);","+      if (i % 64 == 0) fprintf(o, \"  d%d k=%d r=%td len=%zu\", i, k, tmp, LEN(t, es)), dump_table(o, t, es), fprintf(o, \"\\n\");","+    } else {","+      t = ihmput(a, t, k, k * 3 + i);","+      if (i % 64 == 0) fprintf(o, \"  p%d k=%d len=%zu\", i, k, LEN(t, es)), dump_table(o, t, es), fprintf(o, \"\\n\");","+    }","+  }","+  /* full verification sweep */","+  unsigned long ck = 0;","+  for (int k = 0; k < space; ++k) {","+    t = ihmgeti(a, t, k, &tmp);","+    ck = ck * 1000003u + (unsigned long)(tmp + 3) * 31 + (unsigned)t[tmp].value;","+  }","+  fprintf(o, \"churn ck=%lu len=%zu\", ck, LEN(t, es));","+  dump_table(o, t, es);","+  fprintf(o, \"\\n  elems:\");","+  for (size_t i = 0; i + 1 < LEN(t, es); ++i) fprintf(o, \" (%d,%d)\", t[i].key, t[i].value);","+  fprintf(o, \"\\n\");","+  a->hmfree_func((char*)t - es, es);","+}","+","+/* string-key churn for STRDUP / ARENA / DEFAULT modes */","+static void test_schurn(FILE *o, API *a, size_t seed, int mode, int ops, int space) {","+  fprintf(o, \"== schurn seed=%zu mode=%d ops=%d space=%d ==\\n\", seed, mode, ops, space);","+  a->rand_seed(seed);","+  lcg_state = seed * 3 + 7;","+  size_t es = sizeof(spair);","+  spair *t = NULL;","+  if (mode == STBDS_SH_STRDUP || mode == STBDS_SH_ARENA) t = a->shmode_func(es, mode);","+  /* stable key storage for DEFAULT mode (which stores the caller's pointer) */","+  char **kb = calloc(space, sizeof(char*));","+  for (int i = 0; i < space; ++i) { char b[64]; snprintf(b, sizeof b, \"k%d-%d\", i, i * 7); kb[i] = strdup(b); }","+  for (int i = 0; i < ops; ++i) {","+    unsigned r = lcg();","+    int k = (int)(r % (unsigned)space);","+    if ((r >> 20) % 3 == 0) {","+      t = a->hmdel_key(t, es, kb[k], sizeof(char*), 0, STBDS_HM_STRING);","+      if (i % 97 == 0) fprintf(o, \"  sd%d k=%d r=%td len=%zu\\n\", i, k, t ? TMP(t, es) : 0, t ? LEN(t, es) : 0);","+    } else {","+      t = a->hmput_key(t, es, kb[k], sizeof(char*), STBDS_HM_STRING);","+      t[TMP(t, es)].value = k * 5 + i;","+      if (i % 97 == 0) fprintf(o, \"  sp%d k=%d len=%zu\\n\", i, k, LEN(t, es));","+    }","+  }","+  unsigned long ck = 0;","+  for (int k = 0; k < space; ++k) {","+    t = a->hmget_key(t, es, kb[k], sizeof(char*), STBDS_HM_STRING);","+    ptrdiff_t x = TMP(t, es);","+    ck = ck * 1000003u + (unsigned long)(x + 3) * 31 + (unsigned)t[x].value;","+  }","+  fprintf(o, \"schurn ck=%lu len=%zu\", ck, LEN(t, es));","+  dump_table(o, t, es);","+  fprintf(o, \"\\n  elems:\");","+  for (size_t i = 0; i + 1 < LEN(t, es); ++i) fprintf(o, \" (%s,%d)\", t[i].key, t[i].value);","+  fprintf(o, \"\\n\");","+  a->hmfree_func((char*)t - es, es);","+  for (int i = 0; i < space; ++i) free(kb[i]);","+  free(kb);","+}","+"," static void run(FILE *o, API *a) {","   test_hashes(o, a);","   test_array(o, a);"]}],"userModified":false,"replaceAll":false}}
