{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CCs5iLEgBb99yxr7X9vHMn","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-work-Ul2p7g/.symcmp/difftest.c has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"3a43bf63-973b-4de0-93ab-a99afe88c87f","uuid":"8058edc7-3bd2-4e87-b416-542d5750ed49","timestamp":"2026-08-27T10:23:57.199Z","tool_use_result":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-Ul2p7g/.symcmp/difftest.c","oldString":"  for (int i = 0; i < 4000; ++i) {\n    size_t l = 400;\n    for (size_t j = 0; j < l; ++j) big[j] = (char)('a' + ((i + j) % 26));\n    big[l] = 0;\n    char *p = a->stralloc(sa, big);\n    if (p == NULL || strcmp(p, big) != 0) { fprintf(o, \"MISMATCH at %d\\n\", i); break; }\n    if (i % 250 == 0) fprintf(o, \"cap-walk %d rem=%zu block=%u\\n\", i, sa->remaining, (unsigned)sa->block);\n  }","newString":"  for (int i = 0; i < 12000; ++i) {\n    size_t l = 400;\n    for (size_t j = 0; j < l; ++j) big[j] = (char)('a' + ((i + j) % 26));\n    big[l] = 0;\n    char *p = a->stralloc(sa, big);\n    if (p == NULL || strcmp(p, big) != 0) { fprintf(o, \"MISMATCH at %d\\n\", i); break; }\n    if (i % 250 == 0) fprintf(o, \"cap-walk %d rem=%zu block=%u\\n\", i, sa->remaining, (unsigned)sa->block);\n  }","originalFile":"// Differential test: dlopen the C .so and the Rust .so, run an identical\n// scripted sequence against both through the public ABI, dump everything\n// observable, and compare the two dumps byte-for-byte.\n#define _GNU_SOURCE\n#include <dlfcn.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n\n#define HDR 32\n#define OFF_LEN  0\n#define OFF_CAP  8\n#define OFF_HT  16\n#define OFF_TMP 24\n\ntypedef struct {\n  void  *(*arrgrowf)(void*, size_t, size_t, size_t);\n  void   (*arrfreef)(void*);\n  void   (*rand_seed)(size_t);\n  size_t (*hash_string)(char*, size_t);\n  size_t (*hash_bytes)(void*, size_t, size_t);\n  void  *(*hmget_key_ts)(void*, size_t, void*, size_t, ptrdiff_t*, int);\n  void  *(*hmget_key)(void*, size_t, void*, size_t, int);\n  void  *(*hmput_default)(void*, size_t);\n  void  *(*shmode_func)(size_t, int);\n  void  *(*hmdel_key)(void*, size_t, void*, size_t, size_t, int);\n  char  *(*stralloc)(void*, char*);\n  void  *(*hmput_key)(void*, size_t, void*, size_t, int);\n  void   (*strreset)(void*);\n  void   (*hmfree_func)(void*, size_t);\n  char  *(*strkey)(int);\n  void   (*hm_geti)(int);\n} API;\n\nstatic void *must(void *h, const char *n) {\n  void *p = dlsym(h, n);\n  if (!p) { fprintf(stderr, \"MISSING SYMBOL %s: %s\\n\", n, dlerror()); exit(2); }\n  return p;\n}\nstatic void load(API *a, void *h) {\n  a->arrgrowf      = must(h, \"stbds_arrgrowf\");\n  a->arrfreef      = must(h, \"stbds_arrfreef\");\n  a->rand_seed     = must(h, \"stbds_rand_seed\");\n  a->hash_string   = must(h, \"stbds_hash_string\");\n  a->hash_bytes    = must(h, \"stbds_hash_bytes\");\n  a->hmget_key_ts  = must(h, \"stbds_hmget_key_ts\");\n  a->hmget_key     = must(h, \"stbds_hmget_key\");\n  a->hmput_default = must(h, \"stbds_hmput_default\");\n  a->shmode_func   = must(h, \"stbds_shmode_func\");\n  a->hmdel_key     = must(h, \"stbds_hmdel_key\");\n  a->stralloc      = must(h, \"stbds_stralloc\");\n  a->hmput_key     = must(h, \"stbds_hmput_key\");\n  a->strreset      = must(h, \"stbds_strreset\");\n  a->hmfree_func   = must(h, \"stbds_hmfree_func\");\n  a->strkey        = must(h, \"strkey\");\n  a->hm_geti       = must(h, \"hm_geti\");\n}\n\n/* raw header accessors: t is the \"hash pointer\" (element 1 of the raw array) */\nstatic ptrdiff_t TMP(void *t, size_t es){ return *(ptrdiff_t*)((char*)t - es - HDR + OFF_TMP); }\nstatic size_t    LEN(void *t, size_t es){ return *(size_t*)   ((char*)t - es - HDR + OFF_LEN); }\nstatic size_t    CAP(void *t, size_t es){ return *(size_t*)   ((char*)t - es - HDR + OFF_CAP); }\nstatic void*     HT (void *t, size_t es){ return *(void**)    ((char*)t - es - HDR + OFF_HT ); }\n/* raw array (no hash offset) */\nstatic size_t    RLEN(void *a){ return *(size_t*)((char*)a - HDR + OFF_LEN); }\nstatic size_t    RCAP(void *a){ return *(size_t*)((char*)a - HDR + OFF_CAP); }\nstatic ptrdiff_t RTMP(void *a){ return *(ptrdiff_t*)((char*)a - HDR + OFF_TMP); }\n\n#define STBDS_HM_BINARY 0\n#define STBDS_HM_STRING 1\n#define STBDS_SH_NONE    0\n#define STBDS_SH_DEFAULT 1\n#define STBDS_SH_STRDUP  2\n#define STBDS_SH_ARENA   3\n\ntypedef struct { int key, value; } ipair;\ntypedef struct { char *key; int value; } spair;\n/* larger key to exercise multi-word siphash paths */\ntypedef struct { unsigned char key[13]; int value; } bpair;\n\n/* hash_index layout (for observing table internals) */\ntypedef struct {\n  char *temp_key; size_t slot_count, used_count, uct, ucst, tomb, tct, seed, log2;\n  struct { void *storage; size_t remaining; unsigned char block, mode; } string;\n  void *storage;\n} HIDX;\n\nstatic void dump_table(FILE *o, void *t, size_t es) {\n  HIDX *h = HT(t, es);\n  if (!h) { fprintf(o, \" table=NULL\"); return; }\n  fprintf(o, \" slots=%zu used=%zu uct=%zu ucst=%zu tomb=%zu tct=%zu log2=%zu smode=%u sblock=%u srem=%zu\",\n          h->slot_count, h->used_count, h->uct, h->ucst, h->tomb, h->tct, h->log2,\n          (unsigned)h->string.mode, (unsigned)h->string.block, h->string.remaining);\n}\n\n/* ---------------- hash function tests ---------------- */\nstatic void test_hashes(FILE *o, API *a) {\n  fprintf(o, \"== hash_bytes ==\\n\");\n  static const size_t seeds[] = { 0, 1, 2, 0x31415926u, 0xdeadbeefULL,\n                                  0xffffffffffffffffULL, 0x0123456789abcdefULL };\n  unsigned char buf[64];\n  for (int pat = 0; pat < 6; ++pat) {\n    for (size_t i = 0; i < sizeof buf; ++i) {\n      switch (pat) {\n        case 0: buf[i] = (unsigned char)i; break;                 /* low bytes */\n        case 1: buf[i] = (unsigned char)(0x80 + i); break;         /* high bit set */\n        case 2: buf[i] = 0xff; break;                             /* all ones */\n        case 3: buf[i] = 0x00; break;\n        case 4: buf[i] = (unsigned char)(i * 37 + 11); break;\n        default: buf[i] = (unsigned char)((i & 3) == 3 ? 0xff : 0x01); break;\n      }\n    }\n    for (size_t len = 0; len <= 40; ++len)\n      for (size_t s = 0; s < sizeof seeds / sizeof *seeds; ++s)\n        fprintf(o, \"hb pat=%d len=%zu seed=%zu -> %zu\\n\", pat, len, seeds[s],\n                a->hash_bytes(buf, len, seeds[s]));\n  }\n\n  fprintf(o, \"== hash_string ==\\n\");\n  static char *strs[] = { \"\", \"a\", \"ab\", \"abc\", \"test_0\", \"test_12345\",\n                          \"\\x80\\xff\\x01\", \"The quick brown fox jumps over the lazy dog\",\n                          \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" };\n  for (size_t i = 0; i < sizeof strs / sizeof *strs; ++i)\n    for (size_t s = 0; s < sizeof seeds / sizeof *seeds; ++s)\n      fprintf(o, \"hs [%s] seed=%zu -> %zu\\n\", strs[i], seeds[s],\n              a->hash_string(strs[i], seeds[s]));\n}\n\n/* ---------------- dynamic array tests ---------------- */\nstatic void test_array(FILE *o, API *a) {\n  fprintf(o, \"== arrgrowf ==\\n\");\n  for (size_t es = 1; es <= 24; es += 7) {\n    void *arr = NULL;\n    fprintf(o, \"es=%zu start\\n\", es);\n    for (int step = 0; step < 40; ++step) {\n      size_t addlen = (size_t)(step % 5);\n      size_t mincap = (size_t)(step % 3);\n      void *before = arr;\n      arr = a->arrgrowf(arr, es, addlen, mincap);\n      if (!arr) { fprintf(o, \"  grow(add=%zu min=%zu) -> NULL\\n\", addlen, mincap); continue; }\n      fprintf(o, \"  grow(add=%zu min=%zu) len=%zu cap=%zu tmp=%td ht=%d same=%d\\n\",\n              addlen, mincap, RLEN(arr), RCAP(arr), RTMP(arr),\n              *(void**)((char*)arr - HDR + OFF_HT) != NULL, before == arr);\n      /* emulate arrput: length++ after maybegrow */\n      if (RLEN(arr) + 1 > RCAP(arr)) arr = a->arrgrowf(arr, es, 1, 0);\n      memset((char*)arr + es * RLEN(arr), (int)(step & 0x7f), es);\n      *(size_t*)((char*)arr - HDR + OFF_LEN) = RLEN(arr) + 1;\n    }\n    /* checksum contents */\n    if (!arr) { fprintf(o, \"es=%zu arr never allocated\\n\", es); continue; }\n    unsigned long ck = 0;\n    for (size_t i = 0; i < es * RLEN(arr); ++i) ck = ck * 131 + ((unsigned char*)arr)[i];\n    fprintf(o, \"es=%zu final len=%zu cap=%zu ck=%lu\\n\", es, RLEN(arr), RCAP(arr), ck);\n    a->arrfreef(arr);\n  }\n  /* arrgrowf shrink/no-op path */\n  void *arr = a->arrgrowf(NULL, 8, 0, 100);\n  fprintf(o, \"cap100 -> %zu\\n\", RCAP(arr));\n  void *same = a->arrgrowf(arr, 8, 0, 5);\n  fprintf(o, \"noop same=%d cap=%zu\\n\", same == arr, RCAP(arr));\n  a->arrfreef(arr);\n}\n\n/* ---------------- int->int hash map ---------------- */\nstatic ipair *ihmput(API *a, ipair *t, int k, int v) {\n  int kk = k;\n  t = a->hmput_key(t, sizeof(ipair), &kk, sizeof(int), STBDS_HM_BINARY);\n  t[TMP(t, sizeof(ipair))].key = k;\n  t[TMP(t, sizeof(ipair))].value = v;\n  return t;\n}\nstatic ipair *ihmgeti(API *a, ipair *t, int k, ptrdiff_t *out) {\n  int kk = k;\n  t = a->hmget_key(t, sizeof(ipair), &kk, sizeof(int), STBDS_HM_BINARY);\n  *out = TMP(t, sizeof(ipair));\n  return t;\n}\nstatic ipair *ihmgeti_ts(API *a, ipair *t, int k, ptrdiff_t *out) {\n  int kk = k;\n  t = a->hmget_key_ts(t, sizeof(ipair), &kk, sizeof(int), out, STBDS_HM_BINARY);\n  return t;\n}\nstatic ipair *ihmdel(API *a, ipair *t, int k, ptrdiff_t *out) {\n  int kk = k;\n  t = a->hmdel_key(t, sizeof(ipair), &kk, sizeof(int), 0, STBDS_HM_BINARY);\n  *out = t ? TMP(t, sizeof(ipair)) : 0;\n  return t;\n}\n\nstatic void dump_imap(FILE *o, ipair *t) {\n  size_t es = sizeof(ipair);\n  if (!t) { fprintf(o, \"  map=NULL\\n\"); return; }\n  fprintf(o, \"  len=%zu cap=%zu tmp=%td default=%d\", LEN(t, es), CAP(t, es), TMP(t, es), t[-1].value);\n  dump_table(o, t, es);\n  fprintf(o, \"\\n  elems:\");\n  for (size_t i = 0; i + 1 < LEN(t, es); ++i) fprintf(o, \" (%d,%d)\", t[i].key, t[i].value);\n  fprintf(o, \"\\n\");\n}\n\nstatic void test_imap(FILE *o, API *a, size_t seed, int n) {\n  fprintf(o, \"== imap seed=%zu n=%d ==\\n\", seed, n);\n  a->rand_seed(seed);\n  ipair *t = NULL;\n  ptrdiff_t tmp;\n\n  t = ihmgeti(a, t, 7, &tmp); fprintf(o, \"geti(7)=%td\\n\", tmp);\n  t = a->hmput_default(t, sizeof(ipair)); t[-1].value = -99;\n  t = ihmgeti(a, t, 7, &tmp); fprintf(o, \"geti(7)=%td\\n\", tmp);\n  dump_imap(o, t);\n\n  for (int i = 0; i < n; ++i) {\n    t = ihmput(a, t, i * 3 - 5, i * 7);\n    if (i % 17 == 0) { fprintf(o, \"after put %d:\\n\", i); dump_imap(o, t); }\n  }\n  dump_imap(o, t);\n  for (int i = -20; i < n * 3; ++i) {\n    t = ihmgeti(a, t, i, &tmp);\n    ptrdiff_t t2;\n    t = ihmgeti_ts(a, t, i, &t2);\n    fprintf(o, \"g(%d)=%td/%td v=%d\\n\", i, tmp, t2, t[tmp].value);\n  }\n  /* overwrite */\n  for (int i = 0; i < n; i += 2) t = ihmput(a, t, i * 3 - 5, i * 11);\n  dump_imap(o, t);\n  /* deletes: forces tombstones, rebuild and shrink paths */\n  for (int i = 0; i < n; i += 3) { t = ihmdel(a, t, i * 3 - 5, &tmp); fprintf(o, \"del(%d)=%td len=%zu\\n\", i*3-5, tmp, t?LEN(t,sizeof(ipair)):0); }\n  dump_imap(o, t);\n  for (int i = 0; i < n * 3; ++i) { t = ihmgeti(a, t, i, &tmp); fprintf(o, \"g2(%d)=%td v=%d\\n\", i, tmp, t[tmp].value); }\n  /* delete everything */\n  for (int i = 0; i < n; ++i) { t = ihmdel(a, t, i * 3 - 5, &tmp); }\n  dump_imap(o, t);\n  /* re-add after full delete */\n  for (int i = 0; i < n; ++i) t = ihmput(a, t, i, i * 2);\n  dump_imap(o, t);\n  a->hmfree_func((char*)t - sizeof(ipair), sizeof(ipair));\n  t = NULL;\n  /* put into freed/NULL map */\n  t = ihmput(a, t, 1, 2);\n  dump_imap(o, t);\n  a->hmfree_func((char*)t - sizeof(ipair), sizeof(ipair));\n  a->hmfree_func(NULL, sizeof(ipair));\n  fprintf(o, \"imap done\\n\");\n}\n\n/* ---------------- binary (13-byte) key map: exercises siphash tail cases ---- */\nstatic void bkey(unsigned char *k, int i) {\n  for (int j = 0; j < 13; ++j) k[j] = (unsigned char)(i * 17 + j * 91);\n}\nstatic void test_bmap(FILE *o, API *a, size_t seed, int n) {\n  fprintf(o, \"== bmap seed=%zu n=%d ==\\n\", seed, n);\n  a->rand_seed(seed);\n  bpair *t = NULL;\n  size_t es = sizeof(bpair), ks = sizeof(((bpair*)0)->key);\n  for (int i = 0; i < n; ++i) {\n    unsigned char k[13];\n    bkey(k, i);\n    t = a->hmput_key(t, es, k, ks, STBDS_HM_BINARY);\n    ptrdiff_t x = TMP(t, es);\n    memcpy(t[x].key, k, 13);\n    t[x].value = i;\n  }\n  fprintf(o, \"  len=%zu cap=%zu\", LEN(t, es), CAP(t, es));\n  dump_table(o, t, es);\n  fprintf(o, \"\\n\");\n  for (int i = 0; i < n + 10; ++i) {\n    unsigned char k[13];\n    bkey(k, i);\n    t = a->hmget_key(t, es, k, ks, STBDS_HM_BINARY);\n    ptrdiff_t x = TMP(t, es);\n    fprintf(o, \"bg(%d)=%td v=%d\\n\", i, x, t[x].value);\n  }\n  for (int i = 0; i < n; i += 2) {\n    unsigned char k[13];\n    bkey(k, i);\n    t = a->hmdel_key(t, es, k, ks, 0, STBDS_HM_BINARY);\n    fprintf(o, \"bdel(%d)=%td len=%zu\\n\", i, t ? TMP(t, es) : 0, t ? LEN(t, es) : 0);\n  }\n  /* NOTE: checksum only the *defined* fields.  bpair has 3 bytes of padding\n     after key[13] which realloc leaves uninitialised, so a raw-byte checksum\n     would read indeterminate values. */\n  unsigned long ck = 0;\n  for (size_t e = 0; e + 1 < LEN(t, es); ++e) {\n    for (int j = 0; j < 13; ++j) ck = ck * 131 + t[e].key[j];\n    ck = ck * 1000003u + (unsigned)t[e].value;\n  }\n  fprintf(o, \"  bmap ck=%lu len=%zu\", ck, LEN(t, es));\n  dump_table(o, t, es);\n  fprintf(o, \"\\n\");\n  a->hmfree_func((char*)t - es, es);\n  fprintf(o, \"bmap done\\n\");\n}\n\n/* ---------------- string map ---------------- */\nstatic void dump_smap(FILE *o, spair *t) {\n  size_t es = sizeof(spair);\n  if (!t) { fprintf(o, \"  smap=NULL\\n\"); return; }\n  fprintf(o, \"  len=%zu cap=%zu tmp=%td\", LEN(t, es), CAP(t, es), TMP(t, es));\n  dump_table(o, t, es);\n  fprintf(o, \"\\n  elems:\");\n  for (size_t i = 0; i + 1 < LEN(t, es); ++i)\n    fprintf(o, \" (%s,%d)\", t[i].key ? t[i].key : \"(null)\", t[i].value);\n  fprintf(o, \"\\n\");\n}\n\nstatic void test_smap(FILE *o, API *a, size_t seed, int mode, int n) {\n  fprintf(o, \"== smap seed=%zu mode=%d n=%d ==\\n\", seed, mode, n);\n  a->rand_seed(seed);\n  size_t es = sizeof(spair);\n  spair *t = NULL;\n  if (mode == STBDS_SH_STRDUP || mode == STBDS_SH_ARENA)\n    t = a->shmode_func(es, mode);\n  ptrdiff_t tmp;\n  char **keys = calloc(n, sizeof(char*));\n  for (int i = 0; i < n; ++i) {\n    char b[64];\n    snprintf(b, sizeof b, \"key_%d_%s\", i, (i & 1) ? \"odd\" : \"even\");\n    keys[i] = strdup(b);\n    t = a->hmput_key(t, es, keys[i], sizeof(char*), STBDS_HM_STRING);\n    t[TMP(t, es)].value = i * 5;\n    if (i % 23 == 0) { fprintf(o, \"after sput %d:\\n\", i); dump_smap(o, t); }\n  }\n  dump_smap(o, t);\n  for (int i = 0; i < n + 5; ++i) {\n    char b[64];\n    snprintf(b, sizeof b, \"key_%d_%s\", i, (i & 1) ? \"odd\" : \"even\");\n    t = a->hmget_key(t, es, b, sizeof(char*), STBDS_HM_STRING);\n    tmp = TMP(t, es);\n    fprintf(o, \"sg(%s)=%td v=%d\\n\", b, tmp, t[tmp].value);\n  }\n  /* overwrite existing keys (exercises temp_key path) */\n  for (int i = 0; i < n; i += 2) {\n    char b[64];\n    snprintf(b, sizeof b, \"key_%d_%s\", i, (i & 1) ? \"odd\" : \"even\");\n    t = a->hmput_key(t, es, b, sizeof(char*), STBDS_HM_STRING);\n    t[TMP(t, es)].value = -i;\n  }\n  dump_smap(o, t);\n  for (int i = 0; i < n; i += 3) {\n    char b[64];\n    snprintf(b, sizeof b, \"key_%d_%s\", i, (i & 1) ? \"odd\" : \"even\");\n    t = a->hmdel_key(t, es, b, sizeof(char*), 0, STBDS_HM_STRING);\n    fprintf(o, \"sdel(%s)=%td\\n\", b, t ? TMP(t, es) : 0);\n  }\n  dump_smap(o, t);\n  a->hmfree_func((char*)t - es, es);\n  for (int i = 0; i < n; ++i) free(keys[i]);\n  free(keys);\n  fprintf(o, \"smap done\\n\");\n}\n\n/* ---------------- string arena ---------------- */\nstatic void test_arena(FILE *o, API *a) {\n  fprintf(o, \"== arena ==\\n\");\n  unsigned char arena[24];\n  memset(arena, 0, sizeof arena);\n  struct SA { void *storage; size_t remaining; unsigned char block, mode; };\n  struct SA *sa = (struct SA*)arena;\n  char big[4096];\n  char *prev = NULL;\n  for (int i = 0; i < 300; ++i) {\n    char b[4200];\n    size_t l;\n    if (i % 37 == 36) { l = (size_t)(600 + i * 7); if (l > 4000) l = 4000; }\n    else l = (size_t)(3 + (i * 13) % 60);\n    for (size_t j = 0; j < l; ++j) b[j] = (char)('a' + ((i + j) % 26));\n    b[l] = 0;\n    char *p = a->stralloc(sa, b);\n    fprintf(o, \"sa %d len=%zu eq=%d rem=%zu block=%u delta=%td newblk=%d\\n\",\n            i, l, strcmp(p, b) == 0, sa->remaining, (unsigned)sa->block,\n            prev ? (ptrdiff_t)(p - prev) : (ptrdiff_t)0,\n            prev == NULL);\n    prev = p;\n  }\n  (void)big;\n  a->strreset(sa);\n  fprintf(o, \"after reset storage=%d rem=%zu block=%u mode=%u\\n\",\n          sa->storage != NULL, sa->remaining, (unsigned)sa->block, (unsigned)sa->mode);\n  /* reset an all-zero arena */\n  memset(arena, 0, sizeof arena);\n  a->strreset(sa);\n  fprintf(o, \"reset empty ok\\n\");\n}\n\n/* ---------------- strkey / hm_geti ---------------- */\nstatic void test_misc(FILE *o, API *a) {\n  fprintf(o, \"== strkey ==\\n\");\n  int ns[] = { 0, 1, -1, 9, 10, 99, 100, 12345, -12345, 2147483647, -2147483647 - 1 };\n  for (size_t i = 0; i < sizeof ns / sizeof *ns; ++i) {\n    char *s = a->strkey(ns[i]);\n    fprintf(o, \"strkey(%d)=[%s] len=%zu\\n\", ns[i], s, strlen(s));\n  }\n  fprintf(o, \"== hm_geti ==\\n\");\n  int nums[] = { 0, 1, 2, 3, 4, 5, 8, 15, 16, 17, 31, 32, 33, 64, 100, 127, 128, 200, 500, 1000, 2000 };\n  for (size_t i = 0; i < sizeof nums / sizeof *nums; ++i) {\n    a->rand_seed(0x31415926u + nums[i]);\n    a->hm_geti(nums[i]);\n    fprintf(o, \"hm_geti(%d) ok\\n\", nums[i]);\n  }\n  /* also with the evolving default seed */\n  for (int r = 0; r < 5; ++r) { a->hm_geti(50 + r * 13); fprintf(o, \"hm_geti chain %d ok\\n\", r); }\n}\n\n/* ---------------- edge cases from the uncovered branches ---------------- */\nstatic void test_edges(FILE *o, API *a) {\n  fprintf(o, \"== edges ==\\n\");\n  a->rand_seed(4242);\n  size_t es = sizeof(ipair);\n\n  /* hmput_default on a NULL map (allocates the default slot) */\n  ipair *t = a->hmput_default(NULL, es);\n  t[-1].value = -777;\n  fprintf(o, \"default-on-null: len=%zu cap=%zu tmp=%td def=%d ht=%d\\n\",\n          LEN(t, es), CAP(t, es), TMP(t, es), t[-1].value, HT(t, es) != NULL);\n  /* hmdel on a map that has no hash table yet -> returns a unchanged */\n  ptrdiff_t tmp;\n  ipair *before = t;\n  t = ihmdel(a, t, 5, &tmp);\n  fprintf(o, \"del-no-table: same=%d ret=%td tmp=%td len=%zu\\n\",\n          before == t, tmp, TMP(t, es), LEN(t, es));\n  /* hmget_key on a map with no table */\n  t = ihmgeti(a, t, 5, &tmp);\n  fprintf(o, \"get-no-table: %td\\n\", tmp);\n  ptrdiff_t t2 = 12345;\n  t = ihmgeti_ts(a, t, 5, &t2);\n  fprintf(o, \"get_ts-no-table: %td\\n\", t2);\n  a->hmfree_func((char*)t - es, es);\n\n  /* hmdel_key on NULL */\n  void *r = a->hmdel_key(NULL, es, &(int){3}, sizeof(int), 0, STBDS_HM_BINARY);\n  fprintf(o, \"del-null -> %d\\n\", r == NULL);\n\n  /* hmget_key_ts on NULL creates the array; then hmput_default sees length!=0 */\n  ptrdiff_t tt = 999;\n  ipair *m = a->hmget_key_ts(NULL, es, &(int){1}, sizeof(int), &tt, STBDS_HM_BINARY);\n  fprintf(o, \"get_ts-null: tmp=%td len=%zu cap=%zu ht=%d\\n\", tt, LEN(m, es), CAP(m, es), HT(m, es) != NULL);\n  ipair *m2 = a->hmput_default(m, es);\n  fprintf(o, \"default-on-existing: same=%d len=%zu\\n\", m == m2, LEN(m2, es));\n  a->hmfree_func((char*)m2 - es, es);\n\n  /* shmode_func for every mode value */\n  for (int mode = 0; mode <= 3; ++mode) {\n    void *s = a->shmode_func(sizeof(spair), mode);\n    fprintf(o, \"shmode(%d): len=%zu cap=%zu\", mode, LEN(s, sizeof(spair)), CAP(s, sizeof(spair)));\n    dump_table(o, s, sizeof(spair));\n    fprintf(o, \"\\n\");\n    a->hmfree_func((char*)s - sizeof(spair), sizeof(spair));\n  }\n}\n\n/* stralloc: strings longer than the current block size take the \"big\" path */\nstatic void test_arena_big(FILE *o, API *a) {\n  fprintf(o, \"== arena big ==\\n\");\n  unsigned char arena[24];\n  struct SA { void *storage; size_t remaining; unsigned char block, mode; };\n  struct SA *sa = (struct SA*)arena;\n  static char big[8192];\n\n  memset(arena, 0, sizeof arena);\n  /* first alloc is huge and the arena is empty -> storage==NULL branch */\n  for (int round = 0; round < 6; ++round) {\n    size_t l = (size_t)(5000 - round * 700);\n    for (size_t j = 0; j < l; ++j) big[j] = (char)('A' + ((round + j) % 26));\n    big[l] = 0;\n    char *p = a->stralloc(sa, big);\n    fprintf(o, \"big %d len=%zu eq=%d rem=%zu block=%u\\n\",\n            round, l, strcmp(p, big) == 0, sa->remaining, (unsigned)sa->block);\n    /* small alloc in between to populate storage */\n    char s[32];\n    snprintf(s, sizeof s, \"small%d\", round);\n    char *q = a->stralloc(sa, s);\n    fprintf(o, \"  small %d eq=%d rem=%zu block=%u\\n\", round, strcmp(q, s) == 0,\n            sa->remaining, (unsigned)sa->block);\n  }\n  a->strreset(sa);\n  fprintf(o, \"big reset storage=%d rem=%zu block=%u\\n\", sa->storage != NULL, sa->remaining, (unsigned)sa->block);\n\n  /* push block size all the way to the 1MB cap */\n  memset(arena, 0, sizeof arena);\n  for (int i = 0; i < 4000; ++i) {\n    size_t l = 400;\n    for (size_t j = 0; j < l; ++j) big[j] = (char)('a' + ((i + j) % 26));\n    big[l] = 0;\n    char *p = a->stralloc(sa, big);\n    if (p == NULL || strcmp(p, big) != 0) { fprintf(o, \"MISMATCH at %d\\n\", i); break; }\n    if (i % 250 == 0) fprintf(o, \"cap-walk %d rem=%zu block=%u\\n\", i, sa->remaining, (unsigned)sa->block);\n  }\n  fprintf(o, \"cap-walk final rem=%zu block=%u\\n\", sa->remaining, (unsigned)sa->block);\n  a->strreset(sa);\n}\n\n/* deterministic insert/delete churn: hits tombstone reuse in both probe loops,\n   plus the rebuild and shrink paths */\nstatic unsigned long lcg_state;\nstatic unsigned lcg(void) { lcg_state = lcg_state * 6364136223846793005ULL + 1442695040888963407ULL; return (unsigned)(lcg_state >> 33); }\n\nstatic void test_churn(FILE *o, API *a, size_t seed, int ops, int space) {\n  fprintf(o, \"== churn seed=%zu ops=%d space=%d ==\\n\", seed, ops, space);\n  a->rand_seed(seed);\n  lcg_state = seed ^ 0x9e3779b97f4a7c15ULL;\n  size_t es = sizeof(ipair);\n  ipair *t = NULL;\n  ptrdiff_t tmp;\n  t = a->hmput_default(NULL, es);\n  t[-1].value = -1;\n  for (int i = 0; i < ops; ++i) {\n    unsigned r = lcg();\n    int k = (int)(r % (unsigned)space);\n    if ((r >> 20) % 3 == 0) {\n      t = ihmdel(a, t, k, &tmp);\n      if (i % 64 == 0) fprintf(o, \"  d%d k=%d r=%td len=%zu\", i, k, tmp, LEN(t, es)), dump_table(o, t, es), fprintf(o, \"\\n\");\n    } else {\n      t = ihmput(a, t, k, k * 3 + i);\n      if (i % 64 == 0) fprintf(o, \"  p%d k=%d len=%zu\", i, k, LEN(t, es)), dump_table(o, t, es), fprintf(o, \"\\n\");\n    }\n  }\n  /* full verification sweep */\n  unsigned long ck = 0;\n  for (int k = 0; k < space; ++k) {\n    t = ihmgeti(a, t, k, &tmp);\n    ck = ck * 1000003u + (unsigned long)(tmp + 3) * 31 + (unsigned)t[tmp].value;\n  }\n  fprintf(o, \"churn ck=%lu len=%zu\", ck, LEN(t, es));\n  dump_table(o, t, es);\n  fprintf(o, \"\\n  elems:\");\n  for (size_t i = 0; i + 1 < LEN(t, es); ++i) fprintf(o, \" (%d,%d)\", t[i].key, t[i].value);\n  fprintf(o, \"\\n\");\n  a->hmfree_func((char*)t - es, es);\n}\n\n/* string-key churn for STRDUP / ARENA / DEFAULT modes */\nstatic void test_schurn(FILE *o, API *a, size_t seed, int mode, int ops, int space) {\n  fprintf(o, \"== schurn seed=%zu mode=%d ops=%d space=%d ==\\n\", seed, mode, ops, space);\n  a->rand_seed(seed);\n  lcg_state = seed * 3 + 7;\n  size_t es = sizeof(spair);\n  spair *t = NULL;\n  if (mode == STBDS_SH_STRDUP || mode == STBDS_SH_ARENA) t = a->shmode_func(es, mode);\n  /* stable key storage for DEFAULT mode (which stores the caller's pointer) */\n  char **kb = calloc(space, sizeof(char*));\n  for (int i = 0; i < space; ++i) { char b[64]; snprintf(b, sizeof b, \"k%d-%d\", i, i * 7); kb[i] = strdup(b); }\n  for (int i = 0; i < ops; ++i) {\n    unsigned r = lcg();\n    int k = (int)(r % (unsigned)space);\n    if ((r >> 20) % 3 == 0) {\n      t = a->hmdel_key(t, es, kb[k], sizeof(char*), 0, STBDS_HM_STRING);\n      if (i % 97 == 0) fprintf(o, \"  sd%d k=%d r=%td len=%zu\\n\", i, k, t ? TMP(t, es) : 0, t ? LEN(t, es) : 0);\n    } else {\n      t = a->hmput_key(t, es, kb[k], sizeof(char*), STBDS_HM_STRING);\n      t[TMP(t, es)].value = k * 5 + i;\n      if (i % 97 == 0) fprintf(o, \"  sp%d k=%d len=%zu\\n\", i, k, LEN(t, es));\n    }\n  }\n  unsigned long ck = 0;\n  for (int k = 0; k < space; ++k) {\n    t = a->hmget_key(t, es, kb[k], sizeof(char*), STBDS_HM_STRING);\n    ptrdiff_t x = TMP(t, es);\n    ck = ck * 1000003u + (unsigned long)(x + 3) * 31 + (unsigned)t[x].value;\n  }\n  fprintf(o, \"schurn ck=%lu len=%zu\", ck, LEN(t, es));\n  dump_table(o, t, es);\n  fprintf(o, \"\\n  elems:\");\n  for (size_t i = 0; i + 1 < LEN(t, es); ++i) fprintf(o, \" (%s,%d)\", t[i].key, t[i].value);\n  fprintf(o, \"\\n\");\n  a->hmfree_func((char*)t - es, es);\n  for (int i = 0; i < space; ++i) free(kb[i]);\n  free(kb);\n}\n\nstatic void run(FILE *o, API *a) {\n  test_hashes(o, a);\n  test_array(o, a);\n  for (int n = 0; n <= 3; ++n) test_imap(o, a, 0x31415926u, n);\n  test_imap(o, a, 0, 40);\n  test_imap(o, a, 1, 200);\n  test_imap(o, a, 0xdeadbeefULL, 700);\n  test_bmap(o, a, 5, 1);\n  test_bmap(o, a, 5, 200);\n  test_bmap(o, a, 0x99887766ULL, 900);\n  test_smap(o, a, 7, STBDS_SH_NONE, 0);\n  test_smap(o, a, 7, STBDS_SH_NONE, 120);\n  test_smap(o, a, 8, STBDS_SH_STRDUP, 120);\n  test_smap(o, a, 9, STBDS_SH_ARENA, 300);\n  test_arena(o, a);\n  test_edges(o, a);\n  test_arena_big(o, a);\n  test_churn(o, a, 11, 3000, 40);\n  test_churn(o, a, 12, 20000, 300);\n  test_churn(o, a, 13, 40000, 1500);\n  test_schurn(o, a, 21, STBDS_SH_NONE, 4000, 120);\n  test_schurn(o, a, 22, STBDS_SH_STRDUP, 8000, 250);\n  test_schurn(o, a, 23, STBDS_SH_ARENA, 8000, 250);\n  test_misc(o, a);\n  /* seed evolution across a long chain, observed via table seeds */\n  fprintf(o, \"== seed chain ==\\n\");\n  a->rand_seed(12345);\n  for (int i = 0; i < 30; ++i) {\n    void *t = a->shmode_func(sizeof(spair), STBDS_SH_ARENA);\n    HIDX *h = HT(t, sizeof(spair));\n    fprintf(o, \"chain %d seed=%zu\\n\", i, h->seed);\n    a->hmfree_func((char*)t - sizeof(spair), sizeof(spair));\n  }\n}\n\nint main(int argc, char **argv) {\n  if (argc != 3) { fprintf(stderr, \"usage: %s lib.so out.txt\\n\", argv[0]); return 2; }\n  void *h = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n  if (!h) { fprintf(stderr, \"dlopen: %s\\n\", dlerror()); return 2; }\n  API a; load(&a, h);\n  FILE *o = fopen(argv[2], \"w\");\n  if (!o) { perror(\"fopen\"); return 2; }\n  setvbuf(o, NULL, _IONBF, 0);\n  run(o, &a);\n  fclose(o);\n  return 0;\n}\n","structuredPatch":[{"oldStart":477,"oldLines":7,"newStart":477,"newLines":7,"lines":[" ","   /* push block size all the way to the 1MB cap */","   memset(arena, 0, sizeof arena);","-  for (int i = 0; i < 4000; ++i) {","+  for (int i = 0; i < 12000; ++i) {","     size_t l = 400;","     for (size_t j = 0; j < l; ++j) big[j] = (char)('a' + ((i + j) % 26));","     big[l] = 0;"]}],"userModified":false,"replaceAll":false}}
