Mulvs); P(VS, c2Div);\n\tP(XV, c2Mulxv); P(SUP, c2Support);\n\ttypedef float (*LEN)(c2v); P(LEN, c2Len);\n\ttypedef c2v (*MK)(float, float); P(MK, c2V);\n#undef P\n\n\tfor (long it = 0; it < iters; ++it) {\n\t\tc2v p = rv(), q = rv(), r = rv();\n\t\tfloat f = rbits();\n\t\tc2r rot; rot.c = rbits(); rot.s = rbits();\n\t\tc2x x; x.p = rv(); x.r = rot;\n\n#define CK1(nm, call) do { curfn = nm; __typeof__(call) A = call##_SUBC, B = call##_SUBR; cmp(&A,&B,sizeof A); } while (0)\n\t\tcurfn = \"c2V\";       { c2v A = c2V_c(f, p.x), B = c2V_r(f, p.x); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Add\";     { c2v A = c2Add_c(p,q), B = c2Add_r(p,q); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Sub\";     { c2v A = c2Sub_c(p,q), B = c2Sub_r(p,q); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Maxv\";    { c2v A = c2Maxv_c(p,q), B = c2Maxv_r(p,q); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Minv\";    { c2v A = c2Minv_c(p,q), B = c2Minv_r(p,q); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Clampv\";  { c2v A = c2Clampv_c(p,q,r), B = c2Clampv_r(p,q,r); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Neg\";     { c2v A = c2Neg_c(p), B = c2Neg_r(p); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Skew\";    { c2v A = c2Skew_c(p), B = c2Skew_r(p); cmp(&A,&B,8); }\n\t\tcurfn = \"c2CCW90\";   { c2v A = c2CCW90_c(p), B = c2CCW90_r(p); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Norm\";    { c2v A = c2Norm_c(p), B = c2Norm_r(p); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Mulvs\";   { c2v A = c2Mulvs_c(p,f), B = c2Mulvs_r(p,f); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Div\";     { c2v A = c2Div_c(p,f), B = c2Div_r(p,f); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Mulrv\";   { c2v A = c2Mulrv_c(rot,p), B = c2Mulrv_r(rot,p); cmp(&A,&B,8); }\n\t\tcurfn = \"c2MulrvT\";  { c2v A = c2MulrvT_c(rot,p), B = c2MulrvT_r(rot,p); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Mulxv\";   { c2v A = c2Mulxv_c(x,p), B = c2Mulxv_r(x,p); cmp(&A,&B,8); }\n\t\tcurfn = \"c2Dot\";     { float A = c2Dot_c(p,q), B = c2Dot_r(p,q); cmp(&A,&B,4); }\n\t\tcurfn = \"c2Det2\";    { float A = c2Det2_c(p,q), B = c2Det2_r(p,q); cmp(&A,&B,4); }\n\t\tcurfn = \"c2Len