 = rbits();\n\t\t\tconst c2x *axp = (r32()%3==0)?NULL:&ax, *bxp = (r32()%3==0)?NULL:&bx;\n\t\t\tint ur = (int)(r32()%2), hc2 = (int)(r32()%2);\n\t\t\tint nA = (tA==0)?1:(tA==1?4:2), nB = (tB==0)?1:(tB==1?4:2);\n\t\t\tc2GJKCache k0; memset(&k0,0,sizeof k0);\n\t\t\tif (hc2) { k0.metric = rbits(); k0.count = (int)(r32()%4); k0.div = rbits();\n\t\t\t           for (int i=0;i<3;++i){ k0.iA[i]=(int)(r32()%(unsigned)nA); k0.iB[i]=(int)(r32()%(unsigned)nB);} }\n\t\t\tc2GJKCache k1=k0,k2=k0;\n\t\t\tc2v o1,p1,o2,p2; int i1=-7,i2=-7;\n\t\t\tmemset(&o1,0x3c,8);memset(&p1,0x3c,8);memset(&o2,0x3c,8);memset(&p2,0x3c,8);\n\t\t\tcurfn = \"c2GJK\";\n\t\t\tfloat d1 = c2GJK_c(&SA,tA,axp,&SB,tB,bxp,&o1,&p1,ur,&i1,hc2?&k1:NULL);\n\t\t\tfloat d2 = c2GJK_r(&SA,tA,axp,&SB,tB,bxp,&o2,&p2,ur,&i2,hc2?&k2:NULL);\n\t\t\tcmp(&d1,&d2,4); cmp(&o1,&o2,8); cmp(&p1,&p2,8); cmp(&i1,&i2,4);\n\t\t\tcmp(&k1,&k2,sizeof k1);\n\t\t}\n\n\t\t// gjk(): the declared public entry point, arbitrary bits\n\t\t{\n\t\t\tcurfn = \"gjk\";\n\t\t\tfloat A[9]; for (int i=0;i<9;++i) A[i]=rbits();\n\t\t\tchar rev = (char)r32();\n\t\t\tc2v a1,b1,a2,b2;\n\t\t\tmemset(&a1,0x11,8);memset(&b1,0x11,8);memset(&a2,0x11,8);memset(&b2,0x11,8);\n\t\t\tgjk_c(rev,&a1,&b1,A[0],A[1],A[2],A[3],A[4],A[5],A[6],A[7],A[8]);\n\t\t\tgjk_r(rev,&a2,&b2,A[0],A[1],A[2],A[3],A[4],A[5],A[6],A[7],A[8]);\n\t\t\tcmp(&a1,&a2,8); cmp(&b1,&b2,8);\n\t\t}\n\t}\n\tprintf(\"iters=%ld  checks=%ld  failures=%ld\\n\", iters, checks, fails);\n\treturn fails ? 1 : 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
