\tif (memcmp(&fa, &fb, 4)) printf(\"  DIFF c2Det2 (%s,%s)(%s,%s) C=%08x RS=%08x\\n\", nm[i],nm[j],nm[k],nm[l], bits(fa), bits(fb));\n\t}\n\tfor (int i = 0; i < n; ++i) for (int j = 0; j < n; ++j) {\n\t\tc2v p = { cand[i], cand[j] };\n\t\tc2v a = norm_c(p), b = norm_r(p);\n\t\tif (memcmp(&a, &b, 8)) printf(\"  DIFF c2Norm (%s,%s) C=(%08x,%08x) RS=(%08x,%08x)\\n\", nm[i],nm[j], bits(a.x),bits(a.y),bits(b.x),bits(b.y));\n\t}\n\n\t// exhaustive-ish gjk() search over the candidate set, 9 float args\n\tprintf(\"--- gjk() minimal diffs (one NaN at a time) ---\\n\");\n\tint shown = 0;\n\tfloat base[9] = { 0.0f, 0.0f, 1.0f, 1.0f, 2.0f, 2.0f, 3.0f, 3.0f, 0.5f };\n\tfor (int slot = 0; slot < 9 && shown < 40; ++slot) {\n\t\tfor (int ci = 0; ci < n && shown < 40; ++ci) {\n\t\t\tfor (int rev = 0; rev < 2; ++rev) {\n\t\t\t\tfloat f[9]; memcpy(f, base, sizeof f);\n\t\t\t\tf[slot] = cand[ci];\n\t\t\t\tc2v p1, q1, p2, q2;\n\t\t\t\tmemset(&p1, 0x77, 8); memset(&q1, 0x77, 8);\n\t\t\t\tmemset(&p2, 0x77, 8); memset(&q2, 0x77, 8);\n\t\t\t\tgc((char)rev, &p1, &q1, f[0],f[1],f[2],f[3],f[4],f[5],f[6],f[7],f[8]);\n\t\t\t\tgr((char)rev, &p2, &q2, f[0],f[1],f[2],f[3],f[4],f[5],f[6],f[7],f[8]);\n\t\t\t\tif (memcmp(&p1,&p2,8) || memcmp(&q1,&q2,8)) {\n\t\t\t\t\tprintf(\"  slot=%d val=%-5s rev=%d  C a=(%08x,%08x) b=(%08x,%08x) | RS a=(%08x,%08x) b=(%08x,%08x)\\n\",\n\t\t\t\t\t\tslot, nm[ci], rev,\n\t\t\t\t\t\tbits(p1.x),bits(p1.y),bits(q1.x),bits(q1.y),\n\t\t\t\t\t\tbits(p2.x),bits(p2.y),bits(q2.x),bits(q2.y));\n\t\t\t\t\tshown++;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif (!shown) printf(\"  (no single-NaN-slot diffs found)\\n\");\n\treturn 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
