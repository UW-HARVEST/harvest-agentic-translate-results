\n\n/// ```c\n/// typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;\n/// ```\n///\n/// The four `c2sv` members `a`, `b`, `c`, `d` are modelled as a single array\n/// so that the C idiom `c2sv* verts = &s->a; verts[i]` can be reproduced\n/// verbatim.  The memory layout is identical to the C struct.\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\npub struct c2Simplex {\n    /// `a`, `b`, `c`, `d`\n    pub verts: [c2sv; 4],\n    pub div: f32,\n    pub count: c_int,\n}\n\n// Compile-time layout assertions guaranteeing ABI equality with the C structs.\nconst _: () = {\n    assert!(core::mem::size_of::<c2v>() == 8);\n    assert!(core::mem::align_of::<c2v>() == 4);\n    assert!(core::mem::size_of::<c2r>() == 8);\n    assert!(core::mem::size_of::<c2x>() == 16);\n    assert!(core::mem::size_of::<c2Circle>() == 12);\n    assert!(core::mem::size_of::<c2AABB>() == 16);\n    assert!(core::mem::size_of::<c2Capsule>() == 20);\n    assert!(core::mem::size_of::<c2GJKCache>() == 36);\n    assert!(core::mem::size_of::<c2Proxy>() == 72);\n    assert!(core::mem::size_of::<c2sv>() == 36);\n    assert!(core::mem::size_of::<c2Simplex>() == 152);\n};\n\nimpl c2Simplex {\n    #[inline]\n    const fn zeroed() -> c2Simplex {\n        const Z: c2v = c2v { x: 0.0, y: 0.0 };\n        const ZSV: c2sv = c2sv {\n            sA: Z,\n            sB: Z,\n            p: Z,\n            u: 0.0,\n            iA: 0,\n            iB: 0,\n        };\n        c2Simplex {\n            verts: [ZSV; 4],\n            div: 0.0,\n            count: 0,\n        }\n    }\n}\n\nimpl c2Proxy {\n    #[inline]\n    const fn zeroed() -> c2Proxy {\n        c2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [c2v { x: 0.0, y: 0.0 }; 8],\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Vector / rotation helpers\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// c2v c2V(float x, float y)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a = c2v { x: 0.0, y: 0.0 };\n    a.x = x;\n    a.y = y;\n    a\n}\n\n/// ```c\n/// c2v c2Mulvs(c2v a, float b)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n    let mut a = a;\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n/// ```c\n/// c2v c2Maxv(c2v a, c2v b)\n/// ```\n///\n/// Uses the literal ternary comparison from the C macro (NOT `f32::max`,\n/// whose NaN behaviour differs).\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n/// ```c\n/// c2v c2Minv(c2v a, c2v b)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n/// ```c\n/// c2v c2Clampv(c2v a, c2v lo, c2v hi)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n/// ```c\n/// c2v c2Sub(c2v a, c2v b)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n/// ```c\n/// float c2Dot(c2v a, c2v b)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n/// ```c\n/// c2r c2RotIdentity(void)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    let mut r = c2r { c: 0.0, s: 0.0 };\n    r.c = 1.0f32;\n    r.s = 0.0;\n    r\n}\n\n/// ```c\n/// c2x c2xIdentity(void)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    let mut x = c2x {\n        p: c2v { x: 0.0, y: 0.0 },\n        r: c2r { c: 0.0, s: 0.0 },\n    };\n    x.p = c2V(0.0, 0.0);\n    x.r = c2RotIdentity();\n    x\n}\n\n/// ```c\n/// c2v c2Mulrv(c2r a, c2v b)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n}\n\n/// ```c\n/// c2v c2Add(c2v a, c2v b)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n/// ```c\n/// c2v c2Mulxv(c2x a, c2v b)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n/// ```c\n/// c2v c2Neg(c2v a)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    c2V(-a.x, -a.y)\n}\n\n/// ```c\n/// c2v c2Skew(c2v a)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = -a.y;\n    b.y = a.x;\n    b\n}\n\n/// ```c\n/// c2v c2CCW90(c2v a)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = a.y;\n    b.y = -a.x;\n    b\n}\n\n/// ```c\n/// c2v c2Div(c2v a, float b)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n/// ```c\n/// c2v c2Norm(c2v a)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n/// ```c\n/// c2v c2MulrvT(c2r a, c2v b)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n}\n\n/// ```c\n/// float c2Len(c2v a)\n/// ```\n///\n/// `sqrtf` from libm; maps to the identical IEEE-754 single precision\n/// square root.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    sqrtf(c2Dot(a, a))\n}\n\n/// ```c\n/// float c2Det2(c2v a, c2v b)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    a.x * b.y - a.y * b.x\n}\n\n#[inline(always)]\nfn sqrtf(v: f32) -> f32 {\n    // Correctly-rounded IEEE-754 binary32 sqrt, same as libm's sqrtf.\n    v.sqrt()\n}\n\n// ---------------------------------------------------------------------------\n// Shape helpers\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// void c2BBVerts(c2v *out, c2AABB *bb)\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    unsafe {\n        *out.add(0) = (*bb).min;\n        *out.add(1) = c2V((*bb).max.x, (*bb).min.y);\n        *out.add(2) = (*bb).max;\n        *out.add(3) = c2V((*bb).min.x, (*bb).max.y);\n    }\n}\n\n/// ```c\n/// void c2MakeProxy(const void *shape, C2_TYPE type, c2Proxy *p)\n/// ```\n///\n/// Note: as in the C original there is no `default:` arm, so for a `type`\n/// outside `{0,1,2}` the proxy is left completely untouched.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n    unsafe {\n        match type_ {\n            C2_TYPE_CIRCLE => {\n                let c = shape as *mut c2Circle;\n                (*p).radius = (*c).r;\n                (*p).count = 1;\n                (*p).verts[0] = (*c).p;\n            }\n            C2_TYPE_AABB => {\n                let bb = shape as *mut c2AABB;\n                (*p).radius = 0.0;\n                (*p).count = 4;\n                c2BBVerts(addr_of_mut!((*p).verts) as *mut c2v, bb);\n            }\n            C2_TYPE_CAPSULE => {\n                let c = shape as *mut c2Capsule;\n                (*p).radius = (*c).r;\n                (*p).count = 2;\n                (*p).verts[0] = (*c).a;\n                (*p).verts[1] = (*c).b;\n            }\n            _ => {}\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Simplex routines\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// float c2GJKSimplexMetric(c2Simplex *s)\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    unsafe {\n        let verts = addr_of_mut!((*s).verts) as *mut c2sv;\n        match (*s).count {\n            2 => c2Len(c2Sub((*verts.add(1)).p, (*verts.add(0)).p)),\n            3 => c2Det2(\n                c2Sub((*verts.add(1)).p, (*verts.add(0)).p),\n                c2Sub((*verts.add(2)).p, (*verts.add(0)).p),\n            ),\n            // `default:` falls through into `case 1:` in the C source.\n            _ => 0.0,\n        }\n    }\n}\n\n/// ```c\n/// void c22(c2Simplex *s)\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    unsafe {\n        let verts = addr_of_mut!((*s).verts) as *mut c2sv;\n        let sa = verts.add(0);\n        let sb = verts.add(1);\n\n        let a = (*sa).p;\n        let b = (*sb).p;\n        let u = c2Dot(b, c2Sub(b, a));\n        let v = c2Dot(a, c2Sub(a, b));\n        if v <= 0.0 {\n            (*sa).u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else if u <= 0.0 {\n            *sa = *sb;\n            (*sa).u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else {\n            (*sa).u = u;\n            (*sb).u = v;\n            (*s).div = u + v;\n            (*s).count = 2;\n        }\n    }\n}\n\n/// ```c\n/// void c23(c2Simplex *s)\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n    unsafe {\n        let verts = addr_of_mut!((*s).verts) as *mut c2sv;\n        let sa = verts.add(0);\n        let sb = verts.add(1);\n        let sc = verts.add(2);\n\n        let a = (*sa).p;\n        let b = (*sb).p;\n        let c = (*sc).p;\n        let uAB = c2Dot(b, c2Sub(b, a));\n        let vAB = c2Dot(a, c2Sub(a, b));\n        let uBC = c2Dot(c, c2Sub(c, b));\n        let vBC = c2Dot(b, c2Sub(b, c));\n        let uCA = c2Dot(a, c2Sub(a, c));\n        let vCA = c2Dot(c, c2Sub(c, a));\n        let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n        let uABC = c2Det2(b, c) * area;\n        let vABC = c2Det2(c, a) * area;\n        let wABC = c2Det2(a, b) * area;\n        if vAB <= 0.0 && uCA <= 0.0 {\n            (*sa).u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else if uAB <= 0.0 && vBC <= 0.0 {\n            *sa = *sb;\n            (*sa).u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else if uBC <= 0.0 && vCA <= 0.0 {\n            *sa = *sc;\n            (*sa).u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n            (*sa).u = uAB;\n            (*sb).u = vAB;\n            (*s).div = uAB + vAB;\n            (*s).count = 2;\n        } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n            *sa = *sb;\n            *sb = *sc;\n            (*sa).u = uBC;\n            (*sb).u = vBC;\n            (*s).div = uBC + vBC;\n            (*s).count = 2;\n        } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n            *sb = *sa;\n            *sa = *sc;\n            (*sa).u = uCA;\n            (*sb).u = vCA;\n            (*s).div = uCA + vCA;\n            (*s).count = 2;\n        } else {\n            (*sa).u = uABC;\n            (*sb).u = vABC;\n            (*sc).u = wABC;\n            (*s).div = uABC + vABC + wABC;\n            (*s).count = 3;\n        }\n    }\n}\n\n/// ```c\n/// c2v c2D(c2Simplex *s)\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    unsafe {\n        let verts = addr_of!((*s).verts) as *const c2sv;\n        match (*s).count {\n            1 => c2Neg((*verts.add(0)).p),\n            2 => {\n                let ab = c2Sub((*verts.add(1)).p, (*verts.add(0)).p);\n                if c2Det2(ab, c2Neg((*verts.add(0)).p)) > 0.0 {\n                    return c2Skew(ab);\n                }\n                c2CCW90(ab)\n            }\n            // `case 3:` and `default:`\n            _ => c2V(0.0, 0.0),\n        }\n    }\n}\n\n/// ```c\n/// int c2Support(const c2v *verts, int count, c2v d)\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    unsafe {\n        let mut imax: c_int = 0;\n        let mut dmax = c2Dot(*verts.add(0), d);\n        let mut i: c_int = 1;\n        while i < count {\n            let dot = c2Dot(*verts.offset(i as isize), d);\n            if dot > dmax {\n                imax = i;\n                dmax = dot;\n            }\n            i += 1;\n        }\n        imax\n    }\n}\n\n/// ```c\n/// void c2Witness(c2Simplex *s, c2v *a, c2v *b)\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n    unsafe {\n        let verts = addr_of!((*s).verts) as *const c2sv;\n        let den = 1.0f32 / (*s).div;\n        match (*s).count {\n            1 => {\n                *a = (*verts.add(0)).sA;\n                *b = (*verts.add(0)).sB;\n            }\n            2 => {\n                *a = c2Add(\n                    c2Mulvs((*verts.add(0)).sA, den * (*verts.add(0)).u),\n                    c2Mulvs((*verts.add(1)).sA, den * (*verts.add(1)).u),\n                );\n                *b = c2Add(\n                    c2Mulvs((*verts.add(0)).sB, den * (*verts.add(0)).u),\n                    c2Mulvs((*verts.add(1)).sB, den * (*verts.add(1)).u),\n                );\n            }\n            3 => {\n                *a = c2Add(\n                    c2Add(\n                        c2Mulvs((*verts.add(0)).sA, den * (*verts.add(0)).u),\n                        c2Mulvs((*verts.add(1)).sA, den * (*verts.add(1)).u),\n                    ),\n                    c2Mulvs((*verts.add(2)).sA, den * (*verts.add(2)).u),\n                );\n                *b = c2Add(\n                    c2Add(\n                        c2Mulvs((*verts.add(0)).sB, den * (*verts.add(0)).u),\n                        c2Mulvs((*verts.add(1)).sB, den * (*verts.add(1)).u),\n                    ),\n                    c2Mulvs((*verts.add(2)).sB, den * (*verts.add(2)).u),\n                );\n            }\n            _ => {\n                *a = c2V(0.0, 0.0);\n                *b = c2V(0.0, 0.0);\n            }\n        }\n    }\n}\n\n/// ```c\n/// c2v c2L(c2Simplex *s)\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n    unsafe {\n        let verts = addr_of!((*s).verts) as *const c2sv;\n        let den = 1.0f32 / (*s).div;\n        match (*s).count {\n            1 => (*verts.add(0)).p,\n            2 => c2Add(\n                c2Mulvs((*verts.add(0)).p, den * (*verts.add(0)).u),\n                c2Mulvs((*verts.add(1)).p, den * (*verts.add(1)).u),\n            ),\n            _ => c2V(0.0, 0.0),\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// GJK\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// float c2GJK(const void *A, C2_TYPE typeA, const c2x *ax_ptr,\n///             const void *B, C2_TYPE typeB, const c2x *bx_ptr,\n///             c2v *outA, c2v *outB, int use_radius, int *iterations,\n///             c2GJKCache *cache);\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJK(\n    A: *const c_void,\n    typeA: c_int,\n    ax_ptr: *const c2x,\n    B: *const c_void,\n    typeB: c_int,\n    bx_ptr: *const c2x,\n    outA: *mut c2v,\n    outB: *mut c2v,\n    use_radius: c_int,\n    iterations: *mut c_int,\n    cache: *mut c2GJKCache,\n) -> f32 {\n    unsafe {\n        let ax: c2x;\n        let bx: c2x;\n        if ax_ptr.is_null() {\n            ax = c2xIdentity();\n        } else {\n            ax = *ax_ptr;\n        }\n        if bx_ptr.is_null() {\n            bx = c2xIdentity();\n        } else {\n            bx = *bx_ptr;\n        }\n\n        let mut pA = c2Proxy::zeroed();\n        let mut pB = c2Proxy::zeroed();\n        c2MakeProxy(A, typeA, &mut pA);\n        c2MakeProxy(B, typeB, &mut pB);\n        let pA_verts = addr_of!(pA.verts) as *const c2v;\n        let pB_verts = addr_of!(pB.verts) as *const c2v;\n\n        let mut s = c2Simplex::zeroed();\n        let sp: *mut c2Simplex = &mut s;\n        // `c2sv* verts = &s.a;`\n        let verts = addr_of_mut!((*sp).verts) as *mut c2sv;\n\n        let mut cache_was_read: c_int = 0;\n        if !cache.is_null() {\n            let cache_was_good: c_int = ((*cache).count != 0) as c_int;\n            if cache_was_good != 0 {\n                let cache_iA = addr_of_mut!((*cache).iA) as *mut c_int;\n                let cache_iB = addr_of_mut!((*cache).iB) as *mut c_int;\n                let cache_count = (*cache).count;\n                let mut i: c_int = 0;\n                while i < cache_count {\n                    let iA = *cache_iA.offset(i as isize);\n                    let iB = *cache_iB.offset(i as isize);\n                    let sA = c2Mulxv(ax, *pA_verts.offset(iA as isize));\n                    let sB = c2Mulxv(bx, *pB_verts.offset(iB as isize));\n                    let v = verts.offset(i as isize);\n                    (*v).iA = iA;\n                    (*v).sA = sA;\n                    (*v).iB = iB;\n                    (*v).sB = sB;\n                    (*v).p = c2Sub((*v).sB, (*v).sA);\n                    (*v).u = 0.0;\n                    i += 1;\n                }\n                (*sp).count = cache_count;\n                (*sp).div = (*cache).div;\n                let metric_old = (*cache).metric;\n                let metric = c2GJKSimplexMetric(sp);\n                let min_metric = if metric < metric_old { metric } else { metric_old };\n                let max_metric = if metric > metric_old { metric } else { metric_old };\n                if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n                    cache_was_read = 1;\n                }\n            }\n        }\n\n        if cache_was_read == 0 {\n            let v0 = verts.add(0);\n            (*v0).iA = 0;\n            (*v0).iB = 0;\n            (*v0).sA = c2Mulxv(ax, *pA_verts.add(0));\n            (*v0).sB = c2Mulxv(bx, *pB_verts.add(0));\n            (*v0).p = c2Sub((*v0).sB, (*v0).sA);\n            (*v0).u = 1.0f32;\n            (*sp).div = 1.0f32;\n            (*sp).count = 1;\n        }\n\n        let mut saveA: [c_int; 3] = [0; 3];\n        let mut saveB: [c_int; 3] = [0; 3];\n        let saveA_p = saveA.as_mut_ptr();\n        let saveB_p = saveB.as_mut_ptr();\n        let mut save_count: c_int = 0;\n        let mut d0: f32 = FLT_MAX;\n        let mut d1: f32 = FLT_MAX;\n        let mut iter: c_int = 0;\n        let mut hit: c_int = 0;\n        while iter < 20 {\n            save_count = (*sp).count;\n            let mut i: c_int = 0;\n            while i < save_count {\n                *saveA_p.offset(i as isize) = (*verts.offset(i as isize)).iA;\n                *saveB_p.offset(i as isize) = (*verts.offset(i as isize)).iB;\n                i += 1;\n            }\n            match (*sp).count {\n                1 => {}\n                2 => c22(sp),\n                3 => c23(sp),\n                _ => {}\n            }\n            if (*sp).count == 3 {\n                hit = 1;\n                break;\n            }\n            let p = c2L(sp);\n            d1 = c2Dot(p, p);\n            if d1 > d0 {\n                break;\n            }\n            d0 = d1;\n            let d = c2D(sp);\n            if c2Dot(d, d) < FLT_EPSILON * FLT_EPSILON {\n                break;\n            }\n            let iA = c2Support(pA_verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\n            let sA = c2Mulxv(ax, *pA_verts.offset(iA as isize));\n            let iB = c2Support(pB_verts, pB.count, c2MulrvT(bx.r, d));\n            let sB = c2Mulxv(bx, *pB_verts.offset(iB as isize));\n            let v = verts.offset((*sp).count as isize);\n            (*v).iA = iA;\n            (*v).sA = sA;\n            (*v).iB = iB;\n            (*v).sB = sB