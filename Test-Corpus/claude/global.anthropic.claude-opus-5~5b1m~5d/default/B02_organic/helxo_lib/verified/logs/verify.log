{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PnHNNTr4EvQiZBcvuzwoYE","type":"tool_result","content":"440\t}\n441\t\n442\t#[test]\n443\tfn row70_stralloc_block_counter_saturation() {\n444\t    let (p, _g) = libs();\n445\t    // blocksize = 512 << (block/2); block increments while blocksize < 1<<20,\n446\t    // i.e. up to block == 23.  Force many block rollovers with big strings.\n447\t    let mut lens = Vec::new();\n448\t    for _ in 0..30 {\n449\t        lens.push(1_100_000); // > any blocksize -> dedicated block each time\n450\t    }\n451\t    arena_run(p, &lens, 21);\n452\t\n453\t    // now drive `block` upward through the normal (non-oversized) path\n454\t    unsafe {\n455\t        let mut ac = Arena::zeroed();\n456\t        let mut ar = Arena::zeroed();\n457\t        let mut s = vec![b'z'; 400];\n458\t        s.push(0);\n459\t        for i in 0..200000usize {\n460\t            // each allocation of 401 bytes eventually exhausts each block\n461\t            let a = (p.c.stralloc)(&mut ac, s.as_mut_ptr() as *mut c_char);\n462\t            let b = (p.r.stralloc)(&mut ar, s.as_mut_ptr() as *mut c_char);\n463\t            assert_eq!(cstr_bytes(a), cstr_bytes(b), \"content at {i}\");\n464\t            assert_eq!(ac.remaining, ar.remaining, \"remaining at {i}\");\n465\t            assert_eq!(ac.block, ar.block, \"block at {i}\");\n466\t            if ac.block >= 24 {\n467\t                break;\n468\t            }\n469\t        }\n470\t        assert!(ac.block >= 24, \"did not reach block saturation (got {})\", ac.block);\n471\t        assert_eq!(ac.block, ar.block);\n472\t        (p.c.strreset)(&mut ac);\n473\t        (p.r.strreset)(&mut ar);\n474\t    }\n475\t}\n476\t\n477\t#[test]\n478\tfn rows71_72_strreset() {\n479\t    let (p, _g) = libs();"}]},"parent_tool_use_id":null,"session_id":"e2dcfccc-b98f-4c68-871b-22e93296d372","uuid":"d567b778-9304-423a-b657-1f7ced742f08","timestamp":"2026-09-05T08:17:50.291Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-6M6KAs/translation/tests/lowlevel.rs","content":"}\n\n#[test]\nfn row70_stralloc_block_counter_saturation() {\n    let (p, _g) = libs();\n    // blocksize = 512 << (block/2); block increments while blocksize < 1<<20,\n    // i.e. up to block == 23.  Force many block rollovers with big strings.\n    let mut lens = Vec::new();\n    for _ in 0..30 {\n        lens.push(1_100_000); // > any blocksize -> dedicated block each time\n    }\n    arena_run(p, &lens, 21);\n\n    // now drive `block` upward through the normal (non-oversized) path\n    unsafe {\n        let mut ac = Arena::zeroed();\n        let mut ar = Arena::zeroed();\n        let mut s = vec![b'z'; 400];\n        s.push(0);\n        for i in 0..200000usize {\n            // each allocation of 401 bytes eventually exhausts each block\n            let a = (p.c.stralloc)(&mut ac, s.as_mut_ptr() as *mut c_char);\n            let b = (p.r.stralloc)(&mut ar, s.as_mut_ptr() as *mut c_char);\n            assert_eq!(cstr_bytes(a), cstr_bytes(b), \"content at {i}\");\n            assert_eq!(ac.remaining, ar.remaining, \"remaining at {i}\");\n            assert_eq!(ac.block, ar.block, \"block at {i}\");\n            if ac.block >= 24 {\n                break;\n            }\n        }\n        assert!(ac.block >= 24, \"did not reach block saturation (got {})\", ac.block);\n        assert_eq!(ac.block, ar.block);\n        (p.c.strreset)(&mut ac);\n        (p.r.strreset)(&mut ar);\n    }\n}\n\n#[test]\nfn rows71_72_strreset() {\n    let (p, _g) = libs();","numLines":40,"startLine":440,"totalLines":589}}}
