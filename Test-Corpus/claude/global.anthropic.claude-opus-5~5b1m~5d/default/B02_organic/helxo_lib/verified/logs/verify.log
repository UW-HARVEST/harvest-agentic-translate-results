{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01C7mXFXs3qWCEEQ6AvGhatt","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The C library is a single translation unit (`src/lib.c`) that embeds the\n4\t//! implementation part of `stb_ds.h` (public domain, see `c_src/license.txt`)\n5\t//! together with two extra functions (`strkey`, `helxo`).\n6\t//!\n7\t//! Every public symbol exported by the C shared object is re-exported here with\n8\t//! the identical linker name, signature and observable behaviour (including the\n9\t//! quirks / latent bugs of the original code, which are reproduced verbatim).\n10\t\n11\t#![allow(non_camel_case_types)]\n12\t#![allow(non_snake_case)]\n13\t#![allow(non_upper_case_globals)]\n14\t#![allow(unused_assignments)]\n15\t\n16\tuse core::ffi::{c_char, c_int, c_void};\n17\tuse core::ptr;\n18\t\n19\t// ---------------------------------------------------------------------------\n20\t// libc bindings\n21\t//\n22\t// The C code allocates through `realloc`/`free` (STBDS_REALLOC / STBDS_FREE),\n23\t// so the Rust translation must use the very same allocator: callers of this\n24\t// library free array/hash-map headers with plain `free()` through the\n25\t// `stbds_arrfree` / `stbds_hmfree` macros.\n26\t// ---------------------------------------------------------------------------\n27\textern \"C\" {\n28\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n29\t    fn free(p: *mut c_void);\n30\t    fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n31\t    fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n32\t    fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n33\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n34\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n35\t    fn strlen(s: *const c_char) -> usize;\n36\t    fn printf(fmt: *const c_char, ...) -> c_int;\n37\t    fn sprintf(buf: *mut c_char, fmt: *const c_char, ...) -> c_int;\n38\t}\n39\t\n40\t// ---------------------------------------------------------------------------\n41\t// Data structures (layout-identical to the C ones)\n42\t// ---------------------------------------------------------------------------\n43\t\n44\t/// `typedef struct { size_t length; size_t capacity; void *hash_table; ptrdiff_t temp; } stbds_array_header;`\n45\t#[repr(C)]\n46\tstruct stbds_array_header {\n47\t    length: usize,\n48\t    capacity: usize,\n49\t    hash_table: *mut c_void,\n50\t    temp: isize,\n51\t}\n52\t\n53\t/// `typedef struct stbds_string_block { struct stbds_string_block *next; char storage[8]; } stbds_string_block;`\n54\t#[repr(C)]\n55\tstruct stbds_string_block {\n56\t    next: *mut stbds_string_block,\n57\t    storage: [c_char; 8],\n58\t}\n59\t\n60\t/// `struct stbds_string_arena { stbds_string_block *storage; size_t remaining; unsigned char block; unsigned char mode; };`\n61\t#[repr(C)]\n62\tpub struct stbds_string_arena {\n63\t    storage: *mut stbds_string_block,\n64\t    remaining: usize,\n65\t    block: u8,\n66\t    mode: u8,\n67\t}\n68\t\n69\t/// `typedef struct { size_t hash[8]; ptrdiff_t index[8]; } stbds_hash_bucket;`\n70\t#[repr(C)]\n71\tstruct stbds_hash_bucket {\n72\t    hash: [usize; STBDS_BUCKET_LENGTH],\n73\t    index: [isize; STBDS_BUCKET_LENGTH],\n74\t}\n75\t\n76\t/// `typedef struct { ... } stbds_hash_index;`\n77\t#[repr(C)]\n78\tstruct stbds_hash_index {\n79\t    temp_key: *mut c_char,\n80\t    slot_count: usize,\n81\t    used_count: usize,\n82\t    used_count_threshold: usize,\n83\t    used_count_shrink_threshold: usize,\n84\t    tombstone_count: usize,\n85\t    tombstone_count_threshold: usize,\n86\t    seed: usize,\n87\t    slot_count_log2: usize,\n88\t    string: stbds_string_arena,\n89\t    storage: *mut stbds_hash_bucket,\n90\t}\n91\t\n92\t// ---------------------------------------------------------------------------\n93\t// Constants\n94\t// ---------------------------------------------------------------------------\n95\t\n96\tconst STBDS_BUCKET_LENGTH: usize = 8;\n97\tconst STBDS_BUCKET_SHIFT: usize = 3; // (STBDS_BUCKET_LENGTH == 8 ? 3 : 2)\n98\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n99\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n100\t\n101\tconst STBDS_INDEX_EMPTY: isize = -1;\n102\tconst STBDS_INDEX_DELETED: isize = -2;\n103\t\n104\tconst STBDS_HASH_EMPTY: usize = 0;\n105\tconst STBDS_HASH_DELETED: usize = 1;\n106\t\n107\t#[allow(dead_code)]\n108\tconst STBDS_HM_BINARY: c_int = 0;\n109\tconst STBDS_HM_STRING: c_int = 1;\n110\t\n111\t#[allow(dead_code)]\n112\tconst STBDS_SH_NONE: c_int = 0;\n113\tconst STBDS_SH_DEFAULT: c_int = 1;\n114\tconst STBDS_SH_STRDUP: c_int = 2;\n115\tconst STBDS_SH_ARENA: c_int = 3;\n116\t\n117\tconst STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() * 8) as u32;\n118\t\n119\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n120\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n121\t\n122\tconst STBDS_STRING_ARENA_BLOCKSIZE_MIN: usize = 512;\n123\tconst STBDS_STRING_ARENA_BLOCKSIZE_MAX: usize = 1 << 20;\n124\t\n125\tconst HEADER_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n126\t\n127\t// ---------------------------------------------------------------------------\n128\t// Small helpers mirroring the C macros\n129\t// ---------------------------------------------------------------------------\n130\t\n131\t/// `#define stbds_header(t)  ((stbds_array_header *) (t) - 1)`\n132\t#[inline]\n133\tunsafe fn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n134\t    (t as *mut u8).wrapping_sub(HEADER_SIZE) as *mut stbds_array_header\n135\t}\n136\t\n137\t/// `#define stbds_arrlen(a)  ((a) ? (ptrdiff_t) stbds_header(a)->length : 0)`\n138\t#[inline]\n139\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n140\t    if a.is_null() {\n141\t        0\n142\t    } else {\n143\t        (*stbds_header(a)).length as isize\n144\t    }\n145\t}\n146\t\n147\t/// `#define stbds_arrcap(a)  ((a) ? stbds_header(a)->capacity : 0)`\n148\t#[inline]\n149\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n150\t    if a.is_null() {\n151\t        0\n152\t    } else {\n153\t        (*stbds_header(a)).capacity\n154\t    }\n155\t}\n156\t\n157\t/// `#define stbds_temp(t)    stbds_header(t)->temp`\n158\t#[inline]\n159\tunsafe fn stbds_temp_get(t: *mut c_void) -> isize {\n160\t    (*stbds_header(t)).temp\n161\t}\n162\t\n163\t#[inline]\n164\tunsafe fn stbds_temp_set(t: *mut c_void, v: isize) {\n165\t    (*stbds_header(t)).temp = v;\n166\t}\n167\t\n168\t/// `#define stbds_temp_key(t) (*(char **) stbds_header(t)->hash_table)`\n169\t#[inline]\n170\tunsafe fn stbds_temp_key_set(t: *mut c_void, v: *mut c_char) {\n171\t    *((*stbds_header(t)).hash_table as *mut *mut c_char) = v;\n172\t}\n173\t\n174\t/// `#define stbds_hash_table(a)  ((stbds_hash_index *) stbds_header(a)->hash_table)`\n175\t#[inline]\n176\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n177\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n178\t}\n179\t\n180\t/// `#define STBDS_HASH_TO_ARR(x,elemsize) ((char *) (x) - (elemsize))`\n181\t#[inline]\n182\tfn STBDS_HASH_TO_ARR(x: *mut c_void, elemsize: usize) -> *mut c_void {\n183\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n184\t}\n185\t\n186\t/// `#define STBDS_ARR_TO_HASH(x,elemsize) ((char *) (x) + (elemsize))`\n187\t#[inline]\n188\tfn STBDS_ARR_TO_HASH(x: *mut c_void, elemsize: usize) -> *mut c_void {\n189\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n190\t}\n191\t\n192\t/// `#define STBDS_ALIGN_FWD(n,a) (((n) + (a) - 1) & ~((a)-1))`\n193\t#[inline]\n194\tfn STBDS_ALIGN_FWD(n: usize, a: usize) -> usize {\n195\t    n.wrapping_add(a - 1) & !(a - 1)\n196\t}\n197\t\n198\t/// `#define STBDS_ROTATE_LEFT(val, n) (((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n))))`\n199\t#[inline]\n200\tfn STBDS_ROTATE_LEFT(val: usize, n: u32) -> usize {\n201\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n202\t}\n203\t\n204\t/// `#define STBDS_ROTATE_RIGHT(val, n) (((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n))))`\n205\t#[inline]\n206\tfn STBDS_ROTATE_RIGHT(val: usize, n: u32) -> usize {\n207\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n208\t}\n209\t\n210\t// ---------------------------------------------------------------------------\n211\t// stbds_arrgrowf / stbds_arrfreef\n212\t// ---------------------------------------------------------------------------\n213\t\n214\t#[unsafe(no_mangle)]\n215\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n216\t    a: *mut c_void,\n217\t    elemsize: usize,\n218\t    addlen: usize,\n219\t    mut min_cap: usize,\n220\t) -> *mut c_void {\n221\t    let b: *mut c_void;\n222\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n223\t\n224\t    if min_len > min_cap {\n225\t        min_cap = min_len;\n226\t    }\n227\t\n228\t    if min_cap <= stbds_arrcap(a) {\n229\t        return a;\n230\t    }\n231\t\n232\t    if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n233\t        min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n234\t    } else if min_cap < 4 {\n235\t        min_cap = 4;\n236\t    }\n237\t\n238\t    let old: *mut c_void = if a.is_null() {\n239\t        ptr::null_mut()\n240\t    } else {\n241\t        stbds_header(a) as *mut c_void\n242\t    };\n243\t    let raw = realloc(old, elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE));\n244\t    b = (raw as *mut u8).wrapping_add(HEADER_SIZE) as *mut c_void;\n245\t    if a.is_null() {\n246\t        (*stbds_header(b)).length = 0;\n247\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n248\t        (*stbds_header(b)).temp = 0;\n249\t    }\n250\t    (*stbds_header(b)).capacity = min_cap;\n251\t\n252\t    b\n253\t}\n254\t\n255\t#[unsafe(no_mangle)]\n256\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n257\t    free(stbds_header(a) as *mut c_void);\n258\t}\n259\t\n260\t// ---------------------------------------------------------------------------\n261\t// hash seed / rng\n262\t// ---------------------------------------------------------------------------\n263\t\n264\tstatic mut stbds_hash_seed: usize = 0x31415926;\n265\t\n266\t#[unsafe(no_mangle)]\n267\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n268\t    stbds_hash_seed = seed;\n269\t}\n270\t\n271\t/// ```c\n272\t/// #define stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)   \\\n273\t///   temp = v64_lo ^ v32, temp <<= 16, temp <<= 16, temp >>= 16, temp >>= 16, \\\n274\t///   var = v64_hi, var <<= 16, var <<= 16,                       \\\n275\t///   var ^= temp ^ v32\n276\t/// ```\n277\t#[inline]\n278\tfn stbds_load_32_or_64(v32: u32, v64_hi: u32, v64_lo: u32) -> usize {\n279\t    // In C `v64_lo ^ v32` is computed in `unsigned int` (32 bits) and then\n280\t    // widened to size_t, so the intermediate is naturally 32 bits wide.\n281\t    let mut temp: usize = (v64_lo ^ v32) as usize;\n282\t    temp <<= 16;\n283\t    temp <<= 16;\n284\t    temp >>= 16;\n285\t    temp >>= 16;\n286\t    let mut var: usize = v64_hi as usize;\n287\t    var <<= 16;\n288\t    var <<= 16;\n289\t    var ^= temp ^ (v32 as usize);\n290\t    var\n291\t}\n292\t\n293\t// ---------------------------------------------------------------------------\n294\t// hash index construction\n295\t// ---------------------------------------------------------------------------\n296\t\n297\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n298\t    hash & (slot_count - 1)\n299\t}\n300\t\n301\tfn stbds_log2(mut slot_count: usize) -> usize {\n302\t    let mut n: usize = 0;\n303\t    while slot_count > 1 {\n304\t        slot_count >>= 1;\n305\t        n += 1;\n306\t    }\n307\t    n\n308\t}\n309\t\n310\tunsafe fn stbds_make_hash_index(\n311\t    slot_count: usize,\n312\t    ot: *mut stbds_hash_index,\n313\t) -> *mut stbds_hash_index {\n314\t    let t: *mut stbds_hash_index = realloc(\n315\t        ptr::null_mut(),\n316\t        (slot_count >> STBDS_BUCKET_SHIFT)\n317\t            .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n318\t            .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n319\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n320\t    ) as *mut stbds_hash_index;\n321\t\n322\t    (*t).storage = STBDS_ALIGN_FWD(t.wrapping_add(1) as usize, STBDS_CACHE_LINE_SIZE)\n323\t        as *mut stbds_hash_bucket;\n324\t    (*t).slot_count = slot_count;\n325\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n326\t    (*t).tombstone_count = 0;\n327\t    (*t).used_count = 0;\n328\t\n329\t    (*t).used_count_threshold = slot_count - (slot_count >> 2);\n330\t    (*t).tombstone_count_threshold = (slot_count >> 3) + (slot_count >> 4);\n331\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n332\t\n333\t    if slot_count <= STBDS_BUCKET_LENGTH {\n334\t        (*t).used_count_shrink_threshold = 0;\n335\t    }\n336\t    // STBDS_ASSERT(t->used_count_threshold + t->tombstone_count_threshold < t->slot_count);\n337\t\n338\t    if !ot.is_null() {\n339\t        (*t).string = stbds_string_arena {\n340\t            storage: (*ot).string.storage,\n341\t            remaining: (*ot).string.remaining,\n342\t            block: (*ot).string.block,\n343\t            mode: (*ot).string.mode,\n344\t        };\n345\t        (*t).seed = (*ot).seed;\n346\t    } else {\n347\t        memset(\n348\t            ptr::addr_of_mut!((*t).string) as *mut c_void,\n349\t            0,\n350\t            core::mem::size_of::<stbds_string_arena>(),\n351\t        );\n352\t        (*t).seed = stbds_hash_seed;\n353\t        let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n354\t        let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n355\t        stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n356\t    }\n357\t\n358\t    {\n359\t        let mut i: usize = 0;\n360\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n361\t            let b: *mut stbds_hash_bucket = (*t).storage.add(i);\n362\t            for j in 0..STBDS_BUCKET_LENGTH {\n363\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n364\t            }\n365\t            for j in 0..STBDS_BUCKET_LENGTH {\n366\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n367\t            }\n368\t            i += 1;\n369\t        }\n370\t    }\n371\t\n372\t    if !ot.is_null() {\n373\t        (*t).used_count = (*ot).used_count;\n374\t        let mut i: usize = 0;\n375\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n376\t            let ob: *mut stbds_hash_bucket = (*ot).storage.add(i);\n377\t            for j in 0..STBDS_BUCKET_LENGTH {\n378\t                if (*ob).index[j] >= 0 {\n379\t                    let hash = (*ob).hash[j];\n380\t                    let mut pos =\n381\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n382\t                    let mut step = STBDS_BUCKET_LENGTH;\n383\t                    'outer: loop {\n384\t                        let bucket: *mut stbds_hash_bucket =\n385\t                            (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n386\t\n387\t                        let mut z = pos & STBDS_BUCKET_MASK;\n388\t                        while z < STBDS_BUCKET_LENGTH {\n389\t                            if (*bucket).hash[z] == 0 {\n390\t                                (*bucket).hash[z] = hash;\n391\t                                (*bucket).index[z] = (*ob).index[j];\n392\t                                break 'outer;\n393\t                            }\n394\t                            z += 1;\n395\t                        }\n396\t\n397\t                        let limit = pos & STBDS_BUCKET_MASK;\n398\t                        let mut z = 0usize;\n399\t                        while z < limit {\n400\t                            if (*bucket).hash[z] == 0 {\n401\t                                (*bucket).hash[z] = hash;\n402\t                                (*bucket).index[z] = (*ob).index[j];\n403\t                                break 'outer;\n404\t                            }\n405\t                            z += 1;\n406\t                        }\n407\t\n408\t                        pos = pos.wrapping_add(step);\n409\t                        step += STBDS_BUCKET_LENGTH;\n410\t                        pos &= (*t).slot_count - 1;\n411\t                    }\n412\t                }\n413\t            }\n414\t            i += 1;\n415\t        }\n416\t    }\n417\t\n418\t    t\n419\t}\n420\t\n421\t// ---------------------------------------------------------------------------\n422\t// hashing\n423\t// ---------------------------------------------------------------------------\n424\t\n425\t#[unsafe(no_mangle)]\n426\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n427\t    let mut hash: usize = seed;\n428\t    let mut str_ = str_;\n429\t    while *str_ != 0 {\n430\t        hash = STBDS_ROTATE_LEFT(hash, 9).wrapping_add(*str_ as u8 as usize);\n431\t        str_ = str_.add(1);\n432\t    }\n433\t\n434\t    hash ^= seed;\n435\t    hash = (!hash).wrapping_add(hash << 18);\n436\t    hash ^= hash ^ STBDS_ROTATE_RIGHT(hash, 31);\n437\t    hash = hash.wrapping_mul(21);\n438\t    hash ^= hash ^ STBDS_ROTATE_RIGHT(hash, 11);\n439\t    hash = hash.wrapping_add(hash << 6);\n440\t    hash ^= STBDS_ROTATE_RIGHT(hash, 22);\n441\t    hash.wrapping_add(seed)\n442\t}\n443\t\n444\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n445\t    let mut d = p as *const u8;\n446\t    let mut i: usize;\n447\t    let mut v0: usize;\n448\t    let mut v1: usize;\n449\t    let mut v2: usize;\n450\t    let mut v3: usize;\n451\t    let mut data: usize;\n452\t\n453\t    v0 = (((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575)) ^ seed;\n454\t    v1 = (((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d)) ^ !seed;\n455\t    v2 = (((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261)) ^ seed;\n456\t    v3 = (((0x74656462usize << 16) << 16).wrapping_add(0x79746573)) ^ !seed;\n457\t\n458\t    v0 ^= 0x0706050403020100usize ^ seed;\n459\t    v1 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n460\t    v2 ^= 0x0706050403020100usize ^ seed;\n461\t    v3 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n462\t\n463\t    macro_rules! STBDS_SIPROUND {\n464\t        () => {{\n465\t            v0 = v0.wrapping_add(v1);\n466\t            v1 = STBDS_ROTATE_LEFT(v1, 13);\n467\t            v1 ^= v0;\n468\t            v0 = STBDS_ROTATE_LEFT(v0, STBDS_SIZE_T_BITS / 2);\n469\t            v2 = v2.wrapping_add(v3);\n470\t            v3 = STBDS_ROTATE_LEFT(v3, 16);\n471\t            v3 ^= v2;\n472\t            v2 = v2.wrapping_add(v1);\n473\t            v1 = STBDS_ROTATE_LEFT(v1, 17);\n474\t            v1 ^= v2;\n475\t            v2 = STBDS_ROTATE_LEFT(v2, STBDS_SIZE_T_BITS / 2);\n476\t            v0 = v0.wrapping_add(v3);\n477\t            v3 = STBDS_ROTATE_LEFT(v3, 21);\n478\t            v3 ^= v0;\n479\t        }};\n480\t    }\n481\t\n482\t    i = 0;\n483\t    while i + core::mem::size_of::<usize>() <= len {\n484\t        // `data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);`\n485\t        //\n486\t        // In C this expression has type `int`; when d[3] >= 0x80 the result is\n487\t        // negative and the conversion to size_t sign-extends it, setting the\n488\t        // whole upper half of `data`.  That behaviour is reproduced here.\n489\t        let w0: i32 = (*d.add(0) as i32)\n490\t            | ((*d.add(1) as i32) << 8)\n491\t            | ((*d.add(2) as i32) << 16)\n492\t            | (((*d.add(3) as u32) << 24) as i32);\n493\t        data = w0 as i64 as usize;\n494\t\n495\t        let w1: i32 = (*d.add(4) as i32)\n496\t            | ((*d.add(5) as i32) << 8)\n497\t            | ((*d.add(6) as i32) << 16)\n498\t            | (((*d.add(7) as u32) << 24) as i32);\n499\t        data |= ((w1 as i64 as usize) << 16) << 16;\n500\t\n501\t        v3 ^= data;\n502\t        for _ in 0..STBDS_SIPHASH_C_RO