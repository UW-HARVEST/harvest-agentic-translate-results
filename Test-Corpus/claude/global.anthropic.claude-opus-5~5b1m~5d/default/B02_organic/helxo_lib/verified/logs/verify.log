   mode: c_int,\n566\t    i: isize,\n567\t) -> c_int {\n568\t    if mode >= STBDS_HM_STRING {\n569\t        let stored = *((a as *mut u8)\n570\t            .wrapping_offset(elemsize.wrapping_mul(i as usize) as isize)\n571\t            .wrapping_add(keyoffset) as *mut *mut c_char);\n572\t        (0 == strcmp(key as *mut c_char, stored)) as c_int\n573\t    } else {\n574\t        (0 == memcmp(\n575\t            key,\n576\t            (a as *mut u8)\n577\t                .wrapping_offset(elemsize.wrapping_mul(i as usize) as isize)\n578\t                .wrapping_add(keyoffset) as *const c_void,\n579\t            keysize,\n580\t        )) as c_int\n581\t    }\n582\t}\n583\t\n584\t#[unsafe(no_mangle)]\n585\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n586\t    if a.is_null() {\n587\t        return;\n588\t    }\n589\t    if !stbds_hash_table(a).is_null() {\n590\t        if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP as u8 {\n591\t            let mut i: usize = 1;\n592\t            while i < (*stbds_header(a)).length {\n593\t                free(*((a as *mut u8).wrapping_add(elemsize.wrapping_mul(i)) as *mut *mut c_char)\n594\t                    as *mut c_void);\n595\t                i += 1;\n596\t            }\n597\t        }\n598\t        stbds_strreset(ptr::addr_of_mut!((*stbds_hash_table(a)).string));\n599\t    }\n600\t    free((*stbds_header(a)).hash_table);\n601\t    free(stbds_header(a) as *mut c_void);\n602\t}\n603\t\n604\tunsafe fn stbds_hm_find_slot(\n605\t    a: *mut c_void,\n606\t    elemsize: usize,\n607\t    key: *mut c_void,\n608\t    keysize: usize,\n609\t    keyoffset: usize,\n610\t    mode: c_int,\n611\t) -> isize {\n612\t    let raw_a = STBDS_HASH_TO_ARR(a, elemsize);\n613\t    let table = stbds_hash_table(raw_a);\n614\t    let mut hash = if mode >= STBDS_HM_STRING {\n615\t        stbds_hash_string(key as *mut c_char, (*table).seed)\n616\t    } else {\n617\t        stbds_hash_bytes(key, keysize, (*table).seed)\n618\t    };\n619\t    let mut step = STBDS_BUCKET_LENGTH;\n620\t    let mut pos: usize;\n621\t    let mut bucket: *mut stbds_hash_bucket;\n622\t\n623\t    if hash < 2 {\n624\t        hash += 2;\n625\t    }\n626\t\n627\t    pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n628\t\n629\t    loop {\n630\t        bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);\n631\t\n632\t        let mut i = pos & STBDS_BUCKET_MASK;\n633\t        while i < STBDS_BUCKET_LENGTH {\n634\t            if (*bucket).hash[i] == hash {\n635\t                if stbds_is_key_equal(\n636\t                    a,\n637\t                    elemsize,\n638\t                    key,\n639\t                    keysize,\n640\t                    keyoffset,\n641\t                    mode,\n642\t                    (*bucket).index[i],\n643\t                ) != 0\n644\t                {\n645\t                    return ((pos & !STBDS_BUCKET_MASK) + i) as isize;\n646\t                }\n647\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n648\t                return -1;\n649\t            }\n650\t            i += 1;\n651\t        }\n652\t\n653\t        let limit = pos & STBDS_BUCKET_MASK;\n654\t        let mut i = 0usize;\n655\t        while i < limit {\n656\t            if (*bucket).hash[i] == hash {\n657\t                if stbds_is_key_equal(\n658\t                    a,\n659\t                    elemsize,\n660\t                    key,\n661\t                    keysize,\n662\t                    keyoffset,\n663\t                    mode,\n664\t                    (*bucket).index[i],\n665\t                ) != 0\n666\t                {\n667\t                    return ((pos & !STBDS_BUCKET_MASK) + i) as isize;\n668\t                }\n669\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n670\t                return -1;\n671\t            }\n672\t            i += 1;\n673\t        }\n674\t\n675\t        pos = pos.wrapping_add(step);\n676\t        step += STBDS_BUCKET_LENGTH;\n677\t        pos &= (*table).slot_count - 1;\n678\t    }\n679\t}\n680\t\n681\t#[unsafe(no_mangle)]\n682\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n683\t    a: *mut c_void,\n684\t    elemsize: usize,\n685\t    key: *mut c_void,\n686\t    keysize: usize,\n687\t    temp: *mut isize,\n688\t    mode: c_int,\n689\t) -> *mut c_void {\n690\t    let keyoffset: usize = 0;\n691\t    if a.is_null() {\n692\t        let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n693\t        (*stbds_header(a)).length += 1;\n694\t        memset(a, 0, elemsize);\n695\t        *temp = STBDS_INDEX_EMPTY;\n696\t        STBDS_ARR_TO_HASH(a, elemsize)\n697\t    } else {\n698\t        let table: *mut stbds_hash_index;\n699\t        let raw_a = STBDS_HASH_TO_ARR(a, elemsize);\n700\t        table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n701\t        if table.is_null() {\n702\t            *temp = -1;\n703\t        } else {\n704\t            let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n705\t            if slot < 0 {\n706\t                *temp = STBDS_INDEX_EMPTY;\n707\t            } else {\n708\t                let b = (*table).storage.offset(slot >> STBDS_BUCKET_SHIFT);\n709\t                *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n710\t            }\n711\t        }\n712\t        a\n713\t    }\n714\t}\n715\t\n716\t#[unsafe(no_mangle)]\n717\tpub unsafe extern \"C\" fn stbds_hmget_key(\n718\t    a: *mut c_void,\n719\t    elemsize: usize,\n720\t    key: *mut c_void,\n721\t    keysize: usize,\n722\t    mode: c_int,\n723\t) -> *mut c_void {\n724\t    let mut temp: isize = 0;\n725\t    let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &mut temp, mode);\n726\t    stbds_temp_set(STBDS_HASH_TO_ARR(p, elemsize), temp);\n727\t    p\n728\t}\n729\t\n730\t#[unsafe(no_mangle)]\n731\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n732\t    let mut a = a;\n733\t    if a.is_null() || (*stbds_header(STBDS_HASH_TO_ARR(a, elemsize))).length == 0 {\n734\t        a = stbds_arrgrowf(\n735\t            if !a.is_null() {\n736\t                STBDS_HASH_TO_ARR(a, elemsize)\n737\t            } else {\n738\t                ptr::null_mut()\n739\t            },\n740\t            elemsize,\n741\t            0,\n742\t            1,\n743\t        );\n744\t        (*stbds_header(a)).length += 1;\n745\t        memset(a, 0, elemsize);\n746\t        a = STBDS_ARR_TO_HASH(a, elemsize);\n747\t    }\n748\t    a\n749\t}\n750\t\n751\t#[unsafe(no_mangle)]\n752\tpub unsafe extern \"C\" fn stbds_hmput_key(\n753\t    a: *mut c_void,\n754\t    elemsize: usize,\n755\t    key: *mut c_void,\n756\t    keysize: usize,\n757\t    mode: c_int,\n758\t) -> *mut c_void {\n759\t    let keyoffset: usize = 0;\n760\t    let mut raw_a: *mut c_void;\n761\t    let mut table: *mut stbds_hash_index;\n762\t    let mut a = a;\n763\t\n764\t    if a.is_null() {\n765\t        a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n766\t        memset(a, 0, elemsize);\n767\t        (*stbds_header(a)).length += 1;\n768\t        a = STBDS_ARR_TO_HASH(a, elemsize);\n769\t    }\n770\t\n771\t    raw_a = a;\n772\t    a = STBDS_HASH_TO_ARR(a, elemsize);\n773\t\n774\t    table = (*stbds_header(a)).hash_table as *mut stbds_hash_index;\n775\t\n776\t    if table.is_null() || (*table).used_count >= (*table).used_count_threshold {\n777\t        let nt: *mut stbds_hash_index;\n778\t        let slot_count: usize;\n779\t\n780\t        slot_count = if table.is_null() {\n781\t            STBDS_BUCKET_LENGTH\n782\t        } else {\n783\t            (*table).slot_count.wrapping_mul(2)\n784\t        };\n785\t        nt = stbds_make_hash_index(slot_count, table);\n786\t        if !table.is_null() {\n787\t            free(table as *mut c_void);\n788\t        } else {\n789\t            (*nt).string.mode = if mode >= STBDS_HM_STRING {\n790\t                STBDS_SH_DEFAULT as u8\n791\t    