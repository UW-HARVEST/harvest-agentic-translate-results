 a no-op)\" \\","+  's/if (from < orig_len) \\&\\& from > 0 {/if (from <= orig_len) \\&\\& from > 0 {/'","+"," echo \"-----\"","-[ $rc -eq 0 ] && echo \"SELF-CHECK OK: every mutation was killed.\" || echo \"SELF-CHECK FAILED\"","+if [ $rc -eq 0 ]; then echo \"SELF-CHECK OK: every KILL mutation was detected, every EQUIV mutation survived.\"","+else echo \"SELF-CHECK FAILED\"; fi"," exit $rc"]}],"originalFile":"#!/usr/bin/env bash\n# Harness self-check: prove the differential tests actually DETECT divergence.\n#\n# Each mutation deliberately breaks the Rust translation in one place, builds it\n# as a standalone cdylib, and re-runs the differential suite with\n# RUST_DRIVER_SO pointing at the mutant. Every mutation MUST make at least one\n# test fail; if a mutation survives, the suite has a blind spot.\nset -u\nHERE=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nWORK=\"${TMPDIR:-/tmp}/sar-mutants\"\nrm -rf \"$WORK\"; mkdir -p \"$WORK/src\"\nsed '/^\\[dev-dependencies\\]$/,/^$/d' \"$HERE/Cargo.toml\" > \"$WORK/Cargo.toml\"\n\nrun_mutation() { # $1 = name, $2.. = sed expressions\n  local name=\"$1\"; shift\n  cp \"$HERE/src/lib.rs\" \"$WORK/src/lib.rs\"\n  for e in \"$@\"; do sed -i \"$e\" \"$WORK/src/lib.rs\"; done\n  if cmp -s \"$HERE/src/lib.rs\" \"$WORK/src/lib.rs\"; then\n    echo \"MUTATION '$name': sed did not change anything -- BAD MUTATION SPEC\"; return 2\n  fi\n  ( cd \"$WORK\" && cargo build --release --offline >/dev/null 2>&1 ) || {\n    echo \"MUTATION '$name': mutant failed to compile -- skipped\"; return 2; }\n  local out\n  out=$(cd \"$HERE\" && RUST_DRIVER_SO=\"$WORK/target/release/libdriver.so\" \\\n        timeout 600 cargo test --release --offline -- --test-threads=1 2>&1)\n  local failed\n  failed=$(printf '%s\\n' \"$out\" | grep -c '^test .* FAILED$')\n  if [ \"$failed\" -gt 0 ]; then\n    echo \"MUTATION '$name': KILLED ($failed failing tests) -- e.g. $(printf '%s\\n' \"$out\" | grep '^test .* FAILED$' | head -3 | tr '\\n' ' ')\"\n    return 0\n  else\n    echo \"MUTATION '$name': *** SURVIVED *** -- the suite has a blind spot!\"\n    return 1\n  fi\n}\n\nrc=0\nrun_mutation \"leading-copy guard: inx_start > 0  =>  inx_start > 1\" \\\n  's/if inx_start > 0 {/if inx_start > 1 {/' || rc=1\nrun_mutation \"gap guard: inx_start2 > from  =>  inx_start2 >= from\" \\\n  's/if inx_start2 > from {/if inx_start2 >= from {/' || rc=1\nrun_mutation \"tail guard: drop the (buggy but real) from > 0 term\" \\\n  's/if (from < orig_len) \\&\\& from > 0 {/if from < orig_len {/' || rc=1\nrun_mutation \"tail guard: from < orig_len  =>  from <= orig_len\" \\\n  's/if (from < orig_len) \\&\\& from > 0 {/if (from <= orig_len) \\&\\& from > 0 {/' || rc=1\nrun_mutation \"rescan overlapping: orig+inx_start+search_len => orig+inx_start+1\" \\\n  's/orig\\.add(inx_start + search_len), search/orig.add(inx_start + 1), search/' || rc=1\nrun_mutation \"strstr: empty needle returns NULL instead of haystack\" \\\n  's/^        return haystack;$/        return ptr::null();/' || rc=1\nrun_mutation \"strncpy: skip the NUL padding (raw memcpy semantics)\" \\\n  's/^    while i < n {$/    while false \\&\\& i < n {/' || rc=1\nrun_mutation \"no-match path: return empty string instead of strdup(orig)\" \\\n  's/tmp = unsafe { strdup(orig) };/tmp = unsafe { strdup(c\"\".as_ptr()) };/' || rc=1\nrun_mutation \"add a NULL-check the C does not have\" \\\n  's|^    let mut p: \\*const c_char;$|    if orig.is_null() \\|\\| search.is_null() \\|\\| value.is_null() { return ptr::null_mut(); }\\n    let mut p: *const c_char;|' || rc=1\nrun_mutation \"off-by-one: total_bytes_allocated starts at 2\" \\\n  's/let mut total_bytes_allocated: usize = 1;/let mut total_bytes_allocated: usize = 2;/' || rc=1\nrun_mutation \"inx_start not advanced on later matches\" \\\n  's/^            inx_start = inx_start2;$/            inx_start = inx_start;/' || rc=1\n\necho \"-----\"\n[ $rc -eq 0 ] && echo \"SELF-CHECK OK: every mutation was killed.\" || echo \"SELF-CHECK FAILED\"\nexit $rc\n","userModified":false}}
