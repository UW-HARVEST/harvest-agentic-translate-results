 3, b\\'v\\');')\ns = s.replace('let v = big_buf(8 * 1024 * 1024, b\\'v\\');',\n              'let v = big_buf((big / 24).max(1024 * 1024), b\\'v\\');')\ns = s.replace('Vec::with_capacity(BIG + 8)', 'Vec::with_capacity(big + 8)')\ns = s.replace(\"std::iter::repeat(b'y').take(BIG)\", \"std::iter::repeat(b'y').take(big)\")\n\n# forward tunables to children\ns = s.replace('''        .env(\"RUST_BACKTRACE\", \"0\")''',\n'''        .env(\"RUST_BACKTRACE\", \"0\")\n        .env(\"SR_BIG_MB\", big_mb().to_string())\n        .env(\"SR_ULIMIT_MB\", ulimit_mb().to_string())''')\n\n# marker parsing: libtest prefixes the line with \"test child_dispatch ... \"\ns = s.replace('''    let result = out\n        .lines()\n        .find(|l| l.trim_start().starts_with(MARKER))\n        .map(|l| l.trim().to_string());''',\n'''    // libtest with --nocapture prefixes the first captured line with\n    // \"test child_dispatch ... \", so look for the marker anywhere in the line.\n    let result = out\n        .lines()\n        .filter_map(|l| l.find(MARKER).map(|i| l[i..].trim().to_string()))\n        .next();\n    let _ = &err;''')\n\ns = s.replace('''fn assert_returns_null(row: &str, scenario: &str) {\n    let o = assert_children_agree(row, scenario, Some(ULIMIT_KB), Duration::from_secs(120));''',\n'''fn assert_returns_null(row: &str, scenario: &str) {\n    let kb = (ulimit_mb() * 1024) as u64;\n    let o = assert_children_agree(row, scenario, Some(kb), Duration::from_secs(180));''')\ns = s.replace('''        \"[{row}] `{scenario}`: expected a NULL return under ulimit -v {ULIMIT_KB}, got {o:?}\"''',\n'''        \"[{row}] `{scenario}`: expected a NULL return under ulimit -v {kb}, got {o:?}\"''')\nopen(p,'w').write(s)\nPY\ngrep -n \"BIG\\|ULIMIT_KB\" tests/phase_c_errors.rs; timeout 300 cargo check --offline --release --tests 2>&1 | tail -20","description":"Make OOM scenario sizes env-tunable and fix marker parsing"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"i