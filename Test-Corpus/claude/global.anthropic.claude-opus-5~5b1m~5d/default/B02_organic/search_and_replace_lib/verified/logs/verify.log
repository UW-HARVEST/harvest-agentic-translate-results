 *before* writing it (loses the terminator that the\n#    C's padding behaviour guarantees).\nmutate \"strncpy skips NUL write\" \"c7 c9 c19 c24 c29 e14\" \\\n  '        let ch = unsafe { *src.add(i) };\n        unsafe { *dst.add(i) = ch };\n        if ch == 0 {\n            break;\n        }' \\\n  '        let ch = unsafe { *src.add(i) };\n        if ch == 0 {\n            break;\n        }\n        unsafe { *dst.add(i) = ch };'\n\n# 8. prefix guard flipped: skip copying the text before the first match.\nmutate \"prefix copy skipped\" \"c10 c11 c28 c29\" \\\n  'unsafe { c_strncpy(tmp, orig, inx_start) };' \\\n  'unsafe { c_strncpy(tmp, orig, 0) };'\n\nrestore\ntrap - EXIT\necho \"==================================================================\"\nif [ \"$fail\" -eq 0 ]; then\n  echo \"ALL MUTATIONS DETECTED (the suite is not vacuous)\"\nelse\n  echo \"SOME MUTATIONS WERE NOT DETECTED\"\nfi\nexit \"$fail\"\n","structuredPatch":[],"originalFile":null,"userModified":false}}
