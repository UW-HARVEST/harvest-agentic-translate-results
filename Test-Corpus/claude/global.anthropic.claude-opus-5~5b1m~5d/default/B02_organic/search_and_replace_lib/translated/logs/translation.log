earchAndReplace\");\n    fn_t r = (fn_t)dlsym(hr, \"searchAndReplace\");\n    if (!c || !r) { printf(\"dlsym failed\\n\"); return 2; }\n\n    const char *origs[] = {\n        \"\", \"a\", \"aa\", \"aaa\", \"aaaa\", \"abc\", \"abcabc\", \"abcabcabc\",\n        \"xxabcyyabczz\", \"abcxx\", \"xxabc\", \"hello world\", \"hello hello hello\",\n        \"the quick brown fox jumps over the lazy dog\",\n        \"aXbXcXd\", \"XXXX\", \"XaX\", \"aXX\", \"XXa\",\n        \"banana\", \"bananana\", \"mississippi\", \"aaabaaabaaa\",\n        \"foo.bar.baz\", \"  spaced  out  \", \"\\t\\n\\r\", \"abab\", \"ababab\",\n        \"long_string_with_many_needles_needle_needle_and_needle_end\",\n        \"needle\", \"needleneedle\", \"needleXneedle\", \"Xneedle\", \"needleX\",\n    };\n    const char *pats[] = {\n        \"a\", \"aa\", \"aaa\", \"b\", \"abc\", \"ab\", \"bc\", \"c\", \"X\", \"XX\", \"XXX\",\n        \"hello\", \"hello \", \"the\", \"o\", \"ana\", \"ss\", \"iss\", \"issi\", \".\",\n        \"needle\", \"zzz\", \"banana\", \"mississippi\", \"  \", \"\\t\", \"\\n\",\n        \"long\", \"end\", \"abab\",\n    };\n    const char *vals[] = {\n        \"\", \"Q\", \"QQ\", \"ab\", \"abc\", \"[REPLACED]\", \"a\", \"X\", \"XY\",\n        \"0123456789\", \"\\t\", \"\\n\", \"needle\", \"aa\",\n    };\n\n    size_t no = sizeof(origs)/sizeof(*origs);\n    size_t np = sizeof(pats)/sizeof(*pats);\n    size_t nv = sizeof(vals)/sizeof(*vals);\n\n    for (size_t i = 0; i < no; i++)\n        for (size_t j = 0; j < np; j++)\n            for (size_t k = 0; k < nv; k++)\n                cmp(c, r, origs[i], pats[j], vals[k]);\n\n    /* Randomised fuzz over a tiny alphabet to hit overlaps/adjacency hard. */\n    const char alpha[] = \"aab\";\n    srand(12345);\n    char o[64], s[8], v[8];\n    for (int t = 0; t < 300000; t++) {\n        int ol = rand() % 24, sl = 1 + rand() % 4, vl = rand() % 5;\n        for (int i = 0; i < ol; i++) o[i] = alpha[rand() % 3];\n        o[ol] = 0;\n        for (int