(a, (*bucket).index[i]);\n891\t                            if mode >= STBDS_HM_STRING {\n892\t                                let kp = byte_add(\n893\t                                    raw_a,\n894\t                                    elemsize\n895\t                                        .wrapping_mul((*bucket).index[i] as usize)\n896\t                                        .wrapping_add(keyoffset),\n897\t                                ) as *mut *mut c_char;\n898\t                                set_stbds_temp_key(a, *kp);\n899\t                            }\n900\t                            return stbds_arr_to_hash(a, elemsize);\n901\t                        }\n902\t                    } else if (*bucket).hash[i] == 0 {\n903\t                        pos = (pos & !STBDS_BUCKET_MASK) + i;\n904\t                        break 'found_empty_slot;\n905\t                    } else if tombstone < 0 {\n906\t                        if (*bucket).index[i] == STBDS_INDEX_DELETED {\n907\t                            tombstone = ((pos & !STBDS_BUCKET_MASK) + i) as isize;\n908\t                        }\n909\t                    }\n910\t                    i += 1;\n911\t                }\n912\t\n913\t                let limit = pos & STBDS_BUCKET_MASK;\n914\t                let mut i: usize = 0;\n915\t                while i < limit {\n916\t                    if (*bucket).hash[i] == hash {\n917\t                        if stbds_is_key_equal(\n918\t                            raw_a,\n919\t                            elemsize,\n920\t                            key,\n921\t                            keysize,\n922\t                            keyoffset,\n923\t                            mode,\n924\t                            (*bucket).index[i] as usize,\n925\t                        ) != 0\n926\t                        {\n927\t                            set_stbds_temp(a, (*bucket).index[i]);\n928\t                            return stbds_arr_to_hash(a, elemsize);\n929\t          