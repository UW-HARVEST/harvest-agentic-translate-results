{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01YAnrSQBmktb5kuQvZVyT5j","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (stb_ds.h based dynamic array /\n2\t//! hash map implementation plus the small `strkey` / `arr_ins` helpers).\n3\t//!\n4\t//! The translation is byte-for-byte behaviour compatible with the C original:\n5\t//!\n6\t//! * every memory block keeps the exact same layout (the public C header macros\n7\t//!   poke directly at `stbds_array_header`, so the header must stay 32 bytes with\n8\t//!   the same field order),\n9\t//! * every allocation goes through libc `realloc`/`free` so that blocks created\n10\t//!   here can be released by the C macros (`arrfree`, ...) and vice versa,\n11\t//! * all integer arithmetic reproduces the C semantics exactly, including the\n12\t//!   sign-extension quirks of `d[3] << 24` in the siphash loader, the\n13\t//!   `hash ^= hash ^ ROTR(...)` no-ops and the wrap-around behaviour.\n14\t//!\n15\t//! No bugs of the original were fixed.\n16\t\n17\t#![allow(non_camel_case_types)]\n18\t#![allow(non_upper_case_globals)]\n19\t#![allow(clippy::missing_safety_doc)]\n20\t\n21\tuse core::ffi::{c_char, c_int, c_void};\n22\tuse core::mem::size_of;\n23\tuse core::ptr;\n24\t\n25\t// ---------------------------------------------------------------------------\n26\t// libc bindings\n27\t// ---------------------------------------------------------------------------\n28\t\n29\tunsafe extern \"C\" {\n30\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n31\t    fn free(p: *mut c_void);\n32\t    fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n33\t    fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n34\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n35\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n36\t    fn strlen(s: *const c_char) -> usize;\n37\t}\n38\t\n39\t/// `STBDS_REALLOC(c,p,s)` -> `realloc(p,s)` for a **runtime** pointer.\n40\t///\n41\t/// This mirrors `lib.c:297`, the only site where the C passes a value the\n42\t/// compiler cannot fold: `STBDS_REALLOC(NULL, (a) ? stbds_header(a) : 0, ...)`.\n43\t/// gcc therefore emits a real `realloc` call even when `a` happens to be NULL.\n44\t/// The `black_box` stops LLVM from path-splitting the `a == NULL` branch into a\n45\t/// bare `malloc`, so the allocation-call sequence stays identical (see\n46\t/// `tools/check_alloc_trace.sh`).\n47\t#[inline(always)]\n48\tunsafe fn stbds_realloc(p: *mut c_void, s: usize) -> *mut c_void {\n49\t    unsafe { realloc(core::hint::black_box(p), s) }\n50\t}\n51\t\n52\t/// `STBDS_REALLOC(NULL, 0, s)` — the C's *literal*-NULL form\n53\t/// (`lib.c:388`, `873`, `894`, `906`). A C compiler folds this to `malloc(s)`;\n54\t/// letting LLVM do the same keeps the two allocation traces in lock-step.\n55\t#[inline(always)]\n56\tunsafe fn stbds_realloc_fresh(s: usize) -> *mut c_void {\n57\t    unsafe { realloc(ptr::null_mut(), s) }\n58\t}\n59\t\n60\t/// `STBDS_FREE(c,p)` -> `free(p)`\n61\t#[inline(always)]\n62\tunsafe fn stbds_free(p: *mut c_void) {\n63\t    unsafe { free(p) }\n64\t}\n65\t\n66\t#[inline(always)]\n67\tunsafe fn c_memset(dst: *mut c_void, val: u8, n: usize) {\n68\t    unsafe { ptr::write_bytes(dst as *mut u8, val, n) }\n69\t}\n70\t\n71\t/// `*(void **) addr = value`, with C semantics.\n72\t///\n73\t/// The C never null-checks before storing through a `realloc` result, so a\n74\t/// failed allocation faults on the store. Going through libc `memcpy` keeps that\n75\t/// behaviour byte-for-byte in *both* Rust profiles: a plain `(*p).field = v`\n76\t/// would trip the debug-profile null/alignment UB check and abort instead of\n77\t/// faulting.\n78\t#[inline(always)]\n79\tunsafe fn raw_store_ptr<T>(addr: usize, value: *mut T) {\n80\t    unsafe {\n81\t        let v = value;\n82\t        memcpy(\n83\t            addr as *mut c_void,\n84\t            &v as *const *mut T as *const c_void,\n85\t            size_of::<*mut T>(),\n86\t        );\n87\t    }\n88\t}\n89\t\n90\t/// `*(void **) addr`, with C semantics (see `raw_store_ptr`).\n91\t#[inline(always)]\n92\tunsafe fn raw_load_ptr<T>(addr: usize) -> *mut T {\n93\t    unsafe {\n94\t        let mut v: *mut T = ptr::null_mut();\n95\t        memcpy(\n96\t            &mut v as *mut *mut T as *mut c_void,\n97\t            addr as *const c_void,\n98\t            size_of::<*mut T>(),\n99\t        );\n100\t        v\n101\t    }\n102\t}\n103\t\n104\t// ---------------------------------------------------------------------------\n105\t// Data layout (must match the C structures bit for bit)\n106\t// ---------------------------------------------------------------------------\n107\t\n108\t#[repr(C)]\n109\tstruct stbds_array_header {\n110\t    length: usize,\n111\t    capacity: usize,\n112\t    hash_table: *mut c_void,\n113\t    temp: isize,\n114\t}\n115\t\n116\t#[repr(C)]\n117\tstruct stbds_string_block {\n118\t    next: *mut stbds_string_block,\n119\t    storage: [c_char; 8],\n120\t}\n121\t\n122\t#[repr(C)]\n123\t#[derive(Clone, Copy)]\n124\tpub struct stbds_string_arena {\n125\t    storage: *mut stbds_string_block,\n126\t    remaining: usize,\n127\t    block: u8,\n128\t    mode: u8,\n129\t}\n130\t\n131\tconst STBDS_BUCKET_LENGTH: usize = 8;\n132\tconst STBDS_BUCKET_SHIFT: usize = 3;\n133\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n134\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n135\t\n136\t#[repr(C)]\n137\tstruct stbds_hash_bucket {\n138\t    hash: [usize; STBDS_BUCKET_LENGTH],\n139\t    index: [isize; STBDS_BUCKET_LENGTH],\n140\t}\n141\t\n142\t#[repr(C)]\n143\tstruct stbds_hash_index {\n144\t    temp_key: *mut c_char,\n145\t    slot_count: usize,\n146\t    used_count: usize,\n147\t    used_count_threshold: usize,\n148\t    used_count_shrink_threshold: usize,\n149\t    tombstone_count: usize,\n150\t    tombstone_count_threshold: usize,\n151\t    seed: usize,\n152\t    slot_count_log2: usize,\n153\t    string: stbds_string_arena,\n154\t    storage: *mut stbds_hash_bucket,\n155\t}\n156\t\n157\tconst STBDS_INDEX_EMPTY: isize = -1;\n158\tconst STBDS_INDEX_DELETED: isize = -2;\n159\t\n160\tconst STBDS_HASH_EMPTY: usize = 0;\n161\tconst STBDS_HASH_DELETED: usize = 1;\n162\t\n163\t#[allow(dead_code)]\n164\tconst STBDS_HM_BINARY: c_int = 0;\n165\tconst STBDS_HM_STRING: c_int = 1;\n166\t\n167\tconst STBDS_SH_NONE: u8 = 0;\n168\tconst STBDS_SH_DEFAULT: u8 = 1;\n169\tconst STBDS_SH_STRDUP: u8 = 2;\n170\tconst STBDS_SH_ARENA: u8 = 3;\n171\t\n172\tconst STBDS_SIZE_T_BITS: u32 = (size_of::<usize>() * 8) as u32;\n173\t\n174\tconst HEADER_SIZE: usize = size_of::<stbds_array_header>();\n175\t\n176\t// Compile time layout checks mirroring the C struct sizes on LP64.\n177\tconst _: () = assert!(size_of::<stbds_array_header>() == 32);\n178\tconst _: () = assert!(size_of::<stbds_string_block>() == 16);\n179\tconst _: () = assert!(size_of::<stbds_string_arena>() == 24);\n180\tconst _: () = assert!(size_of::<stbds_hash_bucket>() == 128);\n181\tconst _: () = assert!(size_of::<stbds_hash_index>() == 104);\n182\tconst _: () = assert!(size_of::<usize>() == 8, \"siphash 2-4 requires a 64 bit build\");\n183\t\n184\t// ---------------------------------------------------------------------------\n185\t// pointer / accessor helpers (all plain address arithmetic, like the C macros)\n186\t// ---------------------------------------------------------------------------\n187\t\n188\t/// `stbds_header(t)` == `((stbds_array_header *) (t) - 1)`\n189\t#[inline(always)]\n190\tfn stbds_header(t: *const c_void) -> *mut stbds_array_header {\n191\t    (t as usize).wrapping_sub(HEADER_SIZE) as *mut stbds_array_header\n192\t}\n193\t\n194\t/// `(char *) p + n`\n195\t#[inline(always)]\n196\tfn byte_add(p: *const c_void, n: usize) -> *mut c_void {\n197\t    (p as usize).wrapping_add(n) as *mut c_void\n198\t}\n199\t\n200\t/// `(char *) p - n`\n201\t#[inline(always)]\n202\tfn byte_sub(p: *const c_void, n: usize) -> *mut c_void {\n203\t    (p as usize).wrapping_sub(n) as *mut c_void\n204\t}\n205\t\n206\t/// `STBDS_HASH_TO_ARR(x,elemsize)`\n207\t#[inline(always)]\n208\tfn stbds_hash_to_arr(x: *const c_void, elemsize: usize) -> *mut c_void {\n209\t    byte_sub(x, elemsize)\n210\t}\n211\t\n212\t/// `STBDS_ARR_TO_HASH(x,elemsize)`\n213\t#[inline(always)]\n214\tfn stbds_arr_to_hash(x: *const c_void, elemsize: usize) -> *mut c_void {\n215\t    byte_add(x, elemsize)\n216\t}\n217\t\n218\t/// `stbds_arrlen(a)`\n219\t#[inline(always)]\n220\tunsafe fn stbds_arrlen(a: *const c_void) -> isize {\n221\t    if !a.is_null() {\n222\t        unsafe { (*stbds_header(a)).length as isize }\n223\t    } else {\n224\t        0\n225\t    }\n226\t}\n227\t\n228\t/// `stbds_arrcap(a)`\n229\t#[inline(always)]\n230\tunsafe fn stbds_arrcap(a: *const c_void) -> usize {\n231\t    if !a.is_null() {\n232\t        unsafe { (*stbds_header(a)).capacity }\n233\t    } else {\n234\t        0\n235\t    }\n236\t}\n237\t\n238\t/// `stbds_temp(t) = v`\n239\t#[inline(always)]\n240\tunsafe fn set_stbds_temp(t: *const c_void, v: isize) {\n241\t    unsafe { (*stbds_header(t)).temp = v }\n242\t}\n243\t\n244\t/// `stbds_temp_key(t) = v`  (`*(char **) stbds_header(t)->hash_table`)\n245\t#[inline(always)]\n246\tunsafe fn set_stbds_temp_key(t: *const c_void, v: *mut c_char) {\n247\t    unsafe {\n248\t        let table = (*stbds_header(t)).hash_table as *mut *mut c_char;\n249\t        *table = v;\n250\t    }\n251\t}\n252\t\n253\t/// `stbds_hash_table(a)`\n254\t#[inline(always)]\n255\tunsafe fn stbds_hash_table(a: *const c_void) -> *mut stbds_hash_index {\n256\t    unsafe { (*stbds_header(a)).hash_table as *mut stbds_hash_index }\n257\t}\n258\t\n259\t/// `STBDS_ROTATE_LEFT(val, n)`\n260\t#[inline(always)]\n261\tfn rotate_left(val: usize, n: u32) -> usize {\n262\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n263\t}\n264\t\n265\t/// `STBDS_ROTATE_RIGHT(val, n)`\n266\t#[inline(always)]\n267\tfn rotate_right(val: usize, n: u32) -> usize {\n268\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n269\t}\n270\t\n271\t/// `STBDS_ALIGN_FWD(n,a)`\n272\t#[inline(always)]\n273\tfn align_fwd(n: usize, a: usize) -> usize {\n274\t    n.wrapping_add(a - 1) & !(a - 1)\n275\t}\n276\t\n277\t// ---------------------------------------------------------------------------\n278\t// dynamic array growth\n279\t// ---------------------------------------------------------------------------\n280\t\n281\t#[unsafe(no_mangle)]\n282\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n283\t    a: *mut c_void,\n284\t    elemsize: usize,\n285\t    addlen: usize,\n286\t    min_cap: usize,\n287\t) -> *mut c_void {\n288\t    unsafe {\n289\t        let mut min_cap = min_cap;\n290\t        let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n291\t\n292\t        if min_len > min_cap {\n293\t            min_cap = min_len;\n294\t        }\n295\t\n296\t        if min_cap <= stbds_arrcap(a) {\n297\t            return a;\n298\t        }\n299\t\n300\t        if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n301\t            min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n302\t        } else if min_cap < 4 {\n303\t            min_cap = 4;\n304\t        }\n305\t\n306\t        let old = if !a.is_null() {\n307\t            stbds_header(a) as *mut c_void\n308\t        } else {\n309\t            ptr::null_mut()\n310\t        };\n311\t        let b = stbds_realloc(\n312\t            old,\n313\t            elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n314\t        );\n315\t        let b = byte_add(b, HEADER_SIZE);\n316\t        if a.is_null() {\n317\t            (*stbds_header(b)).length = 0;\n318\t            (*stbds_header(b)).hash_table = ptr::null_mut();\n319\t            (*stbds_header(b)).temp = 0;\n320\t        }\n321\t        (*stbds_header(b)).capacity = min_cap;\n322\t\n323\t        b\n324\t    }\n325\t}\n326\t\n327\t#[unsafe(no_mangle)]\n328\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n329\t    unsafe { stbds_free(stbds_header(a) as *mut c_void) }\n330\t}\n331\t\n332\t// ---------------------------------------------------------------------------\n333\t// hash index\n334\t// ---------------------------------------------------------------------------\n335\t\n336\tstatic mut stbds_hash_seed: usize = 0x31415926;\n337\t\n338\t#[unsafe(no_mangle)]\n339\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n340\t    unsafe { stbds_hash_seed = seed }\n341\t}\n342\t\n343\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n344\t    hash & (slot_count.wrapping_sub(1))\n345\t}\n346\t\n347\tfn stbds_log2(slot_count: usize) -> usize {\n348\t    let mut slot_count = slot_count;\n349\t    let mut n: usize = 0;\n350\t    while slot_count > 1 {\n351\t        slot_count >>= 1;\n352\t        n += 1;\n353\t    }\n354\t    n\n355\t}\n356\t\n357\t/// `stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)`\n358\t#[inline(always)]\n359\tfn stbds_load_32_or_64(v32: usize, v64_hi: usize, v64_lo: usize) -> usize {\n360\t    let mut temp: usize;\n361\t    let mut var: usize;\n362\t    temp = v64_lo ^ v32;\n363\t    temp <<= 16;\n364\t    temp <<= 16;\n365\t    temp >>= 16;\n366\t    temp >>= 16;\n367\t    var = v64_hi;\n368\t    var <<= 16;\n369\t    var <<= 16;\n370\t    var ^= temp ^ v32;\n371\t    var\n372\t}\n373\t\n374\tunsafe fn stbds_make_hash_index(\n375\t    slot_count: usize,\n376\t    ot: *mut stbds_hash_index,\n377\t) -> *mut stbds_hash_index {\n378\t    unsafe {\n379\t        let t = stbds_realloc_fresh(\n380\t            (slot_count >> STBDS_BUCKET_SHIFT)\n381\t                .wrapping_mul(size_of::<stbds_hash_bucket>())\n382\t                .wrapping_add(size_of::<stbds_hash_index>())\n383\t                .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n384\t        ) as *mut stbds_hash_index;\n385\t\n386\t        (*t).storage = align_fwd(\n387\t            (t as usize).wrapping_add(size_of::<stbds_hash_index>()),\n388\t            STBDS_CACHE_LINE_SIZE,\n389\t        ) as *mut stbds_hash_bucket;\n390\t        (*t).slot_count = slot_count;\n391\t        (*t).slot_count_log2 = stbds_log2(slot_count);\n392\t        (*t).tombstone_count = 0;\n393\t        (*t).used_count = 0;\n394\t\n395\t        (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n396\t        (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n397\t        (*t).used_count_shrink_threshold = slot_count >> 2;\n398\t\n399\t        if slot_count <= STBDS_BUCKET_LENGTH {\n400\t            (*t).used_count_shrink_threshold = 0;\n401\t        }\n402\t        assert!(\n403\t            (*t)\n404\t                .used_count_threshold\n405\t                .wrapping_add((*t).tombstone_count_threshold)\n406\t                < (*t).slot_count\n407\t        );\n408\t\n409\t        if !ot.is_null() {\n410\t            (*t).string = (*ot).string;\n411\t            (*t).seed = (*ot).seed;\n412\t        } else {\n413\t            c_memset(\n414\t                &mut (*t).string as *mut stbds_string_arena as *mut c_void,\n415\t                0,\n416\t                size_of::<stbds_string_arena>(),\n417\t            );\n418\t            (*t).seed = stbds_hash_seed;\n419\t            let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n420\t            let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n421\t            stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n422\t        }\n423\t\n424\t        {\n425\t            let mut i: usize = 0;\n426\t            while i < slot_count >> STBDS_BUCKET_SHIFT {\n427\t                let b = (*t).storage.add(i);\n428\t                for j in 0..STBDS_BUCKET_LENGTH {\n429\t                    (*b).hash[j] = STBDS_HASH_EMPTY;\n430\t                }\n431\t                for j in 0..STBDS_BUCKET_LENGTH {\n432\t                    (*b).index[j] = STBDS_INDEX_EMPTY;\n433\t                }\n434\t                i += 1;\n435\t            }\n436\t        }\n437\t\n438\t        if !ot.is_null() {\n439\t            (*t).used_count = (*ot).used_count;\n440\t            let mut i: usize = 0;\n441\t            while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n442\t                let ob = (*ot).storage.add(i);\n443\t                for j in 0..STBDS_BUCKET_LENGTH {\n444\t                    if (*ob).index[j] >= 0 {\n445\t                        let hash = (*ob).hash[j];\n446\t                        let mut pos =\n447\t                            stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n448\t                        let mut step = STBDS_BUCKET_LENGTH;\n449\t                        'probe: loop {\n450\t                            let bucket = (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n451\t\n452\t                            let mut z = pos & STBDS_BUCKET_MASK;\n453\t                            while z < STBDS_BUCKET_LENGTH {\n454\t                                if (*bucket).hash[z] == 0 {\n455\t                                    (*bucket).hash[z] = hash;\n456\t                                    (*bucket).index[z] = (*ob).index[j];\n457\t                                    break 'probe;\n458\t                                }\n459\t                                z += 1;\n460\t                            }\n461\t\n462\t                            let limit = pos & STBDS_BUCKET_MASK;\n463\t                            for z in 0..limit {\n464\t                                if (*bucket).hash[z] == 0 {\n465\t                                    (*bucket).hash[z] = hash;\n466\t                                    (*bucket).index[z] = (*ob).index[j];\n467\t                                    break 'probe;\n468\t                                }\n469\t                            }\n470\t\n471\t                            pos = pos.wrapping_add(step);\n472\t                            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n473\t                            pos &= (*t).slot_count.wrapping_sub(1);\n474\t                        }\n475\t                    }\n476\t                }\n477\t                i += 1;\n478\t            }\n479\t        }\n480\t\n481\t        t\n482\t    }\n483\t}\n484\t\n485\t// ---------------------------------------------------------------------------\n486\t// hashing\n487\t// ---------------------------------------------------------------------------\n488\t\n489\t#[unsafe(no_mangle)]\n490\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n491\t    unsafe {\n492\t        let mut str_ = str_;\n493\t        let mut hash = seed;\n494\t        while *str_ != 0 {\n495\t            let c = *str_ as u8 as usize;\n496\t            hash = rotate_left(hash, 9).wrapping_add(c);\n497\t            str_ = str_.add(1);\n498\t        }\n499\t\n500\t        hash ^= seed;\n501\t        hash = (!hash).wrapping_add(hash << 18);\n502\t        hash ^= hash ^ rotate_right(hash, 31);\n503\t        hash = hash.wrapping_mul(21);\n504\t        hash ^= hash ^ rotate_right(hash, 11);\n505\t        hash = hash.wrapping_add(hash << 6);\n506\t        hash ^= rotate_right(hash, 22);\n507\t        hash.wrapping_add(seed)\n508\t    }\n509\t}\n510\t\n511\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n512\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n513\t\n514\t#[inline(always)]\n515\tfn siphash_round(v0: &mut usize, v1: &mut usize, v2: &mut usize, v3: &mut usize) {\n516\t    *v0 = v0.wrapping_add(*v1);\n517\t    *v1 = rotate_left(*v1, 13);\n518\t    *v1 ^= *v0;\n519\t    *v0 = rotate_left(*v0, STBDS_SIZE_T_BITS / 2);\n520\t    *v2 = v2.wrapping_add(*v3);\n521\t    *v3 = rotate_left(*v3, 16);\n522\t    *v3 ^= *v2;\n523\t    *v2 = v2.wrapping_add(*v1);\n524\t    *v1 = rotate_left(*v1, 17);\n525\t    *v1 ^= *v2;\n526\t    *v2 = rotate_left(*v2, STBDS_SIZE_T_BITS / 2);\n527\t    *v0 = v0.wrapping_add(*v3);\n528\t    *v3 = rotate_left(*v3, 21);\n529\t    *v3 ^= *v0;\n530\t}\n531\t\n532\t/// Reproduces `data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);` where the\n533\t/// right hand side is computed in `int` and then (possibly sign-) extended to\n534\t/// `size_t` -- for `d[3] >= 0x80` the C expression is negative and therefore sets\n535\t/// every high bit of the resulting `size_t`.\n536\t#[inline(always)]\n537\tunsafe fn load_int_le32(d: *const u8) -> usize {\n538\t    unsafe {\n539\t        let v: i32 = (*d.add(0) as i32)\n540\t            | ((*d.add(1) as i32) << 8)\n541\t            | ((*d.add(2) as i32) << 16)\n542\t            | ((*d.add(3) as i32) << 24);\n543\t        v as i64 as u64 as usize\n544\t    }\n545\t}\n546\t\n547\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n548\t    unsafe {\n549\t        let mut d = p as *const u8;\n550\t        let mut i: usize;\n551\t        let mut data: usize;\n552\t\n553\t        let mut v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n554\t        let mut v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n555\t        let mut v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n556\t        let mut v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n557\t\n558\t        v0 ^= 0x0706050403020100u64 as usize ^ seed;\n559\t        v1 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n560\t        v2 ^= 0x0706050403020100u64 as usize ^ seed;\n561\t        v3 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n562\t\n563\t        i = 0;\n564\t        while i.wrapping_add(size_of::<usize>()) <= len {\n565\t            data = load_int_le32(d);\n566\t            // discarded if size_t == 4\n567\t            data |= (load_int_le32(d.add(4)) << 16) << 16;\n568\t\n569\t            v3 ^= data;\n570\t            for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n571\t                siphash_round(&mut v0, &mut v1, &mut v2, &mut v3);\n572\t            }\n573\t            v0 ^= data;\n574\t\n575\t            i = i.wrapping_add(size_of::<usize>());\n576\t            d = d.add(size_of::<usize>());\n577\t        }\n578\t\n579\t        data = len << (STBDS_SIZE_T_BITS - 8);\n580\t        // C switch with fall-through: case k performs the work of cases k..1.\n581\t        let rem = len.wrapping_sub(i);\n582\t        if rem >= 7 {\n583\t            data |= ((*d.add(6) as usize) << 24) << 24;\n584\t        }\n585\t        if rem >= 6 {\n586\t            data |= ((*d.add(5) as usize) << 20) << 20;\n587\t        }\n588\t        if rem >= 5 {\n589\t            data |= ((*d.add(4) as usize) << 16) << 16;\n590\t        }\n591\t        if rem >= 4 {\n592\t            // int expression -> sign extended when d[3] >= 0x80\n593\t            data |= (((*d.add(3) as i32) << 24) as i64 as u64) as usize;\n594\t        }\n595\t        if rem >= 3 {\n596\t            data |= ((*d.add(2) as i32) << 16) as usize;\n597\t        }\n598\t        if rem >= 2 {\n599\t            data |= ((*d.add(1) as i32) << 8) as usize;\n600\t        }\n601\t        if rem >= 1 {\n602\t            data |= *d.add(0) as usize;\n603\t        }\n604\t\n605\t        v3 ^= data;\n606\t        for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n607\t            siphash_round(&mut v0, &mut v1, &mut v2, &mut v3);\n608\t        }\n609\t        v0 ^= data;\n610\t        v2 ^= 0xff;\n611\t        for _ in 0..STBDS_SIPHASH_D_ROUNDS {\n612\t            siphash_round(&mut v0, &mut v1, &mut v2, &mut v3);\n613\t        }\n614\t\n615\t        v0 ^ v1 ^ v2 ^ v3\n616\t    }\n617\t}\n618\t\n619\t#[unsafe(no_mangle)]\n620\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n621\t    unsafe { stbds_siphash_bytes(p, len, seed) }\n622\t}\n623\t\n624\t// ---------------------------------------------------------------------------\n625\t// hash map\n626\t// ---------------------------------------------------------------------------\n627\t\n628\tunsafe fn stbds_is_key_equal(\n629\t    a: *mut c_void,\n630\t    elemsize: usize,\n631\t    key: *mut c_void,\n632\t    keysize: usize,\n633\t    keyoffset: usize,\n634\t    mode: c_int,\n635\t    i: usize,\n636\t) -> c_int {\n637\t    unsafe {\n638\t        let slot = byte_add(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset));\n639\t        if mode >= STBDS_HM_STRING {\n640\t            (0 == strcmp(key as *const c_char, *(slot as *mut *const c_char))) as c_int\n641\t        } else {\n642\t            (0 == memcmp(key, slot, keysize)) as c_int\n643\t        }\n644\t    }\n645\t}\n646\t\n647\t#[unsafe(no_mangle)]\n648\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n649\t    unsafe {\n650\t        if a.is_null() {\n651\t            return;\n652\t        }\n653\t        if !stbds_hash_table(a).is_null() {\n654\t            if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP {\n655\t                let mut i: usize = 1;\n656\t                while i < (*stbds_header(a)).length {\n657\t                    stbds_free(*(byte_add(a, elemsize.wrapping_mul(i)) as *mut *mut c_void));\n658\t                    i += 1;\n659\t                }\n660\t            }\n661\t            stbds_strreset(&mut (*stbds_hash_table(a)).string);\n662\t        }\n663\t        stbds_free((*stbds_header(a)).hash_table);\n664\t        stbds_free(stbds_header(a) as *mut c_void);\n665\t    }\n666\t}\n667\t\n668\tunsafe fn stbds_hm_find_slot(\n669\t    a: *mut c_void,\n670\t    elemsize: usize,\n671\t    key: *mut c_void,\n672\t    keysize: usize,\n673\t    keyoffset: usize,\n674\t    mode: c_int,\n675\t) -> isize {\n676\t    unsafe {\n677\t        let raw_a = stbds_hash_to_arr(a, elemsize);\n678\t        let table = stbds_hash_table(raw_a);\n679\t        let mut hash = if mode >= STBDS_HM_STRING {\n680\t            stbds_hash_string(key as *mut c_char, (*table).seed)\n681\t        } else {\n682\t            stbds_hash_bytes(key, keysize, (*table).seed)\n683\t        };\n684\t        let mut step = STBDS_BUCKET_LENGTH;\n685\t\n686\t        if hash < 2 {\n687\t            hash = hash.wrapping_add(2);\n688\t        }\n689\t\n690\t        let mut pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n691\t\n692\t        loop {\n693\t            let bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);\n694\t\n695\t            let mut i = pos & STBDS_BUCKET_MASK;\n696\t            while i < STBDS_BUCKET_LENGTH {\n697\t                if (*bucket).hash[i] == hash {\n698\t                    if stbds_is_key_equal(\n699\t                        a,\n700\t                        elemsize,\n701\t                        key,\n702\t                        keysize,\n703\t                        keyoffset,\n704\t                        mode,\n705\t                        (*bucket).index[i] as usize,\n706\t                    ) != 0\n707\t                    {\n708\t                        return ((pos & !STBDS_BUCKET_MASK) + i) as isize;\n709\t                    }\n710\t                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n711\t                    return -1;\n712\t                }\n713\t                i += 1;\n714\t            }\n715\t\n716\t            let limit = pos & STBDS_BUCKET_MASK;\n717\t            for i in 0..limit {\n718\t                if (*bucket).hash[i] == hash {\n719\t                    if stbds_is_key_equal(\n720\t                        a,\n721\t                        elemsize,\n722\t                        key,\n723\t                        keysize,\n724\t                        keyoffset,\n725\t                        mode,\n726\t                        (*bucket).index[i] as usize,\n727\t                    ) != 0\n728\t                    {\n729\t                        return ((pos & !STBDS_BUCKET_MASK) + i) as isize;\n730\t                    }\n731\t                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n732\t                    return -1;\n733\t                }\n734\t            }\n735\t\n736\t            pos = pos.wrapping_add(step);\n737\t            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n738\t            pos &= (*table).slot_count.wrapping_sub(1);\n739\t        }\n740\t    }\n741\t}\n742\t\n743\t#[unsafe(no_mangle)]\n744\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n745\t    a: *mut c_void,\n746\t    elemsize: usize,\n747\t    key: *mut c_void,\n748\t    keysize: usize,\n749\t    temp: *mut isize,\n750\t    mode: c_int,\n751\t) -> *mut c_void {\n752\t    unsafe {\n753\t        let keyoffset: usize = 0;\n754\t        if a.is_null() {\n755\t            let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n756\t            (*stbds_header(a)).length = (*stbds_header(a)).length.wrapping_add(1);\n757\t            c_memset(a, 0, elemsize);\n758\t            *temp = STBDS_INDEX_EMPTY;\n759\t            stbds_arr_to_hash(a, elemsize)\n760\t        } else {\n761\t            let raw_a = stbds_hash_to_arr(a, elemsize);\n762\t            let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n763\t            if table.is_null() {\n764\t                *temp = -1;\n765\t            } else {\n766\t                let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n767\t                if slot < 0 {\n768\t                    *temp = STBDS_INDEX_EMPTY;\n769\t                } else {\n770\t                    let b = (*table).storage.add((slot >> STBDS_BUCKET_SHIFT) as usize);\n771\t                    *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n772\t                }\n773\t            }\n774\t            a\n775\t        }\n776\t    }\n777\t}\n778\t\n779\t#[unsafe(no_mangle)]\n780\tpub unsafe extern \"C\" fn stbds_hmget_key(\n781\t    a: *mut c_void,\n782\t    elemsize: usize,\n783\t    key: *mut c_void,\n784\t    keysize: usize,\n785\t    mode: c_int,\n786\t) -> *mut c_void {\n787\t    unsafe {\n788\t        let mut temp: isize = 0;\n789\t        let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &mut temp, mo