{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_dvsczyib7cugn2dlkvogac7pyty5472udkx53akjrffvpqoqgm7q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01T16gCtbqAEi9wbakiYK69X","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-VR2NVk/_audit_scratch/harness.c","content":"#define _GNU_SOURCE\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <dlfcn.h>\n#include <stddef.h>\n#include <stdint.h>\n#include <limits.h>\n\ntypedef struct {\n  size_t length, capacity;\n  void *hash_table;\n  ptrdiff_t temp;\n} hdr_t;\n\ntypedef struct {\n  size_t hash[8];\n  ptrdiff_t index[8];\n} bucket_t;\n\ntypedef struct { void *storage; size_t remaining; unsigned char block, mode; } arena_t;\n\ntypedef struct {\n  char *temp_key;\n  size_t slot_count, used_count, used_count_threshold, used_count_shrink_threshold;\n  size_t tombstone_count, tombstone_count_threshold, seed, slot_count_log2;\n  arena_t string;\n  bucket_t *storage;\n} hidx_t;\n\n#define HDR(p) (((hdr_t*)(p)) - 1)\n\ntypedef struct {\n  void *h;\n  const char *name;\n  void  (*rand_seed)(size_t);\n  size_t(*hash_bytes)(void*, size_t, size_t);\n  size_t(*hash_string)(char*, size_t);\n  char *(*stralloc)(arena_t*, char*);\n  void  (*strreset)(arena_t*);\n  void *(*arrgrowf)(void*, size_t, size_t, size_t);\n  void  (*arrfreef)(void*);\n  void  (*hmfree_func)(void*, size_t);\n  void *(*hmget_key)(void*, size_t, void*, size_t, int);\n  void *(*hmget_key_ts)(void*, size_t, void*, size_t, ptrdiff_t*, int);\n  void *(*hmput_default)(void*, size_t);\n  void *(*hmput_key)(void*, size_t, void*, size_t, int);\n  void *(*hmdel_key)(void*, size_t, void*, size_t, size_t, int);\n  void *(*shmode_func)(size_t, int);\n  char *(*strkey)(int);\n  void  (*arr_ins)(int);\n} lib_t;\n\nstatic int failures = 0;\n#define FAIL(fmt, ...) do { failures++; printf(\"DIVERGENCE: \" fmt \"\\n\", ##__VA_ARGS__); } while (0)\n\nstatic void load(lib_t *l, const char *path, const char *name)\n{\n  l->h = dlopen(path, RTLD_NOW | RTLD_LOCAL);\n  if (!l->h) { fprintf(stderr, \"dlopen %s: %s\\n\", path, dlerror()); exit(1); }\n  l->name = name;\n#define S(f) do { *(void**)&l->f = dlsym(l->h, \"stbds_\" #f); if (!l->f) { fprintf(stderr, \"missing stbds_%s in %s\\n\", #f, path); exit(1);} } while(0)\n  S(rand_seed); S(hash_bytes); S(hash_string); S(stralloc); S(strreset);\n  S(arrgrowf); S(arrfreef); S(hmfree_func); S(hmget_key); S(hmget_key_ts);\n  S(hmput_default); S(hmput_key); S(hmdel_key); S(shmode_func);\n#undef S\n  *(void**)&l->strkey = dlsym(l->h, \"strkey\");\n  *(void**)&l->arr_ins = dlsym(l->h, \"arr_ins\");\n  if (!l->strkey || !l->arr_ins) { fprintf(stderr, \"missing strkey/arr_ins in %s\\n\", path); exit(1); }\n}\n\nstatic uint64_t rng_state = 88172645463325252ull;\nstatic uint64_t rnd(void) {\n  rng_state ^= rng_state << 13; rng_state ^= rng_state >> 7; rng_state ^= rng_state << 17;\n  return rng_state;\n}\n\nstatic void test_hash_bytes(lib_t *A, lib_t *B)\n{\n  unsigned char buf[64];\n  size_t seeds[] = {0, 1, 2, 0x31415926, 0xffffffffffffffffull, 0x8000000000000000ull, 12345};\n  int reported = 0;\n  for (size_t len = 0; len <= 40; ++len) {\n    for (int iter = 0; iter < 300; ++iter) {\n      for (size_t k = 0; k < sizeof buf; ++k) buf[k] = (unsigned char) rnd();\n      if (iter % 3 == 0) for (size_t k = 0; k < len; ++k) buf[k] |= 0x80;\n      if (iter % 5 == 0) for (size_t k = 0; k < len; ++k) buf[k] &= 0x7f;\n      for (size_t si = 0; si < sizeof seeds/sizeof *seeds; ++si) {\n        size_t ra = A->hash_bytes(buf, len, seeds[si]);\n        size_t rb = B->hash_bytes(buf, len, seeds[si]);\n        if (ra != rb) {\n          if (reported++ < 8) {\n            printf(\"DIVERGENCE hash_bytes len=%zu seed=%#zx bytes=\", len, seeds[si]);\n            for (size_t k = 0; k < len; ++k) printf(\"%02x\", buf[k]);\n            printf(\" C=%#zx RUST=%#zx\\n\", ra, rb);\n          }\n          failures++;\n        }\n      }\n    }\n  }\n  printf(\"hash_bytes: %s\\n\", reported ? \"DIVERGES\" : \"match\");\n}\n\nstatic void test_hash_string(lib_t *A, lib_t *B)\n{\n  char buf[64];\n  size_t seeds[] = {0, 1, 0x31415926, 0xffffffffffffffffull, 999};\n  int reported = 0;\n  for (size_t len = 0; len < 40; ++len) {\n    for (int iter = 0; iter < 300; ++iter) {\n      for (size_t k = 0; k < len; ++k) {\n        unsigned char c;\n        do { c = (unsigned char) rnd(); } while (c == 0);\n        if (iter % 2 == 0) c |= 0x80;\n        buf[k] = (char) c;\n      }\n      buf[len] = 0;\n      for (size_t si = 0; si < sizeof seeds/sizeof *seeds; ++si) {\n        size_t ra = A->hash_string(buf, seeds[si]);\n        size_t rb = B->hash_string(buf, seeds[si]);\n        if (ra != rb) { if (reported++ < 8) printf(\"DIVERGENCE hash_string len=%zu seed=%#zx C=%#zx RUST=%#zx\\n\", len, seeds[si], ra, rb); failures++; }\n      }\n    }\n  }\n  printf(\"hash_string: %s\\n\", reported ? \"DIVERGES\" : \"match\");\n}\n\nstatic void test_strkey(lib_t *A, lib_t *B)\n{\n  int vals[64]; int n = 0;\n  vals[n++] = 0; vals[n++] = 1; vals[n++] = -1; vals[n++] = 9; vals[n++] = 10;\n  vals[n++] = 99; vals[n++] = 100; vals[n++] = INT_MAX; vals[n++] = INT_MIN;\n  vals[n++] = INT_MIN+1; vals[n++] = -999999999; vals[n++] = 2147483647;\n  vals[n++] = -10; vals[n++] = -100; vals[n++] = 1000000000;\n  for (int i = 0; i < 20; ++i) vals[n++] = (int) rnd();\n  int reported = 0;\n  for (int i = 0; i < n; ++i) {\n    char ca[300], cb[300], ref[300];\n    memcpy(ca, A->strkey(vals[i]), 256);\n    memcpy(cb, B->strkey(vals[i]), 256);\n    sprintf(ref, \"test_%d\", vals[i]);\n    if (strcmp(ca, ref) != 0) { printf(\"DIVERGENCE strkey C n=%d got '%s' want '%s'\\n\", vals[i], ca, ref); failures++; }\n    if (strcmp(cb, ref) != 0) { printf(\"DIVERGENCE strkey RUST n=%d got '%s' want '%s'\\n\", vals[i], cb, ref); failures++; reported++; }\n  }\n  A->strkey(-1234567890); B->strkey(-1234567890);\n  char sa[256], sb[256];\n  memcpy(sa, A->strkey(1), 256);\n  memcpy(sb, B->strkey(1), 256);\n  if (memcmp(sa, sb, 32) != 0) {\n    printf(\"DIVERGENCE strkey residual bytes:\\n  C   =\");\n    for (int k=0;k<20;k++) printf(\" %02x\", (unsigned char)sa[k]);\n    printf(\"\\n  RUST=\");\n    for (int k=0;k<20;k++) printf(\" %02x\", (unsigned char)sb[k]);\n    printf(\"\\n\"); failures++; reported++;\n  }\n  printf(\"strkey: %s\\n\", reported ? \"DIVERGES\" : \"match\");\n}\n\nstatic void test_arrgrowf(lib_t *A, lib_t *B)\n{\n  int reported = 0;\n  for (size_t elemsize = 1; elemsize <= 16; elemsize *= 2) {\n    void *a = NULL, *b = NULL;\n    for (int step = 0; step < 60; ++step) {\n      size_t addlen = (size_t)(rnd() % 5);\n      size_t mincap = (size_t)(rnd() % 9);\n      a = A->arrgrowf(a, elemsize, addlen, mincap);\n      b = B->arrgrowf(b, elemsize, addlen, mincap);\n      hdr_t *ha = HDR(a), *hb = HDR(b);\n      if (ha->length != hb->length || ha->capacity != hb->capacity ||\n          (ha->hash_table==NULL) != (hb->hash_table==NULL) || ha->temp != hb->temp) {\n        if (reported++ < 8)\n          printf(\"DIVERGENCE arrgrowf elemsize=%zu step=%d addlen=%zu mincap=%zu \"\n                 \"C{len=%zu cap=%zu temp=%td} RUST{len=%zu cap=%zu temp=%td}\\n\",\n                 elemsize, step, addlen, mincap, ha->length, ha->capacity, ha->temp,\n                 hb->length, hb->capacity, hb->temp);\n        failures++;\n      }\n      if (ha->length + 1 <= ha->capacity) { ha->length++; hb->length++; }\n    }\n    A->arrfreef(a); B->arrfreef(b);\n  }\n  printf(\"arrgrowf: %s\\n\", reported ? \"DIVERGES\" : \"match\");\n}\n\ntypedef struct { int key; int value; } kv_t;\n\nstatic int cmp_table(void *ta, void *tb, size_t elemsize, const char *what, int stepno)\n{\n  int bad = 0;\n  if ((ta == NULL) != (tb == NULL)) { FAIL(\"%s step %d: null-ness C=%p RUST=%p\", what, stepno, ta, tb); return 1; }\n  if (!ta) return 0;\n  void *ra = (char*)ta - elemsize, *rb = (char*)tb - elemsize;\n  hdr_t *ha = HDR(ra), *hb = HDR(rb);\n  if (ha->length != hb->length) { FAIL(\"%s step %d: length C=%zu RUST=%zu\", what, stepno, ha->length, hb->length); bad=1; }\n  if (ha->capacity != hb->capacity) { FAIL(\"%s step %d: capacity C=%zu RUST=%zu\", what, stepno, ha->capacity, hb->capacity); bad=1; }\n  if (ha->temp != hb->temp) { FAIL(\"%s step %d: temp C=%td RUST=%td\", what, stepno, ha->temp, hb->temp); bad=1; }\n  size_t n = ha->length < hb->length ? ha->length : hb->length;\n  if (memcmp(ra, rb, n * elemsize) != 0) {\n    FAIL(\"%s step %d: array payload differs (len=%zu)\", what, stepno, n);\n    for (size_t i = 0; i < n; ++i)\n      if (memcmp((char*)ra + i*elemsize, (char*)rb + i*elemsize, elemsize)) {\n        printf(\"   elem %zu: C=\", i);\n        for (size_t k=0;k<elemsize;k++) printf(\"%02x\", ((unsigned char*)ra)[i*elemsize+k]);\n        printf(\" RUST=\");\n        for (size_t k=0;k<elemsize;k++) printf(\"%02x\", ((unsigned char*)rb)[i*elemsize+k]);\n        printf(\"\\n\");\n      }\n    bad = 1;\n  }\n  hidx_t *ia = ha->hash_table, *ib = hb->hash_table;\n  if ((ia==NULL) != (ib==NULL)) { FAIL(\"%s step %d: hash_table nullness\", what, stepno); return 1; }\n  if (!ia) return bad;\n#define F(f) if (ia->f != ib->f) { FAIL(\"%s step %d: idx.\" #f \" C=%zu RUST=%zu\", what, stepno, (size_t)ia->f, (size_t)ib->f); bad=1; }\n  F(slot_count) F(used_count) F(used_count_threshold) F(used_count_shrink_threshold)\n  F(tombstone_count) F(tombstone_count_threshold) F(seed) F(slot_count_log2)\n#undef F\n  if (ia->string.remaining != ib->string.remaining) { FAIL(\"%s step %d: string.remaining C=%zu RUST=%zu\", what, stepno, ia->string.remaining, ib->string.remaining); bad=1; }\n  if (ia->string.block != ib->string.block) { FAIL(\"%s step %d: string.block C=%u RUST=%u\", what, stepno, ia->string.block, ib->string.block); bad=1; }\n  if (ia->string.mode != ib->string.mode) { FAIL(\"%s step %d: string.mode C=%u RUST=%u\", what, stepno, ia->string.mode, ib->string.mode); bad=1; }\n  if (ia->slot_count == ib->slot_count)\n    for (size_t i = 0; i < ia->slot_count >> 3; ++i)\n      for (int j = 0; j < 8; ++j)\n        if (ia->storage[i].hash[j] != ib->storage[i].hash[j] ||\n            ia->storage[i].index[j] != ib->storage[i].index[j]) {\n          FAIL(\"%s step %d: bucket[%zu].slot[%d] C{h=%#zx,i=%td} RUST{h=%#zx,i=%td}\",\n               what, stepno, i, j, ia->storage[i].hash[j], ia->storage[i].index[j],\n               ib->storage[i].hash[j], ib->storage[i].index[j]);\n          bad = 1;\n        }\n  if ((ia->temp_key==NULL) != (ib->temp_key==NULL)) { FAIL(\"%s step %d: temp_key nullness C=%p RUST=%p\", what, stepno, (void*)ia->temp_key, (void*)ib->temp_key); bad=1; }\n  else if (ia->temp_key && strcmp(ia->temp_key, ib->temp_key)) { FAIL(\"%s step %d: temp_key C='%s' RUST='%s'\", what, stepno, ia->temp_key, ib->temp_key); bad=1; }\n  return bad;\n}\n\nstatic void test_hm_binary(lib_t *A, lib_t *B, int nops, int keyrange, unsigned seed)\n{\n  rng_state = seed ? seed : 1;\n  A->rand_seed(0x31415926); B->rand_seed(0x31415926);\n  kv_t *ta = NULL, *tb = NULL;\n  size_t es = sizeof(kv_t);\n  int reported = 0;\n  for (int step = 0; step < nops; ++step) {\n    int op = (int)(rnd() % 10);\n    int key = (int)(rnd() % keyrange);\n    int val = (int)(rnd() & 0xffff);\n    int k = key;\n    if (op < 6) {\n      ta = A->hmput_key(ta, es, &k, sizeof(int), 0);\n      tb = B->hmput_key(tb, es, &k, sizeof(int), 0);\n      ptrdiff_t pa = HDR((char*)ta - es)->temp, pb = HDR((char*)tb - es)->temp;\n      if (pa == pb) { ta[pa].key = k; ta[pa].value = val; tb[pb].key = k; tb[pb].value = val; }\n    } else if (op < 8) {\n      ta = A->hmget_key(ta, es, &k, sizeof(int), 0);\n      tb = B->hmget_key(tb, es, &k, sizeof(int), 0);\n    } else {\n      ta = A->hmdel_key(ta, es, &k, sizeof(int), offsetof(kv_t,key), 0);\n      tb = B->hmdel_key(tb, es, &k, sizeof(int), offsetof(kv_t,key), 0);\n    }\n    if (cmp_table(ta, tb, es, \"hm_binary\", step)) { reported++; if (reported > 3) break; }\n  }\n  if (ta) A->hmfree_func((char*)ta - es, es);\n  if (tb) B->hmfree_func((char*)tb - es, es);\n  printf(\"hm_binary(seed=%u,ops=%d,range=%d): %s\\n\", seed, nops, keyrange, reported ? \"DIVERGES\" : \"match\");\n}\n\ntypedef struct { char *key; int value; } skv_t;\n\nstatic void test_hm_string(lib_t *A, lib_t *B, int shmode, int nops, int keyrange, unsigned seed)\n{\n  rng_state = seed ? seed : 1;\n  A->rand_seed(0x31415926); B->rand_seed(0x31415926);\n  size_t es = sizeof(skv_t);\n  skv_t *ta = NULL, *tb = NULL;\n  if (shmode) { ta = A->shmode_func(es, shmode); tb = B->shmode_func(es, shmode); }\n  int reported = 0;\n  static char keys[600][40];\n  for (int i = 0; i < 600; ++i) sprintf(keys[i], \"key_%d_%s\", i, (i%3)?\"x\":\"longer_padding_text\");\n  for (int step = 0; step < nops; ++step) {\n    int op = (int)(rnd() % 10);\n    int ki = (int)(rnd() % keyrange);\n    int val = (int)(rnd() & 0xffff);\n    if (op < 6) {\n      ta = A->hmput_key(ta, es, keys[ki], sizeof(char*), 1);\n      tb = B->hmput_key(tb, es, keys[ki], sizeof(char*), 1);\n      ptrdiff_t pa = HDR((char*)ta - es)->temp, pb = HDR((char*)tb - es)->temp;\n      if (pa == pb) { ta[pa].value = val; tb[pb].value = val; }\n    } else if (op < 8) {\n      ta = A->hmget_key(ta, es, keys[ki], sizeof(char*), 1);\n      tb = B->hmget_key(tb, es, keys[ki], sizeof(char*), 1);\n    } else {\n      ta = A->hmdel_key(ta, es, keys[ki], sizeof(char*), offsetof(skv_t,key), 1);\n      tb = B->hmdel_key(tb, es, keys[ki], sizeof(char*), offsetof(skv_t,key), 1);\n    }\n    if ((ta==NULL)!=(tb==NULL)) { FAIL(\"hm_string mode=%d step %d nullness\", shmode, step); break; }\n    if (!ta) continue;\n    hdr_t *ha = HDR((char*)ta - es), *hb = HDR((char*)tb - es);\n    int bad = 0;\n    if (ha->length != hb->length) { FAIL(\"hm_string mode=%d step %d: length C=%zu RUST=%zu\", shmode, step, ha->length, hb->length); bad=1; }\n    if (ha->capacity != hb->capacity) { FAIL(\"hm_string mode=%d step %d: cap C=%zu RUST=%zu\", shmode, step, ha->capacity, hb->capacity); bad=1; }\n    if (ha->temp != hb->temp) { FAIL(\"hm_string mode=%d step %d: temp C=%td RUST=%td\", shmode, step, ha->temp, hb->temp); bad=1; }\n    size_t n = ha->length < hb->length ? ha->length : hb->length;\n    for (size_t i = 1; i < n && !bad; ++i) {\n      if ((ta[i].key==NULL)!=(tb[i].key==NULL)) { FAIL(\"hm_string mode=%d step %d elem %zu key nullness\", shmode, step, i); bad=1; break; }\n      if (ta[i].key && strcmp(ta[i].key, tb[i].key)) { FAIL(\"hm_string mode=%d step %d elem %zu key C='%s' RUST='%s'\", shmode, step, i, ta[i].key, tb[i].key); bad=1; }\n      if (ta[i].value != tb[i].value) { FAIL(\"hm_string mode=%d step %d elem %zu value C=%d RUST=%d\", shmode, step, i, ta[i].value, tb[i].value); bad=1; }\n    }\n    hidx_t *ia = ha->hash_table, *ib = hb->hash_table;\n    if (ia && ib) {\n#define F(f) if (ia->f != ib->f) { FAIL(\"hm_string mode=%d step %d: idx.\" #f \" C=%zu RUST=%zu\", shmode, step, (size_t)ia->f, (size_t)ib->f); bad=1; }\n      F(slot_count) F(used_count) F(tombstone_count) F(seed) F(slot_count_log2)\n#undef F\n      if (ia->string.mode != ib->string.mode) { FAIL(\"hm_string mode=%d step %d: string.mode C=%u RUST=%u\", shmode, step, ia->string.mode, ib->string.mode); bad=1; }\n      if (ia->string.block != ib->string.block) { FAIL(\"hm_string mode=%d step %d: string.block C=%u RUST=%u\", shmode, step, ia->string.block, ib->string.block); bad=1; }\n      if (ia->string.remaining != ib->string.remaining) { FAIL(\"hm_string mode=%d step %d: string.remaining C=%zu RUST=%zu\", shmode, step, ia->string.remaining, ib->string.remaining); bad=1; }\n      if ((ia->temp_key==NULL)!=(ib->temp_key==NULL)) { FAIL(\"hm_string mode=%d step %d: temp_key nullness C=%p RUST=%p\", shmode, step, (void*)ia->temp_key, (void*)ib->temp_key); bad=1; }\n      else if (ia->temp_key && strcmp(ia->temp_key, ib->temp_key)) { FAIL(\"hm_string mode=%d step %d: temp_key C='%s' RUST='%s'\", shmode, step, ia->temp_key, ib->temp_key); bad=1; }\n      if (ia->slot_count == ib->slot_count)\n        for (size_t i = 0; i < ia->slot_count >> 3; ++i)\n          for (int j = 0; j < 8; ++j)\n            if (ia->storage[i].hash[j] != ib->storage[i].hash[j] || ia->storage[i].index[j] != ib->storage[i].index[j]) {\n              FAIL(\"hm_string mode=%d step %d bucket[%zu][%d] C{%#zx,%td} RUST{%#zx,%td}\", shmode, step, i, j,\n                   ia->storage[i].hash[j], ia->storage[i].index[j], ib->storage[i].hash[j], ib->storage[i].index[j]);\n              bad = 1;\n            }\n    }\n    if (bad) { reported++; if (reported > 3) break; }\n  }\n  if (ta) A->hmfree_func((char*)ta - es, es);\n  if (tb) B->hmfree_func((char*)tb - es, es);\n  printf(\"hm_string(mode=%d,seed=%u,ops=%d,range=%d): %s\\n\", shmode, seed, nops, keyrange, reported ? \"DIVERGES\" : \"match\");\n}\n\nstatic void test_arena(lib_t *A, lib_t *B, unsigned seed)\n{\n  rng_state = seed ? seed : 1;\n  arena_t aa, ab;\n  memset(&aa, 0, sizeof aa); memset(&ab, 0, sizeof ab);\n  int reported = 0;\n  static char buf[8192];\n  for (int step = 0; step < 500; ++step) {\n    size_t len = (size_t)(rnd() % 2000);\n    if (step % 17 == 0) len = 600 + (rnd() % 3000);\n    for (size_t k = 0; k < len; ++k) buf[k] = 'a' + (char)(rnd() % 26);\n    buf[len] = 0;\n    char *pa = A->stralloc(&aa, buf);\n    char *pb = B->stralloc(&ab, buf);\n    int bad = 0;\n    if (strcmp(pa, buf) || strcmp(pb, buf)) { FAIL(\"arena step %d: content wrong\", step); bad = 1; }\n    if (aa.remaining != ab.remaining) { FAIL(\"arena step %d: remaining C=%zu RUST=%zu (len=%zu)\", step, aa.remaining, ab.remaining, len+1); bad=1; }\n    if (aa.block != ab.block) { FAIL(\"arena step %d: block C=%u RUST=%u\", step, aa.block, ab.block); bad=1; }\n    if ((aa.storage==NULL)!=(ab.storage==NULL)) { FAIL(\"arena step %d: storage nullness\", step); bad=1; }\n    /* offset of returned pointer inside its own block */\n    ptrdiff_t oa = pa - ((char*)aa.storage + 8), ob = pb - ((char*)ab.storage + 8);\n    if (oa != ob) { FAIL(\"arena step %d: return offset C=%td RUST=%td\", step, oa, ob); bad=1; }\n    int na = 0, nb = 0;\n    for (void *x = aa.storage; x && na < 100000; x = *(void**)x) na++;\n    for (void *x = ab.storage; x && nb < 100000; x = *(void**)x) nb++;\n    if (na != nb) { FAIL(\"arena step %d: chain length C=%d RUST=%d\", step, na, nb); bad=1; }\n    if (bad) { reported++; if (reported > 5) break; }\n  }\n  A->strreset(&aa); B->strreset(&ab);\n  if (aa.storage || ab.storage || aa.remaining || ab.remaining || aa.block || ab.block || aa.mode || ab.mode)\n    { FAIL(\"strreset did not clear\"); reported++; }\n  printf(\"arena(seed=%u): %s\\n\", seed, reported ? \"DIVERGES\" : \"match\");\n}\n\nstatic void test_hmput_default(lib_t *A, lib_t *B)\n{\n  size_t es = sizeof(kv_t);\n  int reported = 0;\n  void *ta = A->hmput_default(NULL, es);\n  void *tb = B->hmput_default(NULL, es);\n  if (cmp_table(ta, tb, es, \"hmput_default(NULL)\", 0)) reported++;\n  void *ta2 = A->hmput_default(ta, es);\n  void *tb2 = B->hmput_default(tb, es);\n  if (ta2 != ta || tb2 != tb) { FAIL(\"hmput_default second call changed pointer\"); reported++; }\n  A->hmfree_func((char*)ta - es, es);\n  B->hmfree_func((char*)tb - es, es);\n  printf(\"hmput_default: %s\\n\", reported ? \"DIVERGES\" : \"match\");\n}\n\nstatic void test_hmget_key_ts(lib_t *A, lib_t *B)\n{\n  size_t es = sizeof(kv_t);\n  int reported = 0;\n  ptrdiff_t pa = 12345, pb = 12345;\n  int k = 7;\n  void *ta = A->hmget_key_ts(NULL, es, &k, sizeof(int), &pa, 0);\n  void *tb = B->hmget_key_ts(NULL, es, &k, sizeof(int), &pb, 0);\n  if (pa != pb) { FAIL(\"hmget_key_ts(NULL) temp C=%td RUST=%td\", pa, pb); reported++; }\n  if (cmp_table(ta, tb, es, \"hmget_key_ts(NULL)\", 0)) reported++;\n  ta = A->hmget_key_ts(ta, es, &k, sizeof(int), &pa, 0);\n  tb = B->hmget_key_ts(tb, es, &k, sizeof(int), &pb, 0);\n  if (pa != pb) { FAIL(\"hmget_key_ts(no table) temp C=%td RUST=%td\", pa, pb); repor