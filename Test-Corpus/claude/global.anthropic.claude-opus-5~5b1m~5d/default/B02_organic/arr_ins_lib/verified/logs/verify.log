key, keysize, keyoffset, mode);\n979\t        if slot < 0 {\n980\t            return a;\n981\t        }\n982\t\n983\t        let mut b = (*table).storage.add((slot >> STBDS_BUCKET_SHIFT) as usize);\n984\t        let mut i = (slot as usize) & STBDS_BUCKET_MASK;\n985\t        let old_index = (*b).index[i];\n986\t        let final_index = stbds_arrlen(raw_a) - 1 - 1;\n987\t        debug_assert!(slot < (*table).slot_count as isize);\n988\t        (*table).used_count = (*table).used_count.wrapping_sub(1);\n989\t        (*table).tombstone_count = (*table).tombstone_count.wrapping_add(1);\n990\t        set_stbds_temp(raw_a, 1);\n991\t        (*b).hash[i] = STBDS_HASH_DELETED;\n992\t        (*b).index[i] = STBDS_INDEX_DELETED;\n993\t\n994\t        if mode == STBDS_HM_STRING && (*table).string.mode == STBDS_SH_STRDUP {\n995\t            stbds_free(\n996\t                *(byte_add(a, elemsize.wrapping_mul(old_index as usize)) as *mut *mut c_void),\n997\t            );\n998\t        }\n999\t\n1000\t        if old_index != final_index {\n1001\t            memmove(\n1002\t                byte_add(a, elemsize.wrapping_mul(old_index as usize)),\n1003\t                byte_add(a, elemsize.wrapping_mul(final_index as usize)),\n1004\t                elemsize,\n1005\t            );\n1006\t\n1007\t            if mode == STBDS_HM_STRING {\n1008\t                let kp = byte_add(\n1009\t                    a,\n1010\t                    elemsize\n1011\t                        .wrapping_mul(old_index as usize)\n1012\t                        .wrapping_add(keyoffset),\n1013\t                ) as *mut *mut c_void;\n1014\t                slot = stbds_hm_find_slot(a, elemsize, *kp, keysize, keyoffset, mode);\n1015\t            } else {\n1016\t                let kp = byte_add(\n1017\t                    a,\n1018\t                    elemsize\n1019\t                        .wrapping_mul(old_index as usize)\n1020\t                        .wrapping_add(keyoffset),\n1021\t                );\n1022\t                slot = stbds_hm_find_slot(a, elemsize, kp, keysize, keyoffset, mode);\n1023\t            }\n1024\t            debug_assert!(slot >= 0);\n1025\t            b = (*table).storage.add((slot >> STBDS_BUCKET_SHIFT) as usize);\n1026\t            i = (slot as usize) & STBDS_BUCKET_MASK;\n1027\t            debug_assert!((*b).index[i] == final_index);\n1028\t            (*b).index[i] = old_index;\n1029\t        }\n1030\t        (*stbds_header(raw_a)).length -= 1;\n1031\t\n1032\t        if (*table).used_count < (*table).used_count_shrink_threshold\n1033\t            && (*table).slot_count > STBDS_BUCKET_LENGTH\n1034\t        {\n1035\t            (*stbds_header(raw_a)).hash_table =\n1036\t                stbds_make_hash_index((*table).slot_count >> 1, table) as *mut c_void;\n1037\t            stbds_free(table as *mut c_void);\n1038\t        } else if (*table).tombstone_count > (*table).tombstone_count_threshold {\n1039\t            (*stbds_header(raw_a)).hash_table =\n1040\t                stbds_make_hash_index((*table).slot_count, table) as *mut c_void;\n1041\t            stbds_free(table as *mut c_void);\n1042\t        }\n1043\t\n1044\t        a\n1045\t    }\n1046\t}\n1047\t\n1048\t// ---------------------------------------------------------------------------\n1049\t// string storage\n1050\t// ---------------------------------------------------------------------------\n1051\t\n1052\tunsafe fn stbds_strdup(str_: *mut c_char) -> *mut c_char {\n1053\t    unsafe {\n1054\t        let len = strlen(str_) + 1;\n1055\t        let p = stbds_realloc(ptr::null_mut(), len) as *mut c_char;\n1056\t        memmove(p as *mut c_void, str_ as *const c_void, len);\n1057\t        p\n1058\t    }\n1059\t}\n1060\t\n1061\tconst STBDS_STRING_ARENA_BLOCKSIZE_MIN: usize = 512;\n1062\tconst STBDS_STRING_ARENA_BLOCKSIZE_MAX: usize = 1 << 20;\n1063\t\n1064\t#[unsafe(no_mangle)]\n1065\tpub unsafe extern \"C\" fn stbds_stralloc(\n1066\t    a: *mut stbds_string_arena,\n1067\t    str_: *mut c