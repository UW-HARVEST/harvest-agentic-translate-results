issing %s\\n\", nm); exit(1);} } while(0)\n  S(rand_seed,\"stbds_rand_seed\"); S(hash_bytes,\"stbds_hash_bytes\"); S(hash_string,\"stbds_hash_string\");\n  S(stralloc,\"stbds_stralloc\"); S(strreset,\"stbds_strreset\"); S(arrgrowf,\"stbds_arrgrowf\");\n  S(arrfreef,\"stbds_arrfreef\"); S(hmput_default,\"stbds_hmput_default\"); S(hmput_key,\"stbds_hmput_key\");\n  S(hmget_key_ts,\"stbds_hmget_key_ts\"); S(hmfree_func,\"stbds_hmfree_func\");\n  S(shmode_func,\"stbds_shmode_func\"); S(strkey,\"strkey\");\n#undef S\n}\n\n/* ---------- 1. strkey: brute force ---------- */\nstatic void t_strkey(lib_t *A, lib_t *B)\n{\n  int bad = 0;\n  uint64_t rs = 0x1234567;\n  char ref[64], ca[300], cb[300];\n  /* all values near every decimal power and every boundary + 3M random */\n  long long specials[] = {0,1,-1,9,-9,10,-10,99,-99,100,-100,999,-999,1000,-1000,\n    9999,-9999,10000,-10000,99999,-99999,100000,-100000,999999,-999999,1000000,-1000000,\n    9999999,-9999999,10000000,-10000000,99999999,-99999999,100000000,-100000000,\n    999999999,-999999999,1000000000,-1000000000,2147483647,-2147483648,2147483646,-2147483647};\n  for (size_t i = 0; i < sizeof specials/sizeof *specials; ++i) {\n    int n = (int) specials[i];\n    memcpy(ca, A->strkey(n), 32); memcpy(cb, B->strkey(n), 32);\n    sprintf(ref, \"test_%d\", n);\n    if (strcmp(ca, ref)) { FAIL(\"strkey C n=%d '%s' != '%s'\", n, ca, ref); bad=1; }\n    if (strcmp(cb, ref)) { FAIL(\"strkey RUST n=%d '%s' != '%s'\", n, cb, ref); bad=1; }\n    if (memcmp(ca, cb, 32)) { FAIL(\"strkey buffer bytes differ for n=%d\", n); bad=1; }\n  }\n  for (long i = 0; i < 3000000; ++i) {\n    rs ^= rs<<13; rs ^= rs>>7; rs ^= rs<<17;\n    int n = (int)(uint32_t)rs;\n    memcpy(ca, A->strkey(n), 32); memcpy(cb, B->strkey(n), 32);\n    sprintf(ref, \"test_%d\", n);\n    if (strcmp(ca, ref) || strcmp(cb, ref) || memcmp(ca, cb, 32)) {\n      if (!bad) FAIL(\"strkey n=%d C='%s' RUST='%s' ref='%s'\", n, ca, cb, ref);\n      bad = 1;\n    }\n  }\n  printf(\"strkey brute force (3M + boundaries): %s\\n\", bad ? \"DIVERGES\" : \"match\");\n}\n\n/* ---------- 2. arrgrowf exhaustive small sweep ---------- */\nstatic void t_arrgrowf(lib_t *A, lib_t *B)\n{\n  int bad = 0;\n  size_t elemsizes[] = {0,1,2,3,4,8,16,7};\n  /* single-shot: fresh NULL array, every (addlen,min_cap) in 0..40 */\n  for (size_t e = 0; e < sizeof elemsizes/sizeof *elemsizes; ++e)\n  for (size_t addlen = 0; addlen <= 20; ++addlen)\n  for (size_t mincap = 0; mincap <= 20; ++mincap) {\n    void *a = A->arrgrowf(NULL, elemsizes[e], addlen, mincap);\n    void *b = B->arrgrowf(NULL, elemsizes[e], addlen, mincap);\n    if ((a==NULL)!=(b==NULL)) { FAIL(\"arrgrowf(NULL,%zu,%zu,%zu) nullness C=%p R=%p\", elemsizes[e], addlen, mincap, a, b); bad=1; continue; }\n    if (!a) continue;\n    hdr_t *ha=HDR(a), *hb=HDR(b);\n    if (ha->length!=hb->length||ha->capacity!=hb->capacity||ha->temp!=hb->temp||\n        (ha->hash_table!=NULL)!=(hb->hash_table!=NULL)) {\n      FAIL(\"arrgrowf(NULL,e=%zu,add=%zu,min=%zu) C{l=%zu c=%zu t=%td} R{l=%zu c=%zu t=%td}\",\n           elemsizes[e], addlen, mincap, ha->length, ha->capacity, ha->temp, hb->length, hb->capacity, hb->temp);\n      bad=1;\n    }\n    /* second growth from an existing array with a set length */\n    for (size_t setlen = 0; setlen <= ha->capacity; setlen += (ha->capacity/3+1)) {\n      ha->length = setlen; hb->length = setlen;\n      for (size_t a2 = 0; a2 <= 6; ++a2) for (size_t m2 = 0; m2 <= 6; ++m2) {\n        size_t sc = ha->capacity, sl = ha->length;\n        void *a3 = A->arrgrowf(a, elemsizes[e], a2, m2);\n        void *b3 = B->arrgrowf(b, elemsizes[e], a2, m2);\n        hdr_t *h3=HDR(a3), *h4=HDR(b3);\n        if (h3->length!=h4->length||h3->capacity!=h4->capacity||h3->temp!=h4->temp) {\n          FAIL(\"arrgrowf(grow e=%zu len=%zu cap=%zu add=%zu min=%zu) C{l=%zu c=%zu} R{l=%zu c=%zu}\",\n               elemsizes[e], sl, sc, a2, m2, h3->length, h3->capacity, h4->length, h4->capacity);\n          bad=1;\n        }\n        a = a3; b = b3; ha = HDR(a); hb = HDR(b);\n      }\n    }\n    A->arrfreef(a); B->arrfreef(b);\n  }\n  /* wrap-around addlen */\n  {\n    void *a = A->arrgrowf(NULL, 4, 1, 0), *b = B->arrgrowf(NULL, 4, 1, 0);\n    HDR(a)->length = 3; HDR(b)->length = 3;\n    size_t adds[] = {SIZE_MAX, SIZE_MAX-2, SIZE_MAX/2};\n    for (size_t i = 0; i < 3; ++i) {\n      void *a2 = A->arrgrowf(a, 4, adds[i], 0), *b2 = B->arrgrowf(b, 4, adds[i], 0);\n      if ((a2==NULL)!=(b2==NULL)) { FAIL(\"arrgrowf wrap nullness\"); bad=1; break; }\n      if (a2 && b2) {\n        if (HDR(a2)->capacity != HDR(b2)->capacity) { FAIL(\"arrgrowf wrap addlen=%#zx cap C=%zu R=%zu\", adds[i], HDR(a2)->capacity, HDR(b2)->capacity); bad=1; }\n        a = a2; b = b2;\n      }\n    }\n    A->arrfreef(a); B->arrfreef(b);\n  }\n  printf(\"arrgrowf exhaustive sweep: %s\\n\", bad ? \"DIVERGES\" : \"match\");\n}\n\n/* ---------- 3. stralloc boundary lengths ---------- */\nstatic void t_stralloc(lib_t *A, lib_t *B)\n{\n  int bad = 0;\n  static char buf[1<<21];\n  memset(buf, 'z', sizeof buf);\n  /* every interesting length relative to the 512 base block, from a fresh arena */\n  size_t lens[] = {0,1,2,7,8,9,255,510,511,512,513,1022,1023,1024,1025,2047,2048,2049,\n                   1048575,1048576,1048577,2000000};\n  for (size_t i = 0; i < sizeof lens/sizeof *lens; ++i) {\n    arena_t aa, ab; memset(&aa,0,sizeof aa); memset(&ab,0,sizeof ab);\n    size_t L = lens[i];\n    buf[L] = 0;\n    char *pa = A->stralloc(&aa, buf), *pb = B->stralloc(&ab, buf);\n    buf[L] = 'z';\n    if (strlen(pa)!=L||strlen(pb)!=L) { FAIL(\"stralloc len=%zu content len C=%zu R=%zu\", L, strlen(pa), strlen(pb)); bad=1; }\n    if (aa.remaining!=ab.remaining) { FAIL(\"stralloc fresh len=%zu remaining C=%zu R=%zu\", L, aa.remaining, ab.remaining); bad=1; }\n    if (aa.block!=ab.block) { FAIL(\"stralloc fresh len=%zu block C=%u R=%u\", L, aa.block, ab.block); bad=1; }\n    if ((pa == (char*)aa.storage+8+aa.remaining) != (pb == (char*)ab.storage+8+ab.remaining))\n      { FAIL(\"stralloc fresh len=%zu path class differs\", L); bad=1; }\n    /* now a second alloc that exactly consumes / just overflows the remainder */\n    for (int d = -1; d <= 1; ++d) {\n      arena_t a2 = aa, b2 = ab;\n      long long want = (long long)aa.remaining + d;  /* len incl NUL */\n      if (want < 1) continue;\n      size_t L2 = (size_t)want - 1;\n      if (L2 >= sizeof buf) continue;\n      buf[L2] = 0;\n      char *q1 = A->stralloc(&a2, buf), *q2 = B->stralloc(&b2, buf);\n      buf[L2] = 'z';\n      if (strlen(q1)!=L2||strlen(q2)!=L2) { FAIL(\"stralloc2 L=%zu d=%d content\", L2, d); bad=1; }\n      if (a2.remaining!=b2.remaining) { FAIL(\"stralloc2 L=%zu d=%d remaining C=%zu R=%zu\", L2, d, a2.remaining, b2.remaining); bad=1; }\n      if (a2.block!=b2.block) { FAIL(\"stralloc2 L=%zu d=%d block C=%u R=%u\", L2, d, a2.block, b2.block); bad=1; }\n      if ((q1 == (char*)a2.storage+8+a2.remaining) != (q2 == (char*)b2.storage+8+b2.remaining))\n        { FAIL(\"stralloc2 L=%zu d=%d path class differs\", L2, d); bad=1; }\n    }\n    A->strreset(&aa); B->strreset(&ab);\n  }\n  /* long chain, all in the \"big block with existing storage\" path */\n  {\n    arena_t aa, ab; memset(&aa,0,sizeof aa); memset(&ab,0,sizeof ab);\n    buf[100] = 0; A->stralloc(&aa, buf); B->stralloc(&ab, buf); buf[100]='z';\n    for (int i = 0; i < 30; ++i) {\n      size_t L = 600000 + i;\n      buf[L] = 0;\n      char *pa = A->stralloc(&aa, buf), *pb = B->stralloc(&ab, buf);\n      buf[L] = 'z';\n      if (strlen(pa)!=L||strlen(pb)!=L) { FAIL(\"stralloc chain i=%d content\", i); bad=1; }\n      if (aa.remaining!=ab.remaining||aa.block!=ab.block) { FAIL(\"stralloc chain i=%d rem C=%zu R=%zu blk C=%u R=%u\", i, aa.remaining, ab.remaining, aa.block, ab.block); bad=1; }\n      int na=0, nb=0;\n      for (void *x=aa.storage; x; x=*(void**)x) na++;\n      for (void *x=ab.storage; x; x=*(void**)x) nb++;\n      if (na!=nb) { FAIL(\"stralloc chain i=%d chain len C=%d R=%d\", i, na, nb); bad=1; }\n      /* new block must be the SECOND link, not the head (original quirk) */\n      int inserted_2nd_a = aa.storage && *(void**)aa.storage && pa == (char*)(*(void**)aa.storage)+8;\n      int inserted_2nd_b = ab.storage && *(void**)ab.storage && pb == (char*)(*(void**)ab.storage)+8;\n      if (inserted_2nd_a != inserted_2nd_b) { FAIL(\"stralloc chain i=%d insert position differs (C=%d R=%d)\", i, inserted_2nd_a, inserted_2nd_b); bad=1; }\n    }\n    A->strreset(&aa); B->strreset(&ab);\n  }\n  printf(\"stralloc boundaries: %s\\n\", bad ? \"DIVERGES\" : \"match\");\n}\n\n/* ---------- 4. exhaustive short hash inputs ---------- */\nstatic void t_hash_short(lib_t *A, lib_t *B)\n{\n  int bad = 0;\n  unsigned char b[16];\n  size_t seeds[] = {0, 1, ~(size_t)0, 0x31415926, 0x8000000000000000ull};\n  /* all 1-byte and 2-byte inputs, all 3-byte inputs with 0/0x7f/0x80/0xff */\n  for (int x = 0; x < 256; ++x) {\n    b[0] = (unsigned char) x;\n    for (size_t si = 0; si < 5; ++si)\n      if (A->hash_bytes(b,1,seeds[si]) != B->hash_bytes(b,1,seeds[si])) { FAIL(\"hash1 %02x\", x); bad=1; }\n    for (int y = 0; y < 256; ++y) {\n      b[1] = (unsigned char) y;\n      if (A->hash_bytes(b,2,seeds[0]) != B->hash_bytes(b,2,seeds[0])) { FAIL(\"hash2 %02x%02x\", x, y); bad=1; }\n    }\n  }\n  /* every length 0..16 with the byte at each position set to 0x80 / 0xff / 0x7f */\n  unsigned char vals[] = {0x00,0x01,0x7f,0x80,0x81,0xfe,0xff};\n  for (size_t len = 0; len <= 16; ++len)\n    for (size_t pos = 0; pos < 16; ++pos)\n      for (size_t vi = 0; vi < sizeof vals; ++vi) {\n        memset(b, 0x5a, sizeof b);\n        b[pos] = vals[vi];\n        for (size_t si = 0; si < 5; ++si)\n          if (A->hash_bytes(b,len,seeds[si]) != B->hash_bytes(b,len,seeds[si]))\n            { FAIL(\"hashN len=%zu pos=%zu val=%02x seed=%#zx\", len, pos, vals[vi], seeds[si]); bad=1; }\n      }\n  /* hash_string with every single byte value, and 8-byte strings */\n  char s[32];\n  for (int x = 1; x < 256; ++x) {\n    s[0] = (char) x; s[1] = 0;\n    for (size_t si = 0; si < 5; ++si)\n      if (A->hash_string(s,seeds[si]) != B->hash_string(s,seeds[si])) { FAIL(\"hstr1 %02x\", x); bad=1; }\n    for (int y = 1; y < 256; ++y) {\n      s[0]=(char)x; s[1]=(char)y; s[2]=0;\n      if (A->hash_string(s,seeds[0]) != B->hash_string(s,seeds[0])) { FAIL(\"hstr2 %02x%02x\", x, y); bad=1; }\n    }\n  }\n  printf(\"hash exhaustive short inputs: %s\\n\", bad ? \"DIVERGES\" : \"match\");\n}\n\n/* ---------- 5. hmput_default on a length==0 array + shmode 0/1 ---------- */\nstatic void t_misc(lib_t *A, lib_t *B)\n{\n  int bad = 0;\n  size_t es = 8;\n  /* build a length==0 array by hand then feed it to hmput_default */\n  void *ra = A->arrgrowf(NULL, es, 0, 1), *rb = B->arrgrowf(NULL, es, 0, 1);\n  void *ta = (char*)ra + es, *tb = (char*)rb + es;\n  void *ua = A->hmput_default(ta, es), *ub = B->hmput_default(tb, es);\n  hdr_t *ha = HDR((char*)ua - es), *hb = HDR((char*)ub - es);\n  if (ha->length != hb->length || ha->capacity != hb->capacity) { FAIL(\"hmput_default(len=0) C{l=%zu c=%zu} R{l=%zu c=%zu}\", ha->length, ha->capacity, hb->length, hb->capacity); bad=1; }\n  if (memcmp((char*)ua-es, (char*)ub-es, es)) { FAIL(\"hmput_default(len=0) memset differs\"); bad=1; }\n  A->arrfreef((char*)ua-es); B->arrfreef((char*)ub-es);\n\n  for (int m = 0; m <= 3; ++m) {\n    void *xa = A->shmode_func(16, m), *xb = B->shmode_func(16, m);\n    hdr_t *ja = HDR((char*)xa-16), *jb = HDR((char*)xb-16);\n    hidx_t *ia = ja->hash_table, *ib = jb->hash_table;\n    if (ja->length!=jb->length) { FAIL(\"shmode_func(%d) length C=%zu R=%zu\", m, ja->length, jb->length); bad=1; }\n    if (ia->string.mode!=ib->string.mode) { FAIL(\"shmode_func(%d) mode C=%u R=%u\", m, ia->string.mode, ib->string.mode); bad=1; }\n    if (ia->slot_count!=ib->slot_count||ia->seed!=ib->seed||ia->used_count_threshold!=ib->used_count_threshold) { FAIL(\"shmode_func(%d) index fields\", m); bad=1; }\n    A->hmfree_func((char*)xa-16, 16); B->hmfree_func((char*)xb-16, 16);\n  }\n  /* shmode_func with out-of-range mode: (unsigned char) truncation */\n  for (int m = 254; m <= 260; ++m) {\n    void *xa = A->shmode_func(16, m), *xb = B->shmode_func(16, m);\n    hidx_t *ia = HDR((char*)xa-16)->hash_table, *ib = HDR((char*)xb-16)->hash_table;\n    if (ia->string.mode != ib->string.mode) { FAIL(\"shmode_func(%d) truncated mode C=%u R=%u\", m, ia->string.mode, ib->string.mode); bad=1; }\n    A->hmfree_func((char*)xa-16, 16); B->hmfree_func((char*)xb-16, 16);\n  }\n  /* negative mode */\n  for (int m = -2; m <= -1; ++m) {\n    void *xa = A->shmode_func(16, m), *xb = B->shmode_func(16, m);\n    hidx_t *ia = HDR((char*)xa-16)->hash_table, *ib = HDR((char*)xb-16)->hash_table;\n    if (ia->string.mode != ib->string.mode) { FAIL(\"shmode_func(%d) neg mode C=%u R=%u\", m, ia->string.mode, ib->string.mode); bad=1; }\n    A->hmfree_func((char*)xa-16, 16); B->hmfree_func((char*)xb-16, 16);\n  }\n  /* hmput_key with mode < 0 (negative) -> binary path in C ( >= 1 is false ) */\n  {\n    size_t e = 8; int k = 42;\n    void *pa = A->hmput_key(NULL, e, &k, sizeof k, -5);\n    void *pb = B->hmput_key(NULL, e, &k, sizeof k, -5);\n    hidx_t *ia = HDR((char*)pa-e)->hash_table, *ib = HDR((char*)pb-e)->hash_table;\n    if (ia->string.mode != ib->string.mode) { FAIL(\"hmput_key(mode=-5) string.mode C=%u R=%u\", ia->string.mode, ib->string.mode); bad=1; }\n    if (HDR((char*)pa-e)->temp != HDR((char*)pb-e)->temp) { FAIL(\"hmput_key(mode=-5) temp\"); bad=1; }\n    if (memcmp((char*)pa-e, (char*)pb-e, e*2)) { FAIL(\"hmput_key(mode=-5) payload\"); bad=1; }\n    A->hmfree_func((char*)pa-e, e); B->hmfree_func((char*)pb-e, e);\n  }\n  /* hmget_key_ts on a populated table: found / not found */\n  {\n    size_t e = 8;\n    void *pa = NULL, *pb = NULL;\n    for (int k = 0; k < 30; ++k) {\n      pa = A->hmput_key(pa, e, &k, sizeof k, 0);\n      pb = B->hmput_key(pb, e, &k, sizeof k, 0);\n      ptr