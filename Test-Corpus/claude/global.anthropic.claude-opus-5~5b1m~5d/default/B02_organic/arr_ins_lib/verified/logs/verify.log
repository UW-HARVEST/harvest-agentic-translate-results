MASK) + i);\n742\t        }\n743\t      }\n744\t\n745\t      limit = pos & STBDS_BUCKET_MASK;\n746\t      for (i = 0; i < limit; ++i) {\n747\t        if (bucket->hash[i] == hash) {\n748\t          if (stbds_is_key_equal(raw_a, elemsize, key, keysize, keyoffset, mode, bucket->index[i])) {\n749\t            stbds_temp(a) = bucket->index[i];\n750\t            return STBDS_ARR_TO_HASH(a,elemsize);\n751\t          }\n752\t        } else if (bucket->hash[i] == 0) {\n753\t          pos = (pos & ~STBDS_BUCKET_MASK) + i;\n754\t          goto found_empty_slot;\n755\t        } else if (tombstone < 0) {\n756\t          if (bucket->index[i] == STBDS_INDEX_DELETED)\n757\t            tombstone = (ptrdiff_t) ((pos & ~STBDS_BUCKET_MASK) + i);\n758\t        }\n759\t      }\n760\t\n761\t      pos += step;\n762\t      step += STBDS_BUCKET_LENGTH;\n763\t      pos &= (table->slot_count-1);\n764\t    }\n765\t   found_empty_slot:\n766\t    if (tombstone >= 0) {\n767\t      pos = tombstone;\n768\t      --table->tombstone_count;\n769\t    }\n770\t    ++table->used_count;\n771\t\n772\t    {\n773\t      ptrdiff_t i = (ptrdiff_t) stbds_arrlen(a);\n774\t      if ((size_t) i+1 > stbds_arrcap(a))\n775\t        *(void **) &a = stbds_arrgrowf(a, elemsize, 1, 0);\n776\t      raw_a = STBDS_ARR_TO_HASH(a,elemsize);\n777\t\n778\t      STBDS_ASSERT((size_t) i+1 <= stbds_arrcap(a));\n779\t      stbds_header(a)->length = i+1;\n780\t      bucket = &table->storage[pos >> STBDS_BUCKET_SHIFT];\n781\t      bucket->hash[pos & STBDS_BUCKET_MASK] = hash;\n782\t      bucket->index[pos & STBDS_BUCKET_MASK] = i-1;\n783\t      stbds_temp(a) = i-1;\n784\t\n785\t      switch (table->string.mode) {\n786\t         case STBDS_SH_STRDUP:  stbds_temp_key(a) = *(char **) ((char *) a + elemsize*i) = stbds_strdup((char*) key); break;\n787\t         case STBDS_SH_ARENA:   stbds_temp_key(a) = *(char **) ((char *) a + elemsize*i) = stbds_stralloc(&table->string, (char*)key); break;\n788\t         case STBDS_SH_DEFAULT: stbds_temp_key(a) = *(char **) ((char *) a + elemsize*i) = (char *) key; break;\n789\t         default:                memcpy((char *) a + elemsize*i, key, keysize); break;\n790\t      }\n791\t    }\n792\t    return STBDS_ARR_TO_HASH(a,elemsize);\n793\t  }\n794\t}\n795\t\n796\tvoid * stbds_shmode_func(size_t elemsize, int mode)\n797\t{\n798\t  void *a = stbds_arrgrowf(0, elemsize, 0, 1);\n799\t  stbds_hash_index *h;\n800\t  memset(a, 0, elemsize);\n801\t  stbds_header(a)->length = 1;\n802\t  stbds_header(a)->hash_table = h = (stbds_hash_index *) stbds_make_hash_index(STBDS_BUCKET_LENGTH, NULL);\n803\t  h->string.mode = (unsigned char) mode;\n804\t  return STBDS_ARR_TO_HASH(a,elemsize);\n805\t}\n806\t\n807\tvoid * stbds_hmdel_key(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode)\n808\t{\n809\t  if (a == NULL) {\n810\t    return 0;\n811\t  } else {\n812\t    stbds_hash_index *table;\n813\t    void *raw_a = STBDS_HASH_TO_ARR(a,elemsize);\n814\t    table = (stbds_hash_index *) stbds_header(raw_a)->hash_table;\n815\t    stbds_temp(raw_a) = 0;\n816\t    if (table == 0) {\n817\t      return a;\n818\t    } else {\n819\t      ptrdiff_t slot;\n820\t      slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n821\t      if (slot < 0)\n822\t        return a;\n823\t      else {\n824\t        stbds_hash_bucket *b = &table->storage[slot >> STBDS_BUCKET_SHIFT];\n825\t        int i = slot & STBDS_BUCKET_MASK;\n826\t        ptrdiff_t old_index = b->index[i];\n827\t        ptrdiff_t final_index = (ptrdiff_t) stbds_arrlen(raw_a)-1-1;\n828\t        STBDS_ASSERT(slot < (ptrdiff_t) table->slot_count);\n829\t        --table->used_count;\n830\t        ++table->tombstone_count;\n831\t        stbds_temp(raw_a) = 1;\n832\t        STBDS_ASSERT(table->used_count >= 0);\n833\t        b->hash[i] = STBDS_HASH_DELETED;\n834\t        b->index[i] = STBDS_INDEX_DELETED;\n835\t\n836\t        if (mode == STBDS_HM_STRING && table->string.mode == STBDS_SH_STRDUP)\n837\t          STBDS_FREE(NULL, *(char**) ((char *) a+elemsize*old_index));\n838\t\n839\t        if (old_index != final_index) {\n840\t          memmove((char*) a + elemsize*old_index, (char*) a + elemsize*final_index, elemsize);\n841\t\n842\t          if (mode == STBDS_HM_STRING)\n843\t            slot = stbds_hm_find_slot(a, elemsize, *(char**) ((char *) a+elemsize*old_index + keyoffset), keysize, keyoffset, mode);\n844\t          else\n845\t            slot = stbds_hm_find_slot(a, elemsize,  (char* ) a+elemsize*old_index + keyoffset, keysize, keyoffset, mode);\n846\t          STBDS_ASSERT(slot >= 0);\n847\t          b = &table->storage[slot >> STBDS_BUCKET_SHIFT];\n848\t          i = slot & STBDS_BUCKET_MASK;\n849\t          STBDS_ASSERT(b->index[i] == final_index);\n850\t          b->index[i] = old_index;\n851\t        }\n852\t        stbds_header(raw_a)->length -= 1;\n853\t\n854\t        if (table->used_count < table->used_count_shrink_threshold && table->slot_count > STBDS_BUCKET_LENGTH) {\n855\t          stbds_header(raw_a)->hash_table = stbds_make_hash_index(table->slot_count>>1, table);\n856\t          STBDS_FREE(NULL, table);\n857\t          STBDS_STATS(++stbds_hash_shrink);\n858\t        } else if (table->tombstone_count > table->tombstone_count_threshold) {\n859\t          stbds_header(raw_a)->hash_table = stbds_make_hash_index(table->slot_count   , table);\n860\t          STBDS_FREE(NULL, table);\n861\t          STBDS_STATS(++stbds_hash_rebuild);\n862\t        }\n863\t\n864\t        return a;\n865\t      }\n866\t    }\n867\t  }\n868\t}\n869\t\n870\tstatic char *stbds_strdup(char *str)\n871\t{\n872\t  size_t len = strlen(str)+1;\n873\t  char *p = (char*) STBDS_REALLOC(NULL, 0, len);\n874\t  memmove(p, str, len);\n875\t  return p;\n876\t}\n877\t\n878\t#define STBDS_STRING_ARENA_BLOCKSIZE_MIN  512u\n879\t#define STBDS_STRING_ARENA_BLOCKSIZE_MAX  (1u<<20)\n880\t\n881\tchar *stbds_stralloc(stbds_string_arena *a, char *str)\n882\t{\n883\t  char *p;\n884\t  size_t len = strlen(str)+1;\n885\t  if (len > a->remaining) {\n886\t    size_t blocksize = a->block;\n887\t\n888\t    blocksize = (size_t) (STBDS_STRING_ARENA_BLOCKSIZE_MIN) << (blocksize>>1);\n889\t\n890\t    if (blocksize < (size_t)(STBDS_STRING_ARENA_BLOCKSIZE_MAX))\n891\t      ++a->block;\n892\t\n893\t    if (len > blocksize) {\n894\t      stbds_string_block *sb = (stbds_string_block *) STBDS_REALLOC(NULL, 0, sizeof(*sb)-8 + len);\n895\t      memmove(sb->storage, str, len);\n896\t      if (a->storage) {\n897\t        sb->next = a->storage->next;\n898\t        a->storage->next = sb;\n899\t      } else {\n900\t        sb->next = 0;\n901\t        a->storage = sb;\n902\t        a->remaining = 0;\n903\t      }\n904\t      return sb->storage;\n905\t    } else {\n906\t      stbds_string_block *sb = (stbds_string_block *) STBDS_REALLOC(NULL, 0, sizeof(*sb)-8 + blocksize);\n907\t      sb->next = a->storage;\n908\t      a->storage = sb;\n909\t      a->remaining = blocksize;\n910\t    }\n911\t  }\n912\t\n913\t  STBDS_ASSERT(len <= a->remaining);\n914\t  p = a->storage->storage + a->remaining - len;\n915\t  a->remaining -= len;\n916\t  memmove(p, str, len);\n917\t  return p;\n918\t}\n919\t\n920\tvoid stbds_strreset(stbds_string_arena *a)\n921\t{\n922\t  stbds_string_block *x,*y;\n923\t  x = a->storage;\n924\t  while (x) {\n925\t    y = x->next;\n926\t    STBDS_FREE(NULL, x);\n927\t    x = y;\n928\t  }\n929\t  memset(a, 0, sizeof(*a));\n930\t}\n931\t\n932\t#include <stdio.h>\n933\t#include <assert.h>\n934\t\n935\ttypedef struct { int key,b,c,d; } stbds_struct;\n936\ttypedef struct { int key[2],b,c,d; } stbds_struct2;\n937\t\n938\tstatic char buffer[256];\n939\tchar *strkey(int n)\n940\t{\n941\t   sprintf(buffer, \"test_%d\", n);\n942\t   return buffer;\n943\t}\n944\t\n945\tvoid arr_ins(int num)\n946\t{\n947\t  int *arr=NULL;\n948\t  int i,j;\n949\t\n950\t  for (i=0; i < 5; ++i) {\n951\t    arrpush(arr,1); arrpush(arr,2); arrpush(arr,3); arrpush(arr,4);\n952\t    stbds_arrins(arr,i,num);\n953\t    STBDS_ASSERT(arr[i] == num);\n954\t    if (i < 4)\n955\t      STBDS_ASSERT(arr[4] == 4);\n956\t    arrfree(arr);\n957\t  }\n958\t}\n959\t"}]},"parent_tool_use_id":"toolu_bdrk_01RaEq6ZMffNso8L5p3Xjmzh","session_id":"aae41731-ad07-4556-b28d-c5975b42818a","uuid":"196e8bbe-8367-4a05-895c-fc92fb1b13d5","timestamp":"2026-08-27T05:47:07.246Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust line by line"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BUvLqxGWPAAh72t3S2oWSb","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (stb_ds.h based dynamic array /\n2\t//! hash map implementation plus the small `strkey` / `arr_ins` helpers).\n3\t//!\n4\t//! The translation is byte-for-byte behaviour compatible with the C original:\n5\t//!\n6\t//! * every memory block keeps the exact same layout (the public C header macros\n7\t//!   poke directly at `stbds_array_header`, so the header must stay 32 bytes with\n8\t//!   the same field order),\n9\t//! * every allocation goes through libc `realloc`/`free` so that blocks created\n10\t//!   here can be released by the C macros (`arrfree`, ...) and vice versa,\n11\t//! * all integer arithmetic reproduces the C semantics exactly, including the\n12\t//!   sign-extension quirks of `d[3] << 24` in the siphash loader, the\n13\t//!   `hash ^= hash ^ ROTR(...)` no-ops and the wrap-around behaviour.\n14\t//!\n15\t//! No bugs of the original were fixed.\n16\t\n17\t#![allow(non_camel_case_types)]\n18\t#![allow(non_upper_case_globals)]\n19\t#![allow(clippy::missing_safety_doc)]\n20\t\n21\tuse core::ffi::{c_char, c_int, c_void};\n22\tuse core::mem::size_of;\n23\tuse core::ptr;\n24\t\n25\t// ---------------------------------------------------------------------------\n26\t// libc bindings\n27\t// ---------------------------------------------------------------------------\n28\t\n29\tunsafe extern \"C\" {\n30\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n31\t    fn free(p: *mut c_void);\n32\t    fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n33\t    fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n34\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n35\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n36\t    fn strlen(s: *const c_char) -> usize;\n37\t}\n38\t\n39\t/// `STBDS_REALLOC(c,p,s)` -> `realloc(p,s)`\n40\t#[inline(always)]\n41\tunsafe fn stbds_realloc(p: *mut c_void, s: usize) -> *mut c_void {\n42\t    unsafe { realloc(p, s) }\n43\t}\n44\t\n45\t/// `STBDS_FREE(c,p)` -> `free(p)`\n46\t#[inline(always)]\n47\tunsafe fn stbds_free(p: *mut c_void) {\n48\t    unsafe { free(p) }\n49\t}\n50\t\n51\t#[inline(always)]\n52\tunsafe fn c_memset(dst: *mut c_void, val: u8, n: usize) {\n53\t    unsafe { ptr::write_bytes(dst as *mut u8, val, n) }\n54\t}\n55\t\n56\t/// `*(void **) addr = value`, with C semantics.\n57\t///\n58\t/// The C never null-checks before storing through a `realloc` result, so a\n59\t/// failed allocation faults on the store. Going through libc `memcpy` keeps that\n60\t/// behaviour byte-for-byte in *both* Rust profiles: a plain `(*p).field = v`\n61\t/// would trip the debug-profile null/alignment UB check and abort instead of\n62\t/// faulting.\n63\t#[inline(always)]\n64\tunsafe fn raw_store_ptr<T>(addr: usize, value: *mut T) {\n65\t    unsafe {\n66\t        let v = value;\n67\t        memcpy(\n68\t            addr as *mut c_void,\n69\t            &v as *const *mut T as *const c_void,\n70\t            size_of::<*mut T>(),\n71\t        );\n72\t    }\n73\t}\n74\t\n75\t/// `*(void **) addr`, with C semantics (see `raw_store_ptr`).\n76\t#[inline(always)]\n77\tunsafe fn raw_load_ptr<T>(addr: usize) -> *mut T {\n78\t    unsafe {\n79\t        let mut v: *mut T = ptr::null_mut();\n80\t        memcpy(\n81\t            &mut v as *mut *mut T as *mut c_void,\n82\t            addr as *const c_void,\n83\t            size_of::<*mut T>(),\n84\t        );\n85\t        v\n86\t    }\n87\t}\n88\t\n89\t// ---------------------------------------------------------------------------\n90\t// Data layout (must match the C structures bit for bit)\n91\t// ---------------------------------------------------------------------------\n92\t\n93\t#[repr(C)]\n94\tstruct stbds_array_header {\n95\t    length: usize,\n96\t    capacity: usize,\n97\t    hash_table: *mut c_void,\n98\t    temp: isize,\n99\t}\n100\t\n101\t#[repr(C)]\n102\tstruct stbds_string_block {\n103\t    next: *mut stbds_string_block,\n104\t    storage: [c_char; 8],\n105\t}\n106\t\n107\t#[repr(C)]\n108\t#[derive(Clone, Copy)]\n109\tpub struct stbds_string_arena {\n110\t    storage: *mut stbds_string_block,\n111\t    remaining: usize,\n112\t    block: u8,\n113\t    mode: u8,\n114\t}\n115\t\n116\tconst STBDS_BUCKET_LENGTH: usize = 8;\n117\tconst STBDS_BUCKET_SHIFT: usize = 3;\n118\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n119\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n120\t\n121\t#[repr(C)]\n122\tstruct stbds_hash_bucket {\n123\t    hash: [usize; STBDS_BUCKET_LENGTH],\n124\t    index: [isize; STBDS_BUCKET_LENGTH],\n125\t}\n126\t\n127\t#[repr(C)]\n128\tstruct stbds_hash_index {\n129\t    temp_key: *mut c_char,\n130\t    slot_count: usize,\n131\t    used_count: usize,\n132\t    used_count_threshold: usize,\n133\t    used_count_shrink_threshold: usize,\n134\t    tombstone_count: usize,\n135\t    tombstone_count_threshold: usize,\n136\t    seed: usize,\n137\t    slot_count_log2: usize,\n138\t    string: stbds_string_arena,\n139\t    storage: *mut stbds_hash_bucket,\n140\t}\n141\t\n142\tconst STBDS_INDEX_EMPTY: isize = -1;\n143\tconst STBDS_INDEX_DELETED: isize = -2;\n144\t\n145\tconst STBDS_HASH_EMPTY: usize = 0;\n146\tconst STBDS_HASH_DELETED: usize = 1;\n147\t\n148\t#[allow(dead_code)]\n149\tconst STBDS_HM_BINARY: c_int = 0;\n150\tconst STBDS_HM_STRING: c_int = 1;\n151\t\n152\tconst STBDS_SH_NONE: u8 = 0;\n153\tconst STBDS_SH_DEFAULT: u8 = 1;\n154\tconst STBDS_SH_STRDUP: u8 = 2;\n155\tconst STBDS_SH_ARENA: u8 = 3;\n156\t\n157\tconst STBDS_SIZE_T_BITS: u32 = (size_of::<usize>() * 8) as u32;\n158\t\n159\tconst HEADER_SIZE: usize = size_of::<stbds_array_header>();\n160\t\n161\t// Compile time layout checks mirroring the C struct sizes on LP64.\n162\tconst _: () = assert!(size_of::<stbds_array_header>() == 32);\n163\tconst _: () = assert!(size_of::<stbds_string_block>() == 16);\n164\tconst _: () = assert!(size_of::<stbds_string_arena>() == 24);\n165\tconst _: () = assert!(size_of::<stbds_hash_bucket>() == 128);\n166\tconst _: () = assert!(size_of::<stbds_hash_index>() == 104);\n167\tconst _: () = assert!(size_of::<usize>() == 8, \"siphash 2-4 requires a 64 bit build\");\n168\t\n169\t// ---------------------------------------------------------------------------\n170\t// pointer / accessor helpers (all plain address arithmetic, like the C macros)\n171\t// ---------------------------------------------------------------------------\n172\t\n173\t/// `stbds_header(t)` == `((stbds_array_header *) (t) - 1)`\n174\t#[inline(always)]\n175\tfn stbds_header(t: *const c_void) -> *mut stbds_array_header {\n176\t    (t as usize).wrapping_sub(HEADER_SIZE) as *mut stbds_array_header\n177\t}\n178\t\n179\t/// `(char *) p + n`\n180\t#[inline(always)]\n181\tfn byte_add(p: *const c_void, n: usize) -> *mut c_void {\n182\t    (p as usize).wrapping_add(n) as *mut c_void\n183\t}\n184\t\n185\t/// `(char *) p - n`\n186\t#[inline(always)]\n187\tfn byte_sub(p: *const c_void, n: usize) -> *mut c_void {\n188\t    (p as usize).wrapping_sub(n) as *mut c_void\n189\t}\n190\t\n191\t/// `STBDS_HASH_TO_ARR(x,elemsize)`\n192\t#[inline(always)]\n193\tfn stbds_hash_to_arr(x: *const c_void, elemsize: usize) -> *mut c_void {\n194\t    byte_sub(x, elemsize)\n195\t}\n196\t\n197\t/// `STBDS_ARR_TO_HASH(x,elemsize)`\n198\t#[inline(always)]\n199\tfn stbds_arr_to_hash(x: *const c_void, elemsize: usize) -> *mut c_void {\n200\t    byte_add(x, elemsize)\n201\t}\n202\t\n203\t/// `stbds_arrlen(a)`\n204\t#[inline(always)]\n205\tunsafe fn stbds_arrlen(a: *const c_void) -> isize {\n206\t    if !a.is_null() {\n207\t        unsafe { (*stbds_header(a)).length as isize }\n208\t    } else {\n209\t        0\n210\t    }\n211\t}\n212\t\n213\t/// `stbds_arrcap(a)`\n214\t#[inline(always)]\n215\tunsafe fn stbds_arrcap(a: *const c_void) -> usize {\n216\t    if !a.is_null() {\n217\t        unsafe { (*stbds_header(a)).capacity }\n218\t    } else {\n219\t        0\n220\t    }\n221\t}\n222\t\n223\t/// `stbds_temp(t) = v`\n224\t#[inline(always)]\n225\tunsafe fn set_stbds_temp(t: *const c_void, v: isize) {\n226\t    unsafe { (*stbds_header(t)).temp = v }\n227\t}\n228\t\n229\t/// `stbds_temp_key(t) = v`  (`*(char **) stbds_header(t)->hash_table`)\n230\t#[inline(always)]\n231\tunsafe fn set_stbds_temp_key(t: *const c_void, v: *mut c_char) {\n232\t    unsafe {\n233\t        let table = (*stbds_header(t)).hash_table as *mut *mut c_char;\n234\t        *table = v;\n235\t    }\n236\t}\n237\t\n238\t/// `stbds_hash_table(a)`\n239\t#[inline(always)]\n240\tunsafe fn stbds_hash_table(a: *const c_void) -> *mut stbds_hash_index {\n241\t    unsafe { (*stbds_header(a)).hash_table as *mut stbds_hash_index }\n242\t}\n243\t\n244\t/// `STBDS_ROTATE_LEFT(val, n)`\n245\t#[inline(always)]\n246\tfn rotate_left(val: usize, n: u32) -> usize {\n247\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n248\t}\n249\t\n250\t/// `STBDS_ROTATE_RIGHT(val, n)`\n251\t#[inline(always)]\n252\tfn rotate_right(val: usize, n: u32) -> usize {\n253\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n254\t}\n255\t\n256\t/// `STBDS_ALIGN_FWD(n,a)`\n257\t#[inline(always)]\n258\tfn align_fwd(n: usize, a: usize) -> usize {\n259\t    n.wrapping_add(a - 1) & !(a - 1)\n260\t}\n261\t\n262\t// ---------------------------------------------------------------------------\n263\t// dynamic array growth\n264\t// ---------------------------------------------------------------------------\n265\t\n266\t#[unsafe(no_mangle)]\n267\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n268\t    a: *mut c_void,\n269\t    elemsize: usize,\n270\t    addlen: usize,\n271\t    min_cap: usize,\n272\t) -> *mut c_void {\n273\t    unsafe {\n274\t        let mut min_cap = min_cap;\n275\t        let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n276\t\n277\t        if min_len > min_cap {\n278\t            min_cap = min_len;\n279\t        }\n280\t\n281\t        if min_cap <= stbds_arrcap(a) {\n282\t            return a;\n283\t        }\n284\t\n285\t        if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n286\t            min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n287\t        } else if min_cap < 4 {\n288\t            min_cap = 4;\n289\t        }\n290\t\n291\t        let old = if !a.is_null() {\n292\t            stbds_header(a) as *mut c_void\n293\t        } else {\n294\t            ptr::null_mut()\n295\t        };\n296\t        let b = stbds_realloc(\n297\t            old,\n298\t            elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n299\t        );\n300\t        let b = byte_add(b, HEADER_SIZE);\n301\t        if a.is_null() {\n302\t            (*stbds_header(b)).length = 0;\n303\t            (*stbds_header(b)).hash_table = ptr::null_mut();\n304\t            (*stbds_header(b)).temp = 0;\n305\t        }\n306\t        (*stbds_header(b)).capacity = min_cap;\n307\t\n308\t        b\n309\t    }\n310\t}\n311\t\n312\t#[unsafe(no_mangle)]\n313\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n314\t    unsafe { stbds_free(stbds_header(a) as *mut c_void) }\n315\t}\n316\t\n317\t// ---------------------------------------------------------------------------\n318\t// hash index\n319\t// ---------------------------------------------------------------------------\n320\t\n321\tstatic mut stbds_hash_seed: usize = 0x31415926;\n322\t\n323\t#[unsafe(no_mangle)]\n324\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n325\t    unsafe { stbds_hash_seed = seed }\n326\t}\n327\t\n328\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n329\t    hash & (slot_count.wrapping_sub(1))\n330\t}\n331\t\n332\tfn stbds_log2(slot_count: usize) -> usize {\n333\t    let mut slot_count = slot_count;\n334\t    let mut n: usize = 0;\n335\t    while slot_count > 1 {\n336\t        slot_count >>= 1;\n337\t        n += 1;\n338\t    }\n339\t    n\n340\t}\n341\t\n342\t/// `stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)`\n343\t#[inline(always)]\n344\tfn stbds_load_32_or_64(v32: usize, v64_hi: usize, v64_lo: usize) -> usize {\n345\t    let mut temp: usize;\n346\t    let mut var: usize;\n347\t    temp = v64_lo ^ v32;\n348\t    temp <<= 16;\n349\t    temp <<= 16;\n350\t    temp >>= 16;\n351\t    temp >>= 16;\n352\t    var = v64_hi;\n353\t    var <<= 16;\n354\t    var <<= 16;\n355\t    var ^= temp ^ v32;\n356\t    var\n357\t}\n358\t\n359\tunsafe fn stbds_make_hash_index(\n360\t    slot_count: usize,\n361\t    ot: *mut stbds_hash_index,\n362\t) -> *mut stbds_hash_index {\n363\t    unsafe {\n364\t        let t = stbds_realloc(\n365\t            ptr::null_mut(),\n366\t            (slot_count >> STBDS_BUCKET_SHIFT)\n367\t                .wrapping_mul(size_of::<stbds_hash_bucket>())\n368\t                .wrapping_add(size_of::<stbds_hash_index>())\n369\t                .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n370\t        ) as *mut stbds_hash_index;\n371\t\n372\t        (*t).storage = align_fwd(\n373\t            (t as usize).wrapping_add(size_of::<stbds_hash_index>()),\n374\t            STBDS_CACHE_LINE_SIZE,\n375\t        ) as *mut stbds_hash_bucket;\n376\t        (*t).slot_count = slot_count;\n377\t        (*t).slot_count_log2 = stbds_log2(slot_count);\n378\t        (*t).tombstone_count = 0;\n379\t        (*t).used_count = 0;\n380\t\n381\t        (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n382\t        (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n383\t        (*t).used_count_shrink_threshold = slot_count >> 2;\n384\t\n385\t        if slot_count <= STBDS_BUCKET_LENGTH {\n386\t            (*t).used_count_shrink_threshold = 0;\n387\t        }\n388\t        assert!(\n389\t            (*t)\n390\t                .used_count_threshold\n391\t                .wrapping_add((*t).tombstone_count_threshold)\n392\t                < (*t).slot_count\n393\t        );\n394\t\n395\t        if !ot.is_null() {\n396\t            (*t).string = (*ot).string;\n397\t            (*t).seed = (*ot).seed;\n398\t        } else {\n399\t            c_memset(\n400\t                &mut (*t).string as *mut stbds_string_arena as *mut c_void,\n401\t                0,\n402\t                size_of::<stbds_string_arena>(),\n403\t            );\n404\t            (*t).seed = stbds_hash_seed;\n405\t            let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n406\t            let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n407\t            stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n408\t        }\n409\t\n410\t        {\n411\t            let mut i: usize = 0;\n412\t            while i < slot_count >> STBDS_BUCKET_SHIFT {\n413\t                let b = (*t).storage.add(i);\n414\t                for j in 0..STBDS_BUCKET_LENGTH {\n415\t                    (*b).hash[j] = STBDS_HASH_EMPTY;\n416\t                }\n417\t                for j in 0..STBDS_BUCKET_LENGTH {\n418\t                    (*b).index[j] = STBDS_INDEX_EMPTY;\n419\t                }\n420\t                i += 1;\n421\t            }\n422\t        }\n423\t\n424\t        if !ot.is_null() {\n425\t            (*t).used_count = (*ot).used_count;\n426\t            let mut i: usize = 0;\n427\t            while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n428\t                let ob = (*ot).storage.add(i);\n429\t                for j in 0..STBDS_BUCKET_LENGTH {\n430\t                    if (*ob).index[j] >= 0 {\n431\t                        let hash = (*ob).hash[j];\n432\t                        let mut pos =\n433\t                            stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n434\t                        let mut step = STBDS_BUCKET_LENGTH;\n435\t                        'probe: loop {\n436\t                            let bucket = (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n437\t\n438\t                            let mut z = pos & STBDS_BUCKET_MASK;\n439\t                            while z < STBDS_BUCKET_LENGTH {\n440\t                                if (*bucket).hash[z] == 0 {\n441\t                                    (*bucket).hash[z] = hash;\n442\t                                    (*bucket).index[z] = (*ob).index[j];\n443\t                                    break 'probe;\n444\t                                }\n445\t                                z += 1;\n446\t                            }\n447\t\n448\t                            let limit = pos & STBDS_BUCKET_MASK;\n449\t                            for z in 0..limit {\n450\t                                if (*bucket).hash[z] == 0 {\n451\t                                    (*bucket).hash[z] = hash;\n452\t                                    (*bucket).index[z] = (*ob).index[j];\n453\t                                    break 'probe;\n454\t                                }\n455\t                            }\n456\t\n457\t                            pos = pos.wrapping_add(step);\n458\t                            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n459\t                            pos &= (*t).slot_count.wrapping_sub(1);\n460\t                        }\n461\t                    }\n462\t                }\n463\t                i += 1;\n464\t            }\n465\t        }\n466\t\n467\t        t\n468\t    }\n469\t}\n470\t\n471\t// ---------------------------------------------------------------------------\n472\t// hashing\n473\t// ---------------------------------------------------------------------------\n474\t\n475\t#[unsafe(no_mangle)]\n476\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n477\t    unsafe {\n478\t        let mut str_ = str_;\n479\t        let mut hash = seed;\n480\t        while *str_ != 0 {\n481\t            let c = *str_ as u8 as usize;\n482\t            hash = rotate_left(hash, 9).wrapping_add(c);\n483\t            str_ = str_.add(1);\n484\t        }\n485\t\n486\t        hash ^= seed;\n487\t        hash = (!hash).wrapping_add(hash << 18);\n488\t        hash ^= hash ^ rotate_right(hash, 31);\n489\t        hash = hash.wrapping_mul(21);\n490\t        hash ^= hash ^ rotate_right(hash, 11);\n491\t        hash = hash.wrapping_add(hash << 6);\n492\t        hash ^= rotate_right(hash, 22);\n493\t        hash.wrapping_add(seed)\n494\t    }\n495\t}\n496\t\n497\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n498\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n499\t\n500\t#[inline(always)]\n501\tfn siphash_round(v0: &mut usize, v1: &mut usize, v2: &mut usize, v3: &mut usize) {\n502\t    *v0 = v0.wrapping_add(*v1);\n503\t    *v1 = rotate_left(*v1, 13);\n504\t    *v1 ^= *v0;\n505\t    *v0 = rotate_left(*v0, STBDS_SIZE_T_BITS / 2);\n506\t    *v2 = v2.wrapping_add(*v3);\n507\t    *v3 = rotate_left(*v3, 16);\n508\t    *v3 ^= *v2;\n509\t    *v2 = v2.wrapping_add(*v1);\n510\t    *v1 = rotate_left(*v1, 17);\n511\t    *v1 ^= *v2;\n512\t    *v2 = rotate_left(*v2, STBDS_SIZE_T_BITS / 2);\n513\t    *v0 = v0.wrapping_add(*v3);\n514\t    *v3 = rotate_left(*v3, 21);\n515\t    *v3 ^= *v0;\n516\t}\n517\t\n518\t/// Reproduces `data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);` where the\n519\t/// right hand side is computed in `int` and then (possibly sign-) extended to\n520\t/// `size_t` -- for `d[3] >= 0x80` the C expression is negative and therefore sets\n521\t/// every high bit of the resulting `size_t`.\n522\t#[inline(always)]\n523\tunsafe fn load_int_le32(d: *const u8) -> usize {\n524\t    unsafe {\n525\t        let v: i32 = (*d.add(0) as i32)\n526\t            | ((*d.add(1) as i32) << 8)\n527\t            | ((*d.add(2) as i32) << 16)\n528\t            | ((*d.add(3) as i32) << 24);\n529\t        v as i64 as u64 as usize\n530\t    }\n531\t}\n532\t\n533\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n534\t    unsafe {\n535\t        let mut d = p as *const u8;\n536\t        let mut i: usize;\n537\t        let mut data: usize;\n538\t\n539\t        let mut v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n540\t        let mut v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n541\t        let mut v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n542\t        let mut v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n543\t\n544\t        v0 ^= 0x0706050403020100u64 as usize ^ seed;\n545\t        v1 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n546\t        v2 ^= 0x0706050403020100u64 as usize ^ seed;\n547\t        v3 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n548\t\n549\t        i = 0;\n550\t        while i.wrapping_add(size_of::<usize>()) <= len {\n551\t            data = load_int_le32(d);\n552\t            // discarded if size_t == 4\n553\t            data |= (load_int_le32(d.add(4)) << 16) << 16;\n554\t\n555\t            v3 ^= data;\n556\t            for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n557\t                siphash_round(&mut v0, &mut v1, &mut v2, &mut v3);\n558\t            }\n559\t            v0 ^= data;\n560\t\n561\t            i = i.wrapping_add(size_of::<usize>());\n562\t            d = d.add(size_of::<usize>());\n563\t        }\n564\t\n565\t        data = len << (STBDS_SIZE_T_BITS - 8);\n566\t        // C switch with fall-through: case k performs the work of cases k..1.\n567\t        let rem = len.wrapping_sub(i);\n568\t        if rem >= 7 {\n569\t            data |= ((*d.add(6) as usize) << 24) << 24;\n570\t        }\n571\t        if rem >= 6 {\n572\t            data |= ((*d.add(5) as usize) << 20) << 20;\n573\t        }\n574\t        if rem >= 5 {\n575\t            data |= ((*d.add(4) as usize) << 16) << 16;\n576\t        }\n577\t        if rem >= 4 {\n578\t            // int expression -> sign extended when d[3] >= 0x80\n579\t            data |= (((*d.add(3) as i32) << 24) as i64 as u64) as usize;\n580\t        }\n581\t        if rem >= 3 {\n582\t            data |= ((*d.add(2) as i32) << 16) as usize;\n583\t        }\n584\t        if rem >= 2 {\n585\t            data |= ((*d.add(1) as i32) << 8) as usize;\n586\t        }\n587\t        if rem >= 1 {\n588\t            data |= *d.add(0) as usize;\n589\t        }\n590\t\n591\t        v3 ^= data;\n592\t        for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n593\t            siphash_round(&mut v0, &mut v1, &mut v2, &mut v3);\n594\t        }\n595\t        v0 ^= data;\n596\t        v2 ^= 0xff;\n597\t        for _ in 0..STBDS_SIPHASH_D_ROUNDS {\n598\t            siphash_round(&mut v0, &mut v1, &mut v2, &mut v3);\n599\t        }\n600\t\n601\t        v0 ^ v1 ^ v2 ^ v3\n602\t    }\n603\t}\n604\t\n605\t#[unsafe(no_mangle)]\n606\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n607\t    unsafe { stbds_siphash_bytes(p, len, seed) }\n608\t}\n609\t\n610\t// ---------------------------------------------------------------------------\n611\t// hash map\n612\t// ---------------------------------------------------------------------------\n613\t\n614\tunsafe fn stbds_is_key_equal(\n615\t    a: *mut c_void,\n616\t    elemsize: usize,\n617\t    key: *mut c_void,\n618\t    keysize: usize,\n619\t    keyoffset: usize,\n620\t    mode: c_int,\n621\t    i: usize,\n622\t) -> c_int {\n623\t    unsafe {\n624\t        let slot = byte_add(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset));\n625\t        if mode >= STBDS_HM_STRING {\n626\t            (0 == strcmp(key as *const c_char, *(slot as *mut *const c_char))) as c_int\n627\t        } else {\n628\t            (0 == memcmp(key, slot, keysize)) as c_int\n629\t        }\n630\t    }\n631\t}\n632\t\n633\t#[unsafe(no_mangle)]\n634\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n635\t    unsafe {\n636\t        if a.is_null() {\n637\t            return;\n638\t        }\n639\t        if !stbds_hash_table(a).is_null() {\n640\t            if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP {\n641\t     