char;\n970\t                match (*table).string.mode {\n971\t                    STBDS_SH_STRDUP => {\n972\t                        let p = stbds_strdup(key as *mut c_char);\n973\t                        *slot = p;\n974\t                        set_stbds_temp_key(a, p);\n975\t                    }\n976\t                    STBDS_SH_ARENA => {\n977\t                        let p = stbds_stralloc(&mut (*table).string, key as *mut c_char);\n978\t                        *slot = p;\n979\t                        set_stbds_temp_key(a, p);\n980\t                    }\n981\t                    STBDS_SH_DEFAULT => {\n982\t                        let p = key as *mut c_char;\n983\t                        *slot = p;\n984\t                        set_stbds_temp_key(a, p);\n985\t                    }\n986\t                    _ => {\n987\t                        memcpy(slot as *mut c_void, key, keysize);\n988\t                    }\n989\t                }\n990\t            }\n991\t            stbds_arr_to_hash(a, elemsize)\n992\t        }\n993\t    }\n994\t}\n995\t\n996\t#[unsafe(no_mangle)]\n997\tpub unsafe extern \"C\" fn stbds_shmode_func(elemsize: usize, mode: c_int) -> *mut c_void {\n998\t    unsafe {\n999\t        let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n1000\t        c_memset(a, 0, elemsize);\n1001\t        (*stbds_header(a)).length = 1;\n1002\t        let h = stbds_make_hash_index(STBDS_BUCKET_LENGTH, ptr::null_mut());\n1003\t        (*stbds_header(a)).hash_table = h as *mut c_void;\n1004\t        (*h).string.mode = mode as u8;\n1005\t        stbds_arr_to_hash(a, elemsize)\n1006\t    }\n1007\t}\n1008\t\n1009\t#[unsafe(no_mangle)]\n1010\tpub unsafe extern \"C\" fn stbds_hmdel_key(\n1011\t    a: *mut c_void,\n1012\t    elemsize: usize,\n1013\t    key: *mut c_void,\n1014\t    keysize: usize,\n1015\t    keyoffset: usize,\n1016\t    mode: c_int,\n1017\t) -> *mut c_void {\n1018\t    unsafe {\n1019\t        if a.is_null() {\n1020\t            return ptr::null_m