ng_add((*a).remaining).wrapping_sub(len) as *mut c_char;\n1113\t        (*a).remaining = (*a).remaining.wrapping_sub(len);\n1114\t        memmove(p as *mut c_void, str_ as *const c_void, len);\n1115\t        p\n1116\t    }\n1117\t}\n1118\t\n1119\t#[unsafe(no_mangle)]\n1120\tpub unsafe extern \"C\" fn stbds_strreset(a: *mut stbds_string_arena) {\n1121\t    unsafe {\n1122\t        let mut x = (*a).storage;\n1123\t        while !x.is_null() {\n1124\t            let y = (*x).next;\n1125\t            stbds_free(x as *mut c_void);\n1126\t            x = y;\n1127\t        }\n1128\t        c_memset(a as *mut c_void, 0, size_of::<stbds_string_arena>());\n1129\t    }\n1130\t}\n1131\t\n1132\t// ---------------------------------------------------------------------------\n1133\t// test helpers exported by the C library\n1134\t// ---------------------------------------------------------------------------\n1135\t\n1136\tstatic mut buffer: [c_char; 256] = [0; 256];\n1137\t\n1138\t/// `sprintf(buffer, \"test_%d\", n); return buffer;`\n1139\t#[unsafe(no_mangle)]\n1140\tpub unsafe extern \"C\" fn strkey(n: c_int) -> *mut c_char {\n1141\t    unsafe {\n1142\t        let buf = &raw mut buffer as *mut c_char;\n1143\t        let mut pos: usize = 0;\n1144\t\n1145\t        for &c in b\"test_\" {\n1146\t            *buf.add(pos) = c as c_char;\n1147\t            pos += 1;\n1148\t        }\n1149\t\n1150\t        let v = n as i64;\n1151\t        if v < 0 {\n1152\t            *buf.add(pos) = b'-' as c_char;\n1153\t            pos += 1;\n1154\t        }\n1155\t        let mut mag = v.unsigned_abs();\n1156\t        let mut digits = [0u8; 20];\n1157\t        let mut ndigits = 0usize;\n1158\t        loop {\n1159\t            digits[ndigits] = b'0' + (mag % 10) as u8;\n1160\t            ndigits += 1;\n1161\t            mag /= 10;\n1162\t            if mag == 0 {\n1163\t                break;\n1164\t            }\n1165\t        }\n1166\t        while ndigits > 0 {\n1167\t            ndigits -= 1;\n1168\t            *buf.add(pos) = digits[ndigits] as c_char;\n1169\t            pos += 1;\n1170\t        }\n1171\t        *buf.add(pos) = 0;\n1172\t\n1173\t        buf\n1174\t    }\n1175\t}\n1176\t\n1177\t/// Expansion of the C body:\n1178\t/// ```c\n1179\t/// void arr_ins(int num) {\n1180\t///   int *arr=NULL; int i,j;\n1181\t///   for (i=0; i < 5; ++i) {\n1182\t///     arrpush(arr,1); arrpush(arr,2); arrpush(arr,3); arrpush(arr,4);\n1183\t///     stbds_arrins(arr,i,num);\n1184\t///     STBDS_ASSERT(arr[i] == num);\n1185\t///     if (i < 4) STBDS_ASSERT(arr[4] == 4);\n1186\t///     arrfree(arr);\n1187\t///   }\n1188\t/// }\n1189\t/// ```\n1190\t#[unsafe(no_mangle)]\n1191\tpub unsafe extern \"C\" fn arr_ins(num: c_int) {\n1192\t    unsafe {\n1193\t        const ELEMSIZE: usize = size_of::<c_int>();\n1194\t\n1195\t        let mut arr: *mut c_int = ptr::null_mut();\n1196\t\n1197\t        for i in 0..5isize {\n1198\t            // arrpush(arr, 1..4)\n1199\t            for v in 1..=4 as c_int {\n1200\t                // stbds_arrmaybegrow(a,1)\n1201\t                if arr.is_null()\n1202\t                    || (*stbds_header(arr as *const c_void)).length + 1\n1203\t                        > (*stbds_header(arr as *const c_void)).capacity\n1204\t                {\n1205\t                    arr = stbds_arrgrowf(arr as *mut c_void, ELEMSIZE, 1, 0) as *mut c_int;\n1206\t                }\n1207\t                // (a)[stbds_header(a)->length++] = v\n1208\t                let h = stbds_header(arr as *const c_void);\n1209\t                *arr.add((*h).length) = v;\n1210\t                (*h).length += 1;\n1211\t            }\n1212\t\n1213\t            // stbds_arrins(arr,i,num) == stbds_arrinsn(arr,i,1), arr[i] = num\n1214\t            //   stbds_arrinsn -> stbds_arraddn(arr,1) then memmove\n1215\t            {\n1216\t                // stbds_arraddn(a,1) == (void) stbds_arraddnindex(a,1)\n1217\t                if arr.is_null()\n1218\t                    || (*stbds_header(arr a