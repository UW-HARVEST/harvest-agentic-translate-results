.length.wrapping_sub(1);\n1069\t\n1070\t        if (*table).used_count < (*table).used_count_shrink_threshold\n1071\t            && (*table).slot_count > STBDS_BUCKET_LENGTH\n1072\t        {\n1073\t            (*stbds_header(raw_a)).hash_table =\n1074\t                stbds_make_hash_index((*table).slot_count >> 1, table) as *mut c_void;\n1075\t            stbds_free(table as *mut c_void);\n1076\t        } else if (*table).tombstone_count > (*table).tombstone_count_threshold {\n1077\t            (*stbds_header(raw_a)).hash_table =\n1078\t                stbds_make_hash_index((*table).slot_count, table) as *mut c_void;\n1079\t            stbds_free(table as *mut c_void);\n1080\t        }\n1081\t\n1082\t        a\n1083\t    }\n1084\t}\n1085\t\n1086\t// ---------------------------------------------------------------------------\n1087\t// string storage\n1088\t// ---------------------------------------------------------------------------\n1089\t\n1090\tunsafe fn stbds_strdup(str_: *mut c_char) -> *mut c_char {\n1091\t    unsafe {\n1092\t        let len = strlen(str_).wrapping_add(1);\n1093\t        let p = stbds_realloc(ptr::null_mut(), len) as *mut c_char;\n1094\t        memmove(p as *mut c_void, str_ as *const c_void, len);\n1095\t        p\n1096\t    }\n1097\t}\n1098\t\n1099\tconst STBDS_STRING_ARENA_BLOCKSIZE_MIN: usize = 512;\n1100\tconst STBDS_STRING_ARENA_BLOCKSIZE_MAX: usize = 1 << 20;\n1101\t\n1102\t/// `offsetof(stbds_string_block, next)`\n1103\tconst SB_NEXT_OFF: usize = core::mem::offset_of!(stbds_string_block, next);\n1104\t/// `offsetof(stbds_string_block, storage)`\n1105\tconst SB_STORAGE_OFF: usize = core::mem::offset_of!(stbds_string_block, storage);\n1106\tconst _: () = assert!(SB_NEXT_OFF == 0);\n1107\tconst _: () = assert!(SB_STORAGE_OFF == 8);\n1108\t\n1109\t#[unsafe(no_mangle)]\n1110\tpub unsafe extern \"C\" fn stbds_stralloc(\n1111\t    a: *mut stbds_string_arena,\n1112\t    str_: *mut c_char,\n1113\t) -> *mut c_char {\n1114\t    unsafe {\n1115\t        let len = strlen(str_).wrapping_add(1);\n1116\t        if len > (*a).remaining {\n1117\t            let mut blocksize = (*a).block as usize;\n1118\t\n1119\t            blocksize = STBDS_STRING_ARENA_BLOCKSIZE_MIN.wrapping_shl((blocksize >> 1) as u32);\n1120\t\n1121\t            if blocksize < STBDS_STRING_ARENA_BLOCKSIZE_MAX {\n1122\t                (*a).block = (*a).block.wrapping_add(1);\n1123\t            }\n1124\t\n1125\t            if len > blocksize {\n1126\t                let sb = stbds_realloc(\n1127\t                    ptr::null_mut(),\n1128\t                    (size_of::<stbds_string_block>() - 8).wrapping_add(len),\n1129\t                ) as *mut stbds_string_block;\n1130\t                memmove(\n1131\t                    (sb as usize).wrapping_add(SB_STORAGE_OFF) as *mut c_void,\n1132\t                    str_ as *const c_void,\n1133\t                    len,\n1134\t                );\n1135\t                if !(*a).storage.is_null() {\n1136\t                    // sb->next = a->storage->next;  a->storage->next = sb;\n1137\t                    let an: *mut stbds_string_block =\n1138\t                        raw_load_ptr(((*a).storage as usize).wrapping_add(SB_NEXT_OFF));\n1139\t                    raw_store_ptr((sb as usize).wrapping_add(SB_NEXT_OFF), an);\n1140\t                    raw_store_ptr(((*a).storage as usize).wrapping_add(SB_NEXT_OFF), sb);\n1141\t                } else {\n1142\t                    raw_store_ptr(\n1143\t                        (sb as usize).wrapping_add(SB_NEXT_OFF),\n1144\t                        ptr::null_mut::<stbds_string_block>(),\n1145\t                    );\n1146\t                    (*a).storage = sb;\n1147\t                    (*a).remaining = 0;\n1148\t                }\n1149\t                return (sb as usize).wrapping_add(SB_STORAGE_OFF) as *mut c_char;\n1150\t            } else {\n1151\t                let sb = stbds_realloc(\n1152\t                    ptr::null_mut(),\n1153\t                    (size_of::<stbds_string_block>() - 8).wrapping_add(blocksize),\n1154\t                ) as *mut stbds_string_block;\n1155\t                raw_store_ptr((sb as usize).wrapping_add(SB_NEXT_OFF), (*a).storage);\n1156\t                (*a).storage = sb;\n1157\t                (*a).remaining = blocksize;\n1158\t            }\n1159\t        }\n1160\t\n1161\t        assert!(len <= (*a).remaining);\n1162\t        let base = ((*a).storage as usize).wrapping_add(SB_STORAGE_OFF);\n1163\t        let p = base.wrapping_add((*a).remaining).wrapping_sub(len) as *mut c_char;\n1164\t        (*a).remaining = (*a).remaining.wrapping_sub(len);\n1165\t        memmove(p as *mut c_void, str_ as *const c_void, len);\n1166\t        p\n1167\t    }\n1168\t}\n1169\t\n1170\t#[unsafe(no_mangle)]\n1171\tpub unsafe extern \"C\" fn stbds_strreset(a: *mut stbds_string_arena) {\n1172\t    unsafe {\n1173\t        let mut x = (*a).storage;\n1174\t        while !x.is_null() {\n1175\t            let y: *mut stbds_string_block =\n1176\t                raw_load_ptr((x as usize).wrapping_add(SB_NEXT_OFF));\n1177\t            stbds_free(x as *mut c_void);\n1178\t            x = y;\n1179\t        }\n1180\t        c_memset(a as *mut c_void, 0, size_of::<stbds_string_arena>());\n1181\t    }\n1182\t}\n1183\t\n1184\t// ---------------------------------------------------------------------------\n1185\t// test helpers exported by the C library\n1186\t// ---------------------------------------------------------------------------\n1187\t\n1188\tstatic mut buffer: [c_char; 256] = [0; 256];\n1189\t\n1190\t/// `sprintf(buffer, \"test_%d\", n); return buffer;`\n1191\t#[unsafe(no_mangle)]\n1192\tpub unsafe extern \"C\" fn strkey(n: c_int) -> *mut c_char {\n1193\t    unsafe {\n1194\t        let buf = &raw mut buffer as *mut c_char;\n1195\t        let mut pos: usize = 0;\n1196\t\n1197\t        for &c in b\"test_\" {\n1198\t            *buf.add(pos) = c as c_char;\n1199\t            pos += 1;\n1200\t        }\n1201\t\n1202\t        let v = n as i64;\n1203\t        if v < 0 {\n1204\t            *buf.add(pos) = b'-' as c_char;\n1205\t            pos += 1;\n1206\t        }\n1207\t        let mut mag = v.unsigned_abs();\n1208\t        let mut digits = [0u8; 20];\n1209\t        let mut ndigits = 0usize;\n1210\t        loop {\n1211\t            digits[ndigits] = b'0' + (mag % 10) as u8;\n1212\t            ndigits += 1;\n1213\t            mag /= 10;\n1214\t            if mag == 0 {\n1215\t                break;\n1216\t            }\n1217\t        }\n1218\t        while ndigits > 0 {\n1219\t            ndigits -= 1;\n1220\t            *buf.add(pos) = digits[ndigits] as c_char;\n1221\t            pos += 1;\n1222\t        }\n1223\t        *buf.add(pos) = 0;\n1224\t\n1225\t        buf\n1226\t    }\n1227\t}\n1228\t\n1229\t/// Expansion of the C body:\n1230\t/// ```c\n1231\t/// void arr_ins(int num) {\n1232\t///   int *arr=NULL; int i,j;\n1233\t///   for (i=0; i < 5; ++i) {\n1234\t///     arrpush(arr,1); arrpush(arr,2); arrpush(arr,3); arrpush(arr,4);\n1235\t///     stbds_arrins(arr,i,num);\n1236\t///     STBDS_ASSERT(arr[i] == num);\n1237\t///     if (i < 4) STBDS_ASSERT(arr[4] == 4);\n1238\t///     arrfree(arr);\n1239\t///   }\n1240\t/// }\n1241\t/// ```\n1242\t#[unsafe(no_mangle)]\n1243\tpub unsafe extern \"C\" fn arr_ins(num: c_int) {\n1244\t    unsafe {\n1245\t        const ELEMSIZE: usize = size_of::<c_int>();\n1246\t\n1247\t        let mut arr: *mut c_int = ptr::null_mut();\n1248\t\n1249\t        for i in 0..5isize {\n1250\t            // arrpush(arr, 1..4)\n1251\t            for v in 1..=4 as c_int {\n1252\t                // stbds_arrmaybegrow(a,1)\n1253\t                if arr.is_null()\n1254\t                    || (*stbds_header(arr as *const c_void)).length.wrapping_add(1)\n1255\t                        > (*stbds_header(arr as *const c_void)).capacity\n1256\t                {\n1257\t                    arr = stbds_arrgrowf(arr as *mut c_void, ELEMSIZE, 1, 0) as *mut c_int;\n1258\t                }\n1259\t                // (a)[stbds_header(a)->length++] = v\n1260\t                let h = stbds_header(arr as *const c_void);\n1261\t                *arr.add((*h).length) = v;\n1262\t                (*h).length = (*h).length.wrapping_add(1);\n1263\t            }\n1264\t\n1265\t            // stbds_arrins(arr,i,num) == stbds_arrinsn(arr,i,1), arr[i] = num\n1266\t            //   stbds_arrinsn -> stbds_arraddn(arr,1) then memmove\n1267\t            {\n1268\t                // stbds_arraddn(a,1) == (void) stbds_arraddnindex(a,1)\n1269\t                if arr.is_null()\n1270\t                    || (*stbds_header(arr as *const c_void)).length.wrapping_add(1)\n1271\t                        > (*stbds_header(arr as *const c_void)).capacity\n1272\t                {\n1273\t                    arr = stbds_arrgrowf(arr as *mut c_void, ELEMSIZE, 1, 0) as *mut c_int;\n1274\t                }\n1275\t                let h = stbds_header(arr as *const c_void);\n1276\t                (*h).length = (*h).length.wrapping_add(1);\n1277\t\n1278\t                // memmove(&a[i+1], &a[i], sizeof *a * (length - 1 - i))\n1279\t                let n: usize = 1;\n1280\t                let count = (*h)\n1281\t                    .length\n1282\t                    .wrapping_sub(n)\n1283\t                    .wrapping_sub(i as usize);\n1284\t                memmove(\n1285\t                    arr.offset(i + n as isize) as *mut c_void,\n1286\t                    arr.offset(i) as *const c_void,\n1287\t                    ELEMSIZE.wrapping_mul(count),\n1288\t                );\n1289\t                *arr.offset(i) = num;\n1290\t            }\n1291\t\n1292\t            assert!(*arr.offset(i) == num);\n1293\t            if i < 4 {\n1294\t                assert!(*arr.offset(4) == 4);\n1295\t            }\n1296\t\n1297\t            // arrfree(arr)\n1298\t            if !arr.is_null() {\n1299\t                stbds_free(stbds_header(arr as *const c_void) as *mut c_void);\n1300\t            }\n1301\t            arr = ptr::null_mut();\n1302\t        }\n1303\t    }\n1304\t}\n1305\t"}]},"parent_tool_use_id":"toolu_bdrk_01RaEq6ZMffNso8L5p3Xjmzh","session_id":"aae41731-ad07-4556-b28d-c5975b42818a","uuid":"3f207f03-7eda-4921-bcb0-c0b740343ad4","timestamp":"2026-08-27T05:47:07.621Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust line by line"}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_gsvzsphg2hdlmduii7dk2o5liif3bql3gfsy3rx7prnazo3e63ia","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01LCuNeQxgaHoAq9hBAZTmDZ","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-VR2NVk/translation/tests/phase_b_stress.rs","content":"//! Phase B — long randomized property runs that mix every entry point.\n//!\n//! The per-row tests each pin one configuration; these runs interleave them so\n//! that composed states (rehash-of-a-rehashed-table, tombstone reuse across a\n//! shrink, arena growth while a map is churning, ...) get hit as well. Every\n//! op is compared byte-for-byte immediately.\nmod common;\nuse common::*;\nuse std::ffi::c_void;\nuse std::os::raw::{c_char, c_int};\n\n// --- long hash-function sweep, including big buffers -------------------------\n#[test]\nfn stress_hash_long_buffers() {\n    let p = fresh_pair(1);\n    let mut rng = Rng::new(0xFEED_0001);\n    for _ in 0..1500 {\n        let len = match rng.below(4) {\n            0 => rng.below(8),\n            1 => rng.below(64),\n            2 => rng.below(512),\n            _ => rng.below(4096),\n        };\n        let mut b = rng.bytes(len + 8);\n        let seed = match rng.below(4) {\n            0 => 0,\n            1 => usize::MAX,\n            2 => 1usize << rng.below(64),\n            _ => rng.next_u64() as usize,\n        };\n        unsafe {\n            same_val(\n                &format!(\"stress hash_bytes len={len} seed={seed:#x}\"),\n                (p.c.hash_bytes)(b.as_mut_ptr() as *mut c_void, len, seed),\n                (p.r.hash_bytes)(b.as_mut_ptr() as *mut c_void, len, seed),\n            );\n        }\n        // and as a string (NUL-terminate a copy so lengths vary too)\n        let mut s: Vec<u8> = b[..len].iter().map(|&x| if x == 0 { 1 } else { x }).collect();\n        s.push(0);\n        unsafe {\n            same_val(\n                &format!(\"stress hash_string len={len} seed={seed:#x}\"),\n                (p.c.hash_string)(s.as_mut_ptr() as *mut c_char, seed),\n                (p.r.hash_string)(s.as_mut_ptr() as *mut c_char, seed),\n            );\n        }\n    }\n}\n\n// --- long array-macro pipeline over many element sizes -----------------------\n#[test]\nfn stress_array_pipeline() {\n    let p = fresh_pair(2);\n    for &elemsize in &[1usize, 2, 3, 5, 8, 13, 16, 24, 33, 64] {\n        let mut rng = Rng::new(0xFEED_0002 ^ elemsize as u64);\n        let mut a = DiffArr::new(&p, elemsize);\n        for step in 0..600 {\n            let len = unsafe { DiffArr::len(a.ca) };\n            let ctx = format!(\"stress-arr elemsize={elemsize} step={step} len={len}\");\n            match rng.below(10) {\n                0..=3 => a.put(&rng.bytes(elemsize)),\n                4 => {\n                    if len > 0 {\n                        let (c, r) = a.pop();\n                        same_val(&format!(\"{ctx} pop\"), c, r);\n                    }\n                }\n                5 => {\n                    let (c, r) = a.addn(rng.below(17));\n                    same_val(&format!(\"{ctx} addn\"), c, r);\n                }\n                6 => {\n                    let i = if len == 0 { 0 } else { rng.below(len + 1) };\n                    a.ins(i, &rng.bytes(elemsize));\n                }\n                7 => {\n                    if len > 0 {\n                        let i = rng.below(len);\n                        a.deln(i, 1 + rng.below(len - i));\n                    }\n                }\n                8 => {\n                    if len > 0 {\n                        a.delswap(rng.below(len));\n                    }\n                }\n                _ => a.setcap(rng.below(300)),\n            }\n            a.check(&ctx);\n        }\n        a.free();\n    }\n}\n\n// --- very long map pipeline, all modes, all storage modes -------------------\nfn map_stress(tag: &str, seed: u64, elemsize: usize, mode: c_int, shmode: Option<c_int>, steps: usize) {\n    let p = fresh_pair(seed as usize);\n    let string_side = mode >= HM_STRING;\n    let keysize = if string_side { 8 } else { 8 };\n    let keyrepr = KeyRepr::Auto;\n    let mut m = match shmode {\n        Some(sm) => DiffMap::shmode(&p, elemsize, keysize, mode, sm, keyrepr),\n        None => DiffMap::lazy(&p, elemsize, keysize, mode, keyrepr),\n    };\n    // A SH_NONE-style table combined with string mode needs self-referential\n    // keys so that `stbds_is_key_equal` can dereference the memcpy'd bytes.\n    let needs_selfkeys = string_side\n        && match shmode {\n            None => false,\n            Some(sm) => !matches!((sm as u32 & 0xff) as u8, 1 | 2 | 3),\n        };\n    let sk = if needs_selfkeys { Some(SelfKeys::new(200)) } else { None };\n\n    let mut rng = Rng::new(seed);\n    let mut ka = KeyArena::new();\n    let mut live: Vec<*mut u8> = Vec::new();\n    let mut dead: Vec<*mut u8> = Vec::new();\n    let mut next = 0usize;\n    for step in 0..steps {\n        let ctx = format!(\"{tag} elemsize={elemsize} mode={mode} shmode={shmode:?} step={step}\");\n        match rng.below(12) {\n            0..=4 => {\n                // fresh insert (unique key so the reverse-delete rule holds)\n                let k = match &sk {\n                    Some(s) => {\n                        if next >= s.keys.len() {\n                            continue;\n                        }\n                        let k = s.keys[next];\n                        next += 1;\n                        k\n                    }\n                    None => {\n                        let kb = if string_side {\n                            let mut v = format!(\"s{next}_\").into_bytes();\n                            let t = rng.cstring_range(0, 12, ASCII);\n                            v.extend_from_slice(&t[..t.len() - 1]);\n                            v.push(0);\n                            v\n                        } else {\n                            let mut v = rng.bytes(keysize);\n                            v[..4].copy_from_slice(&(next as u32).to_le_bytes());\n                            v\n                        };\n                        next += 1;\n                        ka.add(&kb)\n                    }\n                };\n                live.push(k);\n                let (a, b) = m.put(k, &rng.bytes(elemsize));\n                same_val(&format!(\"{ctx} put temp\"), a, b);\n            }\n            5 => {\n                if !live.is_empty() {\n                    let k = live[rng.below(live.len())];\n                    let (a, b) = m.put(k, &rng.bytes(elemsize));\n                    same_val(&format!(\"{ctx} re-put temp\"), a, b);\n                }\n            }\n            6 | 7 => {\n                if !live.is_empty() {\n                    let k = live[rng.below(live.len())];\n                    let (a, b) = m.get(k);\n                    same_val(&format!(\"{ctx} get temp\"), a, b);\n                }\n            }\n            8 => {\n                if !dead.is_empty() {\n                    let k = dead[rng.below(dead.len())];\n                    let (a, b) = m.get_ts(k);\n                    same_val(&format!(\"{ctx} get_ts(dead) temp\"), a, b);\n                }\n            }\n            9 | 10 => {\n                // delete the most recently inserted live key: keeps\n                // old_index == final_index, which is required for mode >= 2\n                // (see the E67 note in ERRORS.md).\n                if let Some(k) = live.pop() {\n                    dead.push(k);\n                    let (a, b) = m.del(k, 0);\n                    same_val(&format!(\"{ctx} del temp\"), a, b);\n                }\n            }\n            _ => {\n                m.put_default(&rng.bytes(elemsize));\n            }\n        }\n        m.check(&ctx);\n    }\n    m.free();\n    std::mem::forget(ka);\n}\n\n#[test]\nfn stress_map_binary() {\n    for (i, &elemsize) in [8usize, 16, 24, 40].iter().enumerate() {\n        for &mode in &[HM_BINARY, -1, c_int::MIN] {\n            map_stress(\n                \"stress-bin\",\n                0xFEED_0100 + i as u64 + (mode as i64 as u64) & 0xffff_ffff,\n                elemsize,\n                mode,\n                None,\n                700,\n            );\n        }\n    }\n}\n\n#[test]\nfn stress_map_string_lazy() {\n    for (i, &elemsize) in [8usize, 16, 24, 40].iter().enumerate() {\n        for &mode in &[HM_STRING, 2, c_int::MAX] {\n            map_stress(\n                \"stress-str-lazy\",\n                0xFEED_0200 + i as u64 + (mode as u32 as u64),\n                elemsize,\n                mode,\n                None,\n                700,\n            );\n        }\n    }\n}\n\n#[test]\nfn stress_map_string_shmodes() {\n    for (i, &shmode) in [SH_NONE, SH_DEFAULT, SH_STRDUP, SH_ARENA, 7, 255].iter().enumerate() {\n        for &elemsize in &[8usize, 16, 32] {\n            for &mode in &[HM_STRING, 2] {\n                map_stress(\n                    \"stress-str-sh\",\n                    0xFEED_0300 + i as u64 * 7 + elemsize as u64,\n                    elemsize,\n                    mode,\n                    Some(shmode),\n                    400,\n                );\n            }\n        }\n    }\n}\n\n// --- arena churn interleaved with map churn ---------------------------------\n#[test]\nfn stress_arena_and_map_interleaved() {\n    let p = fresh_pair(9);\n    let elemsize = 24usize;\n    let mut rng = Rng::new(0xFEED_0400);\n    let mut m = DiffMap::shmode(&p, elemsize, 8, HM_STRING, SH_ARENA, KeyRepr::CharPtr);\n    let mut ka = KeyArena::new();\n    let mut live: Vec<*mut u8> = Vec::new();\n    let mut ca = Box::new(CArena::zeroed());\n    let mut ra = Box::new(CArena::zeroed());\n    let mut next = 0usize;\n    for step in 0..800 {\n        let ctx = format!(\"stress-mix step={step}\");\n        if rng.below(3) == 0 {\n            // independent arena op\n            let n = rng.below(900);\n            let mut s = rng.cstring(n, ASCII);\n            unsafe {\n                let cp = (p.c.stralloc)(&mut *ca, s.as_mut_ptr() as *mut c_char);\n                let rp = (p.r.stralloc)(&mut *ra, s.as_mut_ptr() as *mut c_char);\n                same_val(&format!(\"{ctx} stralloc content\"), cstr(cp), cstr(rp));\n                same_val(\n                    &format!(\"{ctx} arena scalars\"),\n                    (ca.remaining, ca.block, ca.mode),\n                    (ra.remaining, ra.block, ra.mode),\n                );\n            }\n            if rng.below(30) == 0 {\n                unsafe {\n                    (p.c.strreset)(&mut *ca);\n                    (p.r.strreset)(&mut *ra);\n                }\n            }\n        } else if rng.below(4) != 0 || live.is_empty() {\n            let mut kb = format!(\"m{next}_\").into_bytes();\n            let t = rng.cstring_range(0, 20, ASCII);\n            kb.extend_from_slice(&t[..t.len() - 1]);\n            kb.push(0);\n            next += 1;\n            let k = ka.add(&kb);\n            live.push(k);\n            let (a, b) = m.put(k, &rng.bytes(elemsize));\n            same_val(&format!(\"{ctx} put temp\"), a, b);\n        } else if let Some(k) = live.pop() {\n            let (a, b) = m.del(k, 0);\n            same_val(&format!(\"{ctx} del temp\"), a, b);\n        }\n        m.check(&ctx);\n    }\n    unsafe {\n        (p.c.strreset)(&mut *ca);\n        (p.r.strreset)(&mut *ra);\n    }\n    m.free();\n    std::mem::forget(ka);\n}\n\n// --- rand_seed re-seeding in the middle of a workload -----------------------\n#[test]\nfn stress_reseed_midflight() {\n    let p = pair();\n    let elemsize = 16usize;\n    let mut rng = Rng::new(0xFEED_0500);\n    unsafe {\n        (p.c.rand_seed)(0xAAAA);\n        (p.r.rand_seed)(0xAAAA);\n    }\n    let mut maps: Vec<DiffMap> = Vec::new();\n    let mut arenas: Vec<KeyArena> = Vec::new();\n    for round in 0..14 {\n        // reseed between map creations: each new table captures the *current*\n        // global seed, then advances it by the LCG step\n        let s = rng.next_u64() as usize;\n        unsafe {\n            (p.c.rand_seed)(s);\n            (p.r.rand_seed)(s);\n        }\n        let mut m = DiffMap::lazy(&p, elemsize, 8, HM_BINARY, KeyRepr::Inline);\n        let mut ka = KeyArena::new();\n        for i in 0..40 {\n            let mut kb = rng.bytes(8);\n            kb[..4].copy_from_slice(&(i as u32).to_le_bytes());\n            let k = ka.add(&kb);\n            m.put(k, &rng.bytes(elemsize));\n            m.check(&format!(\"stress-reseed round={round} put#{i}\"));\n        }\n        unsafe {\n            same_val(\n                &format!(\"stress-reseed round={round} captured seed\"),\n                table_of(m.ct, elemsize).unwrap().seed,\n                table_of(m.rt, elemsize).unwrap().seed,\n            );\n        }\n        maps.push(m);\n        arenas.push(ka);\n    }\n    // interleave operations across all the live maps\n    for step in 0..600 {\n        let i = rng.below(maps.len());\n        let mut kb = rng.bytes(8);\n        kb[..4].copy_from_slice(&(rng.next_u32() % 40).to_le_bytes());\n        let k = arenas[i].add(&kb);\n        match rng.below(3) {\n            0 => {\n                let v = rng.bytes(elemsize);\n                let (a, b) = maps[i].put(k, &v);\n                same_val(&format!(\"stress-reseed x step={step} put\"), a, b);\n            }\n            1 => {\n                let (a, b) = maps[i].get(k);\n                same_val(&format!(\"stress-reseed x step={step} get\"), a, b);\n            }\n            _ => {\n                let (a, b) = maps[i].get_ts(k);\n                same_val(&format!(\"stress-reseed x step={step} get_ts\"), a, b);\n            }\n        }\n        maps[i].check(&format!(\"stress-reseed x step={step} map#{i}\"));\n    }\n    for mut m in maps {\n        m.free();\n    }\n    for ka in arenas {\n        std::mem::forget(ka);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2045,"cache_read_input_tokens":328674,"cache_creation":{"ephemeral_5m_input_tokens":2045,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"aae41731-ad07-4556-b28d-c5975b42818a","uuid":"2ca73b4c-481a-431c-9906-259e69e4ef70","timestamp":"2026-08-27T05:47:55.950Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LCuNeQxgaHoAq9hBAZTmDZ","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-VR2NVk/translation/tests/phase_b_stress.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"aae41731-ad07-4556-b28d-c5975b42818a","uuid":"0c55518e-efdd-4ad7-acff-0848dc0eee13","timestamp":"2026-08-27T05:47:55.962Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-VR2NVk/translation/tests/phase_b_stress.rs","content":"//! Phase B — long randomized property runs that mix every entry point.\n//!\n//! The per-row tests each pin one configuration; these runs interleave them so\n//! that composed states (rehash-of-a-rehashed-table, tombstone reuse across a\n//! shrink, arena growth while a map is churning, ...) get hit as well. Every\n//! op is compared byte-for-byte immediately.\nmod common;\nuse common::*;\nuse std::ffi::c_void;\nuse std::os::raw::{c_char, c_int};\n\n// --- long hash-function sweep, including big buffers -------------------------\n#[test]\nfn stress_hash_long_buffers() {\n    let p = fresh_pair(1);\n    let mut rng = Rng::new(0xFEED_0001);\n    for _ in 0..1500 {\n        let len = match rng.below(4) {\n            0 => rng.below(8),\n            1 => rng.below(64),\n            2 => rng.below(512),\n            _ => rng.below(4096),\n        };\n        let mut b = rng.bytes(len + 8);\n        let seed = match rng.below(4) {\n            0 => 0,\n            1 => usize::MAX,\n            2 => 1usize << rng.below(64),\n            _ => rng.next_u64() as usize,\n        };\n        unsafe {\n            same_val(\n                &format!(\"stress hash_bytes len={len} seed={seed:#x}\"),\n                (p.c.hash_bytes)(b.as_mut_ptr() as *mut c_void, len, seed),\n                (p.r.hash_bytes)(b.as_mut_ptr() as *mut c_void, len, seed),\n            );\n        }\n        // and as a string (NUL-terminate a copy so lengths vary too)\n        let mut s: Vec<u8> = b[..len].iter().map(|&x| if x == 0 { 1 } else { x }).collect();\n        s.push(0);\n        unsafe {\n            same_val(\n                &format!(\"stress hash_string len={len} seed={seed:#x}\"),\n                (p.c.hash_string)(s.as_mut_ptr() as *mut c_char, seed),\n                (p.r.hash_string)(s.as_mut_ptr() as *mut c_char, seed),\n            );\n        }\n    }\n}\n\n// --- long array-macro pipeline over many element sizes -----------------------\n#[test]\nfn stress_array_pipeline() {\n    let p = fresh_pair(2);\n    for &elemsize in &[1usize, 2, 3, 5, 8, 13, 16, 24, 33, 64] {\n        let mut rng = Rng::new(0xFEED_0002 ^ elemsize as u64);\n        let mut a = DiffArr::new(&p, elemsize);\n        for step in 0..600 {\n            let len = unsafe { DiffArr::len(a.ca) };\n            let ctx = format!(\"stress-arr elemsize={elemsize} step={step} len={len}\");\n            match rng.below(10) {\n                0..=3 => a.put(&rng.bytes(elemsize)),\n                4 => {\n                    if len > 0 {\n                        let (c, r) = a.pop();\n                        same_val(&format!(\"{ctx} pop\"), c, r);\n                    }\n                }\n                5 => {\n                    let (c, r) = a.addn(rng.below(17));\n                    same_val(&format!(\"{ctx} addn\"), c, r);\n                }\n                6 => {\n                    let i = if len == 0 { 0 } else { rng.below(len + 1) };\n                    a.ins(i, &rng.bytes(elemsize));\n                }\n                7 => {\n                    if len > 0 {\n                        let i = rng.below(len);\n                        a.deln(i, 1 + rng.below(len - i));\n                    }\n                }\n                8 => {\n                    if len > 0 {\n                        a.delswap(rng.below(len));\n                    }\n                }\n                _ => a.setcap(rng.below(300)),\n            }\n            a.check(&ctx);\n        }\n        a.free();\n    }\n}\n\n// --- very long map pipeline, all modes, all storage modes -------------------\nfn map_stress(tag: &str, seed: u64, elemsize: usize, mode: c_int, shmode: Option<c_int>, steps: usize) {\n    let p = fresh_pair(seed as usize);\n    let string_side = mode >= HM_STRING;\n    let keysize = if string_side { 8 } else { 8 };\n    let keyrepr = KeyRepr::Auto;\n    let mut m = match shmode {\n        Some(sm) => DiffMap::shmode(&p, elemsize, keysize, mode, sm, keyrepr),\n        None => DiffMap::lazy(&p, elemsize, keysize, mode, keyrepr),\n    };\n    // A SH_NONE-style table combined with string mode needs self-referential\n    // keys so that `stbds_is_key_equal` can dereference the memcpy'd bytes.\n    let needs_selfkeys = string_side\n        && match shmode {\n            None => false,\n            Some(sm) => !matches!((sm as u32 & 0xff) as u8, 1 | 2 | 3),\n        };\n    let sk = if needs_selfkeys { Some(SelfKeys::new(200)) } else { None };\n\n    let mut rng = Rng::new(seed);\n    let mut ka = KeyArena::new();\n    let mut live: Vec<*mut u8> = Vec::new();\n    let mut dead: Vec<*mut u8> = Vec::new();\n    let mut next = 0usize;\n    for step in 0..steps {\n        let ctx = format!(\"{tag} elemsize={elemsize} mode={mode} shmode={shmode:?} step={step}\");\n        match rng.below(12) {\n            0..=4 => {\n                // fresh insert (unique key so the reverse-delete rule holds)\n                let k = match &sk {\n                    Some(s) => {\n                        if next >= s.keys.len() {\n                            continue;\n                        }\n                        let k = s.keys[next];\n                        next += 1;\n                        k\n                    }\n                    None => {\n                        let kb = if string_side {\n                            let mut v = format!(\"s{next}_\").into_bytes();\n                            let t = rng.cstring_range(0, 12, ASCII);\n                            v.extend_from_slice(&t[..t.len() - 1]);\n                            v.push(0);\n                            v\n                        } else {\n                            let mut v = rng.bytes(keysize);\n                            v[..4].copy_from_slice(&(next as u32).to_le_bytes());\n                            v\n                        };\n                        next += 1;\n                        ka.add(&kb)\n                    }\n                };\n                live.push(k);\n                let (a, b) = m.put(k, &rng.bytes(elemsize));\n                same_val(&format!(\"{ctx} put temp\"), a, b);\n            }\n            5 => {\n                if !live.is_empty() {\n                    let k = live[rng.below(live.len())];\n                    let (a, b) = m.put(k, &rng.bytes(elemsize));\n                    same_val(&format!(\"{ctx} re-put temp\"), a, b);\n                }\n            }\n            6 | 7 => {\n                if !live.is_empty() {\n                    let k = live[rng.below(live.len())];\n                    let (a, b) = m.get(k);\n                    same_val(&format!(\"{ctx} get temp\"), a, b);\n                }\n            }\n            8 => {\n                if !dead.is_empty() {\n                    let k = dead[rng.below(dead.len())];\n                    let (a, b) = m.get_ts(k);\n                    same_val(&format!(\"{ctx} get_ts(dead) temp\"), a, b);\n                }\n            }\n            9 | 10 => {\n                // delete the most recently inserted live key: keeps\n                // old_index == final_index, which is required for mode >= 2\n                // (see the E67 note in ERRORS.md).\n                if let Some(k) = live.pop() {\n                    dead.push(k);\n                    let (a, b) = m.del(k, 0);\n                    same_val(&format!(\"{ctx} del temp\"), a, b);\n                }\n            }\n            _ => {\n                m.put_default(&rng.bytes(elemsize));\n            }\n        }\n        m.check(&ctx);\n    }\n    m.free();\n    std::mem::forget(ka);\n}\n\n#[test]\nfn stress_map_binary() {\n    for (i, &elemsize) in [8usize, 16, 24, 40].iter().enumerate() {\n        for &mode in &[HM_BINARY, -1, c_int::MIN] {\n            map_stress(\n                \"stress-bin\",\n                0xFEED_0100 + i as u64 + (mode as i64 as u64) & 0xffff_ffff,\n                elemsize,\n                mode,\n                None,\n                700,\n            );\n        }\n    }\n}\n\n#[test]\nfn stress_map_string_lazy() {\n    for (i, &elemsize) in [8usize, 16, 24, 40].iter().enumerate() {\n        for &mode in &[HM_STRING, 2, c_int::MAX] {\n            map_stress(\n                \"stress-str-lazy\",\n                0xFEED_0200 + i as u64 + (mode as u32 as u64),\n                elemsize,\n                mode,\n                None,\n                700,\n            );\n        }\n    }\n}\n\n#[test]\nfn stress_map_string_shmodes() {\n    for (i, &shmode) in [SH_NONE, SH_DEFAULT, SH_STRDUP, SH_ARENA, 7, 255].iter().enumerate() {\n        for &elemsize in &[8usize, 16, 32] {\n            for &mode in &[HM_STRING, 2] {\n                map_stress(\n                    \"stress-str-sh\",\n                    0xFEED_0300 + i as u64 * 7 + elemsize as u64,\n                    elemsize,\n                    mode,\n                    Some(shmode),\n                    400,\n                );\n            }\n        }\n    }\n}\n\n// --- arena churn interleaved with map churn ---------------------------------\n#[test]\nfn stress_arena_and_map_interleaved() {\n    let p = fresh_pair(9);\n    let elemsize = 24usize;\n    let mut rng = Rng::new(0xFEED_0400);\n    let mut m = DiffMap::shmode(&p, elemsize, 8, HM_STRING, SH_ARENA, KeyRepr::CharPtr);\n    let mut ka = KeyArena::new();\n    let mut live: Vec<*mut u8> = Vec::new();\n    let mut ca = Box::new(CArena::zeroed());\n    let mut ra = Box::new(CArena::zeroed());\n    let mut next = 0usize;\n    for step in 0..800 {\n        let ctx = format!(\"stress-mix step={step}\");\n        if rng.below(3) == 0 {\n            // independent arena op\n            let n = rng.below(900);\n            let mut s = rng.cstring(n, ASCII);\n            unsafe {\n                let cp = (p.c.stralloc)(&mut *ca, s.as_mut_ptr() as *mut c_char);\n                let rp = (p.r.stralloc)(&mut *ra, s.as_mut_ptr() as *mut c_char);\n                same_val(&format!(\"{ctx} stralloc content\"), cstr(cp), cstr(rp));\n                same_val(\n                    &format!(\"{ctx} arena scalars\"),\n                    (ca.remaining, ca.block, ca.mode),\n                    (ra.remaining, ra.block, ra.mode),\n                );\n            }\n            if rng.below(30) == 0 {\n                unsafe {\n                    (p.c.strreset)(&mut *ca);\n                    (p.r.strreset)(&mut *ra);\n                }\n            }\n        } else if rng.below(4) != 0 || live.is_empty() {\n            let mut kb = format!(\"m{next}_\").into_bytes();\n            let t = rng.cstring_range(0, 20, ASCII);\n            kb.extend_from_slice(&t[..t.len() - 1]);\n            kb.push(0);\n            next += 1;\n            let k = ka.add(&kb);\n            live.push(k);\n            let (a, b) = m.put(k, &rng.bytes(elemsize));\n            same_val(&format!(\"{ctx} put temp\"), a, b);\n        } else if let Some(k) = live.pop() {\n            let (a, b) = m.del(k, 0);\n            same_val(&format!(\"{ctx} del temp\"), a, b);\n        }\n        m.check(&ctx);\n    }\n    unsafe {\n        (p.c.strreset)(&mut *ca);\n        (p.r.strreset)(&mut *ra);\n    }\n    m.free();\n    std::mem::forget(ka);\n}\n\n// --- rand_seed re-seeding in the middle of a workload -----------------------\n#[test]\nfn stress_reseed_midflight() {\n    let p = pair();\n    let elemsize = 16usize;\n    let mut rng = Rng::new(0xFEED_0500);\n    unsafe {\n        (p.c.rand_seed)(0xAAAA);\n        (p.r.rand_seed)(0xAAAA);\n    }\n    let mut maps: Vec<DiffMap> = Vec::new();\n    let mut arenas: Vec<KeyArena> = Vec::new();\n    for round in 0..14 {\n        // reseed between map creations: each new table captures the *current*\n        // global seed, then advances it by the LCG step\n        let s = rng.next_u64() as usize;\n        unsafe {\n            (p.c.rand_seed)(s);\n            (p.r.rand_seed)(s);\n        }\n        let mut m = DiffMap::lazy(&p, elemsize, 8, HM_BINARY, KeyRepr::Inline);\n        let mut ka = KeyArena::new();\n        for i in 0..40 {\n            let mut kb = rng.bytes(8);\n            kb[..4].copy_from_slice(&(i as u32).to_le_bytes());\n            let k = ka.add(&kb);\n            m.put(k, &rng.bytes(elemsize));\n            m.check(&format!(\"stress-reseed round={round} put#{i}\"));\n        }\n        unsafe {\n            same_val(\n                &format!(\"stress-reseed round={round} captured seed\"),\n                table_of(m.ct, elemsize).unwrap().seed,\n                table_of(m.rt, elemsize).unwrap().seed,\n            );\n        }\n        maps.push(m);\n        arenas.push(ka);\n    }\n    // interleave operations across all the live maps\n    for step in 0..600 {\n        let i = rng.below(maps.len());\n        let mut kb = rng.bytes(8);\n        kb[..4].copy_from_slice(&(rng.next_u32() % 40).to_le_bytes());\n        let k = arenas[i].add(&kb);\n        match rng.below(3) {\n            0 => {\n                let v = rng.bytes(elemsize);\n                let (a, b) = maps[i].put(k, &v);\n                same_val(&format!(\"stress-reseed x step={step} put\"), a, b);\n            }\n            1 => {\n                let (a, b) = maps[i].get(k);\n                same_val(&format!(\"stress-reseed x step={step} get\"), a, b);\n            }\n            _ => {\n                let (a, b) = maps[i].get_ts(k);\n                same_val(&format!(\"stress-reseed x step={step} get_ts\"), a, b);\n            }\n        }\n        maps[i].check(&format!(\"stress-reseed x step={step} map#{i}\"));\n    }\n    for mut m in maps {\n        m.free();\n    }\n    for ka in arenas {\n        std::mem::forget(ka);\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
