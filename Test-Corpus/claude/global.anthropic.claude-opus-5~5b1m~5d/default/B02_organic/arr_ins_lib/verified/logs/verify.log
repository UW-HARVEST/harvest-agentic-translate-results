g_mul((*bucket).index[i] as usize)\n844\t                                        .wrapping_add(keyoffset),\n845\t                                ) as *mut *mut c_char;\n846\t                                set_stbds_temp_key(a, *kp);\n847\t                            }\n848\t                            return stbds_arr_to_hash(a, elemsize);\n849\t                        }\n850\t                    } else if (*bucket).hash[i] == 0 {\n851\t                        pos = (pos & !STBDS_BUCKET_MASK) + i;\n852\t                        break 'found_empty_slot;\n853\t                    } else if tombstone < 0 {\n854\t                        if (*bucket).index[i] == STBDS_INDEX_DELETED {\n855\t                            tombstone = ((pos & !STBDS_BUCKET_MASK) + i) as isize;\n856\t                        }\n857\t                    }\n858\t                    i += 1;\n859\t                }\n860\t\n861\t                let limit = pos & STBDS_BUCKET_MASK;\n862\t                let mut i: usize = 0;\n863\t                while i < limit {\n864\t                    if (*bucket).hash[i] == hash {\n865\t                        if stbds_is_key_equal(\n866\t                            raw_a,\n867\t                            elemsize,\n868\t                            key,\n869\t                            keysize,\n870\t                            keyoffset,\n871\t                            mode,\n872\t                            (*bucket).index[i] as usize,\n873\t                        ) != 0\n874\t                        {\n875\t                            set_stbds_temp(a, (*bucket).index[i]);\n876\t                            return stbds_arr_to_hash(a, elemsize);\n877\t                        }\n878\t                    } else if (*bucket).hash[i] == 0 {\n879\t                        pos = (pos & !STBDS_BUCKET_MASK) + i;\n880\t                        break 'found_empty_slot;\n881\t                    } else if tombstone < 0 {\n882\t                        if (*bucket).inde