!bad)FAIL(\"hash1 %02x\",x);bad=1;}\n    for(int y=0;y<256;++y){ buf[1]=(unsigned char)y;\n      if(A->hash_bytes(buf,2,seeds[0])!=B->hash_bytes(buf,2,seeds[0])){if(!bad)FAIL(\"hash2 %02x%02x\",x,y);bad=1;} } }\n  /* per-position high-bit sweep, every length 0..16 */\n  unsigned char vals[]={0x00,0x01,0x7f,0x80,0x81,0xfe,0xff};\n  for(size_t len=0;len<=16;++len) for(size_t pos=0;pos<16;++pos) for(size_t vi=0;vi<7;++vi){\n    memset(buf,0x5a,17); buf[pos]=vals[vi];\n    for(size_t s=0;s<7;++s) if(A->hash_bytes(buf,len,seeds[s])!=B->hash_bytes(buf,len,seeds[s]))\n      { if(!bad)FAIL(\"hashN len=%zu pos=%zu val=%02x\",len,pos,vals[vi]); bad=1; } }\n  /* hash_string */\n  char s[64];\n  for(size_t len=0;len<48;++len) for(int it=0;it<200;++it){\n    for(size_t k=0;k<len;++k){ unsigned char c; do{c=(unsigned char)rnd();}while(!c); if(it%2==0)c|=0x80; s[k]=(char)c; }\n    s[len]=0;\n    for(size_t si=0;si<5;++si) if(A->hash_string(s,seeds[si])!=B->hash_string(s,seeds[si]))\n      { if(!bad)FAIL(\"hash_string len=%zu\",len); bad=1; } }\n  for(int x=1;x<256;++x){ s[0]=(char)x; s[1]=0;\n    for(size_t si=0;si<5;++si) if(A->hash_string(s,seeds[si])!=B->hash_string(s,seeds[si])){if(!bad)FAIL(\"hstr1 %02x\",x);bad=1;}\n    for(int y=1;y<256;++y){ s[0]=(char)x;s[1]=(char)y;s[2]=0;\n      if(A->hash_string(s,seeds[0])!=B->hash_string(s,seeds[0])){if(!bad)FAIL(\"hstr2 %02x%02x\",x,y);bad=1;} } }\n  printf(\"  hash_bytes / hash_string (incl. exhaustive short + high-bit sweeps): %s\\n\", bad?\"DIVERGES\":\"match\");\n}\n\n/* ---- strkey ---- */\nstatic void t_strkey(lib_t*A, lib_t*B)\n{\n  int bad=0; char ca[300],cb[300],ref[300];\n  long long sp[]={0,1,-1,9,-9,10,-10,99,-99,100,-100,999,-999,1000,-1000,9999,-9999,10000,-10000,\n    99999,-99999,100000,-100000,999999,-999999,1000000,-1000000,9999999,-9999999,10000000,-10000000,\n    99999999,-99999999,100000000,-100000000,999999999,-999999999,1000000000,-1000000000,\n    2147483647,-2147483648LL,2147483646,-2147483647};\n  for(size_t i=0;i<sizeof sp/sizeof*sp;++i){ int n=(int)sp[i];\n    memcpy(ca,A->strkey(n),64); memcpy(cb,B->strkey(n),64); sprintf(ref,\"test_%d\",n);\n    if(strcmp(ca,ref)||strcmp(cb,ref)||memcmp(ca,cb,32)){FAIL(\"strkey n=%d C='%s' R='%s' ref='%s'\",n,ca,cb,ref);bad=1;} }\n  for(long i=0;i<3000000;++i){ int n=(int)(uint32_t)rnd();\n    memcpy(ca,A->strkey(n),32); memcpy(cb,B->strkey(n),32); sprintf(ref,\"test_%d\",n);\n    if(strcmp(ca,ref)||strcmp(cb,ref)||memcmp(ca,cb,32)){ if(!bad)FAIL(\"strkey n=%d C='%s' R='%s' ref='%s'\",n,ca,cb,ref); bad=1; } }\n  /* residual bytes after a longer previous call */\n  A->strkey(-1234567890); B->strkey(-1234567890);\n  memcpy(ca,A->strkey(1),64); memcpy(cb,B->strkey(1),64);\n  if(memcmp(ca,cb,64)){FAIL(\"strkey residual buffer bytes differ\");bad=1;}\n  printf(\"  strkey (3M random + all decimal boundaries + INT_MIN/MAX + residual bytes): %s\\n\", bad?\"DIVERGES\":\"match\");\n}\n\n/* ---- arrgrowf ---- */\nstatic void t_arrgrowf(lib_t*A, lib_t*B)\n{\n  int bad=0; size_t es[]={0,1,2,3,4,7,8,16};\n  for(size_t e=0;e<8;++e) for(size_t ad=0;ad<=20;++ad) for(size_t mc=0;mc<=20;++mc){\n    void*a=A->arrgrowf(NULL,es[e],ad,mc), *b=B->arrgrowf(NULL,es[e],ad,mc);\n    if((a==NULL)!=(b==NULL)){FAIL(\"arrgrowf(NULL,%zu,%zu,%zu) nullness\",es[e],ad,mc);bad=1;continue;}\n    if(!a) continue;\n    hdr_t*ha=HDR(a),*hb=HDR(b);\n    if(ha->length!=hb->length||ha->capacity!=hb->capacity||ha->temp!=hb->temp||(ha->hash_table!=0)!=(hb->hash_table!=0))\n      {FAIL(\"arrgrowf(NULL,e=%zu,add=%zu,min=%zu) C{l=%zu c=%zu t=%td} R{l=%zu c=%zu t=%td}\",es[e],ad,mc,ha->length,ha->capacity,ha->temp,hb->length,hb->capacity,hb->temp);bad=1;}\n    for(size_t sl=0; sl<=ha->capacity; sl += (ha->capacity/3+1)){\n      ha->length=sl; hb->length=sl;\n      for(size_t a2=0;a2<=6;++a2) for(size_t m2=0;m2<=6;++m2){\n        size_t sc=ha->capacity, s2=ha->length;\n        void*x=A->arrgrowf(a,es[e],a2,m2), *y=B->arrgrowf(b,es[e],a2,m2);\n        if(HDR(x)->length!=HDR(y)->length||HDR(x)->capacity!=HDR(y)->capacity||HDR(x)->temp!=HDR(y)->temp)\n          {FAIL(\"arrgrowf(grow e=%zu len=%zu cap=%zu add=%zu min=%zu)\",es[e],s2,sc,a2,m2);bad=1;}\n        a=x;b=y;ha=HDR(a);hb=HDR(b);\n      } }\n    A->arrfreef(a); B->arrfreef(b);\n  }\n  { void*a=A->arrgrowf(NULL,4,1,0),*b=B->arrgrowf(NULL,4,1,0);\n    HDR(a)->length=3;HDR(b)->length=3;\n    size_t ads[]={SIZE_MAX,SIZE_MAX-2,SIZE_MAX/2};\n    for(size_t i=0;i<3;++i){ void*x=A->arrgrowf(a,4,ads[i],0),*y=B->arrgrowf(b,4,ads[i],0);\n      if((x==NULL)!=(y==NULL)){FAIL(\"arrgrowf wrap nullness\");bad=1;break;}\n      if(x&&y){ if(HDR(x)->capacity!=HDR(y)->capacity){FAIL(\"arrgrowf wrap addlen=%#zx cap C=%zu R=%zu\",ads[i],HDR(x)->capacity,HDR(y)->capacity);bad=1;} a=x;b=y; } }\n    A->arrfreef(a);B->arrfreef(b); }\n  printf(\"  arrgrowf (exhaustive elemsize x addlen x min_cap sweep + addlen wrap): %s\\n\", bad?\"DIVERGES\":\"match\");\n}\n\n/* ---- binary map full-state comparison ---- */\ntypedef struct { int key, value; } kv_t;\nstatic int cmp_tab(void*ta,void*tb,size_t es,const char*what,int st)\n{\n  int bad=0;\n  if((ta==NULL)!=(tb==NULL)){FAIL(\"%s step %d nullness\",what,st);return 1;}\n  if(!ta) return 0;\n  void*ra=(char*)ta-es,*rb=(char*)tb-es;\n  hdr_t*ha=HDR(ra),*hb=HDR(rb);\n  if(ha->length!=hb->length){FAIL(\"%s step %d length C=%zu R=%zu\",what,st,ha->length,hb->length);bad=1;}\n  if(ha->capacity!=hb->capacity){FAIL(\"%s step %d capacity C=%zu R=%zu\",what,st,ha->capacity,hb->capacity);bad=1;}\n  if(ha->temp!=hb->temp){FAIL(\"%s step %d temp C=%td R=%td\",what,st,ha->temp,hb->temp);bad=1;}\n  size_t n=ha->length<hb->length?ha->length:hb->length;\n  if(memcmp(ra,rb,n*es)){FAIL(\"%s step %d array payload differs\",what,st);bad=1;}\n  hidx_t*ia=ha->hash_table,*ib=hb->hash_table;\n  if((ia==NULL)!=(ib==NULL)){FAIL(\"%s step %d hash_table nullness\",what,st);return 1;}\n  if(!ia) return bad;\n#define F(f) if(ia->f!=ib->f){FAIL(\"%s step %d idx.\" #f \" C=%zu R=%zu\",what,st,(size_t)ia->f,(size_t)ib->f);bad=1;}\n  F(slot_count) F(used_count) F(used_count_threshold) F(used_count_shrink_threshold)\n  F(tombstone_count) F(tombstone_count_threshold) F(seed) F(slot_count_log2)\n#undef F\n  if(ia->string.remaining!=ib->string.remaining||ia->string.block!=ib->string.block||ia->string.mode!=ib->string.mode)\n    {FAIL(\"%s step %d idx.string C{r=%zu b=%u m=%u} R{r=%zu b=%u m=%u}\",what,st,ia->string.remaining,ia->string.block,ia->string.mode,ib->string.remaining,ib->string.block,ib->string.mode);bad=1;}\n  if(ia->slot_count==ib->slot_count)\n    for(size_t i=0;i<ia->slot_count>>3;++i) for(int j=0;j<8;++j)\n      if(ia->storage[i].hash[j]!=ib->storage[i].hash[j]||ia->storage[i].index[j]!=ib->storage[i].index[j])\n        {FAIL(\"%s step %d bucket[%zu][%d] C{%#zx,%td} R{%#zx,%td}\",what,st,i,j,ia->storage[i].hash[j],ia->storage[i].index[j],ib->storage[i].hash[j],ib->storage[i].index[j]);bad=1;}\n  return bad;\n}\n\nstatic void t_bin(lib_t*A,lib_t*B,int nops,int range,unsigned seed)\n{\n  rs_=seed?seed:1; A->rand_seed(0x31415926); B->rand_seed(0x31415926);\n  kv_t*ta=NULL,*tb=NULL; size_t es=sizeof(kv_t); int rep=0;\n  for(int st=0;st<nops;++st){\n    int op=(int)(rnd()%10), k=(int)(rnd()%range), v=(int)(rnd()&0xffff);\n    hidx_t*pia=ta?HDR((char*)ta-es)->hash_table:NULL, *pib=tb?HDR((char*)tb-es)->hash_table:NULL;\n    if(pia)pia->temp_key=(char*)0x1; if(pib)pib->temp_key=(char*)0x1;\n    if(op<6){ ta=A->hmput_key(ta,es,&k,sizeof k,0); tb=B->hmput_key(tb,es,&k,sizeof k,0);\n      ptrdiff_t pa=HDR((char*)ta-es)->temp,pb=HDR((char*)tb-es)->temp;\n      if(pa==pb){ta[pa].key=k;ta[pa].value=v;tb[pb].key=k;tb[pb].value=v;} }\n    else if(op<8){ ta=A->hmget_key(ta,es,&k,sizeof k,0); tb=B->hmget_key(tb,es,&k,sizeof k,0); }\n    else { ta=A->hmdel_key(ta,es,&k,sizeof k,offsetof(kv_t,key),0); tb=B->hmdel_key(tb,es,&k,sizeof k,offsetof(kv_t,key),0); }\n    { hidx_t*qa=ta?HDR((char*)ta-es)->hash_table:NULL,*qb=tb?HDR((char*)tb-es)->hash_table:NULL;\n      if(qa==pia&&qb==pib&&pia&&pib){ int u=(pia->temp_key==(char*)0x1),w=(pib->temp_key==(char*)0x1);\n        if(u!=w) FAIL(\"binary-mode temp_key written: C-untouched=%d RUST-untouched=%d (step %d)\",u,w,st); } }\n    if(cmp_tab(ta,tb,es,\"hm_binary\",st)){rep++;if(rep>2)break;}\n  }\n  if(ta)A->hmfree_func((char*)ta-es,es); if(tb)B->hmfree_func((char*)tb-es,es);\n  if(rep) printf(\"  hm_binary(ops=%d range=%d seed=%u): DIVERGES\\n\",nops,range,seed);\n}\n\nstatic void t_phases(lib_t*A,lib_t*B,int n)\n{\n  A->rand_seed(0x31415926);B->rand_seed(0x31415926);\n  kv_t*ta=NULL,*tb=NULL;size_t es=sizeof(kv_t);int rep=0;\n  for(int i=0;i<n;++i){ int k=(int)(i*2654435761u%1000003);\n    ta=A->hmput_key(ta,es,&k,sizeof k,0); tb=B->hmput_key(tb,es,&k,sizeof k,0);\n    ptrdiff_t pa=HDR((char*)ta-es)->temp,pb=HDR((char*)tb-es)->temp;\n    if(pa==pb){ta[pa].key=k;ta[pa].value=i;tb[pb].key=k;tb[pb].value=i;}\n    if(cmp_tab(ta,tb,es,\"phases:grow\",i)){rep++;if(rep>2)goto out;} }\n  for(int i=0;i<n;++i){ int k=(int)(i*2654435761u%1000003);\n    ta=A->hmdel_key(ta,es,&k,sizeof k,offsetof(kv_t,key),0); tb=B->hmdel_key(tb,es,&k,sizeof k,offsetof(kv_t,key),0);\n    if(cmp_tab(ta,tb,es,\"phases:shrink\",i)){rep++;if(rep>2)goto out;} }\n  for(int i=0;i<n/2;++i){ int k=7000000+i;\n    ta=A->hmput_key(ta,es,&k,sizeof k,0); tb=B->hmput_key(tb,es,&k,sizeof k,0);\n    ptrdiff_t pa=HDR((char*)ta-es)->temp,pb=HDR((char*)tb-es)->temp;\n    if(pa==pb){ta[pa].key=k;ta[pa].value=i;tb[pb].key=k;tb[pb].value=i;}\n    if(cmp_tab(ta,tb,es,\"phases:regrow\",i)){rep++;if(rep>2)goto out;} }\nout:\n  if(ta)A->hmfree_func((char*)ta-es,es); if(tb)B->hmfree_func((char*)tb-es,es);\n  if(rep) printf(\"  hm_phases(n=%d): DIVERGES\\n\",n);\n}\n\nstatic void t_churn(lib_t*A,lib_t*B,int nops,unsigned seed)\n{\n  rs_=seed?seed:1;A->rand_seed(0x31415926);B->rand_seed(0x31415926);\n  kv_t*ta=NULL,*tb=NULL;size_t es=sizeof(kv_t);int rep=0;\n  for(int st=0;st<nops;++st){ int k=(int)(rnd()%300);\n    if(st%3!=2){ ta=A->hmput_key(ta,es,&k,sizeof k,0); tb=B->hmput_key(tb,es,&k,sizeof k,0);\n      ptrdiff_t pa=HDR((char*)ta-es)->temp,pb=HDR((char*)tb-es)->temp;\n      if(pa==pb){ta[pa].key=k;ta[pa].value=st;tb[pb].key=k;tb[pb].value=st;} }\n    else { ta=A->hmdel_key(ta,es,&k,sizeof k,offsetof(kv_t,key),0); tb=B->hmdel_key(tb,es,&k,sizeof k,offsetof(kv_t,key),0); }\n    if(cmp_tab(ta,tb,es,\"hm_churn\",st)){rep++;if(rep>2)break;} }\n  if(ta)A->hmfree_func((char*)ta-es,es); if(tb)B->hmfree_func((char*)tb-es,es);\n  if(rep) printf(\"  hm_churn(ops=%d seed=%u): DIVERGES\\n\",nops,seed);\n}\n\n/* ---- string maps ---- */\ntypedef struct { char *key; int value; } skv_t;\nstatic void t_str(lib_t*A,lib_t*B,int shmode,int nops,int range,unsigned seed)\n{\n  rs_=seed?seed:1;A->rand_seed(0x31415926);B->rand_seed(0x31415926);\n  size_t es=sizeof(skv_t); skv_t*ta=NULL,*tb=NULL; int rep=0;\n  if(shmode){ta=A->shmode_func(es,shmode);tb=B->shmode_func(es,shmode);}\n  static char keys[600][40];\n  for(int i=0;i<600;++i) sprintf(keys[i],\"key_%d_%s\",i,(i%3)?\"x\":\"longer_padding_text\");\n  for(int st=0;st<nops;++st){\n    int op=(int)(rnd()%10),ki=(int)(rnd()%range),v=(int)(rnd()&0xffff);\n    hidx_t*pia=ta?HDR((char*)ta-es)->hash_table:NULL,*pib=tb?HDR((char*)tb-es)->hash_table:NULL;\n    if(pia)pia->temp_key=(char*)0x1; if(pib)pib->temp_key=(char*)0x1;\n    if(op<6){\n      ta=A->hmput_key(ta,es,keys[ki],sizeof(char*),1); tb=B->hmput_key(tb,es,keys[ki],sizeof(char*),1);\n      ptrdiff_t pa=HDR((char*)ta-es)->temp,pb=HDR((char*)tb-es)->temp;\n      if(pa==pb){ta[pa].value=v;tb[pb].value=v;}\n      hidx_t*qa=HDR((char*)ta-es)->hash_table,*qb=HDR((char*)tb-es)->hash_table;\n      if(qa==pia&&qb==pib&&pia&&pib){\n        int da=pia->temp_key==(char*)0x1?0:(pia->temp_key==ta[pa].key?1:(pia->temp_key==keys[ki]?2:3));\n        int db=pib->temp_key==(char*)0x1?0:(pib->temp_key==tb[pb].key?1:(pib->temp_key==keys[ki]?2:3));\n        if(da!=db) FAIL(\"temp_key class mode=%d step %d C=%d RUST=%d\",shmode,st,da,db); } }\n    else if(op<8){ ta=A->hmget_key(ta,es,keys[ki],sizeof(char*),1); tb=B->hmget_key(tb,es,keys[ki],sizeof(char*),1); }\n    else { ta=A->hmdel_key(ta,es,keys[ki],sizeof(char*),offsetof(skv_t,key),1); tb=B->hmdel_key(tb,es,keys[ki],sizeof(char*),offsetof(skv_t,key),1); }\n    if((ta==NULL)!=(tb==NULL)){FAIL(\"str mode=%d step %d nullness\",shmode,st);break;}\n    if(!ta) continue;\n    hdr_t*ha=HDR((char*)ta-es),*hb=HDR((char*)tb-es); int bad=0;\n    if(ha->length!=hb->length){FAIL(\"str mode=%d step %d length C=%zu R=%zu\",shmode,st,ha->length,hb->length);bad=1;}\n    if(ha->capacity!=hb->capacity){FAIL(\"str mode=%d step %d cap\",shmode,st);bad=1;}\n    if(ha->temp!=hb->temp){FAIL(\"str mode=%d step %d temp C=%td R=%td\",shmode,st,ha->temp,hb->temp);bad=1;}\n    size_t n=ha->length<hb->length?ha->length:hb->length;\n    for(size_t i=0;i+1<n&&!bad;++i){\n      if((ta[i].key==NULL)!=(tb[i].key==NULL)){FAIL(\"str mode=%d step %d elem %zu key nullness\",shmode,st,i);bad=1;break;}\n      if(ta[i].key&&strcmp(ta[i].key,tb[i].key)){FAIL(\"str mode=%d step %d elem %zu key C='%s' R='%s'\",shmode,st,i,ta[i].key,tb[i].key);bad=1;}\n      if(ta[i].value!=tb[i].value){FAIL(\"str mode=%d step %d elem %zu value C=%d R=%d\",shmode,st,i,ta[i].value,tb[i].value);bad=1;} }\n    hidx_t*ia=ha->hash_table,*ib=hb->hash_table;\n    if(ia&&ib){\n#define F(f) if(ia->f!=ib->f){FAIL(\"str mode=%d step %d idx.\" #f \" C=%zu R=%zu\",shmode,st,(size_t)ia->f,(size_t)ib->f);bad=1;}\n      F(slot_count) F(used_count) F(tombstone_count) F(seed) F(slot_count_log2)\n#undef F\n      if(ia->string.mode!=ib->string.mode||ia->string.block!=ib->string.block||ia->string.remaining!=ib->string.remaining)\n        {FAIL(\"str mode=%d step %d idx.string C{m=%u b=%u r=%zu} R{m=%u b=%u r=%zu}\",shmode,st,ia->string.mode,ia->string.block,ia->string.remaining,ib->string.mode,ib->string.block,ib->string.remaining);bad=1;}\n      if(ia->slot_count==ib->slot_count)\n        for(size_t i=0;i<ia->slot_count>>3;++i) for(int j=0;j<8;++j)\n          if(ia->storage[i].hash[j]!=ib->storage[i].hash[j]||ia->storage[i].index[j]!=ib->storage[i].index[j])\n            {FAIL(\"str mode=%d step %d bucket[%zu][%d]\",shmode,st,i,j);bad=1;} }\n    if(bad){rep++;if(rep>2)break;} }\n  if(ta)A->hmfree_func((char*)ta-es,es); if(tb)B->hmfree_func((char*)tb-es,es);\n  if(rep) printf(\"  hm_string(mode=%d ops=%d seed=%u): DIVERGES\\n\",shmode,nops,seed);\n}\n\n/* ---- arena ---- */\nstatic void t_arena(lib_t*A,lib_t*B,unsigned seed)\n{\n  rs_=seed?seed:1; arena_t aa,ab; memset(&aa,0,sizeof aa); memset(&ab,0,sizeof ab);\n  int rep=0; static char buf[8192];\n  for(int st=0;st<500;++st){\n    size_t len=(size_t)(rnd()%2000); if(st%17==0) len=600+(rnd()%3000);\n    for(size_t k=0;k<len;++k) buf[k]='a'+(char)(rnd()%26);\n    buf[len]=0;\n    char*pa=A->stralloc(&aa,buf),*pb=B->stralloc(&ab,buf); int bad=0;\n    if(strcmp(pa,buf)||strcmp(pb,buf)){FAIL(\"arena step %d content\",st);bad=1;}\n    if(aa.remaining!=ab.remaining){FAIL(\"arena step %d remaining C=%zu R=%zu\",st,aa.remaining,ab.remaining);bad=1;}\n    if(aa.block!=ab.block){FAIL(\"arena step %d block C=%u R=%u\",st,aa.block,ab.block);bad=1;}\n    int ca=(pa==(char*)aa.storage+8+aa.remaining)?0:((*(void**)aa.storage&&pa==(char*)(*(void**)aa.storage)+8)?1:3);\n    int cb=(pb==(char*)ab.storage+8+ab.remaining)?0:((*(void**)ab.storage&&pb==(char*)(*(void**)ab.storage)+8)?1:3);\n    if(ca!=cb){FAIL(\"arena step %d path class C=%d R=%d\",st,ca,cb);bad=1;}\n    int na=0,nb=0; for(void*x=aa.storage;x;x=*(void**)x)na++; for(void*x=ab.storage;x;x=*(void**)x)nb++;\n    if(na!=nb){FAIL(\"arena step %d chain C=%d R=%d\",st,na,nb);bad=1;}\n    if(bad){rep++;if(rep>3)break;} }\n  A->strreset(&aa);B->strreset(&ab);\n  if(aa.storage||ab.storage||aa.remaining||ab.remaining||aa.block||ab.block||aa.mode||ab.mode){FAIL(\"strreset did not clear\");rep++;}\n  if(rep) printf(\"  arena(seed=%u): DIVERGES\\n\",seed);\n}\n\nstatic void t_arena_edge(lib_t*A,lib_t*B)\n{\n  int bad=0; static char buf[1<<21]; memset(buf,'z',sizeof buf);\n  size_t lens[]={0,1,2,7,8,9,255,510,511,512,513,1022,1023,1024,1025,2047,2048,2049,1048575,1048576,1048577,2000000};\n  for(size_t i=0;i<sizeof lens/sizeof*lens;++i){\n    arena_t aa,ab; memset(&aa,0,sizeof aa);memset(&ab,0,sizeof ab);\n    size_t L=lens[i]; buf[L]=0;\n    char*pa=A->stralloc(&aa,buf),*pb=B->stralloc(&ab,buf); buf[L]='z';\n    if(strlen(pa)!=L||strlen(pb)!=L){FAIL(\"stralloc L=%zu content\",L);bad=1;}\n    if(aa.remaining!=ab.remaining||aa.block!=ab.block){FAIL(\"stralloc L=%zu rem C=%zu R=%zu blk C=%u R=%u\",L,aa.remaining,ab.remaining,aa.block,ab.block);bad=1;}\n    for(int d=-1;d<=1;++d){ arena_t a2=aa,b2=ab; long long w=(long long)aa.remaining+d;\n      if(w<1) continue; size_t L2=(size_t)w-1; if(L2>=sizeof buf) continue;\n      buf[L2]=0; char*q1=A->stralloc(&a2,buf),*q2=B->stralloc(&b2,buf); buf[L2]='z';\n      if(strlen(q1)!=L2||strlen(q2)!=L2){FAIL(\"stralloc2 L=%zu d=%d content\",L2,d);bad=1;}\n      if(a2.remaining!=b2.remaining||a2.block!=b2.block){FAIL(\"stralloc2 L=%zu d=%d rem C=%zu R=%zu\",L2,d,a2.remaining,b2.remaining);bad=1;}\n      if((q1==(char*)a2.storage+8+a2.remaining)!=(q2==(char*)b2.storage+8+b2.remaining)){FAIL(\"stralloc2 L=%zu d=%d path\",L2,d);bad=1;} }\n    A->strreset(&aa);B->strreset(&ab); }\n  /* a->block ramp to the 1<<20 cap, and forced shift-count overflow */\n  { arena_t aa,ab; memset(&aa,0,sizeof aa);memset(&ab,0,sizeof ab); size_t len=400;\n    for(int st=0;st<60;++st){ if(len>sizeof(buf)-1) len=sizeof(buf)-1; buf[len]=0;\n      A->stralloc(&aa,buf); B->stralloc(&ab,buf); buf[len]='z';\n      if(aa.block!=ab.block||aa.remaining!=ab.remaining){FAIL(\"ramp st=%d blk C=%u R=%u rem C=%zu R=%zu\",st,aa.block,ab.block,aa.remaining,ab.remaining);bad=1;break;}\n      len=len*2+1; if(len>1500000) len=900000+(size_t)(st*37); }\n    printf(\"  arena block ramp reached block=%u (C) / %u (RUST)\\n\",aa.block,ab.block);\n    A->strreset(&aa);B->strreset(&ab); }\n  { unsigned char bl[]={0,1,2,3,20,21,22,128,129,130,254,255}; char s[]=\"hello\";\n    for(size_t i=0;i<sizeof bl;++i){ size_t sh=bl[i]>>1; if(sh>=23&&sh<64) continue;\n      arena_t aa,ab; memset(&aa,0,sizeof aa);memset(&ab,0,sizeof ab); aa.block=bl[i];ab.block=bl[i];\n      char*pa=A->stralloc(&aa,s),*pb=B->stralloc(&ab,s);\n      if(strcmp(pa,s)||strcmp(pb,s)||aa.remaining!=ab.remaining||aa.block!=ab.block)\n        {FAIL(\"stralloc block=%u C{r=%zu b=%u} R{r=%zu b=%u}\",bl[i],aa.remaining,aa.block,ab.remaining,ab.block);bad=1;}\n      A->strreset(&aa);B->strreset(&ab); } }\n  printf(\"  stralloc/strreset (boundary lengths, block ramp, shift-count overflow): %s\\n\", bad?\"DIVERGES\":\"match\");\n}\n\n/* ---- misc ---- */\nstatic void t_misc(lib_t*A,lib_t*B)\n{\n  int bad=0;\n  { size_t es=8; void*ta=A->hmput_default(NULL,es),*tb=B->hmput_default(NULL,es);\n    if(cmp_tab(ta,tb,es,\"hmput_default(NULL)\",0))bad=1;\n    if(A->hmput_default(ta,es)!=ta||B->hmput_default(tb,es)!=tb){FAIL(\"hmput_default 2nd call moved ptr\");bad=1;}\n    A->hmfree_func((char*)ta-es,es);B->hmfree_func((char*)tb-es,es); }\n  { size_t es=8; void*ra=A->arrgrowf(NULL,es,0,1),*rb=B->arrgrowf(NULL,es,0,1);\n    memset(ra,0xAB,es*HDR(ra)->capacity); memset(rb,0xAB,es*HDR(rb)->capacity);\n    HDR(ra)->length=0;HDR(rb)->length=0;\n    void*ua=A->hmput_default((char*)ra+es,es),*ub=B->hmput_default((char*)rb+es,es);\n    if(HDR((char*)ua-es)->length!=HDR((char*)ub-es)->length||memcmp((char*)ua-es,(char*)ub-es,es))\n      {FAIL(\"hmput_default(len==0 path)\");bad=1;}\n    A->arrfreef((char*)ua-es);B->arrfreef((char*)ub-es); }\n  { size_t es=8;int k=99; void*ta,*tb;\n    void*ra=A->arrgrowf(NULL,es,0,1),*rb=B->arrgrowf(NULL,es,0,1);\n    memset(ra,0xAB,es*HDR(ra)->capacity);memset(rb,0xAB,es*HDR(rb)->capacity);\n    HDR(ra)->length=0;HDR(rb)->length=0;\n    ta=A->hmput_key((char*)ra+es,es,&k,sizeof k,0); tb=B->hmput_key((char*)rb+es,es,&k,sizeof k,0);\n    if(cmp_tab(ta,tb,es,\"hmput_key(raw leng