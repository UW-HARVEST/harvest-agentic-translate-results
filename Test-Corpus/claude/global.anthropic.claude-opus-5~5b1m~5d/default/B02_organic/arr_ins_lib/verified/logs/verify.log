*mut c_void, key, keysize);\n974\t                    }\n975\t                }\n976\t            }\n977\t            stbds_arr_to_hash(a, elemsize)\n978\t        }\n979\t    }\n980\t}\n981\t\n982\t#[unsafe(no_mangle)]\n983\tpub unsafe extern \"C\" fn stbds_shmode_func(elemsize: usize, mode: c_int) -> *mut c_void {\n984\t    unsafe {\n985\t        let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n986\t        c_memset(a, 0, elemsize);\n987\t        (*stbds_header(a)).length = 1;\n988\t        let h = stbds_make_hash_index(STBDS_BUCKET_LENGTH, ptr::null_mut());\n989\t        (*stbds_header(a)).hash_table = h as *mut c_void;\n990\t        (*h).string.mode = mode as u8;\n991\t        stbds_arr_to_hash(a, elemsize)\n992\t    }\n993\t}\n994\t\n995\t#[unsafe(no_mangle)]\n996\tpub unsafe extern \"C\" fn stbds_hmdel_key(\n997\t    a: *mut c_void,\n998\t    elemsize: usize,\n999\t    key: *mut c_void,\n1000\t    keysize: usize,\n1001\t    keyoffset: usize,\n1002\t    mode: c_int,\n1003\t) -> *mut c_void {\n1004\t    unsafe {\n1005\t        if a.is_null() {\n1006\t            return ptr::null_mut();\n1007\t        }\n1008\t\n1009\t        let raw_a = stbds_hash_to_arr(a, elemsize);\n1010\t        let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n1011\t        set_stbds_temp(raw_a, 0);\n1012\t        if table.is_null() {\n1013\t            return a;\n1014\t        }\n1015\t\n1016\t        let mut slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n1017\t        if slot < 0 {\n1018\t            return a;\n1019\t        }\n1020\t\n1021\t        let mut b = (*table).storage.add((slot >> STBDS_BUCKET_SHIFT) as usize);\n1022\t        let mut i = (slot as usize) & STBDS_BUCKET_MASK;\n1023\t        let old_index = (*b).index[i];\n1024\t        let final_index = stbds_arrlen(raw_a).wrapping_sub(1).wrapping_sub(1);\n1025\t        assert!(slot < (*table).slot_count as isize);\n1026\t        (*table).used_count = (*table).used_count.wrap