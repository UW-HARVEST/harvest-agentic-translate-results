parts(ep, take)),\n                );\n            }\n            KeyRepr::CharPtr => {''')\ns=s.replace('''            KeyRepr::CharPtr | KeyRepr::Auto => 8usize.min(self.elemsize),\n        }''','''            KeyRepr::CharPtr | KeyRepr::Auto => 8usize.min(self.elemsize),\n            KeyRepr::InlineKeyOnly(n) => n.min(self.elemsize),\n        }''')\nopen(p,'w').write(s)\n\np='tests/phase_c_errors.rs'\ns=open(p).read()\ns=s.replace('.map(|&s| unsafe { key_at_slot_bin(&p.c, seed, 8, s, &mut counter) })','.map(|&s| key_at_slot_bin(&p.c, seed, 8, s, &mut counter))')\n# b01 / b05 / e20 : raw hmput_key leaves the value half uninitialised\ns=s.replace('''        let c1 = (p.c.hmput_key)(std::ptr::null_mut(), ELEMSIZE, kp, KEYSIZE, HM_BINARY);\n        let c2 = (p.r.hmput_key)(std::ptr::null_mut(), ELEMSIZE, kp, KEYSIZE, HM_BINARY);\n        same(\n            \"b01 hmput_key(NULL)\",\n            &snap_map(c1, ELEMSIZE, KeyRepr::Inline),\n            &snap_map(c2, ELEMSIZE, KeyRepr::Inline),\n        );''','''        let c1 = (p.c.hmput_key)(std::ptr::null_mut(), ELEMSIZE, kp, KEYSIZE, HM_BINARY);\n        let c2 = (p.r.hmput_key)(std::ptr::null_mut(), ELEMSIZE, kp, KEYSIZE, HM_BINARY);\n        same(\n            \"b01 hmput_key(NULL)\",\n            &snap_map(c1, ELEMSIZE, KeyRepr::InlineKeyOnly(KEYSIZE)),\n            &snap_map(c2, ELEMSIZE, KeyRepr::InlineKeyOnly(KEYSIZE)),\n        );''')\ns=s.replace('''                    same(\n                        &ctx,\n                        &snap_map(ct, elemsize, KeyRepr::Auto),\n                        &snap_map(rt, elemsize, KeyRepr::Auto),\n                    );\n                    (p.c.hmfree_func)((ct as usize - elemsize) as *mut c_void, elemsize);''','''                    let kr = if mode >= HM_STRING {\n                        KeyRepr::InlineKeyOnly(8)\n                    } else {\n                        KeyRepr::InlineKeyOnly(keysize)\n                    };\n                    same(&ctx, &snap_map(ct, ele