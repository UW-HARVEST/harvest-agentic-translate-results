ents 1.. are the live rows\n    for i in 0..h.length {''')\ns=s.replace('''            KeyRepr::CharPtr => {\n                let key = if i == 0 || elemsize < 8 {''','''            KeyRepr::Auto => unreachable!(),\n            KeyRepr::CharPtr => {\n                let key = if i == 0 || elemsize < 8 {''')\n# write_slot must also resolve Auto\ns=s.replace('''        let voff = match self.keyrepr {\n            KeyRepr::Inline => self.keysize.min(self.elemsize),\n            KeyRepr::CharPtr => 8usize.min(self.elemsize),\n        };\n        let n = self.elemsize - voff;\n        for i in 0..n.min(value.len()) {\n            *ep.add(voff + i) = value[i];\n        }\n        for i in value.len()..n {\n            *ep.add(voff + i) = 0;\n        }''','''        let voff = self.value_offset();\n        let n = self.elemsize - voff;\n        for i in 0..n.min(value.len()) {\n            *ep.add(voff + i) = value[i];\n        }\n        for i in value.len()..n {\n            *ep.add(voff + i) = 0;\n        }''')\ns=s.replace('''                let voff = match self.keyrepr {\n                    KeyRepr::Inline => self.keysize.min(self.elemsize),\n                    KeyRepr::CharPtr => 8usize.min(self.elemsize),\n                };\n                let n = self.elemsize - voff;\n                for i in 0..n.min(value.len()) {\n                    *raw.add(voff + i) = value[i];\n                }''','''                let voff = self.value_offset();\n                let n = self.elemsize - voff;\n                for i in 0..n.min(value.len()) {\n                    *raw.add(voff + i) = value[i];\n                }''')\ns=s.replace('''    unsafe fn write_slot(&self, t: *mut c_void, value: &[u8]) {''','''    /// Where the \"value\" half of an element begins, mirroring the layouts the\n    /// stb_ds macros produce (`struct { K key; V value; }`).\n    fn value_offset(&self) -> usize {\n        match self.keyrepr {\n            KeyRepr::Inline => self.keysize.min(self.elemsize),\n            KeyRepr::CharPtr | KeyRepr::Auto => 8usize.min(self.elemsize),\n        }\n    }\n\n    unsafe fn write_slot(&self, t: *mut c_void, value: &[u8]) {''')\nopen(p,'w').write(s)\nprint(\"ok\")\nPY\ncat >> tests/common/mod.rs <<'RS'\n\n/// Brute-force a 4-byte binary key whose probe position is exactly `slot`.\npub unsafe fn key_at_slot_bin(\n    l: &Lib,\n    seed: usize,\n    slot_count: usize,\n    slot: usize,\n    counter: &mut u32,\n) -> [u8; 4] {\n    for _ in 0..100_000_000u64 {\n        let mut k = counter.to_le_bytes();\n        *counter = counter.wrapping_add(1);\n        let h = effective_hash_bytes(l, &mut k, seed);\n        if (h & (slot_count - 1)) == slot {\n            return k;\n        }\n    }\n    panic!(\"no key found for slot {slot}\");\n}\n\n/// Brute-force a printable string key whose probe position is exactly `slot`.\npub unsafe fn key_at_slot_str(\n    l: &Lib,\n    seed: usize,\n    slot_count: usize,\n    slot: usize,\n    counter: &mut u32,\n) -> Vec<u8> {\n    for _ in 0..100_000_000u64 {\n        let mut k: Vec<u8> = format!(\"s{}\", *counter).into_bytes();\n        k.push(0);\n        *counter = counter.wrapping_add(1);\n        let h = effective_hash_string(l, &mut k, seed);\n        if (h & (slot_count - 1)) == slot {\n            return k;\n        }\n    }\n    panic!(\"no string key found for slot {slot}\");\n}\n\n/// Raw bucket read-out for a map (`t` = user pointer).\npub unsafe fn bucket(t: *mut c_void, elemsize: usize, b: usize) -> CBucket {\n    let ti = table_of(t, elemsize).expect(\"no table\");\n    *ti.storage.add(b)\n}\nRS\ntimeout 300 cargo build --offline --release --tests 2>&1 | tail -20","description":"Add KeyRepr::Auto and slot-targeting helpers"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":537,"cache_read_input_tokens":229025,"cache_creation":{"ephemeral_5m_input_tokens":537,"ephemeral_1h_input_tokens":0},"output_tokens":3,"se