const void *, C2_TYPE, c2Proxy *);\n    float (*c2Len)(c2v);\n    float (*c2Det2)(c2v, c2v);\n    float (*c2GJKSimplexMetric)(c2Simplex *);\n    c2v (*c2Mulrv)(c2r, c2v);\n    c2v (*c2MulrvT)(c2r, c2v);\n    c2v (*c2Add)(c2v, c2v);\n    c2v (*c2Mulxv)(c2x, c2v);\n    c2v (*c2MulxvT)(c2x, c2v);\n    c2v (*c2Intersect)(c2v, c2v, float, float);\n    c2v (*c2Div)(c2v, float);\n    c2v (*c2Norm)(c2v);\n    c2v (*c2Neg)(c2v);\n    c2v (*c2CCW90)(c2v);\n    void (*c22)(c2Simplex *);\n    void (*c23)(c2Simplex *);\n    c2v (*c2Skew)(c2v);\n    c2v (*c2D)(c2Simplex *);\n    int (*c2Support)(const c2v *, int, c2v);\n    void (*c2Witness)(c2Simplex *, c2v *, c2v *);\n    c2v (*c2L)(c2Simplex *);\n    float (*c2GJK)(const void *, C2_TYPE, const c2x *, const void *, C2_TYPE,\n                   const c2x *, c2v *, c2v *, int, int *, c2GJKCache *);\n    c2v (*c2Absv)(c2v);\n    void (*c2CircletoCircleManifold)(c2Circle, c2Circle, c2Manifold *);\n    void (*c2CircletoAABBManifold)(c2Circle, c2AABB, c2Manifold *);\n    void (*c2CircletoCapsuleManifold)(c2Circle, c2Capsule, c2Manifold *);\n    void (*c2AABBtoAABBManifold)(c2AABB, c2AABB, c2Manifold *);\n    void (*c2CapsuletoPolyManifold)(c2Capsule, const c2Poly *, const c2x *, c2Manifold *);\n    void (*c2Norms)(c2v *, c2v *, int);\n    void (*c2AABBtoCapsuleManifold)(c2AABB, c2Capsule, c2Manifold *);\n    void (*c2CapsuletoCapsuleManifold)(c2Capsule, c2Capsule, c2Manifold *);\n    void (*c2Collide)(const void *, C2_TYPE, const void *, C2_TYPE, c2Manifold *);\n    void *(*ptr_from_parts)(C2_TYPE, float, float, float, float, float);\n    void (*omni_manifold)(c2Manifold *, C2_TYPE, float, float, float, float, float,\n                          C2_TYPE, float, float, float, float, float);\n} API;\n\n#define LOAD(a, n)                                                             \\\n    do {                                                                       \\\n        *(void **)(&(a)->n) = dlsym((a)->h, #n);                                \\\n        if (!(a)->n) { fprintf(stderr, \"missing %s\\n\", #n); exit(2); }          \\\n    } while (0)\n\nstatic void load(API *a, const char *path) {\n    a->h = dlopen(path, RTLD_NOW | RTLD_LOCAL);\n    if (!a->h) { fprintf(stderr, \"dlopen %s: %s\\n\", path, dlerror()); exit(2); }\n    LOAD(a, c2V); LOAD(a, c2Mulvs); LOAD(a, c2Maxv); LOAD(a, c2Minv);\n    LOAD(a, c2Clampv); LOAD(a, c2Sub); LOAD(a, c2Dot); LOAD(a, c2Dist);\n    LOAD(a, c2PlaneAt); LOAD(a, c2RotIdentity); LOAD(a, c2xIdentity);\n    LOAD(a, c2BBVerts); LOAD(a, c2MakeProxy); LOAD(a, c2Len); LOAD(a, c2Det2);\n    LOAD(a, c2GJKSimplexMetric); LOAD(a, c2Mulrv); LOAD(a, c2MulrvT);\n    LOAD(a, c2Add); LOAD(a, c2Mulxv); LOAD(a, c2MulxvT); LOAD(a, c2Intersect);\n    LOAD(a, c2Div); LOAD(a, c2Norm); LOAD(a, c2Neg); LOAD(a, c2CCW90);\n    LOAD(a, c22); LOAD(a, c23); LOAD(a, c2Skew); LOAD(a, c2D);\n    LOAD(a, c2Support); LOAD(a, c2Witness); LOAD(a, c2L); LOAD(a, c2GJK);\n    LOAD(a, c2Absv); LOAD(a, c2CircletoCircleManifold);\n    LOAD(a, c2CircletoAABBManifold); LOAD(a, c2CircletoCapsuleManifold);\n    LOAD(a, c2AABBtoAABBManifold); LOAD(a, c2CapsuletoPolyManifold);\n    LOAD(a, c2Norms); LOAD(a, c2AABBtoCapsuleManifold);\n    LOAD(a, c2CapsuletoCapsuleManifold); LOAD(a, c2Collide);\n    LOAD(a, ptr_from_parts); LOAD(a, omni_manifold);\n}\n\nstatic API A, B;\nstatic long checks = 0, fails = 0;\nstatic char failed_fn[64][64];\nstatic long failed_cnt[64];\nstatic int nfailed = 0;\n\nstatic void note(const char *tag) {\n    for (int i = 0; i < nfailed; ++i)\n        if (!strcmp(failed_fn[i], tag)) { failed_cnt[i]++; return; }\n    if (nfailed < 64) {\n        snprintf(failed_fn[nfailed], 64, \"%s\", tag);\n        failed_cnt[nfailed] = 1;\n        nfailed++;\n    }\n}\n\nstatic void chk(const char *tag, const void *p, const void *q, size_t n) {\n    checks++;\n    if (memcmp(p, q, n)) { fails++; note(tag); }\n}\n\n/* ---- random helpers ---------------------------------------------------- */\nstatic uint64_t rs = 0x243F6A8885A308D3ULL;\nstatic uint32_t r32(void) {\n    rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17;\n    return (uint32_t)(rs >> 32);\n}\nstatic float rf(void) { /* \"nice\" floats */\n    return ((float)(int)(r32() % 40001) - 20000.0f) / 100.0f;\n}\nstatic float rfx(void) { /* spicy floats incl. 0, -0, inf, nan, denormals */\n    switch (r32() % 16) {\n    case 0: return 0.0f;\n    case 1: return -0.0f;\n    case 2: return INFINITY;\n    case 3: return -INFINITY;\n    case 4: return NAN;\n    case 5: return 1e-40f;\n    case 6: return -1e-40f;\n    case 7: return 3.4028234663852886e38f;\n    case 8: return 1.1920929e-7f;\n    default: return rf();\n    }\n}\nstatic float (*RND)(void) = rf;\nstatic c2v rv(void) { c2v v; v.x = RND(); v.y = RND(); return v; }\nstatic c2h rh(void) { c2h h; h.n = rv(); h.d = RND(); return h; }\nstatic c2r rr(void) { c2r r; float a = RND(); r.c = cosf(a); r.s = sinf(a); return r; }\nstatic c2x rx(void) { c2x x; x.p = rv(); x.r = rr(); return x; }\nstatic c2Circle rc(void) { c2Circle c; c.p = rv(); c.r = fabsf(RND()); return c; }\nstatic c2AABB rb(void) {\n    c2AABB b; c2v u = rv(), v = rv();\n    b.min.x = u.x < v.x ? u.x : v.x; b.min.y = u.y < v.y ? u.y : v.y;\n    b.max.x = u.x < v.x ? v.x : u.x; b.max.y = u.y < v.y ? v.y : u.y;\n    return b;\n}\nstatic c2Capsule rcap(void) { c2Capsule c; c.a = rv(); c.b = rv(); c.r = fabsf(RND()); return c; }\n\nstatic void rpoly(c2Poly *p) {\n    int n = 3 + (int)(r32() % 6);\n    float cx = rf(), cy = rf(), rad = fabsf(rf()) + 0.5f;\n    float base = rf();\n    for (int i = 0; i < n; ++i) {\n        float ang = base + 6.28318530718f * (float)i / (float)n;\n        p->verts[i].x = cx + rad * cosf(ang);\n        p->verts[i].y = cy + rad * sinf(ang);\n    }\n    p->count = n;\n    A.c2Norms(p->verts, p->norms, n); /* identical in both libs (verified separately) */\n    for (int i = n; i < 8; ++i) { p->verts[i] = (c2v){0, 0}; p->norms[i] = (c2v){0, 0}; }\n}\n\nstatic void rsimplex(c2Simplex *s) {\n    float *f = (float *)s;\n    for (size_t i = 0; i < sizeof(*s) / 4; ++i) f[i] = RND();\n    c2sv *v = &s->a;\n    for (int i = 0; i < 4; ++i) { v[i].iA = (int)(r32() % 8); v[i].iB = (int)(r32() % 8); }\n    s->div = RND(); if (s->div == 0) s->div = 1.0f;\n    s->count = (int)(r32() % 4);\n}\n\n#define D1(fn, T, ...)                                                         \\\n    do { T ra = A.fn(__VA_ARGS__), rbv = B.fn(__VA_ARGS__);                    \\\n         chk(#fn, &ra, &rbv, sizeof(T)); } while (0)\n\nint main(int argc, char **argv) {\n    if (argc < 3) { fprintf(stderr, \"usage: diff libA libB [iters]\\n\"); return 2; }\n    load(&A, argv[1]);\n    load(&B, argv[2]);\n    long N = argc > 3 ? atol(argv[3]) : 20000;\n\n    for (long it = 0; it < N; ++it) {\n        RND = (it % 4 == 3) ? rfx : rf;   /* mix nice + spicy inputs */\n\n        /* --- pure vector maths ------------------------------------------ */\n        { c2v u = rv(), v = rv(), w = rv(); float f = RND();\n          D1(c2V, c2v, u.x, u.y);\n          D1(c2Mulvs, c2v, u, f);\n          D1(c2Maxv, c2v, u, v);\n          D1(c2Minv, c2v, u, v);\n          D1(c2Clampv, c2v, u, v, w);\n          D1(c2Sub, c2v, u, v);\n          D1(c2Add, c2v, u, v);\n          D1(c2Dot, float, u, v);\n          D1(c2Len, float, u);\n          D1(c2Det2, float, u, v);\n          D1(c2Div, c2v, u, f);\n          D1(c2Norm, c2v, u);\n          D1(c2Neg, c2v, u);\n          D1(c2CCW90, c2v, u);\n          D1(c2Skew, c2v, u);\n          D1(c2Absv, c2v, u);\n          D1(c2Intersect, c2v, u, v, RND(), RND());\n          D1(c2Dist, float, rh(), u);\n          D1(c2RotIdentity, c2r);\n          D1(c2xIdentity, c2x);\n        }\n        { c2r r = rr(); c2v v = rv(); c2x x = rx();\n          D1(c2Mulrv, c2v, r, v);\n          D1(c2MulrvT, c2v, r, v);\n          D1(c2Mulxv, c2v, x, v);\n          D1(c2MulxvT, c2v, x, v);\n        }\n        /* --- c2PlaneAt / c2BBVerts / c2Norms --------------------------- */\n        { c2Poly p; rpoly(&p);\n          int i = (int)(r32() % (unsigned)p.count);\n          D1(c2PlaneAt, c2h, &p, i);\n          c2v na[8], nb[8];\n          memset(na, 0x5A, sizeof na); memset(nb, 0x5A, sizeof nb);\n          A.c2Norms(p.verts, na, p.count);\n          B.c2Norms(p.verts, nb, p.count);\n          chk(\"c2Norms\", na, nb, sizeof na);\n        }\n        { c2AABB bb = rb(); c2v oa[4], ob[4];\n          memset(oa, 0x5A, sizeof oa); memset(ob, 0x5A, sizeof ob);\n          A.c2BBVerts(oa, &bb); B.c2BBVerts(ob, &bb);\n          chk(\"c2BBVerts\", oa, ob, sizeof oa);\n        }\n        /* --- c2MakeProxy (all four types, incl. POLY) ------------------- */\n        { c2Circle c = rc(); c2AABB bb = rb(); c2Capsule cp = rcap(); c2Poly p; rpoly(&p);\n          const void *shapes[4] = {&cp, &c, &bb, &p};\n          for (int t = 0; t < 4; ++t) {\n              c2Proxy xa, xb;\n              memset(&xa, 0, sizeof xa); memset(&xb, 0, sizeof xb);\n              A.c2MakeProxy(shapes[t], (C2_TYPE)t, &xa);\n              B.c2MakeProxy(shapes[t], (C2_TYPE)t, &xb);\n              chk(\"c2MakeProxy\", &xa, &xb, sizeof xa);\n          }\n        }\n        /* --- simplex routines ------------------------------------------- */\n        { c2Simplex s0; rsimplex(&s0);\n          c2Simplex sa = s0, sb = s0;\n          float ma = A.c2GJKSimplexMetric(&sa), mb = B.c2GJKSimplexMetric(&sb);\n          chk(\"c2GJKSimplexMetric\", &ma, &mb, 4);\n          chk(\"c2GJKSimplexMetric/s\", &sa, &sb, sizeof sa);\n          sa = s0; sb = s0; A.c22(&sa); B.c22(&sb); chk(\"c22\", &sa, &sb, sizeof sa);\n          sa = s0; sb = s0; A.c23(&sa); B.c23(&sb); chk(\"c23\", &sa, &sb, sizeof sa);\n          sa = s0; sb = s0;\n          { c2v da = A.c2D(&sa), db = B.c2D(&sb);\n            chk(\"c2D\", &da, &db, sizeof da); chk(\"c2D/s\", &sa, &sb, sizeof sa); }\n          sa = s0; sb = s0;\n          { c2v la = A.c2L(&sa), lb = B.c2L(&sb);\n            chk(\"c2L\", &la, &lb, sizeof la); chk(\"c2L/s\", &sa, &sb, sizeof sa); }\n          sa = s0; sb = s0;\n          { c2v wa[2], wb[2];\n            memset(wa, 0x5A, sizeof wa); memset(wb, 0x5A, sizeof wb);\n            A.c2Witness(&sa, &wa[0], &wa[1]); B.c2Witness(&sb, &wb[0], &wb[1]);\n            chk(\"c2Witness\", wa, wb, sizeof wa); chk(\"c2Witness/s\", &sa, &sb, sizeof sa); }\n        }\n        /* --- c2Support -------------------------------------------------- */\n        { c2v verts[8]; for (int i = 0; i < 8; ++i) verts[i] = rv();\n          int n = 1 + (int)(r32() % 8); c2v d = rv();\n          D1(c2Support, int, verts, n, d);\n        }\n        /* --- c2GJK ------------------------------------------------------- */\n        { c2Circle c = rc(); c2AABB bb = rb(); c2Capsule cp = rcap(); c2Poly p; rpoly(&p);\n          const void *shapes[4] = {&cp, &c, &bb, &p};\n          c2x xa = rx(), xb2 = rx();\n          for (int ta = 0; ta < 4; ++ta) for (int tb = 0; tb < 4; ++tb) {\n              for (int mode = 0; mode < 4; ++mode) {\n                  int use_radius = mode & 1;\n                  const c2x *pxa = (mode & 2) ? &xa : NULL;\n                  const c2x *pxb = (mode & 2) ? &xb2 : NULL;\n                  c2v o1a, o2a, o1b, o2b; int ia = 0, ib = 0;\n                  memset(&o1a, 0x5A, 8); memset(&o2a, 0x5A, 8);\n                  memset(&o1b, 0x5A, 8); memset(&o2b, 0x5A, 8);\n                  c2GJKCache ca, cb; int usec = (int)(r32() & 1);\n                  memset(&ca, 0, sizeof ca);\n                  if (usec) {\n                      ca.count = (int)(r32() % 4); ca.div = rf(); ca.metric = rf();\n                      for (int k = 0; k < 3; ++k) { ca.iA[k] = (int)(r32() % 4); ca.iB[k] = (int)(r32() % 4); }\n                  }\n                  cb = ca;\n                  float ra = A.c2GJK(shapes[ta], (C2_TYPE)ta, pxa, shapes[tb], (C2_TYPE)tb,\n                                     pxb, &o1a, &o2a, use_radius, &ia, usec ? &ca : NULL);\n                  float rbv = B.c2GJK(shapes[ta], (C2_TYPE)ta, pxa, shapes[tb], (C2_TYPE)tb,\n                                      pxb, &o1b, &o2b, use_radius, &ib, usec ? &cb : NULL);\n                  char tag[48];\n                  snprintf(tag, sizeof tag, \"c2GJK(%d,%d)\", ta, tb);\n                  chk(tag, &ra, &rbv, 4);\n                  chk(tag, &o1a, &o1b, 8); chk(tag, &o2a, &o2b, 8);\n                  chk(tag, &ia, &ib, 4);\n                  if (usec) chk(tag, &ca, &cb, sizeof ca);\n              }\n          }\n        }\n        /* --- manifold functions ------------------------------------------ */\n#define MAN(tag, call)                                                          \\\n        do { c2Manifold ma, mb;                                                 \\\n             memset(&ma, 0x5A, sizeof ma); memset(&mb, 0x5A, sizeof mb);         \\\n             { API *L = &A; c2Manifold *m = &ma; call; }                         \\\n             { API *L = &B; c2Manifold *m = &mb; call; }                         \\\n             chk(tag, &ma, &mb, sizeof ma); } while (0)\n\n        { c2Circle c1 = rc(), c2_ = rc(); c2AABB b1 = rb(), b2 = rb();\n          c2Capsule p1 = rcap(), p2 = rcap(); c2Poly poly; rpoly(&poly);\n          c2x px = rx();\n          MAN(\"c2CircletoCircleManifold\", L->c2CircletoCircleManifold(c1, c2_, m));\n          MAN(\"c2CircletoAABBManifold\", L->c2CircletoAABBManifold(c1, b1, m));\n          MAN(\"c2CircletoCapsuleManifold\", L->c2CircletoCapsuleManifold(c1, p1, m));\n          MAN(\"c2AABBtoAABBManifold\", L->c2AABBtoAABBManifold(b1, b2, m));\n          MAN(\"c2CapsuletoCapsuleManifold\", L->c2CapsuletoCapsuleManifold(p1, p2, m));\n          MAN(\"c2AABBtoCapsuleManifold\", L->c2AABBtoCapsuleManifold(b1, p1, m));\n          MAN(\"c2CapsuletoPolyManifold/0\", L->c2CapsuletoPolyManifold(p1, &poly, NULL, m));\n          MAN(\"c2CapsuletoPolyManifold/x\", L->c2CapsuletoPolyManifold(p2, &poly, &px, m));\n          /* c2Collide over all 16 type pairs */\n          const void *shapes[4] = {&p1, &c1, &b1, &poly};\n          const void *shapes2[4] = {&p2, &c2_, &b2, &poly};\n          for (int ta = 0; ta < 4; ++ta) for (int tb = 0; tb < 4; ++tb) {\n              char tag[48]; snprintf(tag, sizeof tag, \"c2Collide(%d,%d)\", ta, tb);\n              c2Manifold ma, mb;\n              memset(&ma, 0x5A, sizeof ma); memset(&mb, 0x5A, sizeof mb);\n              A.c2Collide(shapes[ta], (C2_TYPE)ta, shapes2[tb], (C2_TYPE)tb, &ma);\n              B.c2Collide(shapes[ta], (C2_TYPE)ta, shapes2[tb], (C2_TYPE)tb, &mb);\n              chk(tag, &ma, &mb, sizeof ma);\n          }\n        }\n        /* --- ptr_from_parts (compare pointed-to contents) ---------------- */\n        { float f[5]; for (int i = 0; i < 5; ++i) f[i] = RND();\n          size_t sz[4] = {20, 12, 16, 0};\n          for (int t = 0; t < 3; ++t) {\n              void *pa = A.ptr_from_parts((C2_TYPE)t, f[0], f[1], f[2], f[3], f[4]);\n              void *pb = B.ptr_from_parts((C2_TYPE)t, f[0], f[1], f[2], f[3], f[4]);\n              char tag[48]; snprintf(tag, sizeof tag, \"ptr_from_parts(%d)\", t);\n              chk(tag, pa, pb, sz[t]);\n              free(pa); free(pb);\n          }\n        }\n        /* --- omni_manifold over all 16 type pairs ------------------------ */\n        { float a[5], b[5];\n          for (int i = 0; i < 5; ++i) { a[i] = RND(); b[i] = RND(); }\n          a[4] = fabsf(a[4]); b[4] = fabsf(b[4]);\n          for (int ta = 0; ta < 4; ++ta) for (int tb = 0; tb < 4; ++tb) {\n              char tag[48]; snprintf(tag, sizeof tag, \"omni_manifold(%d,%d)\", ta, tb);\n              c2Manifold ma, mb;\n              memset(&ma, 0x5A, sizeof ma); memset(&mb, 0x5A, sizeof mb);\n              A.omni_manifold(&ma, (C2_TYPE)ta, a[0], a[1], a[2], a[3], a[4],\n                              (C2_TYPE)tb, b[0], b[1], b[2], b[3], b[4]);\n              B.omni_manifold(&mb, (C2_TYPE)ta, a[0], a[1], a[2], a[3], a[4],\n                              (C2_TYPE)tb, b[0], b[1], b[2], b[3], b[4]);\n              chk(tag, &ma, &mb, sizeof ma);\n          }\n        }\n    }\n\n    printf(\"checks=%ld  mismatches=%ld\\n\", checks, fails);\n    if (nfailed) {\n        printf(\"mismatching functions:\\n\");\n        for (int i = 0; i < nfailed; ++i)\n            printf(\"  %-32s %ld\\n\", failed_fn[i], failed_cnt[i]);\n    } else {\n        printf(\"ALL BIT-IDENTICAL\\n\");\n    }\n    return fails != 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3513,"cache_read_input_tokens":93685,"cache_creation":{"ephemeral_5m_input_tokens":3513,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"2e9cf834-8ec9-4ac2-83fe-5696fe0e53b9","uuid":"7837762a-2652-4831-96a6-af93749fdc14","timestamp":"2026-08-27T12:08:44.736Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LKRwFFHCYeXGuxwp5JLnj5","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-eDM8W0/_probe/diff.c (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"2e9cf834-8ec9-4ac2-83fe-5696fe0e53b9","uuid":"7b2ec9d0-de71-4457-a4f5-7fa98898fc10","timestamp":"2026-08-27T12:08:44.746Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-eDM8W0/_probe/diff.c","content":"// Differential tester: loads two shared libraries and compares every exported\n// symbol's observable output bit-for-bit.\n#define _GNU_SOURCE\n#include <dlfcn.h>\n#include <math.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef enum { C2_TYPE_CAPSULE, C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_POLY } C2_TYPE;\ntypedef struct c2v { float x, y; } c2v;\ntypedef struct c2Manifold { int count; float depths[2]; c2v contact_points[2]; c2v n; } c2Manifold;\ntypedef struct c2h { c2v n; float d; } c2h;\ntypedef struct c2r { float c, s; } c2r;\ntypedef struct c2x { c2v p; c2r r; } c2x;\ntypedef struct c2Circle { c2v p; float r; } c2Circle;\ntypedef struct c2AABB { c2v min, max; } c2AABB;\ntypedef struct c2Capsule { c2v a, b; float r; } c2Capsule;\ntypedef struct c2Poly { int count; c2v verts[8]; c2v norms[8]; } c2Poly;\ntypedef struct c2GJKCache { float metric; int count; int iA[3]; int iB[3]; float div; } c2GJKCache;\ntypedef struct c2Proxy { float radius; int count; c2v verts[8]; } c2Proxy;\ntypedef struct c2sv { c2v sA, sB, p; float u; int iA, iB; } c2sv;\ntypedef struct c2Simplex { c2sv a, b, c, d; float div; int count; } c2Simplex;\n\ntypedef struct {\n    void *h;\n    c2v (*c2V)(float, float);\n    c2v (*c2Mulvs)(c2v, float);\n    c2v (*c2Maxv)(c2v, c2v);\n    c2v (*c2Minv)(c2v, c2v);\n    c2v (*c2Clampv)(c2v, c2v, c2v);\n    c2v (*c2Sub)(c2v, c2v);\n    float (*c2Dot)(c2v, c2v);\n    float (*c2Dist)(c2h, c2v);\n    c2h (*c2PlaneAt)(const c2Poly *, int);\n    c2r (*c2RotIdentity)(void);\n    c2x (*c2xIdentity)(void);\n    void (*c2BBVerts)(c2v *, c2AABB *);\n    void (*c2MakeProxy)(const void *, C2_TYPE, c2Proxy *);\n    float (*c2Len)(c2v);\n    float (*c2Det2)(c2v, c2v);\n    float (*c2GJKSimplexMetric)(c2Simplex *);\n    c2v (*c2Mulrv)(c2r, c2v);\n    c2v (*c2MulrvT)(c2r, c2v);\n    c2v (*c2Add)(c2v, c2v);\n    c2v (*c2Mulxv)(c2x, c2v);\n    c2v (*c2MulxvT)(c2x, c2v);\n    c2v (*c2Intersect)(c2v, c2v, float, float);\n    c2v (*c2Div)(c2v, float);\n    c2v (*c2Norm)(c2v);\n    c2v (*c2Neg)(c2v);\n    c2v (*c2CCW90)(c2v);\n    void (*c22)(c2Simplex *);\n    void (*c23)(c2Simplex *);\n    c2v (*c2Skew)(c2v);\n    c2v (*c2D)(c2Simplex *);\n    int (*c2Support)(const c2v *, int, c2v);\n    void (*c2Witness)(c2Simplex *, c2v *, c2v *);\n    c2v (*c2L)(c2Simplex *);\n    float (*c2GJK)(const void *, C2_TYPE, const c2x *, const void *, C2_TYPE,\n                   const c2x *, c2v *, c2v *, int, int *, c2GJKCache *);\n    c2v (*c2Absv)(c2v);\n    void (*c2CircletoCircleManifold)(c2Circle, c2Circle, c2Manifold *);\n    void (*c2CircletoAABBManifold)(c2Circle, c2AABB, c2Manifold *);\n    void (*c2CircletoCapsuleManifold)(c2Circle, c2Capsule, c2Manifold *);\n    void (*c2AABBtoAABBManifold)(c2AABB, c2AABB, c2Manifold *);\n    void (*c2CapsuletoPolyManifold)(c2Capsule, const c2Poly *, const c2x *, c2Manifold *);\n    void (*c2Norms)(c2v *, c2v *, int);\n    void (*c2AABBtoCapsuleManifold)(c2AABB, c2Capsule, c2Manifold *);\n    void (*c2CapsuletoCapsuleManifold)(c2Capsule, c2Capsule, c2Manifold *);\n    void (*c2Collide)(const void *, C2_TYPE, const void *, C2_TYPE, c2Manifold *);\n    void *(*ptr_from_parts)(C2_TYPE, float, float, float, float, float);\n    void (*omni_manifold)(c2Manifold *, C2_TYPE, float, float, float, float, float,\n                          C2_TYPE, float, float, float, float, float);\n} API;\n\n#define LOAD(a, n)                                                             \\\n    do {                                                                       \\\n        *(void **)(&(a)->n) = dlsym((a)->h, #n);                                \\\n        if (!(a)->n) { fprintf(stderr, \"missing %s\\n\", #n); exit(2); }          \\\n    } while (0)\n\nstatic void load(API *a, const char *path) {\n    a->h = dlopen(path, RTLD_NOW | RTLD_LOCAL);\n    if (!a->h) { fprintf(stderr, \"dlopen %s: %s\\n\", path, dlerror()); exit(2); }\n    LOAD(a, c2V); LOAD(a, c2Mulvs); LOAD(a, c2Maxv); LOAD(a, c2Minv);\n    LOAD(a, c2Clampv); LOAD(a, c2Sub); LOAD(a, c2Dot); LOAD(a, c2Dist);\n    LOAD(a, c2PlaneAt); LOAD(a, c2RotIdentity); LOAD(a, c2xIdentity);\n    LOAD(a, c2BBVerts); LOAD(a, c2MakeProxy); LOAD(a, c2Len); LOAD(a, c2Det2);\n    LOAD(a, c2GJKSimplexMetric); LOAD(a, c2Mulrv); LOAD(a, c2MulrvT);\n    LOAD(a, c2Add); LOAD(a, c2Mulxv); LOAD(a, c2MulxvT); LOAD(a, c2Intersect);\n    LOAD(a, c2Div); LOAD(a, c2Norm); LOAD(a, c2Neg); LOAD(a, c2CCW90);\n    LOAD(a, c22); LOAD(a, c23); LOAD(a, c2Skew); LOAD(a, c2D);\n    LOAD(a, c2Support); LOAD(a, c2Witness); LOAD(a, c2L); LOAD(a, c2GJK);\n    LOAD(a, c2Absv); LOAD(a, c2CircletoCircleManifold);\n    LOAD(a, c2CircletoAABBManifold); LOAD(a, c2CircletoCapsuleManifold);\n    LOAD(a, c2AABBtoAABBManifold); LOAD(a, c2CapsuletoPolyManifold);\n    LOAD(a, c2Norms); LOAD(a, c2AABBtoCapsuleManifold);\n    LOAD(a, c2CapsuletoCapsuleManifold); LOAD(a, c2Collide);\n    LOAD(a, ptr_from_parts); LOAD(a, omni_manifold);\n}\n\nstatic API A, B;\nstatic long checks = 0, fails = 0;\nstatic char failed_fn[64][64];\nstatic long failed_cnt[64];\nstatic int nfailed = 0;\n\nstatic void note(const char *tag) {\n    for (int i = 0; i < nfailed; ++i)\n        if (!strcmp(failed_fn[i], tag)) { failed_cnt[i]++; return; }\n    if (nfailed < 64) {\n        snprintf(failed_fn[nfailed], 64, \"%s\", tag);\n        failed_cnt[nfailed] = 1;\n        nfailed++;\n    }\n}\n\nstatic void chk(const char *tag, const void *p, const void *q, size_t n) {\n    checks++;\n    if (memcmp(p, q, n)) { fails++; note(tag); }\n}\n\n/* ---- random helpers ---------------------------------------------------- */\nstatic uint64_t rs = 0x243F6A8885A308D3ULL;\nstatic uint32_t r32(void) {\n    rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17;\n    return (uint32_t)(rs >> 32);\n}\nstatic float rf(void) { /* \"nice\" floats */\n    return ((float)(int)(r32() % 40001) - 20000.0f) / 100.0f;\n}\nstatic float rfx(void) { /* spicy floats incl. 0, -0, inf, nan, denormals */\n    switch (r32() % 16) {\n    case 0: return 0.0f;\n    case 1: return -0.0f;\n    case 2: return INFINITY;\n    case 3: return -INFINITY;\n    case 4: return NAN;\n    case 5: return 1e-40f;\n    case 6: return -1e-40f;\n    case 7: return 3.4028234663852886e38f;\n    case 8: return 1.1920929e-7f;\n    default: return rf();\n    }\n}\nstatic float (*RND)(void) = rf;\nstatic c2v rv(void) { c2v v; v.x = RND(); v.y = RND(); return v; }\nstatic c2h rh(void) { c2h h; h.n = rv(); h.d = RND(); return h; }\nstatic c2r rr(void) { c2r r; float a = RND(); r.c = cosf(a); r.s = sinf(a); return r; }\nstatic c2x rx(void) { c2x x; x.p = rv(); x.r = rr(); return x; }\nstatic c2Circle rc(void) { c2Circle c; c.p = rv(); c.r = fabsf(RND()); return c; }\nstatic c2AABB rb(void) {\n    c2AABB b; c2v u = rv(), v = rv();\n    b.min.x = u.x < v.x ? u.x : v.x; b.min.y = u.y < v.y ? u.y : v.y;\n    b.max.x = u.x < v.x ? v.x : u.x; b.max.y = u.y < v.y ? v.y : u.y;\n    return b;\n}\nstatic c2Capsule rcap(void) { c2Capsule c; c.a = rv(); c.b = rv(); c.r = fabsf(RND()); return c; }\n\nstatic void rpoly(c2Poly *p) {\n    int n = 3 + (int)(r32() % 6);\n    float cx = rf(), cy = rf(), rad = fabsf(rf()) + 0.5f;\n    float base = rf();\n    for (int i = 0; i < n; ++i) {\n        float ang = base + 6.28318530718f * (float)i / (float)n;\n        p->verts[i].x = cx + rad * cosf(ang);\n        p->verts[i].y = cy + rad * sinf(ang);\n    }\n    p->count = n;\n    A.c2Norms(p->verts, p->norms, n); /* identical in both libs (verified separately) */\n    for (int i = n; i < 8; ++i) { p->verts[i] = (c2v){0, 0}; p->norms[i] = (c2v){0, 0}; }\n}\n\nstatic void rsimplex(c2Simplex *s) {\n    float *f = (float *)s;\n    for (size_t i = 0; i < sizeof(*s) / 4; ++i) f[i] = RND();\n    c2sv *v = &s->a;\n    for (int i = 0; i < 4; ++i) { v[i].iA = (int)(r32() % 8); v[i].iB = (int)(r32() % 8); }\n    s->div = RND(); if (s->div == 0) s->div = 1.0f;\n    s->count = (int)(r32() % 4);\n}\n\n#define D1(fn, T, ...)                                                         \\\n    do { T ra = A.fn(__VA_ARGS__), rbv = B.fn(__VA_ARGS__);                    \\\n         chk(#fn, &ra, &rbv, sizeof(T)); } while (0)\n\nint main(int argc, char **argv) {\n    if (argc < 3) { fprintf(stderr, \"usage: diff libA libB [iters]\\n\"); return 2; }\n    load(&A, argv[1]);\n    load(&B, argv[2]);\n    long N = argc > 3 ? atol(argv[3]) : 20000;\n\n    for (long it = 0; it < N; ++it) {\n        RND = (it % 4 == 3) ? rfx : rf;   /* mix nice + spicy inputs */\n\n        /* --- pure vector maths ------------------------------------------ */\n        { c2v u = rv(), v = rv(), w = rv(); float f = RND();\n          D1(c2V, c2v, u.x, u.y);\n          D1(c2Mulvs, c2v, u, f);\n          D1(c2Maxv, c2v, u, v);\n          D1(c2Minv, c2v, u, v);\n          D1(c2Clampv, c2v, u, v, w);\n          D1(c2Sub, c2v, u, v);\n          D1(c2Add, c2v, u, v);\n          D1(c2Dot, float, u, v);\n          D1(c2Len, float, u);\n          D1(c2Det2, float, u, v);\n          D1(c2Div, c2v, u, f);\n          D1(c2Norm, c2v, u);\n          D1(c2Neg, c2v, u);\n          D1(c2CCW90, c2v, u);\n          D1(c2Skew, c2v, u);\n          D1(c2Absv, c2v, u);\n          D1(c2Intersect, c2v, u, v, RND(), RND());\n          D1(c2Dist, float, rh(), u);\n          D1(c2RotIdentity, c2r);\n          D1(c2xIdentity, c2x);\n        }\n        { c2r r = rr(); c2v v = rv(); c2x x = rx();\n          D1(c2Mulrv, c2v, r, v);\n          D1(c2MulrvT, c2v, r, v);\n          D1(c2Mulxv, c2v, x, v);\n          D1(c2MulxvT, c2v, x, v);\n        }\n        /* --- c2PlaneAt / c2BBVerts / c2Norms --------------------------- */\n        { c2Poly p; rpoly(&p);\n          int i = (int)(r32() % (unsigned)p.count);\n          D1(c2PlaneAt, c2h, &p, i);\n          c2v na[8], nb[8];\n          memset(na, 0x5A, sizeof na); memset(nb, 0x5A, sizeof nb);\n          A.c2Norms(p.verts, na, p.count);\n          B.c2Norms(p.verts, nb, p.count);\n          chk(\"c2Norms\", na, nb, sizeof na);\n        }\n        { c2AABB bb = rb(); c2v oa[4], ob[4];\n          memset(oa, 0x5A, sizeof oa); memset(ob, 0x5A, sizeof ob);\n          A.c2BBVerts(oa, &bb); B.c2BBVerts(ob, &bb);\n          chk(\"c2BBVerts\", oa, ob, sizeof oa);\n        }\n        /* --- c2MakeProxy (all four types, incl. POLY) ------------------- */\n        { c2Circle c = rc(); c2AABB bb = rb(); c2Capsule cp = rcap(); c2Poly p; rpoly(&p);\n          const void *shapes[4] = {&cp, &c, &bb, &p};\n          for (int t = 0; t < 4; ++t) {\n              c2Proxy xa, xb;\n              memset(&xa, 0, sizeof xa); memset(&xb, 0, sizeof xb);\n              A.c2MakeProxy(shapes[t], (C2_TYPE)t, &xa);\n              B.c2MakeProxy(shapes[t], (C2_TYPE)t, &xb);\n              chk(\"c2MakeProxy\", &xa, &xb, sizeof xa);\n          }\n        }\n        /* --- simplex routines ------------------------------------------- */\n        { c2Simplex s0; rsimplex(&s0);\n          c2Simplex sa = s0, sb = s0;\n          float ma = A.c2GJKSimplexMetric(&sa), mb = B.c2GJKSimplexMetric(&sb);\n          chk(\"c2GJKSimplexMetric\", &ma, &mb, 4);\n          chk(\"c2GJKSimplexMetric/s\", &sa, &sb, sizeof sa);\n          sa = s0; sb = s0; A.c22(&sa); B.c22(&sb); chk(\"c22\", &sa, &sb, sizeof sa);\n          sa = s0; sb = s0; A.c23(&sa); B.c23(&sb); chk(\"c23\", &sa, &sb, sizeof sa);\n          sa = s0; sb = s0;\n          { c2v da = A.c2D(&sa), db = B.c2D(&sb);\n            chk(\"c2D\", &da, &db, sizeof da); chk(\"c2D/s\", &sa, &sb, sizeof sa); }\n          sa = s0; sb = s0;\n          { c2v la = A.c2L(&sa), lb = B.c2L(&sb);\n            chk(\"c2L\", &la, &lb, sizeof la); chk(\"c2L/s\", &sa, &sb, sizeof sa); }\n          sa = s0; sb = s0;\n          { c2v wa[2], wb[2];\n            memset(wa, 0x5A, sizeof wa); memset(wb, 0x5A, sizeof wb);\n            A.c2Witness(&sa, &wa[0], &wa[1]); B.c2Witness(&sb, &wb[0], &wb[1]);\n            chk(\"c2Witness\", wa, wb, sizeof wa); chk(\"c2Witness/s\", &sa, &sb, sizeof sa); }\n        }\n        /* --- c2Support -------------------------------------------------- */\n        { c2v verts[8]; for (int i = 0; i < 8; ++i) verts[i] = rv();\n          int n = 1 + (int)(r32() % 8); c2v d = rv();\n          D1(c2Support, int, verts, n, d);\n        }\n        /* --- c2GJK ------------------------------------------------------- */\n        { c2Circle c = rc(); c2AABB bb = rb(); c2Capsule cp = rcap(); c2Poly p; rpoly(&p);\n          const void *shapes[4] = {&cp, &c, &bb, &p};\n          c2x xa = rx(), xb2 = rx();\n          for (int ta = 0; ta < 4; ++ta) for (int tb = 0; tb < 4; ++tb) {\n              for (int mode = 0; mode < 4; ++mode) {\n                  int use_radius = mode & 1;\n                  const c2x *pxa = (mode & 2) ? &xa : NULL;\n                  const c2x *pxb = (mode & 2) ? &xb2 : NULL;\n                  c2v o1a, o2a, o1b, o2b; int ia = 0, ib = 0;\n                  memset(&o1a, 0x5A, 8); memset(&o2a, 0x5A, 8);\n                  memset(&o1b, 0x5A, 8); memset(&o2b, 0x5A, 8);\n                  c2GJKCache ca, cb; int usec = (int)(r32() & 1);\n                  memset(&ca, 0, sizeof ca);\n                  if (usec) {\n                      ca.count = (int)(r32() % 4); ca.div = rf(); ca.metric = rf();\n                      for (int k = 0; k < 3; ++k) { ca.iA[k] = (int)(r32() % 4); ca.iB[k] = (int)(r32() % 4); }\n                  }\n                  cb = ca;\n                  float ra = A.c2GJK(shapes[ta], (C2_TYPE)ta, pxa, shapes[tb], (C2_TYPE)tb,\n                                     pxb, &o1a, &o2a, use_radius, &ia, usec ? &ca : NULL);\n                  float rbv = B.c2GJK(shapes[ta], (C2_TYPE)ta, pxa, shapes[tb], (C2_TYPE)tb,\n                                      pxb, &o1b, &o2b, use_radius, &ib, usec ? &cb : NULL);\n                  char tag[48];\n                  snprintf(tag, sizeof tag, \"c2GJK(%d,%d)\", ta, tb);\n                  chk(tag, &ra, &rbv, 4);\n                  chk(tag, &o1a, &o1b, 8); chk(tag, &o2a, &o2b, 8);\n                  chk(tag, &ia, &ib, 4);\n                  if (usec) chk(tag, &ca, &cb, sizeof ca);\n              }\n          }\n        }\n        /* --- manifold functions ------------------------------------------ */\n#define MAN(tag, call)                                                          \\\n        do { c2Manifold ma, mb;                                                 \\\n             memset(&ma, 0x5A, sizeof ma); memset(&mb, 0x5A, sizeof mb);         \\\n             { API *L = &A; c2Manifold *m = &ma; call; }                         \\\n             { API *L = &B; c2Manifold *m = &mb; call; }                         \\\n             chk(tag, &ma, &mb, sizeof ma); } while (0)\n\n        { c2Circle c1 = rc(), c2_ = rc(); c2AABB b1 = rb(), b2 = rb();\n          c2Capsule p1 = rcap(), p2 = rcap(); c2Poly poly; rpoly(&poly);\n          c2x px = rx();\n          MAN(\"c2CircletoCircleManifold\", L->c2CircletoCircleManifold(c1, c2_, m));\n          MAN(\"c2CircletoAABBManifold\", L->c2CircletoAABBManifold(c1, b1, m));\n          MAN(\"c2CircletoCapsuleManifold\", L->c2CircletoCapsuleManifold(c1, p1, m));\n          MAN(\"c2AABBtoAABBManifold\", L->c2AABBtoAABBManifold(b1, b2, m));\n          MAN(\"c2CapsuletoCapsuleManifold\", L->c2CapsuletoCapsuleManifold(p1, p2, m));\n          MAN(\"c2AABBtoCapsuleManifold\", L->c2AABBtoCapsuleManifold(b1, p1, m));\n          MAN(\"c2CapsuletoPolyManifold/0\", L->c2CapsuletoPolyManifold(p1, &poly, NULL, m));\n          MAN(\"c2CapsuletoPolyManifold/x\", L->c2CapsuletoPolyManifold(p2, &poly, &px, m));\n          /* c2Collide over all 16 type pairs */\n          const void *shapes[4] = {&p1, &c1, &b1, &poly};\n          const void *shapes2[4] = {&p2, &c2_, &b2, &poly};\n          for (int ta = 0; ta < 4; ++ta) for (int tb = 0; tb < 4; ++tb) {\n              char tag[48]; snprintf(tag, sizeof tag, \"c2Collide(%d,%d)\", ta, tb);\n              c2Manifold ma, mb;\n              memset(&ma, 0x5A, sizeof ma); memset(&mb, 0x5A, sizeof mb);\n              A.c2Collide(shapes[ta], (C2_TYPE)ta, shapes2[tb], (C2_TYPE)tb, &ma);\n              B.c2Collide(shapes[ta], (C2_TYPE)ta, shapes2[tb], (C2_TYPE)tb, &mb);\n              chk(tag, &ma, &mb, sizeof ma);\n          }\n        }\n        /* --- ptr_from_parts (compare pointed-to contents) ---------------- */\n        { float f[5]; for (int i = 0; i < 5; ++i) f[i] = RND();\n          size_t sz[4] = {20, 12, 16, 0};\n          for (int t = 0; t < 3; ++t) {\n              void *pa = A.ptr_from_parts((C2_TYPE)t, f[0], f[1], f[2], f[3], f[4]);\n              void *pb = B.ptr_from_parts((C2_TYPE)t, f[0], f[1], f[2], f[3], f[4]);\n              char tag[48]; snprintf(tag, sizeof tag, \"ptr_from_parts(%d)\", t);\n              chk(tag, pa, pb, sz[t]);\n              free(pa); free(pb);\n          }\n        }\n        /* --- omni_manifold over all 16 type pairs ------------------------ */\n        { float a[5], b[5];\n          for (int i = 0; i < 5; ++i) { a[i] = RND(); b[i] = RND(); }\n          a[4] = fabsf(a[4]); b[4] = fabsf(b[4]);\n          for (int ta = 0; ta < 4; ++ta) for (int tb = 0; tb < 4; ++tb) {\n              char tag[48]; snprintf(tag, sizeof tag, \"omni_manifold(%d,%d)\", ta, tb);\n              c2Manifold ma, mb;\n              memset(&ma, 0x5A, sizeof ma); memset(&mb, 0x5A, sizeof mb);\n              A.omni_manifold(&ma, (C2_TYPE)ta, a[0], a[1],