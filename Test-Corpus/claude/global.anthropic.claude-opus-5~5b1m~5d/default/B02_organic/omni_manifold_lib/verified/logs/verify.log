: f32,\n130\t    pub iA: c_int,\n131\t    pub iB: c_int,\n132\t}\n133\t\n134\t/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n135\t///\n136\t/// The C code relies on `a`, `b`, `c`, `d` being contiguous (`c2sv* verts = &s.a`),\n137\t/// which this `#[repr(C)]` layout reproduces.\n138\t#[repr(C)]\n139\t#[derive(Copy, Clone)]\n140\tpub struct c2Simplex {\n141\t    pub a: c2sv,\n142\t    pub b: c2sv,\n143\t    pub c: c2sv,\n144\t    pub d: c2sv,\n145\t    pub div: f32,\n146\t    pub count: c_int,\n147\t}\n148\t\n149\tconst ZERO_V: c2v = c2v { x: 0.0, y: 0.0 };\n150\t\n151\t/// C's unary `-` on a float is an IEEE-754 sign-bit flip (gcc emits `xorps`),\n152\t/// which is also applied to NaN payloads.  Expressed as an explicit bit flip so\n153\t/// that LLVM cannot rewrite `(-a) * b` into `-(a * b)`, a transform that would\n154\t/// change the sign bit of a resulting NaN.\n155\t#[inline(always)]\n156\tfn fneg(x: f32) -> f32 {\n157\t    // `black_box` is the barrier: without it LLVM recognises the sign flip and\n158\t    // sinks it into the neighbouring arithmetic (e.g. `(-a) * b + c` becomes\n159\t    // `c - a * b`), which changes the sign bit of a NaN result.\n160\t    std::hint::black_box(f32::from_bits(x.to_bits() ^ 0x8000_0000))\n161\t}\n162\t\n163\t/// x86 SSE scalar ops select which NaN propagates by *operand position*:\n164\t/// `op dst, src` yields `dst` when `dst` is NaN, else `src` when `src` is NaN.\n165\t/// gcc's register allocation therefore fixes which NaN a mixed-NaN expression\n166\t/// returns; these helpers let the translation name that choice explicitly.\n167\t/// For non-NaN operands they are exactly the plain IEEE-754 operation.\n168\t#[inline(always)]\n169\tfn x86_mul(dst: f32, src: f32) -> f32 {\n170\t    let r = if dst.is_nan() {\n171\t        dst\n172\t    } else if src.is_nan() {\n173\t        src\n174\t    } else {\n175\t        dst * src\n176\t    };\n177\t    std::hint::black_box(r)\n178\t}\n179\t\n180\t#[inline(always)]\n181\tfn x86_add(dst: f32, src: f32) -> f32 {\n182\t    let r = if dst.is_nan() {\n183\t        dst\n184\t    } else if src.is_nan() {\n185\t        src\n186\t    } else {\n187\t        dst + src\n188\t    };\n189\t    std::hint::black_box(r)\n190\t}\n191\t\n192\t#[inline(always)]\n193\tfn x86_sub(dst: f32, src: f32) -> f32 {\n194\t    let r = if dst.is_nan() {\n195\t        dst\n196\t    } else if src.is_nan() {\n197\t        src\n198\t    } else {\n199\t        dst - src\n200\t    };\n201\t    std::hint::black_box(r)\n202\t}\n203\t\n204\textern \"C\" {\n205\t    fn malloc(size: usize) -> *mut c_void;\n206\t}\n207\t\n208\t// ---------------------------------------------------------------------------\n209\t// Vector helpers\n210\t// ---------------------------------------------------------------------------\n211\t\n212\t#[unsafe(no_mangle)]\n213\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n214\t    let mut a: c2v = ZERO_V;\n215\t    a.x = x;\n216\t    a.y = y;\n217\t    a\n218\t}\n219\t\n220\t#[unsafe(no_mangle)]\n221\tpub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n222\t    // gcc: mulss dst=a.x,src=b ; mulss dst=a.y,src=b\n223\t    let mut a = a;\n224\t    a.x = x86_mul(a.x, b);\n225\t    a.y = x86_mul(a.y, b);\n226\t    a\n227\t}\n228\t\n229\t#[unsafe(no_mangle)]\n230\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n231\t    c2V(\n232\t        if a.x > b.x { a.x } else { b.x },\n233\t        if a.y > b.y { a.y } else { b.y },\n234\t    )\n235\t}\n236\t\n237\t#[unsafe(no_mangle)]\n238\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n239\t    c2V(\n240\t        if a.x < b.x { a.x } else { b.x },\n241\t        if a.y < b.y { a.y } else { b.y },\n242\t    )\n243\t}\n244\t\n245\t#[unsafe(no_mangle)]\n246\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n247\t    c2Maxv(lo, c2Minv(a, hi))\n248\t}\n249\t\n250\t#[unsafe(no_mangle)]\n251\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n252\t    // gcc: subss dst=a.x,src=b.x ; subss dst=a.y,src=b.y\n253\t    let mut a = a;\n254\t    a.x = x86_sub(a.x, b.x);\n255\t    a.y = x86_sub(a.y, b.y);\n256\t    a\n257\t}\n258\t\n259\t#[unsafe(no_mangle)]\n260\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n261\t    // gcc: mulss dst=a.x,src=b.x ; mulss dst=b.y,src=a.y ; addss dst=p2,src=p1\n262\t    let p1 = x86_mul(a.x, b.x);\n263\t    let p2 = x86_mul(b.y, a.y);\n264\t    x86_add(p2, p1)\n265\t}\n266\t\n267\t#[unsafe(no_mangle)]\n268\tpub extern \"C\" fn c2Dist(h: c2h, p: c2v) -> f32 {\n269\t    c2Dot(h.n, p) - h.d\n270\t}\n271\t\n272\t#[unsafe(no_mangle)]\n273\tpub unsafe extern \"C\" fn c2PlaneAt(p: *const c2Poly, i: c_int) -> c2h {\n274\t    let mut h = c2h { n: ZERO_V, d: 0.0 };\n275\t    let norms = (*p).norms.as_ptr();\n276\t    let verts = (*p).verts.as_ptr();\n277\t    h.n = *norms.offset(i as isize);\n278\t    h.d = c2Dot(*norms.offset(i as isize), *verts.offset(i as isize));\n279\t    h\n280\t}\n281\t\n282\t#[unsafe(no_mangle)]\n283\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n284\t    let mut r = c2r { c: 0.0, s: 0.0 };\n285\t    r.c = 1.0f32;\n286\t    r.s = 0.0;\n287\t    r\n288\t}\n289\t\n290\t#[unsafe(no_mangle)]\n291\tpub extern \"C\" fn c2xIdentity() -> c2x {\n292\t    let mut x = c2x {\n293\t        p: ZERO_V,\n294\t        r: c2r { c: 0.0, s: 0.0 },\n295\t    };\n296\t    x.p = c2V(0.0, 0.0);\n297\t    x.r = c2RotIdentity();\n298\t    x\n299\t}\n300\t\n301\t#[unsafe(no_mangle)]\n302\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n303\t    *out.offset(0) = (*bb).min;\n304\t    *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n305\t    *out.offset(2) = (*bb).max;\n306\t    *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n307\t}\n308\t\n309\t/// NOTE: the C source has **no** `C2_TYPE_POLY` case, so a poly proxy is left\n310\t/// completely untouched (uninitialised in C).  Reproduced faithfully: nothing is\n311\t/// written for any other type value.\n312\t#[unsafe(no_mangle)]\n313\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n314\t    match type_ {\n315\t        C2_TYPE_CIRCLE => {\n316\t            let c = shape as *const c2Circle;\n317\t            (*p).radius = (*c).r;\n318\t            (*p).count = 1;\n319\t            (*p).verts[0] = (*c).p;\n320\t        }\n321\t        C2_TYPE_AABB => {\n322\t            let bb = shape as *mut c2AABB;\n323\t            (*p).radius = 0.0;\n324\t            (*p).count = 4;\n325\t            let verts = (*p).verts.as_mut_ptr();\n326\t            c2BBVerts(verts, bb);\n327\t        }\n328\t        C2_TYPE_CAPSULE => {\n329\t            let c = shape as *const c2Capsule;\n330\t            (*p).radius = (*c).r;\n331\t            (*p).count = 2;\n332\t            (*p).verts[0] = (*c).a;\n333\t            (*p).verts[1] = (*c).b;\n334\t        }\n335\t        _ => {}\n336\t    }\n337\t}\n338\t\n339\t#[unsafe(no_mangle)]\n340\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n341\t    c2Dot(a, a).sqrt()\n342\t}\n343\t\n344\t#[unsafe(no_mangle)]\n345\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n346\t    // gcc: mulss dst=b.y,src=a.x ; mulss dst=b.x,src=a.y ; subss dst=p1,src=p2\n347\t    let p1 = x86_mul(b.y, a.x);\n348\t    let p2 = x86_mul(b.x, a.y);\n349\t    x86_sub(p1, p2)\n350\t}\n351\t\n352\t#[unsafe(no_mangle)]\n353\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n354\t    match (*s).count {\n355\t        2 => c2Len(c2Sub((*s).b.p, (*s).a.p)),\n356\t        3 => c2Det2(c2Sub((*s).b.p, (*s).a.p), c2Sub((*s).c.p, (*s).a.p)),\n357\t        // `default:` and `case 1:` fall together in the C switch.\n358\t        _ => 0.0,\n359\t    }\n360\t}\n361\t\n362\t#[unsafe(no_mangle)]\n363\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n364\t    // gcc -O0 emits, for `a.c * b.x - a.s * b.y`:\n365\t    //   mulss dst=b.x,src=a.c ; mulss dst=b.y,src=a.s ; subss dst=p1,src=p2\n366\t    // and for `a.s * b.x + a.c * b.y`:\n367\t    //   mulss dst=a.s,src=b.x ; mulss dst=b.y,src=a.c ; addss dst=p1,src=p2\n368\t    c2V(\n369\t        x86_sub(x86_mul(b.x, a.c), x86_mul(b.y, a.s)),\n370\t        x86_add(x86_mul(a.s, b.x), x86_mul(b.y, a.c)),\n371\t    )\n372\t}\n373\t\n374\t#[unsafe(no_mangle)]\n375\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n376\t    // gcc -O0 emits, for `a.c * b.x + a.s * b.y`:\n377\t    //   mulss dst=a.c,src=b.x ; mulss dst=b.y,src=a.s ; addss dst=p1,src=p2\n378\t    // and for `-a.s * b.x + a.c * b.y`:\n379\t    //   xorps (negate) ; mulss dst=-a.s,src=b.x ; mulss dst=b.y,src=a.c ;\n380\t    //   addss dst=p1,src=p2\n381\t    c2V(\n382\t        x86_add(x86_mul(a.c, b.x), x86_mul(b.y, a.s)),\n383\t        x86_add(x86_mul(fneg(a.s), b.x), x86_mul(b.y, a.c)),\n384\t    )\n385\t}\n386\t\n387\t#[unsafe(no_mangle)]\n388\tpub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n389\t    // gcc: addss dst=b.x,src=a.x ; addss dst=b.y,src=a.y\n390\t    let mut a = a;\n391\t    a.x = x86_add(b.x, a.x);\n392\t    a.y = x86_add(b.y, a.y);\n393\t    a\n394\t}\n395\t\n396\t#[unsafe(no_mangle)]\n397\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n398\t    c2Add(c2Mulrv(a.r, b), a.p)\n399\t}\n400\t\n401\t#[unsafe(no_mangle)]\n402\tpub extern \"C\" fn c2MulxvT(a: c2x, b: c2v) -> c2v {\n403\t    c2MulrvT(a.r, c2Sub(b, a.p))\n404\t}\n405\t\n406\t#[unsafe(no_mangle)]\n407\tpub extern \"C\" fn c2Intersect(a: c2v, b: c2v, da: f32, db: f32) -> c2v {\n408\t    c2Add(a, c2Mulvs(c2Sub(b, a), da / (da - db)))\n409\t}\n410\t\n411\t/// `static int c2Clip(c2v *seg, c2h h)` — not exported.\n412\t///\n413\t/// The C version leaves `out[]` (partly) uninitialised when it returns < 2; the\n414\t/// two callers always bail out in that case without inspecting `seg`, so the\n415\t/// zero-initialisation used here is unobservable.\n416\tunsafe fn c2Clip(seg: *mut c2v, h: c2h) -> c_int {\n417\t    let mut out = [ZERO_V; 4];\n418\t    let mut sp: usize = 0;\n419\t    let d0: f32;\n420\t    let d1: f32;\n421\t    d0 = c2Dist(h, *seg.offset(0));\n422\t    if d0 < 0.0 {\n423\t        out[sp] = *seg.offset(0);\n424\t        sp += 1;\n425\t    }\n426\t    d1 = c2Dist(h, *seg.offset(1));\n427\t    if d1 < 0.0 {\n428\t        out[sp] = *seg.offset(1);\n429\t        sp += 1;\n430\t    }\n431\t    if d0 == 0.0 && d1 == 0.0 {\n432\t        out[sp] = *seg.offset(0);\n433\t        sp += 1;\n434\t        out[sp] = *seg.offset(1);\n435\t        sp += 1;\n436\t    } else if d0 * d1 <= 0.0 {\n437\t        out[sp] = c2Intersect(*seg.offset(0), *seg.offset(1), d0, d1);\n438\t        sp += 1;\n439\t    }\n440\t    *seg.offset(0) = out[0];\n441\t    *seg.offset(1) = out[1];\n442\t    sp as c_int\n443\t}\n444\t\n445\t#[unsafe(no_mangle)]\n446\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n447\t    c2Mulvs(a, 1.0f32 / b)\n448\t}\n449\t\n450\t#[unsafe(no_mangle)]\n451\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n452\t    c2Div(a, c2Len(a))\n453\t}\n454\t\n455\t#[unsafe(no_mangle)]\n456\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n457\t    c2V(fneg(a.x), fneg(a.y))\n458\t}\n459\t\n460\t#[unsafe(no_mangle)]\n461\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n462\t    let mut b: c2v = ZERO_V;\n463\t    b.x = a.y;\n464\t    b.y = fneg(a.x);\n465\t    b\n466\t}\n467\t\n468\t/// `static int c2SidePlanes(c2v *seg, c2v ra, c2v rb, c2h *h)` — not exported.\n469\tunsafe fn c2SidePlanes(seg: *mut c2v, ra: c2v, rb: c2v, h: *mut c2h) -> c_int {\n470\t    let in_ = c2Norm(c2Sub(rb, ra));\n471\t    let left = c2h {\n472\t        n: c2Neg(in_),\n473\t        d: c2Dot(c2Neg(in_), ra),\n474\t    };\n475\t    let right = c2h {\n476\t        n: in_,\n477\t        d: c2Dot(in_, rb),\n478\t    };\n479\t    if c2Clip(seg, left) < 2 {\n480\t        return 0;\n481\t    }\n482\t    if c2Clip(seg, right) < 2 {\n483\t        return 0;\n484\t    }\n485\t    if !h.is_null() {\n486\t        (*h).n = c2CCW90(in_);\n487\t        (*h).d = c2Dot(c2CCW90(in_), ra);\n488\t    }\n489\t    1\n490\t}\n491\t\n492\t/// `static int c2SidePlanesFromPoly(...)` — not exported.\n493\tunsafe fn c2SidePlanesFromPoly(\n494\t    seg: *mut c2v,\n495\t    x: c2x,\n496\t    p: *const c2Poly,\n497\t    e: c_int,\n498\t    h: *mut c2h,\n499\t) -> c_int {\n500\t    let verts = (*p).verts.as_ptr();\n501\t    let ra = c2Mulxv(x, *verts.offset(e as isize));\n502\t    let next = if e + 1 == (*p).count { 0 } else { e + 1 };\n503\t    let rb = c2Mulxv(x, *verts.offset(next as isize));\n504\t    c2SidePlanes(seg, ra, rb, h)\n505\t}\n506\t\n507\t// ---------------------------------------------------------------------------\n508\t// GJK\n509\t// ---------------------------------------------------------------------------\n510\t\n511\t#[unsafe(no_mangle)]\n512\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n513\t    let a = (*s).a.p;\n514\t    let b = (*s).b.p;\n515\t    let u = c2Dot(b, c2Sub(b, a));\n516\t    let v = c2Dot(a, c2Sub(a, b));\n517\t    if v <= 0.0 {\n518\t        (*s).a.u = 1.0f32;\n519\t        (*s).div = 1.0f32;\n520\t        (*s).count = 1;\n521\t    } else if u <= 0.0 {\n522\t        (*s).a = (*s).b;\n523\t        (*s).a.u = 1.0f32;\n524\t        (*s).div = 1.0f32;\n525\t        (*s).count = 1;\n526\t    } else {\n527\t        (*s).a.u = u;\n528\t        (*s).b.u = v;\n529\t        (*s).div = x86_add(u, v); // gcc: addss dst=u,src=v\n530\t        (*s).count = 2;\n531\t    }\n532\t}\n533\t\n534\t#[unsafe(no_mangle)]\n535\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n536\t    let a = (*s).a.p;\n537\t    let b = (*s).b.p;\n538\t    let c = (*s).c.p;\n539\t    let uAB = c2Dot(b, c2Sub(b, a));\n540\t    let vAB = c2Dot(a, c2Sub(a, b));\n541\t    let uBC = c2Dot(c, c2Sub(c, b));\n542\t    let vBC = c2Dot(b, c2Sub(b, c));\n543\t    let uCA = c2Dot(a, c2Sub(a, c));\n544\t    let vCA = c2Dot(c, c2Sub(c, a));\n545\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n546\t    // gcc: mulss dst=<c2Det2 result>, src=area\n547\t    let uABC = x86_mul(c2Det2(b, c), area);\n548\t    let vABC = x86_mul(c2Det2(c, a), area);\n549\t    let wABC = x86_mul(c2Det2(a, b), area);\n550\t    if vAB <= 0.0 && uCA <= 0.0 {\n551\t        (*s).a.u = 1.0f32;\n552\t        (*s).div = 1.0f32;\n553\t        (*s).count = 1;\n554\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n555\t        (*s).a = (*s).b;\n556\t        (*s).a.u = 1.0f32;\n557\t        (*s).div = 1.0f32;\n558\t        (*s).count = 1;\n559\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n560\t        (*s).a = (*s).c;\n561\t        (*s).a.u = 1.0f32;\n562\t        (*s).div = 1.0f32;\n563\t        (*s).count = 1;\n564\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n565\t        (*s).a.u = uAB;\n566\t        (*s).b.u = vAB;\n567\t        (*s).div = x86_add(uAB, vAB);\n568\t        (*s).count = 2;\n569\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n570\t        (*s).a = (*s).b;\n571\t        (*s).b = (*s).c;\n572\t        (*s).a.u = uBC;\n573\t        (*s).b.u = vBC;\n574\t        (*s).div = x86_add(uBC, vBC);\n575\t        (*s).count = 2;\n576\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n577\t        (*s).b = (*s).a;\n578\t        (*s).a = (*s).c;\n579\t        (*s).a.u = uCA;\n580\t        (*s).b.u = vCA;\n581\t        (*s).div = x86_add(uCA, vCA);\n582\t        (*s).count = 2;\n583\t    } else {\n584\t        (*s).a.u = uABC;\n585\t        (*s).b.u = vABC;\n586\t        (*s).c.u = wABC;\n587\t        (*s).div = x86_add(x86_add(uABC, vABC), wABC);\n588\t        (*s).count = 3;\n589\t    }\n590\t}\n591\t\n592\t#[unsafe(no_mangle)]\n593\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n594\t    let mut b: c2v = ZERO_V;\n595\t    b.x = fneg(a.y);\n596\t    b.y = a.x;\n597\t    b\n598\t}\n599\t\n600\t#[unsafe(no_mangle)]\n601\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n602\t    match (*s).count {\n603\t        1 => c2Neg((*s).a.p),\n604\t        2 => {\n605\t            let ab = c2Sub((*s).b.p, (*s).a.p);\n606\t            if c2Det2(ab, c2Neg((*s).a.p)) > 0.0 {\n607\t                return c2Skew(ab);\n608\t            }\n609\t            c2CCW90(ab)\n610\t        }\n611\t        // `case 3:` and `default:`\n612\t        _ => c2V(0.0, 0.0),\n613\t    }\n614\t}\n615\t\n616\t#[unsafe(no_mangle)]\n617\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n618\t    let mut imax: c_int = 0;\n619\t    let mut dmax = c2Dot(*verts.offset(0), d);\n620\t    let mut i: c_int = 1;\n621\t    while i < count {\n622\t        let dot = c2Dot(*verts.offset(i as isize), d);\n623\t        if dot > dmax {\n624\t            imax = i;\n625\t            dmax = dot;\n626\t        }\n627\t        i += 1;\n628\t    }\n629\t    imax\n630\t}\n631\t\n632\t#[unsafe(no_mangle)]\n633\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n634\t    let den = 1.0f32 / (*s).div;\n635\t    match (*s).count {\n636\t        1 => {\n637\t            *a = (*s).a.sA;\n638\t            *b = (*s).a.sB;\n639\t        }\n640\t        2 => {\n641\t            *a = c2Add(\n642\t                c2Mulvs((*s).a.sA, x86_mul((*s).a.u, den)),\n643\t                c2Mulvs((*s).b.sA, x86_mul((*s).b.u, den)),\n644\t            );\n645\t            *b = c2Add(\n646\t                c2Mulvs((*s).a.sB, x86_mul((*s).a.u, den)),\n647\t                c2Mulvs((*s).b.sB, x86_mul((*s).b.u, den)),\n648\t            );\n649\t        }\n650\t        3 => {\n651\t            *a = c2Add(\n652\t                c2Add(\n653\t                    c2Mulvs((*s).a.sA, x86_mul((*s).a.u, den)),\n654\t                    c2Mulvs((*s).b.sA, x86_mul((*s).b.u, den)),\n655\t                ),\n656\t                c2Mulvs((*s).c.sA, x86_mul((*s).c.u, den)),\n657\t            );\n658\t            *b = c2Add(\n659\t                c2Add(\n660\t                    c2Mulvs((*s).a.sB, x86_mul((*s).a.u, den)),\n661\t                    c2Mulvs((*s).b.sB, x86_mul((*s).b.u, den)),\n662\t                ),\n663\t                c2Mulvs((*s).c.sB, x86_mul((*s).c.u, den)),\n664\t            );\n665\t        }\n666\t        _ => {\n667\t            *a = c2V(0.0, 0.0);\n668\t            *b = c2V(0.0, 0.0);\n669\t        }\n670\t    }\n671\t}\n672\t\n673\t#[unsafe(no_mangle)]\n674\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n675\t    let den = 1.0f32 / (*s).div;\n676\t    match (*s).count {\n677\t        1 => (*s).a.p,\n678\t        2 => c2Add(\n679\t            c2Mulvs((*s).a.p, x86_mul((*s).a.u, den)),\n680\t            c2Mulvs((*s).b.p, x86_mul((*s).b.u, den)),\n681\t        ),\n682\t        _ => c2V(0.0, 0.0),\n683\t    }\n684\t}\n685\t\n686\t#[unsafe(no_mangle)]\n687\tpub unsafe extern \"C\" fn c2GJK(\n688\t    A: *const c_void,\n689\t    typeA: c_int,\n690\t    ax_ptr: *const c2x,\n691\t    B: *const c_void,\n692\t    typeB: c_int,\n693\t    bx_ptr: *const c2x,\n694\t    outA: *mut c2v,\n695\t    outB: *mut c2v,\n696\t    use_radius: c_int,\n697\t    iterations: *mut c_int,\n698\t    cache: *mut c2GJKCache,\n699\t) -> f32 {\n700\t    let ax: c2x;\n701\t    let bx: c2x;\n702\t    if ax_ptr.is_null() {\n703\t        ax = c2xIdentity();\n704\t    } else {\n705\t        ax = *ax_ptr;\n706\t    }\n707\t    if bx_ptr.is_null() {\n708\t        bx = c2xIdentity();\n709\t    } else {\n710\t        bx = *bx_ptr;\n711\t    }\n712\t    // In C these two proxies are uninitialised locals; `c2MakeProxy` has no\n713\t    // `C2_TYPE_POLY` case, so for a poly the proxy keeps whatever the stack held\n714\t    // (radius 0 / count 0 / verts {0,0} on a freshly used stack).\n715\t    let mut pA: c2Proxy = std::mem::zeroed();\n716\t    let mut pB: c2Proxy = std::mem::zeroed();\n717\t    c2MakeProxy(A, typeA, &mut pA);\n718\t    c2MakeProxy(B, typeB, &mut pB);\n719\t    let mut s: c2Simplex = std::mem::zeroed();\n720\t    // `c2sv* verts = &s.a;` — indexes a, b, c, d contiguously.\n721\t    let verts: *mut c2sv = &mut s as *mut c2Simplex as *mut c2sv;\n722\t    let mut cache_was_read: c_int = 0;\n723\t    if !cache.is_null() {\n724\t        let cache_was_good: c_int = ((*cache).count != 0) as c_int;\n725\t        if cache_was_good != 0 {\n726\t            let mut i: c_int = 0;\n727\t            while i < (*cache).count {\n728\t                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n729\t                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n730\t                let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n731\t                let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n732\t                let v: *mut c2sv = verts.offset(i as isize);\n733\t                (*v).iA = iA;\n734\t                (*v).sA = sA;\n735\t                (*v).iB = iB;\n736\t                (*v).sB = sB;\n737\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n738\t                (*v).u = 0.0;\n739\t                i += 1;\n740\t            }\n741\t            s.count = (*cache).count;\n742\t            s.div = (*cache).div;\n743\t            let metric_old = (*cache).metric;\n744\t            let metric = c2GJKSimplexMetric(&mut s);\n745\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n746\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n747\t            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {"}]},"parent_tool_use_id":null,"session_id":"1ea9a5fb-ed63-409e-b5a3-01727940d457","uuid":"fa324587-ec92-4730-913e-49afb0c20e5b","timestamp":"2026-09-05T09:02:21.245Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-7PcXTT/translation/src/lib.rs","content":"// ---------------------------------------------------------------------------\n// src/lib.c internal types\n// ---------------------------------------------------------------------------\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2h {\n    pub n: c2v,\n    pub d: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Poly {\n    pub count: c_int,\n    pub verts: [c2v; 8],\n    pub norms: [c2v; 8],\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2GJKCache {\n    pub metric: f32,\n    pub count: c_int,\n    pub iA: [c_int; 3],\n    pub iB: [c_int; 3],\n    pub div: f32,\n}\n\n/// `typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;`\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Proxy {\n    pub radius: f32,\n    pub count: c_int,\n    pub verts: [c2v; 8],\n}\n\n/// `typedef struct { c2v sA; c2v sB; c2v p; float u; int iA; int iB; } c2sv;`\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2sv {\n    pub sA: c2v,\n    pub sB: c2v,\n    pub p: c2v,\n    pub u: f32,\n    pub iA: c_int,\n    pub iB: c_int,\n}\n\n/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n///\n/// The C code relies on `a`, `b`, `c`, `d` being contiguous (`c2sv* verts = &s.a`),\n/// which this `#[repr(C)]` layout reproduces.\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Simplex {\n    pub a: c2sv,\n    pub b: c2sv,\n    pub c: c2sv,\n    pub d: c2sv,\n    pub div: f32,\n    pub count: c_int,\n}\n\nconst ZERO_V: c2v = c2v { x: 0.0, y: 0.0 };\n\n/// C's unary `-` on a float is an IEEE-754 sign-bit flip (gcc emits `xorps`),\n/// which is also applied to NaN payloads.  Expressed as an explicit bit flip so\n/// that LLVM cannot rewrite `(-a) * b` into `-(a * b)`, a transform that would\n/// change the sign bit of a resulting NaN.\n#[inline(always)]\nfn fneg(x: f32) -> f32 {\n    // `black_box` is the barrier: without it LLVM recognises the sign flip and\n    // sinks it into the neighbouring arithmetic (e.g. `(-a) * b + c` becomes\n    // `c - a * b`), which changes the sign bit of a NaN result.\n    std::hint::black_box(f32::from_bits(x.to_bits() ^ 0x8000_0000))\n}\n\n/// x86 SSE scalar ops select which NaN propagates by *operand position*:\n/// `op dst, src` yields `dst` when `dst` is NaN, else `src` when `src` is NaN.\n/// gcc's register allocation therefore fixes which NaN a mixed-NaN expression\n/// returns; these helpers let the translation name that choice explicitly.\n/// For non-NaN operands they are exactly the plain IEEE-754 operation.\n#[inline(always)]\nfn x86_mul(dst: f32, src: f32) -> f32 {\n    let r = if dst.is_nan() {\n        dst\n    } else if src.is_nan() {\n        src\n    } else {\n        dst * src\n    };\n    std::hint::black_box(r)\n}\n\n#[inline(always)]\nfn x86_add(dst: f32, src: f32) -> f32 {\n    let r = if dst.is_nan() {\n        dst\n    } else if src.is_nan() {\n        src\n    } else {\n        dst + src\n    };\n    std::hint::black_box(r)\n}\n\n#[inline(always)]\nfn x86_sub(dst: f32, src: f32) -> f32 {\n    let r = if dst.is_nan() {\n        dst\n    } else if src.is_nan() {\n        src\n    } else {\n        dst - src\n    };\n    std::hint::black_box(r)\n}\n\nextern \"C\" {\n    fn malloc(size: usize) -> *mut c_void;\n}\n\n// ---------------------------------------------------------------------------\n// Vector helpers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a: c2v = ZERO_V;\n    a.x = x;\n    a.y = y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n    // gcc: mulss dst=a.x,src=b ; mulss dst=a.y,src=b\n    let mut a = a;\n    a.x = x86_mul(a.x, b);\n    a.y = x86_mul(a.y, b);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n    // gcc: subss dst=a.x,src=b.x ; subss dst=a.y,src=b.y\n    let mut a = a;\n    a.x = x86_sub(a.x, b.x);\n    a.y = x86_sub(a.y, b.y);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    // gcc: mulss dst=a.x,src=b.x ; mulss dst=b.y,src=a.y ; addss dst=p2,src=p1\n    let p1 = x86_mul(a.x, b.x);\n    let p2 = x86_mul(b.y, a.y);\n    x86_add(p2, p1)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dist(h: c2h, p: c2v) -> f32 {\n    c2Dot(h.n, p) - h.d\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2PlaneAt(p: *const c2Poly, i: c_int) -> c2h {\n    let mut h = c2h { n: ZERO_V, d: 0.0 };\n    let norms = (*p).norms.as_ptr();\n    let verts = (*p).verts.as_ptr();\n    h.n = *norms.offset(i as isize);\n    h.d = c2Dot(*norms.offset(i as isize), *verts.offset(i as isize));\n    h\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    let mut r = c2r { c: 0.0, s: 0.0 };\n    r.c = 1.0f32;\n    r.s = 0.0;\n    r\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    let mut x = c2x {\n        p: ZERO_V,\n        r: c2r { c: 0.0, s: 0.0 },\n    };\n    x.p = c2V(0.0, 0.0);\n    x.r = c2RotIdentity();\n    x\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    *out.offset(0) = (*bb).min;\n    *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n    *out.offset(2) = (*bb).max;\n    *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n}\n\n/// NOTE: the C source has **no** `C2_TYPE_POLY` case, so a poly proxy is left\n/// completely untouched (uninitialised in C).  Reproduced faithfully: nothing is\n/// written for any other type value.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n    match type_ {\n        C2_TYPE_CIRCLE => {\n            let c = shape as *const c2Circle;\n            (*p).radius = (*c).r;\n            (*p).count = 1;\n            (*p).verts[0] = (*c).p;\n        }\n        C2_TYPE_AABB => {\n            let bb = shape as *mut c2AABB;\n            (*p).radius = 0.0;\n            (*p).count = 4;\n            let verts = (*p).verts.as_mut_ptr();\n            c2BBVerts(verts, bb);\n        }\n        C2_TYPE_CAPSULE => {\n            let c = shape as *const c2Capsule;\n            (*p).radius = (*c).r;\n            (*p).count = 2;\n            (*p).verts[0] = (*c).a;\n            (*p).verts[1] = (*c).b;\n        }\n        _ => {}\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    c2Dot(a, a).sqrt()\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    // gcc: mulss dst=b.y,src=a.x ; mulss dst=b.x,src=a.y ; subss dst=p1,src=p2\n    let p1 = x86_mul(b.y, a.x);\n    let p2 = x86_mul(b.x, a.y);\n    x86_sub(p1, p2)\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    match (*s).count {\n        2 => c2Len(c2Sub((*s).b.p, (*s).a.p)),\n        3 => c2Det2(c2Sub((*s).b.p, (*s).a.p), c2Sub((*s).c.p, (*s).a.p)),\n        // `default:` and `case 1:` fall together in the C switch.\n        _ => 0.0,\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    // gcc -O0 emits, for `a.c * b.x - a.s * b.y`:\n    //   mulss dst=b.x,src=a.c ; mulss dst=b.y,src=a.s ; subss dst=p1,src=p2\n    // and for `a.s * b.x + a.c * b.y`:\n    //   mulss dst=a.s,src=b.x ; mulss dst=b.y,src=a.c ; addss dst=p1,src=p2\n    c2V(\n        x86_sub(x86_mul(b.x, a.c), x86_mul(b.y, a.s)),\n        x86_add(x86_mul(a.s, b.x), x86_mul(b.y, a.c)),\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    // gcc -O0 emits, for `a.c * b.x + a.s * b.y`:\n    //   mulss dst=a.c,src=b.x ; mulss dst=b.y,src=a.s ; addss dst=p1,src=p2\n    // and for `-a.s * b.x + a.c * b.y`:\n    //   xorps (negate) ; mulss dst=-a.s,src=b.x ; mulss dst=b.y,src=a.c ;\n    //   addss dst=p1,src=p2\n    c2V(\n        x86_add(x86_mul(a.c, b.x), x86_mul(b.y, a.s)),\n        x86_add(x86_mul(fneg(a.s), b.x), x86_mul(b.y, a.c)),\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n    // gcc: addss dst=b.x,src=a.x ; addss dst=b.y,src=a.y\n    let mut a = a;\n    a.x = x86_add(b.x, a.x);\n    a.y = x86_add(b.y, a.y);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulxvT(a: c2x, b: c2v) -> c2v {\n    c2MulrvT(a.r, c2Sub(b, a.p))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Intersect(a: c2v, b: c2v, da: f32, db: f32) -> c2v {\n    c2Add(a, c2Mulvs(c2Sub(b, a), da / (da - db)))\n}\n\n/// `static int c2Clip(c2v *seg, c2h h)` — not exported.\n///\n/// The C version leaves `out[]` (partly) uninitialised when it returns < 2; the\n/// two callers always bail out in that case without inspecting `seg`, so the\n/// zero-initialisation used here is unobservable.\nunsafe fn c2Clip(seg: *mut c2v, h: c2h) -> c_int {\n    let mut out = [ZERO_V; 4];\n    let mut sp: usize = 0;\n    let d0: f32;\n    let d1: f32;\n    d0 = c2Dist(h, *seg.offset(0));\n    if d0 < 0.0 {\n        out[sp] = *seg.offset(0);\n        sp += 1;\n    }\n    d1 = c2Dist(h, *seg.offset(1));\n    if d1 < 0.0 {\n        out[sp] = *seg.offset(1);\n        sp += 1;\n    }\n    if d0 == 0.0 && d1 == 0.0 {\n        out[sp] = *seg.offset(0);\n        sp += 1;\n        out[sp] = *seg.offset(1);\n        sp += 1;\n    } else if d0 * d1 <= 0.0 {\n        out[sp] = c2Intersect(*seg.offset(0), *seg.offset(1), d0, d1);\n        sp += 1;\n    }\n    *seg.offset(0) = out[0];\n    *seg.offset(1) = out[1];\n    sp as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    c2V(fneg(a.x), fneg(a.y))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    let mut b: c2v = ZERO_V;\n    b.x = a.y;\n    b.y = fneg(a.x);\n    b\n}\n\n/// `static int c2SidePlanes(c2v *seg, c2v ra, c2v rb, c2h *h)` — not exported.\nunsafe fn c2SidePlanes(seg: *mut c2v, ra: c2v, rb: c2v, h: *mut c2h) -> c_int {\n    let in_ = c2Norm(c2Sub(rb, ra));\n    let left = c2h {\n        n: c2Neg(in_),\n        d: c2Dot(c2Neg(in_), ra),\n    };\n    let right = c2h {\n        n: in_,\n        d: c2Dot(in_, rb),\n    };\n    if c2Clip(seg, left) < 2 {\n        return 0;\n    }\n    if c2Clip(seg, right) < 2 {\n        return 0;\n    }\n    if !h.is_null() {\n        (*h).n = c2CCW90(in_);\n        (*h).d = c2Dot(c2CCW90(in_), ra);\n    }\n    1\n}\n\n/// `static int c2SidePlanesFromPoly(...)` — not exported.\nunsafe fn c2SidePlanesFromPoly(\n    seg: *mut c2v,\n    x: c2x,\n    p: *const c2Poly,\n    e: c_int,\n    h: *mut c2h,\n) -> c_int {\n    let verts = (*p).verts.as_ptr();\n    let ra = c2Mulxv(x, *verts.offset(e as isize));\n    let next = if e + 1 == (*p).count { 0 } else { e + 1 };\n    let rb = c2Mulxv(x, *verts.offset(next as isize));\n    c2SidePlanes(seg, ra, rb, h)\n}\n\n// ---------------------------------------------------------------------------\n// GJK\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    let a = (*s).a.p;\n    let b = (*s).b.p;\n    let u = c2Dot(b, c2Sub(b, a));\n    let v = c2Dot(a, c2Sub(a, b));\n    if v <= 0.0 {\n        (*s).a.u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if u <= 0.0 {\n        (*s).a = (*s).b;\n        (*s).a.u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else {\n        (*s).a.u = u;\n        (*s).b.u = v;\n        (*s).div = x86_add(u, v); // gcc: addss dst=u,src=v\n        (*s).count = 2;\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n    let a = (*s).a.p;\n    let b = (*s).b.p;\n    let c = (*s).c.p;\n    let uAB = c2Dot(b, c2Sub(b, a));\n    let vAB = c2Dot(a, c2Sub(a, b));\n    let uBC = c2Dot(c, c2Sub(c, b));\n    let vBC = c2Dot(b, c2Sub(b, c));\n    let uCA = c2Dot(a, c2Sub(a, c));\n    let vCA = c2Dot(c, c2Sub(c, a));\n    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n    // gcc: mulss dst=<c2Det2 result>, src=area\n    let uABC = x86_mul(c2Det2(b, c), area);\n    let vABC = x86_mul(c2Det2(c, a), area);\n    let wABC = x86_mul(c2Det2(a, b), area);\n    if vAB <= 0.0 && uCA <= 0.0 {\n        (*s).a.u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uAB <= 0.0 && vBC <= 0.0 {\n        (*s).a = (*s).b;\n        (*s).a.u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uBC <= 0.0 && vCA <= 0.0 {\n        (*s).a = (*s).c;\n        (*s).a.u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n        (*s).a.u = uAB;\n        (*s).b.u = vAB;\n        (*s).div = x86_add(uAB, vAB);\n        (*s).count = 2;\n    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n        (*s).a = (*s).b;\n        (*s).b = (*s).c;\n        (*s).a.u = uBC;\n        (*s).b.u = vBC;\n        (*s).div = x86_add(uBC, vBC);\n        (*s).count = 2;\n    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n        (*s).b = (*s).a;\n        (*s).a = (*s).c;\n        (*s).a.u = uCA;\n        (*s).b.u = vCA;\n        (*s).div = x86_add(uCA, vCA);\n        (*s).count = 2;\n    } else {\n        (*s).a.u = uABC;\n        (*s).b.u = vABC;\n        (*s).c.u = wABC;\n        (*s).div = x86_add(x86_add(uABC, vABC), wABC);\n        (*s).count = 3;\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    let mut b: c2v = ZERO_V;\n    b.x = fneg(a.y);\n    b.y = a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    match (*s).count {\n        1 => c2Neg((*s).a.p),\n        2 => {\n            let ab = c2Sub((*s).b.p, (*s).a.p);\n            if c2Det2(ab, c2Neg((*s).a.p)) > 0.0 {\n                return c2Skew(ab);\n            }\n            c2CCW90(ab)\n        }\n        // `case 3:` and `default:`\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    let mut imax: c_int = 0;\n    let mut dmax = c2Dot(*verts.offset(0), d);\n    let mut i: c_int = 1;\n    while i < count {\n        let dot = c2Dot(*verts.offset(i as isize), d);\n        if dot > dmax {\n            imax = i;\n            dmax = dot;\n        }\n        i += 1;\n    }\n    imax\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n    let den = 1.0f32 / (*s).div;\n    match (*s).count {\n        1 => {\n            *a = (*s).a.sA;\n            *b = (*s).a.sB;\n        }\n        2 => {\n            *a = c2Add(\n                c2Mulvs((*s).a.sA, x86_mul((*s).a.u, den)),\n                c2Mulvs((*s).b.sA, x86_mul((*s).b.u, den)),\n            );\n            *b = c2Add(\n                c2Mulvs((*s).a.sB, x86_mul((*s).a.u, den)),\n                c2Mulvs((*s).b.sB, x86_mul((*s).b.u, den)),\n            );\n        }\n        3 => {\n            *a = c2Add(\n                c2Add(\n                    c2Mulvs((*s).a.sA, x86_mul((*s).a.u, den)),\n                    c2Mulvs((*s).b.sA, x86_mul((*s).b.u, den)),\n                ),\n                c2Mulvs((*s).c.sA, x86_mul((*s).c.u, den)),\n            );\n            *b = c2Add(\n                c2Add(\n                    c2Mulvs((*s).a.sB, x86_mul((*s).a.u, den)),\n                    c2Mulvs((*s).b.sB, x86_mul((*s).b.u, den)),\n                ),\n                c2Mulvs((*s).c.sB, x86_mul((*s).c.u, den)),\n            );\n        }\n        _ => {\n            *a = c2V(0.0, 0.0);\n            *b = c2V(0.0, 0.0);\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n    let den = 1.0f32 / (*s).div;\n    match (*s).count {\n        1 => (*s).a.p,\n        2 => c2Add(\n            c2Mulvs((*s).a.p, x86_mul((*s).a.u, den)),\n            c2Mulvs((*s).b.p, x86_mul((*s).b.u, den)),\n        ),\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJK(\n    A: *const c_void,\n    typeA: c_int,\n    ax_ptr: *const c2x,\n    B: *const c_void,\n    typeB: c_int,\n    bx_ptr: *const c2x,\n    outA: *mut c2v,\n    outB: *mut c2v,\n    use_radius: c_int,\n    iterations: *mut c_int,\n    cache: *mut c2GJKCache,\n) -> f32 {\n    let ax: c2x;\n    let bx: c2x;\n    if ax_ptr.is_null() {\n        ax = c2xIdentity();\n    } else {\n        ax = *ax_ptr;\n    }\n    if bx_ptr.is_null() {\n        bx = c2xIdentity();\n    } else {\n        bx = *bx_ptr;\n    }\n    // In C these two proxies are uninitialised locals; `c2MakeProxy` has no\n    // `C2_TYPE_POLY` case, so for a poly the proxy keeps whatever the stack held\n    // (radius 0 / count 0 / verts {0,0} on a freshly used stack).\n    let mut pA: c2Proxy = std::mem::zeroed();\n    let mut pB: c2Proxy = std::mem::zeroed();\n    c2MakeProxy(A, typeA, &mut pA);\n    c2MakeProxy(B, typeB, &mut pB);\n    let mut s: c2Simplex = std::mem::zeroed();\n    // `c2sv* verts = &s.a;` — indexes a, b, c, d contiguously.\n    let verts: *mut c2sv