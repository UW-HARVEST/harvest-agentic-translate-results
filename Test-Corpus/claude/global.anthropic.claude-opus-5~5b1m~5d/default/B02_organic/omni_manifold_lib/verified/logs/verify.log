{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_s6ec5epufpvrtustcqmx55chd4butvl44mdfhylkb2s3qtk2fmmq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01MJJy7FS3MQsxagvA4GC27F","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-7PcXTT/translation/tests/scratch_probe.rs","content":"//! Scratch probe: reveals what the C build leaves in the uninitialised\n//! `c2Proxy` for `C2_TYPE_POLY` (`c2MakeProxy` has no POLY case).\n//! Run with `cargo test --release --offline --test scratch_probe -- --nocapture`.\n\n#![allow(non_snake_case)]\n\nmod common;\nuse common::*;\nuse std::os::raw::{c_int, c_void};\n\ntype GjkFn = unsafe extern \"C\" fn(\n    *const c_void,\n    c_int,\n    *const c2x,\n    *const c_void,\n    c_int,\n    *const c2x,\n    *mut c2v,\n    *mut c2v,\n    c_int,\n    *mut c_int,\n    *mut c2GJKCache,\n) -> f32;\n\n#[test]\nfn probe_poly_proxy() {\n    let p = pair();\n    let f_c = p.c.get::<GjkFn>(\"c2GJK\");\n    let f_r = p.r.get::<GjkFn>(\"c2GJK\");\n    let mut poly = c2Poly::default();\n    poly.count = 4;\n    poly.verts[0] = c2v { x: -1.0, y: -1.0 };\n    poly.verts[1] = c2v { x: 1.0, y: -1.0 };\n    poly.verts[2] = c2v { x: 1.0, y: 1.0 };\n    poly.verts[3] = c2v { x: -1.0, y: 1.0 };\n    let cap = c2Capsule { a: c2v { x: 5.0, y: 5.0 }, b: c2v { x: 6.0, y: 6.0 }, r: 0.5 };\n    for trial in 0..3 {\n        let mut oa = c2v::default();\n        let mut ob = c2v::default();\n        let mut it: c_int = 0;\n        let mut cache = c2GJKCache::default();\n        unsafe {\n            let d = f_c(\n                &cap as *const _ as *const c_void,\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &poly as *const _ as *const c_void,\n                C2_TYPE_POLY,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                0,\n                &mut it,\n                &mut cache,\n            );\n            println!(\n                \"C   trial{} d={} outA={} outB={} it={} cache={:?}\",\n                trial, fmt_f32(d), fmt_v(oa), fmt_v(ob), it, cache\n            );\n            let mut oa2 = c2v::default();\n            let mut ob2 = c2v::default();\n            let mut it2: c_int = 0;\n            let mut cache2 = c2GJKCache::default();\n            let d2 = f_r(\n                &cap as *const _ as *const c_void,\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &poly as *const _ as *const c_void,\n                C2_TYPE_POLY,\n                std::ptr::null(),\n                &mut oa2,\n                &mut ob2,\n                0,\n                &mut it2,\n                &mut cache2,\n            );\n            println!(\n                \"R   trial{} d={} outA={} outB={} it={} cache={:?}\",\n                trial, fmt_f32(d2), fmt_v(oa2), fmt_v(ob2), it2, cache2\n            );\n        }\n    }\n}\n\n#[test]\nfn probe_cap_poly_manifold() {\n    let p = pair();\n    type CapPoly = unsafe extern \"C\" fn(c2Capsule, *const c2Poly, *const c2x, *mut c2Manifold);\n    let f_c = p.c.get::<CapPoly>(\"c2CapsuletoPolyManifold\");\n    let f_r = p.r.get::<CapPoly>(\"c2CapsuletoPolyManifold\");\n    let norms = p.c.get::<unsafe extern \"C\" fn(*mut c2v, *mut c2v, c_int)>(\"c2Norms\");\n    let mut poly = c2Poly::default();\n    poly.count = 4;\n    poly.verts[0] = c2v { x: -1.0, y: -1.0 };\n    poly.verts[1] = c2v { x: 1.0, y: -1.0 };\n    poly.verts[2] = c2v { x: 1.0, y: 1.0 };\n    poly.verts[3] = c2v { x: -1.0, y: 1.0 };\n    unsafe { norms(poly.verts.as_mut_ptr(), poly.norms.as_mut_ptr(), 4) };\n    for (i, cap) in [\n        c2Capsule { a: c2v { x: 50.0, y: 50.0 }, b: c2v { x: 60.0, y: 50.0 }, r: 0.5 },\n        c2Capsule { a: c2v { x: 0.0, y: 0.0 }, b: c2v { x: 0.5, y: 0.5 }, r: 0.25 },\n        c2Capsule { a: c2v { x: 1.2, y: -1.0 }, b: c2v { x: 1.2, y: 1.0 }, r: 2.0 },\n    ]\n    .into_iter()\n    .enumerate()\n    {\n        let mut mc = c2Manifold { count: -13, depths: [7.5, -8.25], contact_points: [c2v { x: 11.0, y: 12.0 }, c2v { x: 13.0, y: 14.0 }], n: c2v { x: 0.25, y: -0.75 } };\n        let mut mr = mc;\n        unsafe {\n            f_c(cap, &poly, std::ptr::null(), &mut mc);\n            f_r(cap, &poly, std::ptr::null(), &mut mr);\n        }\n        println!(\"case{} C: {}\", i, fmt_man(&mc));\n        println!(\"case{} R: {}\", i, fmt_man(&mr));\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1130,"cache_read_input_tokens":125324,"cache_creation":{"ephemeral_5m_input_tokens":1130,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1ea9a5fb-ed63-409e-b5a3-01727940d457","uuid":"bdbcf6cb-7068-46b3-a2e8-c86bf5c47c1d","timestamp":"2026-09-05T09:12:55.864Z"}
