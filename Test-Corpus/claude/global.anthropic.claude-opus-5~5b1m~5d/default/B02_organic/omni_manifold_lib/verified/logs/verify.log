erive(Copy, Clone)]\n   105\tpub struct c2GJKCache {\n   106\t    pub metric: f32,\n   107\t    pub count: c_int,\n   108\t    pub iA: [c_int; 3],\n   109\t    pub iB: [c_int; 3],\n   110\t    pub div: f32,\n   111\t}\n   112\t\n   113\t/// `typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;`\n   114\t#[repr(C)]\n   115\t#[derive(Copy, Clone)]\n   116\tpub struct c2Proxy {\n   117\t    pub radius: f32,\n   118\t    pub count: c_int,\n   119\t    pub verts: [c2v; 8],\n   120\t}\n   121\t\n   122\t/// `typedef struct { c2v sA; c2v sB; c2v p; float u; int iA; int iB; } c2sv;`\n   123\t#[repr(C)]\n   124\t#[derive(Copy, Clone)]\n   125\tpub struct c2sv {\n   126\t    pub sA: c2v,\n   127\t    pub sB: c2v,\n   128\t    pub p: c2v,\n   129\t    pub u: f32,\n   130\t    pub iA: c_int,\n   131\t    pub iB: c_int,\n   132\t}\n   133\t\n   134\t/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n   135\t///\n   136\t/// The C code relies on `a`, `b`, `c`, `d` being contiguous (`c2sv* verts = &s.a`),\n   137\t/// which this `#[repr(C)]` layout reproduces.\n   138\t#[repr(C)]\n   139\t#[derive(Copy, Clone)]\n   140\tpub struct c2Simplex {\n   141\t    pub a: c2sv,\n   142\t    pub b: c2sv,\n   143\t    pub c: c2sv,\n   144\t    pub d: c2sv,\n   145\t    pub div: f32,\n   146\t    pub count: c_int,\n   147\t}\n   148\t\n   149\tconst ZERO_V: c2v = c2v { x: 0.0, y: 0.0 };\n   150\t\n   151\t/// C's unary `-` on a float is an IEEE-754 sign-bit flip (gcc emits `xorps`),\n   152\t/// which is also applied to NaN payloads.  Expressed as an explicit bit flip so\n   153\t/// that LLVM cannot rewrite `(-a) * b` into `-(a * b)`, a transform that would\n   154\t/// change the sign bit of a resulting NaN.\n   155\t#[inline(always)]\n   156\tfn fneg(x: f32) -> f32 {\n   157\t    // `black_box` is the barrier: without it LLVM recognises the sign flip and\n   158\t    // sinks it into the neighbouring arithmetic (e.g. `(-a) * b + c` becomes\n   159\t    // `c - a * b`), which changes the sign bit of a NaN result.\n   160\t    std::hint::black_box(f32::from_bits(x.to_bits() ^ 0x8000_0000))\n   161\t}\n   162\t\n   163\t/// x86 SSE scalar ops select which NaN propagates by *operand position*:\n   164\t/// `op dst, src` yields `dst` when `dst` is NaN, else `src` when `src` is NaN.\n   165\t/// gcc's register allocation therefore fixes which NaN a mixed-NaN expression\n   166\t/// returns; these helpers let the translation name that choice explicitly.\n   167\t/// For non-NaN operands they are exactly the plain IEEE-754 operation.\n   168\t#[inline(always)]\n   169\tfn x86_mul(dst: f32, src: f32) -> f32 {\n   170\t    let r = if dst.is_nan() {\n   171\t        dst\n   172\t    } else if src.is_nan() {\n   173\t        src\n   174\t    } else {\n   175\t        dst * src\n   176\t    };\n   177\t    std::hint::black_box(r)\n   178\t}\n   179\t\n   180\t#[inline(always)]\n   181\tfn x86_add(dst: f32, src: f32) -> f32 {\n   182\t    let r = if dst.is_nan() {\n   183\t        dst\n   184\t    } else if src.is_nan() {\n   185\t        src\n   186\t    } else {\n   187\t        dst + src\n   188\t    };\n   189\t    std::hint::black_box(r)\n   190\t}\n   191\t\n   192\t#[inline(always)]\n   193\tfn x86_sub(dst: f32, src: f32) -> f32 {\n   194\t    let r = if dst.is_nan() {\n   195\t        dst\n   196\t    } else if src.is_nan() {\n   197\t        src\n   198\t    } else {\n   199\t        dst - src\n   200\t    };\n   201\t    std::hint::black_box(r)\n   202\t}\n   203\t\n   204\textern \"C\" {\n   205\t    fn malloc(size: usize) -> *mut c_void;\n   206\t}\n   207\t\n   208\t// ---------------------------------------------------------------------------\n   209\t// Vector helpers\n   210\t// ---------------------------------------------------------------------------\n   211\t\n   212\t#[unsafe(no_mangle)]\n   213\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n   214\t    let mut a: c2v = ZERO_V;\n   215\t    a.x = x;\n   216\t    a.y = y;\n   217\t    a\n   218\t}\n   219\t\n   220\t#[unsafe(no_mangle)]\n   221\tpub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n   222\t    // gcc: mulss dst=a.x,src=b ; mulss dst=a.y,src=b\n   223\t    let mut a = a;\n   224\t    a.x = x86_mul(a.x, b);\n   225\t    a.y = x86_mul(a.y, b);\n   226\t    a\n   227\t}\n   228\t\n   229\t#[unsafe(no_mangle)]\n   230\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n   231\t    c2V(\n   232\t        if a.x > b.x { a.x } else { b.x },\n   233\t        if a.y > b.y { a.y } else { b.y },\n   234\t    )\n   235\t}\n   236\t\n   237\t#[unsafe(no_mangle)]\n   238\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n   239\t    c2V(\n   240\t        if a.x < b.x { a.x } else { b.x },\n   241\t        if a.y < b.y { a.y } else { b.y },\n   242\t    )\n   243\t}\n   244\t\n   245\t#[unsafe(no_mangle)]\n   246\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n   247\t    c2Maxv(lo, c2Minv(a, hi))\n   248\t}\n   249\t\n   250\t#[unsafe(no_mangle)]\n   251\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n   252\t    // gcc: subss dst=a.x,src=b.x ; subss dst=a.y,src=b.y\n   253\t    let mut a = a;\n   254\t    a.x = x86_sub(a.x, b.x);\n   255\t    a.y = x86_sub(a.y, b.y);\n   256\t    a\n   257\t}\n   258\t\n   259\t#[unsafe(no_mangle)]\n   260\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n   261\t    // gcc: mulss dst=a.x,src=b.x ; mulss dst=b.y,src=a.y ; addss dst=p2,src=p1\n   262\t    let p1 = x86_mul(a.x, b.x);\n   263\t    let p2 = x86_mul(b.y, a.y);\n   264\t    x86_add(p2, p1)\n   265\t}\n   266\t\n   267\t#[unsafe(no_mangle)]\n   268\tpub extern \"C\" fn c2Dist(h: c2h, p: c2v) -> f32 {\n   269\t    c2Dot(h.n, p) - h.d\n   270\t}\n   271\t\n   272\t#[unsafe(no_mangle)]\n   273\tpub unsafe extern \"C\" fn c2PlaneAt(p: *const c2Poly, i: c_int) -> c2h {\n   274\t    let mut h = c2h { n: ZERO_V, d: 0.0 };\n   275\t    let norms = (*p).norms.as_ptr();\n   276\t    let verts = (*p).verts.as_ptr();\n   277\t    h.n = *norms.offset(i as isize);\n   278\t    h.d = c2Dot(*norms.offset(i as isize), *verts.offset(i as isize));\n   279\t    h\n   280\t}\n   281\t\n   282\t#[unsafe(no_mangle)]\n   283\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n   284\t    let mut r = c2r { c: 0.0, s: 0.0 };\n   285\t    r.c = 1.0f32;\n   286\t    r.s = 0.0;\n   287\t    r\n   288\t}\n   289\t\n   290\t#[unsafe(no_mangle)]\n   291\tpub extern \"C\" fn c2xIdentity() -> c2x {\n   292\t    let mut x = c2x {\n   293\t        p: ZERO_V,\n   294\t        r: c2r { c: 0.0, s: 0.0 },\n   295\t    };\n   296\t    x.p = c2V(0.0, 0.0);\n   297\t    x.r = c2RotIdentity();\n   298\t    x\n   299\t}\n   300\t\n   301\t#[unsafe(no_mangle)]\n   302\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n   303\t    *out.offset(0) = (*bb).min;\n   304\t    *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n   305\t    *out.offset(2) = (*bb).max;\n   306\t    *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n   307\t}\n   308\t\n   309\t/// NOTE: the C source has **no** `C2_TYPE_POLY` case, so a poly proxy is left\n   310\t/// completely untouched (uninitialised in C).  Reproduced faithfully: nothing is\n   311\t/// written for any other type value.\n   312\t#[unsafe(no_mangle)]\n   313\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n   314\t    match type_ {\n   315\t        C2_TYPE_CIRCLE => {\n   316\t            let c = shape as *const c2Circle;\n   317\t            (*p).radius = (*c).r;\n   318\t            (*p).count = 1;\n   319\t            (*p).verts[0] = (*c).p;\n   320\t        }\n   321\t        C2_TYPE_AABB => {\n   322\t            let bb = shape as *mut c2AABB;\n   323\t            (*p).radius = 0.0;\n   324\t            (*p).count = 4;\n   325\t            let verts = (*p).verts.as_mut_ptr();\n   326\t            c2BBVerts(verts, bb);\n   327\t        }\n   328\t        C2_TYPE_CAPSULE => {\n   329\t            let c = shape as *const c2Capsule;\n   330\t            (*p).radius = (*c).r;\n   331\t            (*p).count = 2;\n   332\t            (*p).verts[0] = (*c).a;\n   333\t            (*p).verts[1] = (*c).b;\n   334\t        }\n   335\t        _ => {}\n   336\t    }\n   337\t}\n   338\t\n   339\t#[unsafe(no_mangle)]\n   340\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n   341\t    c2Dot(a, a).sqrt()\n   342\t}\n   343\t\n   344\t#[unsafe(no_mangle)]\n   345\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n   346\t    // gcc: mulss dst=b.y,src=a.x ; mulss dst=b.x,src=a.y ; subss dst=p1,src=p2\n   347\t    let p1 = x86_mul(b.y, a.x);\n   348\t    let p2 = x86_mul(b.x, a.y);\n   349\t    x86_sub(p1, p2)\n   350\t}\n   351\t\n   352\t#[unsafe(no_mangle)]\n   353\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n   354\t    match (*s).count {\n   355\t        2 => c2Len(c2Sub((*s).b.p, (*s).a.p)),\n   356\t        3 => c2Det2(c2Sub((*s).b.p, (*s).a.p), c2Sub((*s).c.p, (*s).a.p)),\n   357\t        // `default:` and `case 1:` fall together in the C switch.\n   358\t        _ => 0.0,\n   359\t    }\n   360\t}\n   361\t\n   362\t#[unsafe(no_mangle)]\n   363\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n   364\t    // gcc -O0 emits, for `a.c * b.x - a.s * b.y`:\n   365\t    //   mulss dst=b.x,src=a.c ; mulss dst=b.y,src=a.s ; subss dst=p1,src=p2\n   366\t    // and for `a.s * b.x + a.c * b.y`:\n   367\t    //   mulss dst=a.s,src=b.x ; mulss dst=b.y,src=a.c ; addss dst=p1,src=p2\n   368\t    c2V(\n   369\t        x86_sub(x86_mul(b.x, a.c), x86_mul(b.y, a.s)),\n   370\t        x86_add(x86_mul(a.s, b.x), x86_mul(b.y, a.c)),\n   371\t    )\n   372\t}\n   373\t\n   374\t#[unsafe(no_mangle)]\n   375\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n   376\t    // gcc -O0 emits, for `a.c * b.x + a.s * b.y`:\n   377\t    //   mulss dst=a.c,src=b.x ; mulss dst=b.y,src=a.s ; addss dst=p1,src=p2\n   378\t    // and for `-a.s * b.x + a.c * b.y`:\n   379\t    //   xorps (negate) ; mulss dst=-a.s,src=b.x ; mulss dst=b.y,src=a.c ;\n   380\t    //   addss dst=p1,src=p2\n   381\t    c2V(\n   382\t        x86_add(x86_mul(a.c, b.x), x86_mul(b.y, a.s)),\n   383\t        x86_add(x86_mul(fneg(a.s), b.x), x86_mul(b.y, a.c)),\n   384\t    )\n   385\t}\n   386\t\n   387\t#[unsafe(no_mangle)]\n   388\tpub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n   389\t    // gcc: addss dst=b.x,src=a.x ; addss dst=b.y,src=a.y\n   390\t    let mut a = a;\n   391\t    a.x = x86_add(b.x, a.x);\n   392\t    a.y = x86_add(b.y, a.y);\n   393\t    a\n   394\t}\n   395\t\n   396\t#[unsafe(no_mangle)]\n   397\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n   398\t    c2Add(c2Mulrv(a.r, b), a.p)\n   399\t}\n   400\t\n   401\t#[unsafe(no_mangle)]\n   402\tpub extern \"C\" fn c2MulxvT(a: c2x, b: c2v) -> c2v {\n   403\t    c2MulrvT(a.r, c2Sub(b, a.p))\n   404\t}\n   405\t\n   406\t#[unsafe(no_mangle)]\n   407\tpub extern \"C\" fn c2Intersect(a: c2v, b: c2v, da: f32, db: f32) -> c2v {\n   408\t    c2Add(a, c2Mulvs(c2Sub(b, a), da / (da - db)))\n   409\t}\n   410\t\n   411\t/// `static int c2Clip(c2v *seg, c2h h)` — not exported.\n   412\t///\n   413\t/// The C version leaves `out[]` (partly) uninitialised when it returns < 2; the\n   414\t/// two callers always bail out in that case without inspecting `seg`, so the\n   415\t/// zero-initialisation used here is unobservable.\n   416\tunsafe fn c2Clip(seg: *mut c2v, h: c2h) -> c_int {\n   417\t    let mut out = [ZERO_V; 4];\n   418\t    let mut sp: usize = 0;\n   419\t    let d0: f32;\n   420\t    let d1: f32;\n   421\t    d0 = c2Dist(h, *seg.offset(0));\n   422\t    if d0 < 0.0 {\n   423\t        out[sp] = *seg.offset(0);\n   424\t        sp += 1;\n   425\t    }\n   426\t    d1 = c2Dist(h, *seg.offset(1));\n   427\t    if d1 < 0.0 {\n   428\t        out[sp] = *seg.offset(1);\n   429\t        sp += 1;\n   430\t    }\n   431\t    if d0 == 0.0 && d1 == 0.0 {\n   432\t        out[sp] = *seg.offset(0);\n   433\t        sp += 1;\n   434\t        out[sp] = *seg.offset(1);\n   435\t        sp += 1;\n   436\t    } else if d0 * d1 <= 0.0 {\n   437\t        out[sp] = c2Intersect(*seg.offset(0), *seg.offset(1), d0, d1);\n   438\t        sp += 1;\n   439\t    }\n   440\t    *seg.offset(0) = out[0];\n   441\t    *seg.offset(1) = out[1];\n   442\t    sp as c_int\n   443\t}\n   444\t\n   445\t#[unsafe(no_mangle)]\n   446\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n   447\t    c2Mulvs(a, 1.0f32 / b)\n   448\t}\n   449\t\n   450\t#[unsafe(no_mangle)]\n   451\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n   452\t    c2Div(a, c2Len(a))\n   453\t}\n   454\t\n   455\t#[unsafe(no_mangle)]\n   456\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n   457\t    c2V(fneg(a.x), fneg(a.y))\n   458\t}\n   459\t\n   460\t#[unsafe(no_mangle)]\n   461\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n   462\t    let mut b: c2v = ZERO_V;\n   463\t    b.x = a.y;\n   464\t    b.y = fneg(a.x);\n   465\t    b\n   466\t}\n   467\t\n   468\t/// `static int c2SidePlanes(c2v *seg, c2v ra, c2v rb, c2h *h)` — not exported.\n   469\tunsafe fn c2SidePlanes(seg: *mut c2v, ra: c2v, rb: c2v, h: *mut c2h) -> c_int {\n   470\t    let in_ = c2Norm(c2Sub(rb, ra));\n   471\t    let left = c2h {\n   472\t        n: c2Neg(in_),\n   473\t        d: c2Dot(c2Neg(in_), ra),\n   474\t    };\n   475\t    let right = c2h {\n   476\t        n: in_,\n   477\t        d: c2Dot(in_, rb),\n   478\t    };\n   479\t    if c2Clip(seg, left) < 2 {\n   480\t        return 0;\n   481\t    }\n   482\t    if c2Clip(seg, right) < 2 {\n   483\t        return 0;\n   484\t    }\n   485\t    if !h.is_null() {\n   486\t        (*h).n = c2CCW90(in_);\n   487\t        (*h).d = c2Dot(c2CCW90(in_), ra);\n   488\t    }\n   489\t    1\n   490\t}\n   491\t\n   492\t/// `static int c2SidePlanesFromPoly(...)` — not exported.\n   493\tunsafe fn c2SidePlanesFromPoly(\n   494\t    seg: *mut c2v,\n   495\t    x: c2x,\n   496\t    p: *const c2Poly,\n   497\t    e: c_int,\n   498\t    h: *mut c2h,\n   499\t) -> c_int {\n   500\t    let verts = (*p).verts.as_ptr();\n   501\t    let ra = c2Mulxv(x, *verts.offset(e as isize));\n   502\t    let next = if e + 1 == (*p).count { 0 } else { e + 1 };\n   503\t    let rb = c2Mulxv(x, *verts.offset(next as isize));\n   504\t    c2SidePlanes(seg, ra, rb, h)\n   505\t}\n   506\t\n   507\t// ---------------------------------------------------------------------------\n   508\t// GJK\n   509\t// ---------------------------------------------------------------------------\n   510\t\n   511\t#[unsafe(no_mangle)]\n   512\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n   513\t    let a = (*s).a.p;\n   514\t    let b = (*s).b.p;\n   515\t    let u = c2Dot(b, c2Sub(b, a));\n   516\t    let v = c2Dot(a, c2Sub(a, b));\n   517\t    if v <= 0.0 {\n   518\t        (*s).a.u = 1.0f32;\n   519\t        (*s).div = 1.0f32;\n   520\t        (*s).count = 1;\n   521\t    } else if u <= 0.0 {\n   522\t        (*s).a = (*s).b;\n   523\t        (*s).a.u = 1.0f32;\n   524\t        (*s).div = 1.0f32;\n   525\t        (*s).count = 1;\n   526\t    } else {\n   527\t        (*s).a.u = u;\n   528\t        (*s).b.u = v;\n   529\t        (*s).div = x86_add(u, v); // gcc: addss dst=u,src=v\n   530\t        (*s).count = 2;\n   531\t    }\n   532\t}\n   533\t\n   534\t#[unsafe(no_mangle)]\n   535\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n   536\t    let a = (*s).a.p;\n   537\t    let b = (*s).b.p;\n   538\t    let c = (*s).c.p;\n   539\t    let uAB = c2Dot(b, c2Sub(b, a));\n   540\t    let vAB = c2Dot(a, c2Sub(a, b));\n   541\t    let uBC = c2Dot(c, c2Sub(c, b));\n   542\t    let vBC = c2Dot(b, c2Sub(b, c));\n   543\t    let uCA = c2Dot(a, c2Sub(a, c));\n   544\t    let vCA = c2Dot(c, c2Sub(c, a));\n   545\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n   546\t    // gcc: mulss dst=<c2Det2 result>, src=area\n   547\t    let uABC = x86_mul(c2Det2(b, c), area);\n   548\t    let vABC = x86_mul(c2Det2(c, a), area);\n   549\t    let wABC = x86_mul(c2Det2(a, b), area);\n   550\t    if vAB <= 0.0 && uCA <= 0.0 {\n   551\t        (*s).a.u = 1.0f32;\n   552\t        (*s).div = 1.0f32;\n   553\t        (*s).count = 1;\n   554\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n   555\t        (*s).a = (*s).b;\n   556\t        (*s).a.u = 1.0f32;\n   557\t        (*s).div = 1.0f32;\n   558\t        (*s).count = 1;\n   559\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n   560\t        (*s).a = (*s).c;\n   561\t        (*s).a.u = 1.0f32;\n   562\t        (*s).div = 1.0f32;\n   563\t        (*s).count = 1;\n   564\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n   565\t        (*s).a.u = uAB;\n   566\t        (*s).b.u = vAB;\n   567\t        (*s).div = x86_add(uAB, vAB);\n   568\t        (*s).count = 2;\n   569\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n   570\t        (*s).a = (*s).b;\n   571\t        (*s).b = (*s).c;\n   572\t        (*s).a.u = uBC;\n   573\t        (*s).b.u = vBC;\n   574\t        (*s).div = x86_add(uBC, vBC);\n   575\t        (*s).count = 2;\n   576\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n   577\t        (*s).b = (*s).a;\n   578\t        (*s).a = (*s).c;\n   579\t        (*s).a.u = uCA;\n   580\t        (*s).b.u = vCA;\n   581\t        (*s).div = x86_add(uCA, vCA);\n   582\t        (*s).count = 2;\n   583\t    } else {\n   584\t        (*s).a.u = uABC;\n   585\t        (*s).b.u = vABC;\n   586\t        (*s).c.u = wABC;\n   587\t        (*s).div = x86_add(x86_add(uABC, vABC), wABC);\n   588\t        (*s).count = 3;\n   589\t    }\n   590\t}\n   591\t\n   592\t#[unsafe(no_mangle)]\n   593\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n   594\t    let mut b: c2v = ZERO_V;\n   595\t    b.x = fneg(a.y);\n   596\t    b.y = a.x;\n   597\t    b\n   598\t}\n   599\t\n   600\t#[unsafe(no_mangle)]\n   601\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n   602\t    match (*s).count {\n   603\t        1 => c2Neg((*s).a.p),\n   604\t        2 => {\n   605\t            let ab = c2Sub((*s).b.p, (*s).a.p);\n   606\t            if c2Det2(ab, c2Neg((*s).a.p)) > 0.0 {\n   607\t                return c2Skew(ab);\n   608\t            }\n   609\t            c2CCW90(ab)\n   610\t        }\n   611\t        // `case 3:` and `default:`\n   612\t        _ => c2V(0.0, 0.0),\n   613\t    }\n   614\t}\n   615\t\n   616\t#[unsafe(no_mangle)]\n   617\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n   618\t    let mut imax: c_int = 0;\n   619\t    let mut dmax = c2Dot(*verts.offset(0), d);\n   620\t    let mut i: c_int = 1;\n   621\t    while i < count {\n   622\t        let dot = c2Dot(*verts.offset(i as isize), d);\n   623\t        if dot > dmax {\n   624\t            imax = i;\n   625\t            dmax = dot;\n   626\t        }\n   627\t        i += 1;\n   628\t    }\n   629\t    imax\n   630\t}\n   631\t\n   632\t#[unsafe(no_mangle)]\n   633\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n   634\t    let den = 1.0f32 / (*s).div;\n   635\t    match (*s).count {\n   636\t        1 => {\n   637\t            *a = (*s).a.sA;\n   638\t            *b = (*s).a.sB;\n   639\t        }\n   640\t        2 => {\n   641\t            *a = c2Add(\n   642\t                c2Mulvs((*s).a.sA, x86_mul((*s).a.u, den)),\n   643\t                c2Mulvs((*s).b.sA, x86_mul((*s).b.u, den)),\n   644\t            );\n   645\t            *b = c2Add(\n   646\t                c2Mulvs((*s).a.sB, x86_mul((*s).a.u, den)),\n   647\t                c2Mulvs((*s).b.sB, x86_mul((*s).b.u, den)),\n   648\t            );\n   649\t        }\n   650\t        3 => {\n   651\t            *a = c2Add(\n   652\t                c2Add(\n   653\t                    c2Mulvs((*s).a.sA, x86_mul((*s).a.u, den)),\n   654\t                    c2Mulvs((*s).b.sA, x86_mul((*s).b.u, den)),\n   655\t                ),\n   656\t                c2Mulvs((*s).c.sA, x86_mul((*s).c.u, den)),\n   657\t            );\n   658\t            *b = c2Add(\n   659\t                c2Add(\n   660\t                    c2Mulvs((*s).a.sB, x86_mul((*s).a.u, den)),\n   661\t                    c2Mulvs((*s).b.sB, x86_mul((*s).b.u, den)),\n   662\t                ),\n   663\t                c2Mulvs((*s).c.sB, x86_mul((*s).c.u, den)),\n   664\t            );\n   665\t        }\n   666\t        _ => {\n   667\t            *a = c2V(0.0, 0.0);\n   668\t            *b = c2V(0.0, 0.0);\n   669\t        }\n   670\t    }\n   671\t}\n   672\t\n   673\t#[unsafe(no_mangle)]\n   674\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n   675\t    let den = 1.0f32 / (*s).div;\n   676\t    match (*s).count {\n   677\t        1 => (*s).a.p,\n   678\t        2 => c2Add(\n   679\t            c2Mulvs((*s).a.p, x86_mul((*s).a.u, den)),\n   680\t            c2Mulvs((*s).b.p, x86_mul((*s).b.u, den)),\n   681\t        ),\n   682\t        _ => c2V(0.0, 0.0),\n   683\t    }\n   684\t}\n   685\t\n   686\t#[unsafe(no_mangle)]\n   687\tpub unsafe extern \"C\" fn c2GJK(\n   688\t    A: *const c_void,\n   689\t    typeA: c_int,\n   690\t    ax_ptr: *const c2x,\n   691\t    B: *const c_void,\n   692\t    typeB: c_int,\n   693\t    bx_ptr: *const c2x,\n   694\t    outA: *mut c2v,\n   695\t    outB: *mut c2v,\n   696\t    use_radius: c_int,\n   697\t    iterations: *mut c_int,\n   698\t    cache: *mut c2GJKCache,\n   699\t) -> f32 {\n   700\t    let ax: c2x;\n   701\t    let bx: c2x;\n   702\t    if ax_ptr.is_null() {\n   703\t        ax = c2xIdentity();\n   704\t    } else {\n   705\t        ax = *ax_ptr;\n   706\t    }\n   707\t    if bx_ptr.is_null() {\n   708\t        bx = c2xIdentity();\n   709\t    } else {\n   710\t        bx = *bx_ptr;\n   711\t    }\n   712\t    // In C these two proxies are uninitialised locals; `c2MakeProxy` has no\n   713\t    // `C2_TYPE_POLY` case, so for a poly the proxy keeps whatever the stack held\n   714\t    // (radius 0 / count 0 / ve