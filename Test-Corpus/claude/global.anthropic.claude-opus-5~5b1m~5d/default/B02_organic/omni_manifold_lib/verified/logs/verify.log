e).r = e;\n            capsule as *mut c_void\n        }\n        _ => std::ptr::null_mut(),\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn omni_manifold(\n    m: *mut c2Manifold,\n    type_a: c_int,\n    a1: f32,\n    a2: f32,\n    a3: f32,\n    a4: f32,\n    a5: f32,\n    type_b: c_int,\n    b1: f32,\n    b2: f32,\n    b3: f32,\n    b4: f32,\n    b5: f32,\n) {\n    let A = ptr_from_parts(type_a, a1, a2, a3, a4, a5);\n    let B = ptr_from_parts(type_b, b1, b2, b3, b4, b5);\n\n    c2Collide(A, type_a, B, type_b, m);\n}\n","structuredPatch":[{"oldStart":165,"oldLines":12,"newStart":165,"newLines":22,"lines":[" /// gcc's register allocation therefore fixes which NaN a mixed-NaN expression"," /// returns; these helpers let the translation name that choice explicitly."," /// For non-NaN operands they are exactly the plain IEEE-754 operation.","+///","+/// SSE arithmetic instructions also *quiet* a propagated signalling NaN by","+/// setting the mantissa MSB, so the helpers apply `quiet()` to the operand they","+/// forward (a plain `dst`/`src` return would leak an sNaN payload that the C","+/// build never produces)."," #[inline(always)]","+fn quiet(x: f32) -> f32 {","+    f32::from_bits(x.to_bits() | 0x0040_0000)","+}","+","+#[inline(always)]"," fn x86_mul(dst: f32, src: f32) -> f32 {","     let r = if dst.is_nan() {","-        dst","+        quiet(dst)","     } else if src.is_nan() {","-        src","+        quiet(src)","     } else {","         dst * src","     };"]},{"oldStart":180,"oldLines":9,"newStart":190,"newLines":9,"lines":[" #[inline(always)]"," fn x86_add(dst: f32, src: f32) -> f32 {","     let r = if dst.is_nan() {","-        dst","+        quiet(dst)","     } else if src.is_nan() {","-        src","+        quiet(src)","     } else {","         dst + src","     };"]},{"oldStart":192,"oldLines":9,"newStart":202,"newLines":9,"lines":[" #[inline(always)]"," fn x86_sub(dst: f32, src: f32) -> f32 {","     let r = if dst.is_nan() {","-        ds