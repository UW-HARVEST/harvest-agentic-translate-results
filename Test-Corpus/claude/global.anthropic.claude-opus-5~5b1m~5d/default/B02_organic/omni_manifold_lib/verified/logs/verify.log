{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_n5qf7xjvqzprhy2jf7tqwkskd627lc37jybxca6zet7ksuz2bgzq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01DfhPEErtC7zd4JSL2QJjnz","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-7PcXTT/translation/tests/scratch_probe3.rs","content":"//! Scratch probe 3: is the C library's `c2AABBtoCapsuleManifold` result\n//! history-dependent (i.e. does the uninitialised-proxy garbage change with the\n//! preceding call sequence)?\n\n#![allow(non_snake_case)]\n\nmod common;\nuse common::*;\n\ntype AabbCap = unsafe extern \"C\" fn(c2AABB, c2Capsule, *mut c2Manifold);\n\nfn seed() -> c2Manifold {\n    c2Manifold {\n        count: -13,\n        depths: [7.5, -8.25],\n        contact_points: [c2v { x: 11.0, y: 12.0 }, c2v { x: 13.0, y: 14.0 }],\n        n: c2v { x: 0.25, y: -0.75 },\n    }\n}\n\nfn run(f: AabbCap, a: c2AABB, b: c2Capsule) -> c2Manifold {\n    let mut m = seed();\n    unsafe { f(a, b, &mut m) };\n    m\n}\n\n#[test]\nfn probe_history_dependence() {\n    let p = pair();\n    let f: AabbCap = p.c.get(\"c2AABBtoCapsuleManifold\");\n\n    let target_a = c2AABB { min: c2v { x: -1.0, y: -1.0 }, max: c2v { x: 1.0, y: 1.0 } };\n    let target_b = c2Capsule { a: c2v { x: -3.0, y: 0.0 }, b: c2v { x: 3.0, y: 0.0 }, r: 0.5 };\n\n    println!(\"--- same call 5x in a row ---\");\n    for i in 0..5 {\n        println!(\"{}: {}\", i, fmt_man(&run(f, target_a, target_b)));\n    }\n\n    println!(\"--- after an unrelated call ---\");\n    let other_a = c2AABB { min: c2v { x: 100.0, y: 200.0 }, max: c2v { x: 300.0, y: 400.0 } };\n    let other_b = c2Capsule { a: c2v { x: -70.0, y: 90.0 }, b: c2v { x: 12.0, y: -34.0 }, r: 7.0 };\n    let _ = run(f, other_a, other_b);\n    println!(\"post-other: {}\", fmt_man(&run(f, target_a, target_b)));\n    let _ = run(f, other_a, other_b);\n    let _ = run(f, other_a, other_b);\n    println!(\"post-other2: {}\", fmt_man(&run(f, target_a, target_b)));\n\n    println!(\"--- after deep recursion (different stack depth) ---\");\n    fn deep(n: u32, f: AabbCap, a: c2AABB, b: c2Capsule) -> c2Manifold {\n        if n == 0 {\n            run(f, a, b)\n        } else {\n            let m = deep(n - 1, f, a, b);\n            std::hint::black_box(m)\n        }\n    }\n    for d in [0u32, 1, 5, 20] {\n        println!(\"depth {}: {}\", d, fmt_man(&deep(d, f, target_a, target_b)));\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2289,"cache_read_input_tokens":138523,"cache_creation":{"ephemeral_5m_input_tokens":2289,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1ea9a5fb-ed63-409e-b5a3-01727940d457","uuid":"d473193d-4327-46b8-8580-4af7b517a2ec","timestamp":"2026-09-05T09:14:35.206Z"}
