   scrub_n::<32768>();\n            eprintln!(\"dirtied+scrubbed 32k\");\n        }\n        \"dirty_scrub_big\" => {\n            dirty();\n            scrub_n::<{ 128 * 1024 }>();\n            eprintln!(\"dirtied+scrubbed 128k\");\n        }\n        _ => {\n            scrub_n::<32768>();\n            eprintln!(\"scrubbed 32k\");\n        }\n    }\n    unsafe { f(a, b, &mut m) };\n    eprintln!(\"survived: {}\", fmt_man(&m));\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2447,"cache_read_input_tokens":174018,"cache_creation":{"ephemeral_5m_input_tokens":2447,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1ea9a5fb-ed63-409e-b5a3-01727940d457","uuid":"1bbb28ed-267b-4206-aa86-a8c521b50414","timestamp":"2026-09-05T09:17:53.040Z"}
