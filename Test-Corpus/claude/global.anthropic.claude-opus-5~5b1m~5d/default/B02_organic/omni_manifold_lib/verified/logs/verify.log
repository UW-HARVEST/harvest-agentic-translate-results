  503\t\t\t}\r\n   504\t\t\tc2v p = c2L(&s);\r\n   505\t\t\td1 = c2Dot(p, p);\r\n   506\t\t\tif (d1 > d0)\r\n   507\t\t\t\tbreak;\r\n   508\t\t\td0 = d1;\r\n   509\t\t\tc2v d = c2D(&s);\r\n   510\t\t\tif (c2Dot(d, d) < 1.19209289550781250000000000000000000e-7F *\r\n   511\t\t\t\t\t1.19209289550781250000000000000000000e-7F)\r\n   512\t\t\t\tbreak;\r\n   513\t\t\tint iA = c2Support(pA.verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\r\n   514\t\t\tc2v sA = c2Mulxv(ax, pA.verts[iA]);\r\n   515\t\t\tint iB = c2Support(pB.verts, pB.count, c2MulrvT(bx.r, d));\r\n   516\t\t\tc2v sB = c2Mulxv(bx, pB.verts[iB]);\r\n   517\t\t\tc2sv *v = verts + s.count;\r\n   518\t\t\tv->iA = iA;\r\n   519\t\t\tv->sA = sA;\r\n   520\t\t\tv->iB = iB;\r\n   521\t\t\tv->sB = sB;\r\n   522\t\t\tv->p = c2Sub(v->sB, v->sA);\r\n   523\t\t\tint dup = 0;\r\n   524\t\t\tfor (int i = 0; i < save_count; ++i) {\r\n   525\t\t\t\tif (iA == saveA[i] && iB == saveB[i]) {\r\n   526\t\t\t\t\tdup = 1;\r\n   527\t\t\t\t\tbreak;\r\n   528\t\t\t\t}\r\n   529\t\t\t}\r\n   530\t\t\tif (dup)\r\n   531\t\t\t\tbreak;\r\n   532\t\t\t++s.count;\r\n   533\t\t\t++iter;\r\n   534\t\t}\r\n   535\t\tc2v a, b;\r\n   536\t\tc2Witness(&s, &a, &b);\r\n   537\t\tfloat dist = c2Len(c2Sub(a, b));\r\n   538\t\tif (hit) {\r\n   539\t\t\ta = b;\r\n   540\t\t\tdist = 0;\r\n   541\t\t} else if (use_radius) {\r\n   542\t\t\tfloat rA = pA.radius;\r\n   543\t\t\tfloat rB = pB.radius;\r\n   544\t\t\tif (dist > rA + rB &&\r\n   545\t\t\t\t\tdist > 1.19209289550781250000000000000000000e-7F) {\r\n   546\t\t\t\tdist -= rA + rB;\r\n   547\t\t\t\tc2v n = c2Norm(c2Sub(b, a));\r\n   548\t\t\t\ta = c2Add(a, c2Mulvs(n, rA));\r\n   549\t\t\t\tb = c2Sub(b, c2Mulvs(n, rB));\r\n   550\t\t\t\tif (a.x == b.x && a.y == b.y)\r\n   551\t\t\t\t\tdist = 0;\r\n   552\t\t\t} else {\r\n   553\t\t\t\tc2v p = c2Mulvs(c2Add(a, b), 0.5f);\r\n   554\t\t\t\ta = p;\r\n   555\t\t\t\tb = p;\r\n   556\t\t\t\tdist = 0;\r\n   557\t\t\t}\r\n   558\t\t}\r\n   559\t\tif (cache) {\r\n 