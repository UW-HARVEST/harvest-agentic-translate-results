   \"{}: remaining untouched\",","+                tag","+            );","+            let spliced = *(head0 as *mut *mut u8);","+            assert_eq!(","+                p as usize,","+                spliced as usize + 8,","+                \"{}: p must be in head->next\",","+                tag","+            );","+        }","+    } else {","+        // fresh block of `bs` bytes becomes the new head","+        assert_eq!(chain1, chain0 + 1, \"{}: chain grows by one\", tag);","+        assert_ne!(head1, head0, \"{}: new head block\", tag);","+        assert_eq!(after.remaining, bs - len, \"{}: remaining\", tag);","+        assert_eq!(","+            p as usize,","+            head1 as usize + 8 + after.remaining,","+            \"{}: bump offset in new block\",","+            tag","+        );","+    }"," }"," "," // -------------------------------------------------------------------- row 25"]}],"userModified":false,"replaceAll":false}}
