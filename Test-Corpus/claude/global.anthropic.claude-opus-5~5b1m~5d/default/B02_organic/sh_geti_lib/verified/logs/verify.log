          check_shape(num, &out);","-            assert_eq!(show(&out), expected_output(num), \"exact output for num={}\", num);","-            if num == 33 {","-                outs.push(out);","-            }","-        }","+        let outs = run_and_check(*s, &nums);","+        per_seed.push(outs[1].clone()); // num == 33","     }","     // `sh_geti` prints by walking the *array* (insertion order), not the hash","     // table, so the output is deliberately independent of the hash seed even","     // though the bucket layout is not.","-    let distinct: std::collections::HashSet<Vec<u8>> = outs.iter().cloned().collect();","+    let distinct: std::collections::HashSet<Vec<u8>> = per_seed.iter().cloned().collect();","     assert_eq!(","         distinct.len(),","         1,"]},{"oldStart":191,"oldLines":28,"newStart":158,"newLines":9,"lines":["     );"," }"," ","-/// The output `sh_geti(num)` must produce, derived from the C source:","-/// two passes; each prints `test_i i*3` for even `i < num`, in insertion order.","-fn expected_output(num: c_int) -> String {","-    if num <= 0 {","-        return String::new();","-    }","-    let mut s = String::new();","-    for _pass in 0..2 {","-        let mut i = 0i64;","-        while i < num as i64 {","-            s.push_str(&format!(\"test_{} {}\\n\", i, i * 3));","-            i += 2;","-        }","-    }","-    s","-}","-","-// exact-output check for every size already covered above","+// exact-output cross-check at additional sizes"," #[test]"," fn c80b_sh_geti_exact_output() {","-    for num in [0, 1, 2, 3, 4, 5, 8, 9, 16, 17, 33, 64, 100, 128, 257, 1000] {","-        let out = assert_same(DEFAULT_SEED, num);","-        assert_eq!(show(&out), expected_output(num), \"exact output for num={}\", num);","-    }","+    let nums: Vec<c_int> = vec![0, 1, 2, 3, 4, 5, 8, 9, 16, 17, 33, 64, 100, 128, 257, 1000];","+    run_and_check(DEFAULT_SEED, &nums);"," }"]}],"originalFile":"//! Phase B — CONFIGS.md rows 80..86\n//! `sh_geti`, the top-level driver.  It prints through libc `printf`, so the\n//! comparison is done on the raw bytes written to fd 1.\n\nmod common;\nuse common::*;\nuse std::ffi::c_int;\n\n/// Run `sh_geti(num)` in each library from the same starting seed and return\n/// (c_output, rust_output).\nfn run_one(seed: usize, num: c_int) -> (Vec<u8>, Vec<u8>) {\n    let p = pair();\n    let _g = seed_guard(seed);\n    let c = capture_stdout(|| unsafe {\n        (p.c.rand_seed)(seed);\n        (p.c.sh_geti)(num);\n    });\n    let r = capture_stdout(|| unsafe {\n        (p.r.rand_seed)(seed);\n        (p.r.sh_geti)(num);\n    });\n    (c, r)\n}\n\nfn assert_same(seed: usize, num: c_int) -> Vec<u8> {\n    let (c, r) = run_one(seed, num);\n    if c != r {\n        // find the first differing line for a readable message\n        let cl: Vec<&[u8]> = c.split(|b| *b == b'\\n').collect();\n        let rl: Vec<&[u8]> = r.split(|b| *b == b'\\n').collect();\n        for i in 0..cl.len().max(rl.len()) {\n            let a = cl.get(i).map(|x| show(x)).unwrap_or_else(|| \"<eof>\".into());\n            let b = rl.get(i).map(|x| show(x)).unwrap_or_else(|| \"<eof>\".into());\n            if a != b {\n                panic!(\n                    \"sh_geti({}) seed={:#x}: first difference at line {}\\n  C    = {:?}\\n  Rust = {:?}\\n  \\\n                     (C has {} lines, Rust {} lines)\",\n                    num, seed, i, a, b, cl.len(), rl.len()\n                );\n            }\n        }\n        panic!(\"sh_geti({}) seed={:#x}: outputs differ in length only\", num, seed);\n    }\n    c\n}\n\n/// Independent model of what `sh_geti` must print:\n/// two passes (`j = 0` strdup, `j = 1` arena), each printing `shlen(strmap)`\n/// lines of `\"<key> <value>\\n\"` for the entries `test_i` with even `i < num`.\nfn check_shape(num: c_int, out: &[u8]) {\n    if num <= 0 {\n        assert!(out.is_empty(), \"sh_geti({}) must print nothing\", num);\n        return;\n    }\n    let n = num as usize;\n    let entries = n.div_ceil(2); // i = 0,2,4,... < num\n    let text = String::from_utf8(out.to_vec()).expect(\"output must be UTF-8 here\");\n    let lines: Vec<&str> = text.lines().collect();\n    assert_eq!(\n        lines.len(),\n        2 * entries,\n        \"sh_geti({}) must print {} lines (2 passes x {} entries)\",\n        num,\n        2 * entries,\n        entries\n    );\n    for chunk in lines.chunks(entries) {\n        let mut seen: Vec<usize> = Vec::new();\n        for l in chunk {\n            let mut it = l.split(' ');\n            let key = it.next().unwrap();\n            let val: i64 = it.next().unwrap().parse().unwrap();\n            assert!(it.next().is_none(), \"unexpected extra field in {:?}\", l);\n            let i: usize = key.strip_prefix(\"test_\").unwrap().parse().unwrap();\n            assert_eq!(i % 2, 0, \"only even keys are inserted\");\n            assert!(i < n);\n            assert_eq!(val, (i as i64) * 3, \"value must be i*3\");\n            seen.push(i);\n        }\n        seen.sort_unstable();\n        let want: Vec<usize> = (0..n).step_by(2).collect();\n        assert_eq!(seen, want, \"every even key must appear exactly once\");\n    }\n}\n\n// -------------------------------------------------------------------- row 80\n#[test]\nfn c80_sh_geti_small() {\n    for num in 0..=9 {\n        let out = assert_same(DEFAULT_SEED, num);\n        check_shape(num, &out);\n    }\n}\n\n// -------------------------------------------------------------------- row 81\n#[test]\nfn c81_sh_geti_mid() {\n    for num in 10..=40 {\n        let out = assert_same(DEFAULT_SEED, num);\n        check_shape(num, &out);\n    }\n}\n\n// -------------------------------------------------------------------- row 82\n#[test]\nfn c82_sh_geti_power_of_two_boundaries() {\n    for num in [\n        15, 16, 17, 31, 32, 33, 47, 48, 63, 64, 65, 95, 96, 127, 128, 129,\n    ] {\n        let out = assert_same(DEFAULT_SEED, num);\n        check_shape(num, &out);\n    }\n}\n\n// -------------------------------------------------------------------- row 83\n#[test]\nfn c83_sh_geti_large() {\n    for num in [200, 255, 256, 257, 500, 1000] {\n        let out = assert_same(DEFAULT_SEED, num);\n        check_shape(num, &out);\n    }\n}\n\n// -------------------------------------------------------------------- row 84\n#[test]\nfn c84_sh_geti_non_positive() {\n    for num in [0, -1, -2, -1000, c_int::MIN] {\n        let out = assert_same(DEFAULT_SEED, num);\n        check_shape(num, &out);\n        assert!(out.is_empty());\n    }\n}\n\n// -------------------------------------------------------------------- row 85\n#[test]\nfn c85_sh_geti_repeated_calls_share_globals() {\n    // `stbds_hash_seed` and the static `buffer` persist across calls, so a\n    // sequence of calls must match as a whole.\n    let p = pair();\n    let mut rng = Rng::new(0x8585);\n    let nums: Vec<c_int> = (0..30).map(|_| (rng.below(60)) as c_int).collect();\n    let _g = seed_guard(DEFAULT_SEED);\n    let c = capture_stdout(|| unsafe {\n        (p.c.rand_seed)(DEFAULT_SEED);\n        for &n in &nums {\n            (p.c.sh_geti)(n);\n        }\n    });\n    let r = capture_stdout(|| unsafe {\n        (p.r.rand_seed)(DEFAULT_SEED);\n        for &n in &nums {\n            (p.r.sh_geti)(n);\n        }\n    });\n    assert_eq!(\n        show(&c),\n        show(&r),\n        \"repeated sh_geti calls diverged for nums = {:?}\",\n        nums\n    );\n    assert!(!c.is_empty());\n}\n\n// -------------------------------------------------------------------- row 86\n#[test]\nfn c86_sh_geti_seed_dependence() {\n    let mut rng = Rng::new(0x8686);\n    let mut seeds = vec![0usize, 1, 2, usize::MAX, DEFAULT_SEED];\n    for _ in 0..8 {\n        seeds.push(rng.next_u64() as usize);\n    }\n    let mut outs = Vec::new();\n    for s in &seeds {\n        for num in [7, 33, 100] {\n            let out = assert_same(*s, num);\n            check_shape(num, &out);\n            assert_eq!(show(&out), expected_output(num), \"exact output for num={}\", num);\n            if num == 33 {\n                outs.push(out);\n            }\n        }\n    }\n    // `sh_geti` prints by walking the *array* (insertion order), not the hash\n    // table, so the output is deliberately independent of the hash seed even\n    // though the bucket layout is not.\n    let distinct: std::collections::HashSet<Vec<u8>> = outs.iter().cloned().collect();\n    assert_eq!(\n        distinct.len(),\n        1,\n        \"sh_geti prints in insertion order, so the seed must not change the output\"\n    );\n}\n\n/// The output `sh_geti(num)` must produce, derived from the C source:\n/// two passes; each prints `test_i i*3` for even `i < num`, in insertion order.\nfn expected_output(num: c_int) -> String {\n    if num <= 0 {\n        return String::new();\n    }\n    let mut s = String::new();\n    for _pass in 0..2 {\n        let mut i = 0i64;\n        while i < num as i64 {\n            s.push_str(&format!(\"test_{} {}\\n\", i, i * 3));\n            i += 2;\n        }\n    }\n    s\n}\n\n// exact-output check for every size already covered above\n#[test]\nfn c80b_sh_geti_exact_output() {\n    for num in [0, 1, 2, 3, 4, 5, 8, 9, 16, 17, 33, 64, 100, 128, 257, 1000] {\n        let out = assert_same(DEFAULT_SEED, num);\n        assert_eq!(show(&out), expected_output(num), \"exact output for num={}\", num);\n    }\n}\n","userModified":false}}
