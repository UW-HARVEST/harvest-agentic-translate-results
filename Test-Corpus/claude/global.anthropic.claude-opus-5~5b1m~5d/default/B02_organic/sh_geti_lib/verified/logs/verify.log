","             ap.free();","         }","     }"]},{"oldStart":203,"oldLines":12,"newStart":296,"newLines":10,"lines":["             ap.fill(8, &mut rng);","             ap.check(\"initial fill\");","             for step in 0..12 {","+                let n = ap.len();","                 ap.grow(1, 0);","+                // payload [0, n) must have survived the realloc identically","                 ap.check(&format!(\"after grow {}\", step));","-                let n = {","-                    let h = (ap.ac as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;","-                    (*h).length","-                };","                 ap.set_length(n + 1);","                 let pat = rng.bytes(elemsize);","                 for a in [ap.ac, ap.ar] {"]},{"oldStart":238,"oldLines":15,"newStart":329,"newLines":10,"lines":["                 let addlen = *rng.pick(&[0usize, 1, 2, 3, 8, 17]);","                 let min_cap = *rng.pick(&[0usize, 1, 2, 4, 9, 33]);","                 ap.grow(addlen, min_cap);","-                let cap = {","-                    let h = (ap.ac as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;","-                    (*h).capacity","-                };","+                let cap = ap.cap();","                 len = (len + addlen).min(cap);","                 ap.set_length(len);","-                if len > 0 && elemsize > 0 {","-                    ap.fill(len, &mut rng);","-                }","+                ap.fill(len, &mut rng);","                 ap.check(\"randomized step\");","             }","             ap.free();"]},{"oldStart":257,"oldLines":19,"newStart":343,"newLines":24,"lines":[" // -------------------------------------------------------------------- row 24"," #[test]"," fn c24_arrgrowf_addlen_dominates() {","+    let mut rng = Rng::new(0x2424);","     for &elemsize in &[1usize, 8, 16] {","         unsafe {","             let mut ap = ArrPair::new(elemsize, format!(\"addlen-dom es={}\", elemsize));","             ap.grow(1000, 0);","-            let h = (ap.ac as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;","-            assert_eq!((*h).capacity, 1000);","+            assert_eq!(ap.cap(), 1000);","             ap.set_length(1000);","+            ap.fill(1000, &mut rng);","             ap.check(\"length=1000\");","-            // now min_len = 1000 + 1 > min_cap 0 -> min_cap = 1001, but","-            // 1001 < 2*1000 so it doubles to 2000","+            // min_len = 1000+1 > min_cap 0 -> min_cap = 1001, but 1001 < 2*1000","+            // so it doubles to 2000","             ap.grow(1, 0);","-            let h = (ap.ac as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;","-            assert_eq!((*h).capacity, 2000);","+            assert_eq!(ap.cap(), 2000);","+            ap.check(\"doubled to 2000\");","+            // huge addlen with min_cap 0","+            ap.grow(100_000, 0);","+            assert_eq!(ap.cap(), 101_000);","+            ap.check(\"huge\");","             ap.free();","         }","     }"]}],"originalFile":"//! Phase B — CONFIGS.md rows 18..24\n//! `stbds_arrgrowf` / `stbds_arrfreef`\n\nmod common;\nuse common::*;\nuse std::ffi::c_void;\n\nstruct ArrPair {\n    ac: *mut c_void,\n    ar: *mut c_void,\n    elemsize: usize,\n    ctx: String,\n    step: usize,\n}\n\nimpl ArrPair {\n    fn new(elemsize: usize, ctx: impl Into<String>) -> ArrPair {\n        ArrPair {\n            ac: std::ptr::null_mut(),\n            ar: std::ptr::null_mut(),\n            elemsize,\n            ctx: ctx.into(),\n            step: 0,\n        }\n    }\n\n    /// Returns `(c_returned_same_pointer, r_returned_same_pointer)`.\n    unsafe fn grow(&mut self, addlen: usize, min_cap: usize) -> (bool, bool) {\n        let p = pair();\n        let oc = self.ac;\n        let or = self.ar;\n        self.ac = (p.c.arrgrowf)(self.ac, self.elemsize, addlen, min_cap);\n        self.ar = (p.r.arrgrowf)(self.ar, self.elemsize, addlen, min_cap);\n        let same = (self.ac == oc, self.ar == or);\n        assert_eq!(\n            same.0, same.1,\n            \"[{}] step {}: identity-return divergence for grow(addlen={}, min_cap={})\",\n            self.ctx, self.step, addlen, min_cap\n        );\n        self.step += 1;\n        self.check(&format!(\"grow(addlen={}, min_cap={})\", addlen, min_cap));\n        same\n    }\n\n    unsafe fn check(&self, what: &str) {\n        let sc = snap_raw(self.ac, self.elemsize, KeyRepr::Raw);\n        let sr = snap_raw(self.ar, self.elemsize, KeyRepr::Raw);\n        assert!(\n            sc == sr,\n            \"DIVERGENCE [{}] step {} after `{}`\\n  C    = {:#?}\\n  Rust = {:#?}\",\n            self.ctx,\n            self.step,\n            what,\n            sc,\n            sr\n        );\n    }\n\n    unsafe fn set_length(&mut self, n: usize) {\n        for a in [self.ac, self.ar] {\n            let h = (a as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;\n            (*h).length = n;\n        }\n    }\n\n    unsafe fn fill(&mut self, n: usize, rng: &mut Rng) {\n        let bytes = rng.bytes(n * self.elemsize);\n        for a in [self.ac, self.ar] {\n            std::ptr::copy_nonoverlapping(bytes.as_ptr(), a as *mut u8, bytes.len());\n        }\n    }\n\n    unsafe fn free(&mut self) {\n        let p = pair();\n        if !self.ac.is_null() {\n            (p.c.arrfreef)(self.ac);\n        }\n        if !self.ar.is_null() {\n            (p.r.arrfreef)(self.ar);\n        }\n        self.ac = std::ptr::null_mut();\n        self.ar = std::ptr::null_mut();\n    }\n}\n\n// -------------------------------------------------------------------- row 18\n#[test]\nfn c18_arrgrowf_from_null_cross_product() {\n    for &elemsize in &[1usize, 2, 4, 8, 12, 16, 24, 32, 64] {\n        for &addlen in &[0usize, 1, 2, 7, 100] {\n            for &min_cap in &[0usize, 1, 2, 4, 5, 100] {\n                unsafe {\n                    let mut ap = ArrPair::new(\n                        elemsize,\n                        format!(\"null es={} addlen={} min_cap={}\", elemsize, addlen, min_cap),\n                    );\n                    ap.grow(addlen, min_cap);\n                    // capacity must be max(max(addlen, min_cap), 4)\n                    let h = (ap.ac as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;\n                    let expect = std::cmp::max(std::cmp::max(addlen, min_cap), 4);\n                    assert_eq!((*h).capacity, expect, \"capacity model\");\n                    ap.free();\n                }\n            }\n        }\n    }\n}\n\n// -------------------------------------------------------------------- row 19\n#[test]\nfn c19_arrgrowf_repeated_doubling() {\n    let mut rng = Rng::new(0x1919);\n    for &elemsize in &[1usize, 8, 16, 24] {\n        unsafe {\n            let mut ap = ArrPair::new(elemsize, format!(\"doubling es={}\", elemsize));\n            let mut len = 0usize;\n            for i in 0..64 {\n                ap.grow(1, 0);\n                len += 1;\n                ap.set_length(len);\n                ap.check(&format!(\"set_length({})\", len));\n                // write a byte pattern into the newest element and verify it\n                // survives the next realloc\n                let pat = rng.next_u8();\n                for a in [ap.ac, ap.ar] {\n                    std::ptr::write_bytes(\n                        (a as *mut u8).add((len - 1) * elemsize),\n                        pat,\n                        elemsize,\n                    );\n                }\n                ap.check(&format!(\"write elem {}\", i));\n            }\n            ap.free();\n        }\n    }\n}\n\n// -------------------------------------------------------------------- row 20\n#[test]\nfn c20_arrgrowf_min_cap_branches() {\n    for &elemsize in &[1usize, 8, 16] {\n        for &start in &[4usize, 8, 16, 100] {\n            unsafe {\n                let mut ap =\n                    ArrPair::new(elemsize, format!(\"mincap es={} start={}\", elemsize, start));\n                ap.grow(0, start);\n                let cap = {\n                    let h = (ap.ac as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;\n                    (*h).capacity\n                };\n                // min_cap <= cap  -> identity return, nothing changes\n                for &mc in &[0usize, 1, cap / 2, cap - 1, cap] {\n                    let (sc, _) = ap.grow(0, mc);\n                    assert!(sc, \"min_cap={} <= cap={} must return the input\", mc, cap);\n                }\n                // cap+1 -> the `min_cap < 2*cap` branch bumps it to 2*cap\n                let (sc, _) = ap.grow(0, cap + 1);\n                assert!(!sc, \"growth expected\");\n                let cap2 = {\n                    let h = (ap.ac as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;\n                    (*h).capacity\n                };\n                assert_eq!(cap2, 2 * cap, \"doubling branch\");\n                // 2*cap2+1 -> exceeds doubling, min_cap wins verbatim\n                let want = 2 * cap2 + 1;\n                ap.grow(0, want);\n                let cap3 = {\n                    let h = (ap.ac as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;\n                    (*h).capacity\n                };\n                assert_eq!(cap3, want, \"explicit min_cap branch\");\n                // 4*cap3\n                ap.grow(0, 4 * cap3);\n                ap.free();\n            }\n        }\n    }\n}\n\n// -------------------------------------------------------------------- row 21\n#[test]\nfn c21_arrgrowf_zero_elemsize() {\n    for &min_cap in &[0usize, 1, 4, 100, 1000] {\n        unsafe {\n            let mut ap = ArrPair::new(0, format!(\"es=0 min_cap={}\", min_cap));\n            ap.grow(0, min_cap);\n            ap.grow(3, min_cap);\n            ap.free();\n        }\n    }\n}\n\n// -------------------------------------------------------------------- row 22\n#[test]\nfn c22_arrgrowf_preserves_payload() {\n    let mut rng = Rng::new(0x2222);\n    for &elemsize in &[1usize, 3, 8, 16, 32] {\n        unsafe {\n            let mut ap = ArrPair::new(elemsize, format!(\"payload es={}\", elemsize));\n            ap.grow(0, 8);\n            ap.set_length(8);\n            ap.fill(8, &mut rng);\n            ap.check(\"initial fill\");\n            for step in 0..12 {\n                ap.grow(1, 0);\n                ap.check(&format!(\"after grow {}\", step));\n                let n = {\n                    let h = (ap.ac as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;\n                    (*h).length\n                };\n                ap.set_length(n + 1);\n                let pat = rng.bytes(elemsize);\n                for a in [ap.ac, ap.ar] {\n                    std::ptr::copy_nonoverlapping(\n                        pat.as_ptr(),\n                        (a as *mut u8).add(n * elemsize),\n                        elemsize,\n                    );\n                }\n                ap.check(&format!(\"append {}\", step));\n            }\n            ap.free();\n        }\n    }\n}\n\n// -------------------------------------------------------------------- row 23\n#[test]\nfn c23_arrgrowf_randomized_sequences() {\n    let mut rng = Rng::new(0x2323);\n    for seq in 0..256 {\n        let elemsize = *rng.pick(&[1usize, 2, 4, 8, 12, 16, 24, 32]);\n        unsafe {\n            let mut ap = ArrPair::new(elemsize, format!(\"seq {} es={}\", seq, elemsize));\n            let mut len = 0usize;\n            for _ in 0..24 {\n                let addlen = *rng.pick(&[0usize, 1, 2, 3, 8, 17]);\n                let min_cap = *rng.pick(&[0usize, 1, 2, 4, 9, 33]);\n                ap.grow(addlen, min_cap);\n                let cap = {\n                    let h = (ap.ac as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;\n                    (*h).capacity\n                };\n                len = (len + addlen).min(cap);\n                ap.set_length(len);\n                if len > 0 && elemsize > 0 {\n                    ap.fill(len, &mut rng);\n                }\n                ap.check(\"randomized step\");\n            }\n            ap.free();\n        }\n    }\n}\n\n// -------------------------------------------------------------------- row 24\n#[test]\nfn c24_arrgrowf_addlen_dominates() {\n    for &elemsize in &[1usize, 8, 16] {\n        unsafe {\n            let mut ap = ArrPair::new(elemsize, format!(\"addlen-dom es={}\", elemsize));\n            ap.grow(1000, 0);\n            let h = (ap.ac as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;\n            assert_eq!((*h).capacity, 1000);\n            ap.set_length(1000);\n            ap.check(\"length=1000\");\n            // now min_len = 1000 + 1 > min_cap 0 -> min_cap = 1001, but\n            // 1001 < 2*1000 so it doubles to 2000\n            ap.grow(1, 0);\n            let h = (ap.ac as *mut u8).sub(HEADER_SIZE) as *mut ArrayHeader;\n            assert_eq!((*h).capacity, 2000);\n            ap.free();\n        }\n    }\n}\n","userModified":false}}
