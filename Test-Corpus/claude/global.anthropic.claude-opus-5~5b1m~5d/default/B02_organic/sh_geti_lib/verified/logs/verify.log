{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_uayoxjdqbbzpmv4gplqqgvn5xtdsramenmrieozu2f5lcxv7e55q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_016yUKJwe7qBjiXBnTekQCmh","name":"Edit","input":{"replace_all":false,"file_path":"/local/home/scheschb/.harvest/work/harvest-work-n7doav/translation/tests/common/mod.rs","old_string":"/// Put both libraries' global `stbds_hash_seed` into the same known state.\npub fn reseed(seed: usize) {\n    let p = pair();\n    unsafe {\n        (p.c.rand_seed)(seed);\n        (p.r.rand_seed)(seed);\n    }\n}","new_string":"/// Put both libraries' global `stbds_hash_seed` into the same known state.\npub fn reseed(seed: usize) {\n    let p = pair();\n    unsafe {\n        (p.c.rand_seed)(seed);\n        (p.r.rand_seed)(seed);\n    }\n}\n\n/// `stbds_hash_seed` is a *global* in each `.so` and every fresh hash index\n/// advances it.  Because the two libraries are advanced one after the other,\n/// concurrent test threads could interleave the two sequences and desynchronise\n/// them.  Any test that creates hash indices must therefore hold this guard.\nstatic SEED_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());\n\npub fn seed_guard(seed: usize) -> std::sync::MutexGuard<'static, ()> {\n    let g = SEED_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n    reseed(seed);\n    g\n}\n\n/// `stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)` transcribed from\n/// `lib.c:360-363` (all sub-expressions are 32-bit `unsigned int` in C).\nfn load_32_or_64(v32: u32, v64_hi: u32, v64_lo: u32) -> usize {\n    let temp = (v64_lo ^ v32) as usize; // zero-extended unsigned int\n    let mut var = (v64_hi as usize) << 16 << 16;\n    var ^= temp ^ (v32 as usize);\n    var\n}\n\n/// The LCG the C uses to advance `stbds_hash_seed` (`lib.c:410-412`).\npub fn next_hash_seed(seed: usize) -> usize {\n    let a = load_32_or_64(2147001325, 0x27bb_2ee6, 0x87b0_b0fd);\n    let b = load_32_or_64(715136305, 0, 0xb504_f32d);\n    seed.wrapping_mul(a).wrapping_add(b)\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":470,"cache_read_input_tokens":179094,"cache_creation":{"ephemeral_5m_input_tokens":470,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b643f80a-4a3f-46ec-a182-2be51940f001","uuid":"aa64cc52-0b8a-4172-b813-6e3b88ca5e40","timestamp":"2026-08-27T16:44:09.237Z"}
