436\t        hash = STBDS_ROTATE_LEFT(hash, 9).wrapping_add(*s as usize);\n437\t        s = s.wrapping_add(1);\n438\t    }\n439\t\n440\t    hash ^= seed;\n441\t    hash = (!hash).wrapping_add(hash << 18);\n442\t    hash ^= hash ^ STBDS_ROTATE_RIGHT(hash, 31);\n443\t    hash = hash.wrapping_mul(21);\n444\t    hash ^= hash ^ STBDS_ROTATE_RIGHT(hash, 11);\n445\t    hash = hash.wrapping_add(hash << 6);\n446\t    hash ^= STBDS_ROTATE_RIGHT(hash, 22);\n447\t    hash.wrapping_add(seed)\n448\t}\n449\t\n450\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n451\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n452\t\n453\t#[inline(always)]\n454\tfn stbds_sipround(v: &mut [usize; 4]) {\n455\t    v[0] = v[0].wrapping_add(v[1]);\n456\t    v[1] = STBDS_ROTATE_LEFT(v[1], 13);\n457\t    v[1] ^= v[0];\n458\t    v[0] = STBDS_ROTATE_LEFT(v[0], STBDS_SIZE_T_BITS / 2);\n459\t    v[2] = v[2].wrapping_add(v[3]);\n460\t    v[3] = STBDS_ROTATE_LEFT(v[3], 16);\n461\t    v[3] ^= v[2];\n462\t    v[2] = v[2].wrapping_add(v[1]);\n463\t    v[1] = STBDS_ROTATE_LEFT(v[1], 17);\n464\t    v[1] ^= v[2];\n465\t    v[2] = STBDS_ROTATE_LEFT(v[2], STBDS_SIZE_T_BITS / 2);\n466\t    v[0] = v[0].wrapping_add(v[3]);\n467\t    v[3] = STBDS_ROTATE_LEFT(v[3], 21);\n468\t    v[3] ^= v[0];\n469\t}\n470\t\n471\t/// The C code builds `data` out of `int` sub-expressions; when the top byte has\n472\t/// its high bit set the `int` becomes negative and the conversion to `size_t`\n473\t/// sign-extends.  That behaviour is part of the observable output and is\n474\t/// reproduced here.\n475\t#[inline(always)]\n476\tfn c_int_to_size_t(v: u32) -> usize {\n477\t    ((v as i32) as i64) as usize\n478\t}\n479\t\n480\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n481\t    let mut d: *const u8 = p as *const u8;\n482\t    let mut i: usize;\n483\t    let mut j: usize;\n484\t    let mut v: [usize; 4] = [0; 4];\n485\t    let mut data: usize;\n486\t\n487\t    v[0] = ((0x736f_6d65usize << 16) << 16).wrapping_add(0x7073_6575) ^ seed;\n488\t    v[1] = ((0x646f_7261usize << 16) << 16).wrapping_add(0x6e64_6f6d) ^ !seed;\n489\t    v[2] = ((0x6c79_6765usize << 16) << 16).wrapping_add(0x6e65_7261) ^ seed;\n490\t    v[3] = ((0x7465_6462usize << 16) << 16).wrapping_add(0x7974_6573) ^ !seed;\n491\t\n492\t    v[0] ^= 0x0706_0504_0302_0100usize ^ seed;\n493\t    v[1] ^= 0x0f0e_0d0c_0b0a_0908usize ^ !seed;\n494\t    v[2] ^= 0x0706_0504_0302_0100usize ^ seed;\n495\t    v[3] ^= 0x0f0e_0d0c_0b0a_0908usize ^ !seed;\n496\t\n497\t    i = 0;\n498\t    while i.wrapping_add(core::mem::size_of::<usize>()) <= len {\n499\t        let lo: u32 = (*d.wrapping_add(0) as u32)\n500\t            | ((*d.wrapping_add(1) as u32) << 8)\n501\t            | ((*d.wrapping_add(2) as u32) << 16)\n502\t            | ((*d.wrapping_add(3) as u32) << 24);\n503\t        data = c_int_to_size_t(lo);\n504\t        let hi: u32 = (*d.wrapping_add(4) as u32)\n505\t            | ((*d.wrapping_add(5) as u32) << 8)\n506\t            | ((*d.wrapping_add(6) as u32) << 16)\n507\t            | ((*d.wrapping_add(7) as u32) << 24);\n508\t        data |= (c_int_to_size_t(hi) << 16) << 16;\n509\t\n510\t        v[3] ^= data;\n511\t        j = 0;\n512\t        while j < STBDS_SIPHASH_C_ROUNDS {\n513\t            stbds_sipround(&mut v);\n514\t            j += 1;\n515\t        }\n516\t        v[0] ^= data;\n517\t\n518\t        i = i.wrapping_add(core::mem::size_of::<usize>());\n519\t        d = d.wrapping_add(core::mem::size_of::<usize>());\n520\t    }\n521\t    data = len << (STBDS_SIZE_T_BITS - 8);\n522\t    // switch (len - i) with C fall-through semantics\n523\t    let rem: usize = len.wrapping_sub(i);\n524\t    if rem >= 7 {\n525\t        data |= ((*d.wrapping_add(6) as usize) << 24) << 24;\n526\t    }\n527\t    if rem >= 6 {\n528\t        data |= ((*d.wrapping_add(5) as usize) << 20) << 20;\n529\t    }\n530\t    if rem >= 5 {\n531\t        data |= ((*d.wrapping_add(4) as usize) << 16) << 16;\n532\t    }\n533\t    if rem >= 4 {\n534\t