   }\n    }\n\n    // ---- c2GJK ----------------------------------------------------------\n    for (int it = 0; it < 120000; ++it) {\n        c2Circle ci = {{rf(-90, 90), rf(-90, 90)}, rf(0, 30)};\n        c2AABB bb = {{rf(-90, 0), rf(-90, 0)}, {rf(-10, 90), rf(-10, 90)}};\n        c2Capsule ca = {{rf(-90, 90), rf(-90, 90)}, {rf(-90, 90), rf(-90, 90)}, rf(0, 30)};\n        c2Circle ci2 = {{rf(-90, 90), rf(-90, 90)}, rf(0, 30)};\n        c2AABB bb2 = {{rf(-90, 0), rf(-90, 0)}, {rf(-10, 90), rf(-10, 90)}};\n        c2Capsule ca2 = {{rf(-90, 90), rf(-90, 90)}, {rf(-90, 90), rf(-90, 90)}, rf(0, 30)};\n        const void *sh[3] = {&ci, &bb, &ca};\n        const void *sh2[3] = {&ci2, &bb2, &ca2};\n        c2x tx = {{rf(-20, 20), rf(-20, 20)}, {rf(-1, 1), rf(-1, 1)}};\n        c2x ty = {{rf(-20, 20), rf(-20, 20)}, {rf(-1, 1), rf(-1, 1)}};\n\n        for (int ta = 0; ta < 3; ++ta) {\n            for (int tb = 0; tb < 3; ++tb) {\n                for (int mode = 0; mode < 4; ++mode) {\n                    const c2x *axp = (mode & 1) ? &tx : NULL;\n                    const c2x *bxp = (mode & 1) ? &ty : NULL;\n                    int use_radius = (mode & 2) ? 1 : 0;\n                    c2v oa1, ob1, oa2, ob2;\n                    int itc = -7, itr = -7;\n                    memset(&oa1, 0x33, sizeof oa1); memset(&ob1, 0x44, sizeof ob1);\n                    memset(&oa2, 0x33, sizeof oa2); memset(&ob2, 0x44, sizeof ob2);\n                    c2GJKCache cc, cr;\n                    memset(&cc, 0, sizeof cc); memset(&cr, 0, sizeof cr);\n                    float dc = A.c2GJK(sh[ta], (C2_TYPE)ta, axp, sh2[tb], (C2_TYPE)tb,\n                                       bxp, &oa1, &ob1, use_radius, &itc, &cc);\n                    float dr = R.c2GJK(sh[ta], (C2_TYPE)ta, axp, sh2[tb], (C2_TYPE)tb,\n                                       bxp, &oa2, &ob2, use_radius, &itr, &cr);\n                    chk(\"c2GJK.dist\", &dc, &dr, sizeof dc);\n                    chk(\"c2GJK.outA\", &oa1, &