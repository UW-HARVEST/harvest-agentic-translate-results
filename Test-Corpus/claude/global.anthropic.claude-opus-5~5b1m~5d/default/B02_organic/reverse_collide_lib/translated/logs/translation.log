 ca), int);\n        CHK1(\"c2CapsuletoCapsule\", A.c2CapsuletoCapsule(ca, ca2), R.c2CapsuletoCapsule(ca, ca2), int);\n        CHK1(\"c2CircletoCircle\", A.c2CircletoCircle(ci, ci2), R.c2CircletoCircle(ci, ci2), int);\n        CHK1(\"c2CircletoAABB\", A.c2CircletoAABB(ci, bb), R.c2CircletoAABB(ci, bb), int);\n        CHK1(\"c2CircletoCapsule\", A.c2CircletoCapsule(ci, ca), R.c2CircletoCapsule(ci, ca), int);\n        const void *sh[4] = {&ci, &bb, &ca, &ci2};\n        for (int ta = 0; ta < 4; ++ta)\n            for (int tb = 0; tb < 4; ++tb)\n                CHK1(\"c2Collided\", A.c2Collided(sh[ta], (C2_TYPE)ta, sh[tb], (C2_TYPE)tb),\n                     R.c2Collided(sh[ta], (C2_TYPE)ta, sh[tb], (C2_TYPE)tb), int);\n    }\n\n    // ---- reverse_collide: dense grid + specials -------------------------\n    for (int i = -160; i <= 160; ++i) {\n        for (int j = -160; j <= 160; ++j) {\n            for (int k = 0; k <= 6; ++k) {\n                float x = (float)i * 1.0f, y = (float)j * 1.0f, r = (float)k * 5.0f;\n                CHK1(\"reverse_collide\", A.reverse_collide(x, y, r),\n                     R.reverse_collide(x, y, r), int);\n            }\n        }\n    }\n    for (int i = 0; i < NSPECIAL; ++i)\n        for (int j = 0; j < NSPECIAL; ++j)\n            for (int k = 0; k < NSPECIAL; ++k)\n                CHK1(\"reverse_collide.special\",\n                     A.reverse_collide(SPECIAL[i], SPECIAL[j], SPECIAL[k]),\n                     R.reverse_collide(SPECIAL[i], SPECIAL[j], SPECIAL[k]), int);\n    for (int it = 0; it < 500000; ++it) {\n        float x = rf(-200, 200), y = rf(-200, 200), r = rf(-5, 60);\n        CHK1(\"reverse_collide.rand\", A.reverse_collide(x, y, r),\n             R.reverse_collide(x, y, r), int);\n    }\n    // NaN / inf inputs\n    {\n        float nan = 0.0f / 0.0f, inf = 1.0f / 0.0f;\n        float odd[] = {nan, inf, -inf, 0.0f, -0.0f, 1.0f};\n        for (int i = 0; i < 6; ++i)\n            for (int j = 0; j < 6; ++j)\n                for (int k = 0; k < 6; ++k)\n                    CHK1(\"reverse_collide.nan\",\n                         A.reverse_collide(odd[i], odd[j], odd[k]),\n                         R.reverse_collide(odd[i], odd[j], odd[k]), int);\n        for (int i = 0; i < 6; ++i) {\n            c2v u = {odd[i], odd[(i + 1) % 6]}, v = {odd[(i + 2) % 6], odd[i]};\n            CHK1(\"nan.c2Maxv\", A.c2Maxv(u, v), R.c2Maxv(u, v), c2v);\n            CHK1(\"nan.c2Minv\", A.c2Minv(u, v), R.c2Minv(u, v), c2v);\n            CHK1(\"nan.c2Clampv\", A.c2Clampv(u, v, u), R.c2Clampv(u, v, u), c2v);\n            CHK1(\"nan.c2Len\", A.c2Len(u), R.c2Len(u), float);\n            CHK1(\"nan.c2Norm\", A.c2Norm(u), R.c2Norm(u), c2v);\n            c2Circle c1 = {{odd[i], odd[(i + 3) % 6]}, odd[(i + 1) % 6]};\n            c2Circle c2 = {{odd[(i + 2) % 6], odd[i]}, odd[(i + 4) % 6]};\n            CHK1(\"nan.c2CircletoCircle\", A.c2CircletoCircle(c1, c2),\n                 R.c2CircletoCircle(c1, c2), int);\n            c2Capsule cp = {{odd[i], 1.0f}, {2.0f, odd[(i + 1) % 6]}, odd[(i + 2) % 6]};\n            CHK1(\"nan.c2CircletoCapsule\", A.c2CircletoCapsule(c1, cp),\n                 R.c2CircletoCapsule(c1, cp), int);\n            c2AABB ab = {{odd[i], -1.0f}, {1.0f, odd[(i + 1) % 6]}};\n            CHK1(\"nan.c2CircletoAABB\", A.c2CircletoAABB(c1, ab), R.c2CircletoAABB(c1, ab), int);\n            CHK1(\"nan.c2AABBtoAABB\", A.c2AABBtoAABB(ab, ab), R.c2AABBtoAABB(ab, ab), int);\n            CHK1(\"nan.c2AABBtoCapsule\", A.c2AABBtoCapsule(ab, cp), R.c2AABBtoCapsule(ab, cp), int);\n            CHK1(\"nan.c2CapsuletoCapsule\", A.c2CapsuletoCapsule(cp, cp),\n                 R.c2CapsuletoCapsule(cp, cp), int);\n        }\n    }\n\n    printf(\"checks=%lld fails=%lld\\n\", checks, fails);\n    return fails != 0 ? 1 : 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1029,"cache_read_input_tokens":49609,"cache_creation":{"ephemeral_5m