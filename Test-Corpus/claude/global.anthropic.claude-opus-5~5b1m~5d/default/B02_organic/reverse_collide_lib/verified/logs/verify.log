{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ppn34dannfkbi27ivqphsjohhs63rrpsvfcpwgw4zp4oqjx7smmq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01MuHNqjWH59XEGeHKNqhzn5","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-lBJjNJ/translation/tests/common/mod.rs","content":"//! Shared differential-test harness.\n//!\n//! BOTH libraries are loaded as shared objects through `libloading` and every call goes\n//! through `dlsym`'d function pointers — the Rust functions are never called directly, so\n//! the `#[unsafe(no_mangle)] extern \"C\"` export wrappers and the C ABI are under test too.\n\n#![allow(non_snake_case, non_camel_case_types, dead_code)]\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_void;\nuse std::path::{Path, PathBuf};\n\n// ---------------------------------------------------------------------------\n// #[repr(C)] mirrors of the C types (c_src/src/lib.c lines 4-47, 100-150)\n// ---------------------------------------------------------------------------\n\npub type C2_TYPE = u32;\npub const C2_TYPE_CIRCLE: C2_TYPE = 0;\npub const C2_TYPE_AABB: C2_TYPE = 1;\npub const C2_TYPE_CAPSULE: C2_TYPE = 2;\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2x {\n    pub p: C2v,\n    pub r: C2r,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2Circle {\n    pub p: C2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2AABB {\n    pub min: C2v,\n    pub max: C2v,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2Capsule {\n    pub a: C2v,\n    pub b: C2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2GJKCache {\n    pub metric: f32,\n    pub count: i32,\n    pub iA: [i32; 3],\n    pub iB: [i32; 3],\n    pub div: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct C2Proxy {\n    pub radius: f32,\n    pub count: i32,\n    pub verts: [C2v; 8],\n}\n\nimpl Default for C2Proxy {\n    fn default() -> Self {\n        C2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [C2v::default(); 8],\n        }\n    }\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2sv {\n    pub sA: C2v,\n    pub sB: C2v,\n    pub p: C2v,\n    pub u: f32,\n    pub iA: i32,\n    pub iB: i32,\n}\n\n/// Layout-identical to `struct { c2sv a, b, c, d; float div; int count; }`.\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2Simplex {\n    pub verts: [C2sv; 4],\n    pub div: f32,\n    pub count: i32,\n}\n\npub const FLT_MAX: f32 = 3.402_823_5e38;\npub const FLT_EPSILON: f32 = 1.192_092_9e-7;\n\n// ---------------------------------------------------------------------------\n// Function-pointer types\n// ---------------------------------------------------------------------------\n\npub type FnFF_V = extern \"C\" fn(f32, f32) -> C2v;\npub type FnVF_V = extern \"C\" fn(C2v, f32) -> C2v;\npub type FnVV_V = extern \"C\" fn(C2v, C2v) -> C2v;\npub type FnVVV_V = extern \"C\" fn(C2v, C2v, C2v) -> C2v;\npub type FnVV_F = extern \"C\" fn(C2v, C2v) -> f32;\npub type FnV_V = extern \"C\" fn(C2v) -> C2v;\npub type FnV_F = extern \"C\" fn(C2v) -> f32;\npub type Fn_R = extern \"C\" fn() -> C2r;\npub type Fn_X = extern \"C\" fn() -> C2x;\npub type FnRV_V = extern \"C\" fn(C2r, C2v) -> C2v;\npub type FnXV_V = extern \"C\" fn(C2x, C2v) -> C2v;\npub type FnBBVerts = unsafe extern \"C\" fn(*mut C2v, *mut C2AABB);\npub type FnMakeProxy = unsafe extern \"C\" fn(*const c_void, C2_TYPE, *mut C2Proxy);\npub type FnS_F = unsafe extern \"C\" fn(*mut C2Simplex) -> f32;\npub type FnS_V = unsafe extern \"C\" fn(*mut C2Simplex) -> C2v;\npub type FnS = unsafe extern \"C\" fn(*mut C2Simplex);\npub type FnSupport = unsafe extern \"C\" fn(*const C2v, i32, C2v) -> i32;\npub type FnWitness = unsafe extern \"C\" fn(*mut C2Simplex, *mut C2v, *mut C2v);\npub type FnGJK = unsafe extern \"C\" fn(\n    *const c_void,\n    C2_TYPE,\n    *const C2x,\n    *const c_void,\n    C2_TYPE,\n    *const C2x,\n    *mut C2v,\n    *mut C2v,\n    i32,\n    *mut i32,\n    *mut C2GJKCache,\n) -> f32;\npub type FnAABBAABB = extern \"C\" fn(C2AABB, C2AABB) -> i32;\npub type FnAABBCap = extern \"C\" fn(C2AABB, C2Capsule) -> i32;\npub type FnCapCap = extern \"C\" fn(C2Capsule, C2Capsule) -> i32;\npub type FnCirCir = extern \"C\" fn(C2Circle, C2Circle) -> i32;\npub type FnCirAABB = extern \"C\" fn(C2Circle, C2AABB) -> i32;\npub type FnCirCap = extern \"C\" fn(C2Circle, C2Capsule) -> i32;\npub type FnCollided = unsafe extern \"C\" fn(*const c_void, C2_TYPE, *const c_void, C2_TYPE) -> i32;\npub type FnReverse = extern \"C\" fn(f32, f32, f32) -> i32;\n\n/// The complete set of 38 exported symbols, resolved through `dlsym`.\npub struct Api {\n    pub label: &'static str,\n    pub path: PathBuf,\n    _lib: Library,\n\n    pub c2V: FnFF_V,\n    pub c2Mulvs: FnVF_V,\n    pub c2Maxv: FnVV_V,\n    pub c2Minv: FnVV_V,\n    pub c2Clampv: FnVVV_V,\n    pub c2Sub: FnVV_V,\n    pub c2Dot: FnVV_F,\n    pub c2RotIdentity: Fn_R,\n    pub c2xIdentity: Fn_X,\n    pub c2BBVerts: FnBBVerts,\n    pub c2MakeProxy: FnMakeProxy,\n    pub c2Len: FnV_F,\n    pub c2Det2: FnVV_F,\n    pub c2GJKSimplexMetric: FnS_F,\n    pub c2Mulrv: FnRV_V,\n    pub c2Add: FnVV_V,\n    pub c2Mulxv: FnXV_V,\n    pub c22: FnS,\n    pub c23: FnS,\n    pub c2Neg: FnV_V,\n    pub c2Skew: FnV_V,\n    pub c2CCW90: FnV_V,\n    pub c2D: FnS_V,\n    pub c2Support: FnSupport,\n    pub c2Witness: FnWitness,\n    pub c2Div: FnVF_V,\n    pub c2Norm: FnV_V,\n    pub c2L: FnS_V,\n    pub c2MulrvT: FnRV_V,\n    pub c2GJK: FnGJK,\n    pub c2AABBtoAABB: FnAABBAABB,\n    pub c2AABBtoCapsule: FnAABBCap,\n    pub c2CapsuletoCapsule: FnCapCap,\n    pub c2CircletoCircle: FnCirCir,\n    pub c2CircletoAABB: FnCirAABB,\n    pub c2CircletoCapsule: FnCirCap,\n    pub c2Collided: FnCollided,\n    pub reverse_collide: FnReverse,\n}\n\nmacro_rules! sym {\n    ($lib:expr, $path:expr, $name:literal, $t:ty) => {{\n        let s: Symbol<$t> = match unsafe { $lib.get($name.as_bytes()) } {\n            Ok(s) => s,\n            Err(e) => panic!(\"symbol `{}` missing from {:?}: {}\", $name, $path, e),\n        };\n        *s\n    }};\n}\n\nimpl Api {\n    pub fn open(label: &'static str, path: &Path) -> Api {\n        let lib = unsafe { Library::new(path) }\n            .unwrap_or_else(|e| panic!(\"cannot dlopen {path:?}: {e}\"));\n        let p = path.to_path_buf();\n        let api = Api {\n            label,\n            path: p.clone(),\n            c2V: sym!(lib, p, \"c2V\", FnFF_V),\n            c2Mulvs: sym!(lib, p, \"c2Mulvs\", FnVF_V),\n            c2Maxv: sym!(lib, p, \"c2Maxv\", FnVV_V),\n            c2Minv: sym!(lib, p, \"c2Minv\", FnVV_V),\n            c2Clampv: sym!(lib, p, \"c2Clampv\", FnVVV_V),\n            c2Sub: sym!(lib, p, \"c2Sub\", FnVV_V),\n            c2Dot: sym!(lib, p, \"c2Dot\", FnVV_F),\n            c2RotIdentity: sym!(lib, p, \"c2RotIdentity\", Fn_R),\n            c2xIdentity: sym!(lib, p, \"c2xIdentity\", Fn_X),\n            c2BBVerts: sym!(lib, p, \"c2BBVerts\", FnBBVerts),\n            c2MakeProxy: sym!(lib, p, \"c2MakeProxy\", FnMakeProxy),\n            c2Len: sym!(lib, p, \"c2Len\", FnV_F),\n            c2Det2: sym!(lib, p, \"c2Det2\", FnVV_F),\n            c2GJKSimplexMetric: sym!(lib, p, \"c2GJKSimplexMetric\", FnS_F),\n            c2Mulrv: sym!(lib, p, \"c2Mulrv\", FnRV_V),\n            c2Add: sym!(lib, p, \"c2Add\", FnVV_V),\n            c2Mulxv: sym!(lib, p, \"c2Mulxv\", FnXV_V),\n            c22: sym!(lib, p, \"c22\", FnS),\n            c23: sym!(lib, p, \"c23\", FnS),\n            c2Neg: sym!(lib, p, \"c2Neg\", FnV_V),\n            c2Skew: sym!(lib, p, \"c2Skew\", FnV_V),\n            c2CCW90: sym!(lib, p, \"c2CCW90\", FnV_V),\n            c2D: sym!(lib, p, \"c2D\", FnS_V),\n            c2Support: sym!(lib, p, \"c2Support\", FnSupport),\n            c2Witness: sym!(lib, p, \"c2Witness\", FnWitness),\n            c2Div: sym!(lib, p, \"c2Div\", FnVF_V),\n            c2Norm: sym!(lib, p, \"c2Norm\", FnV_V),\n            c2L: sym!(lib, p, \"c2L\", FnS_V),\n            c2MulrvT: sym!(lib, p, \"c2MulrvT\", FnRV_V),\n            c2GJK: sym!(lib, p, \"c2GJK\", FnGJK),\n            c2AABBtoAABB: sym!(lib, p, \"c2AABBtoAABB\", FnAABBAABB),\n            c2AABBtoCapsule: sym!(lib, p, \"c2AABBtoCapsule\", FnAABBCap),\n            c2CapsuletoCapsule: sym!(lib, p, \"c2CapsuletoCapsule\", FnCapCap),\n            c2CircletoCircle: sym!(lib, p, \"c2CircletoCircle\", FnCirCir),\n            c2CircletoAABB: sym!(lib, p, \"c2CircletoAABB\", FnCirAABB),\n            c2CircletoCapsule: sym!(lib, p, \"c2CircletoCapsule\", FnCirCap),\n            c2Collided: sym!(lib, p, \"c2Collided\", FnCollided),\n            reverse_collide: sym!(lib, p, \"reverse_collide\", FnReverse),\n            _lib: lib,\n        };\n        api\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Library discovery\n// ---------------------------------------------------------------------------\n\nfn manifest_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\npub fn c_so_path() -> PathBuf {\n    if let Ok(p) = std::env::var(\"C2_C_SO\") {\n        return PathBuf::from(p);\n    }\n    let build = manifest_dir().join(\"..\").join(\"c_src\").join(\"build\");\n    let mut found: Vec<PathBuf> = Vec::new();\n    if let Ok(rd) = std::fs::read_dir(&build) {\n        for e in rd.flatten() {\n            let p = e.path();\n            if p.extension().map(|x| x == \"so\").unwrap_or(false) {\n                found.push(p);\n            }\n        }\n    }\n    found.sort();\n    found.into_iter().next().unwrap_or_else(|| {\n        panic!(\n            \"no C .so found in {build:?}; build it with:\\n  \\\n             cd c_src && mkdir -p build && cd build && \\\n             cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\"\n        )\n    })\n}\n\npub fn rust_so_path() -> PathBuf {\n    if let Ok(p) = std::env::var(\"C2_RUST_SO\") {\n        return PathBuf::from(p);\n    }\n    let name = \"libreverse_collide_lib.so\";\n    for profile in [\"release\", \"debug\"] {\n        let p = manifest_dir().join(\"target\").join(profile).join(name);\n        if p.is_file() {\n            return p;\n        }\n    }\n    panic!(\n        \"no Rust cdylib found; build it with `cargo build --release` \\\n         (or set C2_RUST_SO)\"\n    )\n}\n\n/// The two libraries under test, loaded once per test binary.\npub struct Pair {\n    pub c: Api,\n    pub r: Api,\n}\n\npub fn load() -> Pair {\n    Pair {\n        c: Api::open(\"C\", &c_so_path()),\n        r: Api::open(\"RUST\", &rust_so_path()),\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Bit-exact comparison helpers\n// ---------------------------------------------------------------------------\n\npub fn f32_bits(x: f32) -> u32 {\n    x.to_bits()\n}\n\n/// Bit-exact f32 comparison (so `NaN == NaN` and `+0.0 != -0.0`).\n#[track_caller]\npub fn eq_f32(what: &str, ctx: &str, c: f32, r: f32) {\n    if c.to_bits() != r.to_bits() {\n        panic!(\n            \"{what}: C != RUST\\n  ctx : {ctx}\\n  C   : {c:?} (bits {:#010x})\\n  RUST: {r:?} (bits {:#010x})\",\n            c.to_bits(),\n            r.to_bits()\n        );\n    }\n}\n\n#[track_caller]\npub fn eq_i32(what: &str, ctx: &str, c: i32, r: i32) {\n    if c != r {\n        panic!(\"{what}: C != RUST\\n  ctx : {ctx}\\n  C   : {c}\\n  RUST: {r}\");\n    }\n}\n\n#[track_caller]\npub fn eq_v(what: &str, ctx: &str, c: C2v, r: C2v) {\n    if c.x.to_bits() != r.x.to_bits() || c.y.to_bits() != r.y.to_bits() {\n        panic!(\n            \"{what}: C != RUST\\n  ctx : {ctx}\\n  C   : ({:?},{:?}) bits ({:#010x},{:#010x})\\n  RUST: ({:?},{:?}) bits ({:#010x},{:#010x})\",\n            c.x,\n            c.y,\n            c.x.to_bits(),\n            c.y.to_bits(),\n            r.x,\n            r.y,\n            r.x.to_bits(),\n            r.y.to_bits()\n        );\n    }\n}\n\n#[track_caller]\npub fn eq_r(what: &str, ctx: &str, c: C2r, r: C2r) {\n    if c.c.to_bits() != r.c.to_bits() || c.s.to_bits() != r.s.to_bits() {\n        panic!(\"{what}: C != RUST\\n  ctx : {ctx}\\n  C   : {c:?}\\n  RUST: {r:?}\");\n    }\n}\n\n#[track_caller]\npub fn eq_x(what: &str, ctx: &str, c: C2x, r: C2x) {\n    eq_v(what, ctx, c.p, r.p);\n    eq_r(what, ctx, c.r, r.r);\n}\n\npub fn as_bytes<T>(t: &T) -> &[u8] {\n    unsafe { std::slice::from_raw_parts(t as *const T as *const u8, std::mem::size_of::<T>()) }\n}\n\n/// Byte-for-byte comparison of an arbitrary `#[repr(C)]` value.\n#[track_caller]\npub fn eq_bytes<T: std::fmt::Debug>(what: &str, ctx: &str, c: &T, r: &T) {\n    let cb = as_bytes(c);\n    let rb = as_bytes(r);\n    if cb != rb {\n        let off = cb.iter().zip(rb.iter()).position(|(a, b)| a != b);\n        panic!(\n            \"{what}: C != RUST (first differing byte: {off:?})\\n  ctx : {ctx}\\n  C   : {c:#?}\\n  RUST: {r:#?}\\n  Cb  : {cb:02x?}\\n  Rb  : {rb:02x?}\"\n        );\n    }\n}\n\n#[track_caller]\npub fn eq_simplex(what: &str, ctx: &str, c: &C2Simplex, r: &C2Simplex) {\n    eq_bytes(what, ctx, c, r);\n}\n\n#[track_caller]\npub fn eq_cache(what: &str, ctx: &str, c: &C2GJKCache, r: &C2GJKCache) {\n    eq_bytes(what, ctx, c, r);\n}\n\n// ---------------------------------------------------------------------------\n// Deterministic RNG (xorshift64* — no external crates, fixed seed)\n// ---------------------------------------------------------------------------\n\npub struct Rng(u64);\n\nimpl Rng {\n    pub fn new(seed: u64) -> Rng {\n        Rng(seed | 1)\n    }\n\n    #[inline]\n    pub fn next_u64(&mut self) -> u64 {\n        let mut x = self.0;\n        x ^= x >> 12;\n        x ^= x << 25;\n        x ^= x >> 27;\n        self.0 = x;\n        x.wrapping_mul(0x2545_F491_4F6C_DD1D)\n    }\n\n    #[inline]\n    pub fn next_u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n\n    #[inline]\n    pub fn below(&mut self, n: u32) -> u32 {\n        self.next_u32() % n\n    }\n\n    /// Uniform in `[0,1)`.\n    #[inline]\n    pub fn unit(&mut self) -> f32 {\n        (self.next_u32() >> 8) as f32 / (1u32 << 24) as f32\n    }\n\n    /// Uniform in `[lo,hi)`.\n    #[inline]\n    pub fn range(&mut self, lo: f32, hi: f32) -> f32 {\n        lo + self.unit() * (hi - lo)\n    }\n\n    /// A \"geometric\" coordinate: mostly modest values, occasionally extreme.\n    pub fn coord(&mut self) -> f32 {\n        match self.below(16) {\n            0 => 0.0,\n            1 => -0.0,\n            2 => self.range(-1.0e-6, 1.0e-6),\n            3 => self.range(-1.0e6, 1.0e6),\n            4 => (self.below(41) as f32) - 20.0, // integral values -> exact ties\n            5 => self.range(-1.0e20, 1.0e20),\n            _ => self.range(-100.0, 100.0),\n        }\n    }\n\n    /// A \"geometric\" radius: mostly non-negative, occasionally 0 / negative / huge.\n    pub fn radius(&mut self) -> f32 {\n        match self.below(16) {\n            0 => 0.0,\n            1 => -0.0,\n            2 => -self.range(0.0, 50.0),\n            3 => self.range(0.0, 1.0e-6),\n            4 => self.range(0.0, 1.0e12),\n            5 => (self.below(21) as f32),\n            _ => self.range(0.0, 50.0),\n        }\n    }\n\n    /// The full mixed pool: normal, ±0, subnormal, huge, ±inf, NaN, plus raw bit patterns.\n    pub fn mixed(&mut self) -> f32 {\n        match self.below(24) {\n            0 => 0.0,\n            1 => -0.0,\n            2 => f32::INFINITY,\n            3 => f32::NEG_INFINITY,\n            4 => f32::NAN,\n            5 => f32::from_bits(0xFFC0_0000), // -NaN\n            6 => f32::from_bits(0x7FC0_1234), // NaN with payload\n            7 => f32::MAX,\n            8 => f32::MIN,\n            9 => f32::MIN_POSITIVE,\n            10 => -f32::MIN_POSITIVE,\n            11 => f32::from_bits(1), // smallest subnormal\n            12 => f32::from_bits(0x8000_0001),\n            13 => 1.0,\n            14 => -1.0,\n            15 => f32::from_bits(self.next_u32()), // arbitrary bit pattern\n            16 => f32::from_bits(self.next_u32()),\n            _ => self.coord(),\n        }\n    }\n\n    pub fn v_mixed(&mut self) -> C2v {\n        C2v {\n            x: self.mixed(),\n            y: self.mixed(),\n        }\n    }\n\n    pub fn v(&mut self) -> C2v {\n        C2v {\n            x: self.coord(),\n            y: self.coord(),\n        }\n    }\n\n    /// A rotation: identity, a unit rotation, or a non-unit (shearing) `c2r`.\n    pub fn rot(&mut self) -> C2r {\n        match self.below(8) {\n            0 => C2r { c: 1.0, s: 0.0 },\n            1 => C2r { c: -1.0, s: 0.0 },\n            2 | 3 | 4 => {\n                let t = self.range(-3.2, 3.2);\n                C2r {\n                    c: t.cos(),\n                    s: t.sin(),\n                }\n            }\n            5 => C2r { c: 0.0, s: 0.0 },\n            _ => C2r {\n                c: self.range(-3.0, 3.0),\n                s: self.range(-3.0, 3.0),\n            },\n        }\n    }\n\n    pub fn x(&mut self) -> C2x {\n        C2x {\n            p: self.v(),\n            r: self.rot(),\n        }\n    }\n\n    pub fn circle(&mut self) -> C2Circle {\n        C2Circle {\n            p: self.v(),\n            r: self.radius(),\n        }\n    }\n\n    pub fn aabb(&mut self) -> C2AABB {\n        let a = self.v();\n        let b = self.v();\n        match self.below(8) {\n            // inverted box\n            0 => C2AABB { min: b, max: a },\n            // zero-extent box\n            1 => C2AABB { min: a, max: a },\n            _ => C2AABB {\n                min: C2v {\n                    x: a.x.min(b.x),\n                    y: a.y.min(b.y),\n                },\n                max: C2v {\n                    x: a.x.max(b.x),\n                    y: a.y.max(b.y),\n                },\n            },\n        }\n    }\n\n    pub fn capsule(&mut self) -> C2Capsule {\n        let a = self.v();\n        let b = if self.below(8) == 0 { a } else { self.v() };\n        C2Capsule {\n            a,\n            b,\n            r: self.radius(),\n        }\n    }\n\n    pub fn sv(&mut self) -> C2sv {\n        C2sv {\n            sA: self.v(),\n            sB: self.v(),\n            p: self.v(),\n            u: self.coord(),\n            iA: self.below(8) as i32,\n            iB: self.below(8) as i32,\n        }\n    }\n\n    /// A fully random simplex with the given `count`; `div` from the mixed pool.\n    pub fn simplex(&mut self, count: i32) -> C2Simplex {\n        C2Simplex {\n            verts: [self.sv(), self.sv(), self.sv(), self.sv()],\n            div: match self.below(8) {\n                0 => 1.0,\n                1 => 0.0,\n                2 => self.coord(),\n                _ => self.range(0.01, 100.0),\n            },\n            count,\n        }\n    }\n}\n\n/// The three shape kinds, as an untyped blob + type tag, for driving `c2GJK`/`c2Collided`.\n#[derive(Clone, Copy, Debug)]\npub enum Shape {\n    Circle(C2Circle),\n    Aabb(C2AABB),\n    Capsule(C2Capsule),\n}\n\nimpl Shape {\n    pub fn ty(&self) -> C2_TYPE {\n        match self {\n            Shape::Circle(_) => C2_TYPE_CIRCLE,\n            Shape::Aabb(_) => C2_TYPE_AABB,\n            Shape::Capsule(_) => C2_TYPE_CAPSULE,\n        }\n    }\n    pub fn ptr(&self) -> *const c_void {\n        match self {\n            Shape::Circle(c) => c as *const C2Circle as *const c_void,\n            Shape::Aabb(b) => b as *const C2AABB as *const c_void,\n            Shape::Capsule(c) => c as *const C2Capsule as *const c_void,\n        }\n    }\n}\n\npub fn rand_shape(rng: &mut Rng, ty: C2_TYPE) -> Shape {\n    match ty {\n        C2_TYPE_CIRCLE => Shape::Circle(rng.circle()),\n        C2_TYPE_AABB => Shape::Aabb(rng.aabb()),\n        _ => Shape::Capsule(rng.capsule()),\n    }\n}\n\npub const ALL_TYPES: [C2_TYPE; 3] = [C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE];\n\npub fn ty_name(t: C2_TYPE) -> &'static str {\n    match t {\n        C2_TYPE_CIRCLE => \"CIRCLE\",\n        C2_TYPE_AABB => \"AABB\",\n        C2_TYPE_CAPSULE => \"CAPSULE\",\n        _ => \"INVALID\",\n    }\n}\n\n/// Full result of one `c2GJK` invocation, for differential comparison.\n#[derive(Clone, Copy, Debug, Default)]\npub struct GjkOut {\n    pub dist: f32,\n    pub outA: C2v,\n    pub outB: C2v,\n    pub iterations: i32,\n    pub cache: C2GJKCache,\n    pub wrote_a: bool,\n    pub wrote_b: bool,\n}\n\n#[allow(clippy::too_many_arguments)]\npub fn call_gjk(\n    api: &Api,\n    a: &Shape,\n    ax: Option<&C2x>,\n    b: &Shape,\n    bx: Option<&C2x>,\n    use_radius: i32,\n    want_a: bool,\n    want_b: bool,\n    want_iter: bool,\n    cache: Option<&mut C2GJKCache>,\n) -> GjkOut {\n    // Pre-poison the outputs so \"not written\" is detectable and comparable.\n    let mut oa = C2v {\n        x: f32::from_bits(0xDEAD_BEEF),\n        y: f32::from_bits(0xDEAD_BEEE),\n    };\n    let mut ob = C2v {\n        x: f32::from_bits(0xCAFE_BABE),\n        y: f32::from_bits(0xCAFE_BABF),\n    };\n    let mut it: i32 = -12345;\n    let cache_present = cache.is_some();\n    let cache_ptr: *mut C2GJKCache = match cache {\n        Some(c) => c as *mut C2GJKCache,\n        None => std::ptr::null_mut(),\n    };\n    let dist = unsafe {\n        (api.c2GJK)(\n            a.ptr(),\n            a.ty(),\n            ax.map(|x| x as *const C2x).unwrap_or(std::ptr::null()),\n            b.ptr(),\n            b.ty(),\n            bx.map(|x| x as *const C2x).unwrap_or(std::ptr::null()),\n            if want_a {\n                &raw mut oa\n            } else {\n                std::ptr::null_mut()\n            },\n            if want_b {\n                &raw mut ob\n            } else {\n                std::ptr::null_mut()\n            },\n            use_radius,\n            if want_iter {\n                &raw mut it\n            } else {\n                std::ptr::null_mut()\n            },\n            cache_ptr,\n        )\n    };\n    GjkOut {\n        dist,\n        outA: oa,\n        outB: ob,\n        iterations: it,\n        cache: if cache_present {\n            unsafe { *cache_ptr }\n        } else {\n            C2GJKCache::default()\n        },\n        wrote_a: want_a,\n        wrote_b: want_b,\n    }\n}\n\n#[track_caller]\npub fn eq_gjk(ctx: &str, c: &GjkOut, r: &GjkOut) {\n    eq_f32(\"c2GJK dist\", ctx, c.dist, r.dist);\n    eq_v(\"c2GJK outA\", ctx, c.outA, r.outA);\n    eq_v(\"c2GJK outB\", ctx, c.outB, r.outB);\n    eq_i32(\"c2GJK iterations\", ctx, c.iterations, r.iterations);\n    eq_cache(\"c2GJK cache\", ctx, &c.cache, &r.cache);\n}\n\npub fn shape_desc(s: &Shape) -> String {\n    match s {\n        Shape::Circle(c) => format!(\"Circle{{p:({},{}),r:{}}}\", c.p.x, c.p.y, c.r),\n        Shape::Aabb(b) => format!(\n            \"AABB{{min:({},{}),max:({},{})}}\",\n            b.min.x, b.min.y, b.max.x, b.max.y\n        ),\n        Shape::Capsule(c) => format!(\n            \"Capsule{{a:({},{}),b:({},{}),r:{}}}\",\n            c.a.x, c.a.y, c.b.x, c.b.y, c.r\n        ),\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":219,"cache_read_input_tokens":85781,"cache_creation":{"ephemeral_5m_input_tokens":219,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"01a68480-bbf5-45e9-96ef-206dacf1aacc","uuid":"26147155-b30a-45ba-9b4e-47fe1eaae81b","timestamp":"2026-08-27T16:09:06.180Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MuHNqjWH59XEGeHKNqhzn5","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-lBJjNJ/translation/tests/common/mod.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"01a68480-bbf5-45e9-96ef-206dacf1aacc","uuid":"e9795841-446b-4ed6-9e01-e1d9888834bf","timestamp":"2026-08-27T16:09:06.192Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-lBJjNJ/translation/tests/common/mod.rs","content":"//! Shared differential-test harness.\n//!\n//! BOTH libraries are loaded as shared objects through `libloading` and every call goes\n//! through `dlsym`'d function pointers — the Rust functions are never called directly, so\n//! the `#[unsafe(no_mangle)] extern \"C\"` export wrappers and the C ABI are under test too.\n\n#![allow(non_snake_case, non_camel_case_types, dead_code)]\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_void;\nuse std::path::{Path, PathBuf};\n\n// ---------------------------------------------------------------------------\n// #[repr(C)] mirrors of the C types (c_src/src/lib.c lines 4-47, 100-150)\n// ---------------------------------------------------------------------------\n\npub type C2_TYPE = u32;\npub const C2_TYPE_CIRCLE: C2_TYPE = 0;\npub const C2_TYPE_AABB: C2_TYPE = 1;\npub const C2_TYPE_CAPSULE: C2_TYPE = 2;\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2x {\n    pub p: C2v,\n    pub r: C2r,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2Circle {\n    pub p: C2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2AABB {\n    pub min: C2v,\n    pub max: C2v,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2Capsule {\n    pub a: C2v,\n    pub b: C2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2GJKCache {\n    pub metric: f32,\n    pub count: i32,\n    pub iA: [i32; 3],\n    pub iB: [i32; 3],\n    pub div: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct C2Proxy {\n    pub radius: f32,\n    pub count: i32,\n    pub verts: [C2v; 8],\n}\n\nimpl Default for C2Proxy {\n    fn default() -> Self {\n        C2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [C2v::default(); 8],\n        }\n    }\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2sv {\n    pub sA: C2v,\n    pub sB: C2v,\n    pub p: C2v,\n    pub u: f32,\n    pub iA: i32,\n    pub iB: i32,\n}\n\n/// Layout-identical to `struct { c2sv a, b, c, d; float div; int count; }`.\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct C2Simplex {\n    pub verts: [C2sv; 4],\n    pub div: f32,\n    pub count: i32,\n}\n\npub const FLT_MAX: f32 = 3.402_823_5e38;\npub const FLT_EPSILON: f32 = 1.192_092_9e-7;\n\n// ---------------------------------------------------------------------------\n// Function-pointer types\n// ---------------------------------------------------------------------------\n\npub type FnFF_V = extern \"C\" fn(f32, f32) -> C2v;\npub type FnVF_V = extern \"C\" fn(C2v, f32) -> C2v;\npub type FnVV_V = extern \"C\" fn(C2v, C2v) -> C2v;\npub type FnVVV_V = extern \"C\" fn(C2v, C2v, C2v) -> C2v;\npub type FnVV_F = extern \"C\" fn(C2v, C2v) -> f32;\npub type FnV_V = extern \"C\" fn(C2v) -> C2v;\npub type FnV_F = extern \"C\" fn(C2v) -> f32;\npub type Fn_R = extern \"C\" fn() -> C2r;\npub type Fn_X = extern \"C\" fn() -> C2x;\npub type FnRV_V = extern \"C\" fn(C2r, C2v) -> C2v;\npub type FnXV_V = extern \"C\" fn(C2x, C2v) -> C2v;\npub type FnBBVerts = unsafe extern \"C\" fn(*mut C2v, *mut C2AABB);\npub type FnMakeProxy = unsafe extern \"C\" fn(*const c_void, C2_TYPE, *mut C2Proxy);\npub type FnS_F = unsafe extern \"C\" fn(*mut C2Simplex) -> f32;\npub type FnS_V = unsafe extern \"C\" fn(*mut C2Simplex) -> C2v;\npub type FnS = unsafe extern \"C\" fn(*mut C2Simplex);\npub type FnSupport = unsafe extern \"C\" fn(*const C2v, i32, C2v) -> i32;\npub type FnWitness = unsafe extern \"C\" fn(*mut C2Simplex, *mut C2v, *mut C2v);\npub type FnGJK = unsafe extern \"C\" fn(\n    *const c_void,\n    C2_TYPE,\n    *const C2x,\n    *const c_void,\n    C2_TYPE,\n    *const C2x,\n    *mut C2v,\n    *mut C2v,\n    i32,\n    *mut i32,\n    *mut C2GJKCache,\n) -> f32;\npub type FnAABBAABB = extern \"C\" fn(C2AABB, C2AABB) -> i32;\npub type FnAABBCap = extern \"C\" fn(C2AABB, C2Capsule) -> i32;\npub type FnCapCap = extern \"C\" fn(C2Capsule, C2Capsule) -> i32;\npub type FnCirCir = extern \"C\" fn(C2Circle, C2Circle) -> i32;\npub type FnCirAABB = extern \"C\" fn(C2Circle, C2AABB) -> i32;\npub type FnCirCap = extern \"C\" fn(C2Circle, C2Capsule) -> i32;\npub type FnCollided = unsafe extern \"C\" fn(*const c_void, C2_TYPE, *const c_void, C2_TYPE) -> i32;\npub type FnReverse = extern \"C\" fn(f32, f32, f32) -> i32;\n\n/// The complete set of 38 exported symbols, resolved through `dlsym`.\npub struct Api {\n    pub label: &'static str,\n    pub path: PathBuf,\n    _lib: Library,\n\n    pub c2V: FnFF_V,\n    pub c2Mulvs: FnVF_V,\n    pub c2Maxv: FnVV_V,\n    pub c2Minv: FnVV_V,\n    pub c2Clampv: FnVVV_V,\n    pub c2Sub: FnVV_V,\n    pub c2Dot: FnVV_F,\n    pub c2RotIdentity: Fn_R,\n    pub c2xIdentity: Fn_X,\n    pub c2BBVerts: FnBBVerts,\n    pub c2MakeProxy: FnMakeProxy,\n    pub c2Len: FnV_F,\n    pub c2Det2: FnVV_F,\n    pub c2GJKSimplexMetric: FnS_F,\n    pub c2Mulrv: FnRV_V,\n    pub c2Add: FnVV_V,\n    pub c2Mulxv: FnXV_V,\n    pub c22: FnS,\n    pub c23: FnS,\n    pub c2Neg: FnV_V,\n    pub c2Skew: FnV_V,\n    pub c2CCW90: FnV_V,\n    pub c2D: FnS_V,\n    pub c2Support: FnSupport,\n    pub c2Witness: FnWitness,\n    pub c2Div: FnVF_V,\n    pub c2Norm: FnV_V,\n    pub c2L: FnS_V,\n    pub c2MulrvT: FnRV_V,\n    pub c2GJK: FnGJK,\n    pub c2AABBtoAABB: FnAABBAABB,\n    pub c2AABBtoCapsule: FnAABBCap,\n    pub c2CapsuletoCapsule: FnCapCap,\n    pub c2CircletoCircle: FnCirCir,\n    pub c2CircletoAABB: FnCirAABB,\n    pub c2CircletoCapsule: FnCirCap,\n    pub c2Collided: FnCollided,\n    pub reverse_collide: FnReverse,\n}\n\nmacro_rules! sym {\n    ($lib:expr, $path:expr, $name:literal, $t:ty) => {{\n        let s: Symbol<$t> = match unsafe { $lib.get($name.as_bytes()) } {\n            Ok(s) => s,\n            Err(e) => panic!(\"symbol `{}` missing from {:?}: {}\", $name, $path, e),\n        };\n        *s\n    }};\n}\n\nimpl Api {\n    pub fn open(label: &'static str, path: &Path) -> Api {\n        let lib = unsafe { Library::new(path) }\n            .unwrap_or_else(|e| panic!(\"cannot dlopen {path:?}: {e}\"));\n        let p = path.to_path_buf();\n        let api = Api {\n            label,\n            path: p.clone(),\n            c2V: sym!(lib, p, \"c2V\", FnFF_V),\n            c2Mulvs: sym!(lib, p, \"c2Mulvs\", FnVF_V),\n            c2Maxv: sym!(lib, p, \"c2Maxv\", FnVV_V),\n            c2Minv: sym!(lib, p, \"c2Minv\", FnVV_V),\n            c2Clampv: sym!(lib, p, \"c2Clampv\", FnVVV_V),\n            c2Sub: sym!(lib, p, \"c2Sub\", FnVV_V),\n            c2Dot: sym!(lib, p, \"c2Dot\", FnVV_F),\n            c2RotIdentity: sym!(lib, p, \"c2RotIdentity\", Fn_R),\n            c2xIdentity: sym!(lib, p, \"c2xIdentity\", Fn_X),\n            c2BBVerts: sym!(lib, p, \"c2BBVerts\", FnBBVerts),\n            c2MakeProxy: sym!(lib, p, \"c2MakeProxy\", FnMakeProxy),\n            c2Len: sym!(lib, p, \"c2Len\", FnV_F),\n            c2Det2: sym!(lib, p, \"c2Det2\", FnVV_F),\n            c2GJKSimplexMetric: sym!(lib, p, \"c2GJKSimplexMetric\", FnS_F),\n            c2Mulrv: sym!(lib, p, \"c2Mulrv\", FnRV_V),\n            c2Add: sym!(lib, p, \"c2Add\", FnVV_V),\n            c2Mulxv: sym!(lib, p, \"c2Mulxv\", FnXV_V),\n            c22: sym!(lib, p, \"c22\", FnS),\n            c23: sym!(lib, p, \"c23\", FnS),\n            c2Neg: sym!(lib, p, \"c2Neg\", FnV_V),\n            c2Skew: sym!(lib, p, \"c2Skew\", FnV_V),\n            c2CCW90: sym!(lib, p, \"c2CCW90\", FnV_V),\n            c2D: sym!(lib, p, \"c2D\", FnS_V),\n            c2Support: sym!(lib, p, \"c2Support\", FnSupport),\n            c2Witness: sym!(lib, p, \"c2Witness\", FnWitness),\n            c2Div: sym!(lib, p, \"c2Div\", FnVF_V),\n            c2Norm: sym!(lib, p, \"c2Norm\", FnV_V),\n            c2L: sym!(lib, p, \"c2L\", FnS_V),\n            c2MulrvT: sym!(lib, p, \"c2MulrvT\", FnRV_V),\n            c2GJK: sym!(lib, p, \"c2GJK\", FnGJK),\n            c2AABBtoAABB: sym!(lib, p, \"c2AABBtoAABB\", FnAABBAABB),\n            c2AABBtoCapsule: sym!(lib, p, \"c2AABBtoCapsule\", FnAABBCap),\n            c2CapsuletoCapsule: sym!(lib, p, \"c2CapsuletoCapsule\", FnCapCap),\n            c2CircletoCircle: sym!(lib, p, \"c2CircletoCircle\", FnCirCir),\n            c2CircletoAABB: sym!(lib, p, \"c2CircletoAABB\", FnCirAABB),\n            c2CircletoCapsule: sym!(lib, p, \"c2CircletoCapsule\", FnCirCap),\n            c2Collided: sym!(lib, p, \"c2Collided\", FnCollided),\n            reverse_collide: sym!(lib, p, \"reverse_collide\", FnReverse),\n            _lib: lib,\n        };\n        api\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Library discovery\n// ---------------------------------------------------------------------------\n\nfn manifest_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\npub fn c_so_path() -> PathBuf {\n    if let Ok(p) = std::env::var(\"C2_C_SO\") {\n        return PathBuf::from(p);\n    }\n    let build = manifest_dir().join(\"..\").join(\"c_src\").join(\"build\");\n    let mut found: Vec<PathBuf> = Vec::new();\n    if let Ok(rd) = std::fs::read_dir(&build) {\n        for e in rd.flatten() {\n            let p = e.path();\n            if p.extension().map(|x| x == \"so\").unwrap_or(false) {\n                found.push(p);\n            }\n        }\n    }\n    found.sort();\n    found.into_iter().next().unwrap_or_else(|| {\n        panic!(\n            \"no C .so found in {build:?}; build it with:\\n  \\\n             cd c_src && mkdir -p build && cd build && \\\n             cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\"\n        )\n    })\n}\n\npub fn rust_so_path() -> PathBuf {\n    if let Ok(p) = std::env::var(\"C2_RUST_SO\") {\n        return PathBuf::from(p);\n    }\n    let name = \"libreverse_collide_lib.so\";\n    for profile in [\"release\", \"debug\"] {\n        let p = manifest_dir().join(\"target\").join(profile).join(name);\n        if p.is_file() {\n            return p;\n        }\n    }\n    panic!(\n        \"no Rust cdylib found; build it with `cargo build --release` \\\n         (or set C2_RUST_SO)\"\n    )\n}\n\n/// The two libraries under test, loaded once per test binary.\npub struct Pair {\n    pub c: Api,\n    pub r: Api,\n}\n\npub fn load() -> Pair {\n    Pair {\n        c: Api::open(\"C\", &c_so_path()),\n        r: Api::open(\"RUST\", &rust_so_path()),\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Bit-exact comparison helpers\n// ---------------------------------------------------------------------------\n\npub fn f32_bits(x: f32) -> u32 {\n    x.to_bits()\n}\n\n/// Bit-exact f32 comparison (so `NaN == NaN` and `+0.0 != -0.0`).\n#[track_caller]\npub fn eq_f32(what: &str, ctx: &str, c: f32, r: f32) {\n    if c.to_bits() != r.to_bits() {\n        panic!(\n            \"{what}: C != RUST\\n  ctx : {ctx}\\n  C   : {c:?} (bits {:#010x})\\n  RUST: {r:?} (bits {:#010x})\",\n            c.to_bits(),\n            r.to_bits()\n        );\n    }\n}\n\n#[track_caller]\npub fn eq_i32(what: &str, ctx: &str, c: i32, r: i32) {\n    if c != r {\n        panic!(\"{what}: C != RUST\\n  ctx : {ctx}\\n  C   : {c}\\n  RUST: {r}\");\n    }\n}\n\n#[track_caller]\npub fn eq_v(what: &str, ctx: &str, c: C2v, r: C2v) {\n    if c.x.to_bits() != r.x.to_bits() || c.y.to_bits() != r.y.to_bits() {\n        panic!(\n            \"{what}: C != RUST\\n  ctx : {ctx}\\n  C   : ({:?},{:?}) bits ({:#010x},{:#010x})\\n  RUST: ({:?},{:?}) bits ({:#010x},{:#010x})\",\n            c.x,\n            c.y,\n            c.x.to_bits(),\n            c.y.to_bits(),\n            r.x,\n            r.y,\n            r.x.to_bits(),\n            r.y.to_bits()\n        );\n    }\n}\n\n#[track_caller]\npub fn eq_r(what: &str, ctx: &str, c: C2r, r: C2r) {\n    if c.c.to_bits() != r.c.to_bits() || c.s.to_bits() != r.s.to_bits() {\n        panic!(\"{what}: C != RUST\\n  ctx : {ctx}\\n  C   : {c:?}\\n  RUST: {r:?}\");\n    }\n}\n\n#[track_caller]\npub fn eq_x(what: &str, ctx: &str, c: C2x, r: C2x) {\n    eq_v(what, ctx, c.p, r.p);\n    eq_r(what, ctx, c.r, r.r);\n}\n\npub fn as_bytes<T>(t: &T) -> &[u8] {\n    unsafe { std::slice::from_raw_parts(t as *const T as *const u8, std::mem::size_of::<T>()) }\n}\n\n/// Byte-for-byte comparison of an arbitrary `#[repr(C)]` value.\n#[track_caller]\npub fn eq_bytes<T: std::fmt::Debug>(what: &str, ctx: &str, c: &T, r: &T) {\n    let cb = as_bytes(c);\n    let rb = as_bytes(r);\n    if cb != rb {\n        let off = cb.iter().zip(rb.iter()).position(|(a, b)| a != b);\n        panic!(\n            \"{what}: C != RUST (first differing byte: {off:?})\\n  ctx : {ctx}\\n  C   : {c:#?}\\n  RUST: {r:#?}\\n  Cb  : {cb:02x?}\\n  Rb  : {rb:02x?}\"\n        );\n    }\n}\n\n#[track_caller]\npub fn eq_simplex(what: &str, ctx: &str, c: &C2Simplex, r: &C2Simplex) {\n    eq_bytes(what, ctx, c, r);\n}\n\n#[track_caller]\npub fn eq_cache(what: &str, ctx: &str, c: &C2GJKCache, r: &C2GJKCache) {\n    eq_bytes(what, ctx, c, r);\n}\n\n// ---------------------------------------------------------------------------\n// Deterministic RNG (xorshift64* — no external crates, fixed seed)\n// ---------------------------------------------------------------------------\n\npub struct Rng(u64);\n\nimpl Rng {\n    pub fn new(seed: u64) -> Rng {\n        Rng(seed | 1)\n    }\n\n    #[inline]\n    pub fn next_u64(&mut self) -> u64 {\n        let mut x = self.0;\n        x ^= x >> 12;\n        x ^= x << 25;\n        x ^= x >> 27;\n        self.0 = x;\n        x.wrapping_mul(0x2545_F491_4F6C_DD1D)\n    }\n\n    #[inline]\n    pub fn next_u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n\n    #[inline]\n    pub fn below(&mut self, n: u32) -> u32 {\n        self.next_u32() % n\n    }\n\n    /// Uniform in `[0,1)`.\n    #[inline]\n    pub fn unit(&mut self) -> f32 {\n        (self.next_u32() >> 8) as f32 / (1u32 << 24) as f32\n    }\n\n    /// Uniform in `[lo,hi)`.\n    #[inline]\n    pub fn range(&mut self, lo: f32, hi: f32) -> f32 {\n        lo + self.unit() * (hi - lo)\n    }\n\n    /// A \"geometric\" coordinate: mostly modest values, occasionally extreme.\n    pub fn coord(&mut self) -> f32 {\n        match self.below(16) {\n            0 => 0.0,\n            1 => -0.0,\n            2 => self.range(-1.0e-6, 1.0e-6),\n            3 => self.range(-1.0e6, 1.0e6),\n            4 => (self.below(41) as f32) - 20.0, // integral values -> exact ties\n            5 => self.range(-1.0e20, 1.0e20),\n            _ => self.range(-100.0, 100.0),\n        }\n    }\n\n    /// A \"geometric\" radius: mostly non-negative, occasionally 0 / negative / huge.\n    pub fn radius(&mut self) -> f32 {\n        match self.below(16) {\n            0 => 0.0,\n            1 => -0.0,\n            2 => -self.range(0.0, 50.0),\n            3 => self.range(0.0, 1.0e-6),\n            4 => self.range(0.0, 1.0e12),\n            5 => (self.below(21) as f32),\n            _ => self.range(0.0, 50.0),\n        }\n    }\n\n    /// The full mixed pool: normal, ±0, subnormal, huge, ±inf, NaN, plus raw bit patterns.\n    pub fn mixed(&mut self) -> f32 {\n        match self.below(24) {\n            0 => 0.0,\n            1 => -0.0,\n            2 => f32::INFINITY,\n            3 => f32::NEG_INFINITY,\n            4 => f32::NAN,\n            5 => f32::from_bits(0xFFC0_0000), // -NaN\n            6 => f32::from_bits(0x7FC0_1234), // NaN with payload\n            7 => f32::MAX,\n            8 => f32::MIN,\n            9 => f32::MIN_POSITIVE,\n            10 => -f32::MIN_POSITIVE,\n            11 => f32::from_bits(1), // smallest subnormal\n            12 => f32::from_bits(0x8000_0001),\n            13 => 1.0,\n            14 => -1.0,\n            15 => f32::from_bits(self.next_u32()), // arbitrary bit pattern\n            16 => f32::from_bits(self.next_u32()),\n            _ => self.coord(),\n        }\n    }\n\n    pub fn v_mixed(&mut self) -> C2v {\n        C2v {\n            x: self.mixed(),\n            y: self.mixed(),\n        }\n    }\n\n    pub fn v(&mut self) -> C2v {\n        C2v {\n            x: self.coord(),\n            y: self.coord(),\n        }\n    }\n\n    /// A rotation: identity, a unit rotation, or a non-unit (shearing) `c2r`.\n    pub fn rot(&mut self) -> C2r {\n        match self.below(8) {\n            0 => C2r { c: 1.0, s: 0.0 },\n            1 => C2r { c: -1.0, s: 0.0 },\n            2 | 3 | 4 => {\n                let t = self.range(-3.2, 3.2);\n                C2r {\n                    c: t.cos(),\n                    s: t.sin(),\n                }\n            }\n            5 => C2r { c: 0.0, s: 0.0 },\n            _ => C2r {\n                c: self.range(-3.0, 3.0),\n                s: self.range(-3.0, 3.0),\n            },\n        }\n    }\n\n    pub fn x(&mut self) -> C2x {\n        C2x {\n            p: self.v(),\n            r: self.rot(),\n        }\n    }\n\n    pub fn circle(&mut self) -> C2Circle {\n        C2Circle {\n            p: self.v(),\n            r: self.radius(),\n        }\n    }\n\n    pub fn aabb(&mut self) -> C2AABB {\n        let a = self.v();\n        let b = self.v();\n        match self.below(8) {\n            // inverted box\n            0 => C2AABB { min: b, max: a },\n            // zero-extent box\n            1 => C2AABB { min: a, max: a },\n            _ => C2AABB {\n                min: C2v {\n                    x: a.x.min(b.x),\n                    y: a.y.min(b.y),\n                },\n                max: C2v {\n                    x: a.x.max(b.x),\n                    y: a.y.max(b.y),\n                },\n            },\n        }\n    }\n\n    pub fn capsule(&mut self) -> C2Capsule {\n        let a = self.v();\n        let b = if self.below(8) == 0 { a } else { self.v() };\n        C2Capsule {\n            a,\n            b,\n            r: self.radius(),\n        }\n    }\n\n    pub fn sv(&mut self) -> C2sv {\n        C2sv {\n            sA: self.v(),\n            sB: self.v(),\n            p: self.v(),\n            u: self.coord(),\n            iA: self.below(8) as i32,\n            iB: self.below(8) as i32,\n        }\n    }\n\n    /// A fully random simplex with the given `count`; `div` from the mixed pool.\n    pub fn simplex(&mut self, count: i32) -> C2Simplex {\n        C2Simplex {\n            verts: [self.sv(), self.sv(), self.sv(), self.sv()],\n            div: match self.below(8) {\n                0 => 1.0,\n                1 => 0.0,\n                2 => self.coord(),\n                _ => self.range(0.01, 100.0),\n            },\n            count,\n        }\n    }\n}\n\n/// The three shape kinds, as an untyped blob + type tag, for driving `c2GJK`/`c2Collided`.\n#[derive(Clone, Copy, Debug)]\npub enum Shape {\n    Circle(C2Circle),\n    Aabb(C2AABB),\n    Capsule(C2Capsule),\n}\n\nimpl Shape {\n    pub fn ty(&self) -> C2_TYPE {\n        match self {\n            Shape::Circle(_) => C2_TYPE_CIRCLE,\n            Shape::Aabb(_) => C2_TYPE_AABB,\n            Shape::Capsule(_) => C2_TYPE_CAPSULE,\n        }\n    }\n    pub fn ptr(&self) -> *const c_void {\n        match self {\n            Shape::Circle(c) => c as *const C2Circle as *const c_void,\n            Shape::Aabb(b) => b as *const C2AABB as *const c_void,\n            Shape::Capsule(c) => c as *const C2Capsule as *const c_void,\n        }\n    }\n}\n\npub fn rand_shape(rng: &mut Rng, ty: C2_TYPE) -> Shape {\n    match ty {\n        C2_TYPE_CIRCLE => Shape::Circle(rng.circle()),\n        C2_TYPE_AABB => Shape::Aabb(rng.aabb()),\n        _ => Shape::Capsule(rng.capsule()),\n    }\n}\n\npub const ALL_TYPES: [C2_TYPE; 3] = [C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE];\n\npub fn ty_name(t: C2_TYPE) -> &'static str {\n    match t {\n        C2_TYPE_CIRCLE => \"CIRCLE\",\n        C2_TYPE_AABB => \"AABB\",\n        C2_TYPE_CAPSULE => \"CAPSULE\",\n        _ => \"INVALID\",\n    }\n}\n\n/// Full result of one `c2GJK` invocation, for differential comparison.\n#[derive(Clone, Copy, Debug, Default)]\npub struct GjkOut {\n    pub dist: f32,\n    pub outA: C2v,\n    pub outB: C2v,\n    pub iterations: i32,\n    pub cache: C2GJKCache,\n    pub wrote_a: bool,\n    pub wrote_b: bool,\n}\n\n#[allow(clippy::too_many_arguments)]\npub fn call_gjk(\n    api: &Api,\n    a: &Shape,\n    ax: Option<&C2x>,\n    b: &Shape,\n    bx: Option<&C2x>,\n    use_radius: i32,\n    want_a: bool,\n    want_b: bool,\n    want_iter: bool,\n    cache: Option<&mut C2GJKCache>,\n) -> GjkOut {\n    // Pre-poison the outputs so \"not written\" is detectable and comparable.\n    let mut oa = C2v {\n        x: f32::from_bits(0xDEAD_BEEF),\n        y: f32::from_bits(0xDEAD_BEEE),\n    };\n    let mut ob = C2v {\n        x: f32::from_bits(0xCAFE_BABE),\n        y: f32::from_bits(0xCAFE_BABF),\n    };\n    let mut it: i32 = -12345;\n    let cache_present = cache.is_some();\n    let cache_ptr: *mut C2GJKCache = match cache {\n        Some(c) => c as *mut C2GJKCache,\n        None => std::ptr::null_mut(),\n    };\n    let dist = unsafe {\n        (api.c2GJK)(\n            a.ptr(),\n            a.ty(),\n            ax.map(|x| x as *const C2x).unwrap_or(std::ptr::null()),\n            b.ptr(),\n            b.ty(),\n            bx.map(|x| x as *const C2x).unwrap_or(std::ptr::null()),\n            if want_a {\n                &raw mut oa\n            } else {\n                std::ptr::null_mut()\n            },\n            if want_b {\n                &raw mut ob\n            } else {\n                std::ptr::null_mut()\n            },\n            use_radius,\n            if want_iter {\n                &raw mut it\n            } else {\n                std::ptr::null_mut()\n            },\n            cache_ptr,\n        )\n    };\n    GjkOut {\n        dist,\n        outA: oa,\n        outB: ob,\n        iterations: it,\n        cache: if cache_present {\n            unsafe { *cache_ptr }\n        } else {\n            C2GJKCache::default()\n        },\n        wrote_a: want_a,\n        wrote_b: want_b,\n    }\n}\n\n#[track_caller]\npub fn eq_gjk(ctx: &str, c: &GjkOut, r: &GjkOut) {\n    eq_f32(\"c2GJK dist\", ctx, c.dist, r.dist);\n    eq_v(\"c2GJK outA\", ctx, c.outA, r.outA);\n    eq_v(\"c2GJK outB\", ctx, c.outB, r.outB);\n    eq_i32(\"c2GJK iterations\", ctx, c.iterations, r.iterations);\n    eq_cache(\"c2GJK cache\", ctx, &c.cache, &r.cache);\n}\n\npub fn shape_desc(s: &Shape) -> String {\n    match s {\n        Shape::Circle(c) => format!(\"Circle{{p:({},{}),r:{}}}\", c.p.x, c.p.y, c.r),\n        Shape::Aabb(b) => format!(\n            \"AABB{{min:({},{}),max:({},{})}}\",\n            b.min.x, b.min.y, b.max.x, b.max.y\n        ),\n        Shape::Capsule(c) => format!(\n            \"Capsule{{a:({},{}),b:({},{}),r:{}}}\",\n            c.a.x, c.a.y, c.b.x, c.b.y, c.r\n        ),\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
