{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_reousphb4y5hlbaxby6xglgyfjpup54j5fkcjvgske6imrwu5kwa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_019JDxnmZjShhDDFDSpwFqQz","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-lBJjNJ/translation/tests/phase_b_lowlevel.rs","content":"//! Phase B — valid-path differential tests, lowest level first.\n//!\n//! Covers CONFIGS.md rows 1-38 (scalar/vector math, proxy construction, the simplex\n//! primitives and the simplex solvers).  Both libraries are driven exclusively through\n//! `dlsym`'d `extern \"C\"` entry points.\n\nmod common;\nuse common::*;\n\nconst N: usize = 20_000;\nconst SEED: u64 = 0x_C0FF_EE12_3456_789A;\n\n// ===========================================================================\n// Row 1 — c2V\n// ===========================================================================\n\n#[test]\nfn cfg01_c2v() {\n    let p = load();\n    let mut rng = Rng::new(SEED);\n    for i in 0..N {\n        let (x, y) = (rng.mixed(), rng.mixed());\n        eq_v(\n            \"c2V\",\n            &format!(\"#{i} x={x:?} y={y:?}\"),\n            (p.c.c2V)(x, y),\n            (p.r.c2V)(x, y),\n        );\n    }\n}\n\n// ===========================================================================\n// Row 2 — c2Mulvs, c2Div\n// ===========================================================================\n\n#[test]\nfn cfg02_c2mulvs_c2div() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 2);\n    for i in 0..N {\n        let a = rng.v_mixed();\n        let b = rng.mixed();\n        let ctx = format!(\"#{i} a=({:?},{:?}) b={b:?}\", a.x, a.y);\n        eq_v(\"c2Mulvs\", &ctx, (p.c.c2Mulvs)(a, b), (p.r.c2Mulvs)(a, b));\n        eq_v(\"c2Div\", &ctx, (p.c.c2Div)(a, b), (p.r.c2Div)(a, b));\n    }\n    // explicit zero / negative-zero divisors (ERRORS rows 15,16)\n    for b in [0.0f32, -0.0f32] {\n        for a in [\n            C2v { x: 1.0, y: -1.0 },\n            C2v { x: 0.0, y: -0.0 },\n            C2v {\n                x: f32::INFINITY,\n                y: f32::NAN,\n            },\n        ] {\n            let ctx = format!(\"explicit a=({:?},{:?}) b={b:?}\", a.x, a.y);\n            eq_v(\"c2Div\", &ctx, (p.c.c2Div)(a, b), (p.r.c2Div)(a, b));\n        }\n    }\n}\n\n// ===========================================================================\n// Row 3 — c2Add, c2Sub\n// ===========================================================================\n\n#[test]\nfn cfg03_c2add_c2sub() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 3);\n    for i in 0..N {\n        let (a, b) = (rng.v_mixed(), rng.v_mixed());\n        let ctx = format!(\"#{i} a=({:?},{:?}) b=({:?},{:?})\", a.x, a.y, b.x, b.y);\n        eq_v(\"c2Add\", &ctx, (p.c.c2Add)(a, b), (p.r.c2Add)(a, b));\n        eq_v(\"c2Sub\", &ctx, (p.c.c2Sub)(a, b), (p.r.c2Sub)(a, b));\n    }\n}\n\n// ===========================================================================\n// Row 4 — c2Dot, c2Det2\n// ===========================================================================\n\n#[test]\nfn cfg04_c2dot_c2det2() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 4);\n    for i in 0..N {\n        let (a, b) = (rng.v_mixed(), rng.v_mixed());\n        let ctx = format!(\"#{i} a=({:?},{:?}) b=({:?},{:?})\", a.x, a.y, b.x, b.y);\n        eq_f32(\"c2Dot\", &ctx, (p.c.c2Dot)(a, b), (p.r.c2Dot)(a, b));\n        eq_f32(\"c2Det2\", &ctx, (p.c.c2Det2)(a, b), (p.r.c2Det2)(a, b));\n    }\n    // Values that overflow the product to +-inf and that cancel exactly.\n    let huge = 1.0e30f32;\n    for (a, b) in [\n        (C2v { x: huge, y: huge }, C2v { x: huge, y: huge }),\n        (\n            C2v { x: huge, y: huge },\n            C2v {\n                x: huge,\n                y: -huge,\n            },\n        ),\n        (\n            C2v {\n                x: f32::MAX,\n                y: f32::MAX,\n            },\n            C2v {\n                x: f32::MAX,\n                y: -f32::MAX,\n            },\n        ),\n    ] {\n        let ctx = format!(\"overflow a=({:?},{:?}) b=({:?},{:?})\", a.x, a.y, b.x, b.y);\n        eq_f32(\"c2Dot\", &ctx, (p.c.c2Dot)(a, b), (p.r.c2Dot)(a, b));\n        eq_f32(\"c2Det2\", &ctx, (p.c.c2Det2)(a, b), (p.r.c2Det2)(a, b));\n    }\n}\n\n// ===========================================================================\n// Rows 5, 6 — c2Len, c2Norm\n// ===========================================================================\n\n#[test]\nfn cfg05_06_c2len_c2norm() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 5);\n    for i in 0..N {\n        let a = rng.v_mixed();\n        let ctx = format!(\"#{i} a=({:?},{:?})\", a.x, a.y);\n        eq_f32(\"c2Len\", &ctx, (p.c.c2Len)(a), (p.r.c2Len)(a));\n        eq_v(\"c2Norm\", &ctx, (p.c.c2Norm)(a), (p.r.c2Norm)(a));\n    }\n    for a in [\n        C2v { x: 0.0, y: 0.0 },\n        C2v { x: -0.0, y: -0.0 },\n        C2v {\n            x: f32::MAX,\n            y: f32::MAX,\n        },\n        C2v {\n            x: f32::INFINITY,\n            y: 1.0,\n        },\n        C2v {\n            x: f32::NAN,\n            y: 0.0,\n        },\n        C2v {\n            x: f32::from_bits(1),\n            y: f32::from_bits(1),\n        },\n        C2v { x: 3.0, y: 4.0 },\n    ] {\n        let ctx = format!(\"explicit a=({:?},{:?})\", a.x, a.y);\n        eq_f32(\"c2Len\", &ctx, (p.c.c2Len)(a), (p.r.c2Len)(a));\n        eq_v(\"c2Norm\", &ctx, (p.c.c2Norm)(a), (p.r.c2Norm)(a));\n    }\n}\n\n// ===========================================================================\n// Row 7 — c2Neg, c2Skew, c2CCW90\n// ===========================================================================\n\n#[test]\nfn cfg07_unary_vec_ops() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 7);\n    for i in 0..N {\n        let a = rng.v_mixed();\n        let ctx = format!(\"#{i} a=({:?},{:?})\", a.x, a.y);\n        eq_v(\"c2Neg\", &ctx, (p.c.c2Neg)(a), (p.r.c2Neg)(a));\n        eq_v(\"c2Skew\", &ctx, (p.c.c2Skew)(a), (p.r.c2Skew)(a));\n        eq_v(\"c2CCW90\", &ctx, (p.c.c2CCW90)(a), (p.r.c2CCW90)(a));\n    }\n    // +-0.0 must keep its sign bit through the negations.\n    for a in [\n        C2v { x: 0.0, y: 0.0 },\n        C2v { x: -0.0, y: 0.0 },\n        C2v { x: 0.0, y: -0.0 },\n        C2v { x: -0.0, y: -0.0 },\n    ] {\n        let ctx = format!(\"signed-zero bits=({:#x},{:#x})\", a.x.to_bits(), a.y.to_bits());\n        eq_v(\"c2Neg\", &ctx, (p.c.c2Neg)(a), (p.r.c2Neg)(a));\n        eq_v(\"c2Skew\", &ctx, (p.c.c2Skew)(a), (p.r.c2Skew)(a));\n        eq_v(\"c2CCW90\", &ctx, (p.c.c2CCW90)(a), (p.r.c2CCW90)(a));\n    }\n}\n\n// ===========================================================================\n// Rows 8, 9 — c2Maxv, c2Minv, c2Clampv (incl. the NaN asymmetry)\n// ===========================================================================\n\n#[test]\nfn cfg08_09_minmax_clamp() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 8);\n    for i in 0..N {\n        let (a, b, c) = (rng.v_mixed(), rng.v_mixed(), rng.v_mixed());\n        let ctx = format!(\n            \"#{i} a=({:?},{:?}) b=({:?},{:?}) c=({:?},{:?})\",\n            a.x, a.y, b.x, b.y, c.x, c.y\n        );\n        eq_v(\"c2Maxv\", &ctx, (p.c.c2Maxv)(a, b), (p.r.c2Maxv)(a, b));\n        eq_v(\"c2Minv\", &ctx, (p.c.c2Minv)(a, b), (p.r.c2Minv)(a, b));\n        eq_v(\n            \"c2Clampv\",\n            &ctx,\n            (p.c.c2Clampv)(a, b, c),\n            (p.r.c2Clampv)(a, b, c),\n        );\n    }\n\n    // Exhaustive small matrix: every pair from a set including NaN / +-0 / +-inf, in\n    // both argument positions (the C ternary is asymmetric on NaN).\n    let pool = [\n        0.0f32,\n        -0.0,\n        1.0,\n        -1.0,\n        f32::NAN,\n        f32::from_bits(0xFFC0_0000),\n        f32::INFINITY,\n        f32::NEG_INFINITY,\n        f32::MIN_POSITIVE,\n    ];\n    for &ax in &pool {\n        for &ay in &pool {\n            for &bx in &pool {\n                for &by in &pool {\n                    let a = C2v { x: ax, y: ay };\n                    let b = C2v { x: bx, y: by };\n                    let ctx = format!(\n                        \"matrix a=({:#x},{:#x}) b=({:#x},{:#x})\",\n                        ax.to_bits(),\n                        ay.to_bits(),\n                        bx.to_bits(),\n                        by.to_bits()\n                    );\n                    eq_v(\"c2Maxv\", &ctx, (p.c.c2Maxv)(a, b), (p.r.c2Maxv)(a, b));\n                    eq_v(\"c2Minv\", &ctx, (p.c.c2Minv)(a, b), (p.r.c2Minv)(a, b));\n                    // clamp with inverted lo/hi as well\n                    eq_v(\n                        \"c2Clampv\",\n                        &ctx,\n                        (p.c.c2Clampv)(a, b, a),\n                        (p.r.c2Clampv)(a, b, a),\n                    );\n                    eq_v(\n                        \"c2Clampv-inv\",\n                        &ctx,\n                        (p.c.c2Clampv)(a, b, C2v { x: -bx, y: -by }),\n                        (p.r.c2Clampv)(a, b, C2v { x: -bx, y: -by }),\n                    );\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 10 — c2RotIdentity, c2xIdentity (aggregate returns, no inputs)\n// ===========================================================================\n\n#[test]\nfn cfg10_identities() {\n    let p = load();\n    eq_r(\n        \"c2RotIdentity\",\n        \"no args\",\n        (p.c.c2RotIdentity)(),\n        (p.r.c2RotIdentity)(),\n    );\n    eq_x(\n        \"c2xIdentity\",\n        \"no args\",\n        (p.c.c2xIdentity)(),\n        (p.r.c2xIdentity)(),\n    );\n    // exact expected bit patterns from the C source\n    let r = (p.c.c2RotIdentity)();\n    assert_eq!(r.c.to_bits(), 1.0f32.to_bits());\n    assert_eq!(r.s.to_bits(), 0.0f32.to_bits());\n}\n\n// ===========================================================================\n// Rows 11, 12 — c2Mulrv, c2MulrvT, c2Mulxv\n// ===========================================================================\n\n#[test]\nfn cfg11_12_rotations() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 11);\n    for i in 0..N {\n        let r = rng.rot();\n        let v = rng.v_mixed();\n        let x = rng.x();\n        let ctx = format!(\n            \"#{i} r=({:?},{:?}) v=({:?},{:?}) x=(p:({:?},{:?}),r:({:?},{:?}))\",\n            r.c, r.s, v.x, v.y, x.p.x, x.p.y, x.r.c, x.r.s\n        );\n        eq_v(\"c2Mulrv\", &ctx, (p.c.c2Mulrv)(r, v), (p.r.c2Mulrv)(r, v));\n        eq_v(\"c2MulrvT\", &ctx, (p.c.c2MulrvT)(r, v), (p.r.c2MulrvT)(r, v));\n        eq_v(\"c2Mulxv\", &ctx, (p.c.c2Mulxv)(x, v), (p.r.c2Mulxv)(x, v));\n    }\n    // identity / translation-only / rotation-only / both\n    let id = (p.c.c2xIdentity)();\n    let trans = C2x {\n        p: C2v { x: 3.5, y: -7.25 },\n        r: C2r { c: 1.0, s: 0.0 },\n    };\n    let rot = C2x {\n        p: C2v { x: 0.0, y: 0.0 },\n        r: C2r {\n            c: 0.5f32.sqrt(),\n            s: 0.5f32.sqrt(),\n        },\n    };\n    let both = C2x {\n        p: C2v { x: -11.0, y: 2.0 },\n        r: C2r { c: 0.6, s: 0.8 },\n    };\n    let nonunit = C2x {\n        p: C2v { x: 1.0, y: 1.0 },\n        r: C2r { c: 2.5, s: -1.75 },\n    };\n    for (name, x) in [\n        (\"identity\", id),\n        (\"translate\", trans),\n        (\"rotate\", rot),\n        (\"both\", both),\n        (\"non-unit\", nonunit),\n    ] {\n        for v in [\n            C2v { x: 0.0, y: 0.0 },\n            C2v { x: 1.0, y: 0.0 },\n            C2v { x: 0.0, y: 1.0 },\n            C2v { x: -3.0, y: 9.5 },\n            C2v {\n                x: f32::NAN,\n                y: 1.0,\n            },\n        ] {\n            let ctx = format!(\"{name} v=({:?},{:?})\", v.x, v.y);\n            eq_v(\"c2Mulxv\", &ctx, (p.c.c2Mulxv)(x, v), (p.r.c2Mulxv)(x, v));\n            eq_v(\n                \"c2Mulrv\",\n                &ctx,\n                (p.c.c2Mulrv)(x.r, v),\n                (p.r.c2Mulrv)(x.r, v),\n            );\n            eq_v(\n                \"c2MulrvT\",\n                &ctx,\n                (p.c.c2MulrvT)(x.r, v),\n                (p.r.c2MulrvT)(x.r, v),\n            );\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 13, 14 — c2BBVerts\n// ===========================================================================\n\n#[test]\nfn cfg13_14_bbverts() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 13);\n    let poison = C2v {\n        x: f32::from_bits(0x1234_5678),\n        y: f32::from_bits(0x8765_4321),\n    };\n    let run = |api: &Api, bb: C2AABB| -> [C2v; 6] {\n        let mut out = [poison; 6];\n        let mut b = bb;\n        unsafe { (api.c2BBVerts)(out.as_mut_ptr(), &raw mut b) };\n        out\n    };\n    for i in 0..N {\n        let bb = rng.aabb();\n        let ctx = format!(\n            \"#{i} min=({:?},{:?}) max=({:?},{:?})\",\n            bb.min.x, bb.min.y, bb.max.x, bb.max.y\n        );\n        eq_bytes(\"c2BBVerts\", &ctx, &run(&p.c, bb), &run(&p.r, bb));\n    }\n    // explicit degenerate boxes\n    let zero = C2v { x: 0.0, y: 0.0 };\n    for bb in [\n        C2AABB { min: zero, max: zero },\n        C2AABB {\n            min: C2v { x: 5.0, y: 5.0 },\n            max: C2v { x: -5.0, y: -5.0 },\n        }, // inverted\n        C2AABB {\n            min: C2v {\n                x: f32::NEG_INFINITY,\n                y: f32::NAN,\n            },\n            max: C2v {\n                x: f32::INFINITY,\n                y: f32::NAN,\n            },\n        },\n        C2AABB {\n            min: C2v {\n                x: -f32::MAX,\n                y: -f32::MAX,\n            },\n            max: C2v {\n                x: f32::MAX,\n                y: f32::MAX,\n            },\n        },\n    ] {\n        let ctx = format!(\"explicit {bb:?}\");\n        eq_bytes(\"c2BBVerts\", &ctx, &run(&p.c, bb), &run(&p.r, bb));\n    }\n}\n\n// ===========================================================================\n// Rows 15, 16, 17 — c2MakeProxy for each valid type\n// ===========================================================================\n\nfn poisoned_proxy() -> C2Proxy {\n    let mut px = C2Proxy {\n        radius: f32::from_bits(0xA5A5_A5A5),\n        count: -559038737, // 0xDEADBEEF\n        verts: [C2v {\n            x: f32::from_bits(0x5A5A_5A5A),\n            y: f32::from_bits(0xA5A5_5A5A),\n        }; 8],\n    };\n    // make each slot distinct so a wrong-slot write is detected\n    for (i, v) in px.verts.iter_mut().enumerate() {\n        v.x = f32::from_bits(0x5A5A_0000 | i as u32);\n        v.y = f32::from_bits(0xA5A5_0000 | i as u32);\n    }\n    px\n}\n\nfn make_proxy(api: &Api, shape: &Shape) -> C2Proxy {\n    let mut px = poisoned_proxy();\n    unsafe { (api.c2MakeProxy)(shape.ptr(), shape.ty(), &raw mut px) };\n    px\n}\n\n#[test]\nfn cfg15_16_17_makeproxy_valid_types() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 15);\n    for &ty in &ALL_TYPES {\n        for i in 0..N {\n            let s = rand_shape(&mut rng, ty);\n            let ctx = format!(\"#{i} type={} shape={}\", ty_name(ty), shape_desc(&s));\n            eq_bytes(\n                \"c2MakeProxy\",\n                &ctx,\n                &make_proxy(&p.c, &s),\n                &make_proxy(&p.r, &s),\n            );\n        }\n    }\n    // explicit degenerate shapes\n    let zero = C2v { x: 0.0, y: 0.0 };\n    let shapes = [\n        Shape::Circle(C2Circle { p: zero, r: 0.0 }),\n        Shape::Circle(C2Circle { p: zero, r: -5.0 }),\n        Shape::Aabb(C2AABB { min: zero, max: zero }),\n        Shape::Aabb(C2AABB {\n            min: C2v { x: 1.0, y: 1.0 },\n            max: C2v { x: -1.0, y: -1.0 },\n        }),\n        Shape::Capsule(C2Capsule {\n            a: zero,\n            b: zero,\n            r: 0.0,\n        }),\n        Shape::Capsule(C2Capsule {\n            a: C2v {\n                x: f32::NAN,\n                y: 1.0,\n            },\n            b: zero,\n            r: f32::INFINITY,\n        }),\n    ];\n    for s in shapes {\n        let ctx = format!(\"explicit {}\", shape_desc(&s));\n        eq_bytes(\n            \"c2MakeProxy\",\n            &ctx,\n            &make_proxy(&p.c, &s),\n            &make_proxy(&p.r, &s),\n        );\n    }\n}\n\n// ===========================================================================\n// Rows 18, 19 — c2GJKSimplexMetric for count 2 and 3\n// ===========================================================================\n\n#[test]\nfn cfg18_19_simplex_metric() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 18);\n    for count in [2i32, 3] {\n        for i in 0..N {\n            let s = rng.simplex(count);\n            let ctx = format!(\"#{i} count={count} s={s:?}\");\n            let mut sc = s;\n            let mut sr = s;\n            let vc = unsafe { (p.c.c2GJKSimplexMetric)(&raw mut sc) };\n            let vr = unsafe { (p.r.c2GJKSimplexMetric)(&raw mut sr) };\n            eq_f32(\"c2GJKSimplexMetric\", &ctx, vc, vr);\n            // the function must not mutate the simplex\n            eq_simplex(\"c2GJKSimplexMetric/no-mutate\", &ctx, &sc, &sr);\n            eq_bytes(\"c2GJKSimplexMetric/unchanged\", &ctx, &s, &sc);\n        }\n    }\n    // Row 19 must produce determinants of both signs\n    let mut neg = 0usize;\n    let mut pos = 0usize;\n    let mut rng2 = Rng::new(99);\n    for _ in 0..2000 {\n        let s = rng2.simplex(3);\n        let mut sc = s;\n        let m = unsafe { (p.c.c2GJKSimplexMetric)(&raw mut sc) };\n        if m < 0.0 {\n            neg += 1\n        }\n        if m > 0.0 {\n            pos += 1\n        }\n    }\n    assert!(neg > 50 && pos > 50, \"determinant signs not covered: neg={neg} pos={pos}\");\n}\n\n// ===========================================================================\n// Rows 20-23 — c2Support with 1, 2, 4, 8 vertices\n// ===========================================================================\n\n#[test]\nfn cfg20_23_support() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 20);\n    for count in [1i32, 2, 4, 8] {\n        for i in 0..N {\n            let mut verts = [C2v::default(); 8];\n            for v in verts.iter_mut() {\n                *v = if rng.below(4) == 0 {\n                    // integral coordinates -> exact ties\n                    C2v {\n                        x: (rng.below(5) as f32) - 2.0,\n                        y: (rng.below(5) as f32) - 2.0,\n                    }\n                } else {\n                    rng.v()\n                };\n            }\n            let d = if rng.below(6) == 0 {\n                // axis / zero directions -> ties\n                match rng.below(5) {\n                    0 => C2v { x: 1.0, y: 0.0 },\n                    1 => C2v { x: -1.0, y: 0.0 },\n                    2 => C2v { x: 0.0, y: 1.0 },\n                    3 => C2v { x: 0.0, y: -1.0 },\n                    _ => C2v { x: 0.0, y: 0.0 },\n                }\n            } else {\n                rng.v_mixed()\n            };\n            let ctx = format!(\"#{i} count={count} verts={verts:?} d=({:?},{:?})\", d.x, d.y);\n            let ic = unsafe { (p.c.c2Support)(verts.as_ptr(), count, d) };\n            let ir = unsafe { (p.r.c2Support)(verts.as_ptr(), count, d) };\n            eq_i32(\"c2Support\", &ctx, ic, ir);\n        }\n    }\n    // AABB proxy vertices with the 4 axis directions (exact ties, lowest index wins)\n    let bb = C2AABB {\n        min: C2v { x: -1.0, y: -1.0 },\n        max: C2v { x: 1.0, y: 1.0 },\n    };\n    let px = make_proxy(&p.c, &Shape::Aabb(bb));\n    for d in [\n        C2v { x: 1.0, y: 0.0 },\n        C2v { x: -1.0, y: 0.0 },\n        C2v { x: 0.0, y: 1.0 },\n        C2v { x: 0.0, y: -1.0 },\n        C2v { x: 1.0, y: 1.0 },\n        C2v { x: -1.0, y: -1.0 },\n    ] {\n        let ctx = format!(\"aabb-ties d=({:?},{:?})\", d.x, d.y);\n        let ic = unsafe { (p.c.c2Support)(px.verts.as_ptr(), 4, d) };\n        let ir = unsafe { (p.r.c2Support)(px.verts.as_ptr(), 4, d) };\n        eq_i32(\"c2Support\", &ctx, ic, ir);\n    }\n}\n\n// ===========================================================================\n// Rows 24-27 — c22, all three regions\n// ===========================================================================\n\n/// Which branch of `c22` the C takes, computed with the C library's own primitives.\nfn c22_branch(api: &Api, s: &C2Simplex) -> usize {\n    let a = s.verts[0].p;\n    let b = s.verts[1].p;\n    let u = (api.c2Dot)(b, (api.c2Sub)(b, a));\n    let v = (api.c2Dot)(a, (api.c2Sub)(a, b));\n    if v <= 0.0 {\n        0\n    } else if u <= 0.0 {\n        1\n    } else {\n        2\n    }\n}\n\n#[test]\nfn cfg24_27_c22_branches() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 24);\n    let mut hits = [0usize; 3];\n    for i in 0..N {\n        let mut s = rng.simplex(2);\n        // bias toward well-shaped simplexes half the time so all 3 regions are hit\n        if i % 2 == 0 {\n            s.verts[0].p = C2v {\n                x: rng.range(-10.0, 10.0),\n                y: rng.range(-10.0, 10.0),\n            };\n            s.verts[1].p = C2v {\n                x: rng.range(-10.0, 10.0),\n                y: rng.range(-10.0, 10.0),\n            };\n        }\n        hits[c22_branch(&p.c, &s)] += 1;\n        let mut sc = s;\n        let mut sr = s;\n        unsafe { (p.c.c22)(&raw mut sc) };\n        unsafe { (p.r.c22)(&raw mut sr) };\n        eq_simplex(\"c22\", &format!(\"#{i} in={s:?}\"), &sc, &sr);\n    }\n    assert!(\n        hits.iter().all(|&h| h > 100),\n        \"c22 branch coverage insufficient: {hits:?}\"\n    );\n\n    // Hand-built cases for each region, incl. exact-zero and NaN boundaries.\n    let cases: Vec<(&str, C2v, C2v)> = vec![\n        (\"v<=0 (origin past a)\", C2v { x: 1.0, y: 0.0 }, C2v { x: 2.0, y: 0.0 }),\n        (\"u<=0 (origin past b)\", C2v { x: -2.0, y: 0.0 }, C2v { x: -1.0, y: 0.0 }),\n        (\"interior\", C2v { x: -1.0, y: 1.0 }, C2v { x: 1.0, y: 1.0 }),\n        (\"a==b\", C2v { x: 1.0, y: 1.0 }, C2v { x: 1.0, y: 1.0 }),\n        (\"a==origin\", C2v { x: 0.0, y: 0.0 }, C2v { x: 1.0, y: 0.0 }),\n        (\"b==origin\", C2v { x: 1.0, y: 0.0 }, C2v { x: 0.0, y: 0.0 }),\n        (\"both origin\", C2v { x: 0.0, y: 0.0 }, C2v { x: 0.0, y: 0.0 }),\n        (\n            \"nan a\",\n            C2v {\n                x: f32::NAN,\n                y: 0.0,\n            },\n            C2v { x: 1.0, y: 0.0 },\n        ),\n        (\n            \"nan b\",\n            C2v { x: 1.0, y: 0.0 },\n            C2v {\n                x: f32::NAN,\n                y: 0.0,\n            },\n        ),\n        (\n            \"inf\",\n            C2v {\n                x: f32::INFINITY,\n                y: 0.0,\n            },\n            C2v {\n                x: f32::NEG_INFINITY,\n                y: 0.0,\n            },\n        ),\n    ];\n    for (name, a, b) in cases {\n        let mut s = C2Simplex::default();\n        s.count = 2;\n        s.div = 1.0;\n        s.verts[0].p = a;\n        s.verts[1].p = b;\n        s.verts[0].sA = C2v { x: 1.0, y: 2.0 };\n        s.verts[0].sB = C2v { x: 3.0, y: 4.0 };\n        s.verts[1].sA = C2v { x: 5.0, y: 6.0 };\n        s.verts[1].sB = C2v { x: 7.0, y: 8.0 };\n        s.verts[0].iA = 1;\n        s.verts[0].iB = 2;\n        s.verts[1].iA = 3;\n        s.verts[1].iB = 4;\n        let mut sc = s;\n        let mut sr = s;\n        unsafe { (p.c.c22)(&raw mut sc) };\n        unsafe { (p.r.c22)(&raw mut sr) };\n        eq_simplex(\"c22\", &format!(\"explicit {name}\"), &sc, &sr);\n    }\n}\n\n// ===========================================================================\n// Rows 28-35 — c23, all seven regions\n// ===========================================================================\n\nfn c23_branch(api: &Api, s: &C2Simplex) -> usize {\n    let a = s.verts[0].p;\n    let b = s.verts[1].p;\n    let c = s.verts[2].p;\n    let dot = api.c2Dot;\n    let sub = api.c2Sub;\n    let det = api.c2Det2;\n    let uAB = dot(b, sub(b, a));\n    let vAB = dot(a, sub(a, b));\n    let uBC = dot(c, sub(c, b));\n    let vBC = dot(b, sub(b, c));\n    let uCA = dot(a, sub(a, c));\n    let vCA = dot(c, sub(c, a));\n    let area = det(sub(b, a), sub(c, a));\n    let uABC = det(b, c) * area;\n    let vABC = det(c, a) * area;\n    let wABC = det(a, b) * area;\n    if vAB <= 0.0 && uCA <= 0.0 {\n        0\n    } else if uAB <= 0.0 && vBC <= 0.0 {\n        1\n    } else if uBC <= 0.0 && vCA <= 0.0 {\n        2\n    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n        3\n    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n        4\n    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n        5\n    } else {\n        6\n    }\n}\n\n#[test]\nfn cfg28_35_c23_branches() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 28);\n    let mut hits = [0usize; 7];\n    for i in 0..N {\n        let mut s = rng.simplex(3);\n        if i % 2 == 0 {\n            for k in 0..3 {\n                s.verts[k].p = C2v {\n                    x: rng.range(-10.0, 10.0),\n                    y: rng.range(-10.0, 10.0),\n                };\n            }\n        }\n        hits[c23_branch(&p.c, &s)] += 1;\n        let mut sc = s;\n        let mut sr = s;\n        unsafe { (p.c.c23)(&raw mut sc) };\n        unsafe { (p.r.c23)(&raw mut sr) };\n        eq_simplex(\"c23\", &format!(\"#{i} in={s:?}\"), &sc, &sr);\n    }\n    assert!(\n        hits.iter().all(|&h| h > 20),\n        \"c23 branch coverage insufficient: {hits:?}\"\n    );\n\n    // Explicit triangles: origin in each vertex region, each edge region, and inside.\n    let tri = |a: C2v, b: C2v, c: C2v| {\n        let mut s = C2Simplex::default();\n        s.count = 3;\n        s.div = 1.0;\n        s.verts[0].p = a;\n        s.verts[1].p = b;\n        s.verts[2].p = c;\n        for k in 0..3 {\n            s.verts[k].sA = C2v {\n                x: k as f32,\n                y: -(k as f32),\n            };\n            s.verts[k].sB = C2v {\n                x: 10.0 + k as f32,\n                y: -10.0 - k as f32,\n            };\n            s.verts[k].iA = k as i32;\n            s.verts[k].iB = 7 - k as i32;\n        }\n        s\n    };\n    let v = |x: f32, y: f32| C2v { x, y };\n    let mut cases: Vec<(&str, C2Simplex)> = vec![\n        (\"inside\", tri(v(-1.0, -1.0), v(2.0, -1.0), v(0.0, 2.0))),\n        (\"vertexA\", tri(v(1.0, 0.0), v(3.0, 1.0), v(3.0, -1.0))),\n        (\"vertexB\", tri(v(3.0, 1.0), v(1.0, 0.0), v(3.0, -1.0))),\n        (\"vertexC\", tri(v(3.0, 1.0), v(3.0, -1.0), v(1.0, 0.0))),\n        (\"edgeAB\", tri(v(1.0, -2.0), v(1.0, 2.0), v(4.0, 0.0))),\n        (\"edgeBC\", tri(v(4.0, 0.0), v(1.0, -2.0), v(1.0, 2.0))),\n        (\"edgeCA\", tri(v(1.0, 2.0), v(4.0, 0.0), v(1.0, -2.0))),\n        (\"degenerate-collinear\", tri(v(1.0, 1.0), v(2.0, 2.0), v(3.0, 3.0))),\n        (\"all-zero\", tri(v(0.0, 0.0), v(0.0, 0.0), v(0.0, 0.0))),\n        (\"nan\", tri(v(f32::NAN, 0.0), v(1.0, 0.0), v(0.0, 1.0))),\n        (\n            \"inf\",\n            tri(v(f32::INFINITY, 0.0), v(0.0, f32::INFINITY), v(-1.0, -1.0)),\n        ),\n        (\"reverse-winding\", tri(v(-1.0, -1.0), v(0.0, 2.0), v(2.0, -1.0))),\n    ];\n    // report which branch each explicit case hit, for the record\n    let mut explicit_hits = [0usize; 7];\n    for (name, s) in cases.iter_mut() {\n        explicit_hits[c23_branch(&p.c, s)] += 1;\n        let mut sc = *s;\n        let mut sr = *s;\n        unsafe { (p.c.c23)(&raw mut sc) };\n        unsafe { (p.r.c23)(&raw mut sr) };\n        eq_simplex(\"c23\", &format!(\"explicit {name}\"), &sc, &sr);\n    }\n    assert!(\n        explicit_hits.iter().filter(|&&h| h > 0).count() >= 6,\n        \"explicit c23 cases only covered {explicit_hits:?}\"\n    );\n}\n\n// ===========================================================================\n// Row 36 — c2D\n// ===========================================================================\n\n#[test]\nfn cfg36_c2d() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 36);\n    let mut skew = 0usize;\n    let mut ccw = 0usize;\n    for count in [1i32, 2] {\n        for i in 0..N {\n            let s = rng.simplex(count);\n            if count == 2 {\n                let ab = (p.c.c2Sub)(s.verts[1].p, s.verts[0].p);\n                if (p.c.c2Det2)(ab, (p.c.c2Neg)(s.verts[0].p)) > 0.0 {\n                    skew += 1\n                } else {\n                    ccw += 1\n                }\n            }\n            let ctx = format!(\"#{i} count={count} s={s:?}\");\n            let mut sc = s;\n            let mut sr = s;\n            let rc = unsafe { (p.c.c2D)(&raw mut sc) };\n            let rr = unsafe { (p.r.c2D)(&raw mut sr) };\n            eq_v(\"c2D\", &ctx, rc, rr);\n            eq_simplex(\"c2D/no-mutate\", &ctx, &sc, &sr);\n        }\n    }\n    assert!(skew > 100 && ccw > 100, \"c2D branches: skew={skew} ccw={ccw}\");\n}\n\n// ===========================================================================\n// Row 37 — c2L\n// ===========================================================================\n\n#[test]\nfn cfg37_c2l() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 37);\n    for count in [1i32, 2] {\n        for i in 0..N {\n            let mut s = rng.simplex(count);\n            if i % 3 == 0 {\n                s.div = rng.range(1.0e-30, 1.0e30);\n            }\n            let ctx = format!(\"#{i} count={count} s={s:?}\");\n            let mut sc = s;\n            let mut sr = s;\n            let rc = unsafe { (p.c.c2L)(&raw mut sc) };\n            let rr = unsafe { (p.r.c2L)(&raw mut sr) };\n            eq_v(\"c2L\", &ctx, rc, rr);\n            eq_simplex(\"c2L/no-mutate\", &ctx, &sc, &sr);\n        }\n    }\n}\n\n// ===========================================================================\n// Row 38 — c2Witness\n// ===========================================================================\n\n#[test]\nfn cfg38_c2witness() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 38);\n    let run = |api: &Api, s: C2Simplex| -> (C2v, C2v) {\n        let mut ss = s;\n        let mut a = C2v {\n            x: f32::from_bits(0xDEAD_0001),\n            y: f32::from_bits(0xDEAD_0002),\n        };\n        let mut b = C2v {\n            x: f32::from_bits(0xDEAD_0003),\n            y: f32::from_bits(0xDEAD_0004),\n        };\n        unsafe { (api.c2Witness)(&raw mut ss, &raw mut a, &raw mut b) };\n        (a, b)\n    };\n    for count in [1i32, 2, 3] {\n        for i in 0..N {\n            let s = rng.simplex(count);\n            let ctx = format!(\"#{i} count={count} s={s:?}\");\n            let (ac, bc) = run(&p.c, s);\n            let (ar, br) = run(&p.r, s);\n            eq_v(\"c2Witness a\", &ctx, ac, ar);\n            eq_v(\"c2Witness b\", &ctx, bc, br);\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13555,"cache_read_input_tokens":86000,"cache_creation":{"ephemeral_5m_input_tokens":13555,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"01a68480-bbf5-45e9-96ef-206dacf1aacc","uuid":"15f86c5a-82fa-4722-ac80-6db680ab2249","timestamp":"2026-08-27T16:11:20.069Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019JDxnmZjShhDDFDSpwFqQz","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-lBJjNJ/translation/tests/phase_b_lowlevel.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"01a68480-bbf5-45e9-96ef-206dacf1aacc","uuid":"91701c45-6c04-43e6-b42a-f199b81ffe95","timestamp":"2026-08-27T16:11:20.080Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-lBJjNJ/translation/tests/phase_b_lowlevel.rs","content":"//! Phase B — valid-path differential tests, lowest level first.\n//!\n//! Covers CONFIGS.md rows 1-38 (scalar/vector math, proxy construction, the simplex\n//! primitives and the simplex solvers).  Both libraries are driven exclusively through\n//! `dlsym`'d `extern \"C\"` entry points.\n\nmod common;\nuse common::*;\n\nconst N: usize = 20_000;\nconst SEED: u64 = 0x_C0FF_EE12_3456_789A;\n\n// ===========================================================================\n// Row 1 — c2V\n// ===========================================================================\n\n#[test]\nfn cfg01_c2v() {\n    let p = load();\n    let mut rng = Rng::new(SEED);\n    for i in 0..N {\n        let (x, y) = (rng.mixed(), rng.mixed());\n        eq_v(\n            \"c2V\",\n            &format!(\"#{i} x={x:?} y={y:?}\"),\n            (p.c.c2V)(x, y),\n            (p.r.c2V)(x, y),\n        );\n    }\n}\n\n// ===========================================================================\n// Row 2 — c2Mulvs, c2Div\n// ===========================================================================\n\n#[test]\nfn cfg02_c2mulvs_c2div() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 2);\n    for i in 0..N {\n        let a = rng.v_mixed();\n        let b = rng.mixed();\n        let ctx = format!(\"#{i} a=({:?},{:?}) b={b:?}\", a.x, a.y);\n        eq_v(\"c2Mulvs\", &ctx, (p.c.c2Mulvs)(a, b), (p.r.c2Mulvs)(a, b));\n        eq_v(\"c2Div\", &ctx, (p.c.c2Div)(a, b), (p.r.c2Div)(a, b));\n    }\n    // explicit zero / negative-zero divisors (ERRORS rows 15,16)\n    for b in [0.0f32, -0.0f32] {\n        for a in [\n            C2v { x: 1.0, y: -1.0 },\n            C2v { x: 0.0, y: -0.0 },\n            C2v {\n                x: f32::INFINITY,\n                y: f32::NAN,\n            },\n        ] {\n            let ctx = format!(\"explicit a=({:?},{:?}) b={b:?}\", a.x, a.y);\n            eq_v(\"c2Div\", &ctx, (p.c.c2Div)(a, b), (p.r.c2Div)(a, b));\n        }\n    }\n}\n\n// ===========================================================================\n// Row 3 — c2Add, c2Sub\n// ===========================================================================\n\n#[test]\nfn cfg03_c2add_c2sub() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 3);\n    for i in 0..N {\n        let (a, b) = (rng.v_mixed(), rng.v_mixed());\n        let ctx = format!(\"#{i} a=({:?},{:?}) b=({:?},{:?})\", a.x, a.y, b.x, b.y);\n        eq_v(\"c2Add\", &ctx, (p.c.c2Add)(a, b), (p.r.c2Add)(a, b));\n        eq_v(\"c2Sub\", &ctx, (p.c.c2Sub)(a, b), (p.r.c2Sub)(a, b));\n    }\n}\n\n// ===========================================================================\n// Row 4 — c2Dot, c2Det2\n// ===========================================================================\n\n#[test]\nfn cfg04_c2dot_c2det2() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 4);\n    for i in 0..N {\n        let (a, b) = (rng.v_mixed(), rng.v_mixed());\n        let ctx = format!(\"#{i} a=({:?},{:?}) b=({:?},{:?})\", a.x, a.y, b.x, b.y);\n        eq_f32(\"c2Dot\", &ctx, (p.c.c2Dot)(a, b), (p.r.c2Dot)(a, b));\n        eq_f32(\"c2Det2\", &ctx, (p.c.c2Det2)(a, b), (p.r.c2Det2)(a, b));\n    }\n    // Values that overflow the product to +-inf and that cancel exactly.\n    let huge = 1.0e30f32;\n    for (a, b) in [\n        (C2v { x: huge, y: huge }, C2v { x: huge, y: huge }),\n        (\n            C2v { x: huge, y: huge },\n            C2v {\n                x: huge,\n                y: -huge,\n            },\n        ),\n        (\n            C2v {\n                x: f32::MAX,\n                y: f32::MAX,\n            },\n            C2v {\n                x: f32::MAX,\n                y: -f32::MAX,\n            },\n        ),\n    ] {\n        let ctx = format!(\"overflow a=({:?},{:?}) b=({:?},{:?})\", a.x, a.y, b.x, b.y);\n        eq_f32(\"c2Dot\", &ctx, (p.c.c2Dot)(a, b), (p.r.c2Dot)(a, b));\n        eq_f32(\"c2Det2\", &ctx, (p.c.c2Det2)(a, b), (p.r.c2Det2)(a, b));\n    }\n}\n\n// ===========================================================================\n// Rows 5, 6 — c2Len, c2Norm\n// ===========================================================================\n\n#[test]\nfn cfg05_06_c2len_c2norm() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 5);\n    for i in 0..N {\n        let a = rng.v_mixed();\n        let ctx = format!(\"#{i} a=({:?},{:?})\", a.x, a.y);\n        eq_f32(\"c2Len\", &ctx, (p.c.c2Len)(a), (p.r.c2Len)(a));\n        eq_v(\"c2Norm\", &ctx, (p.c.c2Norm)(a), (p.r.c2Norm)(a));\n    }\n    for a in [\n        C2v { x: 0.0, y: 0.0 },\n        C2v { x: -0.0, y: -0.0 },\n        C2v {\n            x: f32::MAX,\n            y: f32::MAX,\n        },\n        C2v {\n            x: f32::INFINITY,\n            y: 1.0,\n        },\n        C2v {\n            x: f32::NAN,\n            y: 0.0,\n        },\n        C2v {\n            x: f32::from_bits(1),\n            y: f32::from_bits(1),\n        },\n        C2v { x: 3.0, y: 4.0 },\n    ] {\n        let ctx = format!(\"explicit a=({:?},{:?})\", a.x, a.y);\n        eq_f32(\"c2Len\", &ctx, (p.c.c2Len)(a), (p.r.c2Len)(a));\n        eq_v(\"c2Norm\", &ctx, (p.c.c2Norm)(a), (p.r.c2Norm)(a));\n    }\n}\n\n// ===========================================================================\n// Row 7 — c2Neg, c2Skew, c2CCW90\n// ===========================================================================\n\n#[test]\nfn cfg07_unary_vec_ops() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 7);\n    for i in 0..N {\n        let a = rng.v_mixed();\n        let ctx = format!(\"#{i} a=({:?},{:?})\", a.x, a.y);\n        eq_v(\"c2Neg\", &ctx, (p.c.c2Neg)(a), (p.r.c2Neg)(a));\n        eq_v(\"c2Skew\", &ctx, (p.c.c2Skew)(a), (p.r.c2Skew)(a));\n        eq_v(\"c2CCW90\", &ctx, (p.c.c2CCW90)(a), (p.r.c2CCW90)(a));\n    }\n    // +-0.0 must keep its sign bit through the negations.\n    for a in [\n        C2v { x: 0.0, y: 0.0 },\n        C2v { x: -0.0, y: 0.0 },\n        C2v { x: 0.0, y: -0.0 },\n        C2v { x: -0.0, y: -0.0 },\n    ] {\n        let ctx = format!(\"signed-zero bits=({:#x},{:#x})\", a.x.to_bits(), a.y.to_bits());\n        eq_v(\"c2Neg\", &ctx, (p.c.c2Neg)(a), (p.r.c2Neg)(a));\n        eq_v(\"c2Skew\", &ctx, (p.c.c2Skew)(a), (p.r.c2Skew)(a));\n        eq_v(\"c2CCW90\", &ctx, (p.c.c2CCW90)(a), (p.r.c2CCW90)(a));\n    }\n}\n\n// ===========================================================================\n// Rows 8, 9 — c2Maxv, c2Minv, c2Clampv (incl. the NaN asymmetry)\n// ===========================================================================\n\n#[test]\nfn cfg08_09_minmax_clamp() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 8);\n    for i in 0..N {\n        let (a, b, c) = (rng.v_mixed(), rng.v_mixed(), rng.v_mixed());\n        let ctx = format!(\n            \"#{i} a=({:?},{:?}) b=({:?},{:?}) c=({:?},{:?})\",\n            a.x, a.y, b.x, b.y, c.x, c.y\n        );\n        eq_v(\"c2Maxv\", &ctx, (p.c.c2Maxv)(a, b), (p.r.c2Maxv)(a, b));\n        eq_v(\"c2Minv\", &ctx, (p.c.c2Minv)(a, b), (p.r.c2Minv)(a, b));\n        eq_v(\n            \"c2Clampv\",\n            &ctx,\n            (p.c.c2Clampv)(a, b, c),\n            (p.r.c2Clampv)(a, b, c),\n        );\n    }\n\n    // Exhaustive small matrix: every pair from a set including NaN / +-0 / +-inf, in\n    // both argument positions (the C ternary is asymmetric on NaN).\n    let pool = [\n        0.0f32,\n        -0.0,\n        1.0,\n        -1.0,\n        f32::NAN,\n        f32::from_bits(0xFFC0_0000),\n        f32::INFINITY,\n        f32::NEG_INFINITY,\n        f32::MIN_POSITIVE,\n    ];\n    for &ax in &pool {\n        for &ay in &pool {\n            for &bx in &pool {\n                for &by in &pool {\n                    let a = C2v { x: ax, y: ay };\n                    let b = C2v { x: bx, y: by };\n                    let ctx = format!(\n                        \"matrix a=({:#x},{:#x}) b=({:#x},{:#x})\",\n                        ax.to_bits(),\n                        ay.to_bits(),\n                        bx.to_bits(),\n                        by.to_bits()\n                    );\n                    eq_v(\"c2Maxv\", &ctx, (p.c.c2Maxv)(a, b), (p.r.c2Maxv)(a, b));\n                    eq_v(\"c2Minv\", &ctx, (p.c.c2Minv)(a, b), (p.r.c2Minv)(a, b));\n                    // clamp with inverted lo/hi as well\n                    eq_v(\n                        \"c2Clampv\",\n                        &ctx,\n                        (p.c.c2Clampv)(a, b, a),\n                        (p.r.c2Clampv)(a, b, a),\n                    );\n                    eq_v(\n                        \"c2Clampv-inv\",\n                        &ctx,\n                        (p.c.c2Clampv)(a, b, C2v { x: -bx, y: -by }),\n                        (p.r.c2Clampv)(a, b, C2v { x: -bx, y: -by }),\n                    );\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 10 — c2RotIdentity, c2xIdentity (aggregate returns, no inputs)\n// ===========================================================================\n\n#[test]\nfn cfg10_identities() {\n    let p = load();\n    eq_r(\n        \"c2RotIdentity\",\n        \"no args\",\n        (p.c.c2RotIdentity)(),\n        (p.r.c2RotIdentity)(),\n    );\n    eq_x(\n        \"c2xIdentity\",\n        \"no args\",\n        (p.c.c2xIdentity)(),\n        (p.r.c2xIdentity)(),\n    );\n    // exact expected bit patterns from the C source\n    let r = (p.c.c2RotIdentity)();\n    assert_eq!(r.c.to_bits(), 1.0f32.to_bits());\n    assert_eq!(r.s.to_bits(), 0.0f32.to_bits());\n}\n\n// ===========================================================================\n// Rows 11, 12 — c2Mulrv, c2MulrvT, c2Mulxv\n// ===========================================================================\n\n#[test]\nfn cfg11_12_rotations() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 11);\n    for i in 0..N {\n        let r = rng.rot();\n        let v = rng.v_mixed();\n        let x = rng.x();\n        let ctx = format!(\n            \"#{i} r=({:?},{:?}) v=({:?},{:?}) x=(p:({:?},{:?}),r:({:?},{:?}))\",\n            r.c, r.s, v.x, v.y, x.p.x, x.p.y, x.r.c, x.r.s\n        );\n        eq_v(\"c2Mulrv\", &ctx, (p.c.c2Mulrv)(r, v), (p.r.c2Mulrv)(r, v));\n        eq_v(\"c2MulrvT\", &ctx, (p.c.c2MulrvT)(r, v), (p.r.c2MulrvT)(r, v));\n        eq_v(\"c2Mulxv\", &ctx, (p.c.c2Mulxv)(x, v), (p.r.c2Mulxv)(x, v));\n    }\n    // identity / translation-only / rotation-only / both\n    let id = (p.c.c2xIdentity)();\n    let trans = C2x {\n        p: C2v { x: 3.5, y: -7.25 },\n        r: C2r { c: 1.0, s: 0.0 },\n    };\n    let rot = C2x {\n        p: C2v { x: 0.0, y: 0.0 },\n        r: C2r {\n            c: 0.5f32.sqrt(),\n            s: 0.5f32.sqrt(),\n        },\n    };\n    let both = C2x {\n        p: C2v { x: -11.0, y: 2.0 },\n        r: C2r { c: 0.6, s: 0.8 },\n    };\n    let nonunit = C2x {\n        p: C2v { x: 1.0, y: 1.0 },\n        r: C2r { c: 2.5, s: -1.75 },\n    };\n    for (name, x) in [\n        (\"identity\", id),\n        (\"translate\", trans),\n        (\"rotate\", rot),\n        (\"both\", both),\n        (\"non-unit\", nonunit),\n    ] {\n        for v in [\n            C2v { x: 0.0, y: 0.0 },\n            C2v { x: 1.0, y: 0.0 },\n            C2v { x: 0.0, y: 1.0 },\n            C2v { x: -3.0, y: 9.5 },\n            C2v {\n                x: f32::NAN,\n                y: 1.0,\n            },\n        ] {\n            let ctx = format!(\"{name} v=({:?},{:?})\", v.x, v.y);\n            eq_v(\"c2Mulxv\", &ctx, (p.c.c2Mulxv)(x, v), (p.r.c2Mulxv)(x, v));\n            eq_v(\n                \"c2Mulrv\",\n                &ctx,\n                (p.c.c2Mulrv)(x.r, v),\n                (p.r.c2Mulrv)(x.r, v),\n            );\n            eq_v(\n                \"c2MulrvT\",\n                &ctx,\n                (p.c.c2MulrvT)(x.r, v),\n                (p.r.c2MulrvT)(x.r, v),\n            );\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 13, 14 — c2BBVerts\n// ===========================================================================\n\n#[test]\nfn cfg13_14_bbverts() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 13);\n    let poison = C2v {\n        x: f32::from_bits(0x1234_5678),\n        y: f32::from_bits(0x8765_4321),\n    };\n    let run = |api: &Api, bb: C2AABB| -> [C2v; 6] {\n        let mut out = [poison; 6];\n        let mut b = bb;\n        unsafe { (api.c2BBVerts)(out.as_mut_ptr(), &raw mut b) };\n        out\n    };\n    for i in 0..N {\n        let bb = rng.aabb();\n        let ctx = format!(\n            \"#{i} min=({:?},{:?}) max=({:?},{:?})\",\n            bb.min.x, bb.min.y, bb.max.x, bb.max.y\n        );\n        eq_bytes(\"c2BBVerts\", &ctx, &run(&p.c, bb), &run(&p.r, bb));\n    }\n    // explicit degenerate boxes\n    let zero = C2v { x: 0.0, y: 0.0 };\n    for bb in [\n        C2AABB { min: zero, max: zero },\n        C2AABB {\n            min: C2v { x: 5.0, y: 5.0 },\n            max: C2v { x: -5.0, y: -5.0 },\n        }, // inverted\n        C2AABB {\n            min: C2v {\n                x: f32::NEG_INFINITY,\n                y: f32::NAN,\n            },\n            max: C2v {\n                x: f32::INFINITY,\n                y: f32::NAN,\n            },\n        },\n        C2AABB {\n            min: C2v {\n                x: -f32::MAX,\n                y: -f32::MAX,\n            },\n            max: C2v {\n                x: f32::MAX,\n                y: f32::MAX,\n            },\n        },\n    ] {\n        let ctx = format!(\"explicit {bb:?}\");\n        eq_bytes(\"c2BBVerts\", &ctx, &run(&p.c, bb), &run(&p.r, bb));\n    }\n}\n\n// ===========================================================================\n// Rows 15, 16, 17 — c2MakeProxy for each valid type\n// ===========================================================================\n\nfn poisoned_proxy() -> C2Proxy {\n    let mut px = C2Proxy {\n        radius: f32::from_bits(0xA5A5_A5A5),\n        count: -559038737, // 0xDEADBEEF\n        verts: [C2v {\n            x: f32::from_bits(0x5A5A_5A5A),\n            y: f32::from_bits(0xA5A5_5A5A),\n        }; 8],\n    };\n    // make each slot distinct so a wrong-slot write is detected\n    for (i, v) in px.verts.iter_mut().enumerate() {\n        v.x = f32::from_bits(0x5A5A_0000 | i as u32);\n        v.y = f32::from_bits(0xA5A5_0000 | i as u32);\n    }\n    px\n}\n\nfn make_proxy(api: &Api, shape: &Shape) -> C2Proxy {\n    let mut px = poisoned_proxy();\n    unsafe { (api.c2MakeProxy)(shape.ptr(), shape.ty(), &raw mut px) };\n    px\n}\n\n#[test]\nfn cfg15_16_17_makeproxy_valid_types() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 15);\n    for &ty in &ALL_TYPES {\n        for i in 0..N {\n            let s = rand_shape(&mut rng, ty);\n            let ctx = format!(\"#{i} type={} shape={}\", ty_name(ty), shape_desc(&s));\n            eq_bytes(\n                \"c2MakeProxy\",\n                &ctx,\n                &make_proxy(&p.c, &s),\n                &make_proxy(&p.r, &s),\n            );\n        }\n    }\n    // explicit degenerate shapes\n    let zero = C2v { x: 0.0, y: 0.0 };\n    let shapes = [\n        Shape::Circle(C2Circle { p: zero, r: 0.0 }),\n        Shape::Circle(C2Circle { p: zero, r: -5.0 }),\n        Shape::Aabb(C2AABB { min: zero, max: zero }),\n        Shape::Aabb(C2AABB {\n            min: C2v { x: 1.0, y: 1.0 },\n            max: C2v { x: -1.0, y: -1.0 },\n        }),\n        Shape::Capsule(C2Capsule {\n            a: zero,\n            b: zero,\n            r: 0.0,\n        }),\n        Shape::Capsule(C2Capsule {\n            a: C2v {\n                x: f32::NAN,\n                y: 1.0,\n            },\n            b: zero,\n            r: f32::INFINITY,\n        }),\n    ];\n    for s in shapes {\n        let ctx = format!(\"explicit {}\", shape_desc(&s));\n        eq_bytes(\n            \"c2MakeProxy\",\n            &ctx,\n            &make_proxy(&p.c, &s),\n            &make_proxy(&p.r, &s),\n        );\n    }\n}\n\n// ===========================================================================\n// Rows 18, 19 — c2GJKSimplexMetric for count 2 and 3\n// ===========================================================================\n\n#[test]\nfn cfg18_19_simplex_metric() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 18);\n    for count in [2i32, 3] {\n        for i in 0..N {\n            let s = rng.simplex(count);\n            let ctx = format!(\"#{i} count={count} s={s:?}\");\n            let mut sc = s;\n            let mut sr = s;\n            let vc = unsafe { (p.c.c2GJKSimplexMetric)(&raw mut sc) };\n            let vr = unsafe { (p.r.c2GJKSimplexMetric)(&raw mut sr) };\n            eq_f32(\"c2GJKSimplexMetric\", &ctx, vc, vr);\n            // the function must not mutate the simplex\n            eq_simplex(\"c2GJKSimplexMetric/no-mutate\", &ctx, &sc, &sr);\n            eq_bytes(\"c2GJKSimplexMetric/unchanged\", &ctx, &s, &sc);\n        }\n    }\n    // Row 19 must produce determinants of both signs\n    let mut neg = 0usize;\n    let mut pos = 0usize;\n    let mut rng2 = Rng::new(99);\n    for _ in 0..2000 {\n        let s = rng2.simplex(3);\n        let mut sc = s;\n        let m = unsafe { (p.c.c2GJKSimplexMetric)(&raw mut sc) };\n        if m < 0.0 {\n            neg += 1\n        }\n        if m > 0.0 {\n            pos += 1\n        }\n    }\n    assert!(neg > 50 && pos > 50, \"determinant signs not covered: neg={neg} pos={pos}\");\n}\n\n// ===========================================================================\n// Rows 20-23 — c2Support with 1, 2, 4, 8 vertices\n// ===========================================================================\n\n#[test]\nfn cfg20_23_support() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 20);\n    for count in [1i32, 2, 4, 8] {\n        for i in 0..N {\n            let mut verts = [C2v::default(); 8];\n            for v in verts.iter_mut() {\n                *v = if rng.below(4) == 0 {\n                    // integral coordinates -> exact ties\n                    C2v {\n                        x: (rng.below(5) as f32) - 2.0,\n                        y: (rng.below(5) as f32) - 2.0,\n                    }\n                } else {\n                    rng.v()\n                };\n            }\n            let d = if rng.below(6) == 0 {\n                // axis / zero directions -> ties\n                match rng.below(5) {\n                    0 => C2v { x: 1.0, y: 0.0 },\n                    1 => C2v { x: -1.0, y: 0.0 },\n                    2 => C2v { x: 0.0, y: 1.0 },\n                    3 => C2v { x: 0.0, y: -1.0 },\n                    _ => C2v { x: 0.0, y: 0.0 },\n                }\n            } else {\n                rng.v_mixed()\n            };\n            let ctx = format!(\"#{i} count={count} verts={verts:?} d=({:?},{:?})\", d.x, d.y);\n            let ic = unsafe { (p.c.c2Support)(verts.as_ptr(), count, d) };\n            let ir = unsafe { (p.r.c2Support)(verts.as_ptr(), count, d) };\n            eq_i32(\"c2Support\", &ctx, ic, ir);\n        }\n    }\n    // AABB proxy vertices with the 4 axis directions (exact ties, lowest index wins)\n    let bb = C2AABB {\n        min: C2v { x: -1.0, y: -1.0 },\n        max: C2v { x: 1.0, y: 1.0 },\n    };\n    let px = make_proxy(&p.c, &Shape::Aabb(bb));\n    for d in [\n        C2v { x: 1.0, y: 0.0 },\n        C2v { x: -1.0, y: 0.0 },\n        C2v { x: 0.0, y: 1.0 },\n        C2v { x: 0.0, y: -1.0 },\n        C2v { x: 1.0, y: 1.0 },\n        C2v { x: -1.0, y: -1.0 },\n    ] {\n        let ctx = format!(\"aabb-ties d=({:?},{:?})\", d.x, d.y);\n        let ic = unsafe { (p.c.c2Support)(px.verts.as_ptr(), 4, d) };\n        let ir = unsafe { (p.r.c2Support)(px.verts.as_ptr(), 4, d) };\n        eq_i32(\"c2Support\", &ctx, ic, ir);\n    }\n}\n\n// ===========================================================================\n// Rows 24-27 — c22, all three regions\n// ===========================================================================\n\n/// Which branch of `c22` the C takes, computed with the C library's own primitives.\nfn c22_branch(api: &Api, s: &C2Simplex) -> usize {\n    let a = s.verts[0].p;\n    let b = s.verts[1].p;\n    let u = (api.c2Dot)(b, (api.c2Sub)(b, a));\n    let v = (api.c2Dot)(a, (api.c2Sub)(a, b));\n    if v <= 0.0 {\n        0\n    } else if u <= 0.0 {\n        1\n    } else {\n        2\n    }\n}\n\n#[test]\nfn cfg24_27_c22_branches() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 24);\n    let mut hits = [0usize; 3];\n    for i in 0..N {\n        let mut s = rng.simplex(2);\n        // bias toward well-shaped simplexes half the time so all 3 regions are hit\n        if i % 2 == 0 {\n            s.verts[0].p = C2v {\n                x: rng.range(-10.0, 10.0),\n                y: rng.range(-10.0, 10.0),\n            };\n            s.verts[1].p = C2v {\n                x: rng.range(-10.0, 10.0),\n                y: rng.range(-10.0, 10.0),\n            };\n        }\n        hits[c22_branch(&p.c, &s)] += 1;\n        let mut sc = s;\n        let mut sr = s;\n        unsafe { (p.c.c22)(&raw mut sc) };\n        unsafe { (p.r.c22)(&raw mut sr) };\n        eq_simplex(\"c22\", &format!(\"#{i} in={s:?}\"), &sc, &sr);\n    }\n    assert!(\n        hits.iter().all(|&h| h > 100),\n        \"c22 branch coverage insufficient: {hits:?}\"\n    );\n\n    // Hand-built cases for each region, incl. exact-zero and NaN boundaries.\n    let cases: Vec<(&str, C2v, C2v)> = vec![\n        (\"v<=0 (origin past a)\", C2v { x: 1.0, y: 0.0 }, C2v { x: 2.0, y: 0.0 }),\n        (\"u<=0 (origin past b)\", C2v { x: -2.0, y: 0.0 }, C2v { x: -1.0, y: 0.0 }),\n        (\"interior\", C2v { x: -1.0, y: 1.0 }, C2v { x: 1.0, y: 1.0 }),\n        (\"a==b\", C2v { x: 1.0, y: 1.0 }, C2v { x: 1.0, y: 1.0 }),\n        (\"a==origin\", C2v { x: 0.0, y: 0.0 }, C2v { x: 1.0, y: 0.0 }),\n        (\"b==origin\", C2v { x: 1.0, y: 0.0 }, C2v { x: 0.0, y: 0.0 }),\n        (\"both origin\", C2v { x: 0.0, y: 0.0 }, C2v { x: 0.0, y: 0.0 }),\n        (\n            \"nan a\",\n            C2v {\n                x: f32::NAN,\n                y: 0.0,\n            },\n            C2v { x: 1.0, y: 0.0 },\n        ),\n        (\n            \"nan b\",\n            C2v { x: 1.0, y: 0.0 },\n            C2v {\n                x: f32::NAN,\n                y: 0.0,\n            },\n        ),\n        (\n            \"inf\",\n            C2v {\n                x: f32::INFINITY,\n                y: 0.0,\n            },\n            C2v {\n                x: f32::NEG_INFINITY,\n                y: 0.0,\n            },\n        ),\n    ];\n    for (name, a, b) in cases {\n        let mut s = C2Simplex::default();\n        s.count = 2;\n        s.div = 1.0;\n        s.verts[0].p = a;\n        s.verts[1].p = b;\n        s.verts[0].sA = C2v { x: 1.0, y: 2.0 };\n        s.verts[0].sB = C2v { x: 3.0, y: 4.0 };\n        s.verts[1].sA = C2v { x: 5.0, y: 6.0 };\n        s.verts[1].sB = C2v { x: 7.0, y: 8.0 };\n        s.verts[0].iA = 1;\n        s.verts[0].iB = 2;\n        s.verts[1].iA = 3;\n        s.verts[1].iB = 4;\n        let mut sc = s;\n        let mut sr = s;\n        unsafe { (p.c.c22)(&raw mut sc) };\n        unsafe { (p.r.c22)(&raw mut sr) };\n        eq_simplex(\"c22\", &format!(\"explicit {name}\"), &sc, &sr);\n    }\n}\n\n// ===========================================================================\n// Rows 28-35 — c23, all seven regions\n// ===========================================================================\n\nfn c23_branch(api: &Api, s: &C2Simplex) -> usize {\n    let a = s.verts[0].p;\n    let b = s.verts[1].p;\n    let c = s.verts[2].p;\n    let dot = api.c2Dot;\n    let sub = api.c2Sub;\n    let det = api.c2Det2;\n    let uAB = dot(b, sub(b, a));\n    let vAB = dot(a, sub(a, b));\n    let uBC = dot(c, sub(c, b));\n    let vBC = dot(b, sub(b, c));\n    let uCA = dot(a, sub(a, c));\n    let vCA = dot(c, sub(c, a));\n    let area = det(sub(b, a), sub(c, a));\n    let uABC = det(b, c) * area;\n    let vABC = det(c, a) * area;\n    let wABC = det(a, b) * area;\n    if vAB <= 0.0 && uCA <= 0.0 {\n        0\n    } else if uAB <= 0.0 && vBC <= 0.0 {\n        1\n    } else if uBC <= 0.0 && vCA <= 0.0 {\n        2\n    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n        3\n    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n        4\n    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n        5\n    } else {\n        6\n    }\n}\n\n#[test]\nfn cfg28_35_c23_branches() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 28);\n    let mut hits = [0usize; 7];\n    for i in 0..N {\n        let mut s = rng.simplex(3);\n        if i % 2 == 0 {\n            for k in 0..3 {\n                s.verts[k].p = C2v {\n                    x: rng.range(-10.0, 10.0),\n                    y: rng.range(-10.0, 10.0),\n                };\n            }\n        }\n        hits[c23_branch(&p.c, &s)] += 1;\n        let mut sc = s;\n        let mut sr = s;\n        unsafe { (p.c.c23)(&raw mut sc) };\n        unsafe { (p.r.c23)(&raw mut sr) };\n        eq_simplex(\"c23\", &format!(\"#{i} in={s:?}\"), &sc, &sr);\n    }\n    assert!(\n        hits.iter().all(|&h| h > 20),\n        \"c23 branch coverage insufficient: {hits:?}\"\n    );\n\n    // Explicit triangles: origin in each vertex region, each edge region, and inside.\n    let tri = |a: C2v, b: C2v, c: C2v| {\n        let mut s = C2Simplex::default();\n        s.count = 3;\n        s.div = 1.0;\n        s.verts[0].p = a;\n        s.verts[1].p = b;\n        s.verts[2].p = c;\n        for k in 0..3 {\n            s.verts[k].sA = C2v {\n                x: k as f32,\n                y: -(k as f32),\n            };\n            s.verts[k].sB = C2v {\n                x: 10.0 + k as f32,\n                y: -10.0 - k as f32,\n            };\n            s.verts[k].iA = k as i32;\n            s.verts[k].iB = 7 - k as i32;\n        }\n        s\n    };\n    let v = |x: f32, y: f32| C2v { x, y };\n    let mut cases: Vec<(&str, C2Simplex)> = vec![\n        (\"inside\", tri(v(-1.0, -1.0), v(2.0, -1.0), v(0.0, 2.0))),\n        (\"vertexA\", tri(v(1.0, 0.0), v(3.0, 1.0), v(3.0, -1.0))),\n        (\"vertexB\", tri(v(3.0, 1.0), v(1.0, 0.0), v(3.0, -1.0))),\n        (\"vertexC\", tri(v(3.0, 1.0), v(3.0, -1.0), v(1.0, 0.0))),\n        (\"edgeAB\", tri(v(1.0, -2.0), v(1.0, 2.0), v(4.0, 0.0))),\n        (\"edgeBC\", tri(v(4.0, 0.0), v(1.0, -2.0), v(1.0, 2.0))),\n        (\"edgeCA\", tri(v(1.0, 2.0), v(4.0, 0.0), v(1.0, -2.0))),\n        (\"degenerate-collinear\", tri(v(1.0, 1.0), v(2.0, 2.0), v(3.0, 3.0))),\n        (\"all-zero\", tri(v(0.0, 0.0), v(0.0, 0.0), v(0.0, 0.0))),\n        (\"nan\", tri(v(f32::NAN, 0.0), v(1.0, 0.0), v(0.0, 1.0))),\n        (\n            \"inf\",\n            tri(v(f32::INFINITY, 0.0), v(0.0, f32::INFINITY), v(-1.0, -1.0)),\n        ),\n        (\"reverse-winding\", tri(v(-1.0, -1.0), v(0.0, 2.0), v(2.0, -1.0))),\n    ];\n    // report which branch each explicit case hit, for the record\n    let mut explicit_hits = [0usize; 7];\n    for (name, s) in cases.iter_mut() {\n        explicit_hits[c23_branch(&p.c, s)] += 1;\n        let mut sc = *s;\n        let mut sr = *s;\n        unsafe { (p.c.c23)(&raw mut sc) };\n        unsafe { (p.r.c23)(&raw mut sr) };\n        eq_simplex(\"c23\", &format!(\"explicit {name}\"), &sc, &sr);\n    }\n    assert!(\n        explicit_hits.iter().filter(|&&h| h > 0).count() >= 6,\n        \"explicit c23 cases only covered {explicit_hits:?}\"\n    );\n}\n\n// ===========================================================================\n// Row 36 — c2D\n// ===========================================================================\n\n#[test]\nfn cfg36_c2d() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 36);\n    let mut skew = 0usize;\n    let mut ccw = 0usize;\n    for count in [1i32, 2] {\n        for i in 0..N {\n            let s = rng.simplex(count);\n            if count == 2 {\n                let ab = (p.c.c2Sub)(s.verts[1].p, s.verts[0].p);\n                if (p.c.c2Det2)(ab, (p.c.c2Neg)(s.verts[0].p)) > 0.0 {\n                    skew += 1\n                } else {\n                    ccw += 1\n                }\n            }\n            let ctx = format!(\"#{i} count={count} s={s:?}\");\n            let mut sc = s;\n            let mut sr = s;\n            let rc = unsafe { (p.c.c2D)(&raw mut sc) };\n            let rr = unsafe { (p.r.c2D)(&raw mut sr) };\n            eq_v(\"c2D\", &ctx, rc, rr);\n            eq_simplex(\"c2D/no-mutate\", &ctx, &sc, &sr);\n        }\n    }\n    assert!(skew > 100 && ccw > 100, \"c2D branches: skew={skew} ccw={ccw}\");\n}\n\n// ===========================================================================\n// Row 37 — c2L\n// ===========================================================================\n\n#[test]\nfn cfg37_c2l() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 37);\n    for count in [1i32, 2] {\n        for i in 0..N {\n            let mut s = rng.simplex(count);\n            if i % 3 == 0 {\n                s.div = rng.range(1.0e-30, 1.0e30);\n            }\n            let ctx = format!(\"#{i} count={count} s={s:?}\");\n            let mut sc = s;\n            let mut sr = s;\n            let rc = unsafe { (p.c.c2L)(&raw mut sc) };\n            let rr = unsafe { (p.r.c2L)(&raw mut sr) };\n            eq_v(\"c2L\", &ctx, rc, rr);\n            eq_simplex(\"c2L/no-mutate\", &ctx, &sc, &sr);\n        }\n    }\n}\n\n// ===========================================================================\n// Row 38 — c2Witness\n// ===========================================================================\n\n#[test]\nfn cfg38_c2witness() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 38);\n    let run = |api: &Api, s: C2Simplex| -> (C2v, C2v) {\n        let mut ss = s;\n        let mut a = C2v {\n            x: f32::from_bits(0xDEAD_0001),\n            y: f32::from_bits(0xDEAD_0002),\n        };\n        let mut b = C2v {\n            x: f32::from_bits(0xDEAD_0003),\n            y: f32::from_bits(0xDEAD_0004),\n        };\n        unsafe { (api.c2Witness)(&raw mut ss, &raw mut a, &raw mut b) };\n        (a, b)\n    };\n    for count in [1i32, 2, 3] {\n        for i in 0..N {\n            let s = rng.simplex(count);\n            let ctx = format!(\"#{i} count={count} s={s:?}\");\n            let (ac, bc) = run(&p.c, s);\n            let (ar, br) = run(&p.r, s);\n            eq_v(\"c2Witness a\", &ctx, ac, ar);\n            eq_v(\"c2Witness b\", &ctx, bc, br);\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
