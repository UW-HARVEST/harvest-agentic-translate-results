&mut rng, ta);\n        let b = rand_shape(&mut rng, tb);\n        let o = GjkOpts {\n            ax: if rng.below(2) == 0 { None } else { Some(rng.xform()) },\n            bx: if rng.below(2) == 0 { None } else { Some(rng.xform()) },\n            use_radius: rng.below(2) as i32,\n            cache: if rng.below(2) == 0 { None } else { Some(c2GJKCache::default()) },\n            ..Default::default()\n        };\n        let out = unsafe { call_gjk(*cf, &a, &b, &o) };\n        let it = out.iters.unwrap();\n        if (0..32).contains(&it) {\n            hist[it as usize] += 1;\n        }\n        if it > best.0 {\n            best = (it, format!(\"A={} B={} [{}]\", a.show(), b.show(), o.show()));\n        }\n    }\n    println!(\"iteration histogram: {hist:?}\");\n    println!(\"max iterations = {} for {}\", best.0, best.1);\n}\n","structuredPatch":[{"oldStart":14,"oldLines":8,"newStart":14,"newLines":23,"lines":["     for _ in 0..2_000_000 {","         let ta = ALL_TYPES[rng.below(3) as usize];","         let tb = ALL_TYPES[rng.below(3) as usize];","-        let a = rand_shape(&mut rng, ta);","-        let b = rand_shape(&mut rng, tb);","+        let wild = rng.below(2) == 0;","+        let mk = |rng: &mut Rng, t: C2_TYPE| -> Shape {","+            if !wild {","+                return rand_shape(rng, t);","+            }","+            match t {","+                C2_TYPE_CIRCLE => Shape::Circle(c2Circle { p: rng.wild_vec(), r: rng.wild() }),","+                C2_TYPE_AABB => Shape::Aabb(c2AABB { min: rng.wild_vec(), max: rng.wild_vec() }),","+                _ => Shape::Capsule(c2Capsule {","+                    a: rng.wild_vec(),","+                    b: rng.wild_vec(),","+                    r: rng.wild(),","+                }),","+            }","+        };","+        let a = mk(&mut rng, ta);","+        let b = mk(&mut rng, tb);","         let o = GjkOpts {","             ax: if rng.below(2) == 0 { None } else { Some(rng.xform()) },","             bx: if rng