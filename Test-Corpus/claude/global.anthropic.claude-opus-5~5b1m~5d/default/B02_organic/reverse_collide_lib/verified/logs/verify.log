afe(no_mangle)]\n191\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n192\t    let mut r = c2r { c: 0.0, s: 0.0 };\n193\t    r.c = 1.0f32;\n194\t    r.s = 0.0;\n195\t    r\n196\t}\n197\t\n198\t#[unsafe(no_mangle)]\n199\tpub extern \"C\" fn c2xIdentity() -> c2x {\n200\t    let mut x = c2x {\n201\t        p: c2v { x: 0.0, y: 0.0 },\n202\t        r: c2r { c: 0.0, s: 0.0 },\n203\t    };\n204\t    x.p = c2V(0.0, 0.0);\n205\t    x.r = c2RotIdentity();\n206\t    x\n207\t}\n208\t\n209\t#[unsafe(no_mangle)]\n210\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n211\t    *out.offset(0) = (*bb).min;\n212\t    *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n213\t    *out.offset(2) = (*bb).max;\n214\t    *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n215\t}\n216\t\n217\t#[unsafe(no_mangle)]\n218\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: C2_TYPE, p: *mut c2Proxy) {\n219\t    match type_ {\n220\t        C2_TYPE_CIRCLE => {\n221\t            let c = shape as *mut c2Circle;\n222\t            (*p).radius = (*c).r;\n223\t            (*p).count = 1;\n224\t            (*p).verts[0] = (*c).p;\n225\t        }\n226\t        C2_TYPE_AABB => {\n227\t            let bb = shape as *mut c2AABB;\n228\t            (*p).radius = 0.0;\n229\t            (*p).count = 4;\n230\t            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n231\t        }\n232\t        C2_TYPE_CAPSULE => {\n233\t            let c = shape as *mut c2Capsule;\n234\t            (*p).radius = (*c).r;\n235\t            (*p).count = 2;\n236\t            (*p).verts[0] = (*c).a;\n237\t            (*p).verts[1] = (*c).b;\n238\t        }\n239\t        _ => {}\n240\t    }\n241\t}\n242\t\n243\t#[unsafe(no_mangle)]\n244\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n245\t    sqrtf(c2Dot(a, a))\n246\t}\n247\t\n248\t#[unsafe(no_mangle)]\n249\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n250\t    a.x * b.y - a.y * b.x\n251\t}\n252\t\n253\t#[unsafe(no_mangle)]\n254\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n255\t    let verts = (*s).verts.as_mut_ptr();\n256\t    match (*s).count {\n257\t        2 => c2Len(c2Sub((*verts.offset(1)).p, (*verts.offset(0)).p)),\n258\t        3 => c2Det2(\n259\t            c2Sub((*verts.offset(1)).p, (*verts.offset(0)).p),\n260\t            c2Sub((*verts.offset(2)).p, (*verts.offset(0)).p),\n261\t        ),\n262\t        // `default:` falls through into `case 1:` which returns 0.\n263\t        _ => 0.0,\n264\t    }\n265\t}\n266\t\n267\t#[unsafe(no_mangle)]\n268\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n269\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n270\t}\n271\t\n272\t#[unsafe(no_mangle)]\n273\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n274\t    a.x += b.x;\n275\t    a.y += b.y;\n276\t    a\n277\t}\n278\t\n279\t#[unsafe(no_mangle)]\n280\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n281\t    c2Add(c2Mulrv(a.r, b), a.p)\n282\t}\n283\t\n284\t// ---------------------------------------------------------------------------\n285\t// Simplex solvers\n286\t// ---------------------------------------------------------------------------\n287\t\n288\t#[unsafe(no_mangle)]\n289\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n290\t    let verts = (*s).verts.as_mut_ptr();\n291\t    let a = (*verts.offset(0)).p;\n292\t    let b = (*verts.offset(1)).p;\n293\t    let u = c2Dot(b, c2Sub(b, a));\n294\t    let v = c2Dot(a, c2Sub(a, b));\n295\t    if v <= 0.0 {\n296\t        (*verts.offset(0)).u = 1.0f32;\n297\t        (*s).div = 1.0f32;\n298\t        (*s).count = 1;\n299\t    } else if u <= 0.0 {\n300\t        *verts.offset(0) = *verts.offset(1);\n301\t        (*verts.offset(0)).u = 1.0f32;\n302\t        (*s).div = 1.0f32;\n303\t        (*s).count = 1;\n304\t    } else {\n305\t        (*verts.offset(0)).u = u;\n306\t        (*verts.offset(1)).u = v;\n307\t        (*s).div = u + v;\n308\t        (*s).count = 2;\n309\t    }\n310\t}\n311\t\n312\t#[unsafe(no_mangle)]\n313\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n314\t    let verts = (*s).verts.as_mut_ptr();\n315\t    let a = (*verts.offset(0)).p;\n316\t    let b = (*verts.offset(1)).p;\n317\t    let c = (*verts.offset(2)).p;\n318\t    let uAB = c2Dot(b, c2Sub(b, a));\n319\t    let vAB = c2Dot(a, c2Sub(a, b));\n320\t    let uBC = c2Dot(c, c2Sub(c, b));\n321\t    let vBC = c2Dot(b, c2Sub(b, c));\n322\t    let uCA = c2Dot(a, c2Sub(a, c));\n323\t    let vCA = c2Dot(c, c2Sub(c, a));\n324\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n325\t    let uABC = c2Det2(b, c) * area;\n326\t    let vABC = c2Det2(c, a) * area;\n327\t    let wABC = c2Det2(a, b) * area;\n328\t    if vAB <= 0.0 && uCA <= 0.0 {\n329\t        (*verts.offset(0)).u = 1.0f32;\n330\t        (*s).div = 1.0f32;\n331\t        (*s).count = 1;\n332\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n333\t        *verts.offset(0) = *verts.offset(1);\n334\t        (*verts.offset(0)).u = 1.0f32;\n335\t        (*s).div = 1.0f32;\n336\t        (*s).count = 1;\n337\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n338\t        *verts.offset(0) = *verts.offset(2);\n339\t        (*verts.offset(0)).u = 1.0f32;\n340\t        (*s).div = 1.0f32;\n341\t        (*s).count = 1;\n342\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n343\t        (*verts.offset(0)).u = uAB;\n344\t        (*verts.offset(1)).u = vAB;\n345\t        (*s).div = uAB + vAB;\n346\t        (*s).count = 2;\n347\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n348\t        *verts.offset(0) = *verts.offset(1);\n349\t        *verts.offset(1) = *verts.offset(2);\n350\t        (*verts.offset(0)).u = uBC;\n351\t        (*verts.offset(1)).u = vBC;\n352\t        (*s).div = uBC + vBC;\n353\t        (*s).count = 2;\n354\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n355\t        *verts.offset(1) = *verts.offset(0);\n356\t        *verts.offset(0) = *verts.offset(2);\n357\t        (*verts.offset(0)).u = uCA;\n358\t        (*verts.offset(1)).u = vCA;\n359\t        (*s).div = uCA + vCA;\n360\t        (*s).count = 2;\n361\t    } else {\n362\t        (*verts.offset(0)).u = uABC;\n363\t        (*verts.offset(1)).u = vABC;\n364\t        (*verts.offset(2)).u = wABC;\n365\t        (*s).div = uABC + vABC + wABC;\n366\t        (*s).count = 3;\n367\t    }\n368\t}\n369\t\n370\t#[unsafe(no_mangle)]\n371\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n372\t    c2V(-a.x, -a.y)\n373\t}\n374\t\n375\t#[unsafe(no_mangle)]\n376\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n377\t    let mut b = c2v { x: 0.0, y: 0.0 };\n378\t    b.x = -a.y;\n379\t    b.y = a.x;\n380\t    b\n381\t}\n382\t\n383\t#[unsafe(no_mangle)]\n384\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n385\t    let mut b = c2v { x: 0.0, y: 0.0 };\n386\t    b.x = a.y;\n387\t    b.y = -a.x;\n388\t    b\n389\t}\n390\t\n391\t#[unsafe(no_mangle)]\n392\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n393\t    let verts = (*s).verts.as_mut_ptr();\n394\t    match (*s).count {\n395\t        1 => c2Neg((*verts.offset(0)).p),\n396\t        2 => {\n397\t            let ab = c2Sub((*verts.offset(1)).p, (*verts.offset(0)).p);\n398\t            if c2Det2(ab, c2Neg((*verts.offset(0)).p)) > 0.0 {\n399\t                return c2Skew(ab);\n400\t            }\n401\t            c2CCW90(ab)\n402\t        }\n403\t        // case 3 and default\n404\t        _ => c2V(0.0, 0.0),\n405\t    }\n406\t}\n407\t\n408\t#[unsafe(no_mangle)]\n409\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n410\t    let mut imax: c_int = 0;\n411\t    let mut dmax = c2Dot(*verts.offset(0), d);\n412\t    let mut i: c_int = 1;\n413\t    while i < count {\n414\t        let dot = c2Dot(*verts.offset(i as isize), d);\n415\t        if dot > dmax {\n416\t            imax = i;\n417\t            dmax = dot;\n418\t        }\n419\t        i += 1;\n420\t    }\n421\t    imax\n422\t}\n423\t\n424\t#[unsafe(no_mangle)]\n425\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n426\t    let verts = (*s).verts.as_mut_ptr();\n427\t    let den = 1.0f32 / (*s).div;\n428\t    match (*s).count {\n429\t        1 => {\n430\t            *a = (*verts.offset(0)).sA;\n431\t            *b = (*verts.offset(0)).sB;\n432\t        }\n433\t        2 => {\n434\t            *a = c2Add(\n435\t                c2Mulvs((*verts.offset(0)).sA, den * (*verts.offset(0)).u),\n436\t                c2Mulvs((*verts.offset(1)).sA, den * (*verts.offset(1)).u),\n437\t            );\n438\t            *b = c2Add(\n439\t                c2Mulvs((*verts.offset(0)).sB, den * (*verts.offset(0)).u),\n440\t                c2Mulvs((*verts.offset(1)).sB, den * (*verts.offset(1)).u),\n441\t            );\n442\t        }\n443\t        3 => {\n444\t            *a = c2Add(\n445\t                c2Add(\n446\t                    c2Mulvs((*verts.offset(0)).sA, den * (*verts.offset(0)).u),\n447\t                    c2Mulvs((*verts.offset(1)).sA, den * (*verts.offset(1)).u),\n448\t                ),\n449\t                c2Mulvs((*verts.offset(2)).sA, den * (*verts.offset(2)).u),\n450\t            );\n451\t            *b = c2Add(\n452\t                c2Add(\n453\t                    c2Mulvs((*verts.offset(0)).sB, den * (*verts.offset(0)).u),\n454\t                    c2Mulvs((*verts.offset(1)).sB, den * (*verts.offset(1)).u),\n455\t                ),\n456\t                c2Mulvs((*verts.offset(2)).sB, den * (*verts.offset(2)).u),\n457\t            );\n458\t        }\n459\t        _ => {\n460\t            *a = c2V(0.0, 0.0);\n461\t            *b = c2V(0.0, 0.0);\n462\t        }\n463\t    }\n464\t}\n465\t\n466\t#[unsafe(no_mangle)]\n467\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n468\t    c2Mulvs(a, 1.0f32 / b)\n469\t}\n470\t\n471\t#[unsafe(no_mangle)]\n472\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n473\t    c2Div(a, c2Len(a))\n474\t}\n475\t\n476\t#[unsafe(no_mangle)]\n477\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n478\t    let verts = (*s).verts.as_mut_ptr();\n479\t    let den = 1.0f32 / (*s).div;\n480\t    match (*s).count {\n481\t        1 => (*verts.offset(0)).p,\n482\t        2 => c2Add(\n483\t            c2Mulvs((*verts.offset(0)).p, den * (*verts.offset(0)).u),\n484\t            c2Mulvs((*verts.offset(1)).p, den * (*verts.offset(1)).u),\n485\t        ),\n486\t        _ => c2V(0.0, 0.0),\n487\t    }\n488\t}\n489\t\n490\t#[unsafe(no_mangle)]\n491\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n492\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n493\t}\n494\t\n495\t// ---------------------------------------------------------------------------\n496\t// GJK\n497\t// ---------------------------------------------------------------------------\n498\t\n499\t#[unsafe(no_mangle)]\n500\tpub unsafe extern \"C\" fn c2GJK(\n501\t    A: *const c_void,\n502\t    typeA: C2_TYPE,\n503\t    ax_ptr: *const c2x,\n504\t    B: *const c_void,\n505\t    typeB: C2_TYPE,\n506\t    bx_ptr: *const c2x,\n507\t    outA: *mut c2v,\n508\t    outB: *mut c2v,\n509\t    use_radius: c_int,\n510\t    iterations: *mut c_int,\n511\t    cache: *mut c2GJKCache,\n512\t) -> f32 {\n513\t    let ax: c2x;\n514\t    let bx: c2x;\n515\t    if ax_ptr.is_null() {\n516\t        ax = c2xIdentity();\n517\t    } else {\n518\t        ax = *ax_ptr;\n519\t    }\n520\t    if bx_ptr.is_null() {\n521\t        bx = c2xIdentity();\n522\t    } else {\n523\t        bx = *bx_ptr;\n524\t    }\n525\t    let mut pA = c2Proxy::default();\n526\t    let mut pB = c2Proxy::default();\n527\t    c2MakeProxy(A, typeA, &mut pA);\n528\t    c2MakeProxy(B, typeB, &mut pB);\n529\t    let mut s = c2Simplex::default();\n530\t    let verts: *mut c2sv = s.verts.as_mut_ptr();\n531\t    let pA_verts: *const c2v = pA.verts.as_ptr();\n532\t    let pB_verts: *const c2v = pB.verts.as_ptr();\n533\t    let mut cache_was_read: c_int = 0;\n534\t    if !cache.is_null() {\n535\t        let cache_was_good = (*cache).count != 0;\n536\t        if cache_was_good {\n537\t            let mut i: c_int = 0;\n538\t            while i < (*cache).count {\n539\t                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n540\t                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n541\t                let sA = c2Mulxv(ax, *pA_verts.offset(iA as isize));\n542\t                let sB = c2Mulxv(bx, *pB_verts.offset(iB as isize));\n543\t                let v = verts.offset(i as isize);\n544\t                (*v).iA = iA;\n545\t                (*v).sA = sA;\n546\t                (*v).iB = iB;\n547\t                (*v).sB = sB;\n548\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n549\t                (*v).u = 0.0;\n550\t                i += 1;\n551\t            }\n552\t            s.count = (*cache).count;\n553\t            s.div = (*cache).div;\n554\t            let metric_old = (*cache).metric;\n555\t            let metric = c2GJKSimplexMetric(&mut s);\n556\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n557\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n558\t            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n559\t                cache_was_read = 1;\n560\t            }\n561\t        }\n562\t    }\n563\t    if cache_was_read == 0 {\n564\t        (*verts.offset(0)).iA = 0;\n565\t        (*verts.offset(0)).iB = 0;\n566\t        (*verts.offset(0)).sA = c2Mulxv(ax, *pA_verts.offset(0));\n567\t        (*verts.offset(0)).sB = c2Mulxv(bx, *pB_verts.offset(0));\n568\t        (*verts.offset(0)).p = c2Sub((*verts.offset(0)).sB, (*verts.offset(0)).sA);\n569\t        (*verts.offset(0)).u = 1.0f32;\n570\t        s.div = 1.0f32;\n571\t        s.count = 1;\n572\t    }\n573\t    let mut saveA: [c_int; 3] = [0; 3];\n574\t    let mut saveB: [c_int; 3] = [0; 3];\n575\t    let saveA_p: *mut c_int = saveA.as_mut_ptr();\n576\t    let saveB_p: *mut c_int = saveB.as_mut_ptr();\n577\t    let mut save_count: c_int;\n578\t    let mut d0: f32 = C2_FLT_MAX;\n579\t    let mut d1: f32;\n580\t    let mut iter: c_int = 0;\n581\t    let mut hit: c_int = 0;\n582\t    while iter < 20 {\n583\t        save_count = s.count;\n584\t        let mut i: c_int = 0;\n585\t        while i < save_count {\n586\t            *saveA_p.offset(i as isize) = (*verts.offset(i as isize)).iA;\n587\t            *saveB_p.offset(i as isize) = (*verts.offset(i as isize)).iB;\n588\t            i += 1;\n589\t        }\n590\t        match s.count {\n591\t            1 => {}\n592\t            2 => c22(&mut s),\n593\t            3 => c23(&mut s),\n594\t            _ => {}\n595\t        }\n596\t        if s.count == 3 {\n597\t            hit = 1;\n598\t            break;\n599\t        }\n600\t        let p = c2L(&mut s);\n601\t        d1 = c2Dot(p, p);\n602\t        if d1 > d0 {\n603\t            break;\n604\t        }\n605\t        d0 = d1;\n606\t        let d = c2D(&mut s);\n607\t        if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n608\t            break;\n609\t        }\n610\t        let iA = c2Support(pA_verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\n611\t        let sA = c2Mulxv(ax, *pA_verts.offset(iA as isize));\n612\t        let iB = c2Support(pB_verts, pB.count, c2MulrvT(bx.r, d));\n613\t        let sB = c2Mulxv(bx, *pB_verts.offset(iB as isize));\n614\t        let v = verts.offset(s.count as isize);\n615\t        (*v).iA = iA;\n616\t        (*v).sA = sA;\n617\t        (*v).iB = iB;\n618\t        (*v).sB = sB;\n619\t        (*v).p = c2Sub((*v).sB, (*v).sA);\n620\t        let mut dup: c_int = 0;\n621\t        let mut j: c_int = 0;\n622\t        while j < save_count {\n623\t            if iA == *saveA_p.offset(j as isize) && iB == *saveB_p.offset(j as isize) {\n624\t                dup = 1;\n625\t                break;\n626\t            }\n627\t            j += 1;\n628\t        }\n629\t        if dup != 0 {\n630\t            break;\n631\t        }\n632\t        s.count += 1;\n633\t        iter += 1;\n634\t    }\n635\t    let mut a = c2v { x: 0.0, y: 0.0 };\n636\t    let mut b = c2v { x: 0.0, y: 0.0 };\n637\t    c2Witness(&mut s, &mut a, &mut b);\n638\t    let mut dist = c2Len(c2Sub(a, b));\n639\t    if hit != 0 {\n640\t        a = b;\n641\t        dist = 0.0;\n642\t    } else if use_radius != 0 {\n643\t        let rA = pA.radius;\n644\t        let rB = pB.radius;\n645\t        if dist > rA + rB && dist > C2_FLT_EPSILON {\n646\t            dist -= rA + rB;\n647\t            let n = c2Norm(c2Sub(b, a));\n648\t            a = c2Add(a, c2Mulvs(n, rA));\n649\t            b = c2Sub(b, c2Mulvs(n, rB));\n650\t            if a.x == b.x && a.y == b.y {\n651\t                dist = 0.0;\n652\t            }\n653\t        } else {\n654\t            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n655\t            a = p;\n656\t            b = p;\n657\t            dist = 0.0;\n658\t        }\n659\t    }\n660\t    if !cache.is_null() {\n661\t        (*cache).metric = c2GJKSimplexMetric(&mut s);\n662\t        (*cache).count = s.count;\n663\t        let mut i: c_int = 0;\n664\t        while i < s.count {\n665\t            let v = verts.offset(i as isize);\n666\t            *(*cache).iA.as_mut_ptr().offset(i as isize) = (*v).iA;\n667\t            *(*cache).iB.as_mut_ptr().offset(i as isize) = (*v).iB;\n668\t            i += 1;\n669\t        }\n670\t        (*cache).div = s.div;\n671\t    }\n672\t    if !outA.is_null() {\n673\t        *outA = a;\n674\t    }\n675\t    if !outB.is_null() {\n676\t        *outB = b;\n677\t    }\n678\t    if !iterations.is_null() {\n679\t        *iterations = iter;\n680\t    }\n681\t    dist\n682\t}\n683\t\n684\t// ---------------------------------------------------------------------------\n685\t// Boolean collision routines\n686\t// ---------------------------------------------------------------------------\n687\t\n688\t#[unsafe(no_mangle)]\n689\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n690\t    let d0: c_int = (B.max.x < A.min.x) as c_int;\n691\t    let d1: c_int = (A.max.x < B.min.x)