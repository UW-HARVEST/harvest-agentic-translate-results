{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_cbnsrsmo5hx2b5gzo45dhjvygdk2yltaplu7uv2ndlyfjs63upfq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01THa6UVyw44enkVSzG9FGLu","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-lBJjNJ/translation/tests/phase_b_highlevel.rs","content":"//! Phase B — the boolean predicates, `c2Collided` and `reverse_collide`\n//! (CONFIGS.md rows 62-71).\n\n#![allow(non_snake_case)]\n\nmod common;\nuse common::*;\n\nconst SEED: u64 = 0x_5DEE_CE66_D000_0000;\nconst N: usize = 20_000;\n\nfn ulp_up(x: f32) -> f32 {\n    f32::from_bits(x.to_bits().wrapping_add(1))\n}\nfn ulp_dn(x: f32) -> f32 {\n    f32::from_bits(x.to_bits().wrapping_sub(1))\n}\n\n// ===========================================================================\n// Row 62 — c2AABBtoAABB\n// ===========================================================================\n\n#[test]\nfn cfg62_aabb_to_aabb() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 62);\n    for i in 0..N {\n        let a = rng.aabb();\n        let b = rng.aabb();\n        let ctx = format!(\"#{i} A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2AABBtoAABB\",\n            &ctx,\n            (p.c.c2AABBtoAABB)(a, b),\n            (p.r.c2AABBtoAABB)(a, b),\n        );\n    }\n    // exhaustive integral grid: every relative placement including exact touching\n    let unit = |x: f32, y: f32| C2AABB {\n        min: C2v { x, y },\n        max: C2v { x: x + 2.0, y: y + 2.0 },\n    };\n    let base = unit(0.0, 0.0);\n    for dx in -6..=6 {\n        for dy in -6..=6 {\n            let b = unit(dx as f32, dy as f32);\n            let ctx = format!(\"grid dx={dx} dy={dy}\");\n            eq_i32(\n                \"c2AABBtoAABB\",\n                &ctx,\n                (p.c.c2AABBtoAABB)(base, b),\n                (p.r.c2AABBtoAABB)(base, b),\n            );\n        }\n    }\n    // the four separating-axis boundaries, at, one-ULP-inside and one-ULP-outside\n    for edge in 0..4 {\n        for shift in [0.0f32, 1.0, -1.0] {\n            let mut b = unit(0.0, 0.0);\n            let d = 2.0 + shift;\n            match edge {\n                0 => {\n                    b.min.x += d;\n                    b.max.x += d;\n                }\n                1 => {\n                    b.min.x -= d;\n                    b.max.x -= d;\n                }\n                2 => {\n                    b.min.y += d;\n                    b.max.y += d;\n                }\n                _ => {\n                    b.min.y -= d;\n                    b.max.y -= d;\n                }\n            }\n            for tweak in [0i32, 1, -1] {\n                let mut bb = b;\n                if tweak != 0 {\n                    bb.min.x = if tweak > 0 {\n                        ulp_up(bb.min.x)\n                    } else {\n                        ulp_dn(bb.min.x)\n                    };\n                    bb.min.y = if tweak > 0 {\n                        ulp_up(bb.min.y)\n                    } else {\n                        ulp_dn(bb.min.y)\n                    };\n                }\n                let ctx = format!(\"edge{edge} shift={shift} tweak={tweak} B={bb:?}\");\n                eq_i32(\n                    \"c2AABBtoAABB\",\n                    &ctx,\n                    (p.c.c2AABBtoAABB)(base, bb),\n                    (p.r.c2AABBtoAABB)(base, bb),\n                );\n            }\n        }\n    }\n    // containment, identity, zero-extent, inverted, NaN, inf\n    let z = C2v { x: 0.0, y: 0.0 };\n    let specials = [\n        C2AABB { min: z, max: z },\n        C2AABB {\n            min: C2v { x: 1.0, y: 1.0 },\n            max: C2v { x: -1.0, y: -1.0 },\n        },\n        C2AABB {\n            min: C2v {\n                x: f32::NAN,\n                y: 0.0,\n            },\n            max: C2v { x: 1.0, y: 1.0 },\n        },\n        C2AABB {\n            min: C2v {\n                x: f32::NEG_INFINITY,\n                y: f32::NEG_INFINITY,\n            },\n            max: C2v {\n                x: f32::INFINITY,\n                y: f32::INFINITY,\n            },\n        },\n        C2AABB {\n            min: C2v { x: -100.0, y: -100.0 },\n            max: C2v { x: 100.0, y: 100.0 },\n        },\n        C2AABB {\n            min: C2v { x: -0.0, y: -0.0 },\n            max: C2v { x: 0.0, y: 0.0 },\n        },\n    ];\n    for a in specials {\n        for b in specials {\n            let ctx = format!(\"special A={a:?} B={b:?}\");\n            eq_i32(\n                \"c2AABBtoAABB\",\n                &ctx,\n                (p.c.c2AABBtoAABB)(a, b),\n                (p.r.c2AABBtoAABB)(a, b),\n            );\n        }\n    }\n}\n\n// ===========================================================================\n// Row 63 — c2CircletoCircle\n// ===========================================================================\n\n#[test]\nfn cfg63_circle_to_circle() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 63);\n    for i in 0..N {\n        let a = rng.circle();\n        let b = rng.circle();\n        let ctx = format!(\"#{i} A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2CircletoCircle\",\n            &ctx,\n            (p.c.c2CircletoCircle)(a, b),\n            (p.r.c2CircletoCircle)(a, b),\n        );\n    }\n    // exact-touching / one-ULP either side / zero / negative radii / concentric\n    for (ra, rb) in [\n        (0.0f32, 0.0f32),\n        (0.0, 5.0),\n        (5.0, 0.0),\n        (3.0, 4.0),\n        (-2.0, 2.0),\n        (-3.0, -4.0),\n        (1.0e20, 1.0e20),\n        (-0.0, 0.0),\n    ] {\n        let sum = ra + rb;\n        for d in [\n            0.0f32,\n            sum,\n            ulp_dn(sum),\n            ulp_up(sum),\n            sum * 0.5,\n            sum * 2.0,\n            f32::NAN,\n            f32::INFINITY,\n        ] {\n            let a = C2Circle {\n                p: C2v { x: 0.0, y: 0.0 },\n                r: ra,\n            };\n            let b = C2Circle {\n                p: C2v { x: d, y: 0.0 },\n                r: rb,\n            };\n            let ctx = format!(\"touch ra={ra} rb={rb} d={d:?}\");\n            eq_i32(\n                \"c2CircletoCircle\",\n                &ctx,\n                (p.c.c2CircletoCircle)(a, b),\n                (p.r.c2CircletoCircle)(a, b),\n            );\n        }\n    }\n}\n\n// ===========================================================================\n// Row 64 — c2CircletoAABB (all 9 Voronoi regions of the clamp)\n// ===========================================================================\n\n#[test]\nfn cfg64_circle_to_aabb() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 64);\n    for i in 0..N {\n        let a = rng.circle();\n        let b = rng.aabb();\n        let ctx = format!(\"#{i} A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2CircletoAABB\",\n            &ctx,\n            (p.c.c2CircletoAABB)(a, b),\n            (p.r.c2CircletoAABB)(a, b),\n        );\n    }\n    // 9 regions around a unit box, times a set of radii, times ULP tweaks\n    let bb = C2AABB {\n        min: C2v { x: -1.0, y: -1.0 },\n        max: C2v { x: 1.0, y: 1.0 },\n    };\n    let coords = [-3.0f32, -1.0, -0.5, 0.0, 0.5, 1.0, 3.0];\n    for &cx in &coords {\n        for &cy in &coords {\n            for r in [0.0f32, -0.0, -1.0, 0.5, 1.0, 2.0, 5.0] {\n                for tweak in [0i32, 1, -1] {\n                    let rr = match tweak {\n                        1 => ulp_up(r),\n                        -1 => ulp_dn(r),\n                        _ => r,\n                    };\n                    let a = C2Circle {\n                        p: C2v { x: cx, y: cy },\n                        r: rr,\n                    };\n                    let ctx = format!(\"region c=({cx},{cy}) r={rr:?}\");\n                    eq_i32(\n                        \"c2CircletoAABB\",\n                        &ctx,\n                        (p.c.c2CircletoAABB)(a, bb),\n                        (p.r.c2CircletoAABB)(a, bb),\n                    );\n                }\n            }\n        }\n    }\n    // inverted / zero-extent / NaN boxes\n    let boxes = [\n        C2AABB {\n            min: C2v { x: 1.0, y: 1.0 },\n            max: C2v { x: -1.0, y: -1.0 },\n        },\n        C2AABB {\n            min: C2v { x: 0.0, y: 0.0 },\n            max: C2v { x: 0.0, y: 0.0 },\n        },\n        C2AABB {\n            min: C2v {\n                x: f32::NAN,\n                y: -1.0,\n            },\n            max: C2v { x: 1.0, y: 1.0 },\n        },\n        C2AABB {\n            min: C2v {\n                x: f32::NEG_INFINITY,\n                y: -1.0,\n            },\n            max: C2v {\n                x: f32::INFINITY,\n                y: 1.0,\n            },\n        },\n    ];\n    for b in boxes {\n        for r in [0.0f32, 1.0, f32::INFINITY, f32::NAN] {\n            for c in [\n                C2v { x: 0.0, y: 0.0 },\n                C2v { x: 5.0, y: 5.0 },\n                C2v {\n                    x: f32::NAN,\n                    y: 0.0,\n                },\n            ] {\n                let a = C2Circle { p: c, r };\n                let ctx = format!(\"weird A={a:?} B={b:?}\");\n                eq_i32(\n                    \"c2CircletoAABB\",\n                    &ctx,\n                    (p.c.c2CircletoAABB)(a, b),\n                    (p.r.c2CircletoAABB)(a, b),\n                );\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 65 — c2CircletoCapsule (the three Voronoi regions)\n// ===========================================================================\n\n#[test]\nfn cfg65_circle_to_capsule() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 65);\n    let mut regions = [0usize; 3];\n    for i in 0..N {\n        let a = rng.circle();\n        let b = rng.capsule();\n        // classify with the C's own primitives\n        let n = (p.c.c2Sub)(b.b, b.a);\n        let ap = (p.c.c2Sub)(a.p, b.a);\n        let da = (p.c.c2Dot)(ap, n);\n        let reg = if da < 0.0 {\n            0\n        } else if (p.c.c2Dot)((p.c.c2Sub)(a.p, b.b), n) < 0.0 {\n            1\n        } else {\n            2\n        };\n        regions[reg] += 1;\n        let ctx = format!(\"#{i} region={reg} A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2CircletoCapsule\",\n            &ctx,\n            (p.c.c2CircletoCapsule)(a, b),\n            (p.r.c2CircletoCapsule)(a, b),\n        );\n    }\n    assert!(\n        regions.iter().all(|&r| r > 100),\n        \"capsule Voronoi regions not covered: {regions:?}\"\n    );\n\n    // hand-built: along the axis, off the shaft, at each cap, degenerate capsule\n    let cap = C2Capsule {\n        a: C2v { x: -5.0, y: 0.0 },\n        b: C2v { x: 5.0, y: 0.0 },\n        r: 2.0,\n    };\n    let degen = C2Capsule {\n        a: C2v { x: 1.0, y: 1.0 },\n        b: C2v { x: 1.0, y: 1.0 },\n        r: 2.0,\n    };\n    let zeror = C2Capsule {\n        a: C2v { x: -5.0, y: 0.0 },\n        b: C2v { x: 5.0, y: 0.0 },\n        r: 0.0,\n    };\n    let negr = C2Capsule {\n        a: C2v { x: -5.0, y: 0.0 },\n        b: C2v { x: 5.0, y: 0.0 },\n        r: -2.0,\n    };\n    for capsule in [cap, degen, zeror, negr] {\n        for x in [-10.0f32, -7.0, -5.0, -2.5, 0.0, 2.5, 5.0, 7.0, 10.0, 1.0] {\n            for y in [-10.0f32, -4.0, -2.0, 0.0, 2.0, 4.0, 10.0, 1.0] {\n                for r in [0.0f32, -0.0, -1.0, 2.0, ulp_dn(2.0), ulp_up(2.0), 100.0] {\n                    let a = C2Circle {\n                        p: C2v { x, y },\n                        r,\n                    };\n                    let ctx = format!(\"explicit A={a:?} B={capsule:?}\");\n                    eq_i32(\n                        \"c2CircletoCapsule\",\n                        &ctx,\n                        (p.c.c2CircletoCapsule)(a, capsule),\n                        (p.r.c2CircletoCapsule)(a, capsule),\n                    );\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 66 — c2AABBtoCapsule (drives the full GJK pipeline)\n// ===========================================================================\n\n#[test]\nfn cfg66_aabb_to_capsule() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 66);\n    for i in 0..N {\n        let a = rng.aabb();\n        let b = rng.capsule();\n        let ctx = format!(\"#{i} A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2AABBtoCapsule\",\n            &ctx,\n            (p.c.c2AABBtoCapsule)(a, b),\n            (p.r.c2AABBtoCapsule)(a, b),\n        );\n    }\n    // bounded scene so hits are frequent\n    for i in 0..N {\n        let bx = rng.range(-20.0, 20.0);\n        let by = rng.range(-20.0, 20.0);\n        let a = C2AABB {\n            min: C2v { x: -5.0, y: -5.0 },\n            max: C2v { x: 5.0, y: 5.0 },\n        };\n        let b = C2Capsule {\n            a: C2v { x: bx, y: by },\n            b: C2v {\n                x: bx + rng.range(-15.0, 15.0),\n                y: by + rng.range(-15.0, 15.0),\n            },\n            r: rng.range(0.0, 8.0),\n        };\n        let ctx = format!(\"#{i} scene A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2AABBtoCapsule\",\n            &ctx,\n            (p.c.c2AABBtoCapsule)(a, b),\n            (p.r.c2AABBtoCapsule)(a, b),\n        );\n    }\n    // explicit: outside / touching / crossing / inside, axis-aligned and diagonal\n    let bb = C2AABB {\n        min: C2v { x: -5.0, y: -5.0 },\n        max: C2v { x: 5.0, y: 5.0 },\n    };\n    let caps = [\n        C2Capsule {\n            a: C2v { x: -20.0, y: 0.0 },\n            b: C2v { x: -10.0, y: 0.0 },\n            r: 1.0,\n        },\n        C2Capsule {\n            a: C2v { x: -20.0, y: 0.0 },\n            b: C2v { x: -6.0, y: 0.0 },\n            r: 1.0,\n        },\n        C2Capsule {\n            a: C2v { x: -20.0, y: 0.0 },\n            b: C2v { x: 20.0, y: 0.0 },\n            r: 1.0,\n        },\n        C2Capsule {\n            a: C2v { x: -1.0, y: -1.0 },\n            b: C2v { x: 1.0, y: 1.0 },\n            r: 0.5,\n        },\n        C2Capsule {\n            a: C2v { x: -20.0, y: -20.0 },\n            b: C2v { x: 20.0, y: 20.0 },\n            r: 0.5,\n        },\n        C2Capsule {\n            a: C2v { x: 0.0, y: 0.0 },\n            b: C2v { x: 0.0, y: 0.0 },\n            r: 0.0,\n        },\n        C2Capsule {\n            a: C2v { x: 0.0, y: 0.0 },\n            b: C2v { x: 0.0, y: 0.0 },\n            r: 100.0,\n        },\n        C2Capsule {\n            a: C2v { x: 5.0, y: 5.0 },\n            b: C2v { x: 10.0, y: 10.0 },\n            r: 0.0,\n        },\n    ];\n    let boxes = [\n        bb,\n        C2AABB {\n            min: C2v { x: 0.0, y: 0.0 },\n            max: C2v { x: 0.0, y: 0.0 },\n        },\n        C2AABB {\n            min: C2v { x: 5.0, y: 5.0 },\n            max: C2v { x: -5.0, y: -5.0 },\n        },\n    ];\n    for b in boxes {\n        for c in caps {\n            let ctx = format!(\"explicit A={b:?} B={c:?}\");\n            eq_i32(\n                \"c2AABBtoCapsule\",\n                &ctx,\n                (p.c.c2AABBtoCapsule)(b, c),\n                (p.r.c2AABBtoCapsule)(b, c),\n            );\n        }\n    }\n}\n\n// ===========================================================================\n// Row 67 — c2CapsuletoCapsule\n// ===========================================================================\n\n#[test]\nfn cfg67_capsule_to_capsule() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 67);\n    for i in 0..N {\n        let a = rng.capsule();\n        let b = rng.capsule();\n        let ctx = format!(\"#{i} A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2CapsuletoCapsule\",\n            &ctx,\n            (p.c.c2CapsuletoCapsule)(a, b),\n            (p.r.c2CapsuletoCapsule)(a, b),\n        );\n    }\n    for i in 0..N {\n        let mk = |rng: &mut Rng| C2Capsule {\n            a: C2v {\n                x: rng.range(-15.0, 15.0),\n                y: rng.range(-15.0, 15.0),\n            },\n            b: C2v {\n                x: rng.range(-15.0, 15.0),\n                y: rng.range(-15.0, 15.0),\n            },\n            r: rng.range(0.0, 6.0),\n        };\n        let a = mk(&mut rng);\n        let b = mk(&mut rng);\n        let ctx = format!(\"#{i} scene A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2CapsuletoCapsule\",\n            &ctx,\n            (p.c.c2CapsuletoCapsule)(a, b),\n            (p.r.c2CapsuletoCapsule)(a, b),\n        );\n    }\n    // parallel / crossing / collinear / end-to-end / degenerate\n    let cases: Vec<(C2Capsule, C2Capsule)> = vec![\n        // parallel, separated then touching\n        (\n            C2Capsule {\n                a: C2v { x: -5.0, y: 0.0 },\n                b: C2v { x: 5.0, y: 0.0 },\n                r: 1.0,\n            },\n            C2Capsule {\n                a: C2v { x: -5.0, y: 5.0 },\n                b: C2v { x: 5.0, y: 5.0 },\n                r: 1.0,\n            },\n        ),\n        (\n            C2Capsule {\n                a: C2v { x: -5.0, y: 0.0 },\n                b: C2v { x: 5.0, y: 0.0 },\n                r: 1.0,\n            },\n            C2Capsule {\n                a: C2v { x: -5.0, y: 2.0 },\n                b: C2v { x: 5.0, y: 2.0 },\n                r: 1.0,\n            },\n        ),\n        // crossing\n        (\n            C2Capsule {\n                a: C2v { x: -5.0, y: 0.0 },\n                b: C2v { x: 5.0, y: 0.0 },\n                r: 0.5,\n            },\n            C2Capsule {\n                a: C2v { x: 0.0, y: -5.0 },\n                b: C2v { x: 0.0, y: 5.0 },\n                r: 0.5,\n            },\n        ),\n        // collinear overlapping\n        (\n            C2Capsule {\n                a: C2v { x: -5.0, y: 0.0 },\n                b: C2v { x: 5.0, y: 0.0 },\n                r: 1.0,\n            },\n            C2Capsule {\n                a: C2v { x: 0.0, y: 0.0 },\n                b: C2v { x: 10.0, y: 0.0 },\n                r: 1.0,\n            },\n        ),\n        // end to end exactly touching\n        (\n            C2Capsule {\n                a: C2v { x: -5.0, y: 0.0 },\n                b: C2v { x: 0.0, y: 0.0 },\n                r: 1.0,\n            },\n            C2Capsule {\n                a: C2v { x: 2.0, y: 0.0 },\n                b: C2v { x: 7.0, y: 0.0 },\n                r: 1.0,\n            },\n        ),\n        // both degenerate (points)\n        (\n            C2Capsule {\n                a: C2v { x: 0.0, y: 0.0 },\n                b: C2v { x: 0.0, y: 0.0 },\n                r: 1.0,\n            },\n            C2Capsule {\n                a: C2v { x: 2.0, y: 0.0 },\n                b: C2v { x: 2.0, y: 0.0 },\n                r: 1.0,\n            },\n        ),\n        // one degenerate, zero radius\n        (\n            C2Capsule {\n                a: C2v { x: 0.0, y: 0.0 },\n                b: C2v { x: 0.0, y: 0.0 },\n                r: 0.0,\n            },\n            C2Capsule {\n                a: C2v { x: -5.0, y: 0.0 },\n                b: C2v { x: 5.0, y: 0.0 },\n                r: 0.0,\n            },\n        ),\n        // identical\n        (\n            C2Capsule {\n                a: C2v { x: -3.0, y: 1.0 },\n                b: C2v { x: 3.0, y: -1.0 },\n                r: 2.0,\n            },\n            C2Capsule {\n                a: C2v { x: -3.0, y: 1.0 },\n                b: C2v { x: 3.0, y: -1.0 },\n                r: 2.0,\n            },\n        ),\n        // negative radii\n        (\n            C2Capsule {\n                a: C2v { x: -3.0, y: 0.0 },\n                b: C2v { x: 3.0, y: 0.0 },\n                r: -2.0,\n            },\n            C2Capsule {\n                a: C2v { x: -3.0, y: 1.0 },\n                b: C2v { x: 3.0, y: 1.0 },\n                r: -2.0,\n            },\n        ),\n    ];\n    for (a, b) in cases {\n        let ctx = format!(\"explicit A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2CapsuletoCapsule\",\n            &ctx,\n            (p.c.c2CapsuletoCapsule)(a, b),\n            (p.r.c2CapsuletoCapsule)(a, b),\n        );\n        // and the reversed argument order\n        let ctx = format!(\"explicit-rev A={b:?} B={a:?}\");\n        eq_i32(\n            \"c2CapsuletoCapsule\",\n            &ctx,\n            (p.c.c2CapsuletoCapsule)(b, a),\n            (p.r.c2CapsuletoCapsule)(b, a),\n        );\n    }\n}\n\n// ===========================================================================\n// Row 68 — c2Collided, all 9 valid type pairs (incl. the C's argument swapping)\n// ===========================================================================\n\n#[test]\nfn cfg68_collided_all_pairs() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 68);\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..N / 3 {\n                let a = rand_shape(&mut rng, ta);\n                let b = rand_shape(&mut rng, tb);\n                let ctx = format!(\n                    \"#{i} {}x{} A={} B={}\",\n                    ty_name(ta),\n                    ty_name(tb),\n                    shape_desc(&a),\n                    shape_desc(&b)\n                );\n                let rc = unsafe { (p.c.c2Collided)(a.ptr(), ta, b.ptr(), tb) };\n                let rr = unsafe { (p.r.c2Collided)(a.ptr(), ta, b.ptr(), tb) };\n                eq_i32(\"c2Collided\", &ctx, rc, rr);\n            }\n            // bounded scene, so that ~half the samples collide\n            for i in 0..N / 3 {\n                let mk = |rng: &mut Rng, t: C2_TYPE| -> Shape {\n                    let c = C2v {\n                        x: rng.range(-15.0, 15.0),\n                        y: rng.range(-15.0, 15.0),\n                    };\n                    match t {\n                        C2_TYPE_CIRCLE => Shape::Circle(C2Circle {\n                            p: c,\n                            r: rng.range(0.0, 8.0),\n                        }),\n                        C2_TYPE_AABB => Shape::Aabb(C2AABB {\n                            min: c,\n                            max: C2v {\n                                x: c.x + rng.range(0.0, 10.0),\n                                y: c.y + rng.range(0.0, 10.0),\n                            },\n                        }),\n                        _ => Shape::Capsule(C2Capsule {\n                            a: c,\n                            b: C2v {\n                                x: c.x + rng.range(-10.0, 10.0),\n                                y: c.y + rng.range(-10.0, 10.0),\n                            },\n                            r: rng.range(0.0, 5.0),\n                        }),\n                    }\n                };\n                let a = mk(&mut rng, ta);\n                let b = mk(&mut rng, tb);\n                let ctx = format!(\n                    \"#{i} scene {}x{} A={} B={}\",\n                    ty_name(ta),\n                    ty_name(tb),\n                    shape_desc(&a),\n                    shape_desc(&b)\n                );\n                let rc = unsafe { (p.c.c2Collided)(a.ptr(), ta, b.ptr(), tb) };\n                let rr = unsafe { (p.r.c2Collided)(a.ptr(), ta, b.ptr(), tb) };\n                eq_i32(\"c2Collided\", &ctx, rc, rr);\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 69, 70, 71 — reverse_collide (the only symbol in include/lib.h)\n// ===========================================================================\n\n#[test]\nfn cfg69_reverse_collide_grid_all_eight_results() {\n    let p = load();\n    let mut seen = [0usize; 8];\n    let mut other = 0usize;\n    let mut x = -160.0f32;\n    while x <= 160.0 {\n        let mut y = -160.0f32;\n        while y <= 160.0 {\n            for r in [0.0f32, 1.0, 5.0, 10.0, 20.0, 40.0, 80.0, 0.5, 15.0] {\n                let rc = (p.c.reverse_collide)(x, y, r);\n                let rr = (p.r.reverse_collide)(x, y, r);\n                eq_i32(\"reverse_collide\", &format!(\"x={x} y={y} r={r}\"), rc, rr);\n                if (0..8).contains(&rc) {\n                    seen[rc as usize] += 1;\n                } else {\n                    other += 1;\n                }\n            }\n            y += 2.0;\n        }\n        x += 2.0;\n    }\n    println!(\"reverse_collide result histogram: {seen:?} (out of range: {other})\");\n    assert_eq!(other, 0, \"reverse_collide returned a value outside 0..=7\");\n    for (v, &n) in seen.iter().enumerate() {\n        assert!(n > 0, \"reverse_collide never returned {v}: {seen:?}\");\n    }\n}\n\n#[test]\nfn cfg70_reverse_collide_random() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 70);\n    for i in 0..200_000 {\n        let (x, y, r) = (rng.mixed(), rng.mixed(), rng.mixed());\n        eq_i32(\n            \"reverse_collide\",\n            &format!(\"#{i} x={x:?}({:#010x}) y={y:?}({:#010x}) r={r:?}({:#010x})\",\n                x.to_bits(), y.to_bits(), r.to_bits()),\n            (p.c.reverse_collide)(x, y, r),\n            (p.r.reverse_collide)(x, y, r),\n        );\n    }\n    // plus a dense geometric sweep\n    let mut rng = Rng::new(SEED ^ 71);\n    for i in 0..200_000 {\n        let x = rng.range(-200.0, 200.0);\n        let y = rng.range(-200.0, 200.0);\n        let r = rng.range(-10.0, 120.0);\n        eq_i32(\n            \"reverse_collide\",\n            &format!(\"#{i} geo x={x} y={y} r={r}\"),\n            (p.c.reverse_collide)(x, y, r),\n            (p.r.reverse_collide)(x, y, r),\n        );\n    }\n}\n\n#[test]\nfn cfg71_reverse_collide_boundaries() {\n    let p = load();\n    // The fixed scene from c_src/src/lib.c:626-637\n    let circle = (C2v { x: -70.0, y: 0.0 }, 20.0f32);\n    let aabb = (C2v { x: -40.0, y: -40.0 }, C2v { x: -15.0, y: -15.0 });\n    let capsule = (C2v { x: -40.0, y: 40.0 }, C2v { x: -20.0, y: 100.0 }, 10.0f32);\n\n    let mut probes: Vec<(f32, f32)> = Vec::new();\n    // circle centre, AABB corners/edge midpoints/centre, capsule endpoints and midpoint\n    probes.push((circle.0.x, circle.0.y));\n    for &cx in &[aabb.0.x, (aabb.0.x + aabb.1.x) * 0.5, aabb.1.x] {\n        for &cy in &[aabb.0.y, (aabb.0.y + aabb.1.y) * 0.5, aabb.1.y] {\n            probes.push((cx, cy));\n        }\n    }\n    probes.push((capsule.0.x, capsule.0.y));\n    probes.push((capsule.1.x, capsule.1.y));\n    probes.push((\n        (capsule.0.x + capsule.1.x) * 0.5,\n        (capsule.0.y + capsule.1.y) * 0.5,\n    ));\n    probes.push((0.0, 0.0));\n    probes.push((-0.0, -0.0));\n\n    // for each probe, the exact distance to each of the three shapes, +-1 ULP\n    let dist = |x: f32, y: f32| -> Vec<f32> {\n        let dx = x - circle.0.x;\n        let dy = y - circle.0.y;\n        let d_circle = (dx * dx + dy * dy).sqrt();\n        let cx = x.clamp(aabb.0.x, aabb.1.x);\n        let cy = y.clamp(aabb.0.y, aabb.1.y);\n        let d_box = ((x - cx) * (x - cx) + (y - cy) * (y - cy)).sqrt();\n        // distance to the capsule segment\n        let (ax, ay) = (capsule.0.x, capsule.0.y);\n        let (bx, by) = (capsule.1.x, capsule.1.y);\n        let (ex, ey) = (bx - ax, by - ay);\n        let t = (((x - ax) * ex + (y - ay) * ey) / (ex * ex + ey * ey)).clamp(0.0, 1.0);\n        let (px, py) = (ax + t * ex, ay + t * ey);\n        let d_seg = ((x - px) * (x - px) + (y - py) * (y - py)).sqrt();\n        vec![\n            d_circle - circle.1,\n            d_box,\n            d_seg - capsule.2,\n            d_circle,\n            d_seg,\n        ]\n    };\n\n    for (x, y) in probes {\n        let mut radii: Vec<f32> = vec![0.0, -0.0, -1.0, 1.0, 1000.0, f32::MIN_POSITIVE];\n        for d in dist(x, y) {\n            for k in [-2i32, -1, 0, 1, 2] {\n                let r = if k == 0 {\n                    d\n                } else if k < 0 {\n                    f32::from_bits(d.to_bits().wrapping_sub((-k) as u32))\n                } else {\n                    f32::from_bits(d.to_bits().wrapping_add(k as u32))\n                };\n                radii.push(r);\n            }\n        }\n        for r in radii {\n            eq_i32(\n                \"reverse_collide\",\n                &format!(\"boundary x={x} y={y} r={r:?} ({:#010x})\", r.to_bits()),\n                (p.c.reverse_collide)(x, y, r),\n                (p.r.reverse_collide)(x, y, r),\n            );\n        }\n    }\n\n    // Also sweep x/y one ULP around every shape boundary coordinate with a fixed radius.\n    for base in [\n        circle.0.x, circle.0.y, aabb.0.x, aabb.0.y, aabb.1.x, aabb.1.y, capsule.0.x, capsule.0.y,\n        capsule.1.x, capsule.1.y,\n    ] {\n        for k in [-2i32, -1, 0, 1, 2] {\n            let v = if k == 0 {\n                base\n            } else if k < 0 {\n                f32::from_bits(base.to_bits().wrapping_sub((-k) as u32))\n            } else {\n                f32::from_bits(base.to_bits().wrapping_add(k as u32))\n            };\n            for r in [0.0f32, 5.0, 10.0, 20.0, 25.0, 30.0] {\n                for (x, y) in [(v, 0.0f32), (0.0f32, v), (v, v)] {\n                    eq_i32(\n                        \"reverse_collide\",\n                        &format!(\"ulp x={x:?} y={y:?} r={r}\"),\n                        (p.c.reverse_collide)(x, y, r),\n                        (p.r.reverse_collide)(x, y, r),\n                    );\n                }\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1147,"cache_read_input_tokens":157314,"cache_creation":{"ephemeral_5m_input_tokens":1147,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"01a68480-bbf5-45e9-96ef-206dacf1aacc","uuid":"0bd532d8-e0d2-4038-b165-c1b9fb536fc0","timestamp":"2026-08-27T16:18:51.244Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01THa6UVyw44enkVSzG9FGLu","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-lBJjNJ/translation/tests/phase_b_highlevel.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"01a68480-bbf5-45e9-96ef-206dacf1aacc","uuid":"42206cf8-d72c-48bc-83a1-7ffa305fcb5b","timestamp":"2026-08-27T16:18:51.255Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-lBJjNJ/translation/tests/phase_b_highlevel.rs","content":"//! Phase B — the boolean predicates, `c2Collided` and `reverse_collide`\n//! (CONFIGS.md rows 62-71).\n\n#![allow(non_snake_case)]\n\nmod common;\nuse common::*;\n\nconst SEED: u64 = 0x_5DEE_CE66_D000_0000;\nconst N: usize = 20_000;\n\nfn ulp_up(x: f32) -> f32 {\n    f32::from_bits(x.to_bits().wrapping_add(1))\n}\nfn ulp_dn(x: f32) -> f32 {\n    f32::from_bits(x.to_bits().wrapping_sub(1))\n}\n\n// ===========================================================================\n// Row 62 — c2AABBtoAABB\n// ===========================================================================\n\n#[test]\nfn cfg62_aabb_to_aabb() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 62);\n    for i in 0..N {\n        let a = rng.aabb();\n        let b = rng.aabb();\n        let ctx = format!(\"#{i} A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2AABBtoAABB\",\n            &ctx,\n            (p.c.c2AABBtoAABB)(a, b),\n            (p.r.c2AABBtoAABB)(a, b),\n        );\n    }\n    // exhaustive integral grid: every relative placement including exact touching\n    let unit = |x: f32, y: f32| C2AABB {\n        min: C2v { x, y },\n        max: C2v { x: x + 2.0, y: y + 2.0 },\n    };\n    let base = unit(0.0, 0.0);\n    for dx in -6..=6 {\n        for dy in -6..=6 {\n            let b = unit(dx as f32, dy as f32);\n            let ctx = format!(\"grid dx={dx} dy={dy}\");\n            eq_i32(\n                \"c2AABBtoAABB\",\n                &ctx,\n                (p.c.c2AABBtoAABB)(base, b),\n                (p.r.c2AABBtoAABB)(base, b),\n            );\n        }\n    }\n    // the four separating-axis boundaries, at, one-ULP-inside and one-ULP-outside\n    for edge in 0..4 {\n        for shift in [0.0f32, 1.0, -1.0] {\n            let mut b = unit(0.0, 0.0);\n            let d = 2.0 + shift;\n            match edge {\n                0 => {\n                    b.min.x += d;\n                    b.max.x += d;\n                }\n                1 => {\n                    b.min.x -= d;\n                    b.max.x -= d;\n                }\n                2 => {\n                    b.min.y += d;\n                    b.max.y += d;\n                }\n                _ => {\n                    b.min.y -= d;\n                    b.max.y -= d;\n                }\n            }\n            for tweak in [0i32, 1, -1] {\n                let mut bb = b;\n                if tweak != 0 {\n                    bb.min.x = if tweak > 0 {\n                        ulp_up(bb.min.x)\n                    } else {\n                        ulp_dn(bb.min.x)\n                    };\n                    bb.min.y = if tweak > 0 {\n                        ulp_up(bb.min.y)\n                    } else {\n                        ulp_dn(bb.min.y)\n                    };\n                }\n                let ctx = format!(\"edge{edge} shift={shift} tweak={tweak} B={bb:?}\");\n                eq_i32(\n                    \"c2AABBtoAABB\",\n                    &ctx,\n                    (p.c.c2AABBtoAABB)(base, bb),\n                    (p.r.c2AABBtoAABB)(base, bb),\n                );\n            }\n        }\n    }\n    // containment, identity, zero-extent, inverted, NaN, inf\n    let z = C2v { x: 0.0, y: 0.0 };\n    let specials = [\n        C2AABB { min: z, max: z },\n        C2AABB {\n            min: C2v { x: 1.0, y: 1.0 },\n            max: C2v { x: -1.0, y: -1.0 },\n        },\n        C2AABB {\n            min: C2v {\n                x: f32::NAN,\n                y: 0.0,\n            },\n            max: C2v { x: 1.0, y: 1.0 },\n        },\n        C2AABB {\n            min: C2v {\n                x: f32::NEG_INFINITY,\n                y: f32::NEG_INFINITY,\n            },\n            max: C2v {\n                x: f32::INFINITY,\n                y: f32::INFINITY,\n            },\n        },\n        C2AABB {\n            min: C2v { x: -100.0, y: -100.0 },\n            max: C2v { x: 100.0, y: 100.0 },\n        },\n        C2AABB {\n            min: C2v { x: -0.0, y: -0.0 },\n            max: C2v { x: 0.0, y: 0.0 },\n        },\n    ];\n    for a in specials {\n        for b in specials {\n            let ctx = format!(\"special A={a:?} B={b:?}\");\n            eq_i32(\n                \"c2AABBtoAABB\",\n                &ctx,\n                (p.c.c2AABBtoAABB)(a, b),\n                (p.r.c2AABBtoAABB)(a, b),\n            );\n        }\n    }\n}\n\n// ===========================================================================\n// Row 63 — c2CircletoCircle\n// ===========================================================================\n\n#[test]\nfn cfg63_circle_to_circle() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 63);\n    for i in 0..N {\n        let a = rng.circle();\n        let b = rng.circle();\n        let ctx = format!(\"#{i} A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2CircletoCircle\",\n            &ctx,\n            (p.c.c2CircletoCircle)(a, b),\n            (p.r.c2CircletoCircle)(a, b),\n        );\n    }\n    // exact-touching / one-ULP either side / zero / negative radii / concentric\n    for (ra, rb) in [\n        (0.0f32, 0.0f32),\n        (0.0, 5.0),\n        (5.0, 0.0),\n        (3.0, 4.0),\n        (-2.0, 2.0),\n        (-3.0, -4.0),\n        (1.0e20, 1.0e20),\n        (-0.0, 0.0),\n    ] {\n        let sum = ra + rb;\n        for d in [\n            0.0f32,\n            sum,\n            ulp_dn(sum),\n            ulp_up(sum),\n            sum * 0.5,\n            sum * 2.0,\n            f32::NAN,\n            f32::INFINITY,\n        ] {\n            let a = C2Circle {\n                p: C2v { x: 0.0, y: 0.0 },\n                r: ra,\n            };\n            let b = C2Circle {\n                p: C2v { x: d, y: 0.0 },\n                r: rb,\n            };\n            let ctx = format!(\"touch ra={ra} rb={rb} d={d:?}\");\n            eq_i32(\n                \"c2CircletoCircle\",\n                &ctx,\n                (p.c.c2CircletoCircle)(a, b),\n                (p.r.c2CircletoCircle)(a, b),\n            );\n        }\n    }\n}\n\n// ===========================================================================\n// Row 64 — c2CircletoAABB (all 9 Voronoi regions of the clamp)\n// ===========================================================================\n\n#[test]\nfn cfg64_circle_to_aabb() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 64);\n    for i in 0..N {\n        let a = rng.circle();\n        let b = rng.aabb();\n        let ctx = format!(\"#{i} A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2CircletoAABB\",\n            &ctx,\n            (p.c.c2CircletoAABB)(a, b),\n            (p.r.c2CircletoAABB)(a, b),\n        );\n    }\n    // 9 regions around a unit box, times a set of radii, times ULP tweaks\n    let bb = C2AABB {\n        min: C2v { x: -1.0, y: -1.0 },\n        max: C2v { x: 1.0, y: 1.0 },\n    };\n    let coords = [-3.0f32, -1.0, -0.5, 0.0, 0.5, 1.0, 3.0];\n    for &cx in &coords {\n        for &cy in &coords {\n            for r in [0.0f32, -0.0, -1.0, 0.5, 1.0, 2.0, 5.0] {\n                for tweak in [0i32, 1, -1] {\n                    let rr = match tweak {\n                        1 => ulp_up(r),\n                        -1 => ulp_dn(r),\n                        _ => r,\n                    };\n                    let a = C2Circle {\n                        p: C2v { x: cx, y: cy },\n                        r: rr,\n                    };\n                    let ctx = format!(\"region c=({cx},{cy}) r={rr:?}\");\n                    eq_i32(\n                        \"c2CircletoAABB\",\n                        &ctx,\n                        (p.c.c2CircletoAABB)(a, bb),\n                        (p.r.c2CircletoAABB)(a, bb),\n                    );\n                }\n            }\n        }\n    }\n    // inverted / zero-extent / NaN boxes\n    let boxes = [\n        C2AABB {\n            min: C2v { x: 1.0, y: 1.0 },\n            max: C2v { x: -1.0, y: -1.0 },\n        },\n        C2AABB {\n            min: C2v { x: 0.0, y: 0.0 },\n            max: C2v { x: 0.0, y: 0.0 },\n        },\n        C2AABB {\n            min: C2v {\n                x: f32::NAN,\n                y: -1.0,\n            },\n            max: C2v { x: 1.0, y: 1.0 },\n        },\n        C2AABB {\n            min: C2v {\n                x: f32::NEG_INFINITY,\n                y: -1.0,\n            },\n            max: C2v {\n                x: f32::INFINITY,\n                y: 1.0,\n            },\n        },\n    ];\n    for b in boxes {\n        for r in [0.0f32, 1.0, f32::INFINITY, f32::NAN] {\n            for c in [\n                C2v { x: 0.0, y: 0.0 },\n                C2v { x: 5.0, y: 5.0 },\n                C2v {\n                    x: f32::NAN,\n                    y: 0.0,\n                },\n            ] {\n                let a = C2Circle { p: c, r };\n                let ctx = format!(\"weird A={a:?} B={b:?}\");\n                eq_i32(\n                    \"c2CircletoAABB\",\n                    &ctx,\n                    (p.c.c2CircletoAABB)(a, b),\n                    (p.r.c2CircletoAABB)(a, b),\n                );\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 65 — c2CircletoCapsule (the three Voronoi regions)\n// ===========================================================================\n\n#[test]\nfn cfg65_circle_to_capsule() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 65);\n    let mut regions = [0usize; 3];\n    for i in 0..N {\n        let a = rng.circle();\n        let b = rng.capsule();\n        // classify with the C's own primitives\n        let n = (p.c.c2Sub)(b.b, b.a);\n        let ap = (p.c.c2Sub)(a.p, b.a);\n        let da = (p.c.c2Dot)(ap, n);\n        let reg = if da < 0.0 {\n            0\n        } else if (p.c.c2Dot)((p.c.c2Sub)(a.p, b.b), n) < 0.0 {\n            1\n        } else {\n            2\n        };\n        regions[reg] += 1;\n        let ctx = format!(\"#{i} region={reg} A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2CircletoCapsule\",\n            &ctx,\n            (p.c.c2CircletoCapsule)(a, b),\n            (p.r.c2CircletoCapsule)(a, b),\n        );\n    }\n    assert!(\n        regions.iter().all(|&r| r > 100),\n        \"capsule Voronoi regions not covered: {regions:?}\"\n    );\n\n    // hand-built: along the axis, off the shaft, at each cap, degenerate capsule\n    let cap = C2Capsule {\n        a: C2v { x: -5.0, y: 0.0 },\n        b: C2v { x: 5.0, y: 0.0 },\n        r: 2.0,\n    };\n    let degen = C2Capsule {\n        a: C2v { x: 1.0, y: 1.0 },\n        b: C2v { x: 1.0, y: 1.0 },\n        r: 2.0,\n    };\n    let zeror = C2Capsule {\n        a: C2v { x: -5.0, y: 0.0 },\n        b: C2v { x: 5.0, y: 0.0 },\n        r: 0.0,\n    };\n    let negr = C2Capsule {\n        a: C2v { x: -5.0, y: 0.0 },\n        b: C2v { x: 5.0, y: 0.0 },\n        r: -2.0,\n    };\n    for capsule in [cap, degen, zeror, negr] {\n        for x in [-10.0f32, -7.0, -5.0, -2.5, 0.0, 2.5, 5.0, 7.0, 10.0, 1.0] {\n            for y in [-10.0f32, -4.0, -2.0, 0.0, 2.0, 4.0, 10.0, 1.0] {\n                for r in [0.0f32, -0.0, -1.0, 2.0, ulp_dn(2.0), ulp_up(2.0), 100.0] {\n                    let a = C2Circle {\n                        p: C2v { x, y },\n                        r,\n                    };\n                    let ctx = format!(\"explicit A={a:?} B={capsule:?}\");\n                    eq_i32(\n                        \"c2CircletoCapsule\",\n                        &ctx,\n                        (p.c.c2CircletoCapsule)(a, capsule),\n                        (p.r.c2CircletoCapsule)(a, capsule),\n                    );\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 66 — c2AABBtoCapsule (drives the full GJK pipeline)\n// ===========================================================================\n\n#[test]\nfn cfg66_aabb_to_capsule() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 66);\n    for i in 0..N {\n        let a = rng.aabb();\n        let b = rng.capsule();\n        let ctx = format!(\"#{i} A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2AABBtoCapsule\",\n            &ctx,\n            (p.c.c2AABBtoCapsule)(a, b),\n            (p.r.c2AABBtoCapsule)(a, b),\n        );\n    }\n    // bounded scene so hits are frequent\n    for i in 0..N {\n        let bx = rng.range(-20.0, 20.0);\n        let by = rng.range(-20.0, 20.0);\n        let a = C2AABB {\n            min: C2v { x: -5.0, y: -5.0 },\n            max: C2v { x: 5.0, y: 5.0 },\n        };\n        let b = C2Capsule {\n            a: C2v { x: bx, y: by },\n            b: C2v {\n                x: bx + rng.range(-15.0, 15.0),\n                y: by + rng.range(-15.0, 15.0),\n            },\n            r: rng.range(0.0, 8.0),\n        };\n        let ctx = format!(\"#{i} scene A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2AABBtoCapsule\",\n            &ctx,\n            (p.c.c2AABBtoCapsule)(a, b),\n            (p.r.c2AABBtoCapsule)(a, b),\n        );\n    }\n    // explicit: outside / touching / crossing / inside, axis-aligned and diagonal\n    let bb = C2AABB {\n        min: C2v { x: -5.0, y: -5.0 },\n        max: C2v { x: 5.0, y: 5.0 },\n    };\n    let caps = [\n        C2Capsule {\n            a: C2v { x: -20.0, y: 0.0 },\n            b: C2v { x: -10.0, y: 0.0 },\n            r: 1.0,\n        },\n        C2Capsule {\n            a: C2v { x: -20.0, y: 0.0 },\n            b: C2v { x: -6.0, y: 0.0 },\n            r: 1.0,\n        },\n        C2Capsule {\n            a: C2v { x: -20.0, y: 0.0 },\n            b: C2v { x: 20.0, y: 0.0 },\n            r: 1.0,\n        },\n        C2Capsule {\n            a: C2v { x: -1.0, y: -1.0 },\n            b: C2v { x: 1.0, y: 1.0 },\n            r: 0.5,\n        },\n        C2Capsule {\n            a: C2v { x: -20.0, y: -20.0 },\n            b: C2v { x: 20.0, y: 20.0 },\n            r: 0.5,\n        },\n        C2Capsule {\n            a: C2v { x: 0.0, y: 0.0 },\n            b: C2v { x: 0.0, y: 0.0 },\n            r: 0.0,\n        },\n        C2Capsule {\n            a: C2v { x: 0.0, y: 0.0 },\n            b: C2v { x: 0.0, y: 0.0 },\n            r: 100.0,\n        },\n        C2Capsule {\n            a: C2v { x: 5.0, y: 5.0 },\n            b: C2v { x: 10.0, y: 10.0 },\n            r: 0.0,\n        },\n    ];\n    let boxes = [\n        bb,\n        C2AABB {\n            min: C2v { x: 0.0, y: 0.0 },\n            max: C2v { x: 0.0, y: 0.0 },\n        },\n        C2AABB {\n            min: C2v { x: 5.0, y: 5.0 },\n            max: C2v { x: -5.0, y: -5.0 },\n        },\n    ];\n    for b in boxes {\n        for c in caps {\n            let ctx = format!(\"explicit A={b:?} B={c:?}\");\n            eq_i32(\n                \"c2AABBtoCapsule\",\n                &ctx,\n                (p.c.c2AABBtoCapsule)(b, c),\n                (p.r.c2AABBtoCapsule)(b, c),\n            );\n        }\n    }\n}\n\n// ===========================================================================\n// Row 67 — c2CapsuletoCapsule\n// ===========================================================================\n\n#[test]\nfn cfg67_capsule_to_capsule() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 67);\n    for i in 0..N {\n        let a = rng.capsule();\n        let b = rng.capsule();\n        let ctx = format!(\"#{i} A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2CapsuletoCapsule\",\n            &ctx,\n            (p.c.c2CapsuletoCapsule)(a, b),\n            (p.r.c2CapsuletoCapsule)(a, b),\n        );\n    }\n    for i in 0..N {\n        let mk = |rng: &mut Rng| C2Capsule {\n            a: C2v {\n                x: rng.range(-15.0, 15.0),\n                y: rng.range(-15.0, 15.0),\n            },\n            b: C2v {\n                x: rng.range(-15.0, 15.0),\n                y: rng.range(-15.0, 15.0),\n            },\n            r: rng.range(0.0, 6.0),\n        };\n        let a = mk(&mut rng);\n        let b = mk(&mut rng);\n        let ctx = format!(\"#{i} scene A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2CapsuletoCapsule\",\n            &ctx,\n            (p.c.c2CapsuletoCapsule)(a, b),\n            (p.r.c2CapsuletoCapsule)(a, b),\n        );\n    }\n    // parallel / crossing / collinear / end-to-end / degenerate\n    let cases: Vec<(C2Capsule, C2Capsule)> = vec![\n        // parallel, separated then touching\n        (\n            C2Capsule {\n                a: C2v { x: -5.0, y: 0.0 },\n                b: C2v { x: 5.0, y: 0.0 },\n                r: 1.0,\n            },\n            C2Capsule {\n                a: C2v { x: -5.0, y: 5.0 },\n                b: C2v { x: 5.0, y: 5.0 },\n                r: 1.0,\n            },\n        ),\n        (\n            C2Capsule {\n                a: C2v { x: -5.0, y: 0.0 },\n                b: C2v { x: 5.0, y: 0.0 },\n                r: 1.0,\n            },\n            C2Capsule {\n                a: C2v { x: -5.0, y: 2.0 },\n                b: C2v { x: 5.0, y: 2.0 },\n                r: 1.0,\n            },\n        ),\n        // crossing\n        (\n            C2Capsule {\n                a: C2v { x: -5.0, y: 0.0 },\n                b: C2v { x: 5.0, y: 0.0 },\n                r: 0.5,\n            },\n            C2Capsule {\n                a: C2v { x: 0.0, y: -5.0 },\n                b: C2v { x: 0.0, y: 5.0 },\n                r: 0.5,\n            },\n        ),\n        // collinear overlapping\n        (\n            C2Capsule {\n                a: C2v { x: -5.0, y: 0.0 },\n                b: C2v { x: 5.0, y: 0.0 },\n                r: 1.0,\n            },\n            C2Capsule {\n                a: C2v { x: 0.0, y: 0.0 },\n                b: C2v { x: 10.0, y: 0.0 },\n                r: 1.0,\n            },\n        ),\n        // end to end exactly touching\n        (\n            C2Capsule {\n                a: C2v { x: -5.0, y: 0.0 },\n                b: C2v { x: 0.0, y: 0.0 },\n                r: 1.0,\n            },\n            C2Capsule {\n                a: C2v { x: 2.0, y: 0.0 },\n                b: C2v { x: 7.0, y: 0.0 },\n                r: 1.0,\n            },\n        ),\n        // both degenerate (points)\n        (\n            C2Capsule {\n                a: C2v { x: 0.0, y: 0.0 },\n                b: C2v { x: 0.0, y: 0.0 },\n                r: 1.0,\n            },\n            C2Capsule {\n                a: C2v { x: 2.0, y: 0.0 },\n                b: C2v { x: 2.0, y: 0.0 },\n                r: 1.0,\n            },\n        ),\n        // one degenerate, zero radius\n        (\n            C2Capsule {\n                a: C2v { x: 0.0, y: 0.0 },\n                b: C2v { x: 0.0, y: 0.0 },\n                r: 0.0,\n            },\n            C2Capsule {\n                a: C2v { x: -5.0, y: 0.0 },\n                b: C2v { x: 5.0, y: 0.0 },\n                r: 0.0,\n            },\n        ),\n        // identical\n        (\n            C2Capsule {\n                a: C2v { x: -3.0, y: 1.0 },\n                b: C2v { x: 3.0, y: -1.0 },\n                r: 2.0,\n            },\n            C2Capsule {\n                a: C2v { x: -3.0, y: 1.0 },\n                b: C2v { x: 3.0, y: -1.0 },\n                r: 2.0,\n            },\n        ),\n        // negative radii\n        (\n            C2Capsule {\n                a: C2v { x: -3.0, y: 0.0 },\n                b: C2v { x: 3.0, y: 0.0 },\n                r: -2.0,\n            },\n            C2Capsule {\n                a: C2v { x: -3.0, y: 1.0 },\n                b: C2v { x: 3.0, y: 1.0 },\n                r: -2.0,\n            },\n        ),\n    ];\n    for (a, b) in cases {\n        let ctx = format!(\"explicit A={a:?} B={b:?}\");\n        eq_i32(\n            \"c2CapsuletoCapsule\",\n            &ctx,\n            (p.c.c2CapsuletoCapsule)(a, b),\n            (p.r.c2CapsuletoCapsule)(a, b),\n        );\n        // and the reversed argument order\n        let ctx = format!(\"explicit-rev A={b:?} B={a:?}\");\n        eq_i32(\n            \"c2CapsuletoCapsule\",\n            &ctx,\n            (p.c.c2CapsuletoCapsule)(b, a),\n            (p.r.c2CapsuletoCapsule)(b, a),\n        );\n    }\n}\n\n// ===========================================================================\n// Row 68 — c2Collided, all 9 valid type pairs (incl. the C's argument swapping)\n// ===========================================================================\n\n#[test]\nfn cfg68_collided_all_pairs() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 68);\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..N / 3 {\n                let a = rand_shape(&mut rng, ta);\n                let b = rand_shape(&mut rng, tb);\n                let ctx = format!(\n                    \"#{i} {}x{} A={} B={}\",\n                    ty_name(ta),\n                    ty_name(tb),\n                    shape_desc(&a),\n                    shape_desc(&b)\n                );\n                let rc = unsafe { (p.c.c2Collided)(a.ptr(), ta, b.ptr(), tb) };\n                let rr = unsafe { (p.r.c2Collided)(a.ptr(), ta, b.ptr(), tb) };\n                eq_i32(\"c2Collided\", &ctx, rc, rr);\n            }\n            // bounded scene, so that ~half the samples collide\n            for i in 0..N / 3 {\n                let mk = |rng: &mut Rng, t: C2_TYPE| -> Shape {\n                    let c = C2v {\n                        x: rng.range(-15.0, 15.0),\n                        y: rng.range(-15.0, 15.0),\n                    };\n                    match t {\n                        C2_TYPE_CIRCLE => Shape::Circle(C2Circle {\n                            p: c,\n                            r: rng.range(0.0, 8.0),\n                        }),\n                        C2_TYPE_AABB => Shape::Aabb(C2AABB {\n                            min: c,\n                            max: C2v {\n                                x: c.x + rng.range(0.0, 10.0),\n                                y: c.y + rng.range(0.0, 10.0),\n                            },\n                        }),\n                        _ => Shape::Capsule(C2Capsule {\n                            a: c,\n                            b: C2v {\n                                x: c.x + rng.range(-10.0, 10.0),\n                                y: c.y + rng.range(-10.0, 10.0),\n                            },\n                            r: rng.range(0.0, 5.0),\n                        }),\n                    }\n                };\n                let a = mk(&mut rng, ta);\n                let b = mk(&mut rng, tb);\n                let ctx = format!(\n                    \"#{i} scene {}x{} A={} B={}\",\n                    ty_name(ta),\n                    ty_name(tb),\n                    shape_desc(&a),\n                    shape_desc(&b)\n                );\n                let rc = unsafe { (p.c.c2Collided)(a.ptr(), ta, b.ptr(), tb) };\n                let rr = unsafe { (p.r.c2Collided)(a.ptr(), ta, b.ptr(), tb) };\n                eq_i32(\"c2Collided\", &ctx, rc, rr);\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 69, 70, 71 — reverse_collide (the only symbol in include/lib.h)\n// ===========================================================================\n\n#[test]\nfn cfg69_reverse_collide_grid_all_eight_results() {\n    let p = load();\n    let mut seen = [0usize; 8];\n    let mut other = 0usize;\n    let mut x = -160.0f32;\n    while x <= 160.0 {\n        let mut y = -160.0f32;\n        while y <= 160.0 {\n            for r in [0.0f32, 1.0, 5.0, 10.0, 20.0, 40.0, 80.0, 0.5, 15.0] {\n                let rc = (p.c.reverse_collide)(x, y, r);\n                let rr = (p.r.reverse_collide)(x, y, r);\n                eq_i32(\"reverse_collide\", &format!(\"x={x} y={y} r={r}\"), rc, rr);\n                if (0..8).contains(&rc) {\n                    seen[rc as usize] += 1;\n                } else {\n                    other += 1;\n                }\n            }\n            y += 2.0;\n        }\n        x += 2.0;\n    }\n    println!(\"reverse_collide result histogram: {seen:?} (out of range: {other})\");\n    assert_eq!(other, 0, \"reverse_collide returned a value outside 0..=7\");\n    for (v, &n) in seen.iter().enumerate() {\n        assert!(n > 0, \"reverse_collide never returned {v}: {seen:?}\");\n    }\n}\n\n#[test]\nfn cfg70_reverse_collide_random() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 70);\n    for i in 0..200_000 {\n        let (x, y, r) = (rng.mixed(), rng.mixed(), rng.mixed());\n        eq_i32(\n            \"reverse_collide\",\n            &format!(\"#{i} x={x:?}({:#010x}) y={y:?}({:#010x}) r={r:?}({:#010x})\",\n                x.to_bits(), y.to_bits(), r.to_bits()),\n            (p.c.reverse_collide)(x, y, r),\n            (p.r.reverse_collide)(x, y, r),\n        );\n    }\n    // plus a dense geometric sweep\n    let mut rng = Rng::new(SEED ^ 71);\n    for i in 0..200_000 {\n        let x = rng.range(-200.0, 200.0);\n        let y = rng.range(-200.0, 200.0);\n        let r = rng.range(-10.0, 120.0);\n        eq_i32(\n            \"reverse_collide\",\n            &format!(\"#{i} geo x={x} y={y} r={r}\"),\n            (p.c.reverse_collide)(x, y, r),\n            (p.r.reverse_collide)(x, y, r),\n        );\n    }\n}\n\n#[test]\nfn cfg71_reverse_collide_boundaries() {\n    let p = load();\n    // The fixed scene from c_src/src/lib.c:626-637\n    let circle = (C2v { x: -70.0, y: 0.0 }, 20.0f32);\n    let aabb = (C2v { x: -40.0, y: -40.0 }, C2v { x: -15.0, y: -15.0 });\n    let capsule = (C2v { x: -40.0, y: 40.0 }, C2v { x: -20.0, y: 100.0 }, 10.0f32);\n\n    let mut probes: Vec<(f32, f32)> = Vec::new();\n    // circle centre, AABB corners/edge midpoints/centre, capsule endpoints and midpoint\n    probes.push((circle.0.x, circle.0.y));\n    for &cx in &[aabb.0.x, (aabb.0.x + aabb.1.x) * 0.5, aabb.1.x] {\n        for &cy in &[aabb.0.y, (aabb.0.y + aabb.1.y) * 0.5, aabb.1.y] {\n            probes.push((cx, cy));\n        }\n    }\n    probes.push((capsule.0.x, capsule.0.y));\n    probes.push((capsule.1.x, capsule.1.y));\n    probes.push((\n        (capsule.0.x + capsule.1.x) * 0.5,\n        (capsule.0.y + capsule.1.y) * 0.5,\n    ));\n    probes.push((0.0, 0.0));\n    probes.push((-0.0, -0.0));\n\n    // for each probe, the exact distance to each of the three shapes, +-1 ULP\n    let dist = |x: f32, y: f32| -> Vec<f32> {\n        let dx = x - circle.0.x;\n        let dy = y - circle.0.y;\n        let d_circle = (dx * dx + dy * dy).sqrt();\n        let cx = x.clamp(aabb.0.x, aabb.1.x);\n        let cy = y.clamp(aabb.0.y, aabb.1.y);\n        let d_box = ((x - cx) * (x - cx) + (y - cy) * (y - cy)).sqrt();\n        // distance to the capsule segment\n        let (ax, ay) = (capsule.0.x, capsule.0.y);\n        let (bx, by) = (capsule.1.x, capsule.1.y);\n        let (ex, ey) = (bx - ax, by - ay);\n        let t = (((x - ax) * ex + (y - ay) * ey) / (ex * ex + ey * ey)).clamp(0.0, 1.0);\n        let (px, py) = (ax + t * ex, ay + t * ey);\n        let d_seg = ((x - px) * (x - px) + (y - py) * (y - py)).sqrt();\n        vec![\n            d_circle - circle.1,\n            d_box,\n            d_seg - capsule.2,\n            d_circle,\n            d_seg,\n        ]\n    };\n\n    for (x, y) in probes {\n        let mut radii: Vec<f32> = vec![0.0, -0.0, -1.0, 1.0, 1000.0, f32::MIN_POSITIVE];\n        for d in dist(x, y) {\n            for k in [-2i32, -1, 0, 1, 2] {\n                let r = if k == 0 {\n                    d\n                } else if k < 0 {\n                    f32::from_bits(d.to_bits().wrapping_sub((-k) as u32))\n                } else {\n                    f32::from_bits(d.to_bits().wrapping_add(k as u32))\n                };\n                radii.push(r);\n            }\n        }\n        for r in radii {\n            eq_i32(\n                \"reverse_collide\",\n                &format!(\"boundary x={x} y={y} r={r:?} ({:#010x})\", r.to_bits()),\n                (p.c.reverse_collide)(x, y, r),\n                (p.r.reverse_collide)(x, y, r),\n            );\n        }\n    }\n\n    // Also sweep x/y one ULP around every shape boundary coordinate with a fixed radius.\n    for base in [\n        circle.0.x, circle.0.y, aabb.0.x, aabb.0.y, aabb.1.x, aabb.1.y, capsule.0.x, capsule.0.y,\n        capsule.1.x, capsule.1.y,\n    ] {\n        for k in [-2i32, -1, 0, 1, 2] {\n            let v = if k == 0 {\n                base\n            } else if k < 0 {\n                f32::from_bits(base.to_bits().wrapping_sub((-k) as u32))\n            } else {\n                f32::from_bits(base.to_bits().wrapping_add(k as u32))\n            };\n            for r in [0.0f32, 5.0, 10.0, 20.0, 25.0, 30.0] {\n                for (x, y) in [(v, 0.0f32), (0.0f32, v), (v, v)] {\n                    eq_i32(\n                        \"reverse_collide\",\n                        &format!(\"ulp x={x:?} y={y:?} r={r}\"),\n                        (p.c.reverse_collide)(x, y, r),\n                        (p.r.reverse_collide)(x, y, r),\n                    );\n                }\n            }\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
