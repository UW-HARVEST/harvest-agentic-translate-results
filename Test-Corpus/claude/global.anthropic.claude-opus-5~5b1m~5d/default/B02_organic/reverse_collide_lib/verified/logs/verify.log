{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_e3xgaz3xj6e7eebwgpcm6ybdnhhfyujath4p36ao45eqoan4nveq","type":"message","role":"assistant","content":[{"type":"text","text":"Now the GJK differential tests (CONFIGS rows 39–61):"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1326,"cache_read_input_tokens":141846,"cache_creation":{"ephemeral_5m_input_tokens":1326,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"01a68480-bbf5-45e9-96ef-206dacf1aacc","uuid":"5c7b15aa-d96b-44d5-b1ae-aaa11dcc9dc5","timestamp":"2026-08-27T16:14:53.839Z"}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_e3xgaz3xj6e7eebwgpcm6ybdnhhfyujath4p36ao45eqoan4nveq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01YBp8SnZE917SXmHfZZ4Ztq","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-lBJjNJ/translation/tests/phase_b_gjk.rs","content":"//! Phase B — `c2GJK`, the lowest-level composed entry point (CONFIGS.md rows 39-61).\n//!\n//! `c2GJK` is where the whole pipeline is driven: `c2MakeProxy` -> cache read ->\n//! `c22`/`c23` -> `c2L`/`c2D`/`c2Support` -> `c2Witness` -> radius shrink -> cache write.\n//! Every option combination is exercised directly rather than only through the\n//! `c2*to*` convenience wrappers.\n\n#![allow(non_snake_case)]\n\nmod common;\nuse common::*;\n\nconst SEED: u64 = 0x_9E37_79B9_7F4A_7C15;\n\n/// Shapes drawn inside a bounded region so that separation / touching / overlap /\n/// containment all occur frequently.\nfn scene_shape(rng: &mut Rng, ty: C2_TYPE) -> Shape {\n    let c = |rng: &mut Rng| C2v {\n        x: rng.range(-50.0, 50.0),\n        y: rng.range(-50.0, 50.0),\n    };\n    match ty {\n        C2_TYPE_CIRCLE => Shape::Circle(C2Circle {\n            p: c(rng),\n            r: match rng.below(8) {\n                0 => 0.0,\n                1 => rng.range(0.0, 1.0e-5),\n                _ => rng.range(0.0, 30.0),\n            },\n        }),\n        C2_TYPE_AABB => {\n            let a = c(rng);\n            let b = c(rng);\n            match rng.below(10) {\n                0 => Shape::Aabb(C2AABB { min: a, max: a }),\n                1 => Shape::Aabb(C2AABB { min: b, max: a }),\n                _ => Shape::Aabb(C2AABB {\n                    min: C2v {\n                        x: a.x.min(b.x),\n                        y: a.y.min(b.y),\n                    },\n                    max: C2v {\n                        x: a.x.max(b.x),\n                        y: a.y.max(b.y),\n                    },\n                }),\n            }\n        }\n        _ => {\n            let a = c(rng);\n            let b = if rng.below(10) == 0 { a } else { c(rng) };\n            Shape::Capsule(C2Capsule {\n                a,\n                b,\n                r: match rng.below(8) {\n                    0 => 0.0,\n                    _ => rng.range(0.0, 20.0),\n                },\n            })\n        }\n    }\n}\n\n/// A pool of transforms covering every shape the C distinguishes.\nfn transforms(rng: &mut Rng) -> Vec<(&'static str, Option<C2x>)> {\n    let t = rng.range(-3.2, 3.2);\n    vec![\n        (\"null\", None),\n        (\n            \"identity\",\n            Some(C2x {\n                p: C2v { x: 0.0, y: 0.0 },\n                r: C2r { c: 1.0, s: 0.0 },\n            }),\n        ),\n        (\n            \"translate\",\n            Some(C2x {\n                p: C2v {\n                    x: rng.range(-40.0, 40.0),\n                    y: rng.range(-40.0, 40.0),\n                },\n                r: C2r { c: 1.0, s: 0.0 },\n            }),\n        ),\n        (\n            \"rotate\",\n            Some(C2x {\n                p: C2v { x: 0.0, y: 0.0 },\n                r: C2r {\n                    c: t.cos(),\n                    s: t.sin(),\n                },\n            }),\n        ),\n        (\n            \"both\",\n            Some(C2x {\n                p: C2v {\n                    x: rng.range(-40.0, 40.0),\n                    y: rng.range(-40.0, 40.0),\n                },\n                r: C2r {\n                    c: t.cos(),\n                    s: t.sin(),\n                },\n            }),\n        ),\n        (\n            \"non-unit\",\n            Some(C2x {\n                p: C2v {\n                    x: rng.range(-10.0, 10.0),\n                    y: rng.range(-10.0, 10.0),\n                },\n                r: C2r {\n                    c: rng.range(-2.5, 2.5),\n                    s: rng.range(-2.5, 2.5),\n                },\n            }),\n        ),\n    ]\n}\n\n// ===========================================================================\n// Rows 39-47 — every (typeA, typeB) pair, default options\n// ===========================================================================\n\n#[test]\nfn cfg39_47_gjk_all_type_pairs() {\n    let p = load();\n    let mut rng = Rng::new(SEED);\n    let per_pair = 3000;\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..per_pair {\n                let a = scene_shape(&mut rng, ta);\n                let b = scene_shape(&mut rng, tb);\n                let ctx = format!(\n                    \"#{i} {}x{} A={} B={}\",\n                    ty_name(ta),\n                    ty_name(tb),\n                    shape_desc(&a),\n                    shape_desc(&b)\n                );\n                let oc = call_gjk(&p.c, &a, None, &b, None, 1, true, true, true, None);\n                let or = call_gjk(&p.r, &a, None, &b, None, 1, true, true, true, None);\n                eq_gjk(&ctx, &oc, &or);\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 48 — use_radius = 0\n// ===========================================================================\n\n#[test]\nfn cfg48_gjk_use_radius_0() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 48);\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..3000 {\n                let a = scene_shape(&mut rng, ta);\n                let b = scene_shape(&mut rng, tb);\n                for ur in [0i32, 1, -1, 2, i32::MIN] {\n                    let ctx = format!(\n                        \"#{i} {}x{} use_radius={ur} A={} B={}\",\n                        ty_name(ta),\n                        ty_name(tb),\n                        shape_desc(&a),\n                        shape_desc(&b)\n                    );\n                    let oc = call_gjk(&p.c, &a, None, &b, None, ur, true, true, true, None);\n                    let or = call_gjk(&p.r, &a, None, &b, None, ur, true, true, true, None);\n                    eq_gjk(&ctx, &oc, &or);\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 49-52 — every transform combination (incl. rotations and non-unit c2r)\n// ===========================================================================\n\n#[test]\nfn cfg49_52_gjk_transforms() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 49);\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..500 {\n                let a = scene_shape(&mut rng, ta);\n                let b = scene_shape(&mut rng, tb);\n                let txa = transforms(&mut rng);\n                let txb = transforms(&mut rng);\n                for (na, xa) in &txa {\n                    for (nb, xb) in &txb {\n                        for ur in [0i32, 1] {\n                            let ctx = format!(\n                                \"#{i} {}x{} ax={na} bx={nb} use_radius={ur} A={} B={} axv={:?} bxv={:?}\",\n                                ty_name(ta),\n                                ty_name(tb),\n                                shape_desc(&a),\n                                shape_desc(&b),\n                                xa,\n                                xb\n                            );\n                            let oc = call_gjk(\n                                &p.c,\n                                &a,\n                                xa.as_ref(),\n                                &b,\n                                xb.as_ref(),\n                                ur,\n                                true,\n                                true,\n                                true,\n                                None,\n                            );\n                            let or = call_gjk(\n                                &p.r,\n                                &a,\n                                xa.as_ref(),\n                                &b,\n                                xb.as_ref(),\n                                ur,\n                                true,\n                                true,\n                                true,\n                                None,\n                            );\n                            eq_gjk(&ctx, &oc, &or);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 53 — cache non-NULL, cold (count == 0)\n// ===========================================================================\n\n#[test]\nfn cfg53_gjk_cache_cold() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 53);\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..2000 {\n                let a = scene_shape(&mut rng, ta);\n                let b = scene_shape(&mut rng, tb);\n                // A cold cache: count == 0 but the other fields deliberately garbage,\n                // to prove they are ignored (`cache_was_good = !!cache->count`).\n                let cold = C2GJKCache {\n                    metric: f32::from_bits(0xDEAD_BEEF),\n                    count: 0,\n                    iA: [7, 6, 5],\n                    iB: [4, 3, 2],\n                    div: f32::from_bits(0xFEED_FACE),\n                };\n                let mut cc = cold;\n                let mut cr = cold;\n                let ctx = format!(\n                    \"#{i} {}x{} A={} B={}\",\n                    ty_name(ta),\n                    ty_name(tb),\n                    shape_desc(&a),\n                    shape_desc(&b)\n                );\n                let oc = call_gjk(&p.c, &a, None, &b, None, 1, true, true, true, Some(&mut cc));\n                let or = call_gjk(&p.r, &a, None, &b, None, 1, true, true, true, Some(&mut cr));\n                eq_gjk(&ctx, &oc, &or);\n                eq_cache(\"cold-cache writeback\", &ctx, &cc, &cr);\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 54, 55 — warm cache, reused as-is and after moving shape B\n// ===========================================================================\n\n#[test]\nfn cfg54_55_gjk_cache_warm() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 54);\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..1500 {\n                let a = scene_shape(&mut rng, ta);\n                let b = scene_shape(&mut rng, tb);\n                let mut cc = C2GJKCache::default();\n                let mut cr = C2GJKCache::default();\n                let base = format!(\n                    \"#{i} {}x{} A={} B={}\",\n                    ty_name(ta),\n                    ty_name(tb),\n                    shape_desc(&a),\n                    shape_desc(&b)\n                );\n\n                // call 1 — cold, fills the cache\n                let oc1 = call_gjk(&p.c, &a, None, &b, None, 1, true, true, true, Some(&mut cc));\n                let or1 = call_gjk(&p.r, &a, None, &b, None, 1, true, true, true, Some(&mut cr));\n                eq_gjk(&format!(\"{base} [call1]\"), &oc1, &or1);\n                eq_cache(\"cache after call1\", &base, &cc, &cr);\n\n                // call 2 — warm, same shapes (row 54)\n                let oc2 = call_gjk(&p.c, &a, None, &b, None, 1, true, true, true, Some(&mut cc));\n                let or2 = call_gjk(&p.r, &a, None, &b, None, 1, true, true, true, Some(&mut cr));\n                eq_gjk(&format!(\"{base} [call2 warm]\"), &oc2, &or2);\n                eq_cache(\"cache after call2\", &base, &cc, &cr);\n\n                // call 3 — warm cache reused after MOVING B (row 55)\n                let b2 = match b {\n                    Shape::Circle(mut c) => {\n                        c.p.x += rng.range(-20.0, 20.0);\n                        c.p.y += rng.range(-20.0, 20.0);\n                        Shape::Circle(c)\n                    }\n                    Shape::Aabb(mut bb) => {\n                        let d = rng.range(-20.0, 20.0);\n                        bb.min.x += d;\n                        bb.max.x += d;\n                        Shape::Aabb(bb)\n                    }\n                    Shape::Capsule(mut c) => {\n                        let d = rng.range(-20.0, 20.0);\n                        c.a.x += d;\n                        c.b.y += d;\n                        Shape::Capsule(c)\n                    }\n                };\n                let oc3 = call_gjk(&p.c, &a, None, &b2, None, 1, true, true, true, Some(&mut cc));\n                let or3 = call_gjk(&p.r, &a, None, &b2, None, 1, true, true, true, Some(&mut cr));\n                eq_gjk(&format!(\"{base} [call3 moved B={}]\", shape_desc(&b2)), &oc3, &or3);\n                eq_cache(\"cache after call3\", &base, &cc, &cr);\n\n                // call 4 — warm across a transform change too\n                let xt = C2x {\n                    p: C2v {\n                        x: rng.range(-30.0, 30.0),\n                        y: rng.range(-30.0, 30.0),\n                    },\n                    r: {\n                        let t = rng.range(-3.2, 3.2);\n                        C2r {\n                            c: t.cos(),\n                            s: t.sin(),\n                        }\n                    },\n                };\n                let oc4 = call_gjk(\n                    &p.c,\n                    &a,\n                    Some(&xt),\n                    &b2,\n                    None,\n                    1,\n                    true,\n                    true,\n                    true,\n                    Some(&mut cc),\n                );\n                let or4 = call_gjk(\n                    &p.r,\n                    &a,\n                    Some(&xt),\n                    &b2,\n                    None,\n                    1,\n                    true,\n                    true,\n                    true,\n                    Some(&mut cr),\n                );\n                eq_gjk(&format!(\"{base} [call4 xform]\"), &oc4, &or4);\n                eq_cache(\"cache after call4\", &base, &cc, &cr);\n            }\n        }\n    }\n}\n\n/// Row 54 sanity: the warm path (`cache_was_read == 1`) really is being taken.\n#[test]\nfn cfg54_warm_path_is_reached() {\n    let p = load();\n    let mut rng = Rng::new(4242);\n    let mut warm_counts = [0usize; 4]; // observed cache->count after call 1\n    for _ in 0..3000 {\n        let a = scene_shape(&mut rng, ALL_TYPES[rng.below(3) as usize]);\n        let b = scene_shape(&mut rng, ALL_TYPES[rng.below(3) as usize]);\n        let mut cc = C2GJKCache::default();\n        call_gjk(&p.c, &a, None, &b, None, 1, true, true, true, Some(&mut cc));\n        if (0..4).contains(&cc.count) {\n            warm_counts[cc.count as usize] += 1;\n        }\n    }\n    // counts 1, 2 and 3 must all occur, otherwise the warm-cache path is untested\n    assert!(\n        warm_counts[1] > 0 && warm_counts[2] > 0 && warm_counts[3] > 0,\n        \"cache counts observed after a cold call: {warm_counts:?}\"\n    );\n}\n\n// ===========================================================================\n// Row 56 — the 8 NULL/non-NULL combinations of outA / outB / iterations\n// ===========================================================================\n\n#[test]\nfn cfg56_gjk_optional_outputs() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 56);\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..400 {\n                let a = scene_shape(&mut rng, ta);\n                let b = scene_shape(&mut rng, tb);\n                for mask in 0..8u32 {\n                    let (wa, wb, wi) =\n                        (mask & 1 != 0, mask & 2 != 0, mask & 4 != 0);\n                    for cache_on in [false, true] {\n                        let mut cc = C2GJKCache::default();\n                        let mut cr = C2GJKCache::default();\n                        let ctx = format!(\n                            \"#{i} {}x{} mask={mask:03b} cache={cache_on} A={} B={}\",\n                            ty_name(ta),\n                            ty_name(tb),\n                            shape_desc(&a),\n                            shape_desc(&b)\n                        );\n                        let oc = call_gjk(\n                            &p.c,\n                            &a,\n                            None,\n                            &b,\n                            None,\n                            1,\n                            wa,\n                            wb,\n                            wi,\n                            if cache_on { Some(&mut cc) } else { None },\n                        );\n                        let or = call_gjk(\n                            &p.r,\n                            &a,\n                            None,\n                            &b,\n                            None,\n                            1,\n                            wa,\n                            wb,\n                            wi,\n                            if cache_on { Some(&mut cr) } else { None },\n                        );\n                        eq_gjk(&ctx, &oc, &or);\n                        // when the pointer was NULL the poison value must survive in BOTH\n                        if !wa {\n                            assert_eq!(\n                                oc.outA.x.to_bits(),\n                                0xDEAD_BEEF,\n                                \"C wrote outA despite NULL ({ctx})\"\n                            );\n                            assert_eq!(\n                                or.outA.x.to_bits(),\n                                0xDEAD_BEEF,\n                                \"RUST wrote outA despite NULL ({ctx})\"\n                            );\n                        }\n                        if !wb {\n                            assert_eq!(oc.outB.x.to_bits(), 0xCAFE_BABE);\n                            assert_eq!(or.outB.x.to_bits(), 0xCAFE_BABE);\n                        }\n                        if !wi {\n                            assert_eq!(oc.iterations, -12345);\n                            assert_eq!(or.iterations, -12345);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 57, 58, 59 — hit path, exact-touching boundary, coincident shapes\n// ===========================================================================\n\n#[test]\nfn cfg57_gjk_hit_path() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 57);\n    let mut hits = 0usize;\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..2000 {\n                // deliberately deeply overlapping: both centred near the origin, large\n                let a = match ta {\n                    C2_TYPE_CIRCLE => Shape::Circle(C2Circle {\n                        p: C2v {\n                            x: rng.range(-2.0, 2.0),\n                            y: rng.range(-2.0, 2.0),\n                        },\n                        r: rng.range(10.0, 30.0),\n                    }),\n                    C2_TYPE_AABB => Shape::Aabb(C2AABB {\n                        min: C2v { x: -20.0, y: -20.0 },\n                        max: C2v { x: 20.0, y: 20.0 },\n                    }),\n                    _ => Shape::Capsule(C2Capsule {\n                        a: C2v { x: -15.0, y: 0.0 },\n                        b: C2v { x: 15.0, y: 0.0 },\n                        r: rng.range(5.0, 15.0),\n                    }),\n                };\n                let b = match tb {\n                    C2_TYPE_CIRCLE => Shape::Circle(C2Circle {\n                        p: C2v {\n                            x: rng.range(-2.0, 2.0),\n                            y: rng.range(-2.0, 2.0),\n                        },\n                        r: rng.range(10.0, 30.0),\n                    }),\n                    C2_TYPE_AABB => Shape::Aabb(C2AABB {\n                        min: C2v { x: -18.0, y: -18.0 },\n                        max: C2v { x: 18.0, y: 18.0 },\n                    }),\n                    _ => Shape::Capsule(C2Capsule {\n                        a: C2v { x: 0.0, y: -15.0 },\n                        b: C2v { x: 0.0, y: 15.0 },\n                        r: rng.range(5.0, 15.0),\n                    }),\n                };\n                for ur in [0i32, 1] {\n                    let ctx = format!(\n                        \"#{i} {}x{} ur={ur} A={} B={}\",\n                        ty_name(ta),\n                        ty_name(tb),\n                        shape_desc(&a),\n                        shape_desc(&b)\n                    );\n                    let mut cc = C2GJKCache::default();\n                    let mut cr = C2GJKCache::default();\n                    let oc = call_gjk(&p.c, &a, None, &b, None, ur, true, true, true, Some(&mut cc));\n                    let or = call_gjk(&p.r, &a, None, &b, None, ur, true, true, true, Some(&mut cr));\n                    eq_gjk(&ctx, &oc, &or);\n                    eq_cache(\"cache\", &ctx, &cc, &cr);\n                    if cc.count == 3 {\n                        hits += 1;\n                    }\n                }\n            }\n        }\n    }\n    assert!(hits > 100, \"the hit (s.count==3) path was reached only {hits} times\");\n}\n\n#[test]\nfn cfg58_59_gjk_touching_and_coincident() {\n    let p = load();\n    let mut cases: Vec<(String, Shape, Shape)> = Vec::new();\n\n    // exactly touching circles (dist == rA + rB)\n    for d in [0.0f32, 10.0, 20.0, 40.0, 1.0e6] {\n        for (ra, rb) in [(5.0f32, 5.0f32), (0.0, 10.0), (10.0, 0.0), (0.0, 0.0)] {\n            let a = Shape::Circle(C2Circle {\n                p: C2v { x: 0.0, y: 0.0 },\n                r: ra,\n            });\n            let b = Shape::Circle(C2Circle {\n                p: C2v { x: ra + rb + d, y: 0.0 },\n                r: rb,\n            });\n            cases.push((format!(\"touch+{d} circles r={ra},{rb}\"), a, b));\n            // and one ULP inside / outside the touching distance\n            for delta in [-1i32, 1] {\n                let base = ra + rb;\n                let x = if delta < 0 {\n                    f32::from_bits(base.to_bits().wrapping_sub(1))\n                } else {\n                    f32::from_bits(base.to_bits().wrapping_add(1))\n                };\n                cases.push((\n                    format!(\"touch ulp{delta} r={ra},{rb}\"),\n                    Shape::Circle(C2Circle {\n                        p: C2v { x: 0.0, y: 0.0 },\n                        r: ra,\n                    }),\n                    Shape::Circle(C2Circle {\n                        p: C2v { x, y: 0.0 },\n                        r: rb,\n                    }),\n                ));\n            }\n        }\n    }\n    // coincident shapes (row 59: dist <= FLT_EPSILON -> midpoint collapse)\n    let z = C2v { x: 0.0, y: 0.0 };\n    for r in [0.0f32, 1.0, 20.0] {\n        cases.push((\n            format!(\"coincident circles r={r}\"),\n            Shape::Circle(C2Circle { p: z, r }),\n            Shape::Circle(C2Circle { p: z, r }),\n        ));\n    }\n    cases.push((\n        \"coincident aabbs\".into(),\n        Shape::Aabb(C2AABB {\n            min: C2v { x: -1.0, y: -1.0 },\n            max: C2v { x: 1.0, y: 1.0 },\n        }),\n        Shape::Aabb(C2AABB {\n            min: C2v { x: -1.0, y: -1.0 },\n            max: C2v { x: 1.0, y: 1.0 },\n        }),\n    ));\n    cases.push((\n        \"coincident capsules\".into(),\n        Shape::Capsule(C2Capsule {\n            a: C2v { x: -3.0, y: 0.0 },\n            b: C2v { x: 3.0, y: 0.0 },\n            r: 2.0,\n        }),\n        Shape::Capsule(C2Capsule {\n            a: C2v { x: -3.0, y: 0.0 },\n            b: C2v { x: 3.0, y: 0.0 },\n            r: 2.0,\n        }),\n    ));\n    // sub-epsilon separation\n    cases.push((\n        \"sub-epsilon separation\".into(),\n        Shape::Circle(C2Circle { p: z, r: 0.0 }),\n        Shape::Circle(C2Circle {\n            p: C2v {\n                x: FLT_EPSILON * 0.5,\n                y: 0.0,\n            },\n            r: 0.0,\n        }),\n    ));\n    cases.push((\n        \"exactly-epsilon separation\".into(),\n        Shape::Circle(C2Circle { p: z, r: 0.0 }),\n        Shape::Circle(C2Circle {\n            p: C2v {\n                x: FLT_EPSILON,\n                y: 0.0,\n            },\n            r: 0.0,\n        }),\n    ));\n\n    for (name, a, b) in &cases {\n        for ur in [0i32, 1] {\n            for cache_on in [false, true] {\n                let mut cc = C2GJKCache::default();\n                let mut cr = C2GJKCache::default();\n                let ctx = format!(\n                    \"{name} ur={ur} cache={cache_on} A={} B={}\",\n                    shape_desc(a),\n                    shape_desc(b)\n                );\n                let oc = call_gjk(\n                    &p.c,\n                    a,\n                    None,\n                    b,\n                    None,\n                    ur,\n                    true,\n                    true,\n                    true,\n                    if cache_on { Some(&mut cc) } else { None },\n                );\n                let or = call_gjk(\n                    &p.r,\n                    a,\n                    None,\n                    b,\n                    None,\n                    ur,\n                    true,\n                    true,\n                    true,\n                    if cache_on { Some(&mut cr) } else { None },\n                );\n                eq_gjk(&ctx, &oc, &or);\n                eq_cache(\"cache\", &ctx, &cc, &cr);\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 60 — degenerate shapes, all 9 type pairs\n// ===========================================================================\n\n#[test]\nfn cfg60_gjk_degenerate_shapes() {\n    let p = load();\n    let z = C2v { x: 0.0, y: 0.0 };\n    let degens: Vec<Shape> = vec![\n        Shape::Circle(C2Circle { p: z, r: 0.0 }),\n        Shape::Circle(C2Circle { p: z, r: -0.0 }),\n        Shape::Circle(C2Circle {\n            p: C2v { x: 5.0, y: 5.0 },\n            r: -3.0,\n        }),\n        Shape::Aabb(C2AABB { min: z, max: z }),\n        Shape::Aabb(C2AABB {\n            min: C2v { x: 2.0, y: 2.0 },\n            max: C2v { x: -2.0, y: -2.0 },\n        }),\n        Shape::Aabb(C2AABB {\n            min: C2v { x: 1.0, y: -5.0 },\n            max: C2v { x: 1.0, y: 5.0 },\n        }),\n        Shape::Capsule(C2Capsule { a: z, b: z, r: 0.0 }),\n        Shape::Capsule(C2Capsule { a: z, b: z, r: 7.0 }),\n        Shape::Capsule(C2Capsule {\n            a: C2v { x: -4.0, y: 0.0 },\n            b: C2v { x: 4.0, y: 0.0 },\n            r: 0.0,\n        }),\n        Shape::Capsule(C2Capsule {\n            a: C2v { x: -4.0, y: 0.0 },\n            b: C2v { x: 4.0, y: 0.0 },\n            r: -2.0,\n        }),\n    ];\n    let offsets = [0.0f32, 1.0, 50.0, -37.5];\n    for a0 in &degens {\n        for b0 in &degens {\n            for off in offsets {\n                // translate B so the pair is sometimes separated, sometimes coincident\n                let b = match *b0 {\n                    Shape::Circle(mut c) => {\n                        c.p.x += off;\n                        Shape::Circle(c)\n                    }\n                    Shape::Aabb(mut bb) => {\n                        bb.min.x += off;\n                        bb.max.x += off;\n                        Shape::Aabb(bb)\n                    }\n                    Shape::Capsule(mut c) => {\n                        c.a.x += off;\n                        c.b.x += off;\n                        Shape::Capsule(c)\n                    }\n                };\n                for ur in [0i32, 1] {\n                    let mut cc = C2GJKCache::default();\n                    let mut cr = C2GJKCache::default();\n                    let ctx = format!(\n                        \"degen ur={ur} off={off} A={} B={}\",\n                        shape_desc(a0),\n                        shape_desc(&b)\n                    );\n                    let oc =\n                        call_gjk(&p.c, a0, None, &b, None, ur, true, true, true, Some(&mut cc));\n                    let or =\n                        call_gjk(&p.r, a0, None, &b, None, ur, true, true, true, Some(&mut cr));\n                    eq_gjk(&ctx, &oc, &or);\n                    eq_cache(\"cache\", &ctx, &cc, &cr);\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 61 — extreme magnitudes (overflow to inf) and subnormal separations\n// ===========================================================================\n\n#[test]\nfn cfg61_gjk_extreme_magnitudes() {\n    let p = load();\n    let scales = [\n        1.0e-30f32,\n        1.0e-6,\n        1.0,\n        1.0e6,\n        1.0e20,\n        1.0e30,\n        f32::MAX,\n        f32::MIN_POSITIVE,\n    ];\n    for s in scales {\n        for &ta in &ALL_TYPES {\n            for &tb in &ALL_TYPES {\n                let a = match ta {\n                    C2_TYPE_CIRCLE => Shape::Circle(C2Circle {\n                        p: C2v { x: 0.0, y: 0.0 },\n                        r: s,\n                    }),\n                    C2_TYPE_AABB => Shape::Aabb(C2AABB {\n                        min: C2v { x: -s, y: -s },\n                        max: C2v { x: s, y: s },\n                    }),\n                    _ => Shape::Capsule(C2Capsule {\n                        a: C2v { x: -s, y: 0.0 },\n                        b: C2v { x: s, y: 0.0 },\n                        r: s,\n                    }),\n                };\n                let b = match tb {\n                    C2_TYPE_CIRCLE => Shape::Circle(C2Circle {\n                        p: C2v { x: s, y: s },\n                        r: s,\n                    }),\n                    C2_TYPE_AABB => Shape::Aabb(C2AABB {\n                        min: C2v { x: s, y: s },\n                        max: C2v { x: 2.0 * s, y: 2.0 * s },\n                    }),\n                    _ => Shape::Capsule(C2Capsule {\n                        a: C2v { x: s, y: s },\n                        b: C2v { x: 2.0 * s, y: s },\n                        r: s,\n                    }),\n                };\n                for ur in [0i32, 1] {\n                    let mut cc = C2GJKCache::default();\n                    let mut cr = C2GJKCache::default();\n                    let ctx = format!(\n                        \"scale={s:e} {}x{} ur={ur} A={} B={}\",\n                        ty_name(ta),\n                        ty_name(tb),\n                        shape_desc(&a),\n                        shape_desc(&b)\n                    );\n                    let oc =\n                        call_gjk(&p.c, &a, None, &b, None, ur, true, true, true, Some(&mut cc));\n                    let or =\n                        call_gjk(&p.r, &a, None, &b, None, ur, true, true, true, Some(&mut cr));\n                    eq_gjk(&ctx, &oc, &or);\n                    eq_cache(\"cache\", &ctx, &cc, &cr);\n                }\n            }\n        }\n    }\n}\n\n/// Row 61b — fully random shapes from the *mixed* float pool (NaN / inf coordinates).\n/// This is also where the iteration-cap and no-progress break paths get stressed.\n#[test]\nfn cfg61b_gjk_mixed_float_pool() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 61);\n    let mut iter_hist = [0usize; 21];\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..2000 {\n                let a = rand_shape(&mut rng, ta);\n                let b = rand_shape(&mut rng, tb);\n                for ur in [0i32, 1] {\n                    let mut cc = C2GJKCache::default();\n                    let mut cr = C2GJKCache::default();\n                    let ctx = format!(\n                        \"#{i} {}x{} ur={ur} A={} B={}\",\n                        ty_name(ta),\n                        ty_name(tb),\n                        shape_desc(&a),\n                        shape_desc(&b)\n                    );\n                    let oc =\n                        call_gjk(&p.c, &a, None, &b, None, ur, true, true, true, Some(&mut cc));\n                    let or =\n                        call_gjk(&p.r, &a, None, &b, None, ur, true, true, true, Some(&mut cr));\n                    eq_gjk(&ctx, &oc, &or);\n                    eq_cache(\"cache\", &ctx, &cc, &cr);\n                    if (0..=20).contains(&oc.iterations) {\n                        iter_hist[oc.iterations as usize] += 1;\n                    }\n                }\n            }\n        }\n    }\n    println!(\"c2GJK iteration histogram (mixed pool): {iter_hist:?}\");\n    assert!(iter_hist[0] > 0 && iter_hist[1] > 0, \"iteration counts: {iter_hist:?}\");\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1326,"cache_read_input_tokens":141846,"cache_creation":{"ephemeral_5m_input_tokens":1326,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"01a68480-bbf5-45e9-96ef-206dacf1aacc","uuid":"f26afe9a-c261-4ffa-bba6-4987f4349da2","timestamp":"2026-08-27T16:16:34.472Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01YBp8SnZE917SXmHfZZ4Ztq","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-lBJjNJ/translation/tests/phase_b_gjk.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"01a68480-bbf5-45e9-96ef-206dacf1aacc","uuid":"7576ceac-6195-4b2f-a0c6-8af9d6cdffa3","timestamp":"2026-08-27T16:16:34.485Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-lBJjNJ/translation/tests/phase_b_gjk.rs","content":"//! Phase B — `c2GJK`, the lowest-level composed entry point (CONFIGS.md rows 39-61).\n//!\n//! `c2GJK` is where the whole pipeline is driven: `c2MakeProxy` -> cache read ->\n//! `c22`/`c23` -> `c2L`/`c2D`/`c2Support` -> `c2Witness` -> radius shrink -> cache write.\n//! Every option combination is exercised directly rather than only through the\n//! `c2*to*` convenience wrappers.\n\n#![allow(non_snake_case)]\n\nmod common;\nuse common::*;\n\nconst SEED: u64 = 0x_9E37_79B9_7F4A_7C15;\n\n/// Shapes drawn inside a bounded region so that separation / touching / overlap /\n/// containment all occur frequently.\nfn scene_shape(rng: &mut Rng, ty: C2_TYPE) -> Shape {\n    let c = |rng: &mut Rng| C2v {\n        x: rng.range(-50.0, 50.0),\n        y: rng.range(-50.0, 50.0),\n    };\n    match ty {\n        C2_TYPE_CIRCLE => Shape::Circle(C2Circle {\n            p: c(rng),\n            r: match rng.below(8) {\n                0 => 0.0,\n                1 => rng.range(0.0, 1.0e-5),\n                _ => rng.range(0.0, 30.0),\n            },\n        }),\n        C2_TYPE_AABB => {\n            let a = c(rng);\n            let b = c(rng);\n            match rng.below(10) {\n                0 => Shape::Aabb(C2AABB { min: a, max: a }),\n                1 => Shape::Aabb(C2AABB { min: b, max: a }),\n                _ => Shape::Aabb(C2AABB {\n                    min: C2v {\n                        x: a.x.min(b.x),\n                        y: a.y.min(b.y),\n                    },\n                    max: C2v {\n                        x: a.x.max(b.x),\n                        y: a.y.max(b.y),\n                    },\n                }),\n            }\n        }\n        _ => {\n            let a = c(rng);\n            let b = if rng.below(10) == 0 { a } else { c(rng) };\n            Shape::Capsule(C2Capsule {\n                a,\n                b,\n                r: match rng.below(8) {\n                    0 => 0.0,\n                    _ => rng.range(0.0, 20.0),\n                },\n            })\n        }\n    }\n}\n\n/// A pool of transforms covering every shape the C distinguishes.\nfn transforms(rng: &mut Rng) -> Vec<(&'static str, Option<C2x>)> {\n    let t = rng.range(-3.2, 3.2);\n    vec![\n        (\"null\", None),\n        (\n            \"identity\",\n            Some(C2x {\n                p: C2v { x: 0.0, y: 0.0 },\n                r: C2r { c: 1.0, s: 0.0 },\n            }),\n        ),\n        (\n            \"translate\",\n            Some(C2x {\n                p: C2v {\n                    x: rng.range(-40.0, 40.0),\n                    y: rng.range(-40.0, 40.0),\n                },\n                r: C2r { c: 1.0, s: 0.0 },\n            }),\n        ),\n        (\n            \"rotate\",\n            Some(C2x {\n                p: C2v { x: 0.0, y: 0.0 },\n                r: C2r {\n                    c: t.cos(),\n                    s: t.sin(),\n                },\n            }),\n        ),\n        (\n            \"both\",\n            Some(C2x {\n                p: C2v {\n                    x: rng.range(-40.0, 40.0),\n                    y: rng.range(-40.0, 40.0),\n                },\n                r: C2r {\n                    c: t.cos(),\n                    s: t.sin(),\n                },\n            }),\n        ),\n        (\n            \"non-unit\",\n            Some(C2x {\n                p: C2v {\n                    x: rng.range(-10.0, 10.0),\n                    y: rng.range(-10.0, 10.0),\n                },\n                r: C2r {\n                    c: rng.range(-2.5, 2.5),\n                    s: rng.range(-2.5, 2.5),\n                },\n            }),\n        ),\n    ]\n}\n\n// ===========================================================================\n// Rows 39-47 — every (typeA, typeB) pair, default options\n// ===========================================================================\n\n#[test]\nfn cfg39_47_gjk_all_type_pairs() {\n    let p = load();\n    let mut rng = Rng::new(SEED);\n    let per_pair = 3000;\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..per_pair {\n                let a = scene_shape(&mut rng, ta);\n                let b = scene_shape(&mut rng, tb);\n                let ctx = format!(\n                    \"#{i} {}x{} A={} B={}\",\n                    ty_name(ta),\n                    ty_name(tb),\n                    shape_desc(&a),\n                    shape_desc(&b)\n                );\n                let oc = call_gjk(&p.c, &a, None, &b, None, 1, true, true, true, None);\n                let or = call_gjk(&p.r, &a, None, &b, None, 1, true, true, true, None);\n                eq_gjk(&ctx, &oc, &or);\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 48 — use_radius = 0\n// ===========================================================================\n\n#[test]\nfn cfg48_gjk_use_radius_0() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 48);\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..3000 {\n                let a = scene_shape(&mut rng, ta);\n                let b = scene_shape(&mut rng, tb);\n                for ur in [0i32, 1, -1, 2, i32::MIN] {\n                    let ctx = format!(\n                        \"#{i} {}x{} use_radius={ur} A={} B={}\",\n                        ty_name(ta),\n                        ty_name(tb),\n                        shape_desc(&a),\n                        shape_desc(&b)\n                    );\n                    let oc = call_gjk(&p.c, &a, None, &b, None, ur, true, true, true, None);\n                    let or = call_gjk(&p.r, &a, None, &b, None, ur, true, true, true, None);\n                    eq_gjk(&ctx, &oc, &or);\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 49-52 — every transform combination (incl. rotations and non-unit c2r)\n// ===========================================================================\n\n#[test]\nfn cfg49_52_gjk_transforms() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 49);\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..500 {\n                let a = scene_shape(&mut rng, ta);\n                let b = scene_shape(&mut rng, tb);\n                let txa = transforms(&mut rng);\n                let txb = transforms(&mut rng);\n                for (na, xa) in &txa {\n                    for (nb, xb) in &txb {\n                        for ur in [0i32, 1] {\n                            let ctx = format!(\n                                \"#{i} {}x{} ax={na} bx={nb} use_radius={ur} A={} B={} axv={:?} bxv={:?}\",\n                                ty_name(ta),\n                                ty_name(tb),\n                                shape_desc(&a),\n                                shape_desc(&b),\n                                xa,\n                                xb\n                            );\n                            let oc = call_gjk(\n                                &p.c,\n                                &a,\n                                xa.as_ref(),\n                                &b,\n                                xb.as_ref(),\n                                ur,\n                                true,\n                                true,\n                                true,\n                                None,\n                            );\n                            let or = call_gjk(\n                                &p.r,\n                                &a,\n                                xa.as_ref(),\n                                &b,\n                                xb.as_ref(),\n                                ur,\n                                true,\n                                true,\n                                true,\n                                None,\n                            );\n                            eq_gjk(&ctx, &oc, &or);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 53 — cache non-NULL, cold (count == 0)\n// ===========================================================================\n\n#[test]\nfn cfg53_gjk_cache_cold() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 53);\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..2000 {\n                let a = scene_shape(&mut rng, ta);\n                let b = scene_shape(&mut rng, tb);\n                // A cold cache: count == 0 but the other fields deliberately garbage,\n                // to prove they are ignored (`cache_was_good = !!cache->count`).\n                let cold = C2GJKCache {\n                    metric: f32::from_bits(0xDEAD_BEEF),\n                    count: 0,\n                    iA: [7, 6, 5],\n                    iB: [4, 3, 2],\n                    div: f32::from_bits(0xFEED_FACE),\n                };\n                let mut cc = cold;\n                let mut cr = cold;\n                let ctx = format!(\n                    \"#{i} {}x{} A={} B={}\",\n                    ty_name(ta),\n                    ty_name(tb),\n                    shape_desc(&a),\n                    shape_desc(&b)\n                );\n                let oc = call_gjk(&p.c, &a, None, &b, None, 1, true, true, true, Some(&mut cc));\n                let or = call_gjk(&p.r, &a, None, &b, None, 1, true, true, true, Some(&mut cr));\n                eq_gjk(&ctx, &oc, &or);\n                eq_cache(\"cold-cache writeback\", &ctx, &cc, &cr);\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 54, 55 — warm cache, reused as-is and after moving shape B\n// ===========================================================================\n\n#[test]\nfn cfg54_55_gjk_cache_warm() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 54);\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..1500 {\n                let a = scene_shape(&mut rng, ta);\n                let b = scene_shape(&mut rng, tb);\n                let mut cc = C2GJKCache::default();\n                let mut cr = C2GJKCache::default();\n                let base = format!(\n                    \"#{i} {}x{} A={} B={}\",\n                    ty_name(ta),\n                    ty_name(tb),\n                    shape_desc(&a),\n                    shape_desc(&b)\n                );\n\n                // call 1 — cold, fills the cache\n                let oc1 = call_gjk(&p.c, &a, None, &b, None, 1, true, true, true, Some(&mut cc));\n                let or1 = call_gjk(&p.r, &a, None, &b, None, 1, true, true, true, Some(&mut cr));\n                eq_gjk(&format!(\"{base} [call1]\"), &oc1, &or1);\n                eq_cache(\"cache after call1\", &base, &cc, &cr);\n\n                // call 2 — warm, same shapes (row 54)\n                let oc2 = call_gjk(&p.c, &a, None, &b, None, 1, true, true, true, Some(&mut cc));\n                let or2 = call_gjk(&p.r, &a, None, &b, None, 1, true, true, true, Some(&mut cr));\n                eq_gjk(&format!(\"{base} [call2 warm]\"), &oc2, &or2);\n                eq_cache(\"cache after call2\", &base, &cc, &cr);\n\n                // call 3 — warm cache reused after MOVING B (row 55)\n                let b2 = match b {\n                    Shape::Circle(mut c) => {\n                        c.p.x += rng.range(-20.0, 20.0);\n                        c.p.y += rng.range(-20.0, 20.0);\n                        Shape::Circle(c)\n                    }\n                    Shape::Aabb(mut bb) => {\n                        let d = rng.range(-20.0, 20.0);\n                        bb.min.x += d;\n                        bb.max.x += d;\n                        Shape::Aabb(bb)\n                    }\n                    Shape::Capsule(mut c) => {\n                        let d = rng.range(-20.0, 20.0);\n                        c.a.x += d;\n                        c.b.y += d;\n                        Shape::Capsule(c)\n                    }\n                };\n                let oc3 = call_gjk(&p.c, &a, None, &b2, None, 1, true, true, true, Some(&mut cc));\n                let or3 = call_gjk(&p.r, &a, None, &b2, None, 1, true, true, true, Some(&mut cr));\n                eq_gjk(&format!(\"{base} [call3 moved B={}]\", shape_desc(&b2)), &oc3, &or3);\n                eq_cache(\"cache after call3\", &base, &cc, &cr);\n\n                // call 4 — warm across a transform change too\n                let xt = C2x {\n                    p: C2v {\n                        x: rng.range(-30.0, 30.0),\n                        y: rng.range(-30.0, 30.0),\n                    },\n                    r: {\n                        let t = rng.range(-3.2, 3.2);\n                        C2r {\n                            c: t.cos(),\n                            s: t.sin(),\n                        }\n                    },\n                };\n                let oc4 = call_gjk(\n                    &p.c,\n                    &a,\n                    Some(&xt),\n                    &b2,\n                    None,\n                    1,\n                    true,\n                    true,\n                    true,\n                    Some(&mut cc),\n                );\n                let or4 = call_gjk(\n                    &p.r,\n                    &a,\n                    Some(&xt),\n                    &b2,\n                    None,\n                    1,\n                    true,\n                    true,\n                    true,\n                    Some(&mut cr),\n                );\n                eq_gjk(&format!(\"{base} [call4 xform]\"), &oc4, &or4);\n                eq_cache(\"cache after call4\", &base, &cc, &cr);\n            }\n        }\n    }\n}\n\n/// Row 54 sanity: the warm path (`cache_was_read == 1`) really is being taken.\n#[test]\nfn cfg54_warm_path_is_reached() {\n    let p = load();\n    let mut rng = Rng::new(4242);\n    let mut warm_counts = [0usize; 4]; // observed cache->count after call 1\n    for _ in 0..3000 {\n        let a = scene_shape(&mut rng, ALL_TYPES[rng.below(3) as usize]);\n        let b = scene_shape(&mut rng, ALL_TYPES[rng.below(3) as usize]);\n        let mut cc = C2GJKCache::default();\n        call_gjk(&p.c, &a, None, &b, None, 1, true, true, true, Some(&mut cc));\n        if (0..4).contains(&cc.count) {\n            warm_counts[cc.count as usize] += 1;\n        }\n    }\n    // counts 1, 2 and 3 must all occur, otherwise the warm-cache path is untested\n    assert!(\n        warm_counts[1] > 0 && warm_counts[2] > 0 && warm_counts[3] > 0,\n        \"cache counts observed after a cold call: {warm_counts:?}\"\n    );\n}\n\n// ===========================================================================\n// Row 56 — the 8 NULL/non-NULL combinations of outA / outB / iterations\n// ===========================================================================\n\n#[test]\nfn cfg56_gjk_optional_outputs() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 56);\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..400 {\n                let a = scene_shape(&mut rng, ta);\n                let b = scene_shape(&mut rng, tb);\n                for mask in 0..8u32 {\n                    let (wa, wb, wi) =\n                        (mask & 1 != 0, mask & 2 != 0, mask & 4 != 0);\n                    for cache_on in [false, true] {\n                        let mut cc = C2GJKCache::default();\n                        let mut cr = C2GJKCache::default();\n                        let ctx = format!(\n                            \"#{i} {}x{} mask={mask:03b} cache={cache_on} A={} B={}\",\n                            ty_name(ta),\n                            ty_name(tb),\n                            shape_desc(&a),\n                            shape_desc(&b)\n                        );\n                        let oc = call_gjk(\n                            &p.c,\n                            &a,\n                            None,\n                            &b,\n                            None,\n                            1,\n                            wa,\n                            wb,\n                            wi,\n                            if cache_on { Some(&mut cc) } else { None },\n                        );\n                        let or = call_gjk(\n                            &p.r,\n                            &a,\n                            None,\n                            &b,\n                            None,\n                            1,\n                            wa,\n                            wb,\n                            wi,\n                            if cache_on { Some(&mut cr) } else { None },\n                        );\n                        eq_gjk(&ctx, &oc, &or);\n                        // when the pointer was NULL the poison value must survive in BOTH\n                        if !wa {\n                            assert_eq!(\n                                oc.outA.x.to_bits(),\n                                0xDEAD_BEEF,\n                                \"C wrote outA despite NULL ({ctx})\"\n                            );\n                            assert_eq!(\n                                or.outA.x.to_bits(),\n                                0xDEAD_BEEF,\n                                \"RUST wrote outA despite NULL ({ctx})\"\n                            );\n                        }\n                        if !wb {\n                            assert_eq!(oc.outB.x.to_bits(), 0xCAFE_BABE);\n                            assert_eq!(or.outB.x.to_bits(), 0xCAFE_BABE);\n                        }\n                        if !wi {\n                            assert_eq!(oc.iterations, -12345);\n                            assert_eq!(or.iterations, -12345);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 57, 58, 59 — hit path, exact-touching boundary, coincident shapes\n// ===========================================================================\n\n#[test]\nfn cfg57_gjk_hit_path() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 57);\n    let mut hits = 0usize;\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..2000 {\n                // deliberately deeply overlapping: both centred near the origin, large\n                let a = match ta {\n                    C2_TYPE_CIRCLE => Shape::Circle(C2Circle {\n                        p: C2v {\n                            x: rng.range(-2.0, 2.0),\n                            y: rng.range(-2.0, 2.0),\n                        },\n                        r: rng.range(10.0, 30.0),\n                    }),\n                    C2_TYPE_AABB => Shape::Aabb(C2AABB {\n                        min: C2v { x: -20.0, y: -20.0 },\n                        max: C2v { x: 20.0, y: 20.0 },\n                    }),\n                    _ => Shape::Capsule(C2Capsule {\n                        a: C2v { x: -15.0, y: 0.0 },\n                        b: C2v { x: 15.0, y: 0.0 },\n                        r: rng.range(5.0, 15.0),\n                    }),\n                };\n                let b = match tb {\n                    C2_TYPE_CIRCLE => Shape::Circle(C2Circle {\n                        p: C2v {\n                            x: rng.range(-2.0, 2.0),\n                            y: rng.range(-2.0, 2.0),\n                        },\n                        r: rng.range(10.0, 30.0),\n                    }),\n                    C2_TYPE_AABB => Shape::Aabb(C2AABB {\n                        min: C2v { x: -18.0, y: -18.0 },\n                        max: C2v { x: 18.0, y: 18.0 },\n                    }),\n                    _ => Shape::Capsule(C2Capsule {\n                        a: C2v { x: 0.0, y: -15.0 },\n                        b: C2v { x: 0.0, y: 15.0 },\n                        r: rng.range(5.0, 15.0),\n                    }),\n                };\n                for ur in [0i32, 1] {\n                    let ctx = format!(\n                        \"#{i} {}x{} ur={ur} A={} B={}\",\n                        ty_name(ta),\n                        ty_name(tb),\n                        shape_desc(&a),\n                        shape_desc(&b)\n                    );\n                    let mut cc = C2GJKCache::default();\n                    let mut cr = C2GJKCache::default();\n                    let oc = call_gjk(&p.c, &a, None, &b, None, ur, true, true, true, Some(&mut cc));\n                    let or = call_gjk(&p.r, &a, None, &b, None, ur, true, true, true, Some(&mut cr));\n                    eq_gjk(&ctx, &oc, &or);\n                    eq_cache(\"cache\", &ctx, &cc, &cr);\n                    if cc.count == 3 {\n                        hits += 1;\n                    }\n                }\n            }\n        }\n    }\n    assert!(hits > 100, \"the hit (s.count==3) path was reached only {hits} times\");\n}\n\n#[test]\nfn cfg58_59_gjk_touching_and_coincident() {\n    let p = load();\n    let mut cases: Vec<(String, Shape, Shape)> = Vec::new();\n\n    // exactly touching circles (dist == rA + rB)\n    for d in [0.0f32, 10.0, 20.0, 40.0, 1.0e6] {\n        for (ra, rb) in [(5.0f32, 5.0f32), (0.0, 10.0), (10.0, 0.0), (0.0, 0.0)] {\n            let a = Shape::Circle(C2Circle {\n                p: C2v { x: 0.0, y: 0.0 },\n                r: ra,\n            });\n            let b = Shape::Circle(C2Circle {\n                p: C2v { x: ra + rb + d, y: 0.0 },\n                r: rb,\n            });\n            cases.push((format!(\"touch+{d} circles r={ra},{rb}\"), a, b));\n            // and one ULP inside / outside the touching distance\n            for delta in [-1i32, 1] {\n                let base = ra + rb;\n                let x = if delta < 0 {\n                    f32::from_bits(base.to_bits().wrapping_sub(1))\n                } else {\n                    f32::from_bits(base.to_bits().wrapping_add(1))\n                };\n                cases.push((\n                    format!(\"touch ulp{delta} r={ra},{rb}\"),\n                    Shape::Circle(C2Circle {\n                        p: C2v { x: 0.0, y: 0.0 },\n                        r: ra,\n                    }),\n                    Shape::Circle(C2Circle {\n                        p: C2v { x, y: 0.0 },\n                        r: rb,\n                    }),\n                ));\n            }\n        }\n    }\n    // coincident shapes (row 59: dist <= FLT_EPSILON -> midpoint collapse)\n    let z = C2v { x: 0.0, y: 0.0 };\n    for r in [0.0f32, 1.0, 20.0] {\n        cases.push((\n            format!(\"coincident circles r={r}\"),\n            Shape::Circle(C2Circle { p: z, r }),\n            Shape::Circle(C2Circle { p: z, r }),\n        ));\n    }\n    cases.push((\n        \"coincident aabbs\".into(),\n        Shape::Aabb(C2AABB {\n            min: C2v { x: -1.0, y: -1.0 },\n            max: C2v { x: 1.0, y: 1.0 },\n        }),\n        Shape::Aabb(C2AABB {\n            min: C2v { x: -1.0, y: -1.0 },\n            max: C2v { x: 1.0, y: 1.0 },\n        }),\n    ));\n    cases.push((\n        \"coincident capsules\".into(),\n        Shape::Capsule(C2Capsule {\n            a: C2v { x: -3.0, y: 0.0 },\n            b: C2v { x: 3.0, y: 0.0 },\n            r: 2.0,\n        }),\n        Shape::Capsule(C2Capsule {\n            a: C2v { x: -3.0, y: 0.0 },\n            b: C2v { x: 3.0, y: 0.0 },\n            r: 2.0,\n        }),\n    ));\n    // sub-epsilon separation\n    cases.push((\n        \"sub-epsilon separation\".into(),\n        Shape::Circle(C2Circle { p: z, r: 0.0 }),\n        Shape::Circle(C2Circle {\n            p: C2v {\n                x: FLT_EPSILON * 0.5,\n                y: 0.0,\n            },\n            r: 0.0,\n        }),\n    ));\n    cases.push((\n        \"exactly-epsilon separation\".into(),\n        Shape::Circle(C2Circle { p: z, r: 0.0 }),\n        Shape::Circle(C2Circle {\n            p: C2v {\n                x: FLT_EPSILON,\n                y: 0.0,\n            },\n            r: 0.0,\n        }),\n    ));\n\n    for (name, a, b) in &cases {\n        for ur in [0i32, 1] {\n            for cache_on in [false, true] {\n                let mut cc = C2GJKCache::default();\n                let mut cr = C2GJKCache::default();\n                let ctx = format!(\n                    \"{name} ur={ur} cache={cache_on} A={} B={}\",\n                    shape_desc(a),\n                    shape_desc(b)\n                );\n                let oc = call_gjk(\n                    &p.c,\n                    a,\n                    None,\n                    b,\n                    None,\n                    ur,\n                    true,\n                    true,\n                    true,\n                    if cache_on { Some(&mut cc) } else { None },\n                );\n                let or = call_gjk(\n                    &p.r,\n                    a,\n                    None,\n                    b,\n                    None,\n                    ur,\n                    true,\n                    true,\n                    true,\n                    if cache_on { Some(&mut cr) } else { None },\n                );\n                eq_gjk(&ctx, &oc, &or);\n                eq_cache(\"cache\", &ctx, &cc, &cr);\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 60 — degenerate shapes, all 9 type pairs\n// ===========================================================================\n\n#[test]\nfn cfg60_gjk_degenerate_shapes() {\n    let p = load();\n    let z = C2v { x: 0.0, y: 0.0 };\n    let degens: Vec<Shape> = vec![\n        Shape::Circle(C2Circle { p: z, r: 0.0 }),\n        Shape::Circle(C2Circle { p: z, r: -0.0 }),\n        Shape::Circle(C2Circle {\n            p: C2v { x: 5.0, y: 5.0 },\n            r: -3.0,\n        }),\n        Shape::Aabb(C2AABB { min: z, max: z }),\n        Shape::Aabb(C2AABB {\n            min: C2v { x: 2.0, y: 2.0 },\n            max: C2v { x: -2.0, y: -2.0 },\n        }),\n        Shape::Aabb(C2AABB {\n            min: C2v { x: 1.0, y: -5.0 },\n            max: C2v { x: 1.0, y: 5.0 },\n        }),\n        Shape::Capsule(C2Capsule { a: z, b: z, r: 0.0 }),\n        Shape::Capsule(C2Capsule { a: z, b: z, r: 7.0 }),\n        Shape::Capsule(C2Capsule {\n            a: C2v { x: -4.0, y: 0.0 },\n            b: C2v { x: 4.0, y: 0.0 },\n            r: 0.0,\n        }),\n        Shape::Capsule(C2Capsule {\n            a: C2v { x: -4.0, y: 0.0 },\n            b: C2v { x: 4.0, y: 0.0 },\n            r: -2.0,\n        }),\n    ];\n    let offsets = [0.0f32, 1.0, 50.0, -37.5];\n    for a0 in &degens {\n        for b0 in &degens {\n            for off in offsets {\n                // translate B so the pair is sometimes separated, sometimes coincident\n                let b = match *b0 {\n                    Shape::Circle(mut c) => {\n                        c.p.x += off;\n                        Shape::Circle(c)\n                    }\n                    Shape::Aabb(mut bb) => {\n                        bb.min.x += off;\n                        bb.max.x += off;\n                        Shape::Aabb(bb)\n                    }\n                    Shape::Capsule(mut c) => {\n                        c.a.x += off;\n                        c.b.x += off;\n                        Shape::Capsule(c)\n                    }\n                };\n                for ur in [0i32, 1] {\n                    let mut cc = C2GJKCache::default();\n                    let mut cr = C2GJKCache::default();\n                    let ctx = format!(\n                        \"degen ur={ur} off={off} A={} B={}\",\n                        shape_desc(a0),\n                        shape_desc(&b)\n                    );\n                    let oc =\n                        call_gjk(&p.c, a0, None, &b, None, ur, true, true, true, Some(&mut cc));\n                    let or =\n                        call_gjk(&p.r, a0, None, &b, None, ur, true, true, true, Some(&mut cr));\n                    eq_gjk(&ctx, &oc, &or);\n                    eq_cache(\"cache\", &ctx, &cc, &cr);\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Row 61 — extreme magnitudes (overflow to inf) and subnormal separations\n// ===========================================================================\n\n#[test]\nfn cfg61_gjk_extreme_magnitudes() {\n    let p = load();\n    let scales = [\n        1.0e-30f32,\n        1.0e-6,\n        1.0,\n        1.0e6,\n        1.0e20,\n        1.0e30,\n        f32::MAX,\n        f32::MIN_POSITIVE,\n    ];\n    for s in scales {\n        for &ta in &ALL_TYPES {\n            for &tb in &ALL_TYPES {\n                let a = match ta {\n                    C2_TYPE_CIRCLE => Shape::Circle(C2Circle {\n                        p: C2v { x: 0.0, y: 0.0 },\n                        r: s,\n                    }),\n                    C2_TYPE_AABB => Shape::Aabb(C2AABB {\n                        min: C2v { x: -s, y: -s },\n                        max: C2v { x: s, y: s },\n                    }),\n                    _ => Shape::Capsule(C2Capsule {\n                        a: C2v { x: -s, y: 0.0 },\n                        b: C2v { x: s, y: 0.0 },\n                        r: s,\n                    }),\n                };\n                let b = match tb {\n                    C2_TYPE_CIRCLE => Shape::Circle(C2Circle {\n                        p: C2v { x: s, y: s },\n                        r: s,\n                    }),\n                    C2_TYPE_AABB => Shape::Aabb(C2AABB {\n                        min: C2v { x: s, y: s },\n                        max: C2v { x: 2.0 * s, y: 2.0 * s },\n                    }),\n                    _ => Shape::Capsule(C2Capsule {\n                        a: C2v { x: s, y: s },\n                        b: C2v { x: 2.0 * s, y: s },\n                        r: s,\n                    }),\n                };\n                for ur in [0i32, 1] {\n                    let mut cc = C2GJKCache::default();\n                    let mut cr = C2GJKCache::default();\n                    let ctx = format!(\n                        \"scale={s:e} {}x{} ur={ur} A={} B={}\",\n                        ty_name(ta),\n                        ty_name(tb),\n                        shape_desc(&a),\n                        shape_desc(&b)\n                    );\n                    let oc =\n                        call_gjk(&p.c, &a, None, &b, None, ur, true, true, true, Some(&mut cc));\n                    let or =\n                        call_gjk(&p.r, &a, None, &b, None, ur, true, true, true, Some(&mut cr));\n                    eq_gjk(&ctx, &oc, &or);\n                    eq_cache(\"cache\", &ctx, &cc, &cr);\n                }\n            }\n        }\n    }\n}\n\n/// Row 61b — fully random shapes from the *mixed* float pool (NaN / inf coordinates).\n/// This is also where the iteration-cap and no-progress break paths get stressed.\n#[test]\nfn cfg61b_gjk_mixed_float_pool() {\n    let p = load();\n    let mut rng = Rng::new(SEED ^ 61);\n    let mut iter_hist = [0usize; 21];\n    for &ta in &ALL_TYPES {\n        for &tb in &ALL_TYPES {\n            for i in 0..2000 {\n                let a = rand_shape(&mut rng, ta);\n                let b = rand_shape(&mut rng, tb);\n                for ur in [0i32, 1] {\n                    let mut cc = C2GJKCache::default();\n                    let mut cr = C2GJKCache::default();\n                    let ctx = format!(\n                        \"#{i} {}x{} ur={ur} A={} B={}\",\n                        ty_name(ta),\n                        ty_name(tb),\n                        shape_desc(&a),\n                        shape_desc(&b)\n                    );\n                    let oc =\n                        call_gjk(&p.c, &a, None, &b, None, ur, true, true, true, Some(&mut cc));\n                    let or =\n                        call_gjk(&p.r, &a, None, &b, None, ur, true, true, true, Some(&mut cr));\n                    eq_gjk(&ctx, &oc, &or);\n                    eq_cache(\"cache\", &ctx, &cc, &cr);\n                    if (0..=20).contains(&oc.iterations) {\n                        iter_hist[oc.iterations as usize] += 1;\n                    }\n                }\n            }\n        }\n    }\n    println!(\"c2GJK iteration histogram (mixed pool): {iter_hist:?}\");\n    assert!(iter_hist[0] > 0 && iter_hist[1] > 0, \"iteration counts: {iter_hist:?}\");\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
