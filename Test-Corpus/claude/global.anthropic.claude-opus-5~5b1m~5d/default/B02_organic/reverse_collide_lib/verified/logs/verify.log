n54\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n55\t#[repr(C)]\n56\t#[derive(Clone, Copy, Default)]\n57\tpub struct c2Circle {\n58\t    pub p: c2v,\n59\t    pub r: f32,\n60\t}\n61\t\n62\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n63\t#[repr(C)]\n64\t#[derive(Clone, Copy, Default)]\n65\tpub struct c2AABB {\n66\t    pub min: c2v,\n67\t    pub max: c2v,\n68\t}\n69\t\n70\t/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n71\t#[repr(C)]\n72\t#[derive(Clone, Copy, Default)]\n73\tpub struct c2Capsule {\n74\t    pub a: c2v,\n75\t    pub b: c2v,\n76\t    pub r: f32,\n77\t}\n78\t\n79\t/// `typedef struct c2GJKCache { float metric; int count; int iA[3]; int iB[3]; float div; } c2GJKCache;`\n80\t#[repr(C)]\n81\t#[derive(Clone, Copy, Default)]\n82\tpub struct c2GJKCache {\n83\t    pub metric: f32,\n84\t    pub count: c_int,\n85\t    pub iA: [c_int; 3],\n86\t    pub iB: [c_int; 3],\n87\t    pub div: f32,\n88\t}\n89\t\n90\t/// `typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;`\n91\t#[repr(C)]\n92\t#[derive(Clone, Copy)]\n93\tpub struct c2Proxy {\n94\t    pub radius: f32,\n95\t    pub count: c_int,\n96\t    pub verts: [c2v; 8],\n97\t}\n98\t\n99\timpl Default for c2Proxy {\n100\t    fn default() -> Self {\n101\t        c2Proxy {\n102\t            radius: 0.0,\n103\t            count: 0,\n104\t            verts: [c2v::default(); 8],\n105\t        }\n106\t    }\n107\t}\n108\t\n109\t/// `typedef struct { c2v sA; c2v sB; c2v p; float u; int iA; int iB; } c2sv;`\n110\t#[repr(C)]\n111\t#[derive(Clone, Copy, Default)]\n112\tpub struct c2sv {\n113\t    pub sA: c2v,\n114\t    pub sB: c2v,\n115\t    pub p: c2v,\n116\t    pub u: f32,\n117\t    pub iA: c_int,\n118\t    pub iB: c_int,\n119\t}\n120\t\n121\t/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n122\t///\n123\t/// The four `c2sv` members are stored as an array; this is layout-identical to the\n124\t/// four consecutive named members in C (`c2sv` has size 36 and alignment 4), and the\n125\t/// original code relies on that by taking `&s.a` and indexing it as an array.\n126\t#[repr(C)]\n127\t#[derive(Clone, Copy, Default)]\n128\tpub struct c2Simplex {\n129\t    pub verts: [c2sv; 4],\n130\t    pub div: f32,\n131\t    pub count: c_int,\n132\t}\n133\t\n134\t// FLT_MAX / FLT_EPSILON as spelled out in the C source.\n135\tconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38_f32;\n136\tconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7_f32;\n137\t\n138\t// ---------------------------------------------------------------------------\n139\t// Basic vector / rotation math\n140\t// ---------------------------------------------------------------------------\n141\t\n142\t#[unsafe(no_mangle)]\n143\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n144\t    let mut a = c2v { x: 0.0, y: 0.0 };\n145\t    a.x = x;\n146\t    a.y = y;\n147\t    a\n148\t}\n149\t\n150\t#[unsafe(no_mangle)]\n151\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n152\t    a.x *= b;\n153\t    a.y *= b;\n154\t    a\n155\t}\n156\t\n157\t#[unsafe(no_mangle)]\n158\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n159\t    c2V(\n160\t        if a.x > b.x { a.x } else { b.x },\n161\t        if a.y > b.y { a.y } else { b.y },\n162\t    )\n163\t}\n164\t\n165\t#[unsafe(no_mangle)]\n166\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n167\t    c2V(\n168\t        if a.x < b.x { a.x } else { b.x },\n169\t        if a.y < b.y { a.y } else { b.y },\n170\t    )\n171\t}\n172\t\n173\t#[unsafe(no_mangle)]\n174\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n175\t    c2Maxv(lo, c2Minv(a, hi))\n176\t}\n177\t\n178\t#[unsafe(no_mangle)]\n179\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n180\t    a.x -= b.x;\n181\t    a.y -= b.y;\n182\t    a\n183\t}\n184\t\n185\t#[unsafe(no_mangle)]\n186\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n187\t    a.x * b.x + a.y * b.y\n188\t}\n189\t\n190\t#[unsafe(no_mangle)]\n191\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n192\t    let mut r = c2r { c: 0.0, s: 0.0 };\n193\t    r.c = 1.0f32;\n194\t    r.s = 0.0;\n195\t    r\n196\t}\n197\t\n198\t#[unsafe(no_mangle)]\n199\tpub extern \"C\" fn c2xIdentity() -> c2x {\n200\t    let mut x = c2x {\n201\t        p: c2v { x: 0.0, y: 0.0 },\n202\t        r: c2r { c: 0.0, s: 0.0 },\n203\t    };\n204\t    x.p = c2V(0.0, 0.0);\n205\t    x.r = c2RotIdentity();\n206\t    x\n207\t}\n208\t\n209\t#[unsafe(no_mangle)]\n210\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n211\t    *out.offset(0) = (*bb).min;\n212\t    *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n213\t    *out.offset(2) = (*bb).max;\n214\t    *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n215\t}\n216\t\n217\t#[unsafe(no_mangle)]\n218\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: C2_TYPE, p: *mut c2Proxy) {\n219\t    match type_ {\n220\t        C2_TYPE_CIRCLE => {\n221\t            let c = shape as *mut c2Circle;\n222\t            (*p).radius = (*c).r;\n223\t            (*p).count = 1;\n224\t            (*p).verts[0] = (*c).p;\n225\t        }\n226\t        C2_TYPE_AABB => {\n227\t            let bb = shape as *mut c2AABB;\n228\t            (*p).radius = 0.0;\n229\t            (*p).count = 4;\n230\t            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n231\t        }\n232\t        C2_TYPE_CAPSULE => {\n233\t            let c = shape as *mut c2Capsule;\n234\t            (*p).radius = (*c).r;\n235\t            (*p).count = 2;\n236\t            (*p).verts[0] = (*c).a;\n237\t            (*p).verts[1] = (*c).b;\n238\t        }\n239\t        _ => {}\n240\t    }\n241\t}\n242\t\n243\t#[unsafe(no_mangle)]\n244\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n245\t    sqrtf(c2Dot(a, a))\n246\t}\n247\t\n248\t#[unsafe(no_mangle)]\n249\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n250\t    a.x * b.y - a.y * b.x\n251\t}\n252\t\n253\t#[unsafe(no_mangle)]\n254\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n255\t    let verts = (*s).verts.as_mut_ptr();\n256\t    match (*s).count {\n257\t        2 => c2Len(c2Sub((*verts.offset(1)).p, (*verts.offset(0)).p)),\n258\t        3 => c2Det2(\n259\t            c2Sub((*verts.offset(1)).p, (*verts.offset(0)).p),\n260\t            c2Sub((*verts.offset(2)).p, (*verts.offset(0)).p),\n261\t        ),\n262\t        // `default:` falls through into `case 1:` which returns 0.\n263\t        _ => 0.0,\n264\t    }\n265\t}\n266\t\n267\t#[unsafe(no_mangle)]\n268\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n269\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n270\t}\n271\t\n272\t#[unsafe(no_mangle)]\n273\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n274\t    a.x += b.x;\n275\t    a.y += b.y;\n276\t    a\n277\t}\n278\t\n279\t#[unsafe(no_mangle)]\n280\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n281\t    c2Add(c2Mulrv(a.r, b), a.p)\n282\t}\n283\t\n284\t// ---------------------------------------------------------------------------\n285\t// Simplex solvers\n286\t// ---------------------------------------------------------------------------\n287\t\n288\t#[unsafe(no_mangle)]\n289\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n290\t    let verts = (*s).verts.as_mut_ptr();\n291\t    let a = (*verts.offset(0)).p;\n292\t    let b = (*verts.offset(1)).p;\n293\t    let u = c2Dot(b, c2Sub(b, a));\n294\t    let v = c2Dot(a, c2Sub(a, b));\n295\t    if v <= 0.0 {\n296\t        (*verts.offset(0)).u = 1.0f32;\n297\t        (*s).div = 1.0f32;\n298\t        (*s).count = 1;\n299\t    } else if u <= 0.0 {\n300\t        *verts.offset(0) = *verts.offset(1);\n301\t        (*verts.offset(0)).u = 1.0f32;\n302\t        (*s).div = 1.0f32;\n303\t        (*s).count = 1;\n304\t    } else {\n305\t        (*verts.offset(0)).u = u;\n306\t        (*verts.offset(1)).u = v;\n307\t        (*s).div = u + v;\n308\t        (*s).count = 2;\n309\t    }\n310\t}\n311\t\n312\t#[unsafe(no_mangle)]\n313\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n314\t    let verts = (*s).verts.as_mut_ptr();\n315\t    let a = (*verts.offset(0)).p;\n316\t    let b = (*verts.offset(1)).p;\n317\t    let c = (*verts.offset(2)).p;\n318\t    let uAB = c2Dot(b, c2Sub(b, a));\n319\t    let vAB = c2Dot(a, c2Sub(a, b));\n320\t    let uBC = c2Dot(c, c2Sub(c, b));\n321\t    let vBC = c2Dot(b, c2Sub(b, c));\n322\t    let uCA = c2Dot(a, c2Sub(a, c));\n323\t    let vCA = c2Dot(c, c2Sub(c, a));\n324\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n325\t    let uABC = c2Det2(b, c) * area;\n326\t    let vABC = c2Det2(c, a) * area;\n327\t    let wABC = c2Det2(a, b) * area;\n328\t    if vAB <= 0.0 && uCA <= 0.0 {\n329\t        (*verts.offset(0)).u = 1.0f32;\n330\t        (*s).div = 1.0f32;\n331\t        (*s).count = 1;\n332\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n333\t        *verts.offset(0) = *verts.offset(1);\n334\t        (*verts.offset(0)).u = 1.0f32;\n335\t        (*s).div = 1.0f32;\n336\t        (*s).count = 1;\n337\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n338\t        *verts.offset(0) = *verts.offset(2);\n339\t        (*verts.offset(0)).u = 1.0f32;\n340\t        (*s).div = 1.0f32;\n341\t        (*s).count = 1;\n342\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n343\t        (*verts.offset(0)).u = uAB;\n344\t        (*verts.offset(1)).u = vAB;\n345\t        (*s).div = uAB + vAB;\n346\t        (*s).count = 2;\n347\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n348\t        *verts.offset(0) = *verts.offset(1);\n349\t        *verts.offset(1) = *verts.offset(2);\n350\t        (*verts.offset(0)).u = uBC;\n351\t        (*verts.offset(1)).u = vBC;\n352\t        (*s).div = uBC + vBC;\n353\t        (*s).count = 2;\n354\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n355\t        *verts.offset(1) = *verts.offset(0);\n356\t        *verts.offset(0) = *verts.offset(2);\n357\t        (*verts.offset(0)).u = uCA;\n358\t        (*verts.offset(1)).u = vCA;\n359\t        (*s).div = uCA + vCA;\n360\t        (*s).count = 2;\n361\t    } else {\n362\t        (*verts.offset(0)).u = uABC;\n363\t        (*verts.offset(1)).u = vABC;\n364\t        (*verts.offset(2)).u = wABC;\n365\t        (*s).div = uABC + vABC + wABC;\n366\t        (*s).count = 3;\n367\t    }\n368\t}\n369\t\n370\t#[unsafe(no_mangle)]\n371\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n372\t    c2V(-a.x, -a.y)\n373\t}\n374\t\n375\t#[unsafe(no_mangle)]\n376\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n377\t    let mut b = c2v { x: 0.0, y: 0.0 };\n378\t    b.x = -a.y;\n379\t    b.y = a.x;\n380\t    b\n381\t}\n382\t\n383\t#[unsafe(no_mangle)]\n384\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n385\t    let mut b = c2v { x: 0.0, y: 0.0 };\n386\t    b.x = a.y;\n387\t    b.y = -a.x;\n388\t    b\n389\t}\n390\t\n391\t#[unsafe(no_mangle)]\n392\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n393\t    let verts = (*s).verts.as_mut_ptr();\n394\t    match (*s).count {\n395\t        1 => c2Neg((*verts.offset(0)).p),\n396\t        2 => {\n397\t            let ab = c2Sub((*verts.offset(1)).p, (*verts.offset(0)).p);\n398\t            if c2Det2(ab, c2Neg((*verts.offset(0)).p)) > 0.0 {\n399\t                return c2Skew(ab);\n400\t            }\n401\t            c2CCW90(ab)\n402\t        }\n403\t        // case 3 and default\n404\t        _ => c2V(0.0, 0.0),\n405\t    }\n406\t}\n407\t\n408\t#[unsafe(no_mangle)]\n409\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n410\t    let mut imax: c_int = 0;\n411\t    let mut dmax = c2Dot(*verts.offset(0), d);\n412\t    let mut i: c_int = 1;\n413\t    while i < count {\n414\t        let dot = c2Dot(*verts.offset(i as isize), d);\n415\t        if dot > dmax {\n416\t            imax = i;\n417\t            dmax = dot;\n418\t        }\n419\t        i += 1;\n420\t    }\n421\t    imax\n422\t}\n423\t\n424\t#[unsafe(no_mangle)]\n425\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n426\t    let verts = (*s).verts.as_mut_ptr();\n427\t    let den = 1.0f32 / (*s).div;\n428\t    match (*s).count {\n429\t        1 => {\n430\t            *a = (*verts.offset(0)).sA;\n431\t            *b = (*verts.offset(0)).sB;\n432\t        }\n433\t        2 => {\n434\t            *a = c2Add(\n435\t                c2Mulvs((*verts.offset(0)).sA, den * (*verts.offset(0)).u),\n436\t                c2Mulvs((*verts.offset(1)).sA, den * (*verts.offset(1)).u),\n437\t            );\n438\t            *b = c2Add(\n439\t                c2Mulvs((*verts.offset(0)).sB, den * (*verts.offset(0)).u),\n440\t                c2Mulvs((*verts.offset(1)).sB, den * (*verts.offset(1)).u),\n441\t            );\n442\t        }\n443\t        3 => {\n444\t            *a = c2Add(\n445\t                c2Add(\n446\t                    c2Mulvs((*verts.offset(0)).sA, den * (*verts.offset(0)).u),\n447\t                    c2Mulvs((*verts.offset(1)).sA, den * (*verts.offset(1)).u),\n448\t                ),\n449\t                c2Mulvs((*verts.offset(2)).sA, den * (*verts.offset(2)).u),\n450\t            );\n451\t            *b = c2Add(\n452\t                c2Add(\n453\t                    c2Mulvs((*verts.offset(0)).sB, den * (*verts.offset(0)).u),\n454\t                    c2Mulvs((*verts.offset(1)).sB, den * (*verts.offset(1)).u),\n455\t                ),\n456\t                c2Mulvs((*verts.offset(2)).sB, den * (*verts.offset(2)).u),\n457\t            );\n458\t        }\n459\t        _ => {\n460\t            *a = c2V(0.0, 0.0);\n461\t            *b = c2V(0.0, 0.0);\n462\t        }\n463\t    }\n464\t}\n465\t\n466\t#[unsafe(no_mangle)]\n467\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n468\t    c2Mulvs(a, 1.0f32 / b)\n469\t}\n470\t\n471\t#[unsafe(no_mangle)]\n472\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n473\t    c2Div(a, c2Len(a))\n474\t}\n475\t\n476\t#[unsafe(no_mangle)]\n477\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n478\t    let verts = (*s).verts.as_mut_ptr();\n479\t    let den = 1.0f32 / (*s).div;\n480\t    match (*s).count {\n481\t        1 => (*verts.offset(0)).p,\n482\t        2 => c2Add(\n483\t            c2Mulvs((*verts.offset(0)).p, den * (*verts.offset(0)).u),\n484\t            c2Mulvs((*verts.offset(1)).p, den * (*verts.offset(1)).u),\n485\t        ),\n486\t        _ => c2V(0.0, 0.0),\n487\t    }\n488\t}\n489\t\n490\t#[unsafe(no_mangle)]\n491\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n492\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n493\t}\n494\t\n495\t// ---------------------------------------------------------------------------\n496\t// GJK\n497\t// ---------------------------------------------------------------------------\n498\t\n499\t#[unsafe(no_mangle)]\n500\tpub unsafe extern \"C\" fn c2GJK(\n501\t    A: *const c_void,\n502\t    typeA: C2_TYPE,\n503\t    ax_ptr: *const c2x,\n504\t    B: *const c_void,\n505\t    typeB: C2_TYPE,\n506\t    bx_ptr: *const c2x,\n507\t    outA: *mut c2v,\n508\t    outB: *mut c2v,\n509\t    use_radius: c_int,\n510\t    iterations: *mut c_int,\n511\t    cache: *mut c2GJKCache,\n512\t) -> f32 {\n513\t    let ax: c2x;\n514\t    let bx: c2x;\n515\t    if ax_ptr.is_null() {\n516\t        ax = c2xIdentity();\n517\t    } else {\n518\t        ax = *ax_ptr;\n519\t    }\n520\t    if bx_ptr.is_null() {\n521\t        bx = c2xIdentity();\n522\t    } else {\n523\t        bx = *bx_ptr;\n524\t    }\n525\t    let mut pA = c2Proxy::default();\n526\t    let mut pB = c2Proxy::default();\n527\t    c2MakeProxy(A, typeA, &mut pA);\n528\t    c2MakeProxy(B, typeB, &mut pB);\n529\t    let mut s = c2Simplex::default();\n530\t    let verts: *mut c2sv = s.verts.as_mut_ptr();\n531\t    let pA_verts: *const c2v = pA.verts.as_ptr();\n532\t    let pB_verts: *const c2v = pB.verts.as_ptr();\n533\t    let mut cache_was_read: c_int = 0;\n534\t    if !cache.is_null() {\n535\t        let cache_was_good = (*cache).count != 0;\n536\t        if cache_was_good {\n537\t            let mut i: c_int = 0;\n538\t            while i < (*cache).count {\n539\t                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n540\t                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n541\t                let sA = c2Mulxv(ax, *pA_verts.offset(iA as isize));\n542\t                let sB = c2Mulxv(bx, *pB_verts.offset(iB as isize));\n543\t                let v = verts.offset(i as isize);\n544\t                (*v).iA = iA;\n545\t                (*v).sA = sA;\n546\t                (*v).iB = iB;\n547\t                (*v).sB = sB;\n548\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n549\t                (*v).u = 0.0;\n550\t                i += 1;\n551\t            }\n552\t            s.count = (*cache).count;\n553\t            s.div = (*cache).div;\n554\t            let metric_old = (*cache).metric;\n555\t            let metric = c2GJKSimplexMetric(&mut s);\n556\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n557\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n558\t            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n559\t                cache_was_read = 1;\n560\t            }\n561\t        }\n562\t    }\n563\t    if cache_was_read == 0 {\n564\t        (*verts.offset(0)).iA = 0;\n565\t        (*verts.offset(0)).iB = 0;\n566\t        (*verts.offset(0)).sA = c2Mulxv(ax, *pA_verts.offset(0));\n567\t        (*verts.offset(0)).sB = c2Mulxv(bx, *pB_verts.offset(0));\n568\t        (*verts.offset(0)).p = c2Sub((*verts.offset(0)).sB, (*verts.offset(0)).sA);\n569\t        (*verts.offset(0)).u = 1.0f32;\n570\t        s.div = 1.0f32;\n571\t        s.count = 1;\n572\t    }\n573\t    let mut saveA: [c_int; 3] = [0; 3];\n574\t    let mut saveB: [c_int; 3] = [0; 3];\n575\t    let saveA_p: *mut c_int = saveA.as_mut_ptr();\n576\t    let saveB_p: *mut c_int = saveB.as_mut_ptr();\n577\t    let mut save_count: c_int;\n578\t    let mut d0: f32 = C2_FLT_MAX;\n579\t    let mut d1: f32;\n580\t    let mut iter: c_int = 0;\n581\t    let mut hit: c_int = 0;\n582\t    while iter < 20 {\n583\t        save_count = s.count;\n584\t        let mut i: c_int = 0;\n585\t        while i < save_count {\n586\t            *saveA_p.offset(i as isize) = (*verts.offset(i as isize)).iA;\n587\t            *saveB_p.offset(i as isize) = (*verts.offset(i as isize)).iB;\n588\t            i += 1;\n589\t        }\n590\t        match s.count {\n591\t            1 => {}\n592\t            2 => c22(&mut s),\n593\t            3 => c23(&mut s),\n594\t            _ => {}\n595\t        }\n596\t        if s.count == 3 {\n597\t            hit = 1;\n598\t            break;\n599\t        }\n600\t        let p = c2L(&mut s);\n601\t        d1 = c2Dot(p, p);\n602\t        if d1 > d0 {\n603\t            break;\n604\t        }\n605\t        d0 = d1;\n606\t        let d = c2D(&mut s);\n607\t        if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n608\t            break;\n609\t        }\n610\t        let iA = c2Support(pA_verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\n611\t        let sA = c2Mulxv(ax, *pA_verts.offset(iA as isize));\n612\t        let iB = c2Support(pB_verts, pB.count, c2MulrvT(bx.r, d));\n613\t        let sB = c2Mulxv(bx, *pB_verts.offset(iB as isize));\n614\t        let v = verts.offset(s.count as isize);\n615\t        (*v).iA = iA;\n616\t        (*v).sA = sA;\n617\t        (*v).iB = iB;\n618\t        (*v).sB = sB;\n619\t        (*v).p = c2Sub((*v).sB, (*v).sA);\n620\t        let mut dup: c_int = 0;\n621\t        let mut j: c_int = 0;\n622\t        while j < save_count {\n623\t            if iA == *saveA_p.offset(j as isize) && iB == *saveB_p.offset(j as isize) {\n624\t                dup = 1;\n625\t                break;\n626\t            }\n627\t            j += 1;\n628\t        }\n629\t        if dup != 0 {\n630\t            break;\n631\t        }\n632\t        s.count += 1;\n633\t        iter += 1;\n634\t    }\n635\t    let mut a = c2v { x: 0.0, y: 0.0 };\n636\t    let mut b = c2v { x: 0.0, y: 0.0 };\n637\t    c2Witness(&mut s, &mut a, &mut b);\n638\t    let mut dist = c2Len(c2Sub(a, b));\n639\t    if hit != 0 {\n640\t        a = b;\n641\t        dist = 0.0;\n642\t    } else if use_radius != 0 {\n643\t        let rA = pA.radius;\n644\t        let rB = pB.radius;\n645\t        if dist > rA + rB && dist > C2_FLT_EPSILON {\n646\t            dist -= rA + rB;\n647\t            let n = c2Norm(c2Sub(b, a));\n648\t            a = c2Add(a, c2Mulvs(n, rA));\n649\t            b = c2Sub(b, c2Mulvs(n, rB));\n650\t            if a.x == b.x && a.y == b.y {\n651\t                dist = 0.0;\n652\t            }\n653\t        } else {\n654\t            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n655\t            a = p;\n656\t            b = p;\n657\t            dist = 0.0;\n658\t        }\n659\t    }\n660\t    if !cache.is_null() {\n661\t        (*cache).metric = c2GJKSimplexMetric(&mut s);\n662\t        (*cache).count = s.count;\n663\t        let mut i: c_int = 0;\n664\t        while i < s.count {\n665\t            let v = verts.offset(i as isize);\n666\t            *(*cache).iA.as_mut_ptr().offset(i as isize) = (*v).iA;\n667\t            *(*cache).iB.as_mut_ptr().offset(i as isize) = (*v).iB;\n668\t            i += 1;\n669\t        }\n670\t        (*cache).div = s.div;\n671\t    }\n672\t    if !outA.is_null() {\n673\t        *outA = a;\n674\t    }\n675\t    if !outB.is_null() {\n676\t        *outB = b;\n677\t    }\n678\t    if !iterations.is_null() {\n679\t        *iterations = iter;\n680\t    }\n681\t    dist\n682\t}\n683\t\n684\t// ---------------------------------------------------------------------------\n685\t// Boolean collision routines\n686\t// ---------------------------------------------------------------------------\n687\t\n688\t#[unsafe(no_mangle)]\n689\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n690\t    let d0: c_int = (B.max.x < A.min.x) as c_int;\n691\t    let d1: c_int = (A.max.x < B.min.x) as c_int;\n692\t    let d2: c_int = (B.max.y < A.min.y) as c_int;\n693\t    let d3: c_int = (A.max.y < B.min.y) as c_int;\n694\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n695\t}\n696\t\n697\t#[unsafe(no_mangle)]\n698\tpub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n699\t    unsafe {\n700\t        if c2GJK(\n701\t            &A as *const c2AABB as *const c_void,\n702\t            C2_TYPE_AABB,\n703\t            core::ptr::null(),\n704\t            &B as *const c2Capsule as *const c_void,\n705\t            C2_TYPE_CAPSULE,\n706\t            core::ptr::null(),\n707\t            core::ptr::null_mut(),\n708\t            core::ptr::null_mut(),\n709\t            1,\n710\t            core::ptr::null_mut(),\n711\t            core::ptr::null_mut(),\n712\t        ) != 0.0\n713\t        {\n714\t            return 0;\n715\t        }\n716\t    }\n717\t    1\n718\t}\n719\t\n720\t#[unsafe(no_mangle)]\n721\tpub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n722\t    unsafe {\n723\t        if c2GJK(\n724\t            &A as *const c2Capsule as *const c_void,\n725\t            C2_TYPE_CAPSULE,\n726\t            core::ptr::null(),\n727\t            &B as *const c2Capsule as *const c_void,\n728\t            C2_TYPE_CAPSULE,\n729\t            core::ptr::null(),\n730\t            core::ptr::null_mut(),\n731\t            core::ptr::null_mut(),\n732\t            1,\n733\t            core::ptr::null_mut(),\n734\t            core::ptr::null_mut(),\n735\t        ) != 0.0\n736\t        {\n737\t            return 0;\n738\t        }\n739\t    }\n740\t    1\n741\t}\n742\t\n743\t#[unsafe(no_mangle)]\n744\tpub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n745\t    let c = c2Sub(B.p, A.p);\n746\t    let d2 = c2Dot(c, c);\n747\t    let mut r2 = A.r + B.r;\n748\t    r2 = r2 * r2;\n749\t    (d2 < r2) as c_int\n750\t}\n751\t\n752\t#[unsafe(no_mangle)]\n753\tpub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n754\t    let L = c2Clampv(A.p, B.min, B.max);\n755\t    let ab = c2Sub(A.p, L);\n756\t    let d2 = c2Dot(ab, ab);\n757\t    let r2 = A.r * A.r;\n758\t    (d2 < r2) as c_int\n759\t}\n760\t\n761\t#[unsafe(no_mangle)]\n762\tpub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n763\t    let n = c2Sub(B.b, B.a);\n764\t    let ap = c2Sub(A.p, B.a);\n765\t    let da = c2Dot(ap, n);\n766\t    let d2: f32;\n767\t    if da < 0.0 {\n768\t        d2 = c2Dot(ap, ap);\n769\t    } else {\n770\t        let db = c2Dot(c2Sub(A.p, B.b), n);\n771\t        if db < 0.0 {\n772\t            let e = c2Sub(ap, c2Mulvs(n, da / c2Dot(n, n)));\n773\t            d2 = c2Dot(e, e);\n774\t        } else {\n775\t            let bp = c2Sub(A.p, B.b);\n776\t            d2 = c2Dot(bp, bp);\n777\t        }\n778\t    }\n779\t    let r = A.r + B.r;\n780\t    (d2 < r * r) as c_int\n781\t}\n782\t\n783\t#[unsafe(no_mangle)]\n784\tpub unsafe extern \"C\" fn c2Collided(\n785\t    A: *const c_void,\n786\t    typeA: C2_TYPE,\n787\t    B: *const c_void,\n788\t    typeB: C2_TYPE,\n789\t) -> c_int {\n790\t    match typeA {\n791\t        C2_TYPE_CIRCLE => match typeB {\n792\t            C2_TYPE_CIRCLE => c2CircletoCircle(*(A as *const c2Circle), *(B as *const c2Circle)),\n793\t            C2_TYPE_AABB => c2CircletoAABB(*(A as *const c2Circle), *(B as *const c2AABB)),\n794\t            C2_TYPE_CAPSULE => c2CircletoCapsule(*(A as *const c2Circle), *(B as *const c2Capsule)),\n795\t            _ => 0,\n796\t        },\n797\t        C2_TYPE_AABB => match typeB {\n798\t            C2_TYPE_CIRCLE => c2CircletoAABB(*(B as *const c2Circle), *(A as *const c2AABB)),\n799\t            C2_TYPE_AABB => c2AABBtoAABB(*(A as *const c2AABB), *(B as *const c2AABB)),\n800\t            C2_TYPE_CAPSULE => c2AABBtoCapsule(*(A as *const c2AABB), *(B as *const c2Capsule)),\n801\t            _ => 0,\n802\t        },\n803\t        C2_TYPE_CAPSULE => match typeB {\n804\t            C2_TYPE_CIRCLE => c2CircletoCapsule(*(B as *const c2Circle), *(A as *const c2Capsule)),\n805\t            C2_TYPE_AABB => c2AABBtoCapsule(*(B as *const c2AABB), *(A as *const c2Capsule)),\n806\t            C2_TYPE_CAPSULE => {\n807\t                c2CapsuletoCapsule(*(A as *const c2Capsule), *(B as *const c2Capsule))\n808\t            }\n809\t            _ => 0,\n810\t        },\n811\t        _ => 0,\n812\t    }\n813\t}\n814\t\n815\t// ---------------------------------------------------------------------------\n816\t// Public entry point (include/lib.h)\n817\t// ---------------------------------------------------------------------------\n818\t\n819\t#[unsafe(no_mangle)]\n820\tpub extern \"C\" fn reverse_collide(x: f32, y: f32, r: f32) -> c_int {\n821\t    let mut result: c_int = 0;\n822\t\n823\t    let mut circle_in = c2Circle::default();\n824\t    circle_in.p = c2V(x, y);\n825\t    circle_in.r = r;\n826\t\n827\t    let mut circle = c2Circle::default();\n828\t    circle.p = c2V(-70.0f32, 0.0);\n829\t    circle.r = 20.0f32;\n830\t\n831\t    let mut aabb = c2AABB::default();\n832\t    aabb.min = c2V(-40.0f32, -40.0f32);\n833\t    aabb.max = c2V(-15.0f32, -15.0f32);\n834\t\n835\t    let mut capsule = c2Capsule::default();\n836\t    capsule.a = c2V(-40.0f32, 40.0f32);\n837\t    capsule.b = c2V(-20.0f32, 100.0f32);\n838\t    capsule.r = 10.0f32;\n839\t\n840\t    unsafe {\n841\t        result = result.wrapping_add(c2Collided(\n842\t            &circle as *const c2Circle as *const c_void,\n843\t            C2_TYPE_CIRCLE,\n844\t            &circle_in as *const c2Circle as *const c_void,\n845\t            C2_TYPE_CIRCLE,\n846\t        ));\n847\t\n848\t        result = result.wrapping_add(\n849\t            c2Collided(\n850\t                &aabb as *const c2AABB as *const c_void,\n851\t                C2_TYPE_AABB,\n852\t                &circle_in as *const c2Circle as *const c_void,\n853\t                C2_TYPE_CIRCLE,\n854\t            ) << 1,\n855\t        );\n856\t\n857\t        result = result.wrapping_add(\n858\t            c2Collided(\n859\t                &capsule as *const c2Capsule as *const c_void,\n860\t                C2_TYPE_CAPSULE,\n861\t                &circle_in as *const c2Circle as *const c_void,\n862\t                C2_TYPE_CIRCLE,\n863\t            ) << 2,\n864\t        );\n865\t    }\n866\t\n867\t    result\n868\t}\n869\t\n870\t// ---------------------------------------------------------------------------\n871\t// libm shim: sqrtf must behave exactly like the C library's sqrtf (IEEE-754\n872\t// correctly rounded single precision square root, which is what the hardware\n873\t// instruction used by `f32::sqrt` provides).\n874\t// ---------------------------------------------------------------------------\n875\t\n876\t#[inline]\n877\tfn sqrtf(x: f32) -> f32 {\n878\t    x.sqrt()\n879\t}\n880\t"}]},"parent_tool_use_id":null,"session_id":"269dae8c-83b7-4194-b947-025790418744","uuid":"eb9fa53b-356b-43e5-9e27-2310dfef81ac","timestamp":"2026-09-05T10:48:46.173Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-wd9wzk/translation/src/lib.rs","content":"//! Rust translation of c_src/src/lib.c (tinyc2 / cute_c2 derived collision routines).\n//!\n//! The C library compiles every function in `src/lib.c` with external linkage, so the\n//! shared object exports all of them.  This crate reproduces the complete public ABI\n//! (38 symbols) with identical signatures, identical struct layouts and identical\n//! floating point behaviour.\n//!\n//! Original license: see c_src/license.txt (zlib / Unlicense, Copyright (c) 2023 Randy Gaul).\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n#![allow(clippy::missing_safety_doc)]\n\nuse core::ffi::{c_int, c_uint, c_void};\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n// typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;\n// GCC gives an all-non-negative enum the underlying type `unsigned int`; on the\n// x86-64 SysV ABI this is passed exactly like `int`.\npub type C2_TYPE = c_uint;\n\npub const C2_TYPE_CIRCLE: C2_TYPE = 0;\npub const C2_TYPE_AABB: C2_TYPE = 1;\npub const C2_TYPE_CAPSULE: C2_TYPE = 2;\n\n/// `typedef struct c2v { float x; float y; } c2v;`\n#[repr(C)]\n#[derive(Clone, Copy, Default)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n/// `typedef struct c2r { float c; float s; } c2r;`\n#[repr(C)]\n#[derive(Clone, Copy, Default)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n/// `typedef struct c2x { c2v p; c2r r; } c2x;`\n#[repr(C)]\n#[derive(Clone, Copy, Default)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n#[repr(C)]\n#[derive(Clone, Copy, Default)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n#[repr(C)]\n#[derive(Clone, Copy, Default)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n#[repr(C)]\n#[derive(Clone, Copy, Default)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2GJKCache { float metric; int count; int iA[3]; int iB[3]; float div; } c2GJKCache;`\n#[repr(C)]\n#[derive(Clone, Copy, Default)]\npub struct c2GJKCache {\n    pub metric: f32,\n    pub count: c_int,\n    pub iA: [c_int; 3],\n    pub iB: [c_int; 3],\n    pub div: f32,\n}\n\n/// `typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;`\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2Proxy {\n    pub radius: f32,\n    pub count: c_int,\n    pub verts: [c2v; 8],\n}\n\nimpl Default for c2Proxy {\n    fn default() -> Self {\n        c2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [c2v::default(); 8],\n        }\n    }\n}\n\n/// `typedef struct { c2v sA; c2v sB; c2v p; float u; int iA; int iB; } c2sv;`\n#[repr(C)]\n#[derive(Clone, Copy, Default)]\npub struct c2sv {\n    pub sA: c2v,\n    pub sB: c2v,\n    pub p: c2v,\n    pub u: f32,\n    pub iA: c_int,\n    pub iB: c_int,\n}\n\n/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n///\n/// The four `c2sv` members are stored as an array; this is layout-identical to the\n/// four consecutive named members in C (`c2sv` has size 36 and alignment 4), and the\n/// original code relies on that by taking `&s.a` and indexing it as an array.\n#[repr(C)]\n#[derive(Clone, Copy, Default)]\npub struct c2Simplex {\n    pub verts: [c2sv; 4],\n    pub div: f32,\n    pub count: c_int,\n}\n\n// FLT_MAX / FLT_EPSILON as spelled out in the C source.\nconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38_f32;\nconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7_f32;\n\n// ---------------------------------------------------------------------------\n// Basic vector / rotation math\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a = c2v { x: 0.0, y: 0.0 };\n    a.x = x;\n    a.y = y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    let mut r = c2r { c: 0.0, s: 0.0 };\n    r.c = 1.0f32;\n    r.s = 0.0;\n    r\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    let mut x = c2x {\n        p: c2v { x: 0.0, y: 0.0 },\n        r: c2r { c: 0.0, s: 0.0 },\n    };\n    x.p = c2V(0.0, 0.0);\n    x.r = c2RotIdentity();\n    x\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    *out.offset(0) = (*bb).min;\n    *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n    *out.offset(2) = (*bb).max;\n    *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: C2_TYPE, p: *mut c2Proxy) {\n    match type_ {\n        C2_TYPE_CIRCLE => {\n            let c = shape as *mut c2Circle;\n            (*p).radius = (*c).r;\n            (*p).count = 1;\n            (*p).verts[0] = (*c).p;\n        }\n        C2_TYPE_AABB => {\n            let bb = shape as *mut c2AABB;\n            (*p).radius = 0.0;\n            (*p).count = 4;\n            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n        }\n        C2_TYPE_CAPSULE => {\n            let c = shape as *mut c2Capsule;\n            (*p).radius = (*c).r;\n            (*p).count = 2;\n            (*p).verts[0] = (*c).a;\n            (*p).verts[1] = (*c).b;\n        }\n        _ => {}\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    sqrtf(c2Dot(a, a))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    a.x * b.y - a.y * b.x\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    let verts = (*s).verts.as_mut_ptr();\n    match (*s).count {\n        2 => c2Len(c2Sub((*verts.offset(1)).p, (*verts.offset(0)).p)),\n        3 => c2Det2(\n            c2Sub((*verts.offset(1)).p, (*verts.offset(0)).p),\n            c2Sub((*verts.offset(2)).p, (*verts.offset(0)).p),\n        ),\n        // `default:` falls through into `case 1:` which returns 0.\n        _ => 0.0,\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n// ---------------------------------------------------------------------------\n// Simplex solvers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    let verts = (*s).verts.as_mut_ptr();\n    let a = (*verts.offset(0)).p;\n    let b = (*verts.offset(1)).p;\n    let u = c2Dot(b, c2Sub(b, a));\n    let v = c2Dot(a, c2Sub(a, b));\n    if v <= 0.0 {\n        (*verts.offset(0)).u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if u <= 0.0 {\n        *verts.offset(0) = *verts.offset(1);\n        (*verts.offset(0)).u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else {\n        (*verts.offset(0)).u = u;\n        (*verts.offset(1)).u = v;\n        (*s).div = u + v;\n        (*s).count = 2;\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n    let verts = (*s).verts.as_mut_ptr();\n    let a = (*verts.offset(0)).p;\n    let b = (*verts.offset(1)).p;\n    let c = (*verts.offset(2)).p;\n    let uAB = c2Dot(b, c2Sub(b, a));\n    let vAB = c2Dot(a, c2Sub(a, b));\n    let uBC = c2Dot(c, c2Sub(c, b));\n    let vBC = c2Dot(b, c2Sub(b, c));\n    let uCA = c2Dot(a, c2Sub(a, c));\n    let vCA = c2Dot(c, c2Sub(c, a));\n    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n    let uABC = c2Det2(b, c) * area;\n    let vABC = c2Det2(c, a) * area;\n    let wABC = c2Det2(a, b) * area;\n    if vAB <= 0.0 && uCA <= 0.0 {\n        (*verts.offset(0)).u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uAB <= 0.0 && vBC <= 0.0 {\n        *verts.offset(0) = *verts.offset(1);\n        (*verts.offset(0)).u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uBC <= 0.0 && vCA <= 0.0 {\n        *verts.offset(0) = *verts.offset(2);\n        (*verts.offset(0)).u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n        (*verts.offset(0)).u = uAB;\n        (*verts.offset(1)).u = vAB;\n        (*s).div = uAB + vAB;\n        (*s).count = 2;\n    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n        *verts.offset(0) = *verts.offset(1);\n        *verts.offset(1) = *verts.offset(2);\n        (*verts.offset(0)).u = uBC;\n        (*verts.offset(1)).u = vBC;\n        (*s).div = uBC + vBC;\n        (*s).count = 2;\n    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n        *verts.offset(1) = *verts.offset(0);\n        *verts.offset(0) = *verts.offset(2);\n        (*verts.offset(0)).u = uCA;\n        (*verts.offset(1)).u = vCA;\n        (*s).div = uCA + vCA;\n        (*s).count = 2;\n    } else {\n        (*verts.offset(0)).u = uABC;\n        (*verts.offset(1)).u = vABC;\n        (*verts.offset(2)).u = wABC;\n        (*s).div = uABC + vABC + wABC;\n        (*s).count = 3;\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    c2V(-a.x, -a.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = -a.y;\n    b.y = a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = a.y;\n    b.y = -a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    let verts = (*s).verts.as_mut_ptr();\n    match (*s).count {\n        1 => c2Neg((*verts.offset(0)).p),\n        2 => {\n            let ab = c2Sub((*verts.offset(1)).p, (*verts.offset(0)).p);\n            if c2Det2(ab, c2Neg((*verts.offset(0)).p)) > 0.0 {\n                return c2Skew(ab);\n            }\n            c2CCW90(ab)\n        }\n        // case 3 and default\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    let mut imax: c_int = 0;\n    let mut dmax = c2Dot(*verts.offset(0), d);\n    let mut i: c_int = 1;\n    while i < count {\n        let dot = c2Dot(*verts.offset(i as isize), d);\n        if dot > dmax {\n            imax = i;\n            dmax = dot;\n        }\n        i += 1;\n    }\n    imax\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n    let verts = (*s).verts.as_mut_ptr();\n    let den = 1.0f32 / (*s).div;\n    match (*s).count {\n        1 => {\n            *a = (*verts.offset(0)).sA;\n            *b = (*verts.offset(0)).sB;\n        }\n        2 => {\n            *a = c2Add(\n                c2Mulvs((*verts.offset(0)).sA, den * (*verts.offset(0)).u),\n                c2Mulvs((*verts.offset(1)).sA, den * (*verts.offset(1)).u),\n            );\n            *b = c2Add(\n                c2Mulvs((*verts.offset(0)).sB, den * (*verts.offset(0)).u),\n                c2Mulvs((*verts.offset(1)).sB, den * (*verts.offset(1)).u),\n            );\n        }\n        3 => {\n            *a = c2Add(\n                c2Add(\n                    c2Mulvs((*verts.offset(0)).sA, den * (*verts.offset(0)).u),\n                    c2Mulvs((*verts.offset(1)).sA, den * (*verts.offset(1)).u),\n                ),\n                c2Mulvs((*verts.offset(2)).sA, den * (*verts.offset(2)).u),\n            );\n            *b = c2Add(\n                c2Add(\n                    c2Mulvs((*verts.offset(0)).sB, den * (*verts.offset(0)).u),\n                    c2Mulvs((*verts.offset(1)).sB, den * (*verts.offset(1)).u),\n                ),\n                c2Mulvs((*verts.offset(2)).sB, den * (*verts.offset(2)).u),\n            );\n        }\n        _ => {\n            *a = c2V(0.0, 0.0);\n            *b = c2V(0.0, 0.0);\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n    let verts = (*s).verts.as_mut_ptr();\n    let den = 1.0f32 / (*s).div;\n    match (*s).count {\n        1 => (*verts.offset(0)).p,\n        2 => c2Add(\n            c2Mulvs((*verts.offset(0)).p, den * (*verts.offset(0)).u),\n            c2Mulvs((*verts.offset(1)).p, den * (*verts.offset(1)).u),\n        ),\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n}\n\n// ---------------------------------------------------------------------------\n// GJK\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJK(\n    A: *const c_void,\n    typeA: C2_TYPE,\n    ax_ptr: *const c2x,\n    B: *const c_void,\n    typeB: C2_TYPE,\n    bx_ptr: *const c2x,\n    outA: *mut c2v,\n    outB: *mut c2v,\n    use_radius: c_int,\n    iterations: *mut c_int,\n    cache: *mut c2GJKCache,\n) -> f32 {\n    let ax: c2x;\n    let bx: c2x;\n    if ax_ptr.is_null() {\n        ax = c2xIdentity();\n    } else {\n        ax = *ax_ptr;\n    }\n    if bx_ptr.is_null() {\n        bx = c2xIdentity();\n    } else {\n        bx = *bx_ptr;\n    }\n    let mut pA = c2Proxy::default();\n    let mut pB = c2Proxy::default();\n    c2MakeProxy(A, typeA, &mut pA);\n    c2MakeProxy(B, typeB, &mut pB);\n    let mut s = c2Simplex::default();\n    let verts: *mut c2sv = s.verts.as_mut_ptr();\n    let pA_verts: *const c2v = pA.verts.as_ptr();\n    let pB_verts: *const c2v = pB.verts.as_ptr();\n    let mut cache_was_read: c_int = 0;\n    if !cache.is_null() {\n        let cache_was_good = (*cache).count != 0;\n        if cache_was_good {\n            let mut i: c_int = 0;\n            while i < (*cache).count {\n                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n                let sA = c2Mulxv(ax, *pA_verts.offset(iA as isize));\n                let sB = c2Mulxv(bx, *pB_verts.offset(iB as isize));\n                let v = verts.offset(i as isize);\n                (*v).iA = iA;\n                (*v).sA = sA;\n                (*v).iB = iB;\n                (*v).sB = sB;\n                (*v).p = c2Sub((*v).sB, (*v).sA);\n                (*v).u = 0.0;\n                i += 1;\n            }\n            s.count = (*cache).count;\n            s.div = (*cache).div;\n            let metric_old = (*cache).metric;\n            let metric = c2GJKSimplexMetric(&mut s);\n            let min_metric = if metric < metric_old { metric } else { metric_old };\n            let max_metric = if metric > metric_old { metric } else { metric_old };\n            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n                cache_was_read = 1;\n            }\n        }\n    }\n    if cache_was_read == 0 {\n        (*verts.offset(0)).iA = 0;\n        (*verts.offset(0)).iB = 0;\n        (*verts.offset(0)).sA = c2Mulxv(ax, *pA_verts.offset(0));\n        (*verts.offset(0)).sB = c2Mulxv(bx, *pB_verts.offset(0));\n        (*verts.offset(0)).p = c2Sub((*verts.offset(0)).sB, (*verts.offset(0)).sA);\n        (*verts.offset(0)).u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    }\n    let mut saveA: [c_int; 3] = [0; 3];\n    let mut saveB: [c_int; 3] = [0; 3];\n    let saveA_p: *mut c_int = saveA.as_mut_ptr();\n    let saveB_p: *mut c_int = saveB.as_mut_ptr();\n    let mut save_count: c_int;\n    let mut d0: f32 = C2_FLT_MAX;\n    let mut d1: f32;\n    let mut iter: c_int = 0;\n    let mut hit: c_int = 0;\n    while iter < 20 {\n        save_count = s.count;\n        let mut i: c_int = 0;\n        while i < save_count {\n            *saveA_p.offset(i as isize) = (*verts.offset(i as isize)).iA;\n            *saveB_p.offset(i as isize) = (*verts.offset(i as isize)).iB;\n            i += 1;\n        }\n        match s.count {\n            1 => {}\n            2 => c22(&mut s),\n            3 => c23(&mut s),\n            _ => {}\n        }\n        if s.count == 3 {\n            hit = 1;\n            break;\n        }\n        let p = c2L(&mut s);\n        d1 = c2Dot(p, p);\n        if d1 > d0 {\n            break;\n        }\n        d0 = d1;\n        let d = c2D(&mut s);\n        if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n            break;\n        }\n        let iA = c2Support(pA_verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\n        let sA = c2Mulxv(ax, *pA_verts.offset(iA as isize));\n        let iB = c2Support(pB_verts, pB.count, c2MulrvT(bx.r, d));\n        let sB = c2Mulxv(bx, *pB_verts.offset(iB as isize));\n        let v = verts.offset(s.count as isize);\n        (*v).iA = iA;\n        (*v).sA = sA;\n        (*v).iB = iB;\n        (*v).sB = sB;\n        (*v).p = c2Sub((*v).sB, (*v).sA);\n        let mut dup: c_int = 0;\n        let mut j: c_int = 0;\n        while j < save_count {\n            if iA == *saveA_p.offset(j as isize) && iB == *saveB_p.offset(j as isize) {\n                dup = 1;\n                break;\n            }\n            j += 1;\n        }\n        if dup != 0 {\n            break;\n        }\n        s.count += 1;\n        iter += 1;\n    }\n    let mut a = c2v { x: 0.0, y: 0.0 };\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    c2Witness(&mut s, &mut a, &mut b);\n    let mut dist = c2Len(c2Sub(a, b));\n    if hit != 0 {\n        a = b;\n        dist = 0.0;\n    } else if use_radius != 0 {\n        let rA = pA.radius;\n        let rB = pB.radius;\n        if dist > rA + rB && dist > C2_FLT_EPSILON {\n            dist -= rA + rB;\n            let n = c2Norm(c2Sub(b, a));\n            a = c2Add(a, c2Mulvs(n, rA));\n            b = c2Sub(b, c2Mulvs(n, rB));\n            if a.x == b.x && a.y == b.y {\n                dist = 0.0;\n            }\n        } else {\n            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n            a = p;\n            b = p;\n            dist = 0.0;\n        }\n    }\n    if !cache.is_null() {\n        (*cache).metric = c2GJKSimplexMetric(&mut s);\n        (*cache).count = s.count;\n        let mut i: c_int = 0;\n        while i < s.count {\n            let v = verts.offset(i as isize);\n            *(*cache).iA.as_mut_ptr().offset(i as isize) = (*v).iA;\n            *(*cache).iB.as_mut_ptr().offset(i as isize) = (*v).iB;\n            i += 1;\n        }\n        (*cache).div = s.div;\n    }\n    if !outA.is_null() {\n        *outA = a;\n    }\n    if !outB.is_null() {\n        *outB = b;\n    }\n    if !iterations.is_null() {\n        *iterations = iter;\n    }\n    dist\n}\n\n// ---------------------------------------------------------------------------\n// Boolean collision routines\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n    let d0: c_int = (B.max.x < A.min.x) as c_int;\n    let d1: c_int = (A.max.x < B.min.x) as c_int;\n    let d2: c_int = (B.max.y < A.min.y) as c_int;\n    let d3: c_int = (A.max.y < B.min.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n    unsafe {\n        if c2GJK(\n            &A as *const c2AABB as *const c_void,\n            C2_TYPE_AABB,\n            core::ptr::null(),\n            &B as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n            1,\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n        ) != 0.0\n        {\n            return 0;\n        }\n    }\n    1\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n    unsafe {\n        if c2GJK(\n            &A as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            &B as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n            1,\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n        ) != 0.0\n        {\n            return 0;\n        }\n    }\n    1\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n    let c = c2Sub(B.p, A.p);\n    let d2 = c2Dot(c, c);\n    let mut r2 = A.r + B.r;\n    r2 = r2 * r2;\n    (d2 < r2) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n    let L = c2Clampv(A.p, B.min, B.max);\n    let ab = c2Sub(A.p, L);\n    let d2 = c2Dot(ab, ab);\n    let r2 = A.r * A.r;\n    (d2 < r2) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n    let n = c2Sub(B.b, B.a);\n    let ap = c2Sub(A.p, B.a);\n    let da = c2Dot(ap, n);\n    let d2: f32;\n    if da < 0.0 {\n        d2 = c2Dot(ap, ap);\n    } else {\n        let db = c2Dot(c2Sub(A.p, B.b), n);\n        if db < 0.0 {\n            let e = c2Sub(ap, c2Mulvs(n, da / c2Dot(n, n)));\n            d2 = c2Dot(e, e);\n        } else {\n            let bp = c2Sub(A.p, B.b);\n            d2 = c2Dot(bp,