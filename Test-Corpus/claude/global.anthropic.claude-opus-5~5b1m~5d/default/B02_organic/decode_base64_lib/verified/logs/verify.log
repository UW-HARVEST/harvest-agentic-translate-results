ut c_void);\" \"let _ = buf;\"\n\nrun_mutation \"leak: drop free(dest) on malloc failure\" \\\n    \"                free(dest as *mut c_void);\n                return ptr::null_mut();\" \\\n    \"                return ptr::null_mut();\"\n\nrun_mutation \"byte 1: b2 >> 4 -> b2 >> 3\" \\\n    \"(b2 as u32) >> 4\" \"(b2 as u32) >> 3\"\n\nrun_mutation \"byte 2: b2 & 0xf -> b2 & 0x7\" \\\n    \"((b2 as u32) & 0xf)\" \"((b2 as u32) & 0x7)\"\n\nrun_mutation \"byte 3: b3 & 0x3 -> b3 & 0x7\" \\\n    \"((b3 as u32) & 0x3)\" \"((b3 as u32) & 0x7)\"\n\nrun_mutation \"pad: c3 != '=' -> c3 != '/'\" \\\n    \"if c3 != b'=' as c_char\" \"if c3 != b'/' as c_char\"\n\nrun_mutation \"pad: c4 != '=' -> always emit\" \\\n    \"if c4 != b'=' as c_char\" \"if true\"\n\nrun_mutation \"loop: k < l -> k + 3 < l (drops tail quartet)\" \\\n    \"while k < l {\" \"while k + 3 < l {\"\n\nrun_mutation \"loop: k += 4 -> k += 3\" \\\n    \"k += 4;\" \"k += 3;\"\n\nrun_mutation \"tail: c2 default 'A' -> '='\" \\\n    \"let mut c2: c_char = b'A' as c_char;\" \"let mut c2: c_char = b'=' as c_char;\"\n\nrun_mutation \"tail: c3 default 'A' -> '='\" \\\n    \"let mut c3: c_char = b'A' as c_char;\" \"let mut c3: c_char = b'=' as c_char;\"\n\nrun_mutation \"tail: k+2 < l -> k+2 <= l\" \\\n    \"if k + 2 < l {\" \"if k + 2 <= l {\"\n\nrun_mutation \"guard: accept empty string\" \\\n    \"if !src.is_null() && *src != 0 {\" \"if !src.is_null() {\"\n\nrun_mutation \"guard: accept NULL\" \\\n    \"if !src.is_null() && *src != 0 {\" \"if src.is_null() || *src != 0 {\"\n\necho\necho \"=== mutants caught: $pass ; survived/skipped: $fail ===\"\n[ \"$fail\" -eq 0 ] || exit 1\n","structuredPatch":[{"oldStart":17,"oldLines":8,"newStart":17,"newLines":12,"lines":[" pass=0"," fail=0"," ","+# run_mutation <expect> <name> <from> <to>","+#   expect=caught      -> the suite MUST fail on this mutant","+#   expect=equivalent  -> the mutant is provably semantics-preserving, so the","+#                         suite MUST stil