\n41\t\n42\t#[inline]\n43\tfn nan_operand(dst: f32, src: f32) -> Option<f32> {\n44\t    if dst.is_nan() {\n45\t        Some(quiet(dst))\n46\t    } else if src.is_nan() {\n47\t        Some(quiet(src))\n48\t    } else {\n49\t        None\n50\t    }\n51\t}\n52\t\n53\t/// `addss dst, src` → `dst + src`\n54\t#[inline]\n55\tfn addss(dst: f32, src: f32) -> f32 {\n56\t    match nan_operand(dst, src) {\n57\t        Some(v) => v,\n58\t        None => dst + src,\n59\t    }\n60\t}\n61\t\n62\t/// `subss dst, src` → `dst - src`\n63\t#[inline]\n64\tfn subss(dst: f32, src: f32) -> f32 {\n65\t    match nan_operand(dst, src) {\n66\t        Some(v) => v,\n67\t        None => dst - src,\n68\t    }\n69\t}\n70\t\n71\t/// `mulss dst, src` → `dst * src`\n72\t#[inline]\n73\tfn mulss(dst: f32, src: f32) -> f32 {\n74\t    match nan_operand(dst, src) {\n75\t        Some(v) => v,\n76\t        None => dst * src,\n77\t    }\n78\t}\n79\t\n80\t/// `divss dst, src` → `dst / src`\n81\t#[inline]\n82\tfn divss(dst: f32, src: f32) -> f32 {\n83\t    match nan_operand(dst, src) {\n84\t        Some(v) => v,\n85\t        None => dst / src,\n86\t    }\n87\t}\n88\t\n89\t// ---------------------------------------------------------------------------\n90\t// Other helpers reproducing C semantics exactly\n91\t// ---------------------------------------------------------------------------\n92\t\n93\t/// `(int)f` as emitted by GCC/Clang on x86-64 (`cvttss2si`).\n94\t///\n95\t/// C leaves the conversion undefined when the truncated value is not\n96\t/// representable; the hardware yields the \"integer indefinite\" value\n97\t/// `0x80000000`. NaN maps there as well.\n98\t#[inline]\n99\tfn c_cast_f32_to_i32(f: f32) -> i32 {\n100\t    if f.is_nan() || f >= 2147483648.0f32 || f < -2147483648.0f32 {\n101\t        i32::MIN\n102\t    } else {\n103\t        f as i32\n104\t    }\n105\t}\n106\t\n107\t/// C's `fmodf` (`x % y` lowers to a `fmodf` libm call).\n108\t#[inline]\n109\tfn fmodf(x: f32, y: f32) -> f32 {\n110\t    x % y\n111\t}\n112\t\n113\t/// C's `fabsf` — `andps` against `0x7fffffff`.\n114\t#[inline]\n115\tfn fabsf(x: f32) -> f32 {\n116\t    f32::from_bits(x.to_bits() & 0x7fff_ffff)\n117\t}\n118\t\n119\t/// C's `floorf` — `roundss $9`.\n120\t#[inline]\n121\tfn floorf(x: f32) -> f32 {\n122\t    x.floor()\n123\t}\n124\t\n125\t/// C's `cond ? 1 : 0` as an `int`.\n126\t#[inline]\n127\tfn cbool(b: bool) -> c_int {\n128\t    b as c_int\n129\t}\n130\t\n131\t/// C's `cond ? 1 : 0` as an `unsigned int`.\n132\t#[inline]\n133\tfn ubool(b: bool) -> c_uint {\n134\t    b as c_uint\n135\t}\n136\t\n137\t// ---------------------------------------------------------------------------\n138\t// cute_c2 style 2D collision primitives\n139\t// ---------------------------------------------------------------------------\n140\t\n141\tpub const C2_TYPE_CIRCLE: c_uint = 0;\n142\tpub const C2_TYPE_AABB: c_uint = 1;\n143\t\n144\t/// `typedef enum { ... } C2_TYPE;` — GCC lays this out as `unsigned int`.\n145\t#[allow(dead_code)]\n146\tpub type C2_TYPE = c_uint;\n147\t\n148\t#[repr(C)]\n149\t#[derive(Copy, Clone)]\n150\tpub struct c2v {\n151\t    pub x: f32,\n152\t    pub y: f32,\n153\t}\n154\t\n155\t#[repr(C)]\n156\t#[derive(Copy, Clone)]\n157\tpub struct c2Circle {\n158\t    pub p: c2v,\n159\t    pub r: f32,\n160\t}\n161\t\n162\t#[repr(C)]\n163\t#[derive(Copy, Clone)]\n164\tpub struct c2AABB {\n165\t    pub min: c2v,\n166\t    pub max: c2v,\n167\t}\n168\t\n169\t#[inline]\n170\tfn c2V_impl(x: f32, y: f32) -> c2v {\n171\t    let mut a = c2v { x: 0.0, y: 0.0 };\n172\t    a.x = x;\n173\t    a.y = y;\n174\t    a\n175\t}\n176\t\n177\t#[unsafe(no_mangle)]\n178\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n179\t    c2V_impl(x, y)\n180\t}\n181\t\n182\t#[inline]\n183\tfn c2Maxv_impl(a: c2v, b: c2v) -> c2v {\n184\t    c2V_impl(\n185\t        if a.x > b.x { a.x } else { b.x },\n186\t        if a.y > b.y { a.y } else { b.y },\n187\t    )\n188\t}\n189\t\n190\t#[unsafe(no_mangle)]\n191\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n192\t    c2Maxv_impl(a, b)\n193\t}\n194\t\n195\t#[inline]\n196\tfn c2Minv_impl(a: c2v, b: c2v) -> c2v {\n197\t    c2V_impl(\n198\t        if a.x < b.x { a.x } else { b.x },\n199\t        if a.y < b.y { a.y } else { b.y },\n200\t    )\n201\t}\n202\t\n203\t#[unsafe(no_mangle)]\n204\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n205\t    c2Minv_impl(a, b)\n206\t}\n207\t\n208\t#[inline]\n209\tfn c2Clampv_impl(a: c2v, lo: c2v, hi: c2v) -> c2v {\n210\t    c2Maxv_impl(lo, c2Minv_impl(a, hi))\n211\t}\n212\t\n213\t#[unsafe(no_mangle)]\n214\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n215\t    c2Clampv_impl(a, lo, hi)\n216\t}\n217\t\n218\t#[inline]\n219\tfn c2Sub_impl(a: c2v, b: c2v) -> c2v {\n220\t    let mut a = a;\n221\t    a.x = subss(a.x, b.x);\n222\t    a.y = subss(a.y, b.y);\n223\t    a\n224\t}\n225\t\n226\t#[unsafe(no_mangle)]\n227\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n228\t    c2Sub_impl(a, b)\n229\t}\n230\t\n231\t#[inline]\n232\tfn c2Dot_impl(a: c2v, b: c2v) -> f32 {\n233\t    addss(mulss(a.x, b.x), mulss(a.y, b.y))\n234\t}\n235\t\n236\t#[unsafe(no_mangle)]\n237\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n238\t    c2Dot_impl(a, b)\n239\t}\n240\t\n241\t#[inline]\n242\tfn c2CircletoCircle_impl(A: c2Circle, B: c2Circle) -> c_int {\n243\t    let c = c2Sub_impl(B.p, A.p);\n244\t    let d2 = c2Dot_impl(c, c);\n245\t    let mut r2 = addss(A.r, B.r);\n246\t    r2 = mulss(r2, r2);\n247\t    cbool(d2 < r2)\n248\t}\n249\t\n250\t#[unsafe(no_mangle)]\n251\tpub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n252\t    c2CircletoCircle_impl(A, B)\n253\t}\n254\t\n255\t#[inline]\n256\tfn c2CircletoAABB_impl(A: c2Circle, B: c2AABB) -> c_int {\n257\t    let L = c2Clampv_impl(A.p, B.min, B.max);\n258\t    let ab = c2Sub_impl(A.p, L);\n259\t    let d2 = c2Dot_impl(ab, ab);\n260\t    let r2 = mulss(A.r, A.r);\n261\t    cbool(d2 < r2)\n262\t}\n263\t\n264\t#[unsafe(no_mangle)]\n265\tpub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n266\t    c2CircletoAABB_impl(A, B)\n267\t}\n268\t\n269\t#[inline]\n270\tfn c2AABBtoAABB_impl(A: c2AABB, B: c2AABB) -> c_int {\n271\t    let d0 = cbool(B.max.x < A.min.x);\n272\t    let d1 = cbool(A.max.x < B.min.x);\n273\t    let d2 = cbool(B.max.y < A.min.y);\n274\t    let d3 = cbool(A.max.y < B.min.y);\n275\t    cbool((d0 | d1 | d2 | d3) == 0)\n276\t}\n277\t\n278\t#[unsafe(no_mangle)]\n279\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n280\t    c2AABBtoAABB_impl(A, B)\n281\t}\n282\t\n283\t/// Dispatching collision test over type-erased shape pointers.\n284\t///\n285\t/// # Safety\n286\t/// `A` and `B` must point to a `c2Circle`/`c2AABB` matching `typeA`/`typeB`.\n287\t#[unsafe(no_mangle)]\n288\tpub unsafe extern \"C\" fn f2(\n289\t    A: *const c_void,\n290\t    typeA: c_uint,\n291\t    B: *const c_void,\n292\t    typeB: c_uint,\n293\t) -> c_int {\n294\t    match typeA {\n295\t        C2_TYPE_CIRCLE => match typeB {\n296\t            C2_TYPE_CIRCLE => {\n297\t                c2CircletoCircle_impl(*(A as *const c2Circle), *(B as *const c2Circle))\n298\t            }\n299\t            C2_TYPE_AABB => c2CircletoAABB_impl(*(A as *const c2Circle), *(B as *const c2AABB)),\n300\t            _ => 0,\n301\t        },\n302\t        C2_TYPE_AABB => match typeB {\n303\t            C2_TYPE_CIRCLE => c2CircletoAABB_impl(*(B as *const c2Circle), *(A as *const c2AABB)),\n304\t            C2_TYPE_AABB => c2AABBtoAABB_impl(*(A as *const c2AABB), *(B as *const c2AABB)),\n305\t            _ => 0,\n306\t        },\n307\t        _ => 0,\n308\t    }\n309\t}\n310\t\n311\t// ---------------------------------------------------------------------------\n312\t// f3 — floored integer division\n313\t// ---------------------------------------------------------------------------\n314\t\n315\tconst INT_MIN: c_int = -0x7fff_ffff - 1;\n316\t\n317\t#[inline]\n318\tfn f3_impl(v1: c_int, v2: c_int) -> c_int {\n319\t    if v2 == 0 {\n320\t        return 0;\n321\t    }\n322\t    let q: c_int;\n323\t    let r: c_int;\n324\t    // The C source relies on dangling-`else` binding; the nesting below\n325\t    // reproduces it exactly. Wrapping arithmetic mirrors the two's-complement\n326\t    // wrap-around the original signed-overflow paths get from the hardware.\n327\t    if v1 >= 0 {\n328\t        if v2 >= 0 {\n329\t            return v1.wrapping_div(v2);\n330\t        } else if v2 != INT_MIN {\n331\t            q = v1.wrapping_div(v2.wrapping_neg()).wrapping_neg();\n332\t            r = v1.wrapping_rem(v2.wrapping_neg());\n333\t        } else {\n334\t            q = 0;\n335\t            r = v1;\n336\t        }\n337\t    } else if v1 != INT_MIN {\n338\t        if v2 >= 0 {\n339\t            q = v1.wrapping_neg().wrapping_div(v2).wrapping_neg();\n340\t            r = v1.wrapping_neg().wrapping_rem(v2).wrapping_neg();\n341\t        } else if v2 != INT_MIN {\n342\t            q = v1.wrapping_neg().wrapping_div(v2.wrapping_neg());\n343\t            r = v1\n344\t                .wrapping_neg()\n345\t                .wrapping_rem(v2.wrapping_neg())\n346\t                .wrapping_neg();\n347\t        } else {\n348\t            q = 1;\n349\t            r = v1.wrapping_sub(q.wrapping_mul(v2));\n350\t        }\n351\t    } else if v2 >= 0 {\n352\t        q = v1\n353\t            .wrapping_add(v2)\n354\t            .wrapping_neg()\n355\t            .wrapping_div(v2)\n356\t            .wrapping_neg()\n357\t            .wrapping_sub(1);\n358\t        r = v1\n359\t            .wrapping_add(v2)\n360\t            .wrapping_neg()\n361\t            .wrapping_rem(v2)\n362\t            .wrapping_neg();\n363\t    } else if v2 != INT_MIN {\n364\t        q = v1\n365\t            .wrapping_sub(v2)\n366\t            .wrapping_neg()\n367\t            .wrapping_div(v2.wrapping_neg())\n368\t            .wrapping_add(1);\n369\t        r = v1\n370\t            .wrapping_sub(v2)\n371\t            .wrapping_neg()\n372\t            .wrapping_rem(v2.wrapping_neg())\n373\t            .wrapping_neg();\n374\t    } else {\n375\t        q = 1;\n376\t        r = 0;\n377\t    }\n378\t    if r >= 0 {\n379\t        q\n380\t    } else {\n381\t        q.wrapping_add(if v2 > 0 { -1 } else { 1 })\n382\t    }\n383\t}\n384\t\n385\t#[unsafe(no_mangle)]\n386\tpub extern \"C\" fn f3(v1: c_int, v2: c_int) -> c_int {\n387\t    f3_impl(v1, v2)\n388\t}\n389\t\n390\t// ---------------------------------------------------------------------------\n391\t// f4 — xorshift128+ derived double in [0, 1)\n392\t// ---------------------------------------------------------------------------\n393\t\n394\t#[repr(C)]\n395\t#[derive(Copy, Clone)]\n396\tpub struct cn_rnd_t {\n397\t    pub state: [u64; 2],\n398\t}\n399\t\n400\t#[inline]\n401\tfn cn_rnd_next(rnd: &mut cn_rnd_t) -> u64 {\n402\t    let mut x = rnd.state[0];\n403\t    let y = rnd.state[1];\n404\t    rnd.state[0] = y;\n405\t    x ^= x << 23;\n406\t    x ^= x >> 17;\n407\t    x ^= y ^ (y >> 26);\n408\t    rnd.state[1] = x;\n409\t    x.wrapping_add(y)\n410\t}\n411\t\n412\t#[inline]\n413\tfn f4_impl(rnd: &mut cn_rnd_t) -> f64 {\n414\t    let value = cn_rnd_next(rnd);\n415\t    let exponent: u64 = 1023;\n416\t    let mantissa: u64 = value >> 12;\n417\t    let result: u64 = (exponent << 52) | mantissa;\n418\t    // The C code type-puns the `uint64_t` through a `double *`.\n419\t    f64::from_bits(result) - 1.0\n420\t}\n421\t\n422\t/// # Safety\n423\t/// `rnd` must be a valid, aligned, non-null pointer to a `cn_rnd_t`.\n424\t#[unsafe(no_mangle)]\n425\tpub unsafe extern \"C\" fn f4(rnd: *mut cn_rnd_t) -> f64 {\n426\t    f4_impl(&mut *rnd)\n427\t}\n428\t\n429\t// ---------------------------------------------------------------------------\n430\t// f5 — 16-bit bit reversal performed on a 32-bit value\n431\t// ---------------------------------------------------------------------------\n432\t\n433\t#[inline]\n434\tfn f5_impl(a: u32) -> u32 {\n435\t    let mut a = a;\n436\t    // The masks are 16-bit, so any bits above bit 15 are discarded — kept as-is.\n437\t    a = ((a & 0xAAAA) >> 1) | ((a & 0x5555) << 1);\n438\t    a = ((a & 0xCCCC) >> 2) | ((a & 0x3333) << 2);\n439\t    a = ((a & 0xF0F0) >> 4) | ((a & 0x0F0F) << 4);\n440\t    a = ((a & 0xFF00) >> 8) | ((a & 0x00FF) << 8);\n441\t    a\n442\t}\n443\t\n444\t#[unsafe(no_mangle)]\n445\tpub extern \"C\" fn f5(a: u32) -> u32 {\n446\t    f5_impl(a)\n447\t}\n448\t\n449\t// ---------------------------------------------------------------------------\n450\t// tflac\n451\t// ---------------------------------------------------------------------------\n452\t\n453\t#[allow(dead_code)]\n454\tpub type tflac_u8 = u8;\n455\t#[allow(dead_code)]\n456\tpub type tflac_u16 = u16;\n457\tpub type tflac_u32 = u32;\n458\t\n459\t#[inline]\n460\tfn f7_impl(blocksize: tflac_u32, channels: tflac_u32, bitdepth: tflac_u32) -> tflac_u32 {\n461\t    // Reproduces the original expression verbatim, including the stray unary\n462\t    // `+` in front of the `7` and the unsigned wrap-around.\n463\t    let term1 = blocksize\n464\t        .wrapping_mul(bitdepth)\n465\t        .wrapping_mul(channels.wrapping_mul(ubool(channels != 2)));\n466\t    let term2 = blocksize\n467\t        .wrapping_mul(bitdepth)\n468\t        .wrapping_mul(ubool(channels == 2));\n469\t    let term3 = blocksize\n470\t        .wrapping_mul(bitdepth.wrapping_add(ubool(bitdepth != 32)))\n471\t        .wrapping_mul(ubool(channels == 2));\n472\t    18u32.wrapping_add(channels).wrapping_add(\n473\t        term1\n474\t            .wrapping_add(term2)\n475\t            .wrapping_add(term3)\n476\t            .wrapping_add(7)\n477\t            / 8,\n478\t    )\n479\t}\n480\t\n481\t#[unsafe(no_mangle)]\n482\tpub extern \"C\" fn f7(blocksize: tflac_u32, channels: tflac_u32, bitdepth: tflac_u32) -> tflac_u32 {\n483\t    f7_impl(blocksize, channels, bitdepth)\n484\t}\n485\t\n486\t// ---------------------------------------------------------------------------\n487\t// lightmapper — barycentric coordinates\n488\t// ---------------------------------------------------------------------------\n489\t\n490\t#[repr(C)]\n491\t#[derive(Copy, Clone)]\n492\tpub struct lm_vec2 {\n493\t    pub x: f32,\n494\t    pub y: f32,\n495\t}\n496\t\n497\t#[inline]\n498\tfn lm_v2(x: f32, y: f32) -> lm_vec2 {\n499\t    lm_vec2 { x, y }\n500\t}\n501\t\n502\t#[inline]\n503\tfn lm_sub2(a: lm_vec2, b: lm_vec2) -> lm_vec2 {\n504\t    lm_v2(subss(a.x, b.x), subss(a.y, b.y))\n505\t}\n506\t\n507\t#[inline]\n508\tfn f9_impl(p1: lm_vec2, p2: lm_vec2, p3: lm_vec2, p: lm_vec2) -> lm_vec2 {\n509\t    let v0 = lm_sub2(p3, p1);\n510\t    let v1 = lm_sub2(p2, p1);\n511\t    let v2 = lm_sub2(p, p1);\n512\t    // `lm_dot2` is inlined; the operand roles below match the `mulss`/`addss`\n513\t    // pairs the C compiler emits for each of the five dot products.\n514\t    let dot00 = addss(mulss(v0.x, v0.x), mulss(v0.y, v0.y));\n515\t    let dot01 = addss(mulss(v1.x, v0.x), mulss(v1.y, v0.y));\n516\t    let dot02 = addss(mulss(v0.y, v2.y), mulss(v0.x, v2.x));\n517\t    let dot11 = addss(mulss(v1.x, v1.x), mulss(v1.y, v1.y));\n518\t    let dot12 = addss(mulss(v1.x, v2.x), mulss(v2.y, v1.y));\n519\t    let inv_denom = divss(1.0f32, subss(mulss(dot11, dot00), mulss(dot01, dot01)));\n520\t    let u = mulss(\n521\t        subss(mulss(dot11, dot02), mulss(dot12, dot01)),\n522\t        inv_denom,\n523\t    );\n524\t    let v = mulss(\n525\t        subss(mulss(dot12, dot00), mulss(dot02, dot01)),\n526\t        inv_denom,\n527\t    );\n528\t    lm_v2(u, v)\n529\t}\n530\t\n531\t#[unsafe(no_mangle)]\n532\tpub extern \"C\" fn f9(p1: lm_vec2, p2: lm_vec2, p3: lm_vec2, p: lm_vec2) -> lm_vec2 {\n533\t    f9_impl(p1, p2, p3, p)\n534\t}\n535\t\n536\t// ---------------------------------------------------------------------------\n537\t// f10 — half-float to float via lookup tables\n538\t// ---------------------------------------------------------------------------\n539\t\n540\t#[inline]\n541\tfn f10_impl(h: u16) -> f32 {\n542\t    let n = (h >> 10) as usize;\n543\t    let num =\n544\t        m__mantissa[((h & 0x3ff) as usize) + (m__offset[n] as usize)].wrapping_add(m__exponent[n]);\n545\t    f32::from_bits(num)\n546\t}\n547\t\n548\t#[unsafe(no_mangle)]\n549\tpub extern \"C\" fn f10(h: u16) -> f32 {\n550\t    f10_impl(h)\n551\t}\n552\t\n553\t// ---------------------------------------------------------------------------\n554\t// Colour space conversions\n555\t// ---------------------------------------------------------------------------\n556\t\n557\t#[inline]\n558\tfn f11_impl(dest: &mut [f32; 3], src: &[f32; 3]) {\n559\t    let h = src[0];\n560\t    let s = src[1];\n561\t    let l = src[2];\n562\t    let c: f32;\n563\t    let m: f32;\n564\t    let x: f32;\n565\t    if s == 0.0 {\n566\t        dest[0] = l;\n567\t        dest[1] = l;\n568\t        dest[2] = l;\n569\t        return;\n570\t    }\n571\t    // c = (1.0f - fabsf(2.0f * l - 1.0f)) * s\n572\t    c = mulss(subss(1.0f32, fabsf(subss(addss(l, l), 1.0f32))), s);\n573\t    // m = 1.0f * (l - 0.5f * c)\n574\t    m = mulss(1.0f32, subss(l, mulss(c, 0.5f32)));\n575\t    // x = c * (1.0f - fabsf(fmodf(h / 60.0f, 2) - 1.0f))\n576\t    x = mulss(\n577\t        subss(\n578\t            1.0f32,\n579\t            fabsf(subss(fmodf(divss(h, 60.0f32), 2.0f32), 1.0f32)),\n580\t        ),\n581\t        c,\n582\t    );\n583\t    if h >= 0.0f32 && h < 60.0f32 {\n584\t        dest[0] = addss(c, m);\n585\t        dest[1] = addss(x, m);\n586\t        dest[2] = m;\n587\t    } else if h >= 60.0f32 && h < 120.0f32 {\n588\t        dest[0] = addss(x, m);\n589\t        dest[1] = addss(c, m);\n590\t        dest[2] = m;\n591\t    } else if h < 120.0f32 && h < 180.0f32 {\n592\t        // NOTE: the original C reads `h < 120.0f && h < 180.0f` (rather than\n593\t        // `h >= 120.0f`). Reproduced verbatim — do not \"fix\".\n594\t        dest[0] = m;\n595\t        dest[1] = addss(c, m);\n596\t        dest[2] = addss(m, x);\n597\t    } else if h >= 180.0f32 && h < 240.0f32 {\n598\t        dest[0] = m;\n599\t        dest[1] = addss(x, m);\n600\t        dest[2] = addss(m, c);\n601\t    } else if h >= 240.0f32 && h < 300.0f32 {\n602\t        dest[0] = addss(x, m);\n603\t        dest[1] = m;\n604\t        dest[2] = addss(m, c);\n605\t    } else if h >= 300.0f32 && h < 360.0f32 {\n606\t        dest[0] = addss(c, m);\n607\t        dest[1] = m;\n608\t        dest[2] = addss(m, x);\n609\t    } else {\n610\t        dest[0] = m;\n611\t        dest[1] = m;\n612\t        dest[2] = m;\n613\t    }\n614\t}\n615\t\n616\t/// # Safety\n617\t/// `dest` must be writable for 3 `float`s and `src` readable for 3 `float`s.\n618\t#[unsafe(no_mangle)]\n619\tpub unsafe extern \"C\" fn f11(dest: *mut f32, src: *const f32) {\n620\t    // All loads happen before any store, matching the C codegen so that\n621\t    // overlapping `dest`/`src` behaves the same.\n622\t    let s: [f32; 3] = [*src.add(0), *src.add(1), *src.add(2)];\n623\t    let mut d: [f32; 3] = [0.0, 0.0, 0.0];\n624\t    f11_impl(&mut d, &s);\n625\t    *dest.add(0) = d[0];\n626\t    *dest.add(1) = d[1];\n627\t    *dest.add(2) = d[2];\n628\t}\n629\t\n630\t#[inline]\n631\tfn f12_impl(dest: &mut [f32; 3], src: &[f32; 3]) {\n632\t    let r: f32;\n633\t    let g: f32;\n634\t    let b: f32;\n635\t    let f: f32;\n636\t    let p: f32;\n637\t    let q: f32;\n638\t    let t: f32;\n639\t    let mut h = src[0];\n640\t    let s = src[1];\n641\t    let v = src[2];\n642\t    let i: c_int;\n643\t    if s == 0.0 {\n644\t        dest[0] = v;\n645\t        dest[1] = v;\n646\t        dest[2] = v;\n647\t        return;\n648\t    }\n649\t    h = divss(h, 60.0f32);\n650\t    i = c_cast_f32_to_i32(floorf(h));\n651\t    f = subss(h, i as f32);\n652\t    p = mulss(subss(1.0f32, s), v);\n653\t    q = mulss(subss(1.0f32, mulss(s, f)), v);\n654\t    t = mulss(subss(1.0f32, mulss(subss(1.0f32, f), s)), v);\n655\t    match i {\n656\t        0 => {\n657\t            r = v;\n658\t            g = t;\n659\t            b = p;\n660\t        }\n661\t        1 => {\n662\t            r = q;\n663\t            g = v;\n664\t            b = p;\n665\t        }\n666\t        2 => {\n667\t            r = p;\n668\t            g = v;\n669\t            b = t;\n670\t        }\n671\t        3 => {\n672\t            r = p;\n673\t            g = q;\n674\t            b = v;\n675\t        }\n676\t        4 => {\n677\t            r = t;\n678\t            g = p;\n679\t            b = v;\n680\t        }\n681\t        _ => {\n682\t            r = v;\n683\t            g = p;\n684\t            b = q;\n685\t        }\n686\t    }\n687\t    dest[0] = r;\n688\t    dest[1] = g;\n689\t    dest[2] = b;\n690\t}\n691\t\n692\t/// # Safety\n693\t/// `dest` must be writable for 3 `float`s and `src` readable for 3 `float`s.\n694\t#[unsafe(no_mangle)]\n695\tpub unsafe extern \"C\" fn f12(dest: *mut f32, src: *const f32) {\n696\t    let s: [f32; 3] = [*src.add(0), *src.add(1), *src.add(2)];\n697\t    let mut d: [f32; 3] = [0.0, 0.0, 0.0];\n698\t    f12_impl(&mut d, &s);\n699\t    *dest.add(0) = d[0];\n700\t    *dest.add(1) = d[1];\n701\t    *dest.add(2) = d[2];\n702\t}\n703\t\n704\t#[inline]\n705\tfn f13_impl(dest: &mut [f32; 3], src: &[f32; 3]) {\n706\t    let r = src[0];\n707\t    let g = src[1];\n708\t    let b = src[2];\n709\t    let mut h: f32 = 0.0;\n710\t    let mut s: f32 = 0.0;\n711\t    let v: f32;\n712\t    let mut min = r;\n713\t    let mut max = r;\n714\t    let delta: f32;\n715\t    min = if min < g { min } else { g };\n716\t    min = if min < b { min } else { b };\n717\t    max = if max > g { max } else { g };\n718\t    max = if max > b { max } else { b };\n719\t    delta = subss(max, min);\n720\t    v = max;\n721\t    if delta == 0.0 || max == 0.0 {\n722\t        dest[0] = h;\n723\t        dest[1] = s;\n724\t        dest[2] = v;\n725\t        return;\n726\t    }\n727\t    s = divss(delta, max);\n728\t    if r == max {\n729\t        h = divss(subss(g, b), delta);\n730\t    } el