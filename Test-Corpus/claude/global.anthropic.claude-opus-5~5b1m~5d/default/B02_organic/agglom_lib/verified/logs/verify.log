   f9_4: f32,\n    f9_5: f32,\n    f9_7: f32,\n    f9_8: f32,\n    f9_10: f32,\n    f9_11: f32,\n    f10_1: u16,\n    f11_2: f32,\n    f11_3: f32,\n    f11_4: f32,\n    f12_2: f32,\n    f12_3: f32,\n    f12_4: f32,\n    f13_2: f32,\n    f13_3: f32,\n    f13_4: f32,\n}\n\nimpl Args {\n    /// A benign, fully finite baseline that exercises the ordinary paths.\n    fn baseline() -> Args {\n        Args {\n            f2_1: 0.5,\n            f2_2: 0.5,\n            f2_3: 1.0,\n            f2_7: 0.0,\n            f2_8: 0.0,\n            f2_9: 2.0,\n            f2_10: 2.0,\n            f3_1: 17,\n            f3_2: 5,\n            f4_1: 0x0123_4567_89AB_CDEF,\n            f4_2: 0xFEDC_BA98_7654_3210,\n            f5_1: 0xBEEF,\n            f7_1: 4096,\n            f7_2: 2,\n            f7_3: 16,\n            f9_1: 0.0,\n            f9_2: 0.0,\n            f9_4: 1.0,\n            f9_5: 0.0,\n            f9_7: 0.0,\n            f9_8: 1.0,\n            f9_10: 0.3,\n            f9_11: 0.3,\n            f10_1: 0x3C00,\n            f11_2: 30.0,\n            f11_3: 0.5,\n            f11_4: 0.5,\n            f12_2: 200.0,\n            f12_3: 0.5,\n            f12_4: 0.5,\n            f13_2: 0.2,\n            f13_3: 0.6,\n            f13_4: 0.4,\n        }\n    }\n\n    fn zeros() -> Args {\n        Args {\n            f2_1: 0.0,\n            f2_2: 0.0,\n            f2_3: 0.0,\n            f2_7: 0.0,\n            f2_8: 0.0,\n            f2_9: 0.0,\n            f2_10: 0.0,\n            f3_1: 0,\n            f3_2: 0,\n            f4_1: 0,\n            f4_2: 0,\n            f5_1: 0,\n            f7_1: 0,\n            f7_2: 0,\n            f7_3: 0,\n            f9_1: 0.0,\n            f9_2: 0.0,\n            f9_4: 0.0,\n            f9_5: 0.0,\n            f9_7: 0.0,\n            f9_8: 0.0,\n            f9_10: 0.0,\n            f9_11: 0.0,\n            f10_1: 0,\n            f11_2: 0.0,\n            f11_3: 0.0,\n            f11_4: 0.0,\n            f12_2: 0.0,\n            f12_3: 0.0,\n