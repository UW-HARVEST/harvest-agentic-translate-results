t    let mut hash: usize = seed;\n437\t    let mut s = str_ as *const u8;\n438\t    while *s != 0 {\n439\t        hash = stbds_rotate_left(hash, 9).wrapping_add(*s as usize);\n440\t        s = s.add(1);\n441\t    }\n442\t\n443\t    hash ^= seed;\n444\t    hash = (!hash).wrapping_add(hash << 18);\n445\t    hash ^= hash ^ stbds_rotate_right(hash, 31);\n446\t    hash = hash.wrapping_mul(21);\n447\t    hash ^= hash ^ stbds_rotate_right(hash, 11);\n448\t    hash = hash.wrapping_add(hash << 6);\n449\t    hash ^= stbds_rotate_right(hash, 22);\n450\t    hash.wrapping_add(seed)\n451\t}\n452\t\n453\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n454\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n455\t\n456\t/// Mirrors `d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24)` evaluated in\n457\t/// `int` arithmetic and then converted to `size_t` (i.e. sign-extended when\n458\t/// the top byte has its high bit set -- exactly what the C code does).\n459\t#[inline(always)]\n460\tunsafe fn load_int_le32_sign_extended(d: *const u8) -> usize {\n461\t    let v: u32 = (*d.add(0) as u32)\n462\t        | ((*d.add(1) as u32) << 8)\n463\t        | ((*d.add(2) as u32) << 16)\n464\t        | ((*d.add(3) as u32) << 24);\n465\t    (v as i32) as isize as usize\n466\t}\n467\t\n468\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n469\t    let mut d = p as *const u8;\n470\t    let mut i: usize;\n471\t    let mut j: usize;\n472\t    let mut v0: usize;\n473\t    let mut v1: usize;\n474\t    let mut v2: usize;\n475\t    let mut v3: usize;\n476\t    let mut data: usize;\n477\t\n478\t    v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n479\t    v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n480\t    v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n481\t    v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n482\t\n483\t    v0 ^= 0x0706050403020100u64 as usize ^ seed;\n484\t    v1 ^= 0x0f0e0d0c0