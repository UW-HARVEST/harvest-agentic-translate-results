{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BH1ahWSy32hoD7GCM3u8sw","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (an inlined copy of stb_ds.h\n2\t//! plus the `strkey` / `str_put` driver code from `src/lib.c`).\n3\t//!\n4\t//! The translation is deliberately literal: every quirk of the original C\n5\t//! (including implicit `int` sign-extension in the SipHash byte loading, the\n6\t//! missing `temp_key` update in the wrap-around branch of `stbds_hmput_key`,\n7\t//! and the `printf(\"%s %d\\n\", struct_by_value, ...)` call in `str_put`) is\n8\t//! reproduced bit for bit.\n9\t//!\n10\t//! All heap memory is managed through libc `realloc`/`free` so that pointers\n11\t//! handed out by / passed into this library remain interchangeable with the\n12\t//! ones from the original C implementation.\n13\t\n14\t#![allow(non_camel_case_types)]\n15\t#![allow(non_upper_case_globals)]\n16\t#![allow(unused_assignments)]\n17\t\n18\tuse core::ffi::{c_char, c_int, c_uint, c_void};\n19\tuse core::ptr;\n20\t\n21\t// ---------------------------------------------------------------------------\n22\t// libc bindings (STBDS_REALLOC / STBDS_FREE and the string/stdio helpers)\n23\t// ---------------------------------------------------------------------------\n24\t\n25\textern \"C\" {\n26\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n27\t    fn free(p: *mut c_void);\n28\t    fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n29\t    fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n30\t    fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n31\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n32\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n33\t    fn strlen(s: *const c_char) -> usize;\n34\t    fn printf(fmt: *const c_char, ...) -> c_int;\n35\t    fn sprintf(buf: *mut c_char, fmt: *const c_char, ...) -> c_int;\n36\t    /// glibc's `assert` backend. `c_src/src/lib.c` is compiled *without*\n37\t    /// `-DNDEBUG` (`nm -D` lists `__assert_fail` among its imports), so every\n38\t    /// `STBDS_ASSERT` is a live check that prints a diagnostic and raises\n39\t    /// `SIGABRT`. Calling the very same libc entry point reproduces both the\n40\t    /// message and the termination signal exactly.\n41\t    fn __assert_fail(\n42\t        assertion: *const c_char,\n43\t        file: *const c_char,\n44\t        line: c_uint,\n45\t        function: *const c_char,\n46\t    ) -> !;\n47\t}\n48\t\n49\t/// `__FILE__` of the original translation unit (see `build.rs`).\n50\tconst STBDS_C_FILE: &str = concat!(env!(\"STBDS_C_SOURCE_FILE\"), \"\\0\");\n51\t\n52\t/// `#define STBDS_ASSERT assert`\n53\t///\n54\t/// Reproduces the C `assert` macro: on failure the same glibc `__assert_fail`\n55\t/// is invoked with the identical expression text, source line and function name.\n56\tmacro_rules! stbds_assert {\n57\t    ($cond:expr, $expr_text:literal, $line:literal, $func:literal) => {\n58\t        if !($cond) {\n59\t            unsafe {\n60\t                __assert_fail(\n61\t                    concat!($expr_text, \"\\0\").as_ptr() as *const c_char,\n62\t                    STBDS_C_FILE.as_ptr() as *const c_char,\n63\t                    $line,\n64\t                    concat!($func, \"\\0\").as_ptr() as *const c_char,\n65\t                );\n66\t            }\n67\t        }\n68\t    };\n69\t}\n70\t\n71\t#[inline(always)]\n72\tunsafe fn stbds_realloc(p: *mut c_void, size: usize) -> *mut c_void {\n73\t    realloc(p, size)\n74\t}\n75\t\n76\t#[inline(always)]\n77\tunsafe fn stbds_free(p: *mut c_void) {\n78\t    free(p)\n79\t}\n80\t\n81\t// ---------------------------------------------------------------------------\n82\t// Types\n83\t// ---------------------------------------------------------------------------\n84\t\n85\t#[repr(C)]\n86\t#[derive(Clone, Copy)]\n87\tstruct stbds_array_header {\n88\t    length: usize,\n89\t    capacity: usize,\n90\t    hash_table: *mut c_void,\n91\t    temp: isize,\n92\t}\n93\t\n94\t#[repr(C)]\n95\tstruct stbds_string_block {\n96\t    next: *mut stbds_string_block,\n97\t    storage: [c_char; 8],\n98\t}\n99\t\n100\t#[repr(C)]\n101\t#[derive(Clone, Copy)]\n102\tpub struct stbds_string_arena {\n103\t    storage: *mut stbds_string_block,\n104\t    remaining: usize,\n105\t    block: u8,\n106\t    mode: u8,\n107\t}\n108\t\n109\tconst STBDS_BUCKET_LENGTH: usize = 8;\n110\tconst STBDS_BUCKET_SHIFT: usize = 3;\n111\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n112\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n113\t\n114\t#[repr(C)]\n115\tstruct stbds_hash_bucket {\n116\t    hash: [usize; STBDS_BUCKET_LENGTH],\n117\t    index: [isize; STBDS_BUCKET_LENGTH],\n118\t}\n119\t\n120\t#[repr(C)]\n121\tstruct stbds_hash_index {\n122\t    temp_key: *mut c_char,\n123\t    slot_count: usize,\n124\t    used_count: usize,\n125\t    used_count_threshold: usize,\n126\t    used_count_shrink_threshold: usize,\n127\t    tombstone_count: usize,\n128\t    tombstone_count_threshold: usize,\n129\t    seed: usize,\n130\t    slot_count_log2: usize,\n131\t    string: stbds_string_arena,\n132\t    storage: *mut stbds_hash_bucket,\n133\t}\n134\t\n135\tconst STBDS_INDEX_EMPTY: isize = -1;\n136\tconst STBDS_INDEX_DELETED: isize = -2;\n137\t\n138\tconst STBDS_HASH_EMPTY: usize = 0;\n139\tconst STBDS_HASH_DELETED: usize = 1;\n140\t\n141\t#[allow(dead_code)]\n142\tconst STBDS_HM_BINARY: c_int = 0;\n143\tconst STBDS_HM_STRING: c_int = 1;\n144\t\n145\tconst STBDS_SH_NONE: c_int = 0;\n146\tconst STBDS_SH_DEFAULT: c_int = 1;\n147\tconst STBDS_SH_STRDUP: c_int = 2;\n148\tconst STBDS_SH_ARENA: c_int = 3;\n149\t\n150\tconst HEADER_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n151\t\n152\t// ---------------------------------------------------------------------------\n153\t// Macro helpers\n154\t// ---------------------------------------------------------------------------\n155\t\n156\t/// Writes `*p = v` the way C does, i.e. **without** the null-pointer check that\n157\t/// rustc inserts for a `(*p).field = v` place expression when\n158\t/// `debug-assertions` is on.\n159\t///\n160\t/// This matters for faithfulness: when `realloc` fails, `stbds_arrgrowf` happily\n161\t/// stores the header at `(char *) NULL + sizeof(header)` and the C process dies\n162\t/// with `SIGSEGV`.  A `(*p).field = v` in the translation would instead trip\n163\t/// rustc's inserted null check and abort with a Rust panic message in the `dev`\n164\t/// profile, so the observable failure mode would differ between profiles.\n165\t/// `ptr::write` lives in precompiled `core`, where the corresponding\n166\t/// `assert_unsafe_precondition!` is compiled out, so the store is emitted raw in\n167\t/// both profiles -- exactly like the C.\n168\t#[inline(always)]\n169\tunsafe fn raw_write<T>(p: *mut T, v: T) {\n170\t    ptr::write(p, v);\n171\t}\n172\t\n173\t/// `stbds_header(t)` -- `((stbds_array_header *) (t) - 1)`\n174\t#[inline(always)]\n175\tfn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n176\t    ((t as usize).wrapping_sub(HEADER_SIZE)) as *mut stbds_array_header\n177\t}\n178\t\n179\t/// `stbds_arrlen(a)`\n180\t#[inline(always)]\n181\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n182\t    if !a.is_null() {\n183\t        (*stbds_header(a)).length as isize\n184\t    } else {\n185\t        0\n186\t    }\n187\t}\n188\t\n189\t/// `stbds_arrcap(a)`\n190\t#[inline(always)]\n191\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n192\t    if !a.is_null() {\n193\t        (*stbds_header(a)).capacity\n194\t    } else {\n195\t        0\n196\t    }\n197\t}\n198\t\n199\t/// `stbds_temp(t)` (read)\n200\t#[inline(always)]\n201\tunsafe fn stbds_temp(t: *mut c_void) -> isize {\n202\t    (*stbds_header(t)).temp\n203\t}\n204\t\n205\t/// `stbds_temp(t) = v`\n206\t#[inline(always)]\n207\tunsafe fn stbds_set_temp(t: *mut c_void, v: isize) {\n208\t    (*stbds_header(t)).temp = v;\n209\t}\n210\t\n211\t/// `stbds_temp_key(t) = v` -- `(*(char **) stbds_header(t)->hash_table) = v`\n212\t#[inline(always)]\n213\tunsafe fn stbds_set_temp_key(t: *mut c_void, v: *mut c_char) {\n214\t    let ht = (*stbds_header(t)).hash_table as *mut *mut c_char;\n215\t    *ht = v;\n216\t}\n217\t\n218\t/// `stbds_hash_table(a)` -- `((stbds_hash_index *) stbds_header(a)->hash_table)`\n219\t#[inline(always)]\n220\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n221\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n222\t}\n223\t\n224\t/// `STBDS_HASH_TO_ARR(x,elemsize)` -- `((char *) (x) - (elemsize))`\n225\t#[inline(always)]\n226\tfn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n227\t    ((x as usize).wrapping_sub(elemsize)) as *mut c_void\n228\t}\n229\t\n230\t/// `STBDS_ARR_TO_HASH(x,elemsize)` -- `((char *) (x) + (elemsize))`\n231\t#[inline(always)]\n232\tfn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n233\t    ((x as usize).wrapping_add(elemsize)) as *mut c_void\n234\t}\n235\t\n236\t/// `(char *) a + elemsize*i + keyoffset`\n237\t#[inline(always)]\n238\tfn elem_ptr(a: *mut c_void, elemsize: usize, i: usize, keyoffset: usize) -> *mut c_void {\n239\t    ((a as usize)\n240\t        .wrapping_add(elemsize.wrapping_mul(i))\n241\t        .wrapping_add(keyoffset)) as *mut c_void\n242\t}\n243\t\n244\t/// `STBDS_ALIGN_FWD(n,a)` -- `(((n) + (a) - 1) & ~((a)-1))`\n245\t#[inline(always)]\n246\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n247\t    n.wrapping_add(a - 1) & !(a - 1)\n248\t}\n249\t\n250\t/// `STBDS_INDEX_IN_USE(x)` -- `((x) >= 0)`\n251\t#[inline(always)]\n252\tfn stbds_index_in_use(x: isize) -> bool {\n253\t    x >= 0\n254\t}\n255\t\n256\tconst STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() as u32) * 8;\n257\t\n258\t/// `STBDS_ROTATE_LEFT(val, n)` -- `(((val) << (n)) | ((val) >> (BITS - (n))))`.\n259\t///\n260\t/// `wrapping_shl`/`wrapping_shr` are used so the behaviour is identical in the\n261\t/// `dev` and `release` profiles (C's `<<` on `size_t` never traps).\n262\t#[inline(always)]\n263\tfn stbds_rotate_left(val: usize, n: u32) -> usize {\n264\t    val.wrapping_shl(n) | val.wrapping_shr(STBDS_SIZE_T_BITS.wrapping_sub(n))\n265\t}\n266\t\n267\t#[inline(always)]\n268\tfn stbds_rotate_right(val: usize, n: u32) -> usize {\n269\t    val.wrapping_shr(n) | val.wrapping_shl(STBDS_SIZE_T_BITS.wrapping_sub(n))\n270\t}\n271\t\n272\t// ---------------------------------------------------------------------------\n273\t// stbds_arrgrowf / stbds_arrfreef\n274\t// ---------------------------------------------------------------------------\n275\t\n276\t#[unsafe(no_mangle)]\n277\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n278\t    a: *mut c_void,\n279\t    elemsize: usize,\n280\t    addlen: usize,\n281\t    min_cap: usize,\n282\t) -> *mut c_void {\n283\t    let mut min_cap = min_cap;\n284\t    let b: *mut c_void;\n285\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n286\t\n287\t    if min_len > min_cap {\n288\t        min_cap = min_len;\n289\t    }\n290\t\n291\t    if min_cap <= stbds_arrcap(a) {\n292\t        return a;\n293\t    }\n294\t\n295\t    if min_cap < stbds_arrcap(a).wrapping_mul(2) {\n296\t        min_cap = stbds_arrcap(a).wrapping_mul(2);\n297\t    } else if min_cap < 4 {\n298\t        min_cap = 4;\n299\t    }\n300\t\n301\t    let old: *mut c_void = if !a.is_null() {\n302\t        stbds_header(a) as *mut c_void\n303\t    } else {\n304\t        ptr::null_mut()\n305\t    };\n306\t    let raw = stbds_realloc(\n307\t        old,\n308\t        elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n309\t    );\n310\t    b = ((raw as usize).wrapping_add(HEADER_SIZE)) as *mut c_void;\n311\t    if a.is_null() {\n312\t        let h = stbds_header(b);\n313\t        raw_write(ptr::addr_of_mut!((*h).length), 0);\n314\t        raw_write(ptr::addr_of_mut!((*h).hash_table), ptr::null_mut());\n315\t        raw_write(ptr::addr_of_mut!((*h).temp), 0);\n316\t    }\n317\t    {\n318\t        let h = stbds_header(b);\n319\t        raw_write(ptr::addr_of_mut!((*h).capacity), min_cap);\n320\t    }\n321\t\n322\t    b\n323\t}\n324\t\n325\t#[unsafe(no_mangle)]\n326\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n327\t    stbds_free(stbds_header(a) as *mut c_void);\n328\t}\n329\t\n330\t// ---------------------------------------------------------------------------\n331\t// hash seed / hash index construction\n332\t// ---------------------------------------------------------------------------\n333\t\n334\tstatic mut stbds_hash_seed: usize = 0x31415926;\n335\t\n336\t#[unsafe(no_mangle)]\n337\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n338\t    stbds_hash_seed = seed;\n339\t}\n340\t\n341\t/// `stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)`\n342\t#[inline(always)]\n343\tfn stbds_load_32_or_64(v32: usize, v64_hi: usize, v64_lo: usize) -> usize {\n344\t    let mut temp: usize = v64_lo ^ v32;\n345\t    temp <<= 16;\n346\t    temp <<= 16;\n347\t    temp >>= 16;\n348\t    temp >>= 16;\n349\t    let mut var: usize = v64_hi;\n350\t    var <<= 16;\n351\t    var <<= 16;\n352\t    var ^= temp ^ v32;\n353\t    var\n354\t}\n355\t\n356\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n357\t    hash & (slot_count.wrapping_sub(1))\n358\t}\n359\t\n360\tfn stbds_log2(slot_count: usize) -> usize {\n361\t    let mut slot_count = slot_count;\n362\t    let mut n: usize = 0;\n363\t    while slot_count > 1 {\n364\t        slot_count >>= 1;\n365\t        n += 1;\n366\t    }\n367\t    n\n368\t}\n369\t\n370\tunsafe fn stbds_make_hash_index(\n371\t    slot_count: usize,\n372\t    ot: *mut stbds_hash_index,\n373\t) -> *mut stbds_hash_index {\n374\t    let t: *mut stbds_hash_index = stbds_realloc(\n375\t        ptr::null_mut(),\n376\t        (slot_count >> STBDS_BUCKET_SHIFT)\n377\t            .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n378\t            .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n379\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n380\t    ) as *mut stbds_hash_index;\n381\t\n382\t    raw_write(\n383\t        ptr::addr_of_mut!((*t).storage),\n384\t        stbds_align_fwd(\n385\t            (t as usize).wrapping_add(core::mem::size_of::<stbds_hash_index>()),\n386\t            STBDS_CACHE_LINE_SIZE,\n387\t        ) as *mut stbds_hash_bucket,\n388\t    );\n389\t    (*t).slot_count = slot_count;\n390\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n391\t    (*t).tombstone_count = 0;\n392\t    (*t).used_count = 0;\n393\t\n394\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n395\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n396\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n397\t\n398\t    if slot_count <= STBDS_BUCKET_LENGTH {\n399\t        (*t).used_count_shrink_threshold = 0;\n400\t    }\n401\t    stbds_assert!(\n402\t        (*t).used_count_threshold\n403\t            .wrapping_add((*t).tombstone_count_threshold)\n404\t            < (*t).slot_count,\n405\t        \"t->used_count_threshold + t->tombstone_count_threshold < t->slot_count\",\n406\t        401,\n407\t        \"stbds_make_hash_index\"\n408\t    );\n409\t\n410\t    if !ot.is_null() {\n411\t        (*t).string = (*ot).string;\n412\t        (*t).seed = (*ot).seed;\n413\t    } else {\n414\t        memset(\n415\t            ptr::addr_of_mut!((*t).string) as *mut c_void,\n416\t            0,\n417\t            core::mem::size_of::<stbds_string_arena>(),\n418\t        );\n419\t        (*t).seed = stbds_hash_seed;\n420\t        let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n421\t        let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n422\t        stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n423\t    }\n424\t\n425\t    {\n426\t        let mut i: usize = 0;\n427\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n428\t            let b: *mut stbds_hash_bucket = (*t).storage.add(i);\n429\t            let mut j: usize = 0;\n430\t            while j < STBDS_BUCKET_LENGTH {\n431\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n432\t                j += 1;\n433\t            }\n434\t            j = 0;\n435\t            while j < STBDS_BUCKET_LENGTH {\n436\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n437\t                j += 1;\n438\t            }\n439\t            i += 1;\n440\t        }\n441\t    }\n442\t\n443\t    if !ot.is_null() {\n444\t        (*t).used_count = (*ot).used_count;\n445\t        let mut i: usize = 0;\n446\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n447\t            let ob: *mut stbds_hash_bucket = (*ot).storage.add(i);\n448\t            let mut j: usize = 0;\n449\t            while j < STBDS_BUCKET_LENGTH {\n450\t                if stbds_index_in_use((*ob).index[j]) {\n451\t                    let hash = (*ob).hash[j];\n452\t                    let mut pos =\n453\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n454\t                    let mut step = STBDS_BUCKET_LENGTH;\n455\t                    'done: loop {\n456\t                        let bucket: *mut stbds_hash_bucket =\n457\t                            (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n458\t\n459\t                        let mut z = pos & STBDS_BUCKET_MASK;\n460\t                        while z < STBDS_BUCKET_LENGTH {\n461\t                            if (*bucket).hash[z] == 0 {\n462\t                                (*bucket).hash[z] = hash;\n463\t                                (*bucket).index[z] = (*ob).index[j];\n464\t                                break 'done;\n465\t                            }\n466\t                            z += 1;\n467\t                        }\n468\t\n469\t                        let limit = pos & STBDS_BUCKET_MASK;\n470\t                        z = 0;\n471\t                        let mut hit = false;\n472\t                        while z < limit {\n473\t                            if (*bucket).hash[z] == 0 {\n474\t                                (*bucket).hash[z] = hash;\n475\t                                (*bucket).index[z] = (*ob).index[j];\n476\t                                hit = true;\n477\t                                break;\n478\t                            }\n479\t                            z += 1;\n480\t                        }\n481\t                        if hit {\n482\t                            break 'done;\n483\t                        }\n484\t\n485\t                        pos = pos.wrapping_add(step);\n486\t                        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n487\t                        pos &= (*t).slot_count.wrapping_sub(1);\n488\t                    }\n489\t                }\n490\t                j += 1;\n491\t            }\n492\t            i += 1;\n493\t        }\n494\t    }\n495\t\n496\t    t\n497\t}\n498\t\n499\t// ---------------------------------------------------------------------------\n500\t// hash functions\n501\t// ---------------------------------------------------------------------------\n502\t\n503\t#[unsafe(no_mangle)]\n504\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n505\t    let mut hash: usize = seed;\n506\t    let mut s = str_ as *const u8;\n507\t    while *s != 0 {\n508\t        hash = stbds_rotate_left(hash, 9).wrapping_add(*s as usize);\n509\t        s = s.add(1);\n510\t    }\n511\t\n512\t    hash ^= seed;\n513\t    hash = (!hash).wrapping_add(hash << 18);\n514\t    hash ^= hash ^ stbds_rotate_right(hash, 31);\n515\t    hash = hash.wrapping_mul(21);\n516\t    hash ^= hash ^ stbds_rotate_right(hash, 11);\n517\t    hash = hash.wrapping_add(hash << 6);\n518\t    hash ^= stbds_rotate_right(hash, 22);\n519\t    hash.wrapping_add(seed)\n520\t}\n521\t\n522\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n523\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n524\t\n525\t/// Mirrors `d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24)` evaluated in\n526\t/// `int` arithmetic and then converted to `size_t` (i.e. sign-extended when\n527\t/// the top byte has its high bit set -- exactly what the C code does).\n528\t#[inline(always)]\n529\tunsafe fn load_int_le32_sign_extended(d: *const u8) -> usize {\n530\t    let v: u32 = (*d.add(0) as u32)\n531\t        | ((*d.add(1) as u32) << 8)\n532\t        | ((*d.add(2) as u32) << 16)\n533\t        | ((*d.add(3) as u32) << 24);\n534\t    (v as i32) as isize as usize\n535\t}\n536\t\n537\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n538\t    let mut d = p as *const u8;\n539\t    let mut i: usize;\n540\t    let mut j: usize;\n541\t    let mut v0: usize;\n542\t    let mut v1: usize;\n543\t    let mut v2: usize;\n544\t    let mut v3: usize;\n545\t    let mut data: usize;\n546\t\n547\t    v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n548\t    v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n549\t    v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n550\t    v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n551\t\n552\t    v0 ^= 0x0706050403020100u64 as usize ^ seed;\n553\t    v1 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n554\t    v2 ^= 0x0706050403020100u64 as usize ^ seed;\n555\t    v3 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n556\t\n557\t    macro_rules! sipround {\n558\t        () => {{\n559\t            v0 = v0.wrapping_add(v1);\n560\t            v1 = stbds_rotate_left(v1, 13);\n561\t            v1 ^= v0;\n562\t            v0 = stbds_rotate_left(v0, STBDS_SIZE_T_BITS / 2);\n563\t            v2 = v2.wrapping_add(v3);\n564\t            v3 = stbds_rotate_left(v3, 16);\n565\t            v3 ^= v2;\n566\t            v2 = v2.wrapping_add(v1);\n567\t            v1 = stbds_rotate_left(v1, 17);\n568\t            v1 ^= v2;\n569\t            v2 = stbds_rotate_left(v2, STBDS_SIZE_T_BITS / 2);\n570\t            v0 = v0.wrapping_add(v3);\n571\t            v3 = stbds_rotate_left(v3, 21);\n572\t            v3 ^= v0;\n573\t        }};\n574\t    }\n575\t\n576\t    i = 0;\n577\t    while i.wrapping_add(core::mem::size_of::<usize>()) <= len {\n578\t        // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n579\t        data = load_int_le32_sign_extended(d);\n580\t        // data |= (size_t) (d[4] | (d[5] << 8) | (d[6] << 16) | (d[7] << 24)) << 16 << 16;\n581\t        data |= (load_int_le32_sign_extended(d.add(4)) << 16) << 16;\n582\t\n583\t        v3 ^= data;\n584\t        j = 0;\n585\t        while j < STBDS_SIPHASH_C_ROUNDS {\n586\t            sipround!();\n587\t            j += 1;\n588\t        }\n589\t        v0 ^= data;\n590\t\n591\t        i = i.wrapping_add(core::mem::size_of::<usize>());\n592\t        d = d.add(core::mem::size_of::<usize>());\n593\t    }\n594\t\n595\t    data = len << (STBDS_SIZE_T_BITS - 8);\n596\t    let tail = len.wrapping_sub(i);\n597\t    // Fall-through switch from the C original.\n598\t    if tail >= 7 {\n599\t        data |= ((*d.add(6) as usize) << 24) << 24;\n600\t    }\n601\t    if tail >= 6 {\n602\t        data |= ((*d.add(5) as usize) << 20) << 20;\n603\t    }\n604\t    if tail >= 5 {\n605\t        data |= ((*d.add(4) as usize) << 16) << 16;\n606\t    }\n607\t    if tail >= 4 {\n608\t        // `data |= (d[3] << 24);` -- int arithmetic, hence sign extension.\n609\t        data |= (((*d.add(3) as u32) << 24) as i32) as isize as usize;\n610\t    }\n611\t    if tail >= 3 {\n612\t        data |= (*d.add(2) as usize) << 16;\n613\t    }\n614\t    if tail >= 2 {\n615\t        data |= (*d.add(1) as usize) << 8;\n616\t    }\n617\t    if tail >= 1 {\n618\t        data |= *d.add(0) as usize;\n619\t    }\n620\t\n621\t    v3 ^= data;\n622\t    j = 0;\n623\t    while j < STBDS_SIPHASH_C_ROUNDS {\n624\t        sipround!();\n625\t        j += 1;\n626\t    }\n627\t    v0 ^= data;\n628\t    v2 ^= 0xff;\n629\t    j = 0;\n630\t    while j < STBDS_SIPHASH_D_ROUNDS {\n631\t        sipround!();\n632\t        j += 1;\n633\t    }\n634\t\n635\t    v0 ^ v1 ^ v2 ^ v3\n636\t}\n637\t\n638\t#[unsafe(no_mangle)]\n639\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n640\t    stbds_siphash_bytes(p, len, seed)\n641\t}\n642\t\n643\t// ---------------------------------------------------------------------------\n644\t// hash map internals\n645\t// ---------------------------------------------------------------------------\n646\t\n647\tunsafe fn stbds_is_key_equal(\n648\t    a: *mut c_void,\n649\t    elemsize: usize,\n650\t    key: *mut c_void,\n651\t    keysize: usize,\n652\t    keyoffset: usize,\n653\t    mode: c_int,\n654\t    i: usize,\n655\t) -> c_int {\n656\t    if mode >= STBDS_HM_STRING {\n657\t        let stored = *(elem_ptr(a, elemsize, i, keyoffset) as *mut *mut c_char);\n658\t        (strcmp(key as *const c_char, stored) == 0) as c_int\n659\t    } else {\n660\t        (memcmp(\n661\t            key as *const c_void,\n662\t            elem_ptr(a, elemsize, i, keyoffset) as *const c_void,\n663\t            keysize,\n664\t        ) == 0) as c_int\n665\t    }\n666\t}\n667\t\n668\t#[unsafe(no_mangle)]\n669\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n670\t    if a.is_null() {\n671\t        return;\n672\t    }\n673\t    if !stbds_hash_table(a).is_null() {\n674\t        if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP as u8 {\n675\t            let mut i: usize = 1;\n676\t            while i < (*stbds_header(a)).length {\n677\t                stbds_free(*(elem_ptr(a, elemsize, i, 0) as *mut *mut c_char) as *mut c_void);\n678\t                i += 1;\n679\t            }\n680\t        }\n681\t        stbds_strreset(ptr::addr_of_mut!((*stbds_hash_table(a)).string));\n682\t    }\n683\t    stbds_free((*stbds_header(a)).hash_table);\n684\t    stbds_free(stbds_header(a) as *mut c_void);\n685\t}\n686\t\n687\tunsafe fn stbds_hm_find_slot(\n688\t    a: *mut c_void,\n689\t    elemsize: usize,\n690\t    key: *mut c_void,\n691\t    keysize: usize,\n692\t    keyoffset: usize,\n693\t    mode: c_int,\n694\t) -> isize {\n695\t    let raw_a = stbds_hash_to_arr(a, elemsize);\n696\t    let table = stbds_hash_table(raw_a);\n697\t    let mut hash = if mode >= STBDS_HM_STRING {\n698\t        stbds_hash_string(key as *mut c_char, (*table).seed)\n699\t    } else {\n700\t        stbds_hash_bytes(key, keysize, (*table).seed)\n701\t    };\n702\t    let mut step = STBDS_BUCKET_LENGTH;\n703\t    let mut limit: usize;\n704\t    let mut i: usize;\n705\t    let mut pos: usize;\n706\t    let mut bucket: *mut stbds_hash_bucket;\n707\t\n708\t    if hash < 2 {\n709\t        hash = hash.wrapping_add(2);\n710\t    }\n711\t\n712\t    pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n713\t\n714\t    loop {\n715\t        bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);\n716\t\n717\t        i = pos & STBDS_BUCKET_MASK;\n718\t        while i < STBDS_BUCKET_LENGTH {\n719\t            if (*bucket).hash[i] == hash {\n720\t                if stbds_is_key_equal(\n721\t                    a,\n722\t                    elemsize,\n723\t                    key,\n724\t                    keysize,\n725\t                    keyoffset,\n726\t                    mode,\n727\t                    (*bucket).index[i] as usize,\n728\t                ) != 0\n729\t                {\n730\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n731\t                }\n732\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n733\t                return -1;\n734\t            }\n735\t            i += 1;\n736\t        }\n737\t\n738\t        limit = pos & STBDS_BUCKET_MASK;\n739\t        i = 0;\n740\t        while i < limit {\n741\t            if (*bucket).hash[i] == hash {\n742\t                if stbds_is_key_equal(\n743\t                    a,\n744\t                    elemsize,\n745\t                    key,\n746\t                    keysize,\n747\t                    keyoffset,\n748\t                    mode,\n749\t                    (*bucket).index[i] as usize,\n750\t                ) != 0\n751\t                {\n752\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n753\t                }\n754\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n755\t                return -1;\n756\t            }\n757\t            i += 1;\n758\t        }\n759\t\n760\t        pos = pos.wrapping_add(step);\n761\t        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n762\t        pos &= (*table).slot_count.wrapping_sub(1);\n763\t    }\n764\t}\n765\t\n766\t#[unsafe(no_mangle)]\n767\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n768\t    a: *mut c_void,\n769\t    elemsize: usize,\n770\t    key: *mut c_void,\n771\t    keysize: usize,\n772\t    temp: *mut isize,\n773\t    mode: c_int,\n774\t) -> *mut c_void {\n775\t    let keyoffset: usize = 0;\n776\t    if a.is_null() {\n777\t        let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n778\t        (*stbds_header(a)).length = (*stbds_header(a)).length.wrapping_add(1);\n779\t        memset(a, 0, elemsize);\n780\t        *temp = STBDS_INDEX_EMPTY;\n781\t        stbds_arr_to_hash(a, elemsize)\n782\t    } else {\n783\t        let table: *mut stbds_hash_index;\n784\t        let raw_a = stbds_hash_to_arr(a, elemsize);\n785\t        table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n786\t        if table.is_null() {\n787\t            *temp = -1;\n788\t        } else {\n789\t            let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n790\t            if slot < 0 {\n791\t                *temp = STBDS_INDEX_EMPTY;\n792\t            } else {\n793\t                let b = (*table).storage.add((slot >> STBDS_BUCKET_SHIFT) as usize);\n794\t                *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n795\t            }\n796\t        }\n797\t        a\n798\t    }\n799\t}\n800\t\n801\t#[unsafe(no_mangle)]\n802\tpub unsafe extern \"C\" fn stbds_hmget_key(\n803\t    a: *mut c_void,\n804\t    elemsize: usize,\n805\t    key: *mut c_void,\n806\t    keysize: usize,\n807\t    mode: c_int,\n808\t) -> *mut c_void {\n809\t    let mut temp: isize = 0;\n810\t    let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &mut temp, mode);\n811\t    stbds_set_temp(stbds_hash_to_arr(p, elemsize), temp);\n812\t    p\n813\t}\n814\t\n815\t#[unsafe(no_mangle)]\n816\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n817\t    let mut a = a;\n818\t    if a.is_null() || (*stbds_header(stbds_hash_to_arr(a, elemsize))).length == 0 {\n819\t        a = stbds_arrgrowf(\n820\t            if !a.is_null() {\n821\t                stbds_hash_to_arr(a, elemsize)\n822\t            } else {\n823\t                ptr::null_mut()\n824\t            },\n825\t            elemsize,\n826\t            0,\n827\t            1,\n828\t        );\n829\t        (*stbds_header(a)).length = (*stbds_header(a)).length.wrapping_add(1);\n830\t        memset(a, 0, elemsize);\n831\t        a = stbds_arr_to_hash(a, elemsize);\n832\t    }\n833\t    a\n834\t}\n835\t\n836\tunsafe fn stbds_strdup(str_: *mut c_char) -> *mut c_char {\n837\t    let len = strlen(str_).wrapping_add(1);\n838\t    let p = stbds_realloc(ptr::null_mut(), len) as *mut c_char;\n839\t    memmove(p as *mut c_void, str_ as *const c_void, len);\n840\t    p\n841\t}\n842\t\n843\t#[unsafe(no_mangle)]\n844\tpub unsafe extern \"C\" fn stbds_hmput_key(\n845\t    a: *mut c_void,\n846\t    elemsize: usize,\n847\t    key: *mut c_void,\n848\t    keysize: usize,\n849\t    mode: c_int,\n850\t) -> *mut c_void {\n851\t    let mut a = a;\n852\t    let keyoffset: usize = 0;\n853\t    let mut raw_a: *mut c_void;\n854\t    let mut table: *mut stbds_hash_index;\n855