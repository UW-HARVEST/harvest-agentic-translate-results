 usize) << 16) << 16;\n537\t    }\n538\t    if tail >= 4 {\n539\t        // `data |= (d[3] << 24);` -- int arithmetic, hence sign extension.\n540\t        data |= (((*d.add(3) as u32) << 24) as i32) as isize as usize;\n541\t    }\n542\t    if tail >= 3 {\n543\t        data |= (*d.add(2) as usize) << 16;\n544\t    }\n545\t    if tail >= 2 {\n546\t        data |= (*d.add(1) as usize) << 8;\n547\t    }\n548\t    if tail >= 1 {\n549\t        data |= *d.add(0) as usize;\n550\t    }\n551\t\n552\t    v3 ^= data;\n553\t    j = 0;\n554\t    while j < STBDS_SIPHASH_C_ROUNDS {\n555\t        sipround!();\n556\t        j += 1;\n557\t    }\n558\t    v0 ^= data;\n559\t    v2 ^= 0xff;\n560\t    j = 0;\n561\t    while j < STBDS_SIPHASH_D_ROUNDS {\n562\t        sipround!();\n563\t        j += 1;\n564\t    }\n565\t\n566\t    v0 ^ v1 ^ v2 ^ v3\n567\t}\n568\t\n569\t#[unsafe(no_mangle)]\n570\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n571\t    stbds_siphash_bytes(p, len, seed)\n572\t}\n573\t\n574\t// ---------------------------------------------------------------------------\n575\t// hash map internals\n576\t// ---------------------------------------------------------------------------\n577\t\n578\tunsafe fn stbds_is_key_equal(\n579\t    a: *mut c_void,\n580\t    elemsize: usize,\n581\t    key: *mut c_void,\n582\t    keysize: usize,\n583\t    keyoffset: usize,\n584\t    mode: c_int,\n585\t    i: usize,\n586\t) -> c_int {\n587\t    if mode >= STBDS_HM_STRING {\n588\t        let stored = *(elem_ptr(a, elemsize, i, keyoffset) as *mut *mut c_char);\n589\t        (strcmp(key as *const c_char, stored) == 0) as c_int\n590\t    } else {\n591\t        (memcmp(\n592\t            key as *const c_void,\n593\t            elem_ptr(a, elemsize, i, keyoffset) as *const c_void,\n594\t            keysize,\n595\t        ) == 0) as c_int\n596\t    }\n597\t}\n598\t\n599\t#[unsafe(no_mangle)]\n600\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n601\t    if a.is_null() {\n602\t        return;\n603\t    }\n604\t    if !stbds_hash_table(a).is_null() {\n605\t        if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP as u8 {\n606\t            let mut i: usize = 1;\n607\t            while i < (*stbds_header(a)).length {\n608\t                stbds_free(*(elem_ptr(a, elemsize, i, 0) as *mut *mut c_char) as *mut c_void);\n609\t                i += 1;\n610\t            }\n611\t        }\n612\t        stbds_strreset(ptr::addr_of_mut!((*stbds_hash_table(a)).string));\n613\t    }\n614\t    stbds_free((*stbds_header(a)).hash_table);\n615\t    stbds_free(stbds_header(a) as *mut c_void);\n616\t}\n617\t\n618\tunsafe fn stbds_hm_find_slot(\n619\t    a: *mut c_void,\n620\t    elemsize: usize,\n621\t    key: *mut c_void,\n622\t    keysize: usize,\n623\t    keyoffset: usize,\n624\t    mode: c_int,\n625\t) -> isize {\n626\t    let raw_a = stbds_hash_to_arr(a, elemsize);\n627\t    let table = stbds_hash_table(raw_a);\n628\t    let mut hash = if mode >= STBDS_HM_STRING {\n629\t        stbds_hash_string(key as *mut c_char, (*table).seed)\n630\t    } else {\n631\t        stbds_hash_bytes(key, keysize, (*table).seed)\n632\t    };\n633\t    let mut step = STBDS_BUCKET_LENGTH;\n634\t    let mut limit: usize;\n635\t    let mut i: usize;\n636\t    let mut pos: usize;\n637\t    let mut bucket: *mut stbds_hash_bucket;\n638\t\n639\t    if hash < 2 {\n640\t        hash = hash.wrapping_add(2);\n641\t    }\n642\t\n643\t    pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n644\t\n645\t    loop {\n646\t        bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);\n647\t\n648\t        i = pos & STBDS_BUCKET_MASK;\n649\t        while i < STBDS_BUCKET_LENGTH {\n650\t            if (*bucket).hash[i] == hash {\n651\t                if stbds_is_key_equal(\n652\t                    a,\n653\t                    elemsize,\n654\t                    key,\n655\t                    keysize,\n656\t                    keyoffset,\n657\t                    mode,\n658\t                    (*bucket).index[i] as usize,\n659\t                ) != 0\n660\t                {\n661\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n662\t                }\n663\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n664\t                return -1;\n665\t            }\n666\t            i += 1;\n667\t        }\n668\t\n669\t        limit = pos & STBDS_BUCKET_MASK;\n670\t        i = 0;\n671\t        while i < limit {\n672\t            if (*bucket).hash[i] == hash {\n673\t                if stbds_is_key_equal(\n674\t                    a,\n675\t                    elemsize,\n676\t                    key,\n677\t                    keysize,\n678\t                    keyoffset,\n679\t                    mode,\n680\t                    (*bucket).index[i] as usize,\n681\t                ) != 0\n682\t                {\n683\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n684\t                }\n685\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n686\t                return -1;\n687\t            }\n688\t            i += 1;\n689\t        }\n690\t\n691\t        pos = pos.wrapping_add(step);\n692\t        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n693\t        pos &= (*table).slot_count.wrapping_sub(1);\n694\t    }\n695\t}\n696\t\n697\t#[unsafe(no_mangle)]\n698\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n699\t    a: *mut c_void,\n700\t    elemsize: usize,\n701\t    key: *mut c_void,\n702\t    keysize: usize,\n703\t    temp: *mut isize,\n704\t    mode: c_int,\n705\t) -> *mut c_void {\n706\t    let keyoffset: usize = 0;\n707\t    if a.is_null() {\n708\t        let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n709\t        (*stbds_header(a)).length += 1;\n710\t        memset(a, 0, elemsize);\n711\t        *temp = STBDS_INDEX_EMPTY;\n712\t        stbds_arr_to_hash(a, elemsize)\n713\t    } else {\n714\t        let table: *mut stbds_hash_index;\n715\t        let raw_a = stbds_hash_to_arr(a, elemsize);\n716\t        table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n717\t        if table.is_null() {\n718\t            *temp = -1;\n719\t        } else {\n720\t            let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n721\t            if slot < 0 {\n722\t                *temp = STBDS_INDEX_EMPTY;\n723\t            } else {\n724\t                let b = (*table).storage.add((slot >> STBDS_BUCKET_SHIFT) as usize);\n725\t                *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n726\t            }\n727\t        }\n728\t        a\n729\t    }\n730\t}\n731\t\n732\t#[unsafe(no_mangle)]\n733\tpub unsafe extern \"C\" fn stbds_hmget_key(\n734\t    a: *mut c_void,\n735\t    elemsize: usize,\n736\t    key: *mut c_void,\n737\t    keysize: usize,\n738\t    mode: c_int,\n739\t) -> *mut c_void {\n740\t    let mut temp: isize = 0;\n741\t    let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &mut temp, mode);\n742\t    stbds_set_temp(stbds_hash_to_arr(p, elemsize), temp);\n743\t    p\n744\t}\n745\t\n746\t#[unsafe(no_mangle)]\n747\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n748\t    let mut a = a;\n749\t    if a.is_null() || (*stbds_header(stbds_hash_to_arr(a, elemsize))).length == 0 {\n750\t        a = stbds_arrgrowf(\n751\t            if !a.is_null() {\n752\t                stbds_hash_to_arr(a, elemsize)\n753\t            } else {\n754\t                ptr::null_mut()\n755\t            },\n756\t            elemsize,\n757\t            0,\n758\t            1,\n759\t        );\n760\t        (*stbds_header(a)).length += 1;\n761\t        memset(a, 0, elemsize);\n762\t        a = stbds_arr_to_hash(a, elemsize);\n763\t    }\n764\t    a\n765\t}\n766\t\n767\tunsafe fn stbds_strdup(str_: *mut c_char) -> *mut c_char {\n768\t    let len = strlen(str_) + 1;