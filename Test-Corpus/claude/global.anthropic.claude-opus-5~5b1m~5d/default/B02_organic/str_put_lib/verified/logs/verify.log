{\n342\t        (*t).string = (*ot).string;\n343\t        (*t).seed = (*ot).seed;\n344\t    } else {\n345\t        memset(\n346\t            ptr::addr_of_mut!((*t).string) as *mut c_void,\n347\t            0,\n348\t            core::mem::size_of::<stbds_string_arena>(),\n349\t        );\n350\t        (*t).seed = stbds_hash_seed;\n351\t        let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n352\t        let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n353\t        stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n354\t    }\n355\t\n356\t    {\n357\t        let mut i: usize = 0;\n358\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n359\t            let b: *mut stbds_hash_bucket = (*t).storage.add(i);\n360\t            let mut j: usize = 0;\n361\t            while j < STBDS_BUCKET_LENGTH {\n362\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n363\t                j += 1;\n364\t            }\n365\t            j = 0;\n366\t            while j < STBDS_BUCKET_LENGTH {\n367\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n368\t                j += 1;\n369\t            }\n370\t            i += 1;\n371\t        }\n372\t    }\n373\t\n374\t    if !ot.is_null() {\n375\t        (*t).used_count = (*ot).used_count;\n376\t        let mut i: usize = 0;\n377\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n378\t            let ob: *mut stbds_hash_bucket = (*ot).storage.add(i);\n379\t            let mut j: usize = 0;\n380\t            while j < STBDS_BUCKET_LENGTH {\n381\t                if stbds_index_in_use((*ob).index[j]) {\n382\t                    let hash = (*ob).hash[j];\n383\t                    let mut pos =\n384\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n385\t                    let mut step = STBDS_BUCKET_LENGTH;\n386\t                    'done: loop {\n387\t                        let bucket: *mut stbds_hash_bucket =\n388\t                            (*t).sto