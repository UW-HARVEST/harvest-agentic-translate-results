{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014ghph1xQQPa4mwUL4yRZSo","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (an inlined copy of stb_ds.h\n2\t//! plus the `strkey` / `str_put` driver code from `src/lib.c`).\n3\t//!\n4\t//! The translation is deliberately literal: every quirk of the original C\n5\t//! (including implicit `int` sign-extension in the SipHash byte loading, the\n6\t//! missing `temp_key` update in the wrap-around branch of `stbds_hmput_key`,\n7\t//! and the `printf(\"%s %d\\n\", struct_by_value, ...)` call in `str_put`) is\n8\t//! reproduced bit for bit.\n9\t//!\n10\t//! All heap memory is managed through libc `realloc`/`free` so that pointers\n11\t//! handed out by / passed into this library remain interchangeable with the\n12\t//! ones from the original C implementation.\n13\t\n14\t#![allow(non_camel_case_types)]\n15\t#![allow(non_upper_case_globals)]\n16\t#![allow(unused_assignments)]\n17\t\n18\tuse core::ffi::{c_char, c_int, c_uint, c_void};\n19\tuse core::ptr;\n20\t\n21\t// ---------------------------------------------------------------------------\n22\t// libc bindings (STBDS_REALLOC / STBDS_FREE and the string/stdio helpers)\n23\t// ---------------------------------------------------------------------------\n24\t\n25\textern \"C\" {\n26\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n27\t    fn free(p: *mut c_void);\n28\t    fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n29\t    fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n30\t    fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n31\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n32\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n33\t    fn strlen(s: *const c_char) -> usize;\n34\t    fn printf(fmt: *const c_char, ...) -> c_int;\n35\t    fn sprintf(buf: *mut c_char, fmt: *const c_char, ...) -> c_int;\n36\t    /// glibc's `assert` backend. `c_src/src/lib.c` is compiled *without*\n37\t    /// `-DNDEBUG` (`nm -D` lists `__assert_fail` among its imports), so every\n38\t    /// `STBDS_ASSERT` is a live check that prints a diagnostic and raises\n39\t    /// `SIGABRT`. Calling the very same libc entry point reproduces both the\n40\t    /// message and the termination signal exactly.\n41\t    fn __assert_fail(\n42\t        assertion: *const c_char,\n43\t        file: *const c_char,\n44\t        line: c_uint,\n45\t        function: *const c_char,\n46\t    ) -> !;\n47\t}\n48\t\n49\t/// `__FILE__` of the original translation unit (see `build.rs`).\n50\tconst STBDS_C_FILE: &str = concat!(env!(\"STBDS_C_SOURCE_FILE\"), \"\\0\");\n51\t\n52\t/// `#define STBDS_ASSERT assert`\n53\t///\n54\t/// Reproduces the C `assert` macro: on failure the same glibc `__assert_fail`\n55\t/// is invoked with the identical expression text, source line and function name.\n56\tmacro_rules! stbds_assert {\n57\t    ($cond:expr, $expr_text:literal, $line:literal, $func:literal) => {\n58\t        if !($cond) {\n59\t            unsafe {\n60\t                __assert_fail(\n61\t                    concat!($expr_text, \"\\0\").as_ptr() as *const c_char,\n62\t                    STBDS_C_FILE.as_ptr() as *const c_char,\n63\t                    $line,\n64\t                    concat!($func, \"\\0\").as_ptr() as *const c_char,\n65\t                );\n66\t            }\n67\t        }\n68\t    };\n69\t}\n70\t\n71\t#[inline(always)]\n72\tunsafe fn stbds_realloc(p: *mut c_void, size: usize) -> *mut c_void {\n73\t    realloc(p, size)\n74\t}\n75\t\n76\t#[inline(always)]\n77\tunsafe fn stbds_free(p: *mut c_void) {\n78\t    free(p)\n79\t}\n80\t\n81\t// ---------------------------------------------------------------------------\n82\t// Types\n83\t// ---------------------------------------------------------------------------\n84\t\n85\t#[repr(C)]\n86\t#[derive(Clone, Copy)]\n87\tstruct stbds_array_header {\n88\t    length