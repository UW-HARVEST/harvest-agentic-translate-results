c_void,\n225\t    elemsize: usize,\n226\t    addlen: usize,\n227\t    min_cap: usize,\n228\t) -> *mut c_void {\n229\t    let mut min_cap = min_cap;\n230\t    let b: *mut c_void;\n231\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n232\t\n233\t    if min_len > min_cap {\n234\t        min_cap = min_len;\n235\t    }\n236\t\n237\t    if min_cap <= stbds_arrcap(a) {\n238\t        return a;\n239\t    }\n240\t\n241\t    if min_cap < stbds_arrcap(a).wrapping_mul(2) {\n242\t        min_cap = stbds_arrcap(a).wrapping_mul(2);\n243\t    } else if min_cap < 4 {\n244\t        min_cap = 4;\n245\t    }\n246\t\n247\t    let old: *mut c_void = if !a.is_null() {\n248\t        stbds_header(a) as *mut c_void\n249\t    } else {\n250\t        ptr::null_mut()\n251\t    };\n252\t    let raw = stbds_realloc(\n253\t        old,\n254\t        elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n255\t    );\n256\t    b = ((raw as usize).wrapping_add(HEADER_SIZE)) as *mut c_void;\n257\t    if a.is_null() {\n258\t        (*stbds_header(b)).length = 0;\n259\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n260\t        (*stbds_header(b)).temp = 0;\n261\t    }\n262\t    (*stbds_header(b)).capacity = min_cap;\n263\t\n264\t    b\n265\t}\n266\t\n267\t#[unsafe(no_mangle)]\n268\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n269\t    stbds_free(stbds_header(a) as *mut c_void);\n270\t}\n271\t\n272\t// ---------------------------------------------------------------------------\n273\t// hash seed / hash index construction\n274\t// ---------------------------------------------------------------------------\n275\t\n276\tstatic mut stbds_hash_seed: usize = 0x31415926;\n277\t\n278\t#[unsafe(no_mangle)]\n279\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n280\t    stbds_hash_seed = seed;\n281\t}\n282\t\n283\t/// `stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)`\n284\t#[inline(always)]\n285\tfn stbds_load_32_or_64(v32: usize, v64_hi: usize,