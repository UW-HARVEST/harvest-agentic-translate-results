, addr: &[u32; 8]) {\n70\t        let mut sha2_state = [0u8; 40];\n71\t        sha2_state.copy_from_slice(&ctx.state_seeded);\n72\t        let mut buf = vec![0u8; SPX_SHA256_ADDR_BYTES + SPX_N];\n73\t        let mut outbuf = [0u8; SPX_SHA256_OUTPUT_BYTES];\n74\t        let addr_bytes: &[u8; 32] = unsafe { &*(addr as *const [u32; 8] as *const [u8; 32]) };\n75\t        buf[..SPX_SHA256_ADDR_BYTES].copy_from_slice(&addr_bytes[..SPX_SHA256_ADDR_BYTES]);\n76\t        buf[SPX_SHA256_ADDR_BYTES..].copy_from_slice(&ctx.sk_seed);\n77\t        sha256_inc_finalize(&mut outbuf, &mut sha2_state, &buf, SPX_SHA256_ADDR_BYTES + SPX_N);\n78\t        out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n79\t    }\n80\t\n81\t    pub fn gen_message_random(\n82\t        r: &mut [u8],\n83\t        sk_prf: &[u8],\n84\t        optrand: &[u8],\n85\t        m: &[u8],\n86\t        mut mlen: u64,\n87\t        _ctx: &SpxCtx,\n88\t    ) {\n89\t        let mut buf = vec![0u8; SPX_SHAX_BLOCK_BYTES + SPX_SHAX_OUTPUT_BYTES];\n90\t        let mut state = vec![0u8; STATE_LEN];\n91\t\n92\t        for i in 0..SPX_N {\n93\t            buf[i] = 0x36 ^ sk_prf[i];\n94\t        }\n95\t        for i in SPX_N..SPX_SHAX_BLOCK_BYTES {\n96\t            buf[i] = 0x36;\n97\t        }\n98\t\n99\t        shax_inc_init(&mut state);\n100\t        let buf_block = buf[..SPX_SHAX_BLOCK_BYTES].to_vec();\n101\t        shax_inc_blocks(&mut state, &buf_block, 1);\n102\t\n103\t        buf[..SPX_N].copy_from_slice(&optrand[..SPX_N]);\n104\t\n105\t        let mut m_pos = 0usize;\n106\t        if (SPX_N as u64) + mlen < SPX_SHAX_BLOCK_BYTES as u64 {\n107\t            buf[SPX_N..SPX_N + mlen as usize].copy_from_slice(&m[..mlen as usize]);\n108\t            let buf_finalize_in = buf[..SPX_N + mlen as usize].to_vec();\n109\t            shax_inc_finalize(&mut buf[SPX_SHAX_BLOCK_BYTES..], &mut state, &buf_finalize_in, mlen as usize + SPX_N);\n110\t        } else {\n111\t            let take = SPX_SHAX_BLOCK_BYTES - SPX_N;\n112\t            buf[SPX_N..SPX_SHAX_BLOCK_BYTES].copy_from_slice(&m[..take]);\n113\t            let buf_block = buf[..SPX_SHAX_BLOCK_BYTES].to_vec();\n114\t            shax_inc_blocks(&mut state, &buf_block, 1);\n115\t\n116\t            m_pos += take;\n117\t            mlen -= take as u64;\n118\t            shax_inc_finalize(&mut buf[SPX_SHAX_BLOCK_BYTES..], &mut state, &m[m_pos..m_pos + mlen as usize], mlen as usize);\n119\t        }\n120\t\n121\t        for i in 0..SPX_N {\n122\t            buf[i] = 0x5c ^ sk_prf[i];\n123\t        }\n124\t        for i in SPX_N..SPX_SHAX_BLOCK_BYTES {\n125\t            buf[i] = 0x5c;\n126\t        }\n127\t\n128\t        let buf_copy = buf.clone();\n129\t        shax(&mut buf, &buf_copy);\n130\t        r[..SPX_N].copy_from_slice(&buf[..SPX_N]);\n131\t    }\n132\t\n133\t    pub fn hash_message(\n134\t        digest: &mut [u8],\n135\t        tree: &mut u64,\n136\t        leaf_idx: &mut u32,\n137\t        r: &[u8],\n138\t        pk: &[u8],\n139\t        m: &[u8],\n140\t        mut mlen: u64,\n141\t        _ctx: &SpxCtx,\n142\t    ) {\n143\t        const SPX_TREE_BITS: usize = SPX_TREE_HEIGHT * (SPX_D - 1);\n144\t        const SPX_TREE_BYTES: usize = (SPX_TREE_BITS + 7) / 8;\n145\t        const SPX_LEAF_BITS: usize = SPX_TREE_HEIGHT;\n146\t        const SPX_LEAF_BYTES: usize = (SPX_LEAF_BITS + 7) / 8;\n147\t        const SPX_DGST_BYTES: usize = SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES;\n148\t\n149\t        let mut seed = vec![0u8; 2 * SPX_N + SPX_SHAX_OUTPUT_BYTES];\n150\t\n151\t        // SPX_INBLOCKS = ceil((SPX_N + SPX_PK_BYTES) / SPX_SHAX_BLOCK_BYTES)\n152\t        let inblocks = (SPX_N + SPX_PK_BYTES + SPX_SHAX_BLOCK_BYTES - 1) / SPX_SHAX_BLOCK_BYTES;\n153\t        let mut inbuf = vec![0u8; inblocks * SPX_SHAX_BLOCK_BYTES];\n154\t\n155\t        let mut buf = vec![0u8; SPX_DGST_BYTES];\n156\t        let mut state = vec![0u8; STATE_LEN];\n157\t        shax_inc_init(&mut state);\n158\t\n159\t        inbuf[..SPX_N].copy_from_slice(&r[..SPX_N]);\n160\t        inbuf[SPX_N..SPX_N + SPX_PK_BYTES].copy_from_slice(&pk[..SPX_PK_BYTES]);\n161\t\n162\t        let mut m_pos = 0usize;\n163\t        if (SPX_N + SPX_PK_BYTES) as u64 + mlen < (inblocks * SPX_SHAX_BLOCK_BYTES) as u64 {\n164\t            inbuf[SPX_N + SPX_PK_BYTES..SPX_N + SPX_PK_BYTES + mlen as usize]\n165\t                .copy_from_slice(&m[..mlen as usize]);\n166\t            shax_inc_finalize(&mut seed[2 * SPX_N..], &mut state, &inbuf, SPX_N + SPX_PK_BYTES + mlen as usize);\n167\t        } else {\n168\t            let take = inblocks * SPX_SHAX_BLOCK_BYTES - SPX_N - SPX_PK_BYTES;\n169\t            inbuf[SPX_N + SPX_PK_BYTES..].copy_from_slice(&m[..take]);\n170\t            shax_inc_blocks(&mut state, &inbuf, inblocks);\n171\t            m_pos += take;\n172\t            mlen -= take as u64;\n173\t            shax_inc_finalize(&mut seed[2 * SPX_N..], &mut state, &m[m_pos..m_pos + mlen as usize], mlen as usize);\n174\t        }\n175\t\n176\t        seed[..SPX_N].copy_from_slice(&r[..SPX_N]);\n177\t        seed[SPX_N..2 * SPX_N].copy_from_slice(&pk[..SPX_N]);\n178\t\n179\t        mgf1_x(&mut buf, SPX_DGST_BYTES, &seed, 2 * SPX_N + SPX_SHAX_OUTPUT_BYTES);\n180\t\n181\t        digest[..SPX_FORS_MSG_BYTES].copy_from_slice(&buf[..SPX_FORS_MSG_BYTES]);\n182\t        let mut bufp = SPX_FORS_MSG_BYTES;\n183\t\n184\t        if SPX_D == 1 {\n185\t            *tree = 0;\n186\t        } else {\n187\t            *tree = crate::utils::bytes_to_ull(&buf[bufp..], SPX_TREE_BYTES);\n188\t            *tree &= u64::MAX >> (64 - SPX_TREE_BITS);\n189\t        }\n190\t        bufp += SPX_TREE_BYTES;\n191\t\n192\t        *leaf_idx = crate::utils::bytes_to_ull(&buf[bufp..], SPX_LEAF_BYTES) as u32;\n193\t        *leaf_idx &= u32::MAX >> (32 - SPX_LEAF_BITS);\n194\t    }\n195\t}\n196\t\n197\t#[cfg(feature = \"shake\")]\n198\tmod backend {\n199\t    use super::*;\n200\t    use crate::fips202::*;\n201\t\n202\t    pub fn initialize_hash_function(_ctx: &mut SpxCtx) {}\n203\t\n204\t    pub fn prf_addr(out: &mut [u8], ctx: &SpxCtx, addr: &[u32; 8]) {\n205\t        let mut buf = vec![0u8; 2 * SPX_N + SPX_ADDR_BYTES];\n206\t        buf[..SPX_N].copy_from_slice(&ctx.pub_seed);\n207\t        let addr_bytes: &[u8; 32] = unsafe { &*(addr as *const [u32; 8] as *const [u8; 32]) };\n208\t        buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(&addr_bytes[..SPX_ADDR_BYTES]);\n209\t        buf[SPX_N + SPX_ADDR_BYTES..].copy_from_slice(&ctx.sk_seed);\n210\t        let buf_copy = buf.clone();\n211\t        shake256(out, SPX_N, &buf_copy, 2 * SPX_N + SPX_ADDR_BYTES);\n212\t    }\n213\t\n214\t    pub fn gen_message_random(r: &mut [u8], sk_prf: &[u8], optrand: &[u8], m: &[u8], mlen: u64, _ctx: &SpxCtx) {\n215\t        let mut s_inc = [0u64; 26];\n216\t        shake256_inc_init(&mut s_inc);\n217\t        shake256_inc_absorb(&mut s_inc, sk_prf, SPX_N);\n218\t        shake256_inc_absorb(&mut s_inc, optrand, SPX_N);\n219\t        shake256_inc_absorb(&mut s_inc, m, mlen as usize);\n220\t        shake256_inc_finalize(&mut s_inc);\n221\t        shake256_inc_squeeze(r, SPX_N, &mut s_inc);\n222\t    }\n223\t\n224\t    pub fn hash_message(\n225\t        digest: &mut [u8],\n226\t        tree: &mut u64,\n227\t        leaf_idx: &mut u32,\n228\t        r: &[u8],\n229\t        pk: &[u8],\n230\t        m: &[u8],\n231\t        mlen: u64,\n232\t        _ctx: &SpxCtx,\n233\t    ) {\n234\t        const SPX_TREE_BITS: usize = SPX_TREE_HEIGHT * (SPX_D - 1);\n235\t        const SPX_TREE_BYTES: usize = (SPX_TREE_BITS + 7) / 8;\n236\t        const SPX_LEAF_BITS: usize = SPX_TREE_HEIGHT;\n237\t        const SPX_LEAF_BYTES: usize = (SPX_LEAF_BITS + 7) / 8;\n238\t        const SPX_DGST_BYTES: usize = SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES;\n239\t\n240\t        let mut buf = vec![0u8; SPX_DGST_BYTES];\n241\t        let mut s_inc = [0u64; 26];\n242\t\n243\t        shake256_inc_init(&mut s_inc);\n244\t        shake256_inc_absorb(&mut s_inc, r, SPX_N);\n245\t        shake256_inc_absorb(&mut s_inc, pk, SPX_PK_BYTES);\n246\t        shake256_inc_absorb(&mut s_inc, m, mlen as usize);\n247\t        shake256_inc_finalize(&mut s_inc);\n248\t        shake256_inc_squeeze(&mut buf, SPX_DGST_BYTES, &mut s_inc);\n249\t\n250\t        digest[..SPX_FORS_MSG_BYTES].copy_from_slice(&buf[..SPX_FORS_MSG_BYTES]);\n251\t        let mut bufp = SPX_FORS_MSG_BYTES;\n252\t\n253\t        if SPX_D == 1 {\n254\t            *tree = 0;\n255\t        } else {\n256\t            *tree = crate::utils::bytes_to_ull(&buf[bufp..], SPX_TREE_BYTES);\n257\t            *tree &= u64::MAX >> (64 - SPX_TREE_BITS);\n258\t        }\n259\t        bufp += SPX_TREE_BYTES;\n260\t\n261\t        *leaf_idx = crate::utils::bytes_to_ull(&buf[bufp..], SPX_LEAF_BYTES) as u32;\n262\t        *leaf_idx &= u32::MAX >> (32 - SPX_LEAF_BITS);\n263\t    }\n264\t}\n265\t\n266\t#[cfg(feature = \"blake\")]\n267\tmod backend {\n268\t    use super::*;\n269\t    use crate::blake::*;\n270\t\n271\t    pub fn initialize_hash_function(_ctx: &mut SpxCtx) {}\n272\t\n273\t    pub fn prf_addr(out: &mut [u8], ctx: &SpxCtx, addr: &[u32; 8]) {\n274\t        let mut buf = vec![0u8; 2 * SPX_N + SPX_ADDR_BYTES];\n275\t        let mut outbuf = [0u8; SPX_BLAKE256_OUTPUT_BYTES];\n276\t        buf[..SPX_N].copy_from_slice(&ctx.pub_seed);\n277\t        let addr_bytes: &[u8; 32] = unsafe { &*(addr as *const [u32; 8] as *const [u8; 32]) };\n278\t        buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(&addr_bytes[..SPX_ADDR_BYTES]);\n279\t        buf[SPX_N + SPX_ADDR_BYTES..].copy_from_slice(&ctx.sk_seed);\n280\t        // C calls blake256(outbuf, buf, SPX_N + SPX_ADDR_BYTES) — so it does NOT\n281\t        // include the appended sk_seed in the digest input length.\n282\t        blake256(&mut outbuf, &buf, (SPX_N + SPX_ADDR_BYTES) as u64);\n283\t        out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n284\t    }\n285\t\n286\t    // NOTE: The reference C code passes byte counts to blake*_update, but\n287\t    // blake*_update interprets its `datalen` argument as a BIT count. We\n288\t    // faithfully reproduce that behavior for byte-identical output.\n289\t    #[cfg(any(feature = \"192s\", feature = \"192f\", feature = \"256s\", feature = \"256f\"))]\n290\t    pub fn gen_message_random(r: &mut [u8], sk_prf: &[u8], optrand: &[u8], m: &[u8], mlen: u64, _ctx: &SpxCtx) {\n291\t        let mut s = Blakestate512::new();\n292\t        blake512_init(&mut s);\n293\t        blake512_update(&mut s, sk_prf, SPX_N as u64);\n294\t        blake512_update(&mut s, optrand, SPX_N as u64);\n295\t        blake512_update(&mut s, m, mlen);\n296\t        let mut digest = [0u8; 64];\n297\t        blake512_final(&mut s, &mut digest);\n298\t        r[..SPX_N].copy_from_slice(&digest[..SPX_N]);\n299\t    }\n300\t    #[cfg(any(feature = \"128s\", feature = \"128f\"))]\n301\t    pub fn gen_message_random(r: &mut [u8], sk_prf: &[u8], optrand: &[u8], m: &[u8], mlen: u64, _ctx: &SpxCtx) {\n302\t        let mut s = Blakestate256::new();\n303\t        blake256_init(&mut s);\n304\t        blake256_update(&mut s, sk_prf, SPX_N as u64);\n305\t        blake256_update(&mut s, optrand, SPX_N as u64);\n306\t        blake256_update(&mut s, m, mlen);\n307\t        let mut digest = [0u8; 32];\n308\t        blake256_final(&mut s, &mut digest);\n309\t        r[..SPX_N].copy_from_slice(&digest[..SPX_N]);\n310\t    }\n311\t\n312\t    #[cfg(any(feature = \"192s\", feature = \"192f\", feature = \"256s\", feature = \"256f\"))]\n313\t    const BLAKEX_OUTPUT_BYTES: usize = SPX_BLAKE512_OUTPUT_BYTES;\n314\t    #[cfg(any(feature = \"128s\", feature = \"128f\"))]\n315\t    const BLAKEX_OUTPUT_BYTES: usize = SPX_BLAKE256_OUTPUT_BYTES;\n316\t\n317\t    pub fn hash_message(\n318\t        digest: &mut [u8],\n319\t        tree: &mut u64,\n320\t        leaf_idx: &mut u32,\n321\t        r: &[u8],\n322\t        pk: &[u8],\n323\t        m: &[u8],\n324\t        mlen: u64,\n325\t        _ctx: &SpxCtx,\n326\t    ) {\n327\t        const SPX_TREE_BITS: usize = SPX_TREE_HEIGHT * (SPX_D - 1);\n328\t        const SPX_TREE_BYTES: usize = (SPX_TREE_BITS + 7) / 8;\n329\t        const SPX_LEAF_BITS: usize = SPX_TREE_HEIGHT;\n330\t        const SPX_LEAF_BYTES: usize = (SPX_LEAF_BITS + 7) / 8;\n331\t        const SPX_DGST_BYTES: usize = SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES;\n332\t\n333\t        let mut buf = vec![0u8; SPX_DGST_BYTES];\n334\t        let mut seed = vec![0u8; 2 * SPX_N + BLAKEX_OUTPUT_BYTES];\n335\t\n336\t        // NOTE: same C bug as in gen_message_random — the datalen is treated\n337\t        // as bits internally but byte counts are passed.\n338\t        #[cfg(any(feature = \"192s\", feature = \"192f\", feature = \"256s\", feature = \"256f\"))]\n339\t        {\n340\t            let mut s = Blakestate512::new();\n341\t            blake512_init(&mut s);\n342\t            blake512_update(&mut s, r, SPX_N as u64);\n343\t            blake512_update(&mut s, pk, SPX_PK_BYTES as u64);\n344\t            blake512_update(&mut s, m, mlen);\n345\t            blake512_final(&mut s, &mut seed[2 * SPX_N..]);\n346\t        }\n347\t        #[cfg(any(feature = \"128s\", feature = \"128f\"))]\n348\t        {\n349\t            let mut s = Blakestate256::new();\n350\t            blake256_init(&mut s);\n351\t            blake256_update(&mut s, r, SPX_N as u64);\n352\t            blake256_update(&mut s, pk, SPX_PK_BYTES as u64);\n353\t            blake256_update(&mut s, m, mlen);\n354\t            blake256_final(&mut s, &mut seed[2 * SPX_N..]);\n355\t        }\n356\t\n357\t        seed[..SPX_N].copy_from_slice(&r[..SPX_N]);\n358\t        seed[SPX_N..2 * SPX_N].copy_from_slice(&pk[..SPX_N]);\n359\t\n360\t        #[cfg(any(feature = \"192s\", feature = \"192f\", feature = \"256s\", feature = \"256f\"))]\n361\t        blake512_mgf1(&mut buf, SPX_DGST_BYTES, &seed, 2 * SPX_N + BLAKEX_OUTPUT_BYTES);\n362\t        #[cfg(any(feature = \"128s\", feature = \"128f\"))]\n363\t        blake256_mgf1(&mut buf, SPX_DGST_B