mut(1); swap2(&mut a[0], &mut b[0]);\n    let (a, b) = q[2..].split_at_mut(1); swap2(&mut a[0], &mut b[0]);\n    let (a, b) = q[4..].split_at_mut(1); swap2(&mut a[0], &mut b[0]);\n    let (a, b) = q[6..].split_at_mut(1); swap2(&mut a[0], &mut b[0]);\n\n    let (a, b) = q.split_at_mut(2); swap4(&mut a[0], &mut b[0]);\n    let (a, b) = q[1..].split_at_mut(2); swap4(&mut a[0], &mut b[0]);\n    let (a, b) = q[4..].split_at_mut(2); swap4(&mut a[0], &mut b[0]);\n    let (a, b) = q[5..].split_at_mut(2); swap4(&mut a[0], &mut b[0]);\n\n    let (a, b) = q.split_at_mut(4); swap8(&mut a[0], &mut b[0]);\n    let (a, b) = q[1..].split_at_mut(4); swap8(&mut a[0], &mut b[0]);\n    let (a, b) = q[2..].split_at_mut(4); swap8(&mut a[0], &mut b[0]);\n    let (a, b) = q[3..].split_at_mut(4); swap8(&mut a[0], &mut b[0]);\n}\n\nfn br_aes_ct64_interleave_in(q0: &mut u64, q1: &mut u64, w: &[u32]) {\n    let mut x0 = w[0] as u64;\n    let mut x1 = w[1] as u64;\n    let mut x2 = w[2] as u64;\n    let mut x3 = w[3] as u64;\n    x0 |= x0 << 16;\n    x1 |= x1 << 16;\n    x2 |= x2 << 16;\n    x3 |= x3 << 16;\n    x0 &= 0x0000FFFF0000FFFF;\n    x1 &= 0x0000FFFF0000FFFF;\n    x2 &= 0x0000FFFF0000FFFF;\n    x3 &= 0x0000FFFF0000FFFF;\n    x0 |= x0 << 8;\n    x1 |= x1 << 8;\n    x2 |= x2 << 8;\n    x3 |= x3 << 8;\n    x0 &= 0x00FF00FF00FF00FF;\n    x1 &= 0x00FF00FF00FF00FF;\n    x2 &= 0x00FF00FF00FF00FF;\n    x3 &= 0x00FF00FF00FF00FF;\n    *q0 = x0 | (x2 << 8);\n    *q1 = x1 | (x3 << 8);\n}\n\nfn br_aes_ct64_interleave_out(w: &mut [u32], q0: u64, q1: u64) {\n    let mut x0 = q0 & 0x00FF00FF00FF00FF;\n    let mut x1 = q1 & 0x00FF00FF00FF00FF;\n    let mut x2 = (q0 >> 8) & 0x00FF00FF00FF00FF;\n    let mut x3 = (q1 >> 8) & 0x00FF00FF00FF00FF;\n    x0 |= x0 >> 8;\n    x1 |= x1 >> 8;\n    x2 |= x2 >> 8;\n    x3 |= x3 >> 8;\n    x0 &= 0x0000FFFF0000FFFF;\n    x1 &= 0x0000FFFF0000FFFF;\n    x2 &= 0x0000FFFF0000FFFF;\n    x3 &= 0x0000FFFF0000FFFF;\n    w[0] = (x0 as u32) | ((x0 >> 16) as u32);\n    w[1] = (x1 as u32) | ((x1 >> 16) as u32);\n    w[2] = (x2 as u32) | ((x2 >> 16) as u32);\n    w[3] = (x3 as u32) | ((x3 >> 16) as u32);\n}\n\n#[inline]\nfn add_round_key(q: &mut [u64; 8], sk: &[u64; 8]) {\n    for i in 0..8 {\n        q[i] ^= sk[i];\n    }\n}\n\nfn shift_rows(q: &mut [u64; 8]) {\n    for i in 0..8 {\n        let x = q[i];\n        q[i] = (x & 0x000000000000FFFF)\n            | ((x & 0x00000000FFF00000) >> 4)\n            | ((x & 0x00000000000F0000) << 12)\n            | ((x & 0x0000FF0000000000) >> 8)\n            | ((x & 0x000000FF00000000) << 8)\n            | ((x & 0xF000000000000000) >> 12)\n            | ((x & 0x0FFF000000000000) << 4);\n    }\n}\n\n#[inline]\nfn rotr32(x: u64) -> u64 { (x << 32) | (x >> 32) }\n\nfn mix_columns(q: &mut [u64; 8]) {\n    let q0 = q[0]; let q1 = q[1]; let q2 = q[2]; let q3 = q[3];\n    let q4 = q[4]; let q5 = q[5]; let q6 = q[6]; let q7 = q[7];\n    let r0 = (q0 >> 16) | (q0 << 48);\n    let r1 = (q1 >> 16) | (q1 << 48);\n    let r2 = (q2 >> 16) | (q2 << 48);\n    let r3 = (q3 >> 16) | (q3 << 48);\n    let r4 = (q4 >> 16) | (q4 << 48);\n    let r5 = (q5 >> 16) | (q5 << 48);\n    let r6 = (q6 >> 16) | (q6 << 48);\n    let r7 = (q7 >> 16) | (q7 << 48);\n\n    q[0] = q7 ^ r7 ^ r0 ^ rotr32(q0 ^ r0);\n    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr32(q1 ^ r1);\n    q[2] = q1 ^ r1 ^ r2 ^ rotr32(q2 ^ r2);\n    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr32(q3 ^ r3);\n    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr32(q4 ^ r4);\n    q[5] = q4 ^ r4 ^ r5 ^ rotr32(q5 ^ r5);\n    q[6] = q5 ^ r5 ^ r6 ^ rotr32(q6 ^ r6);\n    q[7] = q6 ^ r6 ^ r7 ^ rotr32(q7 ^ r7);\n}\n\nfn interleave_constant(out: &mut [u64; 8], input: &[u8]) {\n    let mut tmp_32_constant = [0u32; 16];\n    br_range_dec32le(&mut tmp_32_constant, 16, input);\n    for i in 0..4 {\n        let (left, right) = out.split_at_mut(4);\n        br_aes_ct64_interleave_in(&mut left[i], &mut right[i], &tmp_32_constant[(i << 2)..]);\n    }\n    br_aes_ct64_ortho(out);\n}\n\nfn interleave_constant32(out: &mut [u32; 8], input: &[u8]) {\n    for i in 0..4 {\n        out[2 * i] = br_dec32le(&input[4 * i..]);\n        out[2 * i + 1] = br_dec32le(&input[4 * i + 16..]);\n    }\n    br_aes_ct_ortho(out);\n}\n\npub fn tweak_constants(ctx: &mut SpxCtx) {\n    let mut buf = vec![0u8; 40 * 16];\n    ctx.tweaked512_rc64 = HARAKA512_RC64;\n\n    // Snapshot pub_seed for haraka_S call\n    let pub_seed_copy = ctx.pub_seed;\n    haraka_s(&mut buf, 40 * 16, &pub_seed_copy, SPX_N as u64, ctx);\n\n    for i in 0..10 {\n        let mut tmp32 = [0u32; 8];\n        let mut tmp64 = [0u64; 8];\n        interleave_constant32(&mut tmp32, &buf[32 * i..]);\n        interleave_constant(&mut tmp64, &buf[64 * i..]);\n        ctx.tweaked256_rc32[i] = tmp32;\n        ctx.tweaked512_rc64[i] = tmp64;\n    }\n}\n\npub fn haraka512_perm(out: &mut [u8], input: &[u8], ctx: &SpxCtx) {\n    let mut w = [0u32; 16];\n    let mut q = [0u64; 8];\n    br_range_dec32le(&mut w, 16, input);\n    for i in 0..4 {\n        let (left, right) = q.split_at_mut(4);\n        br_aes_ct64_interleave_in(&mut left[i], &mut right[i], &w[(i << 2)..]);\n    }\n    br_aes_ct64_ortho(&mut q);\n\n    for i in 0..5 {\n        for j in 0..2 {\n            br_aes_ct64_bitslice_sbox(&mut q);\n            shift_rows(&mut q);\n            mix_columns(&mut q);\n            add_round_key(&mut q, &ctx.tweaked512_rc64[2 * i + j]);\n        }\n        for j in 0..8 {\n            let tmp_q = q[j];\n            q[j] = (tmp_q & 0x0001000100010001) << 5\n                | (tmp_q & 0x0002000200020002) << 12\n                | (tmp_q & 0x0004000400040004) >> 1\n                | (tmp_q & 0x0008000800080008) << 6\n                | (tmp_q & 0x0020002000200020) << 9\n                | (tmp_q & 0x0040004000400040) >> 4\n                | (tmp_q & 0x0080008000800080) << 3\n                | (tmp_q & 0x2100210021002100) >> 5\n                | (tmp_q & 0x0210021002100210) << 2\n                | (tmp_q & 0x0800080008000800) << 4\n                | (tmp_q & 0x1000100010001000) >> 12\n                | (tmp_q & 0x4000400040004000) >> 10\n                | (tmp_q & 0x8400840084008400) >> 3;\n        }\n    }\n\n    br_aes_ct64_ortho(&mut q);\n    for i in 0..4 {\n        let q_i = q[i];\n        let q_i4 = q[i + 4];\n        br_aes_ct64_interleave_out(&mut w[(i << 2)..], q_i, q_i4);\n    }\n    br_range_enc32le(out, &w, 16);\n}\n\npub fn haraka512(out: &mut [u8], input: &[u8], ctx: &SpxCtx) {\n    let mut buf = [0u8; 64];\n    haraka512_perm(&mut buf, input, ctx);\n    for i in 0..64 {\n        buf[i] ^= input[i];\n    }\n    out[..8].copy_from_slice(&buf[8..16]);\n    out[8..16].copy_from_slice(&buf[24..32]);\n    out[16..24].copy_from_slice(&buf[32..40]);\n    out[24..32].copy_from_slice(&buf[48..56]);\n}\n\npub fn haraka256(out: &mut [u8], input: &[u8], ctx: &SpxCtx) {\n    let mut q = [0u32; 8];\n    for i in 0..4 {\n        q[2 * i] = br_dec32le(&input[4 * i..]);\n        q[2 * i + 1] = br_dec32le(&input[4 * i + 16..]);\n    }\n    br_aes_ct_ortho(&mut q);\n\n    for i in 0..5 {\n        for j in 0..2 {\n            br_aes_ct_bitslice_sbox(&mut q);\n            shift_rows32(&mut q);\n            mix_columns32(&mut q);\n            add_round_key32(&mut q, &ctx.tweaked256_rc32[2 * i + j]);\n        }\n        for j in 0..8 {\n            let tmp_q = q[j];\n            q[j] = (tmp_q & 0x81818181)\n                | (tmp_q & 0x02020202) << 1\n                | (tmp_q & 0x04040404) << 2\n                | (tmp_q & 0x08080808) << 3\n                | (tmp_q & 0x10101010) >> 3\n                | (tmp_q & 0x20202020) >> 2\n                | (tmp_q & 0x40404040) >> 1;\n        }\n    }\n\n    br_aes_ct_ortho(&mut q);\n    for i in 0..4 {\n        br_enc32le(&mut out[4 * i..], q[2 * i]);\n        br_enc32le(&mut out[4 * i + 16..], q[2 * i + 1]);\n    }\n\n    for i in 0..32 {\n        out[i] ^= input[i];\n    }\n}\n\nfn haraka_s_absorb(s: &mut [u8], r: usize, m: &[u8], mut mlen: u64, p: u8, ctx: &SpxCtx) {\n    let mut t = vec![0u8; r];\n    let mut m_pos = 0usize;\n    while mlen >= r as u64 {\n        for i in 0..r {\n            s[i] ^= m[m_pos + i];\n        }\n        let s_copy = s.to_vec();\n        haraka512_perm(s, &s_copy, ctx);\n        mlen -= r as u64;\n        m_pos += r;\n    }\n    for i in 0..r {\n        t[i] = 0;\n    }\n    for i in 0..(mlen as usize) {\n        t[i] = m[m_pos + i];\n    }\n    t[mlen as usize] = p;\n    t[r - 1] |= 128;\n    for i in 0..r {\n        s[i] ^= t[i];\n    }\n}\n\nfn haraka_s_squeezeblocks(h: &mut [u8], mut nblocks: u64, s: &mut [u8], r: usize, ctx: &SpxCtx) {\n    let mut h_pos = 0usize;\n    while nblocks > 0 {\n        let s_copy = s.to_vec();\n        haraka512_perm(s, &s_copy, ctx);\n        h[h_pos..h_pos + HARAKAS_RATE].copy_from_slice(&s[..HARAKAS_RATE]);\n        h_pos += r;\n        nblocks -= 1;\n    }\n}\n\npub fn haraka_s_inc_init(s_inc: &mut [u8]) {\n    for i in 0..64 {\n        s_inc[i] = 0;\n    }\n    s_inc[64] = 0;\n}\n\npub fn haraka_s_inc_absorb(s_inc: &mut [u8], m: &[u8], mut mlen: usize, ctx: &SpxCtx) {\n    let mut m_pos = 0usize;\n    while mlen + s_inc[64] as usize >= HARAKAS_RATE {\n        let take = HARAKAS_RATE - s_inc[64] as usize;\n        for i in 0..take {\n            s_inc[s_inc[64] as usize + i] ^= m[m_pos + i];\n        }\n        mlen -= take;\n        m_pos += take;\n        s_inc[64] = 0;\n\n        let s_copy = s_inc[..64].to_vec();\n        let mut new_state = [0u8; 64];\n        haraka512_perm(&mut new_state, &s_copy, ctx);\n        s_inc[..64].copy_from_slice(&new_state);\n    }\n    for i in 0..mlen {\n        s_inc[s_inc[64] as usize + i] ^= m[m_pos + i];\n    }\n    s_inc[64] += mlen as u8;\n}\n\npub fn haraka_s_inc_finalize(s_inc: &mut [u8]) {\n    s_inc[s_inc[64] as usize] ^= 0x1F;\n    s_inc[HARAKAS_RATE - 1] ^= 128;\n    s_inc[64] = 0;\n}\n\npub fn haraka_s_inc_squeeze(out: &mut [u8], mut outlen: usize, s_inc: &mut [u8], ctx: &SpxCtx) {\n    let mut out_pos = 0usize;\n    let mut i = 0usize;\n    while i < outlen && i < s_inc[64] as usize {\n        out[out_pos + i] = s_inc[HARAKAS_RATE - s_inc[64] as usize + i];\n        i += 1;\n    }\n    out_pos += i;\n    outlen -= i;\n    s_inc[64] -= i as u8;\n\n    while outlen > 0 {\n        let s_copy = s_inc[..64].to_vec();\n        let mut new_state = [0u8; 64];\n        haraka512_perm(&mut new_state, &s_copy, ctx);\n        s_inc[..64].copy_from_slice(&new_state);\n\n        let mut j = 0usize;\n        while j < outlen && j < HARAKAS_RATE {\n            out[out_pos + j] = s_inc[j];\n            j += 1;\n        }\n        out_pos += j;\n        outlen -= j;\n        s_inc[64] = (HARAKAS_RATE - j) as u8;\n    }\n}\n\npub fn haraka_s(out: &mut [u8], outlen: u64, input: &[u8], inlen: u64, ctx: &SpxCtx) {\n    let mut s = [0u8; 64];\n    haraka_s_absorb(&mut s, 32, input, inlen, 0x1F, ctx);\n    let nblocks = outlen / 32;\n    haraka_s_squeezeblocks(out, nblocks, &mut s, 32, ctx);\n    let mut d = [0u8; 32];\n    let off = (nblocks * 32) as usize;\n    if outlen % 32 != 0 {\n        haraka_s_squeezeblocks(&mut d, 1, &mut s, 32, ctx);\n        for i in 0..(outlen % 32) as usize {\n            out[off + i] = d[i];\n        }\n    }\n}\n\n// ---------- C-ABI exports ----------\n\n#[unsafe(export_name = \"SPX_tweak_constants\")]\npub unsafe extern \"C\" fn spx_tweak_constants(ctx: *mut SpxCtx) {\n    tweak_constants(unsafe { &mut *ctx });\n}\n\n#[unsafe(export_name = \"SPX_haraka_S_inc_init\")]\npub unsafe extern \"C\" fn spx_haraka_s_inc_init(s_inc: *mut u8) {\n    let s_slice = unsafe { core::slice::from_raw_parts_mut(s_inc, 65) };\n    haraka_s_inc_init(s_slice);\n}\n\n#[unsafe(export_name = \"SPX_haraka_S_inc_absorb\")]\npub unsafe extern \"C\" fn spx_haraka_s_inc_absorb(\n    s_inc: *mut u8,\n    m: *const u8,\n    mlen: usize,\n    ctx: *const SpxCtx,\n) {\n    let s_slice = unsafe { core::slice::from_raw_parts_mut(s_inc, 65) };\n    let m_slice = unsafe { core::slice::from_raw_parts(m, mlen) };\n