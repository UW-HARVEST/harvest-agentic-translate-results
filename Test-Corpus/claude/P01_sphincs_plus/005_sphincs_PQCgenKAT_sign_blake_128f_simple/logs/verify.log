n    let y17 = y10 ^ y11;\n    let y19 = y10 ^ y8;\n    let y16 = t0 ^ y11;\n    let y21 = y13 ^ y16;\n    let y18 = x0 ^ y16;\n\n    let t2 = y12 & y15;\n    let t3 = y3 & y6;\n    let t4 = t3 ^ t2;\n    let t5 = y4 & x7;\n    let t6 = t5 ^ t2;\n    let t7 = y13 & y16;\n    let t8 = y5 & y1;\n    let t9 = t8 ^ t7;\n    let t10 = y2 & y7;\n    let t11 = t10 ^ t7;\n    let t12 = y9 & y11;\n    let t13 = y14 & y17;\n    let t14 = t13 ^ t12;\n    let t15 = y8 & y10;\n    let t16 = t15 ^ t12;\n    let t17 = t4 ^ t14;\n    let t18 = t6 ^ t16;\n    let t19 = t9 ^ t14;\n    let t20 = t11 ^ t16;\n    let t21 = t17 ^ y20;\n    let t22 = t18 ^ y19;\n    let t23 = t19 ^ y21;\n    let t24 = t20 ^ y18;\n\n    let t25 = t21 ^ t22;\n    let t26 = t21 & t23;\n    let t27 = t24 ^ t26;\n    let t28 = t25 & t27;\n    let t29 = t28 ^ t22;\n    let t30 = t23 ^ t24;\n    let t31 = t22 ^ t26;\n    let t32 = t31 & t30;\n    let t33 = t32 ^ t24;\n    let t34 = t23 ^ t33;\n    let t35 = t27 ^ t33;\n    let t36 = t24 & t35;\n    let t37 = t36 ^ t34;\n    let t38 = t27 ^ t36;\n    let t39 = t29 & t38;\n    let t40 = t25 ^ t39;\n\n    let t41 = t40 ^ t37;\n    let t42 = t29 ^ t33;\n    let t43 = t29 ^ t40;\n    let t44 = t33 ^ t37;\n    let t45 = t42 ^ t41;\n    let z0 = t44 & y15;\n    let z1 = t37 & y6;\n    let z2 = t33 & x7;\n    let z3 = t43 & y16;\n    let z4 = t40 & y1;\n    let z5 = t29 & y7;\n    let z6 = t42 & y11;\n    let z7 = t45 & y17;\n    let z8 = t41 & y10;\n    let z9 = t44 & y12;\n    let z10 = t37 & y3;\n    let z11 = t33 & y4;\n    let z12 = t43 & y13;\n    let z13 = t40 & y5;\n    let z14 = t29 & y2;\n    let z15 = t42 & y9;\n    let z16 = t45 & y14;\n    let z17 = t41 & y8;\n\n    let t46 = z15 ^ z16;\n    let t47 = z10 ^ z11;\n    let t48 = z5 ^ z13;\n    let t49 = z9 ^ z10;\n    let t50 = z2 ^ z12;\n    let t51 = z2 ^ z5;\n    let t52 = z7 ^ z8;\n    let t53 = z0 ^ z3;\n    let t54 = z6 ^ z7;\n    let t55 = z16 ^ z17;\n    let t56 = z12 ^ t48;\n    let t57 = t50 ^ t53;\n    let t58 = z4 ^ t46;\n    let t59 = z3 ^ t54;\n    let t60 = t46 ^ t57;\n    let t61 = z14 ^ t57;\n    let t62 = t52 ^ t58;\n    let t63 = t49 ^ t58;\n    let t64 = z4 ^ t59;\n    let t65 = t61 ^ t62;\n    let t66 = z1 ^ t63;\n    let s0 = t59 ^ t63;\n    let s6 = t56 ^ !t62;\n    let s7 = t48 ^ !t60;\n    let t67 = t64 ^ t65;\n    let s3 = t53 ^ t66;\n    let s4 = t51 ^ t66;\n    let s5 = t47 ^ t65;\n    let s1 = t64 ^ !s3;\n    let s2 = t55 ^ !t67;\n\n    q[7] = s0;\n    q[6] = s1;\n    q[5] = s2;\n    q[4] = s3;\n    q[3] = s4;\n    q[2] = s5;\n    q[1] = s6;\n    q[0] = s7;\n}\n\n#[inline]\nfn swapn_u32(cl: u32, ch: u32, s: u32, x: &mut u32, y: &mut u32) {\n    let a = *x;\n    let b = *y;\n    *x = (a & cl) | ((b & cl) << s);\n    *y = ((a & ch) >> s) | (b & ch);\n}\n\n#[inline]\nfn swap2_32(x: &mut u32, y: &mut u32) { swapn_u32(0x55555555, 0xAAAAAAAA, 1, x, y); }\n#[inline]\nfn swap4_32(x: &mut u32, y: &mut u32) { swapn_u32(0x33333333, 0xCCCCCCCC, 2, x, y); }\n#[inline]\nfn swap8_32(x: &mut u32, y: &mut u32) { swapn_u32(0x0F0F0F0F, 0xF0F0F0F0, 4, x, y); }\n\nfn br_aes_ct_ortho(q: &mut [u32; 8]) {\n    let (a, b) = q.split_at_mut(1); swap2_32(&mut a[0], &mut b[0]);\n    let (a, b) = q[2..].split_at_mut(1); swap2_32(&mut a[0], &mut b[0]);\n    let (a, b) = q[4..].split_at_mut(1); swap2_32(&mut a[0], &mut b[0]);\n    let (a, b) = q[6..].split_at_mut(1); swap2_32(&mut a[0], &mut b[0]);\n\n    let (a, b) = q.split_at_mut(2); swap4_32(&mut a[0], &mut b[0]);\n    let (a, b) = q[1..].split_at_mut(2); swap4_32(&mut a[0], &mut b[0]);\n    let (a, b) = q[4..].split_at_mut(2); swap4_32(&mut a[0], &mut b[0]);\n    let (a, b) = q[5..].split_at_mut(2); swap4_32(&mut a[0], &mut b[0]);\n\n    let (a, b) = q.split_at_mut(4); swap8_32(&mut a[0], &mut b[0]);\n    let (a, b) = q[1..].split_at_mut(4); swap8_32(&mut a[0], &mut b[0]);\n    let (a, b) = q[2..].split_at_mut(4); swap8_32(&mut a[0], &mut b[0]);\n    let (a, b) = q[3..].split_at_mut(4); swap8_32(&mut a[0], &mut b[0]);\n}\n\n#[inline]\nfn add_round_key32(q: &mut [u32; 8], sk: &[u32; 8]) {\n    for i in 0..8 {\n        q[i] ^= sk[i];\n    }\n}\n\nfn shift_rows32(q: &mut [u32; 8]) {\n    for i in 0..8 {\n        let x = q[i];\n        q[i] = (x & 0x000000FF)\n            | ((x & 0x0000FC00) >> 2) | ((x & 0x00000300) << 6)\n            | ((x & 0x00F00000) >> 4) | ((x & 0x000F0000) << 4)\n            | ((x & 0xC0000000) >> 6) | ((x & 0x3F000000) << 2);\n    }\n}\n\n#[inline]\nfn rotr16(x: u32) -> u32 { (x << 16) | (x >> 16) }\n\nfn mix_columns32(q: &mut [u32; 8]) {\n    let q0 = q[0]; let q1 = q[1]; let q2 = q[2]; let q3 = q[3];\n    let q4 = q[4]; let q5 = q[5]; let q6 = q[6]; let q7 = q[7];\n    let r0 = (q0 >> 8) | (q0 << 24);\n    let r1 = (q1 >> 8) | (q1 << 24);\n    let r2 = (q2 >> 8) | (q2 << 24);\n    let r3 = (q3 >> 8) | (q3 << 24);\n    let r4 = (q4 >> 8) | (q4 << 24);\n    let r5 = (q5 >> 8) | (q5 << 24);\n    let r6 = (q6 >> 8) | (q6 << 24);\n    let r7 = (q7 >> 8) | (q7 << 24);\n\n    q[0] = q7 ^ r7 ^ r0 ^ rotr16(q0 ^ r0);\n    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr16(q1 ^ r1);\n    q[2] = q1 ^ r1 ^ r2 ^ rotr16(q2 ^ r2);\n    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr16(q3 ^ r3);\n    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr16(q4 ^ r4);\n    q[5] = q4 ^ r4 ^ r5 ^ rotr16(q5 ^ r5);\n    q[6] = q5 ^ r5 ^ r6 ^ rotr16(q6 ^ r6);\n    q[7] = q6 ^ r6 ^ r7 ^ rotr16(q7 ^ r7);\n}\n\n#[inline]\nfn swapn_u64(cl: u64, ch: u64, s: u32, x: &mut u64, y: &mut u64) {\n    let a = *x;\n    let b = *y;\n    *x = (a & cl) | ((b & cl) << s);\n    *y = ((a & ch) >> s) | (b & ch);\n}\n\n#[inline]\nfn swap2(x: &mut u64, y: &mut u64) { swapn_u64(0x5555555555555555, 0xAAAAAAAAAAAAAAAA, 1, x, y); }\n#[inline]\nfn swap4(x: &mut u64, y: &mut u64) { swapn_u64(0x3333333333333333, 0xCCCCCCCCCCCCCCCC, 2, x, y); }\n#[inline]\nfn swap8(x: &mut u64, y: &mut u64) { swapn_u64(0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0, 4, x, y); }\n\nfn br_aes_ct64_ortho(q: &mut [u64; 8]) {\n    let (a, b) = q.split_at_mut(1); swap2(&mut a[0], &mut b[0]);\n    let (a, b) = q[2..].split_at_mut(1); swap2(&mut a[0], &mut b[0]);\n    let (a, b) = q[4..].split_at_mut(1); swap2(&mut a[0], &mut b[0]);\n    let (a, b) = q[6..].split_at_mut(1); swap2(&mut a[0], &mut b[0]);\n\n    let (a, b) = q.split_at_mut(2); swap4(&mut a[0], &mut b[0]);\n    let (a, b) = q[1..].split_at_mut(2); swap4(&mut a[0], &mut b[0]);\n    let (a, b) = q[4..].split_at_mut(2); swap4(&mut a[0], &mut b[0]);\n    let (a, b) = q[5..].split_at_mut(2); swap4(&mut a[0], &mut b[0]);\n\n    let (a, b) = q.split_at_mut(4); swap8(&mut a[0], &mut b[0]);\n    let (a, b) = q[1..].split_at_mut(4); swap8(&mut a[0], &mut b[0]);\n    let (a, b) = q[2..].split_at_mut(4); swap8(&mut a[0], &mut b[0]);\n    let (a, b) = q[3..].split_at_mut(4); swap8(&mut a[0], &mut b[0]);\n}\n\nfn br_aes_ct64_interleave_in(q0: &mut u64, q1: &mut u64, w: &[u32]) {\n    let mut x0 = w[0] as u64;\n    let mut x1 = w[1] as u64;\n    let mut x2 = w[2] as u64;\n    let mut x3 = w[3] as u64;\n    x0 |= x0 << 16;\n    x1 |= x1 << 16;\n    x2 |= x2 << 16;\n    x3 |= x3 << 16;\n    x0 &= 0x0000FFFF0000FFFF;\n    x1 &= 0x0000FFFF0000FFFF;\n    x2 &= 0x0000FFFF0000FFFF;\n    x3 &= 0x0000FFFF0000FFFF;\n    x0 |= x0 << 8;\n    x1 |= x1 << 8;\n    x2 |= x2 << 8;\n    x3 |= x3 << 8;\n    x0 &= 0x00FF00FF00FF00FF;\n    x1 &= 0x00FF00FF00FF00FF;\n    x2 &= 0x00FF00FF00FF00FF;\n    x3 &= 0x00FF00FF00FF00FF;\n    *q0 = x0 | (x2 << 8);\n    *q1 = x1 | (x3 << 8);\n}\n\nfn br_aes_ct64_interleave_out(w: &mut [u32], q0: u64, q1: u64) {\n    let mut x0 = q0 & 0x00FF00FF00FF00FF;\n    let mut x1 = q1 & 0x00FF00FF00FF00FF;\n    let mut x2 = (q0 >> 8) & 0x00FF00FF00FF00FF;\n    let mut x3 = (q1 >> 8) & 0x00FF00FF00FF00FF;\n    x0 |= x0 >> 8;\n    x1 |= x1 >> 8;\n    x2 |= x2 >> 8;\n    x3 |= x3 >> 8;\n    x0 &= 0x0000FFFF0000FFFF;\n    x1 &= 0x0000FFFF0000FFFF;\n    x2 &= 0x0000FFFF0000FFFF;\n    x3 &= 0x0000FFFF0000FFFF;\n    w[0] = (x0 as u32) | ((x0 >> 16) as u32);\n    w[1] = (x1 as u32) | ((x1 >> 16)