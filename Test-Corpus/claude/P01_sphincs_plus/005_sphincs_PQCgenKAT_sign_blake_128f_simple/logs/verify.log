92\t    let t64 = z4 ^ t59;\n293\t    let t65 = t61 ^ t62;\n294\t    let t66 = z1 ^ t63;\n295\t    let s0 = t59 ^ t63;\n296\t    let s6 = t56 ^ !t62;\n297\t    let s7 = t48 ^ !t60;\n298\t    let t67 = t64 ^ t65;\n299\t    let s3 = t53 ^ t66;\n300\t    let s4 = t51 ^ t66;\n301\t    let s5 = t47 ^ t65;\n302\t    let s1 = t64 ^ !s3;\n303\t    let s2 = t55 ^ !t67;\n304\t\n305\t    q[7] = s0;\n306\t    q[6] = s1;\n307\t    q[5] = s2;\n308\t    q[4] = s3;\n309\t    q[3] = s4;\n310\t    q[2] = s5;\n311\t    q[1] = s6;\n312\t    q[0] = s7;\n313\t}\n314\t\n315\t#[inline]\n316\tfn swapn_u32(cl: u32, ch: u32, s: u32, x: &mut u32, y: &mut u32) {\n317\t    let a = *x;\n318\t    let b = *y;\n319\t    *x = (a & cl) | ((b & cl) << s);\n320\t    *y = ((a & ch) >> s) | (b & ch);\n321\t}\n322\t\n323\t#[inline]\n324\tfn swap2_32(x: &mut u32, y: &mut u32) { swapn_u32(0x55555555, 0xAAAAAAAA, 1, x, y); }\n325\t#[inline]\n326\tfn swap4_32(x: &mut u32, y: &mut u32) { swapn_u32(0x33333333, 0xCCCCCCCC, 2, x, y); }\n327\t#[inline]\n328\tfn swap8_32(x: &mut u32, y: &mut u32) { swapn_u32(0x0F0F0F0F, 0xF0F0F0F0, 4, x, y); }\n329\t\n330\tfn br_aes_ct_ortho(q: &mut [u32; 8]) {\n331\t    let (a, b) = q.split_at_mut(1); swap2_32(&mut a[0], &mut b[0]);\n332\t    let (a, b) = q[2..].split_at_mut(1); swap2_32(&mut a[0], &mut b[0]);\n333\t    let (a, b) = q[4..].split_at_mut(1); swap2_32(&mut a[0], &mut b[0]);\n334\t    let (a, b) = q[6..].split_at_mut(1); swap2_32(&mut a[0], &mut b[0]);\n335\t\n336\t    let (a, b) = q.split_at_mut(2); swap4_32(&mut a[0], &mut b[0]);\n337\t    let (a, b) = q[1..].split_at_mut(2); swap4_32(&mut a[0], &mut b[0]);\n338\t    let (a, b) = q[4..].split_at_mut(2); swap4_32(&mut a[0], &mut b[0]);\n339\t    let (a, b) = q[5..].split_at_mut(2); swap4_32(&mut a[0], &mut b[0]);\n340\t\n341\t    let (a, b) = q.split_at_mut(4); swap8_32(&mut a[0], &mut b[0]);\n342\t    let (a, b) = q[1..].split_at_mut(4); swap8_32(&mut a[0], &mut b[0]);\n343\t    let (a, b) = q[2..].split_at_mut(4); s