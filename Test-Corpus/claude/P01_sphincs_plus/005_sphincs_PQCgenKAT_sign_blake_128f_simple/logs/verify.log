wapn_u64(0x5555555555555555, 0xAAAAAAAAAAAAAAAA, 1, x, y); }\n399\t#[inline]\n400\tfn swap4(x: &mut u64, y: &mut u64) { swapn_u64(0x3333333333333333, 0xCCCCCCCCCCCCCCCC, 2, x, y); }\n401\t#[inline]\n402\tfn swap8(x: &mut u64, y: &mut u64) { swapn_u64(0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0, 4, x, y); }\n403\t\n404\tfn br_aes_ct64_ortho(q: &mut [u64; 8]) {\n405\t    let (a, b) = q.split_at_mut(1); swap2(&mut a[0], &mut b[0]);\n406\t    let (a, b) = q[2..].split_at_mut(1); swap2(&mut a[0], &mut b[0]);\n407\t    let (a, b) = q[4..].split_at_mut(1); swap2(&mut a[0], &mut b[0]);\n408\t    let (a, b) = q[6..].split_at_mut(1); swap2(&mut a[0], &mut b[0]);\n409\t\n410\t    let (a, b) = q.split_at_mut(2); swap4(&mut a[0], &mut b[0]);\n411\t    let (a, b) = q[1..].split_at_mut(2); swap4(&mut a[0], &mut b[0]);\n412\t    let (a, b) = q[4..].split_at_mut(2); swap4(&mut a[0], &mut b[0]);\n413\t    let (a, b) = q[5..].split_at_mut(2); swap4(&mut a[0], &mut b[0]);\n414\t\n415\t    let (a, b) = q.split_at_mut(4); swap8(&mut a[0], &mut b[0]);\n416\t    let (a, b) = q[1..].split_at_mut(4); swap8(&mut a[0], &mut b[0]);\n417\t    let (a, b) = q[2..].split_at_mut(4); swap8(&mut a[0], &mut b[0]);\n418\t    let (a, b) = q[3..].split_at_mut(4); swap8(&mut a[0], &mut b[0]);\n419\t}\n420\t\n421\tfn br_aes_ct64_interleave_in(q0: &mut u64, q1: &mut u64, w: &[u32]) {\n422\t    let mut x0 = w[0] as u64;\n423\t    let mut x1 = w[1] as u64;\n424\t    let mut x2 = w[2] as u64;\n425\t    let mut x3 = w[3] as u64;\n426\t    x0 |= x0 << 16;\n427\t    x1 |= x1 << 16;\n428\t    x2 |= x2 << 16;\n429\t    x3 |= x3 << 16;\n430\t    x0 &= 0x0000FFFF0000FFFF;\n431\t    x1 &= 0x0000FFFF0000FFFF;\n432\t    x2 &= 0x0000FFFF0000FFFF;\n433\t    x3 &= 0x0000FFFF0000FFFF;\n434\t    x0 |= x0 << 8;\n435\t    x1 |= x1 << 8;\n436\t    x2 |= x2 << 8;\n437\t    x3 |= x3 << 8;\n438\t    x0 &= 0x00FF00FF00FF00FF;\n439\t    x1 &= 0x00FF00FF00FF00FF;\n440\t    x2 &= 0x00FF00FF00FF00FF;\n441\t    x3 &= 0x00FF00FF00FF00FF;\n442\