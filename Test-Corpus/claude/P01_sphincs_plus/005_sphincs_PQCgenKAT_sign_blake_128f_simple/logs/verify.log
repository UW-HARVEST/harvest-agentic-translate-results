{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_zo5cgznyo6dr722poe2ir6umw26cdndb2t4irz77zesezcgz7cxa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_014HcPe9deTzFgXMeN3pZyKY","name":"Write","input":{"file_path":"/tmp/harvest-work-zQlBme/translated_rust/tests/ffi_compare.rs","content":"// FFI comparison tests: load both the C .so and Rust .so via libloading,\n// invoke matching exports, and compare outputs byte-for-byte.\n\nuse libloading::{Library, Symbol};\nuse std::path::PathBuf;\n\n// ---------------------------------------------------------------------\n// Helpers: locate the .so files.\n// ---------------------------------------------------------------------\n\nfn find_rust_so() -> PathBuf {\n    let exe = std::env::current_exe().unwrap();\n    let mut dir = exe.parent().unwrap().to_path_buf();\n    while dir.parent().is_some() {\n        let candidate = dir.join(\"libsphincs_plus.so\");\n        if candidate.exists() {\n            return candidate;\n        }\n        dir = dir.parent().unwrap().to_path_buf();\n    }\n    panic!(\"could not locate libsphincs_plus.so\");\n}\n\nfn find_c_so(name: &str) -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    if name == \"blake\" || name == \"haraka\" || name == \"sha2\" || name == \"shake\" {\n        p.push(\"lib\");\n        p.push(name);\n        p.push(format!(\"lib{}.so\", name));\n    } else if name == \"core_det\" {\n        p.push(\"app\");\n        p.push(\"libsphincs_core_det.so\");\n    } else if name == \"core\" {\n        p.push(\"app\");\n        p.push(\"libsphincs_core.so\");\n    }\n    p\n}\n\nstruct CLibs {\n    backend: Library,\n    core: Library,\n}\n\nimpl CLibs {\n    fn load() -> Self {\n        let backend_name = if cfg!(feature = \"blake\") {\n            \"blake\"\n        } else if cfg!(feature = \"haraka\") {\n            \"haraka\"\n        } else if cfg!(feature = \"sha2\") {\n            \"sha2\"\n        } else if cfg!(feature = \"shake\") {\n            \"shake\"\n        } else {\n            panic!(\"no backend feature enabled\");\n        };\n        unsafe {\n            let backend = Library::new(find_c_so(backend_name)).expect(\"c backend lib\");\n            let core = Library::new(find_c_so(\"core_det\")).expect(\"c core lib\");\n            CLibs { backend, core }\n        }\n    }\n}\n\nfn load_rust() -> Library {\n    unsafe { Library::new(find_rust_so()).expect(\"rust lib\") }\n}\n\n// Resolve a symbol from either the core or backend library.\nunsafe fn get_either<T>(libs: &CLibs, name: &[u8]) -> Symbol<'_, T> {\n    unsafe {\n        if let Ok(s) = libs.core.get::<T>(name) {\n            return s;\n        }\n        libs.backend.get::<T>(name).unwrap_or_else(|e| panic!(\"symbol {} not found: {}\", String::from_utf8_lossy(name), e))\n    }\n}\n\n// ---------------------------------------------------------------------\n// SPX_N and other params from the cargo features (must match C).\n// ---------------------------------------------------------------------\n#[cfg(feature = \"128s\")]\nconst SPX_N: usize = 16;\n#[cfg(feature = \"128f\")]\nconst SPX_N: usize = 16;\n#[cfg(feature = \"192s\")]\nconst SPX_N: usize = 24;\n#[cfg(feature = \"192f\")]\nconst SPX_N: usize = 24;\n#[cfg(feature = \"256s\")]\nconst SPX_N: usize = 32;\n#[cfg(feature = \"256f\")]\nconst SPX_N: usize = 32;\n\n// SpxCtx size depends on backend.\nfn ctx_buf() -> Vec<u8> {\n    // Generous size: 2*SPX_N + 40 + 72 + 10*8*8 + 10*8*4 = 2*SPX_N + 1192\n    vec![0u8; 2 * SPX_N + 2048]\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_u32_to_bytes\n// ---------------------------------------------------------------------\n#[test]\nfn test_spx_u32_to_bytes() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, u32)> =\n            get_either(&cl, b\"SPX_u32_to_bytes\");\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, u32)> =\n            rl.get(b\"SPX_u32_to_bytes\").unwrap();\n        for v in [0u32, 1, 0xdeadbeef, 0xffffffff, 0x12345678] {\n            let mut a = [0u8; 4];\n            let mut b = [0u8; 4];\n            c_fn(a.as_mut_ptr(), v);\n            r_fn(b.as_mut_ptr(), v);\n            assert_eq!(a, b, \"u32_to_bytes mismatch for {:08x}\", v);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_bytes_to_ull and SPX_ull_to_bytes\n// ---------------------------------------------------------------------\n#[test]\nfn test_spx_bytes_ull_roundtrip() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn_to: Symbol<unsafe extern \"C\" fn(*mut u8, u32, u64)> =\n            get_either(&cl, b\"SPX_ull_to_bytes\");\n        let r_fn_to: Symbol<unsafe extern \"C\" fn(*mut u8, u32, u64)> =\n            rl.get(b\"SPX_ull_to_bytes\").unwrap();\n        let c_fn_from: Symbol<unsafe extern \"C\" fn(*const u8, u32) -> u64> =\n            get_either(&cl, b\"SPX_bytes_to_ull\");\n        let r_fn_from: Symbol<unsafe extern \"C\" fn(*const u8, u32) -> u64> =\n            rl.get(b\"SPX_bytes_to_ull\").unwrap();\n        for v in [0u64, 1, 0x123456789abcdef0, 0xffffffffffffffff] {\n            for outlen in [1u32, 2, 4, 8] {\n                let mut a = vec![0u8; outlen as usize];\n                let mut b = vec![0u8; outlen as usize];\n                c_fn_to(a.as_mut_ptr(), outlen, v);\n                r_fn_to(b.as_mut_ptr(), outlen, v);\n                assert_eq!(a, b, \"ull_to_bytes mismatch v={:x} len={}\", v, outlen);\n                let cv = c_fn_from(a.as_ptr(), outlen);\n                let rv = r_fn_from(b.as_ptr(), outlen);\n                assert_eq!(cv, rv);\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_set_*_addr family\n// ---------------------------------------------------------------------\n#[test]\nfn test_spx_address_setters() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        macro_rules! cmp_setter {\n            ($name:literal, $val:expr, $val_type:ty) => {{\n                let c_fn: Symbol<unsafe extern \"C\" fn(*mut u32, $val_type)> =\n                    cl.core.get($name.as_bytes()).unwrap();\n                let r_fn: Symbol<unsafe extern \"C\" fn(*mut u32, $val_type)> =\n                    rl.get($name.as_bytes()).unwrap();\n                let mut a = [0u32; 8];\n                let mut b = [0u32; 8];\n                for i in 0..8 {\n                    a[i] = (i as u32) * 0x10101010 + 0x07060504;\n                    b[i] = a[i];\n                }\n                c_fn(a.as_mut_ptr(), $val);\n                r_fn(b.as_mut_ptr(), $val);\n                assert_eq!(a, b, \"{} mismatch\", $name);\n            }};\n        }\n        cmp_setter!(\"SPX_set_layer_addr\", 0x42u32, u32);\n        cmp_setter!(\"SPX_set_type\", 0x03u32, u32);\n        cmp_setter!(\"SPX_set_keypair_addr\", 0xdeadbeefu32, u32);\n        cmp_setter!(\"SPX_set_chain_addr\", 0x55u32, u32);\n        cmp_setter!(\"SPX_set_hash_addr\", 0xaau32, u32);\n        cmp_setter!(\"SPX_set_tree_height\", 0x42u32, u32);\n        cmp_setter!(\"SPX_set_tree_index\", 0xdeadbeefu32, u32);\n        cmp_setter!(\"SPX_set_tree_addr\", 0x123456789abcdef0u64, u64);\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_copy_subtree_addr / SPX_copy_keypair_addr\n// ---------------------------------------------------------------------\n#[test]\nfn test_spx_address_copies() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        for name in [\"SPX_copy_subtree_addr\", \"SPX_copy_keypair_addr\"] {\n            let c_fn: Symbol<unsafe extern \"C\" fn(*mut u32, *const u32)> =\n                cl.core.get(name.as_bytes()).unwrap();\n            let r_fn: Symbol<unsafe extern \"C\" fn(*mut u32, *const u32)> =\n                rl.get(name.as_bytes()).unwrap();\n            let src: [u32; 8] = [0x11111111, 0x22222222, 0x33333333, 0x44444444,\n                                 0x55555555, 0x66666666, 0x77777777, 0x88888888];\n            let mut a = [0xAAAAAAAAu32; 8];\n            let mut b = [0xAAAAAAAAu32; 8];\n            c_fn(a.as_mut_ptr(), src.as_ptr());\n            r_fn(b.as_mut_ptr(), src.as_ptr());\n            assert_eq!(a, b, \"{} mismatch\", name);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: blake256, blake512 (only blake feature)\n// ---------------------------------------------------------------------\n#[cfg(feature = \"blake\")]\n#[test]\nfn test_blake256() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32> =\n            cl.backend.get(b\"blake256\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32> =\n            rl.get(b\"blake256\").unwrap();\n        for inlen in [0usize, 1, 32, 64, 100, 256, 1000] {\n            let input: Vec<u8> = (0..inlen).map(|i| (i * 7 + 3) as u8).collect();\n            let mut a = [0u8; 32];\n            let mut b = [0u8; 32];\n            c_fn(a.as_mut_ptr(), input.as_ptr(), inlen as u64);\n            r_fn(b.as_mut_ptr(), input.as_ptr(), inlen as u64);\n            assert_eq!(a, b, \"blake256 mismatch inlen={}\", inlen);\n        }\n    }\n}\n\n#[cfg(feature = \"blake\")]\n#[test]\nfn test_blake512() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32> =\n            cl.backend.get(b\"blake512\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32> =\n            rl.get(b\"blake512\").unwrap();\n        for inlen in [0usize, 1, 32, 64, 100, 128, 256, 1000] {\n            let input: Vec<u8> = (0..inlen).map(|i| (i * 11 + 7) as u8).collect();\n            let mut a = [0u8; 64];\n            let mut b = [0u8; 64];\n            c_fn(a.as_mut_ptr(), input.as_ptr(), inlen as u64);\n            r_fn(b.as_mut_ptr(), input.as_ptr(), inlen as u64);\n            assert_eq!(a, b, \"blake512 mismatch inlen={}\", inlen);\n        }\n    }\n}\n\n#[cfg(feature = \"blake\")]\n#[test]\nfn test_blake256_mgf1() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, core::ffi::c_ulong, *const u8, core::ffi::c_ulong)> =\n            cl.backend.get(b\"SPX_blake256_mgf1\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, core::ffi::c_ulong, *const u8, core::ffi::c_ulong)> =\n            rl.get(b\"SPX_blake256_mgf1\").unwrap();\n        for &(inlen, outlen) in &[(8usize, 16usize), (32, 64), (50, 100), (16, 32)] {\n            let input: Vec<u8> = (0..inlen).map(|i| (i * 5 + 1) as u8).collect();\n            let mut a = vec![0u8; outlen];\n            let mut b = vec![0u8; outlen];\n            c_fn(a.as_mut_ptr(), outlen as core::ffi::c_ulong, input.as_ptr(), inlen as core::ffi::c_ulong);\n            r_fn(b.as_mut_ptr(), outlen as core::ffi::c_ulong, input.as_ptr(), inlen as core::ffi::c_ulong);\n            assert_eq!(a, b, \"blake256_mgf1 mismatch in={} out={}\", inlen, outlen);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_initialize_hash_function (verify by writing same pub_seed/sk_seed\n// then comparing the resulting context buffer byte-for-byte).\n// We need a context layout that matches. For blake/shake backends, the C ctx\n// is just pub_seed[N] || sk_seed[N]; for sha2 it's that plus state arrays;\n// for haraka it's plus tweaked tables.\n// ---------------------------------------------------------------------\n#[test]\nfn test_initialize_hash_function() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8)> =\n            get_either(&cl, b\"SPX_initialize_hash_function\");\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8)> =\n            rl.get(b\"SPX_initialize_hash_function\").unwrap();\n        let mut a = ctx_buf();\n        let mut b = ctx_buf();\n        // initialize seeds\n        for i in 0..SPX_N {\n            a[i] = (i as u8).wrapping_mul(7);\n            a[SPX_N + i] = (i as u8).wrapping_mul(11);\n            b[i] = a[i];\n            b[SPX_N + i] = a[SPX_N + i];\n        }\n        c_fn(a.as_mut_ptr());\n        r_fn(b.as_mut_ptr());\n        // For most backends, only the first 2*SPX_N bytes (seeds) are touched\n        // for blake/shake. For sha2 and haraka, more is touched. Compare only\n        // those bytes that the function definitely sets.\n        // Compare the entire buffer up to the SpxCtx size assumption.\n        let cmp_len = if cfg!(feature = \"blake\") || cfg!(feature = \"shake\") {\n            2 * SPX_N\n        } else if cfg!(feature = \"sha2\") {\n            #[cfg(any(feature = \"192s\", feature = \"192f\", feature = \"256s\", feature = \"256f\"))]\n            { 2 * SPX_N + 40 + 72 }\n            #[cfg(any(feature = \"128s\", feature = \"128f\"))]\n            { 2 * SPX_N + 40 }\n        } else {\n            // haraka: 2*N + 10*8*8 + 10*8*4\n            2 * SPX_N + 10 * 8 * 8 + 10 * 8 * 4\n        };\n        assert_eq!(&a[..cmp_len], &b[..cmp_len], \"ctx mismatch after init\");\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_prf_addr\n// ---------------------------------------------------------------------\n#[test]\nfn test_prf_addr() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8)> = get_either(&cl, b\"SPX_initialize_hash_function\");\n        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8)> = rl.get(b\"SPX_initialize_hash_function\").unwrap();\n        let prf_c: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, *const u32)> =\n            get_either(&cl, b\"SPX_prf_addr\");\n        let prf_r: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, *const u32)> =\n            rl.get(b\"SPX_prf_addr\").unwrap();\n        let mut a = ctx_buf();\n        let mut b = ctx_buf();\n        for i in 0..SPX_N {\n            a[i] = (i as u8).wrapping_mul(13).wrapping_add(2);\n            a[SPX_N + i] = (i as u8).wrapping_mul(17).wrapping_add(5);\n            b[i] = a[i];\n            b[SPX_N + i] = a[SPX_N + i];\n        }\n        init_c(a.as_mut_ptr());\n        init_r(b.as_mut_ptr());\n        let addr: [u32; 8] = [0x01020304, 0x05060708, 0x090a0b0c, 0x0d0e0f10,\n                              0x11121314, 0x15161718, 0x191a1b1c, 0x1d1e1f20];\n        let mut oa = vec![0u8; SPX_N];\n        let mut ob = vec![0u8; SPX_N];\n        prf_c(oa.as_mut_ptr(), a.as_ptr(), addr.as_ptr());\n        prf_r(ob.as_mut_ptr(), b.as_ptr(), addr.as_ptr());\n        assert_eq!(oa, ob, \"prf_addr mismatch\");\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_thash with various inblocks\n// ---------------------------------------------------------------------\n#[test]\nfn test_thash() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8)> = get_either(&cl, b\"SPX_initialize_hash_function\");\n        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8)> = rl.get(b\"SPX_initialize_hash_function\").unwrap();\n        let thash_c: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u32, *const u8, *mut u32)> =\n            get_either(&cl, b\"SPX_thash\");\n        let thash_r: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u32, *const u8, *mut u32)> =\n            rl.get(b\"SPX_thash\").unwrap();\n        let mut a = ctx_buf();\n        let mut b = ctx_buf();\n        for i in 0..SPX_N {\n            a[i] = (i as u8).wrapping_mul(3).wrapping_add(1);\n            a[SPX_N + i] = (i as u8).wrapping_mul(5).wrapping_add(2);\n            b[i] = a[i];\n            b[SPX_N + i] = a[SPX_N + i];\n        }\n        init_c(a.as_mut_ptr());\n        init_r(b.as_mut_ptr());\n        for &inblocks in &[1u32, 2u32, 8u32] {\n            let inlen = inblocks as usize * SPX_N;\n            let input: Vec<u8> = (0..inlen).map(|i| (i * 7 + 11) as u8).collect();\n            let mut addr_a: [u32; 8] = [0x10203040, 0, 0x50607080, 0,\n                                        0, 0, 0, 0];\n            let mut addr_b = addr_a;\n            let mut oa = vec![0u8; SPX_N];\n            let mut ob = vec![0u8; SPX_N];\n            thash_c(oa.as_mut_ptr(), input.as_ptr(), inblocks, a.as_ptr(), addr_a.as_mut_ptr());\n            thash_r(ob.as_mut_ptr(), input.as_ptr(), inblocks, b.as_ptr(), addr_b.as_mut_ptr());\n            assert_eq!(oa, ob, \"thash inblocks={} mismatch\", inblocks);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_chain_lengths\n// ---------------------------------------------------------------------\n#[test]\nfn test_chain_lengths() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u32, *const u8)> =\n            get_either(&cl, b\"SPX_chain_lengths\");\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u32, *const u8)> =\n            rl.get(b\"SPX_chain_lengths\").unwrap();\n\n        // SPX_WOTS_LEN1 = 8*N/4, SPX_WOTS_LEN2 = N<=8?2: N<=136?3:4 (so 3 for N>=16)\n        let len1 = 8 * SPX_N / 4;\n        let len2 = if SPX_N <= 8 { 2 } else if SPX_N <= 136 { 3 } else { 4 };\n        let total = len1 + len2;\n        let msg: Vec<u8> = (0..SPX_N).map(|i| (i * 13 + 9) as u8).collect();\n        let mut a = vec![0u32; total];\n        let mut b = vec![0u32; total];\n        c_fn(a.as_mut_ptr(), msg.as_ptr());\n        r_fn(b.as_mut_ptr(), msg.as_ptr());\n        assert_eq!(a, b, \"chain_lengths mismatch\");\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_compute_root\n// ---------------------------------------------------------------------\n#[test]\nfn test_compute_root() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8)> = get_either(&cl, b\"SPX_initialize_hash_function\");\n        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8)> = rl.get(b\"SPX_initialize_hash_function\").unwrap();\n        let cr_c: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u32, u32, *const u8, u32, *const u8, *mut u32)> =\n            get_either(&cl, b\"SPX_compute_root\");\n        let cr_r: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u32, u32, *const u8, u32, *const u8, *mut u32)> =\n            rl.get(b\"SPX_compute_root\").unwrap();\n        let mut a = ctx_buf();\n        let mut b = ctx_buf();\n        for i in 0..SPX_N {\n            a[i] = (i as u8).wrapping_mul(3);\n            a[SPX_N + i] = (i as u8).wrapping_mul(5);\n            b[i] = a[i];\n            b[SPX_N + i] = a[SPX_N + i];\n        }\n        init_c(a.as_mut_ptr());\n        init_r(b.as_mut_ptr());\n        let height = 5u32;\n        let leaf: Vec<u8> = (0..SPX_N).map(|i| (i * 7) as u8).collect();\n        let auth: Vec<u8> = (0..SPX_N * height as usize).map(|i| (i * 9 + 1) as u8).collect();\n        let mut root_a = vec![0u8; SPX_N];\n        let mut root_b = vec![0u8; SPX_N];\n        let mut addr_a = [0u32; 8];\n        let mut addr_b = [0u32; 8];\n        cr_c(root_a.as_mut_ptr(), leaf.as_ptr(), 7, 1, auth.as_ptr(), height, a.as_ptr(), addr_a.as_mut_ptr());\n        cr_r(root_b.as_mut_ptr(), leaf.as_ptr(), 7, 1, auth.as_ptr(), height, b.as_ptr(), addr_b.as_mut_ptr());\n        assert_eq!(root_a, root_b, \"compute_root mismatch\");\n        assert_eq!(addr_a, addr_b, \"compute_root addr mismatch\");\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: end-to-end signing - crypto_sign_keypair, crypto_sign, crypto_sign_open\n// ---------------------------------------------------------------------\n#[test]\nfn test_e2e_keypair_sign_verify() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        // Both libs use the deterministic randombytes_init/randombytes (rng.c).\n        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8)> = cl.core.get(b\"randombytes_init\").unwrap();\n        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8)> = rl.get(b\"randombytes_init\").unwrap();\n\n        let kp_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32> = cl.core.get(b\"crypto_sign_keypair\").unwrap();\n        let kp_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32> = rl.get(b\"crypto_sign_keypair\").unwrap();\n\n        let sign_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> =\n            cl.core.get(b\"crypto_sign\").unwrap();\n        let sign_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> =\n            rl.get(b\"crypto_sign\").unwrap();\n\n        let open_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> =\n            cl.core.get(b\"crypto_sign_open\").unwrap();\n        let open_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> =\n            rl.get(b\"crypto_sign_open\").unwrap();\n\n        let pkbytes_c: Symbol<unsafe extern \"C\" fn() -> u64> = cl.core.get(b\"crypto_sign_publickeybytes\").unwrap();\n        let skbytes_c: Symbol<unsafe extern \"C\" fn() -> u64> = cl.core.get(b\"crypto_sign_secretkeybytes\").unwrap();\n        let sigbytes_c: Symbol<unsafe extern \"C\" fn() -> u64> = cl.core.get(b\"crypto_sign_bytes\").unwrap();\n\n        let pk_len = pkbytes_c() as usize;\n        let sk_len = skbytes_c() as usize;\n        let sig_len = sigbytes_c() as usize;\n\n        // Verify Rust returns same sizes\n        let pkbytes_r: Symbol<unsafe extern \"C\" fn() -> u64> = rl.get(b\"crypto_sign_publickeybytes\").unwrap();\n        let skbytes_r: Symbol<unsafe extern \"C\" fn() -> u64> = rl.get(b\"crypto_sign_secretkeybytes\").unwrap();\n        let sigbytes_r: Symbol<unsafe extern \"C\" fn() -> u64> = rl.get(b\"crypto_sign_bytes\").unwrap();\n        assert_eq!(pkbytes_r() as usize, pk_len);\n        assert_eq!(skbytes_r() as usize, sk_len);\n        assert_eq!(sigbytes_r() as usize, sig_len);\n\n        // Init both PRGs with the same seed\n        let mut entropy = [0u8; 48];\n        for i in 0..48 { entropy[i] = i as u8; }\n        let mut entropy_c = entropy;\n        init_c(entropy_c.as_mut_ptr(), std::ptr::null_mut());\n        let mut entropy_r = entropy;\n        init_r(entropy_r.as_mut_ptr(), std::ptr::null_mut());\n\n        // Generate keys\n        let mut pk_c = vec![0u8; pk_len];\n        let mut sk_c = vec![0u8; sk_len];\n        let mut pk_r = vec![0u8; pk_len];\n        let mut sk_r = vec![0u8; sk_len];\n        kp_c(pk_c.as_mut_ptr(), sk_c.as_mut_ptr());\n        kp_r(pk_r.as_mut_ptr(), sk_r.as_mut_ptr());\n        assert_eq!(pk_c, pk_r, \"pk mismatch\");\n        assert_eq!(sk_c, sk_r, \"sk mismatch\");\n\n        // Sign a message\n        let msg: Vec<u8> = (0..33).map(|i| (i * 7 + 5) as u8).collect();\n        let mut sm_c = vec![0u8; sig_len + msg.len()];\n        let mut sm_r = vec![0u8; sig_len + msg.len()];\n        let mut smlen_c: u64 = 0;\n        let mut smlen_r: u64 = 0;\n        sign_c(sm_c.as_mut_ptr(), &mut smlen_c, msg.as_ptr(), msg.len() as u64, sk_c.as_ptr());\n        sign_r(sm_r.as_mut_ptr(), &mut smlen_r, msg.as_ptr(), msg.len() as u64, sk_r.as_ptr());\n        assert_eq!(smlen_c, smlen_r, \"smlen mismatch\");\n        assert_eq!(&sm_c[..smlen_c as usize], &sm_r[..smlen_r as usize], \"signature mismatch\");\n\n        // Verify\n        let mut m_out_c = vec![0u8; sm_c.len()];\n        let mut m_out_r = vec![0u8; sm_r.len()];\n        let mut mlen_c: u64 = 0;\n        let mut mlen_r: u64 = 0;\n        let r1 = open_c(m_out_c.as_mut_ptr(), &mut mlen_c, sm_c.as_ptr(), smlen_c, pk_c.as_ptr());\n        let r2 = open_r(m_out_r.as_mut_ptr(), &mut mlen_r, sm_r.as_ptr(), smlen_r, pk_r.as_ptr());\n        assert_eq!(r1, 0); assert_eq!(r2, 0);\n        assert_eq!(mlen_c, msg.len() as u64);\n        assert_eq!(mlen_r, msg.len() as u64);\n        assert_eq!(&m_out_c[..mlen_c as usize], &msg[..]);\n        assert_eq!(&m_out_r[..mlen_r as usize], &msg[..]);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":328,"cache_read_input_tokens":166795,"cache_creation":{"ephemeral_5m_input_tokens":328,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c9169a7d-325a-4e19-9af5-5c6ed8898127","uuid":"be769841-4e89-488a-aaa9-198f26b1c342"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014HcPe9deTzFgXMeN3pZyKY","type":"tool_result","content":"The file /tmp/harvest-work-zQlBme/translated_rust/tests/ffi_compare.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"c9169a7d-325a-4e19-9af5-5c6ed8898127","uuid":"d4360c64-1c30-4636-ac27-b44552fe7dec","timestamp":"2026-05-28T09:33:07.944Z","tool_use_result":{"type":"update","filePath":"/tmp/harvest-work-zQlBme/translated_rust/tests/ffi_compare.rs","content":"// FFI comparison tests: load both the C .so and Rust .so via libloading,\n// invoke matching exports, and compare outputs byte-for-byte.\n\nuse libloading::{Library, Symbol};\nuse std::path::PathBuf;\n\n// ---------------------------------------------------------------------\n// Helpers: locate the .so files.\n// ---------------------------------------------------------------------\n\nfn find_rust_so() -> PathBuf {\n    let exe = std::env::current_exe().unwrap();\n    let mut dir = exe.parent().unwrap().to_path_buf();\n    while dir.parent().is_some() {\n        let candidate = dir.join(\"libsphincs_plus.so\");\n        if candidate.exists() {\n            return candidate;\n        }\n        dir = dir.parent().unwrap().to_path_buf();\n    }\n    panic!(\"could not locate libsphincs_plus.so\");\n}\n\nfn find_c_so(name: &str) -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    if name == \"blake\" || name == \"haraka\" || name == \"sha2\" || name == \"shake\" {\n        p.push(\"lib\");\n        p.push(name);\n        p.push(format!(\"lib{}.so\", name));\n    } else if name == \"core_det\" {\n        p.push(\"app\");\n        p.push(\"libsphincs_core_det.so\");\n    } else if name == \"core\" {\n        p.push(\"app\");\n        p.push(\"libsphincs_core.so\");\n    }\n    p\n}\n\nstruct CLibs {\n    backend: Library,\n    core: Library,\n}\n\nimpl CLibs {\n    fn load() -> Self {\n        let backend_name = if cfg!(feature = \"blake\") {\n            \"blake\"\n        } else if cfg!(feature = \"haraka\") {\n            \"haraka\"\n        } else if cfg!(feature = \"sha2\") {\n            \"sha2\"\n        } else if cfg!(feature = \"shake\") {\n            \"shake\"\n        } else {\n            panic!(\"no backend feature enabled\");\n        };\n        unsafe {\n            let backend = Library::new(find_c_so(backend_name)).expect(\"c backend lib\");\n            let core = Library::new(find_c_so(\"core_det\")).expect(\"c core lib\");\n            CLibs { backend, core }\n        }\n    }\n}\n\nfn load_rust() -> Library {\n    unsafe { Library::new(find_rust_so()).expect(\"rust lib\") }\n}\n\n// Resolve a symbol from either the core or backend library.\nunsafe fn get_either<T>(libs: &CLibs, name: &[u8]) -> Symbol<'_, T> {\n    unsafe {\n        if let Ok(s) = libs.core.get::<T>(name) {\n            return s;\n        }\n        libs.backend.get::<T>(name).unwrap_or_else(|e| panic!(\"symbol {} not found: {}\", String::from_utf8_lossy(name), e))\n    }\n}\n\n// ---------------------------------------------------------------------\n// SPX_N and other params from the cargo features (must match C).\n// ---------------------------------------------------------------------\n#[cfg(feature = \"128s\")]\nconst SPX_N: usize = 16;\n#[cfg(feature = \"128f\")]\nconst SPX_N: usize = 16;\n#[cfg(feature = \"192s\")]\nconst SPX_N: usize = 24;\n#[cfg(feature = \"192f\")]\nconst SPX_N: usize = 24;\n#[cfg(feature = \"256s\")]\nconst SPX_N: usize = 32;\n#[cfg(feature = \"256f\")]\nconst SPX_N: usize = 32;\n\n// SpxCtx size depends on backend.\nfn ctx_buf() -> Vec<u8> {\n    // Generous size: 2*SPX_N + 40 + 72 + 10*8*8 + 10*8*4 = 2*SPX_N + 1192\n    vec![0u8; 2 * SPX_N + 2048]\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_u32_to_bytes\n// ---------------------------------------------------------------------\n#[test]\nfn test_spx_u32_to_bytes() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, u32)> =\n            get_either(&cl, b\"SPX_u32_to_bytes\");\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, u32)> =\n            rl.get(b\"SPX_u32_to_bytes\").unwrap();\n        for v in [0u32, 1, 0xdeadbeef, 0xffffffff, 0x12345678] {\n            let mut a = [0u8; 4];\n            let mut b = [0u8; 4];\n            c_fn(a.as_mut_ptr(), v);\n            r_fn(b.as_mut_ptr(), v);\n            assert_eq!(a, b, \"u32_to_bytes mismatch for {:08x}\", v);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_bytes_to_ull and SPX_ull_to_bytes\n// ---------------------------------------------------------------------\n#[test]\nfn test_spx_bytes_ull_roundtrip() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn_to: Symbol<unsafe extern \"C\" fn(*mut u8, u32, u64)> =\n            get_either(&cl, b\"SPX_ull_to_bytes\");\n        let r_fn_to: Symbol<unsafe extern \"C\" fn(*mut u8, u32, u64)> =\n            rl.get(b\"SPX_ull_to_bytes\").unwrap();\n        let c_fn_from: Symbol<unsafe extern \"C\" fn(*const u8, u32) -> u64> =\n            get_either(&cl, b\"SPX_bytes_to_ull\");\n        let r_fn_from: Symbol<unsafe extern \"C\" fn(*const u8, u32) -> u64> =\n            rl.get(b\"SPX_bytes_to_ull\").unwrap();\n        for v in [0u64, 1, 0x123456789abcdef0, 0xffffffffffffffff] {\n            for outlen in [1u32, 2, 4, 8] {\n                let mut a = vec![0u8; outlen as usize];\n                let mut b = vec![0u8; outlen as usize];\n                c_fn_to(a.as_mut_ptr(), outlen, v);\n                r_fn_to(b.as_mut_ptr(), outlen, v);\n                assert_eq!(a, b, \"ull_to_bytes mismatch v={:x} len={}\", v, outlen);\n                let cv = c_fn_from(a.as_ptr(), outlen);\n                let rv = r_fn_from(b.as_ptr(), outlen);\n                assert_eq!(cv, rv);\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_set_*_addr family\n// ---------------------------------------------------------------------\n#[test]\nfn test_spx_address_setters() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        macro_rules! cmp_setter {\n            ($name:literal, $val:expr, $val_type:ty) => {{\n                let c_fn: Symbol<unsafe extern \"C\" fn(*mut u32, $val_type)> =\n                    cl.core.get($name.as_bytes()).unwrap();\n                let r_fn: Symbol<unsafe extern \"C\" fn(*mut u32, $val_type)> =\n                    rl.get($name.as_bytes()).unwrap();\n                let mut a = [0u32; 8];\n                let mut b = [0u32; 8];\n                for i in 0..8 {\n                    a[i] = (i as u32) * 0x10101010 + 0x07060504;\n                    b[i] = a[i];\n                }\n                c_fn(a.as_mut_ptr(), $val);\n                r_fn(b.as_mut_ptr(), $val);\n                assert_eq!(a, b, \"{} mismatch\", $name);\n            }};\n        }\n        cmp_setter!(\"SPX_set_layer_addr\", 0x42u32, u32);\n        cmp_setter!(\"SPX_set_type\", 0x03u32, u32);\n        cmp_setter!(\"SPX_set_keypair_addr\", 0xdeadbeefu32, u32);\n        cmp_setter!(\"SPX_set_chain_addr\", 0x55u32, u32);\n        cmp_setter!(\"SPX_set_hash_addr\", 0xaau32, u32);\n        cmp_setter!(\"SPX_set_tree_height\", 0x42u32, u32);\n        cmp_setter!(\"SPX_set_tree_index\", 0xdeadbeefu32, u32);\n        cmp_setter!(\"SPX_set_tree_addr\", 0x123456789abcdef0u64, u64);\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_copy_subtree_addr / SPX_copy_keypair_addr\n// ---------------------------------------------------------------------\n#[test]\nfn test_spx_address_copies() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        for name in [\"SPX_copy_subtree_addr\", \"SPX_copy_keypair_addr\"] {\n            let c_fn: Symbol<unsafe extern \"C\" fn(*mut u32, *const u32)> =\n                cl.core.get(name.as_bytes()).unwrap();\n            let r_fn: Symbol<unsafe extern \"C\" fn(*mut u32, *const u32)> =\n                rl.get(name.as_bytes()).unwrap();\n            let src: [u32; 8] = [0x11111111, 0x22222222, 0x33333333, 0x44444444,\n                                 0x55555555, 0x66666666, 0x77777777, 0x88888888];\n            let mut a = [0xAAAAAAAAu32; 8];\n            let mut b = [0xAAAAAAAAu32; 8];\n            c_fn(a.as_mut_ptr(), src.as_ptr());\n            r_fn(b.as_mut_ptr(), src.as_ptr());\n            assert_eq!(a, b, \"{} mismatch\", name);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: blake256, blake512 (only blake feature)\n// ---------------------------------------------------------------------\n#[cfg(feature = \"blake\")]\n#[test]\nfn test_blake256() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32> =\n            cl.backend.get(b\"blake256\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32> =\n            rl.get(b\"blake256\").unwrap();\n        for inlen in [0usize, 1, 32, 64, 100, 256, 1000] {\n            let input: Vec<u8> = (0..inlen).map(|i| (i * 7 + 3) as u8).collect();\n            let mut a = [0u8; 32];\n            let mut b = [0u8; 32];\n            c_fn(a.as_mut_ptr(), input.as_ptr(), inlen as u64);\n            r_fn(b.as_mut_ptr(), input.as_ptr(), inlen as u64);\n            assert_eq!(a, b, \"blake256 mismatch inlen={}\", inlen);\n        }\n    }\n}\n\n#[cfg(feature = \"blake\")]\n#[test]\nfn test_blake512() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32> =\n            cl.backend.get(b\"blake512\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32> =\n            rl.get(b\"blake512\").unwrap();\n        for inlen in [0usize, 1, 32, 64, 100, 128, 256, 1000] {\n            let input: Vec<u8> = (0..inlen).map(|i| (i * 11 + 7) as u8).collect();\n            let mut a = [0u8; 64];\n            let mut b = [0u8; 64];\n            c_fn(a.as_mut_ptr(), input.as_ptr(), inlen as u64);\n            r_fn(b.as_mut_ptr(), input.as_ptr(), inlen as u64);\n            assert_eq!(a, b, \"blake512 mismatch inlen={}\", inlen);\n        }\n    }\n}\n\n#[cfg(feature = \"blake\")]\n#[test]\nfn test_blake256_mgf1() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, core::ffi::c_ulong, *const u8, core::ffi::c_ulong)> =\n            cl.backend.get(b\"SPX_blake256_mgf1\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, core::ffi::c_ulong, *const u8, core::ffi::c_ulong)> =\n            rl.get(b\"SPX_blake256_mgf1\").unwrap();\n        for &(inlen, outlen) in &[(8usize, 16usize), (32, 64), (50, 100), (16, 32)] {\n            let input: Vec<u8> = (0..inlen).map(|i| (i * 5 + 1) as u8).collect();\n            let mut a = vec![0u8; outlen];\n            let mut b = vec![0u8; outlen];\n            c_fn(a.as_mut_ptr(), outlen as core::ffi::c_ulong, input.as_ptr(), inlen as core::ffi::c_ulong);\n            r_fn(b.as_mut_ptr(), outlen as core::ffi::c_ulong, input.as_ptr(), inlen as core::ffi::c_ulong);\n            assert_eq!(a, b, \"blake256_mgf1 mismatch in={} out={}\", inlen, outlen);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_initialize_hash_function (verify by writing same pub_seed/sk_seed\n// then comparing the resulting context buffer byte-for-byte).\n// We need a context layout that matches. For blake/shake backends, the C ctx\n// is just pub_seed[N] || sk_seed[N]; for sha2 it's that plus state arrays;\n// for haraka it's plus tweaked tables.\n// ---------------------------------------------------------------------\n#[test]\nfn test_initialize_hash_function() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8)> =\n            get_either(&cl, b\"SPX_initialize_hash_function\");\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8)> =\n            rl.get(b\"SPX_initialize_hash_function\").unwrap();\n        let mut a = ctx_buf();\n        let mut b = ctx_buf();\n        // initialize seeds\n        for i in 0..SPX_N {\n            a[i] = (i as u8).wrapping_mul(7);\n            a[SPX_N + i] = (i as u8).wrapping_mul(11);\n            b[i] = a[i];\n            b[SPX_N + i] = a[SPX_N + i];\n        }\n        c_fn(a.as_mut_ptr());\n        r_fn(b.as_mut_ptr());\n        // For most backends, only the first 2*SPX_N bytes (seeds) are touched\n        // for blake/shake. For sha2 and haraka, more is touched. Compare only\n        // those bytes that the function definitely sets.\n        // Compare the entire buffer up to the SpxCtx size assumption.\n        let cmp_len = if cfg!(feature = \"blake\") || cfg!(feature = \"shake\") {\n            2 * SPX_N\n        } else if cfg!(feature = \"sha2\") {\n            #[cfg(any(feature = \"192s\", feature = \"192f\", feature = \"256s\", feature = \"256f\"))]\n            { 2 * SPX_N + 40 + 72 }\n            #[cfg(any(feature = \"128s\", feature = \"128f\"))]\n            { 2 * SPX_N + 40 }\n        } else {\n            // haraka: 2*N + 10*8*8 + 10*8*4\n            2 * SPX_N + 10 * 8 * 8 + 10 * 8 * 4\n        };\n        assert_eq!(&a[..cmp_len], &b[..cmp_len], \"ctx mismatch after init\");\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_prf_addr\n// ---------------------------------------------------------------------\n#[test]\nfn test_prf_addr() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8)> = get_either(&cl, b\"SPX_initialize_hash_function\");\n        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8)> = rl.get(b\"SPX_initialize_hash_function\").unwrap();\n        let prf_c: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, *const u32)> =\n            get_either(&cl, b\"SPX_prf_addr\");\n        let prf_r: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, *const u32)> =\n            rl.get(b\"SPX_prf_addr\").unwrap();\n        let mut a = ctx_buf();\n        let mut b = ctx_buf();\n        for i in 0..SPX_N {\n            a[i] = (i as u8).wrapping_mul(13).wrapping_add(2);\n            a[SPX_N + i] = (i as u8).wrapping_mul(17).wrapping_add(5);\n            b[i] = a[i];\n            b[SPX_N + i] = a[SPX_N + i];\n        }\n        init_c(a.as_mut_ptr());\n        init_r(b.as_mut_ptr());\n        let addr: [u32; 8] = [0x01020304, 0x05060708, 0x090a0b0c, 0x0d0e0f10,\n                              0x11121314, 0x15161718, 0x191a1b1c, 0x1d1e1f20];\n        let mut oa = vec![0u8; SPX_N];\n        let mut ob = vec![0u8; SPX_N];\n        prf_c(oa.as_mut_ptr(), a.as_ptr(), addr.as_ptr());\n        prf_r(ob.as_mut_ptr(), b.as_ptr(), addr.as_ptr());\n        assert_eq!(oa, ob, \"prf_addr mismatch\");\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_thash with various inblocks\n// ---------------------------------------------------------------------\n#[test]\nfn test_thash() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8)> = get_either(&cl, b\"SPX_initialize_hash_function\");\n        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8)> = rl.get(b\"SPX_initialize_hash_function\").unwrap();\n        let thash_c: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u32, *const u8, *mut u32)> =\n            get_either(&cl, b\"SPX_thash\");\n        let thash_r: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u32, *const u8, *mut u32)> =\n            rl.get(b\"SPX_thash\").unwrap();\n        let mut a = ctx_buf();\n        let mut b = ctx_buf();\n        for i in 0..SPX_N {\n            a[i] = (i as u8).wrapping_mul(3).wrapping_add(1);\n            a[SPX_N + i] = (i as u8).wrapping_mul(5).wrapping_add(2);\n            b[i] = a[i];\n            b[SPX_N + i] = a[SPX_N + i];\n        }\n        init_c(a.as_mut_ptr());\n        init_r(b.as_mut_ptr());\n        for &inblocks in &[1u32, 2u32, 8u32] {\n            let inlen = inblocks as usize * SPX_N;\n            let input: Vec<u8> = (0..inlen).map(|i| (i * 7 + 11) as u8).collect();\n            let mut addr_a: [u32; 8] = [0x10203040, 0, 0x50607080, 0,\n                                        0, 0, 0, 0];\n            let mut addr_b = addr_a;\n            let mut oa = vec![0u8; SPX_N];\n            let mut ob = vec![0u8; SPX_N];\n            thash_c(oa.as_mut_ptr(), input.as_ptr(), inblocks, a.as_ptr(), addr_a.as_mut_ptr());\n            thash_r(ob.as_mut_ptr(), input.as_ptr(), inblocks, b.as_ptr(), addr_b.as_mut_ptr());\n            assert_eq!(oa, ob, \"thash inblocks={} mismatch\", inblocks);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_chain_lengths\n// ---------------------------------------------------------------------\n#[test]\nfn test_chain_lengths() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u32, *const u8)> =\n            get_either(&cl, b\"SPX_chain_lengths\");\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u32, *const u8)> =\n            rl.get(b\"SPX_chain_lengths\").unwrap();\n\n        // SPX_WOTS_LEN1 = 8*N/4, SPX_WOTS_LEN2 = N<=8?2: N<=136?3:4 (so 3 for N>=16)\n        let len1 = 8 * SPX_N / 4;\n        let len2 = if SPX_N <= 8 { 2 } else if SPX_N <= 136 { 3 } else { 4 };\n        let total = len1 + len2;\n        let msg: Vec<u8> = (0..SPX_N).map(|i| (i * 13 + 9) as u8).collect();\n        let mut a = vec![0u32; total];\n        let mut b = vec![0u32; total];\n        c_fn(a.as_mut_ptr(), msg.as_ptr());\n        r_fn(b.as_mut_ptr(), msg.as_ptr());\n        assert_eq!(a, b, \"chain_lengths mismatch\");\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_compute_root\n// ---------------------------------------------------------------------\n#[test]\nfn test_compute_root() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8)> = get_either(&cl, b\"SPX_initialize_hash_function\");\n        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8)> = rl.get(b\"SPX_initialize_hash_function\").unwrap();\n        let cr_c: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u32, u32, *const u8, u32, *const u8, *mut u32)> =\n            get_either(&cl, b\"SPX_compute_root\");\n        let cr_r: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u32, u32, *const u8, u32, *const u8, *mut u32)> =\n            rl.get(b\"SPX_compute_root\").unwrap();\n        let mut a = ctx_buf();\n        let mut b = ctx_buf();\n        for i in 0..SPX_N {\n            a[i] = (i as u8).wrapping_mul(3);\n            a[SPX_N + i] = (i as u8).wrapping_mul(5);\n            b[i] = a[i];\n            b[SPX_N + i] = a[SPX_N + i];\n        }\n        init_c(a.as_mut_ptr());\n        init_r(b.as_mut_ptr());\n        let height = 5u32;\n        let leaf: Vec<u8> = (0..SPX_N).map(|i| (i * 7) as u8).collect();\n        let auth: Vec<u8> = (0..SPX_N * height as usize).map(|i| (i * 9 + 1) as u8).collect();\n        let mut root_a = vec![0u8; SPX_N];\n        let mut root_b = vec![0u8; SPX_N];\n        let mut addr_a = [0u32; 8];\n        let mut addr_b = [0u32; 8];\n        cr_c(root_a.as_mut_ptr(), leaf.as_ptr(), 7, 1, auth.as_ptr(), height, a.as_ptr(), addr_a.as_mut_ptr());\n        cr_r(root_b.as_mut_ptr(), leaf.as_ptr(), 7, 1, auth.as_ptr(), height, b.as_ptr(), addr_b.as_mut_ptr());\n        assert_eq!(root_a, root_b, \"compute_root mismatch\");\n        assert_eq!(addr_a, addr_b, \"compute_root addr mismatch\");\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: end-to-end signing - crypto_sign_keypair, crypto_sign, crypto_sign_open\n// ---------------------------------------------------------------------\n#[test]\nfn test_e2e_keypair_sign_verify() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        // Both libs use the deterministic randombytes_init/randombytes (rng.c).\n        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8)> = cl.core.get(b\"randombytes_init\").unwrap();\n        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8)> = rl.get(b\"randombytes_init\").unwrap();\n\n        let kp_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32> = cl.core.get(b\"crypto_sign_keypair\").unwrap();\n        let kp_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32> = rl.get(b\"crypto_sign_keypair\").unwrap();\n\n        let sign_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> =\n            cl.core.get(b\"crypto_sign\").unwrap();\n        let sign_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> =\n            rl.get(b\"crypto_sign\").unwrap();\n\n        let open_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> =\n            cl.core.get(b\"crypto_sign_open\").unwrap();\n        let open_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> =\n            rl.get(b\"crypto_sign_open\").unwrap();\n\n        let pkbytes_c: Symbol<unsafe extern \"C\" fn() -> u64> = cl.core.get(b\"crypto_sign_publickeybytes\").unwrap();\n        let skbytes_c: Symbol<unsafe extern \"C\" fn() -> u64> = cl.core.get(b\"crypto_sign_secretkeybytes\").unwrap();\n        let sigbytes_c: Symbol<unsafe extern \"C\" fn() -> u64> = cl.core.get(b\"crypto_sign_bytes\").unwrap();\n\n        let pk_len = pkbytes_c() as usize;\n        let sk_len = skbytes_c() as usize;\n        let sig_len = sigbytes_c() as usize;\n\n        // Verify Rust returns same sizes\n        let pkbytes_r: Symbol<unsafe extern \"C\" fn() -> u64> = rl.get(b\"crypto_sign_publickeybytes\").unwrap();\n        let skbytes_r: Symbol<unsafe extern \"C\" fn() -> u64> = rl.get(b\"crypto_sign_secretkeybytes\").unwrap();\n        let sigbytes_r: Symbol<unsafe extern \"C\" fn() -> u64> = rl.get(b\"crypto_sign_bytes\").unwrap();\n        assert_eq!(pkbytes_r() as usize, pk_len);\n        assert_eq!(skbytes_r() as usize, sk_len);\n        assert_eq!(sigbytes_r() as usize, sig_len);\n\n        // Init both PRGs with the same seed\n        let mut entropy = [0u8; 48];\n        for i in 0..48 { entropy[i] = i as u8; }\n        let mut entropy_c = entropy;\n        init_c(entropy_c.as_mut_ptr(), std::ptr::null_mut());\n        let mut entropy_r = entropy;\n        init_r(entropy_r.as_mut_ptr(), std::ptr::null_mut());\n\n        // Generate keys\n        let mut pk_c = vec![0u8; pk_len];\n        let mut sk_c = vec![0u8; sk_len];\n        let mut pk_r = vec![0u8; pk_len];\n        let mut sk_r = vec![0u8; sk_len];\n        kp_c(pk_c.as_mut_ptr(), sk_c.as_mut_ptr());\n        kp_r(pk_r.as_mut_ptr(), sk_r.as_mut_ptr());\n        assert_eq!(pk_c, pk_r, \"pk mismatch\");\n        assert_eq!(sk_c, sk_r, \"sk mismatch\");\n\n        // Sign a message\n        let msg: Vec<u8> = (0..33).map(|i| (i * 7 + 5) as u8).collect();\n        let mut sm_c = vec![0u8; sig_len + msg.len()];\n        let mut sm_r = vec![0u8; sig_len + msg.len()];\n        let mut smlen_c: u64 = 0;\n        let mut smlen_r: u64 = 0;\n        sign_c(sm_c.as_mut_ptr(), &mut smlen_c, msg.as_ptr(), msg.len() as u64, sk_c.as_ptr());\n        sign_r(sm_r.as_mut_ptr(), &mut smlen_r, msg.as_ptr(), msg.len() as u64, sk_r.as_ptr());\n        assert_eq!(smlen_c, smlen_r, \"smlen mismatch\");\n        assert_eq!(&sm_c[..smlen_c as usize], &sm_r[..smlen_r as usize], \"signature mismatch\");\n\n        // Verify\n        let mut m_out_c = vec![0u8; sm_c.len()];\n        let mut m_out_r = vec![0u8; sm_r.len()];\n        let mut mlen_c: u64 = 0;\n        let mut mlen_r: u64 = 0;\n        let r1 = open_c(m_out_c.as_mut_ptr(), &mut mlen_c, sm_c.as_ptr(), smlen_c, pk_c.as_ptr());\n        let r2 = open_r(m_out_r.as_mut_ptr(), &mut mlen_r, sm_r.as_ptr(), smlen_r, pk_r.as_ptr());\n        assert_eq!(r1, 0); assert_eq!(r2, 0);\n        assert_eq!(mlen_c, msg.len() as u64);\n        assert_eq!(mlen_r, msg.len() as u64);\n        assert_eq!(&m_out_c[..mlen_c as usize], &msg[..]);\n        assert_eq!(&m_out_r[..mlen_r as usize], &msg[..]);\n    }\n}\n","structuredPatch":[{"oldStart":9,"oldLines":9,"newStart":9,"newLines":7,"lines":[" // ---------------------------------------------------------------------"," "," fn find_rust_so() -> PathBuf {","-    // The crate's lib (cdylib) is built next to test binaries.","     let exe = std::env::current_exe().unwrap();","-    // tests are in target/debug/deps/<name>-hash; lib is target/debug/libsphincs_plus.so","     let mut dir = exe.parent().unwrap().to_path_buf();","     while dir.parent().is_some() {","         let candidate = dir.join(\"libsphincs_plus.so\");"]},{"oldStart":42,"oldLines":13,"newStart":40,"newLines":12,"lines":[" }"," "," struct CLibs {","-    _backend: Library,","+    backend: Library,","     core: Library,"," }"," "," impl CLibs {","     fn load() -> Self {","-        // Determine which backend based on cargo features","         let backend_name = if cfg!(feature = \"blake\") {","             \"blake\"","         } else if cfg!(feature = \"haraka\") {"]},{"oldStart":61,"oldLines":10,"newStart":58,"newLines":9,"lines":["             panic!(\"no backend feature enabled\");","         };","         unsafe {","-            // Load backend first (so its symbols are available for the core library)","             let backend = Library::new(find_c_so(backend_name)).expect(\"c backend lib\");","             let core = Library::new(find_c_so(\"core_det\")).expect(\"c core lib\");","-            CLibs { _backend: backend, core }","+            CLibs { backend, core }","         }","     }"," }"]},{"oldStart":73,"oldLines":7,"newStart":69,"newLines":39,"lines":["     unsafe { Library::new(find_rust_so()).expect(\"rust lib\") }"," }"," ","+// Resolve a symbol from either the core or backend library.","+unsafe fn get_either<T>(libs: &CLibs, name: &[u8]) -> Symbol<'_, T> {","+    unsafe {","+        if let Ok(s) = libs.core.get::<T>(name) {","+            return s;","+        }","+        libs.backend.get::<T>(name).unwrap_or_else(|e| panic!(\"symbol {} not found: {}\", String::from_utf8_lossy(name), e))","+    }","+}","+"," // ---------------------------------------------------------------------","+// SPX_N and other params from the cargo features (must match C).","+// ---------------------------------------------------------------------","+#[cfg(feature = \"128s\")]","+const SPX_N: usize = 16;","+#[cfg(feature = \"128f\")]","+const SPX_N: usize = 16;","+#[cfg(feature = \"192s\")]","+const SPX_N: usize = 24;","+#[cfg(feature = \"192f\")]","+const SPX_N: usize = 24;","+#[cfg(feature = \"256s\")]","+const SPX_N: usize = 32;","+#[cfg(feature = \"256f\")]","+const SPX_N: usize = 32;","+","+// SpxCtx size depends on backend.","+fn ctx_buf() -> Vec<u8> {","+    // Generous size: 2*SPX_N + 40 + 72 + 10*8*8 + 10*8*4 = 2*SPX_N + 1192","+    vec![0u8; 2 * SPX_N + 2048]","+}","+","+// ---------------------------------------------------------------------"," // Test: SPX_u32_to_bytes"," // ---------------------------------------------------------------------"," #[test]"]},{"oldStart":82,"oldLines":7,"newStart":110,"newLines":7,"lines":["     let rl = load_rust();","     unsafe {","         let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, u32)> =","-            cl.core.get(b\"SPX_u32_to_bytes\").unwrap();","+            get_either(&cl, b\"SPX_u32_to_bytes\");","         let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, u32)> =","             rl.get(b\"SPX_u32_to_bytes\").unwrap();","         for v in [0u32, 1, 0xdeadbeef, 0xffffffff, 0x12345678] {"]},{"oldStart":104,"oldLines":11,"newStart":132,"newLines":11,"lines":["     let rl = load_rust();","     unsafe {","         let c_fn_to: Symbol<unsafe extern \"C\" fn(*mut u8, u32, u64)> =","-            cl.core.get(b\"SPX_ull_to_bytes\").unwrap();","+            get_either(&cl, b\"SPX_ull_to_bytes\");","         let r_fn_to: Symbol<unsafe extern \"C\" fn(*mut u8, u32, u64)> =","             rl.get(b\"SPX_ull_to_bytes\").unwrap();","         let c_fn_from: Symbol<unsafe extern \"C\" fn(*const u8, u32) -> u64> =","-            cl.core.get(b\"SPX_bytes_to_ull\").unwrap();","+            get_either(&cl, b\"SPX_bytes_to_ull\");","         let r_fn_from: Symbol<unsafe extern \"C\" fn(*const u8, u32) -> u64> =","             rl.get(b\"SPX_bytes_to_ull\").unwrap();","         for v in [0u64, 1, 0x123456789abcdef0, 0xffffffffffffffff] {"]},{"oldStart":118,"oldLines":7,"newStart":146,"newLines":6,"lines":["                 c_fn_to(a.as_mut_ptr(), outlen, v);","                 r_fn_to(b.as_mut_ptr(), outlen, v);","                 assert_eq!(a, b, \"ull_to_bytes mismatch v={:x} len={}\", v, outlen);","-","                 let cv = c_fn_from(a.as_ptr(), outlen);","                 let rv = r_fn_from(b.as_ptr(), outlen);","                 assert_eq!(cv, rv);"]},{"oldStart":186,"oldLines":3,"newStart":213,"newLines":337,"lines":["         }","     }"," }","+","+// ---------------------------------------------------------------------","+// Test: blake256, blake512 (only blake feature)","+// ---------------------------------------------------------------------","+#[cfg(feature = \"blake\")]","+#[test]","+fn test_blake256() {","+    let cl = CLibs::load();","+    let rl = load_rust();","+    unsafe {","+        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32> =","+            cl.backend.get(b\"blake256\").unwrap();","+        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32> =","+            rl.get(b\"blake256\").unwrap();","+        for inlen in [0usize, 1, 32, 64, 100, 256, 1000] {","+            let input: Vec<u8> = (0..inlen).map(|i| (i * 7 + 3) as u8).collect();","+            let mut a = [0u8; 32];","+            let mut b = [0u8; 32];","+            c_fn(a.as_mut_ptr(), input.as_ptr(), inlen as u64);","+            r_fn(b.as_mut_ptr(), input.as_ptr(), inlen as u64);","+            assert_eq!(a, b, \"blake256 mismatch inlen={}\", inlen);","+        }","+    }","+}","+","+#[cfg(feature = \"blake\")]","+#[test]","+fn test_blake512() {","+    let cl = CLibs::load();","+    let rl = load_rust();","+    unsafe {","+        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32> =","+            cl.backend.get(b\"blake512\").unwrap();","+        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32> =","+            rl.get(b\"blake512\").unwrap();","+        for inlen in [0usize, 1, 32, 64, 100, 128, 256, 1000] {","+            let input: Vec<u8> = (0..inlen).map(|i| (i * 11 + 7) as u8).collect();","+            let mut a = [0u8; 64];","+            let mut b = [0u8; 64];","+            c_fn(a.as_mut_ptr(), input.as_ptr(), inlen as u64);","+            r_fn(b.as_mut_ptr(), input.as_ptr(), inlen as u64);","+            assert_eq!(a, b, \"blake512 mismatch inlen={}\", inlen);","+        }","+    }","+}","+","+#[cfg(feature = \"blake\")]","+#[test]","+fn test_blake256_mgf1() {","+    let cl = CLibs::load();","+    let rl = load_rust();","+    unsafe {","+        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, core::ffi::c_ulong, *const u8, core::ffi::c_ulong)> =","+            cl.backend.get(b\"SPX_blake256_mgf1\").unwrap();","+        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, core::ffi::c_ulong, *const u8, core::ffi::c_ulong)> =","+            rl.get(b\"SPX_blake256_mgf1\").unwrap();","+        for &(inlen, outlen) in &[(8usize, 16usize), (32, 64), (50, 100), (16, 32)] {","+            let input: Vec<u8> = (0..inlen).map(|i| (i * 5 + 1) as u8).collect();","+            let mut a = vec![0u8; outlen];","+            let mut b = vec![0u8; outlen];","+            c_fn(a.as_mut_ptr(), outlen as core::ffi::c_ulong, input.as_ptr(), inlen as core::ffi::c_ulong);","+            r_fn(b.as_mut_ptr(), outlen as core::ffi::c_ulong, input.as_ptr(), inlen as core::ffi::c_ulong);","+            assert_eq!(a, b, \"blake256_mgf1 mismatch in={} out={}\", inlen, outlen);","+        }","+    }","+}","+","+// ---------------------------------------------------------------------","+// Test: SPX_initialize_hash_function (verify by writing same pub_seed/sk_seed","+// then comparing the resulting context buffer byte-for-byte).","+// We need a context layout that matches. For blake/shake backends, the C ctx","+// is just pub_seed[N] || sk_seed[N]; for sha2 it's that plus state arrays;","+// for haraka it's plus tweaked tables.","+// ---------------------------------------------------------------------","+#[test]","+fn test_initialize_hash_function() {","+    let cl = CLibs::load();","+    let rl = load_rust();","+    unsafe {","+        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8)> =","+            get_either(&cl, b\"SPX_initialize_hash_function\");","+        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8)> =","+            rl.get(b\"SPX_initialize_hash_function\").unwrap();","+        let mut a = ctx_buf();","+        let mut b = ctx_buf();","+        // initialize seeds","+        for i in 0..SPX_N {","+            a[i] = (i as u8).wrapping_mul(7);","+            a[SPX_N + i] = (i as u8).wrapping_mul(11);","+            b[i] = a[i];","+            b[SPX_N + i] = a[SPX_N + i];","+        }","+        c_fn(a.as_mut_ptr());","+        r_fn(b.as_mut_ptr());","+        // For most backends, only the first 2*SPX_N bytes (seeds) are touched","+        // for blake/shake. For sha2 and haraka, more is touched. Compare only","+        // those bytes that the function definitely sets.","+        // Compare the entire buffer up to the SpxCtx size assumption.","+        let cmp_len = if cfg!(feature = \"blake\") || cfg!(feature = \"shake\") {","+            2 * SPX_N","+        } else if cfg!(feature = \"sha2\") {","+            #[cfg(any(feature = \"192s\", feature = \"192f\", feature = \"256s\", feature = \"256f\"))]","+            { 2 * SPX_N + 40 + 72 }","+            #[cfg(any(feature = \"128s\", feature = \"128f\"))]","+            { 2 * SPX_N + 40 }","+        } else {","+            // haraka: 2*N + 10*8*8 + 10*8*4","+            2 * SPX_N + 10 * 8 * 8 + 10 * 8 * 4","+        };","+        assert_eq!(&a[..cmp_len], &b[..cmp_len], \"ctx mismatch after init\");","+    }","+}","+","+// ---------------------------------------------------------------------","+// Test: SPX_prf_addr","+// ---------------------------------------------------------------------","+#[test]","+fn test_prf_addr() {","+    let cl = CLibs::load();","+    let rl = load_rust();","+    unsafe {","+        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8)> = get_either(&cl, b\"SPX_initialize_hash_function\");","+        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8)> = rl.get(b\"SPX_initialize_hash_function\").unwrap();","+        let prf_c: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, *const u32)> =","+            get_either(&cl, b\"SPX_prf_addr\");","+        let prf_r: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, *const u32)> =","+            rl.get(b\"SPX_prf_addr\").unwrap();","+        let mut a = ctx_buf();","+        let mut b = ctx_buf();","+        for i in 0..SPX_N {","+            a[i] = (i as u8).wrapping_mul(13).wrapping_add(2);","+            a[SPX_N + i] = (i as u8).wrapping_mul(17).wrapping_add(5);","+            b[i] = a[i];","+            b[SPX_N + i] = a[SPX_N + i];","+        }","+        init_c(a.as_mut_ptr());","+        init_r(b.as_mut_ptr());","+        let addr: [u32; 8] = [0x01020304, 0x05060708, 0x090a0b0c, 0x0d0e0f10,","+                              0x11121314, 0x15161718, 0x191a1b1c, 0x1d1e1f20];","+        let mut oa = vec![0u8; SPX_N];","+        let mut ob = vec![0u8; SPX_N];","+        prf_c(oa.as_mut_ptr(), a.as_ptr(), addr.as_ptr());","+        prf_r(ob.as_mut_ptr(), b.as_ptr(), addr.as_ptr());","+        assert_eq!(oa, ob, \"prf_addr mismatch\");","+    }","+}","+","+// ---------------------------------------------------------------------","+// Test: SPX_thash with various inblocks","+// ---------------------------------------------------------------------","+#[test]","+fn test_thash() {","+    let cl = CLibs::load();","+    let rl = load_rust();","+    unsafe {","+        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8)> = get_either(&cl, b\"SPX_initialize_hash_function\");","+        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8)> = rl.get(b\"SPX_initialize_hash_function\").unwrap();","+        let thash_c: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u32, *const u8, *mut u32)> =","+            get_either(&cl, b\"SPX_thash\");","+        let thash_r: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u32, *const u8, *mut u32)> =","+            rl.get(b\"SPX_thash\").unwrap();","+        let mut a = ctx_buf();","+        let mut b = ctx_buf();","+        for i in 0..SPX_N {","+            a[i] = (i as u8).wrapping_mul(3).wrapping_add(1);","+            a[SPX_N + i] = (i as u8).wrapping_mul(5).wrapping_add(2);","+            b[i] = a[i];","+            b[SPX_N + i] = a[SPX_N + i];","+        }","+        init_c(a.as_mut_ptr());","+        init_r(b.as_mut_ptr());","+        for &inblocks in &[1u32, 2u32, 8u32] {","+            let inlen = inblocks as usize * SPX_N;","+            let input: Vec<u8> = (0..inlen).map(|i| (i * 7 + 11) as u8).collect();","+            let mut addr_a: [u32; 8] = [0x10203040, 0, 0x50607080, 0,","+                                        0, 0, 0, 0];","+            let mut addr_b = addr_a;","+            let mut oa = vec![0u8; SPX_N];","+            let mut ob = vec![0u8; SPX_N];","+            thash_c(oa.as_mut_ptr(), input.as_ptr(), inblocks, a.as_ptr(), addr_a.as_mut_ptr());","+            thash_r(ob.as_mut_ptr(), input.as_ptr(), inblocks, b.as_ptr(), addr_b.as_mut_ptr());","+            assert_eq!(oa, ob, \"thash inblocks={} mismatch\", inblocks);","+        }","+    }","+}","+","+// ---------------------------------------------------------------------","+// Test: SPX_chain_lengths","+// ---------------------------------------------------------------------","+#[test]","+fn test_chain_lengths() {","+    let cl = CLibs::load();","+    let rl = load_rust();","+    unsafe {","+        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u32, *const u8)> =","+            get_either(&cl, b\"SPX_chain_lengths\");","+        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u32, *const u8)> =","+            rl.get(b\"SPX_chain_lengths\").unwrap();","+","+        // SPX_WOTS_LEN1 = 8*N/4, SPX_WOTS_LEN2 = N<=8?2: N<=136?3:4 (so 3 for N>=16)","+        let len1 = 8 * SPX_N / 4;","+        let len2 = if SPX_N <= 8 { 2 } else if SPX_N <= 136 { 3 } else { 4 };","+        let total = len1 + len2;","+        let msg: Vec<u8> = (0..SPX_N).map(|i| (i * 13 + 9) as u8).collect();","+        let mut a = vec![0u32; total];","+        let mut b = vec![0u32; total];","+        c_fn(a.as_mut_ptr(), msg.as_ptr());","+        r_fn(b.as_mut_ptr(), msg.as_ptr());","+        assert_eq!(a, b, \"chain_lengths mismatch\");","+    }","+}","+","+// ---------------------------------------------------------------------","+// Test: SPX_compute_root","+// ---------------------------------------------------------------------","+#[test]","+fn test_compute_root() {","+    let cl = CLibs::load();","+    let rl = load_rust();","+    unsafe {","+        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8)> = get_either(&cl, b\"SPX_initialize_hash_function\");","+        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8)> = rl.get(b\"SPX_initialize_hash_function\").unwrap();","+        let cr_c: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u32, u32, *const u8, u32, *const u8, *mut u32)> =","+            get_either(&cl, b\"SPX_compute_root\");","+        let cr_r: Symbol<unsafe extern \"C\" fn(*mut u8, *const u8, u32, u32, *const u8, u32, *const u8, *mut u32)> =","+            rl.get(b\"SPX_compute_root\").unwrap();","+        let mut a = ctx_buf();","+        let mut b = ctx_buf();","+        for i in 0..SPX_N {","+            a[i] = (i as u8).wrapping_mul(3);","+            a[SPX_N + i] = (i as u8).wrapping_mul(5);","+            b[i] = a[i];","+            b[SPX_N + i] = a[SPX_N + i];","+        }","+        init_c(a.as_mut_ptr());","+        init_r(b.as_mut_ptr());","+        let height = 5u32;","+        let leaf: Vec<u8> = (0..SPX_N).map(|i| (i * 7) as u8).collect();","+        let auth: Vec<u8> = (0..SPX_N * height as usize).map(|i| (i * 9 + 1) as u8).collect();","+        let mut root_a = vec![0u8; SPX_N];","+        let mut root_b = vec![0u8; SPX_N];","+        let mut addr_a = [0u32; 8];","+        let mut addr_b = [0u32; 8];","+        cr_c(root_a.as_mut_ptr(), leaf.as_ptr(), 7, 1, auth.as_ptr(), height, a.as_ptr(), addr_a.as_mut_ptr());","+        cr_r(root_b.as_mut_ptr(), leaf.as_ptr(), 7, 1, auth.as_ptr(), height, b.as_ptr(), addr_b.as_mut_ptr());","+        assert_eq!(root_a, root_b, \"compute_root mismatch\");","+        assert_eq!(addr_a, addr_b, \"compute_root addr mismatch\");","+    }","+}","+","+// ---------------------------------------------------------------------","+// Test: end-to-end signing - crypto_sign_keypair, crypto_sign, crypto_sign_open","+// ---------------------------------------------------------------------","+#[test]","+fn test_e2e_keypair_sign_verify() {","+    let cl = CLibs::load();","+    let rl = load_rust();","+    unsafe {","+        // Both libs use the deterministic randombytes_init/randombytes (rng.c).","+        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8)> = cl.core.get(b\"randombytes_init\").unwrap();","+        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8)> = rl.get(b\"randombytes_init\").unwrap();","+","+        let kp_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32> = cl.core.get(b\"crypto_sign_keypair\").unwrap();","+        let kp_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32> = rl.get(b\"crypto_sign_keypair\").unwrap();","+","+        let sign_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> =","+            cl.core.get(b\"crypto_sign\").unwrap();","+        let sign_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> =","+            rl.get(b\"crypto_sign\").unwrap();","+","+        let open_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> =","+            cl.core.get(b\"crypto_sign_open\").unwrap();","+        let open_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> =","+            rl.get(b\"crypto_sign_open\").unwrap();","+","+        let pkbytes_c: Symbol<unsafe extern \"C\" fn() -> u64> = cl.core.get(b\"crypto_sign_publickeybytes\").unwrap();","+        let skbytes_c: Symbol<unsafe extern \"C\" fn() -> u64> = cl.core.get(b\"crypto_sign_secretkeybytes\").unwrap();","+        let sigbytes_c: Symbol<unsafe extern \"C\" fn() -> u64> = cl.core.get(b\"crypto_sign_bytes\").unwrap();","+","+        let pk_len = pkbytes_c() as usize;","+        let sk_len = skbytes_c() as usize;","+        let sig_len = sigbytes_c() as usize;","+","+        // Verify Rust returns same sizes","+        let pkbytes_r: Symbol<unsafe extern \"C\" fn() -> u64> = rl.get(b\"crypto_sign_publickeybytes\").unwrap();","+        let skbytes_r: Symbol<unsafe extern \"C\" fn() -> u64> = rl.get(b\"crypto_sign_secretkeybytes\").unwrap();","+        let sigbytes_r: Symbol<unsafe extern \"C\" fn() -> u64> = rl.get(b\"crypto_sign_bytes\").unwrap();","+        assert_eq!(pkbytes_r() as usize, pk_len);","+        assert_eq!(skbytes_r() as usize, sk_len);","+        assert_eq!(sigbytes_r() as usize, sig_len);","+","+        // Init both PRGs with the same seed","+        let mut entropy = [0u8; 48];","+        for i in 0..48 { entropy[i] = i as u8; }","+        let mut entropy_c = entropy;","+        init_c(entropy_c.as_mut_ptr(), std::ptr::null_mut());","+        let mut entropy_r = entropy;","+        init_r(entropy_r.as_mut_ptr(), std::ptr::null_mut());","+","+        // Generate keys","+        let mut pk_c = vec![0u8; pk_len];","+        let mut sk_c = vec![0u8; sk_len];","+        let mut pk_r = vec![0u8; pk_len];","+        let mut sk_r = vec![0u8; sk_len];","+        kp_c(pk_c.as_mut_ptr(), sk_c.as_mut_ptr());","+        kp_r(pk_r.as_mut_ptr(), sk_r.as_mut_ptr());","+        assert_eq!(pk_c, pk_r, \"pk mismatch\");","+        assert_eq!(sk_c, sk_r, \"sk mismatch\");","+","+        // Sign a message","+        let msg: Vec<u8> = (0..33).map(|i| (i * 7 + 5) as u8).collect();","+        let mut sm_c = vec![0u8; sig_len + msg.len()];","+        let mut sm_r = vec![0u8; sig_len + msg.len()];","+        let mut smlen_c: u64 = 0;","+        let mut smlen_r: u64 = 0;","+        sign_c(sm_c.as_mut_ptr(), &mut smlen_c, msg.as_ptr(), msg.len() as u64, sk_c.as_ptr());","+        sign_r(sm_r.as_mut_ptr(), &mut smlen_r, msg.as_ptr(), msg.len() as u64, sk_r.as_ptr());","+        assert_eq!(smlen_c, smlen_r, \"smlen mismatch\");","+        assert_eq!(&sm_c[..smlen_c as usize], &sm_r[..smlen_r as usize], \"signature mismatch\");","+","+        // Verify","+        let mut m_out_c = vec![0u8; sm_c.len()];","+        let mut m_out_r = vec![0u8; sm_r.len()];","+        let mut mlen_c: u64 = 0;","+        let mut mlen_r: u64 = 0;","+        let r1 = open_c(m_out_c.as_mut_ptr(), &mut mlen_c, sm_c.as_ptr(), smlen_c, pk_c.as_ptr());","+        let r2 = open_r(m_out_r.as_mut_ptr(), &mut mlen_r, sm_r.as_ptr(), smlen_r, pk_r.as_ptr());","+        assert_eq!(r1, 0); assert_eq!(r2, 0);","+        assert_eq!(mlen_c, msg.len() as u64);","+        assert_eq!(mlen_r, msg.len() as u64);","+        assert_eq!(&m_out_c[..mlen_c as usize], &msg[..]);","+        assert_eq!(&m_out_r[..mlen_r as usize], &msg[..]);","+    }","+}"]}],"originalFile":"// FFI comparison tests: load both the C .so and Rust .so via libloading,\n// invoke matching exports, and compare outputs byte-for-byte.\n\nuse libloading::{Library, Symbol};\nuse std::path::PathBuf;\n\n// ---------------------------------------------------------------------\n// Helpers: locate the .so files.\n// ---------------------------------------------------------------------\n\nfn find_rust_so() -> PathBuf {\n    // The crate's lib (cdylib) is built next to test binaries.\n    let exe = std::env::current_exe().unwrap();\n    // tests are in target/debug/deps/<name>-hash; lib is target/debug/libsphincs_plus.so\n    let mut dir = exe.parent().unwrap().to_path_buf();\n    while dir.parent().is_some() {\n        let candidate = dir.join(\"libsphincs_plus.so\");\n        if candidate.exists() {\n            return candidate;\n        }\n        dir = dir.parent().unwrap().to_path_buf();\n    }\n    panic!(\"could not locate libsphincs_plus.so\");\n}\n\nfn find_c_so(name: &str) -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    if name == \"blake\" || name == \"haraka\" || name == \"sha2\" || name == \"shake\" {\n        p.push(\"lib\");\n        p.push(name);\n        p.push(format!(\"lib{}.so\", name));\n    } else if name == \"core_det\" {\n        p.push(\"app\");\n        p.push(\"libsphincs_core_det.so\");\n    } else if name == \"core\" {\n        p.push(\"app\");\n        p.push(\"libsphincs_core.so\");\n    }\n    p\n}\n\nstruct CLibs {\n    _backend: Library,\n    core: Library,\n}\n\nimpl CLibs {\n    fn load() -> Self {\n        // Determine which backend based on cargo features\n        let backend_name = if cfg!(feature = \"blake\") {\n            \"blake\"\n        } else if cfg!(feature = \"haraka\") {\n            \"haraka\"\n        } else if cfg!(feature = \"sha2\") {\n            \"sha2\"\n        } else if cfg!(feature = \"shake\") {\n            \"shake\"\n        } else {\n            panic!(\"no backend feature enabled\");\n        };\n        unsafe {\n            // Load backend first (so its symbols are available for the core library)\n            let backend = Library::new(find_c_so(backend_name)).expect(\"c backend lib\");\n            let core = Library::new(find_c_so(\"core_det\")).expect(\"c core lib\");\n            CLibs { _backend: backend, core }\n        }\n    }\n}\n\nfn load_rust() -> Library {\n    unsafe { Library::new(find_rust_so()).expect(\"rust lib\") }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_u32_to_bytes\n// ---------------------------------------------------------------------\n#[test]\nfn test_spx_u32_to_bytes() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut u8, u32)> =\n            cl.core.get(b\"SPX_u32_to_bytes\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut u8, u32)> =\n            rl.get(b\"SPX_u32_to_bytes\").unwrap();\n        for v in [0u32, 1, 0xdeadbeef, 0xffffffff, 0x12345678] {\n            let mut a = [0u8; 4];\n            let mut b = [0u8; 4];\n            c_fn(a.as_mut_ptr(), v);\n            r_fn(b.as_mut_ptr(), v);\n            assert_eq!(a, b, \"u32_to_bytes mismatch for {:08x}\", v);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_bytes_to_ull and SPX_ull_to_bytes\n// ---------------------------------------------------------------------\n#[test]\nfn test_spx_bytes_ull_roundtrip() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        let c_fn_to: Symbol<unsafe extern \"C\" fn(*mut u8, u32, u64)> =\n            cl.core.get(b\"SPX_ull_to_bytes\").unwrap();\n        let r_fn_to: Symbol<unsafe extern \"C\" fn(*mut u8, u32, u64)> =\n            rl.get(b\"SPX_ull_to_bytes\").unwrap();\n        let c_fn_from: Symbol<unsafe extern \"C\" fn(*const u8, u32) -> u64> =\n            cl.core.get(b\"SPX_bytes_to_ull\").unwrap();\n        let r_fn_from: Symbol<unsafe extern \"C\" fn(*const u8, u32) -> u64> =\n            rl.get(b\"SPX_bytes_to_ull\").unwrap();\n        for v in [0u64, 1, 0x123456789abcdef0, 0xffffffffffffffff] {\n            for outlen in [1u32, 2, 4, 8] {\n                let mut a = vec![0u8; outlen as usize];\n                let mut b = vec![0u8; outlen as usize];\n                c_fn_to(a.as_mut_ptr(), outlen, v);\n                r_fn_to(b.as_mut_ptr(), outlen, v);\n                assert_eq!(a, b, \"ull_to_bytes mismatch v={:x} len={}\", v, outlen);\n\n                let cv = c_fn_from(a.as_ptr(), outlen);\n                let rv = r_fn_from(b.as_ptr(), outlen);\n                assert_eq!(cv, rv);\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_set_*_addr family\n// ---------------------------------------------------------------------\n#[test]\nfn test_spx_address_setters() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        macro_rules! cmp_setter {\n            ($name:literal, $val:expr, $val_type:ty) => {{\n                let c_fn: Symbol<unsafe extern \"C\" fn(*mut u32, $val_type)> =\n                    cl.core.get($name.as_bytes()).unwrap();\n                let r_fn: Symbol<unsafe extern \"C\" fn(*mut u32, $val_type)> =\n                    rl.get($name.as_bytes()).unwrap();\n                let mut a = [0u32; 8];\n                let mut b = [0u32; 8];\n                for i in 0..8 {\n                    a[i] = (i as u32) * 0x10101010 + 0x07060504;\n                    b[i] = a[i];\n                }\n                c_fn(a.as_mut_ptr(), $val);\n                r_fn(b.as_mut_ptr(), $val);\n                assert_eq!(a, b, \"{} mismatch\", $name);\n            }};\n        }\n        cmp_setter!(\"SPX_set_layer_addr\", 0x42u32, u32);\n        cmp_setter!(\"SPX_set_type\", 0x03u32, u32);\n        cmp_setter!(\"SPX_set_keypair_addr\", 0xdeadbeefu32, u32);\n        cmp_setter!(\"SPX_set_chain_addr\", 0x55u32, u32);\n        cmp_setter!(\"SPX_set_hash_addr\", 0xaau32, u32);\n        cmp_setter!(\"SPX_set_tree_height\", 0x42u32, u32);\n        cmp_setter!(\"SPX_set_tree_index\", 0xdeadbeefu32, u32);\n        cmp_setter!(\"SPX_set_tree_addr\", 0x123456789abcdef0u64, u64);\n    }\n}\n\n// ---------------------------------------------------------------------\n// Test: SPX_copy_subtree_addr / SPX_copy_keypair_addr\n// ---------------------------------------------------------------------\n#[test]\nfn test_spx_address_copies() {\n    let cl = CLibs::load();\n    let rl = load_rust();\n    unsafe {\n        for name in [\"SPX_copy_subtree_addr\", \"SPX_copy_keypair_addr\"] {\n            let c_fn: Symbol<unsafe extern \"C\" fn(*mut u32, *const u32)> =\n                cl.core.get(name.as_bytes()).unwrap();\n            let r_fn: Symbol<unsafe extern \"C\" fn(*mut u32, *const u32)> =\n                rl.get(name.as_bytes()).unwrap();\n            let src: [u32; 8] = [0x11111111, 0x22222222, 0x33333333, 0x44444444,\n                                 0x55555555, 0x66666666, 0x77777777, 0x88888888];\n            let mut a = [0xAAAAAAAAu32; 8];\n            let mut b = [0xAAAAAAAAu32; 8];\n            c_fn(a.as_mut_ptr(), src.as_ptr());\n            r_fn(b.as_mut_ptr(), src.as_ptr());\n            assert_eq!(a, b, \"{} mismatch\", name);\n        }\n    }\n}\n","userModified":false}}
