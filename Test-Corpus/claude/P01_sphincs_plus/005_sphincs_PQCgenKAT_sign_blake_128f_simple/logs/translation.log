;\n    maxlen >>= 8;\n    ctx->ctr[9] = (unsigned char)(maxlen % 256);\n    maxlen >>= 8;\n    ctx->ctr[8] = (unsigned char)(maxlen % 256);\n    memset(ctx->ctr+12, 0x00, 4);\n    ctx->buffer_pos = 16;\n    memset(ctx->buffer, 0x00, 16);\n    return RNG_SUCCESS;\n}\n\nint seedexpander(AES_XOF_struct *ctx, unsigned char *x, unsigned long xlen)\n{\n    unsigned long   offset;\n    if ( x == NULL )\n        return RNG_BAD_OUTBUF;\n    if ( xlen >= ctx->length_remaining )\n        return RNG_BAD_REQ_LEN;\n    ctx->length_remaining -= xlen;\n    offset = 0;\n    while ( xlen > 0 ) {\n        if ( xlen <= (16-ctx->buffer_pos) ) {\n            memcpy(x+offset, ctx->buffer+ctx->buffer_pos, xlen);\n            ctx->buffer_pos += xlen;\n            return RNG_SUCCESS;\n        }\n        memcpy(x+offset, ctx->buffer+ctx->buffer_pos, 16-ctx->buffer_pos);\n        xlen -= 16-ctx->buffer_pos;\n        offset += 16-ctx->buffer_pos;\n        AES256_ECB(ctx->key, ctx->ctr, ctx->buffer);\n        ctx->buffer_pos = 0;\n        for (int i=15; i>=12; i--) {\n            if ( ctx->ctr[i] == 0xff )\n                ctx->ctr[i] = 0x00;\n            else {\n                ctx->ctr[i]++;\n                break;\n            }\n        }\n    }\n    return RNG_SUCCESS;\n}\n\n// AES256_ECB uses OpenSSL - key is 256-bit, ctr is 128-bit plaintext, buffer is 128-bit ciphertext\nvoid AES256_ECB(unsigned char *key, unsigned char *ctr, unsigned char *buffer)\n{\n    EVP_CIPHER_CTX *ctx;\n    int len;\n    if(!(ctx = EVP_CIPHER_CTX_new())) abort();\n    if(1 != EVP_EncryptInit_ex(ctx, EVP_aes_256_ecb(), NULL, key, NULL)) abort();\n    if(1 != EVP_EncryptUpdate(ctx, buffer, &len, ctr, 16)) abort();\n    EVP_CIPHER_CTX_free(ctx);\n}\n\nvoid randombytes_init(unsigned char *entropy_input, unsigned char *personalization_string)\n{\n    unsigned char   seed_material[48];\n    memcpy(seed_material, entropy_input, 48);\n    if (personalization_string)\n        for (int i=0; i<48; i++)\n            seed_material[i] ^= personalization_string[i];\n    memset(DRBG_ctx.Key, 0x00, 32);\n    memset(DRBG_ctx.V, 0x00, 16);\n    AES256_CTR_DRBG_Update(seed_material, DRBG_ctx.Key, DRBG_ctx.V);\n    DRBG_ctx.reseed_counter = 1;\n}\n\nint randombytes(unsigned char *x, unsigned long long xlen)\n{\n    unsigned char   block[16];\n    int             i = 0;\n    while ( xlen > 0 ) {\n        for (int j=15; j>=0; j--) {\n            if ( DRBG_ctx.V[j] == 0xff )\n                DRBG_ctx.V[j] = 0x00;\n            else {\n                DRBG_ctx.V[j]++;\n                break;\n            }\n        }\n        AES256_ECB(DRBG_ctx.Key, DRBG_ctx.V, block);\n        if ( xlen > 15 ) {\n            memcpy(x+i, block, 16);\n            i += 16;\n            xlen -= 16;\n        }\n        else {\n            memcpy(x+i, block, xlen);\n            xlen = 0;\n        }\n    }\n    AES256_CTR_DRBG_Update(NULL, DRBG_ctx.Key, DRBG_ctx.V);\n    DRBG_ctx.reseed_counter++;\n    return 0;\n}\n\nvoid AES256_CTR_DRBG_Update(unsigned char *provided_data, unsigned char *Key, unsigned char *V)\n{\n    unsigned char   temp[48];\n    for (int i=0; i<3; i++) {\n        for (int j=15; j>=0; j--) {\n            if ( V[j] == 0xff )\n                V[j] = 0x00;\n            else {\n                V[j]++;\n                break;\n            }\n        }\n        AES256_ECB(Key, V, temp+16*i);\n    }\n    if ( provided_data != NULL )\n        for (int i=0; i<48; i++)\n            temp[i] ^= provided_data[i];\n    memcpy(Key, temp, 32);\n    memcpy(V, temp+32, 16);\n}\n```\n\nKey requirements:\n1. Use `aes::Aes256` with `cipher::{BlockEncrypt, KeyInit}` for AES-256-ECB\n2. Use a static mutable global for DRBG_ctx (use unsafe + static mut, or std::sync::Mutex - prefer static mut for byte-identical behavior)\n3. The `randombytes` function signature should be: `pub fn randombytes(x: &mut [u8], xlen: u64)`\n4. The `randombytes_init` function takes entropy_input as &[u8] and optional personalization_string as Option<&[u8]>\n5. AES256_ECB must encrypt a single 16-byte block using AES-256 in ECB mode with NO padding\n6. Note: OpenSSL's EVP_EncryptUpdate with ECB mode and 16 bytes input produces exactly 16 bytes output (no padding added since we never call EncryptFinal)\n\nIMPORTANT: For AES, use `GenericArray` from the `cipher` crate. Example:\n```rust\nuse aes::Aes256;\nuse aes::cipher::{BlockEncrypt, KeyInit, generic_array::GenericArray};\n\nfn aes256_ecb(key: &[u8; 32], plaintext: &[u8; 16], ciphertext: &mut [u8; 16]) {\n    let cipher = Aes256::new(GenericArray::from_slice(key));\n    let mut block = GenericArray::clone_from_slice(plaintext);\n    cipher.encrypt_block(&mut block);\n    ciphertext.copy_from_slice(&block);\n}\n```\n\nWrite ONLY the file, no explanations.","agentId":"adbb99caaac7dac39","agentType":"general-purpose","content":[{"type":"text","text":"File written to `/tmp/harvest-translate-qHL6TU/translated_rust/src/rng.rs`. The translation covers all functions from the C source: `seedexpander_init`, `seedexpander`, `AES256_ECB`, `randombytes_init`, `randombytes`, and `AES256_CTR_DRBG_Update`, using `aes::Aes256` with `cipher::{BlockEncrypt, KeyInit}` instead of OpenSSL."}],"totalDurationMs":29723,"totalTokens":12666,"totalToolUseCount":1,"usage":{"input_tokens":1,"cache_creation_input_tokens":2726,"cache_read_input_tokens":9822,"output_tokens":117,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":2726},"inference_geo":"","iterations":[],"speed":"standard"}}}
