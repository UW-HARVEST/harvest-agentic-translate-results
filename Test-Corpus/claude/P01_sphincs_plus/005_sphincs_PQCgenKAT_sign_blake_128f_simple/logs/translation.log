61\t#define SPX_WOTS_LEN (SPX_WOTS_LEN1 + SPX_WOTS_LEN2)\n62\t#define SPX_WOTS_BYTES (SPX_WOTS_LEN * SPX_N)\n63\t#define SPX_WOTS_PK_BYTES SPX_WOTS_BYTES\n64\t\n65\t/* Subtree size. */\n66\t#define SPX_TREE_HEIGHT (SPX_FULL_HEIGHT / SPX_D)\n67\t\n68\t#if SPX_TREE_HEIGHT * SPX_D != SPX_FULL_HEIGHT\n69\t    #error SPX_D should always divide SPX_FULL_HEIGHT\n70\t#endif\n71\t\n72\t/* FORS parameters. */\n73\t#define SPX_FORS_MSG_BYTES ((SPX_FORS_HEIGHT * SPX_FORS_TREES + 7) / 8)\n74\t#define SPX_FORS_BYTES ((SPX_FORS_HEIGHT + 1) * SPX_FORS_TREES * SPX_N)\n75\t#define SPX_FORS_PK_BYTES SPX_N\n76\t\n77\t/* Resulting SPX sizes. */\n78\t#define SPX_BYTES (SPX_N + SPX_FORS_BYTES + SPX_D * SPX_WOTS_BYTES +\\\n79\t                   SPX_FULL_HEIGHT * SPX_N)\n80\t#define SPX_PK_BYTES (2 * SPX_N)\n81\t#define SPX_SK_BYTES (2 * SPX_N + SPX_PK_BYTES)\n82\t\n83\t#include \"../../lib/blake/include/blake_offsets.h\"\n84\t\n85\t#endif\n86\t"}]},"parent_tool_use_id":"toolu_01Jbeg5ek1LPZB7zZE34bixf","session_id":"37e9594e-3af4-481c-abaf-bfc8535b5484","uuid":"50daae8c-c559-419e-b8af-b5824c1af5d4","timestamp":"2026-04-02T08:39:01.376Z"}
