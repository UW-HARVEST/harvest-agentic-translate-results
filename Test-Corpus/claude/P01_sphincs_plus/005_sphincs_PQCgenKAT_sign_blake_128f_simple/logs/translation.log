xff) as u8;\n        input >>= 8;\n        i -= 1;\n    }\n}\n\npub fn u32_to_bytes(out: &mut [u8], input: u32) {\n    out[0] = (input >> 24) as u8;\n    out[1] = (input >> 16) as u8;\n    out[2] = (input >> 8) as u8;\n    out[3] = input as u8;\n}\n\n/// Converts inlen bytes from big-endian to an integer.\npub fn bytes_to_ull(input: &[u8], inlen: usize) -> u64 {\n    let mut retval: u64 = 0;\n    for i in 0..inlen {\n        retval |= (input[i] as u64) << (8 * (inlen - 1 - i));\n    }\n    retval\n}\n\n/// Computes a root node given a leaf and an auth path.\npub fn compute_root(\n    root: &mut [u8],\n    leaf: &[u8],\n    mut leaf_idx: u32,\n    mut idx_offset: u32,\n    auth_path: &[u8],\n    tree_height: u32,\n    ctx: &SpxCtx,\n    addr: &mut [u32; 8],\n) {\n    let mut buffer = vec![0u8; 2 * SPX_N];\n    let mut auth_pos: usize = 0;\n\n    if leaf_idx & 1 != 0 {\n        buffer[SPX_N..2 * SPX_N].copy_from_slice(&leaf[..SPX_N]);\n        buffer[..SPX_N].copy_from_slice(&auth_path[..SPX_N]);\n    } else {\n        buffer[..SPX_N].copy_from_slice(&leaf[..SPX_N]);\n        buffer[SPX_N..2 * SPX_N].copy_from_slice(&auth_path[..SPX_N]);\n    }\n    auth_pos += SPX_N;\n\n    for i in 0..tree_height.saturating_sub(1) {\n        leaf_idx >>= 1;\n        idx_offset >>= 1;\n        crate::address::set_tree_height_internal(addr, i + 1);\n        crate::address::set_tree_index_internal(addr, leaf_idx + idx_offset);\n\n        if leaf_idx & 1 != 0 {\n            // thash(buffer + SPX_N, buffer, 2)\n            let (left, right) = buffer.split_at_mut(SPX_N);\n            // We need the input to be the entire 2*SPX_N buffer\n            // Workaround: stash it\n            let mut tmp_in = vec![0u8; 2 * SPX_N];\n            tmp_in[..SPX_N].copy_from_slice(left);\n            tmp_in[SPX_N..].copy_from_slice(right);\n            thash(right, &tmp_in, 2, ctx, addr);\n            buffer[..SPX_N].copy_from_slice(&auth_path[auth_pos..auth_pos + SPX_N]);\n        } else {\n          