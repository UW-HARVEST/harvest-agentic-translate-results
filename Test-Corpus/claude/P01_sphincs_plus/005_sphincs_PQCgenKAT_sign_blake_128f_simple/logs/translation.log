nt8_t *)CRYPTO_ALGNAME, strlen(CRYPTO_ALGNAME));\n375\t  kat_tr_absorb_label(&tctx, \"SKBYTES\"); kat_tr_absorb_u64(&tctx, CRYPTO_SECRETKEYBYTES);\n376\t  kat_tr_absorb_label(&tctx, \"PKBYTES\"); kat_tr_absorb_u64(&tctx, CRYPTO_PUBLICKEYBYTES);\n377\t  kat_tr_absorb_label(&tctx, \"SIGBYTES\"); kat_tr_absorb_u64(&tctx, CRYPTO_BYTES);\n378\t\n379\t  for (int i = 0; i < LOOP_COUNT; i++) {\n380\t    randombytes(seed, sizeof seed);\n381\t\n382\t    kat_tr_absorb_label(&tctx, \"count\"); kat_tr_absorb_u64(&tctx, (unsigned long long) i);\n383\t    kat_tr_absorb_label(&tctx, \"seed\"); kat_tr_absorb_bytes(&tctx, seed, sizeof seed);\n384\t\n385\t    mlen = (unsigned long long int)(BASE_MLEN * (i + 1));\n386\t    if (mlen > BASE_MLEN * LOOP_COUNT) { fprintf(stderr, \"mlen overflow\\n\"); return KAT_OVERFLOW; }\n387\t\n388\t    kat_tr_absorb_label(&tctx, \"mlen\"); kat_tr_absorb_u64(&tctx, mlen);\n389\t\n390\t    randombytes(msg, mlen);\n391\t    kat_tr_absorb_label(&tctx, \"msg\"); kat_tr_absorb_bytes(&tctx, msg, mlen);\n392\t\n393\t    memset(m, 0, mlen);\n394\t    memset(m1, 0, mlen + CRYPTO_BYTES);\n395\t    memset(sm, 0, mlen + CRYPTO_BYTES);\n396\t    memcpy(m, msg, mlen);\n397\t\n398\t    // Keypair\n399\t    ret = crypto_sign_keypair(pk, sk);\n400\t    if (ret) { fprintf(stderr, \"crypto_sign_keypair=%d\\n\", ret); return KAT_CRYPTO_FAILURE; }\n401\t    kat_tr_absorb_label(&tctx, \"pk\"); kat_tr_absorb_bytes(&tctx, pk, CRYPTO_PUBLICKEYBYTES);\n402\t    kat_tr_absorb_label(&tctx, \"sk\"); kat_tr_absorb_bytes(&tctx, sk, CRYPTO_SECRETKEYBYTES);\n403\t\n404\t    // Sign\n405\t    ret = crypto_sign(sm, &smlen, m, mlen, sk);\n406\t    if (ret) { fprintf(stderr, \"crypto_sign=%d\\n\", ret); return KAT_CRYPTO_FAILURE; }\n407\t    kat_tr_absorb_label(&tctx, \"smlen\"); kat_tr_absorb_u64(&tctx, smlen);\n408\t    kat_tr_absorb_label(&tctx, \"sm\"); kat_tr_absorb_bytes(&tctx, sm, smlen);\n409\t\n410\t    // Verify\n411\t    ret = crypto_sign_open(m1, &mlen1, sm, smlen, pk);\n412\t