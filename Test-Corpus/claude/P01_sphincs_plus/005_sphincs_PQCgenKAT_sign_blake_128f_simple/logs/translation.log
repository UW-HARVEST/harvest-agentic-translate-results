SPX_TREE_HEIGHT * SPX_D != SPX_FULL_HEIGHT\n64\t    #error SPX_D should always divide SPX_FULL_HEIGHT\n65\t#endif\n66\t\n67\t/* FORS parameters. */\n68\t#define SPX_FORS_MSG_BYTES ((SPX_FORS_HEIGHT * SPX_FORS_TREES + 7) / 8)\n69\t#define SPX_FORS_BYTES ((SPX_FORS_HEIGHT + 1) * SPX_FORS_TREES * SPX_N)\n70\t#define SPX_FORS_PK_BYTES SPX_N\n71\t\n72\t/* Resulting SPX sizes. */\n73\t#define SPX_BYTES (SPX_N + SPX_FORS_BYTES + SPX_D * SPX_WOTS_BYTES +\\\n74\t                   SPX_FULL_HEIGHT * SPX_N)\n75\t#define SPX_PK_BYTES (2 * SPX_N)\n76\t#define SPX_SK_BYTES (2 * SPX_N + SPX_PK_BYTES)\n77\t\n78\t#include \"../../lib/haraka/include/haraka_offsets.h\"\n79\t\n80\t#endif\n81\t"}]},"parent_tool_use_id":"toolu_01BorfxJFrqf3YUj89A5njey","session_id":"37e9594e-3af4-481c-abaf-bfc8535b5484","uuid":"c7ea7cb7-db42-48bb-b6f3-43dabd29d26f","timestamp":"2026-04-02T08:43:21.971Z"}
