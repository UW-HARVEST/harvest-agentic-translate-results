ibs {\n    unsafe {\n        let c = Library::new(c_so_path()).expect(\"failed to open C .so\");\n        let r = Library::new(rust_so_path()).expect(\"failed to open Rust .so\");\n        Libs { c, r }\n    }\n}\n\n/// Look up a symbol by name in both libs.\npub unsafe fn sym<'a, T: Copy>(lib: &'a Library, name: &[u8]) -> Symbol<'a, T> {\n    lib.get(name)\n        .unwrap_or_else(|e| panic!(\"missing symbol {}: {}\", String::from_utf8_lossy(name), e))\n}\n","structuredPatch":[{"oldStart":10,"oldLines":6,"newStart":10,"newLines":9,"lines":[" use std::path::PathBuf;"," "," pub struct Libs {","+    /// The hash backend (blake/haraka/sha2/shake) library, kept alive so its","+    /// symbols remain resolvable for the core .so via lazy resolution.","+    pub _hash: Library,","     pub c: Library,","     pub r: Library,"," }"]}],"userModified":false,"replaceAll":false}}
