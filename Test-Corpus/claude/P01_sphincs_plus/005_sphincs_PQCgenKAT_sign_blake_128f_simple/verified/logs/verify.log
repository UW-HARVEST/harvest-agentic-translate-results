\",\n                &libs,\n                |p| c_fn(p, v),\n                |p| r_fn(p, v),\n            );\n        }\n    }\n}\n\n#[test]\nfn test_set_tree_addr() {\n    let libs = open_libs();\n    unsafe {\n        let c_fn: libloading::Symbol<FnSetU64> = sym(&libs.c, b\"SPX_set_tree_addr\");\n        let r_fn: libloading::Symbol<FnSetU64> = sym(&libs.r, b\"SPX_set_tree_addr\");\n        for v in [0u64, 1, 0xdead_beef_cafe_babe, u64::MAX] {\n            run_pair(\n                \"set_tree_addr\",\n                &libs,\n                |p| c_fn(p, v),\n                |p| r_fn(p, v),\n            );\n        }\n    }\n}\n\n#[test]\nfn test_set_type() {\n    let libs = open_libs();\n    unsafe {\n        let c_fn: libloading::Symbol<FnSetU32> = sym(&libs.c, b\"SPX_set_type\");\n        let r_fn: libloading::Symbol<FnSetU32> = sym(&libs.r, b\"SPX_set_type\");\n        for v in 0..7u32 {\n            run_pair(\n                \"set_type\",\n                &libs,\n                |p| c_fn(p, v),\n                |p| r_fn(p, v),\n            );\n        }\n    }\n}\n\n#[test]\nfn test_set_keypair_addr() {\n    let libs = open_libs();\n    unsafe {\n        let c_fn: libloading::Symbol<FnSetU32> = sym(&libs.c, b\"SPX_set_keypair_addr\");\n        let r_fn: libloading::Symbol<FnSetU32> = sym(&libs.r, b\"SPX_set_keypair_addr\");\n        for v in [0u32, 0xabcdef, 0xff_aaff, u32::MAX] {\n            run_pair(\n                \"set_keypair_addr\",\n                &libs,\n                |p| c_fn(p, v),\n                |p| r_fn(p, v),\n            );\n        }\n    }\n}\n\n#[test]\nfn test_set_chain_addr() {\n    let libs = open_libs();\n    unsafe {\n        let c_fn: libloading::Symbol<FnSetU32> = sym(&libs.c, b\"SPX_set_chain_addr\");\n        let r_fn: libloading::Symbol<FnSetU32> = sym(&libs.r, b\"SPX_set_chain_addr\");\n        for v in 0..16u32 {\n            run_pair(\"set_chain_addr\", &libs, |p| c_fn(p, v), |p| r_fn(p, v));\n        }\n    }\n}\n\n#[test]\nfn test_set_hash_addr() {\n    let libs = open_libs();\n    unsafe {\n        let c_fn: libloading::Symbol<FnSetU32> = sym(&libs.c, b\"SPX_set_hash_addr\");\n        let r_fn: libloading::Symbol<FnSetU32> = sym(&libs.r, b\"SPX_set_hash_addr\");\n        for v in 0..16u32 {\n            run_pair(\"set_hash_addr\", &libs, |p| c_fn(p, v), |p| r_fn(p, v));\n        }\n    }\n}\n\n#[test]\nfn test_set_tree_height() {\n    let libs = open_libs();\n    unsafe {\n        let c_fn: libloading::Symbol<FnSetU32> = sym(&libs.c, b\"SPX_set_tree_height\");\n        let r_fn: libloading::Symbol<FnSetU32> = sym(&libs.r, b\"SPX_set_tree_height\");\n        for v in 0..32u32 {\n            run_pair(\"set_tree_height\", &libs, |p| c_fn(p, v), |p| r_fn(p, v));\n        }\n    }\n}\n\n#[test]\nfn test_set_tree_index() {\n    let libs = open_libs();\n    unsafe {\n        let c_fn: libloading::Symbol<FnSetU32> = sym(&libs.c, b\"SPX_set_tree_index\");\n        let r_fn: libloading::Symbol<FnSetU32> = sym(&libs.r, b\"SPX_set_tree_index\");\n        for v in [0u32, 0xabcd, 0x12345678, u32::MAX] {\n            run_pair(\"set_tree_index\", &libs, |p| c_fn(p, v), |p| r_fn(p, v));\n        }\n    }\n}\n\n#[test]\nfn test_copy_subtree_addr() {\n    let libs = open_libs();\n    unsafe {\n        let c_fn: libloading::Symbol<FnCopy> = sym(&libs.c, b\"SPX_copy_subtree_addr\");\n        let r_fn: libloading::Symbol<FnCopy> = sym(&libs.r, b\"SPX_copy_subtree_addr\");\n\n        let mut src = [0u32; 8];\n        for i in 0..8 {\n            src[i] = 0xdead_0000 + i as u32;\n        }\n        let mut c_addr = [0xa5a5_a5a5u32; 8];\n        let mut r_addr = [0xa5a5_a5a5u32; 8];\n        c_fn(c_addr.as_mut_ptr(), src.as_ptr());\n        r_fn(r_addr.as_mut_ptr(), src.as_ptr());\n        assert_eq!(c_addr, r_addr);\n    }\n}\n\n#[test]\nfn test_copy_keypair_addr() {\n    let libs = open_libs();\n    unsafe {\n        let c_fn: libloading::Symbol<FnCopy> = sym(&libs.c, b\"SPX_copy_keypair_addr\");\n        let r_fn: libloading::Symbol<FnCopy> = sym(&libs.r, b\"SPX_copy_keypair_addr\");\n\n        let mut src = [0u32; 8];\n        for i in 0..8 {\n            src[i] = 0xfeed_0000 + i as u32;\n        }\n        let mut c_addr = [0xa5a5_a5a5u32; 8];\n        let mut r_addr = [0xa5a5_a5a5u32; 8];\n        c_fn(c_addr.as_mut_ptr(), src.as_ptr());\n        r_fn(r_addr.as_mut_ptr(), src.as_ptr());\n        assert_eq!(c_addr, r_addr);\n    }\n}\n","structuredPatch":[{"oldStart":8,"oldLines":7,"newStart":8,"newLines":7,"lines":[" type FnSetU64 = unsafe extern \"C\" fn(*mut u32, u64);"," type FnCopy = unsafe extern \"C\" fn(*mut u32, *const u32);"," ","-fn run_pair<F: Fn(*mut u32) + Copy>(name: &str, libs: &Libs, c_call: F, r_call: F) {","+fn run_pair(name: &str, libs: &Libs, c_call: &dyn Fn(*mut u32), r_call: &dyn Fn(*mut u32)) {","     let mut c_addr = [0u32; 8];","     let mut r_addr = [0u32; 8];"," "]}],"userModified":false,"replaceAll":false}}
