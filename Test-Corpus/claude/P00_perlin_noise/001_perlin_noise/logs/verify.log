    }","-    sum","-}","-","-fn stb_perlin_noise3_wrap_nonpow2(","-    mut x: f32,","-    mut y: f32,","-    mut z: f32,","-    x_wrap: i32,","-    y_wrap: i32,","-    z_wrap: i32,","-    seed: u8,","-) -> f32 {","-    let px = stb_perlin_fastfloor(x);","-    let py = stb_perlin_fastfloor(y);","-    let pz = stb_perlin_fastfloor(z);","-    let x_wrap2 = if x_wrap != 0 { x_wrap } else { 256 };","-    let y_wrap2 = if y_wrap != 0 { y_wrap } else { 256 };","-    let z_wrap2 = if z_wrap != 0 { z_wrap } else { 256 };","-","-    let mut x0 = px % x_wrap2;","-    let mut y0 = py % y_wrap2;","-    let mut z0 = pz % z_wrap2;","-","-    if x0 < 0 { x0 += x_wrap2; }","-    if y0 < 0 { y0 += y_wrap2; }","-    if z0 < 0 { z0 += z_wrap2; }","-    let x1 = (x0 + 1) % x_wrap2;","-    let y1 = (y0 + 1) % y_wrap2;","-    let z1 = (z0 + 1) % z_wrap2;","-","-    x -= px as f32;","-    let u = ease(x);","-    y -= py as f32;","-    let v = ease(y);","-    z -= pz as f32;","-    let w = ease(z);","-","-    let seed_i = seed as i32;","-","-    let mut r0 = STB_PERLIN_RANDTAB[x0 as usize] as i32;","-    r0 = STB_PERLIN_RANDTAB[(r0 + seed_i) as usize] as i32;","-    let mut r1 = STB_PERLIN_RANDTAB[x1 as usize] as i32;","-    r1 = STB_PERLIN_RANDTAB[(r1 + seed_i) as usize] as i32;","-","-    let r00 = STB_PERLIN_RANDTAB[(r0 + y0) as usize] as i32;","-    let r01 = STB_PERLIN_RANDTAB[(r0 + y1) as usize] as i32;","-    let r10 = STB_PERLIN_RANDTAB[(r1 + y0) as usize] as i32;","-    let r11 = STB_PERLIN_RANDTAB[(r1 + y1) as usize] as i32;","-","-    let n000 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r00 + z0) as usize] as i32, x,       y,       z      );","-    let n001 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r00 + z1) as usize] as i32, x,       y,       z - 1.0);","-    let n010 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r01 + z0) as usize] as i32, x,       y - 1.0, z      );","-    let n011 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r01 + z1) as usize] as i32, x,       y -