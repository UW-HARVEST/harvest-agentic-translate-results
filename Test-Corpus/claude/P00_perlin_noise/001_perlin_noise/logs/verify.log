106\t        [-1.0, -1.0,  0.0],\n107\t        [ 1.0,  0.0,  1.0],\n108\t        [-1.0,  0.0,  1.0],\n109\t        [ 1.0,  0.0, -1.0],\n110\t        [-1.0,  0.0, -1.0],\n111\t        [ 0.0,  1.0,  1.0],\n112\t        [ 0.0, -1.0,  1.0],\n113\t        [ 0.0,  1.0, -1.0],\n114\t        [ 0.0, -1.0, -1.0],\n115\t    ];\n116\t    let g = &BASIS[grad_idx as usize];\n117\t    g[0] * x + g[1] * y + g[2] * z\n118\t}\n119\t\n120\t#[inline]\n121\tfn ease(a: f32) -> f32 {\n122\t    ((a * 6.0 - 15.0) * a + 10.0) * a * a * a\n123\t}\n124\t\n125\tfn stb_perlin_noise3_internal(\n126\t    mut x: f32,\n127\t    mut y: f32,\n128\t    mut z: f32,\n129\t    x_wrap: i32,\n130\t    y_wrap: i32,\n131\t    z_wrap: i32,\n132\t    seed: u8,\n133\t) -> f32 {\n134\t    // C: unsigned int x_mask = (x_wrap-1) & 255;\n135\t    let x_mask: u32 = (x_wrap.wrapping_sub(1) as u32) & 255;\n136\t    let y_mask: u32 = (y_wrap.wrapping_sub(1) as u32) & 255;\n137\t    let z_mask: u32 = (z_wrap.wrapping_sub(1) as u32) & 255;\n138\t\n139\t    let px = stb_perlin_fastfloor(x);\n140\t    let py = stb_perlin_fastfloor(y);\n141\t    let pz = stb_perlin_fastfloor(z);\n142\t\n143\t    // C: int x0 = px & x_mask, x1 = (px+1) & x_mask;\n144\t    // px is int, x_mask is unsigned int; in C, the result is unsigned int\n145\t    // but assigned to int. Replicate: cast to u32 first.\n146\t    let x0 = ((px as u32) & x_mask) as i32;\n147\t    let x1 = ((px.wrapping_add(1) as u32) & x_mask) as i32;\n148\t    let y0 = ((py as u32) & y_mask) as i32;\n149\t    let y1 = ((py.wrapping_add(1) as u32) & y_mask) as i32;\n150\t    let z0 = ((pz as u32) & z_mask) as i32;\n151\t    let z1 = ((pz.wrapping_add(1) as u32) & z_mask) as i32;\n152\t\n153\t    x -= px as f32;\n154\t    let u = ease(x);\n155\t    y -= py as f32;\n156\t    let v = ease(y);\n157\t    z -= pz as f32;\n158\t    let w = ease(z);\n159\t\n160\t    let seed_i = seed as i32;\n161\t    let r0 = STB_PERLIN_RANDTAB[(x0 + seed_i) as usize] as i32;\n162\t    let r1 = STB_PERLIN_RANDTAB[(x1 + seed_i) as usize] as i32;\n163\t\n164\t    let r00 = STB_PERLIN_RANDTAB[(r0 + y0) as usize] as i32;\n165\t    let r01 = STB_PERLIN_RANDTAB[(r0 + y1) as usize] as i32;\n166\t    let r10 = STB_PERLIN_RANDTAB[(r1 + y0) as usize] as i32;\n167\t    let r11 = STB_PERLIN_RANDTAB[(r1 + y1) as usize] as i32;\n168\t\n169\t    let n000 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r00 + z0) as usize] as i32, x,       y,       z      );\n170\t    let n001 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r00 + z1) as usize] as i32, x,       y,       z - 1.0);\n171\t    let n010 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r01 + z0) as usize] as i32, x,       y - 1.0, z      );\n172\t    let n011 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r01 + z1) as usize] as i32, x,       y - 1.0, z - 1.0);\n173\t    let n100 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r10 + z0) as usize] as i32, x - 1.0, y,       z      );\n174\t    let n101 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r10 + z1) as usize] as i32, x - 1.0, y,       z - 1.0);\n175\t    let n110 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r11 + z0) as usize] as i32, x - 1.0, y - 1.0, z      );\n176\t    let n111 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r11 + z1) as usize] as i32, x - 1.0, y - 1.0, z - 1.0);\n177\t\n178\t    let n00 = stb_perlin_lerp(n000, n001, w);\n179\t    let n01 = stb_perlin_lerp(n010, n011, w);\n180\t    let n10 = stb_perlin_lerp(n100, n101, w);\n181\t    let n11 = stb_perlin_lerp(n110, n111, w);\n182\t\n183\t    let n0 = stb_perlin_lerp(n00, n01, v);\n184\t    let n1 = stb_perlin_lerp(n10, n11, v);\n185\t\n186\t    stb_perlin_lerp(n0, n1, u)\n187\t}\n188\t\n189\tfn stb_perlin_noise3(x: f32, y: f32, z: f32, x_wrap: i32, y_wrap: i32, z_wrap: i32) -> f32 {\n190\t    stb_perlin_noise3_internal(x, y, z, x_wrap, y_wrap, z_wrap, 0)\n191\t}\n192\t\n193\tfn stb_perlin_noise3_seed(x: f32, y: f32, z: f32, x_wrap: i32, y_wrap: i32, z_wrap: i32, seed: i32) -> f32 {\n194\t    stb_perlin_noise3_internal(x, y, z, x_wrap, y_wrap, z_wrap, seed as u8)\n195\t}\n196\t\n197\tfn stb_perlin_ridge_noise3(x: f32, y: f32, z: f32, lacunarity: f32, gain: f32, offset: f32, octaves: i32) -> f32 {\n198\t    let mut frequency: f32 = 1.0;\n199\t    let mut prev: f32 = 1.0;\n200\t    let mut amplitude: f32 = 0.5;\n201\t    let mut sum: f32 = 0.0;\n202\t\n203\t    for i in 0..octaves {\n204\t        let mut r = stb_perlin_noise3_internal(x * frequency, y * frequency, z * frequency, 0, 0, 0, i as u8);\n205\t        r = offset - r.abs();\n206\t        r = r * r;\n207\t        sum += r * amplitude * prev;\n208\t        prev = r;\n209\t        frequency *= lacunarity;\n210\t        amplitude *= gain;\n211\t    }\n212\t    sum\n213\t}\n214\t\n215\tfn stb_perlin_fbm_noise3(x: f32, y: f32, z: f32, lacunarity: f32, gain: f32, octaves: i32) -> f32 {\n216\t    let mut frequency: f32 = 1.0;\n217\t    let mut amplitude: f32 = 1.0;\n218\t    let mut sum: f32 = 0.0;\n219\t\n220\t    for i in 0..octaves {\n221\t        sum += stb_perlin_noise3_internal(x * frequency, y * frequency, z * frequency, 0, 0, 0, i as u8) * amplitude;\n222\t        frequency *= lacunarity;\n223\t        amplitude *= gain;\n224\t    }\n225\t    sum\n226\t}\n227\t\n228\tfn stb_perlin_turbulence_noise3(x: f32, y: f32, z: f32, lacunarity: f32, gain: f32, octaves: i32) -> f32 {\n229\t    let mut frequency: f32 = 1.0;\n230\t    let mut amplitude: f32 = 1.0;\n231\t    let mut sum: f32 = 0.0;\n232\t\n233\t    for i in 0..octaves {\n234\t        let r = stb_perlin_noise3_internal(x * frequency, y * frequency, z * frequency, 0, 0, 0, i as u8) * amplitude;\n235\t        sum += r.abs();\n236\t        frequency *= lacunarity;\n237\t        amplitude *= gain;\n238\t    }\n239\t    sum\n240\t}\n241\t\n242\tfn stb_perlin_noise3_wrap_nonpow2(\n243\t    mut x: f32,\n244\t    mut y: f32,\n245\t    mut z: f32,\n246\t    x_wrap: i32,\n247\t    y_wrap: i32,\n248\t    z_wrap: i32,\n249\t    seed: u8,\n250\t) -> f32 {\n251\t    let px = stb_perlin_fastfloor(x);\n252\t    let py = stb_perlin_fastfloor(y);\n253\t    let pz = stb_perlin_fastfloor(z);\n254\t    let x_wrap2 = if x_wrap != 0 { x_wrap } else { 256 };\n255\t    let y_wrap2 = if y_wrap != 0 { y_wrap } else { 256 };\n256\t    let z_wrap2 = if z_wrap != 0 { z_wrap } else { 256 };\n257\t\n258\t    let mut x0 = px % x_wrap2;\n259\t    let mut y0 = py % y_wrap2;\n260\t    let mut z0 = pz % z_wrap2;\n261\t\n262\t    if x0 < 0 { x0 += x_wrap2; }\n263\t    if y0 < 0 { y0 += y_wrap2; }\n264\t    if z0 < 0 { z0 += z_wrap2; }\n265\t    let x1 = (x0 + 1) % x_wrap2;\n266\t    let y1 = (y0 + 1) % y_wrap2;\n267\t    let z1 = (z0 + 1) % z_wrap2;\n268\t\n269\t    x -= px as f32;\n270\t    let u = ease(x);\n271\t    y -= py as f32;\n272\t    let v = ease(y);\n273\t    z -= pz as f32;\n274\t    let w = ease(z);\n275\t\n276\t    let seed_i = seed as i32;\n277\t\n278\t    let mut r0 = STB_PERLIN_RANDTAB[x0 as usize] as i32;\n279\t    r0 = STB_PERLIN_RANDTAB[(r0 + seed_i) as usize] as i32;\n280\t    let mut r1 = STB_PERLIN_RANDTAB[x1 as usize] as i32;\n281\t    r1 = STB_PERLIN_RANDTAB[(r1 + seed_i) as usize] as i32;\n282\t\n283\t    let r00 = STB_PERLIN_RANDTAB[(r0 + y0) as usize] as i32;\n284\t    let r01 = STB_PERLIN_RANDTAB[(r0 + y1) as usize] as i32;\n285\t    let r10 = STB_PERLIN_RANDTAB[(r1 + y0) as usize] as i32;\n286\t    let r11 = STB_PERLIN_RANDTAB[(r1 + y1) as usize] as i32;\n287\t\n288\t    let n000 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r00 + z0) as usize] as i32, x,       y,       z      );\n289\t    let n001 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r00 + z1) as usize] as i32, x,       y,       z - 1.0);\n290\t    let n010 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r01 + z0) as usize] as i32, x,       y - 1.0, z      );\n291\t    let n011 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r01 + z1) as usize] as i32, x,       y - 1.0, z - 1.0);\n292\t    let n100 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r10 + z0) as usize] as i32, x - 1.0, y,       z      );\n293\t    let n101 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r10 + z1) as usize] as i32, x - 1.0, y,       z - 1.0);\n294\t    let n110 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r11 + z0) as usize] as i32, x - 1.0, y - 1.0, z      );\n295\t    let n111 = stb_perlin_grad(STB_PERLIN_RANDTAB_GRAD_IDX[(r11 + z1) as usize] as i32, x - 1.0, y - 1.0, z - 1.0);\n296\t\n297\t    let n00 = stb_perlin_lerp(n000, n001, w);\n298\t    let n01 = stb_perlin_lerp(n010, n011, w);\n299\t    let n10 = stb_perlin_lerp(n100, n101, w);\n300\t    let n11 = stb_perlin_lerp(n110, n111, w);\n301\t\n302\t    let n0 = stb_perlin_lerp(n00, n01, v);\n303\t    let n1 = stb_perlin_lerp(n10, n11, v);\n304\t\n305\t    stb_perlin_lerp(n0, n1, u)\n306\t}\n307\t\n308\t// ---------- inner / main ----------\n309\t\n310\tfn inner(\n311\t    which: i32,\n312\t    x: f32,\n313\t    y: f32,\n314\t    z: f32,\n315\t    x_wrap: i32,\n316\t    y_wrap: i32,\n317\t    z_wrap: i32,\n318\t    seed: i32,\n319\t    lacunarity: f32,\n320\t    gain: f32,\n321\t    offset: f32,\n322\t    octaves: i32,\n323\t) -> f32 {\n324\t    match which {\n325\t        0 => stb_perlin_noise3(x, y, z, x_wrap, y_wrap, z_wrap),\n326\t        1 => stb_perlin_noise3_seed(x, y, z, x_wrap, y_wrap, z_wrap, seed),\n327\t        2 => stb_perlin_ridge_noise3(x, y, z, lacunarity, gain, offset, octaves),\n328\t        3 => stb_perlin_fbm_noise3(x, y, z, lacunarity, gain, octaves),\n329\t        4 => stb_perlin_turbulence_noise3(x, y, z, lacunarity, gain, octaves),\n330\t        5 => stb_perlin_noise3_wrap_nonpow2(x, y, z, x_wrap, y_wrap, z_wrap, seed as u8),\n331\t        _ => f32::NAN,\n332\t    }\n333\t}\n334\t\n335\t// Read all of stdin and split into whitespace-separated tokens, mirroring\n336\t// scanf(\"%d%f...\") which skips whitespace (including newlines).\n337\tstruct TokenStream {\n338\t    data: String,\n339\t    pos: usize,\n340\t}\n341\t\n342\timpl TokenStream {\n343\t    fn new() ->