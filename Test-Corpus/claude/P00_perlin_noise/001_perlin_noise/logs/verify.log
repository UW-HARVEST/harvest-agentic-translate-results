mask = (z_wrap.wrapping_sub(1) as u32) & 255;\n113\t\n114\t    let px = fastfloor(x);\n115\t    let py = fastfloor(y);\n116\t    let pz = fastfloor(z);\n117\t\n118\t    let x0 = (px as u32 & x_mask) as usize;\n119\t    let x1 = ((px + 1) as u32 & x_mask) as usize;\n120\t    let y0 = (py as u32 & y_mask) as usize;\n121\t    let y1 = ((py + 1) as u32 & y_mask) as usize;\n122\t    let z0 = (pz as u32 & z_mask) as usize;\n123\t    let z1 = ((pz + 1) as u32 & z_mask) as usize;\n124\t\n125\t    let x = x - px as f32;\n126\t    let y = y - py as f32;\n127\t    let z = z - pz as f32;\n128\t    let u = ease(x);\n129\t    let v = ease(y);\n130\t    let w = ease(z);\n131\t\n132\t    let seed = seed as usize;\n133\t    let r0 = RANDTAB[x0 + seed] as usize;\n134\t    let r1 = RANDTAB[x1 + seed] as usize;\n135\t\n136\t    let r00 = RANDTAB[r0 + y0] as usize;\n137\t    let r01 = RANDTAB[r0 + y1] as usize;\n138\t    let r10 = RANDTAB[r1 + y0] as usize;\n139\t    let r11 = RANDTAB[r1 + y1] as usize;\n140\t\n141\t    let n000 = grad(RANDTAB_GRAD_IDX[r00 + z0] as usize, x,       y,       z);\n142\t    let n001 = grad(RANDTAB_GRAD_IDX[r00 + z1] as usize, x,       y,       z - 1.0);\n143\t    let n010 = grad(RANDTAB_GRAD_IDX[r01 + z0] as usize, x,       y - 1.0, z);\n144\t    let n011 = grad(RANDTAB_GRAD_IDX[r01 + z1] as usize, x,       y - 1.0, z - 1.0);\n145\t    let n100 = grad(RANDTAB_GRAD_IDX[r10 + z0] as usize, x - 1.0, y,       z);\n146\t    let n101 = grad(RANDTAB_GRAD_IDX[r10 + z1] as usize, x - 1.0, y,       z - 1.0);\n147\t    let n110 = grad(RANDTAB_GRAD_IDX[r11 + z0] as usize, x - 1.0, y - 1.0, z);\n148\t    let n111 = grad(RANDTAB_GRAD_IDX[r11 + z1] as usize, x - 1.0, y - 1.0, z - 1.0);\n149\t\n150\t    let n00 = lerp(n000, n001, w);\n151\t    let n01 = lerp(n010, n011, w);\n152\t    let n10 = lerp(n100, n101, w);\n153\t    let n11 = lerp(n110, n111, w);\n154\t\n155\t    let n0 = lerp(n00, n01, v);\n156\t    let n1 = lerp(n10, n11, v);\n157\t\n158\t    lerp(n0, n1, u)\n159\t}\n160\t\n161\tpub fn stb_perlin_noise3(x: f32, y: f32, z: f32, x_wrap: i32, y_wrap: i32, z_wrap: i32) -> f32 {\n162\t    noise3_internal(x, y, z, x_wrap, y_wrap, z_wrap, 0)\n163\t}\n164\t\n165\tpub fn stb_perlin_noise3_seed(x: f32, y: f32, z: f32, x_wrap: i32, y_wrap: i32, z_wrap: i32, seed: i32) -> f32 {\n166\t    noise3_internal(x, y, z, x_wrap, y_wrap, z_wrap, seed as u8)\n167\t}\n168\t\n169\tpub fn stb_perlin_ridge_noise3(x: f32, y: f32, z: f32, lacunarity: f32, gain: f32, offset: f32, octaves: i32) -> f32 {\n170\t    let mut frequency = 1.0f32;\n171\t    let mut prev = 1.0f32;\n172\t    let mut amplitude = 0.5f32;\n173\t    let mut sum = 0.0f32;\n174\t\n175\t    for i in 0..octaves {\n176\t        let mut r = noise3_internal(x * frequency, y * frequency, z * frequency, 0, 0, 0, i as u8);\n177\t        r = offset - (r as f64).abs() as f32;\n178\t        r = r * r;\n179\t        sum += r * amplitude * prev;\n180\t        prev = r;\n181\t        frequency *= lacunarity;\n182\t        amplitude *= gain;\n183\t    }\n184\t    sum\n185\t}\n186\t\n187\tpub fn stb_perlin_fbm_noise3(x: f32, y: f32, z: f32, lacunarity: f32, gain: f32, octaves: i32) -> f32 {\n188\t    let mut frequency = 1.0f32;\n189\t    let mut amplitude = 1.0f32;\n190\t    let mut sum = 0.0f32;\n191\t\n192\t    for i in 0..octaves {\n193\t        sum += noise3_internal(x * frequency, y * frequency, z * frequency, 0, 0, 0, i as u8) * amplitude;\n194\t        frequency *= lacunarity;\n195\t        amplitude *= gain;\n196\t    }\n197\t    sum\n198\t}\n199\t\n200\tpub fn stb_perlin_turbulence_noise3(x: f32, y: f32, z: f32, lacunarity: f32, gain: f32, octaves: i32) -> f32 {\n201\t    let mut frequency = 1.0f32;\n202\t    let mut amplitude = 1.0f32;\n203\t    let mut sum = 0.0f32;\n204\t\n205\t    for i in 0..octaves {\n206\t        let r = noise3_internal(x * frequency, y * frequency, z * frequency, 0, 0, 0, i as u8) * amplitude;\n207\t        sum += (r as f64).abs() as f32;\n208\t        frequency *= la