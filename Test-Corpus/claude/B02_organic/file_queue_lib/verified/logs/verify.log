{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01N3VJcoi53jBMpirDjWcKaz","type":"tool_result","content":"1\t//! Rust translation of the driver C library.\n2\t//!\n3\t//! Provides byte-identical behavior to the original C code under `c_src/`.\n4\t\n5\t#![allow(non_camel_case_types)]\n6\t#![allow(non_snake_case)]\n7\t#![allow(non_upper_case_globals)]\n8\t\n9\tuse std::ffi::{c_char, c_int, c_uint, c_void};\n10\tuse std::ptr;\n11\t\n12\t// ----------------------------------------------------------------------------\n13\t// Constants from headers\n14\t// ----------------------------------------------------------------------------\n15\t\n16\tconst MAX_FQUEUE: usize = 256;\n17\tconst FQ_TIMEOUT: i64 = 5;\n18\t\n19\tconst ALERTS_DAILY: &[u8] = b\"alerts.log\\0\";\n20\tconst STDIN_NAME: &[u8] = b\"<stdin>\\0\";\n21\t\n22\tconst CRALERT_MAIL_SET: c_int = 0x001;\n23\t#[allow(dead_code)]\n24\tconst CRALERT_EXEC_SET: c_int = 0x002;\n25\tconst CRALERT_READ_ALL: c_int = 0x004;\n26\t#[allow(dead_code)]\n27\tconst CRALERT_READ_FAILED: c_int = 0x008;\n28\tconst CRALERT_FP_SET: c_int = 0x010;\n29\t\n30\tconst OS_MAXSTR: usize = 1024;\n31\t\n32\t// ----------------------------------------------------------------------------\n33\t// C struct layouts (must match the headers exactly)\n34\t// ----------------------------------------------------------------------------\n35\t\n36\t#[repr(C)]\n37\tpub struct alert_data {\n38\t    pub rule: c_uint,\n39\t    pub level: c_uint,\n40\t    pub alertid: *mut c_char,\n41\t    pub date: *mut c_char,\n42\t    pub location: *mut c_char,\n43\t    pub comment: *mut c_char,\n44\t    pub group: *mut c_char,\n45\t    pub srcip: *mut c_char,\n46\t    pub srcport: c_int,\n47\t    pub dstip: *mut c_char,\n48\t    pub dstport: c_int,\n49\t    pub user: *mut c_char,\n50\t    pub filename: *mut c_char,\n51\t}\n52\t\n53\t// `struct tm` from <time.h>. Glibc layout (Linux x86_64):\n54\t//   int tm_sec;\n55\t//   int tm_min;\n56\t//   int tm_hour;\n57\t//   int tm_mday;\n58\t//   int tm_mon;\n59\t//   int tm_year;\n60\t//   int tm_wday;\n61\t//   int tm_yday;\n62\t//   int tm_isdst;\n63\t//   long tm_gmtoff;\n64\t//   const char *tm_zone;\n65\t#[repr(C)]\n66\tpub struct tm {\n67\t    pub tm_sec: c_int,\n68\t    pub tm_min: c_int,\n69\t    pub tm_hour: c_int,\n70\t    pub tm_mday: c_int,\n71\t    pub tm_mon: c_int,\n72\t    pub tm_year: c_int,\n73\t    pub tm_wday: c_int,\n74\t    pub tm_yday: c_int,\n75\t    pub tm_isdst: c_int,\n76\t    pub tm_gmtoff: libc::c_long,\n77\t    pub tm_zone: *const c_char,\n78\t}\n79\t\n80\t#[repr(C)]\n81\tpub struct file_queue {\n82\t    pub last_change: libc::time_t,\n83\t    pub year: c_int,\n84\t    pub day: c_int,\n85\t    pub flags: c_int,\n86\t\n87\t    pub mon: [c_char; 4],\n88\t    pub file_name: [c_char; MAX_FQUEUE + 1],\n89\t\n90\t    pub fp: *mut libc::FILE,\n91\t    pub f_status: libc::stat,\n92\t}\n93\t\n94\t// ----------------------------------------------------------------------------\n95\t// Helpers: os_calloc / os_realloc / os_strdup mirror the C versions in shared.h\n96\t// ----------------------------------------------------------------------------\n97\t\n98\tunsafe fn os_calloc(num: libc::size_t, size: libc::size_t) -> *mut c_void {\n99\t    let out = unsafe { libc::calloc(num, size) };\n100\t    if out.is_null() {\n101\t        eprint_no_newline(\"Memory allocation failed in os_calloc\");\n102\t        unsafe { libc::exit(libc::EXIT_FAILURE) };\n103\t    }\n104\t    out\n105\t}\n106\t\n107\tunsafe fn os_realloc(ptr: *mut c_void, new_size: libc::size_t) -> *mut c_void {\n108\t    let out = unsafe { libc::realloc(ptr, new_size) };\n109\t    if out.is_null() {\n110\t        eprint_no_newline(\"Memory allocation failed in os_realloc\");\n111\t        unsafe { libc::exit(libc::EXIT_FAILURE) };\n112\t    }\n113\t    out\n114\t}\n115\t\n116\tunsafe fn os_strdup(str_ptr: *const c_char) -> *mut c_char {\n117\t    if str_ptr.is_null() {\n118\t        eprint_no_newline(\"NULL string passed to os_strdup\");\n119\t        unsafe { libc::exit(libc::EXIT_FAILURE) };\n120\t    }\n121\t    let dup = unsafe { libc::strdup(str_ptr) };\n122\t    if dup.is_null() {\n123\t        eprint_no_newline(\"Memory allocation failed in os_strdup\");\n124\t        unsafe { libc::exit(libc::EXIT_FAILURE) };\n125\t    }\n126\t    dup\n127\t}\n128\t\n129\t/// Mirrors `fprintf(stderr, \"...\")` (no trailing newline) used by os_calloc et al.\n130\tfn eprint_no_newline(s: &str) {\n131\t    use std::io::Write;\n132\t    let stderr = std::io::stderr();\n133\t    let mut h = stderr.lock();\n134\t    let _ = h.write_all(s.as_bytes());\n135\t    let _ = h.flush();\n136\t}\n137\t\n138\t/// Equivalent of the `os_free(x)` macro: free if non-null and clear the slot.\n139\tunsafe fn os_free(p: &mut *mut c_char) {\n140\t    if !p.is_null() {\n141\t        unsafe { libc::free(*p as *mut c_void) };\n142\t        *p = ptr::null_mut();\n143\t    }\n144\t}\n145\t\n146\t/// Equivalent of `os_clearnl(x, p)` which sets the last '\\n' in `x` to '\\0'.\n147\tunsafe fn os_clearnl(x: *mut c_char) {\n148\t    if x.is_null() {\n149\t        return;\n150\t    }\n151\t    let p = unsafe { libc::strrchr(x, b'\\n' as c_int) };\n152\t    if !p.is_null() {\n153\t        unsafe { *p = 0 };\n154\t    }\n155\t}\n156\t\n157\t// ----------------------------------------------------------------------------\n158\t// merror — formatted error to stderr (with trailing newline)\n159\t// ----------------------------------------------------------------------------\n160\t\n161\tunsafe fn merror(\n162\t    err_template: *const c_char,\n163\t    file_name: *const c_char,\n164\t    err: c_int,\n165\t    err_msg: *const c_char,\n166\t) {\n167\t    let mut buffer: [c_char; 256] = [0; 256];\n168\t    unsafe {\n169\t        libc::snprintf(\n170\t            buffer.as_mut_ptr(),\n171\t            buffer.len(),\n172\t            err_template,\n173\t            file_name,\n174\t            err,\n175\t            err_msg,\n176\t        );\n177\t        libc::fprintf(\n178\t            stderr_handle(),\n179\t            b\"%s\\n\\0\".as_ptr() as *const c_char,\n180\t            buffer.as_ptr(),\n181\t        );\n182\t    }\n183\t}\n184\t\n185\tfn stderr_handle() -> *mut libc::FILE {\n186\t    // libc on glibc/musl exposes `stderr` indirectly through a TLS / extern.\n187\t    // Use `fdopen`-free approach via the libc crate's extern \"C\" stderr.\n188\t    unsafe extern \"C\" {\n189\t        static mut stderr: *mut libc::FILE;\n190\t    }\n191\t    unsafe { stderr }\n192\t}\n193\t\n194\t// ----------------------------------------------------------------------------\n195\t// read-alert.c\n196\t// ----------------------------------------------------------------------------\n197\t\n198\t// String constants (with their lengths)\n199\tconst ALERT_BEGIN: &[u8] = b\"** Alert\";\n200\tconst ALERT_BEGIN_SZ: usize = 8;\n201\tconst RULE_BEGIN: &[u8] = b\"Rule: \";\n202\tconst RULE_BEGIN_SZ: usize = 6;\n203\tconst SRCIP_BEGIN: &[u8] = b\"Src IP: \";\n204\tconst SRCIP_BEGIN_SZ: usize = 8;\n205\tconst SRCPORT_BEGIN: &[u8] = b\"Src Port: \";\n206\tconst SRCPORT_BEGIN_SZ: usize = 10;\n207\tconst DSTIP_BEGIN: &[u8] = b\"Dst IP: \";\n208\tconst DSTIP_BEGIN_SZ: usize = 8;\n209\tconst DSTPORT_BEGIN: &[u8] = b\"Dst Port: \";\n210\tconst DSTPORT_BEGIN_SZ: usize = 10;\n211\tconst USER_BEGIN: &[u8] = b\"User: \";\n212\tconst USER_BEGIN_SZ: usize = 6;\n213\tconst ALERT_MAIL: &[u8] = b\"mail\";\n214\tconst ALERT_MAIL_SZ: usize = 4;\n215\t\n216\tconst LOG_LIMIT: usize = 100;\n217\t\n218\t#[unsafe(no_mangle)]\n219\tpub unsafe extern \"C\" fn FreeAlertData(al_data: *mut alert_data) {\n220\t    if al_data.is_null() {\n221\t        // The C version is __attribute__((nonnull)), so passing NULL is UB.\n222\t        // Match C behavior and just dereference; but we choose to early-return\n223\t        // safely here since we only use `os_free` semantics.\n224\t        return;\n225\t    }\n226\t    unsafe {\n227\t        os_free(&mut (*al_data).alertid);\n228\t        os_free(&mut (*al_data).date);\n229\t        os_free(&mut (*al_data).location);\n230\t        os_free(&mut (*al_data).comment);\n231\t        os_free(&mut (*al_data).group);\n232\t        os_free(&mut (*al_data).srcip);\n233\t        os_free(&mut (*al_data).dstip);\n234\t        os_free(&mut (*al_data).user);\n235\t        os_free(&mut (*al_data).filename);\n236\t        libc::free(al_data as *mut c_void);\n237\t    }\n238\t}\n239\t\n240\t#[unsafe(no_mangle)]\n241\tpub unsafe extern \"C\" fn GetAlertData(flag: c_int, fp: *mut libc::FILE) -> *mut alert_data {\n242\t    unsafe {\n243\t        let al_data = os_calloc(1, std::mem::size_of::<alert_data>() as libc::size_t)\n244\t            as *mut alert_data;\n245\t\n246\t        let mut _r: c_int = 0;\n247\t        let mut issyscheck: c_int = 0;\n248\t        let mut log_size: usize = 0;\n249\t        let mut p: *mut c_char;\n250\t        let mut str_buf: [c_char; OS_MAXSTR + 1] = [0; OS_MAXSTR + 1];\n251\t        str_buf[OS_MAXSTR] = 0;\n252\t\n253\t        loop {\n254\t            let res = libc::fgets(str_buf.as_mut_ptr(), OS_MAXSTR as c_int, fp);\n255\t            if res.is_null() {\n256\t                break;\n257\t            }\n258\t            let str_ptr = str_buf.as_mut_ptr();\n259\t\n260\t            // Check for \"** Alert\" prefix\n261\t            if libc::strncmp(\n262\t                ALERT_BEGIN.as_ptr() as *const c_char,\n263\t                str_ptr,\n264\t                ALERT_BEGIN_SZ,\n265\t            ) == 0\n266\t            {\n267\t                let z: libc::size_t;\n268\t\n269\t                // End of the alert\n270\t                if _r == 2 {\n271\t                    let len = libc::strlen(str_ptr);\n272\t                    if libc::fseek(fp, -(len as libc::c_long), libc::SEEK_CUR) != -1 {\n273\t                        return al_data;\n274\t                    } else {\n275\t                        // l_error\n276\t                        FreeAlertData(al_data);\n277\t                        libc::clearerr(fp);\n278\t                        return ptr::null_mut();\n279\t                    }\n280\t                }\n281\t\n282\t                p = str_ptr.add(ALERT_BEGIN_SZ + 1);\n283\t\n284\t                let m = libc::strstr(p, b\":\\0\".as_ptr() as *const c_char);\n285\t                if m.is_null() {\n286\t                    continue;\n287\t                }\n288\t\n289\t                z = libc::strlen(p) - libc::strlen(m);\n290\t                (*al_data).alertid = os_realloc(\n291\t                    (*al_data).alertid as *mut c_void,\n292\t                    (z + 1) * std::mem::size_of::<c_char>(),\n293\t                ) as *mut c_char;\n294\t                libc::strncpy((*al_data).alertid, p, z);\n295\t                *((*al_data).alertid.add(z)) = 0;\n296\t\n297\t                // Search for email flag\n298\t                p = libc::strchr(p, b' ' as c_int);\n299\t                if p.is_null() {\n300\t                    continue;\n301\t                }\n302\t                p = p.add(1);\n303\t\n304\t                if (flag & CRALERT_MAIL_SET) != 0\n305\t                    && libc::strncmp(\n306\t                        ALERT_MAIL.as_ptr() as *const c_char,\n307\t                        p,\n308\t                        ALERT_MAIL_SZ,\n309\t                    ) != 0\n310\t                {\n311\t                    continue;\n312\t                }\n313\t\n314\t                p = libc::strchr(p, b'-' as c_int);\n315\t                if !p.is_null() {\n316\t                    p = p.add(1);\n317\t                    // Skip leading spaces\n318\t                    while *p == (b' ' as c_char) {\n319\t                        p = p.add(1);\n320\t                    }\n321\t                    os_free(&mut (*al_data).group);\n322\t                    (*al_data).group = os_strdup(p);\n323\t\n324\t                    // Clean newline from group\n325\t                    os_clearnl((*al_data).group);\n326\t                    if !(*al_data).group.is_null()\n327\t                        && !libc::strstr(\n328\t                            (*al_data).group,\n329\t                            b\"syscheck\\0\".as_ptr() as *const c_char,\n330\t                        )\n331\t                        .is_null()\n332\t                    {\n333\t                        issyscheck = 1;\n334\t                    }\n335\t                }\n336\t\n337\t                _r = 1;\n338\t                let _ = z; // silence unused warning if reached\n339\t                continue;\n340\t            }\n341\t\n342\t            if _r < 1 {\n343\t                continue;\n344\t            }\n345\t\n346\t            // r == 1: date / location line\n347\t            if _r == 1 {\n348\t                os_clearnl(str_ptr);\n349\t\n350\t                p = libc::strchr(str_ptr, b':' as c_int);\n351\t                if !p.is_null() {\n352\t                    p = libc::strchr(p, b' ' as c_int);\n353\t                    if !p.is_null() {\n354\t                        *p = 0;\n355\t                        p = p.add(1);\n356\t                    } else {\n357\t                        libc::perror(b\"date of location not NULL\\0\".as_ptr() as *const c_char);\n358\t                        // l_error\n359\t                        FreeAlertData(al_data);\n360\t                        libc::clearerr(fp);\n361\t                        return ptr::null_mut();\n362\t                    }\n363\t                }\n364\t\n365\t                if !(*al_data).date.is_null() || !(*al_data).location.is_null() || p.is_null() {\n366\t                    libc::perror(\n367\t                        b\"date or location not NULL or p is NULL\\0\".as_ptr() as *const c_char,\n368\t                    );\n369\t                    FreeAlertData(al_data);\n370\t                    libc::clearerr(fp);\n371\t                    return ptr::null_mut();\n372\t                }\n373\t\n374\t                (*al_data).date = os_strdup(str_ptr);\n375\t                (*al_data).location = os_strdup(p);\n376\t                _r = 2;\n377\t                log_size = 0;\n378\t                continue;\n379\t            } else if _r == 2 {\n380\t                // Rule begin\n381\t                if libc::strncmp(RULE_BEGIN.as_ptr() as *const c_char, str_ptr, RULE_BEGIN_SZ)\n382\t                    == 0\n383\t                {\n384\t                    os_clearnl(str_ptr);\n385\t\n386\t                    p = str_ptr.add(RULE_BEGIN_SZ);\n387\t                    (*al_data).rule = libc::atoi(p) as c_uint;\n388\t\n389\t                    p = libc::strchr(p, b' ' as c_int);\n390\t                    if !p.is_null() {\n391\t                        p = p.add(1);\n392\t                        p = libc::strchr(p, b' ' as c_int);\n393\t                        if !p.is_null() {\n394\t                            p = p.add(1);\n395\t                        }\n396\t                    }\n397\t\n398\t                    if p.is_null() {\n399\t                        FreeAlertData(al_data);\n400\t                        libc::clearerr(fp);\n401\t                        return ptr::null_mut();\n402\t                    }\n403\t\n404\t                    (*al_data).level = libc::atoi(p) as c_uint;\n405\t\n406\t                    // Get the comment\n407\t                    p = libc::strchr(p, b'\\'' as c_int);\n408\t                    if p.is_null() {\n409\t                        FreeAlertData(al_data);\n410\t                        libc::clearerr(fp);\n411\t                        return ptr::null_mut();\n412\t                    }\n413\t\n414\t                    p = p.add(1);\n415\t                    os_free(&mut (*al_data).comment);\n416\t                    (*al_data).comment = os_strdup(p);\n417\t\n418\t                    // Closing '\n419\t                    p = libc::strrchr((*al_data).comment, b'\\'' as c_int);\n420\t                    if !p.is_null() {\n421\t                        *p = 0;\n422\t                    } else {\n423\t                        FreeAlertData(al_data);\n424\t                        libc::clearerr(fp);\n425\t                        return ptr::null_mut();\n426\t                    }\n427\t                } else if libc::strncmp(\n428\t                    SRCIP_BEGIN.as_ptr() as *const c_char,\n429\t                    str_ptr,\n430\t                    SRCIP_BEGIN_SZ,\n431\t                ) == 0\n432\t                {\n433\t                    os_clearnl(str_ptr);\n434\t\n435\t                    p = str_ptr.add(SRCIP_BEGIN_SZ);\n436\t                    os_free(&mut (*al_data).srcip);\n437\t                    (*al_data).srcip = os_strdup(p);\n438\t                } else if libc::strncmp(\n439\t                    SRCPORT_BEGIN.as_ptr() as *const c_char,\n440\t                    str_ptr,\n441\t                    SRCPORT_BEGIN_SZ,\n442\t                ) == 0\n443\t                {\n444\t                    os_clearnl(str_ptr);\n445\t                    p = str_ptr.add(SRCPORT_BEGIN_SZ);\n446\t                    (*al_data).srcport = libc::atoi(p);\n447\t                } else if libc::strncmp(\n448\t                    DSTIP_BEGIN.as_ptr() as *const c_char,\n449\t                    str_ptr,\n450\t                    DSTIP_BEGIN_SZ,\n451\t                ) == 0\n452\t                {\n453\t                    os_clearnl(str_ptr);\n454\t                    p = str_ptr.add(DSTIP_BEGIN_SZ);\n455\t                    os_free(&mut (*al_data).dstip);\n456\t                    (*al_data).dstip = os_strdup(p);\n457\t                } else if libc::strncmp(\n458\t                    DSTPORT_BEGIN.as_ptr() as *const c_char,\n459\t                    str_ptr,\n460\t                    DSTPORT_BEGIN_SZ,\n461\t                ) == 0\n462\t                {\n463\t                    os_clearnl(str_ptr);\n464\t                    p = str_ptr.add(DSTPORT_BEGIN_SZ);\n465\t                    (*al_data).dstport = libc::atoi(p);\n466\t                } else if libc::strncmp(\n467\t                    USER_BEGIN.as_ptr() as *const c_char,\n468\t                    str_ptr,\n469\t                    USER_BEGIN_SZ,\n470\t                ) == 0\n471\t                {\n472\t                    os_clearnl(str_ptr);\n473\t                    p = str_ptr.add(USER_BEGIN_SZ);\n474\t                    os_free(&mut (*al_data).user);\n475\t                    (*al_data).user = os_strdup(p);\n476\t                } else if log_size < LOG_LIMIT {\n477\t                    os_clearnl(str_ptr);\n478\t                    if issyscheck == 1 {\n479\t                        if libc::strncmp(\n480\t                            str_ptr,\n481\t                            b\"Integrity checksum changed for: '\\0\".as_ptr() as *const c_char,\n482\t                            33,\n483\t                        ) == 0\n484\t                        {\n485\t                            (*al_data).filename = libc::strdup(str_ptr.add(33));\n486\t                            if !(*al_data).filename.is_null() {\n487\t                                let len = libc::strlen((*al_data).filename);\n488\t                                if len > 0 {\n489\t                                    *((*al_data).filename.add(len - 1)) = 0;\n490\t                                }\n491\t                            }\n492\t                        }\n493\t                        issyscheck = 0;\n494\t                    }\n495\t                    let _ = log_size; // not incremented (matches C — log_size only tracked in dead code)\n496\t                }\n497\t            }\n498\t        }\n499\t\n500\t        if libc::feof(fp) != 0 && _r == 2 {\n501\t            return al_data;\n502\t        }\n503\t\n504\t        // l_error\n505\t        FreeAlertData(al_data);\n506\t        libc::clearerr(fp);\n507\t        ptr::null_mut()\n508\t    }\n509\t}\n510\t\n511\t// ----------------------------------------------------------------------------\n512\t// file-queue.c\n513\t// ----------------------------------------------------------------------------\n514\t\n515\tconst FSTAT_ERROR: &[u8] =\n516\t    b\"(1118): Could not retrieve information of file '%s' due to [(%d)-(%s)].\\0\";\n517\tconst FSEEK_ERROR: &[u8] =\n518\t    b\"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\\0\";\n519\t\n520\tstatic S_MONTH: [&[u8]; 12] = [\n521\t    b\"Jan\\0\", b\"Feb\\0\", b\"Mar\\0\", b\"Apr\\0\", b\"May\\0\", b\"Jun\\0\", b\"Jul\\0\", b\"Aug\\0\", b\"Sep\\0\",\n522\t    b\"Oct\\0\", b\"Nov\\0\", b\"Dec\\0\",\n523\t];\n524\t\n525\tunsafe fn file_sleep() {\n526\t    let mut fp_timeout = libc::timeval {\n527\t        tv_sec: FQ_TIMEOUT,\n528\t        tv_usec: 0,\n529\t    };\n530\t    unsafe {\n531\t        libc::select(\n532\t            0,\n533\t            ptr::null_mut(),\n534\t            ptr::null_mut(),\n535\t            ptr::null_mut(),\n536\t            &mut fp_timeout,\n537\t        );\n538\t    }\n539\t}\n540\t\n541\tunsafe fn GetFile_Queue(fileq: *mut file_queue) {\n542\t    unsafe {\n543\t        (*fileq).file_name[0] = 0;\n544\t        (*fileq).file_name[MAX_FQUEUE] = 0;\n545\t\n546\t        let name_ptr: *const c_char = if ((*fileq).flags & CRALERT_FP_SET) != 0 {\n547\t            STDIN_NAME.as_ptr() as *const c_char\n548\t        } else {\n549\t            ALERTS_DAILY.as_ptr() as *const c_char\n550\t        };\n551\t\n552\t        libc::snprintf(\n553\t            (*fileq).file_name.as_mut_ptr(),\n554\t            MAX_FQUEUE,\n555\t            b\"%s\\0\".as_ptr() as *const c_char,\n556\t            name_ptr,\n557\t        );\n558\t    }\n559\t}\n560\t\n561\tunsafe fn Handle_Queue(fileq: *mut file_queue, flags: c_int) -> c_int {\n562\t    unsafe {\n563\t        // Close if open (when not FP_SET)\n564\t        if (flags & CRALERT_FP_SET) == 0 {\n565\t            if !(*fileq).fp.is_null() {\n566\t                libc::fclose((*fileq).fp);\n567\t                (*fileq).fp = ptr::null_mut();\n568\t            }\n569\t\n570\t            (*fileq).fp = libc::fopen(\n571\t                (*fileq).file_name.as_ptr(),\n572\t                b\"r\\0\".as_ptr() as *const c_char,\n573\t            );\n574\t            if (*fileq).fp.is_null() {\n575\t                return 0;\n576\t            }\n577\t        }\n578\t\n579\t        // Seek to the end of the file\n580\t        if (flags & CRALERT_READ_ALL) == 0 {\n581\t            if (*fileq).fp.is_null() {\n582\t                return 0;\n583\t            }\n584\t\n585\t            if libc::fseek((*fileq).fp, 0, libc::SEEK_END) < 0 {\n586\t                let err = *libc::__errno_location();\n587\t                merror(\n588\t                    FSEEK_ERROR.as_ptr() as *const c_char,\n589\t                    (*fileq).file_name.as_ptr(),\n590\t                    err,\n591\t                    libc::strerror(err),\n592\t                );\n593\t                libc::fclose((*fileq).fp);\n594\t                (*fileq).fp = ptr::null_mut();\n595\t                return -1;\n596\t            }\n597\t        }\n598\t\n599\t        // File change time\n600\t        if !(*fileq).fp.is_null() {\n601\t            if libc::fstat(libc::fileno((*fileq).fp), &mut (*fileq).f_status) < 0 {\n602\t                let err = *libc::__errno_location();\n603\t                merror(\n604\t                    FSTAT_ERROR.as_ptr() as *const c_char,\n605\t                    (*fileq).file_name.as_ptr(),\n606\t                    err,\n607\t                    libc::strerror(err),\n608\t                );\n609\t                libc::fclose((*fileq).fp);\n610\t                (*fileq).fp = ptr::null_mut();\n611\t                return -1;\n612\t            }\n613\t        }\n614\t\n615\t        (*fileq).last_change = (*fileq).f_status.st_mtime;\n616\t        1\n617\t    }\n618\t}\n619\t\n620\t#[unsafe(no_mangle)]\n621\tpub unsafe extern \"C\" fn Init_FileQueue(\n622\t    fileq: *mut file_queue,\n623\t    p: *const tm,\n624\t    flags: c_int,\n625\t) -> c_int {\n626\t    unsafe {\n627\t        if (flags & CRALERT_FP_SET) == 0 {\n628\t            (*fileq).fp = ptr::null_mut();\n629\t        }\n630\t        (*fileq).last_change = 0;\n631\t        (*fileq).flags = 0;\n632\t\n633\t        (*fileq).day = (*p).tm_mday;\n634\t        (*fileq).year = (*p).tm_year + 1900;\n635\t\n636\t        let month_idx = (*p).tm_mon as usize;\n637\t        let mon_str = S_MONTH[month_idx];\n638\t        // strncpy(fileq->mon, s_month[p->tm_mon], 3);\n639\t        // copies up to 3 bytes; does NOT null-terminate beyond what's copied.\n640\t        libc::strncpy(\n641\t            (*fileq).mon.as_mut_ptr(),\n642\t            mon_str.as_ptr() as *const c_char,\n643\t            3,\n644\t        );\n645\t\n646\t        // memset(fileq->file_name, '\\0', MAX_FQUEUE + 1)\n647\t        libc::memset(\n648\t            (*fileq).file_name.as_mut_ptr() as *mut c_void,\n649\t            0,\n650\t            MAX_FQUEUE + 1,\n651\t        );\n652\t\n653\t        (*fileq).flags = flags;\n654\t\n655\t        GetFile_Queue(fileq);\n656\t\n657\t        if Handle_Queue(fileq, (*fileq).flags) < 0 {\n658\t            return -1;\n659\t        }\n660\t\n661\t        0\n662\t    }\n663\t}\n664\t\n665\t#[unsafe(no_mangle)]\n666\tpub unsafe extern \"C\" fn Read_FileMon(\n667\t    fileq: *mut file_queue,\n668\t    p: *const tm,\n669\t    timeout: c_uint,\n670\t) -> *mut alert_data {\n671\t    unsafe {\n672\t        let mut i: c_uint = 0;\n673\t        let mut al_data: *mut alert_data;\n674\t\n675\t        if (*fileq).fp.is_null() {\n676\t            if Handle_Queue(fileq, 0) != 1 {\n677\t                file_sleep();\n678\t                return ptr::null_mut();\n679\t            }\n680\t        }\n681\t\n682\t        if (*fileq).fp.is_null() {\n683\t            return ptr::null_mut();\n684\t        }\n685\t\n686\t        al_data = GetAlertData((*fileq).flags, (*fileq).fp);\n687\t        if !al_data.is_null() {\n688\t            return al_data;\n689\t        }\n690\t\n691\t        (*fileq).day = (*p).tm_mday;\n692\t        (*fileq).year = (*p).tm_year + 1900;\n693\t        let month_idx = (*p).tm_mon as usize;\n694\t        let mon_str = S_MONTH[month_idx];\n695\t        libc::strncpy(\n696\t            (*fileq).mon.as_mut_ptr(),\n697\t            mon_str.as_ptr() as *const c_char,\n698\t            3,\n699\t        );\n700\t\n701\t        GetFile_Queue(fileq);\n702\t\n703\t        if Handle_Queue(fileq, 0) != 1 {\n704\t            file_sleep();\n705\t            return ptr::null_mut();\n706\t        }\n707\t\n708\t        while i < timeout {\n709\t            al_data = GetAlertData((*fileq).flags, (*fileq).fp);\n710\t            if !al_data.is_null() {\n711\t                return al_data;\n712\t            }\n713\t\n714\t            i += 1;\n715\t            file_sleep();\n716\t        }\n717\t\n718\t        ptr::null_mut()\n719\t    }\n720\t}\n721\t\n722\t// ----------------------------------------------------------------------------\n723\t// driver.c\n724\t// ----------------------------------------------------------------------------\n725\t\n726\t#[unsafe(no_mangle)]\n727\tpub unsafe extern \"C\" fn driver(\n728\t    day: c_int,\n729\t    month: c_int,\n730\t    year: c_int,\n731\t    timeout: c_uint,\n732\t    flags: c_int,\n733\t) -> *mut alert_data {\n734\t    unsafe {\n735\t        // Match the C zero-init; only mday/mon/year set by the C version.\n736\t        let mut time = tm {\n737\t            tm_sec: 0,\n738\t            tm_min: 0,\n739\t            tm_hour: 0,\n740\t            tm_mday: day,\n741\t            tm_mon: month,\n742\t            tm_year: year,\n743\t            tm_wday: 0,\n744\t            tm_yday: 0,\n745\t            tm_isdst: 0,\n746\t            tm_gmtoff: 0,\n747\t            tm_zone: ptr::null(),\n748\t        };\n749\t\n750\t        let mut fq: file_queue = std::mem::zeroed();\n751\t\n752\t        if Init_FileQueue(&mut fq, &mut time, flags) < 0 {\n753\t            eprint_no_newline(\"File queue initialization failed\");\n754\t            return ptr::null_mut();\n755\t        }\n756\t\n757\t        let al_data = Read_FileMon(&mut fq, &mut time, timeout);\n758\t\n759\t        if !fq.fp.is_null() {\n760\t            libc::fclose(fq.fp);\n761\t        }\n762\t        al_data\n763\t    }\n764\t}\n765\t\n766\t// Quiet \"unused\" warnings for constants intentionally kept to mirror the C source.\n767\t#[allow(dead_code)]\n768\tconst _UNUSED_FQ_TIMEOUT_REF: i64 = FQ_TIMEOUT;\n769\t"}]},"parent_tool_use_id":null,"session_id":"2c0a6b91-af33-4948-ac14-6261301657d9","uuid":"d2970286-420d-4cca-87eb-714422ab9033","timestamp":"2026-05-27T16:43:45.797Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-work-Y9yaXD/translated_rust/src/lib.rs","content":"//! Rust translation of the driver C library.\n//!\n//! Provides byte-identical behavior to the original C code under `c_src/`.\n\n#![allow(non_camel_case_types)]\n#![allow(non_snake_case)]\n#![allow(non_upper_case_globals)]\n\nuse std::ffi::{c_char, c_int, c_uint, c_void};\nuse std::ptr;\n\n// ----------------------------------------------------------------------------\n// Constants from headers\n// ----------------------------------------------------------------------------\n\nconst MAX_FQUEUE: usize = 256;\nconst FQ_TIMEOUT: i64 = 5;\n\nconst ALERTS_DAILY: &[u8] = b\"alerts.log\\0\";\nconst STDIN_NAME: &[u8] = b\"<stdin>\\0\";\n\nconst CRALERT_MAIL_SET: c_int = 0x001;\n#[allow(dead_code)]\nconst CRALERT_EXEC_SET: c_int = 0x002;\nconst CRALERT_READ_ALL: c_int = 0x004;\n#[allow(dead_code)]\nconst CRALERT_READ_FAILED: c_int = 0x008;\nconst CRALERT_FP_SET: c_int = 0x010;\n\nconst OS_MAXSTR: usize = 1024;\n\n// ----------------------------------------------------------------------------\n// C struct layouts (must match the headers exactly)\n// ----------------------------------------------------------------------------\n\n#[repr(C)]\npub struct alert_data {\n    pub rule: c_uint,\n    pub level: c_uint,\n    pub alertid: *mut c_char,\n    pub date: *mut c_char,\n    pub location: *mut c_char,\n    pub comment: *mut c_char,\n    pub group: *mut c_char,\n    pub srcip: *mut c_char,\n    pub srcport: c_int,\n    pub dstip: *mut c_char,\n    pub dstport: c_int,\n    pub user: *mut c_char,\n    pub filename: *mut c_char,\n}\n\n// `struct tm` from <time.h>. Glibc layout (Linux x86_64):\n//   int tm_sec;\n//   int tm_min;\n//   int tm_hour;\n//   int tm_mday;\n//   int tm_mon;\n//   int tm_year;\n//   int tm_wday;\n//   int tm_yday;\n//   int tm_isdst;\n//   long tm_gmtoff;\n//   const char *tm_zone;\n#[repr(C)]\npub struct tm {\n    pub tm_sec: c_int,\n    pub tm_min: c_int,\n    pub tm_hour: c_int,\n    pub tm_mday: c_int,\n    pub tm_mon: c_int,\n    pub tm_year: c_int,\n    pub tm_wday: c_int,\n    pub tm_yday: c_int,\n    pub tm_isdst: c_int,\n    pub tm_gmtoff: libc::c_long,\n    pub tm_zone: *const c_char,\n}\n\n#[repr(C)]\npub struct file_queue {\n    pub last_change: libc::time_t,\n    pub year: c_int,\n    pub day: c_int,\n    pub flags: c_int,\n\n    pub mon: [c_char; 4],\n    pub file_name: [c_char; MAX_FQUEUE + 1],\n\n    pub fp: *mut libc::FILE,\n    pub f_status: libc::stat,\n}\n\n// ----------------------------------------------------------------------------\n// Helpers: os_calloc / os_realloc / os_strdup mirror the C versions in shared.h\n// ----------------------------------------------------------------------------\n\nunsafe fn os_calloc(num: libc::size_t, size: libc::size_t) -> *mut c_void {\n    let out = unsafe { libc::calloc(num, size) };\n    if out.is_null() {\n        eprint_no_newline(\"Memory allocation failed in os_calloc\");\n        unsafe { libc::exit(libc::EXIT_FAILURE) };\n    }\n    out\n}\n\nunsafe fn os_realloc(ptr: *mut c_void, new_size: libc::size_t) -> *mut c_void {\n    let out = unsafe { libc::realloc(ptr, new_size) };\n    if out.is_null() {\n        eprint_no_newline(\"Memory allocation failed in os_realloc\");\n        unsafe { libc::exit(libc::EXIT_FAILURE) };\n    }\n    out\n}\n\nunsafe fn os_strdup(str_ptr: *const c_char) -> *mut c_char {\n    if str_ptr.is_null() {\n        eprint_no_newline(\"NULL string passed to os_strdup\");\n        unsafe { libc::exit(libc::EXIT_FAILURE) };\n    }\n    let dup = unsafe { libc::strdup(str_ptr) };\n    if dup.is_null() {\n        eprint_no_newline(\"Memory allocation failed in os_strdup\");\n        unsafe { libc::exit(libc::EXIT_FAILURE) };\n    }\n    dup\n}\n\n/// Mirrors `fprintf(stderr, \"...\")` (no trailing newline) used by os_calloc et al.\nfn eprint_no_newline(s: &str) {\n    use std::io::Write;\n    let stderr = std::io::stderr();\n    let mut h = stderr.lock();\n    let _ = h.write_all(s.as_bytes());\n    let _ = h.flush();\n}\n\n/// Equivalent of the `os_free(x)` macro: free if non-null and clear the slot.\nunsafe fn os_free(p: &mut *mut c_char) {\n    if !p.is_null() {\n        unsafe { libc::free(*p as *mut c_void) };\n        *p = ptr::null_mut();\n    }\n}\n\n/// Equivalent of `os_clearnl(x, p)` which sets the last '\\n' in `x` to '\\0'.\nunsafe fn os_clearnl(x: *mut c_char) {\n    if x.is_null() {\n        return;\n    }\n    let p = unsafe { libc::strrchr(x, b'\\n' as c_int) };\n    if !p.is_null() {\n        unsafe { *p = 0 };\n    }\n}\n\n// ----------------------------------------------------------------------------\n// merror — formatted error to stderr (with trailing newline)\n// ----------------------------------------------------------------------------\n\nunsafe fn merror(\n    err_template: *const c_char,\n    file_name: *const c_char,\n    err: c_int,\n    err_msg: *const c_char,\n) {\n    let mut buffer: [c_char; 256] = [0; 256];\n    unsafe {\n        libc::snprintf(\n            buffer.as_mut_ptr(),\n            buffer.len(),\n            err_template,\n            file_name,\n            err,\n            err_msg,\n        );\n        libc::fprintf(\n            stderr_handle(),\n            b\"%s\\n\\0\".as_ptr() as *const c_char,\n            buffer.as_ptr(),\n        );\n    }\n}\n\nfn stderr_handle() -> *mut libc::FILE {\n    // libc on glibc/musl exposes `stderr` indirectly through a TLS / extern.\n    // Use `fdopen`-free approach via the libc crate's extern \"C\" stderr.\n    unsafe extern \"C\" {\n        static mut stderr: *mut libc::FILE;\n    }\n    unsafe { stderr }\n}\n\n// ----------------------------------------------------------------------------\n// read-alert.c\n// ----------------------------------------------------------------------------\n\n// String constants (with their lengths)\nconst ALERT_BEGIN: &[u8] = b\"** Alert\";\nconst ALERT_BEGIN_SZ: usize = 8;\nconst RULE_BEGIN: &[u8] = b\"Rule: \";\nconst RULE_BEGIN_SZ: usize = 6;\nconst SRCIP_BEGIN: &[u8] = b\"Src IP: \";\nconst SRCIP_BEGIN_SZ: usize = 8;\nconst SRCPORT_BEGIN: &[u8] = b\"Src Port: \";\nconst SRCPORT_BEGIN_SZ: usize = 10;\nconst DSTIP_BEGIN: &[u8] = b\"Dst IP: \";\nconst DSTIP_BEGIN_SZ: usize = 8;\nconst DSTPORT_BEGIN: &[u8] = b\"Dst Port: \";\nconst DSTPORT_BEGIN_SZ: usize = 10;\nconst USER_BEGIN: &[u8] = b\"User: \";\nconst USER_BEGIN_SZ: usize = 6;\nconst ALERT_MAIL: &[u8] = b\"mail\";\nconst ALERT_MAIL_SZ: usize = 4;\n\nconst LOG_LIMIT: usize = 100;\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn FreeAlertData(al_data: *mut alert_data) {\n    if al_data.is_null() {\n        // The C version is __attribute__((nonnull)), so passing NULL is UB.\n        // Match C behavior and just dereference; but we choose to early-return\n        // safely here since we only use `os_free` semantics.\n        return;\n    }\n    unsafe {\n        os_free(&mut (*al_data).alertid);\n        os_free(&mut (*al_data).date);\n        os_free(&mut (*al_data).location);\n        os_free(&mut (*al_data).comment);\n        os_free(&mut (*al_data).group);\n        os_free(&mut (*al_data).srcip);\n        os_free(&mut (*al_data).dstip);\n        os_free(&mut (*al_data).user);\n        os_free(&mut (*al_data).filename);\n        libc::free(al_data as *mut c_void);\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn GetAlertData(flag: c_int, fp: *mut libc::FILE) -> *mut alert_data {\n    unsafe {\n        let al_data = os_calloc(1, std::mem::size_of::<alert_data>() as libc::size_t)\n            as *mut alert_data;\n\n        let mut _r: c_int = 0;\n        let mut issyscheck: c_int = 0;\n        let mut log_size: usize = 0;\n        let mut p: *mut c_char;\n        let mut str_buf: [c_char; OS_MAXSTR + 1] = [0; OS_MAXSTR + 1];\n        str_buf[OS_MAXSTR] = 0;\n\n        loop {\n            let res = libc::fgets(str_buf.as_mut_ptr(), OS_MAXSTR as c_int, fp);\n            if res.is_null() {\n                break;\n            }\n            let str_ptr = str_buf.as_mut_ptr();\n\n            // Check for \"** Alert\" prefix\n            if libc::strncmp(\n                ALERT_BEGIN.as_ptr() as *const c_char,\n                str_ptr,\n                ALERT_BEGIN_SZ,\n            ) == 0\n            {\n                let z: libc::size_t;\n\n                // End of the alert\n                if _r == 2 {\n                    let len = libc::strlen(str_ptr);\n                    if libc::fseek(fp, -(len as libc::c_long), libc::SEEK_CUR) != -1 {\n                        return al_data;\n                    } else {\n                        // l_error\n                        FreeAlertData(al_data);\n                        libc::clearerr(fp);\n                        return ptr::null_mut();\n                    }\n                }\n\n                p = str_ptr.add(ALERT_BEGIN_SZ + 1);\n\n                let m = libc::strstr(p, b\":\\0\".as_ptr() as *const c_char);\n                if m.is_null() {\n                    continue;\n                }\n\n                z = libc::strlen(p) - libc::strlen(m);\n                (*al_data).alertid = os_realloc(\n                    (*al_data).alertid as *mut c_void,\n                    (z + 1) * std::mem::size_of::<c_char>(),\n                ) as *mut c_char;\n                libc::strncpy((*al_data).alertid, p, z);\n                *((*al_data).alertid.add(z)) = 0;\n\n                // Search for email flag\n                p = libc::strchr(p, b' ' as c_int);\n                if p.is_null() {\n                    continue;\n                }\n                p = p.add(1);\n\n                if (flag & CRALERT_MAIL_SET) != 0\n                    && libc::strncmp(\n                        ALERT_MAIL.as_ptr() as *const c_char,\n                        p,\n                        ALERT_MAIL_SZ,\n                    ) != 0\n                {\n                    continue;\n                }\n\n                p = libc::strchr(p, b'-' as c_int);\n                if !p.is_null() {\n                    p = p.add(1);\n                    // Skip leading spaces\n                    while *p == (b' ' as c_char) {\n                        p = p.add(1);\n                    }\n                    os_free(&mut (*al_data).group);\n                    (*al_data).group = os_strdup(p);\n\n                    // Clean newline from group\n                    os_clearnl((*al_data).group);\n                    if !(*al_data).group.is_null()\n                        && !libc::strstr(\n                            (*al_data).group,\n                            b\"syscheck\\0\".as_ptr() as *const c_char,\n                        )\n                        .is_null()\n                    {\n                        issyscheck = 1;\n                    }\n                }\n\n                _r = 1;\n                let _ = z; // silence unused warning if reached\n                continue;\n            }\n\n            if _r < 1 {\n                continue;\n            }\n\n            // r == 1: date / location line\n            if _r == 1 {\n                os_clearnl(str_ptr);\n\n                p = libc::strchr(str_ptr, b':' as c_int);\n                if !p.is_null() {\n                    p = libc::strchr(p, b' ' as c_int);\n                    if !p.is_null() {\n                        *p = 0;\n                        p = p.add(1);\n                    } else {\n                        libc::perror(b\"date of location not NULL\\0\".as_ptr() as *const c_char);\n                        // l_error\n                        FreeAlertData(al_data);\n                        libc::clearerr(fp);\n                        return ptr::null_mut();\n                    }\n                }\n\n                if !(*al_data).date.is_null() || !(*al_data).location.is_null() || p.is_null() {\n                    libc::perror(\n                        b\"date or location not NULL or p is NULL\\0\".as_ptr() as *const c_char,\n                    );\n                    FreeAlertData(al_data);\n                    libc::clearerr(fp);\n                    return ptr::null_mut();\n                }\n\n                (*al_data).date = os_strdup(str_ptr);\n                (*al_data).location = os_strdup(p);\n                _r = 2;\n                log_size = 0;\n                continue;\n            } else if _r == 2 {\n                // Rule begin\n                if libc::strncmp(RULE_BEGIN.as_ptr() as *const c_char, str_ptr, RULE_BEGIN_SZ)\n                    == 0\n                {\n                    os_clearnl(str_ptr);\n\n                    p = str_ptr.add(RULE_BEGIN_SZ);\n                    (*al_data).rule = libc::atoi(p) as c_uint;\n\n                    p = libc::strchr(p, b' ' as c_int);\n                    if !p.is_null() {\n                        p = p.add(1);\n                        p = libc::strchr(p, b' ' as c_int);\n                        if !p.is_null() {\n                            p = p.add(1);\n                        }\n                    }\n\n                    if p.is_null() {\n                        FreeAlertData(al_data);\n                        libc::clearerr(fp);\n                        return ptr::null_mut();\n                    }\n\n                    (*al_data).level = libc::atoi(p) as c_uint;\n\n                    // Get the comment\n                    p = libc::strchr(p, b'\\'' as c_int);\n                    if p.is_null() {\n                        FreeAlertData(al_data);\n                        libc::clearerr(fp);\n                        return ptr::null_mut();\n                    }\n\n                    p = p.add(1);\n                    os_free(&mut (*al_data).comment);\n                    (*al_data).comment = os_strdup(p);\n\n                    // Closing '\n                    p = libc::strrchr((*al_data).comment, b'\\'' as c_int);\n                    if !p.is_null() {\n                        *p = 0;\n                    } else {\n                        FreeAlertData(al_data);\n                        libc::clearerr(fp);\n                        return ptr::null_mut();\n                    }\n                } else if libc::strncmp(\n                    SRCIP_BEGIN.as_ptr() as *const c_char,\n                    str_ptr,\n                    SRCIP_BEGIN_SZ,\n                ) == 0\n                {\n                    os_clearnl(str_ptr);\n\n                    p = str_ptr.add(SRCIP_BEGIN_SZ);\n                    os_free(&mut (*al_data).srcip);\n                    (*al_data).srcip = os_strdup(p);\n                } else if libc::strncmp(\n                    SRCPORT_BEGIN.as_ptr() as *const c_char,\n                    str_ptr,\n                    SRCPORT_BEGIN_SZ,\n                ) == 0\n                {\n                    os_clearnl(str_ptr);\n                    p = str_ptr.add(SRCPORT_BEGIN_SZ);\n                    (*al_data).srcport = libc::atoi(p);\n                } else if libc::strncmp(\n                    DSTIP_BEGIN.as_ptr() as *const c_char,\n                    str_ptr,\n                    DSTIP_BEGIN_SZ,\n                ) == 0\n                {\n                    os_clearnl(str_ptr);\n                 