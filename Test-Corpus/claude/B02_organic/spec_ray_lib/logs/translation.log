{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_fmfugwukux66xvdufpebfw2662wrf6kajev3vyk6gnnrtzxf6bpa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_014Dk7JmiaqH1z9W1ySaG8MN","name":"Write","input":{"file_path":"/tmp/harvest-translate-rE0E3Y/translated_rust/src/lib.rs","content":"#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(dead_code)]\n\nuse std::ffi::c_int;\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Raycast {\n    pub t: f32,\n    pub n: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct c2Circle {\n    p: c2v,\n    r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct c2AABB {\n    min: c2v,\n    max: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct c2Capsule {\n    a: c2v,\n    b: c2v,\n    r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct c2Ray {\n    p: c2v,\n    d: c2v,\n    t: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct c2m {\n    x: c2v,\n    y: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, PartialEq, Eq)]\nenum C2_TYPE {\n    C2_TYPE_CIRCLE = 0,\n    C2_TYPE_AABB = 1,\n    C2_TYPE_CAPSULE = 2,\n}\n\n#[inline]\nfn c2V(x: f32, y: f32) -> c2v {\n    c2v { x, y }\n}\n\n#[inline]\nfn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n#[inline]\nfn c2Len(a: c2v) -> f32 {\n    c2Dot(a, a).sqrt()\n}\n\n#[inline]\nfn c2Add(mut a: c2v, b: c2v) -> c2v {\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[inline]\nfn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[inline]\nfn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n#[inline]\nfn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n#[inline]\nfn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[inline]\nfn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y <