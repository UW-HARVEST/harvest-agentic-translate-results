                                                i32, f32, f32, f32, f32, f32)> = get(&r, b\"omni_manifold\");\n        for a in shapes.iter() {\n            for b in shapes.iter() {\n                let mut mc = c2Manifold::default();\n                let mut mr = c2Manifold::default();\n                cf(&mut mc, a.0, a.1, a.2, a.3, a.4, a.5, b.0, b.1, b.2, b.3, b.4, b.5);\n                rf(&mut mr, a.0, a.1, a.2, a.3, a.4, a.5, b.0, b.1, b.2, b.3, b.4, b.5);\n                let cb = (mc.n.x.to_bits(), mc.n.y.to_bits());\n                let rb = (mr.n.x.to_bits(), mr.n.y.to_bits());\n                if cb != rb || mc.count != mr.count\n                    || mc.depths[0].to_bits() != mr.depths[0].to_bits()\n                    || mc.depths[1].to_bits() != mr.depths[1].to_bits()\n                    || mc.contact_points[0].x.to_bits() != mr.contact_points[0].x.to_bits()\n                    || mc.contact_points[0].y.to_bits() != mr.contact_points[0].y.to_bits()\n                    || mc.contact_points[1].x.to_bits() != mr.contact_points[1].x.to_bits()\n                    || mc.contact_points[1].y.to_bits() != mr.contact_points[1].y.to_bits()\n                {\n                    println!(\"MISMATCH a={:?} b={:?}\", a, b);\n                    println!(\"  C: count={} n.x_bits={:08x} n.y_bits={:08x} depths=[{},{}] cp0=({:08x},{:08x}) cp1=({:08x},{:08x})\",\n                             mc.count, mc.n.x.to_bits(), mc.n.y.to_bits(),\n                             mc.depths[0], mc.depths[1],\n                             mc.contact_points[0].x.to_bits(), mc.contact_points[0].y.to_bits(),\n                             mc.contact_points[1].x.to_bits(), mc.contact_points[1].y.to_bits());\n                    println!(\"  R: count={} n.x_bits={:08x} n.y_bits={:08x} depths=[{},{}] cp0=({:08x},{:08x}) cp1=({:08x},{:08x})\",\n                             mr.count, mr.n.x.to_bits(), mr.n.y.to_bits(),\n                             mr.depths[0], mr.depths[1],\n           