roxy(shape: *const std::ffi::c_void, ty: C2_TYPE, p: *mut c2Proxy) {\n    unsafe { crate::c2MakeProxy(shape, ty, &mut *p) }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    crate::c2Len(a)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    crate::c2Det2(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    unsafe { crate::c2GJKSimplexMetric(&*s) }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    crate::c2Mulrv(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    crate::c2MulrvT(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n    crate::c2Add(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    crate::c2Mulxv(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulxvT(a: c2x, b: c2v) -> c2v {\n    crate::c2MulxvT(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Intersect(a: c2v, b: c2v, da: f32, db: f32) -> c2v {\n    crate::c2Intersect(a, b, da, db)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    crate::c2Div(a, b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    crate::c2Norm(a)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    crate::c2Neg(a)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    crate::c2CCW90(a)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c22(s: *mut c2Simplex) {\n    unsafe { crate::c22(&mut *s) }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c23(s: *mut c2Simplex) {\n    unsafe { crate::c23(&mut *s) }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    crate::c2Skew(a)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    unsafe { crate::c2D(&*s) }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    unsafe {\n        let slice = std::slice::from_raw_parts(verts, count as usize);\n        crate::c2Support(slice, count, d)\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n    unsafe { crate::c2Witness(&*s, &mut *a, &mut *b) }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n    unsafe { crate::c2L(&*s) }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2GJK(\n    a: *const std::ffi::c_void,\n    typeA: C2_TYPE,\n    ax_ptr: *const c2x,\n    b: *const std::ffi::c_void,\n    typeB: C2_TYPE,\n    bx_ptr: *const c2x,\n    out_a: *mut c2v,\n    out_b: *mut c2v,\n    use_radius: c_int,\n    iterations: *mut c_int,\n    cache: *mut c2GJKCache,\n) -> f32 {\n    unsafe {\n        let ax = if ax_ptr.is_null() { None } else { Some(&*ax_ptr) };\n        let bx = if bx_ptr.is_null() { None } else { Some(&*bx_ptr) };\n        let outa = if out_a.is_null() { None } else { Some(&mut *out_a) };\n        let outb = if out_b.is_null() { None } else { Some(&mut *out_b) };\n        let it = if iterations.is_null() { None } else { Some(&mut *iterations) };\n        let cc = if cache.is_null() { None } else { Some(&mut *cache) };\n        crate::c2GJK(a, typeA, ax, b, typeB, bx, outa, outb, use_radius, it, cc)\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n    crate::c2Absv(a)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCircleManifold(A: c2Circle, B: c2Circle, m: *mut c2Manifold) {\n    unsafe { crate::c2CircletoCircleManifold(A, B, &mut *m) }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoAABBManifold(A: c2Circle, B: c2AABB, m: *mut c2Manifold) {\n    unsafe { crate::c2CircletoAABBManifold(A, B, &mut *m) }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCapsuleManifold(A: c2Circle, B: c2Capsule, m: *mut c2Manifold) {\n    unsafe { crate::c2CircletoCapsuleManifold