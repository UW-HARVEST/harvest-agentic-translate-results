       norms: [c2v::default(); 8],\n95\t        }\n96\t    }\n97\t}\n98\t\n99\t#[repr(C)]\n100\t#[derive(Copy, Clone, Default)]\n101\tstruct c2GJKCache {\n102\t    metric: f32,\n103\t    count: c_int,\n104\t    iA: [c_int; 3],\n105\t    iB: [c_int; 3],\n106\t    div: f32,\n107\t}\n108\t\n109\t#[repr(C)]\n110\t#[derive(Copy, Clone, Default)]\n111\tstruct c2Proxy {\n112\t    radius: f32,\n113\t    count: c_int,\n114\t    verts: [c2v; 8],\n115\t}\n116\t\n117\t#[repr(C)]\n118\t#[derive(Copy, Clone, Default)]\n119\tstruct c2sv {\n120\t    sA: c2v,\n121\t    sB: c2v,\n122\t    p: c2v,\n123\t    u: f32,\n124\t    iA: c_int,\n125\t    iB: c_int,\n126\t}\n127\t\n128\t#[repr(C)]\n129\t#[derive(Copy, Clone, Default)]\n130\tstruct c2Simplex {\n131\t    a: c2sv,\n132\t    b: c2sv,\n133\t    c: c2sv,\n134\t    d: c2sv,\n135\t    div: f32,\n136\t    count: c_int,\n137\t}\n138\t\n139\t// ----- Math helpers -----\n140\t\n141\t#[inline]\n142\tfn c2V(x: f32, y: f32) -> c2v {\n143\t    c2v { x, y }\n144\t}\n145\t\n146\t#[inline]\n147\tfn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n148\t    a.x *= b;\n149\t    a.y *= b;\n150\t    a\n151\t}\n152\t\n153\t#[inline]\n154\tfn c2Maxv(a: c2v, b: c2v) -> c2v {\n155\t    c2V(\n156\t        if a.x > b.x { a.x } else { b.x },\n157\t        if a.y > b.y { a.y } else { b.y },\n158\t    )\n159\t}\n160\t\n161\t#[inline]\n162\tfn c2Minv(a: c2v, b: c2v) -> c2v {\n163\t    c2V(\n164\t        if a.x < b.x { a.x } else { b.x },\n165\t        if a.y < b.y { a.y } else { b.y },\n166\t    )\n167\t}\n168\t\n169\t#[inline]\n170\tfn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n171\t    c2Maxv(lo, c2Minv(a, hi))\n172\t}\n173\t\n174\t#[inline]\n175\tfn c2Sub(mut a: c2v, b: c2v) -> c2v {\n176\t    a.x -= b.x;\n177\t    a.y -= b.y;\n178\t    a\n179\t}\n180\t\n181\t#[inline]\n182\tfn c2Dot(a: c2v, b: c2v) -> f32 {\n183\t    a.x * b.x + a.y * b.y\n184\t}\n185\t\n186\t#[inline]\n187\tfn c2Dist(h: c2h, p: c2v) -> f32 {\n188\t    c2Dot(h.n, p) - h.d\n189\t}\n190\t\n191\t#[inline]\n192\tfn c2PlaneAt(p: &c2Poly, i: c_int) -> c2h {\n193\t    let i = i as usize;\n194\t    c2h {\n195\t        n: p.norms[i],\n196\t        d: c2Dot(p.norms[i], p.verts[i]),\n197\t    }\n198\t}\n199\t\n200\t#[inline]\n201\tfn c2RotIdentity() -> c2r {\n202\t    c2r { c: 1.0, s: 0.0 }\n203\t}\n204\t\n205\t#[inline]\n206\tfn c2xIdentity() -> c2x {\n207\t    c2x {\n208\t        p: c2V(0.0, 0.0),\n209\t        r: c2RotIdentity(),\n210\t    }\n211\t}\n212\t\n213\tfn c2BBVerts(out: &mut [c2v], bb: &c2AABB) {\n214\t    out[0] = bb.min;\n215\t    out[1] = c2V(bb.max.x, bb.min.y);\n216\t    out[2] = bb.max;\n217\t    out[3] = c2V(bb.min.x, bb.max.y);\n218\t}\n219\t\n220\tunsafe fn c2MakeProxy(shape: *const std::ffi::c_void, ty: C2_TYPE, p: &mut c2Proxy) {\n221\t    match ty {\n222\t        C2_TYPE_CIRCLE => {\n223\t            let c = unsafe { &*(shape as *const c2Circle) };\n224\t            p.radius = c.r;\n225\t            p.count = 1;\n226\t            p.verts[0] = c.p;\n227\t        }\n228\t        C2_TYPE_AABB => {\n229\t            let bb = unsafe { &*(shape as *const c2AABB) };\n230\t            p.radius = 0.0;\n231\t            p.count = 4;\n232\t            c2BBVerts(&mut p.verts, bb);\n233\t        }\n234\t        C2_TYPE_CAPSULE => {\n235\t            let c = unsafe { &*(shape as *const c2Capsule) };\n236\t            p.radius = c.r;\n237\t            p.count = 2;\n238\t            p.verts[0] = c.a;\n239\t            p.verts[1] = c.b;\n240\t        }\n241\t        _ => {}\n242\t    }\n243\t}\n244\t\n245\t#[inline]\n246\tfn c2Len(a: c2v) -> f32 {\n247\t    c2Dot(a, a).sqrt()\n248\t}\n249\t\n250\t#[inline]\n251\tfn c2Det2(a: c2v, b: c2v) -> f32 {\n252\t    a.x * b.y - a.y * b.x\n253\t}\n254\t\n255\tfn c2GJKSimplexMetric(s: &c2Simplex) -> f32 {\n256\t    match s.count {\n257\t        2 => c2Len(c2Sub(s.b.p, s.a.p)),\n258\t        3 => c2Det2(c2Sub(s.b.p, s.a.p), c2Sub(s.c.p, s.a.p)),\n259\t        _ => 0.0,\n260\t    }\n261\t}\n262\t\n263\t#[inline]\n264\tfn c2Mulrv(a: c2r, b: c2v) -> c2v {\n265\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n266\t}\n267\t\n268\t#[inline]\n269\tfn c2MulrvT(a: c2r, b: c2v) -> c2v {\n270\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n271\t}\n272\t\n273\t#[inline]\n274\tfn c2Add(mut a: c2v, b: c2v) -> c2v {\n275\t    a.x += b.x;\n276\t    a.y += b.y;\n277\t    a\n278\t}\n279\t\n280\t#[inline]\n281\tfn c2Mulxv(a: c2x, b: c2v) -> c2v {\n282\t    c2Add(c2Mulrv(a.r, b), a.p)\n283\t}\n284\t\n285\t#[inline]\n286\tfn c2MulxvT(a: c2x, b: c2v) -> c2v {\n287\t    c2MulrvT(a.r, c2Sub(b, a.p))\n288\t}\n289\t\n290\t#[inline]\n291\tfn c2Intersect(a: c2v, b: c2v, da: f32, db: f32) -> c2v {\n292\t    c2Add(a, c2Mulvs(c2Sub(b, a), da / (da - db)))\n293\t}\n294\t\n295\tfn c2Clip(seg: &mut [c2v; 2], h: c2h) -> c_int {\n296\t    let mut out: [c2v; 2] = [c2v::default(); 2];\n297\t    let mut sp: usize = 0;\n298\t    let d0 = c2Dist(h, seg[0]);\n299\t    if d0 < 0.0 {\n300\t        out[sp] = seg[0];\n301\t        sp += 1;\n302\t    }\n303\t    let d1 = c2Dist(h, seg[1]);\n304\t    if d1 < 0.0 {\n305\t        out[sp] = seg[1];\n306\t        sp += 1;\n307\t    }\n308\t    if d0 == 0.0 && d1 == 0.0 {\n309\t        out[sp] = seg[0];\n310\t        sp += 1;\n311\t        // Note: in C, this writes to out[sp++] where sp may equal 2 already (since both\n312\t        // d0 < 0 and d1 < 0 are false when they're both zero), but we may overflow.\n313\t        // Reproduce the C behavior precisely.\n314\t        if sp < 2 {\n315\t            out[sp] = seg[1];\n316\t            sp += 1;\n317\t        } else {\n318\t            // C writes past array boundary - this would be UB. Skip in safe Rust.\n319\t            sp += 1;\n320\t        }\n321\t    } else if d0 * d1 <= 0.0 {\n322\t        if sp < 2 {\n323\t            out[sp] = c2Intersect(seg[0], seg[1], d0, d1);\n324\t            sp += 1;\n325\t        } else {\n326\t            sp += 1;\n327\t        }\n328\t    }\n329\t    seg[0] = out[0];\n330\t    seg[1] = out[1];\n331\t    sp as c_int\n332\t}\n333\t\n334\t#[inline]\n335\tfn c2Div(a: c2v, b: f32) -> c2v {\n336\t    c2Mulvs(a, 1.0 / b)\n337\t}\n338\t\n339\t#[inline]\n340\tfn c2Norm(a: c2v) -> c2v {\n341\t    c2Div(a, c2Len(a))\n342\t}\n343\t\n344\t#[inline]\n345\tfn c2Neg(a: c2v) -> c2v {\n346\t    c2V(-a.x, -a.y)\n347\t}\n348\t\n349\t#[inline]\n350\tfn c2CCW90(a: c2v) -> c2v {\n351\t    c2v { x: a.y, y: -a.x }\n352\t}\n353\t\n354\tfn c2SidePlanes(seg: &mut [c2v; 2], ra: c2v, rb: c2v, h: Option<&mut c2h>) -> c_int {\n355\t    let inv = c2Norm(c2Sub(rb, ra));\n356\t    let left = c2h {\n357\t        n: c2Neg(inv),\n358\t        d: c2Dot(c2Neg(inv), ra),\n359\t    };\n360\t    let right = c2h {\n361\t        n: inv,\n362\t        d: c2Dot(inv, rb),\n363\t    };\n364\t    if c2Clip(seg, left) < 2 {\n365\t        return 0;\n366\t    }\n367\t    if c2Clip(seg, right) < 2 {\n368\t        return 0;\n369\t    }\n370\t    if let Some(h) = h {\n371\t        h.n = c2CCW90(inv);\n372\t        h.d = c2Dot(c2CCW90(inv), ra);\n373\t    }\n374\t    1\n375\t}\n376\t\n377\tfn c2SidePlanesFromPoly(\n378\t    seg: &mut [c2v; 2],\n379\t    x: c2x,\n380\t    p: &c2Poly,\n381\t    e: c_int,\n382\t    h: Option<&mut c2h>,\n383\t) -> c_int {\n384\t    let ra = c2Mulxv(x, p.verts[e as usize]);\n385\t    let next = if e + 1 == p.count { 0 } else { e + 1 };\n386\t    let rb = c2Mulxv(x, p.verts[next as usize]);\n387\t    c2SidePlanes(seg, ra, rb, h)\n388\t}\n389\t\n390\tfn c22(s: &mut c2Simplex) {\n391\t    let a = s.a.p;\n392\t    let b = s.b.p;\n393\t    let u = c2Dot(b, c2Sub(b, a));\n394\t    let v = c2Dot(a, c2Sub(a, b));\n395\t    if v <= 0.0 {\n396\t        s.a.u = 1.0;\n397\t        s.div = 1.0;\n398\t        s.count = 1;\n399\t    } else if u <= 0.0 {\n400\t        s.a = s.b;\n401\t        s.a.u = 1.0;\n402\t        s.div = 1.0;\n403\t        s.count = 1;\n404\t    } else {\n405\t        s.a.u = u;\n406\t        s.b.u = v;\n407\t        s.div = u + v;\n408\t        s.count = 2;\n409\t    }\n410\t}\n411\t\n412\tfn c23(s: &mut c2Simplex) {\n413\t    let a = s.a.p;\n414\t    let b = s.b.p;\n415\t    let c = s.c.p;\n416\t    let uAB = c2Dot(b, c2Sub(b, a));\n417\t    let vAB = c2Dot(a, c2Sub(a, b));\n418\t    let uBC = c2Dot(c, c2Sub(c, b));\n419\t    let vBC = c2Dot(b, c2Sub(b, c));\n420\t    let uCA = c2Dot(a, c2Sub(a, c));\n421\t    let vCA = c2Dot(c, c2Sub(c, a));\n422\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n423\t    let uABC = c2Det2(b, c) * area;\n424\t    let vABC = c2Det2(c, a) * area;\n425\t    let wABC = c2Det2(a, b) * area;\n426\t    if vAB <= 0.0 && uCA <= 0.0 {\n427\t        s.a.u = 1.0;\n428\t        s.div = 1.0;\n429\t        s.count = 1;\n430\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n431\t        s.a = s.b;\n432\t        s.a.u = 1.0;\n433\t        s.div = 1.0;\n434\t        s.count = 1;\n435\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n436\t        s.a = s.c;\n437\t        s.a.u = 1.0;\n438\t        s.div = 1.0;\n439\t        s.count = 1;\n440\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n441\t        s.a.u = uAB;\n442\t        s.b.u = vAB;\n443\t        s.div = uAB + vAB;\n444\t        s.count = 2;\n445\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n446\t        s.a = s.b;\n447\t        s.b = s.c;\n448\t        s.a.u = uBC;\n449\t        s.b.u = vBC;\n450\t        s.div = uBC + vBC;\n451\t        s.count = 2;\n452\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n453\t        s.b = s.a;\n454\t        s.a = s.c;\n455\t        s.a.u = uCA;\n456\t        s.b.u = vCA;\n457\t        s.div = uCA + vCA;\n458\t        s.count = 2;\n459\t    } else {\n460\t        s.a.u = uABC;\n461\t        s.b.u = vABC;\n462\t        s.c.u = wABC;\n463\t        s.div = uABC + vABC + wABC;\n464\t        s.count = 3;\n465\t    }\n466\t}\n467\t\n468\t#[inline]\n469\tfn c2Skew(a: c2v) -> c2v {\n470\t    c2v { x: -a.y, y: a.x }\n471\t}\n472\t\n473\tfn c2D(s: &c2Simplex) -> c2v {\n474\t    match s.count {\n475\t        1 => c2Neg(s.a.p),\n476\t        2 => {\n477\t            let ab = c2Sub(s.b.p, s.a.p);\n478\t            if c2Det2(ab, c2Neg(s.a.p)) > 0.0 {\n479\t                c2Skew(ab)\n480\t            } else {\n481\t                c2CCW90(ab)\n482\t            }\n483\t        }\n484\t        _ => c2V(0.0, 0.0),\n485\t    }\n486\t}\n487\t\n488\tfn c2Support(verts: &[c2v], count: c_int, d: c2v) -> c_int {\n489\t    let mut imax: c_int = 0;\n490\t    let mut dmax = c2Dot(verts[0], d);\n491\t    for i in 1..count {\n492\t        let dot = c2Dot(verts[i as usize], d);\n493\t        if dot > dmax {\n494\t            imax = i;\n495\t            dmax = dot;\n496\t        }\n497\t    }\n498\t    imax\n499\t}\n500\t\n501\tfn c2Witness(s: &c2Simplex, a: &mut c2v, b: &mut c2v) {\n502\t    let den = 1.0 / s.div;\n503\t    match s.count {\n504\t        1 => {\n505\t            *a = s.a.sA;\n506\t            *b = s.a.sB;\n507\t        }\n508\t        2 => {\n509\t            *a = c2Add(\n510\t                c2Mulvs(s.a.sA, den * s.a.u),\n511\t                c2Mulvs(s.b.sA, den * s.b.u),\n512\t            );\n513\t            *b = c2Add(\n514\t                c2Mulvs(s.a.sB, den * s.a.u),\n515\t                c2Mulvs(s.b.sB, den * s.b.u),\n516\t            );\n517\t        }\n518\t        3 => {\n519\t            *a = c2Add(\n520\t                c2Add(\n521\t                    c2Mulvs(s.a.sA, den * s.a.u),\n522\t                    c2Mulvs(s.b.sA, den * s.b.u),\n523\t                ),\n524\t                c2Mulvs(s.c.sA, den * s.c.u),\n525\t            );\n526\t            *b = c2Add(\n527\t                c2Add(\n528\t                    c2Mulvs(s.a.sB, den * s.a.u),\n529\t                    c2Mulvs(s.b.sB, den * s.b.u),\n530\t                ),\n531\t                c2Mulvs(s.c.sB, den * s.c.u),\n532\t            );\n533\t        }\n534\t        _ => {\n535\t            *a = c2V(0.0, 0.0);\n536\t            *b = c2V(0.0, 0.0);\n537\t        }\n538\t    }\n539\t}\n540\t\n541\tfn c2L(s: &c2Simplex) -> c2v {\n542\t    let den = 1.0 / s.div;\n543\t    match s.count {\n544\t        1 => s.a.p,\n545\t        2 => c2Add(\n546\t            c2Mulvs(s.a.p, den * s.a.u),\n547\t            c2Mulvs(s.b.p, den * s.b.u),\n548\t        ),\n549\t        _ => c2V(0.0, 0.0),\n550\t    }\n551\t}\n552\t\n553\t// helper: get c2sv at index i in simplex (0=a, 1=b, 2=c, 3=d)\n554\tfn simplex_get(s: &c2Simplex, i: usize) -> c2sv {\n555\t    match i {\n556\t        0 => s.a,\n557\t        1 => s.b,\n558\t        2 => s.c,\n559\t        _ => s.d,\n560\t    }\n561\t}\n562\t\n563\tfn simplex_set(s: &mut c2Simplex, i: usize, v: c2sv) {\n564\t    match i {\n565\t        0 => s.a = v,\n566\t        1 => s.b = v,\n567\t        2 => s.c = v,\n568\t        _ => s.d = v,\n569\t    }\n570\t}\n571\t\n572\tfn c2GJK(\n573\t    a_ptr: *const std::ffi::c_void,\n574\t    typeA: C2_TYPE,\n575\t    ax_ptr: Option<&c2x>,\n576\t    b_ptr: *const std::ffi::c_void,\n577\t    typeB: C2_TYPE,\n578\t    bx_ptr: Option<&c2x>,\n579\t    out_a: Option<&mut c2v>,\n580\t    out_b: Option<&mut c2v>,\n581\t    use_radius: c_int,\n582\t    iterations: Option<&mut c_int>,\n583\t    cache: Option<&mut c2GJKCache>,\n584\t) -> f32 {\n585\t    let ax = match ax_ptr {\n586\t        Some(a) => *a,\n587\t        None => c2xIdentity(),\n588\t    };\n589\t    let bx = match bx_ptr {\n590\t        Some(b) => *b,\n591\t        None => c2xIdentity(),\n592\t    };\n593\t    let mut pA = c2Proxy::default();\n594\t    let mut pB = c2Proxy::default();\n595\t    unsafe {\n596\t        c2MakeProxy(a_ptr, typeA, &mut pA);\n597\t        c2MakeProxy(b_ptr, typeB, &mut pB);\n598\t    }\n599\t    let mut s = c2Simplex::default();\n600\t    let mut cache_was_read = 0;\n601\t    if let Some(ref cache) = cache {\n602\t        let cache_was_good = cache.count != 0;\n603\t        if cache_was_good {\n604\t            for i in 0..cache.count as usize {\n605\t                let iA = cache.iA[i];\n606\t                let iB = cache.iB[i];\n607\t                let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n608\t                let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n609\t                let mut v = c2sv::default();\n610\t                v.iA = iA;\n611\t                v.sA = sA;\n612\t                v.iB = iB;\n613\t                v.sB = sB;\n614\t                v.p = c2Sub(v.sB, v.sA);\n615\t                v.u = 0.0;\n616\t                simplex_set(&mut s, i, v);\n617\t            }\n618\t            s.count = cache.count;\n619\t            s.div = cache.div;\n620\t            let metric_old = cache.metric;\n621\t            let metric = c2GJKSimplexMetric(&s);\n622\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n623\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n624\t            if !(min_metric < max_metric * 2.0 && metric < -1.0e8) {\n625\t                cache_was_read = 1;\n626\t            }\n627\t        }\n628\t    }\n629\t    if cache_was_read == 0 {\n630\t        s.a.iA = 0;\n631\t        s.a.iB = 0;\n632\t        s.a.sA = c2Mulxv(ax, pA.verts[0]);\n633\t        s.a.sB = c2Mulxv(bx, pB.verts[0]);\n634\t        s.a.p = c2Sub(s.a.sB, s.a.sA);\n635\t        s.a.u = 1.0;\n636\t        s.div = 1.0;\n637\t        s.count = 1;\n638\t    }\n639\t    let mut saveA: [c_int; 3] = [0; 3];\n640\t    let mut saveB: [c_int; 3] = [0; 3];\n641\t    let mut save_count: c_int;\n642\t    let mut d0: f32 = 3.40282346638528859811704183484516925e+38f32;\n643\t    let mut d1: f32;\n644\t    let mut iter: c_int = 0;\n645\t    let mut hit: c_int = 0;\n646\t    while iter < 20 {\n647\t        save_count = s.count;\n648\t        for i in 0..save_count as usize {\n649\t            let v = simplex_get(&s, i);\n650\t            saveA[i] = v.iA;\n651\t            saveB[i] = v.iB;\n652\t        }\n653\t        match s.count {\n654\t            2 => c22(&mut s),\n655\t            3 => c23(&mut s),\n656\t            _ => {}\n657\t        }\n658\t        if s.count == 3 {\n659\t            hit = 1;\n660\t            break;\n661\t        }\n662\t        let p = c2L(&s);\n663\t        d1 = c2Dot(p, p);\n664\t        if d1 > d0 {\n665\t            break;\n666\t        }\n667\t        d0 = d1;\n668\t        let d = c2D(&s);\n669\t        if c2Dot(d, d)\n670\t            < 1.19209289550781250000000000000000000e-7f32\n671\t                * 1.19209289550781250000000000000000000e-7f32\n672\t        {\n673\t            break;\n674\t        }\n675\t        let iA = c2Support(&pA.verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\n676\t        let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n677\t        let iB = c2Support(&pB.verts, pB.count, c2MulrvT(bx.r, d));\n678\t        let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n679\t        let mut v = c2sv::default();\n680\t        v.iA = iA;\n681\t        v.sA = sA;\n682\t        v.iB = iB;\n683\t        v.sB = sB;\n684\t        v.p = c2Sub(v.sB, v.sA);\n685\t        let mut dup = 0;\n686\t        for i in 0..save_count as usize {\n687\t            if iA == saveA[i] && iB == saveB[i] {\n688\t                dup = 1;\n689\t                break;\n690\t            }\n691\t        }\n692\t        if dup != 0 {\n693\t            break;\n694\t        }\n695\t        let count_idx = s.count as usize;\n696\t        simplex_set(&mut s, count_idx, v);\n697\t        s.count += 1;\n698\t        iter += 1;\n699\t    }\n700\t    let mut a = c2v::default();\n701\t    let mut b = c2v::default();\n702\t    c2Witness(&s, &mut a, &mut b);\n703\t    let mut dist = c2Len(c2Sub(a, b));\n704\t    if hit != 0 {\n705\t        a = b;\n706\t        dist = 0.0;\n707\t    } else if use_radius != 0 {\n708\t        let rA = pA.radius;\n709\t        let rB = pB.radius;\n710\t        if dist > rA + rB && dist > 1.19209289550781250000000000000000000e-7f32 {\n711\t            dist -= rA + rB;\n712\t            let n = c2Norm(c2Sub(b, a));\n713\t            a = c2Add(a, c2Mulvs(n, rA));\n714\t            b = c2Sub(b, c2Mulvs(n, rB));\n715\t            if a.x == b.x && a.y == b.y {\n716\t                dist = 0.0;\n717\t            }\n718\t        } else {\n719\t            let p = c2Mulvs(c2Add(a, b), 0.5);\n720\t            a = p;\n721\t            b = p;\n722\t            dist = 0.0;\n723\t        }\n724\t    }\n725\t    if let Some(cache) = cache {\n726\t        cache.metric = c2GJKSimplexMetric(&s);\n727\t        cache.count = s.count;\n728\t        for i in 0..s.count as usize {\n729\t            let v = simplex_get(&s, i);\n730\t            cache.iA[i] = v.iA;\n731\t            cache.iB[i] = v.iB;\n732\t        }\n733\t        cache.div = s.div;\n734\t    }\n735\t    if let Some(out_a) = out_a {\n736\t        *out_a = a;\n737\t    }\n738\t    if let Some(out_b) = out_b {\n739\t        *out_b = b;\n740\t    }\n741\t    if let Some(iterations) = iterations {\n742\t        *iterations = iter;\n743\t    }\n744\t    dist\n745\t}\n746\t\n747\t#[inline]\n748\tfn c2Absv(a: c2v) -> c2v {\n749\t    c2V(\n750\t        if a.x < 0.0 { -a.x } else { a.x },\n751\t        if a.y < 0.0 { -a.y } else { a.y },\n752\t    )\n753\t}\n754\t\n755\tfn c2CircletoCircleManifold(A: c2Circle, B: c2Circle, m: &mut c2Manifold) {\n756\t    m.count = 0;\n757\t    let d = c2Sub(B.p, A.p);\n758\t    let d2 = c2Dot(d, d);\n759\t    let r = A.r + B.r;\n760\t    if d2 < r * r {\n761\t        let l = d2.sqrt();\n762\t        let n = if l != 0.0 {\n763\t            c2Mulvs(d, 1.0 / l)\n764\t        } else {\n765\t            c2V(0.0, 1.0)\n766\t        };\n767\t        m.count = 1;\n768\t        m.depths[0] = r - l;\n769\t        m.contact_points[0] = c2Sub(B.p, c2Mulvs(n, B.r));\n770\t        m.n = n;\n771\t    }\n772\t}\n773\t\n774\tfn c2CircletoAABBManifold(A: c2Circle, B: c2AABB, m: &mut c2Manifold) {\n775\t    m.count = 0;\n776\t    let L = c2Clampv(A.p, B.min, B.max);\n777\t    let ab = c2Sub(L, A.p);\n778\t    let d2 = c2Dot(ab, ab);\n779\t    let r2 = A.r * A.r;\n780\t    if d2 < r2 {\n781\t        if d2 != 0.0 {\n782\t            let d = d2.sqrt();\n783\t            let n = c2Norm(ab);\n784\t            m.count = 1;\n785\t            m.depths[0] = A.r - d;\n786\t            m.contact_points[0] = c2Add(A.p, c2Mulvs(n, d));\n787\t            m.n = n;\n788\t        } else {\n789\t            let mid = c2Mulvs(c2Add(B.min, B.max), 0.5);\n790\t            let e = c2Mulvs(c2Sub(B.max, B.min), 0.5);\n791\t            let d = c2Sub(A.p, mid);\n792\t            let abs_d = c2Absv(d);\n793\t            let x_overlap = e.x - abs_d.x;\n794\t            let y_overlap = e.y - abs_d.y;\n795\t            let depth;\n796\t            let mut n;\n797\t            if x_overlap < y_overlap {\n798\t                depth = x_overlap;\n799\t                n = c2V(1.0, 0.0);\n800\t                n = c2Mulvs(n, if d.x < 0.0 { 1.0 } else { -1.0 });\n801\t            } else {\n802\t                depth = y_overlap;\n803\t                n = c2V(0.0, 1.0);\n804\t                n = c2Mulvs(n, if d.y < 0.0 { 1.0 } else { -1.0 });\n805\t            }\n806\t            m.count = 1;\n807\t            m.depths[0] = A.r + depth;\n808\t            m.contact_points[0] = c2Sub(A.p, c2Mulvs(n, depth));\n809\t            m.n = n;\n810\t        }\n811\t    }\n812\t}\n813\t\n814\tfn c2CircletoCapsuleManifold(A: c2Circle, B: c2Capsule, m: &mut c2Manifold) {\n815\t    m.count = 0;\n816\t    let mut a = c2v::default();\n817\t    let mut b = c2v::default();\n818\t    let r = A.r + B.r;\n819\t    let d = c2GJK(\n820\t        &A as *const _ as *const std::ffi::c_void,\n821\t        C2_TYPE_CIRCLE,\n822\t        None,\n823\t        &B as *const _ as *const std::ffi::c_void,\n824\t        C2_TYPE_CAPSULE,\n825\t        None,\n826\t        Some(&mut a),\n827\t        Some(&mut b),\n828\t        0,\n829\t        None,\n830\t        None,\n831\t    );\n832\t    if d < r {\n833\t        let n = if d == 0.0 {\n834\t            c2Norm(c2Skew(c2Sub(B.b, B.a)))\n835\t        } else {\n836\t            c2Norm(c2Sub(b, a))\n837\t        };\n838\t        m.count = 1;\n839\t        m.depths[0] = r - d;\n840\t        m.contact_points[0] = c2Sub(b, c2Mulvs(n, B.r));\n841\t        m.n = n;\n842\t    }\n843\t}\n844\t\n845\tfn c2AABBtoAABBManifold(A: c2AABB, B: c2AABB, m: &mut c2Manifold) {\n846\t    m.count = 0;\n847\t    let mid_a = c2Mulvs(c2Add(A.min, A.max), 0.5);\n848\t    let mid_b = c2Mulvs(c2Add(B.min, B.max), 0.5);\n849\t    let eA = c2Absv(c2Mulvs(c2Sub(A.max, A.min), 0.5));\n850\t    let eB = c2Absv(c2Mulvs(c2Sub(B.max, B.min), 0.5));\n851\t    let d = c2Sub(mid_b, mid_a);\n852\t    let dx = eA.x + eB.x - if d.x < 0.0 { -d.x } else { d.x };\n853\t    if dx < 0.0 {\n854\t        return;\n855\t    }\n856\t    let dy = eA.y + eB.y - if d.y < 0.0 { -d.y } else { d.y };\n857\t    if dy < 0.0 {\n858\t        return;\n859\t    }\n860\t    let n;\n861\t    let depth;\n862\t    let p;\n863\t    if dx < dy {\n864\t        depth = dx;\n865\t        if d.x < 0.0 {\n866\t            n = c2V(-1.0, 0.0);\n867\t            p = c2Sub(mid_a, c2V(eA.x, 0.0));\n868\t        } else {\n869\t            n = c2V(1.0, 0.0);\n870\t            p = c2Add(mid_a, c2V(eA.x, 0.0));\n871\t        }\n872\t    } else {\n873\t        depth = dy;\n874\t        if d.y < 0.0 {\n875\t            n = c2V(0.0, -1.0);\n876\t            p = c2Sub(mid_a, c2V(0.0, eA.y));\n877\t        } else {\n878\t            n = c2V(0.0, 1.0);\n879\t            p = c2Add(mid_a, c2V(0.0, eA.y));\n880\t        }\n881\t    }\n882\t    m.count = 1;\n883\t    m.contact_points[0] = p;\n884\t    m.depths[0] = depth;\n885\t    m.n = n;\n886\t}\n887\t\n888\tfn c2KeepDeep(seg: &[c2v; 2], h: c2h, m: &mut c2Manifold) {\n889\t    let mut cp: usize = 0;\n890\t    for i in 0..2 {\n891\t        let p = seg[i];\n892\t        let d = c2Dist(h, p);\n893\t        if d <= 0.0 {\n894\t            m.contact_points[cp] = p;\n895\t            m.depths[cp] = -d;\n896\t            cp += 1;\n897\t        }\n898\t    }\n899\t    m.count = cp as c_int;\n900\t    m.n = h.n;\n901\t}\n902\t\n903\tfn c2Incident(incident: &mut [c2v; 2], ip: &c2Poly, ix: c2x, rn_in_incident_space: c2v) {\n904\t    let mut index: c_int = !0;\n905\t    let mut min_dot: f32 = 3.40282346638528859811704183484516925e+38f32;\n906\t    for i in 0..ip.count {\n907\t        let dot = c2Dot(rn_in_incident_space, ip.norms[i as usize]);\n908\t        if dot < min_dot {\n909\t            min_dot = dot;\n910\t            index = i;\n911\t        }\n912\t    }\n913\t    incident[0] = c2Mulxv(ix, ip.verts[index as usize]);\n914\t    let next = if index + 1 == ip.count { 0 } else { index + 1 };\n915\t    incident[1] = c2Mulxv(ix, ip.verts[next as usize]);\n916\t}\n917\t\n918\tfn c2CapsuletoPolyManifold(A: c2Capsule, B: &c2Poly, bx_ptr: Option<&c2x>, m: &mut c2Manifold) {\n919\t    m.count = 0;\n920\t    let mut a = c2v::default();\n921\t    let mut b = c2v::default();\n922\t    let d = c2GJK(\n923\t        &A as *const _ as *const std::ffi::c_void,\n924\t        C2_TYPE_CAPSULE,\n925\t        None,\n926\t        B as *const _ as *const std::ffi::c_void,\n927\t        C2_TYPE_POLY,\n928\t        bx_ptr,\n929\t        Some(&mut a),\n930\t        Some(&mut b),\n931\t        0,\n932\t        None,\n933\t        None,\n934\t    );\n935\t    if d < 1.0e-6 {\n936\t        let bx = match bx_ptr {\n937\t            Some(b) => *b,\n938\t            None => c2xIdentity(),\n939\t        };\n940\t        let mut A_in_B = c2Capsule::default();\n941\t        A_in_B.a = c2MulxvT(bx, A.a);\n942\t        A_in_B.b = c2MulxvT(bx, A.b);\n943\t        let ab = c2Norm(c2Sub(A_in_B.a, A_in_B.b));\n944\t        let mut ab_h0 = c2h::default();\n945\t        ab_h0.n = c2CCW90(ab);\n946\t        ab_h0.d = c2Dot(A_in_B.a, ab_h0.n);\n947\t        let v0 = c2Support(&B.verts, B.count, c2Neg(ab_h0.n));\n948\t        let s0 = c2Dist(ab_h0, B.verts[v0 as usize]);\n949\t        let mut ab_h1 = c2h::default();\n950\t        ab_h1.n = c2Skew(ab);\n951\t        ab_h1.d = c2Dot(A_in_B.a, ab_h1.n);\n952\t        let v1 = c2Support(&B.verts, B.count, c2Neg(ab_h1.n));\n953\t        let s1 = c2Dist(ab_h1, B.verts[v1 as usize]);\n954\t        let mut index: c_int = !0;\n955\t        let mut sep: f32 = -3.40282346638528859811704183484516925e+38f32;\n956\t        let mut code: c_int = 0;\n957\t        for i in 0..B.count {\n958\t            let h = c2PlaneAt(B, i);\n959\t            let da = c2Dot(A_in_B.a, c2Neg(h.n));\n960\t            let db = c2Dot(A_in_B.b, c2Neg(h.n));\n961\t            let d_local = if da > db {\n962\t                c2Dist(h, A_in_B.a)\n963\t            } else {\n964\t                c2Dist(h, A_in_B.b)\n965\t            };\n966\t            if d_local > sep {\n967\t                sep = d_local;\n968\t                index = i;\n969\t            }\n970\t        }\n971\t        if s0 > sep {\n972\t            sep = s0;\n973\t            index = v0;\n974\t            code = 1;\n975\t        }\n976\t        if s1 > sep {\n977\t            // sep = s1; // not used after\n978\t            let _ = sep;\n979\t            index = v1;\n980\t            code = 2;\n981\t        }\n982\t        match code {\n983\t            0 => {\n984\t                let mut seg: [c2v; 2] = [A.a, A.b];\n985\t                let mut h = c2h::default();\n986\t                if c2SidePlanesFromPoly(&mut seg, bx, B, index, Some(&mut h)) == 0 {\n987\t                    return;\n988\t                }\n989\t                c2KeepDeep(&seg, h, m);\n990\t                m.n = c2Neg(m.n);\n991\t            }\n992\t            1 => {\n993\t                let mut incident: [c2v; 2] = [c2v::default(); 2];\n994\t                c2Incident(&mut incident, B, bx, ab_h0.n);\n995\t                let mut h = c2h::default();\n996\t                if c2SidePlanes(&mut incident, A_in_B.b, A_in_B.a, Some(&mut h)) == 0 {\n997\t                    return;\n998\t                }\n999\t                c2KeepDeep(&incident, h, m);\n1000\t            }\n1001\t            2 => {\n