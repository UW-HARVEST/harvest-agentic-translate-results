n    cast1: *mut c2Raycast,\n    cast2: *mut c2Raycast,\n    cast3: *mut c2Raycast,\n    mp_x: f32,\n    mp_y: f32,\n    r_p_x: f32,\n    r_p_y: f32,\n    c_p_x: f32,\n    c_p_y: f32,\n    c_r: f32,\n    cap_a_x: f32,\n    cap_a_y: f32,\n    cap_b_x: f32,\n    cap_b_y: f32,\n    cap_r: f32,\n    bb_min_x: f32,\n    bb_min_y: f32,\n    bb_max_x: f32,\n    bb_max_y: f32,\n) -> c_int {\n    let mut hit: c_int = 0;\n\n    let mp = c2V(mp_x, mp_y);\n\n    let mut ray = c2Ray {\n        p: c2V(r_p_x, r_p_y),\n        d: c2v { x: 0.0, y: 0.0 },\n        t: 0.0,\n    };\n    ray.d = c2Norm(c2Sub(mp, ray.p));\n    ray.t = c2Dot(mp, ray.d) - c2Dot(ray.p, ray.d);\n\n    let c = c2Circle {\n        p: c2V(c_p_x, c_p_y),\n        r: c_r,\n    };\n\n    hit += c2CastRay(\n        ray,\n        &c as *const c2Circle as *const core::ffi::c_void,\n        C2_TYPE::C2_TYPE_CIRCLE,\n        cast1,\n    );\n\n    let cap = c2Capsule {\n        a: c2V(cap_a_x, cap_a_y),\n        b: c2V(cap_b_x, cap_b_y),\n        r: cap_r,\n    };\n\n    hit += c2CastRay(\n        ray,\n        &cap as *const c2Capsule as *const core::ffi::c_void,\n        C2_TYPE::C2_TYPE_CAPSULE,\n        cast2,\n    ) << 1;\n\n    let bb = c2AABB {\n        min: c2V(bb_min_x, bb_min_y),\n        max: c2V(bb_max_x, bb_max_y),\n    };\n\n    hit += c2CastRay(\n        ray,\n        &bb as *const c2AABB as *const core::ffi::c_void,\n        C2_TYPE::C2_TYPE_AABB,\n        cast3,\n    ) << 2;\n\n    hit\n}\n","structuredPatch":[{"oldStart":19,"oldLines":138,"newStart":19,"newLines":139,"lines":[" "," #[repr(C)]"," #[derive(Copy, Clone)]","-struct c2Circle {","-    p: c2v,","-    r: f32,","+pub struct c2Circle {","+    pub p: c2v,","+    pub r: f32,"," }"," "," #[repr(C)]"," #[derive(Copy, Clone)]","-struct c2AABB {","-    min: c2v,","-    max: c2v,","+pub struct c2AABB {","+    pub min: c2v,","+    pub max: c2v,"," }"," "," #[repr(C)]"," #[derive(Copy, Clone)]","-struct c2Capsule {","-    a: c2v,","-    b: c2v,","-    r: