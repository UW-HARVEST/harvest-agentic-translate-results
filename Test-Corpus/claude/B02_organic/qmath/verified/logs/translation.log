}\n\n/// Formats a `double` exactly like glibc's `printf(\"%f\", v)`.\npub fn printf_f(v: f64) -> String {\n    if v.is_nan() {\n        // glibc honours the sign bit of NaN\n        if v.is_sign_negative() {\n            \"-nan\".to_string()\n        } else {\n            \"nan\".to_string()\n        }\n    } else if v.is_infinite() {\n        if v.is_sign_negative() {\n            \"-inf\".to_string()\n        } else {\n            \"inf\".to_string()\n        }\n    } else {\n        // Rust's fixed-precision formatting is exact and rounds ties to even,\n        // matching glibc in the default rounding mode.\n        format!(\"{:.6}\", v)\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4992,"cache_read_input_tokens":37803,"cache_creation":{"ephemeral_5m_input_tokens":4992,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"02ec8e29-c7ee-43df-9512-200e61ea39ff","uuid":"ab5540e2-e95f-4c1c-8c6b-dc723d4d82fc","timestamp":"2026-08-20T04:26:23.793Z"}
