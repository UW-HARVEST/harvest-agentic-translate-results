t\n175\t#[derive(Copy, Clone)]\n176\t#[repr(C)]\n177\tstruct c2sv {\n178\t    sA: c2v,\n179\t    sB: c2v,\n180\t    p: c2v,\n181\t    u: f32,\n182\t    iA: c_int,\n183\t    iB: c_int,\n184\t}\n185\t\n186\timpl c2sv {\n187\t    fn new() -> Self {\n188\t        c2sv {\n189\t            sA: c2v { x: 0.0, y: 0.0 },\n190\t            sB: c2v { x: 0.0, y: 0.0 },\n191\t            p: c2v { x: 0.0, y: 0.0 },\n192\t            u: 0.0,\n193\t            iA: 0,\n194\t            iB: 0,\n195\t        }\n196\t    }\n197\t}\n198\t\n199\t#[derive(Copy, Clone)]\n200\t#[repr(C)]\n201\tstruct c2Simplex {\n202\t    a: c2sv,\n203\t    b: c2sv,\n204\t    c: c2sv,\n205\t    d: c2sv,\n206\t    div: f32,\n207\t    count: c_int,\n208\t}\n209\t\n210\timpl c2Simplex {\n211\t    fn new() -> Self {\n212\t        c2Simplex {\n213\t            a: c2sv::new(),\n214\t            b: c2sv::new(),\n215\t            c: c2sv::new(),\n216\t            d: c2sv::new(),\n217\t            div: 0.0,\n218\t            count: 0,\n219\t        }\n220\t    }\n221\t    #[inline]\n222\t    fn get(&self, i: usize) -> c2sv {\n223\t        match i {\n224\t            0 => self.a,\n225\t            1 => self.b,\n226\t            2 => self.c,\n227\t            3 => self.d,\n228\t            _ => unreachable!(),\n229\t        }\n230\t    }\n231\t    #[inline]\n232\t    fn set(&mut self, i: usize, v: c2sv) {\n233\t        match i {\n234\t            0 => self.a = v,\n235\t            1 => self.b = v,\n236\t            2 => self.c = v,\n237\t            3 => self.d = v,\n238\t            _ => unreachable!(),\n239\t        }\n240\t    }\n241\t}\n242\t\n243\t#[inline]\n244\tfn c2Len(a: c2v) -> f32 {\n245\t    c2Dot(a, a).sqrt()\n246\t}\n247\t\n248\t#[inline]\n249\tfn c2Det2(a: c2v, b: c2v) -> f32 {\n250\t    a.x * b.y - a.y * b.x\n251\t}\n252\t\n253\tfn c2GJKSimplexMetric(s: &c2Simplex) -> f32 {\n254\t    match s.count {\n255\t        2 => c2Len(c2Sub(s.b.p, s.a.p)),\n256\t        3 => c2Det2(c2Sub(s.b.p, s.a.p), c2Sub(s.c.p, s.a.p)),\n257\t        _ => 0.0,\n258\t    }\n259\t}\n260\t\n261\t#[inline]\n262\tfn c2Mulrv(a: c2r, b: c2v) -> c2v {\n263\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n264\t}\n265\t\n266\t#[inline]\n267\tfn c2Add(mut a: c2v, b: c2v) -> c2v {\n268\t    a.x += b.x;\n269\t    a.y += b.y;\n270\t    a\n271\t}\n272\t\n273\t#[inline]\n274\tfn c2Mulxv(a: c2x, b: c2v) -> c2v {\n275\t    c2Add(c2Mulrv(a.r, b), a.p)\n276\t}\n277\t\n278\tfn c22(s: &mut c2Simplex) {\n279\t    let a = s.a.p;\n280\t    let b = s.b.p;\n281\t    let u = c2Dot(b, c2Sub(b, a));\n282\t    let v = c2Dot(a, c2Sub(a, b));\n283\t    if v <= 0.0 {\n284\t        s.a.u = 1.0;\n285\t        s.div = 1.0;\n286\t        s.count = 1;\n287\t    } else if u <= 0.0 {\n288\t        s.a = s.b;\n289\t        s.a.u = 1.0;\n290\t        s.div = 1.0;\n291\t        s.count = 1;\n292\t    } else {\n293\t        s.a.u = u;\n294\t        s.b.u = v;\n295\t        s.div = u + v;\n296\t        s.count = 2;\n297\t    }\n298\t}\n299\t\n300\tfn c23(s: &mut c2Simplex) {\n301\t    let a = s.a.p;\n302\t    let b = s.b.p;\n303\t    let c = s.c.p;\n304\t    let uAB = c2Dot(b, c2Sub(b, a));\n305\t    let vAB = c2Dot(a, c2Sub(a, b));\n306\t    let uBC = c2Dot(c, c2Sub(c, b));\n307\t    let vBC = c2Dot(b, c2Sub(b, c));\n308\t    let uCA = c2Dot(a, c2Sub(a, c));\n309\t    let vCA = c2Dot(c, c2Sub(c, a));\n310\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n311\t    let uABC = c2Det2(b, c) * area;\n312\t    let vABC = c2Det2(c, a) * area;\n313\t    let wABC = c2Det2(a, b) * area;\n314\t    if vAB <= 0.0 && uCA <= 0.0 {\n315\t        s.a.u = 1.0;\n316\t        s.div = 1.0;\n317\t        s.count = 1;\n318\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n319\t        s.a = s.b;\n320\t        s.a.u = 1.0;\n321\t        s.div = 1.0;\n322\t        s.count = 1;\n323\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n324\t        s.a = s.c;\n325\t        s.a.u = 1.0;\n326\t        s.div = 1.0;\n327\t        s.count = 1;\n328\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n329\t        s.a.u = uAB;\n330\t        s.b.u = vAB;\n331\t        s.div = uAB + vAB;\n332\t        s.count = 2;\n333\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n334\t        s.a = s.b;\n335\t        s.b = s.c;\n336\t        s.a.u = uBC;\n337\t        s.b.u = vBC;\n338\t        s.div = uBC + vBC;\n339\t        s.count = 2;\n340\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n341\t        s.b = s.a;\n342\t        s.a = s.c;\n343\t        s.a.u = uCA;\n344\t        s.b.u = vCA;\n345\t        s.div = uCA + vCA;\n346\t        s.count = 2;\n347\t    } else {\n348\t        s.a.u = uABC;\n349\t        s.b.u = vABC;\n350\t        s.c.u = wABC;\n351\t        s.div = uABC + vABC + wABC;\n352\t        s.count = 3;\n353\t    }\n354\t}\n355\t\n356\t#[inline]\n357\tfn c2Neg(a: c2v) -> c2v {\n358\t    c2V(-a.x, -a.y)\n359\t}\n360\t\n361\t#[inline]\n362\tfn c2Skew(a: c2v) -> c2v {\n363\t    c2v { x: -a.y, y: a.x }\n364\t}\n365\t\n366\t#[inline]\n367\tfn c2CCW90(a: c2v) -> c2v {\n368\t    c2v { x: a.y, y: -a.x }\n369\t}\n370\t\n371\tfn c2D(s: &c2Simplex) -> c2v {\n372\t    match s.count {\n373\t        1 => c2Neg(s.a.p),\n374\t        2 => {\n375\t            let ab = c2Sub(s.b.p, s.a.p);\n376\t            if c2Det2(ab, c2Neg(s.a.p)) > 0.0 {\n377\t                c2Skew(ab)\n378\t            } else {\n379\t                c2CCW90(ab)\n380\t            }\n381\t        }\n382\t        _ => c2V(0.0, 0.0),\n383\t    }\n384\t}\n385\t\n386\tfn c2Support(verts: &[c2v], count: c_int, d: c2v) -> c_int {\n387\t    let mut imax: c_int = 0;\n388\t    let mut dmax = c2Dot(verts[0], d);\n389\t    let mut i: c_int = 1;\n390\t    while i < count {\n391\t        let dot = c2Dot(verts[i as usize], d);\n392\t        if dot > dmax {\n393\t            imax = i;\n394\t            dmax = dot;\n395\t        }\n396\t        i += 1;\n397\t    }\n398\t    imax\n399\t}\n400\t\n401\tfn c2Witness(s: &c2Simplex, a: &mut c2v, b: &mut c2v) {\n402\t    let den = 1.0 / s.div;\n403\t    match s.count {\n404\t        1 => {\n405\t            *a = s.a.sA;\n406\t            *b = s.a.sB;\n407\t        }\n408\t        2 => {\n409\t            *a = c2Add(\n410\t                c2Mulvs(s.a.sA, den * s.a.u),\n411\t                c2Mulvs(s.b.sA, den * s.b.u),\n412\t            );\n413\t            *b = c2Add(\n414\t                c2Mulvs(s.a.sB, den * s.a.u),\n415\t                c2Mulvs(s.b.sB, den * s.b.u),\n416\t            );\n417\t        }\n418\t        3 => {\n419\t            *a = c2Add(\n420\t                c2Add(\n421\t                    c2Mulvs(s.a.sA, den * s.a.u),\n422\t                    c2Mulvs(s.b.sA, den * s.b.u),\n423\t                ),\n424\t                c2Mulvs(s.c.sA, den * s.c.u),\n425\t            );\n426\t            *b = c2Add(\n427\t                c2Add(\n428\t                    c2Mulvs(s.a.sB, den * s.a.u),\n429\t                    c2Mulvs(s.b.sB, den * s.b.u),\n430\t                ),\n431\t                c2Mulvs(s.c.sB, den * s.c.u),\n432\t            );\n433\t        }\n434\t        _ => {\n435\t            *a = c2V(0.0, 0.0);\n436\t            *b = c2V(0.0, 0.0);\n437\t        }\n438\t    }\n439\t}\n440\t\n441\t#[inline]\n442\tfn c2Div(a: c2v, b: f32) -> c2v {\n443\t    c2Mulvs(a, 1.0 / b)\n444\t}\n445\t\n446\t#[inline]\n447\tfn c2Norm(a: c2v) -> c2v {\n448\t    c2Div(a, c2Len(a))\n449\t}\n450\t\n451\tfn c2L(s: &c2Simplex) -> c2v {\n452\t    let den = 1.0 / s.div;\n453\t    match s.count {\n454\t        1 => s.a.p,\n455\t        2 => c2Add(\n456\t            c2Mulvs(s.a.p, den * s.a.u),\n457\t            c2Mulvs(s.b.p, den * s.b.u),\n458\t        ),\n459\t        _ => c2V(0.0, 0.0),\n460\t    }\n461\t}\n462\t\n463\t#[inline]\n464\tfn c2MulrvT(a: c2r, b: c2v) -> c2v {\n465\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n466\t}\n467\t\n468\tunsafe fn c2GJK(\n469\t    A: *const c_void,\n470\t    typeA: C2_TYPE,\n471\t    ax_ptr: *const c2x,\n472\t    B: *const c_void,\n473\t    typeB: 