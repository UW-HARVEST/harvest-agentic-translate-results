LL)\n2234\t    {\n2235\t        /* last element */\n2236\t        parent->child->prev = item->prev;\n2237\t    }\n2238\t\n2239\t    /* make sure the detached item doesn't point anywhere anymore */\n2240\t    item->prev = NULL;\n2241\t    item->next = NULL;\n2242\t\n2243\t    return item;\n2244\t}\n2245\t\n2246\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemFromArray(cJSON *array, int which)\n2247\t{\n2248\t    if (which < 0)\n2249\t    {\n2250\t        return NULL;\n2251\t    }\n2252\t\n2253\t    return cJSON_DetachItemViaPointer(array, get_array_item(array, (size_t)which));\n2254\t}\n2255\t\n2256\tCJSON_PUBLIC(void) cJSON_DeleteItemFromArray(cJSON *array, int which)\n2257\t{\n2258\t    cJSON_Delete(cJSON_DetachItemFromArray(array, which));\n2259\t}\n2260\t\n2261\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemFromObject(cJSON *object, const char *string)\n2262\t{\n2263\t    cJSON *to_detach = cJSON_GetObjectItem(object, string);\n2264\t\n2265\t    return cJSON_DetachItemViaPointer(object, to_detach);\n2266\t}\n2267\t\n2268\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemFromObjectCaseSensitive(cJSON *object, const char *string)\n2269\t{\n2270\t    cJSON *to_detach = cJSON_GetObjectItemCaseSensitive(object, string);\n2271\t\n2272\t    return cJSON_DetachItemViaPointer(object, to_detach);\n2273\t}\n2274\t\n2275\tCJSON_PUBLIC(void) cJSON_DeleteItemFromObject(cJSON *object, const char *string)\n2276\t{\n2277\t    cJSON_Delete(cJSON_DetachItemFromObject(object, string));\n2278\t}\n2279\t\n2280\tCJSON_PUBLIC(void) cJSON_DeleteItemFromObjectCaseSensitive(cJSON *object, const char *string)\n2281\t{\n2282\t    cJSON_Delete(cJSON_DetachItemFromObjectCaseSensitive(object, string));\n2283\t}\n2284\t\n2285\t/* Replace array/object items with new ones. */\n2286\tCJSON_PUBLIC(cJSON_bool) cJSON_InsertItemInArray(cJSON *array, int which, cJSON *newitem)\n2287\t{\n2288\t    cJSON *after_inserted = NULL;\n2289\t\n2290\t    if (which < 0 || newitem == NULL)\n2291\t    {\n2292\t        return false;\n2293\t    }\n2294\t\n2295\t    after_inserted = get_array_item(array, (size_t)which);\n2296\t    if (after_inserted == NULL)\n2297\t    {\n2298\t        return add_item_to_array(array, newitem);\n2299\t    }\n2300\t\n2301\t    if (after_inserted != array->child && after_inserted->prev == NULL) {\n2302\t        /* return false if after_inserted is a corrupted array item */\n2303\t        return false;\n2304\t    }\n2305\t\n2306\t    newitem->next = after_inserted;\n2307\t    newitem->prev = after_inserted->prev;\n2308\t    after_inserted->prev = newitem;\n2309\t    if (after_inserted == array->child)\n2310\t    {\n2311\t        array->child = newitem;\n2312\t    }\n2313\t    else\n2314\t    {\n2315\t        newitem->prev->next = newitem;\n2316\t    }\n2317\t    return true;\n2318\t}\n2319\t\n2320\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemViaPointer(cJSON * const parent, cJSON * const item, cJSON * replacement)\n2321\t{\n2322\t    if ((parent == NULL) || (parent->child == NULL) || (replacement == NULL) || (item == NULL))\n2323\t    {\n2324\t        return false;\n2325\t    }\n2326\t\n2327\t    if (replacement == item)\n2328\t    {\n2329\t        return true;\n2330\t    }\n2331\t\n2332\t    replacement->next = item->next;\n2333\t    replacement->prev = item->prev;\n2334\t\n2335\t    if (replacement->next != NULL)\n2336\t    {\n2337\t        replacement->next->prev = replacement;\n2338\t    }\n2339\t    if (parent->child == item)\n2340\t    {\n2341\t        if (parent->child->prev == parent->child)\n2342\t        {\n2343\t            replacement->prev = replacement;\n2344\t        }\n2345\t        parent->child = replacement;\n2346\t    }\n2347\t    else\n2348\t    {   /*\n2349\t         * To find the last item in array quickly, we use prev in array.\n2350\t         * We can't modify the last item's next pointer where this item was the parent's child\n2351\t         */\n2352\t        if (replacement->prev != NULL)\n2353\t        {\n2354\t            replacement->prev->next = replacement;\n2355\t        }\n2356\t        if (replacement->next == NULL)\n2357\t        {\n2358\t            parent->child->prev = replacement;\n2359\t        }\n2360\t    }\n2361\t\n2362\t    item->next = NULL;\n2363\t    item->prev = NULL;\n2364\t    cJSON_Delete(item);\n2365\t\n2366\t    return true;\n2367\t}\n2368\t\n2369\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemInArray(cJSON *array, int which, cJSON *newitem)\n2370\t{\n2371\t    if (which < 0)\n2372\t    {\n2373\t        return false;\n2374\t    }\n2375\t\n2376\t    return cJSON_ReplaceItemViaPointer(array, get_array_item(array, (size_t)which), newitem);\n2377\t}\n2378\t\n2379\tstatic cJSON_bool replace_item_in_object(cJSON *object, const char *string, cJSON *replacement, cJSON_bool case_sensitive)\n2380\t{\n2381\t    if ((replacement == NULL) || (string == NULL))\n2382\t    {\n2383\t        return false;\n2384\t    }\n2385\t\n2386\t    /* replace the name in the replacement */\n2387\t    if (!(replacement->type & cJSON_StringIsConst) && (replacement->string != NULL))\n2388\t    {\n2389\t        cJSON_free(replacement->string);\n2390\t    }\n2391\t    replacement->string = (char*)cJSON_strdup((const unsigned char*)string, &global_hooks);\n2392\t    if (replacement->string == NULL)\n2393\t    {\n2394\t        return false;\n2395\t    }\n2396\t\n2397\t    replacement->type &= ~cJSON_StringIsConst;\n2398\t\n2399\t    return cJSON_ReplaceItemViaPointer(object, get_object_item(object, string, case_sensitive), replacement);\n2400\t}\n2401\t\n2402\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemInObject(cJSON *object, const char *string, cJSON *newitem)\n2403\t{\n2404\t    return replace_item_in_object(object, string, newitem, false);\n2405\t}\n2406\t\n2407\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemInObjectCaseSensitive(cJSON *object, const char *string, cJSON *newitem)\n2408\t{\n2409\t    return replace_item_in_object(object, string, newitem, true);\n2410\t}\n2411\t\n2412\t/* Create basic types: */\n2413\tCJSON_PUBLIC(cJSON *) cJSON_CreateNull(void)\n2414\t{\n2415\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2416\t    if(item)\n2417\t    {\n2418\t        item->type = cJSON_NULL;\n2419\t    }\n2420\t\n2421\t    return item;\n2422\t}\n2423\t\n2424\tCJSON_PUBLIC(cJSON *) cJSON_CreateTrue(void)\n2425\t{\n2426\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2427\t    if(item)\n2428\t    {\n2429\t        item->type = cJSON_True;\n2430\t    }\n2431\t\n2432\t    return item;\n2433\t}\n2434\t\n2435\tCJSON_PUBLIC(cJSON *) cJSON_CreateFalse(void)\n2436\t{\n2437\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2438\t    if(item)\n2439\t    {\n2440\t        item->type = cJSON_False;\n2441\t    }\n2442\t\n2443\t    return item;\n2444\t}\n2445\t\n2446\tCJSON_PUBLIC(cJSON *) cJSON_CreateBool(cJSON_bool boolean)\n2447\t{\n2448\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2449\t    if(item)\n2450\t    {\n2451\t        item->type = boolean ? cJSON_True : cJSON_False;\n2452\t    }\n2453\t\n2454\t    return item;\n2455\t}\n2456\t\n2457\tCJSON_PUBLIC(cJSON *) cJSON_CreateNumber(double num)\n2458\t{\n2459\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2460\t    if(item)\n2461\t    {\n2462\t        item->type = cJSON_Number;\n2463\t        item->valuedouble = num;\n2464\t\n2465\t        /* use saturation in case of overflow */\n2466\t        if (num >= INT_MAX)\n2467\t        {\n2468\t            item->valueint = INT_MAX;\n2469\t        }\n2470\t        else if (num <= (double)INT_MIN)\n2471\t        {\n2472\t            item->valueint = INT_MIN;\n2473\t        }\n2474\t        else\n2475\t        {\n2476\t            item->valueint = (int)num;\n2477\t        }\n2478\t    }\n2479\t\n2480\t    return item;\n2481\t}\n2482\t\n2483\tCJSON_PUBLIC(cJSON *) cJSON_CreateString(const char *string)\n2484\t{\n2485\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2486\t    if(item)\n2487\t    {\n2488\t        item->type = cJSON_String;\n2489\t        item->valuestring = (char*)cJSON_strdup((const unsigned char*)string, &global_hooks);\n2490\t        if(!item->valuestring)\n2491\t        {\n2492\t            cJSON_Delete(item);\n2493\t            return NULL;\n2494\t        }\n2495\t    }\n2496\t\n2497\t    return item;\n2498\t}\n2499\t\n2500\tCJSON_PUBLIC(cJSON *) cJSON_CreateStringReference(const char *string)\n2501\t{\n2502\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2503\t    if (item != NULL)\n2504\t    {\n2505\t        item->type = cJSON_String | cJSON_IsReference;\n2506\t        item->valuestring = (char*)cast_away_const(string);\n2507\t    }\n2508\t\n2509\t    return item;\n2510\t}\n2511\t\n2512\tCJSON_PUBLIC(cJSON *) cJSON_CreateObjectReference(const cJSON *child)\n2513\t{\n2514\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2515\t    if (item != NULL) {\n2516\t        item->type = cJSON_Object | cJSON_IsReference;\n2517\t        item->child = (cJSON*)cast_away_const(child);\n2518\t    }\n2519\t\n2520\t    return item;\n2521\t}\n2522\t\n2523\tCJSON_PUBLIC(cJSON *) cJSON_CreateArrayReference(const cJSON *child) {\n2524\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2525\t    if (item != NULL) {\n2526\t        item->type = cJSON_Array | cJSON_IsReference;\n2527\t        item->child = (cJSON*)cast_away_const(child);\n2528\t    }\n2529\t\n2530\t    return item;\n2531\t}\n2532\t\n2533\tCJSON_PUBLIC(cJSON *) cJSON_CreateRaw(const char *raw)\n2534\t{\n2535\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2536\t    if(item)\n2537\t    {\n2538\t        item->type = cJSON_Raw;\n2539\t        item->valuestring = (char*)cJSON_strdup((const unsigned char*)raw, &global_hooks);\n2540\t        if(!item->valuestring)\n2541\t        {\n2542\t            cJSON_Delete(item);\n2543\t            return NULL;\n2544\t        }\n2545\t    }\n2546\t\n2547\t    return item;\n2548\t}\n2549\t\n2550\tCJSON_PUBLIC(cJSON *) cJSON_CreateArray(void)\n2551\t{\n2552\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2553\t    if(item)\n2554\t    {\n2555\t        item->type=cJSON_Array;\n2556\t    }\n2557\t\n2558\t    return item;\n2559\t}\n2560\t\n2561\tCJSON_PUBLIC(cJSON *) cJSON_CreateObject(void)\n2562\t{\n2563\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2564\t    if (item)\n2565\t    {\n2566\t        item->type = cJSON_Object;\n2567\t    }\n2568\t\n2569\t    return item;\n2570\t}\n2571\t\n2572\t/* Create Arrays: */\n2573\tCJSON_PUBLIC(cJSON *) cJSON_CreateIntArray(const int *numbers, int count)\n2574\t{\n2575\t    size_t i = 0;\n2576\t    cJSON *n = NULL;\n2577\t    cJSON *p = NULL;\n2578\t    cJSON *a = NULL;\n2579\t\n2580\t    if ((count < 0) || (numbers == NULL))\n2581\t    {\n2582\t        return NULL;\n2583\t    }\n2584\t\n2585\t    a = cJSON_CreateArray();\n2586\t\n2587\t    for(i = 0; a && (i < (size_t)count); i++)\n2588\t    {\n2589\t        n = cJSON_CreateNumber(numbers[i]);\n2590\t        if (!n)\n2591\t        {\n2592\t            cJSON_Delete(a);\n2593\t            return NULL;\n2594\t        }\n2595\t        if(!i)\n2596\t        {\n2597\t            a->child = n;\n2598\t        }\n2599\t        else\n2600\t        {\n2601\t            suffix_object(p, n);\n2602\t        }\n2603\t        p = n;\n2604\t    }\n2605\t\n2606\t    if (a && a->child) {\n2607\t        a->child->prev = n;\n2608\t    }\n2609\t\n2610\t    return a;\n2611\t}\n2612\t\n2613\tCJSON_PUBLIC(cJSON *) cJSON_CreateFloatArray(const float *numbers, int count)\n2614\t{\n2615\t    size_t i = 0;\n2616\t    cJSON *n = NULL;\n2617\t    cJSON *p = NULL;\n2618\t    cJSON *a = NULL;\n2619\t\n2620\t    if ((count < 0) || (numbers == NULL))\n2621\t    {\n2622\t        return NULL;\n2623\t    }\n2624\t\n2625\t    a = cJSON_CreateArray();\n2626\t\n2627\t    for(i = 0; a && (i < (size_t)count); i++)\n2628\t    {\n2629\t        n = cJSON_CreateNumber((double)numbers[i]);\n2630\t        if(!n)\n2631\t        {\n2632\t            cJSON_Delete(a);\n2633\t            return NULL;\n2634\t        }\n2635\t        if(!i)\n2636\t        {\n2637\t            a