alse\n56\t#endif\n57\t#define false ((cJSON_bool)0)\n58\t\n59\t/* define isnan and isinf for ANSI C, if in C99 or above, isnan and isinf has been defined in math.h */\n60\t#ifndef isinf\n61\t#define isinf(d) (isnan((d - d)) && !isnan(d))\n62\t#endif\n63\t#ifndef isnan\n64\t#define isnan(d) (d != d)\n65\t#endif\n66\t\n67\t#ifndef NAN\n68\t#define NAN 0.0/0.0\n69\t#endif\n70\t\n71\ttypedef struct {\n72\t    const unsigned char *json;\n73\t    size_t position;\n74\t} error;\n75\tstatic error global_error = { NULL, 0 };\n76\t\n77\tCJSON_PUBLIC(const char *) cJSON_GetErrorPtr(void)\n78\t{\n79\t    return (const char*) (global_error.json + global_error.position);\n80\t}\n81\t\n82\tCJSON_PUBLIC(char *) cJSON_GetStringValue(const cJSON * const item)\n83\t{\n84\t    if (!cJSON_IsString(item))\n85\t    {\n86\t        return NULL;\n87\t    }\n88\t\n89\t    return item->valuestring;\n90\t}\n91\t\n92\tCJSON_PUBLIC(double) cJSON_GetNumberValue(const cJSON * const item)\n93\t{\n94\t    if (!cJSON_IsNumber(item))\n95\t    {\n96\t        return (double) NAN;\n97\t    }\n98\t\n99\t    return item->valuedouble;\n100\t}\n101\t\n102\t/* This is a safeguard to prevent copy-pasters from using incompatible C and header files */\n103\t#if (CJSON_VERSION_MAJOR != 1) || (CJSON_VERSION_MINOR != 7) || (CJSON_VERSION_PATCH != 19)\n104\t    #error cJSON.h and cJSON.c have different versions. Make sure that both have the same.\n105\t#endif\n106\t\n107\tCJSON_PUBLIC(const char*) cJSON_Version(void)\n108\t{\n109\t    static char version[15];\n110\t    sprintf(version, \"%i.%i.%i\", CJSON_VERSION_MAJOR, CJSON_VERSION_MINOR, CJSON_VERSION_PATCH);\n111\t\n112\t    return version;\n113\t}\n114\t\n115\t/* Case insensitive string comparison, doesn't consider two NULL pointers equal though */\n116\tstatic int case_insensitive_strcmp(const unsigned char *string1, const unsigned char *string2)\n117\t{\n118\t    if ((string1 == NULL) || (string2 == NULL))\n119\t    {\n120\t        return 1;\n121\t    }\n122\t\n123\t    if (string1 == string2)\n124\t    {\n125\t        return 0;\n126\t    }\n127\t\n128\t    for(; tolower(*string1) == tolower(*string2); (void)string1++, string2++)\n129\t    {\n130\t        if (*string1 == '\\0')\n131\t        {\n132\t            return 0;\n133\t        }\n134\t    }\n135\t\n136\t    return tolower(*string1) - tolower(*string2);\n137\t}\n138\t\n139\ttypedef struct internal_hooks\n140\t{\n141\t    void *(CJSON_CDECL *allocate)(size_t size);\n142\t    void (CJSON_CDECL *deallocate)(void *pointer);\n143\t    void *(CJSON_CDECL *reallocate)(void *pointer, size_t size);\n144\t} internal_hooks;\n145\t\n146\t#define internal_malloc malloc\n147\t#define internal_free free\n148\t#define internal_realloc realloc\n149\t\n150\t/* strlen of character literals resolved at compile time */\n151\t#define static_strlen(string_literal) (sizeof(string_literal) - sizeof(\"\"))\n152\t\n153\tstatic internal_hooks global_hooks = { internal_malloc, internal_free, internal_realloc };\n154\t\n155\tstatic unsigned char* cJSON_strdup(const unsigned char* string, const internal_hooks * const hooks)\n156\t{\n157\t    size_t length = 0;\n158\t    unsigned char *copy = NULL;\n159\t\n160\t    if (string == NULL)\n161\t    {\n162\t        return NULL;\n163\t    }\n164\t\n165\t    length = strlen((const char*)string) + sizeof(\"\");\n166\t    copy = (unsigned char*)hooks->allocate(length);\n167\t    if (copy == NULL)\n168\t    {\n169\t        return NULL;\n170\t    }\n171\t    memcpy(copy, string, length);\n172\t\n173\t    return copy;\n174\t}\n175\t\n176\tCJSON_PUBLIC(void) cJSON_InitHooks(cJSON_Hooks* hooks)\n177\t{\n178\t    if (hooks == NULL)\n179\t    {\n180\t        /* Reset hooks */\n181\t        global_hooks.allocate = malloc;\n182\t        global_hooks.deallocate = free;\n183\t        global_hooks.reallocate = realloc;\n184\t        return;\n185\t    }\n186\t\n187\t    global_hooks.allocate = malloc;\n188\t    if (hooks->malloc_fn != NULL)\n189\t    {\n190\t        