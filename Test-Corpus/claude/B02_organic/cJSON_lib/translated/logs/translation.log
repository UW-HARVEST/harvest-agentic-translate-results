58\t        item->valueint = INT_MAX;\n359\t    }\n360\t    else if (number <= (double)INT_MIN)\n361\t    {\n362\t        item->valueint = INT_MIN;\n363\t    }\n364\t    else\n365\t    {\n366\t        item->valueint = (int)number;\n367\t    }\n368\t\n369\t    item->type = cJSON_Number;\n370\t\n371\t    input_buffer->offset += (size_t)(after_end - number_c_string);\n372\t    /* free the temporary buffer */\n373\t    input_buffer->hooks.deallocate(number_c_string);\n374\t    return true;\n375\t}\n376\t\n377\t/* don't ask me, but the original cJSON_SetNumberValue returns an integer or double */\n378\tCJSON_PUBLIC(double) cJSON_SetNumberHelper(cJSON *object, double number)\n379\t{\n380\t    if (number >= INT_MAX)\n381\t    {\n382\t        object->valueint = INT_MAX;\n383\t    }\n384\t    else if (number <= (double)INT_MIN)\n385\t    {\n386\t        object->valueint = INT_MIN;\n387\t    }\n388\t    else\n389\t    {\n390\t        object->valueint = (int)number;\n391\t    }\n392\t\n393\t    return object->valuedouble = number;\n394\t}\n395\t\n396\t/* Note: when passing a NULL valuestring, cJSON_SetValuestring treats this as an error and return NULL */\n397\tCJSON_PUBLIC(char*) cJSON_SetValuestring(cJSON *object, const char *valuestring)\n398\t{\n399\t    char *copy = NULL;\n400\t    size_t v1_len;\n401\t    size_t v2_len;\n402\t    /* if object's type is not cJSON_String or is cJSON_IsReference, it should not set valuestring */\n403\t    if ((object == NULL) || !(object->type & cJSON_String) || (object->type & cJSON_IsReference))\n404\t    {\n405\t        return NULL;\n406\t    }\n407\t    /* return NULL if the object is corrupted or valuestring is NULL */\n408\t    if (object->valuestring == NULL || valuestring == NULL)\n409\t    {\n410\t        return NULL;\n411\t    }\n412\t\n413\t    v1_len = strlen(valuestring);\n414\t    v2_len = strlen(object->valuestring);\n415\t\n416\t    if (v1_len <= v2_len)\n417\t    {\n418\t        /* strcpy does not handle overlapping string: