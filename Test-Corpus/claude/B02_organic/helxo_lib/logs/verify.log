ite_all(key);\n        let _ = out.write_all(b\" \");\n        // %c writes the single byte of the int promoted argument.\n        let byte = (*value as u32 & 0xff) as u8;\n        let _ = out.write_all(&[byte]);\n        let _ = out.write_all(b\"\\n\");\n    }\n    let _ = out.flush();\n}\n","numLines":45,"startLine":1,"totalLines":45}}}
