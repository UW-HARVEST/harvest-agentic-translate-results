s first element is reserved (hence length-1\n            // user entries).\n            let header = header_of(hash);\n            let length = (*header).length; // total underlying length\n            let entries = hash as *mut Entry;\n            let mut result = Vec::new();\n            for i in 0..(length - 1) {\n                let e = *entries.add(i);\n                let key_bytes = std::ffi::CStr::from_ptr(e.key).to_bytes().to_vec();\n                result.push((key_bytes, e.value));\n            }\n            free(hash, elemsize);\n            result\n        }\n    }"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1034,"cache_read_input_tokens":67681,"cache_creation":{"ephemeral_5m_input_tokens":1034,"ephemeral_1h_input_tokens":0},"output_tokens":30,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"38664bbb-1e43-44c7-88fb-d73ddec54d90","uuid":"7a6e6034-cdc7-44a5-b4a0-0950407b77b7"}
