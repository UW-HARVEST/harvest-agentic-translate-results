{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LMWBjbAagELYh4XDn3s5F2","type":"tool_result","content":"1\t// By Jan Wrobel <wrr@mixedbit.org>\n2\t\n3\t#include <stdio.h>\n4\t#include <stdlib.h>\n5\t#include <string.h>\n6\t\n7\t#define LUGGAGE_ID_LENGTH 8\n8\t#define FLIGHT_ID_LENGTH 6\n9\t#define AIRPORT_CODE_LENGTH 3\n10\t#define COMMENTS_LENGTH 80\n11\t\n12\ttypedef struct RoutingDirective {\n13\t\tunsigned int time_stamp;\n14\t\tchar luggage_id[LUGGAGE_ID_LENGTH + 1];\n15\t\tchar flight_id[FLIGHT_ID_LENGTH + 1];\n16\t\tchar departure[AIRPORT_CODE_LENGTH + 1];\n17\t\tchar arrival[AIRPORT_CODE_LENGTH + 1];\n18\t\tchar comments[COMMENTS_LENGTH + 1];\n19\t\tstruct RoutingDirective *next_directive;\n20\t} RoutingDirective;\n21\t\n22\tvoid addRoutingDirectiveToList(RoutingDirective *previous_directive,\n23\t\t\t\t       RoutingDirective *new_directive) {\n24\t\tRoutingDirective *next_directive = previous_directive->next_directive;\n25\t\tif (next_directive == NULL ||\n26\t\t    next_directive->time_stamp > new_directive->time_stamp) {\n27\t\t\tnew_directive->next_directive = next_directive;\n28\t\t\tprevious_directive->next_directive = new_directive;\n29\t\t} else {\n30\t\t\taddRoutingDirectiveToList(next_directive, new_directive);\n31\t\t}\n32\t}\n33\t\n34\tint supersedes(RoutingDirective *directive, char *luggage_id, char *departure) {\n35\t\tif (directive == NULL) {\n36\t\t\treturn 0;\n37\t\t}\n38\t\tif (strcmp(directive->luggage_id, luggage_id) != 0) {\n39\t\t\treturn supersedes(directive->next_directive,\n40\t\t\t\t\t  luggage_id,\n41\t\t\t\t\t  departure);\n42\t\t}\n43\t\tif (strcmp(directive->departure, departure) == 0) {\n44\t\t\treturn 1;\n45\t\t}\n46\t\treturn 0;\n47\t}\n48\t\n49\tint superseded(RoutingDirective *directive) {\n50\t\treturn supersedes(directive->next_directive,\n51\t\t\t\t  directive->luggage_id,\n52\t\t\t\t  directive->departure);\n53\t}\n54\t\n55\t\n56\tint matches(char* expected, char* actual) {\n57\t\tretur