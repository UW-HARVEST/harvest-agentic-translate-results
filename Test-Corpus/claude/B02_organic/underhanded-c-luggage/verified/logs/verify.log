   }\n66\t        if self.pos == digits_start {\n67\t            // no digits matched; rewind sign and report no match\n68\t            self.pos = start;\n69\t            return ScanRes::NoMatch;\n70\t        }\n71\t        let s = std::str::from_utf8(&self.data[digits_start..self.pos]).unwrap_or(\"0\");\n72\t        let mut val: i64 = s.parse().unwrap_or(0);\n73\t        if neg {\n74\t            val = val.wrapping_neg();\n75\t        }\n76\t        ScanRes::Ok(val)\n77\t    }\n78\t\n79\t    /// Equivalent to scanf(\"%N[set]\") - does NOT skip leading whitespace.\n80\t    fn scan_set<F: Fn(u8) -> bool>(&mut self, max_len: usize, allowed: F) -> ScanRes<String> {\n81\t        if self.at_eof() {\n82\t            return ScanRes::Eof;\n83\t        }\n84\t        let start = self.pos;\n85\t        let mut count = 0usize;\n86\t        while !self.at_eof() && count < max_len && allowed(self.data[self.pos]) {\n87\t            self.pos += 1;\n88\t            count += 1;\n89\t        }\n90\t        if self.pos == start {\n91\t            return ScanRes::NoMatch;\n92\t        }\n93\t        let s = String::from_utf8_lossy(&self.data[start..self.pos]).into_owned();\n94\t        ScanRes::Ok(s)\n95\t    }\n96\t}\n97\t\n98\tfn is_alpha_upper_or_digit(b: u8) -> bool {\n99\t    (b >= b'A' && b <= b'Z') || (b >= b'0' && b <= b'9')\n100\t}\n101\t\n102\tfn is_alpha_upper(b: u8) -> bool {\n103\t    b >= b'A' && b <= b'Z'\n104\t}\n105\t\n106\tfn is_not_newline(b: u8) -> bool {\n107\t    b != b'\\n'\n108\t}\n109\t\n110\tfn matches_field(expected: &str, actual: &str) -> bool {\n111\t    // Mirrors C: expected[0] == '-' || strcmp(expected, actual) == 0\n112\t    if let Some(&first) = expected.as_bytes().first() {\n113\t        if first == b'-' {\n114\t            return true;\n115\t        }\n116\t    }\n117\t    expected == actual\n118\t}\n119\t\n120\t/// Mirrors C's `supersedes` recursion: find the FIRST later directive with\n121\t/// matching luggage_id; if its departure also matches, re