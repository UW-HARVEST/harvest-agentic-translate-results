n (expected[0] == '-' || strcmp(expected, actual) == 0);\n58\t}\n59\t\n60\tvoid printMatchingDirectives(RoutingDirective* first_directive,\n61\t\t\t\t     char *expected_luggage_id,\n62\t\t\t\t     char *expected_flight_id,\n63\t\t\t\t     char *expected_departure,\n64\t\t\t\t     char *expected_arrival) {\n65\t\tRoutingDirective *directive;\n66\t\tfor (directive = first_directive; directive != NULL;\n67\t\t     directive = directive->next_directive) {\n68\t\t\tif (!superseded(directive) &&\n69\t\t\t    matches(expected_luggage_id, directive->luggage_id) &&\n70\t\t\t    matches(expected_flight_id, directive->flight_id) &&\n71\t\t\t    matches(expected_departure, directive->departure) &&\n72\t\t\t    matches(expected_arrival, directive->arrival)) {\n73\t                        printf(\"%010u %s %s %s %s %s\\n\",\n74\t\t\t\t       directive->time_stamp,\n75\t\t\t\t       directive->luggage_id,\n76\t\t\t\t       directive->flight_id,\n77\t\t\t\t       directive->departure,\n78\t\t\t\t       directive->arrival,\n79\t\t\t\t       directive->comments);\n80\t\t\t}\n81\t\t}\n82\t}\n83\t\n84\tint main(int argc, char *argv[]) {\n85\t        if (argc != 5) {\n86\t                fprintf(stderr, \"Command line error: 4 arguments expected\\n\");\n87\t                exit(1);\n88\t        }\n89\t\tRoutingDirective directive_list_head;\n90\t\tdirective_list_head.time_stamp = 0;\n91\t\tdirective_list_head.next_directive = NULL;\n92\t\n93\t\twhile (1) {\n94\t\t\tunsigned int time_stamp;\n95\t\t\tchar luggage_id[LUGGAGE_ID_LENGTH + 1];\n96\t\t\tchar flight_id[FLIGHT_ID_LENGTH + 1];\n97\t\t\tchar departure[AIRPORT_CODE_LENGTH + 1];\n98\t\t\tchar arrival[AIRPORT_CODE_LENGTH + 1];\n99\t\t\tchar comments[COMMENTS_LENGTH + 1];\n100\t\t\tcomments[0] = 0; // comments are optional.\n101\t\n102\t\t\tif (scanf(\"%d \", &time_stamp) == EOF) {\n103\t\t\t\tbreak;\n104\t\t\t}\n105\t\t\tif (scanf(\"%8[A-Z0-9] %6[A-Z0-9] \",\n106\t\t\t\t  luggage_id, flight_id) == EOF) {\n107\t\t\t\tbreak;\n108\t\t\