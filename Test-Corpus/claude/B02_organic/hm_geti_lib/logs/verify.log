t\",\n            manifest_dir\n        );\n        println!(\"cargo:rustc-link-arg=-Wl,--export-dynamic\");\n        // `--undefined=_init` / `=_fini` ensures the linker keeps the\n        // symbols even if the version script tries to localize them.\n        println!(\"cargo:rustc-link-arg=-Wl,--undefined=_init\");\n        println!(\"cargo:rustc-link-arg=-Wl,--undefined=_fini\");\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":353,"cache_read_input_tokens":60593,"cache_creation":{"ephemeral_5m_input_tokens":353,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8fa2b476-2198-4c70-95af-708e3b870d4c","uuid":"ccf77286-54f9-4c74-a101-7458629eb34c"}
