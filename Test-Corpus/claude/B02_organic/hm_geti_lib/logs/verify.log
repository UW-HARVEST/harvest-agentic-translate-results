a linker argument to preserve byte-for-byte parity in `nm -D`.\nfn main() {\n    if cfg!(target_os = \"linux\") {\n        println!(\"cargo:rustc-link-arg=-Wl,--export-dynamic-symbol=_init\");\n        println!(\"cargo:rustc-link-arg=-Wl,--export-dynamic-symbol=_fini\");\n    }\n}\n","structuredPatch":[{"oldStart":8,"oldLines":7,"newStart":8,"newLines":17,"lines":[" // via a linker argument to preserve byte-for-byte parity in `nm -D`."," fn main() {","     if cfg!(target_os = \"linux\") {","-        println!(\"cargo:rustc-link-arg=-Wl,--export-dynamic-symbol=_init\");","-        println!(\"cargo:rustc-link-arg=-Wl,--export-dynamic-symbol=_fini\");","+        // Pull `_init` and `_fini` (generated by crti.o / crtn.o) into the","+        // dynamic symbol table. Older binutils don't accept","+        // `--export-dynamic-symbol=NAME`, so we use `--dynamic-list` with a","+        // small list file and `--export-dynamic` to ensure listed symbols","+        // appear in the dynamic table even when otherwise hidden by the","+        // rustc-supplied version script.","+        let manifest_dir = std::env::var(\"CARGO_MANIFEST_DIR\").unwrap();","+        println!(","+            \"cargo:rustc-link-arg=-Wl,--dynamic-list={}/dynamic_list.txt\",","+            manifest_dir","+        );","+        println!(\"cargo:rustc-link-arg=-Wl,--export-dynamic\");","     }"," }"]}],"userModified":false,"replaceAll":false}}
