repr(C)]\n#[derive(Copy, Clone, Default)]\nstruct c2Simplex {\n    a: c2sv,\n    b: c2sv,\n    c: c2sv,\n    d: c2sv,\n    div: f32,\n    count: c_int,\n}\n\nimpl c2Simplex {\n    fn get(&self, i: usize) -> c2sv {\n        match i {\n            0 => self.a,\n            1 => self.b,\n            2 => self.c,\n            3 => self.d,\n            _ => panic!(\"c2Simplex index out of bounds\"),\n        }\n    }\n    fn set(&mut self, i: usize, v: c2sv) {\n        match i {\n            0 => self.a = v,\n            1 => self.b = v,\n            2 => self.c = v,\n            3 => self.d = v,\n            _ => panic!(\"c2Simplex index out of bounds\"),\n        }\n    }\n}\n\n#[no_mangle]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    c2Dot(a, a).sqrt()\n}\n\n#[no_mangle]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    a.x * b.y - a.y * b.x\n}\n\n#[no_mangle]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    let s = &*s;\n    match s.count {\n        2 => c2Len(c2Sub(s.b.p, s.a.p)),\n        3 => c2Det2(c2Sub(s.b.p, s.a.p), c2Sub(s.c.p, s.a.p)),\n        _ => 0.0,\n    }\n}\n\n#[no_mangle]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n}\n\n#[no_mangle]\npub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[no_mangle]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n#[no_mangle]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    let s = &mut *s;\n    let a = s.a.p;\n    let b = s.b.p;\n    let u = c2Dot(b, c2Sub(b, a));\n    let v = c2Dot(a, c2Sub(a, b));\n    if v <= 0.0 {\n        s.a.u = 1.0;\n        s.div = 1.0;\n        s.count = 1;\n    } else if u <= 0.0 {\n        s.a = s.b;\n        s.a.u = 1.0;\n        s.div = 1.0;\n        s.count = 1;\n    } else {\n        s.a.u = u;\n        s.b.u = v;\n        s.div = u + v;\n        s.count = 2;\n    }\n}\n\n#[no_