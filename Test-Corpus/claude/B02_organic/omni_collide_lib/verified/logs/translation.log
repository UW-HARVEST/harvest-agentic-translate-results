}};\n    c2Capsule cap={{rfs(),rfs()},{rfs(),rfs()},rfs()}, cap2={{rfs(),rfs()},{rfs(),rfs()},rfs()};\n    c2x ax={{rfs(),rfs()},{rfs(),rfs()}}, bx={{rfs(),rfs()},{rfs(),rfs()}};\n    int use_ax=rnd()&1, use_bx=rnd()&1, ur=rnd()&1;\n    for(int ta=0;ta<3;ta++)for(int tb=0;tb<3;tb++){\n      const void*A= ta==(int)C2_TYPE_CIRCLE?(void*)&ci: ta==(int)C2_TYPE_AABB?(void*)&bb:(void*)&cap;\n      const void*B= tb==(int)C2_TYPE_CIRCLE?(void*)&ci2: tb==(int)C2_TYPE_AABB?(void*)&bb2:(void*)&cap2;\n      /* no cache */\n      { c2v a0,b0,a1,b1; int i0=0,i1=0;\n        float d0=g0(A,ta,use_ax?&ax:0,B,tb,use_bx?&bx:0,&a0,&b0,ur,&i0,0);\n        float d1=g1(A,ta,use_ax?&ax:0,B,tb,use_bx?&bx:0,&a1,&b1,ur,&i1,0);\n        n_nocache++;\n        if(memcmp(&d0,&d1,4)||memcmp(&a0,&a1,8)||memcmp(&b0,&b1,8)||i0!=i1){ f_nocache++;\n          if(shown++<5) fprintf(stderr,\"NOCACHE ta=%d tb=%d d %g/%g it %d/%d\\n\",ta,tb,d0,d1,i0,i1); } }\n      /* valid cache: indices within proxy vertex counts */\n      { c2v a0,b0,a1,b1; int i0=0,i1=0; c2GJKCache k0,k1; memset(&k0,0,sizeof k0);\n        k0.count=(int)(rnd()%4);\n        for(int i=0;i<3;i++){ k0.iA[i]=rnd()%vcount(ta); k0.iB[i]=rnd()%vcount(tb); }\n        k0.div=rfs(); k0.metric=rfs(); k1=k0;\n        float d0=g0(A,ta,use_ax?&ax:0,B,tb,use_bx?&bx:0,&a0,&b0,ur,&i0,&k0);\n        float d1=g1(A,ta,use_ax?&ax:0,B,tb,use_bx?&bx:0,&a1,&b1,ur,&i1,&k1);\n        n_validcache++;\n        if(memcmp(&d0,&d1,4)||memcmp(&a0,&a1,8)||memcmp(&b0,&b1,8)||i0!=i1||memcmp(&k0,&k1,sizeof k0)){ f_validcache++;\n          if(shown<12){ shown++; fprintf(stderr,\"CACHE ta=%d tb=%d cnt=%d d %g/%g it %d/%d k.count %d/%d k.metric %g/%g k.div %g/%g\\n\",\n             ta,tb,k1.count,d0,d1,i0,i1,k0.count,k1.count,k0.metric,k1.metric,k0.div,k1.div); } } }\n    }\n  }\n  printf(\"nocache: %ld/%ld  validcache: %ld/%ld\\n\", f_nocache,n_nocache,f_validcache,n_validcache);\n  return 0; }\nEOF\ngcc -O1 -o $TMPDIR/cbuild/gjk_probe $TMPDIR/cbuild/gjk_probe.c -ldl -lm && $T