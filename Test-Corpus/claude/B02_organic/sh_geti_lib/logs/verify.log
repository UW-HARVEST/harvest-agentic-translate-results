omRawFd};\n\n    // Flush libc stdout before redirect.\n    unsafe extern \"C\" {\n        fn fflush(stream: *mut libc::FILE) -> libc::c_int;\n    }\n    unsafe {\n        fflush(core::ptr::null_mut());\n    }\n\n    let saved_stdout = unsafe { libc::dup(libc::STDOUT_FILENO) };\n    assert!(saved_stdout >= 0, \"dup stdout failed\");\n\n    let tmp = tempfile_in(\"/tmp\", \"test-stdout\");\n    let tmp_fd = tmp.as_raw_fd();\n    let dup_ret = unsafe { libc::dup2(tmp_fd, libc::STDOUT_FILENO) };\n    assert!(dup_ret >= 0, \"dup2 to tmp failed\");\n\n    f();\n\n    unsafe {\n        fflush(core::ptr::null_mut());\n    }\n    unsafe {\n        libc::dup2(saved_stdout, libc::STDOUT_FILENO);\n        libc::close(saved_stdout);\n    }\n\n    use std::io::{Read, Seek, SeekFrom};\n    let mut tmp = tmp;\n    tmp.seek(SeekFrom::Start(0)).expect(\"seek tmp\");\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).expect(\"read tmp\");\n    let _ = unsafe { std::fs::File::from_raw_fd(tmp_fd) };\n    buf\n}\n\nfn tempfile_in(dir: &str, prefix: &str) -> std::fs::File {\n    use std::os::unix::ffi::OsStrExt;\n    let mut path = std::ffi::OsString::from(dir);\n    path.push(\"/\");\n    path.push(prefix);\n    path.push(\"-XXXXXX\");\n    let mut bytes = path.as_bytes().to_vec();\n    bytes.push(0);\n    let fd = unsafe { libc::mkstemp(bytes.as_mut_ptr() as *mut i8) };\n    assert!(fd >= 0, \"mkstemp failed\");\n    // Unlink so file is removed on close.\n    unsafe {\n        libc::unlink(bytes.as_ptr() as *const i8);\n    }\n    use std::os::unix::io::FromRawFd;\n    unsafe { std::fs::File::from_raw_fd(fd) }\n}\n","userModified":false}}
