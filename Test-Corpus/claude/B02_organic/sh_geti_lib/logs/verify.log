yoffset,\n            STBDS_HM_STRING,\n        ) as *mut ShEntry;\n        *t = new_t;\n        if !new_t.is_null() {\n            let raw = hash_to_arr(new_t as *mut c_void, elemsize);\n            (*header(raw)).temp\n        } else {\n            0\n        }\n    }\n}\n\n#[inline(always)]\nunsafe fn shlen(t: *mut ShEntry) -> isize {\n    unsafe {\n        if t.is_null() {\n            0\n        } else {\n            let elemsize = core::mem::size_of::<ShEntry>();\n            let raw = hash_to_arr(t as *mut c_void, elemsize);\n            (*header(raw)).length as isize - 1\n        }\n    }\n}\n\n#[inline(always)]\nunsafe fn shfree(t: &mut *mut ShEntry) {\n    unsafe {\n        if !(*t).is_null() {\n            let elemsize = core::mem::size_of::<ShEntry>();\n            let raw = hash_to_arr(*t as *mut c_void, elemsize);\n            stbds_hmfree_func(raw, elemsize);\n        }\n        *t = ptr::null_mut();\n    }\n}\n","structuredPatch":[{"oldStart":1077,"oldLines":8,"newStart":1077,"newLines":9,"lines":[" pub unsafe extern \"C\" fn strkey(n: c_int) -> *mut c_char {","     unsafe {","         let fmt = b\"test_%d\\0\";","-        sprintf(STRKEY_BUFFER.as_mut_ptr(), fmt.as_ptr() as *const c_char, n);","-        STRKEY_BUFFER.as_mut_ptr()","+        let p = &raw mut STRKEY_BUFFER as *mut c_char;","+        sprintf(p, fmt.as_ptr() as *const c_char, n);","+        p","     }"," }"," "]}],"userModified":false,"replaceAll":false}}
