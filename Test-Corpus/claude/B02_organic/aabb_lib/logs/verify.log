nt,\n    verts: [c2v; 8],\n}\n\nimpl Default for c2Proxy {\n    fn default() -> Self {\n        c2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [c2v::default(); 8],\n        }\n    }\n}\n\nfn c2BBVerts(out: &mut [c2v], bb: &c2AABB) {\n    out[0] = bb.min;\n    out[1] = c2V(bb.max.x, bb.min.y);\n    out[2] = bb.max;\n    out[3] = c2V(bb.min.x, bb.max.y);\n}\n\nunsafe fn c2MakeProxy(shape: *const c_void, ty: C2_TYPE, p: &mut c2Proxy) {\n    match ty {\n        C2_TYPE::C2_TYPE_CIRCLE => {\n            let c = &*(shape as *const c2Circle);\n            p.radius = c.r;\n            p.count = 1;\n            p.verts[0] = c.p;\n        }\n        C2_TYPE::C2_TYPE_AABB => {\n            let bb = &*(shape as *const c2AABB);\n            p.radius = 0.0;\n            p.count = 4;\n            c2BBVerts(&mut p.verts, bb);\n        }\n        C2_TYPE::C2_TYPE_CAPSULE => {\n            let c = &*(shape as *const c2Capsule);\n            p.radius = c.r;\n            p.count = 2;\n            p.verts[0] = c.a;\n            p.verts[1] = c.b;\n        }\n    }\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\nstruct c2sv {\n    sA: c2v,\n    sB: c2v,\n    p: c2v,\n    u: f32,\n    iA: c_int,\n    iB: c_int,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\nstruct c2Simplex {\n    a: c2sv,\n    b: c2sv,\n    c: c2sv,\n    d: c2sv,\n    div: f32,\n    count: c_int,\n}\n\n#[inline]\nfn c2Len(a: c2v) -> f32 {\n    c2Dot(a, a).sqrt()\n}\n\n#[inline]\nfn c2Det2(a: c2v, b: c2v) -> f32 {\n    a.x * b.y - a.y * b.x\n}\n\nfn c2GJKSimplexMetric(s: &c2Simplex) -> f32 {\n    match s.count {\n        2 => c2Len(c2Sub(s.b.p, s.a.p)),\n        3 => c2Det2(c2Sub(s.b.p, s.a.p), c2Sub(s.c.p, s.a.p)),\n        _ => 0.0,\n    }\n}\n\n#[inline]\nfn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n}\n\n#[inline]\nfn c2Add(mut a: c2v, b: c2v) -> c2v {\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[inline]\nfn c2Mulxv(a: c2x, b: c2v)