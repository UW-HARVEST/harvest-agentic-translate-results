 c2Dot(a, c2Sub(a, b));\n261\t    let uBC = c2Dot(c, c2Sub(c, b));\n262\t    let vBC = c2Dot(b, c2Sub(b, c));\n263\t    let uCA = c2Dot(a, c2Sub(a, c));\n264\t    let vCA = c2Dot(c, c2Sub(c, a));\n265\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n266\t    let uABC = c2Det2(b, c) * area;\n267\t    let vABC = c2Det2(c, a) * area;\n268\t    let wABC = c2Det2(a, b) * area;\n269\t    if vAB <= 0.0 && uCA <= 0.0 {\n270\t        s.a.u = 1.0;\n271\t        s.div = 1.0;\n272\t        s.count = 1;\n273\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n274\t        s.a = s.b;\n275\t        s.a.u = 1.0;\n276\t        s.div = 1.0;\n277\t        s.count = 1;\n278\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n279\t        s.a = s.c;\n280\t        s.a.u = 1.0;\n281\t        s.div = 1.0;\n282\t        s.count = 1;\n283\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n284\t        s.a.u = uAB;\n285\t        s.b.u = vAB;\n286\t        s.div = uAB + vAB;\n287\t        s.count = 2;\n288\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n289\t        s.a = s.b;\n290\t        s.b = s.c;\n291\t        s.a.u = uBC;\n292\t        s.b.u = vBC;\n293\t        s.div = uBC + vBC;\n294\t        s.count = 2;\n295\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n296\t        s.b = s.a;\n297\t        s.a = s.c;\n298\t        s.a.u = uCA;\n299\t        s.b.u = vCA;\n300\t        s.div = uCA + vCA;\n301\t        s.count = 2;\n302\t    } else {\n303\t        s.a.u = uABC;\n304\t        s.b.u = vABC;\n305\t        s.c.u = wABC;\n306\t        s.div = uABC + vABC + wABC;\n307\t        s.count = 3;\n308\t    }\n309\t}\n310\t\n311\t#[inline]\n312\tfn c2Neg(a: c2v) -> c2v {\n313\t    c2V(-a.x, -a.y)\n314\t}\n315\t\n316\t#[inline]\n317\tfn c2Skew(a: c2v) -> c2v {\n318\t    c2v { x: -a.y, y: a.x }\n319\t}\n320\t\n321\t#[inline]\n322\tfn c2CCW90(a: c2v) -> c2v {\n323\t    c2v { x: a.y, y: -a.x }\n324\t}\n325\t\n326\tfn c2D(s: &c2Simplex) -> c2v {\n327\t    match s.count {\n328\t        1 => c2Neg(s.a.p),\n329\t        2 => {\n330\t            let ab = c2Sub(s.b.p, s.a.p);\n331\t            if c2Det2(ab, c2Neg(s.a.p)) > 0.0 {\n332\t                c2Skew(ab)\n333\t            } else {\n334\t                c2CCW90(ab)\n335\t            }\n336\t        }\n337\t        _ => c2V(0.0, 0.0),\n338\t    }\n339\t}\n340\t\n341\tfn c2Support(verts: &[c2v], count: c_int, d: c2v) -> c_int {\n342\t    let mut imax: c_int = 0;\n343\t    let mut dmax = c2Dot(verts[0], d);\n344\t    let mut i: c_int = 1;\n345\t    while i < count {\n346\t        let dot = c2Dot(verts[i as usize], d);\n347\t        if dot > dmax {\n348\t            imax = i;\n349\t            dmax = dot;\n350\t        }\n351\t        i += 1;\n352\t    }\n353\t    imax\n354\t}\n355\t\n356\tfn c2Witness(s: &c2Simplex, a: &mut c2v, b: &mut c2v) {\n357\t    let den = 1.0f32 / s.div;\n358\t    match s.count {\n359\t        1 => {\n360\t            *a = s.a.sA;\n361\t            *b = s.a.sB;\n362\t        }\n363\t        2 => {\n364\t            *a = c2Add(\n365\t                c2Mulvs(s.a.sA, den * s.a.u),\n366\t                c2Mulvs(s.b.sA, den * s.b.u),\n367\t            );\n368\t            *b = c2Add(\n369\t                c2Mulvs(s.a.sB, den * s.a.u),\n370\t                c2Mulvs(s.b.sB, den * s.b.u),\n371\t            );\n372\t        }\n373\t        3 => {\n374\t            *a = c2Add(\n375\t                c2Add(\n376\t                    c2Mulvs(s.a.sA, den * s.a.u),\n377\t                    c2Mulvs(s.b.sA, den * s.b.u),\n378\t                ),\n379\t                c2Mulvs(s.c.sA, den * s.c.u),\n380\t            );\n381\t            *b = c2Add(\n382\t                c2Add(\n383\t                    c2Mulvs(s.a.sB, den * s.a.u),\n384\t                    c2Mulvs(s.b.sB, den * s.b.u),\n385\t                ),\n386\t                c2Mulvs(s.c.sB, den * s.c.u),\n387\t            );\n388\t        }\n389\t        _ => {\n390\t            *a = c2V(0.0, 0.0);\n391\t            *b = c2V(0.0, 0.0);\n392\t        }\n393\t    }\n394\t}\n395\t\n396\t#[inline]\n397\tfn c2Div(a: c2v, b: f32) -> c2v {\n398\t    c2Mulvs(a, 1.0f32 / b)\n399\t}\n400\t\n401\t#[inline]\n402\tfn c2Norm(a: c2v) -> c2v {\n403\t    c2Div(a, c2Len(a))\n404\t}\n405\t\n406\tfn c2L(s: &c2Simplex) -> c2v {\n407\t    let den = 1.0f32 / s.div;\n408\t    match s.count {\n409\t        1 => s.a.p,\n410\t        2 => c2Add(\n411\t            c2Mulvs(s.a.p, den * s.a.u),\n412\t            c2Mulvs(s.b.p, den * s.b.u),\n413\t        ),\n414\t        _ => c2V(0.0, 0.0),\n415\t    }\n416\t}\n417\t\n418\t#[inline]\n419\tfn c2MulrvT(a: c2r, b: c2v) -> c2v {\n420\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n421\t}\n422\t\n423\tunsafe fn c2GJK(\n424\t    A: *const c_void,\n425\t    typeA: C2_TYPE,\n426\t    ax_ptr: *const c2x,\n427\t    B: *const c_void,\n428\t    typeB: C2_TYPE,\n429\t    bx_ptr: *const c2x,\n430\t    outA: *mut c2v,\n431\t    outB: *mut c2v,\n432\t    use_radius: c_int,\n433\t    iterations: *mut c_int,\n434\t    cache: *mut c2GJKCache,\n435\t) -> f32 {\n436\t    let ax: c2x = if ax_ptr.is_null() {\n437\t        c2xIdentity()\n438\t    } else {\n439\t        *ax_ptr\n440\t    };\n441\t    let bx: c2x = if bx_ptr.is_null() {\n442\t        c2xIdentity()\n443\t    } else {\n444\t        *bx_ptr\n445\t    };\n446\t    let mut pA = c2Proxy::default();\n447\t    let mut pB = c2Proxy::default();\n448\t    c2MakeProxy(A, typeA, &mut pA);\n449\t    c2MakeProxy(B, typeB, &mut pB);\n450\t    let mut s = c2Simplex::default();\n451\t    let mut cache_was_read: c_int = 0;\n452\t\n453\t    // helper closures for accessing simplex slots by index\n454\t    fn get_vert(s: &c2Simplex, i: usize) -> c2sv {\n455\t        match i {\n456\t            0 => s.a,\n457\t            1 => s.b,\n458\t            2 => s.c,\n459\t            3 => s.d,\n460\t            _ => unreachable!(),\n461\t        }\n462\t    }\n463\t    fn set_vert(s: &mut c2Simplex, i: usize, v: c2sv) {\n464\t        match i {\n465\t            0 => s.a = v,\n466\t            1 => s.b = v,\n467\t            2 => s.c = v,\n468\t            3 => s.d = v,\n469\t            _ => unreachable!(),\n470\t        }\n471\t    }\n472\t\n473\t    if !cache.is_null() {\n474\t        let cache_ref = &mut *cache;\n475\t        let cache_was_good = cache_ref.count != 0;\n476\t        if cache_was_good {\n477\t            for i in 0..(cache_ref.count as usize) {\n478\t                let iA = cache_ref.iA[i];\n479\t                let iB = cache_ref.iB[i];\n480\t                let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n481\t                let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n482\t                let v = c2sv {\n483\t                    iA,\n484\t                    sA,\n485\t                    iB,\n486\t                    sB,\n487\t                    p: c2Sub(sB, sA),\n488\t                    u: 0.0,\n489\t                };\n490\t                set_vert(&mut s, i, v);\n491\t            }\n492\t            s.count = cache_ref.count;\n493\t            s.div = cache_ref.div;\n494\t            let metric_old = cache_ref.metric;\n495\t            let metric = c2GJKSimplexMetric(&s);\n496\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n497\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n498\t            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n499\t                cache_was_read = 1;\n500\t            }\n501\t        }\n502\t    }\n503\t    if cache_was_read == 0 {\n504\t        s.a.iA = 0;\n505\t        s.a.iB = 0;\n506\t        s.a.sA = c2Mulxv(ax, pA.verts[0]);\n507\t        s.a.sB = c2Mulxv(bx, pB.verts[0]);\n508\t        s.a.p = c2Sub(s.a.sB, s.a.sA);\n509\t        s.a.u = 1.0;\n510\t        s.div = 1.0;\n511\t        s.count = 1;\n512\t    }\n513\t    let mut saveA: [c_int; 3] = [0; 3];\n514\t    let mut saveB: [c_int; 3] = [0; 3];\n515\t    let mut save_count: c_int;\n516\t    let mut d0: f32 = 3.4028234663