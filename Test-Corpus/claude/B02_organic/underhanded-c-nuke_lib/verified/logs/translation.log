loat)((double)v[i] / magnitude)`.\n#[inline]\nunsafe fn normalize(v: *mut f32, length: c_int) {\n    let magnitude: f64 = unsafe { dot_product(v, v, length) }.sqrt();\n    let mut i: c_int = 0;\n    while i < length {\n        let p = unsafe { v.offset(i as isize) };\n        let cur: f32 = unsafe { *p };\n        let scaled: f64 = (cur as f64) / magnitude;\n        unsafe { *p = scaled as f32 };\n        i = i.wrapping_add(1);\n    }\n}\n\n/// double spectral_contrast(float_t *a, float_t *b, int length)\n///\n/// ```c\n/// normalize(a, length);\n/// normalize(b, length);\n/// return dot_product(a, b, length);\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn spectral_contrast(a: *mut f32, b: *mut f32, length: c_int) -> f64 {\n    unsafe {\n        normalize(a, length);\n        normalize(b, length);\n        dot_product(a, b, length)\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6359,"cache_read_input_tokens":29047,"cache_creation":{"ephemeral_5m_input_tokens":6359,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c225ee8b-8e99-4008-a96e-c3986db5292d","uuid":"369db4c5-9612-420b-991b-e42fd937438d","timestamp":"2026-08-20T05:15:37.937Z"}
