95\t                ),\n396\t                c2Mulvs(s.c.sB, den * s.c.u),\n397\t            );\n398\t        }\n399\t        _ => {\n400\t            *a = c2V(0.0, 0.0);\n401\t            *b = c2V(0.0, 0.0);\n402\t        }\n403\t    }\n404\t}\n405\t\n406\t#[inline]\n407\tfn c2Div(a: c2v, b: f32) -> c2v {\n408\t    c2Mulvs(a, 1.0f32 / b)\n409\t}\n410\t\n411\t#[inline]\n412\tfn c2Norm(a: c2v) -> c2v {\n413\t    c2Div(a, c2Len(a))\n414\t}\n415\t\n416\tfn c2L(s: &c2Simplex) -> c2v {\n417\t    let den = 1.0f32 / s.div;\n418\t    match s.count {\n419\t        1 => s.a.p,\n420\t        2 => c2Add(\n421\t            c2Mulvs(s.a.p, den * s.a.u),\n422\t            c2Mulvs(s.b.p, den * s.b.u),\n423\t        ),\n424\t        _ => c2V(0.0, 0.0),\n425\t    }\n426\t}\n427\t\n428\t#[inline]\n429\tfn c2MulrvT(a: c2r, b: c2v) -> c2v {\n430\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n431\t}\n432\t\n433\tfn c2GJK(\n434\t    a_shape: ShapeRef,\n435\t    ax_ptr: Option<&c2x>,\n436\t    b_shape: ShapeRef,\n437\t    bx_ptr: Option<&c2x>,\n438\t    out_a: Option<&mut c2v>,\n439\t    out_b: Option<&mut c2v>,\n440\t    use_radius: c_int,\n441\t    iterations: Option<&mut c_int>,\n442\t    cache: Option<&mut c2GJKCache>,\n443\t) -> f32 {\n444\t    let ax = match ax_ptr {\n445\t        None => c2xIdentity(),\n446\t        Some(p) => *p,\n447\t    };\n448\t    let bx = match bx_ptr {\n449\t        None => c2xIdentity(),\n450\t        Some(p) => *p,\n451\t    };\n452\t    let mut pA = c2Proxy::default();\n453\t    let mut pB = c2Proxy::default();\n454\t    c2MakeProxy(a_shape, &mut pA);\n455\t    c2MakeProxy(b_shape, &mut pB);\n456\t    let mut s = c2Simplex::default();\n457\t    let mut cache_was_read = 0;\n458\t    if let Some(ref c) = cache {\n459\t        let cache_was_good = c.count != 0;\n460\t        if cache_was_good {\n461\t            for i in 0..c.count as usize {\n462\t                let iA = c.iA[i];\n463\t                let iB = c.iB[i];\n464\t                let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n465\t                let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n466\t                let v = s.get_mut(i);\n467\t                v.iA = iA;\n468\t                v.sA = sA;\n469\t                v.iB = iB;\n470\t                v.sB = sB;\n471\t                v.p = c2Sub(v.sB, v.sA);\n472\t                v.u = 0.0;\n473\t            }\n474\t            s.count = c.count;\n475\t            s.div = c.div;\n476\t            let metric_old = c.metric;\n477\t            let metric = c2GJKSimplexMetric(&s);\n478\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n479\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n480\t            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n481\t                cache_was_read = 1;\n482\t            }\n483\t        }\n484\t    }\n485\t    if cache_was_read == 0 {\n486\t        s.a.iA = 0;\n487\t        s.a.iB = 0;\n488\t        s.a.sA = c2Mulxv(ax, pA.verts[0]);\n489\t        s.a.sB = c2Mulxv(bx, pB.verts[0]);\n490\t        s.a.p = c2Sub(s.a.sB, s.a.sA);\n491\t        s.a.u = 1.0;\n492\t        s.div = 1.0;\n493\t        s.count = 1;\n494\t    }\n495\t    let mut saveA: [c_int; 3] = [0; 3];\n496\t    let mut saveB: [c_int; 3] = [0; 3];\n497\t    let mut save_count: c_int = 0;\n498\t    let mut d0: f32 = 3.40282346638528859811704183484516925e+38f32;\n499\t    let mut d1: f32;\n500\t    let mut iter: c_int = 0;\n501\t    let mut hit: c_int = 0;\n502\t    while iter < 20 {\n503\t        save_count = s.count;\n504\t        for i in 0..save_count as usize {\n505\t            let v = s.get(i);\n506\t            saveA[i] = v.iA;\n507\t            saveB[i] = v.iB;\n508\t        }\n509\t        match s.count {\n510\t            1 => {}\n511\t            2 => c22(&mut s),\n512\t            3 => c23(&mut s),\n513\t            _ => {}\n514\t        }\n515\t        if s.count == 3 {\n516\t            hit = 1;\n517\t            break;\n518\t        }\n519\t        let p = c2L(&s);\n520\t        d1 = c2Dot(p, p);\n521\t        if d1 > d0 {\n522\t            break;\n523\t        }\n524\t        d0 = d1;\n525\t        let d = c2D(&s);\n526\t        if c2Dot(d, d)\n527\t            < 1.19209289550781250000000000000000000e-7f32\n528\t                * 1.19209289550781250000000000000000000e-7f32\n529\t        {\n530\t            break;\n531\t        }\n532\t        let iA = c2Support(&pA.verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\n533\t        let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n534\t        let iB = c2Support(&pB.verts, pB.count, c2MulrvT(bx.r, d));\n535\t        let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n536\t        {\n537\t            let count = s.count;\n538\t            let v = s.get_mut(count as usize);\n539\t            v.iA = iA;\n540\t            v.sA = sA;\n541\t            v.iB = iB;\n542\t            v.sB = sB;\n543\t            v.p = c2Sub(v.sB, v.sA);\n544\t        }\n545\t        let mut dup = 0;\n546\t        for i in 0..save_count as usize {\n547\t            if iA == saveA[i] && iB == saveB[i] {\n548\t                dup = 1;\n549\t                break;\n550\t            }\n551\t        }\n552\t        if dup != 0 {\n553\t            break;\n554\t        }\n555\t        s.count += 1;\n556\t        iter += 1;\n557\t    }\n558\t    let _ = save_count;\n559\t    let mut a = c2v::default();\n560\t    let mut b = c2v::default();\n561\t    c2Witness(&s, &mut a, &mut b);\n562\t    let mut dist = c2Len(c2Sub(a, b));\n563\t    if hit != 0 {\n564\t        a = b;\n565\t        dist = 0.0;\n566\t    } else if use_radius != 0 {\n567\t        let rA = pA.radius;\n568\t        let rB = pB.radius;\n569\t        if dist > rA + rB && dist > 1.19209289550781250000000000000000000e-7f32 {\n570\t            dist -= rA + rB;\n571\t            let n = c2Norm(c2Sub(b, a));\n572\t            a = c2Add(a, c2Mulvs(n, rA));\n573\t            b = c2Sub(b, c2Mulvs(n, rB));\n574\t            if a.x == b.x && a.y == b.y {\n575\t                dist = 0.0;\n576\t            }\n577\t        } else {\n578\t            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n579\t            a = p;\n580\t            b = p;\n581\t            dist = 0.0;\n582\t        }\n583\t    }\n584\t    if let Some(c) = cache {\n585\t        c.metric = c2GJKSimplexMetric(&s);\n586\t        c.count = s.count;\n587\t        for i in 0..s.count as usize {\n588\t            let v = s.get(i);\n589\t            c.iA[i] = v.iA;\n590\t            c.iB[i] = v.iB;\n591\t        }\n592\t        c.div = s.div;\n593\t    }\n594\t    if let Some(o) = out_a {\n595\t        *o = a;\n596\t    }\n597\t    if let Some(o) = out_b {\n598\t        *o = b;\n599\t    }\n600\t    if let Some(it) = iterations {\n601\t        *it = iter;\n602\t    }\n603\t    dist\n604\t}\n605\t\n606\tfn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n607\t    let d0 = (B.max.x < A.min.x) as c_int;\n608\t    let d1 = (A.max.x < B.min.x) as c_int;\n609\t    let d2 = (B.max.y < A.min.y) as c_int;\n610\t    let d3 = (A.max.y < B.min.y) as c_int;\n611\t    (!((d0 | d1 | d2 | d3) != 0)) as c_int\n612\t}\n613\t\n614\tfn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n615\t    if c2GJK(\n616\t        ShapeRef::Aabb(&A),\n617\t        None,\n618\t        ShapeRef::Capsule(&B),\n619\t        None,\n620\t        None,\n621\t        None,\n622\t        1,\n623\t        None,\n624\t        None,\n625\t    ) != 0.0\n626\t    {\n627\t        return 0;\n628\t    }\n629\t    1\n630\t}\n631\t\n632\tfn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n633\t    if c2GJK(\n634\t        ShapeRef::Capsule(&A),\n635\t        None,\n636\t        ShapeRef::Capsule(&B),\n637\t        None,\n638\t        None,\n639\t        None,\n640\t        1,\n641\t        None,\n642\t        None,\n643\t    ) != 0.0\n644\t    {\n645\t        return 0;\n646\t    }\n647\t    1\n648\t}\n649\t\n650\tfn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n651\t    let c = c2Sub(B.p, A.p);\n652\t    let d2 = c2Dot(c, c);\n653\t    let mut r2 = A.r + B.r;\n654\t    r2 = r2 * r2;\n655\t    (d2 < r2) as c_int\n656\t}\n657\t\n658\tfn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n659\t    let l = c2Clampv(A.p, B.min, B.max);\n660\t    let ab = c2Sub(A.p, l);\n661\t    let d2 = c2Dot(ab, ab);\n662\t    let r2 = A.r * A.r;\n663\t    (d2 < r2) as c_int\n664\t}\n665\t\n666\tfn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n667\t    let n = c2Sub(B.b, B.a);\n668\t    let ap = c2Sub(A.p, B.a);\n669\t    let da = c2Dot(ap, n);\n670\t    let d2;\n671\t    if da < 0.0 {\n672\t        d2 = c2Dot(ap, ap);\n673\t    } else {\n674\t        let db = c2Dot(c2Sub(A.p, B.b), n);\n675\t        if db < 0.0 {\n676\t            let e = c2Sub(ap, c2Mulvs(n, da / c2Dot(n, n)));\n677\t            d2 = c2Dot(e, e);\n678\t        } else {\n679\t            let bp = c2Sub(A.p, B.b);\n680\t            d2 = c2Dot(bp, bp);\n681\t        }\n682\t    }\n683\t    let r = A.r + B.r;\n684\t    (d2 < r * r) as c_int\n685\t}\n686\t\n687\t#[derive(Copy, Clone)]\n688\tenum Shape {\n689\t    Circle(c2Circle),\n690\t    Aabb(c2AABB),\n691\t    Capsule(c2Capsule),\n692\t}\n693\t\n694\tfn c2Collided(a: &Shape, b: &Shape) -> c_int {\n695\t    match a {\n696\t        Shape::Circle(ca) => match b {\n697\t            Shape::Circle(cb) => c2CircletoCircle(*ca, *cb),\n698\t            Shape::Aabb(bb) => c2CircletoAABB(*ca, *bb),\n699\t            Shape::Capsule(cap) => c2CircletoCapsule(*ca, *cap),\n700\t        },\n701\t        Shape::Aabb(aa) => match b {\n702\t            Shape::Circle(cb) => c2CircletoAABB(*cb, *aa),\n703\t            Shape::Aabb(bb) => c2AABBtoAABB(*aa, *bb),\n704\t            Shape::Capsule(cap) => c2AABBtoCapsule(*aa, *cap),\n705\t        },\n706\t        Shape::Capsule(ca) => match b {\n707\t            Shape::Circle(cb) => c2CircletoCapsule(*cb, *ca),\n708\t            Shape::Aabb(bb) => c2AABBtoCapsule(*bb, *ca),\n709\t            Shape::Capsule(cb) => c2CapsuletoCapsule(*ca, *cb),\n710\t        },\n711\t    }\n712\t}\n713\t\n714\t#[unsafe(no_mangle)]\n715\tpub extern \"C\" fn reverse_collide(x: f32, y: f32, r: f32) -> c_int {\n716\t    let mut result: c_int = 0;\n717\t\n718\t    let mut circle_in = c2Circle::default();\n719\t    circle_in.p = c2V(x, y);\n720\t    circle_in.r = r;\n721\t\n722\t    let mut circle = c2Circle::default();\n723\t    circle.p = c2V(-70.0, 0.0);\n724\t    circle.r = 20.0;\n725\t\n726\t    let mut aabb = c2AABB::default();\n727\t    aabb.min = c2V(-40.0, -40.0);\n728\t    aabb.max = c2V(-15.0, -15.0);\n729\t\n730\t    let mut capsule = c2Capsule::default();\n731\t    capsule.a = c2V(-40.0, 40.0);\n732\t    capsule.b = c2V(-20.0, 100.0);\n733\t    capsule.r = 10.0;\n734\t\n735\t    result += c2Collided(&Shape::Circle(circle), &Shape::Circle(circle_in));\n736\t    result += c2Collided(&Shape::Aabb(aabb), &Shape::Circle(circle_in)) << 1;\n737\t    result += c2Collided(&Shape::Capsule(capsule), &Shape::Circle(circle_in)) << 2;\n738\t\n739\t    result\n740\t}\n741\t"}]},"parent_tool_use_id":null,"session_id":"21e4651a-1532-45d0-b1a5-49e2c4dbb2c4","uuid":"34b2e1aa-fefa-48c8-a576-639af73509d2","timestamp":"2026-05-27T17:19:10.939Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-work-TUuKqI/translated_rust/src/lib.rs","content":"#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(dead_code)]\n\nuse std::ffi::c_int;\n\n#[derive(Copy, Clone, PartialEq, Eq)]\n#[repr(C)]\nenum C2_TYPE {\n    C2_TYPE_CIRCLE = 0,\n    C2_TYPE_AABB = 1,\n    C2_TYPE_CAPSULE = 2,\n}\n\n#[derive(Copy, Clone, Default)]\n#[repr(C)]\nstruct c2v {\n    x: f32,\n    y: f32,\n}\n\n#[derive(Copy, Clone, Default)]\n#[repr(C)]\nstruct c2r {\n    c: f32,\n    s: f32,\n}\n\n#[derive(Copy, Clone, Default)]\n#[repr(C)]\nstruct c2x {\n    p: c2v,\n    r: c2r,\n}\n\n#[derive(Copy, Clone, Default)]\n#[repr(C)]\nstruct c2Circle {\n    p: c2v,\n    r: f32,\n}\n\n#[derive(Copy, Clone, Default)]\n#[repr(C)]\nstruct c2AABB {\n    min: c2v,\n    max: c2v,\n}\n\n#[derive(Copy, Clone, Default)]\n#[repr(C)]\nstruct c2Capsule {\n    a: c2v,\n    b: c2v,\n    r: f32,\n}\n\n#[derive(Copy, Clone, Default)]\n#[repr(C)]\nstruct c2GJKCache {\n    metric: f32,\n    count: c_int,\n    iA: [c_int; 3],\n    iB: [c_int; 3],\n    div: f32,\n}\n\n#[inline]\nfn c2V(x: f32, y: f32) -> c2v {\n    c2v { x, y }\n}\n\n#[inline]\nfn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n#[inline]\nfn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[inline]\nfn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[inline]\nfn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n#[inline]\nfn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[inline]\nfn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n#[inline]\nfn c2RotIdentity() -> c2r {\n    c2r { c: 1.0f32, s: 0.0 }\n}\n\n#[inline]\nfn c2xIdentity() -> c2x {\n    c2x {\n        p: c2V(0.0, 0.0),\n        r: c2RotIdentity(),\n    }\n}\n\n#[derive(Copy, Clone, Default)]\nstruct c2Proxy {\n    radius: f32,\n    count: c_int,\n    verts: [c2v; 8],\n}\n\nfn c2BBVerts(out: &mut [c2v], bb: &c2AABB) {\n    out[0] = bb.min;\n    out[1] = c2V(bb.max.x, bb.min.y);\n    out[2] = bb.max;\n    out[3] = c2V(bb.min.x, bb.max.y);\n}\n\nenum ShapeRef<'a> {\n    Circle(&'a c2Circle),\n    Aabb(&'a c2AABB),\n    Capsule(&'a c2Capsule),\n}\n\nfn c2MakeProxy(shape: ShapeRef, p: &mut c2Proxy) {\n    match shape {\n        ShapeRef::Circle(c) => {\n            p.radius = c.r;\n            p.count = 1;\n            p.verts[0] = c.p;\n        }\n        ShapeRef::Aabb(bb) => {\n            p.radius = 0.0;\n            p.count = 4;\n            c2BBVerts(&mut p.verts, bb);\n        }\n        ShapeRef::Capsule(c) => {\n            p.radius = c.r;\n            p.count = 2;\n            p.verts[0] = c.a;\n            p.verts[1] = c.b;\n        }\n    }\n}\n\n#[derive(Copy, Clone, Default)]\nstruct c2sv {\n    sA: c2v,\n    sB: c2v,\n    p: c2v,\n    u: f32,\n    iA: c_int,\n    iB: c_int,\n}\n\n#[derive(Copy, Clone, Default)]\nstruct c2Simplex {\n    a: c2sv,\n    b: c2sv,\n    c: c2sv,\n    d: c2sv,\n    div: f32,\n    count: c_int,\n}\n\nimpl c2Simplex {\n    fn get(&self, i: usize) -> c2sv {\n        match i {\n            0 => self.a,\n            1 => self.b,\n            2 => self.c,\n            3 => self.d,\n            _ => unreachable!(),\n        }\n    }\n    fn get_mut(&mut self, i: usize) -> &mut c2sv {\n        match i {\n            0 => &mut self.a,\n            1 => &mut self.b,\n            2 => &mut self.c,\n            3 => &mut self.d,\n            _ => unreachable!(),\n        }\n    }\n}\n\n#[inline]\nfn c2Len(a: c2v) -> f32 {\n    c2Dot(a, a).sqrt()\n}\n\n#[inline]\nfn c2Det2(a: c2v, b: c2v) -> f32 {\n    a.x * b.y - a.y * b.x\n}\n\nfn c2GJKSimplexMetric(s: &c2Simplex) -> f32 {\n    match s.count {\n        2 => c2Len(c2Sub(s.b.p, s.a.p)),\n        3 => c2Det2(c2Sub(s.b.p, s.a.p), c2Sub(s.c.p, s.a.p)),\n        _ => 0.0,\n    }\n}\n\n#[inline]\nfn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n}\n\n#[inline]\nfn c2Add(mut a: c2v, b: c2v) -> c2v {\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[inline]\nfn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\nfn c22(s: &mut c2Simplex) {\n    let a = s.a.p;\n    let b = s.b.p;\n    let u = c2Dot(b, c2Sub(b, a));\n    let v = c2Dot(a, c2Sub(a, b));\n    if v <= 0.0 {\n        s.a.u = 1.0;\n        s.div = 1.0;\n        s.count = 1;\n    } else if u <= 0.0 {\n        s.a = s.b;\n        s.a.u = 1.0;\n        s.div = 1.0;\n        s.count = 1;\n    } else {\n        s.a.u = u;\n        s.b.u = v;\n        s.div = u + v;\n        s.count = 2;\n    }\n}\n\nfn c23(s: &mut c2Simplex) {\n    let a = s.a.p;\n    let b = s.b.p;\n    let c = s.c.p;\n    let uAB = c2Dot(b, c2Sub(b, a));\n    let vAB = c2Dot(a, c2Sub(a, b));\n    let uBC = c2Dot(c, c2Sub(c, b));\n    let vBC = c2Dot(b, c2Sub(b, c));\n    let uCA = c2Dot(a, c2Sub(a, c));\n    let vCA = c2Dot(c, c2Sub(c, a));\n    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n    let uABC = c2Det2(b, c) * area;\n    let vABC = c2Det2(c, a) * area;\n    let wABC = c2Det2(a, b) * area;\n    if vAB <= 0.0 && uCA <= 0.0 {\n        s.a.u = 1.0;\n        s.div = 1.0;\n        s.count = 1;\n    } else if uAB <= 0.0 && vBC <= 0.0 {\n        s.a = s.b;\n        s.a.u = 1.0;\n        s.div = 1.0;\n        s.count = 1;\n    } else if uBC <= 0.0 && vCA <= 0.0 {\n        s.a = s.c;\n        s.a.u = 1.0;\n        s.div = 1.0;\n        s.count = 1;\n    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n        s.a.u = uAB;\n        s.b.u = vAB;\n        s.div = uAB + vAB;\n        s.count = 2;\n    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n        s.a = s.b;\n        s.b = s.c;\n        s.a.u = uBC;\n        s.b.u = vBC;\n        s.div = uBC + vBC;\n        s.count = 2;\n    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n        s.b = s.a;\n        s.a = s.c;\n        s.a.u = uCA;\n        s.b.u = vCA;\n        s.div = uCA + vCA;\n        s.count = 2;\n    } else {\n        s.a.u = uABC;\n        s.b.u = vABC;\n        s.c.u = wABC;\n        s.div = uABC + vABC + wABC;\n        s.count = 3;\n    }\n}\n\n#[inline]\nfn c2Neg(a: c2v) -> c2v {\n    c2V(-a.x, -a.y)\n}\n\n#[inline]\nfn c2Skew(a: c2v) -> c2v {\n    c2v { x: -a.y, y: a.x }\n}\n\n#[inline]\nfn c2CCW90(a: c2v) -> c2v {\n    c2v { x: a.y, y: -a.x }\n}\n\nfn c2D(s: &c2Simplex) -> c2v {\n    match s.count {\n        1 => c2Neg(s.a.p),\n        2 => {\n            let ab = c2Sub(s.b.p, s.a.p);\n            if c2Det2(ab, c2Neg(s.a.p)) > 0.0 {\n                c2Skew(ab)\n            } else {\n                c2CCW90(ab)\n            }\n        }\n        _ => c2V(0.0, 0.0),\n    }\n}\n\nfn c2Support(verts: &[c2v], count: c_int, d: c2v) -> c_int {\n    let mut imax: c_int = 0;\n    let mut dmax = c2Dot(verts[0], d);\n    let mut i: c_int = 1;\n    while i < count {\n        let dot = c2Dot(verts[i as usize], d);\n        if dot > dmax {\n            imax = i;\n            dmax = dot;\n        }\n        i += 1;\n    }\n    imax\n}\n\nfn c2Witness(s: &c2Simplex, a: &mut c2v, b: &mut c2v) {\n    let den = 1.0f32 / s.div;\n    match s.count {\n        1 => {\n            *a = s.a.sA;\n            *b = s.a.sB;\n        }\n        2 => {\n            *a = c2Add(\n                c2Mulvs(s.a.sA, den * s.a.u),\n                c2Mulvs(s.b.sA, den * s.b.u),\n            );\n            *b = c2Add(\n                c2Mulvs(s.a.sB, den * s.a.u),\n                c2Mulvs(s.b.sB, den * s.b.u),\n            );\n        }\n        3 => {\n            *a = c2Add(\n                c2Add(\n                    c2Mulvs(s.a.sA, den * s.a.u),\n                    c2Mulvs(s.b.sA, den * s.b.u),\n                ),\n                c2Mulvs(s.c.sA, den * s.c.u),\n            );\n            *b = c2Add(\n                c2Add(\n                    c2Mulvs(s.a.sB, den * s.a.u),\n                    c2Mulvs(s.b.sB, den * s.b.u),\n                ),\n                c2Mulvs(s.c.sB, den * s.c.u),\n            );\n        }\n        _ => {\n            *a = c2V(0.0, 0.0);\n            *b = c2V(0.0, 0.0);\n        }\n    }\n}\n\n#[inline]\nfn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n#[inline]\nfn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\nfn c2L(s: &c2Simplex) -> c2v {\n    let den = 1.0f32 / s.div;\n    match s.count {\n        1 => s.a.p,\n        2 => c2Add(\n            c2Mulvs(s.a.p, den * s.a.u),\n            c2Mulvs(s.b.p, den * s.b.u),\n        ),\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[inline]\nfn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n}\n\nfn c2GJK(\n    a_shape: ShapeRef,\n    ax_ptr: Option<&c2x>,\n    b_shape: ShapeRef,\n    bx_ptr: Option<&c2x>,\n    out_a: Option<&mut c2v>,\n    out_b: Option<&mut c2v>,\n    use_radius: c_int,\n    iterations: Option<&mut c_int>,\n    cache: Option<&mut c2GJKCache>,\n) -> f32 {\n    let ax = match ax_ptr {\n        None => c2xIdentity(),\n        Some(p) => *p,\n    };\n    let bx = match bx_ptr {\n        None => c2xIdentity(),\n        Some(p) => *p,\n    };\n    let mut pA = c2Proxy::default();\n    let mut pB = c2Proxy::default();\n    c2MakeProxy(a_shape, &mut pA);\n    c2MakeProxy(b_shape, &mut pB);\n    let mut s = c2Simplex::default();\n    let mut cache_was_read = 0;\n    if let Some(ref c) = cache {\n        let cache_was_good = c.count != 0;\n        if cache_was_good {\n            for i in 0..c.count as usize {\n                let iA = c.iA[i];\n                let iB = c.iB[i];\n                let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n                let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n                let v = s.get_mut(i);\n                v.iA = iA;\n                v.sA = sA;\n                v.iB = iB;\n                v.sB = sB;\n                v.p = c2Sub(v.sB, v.sA);\n                v.u = 0.0;\n            }\n            s.count = c.count;\n            s.div = c.div;\n            let metric_old = c.metric;\n            let metric = c2GJKSimplexMetric(&s);\n            let min_metric = if metric < metric_old { metric } else { metric_old };\n            let max_metric = if metric > metric_old { metric } else { metric_old };\n            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n                cache_was_read = 1;\n            }\n        }\n    }\n    if cache_was_read == 0 {\n        s.a.iA = 0;\n        s.a.iB = 0;\n        s.a.sA = c2Mulxv(ax, pA.verts[0]);\n        s.a.sB = c2Mulxv(bx, pB.verts[0]);\n        s.a.p = c2Sub(s.a.sB, s.a.sA);\n        s.a.u = 1.0;\n        s.div = 1.0;\n        s.count = 1;\n    }\n    let mut saveA: [c_int; 3] = [0; 3];\n    let mut saveB: [c_int; 3] = [0; 3];\n    let mut save_count: c_int = 0;\n    let mut d0: f32 = 3.40282346638528859811704183484516925e+38f32;\n    let mut d1: f32;\n    let mut iter: c_int = 0;\n    let mut hit: c_int = 0;\n    while iter < 20 {\n        save_count = s.count;\n        for i in 0..save_count as usize {\n            let v = s.get(i);\n            saveA[i] = v.iA;\n            saveB[i] = v.iB;\n        }\n        match s.count {\n            1 => {}\n            2 => c22(&mut s),\n            3 => c23(&mut s),\n            _ => {}\n        }\n        if s.count == 3 {\n            hit = 1;\n            break;\n        }\n        let p = c2L(&s);\n        d1 = c2Dot(p, p);\n        if d1 > d0 {\n            break;\n        }\n        d0 = d1;\n        let d = c2D(&s);\n        if c2Dot(d, d)\n            < 1.19209289550781250000000000000000000e-7f32\n                * 1.19209289550781250000000000000000000e-7f32\n        {\n            break;\n        }\n        let iA = c2Support(&pA.verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\n        let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n        let iB = c2Support(&pB.verts, pB.count, c2MulrvT(bx.r, d));\n        let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n        {\n            let count = s.count;\n            let v = s.get_mut(count as usize);\n            v.iA = iA;\n            v.sA = sA;\n            v.iB = iB;\n            v.sB = sB;\n            v.p = c2Sub(v.sB, v.sA);\n        }\n        let mut dup = 0;\n        for i in 0..save_count as usize {\n            if iA == saveA[i] && iB == saveB[i] {\n                dup = 1;\n                break;\n            }\n        }\n        if dup != 0 {\n            break;\n        }\n        s.count += 1;\n        iter += 1;\n    }\n    let _ = save_count;\n    let mut a = c2v::default();\n    let mut b = c2v::default(