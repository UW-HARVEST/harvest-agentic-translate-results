          sA: c2V(0.0, 0.0),\n102\t            sB: c2V(0.0, 0.0),\n103\t            p: c2V(0.0, 0.0),\n104\t            u: 0.0,\n105\t            iA: 0,\n106\t            iB: 0,\n107\t        }\n108\t    }\n109\t}\n110\t\n111\t#[repr(C)]\n112\t#[derive(Copy, Clone)]\n113\tstruct c2Simplex {\n114\t    a: c2sv,\n115\t    b: c2sv,\n116\t    c: c2sv,\n117\t    d: c2sv,\n118\t    div: f32,\n119\t    count: c_int,\n120\t}\n121\t\n122\timpl c2Simplex {\n123\t    fn new() -> Self {\n124\t        c2Simplex {\n125\t            a: c2sv::new(),\n126\t            b: c2sv::new(),\n127\t            c: c2sv::new(),\n128\t            d: c2sv::new(),\n129\t            div: 0.0,\n130\t            count: 0,\n131\t        }\n132\t    }\n133\t\n134\t    /// Get a mutable reference to one of the simplex vertices, by index.\n135\t    /// Mirrors the C pattern `verts = &s.a; verts[i]` where the four\n136\t    /// `c2sv` members are laid out contiguously in memory.\n137\t    fn vert(&self, i: usize) -> &c2sv {\n138\t        match i {\n139\t            0 => &self.a,\n140\t            1 => &self.b,\n141\t            2 => &self.c,\n142\t            3 => &self.d,\n143\t            _ => panic!(\"simplex index out of bounds\"),\n144\t        }\n145\t    }\n146\t\n147\t    fn vert_mut(&mut self, i: usize) -> &mut c2sv {\n148\t        match i {\n149\t            0 => &mut self.a,\n150\t            1 => &mut self.b,\n151\t            2 => &mut self.c,\n152\t            3 => &mut self.d,\n153\t            _ => panic!(\"simplex index out of bounds\"),\n154\t        }\n155\t    }\n156\t}\n157\t\n158\t#[inline]\n159\tfn c2V(x: f32, y: f32) -> c2v {\n160\t    c2v { x, y }\n161\t}\n162\t\n163\t#[inline]\n164\tfn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n165\t    a.x *= b;\n166\t    a.y *= b;\n167\t    a\n168\t}\n169\t\n170\t#[inline]\n171\tfn c2Maxv(a: c2v, b: c2v) -> c2v {\n172\t    c2V(\n173\t        if a.x > b.x { a.x } else { b.x },\n174\t        if a.y > b.y { a.y } else { b.y },\n175\t    )\n176\t}\n177\