c2v, b: c2v) -> f32 {\n254\t    a.x * b.y - a.y * b.x\n255\t}\n256\t\n257\tfn c2GJKSimplexMetric(s: &c2Simplex) -> f32 {\n258\t    match s.count {\n259\t        2 => c2Len(c2Sub(s.b.p, s.a.p)),\n260\t        3 => c2Det2(c2Sub(s.b.p, s.a.p), c2Sub(s.c.p, s.a.p)),\n261\t        // default and case 1\n262\t        _ => 0.0,\n263\t    }\n264\t}\n265\t\n266\t#[inline]\n267\tfn c2Mulrv(a: c2r, b: c2v) -> c2v {\n268\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n269\t}\n270\t\n271\t#[inline]\n272\tfn c2Add(mut a: c2v, b: c2v) -> c2v {\n273\t    a.x += b.x;\n274\t    a.y += b.y;\n275\t    a\n276\t}\n277\t\n278\t#[inline]\n279\tfn c2Mulxv(a: c2x, b: c2v) -> c2v {\n280\t    c2Add(c2Mulrv(a.r, b), a.p)\n281\t}\n282\t\n283\tfn c22(s: &mut c2Simplex) {\n284\t    let a = s.a.p;\n285\t    let b = s.b.p;\n286\t    let u = c2Dot(b, c2Sub(b, a));\n287\t    let v = c2Dot(a, c2Sub(a, b));\n288\t    if v <= 0.0 {\n289\t        s.a.u = 1.0;\n290\t        s.div = 1.0;\n291\t        s.count = 1;\n292\t    } else if u <= 0.0 {\n293\t        s.a = s.b;\n294\t        s.a.u = 1.0;\n295\t        s.div = 1.0;\n296\t        s.count = 1;\n297\t    } else {\n298\t        s.a.u = u;\n299\t        s.b.u = v;\n300\t        s.div = u + v;\n301\t        s.count = 2;\n302\t    }\n303\t}\n304\t\n305\tfn c23(s: &mut c2Simplex) {\n306\t    let a = s.a.p;\n307\t    let b = s.b.p;\n308\t    let c = s.c.p;\n309\t    let uAB = c2Dot(b, c2Sub(b, a));\n310\t    let vAB = c2Dot(a, c2Sub(a, b));\n311\t    let uBC = c2Dot(c, c2Sub(c, b));\n312\t    let vBC = c2Dot(b, c2Sub(b, c));\n313\t    let uCA = c2Dot(a, c2Sub(a, c));\n314\t    let vCA = c2Dot(c, c2Sub(c, a));\n315\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n316\t    let uABC = c2Det2(b, c) * area;\n317\t    let vABC = c2Det2(c, a) * area;\n318\t    let wABC = c2Det2(a, b) * area;\n319\t    if vAB <= 0.0 && uCA <= 0.0 {\n320\t        s.a.u = 1.0;\n321\t        s.div = 1.0;\n322\t        s.count = 1;\n323\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n324\t        s.a = s.b;\n325\t        s.a.u = 1.0;\n326\t        s.div = 1.0;\n327\t        s.count = 1;\n328\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n329\t        s.a = s.c;\n330\t        s.a.u = 1.0;\n331\t        s.div = 1.0;\n332\t        s.count = 1;\n333\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n334\t        s.a.u = uAB;\n335\t        s.b.u = vAB;\n336\t        s.div = uAB + vAB;\n337\t        s.count = 2;\n338\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n339\t        s.a = s.b;\n340\t        s.b = s.c;\n341\t        s.a.u = uBC;\n342\t        s.b.u = vBC;\n343\t        s.div = uBC + vBC;\n344\t        s.count = 2;\n345\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n346\t        s.b = s.a;\n347\t        s.a = s.c;\n348\t        s.a.u = uCA;\n349\t        s.b.u = vCA;\n350\t        s.div = uCA + vCA;\n351\t        s.count = 2;\n352\t    } else {\n353\t        s.a.u = uABC;\n354\t        s.b.u = vABC;\n355\t        s.c.u = wABC;\n356\t        s.div = uABC + vABC + wABC;\n357\t        s.count = 3;\n358\t    }\n359\t}\n360\t\n361\t#[inline]\n362\tfn c2Neg(a: c2v) -> c2v {\n363\t    c2V(-a.x, -a.y)\n364\t}\n365\t\n366\t#[inline]\n367\tfn c2Skew(a: c2v) -> c2v {\n368\t    c2v { x: -a.y, y: a.x }\n369\t}\n370\t\n371\t#[inline]\n372\tfn c2CCW90(a: c2v) -> c2v {\n373\t    c2v { x: a.y, y: -a.x }\n374\t}\n375\t\n376\tfn c2D(s: &c2Simplex) -> c2v {\n377\t    match s.count {\n378\t        1 => c2Neg(s.a.p),\n379\t        2 => {\n380\t            let ab = c2Sub(s.b.p, s.a.p);\n381\t            if c2Det2(ab, c2Neg(s.a.p)) > 0.0 {\n382\t                c2Skew(ab)\n383\t            } else {\n384\t                c2CCW90(ab)\n385\t            }\n386\t        }\n387\t        // case 3 and default\n388\t        _ => c2V(0.0, 0.0),\n389\t    }\n390\t}\n391\t\n392\tfn c2Support(verts: &[c2v], count: c_int, d: c2v) -> c_int {\n393\t    let mut imax: c_int = 0;\n394\t    let mut dmax = c2Dot(verts[0], d);\n395\t    let mut i: c_int = 1;\n396\t    while i < count {\n397\t        let dot = c2Dot(verts[i as usize], d);\n398\t        if dot > dmax {\n399\t            imax = i;\n400\t            dmax = dot;\n401\t        }\n402\t        i += 1;\n403\t    }\n404\t    imax\n405\t}\n406\t\n407\tfn c2Witness(s: &c2Simplex, a: &mut c2v, b: &mut c2v) {\n408\t    let den = 1.0f32 / s.div;\n409\t    match s.count {\n410\t        1 => {\n411\t            *a = s.a.sA;\n412\t            *b = s.a.sB;\n413\t        }\n414\t        2 => {\n415\t            *a = c2Add(\n416\t                c2Mulvs(s.a.sA, den * s.a.u),\n417\t                c2Mulvs(s.b.sA, den * s.b.u),\n418\t            );\n419\t            *b = c2Add(\n420\t                c2Mulvs(s.a.sB, den * s.a.u),\n421\t                c2Mulvs(s.b.sB, den * s.b.u),\n422\t            );\n423\t        }\n424\t        3 => {\n425\t            *a = c2Add(\n426\t                c2Add(\n427\t                    c2Mulvs(s.a.sA, den * s.a.u),\n428\t                    c2Mulvs(s.b.sA, den * s.b.u),\n429\t                ),\n430\t                c2Mulvs(s.c.sA, den * s.c.u),\n431\t            );\n432\t            *b = c2Add(\n433\t                c2Add(\n434\t                    c2Mulvs(s.a.sB, den * s.a.u),\n435\t                    c2Mulvs(s.b.sB, den * s.b.u),\n436\t                ),\n437\t                c2Mulvs(s.c.sB, den * s.c.u),\n438\t            );\n439\t        }\n440\t        _ => {\n441\t            *a = c2V(0.0, 0.0);\n442\t            *b = c2V(0.0, 0.0);\n443\t        }\n444\t    }\n445\t}\n446\t\n447\t#[inline]\n448\tfn c2Div(a: c2v, b: f32) -> c2v {\n449\t    c2Mulvs(a, 1.0 / b)\n450\t}\n451\t\n452\t#[inline]\n453\tfn c2Norm(a: c2v) -> c2v {\n454\t    c2Div(a, c2Len(a))\n455\t}\n456\t\n457\tfn c2L(s: &c2Simplex) -> c2v {\n458\t    let den = 1.0f32 / s.div;\n459\t    match s.count {\n460\t        1 => s.a.p,\n461\t        2 => c2Add(\n462\t            c2Mulvs(s.a.p, den * s.a.u),\n463\t            c2Mulvs(s.b.p, den * s.b.u),\n464\t        ),\n465\t        _ => c2V(0.0, 0.0),\n466\t    }\n467\t}\n468\t\n469\t#[inline]\n470\tfn c2MulrvT(a: c2r, b: c2v) -> c2v {\n471\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n472\t}\n473\t\n474\tunsafe fn c2GJK(\n475\t    a_shape: *const c_void,\n476\t    type_a: C2_TYPE,\n477\t    ax_ptr: *const c2x,\n478\t    b_shape: *const c_void,\n479\t    type_b: C2_TYPE,\n480\t    bx_ptr: *const c2x,\n481\t    out_a: *mut c2v,\n482\t    out_b: *mut c2v,\n483\t    use_radius: c_int,\n484\t    iterations: *mut c_int,\n485\t    cache: *mut c2GJKCache,\n486\t) -> f32 {\n487\t    let ax: c2x = if ax_ptr.is_null() {\n488\t        c2xIdentity()\n489\t    } else {\n490\t        unsafe { *ax_ptr }\n491\t    };\n492\t    let bx: c2x = if bx_ptr.is_null() {\n493\t        c2xIdentity()\n494\t    } else {\n495\t        unsafe { *bx_ptr }\n496\t    };\n497\t\n498\t    let mut pA = c2Proxy::new();\n499\t    let mut pB = c2Proxy::new();\n500\t    unsafe {\n501\t        c2MakeProxy(a_shape, type_a, &mut pA);\n502\t        c2MakeProxy(b_shape, type_b, &mut pB);\n503\t    }\n504\t\n505\t    let mut s = c2Simplex::new();\n506\t    let mut cache_was_read = 0;\n507\t\n508\t    if !cache.is_null() {\n509\t        let cache_ref = unsafe { &*cache };\n510\t        let cache_was_good = cache_ref.count != 0;\n511\t        if cache_was_good {\n512\t            for i in 0..cache_ref.count as usize {\n513\t                let iA = cache_ref.iA[i];\n514\t                let iB = cache_ref.iB[i];\n515\t                let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n516\t                let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n517\t                let v = s.vert_mut(i);\n518\t                v.iA = iA;\n519\t                v.sA = sA;\n520\t                v.iB = iB;\n521\t                v.sB = sB;\n522\t                v.p = c2Sub(v.sB, v.sA);\n523\t                v.u = 0.0;\n524\t            }\n525\t            s.count = cache_ref.count;\n526\t            s.div = cache_ref.div;\n527\t            let metric_old =