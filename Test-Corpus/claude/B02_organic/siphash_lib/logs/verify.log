      .expect(\"nm -D\");","+        let s = String::from_utf8_lossy(&out.stdout);","+        let mut set = std::collections::BTreeSet::new();","+        for line in s.lines() {","+            // Format: \"<addr> <type> <name>\"","+            let parts: Vec<&str> = line.split_whitespace().collect();","+            if parts.len() < 3 {","+                continue;","+            }","+            let kind = parts[1];","+            let name = parts[2];","+            // Only public code/data symbols (T/D/B/R), skip linker internals.","+            if !matches!(kind, \"T\" | \"D\" | \"B\" | \"R\") {","+                continue;","+            }","+            if matches!(","+                name,","+                \"_init\"","+                    | \"_fini\"","+                    | \"__bss_start\"","+                    | \"_end\"","+                    | \"_edata\"","+                    | \"__TMC_END__\"","+            ) {","+                continue;","+            }","+            set.insert(name.to_string());","+        }","+        set","     }","-    unsafe fn libc_memfd_create(name: *const u8, flags: u32) -> i32 { memfd_create(name, flags) }","+","+    let c_syms = defined_symbols(&c_so_path());","+    let r_syms = defined_symbols(&rust_so_path());","+    let missing: Vec<&String> = c_syms.difference(&r_syms).collect();","+    assert!(","+        missing.is_empty(),","+        \"Rust .so is missing C-exported symbols: {:?}\",","+        missing","+    );"," }"]}],"originalFile":"// Integration test: compares the C .so to the Rust .so via libloading.\n// We never call Rust functions directly — we always go through the cdylib's\n// exported `extern \"C\"` symbols, exactly like a foreign caller would.\n\nuse libloading::{Library, Symbol};\nuse std::path::PathBuf;\nuse std::sync::Once;\n\ntype StbdsHashBytesFn = unsafe extern \"C\" fn(*const u8, usize, usize) -> usize;\ntype SiphashFn = unsafe extern \"C\" fn(i32);\n\nfn project_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_so_path() -> PathBuf {\n    project_root().join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_so_path() -> PathBuf {\n    // tests/ run from CARGO_MANIFEST_DIR. The cdylib output lands in target/debug.\n    let target_dir = std::env::var(\"CARGO_TARGET_DIR\")\n        .map(PathBuf::from)\n        .unwrap_or_else(|_| project_root().join(\"target\"));\n\n    // Cargo runs integration tests with the matching profile, but `cargo test`\n    // by default uses the `test` profile that re-uses `target/debug/`.\n    let candidates = [\n        target_dir.join(\"debug/libsiphash_lib.so\"),\n        target_dir.join(\"release/libsiphash_lib.so\"),\n    ];\n    for c in &candidates {\n        if c.exists() {\n            return c.clone();\n        }\n    }\n    candidates[0].clone()\n}\n\nfn build_artifacts() {\n    static ONCE: Once = Once::new();\n    ONCE.call_once(|| {\n        // Ensure the C .so exists.\n        if !c_so_path().exists() {\n            let build_dir = project_root().join(\"c_src/build\");\n            std::fs::create_dir_all(&build_dir).unwrap();\n            let _ = std::process::Command::new(\"cmake\")\n                .args([\"..\"])\n                .arg(\"-DCMAKE_POSITION_INDEPENDENT_CODE=ON\")\n                .current_dir(&build_dir)\n                .status()\n                .unwrap();\n            let _ = std::process::Command::new(\"cmake\")\n                .args([\"--build\", \".\"])\n                .current_dir(&build_dir)\n                .status()\n                .unwrap();\n        }\n        // Ensure the Rust cdylib exists. `cargo test` builds it, but if it\n        // somehow isn't there yet, force a build.\n        if !rust_so_path().exists() {\n            let _ = std::process::Command::new(\"cargo\")\n                .args([\"build\"])\n                .current_dir(project_root())\n                .status()\n                .unwrap();\n        }\n    });\n}\n\nunsafe fn load_libs() -> (Library, Library) {\n    build_artifacts();\n    let c = Library::new(c_so_path()).expect(\"load C .so\");\n    let r = Library::new(rust_so_path()).expect(\"load Rust .so\");\n    (c, r)\n}\n\n#[test]\nfn compare_stbds_hash_bytes_empty() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<StbdsHashBytesFn> = c.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<StbdsHashBytesFn> = r.get(b\"stbds_hash_bytes\").unwrap();\n\n        // Empty input, several seeds.\n        for &seed in &[0usize, 1, 0x12345, usize::MAX, usize::MAX / 2] {\n            let cv = c_fn(std::ptr::null(), 0, seed);\n            let rv = r_fn(std::ptr::null(), 0, seed);\n            assert_eq!(cv, rv, \"len=0 seed={:#x}\", seed);\n        }\n    }\n}\n\n#[test]\nfn compare_stbds_hash_bytes_short_lengths() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<StbdsHashBytesFn> = c.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<StbdsHashBytesFn> = r.get(b\"stbds_hash_bytes\").unwrap();\n\n        // Test all lengths 0..=64 with several seeds and several content patterns.\n        let mut buffer = [0u8; 128];\n        for (seed_idx, &seed) in [0usize, 1, 0xDEAD_BEEF, usize::MAX].iter().enumerate() {\n            // Pattern: monotonically increasing bytes starting from some offset.\n            let start = (seed_idx as u8).wrapping_mul(7);\n            for (i, b) in buffer.iter_mut().enumerate() {\n                *b = (start as usize).wrapping_add(i) as u8;\n            }\n            for len in 0..=64usize {\n                let cv = c_fn(buffer.as_ptr(), len, seed);\n                let rv = r_fn(buffer.as_ptr(), len, seed);\n                assert_eq!(cv, rv, \"len={} seed={:#x}\", len, seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn compare_stbds_hash_bytes_high_bit_bytes() {\n    // The C implementation has implementation-defined sign-extension when\n    // a byte ≥ 0x80 is shifted into the sign bit of an int. Make sure we\n    // exercise that path.\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<StbdsHashBytesFn> = c.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<StbdsHashBytesFn> = r.get(b\"stbds_hash_bytes\").unwrap();\n\n        let buffer = [0xFFu8; 64];\n        for len in 0..=64usize {\n            let cv = c_fn(buffer.as_ptr(), len, 0);\n            let rv = r_fn(buffer.as_ptr(), len, 0);\n            assert_eq!(cv, rv, \"all-FF len={}\", len);\n        }\n\n        // Mixed pattern with high bytes specifically at d[3], d[4], d[5], d[6].\n        let mut buffer = [0u8; 64];\n        for i in 0..buffer.len() {\n            buffer[i] = if i % 4 == 3 { 0x80 } else { (i as u8) | 0x80 };\n        }\n        for len in 0..=64usize {\n            let cv = c_fn(buffer.as_ptr(), len, 0);\n            let rv = r_fn(buffer.as_ptr(), len, 0);\n            assert_eq!(cv, rv, \"high-bit-pattern len={}\", len);\n        }\n    }\n}\n\n#[test]\nfn compare_stbds_hash_bytes_random_inputs() {\n    // Pseudo-random content using a small LCG so the test is deterministic.\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<StbdsHashBytesFn> = c.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<StbdsHashBytesFn> = r.get(b\"stbds_hash_bytes\").unwrap();\n\n        let mut state: u64 = 0xC0FFEE_BABE;\n        let mut buffer = vec![0u8; 256];\n        for trial in 0..100 {\n            for b in buffer.iter_mut() {\n                state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n                *b = (state >> 33) as u8;\n            }\n            for &len in &[0usize, 1, 2, 3, 7, 8, 9, 15, 16, 17, 31, 32, 63, 64, 100, 200, 256] {\n                state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n                let seed = state as usize;\n                let cv = c_fn(buffer.as_ptr(), len, seed);\n                let rv = r_fn(buffer.as_ptr(), len, seed);\n                assert_eq!(cv, rv, \"trial={} len={} seed={:#x}\", trial, len, seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn compare_siphash_stdout() {\n    // The `siphash` exported function writes formatted output via printf to\n    // stdout. Capture both implementations by redirecting fd 1.\n    use std::io::{Read, Seek, SeekFrom, Write};\n    use std::os::fd::{AsRawFd, FromRawFd};\n\n    fn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n        // Flush Rust stdout buffer.\n        let _ = std::io::stdout().flush();\n\n        // Save the current fd 1.\n        let saved = unsafe { libc_dup(1) };\n        assert!(saved >= 0, \"dup\");\n\n        // Make a tempfile and dup2 it onto fd 1.\n        let mut tmp = tempfile_or_memfile();\n        let tmp_fd = tmp.as_raw_fd();\n        let rc = unsafe { libc_dup2(tmp_fd, 1) };\n        assert!(rc >= 0, \"dup2\");\n\n        f();\n\n        // Make sure libc has flushed everything written via printf.\n        unsafe { libc_fflush_stdout() };\n\n        // Restore stdout.\n        let rc = unsafe { libc_dup2(saved, 1) };\n        assert!(rc >= 0, \"dup2 restore\");\n        unsafe { libc_close(saved) };\n\n        // Read what was captured.\n        tmp.seek(SeekFrom::Start(0)).unwrap();\n        let mut buf = Vec::new();\n        tmp.read_to_end(&mut buf).unwrap();\n        buf\n    }\n\n    fn tempfile_or_memfile() -> std::fs::File {\n        // Use an in-memory file via memfd_create on Linux; fall back to a tmpfile.\n        unsafe {\n            let name = b\"siphash-capture\\0\";\n            let fd = libc_memfd_create(name.as_ptr(), 0);\n            if fd >= 0 {\n                return std::fs::File::from_raw_fd(fd);\n            }\n        }\n        tempfile::tempfile().expect(\"tempfile\")\n    }\n\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<SiphashFn> = c.get(b\"siphash\").unwrap();\n        let r_fn: Symbol<SiphashFn> = r.get(b\"siphash\").unwrap();\n\n        for &init in &[0i32, 1, 7, 42, -1, 100] {\n            let c_out = capture_stdout(|| c_fn(init));\n            let r_out = capture_stdout(|| r_fn(init));\n            assert_eq!(c_out, r_out, \"siphash output mismatch for init={}\", init);\n        }\n    }\n\n    // Tiny libc bindings used above.\n    extern \"C\" {\n        fn dup(oldfd: i32) -> i32;\n        fn dup2(oldfd: i32, newfd: i32) -> i32;\n        fn close(fd: i32) -> i32;\n        fn fflush(stream: *mut core::ffi::c_void) -> i32;\n        fn memfd_create(name: *const u8, flags: u32) -> i32;\n    }\n    extern \"C\" {\n        // stdout is a global FILE* in libc.\n        static stdout: *mut core::ffi::c_void;\n    }\n\n    unsafe fn libc_dup(fd: i32) -> i32 { dup(fd) }\n    unsafe fn libc_dup2(o: i32, n: i32) -> i32 { dup2(o, n) }\n    unsafe fn libc_close(fd: i32) -> i32 { close(fd) }\n    unsafe fn libc_fflush_stdout() {\n        fflush(stdout);\n    }\n    unsafe fn libc_memfd_create(name: *const u8, flags: u32) -> i32 { memfd_create(name, flags) }\n}\n","userModified":false}}
