          }\n            for len in 0..=64usize {\n                let cv = c_fn(buffer.as_ptr(), len, seed);\n                let rv = r_fn(buffer.as_ptr(), len, seed);\n                assert_eq!(cv, rv, \"len={} seed={:#x}\", len, seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn compare_stbds_hash_bytes_high_bit_bytes() {\n    // The C implementation has implementation-defined sign-extension when\n    // a byte ≥ 0x80 is shifted into the sign bit of an int.\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<StbdsHashBytesFn> = c.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<StbdsHashBytesFn> = r.get(b\"stbds_hash_bytes\").unwrap();\n\n        let buffer = [0xFFu8; 64];\n        for len in 0..=64usize {\n            let cv = c_fn(buffer.as_ptr(), len, 0);\n            let rv = r_fn(buffer.as_ptr(), len, 0);\n            assert_eq!(cv, rv, \"all-FF len={}\", len);\n        }\n\n        let mut buffer = [0u8; 64];\n        for i in 0..buffer.len() {\n            buffer[i] = if i % 4 == 3 { 0x80 } else { (i as u8) | 0x80 };\n        }\n        for len in 0..=64usize {\n            let cv = c_fn(buffer.as_ptr(), len, 0);\n            let rv = r_fn(buffer.as_ptr(), len, 0);\n            assert_eq!(cv, rv, \"high-bit-pattern len={}\", len);\n        }\n    }\n}\n\n#[test]\nfn compare_stbds_hash_bytes_random_inputs() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<StbdsHashBytesFn> = c.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<StbdsHashBytesFn> = r.get(b\"stbds_hash_bytes\").unwrap();\n\n        let mut state: u64 = 0xC0FFEE_BABE;\n        let mut buffer = vec![0u8; 256];\n        for trial in 0..100 {\n            for b in buffer.iter_mut() {\n                state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n                *b = (state >> 33) as u8;\n            }\n            for &len in &[0usize, 1, 2, 3, 7, 8, 9, 15, 16, 17, 31, 32, 63, 64, 100, 200, 256] {\n                state = state\n                    .wrapping_mul(6364136223846793005)\n                    .wrapping_add(1442695040888963407);\n                let seed = state as usize;\n                let cv = c_fn(buffer.as_ptr(), len, seed);\n                let rv = r_fn(buffer.as_ptr(), len, seed);\n                assert_eq!(cv, rv, \"trial={} len={} seed={:#x}\", trial, len, seed);\n            }\n        }\n    }\n}\n\n// `siphash` writes through libc's printf. We capture stdout via dup/dup2 to a\n// memfd, then read back what was written. This verifies that the Rust cdylib\n// wrapper produces byte-identical output to the C version.\n#[test]\nfn compare_siphash_stdout() {\n    use std::io::{Read, Seek, SeekFrom};\n    use std::os::fd::FromRawFd;\n\n    extern \"C\" {\n        fn dup(oldfd: i32) -> i32;\n        fn dup2(oldfd: i32, newfd: i32) -> i32;\n        fn close(fd: i32) -> i32;\n        fn memfd_create(name: *const u8, flags: u32) -> i32;\n        fn fflush(stream: *mut core::ffi::c_void) -> i32;\n    }\n\n    fn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n        unsafe {\n            // Flush libc's stdout (we'll be redirecting it).\n            fflush(core::ptr::null_mut());\n\n            let saved = dup(1);\n            assert!(saved >= 0, \"dup failed\");\n\n            let name = b\"siphash-capture\\0\";\n            let memfd = memfd_create(name.as_ptr(), 0);\n            assert!(memfd >= 0, \"memfd_create failed\");\n\n            assert!(dup2(memfd, 1) >= 0, \"dup2 to memfd failed\");\n\n            f();\n\n            // Flush whatever was written to stdout via libc.\n            fflush(core::ptr::null_mut());\n\n            assert!(dup2(saved, 1) >= 0, \"dup2 restore failed\");\n            close(saved);\n\n            let mut file = std::fs::File::from_raw_fd(memfd);\n            file.seek(SeekFrom::Start(0)).unwrap();\n            let mut buf = Vec::new();\n            file.read_to_end(&mut buf).unwrap();\n            buf\n        }\n    }\n\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<SiphashFn> = c.get(b\"siphash\").unwrap();\n        let r_fn: Symbol<SiphashFn> = r.get(b\"siphash\").unwrap();\n\n        for &init in &[0i32, 1, 7, 42, -1, 100] {\n            let c_out = capture_stdout(|| c_fn(init));\n            let r_out = capture_stdout(|| r_fn(init));\n            assert_eq!(\n                c_out, r_out,\n                \"siphash output mismatch for init={}\",\n                init\n            );\n        }\n    }\n}\n\n#[test]\nfn rust_so_exports_all_c_symbols() {\n    // Sanity check: every public symbol that the C .so exports must also be\n    // exported by the Rust .so. Use `nm -D` and diff the lists.\n    build_artifacts();\n\n    fn defined_symbols(path: &std::path::Path) -> std::collections::BTreeSet<String> {\n        let out = std::process::Command::new(\"nm\")\n            .args([\"-D\", \"--defined-only\"])\n            .arg(path)\n            .output()\n            .expect(\"nm -D\");\n        let s = String::from_utf8_lossy(&out.stdout);\n        let mut set = std::collections::BTreeSet::new();\n        for line in s.lines() {\n            // Format: \"<addr> <type> <name>\"\n            let parts: Vec<&str> = line.split_whitespace().collect();\n            if parts.len() < 3 {\n                continue;\n            }\n            let kind = parts[1];\n            let name = parts[2];\n            // Only public code/data symbols (T/D/B/R), skip linker internals.\n            if !matches!(kind, \"T\" | \"D\" | \"B\" | \"R\") {\n                continue;\n            }\n            if matches!(\n                name,\n                \"_init\"\n                    | \"_fini\"\n                    | \"__bss_start\"\n                    | \"_end\"\n                    | \"_edata\"\n                    | \"__TMC_END__\"\n            ) {\n                continue;\n            }\n            set.insert(name.to_string());\n        }\n        set\n    }\n\n    let c_syms = defined_symbols(&c_so_path());\n    let r_syms = defined_symbols(&rust_so_path());\n    let missing: Vec<&String> = c_syms.difference(&r_syms).collect();\n    assert!(\n        missing.is_empty(),\n        \"Rust .so is missing C-exported symbols: {:?}\",\n        missing\n    );\n}\n","structuredPatch":[{"oldStart":18,"oldLines":13,"newStart":18,"newLines":9,"lines":[" }"," "," fn rust_so_path() -> PathBuf {","-    // tests/ run from CARGO_MANIFEST_DIR. The cdylib output lands in target/debug.","     let target_dir = std::env::var(\"CARGO_TARGET_DIR\")","         .map(PathBuf::from)","         .unwrap_or_else(|_| project_root().join(\"target\"));","-","-    // Cargo runs integration tests with the matching profile, but `cargo test`","-    // by default uses the `test` profile that re-uses `target/debug/`.","     let candidates = [","         target_dir.join(\"debug/libsiphash_lib.so\"),","         target_dir.join(\"release/libsiphash_lib.so\"),"]},{"oldStart":40,"oldLines":7,"newStart":36,"newLines":6,"lines":[" fn build_artifacts() {","     static ONCE: Once = Once::new();","     ONCE.call_once(|| {","-        // Ensure the C .so exists.","         if !c_so_path().exists() {","             let build_dir = project_root().join(\"c_src/build\");","             std::fs::create_dir_all(&build_dir).unwrap();"]},{"oldStart":56,"oldLines":8,"newStart":51,"newLines":6,"lines":["                 .status()","                 .unwrap();","         }","-        // Ensure the Rust cdylib exists. `cargo test` builds it, but if it","-        // somehow isn't there yet, force a build.","         if !rust_so_path().exists() {","             let _ = std::process::Command::new(\"cargo\")","                 .args([\"build\"])"]},{"oldStart":82,"oldLines":7,"newStart":75,"newLines":6,"lines":["         let c_fn: Symbol<StbdsHashBytesFn> = c.get(b\"stbds_hash_bytes\").unwrap();","         let r_fn: Symbol<StbdsHashBytesFn> = r.get(b\