{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MZvZjf3gVWQ8SBEgoRVX3R","type":"tool_result","content":"1\t//! Translation of c_src/src/lib.c to Rust.\n2\t//!\n3\t//! This crate exposes `parse_uname_string` as a C ABI symbol matching the C\n4\t//! implementation. All allocations made for OUT pointers use libc::malloc /\n5\t//! strdup-equivalents so that the caller can free them with libc::free, exactly\n6\t//! like the original C code.\n7\t\n8\tuse libc::{c_char, c_int, c_void, size_t};\n9\t\n10\t// We don't use the regex_t / regmatch_t / regcomp / regexec / regfree symbols\n11\t// from libc directly because those are not exposed on every platform. We\n12\t// declare what we need with extern \"C\" blocks. The original C uses POSIX\n13\t// regex with REG_EXTENDED.\n14\t//\n15\t// On glibc, REG_EXTENDED == 1.\n16\tconst REG_EXTENDED: c_int = 1;\n17\t\n18\t// Opaque-enough representation of regex_t. The actual size differs across\n19\t// libc implementations; we use a buffer that is large enough for glibc /\n20\t// musl / BSD. glibc's regex_t is 64 bytes on 64-bit; we use 256 to be very\n21\t// safe across libc implementations.\n22\t#[repr(C)]\n23\tstruct RegexT {\n24\t    _opaque: [u8; 256],\n25\t}\n26\t\n27\t#[repr(C)]\n28\t#[derive(Copy, Clone)]\n29\tstruct RegmatchT {\n30\t    rm_so: libc::regoff_t,\n31\t    rm_eo: libc::regoff_t,\n32\t}\n33\t\n34\textern \"C\" {\n35\t    fn regcomp(preg: *mut RegexT, pattern: *const c_char, cflags: c_int) -> c_int;\n36\t    fn regexec(\n37\t        preg: *const RegexT,\n38\t        string: *const c_char,\n39\t        nmatch: size_t,\n40\t        pmatch: *mut RegmatchT,\n41\t        eflags: c_int,\n42\t    ) -> c_int;\n43\t    fn regfree(preg: *mut RegexT);\n44\t\n45\t    // FILE-handle-bearing stderr stream and fprintf. We mirror the original\n46\t    // C code which uses fprintf(stderr, ...).\n47\t    static stderr: *mut libc::FILE;\n48\t    fn fprintf(stream: *mut libc::FILE, format: *const c_char, ...) -> c_int;\n49\t}\n50\t\n51\t/// Mirrors the C `os_data` struct exactly.\n52\t#[repr(C)]\n53\tpub struct OsData {\n54\t    pub os_name: *mut c_char,\n55\t    pub os_version: *mut c_char,\n56\t    pub os_major: *mut c_char,\n57\t    pub os_minor: *mut c_char,\n58\t    pub os_codename: *mut c_char,\n59\t    pub os_platform: *mut c_char,\n60\t    pub os_build: *mut c_char,\n61\t    pub os_uname: *mut c_char,\n62\t    pub os_arch: *mut c_char,\n63\t}\n64\t\n65\t// ---------------------------------------------------------------------------\n66\t// Internal helpers — reproduce libc behaviors used by the C source.\n67\t// ---------------------------------------------------------------------------\n68\t\n69\t/// Equivalent to `strlen`.\n70\tunsafe fn c_strlen(s: *const c_char) -> usize {\n71\t    let mut n = 0usize;\n72\t    while *s.add(n) != 0 {\n73\t        n += 1;\n74\t    }\n75\t    n\n76\t}\n77\t\n78\t/// Equivalent to `strdup` — allocates with libc::malloc so caller can free().\n79\tunsafe fn c_strdup(s: *const c_char) -> *mut c_char {\n80\t    let len = c_strlen(s);\n81\t    let p = libc::malloc(len + 1) as *mut c_char;\n82\t    if p.is_null() {\n83\t        return p;\n84\t    }\n85\t    libc::memcpy(p as *mut c_void, s as *const c_void, len + 1);\n86\t    p\n87\t}\n88\t\n89\t/// Equivalent to `strstr`.\n90\tunsafe fn c_strstr(haystack: *const c_char, needle: *const c_char) -> *mut c_char {\n91\t    let nlen = c_strlen(needle);\n92\t    if nlen == 0 {\n93\t        return haystack as *mut c_char;\n94\t    }\n95\t    let hlen = c_strlen(haystack);\n96\t    if nlen > hlen {\n97\t        return std::ptr::null_mut();\n98\t    }\n99\t    for i in 0..=(hlen - nlen) {\n100\t        if libc::memcmp(\n101\t            haystack.add(i) as *const c_void,\n102\t            needle as *const c_void,\n103\t            nlen,\n104\t        ) == 0\n105\t        {\n106\t            return haystack.add(i) as *mut c_char;\n107\t        }\n108\t    }\n109\t    std::ptr::null_mut()\n110\t}\n111\t\n112\t/// Implements the same `snprintf(dst, size+1, \"%.*s\", size, src)` pattern used\n113\t/// in the C source. Copies exactly `size` bytes (or until NUL inside src) and\n114\t/// always NUL-terminates within `size + 1` capacity.\n115\tunsafe fn copy_field(dst: *mut c_char, src: *const c_char, size: usize) {\n116\t    // %.*s prints up to `size` bytes from `src`, stopping at the first NUL.\n117\t    // snprintf with buffer of size+1 will write at most `size` chars, then NUL.\n118\t    let mut written = 0usize;\n119\t    while written < size {\n120\t        let b = *src.add(written);\n121\t        if b == 0 {\n122\t            break;\n123\t        }\n124\t        *dst.add(written) = b;\n125\t        written += 1;\n126\t    }\n127\t    *dst.add(written) = 0;\n128\t}\n129\t\n130\t// ---------------------------------------------------------------------------\n131\t// Translated functions.\n132\t// ---------------------------------------------------------------------------\n133\t\n134\t/// Looks for the OS architecture in a string. Possible architectures are\n135\t/// x86_64, i386, i686, sparc, amd64, ia64, AIX, armv6, armv7. The function\n136\t/// returns a pointer to allocated memory that must be freed by the caller.\n137\t///\n138\t/// Returns NULL if not found.\n139\tunsafe fn get_os_arch(os_header: *const c_char) -> *mut c_char {\n140\t    // NUL-terminated C strings, in the same order as the C source. Note that\n141\t    // the C array contains literal pointers so we mirror by referencing static\n142\t    // C strings.\n143\t    static ARCHS: &[&[u8]] = &[\n144\t        b\"x86_64\\0\",\n145\t        b\"i386\\0\",\n146\t        b\"i686\\0\",\n147\t        b\"sparc\\0\",\n148\t        b\"amd64\\0\",\n149\t        b\"i86pc\\0\",\n150\t        b\"ia64\\0\",\n151\t        b\"AIX\\0\",\n152\t        b\"armv6\\0\",\n153\t        b\"armv7\\0\",\n154\t        b\"aarch64\\0\",\n155\t        b\"arm64\\0\",\n156\t    ];\n157\t\n158\t    let mut os_arch: *mut c_