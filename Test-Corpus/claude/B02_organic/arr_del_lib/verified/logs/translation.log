_strreset(&a);\n  printf(\"reset ok storage=%d\\n\", a.storage==NULL);\n\n  /* mixed sizes, dedicated-block path, with the arena initially empty */\n  memset(&a, 0, sizeof(a));\n  char *big = (char*) malloc(70000);\n  memset(big, 'z', 69999); big[69999] = 0;\n  char *p1 = stbds_stralloc(&a, big);\n  printf(\"bigfirst block=%u remaining=%zu len=%zu\\n\", (unsigned)a.block, a.remaining, strlen(p1));\n  char *p2 = stbds_stralloc(&a, \"short\");\n  printf(\"then short block=%u remaining=%zu s=%s\\n\", (unsigned)a.block, a.remaining, p2);\n  big[5000] = 0;\n  char *p3 = stbds_stralloc(&a, big);\n  printf(\"big2 block=%u remaining=%zu len=%zu\\n\", (unsigned)a.block, a.remaining, strlen(p3));\n  char *p4 = stbds_stralloc(&a, \"tail\");\n  printf(\"tail block=%u remaining=%zu s=%s same_block=%d\\n\", (unsigned)a.block, a.remaining, p4, (p4 > p2 - 4096 && p4 < p2 + 4096));\n  stbds_strreset(&a);\n  free(big);\n}\n\n/* ---------------------------------------------- direct generic map API use */\ntypedef struct { char key[12]; int pad; int value; } gmap_t;\n\nstatic void test_generic_direct(void)\n{\n  hdr(\"generic direct\");\n  void *h = NULL;   /* \"hash pointer\" as returned by the put/get functions */\n  size_t elemsize = sizeof(gmap_t);\n  printf(\"elemsize=%zu\\n\", elemsize);\n  for (int i=0; i < 100; ++i) {\n    char key[12];\n    memset(key, 0, 12);\n    sprintf(key, \"g%d\", i);\n    h = stbds_hmput_key(h, elemsize, key, 12, STBDS_HM_BINARY);\n    gmap_t *tbl = (gmap_t *) h;\n    ptrdiff_t t = stbds_header((char*)h - elemsize)->temp;\n    memcpy(tbl[t].key, key, 12);\n    tbl[t].value = i * 5;\n    tbl[t].pad = i;\n  }\n  {\n    void *raw = (char*)h - elemsize;\n    printf(\"length=%zu cap=%zu\\n\", stbds_header(raw)->length, stbds_header(raw)->capacity);\n  }\n  for (int i=0; i < 100; i += 9) {\n    char key[12];\n    memset(key, 0, 12);\n    sprintf(key, \"g%d\", i);\n    h = stbds_hmget_key(h, elemsize, key, 12, STBDS_HM_BINARY);\n    ptrdiff_t t = stbds_header((char*)h - elemsize)->temp;\n    gmap_t *tbl = (gmap_t *) h;\n    printf(\"get %s -> t=%td v=%d pad=%d\\n\", key, t, t >= 0 ? tbl[t].value : -1, t >= 0 ? tbl[t].pad : -1);\n  }\n  for (int i=0; i < 100; i += 7) {\n    char key[12];\n    memset(key, 0, 12);\n    sprintf(key, \"g%d\", i);\n    h = stbds_hmdel_key(h, elemsize, key, 12, 0, STBDS_HM_BINARY);\n    printf(\"del %s -> temp=%td len=%zu\\n\", key, stbds_header((char*)h-elemsize)->temp,\n           stbds_header((char*)h-elemsize)->length);\n  }\n  {\n    gmap_t *tbl = (gmap_t *) h;\n    ptrdiff_t n = (ptrdiff_t) stbds_header((char*)h-elemsize)->length - 1;\n    for (ptrdiff_t i=0; i < n; ++i) printf(\"row %td: %s %d %d\\n\", i, tbl[i].key, tbl[i].pad, tbl[i].value);\n  }\n  stbds_hmfree_func((char*)h - elemsize, elemsize);\n}\n\n/* ------------------------------------------ unaligned / odd-length hashing */\nstatic void test_hash_unaligned(void)\n{\n  hdr(\"hash unaligned\");\n  static unsigned char big[300];\n  for (int i=0; i < 300; ++i) big[i] = (unsigned char)((i*i*7+i) & 0xff);\n  for (int off=0; off < 9; ++off)\n    for (size_t len=0; len <= 33; ++len)\n      printf(\"hu[%d][%zu]=%016zx\\n\", off, len, stbds_hash_bytes(big+off, len, 0xabcdef));\n  for (size_t len=0; len <= 300; len += 7)\n    printf(\"hl[%zu]=%016zx\\n\", len, stbds_hash_bytes(big, len, 0));\n}\n'''\ns = s.replace('static void run(int t)', extra + '\\nstatic void run(int t)')\ns = s.replace('    case 12: test_stress(); break;',\n'''    case 12: test_stress(); break;\n    case 13: test_defaults(); break;\n    case 14: test_arena_limit(); break;\n    case 15: test_generic_direct(); break;\n    case 16: test_hash_unaligned(); break;''')\ns = s.replace('for (int i=0; i <= 12; ++i) run(i);', 'for (int i=0; i <= 16; ++i) run(i);')\nopen('main.c','w').write(s)\nprint(\"ok\")\nPYEOF\ngcc -O1 -std=gnu11 -I. main.c -o run_c -L$TMPDIR/cbuild -ltranslated_rust -Wl,-rpath,$TMPDIR/cbuild 2>&1 | head -20; echo \"build=$?\"","description":"Add edge-case