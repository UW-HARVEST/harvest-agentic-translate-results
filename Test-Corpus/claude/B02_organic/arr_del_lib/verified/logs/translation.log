{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_gvyc7vw4d6awyodpxhltoggxbqocwijqhm64udlxvtgbzegm66fq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Tjcpdrh4QJZUpwPGoLtHBc","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-translate-Wi2ono/tmp/vt/main.c","content":"/* Differential test harness: exercises every exported symbol of the library\n   and prints a deterministic transcript.  Linked once against the C .so and\n   once against the Rust .so; the transcripts must be byte identical. */\n#include <stdio.h>\n#include \"stbds_api.h\"\n\ntypedef struct { int key, b, c, d; } stbds_struct;\ntypedef struct { int key[2], b, c, d; } stbds_struct2;\n\ntypedef struct { int key; int value; } ivmap;\ntypedef struct { char *key; int value; } svmap;\ntypedef struct { stbds_struct key; int value; } stmap;\n\nstatic void hdr(const char *s) { printf(\"\\n=== %s ===\\n\", s); }\n\n/* ---------------------------------------------------------------- hashing */\nstatic void test_hash_string(void)\n{\n  hdr(\"hash_string\");\n  char *strs[] = { \"\", \"a\", \"ab\", \"abc\", \"test_0\", \"test_12345\",\n                   \"\\xff\\xfe\\x80\\x7f\", \"the quick brown fox jumps over the lazy dog\",\n                   \"\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08\\x09\", \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" };\n  size_t seeds[] = { 0, 1, 2, 0x31415926u, 0xdeadbeefu, (size_t)-1,\n                     0x0123456789abcdefull, 0x8000000000000000ull };\n  for (unsigned i=0; i < sizeof(strs)/sizeof(*strs); ++i)\n    for (unsigned j=0; j < sizeof(seeds)/sizeof(*seeds); ++j)\n      printf(\"hs[%u][%u] = %016zx\\n\", i, j, stbds_hash_string(strs[i], seeds[j]));\n}\n\nstatic void test_hash_bytes(void)\n{\n  hdr(\"hash_bytes\");\n  unsigned char buf[64];\n  for (int i=0; i < 64; ++i) buf[i] = (unsigned char)(i*37+11);\n  size_t seeds[] = { 0, 1, 0x31415926u, (size_t)-1, 0x0123456789abcdefull };\n  for (size_t len=0; len <= 64; ++len)\n    for (unsigned j=0; j < sizeof(seeds)/sizeof(*seeds); ++j)\n      printf(\"hb[%zu][%u] = %016zx\\n\", len, j, stbds_hash_bytes(buf, len, seeds[j]));\n\n  /* bytes with the high bit set at every position (sign-extension quirks) */\n  for (int k=0; k < 8; ++k) {\n    unsigned char b2[16];\n    memset(b2, 0, sizeof(b2));\n    b2[k] = 0xff;\n    for (size_t len=1; len <= 12; ++len)\n      printf(\"hbx[%d][%zu] = %016zx\\n\", k, len, stbds_hash_bytes(b2, len, 0x1234));\n  }\n  /* all-0xff buffers */\n  {\n    unsigned char b3[16];\n    memset(b3, 0xff, sizeof(b3));\n    for (size_t len=0; len <= 16; ++len)\n      printf(\"hbf[%zu] = %016zx\\n\", len, stbds_hash_bytes(b3, len, 99));\n  }\n  /* ints and pointers like the map code does */\n  for (int v = -5; v < 5; ++v)\n    printf(\"hbi[%d] = %016zx\\n\", v, stbds_hash_bytes(&v, sizeof(v), 7));\n}\n\n/* ------------------------------------------------------------------ arrays */\nstatic void test_arrays(void)\n{\n  hdr(\"arrays\");\n  int *a = NULL;\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  for (int i=0; i < 1000; ++i) arrput(a, i*i);\n  printf(\"len=%td cap=%zu last=%d\\n\", arrlen(a), arrcap(a), arrlast(a));\n  long long sum=0; for (int i=0; i < arrlen(a); ++i) sum += a[i];\n  printf(\"sum=%lld\\n\", sum);\n  for (int i=0; i < 500; ++i) (void)arrpop(a);\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrins(a, 10, 12345);\n  arrinsn(a, 20, 5);\n  for (int i=0; i < 5; ++i) a[20+i] = 700+i;\n  arrdel(a, 3);\n  arrdeln(a, 100, 7);\n  arrdelswap(a, 4);\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  for (int i=0; i < arrlen(a); i += 37) printf(\"a[%d]=%d\\n\", i, a[i]);\n  arrsetlen(a, 3000);\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetcap(a, 5000);\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetlen(a, 10);\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  {\n    int idx = (int) arraddnindex(a, 17);\n    int *p = arraddnptr(a, 3);\n    ptrdiff_t d = p - a;\n    printf(\"addnindex=%d len=%td cap=%zu ptrdelta=%td\\n\", idx, arrlen(a), arrcap(a), d);\n    arraddn(a, 4);\n    printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  }\n  arrfree(a);\n  printf(\"after free: len=%td cap=%zu ptr_null=%d\\n\", arrlen(a), arrcap(a), a==NULL);\n\n  /* growth pattern of arrgrowf */\n  {\n    void *g = NULL;\n    for (int i=0; i < 20; ++i) {\n      g = stbds_arrgrowf(g, 8, 1, 0);\n      stbds_header(g)->length += 1;\n      printf(\"grow %d: len=%zu cap=%zu\\n\", i, stbds_header(g)->length, stbds_header(g)->capacity);\n    }\n    stbds_arrfreef(g);\n  }\n  {\n    void *g = NULL;\n    g = stbds_arrgrowf(g, 4, 0, 1);   printf(\"g1 cap=%zu len=%zu\\n\", stbds_header(g)->capacity, stbds_header(g)->length);\n    g = stbds_arrgrowf(g, 4, 3, 0);   printf(\"g2 cap=%zu\\n\", stbds_header(g)->capacity);\n    g = stbds_arrgrowf(g, 4, 0, 100); printf(\"g3 cap=%zu\\n\", stbds_header(g)->capacity);\n    g = stbds_arrgrowf(g, 4, 0, 50);  printf(\"g4 cap=%zu\\n\", stbds_header(g)->capacity);\n    g = stbds_arrgrowf(g, 4, 400, 0); printf(\"g5 cap=%zu\\n\", stbds_header(g)->capacity);\n    stbds_arrfreef(g);\n  }\n}\n\n/* ---------------------------------------------------------------- int maps */\nstatic void test_intmap(int n)\n{\n  hdr(\"intmap\");\n  ivmap *m = NULL;\n  hmdefault(m, -777);\n  for (int i=0; i < n; ++i) hmput(m, i*3, i*i+1);\n  printf(\"hmlen=%td hmlenu=%zu\\n\", hmlen(m), hmlenu(m));\n  for (int i=0; i < n; i += 7) {\n    int v = hmget(m, i*3);\n    ptrdiff_t ix = hmgeti(m, i*3);\n    printf(\"get %d -> %d (i=%td)\\n\", i*3, v, ix);\n  }\n  for (int i=0; i < 20; ++i) {\n    int v = hmget(m, i+1);\n    ptrdiff_t ix = hmgeti(m, i+1);\n    int isnull = hmgetp_null(m, i+1) == NULL;\n    printf(\"miss %d -> %d idx=%td null=%d\\n\", i, v, ix, isnull);\n  }\n  /* raw array order is hash dependent: dump it all */\n  for (int i=0; i <= hmlen(m); ++i) printf(\"slot %d: k=%d v=%d\\n\", i, m[i].key, m[i].value);\n  /* delete every third key */\n  for (int i=0; i < n; i += 3) {\n    ptrdiff_t r = hmdel(m, i*3);\n    printf(\"del %d -> %td\\n\", i*3, r);\n  }\n  printf(\"hmlen=%td\\n\", hmlen(m));\n  for (int i=0; i <= hmlen(m); ++i) printf(\"slot2 %d: k=%d v=%d\\n\", i, m[i].key, m[i].value);\n  for (int i=0; i < n; ++i) {\n    ptrdiff_t t;\n    int v = hmget_ts(m, i*3, t);\n    printf(\"ts %d -> %d %td\\n\", i*3, v, t);\n  }\n  /* re-insert */\n  for (int i=0; i < n; i += 3) hmput(m, i*3, -i);\n  printf(\"hmlen=%td\\n\", hmlen(m));\n  for (int i=0; i <= hmlen(m); ++i) printf(\"slot3 %d: k=%d v=%d\\n\", i, m[i].key, m[i].value);\n  hmfree(m);\n  printf(\"freed: %d len=%td\\n\", m==NULL, hmlen(m));\n}\n\nstatic void test_structmap(void)\n{\n  hdr(\"structmap\");\n  stmap *map = NULL;\n  stbds_struct s;\n  for (int i=0; i < 200; ++i) {\n    s.key = i; s.b = i*2; s.c = i*3; s.d = i*4;\n    hmput(map, s, i+1000);\n  }\n  printf(\"len=%td\\n\", hmlen(map));\n  for (int i=0; i < 200; i += 11) {\n    s.key = i; s.b = i*2; s.c = i*3; s.d = i*4;\n    int v = hmget(map, s);\n    ptrdiff_t ix = hmgeti(map, s);\n    printf(\"get %d -> %d idx=%td\\n\", i, v, ix);\n  }\n  for (int i=0; i < 200; i += 11) {\n    s.key = i; s.b = i*2+1; s.c = i*3; s.d = i*4;   /* different key bytes */\n    ptrdiff_t ix = hmgeti(map, s);\n    printf(\"miss %d -> idx=%td\\n\", i, ix);\n  }\n  for (int i=0; i <= hmlen(map); ++i)\n    printf(\"row %d: %d %d %d %d -> %d\\n\", i, map[i].key.key, map[i].key.b, map[i].key.c, map[i].key.d, map[i].value);\n  for (int i=0; i < 200; i += 3) {\n    s.key = i; s.b = i*2; s.c = i*3; s.d = i*4;\n    ptrdiff_t r = hmdel(map, s);\n    printf(\"del %d -> %td\\n\", i, r);\n  }\n  printf(\"len=%td\\n\", hmlen(map));\n  for (int i=0; i <= hmlen(map); ++i)\n    printf(\"row2 %d: %d %d -> %d\\n\", i, map[i].key.key, map[i].key.b, map[i].value);\n  hmfree(map);\n\n  /* hmputs / hmgets / hmdefaults */\n  {\n    ivmap *m2 = NULL;\n    ivmap e;\n    e.key = 5; e.value = 50; hmputs(m2, e);\n    e.key = 6; e.value = 60; hmputs(m2, e);\n    e.key = -1; e.value = -1; hmdefaults(m2, e);\n    int a = hmgets(m2,5).value;\n    int b = hmgets(m2,6).value;\n    int c = hmgets(m2,77).value;\n    printf(\"gets5=%d gets6=%d getsX=%d len=%td\\n\", a, b, c, hmlen(m2));\n    hmfree(m2);\n  }\n}\n\n/* ------------------------------------------------------------- string maps */\nstatic char keybuf[5000][16];\n\nstatic void test_strmap_default(void)\n{\n  hdr(\"strmap default\");\n  svmap *m = NULL;\n  for (int i=0; i < 400; ++i) sprintf(keybuf[i], \"key_%d\", i);\n  for (int i=0; i < 400; ++i) shput(m, keybuf[i], i);\n  printf(\"len=%td\\n\", shlen(m));\n  for (int i=0; i < 400; i += 13) {\n    int v = shget(m, keybuf[i]);\n    ptrdiff_t ix = shgeti(m, keybuf[i]);\n    printf(\"get %s -> %d idx=%td\\n\", keybuf[i], v, ix);\n  }\n  for (int i=0; i < 3; ++i) {\n    ptrdiff_t ix = shgeti(m, \"nope\");\n    int isnull = shgetp_null(m, \"nope\") == NULL;\n    printf(\"miss -> %td %d\\n\", ix, isnull);\n  }\n  for (int i=0; i <= shlen(m); ++i) printf(\"row %d: %s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  for (int i=0; i < 400; i += 5) {\n    ptrdiff_t r = shdel(m, keybuf[i]);\n    printf(\"del %s -> %td\\n\", keybuf[i], r);\n  }\n  printf(\"len=%td\\n\", shlen(m));\n  for (int i=0; i <= shlen(m); ++i) printf(\"row2 %d: %s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  for (int i=0; i < 400; ++i) {\n    ptrdiff_t ix = shgeti(m, keybuf[i]);\n    printf(\"g2 %d -> %td\\n\", i, ix);\n  }\n  shfree(m);\n  printf(\"freed=%d\\n\", m==NULL);\n}\n\nstatic void test_strmap_strdup(void)\n{\n  hdr(\"strmap strdup\");\n  svmap *m = NULL;\n  sh_new_strdup(m);\n  char tmp[32];\n  for (int i=0; i < 300; ++i) { sprintf(tmp, \"dup_%d\", i); shput(m, tmp, i*2); }\n  printf(\"len=%td\\n\", shlen(m));\n  for (int i=0; i < 300; i += 9) {\n    sprintf(tmp, \"dup_%d\", i);\n    int v = shget(m, tmp);\n    printf(\"get %s -> %d\\n\", tmp, v);\n  }\n  for (int i=0; i <= shlen(m); ++i) printf(\"row %d: %s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  for (int i=0; i < 300; i += 4) {\n    sprintf(tmp, \"dup_%d\", i);\n    ptrdiff_t r = shdel(m, tmp);\n    printf(\"del %s -> %td\\n\", tmp, r);\n  }\n  printf(\"len=%td\\n\", shlen(m));\n  for (int i=0; i <= shlen(m); ++i) printf(\"row2 %d: %s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  /* overwrite existing */\n  for (int i=1; i < 300; i += 4) { sprintf(tmp, \"dup_%d\", i); shput(m, tmp, -i); }\n  for (int i=0; i <= shlen(m); ++i) printf(\"row3 %d: %s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  shfree(m);\n}\n\nstatic void test_strmap_arena(void)\n{\n  hdr(\"strmap arena\");\n  svmap *m = NULL;\n  sh_new_arena(m);\n  static char tmp[700];\n  for (int i=0; i < 300; ++i) { sprintf(tmp, \"arena_%d\", i); shput(m, tmp, i*3); }\n  /* a few very long keys to hit the dedicated-block path */\n  for (int i=0; i < 5; ++i) {\n    memset(tmp, 'x'+i, 560);\n    tmp[549+i] = 0;\n    shput(m, tmp, 10000+i);\n  }\n  printf(\"len=%td\\n\", shlen(m));\n  for (int i=0; i < 300; i += 17) {\n    sprintf(tmp, \"arena_%d\", i);\n    int v = shget(m, tmp);\n    printf(\"get %s -> %d\\n\", tmp, v);\n  }\n  for (int i=0; i <= shlen(m); ++i) printf(\"row %d: %.12s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  for (int i=0; i < 300; i += 6) {\n    sprintf(tmp, \"arena_%d\", i);\n    ptrdiff_t r = shdel(m, tmp);\n    printf(\"del %s -> %td\\n\", tmp, r);\n  }\n  for (int i=0; i <= shlen(m); ++i) printf(\"row2 %d: %.12s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  shfree(m);\n}\n\nstatic void test_shputi_shputs(void)\n{\n  hdr(\"shputi/shputs\");\n  svmap *m = NULL;\n  for (int i=0; i < 64; ++i) sprintf(keybuf[i], \"k%d\", i);\n  for (int i=0; i < 64; ++i) {\n    ptrdiff_t r = shputi(m, keybuf[i], i);\n    printf(\"shputi %s -> %td\\n\", keybuf[i], r);\n  }\n  for (int i=0; i < 64; ++i) {\n    ptrdiff_t r = shputi(m, keybuf[i], -i);\n    printf(\"shputi again %s -> %td\\n\", keybuf[i], r);\n  }\n  {\n    svmap e;\n    e.key = keybuf[3]; e.value = 999; shputs(m, e);\n    int v = shget(m, \"k3\");\n    char *k = shgets(m,\"k3\").key;\n    printf(\"after shputs: %d %s\\n\", v, k);\n  }\n  for (int i=0; i <= shlen(m); ++i) printf(\"row %d: %s -> %d\\n\", i, m[i].key?m[i].key:\"(null)\", m[i].value);\n  shfree(m);\n\n  /* shdefault */\n  {\n    svmap *d = NULL;\n    shdefault(d, 4242);\n    int miss = shget(d, \"absent\");\n    printf(\"default miss=%d\\n\", miss);\n    shput(d, \"here\", 1);\n    int hit = shget(d,\"here\");\n    int miss2 = shget(d,\"absent\");\n    printf(\"hit=%d miss=%d len=%td\\n\", hit, miss2, shlen(d));\n    shfree(d);\n  }\n}\n\n/* ------------------------------------------------------------ string arena */\nstatic void test_arena_direct(void)\n{\n  hdr(\"stralloc\");\n  stbds_string_arena a;\n  memset(&a, 0, sizeof(a));\n  static char tmp[4096];\n  for (int i=0; i < 200; ++i) {\n    int n = (i*i*7) % 700;\n    memset(tmp, 'a' + (i%26), n);\n    tmp[n] = 0;\n    char *p = stbds_stralloc(&a, tmp);\n    printf(\"alloc %d len=%d block=%u remaining=%zu match=%d\\n\", i, n, (unsigned)a.block, a.remaining, strcmp(p,tmp)==0);\n  }\n  stbds_strreset(&a);\n  printf(\"reset: storage_null=%d remaining=%zu block=%u mode=%u\\n\", a.storage==NULL, a.remaining, (unsigned)a.block, (unsigned)a.mode);\n  /* empty strings */\n  memset(&a, 0, sizeof(a));\n  for (int i=0; i < 5; ++i) { char *p = stbds_stralloc(&a, \"\"); printf(\"e%d remaining=%zu empty=%d\\n\", i, a.remaining, *p=='\\0'); }\n  stbds_strreset(&a);\n}\n\n/* ------------------------------------------------------- raw API + seeding */\nstatic void test_raw_and_seed(void)\n{\n  hdr(\"raw api + seed\");\n  for (int trial=0; trial < 3; ++trial) {\n    stbds_rand_seed(trial == 0 ? 0x31415926u : (trial == 1 ? 12345u : 0xffffffffffffffffull));\n    ivmap *m = NULL;\n    for (int i=0; i < 300; ++i) hmput(m, i, i);\n    for (int i=0; i < 300; i += 2) hmdel(m, i);\n    for (int i=0; i < 150; ++i) hmput(m, 1000+i, i);\n    printf(\"trial %d len=%td\\n\", trial, hmlen(m));\n    for (int i=0; i <= hmlen(m); ++i) printf(\"t%d row %d: %d %d\\n\", trial, i, m[i].key, m[i].value);\n    hmfree(m);\n  }\n  stbds_rand_seed(0x31415926u);\n\n  /* hmput_default on a fresh and on an existing table */\n  {\n    void *p = stbds_hmput_default(NULL, 8);\n    printf(\"hmput_default len=%zu cap=%zu\\n\", stbds_header((char*)p-8)->length, stbds_header((char*)p-8)->capacity);\n    void *q = stbds_hmput_default(p, 8);\n    printf(\"same=%d\\n\", p==q);\n    stbds_hmfree_func((char*)p-8, 8);\n  }\n  /* hmdel_key on NULL, hmget_key on NULL */\n  {\n    int k = 3;\n    void *dn = stbds_hmdel_key(NULL, 8, &k, 4, 0, STBDS_HM_BINARY);\n    printf(\"del NULL -> %d\\n\", dn == NULL);\n    void *g = stbds_hmget_key(NULL, 8, &k, 4, STBDS_HM_BINARY);\n    printf(\"get NULL temp=%td len=%zu\\n\", stbds_header((char*)g-8)->temp, stbds_header((char*)g-8)->length);\n    printf(\"del no-table -> %d\\n\", stbds_hmdel_key(g, 8, &k, 4, 0, STBDS_HM_BINARY) == g);\n    stbds_hmfree_func((char*)g-8, 8);\n  }\n  /* shmode_func direct */\n  {\n    void *p = stbds_shmode_func(16, STBDS_SH_ARENA);\n    printf(\"shmode len=%zu\\n\", stbds_header((char*)p-16)->length);\n    stbds_hmfree_func((char*)p-16, 16);\n  }\n  /* hmget_key_ts on an empty table */\n  {\n    int k = 7;\n    ptrdiff_t t = 99;\n    void *g = stbds_hmget_key_ts(NULL, 8, &k, 4, &t, STBDS_HM_BINARY);\n    printf(\"ts null temp=%td\\n\", t);\n    t = 99;\n    g = stbds_hmget_key_ts(g, 8, &k, 4, &t, STBDS_HM_BINARY);\n    printf(\"ts empty temp=%td\\n\", t);\n    stbds_hmfree_func((char*)g-8, 8);\n  }\n}\n\n/* ------------------------------------------------------------ public tests */\nstatic void test_public(void)\n{\n  hdr(\"public helpers\");\n  for (int i=-3; i < 5; ++i) printf(\"strkey(%d)=%s\\n\", i, strkey(i));\n  printf(\"strkey(-2147483648)=%s\\n\", strkey(-2147483647-1));\n  printf(\"strkey(2147483647)=%s\\n\", strkey(2147483647));\n  printf(\"strkey(1000000)=%s\\n\", strkey(1000000));\n  for (int i=0; i < 5; ++i) { arr_del(i); printf(\"arr_del(%d) ok\\n\", i); }\n  arr_del(-99);\n  printf(\"arr_del done\\n\");\n}\n\n/* --------------------------------------------------------- big stress test */\nstatic void test_stress(void)\n{\n  hdr(\"stress\");\n  ivmap *m = NULL;\n  int n = 20000;\n  for (int i=0; i < n; ++i) hmput(m, i*17+3, i);\n  for (int i=0; i < n; i += 2) hmdel(m, i*17+3);\n  for (int i=0; i < n; i += 4) hmput(m, i*17+3, -i);\n  long long checksum = 0;\n  for (int i=0; i <= hmlen(m); ++i) checksum += (long long)m[i].key * 31 + m[i].value;\n  printf(\"len=%td checksum=%lld\\n\", hmlen(m), checksum);\n  for (int i=0; i < n; ++i) {\n    ptrdiff_t idx = hmgeti(m, i*17+3);\n    if (i % 997 == 0) printf(\"s %d -> %td\\n\", i, idx);\n  }\n  hmfree(m);\n\n  svmap *sm = NULL;\n  for (int i=0; i < 5000; ++i) sprintf(keybuf[i], \"test_%d\", i);\n  for (int i=0; i < 5000; ++i) shput(sm, keybuf[i], i);\n  printf(\"shlen=%td\\n\", shlen(sm));\n  for (int i=0; i < 5000; i += 311) {\n    int v = shget(sm, keybuf[i]);\n    printf(\"sg %d -> %d\\n\", i, v);\n  }\n  for (int i=0; i < 5000; i += 3) shdel(sm, keybuf[i]);\n  printf(\"shlen=%td\\n\", shlen(sm));\n  {\n    long long cs = 0;\n    for (int i=0; i <= shlen(sm); ++i) cs += (long long)sm[i].value * 7 + (sm[i].key ? (unsigned char)sm[i].key[5] : 0);\n    printf(\"cs=%lld\\n\", cs);\n  }\n  shfree(sm);\n}\n\nint main(void)\n{\n  test_hash_string();\n  test_hash_bytes();\n  test_arrays();\n  test_intmap(500);\n  test_structmap();\n  test_strmap_default();\n  test_strmap_strdup();\n  test_strmap_arena();\n  test_shputi_shputs();\n  test_arena_direct();\n  test_raw_and_seed();\n  test_public();\n  test_stress();\n  printf(\"\\nALL DONE\\n\");\n  return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2580,"cache_read_input_tokens":95144,"cache_creation":{"ephemeral_5m_input_tokens":2580,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ce35fb8d-e170-4fd3-9894-b05775c273e5","uuid":"808b8014-1140-48ce-9edb-c550d95f7d3e","timestamp":"2026-08-20T02:22:36.101Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Tjcpdrh4QJZUpwPGoLtHBc","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-translate-Wi2ono/tmp/vt/main.c has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ce35fb8d-e170-4fd3-9894-b05775c273e5","uuid":"a2ce5bb1-85c3-4a3f-a5a6-a421176e4277","timestamp":"2026-08-20T02:22:36.121Z","tool_use_result":{"type":"update","filePath":"/local/home/scheschb/.harvest/work/harvest-translate-Wi2ono/tmp/vt/main.c","content":"/* Differential test harness: exercises every exported symbol of the library\n   and prints a deterministic transcript.  Linked once against the C .so and\n   once against the Rust .so; the transcripts must be byte identical. */\n#include <stdio.h>\n#include \"stbds_api.h\"\n\ntypedef struct { int key, b, c, d; } stbds_struct;\ntypedef struct { int key[2], b, c, d; } stbds_struct2;\n\ntypedef struct { int key; int value; } ivmap;\ntypedef struct { char *key; int value; } svmap;\ntypedef struct { stbds_struct key; int value; } stmap;\n\nstatic void hdr(const char *s) { printf(\"\\n=== %s ===\\n\", s); }\n\n/* ---------------------------------------------------------------- hashing */\nstatic void test_hash_string(void)\n{\n  hdr(\"hash_string\");\n  char *strs[] = { \"\", \"a\", \"ab\", \"abc\", \"test_0\", \"test_12345\",\n                   \"\\xff\\xfe\\x80\\x7f\", \"the quick brown fox jumps over the lazy dog\",\n                   \"\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08\\x09\", \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" };\n  size_t seeds[] = { 0, 1, 2, 0x31415926u, 0xdeadbeefu, (size_t)-1,\n                     0x0123456789abcdefull, 0x8000000000000000ull };\n  for (unsigned i=0; i < sizeof(strs)/sizeof(*strs); ++i)\n    for (unsigned j=0; j < sizeof(seeds)/sizeof(*seeds); ++j)\n      printf(\"hs[%u][%u] = %016zx\\n\", i, j, stbds_hash_string(strs[i], seeds[j]));\n}\n\nstatic void test_hash_bytes(void)\n{\n  hdr(\"hash_bytes\");\n  unsigned char buf[64];\n  for (int i=0; i < 64; ++i) buf[i] = (unsigned char)(i*37+11);\n  size_t seeds[] = { 0, 1, 0x31415926u, (size_t)-1, 0x0123456789abcdefull };\n  for (size_t len=0; len <= 64; ++len)\n    for (unsigned j=0; j < sizeof(seeds)/sizeof(*seeds); ++j)\n      printf(\"hb[%zu][%u] = %016zx\\n\", len, j, stbds_hash_bytes(buf, len, seeds[j]));\n\n  /* bytes with the high bit set at every position (sign-extension quirks) */\n  for (int k=0; k < 8; ++k) {\n    unsigned char b2[16];\n    memset(b2, 0, sizeof(b2));\n    b2[k] = 0xff;\n    for (size_t len=1; len <= 12; ++len)\n      printf(\"hbx[%d][%zu] = %016zx\\n\", k, len, stbds_hash_bytes(b2, len, 0x1234));\n  }\n  /* all-0xff buffers */\n  {\n    unsigned char b3[16];\n    memset(b3, 0xff, sizeof(b3));\n    for (size_t len=0; len <= 16; ++len)\n      printf(\"hbf[%zu] = %016zx\\n\", len, stbds_hash_bytes(b3, len, 99));\n  }\n  /* ints and pointers like the map code does */\n  for (int v = -5; v < 5; ++v)\n    printf(\"hbi[%d] = %016zx\\n\", v, stbds_hash_bytes(&v, sizeof(v), 7));\n}\n\n/* ------------------------------------------------------------------ arrays */\nstatic void test_arrays(void)\n{\n  hdr(\"arrays\");\n  int *a = NULL;\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  for (int i=0; i < 1000; ++i) arrput(a, i*i);\n  printf(\"len=%td cap=%zu last=%d\\n\", arrlen(a), arrcap(a), arrlast(a));\n  long long sum=0; for (int i=0; i < arrlen(a); ++i) sum += a[i];\n  printf(\"sum=%lld\\n\", sum);\n  for (int i=0; i < 500; ++i) (void)arrpop(a);\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrins(a, 10, 12345);\n  arrinsn(a, 20, 5);\n  for (int i=0; i < 5; ++i) a[20+i] = 700+i;\n  arrdel(a, 3);\n  arrdeln(a, 100, 7);\n  arrdelswap(a, 4);\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  for (int i=0; i < arrlen(a); i += 37) printf(\"a[%d]=%d\\n\", i, a[i]);\n  arrsetlen(a, 3000);\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetcap(a, 5000);\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetlen(a, 10);\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  {\n    int idx = (int) arraddnindex(a, 17);\n    int *p = arraddnptr(a, 3);\n    ptrdiff_t d = p - a;\n    printf(\"addnindex=%d len=%td cap=%zu ptrdelta=%td\\n\", idx, arrlen(a), arrcap(a), d);\n    arraddn(a, 4);\n    printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  }\n  arrfree(a);\n  printf(\"after free: len=%td cap=%zu ptr_null=%d\\n\", arrlen(a), arrcap(a), a==NULL);\n\n  /* growth pattern of arrgrowf */\n  {\n    void *g = NULL;\n    for (int i=0; i < 20; ++i) {\n      g = stbds_arrgrowf(g, 8, 1, 0);\n      stbds_header(g)->length += 1;\n      printf(\"grow %d: len=%zu cap=%zu\\n\", i, stbds_header(g)->length, stbds_header(g)->capacity);\n    }\n    stbds_arrfreef(g);\n  }\n  {\n    void *g = NULL;\n    g = stbds_arrgrowf(g, 4, 0, 1);   printf(\"g1 cap=%zu len=%zu\\n\", stbds_header(g)->capacity, stbds_header(g)->length);\n    g = stbds_arrgrowf(g, 4, 3, 0);   printf(\"g2 cap=%zu\\n\", stbds_header(g)->capacity);\n    g = stbds_arrgrowf(g, 4, 0, 100); printf(\"g3 cap=%zu\\n\", stbds_header(g)->capacity);\n    g = stbds_arrgrowf(g, 4, 0, 50);  printf(\"g4 cap=%zu\\n\", stbds_header(g)->capacity);\n    g = stbds_arrgrowf(g, 4, 400, 0); printf(\"g5 cap=%zu\\n\", stbds_header(g)->capacity);\n    stbds_arrfreef(g);\n  }\n}\n\n/* ---------------------------------------------------------------- int maps */\nstatic void test_intmap(int n)\n{\n  hdr(\"intmap\");\n  ivmap *m = NULL;\n  hmdefault(m, -777);\n  for (int i=0; i < n; ++i) hmput(m, i*3, i*i+1);\n  printf(\"hmlen=%td hmlenu=%zu\\n\", hmlen(m), hmlenu(m));\n  for (int i=0; i < n; i += 7) {\n    int v = hmget(m, i*3);\n    ptrdiff_t ix = hmgeti(m, i*3);\n    printf(\"get %d -> %d (i=%td)\\n\", i*3, v, ix);\n  }\n  for (int i=0; i < 20; ++i) {\n    int v = hmget(m, i+1);\n    ptrdiff_t ix = hmgeti(m, i+1);\n    int isnull = hmgetp_null(m, i+1) == NULL;\n    printf(\"miss %d -> %d idx=%td null=%d\\n\", i, v, ix, isnull);\n  }\n  /* raw array order is hash dependent: dump it all */\n  for (int i=0; i <= hmlen(m); ++i) printf(\"slot %d: k=%d v=%d\\n\", i, m[i].key, m[i].value);\n  /* delete every third key */\n  for (int i=0; i < n; i += 3) {\n    ptrdiff_t r = hmdel(m, i*3);\n    printf(\"del %d -> %td\\n\", i*3, r);\n  }\n  printf(\"hmlen=%td\\n\", hmlen(m));\n  for (int i=0; i <= hmlen(m); ++i) printf(\"slot2 %d: k=%d v=%d\\n\", i, m[i].key, m[i].value);\n  for (int i=0; i < n; ++i) {\n    ptrdiff_t t;\n    int v = hmget_ts(m, i*3, t);\n    printf(\"ts %d -> %d %td\\n\", i*3, v, t);\n  }\n  /* re-insert */\n  for (int i=0; i < n; i += 3) hmput(m, i*3, -i);\n  printf(\"hmlen=%td\\n\", hmlen(m));\n  for (int i=0; i <= hmlen(m); ++i) printf(\"slot3 %d: k=%d v=%d\\n\", i, m[i].key, m[i].value);\n  hmfree(m);\n  printf(\"freed: %d len=%td\\n\", m==NULL, hmlen(m));\n}\n\nstatic void test_structmap(void)\n{\n  hdr(\"structmap\");\n  stmap *map = NULL;\n  stbds_struct s;\n  for (int i=0; i < 200; ++i) {\n    s.key = i; s.b = i*2; s.c = i*3; s.d = i*4;\n    hmput(map, s, i+1000);\n  }\n  printf(\"len=%td\\n\", hmlen(map));\n  for (int i=0; i < 200; i += 11) {\n    s.key = i; s.b = i*2; s.c = i*3; s.d = i*4;\n    int v = hmget(map, s);\n    ptrdiff_t ix = hmgeti(map, s);\n    printf(\"get %d -> %d idx=%td\\n\", i, v, ix);\n  }\n  for (int i=0; i < 200; i += 11) {\n    s.key = i; s.b = i*2+1; s.c = i*3; s.d = i*4;   /* different key bytes */\n    ptrdiff_t ix = hmgeti(map, s);\n    printf(\"miss %d -> idx=%td\\n\", i, ix);\n  }\n  for (int i=0; i <= hmlen(map); ++i)\n    printf(\"row %d: %d %d %d %d -> %d\\n\", i, map[i].key.key, map[i].key.b, map[i].key.c, map[i].key.d, map[i].value);\n  for (int i=0; i < 200; i += 3) {\n    s.key = i; s.b = i*2; s.c = i*3; s.d = i*4;\n    ptrdiff_t r = hmdel(map, s);\n    printf(\"del %d -> %td\\n\", i, r);\n  }\n  printf(\"len=%td\\n\", hmlen(map));\n  for (int i=0; i <= hmlen(map); ++i)\n    printf(\"row2 %d: %d %d -> %d\\n\", i, map[i].key.key, map[i].key.b, map[i].value);\n  hmfree(map);\n\n  /* hmputs / hmgets / hmdefaults */\n  {\n    ivmap *m2 = NULL;\n    ivmap e;\n    e.key = 5; e.value = 50; hmputs(m2, e);\n    e.key = 6; e.value = 60; hmputs(m2, e);\n    e.key = -1; e.value = -1; hmdefaults(m2, e);\n    int a = hmgets(m2,5).value;\n    int b = hmgets(m2,6).value;\n    int c = hmgets(m2,77).value;\n    printf(\"gets5=%d gets6=%d getsX=%d len=%td\\n\", a, b, c, hmlen(m2));\n    hmfree(m2);\n  }\n}\n\n/* ------------------------------------------------------------- string maps */\nstatic char keybuf[5000][16];\n\nstatic void test_strmap_default(void)\n{\n  hdr(\"strmap default\");\n  svmap *m = NULL;\n  for (int i=0; i < 400; ++i) sprintf(keybuf[i], \"key_%d\", i);\n  for (int i=0; i < 400; ++i) shput(m, keybuf[i], i);\n  printf(\"len=%td\\n\", shlen(m));\n  for (int i=0; i < 400; i += 13) {\n    int v = shget(m, keybuf[i]);\n    ptrdiff_t ix = shgeti(m, keybuf[i]);\n    printf(\"get %s -> %d idx=%td\\n\", keybuf[i], v, ix);\n  }\n  for (int i=0; i < 3; ++i) {\n    ptrdiff_t ix = shgeti(m, \"nope\");\n    int isnull = shgetp_null(m, \"nope\") == NULL;\n    printf(\"miss -> %td %d\\n\", ix, isnull);\n  }\n  for (int i=0; i <= shlen(m); ++i) printf(\"row %d: %s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  for (int i=0; i < 400; i += 5) {\n    ptrdiff_t r = shdel(m, keybuf[i]);\n    printf(\"del %s -> %td\\n\", keybuf[i], r);\n  }\n  printf(\"len=%td\\n\", shlen(m));\n  for (int i=0; i <= shlen(m); ++i) printf(\"row2 %d: %s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  for (int i=0; i < 400; ++i) {\n    ptrdiff_t ix = shgeti(m, keybuf[i]);\n    printf(\"g2 %d -> %td\\n\", i, ix);\n  }\n  shfree(m);\n  printf(\"freed=%d\\n\", m==NULL);\n}\n\nstatic void test_strmap_strdup(void)\n{\n  hdr(\"strmap strdup\");\n  svmap *m = NULL;\n  sh_new_strdup(m);\n  char tmp[32];\n  for (int i=0; i < 300; ++i) { sprintf(tmp, \"dup_%d\", i); shput(m, tmp, i*2); }\n  printf(\"len=%td\\n\", shlen(m));\n  for (int i=0; i < 300; i += 9) {\n    sprintf(tmp, \"dup_%d\", i);\n    int v = shget(m, tmp);\n    printf(\"get %s -> %d\\n\", tmp, v);\n  }\n  for (int i=0; i <= shlen(m); ++i) printf(\"row %d: %s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  for (int i=0; i < 300; i += 4) {\n    sprintf(tmp, \"dup_%d\", i);\n    ptrdiff_t r = shdel(m, tmp);\n    printf(\"del %s -> %td\\n\", tmp, r);\n  }\n  printf(\"len=%td\\n\", shlen(m));\n  for (int i=0; i <= shlen(m); ++i) printf(\"row2 %d: %s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  /* overwrite existing */\n  for (int i=1; i < 300; i += 4) { sprintf(tmp, \"dup_%d\", i); shput(m, tmp, -i); }\n  for (int i=0; i <= shlen(m); ++i) printf(\"row3 %d: %s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  shfree(m);\n}\n\nstatic void test_strmap_arena(void)\n{\n  hdr(\"strmap arena\");\n  svmap *m = NULL;\n  sh_new_arena(m);\n  static char tmp[700];\n  for (int i=0; i < 300; ++i) { sprintf(tmp, \"arena_%d\", i); shput(m, tmp, i*3); }\n  /* a few very long keys to hit the dedicated-block path */\n  for (int i=0; i < 5; ++i) {\n    memset(tmp, 'x'+i, 560);\n    tmp[549+i] = 0;\n    shput(m, tmp, 10000+i);\n  }\n  printf(\"len=%td\\n\", shlen(m));\n  for (int i=0; i < 300; i += 17) {\n    sprintf(tmp, \"arena_%d\", i);\n    int v = shget(m, tmp);\n    printf(\"get %s -> %d\\n\", tmp, v);\n  }\n  for (int i=0; i <= shlen(m); ++i) printf(\"row %d: %.12s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  for (int i=0; i < 300; i += 6) {\n    sprintf(tmp, \"arena_%d\", i);\n    ptrdiff_t r = shdel(m, tmp);\n    printf(\"del %s -> %td\\n\", tmp, r);\n  }\n  for (int i=0; i <= shlen(m); ++i) printf(\"row2 %d: %.12s -> %d\\n\", i, m[i].key ? m[i].key : \"(null)\", m[i].value);\n  shfree(m);\n}\n\nstatic void test_shputi_shputs(void)\n{\n  hdr(\"shputi/shputs\");\n  svmap *m = NULL;\n  for (int i=0; i < 64; ++i) sprintf(keybuf[i], \"k%d\", i);\n  for (int i=0; i < 64; ++i) {\n    ptrdiff_t r = shputi(m, keybuf[i], i);\n    printf(\"shputi %s -> %td\\n\", keybuf[i], r);\n  }\n  for (int i=0; i < 64; ++i) {\n    ptrdiff_t r = shputi(m, keybuf[i], -i);\n    printf(\"shputi again %s -> %td\\n\", keybuf[i], r);\n  }\n  {\n    svmap e;\n    e.key = keybuf[3]; e.value = 999; shputs(m, e);\n    int v = shget(m, \"k3\");\n    char *k = shgets(m,\"k3\").key;\n    printf(\"after shputs: %d %s\\n\", v, k);\n  }\n  for (int i=0; i <= shlen(m); ++i) printf(\"row %d: %s -> %d\\n\", i, m[i].key?m[i].key:\"(null)\", m[i].value);\n  shfree(m);\n\n  /* shdefault */\n  {\n    svmap *d = NULL;\n    shdefault(d, 4242);\n    int miss = shget(d, \"absent\");\n    printf(\"default miss=%d\\n\", miss);\n    shput(d, \"here\", 1);\n    int hit = shget(d,\"here\");\n    int miss2 = shget(d,\"absent\");\n    printf(\"hit=%d miss=%d len=%td\\n\", hit, miss2, shlen(d));\n    shfree(d);\n  }\n}\n\n/* ------------------------------------------------------------ string arena */\nstatic void test_arena_direct(void)\n{\n  hdr(\"stralloc\");\n  stbds_string_arena a;\n  memset(&a, 0, sizeof(a));\n  static char tmp[4096];\n  for (int i=0; i < 200; ++i) {\n    int n = (i*i*7) % 700;\n    memset(tmp, 'a' + (i%26), n);\n    tmp[n] = 0;\n    char *p = stbds_stralloc(&a, tmp);\n    printf(\"alloc %d len=%d block=%u remaining=%zu match=%d\\n\", i, n, (unsigned)a.block, a.remaining, strcmp(p,tmp)==0);\n  }\n  stbds_strreset(&a);\n  printf(\"reset: storage_null=%d remaining=%zu block=%u mode=%u\\n\", a.storage==NULL, a.remaining, (unsigned)a.block, (unsigned)a.mode);\n  /* empty strings */\n  memset(&a, 0, sizeof(a));\n  for (int i=0; i < 5; ++i) { char *p = stbds_stralloc(&a, \"\"); printf(\"e%d remaining=%zu empty=%d\\n\", i, a.remaining, *p=='\\0'); }\n  stbds_strreset(&a);\n}\n\n/* ------------------------------------------------------- raw API + seeding */\nstatic void test_raw_and_seed(void)\n{\n  hdr(\"raw api + seed\");\n  for (int trial=0; trial < 3; ++trial) {\n    stbds_rand_seed(trial == 0 ? 0x31415926u : (trial == 1 ? 12345u : 0xffffffffffffffffull));\n    ivmap *m = NULL;\n    for (int i=0; i < 300; ++i) hmput(m, i, i);\n    for (int i=0; i < 300; i += 2) hmdel(m, i);\n    for (int i=0; i < 150; ++i) hmput(m, 1000+i, i);\n    printf(\"trial %d len=%td\\n\", trial, hmlen(m));\n    for (int i=0; i <= hmlen(m); ++i) printf(\"t%d row %d: %d %d\\n\", trial, i, m[i].key, m[i].value);\n    hmfree(m);\n  }\n  stbds_rand_seed(0x31415926u);\n\n  /* hmput_default on a fresh and on an existing table */\n  {\n    void *p = stbds_hmput_default(NULL, 8);\n    printf(\"hmput_default len=%zu cap=%zu\\n\", stbds_header((char*)p-8)->length, stbds_header((char*)p-8)->capacity);\n    void *q = stbds_hmput_default(p, 8);\n    printf(\"same=%d\\n\", p==q);\n    stbds_hmfree_func((char*)p-8, 8);\n  }\n  /* hmdel_key on NULL, hmget_key on NULL */\n  {\n    int k = 3;\n    void *dn = stbds_hmdel_key(NULL, 8, &k, 4, 0, STBDS_HM_BINARY);\n    printf(\"del NULL -> %d\\n\", dn == NULL);\n    void *g = stbds_hmget_key(NULL, 8, &k, 4, STBDS_HM_BINARY);\n    printf(\"get NULL temp=%td len=%zu\\n\", stbds_header((char*)g-8)->temp, stbds_header((char*)g-8)->length);\n    printf(\"del no-table -> %d\\n\", stbds_hmdel_key(g, 8, &k, 4, 0, STBDS_HM_BINARY) == g);\n    stbds_hmfree_func((char*)g-8, 8);\n  }\n  /* shmode_func direct */\n  {\n    void *p = stbds_shmode_func(16, STBDS_SH_ARENA);\n    printf(\"shmode len=%zu\\n\", stbds_header((char*)p-16)->length);\n    stbds_hmfree_func((char*)p-16, 16);\n  }\n  /* hmget_key_ts on an empty table */\n  {\n    int k = 7;\n    ptrdiff_t t = 99;\n    void *g = stbds_hmget_key_ts(NULL, 8, &k, 4, &t, STBDS_HM_BINARY);\n    printf(\"ts null temp=%td\\n\", t);\n    t = 99;\n    g = stbds_hmget_key_ts(g, 8, &k, 4, &t, STBDS_HM_BINARY);\n    printf(\"ts empty temp=%td\\n\", t);\n    stbds_hmfree_func((char*)g-8, 8);\n  }\n}\n\n/* ------------------------------------------------------------ public tests */\nstatic void test_public(void)\n{\n  hdr(\"public helpers\");\n  for (int i=-3; i < 5; ++i) printf(\"strkey(%d)=%s\\n\", i, strkey(i));\n  printf(\"strkey(-2147483648)=%s\\n\", strkey(-2147483647-1));\n  printf(\"strkey(2147483647)=%s\\n\", strkey(2147483647));\n  printf(\"strkey(1000000)=%s\\n\", strkey(1000000));\n  for (int i=0; i < 5; ++i) { arr_del(i); printf(\"arr_del(%d) ok\\n\", i); }\n  arr_del(-99);\n  printf(\"arr_del done\\n\");\n}\n\n/* --------------------------------------------------------- big stress test */\nstatic void test_stress(void)\n{\n  hdr(\"stress\");\n  ivmap *m = NULL;\n  int n = 20000;\n  for (int i=0; i < n; ++i) hmput(m, i*17+3, i);\n  for (int i=0; i < n; i += 2) hmdel(m, i*17+3);\n  for (int i=0; i < n; i += 4) hmput(m, i*17+3, -i);\n  long long checksum = 0;\n  for (int i=0; i <= hmlen(m); ++i) checksum += (long long)m[i].key * 31 + m[i].value;\n  printf(\"len=%td checksum=%lld\\n\", hmlen(m), checksum);\n  for (int i=0; i < n; ++i) {\n    ptrdiff_t idx = hmgeti(m, i*17+3);\n    if (i % 997 == 0) printf(\"s %d -> %td\\n\", i, idx);\n  }\n  hmfree(m);\n\n  svmap *sm = NULL;\n  for (int i=0; i < 5000; ++i) sprintf(keybuf[i], \"test_%d\", i);\n  for (int i=0; i < 5000; ++i) shput(sm, keybuf[i], i);\n  printf(\"shlen=%td\\n\", shlen(sm));\n  for (int i=0; i < 5000; i += 311) {\n    int v = shget(sm, keybuf[i]);\n    printf(\"sg %d -> %d\\n\", i, v);\n  }\n  for (int i=0; i < 5000; i += 3) shdel(sm, keybuf[i]);\n  printf(\"shlen=%td\\n\", shlen(sm));\n  {\n    long long cs = 0;\n    for (int i=0; i <= shlen(sm); ++i) cs += (long long)sm[i].value * 7 + (sm[i].key ? (unsigned char)sm[i].key[5] : 0);\n    printf(\"cs=%lld\\n\", cs);\n  }\n  shfree(sm);\n}\n\nint main(void)\n{\n  test_hash_string();\n  test_hash_bytes();\n  test_arrays();\n  test_intmap(500);\n  test_structmap();\n  test_strmap_default();\n  test_strmap_strdup()