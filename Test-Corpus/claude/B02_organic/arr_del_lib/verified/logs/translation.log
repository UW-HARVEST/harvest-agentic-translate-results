}\n}\n\n/* ------------------------------------------------------------ public tests */\nstatic void test_public(void)\n{\n  hdr(\"public helpers\");\n  for (int i=-3; i < 5; ++i) printf(\"strkey(%d)=%s\\n\", i, strkey(i));\n  printf(\"strkey(-2147483648)=%s\\n\", strkey(-2147483647-1));\n  printf(\"strkey(2147483647)=%s\\n\", strkey(2147483647));\n  printf(\"strkey(1000000)=%s\\n\", strkey(1000000));\n  for (int i=0; i < 5; ++i) { arr_del(i); printf(\"arr_del(%d) ok\\n\", i); }\n  arr_del(-99);\n  printf(\"arr_del done\\n\");\n}\n\n/* --------------------------------------------------------- big stress test */\nstatic void test_stress(void)\n{\n  hdr(\"stress\");\n  struct { int key; int value; } *m = NULL;\n  int n = 20000;\n  for (int i=0; i < n; ++i) hmput(m, i*17+3, i);\n  for (int i=0; i < n; i += 2) hmdel(m, i*17+3);\n  for (int i=0; i < n; i += 4) hmput(m, i*17+3, -i);\n  long long checksum = 0;\n  for (int i=0; i <= hmlen(m); ++i) checksum += (long long)m[i].key * 31 + m[i].value;\n  printf(\"len=%td checksum=%lld\\n\", hmlen(m), checksum);\n  for (int i=0; i < n; ++i) { ptrdiff_t idx = hmgeti(m, i*17+3); if (i % 997 == 0) printf(\"s %d -> %td\\n\", i, idx); }\n  hmfree(m);\n\n  struct { char *key; int value; } *sm = NULL;\n  for (int i=0; i < 5000; ++i) shput(sm, strkey(i), i);\n  printf(\"shlen=%td\\n\", shlen(sm));\n  for (int i=0; i < 5000; i += 311) printf(\"sg %d -> %d\\n\", i, shget(sm, strkey(i)));\n  for (int i=0; i < 5000; i += 3) shdel(sm, strkey(i));\n  printf(\"shlen=%td\\n\", shlen(sm));\n  {\n    long long cs = 0;\n    for (int i=0; i <= shlen(sm); ++i) cs += (long long)sm[i].value * 7 + (sm[i].key ? (unsigned char)sm[i].key[5] : 0);\n    printf(\"cs=%lld\\n\", cs);\n  }\n  shfree(sm);\n}\n\nint main(void)\n{\n  test_hash_string();\n  test_hash_bytes();\n  test_arrays();\n  test_intmap(500);\n  test_structmap();\n  test_strmap_default();\n  test_strmap_strdup();\n  test_strmap_arena();\n  test_shputi_shputs();\n  test_arena_direct();\n  test_