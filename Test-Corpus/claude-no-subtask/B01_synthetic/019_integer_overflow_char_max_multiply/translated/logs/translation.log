}\n\n    if x != 0 {\n        good();\n    } else {\n        bad();\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":133,"cache_read_input_tokens":17949,"cache_creation":{"ephemeral_5m_input_tokens":133,"ephemeral_1h_input_tokens":0},"output_tokens":44,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"26002ea6-5a40-4475-913d-0475d8601fb7","uuid":"eb1a92e9-ee8b-47e5-8b2e-97a846bf5d5e"}
