(input[i] - b'0') as i64;\n        if !overflow {\n            value = value.saturating_mul(10).saturating_add(d);\n            if negative {\n                if -value < i32::MIN as i64 {\n                    overflow = true;\n                }\n            } else {\n                if value > i32::MAX as i64 {\n                    overflow = true;\n                }\n            }\n        }\n        i += 1;\n    }\n\n    let result: i32 = if negative {\n        if overflow {\n            i32::MIN\n        } else {\n            (-value) as i32\n        }\n    } else {\n        if overflow {\n            i32::MAX\n        } else {\n            value as i32\n        }\n    };\n\n    (result, true)\n}\n\nfn main() {\n    let mut buf = Vec::new();\n    io::stdin().read_to_end(&mut buf).unwrap();\n\n    let mut x: i32 = 0;\n    let (parsed, ok) = scanf_int(&buf);\n    if ok {\n        x = parsed;\n    }\n\n    let stdout = io::stdout();\n    let mut out = BufWriter::new(stdout.lock());\n    driver(&mut out, x);\n    out.flush().unwrap();\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
