 a.r * a.r;\n    (d2 < r2) as c_int\n}\n\nfn c2_aabb_to_aabb(a: c2AABB, b: c2AABB) -> c_int {\n    let d0 = (b.max.x < a.min.x) as i32;\n    let d1 = (a.max.x < b.min.x) as i32;\n    let d2 = (b.max.y < a.min.y) as i32;\n    let d3 = (a.max.y < b.min.y) as i32;\n    (!((d0 | d1 | d2 | d3) != 0)) as c_int\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn collided(\n    a: *const c_void,\n    type_a: C2_TYPE,\n    b: *const c_void,\n    type_b: C2_TYPE,\n) -> c_int {\n    match type_a {\n        C2_TYPE_CIRCLE => match type_b {\n            C2_TYPE_CIRCLE => {\n                c2_circle_to_circle(*(a as *const c2Circle), *(b as *const c2Circle))\n            }\n            C2_TYPE_AABB => c2_circle_to_aabb(*(a as *const c2Circle), *(b as *const c2AABB)),\n            _ => 0,\n        },\n        C2_TYPE_AABB => match type_b {\n            C2_TYPE_CIRCLE => {\n                c2_circle_to_aabb(*(b as *const c2Circle), *(a as *const c2AABB))\n            }\n            C2_TYPE_AABB => c2_aabb_to_aabb(*(a as *const c2AABB), *(b as *const c2AABB)),\n            _ => 0,\n        },\n        _ => 0,\n    }\n}\n","structuredPatch":[{"oldStart":99,"oldLines":21,"newStart":99,"newLines":25,"lines":["     b: *const c_void,","     type_b: C2_TYPE,"," ) -> c_int {","-    match type_a {","-        C2_TYPE_CIRCLE => match type_b {","-            C2_TYPE_CIRCLE => {","-                c2_circle_to_circle(*(a as *const c2Circle), *(b as *const c2Circle))","-            }","-            C2_TYPE_AABB => c2_circle_to_aabb(*(a as *const c2Circle), *(b as *const c2AABB)),","+    unsafe {","+        match type_a {","+            C2_TYPE_CIRCLE => match type_b {","+                C2_TYPE_CIRCLE => {","+                    c2_circle_to_circle(*(a as *const c2Circle), *(b as *const c2Circle))","+                }","+                C2_TYPE_AABB => {","+                    c2_circle_to_aabb(*(a as *const c2Circle), *(b as *const c2AABB))","+                }","+                _ => 0,","