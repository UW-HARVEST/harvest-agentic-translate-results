fn main() {\n    let mut input = Vec::new();\n    let _ = io::stdin().read_to_end(&mut input);\n\n    let mut pos = 0usize;\n    let mut x: i32 = 0;\n    if let Some(v) = scanf_int(&input, &mut pos) {\n        x = v;\n    }\n    driver(x);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
