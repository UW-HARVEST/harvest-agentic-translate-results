    }\n}\n\nfn c2L(s: &c2Simplex) -> c2v {\n    let den = 1.0 / s.div;\n    match s.count {\n        1 => s.a.p,\n        2 => c2Add(\n            c2Mulvs(s.a.p, den * s.a.u),\n            c2Mulvs(s.b.p, den * s.b.u),\n        ),\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n// access simplex vertex by index (0..3)\nfn simplex_vert<'a>(s: &'a c2Simplex, i: usize) -> &'a c2sv {\n    match i {\n        0 => &s.a,\n        1 => &s.b,\n        2 => &s.c,\n        _ => &s.d,\n    }\n}\n\nfn simplex_vert_mut<'a>(s: &'a mut c2Simplex, i: usize) -> &'a mut c2sv {\n    match i {\n        0 => &mut s.a,\n        1 => &mut s.b,\n        2 => &mut s.c,\n        _ => &mut s.d,\n    }\n}\n\n#[allow(clippy::too_many_arguments)]\nunsafe fn c2GJK(\n    A: *const c_void,\n    typeA: C2_TYPE,\n    ax_ptr: *const c2x,\n    B: *const c_void,\n    typeB: C2_TYPE,\n    bx_ptr: *const c2x,\n    outA: *mut c2v,\n    outB: *mut c2v,\n    use_radius: c_int,\n    iterations: *mut c_int,\n    cache: *mut c2GJKCache,\n) -> f32 {\n    let ax = if ax_ptr.is_null() {\n        c2xIdentity()\n    } else {\n        unsafe { *ax_ptr }\n    };\n    let bx = if bx_ptr.is_null() {\n        c2xIdentity()\n    } else {\n        unsafe { *bx_ptr }\n    };\n    let mut pA = c2Proxy {\n        radius: 0.0,\n        count: 0,\n        verts: [c2V(0.0, 0.0); 8],\n    };\n    let mut pB = c2Proxy {\n        radius: 0.0,\n        count: 0,\n        verts: [c2V(0.0, 0.0); 8],\n    };\n    unsafe {\n        c2MakeProxy(A, typeA, &mut pA);\n        c2MakeProxy(B, typeB, &mut pB);\n    }\n    let zero_sv = c2sv {\n        sA: c2V(0.0, 0.0),\n        sB: c2V(0.0, 0.0),\n        p: c2V(0.0, 0.0),\n        u: 0.0,\n        iA: 0,\n        iB: 0,\n    };\n    let mut s = c2Simplex {\n        a: zero_sv,\n        b: zero_sv,\n        c: zero_sv,\n        d: zero_sv,\n        div: 0.0,\n        count: 0,\n    };\n\n    let mut cache_was_read = 0;\n    if !cache.is_null() {\n        let cache_was_good = unsafe { (*cache).count }