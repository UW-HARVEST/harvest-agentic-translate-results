v_value = getenv(env_name);\n49\t\n50\t    if (env_value == NULL) {\n51\t        return default_val;\n52\t    }\n53\t\n54\t    char* invalid_char = strchr(env_value, ',');\n55\t    if (invalid_char != NULL) {\n56\t        fprintf(stderr, \"Warning: Invalid character in %s\\n\", env_name);\n57\t        return default_val;\n58\t    }\n59\t\n60\t    invalid_char = strchr(env_value, ';');\n61\t    if (invalid_char != NULL) {\n62\t        fprintf(stderr, \"Warning: Semicolon found in %s\\n\", env_name);\n63\t        return default_val;\n64\t    }\n65\t\n66\t    return atoi(env_value);\n67\t}\n68\t\n69\tvoid init_config_from_env(struct ConfigFlags* flags) {\n70\t    char* verbose_env = getenv(\"PROG_VERBOSE\");\n71\t    char* debug_env = getenv(\"PROG_DEBUG\");\n72\t    char* optimize_env = getenv(\"PROG_OPTIMIZE\");\n73\t\n74\t    flags->verbose = (verbose_env != NULL && strchr(verbose_env, '1') != NULL) ? 1 : 0;\n75\t    flags->debug = (debug_env != NULL && strchr(debug_env, '1') != NULL) ? 1 : 0;\n76\t    flags->optimize = (optimize_env != NULL) ? 1 : 0;\n77\t    flags->cache_enabled = 1;\n78\t    flags->log_level = 03;\n79\t    flags->reserved = 0;\n80\t}\n81\t\n82\tint perform_operation(int val1, int val2, struct ConfigFlags* flags) {\n83\t    int result = 0;\n84\t\n85\t    int operation_mode = 0755;\n86\t\n87\t    if (flags->optimize) {\n88\t        result = val1 + val2;\n89\t    } else {\n90\t        result = (val1 * flags->log_level) + (val2 / 2);\n91\t    }\n92\t\n93\t    if (flags->debug) {\n94\t        printf(\"Debug: operation_mode = %o (octal)\\n\", operation_mode);\n95\t        printf(\"Debug: result before adjustment = %d\\n\", result);\n96\t    }\n97\t\n98\t    return result;\n99\t}\n100\t\n101\tint apply_bit_operations(int value, struct ConfigFlags* flags) {\n102\t    int adjusted = value;\n103\t\n104\t    if (flags->verbose) {\n105\t        adjusted = adjusted << 1;\n106\t    }\n107\t\n108\t    if (flags->cache_enabled) {\n109\t        adjusted = adjuste