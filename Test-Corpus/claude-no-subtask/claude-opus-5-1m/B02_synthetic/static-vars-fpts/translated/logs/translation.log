n// Parse integer from string the way C's sscanf(\"%d\", ...) does.\n// Skip leading whitespace, optional sign, then digits.\n// Returns None if no digits found.\nfn parse_int(input: &[u8]) -> Option<i32> {\n    let mut i = 0;\n    let n = input.len();\n    while i < n && matches!(input[i], b' ' | b'\\t' | b'\\n' | b'\\r' | 0x0b | 0x0c) {\n        i += 1;\n    }\n    let mut sign: i64 = 1;\n    if i < n && (input[i] == b'+' || input[i] == b'-') {\n        if input[i] == b'-' {\n            sign = -1;\n        }\n        i += 1;\n    }\n    if i >= n || !(input[i] >= b'0' && input[i] <= b'9') {\n        return None;\n    }\n    let mut value: i64 = 0;\n    while i < n && input[i] >= b'0' && input[i] <= b'9' {\n        value = value.wrapping_mul(10).wrapping_add((input[i] - b'0') as i64);\n        i += 1;\n    }\n    value = value.wrapping_mul(sign);\n    Some(value as i32)\n}\n","structuredPatch":[{"oldStart":322,"oldLines":7,"newStart":322,"newLines":7,"lines":["                 io::stdout().flush().ok();","             }","             6 => {","-                interactive_tokenizer(ops);","+                interactive_tokenizer(ops, &mut stdin);","             }","             7 => {","                 print!(\"Goodbye!\\n\");"]}],"userModified":false,"replaceAll":false}}
