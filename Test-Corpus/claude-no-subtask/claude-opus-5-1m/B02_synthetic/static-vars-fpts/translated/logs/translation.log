{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JKR58ntxPnBAD9vi8mv6ZM","type":"tool_result","content":"1\t// Main module - port of main.c\n2\t\n3\tmod tokenizer;\n4\tmod analyzer;\n5\t\n6\tuse std::io::{self, Read, Write};\n7\tuse std::fs::File;\n8\t\n9\tuse tokenizer::{get_tokenizer_ops, Token, TokenType, TokenizerOps, MAX_BUFFER_SIZE};\n10\tuse analyzer::{analyzer_init, analyze_text, print_token_distribution, calculate_complexity_score, find_patterns, AnalysisResult};\n11\t\n12\tconst MAX_INPUT_SIZE: usize = 4096;\n13\t\n14\tfn print_menu() {\n15\t    print!(\"\\n=== Text Analyzer ===\\n\");\n16\t    print!(\"1. Analyze text\\n\");\n17\t    print!(\"2. Load text from file\\n\");\n18\t    print!(\"3. Show token distribution\\n\");\n19\t    print!(\"4. Calculate complexity score\\n\");\n20\t    print!(\"5. Find pattern\\n\");\n21\t    print!(\"6. Interactive tokenizer\\n\");\n22\t    print!(\"7. Exit\\n\");\n23\t    print!(\"Choice: \");\n24\t    io::stdout().flush().ok();\n25\t}\n26\t\n27\tfn print_analysis_result(result: AnalysisResult) {\n28\t    print!(\"\\n=== Analysis Results ===\\n\");\n29\t    print!(\"Words/Identifiers: {}\\n\", result.word_count);\n30\t    print!(\"Numbers: {}\\n\", result.number_count);\n31\t    print!(\"Keywords: {}\\n\", result.keyword_count);\n32\t    print!(\"Operators: {}\\n\", result.operator_count);\n33\t    print!(\"Comments: {}\\n\", result.comment_count);\n34\t    print!(\"Strings: {}\\n\", result.string_count);\n35\t    print!(\"Lines: {}\\n\", result.line_count);\n36\t    print!(\"Characters: {}\\n\", result.char_count);\n37\t}\n38\t\n39\t// Read up to (size-1) bytes from stdin until '\\n' (inclusive) or EOF.\n40\t// Mimic fgets: returns the line as bytes including the '\\n' terminator if found,\n41\t// or returns None on EOF with no bytes read.\n42\tfn fgets(stdin: &mut impl Read, size: usize) -> Option<Vec<u8>> {\n43\t    let mut buf: Vec<u8> = Vec::new();\n44\t    let max_read = size - 1; // leave room for null terminator equivalent\n45\t    let mut byte = [0u8; 1];\n46\t    while buf.len() < max_read {\n47\t        match stdin.read(&mut byte) {\n48\t            Ok(0) => {\n49\t                // EOF\n50\t                if buf.is_empty() {\n51\t                    return None;\n52\t                }\n53\t                break;\n54\t            }\n55\t            Ok(_) => {\n56\t                buf.push(byte[0]);\n57\t                if byte[0] == b'\\n' {\n58\t                    break;\n59\t                }\n60\t            }\n61\t            Err(_) => {\n62\t                if buf.is_empty() {\n63\t                    return None;\n64\t                }\n65\t                break;\n66\t            }\n67\t        }\n68\t    }\n69\t    Some(buf)\n70\t}\n71\t\n72\t// strncat: append from src to dest (dest already null-terminated up to dest_used)\n73\t// up to n bytes from src, then null-terminate.\n74\t// In our case, dest is a Vec<u8> of size MAX_INPUT_SIZE, but we track logical length.\n75\t// We mimic the C behavior: append up to (MAX_INPUT_SIZE - strlen(dest) - 1) bytes.\n76\tfn strncat(dest: &mut Vec<u8>, src: &[u8], n: usize) {\n77\t    let mut i = 0usize;\n78\t    while i < n && i < src.len() && src[i] != 0 {\n79\t        dest.push(src[i]);\n80\t        i += 1;\n81\t    }\n82\t}\n83\t\n84\t// strcspn-like: find length of dest before character in reject set.\n85\t// Used to remove '\\n' by setting it to 0.\n86\tfn strip_newline(s: &mut Vec<u8>) {\n87\t    // Truncate at first '\\n' (mimicking input[strcspn(input,\"\\n\")] = 0)\n88\t    if let Some(pos) = s.iter().position(|&b| b == b'\\n') {\n89\t        s.truncate(pos);\n90\t    }\n91\t}\n92\t\n93\tfn interactive_tokenizer<R: Read>(ops: TokenizerOps, stdin: &mut R) {\n94\t    print!(\"\\nEnter text (empty line to stop):\\n\");\n95\t    io::stdout().flush().ok();\n96\t\n97\t    let mut input: Vec<u8> = Vec::with_capacity(MAX_INPUT_SIZE);\n98\t\n99\t    loop {\n100\t        let line_opt = fgets(stdin, 256);\n101\t        let line = match line_opt {\n102\t            Some(l) => l,\n103\t            None => break,\n104\t        };\n105\t        if !line.is_empty() && line[0] == b'\\n' {\n106\t            break;\n107\t        }\n108\t        // Append: MAX_INPUT_SIZE - strlen(input) - 1 bytes\n109\t        let avail = MAX_INPUT_SIZE.saturating_sub(input.len()).saturating_sub(1);\n110\t        strncat(&mut input, &line, avail);\n111\t    }\n112\t\n113\t    if (ops.load_text)(&input) != 0 {\n114\t        print!(\"Failed to load text\\n\");\n115\t        io::stdout().flush().ok();\n116\t        return;\n117\t    }\n118\t\n119\t    print!(\"\\n=== Tokens ===\\n\");\n120\t\n121\t    let token_type_names: [&str; 12] = [\n122\t        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCT\", \"SPACE\",\n123\t        \"NEWLINE\", \"IDENT\", \"KEYWORD\", \"OPERATOR\",\n124\t        \"STRING\", \"COMMENT\", \"ERROR\",\n125\t    ];\n126\t\n127\t    let mut count = 0;\n128\t    loop {\n129\t        let token: Token = (ops.next_token)();\n130\t        if token.ttype == TokenType::Eof {\n131\t            break;\n132\t        }\n133\t        let idx = token.ttype as usize;\n134\t        let name = if idx < token_type_names.len() {\n135\t            token_type_names[idx]\n136\t        } else {\n137\t            \"ERROR\"\n138\t        };\n139\t\n140\t        // Print: [name] '<value>' (L<line>:C<column>)\n141\t        let mut stdout = io::stdout();\n142\t        let prefix = format!(\"[{}] '\", name);\n143\t        let _ = stdout.write_all(prefix.as_bytes());\n144\t        // Write token value as bytes up to first null\n145\t        let value_len = token\n146\t            .value\n147\t            .iter()\n148\t            .position(|&b| b == 0)\n149\t            .unwrap_or(token.value.len());\n150\t        let _ = stdout.write_all(&token.value[..value_len]);\n151\t        let suffix = format!(\"' (L{}:C{})\\n\", token.line, token.column);\n152\t        let _ = stdout.write_all(suffix.as_bytes());\n153\t\n154\t        count += 1;\n155\t        if count > 100 {\n156\t            print!(\"... (truncated, too many tokens)\\n\");\n157\t            break;\n158\t        }\n159\t    }\n160\t    io::stdout().flush().ok();\n161\t}\n162\t\n163\tfn read_file(filename: &[u8]) -> Option<Vec<u8>> {\n164\t    // Convert filename bytes to a path. Use OsStr from bytes on Unix.\n165\t    let filename_str = match std::str::from_utf8(filename) {\n166\t        Ok(s) => s,\n167\t        Err(_) => {\n168\t            // Best effort: write error using bytes\n169\t            let mut stderr = io::stderr();\n170\t            let _ = stderr.write_all(b\"Error: Could not open file '\");\n171\t            let _ = stderr.write_all(filename);\n172\t            let _ = stderr.write_all(b\"'\\n\");\n173\t            return None;\n174\t        }\n175\t    };\n176\t\n177\t    let file_res = File::open(filename_str);\n178\t    let mut file = match file_res {\n179\t        Ok(f) => f,\n180\t        Err(_) => {\n181\t            let mut stderr = io::stderr();\n182\t            let _ = stderr.write_all(b\"Error: Could not open file '\");\n183\t            let _ = stderr.write_all(filename);\n184\t            let _ = stderr.write_all(b\"'\\n\");\n185\t            return None;\n186\t        }\n187\t    };\n188\t\n189\t    // Use seek to determine size\n190\t    use std::io::Seek;\n191\t    let size = match file.seek(io::SeekFrom::End(0)) {\n192\t        Ok(s) => s as i64,\n193\t        Err(_) => -1,\n194\t    };\n195\t    let _ = file.seek(io::SeekFrom::Start(0));\n196\t\n197\t    if size > MAX_BUFFER_SIZE as i64 {\n198\t        let _ = writeln!(io::stderr(), \"Error: File too large\");\n199\t        return None;\n200\t    }\n201\t\n202\t    if size < 0 {\n203\t        // Treat as zero-size; allocation still happens\n204\t    }\n205\t\n206\t    let alloc_size = if size < 0 { 0 } else { size as usize };\n207\t    let mut content = vec![0u8; alloc_size + 1];\n208\t    // fread up to size\n209\t    let mut read_size = 0usize;\n210\t    if alloc_size > 0 {\n211\t        // Read exactly up to size bytes\n212\t        let mut buf = vec![0u8; alloc_size];\n213\t        let mut pos = 0;\n214\t        while pos < alloc_size {\n215\t            match file.read(&mut buf[pos..]) {\n216\t                Ok(0) => break,\n217\t                Ok(n) => pos += n,\n218\t                Err(_) => break,\n219\t            }\n220\t        }\n221\t        read_size = pos;\n222\t        for i in 0..read_size {\n223\t            content[i] = buf[i];\n224\t        }\n225\t    }\n226\t    content[read_size] = 0; // null terminator\n227\t\n228\t    Some(content)\n229\t}\n230\t\n231\tfn main() {\n232\t    let ops = get_tokenizer_ops();\n233\t    analyzer_init(ops);\n234\t\n235\t    print!(\"Text Analysis and Tokenization System\\n\");\n236\t    print!(\"This system demonstrates function pointers and static globals\\n\");\n237\t\n238\t    let stdin_handle = io::stdin();\n239\t    let mut stdin = stdin_handle.lock();\n240\t\n241\t    loop {\n242\t        print_menu();\n243\t\n244\t        let input_opt = fgets(&mut stdin, 256);\n245\t        let input = match input_opt {\n246\t            Some(l) => l,\n247\t            None => break,\n248\t        };\n249\t\n250\t        // sscanf(\"%d\", &choice) - parse int\n251\t        let choice = parse_int(&input);\n252\t        let choice = match choice {\n253\t            Some(n) => n,\n254\t            None => {\n255\t                print!(\"Invalid input\\n\");\n256\t                io::stdout().flush().ok();\n257\t                continue;\n258\t            }\n259\t        };\n260\t\n261\t        match choice {\n262\t            1 => {\n263\t                print!(\"Enter text to analyze (empty line to stop):\\n\");\n264\t                io::stdout().flush().ok();\n265\t                let mut text: Vec<u8> = Vec::with_capacity(MAX_INPUT_SIZE);\n266\t                loop {\n267\t                    let line_opt = fgets(&mut stdin, 256);\n268\t                    let line = match line_opt {\n269\t                        Some(l) => l,\n270\t                        None => break,\n271\t                    };\n272\t                    if !line.is_empty() && line[0] == b'\\n' {\n273\t                        break;\n274\t                    }\n275\t                    let avail = MAX_INPUT_SIZE.saturating_sub(text.len()).saturating_sub(1);\n276\t                    strncat(&mut text, &line, avail);\n277\t                }\n278\t                let result = analyze_text(&text);\n279\t                print_analysis_result(result);\n280\t            }\n281\t            2 => {\n282\t                print!(\"Enter filename: \");\n283\t                io::stdout().flush().ok();\n284\t                let line_opt = fgets(&mut stdin, 256);\n285\t                let mut input2 = match line_opt {\n286\t                    Some(l) => l,\n287\t                    None => break,\n288\t                };\n289\t                strip_newline(&mut input2);\n290\t\n291\t                if let Some(content) = read_file(&input2) {\n292\t                    let result = analyze_text(&content);\n293\t                    print_analysis_result(result);\n294\t                }\n295\t            }\n296\t            3 => {\n297\t                print_token_distribution();\n298\t                io::stdout().flush().ok();\n299\t            }\n300\t            4 => {\n301\t                let score = calculate_complexity_score();\n302\t                print!(\"\\nComplexity Score: {}\\n\", score);\n303\t                if score < 10 {\n304\t                    print!(\"Complexity: Low\\n\");\n305\t                } else if score < 50 {\n306\t                    print!(\"Complexity: Medium\\n\");\n307\t                } else {\n308\t                    print!(\"Complexity: High\\n\");\n309\t                }\n310\t                io::stdout().flush().ok();\n311\t            }\n312\t            5 => {\n313\t                print!(\"Enter pattern to search: \");\n314\t                io::stdout().flush().ok();\n315\t                let line_opt = fgets(&mut stdin, 256);\n316\t                let mut input2 = match line_opt {\n317\t                    Some(l) => l,\n318\t                    None => break,\n319\t                };\n320\t                strip_newline(&mut input2);\n321\t                find_patterns(&input2);\n322\t                io::stdout().flush().ok();\n323\t            }\n324\t            6 => {\n325\t                interactive_tokenizer(ops, &mut stdin);\n326\t            }\n327\t            7 => {\n328\t                print!(\"Goodbye!\\n\");\n329\t                io::stdout().flush().ok();\n330\t                return;\n331\t            }\n332\t            _ => {\n333\t                print!(\"Invalid choice\\n\");\n334\t                io::stdout().flush().ok();\n335\t            }\n336\t        }\n337\t    }\n338\t}\n339\t\n340\t// Parse integer from string the way C's sscanf(\"%d\", ...) does.\n341\t// Skip leading whitespace, optional sign, then digits.\n342\t// Returns None if no digits found.\n343\tfn parse_int(input: &[u8]) -> Option<i32> {\n344\t    let mut i = 0;\n345\t    let n = input.len();\n346\t    while i < n && matches!(input[i], b' ' | b'\\t' | b'\\n' | b'\\r' | 0x0b | 0x0c) {\n347\t        i += 1;\n348\t    }\n349\t    let mut sign: i64 = 1;\n350\t    if i < n && (input[i] == b'+' || input[i] == b'-') {\n351\t        if input[i] == b'-' {\n352\t            sign = -1;\n353\t        }\n354\t        i += 1;\n355\t    }\n356\t    if i >= n || !(input[i] >= b'0' && input[i] <= b'9') {\n357\t        return None;\n358\t    }\n359\t    let mut value: i64 = 0;\n360\t    while i < n && input[i] >= b'0' && input[i] <= b'9' {\n361\t        value = value.wrapping_mul(10).wrapping_add((input[i] - b'0') as i64);\n362\t        i += 1;\n363\t    }\n364\t    value = value.wrapping_mul(sign);\n365\t    Some(value as i32)\n366\t}\n367\t"}]},"parent_tool_use_id":null,"session_id":"9e9e9aee-7e67-487c-b695-4cdf72746c26","uuid":"433904fe-ee3b-419e-948e-5ee6118851fa","timestamp":"2026-06-05T20:17:29.713Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-translate-smPUZw/translated_rust/src/main.rs","content":"// Main module - port of main.c\n\nmod tokenizer;\nmod analyzer;\n\nuse std::io::{self, Read, Write};\nuse std::fs::File;\n\nuse tokenizer::{get_tokenizer_ops, Token, TokenType, TokenizerOps, MAX_BUFFER_SIZE};\nuse analyzer::{analyzer_init, analyze_text, print_token_distribution, calculate_complexity_score, find_patterns, AnalysisResult};\n\nconst MAX_INPUT_SIZE: usize = 4096;\n\nfn print_menu() {\n    print!(\"\\n=== Text Analyzer ===\\n\");\n    print!(\"1. Analyze text\\n\");\n    print!(\"2. Load text from file\\n\");\n    print!(\"3. Show token distribution\\n\");\n    print!(\"4. Calculate complexity score\\n\");\n    print!(\"5. Find pattern\\n\");\n    print!(\"6. Interactive tokenizer\\n\");\n    print!(\"7. Exit\\n\");\n    print!(\"Choice: \");\n    io::stdout().flush().ok();\n}\n\nfn print_analysis_result(result: AnalysisResult) {\n    print!(\"\\n=== Analysis Results ===\\n\");\n    print!(\"Words/Identifiers: {}\\n\", result.word_count);\n    print!(\"Numbers: {}\\n\", result.number_count);\n    print!(\"Keywords: {}\\n\", result.keyword_count);\n    print!(\"Operators: {}\\n\", result.operator_count);\n    print!(\"Comments: {}\\n\", result.comment_count);\n    print!(\"Strings: {}\\n\", result.string_count);\n    print!(\"Lines: {}\\n\", result.line_count);\n    print!(\"Characters: {}\\n\", result.char_count);\n}\n\n// Read up to (size-1) bytes from stdin until '\\n' (inclusive) or EOF.\n// Mimic fgets: returns the line as bytes including the '\\n' terminator if found,\n// or returns None on EOF with no bytes read.\nfn fgets(stdin: &mut impl Read, size: usize) -> Option<Vec<u8>> {\n    let mut buf: Vec<u8> = Vec::new();\n    let max_read = size - 1; // leave room for null terminator equivalent\n    let mut byte = [0u8; 1];\n    while buf.len() < max_read {\n        match stdin.read(&mut byte) {\n            Ok(0) => {\n                // EOF\n                if buf.is_empty() {\n                    return None;\n                }\n                break;\n            }\n            Ok(_) => {\n                buf.push(byte[0]);\n                if byte[0] == b'\\n' {\n                    break;\n                }\n            }\n            Err(_) => {\n                if buf.is_empty() {\n                    return None;\n                }\n                break;\n            }\n        }\n    }\n    Some(buf)\n}\n\n// strncat: append from src to dest (dest already null-terminated up to dest_used)\n// up to n bytes from src, then null-terminate.\n// In our case, dest is a Vec<u8> of size MAX_INPUT_SIZE, but we track logical length.\n// We mimic the C behavior: append up to (MAX_INPUT_SIZE - strlen(dest) - 1) bytes.\nfn strncat(dest: &mut Vec<u8>, src: &[u8], n: usize) {\n    let mut i = 0usize;\n    while i < n && i < src.len() && src[i] != 0 {\n        dest.push(src[i]);\n        i += 1;\n    }\n}\n\n// strcspn-like: find length of dest before character in reject set.\n// Used to remove '\\n' by setting it to 0.\nfn strip_newline(s: &mut Vec<u8>) {\n    // Truncate at first '\\n' (mimicking input[strcspn(input,\"\\n\")] = 0)\n    if let Some(pos) = s.iter().position(|&b| b == b'\\n') {\n        s.truncate(pos);\n    }\n}\n\nfn interactive_tokenizer<R: Read>(ops: TokenizerOps, stdin: &mut R) {\n    print!(\"\\nEnter text (empty line to stop):\\n\");\n    io::stdout().flush().ok();\n\n    let mut input: Vec<u8> = Vec::with_capacity(MAX_INPUT_SIZE);\n\n    loop {\n        let line_opt = fgets(stdin, 256);\n        let line = match line_opt {\n            Some(l) => l,\n            None => break,\n        };\n        if !line.is_empty() && line[0] == b'\\n' {\n            break;\n        }\n        // Append: MAX_INPUT_SIZE - strlen(input) - 1 bytes\n        let avail = MAX_INPUT_SIZE.saturating_sub(input.len()).saturating_sub(1);\n        strncat(&mut input, &line, avail);\n    }\n\n    if (ops.load_text)(&input) != 0 {\n        print!(\"Failed to load text\\n\");\n        io::stdout().flush().ok();\n        return;\n    }\n\n    print!(\"\\n=== Tokens ===\\n\");\n\n    let token_type_names: [&str; 12] = [\n        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCT\", \"SPACE\",\n        \"NEWLINE\", \"IDENT\", \"KEYWORD\", \"OPERATOR\",\n        \"STRING\", \"COMMENT\", \"ERROR\",\n    ];\n\n    let mut count = 0;\n    loop {\n        let token: Token = (ops.next_token)();\n        if token.ttype == TokenType::Eof {\n            break;\n        }\n        let idx = token.ttype as usize;\n        let name = if idx < token_type_names.len() {\n            token_type_names[idx]\n        } else {\n            \"ERROR\"\n        };\n\n        // Print: [name] '<value>' (L<line>:C<column>)\n        let mut stdout = io::stdout();\n        let prefix = format!(\"[{}] '\", name);\n        let _ = stdout.write_all(prefix.as_bytes());\n        // Write token value as bytes up to first null\n        let value_len = token\n            .value\n            .iter()\n            .position(|&b| b == 0)\n            .unwrap_or(token.value.len());\n        let _ = stdout.write_all(&token.value[..value_len]);\n        let suffix = format!(\"' (L{}:C{})\\n\", token.line, token.column);\n        let _ = stdout.write_all(suffix.as_bytes());\n\n        count += 1;\n        if count > 100 {\n            print!(\"... (truncated, too many tokens)\\n\");\n            break;\n        }\n    }\n    io::stdout().flush().ok();\n}\n\nfn read_file(filename: &[u8]) -> Option<Vec<u8>> {\n    // Convert filename bytes to a path. Use OsStr from bytes on Unix.\n    let filename_str = match std::str::from_utf8(filename) {\n        Ok(s) => s,\n        Err(_) => {\n            // Best effort: write error using bytes\n            let mut stderr = io::stderr();\n            let _ = stderr.write_all(b\"Error: Could not open file '\");\n            let _ = stderr.write_all(filename);\n            let _ = stderr.write_all(b\"'\\n\");\n            return None;\n        }\n    };\n\n    let file_res = File::open(filename_str);\n    let mut file = match file_res {\n        Ok(f) => f,\n        Err(_) => {\n            let mut stderr = io::stderr();\n            let _ = stderr.write_all(b\"Error: Could not open file '\");\n            let _ = stderr.write_all(filename);\n            let _ = stderr.write_all(b\"'\\n\");\n            return None;\n        }\n    };\n\n    // Use seek to determine size\n    use std::io::Seek;\n    let size = match file.seek(io::SeekFrom::End(0)) {\n        Ok(s) => s as i64,\n        Err(_) => -1,\n    };\n    let _ = file.seek(io::SeekFrom::Start(0));\n\n    if size > MAX_BUFFER_SIZE as i64 {\n        let _ = writeln!(io::stderr(), \"Error: File too large\");\n        return None;\n    }\n\n    if size < 0 {\n        // Treat as zero-size; allocation still happens\n    }\n\n    let alloc_size = if size < 0 { 0 } else { size as usize };\n    let mut content = vec![0u8; alloc_size + 1];\n    // fread up to size\n    let mut read_size = 0usize;\n    if alloc_size > 0 {\n        // Read exactly up to size bytes\n        let mut buf = vec![0u8; alloc_size];\n        let mut pos = 0;\n        while pos < alloc_size {\n            match file.read(&mut buf[pos..]) {\n                Ok(0) => break,\n                Ok(n) => pos += n,\n                Err(_) => break,\n            }\n        }\n        read_size = pos;\n        for i in 0..read_size {\n            content[i] = buf[i];\n        }\n    }\n    content[read_size] = 0; // null terminator\n\n    Some(content)\n}\n\nfn main() {\n    let ops = get_tokenizer_ops();\n    analyzer_init(ops);\n\n    print!(\"Text Analysis and Tokenization System\\n\");\n    print!(\"This system demonstrates function pointers and static globals\\n\");\n\n    let stdin_handle = io::stdin();\n    let mut stdin = stdin_handle.lock();\n\n    loop {\n        print_menu();\n\n        let input_opt = fgets(&mut stdin, 256);\n        let input = match input_opt {\n            Some(l) => l,\n            None => break,\n        };\n\n        // sscanf(\"%d\", &choice) - parse int\n        let choice = parse_int(&input);\n        let choice = match choice {\n            Some(n) => n,\n            None => {\n                print!(\"Invalid input\\n\");\n                io::stdout().flush().ok();\n                continue;\n            }\n        };\n\n        match choice {\n            1 => {\n                print!(\"Enter text to analyze (empty line to stop):\\n\");\n                io::stdout().flush().ok();\n                let mut text: Vec<u8> = Vec::with_capacity(MAX_INPUT_SIZE);\n                loop {\n                    let line_opt = fgets(&mut stdin, 256);\n                    let line = match line_opt {\n                        Some(l) => l,\n                        None => break,\n                    };\n                    if !line.is_empty() && line[0] == b'\\n' {\n                        break;\n                    }\n                    let avail = MAX_INPUT_SIZE.saturating_sub(text.len()).saturating_sub(1);\n                    strncat(&mut text, &line, avail);\n                }\n                let result = analyze_text(&text);\n                print_analysis_result(result);\n            }\n            2 => {\n                print!(\"Enter filename: \");\n                io::stdout().flush().ok();\n                let line_opt = fgets(&mut stdin, 256);\n                let mut input2 = match line_opt {\n                    Some(l) => l,\n                    None => break,\n                };\n                strip_newline(&mut input2);\n\n                if let Some(content) = read_file(&input2) {\n                    let result = analyze_text(&content);\n                    print_analysis_result(result);\n                }\n            }\n            3 => {\n                print_token_distribution();\n                io::stdout().flush().ok();\n            }\n            4 => {\n                let score = calculate_complexity_score();\n                print!(\"\\nComplexity Score: {}\\n\", score);\n                if score < 10 {\n                    print!(\"Complexity: Low\\n\");\n                } else if score < 50 {\n                    print!(\"Complexity: Medium\\n\");\n                } else {\n                    print!(\"Complexity: High\\n\");\n                }\n                io::stdout().flush().ok();\n            }\n            5 => {\n                print!(\"Enter pattern to search: \");\n                io::stdout().flush().ok();\n                let line_opt = fgets(&mut stdin, 256);\n                let mut input2 = match line_opt {\n                    Some(l) => l,\n                    None => break,\n                };\n                strip_newline(&mut input2);\n                find_patterns(&input2);\n                io::stdout().flush().ok();\n            }\n            6 => {\n                interactive_tokenizer(ops, &mut stdin);\n            }\n            7 => {\n                print!(\"Goodbye!\\n\");\n                io::stdout().flush().ok();\n                return;\n            }\n            _ => {\n                print!(\"Invalid choice\\n\");\n                io::stdout().flush().ok();\n            }\n        }\n    }\n}\n\n// Parse integer from string the way C's sscanf(\"%d\", ...) does.\n// Skip leading whitespace, optional sign, then digits.\n// Returns None if no digits found.\nfn parse_int(input: &[u8]) -> Option<i32> {\n    let mut i = 0;\n    let n = input.len();\n    while i < n && matches!(input[i], b' ' | b'\\t' | b'\\n' | b'\\r' | 0x0b | 0x0c) {\n        i += 1;\n    }\n    let mut sign: i64 = 1;\n    if i < n && (input[i] == b'+' || input[i] == b'-') {\n        if input[i] == b'-' {\n            sign = -1;\n        }\n        i += 1;\n    }\n    if i >= n || !(input[i] >= b'0' && input[i] <= b'9') {\n        return None;\n    }\n    let mut value: i64 = 0;\n    while i < n && input[i] >= b'0' && input[i] <= b'9' {\n        value = value.wrapping_mul(10).wrapping_add((input[i] - b'0') as i64);\n        i += 1;\n    }\n    value = value.wrapping_mul(sign);\n    Some(value as i32)\n}\n","numLines":367,"startLine":1,"totalLines":367}}}
