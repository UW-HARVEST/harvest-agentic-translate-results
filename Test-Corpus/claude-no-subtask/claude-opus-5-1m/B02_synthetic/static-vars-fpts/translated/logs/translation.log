{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_nwnr3ohd4rxa6mw5g6ujsptc2hejwx2nceselsxtmnwo72n4wlxa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_018rhMt1KZY5KNMbZH8HKaDS","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-translate-smPUZw/translated_rust/src/main.rs","content":"// Main module - port of main.c\n\nmod tokenizer;\nmod analyzer;\n\nuse std::io::{self, Read, Write};\nuse std::fs::File;\n\nuse tokenizer::{get_tokenizer_ops, Token, TokenType, TokenizerOps, MAX_BUFFER_SIZE};\nuse analyzer::{analyzer_init, analyze_text, print_token_distribution, calculate_complexity_score, find_patterns, AnalysisResult};\n\nconst MAX_INPUT_SIZE: usize = 4096;\n\nfn print_menu() {\n    print!(\"\\n=== Text Analyzer ===\\n\");\n    print!(\"1. Analyze text\\n\");\n    print!(\"2. Load text from file\\n\");\n    print!(\"3. Show token distribution\\n\");\n    print!(\"4. Calculate complexity score\\n\");\n    print!(\"5. Find pattern\\n\");\n    print!(\"6. Interactive tokenizer\\n\");\n    print!(\"7. Exit\\n\");\n    print!(\"Choice: \");\n    io::stdout().flush().ok();\n}\n\nfn print_analysis_result(result: AnalysisResult) {\n    print!(\"\\n=== Analysis Results ===\\n\");\n    print!(\"Words/Identifiers: {}\\n\", result.word_count);\n    print!(\"Numbers: {}\\n\", result.number_count);\n    print!(\"Keywords: {}\\n\", result.keyword_count);\n    print!(\"Operators: {}\\n\", result.operator_count);\n    print!(\"Comments: {}\\n\", result.comment_count);\n    print!(\"Strings: {}\\n\", result.string_count);\n    print!(\"Lines: {}\\n\", result.line_count);\n    print!(\"Characters: {}\\n\", result.char_count);\n}\n\n// Read up to (size-1) bytes from stdin until '\\n' (inclusive) or EOF.\n// Mimic fgets: returns the line as bytes including the '\\n' terminator if found,\n// or returns None on EOF with no bytes read.\nfn fgets(stdin: &mut impl Read, size: usize) -> Option<Vec<u8>> {\n    let mut buf: Vec<u8> = Vec::new();\n    let max_read = size - 1; // leave room for null terminator equivalent\n    let mut byte = [0u8; 1];\n    while buf.len() < max_read {\n        match stdin.read(&mut byte) {\n            Ok(0) => {\n                // EOF\n                if buf.is_empty() {\n                    return None;\n                }\n                break;\n            }\n            Ok(_) => {\n                buf.push(byte[0]);\n                if byte[0] == b'\\n' {\n                    break;\n                }\n            }\n            Err(_) => {\n                if buf.is_empty() {\n                    return None;\n                }\n                break;\n            }\n        }\n    }\n    Some(buf)\n}\n\n// strncat: append from src to dest (dest already null-terminated up to dest_used)\n// up to n bytes from src, then null-terminate.\n// In our case, dest is a Vec<u8> of size MAX_INPUT_SIZE, but we track logical length.\n// We mimic the C behavior: append up to (MAX_INPUT_SIZE - strlen(dest) - 1) bytes.\nfn strncat(dest: &mut Vec<u8>, src: &[u8], n: usize) {\n    let mut i = 0usize;\n    while i < n && i < src.len() && src[i] != 0 {\n        dest.push(src[i]);\n        i += 1;\n    }\n}\n\n// strcspn-like: find length of dest before character in reject set.\n// Used to remove '\\n' by setting it to 0.\nfn strip_newline(s: &mut Vec<u8>) {\n    // Truncate at first '\\n' (mimicking input[strcspn(input,\"\\n\")] = 0)\n    if let Some(pos) = s.iter().position(|&b| b == b'\\n') {\n        s.truncate(pos);\n    }\n}\n\nfn interactive_tokenizer(ops: TokenizerOps) {\n    print!(\"\\nEnter text (empty line to stop):\\n\");\n    io::stdout().flush().ok();\n\n    let mut input: Vec<u8> = Vec::with_capacity(MAX_INPUT_SIZE);\n    let stdin_handle = io::stdin();\n    let mut stdin = stdin_handle.lock();\n\n    loop {\n        let line_opt = fgets(&mut stdin, 256);\n        let line = match line_opt {\n            Some(l) => l,\n            None => break,\n        };\n        if !line.is_empty() && line[0] == b'\\n' {\n            break;\n        }\n        // Append: MAX_INPUT_SIZE - strlen(input) - 1 bytes\n        let avail = MAX_INPUT_SIZE.saturating_sub(input.len()).saturating_sub(1);\n        strncat(&mut input, &line, avail);\n    }\n\n    if (ops.load_text)(&input) != 0 {\n        print!(\"Failed to load text\\n\");\n        io::stdout().flush().ok();\n        return;\n    }\n\n    print!(\"\\n=== Tokens ===\\n\");\n\n    let token_type_names: [&str; 12] = [\n        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCT\", \"SPACE\",\n        \"NEWLINE\", \"IDENT\", \"KEYWORD\", \"OPERATOR\",\n        \"STRING\", \"COMMENT\", \"ERROR\",\n    ];\n\n    let mut count = 0;\n    loop {\n        let token: Token = (ops.next_token)();\n        if token.ttype == TokenType::Eof {\n            break;\n        }\n        let idx = token.ttype as usize;\n        let name = if idx < token_type_names.len() {\n            token_type_names[idx]\n        } else {\n            \"ERROR\"\n        };\n\n        // Print: [name] '<value>' (L<line>:C<column>)\n        let mut stdout = io::stdout();\n        let prefix = format!(\"[{}] '\", name);\n        let _ = stdout.write_all(prefix.as_bytes());\n        // Write token value as bytes up to first null\n        let value_len = token\n            .value\n            .iter()\n            .position(|&b| b == 0)\n            .unwrap_or(token.value.len());\n        let _ = stdout.write_all(&token.value[..value_len]);\n        let suffix = format!(\"' (L{}:C{})\\n\", token.line, token.column);\n        let _ = stdout.write_all(suffix.as_bytes());\n\n        count += 1;\n        if count > 100 {\n            print!(\"... (truncated, too many tokens)\\n\");\n            break;\n        }\n    }\n    io::stdout().flush().ok();\n}\n\nfn read_file(filename: &[u8]) -> Option<Vec<u8>> {\n    // Convert filename bytes to a path. Use OsStr from bytes on Unix.\n    let filename_str = match std::str::from_utf8(filename) {\n        Ok(s) => s,\n        Err(_) => {\n            // Best effort: write error using bytes\n            let mut stderr = io::stderr();\n            let _ = stderr.write_all(b\"Error: Could not open file '\");\n            let _ = stderr.write_all(filename);\n            let _ = stderr.write_all(b\"'\\n\");\n            return None;\n        }\n    };\n\n    let file_res = File::open(filename_str);\n    let mut file = match file_res {\n        Ok(f) => f,\n        Err(_) => {\n            let mut stderr = io::stderr();\n            let _ = stderr.write_all(b\"Error: Could not open file '\");\n            let _ = stderr.write_all(filename);\n            let _ = stderr.write_all(b\"'\\n\");\n            return None;\n        }\n    };\n\n    // Use seek to determine size\n    use std::io::Seek;\n    let size = match file.seek(io::SeekFrom::End(0)) {\n        Ok(s) => s as i64,\n        Err(_) => -1,\n    };\n    let _ = file.seek(io::SeekFrom::Start(0));\n\n    if size > MAX_BUFFER_SIZE as i64 {\n        let _ = writeln!(io::stderr(), \"Error: File too large\");\n        return None;\n    }\n\n    if size < 0 {\n        // Treat as zero-size; allocation still happens\n    }\n\n    let alloc_size = if size < 0 { 0 } else { size as usize };\n    let mut content = vec![0u8; alloc_size + 1];\n    // fread up to size\n    let mut read_size = 0usize;\n    if alloc_size > 0 {\n        // Read exactly up to size bytes\n        let mut buf = vec![0u8; alloc_size];\n        let mut pos = 0;\n        while pos < alloc_size {\n            match file.read(&mut buf[pos..]) {\n                Ok(0) => break,\n                Ok(n) => pos += n,\n                Err(_) => break,\n            }\n        }\n        read_size = pos;\n        for i in 0..read_size {\n            content[i] = buf[i];\n        }\n    }\n    content[read_size] = 0; // null terminator\n\n    Some(content)\n}\n\nfn main() {\n    let ops = get_tokenizer_ops();\n    analyzer_init(ops);\n\n    print!(\"Text Analysis and Tokenization System\\n\");\n    print!(\"This system demonstrates function pointers and static globals\\n\");\n\n    let stdin_handle = io::stdin();\n    let mut stdin = stdin_handle.lock();\n\n    loop {\n        print_menu();\n\n        let input_opt = fgets(&mut stdin, 256);\n        let input = match input_opt {\n            Some(l) => l,\n            None => break,\n        };\n\n        // sscanf(\"%d\", &choice) - parse int\n        let choice = parse_int(&input);\n        let choice = match choice {\n            Some(n) => n,\n            None => {\n                print!(\"Invalid input\\n\");\n                io::stdout().flush().ok();\n                continue;\n            }\n        };\n\n        match choice {\n            1 => {\n                print!(\"Enter text to analyze (empty line to stop):\\n\");\n                io::stdout().flush().ok();\n                let mut text: Vec<u8> = Vec::with_capacity(MAX_INPUT_SIZE);\n                loop {\n                    let line_opt = fgets(&mut stdin, 256);\n                    let line = match line_opt {\n                        Some(l) => l,\n                        None => break,\n                    };\n                    if !line.is_empty() && line[0] == b'\\n' {\n                        break;\n                    }\n                    let avail = MAX_INPUT_SIZE.saturating_sub(text.len()).saturating_sub(1);\n                    strncat(&mut text, &line, avail);\n                }\n                let result = analyze_text(&text);\n                print_analysis_result(result);\n            }\n            2 => {\n                print!(\"Enter filename: \");\n                io::stdout().flush().ok();\n                let line_opt = fgets(&mut stdin, 256);\n                let mut input2 = match line_opt {\n                    Some(l) => l,\n                    None => break,\n                };\n                strip_newline(&mut input2);\n\n                if let Some(content) = read_file(&input2) {\n                    let result = analyze_text(&content);\n                    print_analysis_result(result);\n                }\n            }\n            3 => {\n                print_token_distribution();\n                io::stdout().flush().ok();\n            }\n            4 => {\n                let score = calculate_complexity_score();\n                print!(\"\\nComplexity Score: {}\\n\", score);\n                if score < 10 {\n                    print!(\"Complexity: Low\\n\");\n                } else if score < 50 {\n                    print!(\"Complexity: Medium\\n\");\n                } else {\n                    print!(\"Complexity: High\\n\");\n                }\n                io::stdout().flush().ok();\n            }\n            5 => {\n                print!(\"Enter pattern to search: \");\n                io::stdout().flush().ok();\n                let line_opt = fgets(&mut stdin, 256);\n                let mut input2 = match line_opt {\n                    Some(l) => l,\n                    None => break,\n                };\n                strip_newline(&mut input2);\n                find_patterns(&input2);\n                io::stdout().flush().ok();\n            }\n            6 => {\n                interactive_tokenizer(ops);\n            }\n            7 => {\n                print!(\"Goodbye!\\n\");\n                io::stdout().flush().ok();\n                return;\n            }\n            _ => {\n                print!(\"Invalid choice\\n\");\n                io::stdout().flush().ok();\n            }\n        }\n    }\n}\n\n// Parse integer from string the way C's sscanf(\"%d\", ...) does.\n// Skip leading whitespace, optional sign, then digits.\n// Returns None if no digits found.\nfn parse_int(input: &[u8]) -> Option<i32> {\n    let mut i = 0;\n    let n = input.len();\n    while i < n && matches!(input[i], b' ' | b'\\t' | b'\\n' | b'\\r' | 0x0b | 0x0c) {\n        i += 1;\n    }\n    let mut sign: i64 = 1;\n    if i < n && (input[i] == b'+' || input[i] == b'-') {\n        if input[i] == b'-' {\n            sign = -1;\n        }\n        i += 1;\n    }\n    if i >= n || !(input[i] >= b'0' && input[i] <= b'9') {\n        return None;\n    }\n    let mut value: i64 = 0;\n    while i < n && input[i] >= b'0' && input[i] <= b'9' {\n        value = value.wrapping_mul(10).wrapping_add((input[i] - b'0') as i64);\n        i += 1;\n    }\n    value = value.wrapping_mul(sign);\n    Some(value as i32)\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":4212,"cache_read_input_tokens":36797,"cache_creation":{"ephemeral_5m_input_tokens":4212,"ephemeral_1h_input_tokens":0},"output_tokens":36,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9e9e9aee-7e67-487c-b695-4cdf72746c26","uuid":"110106fb-53b3-4204-8524-d70502c809c4"}
