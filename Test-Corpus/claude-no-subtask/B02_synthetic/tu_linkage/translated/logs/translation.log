nce, x); }\n41\t    \n42\t    return inline_call(&target, MAC_CALL(target, x));\n43\t}\n44\t\n45\tstatic int process_stream(int impl, const int *buf, size_t n){\n46\t    if (impl==0) return process_a_stream(buf, n);\n47\t    if (impl==1) return process_b_stream(buf, n);\n48\t    \n49\t    int acc=0;\n50\t    for(size_t i=0;i<n;i++){\n51\t        int t = target(buf[i]);\n52\t        if ((t&1)==0) acc += (t*2);\n53\t        else          acc ^= (t+7);\n54\t    }\n55\t    return acc;\n56\t}\n57\t\n58\tint run_engine(int impl_id, const int *code, size_t n, VM *vm){\n59\t    Program p; prog_init(&p, code, n);\n60\t    int op;\n61\t    while (prog_fetch(&p, &op)) {\n62\t        vm->steps++;\n63\t        switch (op) {\n64\t            case 0: { \n65\t                int imm; if (!prog_fetch(&p, &imm)) return 1;\n66\t                iv_push(&vm->stack, imm);\n67\t                vm_trace(vm, 0);\n68\t                break;\n69\t            }\n70\t            case 1: { \n71\t                int a,b; if(!iv_pop(&vm->stack,&b)||!iv_pop(&vm->stack,&a)) return 2;\n72\t                iv_push(&vm->stack, a+b);\n73\t                vm_trace(vm, 1);\n74\t                break;\n75\t            }\n76\t            case 2: { \n77\t                int a,b; if(!iv_pop(&vm->stack,&b)||!iv_pop(&vm->stack,&a)) return 3;\n78\t                iv_push(&vm->stack, a*b);\n79\t                vm_trace(vm, 2);\n80\t                break;\n81\t            }\n82\t            case 3: { \n83\t                int a = iv_peek(&vm->stack, 0);\n84\t                iv_push(&vm->stack, a);\n85\t                vm_trace(vm, 3);\n86\t                break;\n87\t            }\n88\t            case 4: { \n89\t                int tmp; if(!iv_pop(&vm->stack,&tmp)) return 4;\n90\t                vm_trace(vm, 4);\n91\t                break;\n92\t            }\n93\t            case 5: { \n94\t                int x = iv_peek(&vm->stack, 0);\n95\t                int bucket = classify(impl_id, x);\n96\t               