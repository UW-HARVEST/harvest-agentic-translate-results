a struct, zeroes it, sets t.a = a, t.b = b,\n    // then prints find_container_of_a(&t.a)->a + find_container_of_b(&t.b)->b\n    // which is just t.a + t.b == a + b.\n    let sum = a.wrapping_add(b);\n\n    println!(\"{}\", sum);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
