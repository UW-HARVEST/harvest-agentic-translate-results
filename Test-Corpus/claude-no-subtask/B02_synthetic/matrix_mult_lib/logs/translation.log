at->matrix[i][j] = atoi(col_token);\n108\t            col_token = strtok_r(NULL, \" \", &saveptr_col);\n109\t        }\n110\t\n111\t        row_token = strtok_r(NULL, \"\\n\", &saveptr_row);\n112\t    }\n113\t\n114\t    free(input_copy);\n115\t    return mat;\n116\t}\n117\t\n118\tmatrix_t* multiply_matrices(matrix_t* mat_a, matrix_t* mat_b) {\n119\t    if (mat_a->width != mat_b->height) {\n120\t        fprintf(stderr, \"Matrix dimensions do not allow multiplication.\\n\");\n121\t        return NULL;\n122\t    }\n123\t\n124\t    matrix_t* result = allocate_matrix(mat_b->width, mat_a->height);\n125\t    for (int i = 0; i < mat_a->height; i++) {\n126\t        for (int j = 0; j < mat_b->width; j++) {\n127\t            result->matrix[i][j] = 0;\n128\t            for (int k = 0; k < mat_a->width; k++) {\n129\t                result->matrix[i][j] += mat_a->matrix[i][k] * mat_b->matrix[k][j];\n130\t            }\n131\t        }\n132\t    }\n133\t\n134\t    return result;\n135\t}\n136\t\n137\tchar* matrix_to_string(matrix_t* mat) {\n138\t    if (mat == NULL) {\n139\t        fprintf(stderr, \"Error: Matrix is NULL.\\n\");\n140\t        return NULL;\n141\t    }\n142\t\n143\t    int buffer_size = mat->height * (mat->width * 10 + mat->width) + mat->height + 1;\n144\t    char* result = malloc(buffer_size);\n145\t    if (result == NULL) {\n146\t        perror(\"Failed to allocate memory for matrix string\");\n147\t        return NULL;\n148\t    }\n149\t\n150\t    result[0] = '\\0';\n151\t\n152\t    for (int i = 0; i < mat->height; i++) {\n153\t        for (int j = 0; j < mat->width; j++) {\n154\t            char buffer[12];\n155\t            snprintf(buffer, sizeof(buffer), \"%d\", mat->matrix[i][j]);\n156\t            strcat(result, buffer);\n157\t\n158\t            if (j < mat->width - 1) {\n159\t                strcat(result, \" \");\n160\t            }\n161\t        }\n162\t        strcat(result, \"\\n\");\n163\t    }\n164\t\n165\t    return result;\n166\t}\n167\t"}]},"parent_