{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_buniyguly2a6rjhhqan3etw7fk7qypkvhnae5qgsrfj7eiweykbq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_018bTBNi6MYk9bZzhfCgAPDh","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-translate-aMr7ta/translated_rust/src/lib.rs","content":"#![allow(non_camel_case_types)]\n\nuse std::ffi::c_float;\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct lm_vec2 {\n    pub x: c_float,\n    pub y: c_float,\n}\n\n#[inline]\nfn lm_v2(x: c_float, y: c_float) -> lm_vec2 {\n    lm_vec2 { x, y }\n}\n\n#[inline]\nfn lm_sub2(a: lm_vec2, b: lm_vec2) -> lm_vec2 {\n    lm_v2(a.x - b.x, a.y - b.y)\n}\n\n#[inline]\nfn lm_dot2(a: lm_vec2, b: lm_vec2) -> c_float {\n    a.x * b.x + a.y * b.y\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn to_barycentric(\n    p1: lm_vec2,\n    p2: lm_vec2,\n    p3: lm_vec2,\n    p: lm_vec2,\n) -> lm_vec2 {\n    let v0 = lm_sub2(p3, p1);\n    let v1 = lm_sub2(p2, p1);\n    let v2 = lm_sub2(p, p1);\n    let dot00 = lm_dot2(v0, v0);\n    let dot01 = lm_dot2(v0, v1);\n    let dot02 = lm_dot2(v0, v2);\n    let dot11 = lm_dot2(v1, v1);\n    let dot12 = lm_dot2(v1, v2);\n    let inv_denom = 1.0f32 / (dot00 * dot11 - dot01 * dot01);\n    let u = (dot11 * dot02 - dot01 * dot12) * inv_denom;\n    let v = (dot00 * dot12 - dot01 * dot02) * inv_denom;\n    lm_v2(u, v)\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":272,"cache_read_input_tokens":15989,"cache_creation":{"ephemeral_5m_input_tokens":272,"ephemeral_1h_input_tokens":0},"output_tokens":37,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1dae0701-1d1b-488a-93bd-d5f0480a33fb","uuid":"406f63b6-b32b-4c4b-95a5-dfcd430b824f"}
