ymbol names\n- Public C functions exposed with proper `extern \"C\"` and `c_int`/raw-pointer signatures"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":324,"cache_read_input_tokens":319672,"cache_creation":{"ephemeral_5m_input_tokens":324,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"3358c92a-c7cf-4ef9-adf3-e417cf8f446f","uuid":"7ba4ae31-c050-4f95-b8ff-54b862770dc7"}
