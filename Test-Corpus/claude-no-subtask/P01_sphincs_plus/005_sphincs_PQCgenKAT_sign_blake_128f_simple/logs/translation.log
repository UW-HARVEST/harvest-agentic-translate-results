ile( datalen >= 512 ) {\n316\t    S->t[0] += 512;\n317\t    if (S->t[0] == 0) S->t[1]++;\n318\t    blake256_compress( S, data );\n319\t    data += 64;\n320\t    datalen -= 512;\n321\t  }\n322\t  \n323\t  if( datalen > 0 ) {\n324\t    memcpy( (void*) (S->buf + left), (void*) data, datalen>>3 );\n325\t    S->buflen = (left<<3) + datalen;\n326\t  }\n327\t  else S->buflen=0;\n328\t}\n329\t\n330\t\n331\tvoid blake256_final( blakestate256 *S, u8 *digest ) {\n332\t  \n333\t  u8 msglen[8], zo=0x01, oo=0x81;\n334\t  u32 lo=S->t[0] + S->buflen, hi=S->t[1];\n335\t  if ( lo < S->buflen ) hi++;\n336\t  U32TO8(  msglen + 0, hi );\n337\t  U32TO8(  msglen + 4, lo );\n338\t\n339\t  if ( S->buflen == 440 ) { /* one padding byte */\n340\t    S->t[0] -= 8;\n341\t    blake256_update( S, &oo, 8 );\n342\t  }\n343\t  else {\n344\t    if ( S->buflen < 440 ) { /* enough space to fill the block  */\n345\t      if ( !S->buflen ) S->nullt=1;\n346\t      S->t[0] -= 440 - S->buflen;\n347\t      blake256_update( S, padding, 440 - S->buflen );\n348\t    }\n349\t    else { /* need 2 compressions */\n350\t      S->t[0] -= 512 - S->buflen; \n351\t      blake256_update( S, padding, 512 - S->buflen );\n352\t      S->t[0] -= 440;\n353\t      blake256_update( S, padding+1, 440 );\n354\t      S->nullt = 1;\n355\t    }\n356\t    blake256_update( S, &zo, 8 );\n357\t    S->t[0] -= 8;\n358\t  }\n359\t  S->t[0] -= 64;\n360\t  blake256_update( S, msglen, 64 );    \n361\t  \n362\t  U32TO8( digest + 0, S->h[0]);\n363\t  U32TO8( digest + 4, S->h[1]);\n364\t  U32TO8( digest + 8, S->h[2]);\n365\t  U32TO8( digest +12, S->h[3]);\n366\t  U32TO8( digest +16, S->h[4]);\n367\t  U32TO8( digest +20, S->h[5]);\n368\t  U32TO8( digest +24, S->h[6]);\n369\t  U32TO8( digest +28, S->h[7]);\n370\t}\n371\t\n372\tvoid blake256_mgf1(unsigned char *out, unsigned long outlen,\n373\t\t\t   const unsigned char *in, unsigned long inlen)\n374\t{\n375\t    SPX_VLA(uint8_t, inbuf, inlen+4);\n376\t    unsigned char outbuf[SPX_BLAKE256_OUTPUT_B