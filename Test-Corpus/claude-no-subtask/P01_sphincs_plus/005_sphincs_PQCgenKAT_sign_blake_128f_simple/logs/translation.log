nit(state);\n150\t\n151\t    // seed: SHA-X(R ‖ PK.seed ‖ PK.root ‖ M)\n152\t    memcpy(inbuf, R, SPX_N);\n153\t    memcpy(inbuf + SPX_N, pk, SPX_PK_BYTES);\n154\t\n155\t    /* If R + pk + message cannot fill up an entire block */\n156\t    if (SPX_N + SPX_PK_BYTES + mlen < SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES) {\n157\t        memcpy(inbuf + SPX_N + SPX_PK_BYTES, m, mlen);\n158\t        shaX_inc_finalize(seed + 2*SPX_N, state, inbuf, SPX_N + SPX_PK_BYTES + mlen);\n159\t    }\n160\t    /* Otherwise first fill a block, so that finalize only uses the message */\n161\t    else {\n162\t        memcpy(inbuf + SPX_N + SPX_PK_BYTES, m,\n163\t               SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES - SPX_N - SPX_PK_BYTES);\n164\t        shaX_inc_blocks(state, inbuf, SPX_INBLOCKS);\n165\t\n166\t        m += SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES - SPX_N - SPX_PK_BYTES;\n167\t        mlen -= SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES - SPX_N - SPX_PK_BYTES;\n168\t        shaX_inc_finalize(seed + 2*SPX_N, state, m, mlen);\n169\t    }\n170\t\n171\t    // H_msg: MGF1-SHA-X(R ‖ PK.seed ‖ seed)\n172\t    memcpy(seed, R, SPX_N);\n173\t    memcpy(seed + SPX_N, pk, SPX_N);\n174\t\n175\t    /* By doing this in two steps, we prevent hashing the message twice;\n176\t       otherwise each iteration in MGF1 would hash the message again. */\n177\t    mgf1_X(bufp, SPX_DGST_BYTES, seed, 2*SPX_N + SPX_SHAX_OUTPUT_BYTES);\n178\t\n179\t    memcpy(digest, bufp, SPX_FORS_MSG_BYTES);\n180\t    bufp += SPX_FORS_MSG_BYTES;\n181\t\n182\t#if SPX_TREE_BITS > 64\n183\t    #error For given height and depth, 64 bits cannot represent all subtrees\n184\t#endif\n185\t\n186\t    if (SPX_D == 1) {\n187\t\t*tree = 0;\n188\t    } else {\n189\t        *tree = bytes_to_ull(bufp, SPX_TREE_BYTES);\n190\t        *tree &= (~(uint64_t)0) >> (64 - SPX_TREE_BITS);\n191\t    }\n192\t    bufp += SPX_TREE_BYTES;\n193\t\n194\t    *leaf_idx = (uint32_t)bytes_to_ull(bufp, SPX_LEAF_BYTES);\n195\t    *leaf_idx &= (~(uint32_t)0) >> (32 - SPX_LEAF_