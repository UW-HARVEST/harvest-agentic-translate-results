cJSON_Invalid (0)\n49\t#define cJSON_False  (1 << 0)\n50\t#define cJSON_True   (1 << 1)\n51\t#define cJSON_NULL   (1 << 2)\n52\t#define cJSON_Number (1 << 3)\n53\t#define cJSON_String (1 << 4)\n54\t#define cJSON_Array  (1 << 5)\n55\t#define cJSON_Object (1 << 6)\n56\t#define cJSON_Raw    (1 << 7) /* raw json */\n57\t\n58\t#define cJSON_IsReference 256\n59\t#define cJSON_StringIsConst 512\n60\t\n61\t/* The cJSON structure: */\n62\ttypedef struct cJSON\n63\t{\n64\t    /* next/prev allow you to walk array/object chains. Alternatively, use GetArraySize/GetArrayItem/GetObjectItem */\n65\t    struct cJSON *next;\n66\t    struct cJSON *prev;\n67\t    /* An array or object item will have a child pointer pointing to a chain of the items in the array/object. */\n68\t    struct cJSON *child;\n69\t\n70\t    /* The type of the item, as above. */\n71\t    int type;\n72\t\n73\t    /* The item's string, if type==cJSON_String  and type == cJSON_Raw */\n74\t    char *valuestring;\n75\t    /* writing to valueint is DEPRECATED, use cJSON_SetNumberValue instead */\n76\t    int valueint;\n77\t    /* The item's number, if type==cJSON_Number */\n78\t    double valuedouble;\n79\t\n80\t    /* The item's name string, if this item is the child of, or is in the list of subitems of an object. */\n81\t    char *string;\n82\t} cJSON;\n83\t\n84\ttypedef struct cJSON_Hooks\n85\t{\n86\t      /* malloc/free are CDECL on Windows regardless of the default calling convention of the compiler, so ensure the hooks allow passing those functions directly. */\n87\t      void *(CJSON_CDECL *malloc_fn)(size_t sz);\n88\t      void (CJSON_CDECL *free_fn)(void *ptr);\n89\t} cJSON_Hooks;\n90\t\n91\ttypedef int cJSON_bool;\n92\t\n93\t/* Limits how deeply nested arrays/objects can be before cJSON rejects to parse them.\n94\t * This is to prevent stack overflows. */\n95\t#ifndef CJSON_NESTING_LIMIT\n96\t#define CJSON_NESTING_LIMIT 1000\n97\t#endif\n98\t\n99\t/* Limits the length of circular references can be before cJSON rejects to parse them.\n100\t * This is to prevent stack overflows. */\n101\t#ifndef CJSON_CIRCULAR_LIMIT\n102\t#define CJSON_CIRCULAR_LIMIT 10000\n103\t#endif\n104\t\n105\t/* returns the version of cJSON as a string */\n106\tCJSON_PUBLIC(const char*) cJSON_Version(void);\n107\t\n108\t/* Supply malloc, realloc and free functions to cJSON */\n109\tCJSON_PUBLIC(void) cJSON_InitHooks(cJSON_Hooks* hooks);\n110\t\n111\t/* Memory Management: the caller is always responsible to free the results from all variants of cJSON_Parse (with cJSON_Delete) and cJSON_Print (with stdlib free, cJSON_Hooks.free_fn, or cJSON_free as appropriate). The exception is cJSON_PrintPreallocated, where the caller has full responsibility of the buffer. */\n112\t/* Supply a block of JSON, and this returns a cJSON object you can interrogate. */\n113\tCJSON_PUBLIC(cJSON *) cJSON_Parse(const char *value);\n114\tCJSON_PUBLIC(cJSON *) cJSON_ParseWithLength(const char *value, size_t buffer_length);\n115\t/* ParseWithOpts allows you to require (and check) that the JSON is null terminated, and to retrieve the pointer to the final byte parsed. */\n116\t/* If you supply a ptr in return_parse_end and parsing fails, then return_parse_end will contain a pointer to the error so will match cJSON_GetErrorPtr(). */\n117\tCJSON_PUBLIC(cJSON *) cJSON_ParseWithOpts(const char *value, const char **return_parse_end, cJSON_bool require_null_terminated);\n118\tCJSON_PUBLIC(cJSON *) cJSON_ParseWithLengthOpts(const char *value, size_t buffer_length, const char **return_parse_end, cJSON_bool require_null_terminated);\n119\t\n120\t/* Render a cJSON entity to text for transfer/storage. */\n121\tCJSON_PUBLIC(char *) cJSON_Print(const cJSON *item);\n122\t/* Render a cJSON entity to text for transfer/storage without any formatting. */\n123\tCJSON_PUBLIC(char *) cJSON_PrintUnformatted(const cJSON *item);\n124\t/* Render a cJSON entity to text using a buffered strategy. prebuffer is a guess at the final size. guessing well reduces reallocation. fmt=0 gives unformatted, =1 gives formatted */\n125\tCJSON_PUBLIC(char *) cJSON_PrintBuffered(const cJSON *item, int prebuffer, cJSON_bool fmt);\n126\t/* Render a cJSON entity to text using a buffer already allocated in memory with given length. Returns 1 on success and 0 on failure. */\n127\t/* NOTE: cJSON is not always 100% accurate in estimating how much memory it will use, so to be safe allocate 5 bytes more than you actually need */\n128\tCJSON_PUBLIC(cJSON_bool) cJSON_PrintPreallocated(cJSON *item, char *buffer, const int length, const cJSON_bool format);\n129\t/* Delete a cJSON entity and all subentities. */\n130\tCJSON_PUBLIC(void) cJSON_Delete(cJSON *item);\n131\t\n132\t/* Returns the number of items in an array (or object). */\n133\tCJSON_PUBLIC(int) cJSON_GetArraySize(const cJSON *array);\n134\t/* Retrieve item number \"index\" from array \"array\". Returns NULL if unsuccessful. */\n135\tCJSON_PUBLIC(cJSON *) cJSON_GetArrayItem(const cJSON *array, int index);\n136\t/* Get item \"string\" from object. Case insensitive. */\n137\tCJSON_PUBLIC(cJSON *) cJSON_GetObjectItem(const cJSON * const object, const char * const string);\n138\tCJSON_PUBLIC(cJSON *) cJSON_GetObjectItemCaseSensitive(const cJSON * const object, const char * const string);\n139\tCJSON_PUBLIC(cJSON_bool) cJSON_HasObjectItem(const cJSON *object, const char *string);\n140\t/* For analysing failed parses. This returns a pointer to the parse error. You'll probably need to look a few chars back to make sense of it. Defined when cJSON_Parse() returns 0. 0 when cJSON_Parse() succeeds. */\n141\tCJSON_PUBLIC(const char *) cJSON_GetErrorPtr(void);\n142\t\n143\t/* Check item type and return its value */\n144\tCJSON_PUBLIC(char *) cJSON_GetStringValue(const cJSON * const item);\n145\tCJSON_PUBLIC(double) cJSON_GetNumberValue(const cJSON * const item);\n146\t\n147\t/* These functions check the type of an item */\n148\tCJSON_PUBLIC(cJSON_bool) cJSON_IsInvalid(const cJSON * const item);\n149\tCJSON_PUBLIC(cJSON_bool) cJSON_IsFalse(const cJSON * const item);\n150\tCJSON_PUBLIC(cJSON_bool) cJSON_IsTrue(const cJSON * const item);\n151\tCJSON_PUBLIC(cJSON_bool) cJSON_IsBool(const cJSON * const item);\n152\tCJSON_PUBLIC(cJSON_bool) cJSON_IsNull(const cJSON * const item);\n153\tCJSON_PUBLIC(cJSON_bool) cJSON_IsNumber(const cJSON * const item);\n154\tCJSON_PUBLIC(cJSON_bool) cJSON_IsString(const cJSON * const item);\n155\tCJSON_PUBLIC(cJSON_bool) cJSON_IsArray(const cJSON * const item);\n156\tCJSON_PUBLIC(cJSON_bool) cJSON_IsObject(const cJSON * const item);\n157\tCJSON_PUBLIC(cJSON_bool) cJSON_IsRaw(const cJSON * const item);\n158\t\n159\t/* These calls create a cJSON item of the appropriate type. */\n160\tCJSON_PUBLIC(cJSON *) cJSON_CreateNull(void);\n161\tCJSON_PUBLIC(cJSON *) cJSON_CreateTrue(void);\n162\tCJSON_PUBLIC(cJSON *) cJSON_CreateFalse(void);\n163\tCJSON_PUBLIC(cJSON *) cJSON_CreateBool(cJSON_bool boolean);\n164\tCJSON_PUBLIC(cJSON *) cJSON_CreateNumber(double num);\n165\tCJSON_PUBLIC(cJSON *) cJSON_CreateString(const char *string);\n166\t/* raw json */\n167\tCJSON_PUBLIC(cJSON *) cJSON_CreateRaw(const char *raw);\n168\tCJSON_PUBLIC(cJSON *) cJSON_CreateArray(void);\n169\tCJSON_PUBLIC(cJSON *) cJSON_CreateObject(void);\n170\t\n171\t/* Create a string where valuestring references a string so\n172\t * it will not be freed by cJSON_Delete */\n173\tCJSON_PUBLIC(cJSON *) cJSON_CreateStringReference(const char *string);\n174\t/* Create an object/array that only references it's elements so\n175\t * they will not be freed by cJSON_Delete */\n176\tCJSON_PUBLIC(cJSON *) cJSON_CreateObjectReference(const cJSON *child);\n177\tCJSON_PUBLIC(cJSON *) cJSON_CreateArrayReference(const cJSON *child);\n178\t\n179\t/* These utilities create an Array of count items.\n180\t * The parameter count cannot be greater than the number of elements in the number array, otherwise array access will be out of bounds.*/\n181\tCJSON_PUBLIC(cJSON *) cJSON_CreateIntArray(const int *numbers, int count);\n182\tCJSON_PUBLIC(cJSON *) cJSON_CreateFloatArray(const float *numbers, int count);\n183\tCJSON_PUBLIC(cJSON *) cJSON_CreateDoubleArray(const double *numbers, int count);\n184\tCJSON_PUBLIC(cJSON *) cJSON_CreateStringArray(const char *const *strings, int count);\n185\t\n186\t/* Append item to the specified array/object. */\n187\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemToArray(cJSON *array, cJSON *item);\n188\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemToObject(cJSON *object, const char *string, cJSON *item);\n189\t/* Use this when string is definitely const (i.e. a literal, or as good as), and will definitely survive the cJSON object.\n190\t * WARNING: When this function was used, make sure to always check that (item->type & cJSON_StringIsConst) is zero before\n191\t * writing to `item->string` */\n192\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemToObjectCS(cJSON *object, const char *string, cJSON *item);\n193\t/* Append reference to item to the specified array/object. Use this when you want to add an existing cJSON to a new cJSON, but don't want to corrupt your existing cJSON. */\n194\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemReferenceToArray(cJSON *array, cJSON *item);\n195\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemReferenceToObject(cJSON *object, const char *string, cJSON *item);\n196\t\n197\t/* Remove/Detach items from Arrays/Objects. */\n198\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemViaPointer(cJSON *parent, cJSON * const item);\n199\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemFromArray(cJSON *array, int which);\n200\tCJSON_PUBLIC(void) cJSON_DeleteItemFromArray(cJSON *array, int which);\n201\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemFromObject(cJSON *object, const char *string);\n202\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemFromObjectCaseSensitive(cJSON *object, const char *string);\n203\tCJSON_PUBLIC(void) cJSON_DeleteItemFromObject(cJSON *object, const char *string);\n204\tCJSON_PUBLIC(void) cJSON_DeleteItemFromObjectCaseSensitive(cJSON *object, const char *string);\n205\t\n206\t/* Update array items. */\n207\tCJSON_PUBLIC(cJSON_bool) cJSON_InsertItemInArray(cJSON *array, int which, cJSON *newitem); /* Shifts pre-existing items to the right. */\n208\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemViaPointer(cJSON * const parent, cJSON * const item, cJSON * replacement);\n209\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemInArray(cJSON *array, int which, cJSON *newitem);\n210\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemInObject(cJSON *object,const char *string,cJSON *newitem);\n211\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemInObjectCaseSensitive(cJSON *object,const char *string,cJSON *newitem);\n212\t\n213\t/* Duplicate a cJSON item */\n214\tCJSON_PUBLIC(cJSON *) cJSON_Duplicate(const cJSON *item, cJSON_bool recurse);\n215\t/* Duplicate will create a new, identical cJSON item to the one you pass, in new memory that will\n216\t * need to be released. With recurse!=0, it will duplicate any children connected to the item.\n217\t * The item->next and ->prev pointers are always zero on return from Duplicate. */\n218\t/* Recursively compare two cJSON items for equality. If either a or b is NULL or invalid, they will be considered unequal.\n219\t * case_sensitive determines if object keys are treated case sensitive (1) or case insensitive (0) */\n220\tCJSON_PUBLIC(cJSON_bool) cJSON_Compare(const cJSON * const a, const cJSON * const b, const cJSON_bool case_sensitive);\n221\t\n222\t/* Minify a strings, remove blank characters(such as ' ', '\\t', '\\r', '\\n') from strings.\n223\t * The input pointer json cannot point to a read-only address area, such as a string constant, \n224\t * but should point to a readable and writable address area. */\n225\tCJSON_PUBLIC(void) cJSON_Minify(char *json);\n226\t\n227\t/* Helper functions for creating and adding items to an object at the same time.\n228\t * They return the added item or NULL on failure. */\n229\tCJSON_PUBLIC(cJSON*) cJSON_AddNullToObject(cJSON * const object, const char * const name);\n230\tCJSON_PUBLIC(cJSON*) cJSON_AddTrueToObject(cJSON * const object, const char * const name);\n231\tCJSON_PUBLIC(cJSON*) cJSON_AddFalseToObject(cJSON * const object, const char * const name);\n232\tCJSON_PUBLIC(cJSON*) cJSON_AddBoolToObject(cJSON * const object, const char * const name, const cJSON_bool boolean);\n233\tCJSON_PUBLIC(cJSON*) cJSON_AddNumberToObject(cJSON * const object, const char * const name, const double number);\n234\tCJSON_PUBLIC(cJSON*) cJSON_AddStringToObject(cJSON * const object, const char * const name, const char * const string);\n235\tCJSON_PUBLIC(cJSON*) cJSON_AddRawToObject(cJSON * const object, const char * const name, const char * const raw);\n236\tCJSON_PUBLIC(cJSON*) cJSON_AddObjectToObject(cJSON * const object, const char * const name);\n237\tCJSON_PUBLIC(cJSON*) cJSON_AddArrayToObject(cJSON * const object, const char * const name);\n238\t\n239\t/* When assigning an integer value, it needs to be propagated to valuedouble too. */\n240\t#define cJSON_SetIntValue(object, number) ((object) ? (object)->valueint = (object)->valuedouble = (number) : (number))\n241\t/* helper for the cJSON_SetNumberValue macro */\n242\tCJSON_PUBLIC(double) cJSON_SetNumberHelper(cJSON *object, double number);\n243\t#define cJSON_SetNumberValue(object, number) ((object != NULL) ? cJSON_SetNumberHelper(object, (double)number) : (number))\n244\t/* Change the valuestring of a cJSON_String object, only takes effect when type of object is cJSON_String */\n245\tCJSON_PUBLIC(char*) cJSON_SetValuestring(cJSON *object, const char *valuestring);\n246\t\n247\t/* If the object is not a boolean type this does nothing and returns cJSON_Invalid else it returns the new type*/\n248\t#define cJSON_SetBoolValue(object, boolValue) ( \\\n249\t    (object != NULL && ((object)->type & (cJSON_False|cJSON_True))) ? \\\n250\t    (object)->type=((object)->type &(~(cJSON_False|cJSON_True)))|((boolValue)?cJSON_True:cJSON_False) : \\\n251\t    cJSON_Invalid\\\n252\t)\n253\t\n254\t/* Macro for i