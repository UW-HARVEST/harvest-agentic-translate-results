t x2 = helper_ptr(a, b);\n    int x3 = use_generated(REPEAT);\n    int g  = G_OP(a, b);\n\n    printf(\"op=%s call=%d acc=%d g.call=%d\\n\", G_OP_NAME, r_call, acc, g);\n    printf(\"summary=%d\\n\", r_call + acc + x1 + x2 + x3 + g);\n    return 0;\n}\n","numLines":49,"startLine":1,"totalLines":49}}}
