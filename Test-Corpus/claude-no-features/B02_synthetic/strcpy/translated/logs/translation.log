s various string comparison operations\n39\t * \n40\t * @param input Input string buffer\n41\t * @param input_len Length of input buffer\n42\t * @param reference Reference string for comparison\n43\t * @param ref_len Length of reference buffer\n44\t * @param operation Operation code:\n45\t *                  0: validate token\n46\t *                  1: parse command\n47\t *                  2: compare prefix\n48\t *                  3: find delimiter\n49\t *                  4: match pattern\n50\t * @param flags Operation flags (case sensitivity, exact match, etc)\n51\t * @return Operation result (match count, position, or error code)\n52\t */\n53\tint process_strings(char *input, size_t input_len, \n54\t                   const char *reference, size_t ref_len,\n55\t                   int operation, uint32_t flags) {\n56\t    \n57\t    if (input == NULL) {\n58\t        return -1;\n59\t    }\n60\t    \n61\t    /* Different operations based on operation code */\n62\t    switch (operation) {\n63\t        case 0: {\n64\t            /* Validate token - VULNERABLE if input not null-terminated */\n65\t            if (reference == NULL) return -2;\n66\t            return validate_token(input, reference);\n67\t        }\n68\t        \n69\t        case 1: {\n70\t            /* Parse command from list - checks against multiple strings */\n71\t            const char *commands[] = {\"START\", \"STOP\", \"PAUSE\", \"RESUME\", \"RESET\"};\n72\t            return parse_command(input, input_len, commands, 5);\n73\t        }\n74\t        \n75\t        case 2: {\n76\t            /* Compare prefix - can use strcmp or strncmp based on flags */\n77\t            if (reference == NULL) return -2;\n78\t            int exact = (flags & 0x01);\n79\t            return compare_prefix(input, reference, exact);\n80\t        }\n81\t        \n82\t        case 3: {\n83\t            /* Find delimiter position */\n84\t            char delim = (reference && ref_len > 0) ? reference[0] : ':';\n85\t            return find_delimiter(input, input_len, delim);\n86\t        }\n87\t        \n88\t        case 4: {\n89\t            /* Match pattern - VULNERABLE in certain paths */\n90\t            if (reference == NULL) return -2;\n91\t            int case_sens = (flags & 0x02);\n92\t            return match_pattern(input, reference, case_sens);\n93\t        }\n94\t        \n95\t        default:\n96\t            return -3;\n97\t    }\n98\t}\n99\t\n100\t/**\n101\t * Validate token against expected value\n102\t * VULNERABLE: Uses strcmp without ensuring null termination\n103\t */\n104\tstatic int validate_token(const char *token, const char *expected) {\n105\t    /* Direct strcmp - will overflow if token not null-terminated */\n106\t    if (strcmp(token, expected) == 0) {\n107\t        return 1;  /* Valid */\n108\t    }\n109\t    \n110\t    /* Also check some common variations */\n111\t    if (strcmp(token, \"VALID\") == 0 || strcmp(token, \"OK\") == 0) {\n112\t        return 1;\n113\t    }\n114\t    \n115\t    return 0;  /* Invalid */\n116\t}\n117\t\n118\t/**\n119\t * Parse command from a list of valid commands\n120\t * Mix of safe and unsafe comparisons\n121\t */\n122\tstatic int parse_command(char *buffer, size_t buf_size, \n123\t                        const char *cmd_list[], int list_size) {\n124\t    \n125\t    /* Iterate through command list */\n126\t    for (int i = 0; i < list_size; i++) {\n127\t        /* Safe comparison using strncmp first */\n128\t        size_t cmd_len = strlen(cmd_list[i]);\n129\t        \n130\t        if (buf_size >= cmd_len) {\n131\t            if (strncmp(buffer, cmd_list[i], cmd_len) == 0) {\n132\t                /* Check if exact match - VULNERABLE if buffer not null-terminated */\n133\t                if (buffer[cmd_len] == '\\0' || buffer[cmd_len] == ' ') {\n134\t                    return i;  /* Return command index */\n135\t                }\n136\t            }\n137\t        }\n138\t        \n139\t        /* Fallback: direct strcmp -