  /* Manual search with bounds checking */\n199\t    for (size_t i = 0; i < len; i++) {\n200\t        if (data[i] == delim) {\n201\t            return (int)i;\n202\t        }\n203\t        if (data[i] == '\\0') {\n204\t            break;\n205\t        }\n206\t    }\n207\t    \n208\t    /* Check for special delimiter patterns using strcmp */\n209\t    /* VULNERABLE: doesn't verify data is null-terminated */\n210\t    if (delim == '|' && strcmp(data, \"NONE\") == 0) {\n211\t        return -2;  /* Special case */\n212\t    }\n213\t    \n214\t    if (delim == ':' && strcmp(data, \"EMPTY\") == 0) {\n215\t        return -3;  /* Special case */\n216\t    }\n217\t    \n218\t    return -1;  /* Not found */\n219\t}\n220\t\n221\t/**\n222\t * Match pattern with optional case sensitivity\n223\t * Multiple vulnerable strcmp calls\n224\t */\n225\tstatic int match_pattern(const char *text, const char *pattern, int case_sensitive) {\n226\t    \n227\t    if (case_sensitive) {\n228\t        /* Case-sensitive exact match - VULNERABLE */\n229\t        if (strcmp(text, pattern) == 0) {\n230\t            return 1;\n231\t        }\n232\t        \n233\t        /* Try with wildcards - construct patterns */\n234\t        char wildcard_patterns[3][64];\n235\t        snprintf(wildcard_patterns[0], 64, \"*%s*\", pattern);\n236\t        snprintf(wildcard_patterns[1], 64, \"%s*\", pattern);\n237\t        snprintf(wildcard_patterns[2], 64, \"*%s\", pattern);\n238\t        \n239\t        /* VULNERABLE: strcmp on unbounded text */\n240\t        for (int i = 0; i < 3; i++) {\n241\t            if (strcmp(text, wildcard_patterns[i]) == 0) {\n242\t                return 2 + i;\n243\t            }\n244\t        }\n245\t        \n246\t        /* Check if text contains pattern - uses strncmp safely */\n247\t        size_t text_len = strlen(text);\n248\t        size_t pattern_len = strlen(pattern);\n249\t        \n250\t        for (size_t i = 0; i <= text_len - pattern_len; i++) {\n251\t            if (strnc