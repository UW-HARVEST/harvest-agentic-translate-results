\n\", result.operator_count);\n    let _ = write!(out, \"Comments: {}\\n\", result.comment_count);\n    let _ = write!(out, \"Strings: {}\\n\", result.string_count);\n    let _ = write!(out, \"Lines: {}\\n\", result.line_count);\n    let _ = write!(out, \"Characters: {}\\n\", result.char_count);\n}\n\n/// Read one line from stdin like fgets with a fixed-size buffer of `size` bytes.\n/// Returns None on EOF with no data read. Otherwise returns the bytes read,\n/// including the trailing newline if encountered. Behaves like C's fgets:\n/// reads up to size-1 bytes (we'll treat `size` as the buffer size).\nfn fgets_line(stdin: &mut impl Read, size: usize) -> Option<Vec<u8>> {\n    if size <= 1 {\n        return Some(Vec::new());\n    }\n    let mut buf = Vec::with_capacity(size);\n    let mut byte = [0u8; 1];\n    loop {\n        if buf.len() >= size - 1 {\n            break;\n        }\n        match stdin.read(&mut byte) {\n            Ok(0) => {\n                if buf.is_empty() {\n                    return None;\n                }\n                break;\n            }\n            Ok(_) => {\n                buf.push(byte[0]);\n                if byte[0] == b'\\n' {\n                    break;\n                }\n            }\n            Err(_) => {\n                if buf.is_empty() {\n                    return None;\n                }\n                break;\n            }\n        }\n    }\n    Some(buf)\n}\n\n/// Append `src` to `dst`, behaving like C's `strncat(dst, src, n)` where `n`\n/// is the maximum number of bytes from `src` to append. We ensure `dst.len()`\n/// stays within `cap` (effective buffer capacity minus 1 for null terminator).\n/// Stops appending when src has a NUL byte (matches C string semantics).\nfn strncat_emulate(dst: &mut Vec<u8>, src: &[u8], n: usize) {\n    let mut count = 0usize;\n    for &b in src.iter() {\n        if count >= n {\n            break;\n        }\n        if b == 0 {\n            break;\n        }\n        dst.push(b);\n        count += 1;\n    }\n}\n\n/// Returns the C-string length: bytes up to first NUL or end of slice.\nfn c_strlen(s: &[u8]) -> usize {\n    s.iter().position(|&b| b == 0).unwrap_or(s.len())\n}\n\n/// Read text accumulator that mimics:\n///   char text[MAX_INPUT_SIZE] = \"\";\n///   while (fgets(line,256,stdin)) { if (line[0]=='\\n') break;\n///       strncat(text, line, MAX_INPUT_SIZE - strlen(text) - 1); }\nfn read_text_accumulator(stdin: &mut impl Read) -> Vec<u8> {\n    let mut text: Vec<u8> = Vec::with_capacity(MAX_INPUT_SIZE);\n    loop {\n        let line = match fgets_line(stdin, 256) {\n            Some(l) => l,\n            None => break,\n        };\n        if line.is_empty() {\n            // Shouldn't happen with fgets returning Some non-EOF\n            break;\n        }\n        if line[0] == b'\\n' {\n            break;\n        }\n        let cur_len = c_strlen(&text);\n        // C: strncat(text, line, MAX_INPUT_SIZE - strlen(text) - 1)\n        // If MAX_INPUT_SIZE - cur_len - 1 underflows (size_t), it would be huge\n        // and effectively unlimited; but in practice this is bounded by line length.\n        let n = MAX_INPUT_SIZE.saturating_sub(cur_len).saturating_sub(1);\n        strncat_emulate(&mut text, &line, n);\n    }\n    text\n}\n\n/// sscanf \"%d\" emulation: skip leading whitespace, then parse a sequence of\n/// optional sign + digits. Returns (matched_count, value). matched_count is 1\n/// if at least one digit was parsed, otherwise 0.\nfn sscanf_int(s: &[u8]) -> (i32, i32) {\n    let mut i = 0;\n    while i < s.len() && (s[i] as char).is_whitespace() {\n        i += 1;\n    }\n    let mut sign: i32 = 1;\n    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n        if s[i] == b'-' {\n            sign = -1;\n        }\n        i += 1;\n    }\n    let start = i;\n    let mut val: i64 = 0;\n    while i < s.len() && (b'0'..=b'9').contains(&s[i]) {\n        val = val * 10 + (s[i] - b'0') as i64;\n        i += 1;\n    }\n    if i == start {\n        return (0, 0);\n    }\n    let v = (val * sign as i64) as i32;\n    (1, v)\n}\n\nfn interactive_tokenizer(ops: TokenizerOps, stdin: &mut impl Read) {\n    {\n        let mut out = std::io::stdout().lock();\n        let _ = out.write_all(b\"\\nEnter text (empty line to stop):\\n\");\n        let _ = out.flush();\n    }\n\n    let input = read_text_accumulator(stdin);\n\n    if (ops.load_text)(&input) != 0 {\n        let mut out = std::io::stdout().lock();\n        let _ = out.write_all(b\"Failed to load text\\n\");\n        return;\n    }\n\n    {\n        let mut out = std::io::stdout().lock();\n        let _ = out.write_all(b\"\\n=== Tokens ===\\n\");\n    }\n\n    let token_type_names: [&str; 12] = [\n        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCT\", \"SPACE\", \"NEWLINE\", \"IDENT\", \"KEYWORD\", \"OPERATOR\",\n        \"STRING\", \"COMMENT\", \"ERROR\",\n    ];\n\n    let mut count = 0;\n    loop {\n        let token = (ops.next_token)();\n        if token.token_type == TokenType::Eof {\n            break;\n        }\n        let mut out = std::io::stdout().lock();\n        let _ = write!(out, \"[{}] '\", token_type_names[token.token_type as usize]);\n        let _ = out.write_all(&token.value);\n        let _ = write!(out, \"' (L{}:C{})\\n\", token.line, token.column);\n        count += 1;\n        if count > 100 {\n            let _ = out.write_all(b\"... (truncated, too many tokens)\\n\");\n            break;\n        }\n    }\n}\n\nfn read_file(filename: &[u8]) -> Option<Vec<u8>> {\n    use std::ffi::OsStr;\n    use std::os::unix::ffi::OsStrExt;\n    let path = OsStr::from_bytes(filename);\n    let mut file = match std::fs::File::open(path) {\n        Ok(f) => f,\n        Err(_) => {\n            let mut err = std::io::stderr().lock();\n            let _ = err.write_all(b\"Error: Could not open file '\");\n            let _ = err.write_all(filename);\n            let _ = err.write_all(b\"'\\n\");\n            return None;\n        }\n    };\n\n    let size = match file.metadata() {\n        Ok(m) => m.len() as i64,\n        Err(_) => 0,\n    };\n\n    if size > MAX_BUFFER_SIZE as i64 {\n        let mut err = std::io::stderr().lock();\n        let _ = err.write_all(b\"Error: File too large\\n\");\n        return None;\n    }\n\n    let mut content = Vec::with_capacity(size as usize);\n    if file.read_to_end(&mut content).is_err() {\n        return None;\n    }\n    // Truncate to size in case file grew (matches fread reading exactly `size` bytes)\n    if content.len() > size as usize {\n        content.truncate(size as usize);\n    }\n    Some(content)\n}\n\n/// Strip trailing newline from a buffer (matches `input[strcspn(input,\"\\n\")] = 0;`)\n/// In C this replaces the first '\\n' with '\\0', truncating the C string there.\nfn strip_first_newline(buf: &mut Vec<u8>) {\n    if let Some(pos) = buf.iter().position(|&b| b == b'\\n') {\n        buf.truncate(pos);\n    }\n}\n\nfn main() {\n    let ops = get_tokenizer_ops();\n    analyzer_init(ops);\n\n    {\n        let mut out = std::io::stdout().lock();\n        let _ = out.write_all(b\"Text Analysis and Tokenization System\\n\");\n        let _ = out.write_all(b\"This system demonstrates function pointers and static globals\\n\");\n    }\n\n    let mut stdin = std::io::stdin();\n\n    loop {\n        print_menu();\n\n        let input = match fgets_line(&mut stdin, 256) {\n            Some(l) => l,\n            None => break,\n        };\n\n        let (matched, choice) = sscanf_int(&input);\n        if matched != 1 {\n            let mut out = std::io::stdout().lock();\n            let _ = out.write_all(b\"Invalid input\\n\");\n            continue;\n        }\n\n        match choice {\n            1 => {\n                {\n                    let mut out = std::io::stdout().lock();\n                    let _ = out.write_all(b\"Enter text to analyze (empty line to stop):\\n\");\n                    let _ = out.flush();\n                }\n                let text = read_text_accumulator(&mut stdin);\n                let result = analyze_text(&text);\n                print_analysis_result(result);\n            }\n            2 => {\n                {\n                    let mut out = std::io::stdout().lock();\n                    let _ = out.write_all(b\"Enter filename: \");\n                    let _ = out.flush();\n                }\n                let mut input2 = match fgets_line(&mut stdin, 256) {\n                    Some(l) => l,\n                    None => break,\n                };\n                strip_first_newline(&mut input2);\n                if let Some(content) = read_file(&input2) {\n                    let result = analyze_text(&content);\n                    print_analysis_result(result);\n                }\n            }\n            3 => {\n                print_token_distribution();\n            }\n            4 => {\n                let score = calculate_complexity_score();\n                let mut out = std::io::stdout().lock();\n                let _ = write!(out, \"\\nComplexity Score: {}\\n\", score);\n                if score < 10 {\n                    let _ = out.write_all(b\"Complexity: Low\\n\");\n                } else if score < 50 {\n                    let _ = out.write_all(b\"Complexity: Medium\\n\");\n                } else {\n                    let _ = out.write_all(b\"Complexity: High\\n\");\n                }\n            }\n            5 => {\n                {\n                    let mut out = std::io::stdout().lock();\n                    let _ = out.write_all(b\"Enter pattern to search: \");\n                    let _ = out.flush();\n                }\n                let mut input2 = match fgets_line(&mut stdin, 256) {\n                    Some(l) => l,\n                    None => break,\n                };\n                strip_first_newline(&mut input2);\n                find_patterns(&input2);\n            }\n            6 => {\n                interactive_tokenizer(ops, &mut stdin);\n            }\n            7 => {\n                let mut out = std::io::stdout().lock();\n                let _ = out.write_all(b\"Goodbye!\\n\");\n                return;\n            }\n            _ => {\n                let mut out = std::io::stdout().lock();\n                let _ = out.write_all(b\"Invalid choice\\n\");\n            }\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
