eturn (perms & required) == required;\n49\t}\n50\t\n51\tint safe_add(int a, int b, int perms) {\n52\t    if (!check_permissions(perms, READ_PERM | WRITE_PERM)) {\n53\t        printf(\"Insufficient permissions for addition\\n\");\n54\t        return 0;\n55\t    }\n56\t    return a + b;\n57\t}\n58\t\n59\tint multiply_with_log(int a, int b, char** log_msg) {\n60\t    *log_msg = create_result_string(\"multiply\", a * b);\n61\t    if (*log_msg == NULL) {\n62\t        return 0;\n63\t    }\n64\t    return a * b;\n65\t}\n66\t\n67\tint copy_and_sum(int* src, int count) {\n68\t    if (src == NULL) {\n69\t        printf(\"Source pointer is NULL\\n\");\n70\t        return -1;\n71\t    }\n72\t\n73\t    int* dest = (int*)malloc(count * sizeof(int));\n74\t    if (dest == NULL) {\n75\t        printf(\"Memory allocation failed\\n\");\n76\t        return -1;\n77\t    }\n78\t\n79\t    memcpy(dest, src, count * sizeof(int));\n80\t\n81\t    int sum = 0;\n82\t    for (int i = 0; i < count; i++) {\n83\t        sum += dest[i];\n84\t    }\n85\t\n86\t    free(dest);\n87\t    return sum;\n88\t}\n89\t\n90\tint compare_operations(const char* op1, const char* op2) {\n91\t    if (op1 == NULL || op2 == NULL) {\n92\t        printf(\"One or both operation strings are NULL\\n\");\n93\t        return -1;\n94\t    }\n95\t\n96\t    return strcmp(op1, op2);\n97\t}\n98\t\n99\tint complexmode(int mode, int value1, int value2, int value3) {\n100\t    int result = 0;\n101\t    char* log_message = NULL;\n102\t\n103\t    int permissions = 0644;  // rw-r--r--\n104\t\n105\t    Result* res_tracker = (Result*)malloc(sizeof(Result));\n106\t    if (res_tracker == NULL) {\n107\t        printf(\"Failed to allocate result tracker\\n\");\n108\t        return -1;\n109\t    }\n110\t\n111\t    res_tracker->value = 0;\n112\t    res_tracker->permissions = permissions;\n113\t    strcpy(res_tracker->operation, \"none\");\n114\t\n115\t    switch (mode) {\n116\t        case 1: {\n117\t            strcpy(res_tracker->operation, \"addition\");\n118\t            result = safe_add(value1, value2, permissions);\n119\t            res_tracker->value = result;\n120\t\n121\t            printf(\"Mode 1: Addition\\n\");\n122\t            printf(\"Result: %d\\n\", result);\n123\t            break;\n124\t        }\n125\t\n126\t        case 2: {\n127\t            strcpy(res_tracker->operation, \"multiplication\");\n128\t            result = multiply_with_log(value1, value2, &log_message);\n129\t            res_tracker->value = result;\n130\t\n131\t            if (log_message == NULL || strcmp(log_message, \"\") == 0) {\n132\t                printf(\"Log message creation failed\\n\");\n133\t            } else {\n134\t                printf(\"Mode 2: %s\\n\", log_message);\n135\t                free(log_message);\n136\t            }\n137\t            break;\n138\t        }\n139\t\n140\t        case 3: {\n141\t            strcpy(res_tracker->operation, \"array_sum\");\n142\t            int values[3] = {value1, value2, value3};\n143\t            result = copy_and_sum(values, 3);\n144\t            res_tracker->value = result;\n145\t\n146\t            printf(\"Mode 3: Array Sum\\n\");\n147\t            printf(\"Result: %d\\n\", result);\n148\t            break;\n149\t        }\n150\t\n151\t        case 4: {\n152\t            strcpy(res_tracker->operation, \"complex\");\n153\t\n154\t            if (check_permissions(permissions, 0100)) {\n155\t                result = (value1 * value2) + value3;\n156\t            } else {\n157\t                result = value1 + value2 + value3;\n158\t            }\n159\t\n160\t            res_tracker->value = result;\n161\t            printf(\"Mode 4: Complex Calculation\\n\");\n162\t            printf(\"Result: %d\\n\", result);\n163\t            break;\n164\t        }\n165\t\n166\t        default: {\n167\t            printf(\"Invalid mode\\n\");\n168\t            result = -1;\n169\t            break;\n170\t        }\n171\t    }\n172\t\n173\t    if (strcmp(res_tracker->operat