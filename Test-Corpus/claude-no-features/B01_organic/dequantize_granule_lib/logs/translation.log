17 {\n                    let half: i32 = (1i32.wrapping_shl((ba - 1) as u32)).wrapping_sub(1);\n                    for k in 0..group_size {\n                        let v = get_bits(bs, ba) as i32;\n                        let val = (v.wrapping_sub(half)) as f32;\n                        *grbuf.offset(dst_offset + k as isize) = val;\n                    }\n                } else {\n                    let mod_: u32 = (2u32.wrapping_shl((ba - 17) as u32)).wrapping_add(1);\n                    let n_bits: i32 = mod_.wrapping_add(2).wrapping_sub(mod_ >> 3) as i32;\n                    let mut code: u32 = get_bits(bs, n_bits);\n                    for k in 0..group_size {\n                        let val = ((code % mod_).wrapping_sub(mod_ / 2)) as i32 as f32;\n                        *grbuf.offset(dst_offset + k as isize) = val;\n                        code /= mod_;\n                    }\n                }\n            }\n            dst_offset += choff;\n            choff = 18 - choff;\n        }\n    }\n    group_size.wrapping_mul(4)\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":278,"cache_read_input_tokens":15263,"cache_creation":{"ephemeral_5m_input_tokens":278,"ephemeral_1h_input_tokens":0},"output_tokens":39,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0311f982-15d2-49d5-90cf-dd6ed04a7d8c","uuid":"63c41897-fd5a-4c43-9c66-a4f52d7f2400"}
