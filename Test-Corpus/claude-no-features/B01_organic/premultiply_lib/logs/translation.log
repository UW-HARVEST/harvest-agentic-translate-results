t(idx + 2) as f32 / 255.0_f32;\n        let r = r * a;\n        let g = g * a;\n        let b = b * a;\n        *data.offset(idx) = (r * 255.0_f32) as u8;\n        *data.offset(idx + 1) = (g * 255.0_f32) as u8;\n        *data.offset(idx + 2) = (b * 255.0_f32) as u8;\n        i += pixel_size;\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":3,"newStart":1,"newLines":5,"lines":["+#![allow(non_camel_case_types)]","+"," use std::ffi::c_int;"," "," #[repr(C)]"]}],"userModified":false,"replaceAll":false}}
