  | ((x & 0x3F000000) << 2);\n    }\n}\n\n#[inline]\nfn rotr16(x: u32) -> u32 {\n    (x << 16) | (x >> 16)\n}\n\n#[inline]\nfn mix_columns32(q: &mut [u32; 8]) {\n    let q0 = q[0];\n    let q1 = q[1];\n    let q2 = q[2];\n    let q3 = q[3];\n    let q4 = q[4];\n    let q5 = q[5];\n    let q6 = q[6];\n    let q7 = q[7];\n    let r0 = (q0 >> 8) | (q0 << 24);\n    let r1 = (q1 >> 8) | (q1 << 24);\n    let r2 = (q2 >> 8) | (q2 << 24);\n    let r3 = (q3 >> 8) | (q3 << 24);\n    let r4 = (q4 >> 8) | (q4 << 24);\n    let r5 = (q5 >> 8) | (q5 << 24);\n    let r6 = (q6 >> 8) | (q6 << 24);\n    let r7 = (q7 >> 8) | (q7 << 24);\n\n    q[0] = q7 ^ r7 ^ r0 ^ rotr16(q0 ^ r0);\n    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr16(q1 ^ r1);\n    q[2] = q1 ^ r1 ^ r2 ^ rotr16(q2 ^ r2);\n    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr16(q3 ^ r3);\n    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr16(q4 ^ r4);\n    q[5] = q4 ^ r4 ^ r5 ^ rotr16(q5 ^ r5);\n    q[6] = q5 ^ r5 ^ r6 ^ rotr16(q6 ^ r6);\n    q[7] = q6 ^ r6 ^ r7 ^ rotr16(q7 ^ r7);\n}\n\nfn br_aes_ct64_ortho(q: &mut [u64; 8]) {\n    fn swapn(cl: u64, ch: u64, s: u32, x: &mut u64, y: &mut u64) {\n        let a = *x;\n        let b = *y;\n        *x = (a & cl) | ((b & cl) << s);\n        *y = ((a & ch) >> s) | (b & ch);\n    }\n    macro_rules! swap2 { ($x:expr, $y:expr) => {{\n        let (a, b) = $crate::haraka::split_idx64($x, $y, q);\n        swapn(0x5555555555555555, 0xAAAAAAAAAAAAAAAA, 1, a, b);\n    }};}\n    macro_rules! swap4 { ($x:expr, $y:expr) => {{\n        let (a, b) = $crate::haraka::split_idx64($x, $y, q);\n        swapn(0x3333333333333333, 0xCCCCCCCCCCCCCCCC, 2, a, b);\n    }};}\n    macro_rules! swap8 { ($x:expr, $y:expr) => {{\n        let (a, b) = $crate::haraka::split_idx64($x, $y, q);\n        swapn(0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0, 4, a, b);\n    }};}\n\n    swap2!(0, 1);\n    swap2!(2, 3);\n    swap2!(4, 5);\n    swap2!(6, 7);\n\n    swap4!(0, 2);\n    swap4!(1, 3);\n    swap4!(4, 6);\n    swap4!(5, 7);\n\n    swap8!(0, 4);\n    swap8!(1, 5);\n    swap8!(2, 6);\n    swap8!(3, 7);\n}\n\nfn br_aes_ct64_interleave_in(q0: &mut u64, q1: &mut u64, w: &[u32]) {\n    let mut x0 = w[0] as u64;\n    let mut x1 = w[1] as u64;\n    let mut x2 = w[2] as u64;\n    let mut x3 = w[3] as u64;\n    x0 |= x0 << 16;\n    x1 |= x1 << 16;\n    x2 |= x2 << 16;\n    x3 |= x3 << 16;\n    x0 &= 0x0000FFFF0000FFFF;\n    x1 &= 0x0000FFFF0000FFFF;\n    x2 &= 0x0000FFFF0000FFFF;\n    x3 &= 0x0000FFFF0000FFFF;\n    x0 |= x0 << 8;\n    x1 |= x1 << 8;\n    x2 |= x2 << 8;\n    x3 |= x3 << 8;\n    x0 &= 0x00FF00FF00FF00FF;\n    x1 &= 0x00FF00FF00FF00FF;\n    x2 &= 0x00FF00FF00FF00FF;\n    x3 &= 0x00FF00FF00FF00FF;\n    *q0 = x0 | (x2 << 8);\n    *q1 = x1 | (x3 << 8);\n}\n\nfn br_aes_ct64_interleave_out(w: &mut [u32], q0: u64, q1: u64) {\n    let mut x0 = q0 & 0x00FF00FF00FF00FF;\n    let mut x1 = q1 & 0x00FF00FF00FF00FF;\n    let mut x2 = (q0 >> 8) & 0x00FF00FF00FF00FF;\n    let mut x3 = (q1 >> 8) & 0x00FF00FF00FF00FF;\n    x0 |= x0 >> 8;\n    x1 |= x1 >> 8;\n    x2 |= x2 >> 8;\n    x3 |= x3 >> 8;\n    x0 &= 0x0000FFFF0000FFFF;\n    x1 &= 0x0000FFFF0000FFFF;\n    x2 &= 0x0000FFFF0000FFFF;\n    x3 &= 0x0000FFFF0000FFFF;\n    w[0] = (x0 as u32) | ((x0 >> 16) as u32);\n    w[1] = (x1 as u32) | ((x1 >> 16) as u32);\n    w[2] = (x2 as u32) | ((x2 >> 16) as u32);\n    w[3] = (x3 as u32) | ((x3 >> 16) as u32);\n}\n\n#[inline]\nfn add_round_key(q: &mut [u64; 8], sk: &[u64; 8]) {\n    for i in 0..8 {\n        q[i] ^= sk[i];\n    }\n}\n\n#[inline]\nfn shift_rows(q: &mut [u64; 8]) {\n    for i in 0..8 {\n        let x = q[i];\n        q[i] = (x & 0x000000000000FFFF)\n            | ((x & 0x00000000FFF00000) >> 4)\n            | ((x & 0x00000000000F0000) << 12)\n            | ((x & 0x0000FF0000000000) >> 8)\n            | ((x & 0x000000FF00000000) << 8)\n            | ((x & 0xF000000000000000) >> 12)\n            | ((x & 0x0FFF000000000000) << 4);\n    }\n}\n\n#[inline]\nfn rotr32(x: u64) -> u64 {\n    (x << 32) | (x >> 32)\n}\n\n#[inline]\nfn mix_columns(q: &mut [u64; 8]) {\n    let q0 = q[0];\n    let q1 = q[1];\n    let q2 = q[2];\n    let q3 = q[3];\n    let q4 = q[4];\n    let q5 = q[5];\n    let q6 = q[6];\n    let q7 = q[7];\n    let r0 = (q0 >> 16) | (q0 << 48);\n    let r1 = (q1 >> 16) | (q1 << 48);\n    let r2 = (q2 >> 16) | (q2 << 48);\n    let r3 = (q3 >> 16) | (q3 << 48);\n    let r4 = (q4 >> 16) | (q4 << 48);\n    let r5 = (q5 >> 16) | (q5 << 48);\n    let r6 = (q6 >> 16) | (q6 << 48);\n    let r7 = (q7 >> 16) | (q7 << 48);\n\n    q[0] = q7 ^ r7 ^ r0 ^ rotr32(q0 ^ r0);\n    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr32(q1 ^ r1);\n    q[2] = q1 ^ r1 ^ r2 ^ rotr32(q2 ^ r2);\n    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr32(q3 ^ r3);\n    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr32(q4 ^ r4);\n    q[5] = q4 ^ r4 ^ r5 ^ rotr32(q5 ^ r5);\n    q[6] = q5 ^ r5 ^ r6 ^ rotr32(q6 ^ r6);\n    q[7] = q6 ^ r6 ^ r7 ^ rotr32(q7 ^ r7);\n}\n\nfn interleave_constant(out: &mut [u64; 8], input: &[u8]) {\n    let mut tmp = [0u32; 16];\n    br_range_dec32le(&mut tmp, 16, input);\n    let mut tmp_out = [0u64; 8];\n    for i in 0..4 {\n        let mut q0 = tmp_out[i];\n        let mut q1 = tmp_out[i + 4];\n        br_aes_ct64_interleave_in(&mut q0, &mut q1, &tmp[i * 4..]);\n        tmp_out[i] = q0;\n        tmp_out[i + 4] = q1;\n    }\n    br_aes_ct64_ortho(&mut tmp_out);\n    *out = tmp_out;\n}\n\nfn interleave_constant32(out: &mut [u32; 8], input: &[u8]) {\n    for i in 0..4 {\n        out[2 * i] = br_dec32le(&input[4 * i..]);\n        out[2 * i + 1] = br_dec32le(&input[4 * i + 16..]);\n    }\n    br_aes_ct_ortho(out);\n}\n\npub fn tweak_constants_safe(ctx: &mut SpxCtx) {\n    // Use the standard constants to generate tweaked ones\n    ctx.tweaked512_rc64 = HARAKA512_RC64;\n\n    let mut buf = [0u8; 40 * 16];\n    haraka_s_safe(&mut buf, &ctx.pub_seed.clone(), ctx);\n\n    for i in 0..10 {\n        let mut t256 = [0u32; 8];\n        interleave_constant32(&mut t256, &buf[32 * i..]);\n        ctx.tweaked256_rc32[i] = t256;\n        let mut t512 = [0u64; 8];\n        interleave_constant(&mut t512, &buf[64 * i..]);\n        ctx.tweaked512_rc64[i] = t512;\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn SPX_tweak_constants(ctx: *mut SpxCtx) {\n    unsafe {\n        tweak_constants_safe(&mut *ctx);\n    }\n}\n\npub fn haraka512_perm_safe(out: &mut [u8; 64], input: &[u8; 64], ctx: &SpxCtx) {\n    let mut w = [0u32; 16];\n    let mut q = [0u64; 8];\n\n    br_range_dec32le(&mut w, 16, input);\n    for i in 0..4 {\n        let mut q0 = q[i];\n        let mut q1 = q[i + 4];\n        br_aes_ct64_interleave_in(&mut q0, &mut q1, &w[i * 4..]);\n        q[i] = q0;\n        q[i + 4] = q1;\n    }\n    br_aes_ct64_ortho(&mut q);\n\n    for i in 0..5 {\n        for j in 0..2 {\n            br_aes_ct64_bitslice_sbox(&mut q);\n            shift_rows(&mut q);\n            mix_columns(&mut q);\n            add_round_key(&mut q, &ctx.tweaked512_rc64[2 * i + j]);\n        }\n        for j in 0..8 {\n            let tmp_q = q[j];\n            q[j] = (tmp_q & 0x0001000100010001) << 5\n                | (tmp_q & 0x0002000200020002) << 12\n                | (tmp_q & 0x0004000400040004) >> 1\n                | (tmp_q & 0x0008000800080008) << 6\n                | (tmp_q & 0x0020002000200020) << 9\n                | (tmp_q & 0x0040004000400040) >> 4\n                | (tmp_q & 0x0080008000800080) << 3\n                | (tmp_q & 0x2100210021002100) >> 5\n                | (tmp_q & 0x0210021002100210) << 2\n                | (tmp_q & 0x0800080008000800) << 4\n                | (tmp_q & 0x1000100010001000) >> 12\n                | (tmp_q & 0x4000400040004000) >> 10\n                | (tmp_q & 0x8400840084008400) >> 3;\n        }\n    }\n\n    br_aes_ct64_ortho(&mut q);\n    for i in 0..4 {\n        let q0 = q[i];\n        let q1 = q[i + 4];\n        br_aes_ct64_interleave_out(&mut w[i * 4..], q0, q1);\n    }\n    br_range_enc32le(out, &w, 16);\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn SPX_haraka512_perm(out: *mut u8, input: *const u8, ctx: *const SpxCtx) {\n    unsafe {\n        let in_ref = &*(input as *const [u8; 64]);\n        let mut out_buf = [0u8; 64];\n        haraka512_perm_safe(&mut out_buf, in_ref, &*ctx);\n        std::ptr::copy_nonoverlapping(out_buf.as_ptr(), out, 64);\n    }\n}\n\npub fn haraka512_safe(out: &mut [u8], input: &[u8; 64], ctx: &SpxCtx) {\n    let mut buf = [0u8; 64];\n    haraka512_perm_safe(&mut buf, input, ctx);\n    for i in 0..64 {\n        buf[i] ^= input[i];\n    }\n    out[..8].copy_from_slice(&buf[8..16]);\n    out[8..16].copy_from_slice(&buf[24..32]);\n    out[16..24].copy_from_slice(&buf[32..40]);\n    out[24..32].copy_from_slice(&buf[48..56]);\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn SPX_haraka512(out: *mut u8, input: *const u8, ctx: *const SpxCtx) {\n    unsafe {\n        let in_ref = &*(input as *const [u8; 64]);\n        let mut out_buf = [0u8; 32];\n        haraka512_safe(&mut out_buf, in_ref, &*ctx);\n        std::ptr::copy_nonoverlapping(out_buf.as_ptr(), out, 32);\n    }\n}\n\npub fn haraka256_safe(out: &mut [u8; 32], input: &[u8; 32], ctx: &SpxCtx) {\n    let mut q = [0u32; 8];\n\n    for i in 0..4 {\n        q[2 * i] = br_dec32le(&input[4 * i..]);\n        q[2 * i + 1] = br_dec32le(&input[4 * i + 16..]);\n    }\n    br_aes_ct_ortho(&mut q);\n\n    for i in 0..5 {\n        for j in 0..2 {\n            br_aes_ct_bitslice_sbox(&mut q);\n            shift_rows32(&mut q);\n            mix_columns32(&mut q);\n            add_round_key32(&mut q, &ctx.tweaked256_rc32[2 * i + j]);\n        }\n        for j in 0..8 {\n            let tmp_q = q[j];\n            q[j] = (tmp_q & 0x81818181)\n                | (tmp_q & 0x02020202) << 1\n                | (tmp_q & 0x04040404) << 2\n                | (tmp_q & 0x08080808) << 3\n                | (tmp_q & 0x10101010) >> 3\n                | (tmp_q & 0x20202020) >> 2\n                | (tmp_q & 0x40404040) >> 1;\n        }\n    }\n\n    br_aes_ct_ortho(&mut q);\n    for i in 0..4 {\n        br_enc32le(&mut out[4 * i..], q[2 * i]);\n        br_enc32le(&mut out[4 * i + 16..], q[2 * i + 1]);\n    }\n    for i in 0..32 {\n        out[i] ^= input[i];\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn SPX_haraka256(out: *mut u8, input: *const u8, ctx: *const SpxCtx) {\n    unsafe {\n        let in_ref = &*(input as *const [u8; 32]);\n        let mut out_buf = [0u8; 32];\n        haraka256_safe(&mut out_buf, in_ref, &*ctx);\n        std::ptr::copy_nonoverlapping(out_buf.as_ptr(), out, 32);\n    }\n}\n\nfn haraka_s_absorb(s: &mut [u8; 64], r: usize, mut m: &[u8], mut mlen: usize, p: u8, ctx: &SpxCtx) {\n    let mut t = vec![0u8; r];\n\n    while mlen >= r {\n        for i in 0..r {\n            s[i] ^= m[i];\n        }\n        let mut tmp = [0u8; 64];\n        haraka512_perm_safe(&mut tmp, s, ctx);\n        *s = tmp;\n        mlen -= r;\n        m = &m[r..];\n    }\n\n    for i in 0..r {\n        t[i] = 0;\n    }\n    for i in 0..mlen {\n        t[i] = m[i];\n    }\n    t[mlen] = p;\n    t[r - 1] |= 128;\n    for i in 0..r {\n        s[i] ^= t[i];\n    }\n}\n\nfn haraka_s_squeezeblocks(h: &mut [u8], mut nblocks: usize, s: &mut [u8; 64], r: usize, ctx: &SpxCtx) {\n    let mut h_off = 0;\n    while nblocks > 0 {\n        let mut tmp = [0u8; 64];\n        haraka512_perm_safe(&mut tmp, s, ctx);\n        *s = tmp;\n        h[h_off..h_off + HARAKAS_RATE].copy_from_slice(&s[..HARAKAS_RATE]);\n        h_off += r;\n        nblocks -= 1;\n    }\n}\n\npub fn haraka_s_safe(out: &mut [u8], input: &[u8], ctx: &SpxCtx) {\n    let outlen = out.len();\n    let mut s = [0u8; 64];\n    let mut d = [0u8; 32];\n\n    haraka_s_absorb(&mut s, 32, input, input.len(), 0x1F, ctx);\n\n    let nblocks = outlen / 32;\n    haraka_s_squeezeblocks(&mut out[..nblocks * 32], nblocks, &mut s, 32, ctx);\n\n    if outlen % 32 != 0 {\n        haraka_s_squeezeblocks(&mut d, 1, &mut s, 32, ctx);\n        for i in 0..(outlen % 32) {\n            out[nblocks * 32 + i] = d[i];\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn SPX_haraka_S(\n    out: *mut u8,\n    outlen: u64,\n    input: *const u8,\n    inlen: u64,\n    ctx: *const SpxCtx,\n) {\n    unsafe {\n        let in_slice = std::slice::from_raw_parts(input, inlen as usize);\n        let mut out_buf = vec![0u8; outlen as usize];\n        haraka_s_safe(&mut out_buf, in_slice, &*ctx);\n        std::ptr::copy_nonoverlapping(out_buf.as_ptr(), out, outlen as usize);\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn SPX_haraka_S_inc_init(s_inc: *mut u8) {\n    unsafe {\n        for i in 0..65 {\n            *s_inc.add(i) = 0;\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn SPX_haraka_S_inc_absorb(\n    s_inc: *mut u8,\n    m: *const u8,\n    mlen: usize,\n    ctx: *const SpxCtx,\n) {\n    unsafe {\n        let s_slice = std::slice::from_raw_parts_mut(s_inc, 65);\n        let mut m_off = 0usize;\n        let mut mlen = mlen;\n\n        while mlen + (s_slice[64] as usize) >= HARAKAS_RATE {\n            let n = HARAKAS_RATE - s_slice[64] as usize;\n            for i in 0..n {\n                s_slice[s_slice[64] as usize + i] ^= *m.add(m_off + i);\n            }\n            mlen -= n;\n            m_off += n;\n            s_slice[64] = 0;\n\n            let mut tmp = [0u8; 64];\n            let s_arr: &[u8; 64] = s_slice[..64].try_into().unwrap();\n            haraka512_perm_safe(&mut tmp, s_arr, &*ctx);\n            s_slice[..64].copy_from_slice(&tmp);\n        }\n\n        for i in 0..mlen {\n            s_slice[s_slice[64] as usize + i] ^= *m.add(m_off + i);\n        }\n        s_slice[64] += mlen as u8;\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn SPX_haraka_S_inc_finalize(s_inc: *mut u8) {\n    unsafe {\n        let s_slice = std::slice::from_raw_parts_mut(s_inc, 65);\n        s_slice[s_slice[64] as usize] ^= 0x1F;\n        s_slice[HARAKAS_RATE - 1] ^= 128;\n        s_slice[64] = 0;\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn SPX_harak