weak_constants_safe(&mut *ctx);\n    }\n}\n\npub fn haraka512_perm_safe(out: &mut [u8; 64], input: &[u8; 64], ctx: &SpxCtx) {\n    let mut w = [0u32; 16];\n    let mut q = [0u64; 8];\n\n    br_range_dec32le(&mut w, 16, input);\n    for i in 0..4 {\n        let mut q0 = q[i];\n        let mut q1 = q[i + 4];\n        br_aes_ct64_interleave_in(&mut q0, &mut q1, &w[i * 4..]);\n        q[i] = q0;\n        q[i + 4] = q1;\n    }\n    br_aes_ct64_ortho(&mut q);\n\n    for i in 0..5 {\n        for j in 0..2 {\n            br_aes_ct64_bitslice_sbox(&mut q);\n            shift_rows(&mut q);\n            mix_columns(&mut q);\n            add_round_key(&mut q, &ctx.tweaked512_rc64[2 * i + j]);\n        }\n        for j in 0..8 {\n            let tmp_q = q[j];\n            q[j] = (tmp_q & 0x0001000100010001) << 5\n                | (tmp_q & 0x0002000200020002) << 12\n                | (tmp_q & 0x0004000400040004) >> 1\n                | (tmp_q & 0x0008000800080008) << 6\n                | (tmp_q & 0x0020002000200020) << 9\n                | (tmp_q & 0x0040004000400040) >> 4\n                | (tmp_q & 0x0080008000800080) << 3\n                | (tmp_q & 0x2100210021002100) >> 5\n                | (tmp_q & 0x0210021002100210) << 2\n                | (tmp_q & 0x0800080008000800) << 4\n                | (tmp_q & 0x1000100010001000) >> 12\n                | (tmp_q & 0x4000400040004000) >> 10\n                | (tmp_q & 0x8400840084008400) >> 3;\n        }\n    }\n\n    br_aes_ct64_ortho(&mut q);\n    for i in 0..4 {\n        let q0 = q[i];\n        let q1 = q[i + 4];\n        br_aes_ct64_interleave_out(&mut w[i * 4..], q0, q1);\n    }\n    br_range_enc32le(out, &w, 16);\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn SPX_haraka512_perm(out: *mut u8, input: *const u8, ctx: *const SpxCtx) {\n    unsafe {\n        let in_ref = &*(input as *const [u8; 64]);\n        let mut out_buf = [0u8; 64];\n        haraka512_perm_safe(&mut out_buf, in_ref, &*ctx);\n        std::ptr::copy_nonoverlapp