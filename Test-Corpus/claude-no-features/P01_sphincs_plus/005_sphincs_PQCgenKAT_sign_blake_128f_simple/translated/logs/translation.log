\n902\tvoid haraka512(unsigned char *out, const unsigned char *in, const spx_ctx *ctx)\n903\t{\n904\t    int i;\n905\t\n906\t    unsigned char buf[64];\n907\t\n908\t    haraka512_perm(buf, in, ctx);\n909\t    /* Feed-forward */\n910\t    for (i = 0; i < 64; i++) {\n911\t        buf[i] = buf[i] ^ in[i];\n912\t    }\n913\t\n914\t    /* Truncated */\n915\t    memcpy(out,      buf + 8, 8);\n916\t    memcpy(out + 8,  buf + 24, 8);\n917\t    memcpy(out + 16, buf + 32, 8);\n918\t    memcpy(out + 24, buf + 48, 8);\n919\t}\n920\t\n921\t\n922\tvoid haraka256(unsigned char *out, const unsigned char *in,\n923\t        const spx_ctx *ctx)\n924\t{\n925\t    uint32_t q[8], tmp_q;\n926\t    int i, j;\n927\t\n928\t    for (i = 0; i < 4; i++) {\n929\t        q[2*i] = br_dec32le(in + 4*i);\n930\t        q[2*i + 1] = br_dec32le(in + 4*i + 16);\n931\t    }\n932\t    br_aes_ct_ortho(q);\n933\t\n934\t    /* AES rounds */\n935\t    for (i = 0; i < 5; i++) {\n936\t        for (j = 0; j < 2; j++) {\n937\t            br_aes_ct_bitslice_Sbox(q);\n938\t            shift_rows32(q);\n939\t            mix_columns32(q);\n940\t            add_round_key32(q, ctx->tweaked256_rc32[2*i + j]);\n941\t        }\n942\t\n943\t        /* Mix states */\n944\t        for (j = 0; j < 8; j++) {\n945\t            tmp_q = q[j];\n946\t            q[j] = (tmp_q & 0x81818181) |\n947\t                   (tmp_q & 0x02020202) << 1 |\n948\t                   (tmp_q & 0x04040404) << 2 |\n949\t                   (tmp_q & 0x08080808) << 3 |\n950\t                   (tmp_q & 0x10101010) >> 3 |\n951\t                   (tmp_q & 0x20202020) >> 2 |\n952\t                   (tmp_q & 0x40404040) >> 1;\n953\t        }\n954\t    }\n955\t\n956\t    br_aes_ct_ortho(q);\n957\t    for (i = 0; i < 4; i++) {\n958\t        br_enc32le(out + 4*i, q[2*i]);\n959\t        br_enc32le(out + 4*i + 16, q[2*i + 1]);\n960\t    }\n961\t\n962\t    for (i = 0; i < 32; i++) {\n963\t        out[i] ^= in[i];\n964\t    }\n965\t}\n966\t"}]},"parent_tool_use_