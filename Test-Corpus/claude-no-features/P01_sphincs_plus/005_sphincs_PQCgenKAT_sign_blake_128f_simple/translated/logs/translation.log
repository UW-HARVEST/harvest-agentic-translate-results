d left ones */\n45\t        uint32_t internal_idx_offset = idx_offset;\n46\t        uint32_t internal_idx = idx;\n47\t        uint32_t internal_leaf = leaf_idx;\n48\t        uint32_t h;     /* The height we are in the Merkle tree */\n49\t        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {\n50\t\n51\t            /* Check if we hit the top of the tree */\n52\t            if (h == tree_height) {\n53\t                /* We hit the root; return it */\n54\t                memcpy( root, &current[SPX_N], SPX_N );\n55\t                return;\n56\t            }\n57\t\n58\t            /*\n59\t             * Check if the node we have is a part of the\n60\t             * authentication path; if it is, write it out\n61\t             */\n62\t            if ((internal_idx ^ internal_leaf) == 0x01) {\n63\t                memcpy( &auth_path[ h * SPX_N ],\n64\t                        &current[SPX_N],\n65\t                        SPX_N );\n66\t            }\n67\t\n68\t            /*\n69\t             * Check if we're at a left child; if so, stop going up the stack\n70\t             * Exception: if we've reached the end of the tree, keep on going\n71\t             * (so we combine the last 4 nodes into the one root node in two\n72\t             * more iterations)\n73\t             */\n74\t            if ((internal_idx & 1) == 0 && idx < max_idx) {\n75\t                break;\n76\t            }\n77\t\n78\t            /* Ok, we're at a right node */\n79\t            /* Now combine the left and right logical nodes together */\n80\t\n81\t            /* Set the address of the node we're creating. */\n82\t            internal_idx_offset >>= 1;\n83\t            set_tree_height(tree_addr, h + 1);\n84\t            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\n85\t\n86\t            unsigned char *left = &stack[h * SPX_N];\n87\t            memcpy( &current[0], left, SPX_N );\n88\t            thash( &current[1 * SPX_N],\n89\t                   &current[0 * SPX_N