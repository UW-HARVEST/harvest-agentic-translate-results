CCCCCCCCC,  2, x, y)\n542\t#define SWAP8(x, y)    SWAPN(0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0,  4, x, y)\n543\t\n544\t    SWAP2(q[0], q[1]);\n545\t    SWAP2(q[2], q[3]);\n546\t    SWAP2(q[4], q[5]);\n547\t    SWAP2(q[6], q[7]);\n548\t\n549\t    SWAP4(q[0], q[2]);\n550\t    SWAP4(q[1], q[3]);\n551\t    SWAP4(q[4], q[6]);\n552\t    SWAP4(q[5], q[7]);\n553\t\n554\t    SWAP8(q[0], q[4]);\n555\t    SWAP8(q[1], q[5]);\n556\t    SWAP8(q[2], q[6]);\n557\t    SWAP8(q[3], q[7]);\n558\t}\n559\t\n560\t\n561\tstatic void br_aes_ct64_interleave_in(uint64_t *q0, uint64_t *q1, const uint32_t *w)\n562\t{\n563\t    uint64_t x0, x1, x2, x3;\n564\t\n565\t    x0 = w[0];\n566\t    x1 = w[1];\n567\t    x2 = w[2];\n568\t    x3 = w[3];\n569\t    x0 |= (x0 << 16);\n570\t    x1 |= (x1 << 16);\n571\t    x2 |= (x2 << 16);\n572\t    x3 |= (x3 << 16);\n573\t    x0 &= (uint64_t)0x0000FFFF0000FFFF;\n574\t    x1 &= (uint64_t)0x0000FFFF0000FFFF;\n575\t    x2 &= (uint64_t)0x0000FFFF0000FFFF;\n576\t    x3 &= (uint64_t)0x0000FFFF0000FFFF;\n577\t    x0 |= (x0 << 8);\n578\t    x1 |= (x1 << 8);\n579\t    x2 |= (x2 << 8);\n580\t    x3 |= (x3 << 8);\n581\t    x0 &= (uint64_t)0x00FF00FF00FF00FF;\n582\t    x1 &= (uint64_t)0x00FF00FF00FF00FF;\n583\t    x2 &= (uint64_t)0x00FF00FF00FF00FF;\n584\t    x3 &= (uint64_t)0x00FF00FF00FF00FF;\n585\t    *q0 = x0 | (x2 << 8);\n586\t    *q1 = x1 | (x3 << 8);\n587\t}\n588\t\n589\t\n590\tstatic void br_aes_ct64_interleave_out(uint32_t *w, uint64_t q0, uint64_t q1)\n591\t{\n592\t    uint64_t x0, x1, x2, x3;\n593\t\n594\t    x0 = q0 & (uint64_t)0x00FF00FF00FF00FF;\n595\t    x1 = q1 & (uint64_t)0x00FF00FF00FF00FF;\n596\t    x2 = (q0 >> 8) & (uint64_t)0x00FF00FF00FF00FF;\n597\t    x3 = (q1 >> 8) & (uint64_t)0x00FF00FF00FF00FF;\n598\t    x0 |= (x0 >> 8);\n599\t    x1 |= (x1 >> 8);\n600\t    x2 |= (x2 >> 8);\n601\t    x3 |= (x3 >> 8);\n602\t    x0 &= (uint64_t)0x0000FFFF0000FFFF;\n603\t    x1 &= (uint64_t)0x0000FFFF0000FFFF;\n604\t    x2 &= (uint64_t)0x0000FFFF0000FFFF;\n605\t    x3 &= (uint64_t)0x0000FFFF0000FFFF;\n606\t    w[0] = (uint32_t)x0 | (uint32_t)(x0 >> 16);\n607\t    w[1] = (uint32_t)x1 | (uint32_t)(x1 >> 16);\n608\t    w[2] = (uint32_t)x2 | (uint32_t)(x2 >> 16);\n609\t    w[3] = (uint32_t)x3 | (uint32_t)(x3 >> 16);\n610\t}\n611\t\n612\tstatic inline void add_round_key(uint64_t *q, const uint64_t *sk)\n613\t{\n614\t    q[0] ^= sk[0];\n615\t    q[1] ^= sk[1];\n616\t    q[2] ^= sk[2];\n617\t    q[3] ^= sk[3];\n618\t    q[4] ^= sk[4];\n619\t    q[5] ^= sk[5];\n620\t    q[6] ^= sk[6];\n621\t    q[7] ^= sk[7];\n622\t}\n623\t\n624\tstatic inline void shift_rows(uint64_t *q)\n625\t{\n626\t    int i;\n627\t\n628\t    for (i = 0; i < 8; i++) {\n629\t        uint64_t x;\n630\t\n631\t        x = q[i];\n632\t        q[i] = (x & (uint64_t)0x000000000000FFFF)\n633\t               | ((x & (uint64_t)0x00000000FFF00000) >> 4)\n634\t               | ((x & (uint64_t)0x00000000000F0000) << 12)\n635\t               | ((x & (uint64_t)0x0000FF0000000000) >> 8)\n636\t               | ((x & (uint64_t)0x000000FF00000000) << 8)\n637\t               | ((x & (uint64_t)0xF000000000000000) >> 12)\n638\t               | ((x & (uint64_t)0x0FFF000000000000) << 4);\n639\t    }\n640\t}\n641\t\n642\tstatic inline uint64_t rotr32(uint64_t x)\n643\t{\n644\t    return (x << 32) | (x >> 32);\n645\t}\n646\t\n647\tstatic inline void mix_columns(uint64_t *q)\n648\t{\n649\t    uint64_t q0, q1, q2, q3, q4, q5, q6, q7;\n650\t    uint64_t r0, r1, r2, r3, r4, r5, r6, r7;\n651\t\n652\t    q0 = q[0];\n653\t    q1 = q[1];\n654\t    q2 = q[2];\n655\t    q3 = q[3];\n656\t    q4 = q[4];\n657\t    q5 = q[5];\n658\t    q6 = q[6];\n659\t    q7 = q[7];\n660\t    r0 = (q0 >> 16) | (q0 << 48);\n661\t    r1 = (q1 >> 16) | (q1 << 48);\n662\t    r2 = (q2 >> 16) | (q2 << 48);\n663\t    r3 = (q3 >> 16) | (q3 << 48);\n664\t    r4 = (q4 >> 16) | (q4 << 48);\n665\t    r5 = (q5 >> 16) | (q5 << 48);\n666\t    r6 = (q6 >> 16) | (q6 << 48);\n667\t    r7 = (q7 >> 16) | (q7 << 48);\n668\t\n669\t    q[0] = q7 ^ r7 ^ r0 ^ rotr32(q0 ^ r0);\n670\t    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr32(q1 ^ r1);\n671\t    q[2] = q1 ^ r1 ^ r2 ^ rotr32(q2 ^ r2);\n672\t    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr32(q3 ^ r3);\n673\t    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr32(q4 ^ r4);\n674\t    q[5] = q4 ^ r4 ^ r5 ^ rotr32(q5 ^ r5);\n675\t    q[6] = q5 ^ r5 ^ r6 ^ rotr32(q6 ^ r6);\n676\t    q[7] = q6 ^ r6 ^ r7 ^ rotr32(q7 ^ r7);\n677\t}\n678\t\n679\tstatic void interleave_constant(uint64_t *out, const unsigned char *in)\n680\t{\n681\t    uint32_t tmp_32_constant[16];\n682\t    int i;\n683\t\n684\t    br_range_dec32le(tmp_32_constant, 16, in);\n685\t    for (i = 0; i < 4; i++) {\n686\t        br_aes_ct64_interleave_in(&out[i], &out[i + 4], tmp_32_constant + (i << 2));\n687\t    }\n688\t    br_aes_ct64_ortho(out);\n689\t}\n690\t\n691\tstatic void interleave_constant32(uint32_t *out, const unsigned char *in)\n692\t{\n693\t    int i;\n694\t    for (i = 0; i < 4; i++) {\n695\t        out[2*i] = br_dec32le(in + 4*i);\n696\t        out[2*i + 1] = br_dec32le(in + 4*i + 16);\n697\t    }\n698\t    br_aes_ct_ortho(out);\n699\t}\n700\t\n701\tvoid tweak_constants(spx_ctx *ctx)\n702\t{\n703\t    unsigned char buf[40*16];\n704\t    int i;\n705\t\n706\t    /* Use the standard constants to generate tweaked ones. */\n707\t    memcpy((uint8_t *)ctx->tweaked512_rc64, (uint8_t *)haraka512_rc64, 40*16);\n708\t\n709\t    /* Constants for pk.seed */\n710\t    haraka_S(buf, 40*16, ctx->pub_seed, SPX_N, ctx);\n711\t    for (i = 0; i < 10; i++) {\n712\t        interleave_constant32(ctx->tweaked256_rc32[i], buf + 32*i);\n713\t        interleave_constant(ctx->tweaked512_rc64[i], buf + 64*i);\n714\t    }\n715\t}\n716\t\n717\tstatic void haraka_S_absorb(unsigned char *s, unsigned int r,\n718\t                            const unsigned char *m, unsigned long long mlen,\n719\t                            unsigned char p, const spx_ctx *ctx)\n720\t{\n721\t    unsigned long long i;\n722\t    SPX_VLA(uint8_t, t, r);\n723\t\n724\t    while (mlen >= r) {\n725\t        /* XOR block to state */\n726\t        for (i = 0; i < r; ++i) {\n727\t            s[i] ^= m[i];\n728\t        }\n729\t        haraka512_perm(s, s, ctx);\n730\t        mlen -= r;\n731\t        m += r;\n732\t    }\n733\t\n734\t    for (i = 0; i < r; ++i) {\n735\t        t[i] = 0;\n736\t    }\n737\t    for (i = 0; i < mlen; ++i) {\n738\t        t[i] = m[i];\n739\t    }\n740\t    t[i] = p;\n741\t    t[r - 1] |= 128;\n742\t    for (i = 0; i < r; ++i) {\n743\t        s[i] ^= t[i];\n744\t    }\n745\t}\n746\t\n747\tstatic void haraka_S_squeezeblocks(unsigned char *h, unsigned long long nblocks,\n748\t                                   unsigned char *s, unsigned int r,\n749\t                                   const spx_ctx *ctx)\n750\t{\n751\t    while (nblocks > 0) {\n752\t        haraka512_perm(s, s, ctx);\n753\t        memcpy(h, s, HARAKAS_RATE);\n754\t        h += r;\n755\t        nblocks--;\n756\t    }\n757\t}\n758\t\n759\tvoid haraka_S_inc_init(uint8_t *s_inc)\n760\t{\n761\t    size_t i;\n762\t\n763\t    for (i = 0; i < 64; i++) {\n764\t        s_inc[i] = 0;\n765\t    }\n766\t    s_inc[64] = 0;\n767\t}\n768\t\n769\tvoid haraka_S_inc_absorb(uint8_t *s_inc, const uint8_t *m, size_t mlen,\n770\t        const spx_ctx *ctx)\n771\t{\n772\t    size_t i;\n773\t\n774\t    /* Recall that s_inc[64] is the non-absorbed bytes xored into the state */\n775\t    while (mlen + s_inc[64] >= HARAKAS_RATE) {\n776\t        for (i = 0; i < (size_t)(HARAKAS_RATE - s_inc[64]); i++) {\n777\t            /* Take the i'th byte from message\n778\t               xor with the s_inc[64] + i'th byte of the state */\n779\t            s_inc[s_inc[64] + i] ^= m[i];\n780\t        }\n781\t        mlen -= (size_t)(HARAKAS_RATE - s_inc[64]);\n782\t        m += HARAKAS_RATE - (uint8_t)s_inc[64];\n783\t        s_inc[64] = 0;\n784\t\n785\t        haraka512_perm(s_inc, s_inc, ctx);\n786\t    }\n787\t\n788\t    for (i = 0; i < mlen; i++) {\n789\t        s_inc[s_inc[64] + i] ^= m[i];\n790\t    }\n791\t    s_inc[64] += (uint8_t)mlen;\n792\t}\n793\t\n794\tvoid haraka_S_inc_finalize(uint8_t *s_inc)\n795\t{\n796\t    /* After haraka_S_inc_absorb, we are guaranteed that s_inc[64] < HARAKAS_RATE,\n797\t       so we can always use one more byte for p in the current state. */\n798\t    s_inc[s_inc[64]] ^= 0x1F;\n799\t    s_inc[HARAKAS_RATE - 1] ^= 128;\n800\t    s_inc[64] = 0;\n801\t}\n802\t\n803\tvoid haraka_S_inc_squeeze(uint8_t *out, size_t outlen, uint8_t *s_inc,\n804\t        const spx_ctx *ctx)\n805\t{\n806\t    size_t i;\n807\t\n808\t    /* First consume any bytes we still have sitting around */\n809\t    for (i = 0; i < outlen && i < s_inc[64]; i++) {\n810\t        /* There are s_inc[64] bytes left, so r - s_inc[64] is the first\n811\t           available byte. We consume from there, i.e., up to r. */\n812\t        out[i] = (uint8_t)s_inc[(HARAKAS_RATE - s_inc[64] + i)];\n813\t    }\n814\t    out += i;\n815\t    outlen -= i;\n816\t    s_inc[64] -= (uint8_t)i;\n817\t\n818\t    /* Then squeeze the remaining necessary blocks */\n819\t    while (outlen > 0) {\n820\t        haraka512_perm(s_inc, s_inc, ctx);\n821\t\n822\t        for (i = 0; i < outlen && i < HARAKAS_RATE; i++) {\n823\t            out[i] = s_inc[i];\n824\t        }\n825\t        out += i;\n826\t        outlen -= i;\n827\t        s_inc[64] = (uint8_t)(HARAKAS_RATE - i);\n828\t    }\n829\t}\n830\t\n831\tvoid haraka_S(unsigned char *out, unsigned long long outlen,\n832\t              const unsigned char *in, unsigned long long inlen,\n833\t              const spx_ctx *ctx)\n834\t{\n835\t    unsigned long long i;\n836\t    unsigned char s[64];\n837\t    unsigned char d[32];\n838\t\n839\t    for (i = 0; i < 64; i++) {\n840\t        s[i] = 0;\n841\t    }\n842\t    haraka_S_absorb(s, 32, in, inlen, 0x1F, ctx);\n843\t\n844\t    haraka_S_squeezeblocks(out, outlen / 32, s, 32, ctx);\n845\t    out += (outlen / 32) * 32;\n846\t\n847\t    if (outlen % 32) {\n848\t        haraka_S_squeez