n67\t       preparation or computation it needs, based on the public seed. */\n68\t    initialize_hash_function(&ctx);\n69\t\n70\t    /* Compute root node of the top-most subtree. */\n71\t    merkle_gen_root(sk + 3*SPX_N, &ctx);\n72\t\n73\t    memcpy(pk + SPX_N, sk + 3*SPX_N, SPX_N);\n74\t\n75\t    return 0;\n76\t}\n77\t\n78\t/*\n79\t * Generates an SPX key pair.\n80\t * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]\n81\t * Format pk: [PUB_SEED || root]\n82\t */\n83\tint crypto_sign_keypair(unsigned char *pk, unsigned char *sk)\n84\t{\n85\t  unsigned char seed[CRYPTO_SEEDBYTES];\n86\t  randombytes(seed, CRYPTO_SEEDBYTES);\n87\t  crypto_sign_seed_keypair(pk, sk, seed);\n88\t\n89\t  return 0;\n90\t}\n91\t\n92\t/**\n93\t * Returns an array containing a detached signature.\n94\t */\n95\tint crypto_sign_signature(uint8_t *sig, size_t *siglen,\n96\t                          const uint8_t *m, size_t mlen, const uint8_t *sk)\n97\t{\n98\t    spx_ctx ctx;\n99\t\n100\t    const unsigned char *sk_prf = sk + SPX_N;\n101\t    const unsigned char *pk = sk + 2*SPX_N;\n102\t\n103\t    unsigned char optrand[SPX_N];\n104\t    unsigned char mhash[SPX_FORS_MSG_BYTES];\n105\t    unsigned char root[SPX_N];\n106\t    uint32_t i;\n107\t    uint64_t tree;\n108\t    uint32_t idx_leaf;\n109\t    uint32_t wots_addr[8] = {0};\n110\t    uint32_t tree_addr[8] = {0};\n111\t\n112\t    memcpy(ctx.sk_seed, sk, SPX_N);\n113\t    memcpy(ctx.pub_seed, pk, SPX_N);\n114\t\n115\t    /* This hook allows the hash function instantiation to do whatever\n116\t       preparation or computation it needs, based on the public seed. */\n117\t    initialize_hash_function(&ctx);\n118\t\n119\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n120\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n121\t\n122\t    /* Optionally, signing can be made non-deterministic using optrand.\n123\t       This can help counter side-channel attacks that would benefit from\n124\t       getting a large number of traces when the signer u