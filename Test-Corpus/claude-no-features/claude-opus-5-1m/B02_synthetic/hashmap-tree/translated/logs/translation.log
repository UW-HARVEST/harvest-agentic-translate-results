e);\n279\t    TEST_PASS;\n280\t}\n281\t\n282\tvoid test_tree_find_path(void) {\n283\t    printf(\"\\n=== Testing Tree Find Path ===\\n\");\n284\t    \n285\t    tree_t *tree = tree_create();\n286\t    \n287\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n288\t    assert(tree_add_node(tree, 2, 1, \"child\") == 0);\n289\t    assert(tree_add_node(tree, 3, 2, \"grandchild\") == 0);\n290\t    \n291\t    tree_id_t path[10];\n292\t    int length;\n293\t    \n294\t    length = tree_find_path(tree, 3, path, 10);\n295\t    assert(length == 3);\n296\t    assert(path[0] == 1);\n297\t    assert(path[1] == 2);\n298\t    assert(path[2] == 3);\n299\t    \n300\t    length = tree_find_path(tree, 1, path, 10);\n301\t    assert(length == 1);\n302\t    assert(path[0] == 1);\n303\t    \n304\t    tree_delete(tree);\n305\t    TEST_PASS;\n306\t}\n307\t\n308\tvoid test_tree_duplicate_id(void) {\n309\t    printf(\"\\n=== Testing Tree Duplicate ID ===\\n\");\n310\t    \n311\t    tree_t *tree = tree_create();\n312\t    \n313\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n314\t    assert(tree_add_node(tree, 2, 1, \"child\") == 0);\n315\t    \n316\t    // Try to add duplicate\n317\t    assert(tree_add_node(tree, 2, 1, \"duplicate\") != 0);\n318\t    assert(tree_size(tree) == 2);\n319\t    \n320\t    tree_delete(tree);\n321\t    TEST_PASS;\n322\t}\n323\t\n324\tvoid test_tree_max_children(void) {\n325\t    printf(\"\\n=== Testing Tree Max Children ===\\n\");\n326\t    \n327\t    tree_t *tree = tree_create();\n328\t    \n329\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n330\t    \n331\t    // Add MAX_CHILDREN children\n332\t    for (int i = 0; i < MAX_CHILDREN; i++) {\n333\t        assert(tree_add_node(tree, i + 2, 1, \"child\") == 0);\n334\t    }\n335\t    \n336\t    // Try to add one more (should fail)\n337\t    assert(tree_add_node(tree, MAX_CHILDREN + 2, 1, \"overflow\") != 0);\n338\t    assert(tree_size(tree) == MAX_CHILDREN + 1);\n339\t    \n340\t    tree_delete(tree)