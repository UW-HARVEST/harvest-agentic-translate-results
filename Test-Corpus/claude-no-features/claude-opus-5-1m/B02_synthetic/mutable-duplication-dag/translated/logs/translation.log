current_node = end;\n286\t    \n287\t    while (current_node) {\n288\t        path[count++] = current_node;\n289\t        \n290\t        // Find previous node\n291\t        int current_state_idx = -1;\n292\t        for (int i = 0; i < state_count; i++) {\n293\t            if (state[i].node == current_node) {\n294\t                current_state_idx = i;\n295\t                break;\n296\t            }\n297\t        }\n298\t        \n299\t        if (current_state_idx == -1) {\n300\t            break;\n301\t        }\n302\t        \n303\t        current_node = state[current_state_idx].previous;\n304\t    }\n305\t    \n306\t    // Reverse path\n307\t    node_t **result = malloc(sizeof(node_t*) * count);\n308\t    if (!result) {\n309\t        fprintf(stderr, \"Error: Failed to allocate path\\n\");\n310\t        *path_length = 0;\n311\t        return NULL;\n312\t    }\n313\t    \n314\t    for (int i = 0; i < count; i++) {\n315\t        result[i] = path[count - 1 - i];\n316\t    }\n317\t    \n318\t    *path_length = count;\n319\t    return result;\n320\t}\n321\t\n322\t// Get node by city name\n323\tnode_t* get_node_by_name(graph_t *graph, const char *city_name) {\n324\t    if (!graph || !city_name) {\n325\t        return NULL;\n326\t    }\n327\t    \n328\t    for (int i = 0; i < graph->node_count; i++) {\n329\t        if (strcmp(graph->nodes[i]->city_name, city_name) == 0) {\n330\t            return graph->nodes[i];\n331\t        }\n332\t    }\n333\t    \n334\t    return NULL;\n335\t}\n336\t\n337\t// Print node information\n338\tvoid print_node(node_t *node) {\n339\t    if (!node) {\n340\t        printf(\"NULL node\\n\");\n341\t        return;\n342\t    }\n343\t    \n344\t    printf(\"City: %s (ref_count: %d)\\n\", node->city_name, node->ref_count);\n345\t    printf(\"  Edges:\\n\");\n346\t    for (int i = 0; i < node->edge_count; i++) {\n347\t        printf(\"    -> %s (distance: %d)\\n\", \n348\t               node->edges[i].destination->city_name,\n349\t               