ur */\n54\tstatic void GetFile_Queue(file_queue *fileq)\n55\t{\n56\t    /* Create the logfile name */\n57\t    fileq->file_name[0] = '\\0';\n58\t    fileq->file_name[MAX_FQUEUE] = '\\0';\n59\t\n60\t    snprintf(fileq->file_name, MAX_FQUEUE, \"%s\", fileq->flags & CRALERT_FP_SET ? \"<stdin>\" : ALERTS_DAILY);\n61\t}\n62\t\n63\t/* Re Handle the file queue */\n64\tstatic int Handle_Queue(file_queue *fileq, int flags)\n65\t{\n66\t    /* Close if it is open */\n67\t    if (!(flags & CRALERT_FP_SET)) {\n68\t        if (fileq->fp) {\n69\t            fclose(fileq->fp);\n70\t            fileq->fp = NULL;\n71\t        }\n72\t\n73\t        /* We must be able to open the file, fseek and get the\n74\t         * time of change from it.\n75\t         */\n76\t        fileq->fp = fopen(fileq->file_name, \"r\");\n77\t        if (!fileq->fp) {\n78\t            /* Queue not available */\n79\t            return (0);\n80\t        }\n81\t    }\n82\t\n83\t    /* Seek to the end of the file */\n84\t    if (!(flags & CRALERT_READ_ALL)) {\n85\t        if (!fileq->fp) {\n86\t            return (0);\n87\t        }\n88\t\n89\t        if (fseek(fileq->fp, 0, SEEK_END) < 0) {\n90\t            merror(FSEEK_ERROR, fileq->file_name, errno, strerror(errno));\n91\t            fclose(fileq->fp);\n92\t            fileq->fp = NULL;\n93\t            return (-1);\n94\t        }\n95\t    }\n96\t\n97\t    /* File change time */\n98\t    if (fileq->fp) {\n99\t        if (fstat(fileno(fileq->fp), &fileq->f_status) < 0) {\n100\t            merror(FSTAT_ERROR, fileq->file_name, errno, strerror(errno));\n101\t            fclose(fileq->fp);\n102\t            fileq->fp = NULL;\n103\t            return (-1);\n104\t        }\n105\t    }\n106\t\n107\t    fileq->last_change = fileq->f_status.st_mtime;\n108\t\n109\t    return (1);\n110\t}\n111\t\n112\t/* Initiates the file monitoring */\n113\tint Init_FileQueue(file_queue *fileq, const struct tm *p, int flags)\n114\t{\n115\t    /* Initialize file_queue fields */\n116\t  