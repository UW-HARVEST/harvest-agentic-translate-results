(cJSON *root)\n45\t{\n46\t    /* declarations */\n47\t    char *out = NULL;\n48\t    char *buf = NULL;\n49\t    char *buf_fail = NULL;\n50\t    size_t len = 0;\n51\t    size_t len_fail = 0;\n52\t\n53\t    /* formatted print */\n54\t    out = cJSON_Print(root);\n55\t\n56\t    /* create buffer to succeed */\n57\t    /* the extra 5 bytes are because of inaccuracies when reserving memory */\n58\t    len = strlen(out) + 5;\n59\t    buf = (char*)malloc(len);\n60\t    if (buf == NULL)\n61\t    {\n62\t        printf(\"Failed to allocate memory.\\n\");\n63\t        exit(1);\n64\t    }\n65\t\n66\t    /* create buffer to fail */\n67\t    len_fail = strlen(out);\n68\t    buf_fail = (char*)malloc(len_fail);\n69\t    if (buf_fail == NULL)\n70\t    {\n71\t        printf(\"Failed to allocate memory.\\n\");\n72\t        exit(1);\n73\t    }\n74\t\n75\t    /* Print to buffer */\n76\t    if (!cJSON_PrintPreallocated(root, buf, (int)len, 1)) {\n77\t        printf(\"cJSON_PrintPreallocated failed!\\n\");\n78\t        if (strcmp(out, buf) != 0) {\n79\t            printf(\"cJSON_PrintPreallocated not the same as cJSON_Print!\\n\");\n80\t            printf(\"cJSON_Print result:\\n%s\\n\", out);\n81\t            printf(\"cJSON_PrintPreallocated result:\\n%s\\n\", buf);\n82\t        }\n83\t        free(out);\n84\t        free(buf_fail);\n85\t        free(buf);\n86\t        return -1;\n87\t    }\n88\t\n89\t    /* success */\n90\t    printf(\"%s\\n\", buf);\n91\t\n92\t    /* force it to fail */\n93\t    if (cJSON_PrintPreallocated(root, buf_fail, (int)len_fail, 1)) {\n94\t        printf(\"cJSON_PrintPreallocated failed to show error with insufficient memory!\\n\");\n95\t        printf(\"cJSON_Print result:\\n%s\\n\", out);\n96\t        printf(\"cJSON_PrintPreallocated result:\\n%s\\n\", buf_fail);\n97\t        free(out);\n98\t        free(buf_fail);\n99\t        free(buf);\n100\t        return -1;\n101\t    }\n102\t\n103\t    free(out);\n104\t    free(buf_fail);\n105\t    free(buf);\n106\t    return 0;\n107\t}\n108\t\n109\t/* Create a bunch of objects as demonstration. */\n110\tstatic void create_objects(const char *strings[7], int numbers[3][3], int ids[4], struct record fields[2])\n111\t{\n112\t    /* declare a few. */\n113\t    cJSON *root = NULL;\n114\t    cJSON *fmt = NULL;\n115\t    cJSON *img = NULL;\n116\t    cJSON *thm = NULL;\n117\t    cJSON *fld = NULL;\n118\t    int i = 0;\n119\t\n120\t    volatile double zero = 0.0;\n121\t\n122\t    /* Here we construct some JSON standards, from the JSON site. */\n123\t\n124\t    /* Our \"Video\" datatype: */\n125\t    root = cJSON_CreateObject();\n126\t    cJSON_AddItemToObject(root, \"name\", cJSON_CreateString(\"Jack (\\\"Bee\\\") Nimble\"));\n127\t    cJSON_AddItemToObject(root, \"format\", fmt = cJSON_CreateObject());\n128\t    cJSON_AddStringToObject(fmt, \"type\", \"rect\");\n129\t    cJSON_AddNumberToObject(fmt, \"width\", 1920);\n130\t    cJSON_AddNumberToObject(fmt, \"height\", 1080);\n131\t    cJSON_AddFalseToObject (fmt, \"interlace\");\n132\t    cJSON_AddNumberToObject(fmt, \"frame rate\", 24);\n133\t\n134\t    /* Print to text */\n135\t    if (print_preallocated(root) != 0) {\n136\t        cJSON_Delete(root);\n137\t        exit(EXIT_FAILURE);\n138\t    }\n139\t    cJSON_Delete(root);\n140\t\n141\t    /* Our \"days of the week\" array: */\n142\t    root = cJSON_CreateStringArray(strings, 7);\n143\t\n144\t    if (print_preallocated(root) != 0) {\n145\t        cJSON_Delete(root);\n146\t        exit(EXIT_FAILURE);\n147\t    }\n148\t    cJSON_Delete(root);\n149\t\n150\t    /* Our matrix: */\n151\t    root = cJSON_CreateArray();\n152\t    for (i = 0; i < 3; i++)\n153\t    {\n154\t        cJSON_AddItemToArray(root, cJSON_CreateIntArray(numbers[i], 3));\n155\t    }\n156\t\n157\t    /* cJSON_ReplaceItemInArray(root, 1, cJSON_CreateString(\"Replacement\")); */\n158\t\n159\t    if (print_preallocated(root) != 0) {\n160\t        cJSON_Delete(root);\n161\t        exit(EXIT_FAILURE);\n162\t    }\n163\t    cJS