{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_wns7atb3bl4clqdw6cadvmbq6uhfnswbhhtxwoqufc5pe6fsrh7q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_015Sdyurvk1C83LRhuuSEgYy","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-translate-eSaiCu/translated_rust/src/lib.rs","content":"// Rust translation of cJSON 1.7.19\n// This is a faithful byte-identical translation of cJSON.c\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n#![allow(dead_code)]\n#![allow(unused_assignments)]\n#![allow(clippy::missing_safety_doc)]\n\nuse core::ffi::{c_char, c_double, c_float, c_int, c_uint, c_void};\nuse core::ptr;\n\n// Constants from cJSON.h\nconst CJSON_VERSION_MAJOR: c_int = 1;\nconst CJSON_VERSION_MINOR: c_int = 7;\nconst CJSON_VERSION_PATCH: c_int = 19;\n\nconst cJSON_Invalid: c_int = 0;\nconst cJSON_False: c_int = 1 << 0;\nconst cJSON_True: c_int = 1 << 1;\nconst cJSON_NULL: c_int = 1 << 2;\nconst cJSON_Number: c_int = 1 << 3;\nconst cJSON_String: c_int = 1 << 4;\nconst cJSON_Array: c_int = 1 << 5;\nconst cJSON_Object: c_int = 1 << 6;\nconst cJSON_Raw: c_int = 1 << 7;\n\nconst cJSON_IsReference: c_int = 256;\nconst cJSON_StringIsConst: c_int = 512;\n\nconst CJSON_NESTING_LIMIT: usize = 1000;\nconst CJSON_CIRCULAR_LIMIT: usize = 10000;\n\nconst INT_MAX: c_int = c_int::MAX;\nconst INT_MIN: c_int = c_int::MIN;\nconst DBL_EPSILON: f64 = f64::EPSILON;\n\npub type cJSON_bool = c_int;\n\n#[repr(C)]\npub struct cJSON {\n    pub next: *mut cJSON,\n    pub prev: *mut cJSON,\n    pub child: *mut cJSON,\n    pub type_: c_int,\n    pub valuestring: *mut c_char,\n    pub valueint: c_int,\n    pub valuedouble: c_double,\n    pub string: *mut c_char,\n}\n\n#[repr(C)]\npub struct cJSON_Hooks {\n    pub malloc_fn: Option<unsafe extern \"C\" fn(sz: usize) -> *mut c_void>,\n    pub free_fn: Option<unsafe extern \"C\" fn(ptr: *mut c_void)>,\n}\n\n// libc bindings\nextern \"C\