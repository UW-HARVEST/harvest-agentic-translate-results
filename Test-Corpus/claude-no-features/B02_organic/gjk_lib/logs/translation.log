ts->b.u = vCA;\n248\t\t\ts->div = uCA + vCA;\n249\t\t\ts->count = 2;\n250\t\t} else {\n251\t\t\ts->a.u = uABC;\n252\t\t\ts->b.u = vABC;\n253\t\t\ts->c.u = wABC;\n254\t\t\ts->div = uABC + vABC + wABC;\n255\t\t\ts->count = 3;\n256\t\t}\n257\t}\n258\t\n259\tc2v c2Neg(c2v a) {\n260\t\treturn c2V(-a.x, -a.y);\n261\t}\n262\t\n263\tc2v c2Skew(c2v a) {\n264\t\tc2v b;\n265\t\tb.x = -a.y;\n266\t\tb.y = a.x;\n267\t\treturn b;\n268\t}\n269\t\n270\tc2v c2CCW90(c2v a) {\n271\t\tc2v b;\n272\t\tb.x = a.y;\n273\t\tb.y = -a.x;\n274\t\treturn b;\n275\t}\n276\t\n277\tc2v c2D(c2Simplex *s) {\n278\t\tswitch (s->count) {\n279\t\t\tcase 1:\n280\t\t\t\treturn c2Neg(s->a.p);\n281\t\t\tcase 2: {\n282\t\t\t\t\tc2v ab = c2Sub(s->b.p, s->a.p);\n283\t\t\t\t\tif (c2Det2(ab, c2Neg(s->a.p)) > 0)\n284\t\t\t\t\t\treturn c2Skew(ab);\n285\t\t\t\t\treturn c2CCW90(ab);\n286\t\t\t\t}\n287\t\t\tcase 3:\n288\t\t\tdefault:\n289\t\t\t\treturn c2V(0, 0);\n290\t\t}\n291\t}\n292\t\n293\tint c2Support(const c2v *verts, int count, c2v d) {\n294\t\tint imax = 0;\n295\t\tfloat dmax = c2Dot(verts[0], d);\n296\t\tfor (int i = 1; i < count; ++i) {\n297\t\t\tfloat dot = c2Dot(verts[i], d);\n298\t\t\tif (dot > dmax) {\n299\t\t\t\timax = i;\n300\t\t\t\tdmax = dot;\n301\t\t\t}\n302\t\t}\n303\t\treturn imax;\n304\t}\n305\t\n306\tvoid c2Witness(c2Simplex *s, c2v *a, c2v *b) {\n307\t\tfloat den = 1.0f / s->div;\n308\t\tswitch (s->count) {\n309\t\t\tcase 1:\n310\t\t\t\t*a = s->a.sA;\n311\t\t\t\t*b = s->a.sB;\n312\t\t\t\tbreak;\n313\t\t\tcase 2:\n314\t\t\t\t*a = c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\n315\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u)));\n316\t\t\t\t*b = c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\n317\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u)));\n318\t\t\t\tbreak;\n319\t\t\tcase 3:\n320\t\t\t\t*a = c2Add(c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\n321\t\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u))),\n322\t\t\t\t\t\tc2Mulvs(s->c.sA, (den * s->c.u)));\n323\t\t\t\t*b = c2Add(c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\n324\t\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u))),\n325\t\t\t\t\t\tc2Mulvs(s->c.sB, (den * s->c.u)));\n326\t\t\t\tbreak;\n327\t\t\tdefault:\n328\t\t\t\t*a = c2V(0, 0);\n329\t\t\t\t*b = c2V(0, 0);\n330\t\t}\n331\t}\n332\t\n333\tc2v c2Div(c2v a, float b) {\n334\t\treturn c2Mulvs(a, 1.0f / b);\n335\t}\n336\t\n337\tc2v c2Norm(c2v a) {\n338\t\treturn c2Div(a, c2Len(a));\n339\t}\n340\t\n341\tc2v c2L(c2Simplex *s) {\n342\t    float den = 1.0f / s->div;\n343\t    switch (s->count) {\n344\t    case 1:\n345\t        return s->a.p;\n346\t    case 2:\n347\t        return c2Add(c2Mulvs(s->a.p, (den * s->a.u)),\n348\t                     c2Mulvs(s->b.p, (den * s->b.u)));\n349\t    default:\n350\t        return c2V(0, 0);\n351\t    }\n352\t}\n353\t\n354\tc2v c2MulrvT(c2r a, c2v b) {\n355\t    return c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y);\n356\t}\n357\t\n358\tfloat c2GJK(const void *A, C2_TYPE typeA, const c2x *ax_ptr, const void *B,\n359\t\t\tC2_TYPE typeB, const c2x *bx_ptr, c2v *outA, c2v *outB,\n360\t\t\tint use_radius, int *iterations, c2GJKCache *cache) {\n361\t\tc2x ax;\n362\t\tc2x bx;\n363\t\tif (!ax_ptr)\n364\t\t\tax = c2xIdentity();\n365\t\telse\n366\t\t\tax = *ax_ptr;\n367\t\tif (!bx_ptr)\n368\t\t\tbx = c2xIdentity();\n369\t\telse\n370\t\t\tbx = *bx_ptr;\n371\t\tc2Proxy pA;\n372\t\tc2Proxy pB;\n373\t\tc2MakeProxy(A, typeA, &pA);\n374\t\tc2MakeProxy(B, typeB, &pB);\n375\t\tc2Simplex s;\n376\t\tc2sv *verts = &s.a;\n377\t\tint cache_was_read = 0;\n378\t\tif (cache) {\n379\t\t\tint cache_was_good = !!cache->count;\n380\t\t\tif (cache_was_good) {\n381\t\t\t\tfor (int i = 0; i < cache->count; ++i) {\n382\t\t\t\t\tint iA = cache->iA[i];\n383\t\t\t\t\tint iB = cache->iB[i];\n384\t\t\t\t\tc2v sA = c2Mulxv(ax, pA.verts[iA]);\n385\t\t\t\t\tc2v sB = c2Mulxv(bx, pB.verts[iB]);\n386\t\t\t\t\tc2sv *v = verts + i;\n387\t\t\t\t\tv->iA = iA;\n388\t\t\t\t\tv->sA = sA;\n389\t\t\t\t\tv->iB = iB;\n390\t\t\t\t\tv->sB = sB;\n391\t\t\t\t\tv->p = c2Sub(v->sB, v->sA);\n392\t\t\t\t\tv->u = 0;