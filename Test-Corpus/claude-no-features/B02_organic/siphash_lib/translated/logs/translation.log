etails":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":911,"cache_read_input_tokens":22771,"cache_creation":{"ephemeral_5m_input_tokens":911,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"72e0fb19-ea3d-485e-a291-286c34957a44","uuid":"065f0453-37ce-46fa-a77d-bfefbea44331"}
