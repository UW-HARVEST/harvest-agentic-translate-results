\nstruct c2r {\n    c: c_float,\n    s: c_float,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\nstruct c2x {\n    p: c2v,\n    r: c2r,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\nstruct c2Circle {\n    p: c2v,\n    r: c_float,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\nstruct c2AABB {\n    min: c2v,\n    max: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\nstruct c2Capsule {\n    a: c2v,\n    b: c2v,\n    r: c_float,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct c2Poly {\n    count: c_int,\n    verts: [c2v; 8],\n    norms: [c2v; 8],\n}\n\nimpl Default for c2Poly {\n    fn default() -> Self {\n        c2Poly {\n            count: 0,\n            verts: [c2v::default(); 8],\n            norms: [c2v::default(); 8],\n        }\n    }\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\nstruct c2GJKCache {\n    metric: c_float,\n    count: c_int,\n    iA: [c_int; 3],\n    iB: [c_int; 3],\n    div: c_float,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct c2Proxy {\n    radius: c_float,\n    count: c_int,\n    verts: [c2v; 8],\n}\n\nimpl Default for c2Proxy {\n    fn default() -> Self {\n        c2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [c2v::default(); 8],\n        }\n    }\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default, Debug)]\nstruct c2sv {\n    sA: c2v,\n    sB: c2v,\n    p: c2v,\n    u: c_float,\n    iA: c_int,\n    iB: c_int,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\nstruct c2Simplex {\n    a: c2sv,\n    b: c2sv,\n    c: c2sv,\n    d: c2sv,\n    div: c_float,\n    count: c_int,\n}\n\n#[inline]\nfn c2V(x: c_float, y: c_float) -> c2v {\n    c2v { x, y }\n}\n\n#[inline]\nfn c2Mulvs(mut a: c2v, b: c_float) -> c2v {\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n#[inline]\nfn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[inline]\nfn c2Minv(a: c2v, b: c2v) -> c2v {\n   