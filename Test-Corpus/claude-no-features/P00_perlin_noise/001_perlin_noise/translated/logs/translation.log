inline]\nfn grad(grad_idx: i32, x: f32, y: f32, z: f32) -> f32 {\n    // grad_idx in C is `int` from a u8 indexing -- always 0..=255 here\n    // but actual basis index uses only 0..12 since the table only has values 0..=11.\n    let g = &BASIS[grad_idx as usize];\n    g[0] * x + g[1] * y + g[2] * z\n}\n\nfn noise3_internal(\n    mut x: f32,\n    mut y: f32,\n    mut z: f32,\n    x_wrap: i32,\n    y_wrap: i32,\n    z_wrap: i32,\n    seed: u8,\n) -> f32 {\n    // (x_wrap-1) & 255 : compute as wrapping in u32\n    let x_mask: u32 = ((x_wrap.wrapping_sub(1)) as u32) & 255;\n    let y_mask: u32 = ((y_wrap.wrapping_sub(1)) as u32) & 255;\n    let z_mask: u32 = ((z_wrap.wrapping_sub(1)) as u32) & 255;\n\n    let px = fastfloor(x);\n    let py = fastfloor(y);\n    let pz = fastfloor(z);\n\n    // x0 = px & x_mask. In C, px is int, x_mask is unsigned int -> int promoted to uint.\n    // The result is unsigned int, used as array index. Effectively: (px as u32) & x_mask\n    let x0 = ((px as u32) & x_mask) as usize;\n    let x1 = (((px.wrapping_add(1)) as u32) & x_mask) as usize;\n    let y0 = ((py as u32) & y_mask) as usize;\n    let y1 = (((py.wrapping_add(1)) as u32) & y_mask) as usize;\n    let z0 = ((pz as u32) & z_mask) as usize;\n    let z1 = (((pz.wrapping_add(1)) as u32) & z_mask) as usize;\n\n    x -= px as f32;\n    let u = ease(x);\n    y -= py as f32;\n    let v = ease(y);\n    z -= pz as f32;\n    let w = ease(z);\n\n    let seed_us = seed as usize;\n    let r0 = STB_PERLIN_RANDTAB[x0 + seed_us] as usize;\n    let r1 = STB_PERLIN_RANDTAB[x1 + seed_us] as usize;\n\n    let r00 = STB_PERLIN_RANDTAB[r0 + y0] as usize;\n    let r01 = STB_PERLIN_RANDTAB[r0 + y1] as usize;\n    let r10 = STB_PERLIN_RANDTAB[r1 + y0] as usize;\n    let r11 = STB_PERLIN_RANDTAB[r1 + y1] as usize;\n\n    let n000 = grad(STB_PERLIN_RANDTAB_GRAD_IDX[r00 + z0] as i32, x, y, z);\n    let n001 = grad(STB_PERLIN_RANDTAB_GRAD_IDX[r00 + z1] as i32, x, y, z - 1.0);\n    let n010 = grad(STB_PERLIN_