e_creation":{"ephemeral_5m_input_tokens":286,"ephemeral_1h_input_tokens":0},"output_tokens":38,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a692a8fc-f154-42a7-b9ee-9408f2ac6c9b","uuid":"92efbce3-89e0-4de4-a17a-088fecac1c53"}
