        i += 1;\n    }\n\n    if i >= buf.len() {\n        return 0;\n    }\n\n    let mut negative = false;\n    if buf[i] == b'-' {\n        negative = true;\n        i += 1;\n    } else if buf[i] == b'+' {\n        i += 1;\n    }\n\n    let start = i;\n    let mut value: i64 = 0;\n    while i < buf.len() && (buf[i] as char).is_ascii_digit() {\n        value = value.wrapping_mul(10).wrapping_add((buf[i] - b'0') as i64);\n        i += 1;\n    }\n\n    if i == start {\n        // No digits parsed; scanf would not assign, leaving x at its initial 0.\n        return 0;\n    }\n\n    if negative {\n        value = value.wrapping_neg();\n    }\n\n    // Truncate to 32-bit int as C would.\n    value as i32\n}\n\nfn main() -> ExitCode {\n    let x: i32 = scanf_int();\n\n    if x != 0 {\n        good();\n    } else {\n        bad();\n    }\n\n    ExitCode::from(0)\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":148,"cache_read_input_tokens":15525,"cache_creation":{"ephemeral_5m_input_tokens":148,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"08ab83e3-3b06-441c-b60d-b881648c5016","uuid":"5373b818-fff6-4adf-ac1e-8db562309f81"}
