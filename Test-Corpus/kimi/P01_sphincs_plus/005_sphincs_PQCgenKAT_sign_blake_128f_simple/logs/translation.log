      "path": "src/thash.rs",
      "contents": "use crate::context::SpxCtx;\nuse crate::params::*;\n\npub fn thash(out: &mut [u8], inp: &[u8], inblocks: usize, ctx: &SpxCtx, addr: &[u32; 8]) {\n    #[cfg(all(feature = \"shake\", feature = \"robust\"))]\n    {\n        use sha3::{Shake256, shake256};\n        use sha3::digest::{Update, ExtendableOutput, XofReader};\n\n        let mut buf = vec![0u8; SPX_N + SPX_ADDR_BYTES + inblocks * SPX_N];\n        let mut bitmask = vec![0u8; inblocks * SPX_N];\n\n        buf[0..SPX_N].copy_from_slice(&ctx.pub_seed);\n        buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(unsafe {\n            core::slice::from_raw_parts(addr.as_ptr() as *const u8, SPX_ADDR_BYTES)\n        });\n\n        let mut hasher = Shake256::default();\n        hasher.update(&buf[0..SPX_N + SPX_ADDR_BYTES]);\n        let mut reader = hasher.finalize_xof();\n        reader.read(&mut bitmask);\n\n        for i in 0..inblocks * SPX_N {\n            buf[SPX_N + SPX_ADDR_BYTES + i] = inp[i] ^ bitmask[i];\n        }\n\n        let mut hasher2 = Shake256::default();\n        hasher2.update(&buf[0..SPX_N + SPX_ADDR_BYTES + inblocks * SPX_N]);\n        let mut reader2 = hasher2.finalize_xof();\n        reader2.read(out);\n    }\n    #[cfg(all(feature = \"shake\", feature = \"simple\"))]\n    {\n        use sha3::{Shake256, shake256};\n        use sha3::digest::{Update, ExtendableOutput, XofReader};\n\n        let mut buf = vec![0u8; SPX_N + SPX_ADDR_BYTES + inblocks * SPX_N];\n\n        buf[0..SPX_N].copy_from_slice(&ctx.pub_seed);\n        buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(unsafe {\n            core::slice::from_raw_parts(addr.as_ptr() as *const u8, SPX_ADDR_BYTES)\n        });\n        buf[SPX_N + SPX_ADDR_BYTES..SPX_N + SPX_ADDR_BYTES + inblocks * SPX_N].copy_from_slice(inp);\n\n        let mut hasher = Shake256::default();\n        hasher.update(&buf);\n        let mut reader = hasher.finalize_xof();\n        reader.read(out);\n    }\n    #[cfg(feature = \"sha2\")]\n    {\n        crate::sha2_hash::thash(out, inp, inblocks, ctx, addr);\n    }\n    #[cfg(feature = \"blake\")]\n    {\n        crate::blake_hash::thash(out, inp, inblocks, ctx, addr);\n    }\n    #[cfg(feature = \"haraka\")]\n    {\n        crate::haraka::thash(out, inp, inblocks, ctx, addr);\n    }\n}\n"
