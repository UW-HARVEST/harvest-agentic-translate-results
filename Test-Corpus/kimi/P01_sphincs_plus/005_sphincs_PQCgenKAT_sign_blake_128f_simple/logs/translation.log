      "path": "src/rng.rs",
      "contents": "use core::ffi::c_void;\n\npub struct AesXofStruct {\n    buffer: [u8; 16],\n    buffer_pos: usize,\n    length_remaining: usize,\n    key: [u8; 32],\n    ctr: [u8; 16],\n}\n\npub struct Aes256CtrDrbgStruct {\n    key: [u8; 32],\n    v: [u8; 16],\n    reseed_counter: i32,\n}\n\nstatic mut DRBG_CTX: Aes256CtrDrbgStruct = Aes256CtrDrbgStruct {\n    key: [0u8; 32],\n    v: [0u8; 16],\n    reseed_counter: 0,\n};\n\npub fn aes256_ctr_drbg_update(provided_data: Option<&[u8]>, key: &mut [u8], v: &mut [u8]) {\n    let mut temp = [0u8; 48];\n\n    for i in 0..3 {\n        for j in (0..16).rev() {\n            if v[j] == 0xff {\n                v[j] = 0x00;\n            } else {\n                v[j] += 1;\n                break;\n            }\n        }\n        aes256_ecb(key, v, &mut temp[i * 16..(i + 1) * 16]);\n    }\n\n    if let Some(data) = provided_data {\n        for i in 0..48 {\n            temp[i] ^= data[i];\n        }\n    }\n\n    key.copy_from_slice(&temp[0..32]);\n    v.copy_from_slice(&temp[32..48]);\n}\n\npub fn seedexpander_init(ctx: &mut AesXofStruct, seed: &[u8], diversifier: &[u8], maxlen: usize) -> i32 {\n    if maxlen >= 0x100000000 {\n        return -1;\n    }\n\n    ctx.length_remaining = maxlen;\n    ctx.key.copy_from_slice(&seed[0..32]);\n    ctx.ctr[0..8].copy_from_slice(&diversifier[0..8]);\n    ctx.ctr[11] = (maxlen % 256) as u8;\n    let mut m = maxlen >> 8;\n    ctx.ctr[10] = (m % 256) as u8;\n    m >>= 8;\n    ctx.ctr[9] = (m % 256) as u8;\n    m >>= 8;\n    ctx.ctr[8] = (m % 256) as u8;\n    ctx.ctr[12..16].fill(0x00);\n\n    ctx.buffer_pos = 16;\n    ctx.buffer.fill(0x00);\n\n    0\n}\n\npub fn seedexpander(ctx: &mut AesXofStruct, x: &mut [u8]) -> i32 {\n    let mut offset = 0;\n    let mut xlen = x.len();\n\n    while xlen > 0 {\n        if xlen <= 16 - ctx.buffer_pos {\n            x[offset..offset + xlen].copy_from_slice(&ctx.buffer[ctx.buffer_pos..ctx.buffer_pos + xlen]);\n            ctx.buffer_pos += xlen;\n            return 0;\n        }\n\n        let take = 16 - ctx.buffer_pos;\n        x[offset..offset + take].copy_from_slice(&ctx.buffer[ctx.buffer_pos..16]);\n        xlen -= take;\n        offset += take;\n\n        aes256_ecb(&ctx.key, &ctx.ctr, &mut ctx.buffer);\n        ctx.buffer_pos = 0;\n\n        for i in (12..16).rev() {\n            if ctx.ctr[i] == 0xff {\n                ctx.ctr[i] = 0x00;\n            } else {\n                ctx.ctr[i] += 1;\n                break;\n            }\n        }\n    }\n\n    0\n}\n\npub fn randombytes_init(entropy_input: &[u8], personalization_string: Option<&[u8]>) {\n    let mut seed_material = [0u8; 48];\n    seed_material.copy_from_slice(&entropy_input[0..48]);\n\n    if let Some(ps) = personalization_string {\n        for i in 0..48 {\n            seed_material[i] ^= ps[i];\n        }\n    }\n\n    unsafe {\n        DRBG_CTX.key.fill(0x00);\n        DRBG_CTX.v.fill(0x00);\n        aes256_ctr_drbg_update(Some(&seed_material), &mut DRBG_CTX.key, &mut DRBG_CTX.v);\n        DRBG_CTX.reseed_counter = 1;\n    }\n}\n\npub fn randombytes(x: &mut [u8]) -> i32 {\n    let mut block = [0u8; 16];\n    let mut i = 0;\n\n    unsafe {\n        while i < x.len() {\n            for j in (0..16).rev() {\n                if DRBG_CTX.v[j] == 0xff {\n                    DRBG_CTX.v[j] = 0x00;\n                } else {\n                    DRBG_CTX.v[j] += 1;\n                    break;\n                }\n            }\n\n            aes256_ecb(&DRBG_CTX.key, &DRBG_CTX.v, &mut block);\n\n            let take = (x.len() - i).min(16);\n            x[i..i + take].copy_from_slice(&block[0..take]);\n            i += take;\n        }\n\n        aes256_ctr_drbg_update(None, &mut DRBG_CTX.key, &mut DRBG_CTX.v);\n        DRBG_CTX.reseed_counter += 1;\n    }\n\n    0\n}\n\nfn aes256_ecb(key: &[u8], ctr: &[u8], buffer: &mut [u8]) {\n    use aes::cipher::{KeyInit, BlockEncrypt, generic_array::GenericArray};\n    use aes::Aes256;\n\n    let cipher = Aes256::new_from_slice(key).unwrap();\n    let mut block = GenericArray::clone_from_slice(ctr);\n    cipher.encrypt_block(&mut block);\n    buffer.copy_from_slice(&block);\n}\n"
