      "contents": "use crate::context::SpxCtx;\nuse crate::params::*;\nuse crate::hash::{initialize_hash_function, prf_addr, gen_message_random, hash_message};\nuse crate::fors::{fors_sign, fors_pk_from_sig};\nuse crate::merkle::{merkle_sign, merkle_gen_root};\nuse crate::wots::wots_pk_from_sig;\nuse crate::thash::thash;\nuse crate::address::{set_type, set_tree_addr, set_keypair_addr, set_layer_addr, copy_subtree_addr};\nuse crate::utils::compute_root;\nuse crate::randombytes::randombytes;\n\npub fn crypto_sign_secretkeybytes() -> usize {\n    SPX_SK_BYTES\n}\n\npub fn crypto_sign_publickeybytes() -> usize {\n    SPX_PK_BYTES\n}\n\npub fn crypto_sign_bytes() -> usize {\n    SPX_BYTES\n}\n\npub fn crypto_sign_seedbytes() -> usize {\n    3 * SPX_N\n}\n\npub fn crypto_sign_seed_keypair(pk: &mut [u8], sk: &mut [u8], seed: &[u8]) -> i32 {\n    let mut ctx = SpxCtx::new();\n\n    sk[0..3 * SPX_N].copy_from_slice(&seed[0..3 * SPX_N]);\n\n    pk[0..SPX_N].copy_from_slice(&sk[2 * SPX_N..3 * SPX_N]);\n\n    ctx.pub_seed.copy_from_slice(&pk[0..SPX_N]);\n    ctx.sk_seed.copy_from_slice(&sk[0..SPX_N]);\n\n    initialize_hash_function(&mut ctx);\n\n    merkle_gen_root(&mut sk[3 * SPX_N..3 * SPX_N + SPX_N], &ctx);\n\n    pk[SPX_N..2 * SPX_N].copy_from_slice(&sk[3 * SPX_N..3 * SPX_N + SPX_N]);\n\n    0\n}\n\npub fn crypto_sign_keypair(pk: &mut [u8], sk: &mut [u8]) -> i32 {\n    let mut seed = [0u8; 3 * SPX_N];\n    randombytes(&mut seed);\n    crypto_sign_seed_keypair(pk, sk, &seed)\n}\n\npub fn crypto_sign_signature(sig: &mut [u8], siglen: &mut usize, m: &[u8], sk: &[u8]) -> i32 {\n    let mut ctx = SpxCtx::new();\n    let sk_prf = &sk[SPX_N..2 * SPX_N];\n    let pk = &sk[2 * SPX_N..2 * SPX_N + SPX_PK_BYTES];\n    let mut optrand = [0u8; SPX_N];\n    let mut mhash = [0u8; SPX_FORS_MSG_BYTES];\n    let mut root = [0u8; SPX_N];\n    let mut tree: u64 = 0;\n    let mut idx_leaf: u32 = 0;\n    let mut wots_addr = [0u32; 8];\n    let mut tree_addr = [0u32; 8];\n\n    ctx.sk_seed.copy_from_slice(&sk[0..SPX_N]);\n    ctx.pub_seed.copy_from_slice(&pk[0..SPX_N]);\n\n    initialize_hash_function(&mut ctx);\n\n    set_type(&mut wots_addr, SPX_ADDR_TYPE_WOTS as u32);\n    set_type(&mut tree_addr, SPX_ADDR_TYPE_HASHTREE as u32);\n\n    randombytes(&mut optrand);\n    gen_message_random(&mut sig[0..SPX_N], sk_prf, &optrand, m, &ctx);\n\n    hash_message(&mut mhash, &mut tree, &mut idx_leaf, &sig[0..SPX_N], pk, m, &ctx);\n\n    set_tree_addr(&mut wots_addr, tree);\n    set_keypair_addr(&mut wots_addr, idx_leaf);\n\n    fors_sign(&mut sig[SPX_N..SPX_N + SPX_FORS_BYTES], &mut root, &mhash, &ctx, &wots_addr);\n\n    let mut sig_offset = SPX_N + SPX_FORS_BYTES;\n\n    for i in 0..SPX_D {\n        set_layer_addr(&mut tree_addr, i as u32);\n        set_tree_addr(&mut tree_addr, tree);\n\n        copy_subtree_addr(&mut wots_addr, &tree_addr);\n        set_keypair_addr(&mut wots_addr, idx_leaf);\n\n        merkle_sign(\n            &mut sig[sig_offset..sig_offset + SPX_WOTS_BYTES + SPX_TREE_HEIGHT * SPX_N],\n            &mut root,\n            &ctx,\n            &mut wots_addr,\n            &mut tree_addr,\n            idx_leaf,\n        );\n        sig_offset += SPX_WOTS_BYTES + SPX_TREE_HEIGHT * SPX_N;\n\n        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT) - 1)) as u32;\n        tree >>= SPX_TREE_HEIGHT;\n    }\n\n    *siglen = SPX_BYTES;\n    0\n}\n\npub fn crypto_sign_verify(sig: &[u8], siglen: usize, m: &[u8], pk: &[u8]) -> i32 {\n    if siglen != SPX_BYTES {\n        return -1;\n    }\n\n    let mut ctx = SpxCtx::new();\n    let pub_root = &pk[SPX_N..2 * SPX_N];\n    let mut mhash = [0u8; SPX_FORS_MSG_BYTES];\n    let mut wots_pk = [0u8; SPX_WOTS_BYTES];\n    let mut root = [0u8; SPX_N];\n    let mut leaf = [0u8; SPX_N];\n    let mut tree: u64 = 0;\n    let mut idx_leaf: u32 = 0;\n    let mut wots_addr = [0u32; 8];\n    let mut tree_addr = [0u32; 8];\n    let mut wots_pk_addr = [0u32; 8];\n\n    ctx.pub_seed.copy_from_slice(&pk[0..SPX_N]);\n\n    initialize_hash_function(&mut ctx);\n\n    set_type(&mut wots_addr, SPX_ADDR_TYPE_WOTS as u32);\n    set_type(&mut tree_addr, SPX_ADDR_TYPE_HASHTREE as u32);\n    set_type(&mut wots_pk_addr, SPX_ADDR_TYPE_WOTSPK as u32);\n\n    hash_message(&mut mhash, &mut tree, &mut idx_leaf, &sig[0..SPX_N], pk, m, &ctx);\n\n    set_tree_addr(&mut wots_addr, tree);\n    set_keypair_addr(&mut wots_addr, idx_leaf);\n\n    fors_pk_from_sig(&mut root, &sig[SPX_N..SPX_N + SPX_FORS_BYTES], &mhash, &ctx, &wots_addr);\n\n    let mut sig_offset = SPX_N + SPX_FORS_BYTES;\n\n    for i in 0..SPX_D {\n        set_layer_addr(&mut tree_addr, i as u32);\n        set_tree_addr(&mut tree_addr, tree);\n\n        copy_subtree_addr(&mut wots_addr, &tree_addr);\n        set_keypair_addr(&mut wots_addr, idx_leaf);\n\n        crate::address::copy_keypair_addr(&mut wots_pk_addr, &wots_addr);\n\n        wots_pk_from_sig(\n            &mut wots_pk,\n            &sig[sig_offset..sig_offset + SPX_WOTS_BYTES],\n            &root,\n            &ctx,\n            &mut wots_addr,\n        );\n        sig_offset += SPX_WOTS_BYTES;\n\n        thash(&mut leaf, &wots_pk, SPX_WOTS_LEN, &ctx, &wots_pk_addr);\n\n        compute_root(\n            &mut root,\n            &leaf,\n            idx_leaf,\n            0,\n            &sig[sig_offset..sig_offset + SPX_TREE_HEIGHT * SPX_N],\n            SPX_TREE_HEIGHT as u32,\n            &ctx,\n            &mut tree_addr,\n        );\n        sig_offset += SPX_TREE_HEIGHT * SPX_N;\n\n        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT) - 1)) as u32;\n        tree >>= SPX_TREE_HEIGHT;\n    }\n\n    if root != pub_root {\n        return -1;\n    }\n\n    0\n}\n\npub fn crypto_sign(sm: &mut [u8], smlen: &mut usize, m: &[u8], sk: &[u8]) -> i32 {\n    let mut siglen = 0usize;\n    crypto_sign_signature(&mut sm[0..SPX_BYTES], &mut siglen, m, sk);\n    sm[SPX_BYTES..SPX_BYTES + m.len()].copy_from_slice(m);\n    *smlen = siglen + m.len();\n    0\n}\n\npub fn crypto_sign_open(m: &mut [u8], mlen: &mut usize, sm: &[u8], smlen: usize, pk: &[u8]) -> i32 {\n    if smlen < SPX_BYTES {\n        m.fill(0);\n        *mlen = 0;\n        return -1;\n    }\n\n    *mlen = smlen - SPX_BYTES;\n\n    if crypto_sign_verify(&sm[0..SPX_BYTES], SPX_BYTES, &sm[SPX_BYTES..smlen], pk) != 0 {\n        m.fill(0);\n        *mlen = 0;\n        return -1;\n    }\n\n    m[0..*mlen].copy_from_slice(&sm[SPX_BYTES..smlen]);\n    0\n}\n"
