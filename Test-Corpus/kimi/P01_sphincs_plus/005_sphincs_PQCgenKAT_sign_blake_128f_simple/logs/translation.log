      "path": "src/utilsx1.rs",
      "contents": "use crate::context::SpxCtx;\nuse crate::params::*;\nuse crate::thash::thash;\nuse crate::address::{set_tree_height, set_tree_index, set_type};\nuse crate::wotsx1::{wots_gen_leafx1, LeafInfoX1};\nuse crate::forsx1::fors_gen_leafx1;\n\npub fn wots_treehashx1(\n    root: &mut [u8],\n    auth_path: &mut [u8],\n    ctx: &SpxCtx,\n    leaf_idx: u32,\n    idx_offset: u32,\n    tree_height: u32,\n    tree_addr: &mut [u32; 8],\n    info: &mut LeafInfoX1,\n) {\n    let mut stack = vec![0u8; (tree_height as usize) * SPX_N];\n    let max_idx = (1u32 << tree_height) - 1;\n\n    for idx in 0..=max_idx {\n        let mut current = [0u8; 2 * SPX_N];\n        wots_gen_leafx1(&mut current[SPX_N..2 * SPX_N], ctx, idx + idx_offset, info);\n\n        let mut internal_idx_offset = idx_offset;\n        let mut internal_idx = idx;\n        let mut internal_leaf = leaf_idx;\n        let mut h: u32 = 0;\n\n        loop {\n            if h == tree_height {\n                root.copy_from_slice(&current[SPX_N..2 * SPX_N]);\n                return;\n            }\n\n            if (internal_idx ^ internal_leaf) == 0x01 {\n                auth_path[(h as usize) * SPX_N..(h as usize + 1) * SPX_N].copy_from_slice(&current[SPX_N..2 * SPX_N]);\n            }\n\n            if (internal_idx & 1) == 0 && idx < max_idx {\n                break;\n            }\n\n            internal_idx_offset >>= 1;\n            set_tree_height(tree_addr, h + 1);\n            set_tree_index(tree_addr, internal_idx / 2 + internal_idx_offset);\n\n            let left = &stack[(h as usize) * SPX_N..(h as usize + 1) * SPX_N];\n            current[0..SPX_N].copy_from_slice(left);\n            thash(&mut current[SPX_N..2 * SPX_N], &current[0..2 * SPX_N], 2, ctx, tree_addr);\n\n            h += 1;\n            internal_idx >>= 1;\n            internal_leaf >>= 1;\n        }\n\n        stack[(h as usize) * SPX_N..(h as usize + 1) * SPX_N].copy_from_slice(&current[SPX_N..2 * SPX_N]);\n    }\n}\n\npub fn fors_treehashx1(\n    root: &mut [u8],\n    auth_path: &mut [u8],\n    ctx: &SpxCtx,\n    leaf_idx: u32,\n    idx_offset: u32,\n    tree_height: u32,\n    tree_addr: &mut [u32; 8],\n    info: &mut LeafInfoX1,\n) {\n    let mut stack = vec![0u8; (tree_height as usize) * SPX_N];\n    let max_idx = (1u32 << tree_height) - 1;\n\n    for idx in 0..=max_idx {\n        let mut current = [0u8; 2 * SPX_N];\n        fors_gen_leafx1(&mut current[SPX_N..2 * SPX_N], ctx, idx + idx_offset, info);\n\n        let mut internal_idx_offset = idx_offset;\n        let mut internal_idx = idx;\n        let mut internal_leaf = leaf_idx;\n        let mut h: u32 = 0;\n\n        loop {\n            if h == tree_height {\n                root.copy_from_slice(&current[SPX_N..2 * SPX_N]);\n                return;\n            }\n\n            if (internal_idx ^ internal_leaf) == 0x01 {\n                auth_path[(h as usize) * SPX_N..(h as usize + 1) * SPX_N].copy_from_slice(&current[SPX_N..2 * SPX_N]);\n            }\n\n            if (internal_idx & 1) == 0 && idx < max_idx {\n                break;\n            }\n\n            internal_idx_offset >>= 1;\n            set_tree_height(tree_addr, h + 1);\n            set_tree_index(tree_addr, internal_idx / 2 + internal_idx_offset);\n\n            let left = &stack[(h as usize) * SPX_N..(h as usize + 1) * SPX_N];\n            current[0..SPX_N].copy_from_slice(left);\n            thash(&mut current[SPX_N..2 * SPX_N], &current[0..2 * SPX_N], 2, ctx, tree_addr);\n\n            h += 1;\n            internal_idx >>= 1;\n            internal_leaf >>= 1;\n        }\n\n        stack[(h as usize) * SPX_N..(h as usize + 1) * SPX_N].copy_from_slice(&current[SPX_N..2 * SPX_N]);\n    }\n}\n"
    },
    {
      "path": "src/wots.rs",
      "contents": "use crate::context::SpxCtx;\nuse crate::params::*;\nuse crate::thash::thash;\nuse crate::address::{set_chain_addr, set_hash_addr};\nuse crate::utils::{ull_to_bytes, u32_to_bytes};\n\nfn gen_chain(\n    out: &mut [u8],\n    inp: &[u8],\n    start: u32,\n    steps: u32,\n    ctx: &SpxCtx,\n    addr: &mut [u32; 8],\n) {\n    out.copy_from_slice(inp);\n\n    for i in start..(start + steps).min(SPX_WOTS_W as u32) {\n        set_hash_addr(addr, i);\n        thash(out, out, 1, ctx, addr);\n    }\n}\n\nfn base_w(output: &mut [u32], out_len: usize, input: &[u8]) {\n    let mut in_idx = 0;\n    let mut out_idx = 0;\n    let mut total: u8 = 0;\n    let mut bits: i32 = 0;\n\n    for _ in 0..out_len {\n        if bits == 0 {\n            total = input[in_idx];\n            in_idx += 1;\n            bits = 8;\n        }\n        bits -= SPX_WOTS_LOGW as i32;\n        output[out_idx] = ((total >> bits) & ((SPX_WOTS_W - 1) as u8)) as u32;\n        out_idx += 1;\n    }\n}\n\nfn wots_checksum(csum_base_w: &mut [u32], msg_base_w: &[u32]) {\n    let mut csum: u64 = 0;\n    let mut csum_bytes = [0u8; 4];\n\n    for i in 0..SPX_WOTS_LEN1 {\n        csum += (SPX_WOTS_W - 1 - msg_base_w[i] as usize) as u64;\n    }\n\n    let shift = (8 - ((SPX_WOTS_LEN2 * SPX_WOTS_LOGW) % 8)) % 8;\n    csum <<= shift;\n    ull_to_bytes(&mut csum_bytes, csum_bytes.len(), csum);\n    base_w(csum_base_w, SPX_WOTS_LEN2, &csum_bytes);\n}\n\npub fn chain_lengths(lengths: &mut [u32], msg: &[u8]) {\n    base_w(&mut lengths[0..SPX_WOTS_LEN1], SPX_WOTS_LEN1, msg);\n    wots_checksum(&mut lengths[SPX_WOTS_LEN1..SPX_WOTS_LEN], &lengths[0..SPX_WOTS_LEN1]);\n}\n\npub fn wots_pk_from_sig(\n    pk: &mut [u8],\n    sig: &[u8],\n    msg: &[u8],\n    ctx: &SpxCtx,\n    addr: &mut [u32; 8],\n) {\n    let mut lengths = [0u32; SPX_WOTS_LEN];\n    chain_lengths(&mut lengths, msg);\n\n    for i in 0..SPX_WOTS_LEN {\n        set_chain_addr(addr, i as u32);\n        gen_chain(\n            &mut pk[i * SPX_N..(i + 1) * SPX_N],\n            &sig[i * SPX_N..(i + 1) * SPX_N],\n            lengths[i],\n            (SPX_WOTS_W - 1 - lengths[i]) as u32,\n            ctx,\n            addr,\n        );\n    }\n}\n"
    },
    {
      "path": "src/wotsx1.rs",
      "contents": "use crate::context::SpxCtx;\nuse crate::params::*;\nuse crate::hash::prf_addr;\nuse crate::thash::thash;\nuse crate::address::{set_keypair_addr, set_chain_addr, set_hash_addr, set_type, copy_subtree_addr};\nuse crate::wots::{chain_lengths, SPX_WOTS_LEN};\n\npub struct LeafInfoX1 {\n    pub wots_sig: Option<&'static mut [u8]>,\n    pub wots_sign_leaf: u32,\n    pub wots_steps: &'static mut [u32],\n    pub leaf_addr: [u32; 8],\n    pub pk_addr: [u32; 8],\n}\n\nimpl LeafInfoX1 {\n    pub fn new() -> Self {\n        Self {\n            wots_sig: None,\n            wots_sign_leaf: !0u32,\n            wots_steps: unsafe { core::slice::from_raw_parts_mut(core::ptr::null_mut(), SPX_WOTS_LEN) },\n            leaf_addr: [0u32; 8],\n            pk_addr: [0u32; 8],\n        }\n    }\n}\n\nimpl Default for LeafInfoX1 {\n    fn default() -> Self {\n        Self::new()\n    }\n}\n\npub fn wots_gen_leafx1(\n    dest: &mut [u8],\n    ctx: &SpxCtx,\n    leaf_idx: u32,\n    info: &mut LeafInfoX1,\n) {\n    let leaf_addr = &mut info.leaf_addr;\n    let pk_addr = &mut info.pk_addr;\n    let mut pk_buffer = [0u8; SPX_WOTS_BYTES];\n\n    let wots_k_mask = if leaf_idx == info.wots_sign_leaf {\n        0u32\n    } else {\n        !0u32\n    };\n\n    set_keypair_addr(leaf_addr, leaf_idx);\n    set_keypair_addr(pk_addr, leaf_idx);\n\n    for i in 0..SPX_WOTS_LEN {\n        let wots_k = info.wots_steps[i] | wots_k_mask;\n\n        set_chain_addr(leaf_addr, i as u32);\n        set_hash_addr(leaf_addr, 0);\n        set_type(leaf_addr, SPX_ADDR_TYPE_WOTSPRF as u32);\n\n        prf_addr(&mut pk_buffer[i * SPX_N..(i + 1) * SPX_N], ctx, leaf_addr);\n\n        set_type(leaf_addr, SPX_ADDR_TYPE_WOTS as u32);\n\n        let mut k: u32 = 0;\n        loop {\n            if k == wots_k {\n                if let Some(sig) = info.wots_sig.as_mut() {\n                    sig[i * SPX_N..(i + 1) * SPX_N].copy_from_slice(&pk_buffer[i * SPX_N..(i + 1) * SPX_N]);\n                }\n            }\n\n            if k == SPX_WOTS_W as u32 - 1 {\n                break;\n            }\n\n            set_hash_addr(leaf_addr, k);\n            thash(&mut pk_buffer[i * SPX_N..(i + 1) * SPX_N], &pk_buffer[i * SPX_N..(i + 1) * SPX_N], 1, ctx, leaf_addr);\n\n            k += 1;\n        }\n    }\n\n    thash(dest, &pk_buffer, SPX_WOTS_LEN, ctx, pk_addr);\n}\n"
    },
    {
      "path": "src/fors.rs",
      "contents": "use crate::context::SpxCtx;\nuse crate::params::*;\nuse crate::hash::prf_addr;\nuse crate::thash::thash;\nuse crate::address::{set_tree_index, set_tree_height, set_type, copy_keypair_addr};\nuse crate::utils::{compute_root, bytes_to_ull};\nuse crate::utilsx1::fors_treehashx1;\nuse crate::forsx1::fors_gen_leafx1;\n\npub struct ForsGenLeafInfo {\n    pub leaf_addrx: [u32; 8],\n}\n\nimpl ForsGenLeafInfo {\n    pub fn new() -> Self {\n        Self {\n            leaf_addrx: [0u32; 8],\n        }\n    }\n}\n\nimpl Default for ForsGenLeafInfo {\n    fn default() -> Self {\n        Self::new()\n    }\n}\n\nfn fors_gen_sk(sk: &mut [u8], ctx: &SpxCtx, fors_leaf_addr: &[u32; 8]) {\n    prf_addr(sk, ctx, fors_leaf_addr);\n}\n\nfn fors_sk_to_leaf(leaf: &mut [u8], sk: &[u8], ctx: &SpxCtx, fors_leaf_addr: &[u32; 8]) {\n    thash(leaf, sk, 1, ctx, fors_leaf_addr);\n}\n\nfn message_to_indices(indices: &mut [u32], m: &[u8]) {\n    let mut offset: usize = 0;\n\n    for i in 0..SPX_FORS_TREES {\n        indices[i] = 0;\n        for j in 0..SPX_FORS_HEIGHT {\n            indices[i] ^= (((m[offset >> 3] >> (offset & 0x7)) & 1u8) as u32) << j;\n            offset += 1;\n        }\n    }\n}\n\npub fn fors_sign(\n    sig: &mut [u8],\n    pk: &mut [u8],\n    m: &[u8],\n    ctx: &SpxCtx,\n    fors_addr: &[u32; 8],\n) {\n    let mut indices = [0u32; SPX_FORS_TREES];\n    let mut roots = vec![0u8; SPX_FORS_TREES * SPX_N];\n    let mut fors_tree_addr = [0u32; 8];\n    let mut fors_info = ForsGenLeafInfo::new();\n    let fors_leaf_addr = &mut fors_info.leaf_addrx;\n    let mut fors_pk_addr = [0u32; 8];\n\n    copy_keypair_addr(&mut fors_tree_addr, fors_addr);\n    copy_keypair_addr(fors_leaf_addr, fors_addr);\n    copy_keypair_addr(&mut fors_pk_addr, fors_addr);\n\n    set_type(&mut fors_pk_addr, SPX_ADDR_TYPE_FORSPK as u32);\n\n    message_to_indices(&mut indices, m);\n\n    let mut sig_offset = 0;\n    let mut roots_offset = 0;\n\n    for i in 0..SPX_FORS_TREES {\n        let idx_offset = i * (1 << SPX_FORS_HEIGHT);\n\n        set_tree_height(&mut fors_tree_addr, 0);\n        set_tree_index(&mut fors_tree_addr, indices[i] + idx_offset as u32);\n        set_type(&mut fors_tree_addr, SPX_ADDR_TYPE_FORSPRF as u32);\n\n        fors_gen_sk(&mut sig[sig_offset..sig_offset + SPX_N], ctx, &fors_tree_addr);\n        sig_offset += SPX_N;\n\n        set_type(&mut fors_tree_addr, SPX_ADDR_TYPE_FORSTREE as u32);\n\n        let mut auth_path = vec![0u8; SPX_FORS_HEIGHT * SPX_N];\n        fors_treehashx1(\n            &mut roots[roots_offset..roots_offset + SPX_N],\n            &mut auth_path,\n            ctx,\n            indices[i],\n            idx_offset as u32,\n            SPX_FORS_HEIGHT as u32,\n            &mut fors_tree_addr,\n            &mut LeafInfoX1::new(),\n        );\n        roots_offset += SPX_N;\n\n        sig[sig_offset..sig_offset + auth_path.len()].copy_from_slice(&auth_path);\n        sig_offset += auth_path.len();\n    }\n\n    thash(pk, &roots, SPX_FORS_TREES, ctx, &fors_pk_addr);\n}\n\nuse crate::wotsx1::LeafInfoX1;\n\npub fn fors_pk_from_sig(\n    pk: &mut [u8],\n    sig: &[u8],\n    m: &[u8],\n    ctx: &SpxCtx,\n    fors_addr: &[u32; 8],\n) {\n    let mut indices = [0u32; SPX_FORS_TREES];\n    let mut roots = vec![0u8; SPX_FORS_TREES * SPX_N];\n    let mut leaf = [0u8; SPX_N];\n    let mut fors_tree_addr = [0u32; 8];\n    let mut fors_pk_addr = [0u32; 8];\n\n    copy_keypair_addr(&mut fors_tree_addr, fors_addr);\n    copy_keypair_addr(&mut fors_pk_addr, fors_addr);\n\n    set_type(&mut fors_tree_addr, SPX_ADDR_TYPE_FORSTREE as u32);\n    set_type(&mut fors_pk_addr, SPX_ADDR_TYPE_FORSPK as u32);\n\n    message_to_indices(&mut indices, m);\n\n    let mut sig_offset = 0;\n    let mut roots_offset = 0;\n\n    for i in 0..SPX_FORS_TREES {\n        let idx_offset = i * (1 << SPX_FORS_HEIGHT);\n\n        set_tree_height(&mut fors_tree_addr, 0);\n        set_tree_index(&mut fors_tree_addr, indices[i] + idx_offset as u32);\n\n        fors_sk_to_leaf(&mut leaf, &sig[sig_offset..sig_offset + SPX_N], ctx, &fors_tree_addr);\n        sig_offset += SPX_N;\n\n        let mut auth_path = vec![0u8; SPX_FORS_HEIGHT * SPX_N];\n        auth_path.copy_from_slice(&sig[sig_offset..sig_offset + SPX_FORS_HEIGHT * SPX_N]);\n        sig_offset += SPX_FORS_HEIGHT * SPX_N;\n\n        compute_root(\n            &mut roots[roots_offset..roots_offset + SPX_N],\n            &leaf,\n            indices[i],\n            idx_offset as u32,\n            &auth_path,\n            SPX_FORS_HEIGHT as u32,\n            ctx,\n            &mut fors_tree_addr,\n        );\n        roots_offset += SPX_N;\n    }\n\n    thash(pk, &roots, SPX_FORS_TREES, ctx, &fors_pk_addr);\n}\n"
    },
    {
      "path": "src/forsx1.rs",
      "contents": "use crate::context::SpxCtx;\nuse crate::fors::ForsGenLeafInfo;\nuse crate::address::{set_tree_index, set_type};\nuse crate::hash::prf_addr;\nuse crate::thash::thash;\nuse crate::wotsx1::LeafInfoX1;\n\npub fn fors_gen_leafx1(\n    leaf: &mut [u8],\n    ctx: &SpxCtx,\n    addr_idx: u32,\n    info: &mut LeafInfoX1,\n) {\n    let fors_info = unsafe { &mut *(info as *mut LeafInfoX1 as *mut ForsGenLeafInfo) };\n    let fors_leaf_addr = &mut fors_info.leaf_addrx;\n\n    set_tree_index(fors_leaf_addr, addr_idx);\n    set_type(fors_leaf_addr, crate::params::SPX_ADDR_TYPE_FORSPRF as u32);\n    prf_addr(leaf, ctx, fors_leaf_addr);\n\n    set_type(fors_leaf_addr, crate::params::SPX_ADDR_TYPE_FORSTREE as u32);\n    thash(leaf, leaf, 1, ctx, fors_leaf_addr);\n}\n"
    },
    {
      "path": "src/merkle.rs",
      "contents": "use crate::context::SpxCtx;\nuse crate::params::*;\nuse crate::address::{set_layer_addr, set_type, copy_subtree_addr, copy_keypair_addr};\nuse crate::utilsx1::wots_treehashx1;\nuse crate::wots::chain_lengths;\nuse crate::wotsx1::LeafInfoX1;\n\npub fn merkle_sign(\n    sig: &mut [u8],\n    root: &mut [u8],\n    ctx: &SpxCtx,\n    wots_addr: &mut [u32; 8],\n    tree_addr: &mut [u32; 8],\n    idx_leaf: u32,\n) {\n    let auth_path = &mut sig[SPX_WOTS_BYTES..];\n    let mut info = LeafInfoX1::new();\n    let mut steps = [0u32; SPX_WOTS_LEN];\n\n    info.wots_sig = Some(&mut sig[0..SPX_WOTS_BYTES]);\n    chain_lengths(&mut steps, root);\n    info.wots_steps = unsafe { core::slice::from_raw_parts_mut(steps.as_mut_ptr(), steps.len()) };\n\n    set_type(&mut tree_addr[0], SPX_ADDR_TYPE_HASHTREE as u32);\n    set_type(&mut info.pk_addr[0], SPX_ADDR_TYPE_WOTSPK as u32);\n    copy_subtree_addr(&mut info.leaf_addr[0], wots_addr);\n    copy_subtree_addr(&mut info.pk_addr[0], wots_addr);\n\n    info.wots_sign_leaf = idx_leaf;\n\n    wots_treehashx1(\n        root,\n        auth_path,\n        ctx,\n        idx_leaf,\n        0,\n        SPX_TREE_HEIGHT as u32,\n        tree_addr,\n        &mut info,\n    );\n}\n\npub fn merkle_gen_root(root: &mut [u8], ctx: &SpxCtx) {\n    let mut auth_path = vec![0u8; SPX_TREE_HEIGHT * SPX_N + SPX_WOTS_BYTES];\n    let mut top_tree_addr = [0u32; 8];\n    let mut wots_addr = [0u32; 8];\n\n    set_layer_addr(&mut top_tree_addr, (SPX_D - 1) as u32);\n    set_layer_addr(&mut wots_addr, (SPX_D - 1) as u32);\n\n    merkle_sign(\n        &mut auth_path,\n        root,\n        ctx,\n        &mut wots_addr,\n        &mut top_tree_addr,\n        !0u32,\n    );\n}\n"
    },
    {
      "path": "src/hash.rs",
      "contents": "use crate::context::SpxCtx;\nuse crate::params::*;\nuse crate::utils::{ull_to_bytes, bytes_to_ull};\n\n#[cfg(feature = \"shake\")]\nuse sha3::{Shake256, shake256};\n#[cfg(feature = \"shake\")]\nuse sha3::digest::{Update, ExtendableOutput, XofReader};\n\n#[cfg(feature = \"sha2\")]\nuse sha2::{Sha256, Sha512, Digest};\n\n#[cfg(feature = \"blake\")]\nuse blake2::{Blake2b512, Blake2s256, Digest};\n\npub fn initialize_hash_function(ctx: &mut SpxCtx) {\n    #[cfg(feature = \"haraka\")]\n    {\n        crate::haraka::tweak_constants(ctx);\n    }\n    #[cfg(feature = \"sha2\")]\n    {\n        crate::sha2_hash::seed_state(ctx);\n    }\n}\n\npub fn prf_addr(out: &mut [u8], ctx: &SpxCtx, addr: &[u32; 8]) {\n    #[cfg(feature = \"shake\")]\n    {\n        let mut hasher = Shake256::default();\n        hasher.update(&ctx.pub_seed);\n        hasher.update(unsafe { core::slice::from_raw_parts(addr.as_ptr() as *const u8, SPX_ADDR_BYTES) });\n        hasher.update(&ctx.sk_seed);\n        let mut reader = hasher.finalize_xof();\n        reader.read(out);\n    }\n    #[cfg(feature = \"sha2\")]\n    {\n        crate::sha2_hash::prf_addr(out, ctx, addr);\n    }\n    #[cfg(feature = \"blake\")]\n    {\n        crate::blake_hash::prf_addr(out, ctx, addr);\n    }\n    #[cfg(feature = \"haraka\")]\n    {\n        crate::haraka::prf_addr(out, ctx, addr);\n    }\n}\n\npub fn gen_message_random(\n    r: &mut [u8],\n    sk_prf: &[u8],\n    optrand: &[u8],\n    m: &[u8],\n    ctx: &SpxCtx,\n) {\n    #[cfg(feature = \"shake\")]\n    {\n        let mut hasher = Shake256::default();\n        hasher.update(sk_prf);\n        hasher.update(optrand);\n        hasher.update(m);\n        let mut reader = hasher.finalize_xof();\n        reader.read(r);\n    }\n    #[cfg(feature = \"sha2\")]\n    {\n        crate::sha2_hash::gen_message_random(r, sk_prf, optrand, m, ctx);\n    }\n    #[cfg(feature = \"blake\")]\n    {\n        crate::blake_hash::gen_message_random(r, sk_prf, optrand, m, ctx);\n    }\n    #[cfg(feature = \"haraka\")]\n    {\n        crate::haraka::gen_message_random(r, sk_prf, optrand, m, ctx);\n    }\n}\n\npub fn hash_message(\n    digest: &mut [u8],\n    tree: &mut u64,\n    leaf_idx: &mut u32,\n    r: &[u8],\n    pk: &[u8],\n    m: &[u8],\n    ctx: &SpxCtx,\n) {\n    const SPX_TREE_BITS: usize = SPX_TREE_HEIGHT * (SPX_D - 1);\n    const SPX_TREE_BYTES: usize = (SPX_TREE_BITS + 7) / 8;\n    const SPX_LEAF_BITS: usize = SPX_TREE_HEIGHT;\n    const SPX_LEAF_BYTES: usize = (SPX_LEAF_BITS + 7) / 8;\n    const SPX_DGST_BYTES: usize = SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES;\n\n    #[cfg(feature = \"shake\")]\n    {\n        let mut hasher = Shake256::default();\n        hasher.update(r);\n        hasher.update(pk);\n        hasher.update(m);\n        let mut reader = hasher.finalize_xof();\n        let mut buf = [0u8; SPX_DGST_BYTES];\n        reader.read(&mut buf);\n\n        digest.copy_from_slice(&buf[0..SPX_FORS_MSG_BYTES]);\n        let mut bufp = SPX_FORS_MSG_BYTES;\n\n        if SPX_D == 1 {\n            *tree = 0;\n        } else {\n            *tree = bytes_to_ull(&buf[bufp..bufp + SPX_TREE_BYTES], SPX_TREE_BYTES);\n            *tree &= (!0u64) >> (64 - SPX_TREE_BITS);\n        }\n        bufp += SPX_TREE_BYTES;\n\n        *leaf_idx = bytes_to_ull(&buf[bufp..bufp + SPX_LEAF_BYTES], SPX_LEAF_BYTES) as u32;\n        *leaf_idx &= (!0u32) >> (32 - SPX_LEAF_BITS);\n    }\n    #[cfg(feature = \"sha2\")]\n    {\n        crate::sha2_hash::hash_message(digest, tree, leaf_idx, r, pk, m, ctx);\n    }\n    #[cfg(feature = \"blake\")]\n    {\n        crate::blake_hash::hash_message(digest, tree, leaf_idx, r, pk, m, ctx);\n    }\n    #[cfg(feature = \"haraka\")]\n    {\n        crate::haraka::hash_message(digest, tree, leaf_idx, r, pk, m, ctx);\n    }\n}\n"
    },
