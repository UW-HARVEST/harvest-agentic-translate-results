  if item.is_null() {\n        return false;\n    }\n    \n    let type_ = (*item).type_ & 0xFF;\n    \n    match type_ {\n        cJSON_NULL => {\n            buffer.buffer.extend_from_slice(b\"null\");\n            buffer.offset += 4;\n            true\n        }\n        cJSON_False => {\n            buffer.buffer.extend_from_slice(b\"false\");\n            buffer.offset += 5;\n            true\n        }\n        cJSON_True => {\n            buffer.buffer.extend_from_slice(b\"true\");\n            buffer.offset += 4;\n            true\n        }\n        cJSON_Number => print_number(item, buffer),\n        cJSON_String => print_string_ptr((*item).valuestring, buffer),\n        cJSON_Array => print_array(item, buffer),\n        cJSON_Object => print_object(item, buffer),\n        cJSON_Raw => {\n            if (*item).valuestring.is_null() {\n                return false;\n            }\n            let s = CStr::from_ptr((*item).valuestring).to_bytes();\n            buffer.buffer.extend_from_slice(s);\n            buffer.offset += s.len();\n            true\n        }\n        _ => false,\n    }\n}\n\nunsafe fn print_number(item: *const cJSON, buffer: &mut PrintBuffer) -> bool {\n    let d = (*item).valuedouble;\n    \n    let s = if d.is_nan() || d.is_infinite() {\n        \"null\".to_string()\n    } else if d == (*item).valueint as f64 {\n        format!(\"{}\", (*item).valueint)\n    } else {\n        let mut s = format!(\"{:.15g}\", d);\n        if s.parse::<f64>().map(|v| (v - d).abs() > f64::EPSILON).unwrap_or(true) {\n            s = format!(\"{:.17g}\", d);\n        }\n        s\n    };\n    \n    buffer.buffer.extend_from_slice(s.as_bytes());\n    buffer.offset += s.len();\n    true\n}\n\nunsafe fn print_string_ptr(str: *const c_char, buffer: &mut PrintBuffer) -> bool {\n    if str.is_null() {\n        buffer.buffer.extend_from_slice(b\"\\\"\\\"\");\n        buffer.offset += 2;\n        return true;\n    }\n    \n    let bytes = CStr::from_ptr(str).to_b