    return ptr::null_mut();\n    }\n    get_array_item(array, index as usize)\n}\n\nunsafe fn case_insensitive_strcmp(s1: *const u8, s2: *const u8) -> i32 {\n    if s1.is_null() || s2.is_null() {\n        return 1;\n    }\n    if s1 == s2 {\n        return 0;\n    }\n    \n    let mut i = 0;\n    loop {\n        let c1 = (*s1.add(i)).to_ascii_lowercase();\n        let c2 = (*s2.add(i)).to_ascii_lowercase();\n        if c1 != c2 {\n            return c1 as i32 - c2 as i32;\n        }\n        if c1 == 0 {\n            return 0;\n        }\n        i += 1;\n    }\n}\n\nunsafe fn get_object_item(object: *const cJSON, name: *const c_char, case_sensitive: bool) -> *mut cJSON {\n    if object.is_null() || name.is_null() {\n        return ptr::null_mut();\n    }\n    \n    let mut current = (*object).child;\n    while !current.is_null() {\n        if !(*current).string.is_null() {\n            let cmp = if case_sensitive {\n                CStr::from_ptr(name).cmp(CStr::from_ptr((*current).string))\n            } else {\n                let cmp_result = case_insensitive_strcmp(name as *const u8, (*current).string as *const u8);\n                if cmp_result == 0 { std::cmp::Ordering::Equal } else { std::cmp::Ordering::Greater }\n            };\n            \n            if cmp == std::cmp::Ordering::Equal {\n                return current;\n            }\n        }\n        current = (*current).next;\n    }\n    ptr::null_mut()\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_GetObjectItem(object: *const cJSON, string: *const c_char) -> *mut cJSON {\n    get_object_item(object, string, false)\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_GetObjectItemCaseSensitive(object: *const cJSON, string: *const c_char) -> *mut cJSON {\n    get_object_item(object, string, true)\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_HasObjectItem(object: *const cJSON, string: *const c_char) -> cJSON_bool {\n    if cJSON_GetObjectItem(object, string).is