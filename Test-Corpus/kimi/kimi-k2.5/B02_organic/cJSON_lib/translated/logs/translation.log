 cJSON, buffer: &mut PrintBuffer) -> bool {\n    buffer.buffer.push(b'{');\n    buffer.offset += 1;\n    buffer.depth += 1;\n    \n    if buffer.format {\n        buffer.buffer.push(b'\\n');\n        buffer.offset += 1;\n    }\n    \n    let mut child = (*item).child;\n    while !child.is_null() {\n        if buffer.format {\n            for _ in 0..buffer.depth {\n                buffer.buffer.push(b'\\t');\n            }\n            buffer.offset += buffer.depth;\n        }\n        \n        if !print_string_ptr((*child).string, buffer) {\n            return false;\n        }\n        \n        buffer.buffer.push(b':');\n        if buffer.format {\n            buffer.buffer.push(b'\\t');\n        }\n        buffer.offset += if buffer.format { 2 } else { 1 };\n        \n        if !print_value(child, buffer) {\n            return false;\n        }\n        \n        child = (*child).next;\n        if !child.is_null() {\n            buffer.buffer.push(b',');\n        }\n        \n        if buffer.format {\n            buffer.buffer.push(b'\\n');\n        }\n        buffer.offset += 1;\n    }\n    \n    if buffer.format {\n        for _ in 0..buffer.depth - 1 {\n            buffer.buffer.push(b'\\t');\n        }\n        buffer.offset += buffer.depth - 1;\n    }\n    \n    buffer.buffer.push(b'}');\n    buffer.offset += 1;\n    buffer.depth -= 1;\n    \n    true\n}\n\nunsafe fn print(item: *const cJSON, format: bool) -> *mut c_char {\n    let mut buffer = PrintBuffer {\n        buffer: Vec::with_capacity(256),\n        offset: 0,\n        depth: 0,\n        format,\n    };\n    \n    if !print_value(item, &mut buffer) {\n        return ptr::null_mut();\n    }\n    \n    buffer.buffer.push(0);\n    \n    let result = (GLOBAL_HOOKS.allocate)(buffer.buffer.len()) as *mut c_char;\n    if result.is_null() {\n        return ptr::null_mut();\n    }\n    ptr::copy_nonoverlapping(buffer.buffer.as_ptr(), result as *mut u8, buffer.buffer.len());\n    result\n}\n\n#[unsafe(no