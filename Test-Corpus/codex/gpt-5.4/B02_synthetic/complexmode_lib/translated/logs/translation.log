{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport os\nimport sys\n\nbase = '/tmp/harvest-translate-6GGvBt/translated_rust'\nlibs = {\n    'c': os.path.join(base, 'original_c.so'),\n    'rust': os.path.join(base, 'target/release/libtranslated_rust.so'),\n}\nlibc = ctypes.CDLL(None)\nlibc.fflush.argtypes = [ctypes.c_void_p]\nlibc.fflush.restype = ctypes.c_int\n\ndef run(libpath, mode, a, b, c):\n    lib = ctypes.CDLL(libpath)\n    fn = lib.complexmode\n    fn.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int]\n    fn.restype = ctypes.c_int\n\n    rfd, wfd = os.pipe()\n    saved = os.dup(1)\n    try:\n        os.dup2(wfd, 1)\n        os.close(wfd)\n        ret = fn(mode, a, b, c)\n        libc.fflush(None)\n    finally:\n        os.dup2(saved, 1)\n        os.close(saved)\n    out = b''\n    while True:\n        chunk = os.read(rfd, 4096)\n        if not chunk:\n            break\n        out += chunk\n    os.close(rfd)\n    return ret, out\n\ncases = [\n    (1, 3, 4, 5),\n    (2, 3, 4, 5),\n    (3, 3, 4, 5),\n    (4, 3, 4, 5),\n    (0, 3, 4, 5),\n]\nfailed = False\nfor case in cases:\n    c_ret, c_out = run(libs['c'], *case)\n    r_ret, r_out = run(libs['rust'], *case)\n    same = (c_ret, c_out) == (r_ret, r_out)\n    print(case, 'OK' if same else 'DIFF')\n    if not same:\n        failed = True\n        print('  c_ret   =', c_ret)\n        print('  rust_ret=', r_ret)\n        print('  c_out   =', c_out)\n        print('  rust_out=', r_out)\nif failed:\n    sys.exit(1)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
