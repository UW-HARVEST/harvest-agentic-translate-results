{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\nimport ctypes\nfrom ctypes import c_char_p, POINTER, Structure, c_char\n\nclass OsData(Structure):\n    _fields_ = [\n        ('os_name', c_char_p),\n        ('os_version', c_char_p),\n        ('os_major', c_char_p),\n        ('os_minor', c_char_p),\n        ('os_codename', c_char_p),\n        ('os_platform', c_char_p),\n        ('os_build', c_char_p),\n        ('os_uname', c_char_p),\n        ('os_arch', c_char_p),\n    ]\n\nrust = ctypes.CDLL('target/release/libtranslated_rust.so')\nc = ctypes.CDLL('/tmp/harvest-translate-BfxU48/libcdriver.so')\nfor lib in (rust, c):\n    lib.parse_uname_string.argtypes = [ctypes.POINTER(c_char), POINTER(OsData)]\n    lib.parse_uname_string.restype = None\n\nlibc = ctypes.CDLL(None)\nlibc.free.argtypes = [ctypes.c_void_p]\n\nsamples = [\n    b'Microsoft Windows 10 Pro [Ver: 10.0.19045.4412]',\n    b'Ubuntu|linux: 22.04.1 LTS (Jammy Jellyfish) [x86_64]',\n    b'Debian GNU/Linux: 11 [amd64]',\n    b'Solaris [sparc]',\n    b'macOS|darwin: 14.5 [arm64]',\n]\n\nfor sample in samples:\n    bufs = [ctypes.create_string_buffer(sample) for _ in range(2)]\n    outs = [OsData(), OsData()]\n    rust.parse_uname_string(bufs[0], ctypes.byref(outs[0]))\n    c.parse_uname_string(bufs[1], ctypes.byref(outs[1]))\n\n    left = [getattr(outs[0], name) for name, _ in OsData._fields_]\n    right = [getattr(outs[1], name) for name, _ in OsData._fields_]\n    if left \"'!= right or bufs[0].raw != bufs[1].raw:\n        print('\"'MISMATCH', sample)\n        print('rust fields', left)\n        print('c fields   ', right)\n        print('rust raw', bufs[0].raw)\n        print('c raw   ', bufs[1].raw)\n        raise SystemExit(1)\n\n    for out in outs:\n        for name, _ in OsData._fields_:\n            ptr = getattr(out, name)\n            if ptr:\n                libc.free(ptr)\nprint('ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
