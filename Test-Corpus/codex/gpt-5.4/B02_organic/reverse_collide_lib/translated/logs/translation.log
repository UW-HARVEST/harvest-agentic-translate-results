n   320\t    let mut dmax = c2_dot(verts[0], d);\n   321\t    let mut i = 1;\n   322\t    while i < count {\n   323\t        let dot = c2_dot(verts[i as usize], d);\n   324\t        if dot > dmax {\n   325\t            imax = i;\n   326\t            dmax = dot;\n   327\t        }\n   328\t        i += 1;\n   329\t    }\n   330\t    imax\n   331\t}\n   332\t\n   333\tfn c2_witness(s: &C2Simplex, a: &mut C2v, b: &mut C2v) {\n   334\t    let den = 1.0 / s.div;\n   335\t    match s.count {\n   336\t        1 => {\n   337\t            *a = s.a.s_a;\n   338\t            *b = s.a.s_b;\n   339\t        }\n   340\t        2 => {\n   341\t            *a = c2_add(c2_mulvs(s.a.s_a, den * s.a.u), c2_mulvs(s.b.s_a, den * s.b.u));\n   342\t            *b = c2_add(c2_mulvs(s.a.s_b, den * s.a.u), c2_mulvs(s.b.s_b, den * s.b.u));\n   343\t        }\n   344\t        3 => {\n   345\t            *a = c2_add(\n   346\t                c2_add(c2_mulvs(s.a.s_a, den * s.a.u), c2_mulvs(s.b.s_a, den * s.b.u)),\n   347\t                c2_mulvs(s.c.s_a, den * s.c.u),\n   348\t            );\n   349\t            *b = c2_add(\n   350\t                c2_add(c2_mulvs(s.a.s_b, den * s.a.u), c2_mulvs(s.b.s_b, den * s.b.u)),\n   351\t                c2_mulvs(s.c.s_b, den * s.c.u),\n   352\t            );\n   353\t        }\n   354\t        _ => {\n   355\t            *a = c2_v(0.0, 0.0);\n   356\t            *b = c2_v(0.0, 0.0);\n   357\t        }\n   358\t    }\n   359\t}\n   360\t\n   361\tfn c2_div(a: C2v, b: f32) -> C2v {\n   362\t    c2_mulvs(a, 1.0 / b)\n   363\t}\n   364\t\n   365\tfn c2_norm(a: C2v) -> C2v {\n   366\t    c2_div(a, c2_len(a))\n   367\t}\n   368\t\n   369\tfn c2_l(s: &C2Simplex) -> C2v {\n   370\t    let den = 1.0 / s.div;\n   371\t    match s.count {\n   372\t        1 => s.a.p,\n   373\t        2 => c2_add(c2_mulvs(s.a.p, den * s.a.u), c2_mulvs(s.b.p, den * s.b.u)),\n   374\t        _ => c2_v(0.0, 0.0),\n   375\t    }\n   376\t}\n   377\t\n   378\tfn c2_mulrv_t(a: C2r, b: C2v