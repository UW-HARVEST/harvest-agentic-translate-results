    82\t}\n    83\t\n    84\t#[derive(Clone, Copy, Default)]\n    85\tstruct C2sv {\n    86\t    s_a: C2v,\n    87\t    s_b: C2v,\n    88\t    p: C2v,\n    89\t    u: f32,\n    90\t    i_a: c_int,\n    91\t    i_b: c_int,\n    92\t}\n    93\t\n    94\t#[derive(Clone, Copy, Default)]\n    95\tstruct C2Simplex {\n    96\t    a: C2sv,\n    97\t    b: C2sv,\n    98\t    c: C2sv,\n    99\t    d: C2sv,\n   100\t    div: f32,\n   101\t    count: c_int,\n   102\t}\n   103\t\n   104\tfn c2_v(x: f32, y: f32) -> C2v {\n   105\t    C2v { x, y }\n   106\t}\n   107\t\n   108\tfn c2_mulvs(mut a: C2v, b: f32) -> C2v {\n   109\t    a.x *= b;\n   110\t    a.y *= b;\n   111\t    a\n   112\t}\n   113\t\n   114\tfn c2_maxv(a: C2v, b: C2v) -> C2v {\n   115\t    c2_v(\n   116\t        if a.x > b.x { a.x } else { b.x },\n   117\t        if a.y > b.y { a.y } else { b.y },\n   118\t    )\n   119\t}\n   120\t\n   121\tfn c2_minv(a: C2v, b: C2v) -> C2v {\n   122\t    c2_v(\n   123\t        if a.x < b.x { a.x } else { b.x },\n   124\t        if a.y < b.y { a.y } else { b.y },\n   125\t    )\n   126\t}\n   127\t\n   128\tfn c2_clampv(a: C2v, lo: C2v, hi: C2v) -> C2v {\n   129\t    c2_maxv(lo, c2_minv(a, hi))\n   130\t}\n   131\t\n   132\tfn c2_sub(mut a: C2v, b: C2v) -> C2v {\n   133\t    a.x -= b.x;\n   134\t    a.y -= b.y;\n   135\t    a\n   136\t}\n   137\t\n   138\tfn c2_dot(a: C2v, b: C2v) -> f32 {\n   139\t    a.x * b.x + a.y * b.y\n   140\t}\n   141\t\n   142\tfn c2_rot_identity() -> C2r {\n   143\t    C2r { c: 1.0, s: 0.0 }\n   144\t}\n   145\t\n   146\tfn c2x_identity() -> C2x {\n   147\t    C2x {\n   148\t        p: c2_v(0.0, 0.0),\n   149\t        r: c2_rot_identity(),\n   150\t    }\n   151\t}\n   152\t\n   153\tfn c2_bb_verts(out: &mut [C2v; 8], bb: &C2Aabb) {\n   154\t    out[0] = bb.min;\n   155\t    out[1] = c2_v(bb.max.x, bb.min.y);\n   156\t    out[2] = bb.max;\n   157\t    out[3] = c2_v(bb.min.x, bb.max.y);\n   158\t}\n   159\t\n   160\tfn c2_make_proxy(shape: ShapeRef<'_>, type_: C2Type, p: &mut C2Proxy) {\n   161\t    match (type_, shape) {\n   162\t        (C2Type::Circle, ShapeRef::Circle(c)) => {\n   163\t            p.radius = c.r;\n   164\t            p.count = 1;\n   165\t            p.verts[0] = c.p;\n   166\t        }\n   167\t        (C2Type::Aabb, ShapeRef::Aabb(bb)) => {\n   168\t            p.radius = 0.0;\n   169\t            p.count = 4;\n   170\t            c2_bb_verts(&mut p.verts, bb);\n   171\t        }\n   172\t        (C2Type::Capsule, ShapeRef::Capsule(c)) => {\n   173\t            p.radius = c.r;\n   174\t            p.count = 2;\n   175\t            p.verts[0] = c.a;\n   176\t            p.verts[1] = c.b;\n   177\t        }\n   178\t        _ => {}\n   179\t    }\n   180\t}\n   181\t\n   182\tfn c2_len(a: C2v) -> f32 {\n   183\t    c2_dot(a, a).sqrt()\n   184\t}\n   185\t\n   186\tfn c2_det2(a: C2v, b: C2v) -> f32 {\n   187\t    a.x * b.y - a.y * b.x\n   188\t}\n   189\t\n   190\tfn c2_gjk_simplex_metric(s: &C2Simplex) -> f32 {\n   191\t    match s.count {\n   192\t        1 => 0.0,\n   193\t        2 => c2_len(c2_sub(s.b.p, s.a.p)),\n   194\t        3 => c2_det2(c2_sub(s.b.p, s.a.p), c2_sub(s.c.p, s.a.p)),\n   195\t        _ => 0.0,\n   196\t    }\n   197\t}\n   198\t\n   199\tfn c2_mulrv(a: C2r, b: C2v) -> C2v {\n   200\t    c2_v(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n   201\t}\n   202\t\n   203\tfn c2_add(mut a: C2v, b: C2v) -> C2v {\n   204\t    a.x += b.x;\n   205\t    a.y += b.y;\n   206\t    a\n   207\t}\n   208\t\n   209\tfn c2_mulxv(a: C2x, b: C2v) -> C2v {\n   210\t    c2_add(c2_mulrv(a.r, b), a.p)\n   211\t}\n   212\t\n   213\tfn c22(s: &mut C2Simplex) {\n   214\t    let a = s.a.p;\n   215\t    let b = s.b.p;\n   216\t    let u = c2_dot(b, c2_sub(b, a));\n   217\t    let v = c2_dot(a, c2_sub(a, b));\n   218\t    if v <= 0.0 {\n   219\t        s.a.u = 1.0;\n   220\t        s.div = 1.0;\n   221\t        s.count = 1;\n   222\t    } else if u <= 0.0 {\n   223\t        s.a = s.b;\n   224\t        s.