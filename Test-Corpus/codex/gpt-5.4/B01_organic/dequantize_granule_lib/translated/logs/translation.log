{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes, os, random, struct\n\nroot = '/tmp/harvest-translate-DkOnny/translated_rust'\norig = ctypes.CDLL('/tmp/harvest_compare_orig.so')\nrust = ctypes.CDLL(os.path.join(root, 'target/release/libtranslated_rust.so'))\n\nclass Bs(ctypes.Structure):\n    _fields_ = [('buf', ctypes.POINTER(ctypes.c_uint8)), ('pos', ctypes.c_int), ('limit', ctypes.c_int)]\n\nclass Sci(ctypes.Structure):\n    _fields_ = [\n        ('scf', ctypes.c_float * (3 * 64)),\n        ('total_bands', ctypes.c_uint8),\n        ('stereo_bands', ctypes.c_uint8),\n        ('bitalloc', ctypes.c_uint8 * 64),\n        ('scfcod', ctypes.c_uint8 * 64),\n    ]\n\nfor lib in (orig, rust):\n    lib.dequantize_granule.argtypes = [ctypes.POINTER(ctypes.c_float), ctypes.POINTER(Bs), ctypes.POINTER(Sci), ctypes.c_int]\n    lib.dequantize_granule.restype = ctypes.c_int\n\nrng = random.Random(0)\nfor case in range(2000):\n    sci = Sci()\n    for i in range(3 * 64):\n        sci.scf[i] = struct.unpack('f', rng.randbytes(4))[0]\n    sci.total_bands = rng.randrange(0, 33)\n    sci.stereo_bands = rng.randrange(0, 256)\n    for i in range(64):\n        sci.bitalloc[i] = rng.randrange(0, 21)\n        sci.scfcod[i] = rng.randrange(0, 256)\n\n    group_size = rng.randrange(-2, 20)\n    pos = rng.randrange(0, 256)\n    limit = rng.randrange(0, 512)\n    buf = (ctypes.c_uint8 * 128).from_buffer_copy(rng.randbytes(128))\n\n    raw = rng.randbytes(3000 * 4)\n    out1 = (ctypes.c_uint8 * len(raw)).from_buffer_copy(raw)\n    out2 = (ctypes.c_uint8 * len(raw)).from_buffer_copy(raw)\n    gr1 = ctypes.cast(out1, ctypes.POINTER(ctypes.c_float))\n    gr2 = ctypes.cast(out2, ctypes.POINTER(ctypes.c_float))\n\n    bs1 = Bs(buf, pos, limit)\n    bs2 = Bs(buf, pos, limit)\n    sci1 = Sci()\n    sci2 = Sci()\n    ctypes.memmove(ctypes.byref(sci1), ctypes.byref(sci), ctypes.sizeof(Sci))\n    ctypes.memmove(ctypes.byref(sci2), ctypes.byref(sci), ctypes.sizeof(Sci))\n\n    try:\n        r1 = orig.dequantize_granule(gr1, ctypes.byref(bs1), ctypes.byref(sci1), group_size)\n    except Exception as e:\n        print('orig fail', case, e)\n        raise\n    try:\n        r2 = rust.dequantize_granule(gr2, ctypes.byref(bs2), ctypes.byref(sci2), group_size)\n    except Exception as e:\n        print('rust fail', case, e)\n        raise\n\n    if r1 \"'!= r2 or bs1.pos != bs2.pos or bytes(out1) != bytes(out2):\n        print('\"'mismatch case', case)\n        print('group_size', group_size, 'pos', pos, 'limit', limit, 'total_bands', sci.total_bands)\n        print('returns', r1, r2, 'bs.pos', bs1.pos, bs2.pos)\n        for i, (a, b) in enumerate(zip(bytes(out1), bytes(out2))):\n            if a \"'!= b:\n                print('\"'first byte diff', i, a, b)\n                break\n        raise SystemExit(1)\n\nprint('ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
