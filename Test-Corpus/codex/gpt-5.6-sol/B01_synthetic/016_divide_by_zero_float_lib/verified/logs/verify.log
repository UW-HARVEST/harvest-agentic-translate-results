);\n    46\t    printIntLine(result);\n    47\t}\n    48\t\n    49\tstatic void goodG2B()\n    50\t{\n    51\t    float data;\n    52\t    data = 2.0F;\n    53\t    {\n    54\t        int result = (int)(100.0 / data);\n    55\t        printIntLine(result);\n    56\t    }\n    57\t}\n    58\t\n    59\tstatic void goodB2G(float data)\n    60\t{\n    61\t    if (fabs(data) > 0.000001)\n    62\t    {\n    63\t        int result = (int)(100.0 / data);\n    64\t        printIntLine(result);\n    65\t    }\n    66\t    else\n    67\t    {\n    68\t        printLine(\"This would result in a divide by zero\");\n    69\t    }\n    70\t}\n    71\t\n    72\tvoid good(float data)\n    73\t{\n    74\t    goodG2B();\n    75\t    goodB2G(data);\n    76\t}\n    77\t\n    78\tvoid driver(float goodData, float badData)\n    79\t{\n    80\t    printLine(\"Calling good()...\");\n    81\t    good(goodData);\n    82\t    printLine(\"Finished good()\");\n    83\t    printLine(\"Calling bad()...\");\n    84\t    bad(badData);\n    85\t    printLine(\"Finished bad()\");\n    86\t}\n","exit_code":0,"status":"completed"}}
