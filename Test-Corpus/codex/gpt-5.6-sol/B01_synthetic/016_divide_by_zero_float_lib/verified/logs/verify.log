{"type":"item.completed","item":{"id":"item_69","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^#'\"\\\\[test\\\\]|\"'^fn (valid|rejection)'\"' tests/differential.rs; nl -ba tests/differential.rs | sed -n '155,390p'\"","aggregated_output":"165:#[test]\n166:fn valid_configuration_surface_matches() {\n326:#[test]\n327:fn rejection_surface_matches() {\n   155\t    let rust_path = rust_library_path();\n   156\t    assert!(c_path.is_file(), \"missing C library: {}\", c_path.display());\n   157\t    assert!(\n   158\t        rust_path.is_file(),\n   159\t        \"missing Rust library: {}\",\n   160\t        rust_path.display()\n   161\t    );\n   162\t    unsafe { (Api::load(&c_path), Api::load(&rust_path)) }\n   163\t}\n   164\t\n   165\t#[test]\n   166\tfn valid_configuration_surface_matches() {\n   167\t    let (c_api, rust_api) = load_apis();\n   168\t\n   169\t    // CONFIGS.md row 1: all strings are passed through the dynamic symbol.\n   170\t    let mut strings = vec![\n   171\t        CString::new(\"\").unwrap(),\n   172\t        CString::new(\"ordinary text\").unwrap(),\n   173\t        CString::new(\"percent signs %s %d are data\").unwrap(),\n   174\t        CString::new(vec![b'x'; 4096]).unwrap(),\n   175\t    ];\n   176\t    let mut rng = XorShift64(0x4d59_5df4_d0f3_3173);\n   177\t    for _ in 0..128 {\n   178\t        let len = (rng.next_u32() % 96) as usize;\n   179\t        let bytes: Vec<u8> = (0..len)\n   180\t            .map(|_| b' ' + (rng.next_u32() % 95) as u8)\n   181\t            .collect();\n   182\t        strings.push(CString::new(bytes).unwrap());\n   183\t    }\n   184\t    let embedded_nul = b\"visible\\0ignored\\0\";\n   185\t    compare(&c_api, &rust_api, \"printLine valid strings\", |api| unsafe {\n   186\t        for string in &strings {\n   187\t            (api.print_line)(string.as_ptr());\n   188\t        }\n   189\t        (api.print_line)(embedded_nul.as_ptr().cast());\n   190\t    });\n   191\t\n   192\t    // CONFIGS.md row 2.\n   193\t    let mut integers = vec![0, 1, -1, c_int::MIN, c_int::MAX];\n   194\t    for _ in 0..512 {\n   195\t        integers.push(rng.next_u32() as c_int);\n   196\t    }\n   197\t    compare(\n   198\t        &c_api,\n   199\t        &rust_api,\n   200\t        \"printIntLine integer surface\",\n   201\t        |api| unsafe {\n   202\t            for &value in &integers {\n   203\t                (api.print_int_line)(value);\n   204\t            }\n   205\t        },\n   206\t    );\n   207\t\n   208\t    // CONFIGS.md row 3.\n   209\t    let mut regular_floats = vec![0.001, -0.001, 1.0, -1.0, 100.0, -100.0];\n   210\t    for _ in 0..512 {\n   211\t        regular_floats.push(rng.regular_float());\n   212\t    }\n   213\t    compare(&c_api, &rust_api, \"bad regular floats\", |api| unsafe {\n   214\t        for &value in &regular_floats {\n   215\t            (api.bad)(value);\n   216\t        }\n   217\t    });\n   218\t\n   219\t    // CONFIGS.md row 4.\n   220\t    let conversion_boundary = (100.0_f64 / 2_147_483_648.0) as f32;\n   221\t    let exceptional_bad = [\n   222\t        0.0,\n   223\t        -0.0,\n   224\t        f32::MIN_POSITIVE,\n   225\t        -f32::MIN_POSITIVE,\n   226\t        f32::from_bits(1),\n   227\t        f32::from_bits(0x8000_0001),\n   228\t        f32::INFINITY,\n   229\t        f32::NEG_INFINITY,\n   230\t        f32::NAN,\n   231\t        f32::from_bits(0xffc0_1234),\n   232\t        conversion_boundary,\n   233\t        f32::from_bits(conversion_boundary.to_bits() - 1),\n   234\t        f32::from_bits(conversion_boundary.to_bits() + 1),\n   235\t        -conversion_boundary,\n   236\t        f32::from_bits((-conversion_boundary).to_bits() - 1),\n   237\t        f32::from_bits((-conversion_boundary).to_bits() + 1),\n   238\t    ];\n   239\t    compare(&c_api, &rust_api, \"bad exceptional floats\", |api| unsafe {\n   240\t        for &value in &exceptional_bad {\n   241\t            (api.bad)(value);\n   242\t        }\n   243\t    });\n   244\t\n   245\t    // CONFIGS.md row 5.\n   246\t    let threshold = 0.000001_f32;\n   247\t    let above_threshold = f32::from_bits(threshold.to_bits() + 1);\n   248\t    let mut valid_good = vec![\n   249\t        above_threshold,\n   250\t        -above_threshold,\n   251\t        0.001,\n   252\t        -0.001,\n   253\t        1.0,\n   254\t        -1.0,\n   255\t        f32::MAX,\n   256\t        f32::MIN,\n   257\t    ];\n   258\t    for _ in 0..512 {\n   259\t        valid_good.push(rng.regular_float());\n   260\t    }\n   261\t    compare(\n   262\t        &c_api,\n   263\t        &rust_api,\n   264\t        \"good finite division branch\",\n   265\t        |api| unsafe {\n   266\t            for &value in &valid_good {\n   267\t                (api.good)(value);\n   268\t            }\n   269\t        },\n   270\t    );\n   271\t\n   272\t    // CONFIGS.md row 6.\n   273\t    compare(&c_api, &rust_api, \"good infinities\", |api| unsafe {\n   274\t        (api.good)(f32::INFINITY);\n   275\t        (api.good)(f32::NEG_INFINITY);\n   276\t    });\n   277\t\n   278\t    // CONFIGS.md row 7.\n   279\t    let regular_pairs: Vec<(f32, f32)> = (0..256)\n   280\t        .map(|_| (rng.regular_float(), rng.regular_float()))\n   281\t        .collect();\n   282\t    compare(\n   283\t        &c_api,\n   284\t        &rust_api,\n   285\t        \"driver regular cross-product\",\n   286\t        |api| unsafe {\n   287\t            for &(good_data, bad_data) in &regular_pairs {\n   288\t                (api.driver)(good_data, bad_data);\n   289\t            }\n   290\t        },\n   291\t    );\n   292\t\n   293\t    // CONFIGS.md row 8.\n   294\t    compare(\n   295\t        &c_api,\n   296\t        &rust_api,\n   297\t        \"driver exceptional badData cross-product\",\n   298\t        |api| unsafe {\n   299\t            for (index, &bad_data) in exceptional_bad.iter().enumerate() {\n   300\t                let good_data = if index & 1 == 