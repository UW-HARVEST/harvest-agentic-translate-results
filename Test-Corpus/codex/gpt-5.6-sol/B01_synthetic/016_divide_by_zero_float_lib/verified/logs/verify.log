{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/lib.rs'","aggregated_output":"     1\tuse std::ffi::{c_char, c_int};\n     2\t\n     3\tunsafe extern \"C\" {\n     4\t    fn printf(format: *const c_char, ...) -> c_int;\n     5\t    fn puts(string: *const c_char) -> c_int;\n     6\t}\n     7\t\n     8\tconst INTEGER_FORMAT: &[u8] = b\"%d\\n\\0\";\n     9\tconst CALLING_GOOD: &[u8] = b\"Calling good()...\\0\";\n    10\tconst FINISHED_GOOD: &[u8] = b\"Finished good()\\0\";\n    11\tconst CALLING_BAD: &[u8] = b\"Calling bad()...\\0\";\n    12\tconst FINISHED_BAD: &[u8] = b\"Finished bad()\\0\";\n    13\tconst DIVIDE_BY_ZERO: &[u8] = b\"This would result in a divide by zero\\0\";\n    14\t\n    15\tfn c_double_to_int(value: f64) -> c_int {\n    16\t    if !value.is_finite() || value >= (c_int::MAX as f64) + 1.0 || value < c_int::MIN as f64 {\n    17\t        c_int::MIN\n    18\t    } else {\n    19\t        value as c_int\n    20\t    }\n    21\t}\n    22\t\n    23\t#[unsafe(no_mangle)]\n    24\tpub extern \"C\" fn printLine(line: *const c_char) {\n    25\t    if !line.is_null() {\n    26\t        unsafe {\n    27\t            puts(line);\n    28\t        }\n    29\t    }\n    30\t}\n    31\t\n    32\t#[unsafe(no_mangle)]\n    33\tpub extern \"C\" fn printIntLine(int_number: c_int) {\n    34\t    unsafe {\n    35\t        printf(INTEGER_FORMAT.as_ptr().cast(), int_number);\n    36\t    }\n    37\t}\n    38\t\n    39\t#[unsafe(no_mangle)]\n    40\tpub extern \"C\" fn bad(data: f32) {\n    41\t    let result = c_double_to_int(100.0 / f64::from(data));\n    42\t    printIntLine(result);\n    43\t}\n    44\t\n    45\t#[unsafe(no_mangle)]\n    46\tpub extern \"C\" fn good(data: f32) {\n    47\t    printIntLine(50);\n    48\t\n    49\t    if f64::from(data).abs() > 0.000001 {\n    50\t        let result = c_double_to_int(100.0 / f64::from(data));\n    51\t        printIntLine(result);\n    52\t    } else {\n    53\