{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/main.rs'","aggregated_output":"     1\tuse std::io::{self, Read, Write};\n     2\t\n     3\tfn read_byte<R: Read>(input: &mut R) -> Option<u8> {\n     4\t    let mut byte = [0_u8; 1];\n     5\t    loop {\n     6\t        match input.read(&mut byte) {\n     7\t            Ok(0) => return None,\n     8\t            Ok(_) => return Some(byte[0]),\n     9\t            Err(error) if error.kind() == io::ErrorKind::Interrupted => {}\n    10\t            Err(_) => return None,\n    11\t        }\n    12\t    }\n    13\t}\n    14\t\n    15\tfn scan_decimal_int<R: Read>(input: &mut R) -> Option<i32> {\n    16\t    let first = loop {\n    17\t        let byte = read_byte(input)?;\n    18\t        if !matches!(byte, b' ' | b'\\t' | b'\\n' | b'\\r' | 0x0b | 0x0c) {\n    19\t            break byte;\n    20\t        }\n    21\t    };\n    22\t\n    23\t    let (negative, mut byte) = match first {\n    24\t        b'+' => (false, read_byte(input)?),\n    25\t        b'-' => (true, read_byte(input)?),\n    26\t        _ => (false, first),\n    27\t    };\n    28\t\n    29\t    if !byte.is_ascii_digit() {\n    30\t        return None;\n    31\t    }\n    32\t\n    33\t    let limit = if negative {\n    34\t        (i64::MAX as u64) + 1\n    35\t    } else {\n    36\t        i64::MAX as u64\n    37\t    };\n    38\t    let mut magnitude = 0_u64;\n    39\t\n    40\t    loop {\n    41\t        magnitude = magnitude\n    42\t            .saturating_mul(10)\n    43\t            .saturating_add(u64::from(byte - b'0'))\n    44\t            .min(limit);\n    45\t\n    46\t        match read_byte(input) {\n    47\t            Some(next) if next.is_ascii_digit() => byte = next,\n    48\t            _ => break,\n    49\t        }\n    50\t    }\n    51\t\n    52\t    let value = if negative {\n    53\t        if magnitude == (i64::MAX as u64) + 1 {\n    54\t            i64::MIN\n    55\t        } else {\n    56\t            -(magnitude as i64)\n    57\t        }\n    58\t    } else {\n    59\t        magnitude as i64\n    60\t    };\n    61\t\n    62\t    Some(value as i32)\n    63\t}\n    64\t\n    65\tfn driver<W: Write>(x: i32, output: &mut W) -> io::Result<()> {\n    66\t    let mut i = 0_i32;\n    67\t    let mut j = 0_i32;\n    68\t\n    69\t    while i < x {\n    70\t        writeln!(output, \"{i} {j}\")?;\n    71\t        i = i.wrapping_add(1);\n    72\t        j = j.wrapping_add(2);\n    73\t    }\n    74\t\n    75\t    Ok(())\n    76\t}\n    77\t\n    78\tfn main() {\n    79\t    let stdin = io::stdin();\n    80\t    let mut input = stdin.lock();\n    81\t    let x = scan_decimal_int(&mut input).unwrap_or(0);\n    82\t\n    83\t    let stdout = io::stdout();\n    84\t    let mut output = io::BufWriter::new(stdout.lock());\n    85\t    let _ = driver(x, &mut output);\n    86\t}\n","exit_code":0,"status":"completed"}}
