{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/main.rs; find . -maxdepth 3 -type f -print | sort'","aggregated_output":"     1\tuse std::io::{self, Read, Write};\n     2\t\n     3\tfn read_byte<R: Read>(reader: &mut R) -> Option<u8> {\n     4\t    let mut byte = [0_u8; 1];\n     5\t    loop {\n     6\t        match reader.read(&mut byte) {\n     7\t            Ok(0) => return None,\n     8\t            Ok(_) => return Some(byte[0]),\n     9\t            Err(error) if error.kind() == io::ErrorKind::Interrupted => {}\n    10\t            Err(_) => return None,\n    11\t        }\n    12\t    }\n    13\t}\n    14\t\n    15\tfn is_c_whitespace(byte: u8) -> bool {\n    16\t    matches!(byte, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n    17\t}\n    18\t\n    19\tfn scan_decimal_int<R: Read>(reader: &mut R) -> Option<i32> {\n    20\t    let mut byte = loop {\n    21\t        let byte = read_byte(reader)?;\n    22\t        if !is_c_whitespace(byte) {\n    23\t            break byte;\n    24\t        }\n    25\t    };\n    26\t\n    27\t    let negative = match byte {\n    28\t        b'-' => {\n    29\t            byte = read_byte(reader)?;\n    30\t            true\n    31\t        }\n    32\t        b'+' => {\n    33\t            byte = read_byte(reader)?;\n    34\t            false\n    35\t        }\n    36\t        _ => false,\n    37\t    };\n    38\t\n    39\t    if !byte.is_ascii_digit() {\n    40\t        return None;\n    41\t    }\n    42\t\n    43\t    // glibc scanf parses through a signed long, saturates it on range\n    44\t    // errors, and then stores the low int bits.\n    45\t    let limit = if negative {\n    46\t        (i64::MAX as u64) + 1\n    47\t    } else {\n    48\t        i64::MAX as u64\n    49\t    };\n    50\t    let mut magnitude = 0_u64;\n    51\t\n    52\t    loop {\n    53\t        let digit = u64::from(byte - b'0');\n    54\t        magnitude = magnitude\n    55\t            .checked_mul(10)\n    56\t            .and_then(|value| value.checked_add(digit))\n    57\t            .unwrap_or(limit)\n    58\t            .min(limit);\n    59\t\n    60\t        match read_byte(reader) {\n    61\t            Some(next) if next.is_ascii_digit() => byte = next,\n    62\t            _ => break,\n    63\t        }\n    64\t    }\n    65\t\n    66\t    let parsed = if negative {\n    67\t        if magnitude == (i64::MAX as u64) + 1 {\n    68\t            i64::MIN\n    69\t        } else {\n    70\t            -(magnitude as i64)\n    71\t        }\n    72\t    } else {\n    73\t        magnitude as i64\n    74\t    };\n    75\t\n    76\t    Some(parsed as i32)\n    77\t}\n    78\t\n    79\tfn print_line<W: Write>(writer: &mut W, line: Option<&str>) {\n    80\t    if let Some(line) = line {\n    81\t        let _ = writeln!(writer, \"{line}\");\n    82\t    }\n    83\t}\n    84\t\n    85\tfn print_hex_char_line<W: Write>(writer: &mut W, char_hex: i8) {\n    86\t    let promoted = (i32::from(char_hex)) as u32;\n    87\t    let _ = writeln!(writer, \"{promoted:02x}\");\n    88\t}\n    89\t\n    90\tfn bad<W: Write>(writer: &mut W) {\n    91\t    let data = i8::MAX;\n    92\t    if data > 0 {\n    93\t        let result = data.wrapping_mul(2);\n    94\t        print_hex_char_line(writer, result);\n    95\t    }\n    96\t}\n    97\t\n    98\tfn good_g2b<W: Write>(writer: &mut W) {\n    99\t    let data = 2_i8;\n   100\t    if data > 0 {\n   101\t        let result = data.wrapping_mul(2);\n   102\t        print_hex_char_line(writer, result);\n   103\t    }\n   104\t}\n   105\t\n   106\tfn good_b2g<W: Write>(writer: &mut W) {\n   107\t    let data = i8::MAX;\n   108\t    if data > 0 {\n   109\t        if data < (i8::MAX / 2) {\n   110\t            let result = data.wrapping_mul(2);\n   111\t            print_hex_char_line(writer, result);\n   112\t        } else {\n   113\t            print_line(\n   114\t                writer,\n   115\t                Some(\"data value is too large to perform arithmetic safely.\"),\n   116\t            );\n   117\t        }\n   118\t    }\n   119\t}\n   120\t\n   121\tfn good<W: Write>(writer: &mut W) {\n   122\t    good_g2b(writer);\n   123\t    good_b2g(writer);\n   124\t}\n   125\t\n   126\tfn main() {\n   127\t    let stdin = io::stdin();\n   128\t    let mut input = stdin.lock();\n   129\t    let x = scan_decimal_int(&mut input).unwrap_or(0);\n   130\t\n   131\t    let stdout = io::stdout();\n   132\t    let mut output = stdout.lock();\n   133\t    if x != 0 {\n   134\t        good(&mut output);\n   135\t    } else {\n   136\t        bad(&mut output);\n   137\t    }\n   138\t}\n   139\t\n   140\t#[cfg(test)]\n   141\tmod tests {\n   142\t    use super::scan_decimal_int;\n   143\t\n   144\t    #[test]\n   145\t    fn scans_like_decimal_scanf_for_observable_cases() {\n   146\t        assert_eq!(scan_decimal_int(&mut &b\"\\n\\t-42 rest\"[..]), Some(-42));\n   147\t        assert_eq!(scan_decimal_int(&mut &b\"+7\"[..]), Some(7));\n   148\t        assert_eq!(scan_decimal_int(&mut &b\"no number\"[..]), None);\n   149\t        assert_eq!(scan_decimal_int(&mut &b\"-\"[..]), None);\n   150\t    }\n   151\t\n   152\t    #[test]\n   153\t    fn narrows_the_saturated_signed_long_like_glibc() {\n   154\t        assert_eq!(scan_decimal_int(&mut &b\"4294967296\"[..]), Some(0));\n   155\t        assert_eq!(\n   156\t            scan_decimal_int(&mut &b\"999999999999999999999999\"[..]),\n   157\t            Some(-1)\n   158\t        );\n   159\t        assert_eq!(\n   160\t            scan_decimal_int(&mut &b\"-999999999999999999999999\"[..]),\n   161\t            Some(0)\n   162\t        );\n   163\t    }\n   164\t}\n./Cargo.lock\n./Cargo.toml\n./c_src/CMakeLists.txt\n./c_src/src/main.c\n./logs/prompt.md\n./logs/translation.log\n./src/main.rs\n./translation.json\n","exit_code":0,"status":"completed"}}
