{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' Cargo.toml; sed -n '1,240p' src/main.rs\"","aggregated_output":"[package]\nname = \"driver\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[[bin]]\nname = \"driver\"\npath = \"src/main.rs\"\nuse std::io::{self, Read, Write};\n\nfn scan_decimal_int(input: &[u8]) -> i32 {\n    let mut index = input\n        .iter()\n        .position(|byte| !byte.is_ascii_whitespace())\n        .unwrap_or(input.len());\n\n    let negative = match input.get(index) {\n        Some(b'+') => {\n            index += 1;\n            false\n        }\n        Some(b'-') => {\n            index += 1;\n            true\n        }\n        _ => false,\n    };\n\n    let digit_start = index;\n    let mut value = 0_u128;\n    while let Some(byte @ b'0'..=b'9') = input.get(index) {\n        value = value\n            .saturating_mul(10)\n            .saturating_add(u128::from(*byte - b'0'));\n        index += 1;\n    }\n\n    if index == digit_start {\n        return 0;\n    }\n\n    if negative {\n        (value as u32).wrapping_neg() as i32\n    } else {\n        value as u32 as i32\n    }\n}\n\nfn main() {\n    let mut input = Vec::new();\n    io::stdin().read_to_end(&mut input).unwrap();\n    let floors = scan_decimal_int(&input);\n\n    let mut output = String::with_capacity(33);\n    for byte in floors\n        .to_ne_bytes()\n        .into_iter()\n        .chain(3_i32.to_ne_bytes())\n        .chain(2_f64.to_ne_bytes())\n    {\n        use std::fmt::Write;\n        write!(output, \"{byte:02x}\").unwrap();\n    }\n    output.push('\\n');\n    io::stdout().write_all(output.as_bytes()).unwrap();\n}\n","exit_code":0,"status":"completed"}}
