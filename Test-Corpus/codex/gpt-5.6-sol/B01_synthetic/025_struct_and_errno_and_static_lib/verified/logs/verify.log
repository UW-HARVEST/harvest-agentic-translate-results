nsafe fn parse_val(value: *const c_char, parsed: *mut c_int) -> bool {\n    56\t    unsafe {\n    57\t        *__errno_location() = 0;\n    58\t    }\n    59\t    let mut end = value.cast_mut();\n    60\t    let temporary = unsafe { strtol(value, &mut end, 10) };\n    61\t\n    62\t    if end != value.cast_mut()\n    63\t        && unsafe { *__errno_location() } == 0\n    64\t        && temporary >= c_int::MIN as c_long\n    65\t        && temporary <= c_int::MAX as c_long\n    66\t    {\n    67\t        unsafe {\n    68\t            *parsed = temporary as c_int;\n    69\t        }\n    70\t        true\n    71\t    } else {\n    72\t        false\n    73\t    }\n    74\t}\n    75\t\n    76\t/// Parses the input and runs two update cycles when parsing succeeds.\n    77\t///\n    78\t/// # Safety\n    79\t///\n    80\t/// `input` must point to a readable NUL-terminated string. Calls that access\n    81\t/// the global house must be externally synchronized.\n    82\t#[unsafe(no_mangle)]\n    83\tpub unsafe extern \"C\" fn driver(input: *const c_char) {\n    84\t    let mut value = 0;\n    85\t    if unsafe { parse_val(input, &mut value) } {\n    86\t        unsafe {\n    87\t            run(value);\n    88\t            run(value);\n    89\t        }\n    90\t    } else {\n    91\t        unsafe {\n    92\t            printf(ERROR_MESSAGE.as_ptr().cast());\n    93\t        }\n    94\t    }\n    95\t}\n","exit_code":0,"status":"completed"}}
