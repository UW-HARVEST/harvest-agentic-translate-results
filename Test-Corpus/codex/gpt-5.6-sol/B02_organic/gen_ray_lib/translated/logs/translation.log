 C.Structure):\n        return C.string_at(C.byref(x), C.sizeof(x))\n    if isinstance(x, float):\n        return struct.pack('f', x)\n    return x\n\ndef call_equal(name, *args):\n    ca = getattr(clib, name)(*args)\n    ra = getattr(rlib, name)(*args)\n    if raw(ca) \"'!= raw(ra):\n        raise AssertionError(f'\"'{name}: C={raw(ca).hex() if isinstance(raw(ca), bytes) else ca} Rust={raw(ra).hex() if isinstance(raw(ra), bytes) else ra}')\n\ndef cast_equal(name, ray, shape):\n    co = Raycast(C.c_float.from_buffer_copy(bytes.fromhex('4523c17f')).value, V(17.25, -31.5))\n    ro = Raycast.from_buffer_copy(raw(co))\n    cr = getattr(clib, name)(ray, shape, C.byref(co))\n    rr = getattr(rlib, name)(ray, shape, C.byref(ro))\n    if cr \"'!= rr or raw(co) != raw(ro):\n        raise AssertionError(f'\"'{name}: ret {cr}/{rr}, out {raw(co).hex()}/{raw(ro).hex()}')\n\nrng = random.Random(0xC2A57)\ndef f32(x): return C.c_float(x).value\ndef rf(lo=-100.0, hi=100.0): return f32(rng.uniform(lo, hi))\ndef rv(): return V(rf(), rf())\n\n# Exercise scalar/vector ABI, arithmetic, signed zero, infinities, and quiet NaNs.\nedges = [0.0, -0.0, 1.0, -1.0, float('inf'), float('-inf'), C.c_float.from_buffer_copy(bytes.fromhex('0100c07f')).value]\nfor x in edges:\n    for y in edges:\n        for name, args in (\n            ('c2V', (x, y)), ('c2Dot', (V(x, y), V(y, x))),\n            ('c2Add', (V(x, y), V(y, x))), ('c2Sub', (V(x, y), V(y, x))),\n            ('c2Minv', (V(x, y), V(y, x))), ('c2Maxv', (V(x, y), V(y, x))),\n            ('c2Skew', (V(x, y),)), ('c2Absv', (V(x, y),)), ('c2CCW90', (V(x, y),)),\n        ):\n            call_equal(name, *args)\nfor _ in range(50000):\n    a, b, s = rv(), rv(), rf(-20, 20)\n    if abs(s) < 0.001: s = f32(0.125)\n    for name, args in (\n        ('c2V', (a.x, a.y)), ('c2Dot', (a, b)), ('c2Len', (a,)),\n        ('c2Add', (a, b)), ('c2Sub', (a, b)), ('c2Mulvs', (a, s)),\n        ('c2Div', (a, s)), ('c2Norm', (a,)), ('c2Minv', (a, b)),\n        ('c2Maxv', (a, b)), ('c2Skew', (a,)), ('c2Absv', (a,)),\n        ('c2CCW90', (a,)), ('c2MulmvT', (M(a, b), rv())),\n    ):\n        call_equal(name, *args)\n\nfor _ in range(30000):\n    p = rv()\n    dx, dy = rf(-1, 1), rf(-1, 1)\n    length = math.hypot(dx, dy)\n    if length < 1e-5: dx, dy, length = 1.0, 0.0, 1.0\n    ray = Ray(p, V(f32(dx/length), f32(dy/length)), rf(0, 250))\n    circle = Circle(rv(), rf(0.01, 50))\n    x0, x1, y0, y1 = rf(), rf(), rf(), rf()\n    box = AABB(V(min(x0,x1), min(y0,y1)), V(max(x0,x1), max(y0,y1)))\n    ca, cb = rv(), rv()\n    if ca.x == cb.x and ca.y == cb.y: cb.x = f32(cb.x + 1.0)\n    capsule = Capsule(ca, cb, rf(0.01, 30))\n    call_equal('c2AABBtoAABB', box, AABB(rv(), rv()))\n    call_equal('c2AABBtoPoint', box, rv())\n    call_equal('c2CircleToPoint', circle, rv())\n    cast_equal('c2RaytoCircle', ray, circle)\n    cast_equal('c2RaytoAABB', ray, box)\n    cast_equal('c2RaytoCapsule', ray, capsule)\n    for type_id, shape in ((0, circle), (1, box), (2, capsule)):\n        co = Raycast(123.5, V(-9.0, 11.0)); ro = Raycast.from_buffer_copy(raw(co))\n        cr = clib.c2CastRay(ray, C.byref(shape), type_id, C.byref(co))\n        rr = rlib.c2CastRay(ray, C.byref(shape), type_id, C.byref(ro))\n        if cr \"'!= rr or raw(co) != raw(ro):\n            raise AssertionError(f'\"'c2CastRay[{type_id}]: ret {cr}/{rr}, out {raw(co).hex()}/{raw(ro).hex()}')\n\nfor _ in range(30000):\n    values = [rf() for _ in range(16)]\n    values[6] = abs(values[6])\n    values[11] = abs(values[11])\n    # Make the AABB ordered while preserving the argument positions.\n    values[12], values[14] = min(values[12], values[14]), max(values[12], values[14])\n    values[13], values[15] = min(values[13], values[15]), max(values[13], values[15])\n    co = [Raycast(99.0, V(98.0, 97.0)) for _ in range(3)]\n    ro = [Raycast.from_buffer_copy(raw(v)) for v in co]\n    cr = clib.gen_ray(*(C.byref(v) for v in co), *values)\n    rr = rlib.gen_ray(*(C.byref(v) for v in ro), *values)\n    if cr \"'!= rr or [raw(v) for v in co] != [raw(v) for v in ro]:\n        raise AssertionError(f'\"'gen_ray: ret {cr}/{rr}, out {[raw(v).hex() for v in co]}/{[raw(v).hex() for v in ro]}')\n\nprint('PASS: all 22 symbols exercised; 50,000 vector cases, 30,000 shape/ray cases, 30,000 gen_ray cases')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
