{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/lib.rs'","aggregated_output":"     1\tuse std::ffi::{c_int, c_void};\n     2\t\n     3\t#[repr(C)]\n     4\t#[derive(Clone, Copy)]\n     5\tpub struct C2v {\n     6\t    pub x: f32,\n     7\t    pub y: f32,\n     8\t}\n     9\t\n    10\t#[repr(C)]\n    11\t#[derive(Clone, Copy)]\n    12\tpub struct C2Raycast {\n    13\t    pub t: f32,\n    14\t    pub n: C2v,\n    15\t}\n    16\t\n    17\t#[repr(C)]\n    18\t#[derive(Clone, Copy)]\n    19\tpub struct C2Circle {\n    20\t    pub p: C2v,\n    21\t    pub r: f32,\n    22\t}\n    23\t\n    24\t#[repr(C)]\n    25\t#[derive(Clone, Copy)]\n    26\tpub struct C2Aabb {\n    27\t    pub min: C2v,\n    28\t    pub max: C2v,\n    29\t}\n    30\t\n    31\t#[repr(C)]\n    32\t#[derive(Clone, Copy)]\n    33\tpub struct C2Capsule {\n    34\t    pub a: C2v,\n    35\t    pub b: C2v,\n    36\t    pub r: f32,\n    37\t}\n    38\t\n    39\t#[repr(C)]\n    40\t#[derive(Clone, Copy)]\n    41\tpub struct C2Ray {\n    42\t    pub p: C2v,\n    43\t    pub d: C2v,\n    44\t    pub t: f32,\n    45\t}\n    46\t\n    47\t#[repr(C)]\n    48\t#[derive(Clone, Copy)]\n    49\tpub struct C2m {\n    50\t    pub x: C2v,\n    51\t    pub y: C2v,\n    52\t}\n    53\t\n    54\tconst C2_TYPE_CIRCLE: c_int = 0;\n    55\tconst C2_TYPE_AABB: c_int = 1;\n    56\tconst C2_TYPE_CAPSULE: c_int = 2;\n    57\t\n    58\t#[inline]\n    59\tfn c_abs(value: f32) -> f32 {\n    60\t    if value < 0.0 { -value } else { value }\n    61\t}\n    62\t\n    63\t#[unsafe(no_mangle)]\n    64\tpub extern \"C\" fn c2V(x: f32, y: f32) -> C2v {\n    65\t    C2v { x, y }\n    66\t}\n    67\t\n    68\t#[unsafe(no_mangle)]\n    69\tpub extern \"C\" fn c2Dot(a: C2v, b: C2v) -> f32 {\n    70\t    a.x * b.x + a.y * b.y\n    71\t}\n    72\t\n    73\t#[unsafe(no_mangle)]\n    74\tpub extern \"C\" fn c2Len(a: C2v) -> f32 {\n    75\t    c2Dot(a, a).sqrt()\n    76\t}\n    77\t\n    78\t#[unsafe(no_mangle)]\n    79\tpub extern \"C\" fn c2Add(mut a: C2v, b: C2v) -> C2v {\n    80\t    a.x += b.x;\n    81\t    a.y += b.y;\n    82\t    a\n    83\t}\n    84\t\n    85\t#[unsafe(no_mangle)]\n    86\tpub extern \"C\" fn c2Sub(mut a: C2v, b: C2v) -> C2v {\n    87\t    a.x -= b.x;\n    88\t    a.y -= b.y;\n    89\t    a\n    90\t}\n    91\t\n    92\t#[unsafe(no_mangle)]\n    93\tpub extern \"C\" fn c2Mulvs(mut a: C2v, b: f32) -> C2v {\n    94\t    a.x *= b;\n    95\t    a.y *= b;\n    96\t    a\n    97\t}\n    98\t\n    99\t#[unsafe(no_mangle)]\n   100\tpub extern \"C\" fn c2Div(a: C2v, b: f32) -> C2v {\n   101\t    c2Mulvs(a, 1.0 / b)\n   102\t}\n   103\t\n   104\t#[unsafe(no_mangle)]\n   105\tpub extern \"C\" fn c2Norm(a: C2v) -> C2v {\n   106\t    c2Div(a, c2Len(a))\n   107\t}\n   108\t\n   109\t#[unsafe(no_mangle)]\n   110\tpub extern \"C\" fn c2Minv(a: C2v, b: C2v) -> C2v {\n   111\t    c2V(\n   112\t        if a.x < b.x { a.x } else { b.x },\n   113\t        if a.y < b.y { a.y } else { b.y },\n   114\t    )\n   115\t}\n   116\t\n   117\t#[unsafe(no_mangle)]\n   118\tpub extern \"C\" fn c2Maxv(a: C2v, b: C2v) -> C2v {\n   119\t    c2V(\n   120\t        if a.x > b.x { a.x } else { b.x },\n   121\t        if a.y > b.y { a.y } else { b.y },\n   122\t    )\n   123\t}\n   124\t\n   125\t#[unsafe(no_mangle)]\n   126\tpub extern \"C\" fn c2Skew(a: C2v) -> C2v {\n   127\t    C2v { x: -a.y, y: a.x }\n   128\t}\n   129\t\n   130\t#[unsafe(no_mangle)]\n   131\tpub extern \"C\" fn c2Absv(a: C2v) -> C2v {\n   132\t    c2V(c_abs(a.x), c_abs(a.y))\n   133\t}\n   134\t\n   135\t#[unsafe(no_mangle)]\n   136\tpub unsafe extern \"C\" fn c2RaytoCircle(a: C2Ray, b: C2Circle, out: *mut C2Raycast) -> c_int {\n   137\t    let p = b.p;\n   138\t    let m = c2Sub(a.p, p);\n   139\t    let c = c2Dot(m, m) - b.r * b.r;\n   140\t    let projection = c2Dot(m, a.d);\n   141\t    let disc = projection * projection - c;\n   142\t    if disc < 0.0 {\n   143\t        return 0;\n   144\