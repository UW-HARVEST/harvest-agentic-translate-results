fe(no_mangle)]\n   345\tpub unsafe extern \"C\" fn c2CastRay(\n   346\t    a: C2Ray,\n   347\t    b: *const c_void,\n   348\t    type_b: c_int,\n   349\t    out: *mut C2Raycast,\n   350\t) -> c_int {\n   351\t    match type_b {\n   352\t        C2_TYPE_CIRCLE => unsafe { c2RaytoCircle(a, b.cast::<C2Circle>().read(), out) },\n   353\t        C2_TYPE_AABB => unsafe { c2RaytoAABB(a, b.cast::<C2Aabb>().read(), out) },\n   354\t        C2_TYPE_CAPSULE => unsafe { c2RaytoCapsule(a, b.cast::<C2Capsule>().read(), out) },\n   355\t        _ => unsafe { std::hint::unreachable_unchecked() },\n   356\t    }\n   357\t}\n   358\t\n   359\t#[unsafe(no_mangle)]\n   360\tpub unsafe extern \"C\" fn gen_ray(\n   361\t    cast1: *mut C2Raycast,\n   362\t    cast2: *mut C2Raycast,\n   363\t    cast3: *mut C2Raycast,\n   364\t    mp_x: f32,\n   365\t    mp_y: f32,\n   366\t    r_p_x: f32,\n   367\t    r_p_y: f32,\n   368\t    c_p_x: f32,\n   369\t    c_p_y: f32,\n   370\t    c_r: f32,\n   371\t    cap_a_x: f32,\n   372\t    cap_a_y: f32,\n   373\t    cap_b_x: f32,\n   374\t    cap_b_y: f32,\n   375\t    cap_r: f32,\n   376\t    bb_min_x: f32,\n   377\t    bb_min_y: f32,\n   378\t    bb_max_x: f32,\n   379\t    bb_max_y: f32,\n   380\t) -> c_int {\n   381\t    let mut hit = 0;\n   382\t    let mp = c2V(mp_x, mp_y);\n   383\t    let ray_p = c2V(r_p_x, r_p_y);\n   384\t    let ray_d = c2Norm(c2Sub(mp, ray_p));\n   385\t    let ray = C2Ray {\n   386\t        p: ray_p,\n   387\t        d: ray_d,\n   388\t        t: c2Dot(mp, ray_d) - c2Dot(ray_p, ray_d),\n   389\t    };\n   390\t    let circle = C2Circle {\n   391\t        p: c2V(c_p_x, c_p_y),\n   392\t        r: c_r,\n   393\t    };\n   394\t    hit += unsafe {\n   395\t        c2CastRay(\n   396\t            ray,\n   397\t            (&circle as *const C2Circle).cast(),\n   398\t            C2_TYPE_CIRCLE,\n   399\t            cast1,\n   400\t        )\n   401\t    };\n   402\t    let capsule = C2Capsule {\n   403\t        a: c2V(cap_a_x, 