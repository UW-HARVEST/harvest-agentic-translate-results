{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba c_src/include/lib.h; printf '%s\\\\n' '--- C source ---'; nl -ba c_src/src/lib.c\"","aggregated_output":"     1\ttypedef struct c2v {\n     2\t        float x;\n     3\t        float y;\n     4\t} c2v;\n     5\t\n     6\ttypedef struct c2Raycast {\n     7\t        float t;\n     8\t        c2v n;\n     9\t} c2Raycast;\n    10\t\n    11\tint spec_ray(c2Raycast *cast, float mp_x, float mp_y, float c_p_x, float c_p_y, float c_r,\n    12\t                float r_p_x, float r_p_y);\n--- C source ---\n     1\t#include \"lib.h\"\r\n     2\t#include <math.h>\r\n     3\t\r\n     4\ttypedef enum {\r\n     5\t\tC2_TYPE_CIRCLE,\r\n     6\t\tC2_TYPE_AABB,\r\n     7\t\tC2_TYPE_CAPSULE,\r\n     8\t} C2_TYPE;\r\n     9\t\r\n    10\ttypedef struct c2Circle {\r\n    11\t\tc2v p;\r\n    12\t\tfloat r;\r\n    13\t} c2Circle;\r\n    14\t\r\n    15\ttypedef struct c2AABB {\r\n    16\t\tc2v min;\r\n    17\t\tc2v max;\r\n    18\t} c2AABB;\r\n    19\t\r\n    20\ttypedef struct c2Capsule {\r\n    21\t\tc2v a;\r\n    22\t\tc2v b;\r\n    23\t\tfloat r;\r\n    24\t} c2Capsule;\r\n    25\t\r\n    26\ttypedef struct c2Ray {\r\n    27\t\tc2v p;\r\n    28\t\tc2v d;\r\n    29\t\tfloat t;\r\n    30\t} c2Ray;\r\n    31\t\r\n    32\tc2v c2V(float x, float y) {\r\n    33\t\tc2v a;\r\n    34\t\ta.x = x;\r\n    35\t\ta.y = y;\r\n    36\t\treturn a;\r\n    37\t}\r\n    38\t\r\n    39\tfloat c2Dot(c2v a, c2v b) {\r\n    40\t\treturn a.x * b.x + a.y * b.y;\r\n    41\t}\r\n    42\t\r\n    43\tfloat c2Len(c2v a) {\r\n    44\t\treturn sqrtf(c2Dot(a, a));\r\n    45\t}\r\n    46\t\r\n    47\tc2v c2Add(c2v a, c2v b) {\r\n    48\t\ta.x += b.x;\r\n    49\t\ta.y += b.y;\r\n    50\t\treturn a;\r\n    51\t}\r\n    52\t\r\n    53\tc2v c2Sub(c2v a, c2v b) {\r\n    54\t\ta.x -= b.x;\r\n    55\t\ta.y -= b.y;\r\n    56\t\treturn a;\r\n    57\t}\r\n    58\t\r\n    59\tc2v c2Mulvs(c2v a, float b) {\r\n    60\t\ta.x *= b;\r\n    61\t\ta.y *= b;\r\n    62\t\treturn a;\r\n    63\t}\r\n    64\t\r\n    65\tc2v c2Div(c2v a, float b) {\r\n    66\t\treturn c2Mulvs(a, 1.0f / b);\r\n    67\t}\r\n    68\t\r\n    69\tc2v c2Norm(c2v a) {\r\n    70\t\treturn c2Div(a, c2Len(a));\r\n    71\t}\r\n    72\t\r\n    73\tc2v c2Minv(c2v a, c2v b) {\r\n    74\t\treturn c2V(((a.x) < (b.x) ? (a.x) : (b.x)),\r\n    75\t\t\t\t((a.y) < (b.y) ? (a.y) : (b.y)));\r\n    76\t}\r\n    77\t\r\n    78\tc2v c2Maxv(c2v a, c2v b) {\r\n    79\t\treturn c2V(((a.x) > (b.x) ? (a.x) : (b.x)),\r\n    80\t\t\t\t((a.y) > (b.y) ? (a.y) : (b.y)));\r\n    81\t}\r\n    82\t\r\n    83\tc2v c2Skew(c2v a) {\r\n    84\t\tc2v b;\r\n    85\t\tb.x = -a.y;\r\n    86\t\tb.y = a.x;\r\n    87\t\treturn b;\r\n    88\t}\r\n    89\t\r\n    90\tc2v c2Absv(c2v a) {\r\n    91\t\treturn c2V(((a.x) < 0 ? -(a.x) : (a.x)), ((a.y) < 0 ? -(a.y) : (a.y)));\r\n    92\t}\r\n    93\t\r\n    94\tint c2RaytoCircle(c2Ray A, c2Circle B, c2Raycast *out) {\r\n    95\t\tc2v p = B.p;\r\n    96\t\tc2v m = c2Sub(A.p, p);\r\n    97\t\tfloat c = c2Dot(m, m) - B.r * B.r;\r\n    98\t\tfloat b = c2Dot(m, A.d);\r\n    99\t\tfloat disc = b * b - c;\r\n   100\t\tif (disc < 0)\r\n   101\t\t\treturn 0;\r\n   102\t\tfloat t = -b - sqrtf(disc);\r\n   103\t\tif (t >= 0 && t <= A.t) {\r\n   104\t\t\tout->t = t;\r\n   105\t\t\tc2v impact = c2Add(A.p, c2Mulvs(A.d, t));\r\n   106\t\t\tout->n = c2Norm(c2Sub(impact, p));\r\n   107\t\t\treturn 1;\r\n   108\t\t}\r\n   109\t\treturn 0;\r\n   110\t}\r\n   111\t\r\n   112\tint c2AABBtoAABB(c2AABB A, c2AABB B) {\r\n   113\t\tint d0 = B.max.x < A.min.x;\r\n   114\t\tint d1 = A.max.x < B.min.x;\r\n   115\t\tint d2 = B.max.y < A.min.y;\r\n   116\t\tint d3 = A.max.y < B.min.y;\r\n   117\t\treturn !(d0 | d1 | d2 | d3);\r\n   118\t}\r\n   119\t\r\n   120\tstatic inline float c2SignedDistPointToPlane_OneDimensional(float p, float n,\r\n   121\t\t\tfloat d) {\r\n   122\t\treturn p * n - d * n;\r\n   123\t}\r\n   124\t\r\n   125\tstatic inline float c2RayToPlane_OneDimensional(float da, float db) {\r\n   126\t\tif (da < 0)\r\n   127\t\t\treturn 0;\r\n   128\t\telse if (da * db > 0)\r\n   129\t\t\treturn 1.0f;\r\n   130\t\telse {\r\n   131\t\t\tfloat d = da - db;\r\n   132\t\t\tif (d != 0)\r\n   133\t\t\t\treturn da / d;\r\n   134\t\t\telse\r\n   135\t\t\t\treturn 0;\r\n   136\t\t}\r\n   137\t}\r\n   138\t\r\n   139\tint c2RaytoAABB(c2Ray A, c2AABB B, c2Raycast *out) {\r\n   140\t\tc2v p0 = A.p;\r\n   141\t\tc2v p1 = c2Add(A.p, c2Mulvs(A.d, A.t));\r\n   142\t\tc2AABB a_box;\r\n   143\t\ta_box.min = c2Minv(p0, p1);\r\n   144\t\ta_box.max = c2Maxv(p0, p1);\r\n   145\t\tif (!c2AABBtoAABB(a_box, B))\r\n   146\t\t\treturn 0;\r\n   147\t\tc2v ab = c2Sub(p1, p0);\r\n   148\t\tc2v n = c2Skew(ab);\r\n   149\t\tc2v abs_n = c2Absv(n);\r\n   150\t\tc2v half_extents = c2Mulvs(c2Sub(B.max, B.min), 0.5f);\r\n   151\t\tc2v center_of_b_box = c2Mulvs(c2Add(B.min, B.max), 0.5f);\r\n   152\t\tfloat d = ((c2Dot(n, c2Sub(p0, center_of_b_box))) < 0\r\n   153\t\t\t\t? -(c2Dot(n, c2Sub(p0, center_of_b_box)))\r\n   154\t\t\t\t: (c2Dot(n, c2Sub(p0, center_of_b_box)))) -\r\n   155\t\t\tc2Dot(abs_n, half_extents);\r\n   156\t\tif (d > 0)\r\n   157\t\t\treturn 0;\r\n   158\t\tfloat da0 = c2SignedDistPointToPlane_OneDimensional(p0.x, -1.0f, B.min.x);\r\n   159\t\tfloat db0 = c2SignedDistPointToPlane_OneDimensional(p1.x, -1.0f, B.min.x);\r\n   160\t\tfloat da1 = c2SignedDistPointToPlane_OneDimensional(p0.x, 1.0f, B.max.x);\r\n   161\t\tfloat db1 = c2SignedDistPointToPlane_OneDimensional(p1.x, 1.0f, B.max.x);\r\n   162\t\tfloat da2 = c2SignedDistPointToPlane_OneDimensional(p0.y, -1.0f, B.min.y);\r\n   163\t\tfloat db2 = c2SignedDistPointToPlane_OneDimensional(p1.y, -1.0f, B.min.y);\r\n   164\t\tfloat da3 = c2SignedDistPointToPlane_OneDimensional(p0.y, 1.0f, B.max.y);\r\n   165\t\tfloat db3 = c2SignedDistPointToPlane_OneDimensional(p1.y, 1.0f, B.max.y);\r\n   166\t\tfloat t0 = c2RayToPlane_OneDimensional(da0, db0);\r\n   167\t\tfloat t1 = c2RayTo