b(impact, p));\n   195\t        }\n   196\t        return 1;\n   197\t    }\n   198\t    0\n   199\t}\n   200\t\n   201\t#[unsafe(no_mangle)]\n   202\tpub extern \"C\" fn c2AABBtoAABB(a: C2Aabb, b: C2Aabb) -> c_int {\n   203\t    let d0 = b.max.x < a.min.x;\n   204\t    let d1 = a.max.x < b.min.x;\n   205\t    let d2 = b.max.y < a.min.y;\n   206\t    let d3 = a.max.y < b.min.y;\n   207\t    (!(d0 | d1 | d2 | d3)) as c_int\n   208\t}\n   209\t\n   210\t#[inline]\n   211\tfn c2_signed_dist_point_to_plane_one_dimensional(p: c_float, n: c_float, d: c_float) -> c_float {\n   212\t    p * n - d * n\n   213\t}\n   214\t\n   215\t#[inline]\n   216\tfn c2_ray_to_plane_one_dimensional(da: c_float, db: c_float) -> c_float {\n   217\t    if da < 0.0 {\n   218\t        0.0\n   219\t    } else if da * db > 0.0 {\n   220\t        1.0\n   221\t    } else {\n   222\t        let d = da - db;\n   223\t        if d != 0.0 {\n   224\t            da / d\n   225\t        } else {\n   226\t            0.0\n   227\t        }\n   228\t    }\n   229\t}\n   230\t\n   231\t#[unsafe(no_mangle)]\n   232\tpub unsafe extern \"C\" fn c2RaytoAABB(a: C2Ray, b: C2Aabb, out: *mut C2Raycast) -> c_int {\n   233\t    let p0 = a.p;\n   234\t    let p1 = c2Add(a.p, c2Mulvs(a.d, a.t));\n   235\t    let a_box = C2Aabb {\n   236\t        min: c2Minv(p0, p1),\n   237\t        max: c2Maxv(p0, p1),\n   238\t    };\n   239\t    if c2AABBtoAABB(a_box, b) == 0 {\n   240\t        return 0;\n   241\t    }\n   242\t    let ab = c2Sub(p1, p0);\n   243\t    let n = c2Skew(ab);\n   244\t    let abs_n = c2Absv(n);\n   245\t    let half_extents = c2Mulvs(c2Sub(b.max, b.min), 0.5);\n   246\t    let center_of_b_box = c2Mulvs(c2Add(b.min, b.max), 0.5);\n   247\t    let center_distance = c2Dot(n, c2Sub(p0, center_of_b_box));\n   248\t    let d = c_abs(center_distance) - c2Dot(abs_n, half_extents);\n   249\t    if d > 0.0 {\n   250\t        return 0;\n   251\t    }\n   252\t    let da0 = c2_signed_dist_point_to_plane_one_dimensional(p0.x, -1.0, b.min.x);\n   253\t    let db0 = c2_signed_dist_point_to_plane_one_dimensional(p1.x, -1.0, b.min.x);\n   254\t    let da1 = c2_signed_dist_point_to_plane_one_dimensional(p0.x, 1.0, b.max.x);\n   255\t    let db1 = c2_signed_dist_point_to_plane_one_dimensional(p1.x, 1.0, b.max.x);\n   256\t    let da2 = c2_signed_dist_point_to_plane_one_dimensional(p0.y, -1.0, b.min.y);\n   257\t    let db2 = c2_signed_dist_point_to_plane_one_dimensional(p1.y, -1.0, b.min.y);\n   258\t    let da3 = c2_signed_dist_point_to_plane_one_dimensional(p0.y, 1.0, b.max.y);\n   259\t    let db3 = c2_signed_dist_point_to_plane_one_dimensional(p1.y, 1.0, b.max.y);\n   260\t    let mut t0 = c2_ray_to_plane_one_dimensional(da0, db0);\n   261\t    let mut t1 = c2_ray_to_plane_one_dimensional(da1, db1);\n   262\t    let mut t2 = c2_ray_to_plane_one_dimensional(da2, db2);\n   263\t    let mut t3 = c2_ray_to_plane_one_dimensional(da3, db3);\n   264\t    let hit0 = t0 <= 1.0;\n   265\t    let hit1 = t1 <= 1.0;\n   266\t    let hit2 = t2 <= 1.0;\n   267\t    let hit3 = t3 <= 1.0;\n   268\t    let hit = hit0 | hit1 | hit2 | hit3;\n   269\t    if hit {\n   270\t        t0 = (hit0 as c_int) as c_float * t0;\n   271\t        t1 = (hit1 as c_int) as c_float * t1;\n   272\t        t2 = (hit2 as c_int) as c_float * t2;\n   273\t        t3 = (hit3 as c_int) as c_float * t3;\n   274\t        unsafe {\n   275\t            if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n   276\t                (*out).t = t0 * a.t;\n   277\t                (*out).n = c2V(-1.0, 0.0);\n   278\t            } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n   279\t                (*out).t = t1 * a.t;\n   280\t                (*out).n = c2V(1.0, 0.0);\n   281\t            } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n   282\t                (*out).t = t2 * a.t;\n   283\t                (*out).n = c2V(0.0, -1.0);\n   284\t            } else {\n   285\t                (*out).t = t3 * a.t;\n   286\t                (*out).n = c2V(0.0, 1.0);\n   287\t            }\n   288\t        }\n   289\t        1\n   290\t    } else {\n   291\t        0\n   292\t    }\n   293\t}\n   294\t\n   295\t#[unsafe(no_mangle)]\n   296\tpub extern \"C\" fn c2CCW90(a: C2v) -> C2v {\n   297\t    C2v { x: a.y, y: -a.x }\n   298\t}\n   299\t\n   300\t#[unsafe(no_mangle)]\n   301\tpub extern \"C\" fn c2MulmvT(a: C2m, b: C2v) -> C2v {\n   302\t    C2v {\n   303\t        x: c_add(c_mul(a.x.x, b.x), c_mul(a.x.y, b.y)),\n   304\t        y: c_add(c_mul(a.y.x, b.x), c_mul(a.y.y, b.y)),\n   305\t    }\n   306\t}\n   307\t\n   308\t#[unsafe(no_mangle)]\n   309\tpub extern \"C\" fn c2AABBtoPoint(a: C2Aabb, b: C2v) -> c_int {\n   310\t    let d0 = b.x < a.min.x;\n   311\t    let d1 = b.y < a.min.y;\n   312\t    let d2 = b.x > a.max.x;\n   313\t    let d3 = b.y > a.max.y;\n   314\t    (!(d0 | d1 | d2 | d3)) as c_int\n   315\t}\n   316\t\n   317\t#[unsafe(no_mangle)]\n   318\tpub extern \"C\" fn c2CircleToPoint(a: C2Circle, b: C2v) -> c_int {\n   319\t    let n = c2Sub(a.p, b);\n   320\t    let d2 = c2Dot(n, n);\n   321\t    (d2 < a.r * a.r) as c_int\n   322\t}\n   323\t\n   324\t#[unsafe(no_mangle)]\n   325\tpub unsafe extern \"C\" fn c2RaytoCapsule(a: C2Ray, b: C2Capsule, out: *mut C2Raycast) -> c_int {\n   326\t    let mut m = C2m {\n   327\t        x: c2V(0.0, 0.0),\n   328\t        y: c2Norm(c2Sub(b.b, b.a)),\n   329\t    };\n   330\t    m.x = c2CCW90(m.y);\n   331\t    let cap_n = c2Sub(b.b, b.a);\n   332\t    let y_bb = c2MulmvT(m, cap_n);\n   333\t    let y_ap = c2MulmvT(m, c2Sub(a.p, b.a));\n   334\t    let y_ad = c2MulmvT(m, a.d);\n   335\t    let y_ae = c2Add(y_ap, c2Mulvs(y_ad, a.t));\n   336\t    let capsule_bb = C2Aabb {\n   337\t        min: c2V(-b.r, 0.0),\n   338\t        max: c2V(b.r, y_bb.y),\n   339\t    };\n   340\t    unsafe {\n   341\t        (*out).n = c2Norm(cap_n);\n   342\t        (*out).t = 0.0;\n   343\t    }\n   344\t    if c2AABBtoPoint(capsule_bb, y_ap) != 0 {\n   345\t        return 1;\n   346\t    }\n   347\t\n   348\t    let capsule_a = C2Circle { p: b.a, r: b.r };\n   349\t    let capsule_b = C2Circle { p: b.b, r: b.r };\n   350\t    if c2CircleToPoint(capsule_a, a.p) != 0 {\n   351\t        return 1;\n   352\t    } else if c2CircleToPoint(capsule_b, a.p) != 0 {\n   353\t        return 1;\n   354\t    }\n   355\t\n   356\t    let closest_x = if c_abs(y_ae.x) < c_abs(y_ap.x) {\n   357\t        c_abs(y_ae.x)\n   358\t    } else {\n   359\t        c_abs(y_ap.x)\n   360\t    };\n   361\t    if y_ae.x * y_ap.x < 0.0 || closest_x < b.r {\n   362\t        if c_abs(y_ap.x) < b.r {\n   363\t            if y_ap.y < 0.0 {\n   364\t                return unsafe { c2RaytoCircle(a, capsule_a, out) };\n   365\t            } else {\n   366\t                return unsafe { c2RaytoCircle(a, capsule_b, out) };\n   367\t            }\n   368\t        } else {\n   369\t            let c = if y_ap.x > 0.0 { b.r } else { -b.r };\n   370\t            let d = y_ae.x - y_ap.x;\n   371\t            let t = (c - y_ap.x) / d;\n   372\t            let y = y_ap.y + (y_ae.y - y_ap.y) * t;\n   373\t            if y <= 0.0 {\n   374\t                return unsafe { c2RaytoCircle(a, capsule_a, out) };\n   375\t            }\n   376\t            if y >= y_bb.y {\n   377\t                return unsafe { c2RaytoCircle(a, capsule_b, out) };\n   378\t            } else {\n   379\t                unsafe {\n   380\t                    (*out).n = if c > 0.0 { m.x } else { c2Skew(m.y) };\n   381\t                    (*out).t = t * a.t;\n   382\t                }\n   383\t                return 1;\n   384\t            }\n   385\t        }\n   386\t    }\n   387\t    0\n   388\t}\n   389\t\n   390\t#[unsafe(no_mangle)]\n   391\tpub unsafe extern \"C\" fn c2CastRay(\n   392\t    a: C2Ray,\n   393\t    b: *const c_void,\n   394\t    type_b: c_int,\n   395\t    out: *mut C2Raycast,\n   396\t) -> c_int {\n   397\t    match type_b {\n   398\t        C2_TYPE_CIRCLE => unsafe { c2RaytoCircle(a, b.cast::<C2Circle>()