 A.r * A.r;\r\n   229\t}\r\n   230\t\r\n   231\tint c2RaytoCapsule(c2Ray A, c2Capsule B, c2Raycast *out) {\r\n   232\t\tc2m M;\r\n   233\t\tM.y = c2Norm(c2Sub(B.b, B.a));\r\n   234\t\tM.x = c2CCW90(M.y);\r\n   235\t\tc2v cap_n = c2Sub(B.b, B.a);\r\n   236\t\tc2v yBb = c2MulmvT(M, cap_n);\r\n   237\t\tc2v yAp = c2MulmvT(M, c2Sub(A.p, B.a));\r\n   238\t\tc2v yAd = c2MulmvT(M, A.d);\r\n   239\t\tc2v yAe = c2Add(yAp, c2Mulvs(yAd, A.t));\r\n   240\t\tc2AABB capsule_bb;\r\n   241\t\tcapsule_bb.min = c2V(-B.r, 0);\r\n   242\t\tcapsule_bb.max = c2V(B.r, yBb.y);\r\n   243\t\tout->n = c2Norm(cap_n);\r\n   244\t\tout->t = 0;\r\n   245\t\tif (c2AABBtoPoint(capsule_bb, yAp)) {\r\n   246\t\t\treturn 1;\r\n   247\t\t} else {\r\n   248\t\t\tc2Circle capsule_a;\r\n   249\t\t\tc2Circle capsule_b;\r\n   250\t\t\tcapsule_a.p = B.a;\r\n   251\t\t\tcapsule_a.r = B.r;\r\n   252\t\t\tcapsule_b.p = B.b;\r\n   253\t\t\tcapsule_b.r = B.r;\r\n   254\t\t\tif (c2CircleToPoint(capsule_a, A.p)) {\r\n   255\t\t\t\treturn 1;\r\n   256\t\t\t} else if (c2CircleToPoint(capsule_b, A.p)) {\r\n   257\t\t\t\treturn 1;\r\n   258\t\t\t}\r\n   259\t\t}\r\n   260\t\tif (yAe.x * yAp.x < 0 ||\r\n   261\t\t\t\t((((yAe.x) < 0 ? -(yAe.x) : (yAe.x))) <\r\n   262\t\t\t\t (((yAp.x) < 0 ? -(yAp.x) : (yAp.x)))\r\n   263\t\t\t\t ? (((yAe.x) < 0 ? -(yAe.x) : (yAe.x)))\r\n   264\t\t\t\t : (((yAp.x) < 0 ? -(yAp.x) : (yAp.x)))) < B.r) {\r\n   265\t\t\tc2Circle Ca, Cb;\r\n   266\t\t\tCa.p = B.a;\r\n   267\t\t\tCa.r = B.r;\r\n   268\t\t\tCb.p = B.b;\r\n   269\t\t\tCb.r = B.r;\r\n   270\t\t\tif (((yAp.x) < 0 ? -(yAp.x) : (yAp.x)) < B.r) {\r\n   271\t\t\t\tif (yAp.y < 0)\r\n   272\t\t\t\t\treturn c2RaytoCircle(A, Ca, out);\r\n   273\t\t\t\telse\r\n   274\t\t\t\t\treturn c2RaytoCircle(A, Cb, out);\r\n   275\t\t\t} else {\r\n   276\t\t\t\tfloat c = yAp.x > 0 ? B.r : -B.r;\r\n   277\t\t\t\tfloat d = (yAe.x - yAp.x);\r\n   278\t\t\t\tfloat t = (c - yAp.x) / d;\r\n   279\t\t\t\tfloat y = yAp.y + (yAe.y - yAp.y) * t;\r\n   280\t\t\t\t