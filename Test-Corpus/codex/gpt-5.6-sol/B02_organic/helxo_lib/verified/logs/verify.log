\t}\n   595\t\n   596\t#[unsafe(no_mangle)]\n   597\tpub unsafe extern \"C\" fn stbds_hmput_key(\n   598\t    mut hash_array: *mut c_void,\n   599\t    elem_size: usize,\n   600\t    key: *mut c_void,\n   601\t    key_size: usize,\n   602\t    mode: c_int,\n   603\t) -> *mut c_void {\n   604\t    if hash_array.is_null() {\n   605\t        let raw_array = unsafe { stbds_arrgrowf(ptr::null_mut(), elem_size, 0, 1) };\n   606\t        unsafe {\n   607\t            memset(raw_array, 0, elem_size);\n   608\t            (*header(raw_array)).length += 1;\n   609\t            hash_array = array_to_hash(raw_array, elem_size);\n   610\t        }\n   611\t    }\n   612\t\n   613\t    let mut raw_hash_array = hash_array;\n   614\t    let mut raw_array = unsafe { hash_to_array(hash_array, elem_size) };\n   615\t    let mut table = unsafe { hash_table(raw_array) };\n   616\t\n   617\t    unsafe {\n   618\t        if table.is_null() || (*table).used_count >= (*table).used_count_threshold {\n   619\t            let slot_count = if table.is_null() {\n   620\t                BUCKET_LENGTH\n   621\t            } else {\n   622\t                (*table).slot_count.wrapping_mul(2)\n   623\t            };\n   624\t            let new_table = make_hash_index(slot_count, table);\n   625\t            if !table.is_null() {\n   626\t                free(table.cast());\n   627\t            } else {\n   628\t                (*new_table).string.mode = if mode >= HM_STRING { SH_DEFAULT } else { 0 };\n   629\t            }\n   630\t            (*header(raw_array)).hash_table = new_table.cast();\n   631\t            table = new_table;\n   632\t        }\n   633\t\n   634\t        let mut hash = if mode >= HM_STRING {\n   635\t            stbds_hash_string(key.cast(), (*table).seed)\n   636\t        } else {\n   637\t            stbds_hash_bytes(key, key_size, (*table).seed)\n   638\t        };\n   639\t        if hash < 2 {\n   640\t            hash += 2;\n   641\t        }\n   642\t\n   643\t      