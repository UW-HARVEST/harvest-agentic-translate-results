ub unsafe extern \"C\" fn stbds_arrfreef(data: *mut c_void) {\n   298\t    unsafe { free(header(data).cast()) };\n   299\t}\n   300\t\n   301\t#[unsafe(no_mangle)]\n   302\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n   303\t    unsafe { HASH_SEED = seed };\n   304\t}\n   305\t\n   306\t#[unsafe(no_mangle)]\n   307\tpub unsafe extern \"C\" fn stbds_hash_string(mut string: *mut c_char, seed: usize) -> usize {\n   308\t    let mut hash = seed;\n   309\t    unsafe {\n   310\t        while *string != 0 {\n   311\t            hash = hash\n   312\t                .rotate_left(9)\n   313\t                .wrapping_add(*string.cast::<u8>() as usize);\n   314\t            string = string.add(1);\n   315\t        }\n   316\t    }\n   317\t\n   318\t    hash ^= seed;\n   319\t    hash = (!hash).wrapping_add(hash.wrapping_shl(18));\n   320\t    hash ^= hash ^ hash.rotate_right(31);\n   321\t    hash = hash.wrapping_mul(21);\n   322\t    hash ^= hash ^ hash.rotate_right(11);\n   323\t    hash = hash.wrapping_add(hash.wrapping_shl(6));\n   324\t    hash ^= hash.rotate_right(22);\n   325\t    hash.wrapping_add(seed)\n   326\t}\n   327\t\n   328\t#[inline]\n   329\tfn sip_round(v0: &mut usize, v1: &mut usize, v2: &mut usize, v3: &mut usize) {\n   330\t    *v0 = v0.wrapping_add(*v1);\n   331\t    *v1 = v1.rotate_left(13);\n   332\t    *v1 ^= *v0;\n   333\t    *v0 = v0.rotate_left(usize::BITS / 2);\n   334\t    *v2 = v2.wrapping_add(*v3);\n   335\t    *v3 = v3.rotate_left(16);\n   336\t    *v3 ^= *v2;\n   337\t    *v2 = v2.wrapping_add(*v1);\n   338\t    *v1 = v1.rotate_left(17);\n   339\t    *v1 ^= *v2;\n   340\t    *v2 = v2.rotate_left(usize::BITS / 2);\n   341\t    *v0 = v0.wrapping_add(*v3);\n   342\t    *v3 = v3.rotate_left(21);\n   343\t    *v3 ^= *v0;\n   344\t}\n   345\t\n   346\tunsafe fn siphash_bytes(data_ptr: *mut c_void, len: usize, seed: usize) -> usize {\n   347\t    let mut data_ptr = data_ptr.cast::<u8>();\n   348\t    let mut v0 = 0x736f_6d65_7073_657