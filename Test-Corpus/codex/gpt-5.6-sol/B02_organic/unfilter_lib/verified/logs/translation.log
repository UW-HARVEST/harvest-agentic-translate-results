{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\nimport zlib\nfrom pathlib import Path\n\nroot = Path.cwd()\nc = ctypes.CDLL(str(root / 'baseline/libc_reference.so'), mode=ctypes.RTLD_LOCAL)\nr = ctypes.CDLL(str(root / 'target/release/libtranslated_rust.so'), mode=ctypes.RTLD_LOCAL)\nfor lib in (c, r):\n    lib.unfilter.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.c_uint8)]\n    lib.unfilter.restype = ctypes.c_int\n    lib.cp_inflate.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p, ctypes.c_int]\n    lib.cp_inflate.restype = ctypes.c_int\n\ndef reason(lib):\n    address = ctypes.c_void_p.in_dll(lib, 'cp_error_reason').value\n    return None if address is None else ctypes.string_at(address)\n\n# Compare every byte of every exported initialized data object.\ntables = [\n    ('cp_fixed_table', ctypes.c_uint8, 320),\n    ('cp_permutation_order', ctypes.c_uint8, 19),\n    ('cp_len_extra_bits', ctypes.c_uint8, 31),\n    ('cp_len_base', ctypes.c_uint32, 31),\n    ('cp_dist_extra_bits', ctypes.c_uint8, 32),\n    ('cp_dist_base', ctypes.c_uint32, 32),\n]\nfor name, typ, count in tables:\n    assert bytes((typ * count).in_dll(c, name)) == bytes((typ * count).in_dll(r, name)), name\n\nrng = random.Random(0xC0DEC0DE)\nunfilter_cases = 0\nfor w in range(1, 17):\n    for h in range(0, 9):\n        for bpp in range(1, 9):\n            for _ in range(4):\n                source = bytearray()\n                for _row in range(h):\n                    source.append(rng.randrange(5))\n                    source.extend(rng.randbytes(w * bpp))\n                if not source:\n                    source.append(0)\n                cb = (ctypes.c_uint8 * len(source)).from_buffer_copy(source)\n                rb = (ctypes.c_uint8 * len(source)).from_buffer_copy(source)\n                assert c.unfilter(w, h, bpp, cb) == r.unfilter(w, h, bpp, rb)\n    