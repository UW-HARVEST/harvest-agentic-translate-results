        STBDS_STATS(++stbds_rehash_probes);\n   442\t\n   443\t            for (z=pos & STBDS_BUCKET_MASK; z < STBDS_BUCKET_LENGTH; ++z) {\n   444\t              if (bucket->hash[z] == 0) {\n   445\t                bucket->hash[z] = hash;\n   446\t                bucket->index[z] = ob->index[j];\n   447\t                goto done;\n   448\t              }\n   449\t            }\n   450\t\n   451\t            limit = pos & STBDS_BUCKET_MASK;\n   452\t            for (z = 0; z < limit; ++z) {\n   453\t              if (bucket->hash[z] == 0) {\n   454\t                bucket->hash[z] = hash;\n   455\t                bucket->index[z] = ob->index[j];\n   456\t                goto done;\n   457\t              }\n   458\t            }\n   459\t\n   460\t            pos += step;\n   461\t            step += STBDS_BUCKET_LENGTH;\n   462\t            pos &= (t->slot_count-1);\n   463\t          }\n   464\t        }\n   465\t       done:\n   466\t        ;\n   467\t      }\n   468\t    }\n   469\t  }\n   470\t\n   471\t  return t;\n   472\t}\n   473\t\n   474\t#define STBDS_ROTATE_LEFT(val, n)   (((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n))))\n   475\t#define STBDS_ROTATE_RIGHT(val, n)  (((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n))))\n   476\t\n   477\tsize_t stbds_hash_string(char *str, size_t seed)\n   478\t{\n   479\t  size_t hash = seed;\n   480\t  while (*str)\n   481\t     hash = STBDS_ROTATE_LEFT(hash, 9) + (unsigned char) *str++;\n   482\t\n   483\t  hash ^= seed;\n   484\t  hash = (~hash) + (hash << 18);\n   485\t  hash ^= hash ^ STBDS_ROTATE_RIGHT(hash,31);\n   486\t  hash = hash * 21;\n   487\t  hash ^= hash ^ STBDS_ROTATE_RIGHT(hash,11);\n   488\t  hash += (hash << 6);\n   489\t  hash ^= STBDS_ROTATE_RIGHT(hash,22);\n   490\t  return hash+seed;\n   491\t}\n   492\t\n   493\t#define STBDS_SIPHASH_C_ROUNDS 2\n   494\t#define STBDS_SIPHASH_D_ROUNDS 4\n   495\ttypedef int STBDS_SIPHASH_2_4_can_only_be_used_in_64_bit_builds[sizeof(size_t) == 8 ? 1 : -1];\n   496\t\n   497\t\n   498\tstatic size_t stbds_siphash_bytes(void *p, size_t len, size_t seed)\n   499\t{\n   500\t  unsigned char *d = (unsigned char *) p;\n   501\t  size_t i,j;\n   502\t  size_t v0,v1,v2,v3, data;\n   503\t\n   504\t  v0 = ((((size_t) 0x736f6d65 << 16) << 16) + 0x70736575) ^  seed;\n   505\t  v1 = ((((size_t) 0x646f7261 << 16) << 16) + 0x6e646f6d) ^ ~seed;\n   506\t  v2 = ((((size_t) 0x6c796765 << 16) << 16) + 0x6e657261) ^  seed;\n   507\t  v3 = ((((size_t) 0x74656462 << 16) << 16) + 0x79746573) ^ ~seed;\n   508\t\n   509\t  v0 ^= 0x0706050403020100ull ^  seed;\n   510\t  v1 ^= 0x0f0e0d0c0b0a0908ull ^ ~seed;\n   511\t  v2 ^= 0x0706050403020100ull ^  seed;\n   512\t  v3 ^= 0x0f0e0d0c0b0a0908ull ^ ~seed;\n   513\t\n   514\t  #define STBDS_SIPROUND() \\\n   515\t    do {                   \\\n   516\t      v0 += v1; v1 = STBDS_ROTATE_LEFT(v1, 13);  v1 ^= v0; v0 = STBDS_ROTATE_LEFT(v0,STBDS_SIZE_T_BITS/2); \\\n   517\t      v2 += v3; v3 = STBDS_ROTATE_LEFT(v3, 16);  v3 ^= v2;                                                 \\\n   518\t      v2 += v1; v1 = STBDS_ROTATE_LEFT(v1, 17);  v1 ^= v2; v2 = STBDS_ROTATE_LEFT(v2,STBDS_SIZE_T_BITS/2); \\\n   519\t      v0 += v3; v3 = STBDS_ROTATE_LEFT(v3, 21);  v3 ^= v0;                                                 \\\n   520\t    } while (0)\n   521\t\n   522\t  for (i=0; i+sizeof(size_t) <= len; i += sizeof(size_t), d += sizeof(size_t)) {\n   523\t    data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n   524\t    data |= (size_t) (d[4] | (d[5] << 8) | (d[6] << 16) | (d[7] << 24)) << 16 << 16; // discarded if size_t == 4\n   525\t\n   526\t    v3 ^= data;\n   527\t    for (j=0; j < STBDS_SIPHASH_C_ROUNDS; ++j)\n   528\t      STBDS_SIPROUND();\n   529\t    v0 ^= data;\n   530\t  }\n   531\t  data = len << (STBDS_SIZE_T_BITS-8);\n   532\t  switch (len - i) {\n   533\t    case 7: data |= ((size_t) d[6] << 24) << 24;\n   534\t    case 6: data |= ((size_t) d[5] << 20) << 20;\n   535\t    case 5: data |= ((size_t) d[4] << 16) << 16;\n   536\t    case 4: data |= (d[3] << 24);\n   537\t    case 3: data |= (d[2] << 16);\n   538\t    case 2: data |= (d[1] << 8);\n   539\t    case 1: data |= d[0];\n   540\t    case 0: break;\n   541\t  }\n   542\t  v3 ^= data;\n   543\t  for (j=0; j < STBDS_SIPHASH_C_ROUNDS; ++j)\n   544\t    STBDS_SIPROUND();\n   545\t  v0 ^= data;\n   546\t  v2 ^= 0xff;\n   547\t  for (j=0; j < STBDS_SIPHASH_D_ROUNDS; ++j)\n   548\t    STBDS_SIPROUND();\n   549\t\n   550\t  return v0^v1^v2^v3;\n   551\t}\n   552\t\n   553\tsize_t stbds_hash_bytes(void *p, size_t len, size_t seed)\n   554\t{\n   555\t  return stbds_siphash_bytes(p,len,seed);\n   556\t}\n   557\t\n   558\tstatic int stbds_is_key_equal(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode, size_t i)\n   559\t{\n   560\t  if (mode >= STBDS_HM_STRING)\n   561\t    return 0==strcmp((char *) key, * (char **) ((char *) a + elemsize*i + keyoffset));\n   562\t  else\n   563\t    return 0==memcmp(key, (char *) a + elemsize*i + keyoffset, keysize);\n   564\t}\n   565\t\n   566\t#define STBDS_HASH_TO_ARR(x,elemsize) ((char*) (x) - (elemsize))\n   567\t#define STBDS_ARR_TO_HASH(x,elemsize) ((char*) (x) + (elemsize))\n   568\t\n   569\t#define stbds_hash_table(a)  ((stbds_hash_index *) stbds_header(a)->hash_table)\n   570\t\n   571\tvoid stbds_hmfree_func(void *a, size_t elemsize)\n   572\t{\n   573\t  if (a == NULL) return;\n   574\t  if (stbds_hash_table(a) != NULL) {\n   575\t    if (stbds_hash_table(a)->string.mode == STBDS_SH_STRDUP) {\n   576\t      size_t i;\n   577\t      for (i=1; i < stbds_header(a)->length; ++i)\n   578\t        STBDS_FREE(NULL, *(char**) ((char *) a + elemsize*i));\n   579\t    }\n   580\t    stbds_strreset(&stbds_hash_table(a)->string);\n   581\t  }\n   582\t  STBDS_FREE(NULL, stbds_header(a)->hash_table);\n   583\t  STBDS_FREE(NULL, stbds_header(a));\n   584\t}\n   585\t\n   586\tstatic ptrdiff_t stbds_hm_find_slot(void *a, size_t elemsize, v