{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport random\n\nc_path = '/tmp/harvest-c-reference-Amc8Jv-2/libtranslated_rust.so'\nr_path = 'target/release/libtranslated_rust.so'\nlibs = [C.CDLL(c_path), C.CDLL(r_path)]\n\nfor lib in libs:\n    lib.stbds_hash_bytes.argtypes = [C.c_void_p, C.c_size_t, C.c_size_t]\n    lib.stbds_hash_bytes.restype = C.c_size_t\n    lib.stbds_hash_string.argtypes = [C.c_char_p, C.c_size_t]\n    lib.stbds_hash_string.restype = C.c_size_t\n    lib.strkey.argtypes = [C.c_int]\n    lib.strkey.restype = C.c_char_p\n    lib.arr_push.argtypes = [C.c_int]\n\nrng = random.Random(0x5EED)\nfor length in range(0, 129):\n    vectors = [bytes(length), bytes((i * 37 + length) & 255 for i in range(length)), bytes(rng.randrange(256) for _ in range(length))]\n    for data in vectors:\n        buf = C.create_string_buffer(data, max(1, len(data)))\n        for seed in (0, 1, 0x31415926, 0xFFFFFFFF, 0x0123456789ABCDEF, 0xFFFFFFFFFFFFFFFF):\n            values = [lib.stbds_hash_bytes(buf, length, seed) for lib in libs]\n            assert values[0] == values[1], ('hash_bytes', length, seed, values, data.hex())\n\nfor data in (b'', b'a', b'test_0', b'abcdefghijklmnopqrstuvwxyz', bytes(range(1, 128)), bytes(range(128, 256))):\n    buf = C.create_string_buffer(data)\n    for seed in (0, 1, 0x31415926, 0x0123456789ABCDEF, 0xFFFFFFFFFFFFFFFF):\n        values = [lib.stbds_hash_string(buf, seed) for lib in libs]\n        assert values[0] == values[1], ('hash_string', data, seed, values)\n\nfor value in (-2147483648, -1001, -1, 0, 1, 2147483647):\n    outputs = [lib.strkey(value) for lib in libs]\n    assert outputs[0] == outputs[1], ('strkey', value, outputs)\n\nfor lib in libs:\n    for count in (-1, 0, 1, 50, 51, 151):\n        lib.arr_push(count)\n\nprint('hash/string/arr differential checks passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
