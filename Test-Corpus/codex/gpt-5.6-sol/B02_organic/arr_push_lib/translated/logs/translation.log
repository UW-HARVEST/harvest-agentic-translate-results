{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\n\npaths = ['/tmp/harvest-c-reference-Amc8Jv-2/libtranslated_rust.so', 'target/release/libtranslated_rust.so']\nlibs = [C.CDLL(path) for path in paths]\n\nclass Header(C.Structure):\n    _fields_ = [('length', C.c_size_t), ('capacity', C.c_size_t), ('hash_table', C.c_void_p), ('temp', C.c_ssize_t)]\nclass Arena(C.Structure):\n    _fields_ = [('storage', C.c_void_p), ('remaining', C.c_size_t), ('block', C.c_ubyte), ('mode', C.c_ubyte)]\nclass Bucket(C.Structure):\n    _fields_ = [('hash', C.c_size_t * 8), ('index', C.c_ssize_t * 8)]\nclass HashIndex(C.Structure):\n    _fields_ = [('temp_key', C.c_void_p), ('slot_count', C.c_size_t), ('used_count', C.c_size_t),\n                ('used_count_threshold', C.c_size_t), ('used_count_shrink_threshold', C.c_size_t),\n                ('tombstone_count', C.c_size_t), ('tombstone_count_threshold', C.c_size_t),\n                ('seed', C.c_size_t), ('slot_count_log2', C.c_size_t), ('string', Arena),\n                ('storage', C.POINTER(Bucket))]\nclass BinaryEntry(C.Structure):\n    _fields_ = [('key', C.c_int), ('value', C.c_int)]\nclass StringEntry(C.Structure):\n    _fields_ = [('key', C.c_void_p), ('value', C.c_int)]\n\nassert C.sizeof(Header) == 32\nassert C.sizeof(Arena) == 24\nassert C.sizeof(Bucket) == 128\nassert C.sizeof(HashIndex) == 104\nassert C.sizeof(StringEntry) == 16\n\nfor lib in libs:\n    lib.stbds_arrgrowf.argtypes = [C.c_void_p, C.c_size_t, C.c_size_t, C.c_size_t]\n    lib.stbds_arrgrowf.restype = C.c_void_p\n    lib.stbds_arrfreef.argtypes = [C.c_void_p]\n    lib.stbds_stralloc.argtypes = [C.POINTER(Arena), C.c_char_p]\n    lib.stbds_stralloc.restype = C.c_void_p\n    lib.stbds_strreset.argtypes = [C.POINTER(Arena)]\n    lib.stbds_rand_seed.argtypes = [C.c_size_t]\n    lib.stbds_hmput_key.argtypes = [C.c_void_p, C.c_size_t, C.c_void_p, C.c_size_t, C.c_int]\n    lib.stbds_hmput_key.restype = C.c_void_p\n    lib.stbds_hmget_key.argtypes = [C.c_void_p, C.c_size_t, C.c_void_p, C.c_size_t, C.c_int]\n    lib.stbds_hmget_key.restype = C.c_void_p\n    lib.stbds_hmget_key_ts.argtypes = [C.c_void_p, C.c_size_t, C.c_void_p, C.c_size_t, C.POINTER(C.c_ssize_t), C.c_int]\n    lib.stbds_hmget_key_ts.restype = C.c_void_p\n    lib.stbds_hmput_default.argtypes = [C.c_void_p, C.c_size_t]\n    lib.stbds_hmput_default.restype = C.c_void_p\n    lib.stbds_hmdel_key.argtypes = [C.c_void_p, C.c_size_t, C.c_void_p, C.c_size_t, C.c_size_t, C.c_int]\n    lib.stbds_hmdel_key.restype = C.c_void_p\n    lib.stbds_hmfree_func.argtypes = [C.c_void_p, C.c_size_t]\n    lib.stbds_shmode_func.argtypes = [C.c_size_t, C.c_int]\n    lib.stbds_shmode_func.restype = C.c_void_p\n\n# Dynamic array growth, metadata, and realloc preservation.\narrays = [None, None]\nlength = 0\nfor add, minimum in [(0, 0), (1, 0), (3, 0), (0, 20), (2, 0), (50, 1)]:\n    snapshots = []\n    for index, lib in enumerate(libs):\n        arrays[index] = lib.stbds_arrgrowf(arrays[index], C.sizeof(C.c_int), add, minimum)\n        header = Header.from_address(arrays[index] - C.sizeof(Header))\n        snapshots.append((header.length, header.capacity, header.temp, bool(header.hash_table)))\n        for item in range(length):\n            assert C.c_int.from_address(arrays[index] + item * 4).value == item * 17\n        target = max(length, length + add)\n        for item in range(length, target):\n            C.c_int.from_address(arrays[index] + item * 4).value = item * 17\n        header.length = target\n    assert snapshots[0] == snapshots[1], ('array metadata', add, minimum, snapshots)\n    length += add\nfor lib, pointer in zip(libs, arrays):\n    lib.stbds_arrfreef(pointer)\n\n# String arenas exercise normal blocks and oversized linked blocks.\narenas = [Arena(), Arena()]\nstrings = [b'a', b'b' * 300, b'c' * 400, b'd' * 700, b'e' * 1300, b'f' * 17, b'g' * 1_048_577]\nfor value in strings:\n    states = []\n    outputs = []\n    for lib, arena in zip(libs, arenas):\n        pointer = lib.stbds_stralloc(C.byref(arena), value)\n        outputs.append(C.string_at(pointer))\n        states.append((arena.remaining, arena.block, arena.mode, bool(arena.storage)))\n    assert outputs[0] == outputs[1] == value\n    assert states[0] == states[1], ('arena state', len(value), states)\nfor lib, arena in zip(libs, arenas):\n    lib.stbds_strreset(C.byref(arena))\n    assert bytes(arena) == bytes(C.sizeof(Arena))\n\n\ndef header_for(hash_pointer, elem_size):\n    return Header.from_address(hash_pointer - elem_size - C.sizeof(Header))\n\ndef table_snapshot(hash_pointer, elem_size):\n    h = header_for(hash_pointer, elem_size)\n    table = HashIndex.from_address(h.hash_table) if h.hash_table else None\n    if table is None:\n        return (h.length, h.capacity, h.temp, None)\n    buckets = []\n    for bi in range(table.slot_count // 8):\n        bucket = table.storage[bi]\n        buckets.append((tuple(bucket.hash), tuple(bucket.index)))\n    scalar = (table.slot_count, table.used_count, table.used_count_threshold,\n              table.used_count_shrink_threshold, table.tombstone_count,\n              table.tombstone_count_threshold, table.seed, table.slot_count_log2,\n              table.string.remaining, table.string.block, table.string.mode,\n              bool(table.string.storage))\n    return (h.length, h.capacity, h.temp, scalar, tuple(buckets))\n\n# Binary hash maps: growth, duplicate replacement, lookup, deletion, shrink/rebuild.\nfor lib in libs:\n    lib.stbds_rand_seed(0x123456789ABCDEF0)\nmaps = [None, None]\nfor key_value in list(range(80)) + [7, 19, 79]:\n    states = []\n    for index, lib in enumerate(libs):\n        key = C.c_int(key_value)\n        maps[index] = lib.stbds_hmput_key(maps[index], C.sizeof(BinaryEntry), C.byref(key), C.sizeof(key), 0)\n        h = header_for(maps[index], C.sizeof(BinaryEntry))\n        entry = BinaryEntry.from_address(maps[index] + h.temp * C.sizeof(BinaryEntry))\n        entry.value = key_value * 101 + 3\n        states.append(table_snapshot(maps[index], C.sizeof(BinaryEntry)))\n    assert states[0] == states[1], ('binary put', key_value)\n\nfor key_value in list(range(80)) + [-1, 1000]:\n    results = []\n    for index, lib in enumerate(libs):\n        key = C.c_int(key_value)\n        temp = C.c_ssize_t(999)\n        returned = lib.stbds_hmget_key_ts(maps[index], C.sizeof(BinaryEntry), C.byref(key), C.sizeof(key), C.byref(temp), 0)\n        assert returned == maps[index]\n        value = None if temp.value < 0 else BinaryEntry.from_address(maps[index] + temp.value * 8).value\n        results.append((temp.value, value))\n    assert results[0] == results[1], ('binary get', key_value, results)\n\nfor key_value in list(range(0, 80, 3)) + [999, 7, 19]:\n    states = []\n    entries = []\n    for index, lib in enumerate(libs):\n        key = C.c_int(key_value)\n        maps[index] = lib.stbds_hmdel_key(maps[index], 8, C.byref(key), 4, 0, 0)\n        h = header_for(maps[index], 8)\n        entries.append(tuple((BinaryEntry.from_address(maps[index] + i * 8).key,\n                              BinaryEntry.from_address(maps[index] + i * 8).value)\n                             for i in range(h.length - 1)))\n        states.append(table_snapshot(maps[index], 8))\n    assert entries[0] == entries[1], ('binary delete entries', key_value)\n    assert states[0] == states[1], ('binary delete table', key_value)\n\nfor lib, pointer in zip(libs, maps):\n    lib.stbds_hmfree_func(pointer - C.sizeof(BinaryEntry), C.sizeof(BinaryEntry))\n\n# String maps in borrowed, strdup, and arena modes.\nfor string_mode in (1, 2, 3):\n    for lib in libs:\n        lib.stbds_rand_seed(0xA5A5A5A5)\n    smaps = [None, None]\n    if string_mode \"'!= 1:\n        smaps = [lib.stbds_shmode_func(C.sizeof(StringEntry), string_mode) for lib in libs]\n    keepalive = [[], []]\n    values = [f'\"'key-{i:03d}'.encode() for i in range(50)] + [b'key-007', b'key-049']\n    for ordinal, value in enumerate(values):\n        normalized = []\n        states = []\n        for index, lib in enumerate(libs):\n            key = C.create_string_buffer(value)\n            keepalive[index].append(key)\n            smaps[index] = lib.stbds_hmput_key(smaps[index], C.sizeof(StringEntry), key, C.sizeof(C.c_void_p), 1)\n            h = header_for(smaps[index], C.sizeof(StringEntry))\n            entry = StringEntry.from_address(smaps[index] + h.temp * C.sizeof(StringEntry))\n            entry.value = ordinal * 13\n            normalized.append(tuple((C.string_at(StringEntry.from_address(smaps[index] + i * 16).key),\n                                     StringEntry.from_address(smaps[index] + i * 16).value)\n                                    for i in range(h.length - 1)))\n            states.append(table_snapshot(smaps[index], C.sizeof(StringEntry)))\n        assert normalized[0] == normalized[1], ('string put entries', string_mode, value)\n        assert states[0] == states[1], ('string put table', string_mode, value)\n\n    for value in (b'key-000', b'key-007', b'key-049', b'missing'):\n        results = []\n        for index, lib in enumerate(libs):\n            key = C.create_string_buffer(value)\n            smaps[index] = lib.stbds_hmget_key(smaps[index], 16, key, 8, 1)\n            h = header_for(smaps[index], 16)\n            result = None if h.temp < 0 else (C.string_at(StringEntry.from_address(smaps[index] + h.temp * 16).key),\n                                                StringEntry.from_address(smaps[index] + h.temp * 16).value)\n            results.append((h.temp, result))\n        assert results[0] == results[1], ('string get', string_mode, value, results)\n\n    for value in (b'key-003', b'key-049', b'key-017', b'missing', b'key-000'):\n        normalized = []\n        states = []\n        for index, lib in enumerate(libs):\n            key = C.create_string_buffer(value)\n            smaps[index] = lib.stbds_hmdel_key(smaps[index], 16, key, 8, 0, 1)\n            h = header_for(smaps[index], 16)\n            normalized.append(tuple((C.string_at(StringEntry.from_address(smaps[index] + i * 16).key),\n                                     StringEntry.from_address(smaps[index] + i * 16).value)\n                                    for i in range(h.length - 1)))\n            states.append(table_snapshot(smaps[index], 16))\n        assert normalized[0] == normalized[1], ('string del entries', string_mode, value)\n        assert states[0] == states[1], ('string del table', string_mode, value)\n\n    for lib, pointer in zip(libs, smaps):\n        lib.stbds_hmfree_func(pointer - C.sizeof(StringEntry), C.sizeof(StringEntry))\n\nprint('array/arena/binary-map/string-map differential checks passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
