 408\t            break;\n   409\t        }\n   410\t    }\n   411\t    true\n   412\t}\n   413\t\n   414\t#[unsafe(no_mangle)]\n   415\tpub unsafe extern \"C\" fn cp_inflate(\n   416\t    input: *mut c_void,\n   417\t    in_bytes: c_int,\n   418\t    output: *mut c_void,\n   419\t    out_bytes: c_int,\n   420\t) -> c_int {\n   421\t    let mut state = Box::new(CpState::zeroed());\n   422\t    let input = input.cast::<u8>();\n   423\t    let output = output.cast::<u8>();\n   424\t\n   425\t    state.bits_left = in_bytes * 8;\n   426\t    let address = input as usize;\n   427\t    let first_bytes = (((address + 3) & !3) - address) as c_int;\n   428\t    state.words = input.add(first_bytes as usize).cast::<u32>();\n   429\t    state.word_count = (in_bytes - first_bytes) / 4;\n   430\t    let last_bytes = (in_bytes - first_bytes) & 3;\n   431\t    for i in 0..first_bytes {\n   432\t        state.bits |= (ptr::read(input.add(i as usize)) as u64) << (i * 8);\n   433\t    }\n   434\t    state.final_word_available = c_int::from(last_bytes != 0);\n   435\t    state.final_word = 0;\n   436\t    for i in 0..last_bytes {\n   437\t        state.final_word |=\n   438\t            (ptr::read(input.offset((in_bytes - last_bytes + i) as isize)) as u32) << (i * 8);\n   439\t    }\n   440\t    state.count = first_bytes * 8;\n   441\t    state.out = output;\n   442\t    state.out_end = output.offset(out_bytes as isize);\n   443\t    state.begin = output;\n   444\t\n   445\t    loop {\n   446\t        let bfinal = cp_read_bits(&mut state, 1);\n   447\t        let btype = cp_read_bits(&mut state, 2);\n   448\t        match btype {\n   449\t            0 => {\n   450\t                if !cp_stored(&mut state) {\n   451\t                    return 0;\n   452\t                }\n   453\t            }\n   454\t            1 => {\n   455\t                cp_fixed(&mut state);\n   456\t                if !cp_block(&mut state) {\n   457\t                    return 0;\n   458\t                }