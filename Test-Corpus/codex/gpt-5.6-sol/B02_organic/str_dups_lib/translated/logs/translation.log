_map\"] = {\"header\": [binary_hdr.length, binary_hdr.capacity], \"entries\": logical_entries, \"lookups\": lookups}\nlib.stbds_hmfree_func(raw_map(binary, ctypes.sizeof(BinEntry)), ctypes.sizeof(BinEntry))\n\nstring_modes = {}\nfor mode in [1, 2, 3]:\n    lib.stbds_rand_seed(0x1020304050607080)\n    mapping = lib.stbds_shmode_func(ctypes.sizeof(StrEntry), mode)\n    buffers = {}\n    names = [f\"key-{(index * 29) % 97:03d}\" for index in range(70)]\n    present_names = set()\n    for index, name in enumerate(names):\n        if name not in buffers:\n            buffers[name] = ctypes.create_string_buffer(name.encode())\n        mapping = lib.stbds_hmput_key(mapping, ctypes.sizeof(StrEntry), buffers[name], ctypes.sizeof(vp), 1)\n        hdr = header_for_map(mapping, ctypes.sizeof(StrEntry))\n        StrEntry.from_address(mapping + hdr.temp * ctypes.sizeof(StrEntry)).value = index * 11\n        present_names.add(name)\n    for name in sorted(present_names)[2::5]:\n        mapping = lib.stbds_hmdel_key(mapping, ctypes.sizeof(StrEntry), buffers[name], ctypes.sizeof(vp), 0, 1)\n        present_names.discard(name)\n    for index in range(25):\n        name = f\"extra-{index:02d}\"\n        buffers[name] = ctypes.create_string_buffer(name.encode())\n        mapping = lib.stbds_hmput_key(mapping, ctypes.sizeof(StrEntry), buffers[name], ctypes.sizeof(vp), 1)\n        hdr = header_for_map(mapping, ctypes.sizeof(StrEntry))\n        StrEntry.from_address(mapping + hdr.temp * ctypes.sizeof(StrEntry)).value = 5000 + index\n        present_names.add(name)\n    hdr = header_for_map(mapping, ctypes.sizeof(StrEntry))\n    entries = (StrEntry * (hdr.length - 1)).from_address(mapping)\n    logical = [[ctypes.string_at(e.key).decode(), e.value] for e in entries]\n    lookup_indices = []\n    for name in sorted(present_names) + [\"absent-key\"]:\n        probe = buffers.get(name) or ctypes.create_string_buffer(name.encode())\n        mapping = lib.stbds_hmget_key(mapping, ctypes.sizeof(StrEntry), probe, ctypes.sizeof(vp), 1)\n        lookup_indices.append([name, header_for_map(mapping, ctypes.sizeof(StrEntry)).temp])\n    string_modes[str(mode)] = {\"header\": [hdr.length, hdr.capacity], \"entries\": logical, \"lookups\": lookup_indices}\n    lib.stbds_hmfree_func(raw_map(mapping, ctypes.sizeof(StrEntry)), ctypes.sizeof(StrEntry))\nresult[\"string_maps\"] = string_modes\n\ndefault_map = lib.stbds_hmput_default(None, ctypes.sizeof(BinEntry))\ndefault_hdr = header_for_map(default_map, ctypes.sizeof(BinEntry))\nresult[\"default_map\"] = [default_hdr.length, default_hdr.capacity, list(bytes((ctypes.c_ubyte * ctypes.sizeof(BinEntry)).from_address(default_map - ctypes.sizeof(BinEntry))))]\nlib.stbds_hmfree_func(raw_map(default_map, ctypes.sizeof(BinEntry)), ctypes.sizeof(BinEntry))\n\narena = Arena()\narena_states = []\nfor length in [0, 1, 10, 500, 511, 512, 600, 1024, 17, 70000]:\n    text = bytes((65 + index % 26) for index in range(length))\n    allocated = lib.stbds_stralloc(ctypes.byref(arena), text)\n    arena_states.append([length, hashlib.sha256(ctypes.string_at(allocated)).hexdigest(), arena.remaining, arena.block])\nlib.stbds_strreset(ctypes.byref(arena))\nresult[\"arena\"] = [arena_states, [bool(arena.storage), arena.remaining, arena.block, arena.mode]]\nresult[\"strkey\"] = [lib.strkey(value).decode() for value in [-2147483648, -1, 0, 7, 2147483647]]\n\nprint(json.dumps(result, sort_keys=True, separators=(\",\", \":\")))\nPY\ndone\nls -l .reference-c-build/.reference-c-build-behavior.json .reference-c-build/release-behavior.json\nwc -l -c .reference-c-build/.reference-c-build-behavior.json .reference-c-build/release-behavior.json\ndiff -u .reference-c-build/.reference-c-build-behavior.json .reference-c-build/release-behavior.json'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
