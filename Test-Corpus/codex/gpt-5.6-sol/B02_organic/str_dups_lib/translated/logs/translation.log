           for (z=pos & STBDS_BUCKET_MASK; z < STBDS_BUCKET_LENGTH; ++z) {\n   444\t              if (bucket->hash[z] == 0) {\n   445\t                bucket->hash[z] = hash;\n   446\t                bucket->index[z] = ob->index[j];\n   447\t                goto done;\n   448\t              }\n   449\t            }\n   450\t\n   451\t            limit = pos & STBDS_BUCKET_MASK;\n   452\t            for (z = 0; z < limit; ++z) {\n   453\t              if (bucket->hash[z] == 0) {\n   454\t                bucket->hash[z] = hash;\n   455\t                bucket->index[z] = ob->index[j];\n   456\t                goto done;\n   457\t              }\n   458\t            }\n   459\t\n   460\t            pos += step;\n   461\t            step += STBDS_BUCKET_LENGTH;\n   462\t            pos &= (t->slot_count-1);\n   463\t          }\n   464\t        }\n   465\t       done:\n   466\t        ;\n   467\t      }\n   468\t    }\n   469\t  }\n   470\t\n   471\t  return t;\n   472\t}\n   473\t\n   474\t#define STBDS_ROTATE_LEFT(val, n)   (((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n))))\n   475\t#define STBDS_ROTATE_RIGHT(val, n)  (((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n))))\n   476\t\n   477\tsize_t stbds_hash_string(char *str, size_t seed)\n   478\t{\n   479\t  size_t hash = seed;\n   480\t  while (*str)\n   481\t     hash = STBDS_ROTATE_LEFT(hash, 9) + (unsigned char) *str++;\n   482\t\n   483\t  hash ^= seed;\n   484\t  hash = (~hash) + (hash << 18);\n   485\t  hash ^= hash ^ STBDS_ROTATE_RIGHT(hash,31);\n   486\t  hash = hash * 21;\n   487\t  hash ^= hash ^ STBDS_ROTATE_RIGHT(hash,11);\n   488\t  hash += (hash << 6);\n   489\t  hash ^= STBDS_ROTATE_RIGHT(hash,22);\n   490\t  return hash+seed;\n   491\t}\n   492\t\n   493\t#define STBDS_SIPHASH_C_ROUNDS 2\n   494\t#define STBDS_SIPHASH_D_ROUNDS 4\n   495\ttypedef int STBDS_SIPHASH_2_4_can_only_be_used_in_64_bit_builds[sizeof(size_t) == 8 ? 1 : -1];\n   496\t\n   497\t\n   498\tstatic size_t stbds_siphash_bytes(