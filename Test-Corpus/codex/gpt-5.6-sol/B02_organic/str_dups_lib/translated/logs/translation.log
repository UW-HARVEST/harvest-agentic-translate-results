{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes, random\npaths = ['.reference-c-build/libtranslated_rust.so', 'target/release/libtranslated_rust.so']\nlibs = [ctypes.CDLL('./' + p) for p in paths]\nfor lib in libs:\n    lib.stbds_hash_bytes.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_size_t]\n    lib.stbds_hash_bytes.restype = ctypes.c_size_t\n    lib.stbds_hash_string.argtypes = [ctypes.c_char_p, ctypes.c_size_t]\n    lib.stbds_hash_string.restype = ctypes.c_size_t\nrng = random.Random(0x5eed)\nchecks = 0\nfor length in list(range(513)) + [1023, 1024, 4095]:\n    for _ in range(8):\n        data = bytes(rng.randrange(256) for _ in range(length))\n        seed = rng.randrange(1 << 64)\n        buf = ctypes.create_string_buffer(data, max(1, length))\n        values = [lib.stbds_hash_bytes(buf, length, seed) for lib in libs]\n        assert values[0] == values[1], ('bytes', length, seed, values)\n        checks += 1\nfor length in range(256):\n    for _ in range(8):\n        data = bytes(rng.randrange(1, 256) for _ in range(length))\n        seed = rng.randrange(1 << 64)\n        values = [lib.stbds_hash_string(data, seed) for lib in libs]\n        assert values[0] == values[1], ('string', length, seed, values)\n        checks += 1\nprint(f'hash comparisons passed: {checks}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
