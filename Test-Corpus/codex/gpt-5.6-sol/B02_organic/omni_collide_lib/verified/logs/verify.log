lloc(size: usize) -> *mut c_void;\n}\n\n#[unsafe(no_mangle)]\n#[inline(never)]\npub extern \"C\" fn c2V(x: c_float, y: c_float) -> c2v {\n    c2v { x, y }\n}\n\n#[unsafe(no_mangle)]\n#[inline(never)]\npub extern \"C\" fn c2Mulvs(a: c2v, b: c_float) -> c2v {\n    #[cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))]\n    {\n        // GCC puts the broadcast scalar in the destination operand. That order\n        // determines which NaN payload SSE multiplication preserves.\n        let mut lhs: __m128 = unsafe { std::mem::transmute([b, b, b, b]) };\n        let rhs: __m128 = unsafe { std::mem::transmute([a.x, a.y, 0.0, 0.0]) };\n        unsafe {\n            std::arch::asm!(\n                \"mulps {lhs}, {rhs}\",\n                lhs = inout(xmm_reg) lhs,\n                rhs = in(xmm_reg) rhs,\n                options(pure, nomem, nostack)\n            );\n            let result: [c_float; 4] = std::mem::transmute(lhs);\n            return c2v {\n                x: result[0],\n                y: result[1],\n            };\n        }\n    }\n\n    #[cfg(not(any(target_arch = \"x86\", target_arch = \"x86_64\")))]\n    c2v {\n        x: a.x * b,\n        y: a.y * b,\n    }\n}\n\n#[unsafe(no_mangle)]\n#[inline(never)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\n#[inline(never)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\n#[inline(never)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n#[unsafe(no_mangle)]\n#[inline(never)]\npub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\n#[inline(never)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> c_float {\n    #[cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))]\n    {\n        let mut x = a.x;\n        let y = a.y;\n        unsafe {\n            std::arch::asm!(\n                \"mulss {x}, {bx}\",\n                \"mulss {y}, {by}\",\n                \"addss {x}, {y}\",\n                x = inout(xmm_reg) x,\n                y = inout(xmm_reg) y => _,\n                bx = in(xmm_reg) b.x,\n                by = in(xmm_reg) b.y,\n                options(pure, nomem, nostack)\n            );\n        }\n        return x;\n    }\n\n    #[cfg(not(any(target_arch = \"x86\", target_arch = \"x86_64\")))]\n    {\n        (a.x * b.x) + (a.y * b.y)\n    }\n}\n\n#[unsafe(no_mangle)]\n#[inline(never)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    c2r { c: 1.0, s: 0.0 }\n}\n\n#[unsafe(no_mangle)]\n#[inline(never)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    c2x {\n        p: c2V(0.0, 0.0),\n        r: c2RotIdentity(),\n    }\n}\n\n#[unsafe(no_mangle)]\n#[inline(never)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    let bb = &*bb;\n    ptr::write(out, bb.min);\n    ptr::write(out.add(1), c2V(bb.max.x, bb.min.y));\n    ptr::write(out.add(2), bb.max);\n    ptr::write(out.add(3), c2V(bb.min.x, bb.max.y));\n}\n\n#[unsafe(no_mangle)]\n#[inline(never)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, typ: C2_TYPE, p: *mut c2Proxy) {\n    match typ {\n        C2_TYPE_CIRCLE => {\n            let c = &*(shape.cast::<c2Circle>());\n            (*p).radius = c.r;\n            (*p).count = 1;\n            (*p).verts[0] = c.p;\n        }\n        C2_TYPE_AABB => {\n            let bb = shape.cast::<c2AABB>();\n            (*p).radius = 0.0;\n            (*p).count = 4;\n            c2BBVerts((*p).verts.as_mut_ptr(), bb.cast_mut());\n        }\n        C2_TYPE_CAPSULE => {\n            let c = &*(shape.cast::<c2Capsule>());\n            (*p).radius = c.r;\n            (*p).count = 2;\n            (*p).verts[0] = c.a;\n            (*p).verts[1