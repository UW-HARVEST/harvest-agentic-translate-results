\t\t\t*a = c2V(0, 0);\r\n   334\t\t\t\t*b = c2V(0, 0);\r\n   335\t\t}\r\n   336\t}\r\n   337\t\r\n   338\tc2v c2Div(c2v a, float b) {\r\n   339\t\treturn c2Mulvs(a, 1.0f / b);\r\n   340\t}\r\n   341\t\r\n   342\tc2v c2Norm(c2v a) {\r\n   343\t\treturn c2Div(a, c2Len(a));\r\n   344\t}\r\n   345\t\r\n   346\tc2v c2L(c2Simplex *s) {\r\n   347\t    float den = 1.0f / s->div;\r\n   348\t    switch (s->count) {\r\n   349\t    case 1:\r\n   350\t        return s->a.p;\r\n   351\t    case 2:\r\n   352\t        return c2Add(c2Mulvs(s->a.p, (den * s->a.u)),\r\n   353\t                     c2Mulvs(s->b.p, (den * s->b.u)));\r\n   354\t    default:\r\n   355\t        return c2V(0, 0);\r\n   356\t    }\r\n   357\t}\r\n   358\t\r\n   359\tc2v c2MulrvT(c2r a, c2v b) {\r\n   360\t    return c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y);\r\n   361\t}\r\n   362\t\r\n   363\tfloat c2GJK(const void *A, C2_TYPE typeA, const c2x *ax_ptr, const void *B,\r\n   364\t\t\tC2_TYPE typeB, const c2x *bx_ptr, c2v *outA, c2v *outB,\r\n   365\t\t\tint use_radius, int *iterations, c2GJKCache *cache) {\r\n   366\t\tc2x ax;\r\n   367\t\tc2x bx;\r\n   368\t\tif (!ax_ptr)\r\n   369\t\t\tax = c2xIdentity();\r\n   370\t\telse\r\n   371\t\t\tax = *ax_ptr;\r\n   372\t\tif (!bx_ptr)\r\n   373\t\t\tbx = c2xIdentity();\r\n   374\t\telse\r\n   375\t\t\tbx = *bx_ptr;\r\n   376\t\tc2Proxy pA;\r\n   377\t\tc2Proxy pB;\r\n   378\t\tc2MakeProxy(A, typeA, &pA);\r\n   379\t\tc2MakeProxy(B, typeB, &pB);\r\n   380\t\tc2Simplex s;\r\n   381\t\tc2sv *verts = &s.a;\r\n   382\t\tint cache_was_read = 0;\r\n   383\t\tif (cache) {\r\n   384\t\t\tint cache_was_good = !!cache->count;\r\n   385\t\t\tif (cache_was_good) {\r\n   386\t\t\t\tfor (int i = 0; i < cache->count; ++i) {\r\n   387\t\t\t\t\tint iA = cache->iA[i];\r\n   388\t\t\t\t\tint iB = cache->iB[i];\r\n   389\t\t\t\t\tc2v sA = c2Mulxv(ax, pA.verts[iA]);\r\n   390\t\t\t\t\tc2v sB = c2Mulxv(bx, pB.verts[iB]);\r\n   391\t\t\t\t\tc2sv *v = verts + i;\r\n   392\t\t\t\t\tv->iA = iA;\r\n   393\t\t\t\t\tv->sA = sA;\r\n   394\t\t\t\t\tv->iB = iB;\r\n   395\t\t\t\t\tv->sB = sB;\r\n   396\t\t\t\t\tv->p = c2Sub(v->sB, v->sA);\r\n   397\t\t\t\t\tv->u = 0;\r\n   398\t\t\t\t}\r\n   399\t\t\t\ts.count = cache->count;\r\n   400\t\t\t\ts.div = cache->div;\r\n   401\t\t\t\tfloat metric_old = cache->metric;\r\n   402\t\t\t\tfloat metric = c2GJKSimplexMetric(&s);\r\n   403\t\t\t\tfloat min_metric = metric < metric_old ? metric : metric_old;\r\n   404\t\t\t\tfloat max_metric = metric > metric_old ? metric : metric_old;\r\n   405\t\t\t\tif (!(min_metric < max_metric * 2.0f && metric < -1.0e8f))\r\n   406\t\t\t\t\tcache_was_read = 1;\r\n   407\t\t\t}\r\n   408\t\t}\r\n   409\t\tif (!cache_was_read) {\r\n   410\t\t\ts.a.iA = 0;\r\n   411\t\t\ts.a.iB = 0;\r\n   412\t\t\ts.a.sA = c2Mulxv(ax, pA.verts[0]);\r\n   413\t\t\ts.a.sB = c2Mulxv(bx, pB.verts[0]);\r\n   414\t\t\ts.a.p = c2Sub(s.a.sB, s.a.sA);\r\n   415\t\t\ts.a.u = 1.0f;\r\n   416\t\t\ts.div = 1.0f;\r\n   417\t\t\ts.count = 1;\r\n   418\t\t}\r\n   419\t\tint saveA[3], saveB[3];\r\n   420\t\tint save_count = 0;\r\n   421\t\tfloat d0 = 3.40282346638528859811704183484516925e+38F;\r\n   422\t\tfloat d1 = 3.40282346638528859811704183484516925e+38F;\r\n   423\t\tint iter = 0;\r\n   424\t\tint hit = 0;\r\n   425\t\twhile (iter < 20) {\r\n   426\t\t\tsave_count = s.count;\r\n   427\t\t\tfor (int i = 0; i < save_count; ++i) {\r\n   428\t\t\t\tsaveA[i] = verts[i].iA;\r\n   429\t\t\t\tsaveB[i] = verts[i].iB;\r\n   430\t\t\t}\r\n   431\t\t\tswitch (s.count) {\r\n   432\t\t\t\tcase 1:\r\n   433\t\t\t\t\tbreak;\r\n   434\t\t\t\tcase 2:\r\n   435\t\t\t\t\tc22(&s);\r\n   436\t\t\t\t\tbreak;\r\n   437\t\t\t\tcase 3:\r\n   438\t\t\t\t\tc23(&s);\r\n   439\t\t\t\t\tbreak;\r\n   440\t\t\t}\r\n   441\t\t\tif (s.count == 3) {\r\n   442\t\t\t\thit = 1;\r\n   443\t\t\t\tbreak;\r\n   444\t\t\t}\r\n   445\t\t\tc2v p = c2L(&s);\r\n   446\t\t\td1 = c2Dot(p, p);\r\n   447\t\t\tif (d1 > d0)\r\n   448\t\t\t\tbreak;\r\n   449\t\t\td0 = d1;\r\n   450\t\t\tc2v d = c2D(&s);\r\n   451\t\t\tif (c2Dot(d, d) < 1.19209289550781250000000000000000000e-7F *\r\n   452\t\t\t\t\t1.19209289550781250000000000000000000e-7F)\r\n   453\t\t\t\tbreak;\r\n   454\t\t\tint iA = c2Support(pA.verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\r\n   455\t\t\tc2v sA = c2Mulxv(ax, pA.verts[iA]);\r\n   456\t\t\tint iB = c2Support(pB.verts, pB.count, c2MulrvT(bx.r, d));\r\n   457\t\t\tc2v sB = c2Mulxv(bx, pB.verts[iB]);\r\n   458\t\t\tc2sv *v = verts + s.count;\r\n   459\t\t\tv->iA = iA;\r\n   460\t\t\tv->sA = sA;\r\n   461\t\t\tv->iB = iB;\r\n   462\t\t\tv->sB = sB;\r\n   463\t\t\tv->p = c2Sub(v->sB, v->sA);\r\n   464\t\t\tint dup = 0;\r\n   465\t\t\tfor (int i = 0; i < save_count; ++i) {\r\n   466\t\t\t\tif (iA == saveA[i] && iB == saveB[i]) {\r\n   467\t\t\t\t\tdup = 1;\r\n   468\t\t\t\t\tbreak;\r\n   469\t\t\t\t}\r\n   470\t\t\t}\r\n   471\t\t\tif (dup)\r\n   472\t\t\t\tbreak;\r\n   473\t\t\t++s.count;\r\n   474\t\t\t++iter;\r\n   475\t\t}\r\n   476\t\tc2v a, b;\r\n   477\t\tc2Witness(&s, &a, &b);\r\n   478\t\tfloat dist = c2Len(c2Sub(a, b));\r\n   479\t\tif (hit) {\r\n   480\t\t\ta = b;\r\n   481\t\t\tdist = 0;\r\n   482\t\t} else if (use_radius) {\r\n   483\t\t\tfloat rA = pA.radius;\r\n   484\t\t\tfloat rB = pB.radius;\r\n   485\t\t\tif (dist > rA + rB &&\r\n   486\t\t\t\t\tdist > 1.19209289550781250000000000000000000e-7F) {\r\n   487\t\t\t\tdist -= rA + rB;\r\n   488\t\t\t\tc2v n = c2Norm(c2Sub(b, a));\r\n   489\t\t\t\ta = c2Add(a, c2Mulvs(n, rA));\r\n   490\t\t\t\tb = c2Sub(b, c2Mulvs(n, rB));\r\n   491\t\t\t\tif (a.x == b.x && a.y == b.y)\r\n   492\t\t\t\t\tdist = 0;\r\n   493\t\t\t} else {\r\n   494\t\t\t\tc2v p = c2Mulvs(c2Add(a, b), 0.5f);\r\n   495\t\t\t\ta = p;\r\n   496\t\t\t\tb = p;\r\n   497\t\t\t\tdist = 0;\r\n   498\t\t\t}\r\n   499\t\t}\r\n   500\t\tif (cache) {\r\n   501\t\t\tcache->metric = c2GJKSimplexMetric(&s);\r\n   502\t\t\tcache->count = s.count;\r\n   503\t\t\tfor (int i = 0; i < s.count; ++i) {\r\n   504\t\t\t\tc2sv *v = verts + i;\r\n   505\t\t\t\tcache->iA[i] = v->iA;\r\n   506\t\t\t\tcache->iB[i] = v->iB;\r\n   507\t\t\t}\r\n   508\t\t\tcache->div = s.div;\r\n   509\t\t}\r\n   510\t\tif (outA)\r\n   511\t\t\t*outA = a;\r\n   512\t\tif (outB)\r\n   513\t\t\t*outB = b;\r\n   514\t\tif (iterations)\r\n   515\t\t\t*iterations = iter;\r\n   516\t\treturn dist;\r\n   517\t}\r\n   518\t\r\n   519\tint c2AABBtoAABB(c2AABB A, c2AABB B) {\r\n   520\t\tint d0 = B.max.x < A.min.x;\r\n   521\t\tint d1 = A.max.x < B.min.x;\r\n   522\t\tint d2 = B.max.y < A.min.y;\r\n   523\t\tint d3 = A.max.y < B.min.y;\r\n   524\t\treturn !(d0 | d1 | d2 | d3);\r\n   525\t}\r\n   526\t\r\n   527\tint c2AABBtoCapsule(c2AABB A, c2Capsule B) {\r\n   528\t\tif (c2GJK(&A, C2_TYPE_AABB, 0, &B, C2_TYPE_CAPSULE, 0, 0, 0, 1, 0, 0))\r\n   529\t\t\treturn 0;\r\n   530\t\treturn 1;\r\n   531\t}\r\n   532\t\r\n   533\tint c2CapsuletoCapsule(c2Capsule A, c2Capsule B) {\r\n   534\t\tif (c2GJK(&A, C2_TYPE_CAPSULE, 0, &B, C2_TYPE_CAPSULE, 0, 0, 0, 1, 0, 0))\r\n   535\t\t\treturn 0;\r\n   536\t\treturn 1;\r\n   537\t}\r\n   538\t\r\n   539\tint c2CircletoCircle(c2Circle A, c2Circle B) {\r\n   540\t\tc2v c = c2Sub(B.p, A.p);\r\n   541\t\tfloat d2 = c2Dot(c, c);\r\n   542\t\tfloat r2 = A.r + B.r;\r\n   543\t\tr2 = r2 * r2;\r\n   544\t\treturn d2 < r2;\r\n   545\t}\r\n   546\t\r\n   547\tint c2CircletoAABB(c2Circle A, c2AABB B) {\r\n   548\t\tc2v L = c2Clampv(A.p, B.min, B.max);\r\n   549\t\tc2v ab = c2Sub(A.p, L);\r\n   550\t\tfloat d2 = c2Dot(ab, ab);\r\n   551\t\tfloat r2 = A.r * A.r;\r\n   552\t\treturn d2 < r2;\r\n   553\t}\r\n   554\t\r\n   555\tint c2CircletoCapsule(c2Circle A, c2Capsule B) {\r\n   556\t\tc2v n = c2Sub(B.b, B.a);\r\n   557\t\tc2v ap = c2Sub(A.p, B.a);\r\n   558\t\tfloat da = c2Dot(ap, n);\r\n   559\t\tfloat d2;\r\n   560\t\tif (da < 0)\r\n   561\t\t\td2 = c2Dot(ap, ap);\r\n   562\t\telse {\r\n   563\t\t\tfloat db = c2Dot(c2Sub(A.p, B.b), n);\r\n   564\t\t\tif (db < 0) {\r\n   565\