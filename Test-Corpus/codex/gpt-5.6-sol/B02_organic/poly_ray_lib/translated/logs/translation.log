{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport math\nimport os\nimport random\nimport struct\n\nROOT = os.getcwd()\nc = C.CDLL(os.path.join(ROOT, 'reference_c_build/libtranslated_rust.so'))\nr = C.CDLL(os.path.join(ROOT, 'target/release/libtranslated_rust.so'))\n\nclass V(C.Structure):\n    _fields_ = [('x', C.c_float), ('y', C.c_float)]\nclass Raycast(C.Structure):\n    _fields_ = [('t', C.c_float), ('n', V)]\nclass Rot(C.Structure):\n    _fields_ = [('c', C.c_float), ('s', C.c_float)]\nclass X(C.Structure):\n    _fields_ = [('p', V), ('r', Rot)]\nclass Circle(C.Structure):\n    _fields_ = [('p', V), ('r', C.c_float)]\nclass AABB(C.Structure):\n    _fields_ = [('min', V), ('max', V)]\nclass Capsule(C.Structure):\n    _fields_ = [('a', V), ('b', V), ('r', C.c_float)]\nclass Poly(C.Structure):\n    _fields_ = [('count', C.c_int), ('verts', V * 8), ('norms', V * 8)]\nclass Ray(C.Structure):\n    _fields_ = [('p', V), ('d', V), ('t', C.c_float)]\nclass M(C.Structure):\n    _fields_ = [('x', V), ('y', V)]\n\nsigs = {\n    'c2V': ([C.c_float, C.c_float], V),\n    'c2Dot': ([V, V], C.c_float),\n    'c2Len': ([V], C.c_float),\n    'c2Add': ([V, V], V),\n    'c2Sub': ([V, V], V),\n    'c2Mulvs': ([V, C.c_float], V),\n    'c2Div': ([V, C.c_float], V),\n    'c2Norm': ([V], V),\n    'c2Minv': ([V, V], V),\n    'c2Maxv': ([V, V], V),\n    'c2Skew': ([V], V),\n    'c2Absv': ([V], V),\n    'c2RaytoCircle': ([Ray, Circle, C.POINTER(Raycast)], C.c_int),\n    'c2AABBtoAABB': ([AABB, AABB], C.c_int),\n    'c2RaytoAABB': ([Ray, AABB, C.POINTER(Raycast)], C.c_int),\n    'c2CCW90': ([V], V),\n    'c2MulmvT': ([M, V], V),\n    'c2AABBtoPoint': ([AABB, V], C.c_int),\n    'c2CircleToPoint': ([Circle, V], C.c_int),\n    'c2RaytoCapsule': ([Ray, Capsule, C.POINTER(Raycast)], C.c_int),\n    'c2RotIdentity': ([], Rot),\n    'c2xIdentity': ([], X),\n    'c2Mulrv': ([Rot, V], V),\n    'c2MulrvT': ([Rot, V], V),\n    'c2MulxvT': ([X, V], V),\n    'c2RaytoPoly': ([Ray, C.POINTER(Poly), C.POINTER(X), C.POINTER(Raycast)], C.c_int),\n    'c2CastRay': ([Ray, C.c_void_p, C.POINTER(X), C.c_int, C.POINTER(Raycast)], C.c_int),\n    'poly_ray': ([C.POINTER(Raycast), C.POINTER(Raycast)], C.c_int),\n}\nfor lib in (c, r):\n    for name, (args, result) in sigs.items():\n        fn = getattr(lib, name)\n        fn.argtypes = args\n        fn.restype = result\n\nF = lambda value: C.c_float(value).value\nrng = random.Random(0xC2CA57)\nchecked = {name: 0 for name in sigs}\n\ndef raw(value):\n    if isinstance(value, float):\n        return struct.pack('=f', value)\n    if isinstance(value, int):\n        return struct.pack('=i', value)\n    return C.string_at(C.byref(value), C.sizeof(value))\n\ndef same(name, args):\n    cv = getattr(c, name)(*args)\n    rv = getattr(r, name)(*args)\n    if raw(cv) \"'!= raw(rv):\n        raise AssertionError(f'\"'{name}: {raw(cv).hex()} \"'!= {raw(rv).hex()}'\"')\n    checked[name] += 1\n\ndef v(scale=30.0):\n    return V(F(rng.uniform(-scale, scale)), F(rng.uniform(-scale, scale)))\ndef nonzero(scale=30.0):\n    value = F(rng.uniform(-scale, scale))\n    return value if value \"'!= 0.0 else F(1.0)\ndef ray():\n    return Ray(v(), v(2.0), F(rng.uniform(0.0, 30.0)))\ndef aabb():\n    a, b = v(), v()\n    return AABB(V(min(a.x,b.x), min(a.y,b.y)), V(max(a.x,b.x), max(a.y,b.y)))\ndef circle():\n    return Circle(v(), F(rng.uniform(0.0, 15.0)))\ndef capsule():\n    a = v()\n    b = v()\n    if a.x == b.x and a.y == b.y:\n        b.x = F(b.x + 1.0)\n    return Capsule(a, b, F(rng.uniform(0.0, 8.0)))\ndef rot():\n    angle = rng.uniform(-10.0, 10.0)\n    return Rot(F(math.cos(angle)), F(math.sin(angle)))\ndef transform():\n    return X(v(), rot())\ndef box_poly():\n    xmin, xmax = sorted((F(rng.uniform(-20, 0)), F(rng.uniform(0, 20))))\n    ymin, ymax = sorted((F(rng.uniform(-20, 0)), F(rng.uniform(0, 20))))\n    p = Poly()\n    p.count = 4\n    p.verts[0], p.norms[0] = V(xmax,ymin), V(1,0)\n    p.verts[1], p.norms[1] = V(xmax,ymax), V(0,1)\n    p.verts[2], p.norms[2] = V(xmin,ymax), V(-1,0)\n    p.verts[3], p.norms[3] = V(xmin,ymin), V(0,-1)\n    return p\n\ndef raycast_pair_call(name, fixed_args):\n    co = Raycast(F(123.25), V(F(-91.5), F(77.75)))\n    ro = Raycast(F(123.25), V(F(-91.5), F(77.75)))\n    cr = getattr(c, name)(*fixed_args, C.byref(co))\n    rr = getattr(r, name)(*fixed_args, C.byref(ro))\n    if cr != rr or raw(co) != raw(ro):\n        raise AssertionError(f'\"'{name}: ret {cr}/{rr}, out {raw(co).hex()}/{raw(ro).hex()}')\n    checked[name] += 1\n\nedge = [F(0.0), F(-0.0), F(1.0), F(-1.0), F(1e-30), F(-1e-30), F(1e20), F(-1e20)]\nfor x in edge:\n    for y in edge:\n        same('c2V', [x, y])\n        a, b = V(x,y), V(y,x)\n        for name in ('c2Dot','c2Add','c2Sub','c2Minv','c2Maxv'):\n            same(name, [a,b])\n        for name in ('c2Skew','c2Absv','c2CCW90'):\n            same(name, [a])\n\nfor _ in range(2000):\n    a, b = v(), v()\n    scalar = nonzero()\n    for name in ('c2Dot','c2Add','c2Sub','c2Minv','c2Maxv'):\n        same(name, [a,b])\n    for name in ('c2Len','c2Norm','c2Skew','c2Absv','c2CCW90'):\n        same(name, [a])\n    same('c2Mulvs', [a, scalar])\n    same('c2Div', [a, scalar])\n    mm = M(v(), v())\n    same('c2MulmvT', [mm, a])\n    rr = rot()\n    same('c2Mulrv', [rr, a])\n    same('c2MulrvT', [rr, a])\n    same('c2MulxvT', [transform(), a])\n    aa, bb = aabb(), aabb()\n    same('c2AABBtoAABB', [aa, bb])\n    same('c2AABBtoPoint', [aa, a])\n    cc = circle()\n    same('c2CircleToPoint', [cc, a])\n    raycast_pair_call('c2RaytoCircle', [ray(), cc])\n    raycast_pair_call('c2RaytoAABB', [ray(), aa])\n    cap = capsule()\n    raycast_pair_call('c2RaytoCapsule', [ray(), cap])\n    pp = box_poly()\n    bx = transform()\n    raycast_pair_call('c2RaytoPoly', [ray(), C.byref(pp), C.byref(bx)])\n    raycast_pair_call('c2RaytoPoly', [ray(), C.byref(pp), None])\n\n    for kind, obj in ((0, cc), (1, aa), (2, cap), (3, pp)):\n        co = Raycast(F(123.25), V(F(-91.5), F(77.75)))\n        ro = Raycast(F(123.25), V(F(-91.5), F(77.75)))\n        q = ray()\n        cp = C.cast(C.byref(obj), C.c_void_p)\n        rp = C.cast(C.byref(obj), C.c_void_p)\n        cr = c.c2CastRay(q, cp, C.byref(bx), kind, C.byref(co))\n        rrval = r.c2CastRay(q, rp, C.byref(bx), kind, C.byref(ro))\n        if cr \"'!= rrval or raw(co) != raw(ro):\n            raise AssertionError(f'\"'c2CastRay[{kind}]: {cr}/{rrval}, {raw(co).hex()}/{raw(ro).hex()}')\n        checked['c2CastRay'] += 1\n\nsame('c2RotIdentity', [])\nsame('c2xIdentity', [])\n# Invalid dispatch must return before touching the null shape pointer.\nco, ro = Raycast(), Raycast()\ncr = c.c2CastRay(ray(), None, None, 99, C.byref(co))\nrr = r.c2CastRay(ray(), None, None, 99, C.byref(ro))\nassert cr == rr == 0\nchecked['c2CastRay'] += 1\n\nca1, ca2 = Raycast(), Raycast()\nra1, ra2 = Raycast(), Raycast()\ncr = c.poly_ray(C.byref(ca1), C.byref(ca2))\nrr = r.poly_ray(C.byref(ra1), C.byref(ra2))\nassert cr == rr and raw(ca1) == raw(ra1) and raw(ca2) == raw(ra2)\nchecked['poly_ray'] += 1\n\nmissing = [name for name, count in checked.items() if count == 0]\nassert not missing, missing\nprint(f'PASS: all {len(checked)} exports exercised; {sum(checked.values())} bitwise comparisons')\nfor name in sorted(checked):\n    print(f'{name} {checked[name]}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
