 0;\n    41\t    for (int i = 0; i < MAX_NODES; i++) {\n    42\t        graph->nodes[i] = NULL;\n    43\t    }\n    44\t    \n    45\t    return graph;\n    46\t}\n    47\t\n    48\t// Add a node to the graph\n    49\tnode_t* add_node(graph_t *graph, const char *city_name) {\n    50\t    if (!graph || !city_name) {\n    51\t        fprintf(stderr, \"Error: NULL parameter in add_node\\n\");\n    52\t        return NULL;\n    53\t    }\n    54\t    \n    55\t    if (graph->node_count >= MAX_NODES) {\n    56\t        fprintf(stderr, \"Error: Graph is full (max %d nodes)\\n\", MAX_NODES);\n    57\t        return NULL;\n    58\t    }\n    59\t    \n    60\t    // Check if node already exists\n    61\t    for (int i = 0; i < graph->node_count; i++) {\n    62\t        if (strcmp(graph->nodes[i]->city_name, city_name) == 0) {\n    63\t            fprintf(stderr, \"Error: Node '%s' already exists\\n\", city_name);\n    64\t            return NULL;\n    65\t        }\n    66\t    }\n    67\t    \n    68\t    // Allocate new node\n    69\t    node_t *node = malloc(sizeof(node_t));\n    70\t    if (!node) {\n    71\t        fprintf(stderr, \"Error: Failed to allocate node\\n\");\n    72\t        return NULL;\n    73\t    }\n    74\t    \n    75\t    // Initialize node\n    76\t    strncpy(node->city_name, city_name, MAX_CITY_NAME - 1);\n    77\t    node->city_name[MAX_CITY_NAME - 1] = '\\0';\n    78\t    node->ref_count = 1;\n    79\t    node->edge_count = 0;\n    80\t    \n    81\t    // Add to graph\n    82\t    graph->nodes[graph->node_count++] = node;\n    83\t    \n    84\t    return node;\n    85\t}\n    86\t\n    87\t// Add an edge between two nodes\n    88\tint add_edge(node_t *from, node_t *to, int distance) {\n    89\t    if (!from || !to) {\n    90\t        fprintf(stderr, \"Error: NULL node in add_edge\\n\");\n    91\t        return -1;\n    92\t    }\n    93\t    \n    94\t    if (from->edge_count >= MAX_EDGES) {\n    95\t        fprintf(stderr, \"Error: Node '%s' has maximum edges\\n\", from->city_name);\n    96\t        return -1;\n    97\t    }\n    98\t    \n    99\t    if (distance < 0) {\n   100\t        fprintf(stderr, \"Error: Negative distance not allowed\\n\");\n   101\t        return -1;\n   102\t    }\n   103\t    \n   104\t    // Check for duplicate edge\n   105\t    for (int i = 0; i < from->edge_count; i++) {\n   106\t        if (from->edges[i].destination == to) {\n   107\t            fprintf(stderr, \"Error: Edge already exists\\n\");\n   108\t            return -1;\n   109\t        }\n   110\t    }\n   111\t    \n   112\t    // Add edge\n   113\t    from->edges[from->edge_count].destination = to;\n   114\t    from->edges[from->edge_count].distance = distance;\n   115\t    from->edge_count++;\n   116\t    \n   117\t    return 0;\n   118\t}\n   119\t\n   120\t// Delete a node (decrement ref count, free if 0)\n   121\tvoid delete_node(node_t *node) {\n   122\t    if (!node) {\n   123\t        return;\n   124\t    }\n   125\t    \n   126\t    node->ref_count--;\n   127\t    \n   128\t    if (node->ref_count == 0) {\n   129\t        free(node);\n   130\t    }\n   131\t}\n   132\t\n   133\t// Helper function to increment ref count recursively\n   134\tstatic void increment_refs_recursive(node_t *node, node_t **visited, int *visited_count) {\n   135\t    if (!node) {\n   136\t        return;\n   137\t    }\n   138\t    \n   139\t    // Check if already visited\n   140\t    for (int i = 0; i < *visited_count; i++) {\n   141\t        if (visited[i] == node) {\n   142\t            return;\n   143\t        }\n   144\t    }\n   145\t    \n   146\t    // Mark as visited\n   147\t    if (*visited_count < MAX_NODES) {\n   148\t        visited[(*visited_count)++] = node;\n   149\t    }\n   150\t    \n   151\t    // Increment ref count\n   152\t    node->ref_count++;\n   153\t    \n   154\t    // Recursively process all connected nodes\n   155\t    for (int i = 0; i < node->edge_count; i++) {\n   156\t        increment_refs_recursive(node->edges[i].destination, visited, visited_count);\n   157\t    }\n   158\t}\n   159\t\n   160\t// Create shallow copy of subsection (increments ref counts)\n   161\tnode_t* shallow_copy(node_t *start) {\n   162\t    if (!start) {\n   163\t        fprintf(stderr, \"Error: NULL node in shallow_copy\\n\");\n   164\t        return NULL;\n   165\t    }\n   166\t    \n   167\t    // Track visited nodes to avoid cycles\n   168\t    node_t *visited[MAX_NODES];\n   169\t    int visited_count = 0;\n   170\t    \n   171\t    // Increment ref counts for all reachable nodes\n   172\t    increment_refs_recursive(start, visited, &visited_count);\n   173\t    \n   174\t    return start;\n   175\t}\n   176\t\n   177\t// Helper structure for shortest path algorithm\n   178\ttypedef struct {\n   179\t    node_t *node;\n   180\t    int distance;\n   181\t    node_t *previous;\n   182\t    int visited;\n   183\t} dijkstra_node_t;\n   184\t\n   185\t// Find shortest path using Dijkstra's algorithm\n   186\tnode_t** find_shortest_path(node_t *start, node_t *end, int *path_length) {\n   187\t    if (!start || !end || !path_length) {\n   188\t        fprintf(stderr, \"Error: NULL parameter in find_shortest_path\\n\");\n   189\t        return NULL;\n   190\t    }\n   191\t    \n   192\t    // Initialize Dijkstra state\n   193\t    dijkstra_node_t state[MAX_NODES];\n   194\t    int state_count = 0;\n   195\t    \n   196\t    // Add start node\n   197\t    state[state_count].node = start;\n   198\t    state[state_count].distance = 0;\n   199\t    state[state_count].previous = NULL;\n   200\t    state[state_count].visited = 0;\n   201\t    state_count++;\n   202\t    \n   203\t    node_t *current = start;\n   204\t    \n   205\t    while (current) {\n   206\t        // Find current node in state\n   207\t        int current_idx = -1;\n   208\t        for (int i = 0; i < state_count; i++) {\n   209\t            if (state[i].node == current) {\n   210\t                current_idx = i;\n   211\t                break;\n   212\t            }\n   213\t        }\n   214\t        \n   215\t        if (current_idx == -1) {\n   216\t            break;\n   217\t        }\n   218\t        \n   219\t        state[current_idx].visited = 1;\n   220\t        \n   221\t        // Check if we reached the end\n   222\t        if (current == end) {\n   223\t            break;\n   224\t        }\n   225\t        \n   226\t        // Update distances for neighbors\n   227\t        for (int i = 0; i < current->edge_count; i++) {\n   228\t            node_t *neighbor = current->edges[i].destination;\n   229\t            int new_distance = state[current_idx].distance + current->edges[i].distance;\n   230\t            \n   231\t            // Find or add neighbor in state\n   232\t            int neighbor_idx = -1;\n   233\t            for (int j = 0; j < state_count; j++) {\n   234\t                if (state[j].node == neighbor) {\n   235\t                    neighbor_idx = j;\n   236\t                    break;\n   237\t                }\n   238\t            }\n   239\t            \n   240\t            if (neighbor_idx == -1 && state_count < MAX_NODES) {\n   241\t                // Add new neighbor\n   242\t                neighbor_idx = state_count;\n   243\t                state[state_count].node = neighbor;\n   244\t                state[state_count].distance = INT_MAX;\n   245\t                state[state_count].previous = NULL;\n   246\t                state[state_count].visited = 0;\n   247\t                state_count++;\n   248\t            }\n   249\t            \n   250\t            if (neighbor_idx != -1 && new_distance < state[neighbor_idx].distance) {\n   251\t                state[neighbor_idx].distance = new_distance;\n   252\t                state[neighbor_idx].previous = current;\n   253\t            }\n   254\t        }\n   255\t        \n   256\t        // Find next unvisited node with minimum distance\n   257\t        int min_distance = INT_MAX;\n   258\t        current = NULL;\n   259\t        for (int i = 0; i < state_count; i++) {\n   260\t            if (!state[i].visited && state[i].distance < min_distance) {\n   261\t                min_distance = state[i].distance;\n   262\t                current = state[i].node;\n   263\t            }\n   264\t        }\n   265\t    }\n   266\t    \n   267\t    // Find end node in state\n   268\t    int end_idx = -1;\n   269\t    for (int i = 0; i < state_count; i++) {\n   270\t        if (state[i].node == end) {\n   271\t            end_idx = i;\n   272\t            break;\n   273\t        }\n   274\t    }\n   275\t    \n   276\t    if (end_idx == -1 || state[end_idx].distance == INT_MAX) {\n   277\t        fprintf(stderr, \"No path found\\n\");\n   278\t        *path_length = 0;\n   279\t        return NULL;\n   280\t    }\n   281\t    \n   282\t    // Reconstruct path\n   283\t    node_t *path[MAX_NODES];\n   284\t    int count = 0;\n   285\t    node_t *current_node = end;\n   286\t    \n   287\t    while (current_node) {\n   288\t        path[count++] = current_node;\n   289\t        \n   290\t        // Find previous node\n   291\t        int current_state_idx = -1;\n   292\t        for (int i = 0; i < state_count; i++) {\n   293\t            if (state[i].node == current_node) {\n   294\t                current_state_idx = i;\n   295\t                break;\n   296\t            }\n   297\t        }\n   298\t        \n   299\t        if (current_state_idx == -1) {\n   300\t            break;\n   301\t        }\n   302\t        \n   303\t        current_node = state[current_state_idx].previous;\n   304\t    }\n   305\t    \n   306\t    // Reverse path\n   307\t    node_t **result = malloc(sizeof(node_t*) * count);\n   308\t    if (!result) {\n   309\t        fprintf(stderr, \"Error: Failed to allocate path\\n\");\n   310\t        *path_length = 0;\n   311\t        return NULL;\n   312\t    }\n   313\t    \n   314\t    for (int i = 0; i < count; i++) {\n   315\t        result[i] = path[count - 1 - i];\n   316\t    }\n   317\t    \n   318\t    *path_length = count;\n   319\t    return result;\n   320\t}\n   321\t\n   322\t// Get node by city name\n   323\tnode_t* get_node_by_name(graph_t *graph, const char *city_name) {\n   324\t    if (!graph || !city_name) {\n   325\t        return NULL;\n   326\t    }\n   327\t    \n   328\t    for (int i = 0; i < graph->node_count; i++) {\n   329\t        if (strcmp(graph->nodes[i]->city_name, city_name) == 0) {\n   330\t            return graph->nodes[i];\n   331\t        }\n   332\t    }\n   333\t    \n   334\t    return NULL;\n   335\t}\n   336\t\n   337\t// Print node information\n   338\tvoid print_node(node_t *node) {\n   339\t    if (!node) {\n   340\t        printf(\"NULL node\\n\");\n   341\t        return;\n   342\t    }\n   343\t    \n   344\t    printf(\"City: %s (ref_count: %d)\\n\", node->city_name, node->ref_count);\n   345\t    printf(\"  Edges:\\n\");\n   346\t    for (int i = 0; i < node->edge_count; i++) {\n   347\t        printf(\"    -> %s (distance: %d)\\n\", \n   348\t               node->edges[i].destination->city_name,\n   349\t               node->edges[i].distance);\n   350\t    }\n   351\t}\n   352\t\n   353\t// Print entire graph\n   354\tvoid print_graph(graph_t *graph) {\n   355\t    if (!graph) {\n   356\t        printf(\"NULL graph\\n\");\n   357\t        return;\n   358\t    }\n   359\t    \n   360\t    printf(\"Graph with %d nodes:\\n\", graph->node_count);\n   361\t    for (int i = 0; i < graph->node_count; i++) {\n   362\t        print_node(graph->nodes[i]);\n   363\t    }\n   364\t}\n   365\t\n   366\t// Free the entire graph\n   367\tvoid free_graph(graph_t *graph) {\n   368\t    if (!graph) {\n   369\t        return;\n   370\t    }\n   371\t    \n   372\t    // Decrement ref count for all nodes\n   373\t    for (int i = 0; i < graph->node_count; i++) {\n   374\t        delete_node(graph->nodes[i]);\n   375\t    }\n   376\t    \n   377\t    free(graph);\n   378\t}\n","exit_code":0,"status":"completed"}}
