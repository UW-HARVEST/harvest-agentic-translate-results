5. Find shortest path\\n\");\n    40\t    printf(\"6. Make shallow copy of subsection\\n\");\n    41\t    printf(\"7. Delete node\\n\");\n    42\t    printf(\"8. Exit\\n\");\n    43\t    printf(\"Choice: \");\n    44\t}\n    45\t\n    46\tint main(void) {\n    47\t    graph_t *graph = create_graph();\n    48\t    if (!graph) {\n    49\t        fprintf(stderr, \"Failed to create graph\\n\");\n    50\t        return 1;\n    51\t    }\n    52\t    \n    53\t    char input[MAX_INPUT];\n    54\t    int choice;\n    55\t    \n    56\t    printf(\"City Route Management System\\n\");\n    57\t    printf(\"Commands are read from stdin\\n\");\n    58\t    \n    59\t    while (1) {\n    60\t        print_menu();\n    61\t        \n    62\t        if (fgets(input, MAX_INPUT, stdin) == NULL) {\n    63\t            break;\n    64\t        }\n    65\t        \n    66\t        if (sscanf(input, \"%d\", &choice) != 1) {\n    67\t            printf(\"Invalid input\\n\");\n    68\t            continue;\n    69\t        }\n    70\t        \n    71\t        switch (choice) {\n    72\t            case 1: {\n    73\t                // Add city\n    74\t                printf(\"Enter city name: \");\n    75\t                if (fgets(input, MAX_INPUT, stdin) == NULL) {\n    76\t                    break;\n    77\t                }\n    78\t                \n    79\t                // Remove newline\n    80\t                input[strcspn(input, \"\\n\")] = 0;\n    81\t                \n    82\t                node_t *node = add_node(graph, input);\n    83\t                if (node) {\n    84\t                    printf(\"Added city: %s\\n\", input);\n    85\t                } else {\n    86\t                    printf(\"Failed to add city\\n\");\n    87\t                }\n    88\t                break;\n    89\t            }\n    90\t            \n    91\t            case 2: {\n    92\t                // Add route\n    93\t                char from_city[MAX_INPUT], to_city[MAX_INPUT];\n    94\t                int distance;\n    95\t                \n    96\t                printf(\"Enter from city: \");\n    97\t                if (fgets(from_city, MAX_INPUT, stdin) == NULL) {\n    98\t                    break;\n    99\t                }\n   100\t                from_city[strcspn(from_city, \"\\n\")] = 0;\n   101\t                \n   102\t                printf(\"Enter to city: \");\n   103\t                if (fgets(to_city, MAX_INPUT, stdin) == NULL) {\n   104\t                    break;\n   105\t                }\n   106\t                to_city[strcspn(to_city, \"\\n\")] = 0;\n   107\t                \n   108\t                printf(\"Enter distance: \");\n   109\t                if (fgets(input, MAX_INPUT, stdin) == NULL) {\n   110\t                    break;\n   111\t                }\n   112\t                if (sscanf(input, \"%d\", &distance) != 1) {\n   113\t                    printf(\"Invalid distance\\n\");\n   114\t                    break;\n   115\t                }\n   116\t                \n   117\t                node_t *from = get_node_by_name(graph, from_city);\n   118\t                node_t *to = get_node_by_name(graph, to_city);\n   119\t                \n   120\t                if (!from) {\n   121\t                    printf(\"City '%s' not found\\n\", from_city);\n   122\t                    break;\n   123\t                }\n   124\t                if (!to) {\n   125\t                    printf(\"City '%s' not found\\n\", to_city);\n   126\t                    break;\n   127\t                }\n   128\t                \n   129\t                if (add_edge(from, to, distance) == 0) {\n   130\t                    printf(\"Added route: %s -> %s (distance: %d)\\n\", \n   131\t                           from_city, to_city, distance);\n   132\t                } else {\n   133\t                    printf(\"Failed to add route\\n\");\n   134\t                }\n   135\t                break;\n   136\t            }\n   137\t            \n   138\t            case 3: {\n   139\t                // Show all cities\n   140\t                print_graph(graph);\n   141\t                break;\n   142\t            }\n   143\t            \n   144\t            case 4: {\n   145\t                // Show city details\n   146\t                printf(\"Enter city name: \");\n   147\t                if (fgets(input, MAX_INPUT, stdin) == NULL) {\n   148\t                    break;\n   149\t                }\n   150\t                input[strcspn(input, \"\\n\")] = 0;\n   151\t                \n   152\t                node_t *node = get_node_by_name(graph, input);\n   153\t                if (node) {\n   154\t                    print_node(node);\n   155\t                } else {\n   156\t                    printf(\"City '%s' not found\\n\", input);\n   157\t                }\n   158\t                break;\n   159\t            }\n   160\t            \n   161\t            case 5: {\n   162\t                // Find shortest path\n   163\t                char start_city[MAX_INPUT], end_city[MAX_INPUT];\n   164\t                \n   165\t                printf(\"Enter start city: \");\n   166\t                if (fgets(start_city, MAX_INPUT, stdin) == NULL) {\n   167\t                    break;\n   168\t                }\n   169\t                start_city[strcspn(start_city, \"\\n\")] = 0;\n   170\t                \n   171\t                printf(\"Enter end city: \");\n   172\t                if (fgets(end_city, MAX_INPUT, stdin) == NULL) {\n   173\t                    break;\n   174\t                }\n   175\t                end_city[strcspn(end_city, \"\\n\")] = 0;\n   176\t                \n   177\t                node_t *start = get_node_by_name(graph, start_city);\n   178\t                node_t *end = get_node_by_name(graph, end_city);\n   179\t                \n   180\t                if (!start) {\n   181\t                    printf(\"City '%s' not found\\n\", start_city);\n   182\t                    break;\n   183\t                }\n   184\t                if (!end) {\n   185\t                    printf(\"City '%s' not found\\n\", end_city);\n   186\t                    break;\n   187\t                }\n   188\t                \n   189\t                int path_length;\n   190\t                node_t **path = find_shortest_path(start, end, &path_length);\n   191\t                \n   192\t                if (path) {\n   193\t                    printf(\"Shortest path from %s to %s:\\n\", start_city, end_city);\n   194\t                    for (int i = 0; i < path_length; i++) {\n   195\t                        printf(\"  %d. %s\\n\", i + 1, path[i]->city_name);\n   196\t                    }\n   197\t                    free(path);\n   198\t                } else {\n   199\t                    printf(\"No path found\\n\");\n   200\t                }\n   201\t                break;\n   202\t            }\n   203\t            \n   204\t            case 6: {\n   205\t                // Make shallow copy\n   206\t                printf(\"Enter start city for shallow copy: \");\n   207\t                if (fgets(input, MAX_INPUT, stdin) == NULL) {\n   208\t                    break;\n   209\t                }\n   210\t                input[strcspn(input, \"\\n\")] = 0;\n   211\t                \n   212\t                node_t *node = get_node_by_name(graph, input);\n   213\t                if (!node) {\n   214\t                    printf(\"City '%s' not found\\n\", input);\n   215\t                    break;\n   216\t                }\n   217\t                \n   218\t                node_t *copy = shallow_copy(node);\n   219\t                if (copy) {\n   220\t                    printf(\"Created shallow copy starting from %s\\n\", input);\n   221\t                    printf(\"Reference counts incremented for all reachable nodes\\n\");\n   222\t                    print_node(copy);\n   223\t                } else {\n   224\t                    printf(\"Failed to create shallow copy\\n\");\n   225\t                }\n   226\t                break;\n   227\t            }\n   228\t            \n   229\t            case 7: {\n   230\t                // Delete node\n   231\t                printf(\"Enter city name to delete: \");\n   232\t                if (fgets(input, MAX_INPUT, stdin) == NULL) {\n   233\t                    break;\n   234\t                }\n   235\t                input[strcspn(input, \"\\n\")] = 0;\n   236\t                \n   237\t                node_t *node = get_node_by_name(graph, input);\n   238\t                if (!node) {\n   239\t                    printf(\"City '%s' not found\\n\", input);\n   240\t                    break;\n   241\t                }\n   242\t                \n   243\t                printf(\"Current ref count: %d\\n\", node->ref_count);\n   244\t                delete_node(node);\n   245\t                printf(\"Decremented reference count for %s\\n\", input);\n   246\t                printf(\"Note: Node will be freed when ref count reaches 0\\n\");\n   247\t                break;\n   248\t            }\n   249\t            \n   250\t            case 8: {\n   251\t                // Exit\n   252\t                printf(\"Freeing graph and exiting...\\n\");\n   253\t                free_graph(graph);\n   254\t                return 0;\n   255\t            }\n   256\t            \n   257\t            default:\n   258\t                printf(\"Invalid choice\\n\");\n   259\t                break;\n   260\t        }\n   261\t    }\n   262\t    \n   263\t    free_graph(graph);\n   264\t    return 0;\n   265\t}\n","exit_code":0,"status":"completed"}}
