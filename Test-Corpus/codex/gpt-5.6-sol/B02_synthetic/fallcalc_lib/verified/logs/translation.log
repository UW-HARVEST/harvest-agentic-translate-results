{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport math\nimport random\nimport struct\n\nc = ctypes.CDLL('./reference_c_build/libtranslated_rust.so')\nr = ctypes.CDLL('./target/release/libtranslated_rust.so')\n\nfor lib in (c, r):\n    lib.safe_double_to_int.argtypes = [ctypes.c_double]\n    lib.safe_double_to_int.restype = ctypes.c_int\n    lib.process_array_reverse.argtypes = [ctypes.POINTER(ctypes.c_int), ctypes.c_int]\n    lib.process_array_reverse.restype = ctypes.c_int\n    lib.switch_fallthrough_calculator.argtypes = [ctypes.c_int, ctypes.c_int]\n    lib.switch_fallthrough_calculator.restype = ctypes.c_int\n    lib.allocate_and_compute.argtypes = [ctypes.c_int, ctypes.c_double]\n    lib.allocate_and_compute.restype = ctypes.c_int\n    lib.foreach_sum.argtypes = [ctypes.POINTER(ctypes.c_int), ctypes.c_int]\n    lib.foreach_sum.restype = ctypes.c_int\n    lib.fallcalc.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int]\n    lib.fallcalc.restype = ctypes.c_int\n\ndef check(name, args, cv, rv):\n    if cv \"'!= rv:\n        raise AssertionError(f'\"'{name}{args}: C={cv}, Rust={rv}')\n\nfloat_cases = [\n    float('nan'), float('inf'), float('-inf'), -0.0, 0.0,\n    0.9999999999999999, -0.9999999999999999,\n    2147483646.9999998, 2147483647.0, 2147483648.0,\n    -2147483647.9999998, -2147483648.0, -2147483649.0,\n    5e-324, -5e-324,\n]\nrng = random.Random(0xC0DEC0DE)\nfor _ in range(20000):\n    float_cases.append(struct.unpack('d', rng.getrandbits(64).to_bytes(8, 'little'))[0])\nfor value in float_cases:\n    check('safe_double_to_int', (value,), c.safe_double_to_int(value), r.safe_double_to_int(value))\n\nint_values = [-2147483648, -1000000, -513, -512, -1, 0, 1, 127, 128, 511, 512, 1000000, 2147483647]\nfor value in int_values:\n    for operation in range(-8, 9):\n        check('switch_fallthrough_calculator', (value, operation),\n              c.switch_fallthrough_calculator(value, operation),\n              r.switch_fallthrough_calculator(value, operation))\n\nfor count in range(0, 65):\n    values = [rng.randint(-1000000, 1000000) for _ in range(max(count, 1))]\n    array = (ctypes.c_int * len(values))(*values)\n    check('foreach_sum', (values, count), c.foreach_sum(array, count), r.foreach_sum(array, count))\n    end = ctypes.cast(ctypes.byref(array, (max(count, 1) - 1) * ctypes.sizeof(ctypes.c_int)), ctypes.POINTER(ctypes.c_int))\n    check('process_array_reverse', (values, count), c.process_array_reverse(end, count), r.process_array_reverse(end, count))\nfor count in (-2147483648, -100, -1):\n    array = (ctypes.c_int * 1)(123)\n    check('foreach_sum', (count,), c.foreach_sum(array, count), r.foreach_sum(array, count))\n    check('process_array_reverse', (count,), c.process_array_reverse(array, count), r.process_array_reverse(array, count))\n\nmultipliers = [float('nan'), float('inf'), float('-inf'), -1000.5, -1.5, -0.0, 0.0, 1.5, 3.7, 1e100]\nfor size in list(range(-20, 101)):\n    for multiplier in multipliers:\n        check('allocate_and_compute', (size, multiplier),\n              c.allocate_and_compute(size, multiplier),\n              r.allocate_and_compute(size, multiplier))\n\nfallcalc_cases = [\n    (0, 0, 0, 0), (1, 2, 3, 4), (-1, -2, -3, -4),\n    (127, 128, 129, 9), (-1000, 1000, 257, -19),\n    (2147483647, 0, 0, 0), (-2147483648, 0, 0, 0),\n]\nfor _ in range(100000):\n    fallcalc_cases.append(tuple(rng.randint(-2147483648, 2147483647) for _ in range(4)))\nfor args in fallcalc_cases:\n    check('fallcalc', args, c.fallcalc(*args), r.fallcalc(*args))\n\nprint(f'PASS safe_double_to_int: {len(float_cases)} cases')\nprint(f'PASS switch_fallthrough_calculator: {len(int_values) * 17} cases')\nprint('PASS foreach_sum/process_array_reverse: 136 cases')\nprint(f'PASS allocate_and_compute: {121 * len(multipliers)} cases')\nprint(f'PASS fallcalc: {len(fallcalc_cases)} cases')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
