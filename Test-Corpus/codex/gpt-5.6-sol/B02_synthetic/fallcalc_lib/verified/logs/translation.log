\\\r\n    36\t      for(item = (array)[idx]; keep; keep = !keep)\r\n    37\t\r\n    38\t#define OCTAL_MASK_1 0777\r\n    39\t#define OCTAL_MASK_2 0100\r\n    40\t#define OCTAL_FLAG   0200\r\n    41\t#define OCTAL_BASE   010\r\n    42\t\r\n    43\ttypedef struct {\r\n    44\t    int value;\r\n    45\t    double coefficient;\r\n    46\t} DataPoint;\r\n    47\t\r\n    48\tint safe_double_to_int(double d) {\r\n    49\t    if (isnan(d)) {\r\n    50\t        return 0;\r\n    51\t    }\r\n    52\t\r\n    53\t    if (isinf(d)) {\r\n    54\t        return d > 0 ? INT_MAX : INT_MIN;\r\n    55\t    }\r\n    56\t\r\n    57\t    if (d >= (double)INT_MAX) {\r\n    58\t        return INT_MAX;\r\n    59\t    }\r\n    60\t    if (d <= (double)INT_MIN) {\r\n    61\t        return INT_MIN;\r\n    62\t    }\r\n    63\t\r\n    64\t    return (int)d;\r\n    65\t}\r\n    66\t\r\n    67\tint process_array_reverse(int *end, int count) {\r\n    68\t    int sum = 0;\r\n    69\t    int *ptr = end;\r\n    70\t\r\n    71\t    for (int i = 0; i < count; i++) {\r\n    72\t        sum += *ptr;\r\n    73\t        ptr--;\r\n    74\t    }\r\n    75\t\r\n    76\t    return sum;\r\n    77\t}\r\n    78\t\r\n    79\tint switch_fallthrough_calculator(int value, int operation) {\r\n    80\t    int result = value;\r\n    81\t\r\n    82\t    switch (operation) {\r\n    83\t        case 0:\r\n    84\t            result *= OCTAL_BASE;\r\n    85\t        case 1:\r\n    86\t            result += OCTAL_FLAG;\r\n    87\t        case 2:\r\n    88\t            result &= OCTAL_MASK_1;\r\n    89\t            break;\r\n    90\t        case 3:\r\n    91\t            result *= 3;\r\n    92\t        case 4:\r\n    93\t            result += OCTAL_MASK_2;\r\n    94\t            break;\r\n    95\t        default:\r\n    96\t            result = 0;\r\n    97\t    }\r\n    98\t\r\n    99\t    return result;\r\n   100\t}\r\n   101\t\r\n   102\tint allocate_and_compute(int size, double multiplier) {\r\n   103\t    DataPoint *points = (DataPoint *)malloc(size * sizeof(DataPoint));\r\n   104\t\r\n   105\t    if (points == NULL) {\r\n   106\t        return -1;\r\n   107\t    }\r\n   108\t\r\n   109\t    for (int i = 0; i < size; i++) {\r\n   110\t        points[i].value = i * OCTAL_BASE;\r\n   111\t        points[i].coefficient = (double)i * multiplier;\r\n   112\t    }\r\n   113\t\r\n   114\t    double sum = 0.0;\r\n   115\t    for (int i = 0; i < size; i++) {\r\n   116\t        sum += points[i].value * points[i].coefficient;\r\n   117\t    }\r\n   118\t\r\n   119\t    int result = safe_double_to_int(sum);\r\n   120\t\r\n   121\t    free(points);\r\n   122\t\r\n   123\t    return result;\r\n   124\t}\r\n   125\t\r\n   126\tint foreach_sum(int *array, int count) {\r\n   127\t    int total = 0;\r\n   128\t    int element;\r\n   129\t\r\n   130\t    FOREACH(element, array, count) {\r\n   131\t        total += element;\r\n   132\t    }\r\n   133\t\r\n   134\t    return total;\r\n   135\t}\r\n   136\t\r\n   137\tint fallcalc(int param1, int param2, int param3, int param4) {\r\n   138\t    int result = 0;\r\n   139\t\r\n   140\t    int base_value = param1 * OCTAL_MASK_2 + param2;\r\n   141\t\r\n   142\t    int array_size = 5;\r\n   143\t    int *data_array = (int *)malloc(array_size * sizeof(int));\r\n   144\t\r\n   145\t    if (data_array == NULL) {\r\n   146\t        return -1;\r\n   147\t    }\r\n   148\t\r\n   149\t    for (int i = 0; i < array_size; i++) {\r\n   150\t        data_array[i] = (i + 1) * OCTAL_BASE + param1;\r\n   151\t    }\r\n   152\t\r\n   153\t    int foreach_result = foreach_sum(data_array, array_size);\r\n   154\t\r\n   155\t    int *last_element = data_array + array_size - 1;\r\n   156\t    int reverse_sum = process_array_reverse(last_element, array_size);\r\n   157\t\r\n   158\t    int switch_result = switch_fallthrough_calculator(param2, param3 % 5);\r\n   159\t\r\n   160\t    double floating_calc = (double)param1 * 3.7 + (double)param2 * 2.3 - (double)param3 * 0.5;\r\n   161\t    int converted = safe_double_to_int(floating_calc);\r\n   162\t\r\n   163\t    int alloc_result = allocate_and_compute(param4 % 10 + 1, 1.5);\r\n   164\t\r\n   165\t    result = base_value + foreach_result + reverse_sum + switch_result + converted + alloc_result;\r\n   166\t\r\n   167\t    if (param3 > OCTAL_FLAG) {\r\n   168\t        result |= OCTAL_FLAG;\r\n   169\t    }\r\n   170\t\r\n   171\t    free(data_array);\r\n   172\t\r\n   173\t    result &= OCTAL_MASK_1;\r\n   174\t\r\n   175\t    return result;\r\n   176\t}\r\n","exit_code":0,"status":"completed"}}
