safe(no_mangle)]\n    52\tpub unsafe extern \"C\" fn is_string_empty(value: *const c_char) -> c_int {\n    53\t    if value.is_null() {\n    54\t        return 1;\n    55\t    }\n    56\t    if unsafe { *value } != 0 {\n    57\t        return 0;\n    58\t    }\n    59\t    1\n    60\t}\n    61\t\n    62\t#[unsafe(no_mangle)]\n    63\tpub unsafe extern \"C\" fn find_char_in_buffer(\n    64\t    buffer: *const c_char,\n    65\t    size: usize,\n    66\t    target: c_char,\n    67\t) -> *mut c_char {\n    68\t    if buffer.is_null() {\n    69\t        return std::ptr::null_mut();\n    70\t    }\n    71\t    unsafe { memchr(buffer.cast(), c_int::from(target), size).cast() }\n    72\t}\n    73\t\n    74\t#[unsafe(no_mangle)]\n    75\tpub unsafe extern \"C\" fn create_buffer(initial: *const c_char) -> *mut c_char {\n    76\t    if initial.is_null() {\n    77\t        return std::ptr::null_mut();\n    78\t    }\n    79\t\n    80\t    let length = unsafe { strlen(initial) };\n    81\t    let buffer = unsafe { malloc(length.wrapping_add(1)) }.cast::<c_char>();\n    82\t    if !buffer.is_null() {\n    83\t        unsafe {\n    84\t            strcpy(buffer, initial);\n    85\t        }\n    86\t    }\n    87\t    buffer\n    88\t}\n    89\t\n    90\t#[unsafe(no_mangle)]\n    91\tpub extern \"C\" fn validate_uint16_range(value: c_int) -> c_int {\n    92\t    if value < 0 {\n    93\t        return 0;\n    94\t    }\n    95\t    if value > c_int::from(u16::MAX) {\n    96\t        return 0;\n    97\t    }\n    98\t    1\n    99\t}\n   100\t\n   101\t#[unsafe(no_mangle)]\n   102\tpub unsafe extern \"C\" fn apply_operation(op: OperationFunc, value: c_int) -> c_int {\n   103\t    let Some(op) = op else {\n   104\t        return -1;\n   105\t    };\n   106\t    unsafe { op(value) }\n   107\t}\n   108\t\n   109\t#[unsafe(no_mangle)]\n   110\tpub unsafe extern \"C\" fn charinbuf(mode: c_int, value: c_int, opt1: c_int, opt2: c_int) -> c_int {\n   111\t    unsafe {\n   112\t        COUNT