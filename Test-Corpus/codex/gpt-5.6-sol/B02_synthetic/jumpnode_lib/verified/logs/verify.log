#define STATUS_WARNING  0001\r\n    42\t#define STATUS_ERROR    0002\r\n    43\t#define STATUS_CRITICAL 0377\r\n    44\t\r\n    45\tstatic Node* find_node_by_id(int id) {\r\n    46\t    int i;\r\n    47\t    for (i = 0; i < node_count; i++) {\r\n    48\t        if (node_storage[i].id == id) {\r\n    49\t            return &node_storage[i];\r\n    50\t        }\r\n    51\t    }\r\n    52\t    return NULL;\r\n    53\t}\r\n    54\t\r\n    55\tstatic int add_node(int id, int parent_id, double value) {\r\n    56\t    if (node_count >= MAX_NODES) {\r\n    57\t        return STATUS_ERROR;\r\n    58\t    }\r\n    59\t\r\n    60\t    node_storage[node_count].id = id;\r\n    61\t    node_storage[node_count].parent_id = parent_id;\r\n    62\t    node_storage[node_count].value = value;\r\n    63\t\r\n    64\t    node_storage[node_count].data[0] = 0100;\r\n    65\t    node_storage[node_count].data[1] = 0200;\r\n    66\t    node_storage[node_count].data[2] = 0300;\r\n    67\t    node_storage[node_count].data[3] = 0400;\r\n    68\t\r\n    69\t    node_count++;\r\n    70\t    return STATUS_OK;\r\n    71\t}\r\n    72\t\r\n    73\tstatic int process_backward(int *array, size_t size, int start_offset) {\r\n    74\t    int sum = 0;\r\n    75\t    int *ptr;\r\n    76\t    int *start;\r\n    77\t\r\n    78\t    ptr = array + size;\r\n    79\t    start = array + start_offset;\r\n    80\t\r\n    81\t    while (ptr > start) {\r\n    82\t        ptr--;\r\n    83\t        sum += *ptr;\r\n    84\t    }\r\n    85\t\r\n    86\t    return sum;\r\n    87\t}\r\n    88\t\r\n    89\tstatic int compute_size_metric(const char *str) {\r\n    90\t    size_t len = strlen(str);\r\n    91\t    int metric;\r\n    92\t\r\n    93\t    metric = (int)len;\r\n    94\t\r\n    95\t    metric = metric * 2 + 010;\r\n    96\t\r\n    97\t    return metric;\r\n    98\t}\r\n    99\t\r\n   100\tstatic int safe_double_to_int(double value) {\r\n   101\t    if (value > 2147483647.0) {\r\n   102\t        value = 2147483647.0;