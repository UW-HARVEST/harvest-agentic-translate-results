{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/scene.rs && nl -ba src/shape.rs && nl -ba src/input.rs && nl -ba src/main.rs'","aggregated_output":"     1\tuse crate::input::fscanf_i32;\n     2\tuse crate::shape::{self, ShapeManager};\n     3\tuse std::ffi::OsStr;\n     4\tuse std::fs::File;\n     5\tuse std::io::{self, Read, Write};\n     6\tuse std::os::unix::ffi::OsStrExt;\n     7\t\n     8\tconst MAX_SHAPES_IN_SCENE: usize = 50;\n     9\tconst MAX_SCENE_NAME: usize = 64;\n    10\t\n    11\tpub struct Scene {\n    12\t    pub name: Vec<u8>,\n    13\t    pub shapes: Vec<i32>,\n    14\t}\n    15\t\n    16\timpl Scene {\n    17\t    pub fn new(name: &[u8]) -> Self {\n    18\t        Self {\n    19\t            name: name[..name.len().min(MAX_SCENE_NAME - 1)].to_vec(),\n    20\t            shapes: Vec::new(),\n    21\t        }\n    22\t    }\n    23\t\n    24\t    pub fn add_shape<W: Write>(&mut self, type_id: i32, err: &mut W) -> i32 {\n    25\t        if self.shapes.len() >= MAX_SHAPES_IN_SCENE {\n    26\t            let _ = err.write_all(b\"Error: Scene is full\\n\");\n    27\t            return -1;\n    28\t        }\n    29\t        self.shapes.push(type_id);\n    30\t        0\n    31\t    }\n    32\t\n    33\t    pub fn remove_shape(&mut self, index: i32) -> i32 {\n    34\t        let Ok(index) = usize::try_from(index) else {\n    35\t            return -1;\n    36\t        };\n    37\t        if index >= self.shapes.len() {\n    38\t            return -1;\n    39\t        }\n    40\t        self.shapes.remove(index);\n    41\t        0\n    42\t    }\n    43\t}\n    44\t\n    45\tpub fn print<W: Write>(out: &mut W, scene: &Scene, manager: &ShapeManager) -> io::Result<()> {\n    46\t    out.write_all(b\"\\n=== Scene: \")?;\n    47\t    out.write_all(&scene.name)?;\n    48\t    out.write_all(b\" ===\\nContains \")?;\n    49\t    write!(out, \"{}\", scene.shapes.len())?;\n    50\t    out.write_all(b\" shape(s)\\n\\n\")?;\n    51\t\n    52\t    for (index, &type_id) in scene.shapes.iter().enumerate() {\n    53\t        writeln!(out, \"Shape #{}:\", index + 1)?;\n    54\t        shape::print(out, manager.get(type_id))?;\n    55\t        out.write_all(b\"\\n\")?;\n    56\t    }\n    57\t    Ok(())\n    58\t}\n    59\t\n    60\tpub fn list_shapes<W: Write>(out: &mut W, scene: &Scene, manager: &ShapeManager) -> io::Result<()> {\n    61\t    out.write_all(b\"\\nScene: \")?;\n    62\t    out.write_all(&scene.name)?;\n    63\t    out.write_all(b\"\\nShapes (\")?;\n    64\t    write!(out, \"{}\", scene.shapes.len())?;\n    65\t    out.write_all(b\"):\\n\")?;\n    66\t\n    67\t    for (index, &type_id) in scene.shapes.iter().enumerate() {\n    68\t        write!(out, \"  {}. \", index + 1)?;\n    69\t        out.write_all(manager.get(type_id).unwrap().name)?;\n    70\t        write!(out, \" (ptr: {:p})\\n\", manager.ptr(type_id))?;\n    71\t    }\n    72\t    Ok(())\n    73\t}\n    74\t\n    75\tpub fn equals(first: &Scene, second: &Scene) -> bool {\n    76\t    if first.shapes.len() != second.shapes.len() {\n    77\t        return false;\n    78\t    }\n    79\t\n    80\t    let mut matched = [false; MAX_SHAPES_IN_SCENE];\n    81\t    for first_type in &first.shapes {\n    82\t        let mut found = false;\n    83\t        for (index, second_type) in second.shapes.iter().enumerate() {\n    84\t            if !matched[index] && first_type == second_type {\n    85\t                matched[index] = true;\n    86\t                found = true;\n    87\t                break;\n    88\t            }\n    89\t        }\n    90\t        if !found {\n    91\t            return false;\n    92\t        }\n    93\t    }\n    94\t    true\n    95\t}\n    96\t\n    97\tpub fn save<O: Write, E: Write>(\n    98\t    scene: &Scene,\n    99\t    filename: &[u8],\n   100\t    manager: &ShapeManager,\n   101\t    out: &mut O,\n   102\t    err: &mut E,\n   103\t) -> i32 {\n   104\t    let path = OsStr::from_bytes(filename);\n   105\t    let mut file = match File::create(path) {\n   106\t        Ok(file) => file,\n   107\t        Err(_) => {\n   108\t            let _ = err.write_all(b\"Error: Could not open file '\");\n   109\t            let _ = err.write_all(filename);\n   110\t            let _ = err.write_all(b\"' for writing\\n\");\n   111\t            return -1;\n   112\t        }\n   113\t    };\n   114\t\n   115\t    let _ = file.write_all(&scene.name);\n   116\t    let _ = file.write_all(b\"\\n\");\n   117\t    let _ = writeln!(file, \"{}\", scene.shapes.len());\n   118\t    for &type_id in &scene.shapes {\n   119\t        let _ = writeln!(file, \"{}\", manager.get(type_id).unwrap().type_id);\n   120\t    }\n   121\t\n   122\t    let _ = out.write_all(b\"Scene saved to '\");\n   123\t    let _ = out.write_all(filename);\n   124\t    let _ = out.write_all(b\"'\\n\");\n   125\t    0\n   126\t}\n   127\t\n   128\tpub fn load<O: Write, E: Write>(\n   129\t    filename: &[u8],\n   130\t    manager: &ShapeManager,\n   131\t    out: &mut O,\n   132\t    err: &mut E,\n   133\t) -> Option<Scene> {\n   134\t    let path = OsStr::from_bytes(filename);\n   135\t    let mut file = match File::open(path) {\n   136\t        Ok(file) => file,\n   137\t        Err(_) => {\n   138\t            let _ = err.write_all(b\"Error: Could not open file '\");\n   139\t            let _ = err.write_all(filename);\n   140\t            let _ = err.write_all(b\"' for reading\\n\");\n   141\t            return None;\n   142\t        }\n   143\t    };\n   144\t\n   145\t    let mut data = Vec::new();\n   146\t    if file.read_to_end(&mut data).is_err() {\n   147\t        return None;\n   148\t    }\n   149\t\n   150\t    let mut position = 0;\n   151\t    let name_line = file_fgets(&data, &mut position, MAX_SCENE_NAME)?;\n   152\t    let name_end = name_line\n   153\t        .iter()\n   154\t        .position(|&byte| byte == 0 || byte == b'\\n')\n   155\t        .unwrap_or(name_line.len());\n   156\t    let mut scene = Scene::new(&name_line[..name_end]);\n   157\t\n   158\t    let shape_count = fscanf_i32(&data, &mut position)?;\n   159\t    for _ in 0..shape_count {\n   160\t        let type_id = fscanf_i32(&data, &mut position)?;\n   161\t        if manager.get(type_id).is_some() {\n   162\t            scene.add_shape(type_id, err);\n   163\t        }\n   164\t    }\n   165\t\n   166\t    let _ = out.write_all(b\"Scene loaded from '\");\n   167\t    let _ = out.write_all(filename);\n   168\t    let _ = out.write_all(b\"'\\n\");\n   169\t    Some(scene)\n   170\t}\n   171\t\n   172\tfn file_fgets(data: &[u8], position: &mut usize, size: usize) -> Option<Vec<u8>> {\n   173\t    if *position >= data.len() || size <= 1 {\n   174\t        return None;\n   175\t    }\n   176\t\n   177\t    let start = *position;\n   178\t    let limit = (start + size - 1).min(data.len());\n   179\t    while *position < limit {\n   180\t        let byte = data[*position];\n   181\t        *position += 1;\n   182\t        if byte == b'\\n' {\n   183\t            break;\n   184\t        }\n   185\t    }\n   186\t    Some(data[start..*position].to_vec())\n   187\t}\n     1\tuse std::io::{self, Write};\n     2\t\n     3\tpub const SHAPE_COUNT: i32 = 10;\n     4\t\n     5\tpub struct Shape {\n     6\t    pub type_id: i32,\n     7\t    pub name: &'static [u8],\n     8\t    art: &'static [&'static [u8]],\n     9\t}\n    10\t\n    11\tconst TREE: &[&[u8]] = &[\n    12\t    b\"    /\\\\    \",\n    13\t    b\"   /  \\\\   \",\n    14\t    b\"  /____\\\\  \",\n    15\t    b\"  /    \\\\  \",\n    16\t    b\" /______\\\\ \",\n    17\t    b\"    ||    \",\n    18\t    b\"    ||    \",\n    19\t];\n    20\t\n    21\tconst TRACTOR: &[&[u8]] = &[\n    22\t    b\"      ________     \",\n    23\t    b\"     |        |___ \",\n    24\t    b\"     |  []  []|   |\",\n    25\t    b\"  ___|________|___|\",\n    26\t    b\" /  o        o   \\\\\",\n    27\t    b\"|___|        |___| \",\n    28\t];\n    29\t\n    30\tconst HOUSE: &[&[u8]] = &[\n    31\t    b\"     /\\\\     \",\n    32\t    b\"    /  \\\\    \",\n    33\t    b\"   /____\\\\   \",\n    34\t    b\"   |    |   \",\n    35\t    b\"   | [] |   \",\n    36\t    b\"   |    |   \",\n    37\t    b\"   |____|   \",\n    38\t];\n    39\t\n    40\tconst SUN: &[&[u8]] = &[\n    41\t    b\"  \\\\  |  / \",\n    42\t    b\"   \\\\ | /  \",\n    43\t    b\"--- (@) ---\",\n    44\t    b\"   / | \\\\  \",\n    45\t    b\"  /  |  \\\\ \",\n    46\t    b\"          \",\n    47\t    b\"          \",\n    48\t];\n    49\t\n    50\tconst CLOUD: &[&[u8]] = &[\n    51\t    b\"   _____       \",\n    52\t    b\"  /     \\\\_    \",\n    53\t    b\" /  ___  _\\\\  \",\n    54\t    b\"(__/   \\\\_)   \",\n    55\t];\n    56\t\n    57\tconst FLOWER: &[&[u8]] = &[\n    58\t    b\"  \\\\|/  \",\n    59\t    b\" -(@)- \",\n    60\t    b\"  /|\\\\  \",\n    61\t    b\"   |   \",\n    62\t    b\"   |   \",\n    63\t    b\"  / \\\\  \",\n    64\t    b\" /   \\\\ \",\n    65\t];\n    66\t\n    67\tconst CAR: &[&[u8]] = &[\n    68\t    b\"  ____       \",\n    69\t    b\" /|_||_\\\\____ \",\n    70\t    b\"( o     o  ) \",\n    71\t    b\" -----------  \",\n    72\t];\n    73\t\n    74\tconst STAR: &[&[u8]] = &[\n    75\t    b\"    *    \",\n    76\t    b\"   ***   \",\n    77\t    b\"  *****  \",\n    78\t    b\" ******* \",\n    79\t    b\"*********\",\n    80\t];\n    81\t\n    82\tconst HEART: &[&[u8]] = &[\n    83\t    b\" *** ***  \",\n    84\t    b\"*********  \",\n    85\t    b\"*********  \",\n    86\t    b\" ******* \",\n    87\t    b\"  *****  \",\n    88\t    b\"   ***   \",\n    89\t];\n    90\t\n    91\tconst RAINBOW: &[&[u8]] = &[\n    92\t    b\"      _______      \",\n    93\t    b\"    /         \\\\    \",\n    94\t    b\"   /           \\\\   \",\n    95\t    b\"  /             \\\\  \",\n    96\t    b\" /               \\\\ \",\n    97\t];\n    98\t\n    99\tconst SHAPE_DATA: &[(&[u8], &[&[u8]])] = &[\n   100\t    (b\"Tree\", TREE),\n   101\t    (b\"Tractor\", TRACTOR),\n   102\t    (b\"House\", HOUSE),\n   103\t    (b\"Sun\", SUN),\n   104\t    (b\"Cloud\", CLOUD),\n   105\t    (b\"Flower\", FLOWER),\n   106\t    (b\"Car\", CAR),\n   107\t    (b\"Star\", STAR),\n   108\t    (b\"Heart\", HEART),\n   109\t    (b\"Rainbow\", RAINBOW),\n   110\t];\n   111\t\n   112\tpub struct ShapeManager {\n   113\t    shapes: Vec<Box<Shape>>,\n   114\t}\n   115\t\n   116\timpl ShapeManager {\n   117\t    pub fn new() -> Self {\n   118\t        let shapes = SHAPE_DATA\n   119\t            .iter()\n   120\t            .enumerate()\n   121\t            .map(|(type_id, &(name, art))| {\n   122\t                Box::new(Shape {\n   123\t                    type_id: type_id as i32,\n   124\t                    name,\n   125\t                    art,\n   126\t                })\n   127\t            })\n   128\t            .collect();\n   129\t        Self { shapes }\n   130\t    }\n   131\t\n   132\t    pub fn get(&self, type_id: i32) -> Option<&Shape> {\n   133\t        usize::try_from(type_id)\n   134\t            .ok()\n   135\t            .and_then(|index| self.shapes.get(index))\n   136\t            .map(Box::as_ref)\n   137\t    }\n   138\t\n   139\t    pub fn ptr(&self, type_id: i32) -> *const Shape {\n   140\t        self.get(type_id).map_or(std::ptr::null(), |shape| shape)\n   141\t    }\n   142\t}\n   143\t\n   144\tpub fn type_name(type_id: i32) -> &'static [u8] {\n   145\t    usize::try_from(type_id)\n   146\t        .ok()\n   147\t        .and_then(|index| SHAPE_DATA.get(index))\n   148\t        .map_or(b\"Unknown\", |(name, _)| *name)\n   149\t}\n   150\t\n   151\tpub fn print<W: Write>(out: &mut W, shape: Option<&Shape>) -> io::Result<()> {\n   152\t    let Some(shape) = shape else {\n   153\t        out.write_all(b\"(null shape)\\n\")?;\n   154\t        return Ok(());\n   155\t    };\n   156\t\n   157\t    out.write_all(shape.name)?;\n   158\t    out.write_all(b\":\\n\")?;\n   159\t    for line in shape.art {\n   160\t        out.write_all(line)?;\n   161\t        out.write_all(b\"\\n\")?;\n   162\t    }\n   163\t    Ok(())\n   164\t}\n     1\tpub struct Input {\n     2\t    data: Vec<u8>,\n     3\t    position: usize,\n     4\t}\n     5\t\n     6\timpl Input {\n     7\t    pub fn new(data: Vec<u8>) -> Self {\n     8\t        Self { data, position: 0 }\n     9\t    }\n    10\t\n    11\t    pub fn fgets(&mut self, size: usize) -> Option<Vec<u8>> {\n    12\t        if self.position >= self.data.len() || size <= 1 {\n    13\t            return None;\n    14\t        }\n    15\t\n    16\t        let start = self.position;\n    17\t        let limit = (start + size - 1).min(self.data.len());\n    18\t        while self.position < limit {\n    19\t            let byte = self.data[self.position];\n    20\t            self.position += 1;\n    21\t            if byte == b'\\n' {\n    22\t                break;\n    23\t            }\n    24\t        }\n    25\t        Some(self.data[start..self.position].to_vec())\n    26\t    }\n    27\t\n    28\t    pub fn scanf_i32(&mut self) -> Option<i32> {\n    29\t        while self.position < self.data.len() && is_space(self.data[self.position]) {\n    30\t            self.position += 1;\n    31\t        }\n    32\t\n    33\t        let mut negative = false;\n    34\t        if self.position < self.data.len()\n    35\t            && (self.data[self.position] == b'+' || self.data[self.position] == b'-')\n    36\t        {\n    37\t            negative = self.data[self.position] == b'-';\n    38\t            self.position += 1;\n    39\t        }\n    40\t\n    41\t        let digit_start = self.position;\n    42\t        let value = parse_digits(&self.data, &mut self.position, negative);\n    43\t        if self.position == digit_start {\n    44\t            return None;\n    45\t        }\n    46\t        Some(value)\n    47\t    }\n    48\t\n    49\t    pub fn discard_through_newline(&mut self) {\n    50\t        while self.position < self.data.len() {\n    51\t            let byte = self.data[self.position];\n    52\t            self.position += 1;\n    53\t            if byte == b'\\n' {\n    54\t                return;\n    55\t            }\n    56\t        }\n    57\t        loop {\n    58\t            std::hint::spin_loop();\n    59\t        }\n    60\t    }\n    61\t}\n    62\t\n    63\tpub fn sscanf_i32(data: &[u8]) -> Option<i32> {\n    64\t    parse_i32(data, 0).map(|(value, _)| value)\n    65\t}\n    66\t\n    67\tpub fn fscanf_i32(data: &[u8], position: &mut usize) -> Option<i32> {\n    68\t    let (value, end) = parse_i32(data, *position)?;\n    69\t    *position = end;\n    70\t    while *position < data.len() && is_space(data[*position]) {\n    71\t        *position += 1;\n    72\t    }\n    73\t    Some(value)\n    74\t}\n    75\t\n    76\tpub fn c_line_value(data: &[u8]) -> Vec<u8> {\n    77\t    let end = data\n    78\t        .iter()\n    79\t        .position(|&byte| byte == 0 || byte == b'\\n')\n    80\t        .unwrap_or(data.len());\n    81\t    data[..end].to_vec()\n    82\t}\n    83\t\n    84\tfn parse_i32(data: &[u8], mut position: usize) -> Option<(i32, usize)> {\n    85\t    while position < data.len() && is_space(data[position]) {\n    86\t        position += 1;\n    87\t    }\n    88\t\n    89\t    let mut negative = false;\n    90\t    if position < data.len() && (data[position] == b'+' || data[position] == b'-') {\n    91\t        negative = data[position] == b'-';\n    92\t        position += 1;\n    93\t    }\n    94\t\n    95\t    let digit_start = position;\n    96\t    let value = parse_digits(data, &mut position, negative);\n    97\t    if position == digit_start {\n    98\t        return None;\n    99\t    }\n   100\t\n   101\t    Some((value, position))\n   102\t}\n   103\t\n   104\tfn parse_digits(data: &[u8], position: &mut usize, negative: bool) -> i32 {\n   105\t    let mut magnitude = 0u64;\n   106\t    while *position < data.len() && data[*position].is_ascii_digit() {\n   107\t        magnitude = magnitude\n   108\t            .checked_mul(10)\n   109\t            .and_then(|value| value.checked_add(u64::from(data[*position] - b'0')))\n   110\t            .unwrap_or(u64::MAX);\n   111\t        *position += 1;\n   112\t    }\n   113\t\n   114\t    let long_value = if negative {\n   115\t        const LONG_MIN_MAGNITUDE: u64 = 1u64 << 63;\n   116\t        if magnitude >= LONG_MIN_MAGNITUDE {\n   117\t            i64::MIN\n   118\t        } else {\n   119\t            -(magnitude as i64)\n   120\t        }\n   121\t    } else if magnitude > i64::MAX as u64 {\n   122\t        i64::MAX\n   123\t    } else {\n   124\t        magnitude as i64\n   125\t    };\n   126\t    long_value as i32\n   127\t}\n   128\t\n   129\tfn is_space(byte: u8) -> bool {\n   130\t    matches!(byte, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n   131\t}\n     1\tmod input;\n     2\tmod scene;\n     3\tmod shape;\n     4\t\n     5\tuse input::{c_line_value, sscanf_i32, Input};\n     6\tuse scene::Scene;\n     7\tuse shape::{ShapeManager, SHAPE_COUNT};\n     8\tuse std::io::{self, Read, Write};\n     9\t\n    10\tconst MAX_SCENES: usize = 10;\n    11\t\n    12\tstruct App {\n    13\t    manager: ShapeManager,\n    14\t    scenes: Vec<Scene>,\n    15\t}\n    16\t\n    17\timpl App {\n    18\t    fn new() -> Self {\n    19\t        Self {\n    20\t            manager: ShapeManager::new(),\n    21\t            scenes: Vec::new(),\n    22\t        }\n    23\t    }\n    24\t\n    25\t    fn view_all_shapes<W: Write>(&self, out: &mut W) -> io::Result<()> {\n    26\t        out.write_all(b\"\\n=== Available Shapes ===\\n\")?;\n    27\t        for type_id in 0..SHAPE_COUNT {\n    28\t            write!(out, \"\\n{}. \", type_id + 1)?;\n    29\t            shape::print(out, self.manager.get(type_id))?;\n    30\t        }\n    31\t        Ok(())\n    32\t    }\n    33\t\n    34\t    fn create_new_scene<W: Write>(&mut self, input: &mut Input, out: &mut W) -> io::Result<()> {\n    35\t        if self.scenes.len() >= MAX_SCENES {\n    36\t            out.write_all(b\"Error: Maximum scenes reached\\n\")?;\n    37\t            return Ok(());\n    38\t        }\n    39\t\n    40\t        out.write_all(b\"Enter scene name: \")?;\n    41\t        let Some(line) = input.fgets(64) else {\n    42\t            return Ok(());\n    43\t        };\n    44\t        let name = c_line_value(&line);\n    45\t        self.scenes.push(Scene::new(&name));\n    46\t        out.write_all(b\"Scene '\")?;\n    47\t        out.write_all(&name)?;\n    48\t        write!(out, \"' created (index {})\\n\", self.scenes.len() - 1)\n    49\t    }\n    50\t\n    51\t    fn add_shape_to_scene<W: Write, E: Write>(\n    52\t        &mut self,\n    53\t        input: &mut Input,\n    54\t        out: &mut W,\n    55\t        err: &mut E,\n    56\t    ) -> io::Result<()> {\n    57\t        if self.scenes.is_empty() {\n    58\t            out.write_all(b\"No scenes available. Create a scene first.\\n\")?;\n    59\t            return Ok(());\n    60\t        }\n    61\t\n    62\t        write!(out, \"Select scene (0-{}): \", self.scenes.len() - 1)?;\n    63\t        let Some(scene_index) = scan_number(input, out)? else {\n    64\t            return Ok(());\n    65\t        };\n    66\t        let Ok(scene_index) = usize::try_from(scene_index) else {\n    67\t            out.write_all(b\"Invalid scene index\\n\")?;\n    68\t            return Ok(());\n    69\t        };\n    70\t        if scene_index >= self.scenes.len() {\n    71\t            out.write_all(b\"Invalid scene index\\n\")?;\n    72\t            return Ok(());\n    73\t        }\n    74\t\n    75\t        out.write_all(b\"\\nSelect shape to add:\\n\")?;\n    76\t        for type_id in 0..SHAPE_COUNT {\n    77\t            write!(out, \"{}. \", type_id)?;\n    78\t            out.write_all(shape::type_name(type_id))?;\n    79\t            out.write_all(b\"\\n\")?;\n    80\t        }\n    81\t        out.write_all(b\"Choice: \")?;\n    82\t\n    83\t        let Some(type_id) = scan_number(input, out)? else {\n    84\t            return Ok(());\n    85\t        };\n    86\t        if !(0..SHAPE_COUNT).contains(&type_id) {\n    87\t            out.write_all(b\"Invalid shape type\\n\")?;\n    88\t            return Ok(());\n    89\t        }\n    90\t\n    91\t        let result = self.scenes[scene_index].add_shape(type_id, err);\n    92\t        if result == 0 {\n    93\t            out.write_all(b\"Shape '\")?;\n    94\t            out.write_all(self.manager.get(type_id).unwrap().name)?;\n    95\t            write!(\n    96\t                out,\n    97\t                \"' added to scene (reusing singleton at {:p})\\n\",\n    98\t                self.manager.ptr(type_id)\n    99\t            )?;\n   100\t        } else {\n   101\t            out.write_all(b\"Error adding shape\\n\")?;\n   102\t        }\n   103\t        Ok(())\n   104\t    }\n   105\t\n   106\t    fn remove_shape_from_scene<W: Write>(\n   107\t        &mut self,\n   108\t        input: &mut Input,\n   109\t        out: &mut W,\n   110\t    ) -> io::Result<()> {\n   111\t        if self.scenes.is_empty() {\n   112\t            out.write_all(b\"No scenes available\\n\")?;\n   113\t            return Ok(());\n   114\t        }\n   115\t\n   116\t        write!(out, \"Select scene (0-{}): \", self.scenes.len() - 1)?;\n   117\t        let Some(scene_index) = scan_number(input, out)? else {\n   118\t            return Ok(());\n   119\t        };\n   120\t        let Ok(scene_index) = usize::try_from(scene_index) else {\n   121\t            out.write_all(b\"Invalid scene index\\n\")?;\n   122\t            return Ok(());\n   123\t        };\n   124\t        if scene_index >= self.scenes.len() {\n   125\t            out.write_all(b\"Invalid scene index\\n\")?;\n   126\t            return Ok(());\n   127\t        }\n   128\t\n   129\t        scene::list_shapes(out, &self.scenes[scene_index], &self.manager)?;\n   130\t        if self.scenes[scene_index].shapes.is_empty() {\n   131\t            out.write_all(b\"Scene is empty\\n\")?;\n   132\t            return Ok(());\n   133\t        }\n   134\t\n   135\t        write!(\n   136\t            out,\n   137\t            \"Select shape to remove (1-{}): \",\n   138\t            self.scenes[scene_index].shapes.len()\n   139\t        )?;\n   140\t        let Some(shape_index) = scan_number(input, out)? else {\n   141\t            return Ok(());\n   142\t        };\n   143\t        if self.scenes[scene_index].remove_shape(shape_index.wrapping_sub(1)) == 0 {\n   144\t            out.write_all(b\"Shape removed\\n\")?;\n   145\t        } else {\n   146\t            out.write_all(b\"Error removing shape\\n\")?;\n   147\t        }\n   148\t        Ok(())\n   149\t    }\n   150\t\n   151\t    fn view_scene<W: Write>(&self, input: &mut Input, out: &mut W) -> io::Result<()> {\n   152\t        if self.scenes.is_empty() {\n   153\t            out.write_all(b\"No scenes available\\n\")?;\n   154\t            return Ok(());\n   155\t        }\n   156\t\n   157\t        write!(out, \"Select scene (0-{}): \", self.scenes.len() - 1)?;\n   158\t        let Some(scene_index) = scan_number(input, out)? else {\n   159\t            return Ok(());\n   160\t        };\n   161\t        let Ok(scene_index) = usize::try_from(scene_index) else {\n   162\t            out.write_all(b\"Invalid scene index\\n\")?;\n   163\t            return Ok(());\n   164\t        };\n   165\t        if scene_index >= self.scenes.len() {\n   166\t            out.write_all(b\"Invalid scene index\\n\")?;\n   167\t            return Ok(());\n   168\t        }\n   169\t        scene::print(out, &self.scenes[scene_index], &self.manager)\n   170\t    }\n   171\t\n   172\t    fn list_all_scenes<W: Write>(&self, out: &mut W) -> io::Result<()> {\n   173\t        out.write_all(b\"\\n=== All Scenes ===\\n\")?;\n   174\t        if self.scenes.is_empty() {\n   175\t            out.write_all(b\"No scenes created yet\\n\")?;\n   176\t            return Ok(());\n   177\t        }\n   178\t\n   179\t        for (index, scene) in self.scenes.iter().enumerate() {\n   180\t            write!(out, \"{}. \", index)?;\n   181\t            out.write_all(&scene.name)?;\n   182\t            writeln!(out, \" ({} shapes)\", scene.shapes.len())?;\n   183\t        }\n   184\t        Ok(())\n   185\t    }\n   186\t\n   187\t    fn save_scene_to_file<W: Write, E: Write>(\n   188\t        &self,\n   189\t        input: &mut Input,\n   190\t        out: &mut W,\n   191\t        err: &mut E,\n   192\t    ) -> io::Result<()> {\n   193\t        if self.scenes.is_empty() {\n   194\t            out.write_all(b\"No scenes available\\n\")?;\n   195\t            return Ok(());\n   196\t        }\n   197\t\n   198\t        write!(out, \"Select scene (0-{}): \", self.scenes.len() - 1)?;\n   199\t        let Some(scene_index) = scan_number(input, out)? else {\n   200\t            return Ok(());\n   201\t        };\n   202\t        let Ok(scene_index) = usize::try_from(scene_index) else {\n   203\t            out.write_all(b\"Invalid scene index\\n\")?;\n   204\t            return Ok(());\n   205\t        };\n   206\t        if scene_index >= self.scenes.len() {\n   207\t            out.write_all(b\"Invalid scene index\\n\")?;\n   208\t            return Ok(());\n   209\t        }\n   210\t\n   211\t        out.write_all(b\"Enter filename: \")?;\n   212\t        let Some(line) = input.fgets(256) else {\n   213\t            return Ok(());\n   214\t        };\n   215\t        let filename = c_line_value(&line);\n   216\t        scene::save(\n   217\t            &self.scenes[scene_index],\n   218\t            &filename,\n   219\t            &self.manager,\n   220\t            out,\n   221\t            err,\n   222\t        );\n   223\t        Ok(())\n   224\t    }\n   225\t\n   226\t    fn load_scene_from_file<W: Write, E: Write>(\n   227\t        &mut self,\n   228\t        input: &mut Input,\n   229\t        out: &mut W,\n   230\t        err: &mut E,\n   231\t    ) -> io::Result<()> {\n   232\t        if self.scenes.len() >= MAX_SCENES {\n   233\t            out.write_all(b\"Error: Maximum scenes reached\\n\")?;\n   234\t            return Ok(());\n   235\t        }\n   236\t\n   237\t        out.write_all(b\"Enter filename: \")?;\n   238\t        let Some(line) = input.fgets(256) else {\n   239\t            return Ok(());\n   240\t        };\n   241\t        let filename = c_line_value(&line);\n   242\t        if let Some(loaded) = scene::load(&filename, &self.manager, out, err) {\n   243\t            self.scenes.push(loaded);\n   244\t            writeln!(out, \"Scene loaded (index {})\", self.scenes.len() - 1)?;\n   245\t        }\n   246\t        Ok(())\n   247\t    }\n   248\t\n   249\t    fn compare_shapes<W: Write>(&self, input: &mut Input, out: &mut W) -> io::Result<()> {\n   250\t        write!(out, \"\\nSelect first shape (0-{}):\\n\", SHAPE_COUNT - 1)?;\n   251\t        for type_id in 0..SHAPE_COUNT {\n   252\t            write!(out, \"{}. \", type_id)?;\n   253\t            out.write_all(shape::type_name(type_id))?;\n   254\t            out.write_all(b\"\\n\")?;\n   255\t        }\n   256\t        out.write_all(b\"Choice: \")?;\n   257\t        let Some(first) = scan_number(input, out)? else {\n   258\t            return Ok(());\n   259\t        };\n   260\t\n   261\t        write!(out, \"\\nSelect second shape (0-{}): \", SHAPE_COUNT - 1)?;\n   262\t        let Some(second) = scan_number(input, out)? else {\n   263\t            return Ok(());\n   264\t        };\n   265\t\n   266\t        if !(0..SHAPE_COUNT).contains(&first) || !(0..SHAPE_COUNT).contains(&second) {\n   267\t            out.write_all(b\"Invalid shape type\\n\")?;\n   268\t            return Ok(());\n   269\t        }\n   270\t\n   271\t        out.write_all(b\"\\nShape 1: \")?;\n   272\t        out.write_all(self.manager.get(first).unwrap().name)?;\n   273\t        writeln!(out, \" (ptr: {:p})\", self.manager.ptr(first))?;\n   274\t        out.write_all(b\"Shape 2: \")?;\n   275\t        out.write_all(self.manager.get(second).unwrap().name)?;\n   276\t        writeln!(out, \" (ptr: {:p})\", self.manager.ptr(second))?;\n   277\t        writeln!(\n   278\t            out,\n   279\t            \"Comparison of pointers: {}\",\n   280\t            i32::from(first == second)\n   281\t        )?;\n   282\t        if first == second {\n   283\t            out.write_all(b\"Result: Shapes are EQUAL (same instance)\\n\")?;\n   284\t        } else {\n   285\t            out.write_all(b\"Result: Shapes are NOT EQUAL (different instances)\\n\")?;\n   286\t        }\n   287\t        Ok(())\n   288\t    }\n   289\t\n   290\t    fn compare_scenes<W: Write>(&self, input: &mut Input, out: &mut W) -> io::Result<()> {\n   291\t        if self.scenes.len() < 2 {\n   292\t            out.write_all(b\"Need at least 2 scenes to compare\\n\")?;\n   293\t            return Ok(());\n   294\t        }\n   295\t\n   296\t        write!(out, \"Select first scene (0-{}): \", self.scenes.len() - 1)?;\n   297\t        let Some(first) = scan_number(input, out)? else {\n   298\t            return Ok(());\n   299\t        };\n   300\t        write!(out, \"Select second scene (0-{}): \", self.scenes.len() - 1)?;\n   301\t        let Some(second) = scan_number(input, out)? else {\n   302\t            return Ok(());\n   303\t        };\n   304\t\n   305\t        let (Ok(first), Ok(second)) = (usize::try_from(first), usize::try_from(second)) else {\n   306\t            out.write_all(b\"Invalid scene index\\n\")?;\n   307\t            return Ok(());\n   308\t        };\n   309\t        if first >= self.scenes.len() || second >= self.scenes.len() {\n   310\t            out.write_all(b\"Invalid scene index\\n\")?;\n   311\t            return Ok(());\n   312\t        }\n   313\t\n   314\t        let first_scene = &self.scenes[first];\n   315\t        let second_scene = &self.scenes[second];\n   316\t        out.write_all(b\"\\nScene 1: \")?;\n   317\t        out.write_all(&first_scene.name)?;\n   318\t        writeln!(out, \" ({} shapes)\", first_scene.shapes.len())?;\n   319\t        scene::list_shapes(out, first_scene, &self.manager)?;\n   320\t\n   321\t        out.write_all(b\"\\nScene 2: \")?;\n   322\t        out.write_all(&second_scene.name)?;\n   323\t        writeln!(out, \" ({} shapes)\", second_scene.shapes.len())?;\n   324\t        scene::list_shapes(out, second_scene, &self.manager)?;\n   325\t\n   326\t        if scene::equals(first_scene, second_scene) {\n   327\t            out.write_all(b\"\\nResult: Scenes are EQUAL (1:1 correspondence)\\n\")?;\n   328\t        } else {\n   329\t            out.write_all(b\"\\nResult: Scenes are NOT EQUAL\\n\")?;\n   330\t        }\n   331\t        Ok(())\n   332\t    }\n   333\t\n   334\t    fn delete_scene<W: Write>(&mut self, input: &mut Input, out: &mut W) -> io::Result<()> {\n   335\t        if self.scenes.is_empty() {\n   336\t            out.write_all(b\"No scenes available\\n\")?;\n   337\t            return Ok(());\n   338\t        }\n   339\t\n   340\t        write!(\n   341\t            out,\n   342\t            \"Select scene to delete (0-{}): \",\n   343\t            self.scenes.len() - 1\n   344\t        )?;\n   345\t        let Some(scene_index) = scan_number(input, out)? else {\n   346\t            return Ok(());\n   347\t        };\n   348\t        let Ok(scene_index) = usize::try_from(scene_index) else {\n   349\t            out.write_all(b\"Invalid scene index\\n\")?;\n   350\t            return Ok(());\n   351\t        };\n   352\t        if scene_index >= self.scenes.len() {\n   353\t            out.write_all(b\"Invalid scene index\\n\")?;\n   354\t            return Ok(());\n   355\t        }\n   356\t\n   357\t        self.scenes.remove(scene_index);\n   358\t        out.write_all(b\"Scene deleted\\n\")\n   359\t    }\n   360\t}\n   361\t\n   362\tfn scan_number<W: Write>(input: &mut Input, out: &mut W) -> io::Result<Option<i32>> {\n   363\t    let value = input.scanf_i32();\n   364\t    if value.is_none() {\n   365\t        out.write_all(b\"Invalid input\\n\")?;\n   366\t    }\n   367\t    input.discard_through_newline();\n   368\t    Ok(value)\n   369\t}\n   370\t\n   371\tfn print_menu<W: Write>(out: &mut W) -> io::Result<()> {\n   372\t    out.write_all(\n   373\t        b\"\\n=========================================\\n  ASCII ART DRAWING APPLICATION\\n=========================================\\n1. View all available shapes\\n2. Create new scene\\n3. Add shape to scene\\n4. Remove shape from scene\\n5. View scene\\n6. List all scenes\\n7. Save scene\\n8. Load scene\\n9. Compare two shapes\\n10. Compare two scenes\\n11. Delete scene\\n12. Exit\\n=========================================\\nChoice: \",\n   374\t    )\n   375\t}\n   376\t\n   377\tfn run() -> io::Result<()> {\n   378\t    let mut stdin_data = Vec::new();\n   379\t    io::stdin().read_to_end(&mut stdin_data)?;\n   380\t    let mut input = Input::new(stdin_data);\n   381\t    let stdout = io::stdout();\n   382\t    let stderr = io::stderr();\n   383\t    let mut out = stdout.lock();\n   384\t    let mut err = stderr.lock();\n   385\t\n   386\t    out.write_all(\n   387\t        \"╔════════════════════════════════════════╗\\n\\\n   388\t         ║  ASCII ART DRAWING APPLICATION        ║\\n\\\n   389\t         ║  Child-Friendly Shape Editor           ║\\n\\\n   390\t         ╚════════════════════════════════════════╝\\n\"\n   391\t            .as_bytes(),\n   392\t    )?;\n   393\t\n   394\t    let mut app = App::new();\n   395\t    loop {\n   396\t        print_menu(&mut out)?;\n   397\t        let Some(line) = input.fgets(256) else {\n   398\t            break;\n   399\t        };\n   400\t        let Some(choice) = sscanf_i32(&line) else {\n   401\t            out.write_all(b\"Invalid input\\n\")?;\n   402\t            continue;\n   403\t        };\n   404\t\n   405\t        match choice {\n   406\t            1 => app.view_all_shapes(&mut out)?,\n   407\t            2 => app.create_new_scene(&mut input, &mut out)?,\n   408\t            3 => app.add_shape_to_scene(&mut input, &mut out, &mut err)?,\n   409\t            4 => app.remove_shape_from_scene(&mut input, &mut out)?,\n   410\t            5 => app.view_scene(&mut input, &mut out)?,\n   411\t            6 => app.list_all_scenes(&mut out)?,\n   412\t            7 => app.save_scene_to_file(&mut input, &mut out, &mut err)?,\n   413\t            8 => app.load_scene_from_file(&mut input, &mut out, &mut err)?,\n   414\t            9 => app.compare_shapes(&mut input, &mut out)?,\n   415\t            10 => app.compare_scenes(&mut input, &mut out)?,\n   416\t            11 => app.delete_scene(&mut input, &mut out)?,\n   417\t            12 => {\n   418\t                out.write_all(b\"\\nCleaning up and exiting...\\nGoodbye!\\n\")?;\n   419\t                return Ok(());\n   420\t            }\n   421\t            _ => out.write_all(b\"Invalid choice\\n\")?,\n   422\t        }\n   423\t    }\n   424\t    Ok(())\n   425\t}\n   426\t\n   427\tfn main() {\n   428\t    let _ = run();\n   429\t}\n","exit_code":0,"status":"completed"}}
