ame);\n    42\t\n    43\t// Destroy a scene\n    44\tvoid scene_destroy(scene_t *scene);\n    45\t\n    46\t// Add a shape to the scene\n    47\tint scene_add_shape(scene_t *scene, shape_t *shape);\n    48\t\n    49\t// Remove a shape at index\n    50\tint scene_remove_shape(scene_t *scene, int index);\n    51\t\n    52\t// Print the scene\n    53\tvoid scene_print(const scene_t *scene);\n    54\t\n    55\t// Compare two scenes for equality (1:1 correspondence)\n    56\tint scene_equals(const scene_t *s1, const scene_t *s2);\n    57\t\n    58\t// Save scene to file\n    59\tint scene_save(const scene_t *scene, const char *filename);\n    60\t\n    61\t// Load scene from file\n    62\tscene_t* scene_load(const char *filename);\n    63\t\n    64\t// List all shapes in scene\n    65\tvoid scene_list_shapes(const scene_t *scene);\n    66\t\n    67\t#endif // SCENE_H\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t#ifndef SHAPE_H\n    26\t#define SHAPE_H\n    27\t\n    28\t#include <stddef.h>\n    29\t\n    30\t#define MAX_SHAPE_WIDTH 80\n    31\t#define MAX_SHAPE_HEIGHT 30\n    32\t#define MAX_SHAPE_NAME 32\n    33\t\n    34\ttypedef enum {\n    35\t    SHAPE_TREE,\n    36\t    SHAPE_TRACTOR,\n    37\t    SHAPE_HOUSE,\n    38\t    SHAPE_SUN,\n    39\t    SHAPE_CLOUD,\n    40\t    SHAPE_FLOWER,\n    41\t    SHAPE_CAR,\n    42\t    SHAPE_STAR,\n    43\t    SHAPE_HEART,\n    44\t    SHAPE_RAINBOW,\n    45\t    SHAPE_COUNT\n    46\t} shape_type_t;\n    47\t\n    48\ttypedef struct {\n    49\t    shape_type_t type;\n    50\t    char name[MAX_SHAPE_NAME];\n    51\t    char art[MAX_SHAPE_HEIGHT][MAX_SHAPE_WIDTH];\n    52\t    int width;\n    53\t    int height;\n    54\t} shape_t;\n    55\t\n    56\t// Initialize the shape manager (allocate all shapes once)\n    57\tvoid shape_manager_init(void);\n    58\t\n    59\t// Clean up shape manager\n    60\tvoid shape_manager_cleanup(void);\n    61\t\n    62\t// Get a shape by type (returns singleton instance)\n    63\tshape_t* shape_get(shape_type_t type);\n    64\t\n    65\t// Print a shape to stdout\n    66\tvoid shape_print(const shape_t *shape);\n    67\t\n    68\t// Compare two shapes (equal if XOR of pointers is 0)\n    69\tint shape_equals(const shape_t *s1, const shape_t *s2);\n    70\t\n    71\t// Get shape type name\n    72\tconst char* shape_type_name(shape_type_t type);\n    73\t\n    74\t#endif // SHAPE_H\n","exit_code":0,"status":"completed"}}
