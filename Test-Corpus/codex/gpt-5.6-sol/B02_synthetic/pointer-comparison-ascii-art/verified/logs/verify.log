TION\\n\");\n    41\t    printf(\"=========================================\\n\");\n    42\t    printf(\"1. View all available shapes\\n\");\n    43\t    printf(\"2. Create new scene\\n\");\n    44\t    printf(\"3. Add shape to scene\\n\");\n    45\t    printf(\"4. Remove shape from scene\\n\");\n    46\t    printf(\"5. View scene\\n\");\n    47\t    printf(\"6. List all scenes\\n\");\n    48\t    printf(\"7. Save scene\\n\");\n    49\t    printf(\"8. Load scene\\n\");\n    50\t    printf(\"9. Compare two shapes\\n\");\n    51\t    printf(\"10. Compare two scenes\\n\");\n    52\t    printf(\"11. Delete scene\\n\");\n    53\t    printf(\"12. Exit\\n\");\n    54\t    printf(\"=========================================\\n\");\n    55\t    printf(\"Choice: \");\n    56\t}\n    57\t\n    58\tvoid view_all_shapes(void) {\n    59\t    printf(\"\\n=== Available Shapes ===\\n\");\n    60\t    for (int i = 0; i < SHAPE_COUNT; i++) {\n    61\t        printf(\"\\n%d. \", i + 1);\n    62\t        shape_print(shape_get((shape_type_t)i));\n    63\t    }\n    64\t}\n    65\t\n    66\tvoid create_new_scene(void) {\n    67\t    if (scene_count >= MAX_SCENES) {\n    68\t        printf(\"Error: Maximum scenes reached\\n\");\n    69\t        return;\n    70\t    }\n    71\t    \n    72\t    char name[MAX_SCENE_NAME];\n    73\t    printf(\"Enter scene name: \");\n    74\t    if (fgets(name, MAX_SCENE_NAME, stdin) == NULL) {\n    75\t        return;\n    76\t    }\n    77\t    name[strcspn(name, \"\\n\")] = 0;\n    78\t    \n    79\t    scenes[scene_count] = scene_create(name);\n    80\t    if (scenes[scene_count]) {\n    81\t        printf(\"Scene '%s' created (index %d)\\n\", name, scene_count);\n    82\t        scene_count++;\n    83\t    } else {\n    84\t        printf(\"Error creating scene\\n\");\n    85\t    }\n    86\t}\n    87\t\n    88\tvoid add_shape_to_scene(void) {\n    89\t    if (scene_count == 0) {\n    90\t        printf(\"No scenes available. Create a scene first.\\n\");\n    91\t        return;\n    92\t    }\n    93\t    \n    94\t    printf(\"Select scene (0-%d): \", scene_count - 1);\n    95\t    int scene_idx;\n    96\t    if (scanf(\"%d\", &scene_idx) != 1) {\n    97\t        printf(\"Invalid input\\n\");\n    98\t        while (getchar() != '\\n');\n    99\t        return;\n   100\t    }\n   101\t    while (getchar() != '\\n');\n   102\t    \n   103\t    if (scene_idx < 0 || scene_idx >= scene_count) {\n   104\t        printf(\"Invalid scene index\\n\");\n   105\t        return;\n   106\t    }\n   107\t    \n   108\t    printf(\"\\nSelect shape to add:\\n\");\n   109\t    for (int i = 0; i < SHAPE_COUNT; i++) {\n   110\t        printf(\"%d. %s\\n\", i, shape_type_name((shape_type_t)i));\n   111\t    }\n   112\t    printf(\"Choice: \");\n   113\t    \n   114\t    int shape_type;\n   115\t    if (scanf(\"%d\", &shape_type) != 1) {\n   116\t        printf(\"Invalid input\\n\");\n   117\t        while (getchar() != '\\n');\n   118\t        return;\n   119\t    }\n   120\t    while (getchar() != '\\n');\n   121\t    \n   122\t    if (shape_type < 0 || shape_type >= SHAPE_COUNT) {\n   123\t        printf(\"Invalid shape type\\n\");\n   124\t        return;\n   125\t    }\n   126\t    \n   127\t    shape_t *shape = shape_get((shape_type_t)shape_type);\n   128\t    if (scene_add_shape(scenes[scene_idx], shape) == 0) {\n   129\t        printf(\"Shape '%s' added to scene (reusing singleton at %p)\\n\", \n   130\t               shape->name, (void*)shape);\n   131\t    } else {\n   132\t        printf(\"Error adding shape\\n\");\n   133\t    }\n   134\t}\n   135\t\n   136\tvoid remove_shape_from_scene(void) {\n   137\t    if (scene_count == 0) {\n   138\t        printf(\"No scenes available\\n\");\n   139\t        return;\n   140\t    }\n   141\t    \n   142\t    printf(\"Select scene (0-%d): \", scene_count - 1);\n   143\t    int scene_idx;\n   144\t    if (scanf(\"%d\", &scene_idx) != 1) {\n   145\t        printf(\"Invalid input\\n\");\n   146\t        while (getchar() != '\\n');\n   147\t        return;\n   148\t    }\n   149\t    while (getchar() != '\\n');\n   150\t    \n   151\t    if (scene_idx < 0 || scene_idx >= scene_count) {\n   152\t        printf(\"Invalid scene index\\n\");\n   153\t        return;\n   154\t    }\n   155\t    \n   156\t    scene_list_shapes(scenes[scene_idx]);\n   157\t    \n   158\t    if (scenes[scene_idx]->shape_count == 0) {\n   159\t        printf(\"Scene is empty\\n\");\n   160\t        return;\n   161\t    }\n   162\t    \n   163\t    printf(\"Select shape to remove (1-%d): \", scenes[scene_idx]->shape_count);\n   164\t    int shape_idx;\n   165\t    if (scanf(\"%d\", &shape_idx) != 1) {\n   166\t        printf(\"Invalid input\\n\");\n   167\t        while (getchar() != '\\n');\n   168\t        return;\n   169\t    }\n   170\t    while (getchar() != '\\n');\n   171\t    \n   172\t    if (scene_remove_shape(scenes[scene_idx], shape_idx - 1) == 0) {\n   173\t        printf(\"Shape removed\\n\");\n   174\t    } else {\n   175\t        printf(\"Error removing shape\\n\");\n   176\t    }\n   177\t}\n   178\t\n   179\tvoid view_scene(void) {\n   180\t    if (scene_count == 0) {\n   181\t        printf(\"No scenes available\\n\");\n   182\t        return;\n   183\t    }\n   184\t    \n   185\t    printf(\"Select scene (0-%d): \", scene_count - 1);\n   186\t    int scene_idx;\n   187\t    if (scanf(\"%d\", &scene_idx) != 1) {\n   188\t        printf(\"Invalid input\\n\");\n   189\t        while (getchar() != '\\n');\n   190\t        return;\n   191\t    }\n   192\t    while (getchar() != '\\n');\n   193\t    \n   194\t    if (scene_idx < 0 || scene_idx >= scene_count) {\n   195\t        printf(\"Invalid scene index\\n\");\n   196\t        return;\n   197\t    }\n   198\t    \n   199\t    scene_print(scenes[scene_idx]);\n   200\t}\n   201\t\n   202\tvoid list_all_scenes(void) {\n   203\t    printf(\"\\n=== All Scenes ===\\n\");\n   204\t    if (scene_count == 0) {\n   205\t        printf(\"No scenes created yet\\n\");\n   206\t        return;\n   207\t    }\n   208\t    \n   209\t    for (int i = 0; i < scene_count; i++) {\n   210\t        printf(\"%d. %s (%d shapes)\\n\", i, scenes[i]->name, scenes[i]->shape_count);\n   211\t    }\n   212\t}\n   213\t\n   214\tvoid save_scene_to_file(void) {\n   215\t    if (scene_count == 0) {\n   216\t        printf(\"No scenes available\\n\");\n   217\t        return;\n   218\t    }\n   219\t    \n   220\t    printf(\"Select scene (0-%d): \", scene_count - 1);\n   221\t    int scene_idx;\n   222\t    if (scanf(\"%d\", &scene_idx) != 1) {\n   223\t        printf(\"Invalid input\\n\");\n   224\t        while (getchar() != '\\n');\n   225\t        return;\n   226\t    }\n   227\t    while (getchar() != '\\n');\n   228\t    \n   229\t    if (scene_idx < 0 || scene_idx >= scene_count) {\n   230\t        printf(\"Invalid scene index\\n\");\n   231\t        return;\n   232\t    }\n   233\t    \n   234\t    char filename[256];\n   235\t    printf(\"Enter filename: \");\n   236\t    if (fgets(filename, sizeof(filename), stdin) == NULL) {\n   237\t        return;\n   238\t    }\n   239\t    filename[strcspn(filename, \"\\n\")] = 0;\n   240\t    \n   241\t    scene_save(scenes[scene_idx], filename);\n   242\t}\n   243\t\n   244\tvoid load_scene_from_file(void) {\n   245\t    if (scene_count >= MAX_SCENES) {\n   246\t        printf(\"Error: Maximum scenes reached\\n\");\n   247\t        return;\n   248\t    }\n   249\t    \n   250\t    char filename[256];\n   251\t    printf(\"Enter filename: \");\n   252\t    if (fgets(filename, sizeof(filename), stdin) == NULL) {\n   253\t        return;\n   254\t    }\n   255\t    filename[strcspn(filename, \"\\n\")] = 0;\n   256\t    \n   257\t    scene_t *scene = scene_load(filename);\n   258\t    if (scene) {\n   259\t        scenes[scene_count++] = scene;\n   260\t        printf(\"Scene loaded (index %d)\\n\", scene_count - 1);\n   261\t    }\n   262\t}\n   263\t\n   264\tvoid compare_shapes(void) {\n   265\t    printf(\"\\nSelect first shape (0-%d):\\n\", SHAPE_COUNT - 1);\n   266\t    for (int i = 0; i < SHAPE_COUNT; i++) {\n   267\t        printf(\"%d. %s\\n\", i, shape_type_name((shape_type_t)i));\n   268\t    }\n   269\t    printf(\"Choice: \");\n   270\t    \n   271\t    int type1;\n   272\t    if (scanf(\"%d\", &type1) != 1) {\n   273\t        printf(\"Invalid input\\n\");\n   274\t        while (getchar() != '\\n');\n   275\t        return;\n   276\t    }\n   277\t    while (getchar() != '\\n');\n   278\t    \n   279\t    printf(\"\\nSelect second shape (0-%d): \", SHAPE_COUNT - 1);\n   280\t    int type2;\n   281\t    if (scanf(\"%d\", &type2) != 1) {\n   282\t        printf(\"Invalid input\\n\");\n   283\t        while (getchar() != '\\n');\n   284\t        return;\n   285\t    }\n   286\t    while (getchar() != '\\n');\n   287\t    \n   288\t    if (type1 < 0 || type1 >= SHAPE_COUNT || type2 < 0 || type2 >= SHAPE_COUNT) {\n   289\t        printf(\"Invalid shape type\\n\");\n   290\t        return;\n   291\t    }\n   292\t    \n   293\t    shape_t *s1 = shape_get((shape_type_t)type1);\n   294\t    shape_t *s2 = shape_get((shape_type_t)type2);\n   295\t    \n   296\t    printf(\"\\nShape 1: %s (ptr: %p)\\n\", s1->name, (void*)s1);\n   297\t    printf(\"Shape 2: %s (ptr: %p)\\n\", s2->name, (void*)s2);\n   298\t    printf(\"Comparison of pointers: %d\\n\", s1 == s2);\n   299\t    \n   300\t    if (shape_equals(s1, s2)) {\n   301\t        printf(\"Result: Shapes are EQUAL (same instance)\\n\");\n   302\t    } else {\n   303\t        printf(\"Result: Shapes are NOT EQUAL (different instances)\\n\");\n   304\t    }\n   305\t}\n   306\t\n   307\tvoid compare_scenes(void) {\n   308\t    if (scene_count < 2) {\n   309\t        printf(\"Need at least 2 scenes to compare\\n\");\n   310\t        return;\n   311\t    }\n   312\t    \n   313\t    printf(\"Select first scene (0-%d): \", scene_count - 1);\n   314\t    int idx1;\n   315\t    if (scanf(\"%d\", &idx1) != 1) {\n   316\t        printf(\"Invalid input\\n\");\n   317\t        while (getchar() != '\\n');\n   318\t        return;\n   319\t    }\n   320\t    while (getchar() != '\\n');\n   321\t    \n   322\t    printf(\"Select second scene (0-%d): \", scene_count - 1);\n   323\t    int idx2;\n   324\t    if (scanf(\"%d\", &idx2) != 1) {\n   325\t        printf(\"Invalid input\\n\");\n   326\t        while (getchar() != '\\n');\n   327\t        return;\n   328\t    }\n   329\t    while (getchar() != '\\n');\n   330\t    \n   331\t    if (idx1 < 0 || idx1 >= scene_count || idx2 < 0 || idx2 >= scene_count) {\n   332\t        printf(\"Invalid scene index\\n\");\n   333\t        return;\n   334\t    }\n   335\t    \n   336\t    scene_t *sc1 = scenes[idx1];\n   337\t    scene_t *sc2 = scenes[idx2];\n   338\t    \n   339\t    printf(\"\\nScene 1: %s (%d shapes)\\n\", sc1->name, sc1->shape_count);\n   340\t    scene_list_shapes(sc1);\n   341\t    \n   342\t    printf(\"\\nScene 2: %s (%d shapes)\\n\", sc2->name, sc2->shape_count);\n   343\t    scene_list_shapes(sc2);\n   344\t    \n   345\t    if (scene_equals(sc1, sc2)) {\n   346\t        printf(\"\\nResult: Scenes are EQUAL (1:1 correspondence)\\n\");\n   347\t    } else {\n   348\t        printf(\"\\nResult: Scenes are NOT EQUAL\\n\");\n   349\t    }\n   350\t}\n   351\t\n   352\tvoid delete_scene(void) {\n   353\t    if (scene_count == 0) {\n   354\t        printf(\"No scenes available\\n\");\n   355\t        return;\n   356\t    }\n   357\t    \n   358\t    printf(\"Select scene to delete (0-%d): \", scene_count - 1);\n   359\t    int scene_idx;\n   360\t    if (scanf(\"%d\", &scene_idx) != 1) {\n   361\t        printf(\"Invalid input\\n\");\n   362\t        while (getchar() != '\\n');\n   363\t        return;\n   364\t    }\n   365\t    while (getchar() != '\\n');\n   366\t    \n   367\t    if (scene_idx < 0 || scene_idx >= scene_count) {\n   368\t        printf(\"Invalid scene index\\n\");\n   369\t        return;\n   370\t    }\n   371\t    \n   372\t    scene_destroy(scenes[scene_idx]);\n   373\t    \n   374\t    // Shift remaining scenes\n   375\t    for (int i = scene_idx; i < scene_count - 1; i++) {\n   376\t        scenes[i] = scenes[i + 1];\n   377\t    }\n   378\t    \n   379\t    scene_count--;\n   380\t    printf(\"Scene deleted\\n\");\n   381\t}\n   382\t\n   383\tint main(void) {\n   384\t    printf(\"╔════════════════════════════════════════╗\\n\");\n   385\t    printf(\"║  ASCII ART DRAWING APPLICATION        ║\\n\");\n   386\t    printf(\"║  Child-Friendly Shape Editor           ║\\n\");\n   387\t    printf(\"╚════════════════════════════════════════╝\\n\");\n   388\t    \n   389\t    // Initialize shape manager (allocate all shapes once)\n   390\t    shape_manager_init();\n   391\t    \n   392\t    char input[256];\n   393\t    int choice;\n   394\t    \n   395\t    while (1) {\n   396\t        print_menu();\n   397\t        \n   398\t        if (fgets(input, sizeof(input), stdin) == NULL) {\n   399\t            break;\n   400\t        }\n   401\t        \n   402\t        if (sscanf(input, \"%d\", &choice) != 1) {\n   403\t            printf(\"Invalid input\\n\");\n   404\t            continue;\n   405\t        }\n   406\t        \n   407\t        switch (choice) {\n   408\t            case 1:\n   409\t                view_all_shapes();\n   410\t                break;\n   411\t            case 2:\n   412\t                create_new_scene();\n   413\t                break;\n   414\t            case 3:\n   415\t                add_shape_to_scene();\n   416\t                break;\n   417\t            case 4:\n   418\t                remove_shape_from_scene();\n   419\t                break;\n   420\t            case 5:\n   421\t                view_scene();\n   422\t                break;\n   423\t            case 6:\n   424\t                list_all_scenes();\n   425\t                break;\n   426\t            case 7:\n   427\t                save_scene_to_file();\n   428\t                break;\n   429\t            case 8:\n   430\t                load_scene_from_file();\n   431\t                break;\n   432\t            case 9:\n   433\t                compare_shapes();\n   434\t                break;\n   435\t            case 10:\n   436\t                compare_scenes();\n   437\t                break;\n   438\t            case 11:\n   439\t                delete_scene();\n   440\t                break;\n   441\t            case 12:\n   442\t                printf(\"\\nCleaning up and exiting...\\n\");\n   443\t                for (int i = 0; i < scene_count; i++) {\n   444\t                    scene_destroy(scenes[i]);\n   445\t                }\n   446\t                shape_manager_cleanup();\n   447\t                printf(\"Goodbye!\\n\");\n   448\t                return 0;\n   449\t            default:\n   450\t                printf(\"Invalid choice\\n\");\n   451\t                break;\n   452\t        }\n   453\t    }\n   454\t    \n   455\t    // Cleanup\n   456\t    for (int i = 0; i < scene_count; i++) {\n   457\t        scene_destroy(scenes[i]);\n   458\t    }\n   459\t    shape_manager_cleanup();\n   460\t    \n   461\t    return 0;\n   462\t}\n","exit_code":0,"status":"completed"}}
