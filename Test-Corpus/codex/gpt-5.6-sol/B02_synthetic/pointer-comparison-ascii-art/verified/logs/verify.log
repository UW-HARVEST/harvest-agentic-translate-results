{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'nl -ba c_src/src/scene.c && nl -ba c_src/src/shape.c'","aggregated_output":"     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t// scene.c\n    26\t#include \"scene.h\"\n    27\t#include <stdio.h>\n    28\t#include <stdlib.h>\n    29\t#include <string.h>\n    30\t\n    31\tscene_t* scene_create(const char *name) {\n    32\t    scene_t *scene = malloc(sizeof(scene_t));\n    33\t    if (!scene) {\n    34\t        return NULL;\n    35\t    }\n    36\t    \n    37\t    if (name) {\n    38\t        strncpy(scene->name, name, MAX_SCENE_NAME - 1);\n    39\t        scene->name[MAX_SCENE_NAME - 1] = '\\0';\n    40\t    } else {\n    41\t        strcpy(scene->name, \"Untitled Scene\");\n    42\t    }\n    43\t    \n    44\t    scene->shape_count = 0;\n    45\t    \n    46\t    return scene;\n    47\t}\n    48\t\n    49\tvoid scene_destroy(scene_t *scene) {\n    50\t    if (scene) {\n    51\t        // Note: We don't free the shapes themselves\n    52\t        // because they are singletons managed by shape_manager\n    53\t        free(scene);\n    54\t    }\n    55\t}\n    56\t\n    57\tint scene_add_shape(scene_t *scene, shape_t *shape) {\n    58\t    if (!scene || !shape) {\n    59\t        return -1;\n    60\t    }\n    61\t    \n    62\t    if (scene->shape_count >= MAX_SHAPES_IN_SCENE) {\n    63\t        fprintf(stderr, \"Error: Scene is full\\n\");\n    64\t        return -1;\n    65\t    }\n    66\t    \n    67\t    scene->shapes[scene->shape_count++] = shape;\n    68\t    return 0;\n    69\t}\n    70\t\n    71\tint scene_remove_shape(scene_t *scene, int index) {\n    72\t    if (!scene || index < 0 || index >= scene->shape_count) {\n    73\t        return -1;\n    74\t    }\n    75\t    \n    76\t    // Shift remaining shapes\n    77\t    for (int i = index; i < scene->shape_count - 1; i++) {\n    78\t        scene->shapes[i] = scene->shapes[i + 1];\n    79\t    }\n    80\t    \n    81\t    scene->shape_count--;\n    82\t    return 0;\n    83\t}\n    84\t\n    85\tvoid scene_print(const scene_t *scene) {\n    86\t    if (!scene) {\n    87\t        printf(\"(null scene)\\n\");\n    88\t        return;\n    89\t    }\n    90\t    \n    91\t    printf(\"\\n=== Scene: %s ===\\n\", scene->name);\n    92\t    printf(\"Contains %d shape(s)\\n\\n\", scene->shape_count);\n    93\t    \n    94\t    for (int i = 0; i < scene->shape_count; i++) {\n    95\t        printf(\"Shape #%d:\\n\", i + 1);\n    96\t        shape_print(scene->shapes[i]);\n    97\t        printf(\"\\n\");\n    98\t    }\n    99\t}\n   100\t\n   101\tint scene_equals(const scene_t *s1, const scene_t *s2) {\n   102\t    if (!s1 || !s2) {\n   103\t        return 0;\n   104\t    }\n   105\t    \n   106\t    // Scenes are equal if there's a 1:1 correspondence\n   107\t    if (s1->shape_count != s2->shape_count) {\n   108\t        return 0;\n   109\t    }\n   110\t    \n   111\t    // For each shape in s1, find a matching shape in s2\n   112\t    int matched[MAX_SHAPES_IN_SCENE] = {0};\n   113\t    \n   114\t    for (int i = 0; i < s1->shape_count; i++) {\n   115\t        int found = 0;\n   116\t        for (int j = 0; j < s2->shape_count; j++) {\n   117\t            if (!matched[j] && shape_equals(s1->shapes[i], s2->shapes[j])) {\n   118\t                matched[j] = 1;\n   119\t                found = 1;\n   120\t                break;\n   121\t            }\n   122\t        }\n   123\t        if (!found) {\n   124\t            return 0;\n   125\t        }\n   126\t    }\n   127\t    \n   128\t    return 1;\n   129\t}\n   130\t\n   131\tint scene_save(const scene_t *scene, const char *filename) {\n   132\t    if (!scene || !filename) {\n   133\t        return -1;\n   134\t    }\n   135\t    \n   136\t    FILE *file = fopen(filename, \"w\");\n   137\t    if (!file) {\n   138\t        fprintf(stderr, \"Error: Could not open file '%s' for writing\\n\", filename);\n   139\t        return -1;\n   140\t    }\n   141\t    \n   142\t    // Write scene name\n   143\t    fprintf(file, \"%s\\n\", scene->name);\n   144\t    \n   145\t    // Write shape count\n   146\t    fprintf(file, \"%d\\n\", scene->shape_count);\n   147\t    \n   148\t    // Write shape types (not the shapes themselves, just their types)\n   149\t    for (int i = 0; i < scene->shape_count; i++) {\n   150\t        fprintf(file, \"%d\\n\", scene->shapes[i]->type);\n   151\t    }\n   152\t    \n   153\t    fclose(file);\n   154\t    printf(\"Scene saved to '%s'\\n\", filename);\n   155\t    return 0;\n   156\t}\n   157\t\n   158\tscene_t* scene_load(const char *filename) {\n   159\t    if (!filename) {\n   160\t        return NULL;\n   161\t    }\n   162\t    \n   163\t    FILE *file = fopen(filename, \"r\");\n   164\t    if (!file) {\n   165\t        fprintf(stderr, \"Error: Could not open file '%s' for reading\\n\", filename);\n   166\t        return NULL;\n   167\t    }\n   168\t    \n   169\t    char name[MAX_SCENE_NAME];\n   170\t    if (fgets(name, MAX_SCENE_NAME, file) == NULL) {\n   171\t        fclose(file);\n   172\t        return NULL;\n   173\t    }\n   174\t    \n   175\t    // Remove newline\n   176\t    name[strcspn(name, \"\\n\")] = 0;\n   177\t    \n   178\t    scene_t *scene = scene_create(name);\n   179\t    if (!scene) {\n   180\t        fclose(file);\n   181\t        return NULL;\n   182\t    }\n   183\t    \n   184\t    int shape_count;\n   185\t    if (fscanf(file, \"%d\\n\", &shape_count) != 1) {\n   186\t        scene_destroy(scene);\n   187\t        fclose(file);\n   188\t        return NULL;\n   189\t    }\n   190\t    \n   191\t    for (int i = 0; i < shape_count; i++) {\n   192\t        int type;\n   193\t        if (fscanf(file, \"%d\\n\", &type) != 1) {\n   194\t            scene_destroy(scene);\n   195\t            fclose(file);\n   196\t            return NULL;\n   197\t        }\n   198\t        \n   199\t        shape_t *shape = shape_get((shape_type_t)type);\n   200\t        if (shape) {\n   201\t            scene_add_shape(scene, shape);\n   202\t        }\n   203\t    }\n   204\t    \n   205\t    fclose(file);\n   206\t    printf(\"Scene loaded from '%s'\\n\", filename);\n   207\t    return scene;\n   208\t}\n   209\t\n   210\tvoid scene_list_shapes(const scene_t *scene) {\n   211\t    if (!scene) {\n   212\t        printf(\"(null scene)\\n\");\n   213\t        return;\n   214\t    }\n   215\t    \n   216\t    printf(\"\\nScene: %s\\n\", scene->name);\n   217\t    printf(\"Shapes (%d):\\n\", scene->shape_count);\n   218\t    \n   219\t    for (int i = 0; i < scene->shape_count; i++) {\n   220\t        printf(\"  %d. %s (ptr: %p)\\n\", i + 1, \n   221\t               scene->shapes[i]->name, \n   222\t               (void*)scene->shapes[i]);\n   223\t    }\n   224\t}\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t// shape.c\n    26\t#include \"shape.h\"\n    27\t#include <stdio.h>\n    28\t#include <string.h>\n    29\t#include <stdlib.h>\n    30\t#include <stdint.h>\n    31\t\n    32\t// Singleton shape instances\n    33\tstatic shape_t *shapes[SHAPE_COUNT] = {NULL};\n    34\t\n    35\tstatic void init_tree(shape_t *shape) {\n    36\t    shape->type = SHAPE_TREE;\n    37\t    strcpy(shape->name, \"Tree\");\n    38\t    shape->height = 7;\n    39\t    shape->width = 11;\n    40\t    \n    41\t    strcpy(shape->art[0], \"    /\\\\    \");\n    42\t    strcpy(shape->art[1], \"   /  \\\\   \");\n    43\t    strcpy(shape->art[2], \"  /____\\\\  \");\n    44\t    strcpy(shape->art[3], \"  /    \\\\  \");\n    45\t    strcpy(shape->art[4], \" /______\\\\ \");\n    46\t    strcpy(shape->art[5], \"    ||    \");\n    47\t    strcpy(shape->art[6], \"    ||    \");\n    48\t}\n    49\t\n    50\tstatic void init_tractor(shape_t *shape) {\n    51\t    shape->type = SHAPE_TRACTOR;\n    52\t    strcpy(shape->name, \"Tractor\");\n    53\t    shape->height = 6;\n    54\t    shape->width = 20;\n    55\t    \n    56\t    strcpy(shape->art[0], \"      ________     \");\n    57\t    strcpy(shape->art[1], \"     |        |___ \");\n    58\t    strcpy(shape->art[2], \"     |  []  []|   |\");\n    59\t    strcpy(shape->art[3], \"  ___|________|___|\");\n    60\t    strcpy(shape->art[4], \" /  o        o   \\\\\");\n    61\t    strcpy(shape->art[5], \"|___|        |___| \");\n    62\t}\n    63\t\n    64\tstatic void init_house(shape_t *shape) {\n    65\t    shape->type = SHAPE_HOUSE;\n    66\t    strcpy(shape->name, \"House\");\n    67\t    shape->height = 7;\n    68\t    shape->width = 13;\n    69\t    \n    70\t    strcpy(shape->art[0], \"     /\\\\     \");\n    71\t    strcpy(shape->art[1], \"    /  \\\\    \");\n    72\t    strcpy(shape->art[2], \"   /____\\\\   \");\n    73\t    strcpy(shape->art[3], \"   |    |   \");\n    74\t    strcpy(shape->art[4], \"   | [] |   \");\n    75\t    strcpy(shape->art[5], \"   |    |   \");\n    76\t    strcpy(shape->art[6], \"   |____|   \");\n    77\t}\n    78\t\n    79\tstatic void init_sun(shape_t *shape) {\n    80\t    shape->type = SHAPE_SUN;\n    81\t    strcpy(shape->name, \"Sun\");\n    82\t    shape->height = 7;\n    83\t    shape->width = 11;\n    84\t    \n    85\t    strcpy(shape->art[0], \"  \\\\  |  / \");\n    86\t    strcpy(shape->art[1], \"   \\\\ | /  \");\n    87\t    strcpy(shape->art[2], \"--- (@) ---\");\n    88\t    strcpy(shape->art[3], \"   / | \\\\  \");\n    89\t    strcpy(shape->art[4], \"  /  |  \\\\ \");\n    90\t    strcpy(shape->art[5], \"          \");\n    91\t    strcpy(shape->art[6], \"          \");\n    92\t}\n    93\t\n    94\tstatic void init_cloud(shape_t *shape) {\n    95\t    shape->type = SHAPE_CLOUD;\n    96\t    strcpy(shape->name, \"Cloud\");\n    97\t    shape->height = 4;\n    98\t    shape->width = 16;\n    99\t    \n   100\t    strcpy(shape->art[0], \"   _____       \");\n   101\t    strcpy(shape->art[1], \"  /     \\\\_    \");\n   102\t    strcpy(shape->art[2], \" /  ___  _\\\\  \");\n   103\t    strcpy(shape->art[3], \"(__/   \\\\_)   \");\n   104\t}\n   105\t\n   106\tstatic void init_flower(shape_t *shape) {\n   107\t    shape->type = SHAPE_FLOWER;\n   108\t    strcpy(shape->name, \"Flower\");\n   109\t    shape->height = 7;\n   110\t    shape->width = 9;\n   111\t    \n   112\t    strcpy(shape->art[0], \"  \\\\|/  \");\n   113\t    strcpy(shape->art[1], \" -(@)- \");\n   114\t    strcpy(shape->art[2], \"  /|\\\\  \");\n   115\t    strcpy(shape->art[3], \"   |   \");\n   116\t    strcpy(shape->art[4], \"   |   \");\n   117\t    strcpy(shape->art[5], \"  / \\\\  \");\n   118\t    strcpy(shape->art[6], \" /   \\\\ \");\n   119\t}\n   120\t\n   121\tstatic void init_car(shape_t *shape) {\n   122\t    shape->type = SHAPE_CAR;\n   123\t    strcpy(shape->name, \"Car\");\n   124\t    shape->height = 4;\n   125\t    shape->width = 16;\n   126\t    \n   127\t    strcpy(shape->art[0], \"  ____       \");\n   128\t    strcpy(shape->art[1], \" /|_||_\\\\____ \");\n   129\t    strcpy(shape->art[2], \"( o     o  ) \");\n   130\t    strcpy(shape->art[3], \" -----------  \");\n   131\t}\n   132\t\n   133\tstatic void init_star(shape_t *shape) {\n   134\t    shape->type = SHAPE_STAR;\n   135\t    strcpy(shape->name, \"Star\");\n   136\t    shape->height = 5;\n   137\t    shape->width = 9;\n   138\t    \n   139\t    strcpy(shape->art[0], \"    *    \");\n   140\t    strcpy(shape->art[1], \"   ***   \");\n   141\t    strcpy(shape->art[2], \"  *****  \");\n   142\t    strcpy(shape->art[3], \" ******* \");\n   143\t    strcpy(shape->art[4], \"*********\");\n   144\t}\n   145\t\n   146\tstatic void init_heart(shape_t *shape) {\n   147\t    shape->type = SHAPE_HEART;\n   148\t    strcpy(shape->name, \"Heart\");\n   149\t    shape->height = 6;\n   150\t    shape->width = 11;\n   151\t    \n   152\t    strcpy(shape->art[0], \" *** ***  \");\n   153\t    strcpy(shape->art[1], \"*********  \");\n   154\t    strcpy(shape->art[2], \"*********  \");\n   155\t    strcpy(shape->art[3], \" ******* \");\n   156\t    strcpy(shape->art[4], \"  *****  \");\n   157\t    strcpy(shape->art[5], \"   ***   \");\n   158\t}\n   159\t\n   160\tstatic void init_rainbow(shape_t *shape) {\n   161\t    shape->type = SHAPE_RAINBOW;\n   162\t    strcpy(shape->name, \"Rainbow\");\n   163\t    shape->height = 5;\n   164\t    shape->width = 21;\n   165\t    \n   166\t    strcpy(shape->art[0], \"      _______      \");\n   167\t    strcpy(shape->art[1], \"    /         \\\\    \");\n   168\t    strcpy(shape->art[2], \"   /           \\\\   \");\n   169\t    strcpy(shape->art[3], \"  /             \\\\  \");\n   170\t    strcpy(shape->art[4], \" /               \\\\ \");\n   171\t}\n   172\t\n   173\tvoid shape_manager_init(void) {\n   174\t    // Allocate each shape once (singleton pattern)\n   175\t    for (int i = 0; i < SHAPE_COUNT; i++) {\n   176\t        shapes[i] = malloc(sizeof(shape_t));\n   177\t        if (!shapes[i]) {\n   178\t            fprintf(stderr, \"Error: Failed to allocate shape\\n\");\n   179\t            exit(1);\n   180\t        }\n   181\t    }\n   182\t    \n   183\t    // Initialize each shape\n   184\t    init_tree(shapes[SHAPE_TREE]);\n   185\t    init_tractor(shapes[SHAPE_TRACTOR]);\n   186\t    init_house(shapes[SHAPE_HOUSE]);\n   187\t    init_sun(shapes[SHAPE_SUN]);\n   188\t    init_cloud(shapes[SHAPE_CLOUD]);\n   189\t    init_flower(shapes[SHAPE_FLOWER]);\n   190\t    init_car(shapes[SHAPE_CAR]);\n   191\t    init_star(shapes[SHAPE_STAR]);\n   192\t    init_heart(shapes[SHAPE_HEART]);\n   193\t    init_rainbow(shapes[SHAPE_RAINBOW]);\n   194\t}\n   195\t\n   196\tvoid shape_manager_cleanup(void) {\n   197\t    for (int i = 0; i < SHAPE_COUNT; i++) {\n   198\t        free(shapes[i]);\n   199\t        shapes[i] = NULL;\n   200\t    }\n   201\t}\n   202\t\n   203\tshape_t* shape_get(shape_type_t type) {\n   204\t    if (type < 0 || type >= SHAPE_COUNT) {\n   205\t        return NULL;\n   206\t    }\n   207\t    return shapes[type];\n   208\t}\n   209\t\n   210\tvoid shape_print(const shape_t *shape) {\n   211\t    if (!shape) {\n   212\t        printf(\"(null shape)\\n\");\n   213\t        return;\n   214\t    }\n   215\t    \n   216\t    printf(\"%s:\\n\", shape->name);\n   217\t    for (int i = 0; i < shape->height; i++) {\n   218\t        printf(\"%s\\n\", shape->art[i]);\n   219\t    }\n   220\t}\n   221\t\n   222\tint shape_equals(const shape_t *s1, const shape_t *s2) {\n   223\t    return s1 == s2 ? 1 : 0;\n   224\t}\n   225\t\n   226\tconst char* shape_type_name(shape_type_t type) {\n   227\t    switch (type) {\n   228\t        case SHAPE_TREE: return \"Tree\";\n   229\t        case SHAPE_TRACTOR: return \"Tractor\";\n   230\t        case SHAPE_HOUSE: return \"House\";\n   231\t        case SHAPE_SUN: return \"Sun\";\n   232\t        case SHAPE_CLOUD: return \"Cloud\";\n   233\t        case SHAPE_FLOWER: return \"Flower\";\n   234\t        case SHAPE_CAR: return \"Car\";\n   235\t        case SHAPE_STAR: return \"Star\";\n   236\t        case SHAPE_HEART: return \"Heart\";\n   237\t        case SHAPE_RAINBOW: return \"Rainbow\";\n   238\t        default: return \"Unknown\";\n   239\t    }\n   240\t}\n","exit_code":0,"status":"completed"}}
