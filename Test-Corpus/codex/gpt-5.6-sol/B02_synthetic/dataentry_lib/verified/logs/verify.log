_table[4][3] = {\r\n    38\t    {10, 20, 30},\r\n    39\t    {40, 50, 60},\r\n    40\t    {70, 80, 90},\r\n    41\t    {100, 110, 120}\r\n    42\t};\r\n    43\t\r\n    44\tstatic DataEntry* find_entry(DataEntry* entries, int count, int target_id) {\r\n    45\t    DataEntry* ptr = entries;\r\n    46\t    DataEntry* end = entries + count;\r\n    47\t\r\n    48\t    while (ptr < end) {\r\n    49\t        if (ptr->id == target_id) {\r\n    50\t            return ptr;\r\n    51\t        }\r\n    52\t        ptr++;\r\n    53\t    }\r\n    54\t\r\n    55\t    return NULL;\r\n    56\t}\r\n    57\t\r\n    58\tstatic int process_name(char* dest, const char* src, int max_len) {\r\n    59\t    int len;\r\n    60\t\r\n    61\t    if (dest == NULL || *dest == '\\0') {\r\n    62\t        return -1;\r\n    63\t    }\r\n    64\t\r\n    65\t    strcpy(dest, src);\r\n    66\t\r\n    67\t    len = strlen(dest);\r\n    68\t    return len;\r\n    69\t}\r\n    70\t\r\n    71\tstatic int calculate_lookup(int row, int col, int* result) {\r\n    72\t    int temp;\r\n    73\t\r\n    74\t    if ((temp = lookup_table[row][col])) {\r\n    75\t        *result = temp * 2;\r\n    76\t        return 1;\r\n    77\t    }\r\n    78\t\r\n    79\t    return 0;\r\n    80\t}\r\n    81\t\r\n    82\tstatic DataEntry* create_entries(int count, int base_id) {\r\n    83\t    DataEntry* entries;\r\n    84\t    int i;\r\n    85\t    char temp_name[NAME_LENGTH];\r\n    86\t\r\n    87\t    entries = (DataEntry*)malloc(count * sizeof(DataEntry));\r\n    88\t\r\n    89\t    if (entries == NULL || count <= 0) {\r\n    90\t        return NULL;\r\n    91\t    }\r\n    92\t\r\n    93\t    for (i = 0; i < count; i++) {\r\n    94\t        entries[i].id = base_id + i;\r\n    95\t        entries[i].value = (base_id + i) * 10;\r\n    96\t\r\n    97\t        sprintf(temp_name, \"Entry_%d\", base_id + i);\r\n    98\t\r\n    99\t        strcpy(entries[i].name, temp_name);\r\n   100\t    }\r\n   101\t\r\n   102\t    return entries;\r\n   103\t}\r\n   104\t\r\n   105\tstatic int modify_entries(DataEntry* entries, int count, int multiplier) {\r\n   106\t    DataEntry* current;\r\n   107\t    DataEntry* last;\r\n   108\t    int total = 0;\r\n   109\t    int temp_value;\r\n   110\t\r\n   111\t    if (entries == NULL) {\r\n   112\t        return -1;\r\n   113\t    }\r\n   114\t\r\n   115\t    current = entries;\r\n   116\t    last = entries + count;\r\n   117\t\r\n   118\t    while (current < last) {\r\n   119\t        if ((temp_value = current->value)) {\r\n   120\t            current->value = temp_value * multiplier;\r\n   121\t            total += current->value;\r\n   122\t        }\r\n   123\t        current++;\r\n   124\t    }\r\n   125\t\r\n   126\t    return total;\r\n   127\t}\r\n   128\t\r\n   129\tint dataentry(int mode, int param1, int param2, int param3) {\r\n   130\t    DataEntry* entries = NULL;\r\n   131\t    DataEntry* found = NULL;\r\n   132\t    int result = 0;\r\n   133\t    int count;\r\n   134\t    int lookup_result;\r\n   135\t    char buffer[NAME_LENGTH];\r\n   136\t    int i;\r\n   137\t\r\n   138\t    buffer[0] = 'T';\r\n   139\t    buffer[1] = '\\0';\r\n   140\t\r\n   141\t    switch (mode) {\r\n   142\t        case 1:\r\n   143\t            count = param1 > 0 ? param1 : 5;\r\n   144\t            entries = create_entries(count, 100);\r\n   145\t\r\n   146\t            if (entries == NULL || count == 0) {\r\n   147\t                result = -1;\r\n   148\t                break;\r\n   149\t            }\r\n   150\t\r\n   151\t            found = find_entry(entries, count, 100 + param2);\r\n   152\t\r\n   153\t            if (found == NULL || found->id == 0) {\r\n   154\t                result = -2;\r\n   155\t            } else {\r\n   156\t                result = found->value;\r\n   157\t\r\n   158\t                strcpy(buffer, found->name);\r\n   159\t            }\r\n   160\t\r\n   161\t            free(entries);\r\n   162\t            break;\r\n   163\t\r\n   164\