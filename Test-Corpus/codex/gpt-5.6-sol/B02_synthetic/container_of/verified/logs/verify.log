{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'nl -ba translated_rust/c_src/src/container_of.c'","aggregated_output":"     1\t#include <stdlib.h>\n     2\t#include <string.h>\n     3\t#include <stdio.h>\n     4\t\n     5\t#define offsetof(TYPE, MEMBER)  ((size_t) (&(((TYPE *)(0))->MEMBER)))\n     6\t\n     7\t#define container_of(ptr, type, member) ({         \\\n     8\t    (type *)( (char *)ptr - offsetof(type, member) );})\n     9\t\n    10\tstruct test {\n    11\t    int a;\n    12\t    int b;\n    13\t};\n    14\t\n    15\tstruct test* find_container_of_a(int *i) {\n    16\t    return (container_of(i, struct test, a));\n    17\t}\n    18\t\n    19\tstruct test* find_container_of_b(int *i) {\n    20\t    return (container_of(i, struct test, b));\n    21\t}\n    22\t\n    23\tint main(int argc, char** argv) {\n    24\t    int a = atoi(argv[1]);\n    25\t    int b = atoi(argv[2]);\n    26\t\n    27\t    struct test t;\n    28\t\n    29\t    memset(&t, 0, sizeof(t));\n    30\t    t.a = a;\n    31\t    t.b = b;\n    32\t\n    33\t     printf(\"%d\\n\", find_container_of_a(&t.a)->a + find_container_of_b(&t.b)->b);\n    34\t}\n","exit_code":0,"status":"completed"}}
