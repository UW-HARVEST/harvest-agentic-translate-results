{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/lib.rs'","aggregated_output":"     1\tuse std::ffi::{c_char, c_int, c_void};\n     2\t\n     3\tunsafe extern \"C\" {\n     4\t    fn free(ptr: *mut c_void);\n     5\t    fn malloc(size: usize) -> *mut c_void;\n     6\t    fn printf(format: *const c_char, ...) -> c_int;\n     7\t    fn snprintf(buffer: *mut c_char, size: usize, format: *const c_char, ...) -> c_int;\n     8\t}\n     9\t\n    10\t#[unsafe(no_mangle)]\n    11\tpub extern \"C\" fn cleanup(a: c_int, b: c_int, c: c_int, d: c_int) -> c_int {\n    12\t    let numbers = [a, b, c, d];\n    13\t    let mut result: c_int = 0;\n    14\t\n    15\t    // The C validation compares two identical string literals and always succeeds.\n    16\t    for number in numbers {\n    17\t        result = result.wrapping_add(match number {\n    18\t            10 => 30,\n    19\t            20 => 20,\n    20\t            30 => 70,\n    21\t            40 => 40,\n    22\t            _ => number,\n    23\t        });\n    24\t    }\n    25\t\n    26\t    // SAFETY: The allocation is either freed by cleanup_resources or is null.\n    27\t    let dynamic_str = unsafe { malloc(50).cast::<c_char>() };\n    28\t    if dynamic_str.is_null() {\n    29\t        // SAFETY: The argument is a static, null-terminated format string.\n    30\t        unsafe {\n    31\t            printf(c\"Memory allocation failed.\\n\".as_ptr());\n    32\t        }\n    33\t    } else {\n    34\t        // SAFETY: dynamic_str references 50 writable bytes, and all strings are\n    35\t        // static and null-terminated.\n    36\t        unsafe {\n    37\t            snprintf(\n    38\t                dynamic_str,\n    39\t                50,\n    40\t                c\"Processed numbers: %s\".as_ptr(),\n    41\t                c\"numbers\".as_ptr(),\n    42\t            );\n    43\t            printf(c\"%s\\n\".as_ptr(), dynamic_str);\n    44\t    