  37\t    char *dynamic_str = NULL;\r\n    38\t    int result = 0;\r\n    39\t\r\n    40\t    const char *expected_str = \"VALID\";\r\n    41\t    const char *input_str = \"VALID\";\r\n    42\t    if (strncmp(input_str, expected_str, strlen(expected_str)) != 0) {\r\n    43\t        printf(\"Input string validation failed.\\n\");\r\n    44\t        goto cleanup;\r\n    45\t    }\r\n    46\t\r\n    47\t    for (int i = 0; i < 4; i++) {\r\n    48\t        switch (numbers[i]) {\r\n    49\t            case 10:\r\n    50\t                result += 10;\r\n    51\t            case 20:\r\n    52\t                result += 20;\r\n    53\t                break;\r\n    54\t            case 30:\r\n    55\t                result += 30;\r\n    56\t            case 40:\r\n    57\t                result += 40;\r\n    58\t                break;\r\n    59\t            default:\r\n    60\t                result += numbers[i];\r\n    61\t                break;\r\n    62\t        }\r\n    63\t    }\r\n    64\t\r\n    65\t    dynamic_str = (char *)malloc(50 * sizeof(char));\r\n    66\t    if (!dynamic_str) {\r\n    67\t        printf(\"Memory allocation failed.\\n\");\r\n    68\t        goto cleanup;\r\n    69\t    }\r\n    70\t\r\n    71\t    snprintf(dynamic_str, 50, \"Processed numbers: %s\", TO_STRING(numbers));\r\n    72\t    printf(\"%s\\n\", dynamic_str);\r\n    73\t\r\n    74\tcleanup:\r\n    75\t    cleanup_resources(dynamic_str);\r\n    76\t    return result;\r\n    77\t}\r\n    78\t\r\n    79\tvoid print_result(const char *label, int result) {\r\n    80\t    printf(\"%s: %d\\n\", label, result);\r\n    81\t}\r\n    82\t\r\n    83\tvoid cleanup_resources(char *dynamic_str) {\r\n    84\t    if (dynamic_str) {\r\n    85\t        free(dynamic_str);\r\n    86\t        dynamic_str = NULL;\r\n    87\t    }\r\n    88\t}\r\n","exit_code":0,"status":"completed"}}
