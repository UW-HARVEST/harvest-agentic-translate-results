pos, remaining);\n   208\t    }\n   209\t    dst2->length = remaining;\n   210\t    dst2->checksum = calculate_checksum(dst2->data, dst2->length);\n   211\t    \n   212\t    return 0;\n   213\t}\n   214\t\n   215\t// Interleave two buffers (alternating bytes)\n   216\tint buffer_interleave(const buffer_t *src1, const buffer_t *src2, buffer_t *dst) {\n   217\t    if (!src1 || !src2 || !dst) {\n   218\t        fprintf(stderr, \"Error: NULL pointer in buffer_interleave\\n\");\n   219\t        return -1;\n   220\t    }\n   221\t    \n   222\t    size_t max_len = src1->length > src2->length ? src1->length : src2->length;\n   223\t    if (src1->length + src2->length > 256) {\n   224\t        fprintf(stderr, \"Error: Interleaved length exceeds maximum\\n\");\n   225\t        return -1;\n   226\t    }\n   227\t    \n   228\t    size_t dst_pos = 0;\n   229\t    for (size_t i = 0; i < max_len; i++) {\n   230\t        if (i < src1->length) {\n   231\t            memcpy(&dst->data[dst_pos++], &src1->data[i], 1);\n   232\t        }\n   233\t        if (i < src2->length) {\n   234\t            memcpy(&dst->data[dst_pos++], &src2->data[i], 1);\n   235\t        }\n   236\t    }\n   237\t    \n   238\t    dst->length = dst_pos;\n   239\t    dst->checksum = calculate_checksum(dst->data, dst->length);\n   240\t    \n","exit_code":0,"status":"completed"}}
