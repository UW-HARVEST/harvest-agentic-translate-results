{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' c_src/src/lib.c\"","aggregated_output":"#include <math.h>\n\n#include \"lib.h\"\n\nvoid hsl_to_rgb(float *dest, const float *src) {\n    float h = src[0];\n    float s = src[1];\n    float l = src[2];\n    float c, m, x;\n    if (s == 0) {\n        dest[0] = l;\n        dest[1] = l;\n        dest[2] = l;\n        return;\n    }\n    c = (1.0f - fabsf(2.0f * l - 1.0f)) * s;\n    m = 1.0f * (l - 0.5f * c);\n    x = c * (1.0f - fabsf(fmodf(h / 60.0f, 2) - 1.0f));\n    if (h >= 0.0f && h < 60.0f) {\n        dest[0] = c + m;\n        dest[1] = x + m;\n        dest[2] = m;\n    } else if (h >= 60.0f && h < 120.0f) {\n        dest[0] = x + m;\n        dest[1] = c + m;\n        dest[2] = m;\n    } else if (h < 120.0f && h < 180.0f) {\n        dest[0] = m;\n        dest[1] = c + m;\n        dest[2] = x + m;\n    } else if (h >= 180.0f && h < 240.0f) {\n        dest[0] = m;\n        dest[1] = x + m;\n        dest[2] = c + m;\n    } else if (h >= 240.0f && h < 300.0f) {\n        dest[0] = x + m;\n        dest[1] = m;\n        dest[2] = c + m;\n    } else if (h >= 300.0f && h < 360.0f) {\n        dest[0] = c + m;\n        dest[1] = m;\n        dest[2] = x + m;\n    } else {\n        dest[0] = m;\n        dest[1] = m;\n        dest[2] = m;\n    }\n}\n","exit_code":0,"status":"completed"}}
