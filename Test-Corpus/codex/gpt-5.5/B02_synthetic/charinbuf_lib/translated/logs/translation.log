{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes, os, sys\n\nlibs = {\n    'c': '/tmp/harvest_charinbuf_c.so',\n    'rust': 'target/release/libtranslated_rust.so',\n}\nloaded = {k: ctypes.CDLL(os.path.abspath(v)) for k, v in libs.items()}\nfor lib in loaded.values():\n    lib.charinbuf.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int]\n    lib.charinbuf.restype = ctypes.c_int\nlibc = ctypes.CDLL(None)\nlibc.fflush.argtypes = [ctypes.c_void_p]\nlibc.fflush.restype = ctypes.c_int\n\ndef call_capture(fn, args):\n    libc.fflush(None)\n    rfd, wfd = os.pipe()\n    saved = os.dup(1)\n    try:\n        os.dup2(wfd, 1)\n        os.close(wfd)\n        ret = fn(*args)\n        libc.fflush(None)\n        os.dup2(saved, 1)\n        chunks = []\n        while True:\n            data = os.read(rfd, 4096)\n            if not data:\n                break\n            chunks.append(data)\n        return ret, b''.join(chunks)\n    finally:\n        try:\n            os.dup2(saved, 1)\n        except OSError:\n            pass\n        os.close(saved)\n        try:\n            os.close(rfd)\n        except OSError:\n            pass\n\ncases = [\n    (0, -1, 2, 3),\n    (0, 0, 2, 3),\n    (0, 65535, 2, 3),\n    (0, 65536, 2, 3),\n    (1, 7, 2, 3),\n    (2, 7, 2, 3),\n    (3, 10, 4, 3),\n    (3, -2, -5, 4),\n    (4, 7, 2, 3),\n    (99, 7, 2, 3),\n]\n\nok = True\nfor args in cases:\n    c_res = call_capture(loaded['c'].charinbuf, args)\n    r_res = call_capture(loaded['rust'].charinbuf, args)\n    same = c_res == r_res\n    print(args, 'OK' if same else 'DIFF', 'c_ret=', c_res[0], 'rust_ret=', r_res[0], 'c_len=', len(c_res[1]), 'rust_len=', len(r_res[1]))\n    if not same:\n        ok = False\n        print('--- C ---')\n        sys.stdout.buffer.write(c_res[1])\n        print('--- Rust ---')\n        sys.stdout.buffer.write(r_res[1])\nif not ok:\n    raise SystemExit(1)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
