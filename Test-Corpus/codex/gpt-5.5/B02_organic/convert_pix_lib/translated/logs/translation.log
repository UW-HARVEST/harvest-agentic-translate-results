{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes, zlib\nfrom ctypes import c_int, c_void_p, c_ubyte, Structure\n\nclass Pixel(Structure):\n    _fields_ = [('r', c_ubyte), ('g', c_ubyte), ('b', c_ubyte), ('a', c_ubyte)]\n\nlibs = [ctypes.CDLL('/tmp/harvest-translate-o9RUrY/libc_orig.so'), ctypes.CDLL('target/release/libtranslated_rust.so')]\nfor lib in libs:\n    lib.cp_inflate.argtypes = [c_void_p, c_int, c_void_p, c_int]\n    lib.cp_inflate.restype = c_int\n    lib.convert_pix.argtypes = [c_int, c_int, c_int, ctypes.POINTER(c_ubyte), ctypes.POINTER(Pixel)]\n    lib.convert_pix.restype = None\n\ndef raw_deflate(data, level=6, strategy=zlib.Z_DEFAULT_STRATEGY):\n    co = zlib.compressobj(level, zlib.DEFLATED, -15, strategy=strategy)\n    return co.compress(data) + co.flush()\n\npayloads = [b'', b'hello world', b'a' * 300, bytes(range(256)) * 3]\nstrategies = [zlib.Z_DEFAULT_STRATEGY, zlib.Z_FIXED, zlib.Z_HUFFMAN_ONLY]\nfor payload in payloads:\n    for strategy in strategies:\n        comp = raw_deflate(payload, strategy=strategy)\n        results = []\n        for lib in libs:\n            ibuf = ctypes.create_string_buffer(comp)\n            obuf = ctypes.create_string_buffer(max(len(payload), 1) + 16)\n            rc = lib.cp_inflate(ibuf, len(comp), obuf, len(payload))\n            results.append((rc, obuf.raw[:len(payload)]))\n        assert results[0] == results[1], (payload[:20], strategy, results)\n        assert results[0] == (1, payload), (payload[:20], strategy, results[0])\n\nfor bpp in (1,2,3,4):\n    w,h = 5,3\n    row = 1 + w*bpp\n    src_bytes = bytes((i * 17 + bpp) & 255 for i in range(row*h))\n    outs = []\n    for lib in libs:\n        src = (c_ubyte * len(src_bytes)).from_buffer_copy(src_bytes)\n        dst = (Pixel * (w*h))()\n        lib.convert_pix(bpp, w, h, src, dst)\n        outs.append(bytes(ctypes.string_at(ctypes.byref(dst), ctypes.sizeof(dst))))\n    assert outs[0] == outs[1], bpp\nprint('C/Rust smoke comparison passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
