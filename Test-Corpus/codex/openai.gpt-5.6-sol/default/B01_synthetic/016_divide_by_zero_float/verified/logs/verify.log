{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/main.rs'","aggregated_output":"     1\tuse std::ffi::{c_char, c_double};\n     2\tuse std::io::{self, Read};\n     3\t\n     4\tconst CHAR_ARRAY_SIZE: usize = 20;\n     5\t\n     6\tunsafe extern \"C\" {\n     7\t    fn atof(input: *const c_char) -> c_double;\n     8\t}\n     9\t\n    10\tfn print_line(line: &str) {\n    11\t    println!(\"{line}\");\n    12\t}\n    13\t\n    14\tfn print_int_line(number: i32) {\n    15\t    println!(\"{number}\");\n    16\t}\n    17\t\n    18\tfn fgets<R: Read>(reader: &mut R) -> io::Result<Option<Vec<u8>>> {\n    19\t    let mut input = Vec::with_capacity(CHAR_ARRAY_SIZE);\n    20\t\n    21\t    while input.len() < CHAR_ARRAY_SIZE - 1 {\n    22\t        let mut byte = [0_u8; 1];\n    23\t        match reader.read(&mut byte)? {\n    24\t            0 => break,\n    25\t            _ => {\n    26\t                input.push(byte[0]);\n    27\t                if byte[0] == b'\\n' {\n    28\t                    break;\n    29\t                }\n    30\t            }\n    31\t        }\n    32\t    }\n    33\t\n    34\t    if input.is_empty() {\n    35\t        Ok(None)\n    36\t    } else {\n    37\t        Ok(Some(input))\n    38\t    }\n    39\t}\n    40\t\n    41\tfn parse_atof(mut input: Vec<u8>) -> f32 {\n    42\t    input.push(0);\n    43\t\n    44\t    // The appended NUL gives libc the same byte sequence that fgets provides.\n    45\t    unsafe { atof(input.as_ptr().cast()) as f32 }\n    46\t}\n    47\t\n    48\tfn read_data<R: Read>(reader: &mut R) -> f32 {\n    49\t    match fgets(reader) {\n    50\t        Ok(Some(input)) => parse_atof(input),\n    51\t        Ok(None) | Err(_) => {\n    52\t            print_line(\"fgets() failed.\");\n    53\t            0.0\n    54\t        }\n    55\t    }\n    56\t}\n    57\t\n    58\tfn c_double_to_int(value: f64) -> i32 {\n    59\t    if value.is_nan() || value >= 2_147_483_648.0 {\n    60\t        i32::MIN\n    61\t    } else {\n    62\t        value as i32\n    63\t    }\n    64\t}\n    65\t\n    66\tfn divide_to_int(data: f32) -> i32 {\n    67\t    c_double_to_int(100.0 / f64::from(data))\n    68\t}\n    69\t\n    70\tfn bad<R: Read>(reader: &mut R) {\n    71\t    let data = read_data(reader);\n    72\t    let result = divide_to_int(data);\n    73\t    print_int_line(result);\n    74\t}\n    75\t\n    76\tfn good_g2b() {\n    77\t    let data = 2.0_f32;\n    78\t    let result = divide_to_int(data);\n    79\t    print_int_line(result);\n    80\t}\n    81\t\n    82\tfn good_b2g<R: Read>(reader: &mut R) {\n    83\t    let data = read_data(reader);\n    84\t\n    85\t    if f64::from(data).abs() > 0.000001 {\n    86\t        let result = divide_to_int(data);\n    87\t        print_int_line(result);\n    88\t    } else {\n    89\t        print_line(\"This would result in a divide by zero\");\n    90\t    }\n    91\t}\n    92\t\n    93\tfn good<R: Read>(reader: &mut R) {\n    94\t    good_g2b();\n    95\t    good_b2g(reader);\n    96\t}\n    97\t\n    98\tfn main() {\n    99\t    let stdin = io::stdin();\n   100\t    let mut stdin = stdin.lock();\n   101\t\n   102\t    print_line(\"Calling good()...\");\n   103\t    good(&mut stdin);\n   104\t    print_line(\"Finished good()\");\n   105\t    print_line(\"Calling bad()...\");\n   106\t    bad(&mut stdin);\n   107\t    print_line(\"Finished bad()\");\n   108\t}\n","exit_code":0,"status":"completed"}}
