2g(data: c_int) {\n    59\t    let mut buffer = [0; 10];\n    60\t\n    61\t    if data >= 0 && data < 10 {\n    62\t        buffer[data as usize] = 1;\n    63\t        for value in buffer {\n    64\t            printIntLine(value);\n    65\t        }\n    66\t    } else {\n    67\t        printLine(OUT_OF_BOUNDS_ERROR.as_ptr().cast());\n    68\t    }\n    69\t}\n    70\t\n    71\t#[unsafe(no_mangle)]\n    72\tpub extern \"C\" fn good(data: c_int) {\n    73\t    good_g2b();\n    74\t    good_b2g(data);\n    75\t}\n    76\t\n    77\t#[unsafe(no_mangle)]\n    78\tpub extern \"C\" fn driver(good_data: c_int, bad_data: c_int) {\n    79\t    printLine(c\"Calling good()...\".as_ptr());\n    80\t    good(good_data);\n    81\t    printLine(c\"Finished good()\".as_ptr());\n    82\t    printLine(c\"Calling bad()...\".as_ptr());\n    83\t    bad(bad_data);\n    84\t    printLine(c\"Finished bad()\".as_ptr());\n    85\t}\n","exit_code":0,"status":"completed"}}
