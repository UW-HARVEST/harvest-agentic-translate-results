{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' src/main.rs\"","aggregated_output":"use std::io::{self, Read};\n\nfn scanf_decimal(input: &[u8]) -> Option<i32> {\n    let mut index = 0;\n    while index < input.len()\n        && matches!(input[index], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n    {\n        index += 1;\n    }\n\n    let negative = match input.get(index) {\n        Some(b'+') => {\n            index += 1;\n            false\n        }\n        Some(b'-') => {\n            index += 1;\n            true\n        }\n        _ => false,\n    };\n\n    let digit_start = index;\n    let mut value = 0_i32;\n    while let Some(digit @ b'0'..=b'9') = input.get(index).copied() {\n        value = value\n            .wrapping_mul(10)\n            .wrapping_add(i32::from(digit - b'0'));\n        index += 1;\n    }\n\n    (index != digit_start).then(|| if negative { value.wrapping_neg() } else { value })\n}\n\nfn driver(x: i32) {\n    let mut y = x.wrapping_mul(2);\n    y = y.wrapping_add(300);\n    println!(\"{y}\");\n}\n\nfn main() {\n    let mut input = Vec::new();\n    io::stdin().read_to_end(&mut input).unwrap();\n\n    let mut x = 0;\n    if let Some(parsed) = scanf_decimal(&input) {\n        x = parsed;\n    }\n    driver(x);\n}\n","exit_code":0,"status":"completed"}}
