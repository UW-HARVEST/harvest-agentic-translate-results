{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/lib.rs'","aggregated_output":"     1\tuse std::ffi::{c_char, c_float, c_int};\n     2\t\n     3\tconst STRING_FORMAT: &[u8] = b\"%s\\n\\0\";\n     4\tconst INTEGER_FORMAT: &[u8] = b\"%d\\n\\0\";\n     5\tconst DIVIDE_BY_ZERO_MESSAGE: &[u8] = b\"This would result in a divide by zero\\0\";\n     6\tconst CALLING_GOOD_MESSAGE: &[u8] = b\"Calling good()...\\0\";\n     7\tconst FINISHED_GOOD_MESSAGE: &[u8] = b\"Finished good()\\0\";\n     8\tconst CALLING_BAD_MESSAGE: &[u8] = b\"Calling bad()...\\0\";\n     9\tconst FINISHED_BAD_MESSAGE: &[u8] = b\"Finished bad()\\0\";\n    10\t\n    11\tunsafe extern \"C\" {\n    12\t    #[link_name = \"printf\"]\n    13\t    fn c_printf(format: *const c_char, ...) -> c_int;\n    14\t}\n    15\t\n    16\t#[inline]\n    17\tfn c_double_to_int(value: f64) -> c_int {\n    18\t    // GCC's x86-64 conversion yields INT_MIN for NaN and positive overflow.\n    19\t    if value.is_nan() || value >= 2_147_483_648.0 {\n    20\t        c_int::MIN\n    21\t    } else {\n    22\t        value as c_int\n    23\t    }\n    24\t}\n    25\t\n    26\t#[unsafe(no_mangle)]\n    27\tpub unsafe extern \"C\" fn printLine(line: *const c_char) {\n    28\t    if !line.is_null() {\n    29\t        unsafe {\n    30\t            c_printf(STRING_FORMAT.as_ptr().cast(), line);\n    31\t        }\n    32\t    }\n    33\t}\n    34\t\n    35\t#[unsafe(no_mangle)]\n    36\tpub extern \"C\" fn printIntLine(int_number: c_int) {\n    37\t    unsafe {\n    38\t        c_printf(INTEGER_FORMAT.as_ptr().cast(), int_number);\n    39\t    }\n    40\t}\n    41\t\n    42\t#[unsafe(no_mangle)]\n    43\tpub extern \"C\" fn bad(data: c_float) {\n    44\t    let result = c_double_to_int(100.0 / f64::from(data));\n    45\t    printIntLine(result);\n    46\t}\n    47\t\n    48\tfn good_g2b() {\n    49\t    let data = 2.0_f32;\n    50\t    let result = c_double_to_int(100.0 / f64: