{\n    47\t        char result = data * 2;\n    48\t        printHexCharLine(result);\n    49\t    }\n    50\t}\n    51\t\n    52\tstatic void goodG2B()\n    53\t{\n    54\t    char data;\n    55\t    data = 2;\n    56\t    if(data > 0)\n    57\t    {\n    58\t        char result = data * 2;\n    59\t        printHexCharLine(result);\n    60\t    }\n    61\t}\n    62\t\n    63\tstatic void goodB2G()\n    64\t{\n    65\t    char data;\n    66\t    data = ' ';\n    67\t    data = CHAR_MAX;\n    68\t    if(data > 0)\n    69\t    {\n    70\t        if (data < (CHAR_MAX/2))\n    71\t        {\n    72\t            char result = data * 2;\n    73\t            printHexCharLine(result);\n    74\t        }\n    75\t        else\n    76\t        {\n    77\t            printLine(\"data value is too large to perform arithmetic safely.\");\n    78\t        }\n    79\t    }\n    80\t}\n    81\t\n    82\tvoid good()\n    83\t{\n    84\t    goodG2B();\n    85\t    goodB2G();\n    86\t}\n    87\t\n    88\tint main() {\n    89\t    int x = 0;\n    90\t    scanf(\"%d\", &x);\n    91\t\n    92\t    if (x)\n    93\t    {\n    94\t        good();\n    95\t    }\n    96\t    else\n    97\t    {\n    98\t        bad();\n    99\t    }\n   100\t    return 0;\n   101\t}\n","exit_code":0,"status":"completed"}}
