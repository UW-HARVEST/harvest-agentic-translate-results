 {\n    print_the_house();\n    add_floor_to_the_house();\n    print_the_house();\n    the_house.bathrooms += 1.0;\n    print_the_house();\n    add_bedrooms(&the_house, extra_bedrooms);\n    print_the_house();\n}\n\nvoid driver(int x) {\n    run(x);\n    run(x);\n}\n","exit_code":0,"status":"completed"}}
