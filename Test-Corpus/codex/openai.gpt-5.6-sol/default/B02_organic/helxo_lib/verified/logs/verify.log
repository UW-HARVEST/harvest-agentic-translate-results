      array.cast::<u8>().add(element_size * final_index as usize),\n   740\t            array.cast::<u8>().add(element_size * old_index as usize),\n   741\t            element_size,\n   742\t        );\n   743\t        let moved_key = array\n   744\t            .cast::<u8>()\n   745\t            .add(element_size * old_index as usize)\n   746\t            .add(key_offset);\n   747\t        slot = if mode == HM_STRING {\n   748\t            find_slot(\n   749\t                array,\n   750\t                element_size,\n   751\t                *moved_key.cast::<*mut c_char>() as *mut c_void,\n   752\t                key_size,\n   753\t                key_offset,\n   754\t                mode,\n   755\t            )\n   756\t        } else {\n   757\t            find_slot(\n   758\t                array,\n   759\t                element_size,\n   760\t                moved_key.cast(),\n   761\t                key_size,\n   762\t                key_offset,\n   763\t                mode,\n   764\t            )\n   765\t        };\n   766\t        bucket = (*table).storage.add(slot as usize >> BUCKET_SHIFT);\n   767\t        bucket_item = slot as usize & BUCKET_MASK;\n   768\t        (*bucket).index[bucket_item] = old_index;\n   769\t    }\n   770\t    (*header(raw_array)).length -= 1;\n   771\t\n   772\t    if (*table).used_count < (*table).used_count_shrink_threshold\n   773\t        && (*table).slot_count > BUCKET_LENGTH\n   774\t    {\n   775\t        let new_table = make_hash_index((*table).slot_count >> 1, table);\n   776\t        (*header(raw_array)).hash_table = new_table.cast();\n   777\t        free(table.cast());\n   778\t        table = new_table;\n   779\t    } else if (*table).tombstone_count > (*table).tombstone_count_threshold {\n   780\t        let new_table = make_hash_index((*table).slot_count, table);\n   781\t        (*header(raw_array)).hash_table = new_table.cast();\n   782\t        free(table.cast());\n   783\t        table = new_table;\n   784\