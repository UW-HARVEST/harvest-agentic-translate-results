44\t    }\n   645\t    (*table).used_count += 1;\n   646\t\n   647\t    let item = array_length(raw_array) as isize;\n   648\t    if item as usize + 1 > array_capacity(raw_array) {\n   649\t        raw_array = stbds_arrgrowf(raw_array, element_size, 1, 0);\n   650\t    }\n   651\t    raw_visible = array_to_hash(raw_array, element_size);\n   652\t    (*header(raw_array)).length = item as usize + 1;\n   653\t\n   654\t    let bucket = (*table).storage.add(position >> BUCKET_SHIFT);\n   655\t    (*bucket).hash[position & BUCKET_MASK] = hash;\n   656\t    (*bucket).index[position & BUCKET_MASK] = item - 1;\n   657\t    (*header(raw_array)).temp = item - 1;\n   658\t\n   659\t    let item_pointer = raw_array\n   660\t        .cast::<u8>()\n   661\t        .add(element_size.wrapping_mul(item as usize));\n   662\t    match (*table).string.mode {\n   663\t        SH_STRDUP => {\n   664\t            let stored = duplicate_string(key.cast());\n   665\t            *item_pointer.cast::<*mut c_char>() = stored;\n   666\t            (*table).temp_key = stored;\n   667\t        }\n   668\t        SH_ARENA => {\n   669\t            let stored = stbds_stralloc(&mut (*table).string, key.cast());\n   670\t            *item_pointer.cast::<*mut c_char>() = stored;\n   671\t            (*table).temp_key = stored;\n   672\t        }\n   673\t        SH_DEFAULT => {\n   674\t            let stored = key.cast::<c_char>();\n   675\t            *item_pointer.cast::<*mut c_char>() = stored;\n   676\t            (*table).temp_key = stored;\n   677\t        }\n   678\t        _ => copy_nonoverlapping(key.cast::<u8>(), item_pointer, key_size),\n   679\t    }\n   680\t    raw_visible\n   681\t}\n   682\t\n   683\t#[unsafe(no_mangle)]\n   684\tpub unsafe extern \"C\" fn stbds_shmode_func(element_size: usize, mode: c_int) -> *mut c_void {\n   685\t    let array = stbds_arrgrowf(null_mut(), element_size, 0, 1);\n   686\t    write_bytes(array.cast::<u8>(), 0, element_size);\n   687\t    (*header(array