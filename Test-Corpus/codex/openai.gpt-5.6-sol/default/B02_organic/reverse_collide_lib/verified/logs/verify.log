  434\t}\n   435\t\n   436\t#[unsafe(no_mangle)]\n   437\t#[inline(never)]\n   438\tpub extern \"C\" fn c2Neg(a: C2v) -> C2v {\n   439\t    c2V(-a.x, -a.y)\n   440\t}\n   441\t\n   442\t#[unsafe(no_mangle)]\n   443\t#[inline(never)]\n   444\tpub extern \"C\" fn c2Skew(a: C2v) -> C2v {\n   445\t    C2v { x: -a.y, y: a.x }\n   446\t}\n   447\t\n   448\t#[unsafe(no_mangle)]\n   449\t#[inline(never)]\n   450\tpub extern \"C\" fn c2CCW90(a: C2v) -> C2v {\n   451\t    C2v { x: a.y, y: -a.x }\n   452\t}\n   453\t\n   454\t#[unsafe(no_mangle)]\n   455\t#[inline(never)]\n   456\tpub unsafe extern \"C\" fn c2D(s: *mut C2Simplex) -> C2v {\n   457\t    let s = unsafe { &*s };\n   458\t    match s.count {\n   459\t        1 => c2Neg(s.a.p),\n   460\t        2 => {\n   461\t            let ab = c2Sub(s.b.p, s.a.p);\n   462\t            if c2Det2(ab, c2Neg(s.a.p)) > 0.0 {\n   463\t                c2Skew(ab)\n   464\t            } else {\n   465\t                c2CCW90(ab)\n   466\t            }\n   467\t        }\n   468\t        _ => c2V(0.0, 0.0),\n   469\t    }\n   470\t}\n   471\t\n   472\t#[unsafe(no_mangle)]\n   473\t#[inline(never)]\n   474\tpub unsafe extern \"C\" fn c2Support(verts: *const C2v, count: c_int, d: C2v) -> c_int {\n   475\t    let mut imax = 0;\n   476\t    let mut dmax = c2Dot(unsafe { *verts }, d);\n   477\t    let mut i = 1;\n   478\t    while i < count {\n   479\t        let dot = c2Dot(unsafe { *verts.add(i as usize) }, d);\n   480\t        if dot > dmax {\n   481\t            imax = i;\n   482\t            dmax = dot;\n   483\t        }\n   484\t        i += 1;\n   485\t    }\n   486\t    imax\n   487\t}\n   488\t\n   489\t#[unsafe(no_mangle)]\n   490\t#[inline(never)]\n   491\tpub unsafe extern \"C\" fn c2Witness(s: *mut C2Simplex, a: *mut C2v, b: *mut C2v) {\n   492\t    let s = unsafe { &*s };\n   493\t    let den = 1.0 / s.div;\n   494\t    unsafe {\n   495\t        match s.count {\n   496\t            1 => {\n   497\t                *a = s.a.s_a;\n   498\t                *b = s.a.s_b;\n   499\t            }\n   500\t            2 => {\n   501\t                *a = c2Add(c2Mulvs(s.a.s_a, den * s.a.u), c2Mulvs(s.b.s_a, den * s.b.u));\n   502\t                *b = c2Add(c2Mulvs(s.a.s_b, den * s.a.u), c2Mulvs(s.b.s_b, den * s.b.u));\n   503\t            }\n   504\t            3 => {\n   505\t                *a = c2Add(\n   506\t                    c2Add(c2Mulvs(s.a.s_a, den * s.a.u), c2Mulvs(s.b.s_a, den * s.b.u)),\n   507\t                    c2Mulvs(s.c.s_a, den * s.c.u),\n   508\t                );\n   509\t                *b = c2Add(\n   510\t                    c2Add(c2Mulvs(s.a.s_b, den * s.a.u), c2Mulvs(s.b.s_b, den * s.b.u)),\n   511\t                    c2Mulvs(s.c.s_b, den * s.c.u),\n   512\t                );\n   513\t            }\n   514\t            _ => {\n   515\t                *a = c2V(0.0, 0.0);\n   516\t                *b = c2V(0.0, 0.0);\n   517\t            }\n   518\t        }\n   519\t    }\n   520\t}\n   521\t\n   522\t#[unsafe(no_mangle)]\n   523\t#[inline(never)]\n   524\tpub extern \"C\" fn c2Div(a: C2v, b: c_float) -> C2v {\n   525\t    c2Mulvs(a, div_left(1.0, b))\n   526\t}\n   527\t\n   528\t#[unsafe(no_mangle)]\n   529\t#[inline(never)]\n   530\tpub extern \"C\" fn c2Norm(a: C2v) -> C2v {\n   531\t    c2Div(a, c2Len(a))\n   532\t}\n   533\t\n   534\t#[unsafe(no_mangle)]\n   535\t#[inline(never)]\n   536\tpub unsafe extern \"C\" fn c2L(s: *mut C2Simplex) -> C2v {\n   537\t    let s = unsafe { &*s };\n   538\t    let den = 1.0 / s.div;\n   539\t    match s.count {\n   540\t        1 => s.a.p,\n   541\t        2 => c2Add(c2Mulvs(s.a.p, den * s.a.u), c2Mulvs(s.b.p, den * s.b.u)),\n   542\t        _ => c2V(0.0, 0.0),\n   543\t    }\n   544\t}\n   545\t\n   546\t#[unsafe(no_mangle)]\n   547\t#[inline(never)]\n   548\tpub extern \"C\" fn c2MulrvT(a: C2r, b: C2v) -> C2v {\n   549\t    c2V(\n   550\t        add_left(mul_left(a.c, b.x), mul_left(a.s, b.y)),\n   551\t        sub_left(mul_left(a.c, b.y), mul_left(a.s, b.x)),\n   552\t    )\n   553\t}\n   554\t\n   555\t#[unsafe(no_mangle)]\n   556\t#[inline(never)]\n   557\tpub unsafe extern \"C\" fn c2GJK(\n   558\t    a_shape: *const c_void,\n   559\t    type_a: c_int,\n   560\t    ax_ptr: *const C2x,\n   561\t    b_shape: *const c_void,\n   562\t    type_b: c_int,\n   563\t    bx_ptr: *const C2x,\n   564\t    out_a: *mut C2v,\n   565\t    out_b: *mut C2v,\n   566\t    use_radius: c_int,\n   567\t    iterations: *mut c_int,\n   568\t    cache: *mut C2GJKCache,\n   569\t) -> c_float {\n   570\t    let ax = if ax_ptr.is_null() {\n   571\t        c2xIdentity()\n   572\t    } else {\n   573\t        unsafe { *ax_ptr }\n   574\t    };\n   575\t    let bx = if bx_ptr.is_null() {\n   576\t        c2xIdentity()\n   577\t    } else {\n   578\t        unsafe { *bx_ptr }\n   579\t    };\n   580\t\n   581\t    let mut p_a = C2Proxy::default();\n   582\t    let mut p_b = C2Proxy::default();\n   583\t    unsafe {\n   584\t        c2MakeProxy(a_shape, type_a, &mut p_a);\n   585\t        c2MakeProxy(b_shape, type_b, &mut p_b);\n   586\t    }\n   587\t\n   588\t    let mut s = C2Simplex::default();\n   589\t    let mut cache_was_read = false;\n   590\t    if !cache.is_null() {\n   591\t        let cache_ref = unsafe { &*cache };\n   592\t        if cache_ref.count != 0 {\n   593\t            let mut i = 0;\n   594\t            while i < cache_ref.count {\n   595\t                let index = i as usize;\n   596\t                let i_a = cache_ref.i_a[index];\n   597\t                let i_b = cache_ref.i_b[index];\n   598\t                let support_a = c2Mulxv(ax, p_a.verts[i_a as usize]);\n   599\t                let support_b = c2Mulxv(bx, p_b.verts[i_b as usize]);\n   600\t                let v = s.vertex_mut(index);\n   601\t                v.i_a = i_a;\n   602\t                v.s_a = support_a;\n   603\t                v.i_b = i_b;\n   604\t                v.s_b = support_b;\n   605\t                v.p = c2Sub(v.s_b, v.s_a);\n   606\t                v.u = 0.0;\n   607\t                i += 1;\n   608\t            }\n   609\t            s.count = cache_ref.count;\n   610\t            s.div = cache_ref.div;\n   611\t            let metric_old = cache_ref.metric;\n   612\t            let metric = unsafe { c2GJKSimplexMetric(&mut s) };\n   613\t            let min_metric = if metric < metric_old {\n   614\t                metric\n   615\t            } else {\n   616\t                metric_old\n   617\t            };\n   618\t            let max_metric = if metric > metric_old {\n   619\t                metric\n   620\t            } else {\n   621\t                metric_old\n   622\t            };\n   623\t            if !(min_metric < max_metric * 2.0 && metric < -1.0e8) {\n   624\t                cache_was_read = true;\n   625\t            }\n   626\t        }\n   627\t    }\n   628\t\n   629\t    if !cache_was_read {\n   630\t        s.a.i_a = 0;\n   631\t        s.a.i_b = 0;\n   632\t        s.a.s_a = c2Mulxv(ax, p_a.verts[0]);\n   633\t        s.a.s_b = c2Mulxv(bx, p_b.verts[0]);\n   634\t        s.a.p = c2Sub(s.a.s_b, s.a.s_a);\n   635\t        s.a.u = 1.0;\n   636\t        s.div = 1.0;\n   637\t        s.count = 1;\n   638\t    }\n   639\t\n   640\t    let mut save_a = [0; 3];\n   641\t    let mut save_b = [0; 3];\n   642\t    let mut d0 = c_float::MAX;\n   643\t    let mut iter = 0;\n   644\t    let mut hit = false;\n   645\t    while iter < 20 {\n   646\t        let save_count = s.count;\n   647\t        let mut i = 0;\n   648\t        while i < save_count {\n   649\t            save_a[i as usize] = s.vertex(i as usize).i_a;\n   650\t            save_b[i as usize] = s.vertex(i as usize).i_b;\n   651\t            i += 1;\n   652\t        }\n   653\t\n   654\t        match s.count {\n   655\t            2 => unsafe { c22(&mut s) },\n   656\t            3 => unsafe { c23(&mut s) },\n   657\t            _ => {}\n   658\t        }\n   659\t        if s.count == 3 {\n   660\t            hit = true;\n   661\t            break;\n   662\t        }\n   663\t\n   664\t        let p = unsafe { c2L(&mut s) };\n   665\t        let d1 = c2Dot(p, p);\n   666\t        if d1 > d0 {\n   667\t            break;\n   668\t        }\n   669\t        d0 = d1;\n   670\t        let d = unsafe { c2D(&mut s) };\n   671\t        if c2Dot(d, d) < c_float::EPSILON * c_float::EPSILON {\n   672\t            break;\n   673\t        }\n   674\t\n   675\t        let i_a = unsafe { c2Support(p_a.verts.as_ptr(), p_a.count, c2MulrvT(ax.r, c2Neg(d))) };\n   676\t        let support_a = c2Mulxv(ax, p_a.verts[i_a as usize]);\n   677\t        let i_b = unsafe { c2Support(p_b.verts.as_ptr(), p_b.count, c2MulrvT(bx.r, d)) };\n   678\t        let support_b = c2Mulxv(bx, p_b.verts[i_b as usize]);\n   679\t        let v = s.vertex_mut(s.count as usize);\n   680\t        v.i_a = i_a;\n   681\t        v.s_a = support_a;\n   682\t        v.i_b = i_b;\n   683\t        v.s_b = support_b;\n   684\t        v.p = c2Sub(v.s_b, v.s_a);\n   685\t\n   686\t        let mut duplicate = false;\n   687\t        let mut i = 0;\n   688\t        while i < save_count {\n   689\t            if i_a == save_a[i as usize] && i_b == save_b[i as usize] {\n   690\t                duplicate = true;\n   691\t                break;\n   692\t            }\n   693\t            i += 1;\n   694\t        }\n   695\t        if duplicate {\n   696\t            break;\n   697\t        }\n   698\t        s.count += 1;\n   699\t        iter += 1;\n   700\t    }\n   701\t\n   702\t    let mut a = C2v::default();\n   703\t    let mut b = C2v::default();\n   704\t    unsafe { c2Witness(&mut s, &mut a, &mut b) };\n   705\t    let mut dist = c2Len(c2Sub(a, b));\n   706\t    if hit {\n   707\t        a = b;\n   708\t        dist = 0.0;\n   709\t    } else if use_radius != 0 {\n   710\t        let r_a = p_a.radius;\n   711\t        let r_b = p_b.radius;\n   712\t        if dist > r_a + r_b && dist > c_float::EPSILON {\n   713\t            dist -= r_a + r_b;\n   714\t            let n = c2Norm(c2Sub(b, a));\n   715\t            a = c2Add(a, c2Mulvs(n, r_a));\n   716\t            b = c2Sub(b, c2Mulvs(n, r_b));\n   717\t            if a.x == b.x && a.y == b.y {\n   718\t                dist = 0.0;\n   719\t            }\n   720\t        } else {\n   721\t            let p = c2Mulvs(c2Add(a, b), 0.5);\n   722\t            a = p;\n   723\t            b = p;\n   724\t            dist = 0.0;\n   725\t        }\n   726\t    }\n   727\t\n   728\t    if !cache.is_null() {\n   729\t        let cache_ref = unsafe { &mut *cache };\n   730\t        cache_ref.metric = unsafe { c2GJKSimplexMetric(&mut s) };\n   731\t        cache_ref.count = s.count;\n   732\t        let mut i = 0;\n   733\t        while i < s.count {\n   734\t            let v = s.vertex(i as usize);\n   735\t            cache_ref.i_a[i as usize] = v.i_a;\n   736\t            cache_ref.i_b[i as usize] = v.i_b;\n   737\t            i += 1;\n   738\t        }\n   739\t        cache_ref.div = s.div;\n   740\t    }\n   741\t    if !out_a.is_null() {\n   742\t        unsafe { *out_a = a };\n   743\t    }\n   744\t    if !out_b.is_null() {\n   745\t        unsafe { *out_b = b };\n   746\t    }\n   747\t    if !iterations.is_null() {\n   748\t        unsafe { *iterations = iter };\n   749\t    }\n   750\t    dist\n   751\t}\n   752\t\n   753\t#[unsafe(no_mangle)]\n   754\t#[inline(never)]\n   755\tpub extern \"C\" fn c2AABBtoAABB(a: C2AABB, b: C2AABB) -> c_int {\n   756\t    let d0 = b.max.x < a.min.x;\n   757\t    let d1 = a.max.x < b.min.x;\n   758\t    let d2 = b.max.y < a.min.y;\n   759\t    let d3 = a.max.y < b.min.y;\n   760\t    (!(d0 || d1 || d2 || d3)) as c_int\n","exit_code":0,"status":"completed"}}
