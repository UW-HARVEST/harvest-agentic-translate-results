= c2Mulxv(bx, p_b.verts[i_b as usize]);\n   482\t                    let v = &mut *verts.add(i as usize);\n   483\t                    v.i_a = i_a;\n   484\t                    v.s_a = s_a;\n   485\t                    v.i_b = i_b;\n   486\t                    v.s_b = s_b;\n   487\t                    v.p = c2Sub(v.s_b, v.s_a);\n   488\t                    v.u = 0.0;\n   489\t                    i += 1;\n   490\t                }\n   491\t                s.count = (*cache).count;\n   492\t                s.div = (*cache).div;\n   493\t                let metric_old = (*cache).metric;\n   494\t                let metric = c2GJKSimplexMetric(&mut s);\n   495\t                let min_metric = if metric < metric_old {\n   496\t                    metric\n   497\t                } else {\n   498\t                    metric_old\n   499\t                };\n   500\t                let max_metric = if metric > metric_old {\n   501\t                    metric\n   502\t                } else {\n   503\t                    metric_old\n   504\t                };\n   505\t                if !(min_metric < max_metric * 2.0 && metric < -1.0e8) {\n   506\t                    cache_was_read = true;\n   507\t                }\n   508\t            }\n   509\t        }\n   510\t\n   511\t        if !cache_was_read {\n   512\t            s.a.i_a = 0;\n   513\t            s.a.i_b = 0;\n   514\t            s.a.s_a = c2Mulxv(ax, p_a.verts[0]);\n   515\t            s.a.s_b = c2Mulxv(bx, p_b.verts[0]);\n   516\t            s.a.p = c2Sub(s.a.s_b, s.a.s_a);\n   517\t            s.a.u = 1.0;\n   518\t            s.div = 1.0;\n   519\t            s.count = 1;\n   520\t        }\n   521\t\n   522\t        let mut save_a = [0; 3];\n   523\t        let mut save_b = [0; 3];\n   524\t        let mut d0 = c_float::MAX;\n   525\t        let mut iter = 0;\n   526\t        let mut hit = false;\n   527\t\n   528\t        while iter < 20 {\n   529\t            let save_count = s.count;\n   530\t           