\n   580\t            }\n   581\t            s.count += 1;\n   582\t            iter += 1;\n   583\t        }\n   584\t\n   585\t        let mut a = C2v::default();\n   586\t        let mut b = C2v::default();\n   587\t        c2Witness(&mut s, &mut a, &mut b);\n   588\t        let mut dist = c2Len(c2Sub(a, b));\n   589\t        if hit {\n   590\t            a = b;\n   591\t            dist = 0.0;\n   592\t        } else if use_radius != 0 {\n   593\t            let r_a = p_a.radius;\n   594\t            let r_b = p_b.radius;\n   595\t            if dist > r_a + r_b && dist > c_float::EPSILON {\n   596\t                dist -= r_a + r_b;\n   597\t                let n = c2Norm(c2Sub(b, a));\n   598\t                a = c2Add(a, c2Mulvs(n, r_a));\n   599\t                b = c2Sub(b, c2Mulvs(n, r_b));\n   600\t                if a.x == b.x && a.y == b.y {\n   601\t                    dist = 0.0;\n   602\t                }\n   603\t            } else {\n   604\t                let p = c2Mulvs(c2Add(a, b), 0.5);\n   605\t                a = p;\n   606\t                b = p;\n   607\t                dist = 0.0;\n   608\t            }\n   609\t        }\n   610\t\n   611\t        if !cache.is_null() {\n   612\t            (*cache).metric = c2GJKSimplexMetric(&mut s);\n   613\t            (*cache).count = s.count;\n   614\t            let mut i = 0;\n   615\t            while i < s.count {\n   616\t                let v = &*verts.add(i as usize);\n   617\t                (*cache).i_a[i as usize] = v.i_a;\n   618\t                (*cache).i_b[i as usize] = v.i_b;\n   619\t                i += 1;\n   620\t            }\n   621\t            (*cache).div = s.div;\n   622\t        }\n   623\t        if !out_a.is_null() {\n   624\t            *out_a = a;\n   625\t        }\n   626\t        if !out_b.is_null() {\n   627\t            *out_b = b;\n   628\t        }\n   629\t        if !iterations.is_null() {\n   630\t            *iterations = iter;\n   631\t        }\n   632\t        dist\n   633\t    }\n   634\t}\n   635\t\n   636\t#[unsafe(no_mangle)]\n   637\tpub extern \"C\" fn c2AABBtoAABB(a: C2Aabb, b: C2Aabb) -> c_int {\n   638\t    let d0 = b.max.x < a.min.x;\n   639\t    let d1 = a.max.x < b.min.x;\n   640\t    let d2 = b.max.y < a.min.y;\n   641\t    let d3 = a.max.y < b.min.y;\n   642\t    (!(d0 | d1 | d2 | d3)) as c_int\n   643\t}\n   644\t\n   645\t#[unsafe(no_mangle)]\n   646\tpub extern \"C\" fn c2AABBtoCapsule(a: C2Aabb, b: C2Capsule) -> c_int {\n   647\t    let dist = unsafe {\n   648\t        c2GJK(\n   649\t            (&a as *const C2Aabb).cast(),\n   650\t            C2_TYPE_AABB,\n   651\t            std::ptr::null(),\n   652\t            (&b as *const C2Capsule).cast(),\n   653\t            C2_TYPE_CAPSULE,\n   654\t            std::ptr::null(),\n   655\t            std::ptr::null_mut(),\n   656\t            std::ptr::null_mut(),\n   657\t            1,\n   658\t            std::ptr::null_mut(),\n   659\t            std::ptr::null_mut(),\n   660\t        )\n   661\t    };\n   662\t    if dist != 0.0 { 0 } else { 1 }\n   663\t}\n   664\t\n   665\t#[unsafe(no_mangle)]\n   666\tpub extern \"C\" fn c2CapsuletoCapsule(a: C2Capsule, b: C2Capsule) -> c_int {\n   667\t    let dist = unsafe {\n   668\t        c2GJK(\n   669\t            (&a as *const C2Capsule).cast(),\n   670\t            C2_TYPE_CAPSULE,\n   671\t            std::ptr::null(),\n   672\t            (&b as *const C2Capsule).cast(),\n   673\t            C2_TYPE_CAPSULE,\n   674\t            std::ptr::null(),\n   675\t            std::ptr::null_mut(),\n   676\t            std::ptr::null_mut(),\n   677\t            1,\n   678\t            std::ptr::null_mut(),\n   679\t            std::ptr::null_mut(),\n   680\t        )\n   681\t    };\n   682\t    if dist != 0.0 { 0 } else { 1 }\n   683\t}\n   684\t\n   685\t#[unsafe(no_mangle)]\n   686\tpub extern \"C\" fn c2CircletoCircle(a: C2Circle, b: C2Circle) -> c_int {\n   687\t    let c = c2Sub(b.p, a.p);\n   688\t    l