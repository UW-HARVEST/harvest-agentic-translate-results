\t\n   270\t#[unsafe(no_mangle)]\n   271\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n   272\t    c2Add(c2Mulrv(a.r, b), a.p)\n   273\t}\n   274\t\n   275\t#[unsafe(no_mangle)]\n   276\tpub extern \"C\" fn c2MulxvT(a: c2x, b: c2v) -> c2v {\n   277\t    c2MulrvT(a.r, c2Sub(b, a.p))\n   278\t}\n   279\t\n   280\t#[unsafe(no_mangle)]\n   281\tpub extern \"C\" fn c2Intersect(a: c2v, b: c2v, da: c_float, db: c_float) -> c2v {\n   282\t    c2Add(a, c2Mulvs(c2Sub(b, a), da / (da - db)))\n   283\t}\n   284\t\n   285\tunsafe fn c2Clip(seg: *mut c2v, h: c2h) -> c_int {\n   286\t    let mut out = [c2v::default(); 2];\n   287\t    let mut sp = 0usize;\n   288\t    let d0 = c2Dist(h, *seg.add(0));\n   289\t    if d0 < 0.0 {\n   290\t        out[sp] = *seg.add(0);\n   291\t        sp += 1;\n   292\t    }\n   293\t    let d1 = c2Dist(h, *seg.add(1));\n   294\t    if d1 < 0.0 {\n   295\t        out[sp] = *seg.add(1);\n   296\t        sp += 1;\n   297\t    }\n   298\t    if d0 == 0.0 && d1 == 0.0 {\n   299\t        out[sp] = *seg.add(0);\n   300\t        sp += 1;\n   301\t        out[sp] = *seg.add(1);\n   302\t        sp += 1;\n   303\t    } else if d0 * d1 <= 0.0 {\n   304\t        out[sp] = c2Intersect(*seg.add(0), *seg.add(1), d0, d1);\n   305\t        sp += 1;\n   306\t    }\n   307\t    *seg.add(0) = out[0];\n   308\t    *seg.add(1) = out[1];\n   309\t    sp as c_int\n   310\t}\n   311\t\n   312\t#[unsafe(no_mangle)]\n   313\tpub extern \"C\" fn c2Div(a: c2v, b: c_float) -> c2v {\n   314\t    c2Mulvs(a, 1.0 / b)\n   315\t}\n   316\t\n   317\t#[unsafe(no_mangle)]\n   318\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n   319\t    c2Div(a, c2Len(a))\n   320\t}\n   321\t\n   322\t#[unsafe(no_mangle)]\n   323\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n   324\t    c2V(-a.x, -a.y)\n   325\t}\n   326\t\n   327\t#[unsafe(no_mangle)]\n   328\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n   329\t    c2v { x: a.y, y: -a.x }\n   330\t}\n   331\t\n   332\tunsafe fn c2SidePlanes(seg: *mut c2v, ra: c2v, rb: c2v, h: *mut c2h) -> c_int {\n   333\t    let inside = c2Norm(c2Sub(rb, ra));\n   334\t    let left = c2h {\n   335\t        n: c2Neg(inside),\n   336\t        d: c2Dot(c2Neg(inside), ra),\n   337\t    };\n   338\t    let right = c2h {\n   339\t        n: inside,\n   340\t        d: c2Dot(inside, rb),\n   341\t    };\n   342\t    if c2Clip(seg, left) < 2 {\n   343\t        return 0;\n   344\t    }\n   345\t    if c2Clip(seg, right) < 2 {\n   346\t        return 0;\n   347\t    }\n   348\t    if !h.is_null() {\n   349\t        (*h).n = c2CCW90(inside);\n   350\t        (*h).d = c2Dot(c2CCW90(inside), ra);\n   351\t    }\n   352\t    1\n   353\t}\n   354\t\n   355\tunsafe fn c2SidePlanesFromPoly(\n   356\t    seg: *mut c2v,\n   357\t    x: c2x,\n   358\t    p: *const c2Poly,\n   359\t    e: c_int,\n   360\t    h: *mut c2h,\n   361\t) -> c_int {\n   362\t    let p = &*p;\n   363\t    let e = e as usize;\n   364\t    let ra = c2Mulxv(x, p.verts[e]);\n   365\t    let rb = c2Mulxv(\n   366\t        x,\n   367\t        p.verts[if e + 1 == p.count as usize { 0 } else { e + 1 }],\n   368\t    );\n   369\t    c2SidePlanes(seg, ra, rb, h)\n   370\t}\n   371\t\n   372\t#[unsafe(no_mangle)]\n   373\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n   374\t    let a = (*s).a.p;\n   375\t    let b = (*s).b.p;\n   376\t    let u = c2Dot(b, c2Sub(b, a));\n   377\t    let v = c2Dot(a, c2Sub(a, b));\n   378\t    if v <= 0.0 {\n   379\t        (*s).a.u = 1.0;\n   380\t        (*s).div = 1.0;\n   381\t        (*s).count = 1;\n   382\t    } else if u <= 0.0 {\n   383\t        (*s).a = (*s).b;\n   384\t        (*s).a.u = 1.0;\n   385\t        (*s).div = 1.0;\n   386\t        (*s).count = 1;\n   387\t    } else {\n   388\t        (*s).a.u = u;\n   389\t        (*s).b.u = v;\n   390\t        (*s).div = u + v;\n   391\t        (*s).count = 2;\n   392\t    }\n   393\t}\n   394\t\n   395\t#[unsafe(no_mangle)]\n   396\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n   397\t    let a = (*s).a.p;\n   398\t    let b = (*s).b.p;\n   399\t    let c = (*s).c.p;\n   400\t    let uAB = c2Dot(b, c2Sub(b, a));\n   401\t    let vAB = c2Dot(a, c2Sub(a, b));\n   402\t    let uBC = c2Dot(c, c2Sub(c, b));\n   403\t    let vBC = c2Dot(b, c2Sub(b, c));\n   404\t    let uCA = c2Dot(a, c2Sub(a, c));\n   405\t    let vCA = c2Dot(c, c2Sub(c, a));\n   406\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n   407\t    let uABC = c2Det2(b, c) * area;\n   408\t    let vABC = c2Det2(c, a) * area;\n   409\t    let wABC = c2Det2(a, b) * area;\n   410\t    if vAB <= 0.0 && uCA <= 0.0 {\n   411\t        (*s).a.u = 1.0;\n   412\t        (*s).div = 1.0;\n   413\t        (*s).count = 1;\n   414\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n   415\t        (*s).a = (*s).b;\n   416\t        (*s).a.u = 1.0;\n   417\t        (*s).div = 1.0;\n   418\t        (*s).count = 1;\n   419\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n   420\t        (*s).a = (*s).c;\n   421\t        (*s).a.u = 1.0;\n   422\t        (*s).div = 1.0;\n   423\t        (*s).count = 1;\n   424\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n   425\t        (*s).a.u = uAB;\n   426\t        (*s).b.u = vAB;\n   427\t        (*s).div = uAB + vAB;\n   428\t        (*s).count = 2;\n   429\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n   430\t        (*s).a = (*s).b;\n   431\t        (*s).b = (*s).c;\n   432\t        (*s).a.u = uBC;\n   433\t        (*s).b.u = vBC;\n   434\t        (*s).div = uBC + vBC;\n   435\t        (*s).count = 2;\n   436\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n   437\t        (*s).b = (*s).a;\n   438\t        (*s).a = (*s).c;\n   439\t        (*s).a.u = uCA;\n   440\t        (*s).b.u = vCA;\n   441\t        (*s).div = uCA + vCA;\n   442\t        (*s).count = 2;\n   443\t    } else {\n   444\t        (*s).a.u = uABC;\n   445\t        (*s).b.u = vABC;\n   446\t        (*s).c.u = wABC;\n   447\t        (*s).div = uABC + vABC + wABC;\n   448\t        (*s).count = 3;\n   449\t    }\n   450\t}\n   451\t\n   452\t#[unsafe(no_mangle)]\n   453\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n   454\t    c2v { x: -a.y, y: a.x }\n   455\t}\n   456\t\n   457\t#[unsafe(no_mangle)]\n   458\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n   459\t    match (*s).count {\n   460\t        1 => c2Neg((*s).a.p),\n   461\t        2 => {\n   462\t            let ab = c2Sub((*s).b.p, (*s).a.p);\n   463\t            if c2Det2(ab, c2Neg((*s).a.p)) > 0.0 {\n   464\t                c2Skew(ab)\n   465\t            } else {\n   466\t                c2CCW90(ab)\n   467\t            }\n   468\t        }\n   469\t        _ => c2V(0.0, 0.0),\n   470\t    }\n   471\t}\n   472\t\n   473\t#[unsafe(no_mangle)]\n   474\tpub unsafe extern \"C\" fn c2Support(\n   475\t    verts: *const c2v,\n   476\t    count: c_int,\n   477\t    d: c2v,\n   478\t) -> c_int {\n   479\t    let mut imax = 0;\n   480\t    let mut dmax = c2Dot(*verts, d);\n   481\t    for i in 1..count {\n   482\t        let dot = c2Dot(*verts.add(i as usize), d);\n   483\t        if dot > dmax {\n   484\t            imax = i;\n   485\t            dmax = dot;\n   486\t        }\n   487\t    }\n   488\t    imax\n   489\t}\n   490\t\n   491\t#[unsafe(no_mangle)]\n   492\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n   493\t    let den = 1.0 / (*s).div;\n   494\t    match (*s).count {\n   495\t        1 => {\n   496\t            *a = (*s).a.sA;\n   497\t            *b = (*s).a.sB;\n   498\t        }\n   499\t        2 => {\n   500\t            *a = c2Add(\n   501\t                c2Mulvs((*s).a.sA, den * (*s).a.u),\n   502\t                c2Mulvs((*s).b.sA, den * (*s).b.u),\n   503\t            );\n   504\t            *b = c2Add(\n   505\t                c2Mulvs((*s).a.sB, den * (*s).a.u),\n   506\t                c2Mulvs((*s).b.sB, den * (*s).b.u),\n   507\t            );\n   508\t        }\n   509\t        3 => {\n   510\t            *a = c2Add(\n   511\t                c2Add(\n   512\t                    c2Mulvs((*s).a.sA, den * (*s).a.u),\n   513\t                    c2Mulvs((*s).b.sA, den * (*s).b.u),\n   514\t                ),\n   515\t                c2Mulvs((*s).c.sA, den * (*s).c.u),\n   516\t            );\n   517\t            *b = c2Add(\n   518\t                c2Add(\n   519\t                    c2Mulvs((*s).a.sB, den * (*s).a.u),\n   520\t                    c2Mulvs((*s).b.sB, den * (*s).b.u),\n   521\t                ),\n   522\t                c2Mulvs((*s).c.sB, den * (*s).c.u),\n   523\t            );\n   524\t        }\n   525\t        _ => {\n   526\t            *a = c2V(0.0, 0.0);\n   527\t            *b = c2V(0.0, 0.0);\n   528\t        }\n   529\t    }\n   530\t}\n   531\t\n   532\t#[unsafe(no_mangle)]\n   533\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n   534\t    let den = 1.0 / (*s).div;\n   535\t    match (*s).count {\n   536\t        1 => (*s).a.p,\n   537\t        2 => c2Add(\n   538\t            c2Mulvs((*s).a.p, den * (*s).a.u),\n   539\t            c2Mulvs((*s).b.p, den * (*s).b.u),\n   540\t        ),\n   541\t        _ => c2V(0.0, 0.0),\n   542\t    }\n   543\t}\n   544\t\n   545\t#[unsafe(no_mangle)]\n   546\tpub unsafe extern \"C\" fn c2GJK(\n   547\t    A: *const c_void,\n   548\t    typeA: C2_TYPE,\n   549\t    ax_ptr: *const c2x,\n   550\t    B: *const c_void,\n   551\t    typeB: C2_TYPE,\n   552\t    bx_ptr: *const c2x,\n   553\t    outA: *mut c2v,\n   554\t    outB: *mut c2v,\n   555\t    use_radius: c_int,\n   556\t    iterations: *mut c_int,\n   557\t    cache: *mut c2GJKCache,\n   558\t) -> c_float {\n   559\t    let ax = if ax_ptr.is_null() {\n   560\t        c2xIdentity()\n   561\t    } else {\n   562\t        *ax_ptr\n   563\t    };\n   564\t    let bx = if bx_ptr.is_null() {\n   565\t        c2xIdentity()\n   566\t    } else {\n   567\t        *bx_ptr\n   568\t    };\n   569\t    let mut pA = c2Proxy::default();\n   570\t    let mut pB = c2Proxy::default();\n   571\t    c2MakeProxy(A, typeA, &mut pA);\n   572\t    c2MakeProxy(B, typeB, &mut pB);\n   573\t    let mut s = c2Simplex::default();\n   574\t    let verts = &mut s.a as *mut c2sv;\n   575\t    let mut cache_was_read = 0;\n   576\t    if !cache.is_null() {\n   577\t        let cache_was_good = ((*cache).count != 0) as c_int;\n   578\t        if cache_was_good != 0 {\n   579\t            for i in 0..(*cache).count {\n   580\t                let iA = (*cache).iA[i as usize];\n   581\t                let iB = (*cache).iB[i as usize];\n   582\t                let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n   583\t                let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n   584\t                let v = &mut *verts.add(i as usize);\n   585\t                v.iA = iA;\n   586\t                v.sA = sA;\n   587\t                v.iB = iB;\n   588\t                v.sB = sB;\n   589\t                v.p = c2Sub(v.sB, v.sA);\n   590\t                v.u = 0.0;\n   591\t            }\n   592\t            s.count = (*cache).count;\n   593\t            s.div = (*cache).div;\n   594\t            let metric_old = (*cache).metric;\n   595\t            let metric = c2GJKSimplexMetric(&mut s);\n   596\t            let min_metric = if metric < metric_old {\n   597\t                metric\n   598\t            } else {\n   599\t                metric_old\n   600\t            };\n   601\t            let max_metric = if metric > metric_old {\n   602\t                metric\n   603\t            } else {\n   604\t                metric_old\n   605\t            };\n   606\t            if !(min_metric < max_metric * 2.0 && metric < -1.0e8) {\n   607\t                cache_was_read = 1;\n   608\t            }\n   609\t        }\n   610\t    }\n   611\t    if cache_was_read == 0 {\n   612\t        s.a.iA = 0;\n   613\t        s.a.iB = 0;\n   614\t        s.a.sA = c2Mulxv(ax, pA.verts[0]);\n   615\t        s.a.sB = c2Mulxv(bx, pB.verts[0]);\n   616\t        s.a.p = c2Sub(s.a.sB, s.a.sA);\n   617\t        s.a.u = 1.0;\n   618\t        s.div = 1.0;\n   619\t        s.count = 1;\n   620\t    }\n   621\t    let mut saveA = [0; 3];\n   622\t    let mut saveB = [0; 3];\n   623\t    let mut d0 = c_float::MAX;\n   624\t    let mut iter = 0;\n   625\t    let mut hit = 0;\n   626\t    while iter < 20 {\n   627\t        let save_count = s.count;\n   628\t        for i in 0..save_count {\n   629\t            saveA[i as usize] = (*verts.add(i as usize)).iA;\n   630\t            saveB[i as usize] = (*verts.add(i as usize)).iB;\n   631\t        }\n   632\t        match s.count {\n   633\t            2 => c22(&mut s),\n   634\t            3 => c23(&mut s),\n   635\t            _ => {}\n   636\t        }\n   637\t        if s.count == 3 {\n   638\t            hit = 1;\n   639\t            break;\n   640\t        }\n   641\t        let p = c2L(&mut s);\n   642\t        let d1 = c2Dot(p, p);\n   643\t        if d1 > d0 {\n   644\t            break;\n   645\t        }\n   646\t        d0 = d1;\n   647\t        let d = c2D(&mut s);\n   648\t        if c2Dot(d, d) < c_float::EPSILON * c_float::EPSILON {\n   649\t            break;\n   650\t        }\n   651\t        let iA = c2Support(\n   652\t            pA.verts.as_ptr(),\n   653\t            pA.count,\n   654\t            c2MulrvT(ax.r, c2Neg(d)),\n   655\t        );\n   656\t        let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n   657\t        let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n   658\t        let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n   659\t        let v = &mut *verts.add(s.count as usize);\n   660\t        v.iA = iA;\n   661\t        v.sA = sA;\n   662\t        v.iB = iB;\n   663\t        v.sB = sB;\n   664\t        v.p = c2Sub(v.sB, v.sA);\n   665\t        let mut dup = 0;\n   666\t        for i in 0..save_count {\n   667\t            if iA == saveA[i as usize] && iB == saveB[i as usize] {\n   668\t                dup = 1;\n   669\t                break;\n   670\t            }\n   671\t        }\n   672\t        if dup != 0 {\n   673\t            break;\n   674\t        }\n   675\t        s.count += 1;\n   676\t        iter += 1;\n   677\t    }\n   678\t    let mut a = c2v::default();\n   679\t    let mut b = c2v::default();\n   680\t    c2Witness(&mut s, &mut a, &mut b);\n   681\t    let mut dist = c2Len(c2Sub(a, b));\n   682\t    if hit != 0 {\n   683\t        a = b;\n   684\t        dist = 0.0;\n   685\t    } else if use_radius != 0 {\n   686\t        let rA = pA.radius;\n   687\t        let rB = pB.radius;\n   688\t        if dist > rA + rB && dist > c_float::EPSILON {\n   689\t            dist -= rA + rB;\n   690\t            let n = c2Norm(c2Sub(b, a));\n   691\t            a = c2Add(a, c2Mulvs(n, rA));\n   692\t            b = c2Sub(b, c2Mulvs(n, rB));\n   693\t            if a.x == b.x && a.y == b.y {\n   694\t                dist = 0.0;\n   695\t            }\n   696\t        } else {\n   697\t            let p = c2Mulvs(c2Add(a, b), 0.5);\n   698\t            a = p;\n   699\t            b = p;\n   700\t            dist = 0.0;\n   701\t        }\n   702\t    }\n   703\t    if !cache.is_null() {\n   704\t        (*cache).metric = c2GJKSimplexMetric(&mut s);\n   705\t        (*cache).count = s.count;\n   706\t        for i in 0..s.count {\n   707\t            let v = &*verts.add(i as usize);\n   708\t            (*cache).iA[i as usize] = v.iA;\n   709\t            (*cache).iB[i as usize] = v.iB;\n   710\t        }\n   711\t        (*cache).div = s.div;\n   712\t    }\n   713\t    if !outA.is_null() {\n   714\t        *outA = a;\n   715\t    }\n   716\t    if !outB.is_null() {\n   717\t        *outB = b;\n   718\t    }\n   719\t    if !iterations.is_null() {\n   720\t        *iterations = iter;\n   721\t    }\n   722\t    dist\n   723\t}\n   724\t\n   725\t#[unsafe(no_mangle)]\n   726\tpub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n   727\t    c2V(\n   728\t        if a.x < 0.0 { -a.x } else { a.x },\n   729\t        if a.y < 0.0 { -a.y } else { a.y },\n   730\t    )\n   731\t}\n   732\t\n   733\t#[unsafe(no_mangle)]\n   734\tpub unsafe extern \"C\" fn c2CircletoCircleManifold(\n   735\t    A: c2Circle,\n   736\t    B: c2Circle,\n   737\t    m: *mut c2Manifold,\n   738\t) {\n   739\t    (*m).count = 0;\n   740\t    let d = c2Sub(B.p, A.p);\n   741\t    let d2 = c2Dot(d, d);\n   742\t    let r = A.r + B.r;\n   743\t    if d2 < r * r {\n   744\t        let l = d2.sqrt();\n   745\t        let n = if l != 0.0 {\n   746\t            c2Mulvs(d, 1.0 / l)\n   747\t        } else {\n   748\t            c2V(0.0, 1.0)\n   749\t        };\n   750\t        (*m).count = 1;\n   751\t        (*m).depths[0] = r - l;\n   752\t        (*m).contact_points[0] = c2Sub(B.p, c2Mulvs(n, B.r));\n   753\t        (*m).n = n;\n   754\t    }\n   755\t}\n   756\t\n   757\t#[unsafe(no_mangle)]\n   758\tpub unsafe extern \"C\" fn c2CircletoAABBManifold(\n   759\t    A: c2Circle,\n   760\t    B: c2AABB,\n   761\t    m: *mut c2Manifold,\n   762\t) {\n   763\t    (*m).count = 0;\n   764\t    let L = c2Clampv(A.p, B.min, B.max);\n   765\t    let ab = c2Sub(L, A.p);\n   766\t    let d2 = c2Dot(ab, ab);\n   767\t    let r2 = A.r * A.r;\n   768\t    if d2 < r2 {\n   769\t        if d2 != 0.0 {\n   770\t            let d = d2.sqrt();\n   771\t            let n = c2Norm(ab);\n   772\t            (*m).count = 1;\n   773\t            (*m).depths[0] = A.r - d;\n   774\t            (*m).contact_points[0] = c2Add(A.p, c2Mulvs(n, d));\n   775\t            (*m).n = n;\n   776\t        } else {\n   777\t            let mid = c2Mulvs(c2Add(B.min, B.max), 0.5);\n   778\t            let e = c2Mulvs(c2Sub(B.max, B.min), 0.5);\n   779\t            let d = c2Sub(A.p, mid);\n   780\t            let abs_d = c2Absv(d);\n   781\t            let x_overlap = e.x - abs_d.x;\n   782\t            let y_overlap = e.y - abs_d.y;\n   783\t            let (depth, n) = if x_overlap < y_overlap {\n   784\t                let n = c2Mulvs(c2V(1.0, 0.0), if d.x < 0.0 { 1.0 } else { -1.0 });\n   785\t                (x_overlap, n)\n   786\t            } else {\n   787\t                let n = c2Mulvs(c2V(0.0, 1.0), if d.y < 0.0 { 1.0 } else { -1.0 });\n   788\t                (y_overlap, n)\n   789\t            };\n   790\t            (*m).count = 1;\n   791\t            (*m).depths[0] = A.r + depth;\n   792\t            (*m).contact_points[0] = c2Sub(A.p, c2Mulvs(n, depth));\n   793\t            (*m).n = n;\n   794\t        }\n   795\t    }\n   796\t}\n   797\t\n   798\t#[unsafe(no_mangle)]\n   799\tpub unsafe extern \"C\" fn c2CircletoCapsuleManifold(\n   800\t    A: c2Circle,\n   801\t    B: c2Capsule,\n   802\t    m: *mut c2Manifold,\n   803\t) {\n   804\t    (*m).count = 0;\n   805\t    let mut a = c2v::default();\n   806\t    let mut b = c2v::default();\n   807\t    let r = A.r + B.r;\n   808\t    let d = c2GJK(\n   809\t        &A as *const _ as *const c_void,\n   810\t        C2_TYPE_CIRCLE,\n   811\t        std::ptr::null(),\n   812\t        &B as *const _ as *const c_void,\n   813\t        C2_TYPE_CAPSULE,\n   814\t        std::ptr::null(),\n   815\t        &mut a,\n   816\t        &mut b,\n   817\t        0,\n   818\t        std::ptr::null_mut(),\n   819\t        std::ptr::null_mut(),\n   820\t    );\n   821\t    if d < r {\n   822\t        let n = if d == 0.0 {\n   823\t            c2Norm(c2Skew(c2Sub(B.b, B.a)))\n   824\t        } else {\n   825\t            c2Norm(c2Sub(b, a))\n   826\t        };\n   827\t        (*m).count = 1;\n   828\t        (*m).depths[0] = r - d;\n   829\t        (*m).contact_points[0] = c2Sub(b, c2Mulvs(n, B.r));\n   830\t        (*m).n = n;\n   831\t    }\n   832\t}\n   833\t\n   834\t#[unsafe(no_mangle)]\n   835\tpub unsafe extern \"C\" fn c2AABBtoAABBManifold(\n   836\t    A: c2AABB,\n   837\t    B: c2AABB,\n   838\t    m: *mut c2Manifold,\n   839\t) {\n   840\t    (*m).count = 0;\n   841\t    let mid_a = c2Mulvs(c2Add(A.min, A.max), 0.5);\n   842\t    let mid_b = c2Mulvs(c2Add(B.min, B.max), 0.5);\n   843\t    let eA = c2Absv(c2Mulvs(c2Sub(A.max, A.min), 0.5));\n   844\t    let eB = c2Absv(c2Mulvs(c2Sub(B.max, B.min), 0.5));\n   845\t    let d = c2Sub(mid_b, mid_a);\n   846\t    let dx = eA.x + eB.x - if d.x < 0.0 { -d.x } else { d.x };\n   847\t    if dx < 0.0 {\n   848\t        return;\n   849\t    }\n   850\t    let dy = eA.y + eB.y - if d.y < 0.0 { -d.y } else { d.y };\n   851\t    if dy < 0.0 {\n   852\t        return;\n   853\t    }\n   854\t    let (n, depth, p) = if dx < dy {\n   855\t        if d.x < 0.0 {\n   856\t            (\n   857\t                c2V(-1.0, 0.0),\n   858\t                dx,\n   859\t                c2Sub(mid_a, c2V(eA.x, 0.0)),\n   860\t            )\n   861\t        } else {\n   862\t            (\n   863\t                c2V(1.0, 0.0),\n   864\t                dx,\n   865\t                c2Add(mid_a, c2V(eA.x, 0.0)),\n   866\t            )\n   867\t        }\n   868\t    } else if d.y < 0.0 {\n   869\t        (\n   870\t            c2V(0.0, -1.0),\n   871\t            dy,\n   872\t            c2Sub(mid_a, c2V(0.0, eA.y)),\n   873\t        )\n   874\t    } else {\n   875\t        (\n   876\t            c2V(0.0, 1.0),\n   877\t            dy,\n   878\t            c2Add(mid_a, c2V(0.0, eA.y)),\n   879\t        )\n   880\t    };\n   881\t    (*m).count = 1;\n   882\t    (*m).contact_points[0] = p;\n   883\t    (*m).depths[0] = depth;\n   884\t    (*m).n = n;\n   885\t}\n   886\t\n   887\tunsafe fn c2KeepDeep(seg: *mut c2v, h: c2h, m: *mut c2Manifold) {\n   888\t    let mut cp = 0usize;\n   889\t    for i in 0..2 {\n   890\t        let p = *seg.add(i);\n   891\t        let d = c2Dist(h, p);\n   892\t        if d <= 0.0 {\n   893\t            (*m).contact_points[cp] = p;\n   894\t            (*m).depths[cp] = -d;\n   895\t            cp += 1;\n   896\t        }\n   897\t    }\n   898\t    (*m).count = cp as c_int;\n   899\t    (*m).n = h.n;\n   900\t}\n   901\t\n   902\tunsafe fn c2Incident(\n   903\t    incident: *mut c2v,\n   904\t    ip: *const c2Poly,\n   905\t    ix: c2x,\n   906\t    rn_in_incident_space: c2v,\n   907\t) {\n   908\t    let ip = &*ip;\n   909\t    let mut index: c_int = !0;\n   910\t    let mut min_dot = c_float::MAX;\n   911\t    for i in 0..ip.count {\n   912\t        let dot = c2Dot(rn_in_incident_space, ip.norms[i as usize]);\n   913\t        if dot < min_dot {\n   914\t            min_dot = dot;\n   915\t            index = i;\n   916\t        }\n   917\t    }\n   918\t    *incident.add(0) = c2Mulxv(ix, ip.verts[index as usize]);\n   919\t    let next = if index + 1 == ip.count {\n   920\t        0\n   921\t    } else {\n   922\t        index + 1\n   923\t    };\n   924\t    *incident.add(1) = c2Mulxv(ix, ip.verts[next as usize]);\n   925\t}\n   926\t\n   927\t#[unsafe(no_mangle)]\n   928\tpub unsafe extern \"C\" fn c2CapsuletoPolyManifold(\n   929\t    A: c2Capsule,\n   930\t    B: *const c2Poly,\n   931\t    bx_ptr: *const c2x,\n   932\t    m: *mut c2Manifold,\n   933\t) {\n   934\t    (*m).count = 0;\n   935\t    let mut a = c2v::default();\n   936\t    let mut b = c2v::default();\n   937\t    let d = c2GJK(\n   938\t        &A as *const _ as *const c_void,\n   939\t        C2_TYPE_CAPSULE,\n   940\t        std::ptr::null(),\n   941\t        B as *const c_void,\n   942\t        C2_TYPE_POLY,\n   943\t        bx_ptr,\n   944\t        &mut a,\n   945\t        &mut b,\n   946\t        0,\n   947\t        std::ptr::null_mut(),\n   948\t        std::ptr::null_mut(),\n   949\t    );\n   950\t    if d < 1.0e-6 {\n   951\t        let bx = if bx_ptr.is_null() {\n   952\t            c2xIdentity()\n   953\t        } else {\n   954\t            *bx_ptr\n   955\t        };\n   956\t        let A_in_B = c2Capsule {\n   957\t            a: c2MulxvT(bx, A.a),\n   958\t            b: c2MulxvT(bx, A.b),\n   959\t            r: 0.0,\n   960\t        };\n   961\t        let ab = c2Norm(c2Sub(A_in_B.a, A_in_B.b));\n   962\t        let ab_h0 = c2h {\n   963\t            n: c2CCW90(ab),\n   964\t            d: c2Dot(A_in_B.a, c2CCW90(ab)),\n   965\t        };\n   966\t        let v0 = c2Support(\n   967\t            (*B).verts.as_ptr(),\n   968\t            (*B).count,\n   969\t            c2Neg(ab_h0.n),\n   970\t        );\n   971\t        let s0 = c2Dist(ab_h0, (*B).verts[v0 as usize]);\n   972\t        let ab_h1 = c2h {\n   973\t            n: c2Skew(ab),\n   974\t            d: c2Dot(A_in_B.a, c2Skew(ab)),\n   975\t        };\n   976\t        let v1 = c2Support(\n   977\t            (*B).verts.as_ptr(),\n   978\t            (*B).count,\n   979\t            c2Neg(ab_h1.n),\n   980\t        );\n   981\t        let s1 = c2Dist(ab_h1, (*B).verts[v1 as usize]);\n   982\t        let mut index: c_int = !0;\n   983\t        let mut sep = -c_float::MAX;\n   984\t        let mut code = 0;\n   985\t        for i in 0..(*B).count {\n   986\t            let h = c2PlaneAt(B, i);\n   987\t            let da = c2Dot(A_in_B.a, c2Neg(h.n));\n   988\t            let db = c2Dot(A_in_B.b, c2Neg(h.n));\n   989\t            let distance = if da > db {\n   990\t                c2Dist(h, A_in_B.a)\n   991\t            } else {\n   992\t                c2Dist(h, A_in_B.b)\n   993\t            };\n   994\t            if distance > sep {\n   995\t                sep = distance;\n   996\t                index = i;\n   997\t            }\n   998\t        }\n   999\t        if s0 > sep {\n  1000\t            sep = s0;\n  1001\t            index = v0;\n  1002\t            code = 1;\n  1003\t        }\n  1004\t        if s1 > sep {\n  1005\t            index = v1;\n  1006\t            code = 2;\n  1007\t        }\n  1008\t        match code {\n  1009\t            0 => {\n  1010\t                let mut seg = [A.a, A.b];\n  1011\t                let mut h = c2h::default();\n  1012\t                if c2SidePlanesFromPoly(seg.as_mut_ptr(), bx, B, index, &mut h) == 0 {\n  1013\t                    return;\n  1014\t                }\n  1015\t                c2KeepDeep(seg.as_mut_ptr(), h, m);\n  1016\t                (*m).n = c2Neg((*m).n);\n  1017\t            }\n  1018\t            1 => {\n  1019\t                let mut incident = [c2v::default(); 2];\n  1020\t                c2Incident(incident.as_mut_ptr(), B, bx, ab_h0.n);\n  1021\t                let mut h = c2h::default();\n  1022\t                if c2SidePlanes(\n  1023\t                    incident.as_mut_ptr(),\n  1024\t                    A_in_B.b,\n  1025\t                    A_in_B.a,\n  1026\t                    &mut h,\n  1027\t                ) == 0\n  1028\t                {\n  1029\t                    return;\n  1030\t                }\n  1031\t                c2KeepDeep(incident.as_mut_ptr(), h, m);\n  1032\t            }\n  1033\t            2 => {\n  1034\t                let mut incident = [c2v::default(); 2];\n  1035\t                c2Incident(incident.as_mut_ptr(), B, bx, ab_h1.n);\n  1036\t                let mut h = c2h::default();\n  1037\t                if c2SidePlanes(\n  1038\t                    incident.as_mut_ptr(),\n  1039\t                    A_in_B.a,\n  1040\t                    A_in_B.b,\n  1041\t                    &mut h,\n  1042\t                ) == 0\n  1043\t                {\n  1044\t                    return;\n  1045\t                }\n  1046\t                c2KeepDeep(incident.as_mut_ptr(), h, m);\n  1047\t            }\n  1048\t            _ => return,\n  1049\t        }\n  1050\t        for i in 0..(*m).count {\n  1051\t            (*m).depths[i as usize] += A.r;\n  1052\t        }\n  1053\t    } else if d < A.r {\n  1054\t        (*m).count = 1;\n  1055\t        (*m).n = c2Norm(c2Sub(b, a));\n  1056\t        (*m).contact_points[0] = c2Add(a, c2Mulvs((*m).n, A.r));\n  1057\t        (*m).depths[0] = A.r - d;\n  1058\t    }\n  1059\t}\n  1060\t\n  1061\t#[unsafe(no_mangle)]\n  1062\tpub unsafe extern \"C\" fn c2Norms(verts: *mut c2v, norms: *mut c2v, count: c_int) {\n  1063\t    for i in 0.