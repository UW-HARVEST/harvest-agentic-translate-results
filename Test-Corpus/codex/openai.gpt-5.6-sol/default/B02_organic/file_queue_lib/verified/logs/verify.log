 ALERTS_DAILY \"alerts.log\"\n    17\t\n    18\t#define CRALERT_MAIL_SET    0x001\n    19\t#define CRALERT_EXEC_SET    0x002\n    20\t#define CRALERT_READ_ALL    0x004\n    21\t#define CRALERT_READ_FAILED 0x008\n    22\t#define CRALERT_FP_SET      0x010\n    23\t\n    24\t/* File queue */\n    25\ttypedef struct alert_data {\n    26\t    unsigned int rule;\n    27\t    unsigned int level;\n    28\t    char *alertid;\n    29\t    char *date;\n    30\t    char *location;\n    31\t    char *comment;\n    32\t    char *group;\n    33\t    char *srcip;\n    34\t    int srcport;\n    35\t    char *dstip;\n    36\t    int dstport;\n    37\t    char *user;\n    38\t    char *filename;\n    39\t} alert_data;\n    40\t\n    41\talert_data *GetAlertData(int flag, FILE *fp) __attribute__((nonnull));\n    42\tvoid        FreeAlertData(alert_data *al_data) __attribute__((nonnull));\n    43\t\n    44\t#endif /* CRALERT_H */\n     1\t#ifndef SHARED_H\n     2\t#define SHARED_H\n     3\t\n     4\t#include <stdlib.h>\n     5\t#include <stdio.h>\n     6\t#include <string.h>\n     7\t\n     8\t#define OS_MAXSTR 1024\n     9\t\n    10\t#define os_free(x) if(x){free(x);x=NULL;};\n    11\t#define os_clearnl(x,p) if((p = strrchr(x, '\\n')))*p = '\\0';\n    12\t\n    13\tvoid *os_calloc(size_t num, size_t size) {\n    14\t    void *out = calloc(num, size);\n    15\t    if (!out) {\n    16\t        fprintf(stderr, \"Memory allocation failed in os_calloc\");\n    17\t        exit(EXIT_FAILURE);\n    18\t    }\n    19\t    return out;\n    20\t}\n    21\t\n    22\tvoid *os_realloc(void *ptr, size_t new_size) {\n    23\t    void *out = realloc(ptr, new_size);\n    24\t    if (!out) {\n    25\t        fprintf(stderr, \"Memory allocation failed in os_realloc\");\n    26\t        exit(EXIT_FAILURE);\n    27\t    }\n    28\t    return out;\n    29\t}\n    30\t\n    31\tchar *os_strdup(const char *str) {\n    32\t    if (!str) {\n    33\t        fprintf(stderr, \"NULL string passed to os_strdup\");\n