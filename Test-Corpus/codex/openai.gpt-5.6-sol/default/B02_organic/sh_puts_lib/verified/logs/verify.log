      return INDEX_EMPTY;\n   465\t            }\n   466\t        }\n   467\t        position = position.wrapping_add(step);\n   468\t        step = step.wrapping_add(BUCKET_LENGTH);\n   469\t        position &= (*table).slot_count - 1;\n   470\t    }\n   471\t}\n   472\t\n   473\t#[unsafe(no_mangle)]\n   474\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n   475\t    mut map: *mut c_void,\n   476\t    element_size: usize,\n   477\t    key: *mut c_void,\n   478\t    key_size: usize,\n   479\t    temp: *mut isize,\n   480\t    mode: c_int,\n   481\t) -> *mut c_void {\n   482\t    if map.is_null() {\n   483\t        map = stbds_arrgrowf(ptr::null_mut(), element_size, 0, 1);\n   484\t        (*header(map)).length += 1;\n   485\t        ptr::write_bytes(map.cast::<u8>(), 0, element_size);\n   486\t        *temp = INDEX_EMPTY;\n   487\t        array_to_hash(map, element_size)\n   488\t    } else {\n   489\t        let raw_array = hash_to_array(map, element_size);\n   490\t        let table = hash_table(raw_array);\n   491\t        if table.is_null() {\n   492\t            *temp = INDEX_EMPTY;\n   493\t        } else {\n   494\t            let slot = hm_find_slot(map, element_size, key, key_size, 0, mode);\n   495\t            if slot < 0 {\n   496\t                *temp = INDEX_EMPTY;\n   497\t            } else {\n   498\t                let bucket = bucket_at(table, slot as usize);\n   499\t                *temp = (*bucket).index[slot as usize & BUCKET_MASK];\n   500\t            }\n   501\t        }\n   502\t        map\n   503\t    }\n   504\t}\n   505\t\n   506\t#[unsafe(no_mangle)]\n   507\tpub unsafe extern \"C\" fn stbds_hmget_key(\n   508\t    map: *mut c_void,\n   509\t    element_size: usize,\n   510\t    key: *mut c_void,\n   511\t    key_size: usize,\n   512\t    mode: c_int,\n   513\t) -> *mut c_void {\n   514\t    let mut temp = 0;\n   515\t    let result = stbds_hmget_key_ts(map, element_size, key, key_size, &mut temp, mode);\n   516\t    (*header(hash_t