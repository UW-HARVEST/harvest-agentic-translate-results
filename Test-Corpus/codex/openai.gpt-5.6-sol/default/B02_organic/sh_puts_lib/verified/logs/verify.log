 ((size_t) d[5] << 20) << 20;\n   535\t    case 5: data |= ((size_t) d[4] << 16) << 16;\n   536\t    case 4: data |= (d[3] << 24);\n   537\t    case 3: data |= (d[2] << 16);\n   538\t    case 2: data |= (d[1] << 8);\n   539\t    case 1: data |= d[0];\n   540\t    case 0: break;\n   541\t  }\n   542\t  v3 ^= data;\n   543\t  for (j=0; j < STBDS_SIPHASH_C_ROUNDS; ++j)\n   544\t    STBDS_SIPROUND();\n   545\t  v0 ^= data;\n   546\t  v2 ^= 0xff;\n   547\t  for (j=0; j < STBDS_SIPHASH_D_ROUNDS; ++j)\n   548\t    STBDS_SIPROUND();\n   549\t\n   550\t  return v0^v1^v2^v3;\n   551\t}\n   552\t\n   553\tsize_t stbds_hash_bytes(void *p, size_t len, size_t seed)\n   554\t{\n   555\t  return stbds_siphash_bytes(p,len,seed);\n   556\t}\n   557\t\n   558\tstatic int stbds_is_key_equal(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode, size_t i)\n   559\t{\n   560\t  if (mode >= STBDS_HM_STRING)\n   561\t    return 0==strcmp((char *) key, * (char **) ((char *) a + elemsize*i + keyoffset));\n   562\t  else\n   563\t    return 0==memcmp(key, (char *) a + elemsize*i + keyoffset, keysize);\n   564\t}\n   565\t\n   566\t#define STBDS_HASH_TO_ARR(x,elemsize) ((char*) (x) - (elemsize))\n   567\t#define STBDS_ARR_TO_HASH(x,elemsize) ((char*) (x) + (elemsize))\n   568\t\n   569\t#define stbds_hash_table(a)  ((stbds_hash_index *) stbds_header(a)->hash_table)\n   570\t\n   571\tvoid stbds_hmfree_func(void *a, size_t elemsize)\n   572\t{\n   573\t  if (a == NULL) return;\n   574\t  if (stbds_hash_table(a) != NULL) {\n   575\t    if (stbds_hash_table(a)->string.mode == STBDS_SH_STRDUP) {\n   576\t      size_t i;\n   577\t      for (i=1; i < stbds_header(a)->length; ++i)\n   578\t        STBDS_FREE(NULL, *(char**) ((char *) a + elemsize*i));\n   579\t    }\n   580\t    stbds_strreset(&stbds_hash_table(a)->string);\n   581\t  }\n   582\t  STBDS_FREE(NULL, stbds_header(a)->hash_table);\n   583\t  STBDS_FREE(NULL, stbds_header(a));\n   584\t}\n   585\t\n   586\tstatic