 0;\n   634\t  if (a == NULL) {\n   635\t    a = stbds_arrgrowf(0, elemsize, 0, 1);\n   636\t    stbds_header(a)->length += 1;\n   637\t    memset(a, 0, elemsize);\n   638\t    *temp = STBDS_INDEX_EMPTY;\n   639\t    return STBDS_ARR_TO_HASH(a,elemsize);\n   640\t  } else {\n   641\t    stbds_hash_index *table;\n   642\t    void *raw_a = STBDS_HASH_TO_ARR(a,elemsize);\n   643\t    table = (stbds_hash_index *) stbds_header(raw_a)->hash_table;\n   644\t    if (table == 0) {\n   645\t      *temp = -1;\n   646\t    } else {\n   647\t      ptrdiff_t slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n   648\t      if (slot < 0) {\n   649\t        *temp = STBDS_INDEX_EMPTY;\n   650\t      } else {\n   651\t        stbds_hash_bucket *b = &table->storage[slot >> STBDS_BUCKET_SHIFT];\n   652\t        *temp = b->index[slot & STBDS_BUCKET_MASK];\n   653\t      }\n   654\t    }\n   655\t    return a;\n   656\t  }\n   657\t}\n   658\t\n   659\tvoid * stbds_hmget_key(void *a, size_t elemsize, void *key, size_t keysize, int mode)\n   660\t{\n   661\t  ptrdiff_t temp;\n   662\t  void *p = stbds_hmget_key_ts(a, elemsize, key, keysize, &temp, mode);\n   663\t  stbds_temp(STBDS_HASH_TO_ARR(p,elemsize)) = temp;\n   664\t  return p;\n   665\t}\n   666\t\n   667\tvoid * stbds_hmput_default(void *a, size_t elemsize)\n   668\t{\n   669\t  if (a == NULL || stbds_header(STBDS_HASH_TO_ARR(a,elemsize))->length == 0) {\n   670\t    a = stbds_arrgrowf(a ? STBDS_HASH_TO_ARR(a,elemsize) : NULL, elemsize, 0, 1);\n   671\t    stbds_header(a)->length += 1;\n   672\t    memset(a, 0, elemsize);\n   673\t    a=STBDS_ARR_TO_HASH(a,elemsize);\n   674\t  }\n   675\t  return a;\n   676\t}\n   677\t\n   678\tstatic char *stbds_strdup(char *str);\n   679\t\n   680\tvoid *stbds_hmput_key(void *a, size_t elemsize, void *key, size_t keysize, int mode)\n   681\t{\n   682\t  size_t keyoffset=0;\n   683\t  void *raw_a;\n   684\t  stbds_hash_index *table;\n   685\t\n   686\t  if (a == NULL) {\n   687\t    a = stbds_arrgrowf(0, elemsize, 0, 1);\n   688\t    memset(a, 0, elemsize);\n   689\t    stbds_header(a)->length += 1;\n   690\t    a = STBDS_ARR_TO_HASH(a,elemsize);\n   691\t  }\n   692\t\n   693\t  raw_a = a;\n   694\t  a = STBDS_HASH_TO_ARR(a,elemsize);\n   695\t\n   696\t  table = (stbds_hash_index *) stbds_header(a)->hash_table;\n   697\t\n   698\t  if (table == NULL || table->used_count >= table->used_count_threshold) {\n   699\t    stbds_hash_index *nt;\n   700\t    size_t slot_count;\n   701\t\n   702\t    slot_count = (table == NULL) ? STBDS_BUCKET_LENGTH : table->slot_count*2;\n   703\t    nt = stbds_make_hash_index(slot_count, table);\n   704\t    if (table)\n   705\t      STBDS_FREE(NULL, table);\n   706\t    else\n   707\t      nt->string.mode = mode >= STBDS_HM_STRING ? STBDS_SH_DEFAULT : 0;\n   708\t    stbds_header(a)->hash_table = table = nt;\n   709\t    STBDS_STATS(++stbds_hash_grow);\n   710\t  }\n   711\t\n   712\t  {\n   713\t    size_t hash = mode >= STBDS_HM_STRING ? stbds_hash_string((char*)key,table->seed) : stbds_hash_bytes(key, keysize,table->seed);\n   714\t    size_t step = STBDS_BUCKET_LENGTH;\n   715\t    size_t pos;\n   716\t    ptrdiff_t tombstone = -1;\n   717\t    stbds_hash_bucket *bucket;\n   718\t\n   719\t    if (hash < 2) hash += 2;\n   720\t\n   721\t    pos = stbds_probe_position(hash, table->slot_count, table->slot_count_log2);\n   722\t\n   723\t    for (;;) {\n   724\t      size_t limit, i;\n   725\t      STBDS_STATS(++stbds_hash_probes);\n   726\t      bucket = &table->storage[pos >> STBDS_BUCKET_SHIFT];\n   727\t\n   728\t      for (i=pos & STBDS_BUCKET_MASK; i < STBDS_BUCKET_LENGTH; ++i) {\n   729\t        if (bucket->hash[i] == hash) {\n   730\t          if (stbds_is_key_equal(raw_a, elemsize, key, keysize, keyoffset, mode, bucket->index[i])) {\n   731\t            stbds_temp(a) = bucket->index[i];\n   732\t            if (mode >= STBDS_HM_STRING)\n   733\t              stbds_temp_key(a) = * (char **) ((char *) raw_a + elemsize*bucket->index[i] + keyoffset);\n   734\t            return STBDS_ARR_TO_HASH(a,elemsize);\n   735\t          }\n   736\t        } else if (bucket->hash[i] == 0) {\n   737\t          pos = (pos & ~STBDS_BUCKET_MASK) + i;\n   738\t          goto found_empty_slot;\n   739\t        } else if (tombstone < 0) {\n   740\t          if (bucket->index[i] == STBDS_INDEX_DELETED)\n   741\t            tombstone = (ptrdiff_t) ((pos & ~STBDS_BUCKET_MASK) + i);\n   742\t        }\n   743\t      }\n   744\t\n   745\t      limit = pos & STBDS_BUCKET_MASK;\n   746\t      for (i = 0; i < limit; ++i) {\n   747\t        if (bucket->hash[i] == hash) {\n   748\t          if (stbds_is_key_equal(raw_a, elemsize, key, keysize, keyoffset, mode, bucket->index[i])) {\n   749\t            stbds_temp(a) = bucket->index[i];\n   750\t            return STBDS_ARR_TO_HASH(a,elemsize);\n   751\t          }\n   752\t        } else if (bucket->hash[i] == 0) {\n   753\t          pos = (pos & ~STBDS_BUCKET_MASK) + i;\n   754\t          goto found_empty_slot;\n   755\t        } else if (tombstone < 0) {\n   756\t          if (bucket->index[i] == STBDS_INDEX_DELETED)\n   757\t            tombstone = (ptrdiff_t) ((pos & ~STBDS_BUCKET_MASK) + i);\n   758\t        }\n   759\t      }\n   760\t\n   761\t      pos += step;\n   762\t      step += STBDS_BUCKET_LENGTH;\n   763\t      pos &= (table->slot_count-1);\n   764\t    }\n   765\t   found_empty_slot:\n   766\t    if (tombstone >= 0) {\n   767\t      pos = tombstone;\n   768\t      --table->tombstone_count;\n   769\t    }\n   770\t    ++table->used_count;\n   771\t\n   772\t    {\n   773\t      ptrdiff_t i = (ptrdiff_t) stbds_arrlen(a);\n   774\t      if ((size_t) i+1 > stbds_arrcap(a))\n   775\t        *(void **) &a = stbds_arrgrowf(a, elemsize, 1, 0);\n   776\t      raw_a = STBDS_ARR_TO_HASH(a,elemsize);\n   777\t\n   778\t      STBDS_ASSERT((size_t) i+1 <= stbds_arrcap(a));\n   779\t      stbds_header(a)->length = i+1;\n   780\t      bucket = &table->storage[pos >> STBDS_BUCKET_SHIFT];\n   781\t      bucket->hash[pos & STBDS_BUCKET_MASK] = hash;\n   782\t      bucket->index[pos & STBDS_BUCKET_MASK] = i-1;\n   783\t      stbds_temp(a) = i-1;\n   784\t\n   785\t      switch (table->string.mode) {\n   786\t         case STBDS_SH_STRDUP:  stbds_temp_key(a) = *(char **) ((char *) a + elemsize*i) = stbds_strdup((char*) key); break;\n   787\t         case STBDS_SH_ARENA:   stbds_temp_key(a) = *(char **) ((char *) a + elemsize*i) = stbds_stralloc(&table->string, (char*)key); break;\n   788\t         case STBDS_SH_DEFAULT: stbds_temp_key(a) = *(char **) ((char *) a + elemsize*i) = (char *) key; break;\n   789\t         default:                memcpy((char *) a + elemsize*i, key, keysize); break;\n   790\t      }\n   791\t    }\n   792\t    return STBDS_ARR_TO_HASH(a,elemsize);\n   793\t  }\n   794\t}\n   795\t\n   796\tvoid * stbds_shmode_func(size_t elemsize, int mode)\n   797\t{\n   798\t  void *a = stbds_arrgrowf(0, elemsize, 0, 1);\n   799\t  stbds_hash_index *h;\n   800\t  memset(a, 0, elemsize);\n   801\t  stbds_header(a)->length = 1;\n   802\t  stbds_header(a)->hash_table = h = (stbds_hash_index *) stbds_make_hash_index(STBDS_BUCKET_LENGTH, NULL);\n   803\t  h->string.mode = (unsigned char) mode;\n   804\t  return STBDS_ARR_TO_HASH(a,elemsize);\n   805\t}\n   806\t\n   807\tvoid * stbds_hmdel_key(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode)\n   808\t{\n   809\t  if (a == NULL) {\n   810\t    return 0;\n   811\t  } else {\n   812\t    stbds_hash_index *table;\n   813\t    void *raw_a = STBDS_HASH_TO_ARR(a,elemsize);\n   814\t    table = (stbds_hash_index *) stbds_header(raw_a)->hash_table;\n   815\t    stbds_temp(raw_a) = 0;\n   816\t    if (table == 0) {\n   817\t      return a;\n   818\t    } else {\n   819\t      ptrdiff_t slot;\n   820\t      slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n   821\t      if (slot < 0)\n   822\t        return a;\n   823\t      else {\n   824\t        stbds_hash_bucket *b = &table->storage[slot >> STBDS_BUCKET_SHIFT];\n   825\t        int i = slot & STBDS_BUCKET_MASK;\n   826\t        ptrdiff_t old_index = b->index[i];\n   827\t        ptrdiff_t final_index = (ptrdiff_t) stbds_arrlen(raw_a)-1-1;\n   828\t        STBDS_ASSERT(slot < (ptrdiff_t) table->slot_count);\n   829\t        --table->used_count;\n   830\t        ++table->tombstone_count;\n   831\t        stbds_temp(raw_a) = 1;\n   832\t        STBDS_ASSERT(table->used_count >= 0);\n   833\t        b->hash[i] = STBDS_HASH_DELETED;\n   834\t        b->index[i] = STBDS_INDEX_DELETED;\n   835\t\n   836\t        if (mode == STBDS_HM_STRING && table->string.mode == STBDS_SH_STRDUP)\n   837\t          STBDS_FREE(NULL, *(char**) ((char *) a+elemsize*old_index));\n   838\t\n   839\t        if (old_index != final_index) {\n   840\t          memmove((char*) a + elemsize*old_index, (char*) a + elemsize*final_index, elemsize);\n   841\t\n   842\t          if (mode == STBDS_HM_STRING)\n   843\t            slot = stbds_hm_find_slot(a, elemsize, *(char**) ((char *) a+elemsize*old_index + keyoffset), keysize, keyoffset, mode);\n   844\t          else\n   845\t            slot = stbds_hm_find_slot(a, elemsize,  (char* ) a+elemsize*old_index + keyoffset, keysize, keyoffset, mode);\n   846\t          STBDS_ASSERT(slot >= 0);\n   847\t          b = &table->storage[slot >> STBDS_BUCKET_SHIFT];\n   848\t          i = slot & STBDS_BUCKET_MASK;\n   849\t          STBDS_ASSERT(b->index[i] == final_index);\n   850\t          b->index[i] = old_index;\n   851\t        }\n   852\t        stbds_header(raw_a)->length -= 1;\n   853\t\n   854\t        if (table->used_count < table->used_count_shrink_threshold && table->slot_count > STBDS_BUCKET_LENGTH) {\n   855\t          stbds_header(raw_a)->hash_table = stbds_make_hash_index(table->slot_count>>1, table);\n   856\t          STBDS_FREE(NULL, table);\n   857\t          STBDS_STATS(++stbds_hash_s