                  .cast::<*mut c_char>();\n   612\t                    }\n   613\t                    return array_to_hash(raw_array, element_size);\n   614\t                }\n   615\t            } else if (*bucket).hash[i] == HASH_EMPTY {\n   616\t                position = (position & !BUCKET_MASK) + i;\n   617\t                break 'search;\n   618\t            } else if tombstone < 0 && (*bucket).index[i] == INDEX_DELETED {\n   619\t                tombstone = ((position & !BUCKET_MASK) + i) as isize;\n   620\t            }\n   621\t        }\n   622\t\n   623\t        for i in 0..(position & BUCKET_MASK) {\n   624\t            if (*bucket).hash[i] == hash {\n   625\t                if is_key_equal(\n   626\t                    public_array,\n   627\t                    element_size,\n   628\t                    key,\n   629\t                    key_size,\n   630\t                    0,\n   631\t                    mode,\n   632\t                    (*bucket).index[i] as usize,\n   633\t                ) {\n   634\t                    (*header(raw_array)).temp = (*bucket).index[i];\n   635\t                    return array_to_hash(raw_array, element_size);\n   636\t                }\n   637\t            } else if (*bucket).hash[i] == HASH_EMPTY {\n   638\t                position = (position & !BUCKET_MASK) + i;\n   639\t                break 'search;\n   640\t            } else if tombstone < 0 && (*bucket).index[i] == INDEX_DELETED {\n   641\t                tombstone = ((position & !BUCKET_MASK) + i) as isize;\n   642\t            }\n   643\t        }\n   644\t\n   645\t        position = position.wrapping_add(step);\n   646\t        step = step.wrapping_add(BUCKET_LENGTH);\n   647\t        position &= (*table).slot_count - 1;\n   648\t    }\n   649\t\n   650\t    if tombstone >= 0 {\n   651\t        position = tombstone as usize;\n   652\t        (*table).tombstone_count -= 1;\n   653\t    }\n   654\t    (*table).used_count += 1;\n   655\t\n   656\t    let index = array_len(raw_array) as isize;\n   657\t    if index as usize + 1 > array_capacity(raw_array) {\n   658\t        raw_array = stbds_arrgrowf(raw_array, element_size, 1, 0);\n   659\t    }\n   660\t    public_array = array_to_hash(raw_array, element_size);\n   661\t    (*header(raw_array)).length = index as usize + 1;\n   662\t\n   663\t    let bucket = bucket_at(table, position);\n   664\t    (*bucket).hash[position & BUCKET_MASK] = hash;\n   665\t    (*bucket).index[position & BUCKET_MASK] = index - 1;\n   666\t    (*header(raw_array)).temp = index - 1;\n   667\t\n   668\t    let destination = raw_array\n   669\t        .cast::<u8>()\n   670\t        .add(element_size.wrapping_mul(index as usize));\n   671\t    match (*table).string.mode {\n   672\t        SH_STRDUP => {\n   673\t            let stored = duplicate_string(key.cast());\n   674\t            *destination.cast::<*mut c_char>() = stored;\n   675\t            (*table).temp_key = stored;\n   676\t        }\n   677\t        SH_ARENA => {\n   678\t            let stored = stbds_stralloc(ptr::addr_of_mut!((*table).string), key.cast());\n   679\t            *destination.cast::<*mut c_char>() = stored;\n   680\t            (*table).temp_key = stored;\n   681\t        }\n   682\t        SH_DEFAULT => {\n   683\t            let stored = key.cast::<c_char>();\n   684\t            *destination.cast::<*mut c_char>() = stored;\n   685\t            (*table).temp_key = stored;\n   686\t        }\n   687\t        _ => ptr::copy_nonoverlapping(key.cast::<u8>(), destination, key_size),\n   688\t    }\n   689\t\n   690\t    public_array\n   691\t}\n   692\t\n   693\t#[unsafe(no_mangle)]\n   694\tpub unsafe extern \"C\" fn stbds_shmode_func(element_size: usize, mode: c_int) -> *mut c_void {\n   695\t    let raw_array = stbds_arrgrowf(ptr::null_mut(), element_size, 0, 1);\n   696\t    ptr::write_bytes(raw_array.cast::<u8>(), 0, element_size);\n   697\t    (*header(raw_array)).length = 1;\n   698\t    let table = make