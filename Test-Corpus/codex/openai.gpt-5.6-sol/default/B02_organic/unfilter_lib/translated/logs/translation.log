{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc 'C_SO=\"$(cat /tmp/harvest-J42nOk-c-build-path)/libharvest-work-J42nOk.so\" RUST_SO=\"$PWD/target/release/libtranslation.so\" python3 - <<'\"'PY'\nimport ctypes\nimport os\nimport random\nimport zlib\n\nc = ctypes.CDLL(os.environ['C_SO'])\nr = ctypes.CDLL(os.environ['RUST_SO'])\n\nobjects = [\n    ('cp_fixed_table', ctypes.c_uint8, 320),\n    ('cp_permutation_order', ctypes.c_uint8, 19),\n    ('cp_len_extra_bits', ctypes.c_uint8, 31),\n    ('cp_len_base', ctypes.c_uint32, 31),\n    ('cp_dist_extra_bits', ctypes.c_uint8, 32),\n    ('cp_dist_base', ctypes.c_uint32, 32),\n]\nfor name, typ, count in objects:\n    ca = (typ * count).in_dll(c, name)\n    ra = (typ * count).in_dll(r, name)\n    assert bytes(ca) == bytes(ra), name\nassert ctypes.c_void_p.in_dll(c, 'cp_error_reason').value is None\nassert ctypes.c_void_p.in_dll(r, 'cp_error_reason').value is None\nprint('globals: 7/7 values and initial pointer match')\n\nfor lib in (c, r):\n    lib.unfilter.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.c_uint8)]\n    lib.unfilter.restype = ctypes.c_int\n    lib.cp_inflate.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p, ctypes.c_int]\n    lib.cp_inflate.restype = ctypes.c_int\n\nrng = random.Random(0xC0DEC0DE)\nunfilter_cases = 0\nfor _ in range(5000):\n    w = rng.randint(1, 24)\n    h = rng.randint(0, 12)\n    bpp = rng.randint(1, 8)\n    row_len = w * bpp\n    data = bytearray()\n    for y in range(h):\n        data.append(rng.randrange(5))\n        data.extend(rng.randbytes(row_len))\n    if h and rng.randrange(8) == 0:\n        bad_row = rng.randrange(h)\n        data[bad_row * (row_len + 1)] = rng.randrange(5, 256)\n    alloc = max(1, len(data))\n    cb = (ctypes.c_uint8 * alloc)()\n    rb = (ctypes.c_uint8 * alloc)()\n    if data:\n        cb[:len(data)] = data\n        rb[:len(data)] = data\n    cr = c.unfilter(w, h, bpp, cb)\n    