{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/zsh -lc 'C_SO=\"$(cat /tmp/harvest-J42nOk-c-build-path)/libharvest-work-J42nOk.so\" RUST_SO=\"$PWD/target/release/libtranslation.so\" python3 - <<'\"'PY'\nimport ctypes, os, random, zlib\nC=ctypes.CDLL(os.environ['C_SO']); R=ctypes.CDLL(os.environ['RUST_SO'])\nfor lib in (C,R):\n    lib.unfilter.argtypes=[ctypes.c_int]*3+[ctypes.POINTER(ctypes.c_ubyte)]; lib.unfilter.restype=ctypes.c_int\n    lib.cp_inflate.argtypes=[ctypes.c_void_p,ctypes.c_int,ctypes.c_void_p,ctypes.c_int]; lib.cp_inflate.restype=ctypes.c_int\nfor name,t,n in [('cp_fixed_table',ctypes.c_ubyte,320),('cp_permutation_order',ctypes.c_ubyte,19),('cp_len_extra_bits',ctypes.c_ubyte,31),('cp_len_base',ctypes.c_uint32,31),('cp_dist_extra_bits',ctypes.c_ubyte,32),('cp_dist_base',ctypes.c_uint32,32)]:\n    assert bytes((t*n).in_dll(C,name))==bytes((t*n).in_dll(R,name)),name\nrng=random.Random(0xC0DEC0DE)\nfor case in range(5000):\n    w,h,bpp=rng.randrange(1,25),rng.randrange(13),rng.randrange(1,9); row=w*bpp; data=bytearray()\n    for _ in range(h): data.append(rng.randrange(5)); data.extend(rng.randbytes(row))\n    if h and rng.randrange(8)==0: data[rng.randrange(h)*(row+1)]=rng.randrange(5,256)\n    n=max(1,len(data)); a=(ctypes.c_ubyte*n)(); b=(ctypes.c_ubyte*n)()\n    if data: a[:len(data)]=data; b[:len(data)]=data\n    assert (C.unfilter(w,h,bpp,a),bytes(a))==(R.unfilter(w,h,bpp,b),bytes(b)),case\n\ndef call(lib,s,align,outn,initial):\n    src=(ctypes.c_ubyte*(len(s)+8))(); base=ctypes.addressof(src); off=(align-(base&3))&3; src[off:off+len(s)]=s\n    dst=(ctypes.c_ubyte*len(initial))(*initial); reason=ctypes.c_void_p.in_dll(lib,'cp_error_reason'); reason.value=None\n    ret=lib.cp_inflate(base+off,len(s),dst,outn); msg=ctypes.string_at(reason.value) if reason.value else None\n    return ret,bytes(dst),msg\nseen=set()\nfor case in range(600):\n    n=rng.randrange(20000); mode=rng.randrange(4)\n    if mode==0: data=rng.randbytes(n)\n    elif mode==1: data=bytes([rng.randrange(256)])*n\n    elif mode==2:\n        token=rng.randbytes(rng.randrange(1,65)); data=(token*((n+len(token)-1)//len(token)))[:n]\n    else:\n        m=rng.randrange(1,256); d=max(1,rng.randrange(1,40)); data=bytes((i*m+i//d)&255 for i in range(n))\n    strategy=rng.choice([zlib.Z_DEFAULT_STRATEGY,zlib.Z_FIXED]); level=rng.randrange(1,10)\n    o=zlib.compressobj(level,zlib.DEFLATED,-15,8,strategy); s=o.compress(data)+o.flush(); seen.add((s[0]>>1)&3)\n    align=rng.randrange(4); initial=random.Random(case).randbytes(n+32)\n    assert call(C,s,align,n,initial)==call(R,s,align,n,initial),(case,n,len(s))\n\nlens=[8]*144+[9]*112+[7]*24+[8]*8; counts=[0]*16\nfor n in lens: counts[n]+=1\ncounts[0]=0; code=0; nxt=[0]*16\nfor bits in range(1,16): code=(code+counts[bits-1])<<1; nxt[bits]=code\ncodes=[]\nfor n in lens: codes.append(nxt[n]); nxt[n]+=1\ndef rev(v,n):\n    x=0\n    for _ in range(n): x=(x<<1)|(v&1); v>>=1\n    return x\ndef fixed(symbols,dist=False):\n    value=1|(1<<1); bits=3\n    for sym in symbols: value|=rev(codes[sym],lens[sym])<<bits; bits+=lens[sym]\n    if dist: bits+=5\n    return value.to_bytes((bits+7)//8,'little')\nerrors=[\n    (fixed([65]),0,b'Attempted to overwrite out buffer while outputting a symbol.'),\n    (fixed([257],True),16,b'Attempted to write before out buffer (invalid backwards distance).'),\n    (fixed([65,257],True),1,b'Attempted to overwrite out buffer while outputting a string.'),\n    (b'\\\\x07',16,b'Detected unknown block type within input stream.'),\n]\nfor i,(s,outn,message) in enumerate(errors):\n    initial=bytes([0xa5])*32; cv=call(C,s,i%4,outn,initial); rv=call(R,s,i%4,outn,initial)\n    assert cv==rv,(i,cv,rv); assert cv[0]==0 and cv[2]==message,(i,cv)\nprint(f'final behavior: globals match; unfilter=5000; inflate-random=600 types={sorted(seen)}; targeted-errors={len(errors)}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
