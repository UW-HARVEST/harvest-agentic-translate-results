size = len(out_dir) + 1 + len(filename) + suffix_len + 1\n    outputs = []\n    for lib in (c_lib, rust_lib):\n        result = lib.FIO_createFilename_fromOutDir(path, out_dir, suffix_len)\n        assert result, (path, out_dir, suffix_len)\n        outputs.append(ctypes.string_at(result, allocation_size))\n        libc.free(result)\n    assert outputs[0] == outputs[1], (path, out_dir, suffix_len, outputs)\n    fio_cases += 1\n\nprint(f\\\"extractFilename cases compared: {extract_cases}\\\")\nprint(f\\\"FIO_createFilename_fromOutDir allocations compared: {fio_cases}\\\")\nprint(\\\"All allocated bytes matched the C reference.\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
