c2v c2Div(c2v a, float b) {\r\n   334\t\treturn c2Mulvs(a, 1.0f / b);\r\n   335\t}\r\n   336\t\r\n   337\tc2v c2Norm(c2v a) {\r\n   338\t\treturn c2Div(a, c2Len(a));\r\n   339\t}\r\n   340\t\r\n   341\tc2v c2L(c2Simplex *s) {\r\n   342\t    float den = 1.0f / s->div;\r\n   343\t    switch (s->count) {\r\n   344\t    case 1:\r\n   345\t        return s->a.p;\r\n   346\t    case 2:\r\n   347\t        return c2Add(c2Mulvs(s->a.p, (den * s->a.u)),\r\n   348\t                     c2Mulvs(s->b.p, (den * s->b.u)));\r\n   349\t    default:\r\n   350\t        return c2V(0, 0);\r\n   351\t    }\r\n   352\t}\r\n   353\t\r\n   354\tc2v c2MulrvT(c2r a, c2v b) {\r\n   355\t    return c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y);\r\n   356\t}\r\n   357\t\r\n   358\tfloat c2GJK(const void *A, C2_TYPE typeA, const c2x *ax_ptr, const void *B,\r\n   359\t\t\tC2_TYPE typeB, const c2x *bx_ptr, c2v *outA, c2v *outB,\r\n   360\t\t\tint use_radius, int *iterations, c2GJKCache *cache) {\r\n   361\t\tc2x ax;\r\n   362\t\tc2x bx;\r\n   363\t\tif (!ax_ptr)\r\n   364\t\t\tax = c2xIdentity();\r\n   365\t\telse\r\n   366\t\t\tax = *ax_ptr;\r\n   367\t\tif (!bx_ptr)\r\n   368\t\t\tbx = c2xIdentity();\r\n   369\t\telse\r\n   370\t\t\tbx = *bx_ptr;\r\n   371\t\tc2Proxy pA;\r\n   372\t\tc2Proxy pB;\r\n   373\t\tc2MakeProxy(A, typeA, &pA);\r\n   374\t\tc2MakeProxy(B, typeB, &pB);\r\n   375\t\tc2Simplex s;\r\n   376\t\tc2sv *verts = &s.a;\r\n   377\t\tint cache_was_read = 0;\r\n   378\t\tif (cache) {\r\n   379\t\t\tint cache_was_good = !!cache->count;\r\n   380\t\t\tif (cache_was_good) {\r\n   381\t\t\t\tfor (int i = 0; i < cache->count; ++i) {\r\n   382\t\t\t\t\tint iA = cache->iA[i];\r\n   383\t\t\t\t\tint iB = cache->iB[i];\r\n   384\t\t\t\t\tc2v sA = c2Mulxv(ax, pA.verts[iA]);\r\n   385\t\t\t\t\tc2v sB = c2Mulxv(bx, pB.verts[iB]);\r\n   386\t\t\t\t\tc2sv *v = verts + i;\r\n   387\t\t\t\t\tv->iA = iA;\r\n   388\t\t\t\t\tv->sA = sA;\r\n   389\t\t\t\t\tv->iB = iB;\r\n   390\t\t\t\t\tv->sB = sB;\