000000000e-7F *\r\n   447\t\t\t\t\t1.19209289550781250000000000000000000e-7F)\r\n   448\t\t\t\tbreak;\r\n   449\t\t\tint iA = c2Support(pA.verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\r\n   450\t\t\tc2v sA = c2Mulxv(ax, pA.verts[iA]);\r\n   451\t\t\tint iB = c2Support(pB.verts, pB.count, c2MulrvT(bx.r, d));\r\n   452\t\t\tc2v sB = c2Mulxv(bx, pB.verts[iB]);\r\n   453\t\t\tc2sv *v = verts + s.count;\r\n   454\t\t\tv->iA = iA;\r\n   455\t\t\tv->sA = sA;\r\n   456\t\t\tv->iB = iB;\r\n   457\t\t\tv->sB = sB;\r\n   458\t\t\tv->p = c2Sub(v->sB, v->sA);\r\n   459\t\t\tint dup = 0;\r\n   460\t\t\tfor (int i = 0; i < save_count; ++i) {\r\n   461\t\t\t\tif (iA == saveA[i] && iB == saveB[i]) {\r\n   462\t\t\t\t\tdup = 1;\r\n   463\t\t\t\t\tbreak;\r\n   464\t\t\t\t}\r\n   465\t\t\t}\r\n   466\t\t\tif (dup)\r\n   467\t\t\t\tbreak;\r\n   468\t\t\t++s.count;\r\n   469\t\t\t++iter;\r\n   470\t\t}\r\n   471\t\tc2v a, b;\r\n   472\t\tc2Witness(&s, &a, &b);\r\n   473\t\tfloat dist = c2Len(c2Sub(a, b));\r\n   474\t\tif (hit) {\r\n   475\t\t\ta = b;\r\n   476\t\t\tdist = 0;\r\n   477\t\t} else if (use_radius) {\r\n   478\t\t\tfloat rA = pA.radius;\r\n   479\t\t\tfloat rB = pB.radius;\r\n   480\t\t\tif (dist > rA + rB &&\r\n   481\t\t\t\t\tdist > 1.19209289550781250000000000000000000e-7F) {\r\n   482\t\t\t\tdist -= rA + rB;\r\n   483\t\t\t\tc2v n = c2Norm(c2Sub(b, a));\r\n   484\t\t\t\ta = c2Add(a, c2Mulvs(n, rA));\r\n   485\t\t\t\tb = c2Sub(b, c2Mulvs(n, rB));\r\n   486\t\t\t\tif (a.x == b.x && a.y == b.y)\r\n   487\t\t\t\t\tdist = 0;\r\n   488\t\t\t} else {\r\n   489\t\t\t\tc2v p = c2Mulvs(c2Add(a, b), 0.5f);\r\n   490\t\t\t\ta = p;\r\n   491\t\t\t\tb = p;\r\n   492\t\t\t\tdist = 0;\r\n   493\t\t\t}\r\n   494\t\t}\r\n   495\t\tif (cache) {\r\n   496\t\t\tcache->metric = c2GJKSimplexMetric(&s);\r\n   497\t\t\tcache->count = s.count;\r\n   498\t\t\tfor (int i = 0; i < s.count; ++i) {\r\n   499\t\t\t\tc2sv *v = verts + i;\r\n   500\t\t\t\tcache->iA[i] = v->iA;\r\n   501\t\t\t\tcache->iB[i] = v->iB;\r\n   502\t\t\t}\r\n   503\t\t\tcache->div = s.div;\r\n   504\t\t}\r\n   505\t\tif (outA)\r\n   506\t\t\t*outA = a;\r\n   507\t\tif (outB)\r\n   508\t\t\t*outB = b;\r\n   509\t\tif (iterations)\r\n   510\t\t\t*iterations = iter;\r\n   511\t\treturn dist;\r\n   512\t}\r\n   513\t\r\n   514\tvoid gjk(char reverse, c2v *a, c2v *b, float a1, float a2, float a3, float a4,\r\n   515\t\t\tfloat b1, float b2, float b3, float b4, float b5) {\r\n   516\t\tc2AABB bb;\r\n   517\t        bb.min = c2V(a1, a2);\r\n   518\t        bb.max = c2V(a3, a4);\r\n   519\t\r\n   520\t\tc2Capsule cap;\r\n   521\t\tcap.a = c2V(b1, b2);\r\n   522\t\tcap.b = c2V(b3, b4);\r\n   523\t\tcap.r = b5;\r\n   524\t\r\n   525\t\tif (reverse) {\r\n   526\t\t\tc2GJK(&cap, C2_TYPE_CAPSULE, 0, &bb, C2_TYPE_AABB, 0, a, b, 1, 0, 0);\r\n   527\t\t} else {\r\n   528\t\t\tc2GJK(&bb, C2_TYPE_AABB, 0, &cap, C2_TYPE_CAPSULE, 0, a, b, 1, 0, 0);\r\n   529\t\t}\r\n   530\t}\r\n","exit_code":0,"status":"completed"}}
