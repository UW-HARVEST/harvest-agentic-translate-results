{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"cat > /tmp/harvest-ALCCGb-reference/differential.py <<'PY'\nimport ctypes, json, os, sys\n\nclass Header(ctypes.Structure):\n    _fields_ = [('length',ctypes.c_size_t),('capacity',ctypes.c_size_t),('hash_table',ctypes.c_void_p),('temp',ctypes.c_ssize_t)]\nclass BinEntry(ctypes.Structure):\n    _fields_ = [('key',ctypes.c_int),('value',ctypes.c_int)]\nclass StrEntry(ctypes.Structure):\n    _fields_ = [('key',ctypes.c_char_p),('value',ctypes.c_longlong)]\nclass Arena(ctypes.Structure):\n    _fields_ = [('storage',ctypes.c_void_p),('remaining',ctypes.c_size_t),('block',ctypes.c_ubyte),('mode',ctypes.c_ubyte)]\n\ndef hdr(raw): return Header.from_address(raw-ctypes.sizeof(Header))\ndef configure(lib):\n    V=ctypes.c_void_p; Z=ctypes.c_size_t; I=ctypes.c_int\n    lib.stbds_rand_seed.argtypes=[Z]\n    lib.stbds_arrgrowf.argtypes=[V,Z,Z,Z]; lib.stbds_arrgrowf.restype=V\n    lib.stbds_arrfreef.argtypes=[V]\n    lib.stbds_hmput_key.argtypes=[V,Z,V,Z,I]; lib.stbds_hmput_key.restype=V\n    lib.stbds_hmget_key.argtypes=[V,Z,V,Z,I]; lib.stbds_hmget_key.restype=V\n    lib.stbds_hmget_key_ts.argtypes=[V,Z,V,Z,ctypes.POINTER(ctypes.c_ssize_t),I]; lib.stbds_hmget_key_ts.restype=V\n    lib.stbds_hmdel_key.argtypes=[V,Z,V,Z,Z,I]; lib.stbds_hmdel_key.restype=V\n    lib.stbds_hmput_default.argtypes=[V,Z]; lib.stbds_hmput_default.restype=V\n    lib.stbds_hmfree_func.argtypes=[V,Z]\n    lib.stbds_shmode_func.argtypes=[Z,I]; lib.stbds_shmode_func.restype=V\n    lib.stbds_stralloc.argtypes=[ctypes.POINTER(Arena),ctypes.c_char_p]; lib.stbds_stralloc.restype=ctypes.c_char_p\n    lib.stbds_strreset.argtypes=[ctypes.POINTER(Arena)]\n\ndef bin_snapshot(p):\n    raw=p-ctypes.sizeof(BinEntry); h=hdr(raw)\n    entries=[BinEntry.from_address(p+i*ctypes.sizeof(BinEntry)) for i in range(h.length-1)]\n    return (h.length,h.capacity,h.temp,[(e.key,e.value) for e in entries])\n\ndef binary(lib):\n    lib.stbds_rand_seed(0x123456789abcdef0)\n    p=None; trace=[]\n    for i in range(180):\n        key=ctypes.c_int((i*73)%257-128)\n        p=lib.stbds_hmput_key(p,ctypes.sizeof(BinEntry),ctypes.byref(key),ctypes.sizeof(key),0)\n        h=hdr(p-ctypes.sizeof(BinEntry)); e=BinEntry.from_address(p+h.temp*ctypes.sizeof(BinEntry))\n        e.key=key.value; e.value=i*11-700\n        if i in (0,4,5,47,95,179): trace.append(('put',i,bin_snapshot(p)))\n    for keyv in [-128,-90,-1,0,73,128,129,999]:\n        key=ctypes.c_int(keyv); p=lib.stbds_hmget_key(p,8,ctypes.byref(key),4,0)\n        h=hdr(p-8); value=None if h.temp<0 else BinEntry.from_address(p+h.temp*8).value\n        trace.append(('get',keyv,h.temp,value))\n    # Replace every existing key without changing order or length.\n    for keyv in list(range(-128,129,7)):\n        key=ctypes.c_int(keyv); before=hdr(p-8).length\n        p=lib.stbds_hmput_key(p,8,ctypes.byref(key),4,0); h=hdr(p-8)\n        e=BinEntry.from_address(p+h.temp*8); e.key=keyv; e.value=0x12340000+keyv\n        trace.append(('replace',keyv,before,h.length,h.temp))\n    # Delete enough keys to trigger tombstone rebuilds and shrinking.\n    for keyv in list(range(-128,129)):\n        if keyv % 3 \"'!= 0:\n            key=ctypes.c_int(keyv); p=lib.stbds_hmdel_key(p,8,ctypes.byref(key),4,0,0)\n            if keyv in (-128,-100,-50,1,100,128): trace.append(('\"'del',keyv,bin_snapshot(p)))\n    trace.append(('final',bin_snapshot(p)))\n    lib.stbds_hmfree_func(p-8,8)\n    return trace\n\ndef string_snapshot(p):\n    raw=p-ctypes.sizeof(StrEntry); h=hdr(raw)\n    entries=[StrEntry.from_address(p+i*ctypes.sizeof(StrEntry)) for i in range(h.length-1)]\n    return (h.length,h.capacity,h.temp,[(e.key.decode('latin1'),e.value) for e in entries])\n\ndef strings(lib, mode):\n    lib.stbds_rand_seed(0xfedcba9876543210)\n    p=lib.stbds_shmode_func(ctypes.sizeof(StrEntry),mode); keep=[]; trace=[]\n    names=[f'key_{(i*97)%211:03d}_{i%9}'.encode() for i in range(140)]\n  