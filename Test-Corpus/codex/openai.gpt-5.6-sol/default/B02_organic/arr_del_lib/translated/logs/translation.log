 p=None; trace=[]\n    for add,minimum in [(0,0),(1,0),(3,0),(0,20),(25,2),(0,8),(300,0)]:\n        old_len=0 if not p else hdr(p).length\n        p=lib.stbds_arrgrowf(p,3,add,minimum); h=hdr(p)\n        # C callers update length after growth; initialize those bytes deterministically.\n        new_len=max(old_len,old_len+add)\n        if new_len<=h.capacity:\n            h.length=new_len\n            for i in range(old_len*3,new_len*3): ctypes.c_ubyte.from_address(p+i).value=(i*37)&255\n        trace.append((add,minimum,h.length,h.capacity,bytes((ctypes.c_ubyte*(h.length*3)).from_address(p))))\n    lib.stbds_arrfreef(p)\n    return trace\n\ndef arena(lib):\n    a=Arena(); trace=[]\n    values=[b'a',b'b'*500,b'c'*20,b'd'*700,b'e'*1048577,b'f'*30,b'g'*2000]\n    for value in values:\n        got=lib.stbds_stralloc(ctypes.byref(a),value)\n        trace.append((len(value),got.decode(),a.remaining,a.block,a.mode))\n    lib.stbds_strreset(ctypes.byref(a)); trace.append(('reset',a.storage,a.remaining,a.block,a.mode))\n    return trace\n\nlib=ctypes.CDLL(os.path.abspath(sys.argv[1]), mode=os.RTLD_LOCAL); configure(lib)\nresult={'arrays':arrays(lib),'binary':binary(lib),'strings1':strings(lib,1),'strings2':strings(lib,2),'strings3':strings(lib,3),'defaults':defaults(lib),'arena':arena(lib)}\n# bytes become lists through a simple normalization.\ndef norm(x):\n    if isinstance(x,bytes): return list(x)\n    if isinstance(x,tuple): return [norm(v) for v in x]\n    if isinstance(x,list): return [norm(v) for v in x]\n    if isinstance(x,dict): return {k:norm(v) for k,v in x.items()}\n    return x\nprint(json.dumps(norm(result),sort_keys=True,separators=(',',':')))\nPY\npython3 /tmp/harvest-ALCCGb-reference/differential.py /tmp/harvest-ALCCGb-reference/libreference.so > /tmp/harvest-ALCCGb-reference/c.json\npython3 /tmp/harvest-ALCCGb-reference/differential.py target/release/libtranslation.so > /tmp/harvest-ALCCGb-reference/rust.json\nls -l /tmp/harvest-ALCCGb-reference/c.json /tm