{\n   588\t  void *raw_a = STBDS_HASH_TO_ARR(a,elemsize);\n   589\t  stbds_hash_index *table = stbds_hash_table(raw_a);\n   590\t  size_t hash = mode >= STBDS_HM_STRING ? stbds_hash_string((char*)key,table->seed) : stbds_hash_bytes(key, keysize,table->seed);\n   591\t  size_t step = STBDS_BUCKET_LENGTH;\n   592\t  size_t limit,i;\n   593\t  size_t pos;\n   594\t  stbds_hash_bucket *bucket;\n   595\t\n   596\t  if (hash < 2) hash += 2;\n   597\t\n   598\t  pos = stbds_probe_position(hash, table->slot_count, table->slot_count_log2);\n   599\t\n   600\t  for (;;) {\n   601\t    STBDS_STATS(++stbds_hash_probes);\n   602\t    bucket = &table->storage[pos >> STBDS_BUCKET_SHIFT];\n   603\t\n   604\t    for (i=pos & STBDS_BUCKET_MASK; i < STBDS_BUCKET_LENGTH; ++i) {\n   605\t      if (bucket->hash[i] == hash) {\n   606\t        if (stbds_is_key_equal(a, elemsize, key, keysize, keyoffset, mode, bucket->index[i])) {\n   607\t          return (pos & ~STBDS_BUCKET_MASK)+i;\n   608\t        }\n   609\t      } else if (bucket->hash[i] == STBDS_HASH_EMPTY) {\n   610\t        return -1;\n   611\t      }\n   612\t    }\n   613\t\n   614\t    limit = pos & STBDS_BUCKET_MASK;\n   615\t    for (i = 0; i < limit; ++i) {\n   616\t      if (bucket->hash[i] == hash) {\n   617\t        if (stbds_is_key_equal(a, elemsize, key, keysize, keyoffset, mode, bucket->index[i])) {\n   618\t          return (pos & ~STBDS_BUCKET_MASK)+i;\n   619\t        }\n   620\t      } else if (bucket->hash[i] == STBDS_HASH_EMPTY) {\n   621\t        return -1;\n   622\t      }\n   623\t    }\n   624\t\n   625\t    pos += step;\n   626\t    step += STBDS_BUCKET_LENGTH;\n   627\t    pos &= (table->slot_count-1);\n   628\t  }\n   629\t}\n   630\t\n   631\tvoid * stbds_hmget_key_ts(void *a, size_t elemsize, void *key, size_t keysize, ptrdiff_t *temp, int mode)\n   632\t{\n   633\t  size_t keyoffset = 0;\n   634\t  if (a == NULL) {\n   635\t    a = stbds_arrgrowf(0, elemsize, 0, 1);\n   636\t    stbds_header(a)->length