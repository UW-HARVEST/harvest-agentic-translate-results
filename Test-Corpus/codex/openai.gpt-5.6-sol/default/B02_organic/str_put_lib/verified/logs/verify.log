th += 1;\n   690\t    a = STBDS_ARR_TO_HASH(a,elemsize);\n   691\t  }\n   692\t\n   693\t  raw_a = a;\n   694\t  a = STBDS_HASH_TO_ARR(a,elemsize);\n   695\t\n   696\t  table = (stbds_hash_index *) stbds_header(a)->hash_table;\n   697\t\n   698\t  if (table == NULL || table->used_count >= table->used_count_threshold) {\n   699\t    stbds_hash_index *nt;\n   700\t    size_t slot_count;\n   701\t\n   702\t    slot_count = (table == NULL) ? STBDS_BUCKET_LENGTH : table->slot_count*2;\n   703\t    nt = stbds_make_hash_index(slot_count, table);\n   704\t    if (table)\n   705\t      STBDS_FREE(NULL, table);\n   706\t    else\n   707\t      nt->string.mode = mode >= STBDS_HM_STRING ? STBDS_SH_DEFAULT : 0;\n   708\t    stbds_header(a)->hash_table = table = nt;\n   709\t    STBDS_STATS(++stbds_hash_grow);\n   710\t  }\n   711\t\n   712\t  {\n   713\t    size_t hash = mode >= STBDS_HM_STRING ? stbds_hash_string((char*)key,table->seed) : stbds_hash_bytes(key, keysize,table->seed);\n   714\t    size_t step = STBDS_BUCKET_LENGTH;\n   715\t    size_t pos;\n   716\t    ptrdiff_t tombstone = -1;\n   717\t    stbds_hash_bucket *bucket;\n   718\t\n   719\t    if (hash < 2) hash += 2;\n   720\t\n   721\t    pos = stbds_probe_position(hash, table->slot_count, table->slot_count_log2);\n   722\t\n   723\t    for (;;) {\n   724\t      size_t limit, i;\n   725\t      STBDS_STATS(++stbds_hash_probes);\n   726\t      bucket = &table->storage[pos >> STBDS_BUCKET_SHIFT];\n   727\t\n   728\t      for (i=pos & STBDS_BUCKET_MASK; i < STBDS_BUCKET_LENGTH; ++i) {\n   729\t        if (bucket->hash[i] == hash) {\n   730\t          if (stbds_is_key_equal(raw_a, elemsize, key, keysize, keyoffset, mode, bucket->index[i])) {\n   731\t            stbds_temp(a) = bucket->index[i];\n   732\t            if (mode >= STBDS_HM_STRING)\n   733\t              stbds_temp_key(a) = * (char **) ((char *) raw_a + elemsize*bucket->index[i] + keyoffset);\n   734\t            return STBDS_ARR_TO_HASH(a,elemsize);\n   735\t          }\n   736\t        } else if (bucket->hash[i] == 0) {\n   737\t          pos = (pos & ~STBDS_BUCKET_MASK) + i;\n   738\t          goto found_empty_slot;\n   739\t        } else if (tombstone < 0) {\n   740\t          if (bucket->index[i] == STBDS_INDEX_DELETED)\n   741\t            tombstone = (ptrdiff_t) ((pos & ~STBDS_BUCKET_MASK) + i);\n   742\t        }\n   743\t      }\n   744\t\n   745\t      limit = pos & STBDS_BUCKET_MASK;\n   746\t      for (i = 0; i < limit; ++i) {\n   747\t        if (bucket->hash[i] == hash) {\n   748\t          if (stbds_is_key_equal(raw_a, elemsize, key, keysize, keyoffset, mode, bucket->index[i])) {\n   749\t            stbds_temp(a) = bucket->index[i];\n   750\t            return STBDS_ARR_TO_HASH(a,elemsize);\n   751\t          }\n   752\t        } else if (bucket->hash[i] == 0) {\n   753\t          pos = (pos & ~STBDS_BUCKET_MASK) + i;\n   754\t          goto found_empty_slot;\n   755\t        } else if (tombstone < 0) {\n   756\t          if (bucket->index[i] == STBDS_INDEX_DELETED)\n   757\t            tombstone = (ptrdiff_t) ((pos & ~STBDS_BUCKET_MASK) + i);\n   758\t        }\n   759\t      }\n   760\t\n   761\t      pos += step;\n   762\t      step += STBDS_BUCKET_LENGTH;\n   763\t      pos &= (table->slot_count-1);\n   764\t    }\n   765\t   found_empty_slot:\n   766\t    if (tombstone >= 0) {\n   767\t      pos = tombstone;\n   768\t      --table->tombstone_count;\n   769\t    }\n   770\t    ++table->used_count;\n   771\t\n   772\t    {\n   773\t      ptrdiff_t i = (ptrdiff_t) stbds_arrlen(a);\n   774\t      if ((size_t) i+1 > stbds_arrcap(a))\n   775\t        *(void **) &a = stbds_arrgrowf(a, elemsize, 1, 0);\n   776\t      raw_a = STBDS_ARR_TO_HASH(a,elemsize);\n   777\t\n   778\t      STBDS_ASSERT((size_t) i+1 <= stbds_arrcap(a));\n   779\t      stbds_header(a)->length = i+1;\n   780\t      bucket = &table->storage[pos >> STBDS_BUCKET_SHIFT];\n   781\t      bucket->hash[pos & STBDS_BUCKET_MASK] = hash;\n   782