t            } else if (*bucket).hash[i] == HASH_EMPTY {\n   460\t                return -1;\n   461\t            }\n   462\t        }\n   463\t\n   464\t        for i in 0..(pos & BUCKET_MASK) {\n   465\t            if (*bucket).hash[i] == hash {\n   466\t                if is_key_equal(\n   467\t                    a,\n   468\t                    elemsize,\n   469\t                    key,\n   470\t                    keysize,\n   471\t                    keyoffset,\n   472\t                    mode,\n   473\t                    (*bucket).index[i] as usize,\n   474\t                ) {\n   475\t                    return ((pos & !BUCKET_MASK) + i) as isize;\n   476\t                }\n   477\t            } else if (*bucket).hash[i] == HASH_EMPTY {\n   478\t                return -1;\n   479\t            }\n   480\t        }\n   481\t\n   482\t        pos = pos.wrapping_add(step);\n   483\t        step = step.wrapping_add(BUCKET_LENGTH);\n   484\t        pos &= (*table).slot_count - 1;\n   485\t    }\n   486\t}\n   487\t\n   488\t#[unsafe(no_mangle)]\n   489\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n   490\t    if a.is_null() {\n   491\t        return;\n   492\t    }\n   493\t    let table = hash_table(a);\n   494\t    if !table.is_null() {\n   495\t        if (*table).string.mode == SH_STRDUP {\n   496\t            for i in 1..(*header(a)).length {\n   497\t                let key = *((a as *mut u8).add(elemsize.wrapping_mul(i)) as *mut *mut c_void);\n   498\t                free(key);\n   499\t            }\n   500\t        }\n   501\t        stbds_strreset(ptr::addr_of_mut!((*table).string));\n   502\t    }\n   503\t    free((*header(a)).hash_table);\n   504\t    free(header(a) as *mut c_void);\n   505\t}\n   506\t\n   507\t#[unsafe(no_mangle)]\n   508\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n   509\t    mut a: *mut c_void,\n   510\t    elemsize: usize,\n   511\t    key: *mut c_void,\n   512\t    keysize: usize,\n 