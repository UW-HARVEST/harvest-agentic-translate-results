   equal('switch_fallthrough_calculator', (rng.randint(-2**31, 2**31 - 1), rng.randint(-100, 100)))\n\nfor count in range(0, 65):\n    values = [rng.randint(-2**31, 2**31 - 1) for _ in range(max(count, 1))]\n    array = (ctypes.c_int * len(values))(*values)\n    equal('foreach_sum', (array, count))\n    end = ctypes.cast(ctypes.byref(array, (max(count, 1) - 1) * ctypes.sizeof(ctypes.c_int)), ctypes.POINTER(ctypes.c_int))\n    equal('process_array_reverse', (end, count))\nnull_int = ctypes.POINTER(ctypes.c_int)()\nfor count in (-2147483648, -100, -1, 0):\n    equal('foreach_sum', (null_int, count))\n    equal('process_array_reverse', (null_int, count))\n\nmultipliers = edge_doubles + [-1000.25, -1.5, 1.5, 1000.25]\nfor size in list(range(-32, 257)) + [512, 1000, 4096]:\n    for multiplier in multipliers:\n        equal('allocate_and_compute', (size, multiplier))\nfor _ in range(20000):\n    equal('allocate_and_compute', (rng.randint(-32, 512), rng.uniform(-1e100, 1e100)))\n\nfall_edges = ints + [-10, -9, -8, 8, 9, 10]\nfor _ in range(100000):\n    args = tuple(rng.choice(fall_edges) if rng.randrange(4) == 0 else rng.randint(-2**31, 2**31 - 1) for _ in range(4))\n    equal('fallcalc', args)\nfor p1 in (-2147483648, -1, 0, 1, 2147483647):\n    for p2 in (-2147483648, -1, 0, 1, 2147483647):\n        for p3 in (-2147483648, -129, -128, -1, 0, 1, 127, 128, 129, 2147483647):\n            for p4 in (-2147483648, -11, -10, -9, -1, 0, 1, 9, 10, 11, 2147483647):\n                equal('fallcalc', (p1, p2, p3, p4))\n\nprint('differential checks passed: 100013 conversions, 100270 switches, 134 array calls, 21853 allocations, 102750 fallcalc calls')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
