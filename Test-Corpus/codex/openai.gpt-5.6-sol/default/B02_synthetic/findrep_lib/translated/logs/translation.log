{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport os\nfrom pathlib import Path\n\nroot = Path.cwd().parent\nc_path = root / \\\".reference_build/libreference.so\\\"\nr_path = Path.cwd() / \\\"target/release/libfindrep.so\\\"\nmode = os.RTLD_LOCAL | os.RTLD_NOW\nc = ctypes.CDLL(str(c_path), mode=mode)\nr = ctypes.CDLL(str(r_path), mode=mode)\n\nbinary = [\n    \\\"add_to_accumulator\\\",\n    \\\"multiply_with_multiplier\\\",\n    \\\"subtract_from_accumulator\\\",\n    \\\"divide_multiplier\\\",\n]\nfor lib in (c, r):\n    for name in binary:\n        fn = getattr(lib, name)\n        fn.argtypes = [ctypes.c_int, ctypes.c_int]\n        fn.restype = ctypes.c_int\n    lib.validate_and_normalize.argtypes = [ctypes.c_int]\n    lib.validate_and_normalize.restype = ctypes.c_int\n    lib.process_octal_string.argtypes = [ctypes.c_void_p, ctypes.c_int]\n    lib.process_octal_string.restype = None\n    lib.find_and_replace_char.argtypes = [ctypes.c_void_p, ctypes.c_int]\n    lib.find_and_replace_char.restype = None\n    lib.findrep.argtypes = [ctypes.c_int] * 4\n    lib.findrep.restype = ctypes.c_int\n\nnormal_values = list(range(-1024, 1025)) + [-(2**31), 2**31 - 1]\nfor value in normal_values:\n    cv = c.validate_and_normalize(value)\n    rv = r.validate_and_normalize(value)\n    assert cv == rv, (\\\"validate_and_normalize\\\", value, cv, rv)\n\nformat_values = [-(2**31), -513, -1, 0, 1, 63, 64, 83, 511, 512, 2**31 - 1]\nfor value in format_values:\n    cb = ctypes.create_string_buffer(100)\n    rb = ctypes.create_string_buffer(100)\n    c.process_octal_string(cb, value)\n    r.process_octal_string(rb, value)\n    assert cb.raw == rb.raw, (\\\"process_octal_string\\\", value, cb.value, rb.value)\n\nreplace_cases = [\n    (b\\\"\\\", ord(\\\"x\\\")),\n    (b\\\"abcabc\\\", ord(\\\"a\\\")),\n    (b\\\"abcabc\\\", ord(\\\"c\\\")),\n    (b\\\"abcabc\\\", ord(\\\"z\\\")),\n    (b\\\"\\\\xff