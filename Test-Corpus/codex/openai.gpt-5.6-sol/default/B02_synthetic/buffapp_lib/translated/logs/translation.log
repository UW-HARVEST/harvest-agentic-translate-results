ity = required_capacity * 2;\r\n    59\t        char *new_data = (char*)realloc(buffer->data, new_capacity);\r\n    60\t\r\n    61\t        if (!new_data) {\r\n    62\t            return -1;\r\n    63\t        }\r\n    64\t\r\n    65\t        buffer->data = new_data;\r\n    66\t        buffer->capacity = new_capacity;\r\n    67\t    }\r\n    68\t\r\n    69\t    strcpy(buffer->data + buffer->length, str);\r\n    70\t    buffer->length += str_len;\r\n    71\t\r\n    72\t    return 0;\r\n    73\t}\r\n    74\t\r\n    75\tvoid destroy_buffer(StringBuffer *buffer) {\r\n    76\t    if (buffer) {\r\n    77\t        if (buffer->data) {\r\n    78\t            free(buffer->data);\r\n    79\t        }\r\n    80\t        free(buffer);\r\n    81\t    }\r\n    82\t}\r\n    83\t\r\n    84\tconst char* get_operation_name(int op_code) {\r\n    85\t    switch (op_code) {\r\n    86\t        case 0: return \"add\";\r\n    87\t        case 1: return \"subtract\";\r\n    88\t        case 2: return \"multiply\";\r\n    89\t        case 3: return \"divide\";\r\n    90\t        default: return \"unknown\";\r\n    91\t    }\r\n    92\t}\r\n    93\t\r\n    94\tint perform_operation(int a, int b, const char *operation) {\r\n    95\t    if (strcmp(operation, \"add\") == 0) {\r\n    96\t        return a + b;\r\n    97\t    } else if (strcmp(operation, \"subtract\") == 0) {\r\n    98\t        return a - b;\r\n    99\t    } else if (strcmp(operation, \"multiply\") == 0) {\r\n   100\t        return a * b;\r\n   101\t    } else if (strcmp(operation, \"divide\") == 0) {\r\n   102\t        if (b != 0) {\r\n   103\t            return a / b;\r\n   104\t        }\r\n   105\t        return 0;\r\n   106\t    }\r\n   107\t    return 0;\r\n   108\t}\r\n   109\t\r\n   110\t// TODO: lib test stdout\r\n   111\tint buffapp(int param1, int param2, int param3, int param4) {\r\n   112\t    StringBuffer *log_buffer = create_buffer(32);\r\n   113\t    int result = 0;\r\n   114\t    char temp[64];\r\n   115\t\r\n   116\t    log_buffer->length = 0;\r\n   117\t\r\n   118\t    sprintf(temp, \"Starting computation with %d parameters\\n\", 4);\r\n   119\t    append_to_buffer(log_buffer, temp);\r\n   120\t\r\n   121\t    const char *op1 = get_operation_name(param1 % 4);\r\n   122\t    sprintf(temp, \"Operation 1: %s(%d, %d)\\n\", op1, param1, param2);\r\n   123\t    append_to_buffer(log_buffer, temp);\r\n   124\t\r\n   125\t    int intermediate1 = perform_operation(param1, param2, op1);\r\n   126\t    result += intermediate1;\r\n   127\t\r\n   128\t    const char *op2 = get_operation_name(param3 % 4);\r\n   129\t    sprintf(temp, \"Operation 2: %s(%d, %d)\\n\", op2, param3, param4);\r\n   130\t    append_to_buffer(log_buffer, temp);\r\n   131\t\r\n   132\t    int intermediate2 = perform_operation(param3, param4, op2);\r\n   133\t    result += intermediate2;\r\n   134\t\r\n   135\t    const char *op3 = \"multiply\";\r\n   136\t    sprintf(temp, \"Operation 3: %s(%d, %d)\\n\", op3, intermediate1, intermediate2);\r\n   137\t    append_to_buffer(log_buffer, temp);\r\n   138\t\r\n   139\t    int intermediate3 = perform_operation(intermediate1, intermediate2, op3);\r\n   140\t\r\n   141\t    if (intermediate3 != 0) {\r\n   142\t        result = result / intermediate3;\r\n   143\t    } else {\r\n   144\t        result = param1 + param2 + param3 + param4;\r\n   145\t    }\r\n   146\t\r\n   147\t    sprintf(temp, \"Final result: %d\\n\", result);\r\n   148\t    append_to_buffer(log_buffer, temp);\r\n   149\t\r\n   150\t    printf(\"Computation Log:\\n%s\\n\", log_buffer->data);\r\n   151\t\r\n   152\t    destroy_buffer(log_buffer);\r\n   153\t\r\n   154\t    return result;\r\n   155\t}\r\n","exit_code":0,"status":"completed"}}
