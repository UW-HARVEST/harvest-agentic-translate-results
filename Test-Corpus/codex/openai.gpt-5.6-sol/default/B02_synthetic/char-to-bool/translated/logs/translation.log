t * Main entrance function - processes boolean decisions\n    38\t * \n    39\t * @param decision_string String of 'y'/'n' characters representing decisions\n    40\t * @param length Length of decision string\n    41\t * @param operation Operation to perform:\n    42\t *                  0: apply permissions (uses first 3 decisions)\n    43\t *                  1: evaluate conditions with logic (uses first 3 decisions)\n    44\t *                  2: configure flags (uses all decisions)\n    45\t *                  3: validate sequence (checks pattern)\n    46\t * @param param Operation-specific parameter (logic operator, mode, etc)\n    47\t * @return Operation result or error code\n    48\t */\n    49\tint process_decisions(char *decision_string, size_t length, \n    50\t                     int operation, int param) {\n    51\t    \n    52\t    if (decision_string == NULL || length == 0) {\n    53\t        return -1;\n    54\t    }\n    55\t    \n    56\t    switch (operation) {\n    57\t        case 0: {\n    58\t            /* Apply permissions: read, write, execute */\n    59\t            if (length < 3) return -2;\n    60\t            \n    61\t            bool read = parse_bool(decision_string[0]);\n    62\t            bool write = parse_bool(decision_string[1]);\n    63\t            bool execute = parse_bool(decision_string[2]);\n    64\t            \n    65\t            return apply_permissions(read, write, execute);\n    66\t        }\n    67\t        \n    68\t        case 1: {\n    69\t            /* Evaluate logical conditions */\n    70\t            if (length < 3) return -2;\n    71\t            \n    72\t            bool cond1 = parse_bool(decision_string[0]);\n    73\t            bool cond2 = parse_bool(decision_string[1]);\n    74\t            bool cond3 = parse_bool(decision_string[2]);\n    75\t            \n    76\t            /* param determines logic operation: 0=AND, 1=OR, 2=XOR, 3=NAND */\n    77\t            return evaluate_conditions(cond1, cond2, cond3, param);\n    78\t        }\n    79\t        \n    80\t        case 2: {\n    81\t            /* Configure flags from all decisions */\n    82\t            bool decisions[32];\n    83\t            size_t count = (length < 32) ? length : 32;\n    84\t            \n    85\t            for (size_t i = 0; i < count; i++) {\n    86\t                decisions[i] = parse_bool(decision_string[i]);\n    87\t            }\n    88\t            \n    89\t            return configure_flags(decisions, count);\n    90\t        }\n    91\t        \n    92\t        case 3: {\n    93\t            /* Validate decision sequence */\n    94\t            return validate_sequence(decision_string, length);\n    95\t        }\n    96\t        \n    97\t        default:\n    98\t            return -3;\n    99\t    }\n   100\t}\n   101\t\n   102\t/**\n   103\t * Parse character to boolean\n   104\t * 'y' or 'Y' -> true\n   105\t * 'n' or 'N' -> false\n   106\t * anything else -> false\n   107\t */\n   108\tstatic bool parse_bool(char c) {\n   109\t    if (c == 'y' || c == 'Y') {\n   110\t        return true;\n   111\t    } else if (c == 'n' || c == 'N') {\n   112\t        return false;\n   113\t    }\n   114\t    return false;  /* Default to false for invalid input */\n   115\t}\n   116\t\n   117\t/**\n   118\t * Apply permissions based on read/write/execute flags\n   119\t * Complex branching based on boolean combinations\n   120\t */\n   121\tstatic int apply_permissions(bool read, bool write, bool execute) {\n   122\t    int permission_value = 0;\n   123\t    \n   124\t    /* Base permission calculation */\n   125\t    if (read) {\n   126\t        permission_value += 4;\n   127\t    }\n   128\t    if (write) {\n   129\t        permission_value += 2;\n   130\t    }\n   131\t    if (execute) {\n   132\t        permission_value += 1;\n   133\t    }\n   134\t    \n   135\t    /* Complex decision tree based on combinations */\n   136\t    if (read && write && execute) {\n   137\t        /* Full permissions - special handling */\n   138\t        return 100 + permission_value;  /* 107 */\n   139\t    } else if (read && write) {\n   140\t        /* Read/write but no execute */\n   141\t        if (permission_value == 6) {\n   142\t            return 50 + permission_value;  /* 56 */\n   143\t        }\n   144\t    } else if (read && execute) {\n   145\t        /* Read/execute but no write */\n   146\t        return 30 + permission_value;  /* 35 */\n   147\t    } else if (write && execute) {\n   148\t        /* Write/execute but no read - unusual case */\n   149\t        return 20 + permission_value;  /* 23 */\n   150\t    } else if (read) {\n   151\t        /* Read only */\n   152\t        return 10 + permission_value;  /* 14 */\n   153\t    } else if (write) {\n   154\t        /* Write only - dangerous */\n   155\t        return -10;\n   156\t    } else if (execute) {\n   157\t        /* Execute only - very unusual */\n   158\t        return -20;\n   159\t    }\n   160\t    \n   161\t    /* No permissions */\n   162\t    return 0;\n   163\t}\n   164\t\n   165\t/**\n   166\t * Evaluate three conditions with different logic operators\n   167\t */\n   168\tstatic int evaluate_conditions(bool cond1, bool cond2, bool cond3, int logic_op) {\n   169\t    bool result;\n   170\t    \n   171\t    switch (logic_op) {\n   172\t        case 0: {\n   173\t            /* AND - all must be true */\n   174\t            result = cond1 && cond2 && cond3;\n   175\t            \n   176\t            if (result) {\n   177\t                return 100;\n   178\t            } else {\n   179\t                /* Partial matches */\n   180\t                if (cond1 && cond2) return 50;\n   181\t                if (cond1 && cond3) return 51;\n   182\t                if (cond2 && cond3) return 52;\n   183\t                if (cond1) return 10;\n   184\t                if (cond2) return 11;\n   185\t                if (cond3) return 12;\n   186\t                return 0;\n   187\t            }\n   188\t        }\n   189\t        \n   190\t        case 1: {\n   191\t            /* OR - at least one must be true */\n   192\t            result = cond1 || cond2 || cond3;\n   193\t            \n   194\t            if (result) {\n   195\t                /* Count how many are true */\n   196\t                int count = 0;\n   197\t                if (cond1) count++;\n   198\t                if (cond2) count++;\n   199\t                if (cond3) count++;\n   200\t                return 100 + count;\n   201\t            }\n   202\t            return 0;\n   203\t        }\n   204\t        \n   205\t        case 2: {\n   206\t            /* XOR - odd number must be true */\n   207\t            result = (cond1 ^ cond2 ^ cond3);\n   208\t            \n   209\t            if (result) {\n   210\t                /* Determine which combination */\n   211\t                if (cond1 && !cond2 && !cond3) return 1;\n   212\t                if (!cond1 && cond2 && !cond3) return 2;\n   213\t                if (!cond1 && !cond2 && cond3) return 3;\n   214\t                if (cond1 && cond2 && cond3) return 7;\n   215\t                return 90;\n   216\t            }\n   217\t            return 0;\n   218\t        }\n   219\t        \n   220\t        case 3: {\n   221\t            /* NAND - not all true */\n   222\t            result = !(cond1 && cond2 && cond3);\n   223\t            \n   224\t            if (result) {\n   225\t                /* Various false combinations */\n   226\t                if (!cond1 && !cond2 && !cond3) return 200;\n   227\t                if (!cond1) return 150;\n   228\t                if (!cond2) return 151;\n   229\t                if (!cond3) return 152;\n   230\t                return 100;\n   231\t            }\n   232\t            return 0;\n   233\t        }\n   234\t        \n   235\t        default:\n   236\t            return -1;\n   237\t    }\n   238\t}\n   239\t\n   240\t/**\n   241\t * Configure system flags based on array of decisions\n   242\t * Creates bitmask and applies various rules\n   243\t */\n   244\tstatic int configure_flags(bool *decisions, size_t count) {\n   245\t    uint32_t flags = 0;\n   246\t    int special_count = 0;\n   247\t    \n   248\t    /* Build flag bitmask */\n   249\t    for (size_t i = 0; i < count && i < 32; i++) {\n   250\t        if (decisions[i]) {\n   251\t            flags |= (1u << i);\n   252\t            special_count++;\n   253\t        }\n   254\t    }\n   255\t    \n   256\t    /* Apply rules based on flag patterns */\n   257\t    if (special_count == 0) {\n   258\t        /* All false */\n   259\t        return 0;\n   260\t    } else if (special_count == count) {\n   261\t        /* All true */\n   262\t        return 1000 + (int)count;\n   263\t    } else if (special_count == 1) {\n   264\t        /* Exactly one true - find which one */\n   265\t        for (size_t i = 0; i < count; i++) {\n   266\t            if (decisions[i]) {\n   267\t                return 100 + (int)i;\n   268\t            }\n   269\t        }\n   270\t    } else if (special_count == count - 1) {\n   271\t        /* Exactly one false - find which one */\n   272\t        for (size_t i = 0; i < count; i++) {\n   273\t            if (!decisions[i]) {\n   274\t                return 200 + (int)i;\n   275\t            }\n   276\t        }\n   277\t    }\n   278\t    \n   279\t    /* Check for alternating pattern */\n   280\t    bool alternating = true;\n   281\t    for (size_t i = 1; i < count; i++) {\n   282\t        if (decisions[i] == decisions[i-1]) {\n   283\t            alternating = false;\n   284\t            break;\n   285\t        }\n   286\t    }\n   287\t    \n   288\t    if (alternating) {\n   289\t        return 500 + special_count;\n   290\t    }\n   291\t    \n   292\t    /* Check for consecutive true values */\n   293\t    int max_consecutive = 0;\n   294\t    int current_consecutive = 0;\n   295\t    for (size_t i = 0; i < count; i++) {\n   296\t        if (decisions[i]) {\n   297\t            current_consecutive++;\n   298\t            if (current_consecutive > max_consecutive) {\n   299\t                max_consecutive = current_consecutive;\n   300\t            }\n   301\t        } else {\n   302\t            current_consecutive = 0;\n   303\t        }\n   304\t    }\n   305\t    \n   306\t    if (max_consecutive >= 3) {\n   307\t        return 300 + max_consecutive;\n   308\t    }\n   309\t    \n   310\t    /* Return count of true values */\n   311\t    return special_count;\n   312\t}\n   313\t\n   314\t/**\n   315\t * Validate sequence has proper pattern\n   316\t * Checks various decision sequence rules\n   317\t */\n   318\tstatic int validate_sequence(char *sequence, size_t len) {\n   319\t    if (len == 0) return 0;\n   320\t    \n   321\t    /* Convert all to bools */\n   322\t    bool *bools = (bool*)sequence;  /* Reuse buffer */\n   323\t    for (size_t i = 0; i < len; i++) {\n   324\t        bool val = parse_bool(sequence[i]);\n   325\t        bools[i] = val;\n   326\t    }\n   327\t    \n   328\t    /* Rule 1: Must start with 'y' */\n   329\t    if (!bools[0]) {\n   330\t        return -10;\n   331\t    }\n   332\t    \n   333\t    /* Rule 2: Must end with 'n' if length > 1 */\n   334\t    if (len > 1 && bools[len-1]) {\n   335\t        return -11;\n   336\t    }\n   337\t    \n   338\t    /* Rule 3: Cannot have more than 3 consecutive same values */\n   339\t    int consecutive = 1;\n   340\t    for (size_t i = 1; i < len; i++) {\n   341\t        if (bools[i] == bools[i-1]) {\n   342\t            consecutive++;\n   343\t            if (consecutive > 3) {\n   344\t                return -12;\n   345\t            }\n   346\t        } else {\n   347\t            consecutive = 1;\n   348\t        }\n   349\t    }\n   350\t    \n   351\t    /* Rule 4: Count transitions */\n   352\t    int transitions = 0;\n   353\t    for (size_t i = 1; i < len; i++) {\n   354\t        if (bools[i] != bools[i-1]) {\n   355\t            transitions++;\n   356\t        }\n   357\t    }\n   358\t    \n   359\t    /* Validate based on length */\n   360\t    if (len <= 3) {\n   361\t        /* Short sequences - simple rules */\n   362\t        if (transitions == 0) return 1;  /* All same (but passes other rules) */\n   363\t        if (transitions == len - 1) return 2;  /* All different */\n   364\t        return 10 + transitions;\n   365\t    } else if (len <= 10) {\n   366\t        /* Medium sequences */\n   367\t        if (transitions < len / 3) return 20;  /* Few transitions */\n   368\t        if (transitions > len / 2) return 30;  /* Many transitions */\n   369\t        return 25;\n   370\t    } else {\n   371\t        /* Long sequences */\n   372\t        if (transitions < 3) return 40;\n   373\t        if (transitions > len - 3) return 50;\n   374\t        return 45;\n   375\t    }\n   376\t}\n","exit_code":0,"status":"completed"}}
