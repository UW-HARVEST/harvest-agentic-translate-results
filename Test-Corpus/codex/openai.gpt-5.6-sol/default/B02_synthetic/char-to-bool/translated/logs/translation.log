{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport itertools\nimport random\nimport subprocess\nimport sys\n\nc_bin = \\\"/tmp/driver_c_Kr3dXI\\\"\nr_bin = \\\"./target/release/driver\\\"\ntested = 0\n\ndef run(binary, data):\n    result = subprocess.run([binary], input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n    return result.returncode, result.stdout, result.stderr\n\ndef check(data, label):\n    global tested\n    c_result = run(c_bin, data)\n    r_result = run(r_bin, data)\n    tested += 1\n    if c_result \"'!= r_result:\n        print(f\"MISMATCH after {tested} cases: {label}\")\n        print(f\"input={data!r}\")\n        print(f\"C={c_result!r}\")\n        print(f\"Rust={r_result!r}\")\n        sys.exit(1)\n\n# Missing-input and partial-input paths.\nfor data in [b\"\", b\"0\", b\"0'\"\\\\n\\\", b\\\"0\\\\n1\\\", b\\\"0\\\\n1\\\\n\\\"]:\n    check(data, \\\"EOF handling\\\")\n\n# Mixed decision characters across all operations for short strings.\nalphabet = b\\\"ynYNx\\\"\nfor length in range(5):\n    for values in itertools.product(alphabet, repeat=length):\n        decision = bytes(values)\n        for operation in [-1, 0, 2, 3, 4]:\n            check(f\\\"{operation}\\\\n0\\\\n\\\".encode() + decision + b\\\"\\\\n\\\", \\\"mixed short decision\\\")\n        for param in [-2, -1, 0, 1, 2, 3, 4, 5]:\n            check(f\\\"1\\\\n{param}\\\\n\\\".encode() + decision + b\\\"\\\\n\\\", \\\"logic operation\\\")\n\n# Exhaustive boolean sequences through length 12 for operations using all bytes.\nfor length in range(13):\n    for values in itertools.product(b\\\"yn\\\", repeat=length):\n        decision = bytes(values)\n        for operation in [2, 3]:\n            check(f\\\"{operation}\\\\n0\\\\n\\\".encode() + decision + b\\\"\\\\n\\\", \\\"exhaustive boolean sequence\\\")\n\n# atoi syntax, 32-bit wrapping, and 64-bit strtol saturation behavior.\ninteger_fields = [\n    b\\\"0\\\", b\\\"+1\\\", b\\\"  2junk\\\", b\\\"\\\\t-3x\\\", b\\\"2147483647\\\", b\\\"2147483648\\\",\n    b\\\"-2147483649\\\", b\\\"9223372036854775807\\\", b\\\"9223372036854775808\\\",\n    b\\\"-9223372036854775808\\\", b\\\"-9223372036854775809\\\", b\\\"999999999999999999999999999\\\",\n    b\\\"-999999999999999999999999999\\\", b\\\"+\\\", b\\\"-\\\", b\\\"words\\\", b\\\"\\\\x00ignored\\\",\n]\nfor operation in integer_fields:\n    for param in integer_fields:\n        check(operation + b\\\"\\\\n\\\" + param + b\\\"\\\\nyNn\\\\n\\\", \\\"atoi compatibility\\\")\n\n# Hand-selected raw streams for fgets/NUL/newline boundaries.\nraw_cases = [\n    b\\\"0\\\\r\\\\n0\\\\r\\\\nyyn\\\\r\\\\n\\\",\n    b\\\"0\\\\x00junk\\\\n0\\\\x00junk\\\\nyyn\\\\x00ignored\\\\n\\\",\n    b\\\"0\\\\n0\\\\nyyn\\\\ntrailing data\\\",\n    b\\\"0\\\\n0\\\\nyyn\\\",\n    b\\\"0\\\\n0\\\\n\\\\x00yyn\\\\n\\\",\n    b\\\"0\\\\n0\\\\ny\\\\r\\\\n\\\",\n    b\\\"0\\\\n0\\\\n\\\" + b\\\"y\\\" * 1022 + b\\\"\\\\n\\\",\n    b\\\"3\\\\n0\\\\n\\\" + b\\\"yn\\\" * 511 + b\\\"y\\\\n\\\",\n    b\\\"2\\\\n0\\\\n\\\" + b\\\"y\\\" * 1023 + b\\\"n\\\\n\\\",\n    b\\\"0\\\" * 1023 + b\\\"\\\\n0\\\\nyyn\\\\n\\\",\n    b\\\"0\\\" * 1024 + b\\\"\\\\n0\\\\nyyn\\\\n\\\",\n    b\\\"2\\\\n\\\" + b\\\"0\\\" * 1023 + b\\\"\\\\nyyn\\\\n\\\",\n]\nfor index, data in enumerate(raw_cases):\n    check(data, f\\\"raw boundary case {index}\\\")\n\n# Deterministic arbitrary-byte decision data, including embedded NUL and LF.\nrng = random.Random(20260827)\nfor index in range(300):\n    operation = rng.choice([-20, 0, 1, 2, 3, 20])\n    param = rng.randint(-10, 10)\n    length = rng.choice([0, 1, 2, 3, 4, 10, 31, 32, 33, 100, 1022, 1023])\n    decision = bytes(rng.randrange(256) for _ in range(length))\n    check(f\\\"{operation}\\\\n{param}\\\\n\\\".encode() + decision, f\\\"random byte case {index}\\\")\n\nprint(f\\\"PASS: {tested} differential cases matched return code, stdout, and stderr\\\")\nPY\"","aggregated_output"