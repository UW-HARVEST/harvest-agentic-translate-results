 *vm);\n    58\t\n    59\tint run_engine(int impl_id, const int *code, size_t n, VM *vm);\n    60\t\n    61\t#endif\n     1\tuse std::env;\n     2\tuse std::io::{self, Read, Write};\n     3\tuse std::os::unix::ffi::OsStrExt;\n     4\tuse std::process::ExitCode;\n     5\t\n     6\t#[derive(Default)]\n     7\tstruct Vm {\n     8\t    stack: Vec<i32>,\n     9\t    trace: Vec<i32>,\n    10\t    steps: i32,\n    11\t}\n    12\t\n    13\timpl Vm {\n    14\t    fn pop(&mut self) -> Option<i32> {\n    15\t        self.stack.pop()\n    16\t    }\n    17\t\n    18\t    fn peek(&self, default: i32) -> i32 {\n    19\t        self.stack.last().copied().unwrap_or(default)\n    20\t    }\n    21\t\n    22\t    fn mark(&mut self, value: i32) {\n    23\t        self.trace.push(value);\n    24\t    }\n    25\t}\n    26\t\n    27\t#[derive(Default)]\n    28\tstruct Runtime {\n    29\t    state_a: i32,\n    30\t    flipflop: i32,\n    31\t}\n    32\t\n    33\tfn target_external(code: i32) -> i32 {\n    34\t    if code < 0 {\n    35\t        return 7;\n    36\t    }\n    37\t    let m = code % 10;\n    38\t    if m == 0 {\n    39\t        0\n    40\t    } else if m <= 3 {\n    41\t        1\n    42\t    } else if m <= 6 {\n    43\t        2\n    44\t    } else if m == 7 {\n    45\t        3\n    46\t    } else {\n    47\t        4\n    48\t    }\n    49\t}\n    50\t\n    51\tfn target_a(code: i32, runtime: &mut Runtime) -> i32 {\n    52\t    if code < 0 {\n    53\t        return if runtime.state_a & 1 != 0 { 6 } else { 5 };\n    54\t    }\n    55\t    runtime.state_a ^= code.wrapping_shl(1);\n    56\t    match ((code >> 2) ^ runtime.state_a) & 7 {\n    57\t        0 => 0,\n    58\t        1 => 2,\n    59\t        2 => 4,\n    60\t        3 => 1,\n    61\t        4 => 3,\n    62\t        5 | 6 => 5,\n    63\t        _ => 7,\n    64\t    }\n    65\t}\n    66\t\n    67\tfn call_a_once(x: i32, runtime: &mut Runtime) -> i32 {\n    68\t    let a = target_a(x, runtime);\n    69\t    let b = ta