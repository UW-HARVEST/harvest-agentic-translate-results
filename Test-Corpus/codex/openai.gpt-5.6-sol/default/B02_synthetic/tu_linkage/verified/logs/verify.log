ase 1: return 2;\n    39\t        case 2: return 4;\n    40\t        case 3: return 1;\n    41\t        case 4: return 3;\n    42\t        case 5:;\n    43\t        case 6: return 5;\n    44\t        default: return 7;\n    45\t    }\n    46\t}\n    47\t\n    48\tstatic inline int wrap(int x){ return target(x-5); }\n    49\t#define A_MAC_CALL(F, X) a_bias_call((F), (X)) \n    50\t\n    51\tint call_a_once(int x){\n    52\t    int (*fp)(int) = &target;\n    53\t    int a = fp(x);\n    54\t    int b = wrap(a);\n    55\t    int c = target(b ^ 3);\n    56\t    int d = A_MAC_CALL(&target, b);\n    57\t    return a ^ (b << 1) ^ (c << 2) ^ (d << 3);\n    58\t}\n    59\t\n    60\tint process_a_stream(const int *xs, size_t n){\n    61\t    size_t acc=0;\n    62\t    for(size_t i=0;i<n;i++){\n    63\t        int v=xs[i];\n    64\t        for(int j=0;j<3;j++){\n    65\t            int t=target(v+j);\n    66\t            if ((t&1)==0) { acc += t; continue; }\n    67\t            acc ^= (t<<j);\n    68\t            if (t==5) break;\n    69\t        }\n    70\t    }\n    71\t    if (acc > 0x7fffffffLL) acc = 0x7fffffffLL;\n    72\t    if (acc < -0x80000000LL) acc = -0x80000000LL;\n    73\t    return (int)acc;\n    74\t}\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    1