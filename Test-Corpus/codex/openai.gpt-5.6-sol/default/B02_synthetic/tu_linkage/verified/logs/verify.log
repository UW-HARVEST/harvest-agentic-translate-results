0\tfn run_engine(\n   181\t    implementation: i32,\n   182\t    code: &[i32],\n   183\t    vm: &mut Vm,\n   184\t    runtime: &mut Runtime,\n   185\t) -> i32 {\n   186\t    let mut ip = 0usize;\n   187\t    while ip < code.len() {\n   188\t        let op = code[ip];\n   189\t        ip += 1;\n   190\t        vm.steps = vm.steps.wrapping_add(1);\n   191\t\n   192\t        match op {\n   193\t            0 => {\n   194\t                if ip >= code.len() {\n   195\t                    return 1;\n   196\t                }\n   197\t                let immediate = code[ip];\n   198\t                ip += 1;\n   199\t                vm.stack.push(immediate);\n   200\t                vm.mark(0);\n   201\t            }\n   202\t            1 => {\n   203\t                let Some(b) = vm.pop() else {\n   204\t                    return 2;\n   205\t                };\n   206\t                let Some(a) = vm.pop() else {\n   207\t                    return 2;\n   208\t                };\n   209\t                vm.stack.push(a.wrapping_add(b));\n   210\t                vm.mark(1);\n   211\t            }\n   212\t            2 => {\n   213\t                let Some(b) = vm.pop() else {\n   214\t                    return 3;\n   215\t                };\n   216\t                let Some(a) = vm.pop() else {\n   217\t                    return 3;\n   218\t                };\n   219\t                vm.stack.push(a.wrapping_mul(b));\n   220\t                vm.mark(2);\n   221\t            }\n   222\t            3 => {\n   223\t                let value = vm.peek(0);\n   224\t                vm.stack.push(value);\n   225\t                vm.mark(3);\n   226\t            }\n   227\t            4 => {\n   228\t                if vm.pop().is_none() {\n   229\t                    return 4;\n   230\t                }\n   231\t                vm.mark(4);\n   232\t            }\n   233\t            5 => {\n   234\t                let x = vm.peek(0);\n   235\t                let bucket = classify(implementation, x, runtime);\n   236\t                vm.stack.push(bucket);\n   237\t                match bucket {\n   238\t                    0 => vm.mark(5),\n   239\t                    1 => vm.mark(6),\n   240\t                    2 => vm.mark(7),\n   241\t                    3 | 4 => vm.mark(8),\n   242\t                    _ => vm.mark(9),\n   243\t                }\n   244\t            }\n   245\t            6 => {\n   246\t                if ip >= code.len() {\n   247\t                    return 5;\n   248\t                }\n   249\t                let k = code[ip];\n   250\t                ip += 1;\n   251\t                let Some(condition) = vm.pop() else {\n   252\t                    return 6;\n   253\t                };\n   254\t                if condition != 0 {\n   255\t                    let jump = k as usize;\n   256\t                    if jump > code.len() - ip {\n   257\t                        return 7;\n   258\t                    }\n   259\t                    ip += jump;\n   260\t                    vm.mark(10);\n   261\t                } else {\n   262\t                    vm.mark(11);\n   263\t                }\n   264\t            }\n   265\t            7 => {\n   266\t                if ip >= code.len() {\n   267\t                    return 8;\n   268\t                }\n   269\t                let times = code[ip];\n   270\t                ip += 1;\n   271\t                if ip >= code.len() {\n   272\t                    return 9;\n   273\t                }\n   274\t                let saved_ip = ip;\n   275\t                if times > 0 {\n   276\t                    for _ in 0..times {\n   277\t                        let rc = run_engine(\n   278\t                            implementation,\n   279\t                            &code[saved_ip..saved_ip + 1],\n   280\t                            vm,\n   281\t                            runtime,\n   282\t                        );\n   283\t                        if rc != 0 {\n   284\t                            vm.mark(12);\n   285\t                            break;\n   286\t                        }\n   287\t                    }\n   288\t                }\n   289\t                ip = saved_ip + 1;\n   290\t            }\n   291\t            8 => {\n   292\t                let x = vm.peek(0);\n   293\t                let y = classify(implementation, x, runtime);\n   294\t                vm.stack.push(y);\n   295\t                vm.mark(13);\n   296\t            }\n   297\t            9 => {\n   298\t                if ip >= code.len() {\n   299\t                    return 10;\n   300\t                }\n   301\t                let m = code[ip];\n   302\t                ip += 1;\n   303\t                if m < 0 || m as usize > vm.stack.len() {\n   304\t                    return 11;\n   305\t                }\n   306\t                let mut temporary = vec![0i32; m as usize];\n   307\t                for i in (0..m as usize).rev() {\n   308\t                    if let Some(value) = vm.pop() {\n   309\t                        temporary[i] = value;\n   310\t                    }\n   311\t                }\n   312\t                for i in (0..m as usize).rev() {\n   313\t                    if let Some(value) = vm.pop() {\n   314\t                        temporary[i] = value;\n   315\t                    }\n   316\t                }\n   317\t                let result = process_stream(implementation, &temporary, runtime);\n   318\t                vm.stack.push(result);\n   319\t                vm.mark(14);\n   320\t            }\n   321\t            10 => return 0,\n   322\t            _ => return 99,\n   323\t        }\n   324\t    }\n   325\t    0\n   326\t}\n   327\t\n   328\tfn parse_c_long(token: &[u8]) -> Option<i32> {\n   329\t    let mut pos = 0usize;\n   330\t    while pos < token.len()\n   331\t        && matches!(token[pos], b' ' | b'\\t' | b'\\n' | b'\\r' | 0x0b | 0x0c)\n   332\t    {\n   333\t        pos += 1;\n   334\t    }\n   335\t\n   336\t    let mut negative = false;\n   337\t    if pos < token.len() && (token[pos] == b'+' || token[pos] == b'-') {\n   338\t        negative = token[pos] == b'-';\n   339\t        pos += 1;\n   340\t    }\n   341\t    let digits_start = pos;\n   342\t    let mut magnitude = 0u128;\n   343\t    while pos < token.len() && token[pos].is_ascii_digit() {\n   344\t        magnitude = magnitude\n   345\t            .saturating_mul(10)\n   346\t            .saturating_add((token[pos] - b'0') as u128);\n   347\t        pos += 1;\n   348\t    }\n   349\t\n   350\t    if pos == digits_start {\n   351\t        return if token.is_empty() { Some(0) } else { None };\n   352\t    }\n   353\t    if pos != token.len() {\n   354\t        return None;\n   355\t    }\n   356\t\n   357\t    let value = if negative {\n   358\t        const LONG_MIN_MAGNITUDE: u128 = 1u128 << 63;\n   359\t        if magnitude >= LONG_MIN_MAGNITUDE {\n   360\t            i64::MIN\n   361\t        } else {\n   362\t            -(magnitude as i64)\n   363\t        }\n   364\t    } else if magnitude > i64::MAX as u128 {\n   365\t        i64::MAX\n   366\t    } else {\n   367\t        magnitude as i64\n   368\t    };\n   369\t    Some(value as i32)\n   370\t}\n   371\t\n   372\tfn append_stdin_code(code: &mut Vec<i32>) {\n   373\t    let mut input = Vec::new();\n   374\t    let _ = io::stdin().read_to_end(&mut input);\n   375\t\n   376\t    let mut offset = 0usize;\n   377\t    while offset < input.len() {\n   378\t        let limit = (offset + 4095).min(input.len());\n   379\t        let end = input[offset..limit]\n   380\t            .iter()\n   381\t            .position(|&byte| byte == b'\\n')\n   382\t            .map_or(limit, |relative| offset + relative + 1);\n   383\t        let chunk = &input[offset..end];\n   384\t        let visible_len = chunk.iter().position(|&byte| byte == 0).unwrap_or(chunk.len());\n   385\t\n   386\t        let mut pos = 0usize;\n   387\t        while pos < visible_len {\n   388\t            let token_end = chunk[pos..visible_len]\n   389\t                .iter()\n   390\t                .position(|&byte| matches!(byte, b' ' | b'\\t' | b'\\n' | b'\\r'))\n   391\t                .map_or(visible_len, |relative| pos + relative);\n   392\t            if token_end > pos {\n   393\t                if let Some(value) = parse_c_long(&chunk[pos..token_end]) {\n   394\t                    code.push(value);\n   395\t                }\n   396\t            }\n   397\t            pos = if token_end < visible_len {\n   398\t                token_end + 1\n   399\t            } else {\n   400\t                token_end\n   401\t            };\n   402\t        }\n   403\t        offset = end;\n   404\t    }\n   405\t}\n   406\t\n   407\tfn append_vm_output(output: &mut Vec<u8>, label: &[u8], vm: &Vm) {\n   408\t    output.extend_from_slice(label);\n   409\t    write!(\n   410\t        output,\n   411\t        \"STACK_TOP={} STEPS={} TRACE=\",\n   412\t        vm.peek(-777),\n   413\t        vm.steps\n   414\t    )\n   415\t    .unwrap();\n   416\t    let alphabet = b\"abcdefghijklmnopqrstuvwxyz\";\n   417\t    for &value in &vm.trace {\n   418\t        output.push(alphabet[(value & 25) as usize]);\n   419\t    }\n   420\t    output.push(b'\\n');\n   421\t}\n   422\t\n   423\tfn real_main() -> u8 {\n   424\t    let arguments: Vec<_> = env::args_os().collect();\n   425\t    let program_name = arguments\n   426\t        .first()\n   427\t        .map(|value| value.as_os_str().as_bytes())\n   428\t        .unwrap_or_default();\n   429\t    let mut code = Vec::new();\n   430\t    let mut use_stdin = false;\n   431\t    let mut stderr = io::stderr().lock();\n   432\t\n   433\t    for argument in arguments.iter().skip(1) {\n   434\t        let bytes = argument.as_os_str().as_bytes();\n   435\t        if bytes == b\"--help\" {\n   436\t            let _ = stderr.write_all(b\"Usage: \");\n   437\t            let _ = stderr.write_all(program_name);\n   438\t            let _ = stderr.write_all(\n   439\t                b\" [--stdin] [bytecodes...]\\nBytecodes are integers forming a small VM program.\\n\",\n   440\t            );\n   441\t            return 0;\n   442\t        } else if bytes == b\"--stdin\" {\n   443\t            use_stdin = true;\n   444\t        } else if let Some(value) = parse_c_long(bytes) {\n   445\t            code.push(value);\n   446\t        } else {\n   447\t            let _ = stderr.write_all(b\"skip '\");\n   448\t            let _ = stderr.write_all(bytes);\n   449\t            let _ = stderr.write_all(b\"'\\n\");\n   450\t        }\n   451\t    }\n   452\t\n   453\t    if use_stdin {\n   454\t        append_stdin_code(&mut code);\n   455\t    }\n   456\t    if code.is_empty() {\n   457\t        let _ = stderr.write_all(b\"no program\\n\");\n   458\t        return 2;\n   459\t    }\n   460\t    drop(stderr);\n   461\t\n   462\t    let mut runtime = Runtime::default();\n   463\t    let mut vm_a = Vm::default();\n   464\t    let mut vm_b = Vm::default();\n   465\t    let mut vm_external = Vm::default();\n   466\t    let rc_a = run_engine(0, &code, &mut vm_a, &mut runtime);\n   467\t    let rc_b = run_engine(1, &code, &mut vm_b, &mut runtime);\n   468\t    let rc_external = run_engine(2, &code, &mut vm_external, &mut runtime);\n   469\t\n   470\t    let mut output = Vec::new();\n   471\t    writeln!(\n   472\t        output,\n   473\t        \"RC:A={} B={} EXT={}\",\n   474\t        rc_a, rc_b, rc_external\n   475\t    )\n   476\t    .unwrap();\n   477\t    append_vm_output(&mut output, b\"A:\", &vm_a);\n   478\t    append_vm_output(&mut output, b\"B:\", &vm_b);\n   479\t    append_vm_output(&mut output, b\"EXT:\", &vm_external);\n   480\t    let _ = io::stdout().write_all(&output);\n   481\t    0\n   482\t}\n   483\t\n   484\tfn main() -> ExitCode {\n   485\t    ExitCode::from(real_main())\n   486\t}\n","exit_code":0,"status":"completed"}}
