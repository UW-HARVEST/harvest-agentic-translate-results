{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\nfrom pathlib import Path\n\nroot = Path.cwd()\nc_lib = ctypes.CDLL(str(root / \\\"reference/libc_reference.so\\\"), mode=ctypes.RTLD_LOCAL)\nr_lib = ctypes.CDLL(str(root / \\\"translation/target/release/libtranslation.so\\\"), mode=ctypes.RTLD_LOCAL)\nlibs = (c_lib, r_lib)\n\nI = ctypes.c_int\nP = ctypes.POINTER(I)\nCALLBACK = ctypes.CFUNCTYPE(I, I, I, I)\n\nclass Record(ctypes.Structure):\n    _fields_ = [\n        (\\\"id\\\", I),\n        (\\\"value\\\", I),\n        (\\\"timestamp\\\", ctypes.c_long),\n        (\\\"name\\\", ctypes.c_char * 32),\n    ]\n\nfor lib in libs:\n    lib.increment_counter.argtypes = [I, I]\n    lib.increment_counter.restype = None\n    lib.update_accumulator.argtypes = [I, I]\n    lib.update_accumulator.restype = None\n    lib.apply_operation.argtypes = [CALLBACK, I, I, I]\n    lib.apply_operation.restype = I\n    for name in (\\\"add_three\\\", \\\"multiply_add\\\", \\\"complex_calc\\\"):\n        getattr(lib, name).argtypes = [I, I, I]\n        getattr(lib, name).restype = I\n    lib.shift_array_data.argtypes = [P, I, I]\n    lib.shift_array_data.restype = None\n    lib.process_pointer_data.argtypes = [P, I]\n    lib.process_pointer_data.restype = I\n    lib.compute_with_dynamic_memory.argtypes = [I, I]\n    lib.compute_with_dynamic_memory.restype = I\n    lib.get_time_based_value.argtypes = [I]\n    lib.get_time_based_value.restype = I\n    lib.manipulate_records.argtypes = [ctypes.POINTER(Record), I, I]\n    lib.manipulate_records.restype = I\n    lib.hatch.argtypes = [I, I, I, I]\n    lib.hatch.restype = I\n\ndef compare(name, *args):\n    values = [getattr(lib, name)(*args) for lib in libs]\n    assert values[0] == values[1], (name, args, values)\n    return values[0]\n\n# Arithmetic exports, including machine-width boundary behavior.\ntriples = [\n    (0, 0, 0), (1, 2, 3), (-7, 11, -13),\n    (2**31 - 1, 1, 0), (-2**31, -1, 9), (46341, 46341, -17),\n]\nfor triple in triples:\n    compare(\\\"add_three\\\", *triple)\n    compare(\\\"multiply_add\\\", *triple)\n    compare(\\\"complex_calc\\\", *triple)\n\n@CALLBACK\ndef callback(a, b, c):\n    return a * 7 - b * 3 + c\n\nfor triple in triples[:3]:\n    compare(\\\"apply_operation\\\", callback, *triple)\n\n# Byte-for-byte array mutation, including all no-op branches.\nfor size, shift in [(8, 3), (8, 0), (8, 8), (8, -2), (1, 0)]:\n    arrays = [(I * size)(*range(10, 10 + size)) for _ in libs]\n    for lib, array in zip(libs, arrays):\n        lib.shift_array_data(array, size, shift)\n    assert bytes(arrays[0]) == bytes(arrays[1]), (size, shift, list(arrays[0]), list(arrays[1]))\n\n# Dynamic allocation and pointer reads.\nfor base, count in [(5, 0), (5, 1), (-9, 8), (1000, 64), (7, -1)]:\n    compare(\\\"compute_with_dynamic_memory\\\", base, count)\n\n# Time result is independent of wall-clock second for these calculations.\nfor seed in [0, 1, -1, 17, -29, 123456, -123456, 2**31 - 1, -2**31]:\n    compare(\\\"get_time_based_value\\\", seed)\n\n# Record layout and memmove behavior, with all bytes initialized identically.\ndef records(values):\n    array = (Record * len(values))()\n    for i, value in enumerate(values):\n        array[i].id = i + 100\n        array[i].value = value\n        array[i].timestamp = 1700000000 + i\n        array[i].name = f\\\"record-{i}\\\".encode()\n    return array\n\nfor passed_count, shift, values in [\n    (5, 2, [3, 7, 11, 13, 17]),\n    (5, 0, [3, 7, 11, 13, 17]),\n    (5, 5, [3, 7, 11, 13, 17]),\n    (3, -2, [3, 7, 11, 13, 17]),\n    (3, 4, [3, 7, 11, 13, 17]),\n]:\n    pair = [records(values), records(values)]\n    results = [lib.manipulate_records(array, passed_count, shift) for lib, array in zip(libs, pair)]\n    assert results[0] == results[1], (passed_count, shift, results)\n    assert bytes(pair[0]) == bytes(pair[1]), (passed_count, shift)\n\n# Synchronize and observe both hidden globals through dependent exports.\nfor lib in libs:\n    lib.increment_counter(5, 999)\ncompare(\\\"complex_calc\\\", 20, 3, 4)\nfor lib in libs:\n    lib.update_accumulator(7, 888)\nptr_values = [I(19), I(19)]\noutputs = [lib.process_pointer_data(ctypes.byref(value), -4) for lib, value in zip(libs, ptr_values)]\nassert outputs[0] == outputs[1], outputs\n\n# Stateful end-to-end calls; each pair starts from matching hidden state.\nhatch_inputs = [\n    (1, 2, 3, 4),\n    (-5, 7, -2, 11),\n    (100, -3, 29, -17),\n    (0, 0, 0, 0),\n]\nrng = random.Random(20260827)\nhatch_inputs.extend(tuple(rng.randint(-10000, 10000) for _ in range(4)) for _ in range(100))\nfor values in hatch_inputs:\n    compare(\\\"hatch\\\", *values)\n\nprint(f\\\"behavioral comparisons passed: 12 exports, {len(hatch_inputs)} stateful hatch calls\\\")\nprint(f\\\"DataRecord size={ctypes.sizeof(Record)}, alignment={ctypes.alignment(Record)}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
