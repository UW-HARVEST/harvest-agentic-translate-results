, -100 - i)\n    ca, ra = clone_arr(base), clone_arr(base)\n    c.init_result_array(ctypes.byref(ca), values, count)\n    r.init_result_array(ctypes.byref(ra), values, count)\n    assert_arr_equal(ca, ra, ('init_result_array', count))\n    init_cases += 1\n\ncompare_cases = 0\narr = ResultArray()\narr.count = 10\nfor i in range(10):\n    arr.data[i] = Result(i * 3, i / 7.0, 9 - i)\nfor i in range(-3, 13):\n    for j in range(-3, 13):\n        ca, ra = clone_arr(arr), clone_arr(arr)\n        cv = c.compare_results_in_array(ctypes.byref(ca), i, j)\n        rv = r.compare_results_in_array(ctypes.byref(ra), i, j)\n        assert cv == rv, ('compare_results_in_array', i, j, cv, rv)\n        compare_cases += 1\n\nprocess_cases = 0\nfor op_name in ('add_operation', 'multiply_operation', 'subtract_operation', 'modulo_operation'):\n    cop = ctypes.cast(getattr(c, op_name), ctypes.c_void_p)\n    rop = ctypes.cast(getattr(r, op_name), ctypes.c_void_p)\n    for count in range(11):\n        for _ in range(200):\n            base = ResultArray()\n            base.count = count\n            for i in range(10):\n                value = rng.randint(-100000, 100000)\n                if op_name == 'modulo_operation' and i == 1 and value == -2**31:\n                    value = 0\n                base.data[i] = Result(value, rng.uniform(-1e6, 1e6), i)\n            ca, ra = clone_arr(base), clone_arr(base)\n            cv = c.process_with_foreach(ctypes.byref(ca), cop)\n            rv = r.process_with_foreach(ctypes.byref(ra), rop)\n            assert cv == rv, ('process_with_foreach', op_name, count, cv, rv)\n            assert_arr_equal(ca, ra, ('process_with_foreach', op_name, count))\n            process_cases += 1\n\nweighted_cases = 0\nfor count in range(11):\n    for _ in range(1000):\n        base = ResultArray()\n        base.count = count\n        for i in range(10):\n            base.data[i] = Result(rng.randint(-2**31, 2**31 - 1), rng.uniform(-1e9, 1e9), rng.randint(-100, 100))\n        ca, ra = clone_arr(base), clone_arr(base)\n        cv = c.compute_weighted_sum(ctypes.byref(ca))\n        rv = r.compute_weighted_sum(ctypes.byref(ra))\n        assert cv == rv, ('compute_weighted_sum', count, cv, rv)\n        weighted_cases += 1\n\narrayfunc_cases = 0\nfixed = [\n    (0, 0, 0, 0), (1, 2, 3, 4), (-1, -2, -3, -4),\n    (-2**31, -2**31, -2**31, -2**31),\n    (2**31 - 1, 2**31 - 1, 2**31 - 1, 2**31 - 1),\n]\nfor args in fixed + [tuple(rng.randint(-2**31, 2**31 - 1) for _ in range(4)) for _ in range(50000)]:\n    cv = c.arrayfunc(*args)\n    rv = r.arrayfunc(*args)\n    assert cv == rv, ('arrayfunc', args, cv, rv)\n    arrayfunc_cases += 1\n\nprint('PASS')\nprint(f'operation cases: {operation_cases}')\nprint(f'safe conversion cases: {len(float_cases)}')\nprint(f'scaled cases: {scaled_cases}')\nprint(f'init cases: {init_cases}')\nprint(f'comparison cases: {compare_cases}')\nprint(f'foreach cases: {process_cases}')\nprint(f'weighted cases: {weighted_cases}')\nprint(f'arrayfunc cases: {arrayfunc_cases}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
