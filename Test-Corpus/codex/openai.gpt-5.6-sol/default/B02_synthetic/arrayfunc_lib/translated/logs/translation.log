 36\t\r\n    37\ttypedef int (*operation_func)(int a, int b, int unused1, int unused2);\r\n    38\t\r\n    39\ttypedef struct {\r\n    40\t    int value;\r\n    41\t    double scaled;\r\n    42\t    int rank;\r\n    43\t} Result;\r\n    44\t\r\n    45\ttypedef struct {\r\n    46\t    Result data[10];\r\n    47\t    int count;\r\n    48\t} ResultArray;\r\n    49\t\r\n    50\tint add_operation(int a, int b, int unused1, int unused2) {\r\n    51\t    (void)unused1;\r\n    52\t    (void)unused2;\r\n    53\t    return a + b;\r\n    54\t}\r\n    55\t\r\n    56\tint multiply_operation(int a, int b, int unused1, int unused2) {\r\n    57\t    (void)unused1;\r\n    58\t    (void)unused2;\r\n    59\t    return a * b;\r\n    60\t}\r\n    61\t\r\n    62\tint subtract_operation(int a, int b, int unused1, int unused2) {\r\n    63\t    (void)unused1;\r\n    64\t    (void)unused2;\r\n    65\t    return a - b;\r\n    66\t}\r\n    67\t\r\n    68\tint modulo_operation(int a, int b, int unused1, int unused2) {\r\n    69\t    (void)unused1;\r\n    70\t    (void)unused2;\r\n    71\t    if (b == 0) return 0;\r\n    72\t    return a % b;\r\n    73\t}\r\n    74\t\r\n    75\tint safe_double_to_int(double d) {\r\n    76\t    if (d >= (double)INT32_MAX) {\r\n    77\t        return INT32_MAX;\r\n    78\t    }\r\n    79\t    if (d <= (double)INT32_MIN) {\r\n    80\t        return INT32_MIN;\r\n    81\t    }\r\n    82\t    if (d != d) {\r\n    83\t        return 0;\r\n    84\t    }\r\n    85\t    return (int)d;\r\n    86\t}\r\n    87\t\r\n    88\tint compute_scaled_value(int base, double scale_factor) {\r\n    89\t    double scaled = (double)base * scale_factor;\r\n    90\t    return safe_double_to_int(scaled);\r\n    91\t}\r\n    92\t\r\n    93\tint compare_results_in_array(ResultArray *arr, int idx1, int idx2) {\r\n    94\t    if (idx1 >= arr->count || idx2 >= arr->count) {\r\n    95\t        return 0;\r\n    96\t    }\r\n    97\t\r\n    98\t    Result *ptr1 = &arr->data[idx1];\r\n    99\t    Result *ptr2 = &arr->data[idx2];\r\n   100\t\r\n   101\t    if (ptr1 < ptr2) {\r\n   102\t        return -1;\r\n   103\t    } else if (ptr1 > ptr2) {\r\n   104\t        return 1;\r\n   105\t    }\r\n   106\t    return 0;\r\n   107\t}\r\n   108\t\r\n   109\tvoid init_result_array(ResultArray *arr, int values[], int count) {\r\n   110\t    arr->count = count < 10 ? count : 10;\r\n   111\t\r\n   112\t    for (int i = 0; i < arr->count; i++) {\r\n   113\t        arr->data[i] = (Result){\r\n   114\t            .value = values[i],\r\n   115\t            .scaled = (double)values[i] * 1.5,\r\n   116\t            .rank = i\r\n   117\t        };\r\n   118\t    }\r\n   119\t}\r\n   120\t\r\n   121\tint process_with_foreach(ResultArray *arr, operation_func op) {\r\n   122\t    int total = 0;\r\n   123\t    Result *item;\r\n   124\t\r\n   125\t    FOREACH(item, arr->data, arr->count) {\r\n   126\t        int result = op(item->value, item->rank, 0, 0);\r\n   127\t        total += result;\r\n   128\t\r\n   129\t        double temp = (double)result * 0.75;\r\n   130\t        item->scaled = temp;\r\n   131\t        item->value = safe_double_to_int(temp);\r\n   132\t    }\r\n   133\t\r\n   134\t    return total;\r\n   135\t}\r\n   136\t\r\n   137\tint compute_weighted_sum(ResultArray *arr) {\r\n   138\t    int sum = 0;\r\n   139\t\r\n   140\t    for (int i = 0; i < arr->count; i++) {\r\n   141\t        Result *current = &arr->data[i];\r\n   142\t        Result *base = &arr->data[0];\r\n   143\t\r\n   144\t        int weight = (current > base) ? (int)(current - base) : 1;\r\n   145\t\r\n   146\t        double weighted = (double)current->value * (double)weight * 0.8;\r\n   147\t        sum += safe_double_to_int(weighted);\r\n   148\t    }\r\n   149\t\r\n   150\t    return sum;\r\n   151\t}\r\n   152\t\r\n   153\tint arrayfunc(int param1, int param2, int param3, int param4) {\r\n   154\t    operation_func operations[] = {\r\n   155\t        add_operation,\r\n   156\t        multiply_operation,\r\n   157\t        subtract_operation,\r\n   158\t        modulo_operation\r\n   159\t    };\r\n   160\t\r\n   161\t    int values[] = {param1, param2, param3, param4,\r\n   162\t                    param1 + param2, param2 - param3,\r\n   163\t                    param3 * 2, param4 / 2 + 1};\r\n   164\t\r\n   165\t    ResultArray arr = {.count = 0};\r\n   166\t    init_result_array(&arr, values, 8);\r\n   167\t\r\n   168\t    int result = 0;\r\n   169\t\r\n   170\t    for (int i = 0; i < 4; i++) {\r\n   171\t        result += process_with_foreach(&arr, operations[i]);\r\n   172\t    }\r\n   173\t\r\n   174\t    result += compute_weighted_sum(&arr);\r\n   175\t\r\n   176\t    for (int i = 0; i < arr.count - 1; i++) {\r\n   177\t        int cmp = compare_results_in_array(&arr, i, i + 1);\r\n   178\t        result += cmp;\r\n   179\t    }\r\n   180\t\r\n   181\t    double final_scale = (double)result * 0.333;\r\n   182\t    result = safe_double_to_int(final_scale);\r\n   183\t\r\n   184\t    return result;\r\n   185\t}\r\n","exit_code":0,"status":"completed"}}
