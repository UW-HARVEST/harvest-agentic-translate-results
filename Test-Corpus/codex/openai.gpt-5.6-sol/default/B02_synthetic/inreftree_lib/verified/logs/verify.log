58\t\r\n    59\tint subtract_op(int a, int b, int unused1, int unused2) {\r\n    60\t    return a - b;\r\n    61\t}\r\n    62\t\r\n    63\tint divide_op(int a, int b, int unused1, int unused2) {\r\n    64\t    if (b == 0) return 0;\r\n    65\t    return a / b;\r\n    66\t}\r\n    67\t\r\n    68\tint modulo_op(int a, int b, int unused1, int unused2) {\r\n    69\t    if (b == 0) return 0;\r\n    70\t    return a % b;\r\n    71\t}\r\n    72\t\r\n    73\tTreeNode* find_node_by_id(int id) {\r\n    74\t    for (int i = 0; i < node_count; i++) {\r\n    75\t        if (node_table[i].id == id) {\r\n    76\t            return &node_table[i];\r\n    77\t        }\r\n    78\t    }\r\n    79\t    return NULL;\r\n    80\t}\r\n    81\t\r\n    82\tint add_tree_node(int id, int value, int parent_id, const char* label) {\r\n    83\t    if (node_count >= MAX_NODES) {\r\n    84\t        return -1;\r\n    85\t    }\r\n    86\t\r\n    87\t    TreeNode* node = &node_table[node_count];\r\n    88\t    node->id = id;\r\n    89\t    node->value = value;\r\n    90\t    node->parent_id = parent_id;\r\n    91\t    node->left_child_id = -1;\r\n    92\t    node->right_child_id = -1;\r\n    93\t    strncpy(node->label, label, 31);\r\n    94\t    node->label[31] = '\\0';\r\n    95\t\r\n    96\t    if (parent_id != -1) {\r\n    97\t        TreeNode* parent = find_node_by_id(parent_id);\r\n    98\t        if (parent == NULL || parent->id != parent_id) {\r\n    99\t            return -1;\r\n   100\t        }\r\n   101\t\r\n   102\t        if (parent->left_child_id == -1) {\r\n   103\t            parent->left_child_id = id;\r\n   104\t        } else if (parent->right_child_id == -1) {\r\n   105\t            parent->right_child_id = id;\r\n   106\t        }\r\n   107\t    }\r\n   108\t\r\n   109\t    node_count++;\r\n   110\t    return node_count - 1;\r\n   111\t}\r\n   112\t\r\n   113\tint calculate_tree_sum(int node_id) {\r\n   114\t    TreeNode* node = find_node_by_id(node_id);\r\n   115\t\r\n   116\t