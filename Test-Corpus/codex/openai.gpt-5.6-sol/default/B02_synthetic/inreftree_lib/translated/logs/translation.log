{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\nfrom pathlib import Path\n\nroot = Path.cwd()\nc_path = root / \\\"c_reference_build/libharvest-work-8Fe09S.so\\\"\nr_path = root / \\\"translation/target/release/libtranslation.so\\\"\n\nclass TreeNode(ctypes.Structure):\n    _fields_ = [\n        (\\\"id\\\", ctypes.c_int),\n        (\\\"value\\\", ctypes.c_int),\n        (\\\"parent_id\\\", ctypes.c_int),\n        (\\\"left_child_id\\\", ctypes.c_int),\n        (\\\"right_child_id\\\", ctypes.c_int),\n        (\\\"label\\\", ctypes.c_char * 32),\n    ]\n\nassert ctypes.sizeof(TreeNode) == 52\nassert ctypes.alignment(TreeNode) == 4\nTable = TreeNode * 50\n\nlibs = [ctypes.CDLL(str(c_path)), ctypes.CDLL(str(r_path))]\nfor lib in libs:\n    for name in [\\\"add_op\\\", \\\"multiply_op\\\", \\\"subtract_op\\\", \\\"divide_op\\\", \\\"modulo_op\\\", \\\"inreftree\\\"]:\n        fn = getattr(lib, name)\n        fn.argtypes = [ctypes.c_int] * 4\n        fn.restype = ctypes.c_int\n    lib.find_node_by_id.argtypes = [ctypes.c_int]\n    lib.find_node_by_id.restype = ctypes.c_void_p\n    lib.add_tree_node.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_char_p]\n    lib.add_tree_node.restype = ctypes.c_int\n    lib.calculate_tree_sum.argtypes = [ctypes.c_int]\n    lib.calculate_tree_sum.restype = ctypes.c_int\n    lib.parse_operation.argtypes = [ctypes.c_char_p]\n    lib.parse_operation.restype = ctypes.c_int\n    lib.get_operation_func.argtypes = [ctypes.c_int]\n    lib.get_operation_func.restype = ctypes.c_void_p\n\ntables = [Table.in_dll(lib, \\\"node_table\\\") for lib in libs]\ncounts = [ctypes.c_int.in_dll(lib, \\\"node_count\\\") for lib in libs]\n\ndef snapshot(i):\n    return ctypes.string_at(ctypes.addressof(tables[i]), ctypes.sizeof(tables[i]))\n\ndef assert_state(context):\n    assert counts[0].value == counts[1].value, (context, \\\"count\\\", counts[0].value, counts[1].value)\n    assert snapshot(0) == snapshot(1), (context, \\\"table bytes differ\\\")\n\ndef reset():\n    for i in range(2):\n        counts[i].value = 0\n        ctypes.memset(ctypes.addressof(tables[i]), 0, ctypes.sizeof(tables[i]))\n    assert_state(\\\"reset\\\")\n\nrng = random.Random(0x5EED)\narithmetic_cases = [\n    (0, 0), (1, 1), (-1, 1), (2**31 - 1, 1), (-2**31, 1),\n    (2**31 - 1, -1), (-2**31, 2), (123456789, -98765), (-77, -9),\n]\narithmetic_cases += [(rng.randint(-2**31, 2**31 - 1), rng.randint(-2**31, 2**31 - 1)) for _ in range(10000)]\nfor name in [\\\"add_op\\\", \\\"multiply_op\\\", \\\"subtract_op\\\", \\\"divide_op\\\", \\\"modulo_op\\\"]:\n    checked = 0\n    for a, b in arithmetic_cases:\n        if name in (\\\"divide_op\\\", \\\"modulo_op\\\") and a == -2**31 and b == -1:\n            continue\n        got = [getattr(lib, name)(a, b, 17, -23) for lib in libs]\n        assert got[0] == got[1], (name, a, b, got)\n        checked += 1\n    assert checked >= 10000\n\nparse_cases = [None, b\\\"\\\", b\\\"+\\\", b\\\"*\\\", b\\\"-\\\", b\\\"/\\\", b\\\"%\\\", b\\\"abc\\\", b\\\"x*y\\\", b\\\"%/-*+\\\", b\\\"/%\\\", b\\\"-*\\\", b\\\"before+after\\\"]\nfor value in parse_cases:\n    got = [lib.parse_operation(value) for lib in libs]\n    assert got[0] == got[1], (\\\"parse_operation\\\", value, got)\n\nexpected_fn = {1: \\\"add_op\\\", 2: \\\"multiply_op\\\", 3: \\\"subtract_op\\\", 4: \\\"divide_op\\\", 5: \\\"modulo_op\\\"}\nFn = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int)\nfor op in range(-3, 10):\n    expected_name = expected_fn.get(op, \\\"add_op\\\")\n    for lib in libs:\n        pointer = lib.get_operation_func(op)\n        expected_pointer = ctypes.cast(getattr(lib, expected_name), ctypes.c_void_p).value\n        assert pointer == expected_pointer, (\\\"get_operation_func pointer\\\", op, pointer, expected_pointer)\n        assert Fn(pointer)(29, 6, 0, 0) == getattr(lib, expected_name)(29, 6, 0, 0)\n\nreset()\nmutations = [\n    (10, 7, -1, b\\\"abcdefghijklmnopqrstuvwxyz0123456789\\\"),\n    (11, 8, 999, b\\\"failed-parent\\\"),\n    (12, 9, 10, b\\\"left\\\\x00ignored\\\"),\n    (13, -4, 10, b\\\"right\\\"),\n    (14, 100, 10, b\\\"third-child\\\"),\n    (10, 200, -1, b\\\"duplicate-id\\\"),\n]\nfor case in mutations:\n    got = [lib.add_tree_node(*case) for lib in libs]\n    assert got[0] == got[1], (\\\"add_tree_node\\\", case, got)\n    assert_state((\\\"add_tree_node\\\", case))\n\nfor node_id in [10, 12, 13, 14, 999, -1]:\n    pointers = [lib.find_node_by_id(node_id) for lib in libs]\n    offsets = []\n    for i, pointer in enumerate(pointers):\n        offsets.append(None if pointer is None else (pointer - ctypes.addressof(tables[i])) // ctypes.sizeof(TreeNode))\n    assert offsets[0] == offsets[1], (\\\"find_node_by_id\\\", node_id, offsets)\n    sums = [lib.calculate_tree_sum(node_id) for lib in libs]\n    assert sums[0] == sums[1], (\\\"calculate_tree_sum\\\", node_id, sums)\nassert_state(\\\"tree queries\\\")\n\nreset()\nfor i in range(50):\n    label = (f\\\"node-{i:02d}-\\\" + \\\"x\\\" * 40).encode()\n    got = [lib.add_tree_node(1000 + i, i - 25, -1, label) for lib in libs]\n    assert got == [i, i], (\\\"capacity fill\\\", i, got)\n    assert_state((\\\"capacity fill\\\", i))\ngot = [lib.add_tree_node(9999, 3, -1, b\\\"overflow\\\") for lib in libs]\nassert got == [-1, -1]\nassert_state(\\\"capacity rejection\\\")\n\ninreftree_cases = [\n    (1, 2, 3, 4), (1, 2, 4, 4), (1, 2, 4, 5), (1, 2, 5, 5),\n    (1, 0, 1, 2), (0, 0, 0, 0), (-5, 9, 3, 1), (100, -20, 7, 2),\n]\nwhile len(inreftree_cases) < 5000:\n    values = tuple(rng.randint(-1000, 1000) for _ in range(4))\n    if sum(values) >= 0:\n        inreftree_cases.append(values)\nreset()\nfor case in inreftree_cases:\n    got = [lib.inreftree(*case) for lib in libs]\n    assert got[0] == got[1], (\\\"inreftree\\\", case, got)\n    assert_state((\\\"inreftree state\\\", case))\n\nprint(f\\\"behavioral comparison passed: {len(arithmetic_cases)} arithmetic vectors per operation, {len(parse_cases)} parser vectors, 13 function-pointer selectors, 56 node mutations, and {len(inreftree_cases)} inreftree vectors\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
