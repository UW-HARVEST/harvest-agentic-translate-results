  if (!fp) {\n    45\t    goto cleanup;\n    46\t  }\n    47\t\n    48\t  char buffer[100];\n    49\t  while (fgets(buffer, sizeof(buffer), fp)) {\n    50\t      printf(\"%s\", buffer);\n    51\t  }\n    52\t\n    53\t  if (ferror(fp)) {\n    54\t      goto cleanup;\n    55\t  }\n    56\t\n    57\t  return fp;\n    58\t\n    59\tcleanup:\n    60\t  fprintf(stderr, \"Error: opening or processing file %s\\n\", filename);\n    61\t  if(fp) fclose(fp);\n    62\t  return NULL;\n    63\t}\n    64\t\n    65\tint driver(int num, const char* filename) {\n    66\t  int res = forward_goto_example(num);\n    67\t  if (res == -1) {\n    68\t      return -1;\n    69\t  } else {\n    70\t      printf(\"Goto output: %d\\n\", res);\n    71\t  }\n    72\t\n    73\t  FILE* out = open_with_cleanup(filename);\n    74\t  if (out == NULL) {\n    75\t      return -2;\n    76\t  } else {\n    77\t     fclose(out);\n    78\t  }\n    79\t\n    80\t  return 0;\n    81\t}\n","exit_code":0,"status":"completed"}}
