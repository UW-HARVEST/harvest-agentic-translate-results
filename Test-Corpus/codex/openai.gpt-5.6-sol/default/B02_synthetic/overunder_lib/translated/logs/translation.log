stype = ctypes.c_int\nresult = lib.overunder(*map(int, sys.argv[2:])); ctypes.CDLL(None).fflush(None); os.write(2, (str(result) + \\\"\\\\\\\\n\\\").encode())\n'''\nfor _ in range(50):\n    args = tuple(random.randint(-20000, 20000) for _ in range(4))\n    runs = [subprocess.run([sys.executable, '-c', child, path, *map(str, args)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True) for path in paths]\n    assert (runs[0].stdout, runs[0].stderr) == (runs[1].stdout, runs[1].stderr)\nprint('FINAL_PASS: leaf ABI behavior, 40-byte struct copies, and 50 byte-identical complete outputs/returns')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
