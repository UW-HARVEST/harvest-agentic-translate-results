{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport math\nimport os\nimport struct\nimport subprocess\nimport sys\n\nroot = os.path.abspath('..')\nc_path = os.path.join(root, 'c-build', 'libharvest-work-4pgBfp.so')\nr_path = os.path.join(root, 'translation', 'target', 'release', 'libtranslation.so')\nc = ctypes.CDLL(c_path)\nr = ctypes.CDLL(r_path)\n\nfor lib in (c, r):\n    lib.safe_double_to_int.argtypes = [ctypes.c_double]\n    lib.safe_double_to_int.restype = ctypes.c_int\n    lib.process_with_fallthrough.argtypes = [ctypes.c_int, ctypes.c_int]\n    lib.process_with_fallthrough.restype = ctypes.c_int\n    lib.handle_pointer_operations.argtypes = [ctypes.c_int]\n    lib.handle_pointer_operations.restype = ctypes.c_int\n\nconversion_values = [\n    float('-inf'), -1e15, -2147483649.0, -2147483648.0, -2147483647.9,\n    -1.9, -0.0, 0.0, 1.9, 2147483646.9, 2147483647.0,\n    2147483647.1, 1e15, float('inf'), float('nan'),\n]\nfor value in conversion_values:\n    got_c = c.safe_double_to_int(value)\n    got_r = r.safe_double_to_int(value)\n    assert got_c == got_r, ('safe_double_to_int', value, got_c, got_r)\n\nfor code in range(-3, 9):\n    for base in (-1000, -1, 0, 1, 1000):\n        got_c = c.process_with_fallthrough(code, base)\n        got_r = r.process_with_fallthrough(code, base)\n        assert got_c == got_r, ('process_with_fallthrough', code, base, got_c, got_r)\n\nfor value in (-1000000, -1, 0, 1, 1000000):\n    got_c = c.handle_pointer_operations(value)\n    got_r = r.handle_pointer_operations(value)\n    assert got_c == got_r, ('handle_pointer_operations', value, got_c, got_r)\n\nclass DataBlock(ctypes.Structure):\n    _fields_ = [('id', ctypes.c_int), ('value', ctypes.c_double), ('label', ctypes.c_char * 20)]\n\nassert ctypes.sizeof(DataBlock) == 40\nfor lib in (c, r):\n    lib.copy_data_block.argtypes = [ctypes.POINTER(DataBlock), ctypes.POINTER(DataBlock)]\n    lib.copy_data_block.restype = None\n    raw = bytes(range(ctypes.sizeof(DataBlock)))\n    src = DataBlock.from_buffer_copy(raw)\n    dst = DataBlock()\n    lib.copy_data_block(ctypes.byref(dst), ctypes.byref(src))\n    assert ctypes.string_at(ctypes.byref(dst), ctypes.sizeof(dst)) == raw\n\nchild = r'''import ctypes, os, sys\nlib = ctypes.CDLL(sys.argv[1])\nlib.overunder.argtypes = [ctypes.c_int] * 4\nlib.overunder.restype = ctypes.c_int\nresult = lib.overunder(*map(int, sys.argv[2:]))\nctypes.CDLL(None).fflush(None)\nos.write(2, (str(result) + \\\"\\\\\\\\n\\\").encode())\n'''\ncases = [\n    (1, 2, 3, 4),\n    (0, 0, 0, 0),\n    (5, -7, 12, 9),\n    (-1, 8, -10, 11),\n    (-6, -20, 30, -40),\n    (6, 100, 99, 101),\n    (12345, -23456, 34567, -45678),\n]\nfor args in cases:\n    outputs = []\n    for path in (c_path, r_path):\n        proc = subprocess.run(\n            [sys.executable, '-c', child, path, *map(str, args)],\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            check=True,\n        )\n        outputs.append((proc.stdout, proc.stderr))\n    assert outputs[0] == outputs[1], (args, outputs)\n\nprint(f'PASS: {len(conversion_values)} conversions, 60 switch cases, 5 pointer cases, 2 struct copies, and {len(cases)} complete output/return cases')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
