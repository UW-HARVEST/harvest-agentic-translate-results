 Items ---\")?;\n   330\t    for item in &inventory {\n   331\t        print_item(out, *item)?;\n   332\t        writeln!(out)?;\n   333\t    }\n   334\t\n   335\t    calculate_inventory_stats(out, &inventory)?;\n   336\t    find_items_by_category(out, &inventory, \"Electronics\")?;\n   337\t    find_items_by_category(out, &inventory, \"Furniture\")?;\n   338\t\n   339\t    writeln!(out, \"\\n--- Low Stock Items (< 20) ---\")?;\n   340\t    let mut low_stock_count = 0;\n   341\t    for item in &inventory {\n   342\t        if item.quantity < 20 {\n   343\t            print_item(out, *item)?;\n   344\t            low_stock_count += 1;\n   345\t        }\n   346\t    }\n   347\t    writeln!(out, \"Total low stock items: {}\", low_stock_count)\n   348\t}\n   349\t\n   350\tfn orders() -> Vec<Order> {\n   351\t    vec![\n   352\t        Order {\n   353\t            customer_id: 1001,\n   354\t            customer_name: \"Alice Johnson\",\n   355\t            total_amount: 1249.95,\n   356\t        },\n   357\t        Order {\n   358\t            customer_id: 1002,\n   359\t            customer_name: \"Bob Smith\",\n   360\t            total_amount: 89.99,\n   361\t        },\n   362\t        Order {\n   363\t            customer_id: 1003,\n   364\t            customer_name: \"Carol White\",\n   365\t            total_amount: 549.98,\n   366\t        },\n   367\t        Order {\n   368\t            customer_id: 1004,\n   369\t            customer_name: \"David Brown\",\n   370\t            total_amount: 24.99,\n   371\t        },\n   372\t        Order {\n   373\t            customer_id: 1005,\n   374\t            customer_name: \"Eve Davis\",\n   375\t            total_amount: 899.99,\n   376\t        },\n   377\t        Order {\n   378\t            customer_id: 1006,\n   379\t            customer_name: \"Frank Miller\",\n   380\t            total_amount: 374.97,\n   381\t        },\n   382\t        Order {\n   383\t            customer_id: 1007,\n   384\t            customer_name: \"Grace Lee\",\n   385\t            total_amount: 159.98,\n   386\t        },\n   387\t        Order {\n   388\t            customer_id: 1008,\n   389\t            customer_name: \"Henry Wilson\",\n   390\t            total_amount: 1099.99,\n   391\t        },\n   392\t    ]\n   393\t}\n   394\t\n   395\tfn demo_order_list(out: &mut impl Write) -> io::Result<()> {\n   396\t    writeln!(out)?;\n   397\t    writeln!(out, \"========================================\")?;\n   398\t    writeln!(out, \"  DEMO 4: Order List (Orders)\")?;\n   399\t    writeln!(out, \"========================================\")?;\n   400\t\n   401\t    writeln!(out, \"\\n--- Adding Orders ---\")?;\n   402\t    let orders = orders();\n   403\t    writeln!(out, \"Added {} orders\", orders.len())?;\n   404\t\n   405\t    writeln!(out, \"\\n--- All Orders ---\")?;\n   406\t    for order in &orders {\n   407\t        print_order(out, *order)?;\n   408\t    }\n   409\t\n   410\t    calculate_order_stats(out, &orders)?;\n   411\t\n   412\t    writeln!(out, \"\\n--- Large Orders (> $500) ---\")?;\n   413\t    let mut large_order_count = 0;\n   414\t    let mut large_order_total = 0.0;\n   415\t    for order in &orders {\n   416\t        if order.total_amount > 500.0 {\n   417\t            print_order(out, *order)?;\n   418\t            large_order_count += 1;\n   419\t            large_order_total += order.total_amount;\n   420\t        }\n   421\t    }\n   422\t\n   423\t    writeln!(out, \"Total large orders: {}\", large_order_count)?;\n   424\t    writeln!(out, \"Revenue from large orders: ${:.2}\", large_order_total)\n   425\t}\n   426\t\n   427\tfn mixed_items() -> Vec<Item> {\n   428\t    vec![\n   429\t        Item {\n   430\t            id: 1,\n   431\t            name: \"Smartphone\",\n   432\t            category: \"Electronics\",\n   433\t            price: 699.99,\n   434\t            quantity: 25,\n   435\t        },\n   436\t        Item {\n   437\t            id: 2,\n   438\t            name: \"Tablet\",\n   439\t            category: \"Electronics\",\n   440\t            price: 449.99,\n   441\t            quantity: 18,\n   442\t        },\n   443\t        Item {\n   444\t            id: 3,\n   445\t            name: \"Headphones\",\n   446\t            category: \"Electronics\",\n   447\t            price: 149.99,\n   448\t            quantity: 40,\n   449\t        },\n   450\t        Item {\n   451\t            id: 4,\n   452\t            name: \"Smart Watch\",\n   453\t            category: \"Electronics\",\n   454\t            price: 299.99,\n   455\t            quantity: 22,\n   456\t        },\n   457\t        Item {\n   458\t            id: 5,\n   459\t            name: \"Power Bank\",\n   460\t            category: \"Electronics\",\n   461\t            price: 39.99,\n   462\t            quantity: 55,\n   463\t        },\n   464\t    ]\n   465\t}\n   466\t\n   467\tfn demo_mixed_operations(out: &mut impl Write) -> io::Result<()> {\n   468\t    writeln!(out)?;\n   469\t    writeln!(out, \"========================================\")?;\n   470\t    writeln!(out, \"  DEMO 5: Mixed Operations\")?;\n   471\t    writeln!(out, \"========================================\")?;\n   472\t\n   473\t    writeln!(out, \"\\n--- Populating both Array and List ---\")?;\n   474\t    let array_inventory = mixed_items();\n   475\t    let list_inventory = array_inventory.clone();\n   476\t    writeln!(\n   477\t        out,\n   478\t        \"Added {} items to both containers\",\n   479\t        array_inventory.len()\n   480\t    )?;\n   481\t\n   482\t    writeln!(out, \"\\n--- Iterating through Array ---\")?;\n   483\t    let mut array_count = 0;\n   484\t    for _ in &array_inventory {\n   485\t        array_count += 1;\n   486\t    }\n   487\t    writeln!(out, \"Array iteration count: {}\", array_count)?;\n   488\t\n   489\t    writeln!(out, \"\\n--- Iterating through List ---\")?;\n   490\t    let mut list_count = 0;\n   491\t    for _ in &list_inventory {\n   492\t        list_count += 1;\n   493\t    }\n   494\t    writeln!(out, \"List iteration count: {}\", list_count)?;\n   495\t\n   496\t    let price_threshold = 200.0;\n   497\t    writeln!(out, \"\\n--- Items above ${:.2} (Array) ---\", price_threshold)?;\n   498\t    for item in &array_inventory {\n   499\t        if item.price >= price_threshold {\n   500\t            writeln!(out, \"  {}: ${:.2}\", item.name, item.price)?;\n   501\t        }\n   502\t    }\n   503\t\n   504\t    writeln!(out, \"\\n--- Items above ${:.2} (List) ---\", price_threshold)?;\n   505\t    for item in &list_inventory {\n   506\t        if item.price >= price_threshold {\n   507\t            writeln!(out, \"  {}: ${:.2}\", item.name, item.price)?;\n   508\t        }\n   509\t    }\n   510\t\n   511\t    Ok(())\n   512\t}\n   513\t\n   514\t// fgets(input, 256, stdin) returns at most 255 bytes and leaves a longer\n   515\t// physical line for the next call.\n   516\tfn fgets_256(input: &mut impl BufRead) -> io::Result<Option<Vec<u8>>> {\n   517\t    let mut result = Vec::with_capacity(255);\n   518\t\n   519\t    while result.len() < 255 {\n   520\t        let available = input.fill_buf()?;\n   521\t        if available.is_empty() {\n   522\t            return if result.is_empty() {\n   523\t                Ok(None)\n   524\t            } else {\n   525\t                Ok(Some(result))\n   526\t            };\n   527\t        }\n   528\t\n   529\t        let room = 255 - result.len();\n   530\t        let available = &available[..available.len().min(room)];\n   531\t        let take = available\n   532\t            .iter()\n   533\t            .position(|byte| *byte == b'\\n')\n   534\t            .map_or(available.len(), |index| index + 1);\n   535\t        let found_newline = available[take - 1] == b'\\n';\n   536\t        result.extend_from_slice(&available[..take]);\n   537\t        input.consume(take);\n   538\t\n   539\t        if found_newline {\n   540\t            break;\n   541\t        }\n   542\t    }\n   543\t\n   544\t    Ok(Some(result))\n   545\t}\n   546\t\n   547\tfn sscanf_decimal_i32(input: &[u8]) -> Option<i32> {\n   548\t    let nul = input\n   549\t        .iter()\n   550\t        .position(|byte| *byte == 0)\n   551\t        .unwrap_or(input.len());\n   552\t    let input = &input[..nul];\n   553\t    let mut index = 0;\n   554\t\n   555\t    while index < input.len() && matches!(input[index], b' ' | b'\\t' | b'\\n' | b'\\r' | 0x0b | 0x0c)\n   556\t    {\n   557\t        index += 1;\n   558\t    }\n   559\t\n   560\t    let mut negative = false;\n   561\t    if index < input.len() && (input[index] == b'+' || input[index] == b'-') {\n   562\t        negative = input[index] == b'-';\n   563\t        index += 1;\n   564\t    }\n   565\t\n   566\t    let digit_start = index;\n   567\t    let mut magnitude = 0_u64;\n   568\t    while index < input.len() && input[index].is_ascii_digit() {\n   569\t        magnitude = magnitude\n   570\t            .saturating_mul(10)\n   571\t            .saturating_add(u64::from(input[index] - b'0'));\n   572\t        index += 1;\n   573\t    }\n   574\t    if index == digit_start {\n   575\t        return None;\n   576\t    }\n   577\t\n   578\t    let signed = if negative {\n   579\t        const I64_MIN_MAGNITUDE: u64 = 1_u64 << 63;\n   580\t        if magnitude >= I64_MIN_MAGNITUDE {\n   581\t            i64::MIN\n   582\t        } else {\n   583\t            -(magnitude as i64)\n   584\t        }\n   585\t    } else {\n   586\t        magnitude.min(i64::MAX as u64) as i64\n   587\t    };\n   588\t    Some(signed as i32)\n   589\t}\n   590\t\n   591\tfn run() -> io::Result<()> {\n   592\t    let stdin = io::stdin();\n   593\t    let stdout = io::stdout();\n   594\t    let mut input = stdin.lock();\n   595\t    let mut out = stdout.lock();\n   596\t\n   597\t    writeln!(out, \"╔════════════════════════════════════════╗\")?;\n   598\t    writeln!(out, \"║   GENERIC FOR_EACH MACRO DEMO         ║\")?;\n   599\t    writeln!(out, \"║   Demonstrating Generic Containers    ║\")?;\n   600\t    writeln!(out, \"╚════════════════════════════════════════╝\")?;\n   601\t\n   602\t    loop {\n   603\t        print_menu(&mut out)?;\n   604\t        out.flush()?;\n   605\t\n   606\t        let Some(line) = fgets_256(&mut input)? else {\n   607\t            break;\n   608\t        };\n   609\t\n   610\t        let Some(choice) = sscanf_decimal_i32(&line) else {\n   611\t            writeln!(out, \"Invalid input\")?;\n   612\t            continue;\n   613\t        };\n   614\t\n   615\t        match choice {\n   616\t            1 => demo_integer_containers(&mut out)?,\n   617\t            2 => demo_double_containers(&mut out)?,\n   618\t            3 => demo_inventory_array(&mut out)?,\n   619\t            4 => demo_order_list(&mut out)?,\n   620\t            5 => demo_mixed_operations(&mut out)?,\n","exit_code":0,"status":"completed"}}
