{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"nl -ba c_src/src/main.c | sed -n '346,430p' && nl -ba c_src/src/inventory.c | sed -n '1,220p'\"","aggregated_output":"   346\t\n   347\tint main(void) {\n   348\t    printf(\"╔════════════════════════════════════════╗\\n\");\n   349\t    printf(\"║   GENERIC FOR_EACH MACRO DEMO         ║\\n\");\n   350\t    printf(\"║   Demonstrating Generic Containers    ║\\n\");\n   351\t    printf(\"╚════════════════════════════════════════╝\\n\");\n   352\t    \n   353\t    char input[256];\n   354\t    int choice;\n   355\t    \n   356\t    while (1) {\n   357\t        print_menu();\n   358\t        \n   359\t        if (!fgets(input, sizeof(input), stdin)) {\n   360\t            break;\n   361\t        }\n   362\t        \n   363\t        if (sscanf(input, \"%d\", &choice) != 1) {\n   364\t            printf(\"Invalid input\\n\");\n   365\t            continue;\n   366\t        }\n   367\t        \n   368\t        switch (choice) {\n   369\t            case 1:\n   370\t                demo_integer_containers();\n   371\t                break;\n   372\t                \n   373\t            case 2:\n   374\t                demo_double_containers();\n   375\t                break;\n   376\t                \n   377\t            case 3:\n   378\t                demo_inventory_array();\n   379\t                break;\n   380\t                \n   381\t            case 4:\n   382\t                demo_order_list();\n   383\t                break;\n   384\t                \n   385\t            case 5:\n   386\t                demo_mixed_operations();\n   387\t                break;\n   388\t                \n   389\t            case 6:\n   390\t                printf(\"\\n=== Running All Demos ===\\n\");\n   391\t                demo_integer_containers();\n   392\t                demo_double_containers();\n   393\t                demo_inventory_array();\n   394\t                demo_order_list();\n   395\t                demo_mixed_operations();\n   396\t                printf(\"\\n========================================\\n\");\n   397\t                printf(\"  All demos completed successfully!\\n\");\n   398\t                printf(\"========================================\\n\");\n   399\t                break;\n   400\t                \n   401\t            case 7:\n   402\t                printf(\"\\nGoodbye!\\n\");\n   403\t                return 0;\n   404\t                \n   405\t            default:\n   406\t                printf(\"Invalid choice\\n\");\n   407\t                break;\n   408\t        }\n   409\t    }\n   410\t    \n   411\t    return 0;\n   412\t}\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t// inventory.c\n    26\t#include \"inventory.h\"\n    27\t\n    28\t// Define the container implementations\n    29\tDEFINE_ARRAY(int)\n    30\tDEFINE_ARRAY(double)\n    31\tDEFINE_ARRAY(item_t)\n    32\tDEFINE_ARRAY(order_t)\n    33\t\n    34\tDEFINE_LIST(int)\n    35\tDEFINE_LIST(double)\n    36\tDEFINE_LIST(item_t)\n    37\tDEFINE_LIST(order_t)\n    38\t\n    39\tvoid print_item(item_t item) {\n    40\t    printf(\"  [%d] %s\\n\", item.id, item.name);\n    41\t    printf(\"      Category: %s\\n\", item.category);\n    42\t    printf(\"      Price: $%.2f\\n\", item.price);\n    43\t    printf(\"      Quantity: %d\\n\", item.quantity);\n    44\t}\n    45\t\n    46\tvoid print_order(order_t order) {\n    47\t    printf(\"  Order - Customer ID: %d, Name: %s\\n\", \n    48\t           order.customer_id, order.customer_name);\n    49\t    printf(\"          Total: $%.2f\\n\", order.total_amount);\n    50\t}\n    51\t\n    52\titem_t create_item(int id, const char *name, const char *category, \n    53\t                   double price, int quantity) {\n    54\t    item_t item;\n    55\t    item.id = id;\n    56\t    strncpy(item.name, name, MAX_NAME_LENGTH - 1);\n    57\t    item.name[MAX_NAME_LENGTH - 1] = '\\0';\n    58\t    strncpy(item.category, category, MAX_CATEGORY_LENGTH - 1);\n    59\t    item.category[MAX_CATEGORY_LENGTH - 1] = '\\0';\n    60\t    item.price = price;\n    61\t    item.quantity = quantity;\n    62\t    return item;\n    63\t}\n    64\t\n    65\torder_t create_order(int customer_id, const char *customer_name, \n    66\t                     double total_amount) {\n    67\t    order_t order;\n    68\t    order.customer_id = customer_id;\n    69\t    strncpy(order.customer_name, customer_name, MAX_NAME_LENGTH - 1);\n    70\t    order.customer_name[MAX_NAME_LENGTH - 1] = '\\0';\n    71\t    order.total_amount = total_amount;\n    72\t    return order;\n    73\t}\n    74\t\n    75\tvoid calculate_inventory_stats(array_item_t_t *items) {\n    76\t    if (!items || items->size == 0) {\n    77\t        printf(\"No items in inventory\\n\");\n    78\t        return;\n    79\t    }\n    80\t    \n    81\t    printf(\"\\n=== Inventory Statistics (Array) ===\\n\");\n    82\t    \n    83\t    double total_value = 0.0;\n    84\t    int total_items = 0;\n    85\t    double max_price = 0.0;\n    86\t    double min_price = items->data[0].price;\n    87\t    \n    88\t    // Use ARRAY_FOREACH macro\n    89\t    item_t item;\n    90\t    ARRAY_FOREACH(item_t, item, items) {\n    91\t        total_value += item.price * item.quantity;\n    92\t        total_items += item.quantity;\n    93\t        if (item.price > max_price) max_price = item.price;\n    94\t        if (item.price < min_price) min_price = item.price;\n    95\t    }\n    96\t    \n    97\t    printf(\"Total unique items: %zu\\n\", items->size);\n    98\t    printf(\"Total item count: %d\\n\", total_items);\n    99\t    printf(\"Total inventory value: $%.2f\\n\", total_value);\n   100\t    printf(\"Average item price: $%.2f\\n\", total_value / total_items);\n   101\t    printf(\"Most expensive item: $%.2f\\n\", max_price);\n   102\t    printf(\"Least expensive item: $%.2f\\n\", min_price);\n   103\t}\n   104\t\n   105\tvoid calculate_order_stats(list_order_t_t *orders) {\n   106\t    if (!orders || orders->size == 0) {\n   107\t        printf(\"No orders to analyze\\n\");\n   108\t        return;\n   109\t    }\n   110\t    \n   111\t    printf(\"\\n=== Order Statistics (List) ===\\n\");\n   112\t    \n   113\t    double total_revenue = 0.0;\n   114\t    double max_order = 0.0;\n   115\t    double min_order = -1.0;\n   116\t    \n   117\t    // Use LIST_FOREACH macro\n   118\t    order_t order;\n   119\t    LIST_FOREACH(order_t, order, orders) {\n   120\t        total_revenue += order.total_amount;\n   121\t        if (order.total_amount > max_order) {\n   122\t            max_order = order.total_amount;\n   123\t        }\n   124\t        if (min_order < 0 || order.total_amount < min_order) {\n   125\t            min_order = order.total_amount;\n   126\t        }\n   127\t    }\n   128\t    \n   129\t    printf(\"Total orders: %zu\\n\", orders->size);\n   130\t    printf(\"Total revenue: $%.2f\\n\", total_revenue);\n   131\t    printf(\"Average order value: $%.2f\\n\", total_revenue / orders->size);\n   132\t    printf(\"Largest order: $%.2f\\n\", max_order);\n   133\t    printf(\"Smallest order: $%.2f\\n\", min_order);\n   134\t}\n   135\t\n   136\tvoid find_items_by_category(array_item_t_t *items, const char *category) {\n   137\t    if (!items || !category) return;\n   138\t    \n   139\t    printf(\"\\n=== Items in category '%s' ===\\n\", category);\n   140\t    \n   141\t    int found = 0;\n   142\t    item_t item;\n   143\t    \n   144\t    // Use ARRAY_FOREACH to iterate\n   145\t    ARRAY_FOREACH(item_t, item, items) {\n   146\t        if (strcmp(item.category, category) == 0) {\n   147\t            print_item(item);\n   148\t            found++;\n   149\t        }\n   150\t    }\n   151\t    \n   152\t    if (found == 0) {\n   153\t        printf(\"No items found in this category\\n\");\n   154\t    } else {\n   155\t        printf(\"Found %d items\\n\", found);\n   156\t    }\n   157\t}\n   158\t\n   159\tvoid find_expensive_items(list_item_t_t *items, double min_price) {\n   160\t    if (!items) return;\n   161\t    \n   162\t    printf(\"\\n=== Items priced above $%.2f ===\\n\", min_price);\n   163\t    \n   164\t    int found = 0;\n   165\t    item_t item;\n   166\t    \n   167\t    // Use LIST_FOREACH to iterate\n   168\t    LIST_FOREACH(item_t, item, items) {\n   169\t        if (item.price >= min_price) {\n   170\t            print_item(item);\n   171\t            found++;\n   172\t        }\n   173\t    }\n   174\t    \n   175\t    if (found == 0) {\n   176\t        printf(\"No items found above this price\\n\");\n   177\t    } else {\n   178\t        printf(\"Found %d items\\n\", found);\n   179\t    }\n   180\t}\n","exit_code":0,"status":"completed"}}
