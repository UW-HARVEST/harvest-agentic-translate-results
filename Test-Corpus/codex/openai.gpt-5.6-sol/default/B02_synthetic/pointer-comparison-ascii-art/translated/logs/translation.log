nes[i]);\n                }\n                shape_manager_cleanup();\n                printf(\"Goodbye!\\n\");\n                return 0;\n            default:\n                printf(\"Invalid choice\\n\");\n                break;\n        }\n    }\n    \n    // Cleanup\n    for (int i = 0; i < scene_count; i++) {\n        scene_destroy(scenes[i]);\n    }\n    shape_manager_cleanup();\n    \n    return 0;\n}\n","exit_code":0,"status":"completed"}}
