    return counter;\r\n    42\t}\r\n    43\t\r\n    44\tint multiply_counter(int value) {\r\n    45\t    counter *= value;\r\n    46\t    return counter;\r\n    47\t}\r\n    48\t\r\n    49\tint reset_counter(int value) {\r\n    50\t    counter = value;\r\n    51\t    return counter;\r\n    52\t}\r\n    53\t\r\n    54\tint is_string_empty(const char *str) {\r\n    55\t    if (!str) return 1;\r\n    56\t    if (*str) {\r\n    57\t        return 0;\r\n    58\t    }\r\n    59\t    return 1;\r\n    60\t}\r\n    61\t\r\n    62\tchar* find_char_in_buffer(const char *buffer, size_t size, char target) {\r\n    63\t    if (!buffer) return NULL;\r\n    64\t    return (char*)memchr(buffer, target, size);\r\n    65\t}\r\n    66\t\r\n    67\tchar* create_buffer(const char *initial) {\r\n    68\t    if (!initial) return NULL;\r\n    69\t\r\n    70\t    size_t len = strlen(initial);\r\n    71\t    char *buffer = (char*)malloc(len + 1);\r\n    72\t\r\n    73\t    if (buffer) {\r\n    74\t        strcpy(buffer, initial);\r\n    75\t    }\r\n    76\t\r\n    77\t    return buffer;\r\n    78\t}\r\n    79\t\r\n    80\tint validate_uint16_range(int value) {\r\n    81\t    if (value < 0) return 0;\r\n    82\t    if (value > UINT16_MAX) return 0;\r\n    83\t    return 1;\r\n    84\t}\r\n    85\t\r\n    86\tint apply_operation(operation_func op, int value) {\r\n    87\t    if (!op) return -1;\r\n    88\t    return op(value);\r\n    89\t}\r\n    90\t\r\n    91\t// TODO: lib test stdout\r\n    92\tint charinbuf(int mode, int value, int opt1, int opt2) {\r\n    93\t    int result = 0;\r\n    94\t    char *buffer = NULL;\r\n    95\t    char *found_pos = NULL;\r\n    96\t    const char *test_string = \"\";\r\n    97\t    const char *non_empty_string = \"Hello, World!\";\r\n    98\t\r\n    99\t    operation_func current_op = NULL;\r\n   100\t\r\n   101\t    counter = 0;\r\n   102\t\r\n   103\t    switch (mode) {\r\n   104\t        case 0:\r\n   105\t            printf(\"Mode 0: UINT16_MAX validation\\n\");\r\n   106\t            printf(\"Checking if value %d is within uint16_t range...\\n\", value);\r\n   107\t\r\n   108\t            if (validate_uint16_range(value)) {\r\n   109\t                printf(\"Value %d is valid (0 <= value <= %u)\\n\", value, UINT16_MAX);\r\n   110\t                result = value;\r\n   111\t            } else {\r\n   112\t                printf(\"Value %d is out of range for uint16_t\\n\", value);\r\n   113\t                result = -1;\r\n   114\t            }\r\n   115\t\r\n   116\t            printf(\"UINT16_MAX constant value: %u\\n\", UINT16_MAX);\r\n   117\t            break;\r\n   118\t\r\n   119\t        case 1:\r\n   120\t            printf(\"Mode 1: String empty check by dereference\\n\");\r\n   121\t\r\n   122\t            if (is_string_empty(test_string)) {\r\n   123\t                printf(\"Test string is empty (checked with *string)\\n\");\r\n   124\t                result = 0;\r\n   125\t            } else {\r\n   126\t                printf(\"Test string is not empty\\n\");\r\n   127\t                result = 1;\r\n   128\t            }\r\n   129\t\r\n   130\t            if (is_string_empty(non_empty_string)) {\r\n   131\t                printf(\"Non-empty string check failed!\\n\");\r\n   132\t            } else {\r\n   133\t                printf(\"Non-empty string correctly identified\\n\");\r\n   134\t                result += 10;\r\n   135\t            }\r\n   136\t            break;\r\n   137\t\r\n   138\t        case 2:\r\n   139\t            printf(\"Mode 2: Dynamic memory allocation and free\\n\");\r\n   140\t\r\n   141\t            buffer = create_buffer(\"Testing malloc and free\");\r\n   142\t\r\n   143\t            if (buffer) {\r\n   144\t                printf(\"Buffer allocated: '%s'\\n\", buffer);\r\n   145\t                printf(\"Buffer length: %zu\\n\", strlen(buffer));\r\n   146\t                result = (int)strlen(buffer);\r\n   147\t\r\n   148\t                free(buffer);\r\n   149\t                printf(\"Buffer freed successfully\\n\");\r\n   150\t                buffer = NULL;\r\n   151\t            } else {\r\n   152\t                printf(\"Failed to allocate buffer\\n\");\r\n   153\t                result = -1;\r\n   154\t            }\r\n   155\t            break;\r\n   156\t\r\n   157\t        case 3:\r\n   158\t            printf(\"Mode 3: Function pointers with static counter\\n\");\r\n   159\t\r\n   160\t            current_op = reset_counter;\r\n   161\t            result = apply_operation(current_op, value);\r\n   162\t            printf(\"Counter reset to: %d\\n\", result);\r\n   163\t\r\n   164\t            current_op = increment_counter;\r\n   165\t            result = apply_operation(current_op, opt1);\r\n   166\t            printf(\"Counter after increment by %d: %d\\n\", opt1, result);\r\n   167\t\r\n   168\t            current_op = multiply_counter;\r\n   169\t            result = apply_operation(current_op, opt2);\r\n   170\t            printf(\"Counter after multiply by %d: %d\\n\", opt2, result);\r\n   171\t\r\n   172\t            current_op = decrement_counter;\r\n   173\t            result = apply_operation(current_op, 5);\r\n   174\t            printf(\"Counter after decrement by 5: %d\\n\", result);\r\n   175\t\r\n   176\t            printf(\"Final static counter value: %d\\n\", counter);\r\n   177\t            break;\r\n   178\t\r\n   179\t        case 4:\r\n   180\t            printf(\"Mode 4: Using memchr to find character\\n\");\r\n   181\t\r\n   182\t            buffer = create_buffer(\"Search for character X in this buffer\");\r\n   183\t\r\n   184\t            if (buffer) {\r\n   185\t                size_t buf_size = strlen(buffer);\r\n   186\t                char search_char = 'X';\r\n   187\t\r\n   188\t                printf(\"Searching for '%c' in: '%s'\\n\", search_char, buffer);\r\n   189\t                found_pos = find_char_in_buffer(buffer, buf_size, search_char);\r\n   190\t\r\n   191\t              