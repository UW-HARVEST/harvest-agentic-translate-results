 result = generated_accumulator(OP, n);\n    53\t    println!(\"gen.acc={result}\");\n    54\t    result\n    55\t}\n     1\tmod config;\n     2\tmod mdcore;\n     3\t\n     4\tuse std::ffi::{CStr, CString, OsStr, c_char, c_int};\n     5\tuse std::io::{self, Write};\n     6\tuse std::os::unix::ffi::OsStrExt;\n     7\tuse std::process::ExitCode;\n     8\t\n     9\tunsafe extern \"C\" {\n    10\t    fn atoi(value: *const c_char) -> c_int;\n    11\t}\n    12\t\n    13\tfn parse_argument(value: &OsStr) -> c_int {\n    14\t    let value = CString::new(value.as_bytes()).expect(\"argv cannot contain a NUL byte\");\n    15\t    // SAFETY: CString provides the same NUL-terminated representation received\n    16\t    // by the C program, and atoi does not retain its argument.\n    17\t    unsafe { atoi(value.as_ptr()) }\n    18\t}\n    19\t\n    20\tfn main() -> ExitCode {\n    21\t    let arguments: Vec<_> = std::env::args_os().collect();\n    22\t    if arguments.len() < 3 {\n    23\t        let mut stderr = io::stderr().lock();\n    24\t        stderr.write_all(b\"usage: \").unwrap();\n    25\t        stderr.write_all(arguments[0].as_bytes()).unwrap();\n    26\t        stderr.write_all(b\" A B\\n\").unwrap();\n    27\t        return ExitCode::from(2);\n    28\t    }\n    29\t\n    30\t    let a = parse_argument(&arguments[1]);\n    31\t    let b = parse_argument(&arguments[2]);\n    32\t\n    33\t    let result_call = config::OP.apply(a, b);\n    34\t    let accumulator = config::run_unrolled(config::OP, config::REPEAT);\n    35\t\n    36\t    let x1 = mdcore::helper_call(a, b);\n    37\t    let x2 = mdcore::helper_ptr(a, b);\n    38\t    let x3 = mdcore::use_generated(config::REPEAT);\n    39\t\n    40\t    // SAFETY: Both globals are initialized to matching static values and this\n    41\t    // program does not mutate them.\n    42\t    let (global_result, operation_name) = unsafe {\n    43\t        let global_result = (mdcore::G_OP)(a, b);\n    44\t        let operatio