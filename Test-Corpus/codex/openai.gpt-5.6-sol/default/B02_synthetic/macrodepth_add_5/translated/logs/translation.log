e = \"6\"),\n    29\t    not(feature = \"4\"),\n    30\t    feature = \"3\"\n    31\t))]\n    32\tpub const REPEAT: c_int = 3;\n    33\t#[cfg(all(\n    34\t    not(feature = \"7\"),\n    35\t    not(feature = \"6\"),\n    36\t    not(feature = \"4\"),\n    37\t    not(feature = \"3\"),\n    38\t    feature = \"2\"\n    39\t))]\n    40\tpub const REPEAT: c_int = 2;\n    41\t#[cfg(all(\n    42\t    not(feature = \"7\"),\n    43\t    not(feature = \"6\"),\n    44\t    not(feature = \"4\"),\n    45\t    not(feature = \"3\"),\n    46\t    not(feature = \"2\"),\n    47\t    feature = \"1\"\n    48\t))]\n    49\tpub const REPEAT: c_int = 1;\n    50\t#[cfg(all(\n    51\t    not(feature = \"7\"),\n    52\t    not(feature = \"6\"),\n    53\t    not(feature = \"4\"),\n    54\t    not(feature = \"3\"),\n    55\t    not(feature = \"2\"),\n    56\t    not(feature = \"1\"),\n    57\t    feature = \"0\"\n    58\t))]\n    59\tpub const REPEAT: c_int = 0;\n    60\t#[cfg(not(any(\n    61\t    feature = \"7\",\n    62\t    feature = \"6\",\n    63\t    feature = \"4\",\n    64\t    feature = \"3\",\n    65\t    feature = \"2\",\n    66\t    feature = \"1\",\n    67\t    feature = \"0\"\n    68\t)))]\n    69\tpub const REPEAT: c_int = 5;\n    70\t\n    71\timpl Operation {\n    72\t    pub const fn name_c(self) -> *const i8 {\n    73\t        match self {\n    74\t            Self::Add => c\"add\".as_ptr(),\n    75\t            Self::Sub => c\"sub\".as_ptr(),\n    76\t            Self::Mul => c\"mul\".as_ptr(),\n    77\t        }\n    78\t    }\n    79\t\n    80\t    pub fn apply(self, a: c_int, b: c_int) -> c_int {\n    81\t        match self {\n    82\t            Self::Add => a.wrapping_add(b),\n    83\t            Self::Sub => a.wrapping_sub(b),\n    84\t            Self::Mul => a.wrapping_mul(b),\n    85\t        }\n    86\t    }\n    87\t\n    88\t    pub const fn initial(self) -> c_int {\n    89\t        match self {\n    90\t            Self::Add | Self::Sub => 0,\n    91\t            Self::Mul => 1,\n    92\t        }\n    93\t    }\n    94\t\n    95\t    pub fn step(self, accumulator: c_int, index: c_int) -> c_int {\n    96\t        match self {\n    97\t            Self::Add => accumulator.wrapping_add(index),\n    98\t            Self::Sub => accumulator.wrapping_sub(index),\n    99\t            Self::Mul => accumulator.wrapping_mul(index.wrapping_add(1)),\n   100\t        }\n   101\t    }\n   102\t}\n   103\t\n   104\tpub fn run_unrolled(operation: Operation, repeat: c_int) -> c_int {\n   105\t    let mut accumulator = operation.initial();\n   106\t    for index in 0..repeat {\n   107\t        accumulator = operation.step(accumulator, index);\n   108\t    }\n   109\t    accumulator\n   110\t}\n   111\t\n   112\tpub fn generated_accumulator(operation: Operation, n: c_int) -> c_int {\n   113\t    if (0..=6).contains(&n) {\n   114\t        run_unrolled(operation, n)\n   115\t    } else {\n   116\t        operation.initial()\n   117\t    }\n   118\t}\n","exit_code":0,"status":"completed"}}
