k; \\\n    85\t    case 1: REP1(op, acc);  break; \\\n    86\t    case 2: REP2(op, acc);  break; \\\n    87\t    case 3: REP3(op, acc);  break; \\\n    88\t    case 4: REP4(op, acc);  break; \\\n    89\t    case 5: REP5(op, acc);  break; \\\n    90\t    case 6: REP6(op, acc);  break; \\\n    91\t    default: break; \\\n    92\t  } \\\n    93\t} while(0)\n    94\t\n    95\t#define DEFINE_ACCUM(op) \\\n    96\t  static int CAT(accum_, op)(int n) { \\\n    97\t    int acc = INIT_FOR(op); \\\n    98\t    DISPATCH_REP(op, acc, n); \\\n    99\t    return acc; \\\n   100\t  }\n   101\t#define ACCUM_FN(op) CAT(accum_, op)\n   102\t\n   103\t/* Globals provided by md_core.c */\n   104\textern int (*G_OP)(int, int);\n   105\textern const char *G_OP_NAME;\n   106\t\n   107\t/* Helpers provided by md_core.c */\n   108\tint helper_call(int a, int b);\n   109\tint helper_ptr(int a, int b);\n   110\tint use_generated(int n);\n   111\t\n   112\t#endif /* MD_MACROS_H */\n","exit_code":0,"status":"completed"}}
