{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/lib.rs && nl -ba src/config.rs && nl -ba src/mdcore.rs'","aggregated_output":"     1\tmod config;\n     2\tmod mdcore;\n     3\t\n     4\tpub use mdcore::{G_OP, G_OP_NAME, helper_call, helper_ptr, op_add, op_mul, op_sub, use_generated};\n     1\tuse std::ffi::c_int;\n     2\t\n     3\t#[derive(Clone, Copy)]\n     4\t#[allow(dead_code)]\n     5\tpub enum Operation {\n     6\t    Add,\n     7\t    Sub,\n     8\t    Mul,\n     9\t}\n    10\t\n    11\t// Alternate values override the C defaults when Cargo's additive features\n    12\t// leave both the default and an explicitly requested value enabled.\n    13\t#[cfg(feature = \"mul\")]\n    14\tpub const OP: Operation = Operation::Mul;\n    15\t#[cfg(all(not(feature = \"mul\"), feature = \"sub\"))]\n    16\tpub const OP: Operation = Operation::Sub;\n    17\t#[cfg(all(not(feature = \"mul\"), not(feature = \"sub\")))]\n    18\tpub const OP: Operation = Operation::Add;\n    19\t\n    20\t#[cfg(feature = \"7\")]\n    21\tpub const REPEAT: c_int = 7;\n    22\t#[cfg(all(not(feature = \"7\"), feature = \"6\"))]\n    23\tpub const REPEAT: c_int = 6;\n    24\t#[cfg(all(not(feature = \"7\"), not(feature = \"6\"), feature = \"4\"))]\n    25\tpub const REPEAT: c_int = 4;\n    26\t#[cfg(all(\n    27\t    not(feature = \"7\"),\n    28\t    not(feature = \"6\"),\n    29\t    not(feature = \"4\"),\n    30\t    feature = \"3\"\n    31\t))]\n    32\tpub const REPEAT: c_int = 3;\n    33\t#[cfg(all(\n    34\t    not(feature = \"7\"),\n    35\t    not(feature = \"6\"),\n    36\t    not(feature = \"4\"),\n    37\t    not(feature = \"3\"),\n    38\t    feature = \"2\"\n    39\t))]\n    40\tpub const REPEAT: c_int = 2;\n    41\t#[cfg(all(\n    42\t    not(feature = \"7\"),\n    43\t    not(feature = \"6\"),\n    44\t    not(feature = \"4\"),\n    45\t    not(feature = \"3\"),\n    46\t    not(feature = \"2\"),\n    47\t    feature = \"1\"\n    48\t))]\n    49\tpub const REPEAT: c_int = 1;\n    50\t#[cfg(all(\n    51\t    not(feature = \"7\"),\n    52\t    not(feature = \"6\"),\n    53\t    not(feature = \"4\"),\n    54\t    not(feature = \"3\"),\n    55\t    not(feature = \"2\"),\n    56\t    not(feature = \"1\"),\n    57\t    feature = \"0\"\n    58\t))]\n    59\tpub const REPEAT: c_int = 0;\n    60\t#[cfg(not(any(\n    61\t    feature = \"7\",\n    62\t    feature = \"6\",\n    63\t    feature = \"4\",\n    64\t    feature = \"3\",\n    65\t    feature = \"2\",\n    66\t    feature = \"1\",\n    67\t    feature = \"0\"\n    68\t)))]\n    69\tpub const REPEAT: c_int = 5;\n    70\t\n    71\timpl Operation {\n    72\t    pub const fn name_c(self) -> *const i8 {\n    73\t        match self {\n    74\t            Self::Add => c\"add\".as_ptr(),\n    75\t            Self::Sub => c\"sub\".as_ptr(),\n    76\t            Self::Mul => c\"mul\".as_ptr(),\n    77\t        }\n    78\t    }\n    79\t\n    80\t    pub fn apply(self, a: c_int, b: c_int) -> c_int {\n    81\t        match self {\n    82\t            Self::Add => a.wrapping_add(b),\n    83\t            Self::Sub => a.wrapping_sub(b),\n    84\t            Self::Mul => a.wrapping_mul(b),\n    85\t        }\n    86\t    }\n    87\t\n    88\t    pub const fn initial(self) -> c_int {\n    89\t        match self {\n    90\t            Self::Add | Self::Sub => 0,\n    91\t            Self::Mul => 1,\n    92\t        }\n    93\t    }\n    94\t\n    95\t    pub fn step(self, accumulator: c_int, index: c_int) -> c_int {\n    96\t        match self {\n    97\t            Self::Add => accumulator.wrapping_add(index),\n    98\t            Self::Sub => accumulator.wrapping_sub(index),\n    99\t            Self::Mul => accumulator.wrapping_mul(index.wrapping_add(1)),\n   100\t        }\n   101\t    }\n   102\t}\n   103\t\n   104\tpub fn run_unrolled(operation: Operation, repeat: c_int) -> c_int {\n   105\t    let mut accumulator = operation.initial();\n   106\t    for index in 0..repeat {\n   107\t        accumulator = operation.step(accumulator, index);\n   108\t    }\n   109\t    accumulator\n   110\t}\n   111\t\n   112\tpub fn generated_accumulator(operation: Operation, n: c_int) -> c_int {\n   113\t    if (0..=6).contains(&n) {\n   114\t        run_unrolled(operation, n)\n   115\t    } else {\n   116\t        operation.initial()\n   117\t    }\n   118\t}\n     1\tuse std::ffi::{c_char, c_int};\n     2\t\n     3\tuse crate::config::{OP, Operation, REPEAT, generated_accumulator, run_unrolled};\n     4\t\n     5\t#[unsafe(no_mangle)]\n     6\tpub extern \"C\" fn op_add(a: c_int, b: c_int) -> c_int {\n     7\t    a.wrapping_add(b)\n     8\t}\n     9\t\n    10\t#[unsafe(no_mangle)]\n    11\tpub extern \"C\" fn op_sub(a: c_int, b: c_int) -> c_int {\n    12\t    a.wrapping_sub(b)\n    13\t}\n    14\t\n    15\t#[unsafe(no_mangle)]\n    16\tpub extern \"C\" fn op_mul(a: c_int, b: c_int) -> c_int {\n    17\t    a.wrapping_mul(b)\n    18\t}\n    19\t\n    20\tconst fn selected_function() -> extern \"C\" fn(c_int, c_int) -> c_int {\n    21\t    match OP {\n    22\t        Operation::Add => op_add,\n    23\t        Operation::Sub => op_sub,\n    24\t        Operation::Mul => op_mul,\n    25\t    }\n    26\t}\n    27\t\n    28\t#[unsafe(no_mangle)]\n    29\tpub static mut G_OP: extern \"C\" fn(c_int, c_int) -> c_int = selected_function();\n    30\t\n    31\t#[unsafe(no_mangle)]\n    32\tpub static mut G_OP_NAME: *const c_char = OP.name_c();\n    33\t\n    34\t#[unsafe(no_mangle)]\n    35\tpub extern \"C\" fn helper_call(a: c_int, b: c_int) -> c_int {\n    36\t    let result = OP.apply(a, b);\n    37\t    let accumulator = run_unrolled(OP, REPEAT);\n    38\t    println!(\"helper.call={result} helper.acc={accumulator}\");\n    39\t    result.wrapping_add(accumulator)\n    40\t}\n    41\t\n    42\t#[unsafe(no_mangle)]\n    43\tpub extern \"C\" fn helper_ptr(a: c_int, b: c_int) -> c_int {\n    44\t    let function = selected_function();\n    45\t    let result = function(a, b);\n    46\t    println!(\"helper.ptr={result}\");\n    47\t    result\n    48\t}\n    49\t\n    50\t#[unsafe(no_mangle)]\n    51\tpub extern \"C\" fn use_generated(n: c_int) -> c_int {\n    52\t    let result = generated_accumulator(OP, n);\n    53\t    println!(\"gen.acc={result}\");\n    54\t    result\n    55\t}\n","exit_code":0,"status":"completed"}}
