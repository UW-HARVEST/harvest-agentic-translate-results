{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/main.rs | sed -n '263,308p' && grep -c 'saturating_mul' src/main.rs\"","aggregated_output":"   263\tfn scan_decimal_i32(bytes: &[u8]) -> Option<i32> {\n   264\t    let bytes = c_string(bytes);\n   265\t    let mut index = 0;\n   266\t    while index < bytes.len()\n   267\t        && matches!(bytes[index], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n   268\t    {\n   269\t        index += 1;\n   270\t    }\n   271\t\n   272\t    let negative = match bytes.get(index) {\n   273\t        Some(b'-') => {\n   274\t            index += 1;\n   275\t            true\n   276\t        }\n   277\t        Some(b'+') => {\n   278\t            index += 1;\n   279\t            false\n   280\t        }\n   281\t        _ => false,\n   282\t    };\n   283\t\n   284\t    let start = index;\n   285\t    let limit = if negative {\n   286\t        (i64::MAX as u64) + 1\n   287\t    } else {\n   288\t        i64::MAX as u64\n   289\t    };\n   290\t    let mut value = 0_u64;\n   291\t    while let Some(&digit @ b'0'..=b'9') = bytes.get(index) {\n   292\t        value = value\n   293\t            .saturating_mul(10)\n   294\t            .saturating_add(u64::from(digit - b'0'))\n   295\t            .min(limit);\n   296\t        index += 1;\n   297\t    }\n   298\t    if index == start {\n   299\t        return None;\n   300\t    }\n   301\t\n   302\t    if negative {\n   303\t        Some(0_u64.wrapping_sub(value) as i32)\n   304\t    } else {\n   305\t        Some(value as i32)\n   306\t    }\n   307\t}\n   308\t\n1\n","exit_code":0,"status":"completed"}}
