{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba translation/src/main.rs && wc -l translation/src/main.rs c_src/src/main.c c_src/src/lib.c c_src/include/dag_lib.h'","aggregated_output":"     1\tuse std::io::{self, BufWriter, Read, Write};\n     2\t\n     3\tconst MAX_INPUT: usize = 256;\n     4\tconst MAX_CITY_NAME: usize = 64;\n     5\tconst MAX_EDGES: usize = 10;\n     6\tconst MAX_NODES: usize = 100;\n     7\t\n     8\t#[derive(Clone, Copy)]\n     9\tstruct Edge {\n    10\t    destination: usize,\n    11\t    distance: i32,\n    12\t}\n    13\t\n    14\tstruct Node {\n    15\t    city_name: Vec<u8>,\n    16\t    ref_count: i32,\n    17\t    edges: Vec<Edge>,\n    18\t}\n    19\t\n    20\tstruct Graph {\n    21\t    nodes: Vec<Node>,\n    22\t}\n    23\t\n    24\timpl Graph {\n    25\t    fn new() -> Self {\n    26\t        Self { nodes: Vec::new() }\n    27\t    }\n    28\t\n    29\t    fn add_node(&mut self, city_name: &[u8], err: &mut impl Write) -> Option<usize> {\n    30\t        if self.nodes.len() >= MAX_NODES {\n    31\t            let _ = writeln!(err, \"Error: Graph is full (max {MAX_NODES} nodes)\");\n    32\t            return None;\n    33\t        }\n    34\t\n    35\t        if self\n    36\t            .nodes\n    37\t            .iter()\n    38\t            .any(|node| node.city_name.as_slice() == city_name)\n    39\t        {\n    40\t            let _ = write!(err, \"Error: Node '\");\n    41\t            let _ = err.write_all(city_name);\n    42\t            let _ = writeln!(err, \"' already exists\");\n    43\t            return None;\n    44\t        }\n    45\t\n    46\t        let node = Node {\n    47\t            city_name: city_name[..city_name.len().min(MAX_CITY_NAME - 1)].to_vec(),\n    48\t            ref_count: 1,\n    49\t            edges: Vec::new(),\n    50\t        };\n    51\t        self.nodes.push(node);\n    52\t        Some(self.nodes.len() - 1)\n    53\t    }\n    54\t\n    55\t    fn get_node_by_name(&self, city_name: &[u8]) -> Option<usize> {\n    56\t        self.nodes\n    57\t            .iter()\n    58\t            .position(|node| node.city_name.as_slice() == city_name)\n    59\t    }\n    60\t\n    61\t    fn add_edge(\n    62\t        &mut self,\n    63\t        from: usize,\n    64\t        to: usize,\n    65\t        distance: i32,\n    66\t        err: &mut impl Write,\n    67\t    ) -> bool {\n    68\t        if self.nodes[from].edges.len() >= MAX_EDGES {\n    69\t            let _ = write!(err, \"Error: Node '\");\n    70\t            let _ = err.write_all(&self.nodes[from].city_name);\n    71\t            let _ = writeln!(err, \"' has maximum edges\");\n    72\t            return false;\n    73\t        }\n    74\t\n    75\t        if distance < 0 {\n    76\t            let _ = writeln!(err, \"Error: Negative distance not allowed\");\n    77\t            return false;\n    78\t        }\n    79\t\n    80\t        if self.nodes[from]\n    81\t            .edges\n    82\t            .iter()\n    83\t            .any(|edge| edge.destination == to)\n    84\t        {\n    85\t            let _ = writeln!(err, \"Error: Edge already exists\");\n    86\t            return false;\n    87\t        }\n    88\t\n    89\t        self.nodes[from].edges.push(Edge {\n    90\t            destination: to,\n    91\t            distance,\n    92\t        });\n    93\t        true\n    94\t    }\n    95\t\n    96\t    fn delete_node(&mut self, node: usize) {\n    97\t        self.nodes[node].ref_count = self.nodes[node].ref_count.wrapping_sub(1);\n    98\t    }\n    99\t\n   100\t    fn shallow_copy(&mut self, start: usize) -> usize {\n   101\t        let mut visited = [false; MAX_NODES];\n   102\t        self.increment_refs_recursive(start, &mut visited);\n   103\t        start\n   104\t    }\n   105\t\n   106\t    fn increment_refs_recursive(&mut self, node: usize, visited: &mut [bool; MAX_NODES]) {\n   107\t        if visited[node] {\n   108\t            return;\n   109\t        }\n   110\t\n   111\t        visited[node] = true;\n   112\t        self.nodes[node].ref_count = self.nodes[node].ref_count.wrapping_add(1);\n   113\t\n   114\t        let edges = self.nodes[node].edges.clone();\n   115\t        for edge in edges {\n   116\t            self.increment_refs_recursive(edge.destination, visited);\n   117\t        }\n   118\t    }\n   119\t\n   120\t    fn find_shortest_path(&self, start: usize, end: usize) -> Option<Vec<usize>> {\n   121\t        struct State {\n   122\t            node: usize,\n   123\t            distance: i32,\n   124\t            previous: Option<usize>,\n   125\t            visited: bool,\n   126\t        }\n   127\t\n   128\t        let mut state = Vec::with_capacity(MAX_NODES);\n   129\t        state.push(State {\n   130\t            node: start,\n   131\t            distance: 0,\n   132\t            previous: None,\n   133\t            visited: false,\n   134\t        });\n   135\t\n   136\t        let mut current = Some(start);\n   137\t        while let Some(current_node) = current {\n   138\t            let Some(current_idx) = state.iter().position(|item| item.node == current_node) else {\n   139\t                break;\n   140\t            };\n   141\t\n   142\t            state[current_idx].visited = true;\n   143\t            if current_node == end {\n   144\t                break;\n   145\t            }\n   146\t\n   147\t            let current_distance = state[current_idx].distance;\n   148\t            for edge in &self.nodes[current_node].edges {\n   149\t                let new_distance = current_distance.wrapping_add(edge.distance);\n   150\t                let mut neighbor_idx =\n   151\t                    state.iter().position(|item| item.node == edge.destination);\n   152\t\n   153\t                if neighbor_idx.is_none() && state.len() < MAX_NODES {\n   154\t                    neighbor_idx = Some(state.len());\n   155\t                    state.push(State {\n   156\t                        node: edge.destination,\n   157\t                        distance: i32::MAX,\n   158\t                        previous: None,\n   159\t                        visited: false,\n   160\t                    });\n   161\t                }\n   162\t\n   163\t                if let Some(index) = neighbor_idx {\n   164\t                    if new_distance < state[index].distance {\n   165\t                        state[index].distance = new_distance;\n   166\t                        state[index].previous = Some(current_node);\n   167\t                    }\n   168\t                }\n   169\t            }\n   170\t\n   171\t            let mut min_distance = i32::MAX;\n   172\t            current = None;\n   173\t            for item in &state {\n   174\t                if !item.visited && item.distance < min_distance {\n   175\t                    min_distance = item.distance;\n   176\t                    current = Some(item.node);\n   177\t                }\n   178\t            }\n   179\t        }\n   180\t\n   181\t        let end_idx = state.iter().position(|item| item.node == end)?;\n   182\t        if state[end_idx].distance == i32::MAX {\n   183\t            return None;\n   184\t        }\n   185\t\n   186\t        let mut path = Vec::new();\n   187\t        let mut current_node = Some(end);\n   188\t        while let Some(node) = current_node {\n   189\t            path.push(node);\n   190\t            let Some(index) = state.iter().position(|item| item.node == node) else {\n   191\t                break;\n   192\t            };\n   193\t            current_node = state[index].previous;\n   194\t        }\n   195\t        path.reverse();\n   196\t        Some(path)\n   197\t    }\n   198\t\n   199\t    fn print_node(&self, node: usize, out: &mut impl Write) {\n   200\t        let _ = write!(out, \"City: \");\n   201\t        let _ = out.write_all(&self.nodes[node].city_name);\n   202\t        let _ = writeln!(out, \" (ref_count: {})\", self.nodes[node].ref_count);\n   203\t        let _ = writeln!(out, \"  Edges:\");\n   204\t        for edge in &self.nodes[node].edges {\n   205\t            let _ = write!(out, \"    -> \");\n   206\t            let _ = out.write_all(&self.nodes[edge.destination].city_name);\n   207\t            let _ = writeln!(out, \" (distance: {})\", edge.distance);\n   208\t        }\n   209\t    }\n   210\t\n   211\t    fn print_graph(&self, out: &mut impl Write) {\n   212\t        let _ = writeln!(out, \"Graph with {} nodes:\", self.nodes.len());\n   213\t        for node in 0..self.nodes.len() {\n   214\t            self.print_node(node, out);\n   215\t        }\n   216\t    }\n   217\t\n   218\t    fn free_graph(&mut self) {\n   219\t        for node in 0..self.nodes.len() {\n   220\t            self.delete_node(node);\n   221\t        }\n   222\t    }\n   223\t}\n   224\t\n   225\tfn fgets(input: &mut impl Read) -> Option<Vec<u8>> {\n   226\t    let mut buffer = Vec::with_capacity(MAX_INPUT);\n   227\t    let mut byte = [0_u8; 1];\n   228\t\n   229\t    while buffer.len() < MAX_INPUT - 1 {\n   230\t        match input.read(&mut byte) {\n   231\t            Ok(0) => break,\n   232\t            Ok(_) => {\n   233\t                buffer.push(byte[0]);\n   234\t                if byte[0] == b'\\n' {\n   235\t                    break;\n   236\t                }\n   237\t            }\n   238\t            Err(_) => return None,\n   239\t        }\n   240\t    }\n   241\t\n   242\t    if buffer.is_empty() {\n   243\t        None\n   244\t    } else {\n   245\t        Some(buffer)\n   246\t    }\n   247\t}\n   248\t\n   249\tfn c_string(bytes: &[u8]) -> &[u8] {\n   250\t    let end = bytes.iter().position(|&byte| byte == 0).unwrap_or(bytes.len());\n   251\t    &bytes[..end]\n   252\t}\n   253\t\n   254\tfn city_input(bytes: &[u8]) -> &[u8] {\n   255\t    let bytes = c_string(bytes);\n   256\t    let end = bytes\n   257\t        .iter()\n   258\t        .position(|&byte| byte == b'\\n')\n   259\t        .unwrap_or(bytes.len());\n   260\t    &bytes[..end]\n   261\t}\n   262\t\n   263\tfn scan_decimal_i32(bytes: &[u8]) -> Option<i32> {\n   264\t    let bytes = c_string(bytes);\n   265\t    let mut index = 0;\n   266\t    while index < bytes.len()\n   267\t        && matches!(bytes[index], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n   268\t    {\n   269\t        index += 1;\n   270\t    }\n   271\t\n   272\t    let negative = match bytes.get(index) {\n   273\t        Some(b'-') => {\n   274\t            index += 1;\n   275\t            true\n   276\t        }\n   277\t        Some(b'+') => {\n   278\t            index += 1;\n   279\t            false\n   280\t        }\n   281\t        _ => false,\n   282\t    };\n   283\t\n   284\t    let start = index;\n   285\t    let mut value = 0_u32;\n   286\t    while let Some(&digit @ b'0'..=b'9') = bytes.get(index) {\n   287\t        value = value.wrapping_mul(10).wrapping_add(u32::from(digit - b'0'));\n   288\t        index += 1;\n   289\t    }\n   290\t    if index == start {\n   291\t        return None;\n   292\t    }\n   293\t\n   294\t    if negative {\n   295\t        Some((0_u32.wrapping_sub(value)) as i32)\n   296\t    } else {\n   297\t        Some(value as i32)\n   298\t    }\n   299\t}\n   300\t\n   301\tfn print_menu(out: &mut impl Write) {\n   302\t    let _ = writeln!(out, \"\\n=== DAG City Route Manager ===\");\n   303\t    let _ = writeln!(out, \"1. Add city (node)\");\n   304\t    let _ = writeln!(out, \"2. Add route (edge)\");\n   305\t    let _ = writeln!(out, \"3. Show all cities\");\n   306\t    let _ = writeln!(out, \"4. Show city details\");\n   307\t    let _ = writeln!(out, \"5. Find shortest path\");\n   308\t    let _ = writeln!(out, \"6. Make shallow copy of subsection\");\n   309\t    let _ = writeln!(out, \"7. Delete node\");\n   310\t    let _ = writeln!(out, \"8. Exit\");\n   311\t    let _ = write!(out, \"Choice: \");\n   312\t}\n   313\t\n   314\tfn write_quoted_not_found(out: &mut impl Write, city: &[u8]) {\n   315\t    let _ = write!(out, \"City '\");\n   316\t    let _ = out.write_all(city);\n   317\t    let _ = writeln!(out, \"' not found\");\n   318\t}\n   319\t\n   320\tfn main() {\n   321\t    let stdin = io::stdin();\n   322\t    let stdout = io::stdout();\n   323\t    let stderr = io::stderr();\n   324\t    let mut input_stream = stdin.lock();\n   325\t    let mut out = BufWriter::new(stdout.lock());\n   326\t    let mut err = stderr.lock();\n   327\t    let mut graph = Graph::new();\n   328\t\n   329\t    let _ = writeln!(out, \"City Route Management System\");\n   330\t    let _ = writeln!(out, \"Commands are read from stdin\");\n   331\t\n   332\t    loop {\n   333\t        print_menu(&mut out);\n   334\t\n   335\t        let Some(input) = fgets(&mut input_stream) else {\n   336\t            break;\n   337\t        };\n   338\t        let Some(choice) = scan_decimal_i32(&input) else {\n   339\t            let _ = writeln!(out, \"Invalid input\");\n   340\t            continue;\n   341\t        };\n   342\t\n   343\t        match choice {\n   344\t            1 => {\n   345\t                let _ = write!(out, \"Enter city name: \");\n   346\t                let Some(input) = fgets(&mut input_stream) else {\n   347\t                    continue;\n   348\t                };\n   349\t                let city = city_input(&input);\n   350\t\n   351\t                if graph.add_node(city, &mut err).is_some() {\n   352\t                    let _ = write!(out, \"Added city: \");\n   353\t                    let _ = out.write_all(city);\n   354\t                    let _ = writeln!(out);\n   355\t                } else {\n   356\t                    let _ = writeln!(out, \"Failed to add city\");\n   357\t                }\n   358\t            }\n   359\t            2 => {\n   360\t                let _ = write!(out, \"Enter from city: \");\n   361\t                let Some(from_input) = fgets(&mut input_stream) else {\n   362\t                    continue;\n   363\t                };\n   364\t                let from_city = city_input(&from_input);\n   365\t\n   366\t                let _ = write!(out, \"Enter to city: \");\n   367\t                let Some(to_input) = fgets(&mut input_stream) else {\n   368\t                    continue;\n   369\t                };\n   370\t                let to_city = city_input(&to_input);\n   371\t\n   372\t                let _ = write!(out, \"Enter distance: \");\n   373\t                let Some(distance_input) = fgets(&mut input_stream) else {\n   374\t                    continue;\n   375\t                };\n   376\t                let Some(distance) = scan_decimal_i32(&distance_input) else {\n   377\t                    let _ = writeln!(out, \"Invalid distance\");\n   378\t                    continue;\n   379\t                };\n   380\t\n   381\t                let from = graph.get_node_by_name(from_city);\n   382\t                let to = graph.get_node_by_name(to_city);\n   383\t\n   384\t                let Some(from) = from else {\n   385\t                    write_quoted_not_found(&mut out, from_city);\n   386\t                    continue;\n   387\t                };\n   388\t                let Some(to) = to else {\n   389\t                    write_quoted_not_found(&mut out, to_city);\n   390\t                    continue;\n   391\t                };\n   392\t\n   393\t                if graph.add_edge(from, to, distance, &mut err) {\n   394\t                    let _ = write!(out, \"Added route: \");\n   395\t                    let _ = out.write_all(from_city);\n   396\t                    let _ = write!(out, \" -> \");\n   397\t                    let _ = out.write_all(to_city);\n   398\t                    let _ = writeln!(out, \" (distance: {distance})\");\n   399\t                } else {\n   400\t                    let _ = writeln!(out, \"Failed to add route\");\n   401\t                }\n   402\t            }\n   403\t            3 => graph.print_graph(&mut out),\n   404\t            4 => {\n   405\t                let _ = write!(out, \"Enter city name: \");\n   406\t                let Some(input) = fgets(&mut input_stream) else {\n   407\t                    continue;\n   408\t                };\n   409\t                let city = city_input(&input);\n   410\t\n   411\t                if let Some(node) = graph.get_node_by_name(city) {\n   412\t                    graph.print_node(node, &mut out);\n   413\t                } else {\n   414\t                    write_quoted_not_found(&mut out, city);\n   415\t                }\n   416\t            }\n   417\t            5 => {\n   418\t                let _ = write!(out, \"Enter start city: \");\n   419\t                let Some(start_input) = fgets(&mut input_stream) else {\n   420\t                    continue;\n   421\t                };\n   422\t                let start_city = city_input(&start_input);\n   423\t\n   424\t                let _ = write!(out, \"Enter end city: \");\n   425\t                let Some(end_input) = fgets(&mut input_stream) else {\n   426\t                    continue;\n   427\t                };\n   428\t                let end_city = city_input(&end_input);\n   429\t\n   430\t                let start = graph.get_node_by_name(start_city);\n   431\t                let end = graph.get_node_by_name(end_city);\n   432\t\n   433\t                let Some(start) = start else {\n   434\t                    write_quoted_not_found(&mut out, start_city);\n   435\t                    continue;\n   436\t                };\n   437\t                let Some(end) = end else {\n   438\t                    write_quoted_not_found(&mut out, end_city);\n   439\t                    continue;\n   440\t                };\n   441\t\n   442\t                if let Some(path) = graph.find_shortest_path(start, end) {\n   443\t                    let _ = write!(out, \"Shortest path from \");\n   444\t                    let _ = out.write_all(start_city);\n   445\t                    let _ = write!(out, \" to \");\n   446\t                    let _ = out.write_all(end_city);\n   447\t                    let _ = writeln!(out, \":\");\n   448\t                    for (index, node) in path.iter().enumerate() {\n   449\t                        let _ = write!(out, \"  {}. \", index + 1);\n   450\t                        let _ = out.write_all(&graph.nodes[*node].city_name);\n   451\t                        let _ = writeln!(out);\n   452\t                    }\n   453\t                } else {\n   454\t                    let _ = writeln!(err, \"No path found\");\n   455\t                    let _ = writeln!(out, \"No path found\");\n   456\t                }\n   457\t            }\n   458\t            6 => {\n   459\t                let _ = write!(out, \"Enter start city for shallow copy: \");\n   460\t                let Some(input) = fgets(&mut input_stream) else {\n   461\t                    continue;\n   462\t                };\n   463\t                let city = city_input(&input);\n   464\t\n   465\t                let Some(node) = graph.get_node_by_name(city) else {\n   466\t                    write_quoted_not_found(&mut out, city);\n   467\t                    continue;\n   468\t                };\n   469\t\n   470\t                let copy = graph.shallow_copy(node);\n   471\t                let _ = write!(out, \"Created shallow copy starting from \");\n   472\t                let _ = out.write_all(city);\n   473\t                let _ = writeln!(out);\n   474\t                let _ = writeln!(\n   475\t                    out,\n   476\t                    \"Reference counts incremented for all reachable nodes\"\n   477\t                );\n   478\t                graph.print_node(copy, &mut out);\n   479\t            }\n   480\t            7 => {\n   481\t                let _ = write!(out, \"Enter city name to delete: \");\n   482\t                let Some(input) = fgets(&mut input_stream) else {\n   483\t                    continue;\n   484\t                };\n   485\t                let city = city_input(&input);\n   486\t\n   487\t                let Some(node) = graph.get_node_by_name(city) else {\n   488\t                    write_quoted_not_found(&mut out, city);\n   489\t                    continue;\n   490\t                };\n   491\t\n   492\t                let _ = writeln!(out, \"Current ref count: {}\", graph.nodes[node].ref_count);\n   493\t                graph.delete_node(node);\n   494\t                let _ = write!(out, \"Decremented reference count for \");\n   495\t                let _ = out.write_all(city);\n   496\t                let _ = writeln!(out);\n   497\t                let _ = writeln!(out, \"Note: Node will be freed when ref count reaches 0\");\n   498\t            }\n   499\t            8 => {\n   500\t                let _ = writeln!(out, \"Freeing graph and exiting...\");\n   501\t                graph.free_graph();\n   502\t                return;\n   503\t            }\n   504\t            _ => {\n   505\t                let _ = writeln!(out, \"Invalid choice\");\n   506\t            }\n   507\t        }\n   508\t    }\n   509\t\n   510\t    graph.free_graph();\n   511\t}\n  511 translation/src/main.rs\n  265 c_src/src/main.c\n  378 c_src/src/lib.c\n   87 c_src/include/dag_lib.h\n 1241 total\n","exit_code":0,"status":"completed"}}
