{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\nimport struct\n\nc_lib = ctypes.CDLL('../reference-build/libharvest-work-I2WSan.so')\nr_lib = ctypes.CDLL('target/release/libharvest_work_i2wsan.so')\nfor lib in (c_lib, r_lib):\n    lib.ldexp_q2.argtypes = (ctypes.c_float, ctypes.c_int)\n    lib.ldexp_q2.restype = ctypes.c_float\n\ndef f32(value):\n    return struct.unpack('=f', struct.pack('=I', value))[0]\n\ndef bits(value):\n    return struct.unpack('=I', struct.pack('=f', value))[0]\n\ndef check(y_bits, exponent):\n    y = f32(y_bits)\n    c_bits = bits(c_lib.ldexp_q2(y, exponent))\n    r_bits = bits(r_lib.ldexp_q2(y, exponent))\n    if c_bits \"'!= r_bits:\n        raise SystemExit(\n            f'\"'mismatch y=0x{y_bits:08x} exp={exponent}: '\n            f'C=0x{c_bits:08x} Rust=0x{r_bits:08x}'\n        )\n\nfloat_edges = [\n    0x00000000, 0x80000000, 0x00000001, 0x007fffff,\n    0x00800000, 0x3f000000, 0x3f800000, 0x40000000,\n    0x7f7fffff, 0x80800000, 0xbf800000, 0xff7fffff,\n    0x7f800000, 0xff800000, 0x7fc00000, 0xffc00000,\n    0x7fc12345, 0xffc54321,\n]\nexp_edges = sorted(set(range(-512, 4097)) | {\n    -(1 << 31), -(1 << 31) + 1, -1_000_000_000,\n    -129, -128, -127, -121, -120, -119, -4, -3, -2, -1,\n    0, 1, 2, 3, 4, 119, 120, 121, 239, 240, 241,\n})\nchecked = 0\nfor y_bits in float_edges:\n    for exponent in exp_edges:\n        check(y_bits, exponent)\n        checked += 1\n\nrng = random.Random(0x1D3E9A2)\nfor _ in range(300_000):\n    check(rng.getrandbits(32), rng.randint(-1_000_000, 10_000))\n    checked += 1\n\ncheck(0x3f800000, (1 << 31) - 1)\nchecked += 1\nprint(f'bit-identical cases: {checked}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
