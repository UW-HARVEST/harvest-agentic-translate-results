{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\nimport struct\n\nc_path = '/tmp/harvest-work-2PSkir-c-build.vJAvgQ/libharvest-work-2PSkir.so'\nr_path = 'target/release/libhsv_to_rgb.so'\nlibs = [ctypes.CDLL(c_path), ctypes.CDLL(r_path)]\nfor lib in libs:\n    lib.hsv_to_rgb.argtypes = [ctypes.POINTER(ctypes.c_float), ctypes.POINTER(ctypes.c_float)]\n    lib.hsv_to_rgb.restype = None\n\nF3 = ctypes.c_float * 3\nF8 = ctypes.c_float * 8\n\ndef f32(raw):\n    return struct.unpack('=f', struct.pack('=I', raw))[0]\n\ndef bit(value):\n    return struct.unpack('=I', struct.pack('=f', value))[0]\n\ndef bits(values):\n    return tuple(bit(value) for value in values)\n\ndef call(lib, values):\n    src = F3(*values)\n    dst = F3()\n    lib.hsv_to_rgb(dst, src)\n    return bits(dst)\n\ndef assert_equal(values, label):\n    c_out = call(libs[0], values)\n    r_out = call(libs[1], values)\n    if c_out \"'!= r_out:\n        raise SystemExit(f'\"'{label}: in={bits(values)} c={c_out} rust={r_out}')\n\nspecial_bits = [\n    0x00000000, 0x80000000, 0x00000001, 0x007fffff, 0x00800000,\n    0x3f000000, 0x3f800000, 0x40000000, 0x42700000, 0x42f00000,\n    0x7f7fffff, 0xff7fffff, 0x7f800000, 0xff800000,\n    0x7fc00000, 0x7fa00001, 0xffc12345,\n]\nfor h_raw in special_bits:\n    for s_raw in special_bits:\n        for v_raw in special_bits:\n            assert_equal((f32(h_raw), f32(s_raw), f32(v_raw)), 'special')\n\nrng = random.Random(0x485356)\nfor n in range(250_000):\n    values = tuple(\n        ctypes.c_float(value).value\n        for value in (\n            rng.uniform(-100_000.0, 100_000.0),\n            rng.uniform(-4.0, 4.0),\n            rng.uniform(-4.0, 4.0),\n        )\n    )\n    assert_equal(values, f'finite-{n}')\n\nfor n in range(1_000_000):\n    values = tuple(f32(rng.getrandbits(32)) for _ in range(3))\n    assert_equal(values, f'raw-{n}')\n\nalias_inputs = [\n    (0.0,