{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\nfrom pathlib import Path\n\nclass Pixel(ctypes.Structure):\n    _fields_ = [(\\\"r\\\", ctypes.c_uint8), (\\\"g\\\", ctypes.c_uint8), (\\\"b\\\", ctypes.c_uint8), (\\\"a\\\", ctypes.c_uint8)]\n\nclass Image(ctypes.Structure):\n    _fields_ = [(\\\"w\\\", ctypes.c_int), (\\\"h\\\", ctypes.c_int), (\\\"pix\\\", ctypes.POINTER(Pixel))]\n\nroot = Path.cwd().parent\nc_lib = ctypes.CDLL(str(root / \\\"c_reference_build\\\" / \\\"libharvest-work-kuxpUV.so\\\"))\nrust_lib = ctypes.CDLL(str(Path.cwd() / \\\"target\\\" / \\\"release\\\" / \\\"libtranslation.so\\\"))\nfor lib in (c_lib, rust_lib):\n    lib.flip_horizontal.argtypes = [ctypes.POINTER(Image)]\n    lib.flip_horizontal.restype = None\n\ndef run(lib, w, h, data):\n    count = max(1, w * h)\n    pixels = (Pixel * count)()\n    if data:\n        ctypes.memmove(pixels, data, len(data))\n    image = Image(w, h, pixels)\n    lib.flip_horizontal(ctypes.byref(image))\n    return ctypes.string_at(pixels, w * h * ctypes.sizeof(Pixel))\n\nrng = random.Random(0xC0FFEE)\ncases = []\nfor h in range(17):\n    for w in range(17):\n        cases.append((w, h))\nfor _ in range(1000):\n    cases.append((rng.randrange(0, 129), rng.randrange(0, 129)))\n\nfor index, (w, h) in enumerate(cases):\n    data = rng.randbytes(w * h * ctypes.sizeof(Pixel))\n    c_out = run(c_lib, w, h, data)\n    rust_out = run(rust_lib, w, h, data)\n    expected = b\\\"\\\".join(\n        data[row * w * 4:(row + 1) * w * 4]\n        for row in range(h - 1, -1, -1)\n    )\n    if c_out \"'!= rust_out or rust_out != expected:\n        raise SystemExit(f\"mismatch in case {index}: w={w}, h={h}\")\n\nprint(f\"matched {len(cases)} cases; Pixel={ctypes.sizeof(Pixel)} bytes, Image={ctypes.sizeof(Image)} bytes\")\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
