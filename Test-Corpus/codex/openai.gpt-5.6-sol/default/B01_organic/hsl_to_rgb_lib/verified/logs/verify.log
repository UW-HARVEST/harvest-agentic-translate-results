e {\n        (m, m, m)\n    };\n\n    unsafe {\n        *dest = rgb.0;\n        *dest.add(1) = rgb.1;\n        *dest.add(2) = rgb.2;\n    }\n}\n","exit_code":0,"status":"completed"}}
