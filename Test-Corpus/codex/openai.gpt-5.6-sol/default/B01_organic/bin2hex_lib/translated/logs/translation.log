verlap(funcs[0], initial, out_at, in_at, length) == overlap(funcs[1], initial, out_at, in_at, length)\n            count += 1\n\nchild = ('import ctypes,sys; f=ctypes.CDLL(sys.argv[1]).bin2hex; '\n         'f.argtypes=[ctypes.c_void_p,ctypes.c_size_t,ctypes.c_void_p,ctypes.c_size_t]; '\n         'f(None,int(sys.argv[2]),None,int(sys.argv[3]))')\nscenarios = [(0, 2**63 - 1), (2, 1), (0, 0)]\nabort_results = []\nfor lib in libs:\n    results = [subprocess.run([sys.executable, '-c', child, lib, str(a), str(b)],\n                              stdout=subprocess.DEVNULL,\n                              stderr=subprocess.DEVNULL).returncode\n               for a, b in scenarios]\n    assert results == [-6, -6, -6], (lib, results)\n    abort_results.append(results)\nassert abort_results[0] == abort_results[1]\nprint(f'normal_cases={len(cases)} overlap_cases={count} abort_cases={len(scenarios)} status=pass')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
