{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\nimport struct\n\nC_SO = '/tmp/harvest-c-reference-6xw7RS-v1/libharvest-work-6xw7RS.so'\nRUST_SO = 'target/release/libspritebatch_sort.so'\nRECORD_SIZE = 16\n\nc_lib = ctypes.CDLL(C_SO, mode=ctypes.RTLD_LOCAL)\nrust_lib = ctypes.CDLL(RUST_SO, mode=ctypes.RTLD_LOCAL)\nfor lib in (c_lib, rust_lib):\n    lib.merge_sort.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int]\n    lib.merge_sort.restype = None\n\nassert ctypes.sizeof(ctypes.c_ulonglong) == 8\nclass Sprite(ctypes.Structure):\n    _fields_ = [('texture_id', ctypes.c_ulonglong), ('sort_bits', ctypes.c_int)]\nassert ctypes.sizeof(Sprite) == RECORD_SIZE\nassert Sprite.sort_bits.offset == 8\n\nrng = random.Random(0x5EEDC0DE)\n\ndef invoke(lib, source, scratch):\n    allocated = max(len(source), 1)\n    a = ctypes.create_string_buffer(allocated)\n    b = ctypes.create_string_buffer(allocated)\n    if source:\n        ctypes.memmove(a, source, len(source))\n        ctypes.memmove(b, scratch, len(scratch))\n    else:\n        a[0] = b'\\\\xA5'\n        b[0] = b'\\\\x5A'\n    lib.merge_sort(a, b, len(source) // RECORD_SIZE)\n    return bytes(a.raw[:allocated]), bytes(b.raw[:allocated])\n\ndef check(records):\n    source = b''.join(records)\n    scratch = bytes(rng.getrandbits(8) for _ in range(len(source)))\n    c_result = invoke(c_lib, source, scratch)\n    rust_result = invoke(rust_lib, source, scratch)\n    if c_result \"'!= rust_result:\n        raise AssertionError(f'\"'mismatch for {len(records)} records')\n    if records:\n        actual = [c_result[0][i:i + RECORD_SIZE] for i in range(0, len(source), RECORD_SIZE)]\n        expected = sorted(records, key=lambda record: struct.unpack_from('@i', record, 8)[0])\n        if actual \"'!= expected:\n            raise AssertionError(f'\"'unexpected ordering for {len(records)} records')\n\ndef record(texture_id, sort_