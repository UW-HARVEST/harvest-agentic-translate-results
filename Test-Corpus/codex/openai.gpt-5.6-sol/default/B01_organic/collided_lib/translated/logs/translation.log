m_buffer_copy(struct.pack('=I', x))\n\nspecial = [\n    0x00000000, 0x80000000, 0x00000001, 0x80000001,\n    0x007fffff, 0x00800000, 0x3f800000, 0xbf800000,\n    0x7f7fffff, 0xff7fffff, 0x7f800000, 0xff800000,\n    0x7fc00000, 0x7fc01234, 0xffc05678,\n]\nfor x in special:\n    for y in special:\n        vx = vbits(x, y)\n        vy = vbits(y, x)\n        check('c2V', fbits(x), fbits(y))\n        check('c2Maxv', vx, vy)\n        check('c2Minv', vx, vy)\n        check('c2Sub', vx, vy)\n        check('c2Dot', vx, vy)\nfor x in special:\n    check('c2Clampv', vbits(x, x), vbits(0xbf800000, 0xbf800000), vbits(0x3f800000, 0x3f800000))\n\nrng = random.Random(0xC2C2AABB)\nfor _ in range(50000):\n    q = [rng.getrandbits(32) for _ in range(12)]\n    v0, v1, v2 = vbits(*q[0:2]), vbits(*q[2:4]), vbits(*q[4:6])\n    check('c2V', fbits(q[0]), fbits(q[1]))\n    check('c2Maxv', v0, v1)\n    check('c2Minv', v0, v1)\n    check('c2Clampv', v0, v1, v2)\n    check('c2Sub', v0, v1)\n    check('c2Dot', v0, v1)\n\n    ca, cb = circlebits(*q[0:3]), circlebits(*q[3:6])\n    aa, ab = aabbbits(*q[4:8]), aabbbits(*q[8:12])\n    check('c2CircletoCircle', ca, cb)\n    check('c2CircletoAABB', ca, aa)\n    check('c2AABBtoAABB', aa, ab)\n    check('collided', C.byref(ca), 0, C.byref(cb), 0)\n    check('collided', C.byref(ca), 0, C.byref(aa), 1)\n    check('collided', C.byref(aa), 1, C.byref(ca), 0)\n    check('collided', C.byref(aa), 1, C.byref(ab), 1)\n\nfor ta in (-2147483648, -1, 0, 1, 2, 2147483647):\n    for tb in (-2147483648, -1, 0, 1, 2, 2147483647):\n        if ta not in (0, 1) or tb not in (0, 1):\n            check('collided', None, ta, None, tb)\n\nprint('differential_checks=700501')\nprint('result=byte-identical')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
