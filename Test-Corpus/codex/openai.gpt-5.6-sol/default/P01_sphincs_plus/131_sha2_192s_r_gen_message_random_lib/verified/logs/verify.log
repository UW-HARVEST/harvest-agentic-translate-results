{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/address.rs; nl -ba src/offsets/blake.rs; nl -ba src/utils.rs | sed -n '1,130p'\"","aggregated_output":"     1\tuse crate::{ params::*, utils::*, offsets::* };\n     2\t\n     3\t// This could probably be better represented as an enum with associated constants \n     4\tpub const SPX_ADDR_TYPE_WOTS: u32 = 0;\n     5\tpub const SPX_ADDR_TYPE_WOTSPK: u32 = 1;\n     6\tpub const SPX_ADDR_TYPE_HASHTREE: u32 = 2;\n     7\tpub const SPX_ADDR_TYPE_FORSTREE: u32 = 3;\n     8\tpub const SPX_ADDR_TYPE_FORSPK: u32 = 4;\n     9\tpub const SPX_ADDR_TYPE_WOTSPRF: u32 = 5;\n    10\tpub const SPX_ADDR_TYPE_FORSPRF: u32 = 6;\n    11\t\n    12\t// Replaces the uint8_t addr cast in C reference implementation\n    13\tfn set_addr(addr: &mut[u32], offset: usize, value: u32) \n    14\t{\n    15\t  let mut addr_bytes = address_to_bytes(addr); \n    16\t  addr_bytes[offset] = value as u8;\n    17\t  bytes_to_address(addr, &addr_bytes);\n    18\t}\n    19\t\n    20\t/// Specify which level of Merkle tree (the \"layer\") we're working on\n    21\tpub fn set_layer_addr(addr: &mut [u32], layer: u32)\n    22\t{ \n    23\t  set_addr(addr, SPX_OFFSET_LAYER, layer);\n    24\t}\n    25\t\n    26\t/// Specify which Merkle tree within the level (the \"tree address\") we're working on\n    27\tpub fn set_tree_addr(addr: &mut [u32], tree: u64)\n    28\t{\n    29\t  let be64 = tree.to_be_bytes();\n    30\t  let mut tmp_addr = address_to_bytes(&addr);\n    31\t  tmp_addr[SPX_OFFSET_TREE..SPX_OFFSET_TREE+8].copy_from_slice(&be64);\n    32\t  bytes_to_address(addr, &tmp_addr);\n    33\t}\n    34\t\n    35\t/// Specify the reason we'll use this address structure for, that is, what\n    36\t/// hash will we compute with it.  This is used so that unrelated types of\n    37\t/// hashes don't accidentally get the same address structure.  The type will be\n    38\t/// one of the SPX_ADDR_TYPE constants\n    39\tpub fn set_type(addr: &mut [u32], addr_type: u32)\n    40\t{\n    41\t  set_addr(addr, SPX_OFFSET_TYPE, addr_type);\n    42\t}\n    43\t\n    44\t/// Copy the layer and tree fields of the address structure.  This is used\n    45\t/// when we're doing multiple types of hashes within the same Merkle tree\n    46\tpub fn copy_subtree_addr(out: &mut [u32], input: &mut [u32])\n    47\t{   \n    48\t  let buf = address_to_bytes(input);\n    49\t  let mut out_bytes = address_to_bytes(out);\n    50\t  out_bytes[..SPX_OFFSET_TREE + 8 ]\n    51\t    .copy_from_slice(&buf[..SPX_OFFSET_TREE + 8]);\n    52\t  bytes_to_address(out, &out_bytes);\n    53\t}\n    54\t\n    55\t/// OTS ADDRESS FUNCTIONS\n    56\t\n    57\t/// Specify which Merkle leaf we're working on; that is, which OTS keypair\n    58\t/// we're talking about.\n    59\tpub fn set_keypair_addr(addr: &mut [u32], keypair: u32)\n    60\t{\n    61\t  // We have > 256 OTS at the bottom of the Merkle tree; to specify \n    62\t  // which one, we'd need to express it input two bytes  \n    63\t  if SPX_FULL_HEIGHT/SPX_D > 8 {\n    64\t    set_addr(addr, SPX_OFFSET_KP_ADDR2, keypair >> 8);\n    65\t  }\n    66\t  set_addr(addr, SPX_OFFSET_KP_ADDR1, keypair);\n    67\t}\n    68\t\n    69\t/// Copy the layer, tree and keypair fields of the address structure.  This is\n    70\t/// used when we're doing multiple things within the same OTS keypair\n    71\tpub fn copy_keypair_addr(out: &mut [u32], input: &[u32])\n    72\t{ \n    73\t  let in_buf = address_to_bytes(input);\n    74\t  let mut out_buf = address_to_bytes(out);\n    75\t  out_buf[..SPX_OFFSET_TREE + 8].copy_from_slice(&in_buf[..SPX_OFFSET_TREE + 8]);\n    76\t\n    77\t  if SPX_FULL_HEIGHT / SPX_D > 8 {\n    78\t    out_buf[SPX_OFFSET_KP_ADDR2] = in_buf[SPX_OFFSET_KP_ADDR2];\n    79\t  }\n    80\t  out_buf[SPX_OFFSET_KP_ADDR1] = in_buf[SPX_OFFSET_KP_ADDR1];\n    81\t  bytes_to_address(out, &out_buf);\n    82\t}\n    83\t\n    84\t/// Specify which Merkle chain within the OTS we're working with the chain address\n    85\tpub fn set_chain_addr(addr: &mut [u32], chain: u32)\n    86\t{\n    87\t  set_addr(addr, SPX_OFFSET_CHAIN_ADDR, chain);\n    88\t}\n    89\t\n    90\t/// Specify where in the Merkle chain we are the hash address\n    91\tpub fn set_hash_addr(addr: &mut [u32], hash: u32)\n    92\t{\n    93\t  set_addr(addr, SPX_OFFSET_HASH_ADDR, hash);\n    94\t}\n    95\t\n    96\t/// These functions are used for all hash tree addresses (including FORS).\n    97\t\n    98\t/// Specify the height of the node in the Merkle/FORS tree we are in the tree height\n    99\tpub fn set_tree_height(addr: &mut [u32], tree_height: u32)\n   100\t{\n   101\t  set_addr(addr, SPX_OFFSET_TREE_HGT, tree_height);\n   102\t}\n   103\t\n   104\t///Specify the distance from the left edge of the node in the Merkle/FORS tree\n   105\tpub fn set_tree_index(addr: &mut [u32], tree_index: u32)\n   106\t{\n   107\t  let mut tmp_addr = address_to_bytes(&addr);\n   108\t  u32_to_bytes(&mut tmp_addr[SPX_OFFSET_TREE_INDEX..], tree_index);\n   109\t  bytes_to_address(addr, &tmp_addr);\n   110\t}\n     1\tpub const SPX_OFFSET_LAYER: usize = 3;\n     2\tpub const SPX_OFFSET_TREE: usize = 8;\n     3\tpub const SPX_OFFSET_TYPE: usize = 19;\n     4\tpub const SPX_OFFSET_KP_ADDR2: usize = 22;\n     5\tpub const SPX_OFFSET_KP_ADDR1: usize = 23;\n     6\tpub const SPX_OFFSET_CHAIN_ADDR: usize = 27;\n     7\tpub const SPX_OFFSET_HASH_ADDR: usize = 31;\n     8\tpub const SPX_OFFSET_TREE_HGT: usize = 27;\n     9\tpub const SPX_OFFSET_TREE_INDEX: usize = 28;\n    10\t\n     1\tuse crate::context::SpxCtx;\n     2\tuse crate::params::*;\n     3\tuse crate::thash::*;\n     4\tuse crate::address::*;\n     5\t\n     6\t/// Converts the value of 'in' to 'outlen' bytes in big-endian byte order\n     7\tpub fn ull_to_bytes(out: &mut[u8], outlen: usize, mut input: u64)\n     8\t{\n     9\t  // Iterate over out in decreasing order, for big-endianness.\n    10\t  for i in (0..outlen).rev() {\n    11\t    out[i] = (input & 0xff) as u8;\n    12\t    input = input >> 8;\n    13\t  }\n    14\t}\n    15\t\n    16\tpub fn u32_to_bytes(out: &mut[u8], input: u32)\n    17\t{\n    18\t  out[0] = (input >> 24) as u8;\n    19\t  out[1] = (input >> 16) as u8;\n    20\t  out[2] = (input >> 8) as u8;\n    21\t  out[3] = input as u8;\n    22\t}\n    23\t\n    24\t/// Converts the inlen bytes in 'in' from big-endian byte order to an integer.\n    25\tpub fn bytes_to_ull(input: &[u8], inlen: usize ) -> u64\n    26\t{\n    27\t  let mut retval = 0u64;\n    28\t  for i in 0..inlen  {\n    29\t    retval |= (input[i] as u64) << (8*(inlen - 1 - i));\n    30\t  }\n    31\t  return retval;\n    32\t}\n    33\t\n    34\t/// Computes a root node given a leaf and an auth path.\n    35\t/// Expects address to be complete other than the tree_height and tree_index.\n    36\tpub fn compute_root(\n    37\t  root: &mut[u8], leaf: &[u8], mut leaf_idx: u32, mut idx_offset: u32,\n    38\t  auth_path: &[u8], tree_height: u32, ctx: &SpxCtx, addr: &mut[u32; 8]\n    39\t)\n    40\t{\n    41\t  let mut buffer = [0u8; 2 * SPX_N];\n    42\t  let mut idx = 0usize;\n    43\t\n    44\t  // If leaf_idx is odd (last bit = 1), current path element is a right child\n    45\t  // and auth_path has to go left. Otherwise it is the other way around.\n    46\t  if (leaf_idx & 1) != 0 {\n    47\t    buffer[SPX_N..].copy_from_slice(&leaf[..SPX_N]);\n    48\t    buffer[..SPX_N].copy_from_slice(&auth_path[..SPX_N]);\n    49\t  }\n    50\t  else {\n    51\t    buffer[..SPX_N].copy_from_slice(&leaf[..SPX_N]);\n    52\t    buffer[SPX_N..].copy_from_slice(&auth_path[..SPX_N]);\n    53\t  }\n    54\t  idx += SPX_N;\n    55\t\n    56\t  for i in 0..(tree_height - 1) {\n    57\t    leaf_idx >>= 1;\n    58\t    idx_offset >>= 1;\n    59\t    // Set the address of the node we're creating.\n    60\t    set_tree_height(addr, i + 1);\n    61\t    set_tree_index(addr, leaf_idx + idx_offset);\n    62\t\n    63\t    // Pick the right or left neighbour, depending on parity of the node.\n    64\t    if (leaf_idx & 1) != 0 {\n    65\t      let tmp_buffer = buffer.clone();\n    66\t      thash::<2>(&mut buffer[SPX_N..], Some(&tmp_buffer), ctx, addr);\n    67\t      buffer[..SPX_N].copy_from_slice(&auth_path[idx..][..SPX_N]);\n    68\t  }\n    69\t    else {\n    70\t      thash::<2>(&mut buffer, None, ctx, addr);\n    71\t      buffer[SPX_N..].copy_from_slice(&auth_path[idx..][..SPX_N]);\n    72\t    }\n    73\t    idx += SPX_N;\n    74\t  }\n    75\t\n    76\t  // The last iteration is exceptional; we do not copy an auth_path node.\n    77\t  leaf_idx >>= 1;\n    78\t  idx_offset >>= 1;\n    79\t  set_tree_height(addr, tree_height);\n    80\t  set_tree_index(addr, leaf_idx + idx_offset);\n    81\t  thash::<2>(root, Some(&buffer), ctx, addr);\n    82\t}\n    83\t\n    84\tpub fn bytes_to_address(addr: &mut[u32], bytes: &[u8; 32])\n    85\t{\n    86\t  for i in 0..8 {\n    87\t    let mut addr_i = [0u8; 4];\n    88\t    addr_i.copy_from_slice(&bytes[i*4..][..4]);\n    89\t    addr[i] = u32::from_ne_bytes(addr_i);\n    90\t  }\n    91\t}\n    92\t\n    93\tpub fn address_to_bytes(addr: &[u32]) -> [u8; 32] \n    94\t{\n    95\t  let mut out = [0u8; 32];\n    96\t  for i in 0..8 {\n    97\t    out[i*4..][..4].copy_from_slice(&addr[i].to_ne_bytes());\n    98\t  }\n    99\t  out\n   100\t}\n","exit_code":0,"status":"completed"}}
