{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/utilsx1.rs | sed -n '1,260p'; nl -ba src/thash/blake_simple.rs; nl -ba src/hash/blake.rs\"","aggregated_output":"     1\tuse crate::context::SpxCtx;\n     2\tuse crate::fors::{ ForsGenLeafInfo, fors_gen_leafx1 };\n     3\tuse crate::params::*;\n     4\tuse crate::address::*;\n     5\tuse crate::thash::*;\n     6\tuse crate::wotsx1::{ LeafInfoX1, wots_gen_leafx1 };\n     7\t\n     8\t/// Generate the entire Merkle tree, computing the authentication path for\n     9\t/// leaf_idx, and the resulting root node using Merkle's TreeHash algorithm.\n    10\t/// Expects the layer and tree parts of the tree_addr to be set, as well as the\n    11\t/// tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE)\n    12\t/// This expects tree_addr to be initialized to the addr structures for the \n    13\t/// Merkle tree nodes.\n    14\t/// \n    15\t/// Applies the offset idx_offset to indices before building addresses, so that\n    16\t/// it is possible to continue counting indices across trees.\n    17\t/// This works by using the standard Merkle tree building algorithm.\n    18\t/// T: tree_height\n    19\t/// S: stack.len()\n    20\tpub fn wots_treehashx1<const T: usize, const S: usize>(\n    21\t  root: &mut[u8], auth_path: &mut[u8], ctx: &SpxCtx, leaf_idx: u32, \n    22\t  idx_offset: u32, tree_addr: &mut[u32], info: &mut LeafInfoX1\n    23\t) \n    24\t{\n    25\t  let mut idx =  0u32;\n    26\t  let max_idx = (1 << T) - 1;\n    27\t  let mut stack = [0u8; S];\n    28\t  loop {\n    29\t    // Current logical node is at index[SPX_N].\n    30\t    // We do this to minimize the number of copies needed during a thash\n    31\t    let mut current = [0u8; 2*SPX_N];    \n    32\t\n    33\t    wots_gen_leafx1( &mut current[SPX_N..], ctx, idx + idx_offset, info);\n    34\t\n    35\t    // Now combine the freshly generated right node with previously\n    36\t    //  generated left ones\n    37\t    let mut internal_idx_offset = idx_offset;\n    38\t    let mut internal_idx = idx;\n    39\t    let mut internal_leaf = leaf_idx;\n    40\t    // The height we are in the Merkle tree\n    41\t    let mut h =  0u32;      \n    42\t    loop {\n    43\t\n    44\t      // Check if we hit the top of the tree\n    45\t      if h == T as u32 {\n    46\t        // We hit the root; return it\n    47\t        root[..SPX_N].copy_from_slice(&current[SPX_N..SPX_N*2]);\n    48\t        return;\n    49\t      }\n    50\t      // Check if the node we have is a part of the\n    51\t      //authentication path; if it is, write it out\n    52\t      let start = h as usize * SPX_N;\n    53\t      if (internal_idx ^ internal_leaf) == 0x01 {\n    54\t        auth_path[start..][..SPX_N].copy_from_slice(&current[SPX_N..SPX_N*2]);\n    55\t      }\n    56\t\n    57\t       // Check if we're at a left child; if so, stop going up the stack\n    58\t       // Exception: if we've reached the end of the tree, keep on going\n    59\t       // (so we combine the last 4 nodes into the one root node in two\n    60\t       // more iterations)\n    61\t      if (internal_idx & 1) == 0 && idx < max_idx {\n    62\t        break;\n    63\t      }\n    64\t\n    65\t      // Ok, we're at a right node\n    66\t      // Now combine the left and right logical nodes together\n    67\t      // Set the address of the node we're creating.\n    68\t      internal_idx_offset >>= 1;\n    69\t      set_tree_height(tree_addr, h + 1);\n    70\t      set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\n    71\t\n    72\t      current[  ..SPX_N].copy_from_slice(&stack[start..][..SPX_N]);\n    73\t      let tmp_current = current.clone();\n    74\t      thash::<2>( &mut current[SPX_N..], Some(&tmp_current), ctx, tree_addr);\n    75\t      h += 1; \n    76\t      internal_idx >>= 1;\n    77\t      internal_leaf >>= 1;\n    78\t    }\n    79\t\n    80\t    // We've hit a left child; save the current for when we get the\n    81\t    // corresponding right right\n    82\t    let start = h as usize * SPX_N;\n    83\t    stack[start..][..SPX_N].copy_from_slice(&current[SPX_N..SPX_N*2]);\n    84\t    idx += 1\n    85\t  }\n    86\t}\n    87\t\n    88\tpub fn fors_treehashx1<const T: usize, const S: usize>(\n    89\t  root: &mut[u8], auth_path: &mut[u8], ctx: &SpxCtx, leaf_idx: u32, \n    90\t  idx_offset: u32, tree_addr: &mut[u32; 8], info: &mut ForsGenLeafInfo\n    91\t) \n    92\t{\n    93\t  let mut stack = [0u8; S];\n    94\t  let mut idx =  0u32;\n    95\t  let max_idx = (1 << T) - 1;\n    96\t  loop {\n    97\t    let mut current = [0u8; 2*SPX_N];    \n    98\t\n    99\t    fors_gen_leafx1(&mut current[SPX_N..], ctx, idx + idx_offset, info);\n   100\t\n   101\t    let mut internal_idx_offset = idx_offset;\n   102\t    let mut internal_idx = idx;\n   103\t    let mut internal_leaf = leaf_idx;\n   104\t    let mut h =  0u32;      \n   105\t    loop {\n   106\t      if h == T as u32 {\n   107\t        root[..SPX_N].copy_from_slice(&current[SPX_N..SPX_N*2]);\n   108\t        return;\n   109\t      }\n   110\t      let start = h as usize * SPX_N;\n   111\t      if (internal_idx ^ internal_leaf) == 0x01 {\n   112\t        auth_path[start..][..SPX_N].copy_from_slice(&current[SPX_N..SPX_N*2]);\n   113\t      }\n   114\t\n   115\t      if (internal_idx & 1) == 0 && idx < max_idx {\n   116\t        break;\n   117\t      }\n   118\t\n   119\t      internal_idx_offset >>= 1;\n   120\t      set_tree_height(tree_addr, h + 1);\n   121\t      set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\n   122\t\n   123\t      current[..SPX_N].copy_from_slice(&stack[start..][..SPX_N]);\n   124\t      let tmp_current = current.clone();\n   125\t      thash::<2>( &mut current[SPX_N..], Some(&tmp_current), ctx, tree_addr);\n   126\t      h += 1; \n   127\t      internal_idx >>= 1;\n   128\t      internal_leaf >>= 1;\n   129\t    }\n   130\t\n   131\t    let start = h as usize * SPX_N;\n   132\t    stack[start..][..SPX_N].copy_from_slice(&current[SPX_N..SPX_N*2]);\n   133\t    idx += 1\n   134\t  }\n   135\t}\n     1\tuse crate::blake::{blake256, blake512};\n     2\tuse crate::context::SpxCtx;\n     3\tuse crate::params::*;\n     4\tuse crate::utils::address_to_bytes;\n     5\t\n     6\tpub fn thash<const BLOCKS: usize>(\n     7\t    out: &mut [u8],\n     8\t    input: Option<&[u8]>,\n     9\t    ctx: &SpxCtx,\n    10\t    addr: &[u32],\n    11\t) where\n    12\t    [(); SPX_N + SPX_ADDR_BYTES + BLOCKS * SPX_N]: Sized,\n    13\t{\n    14\t    let input = input.unwrap_or(out);\n    15\t    let mut buf = vec![0u8; SPX_N + SPX_ADDR_BYTES + BLOCKS * SPX_N];\n    16\t    buf[..SPX_N].copy_from_slice(&ctx.pub_seed);\n    17\t    buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(&address_to_bytes(addr));\n    18\t    buf[SPX_N + SPX_ADDR_BYTES..].copy_from_slice(&input[..BLOCKS * SPX_N]);\n    19\t    if SPX_N >= 24 && BLOCKS > 1 {\n    20\t        out[..SPX_N].copy_from_slice(&blake512(&buf)[..SPX_N]);\n    21\t    } else {\n    22\t        out[..SPX_N].copy_from_slice(&blake256(&buf)[..SPX_N]);\n    23\t    }\n    24\t}\n    25\t\n     1\tuse crate::blake::*;\n     2\tuse crate::context::SpxCtx;\n     3\tuse crate::params::*;\n     4\tuse crate::utils::{address_to_bytes, bytes_to_ull};\n     5\t\n     6\tpub fn initialize_hash_function(ctx: &mut SpxCtx) {\n     7\t    let _ = ctx;\n     8\t}\n     9\t\n    10\tpub fn prf_addr(out: &mut [u8], ctx: &SpxCtx, addr: &mut [u32]) {\n    11\t    let mut buf = vec![0u8; 2 * SPX_N + SPX_ADDR_BYTES];\n    12\t    buf[..SPX_N].copy_from_slice(&ctx.pub_seed);\n    13\t    buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(&address_to_bytes(addr));\n    14\t    buf[SPX_N + SPX_ADDR_BYTES..].copy_from_slice(&ctx.sk_seed);\n    15\t\n    16\t    // Preserve the C source's truncated input length, which omits sk_seed.\n    17\t    let digest = blake256(&buf[..SPX_N + SPX_ADDR_BYTES]);\n    18\t    out[..SPX_N].copy_from_slice(&digest[..SPX_N]);\n    19\t}\n    20\t\n    21\tpub fn gen_message_random(\n    22\t    r: &mut [u8],\n    23\t    sk_prf: &[u8],\n    24\t    optrand: &[u8],\n    25\t    message: &[u8],\n    26\t    mlen: usize,\n    27\t    _ctx: &SpxCtx,\n    28\t) {\n    29\t    let digest = blakex_buggy(&[&sk_prf[..SPX_N], &optrand[..SPX_N], &message[..mlen]]);\n    30\t    r[..SPX_N].copy_from_slice(&digest[..SPX_N]);\n    31\t}\n    32\t\n    33\tpub fn hash_message(\n    34\t    digest: &mut [u8],\n    35\t    tree: &mut u64,\n    36\t    leaf_idx: &mut u32,\n    37\t    r: &[u8],\n    38\t    pk: &[u8],\n    39\t    message: &[u8],\n    40\t    mlen: usize,\n    41\t    _ctx: &SpxCtx,\n    42\t) {\n    43\t    let message_hash = blakex_buggy(&[\n    44\t        &r[..SPX_N],\n    45\t        &pk[..SPX_PK_BYTES],\n    46\t        &message[..mlen],\n    47\t    ]);\n    48\t    let mut seed = vec![0u8; 2 * SPX_N + message_hash.len()];\n    49\t    seed[..SPX_N].copy_from_slice(&r[..SPX_N]);\n    50\t    seed[SPX_N..2 * SPX_N].copy_from_slice(&pk[..SPX_N]);\n    51\t    seed[2 * SPX_N..].copy_from_slice(&message_hash);\n    52\t\n    53\t    let mut buf = vec![0u8; SPX_DGST_BYTES];\n    54\t    if SPX_N >= 24 {\n    55\t        blake512_mgf1(&mut buf, &seed);\n    56\t    } else {\n    57\t        blake256_mgf1(&mut buf, &seed);\n    58\t    }\n    59\t\n    60\t    digest[..SPX_FORS_MSG_BYTES].copy_from_slice(&buf[..SPX_FORS_MSG_BYTES]);\n    61\t    let mut offset = SPX_FORS_MSG_BYTES;\n    62\t    *tree = bytes_to_ull(&buf[offset..], SPX_TREE_BYTES);\n    63\t    *tree &= u64::MAX >> (64 - SPX_TREE_BITS);\n    64\t    offset += SPX_TREE_BYTES;\n    65\t    *leaf_idx = bytes_to_ull(&buf[offset..], SPX_LEAF_BYTES) as u32;\n    66\t    *leaf_idx &= u32::MAX >> (32 - SPX_LEAF_BITS);\n    67\t}\n","exit_code":0,"status":"completed"}}
