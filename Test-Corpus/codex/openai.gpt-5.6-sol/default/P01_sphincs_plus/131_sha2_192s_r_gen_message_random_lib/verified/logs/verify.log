_parts_mut(root, SPX_N) };\n   749\t    let auth = unsafe {\n   750\t        std::slice::from_raw_parts_mut(auth_path, tree_height as usize * SPX_N)\n   751\t    };\n   752\t    let ctx_ref = unsafe { &*ctx };\n   753\t    let addr = unsafe { std::slice::from_raw_parts_mut(tree_addr, 8) };\n   754\t    let mut stack = vec![0u8; (tree_height as usize + 1) * SPX_N];\n   755\t    let mut heights = vec![0u32; tree_height as usize + 1];\n   756\t    let mut offset = 0usize;\n   757\t    let callback = gen_leaf.expect(\"treehash requires a leaf callback\");\n   758\t\n   759\t    for idx in 0..(1u32 << tree_height) {\n   760\t        unsafe {\n   761\t            callback(\n   762\t                stack.as_mut_ptr().add(offset * SPX_N),\n   763\t                ctx,\n   764\t                idx + idx_offset,\n   765\t                tree_addr,\n   766\t            )\n   767\t        };\n   768\t        offset += 1;\n   769\t        heights[offset - 1] = 0;\n   770\t        if (leaf_idx ^ 1) == idx {\n   771\t            auth[..SPX_N].copy_from_slice(&stack[(offset - 1) * SPX_N..offset * SPX_N]);\n   772\t        }\n   773\t        while offset >= 2 && heights[offset - 1] == heights[offset - 2] {\n   774\t            let height = heights[offset - 1];\n   775\t            let tree_idx = idx >> (height + 1);\n   776\t            crate::address::set_tree_height(addr, height + 1);\n   777\t            crate::address::set_tree_index(\n   778\t                addr,\n   779\t                tree_idx + (idx_offset >> (height + 1)),\n   780\t            );\n   781\t            let start = (offset - 2) * SPX_N;\n   782\t            let input = stack[start..start + 2 * SPX_N].to_vec();\n   783\t            thash_inner(&mut stack[start..start + SPX_N], &input, 2, ctx_ref, addr);\n   784\t            offset -= 1;\n   785\t            heights[offset - 1] += 1;\n   786\t            let new_height = heights[offset - 1];\n   787\t            if ((leaf_idx >> new_height) ^ 1) == tree_idx {\n   788\t                let auth_start = new_height as usize * SPX_N;\n   789\t                auth[auth_start..auth_start + SPX_N]\n   790\t                    .copy_from_slice(&stack[(offset - 1) * SPX_N..offset * SPX_N]);\n   791\t            }\n   792\t        }\n   793\t    }\n   794\t    root.copy_from_slice(&stack[..SPX_N]);\n   795\t}\n   796\t\n   797\tfn treehash_x1<F>(\n   798\t    root: &mut [u8],\n   799\t    auth: &mut [u8],\n   800\t    ctx: &SpxCtx,\n   801\t    leaf_idx: u32,\n   802\t    idx_offset: u32,\n   803\t    tree_height: u32,\n   804\t    tree_addr: &mut [u32],\n   805\t    mut gen_leaf: F,\n   806\t) where\n   807\t    F: FnMut(&mut [u8], u32),\n   808\t{\n   809\t    let mut stack = vec![0u8; tree_height as usize * SPX_N];\n   810\t    let max_idx = (1u32 << tree_height) - 1;\n   811\t    for idx in 0.. {\n   812\t        let mut current = vec![0u8; 2 * SPX_N];\n   813\t        gen_leaf(&mut current[SPX_N..], idx + idx_offset);\n   814\t        let mut internal_idx_offset = idx_offset;\n   815\t        let mut internal_idx = idx;\n   816\t        let mut internal_leaf = leaf_idx;\n   817\t        let mut height = 0u32;\n   818\t        loop {\n   819\t            if height == tree_height {\n   820\t                root.copy_from_slice(&current[SPX_N..]);\n   821\t                return;\n   822\t            }\n   823\t            let start = height as usize * SPX_N;\n   824\t            if (internal_idx ^ internal_leaf) == 1 {\n   825\t                auth[start..start + SPX_N].copy_from_slice(&current[SPX_N..]);\n   826\t            }\n   827\t            if internal_idx & 1 == 0 && idx < max_idx {\n   828\t                break;\n   829\t            }\n   830\t            internal_idx_offset >>= 1;\n   831\t            crate::address::set_tree_height(tree_addr, height + 1);\n   832\t            crate::address::set_tree_index(\n   833\t                tree_addr,\n   834\t                internal_idx / 2 + internal_idx_offset,\n   835\t            );\n   836\t            current[..SPX_N].copy_from_slice(&stack[start..start + SPX_N]);\n   837\t            let input = current.clone();\n   838\t            thash_inner(&mut current[SPX_N..], &input, 2, ctx, tree_addr);\n   839\t            height += 1;\n   840\t            internal_idx >>= 1;\n   841\t            internal_leaf >>= 1;\n   842\t        }\n   843\t        let start = height as usize * SPX_N;\n   844\t        stack[start..start + SPX_N].copy_from_slice(&current[SPX_N..]);\n   845\t    }\n   846\t}\n   847\t\n   848\t#[unsafe(no_mangle)]\n   849\tpub unsafe extern \"C\" fn SPX_wots_treehashx1(\n   850\t    root: *mut u8,\n   851\t    auth_path: *mut u8,\n   852\t    ctx: *const SpxCtx,\n   853\t    leaf_idx: u32,\n   854\t    idx_offset: u32,\n   855\t    tree_height: u32,\n   856\t    tree_addr: *mut u32,\n   857\t    info: *mut CLeafInfoX1,\n   858\t) {\n   859\t    let c_info = unsafe { &mut *info };\n   860\t    let mut rust_info = import_leaf_info(c_info);\n   861\t    let ctx_ref = unsafe { &*ctx };\n   862\t    let addr = unsafe { std::slice::from_raw_parts_mut(tree_addr, 8) };\n   863\t    treehash_x1(\n   864\t        unsafe { std::slice::from_raw_parts_mut(root, SPX_N) },\n   865\t        unsafe {\n   866\t            std::slice::from_raw_parts_mut(auth_path, tree_height as usize * SPX_N)\n   867\t        },\n   868\t        ctx_ref,\n   869\t        leaf_idx,\n   870\t        idx_offset,\n   871\t        tree_height,\n   872\t        addr,\n   873\t        |leaf, idx| crate::wotsx1::wots_gen_leafx1(leaf, ctx_ref, idx, &mut rust_info),\n   874\t    );\n   875\t    export_wots_signature(c_info, &rust_info);\n   876\t}\n   877\t\n   878\t#[unsafe(no_mangle)]\n   879\tpub unsafe extern \"C\" fn SPX_fors_treehashx1(\n   880\t    root: *mut u8,\n   881\t    auth_path: *mut u8,\n   882\t    ctx: *const SpxCtx,\n   883\t    leaf_idx: u32,\n   884\t    idx_offset: u32,\n   885\t    tree_height: u32,\n   886\t    tree_addr: *mut u32,\n   