   296\t    addr: *const u32,\n   297\t) {\n   298\t    crate::hash::prf_addr(\n   299\t        unsafe { std::slice::from_raw_parts_mut(out, SPX_N) },\n   300\t        unsafe { &*ctx },\n   301\t        unsafe { std::slice::from_raw_parts_mut(addr as *mut u32, 8) },\n   302\t    );\n   303\t}\n   304\t\n   305\t#[unsafe(no_mangle)]\n   306\tpub unsafe extern \"C\" fn SPX_gen_message_random(\n   307\t    out: *mut u8,\n   308\t    sk_prf: *const u8,\n   309\t    optrand: *const u8,\n   310\t    message: *const u8,\n   311\t    mlen: u64,\n   312\t    ctx: *const SpxCtx,\n   313\t) {\n   314\t    crate::hash::gen_message_random(\n   315\t        unsafe { std::slice::from_raw_parts_mut(out, SPX_N) },\n   316\t        unsafe { std::slice::from_raw_parts(sk_prf, SPX_N) },\n   317\t        unsafe { std::slice::from_raw_parts(optrand, SPX_N) },\n   318\t        unsafe { std::slice::from_raw_parts(message, mlen as usize) },\n   319\t        mlen as usize,\n   320\t        unsafe { &*ctx },\n   321\t    );\n   322\t}\n   323\t\n   324\t#[unsafe(no_mangle)]\n   325\tpub unsafe extern \"C\" fn SPX_hash_message(\n   326\t    digest: *mut u8,\n   327\t    tree: *mut u64,\n   328\t    leaf_idx: *mut u32,\n   329\t    r: *const u8,\n   330\t    pk: *const u8,\n   331\t    message: *const u8,\n   332\t    mlen: u64,\n   333\t    ctx: *const SpxCtx,\n   334\t) {\n   335\t    crate::hash::hash_message(\n   336\t        unsafe { std::slice::from_raw_parts_mut(digest, SPX_FORS_MSG_BYTES) },\n   337\t        unsafe { &mut *tree },\n   338\t        unsafe { &mut *leaf_idx },\n   339\t        unsafe { std::slice::from_raw_parts(r, SPX_N) },\n   340\t        unsafe { std::slice::from_raw_parts(pk, SPX_PK_BYTES) },\n   341\t        unsafe { std::slice::from_raw_parts(message, mlen as usize) },\n   342\t        mlen as usize,\n   343\t        unsafe { &*ctx },\n   344\t    );\n   345\t}\n   346\t\n   347\tfn thash_inner(\n   348\t    out: &mut [u8],\n   349\t    input: &[u8],\n   350\t    blocks: usize,\n   351\t    ctx: &SpxCtx,\n   352\t    addr: &[u32],\n   353\t) {\n   354\t    if blocks == 1 {\n   355\t        crate::thash::thash::<1>(out, Some(input), ctx, addr);\n   356\t    } else if blocks == 2 {\n   357\t        crate::thash::thash::<2>(out, Some(input), ctx, addr);\n   358\t    } else if blocks == SPX_WOTS_LEN {\n   359\t        crate::thash::thash::<SPX_WOTS_LEN>(out, Some(input), ctx, addr);\n   360\t    } else if blocks == SPX_FORS_TREES {\n   361\t        crate::thash::thash::<SPX_FORS_TREES>(out, Some(input), ctx, addr);\n   362\t    } else {\n   363\t        panic!(\"unsupported thash block count {blocks}\");\n   364\t    }\n   365\t}\n   366\t\n   367\tfn thash_dynamic(\n   368\t    out: &mut [u8],\n   369\t    input: &[u8],\n   370\t    blocks: usize,\n   371\t    ctx: &SpxCtx,\n   372\t    addr: &[u32],\n   373\t) {\n   374\t    let input_len = blocks * SPX_N;\n   375\t    let addr_bytes = crate::utils::address_to_bytes(addr);\n   376\t\n   377\t    #[cfg(feature = \"haraka\")]\n   378\t    {\n   379\t        if blocks == 1 {\n   380\t            let mut outbuf = [0u8; 32];\n   381\t            let mut block = [0u8; 64];\n   382\t            block[..SPX_ADDR_BYTES].copy_from_slice(&addr_bytes);\n   383\t            #[cfg(feature = \"robust\")]\n   384\t            {\n   385\t                crate::haraka::haraka256(&mut outbuf, &block, ctx);\n   386\t                for i in 0..SPX_N {\n   387\t                    block[SPX_ADDR_BYTES + i] = input[i] ^ outbuf[i];\n   388\t                }\n   389\t            }\n   390\t            #[cfg(feature = \"simple\")]\n   391\t            block[SPX_ADDR_BYTES..SPX_ADDR_BYTES + SPX_N]\n   392\t                .copy_from_slice(&input[..SPX_N]);\n   393\t            crate::haraka::haraka512(&mut outbuf, &block, ctx);\n   394\t            out.copy_from_slice(&outbuf[..SPX_N]);\n   395\t        } else {\n   396\t            let mut buf = vec![0u8; SPX_ADDR_BYTES + input_len];\n   397\t            buf[..SPX_ADDR_BYTES].copy_from_slice(&addr_bytes);\n   398\t            #[cfg(feature = \"robust\")]\n   399\t            {\n   400\t                let mut bitmask = vec![0u8; input_len];\n   401\t                crate::haraka::haraka_s(\n   402\t                    &mut bitmask,\n   403\t                    input_len,\n   404\t                    &buf,\n   405\t                    SPX_ADDR_BYTES,\n   406\t                    ctx,\n   407\t                );\n   408\t                for i in 0..input_len {\n   409\t                    buf[SPX_ADDR_BYTES + i] = input[i] ^ bitmask[i];\n   410\t                }\n   411\t            }\n   412\t            #[cfg(feature = \"simple\")]\n   413\t            buf[SPX_ADDR_BYTES..].copy_from_slice(input);\n   414\t            crate::haraka::haraka_s(\n   415\t                out,\n   416\t                SPX_N,\n   417\t                &buf,\n   418\t                SPX_ADDR_BYTES + input_len,\n   419\t                ctx,\n   420\t            );\n   421\t        }\n   422\t    }\n   423\t\n   424\t    #[cfg(feature = \"sha2\")]\n   425\t    {\n   426\t        let addr_len = crate::sha2::SPX_SHA256_ADDR_BYTES;\n   427\t        let mut hash_input = vec![0u8; addr_len + input_len];\n   428\t        hash_input[..addr_len].copy_from_slice(&addr_bytes[..addr_len]);\n   429\t        #[cfg(feature = \"robust\")]\n   430\t        {\n   431\t            let mut mgf_input = vec![0u8; SPX_N + addr_len];\n   432\t            mgf_input[..SPX_N].copy_from_slice(&ctx.pub_seed);\n   433\t            mgf_input[SPX_N..].copy_from_slice(&addr_bytes[..addr_len]);\n   434\t            let mut bitmask = vec![0u8; input_len];\n   435\t            #[cfg(any(feature = \"128f\", feature = \"128s\"))]\n   436\t            crate::sha2::mgf1_256(&mut bitmask, input_len, &mgf_input);\n   437\t            #[cfg(not(any(feature = \"128f\", feature = \"128s\")))]\n   438\t            if blocks > 1 {\n   439\t                crate::sha2::mgf1_512(&mut bitmask, input_len, &mgf_input);\n   440\t            } else {\n   441\t                crate::sha2::mgf1_256(&mut bitmask, input_len, &mgf_input);\n   442\t            }\n   443\t            for i in 0..input_len {\n   444\t                hash_input[addr_len + i] = input[i] ^ bitmask[i];\n   445\t            }\n   446\t        }\n   447\t        #[cfg(feature = \"simple\")]\n   448\t        hash_input[addr_len..].copy_from_slice(input);\n   449\t\n   450\t        #[cfg(not(any(feature = \"128f\", feature = \"128s\")))]\n   451\t        if blocks > 1 {\n   452\t            let mut state = ctx.state_seeded_512;\n   453\t            let mut digest = [0u8; 64];\n   454\t            crate::sha2::sha512_inc_finalize(\n   455\t                &mut digest,\n   456\t                &mut state,\n   457\t                &hash_input,\n   458\t                hash_input.len(),\n   459\t            );\n   460\t            out.copy_from_slice(&digest[..SPX_N]);\n   461\t            return;\n   462\t        }\n   463\t        let mut state = ctx.state_seeded;\n   464\t        let mut digest = [0u8; 32];\n   465\t        crate::sha2::sha256_inc_finalize(\n   466\t            &mut digest,\n   467\t            &mut state,\n   468\t            &hash_input,\n   469\t            hash_input.len(),\n   470\t        );\n   471\t        out.copy_from_slice(&digest[..SPX_N]);\n   472\t    }\n   473\t\n   474\t    #[cfg(feature = \"shake\")]\n   475\t    {\n   476\t        let prefix_len = SPX_N + SPX_ADDR_BYTES;\n   477\t        let mut buf = vec![0u8; prefix_len + input_len];\n   478\t        buf[..SPX_N].copy_from_slice(&ctx.pub_seed);\n   479\t        buf[SPX_N..prefix_len].copy_from_slice(&addr_bytes);\n   480\t        #[cfg(feature = \"robust\")]\n   481\t        {\n   482\t            let mut bitmask = vec![0u8; input_len];\n   483\t            crate::fips202::shake256(&mut bitmask, &buf[..prefix_len]);\n   484\t            for i in 0..input_len {\n   485\t                buf[prefix_len + i] = input[i] ^ bitmask[i];\n   486\t            }\n   487\t        }\n   488\t        #[cfg(feature = \"simple\")]\n   489\t        buf[prefix_len..].copy_from_slice(input);\n   490\t        crate::fips202::shake256(out, &buf);\n   491\t    }\n   492\t\n   493\t    #[cfg(feature = \"blake\")]\n   494\t    {\n   495\t        let prefix_len = SPX_N + SPX_ADDR_BYTES;\n   496\t        let mut buf = vec![0u8; prefix_len + input_len];\n   497\t        buf[..SPX_N].copy_from_slice(&ctx.pub_seed);\n   498\t        buf[SPX_N..prefix_len].copy_from_slice(&addr_bytes);\n   499\t        #[cfg(feature = \"robust\")]\n   500\t        {\n   501\t            let mut bitmask = vec![0u8; input_len];\n   502\t            if SPX_N >= 24 && blocks > 1 {\n   503\t                crate::blake::blake512_mgf1(&mut bitmask, &buf[..prefix_len]);\n   504\t            } else {\n   505\t                crate::blake::blake256_mgf1(&mut bitmask, &buf[..prefix_len]);\n   506\t            }\n   507\t            for i in 0..input_len {\n   508\t                buf[prefix_len + i] = input[i] ^ bitmask[i];\n   509\t            }\n   510\t        }\n   511\t        #[cfg(feature = \"simple\")]\n   512\t        buf[prefix_len..].copy_from_slice(input);\n   513\t        let digest_input = if cfg!(feature = \"robust\") {\n   514\t            &buf[SPX_N..]\n   515\t        } else {\n   516\t            &buf\n   517\t        };\n   518\t        if SPX_N >= 24 && blocks > 1 {\n   519\t            out.copy_from_slice(&crate::blake::blake512(digest_input)[..SPX_N]);\n   520\t        } else {\n   521\t            out.copy_from_slice(&crate::blake::blake256(digest_input)[..SPX_N]);\n   522\t        }\n   523\t    }\n   524\t}\n   525\t\n   526\t#[unsafe(no_mangle)]\n   527\tpub unsafe extern \"C\" fn SPX_thash(\n   528\t    out: *mut u8,\n   529\t    input: *const u8,\n   530\t    inblocks: u32,\n   531\t    ctx: *const SpxCtx,\n   532\t    addr: *mut u32,\n   533\t) {\n   534\t    let blocks = inblocks as usize;\n   535\t    let input_len = blocks * SPX_N;\n   536\t    let input = if input_len == 0 {\n   537\t        Vec::new()\n   538\t    } else {\n   539\t        unsafe { std::slice::from_raw_parts(input, input_len) }.to_vec()\n   540\t    };\n   541\t    thash_dynamic(\n   542\t        unsafe { std::slice::from_raw_parts_mut(out, SPX_N) },\n   543\t        &input,\n   544\t        blocks,\n   545\t        unsafe { &*ctx },\n   546\t        unsafe { std::slice::from_raw_parts(addr, 8) },\n   547\t    );\n   548\t}\n   549\t\n   550\t#[unsafe(no_mangle)]\n   551\tpub unsafe extern \"C\" fn SPX_chain_lengths(lengths: *mut u32, message: *const u8) {\n   552\t    crate::wots::chain_lengths(\n   553\t        unsafe { std::slice::from_raw_parts_mut(lengths, SPX_WOTS_LEN) },\n   554\t        unsafe { std::slice::from_raw_parts(message, SPX_N) },\n   555\t    );\n   556\t}\n   557\t\n   558\t#[unsafe(no_mangle)]\n   559\tpub unsafe extern \"C\" fn SPX_wots_pk_from_sig(\n   560\t    pk: *mut u8,\n   561\t    sig: *const u8,\n   562\t    message: *const u8,\n   563\t    ctx: *const SpxCtx,\n   564\t    addr: *mut u32,\n   565\t) {\n   566\t    crate::wots::wots_pk_from_sig(\n   567\t        unsafe { std::slice::from_raw_parts_mut(pk, SPX_WOTS_BYTES) },\n   568\t        unsafe { std::slice::from_raw_parts(sig, SPX_WOTS_BYTES) },\n   569\t        unsafe { std::slice::from_raw_parts(message, SPX_N) },\n   570\t        unsafe { &*ctx },\n   571\t        unsafe { std::slice::from_raw_parts_mut(addr, 8) },\n   572\t    );\n   573\t}\n   574\t\n   575\t#[unsafe(no_mangle)]\n   576\tpub unsafe extern \"C\" fn SPX_compute_root(\n   577\t    root: *mut u8,\n   578\t    leaf: *const u8,\n   579\t    leaf_idx: u32,\n   580\t    idx_offset: u32,\n   581\t    auth_path: *const u8,\n   582\t    tree_height: u32,\n   583\t    ctx: *const SpxCtx,\n   584\t    addr: *mut u32,\n   585\t) {\n   586\t    crate::utils::compute_root(\n   587\t        unsafe { std::slice::from_raw_parts_mut(root, SPX_N) },\n   588\t        unsafe { std::slice::from_raw_parts(leaf, SPX_N) },\n   589\t        leaf_idx,\n   590\t        idx_offset,\n   591\t        unsafe { std::slice::from_raw_parts(auth_path, tree_height as usize * SPX_N) },\n   592\t        tree_height,\n   593\t        unsafe { &*ctx },\n   594\t        unsafe { &mut *(addr as *mut [u32; 8]) },\n   595\t    );\n   596\t}\n   597\t\n   598\t#[unsafe(no_mangle)]\n   599\tpub unsafe extern \"C\" fn SPX_fors_sign(\n   600\t    sig: *mut u8,\n   601\t    pk: *mut u8,\n   602\t    message: *const u8,\n   603\t    ctx: *const SpxCtx,\n   604\t    addr: *const u32,\n   605\t) {\n   606\t    crate::fors::fors_sign(\n   607\t        unsafe { std::slice::from_raw_parts_mut(sig, SPX_FORS_BYTES) },\n   608\t        unsafe { std::slice::from_raw_parts_mut(pk, SPX_N) },\n   609\t        unsafe { std::slice::from_raw_parts(message, SPX_FORS_MSG_BYTES) },\n   610\t        unsafe { &*ctx },\n   611\t        unsafe { std::slice::from_raw_parts_mut(addr as *mut u32, 8) },\n   612\t    );\n   613\t}\n   614\t\n   615\t#[unsafe(no_mangle)]\n   616\tpub unsafe extern \"C\" fn SPX_fors_pk_from_sig(\n   617\t    pk: *mut u8,\n   618\t    sig: *const u8,\n   619\t    message: *const u8,\n   620\t    ctx: *const SpxCtx,\n   621\t    addr: *const u32,\n   622\t) {\n   623\t    crate::fors::fors_pk_from_sig(\n   624\t        unsafe { std::slice::from_raw_parts_mut(pk, SPX_N) },\n   625\t        unsafe { std::slice::from_raw_parts(sig, SPX_FORS_BYTES) },\n   626\t        unsafe { std::slice::from_raw_parts(message, SPX_FORS_MSG_BYTES) },\n   627\t        unsafe { &*ctx },\n   628\t        unsafe { std::slice::from_raw_parts_mut(addr as *mut u32, 8) },\n   629\t    );\n   630\t}\n   631\t\n   632\t#[unsafe(no_mangle)]\n   633\tpub unsafe extern \"C\" fn SPX_merkle_sign(\n   634\t    sig: *mut u8,\n   635\t    root: *mut u8,\n   636\t    ctx: *const SpxCtx,\n   637\t    wots_addr: *mut u32,\n   638\t    tree_addr: *mut u32,\n   639\t    idx_leaf: u32,\n   640\t) {\n   641\t    crate::merkle::merkle_sign(\n   642\t        unsafe {\n   643\t            std::slice::from_raw_parts_mut(\n   644\t                sig,\n   645\t                SPX_WOTS_BYTES + SPX_TREE_HEIGHT * SPX_N,\n   646\t            )\n   647\t        },\n   648\t        unsafe { std::slice::from_raw_parts_mut(root, SPX_N) },\n   649\t        unsafe { &*ctx },\n   650\t        unsafe { std::slice::from_raw_parts_mut(wots_addr, 8) },\n   651\t        unsafe { std::slice::from_raw_parts_mut(tree_addr, 8) },\n   652\t        idx_leaf,\n   653\t    );\n   654\t}\n   655\t\n   656\t#[unsafe(no_mangle)]\n   657\tpub unsafe extern \"C\" fn SPX_merkle_gen_root(root: *mut u8, ctx: *const SpxCtx) {\n   658\t    crate::merkle::merkle_gen_root(\n   659\t        unsafe { std::slice::from_raw_parts_mut(root, SPX_N) },\n   660\t        unsafe { &*ctx },\n   661\t    );\n   662\t}\n   663\t\n   664\t#[repr(C)]\n   665\tpub struct CLeafInfoX1 {\n   666\t    wots_sig: *mut u8,\n   667\t    wots_sign_leaf: u32,\n   668\t    wots_steps: *mut u32,\n   669\t    leaf_addr: [u32; 8],\n   670\t    pk_addr: [u32; 8],\n   671\t}\n   672\t\n   673\tfn import_leaf_info(info: &CLeafInfoX1) -> crate::wotsx1::LeafInfoX1 {\n   674\t    let mut rust_info = crate::wotsx1::LeafInfoX1::default();\n   675\t    rust_info.wots_sign_leaf = info.wots_sign_leaf;\n   676\t    rust_info.leaf_addr = info.leaf_addr;\n   677\t    rust_info.pk_addr = info.pk_addr;\n   678\t    if !info.wots_steps.is_null() {\n   679\t        rust_info.wots_steps.copy_from_slice(unsafe {\n   680\t            std::slice::from_raw_parts(info.wots_steps, SPX_WOTS_LEN)\n   681\t        });\n   682\t    }\n   683\t    rust_info\n   684\t}\n   685\t\n   686\tfn export_wots_signature(info: &CLeafInfoX1, rust_info: &crate::wotsx1::LeafInfoX1) {\n   687\t    if !info.wots_sig.is_null() {\n   688\t        unsafe {\n   689\t            std::ptr::copy_nonoverlapping(\n   690\t                rust_info.wots_sig.as