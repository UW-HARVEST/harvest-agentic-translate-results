{"type":"item.started","item":{"id":"item_124","type":"command_execution","command":"/bin/zsh -lc 'set -u\nlog=target/final-matrix.log\nmkdir -p target/symbol-tmp\n: > \"$log\"\npassed=0\nfailed=0\nfor backend in haraka sha2 shake blake; do\n  for variant in robust simple; do\n    for param in 128s 128f 192s 192f 256s 256f; do\n      combo=\"$backend,$variant,$param\"\n      tuple=\"$backend-$variant-$param\"\n      printf '\"'=== %s ===\\\\n' \\\"\"'$combo\" | tee -a \"$log\"\n      if ! timeout 600 cargo build --release --lib --no-default-features --features \"$combo\" >>\"$log\" 2>&1 || ! timeout 600 cargo test --release --no-default-features --features \"$combo\" --test differential -- --test-threads=1 >>\"$log\" 2>&1; then\n        printf '\"'TEST_FAIL %s\\\\n' \\\"\"'$combo\" | tee -a \"$log\"\n        failed=$((failed+1)); tail -80 \"$log\"; break 3\n      fi\n      nm -D --defined-only \"target/c-ref/$tuple/lib/$backend/lib$backend.so\" \"target/c-ref/$tuple/app/libsphincs_core.so\" \"target/c-ref/$tuple/app/libsphincs_core_det.so\" | awk '\"'NF>=3 && \"'$2 ~ /''^[A-TV-Z]$/ {print $3}'\"' | sort -u > target/symbol-tmp/c\n      nm -D --defined-only target/release/libsphincs_plus.so | awk 'NF>=3 && \"'$2 ~ /''^[A-TV-Z]$/ {print $3}'\"' | sort -u > target/symbol-tmp/r\n      comm -23 target/symbol-tmp/c target/symbol-tmp/r > target/symbol-tmp/missing\n      if test -s target/symbol-tmp/missing; then\n        printf 'SYMBOL_FAIL %s\\\\n' \\\"\"'$combo\" | tee -a \"$log\"\n        tee -a \"$log\" < target/symbol-tmp/missing\n        failed=$((failed+1)); break 3\n      fi\n      passed=$((passed+1))\n      printf '\"'PASS %s symbols_missing=0\\\\n' \\\"\"'$combo\" | tee -a \"$log\"\n    done\n  done\ndone\nprintf '\"'TOTAL_PASSED=%d TOTAL_FAILED=%d\\\\n' \\\"\"'$passed\" \"$failed\" | tee -a \"$log\"\ntest \"$passed\" -eq 48 && test \"$failed\" -eq 0'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
