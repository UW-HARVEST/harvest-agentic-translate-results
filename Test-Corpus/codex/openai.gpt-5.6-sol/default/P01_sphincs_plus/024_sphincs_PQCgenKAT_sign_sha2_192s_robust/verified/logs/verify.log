{"type":"item.completed","item":{"id":"item_108","type":"command_execution","command":"/bin/zsh -lc \"sed -n '500,710p' tests/differential.rs && sed -n '1,180p' ERRORS.md && sed -n '45,125p' CONFIGS.md\"","aggregated_output":"            rng.fill(&mut seed);\n            seed[0] ^= case;\n            let mut cpk = vec![0u8; p.pk_bytes()];\n            let mut rpk = vec![0u8; p.pk_bytes()];\n            let mut csk = vec![0u8; p.sk_bytes()];\n            let mut rsk = vec![0u8; p.sk_bytes()];\n            assert_eq!(r(rpk.as_mut_ptr(), rsk.as_mut_ptr(), seed.as_ptr()),\n                       c(cpk.as_mut_ptr(), csk.as_mut_ptr(), seed.as_ptr()));\n            assert_eq!(rpk, cpk, \"public key case {case}\");\n            assert_eq!(rsk, csk, \"secret key case {case}\");\n        }\n    }\n}\n\n#[test]\nfn explicit_signature_error_paths_match() {\n    unsafe {\n        let libs = Libraries::load();\n        let p = Params::current();\n        type Verify =\n            unsafe extern \"C\" fn(*const u8, usize, *const u8, usize, *const u8) -> i32;\n        type Open =\n            unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32;\n        let cv: libloading::os::unix::Symbol<Verify> =\n            libs.core.get(b\"crypto_sign_verify\\0\").unwrap();\n        let rv: libloading::os::unix::Symbol<Verify> =\n            libs.rust.get(b\"crypto_sign_verify\\0\").unwrap();\n        let co: libloading::os::unix::Symbol<Open> =\n            libs.core.get(b\"crypto_sign_open\\0\").unwrap();\n        let ro: libloading::os::unix::Symbol<Open> =\n            libs.rust.get(b\"crypto_sign_open\\0\").unwrap();\n        let sig = vec![0u8; p.sig_bytes() + 1];\n        let pk = vec![0u8; p.pk_bytes()];\n        let message = [0x5au8; 3];\n        for len in [0, p.sig_bytes() - 1, p.sig_bytes() + 1] {\n            assert_eq!(\n                rv(sig.as_ptr(), len, message.as_ptr(), message.len(), pk.as_ptr()),\n                cv(sig.as_ptr(), len, message.as_ptr(), message.len(), pk.as_ptr()),\n                \"siglen={len}\",\n            );\n        }\n        for smlen in [0usize, 1, p.sig_bytes() - 1] {\n            let signed = vec![0x33u8; smlen.max(1)];\n            let mut cm = vec![0xa5u8; smlen + 8];\n            let mut rm = cm.clone();\n            let (mut cmlen, mut rmlen) = (u64::MAX, u64::MAX);\n            let cr = co(\n                cm.as_mut_ptr(), &mut cmlen, signed.as_ptr(), smlen as u64, pk.as_ptr(),\n            );\n            let rr = ro(\n                rm.as_mut_ptr(), &mut rmlen, signed.as_ptr(), smlen as u64, pk.as_ptr(),\n            );\n            assert_eq!((rr, rmlen), (cr, cmlen), \"smlen={smlen}\");\n            assert_eq!(rm, cm, \"zeroing smlen={smlen}\");\n        }\n    }\n}\n\n#[repr(C)]\n#[derive(Clone, Debug, PartialEq, Eq)]\nstruct AesXof {\n    buffer: [u8; 16],\n    buffer_pos: usize,\n    length_remaining: usize,\n    key: [u8; 32],\n    ctr: [u8; 16],\n}\n\nimpl Default for AesXof {\n    fn default() -> Self {\n        Self {\n            buffer: [0; 16],\n            buffer_pos: 0,\n            length_remaining: 0,\n            key: [0; 32],\n            ctr: [0; 16],\n        }\n    }\n}\n\n#[test]\nfn deterministic_rng_signing_and_rng_errors_match() {\n    unsafe {\n        let libs = Libraries::load();\n        let (_crypto, det) = load_deterministic_core(&libs);\n        let p = Params::current();\n        type Init = unsafe extern \"C\" fn(*mut u8, *mut u8);\n        type Random = unsafe extern \"C\" fn(*mut u8, u64) -> i32;\n        type Aes = unsafe extern \"C\" fn(*mut u8, *mut u8, *mut u8);\n        type Update = unsafe extern \"C\" fn(*mut u8, *mut u8, *mut u8);\n        type ExpInit =\n            unsafe extern \"C\" fn(*mut AesXof, *mut u8, *mut u8, usize) -> i32;\n        type Exp = unsafe extern \"C\" fn(*mut AesXof, *mut u8, usize) -> i32;\n        let ci: libloading::os::unix::Symbol<Init> =\n            det.get(b\"randombytes_init\\0\").unwrap();\n        let ri: libloading::os::unix::Symbol<Init> =\n            libs.rust.get(b\"randombytes_init\\0\").unwrap();\n        let cr: libloading::os::unix::Symbol<Random> =\n            det.get(b\"randombytes\\0\").unwrap();\n        let rr: libloading::os::unix::Symbol<Random> =\n            libs.rust.get(b\"randombytes\\0\").unwrap();\n        let ca: libloading::os::unix::Symbol<Aes> = det.get(b\"AES256_ECB\\0\").unwrap();\n        let ra: libloading::os::unix::Symbol<Aes> =\n            libs.rust.get(b\"AES256_ECB\\0\").unwrap();\n        let cu: libloading::os::unix::Symbol<Update> =\n            det.get(b\"AES256_CTR_DRBG_Update\\0\").unwrap();\n        let ru: libloading::os::unix::Symbol<Update> =\n            libs.rust.get(b\"AES256_CTR_DRBG_Update\\0\").unwrap();\n        let cei: libloading::os::unix::Symbol<ExpInit> =\n            det.get(b\"seedexpander_init\\0\").unwrap();\n        let rei: libloading::os::unix::Symbol<ExpInit> =\n            libs.rust.get(b\"seedexpander_init\\0\").unwrap();\n        let ce: libloading::os::unix::Symbol<Exp> =\n            det.get(b\"seedexpander\\0\").unwrap();\n        let re: libloading::os::unix::Symbol<Exp> =\n            libs.rust.get(b\"seedexpander\\0\").unwrap();\n        let mut rng = Prng::new();\n        let mut entropy = [0u8; 48];\n        let mut personalization = [0u8; 48];\n        rng.fill(&mut entropy);\n        rng.fill(&mut personalization);\n\n        for personal in [false, true] {\n            let ptr = if personal {\n                personalization.as_mut_ptr()\n            } else {\n                std::ptr::null_mut()\n            };\n            ci(entropy.as_mut_ptr(), ptr);\n            let mut co = vec![0u8; 81];\n            assert_eq!(cr(co.as_mut_ptr(), co.len() as u64), 0);\n            ri(entropy.as_mut_ptr(), ptr);\n            let mut ro = vec![0u8; 81];\n            assert_eq!(rr(ro.as_mut_ptr(), ro.len() as u64), 0);\n            assert_eq!(ro, co, \"personalization={personal}\");\n        }\n\n        for _ in 0..32 {\n            let mut key = [0u8; 32];\n            let mut ctr = [0u8; 16];\n            rng.fill(&mut key);\n            rng.fill(&mut ctr);\n            let mut co = [0u8; 16];\n            let mut ro = [0u8; 16];\n            ca(key.as_mut_ptr(), ctr.as_mut_ptr(), co.as_mut_ptr());\n            ra(key.as_mut_ptr(), ctr.as_mut_ptr(), ro.as_mut_ptr());\n            assert_eq!(ro, co);\n\n            let mut ck = key;\n            let mut rk = key;\n            let mut cv = ctr;\n            let mut rv = ctr;\n            let mut provided = [0u8; 48];\n            rng.fill(&mut provided);\n            cu(provided.as_mut_ptr(), ck.as_mut_ptr(), cv.as_mut_ptr());\n            ru(provided.as_mut_ptr(), rk.as_mut_ptr(), rv.as_mut_ptr());\n            assert_eq!((rk, rv), (ck, cv));\n        }\n\n        let mut seed = [0u8; 32];\n        let mut diversifier = [0u8; 8];\n        rng.fill(&mut seed);\n        rng.fill(&mut diversifier);\n        let mut cx = AesXof::default();\n        let mut rx = AesXof::default();\n        assert_eq!(\n            rei(&mut rx, seed.as_mut_ptr(), diversifier.as_mut_ptr(), 100),\n            cei(&mut cx, seed.as_mut_ptr(), diversifier.as_mut_ptr(), 100),\n        );\n        assert_eq!(rx, cx);\n        let mut co = [0u8; 17];\n        let mut ro = [0u8; 17];\n        assert_eq!(re(&mut rx, ro.as_mut_ptr(), ro.len()),\n                   ce(&mut cx, co.as_mut_ptr(), co.len()));\n        assert_eq!((ro, &rx), (co, &cx));\n        assert_eq!(rei(&mut rx, seed.as_mut_ptr(), diversifier.as_mut_ptr(), 1usize << 32),\n                   cei(&mut cx, seed.as_mut_ptr(), diversifier.as_mut_ptr(), 1usize << 32));\n        assert_eq!(re(&mut rx, std::ptr::null_mut(), 1),\n                   ce(&mut cx, std::ptr::null_mut(), 1));\n        assert_eq!(rei(&mut rx, seed.as_mut_ptr(), diversifier.as_mut_ptr(), 9),\n                   cei(&mut cx, seed.as_mut_ptr(), diversifier.as_mut_ptr(), 9));\n        assert_eq!(re(&mut rx, ro.as_mut_ptr(), 9), ce(&mut cx, co.as_mut_ptr(), 9));\n\n        type SeedKeypair = unsafe extern \"C\" fn(*mut u8, *mut u8, *const u8) -> i32;\n        type Signature = unsafe extern \"C\" fn(\n            *mut u8, *mut usize, *const u8, usize, *const u8,\n        ) -> i32;\n        type Verify =\n            unsafe extern \"C\" fn(*const u8, usize, *const u8, usize, *const u8) -> i32;\n        let ckp: libloading::os::unix::Symbol<SeedKeypair> =\n            det.get(b\"crypto_sign_seed_keypair\\0\").unwrap();\n        let rkp: libloading::os::unix::Symbol<SeedKeypair> =\n            libs.rust.get(b\"crypto_sign_seed_keypair\\0\").unwrap();\n        let cs: libloading::os::unix::Symbol<Signature> =\n            det.get(b\"crypto_sign_signature\\0\").unwrap();\n        let rs: libloading::os::unix::Symbol<Signature> =\n            libs.rust.get(b\"crypto_sign_signature\\0\").unwrap();\n        let cv: libloading::os::unix::Symbol<Verify> =\n            det.get(b\"crypto_sign_verify\\0\").unwrap();\n        let rv: libloading::os::unix::Symbol<Verify> =\n            libs.rust.get(b\"crypto_sign_verify\\0\").unwrap();\n        let mut key_seed = vec![0u8; p.seed_bytes()];\n        rng.fill(&mut key_seed);\n        let mut cpk = vec![0u8; p.pk_bytes()];\n        let mut rpk = vec![0u8; p.pk_bytes()];\n        let mut csk = vec![0u8; p.sk_bytes()];\n        let mut rsk = vec![0u8; p.sk_bytes()];\n        assert_eq!(rkp(rpk.as_mut_ptr(), rsk.as_mut_ptr(), key_seed.as_ptr()),\n                   ckp(cpk.as_mut_ptr(), csk.as_mut_ptr(), key_seed.as_ptr()));\n        assert_eq!((&rpk, &rsk), (&cpk, &csk));\n        let mut message = vec![0u8; 65];\n# Error-surface table\n\nThis table comes from mechanical searches for negative/sentinel returns,\nnull/range checks, error constants, aborts, and compile-time `#error` guards.\nRows 1–7 are input-triggerable API rejections. Rows 8–10 are internal OpenSSL\nfatal paths in the deterministic RNG implementation.\n\n| # | function | trigger (the exact invalid input/condition) | expected C result |\n|---:|---|---|---|\n| 1 | `crypto_sign_verify` | `siglen != SPX_BYTES` | return `-1` before reading the signature |\n| 2 | `crypto_sign_verify` | reconstructed root differs from `pk + SPX_N` (`memcmp(...) != 0`) | return `-1` |\n| 3 | `crypto_sign_open` | `smlen < SPX_BYTES` | zero exactly `smlen` output bytes, set `*mlen = 0`, return `-1` |\n| 4 | `crypto_sign_open` | embedded `crypto_sign_verify(...)` returns nonzero | zero exactly `smlen` output bytes, set `*mlen = 0`, return `-1` |\n| 5 | `seedexpander_init` | `maxlen >= 0x100000000` | return `RNG_BAD_MAXLEN` (`-1`) |\n| 6 | `seedexpander` | output pointer `x == NULL` | return `RNG_BAD_OUTBUF` (`-2`) |\n| 7 | `seedexpander` | `xlen >= ctx->length_remaining` (equality is rejected) | return `RNG_BAD_REQ_LEN` (`-3`) without consuming bytes |\n| 8 | `AES256_ECB` | `EVP_CIPHER_CTX_new()` returns `NULL` | print OpenSSL errors and abort |\n| 9 | `AES256_ECB` | `EVP_EncryptInit_ex(...) != 1` | print OpenSSL errors and abort |\n| 10 | `AES256_ECB` | `EVP_EncryptUpdate(...) != 1` | print OpenSSL errors and abort |\n\nNo C `assert` statements, `RETURN_ERROR` macros, `return NULL` statements, or\npublic enum-valued inputs exist in this source tree.\n\nBuild-time guards (not FFI inputs) reject: a BLAKE/SHA-256 output shorter than\n`SPX_N`; subtree addressing needing more than 64 bits; message tree indices\nneeding more than 64 bits; SHA input parameters outside the implementation's\nsupported block-size assumptions.\n| 33 | all | `shake, simple, 192s` | [ ] |\n| 34 | all | `shake, simple, 192f` | [ ] |\n| 35 | all | `shake, simple, 256s` | [ ] |\n| 36 | all | `shake, simple, 256f` | [ ] |\n| 37 | all | `blake, robust, 128s` (BLAKE-256 thash path) | [ ] |\n| 38 | all | `blake, robust, 128f` (BLAKE-256 thash path) | [ ] |\n| 39 | all | `blake, robust, 192s` (BLAKE-512 for multi-block thash) | [ ] |\n| 40 | all | `blake, robust, 192f` (BLAKE-512 for multi-block thash) | [ ] |\n| 41 | all | `blake, robust, 256s` (BLAKE-512 for multi-block thash) | [ ] |\n| 42 | all | `blake, robust, 256f` (BLAKE-512 for multi-block thash) | [ ] |\n| 43 | all | `blake, simple, 128s` (BLAKE-256 thash path) | [ ] |\n| 44 | all | `blake, simple, 128f` (BLAKE-256 thash path) | [ ] |\n| 45 | all | `blake, simple, 192s` (BLAKE-512 for multi-block thash) | [ ] |\n| 46 | all | `blake, simple, 192f` (BLAKE-512 for multi-block thash) | [ ] |\n| 47 | all | `blake, simple, 256s` (BLAKE-512 for multi-block thash) | [ ] |\n| 48 | all | `blake, simple, 256f` (BLAKE-512 for multi-block thash) | [ ] |\n\nParameter shapes are: `128s=(N=16,D=7,tree_height=9,FORS=12x14)`,\n`128f=(16,22,3,6x33)`, `192s=(24,7,9,14x17)`,\n`192f=(24,22,3,8x33)`, `256s=(32,8,8,14x22)`, and\n`256f=(32,17,4,9x35)`.\n\n## Runtime/data-shape combinations\n\nThese rows are run under every build-time combination when the named backend\nentry point exists.\n\n| # | entry point(s) | configuration (options set + input shape) | [ ] |\n|---:|---|---|:---:|\n| 49 | four `crypto_sign_*bytes` queries | no input; compare all parameter-derived sizes | [ ] |\n| 50 | `SPX_ull_to_bytes`, `SPX_bytes_to_ull` | widths 0, 1, 2, 4, and 8; randomized values; big-endian truncation | [ ] |\n| 51 | `SPX_u32_to_bytes` | randomized 32-bit values including 0 and `UINT32_MAX` | [ ] |\n| 52 | all eight address setters | zero, in-range, and high-bit values; byte-truncating and full-width fields | [ ] |\n| 53 | both address copy functions | randomized source/destination bytes, including overlap-preserved fields | [ ] |\n| 54 | backend initialize/PRF | randomized public/secret seeds and all seven address types | [ ] |\n| 55 | backend message-random function | message lengths 0, 1, block-1, block, block+1, and multi-block | [ ] |\n| 56 | backend message hash | same message shapes; verify digest, masked tree index, and masked leaf index | [ ] |\n| 57 | `SPX_thash` | `inblocks=1` (F function) | [ ] |\n| 58 | `SPX_thash` | `inblocks=2` (Merkle/FORS internal node; wide hash when `N>=24`) | [ ] |\n| 59 | `SPX_thash` | `inblocks=SPX_WOTS_LEN` | [ ] |\n| 60 | `SPX_thash` | `inblocks=SPX_FORS_TREES` | [ ] |\n| 61 | `SPX_chain_lengths` | randomized `SPX_N`-byte messages, including all-zero/all-`0xff` | [ ] |\n| 62 | `SPX_wots_pk_from_sig` | randomized WOTS signature/message/context/address | [ ] |\n| 63 | `SPX_compute_root` | even leaf, nonzero offset, every valid tree height used by the parameter set | [ ] |\n| 64 | `SPX_compute_root` | odd leaf, zero/nonzero offset, every valid tree height used by the parameter set | [ ] |\n| 65 | `SPX_treehash` | direct callback API, leaf indices at first/middle/last and nonzero offsets | [ ] |\n| 66 | `SPX_wots_gen_leafx1` | generated leaf is not the signing leaf | [ ] |\n| 67 | `SPX_wots_gen_leafx1` | generated leaf is the signing leaf; capture WOTS signature steps | [ ] |\n| 68 | `SPX_wots_treehashx1` | first/middle/last signing leaf and authentication path | [ ] |\n| 69 | `SPX_fors_gen_leafx1` | randomized FORS address/index | [ ] |\n| 70 | `SPX_fors_treehashx1` | first/middle/last FORS leaf and nonzero tree offset | [ ] |\n| 71 | `SPX_fors_sign`, `SPX_fors_pk_from_sig` | randomized message digest/context/address; compare signature and recovered PK | [ ] |\n| 72 | `SPX_merkle_sign` | first/middle/last leaf; compare WOTS signature, auth path, and root | [ ] |\n| 73 | `SPX_merkle_gen_root` | randomized context seeds | [ ] |\n| 74 | `crypto_sign_seed_keypair` | randomized fixed-size seeds | [ ] |\n| 75 | `crypto_sign_signature`, `crypto_sign_verify` | deterministic RNG initialized identically; empty, one-byte, and multi-block messages | [ ] |\n| 76 | `crypto_sign`, `crypto_sign_open` | deterministic RNG initialized identically; disjoint and overlapping message/output buffers | [ ] |\n| 77 | BLAKE one-shot functions | lengths 0, 1, 55/56, 63/64/65 and 111/112, 127/128/129 | [ ] |\n| 78 | BLAKE incremental functions | zero/one/many updates crossing 64- and 128-byte compression boundaries | [ ] |\n| 79 | BLAKE MGF1 functions | output lengths 0, 1, digest-1, digest, digest+1, and multiple digests | [ ] |\n| 80 | SHA-2 one-shot/incremental functions | empty, padding boundaries, one/many full blocks, and remainder finalization | [ ] |\n| 81 | SHA-2 MGF1/state seeding | short/exact/long outputs and both `N<24`/`N>=24` branches | [ ] |\n| 82 | SHAKE one-shot/incremental functions | empty, rate-1, rate, rate+1, and multi-rate absorb/squeeze | [ ] |\n| 83 | Haraka permutation/hash functions | 32-byte, 64-byte, incremental sponge, and partial squeeze shapes | [ ] |\n| 84 | deterministic RNG/AES functions | personalization absent/present; requests 0, 1, 15, 16, 17, and many blocks | [ ] |\n","exit_code":0,"status":"completed"}}
