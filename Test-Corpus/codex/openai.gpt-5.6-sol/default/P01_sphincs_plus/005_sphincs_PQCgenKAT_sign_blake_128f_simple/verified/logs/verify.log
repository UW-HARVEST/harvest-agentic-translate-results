                  const unsigned char *seed)\n    55\t{\n    56\t    spx_ctx ctx;\n    57\t\n    58\t    /* Initialize SK_SEED, SK_PRF and PUB_SEED from seed. */\n    59\t    memcpy(sk, seed, CRYPTO_SEEDBYTES);\n    60\t\n    61\t    memcpy(pk, sk + 2*SPX_N, SPX_N);\n    62\t\n    63\t    memcpy(ctx.pub_seed, pk, SPX_N);\n    64\t    memcpy(ctx.sk_seed, sk, SPX_N);\n    65\t\n    66\t    /* This hook allows the hash function instantiation to do whatever\n    67\t       preparation or computation it needs, based on the public seed. */\n    68\t    initialize_hash_function(&ctx);\n    69\t\n    70\t    /* Compute root node of the top-most subtree. */\n    71\t    merkle_gen_root(sk + 3*SPX_N, &ctx);\n    72\t\n    73\t    memcpy(pk + SPX_N, sk + 3*SPX_N, SPX_N);\n    74\t\n    75\t    return 0;\n    76\t}\n    77\t\n    78\t/*\n    79\t * Generates an SPX key pair.\n    80\t * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]\n    81\t * Format pk: [PUB_SEED || root]\n    82\t */\n    83\tint crypto_sign_keypair(unsigned char *pk, unsigned char *sk)\n    84\t{\n    85\t  unsigned char seed[CRYPTO_SEEDBYTES];\n    86\t  randombytes(seed, CRYPTO_SEEDBYTES);\n    87\t  crypto_sign_seed_keypair(pk, sk, seed);\n    88\t\n    89\t  return 0;\n    90\t}\n    91\t\n    92\t/**\n    93\t * Returns an array containing a detached signature.\n    94\t */\n    95\tint crypto_sign_signature(uint8_t *sig, size_t *siglen,\n    96\t                          const uint8_t *m, size_t mlen, const uint8_t *sk)\n    97\t{\n    98\t    spx_ctx ctx;\n    99\t\n   100\t    const unsigned char *sk_prf = sk + SPX_N;\n   101\t    const unsigned char *pk = sk + 2*SPX_N;\n   102\t\n   103\t    unsigned char optrand[SPX_N];\n   104\t    unsigned char mhash[SPX_FORS_MSG_BYTES];\n   105\t    unsigned char root[SPX_N];\n   106\t    uint32_t i;\n   107\t    uint64_t tree;\n   108\t    uint32_t idx_leaf;\n   109\t    uint32_t wots_addr[8] = {0};\n   110\t    uint32_t tree_addr[8] = {0};\n   111\t\n   112\t    memcpy(ctx.sk_seed, sk, SPX_N);\n   113\t    memcpy(ctx.pub_seed, pk, SPX_N);\n   114\t\n   115\t    /* This hook allows the hash function instantiation to do whatever\n   116\t       preparation or computation it needs, based on the public seed. */\n   117\t    initialize_hash_function(&ctx);\n   118\t\n   119\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n   120\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n   121\t\n   122\t    /* Optionally, signing can be made non-deterministic using optrand.\n   123\t       This can help counter side-channel attacks that would benefit from\n   124\t       getting a large number of traces when the signer uses the same nodes. */\n   125\t    randombytes(optrand, SPX_N);\n   126\t    /* Compute the digest randomization value. */\n   127\t    gen_message_random(sig, sk_prf, optrand, m, mlen, &ctx);\n   128\t\n   129\t    /* Derive the message digest and leaf index from R, PK and M. */\n   130\t    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);\n   131\t    sig += SPX_N;\n   132\t\n   133\t    set_tree_addr(wots_addr, tree);\n   134\t    set_keypair_addr(wots_addr, idx_leaf);\n   135\t\n   136\t    /* Sign the message hash using FORS. */\n   137\t    fors_sign(sig, root, mhash, &ctx, wots_addr);\n   138\t    sig += SPX_FORS_BYTES;\n   139\t\n   140\t    for (i = 0; i < SPX_D; i++) {\n   141\t        set_layer_addr(tree_addr, i);\n   142\t        set_tree_addr(tree_addr, tree);\n   143\t\n   144\t        copy_subtree_addr(wots_addr, tree_addr);\n   145\t        set_keypair_addr(wots_addr, idx_leaf);\n   146\t\n   147\t        merkle_sign(sig, root, &ctx, wots_addr, tree_addr, idx_leaf);\n   148\t        sig += SPX_WOTS_BYTES + SPX_TREE_HEIGHT * SPX_N;\n   149\t\n   150\t        /* Update the indices for the next layer. */\n   151\t        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));\n   152\t        tree = tree >> SPX_TREE_HEIGHT;\n   153\t    }\n   154\t\n   155\t    *siglen = SPX_BYTES;\n   156\t\n   157\t    return 0;\n   158\t}\n   159\t\n   160\t/**\n   161\t * Verifies a detached signature and message under a given public key.\n   162\t */\n   163\tint crypto_sign_verify(const uint8_t *sig, size_t siglen,\n   164\t                       const uint8_t *m, size_t mlen, const uint8_t *pk)\n   165\t{\n   166\t    spx_ctx ctx;\n   167\t    const unsigned char *pub_root = pk + SPX_N;\n   168\t    unsigned char mhash[SPX_FORS_MSG_BYTES];\n   169\t    unsigned char wots_pk[SPX_WOTS_BYTES];\n   170\t    unsigned char root[SPX_N];\n   171\t    unsigned char leaf[SPX_N];\n   172\t    unsigned int i;\n   173\t    uint64_t tree;\n   174\t    uint32_t idx_leaf;\n   175\t    uint32_t wots_addr[8] = {0};\n   176\t    uint32_t tree_addr[8] = {0};\n   177\t    uint32_t wots_pk_addr[8] = {0};\n   178\t\n   179\t    if (siglen != SPX_BYTES) {\n   180\t        return -1;\n   181\t    }\n   182\t\n   183\t    memcpy(ctx.pub_seed, pk, SPX_N);\n   184\t\n   185\t    /* This hook allows the hash function instantiation to do whatever\n   186\t       preparation or computation it needs, based on the public seed. */\n   187\t    initialize_hash_function(&ctx);\n   188\t\n   189\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n   190\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n   191\t    set_type(wots_pk_addr, SPX_ADDR_TYPE_WOTSPK);\n   192\t\n   193\t    /* Derive the message digest and leaf index from R || PK || M. */\n   194\t    /* The additional SPX_N is a result of the hash domain separator. */\n   195\t    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);\n   196\t    sig += SPX_N;\n   197\t\n   198\t    /* Layer correctly defaults to 0, so no need to set_layer_addr */\n   199\t    set_tree_addr(wots_addr, tree);\n   200\t    set_keypair_addr(wots_addr, idx_leaf);\n   201\t\n   202\t    fors_pk_from_sig(root, sig, mhash, &ctx, wots_addr);\n   203\t    sig += SPX_FORS_BYTES;\n   204\t\n   205\t    /* For each subtree.. */\n   206\t    for (i = 0; i < SPX_D; i+