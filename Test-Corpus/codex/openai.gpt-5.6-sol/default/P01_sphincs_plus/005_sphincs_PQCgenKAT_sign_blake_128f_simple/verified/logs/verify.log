.copy_from_slice(&d[..fill]);self.t[0]=self.t[0].wrapping_add(1024);let b=self.buf;self.comp(&b);p+=fill;bits-=(fill as u64)<<3;left=0}while bits>=1024{self.t[0]=self.t[0].wrapping_add(1024);self.comp(&d[p..p+128]);p+=128;bits-=1024}if bits>0{let q=((bits>>3)&127)as usize;self.buf[left..left+q].copy_from_slice(&d[p..p+q]);self.n=((left as u64)<<3).wrapping_add(bits)}else{self.n=0}}\nfn fin(mut self)->[u8;64]{let lo=self.t[0].wrapping_add(self.n);let hi=self.t[1].wrapping_add((lo<self.n)as u64);let mut ml=[0u8;16];ml[..8].copy_from_slice(&hi.to_be_bytes());ml[8..].copy_from_slice(&lo.to_be_bytes());let mut pad=[0u8;129];pad[0]=128;if self.n==888{self.t[0]=self.t[0].wrapping_sub(8);self.up(&[129],8)}else{if self.n<888{if self.n==0{self.null=true}let q=888-self.n;self.t[0]=self.t[0].wrapping_sub(q);self.up(&pad,q)}else{let q=1024-self.n;self.t[0]=self.t[0].wrapping_sub(q);self.up(&pad,q);self.t[0]=self.t[0].wrapping_sub(888);self.up(&pad[1..],888);self.null=true}self.up(&[1],8);self.t[0]=self.t[0].wrapping_sub(8)}self.t[0]=self.t[0].wrapping_sub(128);self.up(&ml,128);let mut o=[0;64];for i in 0..8{o[8*i..8*i+8].copy_from_slice(&self.h[i].to_be_bytes())}o}}\npub fn blake256(i:&[u8])->[u8;32]{let mut s=B256::new();s.up(i,i.len()as u64*8);s.fin()}\npub fn blake512(i:&[u8])->[u8;64]{let mut s=B512::new();s.up(i,i.len()as u64*8);s.fin()}\npub fn blake256_updates(p:&[(&[u8],u64)])->[u8;32]{let mut s=B256::new();for&(d,n)in p{s.up(d,n)}s.fin()}\npub fn blake512_updates(p:&[(&[u8],u64)])->[u8;64]{let mut s=B512::new();for&(d,n)in p{s.up(d,n)}s.fin()}\npub fn mgf1(o:&mut[u8],seed:&[u8],wide:bool){let step=if wide{64}else{32};let mut p=0;let mut c=0u32;while p<o.len(){let mut x=seed.to_vec();x.extend_from_slice(&c.to_be_bytes());let d=if wide{blake512(&x).to_vec()}else{blake256(&x).to_vec()};let n=step.min(o.len()-p);o[p..p+n].copy_from_slice(&d[..n]);p+=n;c+=1}}\n#[cfg(test)]\nmod tests {\n    use super::*;\n    #[test]\n    fn blake256_vectors() {\n        assert_eq!(hex(&blake256(b\"\")), \"716f6e863f744b9ac22c97ec7b76ea5f5908bc5b2f67c61510bfc4751384ea7a\");\n        assert_eq!(hex(&blake256(b\"abc\")), \"1833a9fa7cf4086bd5fda73da32e5a1d75b4c3f89d5c436369f9d78bb2da5c28\");\n    }\n    fn hex(x:&[u8])->String{x.iter().map(|b|format!(\"{b:02x}\")).collect()}\n}\n","exit_code":0,"status":"completed"}}
