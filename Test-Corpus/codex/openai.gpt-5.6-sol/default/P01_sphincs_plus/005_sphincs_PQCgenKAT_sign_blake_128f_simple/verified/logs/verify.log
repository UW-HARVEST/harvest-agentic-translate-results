[8])\\n    22\\t{\\n    23\\t    thash(leaf, sk, 1, ctx, fors_leaf_addr);\\n    24\\t}\\n    25\\t\\n    26\\tvoid fors_gen_leafx1(unsigned char *leaf,\\n    27\\t                            const spx_ctx *ctx,\\n    28\\t                            uint32_t addr_idx, fors_gen_leaf_info *info)\\n    29\\t{\\n    30\\t    struct fors_gen_leaf_info *fors_info = info;\\n    31\\t    uint32_t *fors_leaf_addr = fors_info->leaf_addrx;\\n    32\\t\\n    33\\t    /* Only set the parts that the caller doesn't set */\\n    34\\t    set_tree_index(fors_leaf_addr, addr_idx);\\n    35\\t    set_type(fors_leaf_addr, SPX_ADDR_TYPE_FORSPRF);\\n    36\\t    fors_gen_sk(leaf, ctx, fors_leaf_addr);\\n    37\\t\\n    38\\t    set_type(fors_leaf_addr, SPX_ADDR_TYPE_FORSTREE);\\n    39\\t    fors_sk_to_leaf(leaf, leaf,\\n    40\\t                    ctx, fors_leaf_addr);\\n    41\\t}\\n    42\\t\\n    43\\t/**\\n    44\\t * Interprets m as SPX_FORS_HEIGHT-bit unsigned integers.\\n    45\\t * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.\\n    46\\t * Assumes indices has space for SPX_FORS_TREES integers.\\n    47\\t */\\n    48\\tstatic void message_to_indices(uint32_t *indices, const unsigned char *m)\\n    49\\t{\\n    50\\t    unsigned int i, j;\\n    51\\t    unsigned int offset = 0;\\n    52\\t\\n    53\\t    for (i = 0; i < SPX_FORS_TREES; i++) {\\n    54\\t        indices[i] = 0;\\n    55\\t        for (j = 0; j < SPX_FORS_HEIGHT; j++) {\\n    56\\t            indices[i] ^= ((m[offset >> 3] >> (offset & 0x7)) & 1u) << j;\\n    57\\t            offset++;\\n    58\\t        }\\n    59\\t    }\\n    60\\t}\\n    61\\t\\n    62\\t/**\\n    63\\t * Signs a message m, deriving the secret key from sk_seed and the FTS address.\\n    64\\t * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.\\n    65\\t */\\n    66\\tvoid fors_sign(unsigned char *sig, unsigned char *pk,\\n    67\\t               const unsigned char *m,\\n    68\\t               const spx_ctx *ctx,\\n    69\\t               const uint32_t fors_addr[8])\\n    70\\t{\\n    71\\t    uint32_t indices[SPX_FORS_TREES];\\n    72\\t    unsigned char roots[SPX_FORS_TREES * SPX_N];\\n    73\\t    uint32_t fors_tree_addr[8] = {0};\\n    74\\t    struct fors_gen_leaf_info fors_info = {0};\\n    75\\t    uint32_t *fors_leaf_addr = fors_info.leaf_addrx;\\n    76\\t    uint32_t fors_pk_addr[8] = {0};\\n    77\\t    uint32_t idx_offset;\\n    78\\t    unsigned int i;\\n    79\\t\\n    80\\t    copy_keypair_addr(fors_tree_addr, fors_addr);\\n    81\\t    copy_keypair_addr(fors_leaf_addr, fors_addr);\\n    82\\t\\n    83\\t    copy_keypair_addr(fors_pk_addr, fors_addr);\\n    84\\t    set_type(fors_pk_addr, SPX_ADDR_TYPE_FORSPK);\\n    85\\t\\n    86\\t    message_to_indices(indices, m);\\n    87\\t\\n    88\\t    for (i = 0; i < SPX_FORS_TREES; i++) {\\n    89\\t        idx_offset = i * (1 << SPX_FORS_HEIGHT);\\n    90\\t\\n    91\\t        set_tree_height(fors_tree_addr, 0);\\n    92\\t        set_tree_index(fors_tree_addr, indices[i] + idx_offset);\\n    93\\t        set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSPRF);\\n    94\\t\\n    95\\t        /* Include the secret key part that produces the selected leaf node. */\\n    96\\t        fors_gen_sk(sig, ctx, fors_tree_addr);\\n    97\\t        set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);\\n    98\\t        sig += SPX_N;\\n    99\\t\\n   100\\t        /* Compute the authentication path for this leaf node. */\\n   101\\t        fors_treehashx1(roots + i*SPX_N, sig, ctx,\\n   102\\t                 indices[i], idx_offset, SPX_FORS_HEIGHT,\\n   103\\t                 fors_tree_addr, &fors_info);\\n   104\\t\\n   105\\t        sig += SPX_N * SPX_FORS_HEIGHT;\\n   106\\t    }\\n   107\\t\\n   108\\t    /* Hash horizontally across all tree roots to derive the public key. */\\n   109\\t    thash(pk, roots, SPX_FORS_TREES, ctx, fors_pk_addr);\\n   110\\t}\\n   111\\t\\n   112\\t/**\\n   113\\t * Derives the FORS public