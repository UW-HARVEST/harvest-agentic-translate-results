r_addr(fors_tree_addr, fors_addr);\\n    81\\t    copy_keypair_addr(fors_leaf_addr, fors_addr);\\n    82\\t\\n    83\\t    copy_keypair_addr(fors_pk_addr, fors_addr);\\n    84\\t    set_type(fors_pk_addr, SPX_ADDR_TYPE_FORSPK);\\n    85\\t\\n    86\\t    message_to_indices(indices, m);\\n    87\\t\\n    88\\t    for (i = 0; i < SPX_FORS_TREES; i++) {\\n    89\\t        idx_offset = i * (1 << SPX_FORS_HEIGHT);\\n    90\\t\\n    91\\t        set_tree_height(fors_tree_addr, 0);\\n    92\\t        set_tree_index(fors_tree_addr, indices[i] + idx_offset);\\n    93\\t        set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSPRF);\\n    94\\t\\n    95\\t        /* Include the secret key part that produces the selected leaf node. */\\n    96\\t        fors_gen_sk(sig, ctx, fors_tree_addr);\\n    97\\t        set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);\\n    98\\t        sig += SPX_N;\\n    99\\t\\n   100\\t        /* Compute the authentication path for this leaf node. */\\n   101\\t        fors_treehashx1(roots + i*SPX_N, sig, ctx,\\n   102\\t                 indices[i], idx_offset, SPX_FORS_HEIGHT,\\n   103\\t                 fors_tree_addr, &fors_info);\\n   104\\t\\n   105\\t        sig += SPX_N * SPX_FORS_HEIGHT;\\n   106\\t    }\\n   107\\t\\n   108\\t    /* Hash horizontally across all tree roots to derive the public key. */\\n   109\\t    thash(pk, roots, SPX_FORS_TREES, ctx, fors_pk_addr);\\n   110\\t}\\n   111\\t\\n   112\\t/**\\n   113\\t * Derives the FORS public key from a signature.\\n   114\\t * This can be used for verification by comparing to a known public key, or to\\n   115\\t * subsequently verify a signature on the derived public key. The latter is the\\n   116\\t * typical use-case when used as an FTS below an OTS in a hypertree.\\n   117\\t * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.\\n   118\\t */\\n   119\\tvoid fors_pk_from_sig(unsigned char *pk,\\n   120\\t                      const unsigned char *sig, const unsigned char *m,\\n   121\\t                      const spx_ctx* ctx,\\n   122\\t                      const uint32_t fors_addr[8])\\n   123\\t{\\n   124\\t    uint32_t indices[SPX_FORS_TREES];\\n   125\\t    unsigned char roots[SPX_FORS_TREES * SPX_N];\\n   126\\t    unsigned char leaf[SPX_N];\\n   127\\t    uint32_t fors_tree_addr[8] = {0};\\n   128\\t    uint32_t fors_pk_addr[8] = {0};\\n   129\\t    uint32_t idx_offset;\\n   130\\t    unsigned int i;\\n   131\\t\\n   132\\t    copy_keypair_addr(fors_tree_addr, fors_addr);\\n   133\\t    copy_keypair_addr(fors_pk_addr, fors_addr);\\n   134\\t\\n   135\\t    set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);\\n   136\\t    set_type(fors_pk_addr, SPX_ADDR_TYPE_FORSPK);\\n   137\\t\\n   138\\t    message_to_indices(indices, m);\\n   139\\t\\n   140\\t    for (i = 0; i < SPX_FORS_TREES; i++) {\\n   141\\t        idx_offset = i * (1 << SPX_FORS_HEIGHT);\\n   142\\t\\n   143\\t        set_tree_height(fors_tree_addr, 0);\\n   144\\t        set_tree_index(fors_tree_addr, indices[i] + idx_offset);\\n   145\\t\\n   146\\t        /* Derive the leaf from the included secret key part. */\\n   147\\t        fors_sk_to_leaf(leaf, sig, ctx, fors_tree_addr);\\n   148\\t        sig += SPX_N;\\n   149\\t\\n   150\\t        /* Derive the corresponding root node of this tree. */\\n   151\\t        compute_root(roots + i*SPX_N, leaf, indices[i], idx_offset,\\n   152\\t                     sig, SPX_FORS_HEIGHT, ctx, fors_tree_addr);\\n   153\\t        sig += SPX_N * SPX_FORS_HEIGHT;\\n   154\\t    }\\n   155\\t\\n   156\\t    /* Hash horizontally across all tree roots to derive the public key. */\\n   157\\t    thash(pk, roots, SPX_FORS_TREES, ctx, fors_pk_addr);\\n   158\\t}\\n########## app/src/wots.c\\n     1\\t#include <stdint.h>\\n     2\\t#include <string.h>\\n     3\\t\\n     4\\t#include \\\"../include/address.h\\\"\\n     5\\t#include \\\"../include/hash.h\\\"\\n     6\\t#include \\\"../include/params.h\\\"\\n     7\\t#include \\\"../include/thash.h\\\"\\n     8\\t#include \\\"../include/utils.h\\\"\\n     9\\t#include \\\"../include/utilsx1.h\\\"\\n    10\\t#include \\\"../include/wots.h\\\"\\n    11\\t#include \\\"../include/wotsx1.h\\\"\\n    12\\t\\n    13\\t// TODO clarify address expectations, and make them more uniform.\\n    14\\t// TODO i.e. do we expect types to be set already?\\n    15\\t// TODO and do we expect modifications or copies?\\n    16\\t\\n    17\\t/**\\n    18\\t * Computes the chaining function.\\n    19\\t * out and in have to be n-byte arrays.\\n    20\\t *\\n    21\\t * Interprets in as start-th value of the chain.\\n    22\\t * addr has to contain the address of the chain.\\n    23\\t */\\n    24\\tstatic void gen_chain(unsigned char *out, const unsigned char *in,\\n    25\\t                      unsigned int start, unsigned int steps,\\n    26\\t                      const spx_ctx *ctx, uint32_t addr[8])\\n    27\\t{\\n    28\\t    uint32_t i;\\n    29\\t\\n    30\\t    /* Initialize out with the value at position 'start'. */\\n    31\\t    memcpy(out, in, SPX_N);\\n    32\\t\\n    33\\t    /* Iterate 'steps' calls to the hash function. */\\n    34\\t    for (i = start; i < (start+steps) && i < SPX_WOTS_W; i++) {\\n    35\\t        set_hash_addr(addr, i);\\n    36\\t        thash(out, out, 1, ctx, addr);\\n    37\\t    }\\n    38\\t}\\n    39\\t\\n    40\\t/**\\n    41\\t * base_w algorithm as described in draft.\\n    42\\t * Interprets an array of bytes as integers in base w.\\n    43\\t * This only works when log_w is a divisor of 8.\\n    44\\t */\\n    45\\tstatic void base_w(unsigned int *output, const int out_len,\\n    46\\t                   const unsigned char *input)\\n    47\\t{\\n    48\\t    int in = 0;\\n    49\\t    int out = 0;\\n    50\\t    unsigned char total;\\n    51\\t    int bits = 0;\\n    52\\t    int consumed;\\n    53\\t\\n    54\\t    for (consumed = 0; consumed < out_len; consumed++) {\\n    55\\t        if (bits == 0) {\\n    56\\t            total = input[in];\\n    57\\t            in++;\\n    58\\t            bits += 8;\\n    59\\t        }\\n    60\\t        bits -= SPX_WOTS_LOGW;\\n    61\\t        output[out] = (total >> bits) & (SPX_WOTS_W - 1);\\n    62\\t        out++;\\n    63\\t    }\\n    64\\t}\\n    65\\t\\n    66\\t/* Computes the WOTS+ checksum over a message (in base_w). */\\n    67\\tstatic void wots_checksum(unsigned int *csum_base_w,\\n    68\\t                          const unsigned int *msg_base_w)\\n    69\\t{\\n    70\\t    unsigned int csum = 0;\\n    71\\t    unsigned char csum_bytes[(SPX_WOTS_LEN2 * SPX_WOTS_LOGW + 7) / 8];\\n    72\\t    unsigned int i;\\n    73\\t\\n    74\\t    /* Compute checksum. */\\n    75\\t    for (i = 0; i < SPX_WOTS_LEN1; i++) {\\n    76\\t        csum += SPX_WOTS_W - 1 - msg_base_w[i];\\n    77\\t    }\\n    78\\t\\n    79\\t    /* Convert checksum to base_w. */\\n    80\\t    /* Make sure expected empty zero bits are the least significant bits. */\\n    81\\t    csum = csum << ((8 - ((SPX_WOTS_LEN2 * SPX_WOTS_LOGW) % 8)) % 8);\\n    82\\t    ull_to_bytes(csum_bytes, sizeof(csum_bytes), csum);\\n    83\\t    base_w(csum_base_w, SPX_WOTS_LEN2, csum_bytes);\\n    84\\t}\\n    85\\t\\n    86\\t/* Takes a message and derives the matching chain lengths. */\\n    87\\tvoid chain_lengths(unsigned int *lengths, const unsigned char *msg)\\n    88\\t{\\n    89\\t    base_w(lengths, SPX_WOTS_LEN1, msg);\\n    90\\t    wots_checksum(lengths + SPX_WOTS_LEN1, lengths);\\n    91\\t}\\n    92\\t\\n    93\\t/**\\n    94\\t * Takes a WOTS signature and an n-byte message, computes a WOTS public key.\\n    95\\t *\\n    96\\t * Writes the computed public key to 'pk'.\\n    97\\t */\\n    98\\tvoid wots_pk_from_sig(unsigned char *pk,\\n    99\\t                      const unsigned char *sig, const unsigned char *msg,\\n   100\\t                      const spx_ctx *ctx, uint32_t addr[8])\\n   101\\t{\\n   102\\t    unsigned int lengths[SPX_WOTS_LEN];\\n   103\\t    uint32_t i;\\n   104\\t\\n   105\\t    chain_lengths(lengths, msg);\\n   106\\t\\n   107\\t    for (i = 0; i < SPX_WOTS_LEN; i++) {\\n   108\\t        set_chain_addr(addr, i);\\n   109\\t        gen_chain(pk + i*SPX_N, sig + i*SPX_N,\\n   110\\t                  lengths[i], SPX_WOTS_W - 1 - lengths[i], ctx, addr);\\n   111\\t    }\\n   112\\t}\\n########## app/src/wotsx1.c\\n     1\\t#include <stdint.h>\\n     2\\t#include <string.h>\\n     3\\t\\n     4\\t#include \\\"../include/address.h\\\"\\n     5\\t#include \\\"../include/hash.h\\\"\\n     6\\t#include \\\"../include/params.h\\\"\\n     7\\t#include \\\"../include/thash.h\\\"\\n     8\\t#include \\\"../include/utils.h\\\"\\n     9\\t#include \\\"../include/wots.h\\\"\\n    10\\t#include \\\"../include/wotsx1.h\\\"\\n    11\\t\\n    12\\t/*\\n    13\\t * This generates a WOTS public key\\n    14\\t * It also generates the WOTS signature if leaf_info indicates\\n    15\\t * that we're signing with this WOTS key\\n    16\\t */\\n    17\\tvoid wots_gen_leafx1(unsigned char *dest,\\n    18\\t                   const spx_ctx *ctx,\\n    19\\t                   uint32_t leaf_idx, leaf_info_x1 *v_info) {\\n    20\\t    struct leaf_info_x1 *info = v_info;\\n    21\\t    uint32_t *leaf_addr = info->leaf_addr;\\n    22\\t    uint32_t *pk_addr = info->pk_addr;\\n    23\\t    unsigned int i, k;\\n    24\\t    unsigned char pk_buffer[ SPX_WOTS_BYTES ];\\n    25\\t    unsigned char *buffer;\\n    26\\t    uint32_t wots_k_mask;\\n    27\\t\\n    28\\t    if (leaf_idx == info->wots_sign_leaf) {\\n    29\\t        /* We're traversing the leaf that's signing; generate the WOTS */\\n    30\\t        /* signature */\\n    31\\t        wots_k_mask = 0;\\n    32\\t    } else {\\n    33\\t        /* Nope, we're just generating pk's; turn off the signature logic */\\n    34\\t        wots_k_mask = (uint32_t)~0;\\n    35\\t    }\\n    36\\t\\n    37\\t    set_keypair_addr( leaf_addr, leaf_idx );\\n    38\\t    set_keypair_addr( pk_addr, leaf_idx );\\n    39\\t\\n    40\\t    for (i = 0, buffer = pk_buffer; i < SPX_WOTS_LEN; i++, buffer += SPX_N) {\\n    41\\t        uint32_t wots_k = info->wots_steps[i] | wots_k_mask; /* Set wots_k to */\\n    42\\t            /* the step if we're generating a signature, ~0 if we're not */\\n    43\\t\\n    44\\t        /* Start with the secret seed */\\n    45\\t        set_chain_addr(leaf_addr, i);\\n    46\\t        set_hash_addr(leaf_addr, 0);\\n    47\\t        set_type(leaf_addr, SPX_ADDR_TYPE_WOTSPRF);\\n    48\\t\\n    49\\t        prf_addr(buffer, ctx, leaf_addr);\\n    50\\t\\n    51\\t        set_type(leaf_addr, SPX_ADDR_TYPE_WOTS);\\n    52\\t\\n    53\\t        /* Iterate down the WOTS chain */\\n    54\\t        for (k=0;; k++) {\\n    55\\t            /* Check if this is the value that needs to be saved as a */\\n    56\\t            /* part of the WOTS signature */\\n    57\\t            if (k == wots_k) {\\n    58\\t                memcpy( info->wots_sig + i * SPX_N, buffer, SPX_N );\\n    59\\t            }\\n    60\\t\\n    61\\t            /* Check if we hit the top of the chain */\\n    62\\t            if (k == SPX_WOTS_W - 1) break;\\n    63\\t\\n    64\\t            /* Iterate one step on the chain */\\n    65\\t            set_hash_addr(leaf_addr, k);\\n    66\\t\\n    67\\t            thash(buffer, buffer, 1, ctx, leaf_addr);\\n    68\\t        }\\n    69\\t    }\\n    70\\t\\n    71\\t    /* Do the final thash to generate the public keys */\\n    72\\t    thash(dest, pk_buffer, SPX_WOTS_LEN, ctx, pk_addr);\\n    73\\t}\\n########## app/src/merkle.c\\n     1\\t#include <stdint.h>\\n     2\\t#include <string.h>\\n     3\\t\\n     4\\t#include \\\"../include/address.h\\\"\\n     5\\t#include \\\"../include/merkle.h\\\"\\n     6\\t#include \\\"../include/params.h\\\"\\n     7\\t#include \\\"../include/utils.h\\\"\\n     8\\t#include \\\"../include/utilsx1.h\\\"\\n     9\\t#include \\\"../include/wots.h\\\"\\n    10\\t#include \\\"../include/wotsx1.h\\\"\\n    11\\t\\n    12\\t/*\\n    13\\t * This generates a Merkle signature (WOTS signature followed by the Merkle\\n    14\\t * authentication path).  This is in this file because most of the complexity\\n    15\\t * is involved with the WOTS signature; the Merkle authentication path logic\\n    16\\t * is mostly hidden in treehashx4\\n    17\\t */\\n    18\\tvoid merkle_sign(uint8_t *sig, unsigned char *root,\\n    19\\t                 const spx_ctx *ctx,\\n    20\\t                 uint32_t wots_addr[8], uint32_t tree_addr[8],\\n    21\\t                 uint32_t idx_leaf)\\n    22\\t{\\n    23\\t    unsigned char *auth_path = sig + SPX_WOTS_BYTES;\\n    24\\t    struct leaf_info_x1 info = { 0 };\\n    25\\t    unsigned steps[ SPX_WOTS_LEN ];\\n    26\\t\\n    27\\t    info.wots_sig = sig;\\n    28\\t    chain_lengths(steps, root);\\n    29\\t    info.wots_steps = steps;\\n    30\\t\\n    31\\t    set_type(&tree_addr[0], SPX_ADDR_TYPE_HASHTREE);\\n    32\\t    set_type(&info.pk_addr[0], SPX_ADDR_TYPE_WOTSPK);\\n    33\\t    copy_subtree_addr(&info.leaf_addr[0], wots_addr);\\n    34\\t    copy_subtree_addr(&info.pk_addr[0], wots_addr);\\n    35\\t\\n    36\\t    info.wots_sign_leaf = idx_leaf;\\n    37\\t\\n    38\\t    wots_treehashx1(root, auth_path, ctx,\\n    39\\t                idx_leaf, 0,\\n    40\\t                SPX_TREE_HEIGHT,\\n    41\\t                tree_addr, &info);\\n    42\\t}\\n    43\\t\\n    44\\t/* Compute root node of the top-most subtree. */\\n    45\\tvoid merkle_gen_root(unsigned char *root, const spx_ctx *ctx)\\n    46\\t{\\n    47\\t    /* We do not need the auth path in key generation, but it simplifies the\\n    48\\t       code to have just one treehash routine that computes both root and path\\n    49\\t       in one function. */\\n    50\\t    unsigned char auth_path[SPX_TREE_HEIGHT * SPX_N + SPX_WOTS_BYTES];\\n    51\\t    uint32_t top_tree_addr[8] = {0};\\n    52\\t    uint32_t wots_addr[8] = {0};\\n    53\\t\\n    54\\t    set_layer_addr(top_tree_addr, SPX_D - 1);\\n    55\\t    set_layer_addr(wots_addr, SPX_D - 1);\\n    56\\t\\n    57\\t    merkle_sign(auth_path, root, ctx,\\n    58\\t                wots_addr, top_tree_addr,\\n    59\\t                (uint32_t)~0 /* ~0 means \\\"don't bother generating an auth path */ );\\n    60\\t}\\n########## app/src/utilsx1.c\\n     1\\t#include <string.h>\\n     2\\t\\n     3\\t#include \\\"../include/address.h\\\"\\n     4\\t#include \\\"../include/params.h\\\"\\n     5\\t#include \\\"../include/forsx1.h\\\"\\n     6\\t#include \\\"../include/thash.h\\\"\\n     7\\t#include \\\"../include/utils.h\\\"\\n     8\\t#include \\\"../include/utilsx1.h\\\"\\n     9\\t\\n    10\\t/*\\n    11\\t * Generate the entire Merkle tree, computing the authentication path for\\n    12\\t * leaf_idx, and the resulting root node using Merkle's TreeHash algorithm.\\n    13\\t * Expects the layer and tree parts of the tree_addr to be set, as well as the\\n    14\\t * tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE)\\n    15\\t *\\n    16\\t * This expects tree_addr to be initialized to the addr structures for the\\n    17\\t * Merkle tree nodes\\n    18\\t *\\n    19\\t * Applies the offset idx_offset to indices before building addresses, so that\\n    20\\t * it is possible to continue counting indices across trees.\\n    21\\t *\\n    22\\t * This works by using the standard Merkle tree building algorithm,\\n    23\\t */\\n    24\\tvoid wots_treehashx1(unsigned char *root, unsigned char *auth_path,\\n    25\\t\\t\\t     const spx_ctx* ctx,\\n    26\\t\\t\\t     uint32_t leaf_idx, uint32_t idx_offset,\\n    27\\t\\t\\t     uint32_t tree_height,\\n    28\\t\\t\\t     uint32_t tree_addr[8],\\n    29\\t\\t\\t     leaf_info_x1 *info)\\n    30\\t{\\n    31\\t    /* This is where we keep the intermediate nodes */\\n    32\\t    SPX_VLA(uint8_t, stack, tree_height*SPX_N);\\n    33\\t\\n    34\\t    uint32_t idx;\\n    35\\t    uint32_t max_idx = (uint32_t)((1 << tree_height) - 1);\\n    36\\t    for (idx = 0;; idx++) {\\n    37\\t        unsigned char current[2*SPX_N];   /* Current logical node is at */\\n    38\\t            /* index[SPX_N].  We do this to minimize the number of copies */\\n    39\\t            /* needed during a thash */\\n    40\\t        wots_gen_leafx1( &current[SPX_N], ctx, idx + idx_offset,\\n    41\\t\\t\\t\\t info );\\n    42\\t\\n    43\\t        /* Now combine the freshly generated right node with previously */\\n    44\\t        /* generated left ones */\\n    45\\t        uint32_t internal_idx_offset = idx_offset;\\n    46\\t        uint32_t internal_idx = idx;\\n    47\\t        uint32_t internal_leaf = leaf_idx;\\n    48\\t        uint32_t h;     /* The height we are in the Merkle tree */\\n    49\\t        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {\\n    50\\t\\n    51\\t            /* Check if we hit the top of the tree */\\n    52\\t            if (h == tree_height) {\\n    53\\t                /* We hit the root; return it */\\n    54\\t                memcpy( root, &current[SPX_N], SPX_N );\\n    55\\t                return;\\n    56\\t            }\\n    57\\t\\n    58\\t            /*\\n    59\\t             * Check if the node we have is a part of the\\n    60\\t             * authentication path; if it is, write it out\\n    61\\t             */\\n    62\\t            if ((internal_idx ^ internal_leaf) == 0x01) {\\n    63\\t                memcpy( &auth_path[ h * SPX_N ],\\n    64\\t                        &current[SPX_N],\\n    65\\t                        SPX_N );\\n    66\\t            }\\n    67\\t\\n    68\\t            /*\\n    69\\t             * Check if we're at a left child; if so, stop going up the stack\\n    70\\t             * Exception: if we've reached the end of the tree, keep on going\\n    71\\t             * (so we combine the last 4 nodes into the one root node in two\\n    72\\t             * more iterations)\\n    73\\t             */\\n    74\\t            if ((internal_idx & 1) == 0 && idx < max_idx) {\\n    75\\t                break;\\n    76\\t            }\\n    77\\t\\n    78\\t            /* Ok, we're at a right node */\\n    79\\t            /* Now combine the left and right logical nodes together */\\n    80\\t\\n    81\\t            /* Set the address of the node we're creating. */\\n    82\\t            internal_idx_offset >>= 1;\\n    83\\t            set_tree_height(tree_addr, h + 1);\\n    84\\t            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\\n    85\\t\\n    86\\t            unsigned char *left = &stack[h * SPX_N];\\n    87\\t            memcpy( &current[0], left, SPX_N );\\n    88\\t            thash( &current[1 * SPX_N],\\n    89\\t                   &current[0 * SPX_N],\\n    90\\t                   2, ctx, tree_addr);\\n    91\\t        }\\n    92\\t\\n    93\\t        /* We've hit a left child; save the current for when we get the */\\n    94\\t        /* corresponding right right */\\n    95\\t        memcpy( &stack[h * SPX_N], &current[SPX_N], SPX_N);\\n    96\\t    }\\n    97\\t}\\n    98\\t\\n    99\\tvoid fors_treehashx1(unsigned char *root, unsigned char *auth_path,\\n   100\\t\\t\\t     const spx_ctx* ctx,\\n   101\\t\\t\\t     uint32_t leaf_idx, uint32_t idx_offset,\\n   102\\t\\t\\t     uint32_t tree_height,\\n   103\\t\\t\\t     uint32_t tree_addr[8],\\n   104\\t\\t\\t     leaf_info_x1 *info)\\n   105\\t{\\n   106\\t    /* This is where we keep the intermediate nodes */\\n   107\\t    SPX_VLA(uint8_t, stack, tree_height*SPX_N);\\n   108\\t\\n   109\\t    uint32_t idx;\\n   110\\t    uint32_t max_idx = (uint32_t)((1 << tree_height) - 1);\\n   111\\t    for (idx = 0;; idx++) {\\n   112\\t        unsigned char current[2*SPX_N];   /* Current logical node is at */\\n   113\\t            /* index[SPX_N].  We do this to minimize the number of copies */\\n   114\\t            /* needed during a thash */\\n   115\\t\\n   116\\t\\t// IAN TODO: WARNING ON INFO PARAMETER\\n   117\\t        fors_gen_leafx1( &current[SPX_N], ctx, idx + idx_offset,\\n   118\\t\\t\\t\\t info );\\n   119\\t\\n   120\\t        /* Now combine the freshly generated right node with previously */\\n   121\\t        /* generated left ones */\\n   122\\t        uint32_t internal_idx_offset = idx_offset;\\n   123\\t        uint32_t internal_idx = idx;\\n   124\\t        uint32_t internal_leaf = leaf_idx;\\n   125\\t        uint32_t h;     /* The height we are in the Merkle tree */\\n   126\\t        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {\\n   127\\t\\n   128\\t            /* Check if we hit the top of the tree */\\n   129\\t            if (h == tree_height) {\\n   130\\t                /* We hit the root; return it */\\n   131\\t                memcpy( root, &current[SPX_N], SPX_N );\\n   132\\t                return;\\n   133\\t            }\\n   134\\t\\n   135\\t            /*\\n   136\\t             * Check if the node we have is a part of the\\n   137\\t             * authentication path; if it is, write it out\\n   138\\t             */\\n   139\\t            if ((internal_idx ^ internal_leaf) == 0x01) {\\n   140\\t                memcpy( &auth_path[ h * SPX_N ],\\n   141\\t                        &current[SPX_N],\\n   142\\t                        SPX_N );\\n   143\\t            }\\n   144\\t\\n   145\\t            /*\\n   146\\t             * Check if we're at a left child; if so, stop going up the stack\\n   147\\t             * Exception: if we've reached the end of the tree, keep on going\\n   148\\t             * (so we combine the last 4 nodes into the one root node in two\\n   149\\t             * more iterations)\\n   150\\t             */\\n   151\\t            if ((internal_idx & 1) == 0 && idx < max_idx) {\\n   152\\t                break;\\n   153\\t            }\\n   154\\t\\n   155\\t            /* Ok, we're at a right node */\\n   156\\t            /* Now combine the left and right logical