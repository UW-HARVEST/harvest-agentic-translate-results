mlen);\n   255\t    *smlen = siglen + mlen;\n   256\t\n   257\t    return 0;\n   258\t}\n   259\t\n   260\t/**\n   261\t * Verifies a given signature-message pair under a given public key.\n   262\t */\n   263\tint crypto_sign_open(unsigned char *m, unsigned long long *mlen,\n   264\t                     const unsigned char *sm, unsigned long long smlen,\n   265\t                     const unsigned char *pk)\n   266\t{\n   267\t    /* The API caller does not necessarily know what size a signature should be\n   268\t       but SPHINCS+ signatures are always exactly SPX_BYTES. */\n   269\t    if (smlen < SPX_BYTES) {\n   270\t        memset(m, 0, smlen);\n   271\t        *mlen = 0;\n   272\t        return -1;\n   273\t    }\n   274\t\n   275\t    *mlen = smlen - SPX_BYTES;\n   276\t\n   277\t    if (crypto_sign_verify(sm, SPX_BYTES, sm + SPX_BYTES, (size_t)*mlen, pk)) {\n   278\t        memset(m, 0, smlen);\n   279\t        *mlen = 0;\n   280\t        return -1;\n   281\t    }\n   282\t\n   283\t    /* If verification was successful, move the message to the right place. */\n   284\t    memmove(m, sm + SPX_BYTES, *mlen);\n   285\t\n   286\t    return 0;\n   287\t}\n===== c_src/app/src/rng.c\n     1\t//\n     2\t//  rng.c\n     3\t//\n     4\t//  Created by Bassham, Lawrence E (Fed) on 8/29/17.\n     5\t//  Copyright © 2017 Bassham, Lawrence E (Fed). All rights reserved.\n     6\t//\n     7\t\n     8\t#include <string.h>\n     9\t#include <openssl/conf.h>\n    10\t#include <openssl/evp.h>\n    11\t#include <openssl/err.h>\n    12\t\n    13\t#include \"../include/rng.h\"\n    14\t\n    15\tAES256_CTR_DRBG_struct  DRBG_ctx;\n    16\t\n    17\tvoid    AES256_ECB(unsigned char *key, unsigned char *ctr, unsigned char *buffer);\n    18\t\n    19\t/*\n    20\t seedexpander_init()\n    21\t ctx            - stores the current state of an instance of the seed expander\n    22\t seed           - a 32 byte random value\n    23\t diversifier    - an 8 byte diversifier\n    24\t maxlen         - maximum number of bytes (less than 2**32) generated under this seed and diversifier\n    25\t */\n    26\tint\n    27\tseedexpander_init(AES_XOF_struct *ctx,\n    28\t                  unsigned char *seed,\n    29\t                  unsigned char *diversifier,\n    30\t                  unsigned long maxlen)\n    31\t{\n    32\t    if ( maxlen >= 0x100000000 )\n    33\t        return RNG_BAD_MAXLEN;\n    34\t    \n    35\t    ctx->length_remaining = maxlen;\n    36\t    \n    37\t    memcpy(ctx->key, seed, 32);\n    38\t    \n    39\t    memcpy(ctx->ctr, diversifier, 8);\n    40\t    ctx->ctr[11] = (unsigned char)(maxlen % 256);\n    41\t    maxlen >>= 8;\n    42\t    ctx->ctr[10] = (unsigned char)(maxlen % 256);\n    43\t    maxlen >>= 8;\n    44\t    ctx->ctr[9] = (unsigned char)(maxlen % 256);\n    45\t    maxlen >>= 8;\n    46\t    ctx->ctr[8] = (unsigned char)(maxlen % 256);\n    47\t    memset(ctx->ctr+12, 0x00, 4);\n    48\t    \n    49\t    ctx->buffer_pos = 16;\n    50\t    memset(ctx->buffer, 0x00, 16);\n    51\t    \n    52\t    return RNG_SUCCESS;\n    53\t}\n    54\t\n    55\t/*\n    56\t seedexpander()\n    57\t    ctx  - stores the current state of an instance of the seed expander\n    58\t    x    - returns the XOF data\n    59\t    xlen - number of bytes to return\n    60\t */\n    61\tint\n    62\tseedexpander(AES_XOF_struct *ctx, unsigned char *x, unsigned long xlen)\n    63\t{\n    64\t    unsigned long   offset;\n    65\t    \n    66\t    if ( x == NULL )\n    67\t        return RNG_BAD_OUTBUF;\n    68\t    if ( xlen >= ctx->length_remaining )\n    69\t        return RNG_BAD_REQ_LEN;\n    70\t    \n    71\t    ctx->length_remaining -= xlen;\n    72\t    \n    73\t    offset = 0;\n    74\t    while ( xlen > 0 ) {\n    75\t        if ( xlen <= (16-ctx->buffer_pos) ) { // buffer has what we need\n    76\t            memcpy(x+offset, ctx->buffer+ctx->buffer_pos, xlen);\n    77\t            ctx->buffer_pos += xlen;\n    78\t            \n    79\t            return RNG_SUCCESS;\n    80\t        }\n    81\t        \n    82\t        // take what's in the buffer\n    83\t        memcpy(x+offset, ctx->buffer+ctx->buffer_pos, 16-ctx->buffer_pos);\n    84\t        xlen -= 16-ctx->buffer_pos;\n    85\t        offset += 16-ctx->buffer_pos;\n    86\t        \n    87\t        AES256_ECB(ctx->key, ctx->ctr, ctx->buffer);\n    88\t        ctx->buffer_pos = 0;\n    89\t        \n    90\t        //increment the counter\n    91\t        for (int i=15; i>=12; i--) {\n    92\t            if ( ctx->ctr[i] == 0xff )\n    93\t                ctx->ctr[i] = 0x00;\n    94\t            else {\n    95\t                ctx->ctr[i]++;\n    96\t                break;\n    97\t            }\n    98\t        }\n    99\t        \n   100\t    }\n   101\t    \n   102\t    return RNG_SUCCESS;\n   103\t}\n   104\t\n   105\t\n   106\tstatic void handleErrors(void)\n   107\t{\n   108\t    ERR_print_errors_fp(stderr);\n   109\t    abort();\n   110\t}\n   111\t\n   112\t// Use whatever AES implementation you have. This uses AES from openSSL library\n   113\t//    key - 256-bit AES key\n   114\t//    ctr - a 128-bit plaintext value\n   115\t//    buffer - a 128-bit ciphertext value\n   116\tvoid\n   117\tAES256_ECB(unsigned char *key, unsigned char *ctr, unsigned char *buffer)\n   118\t{\n   119\t    EVP_CIPHER_CTX *ctx;\n   120\t    \n   121\t    int len;\n   122\t    \n   123\t    /* Create and initialise the context */\n   124\t    if(!(ctx = EVP_CIPHER_CTX_new())) handleErrors();\n   125\t    \n   126\t    if(1 != EVP_EncryptInit_ex(ctx, EVP_aes_256_ecb(), NULL, key, NULL))\n   127\t        handleErrors();\n   128\t    \n   129\t    if(1 != EVP_EncryptUpdate(ctx, buffer, &len, ctr, 16))\n   130\t        handleErrors();\n   131\t    \n   132\t    /* Clean up */\n   133\t    EVP_CIPHER_CTX_free(ctx);\n   134\t}\n   135\t\n   136\tvoid\n   137\trandombytes_init(unsigned char *entropy_input,\n   138\t                 unsigned char *personalization_string)\n   139\t{\n   140\t    unsigned char   seed_material[48];\n   141\t    \n   142\t    memcpy(seed_material, entropy_input, 48);\n   143\t    if (personalization_string)\n   144\t        for (int i=0; i<48; i++)\n   145\t            seed_material[i] ^= personalization_string[i];\n   146\t    memset(DRBG_ctx.Key, 0x00, 32);\n   147\t    memset(DRBG_ctx.V, 0x00, 16);\n   148\t    AES256_CTR_DRBG_Update(seed_material, DRBG_ctx.Key, DRBG_ctx.V);\n   149\t    DRBG_ctx.reseed_counter = 1;\n   150\t}\n   151\t\n   152\tint\n   153\trandombytes(unsigned char *x, unsigned long long xlen)\n   154\t{\n   155\t    unsigned char   block[16];\n   156\t    int             i = 0;\n   157\t    \n   158\t    while ( xlen > 0 ) {\n   159\t        //increment V\n   160\t        for (int j=15; j>=0; j--) {\n   161\t            if ( DRBG_ctx.V[j] == 0xff )\n   162\t                DRBG_ctx.V[j] = 0x00;\n   163\t            else {\n   164\t                DRBG_ctx.V[j]++;\n   165\t                break;\n   166\t            }\n   167\t        }\n   168\t        AES256_ECB(DRBG_ctx.Key, DRBG_ctx.V, block);\n   169\t        if ( xlen > 15 ) {\n   170\t            memcpy(x+i, block, 16);\n   171\t            i += 16;\n   172\t            xlen -= 16;\n   173\t        }\n   174\t        else {\n   175\t            memcpy(x+i, block, xlen);\n   176\t            xlen = 0;\n   177\t        }\n   178\t    }\n   179\t    AES256_CTR_DRBG_Update(NULL, DRBG_ctx.Key, DRBG_ctx.V);\n   180\t    DRBG_ctx.reseed_counter++;\n   181\t    \n   182\t    return RNG_SUCCESS;\n   183\t}\n   184\t\n   185\tvoid\n   186\tAES256_CTR_DRBG_Update(unsigned char *provided_data,\n   187\t                       unsigned char *Key,\n   188\t                       unsigned char *V)\n   189\t{\n   190\t    unsigned char   temp[48];\n   191\t    \n   192\t    for (int i=0; i<3; i++) {\n   193\t        //increment V\n   194\t        for (int j=15; j>=0; j--) {\n   195\t            if ( V[j] == 0xff )\n   196\t                V[j] = 0x00;\n   197\t            else {\n   198\t                V[j]++;\n   199\t                break;\n   200\t            }\n   201\t        }\n   202\t        \n   203\t        AES256_ECB(Key, V, temp+16*i);\n   204\t    }\n   205\t    if ( provided_data != NULL )\n   206\t        for (int i=0; i<48; i++)\n   207\t            temp[i] ^= provided_data[i];\n   208\t    memcpy(Key, temp, 32);\n   209\t    memcpy(V, temp+32, 16);\n   210\t}\n   211\t\n   212\t\n   213\t\n   214\t\n   215\t\n   216\t\n   217\t\n   218\t\n   219\t\n===== c_src/app/src/randombytes.c\n     1\t/*\n     2\tThis code was taken from the SPHINCS reference implementation and is public domain.\n     3\t*/\n     4\t\n     5\t#include <fcntl.h>\n     6\t#include <unistd.h>\n     7\t\n     8\t#include \"../include/randombytes.h\"\n     9\t\n    10\tstatic int fd = -1;\n    11\t\n    12\tvoid randombytes(unsigned char *x, unsigned long long xlen)\n    13\t{\n    14\t    unsigned long long i;\n    15\t\n    16\t    if (fd == -1) {\n    17\t        for (;;) {\n    18\t            fd = open(\"/dev/urandom\", O_RDONLY);\n    19\t            if (fd != -1) {\n    20\t                break;\n    21\t            }\n    22\t            sleep(1);\n    23\t        }\n    24\t    }\n    25\t\n    26\t    while (xlen > 0) {\n    27\t        if (xlen < 1048576) {\n    28\t            i = xlen;\n    29\t        }\n    30\t        else {\n    31\t            i = 1048576;\n    32\t        }\n    33\t\n    34\t        i = (unsigned long long)read(fd, x, i);\n    35\t        if (i < 1) {\n    36\t            sleep(1);\n    37\t            continue;\n    38\t        }\n    39\t\n    40\t        x += i;\n    41\t        xlen -= i;\n    42\t    }\n    43\t}\n","exit_code":0,"status":"completed"}}
