{"type":"item.completed","item":{"id":"item_96","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,460p' c_src/lib/blake/src/blake256.c | tail -120; sed -n '350,430p' c_src/lib/blake/src/blake512.c; rg -n 'fn finalize|impl.*Digest|impl.*Input|impl.*FixedOutput' ~/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/blake-hash-0.4.1/src/lib.rs\"","aggregated_output":"\n\nvoid blake256_init( blakestate256 *S ) {\n\n  S->h[0]=0x6A09E667;\n  S->h[1]=0xBB67AE85;\n  S->h[2]=0x3C6EF372;\n  S->h[3]=0xA54FF53A;\n  S->h[4]=0x510E527F;\n  S->h[5]=0x9B05688C;\n  S->h[6]=0x1F83D9AB;\n  S->h[7]=0x5BE0CD19;\n  S->t[0]=S->t[1]=S->buflen=S->nullt=0;\n  S->s[0]=S->s[1]=S->s[2]=S->s[3] =0;\n}\n\n\nvoid blake256_update( blakestate256 *S, const u8 *data, u64 datalen ) {\n\n  int left=S->buflen >> 3; \n  int fill=64 - left;\n   \n  if( left && ( ((datalen >> 3) & 0x3F) >= fill ) ) {\n    memcpy( (void*) (S->buf + left), (void*) data, fill );\n    S->t[0] += 512;\n    if (S->t[0] == 0) S->t[1]++;      \n    blake256_compress( S, S->buf );\n    data += fill;\n    datalen  -= (fill << 3);       \n    left = 0;\n  }\n\n  while( datalen >= 512 ) {\n    S->t[0] += 512;\n    if (S->t[0] == 0) S->t[1]++;\n    blake256_compress( S, data );\n    data += 64;\n    datalen -= 512;\n  }\n  \n  if( datalen > 0 ) {\n    memcpy( (void*) (S->buf + left), (void*) data, datalen>>3 );\n    S->buflen = (left<<3) + datalen;\n  }\n  else S->buflen=0;\n}\n\n\nvoid blake256_final( blakestate256 *S, u8 *digest ) {\n  \n  u8 msglen[8], zo=0x01, oo=0x81;\n  u32 lo=S->t[0] + S->buflen, hi=S->t[1];\n  if ( lo < S->buflen ) hi++;\n  U32TO8(  msglen + 0, hi );\n  U32TO8(  msglen + 4, lo );\n\n  if ( S->buflen == 440 ) { /* one padding byte */\n    S->t[0] -= 8;\n    blake256_update( S, &oo, 8 );\n  }\n  else {\n    if ( S->buflen < 440 ) { /* enough space to fill the block  */\n      if ( !S->buflen ) S->nullt=1;\n      S->t[0] -= 440 - S->buflen;\n      blake256_update( S, padding, 440 - S->buflen );\n    }