6_inc_init(ctx->state_seeded);\n    sha256_inc_blocks(ctx->state_seeded, block, 1);\n#if SPX_SHA512\n    sha512_inc_init(ctx->state_seeded_512);\n    sha512_inc_blocks(ctx->state_seeded_512, block, 1);\n#endif\n}\n","exit_code":0,"status":"completed"}}
