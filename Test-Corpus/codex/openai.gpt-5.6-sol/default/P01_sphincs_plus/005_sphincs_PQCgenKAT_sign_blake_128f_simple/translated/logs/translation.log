te[i]);\n   102\t  }\n   103\t  return inlen;\n   104\t}\n   105\t\n   106\tpub fn sha256_inc_init(state: &mut[u8]) {\n   107\t  for i in 0..32 {\n   108\t    state[i] = IV_256[i];\n   109\t  }\n   110\t  for i in 32..40 {\n   111\t    state[i] = 0;\n   112\t  }\n   113\t}\n   114\t\n   115\tpub fn sha512_inc_init(state: &mut[u8]) {\n   116\t  for i in 0..64 {\n   117\t    state[i] = IV_512[i];\n   118\t  }\n   119\t  for i in 64..72 {\n   120\t    state[i] = 0;\n   121\t  }\n   122\t}\n   123\t\n   124\tpub fn sha256_inc_blocks(state: &mut [u8], input: &[u8], inblocks: usize) {\n   125\t  let mut bytes = load_bigendian_64(&state[32..]);\n   126\t  crypto_hashblocks_sha256(state, input, 64 * inblocks);\n   127\t  bytes += 64 * inblocks as u64;\n   128\t  store_bigendian_64(&mut state[32..], bytes);\n   129\t}\n   130\t\n   131\tpub fn sha512_inc_blocks(state: &mut[u8], input: &[u8], inblocks: usize) {\n   132\t  let mut bytes = load_bigendian_64(&state[64..]);\n   133\t  crypto_hashblocks_sha512(state, input, 128 * inblocks);\n   134\t  bytes += 128 * inblocks as u64;\n   135\t  store_bigendian_64(&mut state[64..], bytes);\n   136\t}\n   137\t\n   138\tpub fn sha256_inc_finalize(out: &mut[u8], state: &mut[u8], input: &[u8], mut inlen: usize) {\n   139\t  let mut padded = [0u8; 128];\n   140\t  let bytes = load_bigendian_64(&state[32..]) + inlen as u64;\n   141\t\n   142\t  crypto_hashblocks_sha256(state, input, inlen);\n   143\t  let mut idx = 0;\n   144\t  idx += inlen;\n   145\t  inlen &= 63;\n   146\t  idx -= inlen;\n   147\t\n   148\t  padded[..inlen].copy_from_slice(&input[idx..idx+inlen]);\n   149\t  padded[inlen as usize] = 0x80;\n   150\t\n   151\t  if inlen < 56 {\n   152\t    padded[(inlen+1)..56].fill(0);\n   153\t    padded[56] = (bytes >> 53) as u8;\n   154\t    padded[57] = (bytes >> 45) as u8;\n   155\t    padded[58] = (bytes >> 37) as u8;\n   156\t    padded[59] = (bytes >> 29) as u8;\n   157\t    padded[60] = (bytes >> 21) as u8;\n   158\t    padded