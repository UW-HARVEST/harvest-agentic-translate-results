\tpub struct Blake512State {\n   181\t    pub h: [u64; 8],\n   182\t    pub s: [u64; 4],\n   183\t    pub t: [u64; 2],\n   184\t    pub buflen: i32,\n   185\t    pub nullt: i32,\n   186\t    pub buf: [u8; 128],\n   187\t}\n   188\t\n   189\timpl Blake512State {\n   190\t    pub fn new() -> Self {\n   191\t        Self {\n   192\t            h: [\n   193\t                0x6a09e667f3bcc908, 0xbb67ae8584caa73b,\n   194\t                0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,\n   195\t                0x510e527fade682d1, 0x9b05688c2b3e6c1f,\n   196\t                0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,\n   197\t            ],\n   198\t            s: [0; 4],\n   199\t            t: [0; 2],\n   200\t            buflen: 0,\n   201\t            nullt: 0,\n   202\t            buf: [0; 128],\n   203\t        }\n   204\t    }\n   205\t\n   206\t    pub fn compress(&mut self, block: &[u8]) {\n   207\t        let mut m = [0u64; 16];\n   208\t        for (word, bytes) in m.iter_mut().zip(block.chunks_exact(8)) {\n   209\t            *word = u64::from_be_bytes(bytes.try_into().unwrap());\n   210\t        }\n   211\t        let mut v = [0u64; 16];\n   212\t        v[..8].copy_from_slice(&self.h);\n   213\t        for i in 0..4 {\n   214\t            v[8 + i] = self.s[i] ^ C64[i];\n   215\t        }\n   216\t        v[12..16].copy_from_slice(&C64[4..8]);\n   217\t        if self.nullt == 0 {\n   218\t            v[12] ^= self.t[0];\n   219\t            v[13] ^= self.t[0];\n   220\t            v[14] ^= self.t[1];\n   221\t            v[15] ^= self.t[1];\n   222\t        }\n   223\t        for round in 0..16 {\n   224\t            let sigma = &SIGMA[round % 10];\n   225\t            for i in 0..4 {\n   226\t                g64(&mut v, i, i + 4, i + 8, i + 12, i, sigma, &m);\n   227\t            }\n   228\t            g64(&mut v, 0, 5, 10, 15, 4, sigma, &m);\n   229\t            g64(&mut v, 1, 6, 11, 12, 5, sigma, &m);\n   230\t            g64(&mut v, 2, 7, 8, 13, 6, sigma, &m);\n   231\t            g64(&mut v, 3, 4, 9, 14, 7, sigma, &m);\n   232\t        }\n   233\t        for i in 0..8 {\n   234\t            self.h[i] ^= v[i] ^ v[i + 8] ^ self.s[i % 4];\n   235\t        }\n   236\t    }\n   237\t\n   238\t    pub fn update_bits(&mut self, mut data: &[u8], mut datalen: u64) {\n   239\t        let mut left = (self.buflen >> 3) as usize;\n   240\t        let fill = 128 - left;\n   241\t        if left != 0 && (((datalen >> 3) & 0x7f) as usize) >= fill {\n   242\t            self.buf[left..left + fill].copy_from_slice(&data[..fill]);\n   243\t            self.t[0] = self.t[0].wrapping_add(1024);\n   244\t            let block = self.buf;\n   245\t            self.compress(&block);\n   246\t            data = &data[fill..];\n   247\t            datalen -= (fill * 8) as u64;\n   248\t            left = 0;\n   249\t        }\n   250\t        while datalen >= 1024 {\n   251\t            self.t[0] = self.t[0].wrapping_add(1024);\n   252\t            self.compress(&data[..128]);\n   253\t            data = &data[128..];\n   254\t            datalen -= 1024;\n   255\t        }\n   256\t        if datalen > 0 {\n   257\t            let bytes = ((datalen >> 3) & 0x7f) as usize;\n   258\t            self.buf[left..left + bytes].copy_from_slice(&data[..bytes]);\n   259\t            self.buflen = (left as i32 * 8) + datalen as i32;\n   260\t        } else {\n   261\t            self.buflen = 0;\n   262\t        }\n   263\t    }\n   264\t\n   265\t    pub fn finalize(mut self) -> [u8; 64] {\n   266\t        let lo = self.t[0].wrapping_add(self.buflen as u64);\n   267\t        let hi = self.t[1].wrapping_add((lo < self.buflen as u64) as u64);\n   268\t        let mut msglen = [0u8; 16];\n   269\t        msglen[..8].copy_from_slice(&hi.to_be_bytes());\n   270\t        msglen[8..].copy_from_slice(&lo.to_be_bytes());\n   271\t        let mut padding = [0u8; 129];\n   272\t        padding[0] = 0x80;\n   273\t\n   274\t        if self.buflen == 888 {\n   275\t            self.t[0] = self.t[0].wrapping_sub(8);\n   276\t            self.update_bits(&[0x81], 8);\n   277\t        } else {\n   278\t            if self.buflen < 888 {\n   279\t                if self.buflen == 0 {\n   280\t                    self.nullt = 1;\n   281\t                }\n   282\t                let bits = (888 - self.buflen) as u64;\n   283\t                self.t[0] = self.t[0].wrapping_sub(bits);\n   284\t                self.update_bits(&padding, bits);\n   285\t            } else {\n   286\t                let bits = (1024 - self.buflen) as u64;\n   287\t                self.t[0] = self.t[0].wrapping_sub(bits);\n   288\t                self.update_bits(&padding, bits);\n   289\t                self.t[0] = self.t[0].wrapping_sub(888);\n   290\t                self.update_bits(&padding[1..], 888);\n   291\t                self.nullt = 1;\n   292\t            }\n   293\t            self.update_bits(&[0x01], 8);\n   294\t            self.t[0] = self.t[0].wrapping_sub(8);\n   295\t        }\n   296\t        self.t[0] = self.t[0].wrapping_sub(128);\n   297\t        self.update_bits(&msglen, 128);\n   298\t        let mut out = [0u8; 64];\n   299\t        for (bytes, word) in out.chunks_exact_mut(8).zip(self.h) {\n   300\t            bytes.copy_from_slice(&word.to_be_bytes());\n   301\t        }\n   302\t        out\n   303\t    }\n   304\t}\n   305\t\n   306\tfn g64(\n   307\t    v: &mut [u64; 16], a: usize, b: usize, c: usize, d: usize,\n   308\t    e: usize, sigma: &[usize; 16], m: &[u64; 16],\n   309\t) {\n   310\t    v[a] = v[a].wrapping_add(v[b]).wrapping_add(m[sigma[2 * e]] ^ C64[sigma[2 * e + 1]]);\n   311\t    v[d] = (v[d] ^ v[a]).rotate_right(32);\n   312\t    v[c] = v[c].wrapping_add(v[d]);\n   313\t    v[b] = (v[b] ^ v[c]).rotate_right(25);\n   314\t    v[a] = v[a].wrapping_add(v[b]).wrapping_add(m[sigma[2 * e + 1]] ^ C64[sigma[2 * e]]);\n   315\t    v[d] = (v[d] ^ v[a]).rotate_right(16);\n   316\t    v[c] = v[c].wrapping_add(v[d]);\n   317\t    v[b] = (v[b] ^ v[c]).rotate_right(11);\n   318\t}\n   319\t\n   320\tpub fn blake256(input: &[u8]) -> [u8; 32] {\n   321\t    let mut state = Blake256State::new();\n   322\t    state.update_bits(input, (input.len() as u64) * 8);\n   323\t    state.finalize()\n   324\t}\n   325\t\n   326\tpub fn blake512(input: &[u8]) -> [u8; 64] {\n   327\t    let mut state = Blake512State::new();\n   328\t    state.update_bits(input, (input.len() as u64) * 8);\n   329\t    state.finalize()\n   330\t}\n   331\t\n   332\tpub fn blake256_mgf1(out: &mut [u8], input: &[u8]) {\n   333\t    mgf1(out, input, false);\n   334\t}\n   335\t\n   336\tpub fn blake512_mgf1(out: &mut [u8], input: &[u8]) {\n   337\t    mgf1(out, input, true);\n   338\t}\n   339\t\n   340\tfn mgf1(out: &mut [u8], input: &[u8], wide: bool) {\n   341\t    let output_bytes = if wide { 64 } else { 32 };\n   342\t    let mut inbuf = Vec::with_capacity(input.len() + 4);\n   343\t    inbuf.extend_from_slice(input);\n   344\t    inbuf.extend_from_slice(&[0; 4]);\n   345\t    for (counter, chunk) in out.chunks_mut(output_bytes).enumerate() {\n   346\t        inbuf[input.len()..].copy_from_slice(&(counter as u32).to_be_bytes());\n   347\t        if wide {\n   348\t            chunk.copy_from_slice(&blake512(&inbuf)[..chunk.len()]);\n   349\t        } else {\n   350\t            chunk.copy_from_slice(&blake256(&inbuf)[..chunk.len()]);\n   351\t        }\n   352\t    }\n   353\t}\n   354\t\n   355\tpub fn blakex_buggy(parts: &[&[u8]]) -> Vec<u8> {\n   356\t    if crate::params::SPX_N >= 24 {\n   357\t        let mut state = Blake512State::new();\n   358\t        for part in parts {\n   359\t            state.update_bits(part, part.len() as u64);\n   360\t        }\n   361\t        state.finalize().to_vec()\n   362\t    } else {\n   363\t        let mut state = Blake256State::new();\n   364\t        for part in parts {\n   365\t            state.update_bits(part, part.len() as u64);\n   366\t        }\n   367\t        state.finalize().to_vec()\n   368\t    }\n   369\t}\n","exit_code":0,"status":"completed"}}
