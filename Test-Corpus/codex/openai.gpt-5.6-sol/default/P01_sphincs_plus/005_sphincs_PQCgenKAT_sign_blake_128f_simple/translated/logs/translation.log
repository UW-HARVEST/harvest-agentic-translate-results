{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc \"cat ~/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/pqc_sphincsplus-0.2.0/src/offsets/{haraka.rs,sha2.rs,shake.rs}; sed -n '1,120p' translation/src/sphincs/thash/haraka_robust.rs; sed -n '1,90p' translation/src/sphincs/context.rs\"","aggregated_output":"/// Offsets of various fields in the address structure when we use Haraka as\n/// the Sphincs+ hash function\n\npub const SPX_OFFSET_LAYER: usize = 3;   // The byte used to specify the Merkle tree layer\npub const SPX_OFFSET_TREE: usize = 8;   // The start of the 8 byte field used to specify the tree\npub const SPX_OFFSET_TYPE: usize = 19;  // The byte used to specify the hash type (reason)\npub const SPX_OFFSET_KP_ADDR2: usize = 22;  // The high byte used to specify the key pair (which one-time signature)\npub const SPX_OFFSET_KP_ADDR1: usize = 23;  // The low byte used to specify the key pair\npub const SPX_OFFSET_CHAIN_ADDR: usize = 27;  // The byte used to specify the chain address (which Winternitz chain)\npub const SPX_OFFSET_HASH_ADDR: usize = 31;  // The byte used to specify the hash address (where in the Winternitz chain)\npub const SPX_OFFSET_TREE_HGT: usize = 27;  // The byte used to specify the height of this node in the FORS or Merkle tree\npub const SPX_OFFSET_TREE_INDEX: usize = 28; // The start of the 4 byte field used to specify the node in the FORS or Merkle tree\n/// Offsets of various fields in the address structure when we use SHA2 as\n/// the Sphincs+ hash function\n\npub const SPX_OFFSET_LAYER: usize = 0;   //The byte used to specify the Merkle tree layer\npub const SPX_OFFSET_TREE: usize = 1;   //The start of the 8 byte field used to specify the tree\npub const SPX_OFFSET_TYPE: usize = 9;   //The byte used to specify the hash type (reason)\npub const SPX_OFFSET_KP_ADDR2: usize = 12;  //The high byte used to specify the key pair (which one-time signature)\npub const SPX_OFFSET_KP_ADDR1: usize = 13;  //The low byte used to specify the key pair\npub const SPX_OFFSET_CHAIN_ADDR: usize = 17;  //The byte used to specify the chain address (which Winternitz chain)\npub const SPX_OFFSET_HASH_ADDR: usize = 21;  //The byte used to specify the hash address (where in the Winternitz chain)\npub const SPX_OFFSET_TREE_HGT: usize = 17;  //The byte used to specify the height of this node in the FORS or Merkle tree\npub const SPX_OFFSET_TREE_INDEX: usize = 18; //The start of the 4 byte field used to specify the node in the FORS or Merkle tree///Offsets of various fields in the address structure when we use SHAKE as\n///the Sphincs+ hash function\n\n\npub const SPX_OFFSET_LAYER: usize = 3;   // The byte used to specify the Merkle tree layer\npub const SPX_OFFSET_TREE: usize = 8;   // The start of the 8 byte field used to specify the tree\npub const SPX_OFFSET_TYPE: usize = 19;  // The byte used to specify the hash type (reason)\npub const SPX_OFFSET_KP_ADDR2: usize = 22;  // The high byte used to specify the key pair (which one-time signature)\npub const SPX_OFFSET_KP_ADDR1: usize = 23;  // The low byte used to specify the key pair\npub const SPX_OFFSET_CHAIN_ADDR: usize = 27;  // The byte used to specify the chain address (which Winternitz chain)\npub const SPX_OFFSET_HASH_ADDR: usize = 31;  // The byte used to specify the hash address (where in the Winternitz chain)\npub const SPX_OFFSET_TREE_HGT: usize = 27;  // The byte used to specify the height of this node in the FORS or Merkle tree\npub const SPX_OFFSET_TREE_INDEX: usize = 28; // The start of the 4 byte field used to specify the node in the FORS or Merkle tree\nuse crate::{\n  params::*,\n  utils::*,\n  haraka::*,\n  context::SpxCtx\n};\n\n\n/// Takes an array of inblocks concatenated arrays of SPX_N bytes.\npub fn thash<const N: usize>(\n  out: &mut[u8], input: Option<&[u8]>,  ctx: &SpxCtx, addr: &[u32]\n)\n  where [(); SPX_ADDR_BYTES + N * SPX_N]: Sized\n{\n  let mut buf = [0u8; SPX_ADDR_BYTES + N * SPX_N];\n  let mut bitmask = [0u8; N * SPX_N];\n  let mut outbuf = [0u8; 32];\n  let mut buf_tmp = [0u8; 64];\n\n  if N == 1 {\n    // F function\n    // Since SPX_N may be smaller than 32, we need a temporary buffer.\n    buf_tmp[..32].copy_from_slice(&address_to_bytes(addr));\n\n    haraka256(&mut outbuf, &buf_tmp, ctx);\n    for i in 0..N * SPX_N {\n        buf_tmp[SPX_ADDR_BYTES + i] = input.unwrap_or(out)[i] ^ outbuf[i];\n    }\n    haraka512(&mut outbuf, &buf_tmp, ctx);\n    out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n  } else {\n    // All other tweakable hashes\n    buf[..32].copy_from_slice(&address_to_bytes(addr));\n    haraka_s(&mut bitmask, N * SPX_N, &buf, SPX_ADDR_BYTES, ctx);\n\n    for i in 0..N * SPX_N {\n        buf[SPX_ADDR_BYTES + i] = input.unwrap_or(out)[i] ^ bitmask[i];\n    }\n\n    haraka_s(out, SPX_N, &buf, SPX_ADDR_BYTES + N *SPX_N, ctx);\n  }\n}use crate::params::SPX_N;\n\n/// Sphincs context\npub struct SpxCtx {\n  pub pub_seed: [u8; SPX_N],\n  pub sk_seed: [u8; SPX_N],\n  \n  #[cfg(feature=\"sha2\")]\n  pub state_seeded: [u8; 40],\n  \n  #[cfg(all(feature=\"sha2\", not(any(feature=\"128f\", feature=\"128s\"))))]\n  pub state_seeded_512: [u8; 72],\n  \n  #[cfg(feature=\"haraka\")]\n  pub tweaked512_rc64: [[u64; 8]; 10],\n\n  #[cfg(feature=\"haraka\")]\n  pub tweaked256_rc32: [[u32; 8]; 10],\n}\n\nimpl Default for SpxCtx {\n  fn default() -> Self {\n      Self { \n        pub_seed: [0u8; SPX_N], \n        sk_seed: [0u8; SPX_N],\n\n        #[cfg(feature=\"sha2\")]\n        state_seeded: [0u8; 40],\n\n        #[cfg(all(feature=\"sha2\", not(any(feature=\"128f\", feature=\"128s\"))))]\n        state_seeded_512: [0u8; 72],\n\n        #[cfg(feature=\"haraka\")]\n        tweaked512_rc64: [[0u64; 8]; 10], \n\n        #[cfg(feature=\"haraka\")]\n        tweaked256_rc32: [[0u32; 8]; 10] \n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
