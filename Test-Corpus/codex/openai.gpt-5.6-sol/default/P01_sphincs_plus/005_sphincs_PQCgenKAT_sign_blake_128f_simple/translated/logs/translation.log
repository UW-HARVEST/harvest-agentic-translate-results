n    45\t        for y in 0..5 {\n    46\t            for x in 0..5 {\n    47\t                state[x + 5 * y] =\n    48\t                    b[x + 5 * y] ^ ((!b[(x + 1) % 5 + 5 * y]) & b[(x + 2) % 5 + 5 * y]);\n    49\t            }\n    50\t        }\n    51\t        state[0] ^= rc;\n    52\t    }\n    53\t}\n    54\t\n    55\tfn xor_byte(state: &mut [u64], offset: usize, byte: u8) {\n    56\t    state[offset >> 3] ^= (byte as u64) << (8 * (offset & 7));\n    57\t}\n    58\t\n    59\tfn get_byte(state: &[u64], offset: usize) -> u8 {\n    60\t    (state[offset >> 3] >> (8 * (offset & 7))) as u8\n    61\t}\n    62\t\n    63\tpub fn shake256_inc_init(state: &mut [u64; 26]) {\n    64\t    state.fill(0);\n    65\t}\n    66\t\n    67\tpub fn shake256_inc_absorb(state: &mut [u64; 26], mut input: &[u8]) {\n    68\t    while input.len() + state[25] as usize >= SHAKE256_RATE {\n    69\t        let take = SHAKE256_RATE - state[25] as usize;\n    70\t        for (i, byte) in input[..take].iter().enumerate() {\n    71\t            xor_byte(state, state[25] as usize + i, *byte);\n    72\t        }\n    73\t        input = &input[take..];\n    74\t        state[25] = 0;\n    75\t        keccak_f1600(state);\n    76\t    }\n    77\t    let offset = state[25] as usize;\n    78\t    for (i, byte) in input.iter().enumerate() {\n    79\t        xor_byte(state, offset + i, *byte);\n    80\t    }\n    81\t    state[25] += input.len() as u64;\n    82\t}\n    83\t\n    84\tpub fn shake256_inc_finalize(state: &mut [u64; 26]) {\n    85\t    xor_byte(state, state[25] as usize, 0x1f);\n    86\t    xor_byte(state, SHAKE256_RATE - 1, 0x80);\n    87\t    state[25] = 0;\n    88\t}\n    89\t\n    90\tpub fn shake256_inc_squeeze(out: &mut [u8], state: &mut [u64; 26]) {\n    91\t    let mut offset = 0;\n    92\t    while offset < out.len() && state[25] > 0 {\n    93\t        out[offset] = get_byte(state, SHAKE256_RATE - state[25] as usize);\n    94\t        state[25] -= 1;\n    95\t        offset += 1;\n    96\t    }\n    97\t    while offset < out.len() {\n    98\t        keccak_f1600(state);\n    99\t        let take = (out.len() - offset).min(SHAKE256_RATE);\n   100\t        for i in 0..take {\n   101\t            out[offset + i] = get_byte(state, i);\n   102\t        }\n   103\t        state[25] = (SHAKE256_RATE - take) as u64;\n   104\t        offset += take;\n   105\t    }\n   106\t}\n   107\t\n   108\tpub fn shake256_absorb(state: &mut [u64; 25], input: &[u8]) {\n   109\t    state.fill(0);\n   110\t    let mut offset = 0;\n   111\t    while input.len() - offset >= SHAKE256_RATE {\n   112\t        for i in 0..SHAKE256_RATE {\n   113\t            xor_byte(state, i, input[offset + i]);\n   114\t        }\n   115\t        keccak_f1600(state);\n   116\t        offset += SHAKE256_RATE;\n   117\t    }\n   118\t    for (i, byte) in input[offset..].iter().enumerate() {\n   119\t        xor_byte(state, i, *byte);\n   120\t    }\n   121\t    xor_byte(state, input.len() - offset, 0x1f);\n   122\t    xor_byte(state, SHAKE256_RATE - 1, 0x80);\n   123\t}\n   124\t\n   125\tpub fn shake256_squeezeblocks(out: &mut [u8], state: &mut [u64; 25]) {\n   126\t    for block in out.chunks_exact_mut(SHAKE256_RATE) {\n   127\t        keccak_f1600(state);\n   128\t        for (i, byte) in block.iter_mut().enumerate() {\n   129\t            *byte = get_byte(state, i);\n   130\t        }\n   131\t    }\n   132\t}\n   133\t\n   134\tpub fn shake256(out: &mut [u8], input: &[u8]) {\n   135\t    let mut state = [0u64; 25];\n   136\t    shake256_absorb(&mut state, input);\n   137\t    let full = out.len() / SHAKE256_RATE * SHAKE256_RATE;\n   138\t    shake256_squeezeblocks(&mut out[..full], &mut state);\n   139\t    if full < out.len() {\n   140\t        let mut block = [0u8; SHAKE256_RATE];\n   141\t        shake256_squeezeblocks(&mut block, &mut state);\n   142\t        let remainder = out.len() - full;\n   143\t        out[full..].copy_from_slice(&block[..remainder]);\n   144\t    }