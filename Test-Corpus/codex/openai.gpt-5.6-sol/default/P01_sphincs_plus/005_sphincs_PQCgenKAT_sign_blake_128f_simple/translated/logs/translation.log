{"type":"item.started","item":{"id":"item_285","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes, os\nroot = '..'\nmode = os.RTLD_LAZY | os.RTLD_GLOBAL\nctypes.CDLL(f'{root}/c_build_default/lib/haraka/libharaka.so', mode=mode)\nctypes.CDLL(f'{root}/c_build_default/app/libsphincs_core.so', mode=mode)\n\ncases = [\n    ('haraka-robust-128s', 'c_build_default/lib/haraka/libharaka.so', 'target/abi-haraka-robust/release/libsphincs_plus_translation.so', 16, 992),\n    ('haraka-simple-128f', 'c_build_haraka_simple_128f/lib/haraka/libharaka.so', 'target/abi-haraka-simple/release/libsphincs_plus_translation.so', 16, 992),\n    ('sha2-robust-256f', 'c_build_sha2_robust_256f/lib/sha2/libsha2.so', 'target/abi-sha2-robust/release/libsphincs_plus_translation.so', 32, 176),\n    ('sha2-simple-128f', 'c_build_sha2_simple_128f/lib/sha2/libsha2.so', 'target/abi-sha2-simple/release/libsphincs_plus_translation.so', 16, 72),\n    ('shake-robust-128s', 'c_build_shake/lib/shake/libshake.so', 'target/abi-shake-robust/release/libsphincs_plus_translation.so', 16, 32),\n    ('shake-simple-128f', 'c_build_shake_simple_128f/lib/shake/libshake.so', 'target/abi-shake-simple/release/libsphincs_plus_translation.so', 16, 32),\n    ('blake-robust-256f', 'c_build_blake_robust_256f/lib/blake/libblake.so', 'target/abi-blake-robust/release/libsphincs_plus_translation.so', 32, 64),\n    ('blake-simple-128f', 'c_build_blake_simple_128f/lib/blake/libblake.so', 'target/abi-blake-simple/release/libsphincs_plus_translation.so', 16, 32),\n]\nfor name, cpath, rpath, n, ctx_size in cases:\n    c = ctypes.CDLL(f'{root}/{cpath}', mode=os.RTLD_LAZY | os.RTLD_LOCAL)\n    r = ctypes.CDLL(rpath)\n    cctx = ctypes.create_string_buffer(ctx_size)\n    rctx = ctypes.create_string_buffer(ctx_size)\n    seed = bytes((i * 29 + 7) & 255 for i in range(n))\n    cctx.raw = seed + bytes(n) + bytes(ctx_size - 2*n)\n    rctx.raw = cctx.raw\n    c.SPX_initialize_hash_function(cctx)\n    r.SPX_initialize_hash_function(rctx)\n    assert cctx.raw == rctx.raw, (name, 'context')\n    addr = (ctypes.c_uint32 * 8)(*[0x10203040 \"'^ (i * 0x11111111) for i in range(8)])\n    for blocks in (1, 2, 3, 5):\n        data = bytes((i * 37 + blocks * 13) & 255 for i in range(blocks*n))\n        inp = (ctypes.c_ubyte * len(data)).from_buffer_copy(data)\n        co, ro = (ctypes.c_ubyte * n)(), (ctypes.c_ubyte * n)()\n        ca = (ctypes.c_uint32 * 8)(*addr)\n        ra = (ctypes.c_uint32 * 8)(*addr)\n        c.SPX_thash(co, inp, blocks, cctx, ca)\n        r.SPX_thash(ro, inp, blocks, rctx, ra)\n        assert bytes(co) == bytes(ro), (name, blocks, bytes(co).hex(), bytes(ro).hex())\n    print(f'\"'{name}: blocks 1,2,3,5 match')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
