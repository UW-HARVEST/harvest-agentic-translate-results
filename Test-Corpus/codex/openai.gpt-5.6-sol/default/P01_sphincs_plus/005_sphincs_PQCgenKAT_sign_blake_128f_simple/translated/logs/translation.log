{"type":"item.started","item":{"id":"item_223","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes, os\nroot = '..'\nc = ctypes.CDLL(f'{root}/c_build_blake/lib/blake/libblake.so', mode=os.RTLD_LOCAL | os.RTLD_LAZY)\nr = ctypes.CDLL('target/check-blake/release/libsphincs_plus_translation.so')\n\nclass B256(ctypes.Structure):\n    _fields_ = [('h', ctypes.c_uint32 * 8), ('s', ctypes.c_uint32 * 4),\n                ('t', ctypes.c_uint32 * 2), ('buflen', ctypes.c_int),\n                ('nullt', ctypes.c_int), ('buf', ctypes.c_ubyte * 64)]\nclass B512(ctypes.Structure):\n    _fields_ = [('h', ctypes.c_uint64 * 8), ('s', ctypes.c_uint64 * 4),\n                ('t', ctypes.c_uint64 * 2), ('buflen', ctypes.c_int),\n                ('nullt', ctypes.c_int), ('buf', ctypes.c_ubyte * 128)]\nassert ctypes.sizeof(B256) == 128\nassert ctypes.sizeof(B512) == 248\n\ndef raw(x):\n    return ctypes.string_at(ctypes.byref(x), ctypes.sizeof(x))\n\ndef check(bits, State, outlen, lengths):\n    init_c, init_r = getattr(c, f'blake{bits}_init'), getattr(r, f'blake{bits}_init')\n    upd_c, upd_r = getattr(c, f'blake{bits}_update'), getattr(r, f'blake{bits}_update')\n    fin_c, fin_r = getattr(c, f'blake{bits}_final'), getattr(r, f'blake{bits}_final')\n    for n in lengths:\n        sc, sr = State(), State()\n        ctypes.memset(ctypes.byref(sc), 0xA5, ctypes.sizeof(sc))\n        ctypes.memset(ctypes.byref(sr), 0xA5, ctypes.sizeof(sr))\n        init_c(ctypes.byref(sc)); init_r(ctypes.byref(sr))\n        assert raw(sc) == raw(sr), (bits, n, 'init')\n        data = bytes((i * 37 + 11) & 255 for i in range(n))\n        buf = (ctypes.c_ubyte * max(1, n)).from_buffer_copy(data or b'\\\\0')\n        split = min(n, 17)\n        upd_c(ctypes.byref(sc), buf, split * 8); upd_r(ctypes.byref(sr), buf, split * 8)\n        upd_c(ctypes.byref(sc), ctypes.byref(buf, split), (n-split) * 8)\n        upd_r(ctypes.byref(sr), ctypes.byref(buf, split), (n-split) * 8)\n        assert raw(sc) == raw(sr), (bits, n, 'update')\n        oc, or_ = (ctypes.c_ubyte * outlen)(), (ctypes.c_ubyte * outlen)()\n        fin_c(ctypes.byref(sc), oc); fin_r(ctypes.byref(sr), or_)\n        assert bytes(oc) == bytes(or_), (bits, n, 'digest')\n        assert raw(sc) == raw(sr), (bits, n, 'final-state')\n\ncheck(256, B256, 32, [0,1,17,54,55,56,63,64,65,119,120,127,128,129])\ncheck(512, B512, 64, [0,1,17,110,111,112,127,128,129,239,240,255,256,257])\nprint('BLAKE C/Rust state layouts, mutation, and boundary digests: match')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
