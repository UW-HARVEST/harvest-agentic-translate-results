{"type":"item.completed","item":{"id":"item_298","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/hash/blake.rs | sed -n '1,40p'; nl -ba src/utilsx1.rs | sed -n '1,120p'; nl -ba src/utils.rs | sed -n '85,105p'\"","aggregated_output":"     1\tuse crate::blake::*;\n     2\tuse crate::context::SpxCtx;\n     3\tuse crate::params::*;\n     4\tuse crate::utils::{address_to_bytes, bytes_to_ull};\n     5\t\n     6\tpub fn initialize_hash_function(_ctx: &mut SpxCtx) {}\n     7\t\n     8\tpub fn prf_addr(out: &mut [u8], ctx: &SpxCtx, addr: &mut [u32]) {\n     9\t    let mut buf = vec![0u8; 2 * SPX_N + SPX_ADDR_BYTES];\n    10\t    buf[..SPX_N].copy_from_slice(&ctx.pub_seed);\n    11\t    buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(&address_to_bytes(addr));\n    12\t    buf[SPX_N + SPX_ADDR_BYTES..].copy_from_slice(&ctx.sk_seed);\n    13\t\n    14\t    // Preserve the C source's truncated input length, which omits sk_seed.\n    15\t    let digest = blake256(&buf[..SPX_N + SPX_ADDR_BYTES]);\n    16\t    out[..SPX_N].copy_from_slice(&digest[..SPX_N]);\n    17\t}\n    18\t\n    19\tpub fn gen_message_random(\n    20\t    r: &mut [u8],\n    21\t    sk_prf: &[u8],\n    22\t    optrand: &[u8],\n    23\t    message: &[u8],\n    24\t    mlen: usize,\n    25\t    _ctx: &SpxCtx,\n    26\t) {\n    27\t    let digest = blakex_buggy(&[&sk_prf[..SPX_N], &optrand[..SPX_N], &message[..mlen]]);\n    28\t    r[..SPX_N].copy_from_slice(&digest[..SPX_N]);\n    29\t}\n    30\t\n    31\tpub fn hash_message(\n    32\t    digest: &mut [u8],\n    33\t    tree: &mut u64,\n    34\t    leaf_idx: &mut u32,\n    35\t    r: &[u8],\n    36\t    pk: &[u8],\n    37\t    message: &[u8],\n    38\t    mlen: usize,\n    39\t    _ctx: &SpxCtx,\n    40\t) {\n     1\tuse crate::context::SpxCtx;\n     2\tuse crate::fors::{ ForsGenLeafInfo, fors_gen_leafx1 };\n     3\tuse crate::params::*;\n     4\tuse crate::address::*;\n     5\tuse crate::thash::*;\n     6\tuse crate::wotsx1::{ LeafInfoX1, wots_gen_leafx1 };\n     7\t\n     8\t// TODO: dedup treehash functions\n     9\t\n    10\t/// Generate the entire Merkle tree, computing the authentication path for\n    11\t/// leaf_idx, and the resulting root node using Merkle's TreeHash algorithm.\n    12\t/// Expects the layer and tree parts of the tree_addr to be set, as well as the\n    13\t/// tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE)\n    14\t/// This expects tree_addr to be initialized to the addr structures for the \n    15\t/// Merkle tree nodes.\n    16\t/// \n    17\t/// Applies the offset idx_offset to indices before building addresses, so that\n    18\t/// it is possible to continue counting indices across trees.\n    19\t/// This works by using the standard Merkle tree building algorithm.\n    20\t/// T: tree_height\n    21\t/// S: stack.len()\n    22\tpub fn wots_treehashx1<const T: usize, const S: usize>(\n    23\t  root: &mut[u8], auth_path: &mut[u8], ctx: &SpxCtx, leaf_idx: u32, \n    24\t  idx_offset: u32, tree_addr: &mut[u32], info: &mut LeafInfoX1\n    25\t) \n    26\t{\n    27\t  let mut idx =  0u32;\n    28\t  let max_idx = (1 << T) - 1;\n    29\t  let mut stack = [0u8; S];\n    30\t  loop {\n    31\t    // Current logical node is at index[SPX_N].\n    32\t    // We do this to minimize the number of copies needed during a thash\n    33\t    let mut current = [0u8; 2*SPX_N];    \n    34\t\n    35\t    wots_gen_leafx1( &mut current[SPX_N..], ctx, idx + idx_offset, info);\n    36\t\n    37\t    // Now combine the freshly generated right node with previously\n    38\t    //  generated left ones\n    39\t    let mut internal_idx_offset = idx_offset; //TODO: Refactor \n    40\t    let mut internal_idx = idx;\n    41\t    let mut internal_leaf = leaf_idx;\n    42\t    // The height we are in the Merkle tree\n    43\t    let mut h =  0u32;      \n    44\t    loop {\n    45\t\n    46\t      // Check if we hit the top of the tree\n    47\t      if h == T as u32 {\n    48\t        // We hit the root; return it\n    49\t        root[..SPX_N].copy_from_slice(&current[SPX_N..SPX_N*2]);\n    50\t        return;\n    51\t      }\n    52\t      // Check if the node we have is a part of the\n    53\t      //authentication path; if it is, write it out\n    54\t      let start = h as usize * SPX_N;\n    55\t      if (internal_idx ^ internal_leaf) == 0x01 {\n    56\t        auth_path[start..][..SPX_N].copy_from_slice(&current[SPX_N..SPX_N*2]);\n    57\t      }\n    58\t\n    59\t       // Check if we're at a left child; if so, stop going up the stack\n    60\t       // Exception: if we've reached the end of the tree, keep on going\n    61\t       // (so we combine the last 4 nodes into the one root node in two\n    62\t       // more iterations)\n    63\t      if (internal_idx & 1) == 0 && idx < max_idx {\n    64\t        break;\n    65\t      }\n    66\t\n    67\t      // Ok, we're at a right node\n    68\t      // Now combine the left and right logical nodes together\n    69\t      // Set the address of the node we're creating.\n    70\t      internal_idx_offset >>= 1;\n    71\t      set_tree_height(tree_addr, h + 1);\n    72\t      set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );\n    73\t\n    74\t      current[  ..SPX_N].copy_from_slice(&stack[start..][..SPX_N]);\n    75\t      let tmp_current = current.clone();\n    76\t      thash::<2>( &mut current[SPX_N..], Some(&tmp_current), ctx, tree_addr);\n    77\t      h += 1; \n    78\t      internal_idx >>= 1;\n    79\t      internal_leaf >>= 1;\n    80\t    }\n    81\t\n    82\t    // We've hit a left child; save the current for when we get the\n    83\t    // corresponding right right\n    84\t    let start = h as usize * SPX_N;\n    85\t    stack[start..][..SPX_N].copy_from_slice(&current[SPX_N..SPX_N*2]);\n    86\t    idx += 1\n    87\t  }\n    88\t}\n    89\t\n    90\tpub fn fors_treehashx1<const T: usize, const S: usize>(\n    91\t  root: &mut[u8], auth_path: &mut[u8], ctx: &SpxCtx, leaf_idx: u32, \n    92\t  idx_offset: u32, tree_addr: &mut[u32; 8], info: &mut ForsGenLeafInfo\n    93\t) \n    94\t{\n    95\t  let mut stack = [0u8; S];\n    96\t  let mut idx =  0u32;\n    97\t  let max_idx = (1 << T) - 1;\n    98\t  loop {\n    99\t    let mut current = [0u8; 2*SPX_N];    \n   100\t\n   101\t    fors_gen_leafx1(&mut current[SPX_N..], ctx, idx + idx_offset, info);\n   102\t\n   103\t    let mut internal_idx_offset = idx_offset; //TODO: Refactor \n   104\t    let mut internal_idx = idx;\n   105\t    let mut internal_leaf = leaf_idx;\n   106\t    let mut h =  0u32;      \n   107\t    loop {\n   108\t      if h == T as u32 {\n   109\t        root[..SPX_N].copy_from_slice(&current[SPX_N..SPX_N*2]);\n   110\t        return;\n   111\t      }\n   112\t      let start = h as usize * SPX_N;\n   113\t      if (internal_idx ^ internal_leaf) == 0x01 {\n   114\t        auth_path[start..][..SPX_N].copy_from_slice(&current[SPX_N..SPX_N*2]);\n   115\t      }\n   116\t\n   117\t      if (internal_idx & 1) == 0 && idx < max_idx {\n   118\t        break;\n   119\t      }\n   120\t\n    85\t{\n    86\t  for i in 0..8 {\n    87\t    let mut addr_i = [0u8; 4];\n    88\t    addr_i.copy_from_slice(&bytes[i*4..][..4]);\n    89\t    addr[i] = u32::from_ne_bytes(addr_i);\n    90\t  }\n    91\t}\n    92\t\n    93\tpub fn address_to_bytes(addr: &[u32]) -> [u8; 32] \n    94\t{\n    95\t  let mut out = [0u8; 32];\n    96\t  for i in 0..8 {\n    97\t    out[i*4..][..4].copy_from_slice(&addr[i].to_ne_bytes()); //TODO: Check on BE in QEMU\n    98\t  }\n    99\t  out\n   100\t}\n","exit_code":0,"status":"completed"}}
