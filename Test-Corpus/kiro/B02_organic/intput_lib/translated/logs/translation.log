// ── stbds_strdup (internal) ────────────────────────────────────────────────
unsafe fn stbds_strdup(s: *const u8) -> *mut u8 {
    let len = strlen(s) + 1;
    let p = realloc(ptr::null_mut(), len);
    memmove(p, s, len);
    p
}

