#include <stdbool.h>
#include <stdio.h>

typedef struct {
    unsigned int x : 2;
    unsigned int y : 3;
    bool b : 1;
    int z;
} foo_t;

int main() {
    // Test various inputs to understand bitfield truncation
    unsigned int test_x[] = {0, 1, 2, 3, 4, 5, 0xFFFFFFFF};
    unsigned int test_y[] = {0, 1, 4, 7, 8, 15, 0xFFFFFFFF};
    bool test_b[] = {false, true};
    int test_z[] = {0, 1, -1, 42, -100, 0x7FFFFFFF};

    for (int i = 0; i < sizeof(test_x)/sizeof(test_x[0]); i++) {
        for (int j = 0; j < sizeof(test_b)/sizeof(test_b[0]); j++) {
            foo_t foo = {.x = test_x[i], .y = test_y[i], .b = test_b[j], .z = test_z[i % (sizeof(test_z)/sizeof(test_z[0]))]};
            printf("input: x=%u y=%u b=%d z=%d -> output: %u %u %d %d\n",
                   test_x[i], test_y[i], test_b[j], test_z[i % (sizeof(test_z)/sizeof(test_z[0]))],
                   foo.x, foo.y, foo.b, foo.z);
        }
    }
    return 0;
}
EOF
