#include <stdbool.h>
#include <stdio.h>
#include <stddef.h>

typedef struct {
    unsigned int x : 2;
    unsigned int y : 3;
    bool b : 1;
    int z;
} foo_t;

int main() {
    printf("sizeof(foo_t) = %zu\n", sizeof(foo_t));
    printf("offsetof(foo_t, z) = %zu\n", offsetof(foo_t, z));
    
    // Test bitfield layout
    foo_t f = {0};
    f.x = 3; f.y = 0; f.b = 0; f.z = 0;
    unsigned char *p = (unsigned char*)&f;
    printf("x=3,y=0,b=0,z=0: bytes[0..3] = %02x %02x %02x %02x\n", p[0], p[1], p[2], p[3]);
    
    f.x = 0; f.y = 7; f.b = 0; f.z = 0;
    printf("x=0,y=7,b=0,z=0: bytes[0..3] = %02x %02x %02x %02x\n", p[0], p[1], p[2], p[3]);
    
    f.x = 0; f.y = 0; f.b = 1; f.z = 0;
    printf("x=0,y=0,b=1,z=0: bytes[0..3] = %02x %02x %02x %02x\n", p[0], p[1], p[2], p[3]);
    
    f.x = 3; f.y = 7; f.b = 1; f.z = 42;
    printf("x=3,y=7,b=1,z=42: bytes = ");
    for (int i = 0; i < (int)sizeof(foo_t); i++) printf("%02x ", p[i]);
    printf("\n");
    
    return 0;
}
EOF
