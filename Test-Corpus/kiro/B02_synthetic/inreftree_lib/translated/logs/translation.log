#include <stdio.h>
#include <dlfcn.h>

typedef int (*inreftree_fn)(int, int, int, int);

int main() {
    void *c_lib = dlopen("./libc_version.so", RTLD_NOW);
    void *rs_lib = dlopen("./translated_rust/target/release/libtranslated_rust.so", RTLD_NOW);
    if (!c_lib || !rs_lib) {
        printf("dlopen failed: %s %s\n", dlerror(), dlerror());
        return 1;
    }
    inreftree_fn c_fn = dlsym(c_lib, "inreftree");
    inreftree_fn rs_fn = dlsym(rs_lib, "inreftree");

    int tests[][4] = {
        {10, 20, 30, 40},
        {0, 0, 0, 0},
        {1, 2, 3, 4},
        {-5, 10, -15, 20},
        {100, 200, 300, 400},
        {0, 1, 0, 1},
        {-1, -1, -1, -1},
        {2147483647, 1, 0, 0},
    };
    int n = sizeof(tests)/sizeof(tests[0]);
    int pass = 1;
    for (int i = 0; i < n; i++) {
        int c_r = c_fn(tests[i][0], tests[i][1], tests[i][2], tests[i][3]);
        int r_r = rs_fn(tests[i][0], tests[i][1], tests[i][2], tests[i][3]);
        if (c_r != r_r) {
            printf("MISMATCH(%d,%d,%d,%d): C=%d Rust=%d\n",
                tests[i][0], tests[i][1], tests[i][2], tests[i][3], c_r, r_r);
            pass = 0;
        } else {
            printf("OK(%d,%d,%d,%d) = %d\n",
                tests[i][0], tests[i][1], tests[i][2], tests[i][3], c_r);
        }
    }
    printf(pass ? "\nALL PASSED\n" : "\nSOME FAILED\n");
    dlclose(c_lib);
    dlclose(rs_lib);
    return !pass;
}
EOF
