# Test all operations
PASS=0; FAIL=0

run_test() {
    local desc="$1"; local input="$2"
    c_out=$(echo "$input" | $C_BIN 2>/dev/null)
    c_err=$(echo "$input" | $C_BIN 2>&1 >/dev/null)
    c_rc=$?
    r_out=$(echo "$input" | $R_BIN 2>/dev/null)
    r_err=$(echo "$input" | $R_BIN 2>&1 >/dev/null)
    r_rc=$?
    if [ "$c_out" = "$r_out" ] && [ "$c_rc" = "$r_rc" ] && [ "$c_err" = "$r_err" ]; then
        echo "PASS: $desc"
        PASS=$((PASS+1))
    else
        echo "FAIL: $desc"
        [ "$c_out" != "$r_out" ] && echo "  stdout C: $(echo "$c_out" | xxd | head -3)" && echo "  stdout R: $(echo "$r_out" | xxd | head -3)"
        [ "$c_err" != "$r_err" ] && echo "  stderr C: [$c_err]" && echo "  stderr R: [$r_err]"
        [ "$c_rc" != "$r_rc" ] && echo "  rc C: $c_rc  R: $r_rc"
        FAIL=$((FAIL+1))
    fi
}

# OP_COPY (0): copy first buffer
