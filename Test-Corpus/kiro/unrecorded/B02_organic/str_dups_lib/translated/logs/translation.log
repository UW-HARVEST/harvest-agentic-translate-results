use std::ffi::c_int;
use std::ptr;

const BUCKET_LENGTH: usize = 8;
const BUCKET_SHIFT: usize = 3;
const BUCKET_MASK: usize = BUCKET_LENGTH - 1;
const CACHE_LINE_SIZE: usize = 64;

const INDEX_EMPTY: isize = -1;
const INDEX_DELETED: isize = -2;

const HASH_EMPTY: usize = 0;
const HASH_DELETED: usize = 1;

const HM_STRING: i32 = 1;

const SH_NONE: u8 = 0;
const SH_DEFAULT: u8 = 1;
const SH_STRDUP: u8 = 2;
const SH_ARENA: u8 = 3;

const SIZE_T_BITS: u32 = 64;

const STRING_ARENA_BLOCKSIZE_MIN: usize = 512;
const STRING_ARENA_BLOCKSIZE_MAX: usize = 1 << 20;

static mut HASH_SEED: usize = 0x31415926;

#[repr(C)]
struct ArrayHeader {
    length: usize,
    capacity: usize,
    hash_table: *mut u8,
    temp: isize,
}

#[repr(C)]
struct StringBlock {
    next: *mut StringBlock,
    storage: [u8; 8],
}

#[repr(C)]
#[derive(Clone, Copy)]
struct StringArena {
    storage: *mut StringBlock,
    remaining: usize,
    block: u8,
    mode: u8,
}

#[repr(C)]
struct HashBucket {
    hash: [usize; BUCKET_LENGTH],
    index: [isize; BUCKET_LENGTH],
}

#[repr(C)]
struct HashIndex {
    temp_key: *mut u8,
    slot_count: usize,
    used_count: usize,
    used_count_threshold: usize,
    used_count_shrink_threshold: usize,
    tombstone_count: usize,
    tombstone_count_threshold: usize,
    seed: usize,
    slot_count_log2: usize,
    string: StringArena,
    storage: *mut HashBucket,
}

unsafe fn header(t: *mut u8) -> *mut ArrayHeader {
    (t as *mut ArrayHeader).offset(-1)
}

unsafe fn arr_len(a: *mut u8) -> isize {
    if a.is_null() { 0 } else { (*header(a)).length as isize }
}

unsafe fn arr_lenu(a: *mut u8) -> usize {
    if a.is_null() { 0 } else { (*header(a)).length }
}

unsafe fn arr_cap(a: *mut u8) -> usize {
    if a.is_null() { 0 } else { (*header(a)).capacity }
}

unsafe fn hash_to_arr(x: *mut u8, elemsize: usize) -> *mut u8 {
    x.sub(elemsize)
}

unsafe fn arr_to_hash(x: *mut u8, elemsize: usize) -> *mut u8 {
    x.add(elemsize)
}

unsafe fn hash_table(a: *mut u8) -> *mut HashIndex {
    (*header(a)).hash_table as *mut HashIndex
}

unsafe fn arrgrowf(a: *mut u8, elemsize: usize, addlen: usize, min_cap_in: usize) -> *mut u8 {
    let min_len = (arr_len(a) as usize).wrapping_add(addlen);
    let mut min_cap = min_cap_in;

    if min_len > min_cap {
        min_cap = min_len;
    }
    if min_cap <= arr_cap(a) {
        return a;
    }
    if min_cap < 2 * arr_cap(a) {
        min_cap = 2 * arr_cap(a);
    } else if min_cap < 4 {
        min_cap = 4;
    }

    let alloc_size = elemsize * min_cap + std::mem::size_of::<ArrayHeader>();
    let old_ptr = if !a.is_null() { header(a) as *mut u8 } else { ptr::null_mut() };
    let b_raw = libc::realloc(old_ptr as *mut libc::c_void, alloc_size) as *mut u8;
    let b = b_raw.add(std::mem::size_of::<ArrayHeader>());

    if a.is_null() {
        (*header(b)).length = 0;
        (*header(b)).hash_table = ptr::null_mut();
        (*header(b)).temp = 0;
    }
    (*header(b)).capacity = min_cap;
    b
}

unsafe fn arrfreef(a: *mut u8) {
    libc::free(header(a) as *mut libc::c_void);
}

fn stbds_log2(mut slot_count: usize) -> usize {
    let mut n: usize = 0;
    while slot_count > 1 {
        slot_count >>= 1;
        n += 1;
    }
    n
}

fn probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {
    hash & (slot_count - 1)
}

fn rotate_left(val: usize, n: u32) -> usize {
    val.rotate_left(n)
}

fn rotate_right(val: usize, n: u32) -> usize {
    val.rotate_right(n)
}

fn hash_string(str_ptr: *const u8, seed: usize) -> usize {
    let mut hash = seed;
    let mut p = str_ptr;
    unsafe {
        while *p != 0 {
            hash = rotate_left(hash, 9).wrapping_add(*p as usize);
            p = p.add(1);
        }
    }
    hash ^= seed;
    hash = (!hash).wrapping_add(hash << 18);
    hash ^= hash ^ rotate_right(hash, 31);
    hash = hash.wrapping_mul(21);
    hash ^= hash ^ rotate_right(hash, 11);
    hash = hash.wrapping_add(hash << 6);
    hash ^= rotate_right(hash, 22);
    hash.wrapping_add(seed)
}

fn siphash_bytes(p: *const u8, len: usize, seed: usize) -> usize {
    let d = p;
    let mut v0: usize = ((0x736f6d65_usize << 16) << 16).wrapping_add(0x70736575) ^ seed;
    let mut v1: usize = ((0x646f7261_usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;
    let mut v2: usize = ((0x6c796765_usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;
    let mut v3: usize = ((0x74656462_usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;

    v0 ^= 0x0706050403020100_usize ^ seed;
    v1 ^= 0x0f0e0d0c0b0a0908_usize ^ !seed;
    v2 ^= 0x0706050403020100_usize ^ seed;
    v3 ^= 0x0f0e0d0c0b0a0908_usize ^ !seed;

    macro_rules! sipround {
        () => {
            v0 = v0.wrapping_add(v1); v1 = rotate_left(v1, 13); v1 ^= v0; v0 = rotate_left(v0, (SIZE_T_BITS / 2));
            v2 = v2.wrapping_add(v3); v3 = rotate_left(v3, 16); v3 ^= v2;
            v2 = v2.wrapping_add(v1); v1 = rotate_left(v1, 17); v1 ^= v2; v2 = rotate_left(v2, (SIZE_T_BITS / 2));
            v0 = v0.wrapping_add(v3); v3 = rotate_left(v3, 21); v3 ^= v0;
        };
    }

    let mut i: usize = 0;
    unsafe {
        while i + 8 <= len {
            let dp = d.add(i);
            let lo = *dp.add(0) as usize
                | (*dp.add(1) as usize) << 8
                | (*dp.add(2) as usize) << 16
                | (*dp.add(3) as usize) << 24;
            let hi = *dp.add(4) as usize
                | (*dp.add(5) as usize) << 8
                | (*dp.add(6) as usize) << 16
                | (*dp.add(7) as usize) << 24;
            let data = lo | (hi << 16 << 16);

            v3 ^= data;
            for _ in 0..2 { sipround!(); }
            v0 ^= data;
            i += 8;
        }

        let mut data: usize = len << (SIZE_T_BITS - 8);
        let dp = d.add(i);
        let rem = len - i;
        // fallthrough switch
        if rem >= 7 { data |= (*dp.add(6) as usize) << 24 << 24; }
        if rem >= 6 { data |= (*dp.add(5) as usize) << 20 << 20; }
        if rem >= 5 { data |= (*dp.add(4) as usize) << 16 << 16; }
        if rem >= 4 { data |= (*dp.add(3) as usize) << 24; }
        if rem >= 3 { data |= (*dp.add(2) as usize) << 16; }
        if rem >= 2 { data |= (*dp.add(1) as usize) << 8; }
        if rem >= 1 { data |= *dp.add(0) as usize; }

        v3 ^= data;
        for _ in 0..2 { sipround!(); }
        v0 ^= data;
        v2 ^= 0xff;
        for _ in 0..4 { sipround!(); }
    }

    v0 ^ v1 ^ v2 ^ v3
}

unsafe fn is_key_equal(a: *mut u8, elemsize: usize, key: *const u8, keysize: usize, keyoffset: usize, mode: i32, i: isize) -> bool {
    if mode >= HM_STRING {
        let stored_key_ptr = *(a.add(elemsize * i as usize + keyoffset) as *const *const u8);
        libc::strcmp(key as *const i8, stored_key_ptr as *const i8) == 0
    } else {
        libc::memcmp(
            key as *const libc::c_void,
            a.add(elemsize * i as usize + keyoffset) as *const libc::c_void,
            keysize,
        ) == 0
    }
}

unsafe fn make_hash_index(slot_count: usize, ot: *mut HashIndex) -> *mut HashIndex {
    let num_buckets = slot_count >> BUCKET_SHIFT;
    let alloc_size = num_buckets * std::mem::size_of::<HashBucket>()
        + std::mem::size_of::<HashIndex>()
        + CACHE_LINE_SIZE - 1;
    let t = libc::realloc(ptr::null_mut(), alloc_size) as *mut HashIndex;

    let after_t = (t as usize) + std::mem::size_of::<HashIndex>();
    let aligned = (after_t + CACHE_LINE_SIZE - 1) & !(CACHE_LINE_SIZE - 1);
    (*t).storage = aligned as *mut HashBucket;
    (*t).slot_count = slot_count;
    (*t).slot_count_log2 = stbds_log2(slot_count);
    (*t).tombstone_count = 0;
    (*t).used_count = 0;
    (*t).used_count_threshold = slot_count - (slot_count >> 2);
    (*t).tombstone_count_threshold = (slot_count >> 3) + (slot_count >> 4);
    (*t).used_count_shrink_threshold = slot_count >> 2;

    if slot_count <= BUCKET_LENGTH {
        (*t).used_count_shrink_threshold = 0;
    }

    if !ot.is_null() {
        (*t).string = (*ot).string;
        (*t).seed = (*ot).seed;
    } else {
        ptr::write_bytes(&mut (*t).string as *mut StringArena as *mut u8, 0, std::mem::size_of::<StringArena>());
        (*t).seed = HASH_SEED;
        let mut a_val: usize;
        let mut b_val: usize;
        let mut temp: usize;
        // stbds_load_32_or_64(a, temp, 2147001325, 0x27bb2ee6, 0x87b0b0fd)
        temp = 0x87b0b0fd_usize ^ 2147001325_usize;
        temp <<= 16; temp <<= 16; temp >>= 16; temp >>= 16;
        a_val = 0x27bb2ee6_usize;
        a_val <<= 16; a_val <<= 16;
        a_val ^= temp ^ 2147001325_usize;

        // stbds_load_32_or_64(b, temp, 715136305, 0, 0xb504f32d)
        temp = 0xb504f32d_usize ^ 715136305_usize;
        temp <<= 16; temp <<= 16; temp >>= 16; temp >>= 16;
        b_val = 0_usize;
        b_val <<= 16; b_val <<= 16;
        b_val ^= temp ^ 715136305_usize;

        HASH_SEED = HASH_SEED.wrapping_mul(a_val).wrapping_add(b_val);
    }

    // Initialize buckets
    for i in 0..num_buckets {
        let b = &mut *(*t).storage.add(i);
        for j in 0..BUCKET_LENGTH {
            b.hash[j] = HASH_EMPTY;
        }
        for j in 0..BUCKET_LENGTH {
            b.index[j] = INDEX_EMPTY;
        }
    }

    // Rehash from old table
    if !ot.is_null() {
        (*t).used_count = (*ot).used_count;
        let old_num_buckets = (*ot).slot_count >> BUCKET_SHIFT;
        for i in 0..old_num_buckets {
            let ob = &*(*ot).storage.add(i);
            for j in 0..BUCKET_LENGTH {
                if ob.index[j] >= 0 {
                    let hash = ob.hash[j];
                    let mut pos = probe_position(hash, (*t).slot_count, (*t).slot_count_log2);
                    let mut step = BUCKET_LENGTH;
                    'outer: loop {
                        let bucket = &mut *(*t).storage.add(pos >> BUCKET_SHIFT);
                        let mut z = pos & BUCKET_MASK;
                        while z < BUCKET_LENGTH {
                            if bucket.hash[z] == 0 {
                                bucket.hash[z] = hash;
                                bucket.index[z] = ob.index[j];
                                break 'outer;
                            }
                            z += 1;
                        }
                        let limit = pos & BUCKET_MASK;
                        z = 0;
                        while z < limit {
                            if bucket.hash[z] == 0 {
                                bucket.hash[z] = hash;
                                bucket.index[z] = ob.index[j];
                                break 'outer;
                            }
                            z += 1;
                        }
                        pos += step;
                        step += BUCKET_LENGTH;
                        pos &= (*t).slot_count - 1;
                    }
                }
            }
        }
    }

    t
}

unsafe fn hm_find_slot(a: *mut u8, elemsize: usize, key: *const u8, keysize: usize, keyoffset: usize, mode: i32) -> isize {
    let raw_a = hash_to_arr(a, elemsize);
    let table = hash_table(raw_a);
    let hash_val = if mode >= HM_STRING {
        hash_string(key, (*table).seed)
    } else {
        siphash_bytes(key, keysize, (*table).seed)
    };
    let hash_val = if hash_val < 2 { hash_val + 2 } else { hash_val };
    let mut step = BUCKET_LENGTH;
    let mut pos = probe_position(hash_val, (*table).slot_count, (*table).slot_count_log2);

    loop {
        let bucket = &*(*table).storage.add(pos >> BUCKET_SHIFT);

        let mut i = pos & BUCKET_MASK;
        while i < BUCKET_LENGTH {
            if bucket.hash[i] == hash_val {
                if is_key_equal(a, elemsize, key, keysize, keyoffset, mode, bucket.index[i]) {
                    return ((pos & !BUCKET_MASK) + i) as isize;
                }
            } else if bucket.hash[i] == HASH_EMPTY {
                return -1;
            }
            i += 1;
        }

        let limit = pos & BUCKET_MASK;
        i = 0;
        while i < limit {
            if bucket.hash[i] == hash_val {
                if is_key_equal(a, elemsize, key, keysize, keyoffset, mode, bucket.index[i]) {
                    return ((pos & !BUCKET_MASK) + i) as isize;
                }
            } else if bucket.hash[i] == HASH_EMPTY {
                return -1;
            }
            i += 1;
        }

        pos += step;
        step += BUCKET_LENGTH;
        pos &= (*table).slot_count - 1;
    }
}

unsafe fn hmget_key_ts(a: *mut u8, elemsize: usize, key: *const u8, keysize: usize, temp: &mut isize, mode: i32) -> *mut u8 {
    let keyoffset: usize = 0;
    if a.is_null() {
        let new_a = arrgrowf(ptr::null_mut(), elemsize, 0, 1);
        (*header(new_a)).length += 1;
        ptr::write_bytes(new_a, 0, elemsize);
        *temp = INDEX_EMPTY;
        arr_to_hash(new_a, elemsize)
    } else {
        let raw_a = hash_to_arr(a, elemsize);
        let table = (*header(raw_a)).hash_table as *mut HashIndex;
        if table.is_null() {
            *temp = -1;
        } else {
            let slot = hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);
            if slot < 0 {
                *temp = INDEX_EMPTY;
            } else {
                let b = &*(*table).storage.add((slot as usize) >> BUCKET_SHIFT);
                *temp = b.index[slot as usize & BUCKET_MASK];
            }
        }
        a
    }
}

unsafe fn hmget_key(a: *mut u8, elemsize: usize, key: *const u8, keysize: usize, mode: i32) -> *mut u8 {
    let mut temp: isize = 0;
    let p = hmget_key_ts(a, elemsize, key, keysize, &mut temp, mode);
    (*header(hash_to_arr(p, elemsize))).temp = temp;
    p
}

unsafe fn hmput_default(a: *mut u8, elemsize: usize) -> *mut u8 {
    let mut a = a;
    if a.is_null() || (*header(hash_to_arr(a, elemsize))).length == 0 {
        let raw = if !a.is_null() { hash_to_arr(a, elemsize) } else { ptr::null_mut() };
        let new_a = arrgrowf(raw, elemsize, 0, 1);
        (*header(new_a)).length += 1;
        ptr::write_bytes(new_a, 0, elemsize);
        a = arr_to_hash(new_a, elemsize);
    }
    a
}

unsafe fn stbds_strdup(s: *const u8) -> *mut u8 {
    let len = libc::strlen(s as *const i8) + 1;
    let p = libc::realloc(ptr::null_mut(), len) as *mut u8;
    libc::memmove(p as *mut libc::c_void, s as *const libc::c_void, len);
    p
}

unsafe fn stralloc(arena: &mut StringArena, s: *const u8) -> *mut u8 {
    let len = libc::strlen(s as *const i8) + 1;
    if len > arena.remaining {
        let blocksize_shift = arena.block >> 1;
        let mut blocksize = STRING_ARENA_BLOCKSIZE_MIN << (blocksize_shift as usize);
        if blocksize < STRING_ARENA_BLOCKSIZE_MAX {
            arena.block += 1;
        }
        if len > blocksize {
            let sb_size = std::mem::size_of::<StringBlock>() - 8 + len;
            let sb = libc::realloc(ptr::null_mut(), sb_size) as *mut StringBlock;
            libc::memmove(
                (*sb).storage.as_mut_ptr() as *mut libc::c_void,
                s as *const libc::c_void,
                len,
            );
            if !arena.storage.is_null() {
                (*sb).next = (*arena.storage).next;
                (*arena.storage).next = sb;
            } else {
                (*sb).next = ptr::null_mut();
                arena.storage = sb;
                arena.remaining = 0;
            }
            return (*sb).storage.as_mut_ptr();
        } else {
            let sb_size = std::mem::size_of::<StringBlock>() - 8 + blocksize;
            let sb = libc::realloc(ptr::null_mut(), sb_size) as *mut StringBlock;
            (*sb).next = arena.storage;
            arena.storage = sb;
            arena.remaining = blocksize;
        }
    }
    assert!(len <= arena.remaining);
    let p = (*arena.storage).storage.as_mut_ptr().add(arena.remaining - len);
    arena.remaining -= len;
    libc::memmove(p as *mut libc::c_void, s as *const libc::c_void, len);
    p
}

unsafe fn strreset(arena: &mut StringArena) {
    let mut x = arena.storage;
    while !x.is_null() {
        let y = (*x).next;
        libc::free(x as *mut libc::c_void);
        x = y;
    }
    ptr::write_bytes(arena as *mut StringArena as *mut u8, 0, std::mem::size_of::<StringArena>());
}

