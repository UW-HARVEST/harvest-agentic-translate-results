import zlib, struct

# Test 1: Simple stored block (btype=0)
# Manual stored block: bfinal=1, btype=00, then LEN/NLEN/data
data = b'Hello'
LEN = len(data)
NLEN = LEN ^ 0xFFFF
# bfinal=1, btype=0 => bits: 1 (bfinal) + 00 (btype) = 0b001 = 0x01
stored = bytes([0x01]) + struct.pack('<HH', LEN, NLEN) + data
print('STORED:', stored.hex())

