#include <stdio.h>
#include <dlfcn.h>

typedef int (*fallcalc_fn)(int, int, int, int);

int main() {
    // Test cases covering various code paths
    int tests[][4] = {
        {1, 2, 3, 4},
        {0, 0, 0, 0},
        {-1, -2, -3, -4},
        {100, 200, 300, 400},
        {5, 10, 129, 7},    // param3 > 128 (OCTAL_FLAG)
        {3, 7, 0, 9},       // param3 % 5 == 0
        {3, 7, 1, 9},       // param3 % 5 == 1
        {3, 7, 2, 9},       // param3 % 5 == 2
        {3, 7, 3, 9},       // param3 % 5 == 3
        {3, 7, 4, 9},       // param3 % 5 == 4
        {2147483647, 0, 0, 0}, // INT_MAX
        {0, 2147483647, 0, 0},
        {1, 1, -1, -1},     // negative params
    };
    int n = sizeof(tests) / sizeof(tests[0]);

    // Load C library
    void *c_lib = dlopen("./c_src/build/libtranslated_rust.so", RTLD_NOW);
    if (!c_lib) {
        // Try building C first
        printf("C lib not found, building...\n");
        return 1;
    }
    fallcalc_fn c_fn = (fallcalc_fn)dlsym(c_lib, "fallcalc");

    // Load Rust library
    void *rs_lib = dlopen("./target/release/libtranslated_rust.so", RTLD_NOW);
    if (!rs_lib) {
        printf("Rust lib not found: %s\n", dlerror());
        return 1;
    }
    fallcalc_fn rs_fn = (fallcalc_fn)dlsym(rs_lib, "fallcalc");

    int pass = 1;
    for (int i = 0; i < n; i++) {
        int a = tests[i][0], b = tests[i][1], c = tests[i][2], d = tests[i][3];
        int c_res = c_fn(a, b, c, d);
        int rs_res = rs_fn(a, b, c, d);
        if (c_res != rs_res) {
            printf("MISMATCH test %d: fallcalc(%d,%d,%d,%d) C=%d Rust=%d\n", i, a, b, c, d, c_res, rs_res);
            pass = 0;
        } else {
            printf("OK test %d: fallcalc(%d,%d,%d,%d) = %d\n", i, a, b, c, d, c_res);
        }
    }
    dlclose(c_lib);
    dlclose(rs_lib);
    printf(pass ? "\nALL TESTS PASSED\n" : "\nSOME TESTS FAILED\n");
    return !pass;
}
