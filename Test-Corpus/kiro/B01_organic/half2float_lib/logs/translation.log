import re

with open('c_src/src/lib.c') as f:
    c = f.read()

def extract_array(name, c_text):
    # Find the array initializer
    pat = re.compile(r'static\s+\w+\s+' + name + r'\[\d+\]\s*=\s*\{([^;]+)\};', re.DOTALL)
    m = pat.search(c_text)
    vals = re.findall(r'0x[0-9a-fA-F]+', m.group(1))
    return vals

mantissa = extract_array('m__mantissa', c)
offset = extract_array('m__offset', c)
exponent = extract_array('m__exponent', c)

print(f'mantissa count: {len(mantissa)}')
print(f'offset count: {len(offset)}')
print(f'exponent count: {len(exponent)}')

# Build Rust file
lines = []
lines.append('#[allow(long_running_const_eval)]')
lines.append('')

def fmt_u32_array(name, vals, size):
    lines.append(f'static {name}: [u32; {size}] = [')
    row = []
    for v in vals:
        row.append(v)
        if len(row) == 6:
            lines.append('    ' + ', '.join(row) + ',')
            row = []
    if row:
        lines.append('    ' + ', '.join(row) + ',')
    lines.append('];')
    lines.append('')

def fmt_u16_array(name, vals, size):
    lines.append(f'static {name}: [u16; {size}] = [')
    row = []
    for v in vals:
        row.append(v)
        if len(row) == 8:
            lines.append('    ' + ', '.join(row) + ',')
            row = []
    if row:
        lines.append('    ' + ', '.join(row) + ',')
    lines.append('];')
    lines.append('')

fmt_u32_array('M_MANTISSA', mantissa, len(mantissa))
fmt_u16_array('M_OFFSET', offset, len(offset))
fmt_u32_array('M_EXPONENT', exponent, len(exponent))

lines.append('#[unsafe(no_mangle)]')
lines.append('pub extern \"C\" fn half2float(h: u16) -> f32 {')
lines.append('    let n = (h >> 10) as usize;')
lines.append('    let idx = (h & 0x3ff) as usize + M_OFFSET[n] as usize;')
lines.append('    let num = M_MANTISSA[idx].wrapping_add(M_EXPONENT[n]);')
lines.append('    f32::from_bits(num)')
lines.append('}')

with open('src/lib.rs', 'w') as f:
    f.write('\n'.join(lines) + '\n')

print('Generated src/lib.rs')
"
