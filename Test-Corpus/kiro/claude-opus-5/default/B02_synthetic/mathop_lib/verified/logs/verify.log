[0m[49m[38;5;10m+    636[0m:[38;5;10m[49m                 p.c.mathop(p1, p2, p3, 0),
[0m[49m[38;5;10m+    637[0m:[38;5;10m[49m                 p.r.mathop(p1, p2, p3, 0),
[0m[49m[38;5;10m+    638[0m:[38;5;10m[49m                 "row 23: mathop({p1}, {p2}, {p3}, 0)"
[0m[49m[38;5;10m+    639[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    640[0m:[38;5;10m[49m         }
