[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m     fn open(path: *const c_char, flags: c_int, ...) -> c_int;
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m     fn close(fd: c_int) -> c_int;
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m     fn fflush(stream: *mut c_void) -> c_int;
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m static STDOUT_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());
