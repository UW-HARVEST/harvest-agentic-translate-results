[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m // Row 21 — the static history saturates after 5 mathop calls, and that must
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m // NOT change the return value
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m fn err_21_history_saturates_after_five_calls() {
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m     let _quiet = SilentStdout::new();
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m     let c = Lib::c();
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m     let r = Lib::rust();
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m     let ts = c.get_computation_timestamp();
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m     // Same arguments 20 times in a row: the first 5 calls fill the 10 slots,
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m     // every later call finds the history full (row 13). The result must be
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m     // constant, and identical between the libraries.
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m     let (p1, p2, p3, p4) = (1234, 56, 7, 89);
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m     let expected = model_mathop(p1, p2, p3, p4, ts);
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m     for call in 0..20 {
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m         let vc = c.mathop(p1, p2, p3, p4);
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m         let vr = r.mathop(p1, p2, p3, p4);
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m         assert_eq!(vc, vr, "row 21: call {call}");
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m         assert_eq!(vc, expected, "row 21: call {call} — the history must not affect the result");
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m // Row 22 — divide-by-zero reached from mathop's first computation
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m fn err_22_mathop_divide_by_zero_path() {
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m     let _quiet = SilentStdout::new();
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m     let p = Pair::new();
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x22);
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m     // param3 % 5 == 3 -> selected_op == OP_DIVIDE
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m     for p3 in [3i32, 8, 13, 103, -2, -7] {
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m         assert_eq!(p3.wrapping_rem(5).wrapping_add(1), OP_DIVIDE, "p3 {p3} selects divide");
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m         for _ in 0..300 {
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m             let (p1, p4) = (rng.next_i32_mixed(), rng.next_i32_mixed());
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m             if model_would_trap(p1, 0, p3, p4) {
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m                 continue;
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m             let vc = p.c.mathop(p1, 0, p3, p4);
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m             let vr = p.r.mathop(p1, 0, p3, p4);
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m             assert_eq!(vc, vr, "row 22: mathop({p1}, 0, {p3}, {p4})");
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m             // The intermediate really was the 0 sentinel.
