[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m                 "row 22: the divide-by-zero sentinel must be 0"
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m // Row 23 — modulo-by-zero reached from mathop's second computation
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    603[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    604[0m:[38;5;10m[49m fn err_23_mathop_modulo_by_zero_path() {
[0m[49m[38;5;10m+    605[0m:[38;5;10m[49m     let _quiet = SilentStdout::new();
[0m[49m[38;5;10m+    606[0m:[38;5;10m[49m     let p = Pair::new();
[0m[49m[38;5;10m+    607[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x23);
[0m[49m[38;5;10m+    608[0m:[38;5;10m[49m     // (param4 + 1) % 5 == 4 -> second_op == OP_MODULO, and param4 == 0 would
[0m[49m[38;5;10m+    609[0m:[38;5;10m[49m     // then divide by zero. `(0+1) % 5 + 1 == 2`, so instead drive the *first*
