[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m // Row 29 — mathop's static history bootstraps, fills and saturates
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m fn cfg_29_mathop_static_history_saturation() {
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m     let _quiet = SilentStdout::new();
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m     // Fresh handles so each library starts from its own pristine statics.
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m     let c = Lib::c();
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m     let r = Lib::rust();
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 29);
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m     // 12 consecutive calls: calls 1..5 fill the 10 slots, 6..12 saturate.
