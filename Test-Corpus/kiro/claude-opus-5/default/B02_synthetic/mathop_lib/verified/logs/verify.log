[0m[49m[38;5;10m+      3[0m:[38;5;10m[49m //! One test per row of `ERRORS.md`. Rows whose C behaviour is a fatal signal
[0m[49m[38;5;10m+      4[0m:[38;5;10m[49m //! (`SIGFPE` from `INT_MIN / -1`, `SIGSEGV` from a NULL out-param) are run in a
[0m[49m[38;5;10m+      5[0m:[38;5;10m[49m //! child process so that *how the process died* can be compared instead of just
[0m[49m[38;5;10m+      6[0m:[38;5;10m[49m //! "something went wrong".
[0m[49m[38;5;10m+      7[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+      8[0m:[38;5;10m[49m mod common;
[0m[49m[38;5;10m+      9[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     10[0m:[38;5;10m[49m use common::*;
[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m use std::ffi::c_int;
[0m[49m[38;5;10m+     12[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m const SIGFPE: i32 = 8;
[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m const SIGSEGV: i32 = 11;
[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     16[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     17[0m:[38;5;10m[49m // Child-process entry point for the crashing rows.
[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+     19[0m:[38;5;10m[49m // Marked `#[ignore]` so a normal `cargo test` run never executes it; the parent
[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m // re-invokes this binary with `--ignored --exact crash_child_entry` and
[0m[49m[38;5;10m+     21[0m:[38;5;10m[49m // `HARVEST_CRASH_SCENARIO=<scenario>:<c|rust>`.
[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     23[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     24[0m:[38;5;10m[49m #[ignore]
[0m[49m[38;5;10m+     25[0m:[38;5;10m[49m fn crash_child_entry() {
[0m[49m[38;5;10m+     26[0m:[38;5;10m[49m     let spec = match std::env::var(CRASH_ENV) {
[0m[49m[38;5;10m+     27[0m:[38;5;10m[49m         Ok(s) => s,
[0m[49m[38;5;10m+     28[0m:[38;5;10m[49m         Err(_) => return, // invoked without a scenario: nothing to do
[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m     let (scenario, which) = spec.split_once(':').expect("scenario must be `name:lib`");
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m     let lib = match which {
[0m[49m[38;5;10m+     32[0m:[38;5;10m[49m         "c" => Lib::c(),
[0m[49m[38;5;10m+     33[0m:[38;5;10m[49m         "rust" => Lib::rust(),
[0m[49m[38;5;10m+     34[0m:[38;5;10m[49m         other => panic!("unknown library selector {other}"),
[0m[49m[38;5;10m+     35[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+     36[0m:[38;5;10m[49m     // Volatile-ish sink: the value is printed so nothing can be optimised out.
[0m[49m[38;5;10m+     37[0m:[38;5;10m[49m     // (Every call goes through a `dlsym`ed pointer anyway.)
[0m[49m[38;5;10m+     38[0m:[38;5;10m[49m     let sink: i32 = match scenario {
[0m[49m[38;5;10m+     39[0m:[38;5;10m[49m         // ERRORS rows 6 / 7 — INT_MIN / -1 and INT_MIN % -1 reach `idiv`.
[0m[49m[38;5;10m+     40[0m:[38;5;10m[49m         "div_intmin" => lib.divide_operation(i32::MIN, -1, 0),
[0m[49m[38;5;10m+     41[0m:[38;5;10m[49m         "mod_intmin" => lib.modulo_operation(i32::MIN, -1, 0),
[0m[49m[38;5;10m+     42[0m:[38;5;10m[49m         // ERRORS row 16 — NULL out-parameters are unchecked.
[0m[49m[38;5;10m+     43[0m:[38;5;10m[49m         "null_history" => unsafe {
[0m[49m[38;5;10m+     44[0m:[38;5;10m[49m             let mut count: c_int = 0;
[0m[49m[38;5;10m+     45[0m:[38;5;10m[49m             lib.perform_computation_with_history(1, 2, OP_ADD, std::ptr::null_mut(), &mut count)
[0m[49m[38;5;10m+     46[0m:[38;5;10m[49m         },
[0m[49m[38;5;10m+     47[0m:[38;5;10m[49m         "null_count" => unsafe {
[0m[49m[38;5;10m+     48[0m:[38;5;10m[49m             let mut buf = HistoryBuf::zeroed(HISTORY_CAPACITY);
[0m[49m[38;5;10m+     49[0m:[38;5;10m[49m             let mut hist = buf.as_mut_ptr();
[0m[49m[38;5;10m+     50[0m:[38;5;10m[49m             lib.perform_computation_with_history(1, 2, OP_ADD, &mut hist, std::ptr::null_mut())
[0m[49m[38;5;10m+     51[0m:[38;5;10m[49m         },
[0m[49m[38;5;10m+     52[0m:[38;5;10m[49m         "null_both" => unsafe {
[0m[49m[38;5;10m+     53[0m:[38;5;10m[49m             lib.perform_computation_with_history(
[0m[49m[38;5;10m+     54[0m:[38;5;10m[49m                 1,
[0m[49m[38;5;10m+     55[0m:[38;5;10m[49m                 2,
[0m[49m[38;5;10m+     56[0m:[38;5;10m[49m                 OP_ADD,
[0m[49m[38;5;10m+     57[0m:[38;5;10m[49m                 std::ptr::null_mut(),
[0m[49m[38;5;10m+     58[0m:[38;5;10m[49m                 std::ptr::null_mut(),
[0m[49m[38;5;10m+     59[0m:[38;5;10m[49m             )
[0m[49m[38;5;10m+     60[0m:[38;5;10m[49m         },
