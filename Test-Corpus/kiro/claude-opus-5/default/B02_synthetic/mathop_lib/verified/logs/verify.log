[0m[49m[38;5;10m+     58[0m:[38;5;10m[49m   n=${#FEATS[@]}
[0m[49m[38;5;10m+     59[0m:[38;5;10m[49m   for ((mask = 1; mask < (1 << n); mask++)); do
