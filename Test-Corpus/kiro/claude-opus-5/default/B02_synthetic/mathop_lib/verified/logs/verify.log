[0m[49m[38;5;10m+    622[0m:[38;5;10m[49m                 p.r.mathop(p1, 0, p3, p4),
[0m[49m[38;5;10m+    623[0m:[38;5;10m[49m                 "row 23: mathop({p1}, 0, {p3}, {p4})"
[0m[49m[38;5;10m+    624[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    625[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    626[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    627[0m:[38;5;10m[49m     // param4 == 0 makes the second computation's divisor zero; sweep every
