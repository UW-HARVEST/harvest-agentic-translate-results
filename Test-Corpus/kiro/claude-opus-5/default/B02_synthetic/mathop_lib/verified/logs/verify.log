[0m[49m[38;5;10m+     63[0m:[38;5;10m[49m         "mathop_div_fpe" => {
[0m[49m[38;5;10m+     64[0m:[38;5;10m[49m             let _quiet = SilentStdout::new();
[0m[49m[38;5;10m+     65[0m:[38;5;10m[49m             lib.mathop(i32::MIN, -1, 3, 7)
[0m[49m[38;5;10m+     66[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     67[0m:[38;5;10m[49m         // param3 == 4 -> selected_op == OP_MODULO.
[0m[49m[38;5;10m+     68[0m:[38;5;10m[49m         "mathop_mod_fpe" => {
[0m[49m[38;5;10m+     69[0m:[38;5;10m[49m             let _quiet = SilentStdout::new();
[0m[49m[38;5;10m+     70[0m:[38;5;10m[49m             lib.mathop(i32::MIN, -1, 4, 7)
[0m[49m[38;5;10m+     71[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     72[0m:[38;5;10m[49m         // Control: a scenario that must NOT crash, proving the harness can
[0m[49m[38;5;10m+     73[0m:[38;5;10m[49m         // tell a clean exit from a signal.
[0m[49m[38;5;10m+     74[0m:[38;5;10m[49m         "control_ok" => lib.divide_operation(i32::MIN, 1, 0),
[0m[49m[38;5;10m+     75[0m:[38;5;10m[49m         other => panic!("unknown scenario {other}"),
[0m[49m[38;5;10m+     76[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+     77[0m:[38;5;10m[49m     // Keep the value alive.
[0m[49m[38;5;10m+     78[0m:[38;5;10m[49m     std::hint::black_box(sink);
[0m[49m[38;5;10m+     79[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     80[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     81[0m:[38;5;10m[49m /// Runs one scenario on both libraries and requires identical termination.
[0m[49m[38;5;10m+     82[0m:[38;5;10m[49m fn assert_same_death(scenario: &str, expected: Outcome) {
