[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m             p.r.mathop(i32::MIN, p2, p3, p4),
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m             "row 20: mathop(INT_MIN, {p2}, {p3}, {p4})"
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m     }
