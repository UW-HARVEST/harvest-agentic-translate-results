[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m fn cfg_22_mathop_param3_selects_each_op() {
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     let _quiet = SilentStdout::new();
