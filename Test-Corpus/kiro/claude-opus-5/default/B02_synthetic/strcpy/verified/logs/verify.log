def run(p,d):
    q=subprocess.run([p],input=d,capture_output=True); return (q.stdout,q.stderr,q.returncode)
REPS=int(sys.argv[1]) if len(sys.argv)>1 else 120
ex=ThreadPoolExecutor(24)
def check(c):
    name,d=c
