[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m fn scanf_integer_conversion_edges() {
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m     // `%d` goes through strtol: it saturates at LONG_MAX/LONG_MIN and the
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m     // result is then truncated into an `int`.
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m     assert_same("op INT_MAX", b"2147483647 0 0 0");
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m     assert_same("op INT_MAX+1", b"2147483648 0 0 0");
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m     assert_same("op INT_MIN", b"-2147483648 0 0 0");
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m     assert_same("op INT_MIN-1", b"-2147483649 0 0 0");
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m     assert_same("op huge", b"99999999999999999999 0 0 0");
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m     assert_same("op huge negative", b"-99999999999999999999 0 0 0");
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m     assert_same("op 2^32", b"4294967296 0 0 0");
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m     assert_same("op 2^32-1", b"4294967295 0 0 0");
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m     // `%u` goes through strtoul: negatives wrap, huge values saturate.
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m     assert_same("flags UINT_MAX", b"0 4294967295 0 0");
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m     assert_same("flags 2^32", b"0 4294967296 0 0");
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m     assert_same("flags -1", b"0 -1 0 0");
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m     assert_same("flags -5", b"0 -5 0 0");
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m     assert_same("flags huge", b"0 18446744073709551617 0 0");
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m     // Leading zeros are decimal, and "0x41" stops at the 'x'.
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m     assert_same("byte with leading zeros", b"0 0 1 0041 0");
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m     assert_same("byte written as hex", b"0 0 1 0x41 0");
