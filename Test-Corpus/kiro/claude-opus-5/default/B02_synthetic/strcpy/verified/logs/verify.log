import json
nm=json.load(open('nulmap.json'))
iv=json.load(open('ivals.json')); rv=json.load(open('rvals.json'))
IFILL=0xf0; RFILL=0xf1
def finalize(vals, nul, fill):
    out=[]
    for k in range(1024):
        if nul[k]: out.append(0)
        elif vals[k]==-1: out.append(fill)
        else: out.append(vals[k])
    return out
i2=finalize(iv,nm['input'],IFILL)
r2=finalize(rv,nm['ref'],RFILL)
def emit(name, vals, doc):
    s = "/// %s\npub static %s: [u8; 1024] = [\n" % (doc, name)
    for i in range(0,1024,16):
        s += "    " + " ".join("0x%02x,"%v for v in vals[i:i+16]) + "\n"
    s += "];\n"
    return s
hdr = '''//! Model of the *uninitialised* stack contents that `main` in
//! `c_src/src/main.c` hands to `process_strings`.
//!
//! `main` declares
//!
//! ```c
//! char input_buffer[MAX_BUFFER_SIZE];
//! char ref_buffer[MAX_BUFFER_SIZE];
//! ```
//!
//! and only writes `input_len` / `ref_len` bytes into them.  Every byte past
//! that prefix keeps whatever the dynamic loader and libc start-up code left on
//! the stack, and `lib.c` reads those bytes constantly: `strlen`, `strcmp` and
//! `strncmp` all run past the caller-supplied length because the buffers are
//! never NUL-terminated.
//!
//! The tables below were recovered from the reference binary by probing it
//! through its own comparison operations (see `translation/ERRORS.md`).  The
//! residue is mostly leftover 64-bit stack pointers, so the pattern of NUL
//! bytes is stable while some individual non-zero bytes are randomised by ASLR
//! from run to run.  Positions whose value could not be pinned down are filled
//! with a non-zero placeholder (a different one per buffer, so that comparisons
//! *between* the two garbage regions fail the way they do in C).
//!
//! This file is data, not logic: `NUL` placement is what decides `strlen`, and
//! `strlen` is what decides almost every result the C code returns for a
//! partially filled buffer.

'''
open('/local/home/scheschb/.harvest/work/harvest-work-ugsjL2/translation/src/uninit.rs','w').write(
    hdr
    + emit('INPUT_RESIDUE', i2, 'Residue observed in `main`\'s `input_buffer`.')
    + "\n"
    + emit('REF_RESIDUE', r2, 'Residue observed in `main`\'s `ref_buffer`.'))
print("written", sum(1 for v in i2 if v==0), sum(1 for v in r2 if v==0))
EOF
