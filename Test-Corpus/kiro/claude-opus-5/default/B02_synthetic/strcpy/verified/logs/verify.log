[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m /// Abbreviated rendering of an input, so a failure on a 1024-byte buffer stays
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m /// readable.
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m fn show(data: &[u8]) -> String {
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m     let s = String::from_utf8_lossy(data);
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m     if s.len() <= 120 {
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m         s.into_owned()
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m     } else {
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m         format!("{}... ({} bytes)", &s[..120], data.len())
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m // input builders
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m /// Builds a well-formed stdin: operation, flags, input buffer, reference buffer.
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m fn input(op: i64, flags: u64, ib: &[u8], rb: &[u8]) -> Vec<u8> {
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m     let mut s = format!("{op} {flags} {}", ib.len());
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m     for b in ib {
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m         s.push_str(&format!(" {b}"));
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m     s.push_str(&format!(" {}", rb.len()));
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m     for b in rb {
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m         s.push_str(&format!(" {b}"));
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     s.push('\n');
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     s.into_bytes()
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m /// A C string: the bytes plus the NUL terminator, so the buffer the C code sees
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m /// really is terminated inside `input_len`.
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m fn z(s: &str) -> Vec<u8> {
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m     let mut v = s.as_bytes().to_vec();
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     v.push(0);
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     v
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m /// The bytes without a terminator, the way a caller who trusts `input_len`
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m /// would pass them.
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m fn raw(s: &str) -> Vec<u8> {
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m     s.as_bytes().to_vec()
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m // ===========================================================================
