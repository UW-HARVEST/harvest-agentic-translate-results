import subprocess, json
from concurrent.futures import ThreadPoolExecutor
C = "/local/home/scheschb/.harvest/work/harvest-work-ugsjL2/c_src/build/driver"
F = 7
def run(toks):
    p = subprocess.run([C], input=" ".join(map(str,toks)).encode(), capture_output=True)
    return p.stdout.decode().strip()
m = json.load(open("nulmap.json"))
rm = m["ref"]
ex = ThreadPoolExecutor(24)
rvals=[0]*1024
def ref_probe(p, c, tail):
    # input fully written: [F]*p + [c] + tail + zeros ; ref_len = p
    inp = [F]*p + [c] + tail
    inp = inp + [0]*(1024-len(inp))
    return run([0,0,1024]+inp+[p]+[F]*p) == "1"
# build runs of nonzero positions
p = 0
runs=[]
while p < 1024:
    if not rm[p]:
        q=p
        while q < 1024 and not rm[q]: q+=1
        runs.append((p,q)); p=q
    else: p+=1
unres=0
for (a,b) in runs:
    for pos in range(b-1, a-1, -1):
        tail = [rvals[j] for j in range(pos+1, b)]
        if any(t == -1 for t in tail):
            rvals[pos] = -1; unres+=1; continue
        hits=[c for c,ok in zip(range(1,256), ex.map(lambda c,pos=pos,tail=tail: ref_probe(pos,c,tail), range(1,256))) if ok]
        rvals[pos] = hits[0] if hits else -1
        if len(hits)!=1: print("ref[%d] hits=%s"%(pos,hits))
        if not hits: unres+=1
json.dump(rvals, open("rvals.json","w"))
print("ref done unresolved:", unres)
EOF
