def parse(path):
    data=open(path,'rb').read(); i=0; out=[]
    while i < len(data):
        j=data.index(b'\n', i); nl,dl=data[i:j].decode().split('\t'); nl=int(nl); dl=int(dl)
        i=j+1; name=data[i:i+nl].decode(); i+=nl; d=data[i:i+dl]; i+=dl
        out.append((name,d))
    return out
