fn expand(rle: &[(u8, u16)]) -> Vec<u8> {
    let mut out = Vec::with_capacity(1024);
    for &(v, n) in rle {
        for _ in 0..n {
            out.push(v);
        }
    }
    debug_assert_eq!(out.len(), 1024);
    out
}

/// Residue of the lower buffer (`ref_buffer`, at `rbp-0x830`).
pub fn ref_residue() -> Vec<u8> {
    expand(REF_RESIDUE_RLE)
}

/// Residue of the upper buffer (`input_buffer`, at `rbp-0x430`).
pub fn input_residue() -> Vec<u8> {
    expand(INPUT_RESIDUE_RLE)
}
