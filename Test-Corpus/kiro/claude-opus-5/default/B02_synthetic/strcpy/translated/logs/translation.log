def rle(b):
    out=[]; i=0
    while i<len(b):
        j=i
        while j<len(b) and b[j]==b[i]: j+=1
        out.append((b[i], j-i)); i=j
    return out
def fmt(b,name):
    r=rle(b)
    lines=[]
    cur='    '
    for v,n in r:
        tok='(%d,%d),'%(v,n)
        if len(cur)+len(tok)>96:
            lines.append(cur); cur='    '
        cur+=tok
    lines.append(cur)
    return "/// RLE (value, run-length) pairs; total 1024 bytes.\nstatic %s: &[(u8, u16)] = &[\n%s\n];\n"%(name,'\n'.join(lines))
