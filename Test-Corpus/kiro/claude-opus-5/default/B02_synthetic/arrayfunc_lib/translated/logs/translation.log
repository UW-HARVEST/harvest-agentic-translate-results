            f_sub(e[i],e[j],5,6), f_mod(e[i],e[j],7,8));

    double ds[]={0.0,-0.0,0.5,-0.5,1.9,-1.9,2147483647.0,2147483646.9,
        -2147483648.0,-2147483647.5,2147483648.0,-2147483649.0,1e300,-1e300,
        0.0/0.0, 1.0/0.0, -1.0/0.0, 3.333, -3.333, 1e-300};
    int nd=sizeof(ds)/sizeof(*ds);
    for(int i=0;i<nd;i++) printf("s2i %.17g -> %d\n", ds[i], f_s2i(ds[i]));
    for(int i=0;i<n;i++)for(int j=0;j<nd;j++)
        printf("csv %d %.17g -> %d\n", e[i], ds[j], f_csv(e[i],ds[j]));

    // struct-based
