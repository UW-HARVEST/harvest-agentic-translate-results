    int (*f_pwf)(ResultArray*,opf)=dlsym(h,"process_with_foreach");
    int (*f_cws)(ResultArray*)=dlsym(h,"compute_weighted_sum");

    printf("sizeof=%zu offs=%zu,%zu,%zu\n", sizeof(ResultArray),
