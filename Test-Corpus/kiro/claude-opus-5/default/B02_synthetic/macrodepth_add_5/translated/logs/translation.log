[0m[49m[38;5;10m+    37[0m:[38;5;10m[49m         magnitude = magnitude.saturating_mul(10).saturating_add(digit);
[0m[49m[38;5;10m+    38[0m:[38;5;10m[49m         idx += 1;
[0m[49m[38;5;10m+    39[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    40[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    41[0m:[38;5;10m[49m     let value: i64 = if negative {
[0m[49m[38;5;10m+    42[0m:[38;5;10m[49m         // LONG_MIN is one further out than -LONG_MAX; saturating_neg keeps the
[0m[49m[38;5;10m+    43[0m:[38;5;10m[49m         // clamp on the negative side too.
[0m[49m[38;5;10m+    44[0m:[38;5;10m[49m         magnitude.saturating_neg()
[0m[49m[38;5;10m+    45[0m:[38;5;10m[49m     } else {
