[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m #[cfg(all(
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m     feature = "3",
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m     not(any(feature = "0", feature = "1", feature = "2"))
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m ))]
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m pub const REPEAT: c_int = 3;
