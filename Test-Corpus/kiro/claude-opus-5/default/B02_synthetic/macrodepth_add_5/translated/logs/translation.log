[0m[49m[38;5;10m+    13[0m:[38;5;10m[49m /// glibc keeps the observable behaviour aligned with the reference binary.
[0m[49m[38;5;10m+    14[0m:[38;5;10m[49m pub fn atoi(s: &[u8]) -> c_int {
[0m[49m[38;5;10m+    15[0m:[38;5;10m[49m     let mut idx = 0usize;
[0m[49m[38;5;10m+    16[0m:[38;5;10m[49m 
