[0m[49m[38;5;10m+    105[0m:[38;5;10m[49m /// One `STEP_add` application.
[0m[49m[38;5;10m+    106[0m:[38;5;10m[49m #[cfg(all(not(feature = "sub"), not(feature = "mul")))]
[0m[49m[38;5;10m+    107[0m:[38;5;10m[49m #[inline]
[0m[49m[38;5;10m+    108[0m:[38;5;10m[49m pub fn step(acc: c_int, i: c_int) -> c_int {
[0m[49m[38;5;10m+    109[0m:[38;5;10m[49m     acc.wrapping_add(i)
[0m[49m[38;5;10m+    110[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    111[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    112[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    113[0m:[38;5;10m[49m // REPEAT selection  (`#define REPEAT 5` / `-DREPEAT=...`)
[0m[49m[38;5;10m+    114[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    115[0m:[38;5;10m[49m //
