[0m[49m[38;5;10m+    10[0m:[38;5;10m[49m /// `fwrite(bytes, 1, n, stdout)` -- errors ignored, as `printf`'s return value is.
[0m[49m[38;5;10m+    11[0m:[38;5;10m[49m pub fn print_bytes(bytes: &[u8]) {
[0m[49m[38;5;10m+    12[0m:[38;5;10m[49m     let stdout = std::io::stdout();
