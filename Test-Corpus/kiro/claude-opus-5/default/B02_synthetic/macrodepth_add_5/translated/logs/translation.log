[0m[49m[38;5;10m+    100[0m:[38;5;10m[49m #[inline]
[0m[49m[38;5;10m+    101[0m:[38;5;10m[49m pub fn step(acc: c_int, i: c_int) -> c_int {
[0m[49m[38;5;10m+    102[0m:[38;5;10m[49m     acc.wrapping_sub(i)
