[0m[49m[38;5;10m+     72[0m:[38;5;10m[49m #[cfg(feature = "mul")]
[0m[49m[38;5;10m+     73[0m:[38;5;10m[49m pub const OP_FN: extern "C" fn(c_int, c_int) -> c_int = crate::mdcore::op_mul;
[0m[49m[38;5;10m+     74[0m:[38;5;10m[49m #[cfg(all(feature = "sub", not(feature = "mul")))]
[0m[49m[38;5;10m+     75[0m:[38;5;10m[49m pub const OP_FN: extern "C" fn(c_int, c_int) -> c_int = crate::mdcore::op_sub;
[0m[49m[38;5;10m+     76[0m:[38;5;10m[49m #[cfg(all(not(feature = "sub"), not(feature = "mul")))]
[0m[49m[38;5;10m+     77[0m:[38;5;10m[49m pub const OP_FN: extern "C" fn(c_int, c_int) -> c_int = crate::mdcore::op_add;
[0m[49m[38;5;10m+     78[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     79[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     80[0m:[38;5;10m[49m // STEP_OP(op, acc, i)
[0m[49m[38;5;10m+     81[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     82[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+     83[0m:[38;5;10m[49m //   #define STEP_add(acc, i) ((acc) += (i))
[0m[49m[38;5;10m+     84[0m:[38;5;10m[49m //   #define STEP_sub(acc, i) ((acc) -= (i))
[0m[49m[38;5;10m+     85[0m:[38;5;10m[49m //   #define STEP_mul(acc, i) ((acc) *= ((i) + 1))
[0m[49m[38;5;10m+     86[0m:[38;5;10m[49m //
