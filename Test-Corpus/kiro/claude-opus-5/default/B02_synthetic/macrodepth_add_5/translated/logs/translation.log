[0m[49m[38;5;10m+    18[0m:[38;5;10m[49m     while idx < s.len()
[0m[49m[38;5;10m+    19[0m:[38;5;10m[49m         && matches!(
[0m[49m[38;5;10m+    20[0m:[38;5;10m[49m             s[idx],
[0m[49m[38;5;10m+    21[0m:[38;5;10m[49m             b' ' | b'\t' | b'\n' | 0x0b /* \v */ | 0x0c /* \f */ | b'\r'
[0m[49m[38;5;10m+    22[0m:[38;5;10m[49m         )
[0m[49m[38;5;10m+    23[0m:[38;5;10m[49m     {
[0m[49m[38;5;10m+    24[0m:[38;5;10m[49m         idx += 1;
[0m[49m[38;5;10m+    25[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    26[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    27[0m:[38;5;10m[49m     let mut negative = false;
[0m[49m[38;5;10m+    28[0m:[38;5;10m[49m     if idx < s.len() && (s[idx] == b'+' || s[idx] == b'-') {
[0m[49m[38;5;10m+    29[0m:[38;5;10m[49m         negative = s[idx] == b'-';
[0m[49m[38;5;10m+    30[0m:[38;5;10m[49m         idx += 1;
[0m[49m[38;5;10m+    31[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    32[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    33[0m:[38;5;10m[49m     // Accumulate the magnitude, saturating the way strtol clamps to LONG_MAX.
[0m[49m[38;5;10m+    34[0m:[38;5;10m[49m     let mut magnitude: i64 = 0;
