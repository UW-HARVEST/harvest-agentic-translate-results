[0m[49m[38;5;10m+     92[0m:[38;5;10m[49m #[cfg(feature = "mul")]
[0m[49m[38;5;10m+     93[0m:[38;5;10m[49m #[inline]
[0m[49m[38;5;10m+     94[0m:[38;5;10m[49m pub fn step(acc: c_int, i: c_int) -> c_int {
[0m[49m[38;5;10m+     95[0m:[38;5;10m[49m     acc.wrapping_mul(i.wrapping_add(1))
