[0m[49m[38;5;10m+     35[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+     36[0m:[38;5;10m[49m //! `REPEAT` is bounded by 0..=7 in C as well: `RUN_LOOP` expands to
[0m[49m[38;5;10m+     37[0m:[38;5;10m[49m //! `CHOOSE_REP(REPEAT)`, i.e. `REP<REPEAT>`, and the header only defines
[0m[49m[38;5;10m+     38[0m:[38;5;10m[49m //! `REP0` through `REP7`.
[0m[49m[38;5;10m+     39[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     40[0m:[38;5;10m[49m use core::ffi::c_int;
[0m[49m[38;5;10m+     41[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     42[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     43[0m:[38;5;10m[49m // OP selection  (`#define OP add` / `-DOP=...`)
[0m[49m[38;5;10m+     44[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     45[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+     46[0m:[38;5;10m[49m // Precedence is mul > sub > add so that enabling a non-default OP feature wins
[0m[49m[38;5;10m+     47[0m:[38;5;10m[49m // over the `add` that arrives with `default`. Absence of every OP feature falls
[0m[49m[38;5;10m+     48[0m:[38;5;10m[49m // back to `add`, matching the header's `#ifndef OP / #define OP add`.
[0m[49m[38;5;10m+     49[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     50[0m:[38;5;10m[49m /// `STR(OP)` -- the operation name as a NUL-terminated C string body.
[0m[49m[38;5;10m+     51[0m:[38;5;10m[49m ///
