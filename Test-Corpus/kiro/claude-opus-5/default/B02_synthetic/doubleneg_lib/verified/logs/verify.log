    66	// ---------------------------------------------------------------------------
    67	// C semantics helpers
    68	// ---------------------------------------------------------------------------
    69	
    70	/// Reproduces `(int)value` for a `double` on x86-64 (the `cvttsd2si`
    71	/// instruction): truncation toward zero, and the "integer indefinite" value
    72	/// `INT_MIN` whenever the result is not representable (including NaN and the
    73	/// infinities). The original C relies on this undefined behaviour, so the
    74	/// platform result is reproduced rather than corrected.
    75	fn c_double_to_int(value: f64) -> i32 {
    76	    if value.is_nan() {
    77	        return i32::MIN;
    78	    }
    79	    let truncated = value.trunc();
    80	    if truncated >= -2147483648.0 && truncated <= 2147483647.0 {
    81	        truncated as i32
    82	    } else {
    83	        i32::MIN
    84	    }
    85	}
