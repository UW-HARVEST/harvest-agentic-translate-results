===== doubles.rs =====
     1	//! Translation of `calculate_with_doubles`.
     2	
     3	use core::ffi::c_int;
     4	
     5	use crate::ffi;
     6	
     7	/// ```c
     8	/// double calculate_with_doubles(int a, int b, int c) {
     9	///     double result = 0.0;
    10	///
    11	///     if (b != 0) {
    12	///         result = (double)a / (double)b;
    13	///     }
    14	///
    15	///     result *= pow(10.0, c % 10);
    16	///
    17	///     return result;
    18	/// }
    19	/// ```
    20	///
    21	/// Note that the multiplication happens unconditionally, so a zero `b` still
    22	/// yields `0.0 * pow(...)`. `c % 10` truncates toward zero in C, so a negative
    23	/// `c` produces a negative exponent.
    24	#[unsafe(no_mangle)]
    25	pub extern "C" fn calculate_with_doubles(a: c_int, b: c_int, c: c_int) -> f64 {
    26	    let mut result: f64 = 0.0;
    27	
    28	    if b != 0 {
    29	        result = f64::from(a) / f64::from(b);
    30	    }
    31	
    32	    let exponent = f64::from(c.wrapping_rem(10));
    33	    result *= unsafe { ffi::pow(10.0, exponent) };
    34	
    35	    result
    36	}
