    26	use std::ffi::{c_char, c_double, c_int, c_long};
    27	use std::io::Write;
    28	
    29	// ---------------------------------------------------------------------------
    30	// printf("%e", ...) emulation
    31	// ---------------------------------------------------------------------------
    32	
    33	/// Formats `v` exactly the way glibc's `printf("%e", v)` does (default
    34	/// precision of 6): one leading digit, a decimal point, six fraction digits,
    35	/// `e`, an explicit exponent sign, and at least two exponent digits.
    36	///
    37	/// Rust's `{:.6e}` performs the same correctly-rounded (ties-to-even) decimal
    38	/// conversion as glibc, so only the exponent field needs reshaping.
    39	fn fmt_e(v: f64) -> String {
    40	    if v.is_nan() {
    41	        // glibc honours the sign bit of a NaN for %e.
    42	        return if v.is_sign_negative() {
    43	            "-nan".to_string()
    44	        } else {
    45	            "nan".to_string()
    46	        };
    47	    }
    48	    if v.is_infinite() {
    49	        return if v.is_sign_negative() {
    50	            "-inf".to_string()
    51	        } else {
    52	            "inf".to_string()
    53	        };
    54	    }
    55	
    56	    let s = format!("{:.6e}", v);
    57	    // `s` looks like "-1.099512e12" / "0.000000e0" / "1.000000e-9".
    58	    let (mantissa, exp) = s.split_once('e').expect("{:e} always emits an exponent");
    59	    let (sign, digits) = match exp.strip_prefix('-') {
    60	        Some(rest) => ('-', rest),
    61	        None => ('+', exp),
    62	    };
    63	    format!("{mantissa}e{sign}{digits:0>2}")
    64	}
