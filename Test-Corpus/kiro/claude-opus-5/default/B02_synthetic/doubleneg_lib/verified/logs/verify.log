    95	
    96	fn find_value_in_buffer_impl(buffer: &[u8], search_val: i32) -> i32 {
    97	    // `char target = (char)search_val;` then `memchr` re-reads it as an
    98	    // unsigned char, so only the low 8 bits matter.
    99	    let target = search_val as u8;
   100	    match c_memchr(buffer, target) {
   101	        Some(index) => index as i32,
   102	        None => -1,
   103	    }
   104	}
   105	
   106	fn create_numeric_buffer_impl(buffer: &mut [u8], seed: i32) {
   107	    for (i, slot) in buffer.iter_mut().enumerate() {
   108	        // `(seed + i * 7) % 256` with C's truncating remainder, then narrowed
   109	        // to `char` (low 8 bits). Wrapping arithmetic mirrors what the C does
   110	        // in practice when `seed + i * 7` overflows `int`.
   111	        let value = seed.wrapping_add((i as i32).wrapping_mul(7)).wrapping_rem(256);
   112	        *slot = value as u8;
   113	    }
   114	}
   115	
   116	fn calculate_with_doubles_impl(a: i32, b: i32, c: i32) -> f64 {
   117	    let mut result = 0.0f64;
   118	
   119	    if b != 0 {
   120	        result = f64::from(a) / f64::from(b);
   121	    }
   122	
   123	    result *= 10.0f64.powf(f64::from(c.wrapping_rem(10)));
   124	
   125	    result
   126	}
