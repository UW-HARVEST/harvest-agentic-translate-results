     1	//! Translation of the library's headline entry point, `doubleneg`.
     2	//!
     3	//! Every `printf` call is forwarded to the C library's `printf` with the
     4	//! original format string so that the produced bytes are identical, including
     5	//! `%e` scientific notation and the `%ld` pointer difference.
     6	
     7	use core::ffi::{c_int, c_long, c_void};
     8	
     9	use crate::buffer::{create_numeric_buffer, find_value_in_buffer};
    10	use crate::conv::convert_double_to_int;
    11	use crate::doubles::calculate_with_doubles;
    12	use crate::ffi;
    13	
    14	/// Translation of:
    15	///
    16	/// ```c
    17	/// int doubleneg(int param1, int param2, int param3, int param4);
    18	/// ```
    19	///
    20	/// This is the only function declared in `include/lib.h`, but the whole
    21	/// translation unit is compiled into the shared object, so all six helpers are
    22	/// exported as well.
    23	#[unsafe(no_mangle)]
    24	pub extern "C" fn doubleneg(param1: c_int, param2: c_int, param3: c_int, param4: c_int) -> c_int {
    25	    let mut result: c_int = 0;
    26	    // `char buffer[256];` — left uninitialised in C, but fully written by
    27	    // `create_numeric_buffer` before any read, so zeroing changes nothing.
    28	    let mut buffer = [0i8; 256];
    29	    let mut i: c_int;
    30	
    31	    unsafe {
    32	        ffi::printf(c"=== Starting foo() execution ===\n".as_ptr());
    33	        ffi::printf(
    34	            c"Parameters: %d, %d, %d, %d\n".as_ptr(),
    35	            param1,
    36	            param2,
    37	            param3,
    38	            param4,
    39	        );
    40	
    41	        ffi::printf(c"\n--- Integer Negation Test ---\n".as_ptr());
    42	    }
    43	    let negation_test: c_int = param1;
    44	    let negation_result: c_int = c_int::from(negation_test != 0);
    45	    unsafe {
    46	        ffi::printf(c"Original value: %d\n".as_ptr(), negation_test);
    47	        ffi::printf(c"After !!negation: %d\n".as_ptr(), negation_result);
    48	    }
    49	    result = result.wrapping_add(negation_result.wrapping_mul(10));
    50	
    51	    let neg_p2: c_int = c_int::from(param2 != 0);
    52	    let neg_p3: c_int = c_int::from(param3 != 0);
    53	    let neg_p4: c_int = c_int::from(param4 != 0);
    54	    unsafe {
    55	        ffi::printf(
    56	            c"Double negation results: %d, %d, %d\n".as_ptr(),
    57	            neg_p2,
    58	            neg_p3,
    59	            neg_p4,
    60	        );
    61	    }
    62	    result = result.wrapping_add(neg_p2.wrapping_add(neg_p3).wrapping_add(neg_p4));
    63	
    64	    unsafe {
    65	        ffi::printf(c"\n--- Double to Int Conversion Test ---\n".as_ptr());
    66	    }
    67	
    68	    let large_double: f64 = calculate_with_doubles(param1, param2, param3);
    69	    unsafe {
    70	        ffi::printf(c"Calculated double value: %e\n".as_ptr(), large_double);
    71	    }
    72	
    73	    let converted_int: c_int = convert_double_to_int(large_double);
    74	    unsafe {
    75	        ffi::printf(c"Converted to int (may be UB): %d\n".as_ptr(), converted_int);
