===== conv.rs =====
     1	//! Translation of `convert_double_to_int`.
     2	
     3	use core::ffi::c_int;
     4	
     5	/// Reproduce the exact behaviour of a C `(int)` cast from `double` on x86-64.
     6	///
     7	/// In C, converting a `double` whose truncated value does not fit in `int`
     8	/// (including infinities and NaN) is undefined behaviour. The original library
     9	/// deliberately exercises that case, and on x86-64 the compiler emits
    10	/// `cvttsd2si`, which yields the "integer indefinite" value `0x80000000`
    11	/// (`INT_MIN`) for every out-of-range or NaN input.
    12	///
    13	/// Rust's `as` cast saturates instead, so the C behaviour is emulated
    14	/// explicitly here. Do not "fix" this: the observable output of the library
    15	/// depends on it.
    16	#[inline]
    17	pub fn c_double_to_int(value: f64) -> c_int {
    18	    if value.is_nan() {
    19	        return c_int::MIN;
    20	    }
    21	
    22	    let truncated = value.trunc();
    23	
    24	    // Both bounds are exactly representable as `f64`, so the comparison is
    25	    // precise.
    26	    if truncated >= -2147483648.0_f64 && truncated <= 2147483647.0_f64 {
    27	        truncated as c_int
    28	    } else {
    29	        c_int::MIN
    30	    }
    31	}
    32	
    33	/// ```c
    34	/// int convert_double_to_int(double value) {
    35	///     return (int)value;
    36	/// }
    37	/// ```
    38	#[unsafe(no_mangle)]
    39	pub extern "C" fn convert_double_to_int(value: f64) -> c_int {
    40	    c_double_to_int(value)
    41	}
===== buffer.rs =====
     1	//! Translations of the buffer helpers: `find_value_in_buffer` and
     2	//! `create_numeric_buffer`.
     3	
     4	use core::ffi::{c_char, c_int};
     5	
     6	/// ```c
     7	/// int find_value_in_buffer(const char *buffer, size_t size, int search_val) {
     8	///     char target = (char)search_val;
     9	///     void *result = memchr(buffer, target, size);
    10	///     if (result != NULL) {
    11	///         return (int)((char*)result - buffer);
    12	///     }
    13	///     return -1;
    14	/// }
    15	/// ```
    16	///
    17	/// `search_val` is first narrowed to `char` and then widened back to `int` by
    18	/// the default argument promotion of `memchr`; `memchr` in turn compares
    19	/// against `(unsigned char)c`. The net effect is a search for the low byte of
    20	/// `search_val`, which is what the byte comparison below performs.
    21	///
    22	/// # Safety
    23	/// `buffer` must be valid for reads of `size` bytes.
    24	#[unsafe(no_mangle)]
    25	pub unsafe extern "C" fn find_value_in_buffer(
    26	    buffer: *const c_char,
    27	    size: usize,
    28	    search_val: c_int,
    29	) -> c_int {
    30	    let target = search_val as c_char;
    31	
    32	    // `memchr` never dereferences the pointer when the length is zero.
    33	    if size == 0 {
    34	        return -1;
    35	    }
    36	
    37	    let haystack = unsafe { core::slice::from_raw_parts(buffer as *const u8, size) };
    38	    let needle = target as u8;
    39	
    40	    match haystack.iter().position(|&byte| byte == needle) {
    41	        Some(offset) => offset as c_int,
    42	        None => -1,
    43	    }
    44	}
    45	
    46	/// ```c
    47	/// void create_numeric_buffer(char *buffer, int size, int seed) {
    48	///     for (int i = 0; i < size; i++) {
    49	///         buffer[i] = (char)((seed + i * 7) % 256);
    50	///     }
    51	/// }
    52	/// ```
    53	///
    54	/// `seed + i * 7` can overflow `int`, which is undefined behaviour in C but in
    55	/// practice wraps on the target; `wrapping_*` reproduces that. C's `%` truncates
    56	/// toward zero, matching Rust's `%`, so negative seeds keep producing negative
    57	/// bytes exactly as the C does.
    58	///
    59	/// # Safety
    60	/// `buffer` must be valid for writes of `size` bytes when `size > 0`.
    61	#[unsafe(no_mangle)]
    62	pub unsafe extern "C" fn create_numeric_buffer(buffer: *mut c_char, size: c_int, seed: c_int) {
    63	    let mut i: c_int = 0;
    64	    while i < size {
    65	        let value = seed.wrapping_add(i.wrapping_mul(7)) % 256;
    66	        unsafe { *buffer.add(i as usize) = value as c_char };
    67	        i = i.wrapping_add(1);
    68	    }
    69	}
