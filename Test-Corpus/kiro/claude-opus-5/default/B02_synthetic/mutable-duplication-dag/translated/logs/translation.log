#!/bin/bash
# Compare with ASLR disabled, where the C program is deterministic even for its
# use-after-free reads of freed heap bytes.
C=/tmp/cmb/driver
R=/local/home/scheschb/.harvest/work/harvest-work-rywjaY/translation/target/release/driver
fail=0
for f in /tmp/cases/*.txt; do
  setarch -R "$C" < "$f" > /tmp/c.out 2> /tmp/c.err; ce=$?
  setarch -R "$R" < "$f" > /tmp/r.out 2> /tmp/r.err; re=$?
  setarch -R "$C" < "$f" > /tmp/c.both 2>&1
  setarch -R "$R" < "$f" > /tmp/r.both 2>&1
  ok=1
  [ "$ce" = "$re" ] || { echo "=== EXIT DIFF $(basename $f): C=$ce R=$re"; ok=0; }
  cmp -s /tmp/c.out /tmp/r.out || { echo "=== STDOUT DIFF: $(basename $f)"; diff <(od -c /tmp/c.out) <(od -c /tmp/r.out) | head -10; ok=0; }
  cmp -s /tmp/c.err /tmp/r.err || { echo "=== STDERR DIFF: $(basename $f)"; diff /tmp/c.err /tmp/r.err | head -10; ok=0; }
  cmp -s /tmp/c.both /tmp/r.both || { echo "=== MERGED DIFF: $(basename $f)"; ok=0; }
  [ $ok -eq 1 ] && echo "PASS $(basename $f)" || fail=1
done
exit $fail
EOF
