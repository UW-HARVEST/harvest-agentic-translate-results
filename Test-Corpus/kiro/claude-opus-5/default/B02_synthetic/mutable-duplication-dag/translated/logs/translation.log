#!/usr/bin/env python3
"""Second generator: biased towards node deletion, memory reuse, double frees
and long scripts that cross the stdout flush boundary repeatedly."""
import random, subprocess, sys
C="/tmp/cmb/driver"
R="/local/home/scheschb/.harvest/work/harvest-work-rywjaY/translation/target/release/driver"
def gen(rng):
    pool=[f"C{i}" for i in range(6)]+["", "dup"]
    L=[]
    for _ in range(rng.randint(5,60)):
        ch=rng.choice([1,1,2,2,3,3,4,5,6,6,7,7,7,9])
        L.append(str(ch))
        if ch==1: L.append(rng.choice(pool))
        elif ch==2: L+=[rng.choice(pool),rng.choice(pool),str(rng.choice([0,1,5,-1,10,2**31-1]))]
        elif ch in (4,6,7): L.append(rng.choice(pool))
        elif ch==5: L+=[rng.choice(pool),rng.choice(pool)]
    if rng.random()<0.7: L.append("8")
    return ("\n".join(L)+"\n").encode()
def run(b,d):
    p=subprocess.run(['setarch','-R',b],input=d,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    return p.returncode,p.stdout,p.stderr
rng=random.Random(int(sys.argv[1])); n=int(sys.argv[2])
aborts=0
for i in range(n):
    d=gen(rng); a=run(C,d)
    if a!=run(C,d): print("C flaky, skip"); continue
    if a[0]!=0: aborts+=1
    b=run(R,d)
    if a!=b:
        print("MISMATCH:\n"+d.decode(errors='replace'))
        for lbl,x,y in (("exit",a[0],b[0]),("stdout",a[1],b[1]),("stderr",a[2],b[2])):
            if x!=y:
                print(f" {lbl} C={x!r}"[:600]); print(f" {lbl} R={y!r}"[:600])
                if lbl=="stdout":
                    for k in range(min(len(x),len(y))):
                        if x[k]!=y[k]: print(f"  first diff at byte {k}: C={x[k-40:k+40]!r} R={y[k-40:k+40]!r}"); break
        sys.exit(1)
print(f"{n} identical ({aborts} of them aborted in both), 0 mismatches")
PYEOF
