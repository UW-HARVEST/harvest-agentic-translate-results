#!/usr/bin/env python3
"""Target the interaction between find_shortest_path's malloc and node chunks
that were merged back into the top chunk."""
import random, subprocess, sys
C = "c_src/build/driver"; R = "translation/target/debug/driver"
def run(b, d):
    p = subprocess.run([b], input=d, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return p.stdout, p.stderr, p.returncode
def gen(rng):
    n = rng.randint(8, 20)
    names = ["C%d" % i for i in range(n)]
    lines = []
    for c in names: lines += ["1", c]
    for i in range(n - 1):
        if rng.random() < 0.8:
            lines += ["2", names[i], names[i+1], str(rng.randint(0, 5))]
    for _ in range(rng.randint(7, n)):
        lines += ["7", rng.choice(names)]
    for _ in range(rng.randint(1, 6)):
        op = rng.choice([5, 5, 4, 2, 6, 7])
        if op == 5: lines += ["5", rng.choice(names), rng.choice(names)]
        elif op == 2: lines += ["2", rng.choice(names), rng.choice(names), "1"]
        else: lines += [str(op), rng.choice(names)]
    lines += ["8"]
    return ("\n".join(lines) + "\n").encode()
def main():
    s0 = int(sys.argv[1]); n = int(sys.argv[2]); nd = 0; bad = []
    for s in range(s0, s0 + n):
        d = gen(random.Random(s))
        a = run(C, d); b = run(C, d)
        if a != b: nd += 1; continue
        c = run(R, d)
        if c != a:
            bad.append(s); open("/tmp/bad_%d.txt" % s, "wb").write(d)
            if len(bad) >= 5: break
    print(f"checked={n} nondet={nd} mismatches={len(bad)} {bad}")
    return 1 if bad else 0
sys.exit(main())
EOF
