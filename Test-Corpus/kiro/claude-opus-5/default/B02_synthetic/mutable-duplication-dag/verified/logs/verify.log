#!/usr/bin/env python3
"""Abort-path fuzzer: deliberately drives use-after-free reference counting so
that the heap consistency checks fire, and checks the diagnostic, the truncated
stdout and the SIGABRT status all agree."""
import random, subprocess, sys
C = "c_src/build/driver"; R = "translation/target/release/driver"
def run(b, d):
    p = subprocess.run([b], input=d, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return p.stdout, p.stderr, p.returncode
def gen(rng):
    n = rng.randint(1, 14)
    names = ["C%d" % i for i in range(n)]
    lines = []
    for c in names: lines += ["1", c]
    for _ in range(rng.randint(0, 3 * n)):
        lines += ["2", rng.choice(names), rng.choice(names), str(rng.randint(0, 5))]
    for _ in range(rng.randint(1, 3 * n)):
        op = rng.choice([6, 7, 7, 7, 4])
        lines += [str(op), rng.choice(names)]
    lines += ["8"]
    return ("\n".join(lines) + "\n").encode()
def main():
    s0 = int(sys.argv[1]); n = int(sys.argv[2]); nd = 0; bad = []; aborts = 0
    for s in range(s0, s0 + n):
        d = gen(random.Random(s))
        a = run(C, d); b = run(C, d)
        if a != b: nd += 1; continue
        if a[2] != 0: aborts += 1
        c = run(R, d)
        if c != a:
            bad.append(s); open("/tmp/bad_%d.txt" % s, "wb").write(d)
            if len(bad) >= 3: break
    print(f"checked={n} nondet={nd} aborts={aborts} mismatches={len(bad)} {bad}")
    return 1 if bad else 0
sys.exit(main())
EOF
