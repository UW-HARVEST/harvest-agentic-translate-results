#!/usr/bin/env python3
"""For every generated input where C is not reproducible, confirm the only
unstable part is stdout (the bytes glibc wrote over a freed node's name) and
that stderr and the exit status still agree with the Rust program."""
import random, subprocess, sys, importlib.util
C = "c_src/build/driver"; R = "translation/target/release/driver"
def run(b, d):
    p = subprocess.run([b], input=d, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return p.stdout, p.stderr, p.returncode
gens = {}
for mod in ["fuzz_abort", "fuzz_alloc", "fuzz_reuse_big", "fuzz"]:
    spec = importlib.util.spec_from_file_location(mod, mod + ".py")
    src = open(mod + ".py").read().replace("sys.exit(main())", "")
    ns = {"__name__": mod}
    exec(compile(src, mod + ".py", "exec"), ns)
    gens[mod] = ns["gen"]
total = nd = bad = 0
lenbad = 0
for mod, g in gens.items():
    for s in range(600):
        rng = random.Random(s)
        try:
            d = g(rng, rng.randint(1, 40)) if mod == "fuzz" else g(rng)
        except TypeError:
            d = g(rng)
        a = run(C, d); b = run(C, d)
        total += 1
        if a == b: continue
        nd += 1
        # stderr and exit status must still be stable and must match Rust
        c = run(R, d)
        if a[1] != b[1] or a[2] != b[2]:
            print("UNSTABLE stderr/status", mod, s); bad += 1
        elif c[1] != a[1] or c[2] != a[2]:
            print("MISMATCH stderr/status", mod, s); bad += 1
        elif len(a[0]) == len(b[0]) and len(c[0]) != len(a[0]):
            lenbad += 1
print(f"inputs={total} nondeterministic_in_C={nd} stderr/status_problems={bad} "
      f"stdout_len_differs_from_C={lenbad}")
sys.exit(1 if bad else 0)
EOF
