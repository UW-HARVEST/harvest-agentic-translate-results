#!/usr/bin/env python3
"""Chunk-reuse fuzzer: add N cities, delete a random subset, then add exactly as
many fresh cities so every freed chunk is handed back out, then print the graph.
Reuse order is fully observable and deterministic in C."""
import random, subprocess, sys
C = "c_src/build/driver"; R = "translation/target/release/driver"
def run(b, d):
    p = subprocess.run([b], input=d, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return p.stdout, p.stderr, p.returncode
def gen(rng):
    n = rng.randint(1, 25)
    old = ["O%d" % i for i in range(n)]
    lines = []
    for c in old: lines += ["1", c]
    for _ in range(rng.randint(0, n)):
        lines += ["2", rng.choice(old), rng.choice(old), str(rng.randint(0, 9))]
    victims = rng.sample(old, rng.randint(0, n))
    for v in victims: lines += ["7", v]
    for i in range(len(victims)): lines += ["1", "N%d" % i]
    lines += ["3", "8"]
    return ("\n".join(lines) + "\n").encode()
def main():
    s0 = int(sys.argv[1]); n = int(sys.argv[2]); nd = 0; bad = []
    for s in range(s0, s0 + n):
        rng = random.Random(s); d = gen(rng)
        a = run(C, d); b = run(C, d)
        if a != b: nd += 1; continue
        c = run(R, d)
        if c != a:
            bad.append(s); open("/tmp/bad_%d.txt" % s, "wb").write(d)
            if len(bad) >= 3: break
    print(f"checked={n} nondet={nd} mismatches={len(bad)} {bad}")
    return 1 if bad else 0
sys.exit(main())
EOF
