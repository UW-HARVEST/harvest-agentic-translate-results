#!/bin/bash
# Builds the C sources as shared libraries + driver executables for every
# (OP, REPEAT) configuration.  Nothing inside c_src/ is written to.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$ROOT/c_src/src"
OUT="$ROOT/cbuild"
rc=0
for op in add sub mul; do
  for rep in 0 1 2 3 4 5 6 7; do
    gcc -O2 -fPIC -shared -DOP="$op" -DREPEAT="$rep" \
        -I"$SRC" "$SRC/mdcore.c" -o "$OUT/libcmd_${op}_${rep}.so" || rc=1
    gcc -O2 -DOP="$op" -DREPEAT="$rep" \
        -I"$SRC" "$SRC/mdcore.c" "$SRC/mdmain.c" -o "$OUT/driver_${op}_${rep}" || rc=1
  done
done
exit $rc
EOF
