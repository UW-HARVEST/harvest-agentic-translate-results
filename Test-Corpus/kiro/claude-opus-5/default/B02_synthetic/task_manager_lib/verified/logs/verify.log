     1	//! Translation of `c_src/src/logger.c` / `c_src/include/logger.h`.
     2	
     3	use crate::cstdio::print_stderr;
     4	use crate::cutil::{c_str_bytes, getenv_bytes};
     5	use crate::stdio_stream::StdioStream;
     6	use std::ffi::{c_char, c_int};
     7	use std::fs::OpenOptions;
     8	use std::sync::atomic::{AtomicBool, Ordering};
     9	use std::sync::Mutex;
    10	
    11	/// `static FILE *log_file = NULL;`
    12	///
    13	/// `StdioStream` stands in for the `FILE *`: writes are buffered and flushed
    14	/// when the stream is closed, matching stdio's behaviour.
    15	static LOG_FILE: Mutex<Option<StdioStream>> = Mutex::new(None);
    16	
    17	/// Streams that `initialize_logger()` overwrote without closing.  The C code
    18	/// leaks the previous `FILE *`; glibc still flushes it at process exit, after
    19	/// every stream that was closed explicitly.  New streams are prepended to
    20	/// glibc's stream list, so exit-time flushing runs newest first.
    21	static LEAKED: Mutex<Vec<StdioStream>> = Mutex::new(Vec::new());
    22	
    23	/// Size of glibc's default stdio buffer for a regular file.
    24	const STDIO_BUFSIZ: usize = 4096;
    25	
    26	/// glibc flushes every still-open stdio stream when the process exits (see
    27	/// `_IO_cleanup`).  The original code can leave `log_file` open — e.g.
    28	/// `driver()` returns `EXIT_FAILURE` without calling `finalize_logger()` when
    29	/// `create_task_manager()` fails — and the buffered text still reaches the
    30	/// file.  Registering an `atexit` hook reproduces that.
    31	static EXIT_HOOK_REGISTERED: AtomicBool = AtomicBool::new(false);
    32	
    33	extern "C" {
    34	    fn atexit(cb: extern "C" fn()) -> c_int;
    35	}
    36	
    37	extern "C" fn flush_at_exit() {
    38	    {
    39	        let mut guard = LOG_FILE.lock().unwrap_or_else(|e| e.into_inner());
    40	        if let Some(writer) = guard.as_mut() {
    41	            writer.flush();
    42	        }
    43	    }
    44	    let mut leaked = LEAKED.lock().unwrap_or_else(|e| e.into_inner());
    45	    for writer in leaked.iter_mut().rev() {
    46	        writer.flush();
    47	    }
    48	}
    49	
    50	fn register_exit_hook() {
    51	    if !EXIT_HOOK_REGISTERED.swap(true, Ordering::SeqCst) {
    52	        unsafe { atexit(flush_at_exit) };
    53	    }
    54	}
    55	
    56	fn open_append(path_bytes: &[u8]) -> Option<std::fs::File> {
    57	    #[cfg(unix)]
    58	    let path: std::path::PathBuf = {
    59	        use std::os::unix::ffi::OsStrExt;
    60	        std::path::PathBuf::from(std::ffi::OsStr::from_bytes(path_bytes))
    61	    };
    62	    #[cfg(not(unix))]
    63	    let path: std::path::PathBuf =
    64	        std::path::PathBuf::from(String::from_utf8_lossy(path_bytes).into_owned());
    65	
    66	    // fopen(path, "a") == O_WRONLY | O_CREAT | O_APPEND
    67	    OpenOptions::new().append(true).create(true).open(path).ok()
    68	}
    69	
    70	/// `fprintf(log_file, "<prefix> %s\n", message)` guarded by `if (log_file)`.
    71	unsafe fn write_entry(prefix: &[u8], message: *const c_char) {
    72	    let mut guard = LOG_FILE.lock().unwrap_or_else(|e| e.into_inner());
    73	    if let Some(writer) = guard.as_mut() {
    74	        let mut line = Vec::with_capacity(prefix.len() + 16);
    75	        line.extend_from_slice(prefix);
    76	        line.extend_from_slice(&c_str_bytes(message));
    77	        line.push(b'\n');
    78	        writer.write(&line);
    79	    }
    80	}
    81	
    82	#[unsafe(no_mangle)]
    83	pub extern "C" fn initialize_logger() -> c_int {
    84	    let log_file_env = getenv_bytes("LOG_FILE");
    85	    let log_file_path: Vec<u8> = match log_file_env {
    86	        Some(v) => v,
    87	        None => b"default.log".to_vec(),
    88	    };
    89	
    90	    // log_file = fopen(log_file_path, "a");  (assigned unconditionally, so a
    91	    // failed re-initialisation also clears any previously open stream)
    92	    let opened = open_append(&log_file_path).map(|f| StdioStream::new(f, STDIO_BUFSIZ));
    93	    let failed = opened.is_none();
    94	    {
    95	        let mut guard = LOG_FILE.lock().unwrap_or_else(|e| e.into_inner());
    96	        if let Some(previous) = guard.take() {
    97	            // The old FILE * is neither flushed nor closed by the C code.
    98	            LEAKED
    99	                .lock()
   100	                .unwrap_or_else(|e| e.into_inner())
   101	                .push(previous);
   102	        }
   103	        *guard = opened;
   104	    }
   105	
   106	    register_exit_hook();
   107	
   108	    if failed {
   109	        let mut msg = b"Failed to open log file: ".to_vec();
   110	        msg.extend_from_slice(&log_file_path);
   111	        msg.push(b'\n');
   112	        print_stderr(&msg);
   113	        return -1;
   114	    }
   115	
   116	    unsafe { write_entry(b"[INFO] ", c"Logger initialized.".as_ptr()) };
   117	    0
   118	}
   119	
   120	#[unsafe(no_mangle)]
   121	pub unsafe extern "C" fn log_info(message: *const c_char) {
   122	    write_entry(b"[INFO] ", message);
   123	}
   124	
   125	#[unsafe(no_mangle)]
   126	pub unsafe extern "C" fn log_warning(message: *const c_char) {
   127	    write_entry(b"[WARNING] ", message);
   128	}
   129	
   130	#[unsafe(no_mangle)]
   131	pub unsafe extern "C" fn log_error(message: *const c_char) {
   132	    write_entry(b"[ERROR] ", message);
   133	}
   134	
   135	#[unsafe(no_mangle)]
   136	pub extern "C" fn finalize_logger() {
   137	    let is_open = {
   138	        let guard = LOG_FILE.lock().unwrap_or_else(|e| e.into_inner());
   139	        guard.is_some()
   140	    };
   141	    if is_open {
   142	        unsafe { write_entry(b"[INFO] ", c"Logger finalized.".as_ptr()) };
   143	        // fclose(log_file): flush, then close.  (The C code leaves the dangling
   144	        // `log_file` pointer in place; reproducing that use-after-free is not
   145	        // possible in Rust, so the handle is cleared instead.)
   146	        let stream = {
   147	            let mut guard = LOG_FILE.lock().unwrap_or_else(|e| e.into_inner());
   148	            guard.take()
   149	        };
   150	        drop(stream);
   151	    }
   152	}
   153	
   154	/// Internal helpers so the other modules can log without going through the
   155	/// exported `extern "C"` symbols.
   156	pub(crate) fn log_info_str(message: &std::ffi::CStr) {
   157	    unsafe { write_entry(b"[INFO] ", message.as_ptr()) };
   158	}
   159	
   160	pub(crate) fn log_warning_str(message: &std::ffi::CStr) {
   161	    unsafe { write_entry(b"[WARNING] ", message.as_ptr()) };
   162	}
   163	
   164	pub(crate) fn log_error_str(message: &std::ffi::CStr) {
   165	    unsafe { write_entry(b"[ERROR] ", message.as_ptr()) };
   166	}
