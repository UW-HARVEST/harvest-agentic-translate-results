     1	//! Translation of `c_src/src/driver.c`.
     2	
     3	use crate::cstdio::print_stderr;
     4	use crate::logger::{finalize_logger, initialize_logger};
     5	use crate::task_manager::{add_task, create_task_manager, destroy_task_manager, print_tasks};
     6	use std::alloc::{alloc, dealloc, Layout};
     7	use std::ffi::{c_char, c_int};
     8	
     9	/// `EXIT_FAILURE`
    10	const EXIT_FAILURE: c_int = 1;
    11	
    12	#[unsafe(no_mangle)]
    13	pub unsafe extern "C" fn driver(tasks: *const c_char) -> c_int {
    14	    let res = initialize_logger();
    15	    if res != 0 {
    16	        return EXIT_FAILURE;
    17	    }
    18	
    19	    let manager = create_task_manager();
    20	    if manager.is_null() {
    21	        // NOTE: the original returns here without calling finalize_logger();
    22	        // the missing finalisation is preserved on purpose.
    23	        return EXIT_FAILURE;
    24	    }
    25	
    26	    let mut start = tasks;
    27	    let mut priority: c_int = 1;
    28	    while *start != 0 {
    29	        // const char *end = strchr(start, '\n');
    30	        // if (end == NULL) end = start + strlen(start);
    31	        let mut end = start;
    32	        while *end != 0 && *end != b'\n' as c_char {
    33	            end = end.add(1);
    34	        }
    35	
    36	        // Extract the current task
    37	        let length = end.offset_from(start) as usize;
    38	        let layout = Layout::from_size_align(length + 1, 1).unwrap();
    39	        let task = alloc(layout);
    40	        if task.is_null() {
    41	            print_stderr(b"Error: Failed to allocate memory for task.\n");
    42	            destroy_task_manager(manager);
    43	            finalize_logger();
    44	            return EXIT_FAILURE;
    45	        }
    46	        // strncpy(task, start, length); task[length] = '\0';
    47	        std::ptr::copy_nonoverlapping(start as *const u8, task, length);
    48	        *task.add(length) = 0;
    49	
    50	        add_task(manager, task as *const c_char, priority);
    51	        priority = priority.wrapping_add(1);
    52	        dealloc(task, layout);
    53	
    54	        start = if *end == b'\n' as c_char {
    55	            end.add(1)
    56	        } else {
    57	            end
    58	        };
    59	    }
    60	
    61	    print_tasks(manager);
    62	
    63	    destroy_task_manager(manager);
    64	    finalize_logger();
    65	
    66	    0
    67	}
