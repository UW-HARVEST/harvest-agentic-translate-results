    26	#include <stdio.h>
    27	#include <stdlib.h>
    28	#include <string.h>
    29	#include "task_manager.h"
    30	#include "logger.h"
    31	
    32	TaskManager *create_task_manager() {
    33	    TaskManager *manager = (TaskManager *)malloc(sizeof(TaskManager));
    34	    if (!manager) {
    35	        log_error("Failed to allocate memory for TaskManager.");
    36	        return NULL;
    37	    }
    38	
    39	    const char *max_tasks_env = getenv("MAX_TASKS");
    40	    manager->max_tasks = max_tasks_env ? atoi(max_tasks_env) : 10;
    41	    manager->task_count = 0;
    42	    manager->tasks = (Task *)malloc(manager->max_tasks * sizeof(Task));
    43	    if (!manager->tasks) {
    44	        log_error("Failed to allocate memory for tasks.");
    45	        free(manager);
    46	        return NULL;
    47	    }
    48	
    49	    log_info("TaskManager created successfully.");
    50	    return manager;
    51	}
    52	
    53	void add_task(TaskManager *manager, const char *description, int priority) {
    54	    if (manager->task_count >= manager->max_tasks) {
    55	        log_warning("Cannot add task: Maximum task limit reached.");
    56	        return;
    57	    }
    58	
    59	    Task *task = &manager->tasks[manager->task_count++];
    60	    strncpy(task->description, description, sizeof(task->description) - 1);
    61	    task->description[sizeof(task->description) - 1] = '\0';
    62	    task->priority = priority;
    63	
    64	    log_info("Task added successfully.");
    65	}
    66	
    67	void print_tasks(const TaskManager *manager) {
    68	    printf("Tasks:\n");
    69	    for (int i = 0; i < manager->task_count; i++) {
    70	        printf("  [%d] %s (Priority: %d)\n", i + 1, manager->tasks[i].description, manager->tasks[i].priority);
    71	    }
    72	}
    73	
    74	void destroy_task_manager(TaskManager *manager) {
    75	    free(manager->tasks);
    76	    free(manager);
    77	    log_info("TaskManager destroyed successfully.");
    78	}
