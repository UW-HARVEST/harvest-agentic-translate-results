     1	//! Translation of `c_src/src/task_manager.c` / `c_src/include/task_manager.h`.
     2	
     3	use crate::cstdio::print_stdout;
     4	use crate::cutil::{c_atoi, c_str_bytes, getenv_bytes, strncpy};
     5	use crate::logger::{log_error_str, log_info_str, log_warning_str};
     6	use std::alloc::{alloc, dealloc, Layout};
     7	use std::ffi::{c_char, c_int};
     8	
     9	/// ```c
    10	/// typedef struct {
    11	///     char description[256];
    12	///     int priority;
    13	/// } Task;
    14	/// ```
    15	#[repr(C)]
    16	pub struct Task {
    17	    pub description: [c_char; 256],
    18	    pub priority: c_int,
    19	}
    20	
    21	/// ```c
    22	/// typedef struct {
    23	///     Task *tasks;
    24	///     int max_tasks;
    25	///     int task_count;
    26	/// } TaskManager;
    27	/// ```
    28	#[repr(C)]
    29	pub struct TaskManager {
    30	    pub tasks: *mut Task,
    31	    pub max_tasks: c_int,
    32	    pub task_count: c_int,
    33	}
    34	
    35	/// `malloc(max_tasks * sizeof(Task))`.
    36	///
    37	/// The C expression converts the `int` count to `size_t` (sign extension) and
    38	/// multiplies modulo 2^64, so a negative or absurdly large `MAX_TASKS`
    39	/// produces a request that `malloc` refuses.  `malloc(0)` returns a valid,
    40	/// non-NULL pointer under glibc.
    41	fn tasks_layout(max_tasks: c_int) -> Option<Layout> {
    42	    let size = (max_tasks as usize).wrapping_mul(std::mem::size_of::<Task>());
    43	    if size == 0 {
    44	        // Stand-in for glibc's minimum allocation for malloc(0).
    45	        let align = std::mem::align_of::<Task>();
    46	        Some(Layout::from_size_align(align, align).unwrap())
    47	    } else {
    48	        Layout::from_size_align(size, std::mem::align_of::<Task>()).ok()
    49	    }
    50	}
    51	
    52	#[unsafe(no_mangle)]
    53	pub extern "C" fn create_task_manager() -> *mut TaskManager {
    54	    let manager_layout = Layout::new::<TaskManager>();
    55	    let manager = unsafe { alloc(manager_layout) } as *mut TaskManager;
    56	    if manager.is_null() {
    57	        log_error_str(c"Failed to allocate memory for TaskManager.");
    58	        return std::ptr::null_mut();
    59	    }
    60	
    61	    unsafe {
    62	        let max_tasks_env = getenv_bytes("MAX_TASKS");
    63	        (*manager).max_tasks = match max_tasks_env {
    64	            Some(v) => c_atoi(&v),
    65	            None => 10,
    66	        };
    67	        (*manager).task_count = 0;
    68	
    69	        let tasks = match tasks_layout((*manager).max_tasks) {
    70	            Some(layout) => alloc(layout) as *mut Task,
    71	            None => std::ptr::null_mut(),
    72	        };
    73	        (*manager).tasks = tasks;
    74	
    75	        if tasks.is_null() {
    76	            log_error_str(c"Failed to allocate memory for tasks.");
    77	            dealloc(manager as *mut u8, manager_layout);
    78	            return std::ptr::null_mut();
    79	        }
    80	    }
    81	
    82	    log_info_str(c"TaskManager created successfully.");
    83	    manager
    84	}
    85	
    86	#[unsafe(no_mangle)]
    87	pub unsafe extern "C" fn add_task(
    88	    manager: *mut TaskManager,
    89	    description: *const c_char,
    90	    priority: c_int,
    91	) {
    92	    if (*manager).task_count >= (*manager).max_tasks {
    93	        log_warning_str(c"Cannot add task: Maximum task limit reached.");
    94	        return;
    95	    }
    96	
    97	    let index = (*manager).task_count;
    98	    (*manager).task_count = index.wrapping_add(1);
    99	
   100	    let task = (*manager).tasks.add(index as usize);
   101	    let desc = std::ptr::addr_of_mut!((*task).description) as *mut u8;
   102	    // strncpy(task->description, description, sizeof(task->description) - 1);
   103	    strncpy(desc, description, 256 - 1);
   104	    // task->description[sizeof(task->description) - 1] = '\0';
   105	    *desc.add(255) = 0;
   106	    (*task).priority = priority;
   107	
   108	    log_info_str(c"Task added successfully.");
   109	}
   110	
   111	#[unsafe(no_mangle)]
   112	pub unsafe extern "C" fn print_tasks(manager: *const TaskManager) {
   113	    // printf("Tasks:\n");
   114	    print_stdout(b"Tasks:\n");
   115	
   116	    let count = (*manager).task_count;
   117	    let mut i: c_int = 0;
   118	    while i < count {
   119	        let task = (*manager).tasks.add(i as usize);
   120	        // printf("  [%d] %s (Priority: %d)\n", i + 1, description, priority);
   121	        let mut line: Vec<u8> = Vec::new();
   122	        line.extend_from_slice(b"  [");
   123	        line.extend_from_slice(i.wrapping_add(1).to_string().as_bytes());
   124	        line.extend_from_slice(b"] ");
   125	        line.extend_from_slice(&c_str_bytes(
   126	            std::ptr::addr_of!((*task).description) as *const c_char
   127	        ));
   128	        line.extend_from_slice(b" (Priority: ");
   129	        line.extend_from_slice((*task).priority.to_string().as_bytes());
   130	        line.extend_from_slice(b")\n");
   131	        print_stdout(&line);
   132	        i = i.wrapping_add(1);
   133	    }
   134	}
   135	
   136	#[unsafe(no_mangle)]
   137	pub unsafe extern "C" fn destroy_task_manager(manager: *mut TaskManager) {
   138	    // free(manager->tasks);
   139	    if !(*manager).tasks.is_null() {
   140	        if let Some(layout) = tasks_layout((*manager).max_tasks) {
   141	            dealloc((*manager).tasks as *mut u8, layout);
   142	        }
   143	    }
   144	    // free(manager);
   145	    dealloc(manager as *mut u8, Layout::new::<TaskManager>());
   146	
   147	    log_info_str(c"TaskManager destroyed successfully.");
   148	}
