import os, subprocess
def run(v, data, env_over, harness="f"):
    env=dict(os.environ); env.pop("MAX_TASKS",None); env.pop("LOG_FILE",None)
    env.update({k:val.replace("{V}",v) for k,val in env_over.items()})
    for f in ("default.log",): 
        if os.path.exists("/tmp/dt/"+f): os.remove("/tmp/dt/"+f)
    p=subprocess.run(["./%s_%s"%(harness,v)],input=data,capture_output=True,env=env,cwd="/tmp/dt")
    return (p.returncode,p.stdout,p.stderr)

