#include <stdio.h>
#include <stdlib.h>
#include <string.h>
typedef struct { char description[256]; int priority; } Task;
typedef struct { Task *tasks; int max_tasks; int task_count; } TaskManager;
extern int initialize_logger(void);
extern void log_info(const char*); extern void log_warning(const char*);
extern void log_error(const char*); extern void finalize_logger(void);
extern TaskManager *create_task_manager(void);
extern void add_task(TaskManager*, const char*, int);
extern void print_tasks(const TaskManager*);
extern void destroy_task_manager(TaskManager*);
extern int driver(const char*);
int main(void) {
    printf("init=%d\n", initialize_logger());
    log_info(NULL); log_warning("w"); log_error("e");
    TaskManager *m = create_task_manager();
    printf("m=%d max=%d count=%d\n", m!=NULL, m->max_tasks, m->task_count);
    char big[600]; memset(big,'Z',sizeof(big)); big[599]='\0';
    add_task(m, big, 7);
    add_task(m, "", -5);
    for (int i=0;i<20;i++) add_task(m, "fill", i);
    printf("count=%d\n", m->task_count);
    print_tasks(m);
    destroy_task_manager(m);
    printf("d1=%d\n", driver("re-entrant\nsecond"));
    printf("d2=%d\n", driver("again"));
    printf("reinit=%d\n", initialize_logger());
    log_info("after reinit");
    finalize_logger();
    return 0;
}
EOF
