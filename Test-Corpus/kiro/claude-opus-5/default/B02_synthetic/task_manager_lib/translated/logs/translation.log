import os, random, subprocess, sys
random.seed(1234)
maxtasks = ["__unset__","0","1","2","5","10","-1","-7","abc","3junk"," 4","+6","1000","2147483647","-2147483648","99999999999999999999","4294967296","0x10","007",""]
fails=0
for it in range(400):
    style = random.randrange(5)
    if style==0: body = "\n".join("task%d"%i for i in range(random.randrange(0,15)))
    elif style==1: body = "".join(random.choice("ab\n\n\n \t") for _ in range(random.randrange(0,60)))
    elif style==2: body = "".join(chr(random.randrange(1,256)) for _ in range(random.randrange(0,200)))
    elif style==3: body = ("Z"*random.randrange(250,300))+"\n"+("Y"*random.randrange(1,400))
    else: body = "\n"*random.randrange(0,8)
    data = body.encode("latin-1")
    mt = random.choice(maxtasks)
    outs={}
    for v in ("c","rs"):
        env = dict(os.environ)
        log = "/tmp/dt/fz_%s.log"%v
        if os.path.exists(log): os.remove(log)
        env["LOG_FILE"] = log
        if mt=="__unset__": env.pop("MAX_TASKS",None)
        else: env["MAX_TASKS"]=mt
        p = subprocess.run(["./f_%s"%v], input=data, capture_output=True, env=env, cwd="/tmp/dt")
        logdata = open(log,"rb").read() if os.path.exists(log) else b"<none>"
        outs[v]=(p.returncode,p.stdout,p.stderr,logdata)
    if outs["c"]!=outs["rs"]:
        fails+=1
        print("MISMATCH iter=%d MAX_TASKS=%r input=%r"%(it,mt,data[:60]))
        for i,name in enumerate(["rc","stdout","stderr","log"]):
