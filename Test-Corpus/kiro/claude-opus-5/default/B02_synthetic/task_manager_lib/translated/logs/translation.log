maxtasks=["__unset__","0","1","3","10","-1","abc","5x"," 7","+2","1000","2147483647","99999999999999999999","4294967296",""]
logs=["file","/dev/stdout","/dev/null"]
fails=0
for it in range(300):
    st=random.randrange(5)
    if st==0: body="\n".join("task%d"%i for i in range(random.randrange(0,15)))
    elif st==1: body="".join(random.choice("ab\n\n\n \t") for _ in range(random.randrange(0,60)))
    elif st==2: body="".join(chr(random.randrange(1,256)) for _ in range(random.randrange(0,300)))
    elif st==3: body=("Z"*random.randrange(250,300))+"\n"+("Y"*random.randrange(1,400))
    else: body="\n".join("t%d"%i for i in range(random.randrange(0,600)))
    data=body.encode("latin-1"); mt=random.choice(maxtasks); lg=random.choice(logs)
    outs={}
    for v in ("c","rs"):
        env=dict(os.environ); env.pop("MAX_TASKS",None)
        log="/tmp/dt/fz_%s.log"%v
        if os.path.exists(log): os.remove(log)
        env["LOG_FILE"]= log if lg=="file" else lg
        if mt!="__unset__": env["MAX_TASKS"]=mt
        p=subprocess.run(["./f_%s"%v],input=data,capture_output=True,env=env,cwd="/tmp/dt")
        ld=open(log,"rb").read() if os.path.exists(log) else b"<none>"
        outs[v]=(p.returncode,p.stdout,p.stderr,ld)
    if outs["c"]!=outs["rs"]:
        fails+=1; print("MISMATCH it=%d MAX_TASKS=%r LOG=%s len=%d"%(it,mt,lg,len(data)))
        if fails>2: break
print("fuzz round 2: 300 cases, mismatches=%d"%fails)
