[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m         let op2 = model_op_name(p3.wrapping_rem(4));
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m         let i1 = model_perform(p1, p2, op1).unwrap();
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m         let i2 = model_perform(p3, p4, op2).unwrap();
