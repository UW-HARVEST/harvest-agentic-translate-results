import re, pathlib

src = pathlib.Path("tests/buffapp_pipeline.rs").read_text()

# Collect test fn names in source order.
names = re.findall(r"#\[test\]\nfn (\w+)\(\)", src)
assert len(names) == 12, names

# Drop the #[test] attributes -- this binary owns main().
src = src.replace("#[test]\nfn ", "fn ")

header = '''//! Phase B/D — differential tests for `buffapp` and the composed low-level
//! pipeline, plus the cross-library ABI checks.
//!
//! `harness = false`: this binary owns `main()` and runs every scenario
//! sequentially on one thread. That is required, not stylistic — `buffapp`
//! writes its log with `printf`, so comparing that output means redirecting
//! fd 1, which is process-global. Under libtest's default thread pool,
//! libtest's own progress lines get written into the capture window and show up
//! as bogus divergences.
'''
# Replace the original doc comment block with the new header.
src = re.sub(r"\A(//![^\n]*\n)+", header, src)

runner = "\nfn main() {\n"
runner += '    println!("running {} differential scenarios (sequential, harness-free)", %d);\n' % len(names)
runner += "    let started = std::time::Instant::now();\n"
for n in names:
    runner += '    print!("  {:<58} ", "%s");\n' % n
    runner += "    use std::io::Write;\n" if n == names[0] else ""
    runner += "    std::io::stdout().flush().unwrap();\n"
    runner += "    %s();\n" % n
    runner += '    println!("ok");\n'
runner += '    println!("\\nstdout_diff result: ok. {} scenarios passed in {:.2?}", %d, started.elapsed());\n' % len(names)
runner += "}\n"

pathlib.Path("tests/stdout_diff.rs").write_text(src + runner)
pathlib.Path("tests/buffapp_pipeline.rs").unlink()
print("wrote tests/stdout_diff.rs with", len(names), "scenarios")
EOF
