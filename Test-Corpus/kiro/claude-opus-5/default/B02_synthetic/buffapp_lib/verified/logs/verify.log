[0m[49m[38;5;10m+    103[0m:[38;5;10m[49m // (C's `%` keeps the dividend's sign, so -1, -2, -3 are reachable and select
[0m[49m[38;5;10m+    104[0m:[38;5;10m[49m // the `default` "unknown" arm.)
[0m[49m[38;5;10m+    105[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    106[0m:[38;5;10m[49m const RESIDUES: [i32; 7] = [0, 1, 2, 3, -1, -2, -3];
[0m[49m[38;5;10m+    107[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    108[0m:[38;5;10m[49m /// Smallest-magnitude representative plus randomized values with the requested
[0m[49m[38;5;10m+    109[0m:[38;5;10m[49m /// residue mod 4.
[0m[49m[38;5;10m+    110[0m:[38;5;10m[49m fn with_residue(rng: &mut Rng, r: i32) -> i32 {
[0m[49m[38;5;10m+    111[0m:[38;5;10m[49m     // pick k so that (4k + r) % 4 == r; keep the sign of r so the residue is
[0m[49m[38;5;10m+    112[0m:[38;5;10m[49m     // preserved by C's truncating %.
[0m[49m[38;5;10m+    113[0m:[38;5;10m[49m     let k = (rng.next_u64() % 1000) as i32;
[0m[49m[38;5;10m+    114[0m:[38;5;10m[49m     if r >= 0 {
[0m[49m[38;5;10m+    115[0m:[38;5;10m[49m         4 * k + r
[0m[49m[38;5;10m+    116[0m:[38;5;10m[49m     } else {
[0m[49m[38;5;10m+    117[0m:[38;5;10m[49m         -4 * k + r
[0m[49m[38;5;10m+    118[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    119[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    120[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m fn cfg_28_buffapp_residue_cross_product() {
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m     let mut rng = Rng::new(Rng::DEFAULT_SEED ^ 28);
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m     for &r1 in &RESIDUES {
[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m         for &r3 in &RESIDUES {
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m             let mut done = 0;
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m             let mut attempts = 0;
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m             while done < 40 && attempts < 4000 {
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m                 attempts += 1;
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m                 let p1 = with_residue(&mut rng, r1);
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m                 let p3 = with_residue(&mut rng, r3);
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m                 debug_assert_eq!(p1 % 4, r1);
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m                 debug_assert_eq!(p3 % 4, r3);
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m                 let p2 = rng.next_small_i32();
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m                 let p4 = rng.next_small_i32();
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m                 if would_trap(p1, p2, p3, p4) {
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m                     continue;
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m                 buffapp_diff(p1, p2, p3, p4);
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m                 done += 1;
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m             assert!(done >= 40, "residue cell ({r1},{r3}) under-tested: {done}");
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m }
