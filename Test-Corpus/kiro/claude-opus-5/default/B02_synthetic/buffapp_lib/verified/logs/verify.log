[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m         done += 1;
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m     assert!(done >= 400, "only {done} intermediate3==0 cases found");
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m 
