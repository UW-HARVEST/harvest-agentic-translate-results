[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m fn parity_datablock_layout_matches_c() {
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     // The C compiler reports size=40 align=8 off_id=0 off_value=8 off_label=16.
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     // If Rust's `DataBlock` disagreed, `copy_data_block` would copy the wrong
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m     // number of bytes; the guard-byte check in `assert_copy_eq` pins the
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m     // length, and this pins the field offsets the printf output depends on.
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m     assert_eq!(std::mem::size_of::<DataBlock>(), 40);
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m     assert_eq!(std::mem::align_of::<DataBlock>(), 8);
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m     let b = DataBlock { id: 0, value: 0.0, label: [0; 20] };
