     1	//! `charinbuf` — the single function declared in `include/lib.h` and the driver
     2	//! that exercises the rest of the library.
     3	//!
     4	//! Every message is emitted through libc `printf` with the original format
     5	//! string byte-for-byte, so stdout content, ordering and buffering behaviour are
     6	//! identical to the C build.
     7	
     8	use core::ffi::{c_char, c_int};
     9	use core::ptr;
    10	
    11	use crate::cruntime::{free, printf, strlen};
    12	use crate::helpers::{
    13	    OperationFunc, apply_operation, create_buffer, find_char_in_buffer, is_string_empty,
    14	};
    15	use crate::{UINT16_MAX, counter};
    16	
    17	/// Convenience for turning a NUL-terminated byte literal into `*const c_char`.
    18	macro_rules! cstr {
    19	    ($bytes:literal) => {
    20	        concat!($bytes, "\0").as_ptr() as *const c_char
    21	    };
    22	}
    23	
    24	/// ```c
    25	/// int charinbuf(int mode, int value, int opt1, int opt2);
    26	/// ```
    27	///
    28	/// Declared in `include/lib.h`. There is no namespace macro in the header, so
    29	/// the linker symbol is plain `charinbuf`.
    30	#[unsafe(no_mangle)]
    31	pub extern "C" fn charinbuf(mode: c_int, value: c_int, opt1: c_int, opt2: c_int) -> c_int {
    32	    let mut result: c_int = 0;
    33	    let mut buffer: *mut c_char = ptr::null_mut();
    34	    let found_pos: *mut c_char;
    35	    let test_string = cstr!("");
    36	    let non_empty_string = cstr!("Hello, World!");
    37	
    38	    let mut current_op: OperationFunc;
    39	
    40	    counter::set(0);
    41	
    42	    // SAFETY: every call below is a variadic libc call whose argument types
    43	    // match the corresponding conversion specifier, or a helper invoked on a
    44	    // pointer this function itself produced.
    45	    unsafe {
    46	        match mode {
    47	            0 => {
    48	                printf(cstr!("Mode 0: UINT16_MAX validation\n"));
    49	                printf(
    50	                    cstr!("Checking if value %d is within uint16_t range...\n"),
    51	                    value,
    52	                );
    53	
    54	                if crate::helpers::validate_uint16_range(value) != 0 {
    55	                    printf(
    56	                        cstr!("Value %d is valid (0 <= value <= %u)\n"),
    57	                        value,
    58	                        UINT16_MAX as core::ffi::c_uint,
    59	                    );
    60	                    result = value;
    61	                } else {
    62	                    printf(cstr!("Value %d is out of range for uint16_t\n"), value);
    63	                    result = -1;
    64	                }
    65	
    66	                printf(
    67	                    cstr!("UINT16_MAX constant value: %u\n"),
    68	                    UINT16_MAX as core::ffi::c_uint,
    69	                );
    70	            }
    71	
    72	            1 => {
    73	                printf(cstr!("Mode 1: String empty check by dereference\n"));
    74	
    75	                if is_string_empty(test_string) != 0 {
    76	                    printf(cstr!("Test string is empty (checked with *string)\n"));
    77	                    result = 0;
    78	                } else {
    79	                    printf(cstr!("Test string is not empty\n"));
    80	                    result = 1;
    81	                }
    82	
    83	                if is_string_empty(non_empty_string) != 0 {
    84	                    printf(cstr!("Non-empty string check failed!\n"));
    85	                } else {
    86	                    printf(cstr!("Non-empty string correctly identified\n"));
    87	                    result = result.wrapping_add(10);
    88	                }
    89	            }
    90	
    91	            2 => {
    92	                printf(cstr!("Mode 2: Dynamic memory allocation and free\n"));
    93	
    94	                buffer = create_buffer(cstr!("Testing malloc and free"));
    95	
    96	                if !buffer.is_null() {
    97	                    printf(cstr!("Buffer allocated: '%s'\n"), buffer);
    98	                    printf(cstr!("Buffer length: %zu\n"), strlen(buffer));
    99	                    result = strlen(buffer) as c_int;
   100	
   101	                    free(buffer as *mut core::ffi::c_void);
   102	                    printf(cstr!("Buffer freed successfully\n"));
   103	                    buffer = ptr::null_mut();
   104	                } else {
   105	                    printf(cstr!("Failed to allocate buffer\n"));
   106	                    result = -1;
   107	                }
   108	            }
   109	
   110	            3 => {
   111	                printf(cstr!("Mode 3: Function pointers with static counter\n"));
   112	
   113	                current_op = Some(counter::reset_counter);
   114	                result = apply_operation(current_op, value);
   115	                printf(cstr!("Counter reset to: %d\n"), result);
   116	
   117	                current_op = Some(counter::increment_counter);
   118	                result = apply_operation(current_op, opt1);
   119	                printf(cstr!("Counter after increment by %d: %d\n"), opt1, result);
   120	
   121	                current_op = Some(counter::multiply_counter);
   122	                result = apply_operation(current_op, opt2);
   123	                printf(cstr!("Counter after multiply by %d: %d\n"), opt2, result);
   124	
   125	                current_op = Some(counter::decrement_counter);
   126	                result = apply_operation(current_op, 5);
   127	                printf(cstr!("Counter after decrement by 5: %d\n"), result);
   128	
   129	                printf(cstr!("Final static counter value: %d\n"), counter::get());
   130	            }
   131	
   132	            4 => {
   133	                printf(cstr!("Mode 4: Using memchr to find character\n"));
   134	
   135	                buffer = create_buffer(cstr!("Search for character X in this buffer"));
   136	
   137	                if !buffer.is_null() {
   138	                    let buf_size = strlen(buffer);
   139	                    let search_char: c_char = b'X' as c_char;
   140	
   141	                    printf(
   142	                        cstr!("Searching for '%c' in: '%s'\n"),
   143	                        search_char as c_int,
   144	                        buffer,
   145	                    );
   146	                    found_pos = find_char_in_buffer(buffer, buf_size, search_char);
   147	
   148	                    if !found_pos.is_null() {
   149	                        result = found_pos.offset_from(buffer) as c_int;
   150	                        printf(
   151	                            cstr!("Found '%c' at position: %d\n"),
   152	                            search_char as c_int,
   153	                            result,
   154	                        );
   155	                    } else {
   156	                        printf(cstr!("Character '%c' not found\n"), search_char as c_int);
   157	                        result = -1;
   158	                    }
   159	
   160	                    free(buffer as *mut core::ffi::c_void);
   161	                    buffer = ptr::null_mut();
   162	                }
   163	            }
   164	
   165	            _ => {
   166	                printf(cstr!("Invalid mode: %d\n"), mode);
   167	                result = -1;
   168	            }
   169	        }
   170	    }
   171	
   172	    // `buffer` is cleared on every path that allocated it, mirroring the C code;
   173	    // the assignments exist only for parity and are otherwise dead.
   174	    let _ = buffer;
   175	
   176	    result
   177	}
