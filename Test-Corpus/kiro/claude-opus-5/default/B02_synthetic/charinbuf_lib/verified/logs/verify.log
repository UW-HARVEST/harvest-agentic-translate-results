     1	//! String, buffer and validation helpers exported by `src/lib.c`.
     2	
     3	use core::ffi::{c_char, c_int, c_void};
     4	use core::ptr;
     5	
     6	use crate::cruntime;
     7	
     8	/// `typedef int (*operation_func)(int);`
     9	///
    10	/// Modelled as an `Option<...>` so that the C-side NULL is representable while
    11	/// keeping the same single-pointer ABI (null pointer optimisation).
    12	pub type OperationFunc = Option<unsafe extern "C" fn(c_int) -> c_int>;
    13	
    14	/// ```c
    15	/// int is_string_empty(const char *str) {
    16	///     if (!str) return 1;
    17	///     if (*str) {
    18	///         return 0;
    19	///     }
    20	///     return 1;
    21	/// }
    22	/// ```
    23	///
    24	/// Note the NULL pointer and the empty string are conflated into the same `1`
    25	/// result; that is the C behaviour and is kept as-is.
    26	#[unsafe(no_mangle)]
    27	pub unsafe extern "C" fn is_string_empty(str: *const c_char) -> c_int {
    28	    if str.is_null() {
    29	        return 1;
    30	    }
    31	    // SAFETY: non-NULL was just established; the caller guarantees the pointer
    32	    // is dereferenceable, exactly as the C original requires.
    33	    if unsafe { *str } != 0 {
    34	        return 0;
    35	    }
    36	    1
    37	}
    38	
    39	/// ```c
    40	/// char* find_char_in_buffer(const char *buffer, size_t size, char target) {
    41	///     if (!buffer) return NULL;
    42	///     return (char*)memchr(buffer, target, size);
    43	/// }
    44	/// ```
    45	///
    46	/// `target` is a `char`, which on the x86-64 SysV ABI is signed. C promotes it
    47	/// to `int` (sign extending) for the `memchr` call, and `memchr` then truncates
    48	/// back to `unsigned char`; casting through `c_int` here reproduces that chain.
    49	#[unsafe(no_mangle)]
    50	pub unsafe extern "C" fn find_char_in_buffer(
    51	    buffer: *const c_char,
    52	    size: usize,
    53	    target: c_char,
    54	) -> *mut c_char {
    55	    if buffer.is_null() {
    56	        return ptr::null_mut();
    57	    }
    58	    // SAFETY: delegated to libc's memchr under the same contract the C code
    59	    // imposes on its callers (`buffer` readable for `size` bytes).
    60	    unsafe { cruntime::memchr(buffer as *const c_void, target as c_int, size) as *mut c_char }
    61	}
    62	
    63	/// ```c
    64	/// char* create_buffer(const char *initial) {
    65	///     if (!initial) return NULL;
    66	///     size_t len = strlen(initial);
    67	///     char *buffer = (char*)malloc(len + 1);
    68	///     if (buffer) {
    69	///         strcpy(buffer, initial);
    70	///     }
    71	///     return buffer;
    72	/// }
    73	/// ```
    74	///
    75	/// The allocation must come from libc `malloc`: the returned pointer is handed
    76	/// to callers (and to `charinbuf`) that release it with `free`.
    77	#[unsafe(no_mangle)]
    78	pub unsafe extern "C" fn create_buffer(initial: *const c_char) -> *mut c_char {
    79	    if initial.is_null() {
    80	        return ptr::null_mut();
    81	    }
    82	
    83	    // SAFETY: `initial` is a non-NULL NUL-terminated string per the C contract.
    84	    let len = unsafe { cruntime::strlen(initial) };
    85	    // `len + 1` is written exactly as in C, including its wrap-around behaviour
    86	    // on a (practically unreachable) SIZE_MAX-length string.
    87	    let buffer = unsafe { cruntime::malloc(len.wrapping_add(1)) } as *mut c_char;
    88	
    89	    if !buffer.is_null() {
    90	        // SAFETY: `buffer` holds `len + 1` bytes, enough for the string plus NUL.
    91	        unsafe { cruntime::strcpy(buffer, initial) };
    92	    }
    93	
    94	    buffer
    95	}
    96	
    97	/// ```c
    98	/// int validate_uint16_range(int value) {
    99	///     if (value < 0) return 0;
   100	///     if (value > UINT16_MAX) return 0;
   101	///     return 1;
   102	/// }
   103	/// ```
   104	#[unsafe(no_mangle)]
   105	pub extern "C" fn validate_uint16_range(value: c_int) -> c_int {
   106	    if value < 0 {
   107	        return 0;
   108	    }
   109	    if value > crate::UINT16_MAX {
   110	        return 0;
   111	    }
   112	    1
   113	}
   114	
   115	/// ```c
   116	/// int apply_operation(operation_func op, int value) {
   117	///     if (!op) return -1;
   118	///     return op(value);
   119	/// }
   120	/// ```
   121	///
   122	/// The `-1` sentinel for a NULL callback is indistinguishable from an operation
