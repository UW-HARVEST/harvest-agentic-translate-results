=== src/lib.rs ===
     1	//! Rust translation of the C library in `../c_src`.
     2	//!
     3	//! The C build globs `src/lib.c` into one shared object exporting ten symbols:
     4	//! `increment_counter`, `decrement_counter`, `multiply_counter`,
     5	//! `reset_counter`, `is_string_empty`, `find_char_in_buffer`, `create_buffer`,
     6	//! `validate_uint16_range`, `apply_operation` and `charinbuf`. All ten are
     7	//! re-exported here with the same names and signatures; `include/lib.h` defines
     8	//! no namespace macros, so no symbol renaming is involved.
     9	//!
    10	//! Guiding rules for this translation:
    11	//! * Observable behaviour is preserved, bugs included. Nothing is "fixed".
    12	//! * Error checks stay in their original order.
    13	//! * Formatted output goes through libc `printf` with the original format
    14	//!   strings, and heap buffers come from libc `malloc`, so stdout bytes and the
    15	//!   `free()`-ability of returned pointers are unchanged.
    16	
    17	mod charinbuf;
    18	mod counter;
    19	mod cruntime;
    20	mod helpers;
    21	
    22	use core::ffi::c_int;
    23	
    24	/// `UINT16_MAX` from `<stdint.h>`, which the preprocessor expands to `65535`.
    25	///
    26	/// In the C source it appears both in an `int` comparison
    27	/// (`value > UINT16_MAX`) and as a `%u` argument, so it is kept as a `c_int`
    28	/// and cast at the `printf` call sites.
    29	pub(crate) const UINT16_MAX: c_int = 65535;
=== src/cruntime.rs ===
     1	//! Declarations for the C runtime routines used by the original library.
     2	//!
     3	//! The translation deliberately calls straight through to libc rather than
     4	//! reimplementing formatting or allocation in Rust. `charinbuf` writes to the
     5	//! process' C `stdout`, and buffers returned by `create_buffer` are expected to
     6	//! be releasable with `free()`, so both must be the genuine libc versions in
     7	//! order for the observable behaviour to stay byte-identical.
     8	
     9	use core::ffi::{c_char, c_int, c_void};
    10	
    11	unsafe extern "C" {
    12	    /// `int printf(const char *restrict format, ...)`
    13	    pub fn printf(format: *const c_char, ...) -> c_int;
    14	
    15	    /// `void *malloc(size_t size)`
    16	    pub fn malloc(size: usize) -> *mut c_void;
    17	
    18	    /// `void free(void *ptr)`
    19	    pub fn free(ptr: *mut c_void);
    20	
    21	    /// `size_t strlen(const char *s)`
    22	    pub fn strlen(s: *const c_char) -> usize;
    23	
    24	    /// `char *strcpy(char *dest, const char *src)`
    25	    pub fn strcpy(dest: *mut c_char, src: *const c_char) -> *mut c_char;
    26	
    27	    /// `void *memchr(const void *s, int c, size_t n)`
    28	    pub fn memchr(s: *const c_void, c: c_int, n: usize) -> *mut c_void;
    29	}
=== src/counter.rs ===
     1	//! The file-scope `static int counter;` from `src/lib.c` and the four exported
     2	//! functions that mutate it.
     3	//!
     4	//! The C original is not thread safe (a plain non-atomic `static int` touched
     5	//! from exported entry points), and signed overflow in the arithmetic is
     6	//! technically undefined behaviour that GCC/Clang compile into plain wrapping
     7	//! `add`/`sub`/`imul`. Both traits are preserved here: the state lives in an
     8	//! `UnsafeCell` with no synchronisation, and the arithmetic uses the explicit
     9	//! `wrapping_*` operators so the release build cannot diverge and the debug
    10	//! build cannot panic.
    11	
    12	use core::cell::UnsafeCell;
    13	use core::ffi::c_int;
    14	
    15	/// `static int counter = 0;`
    16	struct Counter(UnsafeCell<c_int>);
    17	
    18	// SAFETY: This is a faithful model of a C file-scope `static int`, which comes
    19	// with no synchronisation of its own. Every access happens through the exported
    20	// entry points below, exactly as in the C original.
    21	unsafe impl Sync for Counter {}
    22	
    23	static COUNTER: Counter = Counter(UnsafeCell::new(0));
    24	
    25	/// Read the file-scope counter.
    26	#[inline]
    27	pub(crate) fn get() -> c_int {
    28	    // SAFETY: no concurrent access is guarded against, matching the C original.
    29	    unsafe { *COUNTER.0.get() }
    30	}
    31	
    32	/// Overwrite the file-scope counter.
    33	#[inline]
    34	pub(crate) fn set(value: c_int) {
    35	    // SAFETY: see `get`.
    36	    unsafe { *COUNTER.0.get() = value }
    37	}
    38	
    39	/// ```c
    40	/// int increment_counter(int value) {
    41	///     counter += value;
    42	///     return counter;
    43	/// }
    44	/// ```
    45	#[unsafe(no_mangle)]
    46	pub extern "C" fn increment_counter(value: c_int) -> c_int {
    47	    let updated = get().wrapping_add(value);
    48	    set(updated);
    49	    updated
    50	}
    51	
    52	/// ```c
    53	/// int decrement_counter(int value) {
    54	///     counter -= value;
    55	///     return counter;
    56	/// }
    57	/// ```
    58	#[unsafe(no_mangle)]
    59	pub extern "C" fn decrement_counter(value: c_int) -> c_int {
    60	    let updated = get().wrapping_sub(value);
    61	    set(updated);
    62	    updated
    63	}
    64	
    65	/// ```c
    66	/// int multiply_counter(int value) {
    67	///     counter *= value;
    68	///     return counter;
    69	/// }
    70	/// ```
    71	#[unsafe(no_mangle)]
    72	pub extern "C" fn multiply_counter(value: c_int) -> c_int {
    73	    let updated = get().wrapping_mul(value);
    74	    set(updated);
    75	    updated
    76	}
    77	
    78	/// ```c
    79	/// int reset_counter(int value) {
    80	///     counter = value;
    81	///     return counter;
    82	/// }
    83	/// ```
    84	#[unsafe(no_mangle)]
    85	pub extern "C" fn reset_counter(value: c_int) -> c_int {
    86	    set(value);
    87	    value
    88	}
