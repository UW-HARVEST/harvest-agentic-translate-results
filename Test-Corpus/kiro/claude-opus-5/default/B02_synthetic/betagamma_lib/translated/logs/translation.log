    printf("betagamma(%d,%d,%d,%d)=%d\n",cases[i][0],cases[i][1],cases[i][2],cases[i][3],
      betagamma(cases[i][0],cases[i][1],cases[i][2],cases[i][3]));
  }
  DataBlock b = create_block(42,"hello",0xAB);
  printf("cb id=%d name=%s flags=%u\n", b.id, b.name, b.flags);
  MemoryBlock *m1 = allocate_block(5,-3), *m2 = allocate_block(5,100);
  printf("m1 size=%zu vals:",m1->size); for(size_t i=0;i<m1->size;i++) printf(" %d",m1->data[i]); printf("\n");
  printf("m2 size=%zu vals:",m2->size); for(size_t i=0;i<m2->size;i++) printf(" %d",m2->data[i]); printf("\n");
  printf("hash(m1,m2)=%d hash(m2,m1)=%d hash(m1,m1)=%d\n", compute_hash(m1,m2), compute_hash(m2,m1), compute_hash(m1,m1));
  free_block(m1); free_block(m2); free_block(NULL);
  MemoryBlock *z = allocate_block(0,7);
  printf("zero: %d size=%zu dataNull=%d\n", z!=NULL, z?z->size:0, z? (z->data==NULL):-1);
  free_block(z);
  MemoryBlock *huge = allocate_block((size_t)-1, 1);
  printf("huge=%d\n", huge!=NULL);
  return 0;
}
