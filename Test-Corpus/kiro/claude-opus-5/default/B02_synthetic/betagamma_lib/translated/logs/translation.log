typedef struct { int id; char name[32]; uint8_t flags; } DataBlock;
typedef struct { int *data; size_t size; } MemoryBlock;
extern int betagamma(int,int,int,int);
extern DataBlock create_block(int, const char*, uint8_t);
extern MemoryBlock* allocate_block(size_t, int);
extern void free_block(MemoryBlock*);
extern int compute_hash(MemoryBlock*, MemoryBlock*);
static unsigned long s=88172645463325252UL;
static unsigned long rnd(void){s^=s<<13;s^=s>>7;s^=s<<17;return s;}
int main(void){
  unsigned long acc=0;
  for(int i=0;i<20000;i++){
    int a=(int)rnd(), b=(int)rnd(), c=(int)rnd(), d=(int)rnd();
    if(i%3==0){a%=25;b%=25;c%=25;d%=25;}
    int r=betagamma(a,b,c,d);
    printf("%d %d %d %d -> %d\n",a,b,c,d,r);
    acc+=(unsigned)r;
    if(i%7==0){
      MemoryBlock *m=allocate_block((size_t)(rnd()%40),(int)rnd());
      MemoryBlock *n=allocate_block((size_t)(rnd()%40),(int)rnd());
      if(m&&n){ printf("h=%d s=%zu,%zu",compute_hash(m,n),m->size,n->size);
        for(size_t k=0;k<m->size;k++)printf(" %d",m->data[k]);
        for(size_t k=0;k<n->size;k++)printf(" %d",n->data[k]); printf("\n"); }
      free_block(m); free_block(n);
    }
