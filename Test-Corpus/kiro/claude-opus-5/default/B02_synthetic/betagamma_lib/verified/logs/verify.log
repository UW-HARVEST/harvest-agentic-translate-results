[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m                 assert_eq!(cvals.1, rvals.1, "contents differ for count 1<<{bit}");
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m                 (c.free_block)(cm);
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m                 (r.free_block)(rm);
