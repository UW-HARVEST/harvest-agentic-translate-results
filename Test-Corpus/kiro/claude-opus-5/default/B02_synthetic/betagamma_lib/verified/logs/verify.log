[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m             let rb = (r.create_block)(-1, s.as_ptr(), flags);
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m             assert_eq!(cb.flags, flags);
