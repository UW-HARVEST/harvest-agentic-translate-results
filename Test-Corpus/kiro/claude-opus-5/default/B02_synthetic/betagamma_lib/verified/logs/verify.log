[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m                 "allocate_block(1<<{bit}) null-ness disagreement"
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m             if !cm.is_null() {
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m                 let cvals = read_block(cm).unwrap();
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m                 let rvals = read_block(rm).unwrap();
