[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m             let s = cstr(&name);
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m             let cb = (c.create_block)(0x5A5A5A5A, s.as_ptr(), 0x3C);
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m             let rb = (r.create_block)(0x5A5A5A5A, s.as_ptr(), 0x3C);
