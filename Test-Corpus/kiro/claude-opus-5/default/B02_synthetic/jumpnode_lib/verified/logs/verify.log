[0m[49m[38;5;10m+    707[0m:[38;5;10m[49m         assert_eq!(p.assert_same(MODE_1, node_id, i32::MAX, 0), ERR_MODE1_NULL);
[0m[49m[38;5;10m+    708[0m:[38;5;10m[49m         assert_eq!(p.assert_same(MODE_4, node_id, i32::MAX, 0), ERR_MODE4_NULL);
