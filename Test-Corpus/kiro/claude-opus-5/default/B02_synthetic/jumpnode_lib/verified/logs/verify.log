[0m[49m[38;5;10m+    722[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    723[0m:[38;5;10m[49m // Phase D — symbol parity through the loaded objects
[0m[49m[38;5;10m+    724[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    725[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    726[0m:[38;5;10m[49m /// The Rust `.so` must export every symbol the C `.so` exports, by exact name.
[0m[49m[38;5;10m+    727[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    728[0m:[38;5;10m[49m fn phase_d_symbol_parity() {
