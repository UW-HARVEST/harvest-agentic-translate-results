[0m[49m[38;5;10m+    700[0m:[38;5;10m[49m     assert_eq!(p.rust(MODE_4, 1, 0, 0), ERR_MODE4_NULL);
[0m[49m[38;5;10m+    701[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    702[0m:[38;5;10m[49m     // Rows 7/8 (`safe_double_to_int` clamps) are only called from modes 0001 and
