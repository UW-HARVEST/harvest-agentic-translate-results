[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m     // the two libraries must still agree.
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m     for m in 0..=5 {
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m         let c_now = p.c(m, 3, 2, 7);
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m         let r_now = p.rust(m, 3, 2, 7);
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m         let (c0, r0) = base[m as usize];
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m         assert_eq!(c_now, c0, "C mode {m} drifted: {c0} -> {c_now}");
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m         assert_eq!(r_now, r0, "Rust mode {m} drifted: {r0} -> {r_now}");
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m         assert_eq!(c_now, r_now, "mode {m}: C {c_now} != Rust {r_now}");
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m 
