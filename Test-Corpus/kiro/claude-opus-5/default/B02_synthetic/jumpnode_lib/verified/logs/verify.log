[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m         p.assert_same(m, rng.next_i32(), rng.next_i32(), rng.next_i32());
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m 
