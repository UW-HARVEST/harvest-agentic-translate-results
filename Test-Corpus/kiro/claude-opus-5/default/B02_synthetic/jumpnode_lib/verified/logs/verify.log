[0m[49m[38;5;10m+    630[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    631[0m:[38;5;10m[49m /// Out-of-range "enum" values crossing the FFI boundary. A C `switch` on an int
[0m[49m[38;5;10m+    632[0m:[38;5;10m[49m /// accepts any bit pattern, so a value with no matching `case` is a real input.
[0m[49m[38;5;10m+    633[0m:[38;5;10m[49m /// Both sides must take the `default:` arm identically.
[0m[49m[38;5;10m+    634[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    635[0m:[38;5;10m[49m fn phase_c_out_of_range_enum_values() {
[0m[49m[38;5;10m+    636[0m:[38;5;10m[49m     let p = Pair::load();
[0m[49m[38;5;10m+    637[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    638[0m:[38;5;10m[49m     // Every mode value one step outside the valid 1..=4 window.
[0m[49m[38;5;10m+    639[0m:[38;5;10m[49m     for m in [0, 5, -1, i32::MIN, i32::MAX] {
[0m[49m[38;5;10m+    640[0m:[38;5;10m[49m         let got = p.assert_same(m, 0, 0, 0);
[0m[49m[38;5;10m+    641[0m:[38;5;10m[49m         assert_eq!(got, ERR_DEFAULT, "mode {m} must be rejected as unknown");
[0m[49m[38;5;10m+    642[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    643[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    644[0m:[38;5;10m[49m     // The STATUS_* constants themselves, misused as modes.
[0m[49m[38;5;10m+    645[0m:[38;5;10m[49m     for m in [0o0, 0o1, 0o2, 0o377] {
[0m[49m[38;5;10m+    646[0m:[38;5;10m[49m         p.assert_same(m, 42, 7, 9);
[0m[49m[38;5;10m+    647[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    648[0m:[38;5;10m[49m     assert_eq!(p.assert_same(0o0, 42, 7, 9), ERR_DEFAULT);
[0m[49m[38;5;10m+    649[0m:[38;5;10m[49m     assert_eq!(p.assert_same(0o377, 42, 7, 9), ERR_DEFAULT);
[0m[49m[38;5;10m+    650[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    651[0m:[38;5;10m[49m     // Values that alias 1..=4 only in their low bits must NOT be accepted.
[0m[49m[38;5;10m+    652[0m:[38;5;10m[49m     for shift in 8..31u32 {
[0m[49m[38;5;10m+    653[0m:[38;5;10m[49m         for low in 1..=4i32 {
[0m[49m[38;5;10m+    654[0m:[38;5;10m[49m             let m = low | (1 << shift);
[0m[49m[38;5;10m+    655[0m:[38;5;10m[49m             let got = p.assert_same(m, 1, 1, 1);
[0m[49m[38;5;10m+    656[0m:[38;5;10m[49m             assert_eq!(got, ERR_DEFAULT, "mode {m} (0x{m:x}) must hit default");
[0m[49m[38;5;10m+    657[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    658[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    659[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    660[0m:[38;5;10m[49m     // Exhaustive sweep of a contiguous window around the valid range.
[0m[49m[38;5;10m+    661[0m:[38;5;10m[49m     for m in -4096..=4096 {
[0m[49m[38;5;10m+    662[0m:[38;5;10m[49m         let got = p.assert_same(m, 123, -456, 789);
[0m[49m[38;5;10m+    663[0m:[38;5;10m[49m         if !(1..=4).contains(&m) {
[0m[49m[38;5;10m+    664[0m:[38;5;10m[49m             assert_eq!(got, ERR_DEFAULT, "mode {m} must hit default");
[0m[49m[38;5;10m+    665[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    666[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    667[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    668[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    669[0m:[38;5;10m[49m /// Generic boundary sweep (ERRORS.md G1..G8): each of the four `int` arguments
[0m[49m[38;5;10m+    670[0m:[38;5;10m[49m /// driven to `INT_MIN` / `INT_MAX` / `0` / `-1` / one-past-valid, in every mode.
[0m[49m[38;5;10m+    671[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    672[0m:[38;5;10m[49m fn phase_c_generic_boundaries() {
[0m[49m[38;5;10m+    673[0m:[38;5;10m[49m     let p = Pair::load();
[0m[49m[38;5;10m+    674[0m:[38;5;10m[49m     let edges = [i32::MIN, i32::MIN + 1, -1, 0, 1, 15, 16, 17, i32::MAX - 1, i32::MAX];
[0m[49m[38;5;10m+    675[0m:[38;5;10m[49m     for m in [i32::MIN, -1, 0, 1, 2, 3, 4, 5, i32::MAX] {
[0m[49m[38;5;10m+    676[0m:[38;5;10m[49m         for &n in &edges {
[0m[49m[38;5;10m+    677[0m:[38;5;10m[49m             for &d in &edges {
[0m[49m[38;5;10m+    678[0m:[38;5;10m[49m                 for &f in &edges {
[0m[49m[38;5;10m+    679[0m:[38;5;10m[49m                     p.assert_same(m, n, d, f);
[0m[49m[38;5;10m+    680[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    681[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    682[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    683[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    684[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    685[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    686[0m:[38;5;10m[49m /// ERRORS.md rows 1, 2, 7, 8, 9, 10 — rejections that exist in the C source but
[0m[49m[38;5;10m+    687[0m:[38;5;10m[49m /// are not reachable through the single exported symbol. This test pins down the
[0m[49m[38;5;10m+    688[0m:[38;5;10m[49m /// preemption that makes them unreachable, so the claim stays honest and is
[0m[49m[38;5;10m+    689[0m:[38;5;10m[49m /// re-checked on every run rather than merely asserted in a document.
[0m[49m[38;5;10m+    690[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    691[0m:[38;5;10m[49m fn phase_c_unreachable_rows() {
[0m[49m[38;5;10m+    692[0m:[38;5;10m[49m     let p = Pair::load();
[0m[49m[38;5;10m+    693[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    694[0m:[38;5;10m[49m     // Row 1 (`add_node`: node_count >= MAX_NODES) and row 2's only caller path:
[0m[49m[38;5;10m+    695[0m:[38;5;10m[49m     // `add_node` is called exclusively by `initialize_test_data`, which has no
