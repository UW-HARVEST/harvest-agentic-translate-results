[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m     assert_eq!(p.c(MODE_1, 1, 0, 0), ERR_MODE1_NULL);
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m     assert_eq!(p.rust(MODE_1, 1, 0, 0), ERR_MODE1_NULL);
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m     assert_eq!(p.c(MODE_2, 1, 0, 0), ERR_MODE2_NULL);
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m     assert_eq!(p.rust(MODE_2, 1, 0, 0), ERR_MODE2_NULL);
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m     assert_eq!(p.c(MODE_4, 1, 0, 0), ERR_MODE4_NULL);
