import subprocess
fails=[]
def run(data, name):
    c = subprocess.run(['./c_src/build/driver'], input=data, capture_output=True)
    r = subprocess.run(['./translation/target/release/driver'], input=data, capture_output=True)
    if (c.stdout,c.stderr,c.returncode)!=(r.stdout,r.stderr,r.returncode):
        print("MISMATCH", name, c.returncode, r.returncode)
        # find first differing byte
        a,b=c.stdout,r.stdout
        i=next((k for k in range(min(len(a),len(b))) if a[k]!=b[k]), min(len(a),len(b)))
        print("  stdout first diff at",i,"len",len(a),len(b))
        print("  C:",a[max(0,i-80):i+80]); print("  R:",b[max(0,i-80):i+80])
        if c.stderr!=r.stderr: print("  Cerr:",c.stderr[:300],"\n  Rerr:",r.stderr[:300])
        fails.append(name); return
    print("ok", name)

# >100 tokens truncation in interactive tokenizer
