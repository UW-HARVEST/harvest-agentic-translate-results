    words = b" ".join(b"w%d"%i for i in range(n))
    run(b"1\n" + words + b"\n\n3\n7\n", f"words{n}")
# repeated words for bubble sort ordering
run(b"1\naa bb aa cc bb aa dd\n\n3\n7\n", "sortwords")
run(b"1\n" + b" ".join([b"a"]*5+[b"b"]*3+[b"c"]*7+[b"d"]*7) + b"\n\n3\n7\n", "sortties")
# 4096 input fill (MAX_INPUT_SIZE)
for n in (4094,4095,4096,4097,5000):
    run(b"1\n" + b"a"*200 + b"\n"*0 + b"\n\n7\n" if False else b"1\n" + (b"ab"*(n//2))[:n] + b"\n\n7\n", f"fill{n}")
# many lines to fill 4096
run(b"1\n" + b"".join(b"line%d\n"%i for i in range(800)) + b"\n7\n", "manylines")
# fgets line splitting: 254,255,256,257 char lines
