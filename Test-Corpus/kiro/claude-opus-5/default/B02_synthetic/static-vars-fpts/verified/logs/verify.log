import subprocess, random
random.seed(1234)
alpha = list(b'abcXYZ_019 \t\n"\'\\/*+-=<>!&|^~?:(){}[];,.%#@\x00\x0b\x0c\r\x80\xff')
menu = [b"1\n",b"2\n",b"3\n",b"4\n",b"5\n",b"6\n",b"0\n",b"x\n",b"\n",b"-3\n",b"8\n"]
fails=0; total=0
for it in range(600):
    parts=[]
    for _ in range(random.randint(1,6)):
        parts.append(random.choice(menu))
        # payload lines
        for _ in range(random.randint(0,4)):
            n=random.randint(0,60)
            parts.append(bytes(random.choice(alpha) for _ in range(n))+b"\n")
        parts.append(b"\n")
    data=b"".join(parts)
    if random.random()<0.2: data=data.rstrip(b"\n")
    c = subprocess.run(['./c_src/build/driver'], input=data, capture_output=True)
    r = subprocess.run(['./translation/target/release/driver'], input=data, capture_output=True)
    total+=1
    if (c.stdout,c.stderr,c.returncode)!=(r.stdout,r.stderr,r.returncode):
        fails+=1
        print("MISMATCH iter",it,"rc",c.returncode,r.returncode)
        print("  input:", data[:400])
        a,b=c.stdout,r.stdout
        i=next((k for k in range(min(len(a),len(b))) if a[k]!=b[k]), min(len(a),len(b)))
        print("  out diff@",i,len(a),len(b)); print("  C:",a[max(0,i-120):i+120]); print("  R:",b[max(0,i-120):i+120])
        if c.stderr!=r.stderr: print("  Cerr:",c.stderr[:200],"Rerr:",r.stderr[:200])
        if fails>5: break
print("fuzz done", total, "cases,", fails, "mismatches")
