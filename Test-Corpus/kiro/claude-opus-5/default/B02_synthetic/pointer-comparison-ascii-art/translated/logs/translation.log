import re
p='src/main.rs'
s=open(p).read()

# hoist expressions that borrow `app` immutably out of cprintf(&mut app.out, ...) calls
pat = re.compile(r'(?P<ind>[ ]*)cprintf\(\n(?P<ind2>[ ]*)&mut app\.out,\n(?P<ind3>[ ]*)(?P<fmt>b"[^\n]*",)\n(?P<ind4>[ ]*)&\[Arg::D\((?P<expr>[^\n]*?)\)\],\n(?P<ind5>[ ]*)\);')
def repl(m):
    expr=m.group('expr')
    if 'app.' not in expr:
        return m.group(0)
    ind=m.group('ind')
    return (f"{ind}let arg0 = {expr};\n"
            f"{ind}cprintf(\n{m.group('ind2')}&mut app.out,\n{m.group('ind3')}{m.group('fmt')}\n"
            f"{m.group('ind4')}&[Arg::D(arg0)],\n{m.group('ind5')});")
s2,n = pat.subn(repl, s)
print('rewrites:', n)
open(p,'w').write(s2)
EOF
