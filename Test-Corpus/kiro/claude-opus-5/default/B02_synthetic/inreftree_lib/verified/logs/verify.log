[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m fn err_generic_boundaries_one_past_valid_range() {
[0m[49m[38;5;10m+    603[0m:[38;5;10m[49m     let p = Pair::load();
[0m[49m[38;5;10m+    604[0m:[38;5;10m[49m     let mut r = Rng::new(0xC0FF);
[0m[49m[38;5;10m+    605[0m:[38;5;10m[49m 
