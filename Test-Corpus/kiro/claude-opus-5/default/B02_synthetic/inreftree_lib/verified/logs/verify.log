[0m[49m[38;5;10m+    636[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    637[0m:[38;5;10m[49m fn err_18_dead_parent_id_recheck() {
[0m[49m[38;5;10m+    638[0m:[38;5;10m[49m     let p = Pair::open();
[0m[49m[38;5;10m+    639[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 118);
[0m[49m[38;5;10m+    640[0m:[38;5;10m[49m     // `parent->id != parent_id` can never fire: find_node_by_id only returns a
[0m[49m[38;5;10m+    641[0m:[38;5;10m[49m     // node whose id already equals the argument. Assert the invariant directly
[0m[49m[38;5;10m+    642[0m:[38;5;10m[49m     // through the exports, over randomized tables incl. duplicate ids.
[0m[49m[38;5;10m+    643[0m:[38;5;10m[49m     for _ in 0..4_000 {
[0m[49m[38;5;10m+    644[0m:[38;5;10m[49m         p.reset_both();
[0m[49m[38;5;10m+    645[0m:[38;5;10m[49m         let count = (rng.below(MAX_NODES as u32) + 1) as usize;
[0m[49m[38;5;10m+    646[0m:[38;5;10m[49m         let l = cstr(b"l");
[0m[49m[38;5;10m+    647[0m:[38;5;10m[49m         for i in 0..count {
[0m[49m[38;5;10m+    648[0m:[38;5;10m[49m             let id = (rng.below(6) as c_int) + 1; // heavy duplication
[0m[49m[38;5;10m+    649[0m:[38;5;10m[49m             let v = rng.next_i32_mixed();
