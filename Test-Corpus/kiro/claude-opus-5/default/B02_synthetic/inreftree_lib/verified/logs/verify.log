[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m fn err_16_inreftree_target_null_unreachable() {
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m     let p = Pair::open();
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 116);
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m     p.reset_both();
