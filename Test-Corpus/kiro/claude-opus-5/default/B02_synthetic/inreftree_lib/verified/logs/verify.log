[0m[49m[38;5;10m+    651[0m:[38;5;10m[49m                 p.c.add_tree_node(id, v, -1, &l),
[0m[49m[38;5;10m+    652[0m:[38;5;10m[49m                 p.r.add_tree_node(id, v, -1, &l)
[0m[49m[38;5;10m+    653[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    654[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    655[0m:[38;5;10m[49m         for id in [1, 2, 3, 4, 5, 6, 7, -1, 0] {
[0m[49m[38;5;10m+    656[0m:[38;5;10m[49m             let idx = p.c.find_node_by_id(id);
[0m[49m[38;5;10m+    657[0m:[38;5;10m[49m             assert_eq!(idx, p.r.find_node_by_id(id));
[0m[49m[38;5;10m+    658[0m:[38;5;10m[49m             if let Some(i) = idx {
