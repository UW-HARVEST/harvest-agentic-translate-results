[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m                     rows[k].right_child_id = if rr < count { rr as c_int + 1 } else { -1 };
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m         // Keep links inside the live range so no cycle / unbounded recursion
