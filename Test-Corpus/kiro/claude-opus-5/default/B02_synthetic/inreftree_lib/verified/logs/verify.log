[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m         // the sum is unaffected by the retarget; only the 2nd operand changes
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m         let sum = p.c.calculate_tree_sum(1);
