[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m fn err_17_inreftree_negative_modulo_oob_read() {
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m     let p = Pair::open();
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 117);
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m     p.reset_both();
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m     // tree_sum % 4 in {-1, -2, -3} indexes BEFORE the "+*-%" literal.
[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m     for class in [1i32, 2, 3] {
[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m         for _ in 0..10_000 {
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m             let mag = (rng.next_u32() % 200_000) as i32 * 4;
[0m[49m[38;5;10m+    603[0m:[38;5;10m[49m             let sum = -(mag + class);
