[0m[49m[38;5;10m+    620[0m:[38;5;10m[49m             let sum = -(mag + class);
[0m[49m[38;5;10m+    621[0m:[38;5;10m[49m             let a = rng.next_i32() >> 3;
[0m[49m[38;5;10m+    622[0m:[38;5;10m[49m             let c = rng.next_i32() >> 3;
[0m[49m[38;5;10m+    623[0m:[38;5;10m[49m             let d = sum.wrapping_sub(a).wrapping_sub(c);
