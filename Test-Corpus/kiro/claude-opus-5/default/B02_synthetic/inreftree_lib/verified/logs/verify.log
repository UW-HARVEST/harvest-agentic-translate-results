[0m[49m[38;5;10m+    699[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    700[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    701[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    702[0m:[38;5;10m[49m fn err_20_oversized_label_truncates() {
[0m[49m[38;5;10m+    703[0m:[38;5;10m[49m     let p = Pair::open();
[0m[49m[38;5;10m+    704[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 120);
[0m[49m[38;5;10m+    705[0m:[38;5;10m[49m     for len in [31usize, 32, 33, 40, 63, 64, 200, 1000] {
[0m[49m[38;5;10m+    706[0m:[38;5;10m[49m         for _ in 0..200 {
[0m[49m[38;5;10m+    707[0m:[38;5;10m[49m             p.reset_both();
[0m[49m[38;5;10m+    708[0m:[38;5;10m[49m             let mut body: Vec<u8> = (0..len)
[0m[49m[38;5;10m+    709[0m:[38;5;10m[49m                 .map(|_| b"abcdefghijklmnopqrstuvwxyz"[rng.below(26) as usize])
[0m[49m[38;5;10m+    710[0m:[38;5;10m[49m                 .collect();
[0m[49m[38;5;10m+    711[0m:[38;5;10m[49m             body.push(0);
[0m[49m[38;5;10m+    712[0m:[38;5;10m[49m             let v = rng.next_i32_mixed();
[0m[49m[38;5;10m+    713[0m:[38;5;10m[49m             let cv = p.c.add_tree_node(9, v, -1, &body);
[0m[49m[38;5;10m+    714[0m:[38;5;10m[49m             let rv = p.r.add_tree_node(9, v, -1, &body);
[0m[49m[38;5;10m+    715[0m:[38;5;10m[49m             assert_eq!(cv, 0, "truncation is not an error");
[0m[49m[38;5;10m+    716[0m:[38;5;10m[49m             assert_eq!(cv, rv, "add_tree_node with a {len}-byte label");
