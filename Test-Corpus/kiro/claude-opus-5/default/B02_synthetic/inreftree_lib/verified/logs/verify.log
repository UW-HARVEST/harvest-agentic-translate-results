[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m             0 => {} // all leaves
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m             1 => rows[0].left_child_id = 2,
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m             2 => rows[0].right_child_id = 2,
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m             3 => {
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m                 rows[0].left_child_id = 2;
