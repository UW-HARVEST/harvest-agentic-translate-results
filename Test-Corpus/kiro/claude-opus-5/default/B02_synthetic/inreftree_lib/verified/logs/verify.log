[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m fn configs_row_15_tree_sum_shapes() {
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m     let p = Pair::load();
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m     let mut r = Rng::new(0x1015);
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m 
