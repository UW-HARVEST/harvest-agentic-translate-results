[0m[49m[38;5;10m+    682[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    683[0m:[38;5;10m[49m                 p.c.add_tree_node(id, v, -1, &l),
[0m[49m[38;5;10m+    684[0m:[38;5;10m[49m                 p.r.add_tree_node(id, v, -1, &l)
[0m[49m[38;5;10m+    685[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    686[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    687[0m:[38;5;10m[49m         for (i, &v) in vals.iter().enumerate() {
[0m[49m[38;5;10m+    688[0m:[38;5;10m[49m             let id = i as c_int + 1;
[0m[49m[38;5;10m+    689[0m:[38;5;10m[49m             let cv = p.c.calculate_tree_sum(id);
