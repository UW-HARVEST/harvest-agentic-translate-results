[0m[49m[38;5;10m+    605[0m:[38;5;10m[49m             let c = rng.next_i32() >> 3;
[0m[49m[38;5;10m+    606[0m:[38;5;10m[49m             let b = 1; // non-zero so target_id stays 2
[0m[49m[38;5;10m+    607[0m:[38;5;10m[49m             let d = sum.wrapping_sub(a).wrapping_sub(b).wrapping_sub(c);
[0m[49m[38;5;10m+    608[0m:[38;5;10m[49m             let cv = p.c.inreftree(a, b, c, d);
[0m[49m[38;5;10m+    609[0m:[38;5;10m[49m             let rv = p.r.inreftree(a, b, c, d);
[0m[49m[38;5;10m+    610[0m:[38;5;10m[49m             assert_eq!(p.c.calculate_tree_sum(1), sum, "sum setup");
[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m             assert_eq!(cv, rv, "inreftree sum={sum} (sum%4={})", sum % 4);
[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m             // the byte read is not an operator, so parse_operation -> OP_ADD
[0m[49m[38;5;10m+    613[0m:[38;5;10m[49m             assert_eq!(cv, sum.wrapping_add(2), "negative-index path must select add_op");
[0m[49m[38;5;10m+    614[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    615[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    616[0m:[38;5;10m[49m     // and the same with param2 == 0 (target 1)
[0m[49m[38;5;10m+    617[0m:[38;5;10m[49m     for class in [1i32, 2, 3] {
[0m[49m[38;5;10m+    618[0m:[38;5;10m[49m         for _ in 0..5_000 {
