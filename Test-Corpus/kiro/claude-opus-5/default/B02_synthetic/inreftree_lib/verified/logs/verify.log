[0m[49m[38;5;10m+    660[0m:[38;5;10m[49m                 assert_eq!(p.r.node(i as usize).id, id, "Rust: found node has a different id");
[0m[49m[38;5;10m+    661[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    662[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    663[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    664[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    665[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    666[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    667[0m:[38;5;10m[49m fn err_19_dead_node_id_recheck() {
