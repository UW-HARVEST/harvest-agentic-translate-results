[0m[49m[38;5;10m+    625[0m:[38;5;10m[49m             let rv = p.r.inreftree(a, 0, c, d);
[0m[49m[38;5;10m+    626[0m:[38;5;10m[49m             assert_eq!(cv, rv, "inreftree({a},0,{c},{d}) sum={sum}");
[0m[49m[38;5;10m+    627[0m:[38;5;10m[49m             assert_eq!(cv, sum.wrapping_add(1));
[0m[49m[38;5;10m+    628[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    629[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    630[0m:[38;5;10m[49m }
