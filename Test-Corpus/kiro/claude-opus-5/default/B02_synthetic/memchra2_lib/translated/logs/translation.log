#include <stdio.h>
#include <stdlib.h>
#include <dlfcn.h>
#include <limits.h>
#include <stdint.h>

typedef int (*fn_t)(int,int,int,int);

static uint64_t s = 0x243F6A8885A308D3ULL;
static uint64_t rnd(void){ s^=s<<13; s^=s>>7; s^=s<<17; return s; }

int main(int argc, char**argv){
    void *hc = dlopen(argv[1], RTLD_NOW);
    void *hr = dlopen(argv[2], RTLD_NOW);
    if(!hc||!hr){ fprintf(stderr,"dlopen: %s\n", dlerror()); return 2; }
    fn_t fc = (fn_t)dlsym(hc,"memchra2");
    fn_t fr = (fn_t)dlsym(hr,"memchra2");
    if(!fc||!fr){ fprintf(stderr,"dlsym failed\n"); return 2; }

    int edge[] = {0,1,-1,2,-2,7,-7,255,256,-255,-256,65535,-65536,
                  INT_MAX,INT_MIN,INT_MAX-1,INT_MIN+1,
                  0x3F800000, 0x447A0000, 0x449C4000, 0x00000001, 0x7F7FFFFF,
                  0x7F800000, 0x7FC00000, (int)0x80000000, (int)0xFF800000,
                  0x3DCCCCCD, 0x40490FDB, 1000, -1000, 12345, -12345,
                  0x00800000, 0x007FFFFF, 0x447A0001, 0x3F7FFFFF};
    int ne = sizeof(edge)/sizeof(edge[0]);
    long fails=0, total=0;

    for(int i=0;i<ne;i++)for(int j=0;j<ne;j++){
        int a=edge[i], b=edge[j], c=edge[(i+j)%ne], d=edge[(i*3+j*7)%ne];
        int rc=fc(a,b,c,d), rr=fr(a,b,c,d); total++;
        if(rc!=rr){ if(fails<20) printf("MISMATCH a=%d b=%d c=%d d=%d C=%d R=%d\n",a,b,c,d,rc,rr); fails++; }
    }
    for(long k=0;k<400000;k++){
        int a=(int)rnd(), b=(int)rnd(), c=(int)rnd(), d=(int)rnd();
        if(k%5==0){ a = edge[rnd()%ne]; }
        if(k%7==0){ b = (int)(rnd()%512) - 256; }
        int rc=fc(a,b,c,d), rr=fr(a,b,c,d); total++;
        if(rc!=rr){ if(fails<20) printf("MISMATCH a=%d b=%d c=%d d=%d C=%d R=%d\n",a,b,c,d,rc,rr); fails++; }
    }
    printf("total=%ld fails=%ld\n", total, fails);
    return fails!=0;
}
EOF
