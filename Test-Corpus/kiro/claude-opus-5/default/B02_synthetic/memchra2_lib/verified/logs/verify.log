#[test]
fn negative_control_values_are_nontrivial_and_distinct() {
    let h = Harness::load();
    let mut seen = std::collections::BTreeSet::new();
    for a in 0..64 { seen.insert(h.c_memchra2(a, a*3, a*7, a*11)); }
    println!("distinct C results over 64 inputs: {}", seen.len());
    assert!(seen.len() > 40, "C outputs are suspiciously constant: {seen:?}");
