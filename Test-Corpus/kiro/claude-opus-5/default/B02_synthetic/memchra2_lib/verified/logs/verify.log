[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m // ------------------------------------------------------- E7 / E8
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m // safe_sum_array: arr == NULL, size == 0 -> return 0
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m // Never taken: `int values[4]`, size = 4. Observable: result += a+b+c+d.
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m fn e7_e8_safe_sum_array_guards() {
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     let p = Pair::load();
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m     e_row(&p, "E7/E8", N, any);
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m     // Vary only `a` by a known delta: the sum term must move the result by the
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m     // same delta (mod the other a-dependent terms, so pick `a` values that
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m     // keep dash_count, the float branch and the low byte identical).
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m     // a = 0x40000000 (f = 2.0) and a = 0x40000000 + 256 keep the low byte and
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m     // the float window, but differ in the sum by 256.
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m     let (b, c, d) = (5, 6, 7);
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m     let a1 = 0x4000_0000i32;
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m     let a2 = a1 + 256;
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m     let r1 = p.c(a1, b, c, d);
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m     let r2 = p.c(a2, b, c, d);
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m     assert_eq!(r1, model(a1, b, c, d));
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m     assert_eq!(r2, model(a2, b, c, d));
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m     assert_ne!(r1, r2, "the a+b+c+d sum term must influence the result");
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m     p.assert_eq_at("E7/E8/exact", a1, b, c, d);
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m     p.assert_eq_at("E7/E8/exact", a2, b, c, d);
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m // ------------------------------------------------------- E9 / E10
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m // interpret_as_int: bytes == NULL, len < sizeof(int) -> return 0
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m // Never taken: len = 4, exactly sizeof(int) — the boundary that PASSES.
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m // Observable: result ^= LE32(b&0xFF, c&0xFF, d&0xFF, 0).
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m fn e9_e10_interpret_as_int_guards() {
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     let p = Pair::load();
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m     e_row(&p, "E9/E10", N, any);
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m     // len == 4 is one step inside the boundary; len == 3 would reject. Prove
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m     // the xor term is live by finding two inputs differing only in b's low
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m     // byte and confirming the result changes accordingly.
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m     assert_eq!(std::mem::size_of::<i32>(), 4, "sizeof(int) assumption");
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m     for &(b_lo, expect_nonzero) in &[(0x00u32, false), (0x01, true), (0xFF, true)] {
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m         let b = (0x1000_0000u32 | b_lo) as i32;
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m         let (c, d) = (0, 0);
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m         let a = 0;
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m             interpreted(b, c, d) != 0,
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m             expect_nonzero,
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m             "interpret_as_int model mismatch for low byte {b_lo:#x}"
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m         assert_eq!(p.c(a, b, c, d), model(a, b, c, d));
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         p.assert_eq_at("E9/E10/exact", a, b, c, d);
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m // ------------------------------------------------------- E11 / E12
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m // count_occurrences: text == NULL, *text == '\0' -> return 0
