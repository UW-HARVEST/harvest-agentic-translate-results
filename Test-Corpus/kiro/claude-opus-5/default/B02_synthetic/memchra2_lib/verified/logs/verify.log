[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m     // must be reflected as a distinct +10*k term in the C result.
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m     for mask in 0u32..16 {
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m         let mk = |neg: bool| if neg { -1i32 } else { 1i32 };
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m         let (a, b, c, d) = (
