   129	    int result = 0;
   130	
   131	    char buffer[64];
   132	    snprintf(buffer, sizeof(buffer), "test%d-%d-%d-%d", a, b, c, d);
   133	
   134	    int dash_count = count_occurrences(buffer, '-');
   135	    result += dash_count * 10;
   136	
