[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m             mk(mask & 8 != 0),
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m         let dc = dash_count(a, b, c, d);
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m         assert_eq!(dc, 3 + mask.count_ones() as i32, "dash_count model");
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m         assert_eq!(p.c(a, b, c, d), model(a, b, c, d));
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m         p.assert_eq_at("E11/E12/exact", a, b, c, d);
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m }
