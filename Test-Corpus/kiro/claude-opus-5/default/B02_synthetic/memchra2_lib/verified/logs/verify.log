[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m     // Pick inputs where the xor is 0: the result must equal the model, and a
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     // -1 return would be visible as an off-by-one.
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m     let (a, b, c, d) = (0x0100_0055u32 as i32, 0x0200_0055u32 as i32, 0x0300_0055u32 as i32, 0x0400_0055u32 as i32);
