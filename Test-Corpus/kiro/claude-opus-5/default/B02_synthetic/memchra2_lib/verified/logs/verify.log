[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m // ------------------------------------------------------- E3..E6
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m // process_strings: strings == NULL, count <= 0 -> return 0;
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m //                  *i == NULL, **i == '\0'     -> continue
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m // Never taken: fixed 4-element array of non-empty literals, count = 4.
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m // Observable: matches == 3, contributing +15.
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m fn e3_e6_process_strings_guards() {
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m     let p = Pair::load();
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m     e_row(&p, "E3/E6", N, any);
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m     // The +15 term is a constant; prove it is present by differencing the C
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m     // result against the model with `matches` forced to the rejected value 0.
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m     let (a, b, c, d) = (7, 11, 13, 17);
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m     let with_15 = p.c(a, b, c, d);
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m     let without_15 = model(a, b, c, d).wrapping_sub(15);
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m     assert_ne!(
