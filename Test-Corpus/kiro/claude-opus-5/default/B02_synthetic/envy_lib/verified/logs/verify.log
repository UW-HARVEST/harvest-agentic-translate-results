[0m[49m[38;5;10m+    812[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    813[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    814[0m:[38;5;10m[49m             (0, 0, 0, 0, 0, 0, false)
[0m[49m[38;5;10m+    815[0m:[38;5;10m[49m         });
[0m[49m[38;5;10m+    816[0m:[38;5;10m[49m         let (p1, p2, p3, p4, cv, rv, bad) = cap.0.clone().into();
[0m[49m[38;5;10m+    817[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    818[0m:[38;5;10m[49m             !bad,
[0m[49m[38;5;10m+    819[0m:[38;5;10m[49m             "DIVERGENCE [row46] envy({p1}, {p2}, {p3}, {p4}): C = {cv}, Rust = {rv}"
[0m[49m[38;5;10m+    820[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    821[0m:[38;5;10m[49m         assert!(
