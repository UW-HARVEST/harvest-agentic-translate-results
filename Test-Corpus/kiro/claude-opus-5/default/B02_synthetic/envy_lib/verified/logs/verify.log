[0m[49m[38;5;10m+    803[0m:[38;5;10m[49m             for &(p1, p2, p3, p4) in &params {
[0m[49m[38;5;10m+    804[0m:[38;5;10m[49m                 let cv = unsafe { (b.c.envy)(p1, p2, p3, p4) };
[0m[49m[38;5;10m+    805[0m:[38;5;10m[49m                 let rv = unsafe { (b.rs.envy)(p1, p2, p3, p4) };
[0m[49m[38;5;10m+    806[0m:[38;5;10m[49m                 if cv != rv {
[0m[49m[38;5;10m+    807[0m:[38;5;10m[49m                     // Reported by the assert below; stash nothing here.
