[0m[49m[38;5;10m+    824[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    825[0m:[38;5;10m[49m         let _ = cap.1;
[0m[49m[38;5;10m+    826[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    827[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    828[0m:[38;5;10m[49m     // Hand-built cases pinned on the boundary, plus verbose on/off.
