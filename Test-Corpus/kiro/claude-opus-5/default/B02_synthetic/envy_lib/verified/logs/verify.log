[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m /// Serialises the process-global state the tests mutate: `environ`, and fds 1/2.
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m pub fn lock() -> MutexGuard<'static, ()> {
