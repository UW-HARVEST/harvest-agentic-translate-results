#include <stdio.h>
#include <string.h>
struct ConfigFlags {
    unsigned int verbose : 1;
    unsigned int debug : 1;
    unsigned int optimize : 1;
    unsigned int cache_enabled : 1;
    unsigned int log_level : 3;
    unsigned int reserved : 1;
};
struct ProcessState {
    struct ConfigFlags flags;
    int base_value;
    int multiplier;
    char operation;
};
int main(void){
    printf("sizeof ConfigFlags=%zu align=%zu\n", sizeof(struct ConfigFlags), _Alignof(struct ConfigFlags));
    printf("sizeof ProcessState=%zu align=%zu\n", sizeof(struct ProcessState), _Alignof(struct ProcessState));
    printf("off flags=%zu base=%zu mult=%zu op=%zu\n", offsetof(struct ProcessState,flags), offsetof(struct ProcessState,base_value), offsetof(struct ProcessState,multiplier), offsetof(struct ProcessState,operation));
    struct ConfigFlags f; unsigned int raw;
    const char* names[6]={"verbose","debug","optimize","cache_enabled","log_level","reserved"};
    for(int i=0;i<6;i++){
        memset(&f,0,sizeof f);
        switch(i){case 0:f.verbose=1;break;case 1:f.debug=1;break;case 2:f.optimize=1;break;case 3:f.cache_enabled=1;break;case 4:f.log_level=7;break;case 5:f.reserved=1;break;}
        memcpy(&raw,&f,sizeof raw);
        printf("%s -> 0x%08x\n", names[i], raw);
    }
    /* check whether upper bits survive a full init */
    memset(&f,0xFF,sizeof f);
    f.verbose=0;f.debug=0;f.optimize=0;f.cache_enabled=1;f.log_level=03;f.reserved=0;
    memcpy(&raw,&f,sizeof raw);
    printf("after full init from 0xFFFFFFFF -> 0x%08x\n", raw);
    return 0;
}
EOF
