    31	#define OP_ADD 0x01
    32	#define OP_MULTIPLY 0x02
    33	#define OP_XOR 0x03
    34	#define OP_SHIFT 0x04
    35	#define MAGIC_NUMBER 0xDEADBEEF
    36	#define MASK_LOWER 0x0000FFFF
    37	
    38	typedef struct {
    39	    int accumulator;
    40	    int operation_count;
    41	    unsigned int checksum;
    42	} ComputeState;
    43	
    44	typedef int (*operation_func)(int, int);
    45	
    46	static int static_multiplier = 3;
    47	static int static_addend = 100;
    48	static int static_shift_amount = 2;
    49	
    50	int multiply_with_static(int a, int b) {
    51	    return (a * b) * static_multiplier;
    52	}
    53	
    54	int add_with_static(int a, int b) {
    55	    return (a + b) + static_addend;
    56	}
    57	
    58	int xor_operation(int a, int b) {
    59	    return a ^ b ^ 0xABCD;
    60	}
    61	
    62	int shift_with_static(int a, int b) {
    63	    return (a << static_shift_amount) | (b >> static_shift_amount);
    64	}
    65	
    66	operation_func get_operation(int opcode) {
    67	    static operation_func ops[4] = {NULL, NULL, NULL, NULL};
    68	
    69	    if (ops[0] == NULL) {
    70	        ops[0] = multiply_with_static;
    71	        ops[1] = add_with_static;
    72	        ops[2] = xor_operation;
    73	        ops[3] = shift_with_static;
    74	    }
    75	
    76	    if (opcode >= 0 && opcode < 4) {
    77	        return ops[opcode];
    78	    }
    79	
    80	    return NULL;
    81	}
    82	
    83	int execute_operation(operation_func func, int a, int b, const char* op_name) {
    84	    if (func == NULL) {
    85	        printf("Error: Operation function pointer is NULL for %s\n", op_name);
    86	        return 0;
    87	    }
    88	
    89	    LOG_VALUE(a);
    90	    LOG_VALUE(b);
    91	
    92	    int result = func(a, b);
    93	    printf("Result of %s: %d\n", op_name, result);
    94	
    95	    return result;
    96	}
    97	
    98	unsigned int compute_checksum(int* values, int count) {
    99	    unsigned int checksum = 0;
   100	    unsigned char buffer[sizeof(int) * 4];
   101	
   102	    if (values != NULL && count > 0) {
   103	        int copy_count = (count > 4) ? 4 : count;
   104	        memcpy(buffer, values, sizeof(int) * copy_count);
   105	
   106	        for (int i = 0; i < sizeof(int) * copy_count; i++) {
   107	            checksum = (checksum << 1) ^ buffer[i];
   108	        }
   109	
   110	        checksum ^= MAGIC_NUMBER;
   111	    }
   112	
   113	    return checksum & MASK_LOWER;
   114	}
   115	
   116	void init_state(ComputeState* state, int initial_value) {
   117	    if (state == NULL) {
   118	        printf("Error: state pointer is NULL in init_state\n");
   119	        return;
   120	    }
   121	
   122	    ComputeState template = {initial_value, 0, 0x0000};
   123	
   124	    memcpy(state, &template, sizeof(ComputeState));
   125	
   126	    printf("State initialized with accumulator = %d\n", state->accumulator);
   127	}
   128	
   129	void apply_operation(ComputeState* state, int value, operation_func func) {
   130	    if (state == NULL) {
   131	        printf("Error: state pointer is NULL in apply_operation\n");
   132	        return;
   133	    }
   134	
   135	    if (func == NULL) {
   136	        printf("Error: operation function pointer is NULL in apply_operation\n");
   137	        return;
   138	    }
   139	
   140	    state->accumulator = func(state->accumulator, value);
   141	    state->operation_count++;
   142	}
   143	
   144	int checkshift(int param1, int param2, int param3, int param4) {
   145	    printf("\n=== Starting foo function ===\n");
   146	    printf("Parameters: %d, %d, %d, %d\n", param1, param2, param3, param4);
   147	
   148	    ComputeState* state = (ComputeState*)malloc(sizeof(ComputeState));
   149	
   150	    if (state == NULL) {
   151	        printf("Error: Failed to allocate memory for state\n");
   152	        return -1;
   153	    }
   154	
   155	    init_state(state, param1);
   156	
   157	    int params[4] = {param1, param2, param3, param4};
   158	
   159	    operation_func mult_op = get_operation(0);
   160	    operation_func add_op = get_operation(1);
   161	    operation_func xor_op = get_operation(2);
   162	    operation_func shift_op = get_operation(3);
   163	
   164	    printf("\n--- Operation 1: Multiply ---\n");
   165	    apply_operation(state, param2, mult_op);
   166	
   167	    printf("\n--- Operation 2: Add ---\n");
   168	    apply_operation(state, param3, add_op);
   169	
   170	    printf("\n--- Operation 3: XOR ---\n");
   171	    int xor_result = execute_operation(xor_op, state->accumulator, param4, "XOR");
   172	
   173	    printf("\n--- Operation 4: Shift ---\n");
   174	    int shift_result = execute_operation(shift_op, xor_result, param2, "SHIFT");
   175	
   176	    state->checksum = compute_checksum(params, 4);
   177	    printf("\nComputed checksum: 0x%04X\n", state->checksum);
   178	
   179	    int final_result = (state->accumulator + shift_result) ^ state->checksum;
   180	
   181	    printf("\nFinal accumulator: %d\n", state->accumulator);
   182	    printf("Operation count: %d\n", state->operation_count);
   183	    printf("Final result: %d\n", final_result);
   184	
   185	    free(state);
   186	    state = NULL;
   187	
   188	    printf("=== Ending foo function ===\n\n");
   189	
   190	    return final_result;
   191	}
