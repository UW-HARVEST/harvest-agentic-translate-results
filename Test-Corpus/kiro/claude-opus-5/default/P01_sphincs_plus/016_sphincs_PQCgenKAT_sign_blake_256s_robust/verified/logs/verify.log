    86	            unsigned char *left = &stack[h * SPX_N];
    87	            memcpy( &current[0], left, SPX_N );
    88	            thash( &current[1 * SPX_N],
    89	                   &current[0 * SPX_N],
    90	                   2, ctx, tree_addr);
    91	        }
