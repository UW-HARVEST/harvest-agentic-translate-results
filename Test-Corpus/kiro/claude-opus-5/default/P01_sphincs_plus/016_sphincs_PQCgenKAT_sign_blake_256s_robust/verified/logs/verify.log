            &buf[..SPX_ADDR_BYTES],
            SPX_ADDR_BYTES as u64,
            ctx,
        );

        for i in 0..n {
            buf[SPX_ADDR_BYTES + i] = inp[i] ^ bitmask[i];
        }

        let total = SPX_ADDR_BYTES + n;
        let (out_part, buf_part) = (&mut out[..SPX_N], &buf[..total]);
        haraka_s(
            out_part,
            SPX_N as u64,
            buf_part,
            total as u64,
            ctx,
        );
    }
}
