    67	  blakeX_update(&S, m, mlen);
    68	  blakeX_final(&S, R);
    69	}
    70	
    71	/**
    72	 * Computes the message hash using R, the public key, and the message.
    73	 * Outputs the message digest and the index of the leaf. The index is split in
    74	 * the tree index and the leaf index, for convenient copying to an address.
    75	 */
    76	void hash_message(unsigned char *digest, uint64_t *tree, uint32_t *leaf_idx,
    77			  const unsigned char *R, const unsigned char *pk,
    78			  const unsigned char *m, unsigned long long mlen,
    79			  const spx_ctx *ctx)
    80	{
    81	  (void)ctx;
    82	#define SPX_TREE_BITS (SPX_TREE_HEIGHT * (SPX_D - 1))
    83	#define SPX_TREE_BYTES ((SPX_TREE_BITS + 7) / 8)
    84	#define SPX_LEAF_BITS SPX_TREE_HEIGHT
    85	#define SPX_LEAF_BYTES ((SPX_LEAF_BITS + 7) / 8)
    86	#define SPX_DGST_BYTES (SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES)
    87	
    88	  unsigned char buf[SPX_DGST_BYTES];
    89	  unsigned char *bufp = buf;
    90	  unsigned char seed[2*SPX_N + SPX_BLAKEX_OUTPUT_BYTES];
    91	  
    92	  blakestateX S;
    93	  blakeX_init(&S);
    94	  
    95	  blakeX_update(&S, R, SPX_N);
    96	  blakeX_update(&S, pk, SPX_PK_BYTES);
    97	  blakeX_update(&S, m, mlen);
    98	
    99	  blakeX_final(&S, seed+ 2 * SPX_N);
   100	
   101	  memcpy(seed, R, SPX_N);
   102	  memcpy(seed + SPX_N, pk, SPX_N);
   103	  
   104	  blakeX_mgf1(bufp, SPX_DGST_BYTES, seed, 2*SPX_N + SPX_BLAKEX_OUTPUT_BYTES);
   105	
   106	  memcpy(digest, bufp, SPX_FORS_MSG_BYTES);
   107	  bufp += SPX_FORS_MSG_BYTES;
   108	
   109	#if SPX_TREE_BITS > 64
   110	#error For given height and depth, 64 bits cannot represent all subtrees
   111	#endif
   112	
   113	  if (SPX_D == 1) {
   114	    *tree = 0;
   115	  } else {
   116	    *tree = bytes_to_ull(bufp, SPX_TREE_BYTES);
   117	    *tree &= (~(uint64_t)0) >> (64 - SPX_TREE_BITS);
   118	  }
   119	  bufp += SPX_TREE_BYTES;
   120	
   121	  *leaf_idx = (uint32_t)bytes_to_ull(bufp, SPX_LEAF_BYTES);
   122	  *leaf_idx &= (~(uint32_t)0) >> (32 - SPX_LEAF_BITS);
   123	}
