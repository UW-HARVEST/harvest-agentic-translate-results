   344	/*
   345	 * This generates a Merkle signature (WOTS signature followed by the Merkle
   346	 * authentication path).  This is in this file because most of the complexity
   347	 * is involved with the WOTS signature; the Merkle authentication path logic
   348	 * is mostly hidden in treehashx4
   349	 */
   350	void merkle_sign(uint8_t *sig, unsigned char *root,
   351	                 const spx_ctx *ctx,
   352	                 uint32_t wots_addr[8], uint32_t tree_addr[8],
   353	                 uint32_t idx_leaf)
   354	{
   355	    unsigned char *auth_path = sig + SPX_WOTS_BYTES;
   356	    struct leaf_info_x1 info = { 0 };
   357	    unsigned steps[ SPX_WOTS_LEN ];
   358	
   359	    info.wots_sig = sig;
   360	    chain_lengths(steps, root);
   361	    info.wots_steps = steps;
   362	
   363	    set_type(&tree_addr[0], SPX_ADDR_TYPE_HASHTREE);
   364	    set_type(&info.pk_addr[0], SPX_ADDR_TYPE_WOTSPK);
   365	    copy_subtree_addr(&info.leaf_addr[0], wots_addr);
   366	    copy_subtree_addr(&info.pk_addr[0], wots_addr);
   367	
   368	    info.wots_sign_leaf = idx_leaf;
   369	
   370	    wots_treehashx1(root, auth_path, ctx,
   371	                idx_leaf, 0,
   372	                SPX_TREE_HEIGHT,
   373	                tree_addr, &info);
   374	}
   375	
   376	/* Compute root node of the top-most subtree. */
   377	void merkle_gen_root(unsigned char *root, const spx_ctx *ctx)
   378	{
   379	    /* We do not need the auth path in key generation, but it simplifies the
   380	       code to have just one treehash routine that computes both root and path
   381	       in one function. */
   382	    unsigned char auth_path[SPX_TREE_HEIGHT * SPX_N + SPX_WOTS_BYTES];
   383	    uint32_t top_tree_addr[8] = {0};
   384	    uint32_t wots_addr[8] = {0};
   385	
   386	    set_layer_addr(top_tree_addr, SPX_D - 1);
   387	    set_layer_addr(wots_addr, SPX_D - 1);
   388	
   389	    merkle_sign(auth_path, root, ctx,
   390	                wots_addr, top_tree_addr,
   391	                (uint32_t)~0 /* ~0 means "don't bother generating an auth path */ );
   392	}
