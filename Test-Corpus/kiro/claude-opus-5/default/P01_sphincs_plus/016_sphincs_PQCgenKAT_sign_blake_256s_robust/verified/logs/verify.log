    let mut bitmask = [0u8; SPX_MAX_INBLOCKS * SPX_N];
    let mut buf = [0u8; SPX_N + SPX_SHA256_OUTPUT_BYTES + SPX_MAX_INBLOCKS * SPX_N];
    let mut sha2_state = [0u8; 40];
