    74	            if ((internal_idx & 1) == 0 && idx < max_idx) {
    75	                break;
    76	            }
    77	
    78	            /* Ok, we're at a right node */
    79	            /* Now combine the left and right logical nodes together */
    80	
    81	            /* Set the address of the node we're creating. */
    82	            internal_idx_offset >>= 1;
    83	            set_tree_height(tree_addr, h + 1);
    84	            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );
