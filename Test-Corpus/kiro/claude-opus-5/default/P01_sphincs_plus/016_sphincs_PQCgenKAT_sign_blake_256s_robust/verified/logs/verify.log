     6	use std::fs::File;
     7	use std::io::Read;
     8	use std::sync::Mutex;
     9	use std::sync::OnceLock;
    10	
    11	/// Stands in for `static int fd = -1;`.
    12	fn urandom() -> &'static Mutex<File> {
    13	    static FD: OnceLock<Mutex<File>> = OnceLock::new();
    14	    FD.get_or_init(|| {
    15	        loop {
    16	            match File::open("/dev/urandom") {
    17	                Ok(f) => return Mutex::new(f),
    18	                Err(_) => std::thread::sleep(std::time::Duration::from_secs(1)),
    19	            }
    20	        }
    21	    })
    22	}
    23	
    24	/// The `randombytes()` from `randombytes.c`.
    25	pub fn randombytes_urandom(x: &mut [u8]) {
    26	    let file = urandom();
    27	    let mut guard = file.lock().unwrap();
    28	
    29	    let mut off = 0usize;
    30	    let mut xlen = x.len();
    31	
    32	    while xlen > 0 {
    33	        let want = if xlen < 1048576 { xlen } else { 1048576 };
    34	
    35	        let i = match guard.read(&mut x[off..off + want]) {
    36	            Ok(i) => i,
    37	            Err(_) => 0,
    38	        };
    39	        if i < 1 {
    40	            std::thread::sleep(std::time::Duration::from_secs(1));
    41	            continue;
    42	        }
    43	
    44	        off += i;
    45	        xlen -= i;
    46	    }
    47	}
    48	
    49	/// `void randombytes(unsigned char *x, unsigned long long xlen)`
    50	///
    51	/// Exported only with the `urandom` feature; see [`crate::rng::randombytes`]
    52	/// for the default (deterministic) implementation and the note in
    53	/// `Cargo.toml`.
    54	#[cfg(feature = "urandom")]
    55	#[unsafe(no_mangle)]
    56	pub unsafe extern "C" fn randombytes(x: *mut u8, xlen: core::ffi::c_ulonglong) {
    57	    unsafe { randombytes_urandom(core::slice::from_raw_parts_mut(x, xlen as usize)) }
    58	}
