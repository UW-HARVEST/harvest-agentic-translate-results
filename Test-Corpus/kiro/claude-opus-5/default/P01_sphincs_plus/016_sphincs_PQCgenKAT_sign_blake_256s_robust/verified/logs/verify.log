   187	static void fors_gen_sk(unsigned char *sk, const spx_ctx *ctx,
   188	                        uint32_t fors_leaf_addr[8])
   189	{
   190	    prf_addr(sk, ctx, fors_leaf_addr);
   191	}
   192	
   193	static void fors_sk_to_leaf(unsigned char *leaf, const unsigned char *sk,
   194	                            const spx_ctx *ctx,
   195	                            uint32_t fors_leaf_addr[8])
   196	{
   197	    thash(leaf, sk, 1, ctx, fors_leaf_addr);
   198	}
   199	
   200	void fors_gen_leafx1(unsigned char *leaf,
   201	                            const spx_ctx *ctx,
   202	                            uint32_t addr_idx, fors_gen_leaf_info *info)
   203	{
   204	    struct fors_gen_leaf_info *fors_info = info;
   205	    uint32_t *fors_leaf_addr = fors_info->leaf_addrx;
   206	
   207	    /* Only set the parts that the caller doesn't set */
   208	    set_tree_index(fors_leaf_addr, addr_idx);
   209	    set_type(fors_leaf_addr, SPX_ADDR_TYPE_FORSPRF);
   210	    fors_gen_sk(leaf, ctx, fors_leaf_addr);
   211	
   212	    set_type(fors_leaf_addr, SPX_ADDR_TYPE_FORSTREE);
   213	    fors_sk_to_leaf(leaf, leaf,
   214	                    ctx, fors_leaf_addr);
   215	}
   216	
   217	/**
   218	 * Interprets m as SPX_FORS_HEIGHT-bit unsigned integers.
   219	 * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.
   220	 * Assumes indices has space for SPX_FORS_TREES integers.
   221	 */
   222	static void message_to_indices(uint32_t *indices, const unsigned char *m)
   223	{
   224	    unsigned int i, j;
   225	    unsigned int offset = 0;
   226	
   227	    for (i = 0; i < SPX_FORS_TREES; i++) {
   228	        indices[i] = 0;
   229	        for (j = 0; j < SPX_FORS_HEIGHT; j++) {
   230	            indices[i] ^= ((m[offset >> 3] >> (offset & 0x7)) & 1u) << j;
   231	            offset++;
   232	        }
   233	    }
   234	}
   235	
   236	/**
   237	 * Signs a message m, deriving the secret key from sk_seed and the FTS address.
   238	 * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.
   239	 */
   240	void fors_sign(unsigned char *sig, unsigned char *pk,
   241	               const unsigned char *m,
   242	               const spx_ctx *ctx,
   243	               const uint32_t fors_addr[8])
   244	{
   245	    uint32_t indices[SPX_FORS_TREES];
   246	    unsigned char roots[SPX_FORS_TREES * SPX_N];
   247	    uint32_t fors_tree_addr[8] = {0};
   248	    struct fors_gen_leaf_info fors_info = {0};
   249	    uint32_t *fors_leaf_addr = fors_info.leaf_addrx;
   250	    uint32_t fors_pk_addr[8] = {0};
   251	    uint32_t idx_offset;
   252	    unsigned int i;
   253	
   254	    copy_keypair_addr(fors_tree_addr, fors_addr);
   255	    copy_keypair_addr(fors_leaf_addr, fors_addr);
   256	
   257	    copy_keypair_addr(fors_pk_addr, fors_addr);
   258	    set_type(fors_pk_addr, SPX_ADDR_TYPE_FORSPK);
   259	
   260	    message_to_indices(indices, m);
   261	
   262	    for (i = 0; i < SPX_FORS_TREES; i++) {
   263	        idx_offset = i * (1 << SPX_FORS_HEIGHT);
   264	
   265	        set_tree_height(fors_tree_addr, 0);
   266	        set_tree_index(fors_tree_addr, indices[i] + idx_offset);
   267	        set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSPRF);
   268	
   269	        /* Include the secret key part that produces the selected leaf node. */
   270	        fors_gen_sk(sig, ctx, fors_tree_addr);
   271	        set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);
   272	        sig += SPX_N;
   273	
   274	        /* Compute the authentication path for this leaf node. */
   275	        fors_treehashx1(roots + i*SPX_N, sig, ctx,
   276	                 indices[i], idx_offset, SPX_FORS_HEIGHT,
   277	                 fors_tree_addr, &fors_info);
   278	
   279	        sig += SPX_N * SPX_FORS_HEIGHT;
   280	    }
   281	
   282	    /* Hash horizontally across all tree roots to derive the public key. */
   283	    thash(pk, roots, SPX_FORS_TREES, ctx, fors_pk_addr);
   284	}
   285	
   286	/**
   287	 * Derives the FORS public key from a signature.
   288	 * This can be used for verification by comparing to a known public key, or to
   289	 * subsequently verify a signature on the derived public key. The latter is the
   290	 * typical use-case when used as an FTS below an OTS in a hypertree.
   291	 * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.
   292	 */
   293	void fors_pk_from_sig(unsigned char *pk,
   294	                      const unsigned char *sig, const unsigned char *m,
   295	                      const spx_ctx* ctx,
   296	                      const uint32_t fors_addr[8])
   297	{
   298	    uint32_t indices[SPX_FORS_TREES];
   299	    unsigned char roots[SPX_FORS_TREES * SPX_N];
   300	    unsigned char leaf[SPX_N];
   301	    uint32_t fors_tree_addr[8] = {0};
   302	    uint32_t fors_pk_addr[8] = {0};
   303	    uint32_t idx_offset;
   304	    unsigned int i;
   305	
   306	    copy_keypair_addr(fors_tree_addr, fors_addr);
   307	    copy_keypair_addr(fors_pk_addr, fors_addr);
   308	
   309	    set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);
   310	    set_type(fors_pk_addr, SPX_ADDR_TYPE_FORSPK);
   311	
   312	    message_to_indices(indices, m);
   313	
   314	    for (i = 0; i < SPX_FORS_TREES; i++) {
   315	        idx_offset = i * (1 << SPX_FORS_HEIGHT);
   316	
   317	        set_tree_height(fors_tree_addr, 0);
   318	        set_tree_index(fors_tree_addr, indices[i] + idx_offset);
   319	
   320	        /* Derive the leaf from the included secret key part. */
   321	        fors_sk_to_leaf(leaf, sig, ctx, fors_tree_addr);
   322	        sig += SPX_N;
   323	
   324	        /* Derive the corresponding root node of this tree. */
   325	        compute_root(roots + i*SPX_N, leaf, indices[i], idx_offset,
   326	                     sig, SPX_FORS_HEIGHT, ctx, fors_tree_addr);
   327	        sig += SPX_N * SPX_FORS_HEIGHT;
   328	    }
   329	
   330	    /* Hash horizontally across all tree roots to derive the public key. */
   331	    thash(pk, roots, SPX_FORS_TREES, ctx, fors_pk_addr);
   332	}
