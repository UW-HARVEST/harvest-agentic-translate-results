    44	 */
    45	static void base_w(unsigned int *output, const int out_len,
    46	                   const unsigned char *input)
    47	{
    48	    int in = 0;
    49	    int out = 0;
    50	    unsigned char total;
    51	    int bits = 0;
    52	    int consumed;
    53	
    54	    for (consumed = 0; consumed < out_len; consumed++) {
    55	        if (bits == 0) {
    56	            total = input[in];
    57	            in++;
    58	            bits += 8;
    59	        }
    60	        bits -= SPX_WOTS_LOGW;
    61	        output[out] = (total >> bits) & (SPX_WOTS_W - 1);
    62	        out++;
    63	    }
    64	}
