   218	        wots_pk_from_sig(wots_pk, sig, root, &ctx, wots_addr);
   219	        sig += SPX_WOTS_BYTES;
   220	
   221	        /* Compute the leaf node using the WOTS public key. */
   222	        thash(leaf, wots_pk, SPX_WOTS_LEN, &ctx, wots_pk_addr);
   223	
   224	        /* Compute the root node of this subtree. */
   225	        compute_root(root, leaf, idx_leaf, 0, sig, SPX_TREE_HEIGHT,
   226	                     &ctx, tree_addr);
   227	        sig += SPX_TREE_HEIGHT * SPX_N;
   228	
   229	        /* Update the indices for the next layer. */
   230	        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));
   231	        tree = tree >> SPX_TREE_HEIGHT;
   232	    }
   233	
   234	    /* Check if the root node equals the root node in the public key. */
   235	    if (memcmp(root, pub_root, SPX_N)) {
