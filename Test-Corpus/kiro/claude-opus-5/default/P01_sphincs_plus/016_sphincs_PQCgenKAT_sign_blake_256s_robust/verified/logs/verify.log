   168	    unsigned char mhash[SPX_FORS_MSG_BYTES];
   169	    unsigned char wots_pk[SPX_WOTS_BYTES];
   170	    unsigned char root[SPX_N];
   171	    unsigned char leaf[SPX_N];
   172	    unsigned int i;
   173	    uint64_t tree;
   174	    uint32_t idx_leaf;
   175	    uint32_t wots_addr[8] = {0};
   176	    uint32_t tree_addr[8] = {0};
   177	    uint32_t wots_pk_addr[8] = {0};
