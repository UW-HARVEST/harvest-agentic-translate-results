   331	void blake256_final( blakestate256 *S, u8 *digest ) {
   332	  
   333	  u8 msglen[8], zo=0x01, oo=0x81;
   334	  u32 lo=S->t[0] + S->buflen, hi=S->t[1];
   335	  if ( lo < S->buflen ) hi++;
   336	  U32TO8(  msglen + 0, hi );
   337	  U32TO8(  msglen + 4, lo );
   338	
   339	  if ( S->buflen == 440 ) { /* one padding byte */
   340	    S->t[0] -= 8;
   341	    blake256_update( S, &oo, 8 );
   342	  }
   343	  else {
   344	    if ( S->buflen < 440 ) { /* enough space to fill the block  */
   345	      if ( !S->buflen ) S->nullt=1;
   346	      S->t[0] -= 440 - S->buflen;
   347	      blake256_update( S, padding, 440 - S->buflen );
   348	    }
   349	    else { /* need 2 compressions */
   350	      S->t[0] -= 512 - S->buflen; 
   351	      blake256_update( S, padding, 512 - S->buflen );
   352	      S->t[0] -= 440;
   353	      blake256_update( S, padding+1, 440 );
   354	      S->nullt = 1;
   355	    }
   356	    blake256_update( S, &zo, 8 );
   357	    S->t[0] -= 8;
   358	  }
   359	  S->t[0] -= 64;
   360	  blake256_update( S, msglen, 64 );    
