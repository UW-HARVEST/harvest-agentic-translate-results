    70	static inline void br_enc32le(unsigned char *dst, uint32_t x)
    71	{
    72	    dst[0] = (unsigned char)x;
    73	    dst[1] = (unsigned char)(x >> 8);
    74	    dst[2] = (unsigned char)(x >> 16);
    75	    dst[3] = (unsigned char)(x >> 24);
    76	}
    77	
    78	
    79	static void br_range_enc32le(unsigned char *dst, const uint32_t *v, size_t num)
    80	{
    81	    while (num-- > 0) {
    82	        br_enc32le(dst, *v ++);
    83	        dst += 4;
    84	    }
    85	}
