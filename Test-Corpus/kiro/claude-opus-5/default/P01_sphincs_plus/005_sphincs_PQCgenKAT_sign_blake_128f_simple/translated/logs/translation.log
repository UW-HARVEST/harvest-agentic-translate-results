   360	
   361	  unsigned long long    mlen, smlen, mlen1;
   362	  int                   ret;
   363	
   364	  // Deterministic entropy to seed DRBG to make .req
   365	  for (int i = 0; i < 48; i++) {
   366	    entropy_input[i] = (unsigned char)i;
   367	  }
   368	  randombytes_init(entropy_input, NULL);
   369	
   370	  // Initialize Transcript
   371	  kat_tr_ctx tctx;
   372	  kat_tr_init(&tctx);
   373	  kat_tr_absorb_label(&tctx, "CRYPTO_ALGNAME");
   374	  kat_tr_absorb_bytes(&tctx, (const uint8_t *)CRYPTO_ALGNAME, strlen(CRYPTO_ALGNAME));
   375	  kat_tr_absorb_label(&tctx, "SKBYTES"); kat_tr_absorb_u64(&tctx, CRYPTO_SECRETKEYBYTES);
   376	  kat_tr_absorb_label(&tctx, "PKBYTES"); kat_tr_absorb_u64(&tctx, CRYPTO_PUBLICKEYBYTES);
   377	  kat_tr_absorb_label(&tctx, "SIGBYTES"); kat_tr_absorb_u64(&tctx, CRYPTO_BYTES);
   378	
   379	  for (int i = 0; i < LOOP_COUNT; i++) {
   380	    randombytes(seed, sizeof seed);
   381	
   382	    kat_tr_absorb_label(&tctx, "count"); kat_tr_absorb_u64(&tctx, (unsigned long long) i);
   383	    kat_tr_absorb_label(&tctx, "seed"); kat_tr_absorb_bytes(&tctx, seed, sizeof seed);
   384	
   385	    mlen = (unsigned long long int)(BASE_MLEN * (i + 1));
   386	    if (mlen > BASE_MLEN * LOOP_COUNT) { fprintf(stderr, "mlen overflow\n"); return KAT_OVERFLOW; }
   387	
   388	    kat_tr_absorb_label(&tctx, "mlen"); kat_tr_absorb_u64(&tctx, mlen);
   389	
   390	    randombytes(msg, mlen);
   391	    kat_tr_absorb_label(&tctx, "msg"); kat_tr_absorb_bytes(&tctx, msg, mlen);
   392	
   393	    memset(m, 0, mlen);
   394	    memset(m1, 0, mlen + CRYPTO_BYTES);
   395	    memset(sm, 0, mlen + CRYPTO_BYTES);
   396	    memcpy(m, msg, mlen);
   397	
   398	    // Keypair
   399	    ret = crypto_sign_keypair(pk, sk);
   400	    if (ret) { fprintf(stderr, "crypto_sign_keypair=%d\n", ret); return KAT_CRYPTO_FAILURE; }
   401	    kat_tr_absorb_label(&tctx, "pk"); kat_tr_absorb_bytes(&tctx, pk, CRYPTO_PUBLICKEYBYTES);
   402	    kat_tr_absorb_label(&tctx, "sk"); kat_tr_absorb_bytes(&tctx, sk, CRYPTO_SECRETKEYBYTES);
   403	
   404	    // Sign
   405	    ret = crypto_sign(sm, &smlen, m, mlen, sk);
   406	    if (ret) { fprintf(stderr, "crypto_sign=%d\n", ret); return KAT_CRYPTO_FAILURE; }
   407	    kat_tr_absorb_label(&tctx, "smlen"); kat_tr_absorb_u64(&tctx, smlen);
   408	    kat_tr_absorb_label(&tctx, "sm"); kat_tr_absorb_bytes(&tctx, sm, smlen);
   409	
   410	    // Verify
   411	    ret = crypto_sign_open(m1, &mlen1, sm, smlen, pk);
   412	    if (ret) { fprintf(stderr, "crypto_sign_open=%d\n", ret); return KAT_CRYPTO_FAILURE; }
   413	    if (mlen1 != mlen) { fprintf(stderr, "mlen mismatch\n"); return KAT_CRYPTO_FAILURE; }
   414	    if (memcmp(m, m1, mlen) != 0) { fprintf(stderr, "m mismatch\n"); return KAT_CRYPTO_FAILURE; }
   415	  }
   416	
   417	  // Finalize transcript digest
   418	  uint8_t digest[32] = {0};
   419	  kat_tr_final(&tctx, digest);
   420	
   421	  printf("KAT transcript digest = ");
   422	  for (size_t i = 0; i < 32; i++) { printf("%02X", digest[i]); }
   423	  printf("\n");
   424	
   425	  return KAT_SUCCESS;
   426	}
