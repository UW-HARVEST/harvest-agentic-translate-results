   363	  U32TO8( digest + 4, S->h[1]);
   364	  U32TO8( digest + 8, S->h[2]);
   365	  U32TO8( digest +12, S->h[3]);
   366	  U32TO8( digest +16, S->h[4]);
   367	  U32TO8( digest +20, S->h[5]);
   368	  U32TO8( digest +24, S->h[6]);
   369	  U32TO8( digest +28, S->h[7]);
   370	}
