    84	#if SPX_TREE_BITS > 64
    85	    #error For given height and depth, 64 bits cannot represent all subtrees
    86	#endif
    87	
    88	    if (SPX_D == 1) {
    89	        *tree = 0;
    90	    } else {
    91	        *tree = bytes_to_ull(bufp, SPX_TREE_BYTES);
    92	        *tree &= (~(uint64_t)0) >> (64 - SPX_TREE_BITS);
    93	    }
    94	    bufp += SPX_TREE_BYTES;
    95	
    96	    *leaf_idx = (uint32_t)bytes_to_ull(bufp, SPX_LEAF_BYTES);
    97	    *leaf_idx &= (~(uint32_t)0) >> (32 - SPX_LEAF_BITS);
