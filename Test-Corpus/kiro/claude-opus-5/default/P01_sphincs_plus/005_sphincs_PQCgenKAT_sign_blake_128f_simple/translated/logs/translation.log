   385	    z12 = t43 & y13;
   386	    z13 = t40 & y5;
   387	    z14 = t29 & y2;
   388	    z15 = t42 & y9;
   389	    z16 = t45 & y14;
   390	    z17 = t41 & y8;
   391	
   392	    /*
   393	     * Bottom linear transformation.
   394	     */
   395	    t46 = z15 ^ z16;
   396	    t47 = z10 ^ z11;
   397	    t48 = z5 ^ z13;
   398	    t49 = z9 ^ z10;
   399	    t50 = z2 ^ z12;
   400	    t51 = z2 ^ z5;
   401	    t52 = z7 ^ z8;
   402	    t53 = z0 ^ z3;
   403	    t54 = z6 ^ z7;
   404	    t55 = z16 ^ z17;
   405	    t56 = z12 ^ t48;
   406	    t57 = t50 ^ t53;
   407	    t58 = z4 ^ t46;
   408	    t59 = z3 ^ t54;
   409	    t60 = t46 ^ t57;
   410	    t61 = z14 ^ t57;
   411	    t62 = t52 ^ t58;
   412	    t63 = t49 ^ t58;
   413	    t64 = z4 ^ t59;
   414	    t65 = t61 ^ t62;
   415	    t66 = z1 ^ t63;
   416	    s0 = t59 ^ t63;
   417	    s6 = t56 ^ ~t62;
   418	    s7 = t48 ^ ~t60;
   419	    t67 = t64 ^ t65;
   420	    s3 = t53 ^ t66;
   421	    s4 = t51 ^ t66;
   422	    s5 = t47 ^ t65;
   423	    s1 = t64 ^ ~s3;
   424	    s2 = t55 ^ ~t67;
   425	
   426	    q[7] = s0;
   427	    q[6] = s1;
   428	    q[5] = s2;
   429	    q[4] = s3;
   430	    q[3] = s4;
   431	    q[2] = s5;
   432	    q[1] = s6;
   433	    q[0] = s7;
   434	}
   435	
   436	static void br_aes_ct_ortho(uint32_t *q)
   437	{
   438	#define SWAPN_32(cl, ch, s, x, y)   do { \
   439	        uint32_t a, b; \
   440	        a = (x); \
   441	        b = (y); \
   442	        (x) = (a & (uint32_t)cl) | ((b & (uint32_t)cl) << (s)); \
   443	        (y) = ((a & (uint32_t)ch) >> (s)) | (b & (uint32_t)ch); \
   444	    } while (0)
   445	
   446	#define SWAP2_32(x, y)   SWAPN_32(0x55555555, 0xAAAAAAAA, 1, x, y)
   447	#define SWAP4_32(x, y)   SWAPN_32(0x33333333, 0xCCCCCCCC, 2, x, y)
   448	#define SWAP8_32(x, y)   SWAPN_32(0x0F0F0F0F, 0xF0F0F0F0, 4, x, y)
   449	
   450	    SWAP2_32(q[0], q[1]);
   451	    SWAP2_32(q[2], q[3]);
   452	    SWAP2_32(q[4], q[5]);
   453	    SWAP2_32(q[6], q[7]);
   454	
   455	    SWAP4_32(q[0], q[2]);
   456	    SWAP4_32(q[1], q[3]);
   457	    SWAP4_32(q[4], q[6]);
   458	    SWAP4_32(q[5], q[7]);
   459	
   460	    SWAP8_32(q[0], q[4]);
   461	    SWAP8_32(q[1], q[5]);
   462	    SWAP8_32(q[2], q[6]);
   463	    SWAP8_32(q[3], q[7]);
   464	}
   465	
   466	static inline void add_round_key32(uint32_t *q, const uint32_t *sk)
   467	{
   468	    q[0] ^= sk[0];
   469	    q[1] ^= sk[1];
   470	    q[2] ^= sk[2];
   471	    q[3] ^= sk[3];
   472	    q[4] ^= sk[4];
   473	    q[5] ^= sk[5];
   474	    q[6] ^= sk[6];
   475	    q[7] ^= sk[7];
   476	}
   477	
   478	static inline void shift_rows32(uint32_t *q)
   479	{
   480	    int i;
   481	
   482	    for (i = 0; i < 8; i++) {
   483	        uint32_t x;
   484	
   485	        x = q[i];
   486	        q[i] = (x & 0x000000FF)
   487	            | ((x & 0x0000FC00) >> 2) | ((x & 0x00000300) << 6)
   488	            | ((x & 0x00F00000) >> 4) | ((x & 0x000F0000) << 4)
   489	            | ((x & 0xC0000000) >> 6) | ((x & 0x3F000000) << 2);
   490	    }
   491	}
   492	
   493	static inline uint32_t rotr16(uint32_t x)
   494	{
   495	    return (x << 16) | (x >> 16);
   496	}
   497	
   498	static inline void mix_columns32(uint32_t *q)
   499	{
   500	    uint32_t q0, q1, q2, q3, q4, q5, q6, q7;
   501	    uint32_t r0, r1, r2, r3, r4, r5, r6, r7;
   502	
   503	    q0 = q[0];
   504	    q1 = q[1];
   505	    q2 = q[2];
   506	    q3 = q[3];
   507	    q4 = q[4];
   508	    q5 = q[5];
   509	    q6 = q[6];
   510	    q7 = q[7];
   511	    r0 = (q0 >> 8) | (q0 << 24);
   512	    r1 = (q1 >> 8) | (q1 << 24);
   513	    r2 = (q2 >> 8) | (q2 << 24);
   514	    r3 = (q3 >> 8) | (q3 << 24);
   515	    r4 = (q4 >> 8) | (q4 << 24);
   516	    r5 = (q5 >> 8) | (q5 << 24);
   517	    r6 = (q6 >> 8) | (q6 << 24);
   518	    r7 = (q7 >> 8) | (q7 << 24);
   519	
   520	    q[0] = q7 ^ r7 ^ r0 ^ rotr16(q0 ^ r0);
   521	    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr16(q1 ^ r1);
   522	    q[2] = q1 ^ r1 ^ r2 ^ rotr16(q2 ^ r2);
   523	    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr16(q3 ^ r3);
   524	    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr16(q4 ^ r4);
   525	    q[5] = q4 ^ r4 ^ r5 ^ rotr16(q5 ^ r5);
   526	    q[6] = q5 ^ r5 ^ r6 ^ rotr16(q6 ^ r6);
   527	    q[7] = q6 ^ r6 ^ r7 ^ rotr16(q7 ^ r7);
   528	}
   529	
   530	static void br_aes_ct64_ortho(uint64_t *q)
   531	{
   532	#define SWAPN(cl, ch, s, x, y)   do { \
   533	        uint64_t a, b; \
   534	        a = (x); \
   535	        b = (y); \
   536	        (x) = (a & (uint64_t)(cl)) | ((b & (uint64_t)(cl)) << (s)); \
   537	        (y) = ((a & (uint64_t)(ch)) >> (s)) | (b & (uint64_t)(ch)); \
   538	    } while (0)
   539	
   540	#define SWAP2(x, y)    SWAPN(0x5555555555555555, 0xAAAAAAAAAAAAAAAA,  1, x, y)
   541	#define SWAP4(x, y)    SWAPN(0x3333333333333333, 0xCCCCCCCCCCCCCCCC,  2, x, y)
   542	#define SWAP8(x, y)    SWAPN(0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0,  4, x, y)
   543	
   544	    SWAP2(q[0], q[1]);
   545	    SWAP2(q[2], q[3]);
   546	    SWAP2(q[4], q[5]);
   547	    SWAP2(q[6], q[7]);
   548	
   549	    SWAP4(q[0], q[2]);
   550	    SWAP4(q[1], q[3]);
   551	    SWAP4(q[4], q[6]);
   552	    SWAP4(q[5], q[7]);
   553	
   554	    SWAP8(q[0], q[4]);
   555	    SWAP8(q[1], q[5]);
   556	    SWAP8(q[2], q[6]);
   557	    SWAP8(q[3], q[7]);
   558	}
   559	
   560	
   561	static void br_aes_ct64_interleave_in(uint64_t *q0, uint64_t *q1, const uint32_t *w)
   562	{
   563	    uint64_t x0, x1, x2, x3;
   564	
   565	    x0 = w[0];
   566	    x1 = w[1];
   567	    x2 = w[2];
   568	    x3 = w[3];
   569	    x0 |= (x0 << 16);
   570	    x1 |= (x1 << 16);
   571	    x2 |= (x2 << 16);
   572	    x3 |= (x3 << 16);
   573	    x0 &= (uint64_t)0x0000FFFF0000FFFF;
   574	    x1 &= (uint64_t)0x0000FFFF0000FFFF;
   575	    x2 &= (uint64_t)0x0000FFFF0000FFFF;
   576	    x3 &= (uint64_t)0x0000FFFF0000FFFF;
   577	    x0 |= (x0 << 8);
   578	    x1 |= (x1 << 8);
   579	    x2 |= (x2 << 8);
   580	    x3 |= (x3 << 8);
   581	    x0 &= (uint64_t)0x00FF00FF00FF00FF;
   582	    x1 &= (uint64_t)0x00FF00FF00FF00FF;
   583	    x2 &= (uint64_t)0x00FF00FF00FF00FF;
   584	    x3 &= (uint64_t)0x00FF00FF00FF00FF;
   585	    *q0 = x0 | (x2 << 8);
   586	    *q1 = x1 | (x3 << 8);
   587	}
   588	
   589	
   590	static void br_aes_ct64_interleave_out(uint32_t *w, uint64_t q0, uint64_t q1)
   591	{
   592	    uint64_t x0, x1, x2, x3;
   593	
   594	    x0 = q0 & (uint64_t)0x00FF00FF00FF00FF;
   595	    x1 = q1 & (uint64_t)0x00FF00FF00FF00FF;
   596	    x2 = (q0 >> 8) & (uint64_t)0x00FF00FF00FF00FF;
   597	    x3 = (q1 >> 8) & (uint64_t)0x00FF00FF00FF00FF;
   598	    x0 |= (x0 >> 8);
   599	    x1 |= (x1 >> 8);
   600	    x2 |= (x2 >> 8);
   601	    x3 |= (x3 >> 8);
   602	    x0 &= (uint64_t)0x0000FFFF0000FFFF;
   603	    x1 &= (uint64_t)0x0000FFFF0000FFFF;
   604	    x2 &= (uint64_t)0x0000FFFF0000FFFF;
   605	    x3 &= (uint64_t)0x0000FFFF0000FFFF;
   606	    w[0] = (uint32_t)x0 | (uint32_t)(x0 >> 16);
   607	    w[1] = (uint32_t)x1 | (uint32_t)(x1 >> 16);
   608	    w[2] = (uint32_t)x2 | (uint32_t)(x2 >> 16);
   609	    w[3] = (uint32_t)x3 | (uint32_t)(x3 >> 16);
   610	}
   611	
   612	static inline void add_round_key(uint64_t *q, const uint64_t *sk)
   613	{
   614	    q[0] ^= sk[0];
   615	    q[1] ^= sk[1];
   616	    q[2] ^= sk[2];
   617	    q[3] ^= sk[3];
   618	    q[4] ^= sk[4];
   619	    q[5] ^= sk[5];
   620	    q[6] ^= sk[6];
   621	    q[7] ^= sk[7];
   622	}
   623	
   624	static inline void shift_rows(uint64_t *q)
   625	{
   626	    int i;
   627	
   628	    for (i = 0; i < 8; i++) {
   629	        uint64_t x;
   630	
   631	        x = q[i];
   632	        q[i] = (x & (uint64_t)0x000000000000FFFF)
   633	               | ((x & (uint64_t)0x00000000FFF00000) >> 4)
   634	               | ((x & (uint64_t)0x00000000000F0000) << 12)
   635	               | ((x & (uint64_t)0x0000FF0000000000) >> 8)
   636	               | ((x & (uint64_t)0x000000FF00000000) << 8)
   637	               | ((x & (uint64_t)0xF000000000000000) >> 12)
   638	               | ((x & (uint64_t)0x0FFF000000000000) << 4);
   639	    }
   640	}
   641	
   642	static inline uint64_t rotr32(uint64_t x)
   643	{
   644	    return (x << 32) | (x >> 32);
   645	}
   646	
   647	static inline void mix_columns(uint64_t *q)
   648	{
   649	    uint64_t q0, q1, q2, q3, q4, q5, q6, q7;
   650	    uint64_t r0, r1, r2, r3, r4, r5, r6, r7;
   651	
   652	    q0 = q[0];
   653	    q1 = q[1];
   654	    q2 = q[2];
   655	    q3 = q[3];
   656	    q4 = q[4];
   657	    q5 = q[5];
   658	    q6 = q[6];
   659	    q7 = q[7];
   660	    r0 = (q0 >> 16) | (q0 << 48);
   661	    r1 = (q1 >> 16) | (q1 << 48);
   662	    r2 = (q2 >> 16) | (q2 << 48);
   663	    r3 = (q3 >> 16) | (q3 << 48);
   664	    r4 = (q4 >> 16) | (q4 << 48);
   665	    r5 = (q5 >> 16) | (q5 << 48);
   666	    r6 = (q6 >> 16) | (q6 << 48);
   667	    r7 = (q7 >> 16) | (q7 << 48);
   668	
   669	    q[0] = q7 ^ r7 ^ r0 ^ rotr32(q0 ^ r0);
   670	    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr32(q1 ^ r1);
   671	    q[2] = q1 ^ r1 ^ r2 ^ rotr32(q2 ^ r2);
   672	    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr32(q3 ^ r3);
   673	    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr32(q4 ^ r4);
   674	    q[5] = q4 ^ r4 ^ r5 ^ rotr32(q5 ^ r5);
   675	    q[6] = q5 ^ r5 ^ r6 ^ rotr32(q6 ^ r6);
   676	    q[7] = q6 ^ r6 ^ r7 ^ rotr32(q7 ^ r7);
   677	}
   678	
   679	static void interleave_constant(uint64_t *out, const unsigned char *in)
   680	{
   681	    uint32_t tmp_32_constant[16];
   682	    int i;
   683	
   684	    br_range_dec32le(tmp_32_constant, 16, in);
   685	    for (i = 0; i < 4; i++) {
   686	        br_aes_ct64_interleave_in(&out[i], &out[i + 4], tmp_32_constant + (i << 2));
   687	    }
   688	    br_aes_ct64_ortho(out);
   689	}
   690	
   691	static void interleave_constant32(uint32_t *out, const unsigned char *in)
   692	{
   693	    int i;
   694	    for (i = 0; i < 4; i++) {
   695	        out[2*i] = br_dec32le(in + 4*i);
   696	        out[2*i + 1] = br_dec32le(in + 4*i + 16);
   697	    }
   698	    br_aes_ct_ortho(out);
   699	}
   700	
   701	void tweak_constants(spx_ctx *ctx)
   702	{
   703	    unsigned char buf[40*16];
   704	    int i;
   705	
   706	    /* Use the standard constants to generate tweaked ones. */
   707	    memcpy((uint8_t *)ctx->tweaked512_rc64, (uint8_t *)haraka512_rc64, 40*16);
   708	
   709	    /* Constants for pk.seed */
   710	    haraka_S(buf, 40*16, ctx->pub_seed, SPX_N, ctx);
   711	    for (i = 0; i < 10; i++) {
   712	        interleave_constant32(ctx->tweaked256_rc32[i], buf + 32*i);
   713	        interleave_constant(ctx->tweaked512_rc64[i], buf + 64*i);
   714	    }
   715	}
   716	
   717	static void haraka_S_absorb(unsigned char *s, unsigned int r,
   718	                            const unsigned char *m, unsigned long long mlen,
   719	                            unsigned char p, const spx_ctx *ctx)
   720	{
   721	    unsigned long long i;
   722	    SPX_VLA(uint8_t, t, r);
   723	
   724	    while (mlen >= r) {
   725	        /* XOR block to state */
   726	        for (i = 0; i < r; ++i) {
   727	            s[i] ^= m[i];
   728	        }
   729	        haraka512_perm(s, s, ctx);
   730	        mlen -= r;
   731	        m += r;
   732	    }
   733	
   734	    for (i = 0; i < r; ++i) {
   735	        t[i] = 0;
   736	    }
   737	    for (i = 0; i < mlen; ++i) {
   738	        t[i] = m[i];
   739	    }
   740	    t[i] = p;
   741	    t[r - 1] |= 128;
   742	    for (i = 0; i < r; ++i) {
   743	        s[i] ^= t[i];
   744	    }
   745	}
   746	
   747	static void haraka_S_squeezeblocks(unsigned char *h, unsigned long long nblocks,
   748	                                   unsigned char *s, unsigned int r,
   749	                                   const spx_ctx *ctx)
   750	{
   751	    while (nblocks > 0) {
   752	        haraka512_perm(s, s, ctx);
   753	        memcpy(h, s, HARAKAS_RATE);
   754	        h += r;
   755	        nblocks--;
   756	    }
   757	}
   758	
   759	void haraka_S_inc_init(uint8_t *s_inc)
   760	{
   761	    size_t i;
   762	
   763	    for (i = 0; i < 64; i++) {
   764	        s_inc[i] = 0;
   765	    }
   766	    s_inc[64] = 0;
   767	}
   768	
   769	void haraka_S_inc_absorb(uint8_t *s_inc, const uint8_t *m, size_t mlen,
   770	        const spx_ctx *ctx)
   771	{
   772	    size_t i;
   773	
   774	    /* Recall that s_inc[64] is the non-absorbed bytes xored into the state */
   775	    while (mlen + s_inc[64] >= HARAKAS_RATE) {
   776	        for (i = 0; i < (size_t)(HARAKAS_RATE - s_inc[64]); i++) {
   777	            /* Take the i'th byte from message
   778	               xor with the s_inc[64] + i'th byte of the state */
   779	            s_inc[s_inc[64] + i] ^= m[i];
   780	        }
   781	        mlen -= (size_t)(HARAKAS_RATE - s_inc[64]);
   782	        m += HARAKAS_RATE - (uint8_t)s_inc[64];
   783	        s_inc[64] = 0;
   784	
   785	        haraka512_perm(s_inc, s_inc, ctx);
   786	    }
   787	
   788	    for (i = 0; i < mlen; i++) {
   789	        s_inc[s_inc[64] + i] ^= m[i];
   790	    }
   791	    s_inc[64] += (uint8_t)mlen;
   792	}
   793	
   794	void haraka_S_inc_finalize(uint8_t *s_inc)
   795	{
   796	    /* After haraka_S_inc_absorb, we are guaranteed that s_inc[64] < HARAKAS_RATE,
   797	       so we can always use one more byte for p in the current state. */
   798	    s_inc[s_inc[64]] ^= 0x1F;
   799	    s_inc[HARAKAS_RATE - 1] ^= 128;
   800	    s_inc[64] = 0;
   801	}
   802	
   803	void haraka_S_inc_squeeze(uint8_t *out, size_t outlen, uint8_t *s_inc,
   804	        const spx_ctx *ctx)
   805	{
   806	    size_t i;
   807	
   808	    /* First consume any bytes we still have sitting around */
   809	    for (i = 0; i < outlen && i < s_inc[64]; i++) {
   810	        /* There are s_inc[64] bytes left, so r - s_inc[64] is the first
   811	           available byte. We consume from there, i.e., up to r. */
   812	        out[i] = (uint8_t)s_inc[(HARAKAS_RATE - s_inc[64] + i)];
   813	    }
   814	    out += i;
   815	    outlen -= i;
   816	    s_inc[64] -= (uint8_t)i;
   817	
   818	    /* Then squeeze the remaining necessary blocks */
   819	    while (outlen > 0) {
   820	        haraka512_perm(s_inc, s_inc, ctx);
   821	
   822	        for (i = 0; i < outlen && i < HARAKAS_RATE; i++) {
   823	            out[i] = s_inc[i];
   824	        }
   825	        out += i;
   826	        outlen -= i;
   827	        s_inc[64] = (uint8_t)(HARAKAS_RATE - i);
   828	    }
   829	}
   830	
   831	void haraka_S(unsigned char *out, unsigned long long outlen,
   832	              const unsigned char *in, unsigned long long inlen,
   833	              const spx_ctx *ctx)
   834	{
   835	    unsigned long long i;
   836	    unsigned char s[64];
   837	    unsigned char d[32];
   838	
   839	    for (i = 0; i < 64; i++) {
   840	        s[i] = 0;
   841	    }
   842	    haraka_S_absorb(s, 32, in, inlen, 0x1F, ctx);
   843	
   844	    haraka_S_squeezeblocks(out, outlen / 32, s, 32, ctx);
   845	    out += (outlen / 32) * 32;
   846	
   847	    if (outlen % 32) {
   848	        haraka_S_squeezeblocks(d, 1, s, 32, ctx);
   849	        for (i = 0; i < outlen % 32; i++) {
   850	            out[i] = d[i];
   851	        }
   852	    }
   853	}
   854	
   855	void haraka512_perm(unsigned char *out, const unsigned char *in,
   856	        const spx_ctx *ctx)
   857	{
   858	    uint32_t w[16];
   859	    uint64_t q[8], tmp_q;
   860	    unsigned int i, j;
   861	
   862	    br_range_dec32le(w, 16, in);
   863	    for (i = 0; i < 4; i++) {
   864	        br_aes_ct64_interleave_in(&q[i], &q[i + 4], w + (i << 2));
   865	    }
   866	    br_aes_ct64_ortho(q);
   867	
   868	    /* AES rounds */
   869	    for (i = 0; i < 5; i++) {
   870	        for (j = 0; j < 2; j++) {
   871	            br_aes_ct64_bitslice_Sbox(q);
   872	            shift_rows(q);
   873	            mix_columns(q);
   874	            add_round_key(q, ctx->tweaked512_rc64[2*i + j]);
   875	        }
   876	        /* Mix states */
   877	        for (j = 0; j < 8; j++) {
   878	            tmp_q = q[j];
   879	            q[j] = (tmp_q & 0x0001000100010001) << 5 |
   880	                   (tmp_q & 0x0002000200020002) << 12 |
   881	                   (tmp_q & 0x0004000400040004) >> 1 |
   882	                   (tmp_q & 0x0008000800080008) << 6 |
   883	                   (tmp_q & 0x0020002000200020) << 9 |
   884	                   (tmp_q & 0x0040004000400040) >> 4 |
   885	                   (tmp_q & 0x0080008000800080) << 3 |
   886	                   (tmp_q & 0x2100210021002100) >> 5 |
   887	                   (tmp_q & 0x0210021002100210) << 2 |
   888	                   (tmp_q & 0x0800080008000800) << 4 |
   889	                   (tmp_q & 0x1000100010001000) >> 12 |
   890	                   (tmp_q & 0x4000400040004000) >> 10 |
   891	                   (tmp_q & 0x8400840084008400) >> 3;
   892	        }
   893	    }
   894	
   895	    br_aes_ct64_ortho(q);
   896	    for (i = 0; i < 4; i ++) {
   897	        br_aes_ct64_interleave_out(w + (i << 2), q[i], q[i + 4]);
   898	    }
   899	    br_range_enc32le(out, w, 16);
   900	}
   901	
   902	void haraka512(unsigned char *out, const unsigned char *in, const spx_ctx *ctx)
   903	{
   904	    int i;
   905	
   906	    unsigned char buf[64];
   907	
   908	    haraka512_perm(buf, in, ctx);
   909	    /* Feed-forward */
   910	    for (i = 0; i < 64; i++) {
   911	        buf[i] = buf[i] ^ in[i];
   912	    }
   913	
   914	    /* Truncated */
   915	    memcpy(out,      buf + 8, 8);
   916	    memcpy(out + 8,  buf + 24, 8);
   917	    memcpy(out + 16, buf + 32, 8);
   918	    memcpy(out + 24, buf + 48, 8);
   919	}
   920	
   921	
   922	void haraka256(unsigned char *out, const unsigned char *in,
   923	        const spx_ctx *ctx)
   924	{
   925	    uint32_t q[8], tmp_q;
   926	    int i, j;
   927	
   928	    for (i = 0; i < 4; i++) {
   929	        q[2*i] = br_dec32le(in + 4*i);
   930	        q[2*i + 1] = br_dec32le(in + 4*i + 16);
   931	    }
   932	    br_aes_ct_ortho(q);
   933	
   934	    /* AES rounds */
   935	    for (i = 0; i < 5; i++) {
   936	        for (j = 0; j < 2; j++) {
   937	            br_aes_ct_bitslice_Sbox(q);
   938	            shift_rows32(q);
   939	            mix_columns32(q);
   940	            add_round_key32(q, ctx->tweaked256_rc32[2*i + j]);
   941	        }
   942	
   943	        /* Mix states */
   944	        for (j = 0; j < 8; j++) {
   945	            tmp_q = q[j];
   946	            q[j] = (tmp_q & 0x81818181) |
   947	                   (tmp_q & 0x02020202) << 1 |
   948	                   (tmp_q & 0x04040404) << 2 |
   949	                   (tmp_q & 0x08080808) << 3 |
   950	                   (tmp_q & 0x10101010) >> 3 |
   951	                   (tmp_q & 0x20202020) >> 2 |
   952	                   (tmp_q & 0x40404040) >> 1;
   953	        }
   954	    }
   955	
   956	    br_aes_ct_ortho(q);
   957	    for (i = 0; i < 4; i++) {
   958	        br_enc32le(out + 4*i, q[2*i]);
   959	        br_enc32le(out + 4*i + 16, q[2*i + 1]);
   960	    }
   961	
   962	    for (i = 0; i < 32; i++) {
   963	        out[i] ^= in[i];
   964	    }
   965	}
