     4	
     5	#include <fcntl.h>
     6	#include <unistd.h>
     7	
     8	#include "../include/randombytes.h"
     9	
    10	static int fd = -1;
    11	
    12	void randombytes(unsigned char *x, unsigned long long xlen)
    13	{
    14	    unsigned long long i;
    15	
    16	    if (fd == -1) {
    17	        for (;;) {
    18	            fd = open("/dev/urandom", O_RDONLY);
    19	            if (fd != -1) {
    20	                break;
    21	            }
    22	            sleep(1);
    23	        }
    24	    }
    25	
    26	    while (xlen > 0) {
    27	        if (xlen < 1048576) {
    28	            i = xlen;
    29	        }
    30	        else {
    31	            i = 1048576;
    32	        }
    33	
    34	        i = (unsigned long long)read(fd, x, i);
    35	        if (i < 1) {
    36	            sleep(1);
    37	            continue;
    38	        }
    39	
    40	        x += i;
    41	        xlen -= i;
    42	    }
    43	}
