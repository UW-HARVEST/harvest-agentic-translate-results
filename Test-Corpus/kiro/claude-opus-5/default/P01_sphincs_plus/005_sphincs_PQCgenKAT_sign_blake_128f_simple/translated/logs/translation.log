void fors_treehashx1(unsigned char *root, unsigned char *auth_path,
		     const spx_ctx* ctx,
		     uint32_t leaf_idx, uint32_t idx_offset, uint32_t tree_height,
		     uint32_t tree_addrx4[8], leaf_info_x1 *info);
#endif
