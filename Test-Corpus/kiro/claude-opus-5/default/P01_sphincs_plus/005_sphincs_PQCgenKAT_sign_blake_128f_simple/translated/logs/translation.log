   432	 *                26th value represents either the number of absorbed bytes
   433	 *                that have not been permuted, or not-yet-squeezed bytes.
   434	 *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)
   435	 *              - const uint8_t *m: pointer to input to be absorbed into s
   436	 *              - size_t mlen: length of input in bytes
   437	 **************************************************/
   438	static void keccak_inc_absorb(uint64_t *s_inc, uint32_t r, const uint8_t *m,
   439	                              size_t mlen) {
   440	    size_t i;
   441	
   442	    /* Recall that s_inc[25] is the non-absorbed bytes xored into the state */
   443	    while (mlen + s_inc[25] >= r) {
   444	        for (i = 0; i < r - s_inc[25]; i++) {
