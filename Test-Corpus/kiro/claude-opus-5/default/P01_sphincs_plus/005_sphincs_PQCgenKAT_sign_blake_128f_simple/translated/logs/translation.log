   350	  else {
   351	    if ( S->buflen < 888 ) { /* enough space to fill the block */
   352	      if ( S->buflen == 0 ) S->nullt=1;
   353	      S->t[0] -= 888 - S->buflen;
   354	      blake512_update( S, padding, 888 - S->buflen );
   355	    }
   356	    else { /* NOT enough space, need 2 compressions */ 
   357	      S->t[0] -= 1024 - S->buflen; 
   358	      blake512_update( S, padding, 1024 - S->buflen );
   359	      S->t[0] -= 888;
   360	      blake512_update( S, padding+1, 888 );
   361	      S->nullt = 1;
   362	    }
   363	    blake512_update( S, &zo, 8 );
