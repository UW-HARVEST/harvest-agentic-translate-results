    54	static inline uint32_t br_dec32le(const unsigned char *src)
    55	{
    56	    return (uint32_t)src[0]
    57	           | ((uint32_t)src[1] << 8)
    58	           | ((uint32_t)src[2] << 16)
    59	           | ((uint32_t)src[3] << 24);
    60	}
    61	
    62	static void br_range_dec32le(uint32_t *v, size_t num, const unsigned char *src)
    63	{
    64	    while (num-- > 0) {
    65	        *v ++ = br_dec32le(src);
    66	        src += 4;
    67	    }
    68	}
