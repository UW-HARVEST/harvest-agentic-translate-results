    29	
    30	/* For SHA, there is no immediate reason to initialize at the start,
    31	   so this function is an empty operation. */
    32	void initialize_hash_function(spx_ctx *ctx)
    33	{
    34	    seed_state(ctx);
    35	}
    36	
    37	/*
    38	 * Computes PRF(pk_seed, sk_seed, addr).
    39	 */
    40	void prf_addr(unsigned char *out, const spx_ctx *ctx,
    41	              const uint32_t addr[8])
    42	{
    43	    uint8_t sha2_state[40];
    44	    unsigned char buf[SPX_SHA256_ADDR_BYTES + SPX_N];
    45	    unsigned char outbuf[SPX_SHA256_OUTPUT_BYTES];
    46	
    47	    /* Retrieve precomputed state containing pub_seed */
    48	    memcpy(sha2_state, ctx->state_seeded, 40 * sizeof(uint8_t));
    49	
    50	    /* Remainder: ADDR^c ‖ SK.seed */
    51	    memcpy(buf, addr, SPX_SHA256_ADDR_BYTES);
    52	    memcpy(buf + SPX_SHA256_ADDR_BYTES, ctx->sk_seed, SPX_N);
    53	
    54	    sha256_inc_finalize(outbuf, sha2_state, buf, SPX_SHA256_ADDR_BYTES + SPX_N);
    55	
    56	    memcpy(out, outbuf, SPX_N);
    57	}
    58	
    59	/**
    60	 * Computes the message-dependent randomness R, using a secret seed as a key
    61	 * for HMAC, and an optional randomization value prefixed to the message.
    62	 * This requires m to have at least SPX_SHAX_BLOCK_BYTES + SPX_N space
    63	 * available in front of the pointer, i.e. before the message to use for the
    64	 * prefix. This is necessary to prevent having to move the message around (and
    65	 * allocate memory for it).
    66	 */
    67	void gen_message_random(unsigned char *R, const unsigned char *sk_prf,
    68	                        const unsigned char *optrand,
    69	                        const unsigned char *m, unsigned long long mlen,
    70	                        const spx_ctx *ctx)
    71	{
    72	    (void)ctx;
    73	
    74	    unsigned char buf[SPX_SHAX_BLOCK_BYTES + SPX_SHAX_OUTPUT_BYTES];
    75	    uint8_t state[8 + SPX_SHAX_OUTPUT_BYTES];
    76	    int i;
    77	
    78	#if SPX_N > SPX_SHAX_BLOCK_BYTES
    79	    #error "Currently only supports SPX_N of at most SPX_SHAX_BLOCK_BYTES"
    80	#endif
    81	
    82	    /* This implements HMAC-SHA */
    83	    for (i = 0; i < SPX_N; i++) {
    84	        buf[i] = 0x36 ^ sk_prf[i];
    85	    }
    86	    memset(buf + SPX_N, 0x36, SPX_SHAX_BLOCK_BYTES - SPX_N);
    87	
    88	    shaX_inc_init(state);
    89	    shaX_inc_blocks(state, buf, 1);
    90	
    91	    memcpy(buf, optrand, SPX_N);
    92	
    93	    /* If optrand + message cannot fill up an entire block */
    94	    if (SPX_N + mlen < SPX_SHAX_BLOCK_BYTES) {
    95	        memcpy(buf + SPX_N, m, mlen);
    96	        shaX_inc_finalize(buf + SPX_SHAX_BLOCK_BYTES, state,
    97	                            buf, mlen + SPX_N);
    98	    }
    99	    /* Otherwise first fill a block, so that finalize only uses the message */
   100	    else {
   101	        memcpy(buf + SPX_N, m, SPX_SHAX_BLOCK_BYTES - SPX_N);
   102	        shaX_inc_blocks(state, buf, 1);
   103	
   104	        m += SPX_SHAX_BLOCK_BYTES - SPX_N;
   105	        mlen -= SPX_SHAX_BLOCK_BYTES - SPX_N;
   106	        shaX_inc_finalize(buf + SPX_SHAX_BLOCK_BYTES, state, m, mlen);
   107	    }
   108	
   109	    for (i = 0; i < SPX_N; i++) {
   110	        buf[i] = 0x5c ^ sk_prf[i];
   111	    }
   112	    memset(buf + SPX_N, 0x5c, SPX_SHAX_BLOCK_BYTES - SPX_N);
   113	
   114	    shaX(buf, buf, SPX_SHAX_BLOCK_BYTES + SPX_SHAX_OUTPUT_BYTES);
   115	    memcpy(R, buf, SPX_N);
   116	}
   117	
   118	/**
   119	 * Computes the message hash using R, the public key, and the message.
   120	 * Outputs the message digest and the index of the leaf. The index is split in
   121	 * the tree index and the leaf index, for convenient copying to an address.
   122	 */
   123	void hash_message(unsigned char *digest, uint64_t *tree, uint32_t *leaf_idx,
   124	                  const unsigned char *R, const unsigned char *pk,
   125	                  const unsigned char *m, unsigned long long mlen,
   126	                  const spx_ctx *ctx)
   127	{
   128	    (void)ctx;
   129	#define SPX_TREE_BITS (SPX_TREE_HEIGHT * (SPX_D - 1))
   130	#define SPX_TREE_BYTES ((SPX_TREE_BITS + 7) / 8)
   131	#define SPX_LEAF_BITS SPX_TREE_HEIGHT
   132	#define SPX_LEAF_BYTES ((SPX_LEAF_BITS + 7) / 8)
   133	#define SPX_DGST_BYTES (SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES)
   134	
   135	    unsigned char seed[2*SPX_N + SPX_SHAX_OUTPUT_BYTES];
   136	
   137	    /* Round to nearest multiple of SPX_SHAX_BLOCK_BYTES */
   138	#if (SPX_SHAX_BLOCK_BYTES & (SPX_SHAX_BLOCK_BYTES-1)) != 0
   139	    #error "Assumes that SPX_SHAX_BLOCK_BYTES is a power of 2"
   140	#endif
   141	#define SPX_INBLOCKS (((SPX_N + SPX_PK_BYTES + SPX_SHAX_BLOCK_BYTES - 1) & \
   142	                        -SPX_SHAX_BLOCK_BYTES) / SPX_SHAX_BLOCK_BYTES)
   143	    unsigned char inbuf[SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES];
   144	
   145	    unsigned char buf[SPX_DGST_BYTES];
   146	    unsigned char *bufp = buf;
   147	    uint8_t state[8 + SPX_SHAX_OUTPUT_BYTES];
   148	
   149	    shaX_inc_init(state);
   150	
   151	    // seed: SHA-X(R ‖ PK.seed ‖ PK.root ‖ M)
   152	    memcpy(inbuf, R, SPX_N);
   153	    memcpy(inbuf + SPX_N, pk, SPX_PK_BYTES);
   154	
   155	    /* If R + pk + message cannot fill up an entire block */
   156	    if (SPX_N + SPX_PK_BYTES + mlen < SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES) {
   157	        memcpy(inbuf + SPX_N + SPX_PK_BYTES, m, mlen);
   158	        shaX_inc_finalize(seed + 2*SPX_N, state, inbuf, SPX_N + SPX_PK_BYTES + mlen);
   159	    }
   160	    /* Otherwise first fill a block, so that finalize only uses the message */
   161	    else {
   162	        memcpy(inbuf + SPX_N + SPX_PK_BYTES, m,
   163	               SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES - SPX_N - SPX_PK_BYTES);
   164	        shaX_inc_blocks(state, inbuf, SPX_INBLOCKS);
   165	
   166	        m += SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES - SPX_N - SPX_PK_BYTES;
   167	        mlen -= SPX_INBLOCKS * SPX_SHAX_BLOCK_BYTES - SPX_N - SPX_PK_BYTES;
   168	        shaX_inc_finalize(seed + 2*SPX_N, state, m, mlen);
   169	    }
   170	
   171	    // H_msg: MGF1-SHA-X(R ‖ PK.seed ‖ seed)
   172	    memcpy(seed, R, SPX_N);
   173	    memcpy(seed + SPX_N, pk, SPX_N);
   174	
   175	    /* By doing this in two steps, we prevent hashing the message twice;
   176	       otherwise each iteration in MGF1 would hash the message again. */
   177	    mgf1_X(bufp, SPX_DGST_BYTES, seed, 2*SPX_N + SPX_SHAX_OUTPUT_BYTES);
   178	
   179	    memcpy(digest, bufp, SPX_FORS_MSG_BYTES);
   180	    bufp += SPX_FORS_MSG_BYTES;
   181	
   182	#if SPX_TREE_BITS > 64
   183	    #error For given height and depth, 64 bits cannot represent all subtrees
   184	#endif
   185	
   186	    if (SPX_D == 1) {
   187		*tree = 0;
   188	    } else {
   189	        *tree = bytes_to_ull(bufp, SPX_TREE_BYTES);
   190	        *tree &= (~(uint64_t)0) >> (64 - SPX_TREE_BITS);
   191	    }
   192	    bufp += SPX_TREE_BYTES;
   193	
   194	    *leaf_idx = (uint32_t)bytes_to_ull(bufp, SPX_LEAF_BYTES);
   195	    *leaf_idx &= (~(uint32_t)0) >> (32 - SPX_LEAF_BITS);
   196	}
