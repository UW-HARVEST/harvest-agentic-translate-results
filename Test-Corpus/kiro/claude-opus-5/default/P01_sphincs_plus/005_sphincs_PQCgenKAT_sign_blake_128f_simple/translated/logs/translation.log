   138	             */
   139	            if ((internal_idx ^ internal_leaf) == 0x01) {
   140	                memcpy( &auth_path[ h * SPX_N ],
   141	                        &current[SPX_N],
   142	                        SPX_N );
   143	            }
   144	
   145	            /*
   146	             * Check if we're at a left child; if so, stop going up the stack
   147	             * Exception: if we've reached the end of the tree, keep on going
   148	             * (so we combine the last 4 nodes into the one root node in two
   149	             * more iterations)
   150	             */
   151	            if ((internal_idx & 1) == 0 && idx < max_idx) {
   152	                break;
   153	            }
   154	
   155	            /* Ok, we're at a right node */
   156	            /* Now combine the left and right logical nodes together */
   157	
   158	            /* Set the address of the node we're creating. */
   159	            internal_idx_offset >>= 1;
   160	            set_tree_height(tree_addr, h + 1);
   161	            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );
   162	
   163	            unsigned char *left = &stack[h * SPX_N];
   164	            memcpy( &current[0], left, SPX_N );
   165	            thash( &current[1 * SPX_N],
   166	                   &current[0 * SPX_N],
   167	                   2, ctx, tree_addr);
   168	        }
   169	
   170	        /* We've hit a left child; save the current for when we get the */
   171	        /* corresponding right right */
   172	        memcpy( &stack[h * SPX_N], &current[SPX_N], SPX_N);
   173	    }
   174	}
