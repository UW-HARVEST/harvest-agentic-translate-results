    15	
    16	/**
    17	 * Takes an array of inblocks concatenated arrays of SPX_N bytes.
    18	 */
    19	void thash(unsigned char *out, const unsigned char *in, unsigned int inblocks,
    20	           const spx_ctx *ctx, uint32_t addr[8])
    21	{
    22	#if SPX_SHA512
    23	    if (inblocks > 1) {
    24		thash_512(out, in, inblocks, ctx, addr);
    25	        return;
    26	    }
    27	#endif
    28	    unsigned char outbuf[SPX_SHA256_OUTPUT_BYTES];
    29	    SPX_VLA(uint8_t, bitmask, inblocks * SPX_N);
    30	    SPX_VLA(uint8_t, buf, SPX_N + SPX_SHA256_OUTPUT_BYTES + inblocks*SPX_N);
    31	    uint8_t sha2_state[40];
    32	    unsigned int i;
    33	
    34	    memcpy(buf, ctx->pub_seed, SPX_N);
    35	    memcpy(buf + SPX_N, addr, SPX_SHA256_ADDR_BYTES);
    36	    mgf1_256(bitmask, inblocks * SPX_N, buf, SPX_N + SPX_SHA256_ADDR_BYTES);
    37	
    38	    /* Retrieve precomputed state containing pub_seed */
    39	    memcpy(sha2_state, ctx->state_seeded, 40 * sizeof(uint8_t));
    40	
    41	    for (i = 0; i < inblocks * SPX_N; i++) {
    42	        buf[SPX_N + SPX_SHA256_ADDR_BYTES + i] = in[i] ^ bitmask[i];
    43	    }
    44	
    45	    sha256_inc_finalize(outbuf, sha2_state, buf + SPX_N,
    46	                        SPX_SHA256_ADDR_BYTES + inblocks*SPX_N);
    47	    memcpy(out, outbuf, SPX_N);
    48	}
