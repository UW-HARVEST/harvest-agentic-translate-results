    17	}
    18	
    19	static void fors_sk_to_leaf(unsigned char *leaf, const unsigned char *sk,
    20	                            const spx_ctx *ctx,
    21	                            uint32_t fors_leaf_addr[8])
    22	{
    23	    thash(leaf, sk, 1, ctx, fors_leaf_addr);
