    16	/*************************************************
    17	 * Name:        load64
    18	 *
    19	 * Description: Load 8 bytes into uint64_t in little-endian order
    20	 *
    21	 * Arguments:   - const uint8_t *x: pointer to input byte array
    22	 *
    23	 * Returns the loaded 64-bit unsigned integer
    24	 **************************************************/
    25	static uint64_t load64(const uint8_t *x) {
    26	    uint64_t r = 0;
    27	    for (size_t i = 0; i < 8; ++i) {
    28	        r |= (uint64_t)x[i] << 8 * i;
    29	    }
