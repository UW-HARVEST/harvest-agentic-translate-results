   622	/**
   623	 * mgf1 function based on the SHA-256 hash function
   624	 * Note that inlen should be sufficiently small that it still allows for
   625	 * an array to be allocated on the stack. Typically 'in' is merely a seed.
   626	 * Outputs outlen number of bytes
   627	 */
   628	void mgf1_256(unsigned char *out, unsigned long outlen,
   629	          const unsigned char *in, unsigned long inlen)
   630	{
   631	    SPX_VLA(uint8_t, inbuf, inlen+4);
   632	    unsigned char outbuf[SPX_SHA256_OUTPUT_BYTES];
   633	    unsigned long i;
   634	
   635	    memcpy(inbuf, in, inlen);
   636	
   637	    /* While we can fit in at least another full block of SHA256 output.. */
   638	    for (i = 0; (i+1)*SPX_SHA256_OUTPUT_BYTES <= outlen; i++) {
   639	        u32_to_bytes(inbuf + inlen, i);
   640	        sha256(out, inbuf, inlen + 4);
   641	        out += SPX_SHA256_OUTPUT_BYTES;
   642	    }
   643	    /* Until we cannot anymore, and we fill the remainder. */
   644	    if (outlen > i*SPX_SHA256_OUTPUT_BYTES) {
   645	        u32_to_bytes(inbuf + inlen, i);
   646	        sha256(outbuf, inbuf, inlen + 4);
   647	        memcpy(out, outbuf, outlen - i*SPX_SHA256_OUTPUT_BYTES);
   648	    }
   649	}
