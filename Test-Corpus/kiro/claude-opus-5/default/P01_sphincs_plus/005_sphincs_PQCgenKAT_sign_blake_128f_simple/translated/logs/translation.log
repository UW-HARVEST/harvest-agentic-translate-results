    40	 *              - uint64_t u: input 64-bit unsigned integer
    41	 **************************************************/
    42	static void store64(uint8_t *x, uint64_t u) {
    43	    for (size_t i = 0; i < 8; ++i) {
    44	        x[i] = (uint8_t) (u >> 8 * i);
    45	    }
    46	}
