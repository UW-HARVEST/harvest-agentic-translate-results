   446	               xor with the s_inc[25] + i'th byte of the state; little-endian */
   447	            s_inc[(s_inc[25] + i) >> 3] ^= (uint64_t)m[i] << (8 * ((s_inc[25] + i) & 0x07));
   448	        }
   449	        mlen -= (size_t)(r - s_inc[25]);
   450	        m += r - s_inc[25];
   451	        s_inc[25] = 0;
   452	
   453	        KeccakF1600_StatePermute(s_inc);
   454	    }
   455	
   456	    for (i = 0; i < mlen; i++) {
   457	        s_inc[(s_inc[25] + i) >> 3] ^= (uint64_t)m[i] << (8 * ((s_inc[25] + i) & 0x07));
   458	    }
   459	    s_inc[25] += mlen;
