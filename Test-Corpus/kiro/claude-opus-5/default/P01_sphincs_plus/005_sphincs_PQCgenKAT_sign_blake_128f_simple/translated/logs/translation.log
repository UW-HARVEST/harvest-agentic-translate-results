    11	
    12	/*
    13	 * This generates a WOTS public key
    14	 * It also generates the WOTS signature if leaf_info indicates
    15	 * that we're signing with this WOTS key
    16	 */
    17	void wots_gen_leafx1(unsigned char *dest,
    18	                   const spx_ctx *ctx,
    19	                   uint32_t leaf_idx, leaf_info_x1 *v_info) {
    20	    struct leaf_info_x1 *info = v_info;
    21	    uint32_t *leaf_addr = info->leaf_addr;
    22	    uint32_t *pk_addr = info->pk_addr;
    23	    unsigned int i, k;
    24	    unsigned char pk_buffer[ SPX_WOTS_BYTES ];
    25	    unsigned char *buffer;
    26	    uint32_t wots_k_mask;
    27	
    28	    if (leaf_idx == info->wots_sign_leaf) {
    29	        /* We're traversing the leaf that's signing; generate the WOTS */
    30	        /* signature */
    31	        wots_k_mask = 0;
    32	    } else {
    33	        /* Nope, we're just generating pk's; turn off the signature logic */
    34	        wots_k_mask = (uint32_t)~0;
    35	    }
    36	
    37	    set_keypair_addr( leaf_addr, leaf_idx );
    38	    set_keypair_addr( pk_addr, leaf_idx );
    39	
    40	    for (i = 0, buffer = pk_buffer; i < SPX_WOTS_LEN; i++, buffer += SPX_N) {
    41	        uint32_t wots_k = info->wots_steps[i] | wots_k_mask; /* Set wots_k to */
    42	            /* the step if we're generating a signature, ~0 if we're not */
    43	
    44	        /* Start with the secret seed */
    45	        set_chain_addr(leaf_addr, i);
    46	        set_hash_addr(leaf_addr, 0);
    47	        set_type(leaf_addr, SPX_ADDR_TYPE_WOTSPRF);
    48	
    49	        prf_addr(buffer, ctx, leaf_addr);
    50	
    51	        set_type(leaf_addr, SPX_ADDR_TYPE_WOTS);
    52	
    53	        /* Iterate down the WOTS chain */
    54	        for (k=0;; k++) {
    55	            /* Check if this is the value that needs to be saved as a */
    56	            /* part of the WOTS signature */
    57	            if (k == wots_k) {
    58	                memcpy( info->wots_sig + i * SPX_N, buffer, SPX_N );
    59	            }
    60	
    61	            /* Check if we hit the top of the chain */
    62	            if (k == SPX_WOTS_W - 1) break;
    63	
    64	            /* Iterate one step on the chain */
    65	            set_hash_addr(leaf_addr, k);
    66	
    67	            thash(buffer, buffer, 1, ctx, leaf_addr);
    68	        }
    69	    }
    70	
    71	    /* Do the final thash to generate the public keys */
    72	    thash(dest, pk_buffer, SPX_WOTS_LEN, ctx, pk_addr);
    73	}
