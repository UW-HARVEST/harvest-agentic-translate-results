    93	 * Returns an array containing a detached signature.
    94	 */
    95	int crypto_sign_signature(uint8_t *sig, size_t *siglen,
    96	                          const uint8_t *m, size_t mlen, const uint8_t *sk)
    97	{
    98	    spx_ctx ctx;
    99	
   100	    const unsigned char *sk_prf = sk + SPX_N;
   101	    const unsigned char *pk = sk + 2*SPX_N;
   102	
   103	    unsigned char optrand[SPX_N];
   104	    unsigned char mhash[SPX_FORS_MSG_BYTES];
   105	    unsigned char root[SPX_N];
   106	    uint32_t i;
   107	    uint64_t tree;
   108	    uint32_t idx_leaf;
   109	    uint32_t wots_addr[8] = {0};
   110	    uint32_t tree_addr[8] = {0};
   111	
   112	    memcpy(ctx.sk_seed, sk, SPX_N);
   113	    memcpy(ctx.pub_seed, pk, SPX_N);
   114	
   115	    /* This hook allows the hash function instantiation to do whatever
   116	       preparation or computation it needs, based on the public seed. */
   117	    initialize_hash_function(&ctx);
   118	
   119	    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);
   120	    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);
   121	
   122	    /* Optionally, signing can be made non-deterministic using optrand.
   123	       This can help counter side-channel attacks that would benefit from
   124	       getting a large number of traces when the signer uses the same nodes. */
   125	    randombytes(optrand, SPX_N);
   126	    /* Compute the digest randomization value. */
   127	    gen_message_random(sig, sk_prf, optrand, m, mlen, &ctx);
   128	
   129	    /* Derive the message digest and leaf index from R, PK and M. */
   130	    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);
   131	    sig += SPX_N;
   132	
   133	    set_tree_addr(wots_addr, tree);
   134	    set_keypair_addr(wots_addr, idx_leaf);
   135	
   136	    /* Sign the message hash using FORS. */
   137	    fors_sign(sig, root, mhash, &ctx, wots_addr);
   138	    sig += SPX_FORS_BYTES;
   139	
   140	    for (i = 0; i < SPX_D; i++) {
   141	        set_layer_addr(tree_addr, i);
   142	        set_tree_addr(tree_addr, tree);
   143	
   144	        copy_subtree_addr(wots_addr, tree_addr);
   145	        set_keypair_addr(wots_addr, idx_leaf);
   146	
   147	        merkle_sign(sig, root, &ctx, wots_addr, tree_addr, idx_leaf);
   148	        sig += SPX_WOTS_BYTES + SPX_TREE_HEIGHT * SPX_N;
   149	
   150	        /* Update the indices for the next layer. */
   151	        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));
   152	        tree = tree >> SPX_TREE_HEIGHT;
   153	    }
   154	
   155	    *siglen = SPX_BYTES;
   156	
   157	    return 0;
   158	}
   159	
   160	/**
   161	 * Verifies a detached signature and message under a given public key.
   162	 */
   163	int crypto_sign_verify(const uint8_t *sig, size_t siglen,
   164	                       const uint8_t *m, size_t mlen, const uint8_t *pk)
   165	{
   166	    spx_ctx ctx;
   167	    const unsigned char *pub_root = pk + SPX_N;
   168	    unsigned char mhash[SPX_FORS_MSG_BYTES];
   169	    unsigned char wots_pk[SPX_WOTS_BYTES];
   170	    unsigned char root[SPX_N];
   171	    unsigned char leaf[SPX_N];
   172	    unsigned int i;
   173	    uint64_t tree;
   174	    uint32_t idx_leaf;
   175	    uint32_t wots_addr[8] = {0};
   176	    uint32_t tree_addr[8] = {0};
   177	    uint32_t wots_pk_addr[8] = {0};
   178	
   179	    if (siglen != SPX_BYTES) {
   180	        return -1;
   181	    }
   182	
   183	    memcpy(ctx.pub_seed, pk, SPX_N);
   184	
   185	    /* This hook allows the hash function instantiation to do whatever
   186	       preparation or computation it needs, based on the public seed. */
   187	    initialize_hash_function(&ctx);
   188	
   189	    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);
   190	    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);
   191	    set_type(wots_pk_addr, SPX_ADDR_TYPE_WOTSPK);
   192	
   193	    /* Derive the message digest and leaf index from R || PK || M. */
   194	    /* The additional SPX_N is a result of the hash domain separator. */
   195	    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);
   196	    sig += SPX_N;
   197	
   198	    /* Layer correctly defaults to 0, so no need to set_layer_addr */
   199	    set_tree_addr(wots_addr, tree);
   200	    set_keypair_addr(wots_addr, idx_leaf);
   201	
   202	    fors_pk_from_sig(root, sig, mhash, &ctx, wots_addr);
   203	    sig += SPX_FORS_BYTES;
   204	
   205	    /* For each subtree.. */
   206	    for (i = 0; i < SPX_D; i++) {
   207	        set_layer_addr(tree_addr, i);
   208	        set_tree_addr(tree_addr, tree);
   209	
   210	        copy_subtree_addr(wots_addr, tree_addr);
   211	        set_keypair_addr(wots_addr, idx_leaf);
   212	
   213	        copy_keypair_addr(wots_pk_addr, wots_addr);
   214	
   215	        /* The WOTS public key is only correct if the signature was correct. */
   216	        /* Initially, root is the FORS pk, but on subsequent iterations it is
   217	           the root of the subtree below the currently processed subtree. */
   218	        wots_pk_from_sig(wots_pk, sig, root, &ctx, wots_addr);
   219	        sig += SPX_WOTS_BYTES;
   220	
   221	        /* Compute the leaf node using the WOTS public key. */
   222	        thash(leaf, wots_pk, SPX_WOTS_LEN, &ctx, wots_pk_addr);
   223	
   224	        /* Compute the root node of this subtree. */
   225	        compute_root(root, leaf, idx_leaf, 0, sig, SPX_TREE_HEIGHT,
   226	                     &ctx, tree_addr);
   227	        sig += SPX_TREE_HEIGHT * SPX_N;
   228	
   229	        /* Update the indices for the next layer. */
   230	        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));
   231	        tree = tree >> SPX_TREE_HEIGHT;
   232	    }
   233	
   234	    /* Check if the root node equals the root node in the public key. */
   235	    if (memcmp(root, pub_root, SPX_N)) {
   236	        return -1;
   237	    }
   238	
   239	    return 0;
   240	}
   241	
   242	
   243	/**
   244	 * Returns an array containing the signature followed by the message.
   245	 */
   246	int crypto_sign(unsigned char *sm, unsigned long long *smlen,
   247	                const unsigned char *m, unsigned long long mlen,
   248	                const unsigned char *sk)
   249	{
   250	    size_t siglen;
   251	
   252	    crypto_sign_signature(sm, &siglen, m, (size_t)mlen, sk);
   253	
   254	    memmove(sm + SPX_BYTES, m, mlen);
   255	    *smlen = siglen + mlen;
   256	
   257	    return 0;
   258	}
   259	
   260	/**
   261	 * Verifies a given signature-message pair under a given public key.
   262	 */
   263	int crypto_sign_open(unsigned char *m, unsigned long long *mlen,
   264	                     const unsigned char *sm, unsigned long long smlen,
   265	                     const unsigned char *pk)
   266	{
   267	    /* The API caller does not necessarily know what size a signature should be
   268	       but SPHINCS+ signatures are always exactly SPX_BYTES. */
   269	    if (smlen < SPX_BYTES) {
   270	        memset(m, 0, smlen);
   271	        *mlen = 0;
   272	        return -1;
   273	    }
   274	
   275	    *mlen = smlen - SPX_BYTES;
   276	
   277	    if (crypto_sign_verify(sm, SPX_BYTES, sm + SPX_BYTES, (size_t)*mlen, pk)) {
   278	        memset(m, 0, smlen);
   279	        *mlen = 0;
   280	        return -1;
   281	    }
   282	
   283	    /* If verification was successful, move the message to the right place. */
   284	    memmove(m, sm + SPX_BYTES, *mlen);
   285	
   286	    return 0;
   287	}
