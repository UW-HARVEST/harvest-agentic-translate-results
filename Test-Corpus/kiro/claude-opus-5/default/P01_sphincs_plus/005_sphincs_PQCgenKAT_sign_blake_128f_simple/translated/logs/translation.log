   554	/*************************************************
   555	 * Name:        shake256_squeezeblocks
   556	 *
   557	 * Description: Squeeze step of SHAKE256 XOF. Squeezes full blocks of
   558	 *              SHAKE256_RATE bytes each. Modifies the state. Can be called
   559	 *              multiple times to keep squeezing, i.e., is incremental.
   560	 *
   561	 * Arguments:   - uint8_t *output: pointer to output blocks
   562	 *              - size_t nblocks: number of blocks to be squeezed
   563	 *                                (written to output)
   564	 *              - uint64_t *s: pointer to input/output Keccak state
   565	 **************************************************/
   566	void shake256_squeezeblocks(uint8_t *output, size_t nblocks, uint64_t *s) {
   567	    keccak_squeezeblocks(output, nblocks, s, SHAKE256_RATE);
   568	}
   569	
   570	/*************************************************
   571	 * Name:        shake256
   572	 *
   573	 * Description: SHAKE256 XOF with non-incremental API
   574	 *
   575	 * Arguments:   - uint8_t *output: pointer to output
   576	 *              - size_t outlen: requested output length in bytes
   577	 *              - const uint8_t *input: pointer to input
   578	 *              - size_t inlen: length of input in bytes
   579	 **************************************************/
   580	void shake256(uint8_t *output, size_t outlen,
   581	              const uint8_t *input, size_t inlen) {
   582	    size_t nblocks = outlen / SHAKE256_RATE;
   583	    uint8_t t[SHAKE256_RATE];
   584	    uint64_t s[25];
   585	
   586	    shake256_absorb(s, input, inlen);
   587	    shake256_squeezeblocks(output, nblocks, s);
   588	
   589	    output += nblocks * SHAKE256_RATE;
   590	    outlen -= nblocks * SHAKE256_RATE;
   591	
   592	    if (outlen) {
   593	        shake256_squeezeblocks(t, 1, s);
   594	        for (size_t i = 0; i < outlen; ++i) {
   595	            output[i] = t[i];
   596	        }
   597	    }
   598	}
