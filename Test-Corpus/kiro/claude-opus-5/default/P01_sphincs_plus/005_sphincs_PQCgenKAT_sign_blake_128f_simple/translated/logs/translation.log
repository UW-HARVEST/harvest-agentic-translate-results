    11	/**
    12	 * Takes an array of inblocks concatenated arrays of SPX_N bytes.
    13	 */
    14	void thash(unsigned char *out, const unsigned char *in, unsigned int inblocks,
    15	           const spx_ctx *ctx, uint32_t addr[8])
    16	{
    17	    SPX_VLA(uint8_t, buf, SPX_N + SPX_ADDR_BYTES + inblocks*SPX_N);
    18	    SPX_VLA(uint8_t, bitmask, inblocks * SPX_N);
    19	    unsigned int i;
    20	
    21	    memcpy(buf, ctx->pub_seed, SPX_N);
    22	    memcpy(buf + SPX_N, addr, SPX_ADDR_BYTES);
    23	
    24	    shake256(bitmask, inblocks * SPX_N, buf, SPX_N + SPX_ADDR_BYTES);
    25	
    26	    for (i = 0; i < inblocks * SPX_N; i++) {
    27	        buf[SPX_N + SPX_ADDR_BYTES + i] = in[i] ^ bitmask[i];
