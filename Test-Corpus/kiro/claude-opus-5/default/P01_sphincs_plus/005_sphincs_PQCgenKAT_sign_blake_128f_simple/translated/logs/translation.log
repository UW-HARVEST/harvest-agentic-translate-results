   380	/*************************************************
   381	 * Name:        keccak_squeezeblocks
   382	 *
   383	 * Description: Squeeze step of Keccak. Squeezes full blocks of r bytes each.
   384	 *              Modifies the state. Can be called multiple times to keep
   385	 *              squeezing, i.e., is incremental.
   386	 *
   387	 * Arguments:   - uint8_t *h: pointer to output blocks
   388	 *              - size_t nblocks: number of blocks to be
   389	 *                                                squeezed (written to h)
   390	 *              - uint64_t *s: pointer to input/output Keccak state
   391	 *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)
   392	 **************************************************/
   393	static void keccak_squeezeblocks(uint8_t *h, size_t nblocks,
   394	                                 uint64_t *s, uint32_t r) {
   395	    while (nblocks > 0) {
   396	        KeccakF1600_StatePermute(s);
   397	        for (size_t i = 0; i < (r >> 3); i++) {
   398	            store64(h + 8 * i, s[i]);
   399	        }
   400	        h += r;
   401	        nblocks--;
   402	    }
   403	}
