    20	#define SPX_SHAX_OUTPUT_BYTES SPX_SHA256_OUTPUT_BYTES
    21	#define SPX_SHAX_BLOCK_BYTES SPX_SHA256_BLOCK_BYTES
    22	#define shaX_inc_init sha256_inc_init
    23	#define shaX_inc_blocks sha256_inc_blocks
    24	#define shaX_inc_finalize sha256_inc_finalize
    25	#define shaX sha256
    26	#define mgf1_X mgf1_256
    27	#endif
