    63	    memcpy(ctx.pub_seed, pk, SPX_N);
    64	    memcpy(ctx.sk_seed, sk, SPX_N);
    65	
    66	    /* This hook allows the hash function instantiation to do whatever
    67	       preparation or computation it needs, based on the public seed. */
    68	    initialize_hash_function(&ctx);
