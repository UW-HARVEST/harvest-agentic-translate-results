    93	
    94	    *leaf_idx = (uint32_t)bytes_to_ull(bufp, SPX_LEAF_BYTES);
    95	    *leaf_idx &= (~(uint32_t)0) >> (32 - SPX_LEAF_BITS);
    96	}
