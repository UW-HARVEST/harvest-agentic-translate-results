    10	/*
    11	 * Generate the entire Merkle tree, computing the authentication path for
    12	 * leaf_idx, and the resulting root node using Merkle's TreeHash algorithm.
    13	 * Expects the layer and tree parts of the tree_addr to be set, as well as the
    14	 * tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE)
    15	 *
    16	 * This expects tree_addr to be initialized to the addr structures for the
    17	 * Merkle tree nodes
    18	 *
    19	 * Applies the offset idx_offset to indices before building addresses, so that
    20	 * it is possible to continue counting indices across trees.
    21	 *
    22	 * This works by using the standard Merkle tree building algorithm,
    23	 */
    24	void wots_treehashx1(unsigned char *root, unsigned char *auth_path,
    25			     const spx_ctx* ctx,
    26			     uint32_t leaf_idx, uint32_t idx_offset,
    27			     uint32_t tree_height,
    28			     uint32_t tree_addr[8],
    29			     leaf_info_x1 *info)
    30	{
    31	    /* This is where we keep the intermediate nodes */
    32	    SPX_VLA(uint8_t, stack, tree_height*SPX_N);
    33	
    34	    uint32_t idx;
    35	    uint32_t max_idx = (uint32_t)((1 << tree_height) - 1);
    36	    for (idx = 0;; idx++) {
    37	        unsigned char current[2*SPX_N];   /* Current logical node is at */
    38	            /* index[SPX_N].  We do this to minimize the number of copies */
    39	            /* needed during a thash */
    40	        wots_gen_leafx1( &current[SPX_N], ctx, idx + idx_offset,
    41				 info );
    42	
    43	        /* Now combine the freshly generated right node with previously */
    44	        /* generated left ones */
    45	        uint32_t internal_idx_offset = idx_offset;
    46	        uint32_t internal_idx = idx;
    47	        uint32_t internal_leaf = leaf_idx;
    48	        uint32_t h;     /* The height we are in the Merkle tree */
    49	        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {
    50	
    51	            /* Check if we hit the top of the tree */
    52	            if (h == tree_height) {
    53	                /* We hit the root; return it */
    54	                memcpy( root, &current[SPX_N], SPX_N );
    55	                return;
    56	            }
    57	
    58	            /*
    59	             * Check if the node we have is a part of the
    60	             * authentication path; if it is, write it out
    61	             */
    62	            if ((internal_idx ^ internal_leaf) == 0x01) {
    63	                memcpy( &auth_path[ h * SPX_N ],
    64	                        &current[SPX_N],
    65	                        SPX_N );
    66	            }
    67	
    68	            /*
    69	             * Check if we're at a left child; if so, stop going up the stack
    70	             * Exception: if we've reached the end of the tree, keep on going
    71	             * (so we combine the last 4 nodes into the one root node in two
    72	             * more iterations)
    73	             */
    74	            if ((internal_idx & 1) == 0 && idx < max_idx) {
    75	                break;
    76	            }
    77	
    78	            /* Ok, we're at a right node */
    79	            /* Now combine the left and right logical nodes together */
    80	
    81	            /* Set the address of the node we're creating. */
    82	            internal_idx_offset >>= 1;
    83	            set_tree_height(tree_addr, h + 1);
    84	            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );
    85	
    86	            unsigned char *left = &stack[h * SPX_N];
    87	            memcpy( &current[0], left, SPX_N );
    88	            thash( &current[1 * SPX_N],
    89	                   &current[0 * SPX_N],
    90	                   2, ctx, tree_addr);
    91	        }
    92	
    93	        /* We've hit a left child; save the current for when we get the */
    94	        /* corresponding right right */
    95	        memcpy( &stack[h * SPX_N], &current[SPX_N], SPX_N);
    96	    }
    97	}
    98	
    99	void fors_treehashx1(unsigned char *root, unsigned char *auth_path,
   100			     const spx_ctx* ctx,
   101			     uint32_t leaf_idx, uint32_t idx_offset,
   102			     uint32_t tree_height,
   103			     uint32_t tree_addr[8],
   104			     leaf_info_x1 *info)
   105	{
   106	    /* This is where we keep the intermediate nodes */
   107	    SPX_VLA(uint8_t, stack, tree_height*SPX_N);
   108	
   109	    uint32_t idx;
   110	    uint32_t max_idx = (uint32_t)((1 << tree_height) - 1);
   111	    for (idx = 0;; idx++) {
   112	        unsigned char current[2*SPX_N];   /* Current logical node is at */
   113	            /* index[SPX_N].  We do this to minimize the number of copies */
   114	            /* needed during a thash */
   115	
   116		// IAN TODO: WARNING ON INFO PARAMETER
   117	        fors_gen_leafx1( &current[SPX_N], ctx, idx + idx_offset,
   118				 info );
   119	
   120	        /* Now combine the freshly generated right node with previously */
   121	        /* generated left ones */
   122	        uint32_t internal_idx_offset = idx_offset;
   123	        uint32_t internal_idx = idx;
   124	        uint32_t internal_leaf = leaf_idx;
   125	        uint32_t h;     /* The height we are in the Merkle tree */
   126	        for (h=0;; h++, internal_idx >>= 1, internal_leaf >>= 1) {
   127	
   128	            /* Check if we hit the top of the tree */
   129	            if (h == tree_height) {
   130	                /* We hit the root; return it */
   131	                memcpy( root, &current[SPX_N], SPX_N );
   132	                return;
   133	            }
   134	
   135	            /*
   136	             * Check if the node we have is a part of the
   137	             * authentication path; if it is, write it out
   138	             */
   139	            if ((internal_idx ^ internal_leaf) == 0x01) {
   140	                memcpy( &auth_path[ h * SPX_N ],
   141	                        &current[SPX_N],
   142	                        SPX_N );
   143	            }
   144	
   145	            /*
   146	             * Check if we're at a left child; if so, stop going up the stack
   147	             * Exception: if we've reached the end of the tree, keep on going
   148	             * (so we combine the last 4 nodes into the one root node in two
   149	             * more iterations)
   150	             */
   151	            if ((internal_idx & 1) == 0 && idx < max_idx) {
   152	                break;
   153	            }
   154	
   155	            /* Ok, we're at a right node */
   156	            /* Now combine the left and right logical nodes together */
   157	
   158	            /* Set the address of the node we're creating. */
   159	            internal_idx_offset >>= 1;
   160	            set_tree_height(tree_addr, h + 1);
   161	            set_tree_index(tree_addr, internal_idx/2 + internal_idx_offset );
   162	
   163	            unsigned char *left = &stack[h * SPX_N];
   164	            memcpy( &current[0], left, SPX_N );
   165	            thash( &current[1 * SPX_N],
   166	                   &current[0 * SPX_N],
   167	                   2, ctx, tree_addr);
   168	        }
   169	
   170	        /* We've hit a left child; save the current for when we get the */
   171	        /* corresponding right right */
   172	        memcpy( &stack[h * SPX_N], &current[SPX_N], SPX_N);
   173	    }
   174	}
