    15	
    16	/**
    17	 * Takes an array of inblocks concatenated arrays of SPX_N bytes.
    18	 */
    19	void thash(unsigned char *out, const unsigned char *in, unsigned int inblocks,
    20	           const spx_ctx *ctx, uint32_t addr[8])
    21	{
    22	#if SPX_BLAKE512
    23	    if (inblocks > 1) {
    24		thash_512(out, in, inblocks, ctx, addr);
    25	        return;
    26	    }
    27	#endif
    28	    unsigned char outbuf[SPX_BLAKE256_OUTPUT_BYTES];
    29	    SPX_VLA(uint8_t, bitmask, inblocks * SPX_N);
    30	    SPX_VLA(uint8_t, buf, SPX_N + SPX_ADDR_BYTES + inblocks*SPX_N);
    31	    unsigned int i;
    32	
    33	    memcpy(buf, ctx->pub_seed, SPX_N);
    34	    memcpy(buf + SPX_N, addr, SPX_ADDR_BYTES);
    35	    
    36	    blake256_mgf1(bitmask, inblocks * SPX_N, buf, SPX_N + SPX_ADDR_BYTES);
    37	
    38	    for (i = 0; i < inblocks * SPX_N; i++) {
    39	        buf[SPX_N + SPX_ADDR_BYTES + i] = in[i] ^ bitmask[i];
    40	    }
    41	
    42	    blake256(outbuf, buf + SPX_N, SPX_ADDR_BYTES + inblocks*SPX_N);
    43	    memcpy(out, outbuf, SPX_N);
    44	}
