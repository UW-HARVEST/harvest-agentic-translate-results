    70	    uint8_t s_inc[65];
    71	
    72	    haraka_S_inc_init(s_inc);
    73	    haraka_S_inc_absorb(s_inc, R, SPX_N, ctx);
    74	    haraka_S_inc_absorb(s_inc, pk + SPX_N, SPX_N, ctx); // Only absorb root part of pk
    75	    haraka_S_inc_absorb(s_inc, m, mlen, ctx);
    76	    haraka_S_inc_finalize(s_inc);
    77	    haraka_S_inc_squeeze(buf, SPX_DGST_BYTES, s_inc, ctx);
    78	
    79	    memcpy(digest, bufp, SPX_FORS_MSG_BYTES);
    80	    bufp += SPX_FORS_MSG_BYTES;
