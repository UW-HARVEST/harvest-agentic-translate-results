   136	void
   137	randombytes_init(unsigned char *entropy_input,
   138	                 unsigned char *personalization_string)
   139	{
   140	    unsigned char   seed_material[48];
   141	    
   142	    memcpy(seed_material, entropy_input, 48);
   143	    if (personalization_string)
   144	        for (int i=0; i<48; i++)
   145	            seed_material[i] ^= personalization_string[i];
   146	    memset(DRBG_ctx.Key, 0x00, 32);
   147	    memset(DRBG_ctx.V, 0x00, 16);
   148	    AES256_CTR_DRBG_Update(seed_material, DRBG_ctx.Key, DRBG_ctx.V);
   149	    DRBG_ctx.reseed_counter = 1;
   150	}
   151	
   152	int
   153	randombytes(unsigned char *x, unsigned long long xlen)
   154	{
   155	    unsigned char   block[16];
   156	    int             i = 0;
   157	    
   158	    while ( xlen > 0 ) {
   159	        //increment V
   160	        for (int j=15; j>=0; j--) {
   161	            if ( DRBG_ctx.V[j] == 0xff )
   162	                DRBG_ctx.V[j] = 0x00;
   163	            else {
   164	                DRBG_ctx.V[j]++;
   165	                break;
   166	            }
   167	        }
   168	        AES256_ECB(DRBG_ctx.Key, DRBG_ctx.V, block);
   169	        if ( xlen > 15 ) {
   170	            memcpy(x+i, block, 16);
   171	            i += 16;
   172	            xlen -= 16;
   173	        }
   174	        else {
   175	            memcpy(x+i, block, xlen);
   176	            xlen = 0;
   177	        }
   178	    }
   179	    AES256_CTR_DRBG_Update(NULL, DRBG_ctx.Key, DRBG_ctx.V);
   180	    DRBG_ctx.reseed_counter++;
   181	    
   182	    return RNG_SUCCESS;
   183	}
   184	
   185	void
   186	AES256_CTR_DRBG_Update(unsigned char *provided_data,
   187	                       unsigned char *Key,
   188	                       unsigned char *V)
   189	{
   190	    unsigned char   temp[48];
   191	    
   192	    for (int i=0; i<3; i++) {
   193	        //increment V
   194	        for (int j=15; j>=0; j--) {
   195	            if ( V[j] == 0xff )
   196	                V[j] = 0x00;
   197	            else {
   198	                V[j]++;
   199	                break;
   200	            }
   201	        }
   202	        
   203	        AES256_ECB(Key, V, temp+16*i);
   204	    }
   205	    if ( provided_data != NULL )
   206	        for (int i=0; i<48; i++)
   207	            temp[i] ^= provided_data[i];
   208	    memcpy(Key, temp, 32);
   209	    memcpy(V, temp+32, 16);
   210	}
