     9	#include "../include/utilsx1.h"
    10	#include "../include/wots.h"
    11	#include "../include/wotsx1.h"
    12	
    13	// TODO clarify address expectations, and make them more uniform.
    14	// TODO i.e. do we expect types to be set already?
    15	// TODO and do we expect modifications or copies?
    16	
    17	/**
    18	 * Computes the chaining function.
    19	 * out and in have to be n-byte arrays.
    20	 *
    21	 * Interprets in as start-th value of the chain.
    22	 * addr has to contain the address of the chain.
    23	 */
    24	static void gen_chain(unsigned char *out, const unsigned char *in,
    25	                      unsigned int start, unsigned int steps,
    26	                      const spx_ctx *ctx, uint32_t addr[8])
    27	{
    28	    uint32_t i;
    29	
    30	    /* Initialize out with the value at position 'start'. */
    31	    memcpy(out, in, SPX_N);
    32	
    33	    /* Iterate 'steps' calls to the hash function. */
    34	    for (i = start; i < (start+steps) && i < SPX_WOTS_W; i++) {
    35	        set_hash_addr(addr, i);
    36	        thash(out, out, 1, ctx, addr);
    37	    }
    38	}
    39	
    40	/**
    41	 * base_w algorithm as described in draft.
    42	 * Interprets an array of bytes as integers in base w.
    43	 * This only works when log_w is a divisor of 8.
    44	 */
    45	static void base_w(unsigned int *output, const int out_len,
    46	                   const unsigned char *input)
    47	{
    48	    int in = 0;
    49	    int out = 0;
    50	    unsigned char total;
    51	    int bits = 0;
    52	    int consumed;
    53	
    54	    for (consumed = 0; consumed < out_len; consumed++) {
    55	        if (bits == 0) {
    56	            total = input[in];
    57	            in++;
    58	            bits += 8;
    59	        }
    60	        bits -= SPX_WOTS_LOGW;
    61	        output[out] = (total >> bits) & (SPX_WOTS_W - 1);
    62	        out++;
    63	    }
    64	}
    65	
    66	/* Computes the WOTS+ checksum over a message (in base_w). */
    67	static void wots_checksum(unsigned int *csum_base_w,
    68	                          const unsigned int *msg_base_w)
    69	{
    70	    unsigned int csum = 0;
    71	    unsigned char csum_bytes[(SPX_WOTS_LEN2 * SPX_WOTS_LOGW + 7) / 8];
    72	    unsigned int i;
    73	
    74	    /* Compute checksum. */
    75	    for (i = 0; i < SPX_WOTS_LEN1; i++) {
    76	        csum += SPX_WOTS_W - 1 - msg_base_w[i];
    77	    }
    78	
    79	    /* Convert checksum to base_w. */
    80	    /* Make sure expected empty zero bits are the least significant bits. */
    81	    csum = csum << ((8 - ((SPX_WOTS_LEN2 * SPX_WOTS_LOGW) % 8)) % 8);
    82	    ull_to_bytes(csum_bytes, sizeof(csum_bytes), csum);
    83	    base_w(csum_base_w, SPX_WOTS_LEN2, csum_bytes);
    84	}
    85	
    86	/* Takes a message and derives the matching chain lengths. */
    87	void chain_lengths(unsigned int *lengths, const unsigned char *msg)
    88	{
    89	    base_w(lengths, SPX_WOTS_LEN1, msg);
    90	    wots_checksum(lengths + SPX_WOTS_LEN1, lengths);
    91	}
    92	
    93	/**
    94	 * Takes a WOTS signature and an n-byte message, computes a WOTS public key.
    95	 *
    96	 * Writes the computed public key to 'pk'.
    97	 */
    98	void wots_pk_from_sig(unsigned char *pk,
    99	                      const unsigned char *sig, const unsigned char *msg,
   100	                      const spx_ctx *ctx, uint32_t addr[8])
   101	{
   102	    unsigned int lengths[SPX_WOTS_LEN];
   103	    uint32_t i;
   104	
   105	    chain_lengths(lengths, msg);
   106	
   107	    for (i = 0; i < SPX_WOTS_LEN; i++) {
   108	        set_chain_addr(addr, i);
   109	        gen_chain(pk + i*SPX_N, sig + i*SPX_N,
   110	                  lengths[i], SPX_WOTS_W - 1 - lengths[i], ctx, addr);
   111	    }
   112	}
