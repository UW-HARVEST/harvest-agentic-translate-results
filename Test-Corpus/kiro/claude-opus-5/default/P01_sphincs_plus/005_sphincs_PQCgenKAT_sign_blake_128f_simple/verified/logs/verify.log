     8	#include "../include/utilsx1.h"
     9	#include "../include/wots.h"
    10	#include "../include/wotsx1.h"
    11	
    12	/*
    13	 * This generates a Merkle signature (WOTS signature followed by the Merkle
    14	 * authentication path).  This is in this file because most of the complexity
    15	 * is involved with the WOTS signature; the Merkle authentication path logic
    16	 * is mostly hidden in treehashx4
    17	 */
    18	void merkle_sign(uint8_t *sig, unsigned char *root,
    19	                 const spx_ctx *ctx,
    20	                 uint32_t wots_addr[8], uint32_t tree_addr[8],
    21	                 uint32_t idx_leaf)
    22	{
    23	    unsigned char *auth_path = sig + SPX_WOTS_BYTES;
    24	    struct leaf_info_x1 info = { 0 };
    25	    unsigned steps[ SPX_WOTS_LEN ];
    26	
    27	    info.wots_sig = sig;
    28	    chain_lengths(steps, root);
    29	    info.wots_steps = steps;
    30	
    31	    set_type(&tree_addr[0], SPX_ADDR_TYPE_HASHTREE);
    32	    set_type(&info.pk_addr[0], SPX_ADDR_TYPE_WOTSPK);
    33	    copy_subtree_addr(&info.leaf_addr[0], wots_addr);
    34	    copy_subtree_addr(&info.pk_addr[0], wots_addr);
    35	
    36	    info.wots_sign_leaf = idx_leaf;
    37	
    38	    wots_treehashx1(root, auth_path, ctx,
    39	                idx_leaf, 0,
    40	                SPX_TREE_HEIGHT,
    41	                tree_addr, &info);
    42	}
    43	
    44	/* Compute root node of the top-most subtree. */
    45	void merkle_gen_root(unsigned char *root, const spx_ctx *ctx)
    46	{
    47	    /* We do not need the auth path in key generation, but it simplifies the
    48	       code to have just one treehash routine that computes both root and path
    49	       in one function. */
    50	    unsigned char auth_path[SPX_TREE_HEIGHT * SPX_N + SPX_WOTS_BYTES];
    51	    uint32_t top_tree_addr[8] = {0};
    52	    uint32_t wots_addr[8] = {0};
    53	
    54	    set_layer_addr(top_tree_addr, SPX_D - 1);
    55	    set_layer_addr(wots_addr, SPX_D - 1);
    56	
    57	    merkle_sign(auth_path, root, ctx,
    58	                wots_addr, top_tree_addr,
    59	                (uint32_t)~0 /* ~0 means "don't bother generating an auth path */ );
    60	}
