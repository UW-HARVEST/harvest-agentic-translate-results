    19	void prf_addr(unsigned char *out, const spx_ctx *ctx,
    20	              const uint32_t addr[8])
    21	{
    22	    /* Since SPX_N may be smaller than 32, we need temporary buffers. */
    23	    unsigned char outbuf[32];
    24	    unsigned char buf[64] = {0};
    25	
