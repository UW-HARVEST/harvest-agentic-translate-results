    33	/**
    34	 * Computes the message-dependent randomness R, using a secret seed and an
    35	 * optional randomization value as well as the message.
    36	 */
    37	void gen_message_random(unsigned char *R, const unsigned char* sk_prf,
    38	                        const unsigned char *optrand,
    39	                        const unsigned char *m, unsigned long long mlen,
    40	                        const spx_ctx *ctx)
    41	{
    42	    uint8_t s_inc[65];
    43	
    44	    haraka_S_inc_init(s_inc);
    45	    haraka_S_inc_absorb(s_inc, sk_prf, SPX_N, ctx);
    46	    haraka_S_inc_absorb(s_inc, optrand, SPX_N, ctx);
    47	    haraka_S_inc_absorb(s_inc, m, mlen, ctx);
    48	    haraka_S_inc_finalize(s_inc);
    49	    haraka_S_inc_squeeze(R, SPX_N, s_inc, ctx);
    50	}
    51	
    52	/**
    53	 * Computes the message hash using R, the public key, and the message.
    54	 * Outputs the message digest and the index of the leaf. The index is split in
    55	 * the tree index and the leaf index, for convenient copying to an address.
    56	 */
    57	void hash_message(unsigned char *digest, uint64_t *tree, uint32_t *leaf_idx,
    58	                  const unsigned char *R, const unsigned char *pk,
    59	                  const unsigned char *m, unsigned long long mlen,
    60	                  const spx_ctx *ctx)
    61	{
    62	#define SPX_TREE_BITS (SPX_TREE_HEIGHT * (SPX_D - 1))
    63	#define SPX_TREE_BYTES ((SPX_TREE_BITS + 7) / 8)
    64	#define SPX_LEAF_BITS SPX_TREE_HEIGHT
    65	#define SPX_LEAF_BYTES ((SPX_LEAF_BITS + 7) / 8)
    66	#define SPX_DGST_BYTES (SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES)
    67	
    68	    unsigned char buf[SPX_DGST_BYTES];
