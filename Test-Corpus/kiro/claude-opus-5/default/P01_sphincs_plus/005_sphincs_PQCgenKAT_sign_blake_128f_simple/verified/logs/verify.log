     9	/**
    10	 * Converts the value of 'in' to 'outlen' bytes in big-endian byte order.
    11	 */
    12	void ull_to_bytes(unsigned char *out, unsigned int outlen,
    13	                  unsigned long long in)
    14	{
    15	    int i;
    16	
    17	    /* Iterate over out in decreasing order, for big-endianness. */
    18	    for (i = (signed int)outlen - 1; i >= 0; i--) {
    19	        out[i] = in & 0xff;
    20	        in = in >> 8;
    21	    }
    22	}
    23	
    24	void u32_to_bytes(unsigned char *out, uint32_t in)
    25	{
    26	    out[0] = (unsigned char)(in >> 24);
    27	    out[1] = (unsigned char)(in >> 16);
    28	    out[2] = (unsigned char)(in >> 8);
    29	    out[3] = (unsigned char)in;
    30	}
    31	
    32	/**
    33	 * Converts the inlen bytes in 'in' from big-endian byte order to an integer.
    34	 */
    35	unsigned long long bytes_to_ull(const unsigned char *in, unsigned int inlen)
    36	{
    37	    unsigned long long retval = 0;
    38	    unsigned int i;
    39	
    40	    for (i = 0; i < inlen; i++) {
    41	        retval |= ((unsigned long long)in[i]) << (8*(inlen - 1 - i));
    42	    }
    43	    return retval;
    44	}
    45	
    46	/**
    47	 * Computes a root node given a leaf and an auth path.
    48	 * Expects address to be complete other than the tree_height and tree_index.
    49	 */
    50	void compute_root(unsigned char *root, const unsigned char *leaf,
    51	                  uint32_t leaf_idx, uint32_t idx_offset,
    52	                  const unsigned char *auth_path, uint32_t tree_height,
    53	                  const spx_ctx *ctx, uint32_t addr[8])
    54	{
    55	    uint32_t i;
    56	    unsigned char buffer[2 * SPX_N];
    57	
    58	    /* If leaf_idx is odd (last bit = 1), current path element is a right child
    59	       and auth_path has to go left. Otherwise it is the other way around. */
    60	    if (leaf_idx & 1) {
    61	        memcpy(buffer + SPX_N, leaf, SPX_N);
    62	        memcpy(buffer, auth_path, SPX_N);
    63	    }
    64	    else {
    65	        memcpy(buffer, leaf, SPX_N);
    66	        memcpy(buffer + SPX_N, auth_path, SPX_N);
    67	    }
    68	    auth_path += SPX_N;
    69	
    70	    for (i = 0; i < tree_height - 1; i++) {
    71	        leaf_idx >>= 1;
    72	        idx_offset >>= 1;
    73	        /* Set the address of the node we're creating. */
    74	        set_tree_height(addr, i + 1);
    75	        set_tree_index(addr, leaf_idx + idx_offset);
    76	
    77	        /* Pick the right or left neighbor, depending on parity of the node. */
    78	        if (leaf_idx & 1) {
    79	            thash(buffer + SPX_N, buffer, 2, ctx, addr);
    80	            memcpy(buffer, auth_path, SPX_N);
    81	        }
    82	        else {
    83	            thash(buffer, buffer, 2, ctx, addr);
    84	            memcpy(buffer + SPX_N, auth_path, SPX_N);
    85	        }
    86	        auth_path += SPX_N;
    87	    }
    88	
    89	    /* The last iteration is exceptional; we do not copy an auth_path node. */
    90	    leaf_idx >>= 1;
    91	    idx_offset >>= 1;
    92	    set_tree_height(addr, tree_height);
    93	    set_tree_index(addr, leaf_idx + idx_offset);
    94	    thash(root, buffer, 2, ctx, addr);
    95	}
    96	
    97	/**
    98	 * For a given leaf index, computes the authentication path and the resulting
    99	 * root node using Merkle's TreeHash algorithm.
   100	 * Expects the layer and tree parts of the tree_addr to be set, as well as the
   101	 * tree type (i.e. SPX_ADDR_TYPE_HASHTREE or SPX_ADDR_TYPE_FORSTREE).
   102	 * Applies the offset idx_offset to indices before building addresses, so that
   103	 * it is possible to continue counting indices across trees.
   104	 */
   105	void treehash(unsigned char *root, unsigned char *auth_path, const spx_ctx* ctx,
   106	              uint32_t leaf_idx, uint32_t idx_offset, uint32_t tree_height,
   107	              void (*gen_leaf)(
   108	                 unsigned char* /* leaf */,
   109	                 const spx_ctx* /* ctx */,
   110	                 uint32_t /* addr_idx */, const uint32_t[8] /* tree_addr */),
   111	              uint32_t tree_addr[8])
   112	{
   113	    SPX_VLA(uint8_t, stack, (tree_height+1)*SPX_N);
   114	    SPX_VLA(unsigned int, heights, tree_height+1);
   115	    unsigned int offset = 0;
   116	    uint32_t idx;
   117	    uint32_t tree_idx;
   118	
   119	    for (idx = 0; idx < (uint32_t)(1 << tree_height); idx++) {
   120	        /* Add the next leaf node to the stack. */
   121	        gen_leaf(stack + offset*SPX_N, ctx, idx + idx_offset, tree_addr);
   122	        offset++;
   123	        heights[offset - 1] = 0;
   124	
   125	        /* If this is a node we need for the auth path.. */
   126	        if ((leaf_idx ^ 0x1) == idx) {
   127	            memcpy(auth_path, stack + (offset - 1)*SPX_N, SPX_N);
   128	        }
   129	
   130	        /* While the top-most nodes are of equal height.. */
   131	        while (offset >= 2 && heights[offset - 1] == heights[offset - 2]) {
   132	            /* Compute index of the new node, in the next layer. */
   133	            tree_idx = (idx >> (heights[offset - 1] + 1));
   134	
   135	            /* Set the address of the node we're creating. */
   136	            set_tree_height(tree_addr, heights[offset - 1] + 1);
   137	            set_tree_index(tree_addr,
   138	                           tree_idx + (idx_offset >> (heights[offset-1] + 1)));
   139	            /* Hash the top-most nodes from the stack together. */
   140	            thash(stack + (offset - 2)*SPX_N,
   141	                  stack + (offset - 2)*SPX_N, 2, ctx, tree_addr);
   142	            offset--;
   143	            /* Note that the top-most node is now one layer higher. */
   144	            heights[offset - 1]++;
   145	
   146	            /* If this is a node we need for the auth path.. */
   147	            if (((leaf_idx >> heights[offset - 1]) ^ 0x1) == tree_idx) {
   148	                memcpy(auth_path + heights[offset - 1]*SPX_N,
   149	                       stack + (offset - 1)*SPX_N, SPX_N);
   150	            }
   151	        }
   152	    }
   153	    memcpy(root, stack, SPX_N);
   154	}
