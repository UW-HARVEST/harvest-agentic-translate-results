    48	/*
    49	 * Generates an SPX key pair given a seed of length
    50	 * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]
    51	 * Format pk: [PUB_SEED || root]
    52	 */
    53	int crypto_sign_seed_keypair(unsigned char *pk, unsigned char *sk,
    54	                             const unsigned char *seed)
    55	{
    56	    spx_ctx ctx;
    57	
    58	    /* Initialize SK_SEED, SK_PRF and PUB_SEED from seed. */
    59	    memcpy(sk, seed, CRYPTO_SEEDBYTES);
    60	
    61	    memcpy(pk, sk + 2*SPX_N, SPX_N);
    62	
    63	    memcpy(ctx.pub_seed, pk, SPX_N);
    64	    memcpy(ctx.sk_seed, sk, SPX_N);
    65	
    66	    /* This hook allows the hash function instantiation to do whatever
    67	       preparation or computation it needs, based on the public seed. */
    68	    initialize_hash_function(&ctx);
    69	
    70	    /* Compute root node of the top-most subtree. */
    71	    merkle_gen_root(sk + 3*SPX_N, &ctx);
    72	
    73	    memcpy(pk + SPX_N, sk + 3*SPX_N, SPX_N);
    74	
    75	    return 0;
    76	}
    77	
    78	/*
    79	 * Generates an SPX key pair.
    80	 * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]
    81	 * Format pk: [PUB_SEED || root]
    82	 */
    83	int crypto_sign_keypair(unsigned char *pk, unsigned char *sk)
    84	{
    85	  unsigned char seed[CRYPTO_SEEDBYTES];
    86	  randombytes(seed, CRYPTO_SEEDBYTES);
    87	  crypto_sign_seed_keypair(pk, sk, seed);
    88	
    89	  return 0;
    90	}
