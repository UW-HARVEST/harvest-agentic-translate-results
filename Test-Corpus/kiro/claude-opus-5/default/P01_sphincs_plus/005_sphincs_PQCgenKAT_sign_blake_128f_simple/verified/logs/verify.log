   243	/**
   244	 * Returns an array containing the signature followed by the message.
   245	 */
   246	int crypto_sign(unsigned char *sm, unsigned long long *smlen,
   247	                const unsigned char *m, unsigned long long mlen,
   248	                const unsigned char *sk)
   249	{
   250	    size_t siglen;
   251	
   252	    crypto_sign_signature(sm, &siglen, m, (size_t)mlen, sk);
   253	
   254	    memmove(sm + SPX_BYTES, m, mlen);
   255	    *smlen = siglen + mlen;
   256	
   257	    return 0;
   258	}
   259	
   260	/**
   261	 * Verifies a given signature-message pair under a given public key.
   262	 */
   263	int crypto_sign_open(unsigned char *m, unsigned long long *mlen,
   264	                     const unsigned char *sm, unsigned long long smlen,
   265	                     const unsigned char *pk)
   266	{
   267	    /* The API caller does not necessarily know what size a signature should be
   268	       but SPHINCS+ signatures are always exactly SPX_BYTES. */
   269	    if (smlen < SPX_BYTES) {
   270	        memset(m, 0, smlen);
   271	        *mlen = 0;
   272	        return -1;
   273	    }
   274	
   275	    *mlen = smlen - SPX_BYTES;
   276	
   277	    if (crypto_sign_verify(sm, SPX_BYTES, sm + SPX_BYTES, (size_t)*mlen, pk)) {
   278	        memset(m, 0, smlen);
   279	        *mlen = 0;
   280	        return -1;
   281	    }
   282	
   283	    /* If verification was successful, move the message to the right place. */
   284	    memmove(m, sm + SPX_BYTES, *mlen);
   285	
   286	    return 0;
   287	}
