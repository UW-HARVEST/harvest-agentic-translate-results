    42	
    43	/**
    44	 * Interprets m as SPX_FORS_HEIGHT-bit unsigned integers.
    45	 * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.
    46	 * Assumes indices has space for SPX_FORS_TREES integers.
    47	 */
    48	static void message_to_indices(uint32_t *indices, const unsigned char *m)
    49	{
    50	    unsigned int i, j;
    51	    unsigned int offset = 0;
    52	
    53	    for (i = 0; i < SPX_FORS_TREES; i++) {
    54	        indices[i] = 0;
    55	        for (j = 0; j < SPX_FORS_HEIGHT; j++) {
    56	            indices[i] ^= ((m[offset >> 3] >> (offset & 0x7)) & 1u) << j;
    57	            offset++;
    58	        }
    59	    }
    60	}
    61	
    62	/**
    63	 * Signs a message m, deriving the secret key from sk_seed and the FTS address.
    64	 * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.
    65	 */
    66	void fors_sign(unsigned char *sig, unsigned char *pk,
    67	               const unsigned char *m,
    68	               const spx_ctx *ctx,
    69	               const uint32_t fors_addr[8])
    70	{
    71	    uint32_t indices[SPX_FORS_TREES];
    72	    unsigned char roots[SPX_FORS_TREES * SPX_N];
    73	    uint32_t fors_tree_addr[8] = {0};
    74	    struct fors_gen_leaf_info fors_info = {0};
    75	    uint32_t *fors_leaf_addr = fors_info.leaf_addrx;
    76	    uint32_t fors_pk_addr[8] = {0};
    77	    uint32_t idx_offset;
    78	    unsigned int i;
    79	
    80	    copy_keypair_addr(fors_tree_addr, fors_addr);
    81	    copy_keypair_addr(fors_leaf_addr, fors_addr);
    82	
    83	    copy_keypair_addr(fors_pk_addr, fors_addr);
    84	    set_type(fors_pk_addr, SPX_ADDR_TYPE_FORSPK);
    85	
    86	    message_to_indices(indices, m);
    87	
    88	    for (i = 0; i < SPX_FORS_TREES; i++) {
    89	        idx_offset = i * (1 << SPX_FORS_HEIGHT);
    90	
    91	        set_tree_height(fors_tree_addr, 0);
    92	        set_tree_index(fors_tree_addr, indices[i] + idx_offset);
    93	        set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSPRF);
    94	
    95	        /* Include the secret key part that produces the selected leaf node. */
    96	        fors_gen_sk(sig, ctx, fors_tree_addr);
    97	        set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);
    98	        sig += SPX_N;
    99	
   100	        /* Compute the authentication path for this leaf node. */
   101	        fors_treehashx1(roots + i*SPX_N, sig, ctx,
   102	                 indices[i], idx_offset, SPX_FORS_HEIGHT,
   103	                 fors_tree_addr, &fors_info);
   104	
   105	        sig += SPX_N * SPX_FORS_HEIGHT;
   106	    }
   107	
   108	    /* Hash horizontally across all tree roots to derive the public key. */
   109	    thash(pk, roots, SPX_FORS_TREES, ctx, fors_pk_addr);
   110	}
   111	
   112	/**
   113	 * Derives the FORS public key from a signature.
   114	 * This can be used for verification by comparing to a known public key, or to
   115	 * subsequently verify a signature on the derived public key. The latter is the
   116	 * typical use-case when used as an FTS below an OTS in a hypertree.
   117	 * Assumes m contains at least SPX_FORS_HEIGHT * SPX_FORS_TREES bits.
   118	 */
   119	void fors_pk_from_sig(unsigned char *pk,
   120	                      const unsigned char *sig, const unsigned char *m,
   121	                      const spx_ctx* ctx,
   122	                      const uint32_t fors_addr[8])
   123	{
   124	    uint32_t indices[SPX_FORS_TREES];
   125	    unsigned char roots[SPX_FORS_TREES * SPX_N];
   126	    unsigned char leaf[SPX_N];
   127	    uint32_t fors_tree_addr[8] = {0};
   128	    uint32_t fors_pk_addr[8] = {0};
   129	    uint32_t idx_offset;
   130	    unsigned int i;
   131	
   132	    copy_keypair_addr(fors_tree_addr, fors_addr);
   133	    copy_keypair_addr(fors_pk_addr, fors_addr);
   134	
   135	    set_type(fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);
   136	    set_type(fors_pk_addr, SPX_ADDR_TYPE_FORSPK);
   137	
   138	    message_to_indices(indices, m);
   139	
   140	    for (i = 0; i < SPX_FORS_TREES; i++) {
   141	        idx_offset = i * (1 << SPX_FORS_HEIGHT);
   142	
   143	        set_tree_height(fors_tree_addr, 0);
   144	        set_tree_index(fors_tree_addr, indices[i] + idx_offset);
   145	
   146	        /* Derive the leaf from the included secret key part. */
   147	        fors_sk_to_leaf(leaf, sig, ctx, fors_tree_addr);
   148	        sig += SPX_N;
   149	
   150	        /* Derive the corresponding root node of this tree. */
   151	        compute_root(roots + i*SPX_N, leaf, indices[i], idx_offset,
   152	                     sig, SPX_FORS_HEIGHT, ctx, fors_tree_addr);
   153	        sig += SPX_N * SPX_FORS_HEIGHT;
   154	    }
   155	
   156	    /* Hash horizontally across all tree roots to derive the public key. */
   157	    thash(pk, roots, SPX_FORS_TREES, ctx, fors_pk_addr);
   158	}
