    11	/**
    12	 * Takes an array of inblocks concatenated arrays of SPX_N bytes.
    13	 */
    14	void thash(unsigned char *out, const unsigned char *in, unsigned int inblocks,
    15	           const spx_ctx *ctx, uint32_t addr[8])
    16	{
    17	    SPX_VLA(uint8_t, buf, SPX_ADDR_BYTES + inblocks*SPX_N);
    18	    unsigned char outbuf[32];
    19	    unsigned char buf_tmp[64];
    20	
    21	    if (inblocks == 1) {
    22	        /* F function */
    23	        /* Since SPX_N may be smaller than 32, we need a temporary buffer. */
    24	        memset(buf_tmp, 0, 64);
    25	        memcpy(buf_tmp, addr, 32);
    26	        memcpy(buf_tmp + SPX_ADDR_BYTES, in, SPX_N);
    27	
    28	        haraka512(outbuf, buf_tmp, ctx);
    29	        memcpy(out, outbuf, SPX_N);
    30	    } else {
    31	        /* All other tweakable hashes*/
    32	        memcpy(buf, addr, 32);
    33	        memcpy(buf + SPX_ADDR_BYTES, in, inblocks * SPX_N);
    34	
    35	        haraka_S(out, SPX_N, buf, SPX_ADDR_BYTES + inblocks*SPX_N, ctx);
    36	    }
    37	}
