    18	/*
    19	 * Computes PRF(pk_seed, sk_seed, addr)
    20	 */
    21	void prf_addr(unsigned char *out, const spx_ctx *ctx,
    22	              const uint32_t addr[8])
    23	{
    24	    unsigned char buf[2*SPX_N + SPX_ADDR_BYTES];
    25	
    26	    memcpy(buf, ctx->pub_seed, SPX_N);
    27	    memcpy(buf + SPX_N, addr, SPX_ADDR_BYTES);
    28	    memcpy(buf + SPX_N + SPX_ADDR_BYTES, ctx->sk_seed, SPX_N);
    29	
    30	    shake256(out, SPX_N, buf, 2*SPX_N + SPX_ADDR_BYTES);
    31	}
    32	
    33	/**
    34	 * Computes the message-dependent randomness R, using a secret seed and an
    35	 * optional randomization value as well as the message.
    36	 */
    37	void gen_message_random(unsigned char *R, const unsigned char *sk_prf,
    38	                        const unsigned char *optrand,
    39	                        const unsigned char *m, unsigned long long mlen,
    40	                        const spx_ctx *ctx)
    41	{
    42	    (void)ctx;
    43	    uint64_t s_inc[26];
    44	
    45	    shake256_inc_init(s_inc);
    46	    shake256_inc_absorb(s_inc, sk_prf, SPX_N);
    47	    shake256_inc_absorb(s_inc, optrand, SPX_N);
    48	    shake256_inc_absorb(s_inc, m, mlen);
    49	    shake256_inc_finalize(s_inc);
    50	    shake256_inc_squeeze(R, SPX_N, s_inc);
    51	}
    52	
    53	/**
    54	 * Computes the message hash using R, the public key, and the message.
    55	 * Outputs the message digest and the index of the leaf. The index is split in
    56	 * the tree index and the leaf index, for convenient copying to an address.
    57	 */
    58	void hash_message(unsigned char *digest, uint64_t *tree, uint32_t *leaf_idx,
    59	                  const unsigned char *R, const unsigned char *pk,
    60	                  const unsigned char *m, unsigned long long mlen,
    61	                  const spx_ctx *ctx)
    62	{
    63	    (void)ctx;
    64	#define SPX_TREE_BITS (SPX_TREE_HEIGHT * (SPX_D - 1))
    65	#define SPX_TREE_BYTES ((SPX_TREE_BITS + 7) / 8)
    66	#define SPX_LEAF_BITS SPX_TREE_HEIGHT
    67	#define SPX_LEAF_BYTES ((SPX_LEAF_BITS + 7) / 8)
    68	#define SPX_DGST_BYTES (SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES)
    69	
    70	    unsigned char buf[SPX_DGST_BYTES];
    71	    unsigned char *bufp = buf;
    72	    uint64_t s_inc[26];
    73	
    74	    shake256_inc_init(s_inc);
    75	    shake256_inc_absorb(s_inc, R, SPX_N);
    76	    shake256_inc_absorb(s_inc, pk, SPX_PK_BYTES);
    77	    shake256_inc_absorb(s_inc, m, mlen);
    78	    shake256_inc_finalize(s_inc);
    79	    shake256_inc_squeeze(buf, SPX_DGST_BYTES, s_inc);
    80	
    81	    memcpy(digest, bufp, SPX_FORS_MSG_BYTES);
    82	    bufp += SPX_FORS_MSG_BYTES;
    83	
    84	#if SPX_TREE_BITS > 64
    85	    #error For given height and depth, 64 bits cannot represent all subtrees
    86	#endif
    87	
    88	    if (SPX_D == 1) {
    89	        *tree = 0;
    90	    } else {
    91	        *tree = bytes_to_ull(bufp, SPX_TREE_BYTES);
    92	        *tree &= (~(uint64_t)0) >> (64 - SPX_TREE_BITS);
    93	    }
    94	    bufp += SPX_TREE_BYTES;
    95	
    96	    *leaf_idx = (uint32_t)bytes_to_ull(bufp, SPX_LEAF_BYTES);
    97	    *leaf_idx &= (~(uint32_t)0) >> (32 - SPX_LEAF_BITS);
    98	}
