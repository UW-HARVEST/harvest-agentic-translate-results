import os, random, subprocess, sys, shutil, itertools

W = "/local/home/scheschb/.harvest/work/harvest-work-1BF2Nq"
os.makedirs("/tmp/cdir", exist_ok=True)
os.makedirs("/tmp/rdir", exist_ok=True)
shutil.copyfile(W + "/c_src/build/driver", "/tmp/cdir/driver"); os.chmod("/tmp/cdir/driver", 0o755)
shutil.copyfile(W + "/translation/target/release/driver", "/tmp/rdir/driver"); os.chmod("/tmp/rdir/driver", 0o755)

def run(d, args):
    p = subprocess.run([b"./driver"] + args, cwd=d, capture_output=True)
    return (p.returncode, p.stdout, p.stderr)

mismatch = 0
def check(args):
    global mismatch
    a = run("/tmp/cdir", args)
    b = run("/tmp/rdir", args)
    if a != b:
        mismatch += 1
