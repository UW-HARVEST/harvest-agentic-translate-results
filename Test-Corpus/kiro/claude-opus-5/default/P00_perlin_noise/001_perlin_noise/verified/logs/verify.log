import re
c = open('c_src/src/stb_perlin.h').read()
r = open('translation/src/stb_perlin.rs').read()

def cnums(name):
    i = c.index(name + '[512] =')
    body = c[c.index('{', i)+1 : c.index('};', i)]
    body = re.sub(r'//.*', '', body)
    return [int(x) for x in re.findall(r'-?\d+', body)]

def rnums(name):
    i = r.index(name + ': [u8; 256] = [')
    body = r[r.index('[', r.index('=', i)) + 1 : r.index('];', i)]
    return [int(x) for x in re.findall(r'-?\d+', body)]

for cn, rn in [('stb__perlin_randtab','RANDTAB_BASE'),
               ('stb__perlin_randtab_grad_idx','RANDTAB_GRAD_IDX_BASE')]:
    cv, rv = cnums(cn), rnums(rn)
    assert len(cv) == 512, (cn, len(cv))
    assert len(rv) == 256, (rn, len(rv))
    print(cn, "C len", len(cv), "| halves identical:", cv[:256] == cv[256:],
          "| rust == C first half:", rv == cv[:256])

# basis[12][4]
