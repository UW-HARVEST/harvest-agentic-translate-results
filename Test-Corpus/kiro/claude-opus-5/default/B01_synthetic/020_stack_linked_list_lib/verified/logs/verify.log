[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m     // Allocate n boxes, then decide a random permutation `order` such that
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m     // order[k] is the box index used for the k-th visited node.
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     let mut boxes: Vec<Box<ListNode>> = (0..n).map(|_| Box::new(ListNode::new(0))).collect();
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m     let mut order: Vec<usize> = (0..n).collect();
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m     // Fisher-Yates with the seeded PRNG.
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     for i in (1..n).rev() {
