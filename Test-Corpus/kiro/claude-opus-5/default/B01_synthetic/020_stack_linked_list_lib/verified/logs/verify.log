[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m /// Individually heap-allocated nodes, chained in an order determined by the
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m /// PRNG so that traversal order is unrelated to allocation/address order.
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m fn chain_shuffled_boxes(values: &[c_int], rng: &mut Rng) -> Chain {
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     let n = values.len();
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m     if n == 0 {
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m         return Chain {
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m             _storage: Storage::Boxes(Vec::new()),
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m             head: std::ptr::null_mut(),
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m         };
