[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m         (lo as i64 + (self.next_u64() % span) as i64) as i32
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m /// Number of randomized inputs per configuration row.
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m const ITERS: usize = 400;
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m // The core differential assertion
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m /// Calls BOTH `.so` exports on the same head pointer and asserts the returned
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m /// bytes are identical. Also re-runs in the opposite order to prove neither
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m /// implementation mutated the list.
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m #[track_caller]
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m fn assert_same(head: *mut ListNode, ctx: &str) -> c_int {
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m     let im = impls();
