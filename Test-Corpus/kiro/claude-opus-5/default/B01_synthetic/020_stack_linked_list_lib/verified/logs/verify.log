[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m     for (k, &v) in values.iter().enumerate() {
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m         boxes[order[k]].value = v;
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     for k in 0..n - 1 {
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m         let next_ptr: *mut ListNode = &mut *boxes[order[k + 1]] as *mut ListNode;
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m         boxes[order[k]].next = next_ptr;
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m     let head: *mut ListNode = &mut *boxes[order[0]] as *mut ListNode;
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     Chain {
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         _storage: Storage::Boxes(boxes),
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         head,
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m // Deterministic PRNG (fixed seed, SplitMix64) — reproducible property tests
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m struct Rng(u64);
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m impl Rng {
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m     fn new(seed: u64) -> Self {
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         Rng(seed)
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m     fn next_u64(&mut self) -> u64 {
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m         self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m         let mut z = self.0;
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m         z ^ (z >> 31)
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m     fn i32(&mut self) -> c_int {
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         self.next_u64() as u32 as i32
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m     /// Uniform in `[lo, hi]`.
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m     fn range(&mut self, lo: u64, hi: u64) -> u64 {
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m         debug_assert!(lo <= hi);
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         lo + self.next_u64() % (hi - lo + 1)
