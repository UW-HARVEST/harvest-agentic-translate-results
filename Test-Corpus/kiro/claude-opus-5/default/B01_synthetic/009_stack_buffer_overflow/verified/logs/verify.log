import random, subprocess, os
C="./c_src/build/driver"; R="./translation/target/release/driver"
def run(b, inp):
    p=subprocess.run([b], input=inp, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return p.stdout, p.stderr, p.returncode
random.seed(20250830)
alpha = b"0123456789 \t\r\n+-abcXZ.\x00\xff/:*"
cases=[]
for _ in range(500):
    n=random.randint(0,34)
    cases.append(bytes(random.choice(alpha) for _ in range(n)))
# plus structured numeric pairs
for _ in range(200):
    a=random.randint(-50,2000); b=random.randint(-50,2000)
    cases.append(f"{a}\n{b}\n".encode())
mismatch=[]; flaky=0
for inp in cases:
    co,ce,cs = run(C,inp); ro,re_,rs = run(R,inp)
    if (co,ce,cs)==(ro,re_,rs): continue
    # re-run C 5x: if C itself disagrees with itself, it's the ASLR band
    results={run(C,inp)[2] for _ in range(5)}
    if len(results)>1: flaky+=1; continue
    mismatch.append((inp,(cs,co,ce),(rs,ro,re_)))
print(f"cases={len(cases)} real_mismatches={len(mismatch)} c_selfinconsistent={flaky}")
for inp,c,r in mismatch[:8]:
    print(" IN",inp[:40],"\n   C",c[0],c[1][-40:],c[2][:40],"\n   R",r[0],r[1][-40:],r[2][:40])
