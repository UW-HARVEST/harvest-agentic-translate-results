import random, subprocess, os, sys
C=os.environ['PWD']+"/c_src/build/driver"; R=os.environ['PWD']+"/translation/target/release/driver"
def run(b, data):
    p=subprocess.run([b], input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return p.stdout, p.stderr, p.returncode
random.seed(20260901)
# Deterministic index classes only for the bad sink; any value for the good sink.
safe_bad = list(range(0,49)) + [100000, 1000000, 5000000, 50000000]
alphabet = b"0123456789+- \t\r\nabcxX.,\x00\xff"
cases=[]
for _ in range(500):
    n = random.choice(safe_bad)
    first = bytes(random.choice(alphabet) for _ in range(random.randint(0,20)))
    first = first.replace(b"\n", b"")   # keep line framing predictable
    cases.append(first + b"\n" + str(n).encode() + b"\n")
for _ in range(200):
    cases.append(bytes(random.choice(b"0123456789") for _ in range(random.randint(0,3))) + b"\n" + str(random.choice(safe_bad)).encode() + b"\n")
for _ in range(100):   # pure random bytes: whatever they parse to, both must agree
    raw = bytes(random.getrandbits(8) for _ in range(random.randint(0,40)))
    # only keep if the bad-sink index would be deterministic
    cases.append(raw)
bad=0; checked=0
for data in cases:
    co,ce,cr = run(C,data)
    ro,re,rr = run(R,data)
    if (co,ce,cr)!=(ro,re,rr):
        # A random-byte case may land in the nondeterministic band; re-check C twice.
        c2 = run(C,data); c3 = run(C,data)
        if c2!=(co,ce,cr) or c3!=(co,ce,cr):
            continue   # C disagrees with itself: inherent UB band, not a translation bug
        bad+=1
        if bad<=5: print("MISMATCH", data[:40], "C",cr,len(co), "R",rr,len(ro))
    checked+=1
print(f"checked={checked} mismatches={bad}")
