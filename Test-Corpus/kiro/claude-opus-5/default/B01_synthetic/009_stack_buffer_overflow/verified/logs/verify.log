[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m     assert_eq!(c.code, Some(0), "C reference should exit 0 on a benign input");
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m     assert_eq!(r.code, Some(0), "Rust should exit 0 on a benign input");
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m     assert!(!c.stdout.is_empty(), "C should produce output");
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m     assert_eq!(c.stdout, r.stdout);
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m // Phase B: the source-level branches
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m /// `fgets` returns NULL in *both* call sites: "fgets() failed." twice, then
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m /// data stays -1, so goodB2G takes its out-of-bounds branch and bad() takes its
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m /// negative branch.
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m fn empty_input_hits_both_fgets_failure_paths() {
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m     assert_identical(b"");
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m /// One line only: goodB2G consumes it, then bad()'s fgets hits EOF.
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m fn single_line_then_eof_in_bad() {
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     assert_identical(b"5");
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     assert_identical(b"5\n");
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     assert_identical(b"0\n");
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m     assert_identical(b"9\n");
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m /// Every in-bounds index, in both the good sink and the bad sink.
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m fn every_in_bounds_index() {
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     for n in 0..10 {
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m         assert_identical(&two_lines(&n.to_string(), n));
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m /// The negative branch of `bad()` ("ERROR: Array index is negative.") and the
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m /// out-of-bounds branch of `goodB2G` ("ERROR: Array index is out-of-bounds").
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m fn negative_and_out_of_bounds_error_branches() {
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     for first in ["-1", "-2", "-2147483648", "10", "99", "abc"] {
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m         for second in ["-1", "-7", "-2147483648"] {
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m             assert_identical(format!("{first}\n{second}\n").as_bytes());
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m /// goodB2G rejects >= 10 while bad() accepts it: the asymmetry between the two
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m /// sinks, checked at the boundary.
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m fn good_sink_boundary_at_ten() {
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m     for n in [8, 9, 10, 11] {
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m         assert_identical(&two_lines(&n.to_string(), 0));
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m // Phase B: atoi() surface
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m fn atoi_accepted_and_rejected_forms() {
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m     let forms = [
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m         "0", "9", "00", "007", "+5", "-0", "--5", "+-5", " 7", "  7", "\t3", "\r5", "5\r", "7abc",
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         "0x10", "abc", "", " ", "   ", ".5", "5.9", "1e3", "-", "+", "9,9",
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m     for f in forms {
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         assert_identical(format!("{f}\n{f}\n").as_bytes());
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m /// `inputBuffer` is 14 bytes, so at most 13 digits reach `atoi`. `strtol`
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m /// therefore cannot overflow, but the narrowing to `int` can and does.
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m fn atoi_int_truncation() {
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     let values = [
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         "2147483647",    // INT_MAX
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m         "-2147483648",   // INT_MIN
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m         "2147483648",    // wraps negative
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         "4294967296",    // -> 0
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         "4294967306",    // -> 10, an out-of-bounds index via truncation
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m         "1234567890123", // 13 digits, truncates to 1912239307
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         "9999999999999", // 13 nines
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         "-999999999999",
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         "-000000000001",
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m     for v in values {
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m         assert_identical(format!("{v}\n{v}\n").as_bytes());
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m /// A NUL byte terminates the C string that `atoi` sees, even though `fgets`
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m /// copied it.
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m fn embedded_nul_and_high_bytes() {
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m     assert_identical(b"\x005\n\x005\n");
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m     assert_identical(b"5\x009\n5\x009\n");
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m     assert_identical(b"\xff\xfe\n\xff\xfe\n");
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m     assert_identical(b"\x7f\n\x7f\n");
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m // Phase B: fgets() framing
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m /// `fgets(buf, 14, stdin)` takes at most 13 bytes and stops after a newline, so
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m /// a long line is split across the two call sites rather than being discarded.
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m fn fgets_splits_long_lines_across_call_sites() {
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m     assert_identical(b"1234567890123\n");          // exactly 13, newline left over
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m     assert_identical(b"12345678901234\n");          // 14: 13 taken, "4\n" left
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m     assert_identical(b"0000000000005\n");           // 13 chars, value 5
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m     assert_identical(b"00000000000009\n");          // splits into "0000000000000" + "9\n"
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m     assert_identical(b"1\n2\n3\n4\n");              // extra lines simply ignored
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m     assert_identical(b"\n\n");                      // two empty lines -> atoi("") twice
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m     assert_identical(b"\n");                        // one empty line, then EOF
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m     assert_identical(b"\n\n\n\n\n");
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m /// No trailing newline anywhere.
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m fn missing_trailing_newline() {
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m     assert_identical(b"4");
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m     assert_identical(b"0\n4");
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m     assert_identical(b"1234567890123");
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m // Phase C: the out-of-bounds write in bad(), slot by slot
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m /// `bad()` checks only `data >= 0`, so `buffer[data] = 1` on `int buffer[10]`
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m /// runs off the end. Indices 10..=15 land on dead locals and are absorbed;
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m /// 16..=19 hit `bad`'s saved frame pointer and return address, and 26..=27 hit
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m /// `main`'s return address, so the C dies of SIGSEGV having flushed nothing.
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m fn oob_write_slot_by_slot() {
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m     for n in 10..=48 {
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m         assert_identical(&two_lines("0", n));
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m /// The four indices that corrupt `bad`'s own saved %rbp / return address.
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m fn oob_indices_corrupting_bad_return() {
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m     for n in 16..=19 {
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m         assert_identical(&two_lines("0", n));
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m         let c = run(&c_binary(), &two_lines("0", n));
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m             c.killed_by_signal(),
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m             "C should be killed by a signal at index {n}, got {c:?}"
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m             c.stdout.is_empty(),
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m             "C's buffered stdout should be lost at index {n}, got {c:?}"
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m /// The two indices that corrupt `main`'s return address.
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m fn oob_indices_corrupting_main_return() {
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m     for n in 26..=27 {
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m         assert_identical(&two_lines("0", n));
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m         let c = run(&c_binary(), &two_lines("0", n));
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m             c.killed_by_signal(),
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m             "C should be killed by a signal at index {n}, got {c:?}"
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m         assert!(c.stdout.is_empty(), "C's stdout should be lost at index {n}");
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m /// The indices next to the crashing ones must still exit 0 with the normal
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m /// all-zero dump: an off-by-one in the model would show up here.
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m fn oob_indices_adjacent_to_crash_slots_are_absorbed() {
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m     for n in [10, 11, 12, 13, 14, 15, 20, 21, 22, 23, 24, 25, 28, 29, 30] {
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m         assert_identical(&two_lines("0", n));
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m         let c = run(&c_binary(), &two_lines("0", n));
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m         assert_eq!(c.code, Some(0), "index {n} should be absorbed, got {c:?}");
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m /// A wide sweep of the absorbed region above the frame, where the store lands
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m /// in the argv/env block.
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m fn oob_absorbed_region_sweep() {
