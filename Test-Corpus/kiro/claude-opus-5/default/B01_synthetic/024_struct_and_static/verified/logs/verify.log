import os, subprocess
C='c_src/build/driver'; R='translation/target/release/driver'
def closed_pipe(exe):
    r,w = os.pipe(); p = subprocess.Popen([exe], stdin=subprocess.DEVNULL, stdout=w, stderr=subprocess.PIPE)
    os.close(w); os.close(r); e=p.stderr.read(); p.wait(); return p.returncode, e
def closed_stdout(exe):
    devnull=os.open(os.devnull, os.O_RDONLY)
    p = subprocess.Popen([exe], stdin=subprocess.DEVNULL, stdout=devnull, stderr=subprocess.PIPE, close_fds=True,
                         preexec_fn=lambda: os.close(1))
    e=p.stderr.read(); p.wait(); os.close(devnull); return p.returncode, e
print("closed reader :", closed_pipe(C), closed_pipe(R))
print("stdout closed :", closed_stdout(C), closed_stdout(R))
# stdout to a full/unwritable target: /dev/full
def devfull(exe):
    fd=os.open('/dev/full', os.O_WRONLY)
    p=subprocess.Popen([exe], stdin=subprocess.DEVNULL, stdout=fd, stderr=subprocess.PIPE)
    e=p.stderr.read(); p.wait(); os.close(fd); return p.returncode, e
print("/dev/full     :", devfull(C), devfull(R))
