import os, subprocess, sys, time
def partial(exe):
    r, w = os.pipe()
    p = subprocess.Popen([exe], stdout=w, stderr=subprocess.PIPE)
    os.close(w)
    time.sleep(0.15)          # let the program run/buffer
    os.read(r, 5)             # consume only 5 bytes
    os.close(r)               # reader goes away mid-output
    err = p.communicate()[1]
    return p.returncode, err
for exe in sys.argv[1:]:
    rc, err = partial(exe)
    print(f"{os.path.basename(os.path.dirname(exe))}/{os.path.basename(exe)}: rc={rc} stderr={err!r}")
EOF
