import os, subprocess, sys, time
def chunks(exe):
    r, w = os.pipe()
    p = subprocess.Popen([exe], stdout=w)
    os.close(w)
    out = []
    while True:
        time.sleep(0.02)          # let writer get ahead so chunks reflect write() calls
        b = os.read(r, 65536)
        if not b: break
        out.append(len(b))
    os.close(r); p.wait()
    return out
for exe in sys.argv[1:]:
    print(f"{exe}: pipe read chunk sizes = {chunks(exe)}")
EOF
