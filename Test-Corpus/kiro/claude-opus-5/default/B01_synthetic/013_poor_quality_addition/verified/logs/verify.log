cat > /tmp/ptytest.py <<'EOF'
import os, pty, sys, subprocess
def run_tty(exe):
    m, s = pty.openpty()
    p = subprocess.Popen([exe], stdout=s, stderr=subprocess.PIPE)
    os.close(s)
    data = b""
    try:
        while True:
            b = os.read(m, 65536)
            if not b: break
            data += b
    except OSError:
        pass
    err = p.communicate()[1]
    os.close(m)
    return p.returncode, data, err
res = [run_tty(e) for e in sys.argv[1:]]
for e, (rc, d, err) in zip(sys.argv[1:], res):
    print(f"{e}: rc={rc} stdout={d!r} stderr={err!r}")
print("TTY MATCH:", res[0] == res[1])
EOF
