import random, subprocess, sys
C="./c_src/build/driver"; R="./translation/target/release/driver"
random.seed(1234)
alpha = b"0123456789+- \t\n\r\v\f.xXeE,abz\x00\xff\x80'"
def run(exe, data):
    p = subprocess.run([exe], input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return p.stdout, p.stderr, p.returncode
bad=0
cases=[]
for _ in range(4000):
    n = random.randint(0, 24)
    cases.append(bytes(random.choice(alpha) for _ in range(n)))
# structured numeric fuzz
for _ in range(2000):
    v = random.getrandbits(random.randint(1,80))
    s = ("-" if random.random()<0.5 else "") + str(v)
    cases.append(s.encode())
for data in cases:
    a=run(C,data); b=run(R,data)
    if a!=b:
        bad+=1
        print("DIFF", data, a, b)
        if bad>10: break
