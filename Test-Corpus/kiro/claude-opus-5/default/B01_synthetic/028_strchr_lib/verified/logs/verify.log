[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m                 let _ = unsafe { f(ptr, 0) };
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m             }, 30, None));
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         assert_eq!(
