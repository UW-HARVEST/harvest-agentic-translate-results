    27	//
    28	// The complete public ABI of the C shared library, as reported by
    29	// `nm -D libdriver.so` (defined, global symbols), is:
    30	//
    31	//     T driver
    32	//     T foo
    33	//
    34	// `foo` is not declared in include/driver.h, but it has external linkage in
    35	// src/driver.c and is therefore part of the exported ABI; it is reproduced here.
    36	
    37	use core::ffi::{c_char, c_int};
    38	
    39	unsafe extern "C" {
    40	    /// The C library formats its output with `printf` from libc. We reuse it
    41	    /// verbatim so that the produced bytes *and* the stdio stream buffering
    42	    /// behaviour are identical to the original library.
    43	    #[link_name = "printf"]
    44	    unsafe fn c_printf(fmt: *const c_char, ...) -> c_int;
    45	}
    46	
    47	/// Faithful reimplementation of C `strchr`.
    48	///
    49	/// Semantics preserved from the C standard / glibc:
    50	/// * the comparison is performed on `char`-sized values,
    51	/// * the terminating NUL is part of the searched string, so `strchr(s, 0)`
    52	///   returns a pointer to that terminator rather than NULL,
    53	/// * a NULL / invalid `s` is dereferenced, exactly as the C code would.
    54	///
    55	/// # Safety
    56	/// `s` must point to a NUL-terminated string (or, for bug-compatibility with
    57	/// the original, to whatever the caller passed).
    58	#[inline]
    59	unsafe fn strchr(mut s: *const c_char, c: c_char) -> *const c_char {
    60	    loop {
    61	        let v = unsafe { *s };
    62	        if v == c {
    63	            return s;
    64	        }
    65	        if v == 0 {
    66	            return core::ptr::null();
    67	        }
    68	        s = unsafe { s.add(1) };
    69	    }
    70	}
    71	
    72	/// ```c
    73	/// int foo(const char *in, char c) {
    74	///     int res = 0;
    75	///     for (const char *s = in; s = strchr(s, c); s++) {
    76	///         res++;
    77	///     }
    78	///     return res;
    79	/// }
    80	/// ```
    81	///
    82	/// Note: the original increments `s` past every match, including the case where
    83	/// `c == '\0'` and the match is the terminator (walking off the end of the
    84	/// buffer). That behaviour is intentionally reproduced rather than "fixed".
    85	#[unsafe(no_mangle)]
    86	pub unsafe extern "C" fn foo(in_: *const c_char, c: c_char) -> c_int {
    87	    let mut res: c_int = 0;
    88	    let mut s: *const c_char = in_;
    89	    loop {
    90	        s = unsafe { strchr(s, c) };
    91	        if s.is_null() {
    92	            break;
    93	        }
    94	        res = res.wrapping_add(1);
    95	        s = unsafe { s.add(1) };
    96	    }
    97	    res
    98	}
    99	
   100	/// ```c
   101	/// void driver(const char *in) {
   102	///     printf("A: %d\n", foo(in, 'A'));
   103	///     printf("x: %d\n", foo(in, 'x'));
   104	/// }
   105	/// ```
   106	#[unsafe(no_mangle)]
   107	pub unsafe extern "C" fn driver(in_: *const c_char) {
   108	    unsafe {
   109	        c_printf(c"A: %d\n".as_ptr(), foo(in_, b'A' as c_char));
   110	        c_printf(c"x: %d\n".as_ptr(), foo(in_, b'x' as c_char));
   111	    }
   112	}
