[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m // Phase C — the buffer-length paths, and inputs no earlier case reaches.
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m // `char in[100]` + `fgets(in, sizeof(in), stdin)` reads at most 99 bytes and
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m // does NOT read across a newline.
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m fn fgets_99_byte_boundary() {
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m     // 98 chars + '\n' == exactly the 99 bytes fgets will take.
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m     let mut a = vec![b'7'; 98];
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m     a.push(b'\n');
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m     assert_same("98 chars plus newline (exactly 99)", &a);
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m     // 99 chars + '\n': the newline is NOT read.
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m     let mut b = vec![b'8'; 99];
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m     b.push(b'\n');
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m     assert_same("99 chars plus newline (newline unread)", &b);
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m     // 100 chars: truncated at 99.
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m     assert_same("100 digits", &vec![b'9'; 100]);
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m     // A valid number whose digits are cut by the 99-byte limit: "1" * 120
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m     // truncates to 99 ones -> ERANGE -> error path.
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m     assert_same("120 ones truncated to 99", &vec![b'1'; 120]);
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m     // Value only becomes representable because of truncation.
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m     let mut c = b"1".to_vec();
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m     c.extend(std::iter::repeat(b'0').take(105));
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m     assert_same("1 followed by 105 zeros", &c);
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m     // Digits pushed past byte 99 by leading whitespace -> no conversion.
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m     let mut d = vec![b' '; 200];
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m     d.push(b'5');
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m     d.push(b'\n');
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m     assert_same("digits beyond the 99-byte window", &d);
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m     // Number that fits, padded with spaces up to and past the boundary.
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m     for pad in [96usize, 97, 98, 99, 100, 150] {
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m         let mut e = b"1".to_vec();
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m         e.extend(std::iter::repeat(b' ').take(pad));
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m         e.push(b'\n');
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m         assert_same(&format!("1 plus {pad} spaces"), &e);
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m     // Sign lands on the last readable byte.
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m     let mut f = vec![b' '; 98];
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m     f.push(b'-');
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m     f.extend_from_slice(b"5\n");
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m     assert_same("sign at the 99-byte boundary", &f);
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m     // INT_MAX sitting right at the truncation boundary.
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m     let mut g = vec![b' '; 89];
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m     g.extend_from_slice(b"2147483647\n");
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m     assert_same("INT_MAX ending at the boundary", &g);
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m fn fgets_does_not_read_across_newlines() {
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m     // Every one of these has a valid number on a later line only.
