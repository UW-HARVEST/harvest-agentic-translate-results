[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m     assert_same("sign, NUL, digits", b"-\x005\n");
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m     assert_same("NUL after full number", b"123\x00456\n");
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m }
