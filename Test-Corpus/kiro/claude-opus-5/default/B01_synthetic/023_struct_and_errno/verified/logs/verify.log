[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m /// Deterministic pseudo-random byte fuzz over the alphabet the parser cares
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m /// about, crossing the 99-byte buffer boundary.
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m fn randomized_differential_fuzz() {
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m     const ALPHABET: &[u8] = b"0123456789+- \t\n\r\x0b\x0c\x00abcxX.eE,;9";
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m     const LENGTHS: [usize; 14] = [0, 1, 2, 3, 5, 10, 50, 97, 98, 99, 100, 101, 120, 200];
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m     // xorshift64* — reproducible without a dependency.
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m     let mut state: u64 = 0x9E3779B97F4A7C15;
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m     let mut next = move || {
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m         state ^= state >> 12;
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m         state ^= state << 25;
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m         state ^= state >> 27;
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m         state.wrapping_mul(0x2545F4914F6CDD1D)
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m     for i in 0..600 {
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m         let len = LENGTHS[(next() % LENGTHS.len() as u64) as usize];
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m         let input: Vec<u8> = (0..len)
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m             .map(|_| ALPHABET[(next() % ALPHABET.len() as u64) as usize])
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m             .collect();
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m         assert_same(&format!("fuzz #{i} (len {len})"), &input);
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m /// Numeric strings around every interesting magnitude, with several suffixes.
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m fn numeric_matrix() {
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m     let bodies: Vec<String> = [
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m         "0",
