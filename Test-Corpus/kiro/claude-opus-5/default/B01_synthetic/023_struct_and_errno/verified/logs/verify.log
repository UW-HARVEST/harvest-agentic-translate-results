[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m         ("INT_MIN underflows bedrooms twice", b"-2147483648\n"),
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         ("large positive", b"2147483640\n"),
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m         ("large negative", b"-2147483640\n"),
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m         ("half of INT_MAX", b"1073741824\n"),
