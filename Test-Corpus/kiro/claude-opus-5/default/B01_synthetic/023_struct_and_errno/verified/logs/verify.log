[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m     assert_same("number then garbage line", b"5\nabc\n");
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m     assert_same("three lines", b"1\n2\n3\n");
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m 
