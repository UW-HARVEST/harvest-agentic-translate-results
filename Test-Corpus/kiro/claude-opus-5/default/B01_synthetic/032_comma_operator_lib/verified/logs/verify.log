X = 1073745920
OV = 1 << 30

def dlen_range(lo, hi):
    """sum of len(str(v)) for v in [lo,hi) , v>=0"""
    s = 0
    if lo == 0:
        s += 1
        lo = 1
    p, d = 1, 1
    while p < hi:
        a = max(lo, p); b = min(hi, p * 10)
        if b > a:
            s += (b - a) * d
        p *= 10; d += 1
    return s

def dlen_even_range(lo, hi):
    """sum of len(str(v)) for even v in [lo,hi)"""
    s = 0
    if lo == 0:
        s += 1
        lo = 2
    p, d = 1, 1
    while p < hi:
        a = max(lo, p); b = min(hi, p * 10)
        if b > a:
            cnt = (b - 1) // 2 - (a - 1) // 2   # count of evens in [a,b)
            s += cnt * d
        p *= 10; d += 1
    return s

# --- i field: i = 0 .. X-1
ti = dlen_range(0, X)

# --- j field under WRAPPING model
# i in [0, OV): j = 2i, even, in [0, 2*OV)
tj = dlen_even_range(0, 2 * OV)
# i in [OV, X): j = 2i - 2^32, i.e. -2^31 + 2*(i-OV)  -> negative, len = 1 + len(abs)
n_tail = X - OV
for k in range(n_tail):
    j = -(2 ** 31) + 2 * k
    tj += 1 + len(str(abs(j)))

# each line: i + ' ' + j + '\n'  => 2 separator bytes per line
wrap_total = ti + tj + 2 * X

# --- j field under NON-wrapping (mathematical 2*i) model, for contrast
tj_nowrap = dlen_even_range(0, 2 * X)
nowrap_total = ti + tj_nowrap + 2 * X

print("measured bytes      :", 21955747671)
print("wrapping model      :", wrap_total, "MATCH" if wrap_total == 21955747671 else "no")
print("non-wrapping model  :", nowrap_total, "MATCH" if nowrap_total == 21955747671 else "no")
print("negative-j lines    :", n_tail)
print("first wrapped j     :", -(2**31), " at i =", OV)
