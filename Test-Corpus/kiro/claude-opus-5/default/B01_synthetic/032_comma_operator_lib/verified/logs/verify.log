[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m // C12 — stdout buffer boundary straddling
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
