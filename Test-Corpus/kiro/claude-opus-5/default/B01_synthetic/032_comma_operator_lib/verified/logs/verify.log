[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m     // Explicitly assert the skew really exists in the C output (guards against
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     // the test degenerating into a no-op).
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     let five = libs.run(Impl::C, 6);
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m     assert_eq!(five, b"0 0\n1 2\n2 4\n3 6\n4 8\n5 10\n");
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m }
