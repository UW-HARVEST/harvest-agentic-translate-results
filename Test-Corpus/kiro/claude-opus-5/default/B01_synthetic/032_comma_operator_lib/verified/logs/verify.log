[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m     xs.sort_unstable();
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m     xs.dedup();
