[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m             if v >= 0 {
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m                 xs.push(v);
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m             }
