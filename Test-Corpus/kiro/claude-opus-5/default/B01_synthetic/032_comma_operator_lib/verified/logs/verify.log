[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     // Confirm at least one candidate really straddles a 4 KiB boundary.
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m     assert!(
