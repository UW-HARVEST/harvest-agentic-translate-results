[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m // C11 — `j`-digit boundaries: j == 2*i gains a digit before i does
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m fn c11_digit_boundaries_for_j() {
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m     let libs = Libs::load();
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m     let mut xs = Vec::new();
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m     let mut p: i64 = 10;
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m     while p <= 1_000_000 {
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m         // j first reaches `p` at i == p/2, i.e. x must exceed p/2.
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m         let base = p / 2;
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m         for d in [-1i64, 0, 1, 2] {
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m             let v = base + d;
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m             if v >= 0 {
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m                 xs.push(v as i32);
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m         p *= 10;
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m     xs.sort_unstable();
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m     xs.dedup();
