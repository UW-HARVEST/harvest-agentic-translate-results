[49m[38;5;10m+      1[0m:[38;5;10m[49m //! Shared differential-test harness.
[0m[49m[38;5;10m+      2[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+      3[0m:[38;5;10m[49m //! Loads BOTH shared objects — the C `libdriver.so` built by CMake and the Rust
[0m[49m[38;5;10m+      4[0m:[38;5;10m[49m //! `libdriver.so` built by cargo — through `libloading`, and calls them only via
[0m[49m[38;5;10m+      5[0m:[38;5;10m[49m //! their exported `extern "C"` symbols. The Rust implementation is never called
[0m[49m[38;5;10m+      6[0m:[38;5;10m[49m //! directly from the test binary, so the `#[no_mangle]` export wrappers are
[0m[49m[38;5;10m+      7[0m:[38;5;10m[49m //! themselves under test.
[0m[49m[38;5;10m+      8[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+      9[0m:[38;5;10m[49m //! The library communicates its results exclusively through `printf` to
[0m[49m[38;5;10m+     10[0m:[38;5;10m[49m //! `stdout` (both public functions return `void`), so "comparing outputs" means
[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m //! capturing the bytes each `.so` writes to file descriptor 1 and comparing them
[0m[49m[38;5;10m+     12[0m:[38;5;10m[49m //! byte-for-byte.
[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m //! ## Why a global lock and lock-step calling
