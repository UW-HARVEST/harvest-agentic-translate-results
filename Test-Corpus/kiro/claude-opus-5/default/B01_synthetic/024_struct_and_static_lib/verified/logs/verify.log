< /// `house->floors++;`
< ///
< /// Takes a raw pointer, exactly like the C, and never forms a Rust reference:
< /// `&mut *ptr` would let the compiler assume the pointer is non-null/aligned,
< /// and under `debug-assertions` it inserts a `null pointer dereference` check
< /// that aborts (SIGABRT) where the C simply faults (SIGSEGV). See `run`.
< ///
< /// Signed overflow is undefined behaviour in C; gcc's actual codegen wraps, so
< /// `wrapping_add` reproduces the observed behaviour instead of panicking.
< unsafe fn add_floor(house: *mut house_t) {
<     let p = addr_of_mut!((*house).floors);
<     p.write_unaligned(p.read_unaligned().wrapping_add(1));
< }
< 
