[0m[49m[38;5;10m+    26[0m:[38;5;10m[49m ## The complete C body, for reference
[0m[49m[38;5;10m+    27[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    28[0m:[38;5;10m[49m ```c
[0m[49m[38;5;10m+    29[0m:[38;5;10m[49m void driver(int x) {
[0m[49m[38;5;10m+    30[0m:[38;5;10m[49m     register int y = 2*x;
