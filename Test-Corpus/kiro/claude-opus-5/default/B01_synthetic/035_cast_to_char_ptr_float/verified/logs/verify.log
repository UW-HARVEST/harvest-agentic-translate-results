[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m             assert_same(format!("{}{}", &w[..i], suffix).as_bytes());
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m     }
