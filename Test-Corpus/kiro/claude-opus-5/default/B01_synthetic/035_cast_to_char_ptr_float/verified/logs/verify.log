import random, sys, struct
random.seed(99)
cases=[]
# subnormal / rounding boundaries as exact decimals
import decimal
decimal.getcontext().prec=200
for e in list(range(-149,-120))+list(range(120,129)):
    v=decimal.Decimal(2)**e
    for mul in ["1","1.5","0.5","1.25","0.75","1.0000001","0.9999999"]:
        cases.append(str(v*decimal.Decimal(mul)))
# halfway cases between consecutive f32
for _ in range(600):
    b=random.getrandbits(32)
    f=struct.unpack('<f',struct.pack('<I',b))[0]
    if f!=f or abs(f)==float('inf'): continue
    d=decimal.Decimal(f)
    b2=(b+1)
    try: f2=struct.unpack('<f',struct.pack('<I',b2))[0]
    except Exception: continue
    if f2!=f2 or abs(f2)==float('inf'): continue
    cases.append(str((d+decimal.Decimal(f2))/2))
# very long digit strings
for _ in range(300):
    n=random.randint(50,800)
    s="".join(random.choice("0123456789") for _ in range(n))
    cases.append(s)
    cases.append("0."+s)
    cases.append(s+"e-"+str(random.randint(0,400)))
# long hex
for _ in range(400):
    n=random.randint(1,80)
    cases.append("0x"+"".join(random.choice("0123456789abcdef") for _ in range(n))+"p"+random.choice("+-")+str(random.randint(0,400)))
    cases.append("0x."+"".join(random.choice("0123456789abcdef") for _ in range(n))+"p"+random.choice("+-")+str(random.randint(0,400)))
cases=[c for c in cases if "\0" not in c]
sys.stdout.write("\0".join(cases)+"\0")
EOF
