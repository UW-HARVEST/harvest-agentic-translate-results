import random, struct, subprocess
random.seed(99)
C="/tmp/cb/driver"; R="./translation/target/release/driver"
cases=[]
# exact ties: value with 25 significant bits -> ties-to-even
for _ in range(4000):
    e=random.randint(-160,120)
    m=random.getrandbits(25)|(1<<24)
    cases.append("0x%xp%d"%(m,e))
    cases.append("-0x%xp%d"%(m,e))
# long hex mantissas (force sticky path, >128 bits)
for _ in range(4000):
    n=random.randint(30,80)
    h="".join(random.choice("0123456789abcdef") for _ in range(n))
    cases.append("0x%s.%sp%d"%(h,"".join(random.choice("0123456789abcdef") for _ in range(random.randint(0,80))),random.randint(-300,300)))
# decimal exact-tie / boundary
for _ in range(4000):
    b=random.getrandbits(32)
    f=struct.unpack('<f',struct.pack('<I',b))[0]
    if f!=f or abs(f)==float('inf'): continue
    cases.append("%.80e"%f)
    cases.append("%.9g"%f)
# subnormal boundaries
for k in range(0,30):
    cases.append("0x1p-%d"%(149+k)); cases.append("0x1.8p-%d"%(149+k)); cases.append("0x0.%sp-126"%("8"*k or "8"))
cases += ["", " ", "\n", "\t\t\n ", "1\n2\n3", "  -inf junk", "0x1p3 0x1p4"]
bad=0
for t in cases:
    d=t.encode()
    a=subprocess.run([C],input=d,capture_output=True).stdout
    b2=subprocess.run([R],input=d,capture_output=True).stdout
    if a!=b2:
        bad+=1; print("MISMATCH",repr(d),a,b2)
        if bad>15: break
print("checked",len(cases),"failures",bad)
