#!/usr/bin/env python3
"""Byte-exact differential verification: C reference vs Rust translation."""
import os, random, struct, subprocess, sys
REF = os.path.dirname(os.path.abspath(__file__))
C = os.path.join(REF, "cref"); R = os.path.join(REF, "rustd")
def run(exe, data):
    return subprocess.run([exe], input=data, stdout=subprocess.PIPE).stdout
bad = []; n = 0
def check(d):
    global n
    if isinstance(d, str): d = d.encode()
    n += 1
    a, b = run(C, d), run(R, d)
    if a != b: bad.append((d, a, b))

# ---- 1. fixed cases -------------------------------------------------------
fixed = """0 -0 1 -1 0.5 3.14159 2.718281828459045 1e10 1e-10 1E+10 1e38 1e39 1e-38 1e-45 1e-46
1e-50 3.4028235e38 3.4028236e38 1.17549435e-38 1.4e-45 7e-46 0.1 0.2 0.3 123456789
12345678901234567890 .5 5. -.5 +.5 +5 1e 1e+ 1e- 1.5e 12e5 0000123.456 1.0000001 1.00000001
16777217 16777216 16777218 16777215.5 8388609.5 2.3509887e-38 1.1754942e-38 1e-44 2e-45 3e-45
0.49999999999999994 0x1p0 0x1P0 -0x1p0 0x1.8p1 0x.8p1 0x8p-4 0X1FFFFFFp0 0x1p128 0x1p-149
0x1p-150 0x1.8p-150 0x1p-151 0x0p0 -0x0p0 0x 0X 0x. 0xzz 0x1p 0x1p+ 0x1.fffffep127
0x1.ffffffp127 0x1p1000 0x1p-1000 inf INF -inf +inf Inf infinity INFINITY -Infinity infinit
infi infin infini infinityy inff -infi +infinity INFI InFiNiTy in i nan NAN -nan +nan NaN
nanx nann n na N nA abc - + . -. e5 --1 +-1 x 00 1.5abc 3xyz 0x1p0zz infxyz""".split()
for v in fixed: check(v)
for v in ["", " ", "\n", "  7.25", "\n\n\t 8.5", "- 5", "1.5 9", "1.5\n9", "nan()", "nan(1)",
          "nan(0x123)", "nan(123)", "nan(0777)", "nan(abc)", "nan(_)", "nan(1_2)", "nan(",
          "nan(1", "nan(1)x", "nan(0x)", "1.5e+x", "0.000000000000000000001", "0x.p1",
          "\v\f\r\t 2.5", "\0", "\0001.5", "1.5\0", "\xff\xfe", "+", "..."]:
    check(v)
check("1" + "0"*400); check("0." + "0"*400 + "1")
check("1." + "2"*900 + "e5"); check("1"*300 + "e-295")
check("9"*40 + "e30"); check("-" + "9"*40 + "e-40")

# ---- 2. hex / rounding boundary stress -----------------------------------
for m in [0x1000001,0x1000003,0x1FFFFFF,0x1000000,0x17FFFFF,0x1800001,0x800001,0xFFFFFF]:
    for e in range(-165, 135, 3): check("0x%xp%d" % (m, e))
for h in ["0x1p-150","0x1p-151","0x1.8p-150","0x1.0000001p-150","0x3p-151","0x1p-149",
          "0x1.fffffep-127","0x1.ffffffp-127","0x1p-126","0x1.8p-127","0x1p-127",
          "0x0.000001p-126","0x0.8p-149","0x0.80001p-149","0x1.8p-149","0x2.8p-149",
          "0x1p127","0x1p128","0x1.ffffffp127","0x"+"f"*40+"p-200"]:
    check(h); check("-"+h)
for tail in ["0","1","8","0000000000000000","0000000000000001"]:
    for pre in ["1","1000001","ffffff","1000000","800000"]:
        for e in [-200,-149,-130,-20,0,20,100,127,128]:
            check("0x%s%s%sp%d" % (pre, "0"*20, tail, e))

# ---- 3. full-f32-space round trip ---------------------------------------
for bits in range(0, 1 << 32, 0x2711*137):
    f = struct.unpack("<f", struct.pack("<I", bits))[0]
    for s in {repr(f), "%.17g" % f, "%.9g" % f, "%e" % f, float.hex(f)}:
        check(s)

# ---- 4. randomized fuzz -------------------------------------------------
def gen(rng):
    k = rng.randrange(12)
    if k == 0:
        return repr(struct.unpack("<f", struct.pack("<I", rng.getrandbits(32)))[0])
    if k == 1:
        s = "".join(rng.choice("0123456789") for _ in range(rng.randrange(1, 30)))
        if rng.random() < .7:
            p = rng.randrange(len(s)+1); s = s[:p]+"."+s[p:]
        if rng.random() < .5:
            s += rng.choice("eE")+rng.choice(["","+","-"])+str(rng.randrange(0,60))
        return (rng.choice("+-") if rng.random() < .4 else "") + s
    if k == 2:
        s = "".join(rng.choice("0123456789") for _ in range(rng.randrange(1,12)))
        return "%se%d" % (s, rng.choice([-45,-44,-46,-38,-39,38,39,40,-149,128]))
    if k == 3:
        h = "".join(rng.choice("0123456789abcdefABCDEF") for _ in range(rng.randrange(1,14)))
        if rng.random() < .5:
            p = rng.randrange(len(h)+1); h = h[:p]+"."+h[p:]
        s = "0"+rng.choice("xX")+h
        if rng.random() < .8:
            s += rng.choice("pP")+rng.choice(["","+","-"])+str(rng.randrange(0,220))
        return (rng.choice("+-") if rng.random() < .4 else "") + s
    if k == 4:
        s = "".join(rng.choice("0123456789") for _ in range(rng.randrange(50,500)))
        return s+"e"+str(rng.randrange(-60,20))
    if k == 5:
        return "%de%d" % (rng.randrange(1<<23, 1<<25), rng.randrange(-30,30))
    if k == 6:
        return rng.choice(["inf","INF","infinity","infi","infinit","nan","NAN","nan(1)",
                           "nan(0x1)","-nan","-inf","i","n","na","nanx","inff","Infinity"])
    if k == 7:
        ws = "".join(rng.choice(" \t\n\v\f\r") for _ in range(rng.randrange(0,6)))
        return ws + repr(rng.random()*10**rng.randrange(-10,10))
    if k == 8:
        return bytes(rng.randrange(256) for _ in range(rng.randrange(0,12)))
    if k == 9:
        return "".join(rng.choice("0123456789+-.eExXpPabcdinf() \t\n") for _ in range(rng.randrange(0,14)))
    if k == 10:
        return rng.choice(["",".","-","+","e5","0x","0X","0x.","0x1p","1e","1e+",".e5","--1","- 1","+.","0x.p1"])
    return "0."+"0"*rng.randrange(0,50)+"".join(rng.choice("0123456789") for _ in range(rng.randrange(1,400)))

rng = random.Random(int(sys.argv[1]) if len(sys.argv) > 1 else 12345)
for _ in range(int(sys.argv[2]) if len(sys.argv) > 2 else 8000):
    check(gen(rng))

for d, a, b in bad[:25]:
    print("MISMATCH input=%r C=%r RUST=%r" % (d, a, b))
print("TOTAL cases=%d mismatches=%d" % (n, len(bad)))
sys.exit(1 if bad else 0)
