[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m fn closed_stdout_pipe_kills_both_the_same_way() {
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m     for input in [&b"1\n"[..], b"0\n"] {
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m         let mut runs = Vec::new();
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m         for bin in [c_binary(), rust_binary()] {
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m             let mut child = Command::new(&bin)
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m                 .stdin(Stdio::piped())
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m                 .stdout(Stdio::piped())
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m                 .stderr(Stdio::piped())
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m                 .spawn()
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m                 .expect("spawn");
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m             // Close the read end *before* the child can write anything: it is
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m             // still blocked reading stdin, which has not been fed yet.
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m             drop(child.stdout.take());
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m 
