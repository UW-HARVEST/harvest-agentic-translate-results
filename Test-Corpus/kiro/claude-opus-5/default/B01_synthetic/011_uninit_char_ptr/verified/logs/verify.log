[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m         ("bare_minus_nl", b"-\n"),
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m         ("bare_plus_nl", b"+\n"),
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m         ("minus_space_one", b"- 1"),
