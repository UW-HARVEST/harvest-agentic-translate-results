[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m             let _ = stdin.write_all(input);
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m             drop(stdin);
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m             let status = child.wait().expect("wait");
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m             use std::os::unix::process::ExitStatusExt;
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m             runs.push((status.code(), status.signal()));
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m             runs[0], runs[1],
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m             "closed-stdout exit status differs for input {:?}: C {:?} vs Rust {:?}",
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m             String::from_utf8_lossy(input),
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m             runs[0],
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m             runs[1]
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m 
