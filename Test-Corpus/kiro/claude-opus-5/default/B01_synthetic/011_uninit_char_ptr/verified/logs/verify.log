[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m         ("negative_way_past_u64", b"-99999999999999999999999999"),
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m         ("leading_zeros_then_one", b"0000000000000000000000001"),
