[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m         ("long_max", b"9223372036854775807"),
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m         ("long_max_plus_one_saturates", b"9223372036854775808"),
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m         ("long_min", b"-9223372036854775808"),
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m         ("long_min_minus_one_saturates", b"-9223372036854775809"),
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m         ("u64_max", b"18446744073709551615"),
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m         ("u64_max_plus_one", b"18446744073709551616"),
