[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m             outs[1].stdout.len()
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m         assert_eq!(
