[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     for bin in [&c, &r] {
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m         let run = run_with_stdin(bin, b"1\n");
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m             run.code,
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m             Some(0),
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m             "{} did not exit 0 on a trivial input: {run:?}",
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m             bin.display()
