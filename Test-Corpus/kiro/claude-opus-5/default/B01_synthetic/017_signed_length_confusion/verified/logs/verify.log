[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m     let mut next = || {
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m         state ^= state << 13;
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m         state ^= state >> 7;
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m         state ^= state << 17;
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m         state
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m     for _ in 0..120 {
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m         let len = (next() % 24) as usize;
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m         let input: Vec<u8> = (0..len)
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m             .map(|_| match next() % 10 {
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m                 // Bias towards characters atoi cares about.
