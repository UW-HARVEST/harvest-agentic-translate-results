[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m                 _ => (next() % 256) as u8,
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m             })
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m             .collect();
