[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m         let rc = unsafe { libc_pipe(fds.as_mut_ptr()) };
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m         assert_eq!(rc, 0, "pipe() failed");
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m         let (read_fd, write_fd) = (fds[0], fds[1]);
