[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m     use std::os::unix::process::ExitStatusExt;
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m     let mut results = Vec::new();
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m     for bin in [c_bin(), rust_bin()] {
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m         // Build a pipe, hand the write end to the child, then drop the read
