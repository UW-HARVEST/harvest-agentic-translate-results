[0m[49m[38;5;10m+    113[0m:[38;5;10m[49m /// Escapes bytes for readable assertion messages, truncating very long inputs.
[0m[49m[38;5;10m+    114[0m:[38;5;10m[49m struct Show<'a>(&'a [u8]);
