[0m[49m[38;5;10m+    116[0m:[38;5;10m[49m impl std::fmt::Debug for Show<'_> {
[0m[49m[38;5;10m+    117[0m:[38;5;10m[49m     fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
[0m[49m[38;5;10m+    118[0m:[38;5;10m[49m         let (head, elided) = if self.0.len() > 96 {
[0m[49m[38;5;10m+    119[0m:[38;5;10m[49m             (&self.0[..96], self.0.len() - 96)
[0m[49m[38;5;10m+    120[0m:[38;5;10m[49m         } else {
[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m             (self.0, 0)
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m         for &b in head {
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m             match b {
[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m                 b'\n' => write!(f, "\\n")?,
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m                 b'\r' => write!(f, "\\r")?,
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m                 b'\t' => write!(f, "\\t")?,
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m                 0x0b => write!(f, "\\v")?,
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m                 0x0c => write!(f, "\\f")?,
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m                 0x20..=0x7e => write!(f, "{}", b as char)?,
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m                 _ => write!(f, "\\x{b:02x}")?,
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m         if elided > 0 {
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m             write!(f, "...(+{elided} bytes)")?;
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m         Ok(())
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m // Input classes the C program branches on.
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m // main() is: `int x = 0; scanf("%d", &x); driver(x);`
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m // The branch points are therefore entirely inside the `%d` conversion:
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m //   1. leading-whitespace skip (any amount, including none, including newlines)
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m //   2. optional '+' / '-' sign, or none
