[0m[49m[38;5;10m+     84[0m:[38;5;10m[49m         "[{label}] driver({:?}): parsed value != {expect_value}; tail was {}",
[0m[49m[38;5;10m+     85[0m:[38;5;10m[49m         show(input),
[0m[49m[38;5;10m+     86[0m:[38;5;10m[49m         show(&c_out)
[0m[49m[38;5;10m+     87[0m:[38;5;10m[49m     );
