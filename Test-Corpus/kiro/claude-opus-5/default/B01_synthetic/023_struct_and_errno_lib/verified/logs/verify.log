[0m[49m[38;5;10m+    118[0m:[38;5;10m[49m // E3 — sign only / repeated signs
[0m[49m[38;5;10m+    119[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    120[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m fn e3_sign_only() {
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m     for s in [
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m         &b"+"[..], b"-", b"++", b"--", b"+-", b"-+", b"  +", b"\t-", b"--1", b"+-1", b"-+1",
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m         b"++1", b"+ 1", b"- 1", b"+ ", b"- ",
[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m         assert_both_reject(&format!("E3 {}", show(s)), s);
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m // E4 — first non-space char is neither digit nor sign
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m fn e4_non_numeric_lead() {
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m     for s in [
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m         &b"abc"[..], b"x12", b".", b".5", b"e5", b"E5", b"#", b"/", b":", b"\xff", b"\x80",
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m         b"\x01", b"_1", b"(1)", b"$5", b"1"[..0].as_ref().unwrap_or(&b""[..]),
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m         if s.is_empty() {
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m         assert_both_reject(&format!("E4 {}", show(s)), s);
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m     // Exhaustive single-byte sweep: every byte 0x01..=0xff. Digits and signs
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m     // that begin a conversion are accepted; everything else is rejected. The
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m     // point is that C and Rust must agree on the *whole* byte alphabet.
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m     let p = pair();
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m     for b in 1u16..=255 {
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m         let buf = [b as u8, 0u8];
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m         let c_out = capture(|| unsafe { (p.c.driver)(buf.as_ptr() as *const c_char) });
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m         let r_out = capture(|| unsafe { (p.rs.driver)(buf.as_ptr() as *const c_char) });
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m             c_out, r_out,
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m             "E4 byte-sweep {b:#04x}: C={} Rust={}",
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m             show(&c_out),
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m             show(&r_out)
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m         let is_digit = (b as u8).is_ascii_digit();
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m         if !is_digit {
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m                 c_out, REJECT,
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m                 "E4 byte-sweep {b:#04x}: expected rejection, got {}",
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m                 show(&c_out)
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m     // Two-byte sweep over sign/space prefixes.
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m     for pre in [b'+', b'-', b' ', b'\t'] {
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m         for b in 1u16..=255 {
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m             let buf = [pre, b as u8, 0u8];
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m             let c_out = capture(|| unsafe { (p.c.driver)(buf.as_ptr() as *const c_char) });
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m             let r_out = capture(|| unsafe { (p.rs.driver)(buf.as_ptr() as *const c_char) });
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m                 c_out, r_out,
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m                 "E4 pair-sweep {:?}+{b:#04x}: C={} Rust={}",
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m                 pre as char,
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m                 show(&c_out),
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m                 show(&r_out)
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m // E5 — base-10 vs hex/octal prefixes
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m fn e5_prefixes() {
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m     // "0x" and friends START with a digit, so strtol(base 10) converts 0 and
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m     // stops at 'x' -> endp != str -> ACCEPTED with value 0.
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m     assert_both_accept("E5 0x", b"0x", 0);
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m     assert_both_accept("E5 0x10", b"0x10", 0);
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m     assert_both_accept("E5 0X1F", b"0X1F", 0);
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m     assert_both_accept("E5 0b101", b"0b101", 0);
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m     assert_both_accept("E5 0o17", b"0o17", 0);
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     assert_both_accept("E5 017", b"017", 17); // NOT octal: base 10
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m     assert_both_accept("E5 -0x10", b"-0x10", 0);
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m     // No leading digit -> no conversion -> rejected.
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m     for s in [&b"x0"[..], b"X", b"xyz", b"0"[..0].as_ref().unwrap_or(&b"x"[..])] {
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m         if s.is_empty() {
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m         assert_both_reject(&format!("E5 {}", show(s)), s);
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m // E6 — ERANGE, magnitude above LONG_MAX
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m fn e6_erange_above_long_max() {
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     assert_both_reject("E6 LONG_MAX+1", b"9223372036854775808");
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     assert_both_reject("E6 LONG_MAX+2", b"9223372036854775809");
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m     assert_both_reject("E6 20 nines", b"99999999999999999999");
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m     assert_both_reject("E6 +LONG_MAX+1", b"+9223372036854775808");
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m     let big = "9".repeat(400);
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m     assert_both_reject("E6 400 nines", big.as_bytes());
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE006);
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     for i in 0..200 {
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m         let extra_digits = rng.below(30) + 1;
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m         let mut s = String::from("9223372036854775808");
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m         for _ in 0..extra_digits {
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m             s.push((b'0' + rng.below(10) as u8) as char);
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m         assert_both_reject(&format!("E6 rand#{i}"), s.as_bytes());
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     // With trailing junk too (ERANGE still dominates).
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m     assert_both_reject("E6 junk", b"99999999999999999999abc");
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m // E7 — ERANGE, magnitude below LONG_MIN
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m fn e7_erange_below_long_min() {
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m     assert_both_reject("E7 LONG_MIN-1", b"-9223372036854775809");
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m     assert_both_reject("E7 LONG_MIN-2", b"-9223372036854775810");
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m     assert_both_reject("E7 -20 nines", b"-99999999999999999999");
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     let big = format!("-{}", "9".repeat(400));
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m     assert_both_reject("E7 -400 nines", big.as_bytes());
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE007);
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m     for i in 0..200 {
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         let extra_digits = rng.below(30) + 1;
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         let mut s = String::from("-9223372036854775809");
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         for _ in 0..extra_digits {
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m             s.push((b'0' + rng.below(10) as u8) as char);
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         assert_both_reject(&format!("E7 rand#{i}"), s.as_bytes());
