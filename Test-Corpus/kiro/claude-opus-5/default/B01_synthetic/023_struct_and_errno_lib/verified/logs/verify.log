[0m[49m[38;5;10m+    108[0m:[38;5;10m[49m     assert_both_reject("E2 mix", b" \t\n\x0b\x0c\r \t");
[0m[49m[38;5;10m+    109[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE002);
[0m[49m[38;5;10m+    110[0m:[38;5;10m[49m     for i in 0..200 {
[0m[49m[38;5;10m+    111[0m:[38;5;10m[49m         let n = rng.below(12) + 1;
[0m[49m[38;5;10m+    112[0m:[38;5;10m[49m         let s: Vec<u8> = (0..n).map(|_| *rng.pick(&WS)).collect();
[0m[49m[38;5;10m+    113[0m:[38;5;10m[49m         assert_both_reject(&format!("E2 rand#{i}"), &s);
[0m[49m[38;5;10m+    114[0m:[38;5;10m[49m     }
