#include <errno.h>
#include <limits.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
int main(void){
    // Search for any input where strtol sets errno but the result is inside
    // [INT_MIN, INT_MAX] -- i.e. where the `errno == 0` conjunct is the ONLY
    // thing that rejects. If none exists, that conjunct is redundant.
    char buf[512];
    long found = 0, checked = 0;
    const char *pre[] = {"", "+", "-", "  ", "\t+", "\n-", "000", "+000", "-000"};
    for (int p = 0; p < 9; p++) {
      for (int digits = 1; digits <= 60; digits++) {
        for (int lead = 1; lead <= 9; lead++) {
          for (int t = 0; t < 3; t++) {
            const char *tail = t == 0 ? "" : (t == 1 ? "abc" : " 7");
            snprintf(buf, sizeof buf, "%s%d", pre[p], lead);
            for (int k = 1; k < digits; k++) strcat(buf, "9");
            strcat(buf, tail);
            errno = 0; char *e = buf;
            long v = strtol(buf, &e, 10);
            checked++;
            if (e != buf && errno != 0 && v >= INT_MIN && v <= INT_MAX) {
              printf("COUNTEREXAMPLE: %s -> %ld errno=%d\n", buf, v, errno);
              found++;
            }
          }
        }
      }
    }
    printf("checked=%ld counterexamples=%ld\n", checked, found);
    return 0;
}
EOF
