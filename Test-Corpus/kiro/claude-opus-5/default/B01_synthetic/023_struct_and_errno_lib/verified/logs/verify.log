[0m[49m[38;5;10m+     89[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     90[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+     91[0m:[38;5;10m[49m // E1 — empty string: strtol performs no conversion, endp == str
[0m[49m[38;5;10m+     92[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+     93[0m:[38;5;10m[49m #[test]
