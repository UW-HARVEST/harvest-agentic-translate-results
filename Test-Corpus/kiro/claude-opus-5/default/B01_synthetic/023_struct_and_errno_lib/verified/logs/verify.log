[0m[49m[38;5;10m+     96[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     97[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     98[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+     99[0m:[38;5;10m[49m // E2 — whitespace only
[0m[49m[38;5;10m+    100[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    101[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    102[0m:[38;5;10m[49m fn e2_whitespace_only() {
[0m[49m[38;5;10m+    103[0m:[38;5;10m[49m     const WS: [u8; 6] = [b' ', b'\t', b'\n', 0x0b, 0x0c, b'\r'];
[0m[49m[38;5;10m+    104[0m:[38;5;10m[49m     for &w in WS.iter() {
