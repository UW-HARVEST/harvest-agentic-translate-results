import re, io

def wrap(path):
    lines = open(path).read().split('\n')
    out = []
    i = 0
    n = len(lines)
    count = 0
    while i < n:
        line = lines[i]
        if line.strip() == '#[test]':
            # find the fn signature line (next non-attribute line)
            j = i + 1
            while j < n and lines[j].lstrip().startswith('#['):
                j += 1
            sig = lines[j]
            assert sig.rstrip().endswith('{'), (path, sig)
            # emit through sig, then open the wrapper
            out.extend(lines[i:j+1])
            out.append('    common::isolated(|| {')
            # copy body until the closing '}' at column 0
            k = j + 1
            while lines[k] != '}':
                out.append(lines[k])
                k += 1
            out.append('    });')
            out.append('}')
            count += 1
            i = k + 1
        else:
            out.append(line)
            i += 1
    open(path, 'w').write('\n'.join(out))
    print(path, 'wrapped', count, 'tests')

