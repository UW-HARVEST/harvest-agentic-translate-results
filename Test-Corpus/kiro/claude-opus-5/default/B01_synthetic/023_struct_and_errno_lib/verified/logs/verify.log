[package]
name = "driver"
version = "0.1.0"
edition = "2021"

[lib]
name = "driver"
crate-type = ["cdylib"]
path = "src/lib.rs"

[dev-dependencies]
libloading = "0.8"

[profile.dev]
# The C reference library is built by CMake with no extra flags: no overflow
# traps and no null/alignment assertions. Rust's debug-assertion-gated
# `CheckNull` / `ub_checks` passes turn an unchecked dereference (which the C
# lets fault with SIGSEGV) into a `SIGABRT` panic, and overflow checks turn the
# C's wrapping `int` arithmetic into a panic. Both are behavioural differences,
# so they are disabled here to keep the dev/test build ABI-equivalent to the C.
debug-assertions = false
overflow-checks = false

[profile.release]
panic = "abort"
debug-assertions = false
overflow-checks = false

