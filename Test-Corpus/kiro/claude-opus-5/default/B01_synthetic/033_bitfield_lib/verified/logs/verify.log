[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m         let via_driver_r = capture(|| unsafe { (pair().r.driver)(x, y, b, z) });
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m         let via_print_c = capture(|| unsafe { (pair().c.print_foo)(img.as_ptr()) });
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m         let via_print_r = capture(|| unsafe { (pair().r.print_foo)(img.as_ptr()) });
