[49m[38;5;10m+      1[0m:[38;5;10m[49m // Differential tests: load BOTH the C `.so` and the Rust `.so` with `libloading`
[0m[49m[38;5;10m+      2[0m:[38;5;10m[49m // and compare their observable output (stdout) byte-for-byte.
[0m[49m[38;5;10m+      3[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+      4[0m:[38;5;10m[49m // No Rust function is ever called directly — every call goes through the
[0m[49m[38;5;10m+      5[0m:[38;5;10m[49m // `.so`'s exported symbol, so the `#[no_mangle]` / `extern "C"` wrappers are
[0m[49m[38;5;10m+      6[0m:[38;5;10m[49m // under test too.
[0m[49m[38;5;10m+      7[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+      8[0m:[38;5;10m[49m // Phase B rows live in `CONFIGS.md`, Phase C rows in `ERRORS.md`.
[0m[49m[38;5;10m+      9[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     10[0m:[38;5;10m[49m use std::ffi::{c_char, c_int, c_void};
[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m use std::path::PathBuf;
[0m[49m[38;5;10m+     12[0m:[38;5;10m[49m use std::sync::{Mutex, OnceLock};
[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m use libloading::{Library, Symbol};
[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     16[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     17[0m:[38;5;10m[49m // libc bits needed to capture whatever the loaded libraries write to fd 1.
[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
