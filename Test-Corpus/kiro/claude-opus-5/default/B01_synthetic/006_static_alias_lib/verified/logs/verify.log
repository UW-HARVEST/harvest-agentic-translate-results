[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m fn chain(f: StaticAliasFn, initial: i32, steps: usize) -> Vec<Step> {
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     let mut cell: c_int = initial;
