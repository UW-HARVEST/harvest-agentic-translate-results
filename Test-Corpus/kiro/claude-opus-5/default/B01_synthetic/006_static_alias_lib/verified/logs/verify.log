    27	int*
    28	static_alias(int *outer) {
    29	  static int inner = 1;
    30	  if(*outer >= inner) {
    31	    inner += *outer;
    32	    return &inner;
    33	  } else {
    34	    *outer += inner;
    35	    return outer;
