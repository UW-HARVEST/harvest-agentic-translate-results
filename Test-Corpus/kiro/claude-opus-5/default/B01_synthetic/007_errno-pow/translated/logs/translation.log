  ro=$(cd /tmp/dtest/r && ./driver "${args[@]}" 2>/tmp/dtest/re); rrc=$?
  re=$(cat /tmp/dtest/re)
  if [ "$co" != "$ro" ] || [ "$ce" != "$re" ] || [ "$crc" != "$rrc" ]; then
    fail=$((fail+1))
