[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m     // Truncating 64-bit patterns to int: low half zero => 0 => bad().
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     for hi in [0xFFFF_FFFFu64, 0x1u64, 0xDEAD_BEEFu64] {
