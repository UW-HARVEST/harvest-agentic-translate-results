[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m fn err_10_bad_overrun_does_not_corrupt_later_calls() {
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m     let s = cstr(b"sentinel");
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m     let out = diff("bad() overrun stress", |a: &Api| {
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m         for i in 0..512 {
