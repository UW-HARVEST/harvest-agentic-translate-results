    // scripts/verify_all.sh, which runs the suite against BOTH profiles).
    if let Ok(p) = std::env::var("DRIVER_RUST_SO") {
        return PathBuf::from(p);
    }
    manifest_dir().join("target/debug/libdriver.so")
}'''
