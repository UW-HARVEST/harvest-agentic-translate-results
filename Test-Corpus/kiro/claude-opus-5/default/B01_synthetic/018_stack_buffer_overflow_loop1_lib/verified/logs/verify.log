[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m fn err_07_print_int_line_power_of_two_boundaries() {
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     let mut vals: Vec<i32> = vec![0];
