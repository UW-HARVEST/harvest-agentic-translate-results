[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m // ----------------------------------------------------------------- the sessions
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m /// A freshly loaded copy of one implementation, with pristine `the_house`.
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m pub struct Session {
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m     name: &'static str,
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m     _lib: libloading::Library,
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m     copy_path: PathBuf,
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m     pub driver: DriverFn,
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m     pub run: RunFn,
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m impl Session {
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m     fn open(name: &'static str, original: &Path) -> Session {
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m         // Unique path => guaranteed-fresh data segment.
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m         let copy_path = scratch_dir().join(format!("{}-libdriver.so", unique(name)));
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m         std::fs::copy(original, &copy_path)
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m             .unwrap_or_else(|e| panic!("copy {original:?} -> {copy_path:?}: {e}"));
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m         let lib = unsafe { libloading::Library::new(&copy_path) }
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m             .unwrap_or_else(|e| panic!("dlopen {copy_path:?}: {e}"));
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         let driver: DriverFn = unsafe {
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m             *lib.get::<DriverFn>(b"driver\0")
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m                 .unwrap_or_else(|e| panic!("{name}: missing exported symbol `driver`: {e}"))
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m         let run: RunFn = unsafe {
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m             *lib.get::<RunFn>(b"run\0")
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m                 .unwrap_or_else(|e| panic!("{name}: missing exported symbol `run`: {e}"))
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m         Session {
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m             name,
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m             _lib: lib,
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m             copy_path,
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m             driver,
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m             run,
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m     pub fn fresh_c() -> Session {
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m         Session::open("c", &c_so())
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m     pub fn fresh_rust() -> Session {
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m         Session::open("rust", &rust_so())
