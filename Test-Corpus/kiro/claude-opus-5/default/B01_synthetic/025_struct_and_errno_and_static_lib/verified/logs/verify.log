[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m impl Op {
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m     pub fn driver(s: &str) -> Op {
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m         Op::Driver(s.as_bytes().to_vec())
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m     pub fn describe(&self) -> String {
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m         match self {
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m             Op::Run(v) => format!("run({v})"),
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m             Op::Driver(bytes) => {
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m                 let s = String::from_utf8_lossy(bytes);
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m                 let shown: String = s.chars().take(64).collect();
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m                 format!(
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m                     "driver({:?}{})",
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m                     shown,
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m                     if s.chars().count() > 64 { "…" } else { "" }
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m                 )
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     fn invoke(&self, sess: &Session) {
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m         match self {
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m             Op::Run(v) => unsafe { (sess.run)(*v) },
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m             Op::Driver(bytes) => {
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m                 let cs = CString::new(bytes.clone())
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m                     .expect("test input must not contain an interior NUL");
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m                 unsafe { (sess.driver)(cs.as_ptr()) }
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m /// Execute the same op sequence against a fresh C session and a fresh Rust
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m /// session, comparing the stdout bytes of EVERY individual call.
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m /// Comparing per call (rather than only the concatenation at the end) keeps the
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m /// accumulated `the_house` state under test while still pinpointing the first
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m /// divergence.
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m pub fn diff_sequence(row: &str, ops: &[Op]) {
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m     let c = Session::fresh_c();
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m     let r = Session::fresh_rust();
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m     for (i, op) in ops.iter().enumerate() {
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         let ((), out_c) = capture(|| op.invoke(&c));
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         let ((), out_r) = capture(|| op.invoke(&r));
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         if out_c != out_r {
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m             panic!(
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m                 "[{row}] divergence at op #{i} {}\n  C    ({} bytes): {:?}\n  Rust ({} bytes): {:?}\n  \
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m                  preceding ops: {}",
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m                 op.describe(),
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m                 out_c.len(),
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m                 String::from_utf8_lossy(&out_c),
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m                 out_r.len(),
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m                 String::from_utf8_lossy(&out_r),
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m                 ops[i.saturating_sub(3)..i]
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m                     .iter()
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m                     .map(Op::describe)
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m                     .collect::<Vec<_>>()
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m                     .join(", ")
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m             !out_c.is_empty(),
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m             "[{row}] op #{i} {} produced no output at all — the scenario is not \
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m              exercising the library",
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m             op.describe()
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m /// Like [`diff_sequence`] but each op gets a pristine pair of libraries, so the
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m /// op is observed in isolation from the pristine `{2, 5, 2.5}` state.
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m pub fn diff_each_from_pristine(row: &str, ops: &[Op]) {
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m     for (i, op) in ops.iter().enumerate() {
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m         let c = Session::fresh_c();
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m         let r = Session::fresh_rust();
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m         let ((), out_c) = capture(|| op.invoke(&c));
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m         let ((), out_r) = capture(|| op.invoke(&r));
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m             String::from_utf8_lossy(&out_c),
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m             String::from_utf8_lossy(&out_r),
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m             "[{row}] pristine-state divergence at op #{i} {}",
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m             op.describe()
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m /// Assert that a rejected `driver` call left `the_house` untouched on both
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m /// sides: the follow-up `run(0)` must print the pristine numbers.
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m pub fn diff_rejection_leaves_state_intact(row: &str, bad_inputs: &[&str]) {
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m     for (i, bad) in bad_inputs.iter().enumerate() {
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m         let c = Session::fresh_c();
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m         let r = Session::fresh_rust();
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m         let ((), err_c) = capture(|| Op::driver(bad).invoke(&c));
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m         let ((), err_r) = capture(|| Op::driver(bad).invoke(&r));
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m             String::from_utf8_lossy(&err_c),
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m             String::from_utf8_lossy(&err_r),
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m             "[{row}] rejection output differs for input #{i} {bad:?}"
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m             err_c, b"An error occurred\n",
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m             "[{row}] input #{i} {bad:?} was expected to be rejected by the C \
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m              library but produced: {:?}",
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m             String::from_utf8_lossy(&err_c)
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m         let ((), st_c) = capture(|| Op::Run(0).invoke(&c));
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m         let ((), st_r) = capture(|| Op::Run(0).invoke(&r));
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m             String::from_utf8_lossy(&st_c),
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m             String::from_utf8_lossy(&st_r),
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m             "[{row}] post-rejection state differs for input #{i} {bad:?}"
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m         // Pristine state means the first printed line is the initial house.
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m         let first = st_c.split(|b| *b == b'\n').next().unwrap().to_vec();
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m             String::from_utf8_lossy(&first),
