[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m     pub fn name(&self) -> &'static str {
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m         self.name
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m impl Drop for Session {
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     fn drop(&mut self) {
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m         let _ = std::fs::remove_file(&self.copy_path);
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m // ------------------------------------------------------------------- operations
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m /// One call into the library under test.
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m #[derive(Clone, Debug, PartialEq, Eq)]
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m pub enum Op {
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     /// `run(extra_bedrooms)` — the low-level entry point.
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m     Run(i32),
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m     /// `driver(in)` — the convenience wrapper. Bytes are the C string content
