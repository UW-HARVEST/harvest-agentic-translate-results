import subprocess, sys, os
data=(b'q'*80+b'\n')*20000
for p in sys.argv[1:]:
    r,w=os.pipe()
    proc=subprocess.Popen([p], stdin=subprocess.PIPE, stdout=w, stderr=subprocess.PIPE)
    os.close(w)
    os.read(r,10)
    os.close(r)          # reader goes away -> SIGPIPE / EPIPE
    try:
