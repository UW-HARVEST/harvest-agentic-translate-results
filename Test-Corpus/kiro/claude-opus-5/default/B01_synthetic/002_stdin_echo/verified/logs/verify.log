run() {
  name="$1"; shift
  printf '%s' "$1" > /tmp/in.bin 2>/dev/null || true
  co=$("$C" < /tmp/in.bin 2>/tmp/ce; echo "rc=$?")
  ro=$("$R" < /tmp/in.bin 2>/tmp/re; echo "rc=$?")
  if [ "$co" = "$ro" ] && cmp -s /tmp/ce /tmp/re; then echo "OK    $name"; else echo "DIFF  $name"; echo "  C: $(echo "$co" | od -c | head -3)"; echo "  R: $(echo "$ro" | od -c | head -3)"; fi
}
