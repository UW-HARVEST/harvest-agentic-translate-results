import subprocess, sys
C="c_src/build/driver"; R="translation/target/release/driver"
cases = {
 "nul-mid": b"a\x00b\ncd\n",
 "nul-first": b"\x00abc\ndef\n",
 "nul-only": b"\x00",
 "nul-at-end": b"abc\n\x00",
 "all-nuls": b"\x00"*10,
 "invalid-utf8": bytes([0xff,0xfe,0x80,0x0a,0xc3,0x28,0x0a]),
 "high-bytes-no-nl": bytes(range(1,256)),           # no 0x00, contains 0x0a
 "full-256": bytes(range(0,256)),
 "nul-after-127": b"a"*127 + b"\x00" + b"rest\n",
 "nul-exactly-127th": b"a"*126 + b"\x00" + b"\n",
 "cr-only": b"a\rb\rc",
 "big-10k-nonl": b"x"*10000,
 "big-lines": (b"line\n"*3000),
 "nul-and-long": b"y"*200 + b"\x00" + b"z"*200 + b"\n",
 "eof-mid-127": b"q"*127,
 "utf8-multibyte-split": ("é"*100).encode(),        # 200 bytes, splits a char at 127
}
bad=0
for name,data in cases.items():
    c=subprocess.run([C],input=data,capture_output=True)
    r=subprocess.run([R],input=data,capture_output=True)
    ok = c.stdout==r.stdout and c.stderr==r.stderr and c.returncode==r.returncode
    print(("OK    " if ok else "DIFF  ")+name)
    if not ok:
        bad+=1
        print("  rc", c.returncode, r.returncode)
        print("  C out", c.stdout[:120])
        print("  R out", r.stdout[:120])
        print("  C err", c.stderr[:120], "R err", r.stderr[:120])
sys.exit(1 if bad else 0)
EOF
