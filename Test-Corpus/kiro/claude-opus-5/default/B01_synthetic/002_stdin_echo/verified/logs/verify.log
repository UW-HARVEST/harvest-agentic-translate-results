probe() {
  desc="$1"; shift
  printf '%s' "$1" > /tmp/in.bin
  "$C" < /tmp/in.bin > /tmp/c.out 2>/tmp/c.err; cs=$?
  "$R" < /tmp/in.bin > /tmp/r.out 2>/tmp/r.err; rs=$?
  if cmp -s /tmp/c.out /tmp/r.out && cmp -s /tmp/c.err /tmp/r.err && [ "$cs" = "$rs" ]; then
    echo "OK   $desc (exit=$cs, out=$(stat -c%s /tmp/c.out)B)"
  else
    echo "DIFF $desc  c_exit=$cs r_exit=$rs c_out=$(stat -c%s /tmp/c.out) r_out=$(stat -c%s /tmp/r.out)"
    echo "--- c"; xxd /tmp/c.out | head -5; echo "--- r"; xxd /tmp/r.out | head -5
  fi
}
