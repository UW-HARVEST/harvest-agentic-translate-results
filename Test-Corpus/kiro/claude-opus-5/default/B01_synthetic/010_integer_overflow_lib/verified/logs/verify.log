[49m[38;5;10m+      1[0m:[38;5;10m[49m // Differential tests: load BOTH the C `libdriver.so` and the Rust `libdriver.so`
[0m[49m[38;5;10m+      2[0m:[38;5;10m[49m // through `libloading` and compare their observable behaviour byte-for-byte.
[0m[49m[38;5;10m+      3[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+      4[0m:[38;5;10m[49m // Neither library is ever called as a Rust function. Every call goes through
[0m[49m[38;5;10m+      5[0m:[38;5;10m[49m // `dlsym` on a `.so`, exactly as an external C consumer would do, so the
[0m[49m[38;5;10m+      6[0m:[38;5;10m[49m // `#[unsafe(no_mangle)] extern "C"` export wrappers are themselves under test.
[0m[49m[38;5;10m+      7[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+      8[0m:[38;5;10m[49m // Both `driver` and `printHexCharLine` return `void`; their entire observable
[0m[49m[38;5;10m+      9[0m:[38;5;10m[49m // output is what they write to `stdout` via libc `printf`. The harness below
[0m[49m[38;5;10m+     10[0m:[38;5;10m[49m // therefore captures file descriptor 1 around each call batch.
[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     12[0m:[38;5;10m[49m #![allow(non_snake_case)]
[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m 
