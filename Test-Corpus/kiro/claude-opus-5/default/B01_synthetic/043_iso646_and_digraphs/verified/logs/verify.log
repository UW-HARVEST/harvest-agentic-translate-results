[0m[49m[38;5;10m+      6[0m:[38;5;10m[49m spellings, which de-obfuscates to:
[0m[49m[38;5;10m+      7[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+      8[0m:[38;5;10m[49m ```c
[0m[49m[38;5;10m+      9[0m:[38;5;10m[49m #include <stdio.h>
[0m[49m[38;5;10m+     10[0m:[38;5;10m[49m #include <iso646.h>
