[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m     assert_same_with_args("argv_many", &["-h", "--version", "1", "2"], b"3 4");
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m     assert_same_with_args("argv_empty_input", &["whatever"], b"");
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m /// Immediate EOF on stdin (pipe closed with nothing written).
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m fn stdin_closed_immediately() {
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m     assert_same("stdin_eof", b"");
