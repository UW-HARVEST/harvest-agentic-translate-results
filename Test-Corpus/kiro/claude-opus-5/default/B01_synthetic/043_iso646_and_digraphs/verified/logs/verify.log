[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m // Phase C: buffering boundaries. The Rust reader refills a fixed-size buffer,
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m // so tokens must survive being split across a refill.
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m fn buffer_boundary_cases() {
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m     let mut cases: Vec<(String, Vec<u8>)> = Vec::new();
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m     // A digit run that crosses the 4096-byte refill boundary.
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m     let mut v = vec![b'0'; 4095];
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m     v.extend_from_slice(b"7 9");
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m     cases.push(("digits_span_4096".to_string(), v));
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m     // Whitespace filling exactly one buffer, then the real tokens.
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m     let mut v = vec![b'\n'; 4096];
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m     v.extend_from_slice(b"-5 -9");
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m     cases.push(("ws_fills_4096".to_string(), v));
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m     // A number whose digits straddle the boundary.
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m     let mut v = vec![b' '; 4094];
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m     v.extend_from_slice(b"123456 654321");
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m     cases.push(("number_straddles_boundary".to_string(), v));
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m     // The sign lands on the last byte of the first buffer.
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m     let mut v = vec![b' '; 4095];
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m     v.extend_from_slice(b"-42 -42");
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m     cases.push(("sign_on_boundary".to_string(), v));
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m 
