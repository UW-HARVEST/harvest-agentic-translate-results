[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m     let mut v = vec![b'9'; 10_000];
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m     v.push(b' ');
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m     v.extend(std::iter::repeat(b'8').take(10_000));
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m     cases.push(("ten_thousand_digits_each".to_string(), v));
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m     // Long run of zeros only: converts to 0, second scanf hits EOF.
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m     cases.push(("ten_thousand_zeros".to_string(), vec![b'0'; 10_000]));
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m     // Leading zeros then a significant tail, longer than a buffer.
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m     let mut v = vec![b'0'; 8192];
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m     v.extend_from_slice(b"12345 ");
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m     v.extend(std::iter::repeat(b'0').take(8192));
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m     v.extend_from_slice(b"6789");
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m     cases.push(("long_leading_zeros".to_string(), v));
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m     // Large stream where only the first two tokens matter.
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m     cases.push(("fifty_thousand_tokens".to_string(), b"7 ".repeat(50_000)));
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m     for (label, data) in &cases {
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m         assert_same(label, data);
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m // Phase C: process-level behaviour.
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m 
