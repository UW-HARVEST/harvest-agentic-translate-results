[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m         let inputs: Vec<u32> = (0..n).map(|_| rng.next_u32()).collect();
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         run_batch(&format!("cfg_row14_call_multiplicity(n={n})"), &inputs);
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m 
