[0m[49m[38;5;10m+     67[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     68[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     69[0m:[38;5;10m[49m /// Row C6 — quiet NaNs, both signs, random payloads. The payload must be printed
[0m[49m[38;5;10m+     70[0m:[38;5;10m[49m /// verbatim; nothing in the C code inspects or canonicalises it.
[0m[49m[38;5;10m+     71[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     72[0m:[38;5;10m[49m fn b_c6_quiet_nans() {
[0m[49m[38;5;10m+     73[0m:[38;5;10m[49m     let mut rng = Rng::new(0x0000_0006);
[0m[49m[38;5;10m+     74[0m:[38;5;10m[49m     let mut bits = Vec::with_capacity(4096);
[0m[49m[38;5;10m+     75[0m:[38;5;10m[49m     for _ in 0..4096 {
[0m[49m[38;5;10m+     76[0m:[38;5;10m[49m         let payload = rng.next_u32() & 0x003F_FFFF; // low 22 bits
[0m[49m[38;5;10m+     77[0m:[38;5;10m[49m         let sign = (rng.next_u32() & 1) << 31;
[0m[49m[38;5;10m+     78[0m:[38;5;10m[49m         // exponent all ones + mantissa MSB set => quiet NaN
[0m[49m[38;5;10m+     79[0m:[38;5;10m[49m         bits.push(sign | 0x7FC0_0000 | payload);
[0m[49m[38;5;10m+     80[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     81[0m:[38;5;10m[49m     assert_same("C6 quiet NaNs", &bits);
[0m[49m[38;5;10m+     82[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     83[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     84[0m:[38;5;10m[49m /// Row C7 — signalling NaNs (mantissa MSB clear, remaining mantissa non-zero),
[0m[49m[38;5;10m+     85[0m:[38;5;10m[49m /// both signs, random payloads.
[0m[49m[38;5;10m+     86[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     87[0m:[38;5;10m[49m fn b_c7_signalling_nans() {
[0m[49m[38;5;10m+     88[0m:[38;5;10m[49m     let mut rng = Rng::new(0x0000_0007);
[0m[49m[38;5;10m+     89[0m:[38;5;10m[49m     let mut bits = Vec::with_capacity(4096);
[0m[49m[38;5;10m+     90[0m:[38;5;10m[49m     for _ in 0..4096 {
[0m[49m[38;5;10m+     91[0m:[38;5;10m[49m         let mut payload = rng.next_u32() & 0x003F_FFFF;
[0m[49m[38;5;10m+     92[0m:[38;5;10m[49m         if payload == 0 {
[0m[49m[38;5;10m+     93[0m:[38;5;10m[49m             payload = 1; // a zero payload with the MSB clear would be infinity
[0m[49m[38;5;10m+     94[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     95[0m:[38;5;10m[49m         let sign = (rng.next_u32() & 1) << 31;
[0m[49m[38;5;10m+     96[0m:[38;5;10m[49m         bits.push(sign | 0x7F80_0000 | payload);
[0m[49m[38;5;10m+     97[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     98[0m:[38;5;10m[49m     assert_same("C7 signalling NaNs", &bits);
[0m[49m[38;5;10m+     99[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    100[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    101[0m:[38;5;10m[49m /// Row C8 — the IEEE-754 extremes a real caller is most likely to hit.
[0m[49m[38;5;10m+    102[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    103[0m:[38;5;10m[49m fn b_c8_ieee_extremes() {
[0m[49m[38;5;10m+    104[0m:[38;5;10m[49m     let values: [f32; 12] = [
[0m[49m[38;5;10m+    105[0m:[38;5;10m[49m         f32::MAX,
[0m[49m[38;5;10m+    106[0m:[38;5;10m[49m         f32::MIN,
[0m[49m[38;5;10m+    107[0m:[38;5;10m[49m         f32::MIN_POSITIVE,
[0m[49m[38;5;10m+    108[0m:[38;5;10m[49m         -f32::MIN_POSITIVE,
[0m[49m[38;5;10m+    109[0m:[38;5;10m[49m         f32::EPSILON,
[0m[49m[38;5;10m+    110[0m:[38;5;10m[49m         -f32::EPSILON,
[0m[49m[38;5;10m+    111[0m:[38;5;10m[49m         f32::from_bits(0x0000_0001),  // smallest positive subnormal
[0m[49m[38;5;10m+    112[0m:[38;5;10m[49m         f32::from_bits(0x8000_0001),  // smallest negative subnormal
[0m[49m[38;5;10m+    113[0m:[38;5;10m[49m         f32::from_bits(0x007F_FFFF),  // largest subnormal
[0m[49m[38;5;10m+    114[0m:[38;5;10m[49m         f32::from_bits(0x0080_0000),  // smallest normal
[0m[49m[38;5;10m+    115[0m:[38;5;10m[49m         1.0,
[0m[49m[38;5;10m+    116[0m:[38;5;10m[49m         -1.0,
[0m[49m[38;5;10m+    117[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    118[0m:[38;5;10m[49m     assert_same_floats("C8 IEEE extremes", &values);
[0m[49m[38;5;10m+    119[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    120[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m /// Row C9 — for each of the 4 byte positions, sweep values that place a low
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m /// nibble-only byte (`0x00..=0x0f`) there. This is what `%02x`'s zero padding
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m /// depends on: a translation using `{:x}` without width/fill would emit one
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m /// digit and desynchronise the whole line.
[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m fn b_c9_zero_padding_each_position() {
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m     let mut rng = Rng::new(0x0000_0009);
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m     let mut bits = Vec::new();
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m     for pos in 0..4u32 {
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m         for low in 0x00..=0x0Fu32 {
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m             // Fill the other three bytes randomly, so the padded byte is checked
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m             // in many surrounding contexts rather than just one.
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m             for _ in 0..16 {
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m                 let mut w = rng.next_u32();
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m                 w &= !(0xFF << (8 * pos));
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m                 w |= low << (8 * pos);
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m                 bits.push(w);
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m     assert_same("C9 %02x zero padding per byte position", &bits);
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m /// Row C10 — for each byte position, sweep the high half (`0x80..=0xff`). This is
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m /// the zero-extension check: `p[i]` is `unsigned char`, so it widens to a
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m /// positive `int` and prints as two digits.
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m fn b_c10_high_byte_each_position() {
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m     let mut rng = Rng::new(0x0000_000A);
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m     let mut bits = Vec::new();
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m     for pos in 0..4u32 {
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m         for hi in 0x80..=0xFFu32 {
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m             let mut w = rng.next_u32();
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m             w &= !(0xFF << (8 * pos));
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m             w |= hi << (8 * pos);
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m             bits.push(w);
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m     assert_same("C10 high byte per position", &bits);
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m /// Row C11 — exhaustive per-position sweep: every byte value `0x00..=0xff` at
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m /// every one of the 4 positions. Together with C12 this covers each byte lane's
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m /// full domain.
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m fn b_c11_full_per_position_sweep() {
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m     let mut rng = Rng::new(0x0000_000B);
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m     let mut bits = Vec::with_capacity(4 * 256);
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m     for pos in 0..4u32 {
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m         for byte in 0x00..=0xFFu32 {
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m             let mut w = rng.next_u32();
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m             w &= !(0xFF << (8 * pos));
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m             w |= byte << (8 * pos);
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m             bits.push(w);
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m     assert_same("C11 full per-position byte sweep", &bits);
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m /// Row C12 — uniformly random raw bit patterns. Unbiased across all IEEE classes
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m /// and all byte values simultaneously, which is what catches value-dependent
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m /// formatting bugs that per-class rows can miss.
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m fn b_c12_random_bit_patterns() {
