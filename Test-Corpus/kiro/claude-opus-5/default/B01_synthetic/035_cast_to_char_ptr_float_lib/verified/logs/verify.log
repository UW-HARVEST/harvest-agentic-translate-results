[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m /// Row C14 — exponent sweep: every representable power of two, both signs,
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m /// including the subnormal powers.
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m fn b_c14_exponent_sweep() {
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     let mut values = Vec::new();
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     for e in -149i32..=127 {
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m         let v = (2.0f64).powi(e) as f32;
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m         values.push(v);
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m         values.push(-v);
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m     assert_same_floats("C14 exponent sweep", &values);
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m /// Row C15 — many calls in one capture window. Confirms `driver` is stateless and
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m /// that line framing is identical across a long run (no missing or doubled
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m /// newline that a single-call test would not reveal).
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m fn b_c15_repeated_calls_sequence() {
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m     let mut rng = Rng::new(0x0000_000F);
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m     for _ in 0..8 {
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m         let bits: Vec<u32> = (0..1024).map(|_| rng.next_u32()).collect();
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m         assert_same("C15 repeated calls sequence", &bits);
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m /// Row C16 — both `.so`s loaded at once and called alternately on the *same*
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m /// `stdout` stream, then the two interleaved transcripts compared against each
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m /// other's expected halves. This checks the Rust library shares the process
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m /// `stdout` FILE (rather than owning a private buffer) — if it did not, the
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m /// alternating lines would come out in the wrong order.
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m fn b_c16_interleaved_same_stream() {
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m     let mut rng = Rng::new(0x0000_0010);
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m     let bits: Vec<u32> = (0..1024).map(|_| rng.next_u32()).collect();
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m     let c = common::c_driver();
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     let r = common::rust_driver();
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m     // Alternate C, Rust, C, Rust, ... on the shared stream.
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m     let interleaved = common::capture_stdout(|| {
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m         for &b in &bits {
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m             unsafe {
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m                 c(f32::from_bits(b));
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m                 r(f32::from_bits(b));
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m     let lines: Vec<&[u8]> = interleaved
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         .split(|&b| b == b'\n')
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         .filter(|l| !l.is_empty())
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         .collect();
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m         lines.len(),
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         bits.len() * 2,
