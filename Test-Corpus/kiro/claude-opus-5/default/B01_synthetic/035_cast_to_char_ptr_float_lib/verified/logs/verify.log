[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     for which in libs {
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m         let path = if which == "c" {
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m             std::path::PathBuf::from(env!("CARGO_MANIFEST_DIR"))
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m                 .parent()
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m                 .unwrap()
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m                 .join("c_src/build/libdriver.so")
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m         } else {
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m             let mut p = std::env::current_exe().unwrap();
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m             p.pop();
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m             if p.file_name().and_then(|s| s.to_str()) == Some("deps") {
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m                 p.pop();
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m             p.join("libdriver.so")
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m         let lib = unsafe { libloading::Library::new(&path) }.unwrap();
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m         let sym: Result<libloading::Symbol<unsafe extern "C" fn()>, _> =
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m             unsafe { lib.get(b"print_hex\0") };
