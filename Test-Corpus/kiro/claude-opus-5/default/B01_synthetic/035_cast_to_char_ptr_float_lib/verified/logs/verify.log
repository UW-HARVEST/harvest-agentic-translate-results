[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     let bits: Vec<u32> = (0..65536).map(|_| rng.next_u32()).collect();
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m     assert_same("C12 random bit patterns", &bits);
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m }
