[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m         let c = capture(|| unsafe { (api.c_driver)(x) });
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m         let r = capture(|| unsafe { (api.r_driver)(x) });
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m         assert_eq!(c.len(), 9, "C emitted {} bytes for 0x{b:08x}", c.len());
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m         assert_eq!(r.len(), 9, "Rust emitted {} bytes for 0x{b:08x}", r.len());
