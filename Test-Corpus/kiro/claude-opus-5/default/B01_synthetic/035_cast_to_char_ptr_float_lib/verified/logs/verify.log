[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m         let r = capture(|| unsafe { (api.r_driver)(x) });
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m             c,
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m             r,
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m             "single-call divergence for 0x{b:08x}: C {:?} Rust {:?}",
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m             String::from_utf8_lossy(&c),
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m             String::from_utf8_lossy(&r)
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m         );
