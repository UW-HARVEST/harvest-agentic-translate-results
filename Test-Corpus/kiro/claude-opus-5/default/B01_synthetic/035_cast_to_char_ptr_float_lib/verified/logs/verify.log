[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m fn err_row13_no_pointer_parameter() {
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m     // The public ABI is `void driver(float)`: there is no pointer parameter,
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m     // so a null-pointer rejection cannot be constructed. Assert this
