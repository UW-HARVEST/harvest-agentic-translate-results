[0m[49m[38;5;10m+    15[0m:[38;5;10m[49m     /^\[/           { in_f = 0 }
[0m[49m[38;5;10m+    16[0m:[38;5;10m[49m     in_f && /^[A-Za-z0-9_-]+[[:space:]]*=/ {
[0m[49m[38;5;10m+    17[0m:[38;5;10m[49m       split($0, a, "=");
[0m[49m[38;5;10m+    18[0m:[38;5;10m[49m       gsub(/[[:space:]]/, "", a[1]);
[0m[49m[38;5;10m+    19[0m:[38;5;10m[49m       if (a[1] != "default") print a[1];
[0m[49m[38;5;10m+    20[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    21[0m:[38;5;10m[49m   ' Cargo.toml
[0m[49m[38;5;10m+    22[0m:[38;5;10m[49m )
[0m[49m[38;5;10m+    23[0m:[38;5;10m[49m 
