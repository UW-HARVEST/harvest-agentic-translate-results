[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m fn err_row14_all_bit_patterns_are_valid() {
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     // The C declares no enum / flag / mode parameter, so there is no enum
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m     // value to push out of range. The equivalent boundary is that every one of
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m     // the 2^32 argument bit patterns is a valid input; sweep it densely, and
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m     // include the patterns an out-of-range `int` enum would have produced if
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m     // reinterpreted through this ABI.
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m     let mut inputs: Vec<u32> = vec![
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         0x0000_0000,
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         0x0000_0001,
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         0x7fff_ffff,
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         0x8000_0000,
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m         0xffff_ffff,
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m         0xdead_beef,
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         0xcafe_babe,
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m         // values a bogus C enum argument would carry
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         (-1i32) as u32,
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m         (i32::MIN) as u32,
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         (i32::MAX) as u32,
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m         999_999u32,
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m         0xffff_fff0,
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m     let mut rng = Rng::new(114);
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m     inputs.extend((0..8000).map(|_| rng.next_u32()));
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m     // Dense sweep of the top byte (exponent+sign region) with random low bits.
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m     for hi in 0..=255u32 {
