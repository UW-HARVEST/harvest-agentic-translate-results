[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m /// Row C13 — small integer-valued floats, the ordinary real-world shape.
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m fn b_c13_integral_values() {
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m     let values: Vec<f32> = (-1024..=1024).map(|i| i as f32).collect();
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m     assert_same_floats("C13 integral values", &values);
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m }
