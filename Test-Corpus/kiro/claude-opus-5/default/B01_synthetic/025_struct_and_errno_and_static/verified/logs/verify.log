[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m     prefix_num.extend(std::iter::repeat(b'0').take(8)); // 1000000000, 10 bytes
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m     prefix_num.extend(std::iter::repeat(b'x').take(120));
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m     prefix_num.push(b'\n');
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m     check_all(&[
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m         ("98 nines", &n98),
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m         ("98 nines + newline", &c98),
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m         ("99 nines exactly fills buffer", &n99),
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m         ("99 nines + newline", &c99),
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m         ("200 nines truncated to 99", &c200),
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m         ("truncation splits the number", &split),
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m         ("99 spaces then digit is unreachable", &ws99),
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m         ("99 tabs then digit is unreachable", &tab99),
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m         ("98 spaces then digit is reachable", &ws98),
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m         ("1 followed by 98 zeros", &e98),
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m         ("150 letters", &a150),
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m         ("minus then 99 nines", &neg99),
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m         ("number then 120 letters", &prefix_num),
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m     ]);
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m }
