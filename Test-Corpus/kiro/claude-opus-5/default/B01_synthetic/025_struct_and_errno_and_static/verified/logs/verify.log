[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m     // 95 spaces + "12345": fgets keeps 95 spaces + "1234", dropping the 5.
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m     let mut split = vec![b' '; 95];
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m     split.extend_from_slice(b"12345\n");
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m     // 99 spaces fill the buffer; the digit never arrives -> error path.
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m     let mut ws99 = vec![b' '; 99];
