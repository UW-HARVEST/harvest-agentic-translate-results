#!/bin/bash
C=./c_src/build/driver
R=./translation/target/release/driver
run() {
  local desc="$1"; shift
  printf '%s' "$1" > /tmp/in.bin
  $C < /tmp/in.bin > /tmp/c.out 2>/tmp/c.err; cs=$?
  $R < /tmp/in.bin > /tmp/r.out 2>/tmp/r.err; rs=$?
  if ! cmp -s /tmp/c.out /tmp/r.out || ! cmp -s /tmp/c.err /tmp/r.err || [ "$cs" != "$rs" ]; then
    echo "MISMATCH [$desc] status c=$cs r=$rs"
    echo "--- c stdout"; head -c 300 /tmp/c.out | od -c | head -20
    echo "--- r stdout"; head -c 300 /tmp/r.out | od -c | head -20
    echo "--- c stderr"; cat /tmp/c.err
    echo "--- r stderr"; cat /tmp/r.err
  else
    echo "ok [$desc] status=$cs out=$(head -c 60 /tmp/c.out | tr '\n' ' ')"
  fi
}
