[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     assert_same(
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m         "one hundred newline separated",
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m         &joined(&ints(1..=100), "\n"),
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m }
