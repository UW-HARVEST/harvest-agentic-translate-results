[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m fn signs_and_leading_zeros() {
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m     assert_same("explicit plus", b"+7");
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m     assert_same("plus zero", b"+0");
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m     assert_same("negative zero", b"-0");
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m     assert_same("leading zeros", b"0000000005");
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m     assert_same("many zeros", &b"0".repeat(500));
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m     assert_same("padded items", b"007 -008 +009");
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m fn int_boundaries() {
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m     assert_same("INT_MAX", b"2147483647");
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m     assert_same("INT_MIN", b"-2147483648");
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m     assert_same("INT_MIN + 1", b"-2147483647");
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m     assert_same("both extremes", b"2147483647 -2147483648");
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m     assert_same("INT_MIN twice", b"-2147483648 -2147483648");
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m /// glibc converts `%d` with `strtol` and then narrows to `int`, so values
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m /// beyond the `int` range wrap, and values beyond the `long` range saturate at
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m /// `LONG_MAX`/`LONG_MIN` before being narrowed. Both effects are reproduced.
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m fn conversion_overflow_truncates_and_saturates_like_the_c_does() {
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m     assert_same("INT_MAX + 1", b"2147483648");
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m     assert_same("INT_MIN - 1", b"-2147483649");
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m     assert_same("2^32", b"4294967296");
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m     assert_same("2^32 + 1", b"4294967297");
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m     assert_same("LONG_MAX", b"9223372036854775807");
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m     assert_same("LONG_MIN", b"-9223372036854775808");
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m     assert_same("LONG_MAX + 1", b"9223372036854775808");
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m     assert_same("LONG_MIN - 1", b"-9223372036854775809");
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m     assert_same("2^64", b"18446744073709551616");
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m     assert_same("twenty nines", b"99999999999999999999");
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m     assert_same("negative twenty nines", b"-99999999999999999999");
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m     assert_same("one thousand nines", &b"9".repeat(1000));
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m     let mut neg_thousand = vec![b'-'];
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m     neg_thousand.extend_from_slice(&b"9".repeat(1000));
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m     assert_same("negative one thousand nines", &neg_thousand);
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m     assert_same("LONG_MIN twice", b"-9223372036854775808 -9223372036854775808");
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m // Phase B: the arithmetic in `fma_array`
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m // The single call site is `fma_array(out, out, out, out, len)`, so all four
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m // pointers alias and each element becomes `v * v + v`. Signed overflow wraps
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m // the way the compiled C does.
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m fn arithmetic_around_the_overflow_boundary() {
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m     // 46340^2 fits in an int; 46341^2 does not.
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m     assert_same("just below the square limit", b"46340");
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m     assert_same("just above the square limit", b"46341");
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m     assert_same("negative of each", b"-46340 -46341");
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m     assert_same("powers of two around 2^16", b"65535 65536 65537");
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m     assert_same("large round numbers", b"100000 1000000 1000000000");
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m     assert_same("extremes squared", b"2147483647 -2147483648");
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m     assert_same(
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m         "assorted magnitudes",
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m         b"0 1 -1 2 -2 3 -3 10 -10 32768 -32768 123456 -123456",
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m fn zero_and_one_are_fixed_points_and_output_formatting_matches() {
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m     // `printf("%d\n", ...)` -- one value per line, trailing newline, no padding.
