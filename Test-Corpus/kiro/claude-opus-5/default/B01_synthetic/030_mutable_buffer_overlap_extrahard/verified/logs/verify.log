import random, subprocess, sys
C="./c_src/build/driver"; R="./translation/target/release/driver"
alpha=b"0123456789 \n\t+-xabc.,\r\v\f\x00e*/"
random.seed(1234)
bad=0
def check(data, tag):
    global bad
    a=subprocess.run([C],input=data,capture_output=True)
    b=subprocess.run([R],input=data,capture_output=True)
    if (a.stdout,a.stderr,a.returncode)!=(b.stdout,b.stderr,b.returncode):
        bad+=1
        print("MISMATCH",tag,repr(data[:120]))
        print(" c:",a.returncode,repr(a.stdout[:200]),repr(a.stderr[:200]))
        print(" r:",b.returncode,repr(b.stdout[:200]),repr(b.stderr[:200]))
        if bad>8: sys.exit(1)
for n in range(4000):
    L=random.randint(0,60)
    check(bytes(random.choice(alpha) for _ in range(L)), f"rand{n}")
# structured: random ints incl extremes
for n in range(2000):
    k=random.randint(0,120)
    vals=[]
    for _ in range(k):
        c=random.random()
        if c<0.25: vals.append(random.randint(-2147483648,2147483647))
        elif c<0.5: vals.append(random.randint(-100000,100000))
        elif c<0.7: vals.append(random.choice([0,1,-1,2147483647,-2147483648,46340,46341,-46341,65535,65536,2,-2]))
        elif c<0.85: vals.append(random.randint(-10**25,10**25))
        else: vals.append(random.randint(-10**12,10**12))
    sep=random.choice([b" ",b"\n",b"\t",b"  \n ",b"\r\n"])
    check(sep.join(str(v).encode() for v in vals), f"ints{n}")
# long digit strings
for d in [1,10,18,19,20,25,50,200,1000,5000]:
    check(b"9"*d, f"nines{d}")
    check(b"-"+b"9"*d, f"negnines{d}")
    check(b"0"*d+b"5", f"zeros{d}")
    check(b"-"+b"0"*d+b"5", f"negzeros{d}")
    check(b"+"+b"0"*d+b"7", f"poszeros{d}")
print("done, mismatches:",bad)
EOF
