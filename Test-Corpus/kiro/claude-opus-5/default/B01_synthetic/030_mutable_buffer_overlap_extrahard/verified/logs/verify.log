[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m     assert_same("vertical tab and form feed", b"1\x0b2\x0c3");
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     assert_same("leading whitespace before first item", b"   \n\n  5");
