[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m         b"3.5",
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m         b"99999999999999999999",
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m         b"2147483648",
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m         b"-2147483648",
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m         b"1e5",
