[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m         b"\x00",
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m     // xorshift64* so the case set is reproducible without a dependency.
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m     let mut state: u64 = 0x9E3779B97F4A7C15;
