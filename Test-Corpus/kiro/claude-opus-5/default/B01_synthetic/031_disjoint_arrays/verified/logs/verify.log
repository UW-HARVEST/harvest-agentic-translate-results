[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m         b" ",
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m         b"\t",
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m         b"\n",
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m         b"\r",
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m         b"\x0b",
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m         b"\x0c",
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m         b"+",
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m         b"-",
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m         b"abc",
