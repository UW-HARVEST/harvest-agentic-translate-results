run_cmp() {
  co=$("$C" "$@" 2>/dev/null | md5sum); cs=$?
  "$C" "$@" >/dev/null 2>&1; cs=$?
  ro=$("$R" "$@" 2>/dev/null | md5sum)
  "$R" "$@" >/dev/null 2>&1; rs=$?
  n=$((n+1))
  if [ "$co" != "$ro" ] || [ "$cs" != "$rs" ]; then
    echo "MISMATCH args=[$*] c=($cs,$co) r=($rs,$ro)"; fail=$((fail+1))
  fi
}
