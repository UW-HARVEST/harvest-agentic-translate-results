import random, subprocess, sys
C="./c_src/build/driver"; R="./translation/target/release/driver"
alpha = list("0123456789+-  \t\n\r\x0b\x0cxXeE.,abcZ/:'\"*") + ["\xff","\x80"]
random.seed(1234)
def huge(a):
    # skip args whose output would be gigantic (val truncates near INT_MIN/MAX)
    try:
        import re
        m=re.match(r"^[ \t\n\r\x0b\x0c]*([+-]?)([0-9]+)", a)
        if not m: return False
        v=int(m.group(1)+m.group(2))
        v=max(min(v,2**63-1),-2**63) if abs(v)>=2**63 else v
        v=((v+2**31)%2**32)-2**31
        return v>9 or v< -100000
    except Exception: return True
bad=0; n=0
cases=[]
for _ in range(4000):
    L=random.randint(0,6)
    cases.append("".join(random.choice(alpha) for _ in range(L)))
# multi-arg cases
multi=[[],["1","2"],["a","b","c"],["","",""],["9"]*5]
for a in cases:
    if huge(a): continue
    n+=1
    ca=subprocess.run([C,a],capture_output=True,timeout=20)
    ra=subprocess.run([R,a],capture_output=True,timeout=20)
    if (ca.stdout,ca.stderr,ca.returncode)!=(ra.stdout,ra.stderr,ra.returncode):
        bad+=1; print("DIFF",repr(a)); print(" C",ca.returncode,ca.stdout[:80],ca.stderr[:80]); print(" R",ra.returncode,ra.stdout[:80],ra.stderr[:80])
        if bad>10: break
for args in multi:
    n+=1
    ca=subprocess.run([C]+args,capture_output=True); ra=subprocess.run([R]+args,capture_output=True)
    if (ca.stdout,ca.stderr,ca.returncode)!=(ra.stdout,ra.stderr,ra.returncode):
        bad+=1; print("DIFF multi",args)
print(f"compared {n} cases, {bad} mismatches")
EOF
