import random, subprocess
C="./c_src/build/driver"; R="./translation/target/release/driver"
random.seed(7)
vals=set()
for base in [0,2**31,2**32,2**63,2**64,10**19,10**20,2**33,3*2**32]:
    for d in range(-12,13):
        vals.add(base+d); vals.add(-(base+d))
for _ in range(400):
    vals.add(random.randint(-10**25,10**25))
def trunc(v):
    v = max(min(v, 2**63-1), -2**63)          # strtol saturation
    return ((v+2**31)%2**32)-2**31            # long -> int
cands=[]
for v in vals:
    t=trunc(v)
    if t>9 or t<-2000:   # would print an enormous number of lines
        continue
    cands.append(str(v))
cands += ["0"*30+"9", "+"+"0"*30+"5", "  \t"+"-"+"0"*10+"3"]
bad=0
for a in cands:
    ca=subprocess.run([C,a],capture_output=True,timeout=30)
    ra=subprocess.run([R,a],capture_output=True,timeout=30)
    if (ca.stdout,ca.stderr,ca.returncode)!=(ra.stdout,ra.stderr,ra.returncode):
        bad+=1; print("DIFF",repr(a)); print(" C",ca.returncode,ca.stdout[:60]); print(" R",ra.returncode,ra.stdout[:60])
print(f"compared {len(cands)} numeric-boundary cases, {bad} mismatches")
EOF
