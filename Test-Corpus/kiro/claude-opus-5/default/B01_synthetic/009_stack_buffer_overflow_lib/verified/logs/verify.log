    22	/// Format string `"%s\n"` used by `printLine`.
    23	static FMT_S: [c_char; 4] = [b'%' as c_char, b's' as c_char, b'\n' as c_char, 0];
    24	/// Format string `"%d\n"` used by `printIntLine`.
    25	static FMT_D: [c_char; 4] = [b'%' as c_char, b'd' as c_char, b'\n' as c_char, 0];
    26	
    27	/// C string literal helper: builds a NUL-terminated `[c_char; N + 1]`.
    28	macro_rules! cstr {
    29	    ($bytes:expr) => {{
    30	        const SRC: &[u8] = $bytes;
    31	        const N: usize = SRC.len();
    32	        const BUF: [c_char; N + 1] = {
    33	            let mut buf = [0 as c_char; N + 1];
    34	            let mut i = 0;
    35	            while i < N {
    36	                buf[i] = SRC[i] as c_char;
    37	                i += 1;
    38	            }
    39	            buf
    40	        };
    41	        BUF.as_ptr()
    42	    }};
    43	}
    44	
    45	// void printLine (const char * line)
    46	#[unsafe(no_mangle)]
    47	pub unsafe extern "C" fn printLine(line: *const c_char) {
    48	    if !line.is_null() {
    49	        unsafe {
    50	            printf(FMT_S.as_ptr(), line);
    51	        }
    52	    }
    53	}
    54	
    55	// void printIntLine (int intNumber)
    56	#[unsafe(no_mangle)]
    57	pub unsafe extern "C" fn printIntLine(intNumber: c_int) {
    58	    unsafe {
    59	        printf(FMT_D.as_ptr(), intNumber);
    60	    }
    61	}
    62	
    63	/// Number of `int` slots actually declared by the C source (`int buffer[10]`).
    64	const BUFFER_LEN: usize = 10;
    65	/// The C code writes `buffer[data] = 1` for any non-negative `data`, i.e. it
    66	/// writes out of bounds when `data >= BUFFER_LEN` (CWE-787). That write is
    67	/// undefined behaviour in C; in practice it lands in unused stack space and the
    68	/// function keeps running, printing the ten (still zero) in-bounds elements.
    69	///
    70	/// To reproduce that observable behaviour instead of trapping, the 10-element
    71	/// buffer is backed by a larger zeroed region so the overrun writes into slack
    72	/// memory rather than clobbering the caller's frame. Only the first
    73	/// `BUFFER_LEN` elements are ever read back, exactly as in the C source.
    74	const BUFFER_SLACK: usize = 1024;
