import ctypes, os, sys, tempfile
def run(lib, fn, args):
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:
        os.close(r); os.dup2(w, 1); os.close(w)
        try:
            l = ctypes.CDLL(lib)
            f = getattr(l, fn)
            f.restype = None
            f.argtypes = [ctypes.c_int]*len(args)
            f(*args)
            l.fflush = None
            ctypes.CDLL("libc.so.6").fflush(None)
        except Exception:
            pass
        os._exit(0)
    os.close(w)
    out = b""
    while True:
        c = os.read(r, 65536)
        if not c: break
        out += c
    os.close(r)
    _, st = os.waitpid(pid, 0)
    return out, st

C = sys.argv[1]; R = sys.argv[2]
for n in list(range(-3, 40)) + [64, 100, 255, 256, 1000, 1024, 4096, 100000, 2**30]:
    co, cs = run(C, "bad", [n])
    ro, rs = run(R, "bad", [n])
    same = (co == ro and cs == rs)
    print(f"bad({n:>10}) match={same} cstat={cs:>5} rstat={rs:>5} clen={len(co):>6} rlen={len(ro):>6}"
          + ("" if same else f"\n   C={co[:120]!r}\n   R={ro[:120]!r}"))
EOF
