    76	// void bad(int data)
    77	//
    78	// Faithful reproduction of the original, out-of-bounds write included; the bug
    79	// is preserved, not fixed.
    80	#[unsafe(no_mangle)]
    81	pub unsafe extern "C" fn bad(data: c_int) {
    82	    let mut backing: [c_int; BUFFER_SLACK] = [0; BUFFER_SLACK];
    83	    let buffer = &mut backing[..BUFFER_LEN];
    84	    if data >= 0 {
    85	        // buffer[data] = 1;  (unchecked, exactly as in C)
    86	        unsafe {
    87	            *buffer.as_mut_ptr().offset(data as isize) = 1;
