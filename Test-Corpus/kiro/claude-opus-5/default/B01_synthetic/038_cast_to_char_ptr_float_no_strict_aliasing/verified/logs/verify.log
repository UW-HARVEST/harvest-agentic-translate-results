import struct, random
out=[]
# exact f32 halfway cases: midpoint between consecutive floats
for bits in [0x00000000,0x00000001,0x00000002,0x007fffff,0x00800000,0x00800001,
             0x3f800000,0x3f800001,0x7f7fffff,0x7f7ffffe,0x4b000000,0x4b000001,
             0x33800000,0x0a000000,0x70000000]:
    f=struct.unpack('f',struct.pack('I',bits))[0]
    g=struct.unpack('f',struct.pack('I',bits+1))[0]
    mid=(float(f)+float(g))/2
    for v in (f,g,mid):
        out.append(repr(v))
        out.append('%.60e'%v)
    out.append('%.60e'%(mid*(1+1e-16)))
    out.append('%.60e'%(mid*(1-1e-16)))
# subnormal region
for k in range(1,30):
    out.append('%.40e'%(2.0**-149*k/2))
    out.append('%.40e'%(2.0**-149*(k+0.5)))
# hex long significands
random.seed(7)
for _ in range(200):
    d=''.join(random.choice('0123456789abcdef') for _ in range(random.randrange(14,30)))
    e=random.randrange(-200,150)
    out.append('0x%s.%sp%d'%(d,''.join(random.choice('0123456789abcdef') for _ in range(random.randrange(0,20))),e))
# huge digit strings
out.append('1'+'0'*300)
out.append('0.'+'0'*300+'1')
out.append('1'*400)
out.append('1'*400+'e-400')
out.append('0.'+'9'*400)
out.append('9'*400+'e-800')
out.append('1e1000000000')
out.append('1e1000000001')
out.append('1e-1000000000')
out.append('0x1p1000000000')
out.append('0x1p-1000000000')
for s in out: print(s)
EOF
