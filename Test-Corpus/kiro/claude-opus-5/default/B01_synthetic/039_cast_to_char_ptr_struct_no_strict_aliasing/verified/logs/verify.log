[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m /// The output must not depend on stdout being a terminal or on buffering mode:
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m /// both programs are piped here, and the byte count is fixed.
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m fn output_is_fully_flushed() {
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m     for input in [&b""[..], b"1\n", b"9999999999999999999999\n"] {
