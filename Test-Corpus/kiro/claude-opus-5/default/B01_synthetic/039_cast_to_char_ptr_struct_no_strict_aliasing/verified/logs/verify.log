[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m /// A single ordinary value, with and without a trailing newline.
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m fn single_value() {
