[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         b"\r",
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m         b"\x0b",
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         b"\x0c",
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         b" \t\n\x0b\x0c\r ",
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         let mut input = prefix.to_vec();
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         input.extend_from_slice(b"42\n");
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         assert_same("leading whitespace", &input);
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m /// Every single leading byte, so no character is misclassified as whitespace
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m /// (or as not-whitespace) relative to C.
