[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m /// Whitespace only, i.e. EOF is reached while skipping whitespace.
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m fn whitespace_only_input() {
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     for input in [
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m         &b"\n"[..],
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m         b" ",
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m         b"\t",
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m         b"\r",
