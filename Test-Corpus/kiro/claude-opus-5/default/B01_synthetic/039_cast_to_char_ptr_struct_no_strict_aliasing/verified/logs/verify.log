[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m /// Signs: `%d` accepts an optional leading '+' or '-'.
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m fn signs() {
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     for input in [&b"+7\n"[..], b"-7\n", b"+0\n", b"-0\n", b"+2147483647\n"] {
