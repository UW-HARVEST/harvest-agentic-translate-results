[0m[49m[38;5;10m+    103[0m:[38;5;10m[49m         c.stdout,
[0m[49m[38;5;10m+    104[0m:[38;5;10m[49m         r.stdout,
[0m[49m[38;5;10m+    105[0m:[38;5;10m[49m         "stdout differs for {label} (input {:?})\n  C   : {:?}\n  Rust: {:?}",
[0m[49m[38;5;10m+    106[0m:[38;5;10m[49m         Escaped(stdin),
[0m[49m[38;5;10m+    107[0m:[38;5;10m[49m         Escaped(&c.stdout),
[0m[49m[38;5;10m+    108[0m:[38;5;10m[49m         Escaped(&r.stdout),
[0m[49m[38;5;10m+    109[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    110[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    111[0m:[38;5;10m[49m         c.stderr,
[0m[49m[38;5;10m+    112[0m:[38;5;10m[49m         r.stderr,
[0m[49m[38;5;10m+    113[0m:[38;5;10m[49m         "stderr differs for {label} (input {:?})\n  C   : {:?}\n  Rust: {:?}",
[0m[49m[38;5;10m+    114[0m:[38;5;10m[49m         Escaped(stdin),
[0m[49m[38;5;10m+    115[0m:[38;5;10m[49m         Escaped(&c.stderr),
[0m[49m[38;5;10m+    116[0m:[38;5;10m[49m         Escaped(&r.stderr),
[0m[49m[38;5;10m+    117[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    118[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    119[0m:[38;5;10m[49m         c.status.code(),
[0m[49m[38;5;10m+    120[0m:[38;5;10m[49m         r.status.code(),
[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m         "exit code differs for {label} (input {:?}): C {:?} vs Rust {:?}",
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m         Escaped(stdin),
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m         c.status,
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m         r.status,
[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m     assert_eq!(
