[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m fn every_leading_byte_agrees() {
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m     for b in 0u16..=255 {
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m         let input = [b as u8, b'4', b'2', b'\n'];
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         assert_same(&format!("leading byte 0x{b:02x}"), &input);
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m /// Matching failure: the first non-whitespace character cannot start a number,
