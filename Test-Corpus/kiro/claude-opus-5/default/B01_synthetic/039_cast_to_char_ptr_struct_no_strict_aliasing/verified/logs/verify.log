[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m /// set, including the vertical tab that Rust's `is_ascii_whitespace` omits.
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m fn leading_whitespace_is_skipped() {
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m     for prefix in [
