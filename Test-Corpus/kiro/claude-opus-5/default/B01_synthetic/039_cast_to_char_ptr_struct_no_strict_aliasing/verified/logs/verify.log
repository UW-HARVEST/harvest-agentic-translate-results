[0m[49m[38;5;10m+     74[0m:[38;5;10m[49m /// Run one program with `stdin` piped in, capturing stdout and stderr.
[0m[49m[38;5;10m+     75[0m:[38;5;10m[49m fn run(program: &Path, stdin: &[u8]) -> Output {
[0m[49m[38;5;10m+     76[0m:[38;5;10m[49m     let mut child = Command::new(program)
[0m[49m[38;5;10m+     77[0m:[38;5;10m[49m         .stdin(Stdio::piped())
[0m[49m[38;5;10m+     78[0m:[38;5;10m[49m         .stdout(Stdio::piped())
[0m[49m[38;5;10m+     79[0m:[38;5;10m[49m         .stderr(Stdio::piped())
[0m[49m[38;5;10m+     80[0m:[38;5;10m[49m         .spawn()
[0m[49m[38;5;10m+     81[0m:[38;5;10m[49m         .unwrap_or_else(|e| panic!("failed to spawn {}: {e}", program.display()));
[0m[49m[38;5;10m+     82[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     83[0m:[38;5;10m[49m     {
[0m[49m[38;5;10m+     84[0m:[38;5;10m[49m         let mut sink = child.stdin.take().expect("stdin was piped");
[0m[49m[38;5;10m+     85[0m:[38;5;10m[49m         // A broken pipe is legitimate: the program may exit before draining
[0m[49m[38;5;10m+     86[0m:[38;5;10m[49m         // stdin. That is the same thing a shell would observe, so it is not a
[0m[49m[38;5;10m+     87[0m:[38;5;10m[49m         // test failure.
[0m[49m[38;5;10m+     88[0m:[38;5;10m[49m         let _ = sink.write_all(stdin);
[0m[49m[38;5;10m+     89[0m:[38;5;10m[49m         let _ = sink.flush();
[0m[49m[38;5;10m+     90[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     91[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     92[0m:[38;5;10m[49m     child
[0m[49m[38;5;10m+     93[0m:[38;5;10m[49m         .wait_with_output()
[0m[49m[38;5;10m+     94[0m:[38;5;10m[49m         .unwrap_or_else(|e| panic!("failed to wait for {}: {e}", program.display()))
[0m[49m[38;5;10m+     95[0m:[38;5;10m[49m }
