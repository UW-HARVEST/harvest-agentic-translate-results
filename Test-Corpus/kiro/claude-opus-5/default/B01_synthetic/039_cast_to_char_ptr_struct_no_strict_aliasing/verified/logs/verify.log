[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m         format!("{}", r.status),
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m         "exit status differs for {label} (input {:?})",
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m         Escaped(stdin),
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m /// Debug-printable byte string, so failures stay readable for non-UTF-8 input.
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m struct Escaped<'a>(&'a [u8]);
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m impl std::fmt::Debug for Escaped<'_> {
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m     fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m         f.write_str("\"")?;
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m         for &b in self.0 {
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m             match b {
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m                 b'\\' => f.write_str("\\\\")?,
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m                 b'"' => f.write_str("\\\"")?,
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m                 b'\n' => f.write_str("\\n")?,
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m                 b'\r' => f.write_str("\\r")?,
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m                 b'\t' => f.write_str("\\t")?,
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m                 0x20..=0x7e => f.write_str(&(b as char).to_string())?,
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m                 _ => write!(f, "\\x{b:02x}")?,
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m         f.write_str("\"")
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m // Phase A sanity: the two programs exist and agree on the trivial input.
