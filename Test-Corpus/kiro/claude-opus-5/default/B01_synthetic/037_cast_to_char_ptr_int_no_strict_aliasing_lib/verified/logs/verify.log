[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m         assert_exact(0x8000_0000u32 as c_int, "00000080\n");
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m         // 64-bit values truncated into the 32-bit `int` slot
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m         for wide in [
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m             0x1_0000_0000u64,
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m             0x1_0000_00FFu64,
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m             0xFFFF_FFFF_FFFF_FFFFu64,
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m             0xDEAD_BEEF_CAFE_BABEu64,
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m         ] {
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m             let x = wide as u32 as c_int;
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m             let c = run_one(Impl::C, x);
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m             let r = run_one(Impl::RustRelease, x);
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m             assert_eq!(c, r, "divergence for truncated wide value {wide:#018x}");
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m             assert_eq!(c.len(), 9);
