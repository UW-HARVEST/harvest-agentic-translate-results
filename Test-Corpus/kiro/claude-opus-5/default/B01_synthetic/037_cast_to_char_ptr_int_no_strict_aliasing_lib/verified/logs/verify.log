[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m // `driver` returns `void` and performs no validation whatsoever (see
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m // ERRORS.md: the exhaustive grep for `return`/`assert`/`NULL`/range checks
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m // matches nothing in the C source). Each row therefore asserts the C's ACTUAL
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m // behaviour for that boundary input — that it does NOT reject, and that Rust
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m // reaches the identical non-rejecting result byte-for-byte.
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m mod phase_c {
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m     use super::*;
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m     /// Assert C and Rust agree AND that the C result is exactly `expected`
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m     /// (i.e. a defined, non-error output rather than "both failed somehow").
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m     #[track_caller]
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m     fn assert_exact(x: c_int, expected: &str) {
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m         let c = run_one(Impl::C, x);
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m         let r = run_one(Impl::RustRelease, x);
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m             c,
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m             expected.as_bytes(),
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m             "C sentinel changed for driver({x}): got \"{}\"",
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m             show(&c)
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m         );
