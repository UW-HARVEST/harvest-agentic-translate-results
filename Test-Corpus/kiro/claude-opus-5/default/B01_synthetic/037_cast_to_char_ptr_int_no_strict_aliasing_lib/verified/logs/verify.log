[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m             c,
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m             r,
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m             "error-path divergence for driver({x})\n  C   : \"{}\"\n  Rust: \"{}\"",
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m             show(&c),
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m             show(&r)
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m 
