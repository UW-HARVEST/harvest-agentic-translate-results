[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         let out_c = run_capture_with_pending(&c, val, "PENDING>");
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m         let out_r = run_capture_with_pending(&r, val, "PENDING>");
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m         assert_eq!(
