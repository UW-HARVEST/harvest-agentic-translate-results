[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m             "C read more than the low 32 bits for raw={raw:#x}"
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m /// Row 19 — the two libraries interleaved in one process on the same stream.
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m fn row19_interleaved_c_and_rust() {
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m     let (c, r) = both();
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m     let mut rng = Rng::with_seed(0xFEED_FACE_CAFE_0001);
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m     let vals: Vec<i32> = (0..60).map(|_| rng.range_i32(-200, 200)).collect();
