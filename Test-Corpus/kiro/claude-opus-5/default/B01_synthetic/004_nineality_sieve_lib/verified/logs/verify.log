[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         for &val in &vals {
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m             unsafe { (c.sieve)(val) };
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m     let seq_r = capture(|| {
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m         for &val in &vals {
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m             unsafe { (r.sieve)(val) };
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     assert_eq!(seq_c, seq_r, "sequential-call output diverged");
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m     let concat: Vec<u8> = vals
