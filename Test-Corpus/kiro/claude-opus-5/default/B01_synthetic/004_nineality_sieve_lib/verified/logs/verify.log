[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m fn row18_argument_width_truncation() {
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m     let (c, r) = both();
