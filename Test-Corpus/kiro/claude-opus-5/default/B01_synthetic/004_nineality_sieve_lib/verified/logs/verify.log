[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m             expensive += 1;
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m             assert_same_prefix(&c, &r, val, 4096);
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m     }
