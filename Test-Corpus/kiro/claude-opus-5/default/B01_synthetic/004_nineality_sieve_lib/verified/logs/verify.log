[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m         assert_none_cheap(val);
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m         assert_same_prefix(&c, &r, val, 8192);
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m     }
