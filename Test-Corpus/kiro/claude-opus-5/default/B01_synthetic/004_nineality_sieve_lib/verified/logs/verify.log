[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m /// Row 17 — statelessness. The C has no globals, so 200 sequential calls on one
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m /// handle must behave exactly like 200 independent first calls.
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m fn row17_repeated_calls_are_stateless() {
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m     let (c, r) = both();
