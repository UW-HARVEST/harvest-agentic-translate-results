[0m[49m[38;5;10m+     95[0m:[38;5;10m[49m     for &b in head {
[0m[49m[38;5;10m+     96[0m:[38;5;10m[49m         match b {
[0m[49m[38;5;10m+     97[0m:[38;5;10m[49m             b'\n' => s.push_str("\\n"),
[0m[49m[38;5;10m+     98[0m:[38;5;10m[49m             b'\t' => s.push_str("\\t"),
[0m[49m[38;5;10m+     99[0m:[38;5;10m[49m             b'\r' => s.push_str("\\r"),
[0m[49m[38;5;10m+    100[0m:[38;5;10m[49m             0x20..=0x7e => s.push(b as char),
[0m[49m[38;5;10m+    101[0m:[38;5;10m[49m             _ => s.push_str(&format!("\\x{b:02x}")),
[0m[49m[38;5;10m+    102[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    103[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    104[0m:[38;5;10m[49m     if bytes.len() > LIMIT {
[0m[49m[38;5;10m+    105[0m:[38;5;10m[49m         s.push_str(&format!("...<+{} bytes>", bytes.len() - LIMIT));
[0m[49m[38;5;10m+    106[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    107[0m:[38;5;10m[49m     s
[0m[49m[38;5;10m+    108[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    109[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    110[0m:[38;5;10m[49m /// The single assertion used by every case: stdout, stderr and exit status
[0m[49m[38;5;10m+    111[0m:[38;5;10m[49m /// must all agree.
[0m[49m[38;5;10m+    112[0m:[38;5;10m[49m fn assert_same(case: &str, input: &[u8]) {
[0m[49m[38;5;10m+    113[0m:[38;5;10m[49m     let c = run(&c_bin(), input);
[0m[49m[38;5;10m+    114[0m:[38;5;10m[49m     let r = run(&rust_bin(), input);
[0m[49m[38;5;10m+    115[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    116[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    117[0m:[38;5;10m[49m         c.stdout,
[0m[49m[38;5;10m+    118[0m:[38;5;10m[49m         r.stdout,
[0m[49m[38;5;10m+    119[0m:[38;5;10m[49m         "[{case}] stdout mismatch\n  input : {}\n  C     : {}\n  Rust  : {}\n  \
[0m[49m[38;5;10m+    120[0m:[38;5;10m[49m          C len={} Rust len={}",
[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m         show(input),
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m         show(&c.stdout),
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m         show(&r.stdout),
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m         c.stdout.len(),
[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m         r.stdout.len()
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m         c.stderr,
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m         r.stderr,
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m         "[{case}] stderr mismatch\n  input : {}\n  C     : {}\n  Rust  : {}",
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m         show(input),
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m         show(&c.stderr),
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m         show(&r.stderr)
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m         (c.status, c.signal),
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m         (r.status, r.signal),
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m         "[{case}] exit status mismatch\n  input : {}\n  C     : code={:?} signal={:?}\n  \
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m          Rust  : code={:?} signal={:?}",
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m         show(input),
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m         c.status,
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m         c.signal,
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m         r.status,
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m         r.signal
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m // Phase A sanity: both binaries exist and are runnable.
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m fn both_binaries_are_runnable() {
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m     let c = c_bin();
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m     let r = rust_bin();
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m     assert!(c.is_file(), "C binary missing at {}", c.display());
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m     assert!(r.is_file(), "Rust binary missing at {}", r.display());
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     // A trivial run must succeed for both, otherwise every comparison below
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m     // would be measuring nothing.
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     assert_eq!(run(&c, b"1\n").status, Some(0), "C binary did not exit 0");
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     assert_eq!(run(&r, b"1\n").status, Some(0), "Rust binary did not exit 0");
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m // Phase B: the input classes the C program branches on.
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m // The C is:
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m //     int x = 0; scanf("%d", &x); driver(x); return 0;
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m //     driver: for (i=0, j=0; i < x; i++, j+=2) printf("%d %d\n", i, j);
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m // So the branch space is (1) whether scanf assigns at all, (2) the value it
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m // assigns, and (3) the `i < x` loop guard: zero iterations vs one vs many.
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m /// scanf hits an input failure immediately: nothing is stored, x stays 0,
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m /// the loop body never runs. Zero-iteration path.
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m fn empty_input() {
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m     assert_same("empty input", b"");
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m /// Whitespace-only input: `%d` skips all of it, then hits EOF -> input
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m /// failure, x stays 0.
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m fn whitespace_only_input() {
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     assert_same("spaces only", b"   ");
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m     assert_same("newlines only", b"\n\n\n");
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m     assert_same("mixed whitespace only", b" \t\n\r\x0b\x0c ");
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m /// x == 0 explicitly: loop guard false on the first check.
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m fn zero() {
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m     assert_same("0", b"0");
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m     assert_same("0 with newline", b"0\n");
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     assert_same("-0", b"-0\n");
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m     assert_same("+0", b"+0\n");
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m /// The single-iteration boundary of `i < x`.
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m fn single_item() {
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     assert_same("1", b"1\n");
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m /// A handful of iterations: exercises the `j += 2` stride and the two-column
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m /// printf format.
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m fn small_counts() {
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     for n in 2..=12u32 {
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m         let input = format!("{n}\n");
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m         assert_same(&format!("n={n}"), input.as_bytes());
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m /// Negative x: the loop guard is false immediately, no output.
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m fn negative_values() {
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     assert_same("-1", b"-1\n");
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m     assert_same("-3", b"-3\n");
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m     assert_same("-2147483648 (INT_MIN)", b"-2147483648\n");
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m     assert_same("-2147483647", b"-2147483647\n");
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m /// Column widths change as i and j cross decimal digit boundaries (9->10,
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m /// 99->100, and j crossing them one step earlier than i).
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m fn digit_width_transitions() {
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m     for n in [9u32, 10, 11, 50, 51, 99, 100, 101, 500, 501, 999, 1000, 1001] {
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         let input = format!("{n}\n");
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m         assert_same(&format!("width n={n}"), input.as_bytes());
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m /// A large count, to shake out any stdout buffering or flushing difference
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m /// between C's block-buffered stdout and Rust's BufWriter.
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m fn large_count() {
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     assert_same("n=100000", b"100000\n");
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m // Phase B/C: scanf("%d") parsing behavior. `%d` skips leading whitespace
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m // INCLUDING newlines, accepts an optional sign, consumes digits, and pushes
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m // back the first non-digit. On a matching failure nothing is stored, so `x`
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m // keeps its initializer 0.
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m fn leading_whitespace_is_skipped_across_newlines() {
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m     assert_same("leading spaces", b"    4\n");
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m     assert_same("leading newlines", b"\n\n\n4\n");
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m     assert_same("leading tabs", b"\t\t4\n");
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     assert_same("all whitespace kinds", b" \t\n\r\x0b\x0c4\n");
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m     assert_same("no trailing newline", b"4");
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m fn explicit_plus_sign() {
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m     assert_same("+7", b"+7\n");
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m     assert_same("+0007", b"+0007\n");
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m fn leading_zeros_are_decimal_not_octal() {
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m     assert_same("007", b"007\n");
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m     assert_same("0000000000000000000000000005", b"0000000000000000000000000005\n");
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m fn trailing_junk_after_the_number_is_ignored() {
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m     // Only the first conversion runs; the rest of stdin is never read.
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     assert_same("3 then another number", b"3 99\n");
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m     assert_same("3 then letters", b"3abc\n");
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m     assert_same("3 then newline then more", b"3\n7\n");
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m     assert_same("3 then punctuation", b"3,4\n");
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m     assert_same("3 then dot", b"3.9\n");
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m /// Matching failure paths: scanf returns 0 without assigning, so x stays 0.
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m fn matching_failure_leaves_x_at_zero() {
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m     assert_same("letters", b"abc\n");
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m     assert_same("lone minus", b"-");
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m     assert_same("lone plus", b"+");
