[0m[49m[38;5;10m+     27[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     28[0m:[38;5;10m[49m use std::io::{self, BufRead};
[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m /// `fgets(buf, size, stdin)`.
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+     32[0m:[38;5;10m[49m /// Reads at most `size - 1` bytes from stdin, stopping early after a newline
[0m[49m[38;5;10m+     33[0m:[38;5;10m[49m /// (which is retained). Returns `None` exactly when C `fgets` returns `NULL`,
[0m[49m[38;5;10m+     34[0m:[38;5;10m[49m /// i.e. when end-of-file (or an error) is hit before any byte is stored.
[0m[49m[38;5;10m+     35[0m:[38;5;10m[49m /// Bytes not consumed stay in stdin's buffer for the next call, so a line
[0m[49m[38;5;10m+     36[0m:[38;5;10m[49m /// longer than `size - 1` is picked up piecewise by subsequent calls -- unlike
[0m[49m[38;5;10m+     37[0m:[38;5;10m[49m /// `scanf`, this never reads across a newline.
[0m[49m[38;5;10m+     38[0m:[38;5;10m[49m pub fn fgets(size: usize) -> Option<Vec<u8>> {
[0m[49m[38;5;10m+     39[0m:[38;5;10m[49m     if size == 0 {
[0m[49m[38;5;10m+     40[0m:[38;5;10m[49m         return None;
[0m[49m[38;5;10m+     41[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     42[0m:[38;5;10m[49m     let capacity = size - 1;
[0m[49m[38;5;10m+     43[0m:[38;5;10m[49m     let mut out: Vec<u8> = Vec::new();
[0m[49m[38;5;10m+     44[0m:[38;5;10m[49m     let stdin = io::stdin();
[0m[49m[38;5;10m+     45[0m:[38;5;10m[49m     // `Stdin`'s buffer lives in a global mutex, so it persists across the
[0m[49m[38;5;10m+     46[0m:[38;5;10m[49m     // separate `lock()` calls made by separate `fgets` invocations.
[0m[49m[38;5;10m+     47[0m:[38;5;10m[49m     let mut input = stdin.lock();
[0m[49m[38;5;10m+     48[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     49[0m:[38;5;10m[49m     while out.len() < capacity {
[0m[49m[38;5;10m+     50[0m:[38;5;10m[49m         let available = match input.fill_buf() {
[0m[49m[38;5;10m+     51[0m:[38;5;10m[49m             Ok(buf) => buf,
[0m[49m[38;5;10m+     52[0m:[38;5;10m[49m             Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,
[0m[49m[38;5;10m+     53[0m:[38;5;10m[49m             Err(_) => break,
[0m[49m[38;5;10m+     54[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+     55[0m:[38;5;10m[49m         if available.is_empty() {
[0m[49m[38;5;10m+     56[0m:[38;5;10m[49m             break; // end of file
[0m[49m[38;5;10m+     57[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     58[0m:[38;5;10m[49m         let take = (capacity - out.len()).min(available.len());
[0m[49m[38;5;10m+     59[0m:[38;5;10m[49m         let chunk = &available[..take];
[0m[49m[38;5;10m+     60[0m:[38;5;10m[49m         match chunk.iter().position(|&b| b == b'\n') {
[0m[49m[38;5;10m+     61[0m:[38;5;10m[49m             Some(pos) => {
[0m[49m[38;5;10m+     62[0m:[38;5;10m[49m                 out.extend_from_slice(&chunk[..=pos]);
[0m[49m[38;5;10m+     63[0m:[38;5;10m[49m                 let consumed = pos + 1;
[0m[49m[38;5;10m+     64[0m:[38;5;10m[49m                 input.consume(consumed);
[0m[49m[38;5;10m+     65[0m:[38;5;10m[49m                 return Some(out);
[0m[49m[38;5;10m+     66[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+     67[0m:[38;5;10m[49m             None => {
[0m[49m[38;5;10m+     68[0m:[38;5;10m[49m                 out.extend_from_slice(chunk);
[0m[49m[38;5;10m+     69[0m:[38;5;10m[49m                 input.consume(take);
[0m[49m[38;5;10m+     70[0m:[38;5;10m[49m             }
