[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m |---|:--:|--:|
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m | `driver` loop bound `0..10` → `0..9` | yes | 43 |
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m | `printf` format `"%d\n"` → `"%u\n"` | yes | 21 |
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m | `printf` format `"%d\n"` → `"%d\n\n"` | yes | 25 |
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m | `i * stride` → `i * stride + 1` | yes | 43 |
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m | `SUM.wrapping_add` → `SUM.saturating_add` | yes | 35 |
