import os,pty,sys,select
def run_on_tty(prog):
    pid, fd = pty.fork()
    if pid == 0:
        os.execv(prog, [prog]); os._exit(127)
    data=b""
    try:
        while True:
            r,_,_ = select.select([fd],[],[],2.0)
            if not r: break
            try: chunk = os.read(fd, 4096)
            except OSError: break
            if not chunk: break
            data += chunk
    finally:
        os.close(fd)
    _, status = os.waitpid(pid, 0)
    return data, status
