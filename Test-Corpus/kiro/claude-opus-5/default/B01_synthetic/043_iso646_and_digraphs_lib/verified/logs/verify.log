[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m             let c = Library::new(&c_path)
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m                 .unwrap_or_else(|e| panic!("dlopen {} failed: {e}", c_path.display()));
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m             let rust = Library::new(&rust_path)
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m                 .unwrap_or_else(|e| panic!("dlopen {} failed: {e}", rust_path.display()));
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m             Libs { c, rust, c_path, rust_path }
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m     })
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m type DriverFn = unsafe extern "C" fn(c_int, c_int);
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m /// Same symbol viewed with 64-bit parameters, to probe what the callee does
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m /// with the unspecified upper half of an `int` argument register.
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m type DriverFn64 = unsafe extern "C" fn(i64, i64);
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m /// Same symbol viewed with extra trailing arguments.
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m type DriverFn4 = unsafe extern "C" fn(c_int, c_int, c_int, c_int);
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m fn c_driver() -> Symbol<'static, DriverFn> {
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m     unsafe { libs().c.get(b"driver\0").expect("C .so exports `driver`") }
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m fn rust_driver() -> Symbol<'static, DriverFn> {
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m     unsafe { libs().rust.get(b"driver\0").expect("Rust .so exports `driver`") }
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m // harness: deterministic PRNG (SplitMix64) — fixed seeds, reproducible
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m struct Rng(u64);
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m impl Rng {
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m     fn new(seed: u64) -> Self {
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m         Rng(seed)
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m     fn next_u64(&mut self) -> u64 {
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m         self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m         let mut z = self.0;
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m         z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m         z ^ (z >> 31)
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m     /// Uniform over all 2^32 bit patterns of `i32`.
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m     fn next_i32(&mut self) -> i32 {
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m         self.next_u64() as u32 as i32
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     fn next_positive(&mut self) -> i32 {
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m         (self.next_u64() as u32 & 0x7FFF_FFFF) as i32
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     fn next_negative(&mut self) -> i32 {
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m         (self.next_u64() as u32 | 0x8000_0000) as i32
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m // harness: the differential assertion
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m /// Reference model of the C: `printf("%d", x | ~y); puts("");`
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m fn model(pairs: &[(i32, i32)]) -> Vec<u8> {
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     let mut out = Vec::new();
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m     for &(x, y) in pairs {
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m         out.extend_from_slice(format!("{}\n", x | !y).as_bytes());
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     out
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m /// Drive `pairs` through the C `.so` and the Rust `.so` and require the
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m /// captured `stdout` bytes to be identical.
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m fn assert_same(row: &str, pairs: &[(i32, i32)]) {
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     assert!(!pairs.is_empty(), "{row}: empty input set");
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m     let c = c_driver();
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m     let c_out = capture(|| unsafe {
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m         for &(x, y) in pairs {
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m             c(x, y);
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m     let r = rust_driver();
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m     let r_out = capture(|| unsafe {
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         for &(x, y) in pairs {
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m             r(x, y);
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m     if c_out != r_out {
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m         // Narrow the report down to the first differing call.
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         let c_lines: Vec<&[u8]> = c_out.split(|b| *b == b'\n').collect();
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m         let r_lines: Vec<&[u8]> = r_out.split(|b| *b == b'\n').collect();
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         for (i, (cl, rl)) in c_lines.iter().zip(r_lines.iter()).enumerate() {
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m             if cl != rl {
