[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m                 panic!(
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m                     "{row}: divergence at call #{i} driver({x}, {y}):\n  C   : {:?}\n  Rust: {:?}",
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m                     String::from_utf8_lossy(cl),
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m                     String::from_utf8_lossy(rl)
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         panic!(
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m             "{row}: output length differs: C {} bytes / {} lines, Rust {} bytes / {} lines",
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m             c_out.len(),
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m             c_lines.len(),
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m             r_out.len(),
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m             r_lines.len()
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     }
