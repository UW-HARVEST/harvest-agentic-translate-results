[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m fn scanf_truncates_to_int() {
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m     assert_same_str("INT_MAX + 1", "2147483648");
