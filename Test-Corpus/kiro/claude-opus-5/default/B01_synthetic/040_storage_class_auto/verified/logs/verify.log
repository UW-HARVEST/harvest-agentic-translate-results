[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m             Some(c) => Ok(c),
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m             None => Err(out.status.signal().expect("no exit code and no signal")),
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m         },
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m /// Runs `exe` with `input` on stdin and a stdout pipe whose read end is already
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m /// closed, so the first write fails. Used to compare broken-pipe behavior.
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m fn run_with_closed_stdout(exe: &Path, input: &[u8]) -> Outcome {
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m     use std::os::unix::io::FromRawFd;
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m     extern "C" {
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m         fn pipe(fds: *mut i32) -> i32;
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m         fn close(fd: i32) -> i32;
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m     let mut fds = [0i32; 2];
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m     let rc = unsafe { pipe(fds.as_mut_ptr()) };
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m     assert_eq!(rc, 0, "pipe() failed");
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     let (read_end, write_end) = (fds[0], fds[1]);
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     // SAFETY: `write_end` is a fresh fd owned by us; ownership moves to Stdio.
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     let child_stdout = unsafe { Stdio::from_raw_fd(write_end) };
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m     let mut child = Command::new(exe)
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m         .stdin(Stdio::piped())
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m         .stdout(child_stdout)
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m         .stderr(Stdio::piped())
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m         .spawn()
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m         .unwrap_or_else(|e| panic!("failed to spawn {}: {e}", exe.display()));
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m     // Drop every reader of the pipe so the child's write gets EPIPE/SIGPIPE.
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m         close(read_end);
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m     {
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m         let mut stdin = child.stdin.take().expect("stdin was piped");
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m         let _ = stdin.write_all(input);
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m         let _ = stdin.flush();
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m     let out = child.wait_with_output().expect("failed to wait for child");
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m     Outcome {
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m         stdout: Vec::new(), // went to the broken pipe, not observable
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m         stderr: out.stderr,
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m         status: match out.status.code() {
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m             Some(c) => Ok(c),
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m             None => Err(out.status.signal().expect("no exit code and no signal")),
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m         },
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m // Assertions
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m /// Asserts the C and Rust programs agree on stdout, stderr and exit status.
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m #[track_caller]
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m fn assert_same(label: &str, input: &[u8]) {
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m     let c = c_binary();
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     let expected = run(&c, input);
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     let actual = run(&rust_binary(), input);
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m         expected,
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m         actual,
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m         "\nmismatch for {label}\n  input: {:?}\n  C   : {:?}\n  Rust: {:?}\n",
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m         String::from_utf8_lossy(input),
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m         expected,
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m         actual
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     if let Some(rel) = release_binary() {
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m         let actual = run(&rel, input);
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m             expected,
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m             actual,
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m             "\nmismatch for {label} (release binary)\n  input: {:?}\n  C   : {:?}\n  Rust: {:?}\n",
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m             String::from_utf8_lossy(input),
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m             expected,
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m             actual
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m #[track_caller]
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m fn assert_same_str(label: &str, input: &str) {
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     assert_same(label, input.as_bytes());
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m // Phase B — the inputs the C program branches on
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m // `main` is:      int x = 0; scanf("%d", &x); driver(x); return 0;
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m // `driver` is:    y = 2*x; y += 300; printf("%d\n", y);
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m // The only branch is inside `scanf("%d", &x)`: on input failure or matching
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m // failure it stores nothing and `x` keeps its initializer of 0. Every input
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m // class below is one arm of that conversion.
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
