[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m /// `2*x + 300` overflowing 32-bit int.
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m fn int_arithmetic_overflow_in_driver() {
