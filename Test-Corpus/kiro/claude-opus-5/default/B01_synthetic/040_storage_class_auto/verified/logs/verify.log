[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m /// Neither program should ever write to stderr on any of the input classes.
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m fn stderr_is_always_empty() {
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m     for input in ["", "5", "abc", "-", &"9".repeat(40), "\x00"] {
