[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m     assert_same_str("newline between sign and digits", "-\n5");
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m 
