use std::io::Write;
use std::os::unix::io::FromRawFd;
use std::os::unix::process::ExitStatusExt;
use std::process::{Command, Stdio};

fn main() {
    extern "C" { fn pipe(fds: *mut i32) -> i32; fn close(fd: i32) -> i32; }
    for exe in std::env::args().skip(1) {
        let mut fds = [0i32; 2];
        assert_eq!(unsafe { pipe(fds.as_mut_ptr()) }, 0);
        let (r, w) = (fds[0], fds[1]);
        let mut child = Command::new(&exe)
            .stdin(Stdio::piped())
            .stdout(unsafe { Stdio::from_raw_fd(w) })
            .stderr(Stdio::piped())
            .spawn().unwrap();
        unsafe { close(r); }
        { let mut s = child.stdin.take().unwrap(); let _ = s.write_all(b"5\n"); }
        let out = child.wait_with_output().unwrap();
        println!("{exe}: code={:?} signal={:?} stderr={:?}",
                 out.status.code(), out.status.signal(), String::from_utf8_lossy(&out.stderr));
    }
}
