[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m     assert_same_str("-(2^32 - 1)", "-4294967295");
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m     assert_same_str("10^10", "10000000000");
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m     assert_same_str("-10^10", "-10000000000");
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m     assert_same_str("6442450941", "6442450941");
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m 
