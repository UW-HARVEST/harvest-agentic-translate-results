[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m fn empty_input_from_devnull() {
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m     let c = c_binary();
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m     let expected = {
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         let out = Command::new(&c)
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m             .stdin(Stdio::null())
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m             .output()
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m             .expect("run C with /dev/null stdin");
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m         (out.stdout, out.stderr, out.status.code())
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m     let actual = {
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m         let out = Command::new(rust_binary())
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m             .stdin(Stdio::null())
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m             .output()
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m             .expect("run Rust with /dev/null stdin");
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         (out.stdout, out.stderr, out.status.code())
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m     assert_eq!(expected, actual, "mismatch with stdin = /dev/null");
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m /// A single item, with and without a trailing newline.
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m fn single_value() {
