[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m     assert_same_str("number then many lines", "5\n6\n7\n8\n");
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m     // `%d` stops at the '.', so this reads 1, not 1.5.
