[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m     assert_same_str("INT_MIN", "-2147483648");
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m     // 2*x overflows exactly at 2^30.
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m     assert_same_str("2^30", "1073741824");
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m     assert_same_str("2^30 - 1", "1073741823");
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m     assert_same_str("-2^30", "-1073741824");
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m     assert_same_str("-2^30 - 1", "-1073741825");
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m     // The largest x for which 2*x + 300 does not overflow, and the first that does.
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m     assert_same_str("1073741673", "1073741673");
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m     assert_same_str("1073741674", "1073741674");
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m     assert_same_str("1073741675", "1073741675");
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m /// Values that fit a 64-bit `long` but not an `int`: `scanf` converts with
