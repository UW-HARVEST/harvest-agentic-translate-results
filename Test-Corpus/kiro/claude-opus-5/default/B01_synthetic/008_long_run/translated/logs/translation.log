#include <stdio.h>
#include <stdlib.h>
static inline int f(int x){
    x = x * 3 + 7;
    x = x ^ (x >> 3);
    x = x - (x << 1);
    x = x / 2 + x % 7;
    return x;
}
int main(void){
  int starts[]={1804289383,846930886,0,1,123456789,2147483647,-2147483648,999};
  for(int s=0;s<8;s++){
    // Brent
    long lam=1, power=1; int tort=starts[s], hare=f(starts[s]);
    while(tort!=hare){ if(power==lam){tort=hare;power*=2;lam=0;} hare=f(hare); lam++; if(lam>100000000L){printf("no cycle found\n");break;} }
    // find mu
    tort=starts[s]; hare=starts[s];
    for(long i=0;i<lam;i++) hare=f(hare);
    long mu=0;
    while(tort!=hare){ tort=f(tort); hare=f(hare); mu++; }
    printf("start %11d -> tail(mu)=%ld cycle(lam)=%ld entry=%d\n",starts[s],mu,lam,tort);
  }
  return 0;
}
