[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m         let mut r_prev: Option<Vec<u8>> = None;
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m         for iter in 0..5 {
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m             let cc = c_output(c);
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m             let rr = rust_output(c);
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m             assert_eq!(cc, rr, "row15/repeat divergence c={c} iter={iter}");
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m             if let Some(p) = &c_prev {
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m                 assert_eq!(p, &cc, "row15: C output not idempotent for c={c}");
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m             if let Some(p) = &r_prev {
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m                 assert_eq!(p, &rr, "row15: Rust output not idempotent for c={c}");
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m             c_prev = Some(cc);
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m             r_prev = Some(rr);
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m }
