import ctypes, struct, tempfile, os, random
c = ctypes.CDLL('../c_src/build/libdriver.so')
r = ctypes.CDLL('./target/release/libdriver.so')
libc = ctypes.CDLL('libc.so.6')
for L in (c,r):
    for n in ('bad','good'): getattr(L,n).argtypes=[ctypes.c_float]; getattr(L,n).restype=None
    L.driver.argtypes=[ctypes.c_float,ctypes.c_float]; L.driver.restype=None
def cap(fn):
    libc.fflush(None)
    fd=os.dup(1); tf=tempfile.mkstemp()[1]; f=os.open(tf,os.O_WRONLY)
    os.dup2(f,1)
    try: fn()
    finally:
        libc.fflush(None); os.dup2(fd,1); os.close(fd); os.close(f)
    d=open(tf,'rb').read(); os.unlink(tf); return d
random.seed(20260905)
N=200000
vals=[struct.unpack('f',struct.pack('I',random.getrandbits(32)))[0] for _ in range(N)]
pairs=[(vals[i],vals[(i*7+3)%N]) for i in range(N)]
def batch(L,fn,args):
    def go():
        for a in args: fn(L,a)
    return go
for label, fn, args in [
    ('bad',   lambda L,a: L.bad(a), vals),
    ('good',  lambda L,a: L.good(a), vals),
    ('driver',lambda L,a: L.driver(a[0],a[1]), pairs),
]:
    co=cap(batch(c,fn,args)); ro=cap(batch(r,fn,args))
    print('%-8s %8d inputs  C=%9d B  Rust=%9d B  %s' % (label,len(args),len(co),len(ro),'IDENTICAL' if co==ro else 'DIVERGE'))
    if co!=ro:
        cl=co.split(b'\n'); rl=ro.split(b'\n')
        for i,(x,y) in enumerate(zip(cl,rl)):
            if x!=y: print('  first diff at line',i,x,y); break
