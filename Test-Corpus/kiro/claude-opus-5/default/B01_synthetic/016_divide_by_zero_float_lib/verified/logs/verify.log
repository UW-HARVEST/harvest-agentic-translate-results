import re, io
p='tests/differential.rs'
s=open(p).read()
names=[l.strip() for l in open('/tmp/testnames.txt') if l.strip()]
# strip the #[test] attribute lines
s=re.sub(r'^#\[test\]\n', '', s, flags=re.M)
# header: mark as non-harness binary
s=s.replace('//! Differential tests: C `.so` vs Rust `.so`, both loaded via `libloading`.',
            '//! Differential tests: C `.so` vs Rust `.so`, both loaded via `libloading`.\n//!\n//! Built with `harness = false` (see `Cargo.toml`) and driven by the `main()`\n//! at the bottom of this file. A custom harness is REQUIRED here: each case\n//! captures file descriptor 1 to compare the two libraries byte for byte, and\n//! libtest\'s own progress output (written from a different thread to the same\n//! fd) would otherwise land inside the captured bytes and produce spurious\n//! divergences. `main()` runs every case sequentially and emits its own report\n//! only while fd 1 is not redirected.')
main = ['\n// ===========================================================================\n// Custom harness entry point\n// ===========================================================================\n',
'type Case = (&\'static str, fn());\n',
'const CASES: &[Case] = &[\n']
for n in names:
    main.append(f'    ("{n}", {n}),\n')
main.append('];\n\n')
main.append('''fn main() {
    // Optional substring filter, mirroring `cargo test -- <filter>`.
    let args: Vec<String> = std::env::args().skip(1).filter(|a| !a.starts_with('-')).collect();
    let selected: Vec<&Case> = CASES
        .iter()
        .filter(|(name, _)| args.is_empty() || args.iter().any(|a| name.contains(a.as_str())))
        .collect();

    println!("running {} differential cases", selected.len());
    let mut failed: Vec<&str> = Vec::new();
    let start = std::time::Instant::now();

    for (name, f) in selected {
        // Silence the default panic message; the report below is authoritative.
        let prev = std::panic::take_hook();
        let captured = std::sync::Arc::new(std::sync::Mutex::new(String::new()));
        let sink = std::sync::Arc::clone(&captured);
        std::panic::set_hook(Box::new(move |info| {
            *sink.lock().unwrap() = info.to_string();
        }));
        let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(*f));
        std::panic::set_hook(prev);

        match outcome {
            Ok(()) => println!("ok    {name}"),
            Err(_) => {
                println!("FAIL  {name}");
                println!("{}", captured.lock().unwrap());
                failed.push(name);
            }
        }
    }

    println!(
        "\\nresult: {} passed, {} failed, in {:.2}s",
        selected.len() - failed.len(),
        failed.len(),
        start.elapsed().as_secs_f64()
    );
    if !failed.is_empty() {
        println!("failures:");
        for f in &failed {
            println!("    {f}");
        }
        std::process::exit(1);
    }
}
''')
s = s + ''.join(main)
open(p,'w').write(s)
print("ok", len(names))
