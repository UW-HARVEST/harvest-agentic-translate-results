import re, io

def convert(path, suite):
    s = open(path).read()
    names = re.findall(r'^#\[test\]\n(?:.*\n)*?fn (\w+)\(\)', s, re.M)
    # simpler: find every "#[test]" followed by fn name
    names = re.findall(r'#\[test\]\s*\nfn (\w+)\(\)', s)
    assert names, path
    s = s.replace('#[test]\n', '')
    entries = "".join(f'        ("{n}", {n}),\n' for n in names)
    s += f'\nfn main() {{\n    common::run_suite(\n        "{suite}",\n        &[\n{entries}        ],\n    )\n}}\n'
    open(path, 'w').write(s)
    return names

for path, suite in [("tests/harness.rs", "harness"),
                    ("tests/print_helpers.rs", "print_helpers"),
                    ("tests/driver_api.rs", "driver_api")]:
    print(path, convert(path, suite))

# declare harness = false
t = open('Cargo.toml').read()
t += '''
# libtest is disabled for the differential suites: it prints progress to file
# descriptor 1 from worker threads, which would be picked up by the stdout
# capture used to compare the C and Rust libraries. See tests/common/mod.rs.
[[test]]
name = "harness"
path = "tests/harness.rs"
harness = false

[[test]]
name = "print_helpers"
path = "tests/print_helpers.rs"
harness = false

[[test]]
name = "driver_api"
path = "tests/driver_api.rs"
harness = false
'''
open('Cargo.toml','w').write(t)
