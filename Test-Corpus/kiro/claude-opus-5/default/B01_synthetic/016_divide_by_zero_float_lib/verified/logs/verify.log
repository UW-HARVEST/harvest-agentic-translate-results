=== lib.rs ===
     1	// Rust translation of c_src/src/driver.c (MIT Lincoln Laboratory, 2025).
     2	//
     3	// The original C library is compiled by CMake into a single shared object that
     4	// exports exactly five public symbols:
     5	//
     6	//     printLine, printIntLine, bad, good, driver
     7	//
     8	// `goodG2B` and `goodB2G` are `static` in the C source, so they are *not*
     9	// exported; they are kept private here as well.
    10	//
    11	// Behavioural notes (deliberately reproduced, not "fixed"):
    12	//
    13	//  * `bad()` performs `100.0 / data` with no guard at all, so a zero (or
    14	//    denormal/tiny) `data` produces an infinite/huge double that is then cast to
    15	//    `int`. That cast is undefined behaviour in C; on x86-64 the compiler emits
    16	//    `cvttsd2si`, which returns the "integer indefinite" value `0x80000000`
    17	//    (`-2147483648`) for NaN and for anything outside the `int` range. The C
    18	//    reference binary prints `-2147483648` in those cases, so `to_c_int()`
    19	//    below reproduces that instead of Rust's saturating `as` cast.
    20	//  * `goodB2G()` guards with `fabs(data) > 0.000001`, which is *not* the same as
    21	//    a divide-by-zero check: values such as 5e-07 fall into the "would divide by
    22	//    zero" branch even though the division is finite, and NaN also lands there
    23	//    (all NaN comparisons are false). Left exactly as written.
    24	//  * The division is done in `double`, not `float`: the `float` argument is
    25	//    promoted to `double` and divided into the `double` literal `100.0`.
    26	//
    27	// All printing goes through libc's `printf` so that this library shares the C
    28	// stdio buffer and produces byte-identical, identically-ordered output.
    29	
    30	#![allow(non_snake_case)]
    31	
    32	use std::ffi::c_char;
    33	use std::ffi::c_float;
    34	use std::ffi::c_int;
    35	
    36	extern "C" {
    37	    fn printf(format: *const c_char, ...) -> c_int;
    38	}
    39	
    40	/// `"%s\n"` — the format string used by the C `printLine`.
    41	const FMT_STR_NL: &[u8] = b"%s\n\0";
    42	/// `"%d\n"` — the format string used by the C `printIntLine`.
    43	const FMT_INT_NL: &[u8] = b"%d\n\0";
    44	
    45	/// The message emitted by the C `goodB2G` when its guard rejects `data`.
    46	const DIVIDE_BY_ZERO_MSG: &[u8] = b"This would result in a divide by zero\0";
    47	
    48	/// Truncating `double` -> `int` conversion with x86-64 `cvttsd2si` semantics.
    49	///
    50	/// C's `(int)some_double` is undefined when the truncated value does not fit in
    51	/// an `int`; on x86-64 the hardware yields the "integer indefinite" value
    52	/// `INT_MIN`. Rust's `as` cast instead saturates, so it cannot be used directly
    53	/// if the output is to match the C library byte for byte.
    54	fn to_c_int(value: f64) -> c_int {
    55	    // NaN -> integer indefinite.
    56	    if value.is_nan() {
    57	        return c_int::MIN;
    58	    }
    59	    // Truncation toward zero must land within [-2^31, 2^31 - 1]. Anything at or
    60	    // above 2^31, or at or below -(2^31 + 1), is out of range. Note that values
    61	    // in (-2147483649.0, -2147483648.0] truncate to exactly INT_MIN and are
    62	    // therefore in range.
    63	    if value >= 2_147_483_648.0 || value <= -2_147_483_649.0 {
    64	        return c_int::MIN;
    65	    }
    66	    value as c_int
    67	}
    68	
    69	/// C: `void printLine(const char * line)`
    70	///
    71	/// Prints `line` followed by a newline, but only when the pointer is non-NULL.
    72	#[unsafe(no_mangle)]
    73	pub unsafe extern "C" fn printLine(line: *const c_char) {
    74	    if !line.is_null() {
    75	        printf(FMT_STR_NL.as_ptr() as *const c_char, line);
    76	    }
    77	}
    78	
    79	/// C: `void printIntLine(int intNumber)`
    80	#[unsafe(no_mangle)]
    81	pub unsafe extern "C" fn printIntLine(intNumber: c_int) {
    82	    printf(FMT_INT_NL.as_ptr() as *const c_char, intNumber);
    83	}
    84	
    85	/// C: `void bad(float data)`
    86	///
    87	/// Divides by `data` with no validation whatsoever — the flaw under test.
    88	#[unsafe(no_mangle)]
    89	pub unsafe extern "C" fn bad(data: c_float) {
    90	    let result: c_int = to_c_int(100.0f64 / data as f64);
    91	    printIntLine(result);
    92	}
    93	
    94	/// C: `static void goodG2B(void)`
    95	///
    96	/// Uses a hard-coded, known-safe divisor, so it always prints 50.
    97	unsafe fn goodG2B() {
    98	    let data: c_float = 2.0f32;
    99	    let result: c_int = to_c_int(100.0f64 / data as f64);
   100	    printIntLine(result);
   101	}
   102	
   103	/// C: `static void goodB2G(float data)`
   104	///
   105	/// Screens `data` with `fabs(data) > 0.000001` before dividing.
   106	unsafe fn goodB2G(data: c_float) {
   107	    if (data as f64).abs() > 0.000001 {
   108	        let result: c_int = to_c_int(100.0f64 / data as f64);
   109	        printIntLine(result);
   110	    } else {
   111	        printLine(DIVIDE_BY_ZERO_MSG.as_ptr() as *const c_char);
   112	    }
   113	}
   114	
   115	/// C: `void good(float data)`
   116	#[unsafe(no_mangle)]
   117	pub unsafe extern "C" fn good(data: c_float) {
   118	    goodG2B();
   119	    goodB2G(data);
   120	}
   121	
   122	/// C: `void driver(float goodData, float badData)`
   123	///
   124	/// The public entry point declared in `include/driver.h`.
   125	#[unsafe(no_mangle)]
   126	pub unsafe extern "C" fn driver(goodData: c_float, badData: c_float) {
   127	    printLine(b"Calling good()...\0".as_ptr() as *const c_char);
   128	    good(goodData);
   129	    printLine(b"Finished good()\0".as_ptr() as *const c_char);
   130	    printLine(b"Calling bad()...\0".as_ptr() as *const c_char);
   131	    bad(badData);
   132	    printLine(b"Finished bad()\0".as_ptr() as *const c_char);
   133	}
