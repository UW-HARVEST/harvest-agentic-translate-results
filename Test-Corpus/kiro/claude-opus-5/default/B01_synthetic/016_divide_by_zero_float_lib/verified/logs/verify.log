fn main() {
    // MUT 2: does ANY f32 widen to exactly the double 0.000001?
    // f32 -> f64 is exact, so this asks whether 1e-6_f64 has a 24-bit mantissa.
    let target = 0.000001f64;
    let nearest = target as f32;
    println!("MUT2: nearest f32 to 1e-6 = {:e}, widened = {:.25e}, equal = {}",
             nearest, nearest as f64, (nearest as f64) == target);
    println!("MUT2: 1e-6_f64 bits = {:#018x}  (mantissa low 29 bits = {:#x})",
             target.to_bits(), target.to_bits() & ((1u64<<29)-1));
    // A 24-bit-significand double has its low 29 mantissa bits clear.
    println!("MUT2: representable in f32 exactly = {}", target.to_bits() & ((1u64<<29)-1) == 0);
    // Brute-force the whole neighbourhood to be certain.
    let mut hit = false;
    let base = nearest.to_bits();
    for d in -1_000_000i64..=1_000_000 {
        let x = f32::from_bits((base as i64 + d) as u32);
        if (x as f64) == target || ((x as f64).abs()) == target { hit = true; }
    }
    println!("MUT2: any f32 in +-1e6 ULPs equal to 1e-6 as double: {hit}");

    // MUT 12: for value in (-2147483649.0, -2147483648.0], does the extra
    // early-return change the answer vs plain truncation?
    let mut differ = 0u64;
    let lo = -2147483649.0f64;
    let hi = -2147483648.0f64;
    let mut v = hi;
    for _ in 0..200 {
        // walk downward through consecutive doubles from hi toward lo
        if v <= lo { break; }
        let trunc = v as i32;       // Rust saturating cast
        if trunc != i32::MIN { differ += 1; println!("  differs at {v}: {trunc}"); }
        v = f64::from_bits(v.to_bits() + 1); // more negative
    }
    println!("MUT12: doubles in (-2^31-1, -2^31] whose truncation != INT_MIN: {differ}");
    // And the value that the C code can actually produce there: 100.0/data.
    // Show that no f32 divisor lands strictly inside the interval either way
    // without truncating to INT_MIN.
    let mut bad = 0u64;
    for d in -5000i64..=5000 {
        let c = (100.0f64 / hi) as f32;
        let x = f32::from_bits((c.to_bits() as i64 + d) as u32);
        let q = 100.0f64 / (x as f64);
        if q > lo && q <= hi && (q as i32) != i32::MIN { bad += 1; }
    }
    println!("MUT12: reachable quotients in the interval that do NOT truncate to INT_MIN: {bad}");
}
