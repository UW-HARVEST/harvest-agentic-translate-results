    cases.append(sep.join(parts).encode())
for inp in cases:
    a=run(C,inp); b=run(R,inp)
    if a!=b:
        bad+=1
        print("MISMATCH", inp, a, b)
        if bad>10: break
print("checked",len(cases),"mismatches",bad)
