[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     23[0m:[38;5;10m[49m int main() {
[0m[49m[38;5;10m+     24[0m:[38;5;10m[49m     char in[1000] = "";
