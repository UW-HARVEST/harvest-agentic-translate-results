[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m int foo(const char *in, char c) {         /* count occurrences of c */
[0m[49m[38;5;10m+     12[0m:[38;5;10m[49m     int res = 0;
[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m     for (const char *s = in; s = strchr(s, c); s++) res++;
[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m     return res;
[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     16[0m:[38;5;10m[49m void driver(const char *in) { printf("A: %d\n", foo(in,'A')); printf("x: %d\n", foo(in,'x')); }
