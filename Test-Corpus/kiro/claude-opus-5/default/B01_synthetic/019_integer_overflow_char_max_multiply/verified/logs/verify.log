[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m /// Every power-of-two boundary up to 2^71, in both signs, plus neighbours.
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m fn power_of_two_boundary_sweep() {
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m     let mut values: Vec<i128> = Vec::new();
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m     for bit in 0..72u32 {
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m         let base = 1i128 << bit;
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m         for delta in [-2i128, -1, 0, 1, 2] {
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m             values.push(base + delta);
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m             values.push(-(base + delta));
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m     values.sort_unstable();
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m     values.dedup();
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m     for v in values {
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m         assert_same("power-of-two boundary", v.to_string().as_bytes());
