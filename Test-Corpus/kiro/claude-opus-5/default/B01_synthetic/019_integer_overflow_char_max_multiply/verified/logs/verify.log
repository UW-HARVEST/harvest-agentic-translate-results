[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m         ("2^33 truncates to 0", b"8589934592"),
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m         ("3 * 2^32 truncates to 0", b"12884901888"),
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m         ("LONG_MAX", b"9223372036854775807"),
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m         ("LONG_MAX + 1 saturates", b"9223372036854775808"),
