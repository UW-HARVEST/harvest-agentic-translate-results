[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m             format!("{v}\n{v}\n").as_bytes(),
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m             "{spec}: bad() should re-read printIntPtrLine's spilled pointer"
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m     for v in boundary_i32s() {
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m         assert_same_in_process(&lc, &lr, &format!("pipl_bad:{v}"));
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m     // And once through a fresh process, to confirm it does not depend on the
