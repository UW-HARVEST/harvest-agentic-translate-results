#include <stdio.h>
#include <stdlib.h>
#include <dlfcn.h>
#include <unistd.h>
#include <sys/wait.h>
#include <string.h>

static void run(const char *lib, const char *sym, int arg, int hasarg) {
    for (int i = 0; i < 5; i++) {
        pid_t p = fork();
        if (p == 0) {
            void *h = dlopen(lib, RTLD_NOW);
            if (!h) { fprintf(stderr, "dlopen %s\n", dlerror()); _exit(97); }
            void *f = dlsym(h, sym);
            if (!f) _exit(98);
            fflush(NULL);
            if (hasarg) ((void(*)(int))f)(arg); else ((void(*)(void))f)();
            fflush(NULL);
            _exit(0);
        }
        int st; waitpid(p, &st, 0);
        fprintf(stderr, "  [%s %s%s] ", lib, sym, hasarg?"(0)":"()");
        if (WIFEXITED(st)) fprintf(stderr, "exited %d\n", WEXITSTATUS(st));
        else fprintf(stderr, "signal %d (%s)\n", WTERMSIG(st), strsignal(WTERMSIG(st)));
    }
}
int main(int argc, char**argv){
    run(argv[1], "bad", 0, 0);
    run(argv[1], "driver", 0, 1);
    return 0;
}
EOF
