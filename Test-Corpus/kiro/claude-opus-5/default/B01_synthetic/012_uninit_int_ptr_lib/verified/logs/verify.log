[0m[49m[38;5;10m+    815[0m:[38;5;10m[49m         let text = String::from_utf8_lossy(&out.stdout).into_owned();
[0m[49m[38;5;10m+    816[0m:[38;5;10m[49m         let lines: Vec<&str> = text.lines().collect();
[0m[49m[38;5;10m+    817[0m:[38;5;10m[49m         assert_eq!(lines.len(), 4, "expected four lines, got {text:?}");
[0m[49m[38;5;10m+    818[0m:[38;5;10m[49m         first_values.insert(lines[0].to_string());
[0m[49m[38;5;10m+    819[0m:[38;5;10m[49m         // Calls 2..4 no longer run the resolver and settle on the true slot.
