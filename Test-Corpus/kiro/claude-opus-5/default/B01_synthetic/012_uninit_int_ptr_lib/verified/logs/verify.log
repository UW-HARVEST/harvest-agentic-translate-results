    24	//! Rust translation of `c_src/src/driver.c`.
    25	//!
    26	//! This is a faithful translation, not a fix. The original C demonstrates a
    27	//! CWE-457/CWE-824 defect: `bad()` declares an uninitialized `int *data` and
    28	//! dereferences it. That behaviour is reproduced here rather than corrected,
    29	//! per the translation requirements.
    30	//!
    31	//! Output is emitted through the C library's `printf` (rather than Rust's
    32	//! `std::io::stdout`) so that the bytes written, and their interleaving with
    33	//! output produced by any C caller, are identical to the original: same
    34	//! `%d\n` formatting and the same shared C `stdout` buffer.
    35	
    36	#![allow(non_snake_case)]
    37	
    38	use std::ffi::{c_char, c_int};
    39	use std::mem::MaybeUninit;
    40	
    41	unsafe extern "C" {
    42	    /// `int printf(const char *restrict format, ...);` from the C library.
    43	    ///
    44	    /// Linking against the platform libc directly keeps the exact `stdio`
    45	    /// buffering semantics of the original translation unit.
    46	    fn printf(format: *const c_char, ...) -> c_int;
    47	}
    48	
    49	/// `"%d\n"` as a NUL-terminated C string literal.
    50	const FMT_INT_LINE: &[u8; 4] = b"%d\n\0";
    51	
    52	/// Translation of:
    53	///
    54	/// ```c
    55	/// void printIntPtrLine(const int *intNumber)
    56	/// {
    57	///     printf("%d\n", *intNumber);
    58	/// }
    59	/// ```
    60	///
    61	/// # Safety
    62	///
    63	/// `intNumber` must be a valid, aligned, dereferenceable pointer to an
    64	/// initialized `int`. The original C performs no validation, so none is
    65	/// added here.
    66	#[inline(never)]
    67	#[unsafe(no_mangle)]
    68	pub unsafe extern "C" fn printIntPtrLine(intNumber: *const c_int) {
    69	    unsafe {
    70	        printf(FMT_INT_LINE.as_ptr() as *const c_char, *intNumber);
    71	    }
    72	}
    73	
    74	/// Translation of:
    75	///
    76	/// ```c
    77	/// void bad()
    78	/// {
    79	///     int *data;
    80	///     printIntPtrLine(data);
    81	/// }
    82	/// ```
    83	///
    84	/// The pointer `data` is deliberately left uninitialized before being passed
    85	/// to `printIntPtrLine`, exactly as in the C. This is undefined behaviour in
    86	/// both languages; it is preserved because the defect is the point of this
    87	/// test case.
    88	#[inline(never)]
    89	#[unsafe(no_mangle)]
    90	pub unsafe extern "C" fn bad() {
    91	    // `int *data;` -- a stack slot is reserved and never assigned.
    92	    let slot: MaybeUninit<*const c_int> = MaybeUninit::uninit();
    93	    // Reading it volatile keeps the compiler from folding the `undef` away, so
    94	    // what reaches `printIntPtrLine` is the actual garbage left on the stack --
    95	    // the same thing the unoptimized C passes.
    96	    let data: *const c_int = unsafe { std::ptr::read_volatile(slot.as_ptr()) };
    97	    unsafe {
    98	        printIntPtrLine(data);
    99	    }
   100	}
   101	
   102	/// Translation of:
   103	///
   104	/// ```c
   105	/// void good()
   106	/// {
   107	///     int data;
   108	///     data = 5;
   109	///     int *data_addr;
   110	///     data_addr = &data;
   111	///     printIntPtrLine(data_addr);
   112	/// }
   113	/// ```
   114	///
   115	/// Prints `5\n`.
   116	#[inline(never)]
   117	#[unsafe(no_mangle)]
   118	pub unsafe extern "C" fn good() {
   119	    let data: c_int;
   120	    data = 5;
   121	    let data_addr: *const c_int;
   122	    data_addr = &raw const data;
   123	    unsafe {
   124	        printIntPtrLine(data_addr);
   125	    }
   126	}
   127	
   128	/// Translation of:
   129	///
   130	/// ```c
   131	/// void driver(int useGood)
   132	/// {
   133	///     if (useGood) { good(); } else { bad(); }
   134	/// }
   135	/// ```
   136	///
   137	/// Any nonzero `useGood` selects the `good()` path, matching C truthiness.
   138	#[inline(never)]
   139	#[unsafe(no_mangle)]
   140	pub unsafe extern "C" fn driver(useGood: c_int) {
   141	    unsafe {
   142	        if useGood != 0 {
   143	            good();
   144	        } else {
   145	            bad();
   146	        }
   147	    }
   148	}
