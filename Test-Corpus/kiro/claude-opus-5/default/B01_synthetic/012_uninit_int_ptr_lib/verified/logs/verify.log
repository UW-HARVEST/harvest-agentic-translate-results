[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m // Operation specs, shared by in-process and isolated execution
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m /// One thing to do to a loaded library. Encoded as a string so the parent can
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m /// hand it to a child process verbatim.
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m /// Grammar (`:`-separated):
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m /// * `pipl:<i32>`            — `printIntPtrLine(&v)`, `v` on the stack
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m /// * `pipl_heap:<i32>`       — same, pointer into a heap allocation
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m /// * `pipl_static:<i32>`     — same, pointer into a `static mut`
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m /// * `pipl_idx:<i32>:<n>:<i>`— pointer to element `i` of an `n`-element array
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m /// * `pipl_unaligned:<u32>:<off>` — pointer `off` bytes into a byte buffer
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m /// * `pipl_addr:<usize>`     — `printIntPtrLine(addr)` with a raw address
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m /// * `pipl_null`             — `printIntPtrLine(NULL)`
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m /// * `pipl_unmapped`         — pointer into a page that was mapped then unmapped
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m /// * `pipl_protnone`         — pointer into a `PROT_NONE` page
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m /// * `pipl_writeonly`        — pointer into a `PROT_WRITE`-only page
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m /// * `pipl_straddle`         — 4-byte read straddling the end of a mapping
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m /// * `good`                  — `good()`
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m /// * `bad`                   — `bad()`
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m /// * `bad_bad`               — `bad(); bad();`
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m /// * `good_bad`              — `good(); bad();`
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m /// * `pipl_bad:<i32>`        — `printIntPtrLine(&v); bad();`
