[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m fn child_worker() {
[0m[49m[38;5;10m+     19[0m:[38;5;10m[49m     common::child_entry();
[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     21[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m const SIGSEGV: i32 = 11;
[0m[49m[38;5;10m+     23[0m:[38;5;10m[49m const SIGBUS: i32 = 7;
[0m[49m[38;5;10m+     24[0m:[38;5;10m[49m 
