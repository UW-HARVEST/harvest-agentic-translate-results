[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m // Row 15 — bad() after printIntPtrLine(&v): value-dependent and byte-exact
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m fn row15_bad_after_pipl_exact() {
