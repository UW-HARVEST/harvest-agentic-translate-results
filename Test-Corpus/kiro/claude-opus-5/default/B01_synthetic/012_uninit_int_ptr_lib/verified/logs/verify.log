[0m[49m[38;5;10m+     10[0m:[38;5;10m[49m //! than something that aborts the test run.
[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     12[0m:[38;5;10m[49m mod common;
[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m use common::*;
[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     16[0m:[38;5;10m[49m /// Child-side hook required by `common::run_isolated`.
