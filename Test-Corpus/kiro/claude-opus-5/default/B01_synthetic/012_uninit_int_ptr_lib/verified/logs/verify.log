[0m[49m[38;5;10m+    821[0m:[38;5;10m[49m             &lines[1..],
[0m[49m[38;5;10m+    822[0m:[38;5;10m[49m             ["6", "6", "6"],
[0m[49m[38;5;10m+    823[0m:[38;5;10m[49m             "post-resolver calls should read poison slot 6"
[0m[49m[38;5;10m+    824[0m:[38;5;10m[49m         );
