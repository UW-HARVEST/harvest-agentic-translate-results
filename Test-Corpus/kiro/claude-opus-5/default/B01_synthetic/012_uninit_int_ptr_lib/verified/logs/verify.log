import re, pathlib

# The `#[macro_export] macro_rules! tests` in common/mod.rs resolves as
# `$crate::common::Test`, which only works if `common` is a module of the test
# crate root -- it is (`mod common;`). Strip #[test] attrs and the child_worker
# stubs, then append a main() that lists the checks in declaration order.
for name in ("configs.rs", "errors.rs", "symbols.rs"):
    p = pathlib.Path(name)
    src = p.read_text()

    # Remove the child_worker stub blocks (now handled by run_tests).
    src = re.sub(
        r"/// Child-side hook[^\n]*\n(?:///[^\n]*\n)*#\[test\]\nfn child_worker\(\) \{\n    common::child_entry\(\);\n\}\n\n",
        "", src)

    # Collect test fn names in source order, then drop the attributes.
    names = re.findall(r"#\[test\]\nfn (\w+)\(\)", src)
    src = src.replace("#[test]\n", "")

    assert names, name
    listed = ",\n        ".join(names)
    src += f"""
// ---------------------------------------------------------------------------
// Entry point (`harness = false`; see the comment in Cargo.toml)
// ---------------------------------------------------------------------------
fn main() -> ! {{
    common::run_tests(driver_tests())
}}

fn driver_tests() -> &'static [common::Test] {{
    tests![
        {listed},
    ]
}}
"""
    p.write_text(src)
    print(name, len(names), names)
