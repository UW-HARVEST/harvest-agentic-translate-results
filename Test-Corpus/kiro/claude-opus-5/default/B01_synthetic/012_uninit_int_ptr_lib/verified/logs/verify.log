[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     tmp.seek(SeekFrom::Start(0)).expect("seek");
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     let mut out = Vec::new();
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     tmp.read_to_end(&mut out).expect("read capture");
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     out
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m fn tempfile() -> std::fs::File {
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m     let mut path = std::env::temp_dir();
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m     let n = std::time::SystemTime::now()
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m         .duration_since(std::time::UNIX_EPOCH)
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m         .unwrap()
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m         .as_nanos();
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     path.push(format!("difftest-{}-{}.out", std::process::id(), n));
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     let f = std::fs::OpenOptions::new()
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m         .read(true)
