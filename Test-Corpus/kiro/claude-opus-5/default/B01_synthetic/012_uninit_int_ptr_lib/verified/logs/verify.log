[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m /// Runs `f` with fd 1 redirected to a scratch file and returns everything the
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m /// callee wrote through libc `stdout`.
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m /// `&mut dyn FnMut()` rather than a generic parameter on purpose: there is
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m /// exactly one monomorphisation, so the C and the Rust library are called from
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m /// byte-identical harness code at an identical stack depth. That matters for the
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m /// residue-dependent rows in `CONFIGS.md`.
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m pub fn capture(f: &mut dyn FnMut()) -> Vec<u8> {
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m     use std::io::{Read, Seek, SeekFrom, Write};
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m     // Drain anything the Rust test harness itself has buffered, and anything
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m     // libc has buffered, so it cannot leak into the capture.
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m     std::io::stdout().flush().ok();
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m     unsafe { fflush(std::ptr::null_mut()) };
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m     let mut tmp = tempfile();
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m     let saved = unsafe { dup(1) };
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m     assert!(saved >= 0, "dup(1) failed");
