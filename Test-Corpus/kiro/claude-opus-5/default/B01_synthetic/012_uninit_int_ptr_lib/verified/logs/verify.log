[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m // Row 7 — driver(0): the same defect one frame deeper
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m fn err07_driver_zero_reaches_the_defect() {
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     for _ in 0..6 {
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m         let (c, r) = assert_same_termination("driver:0");
