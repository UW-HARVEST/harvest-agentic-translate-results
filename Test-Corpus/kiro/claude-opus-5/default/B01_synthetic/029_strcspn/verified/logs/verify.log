[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m     // The C program keeps SIGPIPE at SIG_DFL, so writing to a pipe with no
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m     // reader kills it (status: signal 13). The Rust runtime ignores SIGPIPE by
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m     // default, which would silently produce exit 0 instead.
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m     let c = c_bin();
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m     let expected = run_with_closed_stdout(&c, b"abc\nz\n");
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m     let actual = run_with_closed_stdout(Path::new(RUST_BIN), b"abc\nz\n");
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m         expected.status,
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m         Err(13),
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m         "expected the C program to die from SIGPIPE"
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m     assert_eq!(expected, actual, "closed stdout");
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m #[cfg(unix)]
