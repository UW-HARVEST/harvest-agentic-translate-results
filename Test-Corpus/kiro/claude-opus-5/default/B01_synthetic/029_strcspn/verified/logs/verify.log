[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m                 5..=7 => b'a' + rng.below(4) as u8,
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m                 _ => rng.below(256) as u8,
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m             });
