[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m fn full_length_sweep() {
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m     // Every line-1 length from 0..=205, crossed with newline presence and
