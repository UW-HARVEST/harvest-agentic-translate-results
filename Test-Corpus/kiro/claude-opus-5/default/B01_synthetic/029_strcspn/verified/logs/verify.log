[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m // Phase C: deterministic pseudo-random fuzz over arbitrary byte strings.
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m /// xorshift64*, so the corpus is identical on every run and every machine.
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m struct Rng(u64);
