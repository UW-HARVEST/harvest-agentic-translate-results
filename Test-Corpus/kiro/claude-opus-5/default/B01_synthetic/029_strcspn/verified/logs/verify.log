import subprocess
C="c_src/build/driver"; R="translation/target/release/driver"
def run(p, data):
    r=subprocess.run([p], input=data, capture_output=True)
    return (r.stdout, r.stderr, r.returncode)
bad=0
cases=[]
# length sweep on line1 with/without newline, line2 variants
for n in range(0,205):
    for nl in ("\n",""):
        for l2 in ("z\n","\n","","abc\n","q"*120+"\n"):
            cases.append(("a"*n+nl+l2).encode())
# line1 containing a char present in line2 at a late position
for n in range(90,110):
    cases.append(("a"*n+"Z"+"\n"+"Z\n").encode())
    cases.append(("a"*n+"\n"+"a\n").encode())
# nul bytes at various offsets
for n in range(0,102):
    cases.append((b"a"*n+b"\0"+b"bc\n"+b"c\n"))
for c in cases:
    a=run(C,c); b=run(R,c)
    if a!=b:
        bad+=1
        if bad<15: print("DIFF", repr(c[:40]), len(c), a, b)
print("total",len(cases),"diffs",bad)
EOF
