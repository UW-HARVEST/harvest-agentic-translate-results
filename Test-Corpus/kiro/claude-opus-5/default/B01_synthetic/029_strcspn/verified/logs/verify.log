[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m             for tail in tails {
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m                 let mut input = vec![b'a'; n];
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m                 if nl {
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m                     input.push(b'\n');
