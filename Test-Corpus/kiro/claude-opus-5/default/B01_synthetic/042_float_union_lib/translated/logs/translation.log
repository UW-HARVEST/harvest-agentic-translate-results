import random, struct
vals = []
# structural edge cases
for b in [0, 1<<63, 1, (1<<63)|1, 0x000fffffffffffff, 0x0010000000000000,
          0x3ff0000000000000, 0xbff0000000000000, 0x7ff0000000000000, 0xfff0000000000000,
          0x7ff8000000000000, 0xfff8000000000000, 0x7ff0000000000001, 0x7fefffffffffffff,
          0xffefffffffffffff, 0x8000000000000000, 0x0008000000000000, 0x0000000000000010]:
    vals.append(b)
# decimal-ish values incl. rounding ties
for v in [0.0,-0.0,0.5,1.5,2.5,-0.5,0.03125,-0.03125,0.09375,0.15625,0.21875,
          1e-5,5e-5,4.99999e-5,0.00005,1e300,-1e300,1e-300,123456.789,
          3.141592653589793,2.718281828459045,1e17,1e18,1e-17,0.1,0.2,0.3,
          1/3,2/3,1e-320,5e-324,1.7976931348623157e308]:
    vals.append(struct.unpack('<Q', struct.pack('<d', v))[0])
random.seed(1234)
# fully random bit patterns
for _ in range(60000):
    vals.append(random.getrandbits(64))
# random "reasonable magnitude" doubles
for _ in range(40000):
    e = random.randint(-40, 40)
    m = random.uniform(-1, 1) * (10.0 ** e)
    vals.append(struct.unpack('<Q', struct.pack('<d', m))[0])
# values near 4-decimal rounding boundaries
for _ in range(20000):
    k = random.randint(-2000000, 2000000)
    for delta in (0, 1, -1):
        d = (k + 0.5) / 10000.0
        b = struct.unpack('<Q', struct.pack('<d', d))[0] + delta
        vals.append(b & 0xffffffffffffffff)
print("\n".join("%x" % v for v in vals))
EOF
