[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m fn very_large_input() {
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m     let big = vec![b'x'; 1 << 20];
