[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m /// Empty stdin: `fscanf` matches nothing and returns EOF. The C code ignores
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m /// the return value, so `data` keeps its pre-initialised ' ' (0x20) and the
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m /// program prints 0x21. This is the "error path" of the only input operation.
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m fn empty_stdin() {
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m     assert_identical("empty stdin", b"");
