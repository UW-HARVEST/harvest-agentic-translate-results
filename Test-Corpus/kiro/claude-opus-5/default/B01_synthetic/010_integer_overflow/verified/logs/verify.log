[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     for (input, expected) in cases {
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         let c = run(c_binary(), &[input]);
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m             c.stdout, expected,
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m             "C reference changed for input {input:#04x}"
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         let r = run(rust_binary(), &[input]);
