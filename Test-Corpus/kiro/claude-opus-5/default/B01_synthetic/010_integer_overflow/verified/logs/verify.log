[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m /// Pin the sign-extended widths as golden values so a translation that emitted
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m /// two-digit output (e.g. treating the char as unsigned) cannot slip through.
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m fn sign_extension_golden_values() {
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m     let cases: [(u8, &[u8]); 6] = [
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m         (0x00, b"01\n"),
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m         (0x1f, b"20\n"),
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m         (0x7e, b"7f\n"),
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m         (0x7f, b"ffffff80\n"), // -127-1 wraps to -128, printed sign-extended
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m         (0xfe, b"ffffffff\n"),
