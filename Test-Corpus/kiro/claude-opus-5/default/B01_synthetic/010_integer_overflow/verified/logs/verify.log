[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m fn empty_stdin_matches_preinitialised_space_plus_one() {
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m     let c = run(c_binary(), b"");
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m         c.stdout, b"21\n",
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m         "EOF must fall back to the pre-initialised ' ' + 1 == 0x21"
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     assert_identical("empty stdin (golden)", b"");
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m /// A single item: exactly one byte on stdin and nothing else.
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m fn single_byte_printable() {
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m     for b in b'!'..=b'~' {
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m         assert_identical(&format!("single printable byte {b:#04x}"), &[b]);
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m /// Exhaustive over the whole input alphabet: every possible first byte.
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m /// This is the maximum the code can distinguish, so it is fully enumerable.
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m fn every_possible_first_byte() {
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     for b in 0u8..=255 {
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         assert_identical(&format!("first byte {b:#04x}"), &[b]);
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m /// `%c` performs no whitespace skipping, unlike most scanf conversions.
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m /// A leading newline / space / tab must be consumed as data, not skipped.
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m fn whitespace_is_data_not_skipped() {
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     for b in [b'\n', b' ', b'\t', b'\r', 0x0b, 0x0c] {
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m         assert_identical(&format!("leading whitespace {b:#04x}"), &[b]);
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m         // ...and the byte after the whitespace must never be reached.
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m         assert_identical(&format!("whitespace {b:#04x} then 'Z'"), &[b, b'Z']);
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m     }
