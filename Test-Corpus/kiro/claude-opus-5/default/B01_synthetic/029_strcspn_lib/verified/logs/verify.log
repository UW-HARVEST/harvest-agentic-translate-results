use std::ffi::{c_char, c_int};
unsafe extern "C" { fn printf(fmt: *const c_char, ...) -> c_int; }
unsafe fn strcspn(s1: *const c_char, s2: *const c_char) -> usize {
    let mut i: usize = 0;
    loop {
        let c = unsafe { *s1.add(i) };
        if c == 0 { return i; }
        let mut j: usize = 0;
        loop {
            let r = unsafe { *s2.add(j) };
            if r == 0 { break; }
            if r == c { return i; }
            j += 1;
        }
        i += 1;
    }
}
#[unsafe(no_mangle)]
pub unsafe extern "C" fn driver(s1: *const c_char, s2: *const c_char) {
    let n = unsafe { strcspn(s1, s2) };
    unsafe { printf(c"%zu\n".as_ptr(), n); }
}
EOF

