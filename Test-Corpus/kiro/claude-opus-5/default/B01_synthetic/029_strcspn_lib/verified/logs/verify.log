#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <sys/mman.h>
int main(int argc, char**argv){
    int which = atoi(argv[1]);
    if (which == 0) { /* s1="", s2=NULL */
        printf("%zu\n", strcspn("", NULL));
    } else if (which == 1) { /* s1 empty, s2 unmapped */
        char *p = mmap(NULL, 4096, PROT_NONE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);
        printf("%zu\n", strcspn("", p));
    } else if (which == 2) {
        /* s2 = "a" followed immediately by unmapped page (no NUL) -> does glibc scan all of s2 before s1? */
        long pg = 4096;
        char *base = mmap(NULL, 2*pg, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);
        mprotect(base+pg, pg, PROT_NONE);
        char *s2 = base + pg - 2; s2[0]='a'; s2[1]='b'; /* no NUL, runs into PROT_NONE */
        printf("%zu\n", strcspn("aXYZ", s2));
    }
    return 0;
}
EOF
