[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m     // the domain (0x01, 0x7f, 0x80, 0xff).
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m     for b in [1u8, 0x7f, 0x80, 0xff] {
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m         assert_same_bytes(&pair, &mut cap, &[b], &[b]);
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m         assert_same_bytes(&pair, &mut cap, &[b], b"a");
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m         assert_same_bytes(&pair, &mut cap, b"a", &[b]);
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m     // The largest legal reject set (every non-NUL byte) and a maximal-length
