[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m     assert_same_bytes(&pair, &mut cap, b"", b"");
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m     assert_same_bytes(&pair, &mut cap, b"", b"a");
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     assert_same_bytes(&pair, &mut cap, b"a", b"");
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m 
