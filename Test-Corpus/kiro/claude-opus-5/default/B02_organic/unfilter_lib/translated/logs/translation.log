import re
s=open('src/lib.c').read()
def grab(name):
    i=s.index(name)
    j=s.index('{',i); k=s.index('}',j)
    vals=[int(x) for x in re.findall(r'-?\d+', s[j+1:k])]
    return vals
for n in ['cp_fixed_table','cp_permutation_order','cp_len_extra_bits','cp_len_base','cp_dist_extra_bits','cp_dist_base']:
