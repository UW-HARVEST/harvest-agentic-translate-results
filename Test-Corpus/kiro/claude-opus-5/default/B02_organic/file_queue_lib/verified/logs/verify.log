/* Probe the two inputs the differential tests deliberately avoid, in a
   throwaway process so a crash cannot take the test harness down. */
#include <dlfcn.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
typedef struct alert_data { unsigned rule, level; char *alertid,*date,*location,*comment,*group,*srcip; int srcport; char *dstip; int dstport; char *user,*filename; } alert_data;
int main(int argc,char**argv){
  void*h=dlopen(argv[1],RTLD_NOW); if(!h){printf("dlopen: %s\n",dlerror());return 2;}
  alert_data*(*g)(int,FILE*)=dlsym(h,"GetAlertData");
  void(*f)(alert_data*)=dlsym(h,"FreeAlertData");
  FILE*fp=fopen(argv[2],"r"); if(!fp){perror("fopen");return 2;}
  alert_data*a=g(0,fp);
  if(!a){printf("NULL\n");}
  else{printf("filename=%s|group=%s\n",a->filename?a->filename:"(null)",a->group?a->group:"(null)");f(a);}
  fclose(fp);return 0;
}
EOF
