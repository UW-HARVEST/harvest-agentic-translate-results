[0m[49m[38;5;10m+    615[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    616[0m:[38;5;10m[49m fn row18_c23_all_regions() {
[0m[49m[38;5;10m+    617[0m:[38;5;10m[49m     let l = libs();
[0m[49m[38;5;10m+    618[0m:[38;5;10m[49m     let (c_f, r_f) = l.pair::<FnSimplex>("c23");
