/// Prove the loops really iterate: compare a deliberately WRONG pair of symbols
/// and count the mismatches. If the harness were being optimized away this
/// would report zero.
#[test]
fn loops_really_execute() {
    let p = pair();
    let (cNeg, _) = p.get::<FnVV>(b"c2Neg");
    let (_, rSkew) = p.get::<FnVV>(b"c2Skew");
    let mut rng = Rng::new(2);
    let mut diffs = 0u64;
    for _ in 0..1_000_000u64 {
        let a = rng.vec_sym(1.0);
        unsafe {
            if raw(&cNeg(a)) != raw(&rSkew(a)) { diffs += 1; }
        }
    }
    println!("observed {diffs} mismatches out of 1000000");
    assert!(diffs > 990_000, "harness is not actually calling both libraries");
}
EOF
