[0m[49m[38;5;10m+    640[0m:[38;5;10m[49m                 let a = rng.vec(5.0);
[0m[49m[38;5;10m+    641[0m:[38;5;10m[49m                 let d = rng.vec(2.0);
[0m[49m[38;5;10m+    642[0m:[38;5;10m[49m                 cs.verts[0].p = a;
[0m[49m[38;5;10m+    643[0m:[38;5;10m[49m                 cs.verts[1].p = v(a.x + d.x, a.y + d.y);
[0m[49m[38;5;10m+    644[0m:[38;5;10m[49m                 cs.verts[2].p = v(a.x + 2.0 * d.x, a.y + 2.0 * d.y);
