[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m             0 => {
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m                 let dir = rng.vec(1.0);
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m                 cs.verts[0].p = v(dir.x, dir.y);
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m                 cs.verts[1].p = v(dir.x * 3.0, dir.y * 3.0);
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m             // origin beyond b: u <= 0
