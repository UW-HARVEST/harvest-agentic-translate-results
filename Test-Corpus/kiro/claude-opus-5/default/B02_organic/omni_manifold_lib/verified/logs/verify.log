[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m             fs(s.verts[k].u),
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m             vs(s.verts[k].sA),
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m             vs(s.verts[k].sB),
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m             s.verts[k].iA,
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m             s.verts[k].iB
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m     out
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m // ----------------------------------------------------------------------- row 16
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m fn row16_gjk_simplex_metric() {
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m     let l = libs();
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m     let (c_m, r_m) = l.pair::<FnFsimplex>("c2GJKSimplexMetric");
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m     let mut rng = Rng::new(0x2222_3333_4444_5555);
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m     for i in 0..N {
