[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m                 cs.verts[0].p = v(dir.x * 3.0, dir.y * 3.0);
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m                 cs.verts[1].p = v(dir.x, dir.y);
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m             // origin projects inside the edge
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m             _ => {
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m                 let d = rng.vec(1.0);
