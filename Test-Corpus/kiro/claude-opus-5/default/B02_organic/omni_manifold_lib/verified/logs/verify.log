[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m // Simplex helpers — rows 16..21
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m /// Builds a random simplex. `count` is set explicitly; all 4 slots and both
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m /// `sA`/`sB` witnesses are randomized so `c2Witness` has something to mix.
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m fn rand_simplex(rng: &mut Rng, count: c_int, wild: bool) -> c2Simplex {
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m     let mut s = c2Simplex::default();
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m     for k in 0..4 {
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m         s.verts[k] = c2sv {
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m             sA: if wild { rng.wild_vec() } else { rng.vec(50.0) },
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m             sB: if wild { rng.wild_vec() } else { rng.vec(50.0) },
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m             p: if wild { rng.wild_vec() } else { rng.vec(50.0) },
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m             u: if wild { rng.wild() } else { rng.f(5.0) },
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m             iA: rng.below(8) as c_int,
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m             iB: rng.below(8) as c_int,
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m     s.div = if wild { rng.wild() } else { rng.f(5.0) };
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m     s.count = count;
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m     s
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m fn simplex_eq(a: &c2Simplex, b: &c2Simplex) -> bool {
