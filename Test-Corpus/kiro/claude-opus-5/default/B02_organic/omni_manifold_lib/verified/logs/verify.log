[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m // ----------------------------------------------------------------------- row 17
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m fn row17_c22_all_regions() {
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m     let l = libs();
