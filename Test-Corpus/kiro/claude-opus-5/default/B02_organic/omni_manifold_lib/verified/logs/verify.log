        #[repr(C)]
        struct SaveIdx {
            a: [c_int; 3],
            b: [c_int; 3],
        }
        let mut save = SaveIdx { a: [0; 3], b: [0; 3] };
        let save_a: *mut c_int = save.a.as_mut_ptr();
        let save_b: *mut c_int = save.b.as_mut_ptr();"""
assert s.count(old)==1
