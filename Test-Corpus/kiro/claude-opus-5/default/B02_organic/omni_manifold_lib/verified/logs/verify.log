[0m[49m[38;5;10m+    629[0m:[38;5;10m[49m                 cs.verts[1].p = v(o.x + scale, o.y);
[0m[49m[38;5;10m+    630[0m:[38;5;10m[49m                 cs.verts[2].p = v(o.x, o.y + scale);
[0m[49m[38;5;10m+    631[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    632[0m:[38;5;10m[49m             // triangle enclosing the origin (interior region)
[0m[49m[38;5;10m+    633[0m:[38;5;10m[49m             3 => {
[0m[49m[38;5;10m+    634[0m:[38;5;10m[49m                 cs.verts[0].p = v(-1.0 - rng.fpos(3.0), -1.0 - rng.fpos(3.0));
[0m[49m[38;5;10m+    635[0m:[38;5;10m[49m                 cs.verts[1].p = v(1.0 + rng.fpos(3.0), -1.0 - rng.fpos(3.0));
[0m[49m[38;5;10m+    636[0m:[38;5;10m[49m                 cs.verts[2].p = v(rng.f(1.0), 1.0 + rng.fpos(3.0));
[0m[49m[38;5;10m+    637[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    638[0m:[38;5;10m[49m             // degenerate: zero area
