[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m                 cs.verts[0].p = v(n.x - d.x, n.y - d.y);
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m                 cs.verts[1].p = v(n.x + d.x, n.y + d.y);
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m         let mut rs = cs;
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m         unsafe {
