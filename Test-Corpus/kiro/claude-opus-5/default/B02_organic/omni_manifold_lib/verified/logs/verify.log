[0m[49m[38;5;10m+    610[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m     assert!(hit[0] > 0 && hit[1] > 0, "c22 region coverage: {hit:?}");
[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m }
