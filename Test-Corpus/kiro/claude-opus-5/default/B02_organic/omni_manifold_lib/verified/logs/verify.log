[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m         if !veq(x.sA, y.sA)
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m             || !veq(x.sB, y.sB)
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m             || !veq(x.p, y.p)
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m             || !feq(x.u, y.u)
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m             || x.iA != y.iA
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m             || x.iB != y.iB
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m         {
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m             return false;
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m     true
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m 
