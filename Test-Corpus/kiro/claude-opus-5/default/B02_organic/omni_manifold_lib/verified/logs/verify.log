[0m[49m[38;5;10m+     27[0m:[38;5;10m[49m /// The value families used for every manifold row.
[0m[49m[38;5;10m+     28[0m:[38;5;10m[49m /// 0 tame, 1 grid-snapped (exact ties / touching), 2 large, 3 tiny,
[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m /// 4 pathological (inf / NaN / ±0 / FLT_MAX).
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m fn coord(rng: &mut Rng, family: usize) -> f32 {
