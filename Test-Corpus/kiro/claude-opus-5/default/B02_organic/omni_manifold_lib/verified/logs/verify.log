[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m     let mut rng = Rng::new(0x3333_4444_5555_6666);
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m     let mut hit = [0usize; 3];
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m     for i in 0..N {
