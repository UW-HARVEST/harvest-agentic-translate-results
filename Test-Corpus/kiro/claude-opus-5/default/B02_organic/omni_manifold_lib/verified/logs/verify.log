[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m         let mut cs = rand_simplex(&mut rng, count, i % 7 == 0);
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m         let mut rs = cs;
