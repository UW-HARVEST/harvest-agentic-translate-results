# Replace every `den * s.verts[N].u` with mulss(u, den).
import re
before = s
s = re.sub(r"den \* s\.verts\[(\d)\]\.u", r"mulss(s.verts[\1].u, den)", s)
assert s != before
open(p,'w').write(s)
print(s.count("mulss(s.verts"))
