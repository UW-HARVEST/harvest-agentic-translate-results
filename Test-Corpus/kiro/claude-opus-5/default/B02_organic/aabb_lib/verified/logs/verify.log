[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m     let mut rep = Report::new();
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m     for ta in TYPES {
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m         for tb in TYPES {
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m             for i in 0..250 {
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m                 let sep = [0.0, 10.0, 60.0, 200.0][i % 4];
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m                 let A = gen_shape(&mut g, ta, c2v { x: 0.0, y: 0.0 }, 20.0);
