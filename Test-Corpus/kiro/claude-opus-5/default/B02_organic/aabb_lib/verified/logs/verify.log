[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m fn row64_row66_cache_warm_repeat() {
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m     // Call twice with the same cache and the same shapes. The second call takes
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m     // the `cache_was_read` path. Chained through 4 generations so a triangle
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m     // cache (count == 3, row 66) is also fed back in.
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m     let l = libs();
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m     let gjk = Gjk::new(&l);
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m     let mut g = Rng::new(0x40);
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m     let mut rep = Report::new();
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m     let mut counts = [0usize; 5];
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m     for ta in TYPES {
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m         for tb in TYPES {
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m             for i in 0..300 {
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m                 let sep = [0.0, 3.0, 12.0, 70.0, 250.0][i % 5];
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m                 let A = gen_shape(&mut g, ta, c2v { x: 0.0, y: 0.0 }, 15.0);
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m                 let B = gen_shape(&mut g, tb, c2v { x: sep, y: g.sym(sep) }, 15.0);
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m                 let use_radius = (i % 2) as c_int;
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m                 let mut cache = c2GJKCache::default();
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m                 for _gen in 0..4 {
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m                     let call =
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m                         Call { use_radius, cache: Some(cache), ..Default::default() };
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m                     cache = gjk.check(&mut rep, &A, &B, &call);
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m                     if (0..=4).contains(&cache.count) {
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m                         counts[cache.count as usize] += 1;
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m                     }
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m     // Row 66: prove count == 3 caches really were fed back in.
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m     assert!(counts[3] > 100, "no triangle (count==3) cache was exercised: {counts:?}");
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m     assert!(counts[1] > 100 && counts[2] > 100, "cache count coverage too narrow: {counts:?}");
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m     eprintln!("row64/66: cache count histogram (0..4) = {counts:?}");
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m     rep.finish("row64_row66_cache_warm_repeat");
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m fn row65_cache_warm_moved_shapes() {
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m     // Warm the cache on one placement, then reuse it for a *moved* placement of
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m     // the same shape types. Indices stay in range because the proxy vertex count
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m     // depends only on the type, so this is the well-defined `cache_was_read`
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m     // path the C is designed for.
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m     let l = libs();
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m     let gjk = Gjk::new(&l);
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m     let mut g = Rng::new(0x41);
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m     let mut rep = Report::new();
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m     for ta in TYPES {
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m         for tb in TYPES {
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m             for _ in 0..300 {
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m                 let A = gen_shape(&mut g, ta, c2v { x: 0.0, y: 0.0 }, 15.0);
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m                 let B0 = gen_shape(&mut g, tb, c2v { x: 30.0, y: 0.0 }, 15.0);
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m                 let use_radius = g.below(2) as c_int;
[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m                 let mut cache = c2GJKCache::default();
[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m                 cache = gjk.check(
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m                     &mut rep,
[0m[49m[38;5;10m+    603[0m:[38;5;10m[49m                     &A,
[0m[49m[38;5;10m+    604[0m:[38;5;10m[49m                     &B0,
[0m[49m[38;5;10m+    605[0m:[38;5;10m[49m                     &Call { use_radius, cache: Some(cache), ..Default::default() },
[0m[49m[38;5;10m+    606[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    607[0m:[38;5;10m[49m                 // Now nudge B along a path, reusing the warm cache each step.
[0m[49m[38;5;10m+    608[0m:[38;5;10m[49m                 for step in 1..8 {
[0m[49m[38;5;10m+    609[0m:[38;5;10m[49m                     let B = gen_shape(
[0m[49m[38;5;10m+    610[0m:[38;5;10m[49m                         &mut g,
[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m                         tb,
[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m                         c2v { x: 30.0 - step as f32 * 9.0, y: step as f32 * 4.0 },
