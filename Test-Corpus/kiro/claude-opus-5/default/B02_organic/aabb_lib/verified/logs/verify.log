[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m fn row61_touching_midpoint_branch() {
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m     // Shapes whose cores are exactly `rA + rB` apart, or closer: the
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m     // `dist <= rA+rB` / `dist <= FLT_EPSILON` midpoint branch.
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m     let l = libs();
[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m     let gjk = Gjk::new(&l);
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m     let mut g = Rng::new(0x3d);
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m     let mut rep = Report::new();
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m     for _ in 0..1200 {
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m         let rA = g.unit() * 20.0;
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m         let rB = g.unit() * 20.0;
[0m[49m[38;5;10m+    466[0m:[38;5;10m[49m         // Circle cores exactly rA+rB apart along a random axis.
[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m         for scale in [1.0f32, 0.999999, 1.000001, 0.5, 0.0] {
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m             let d = (rA + rB) * scale;
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m             let ang = g.unit() * std::f32::consts::TAU;
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m             let A = Shape::circle(c2Circle { p: c2v { x: 0.0, y: 0.0 }, r: rA });
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m             let B = Shape::circle(c2Circle {
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m                 p: c2v { x: d * ang.cos(), y: d * ang.sin() },
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m                 r: rB,
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m             });
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m             gjk.check(&mut rep, &A, &B, &Call { use_radius: 1, ..Default::default() });
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m             gjk.check(&mut rep, &A, &B, &Call { use_radius: 0, ..Default::default() });
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m         // Identical capsules -> dist == 0 exactly.
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m         let k = c2Capsule { a: g.finite_v(), b: g.finite_v(), r: rA };
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m         let A = Shape::capsule(k);
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m         gjk.check(&mut rep, &A, &A, &Call { use_radius: 1, ..Default::default() });
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m     rep.finish("row61_touching_midpoint_branch");
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m #[test]
