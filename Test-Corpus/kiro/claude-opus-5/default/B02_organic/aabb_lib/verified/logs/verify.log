[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m fn row63_cache_cold() {
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m     // Non-null cache with count == 0: `cache_was_good` is false, so a fresh
