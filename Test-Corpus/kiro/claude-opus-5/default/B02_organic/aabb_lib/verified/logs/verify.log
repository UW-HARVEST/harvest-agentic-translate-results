[0m[49m[38;5;10m+    699[0m:[38;5;10m[49m         (c2v { x: 1.0, y: 2.0 }, c2v { x: nan, y: nan }),
[0m[49m[38;5;10m+    700[0m:[38;5;10m[49m         (c2v { x: nan, y: 2.0 }, c2v { x: 3.0, y: nan }),
