[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m                         let or = invoke(&gjk.rs, &A, &B, &call);
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m                         rep.check(oc.dist == 0.0 && or.dist == 0.0, || {
