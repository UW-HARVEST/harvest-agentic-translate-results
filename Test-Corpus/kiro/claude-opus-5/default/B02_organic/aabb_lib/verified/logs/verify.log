[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m                     iA: [9, -3, 77],
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m                     iB: [-1, 4, 2],
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m                     div: g.sym(10.0),
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m                 for use_radius in [0, 1] {
