"""	B2(c2GJK, float (*)(const void *, C2_TYPE, const c2x *, const void *, C2_TYPE, const c2x *, c2v *, c2v *, int, int *, c2GJKCache *));""")
# new macro
s = s.replace('#define B2(name, T) T name##_c = (T)S(hc, #name), name##_r = (T)S(hr, #name)',
