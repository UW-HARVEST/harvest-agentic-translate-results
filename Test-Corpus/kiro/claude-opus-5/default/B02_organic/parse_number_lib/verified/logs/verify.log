[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m         0xFFF0_0000_0000_0000,
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m         0x0000_0000_0000_0001,
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m         0x8000_0000_0000_0000,
