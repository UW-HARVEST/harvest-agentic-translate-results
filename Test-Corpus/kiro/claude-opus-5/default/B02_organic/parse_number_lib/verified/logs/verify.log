[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m fn e11_return_value_is_exactly_0_or_1() {
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x11E);
[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m     for _ in 0..20_000 {
