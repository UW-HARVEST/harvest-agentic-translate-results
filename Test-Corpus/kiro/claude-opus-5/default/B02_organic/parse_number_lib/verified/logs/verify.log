[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m             content: std::ptr::null(),
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m             length: l,
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m             offset: o,
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m             depth: d,
