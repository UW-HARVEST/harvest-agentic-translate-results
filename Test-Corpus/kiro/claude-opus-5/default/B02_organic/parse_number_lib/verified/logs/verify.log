<             C2_TYPE_CAPSULE => {
<                 let capsule = malloc(std::mem::size_of::<c2Capsule>()) as *mut c2Capsule;
<                 (*capsule).a = c2V(a, b);
<                 (*capsule).b = c2V(c, d);
<                 (*capsule).r = e;
<                 capsule as *mut c_void
<             }
<             _ => std::ptr::null_mut(),
<         }
