[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         for offset in 0..=(text.len() + 4) {
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m             let sc = Scenario::new(text.to_vec())
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m                 .length(length)
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m                 .offset(offset)
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m                 .depth(rng.next_u64() as usize)
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m                 .item(random_item_seed(&mut rng));
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m             assert_same("E5", &sc);
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m             if offset >= length {
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m                 let c = run(c_parse_number(), &sc);
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m                 assert_eq!(c.ret, 0, "[E5] offset={offset} length={length}");
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m                 assert_eq!(c.buf_offset, offset, "[E5] offset must not advance");
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m                 assert_eq!(c.type_, POISON_TYPE);
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m     // length == 0 with a non-empty allocation.
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m     assert_same("E5/zero-length", &Scenario::new(b"12345".to_vec()).length(0));
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m     // length == 0 and offset == 0 with a zero-size allocation.
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m     assert_same("E5/zero-length", &Scenario::new(Vec::new()).length(0));
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m /// `offset + index` uses wrapping `size_t` arithmetic in C — no overflow check.
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m /// With `offset == SIZE_MAX` the bound `offset + 0 < length` is false for every
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m /// `length <= SIZE_MAX`, so the scan collects nothing and both must return
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m /// `false` without dereferencing `content + offset` for a nonzero count.
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m fn e5_size_t_wraparound_offset() {
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m     let data = b"12345\0".to_vec();
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m     for offset in [usize::MAX, usize::MAX - 1, usize::MAX - 5, isize::MAX as usize] {
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m         for length in [0usize, 1, 6, usize::MAX] {
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m             // `offset + 0 < length` must be false, otherwise the C would read
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m             // wild memory and the comparison would be meaningless.
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m             if offset < length {
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m                 continue;
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m             let sc = Scenario::new(data.clone()).length(length).offset(offset);
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m             assert_same("E5/wrap", &sc);
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m             let c = run(c_parse_number(), &sc);
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m             assert_eq!(c.ret, 0, "[E5/wrap] offset={offset} length={length}");
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m             assert_eq!(c.buf_offset, offset);
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m // ------------------------------------------------------------------ E6
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m /// `default: goto loop_end` — the terminator byte and everything after it must
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m /// not reach `strtod`, and bytes at/after `length` must never be read.
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m fn e6_terminator_byte_all_256() {
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m     for prefix in ["1", "12", "-3", "1.5", "9e2", "0", "2147483647", "1e999"] {
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m         for b in 0u16..=255 {
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m             // terminator in the middle of the allocation, more digits after
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m             let mut data = prefix.as_bytes().to_vec();
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m             data.push(b as u8);
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m             data.extend_from_slice(b"999\0");
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m             assert_same("E6", &Scenario::new(data));
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m             // same, but `length` cuts the buffer right at the terminator, so the
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m             // terminator itself is out of bounds and must not be examined
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m             let mut data = prefix.as_bytes().to_vec();
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m             let cut = data.len();
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m             data.push(b as u8);
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m             data.extend_from_slice(b"999\0");
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m             assert_same("E6/cut", &Scenario::new(data).length(cut));
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m // ------------------------------------------------------------------ E7
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m /// `number >= INT_MAX` → `valueint = INT_MAX`.
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m fn e7_saturate_int_max() {
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xE7);
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m     let cases = [
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m         "2147483647", "2147483647.0", "2147483647.5", "2147483648", "2147483649",
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m         "99999999999999999999", "1e999", "1e308", "1e38", "3e9", "2.1474836475e9",
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m         "+2147483647", "+1e999", "21474836470000000000",
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m     for s in cases {
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m         let sc = Scenario::from_str_nul(s);
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m         assert_same("E7", &sc);
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m         let c = run(c_parse_number(), &sc);
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m         assert_eq!(c.ret, 1, "[E7] {s:?} must succeed");
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m         assert_eq!(c.valueint, i32::MAX, "[E7] {s:?} must saturate to INT_MAX");
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m         assert_eq!(c.type_, 8, "[E7] type must be cJSON_Number");
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m     for _ in 0..3000 {
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m         let exp = rng.range_incl(10, 500);
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m         let s = format!("{}e{}", rand_digits_str(&mut rng, 1, 6), exp);
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m         let sc = Scenario::from_str_nul(&s);
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m         assert_same("E7", &sc);
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m         let c = run(c_parse_number(), &sc);
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m         assert_eq!(c.valueint, i32::MAX, "[E7] {s:?}");
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m // ------------------------------------------------------------------ E8
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m /// `number <= (double)INT_MIN` → `valueint = INT_MIN`. Note `<=`: exactly
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m /// `-2147483648.0` takes this branch (the value *is* representable as `int`,
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m /// but the C saturates anyway — replicated, not "fixed").
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m fn e8_saturate_int_min() {
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xE8);
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m     let cases = [
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m         "-2147483648", "-2147483648.0", "-2147483648.5", "-2147483649", "-2147483650",
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m         "-99999999999999999999", "-1e999", "-1e308", "-1e38", "-3e9", "-2.1474836485e9",
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m         "-21474836480000000000",
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m     for s in cases {
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m         let sc = Scenario::from_str_nul(s);
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m         assert_same("E8", &sc);
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m         let c = run(c_parse_number(), &sc);
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m         assert_eq!(c.ret, 1, "[E8] {s:?} must succeed");
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m         assert_eq!(c.valueint, i32::MIN, "[E8] {s:?} must saturate to INT_MIN");
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m         assert_eq!(c.type_, 8);
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m     // The value one ULP above -2147483648.0 must NOT saturate.
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m     let just_inside = "-2147483647.9999998";
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m     let sc = Scenario::from_str_nul(just_inside);
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m     assert_same("E8/just-inside", &sc);
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m     let c = run(c_parse_number(), &sc);
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m     assert_eq!(c.ret, 1);
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m     assert_eq!(c.valueint, -2147483647, "[E8] must truncate, not saturate");
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m     for _ in 0..3000 {
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m         let exp = rng.range_incl(10, 500);
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m         let s = format!("-{}e{}", rand_digits_str(&mut rng, 1, 6), exp);
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m         let sc = Scenario::from_str_nul(&s);
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m         assert_same("E8", &sc);
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m         let c = run(c_parse_number(), &sc);
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m         assert_eq!(c.valueint, i32::MIN, "[E8] {s:?}");
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m // ------------------------------------------------------------------ E9
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m /// The `(int)number` branch is fenced by E7/E8 and by the scan alphabet:
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m /// `nan` / `inf` spellings cannot be produced, so the cast never sees a value
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m /// it cannot represent. Asserted, not assumed.
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m fn e9_int_cast_branch_is_fenced() {
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m     // `nan`, `inf`, `infinity`, hex floats: the scan stops at the first letter
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m     // outside {e,E}, so `strtod` never sees them.
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m     for s in [
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m         "nan", "NAN", "nan(1)", "inf", "INF", "infinity", "INFINITY", "-nan", "-inf", "+inf",
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m         "0x10", "0X1p3", "0x1.8p1", "-0x10",
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m         let sc = Scenario::from_str_nul(s);
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m         assert_same("E9", &sc);
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m         let c = run(c_parse_number(), &sc);
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m         // `0x10` / `0X1p3` parse only the leading `0`; the letter forms are rejected.
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m         if s.as_bytes()[0] == b'0' || s.as_bytes()[0] == b'-' && s.as_bytes()[1] == b'0' {
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m             assert_eq!(c.ret, 1, "[E9] {s:?}");
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m             assert_eq!(c.valueint, 0, "[E9] {s:?} must parse only the leading zero");
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m             assert_eq!(c.valuedouble_bits & !(1u64 << 63), 0, "[E9] {s:?} must be +/-0.0");
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m         } else {
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m             assert_eq!(c.ret, 0, "[E9] {s:?} must be rejected");
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m     // In the `else` branch the value is strictly inside (INT_MIN, INT_MAX) and
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m     // finite: sweep it densely and confirm plain truncation-toward-zero.
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xE9);
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m     for _ in 0..5000 {
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m         let v = rng.next_u64() as i64 % 2147483647;
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m         let frac = rng.below(1_000_000);
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m         let s = format!("{v}.{frac:06}");
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m         let sc = Scenario::from_str_nul(&s);
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m         assert_same("E9/else", &sc);
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m         let c = run(c_parse_number(), &sc);
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m         assert_eq!(c.ret, 1);
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m         let d = f64::from_bits(c.valuedouble_bits);
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m         assert!(d.is_finite(), "[E9] {s:?} must be finite");
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m             c.valueint,
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m             d.trunc() as i32,
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m             "[E9] {s:?} must truncate toward zero"
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m     }
