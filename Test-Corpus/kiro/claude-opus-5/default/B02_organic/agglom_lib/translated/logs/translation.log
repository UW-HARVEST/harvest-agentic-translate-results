import re
lines = open('/local/home/scheschb/.harvest/work/harvest-work-7Xuusu/c_src/src/lib.c').read().split('\n')
# lines are 0-indexed; C line N -> lines[N-1]
def extract(start, end):
    text = '\n'.join(lines[start-1:end])
    vals = re.findall(r'0x[0-9a-fA-F]+', text)
    return vals

mant = extract(493, 834)
off  = extract(836, 843)
expo = extract(845, 856)
print(len(mant), len(off), len(expo))

def emit(name, ty, vals, per):
    out = ["pub static %s: [%s; %d] = [" % (name, ty, len(vals))]
    for i in range(0, len(vals), per):
        out.append("    " + " ".join(v+"," for v in vals[i:i+per]))
    out.append("];")
    return '\n'.join(out)

with open('/local/home/scheschb/.harvest/work/harvest-work-7Xuusu/translation/src/tables.rs','w') as f:
    f.write("//! Lookup tables translated verbatim from the original C source.\n\n")
    f.write(emit("M_MANTISSA", "u32", mant, 6) + "\n\n")
    f.write(emit("M_OFFSET", "u16", off, 8) + "\n\n")
    f.write(emit("M_EXPONENT", "u32", expo, 6) + "\n")
