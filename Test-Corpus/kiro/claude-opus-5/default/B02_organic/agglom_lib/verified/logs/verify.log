[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m             let mut c = args_realistic(&mut g);
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m             c.f12[slot] = n;
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m             diff(&format!("C95 f12[{slot}]=nan"), &c);
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m             let mut d = args_realistic(&mut g);
