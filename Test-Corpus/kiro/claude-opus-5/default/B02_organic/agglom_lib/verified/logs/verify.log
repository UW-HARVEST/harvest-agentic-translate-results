import re
c = open('c_src/src/lib.c').read()
r = open('translation/src/tables.rs').read()

def cnums(text):
    return [int(x,16) for x in re.findall(r'0x[0-9a-fA-F]+', text)]

def cslice(text, start_marker, end_marker='};'):
    i = text.index(start_marker)
    j = text.index(end_marker, i)
    return text[i+len(start_marker):j]

def rslice(text, start_marker):
    i = text.index(start_marker)
    j = text.index('\n];', i)
    return text[i+len(start_marker):j]

pairs = [
  ('static const tflac_u16 tflac_crc16_tables[8][256] = {', 'pub static TFLAC_CRC16_TABLES: [[u16; 256]; 8] = [', 8*256),
  ('static uint32_t m__mantissa[2048] = {', 'pub static M_MANTISSA: [u32; 2048] = [', 2048),
  ('static uint16_t m__offset[64] = {', 'pub static M_OFFSET: [u16; 64] = [', 64),
  ('static uint32_t m__exponent[64] = {', 'pub static M_EXPONENT: [u32; 64] = [', 64),
]
ok=True
for cm, rm, n in pairs:
    cv = cnums(cslice(c, cm))
    rv = cnums(rslice(r, rm))
    status = "OK" if cv==rv and len(cv)==n else "MISMATCH"
    if status!="OK": ok=False
    print(f"{rm.split(':')[0][11:]:25s} C={len(cv)} R={len(rv)} expect={n} -> {status}")
    if cv!=rv:
        for k,(a,b) in enumerate(zip(cv,rv)):
            if a!=b:
                print(f"   first diff at {k}: C=0x{a:x} R=0x{b:x}")
                break
print("ALL TABLES OK" if ok else "TABLE PROBLEM")
EOF[0m[38;5;244m (using tool: shell)[0m
