mod common;
use common::*;
#[test]
fn probe() {
    let c = &libs().c;
    let mut rng = Rng::new(12345);
    let mut interior_zero = 0usize;
    let mut interior = 0usize;
    let mut area_zero_results = std::collections::BTreeMap::new();
    // 1) exactly-collinear integer triples (area == 0 bit-exactly)
    let mut area_zero_seen = 0usize;
    for _ in 0..400000 {
        let pick = rng.below(4);
        let (a,b,cc) = match pick {
            0 => { // x-axis
                let f=|r:&mut Rng| c2v{x: r.below(21) as f32-10.0, y:0.0};
                (f(&mut rng),f(&mut rng),f(&mut rng)) }
            1 => { let f=|r:&mut Rng| c2v{x:0.0, y: r.below(21) as f32-10.0};
                (f(&mut rng),f(&mut rng),f(&mut rng)) }
            2 => { let f=|r:&mut Rng| { let t=r.below(21) as f32-10.0; c2v{x:t,y:t} };
                (f(&mut rng),f(&mut rng),f(&mut rng)) }
            _ => { let k=rng.below(9) as f32-4.0; let f=|r:&mut Rng| { let t=r.below(21) as f32-10.0; c2v{x:t,y:t*k} };
                (f(&mut rng),f(&mut rng),f(&mut rng)) }
        };
        let area = (c.c2Det2)((c.c2Sub)(b,a),(c.c2Sub)(cc,a));
        if area != 0.0 { continue; }
        area_zero_seen += 1;
        let mut s = rand_simplex(&mut rng, 3, 1.0, false);
        s.verts[0].p=a; s.verts[1].p=b; s.verts[2].p=cc;
        unsafe { (c.c23)(&mut s); }
        *area_zero_results.entry(s.count).or_insert(0usize) += 1;
        if s.count==3 { interior += 1; if s.div==0.0 { interior_zero += 1; } }
    }
    eprintln!("area==0 cases: {area_zero_seen}, result counts: {area_zero_results:?}, interior={interior}, interior_div0={interior_zero}");
    // 2) fully general search for count==3 && div==0
    let mut general = 0usize;
    let mut gen_examples = vec![];
    for _ in 0..2000000 {
        let mode = rng.below(3);
        let mk = |r:&mut Rng| match mode {
            0 => c2v{x: r.below(9) as f32-4.0, y: r.below(9) as f32-4.0},
            1 => r.coord_v(),
            _ => r.wild_v(),
        };
        let (a,b,cc)=(mk(&mut rng),mk(&mut rng),mk(&mut rng));
        let mut s = rand_simplex(&mut rng, 3, 1.0, false);
        s.verts[0].p=a; s.verts[1].p=b; s.verts[2].p=cc;
        unsafe { (c.c23)(&mut s); }
        if s.count==3 && s.div==0.0 {
            general += 1;
            if gen_examples.len()<3 { gen_examples.push((a,b,cc,s.div)); }
        }
    }
    eprintln!("general count==3 && div==0: {general}, examples: {gen_examples:?}");
}
