import re
p='src/lib.rs'
s=open(p).read()

# Split off the FFI export section so edits only touch the internal part.
marker = "// FFI exports"
idx = s.index(marker)
head, tail = s[:idx], s[idx:]

def cut(src, sig_prefix):
    """Remove a top-level fn definition starting with sig_prefix."""
    i = src.index(sig_prefix)
    # find terminating line that is exactly "}"
    j = src.index("\n}\n", i) + len("\n}\n")
    # also swallow the following blank line
    while src[j:j+1] == "\n":
        j += 1
    return src[:i] + src[j:]

for sig in [
    "fn c2V(", "fn c2Mulvs(", "fn c2Sub(", "fn c2Dot(", "fn c2RotIdentity(",
    "fn c2xIdentity(", "fn c2Len(", "fn c2Det2(", "fn c2Mulrv(", "fn c2MulrvT(",
    "fn c2Add(", "fn c2Mulxv(", "fn c2Neg(", "fn c2Skew(", "fn c2CCW90(",
    "fn c2Div(", "fn c2Norm(",
]:
    head = cut(head, sig)

renames = ["c2Maxv","c2Minv","c2Clampv","c2BBVerts","c2MakeProxy",
           "c2GJKSimplexMetric","c22","c23","c2D","c2Support","c2Witness",
           "c2L","c2GJK"]
