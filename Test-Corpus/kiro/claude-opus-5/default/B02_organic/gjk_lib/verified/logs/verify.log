#[test]
fn probe() {
    let (c, r) = (&libs().c, &libs().r);
    let mut rng = Rng::new(SEED ^ 0xABCD);
    for i in 0..200 {
        let rev = (rng.next_u32() & 1) as i8;
        let p = [rng.wild(),rng.wild(),rng.wild(),rng.wild(),rng.wild(),rng.wild(),rng.wild(),rng.wild(),rng.wild()];
        let (mut ca, mut cb) = (c2v::default(), c2v::default());
        let (mut ra, mut rb) = (c2v::default(), c2v::default());
        unsafe {
            (c.gjk)(rev, &mut ca, &mut cb, p[0],p[1],p[2],p[3],p[4],p[5],p[6],p[7],p[8]);
            (r.gjk)(rev, &mut ra, &mut rb, p[0],p[1],p[2],p[3],p[4],p[5],p[6],p[7],p[8]);
        }
        if ca.x.to_bits()!=ra.x.to_bits()||ca.y.to_bits()!=ra.y.to_bits()||cb.x.to_bits()!=rb.x.to_bits()||cb.y.to_bits()!=rb.y.to_bits() {
            eprintln!("#{i} rev={rev} p={p:?}\n  C a=({:08x},{:08x}) b=({:08x},{:08x})\n  R a=({:08x},{:08x}) b=({:08x},{:08x})",
                ca.x.to_bits(),ca.y.to_bits(),cb.x.to_bits(),cb.y.to_bits(),
                ra.x.to_bits(),ra.y.to_bits(),rb.x.to_bits(),rb.y.to_bits());
        }
    }
    // Which leaf op differs on NaN sign? probe c2Mulvs / c2Add / c2Sub / c2Mulvs with NaN
    let nan = f32::NAN;
    for &v in &[0.0f32, -0.0, 1.0, -1.0, nan, -nan, f32::INFINITY] {
        let a = c2v{x:nan,y:nan};
        eprintln!("c2Mulvs(NaN,{v:?}): C={:08x},{:08x} R={:08x},{:08x}",
            (c.c2Mulvs)(a,v).x.to_bits(),(c.c2Mulvs)(a,v).y.to_bits(),
            (r.c2Mulvs)(a,v).x.to_bits(),(r.c2Mulvs)(a,v).y.to_bits());
    }
    for &(x,y) in &[(nan,1.0f32),(1.0,nan),(-nan,1.0)] {
        let a=c2v{x,y}; let b=c2v{x:y,y:x};
        eprintln!("add({x:?},{y:?}): C={:08x},{:08x} R={:08x},{:08x}   sub: C={:08x},{:08x} R={:08x},{:08x}",
            (c.c2Add)(a,b).x.to_bits(),(c.c2Add)(a,b).y.to_bits(),(r.c2Add)(a,b).x.to_bits(),(r.c2Add)(a,b).y.to_bits(),
            (c.c2Sub)(a,b).x.to_bits(),(c.c2Sub)(a,b).y.to_bits(),(r.c2Sub)(a,b).x.to_bits(),(r.c2Sub)(a,b).y.to_bits());
    }
}
