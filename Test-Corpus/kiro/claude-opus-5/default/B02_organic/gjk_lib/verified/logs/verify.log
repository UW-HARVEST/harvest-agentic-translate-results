    head = re.sub(r'(?<![\w_])%s\(' % re.escape(n), '%s_impl(' % n, head)
    head = head.replace('fn %s_impl_impl(' % n, 'fn %s_impl(' % n)

s = head + tail
open(p,'w').write(s)
