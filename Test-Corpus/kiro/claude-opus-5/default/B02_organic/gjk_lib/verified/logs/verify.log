# make fields pub in those three structs
def pubfields(src, structname, fields):
    i=src.index('pub struct '+structname)
    j=src.index('}', i)
    body=src[i:j]
    for f in fields:
        body=re.sub(r'(\n    )'+f+r':', r'\1pub '+f+':', body)
    return src[:i]+body+src[j:]
