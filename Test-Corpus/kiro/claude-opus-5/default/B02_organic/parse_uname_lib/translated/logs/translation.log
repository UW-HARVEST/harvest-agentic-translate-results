#define _GNU_SOURCE
#include <dlfcn.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
typedef struct os_data { char *a[9]; } os_data;
typedef void (*parse_fn)(char *, os_data *);
typedef char *(*arch_fn)(char *);
int main(int argc, char **argv) {
    void *h = dlopen(argv[1], RTLD_NOW);
    if (!h) { fprintf(stderr, "dlopen fail\n"); return 2; }
    parse_fn parse = (parse_fn) dlsym(h, "parse_uname_string");
    arch_fn  arch  = (arch_fn)  dlsym(h, "get_os_arch");
    char line[4096];
    while (fgets(line, sizeof line, stdin)) {
        size_t n = strlen(line);
        while (n && (line[n-1]=='\n'||line[n-1]=='\r')) line[--n] = 0;
        os_data osd; memset(&osd, 0, sizeof osd);
        char *pad = calloc(1, n + 64);
        char *buf = pad + 32;
        memcpy(buf, line, n);
        fflush(NULL);
        parse(buf, &osd);
        fflush(NULL);
        printf("IN[%s]\n", line);
        printf(" REG");
        for (size_t k = 0; k < n + 64; k++) printf(" %02x", (unsigned char)pad[k]);
        printf("\n");
        for (int f = 0; f < 9; f++) {
            if (osd.a[f]) { printf(" F%d", f); for (size_t k=0;k<=strlen(osd.a[f]);k++) printf(" %02x",(unsigned char)osd.a[f][k]); printf("\n"); }
            else printf(" F%d NULL\n", f);
            free(osd.a[f]);
        }
        free(pad);
        char *b2 = strdup(line);
        char *r = arch(b2);
        printf(" ARCH %s\n", r ? r : "NULL");
        free(r); free(b2);
        fflush(NULL);
    }
    return 0;
}
EOF
