[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m             "byte mismatch for pfcn={pfcn}: C({}) -> {cv} {:02x?} vs Rust({label}) -> {rv} {:02x?}",
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m             l.c_label,
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m             cv.to_le_bytes(),
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m             rv.to_le_bytes()
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m         );
