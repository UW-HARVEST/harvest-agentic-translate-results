[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m     diff_all(-20..=20);
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m     diff_all((-20..=20).rev());
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m /// Row 20 — concurrent invocation from several threads. Neither implementation
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m /// has shared mutable state, so results must be stable under contention.
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m fn configs_row20_concurrent() {
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m     let l = loaded();
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m     let c = l.c;
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m     let rust: Vec<(String, CallPredict)> = l.rust.clone_pairs();
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m     let mut handles = Vec::new();
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m     for t in 0..8u64 {
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m         let rust = rust.clone();
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m         handles.push(std::thread::spawn(move || {
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m             let mut rng = Rng::new(0xABCD_0000 + t);
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m             for _ in 0..20_000 {
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m                 let v = if t % 2 == 0 { rng.range(-32, 32) } else { rng.next_i32() };
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m                 let cv = unsafe { c(v) };
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m                 for (label, f) in &rust {
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m                     let rv = unsafe { f(v) };
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m                     assert_eq!(
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m                         cv.to_le_bytes(),
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m                         rv.to_le_bytes(),
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m                         "thread {t}: mismatch for pfcn={v}: C -> {cv}, Rust({label}) -> {rv}"
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m                     );
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m         }));
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m     for h in handles {
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m         h.join().expect("worker thread panicked");
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m /// Helper so row 20 can move the symbol list into threads. `CallPredict` is a
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m /// plain `extern "C" fn` pointer, which is `Send`; the `Library` handles stay
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m /// alive in the `OnceLock` for the whole process.
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m trait ClonePairs {
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m     fn clone_pairs(&self) -> Vec<(String, CallPredict)>;
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m impl ClonePairs for Vec<(String, CallPredict)> {
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m     fn clone_pairs(&self) -> Vec<(String, CallPredict)> {
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m         self.iter().map(|(s, f)| (s.clone(), *f)).collect()
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m // Phase C — ERRORS.md rows 1..9 (rows 10..12 are unreachable via the ABI; see
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m // ERRORS.md for why, and `errors_row10_12_unreachable_by_construction` below
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m // for the structural check that stands in for them).
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m /// Every error row asserts the *same specific* result, not merely "both
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m /// rejected": `call_predict`'s rejection sentinel is the literal `0` it returns
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m /// when the `default:` label is taken.
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m #[track_caller]
