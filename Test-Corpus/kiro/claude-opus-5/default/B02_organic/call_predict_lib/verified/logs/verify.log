[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m     expect_rejection(-1);
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m /// Row 2 — `pfcn == 12`, one step past the top of `call_predict`'s band.
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m fn errors_row02_one_past_top() {
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m     expect_rejection(12);
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m /// Row 3 — the `12..=15` band handled by the big switch but not by `call_predict`.
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m fn errors_row03_partially_handled_band() {
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m     for v in 12..=15 {
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m         expect_rejection(v);
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m /// Row 4 — `pfcn == 16`, past the widest band any switch in the file names.
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m fn errors_row04_sixteen() {
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m     expect_rejection(16);
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m /// Row 5 — `INT_MIN`, the extreme out-of-range value across the FFI boundary.
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m /// A C `enum` parameter accepts any `int`; this is the value with no variant.
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m fn errors_row05_int_min() {
