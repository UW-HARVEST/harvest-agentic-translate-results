[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m         let st = IdxState::default();
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m         let mut saw_pfn10_mismatch = false;
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m         let mut saw_pfn11_mismatch = false;
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m         for _ in 0..20_000 {
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m             let psamp = full_samples(&mut rng);
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m             let idx = rng.next_i32();
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m             for n in 0..12usize {
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m                 p.assert_pfn(n, &psamp, idx, n as c_int, &st);
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m             // Cross-check the documented C inconsistencies, identically on both sides.
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m             for n in [10usize, 11usize] {
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m                 let mut pc = psamp;
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m                 let mut sc = st;
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m                 let via_helper_c = unsafe { (p.c_pfn[n])(pc.as_mut_ptr(), idx, n as c_int, &mut sc) };
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m                 let (sw_c, sw_r) = p.predict_sample(&psamp, idx, n as c_int, &st);
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m                 assert_eq!(sw_c, sw_r);
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m                 let mut pr = psamp;
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m                 let mut sr = st;
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m                 let via_helper_r = unsafe { (p.r_pfn[n])(pr.as_mut_ptr(), idx, n as c_int, &mut sr) };
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m                 assert_eq!(
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m                     via_helper_c, via_helper_r,
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m                     "Pfn{n} helper diverged (psamp={psamp:?}, idx={idx})"
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m                 assert_eq!(
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m                     via_helper_c != sw_c,
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m                     via_helper_r != sw_r,
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m                     "helper-vs-switch agreement for arm {n} differs between C and Rust"
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m                 if via_helper_c != sw_c {
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m                     if n == 10 {
