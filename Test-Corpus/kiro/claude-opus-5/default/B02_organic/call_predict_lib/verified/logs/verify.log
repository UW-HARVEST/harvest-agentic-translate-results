[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m                     } else {
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m                         saw_pfn11_mismatch = true;
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m                     }
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m             saw_pfn10_mismatch,
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m             "expected Pfn10 (>>3) to differ from case 10 (>>4) for some input"
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m             saw_pfn11_mismatch,
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m             "expected Pfn11 (>>1) to differ from case 11 (>>3) for some input"
