[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m     /// where `case 10:` shifts by 4, and `Pfn11` shifts by 1 where `case 11:`
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m     /// shifts by 3. This test pins the helper behaviour, and additionally
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m     /// asserts those two really do disagree with the switch in BOTH libraries.
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m     #[test]
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m     fn row22_pfn_helpers_full_range_random() {
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m         let p = InternalPair::load();
