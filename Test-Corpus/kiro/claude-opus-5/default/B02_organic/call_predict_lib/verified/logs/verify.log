[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m     fn next_i16(&mut self) -> i16 {
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m         self.next_u64() as u16 as i16
