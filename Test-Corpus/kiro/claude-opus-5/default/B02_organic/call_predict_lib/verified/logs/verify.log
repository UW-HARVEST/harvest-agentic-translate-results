[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m     for _ in 0..RANDOM_DRAWS {
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m         // the row's own value, then a random other value, then the row again:
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m         // catches any state left behind by a previous call.
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         diff(pfcn);
