[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     fn below(&mut self, n: u32) -> u32 {
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m         (self.next_u64() as u32) % n
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m // Phase B — CONFIGS.md rows 1..14 (public API, the only exported symbol)
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m // ===========================================================================
