[0m[49m[38;5;10m+    116[0m:[38;5;10m[49m             .map(|t| t.join(candidate).join("libcall_predict_lib.so"));
[0m[49m[38;5;10m+    117[0m:[38;5;10m[49m         if let Some(p) = p {
