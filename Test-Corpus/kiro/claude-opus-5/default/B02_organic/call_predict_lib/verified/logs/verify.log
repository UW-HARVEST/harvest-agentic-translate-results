[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m     assert_eq!(cv, 0, "C is expected to reject pfcn={pfcn} with 0, got {cv}");
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m     diff(pfcn);
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m /// Row 1 — `pfcn == -1`, immediately below the valid band.
