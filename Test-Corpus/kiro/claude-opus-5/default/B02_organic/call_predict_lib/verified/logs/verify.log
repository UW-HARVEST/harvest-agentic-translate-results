[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m     for (label, f) in &l.rust {
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m         let rv = unsafe { f(pfcn) };
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m         assert_eq!(
