[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m fn errors_row07_extreme_neighbours() {
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m     for v in [i32::MIN + 1, i32::MIN + 2, i32::MAX - 1, i32::MAX - 2] {
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m         expect_rejection(v);
