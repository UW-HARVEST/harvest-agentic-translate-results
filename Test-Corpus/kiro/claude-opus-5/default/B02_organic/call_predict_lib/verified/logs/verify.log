Purpose: View current internals.rs harness section

mod common;

use common::*;
use libloading::Library;
use std::ffi::c_int;

/// The two libraries that expose the internal helpers, with every symbol
/// resolved up-front through `dlsym`.
struct InternalPair {
    rust_so: std::path::PathBuf,
    _c: Library,
    _r: Library,
    c_predict_sample: FnPredict,
    r_predict_sample: FnPredict,
    c_pfn: [FnPredict; 12],
    r_pfn: [FnPredict; 12],
    c_index: FnInt,
    r_index: FnInt,
    c_through: FnCallThrough,
    r_through: FnCallThrough,
}

impl InternalPair {
    fn load(rust_so: &std::path::Path) -> Self {
        let c = dlopen(&c_wrap_path());
        let r = dlopen(rust_so);

        macro_rules! pfns {
            ($lib:expr, $prefix:literal) => {{
                let mut out: [Option<FnPredict>; 12] = [None; 12];
                for n in 0..12usize {
                    out[n] = Some(*sym::<FnPredict>(&$lib, &format!("{}{}", $prefix, n)));
                }
                out.map(|f| f.unwrap())
            }};
        }

        let c_predict_sample = *sym::<FnPredict>(&c, "wrap_predict_sample");
        let r_predict_sample = *sym::<FnPredict>(&r, "rsw_predict_sample");
        let c_pfn = pfns!(c, "wrap_pfn");
        let r_pfn = pfns!(r, "rsw_pfn");
        let c_index = *sym::<FnInt>(&c, "wrap_get_predict_func_index");
        let r_index = *sym::<FnInt>(&r, "rsw_get_predict_func_index");
        let c_through = *sym::<FnCallThrough>(&c, "wrap_call_through");
        let r_through = *sym::<FnCallThrough>(&r, "rsw_call_through");

        // Struct layout must agree before any `firfx` access is meaningful.
        for (name_c, name_r) in [
            ("wrap_sizeof_idxstate", "rsw_sizeof_idxstate"),
            ("wrap_alignof_idxstate", "rsw_alignof_idxstate"),
            ("wrap_offsetof_firfx", "rsw_offsetof_firfx"),
            ("wrap_offsetof_usefx", "rsw_offsetof_usefx"),
            ("wrap_offsetof_lpred", "rsw_offsetof_lpred"),
        ] {
            let cv = unsafe { (*sym::<FnProbe>(&c, name_c))() };
            let rv = unsafe { (*sym::<FnProbe>(&r, name_r))() };
            assert_eq!(cv, rv, "struct layout mismatch: {name_c}={cv} vs {name_r}={rv}");
        }

        InternalPair {
            rust_so: rust_so.to_path_buf(),
            _c: c,
            _r: r,
            c_predict_sample,
            r_predict_sample,
            c_pfn,
            r_pfn,
            c_index,
            r_index,
            c_through,
            r_through,
        }
    }

    /// One pair per Rust profile artifact; every test runs against all of them.
    fn all() -> Vec<Self> {
        rust_lib_paths().iter().map(|p| Self::load(p)).collect()
    }

    /// `BTAC1C2_PredictSample(psamp, idx, pfcn, ridx)` on both sides.
    fn predict_sample(
        &self,
        psamp: &[c_int; 8],
        idx: c_int,
        pfcn: c_int,
        st: &IdxState,
    ) -> (c_int, c_int) {
        // Each side gets its own mutable copies; neither function writes, but
        // this guarantees no cross-contamination if that ever changes.
        let mut pc = *psamp;
        let mut pr = *psamp;
        let mut sc = *st;
        let mut sr = *st;
        unsafe {
            (
                (self.c_predict_sample)(pc.as_mut_ptr(), idx, pfcn, &mut sc),
                (self.r_predict_sample)(pr.as_mut_ptr(), idx, pfcn, &mut sr),
            )
        }
    }

    fn assert_predict_sample(&self, psamp: &[c_int; 8], idx: c_int, pfcn: c_int, st: &IdxState) {
        let (c, r) = self.predict_sample(psamp, idx, pfcn, st);
        assert_eq!(
            c, r,
            "BTAC1C2_PredictSample(psamp={psamp:?}, idx={idx}, pfcn={pfcn}, \
             firfx={:?}): C={c} Rust={r} [{}]",
            st.firfx,
            self.rust_so.display()
        );
    }

    /// `BTAC1C2_PredictSample_Pfn<n>(psamp, idx, pfcn, ridx)` on both sides.
    fn assert_pfn(&self, n: usize, psamp: &[c_int; 8], idx: c_int, pfcn: c_int, st: &IdxState) {
        let mut pc = *psamp;
        let mut pr = *psamp;
        let mut sc = *st;
        let mut sr = *st;
        let (c, r) = unsafe {
            (
                (self.c_pfn[n])(pc.as_mut_ptr(), idx, pfcn, &mut sc),
                (self.r_pfn[n])(pr.as_mut_ptr(), idx, pfcn, &mut sr),
            )
        };
        assert_eq!(
            c, r,
            "Pfn{n}(psamp={psamp:?}, idx={idx}, pfcn={pfcn}): C={c} Rust={r} [{}]",
            self.rust_so.display()
        );
    }

    fn assert_index(&self, pfcn: c_int) -> c_int {
        let (c, r) = unsafe { ((self.c_index)(pfcn), (self.r_index)(pfcn)) };
        assert_eq!(
            c, r,
            "GetPredictFunc({pfcn}) identity: C selected {c}, Rust selected {r} [{}]",
            self.rust_so.display()
        );
        assert_ne!(c, -2, "C dispatcher returned an unrecognised pointer");
        c
    }

    fn assert_through(&self, pfcn: c_int, psamp: &[c_int; 8], idx: c_int, st: &IdxState) {
        let mut pc = *psamp;
        let mut pr = *psamp;
        let mut sc = *st;
        let mut sr = *st;
        let (c, r) = unsafe {
            (
                (self.c_through)(pfcn, pc.as_mut_ptr(), idx, &mut sc),
                (self.r_through)(pfcn, pr.as_mut_ptr(), idx, &mut sr),
            )
        };
        assert_eq!(
            c, r,
            "dispatch+call pfcn={pfcn} psamp={psamp:?} idx={idx}: C={c} Rust={r} [{}]",
            self.rust_so.display()
        );
    }
}

// ---------------------------------------------------------------------------
// input generators
// ---------------------------------------------------------------------------

fn small_samples(rng: &mut Rng) -> [c_int; 8] {
    let mut a = [0i32; 8];
    for v in a.iter_mut() {
        *v = rng.small_i32();
    }
    a
}

fn full_samples(rng: &mut Rng) -> [c_int; 8] {
    let mut a = [0i32; 8];
    for v in a.iter_mut() {
        *v = rng.next_i32();
    }
    a
}

