[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m         profile_dir.display()
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m /// Loads a symbol out of a library, panicking with a useful message.
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m fn sym<'a, T: Copy>(lib: &'a Library, name: &str) -> Symbol<'a, T> {
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m         lib.get(format!("{name}\0").as_bytes())
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m             .unwrap_or_else(|e| panic!("missing symbol `{name}`: {e}"))
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m /// Both public `.so`s, with `call_predict` resolved from each.
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m struct PublicPair {
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m     _c: Library,
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m     _r: Library,
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m     c_call_predict: FnInt,
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m     r_call_predict: FnInt,
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m impl PublicPair {
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m     fn load() -> Self {
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m         let c = unsafe { Library::new(c_lib_path()) }.expect("dlopen C .so");
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m         let r = unsafe { Library::new(rust_lib_path()) }.expect("dlopen Rust .so");
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m         let c_call_predict = *sym::<FnInt>(&c, "call_predict");
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m         let r_call_predict = *sym::<FnInt>(&r, "call_predict");
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m         PublicPair {
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m             _c: c,
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m             _r: r,
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m             c_call_predict,
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m             r_call_predict,
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m     fn call_predict(&self, pfcn: c_int) -> (c_int, c_int) {
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m         unsafe { ((self.c_call_predict)(pfcn), (self.r_call_predict)(pfcn)) }
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m     fn assert_same(&self, pfcn: c_int) {
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m         let (c, r) = self.call_predict(pfcn);
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m         assert_eq!(c, r, "call_predict({pfcn}): C returned {c}, Rust returned {r}");
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m // rng: SplitMix64, fixed seed -> reproducible "randomized" inputs
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m struct Rng(u64);
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m impl Rng {
