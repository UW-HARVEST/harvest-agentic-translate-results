[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m /// Call `call_predict(pfcn)` in the C `.so` and in every Rust `.so`, and require
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m /// the returned `int`s to be identical both as integers and as raw byte images.
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m #[track_caller]
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m fn diff(pfcn: i32) {
