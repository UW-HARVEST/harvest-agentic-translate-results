[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m     fn next_u64(&mut self) -> u64 {
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m         self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m         let mut z = self.0;
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m         z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m         z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m         z ^ (z >> 31)
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     fn next_i32(&mut self) -> i32 {
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m         self.next_u64() as u32 as i32
