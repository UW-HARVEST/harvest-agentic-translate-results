new2 = """                            stbds_temp_set(a, (*bucket).index[i]);
                            COUNTERS[1] += 1;
                            return STBDS_ARR_TO_HASH(a, elemsize);"""
old3 = """                    } else if (*bucket).hash[i] == 0 {
                        pos = (pos & !STBDS_BUCKET_MASK) + i;
                        break 'found_empty_slot;
                    } else if tombstone < 0 {
                        if (*bucket).index[i] == STBDS_INDEX_DELETED {
                            tombstone = ((pos & !STBDS_BUCKET_MASK) + i) as isize;
                        }
                    }
                    i += 1;
                }

                pos = pos.wrapping_add(step);"""
new3 = """                    } else if (*bucket).hash[i] == 0 {
                        COUNTERS[2] += 1;
                        pos = (pos & !STBDS_BUCKET_MASK) + i;
                        break 'found_empty_slot;
                    } else if tombstone < 0 {
                        if (*bucket).index[i] == STBDS_INDEX_DELETED {
                            tombstone = ((pos & !STBDS_BUCKET_MASK) + i) as isize;
                        }
                    }
                    i += 1;
                }

                pos = pos.wrapping_add(step);"""
assert s.count(old1)==1 and s.count(old2)==1 and s.count(old3)==1
s = s.replace(old1,new1).replace(old2,new2).replace(old3,new3)
s = s.replace("static mut stbds_hash_seed: usize = 0x31415926;",
 "static mut stbds_hash_seed: usize = 0x31415926;\n#[unsafe(no_mangle)]\npub static mut COUNTERS: [u64; 8] = [0; 8];")
open(p,'w').write(s)
