mod common;
use common::*;
use std::ffi::{c_char, c_int, c_void};
use libloading::Library;

#[test]
fn report_branch_coverage() {
    let _g = serial();
    let (c, r) = apis();
    // Drive a big mixed workload through the Rust lib and report the counters.
    let lib = unsafe { Library::new(std::env::current_exe().unwrap().parent().unwrap().parent().unwrap().join("libsh_geti_lib.so")) }.unwrap();
    let counters = unsafe { lib.get::<*mut u64>(b"COUNTERS\0") }.unwrap();
    let cptr = unsafe { counters.into_raw() };
    let base = unsafe { *cptr } as *mut u64;

    let mut keys: Vec<CStr8> = (0..3000).map(|i| CStr8::new(&format!("test_{}", i))).collect();
    let mut t: *mut StrMapEntry = std::ptr::null_mut();
    unsafe {
        (r.rand_seed)(DEFAULT_SEED);
        t = (r.shmode_func)(ELEMSIZE, STBDS_SH_STRDUP) as *mut StrMapEntry;
        let mut state = 0x12345678u64;
        let mut next = move || { state ^= state<<13; state ^= state>>7; state ^= state<<17; state };
        for _ in 0..200000 {
            let x = next();
            let i = (x as usize >> 8) % keys.len();
            let k = keys[i].as_ptr();
            match x % 3 {
                0 => { t = (r.hmput_key)(t as *mut c_void, ELEMSIZE, k as *mut c_void, KEYSIZE, STBDS_HM_STRING) as *mut StrMapEntry; }
                1 => { t = (r.hmget_key)(t as *mut c_void, ELEMSIZE, k as *mut c_void, KEYSIZE, STBDS_HM_STRING) as *mut StrMapEntry; }
                _ => { t = (r.hmdel_key)(t as *mut c_void, ELEMSIZE, k as *mut c_void, KEYSIZE, 0, STBDS_HM_STRING) as *mut StrMapEntry; }
            }
        }
        println!("COUNTERS loop1_found={} loop2_found={} loop2_empty={}", *base, *base.add(1), *base.add(2));
        let _ = c.name;
    }
}
