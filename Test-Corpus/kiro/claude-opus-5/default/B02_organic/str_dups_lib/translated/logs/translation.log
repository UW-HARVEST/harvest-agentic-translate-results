    }
    for (k = 0; k < 150; ++k) {
      t = (smap*)stbds_hmget_key(t, sizeof(smap), kk[k], sizeof(char*), 2);
      raw = (char*)t - sizeof(smap);
      printf("M2 %d idx=%td [%s] v=%d\n", k, HDR(raw)->temp, t[HDR(raw)->temp].key, t[HDR(raw)->temp].value);
    }
    /* re-put existing keys: exercises the found-existing-key path incl. temp_key */
    for (k = 0; k < 150; k += 7) {
      t = (smap*)stbds_hmput_key(t, sizeof(smap), kk[k], sizeof(char*), 2);
      raw = (char*)t - sizeof(smap);
      printf("M2r %d idx=%td tk=[%s] len=%zu\n", k, HDR(raw)->temp,
             *(char**)((char*)HDR(raw)->hash_table), HDR(raw)->length);
    }
    stbds_hmfree_func(raw, sizeof(smap));
  }

  fflush(stdout);
  return 0;
}
'''
assert s.rstrip().endswith('}')
i = s.rindex('  fflush(stdout);\n  return 0;\n}')
