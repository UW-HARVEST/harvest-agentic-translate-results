import re, glob

def covered_from(files):
    cov = set()
    txt = "".join(open(f).read() for f in files)
    for m in re.finditer(r'\brow(\d+)\b', txt):
        cov.add(int(m.group(1)))
    # test names like err_18_28_29_34_... or cfg_40_46_... : treat 2 numbers as a range
    for m in re.finditer(r'fn (?:err|cfg)_((?:\d+_)+)', txt):
        nums = [int(x) for x in m.group(1).strip('_').split('_')]
        cov.update(nums)
        if len(nums) == 2 and nums[0] < nums[1]:
            cov.update(range(nums[0], nums[1] + 1))
    return cov

