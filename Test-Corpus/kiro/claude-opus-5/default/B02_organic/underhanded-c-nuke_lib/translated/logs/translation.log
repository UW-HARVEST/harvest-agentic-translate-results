typedef double (*sf)(void*,void*,int);
static sf c_sc, r_sc;
static float fb(uint32_t u){ float f; memcpy(&f,&u,4); return f; }
static void t(int len, const uint32_t *bits){
  float ca[8], cb[8], ra[8], rb[8];
  for(int i=0;i<len;i++){ ca[i]=fb(bits[i]); cb[i]=fb(bits[len+i]); }
  memcpy(ra,ca,sizeof ca); memcpy(rb,cb,sizeof cb);
  double c=c_sc(ca,cb,len), r=r_sc(ra,rb,len);
  int eq = memcmp(&c,&r,8)==0 && memcmp(ca,ra,4*len)==0 && memcmp(cb,rb,4*len)==0;
  if(!eq){
    printf("len=%d IN:",len);
    for(int i=0;i<2*len;i++) printf(" %08x",bits[i]);
    printf("\n  ret c=%016llx r=%016llx\n",(unsigned long long)*(uint64_t*)&c,(unsigned long long)*(uint64_t*)&r);
    for(int i=0;i<len;i++) printf("  a[%d] c=%08x r=%08x | b[%d] c=%08x r=%08x\n",
       i,*(uint32_t*)&ca[i],*(uint32_t*)&ra[i], i,*(uint32_t*)&cb[i],*(uint32_t*)&rb[i]);
  }
}
int main(int argc,char**argv){
  void*ch=dlopen(argv[1],RTLD_NOW|RTLD_LOCAL), *rh=dlopen(argv[2],RTLD_NOW|RTLD_LOCAL);
  c_sc=(sf)dlsym(ch,"spectral_contrast"); r_sc=(sf)dlsym(rh,"spectral_contrast");
  uint32_t vals[]={0x00000000,0x80000000,0x3f800000,0xbf800000,0x7f800000,0xff800000,
                   0x7fc00000,0x7fa5a5a5,0xffd34567,0x7f7fffff,0x00000001,0x7f000000,
                   0x40490fdb,0x00800000,0x4b000000};
  int nv=sizeof vals/sizeof *vals;
  uint32_t b[8];
  for(int i=0;i<nv;i++) for(int j=0;j<nv;j++){ b[0]=vals[i]; b[1]=vals[j]; t(1,b); }
  for(int i=0;i<nv;i++)for(int j=0;j<nv;j++)for(int k=0;k<nv;k++)for(int l=0;l<nv;l++){
     b[0]=vals[i];b[1]=vals[j];b[2]=vals[k];b[3]=vals[l]; t(2,b); }
  printf("done\n");
}
