/// `__FILE__` as the C build sees it (`c_src/src/lib.c`).
const STBDS_FILE: &core::ffi::CStr = c"src/lib.c";

/// `STBDS_ASSERT(cond)` => `assert(cond)`.
///
/// The C library is compiled without `NDEBUG`, so every `assert` is live and
/// aborts through glibc `__assert_fail`.  Reproduce that exactly (same
/// assertion text, line number and enclosing function name) rather than
/// silently continuing.
#[inline]
unsafe fn stbds_assert(cond: bool, assertion: &core::ffi::CStr, line: u32, function: &core::ffi::CStr) {
    if !cond {
        __assert_fail(
            assertion.as_ptr(),
            STBDS_FILE.as_ptr(),
            line as c_uint,
            function.as_ptr(),
        );
    }
}
```

