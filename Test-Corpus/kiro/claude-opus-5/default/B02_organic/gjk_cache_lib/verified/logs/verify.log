fn main() {
    let target = f32::MAX.to_bits();
    let approx = (f32::MAX as f64).sqrt() as f32;
    let base = approx.to_bits();
    let mut hits: Vec<u32> = Vec::new();
    for d in -8000i64..8000 {
        let b = (base as i64 + d) as u32;
        let x = f32::from_bits(b);
        if (x * x).to_bits() == target { hits.push(b); }
    }
    println!("FLT_MAX bits = 0x{:08x}", target);
    println!("hits = {}", hits.len());
    if let (Some(&f), Some(&l)) = (hits.first(), hits.last()) {
        println!("first 0x{:08x} = {:?}  (sq bits 0x{:08x})", f, f32::from_bits(f), (f32::from_bits(f)*f32::from_bits(f)).to_bits());
        println!("last  0x{:08x} = {:?}", l, f32::from_bits(l));
        let m = hits[hits.len()/2];
        println!("mid   0x{:08x} = {:?}  x={:e}", m, f32::from_bits(m), f32::from_bits(m));
        // also verify dot(p,p) with y = 0
        let x = f32::from_bits(m);
        let dot = x*x + 0.0f32*0.0f32;
        println!("dot(p,p) bits = 0x{:08x}, == FLT_MAX? {}", dot.to_bits(), dot.to_bits()==target);
    }
}
