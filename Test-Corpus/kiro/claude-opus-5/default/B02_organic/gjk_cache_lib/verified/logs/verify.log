use libloading::{Library, Symbol};
use std::ffi::{c_int, c_void};
#[repr(C)] #[derive(Copy,Clone,Default,Debug,PartialEq)] struct V { x: f32, y: f32 }
#[repr(C)] #[derive(Copy,Clone,Default,Debug)] struct R { c: f32, s: f32 }
#[repr(C)] #[derive(Copy,Clone,Default,Debug)] struct X { p: V, r: R }
#[repr(C)] #[derive(Copy,Clone,Default,Debug)] struct Circle { p: V, r: f32 }
#[repr(C)] #[derive(Copy,Clone,Default,Debug)] struct Aabb { min: V, max: V }
#[repr(C)] #[derive(Copy,Clone,Default,Debug)] struct Cap { a: V, b: V, r: f32 }
#[repr(C)] #[derive(Copy,Clone,Default,Debug)] struct Cache { metric: f32, count: c_int, ia: [c_int;3], ib: [c_int;3], div: f32 }
type FnGJK = unsafe extern "C" fn(*const c_void,u32,*const X,*const c_void,u32,*const X,*mut V,*mut V,c_int,*mut c_int,*mut Cache)->f32;
#[repr(C, align(16))] struct Blob([u8;32]);
fn blob<T: Copy>(v:&T)->Blob{let mut b=Blob([0u8;32]);unsafe{std::ptr::copy_nonoverlapping(v as *const T as *const u8,b.0.as_mut_ptr(),std::mem::size_of::<T>());}b}
struct Out{d:f32,a:V,b:V,it:c_int,c:Cache}
