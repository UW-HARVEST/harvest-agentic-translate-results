 let mut a=V{x:7777.0,y:-7777.0}; let mut b=V{x:-8888.0,y:8888.0}; let mut it:c_int=-1; let mut c=cin;
 let d=f(ba.0.as_ptr() as *const c_void,ta,ax,bb.0.as_ptr() as *const c_void,tb,bx,&mut a,&mut b,ur,&mut it,if wc{&mut c}else{std::ptr::null_mut()});
 Out{d,a,b,it,c}}
fn fe(a:f32,b:f32)->bool{ if a.is_nan()||b.is_nan(){a.is_nan()&&b.is_nan()} else {a.to_bits()==b.to_bits()} }
fn ve(a:V,b:V)->bool{fe(a.x,b.x)&&fe(a.y,b.y)}
fn eq(c:&Out,r:&Out)->bool{fe(c.d,r.d)&&ve(c.a,r.a)&&ve(c.b,r.b)&&c.it==r.it&&fe(c.c.metric,r.c.metric)&&c.c.count==r.c.count&&c.c.ia==r.c.ia&&c.c.ib==r.c.ib&&fe(c.c.div,r.c.div)}
