[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m             let buf = AlignedBuf::new(&png, 0);
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m             let img = (p.c.load_png_mem)(buf.ptr, png.len() as c_int);
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m             assert!(!img.pix.is_null(), "C rejected short-PLTE image");
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m             libc::free(img.pix as *mut std::os::raw::c_void);
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         }
