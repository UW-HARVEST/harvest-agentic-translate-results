pub const CHILD_TIMEOUT_EXIT: c_int = 71;
/// Fatal signals leave via `100 + signo` so the parent can tell them apart.
pub const CHILD_FATAL_BASE: c_int = 100;

/// Per-case wall-clock budget. Legitimate cases finish in well under a
/// millisecond; a malformed stream can put `cp_block` into a loop that only a
/// timer breaks.
pub const CASE_TIME_LIMIT_MS: i64 = 2000;

extern "C" fn fatal_handler(sig: c_int) {
    unsafe { libc::_exit(CHILD_FATAL_BASE + sig) };
}

extern "C" fn alarm_handler(_sig: c_int) {
    unsafe { libc::_exit(CHILD_TIMEOUT_EXIT) };
}

unsafe fn arm_case_timer() {
    let it = libc::itimerval {
        it_interval: libc::timeval {
            tv_sec: 0,
            tv_usec: 0,
        },
        it_value: libc::timeval {
            tv_sec: CASE_TIME_LIMIT_MS / 1000,
            tv_usec: ((CASE_TIME_LIMIT_MS % 1000) * 1000) as libc::suseconds_t,
        },
    };
    libc::setitimer(libc::ITIMER_REAL, &it, std::ptr::null_mut());
}

unsafe fn disarm_case_timer() {
    let it = libc::itimerval {
        it_interval: libc::timeval {
            tv_sec: 0,
            tv_usec: 0,
        },
        it_value: libc::timeval {
            tv_sec: 0,
            tv_usec: 0,
        },
    };
    libc::setitimer(libc::ITIMER_REAL, &it, std::ptr::null_mut());
}''')

