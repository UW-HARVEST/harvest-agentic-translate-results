[0m[49m[38;5;10m+    111[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    112[0m:[38;5;10m[49m     for _ in 0..N {
[0m[49m[38;5;10m+    113[0m:[38;5;10m[49m         // 32-byte buffer: fits c2Circle (12), c2AABB (16) and c2Capsule (20).
[0m[49m[38;5;10m+    114[0m:[38;5;10m[49m         let mut buf = [0u32; 8];
