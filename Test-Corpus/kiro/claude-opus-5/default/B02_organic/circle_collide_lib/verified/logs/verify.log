[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m fn rows22_23_maxv_minv_nan_and_signed_zero() {
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m     let p = load();
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m     let vals = [
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m         0.0f32,
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m         -0.0,
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m         f32::NAN,
