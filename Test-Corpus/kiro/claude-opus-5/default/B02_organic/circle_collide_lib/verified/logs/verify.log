[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m         f32::INFINITY,
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m         f32::NEG_INFINITY,
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m     for &ax in &vals {
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m         for &ay in &vals {
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m             for &bx in &vals {
