[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m         f32::from_bits(0x7f80_0001), // signalling NaN
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m         f32::from_bits(0xffc0_1234), // negative quiet NaN with payload
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m         1.0,
