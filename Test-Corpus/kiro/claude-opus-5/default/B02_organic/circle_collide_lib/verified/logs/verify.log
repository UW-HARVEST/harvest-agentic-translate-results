[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m             let (cv, rv) = ((c.c2CircletoAABB)(A, bb), (r.c2CircletoAABB)(A, bb));
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m             diff_assert!(cv == rv, "row09 circle/aabb NaN: C={cv} RS={rv}");
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m             diff_assert!(cv == 0, "row09 C should reject NaN d2 (aabb), got {cv}");
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m             let (cv, rv) = (
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m                 (c.c2CircletoCapsule)(A, cap),
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m                 (r.c2CircletoCapsule)(A, cap),
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m             diff_assert!(cv == rv, "row09 circle/capsule NaN: C={cv} RS={rv}");
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m             diff_assert!(cv == 0, "row09 C should reject NaN d2 (capsule), got {cv}");
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m             // NaN radius too.
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m             let An = c2Circle {
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m                 p: c2v { x: 0.0, y: 0.0 },
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m                 r: nan,
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m             for &(cv, rv) in &[
