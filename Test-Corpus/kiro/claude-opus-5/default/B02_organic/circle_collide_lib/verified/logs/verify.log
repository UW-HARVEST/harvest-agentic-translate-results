[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m     let mut arm_a = 0usize;
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m     let mut arm_side = 0usize;
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m     let mut arm_b = 0usize;
