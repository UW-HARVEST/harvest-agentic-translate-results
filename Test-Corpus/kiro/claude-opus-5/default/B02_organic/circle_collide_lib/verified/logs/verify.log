[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m         let (lo, hi) = (s.max, s.min); // deliberately inverted
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m         let c = unsafe { (p.c.c2Clampv)(a, lo, hi) };
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m         let rs = unsafe { (p.rs.c2Clampv)(a, lo, hi) };
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m         assert_v_bits_eq("clampv inverted", c, rs);
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m     let vals = [
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m         0.0f32,
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m         -0.0,
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m         f32::NAN,
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m         f32::from_bits(0xffc0_00ff),
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m         1.0,
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m         -1.0,
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m         f32::INFINITY,
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m         f32::NEG_INFINITY,
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m     for &a0 in &vals {
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m         for &l0 in &vals {
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m             for &h0 in &vals {
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m                 let a = v(a0, l0);
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m                 let lo = v(l0, h0);
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m                 let hi = v(h0, a0);
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m                 assert_v_bits_eq(
