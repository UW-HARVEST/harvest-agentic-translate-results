[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m /// Row 34 — the composed pipeline, built out of the LOW-LEVEL exports and
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m /// compared against the high-level predicate of the *other* library. This
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m /// catches a divergence that only appears once the primitives are chained
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m /// (`c2Clampv` -> `c2Sub` -> `c2Dot`), which per-function tests cannot see.
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m fn row34_composed_pipeline_cross_library() {
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m     let p = load();
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m     let mut rng = Rng::default_seeded();
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m     // Re-implement c2CircletoAABB using one library's primitives.
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     let compose_aabb = |api: &Api, a: C2Circle, b: C2Aabb| -> i32 {
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m         unsafe {
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m             let l = (api.c2Clampv)(a.p, b.min, b.max);
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m             let ab = (api.c2Sub)(a.p, l);
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m             let d2 = (api.c2Dot)(ab, ab);
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m             let r2 = (api.c2Dot)((api.c2V)(a.r, 0.0), (api.c2V)(a.r, 0.0));
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m             // NB: c2Dot((r,0),(r,0)) == 0*0 + r*r == r*r, matching `A.r * A.r`.
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m             (d2 < r2) as i32
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m     // Re-implement c2CircletoCapsule's side arm using primitives.
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m     let compose_capsule_side = |api: &Api, a: C2Circle, b: C2Capsule| -> C2v {
