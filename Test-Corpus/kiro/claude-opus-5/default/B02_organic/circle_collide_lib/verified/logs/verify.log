[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m         let (c, rs) = unsafe {
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m             (
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m                 (p.c.c2CircletoCapsule)(a, b),
