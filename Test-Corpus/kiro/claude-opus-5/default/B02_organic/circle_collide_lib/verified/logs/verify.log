[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m                     unsafe { (p.c.c2Clampv)(a, lo, hi) },
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m                     unsafe { (p.rs.c2Clampv)(a, lo, hi) },
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m // Rows 26-29 — top-level entry point and c2V.
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m /// Rows 26-28 — `circle_collide` with NaN (must return 0), with negative /
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m /// infinite arguments, and with a zero / negative-zero radius.
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m fn rows26_28_circle_collide_invalid_scalars() {
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m     let p = load();
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m     let mut rng = Rng::default_seeded();
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m     // Row 26 — NaN in any argument makes every predicate false.
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m     let nan = f32::NAN;
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m     for slot in 0..3 {
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m         for _ in 0..1000 {
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m             let mut arg = [rng.range(-100.0, 100.0), rng.range(-100.0, 100.0), rng.range(0.0, 50.0)];
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m             arg[slot] = nan;
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m             let (c, rs) = unsafe {
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m                 (
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m                     (p.c.circle_collide)(arg[0], arg[1], arg[2]),
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m                     (p.rs.circle_collide)(arg[0], arg[1], arg[2]),
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m                 )
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m             assert_int_eq(&format!("circle_collide nan slot {slot}"), c, rs);
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m             assert_eq!(c, 0, "NaN argument must yield 0 (slot {slot})");
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m     // Row 27 — negative / infinite arguments.
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m     for &r in &[-1.0f32, -100.0, f32::INFINITY, f32::NEG_INFINITY, 1.0e30, f32::MAX] {
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m         for &x in &[0.0f32, -70.0, f32::INFINITY, f32::NEG_INFINITY, 1.0e30] {
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m             for &y in &[0.0f32, 70.0, f32::INFINITY, f32::NEG_INFINITY, -1.0e30] {
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m                 let (c, rs) =
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m                     unsafe { ((p.c.circle_collide)(x, y, r), (p.rs.circle_collide)(x, y, r)) };
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m                 assert_int_eq(&format!("circle_collide extreme({x:?},{y:?},{r:?})"), c, rs);
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m     // Row 28 — zero radius: the AABB bit can never be set (r2 == 0).
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m     for &r in &[0.0f32, -0.0] {
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m         for _ in 0..2000 {
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m             let x = rng.range(-120.0, 40.0);
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m             let y = rng.range(-120.0, 140.0);
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m             let (c, rs) = unsafe { ((p.c.circle_collide)(x, y, r), (p.rs.circle_collide)(x, y, r)) };
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m             assert_int_eq(&format!("circle_collide r={r:?}"), c, rs);
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m             assert_eq!(c & 2, 0, "zero radius must never set the AABB bit");
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m /// Row 29 — `c2V` stores its arguments verbatim: signalling NaNs, denormals and
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m /// signed zeros must not be normalised or quieted by either library.
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m fn row29_c2v_verbatim_bit_patterns() {
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m     let p = load();
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m     let patterns: Vec<u32> = vec![
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m         0x0000_0000, // +0
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m         0x8000_0000, // -0
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m         0x0000_0001, // smallest denormal
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m         0x8000_0001,
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m         0x007f_ffff, // largest denormal
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m         0x7f7f_ffff, // FLT_MAX
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m         0x7f80_0000, // +inf
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m         0xff80_0000, // -inf
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m         0x7f80_0001, // signalling NaN, minimal payload
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m         0xff80_0001,
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m         0x7fbf_ffff, // signalling NaN, maximal payload
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m         0x7fc0_0000, // canonical quiet NaN
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m         0xffc0_0000,
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m         0x7fff_ffff, // quiet NaN, maximal payload
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m         0xffff_ffff,
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m         0x3f80_0000, // 1.0
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m         0xbf80_0000, // -1.0
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m     for &bx in &patterns {
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m         for &by in &patterns {
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m             let (x, y) = (f32::from_bits(bx), f32::from_bits(by));
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m             let c = unsafe { (p.c.c2V)(x, y) };
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m             let rs = unsafe { (p.rs.c2V)(x, y) };
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m             assert_v_bits_eq(&format!("c2V(0x{bx:08x}, 0x{by:08x})"), c, rs);
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m                 bits_v(c),
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m                 (bx, by),
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m                 "C c2V did not store the bits verbatim"
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m                 bits_v(rs),
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m                 (bx, by),
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m                 "Rust c2V did not store the bits verbatim"
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m // Row 30 — struct tail padding / trap representations.
[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m /// Row 30 — `c2Circle` (12 B) and `c2Capsule` (20 B, MEMORY class) passed with
[0m[49m[38;5;10m+    603[0m:[38;5;10m[49m /// arbitrary garbage in the bytes beyond the declared fields. Neither library
[0m[49m[38;5;10m+    604[0m:[38;5;10m[49m /// may read them: verified by running the same logical value with two different
[0m[49m[38;5;10m+    605[0m:[38;5;10m[49m /// garbage fills and requiring an identical result.
[0m[49m[38;5;10m+    606[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    607[0m:[38;5;10m[49m fn row30_struct_tail_padding_ignored() {
[0m[49m[38;5;10m+    608[0m:[38;5;10m[49m     let p = load();
[0m[49m[38;5;10m+    609[0m:[38;5;10m[49m     let mut rng = Rng::default_seeded();
[0m[49m[38;5;10m+    610[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m     #[repr(C)]
[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m     #[derive(Copy, Clone)]
[0m[49m[38;5;10m+    613[0m:[38;5;10m[49m     struct CircleWithTail {
[0m[49m[38;5;10m+    614[0m:[38;5;10m[49m         c: C2Circle,
[0m[49m[38;5;10m+    615[0m:[38;5;10m[49m         tail: [u32; 5],
[0m[49m[38;5;10m+    616[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    617[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    618[0m:[38;5;10m[49m     #[repr(C)]
[0m[49m[38;5;10m+    619[0m:[38;5;10m[49m     #[derive(Copy, Clone)]
[0m[49m[38;5;10m+    620[0m:[38;5;10m[49m     struct CapsuleWithTail {
[0m[49m[38;5;10m+    621[0m:[38;5;10m[49m         c: C2Capsule,
[0m[49m[38;5;10m+    622[0m:[38;5;10m[49m         tail: [u32; 5],
[0m[49m[38;5;10m+    623[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    624[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    625[0m:[38;5;10m[49m     for _ in 0..N {
[0m[49m[38;5;10m+    626[0m:[38;5;10m[49m         let circle = rng.circle();
[0m[49m[38;5;10m+    627[0m:[38;5;10m[49m         let capsule = rng.capsule();
[0m[49m[38;5;10m+    628[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    629[0m:[38;5;10m[49m         let mut c1 = CircleWithTail { c: circle, tail: [0; 5] };
[0m[49m[38;5;10m+    630[0m:[38;5;10m[49m         let mut c2 = CircleWithTail { c: circle, tail: [0; 5] };
[0m[49m[38;5;10m+    631[0m:[38;5;10m[49m         for i in 0..5 {
[0m[49m[38;5;10m+    632[0m:[38;5;10m[49m             c1.tail[i] = rng.next_u32();
[0m[49m[38;5;10m+    633[0m:[38;5;10m[49m             c2.tail[i] = rng.next_u32();
[0m[49m[38;5;10m+    634[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    635[0m:[38;5;10m[49m         let mut k1 = CapsuleWithTail { c: capsule, tail: [0; 5] };
[0m[49m[38;5;10m+    636[0m:[38;5;10m[49m         let mut k2 = CapsuleWithTail { c: capsule, tail: [0; 5] };
[0m[49m[38;5;10m+    637[0m:[38;5;10m[49m         for i in 0..5 {
[0m[49m[38;5;10m+    638[0m:[38;5;10m[49m             k1.tail[i] = rng.next_u32();
[0m[49m[38;5;10m+    639[0m:[38;5;10m[49m             k2.tail[i] = rng.next_u32();
[0m[49m[38;5;10m+    640[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    641[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    642[0m:[38;5;10m[49m         // By-value calls: the struct is copied out of a buffer whose tail
[0m[49m[38;5;10m+    643[0m:[38;5;10m[49m         // differs, so any read past the declared fields would show up here.
[0m[49m[38;5;10m+    644[0m:[38;5;10m[49m         let a1 = unsafe { (p.c.c2CircletoCircle)(c1.c, c2.c) };
[0m[49m[38;5;10m+    645[0m:[38;5;10m[49m         let a2 = unsafe { (p.rs.c2CircletoCircle)(c1.c, c2.c) };
[0m[49m[38;5;10m+    646[0m:[38;5;10m[49m         assert_int_eq("padded circle-circle", a1, a2);
[0m[49m[38;5;10m+    647[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    648[0m:[38;5;10m[49m         let b1 = unsafe { (p.c.c2CircletoCapsule)(c1.c, k1.c) };
[0m[49m[38;5;10m+    649[0m:[38;5;10m[49m         let b2 = unsafe { (p.rs.c2CircletoCapsule)(c1.c, k1.c) };
[0m[49m[38;5;10m+    650[0m:[38;5;10m[49m         let b3 = unsafe { (p.c.c2CircletoCapsule)(c2.c, k2.c) };
[0m[49m[38;5;10m+    651[0m:[38;5;10m[49m         let b4 = unsafe { (p.rs.c2CircletoCapsule)(c2.c, k2.c) };
[0m[49m[38;5;10m+    652[0m:[38;5;10m[49m         assert_int_eq("padded circle-capsule 1", b1, b2);
[0m[49m[38;5;10m+    653[0m:[38;5;10m[49m         assert_int_eq("padded circle-capsule 2", b3, b4);
[0m[49m[38;5;10m+    654[0m:[38;5;10m[49m         assert_eq!(b1, b3, "C result depended on tail garbage");
[0m[49m[38;5;10m+    655[0m:[38;5;10m[49m         assert_eq!(b2, b4, "Rust result depended on tail garbage");
[0m[49m[38;5;10m+    656[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    657[0m:[38;5;10m[49m         // Pointer calls through c2Collided: `B` deliberately points at a
[0m[49m[38;5;10m+    658[0m:[38;5;10m[49m         // capsule followed by garbage.
[0m[49m[38;5;10m+    659[0m:[38;5;10m[49m         let ap = &c1 as *const _ as *const c_void;
[0m[49m[38;5;10m+    660[0m:[38;5;10m[49m         let kp1 = &k1 as *const _ as *const c_void;
[0m[49m[38;5;10m+    661[0m:[38;5;10m[49m         let kp2 = &k2 as *const _ as *const c_void;
[0m[49m[38;5;10m+    662[0m:[38;5;10m[49m         let d1 = unsafe { (p.c.c2Collided)(ap, kp1, C2_TYPE_CAPSULE) };
[0m[49m[38;5;10m+    663[0m:[38;5;10m[49m         let d2 = unsafe { (p.rs.c2Collided)(ap, kp1, C2_TYPE_CAPSULE) };
[0m[49m[38;5;10m+    664[0m:[38;5;10m[49m         let d3 = unsafe { (p.c.c2Collided)(ap, kp2, C2_TYPE_CAPSULE) };
[0m[49m[38;5;10m+    665[0m:[38;5;10m[49m         let d4 = unsafe { (p.rs.c2Collided)(ap, kp2, C2_TYPE_CAPSULE) };
[0m[49m[38;5;10m+    666[0m:[38;5;10m[49m         assert_int_eq("padded collided 1", d1, d2);
