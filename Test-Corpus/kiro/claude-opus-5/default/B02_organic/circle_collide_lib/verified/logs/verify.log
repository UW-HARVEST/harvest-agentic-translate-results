[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m                 ((c.c2CircletoAABB)(An, bb), (r.c2CircletoAABB)(An, bb)),
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m                 (
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m                     (c.c2CircletoCapsule)(An, cap),
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m                     (r.c2CircletoCapsule)(An, cap),
