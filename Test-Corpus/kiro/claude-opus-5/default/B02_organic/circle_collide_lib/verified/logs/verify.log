[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m fn row19_22_circle_capsule_arms() {
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m     let p = load();
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m     let mut rng = Rng::default_seeded();
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m 
