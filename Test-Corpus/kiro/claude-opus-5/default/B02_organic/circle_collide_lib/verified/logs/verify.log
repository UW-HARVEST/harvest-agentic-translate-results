[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m         for (i, f) in head.iter().enumerate() {
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m             buf[i] = f.to_bits();
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m         }
