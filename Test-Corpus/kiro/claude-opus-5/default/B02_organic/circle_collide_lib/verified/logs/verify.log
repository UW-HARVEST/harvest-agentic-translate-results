[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m             unsafe {
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m                 let (cm, rm) = ((c.c2Maxv)(a, b), (r.c2Maxv)(a, b));
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m                 diff_assert!(
