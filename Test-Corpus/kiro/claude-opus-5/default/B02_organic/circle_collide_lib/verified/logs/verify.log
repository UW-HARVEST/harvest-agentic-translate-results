[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m     for _ in 0..N {
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m         let a = rng.circle();
