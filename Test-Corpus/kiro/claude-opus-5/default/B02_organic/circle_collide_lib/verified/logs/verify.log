[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m     let mut check = |x: f32, y: f32, r: f32, what: &str, seen: &mut [usize; 8]| {
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m         let (c, rs) = unsafe { ((p.c.circle_collide)(x, y, r), (p.rs.circle_collide)(x, y, r)) };
