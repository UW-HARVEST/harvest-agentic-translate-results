[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m // Row 9 — NaN in any float argument
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m fn err_row09_nan_inputs() {
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m     let (c, r) = libs();
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m     let nans: Vec<f32> = SPECIAL_BITS
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m         .iter()
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m         .map(|&b| f32::from_bits(b))
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m         .filter(|v| v.is_nan())
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m         .chain([f32::NAN, -f32::NAN])
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m         .collect();
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m     assert!(nans.len() >= 6, "row09 needs several NaN encodings");
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m     for &nan in &nans {
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m         // c2Maxv / c2Minv: the comparison is false, so operand b must win.
