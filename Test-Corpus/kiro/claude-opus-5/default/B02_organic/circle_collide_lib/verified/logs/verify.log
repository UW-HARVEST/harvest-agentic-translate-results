[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m                     let a = v(ax, ay);
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m                     let b = v(bx, by);
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m                     assert_v_bits_eq(
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m                         &format!("c2Maxv(({ax:?},{ay:?}),({bx:?},{by:?}))"),
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m                         unsafe { (p.c.c2Maxv)(a, b) },
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m                         unsafe { (p.rs.c2Maxv)(a, b) },
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m                     );
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m                     assert_v_bits_eq(
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m                         &format!("c2Minv(({ax:?},{ay:?}),({bx:?},{by:?}))"),
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m                         unsafe { (p.c.c2Minv)(a, b) },
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m                         unsafe { (p.rs.c2Minv)(a, b) },
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m                     );
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m     }
