[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m                     f32_eq_bits(cm.x, b.x),
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m                     "row09 C c2Maxv did not return b.x for NaN a.x: {}",
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m                     show(cm.x)
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m                 let (cn, rn) = ((c.c2Minv)(a, b), (r.c2Minv)(a, b));
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m                 diff_assert!(
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m                     v_eq(cn, rn),
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m                     "row09 c2Minv NaN: C={} RS={}",
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m                     show_v(cn),
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m                     show_v(rn)
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m         // The `d2 < r2` predicates must reject (return 0) on a NaN d2.
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m         let A = c2Circle {
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m             p: c2v { x: nan, y: 0.0 },
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m             r: 10.0,
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m         let B = c2Circle {
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m             p: c2v { x: 0.0, y: 0.0 },
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m             r: 10.0,
