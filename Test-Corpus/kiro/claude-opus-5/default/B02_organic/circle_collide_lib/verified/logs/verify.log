[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m             let (c, rs) = unsafe { ((p.c.c2Collided)(ptr, ptr, ty), (p.rs.c2Collided)(ptr, ptr, ty)) };
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m             assert_int_eq(&format!("c2Collided aliased ty={ty}"), c, rs);
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m /// Row 29 — `B` points into an over-sized buffer whose tail holds garbage. The
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m /// C only reads `sizeof(type)` bytes, so the tail must not affect the result:
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m /// asserted by running the same logical shape with two different tails.
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m fn row29_collided_oversized_buffer() {
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m     let p = load();
