[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m fn rows24_25_clampv_contradictory_and_nan() {
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m     let p = load();
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m     let mut rng = Rng::default_seeded();
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m 
