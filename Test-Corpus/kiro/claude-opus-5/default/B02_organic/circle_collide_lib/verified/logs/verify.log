[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m                 buf2[i] = rng.next_u32();
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m             let r1c = unsafe { (p.c.c2Collided)(a_ptr, buf1.as_ptr() as *const c_void, ty) };
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m             let r1r = unsafe { (p.rs.c2Collided)(a_ptr, buf1.as_ptr() as *const c_void, ty) };
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m             let r2c = unsafe { (p.c.c2Collided)(a_ptr, buf2.as_ptr() as *const c_void, ty) };
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m             let r2r = unsafe { (p.rs.c2Collided)(a_ptr, buf2.as_ptr() as *const c_void, ty) };
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m             assert_int_eq(&format!("oversized buf1 ty={ty}"), r1c, r1r);
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m             assert_int_eq(&format!("oversized buf2 ty={ty}"), r2c, r2r);
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m             assert_eq!(r1c, r2c, "C read past the used bytes for ty={ty}");
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m             assert_eq!(r1r, r2r, "Rust read past the used bytes for ty={ty}");
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m         }
