[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m fn err_row08_inverted_aabb() {
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m     let (c, r) = libs();
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m     let mut rng = Rng::seeded(108);
