[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m             (C2_TYPE_CIRCLE, 3usize),
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m             (C2_TYPE_AABB, 4),
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m             (C2_TYPE_CAPSULE, 5),
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m         ] {
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m             let mut buf1 = [0u32; 8];
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m             for i in 0..used_words {
