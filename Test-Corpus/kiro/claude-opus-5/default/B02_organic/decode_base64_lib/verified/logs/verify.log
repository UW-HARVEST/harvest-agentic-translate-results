     9	/* Decode a base64 character */
    10	static unsigned char decode(char c)
    11	{
    12	    if (c >= 'A' && c <= 'Z') {
    13	        return (c - 'A');
    14	    }
    15	    if (c >= 'a' && c <= 'z') {
    16	        return (c - 'a' + 26);
    17	    }
    18	    if (c >= '0' && c <= '9') {
    19	        return (c - '0' + 52);
    20	    }
    21	    if (c == '+') {
    22	        return 62;
    23	    }
    24	
    25	    return 63;
    26	}
    27	
    28	/* Returns TRUE if 'c' is a valid base64 character, otherwise FALSE */
    29	static int is_base64(char c)
    30	{
    31	    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
    32	        (c >= '0' && c <= '9') || (c == '+')             ||
    33	        (c == '/')             || (c == '=')) {
    34	
    35	        return TRUE;
    36	    }
    37	    return FALSE;
    38	}
    39	
    40	/* Decode the base64 encoded string 'src' into the memory pointed to by
    41	 * 'dest'. The dest buffer is NUL terminated.
    42	 * Returns NULL in case of error
    43	 */
    44	char *decode_base64(const char *src)
    45	{
    46	    if (src && *src) {
    47	        char *dest;
    48	        unsigned char *p;
    49	        int k, l = strlen(src) + 1;
    50	        unsigned char *buf;
    51	
    52	        /* The size of the dest will always be less than the source */
    53	        dest = (char *)calloc(sizeof(char), l + 13);
    54	        if (!dest) {
    55	            return (NULL);
    56	        }
    57	
    58	        p = (unsigned char *)dest;
    59	
    60	        buf = (unsigned char *) malloc(l);
    61	        if (!buf) {
    62	            free(dest);
    63	            return (NULL);
    64	        }
    65	
    66	        /* Ignore non base64 chars as per the POSIX standard */
    67	        for (k = 0, l = 0; src[k]; k++) {
    68	            if (is_base64(src[k])) {
    69	                buf[l++] = src[k];
    70	            }
    71	        }
    72	
    73	        for (k = 0; k < l; k += 4) {
    74	            char c1 = 'A', c2 = 'A', c3 = 'A', c4 = 'A';
    75	            unsigned char b1 = 0, b2 = 0, b3 = 0, b4 = 0;
    76	
    77	            c1 = buf[k];
    78	
    79	            if (k + 1 < l) {
    80	                c2 = buf[k + 1];
    81	            }
    82	
    83	            if (k + 2 < l) {
    84	                c3 = buf[k + 2];
    85	            }
    86	
    87	            if (k + 3 < l) {
    88	                c4 = buf[k + 3];
    89	            }
    90	
    91	            b1 = decode(c1);
    92	            b2 = decode(c2);
    93	            b3 = decode(c3);
    94	            b4 = decode(c4);
    95	
    96	            *p++ = ((b1 << 2) | (b2 >> 4) );
    97	
    98	            if (c3 != '=') {
    99	                *p++ = (((b2 & 0xf) << 4) | (b3 >> 2) );
   100	            }
   101	
   102	            if (c4 != '=') {
   103	                *p++ = (((b3 & 0x3) << 6) | b4 );
   104	            }
   105	
   106	        }
   107	
   108	        free(buf);
   109	
   110	        return (dest);
   111	    }
   112	    return (NULL);
   113	}

