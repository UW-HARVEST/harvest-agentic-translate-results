     9	use std::ffi::{c_char, c_int, c_uchar, c_void};
    10	
    11	unsafe extern "C" {
    12	    fn calloc(nmemb: usize, size: usize) -> *mut c_void;
    13	    fn free(ptr: *mut c_void);
    14	}
    15	
    16	const TRUE: c_int = 1;
    17	const FALSE: c_int = 0;
    18	
    19	/// Decode a base64 character.
    20	fn decode(c: u8) -> c_uchar {
    21	    if c >= b'A' && c <= b'Z' {
    22	        return c - b'A';
    23	    }
    24	    if c >= b'a' && c <= b'z' {
    25	        return c - b'a' + 26;
    26	    }
    27	    if c >= b'0' && c <= b'9' {
    28	        return c - b'0' + 52;
    29	    }
    30	    if c == b'+' {
    31	        return 62;
    32	    }
    33	
    34	    63
    35	}
    36	
    37	/// Returns TRUE if `c` is a valid base64 character, otherwise FALSE.
    38	fn is_base64(c: u8) -> c_int {
    39	    if (c >= b'A' && c <= b'Z')
    40	        || (c >= b'a' && c <= b'z')
    41	        || (c >= b'0' && c <= b'9')
    42	        || (c == b'+')
    43	        || (c == b'/')
    44	        || (c == b'=')
    45	    {
    46	        return TRUE;
    47	    }
    48	    FALSE
    49	}
    50	
    51	/// Decode the base64 encoded string `src` into a freshly allocated, NUL
    52	/// terminated buffer.
    53	///
    54	/// Returns NULL in case of error.
    55	///
    56	/// # Safety
    57	///
    58	/// `src` must either be NULL or point to a NUL terminated string. The returned
    59	/// pointer, when non-NULL, must be released with `free()`.
    60	#[unsafe(no_mangle)]
    61	pub unsafe extern "C" fn decode_base64(src: *const c_char) -> *mut c_char {
    62	    if src.is_null() || unsafe { *src } == 0 {
    63	        return std::ptr::null_mut();
    64	    }
    65	
    66	    // strlen(src) + 1
    67	    let mut len: usize = 0;
    68	    while unsafe { *src.add(len) } != 0 {
    69	        len += 1;
    70	    }
    71	    let l0 = len + 1;
    72	
    73	    /* The size of the dest will always be less than the source */
    74	    let dest = unsafe { calloc(std::mem::size_of::<c_char>(), l0 + 13) } as *mut c_char;
    75	    if dest.is_null() {
    76	        return std::ptr::null_mut();
    77	    }
    78	
    79	    let mut p = dest as *mut c_uchar;
    80	
    81	    let mut buf: Vec<u8> = Vec::new();
    82	    if buf.try_reserve_exact(l0).is_err() {
    83	        unsafe { free(dest as *mut c_void) };
    84	        return std::ptr::null_mut();
    85	    }
    86	
    87	    // Source bytes as a slice (excluding the NUL terminator).
    88	    let input = unsafe { std::slice::from_raw_parts(src as *const u8, len) };
    89	
    90	    /* Ignore non base64 chars as per the POSIX standard */
    91	    for &c in input {
    92	        if is_base64(c) == TRUE {
    93	            buf.push(c);
    94	        }
    95	    }
    96	
    97	    let l = buf.len();
    98	
    99	    let mut k = 0usize;
   100	    while k < l {
   101	        let c1: u8;
   102	        let mut c2: u8 = b'A';
   103	        let mut c3: u8 = b'A';
   104	        let mut c4: u8 = b'A';
   105	
   106	        c1 = buf[k];
   107	
   108	        if k + 1 < l {
   109	            c2 = buf[k + 1];
   110	        }
   111	
   112	        if k + 2 < l {
   113	            c3 = buf[k + 2];
   114	        }
   115	
   116	        if k + 3 < l {
   117	            c4 = buf[k + 3];
   118	        }
   119	
   120	        let b1 = decode(c1);
   121	        let b2 = decode(c2);
   122	        let b3 = decode(c3);
   123	        let b4 = decode(c4);
   124	
   125	        unsafe {
   126	            *p = (b1 << 2) | (b2 >> 4);
   127	            p = p.add(1);
   128	
   129	            if c3 != b'=' {
   130	                *p = ((b2 & 0xf) << 4) | (b3 >> 2);
   131	                p = p.add(1);
   132	            }
   133	
   134	            if c4 != b'=' {
   135	                *p = ((b3 & 0x3) << 6) | b4;
   136	                p = p.add(1);
   137	            }
   138	        }
   139	
   140	        k += 4;
   141	    }
   142	
   143	    dest
   144	}
