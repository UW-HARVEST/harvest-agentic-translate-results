/* true iff every differing 4-byte word is NaN on BOTH sides (payload/sign only) */
static int nan_payload_only(const void *a, const void *b, size_t n) {
    if (n % 4) return 0;
    const uint32_t *x = (const uint32_t *)a, *y = (const uint32_t *)b;
    for (size_t i = 0; i < n / 4; ++i) {
        if (x[i] == y[i]) continue;
