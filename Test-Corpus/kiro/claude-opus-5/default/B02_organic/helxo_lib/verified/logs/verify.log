  1100	#[unsafe(no_mangle)]
  1101	pub unsafe extern "C" fn stbds_strreset(a: *mut stbds_string_arena) {
  1102	    unsafe {
  1103	        let mut x = (*a).storage;
  1104	        while !x.is_null() {
  1105	            let y = (*x).next;
  1106	            stbds_free(x as *mut c_void);
  1107	            x = y;
  1108	        }
  1109	        memset(a as *mut c_void, 0, size_of::<stbds_string_arena>());
  1110	    }
  1111	}
