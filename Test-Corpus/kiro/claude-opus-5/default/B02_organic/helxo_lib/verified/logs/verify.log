   948	// ---------------------------------------------------------------------------
   949	// stbds_hmdel_key
   950	// ---------------------------------------------------------------------------
   951	
   952	#[unsafe(no_mangle)]
   953	pub unsafe extern "C" fn stbds_hmdel_key(
   954	    a: *mut c_void,
   955	    elemsize: usize,
   956	    key: *mut c_void,
   957	    keysize: usize,
   958	    keyoffset: usize,
   959	    mode: c_int,
   960	) -> *mut c_void {
   961	    unsafe {
   962	        if a.is_null() {
   963	            return ptr::null_mut();
   964	        }
   965	
   966	        let raw_a = hash_to_arr(a, elemsize);
   967	        let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;
   968	        stbds_temp_set(raw_a, 0);
   969	        if table.is_null() {
   970	            return a;
   971	        }
   972	
   973	        let mut slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);
   974	        if slot < 0 {
   975	            return a;
   976	        }
   977	
   978	        let mut b = (*table).storage.add((slot >> STBDS_BUCKET_SHIFT) as usize);
   979	        let mut i = (slot as usize) & STBDS_BUCKET_MASK;
   980	        let old_index = (*b).index[i];
   981	        let final_index: isize = stbds_arrlen(raw_a) - 1 - 1;
   982	        (*table).used_count -= 1;
   983	        (*table).tombstone_count += 1;
   984	        stbds_temp_set(raw_a, 1);
   985	        (*b).hash[i] = STBDS_HASH_DELETED;
   986	        (*b).index[i] = STBDS_INDEX_DELETED;
   987	
   988	        if mode == STBDS_HM_STRING && (*table).string.mode as c_int == STBDS_SH_STRDUP {
   989	            stbds_free(*(elem_ptr(a, elemsize, old_index) as *mut *mut c_char) as *mut c_void);
   990	        }
   991	
   992	        if old_index != final_index {
   993	            memmove(
   994	                elem_ptr(a, elemsize, old_index) as *mut c_void,
   995	                elem_ptr(a, elemsize, final_index) as *const c_void,
   996	                elemsize,
   997	            );
   998	
   999	            if mode == STBDS_HM_STRING {
  1000	                let k = *(elem_ptr(a, elemsize, old_index).add(keyoffset) as *mut *mut c_char);
  1001	                slot = stbds_hm_find_slot(a, elemsize, k as *mut c_void, keysize, keyoffset, mode);
  1002	            } else {
  1003	                let k = elem_ptr(a, elemsize, old_index).add(keyoffset);
  1004	                slot = stbds_hm_find_slot(a, elemsize, k as *mut c_void, keysize, keyoffset, mode);
  1005	            }
  1006	            b = (*table).storage.add((slot >> STBDS_BUCKET_SHIFT) as usize);
  1007	            i = (slot as usize) & STBDS_BUCKET_MASK;
  1008	            (*b).index[i] = old_index;
  1009	        }
  1010	        (*stbds_header(raw_a)).length -= 1;
  1011	
  1012	        if (*table).used_count < (*table).used_count_shrink_threshold
  1013	            && (*table).slot_count > STBDS_BUCKET_LENGTH
  1014	        {
  1015	            (*stbds_header(raw_a)).hash_table =
  1016	                stbds_make_hash_index((*table).slot_count >> 1, table) as *mut c_void;
  1017	            stbds_free(table as *mut c_void);
  1018	        } else if (*table).tombstone_count > (*table).tombstone_count_threshold {
  1019	            (*stbds_header(raw_a)).hash_table =
  1020	                stbds_make_hash_index((*table).slot_count, table) as *mut c_void;
  1021	            stbds_free(table as *mut c_void);
  1022	        }
  1023	
  1024	        a
  1025	    }
  1026	}
