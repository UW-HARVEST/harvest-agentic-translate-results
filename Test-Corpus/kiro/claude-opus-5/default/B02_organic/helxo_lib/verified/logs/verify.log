   348	#define STBDS_INDEX_IN_USE(x)  ((x) >= 0)
   349	
   350	#define STBDS_HASH_EMPTY      0
   351	#define STBDS_HASH_DELETED    1
   352	
   353	static size_t stbds_hash_seed=0x31415926;
   354	
   355	void stbds_rand_seed(size_t seed)
   356	{
   357	  stbds_hash_seed = seed;
   358	}
   359	
   360	#define stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)                                          \
   361	  temp = v64_lo ^ v32, temp <<= 16, temp <<= 16, temp >>= 16, temp >>= 16,                           \
   362	  var = v64_hi, var <<= 16, var <<= 16,                                                              \
   363	  var ^= temp ^ v32
   364	
   365	#define STBDS_SIZE_T_BITS           ((sizeof (size_t)) * 8)
   366	
   367	static size_t stbds_probe_position(size_t hash, size_t slot_count, size_t slot_log2)
   368	{
   369	  size_t pos;
   370	  STBDS_NOTUSED(slot_log2);
   371	  pos = hash & (slot_count-1);
   372	  return pos;
   373	}
   374	
   375	static size_t stbds_log2(size_t slot_count)
   376	{
   377	  size_t n=0;
   378	  while (slot_count > 1) {
   379	    slot_count >>= 1;
   380	    ++n;
   381	  }
   382	  return n;
   383	}
   384	
   385	static stbds_hash_index *stbds_make_hash_index(size_t slot_count, stbds_hash_index *ot)
   386	{
   387	  stbds_hash_index *t;
   388	  t = (stbds_hash_index *) STBDS_REALLOC(NULL,0,(slot_count >> STBDS_BUCKET_SHIFT) * sizeof(stbds_hash_bucket) + sizeof(stbds_hash_index) + STBDS_CACHE_LINE_SIZE-1);
   389	  t->storage = (stbds_hash_bucket *) STBDS_ALIGN_FWD((size_t) (t+1), STBDS_CACHE_LINE_SIZE);
   390	  t->slot_count = slot_count;
   391	  t->slot_count_log2 = stbds_log2(slot_count);
   392	  t->tombstone_count = 0;
   393	  t->used_count = 0;
   394	
   395	  t->used_count_threshold        = slot_count - (slot_count>>2);
   396	  t->tombstone_count_threshold   = (slot_count>>3) + (slot_count>>4);
   397	  t->used_count_shrink_threshold = slot_count >> 2;
   398	
   399	  if (slot_count <= STBDS_BUCKET_LENGTH)
   400	    t->used_count_shrink_threshold = 0;
   401	  STBDS_ASSERT(t->used_count_threshold + t->tombstone_count_threshold < t->slot_count);
   402	  STBDS_STATS(++stbds_hash_alloc);
   403	  if (ot) {
   404	    t->string = ot->string;
   405	    t->seed = ot->seed;
   406	  } else {
   407	    size_t a,b,temp;
   408	    memset(&t->string, 0, sizeof(t->string));
   409	    t->seed = stbds_hash_seed;
   410	    stbds_load_32_or_64(a,temp, 2147001325, 0x27bb2ee6, 0x87b0b0fd);
   411	    stbds_load_32_or_64(b,temp,  715136305,          0, 0xb504f32d);
   412	    stbds_hash_seed = stbds_hash_seed  * a + b;
   413	  }
   414	
   415	  {
   416	    size_t i,j;
   417	    for (i=0; i < slot_count >> STBDS_BUCKET_SHIFT; ++i) {
   418	      stbds_hash_bucket *b = &t->storage[i];
   419	      for (j=0; j < STBDS_BUCKET_LENGTH; ++j)
   420	        b->hash[j] = STBDS_HASH_EMPTY;
   421	      for (j=0; j < STBDS_BUCKET_LENGTH; ++j)
   422	        b->index[j] = STBDS_INDEX_EMPTY;
   423	    }
   424	  }
   425	
   426	  if (ot) {
   427	    size_t i,j;
   428	    t->used_count = ot->used_count;
   429	    for (i=0; i < ot->slot_count >> STBDS_BUCKET_SHIFT; ++i) {
   430	      stbds_hash_bucket *ob = &ot->storage[i];
   431	      for (j=0; j < STBDS_BUCKET_LENGTH; ++j) {
   432	        if (STBDS_INDEX_IN_USE(ob->index[j])) {
   433	          size_t hash = ob->hash[j];
   434	          size_t pos = stbds_probe_position(hash, t->slot_count, t->slot_count_log2);
   435	          size_t step = STBDS_BUCKET_LENGTH;
   436	          STBDS_STATS(++stbds_rehash_items);
   437	          for (;;) {
   438	            size_t limit,z;
   439	            stbds_hash_bucket *bucket;
   440	            bucket = &t->storage[pos >> STBDS_BUCKET_SHIFT];
   441	            STBDS_STATS(++stbds_rehash_probes);
   442	
   443	            for (z=pos & STBDS_BUCKET_MASK; z < STBDS_BUCKET_LENGTH; ++z) {
   444	              if (bucket->hash[z] == 0) {
   445	                bucket->hash[z] = hash;
   446	                bucket->index[z] = ob->index[j];
   447	                goto done;
   448	              }
   449	            }
   450	
   451	            limit = pos & STBDS_BUCKET_MASK;
   452	            for (z = 0; z < limit; ++z) {
   453	              if (bucket->hash[z] == 0) {
   454	                bucket->hash[z] = hash;
   455	                bucket->index[z] = ob->index[j];
   456	                goto done;
   457	              }
   458	            }
   459	
   460	            pos += step;
   461	            step += STBDS_BUCKET_LENGTH;
   462	            pos &= (t->slot_count-1);
   463	          }
   464	        }
   465	       done:
   466	        ;
   467	      }
   468	    }
   469	  }
   470	
   471	  return t;
   472	}
   473	
   474	#define STBDS_ROTATE_LEFT(val, n)   (((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n))))
   475	#define STBDS_ROTATE_RIGHT(val, n)  (((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n))))
   476	
   477	size_t stbds_hash_string(char *str, size_t seed)
   478	{
   479	  size_t hash = seed;
   480	  while (*str)
   481	     hash = STBDS_ROTATE_LEFT(hash, 9) + (unsigned char) *str++;
   482	
   483	  hash ^= seed;
   484	  hash = (~hash) + (hash << 18);
   485	  hash ^= hash ^ STBDS_ROTATE_RIGHT(hash,31);
   486	  hash = hash * 21;
   487	  hash ^= hash ^ STBDS_ROTATE_RIGHT(hash,11);
   488	  hash += (hash << 6);
   489	  hash ^= STBDS_ROTATE_RIGHT(hash,22);
   490	  return hash+seed;
   491	}
   492	
   493	#define STBDS_SIPHASH_C_ROUNDS 2
   494	#define STBDS_SIPHASH_D_ROUNDS 4
   495	typedef int STBDS_SIPHASH_2_4_can_only_be_used_in_64_bit_builds[sizeof(size_t) == 8 ? 1 : -1];
   496	
   497	
   498	static size_t stbds_siphash_bytes(void *p, size_t len, size_t seed)
   499	{
   500	  unsigned char *d = (unsigned char *) p;
   501	  size_t i,j;
   502	  size_t v0,v1,v2,v3, data;
   503	
   504	  v0 = ((((size_t) 0x736f6d65 << 16) << 16) + 0x70736575) ^  seed;
   505	  v1 = ((((size_t) 0x646f7261 << 16) << 16) + 0x6e646f6d) ^ ~seed;
   506	  v2 = ((((size_t) 0x6c796765 << 16) << 16) + 0x6e657261) ^  seed;
   507	  v3 = ((((size_t) 0x74656462 << 16) << 16) + 0x79746573) ^ ~seed;
   508	
   509	  v0 ^= 0x0706050403020100ull ^  seed;
   510	  v1 ^= 0x0f0e0d0c0b0a0908ull ^ ~seed;
   511	  v2 ^= 0x0706050403020100ull ^  seed;
   512	  v3 ^= 0x0f0e0d0c0b0a0908ull ^ ~seed;
   513	
   514	  #define STBDS_SIPROUND() \
   515	    do {                   \
   516	      v0 += v1; v1 = STBDS_ROTATE_LEFT(v1, 13);  v1 ^= v0; v0 = STBDS_ROTATE_LEFT(v0,STBDS_SIZE_T_BITS/2); \
   517	      v2 += v3; v3 = STBDS_ROTATE_LEFT(v3, 16);  v3 ^= v2;                                                 \
   518	      v2 += v1; v1 = STBDS_ROTATE_LEFT(v1, 17);  v1 ^= v2; v2 = STBDS_ROTATE_LEFT(v2,STBDS_SIZE_T_BITS/2); \
   519	      v0 += v3; v3 = STBDS_ROTATE_LEFT(v3, 21);  v3 ^= v0;                                                 \
   520	    } while (0)
   521	
   522	  for (i=0; i+sizeof(size_t) <= len; i += sizeof(size_t), d += sizeof(size_t)) {
   523	    data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);
   524	    data |= (size_t) (d[4] | (d[5] << 8) | (d[6] << 16) | (d[7] << 24)) << 16 << 16; // discarded if size_t == 4
   525	
   526	    v3 ^= data;
   527	    for (j=0; j < STBDS_SIPHASH_C_ROUNDS; ++j)
   528	      STBDS_SIPROUND();
   529	    v0 ^= data;
   530	  }
   531	  data = len << (STBDS_SIZE_T_BITS-8);
   532	  switch (len - i) {
   533	    case 7: data |= ((size_t) d[6] << 24) << 24;
   534	    case 6: data |= ((size_t) d[5] << 20) << 20;
   535	    case 5: data |= ((size_t) d[4] << 16) << 16;
   536	    case 4: data |= (d[3] << 24);
   537	    case 3: data |= (d[2] << 16);
   538	    case 2: data |= (d[1] << 8);
   539	    case 1: data |= d[0];
   540	    case 0: break;
   541	  }
   542	  v3 ^= data;
   543	  for (j=0; j < STBDS_SIPHASH_C_ROUNDS; ++j)
   544	    STBDS_SIPROUND();
   545	  v0 ^= data;
   546	  v2 ^= 0xff;
   547	  for (j=0; j < STBDS_SIPHASH_D_ROUNDS; ++j)
   548	    STBDS_SIPROUND();
   549	
   550	  return v0^v1^v2^v3;
   551	}
   552	
   553	size_t stbds_hash_bytes(void *p, size_t len, size_t seed)
   554	{
   555	  return stbds_siphash_bytes(p,len,seed);
   556	}
   557	
   558	static int stbds_is_key_equal(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode, size_t i)
   559	{
   560	  if (mode >= STBDS_HM_STRING)
   561	    return 0==strcmp((char *) key, * (char **) ((char *) a + elemsize*i + keyoffset));
   562	  else
   563	    return 0==memcmp(key, (char *) a + elemsize*i + keyoffset, keysize);
   564	}
   565	
   566	#define STBDS_HASH_TO_ARR(x,elemsize) ((char*) (x) - (elemsize))
   567	#define STBDS_ARR_TO_HASH(x,elemsize) ((char*) (x) + (elemsize))
   568	
   569	#define stbds_hash_table(a)  ((stbds_hash_index *) stbds_header(a)->hash_table)
   570	
   571	void stbds_hmfree_func(void *a, size_t elemsize)
   572	{
   573	  if (a == NULL) return;
   574	  if (stbds_hash_table(a) != NULL) {
   575	    if (stbds_hash_table(a)->string.mode == STBDS_SH_STRDUP) {
   576	      size_t i;
   577	      for (i=1; i < stbds_header(a)->length; ++i)
   578	        STBDS_FREE(NULL, *(char**) ((char *) a + elemsize*i));
   579	    }
   580	    stbds_strreset(&stbds_hash_table(a)->string);
   581	  }
   582	  STBDS_FREE(NULL, stbds_header(a)->hash_table);
   583	  STBDS_FREE(NULL, stbds_header(a));
   584	}
   585	
   586	static ptrdiff_t stbds_hm_find_slot(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode)
   587	{
   588	  void *raw_a = STBDS_HASH_TO_ARR(a,elemsize);
   589	  stbds_hash_index *table = stbds_hash_table(raw_a);
   590	  size_t hash = mode >= STBDS_HM_STRING ? stbds_hash_string((char*)key,table->seed) : stbds_hash_bytes(key, keysize,table->seed);
   591	  size_t step = STBDS_BUCKET_LENGTH;
   592	  size_t limit,i;
   593	  size_t pos;
   594	  stbds_hash_bucket *bucket;
   595	
   596	  if (hash < 2) hash += 2;
   597	
   598	  pos = stbds_probe_position(hash, table->slot_count, table->slot_count_log2);
   599	
   600	  for (;;) {
   601	    STBDS_STATS(++stbds_hash_probes);
   602	    bucket = &table->storage[pos >> STBDS_BUCKET_SHIFT];
   603	
   604	    for (i=pos & STBDS_BUCKET_MASK; i < STBDS_BUCKET_LENGTH; ++i) {
   605	      if (bucket->hash[i] == hash) {
   606	        if (stbds_is_key_equal(a, elemsize, key, keysize, keyoffset, mode, bucket->index[i])) {
   607	          return (pos & ~STBDS_BUCKET_MASK)+i;
   608	        }
   609	      } else if (bucket->hash[i] == STBDS_HASH_EMPTY) {
   610	        return -1;
   611	      }
   612	    }
   613	
   614	    limit = pos & STBDS_BUCKET_MASK;
   615	    for (i = 0; i < limit; ++i) {
   616	      if (bucket->hash[i] == hash) {
   617	        if (stbds_is_key_equal(a, elemsize, key, keysize, keyoffset, mode, bucket->index[i])) {
   618	          return (pos & ~STBDS_BUCKET_MASK)+i;
   619	        }
   620	      } else if (bucket->hash[i] == STBDS_HASH_EMPTY) {
   621	        return -1;
   622	      }
   623	    }
   624	
   625	    pos += step;
   626	    step += STBDS_BUCKET_LENGTH;
   627	    pos &= (table->slot_count-1);
   628	  }
   629	}
   630	
   631	void * stbds_hmget_key_ts(void *a, size_t elemsize, void *key, size_t keysize, ptrdiff_t *temp, int mode)
   632	{
   633	  size_t keyoffset = 0;
   634	  if (a == NULL) {
   635	    a = stbds_arrgrowf(0, elemsize, 0, 1);
   636	    stbds_header(a)->length += 1;
   637	    memset(a, 0, elemsize);
   638	    *temp = STBDS_INDEX_EMPTY;
   639	    return STBDS_ARR_TO_HASH(a,elemsize);
   640	  } else {
   641	    stbds_hash_index *table;
   642	    void *raw_a = STBDS_HASH_TO_ARR(a,elemsize);
   643	    table = (stbds_hash_index *) stbds_header(raw_a)->hash_table;
   644	    if (table == 0) {
   645	      *temp = -1;
   646	    } else {
   647	      ptrdiff_t slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);
   648	      if (slot < 0) {
   649	        *temp = STBDS_INDEX_EMPTY;
   650	      } else {
   651	        stbds_hash_bucket *b = &table->storage[slot >> STBDS_BUCKET_SHIFT];
   652	        *temp = b->index[slot & STBDS_BUCKET_MASK];
   653	      }
   654	    }
   655	    return a;
   656	  }
   657	}
   658	
   659	void * stbds_hmget_key(void *a, size_t elemsize, void *key, size_t keysize, int mode)
   660	{
   661	  ptrdiff_t temp;
   662	  void *p = stbds_hmget_key_ts(a, elemsize, key, keysize, &temp, mode);
   663	  stbds_temp(STBDS_HASH_TO_ARR(p,elemsize)) = temp;
   664	  return p;
   665	}
   666	
   667	void * stbds_hmput_default(void *a, size_t elemsize)
   668	{
   669	  if (a == NULL || stbds_header(STBDS_HASH_TO_ARR(a,elemsize))->length == 0) {
   670	    a = stbds_arrgrowf(a ? STBDS_HASH_TO_ARR(a,elemsize) : NULL, elemsize, 0, 1);
   671	    stbds_header(a)->length += 1;
   672	    memset(a, 0, elemsize);
   673	    a=STBDS_ARR_TO_HASH(a,elemsize);
   674	  }
   675	  return a;
   676	}
   677	
   678	static char *stbds_strdup(char *str);
   679	
   680	void *stbds_hmput_key(void *a, size_t elemsize, void *key, size_t keysize, int mode)
   681	{
   682	  size_t keyoffset=0;
   683	  void *raw_a;
   684	  stbds_hash_index *table;
   685	
   686	  if (a == NULL) {
   687	    a = stbds_arrgrowf(0, elemsize, 0, 1);
   688	    memset(a, 0, elemsize);
   689	    stbds_header(a)->length += 1;
   690	    a = STBDS_ARR_TO_HASH(a,elemsize);
   691	  }
   692	
   693	  raw_a = a;
   694	  a = STBDS_HASH_TO_ARR(a,elemsize);
   695	
   696	  table = (stbds_hash_index *) stbds_header(a)->hash_table;
   697	
   698	  if (table == NULL || table->used_count >= table->used_count_threshold) {
   699	    stbds_hash_index *nt;
   700	    size_t slot_count;
   701	
   702	    slot_count = (table == NULL) ? STBDS_BUCKET_LENGTH : table->slot_count*2;
   703	    nt = stbds_make_hash_index(slot_count, table);
   704	    if (table)
   705	      STBDS_FREE(NULL, table);
   706	    else
   707	      nt->string.mode = mode >= STBDS_HM_STRING ? STBDS_SH_DEFAULT : 0;
   708	    stbds_header(a)->hash_table = table = nt;
   709	    STBDS_STATS(++stbds_hash_grow);
   710	  }
   711	
   712	  {
   713	    size_t hash = mode >= STBDS_HM_STRING ? stbds_hash_string((char*)key,table->seed) : stbds_hash_bytes(key, keysize,table->seed);
   714	    size_t step = STBDS_BUCKET_LENGTH;
   715	    size_t pos;
   716	    ptrdiff_t tombstone = -1;
   717	    stbds_hash_bucket *bucket;
   718	
   719	    if (hash < 2) hash += 2;
   720	
   721	    pos = stbds_probe_position(hash, table->slot_count, table->slot_count_log2);
   722	
   723	    for (;;) {
   724	      size_t limit, i;
   725	      STBDS_STATS(++stbds_hash_probes);
   726	      bucket = &table->storage[pos >> STBDS_BUCKET_SHIFT];
   727	
   728	      for (i=pos & STBDS_BUCKET_MASK; i < STBDS_BUCKET_LENGTH; ++i) {
   729	        if (bucket->hash[i] == hash) {
   730	          if (stbds_is_key_equal(raw_a, elemsize, key, keysize, keyoffset, mode, bucket->index[i])) {
   731	            stbds_temp(a) = bucket->index[i];
   732	            if (mode >= STBDS_HM_STRING)
   733	              stbds_temp_key(a) = * (char **) ((char *) raw_a + elemsize*bucket->index[i] + keyoffset);
   734	            return STBDS_ARR_TO_HASH(a,elemsize);
   735	          }
   736	        } else if (bucket->hash[i] == 0) {
   737	          pos = (pos & ~STBDS_BUCKET_MASK) + i;
   738	          goto found_empty_slot;
   739	        } else if (tombstone < 0) {
   740	          if (bucket->index[i] == STBDS_INDEX_DELETED)
   741	            tombstone = (ptrdiff_t) ((pos & ~STBDS_BUCKET_MASK) + i);
   742	        }
   743	      }
   744	
   745	      limit = pos & STBDS_BUCKET_MASK;
   746	      for (i = 0; i < limit; ++i) {
   747	        if (bucket->hash[i] == hash) {
   748	          if (stbds_is_key_equal(raw_a, elemsize, key, keysize, keyoffset, mode, bucket->index[i])) {
   749	            stbds_temp(a) = bucket->index[i];
   750	            return STBDS_ARR_TO_HASH(a,elemsize);
   751	          }
   752	        } else if (bucket->hash[i] == 0) {
   753	          pos = (pos & ~STBDS_BUCKET_MASK) + i;
   754	          goto found_empty_slot;
   755	        } else if (tombstone < 0) {
   756	          if (bucket->index[i] == STBDS_INDEX_DELETED)
   757	            tombstone = (ptrdiff_t) ((pos & ~STBDS_BUCKET_MASK) + i);
   758	        }
   759	      }
   760	
   761	      pos += step;
   762	      step += STBDS_BUCKET_LENGTH;
   763	      pos &= (table->slot_count-1);
   764	    }
   765	   found_empty_slot:
   766	    if (tombstone >= 0) {
   767	      pos = tombstone;
   768	      --table->tombstone_count;
   769	    }
   770	    ++table->used_count;
   771	
   772	    {
   773	      ptrdiff_t i = (ptrdiff_t) stbds_arrlen(a);
   774	      if ((size_t) i+1 > stbds_arrcap(a))
   775	        *(void **) &a = stbds_arrgrowf(a, elemsize, 1, 0);
   776	      raw_a = STBDS_ARR_TO_HASH(a,elemsize);
   777	
   778	      STBDS_ASSERT((size_t) i+1 <= stbds_arrcap(a));
   779	      stbds_header(a)->length = i+1;
   780	      bucket = &table->storage[pos >> STBDS_BUCKET_SHIFT];
   781	      bucket->hash[pos & STBDS_BUCKET_MASK] = hash;
   782	      bucket->index[pos & STBDS_BUCKET_MASK] = i-1;
   783	      stbds_temp(a) = i-1;
   784	
   785	      switch (table->string.mode) {
   786	         case STBDS_SH_STRDUP:  stbds_temp_key(a) = *(char **) ((char *) a + elemsize*i) = stbds_strdup((char*) key); break;
   787	         case STBDS_SH_ARENA:   stbds_temp_key(a) = *(char **) ((char *) a + elemsize*i) = stbds_stralloc(&table->string, (char*)key); break;
   788	         case STBDS_SH_DEFAULT: stbds_temp_key(a) = *(char **) ((char *) a + elemsize*i) = (char *) key; break;
   789	         default:                memcpy((char *) a + elemsize*i, key, keysize); break;
