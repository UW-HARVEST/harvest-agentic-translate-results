  1175	#[unsafe(no_mangle)]
  1176	pub unsafe extern "C" fn helxo(letter: c_char) {
  1177	    unsafe {
  1178	        let mut hash: *mut helxo_entry = ptr::null_mut();
  1179	        let mut name: [c_char; 4] = [b'j' as c_char, b'e' as c_char, b'n' as c_char, 0];
  1180	
  1181	        hash = helxo_shput(hash, c"bob".as_ptr() as *mut c_char, b'h' as c_char);
  1182	        hash = helxo_shput(hash, c"sally".as_ptr() as *mut c_char, b'e' as c_char);
  1183	        hash = helxo_shput(hash, c"fred".as_ptr() as *mut c_char, b'l' as c_char);
  1184	        hash = helxo_shput(hash, c"jen".as_ptr() as *mut c_char, b'x' as c_char);
