   345	            let mut i: usize = 0;
   346	            while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {
   347	                let ob = (*ot).storage.add(i);
   348	                for j in 0..STBDS_BUCKET_LENGTH {
   349	                    if stbds_index_in_use((*ob).index[j]) {
   350	                        let hash = (*ob).hash[j];
   351	                        let mut pos =
   352	                            stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);
   353	                        let mut step = STBDS_BUCKET_LENGTH;
   354	                        'probe: loop {
   355	                            let bucket = (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);
   356	
   357	                            let mut z = pos & STBDS_BUCKET_MASK;
   358	                            while z < STBDS_BUCKET_LENGTH {
   359	                                if (*bucket).hash[z] == 0 {
   360	                                    (*bucket).hash[z] = hash;
   361	                                    (*bucket).index[z] = (*ob).index[j];
   362	                                    break 'probe;
   363	                                }
   364	                                z += 1;
   365	                            }
   366	
   367	                            let limit = pos & STBDS_BUCKET_MASK;
   368	                            let mut z = 0usize;
   369	                            let mut placed = false;
   370	                            while z < limit {
   371	                                if (*bucket).hash[z] == 0 {
   372	                                    (*bucket).hash[z] = hash;
   373	                                    (*bucket).index[z] = (*ob).index[j];
   374	                                    placed = true;
   375	                                    break;
   376	                                }
   377	                                z += 1;
   378	                            }
   379	                            if placed {
   380	                                break 'probe;
   381	                            }
   382	
   383	                            pos = pos.wrapping_add(step);
   384	                            step = step.wrapping_add(STBDS_BUCKET_LENGTH);
   385	                            pos &= (*t).slot_count.wrapping_sub(1);
   386	                        }
   387	                    }
   388	                }
   389	                i += 1;
   390	            }
   391	        }
   392	
   393	        t
   394	    }
   395	}
   396	
   397	// ---------------------------------------------------------------------------
   398	// Hash functions
   399	// ---------------------------------------------------------------------------
   400	
   401	#[unsafe(no_mangle)]
   402	pub unsafe extern "C" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {
   403	    unsafe {
   404	        let mut s = str_ as *const c_uchar;
   405	        let mut hash: usize = seed;
   406	        while *s != 0 {
   407	            hash = hash
   408	                .rotate_left(9)
   409	                .wrapping_add(*s as usize);
   410	            s = s.add(1);
   411	        }
   412	
   413	        hash ^= seed;
   414	        hash = (!hash).wrapping_add(hash << 18);
   415	        hash ^= hash ^ hash.rotate_right(31);
   416	        hash = hash.wrapping_mul(21);
   417	        hash ^= hash ^ hash.rotate_right(11);
   418	        hash = hash.wrapping_add(hash << 6);
   419	        hash ^= hash.rotate_right(22);
   420	        hash.wrapping_add(seed)
   421	    }
   422	}
   423	
   424	const STBDS_SIPHASH_C_ROUNDS: usize = 2;
   425	const STBDS_SIPHASH_D_ROUNDS: usize = 4;
   426	
   427	macro_rules! stbds_sipround {
   428	    ($v0:ident, $v1:ident, $v2:ident, $v3:ident) => {{
   429	        $v0 = $v0.wrapping_add($v1);
   430	        $v1 = $v1.rotate_left(13);
   431	        $v1 ^= $v0;
   432	        $v0 = $v0.rotate_left(STBDS_SIZE_T_BITS / 2);
   433	        $v2 = $v2.wrapping_add($v3);
   434	        $v3 = $v3.rotate_left(16);
   435	        $v3 ^= $v2;
   436	        $v2 = $v2.wrapping_add($v1);
   437	        $v1 = $v1.rotate_left(17);
   438	        $v1 ^= $v2;
   439	        $v2 = $v2.rotate_left(STBDS_SIZE_T_BITS / 2);
   440	        $v0 = $v0.wrapping_add($v3);
   441	        $v3 = $v3.rotate_left(21);
   442	        $v3 ^= $v0;
   443	    }};
   444	}
   445	
   446	unsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {
   447	    unsafe {
   448	        let mut d = p as *const c_uchar;
   449	
   450	        let mut v0: usize = (((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575)) ^ seed;
   451	        let mut v1: usize = (((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d)) ^ !seed;
   452	        let mut v2: usize = (((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261)) ^ seed;
   453	        let mut v3: usize = (((0x74656462usize << 16) << 16).wrapping_add(0x79746573)) ^ !seed;
   454	
   455	        v0 ^= 0x0706050403020100usize ^ seed;
   456	        v1 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;
   457	        v2 ^= 0x0706050403020100usize ^ seed;
   458	        v3 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;
   459	
   460	        let mut i: usize = 0;
   461	        let mut data: usize;
   462	        while i.wrapping_add(size_of::<usize>()) <= len {
   463	            // `d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24)` is computed in `int`
   464	            // and then converted to `size_t`, so a byte >= 0x80 at d[3] sign-extends.
   465	            let lo = (*d.add(0) as u32)
   466	                | ((*d.add(1) as u32) << 8)
   467	                | ((*d.add(2) as u32) << 16)
   468	                | ((*d.add(3) as u32) << 24);
   469	            data = (lo as i32) as isize as usize;
   470	            let hi = (*d.add(4) as u32)
   471	                | ((*d.add(5) as u32) << 8)
   472	                | ((*d.add(6) as u32) << 16)
   473	                | ((*d.add(7) as u32) << 24);
   474	            data |= (((hi as i32) as isize as usize) << 16) << 16;
   475	
   476	            v3 ^= data;
   477	            for _ in 0..STBDS_SIPHASH_C_ROUNDS {
   478	                stbds_sipround!(v0, v1, v2, v3);
   479	            }
   480	            v0 ^= data;
   481	
   482	            i = i.wrapping_add(size_of::<usize>());
   483	            d = d.add(size_of::<usize>());
   484	        }
   485	
   486	        data = len << (STBDS_SIZE_T_BITS - 8);
   487	        // The C uses a fall-through switch on `len - i`.
   488	        let rem = len.wrapping_sub(i);
   489	        if rem >= 7 {
   490	            data |= ((*d.add(6) as usize) << 24) << 24;
   491	        }
   492	        if rem >= 6 {
   493	            data |= ((*d.add(5) as usize) << 20) << 20;
   494	        }
   495	        if rem >= 5 {
   496	            data |= ((*d.add(4) as usize) << 16) << 16;
   497	        }
   498	        if rem >= 4 {
   499	            // `d[3] << 24` is an `int` expression: sign-extends when d[3] >= 0x80.
   500	            data |= (((*d.add(3) as u32) << 24) as i32) as isize as usize;
   501	        }
   502	        if rem >= 3 {
   503	            data |= ((*d.add(2) as u32) << 16) as usize;
   504	        }
   505	        if rem >= 2 {
   506	            data |= ((*d.add(1) as u32) << 8) as usize;
   507	        }
   508	        if rem >= 1 {
   509	            data |= *d.add(0) as usize;
   510	        }
   511	
   512	        v3 ^= data;
   513	        for _ in 0..STBDS_SIPHASH_C_ROUNDS {
   514	            stbds_sipround!(v0, v1, v2, v3);
   515	        }
   516	        v0 ^= data;
   517	        v2 ^= 0xff;
   518	        for _ in 0..STBDS_SIPHASH_D_ROUNDS {
   519	            stbds_sipround!(v0, v1, v2, v3);
   520	        }
   521	
   522	        v0 ^ v1 ^ v2 ^ v3
   523	    }
   524	}
   525	
   526	#[unsafe(no_mangle)]
   527	pub unsafe extern "C" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {
   528	    unsafe { stbds_siphash_bytes(p, len, seed) }
   529	}
   530	
   531	// ---------------------------------------------------------------------------
   532	// Key comparison
   533	// ---------------------------------------------------------------------------
   534	
   535	unsafe fn stbds_is_key_equal(
   536	    a: *mut c_void,
   537	    elemsize: usize,
   538	    key: *mut c_void,
   539	    keysize: usize,
   540	    keyoffset: usize,
   541	    mode: c_int,
   542	    i: isize,
   543	) -> bool {
   544	    unsafe {
   545	        if mode >= STBDS_HM_STRING {
   546	            let slot = elem_ptr(a, elemsize, i).add(keyoffset) as *mut *mut c_char;
   547	            0 == strcmp(key as *const c_char, *slot)
   548	        } else {
   549	            0 == memcmp(
   550	                key as *const c_void,
   551	                elem_ptr(a, elemsize, i).add(keyoffset) as *const c_void,
   552	                keysize,
   553	            )
   554	        }
   555	    }
   556	}
   557	
   558	// ---------------------------------------------------------------------------
   559	// stbds_hmfree_func
   560	// ---------------------------------------------------------------------------
   561	
   562	#[unsafe(no_mangle)]
   563	pub unsafe extern "C" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {
   564	    unsafe {
   565	        if a.is_null() {
   566	            return;
   567	        }
   568	        if !stbds_hash_table(a).is_null() {
   569	            if (*stbds_hash_table(a)).string.mode as c_int == STBDS_SH_STRDUP {
   570	                let mut i: usize = 1;
   571	                while i < (*stbds_header(a)).length {
   572	                    stbds_free(
   573	                        *(elem_ptr(a, elemsize, i as isize) as *mut *mut c_char) as *mut c_void,
   574	                    );
   575	                    i += 1;
   576	                }
   577	            }
   578	            stbds_strreset(&raw mut (*stbds_hash_table(a)).string);
   579	        }
   580	        stbds_free((*stbds_header(a)).hash_table);
   581	        stbds_free(stbds_header(a) as *mut c_void);
   582	    }
   583	}
   584	
   585	// ---------------------------------------------------------------------------
   586	// stbds_hm_find_slot
   587	// ---------------------------------------------------------------------------
   588	
   589	unsafe fn stbds_hm_find_slot(
   590	    a: *mut c_void,
   591	    elemsize: usize,
   592	    key: *mut c_void,
   593	    keysize: usize,
   594	    keyoffset: usize,
   595	    mode: c_int,
   596	) -> isize {
   597	    unsafe {
   598	        let raw_a = hash_to_arr(a, elemsize);
   599	        let table = stbds_hash_table(raw_a);
   600	        let mut hash = if mode >= STBDS_HM_STRING {
   601	            stbds_hash_string(key as *mut c_char, (*table).seed)
   602	        } else {
   603	            stbds_hash_bytes(key, keysize, (*table).seed)
   604	        };
   605	        let mut step = STBDS_BUCKET_LENGTH;
   606	
   607	        if hash < 2 {
   608	            hash = hash.wrapping_add(2);
   609	        }
   610	
   611	        let mut pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);
   612	
   613	        loop {
   614	            let bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);
   615	
   616	            let mut i = pos & STBDS_BUCKET_MASK;
   617	            while i < STBDS_BUCKET_LENGTH {
   618	                if (*bucket).hash[i] == hash {
   619	                    if stbds_is_key_equal(
   620	                        a,
   621	                        elemsize,
   622	                        key,
   623	                        keysize,
   624	                        keyoffset,
   625	                        mode,
   626	                        (*bucket).index[i],
   627	                    ) {
   628	                        return ((pos & !STBDS_BUCKET_MASK) + i) as isize;
   629	                    }
   630	                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {
   631	                    return -1;
   632	                }
   633	                i += 1;
   634	            }
   635	
   636	            let limit = pos & STBDS_BUCKET_MASK;
   637	            let mut i = 0usize;
   638	            while i < limit {
   639	                if (*bucket).hash[i] == hash {
   640	                    if stbds_is_key_equal(
   641	                        a,
   642	                        elemsize,
   643	                        key,
   644	                        keysize,
   645	                        keyoffset,
   646	                        mode,
   647	                        (*bucket).index[i],
   648	                    ) {
   649	                        return ((pos & !STBDS_BUCKET_MASK) + i) as isize;
   650	                    }
   651	                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {
   652	                    return -1;
   653	                }
   654	                i += 1;
   655	            }
   656	
   657	            pos = pos.wrapping_add(step);
   658	            step = step.wrapping_add(STBDS_BUCKET_LENGTH);
   659	            pos &= (*table).slot_count.wrapping_sub(1);
   660	        }
   661	    }
   662	}
   663	
   664	// ---------------------------------------------------------------------------
   665	// stbds_hmget_key_ts / stbds_hmget_key
   666	// ---------------------------------------------------------------------------
   667	
   668	#[unsafe(no_mangle)]
   669	pub unsafe extern "C" fn stbds_hmget_key_ts(
   670	    a: *mut c_void,
   671	    elemsize: usize,
   672	    key: *mut c_void,
   673	    keysize: usize,
   674	    temp: *mut isize,
   675	    mode: c_int,
   676	) -> *mut c_void {
   677	    unsafe {
   678	        let keyoffset: usize = 0;
   679	        if a.is_null() {
   680	            let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);
   681	            (*stbds_header(a)).length += 1;
   682	            memset(a, 0, elemsize);
   683	            *temp = STBDS_INDEX_EMPTY;
   684	            arr_to_hash(a, elemsize)
   685	        } else {
   686	            let raw_a = hash_to_arr(a, elemsize);
   687	            let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;
   688	            if table.is_null() {
   689	                *temp = -1;
   690	            } else {
   691	                let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);
   692	                if slot < 0 {
   693	                    *temp = STBDS_INDEX_EMPTY;
   694	                } else {
   695	                    let b = (*table).storage.add((slot >> STBDS_BUCKET_SHIFT) as usize);
   696	                    *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];
   697	                }
   698	            }
   699	            a
   700	        }
   701	    }
   702	}
   703	
   704	#[unsafe(no_mangle)]
   705	pub unsafe extern "C" fn stbds_hmget_key(
   706	    a: *mut c_void,
   707	    elemsize: usize,
   708	    key: *mut c_void,
   709	    keysize: usize,
   710	    mode: c_int,
   711	) -> *mut c_void {
   712	    unsafe {
   713	        let mut temp: isize = 0;
   714	        let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &mut temp, mode);
   715	        stbds_temp_set(hash_to_arr(p, elemsize), temp);
   716	        p
   717	    }
   718	}
   719	
   720	// ---------------------------------------------------------------------------
   721	// stbds_hmput_default
   722	// ---------------------------------------------------------------------------
   723	
   724	#[unsafe(no_mangle)]
   725	pub unsafe extern "C" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {
   726	    unsafe {
   727	        let mut a = a;
   728	        if a.is_null() || (*stbds_header(hash_to_arr(a, elemsize))).length == 0 {
   729	            let base = if !a.is_null() {
   730	                hash_to_arr(a, elemsize)
   731	            } else {
   732	                ptr::null_mut()
   733	            };
   734	            let g = stbds_arrgrowf(base, elemsize, 0, 1);
   735	            (*stbds_header(g)).length += 1;
   736	            memset(g, 0, elemsize);
   737	            a = arr_to_hash(g, elemsize);
   738	        }
   739	        a
   740	    }
   741	}
   742	
   743	// ---------------------------------------------------------------------------
   744	// stbds_hmput_key
   745	// ---------------------------------------------------------------------------
   746	
   747	#[unsafe(no_mangle)]
   748	pub unsafe extern "C" fn stbds_hmput_key(
   749	    a: *mut c_void,
   750	    elemsize: usize,
   751	    key: *mut c_void,
   752	    keysize: usize,
   753	    mode: c_int,
   754	) -> *mut c_void {
   755	    unsafe {
   756	        let keyoffset: usize = 0;
   757	        let mut a = a;
   758	        let mut raw_a: *mut c_void;
   759	        let mut table: *mut stbds_hash_index;
   760	
   761	        if a.is_null() {
   762	            let g = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);
   763	            memset(g, 0, elemsize);
   764	            (*stbds_header(g)).length += 1;
   765	            a = arr_to_hash(g, elemsize);
   766	        }
   767	
   768	        raw_a = a;
   769	        a = hash_to_arr(a, elemsize);
   770	
   771	        table = (*stbds_header(a)).hash_table as *mut stbds_hash_index;
   772	
   773	        if table.is_null() || (*table).used_count >= (*table).used_count_threshold {
   774	            let slot_count = if table.is_null() {
   775	                STBDS_BUCKET_LENGTH
   776	            } else {
   777	                (*table).slot_count.wrapping_mul(2)
   778	            };
   779	            let nt = stbds_make_hash_index(slot_count, table);
   780	            if !table.is_null() {
   781	                stbds_free(table as *mut c_void);
   782	            } else {
   783	                (*nt).string.mode = if mode >= STBDS_HM_STRING {
   784	                    STBDS_SH_DEFAULT as c_uchar
   785	                } else {
   786	                    0
   787	                };
   788	            }
   789	            table = nt;
   790	            (*stbds_header(a)).hash_table = table as *mut c_void;
   791	        }
   792	
   793	        let mut hash = if mode >= STBDS_HM_STRING {
   794	            stbds_hash_string(key as *mut c_char, (*table).seed)
   795	        } else {
   796	            stbds_hash_bytes(key, keysize, (*table).seed)
   797	        };
   798	        let mut step = STBDS_BUCKET_LENGTH;
   799	        let mut pos: usize;
   800	        let mut tombstone: isize = -1;
   801	        let mut bucket: *mut stbds_hash_bucket;
   802	
   803	        if hash < 2 {
   804	            hash = hash.wrapping_add(2);
   805	        }
   806	
   807	        pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);
   808	
   809	        'outer: loop {
   810	            bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);
   811	
   812	            let mut i = pos & STBDS_BUCKET_MASK;
   813	            while i < STBDS_BUCKET_LENGTH {
   814	                if (*bucket).hash[i] == hash {
   815	                    if stbds_is_key_equal(
   816	                        raw_a,
   817	                        elemsize,
   818	                        key,
   819	                        keysize,
   820	                        keyoffset,
   821	                        mode,
   822	                        (*bucket).index[i],
   823	                    ) {
   824	                        stbds_temp_set(a, (*bucket).index[i]);
   825	                        if mode >= STBDS_HM_STRING {
   826	                            let v = *(elem_ptr(raw_a, elemsize, (*bucket).index[i]).add(keyoffset)
   827	                                as *mut *mut c_char);
   828	                            stbds_temp_key_set(a, v);
   829	                        }
   830	                        return arr_to_hash(a, elemsize);
   831	                    }
   832	                } else if (*bucket).hash[i] == 0 {
   833	                    pos = (pos & !STBDS_BUCKET_MASK) + i;
   834	                    break 'outer;
   835	                } else if tombstone < 0 {
   836	                    if (*bucket).index[i] == STBDS_INDEX_DELETED {
   837	                        tombstone = ((pos & !STBDS_BUCKET_MASK) + i) as isize;
   838	                    }
   839	                }
   840	                i += 1;
   841	            }
   842	
   843	            let limit = pos & STBDS_BUCKET_MASK;
   844	            let mut i = 0usize;
   845	            let mut found_empty = false;
   846	            while i < limit {
   847	                if (*bucket).hash[i] == hash {
   848	                    if stbds_is_key_equal(
   849	                        raw_a,
   850	                        elemsize,
   851	                        key,
   852	                        keysize,
   853	                        keyoffset,
   854	                        mode,
   855	                        (*bucket).index[i],
   856	                    ) {
   857	                        stbds_temp_set(a, (*bucket).index[i]);
   858	                        return arr_to_hash(a, elemsize);
   859	                    }
   860	                } else if (*bucket).hash[i] == 0 {
   861	                    pos = (pos & !STBDS_BUCKET_MASK) + i;
   862	                    found_empty = true;
   863	                    break;
   864	                } else if tombstone < 0 {
   865	                    if (*bucket).index[i] == STBDS_INDEX_DELETED {
   866	                        tombstone = ((pos & !STBDS_BUCKET_MASK) + i) as isize;
   867	                    }
   868	                }
   869	                i += 1;
   870	            }
   871	            if found_empty {
   872	                break 'outer;
   873	            }
   874	
   875	            pos = pos.wrapping_add(step);
   876	            step = step.wrapping_add(STBDS_BUCKET_LENGTH);
   877	            pos &= (*table).slot_count.wrapping_sub(1);
   878	        }
   879	
   880	        // found_empty_slot:
   881	        if tombstone >= 0 {
   882	            pos = tombstone as usize;
   883	            (*table).tombstone_count -= 1;
   884	        }
   885	        (*table).used_count += 1;
   886	
   887	        {
   888	            let i: isize = stbds_arrlen(a);
   889	            if (i as usize).wrapping_add(1) > stbds_arrcap(a) {
   890	                a = stbds_arrgrowf(a, elemsize, 1, 0);
   891	            }
