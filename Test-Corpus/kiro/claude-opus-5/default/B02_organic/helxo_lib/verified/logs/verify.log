  1029	// String storage
  1030	// ---------------------------------------------------------------------------
  1031	
  1032	unsafe fn stbds_strdup(str_: *mut c_char) -> *mut c_char {
  1033	    unsafe {
  1034	        let len = strlen(str_) + 1;
  1035	        let p = stbds_realloc(ptr::null_mut(), len) as *mut c_char;
  1036	        memmove(p as *mut c_void, str_ as *const c_void, len);
  1037	        p
  1038	    }
  1039	}
  1040	
  1041	const STBDS_STRING_ARENA_BLOCKSIZE_MIN: usize = 512;
  1042	const STBDS_STRING_ARENA_BLOCKSIZE_MAX: usize = 1 << 20;
  1043	
  1044	#[unsafe(no_mangle)]
  1045	pub unsafe extern "C" fn stbds_stralloc(
  1046	    a: *mut stbds_string_arena,
  1047	    str_: *mut c_char,
  1048	) -> *mut c_char {
  1049	    unsafe {
  1050	        let len = strlen(str_) + 1;
  1051	        if len > (*a).remaining {
  1052	            let blocksize0 = (*a).block as usize;
  1053	
  1054	            let blocksize =
  1055	                STBDS_STRING_ARENA_BLOCKSIZE_MIN.wrapping_shl((blocksize0 >> 1) as u32);
  1056	
  1057	            if blocksize < STBDS_STRING_ARENA_BLOCKSIZE_MAX {
  1058	                (*a).block = (*a).block.wrapping_add(1);
  1059	            }
  1060	
  1061	            if len > blocksize {
  1062	                let sb = stbds_realloc(
  1063	                    ptr::null_mut(),
  1064	                    size_of::<stbds_string_block>() - 8 + len,
  1065	                ) as *mut stbds_string_block;
  1066	                memmove(
  1067	                    (&raw mut (*sb).storage) as *mut c_void,
  1068	                    str_ as *const c_void,
  1069	                    len,
  1070	                );
  1071	                if !(*a).storage.is_null() {
  1072	                    (*sb).next = (*(*a).storage).next;
  1073	                    (*(*a).storage).next = sb;
  1074	                } else {
  1075	                    (*sb).next = ptr::null_mut();
  1076	                    (*a).storage = sb;
  1077	                    (*a).remaining = 0;
  1078	                }
  1079	                return (&raw mut (*sb).storage) as *mut c_char;
  1080	            } else {
  1081	                let sb = stbds_realloc(
  1082	                    ptr::null_mut(),
  1083	                    size_of::<stbds_string_block>() - 8 + blocksize,
  1084	                ) as *mut stbds_string_block;
  1085	                (*sb).next = (*a).storage;
  1086	                (*a).storage = sb;
  1087	                (*a).remaining = blocksize;
  1088	            }
  1089	        }
  1090	
  1091	        let p = ((&raw mut (*(*a).storage).storage) as *mut c_char)
  1092	            .add((*a).remaining)
  1093	            .sub(len);
  1094	        (*a).remaining -= len;
  1095	        memmove(p as *mut c_void, str_ as *const c_void, len);
  1096	        p
  1097	    }
  1098	}
