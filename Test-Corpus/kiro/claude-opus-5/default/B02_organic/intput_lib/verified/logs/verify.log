[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m fn row52_55_hmfree_all_modes() {
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m     let _g = lock();
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x909);
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m     // populated tables in every string mode (freeing must not crash and must
