[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m fn row45_46_tombstones() {
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m     let _g = lock();
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x707);
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m     for round in 0..8usize {
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m         let mut m = MapPair::new(8, 4, KeyKind::Bytes);
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m         m.pin_seed(PIN.wrapping_add(round));
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m         // fill to a large table, then churn: delete one + insert one, keeping
