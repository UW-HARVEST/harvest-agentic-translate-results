[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m         if round == 0 {
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m             assert!(saw_rebuild, "tombstone rebuild path never taken");
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m             assert!(saw_tombstone_reuse, "tombstone reuse path never taken");
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m         }
