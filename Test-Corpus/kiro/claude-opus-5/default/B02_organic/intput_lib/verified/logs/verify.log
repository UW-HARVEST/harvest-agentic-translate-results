[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m                     assert_eq!(t, 1, "sh={sh} mode={mode} n={n} i={i}: delete must report 1");
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m                     assert_eq!(m.get(k, mode), -1, "deleted string key still present");
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m                 }
