[0m[49m[38;5;10m+     8[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     9[0m:[38;5;10m[49m ```c
[0m[49m[38;5;10m+    10[0m:[38;5;10m[49m typedef int16_t mp3d_sample_t;
