[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m     for tap in 0..N_TAPS {
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m         for &blk2 in &[false, true] {
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m             let mut z = z_zeros();
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m             if blk2 {
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m                 set_tap2(&mut z, tap, f32::NAN);
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m             } else {
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m                 set_tap1(&mut z, tap, f32::NAN);
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m             h.assert_same(
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m                 &format!("E11 NaN at tap {tap} block{}", if blk2 { 2 } else { 1 }),
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m                 &z,
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m                 2,
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m                 &pre,
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m                 PCM_MID,
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m // E12 / E13 — infinities
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m fn err_e12_e13_infinities() {
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m     let h = Harness::load();
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m     assert_sentinel(&h, "E12 +Inf", f32::INFINITY, f32::INFINITY, 32767, 32767);
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     assert_sentinel(&h, "E13 -Inf", f32::NEG_INFINITY, f32::NEG_INFINITY, -32768, -32768);
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m     assert_sentinel(&h, "E12/E13 mixed", f32::INFINITY, f32::NEG_INFINITY, 32767, -32768);
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m     // Inf at each tap: subtraction pairings turn Inf - Inf into NaN, which is a
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     // different downstream branch again.
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     let pre = prefill();
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     for tap in 0..N_TAPS {
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m         for inf in [f32::INFINITY, f32::NEG_INFINITY] {
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m             let mut z = z_zeros();
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m             set_tap1(&mut z, tap, inf);
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m             set_tap2(&mut z, tap, inf);
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m             h.assert_same(&format!("E12/E13 Inf at tap {tap} ({inf})"), &z, 2, &pre, PCM_MID);
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     // Both operands of every subtraction pair infinite -> Inf - Inf == NaN.
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m     for &(hi, lo) in &[(14usize, 0usize), (12, 2), (10, 4), (8, 6)] {
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m         for inf in [f32::INFINITY, f32::NEG_INFINITY] {
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m             let mut z = z_zeros();
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m             set_tap1(&mut z, hi, inf);
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m             set_tap1(&mut z, lo, inf);
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m             h.assert_same(&format!("E12/E13 Inf-Inf pair ({hi},{lo})"), &z, 2, &pre, PCM_MID);
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m // E14 / E15 — null pointers (unchecked UB) — compared OUT OF PROCESS
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m /// Child mode: performs one deliberately faulting call and is expected to die.
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m /// Selected by the `HARVEST_FAULT` env var; a normal test run sets nothing and
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m /// this returns immediately.
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m fn fault_child() {
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m     let mode = match std::env::var("HARVEST_FAULT") {
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m         Ok(m) => m,
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m         Err(_) => return, // not the child; nothing to do
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     let h = Harness::load();
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m     let z = z_zeros();
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m     let mut pcm = vec![0i16; 4096];
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m         match mode.as_str() {
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m             "c_null_pcm" => h.call_raw_c(std::ptr::null_mut(), 2, z.as_ptr()),
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m             "r_null_pcm" => h.call_raw_rust(std::ptr::null_mut(), 2, z.as_ptr()),
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m             "c_null_z" => h.call_raw_c(pcm.as_mut_ptr(), 2, std::ptr::null()),
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m             "r_null_z" => h.call_raw_rust(pcm.as_mut_ptr(), 2, std::ptr::null()),
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m             "c_null_both" => h.call_raw_c(std::ptr::null_mut(), 2, std::ptr::null()),
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m             "r_null_both" => h.call_raw_rust(std::ptr::null_mut(), 2, std::ptr::null()),
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m             other => panic!("unknown fault mode {other}"),
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m     // If we get here the call did not fault; report it so the parent sees a
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m     // clean exit code rather than a signal.
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m     println!("survived {mode}");
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m     std::process::exit(0);
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m /// Outcome of a child run: `Ok(())` = exited 0, `Err(sig)` = killed by signal.
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m fn run_fault_child(mode: &str) -> Result<(), i32> {
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m     use std::process::Command;
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m     let exe = std::env::current_exe().expect("current_exe");
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m     let out = Command::new(exe)
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         .args(["--exact", "fault_child", "--nocapture", "--test-threads=1"])
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m         .env("HARVEST_FAULT", mode)
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         .output()
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         .expect("spawn fault child");
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m     match out.status.code() {
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         Some(0) => Ok(()),
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m         Some(c) => Err(-c), // non-signal failure, distinguished from signals
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m         None => {
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m             // Killed by a signal; `ExitStatusExt` gives us which one.
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m             #[cfg(unix)]
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m             {
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m                 use std::os::unix::process::ExitStatusExt;
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m                 Err(out.status.signal().unwrap_or(-1))
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m             #[cfg(not(unix))]
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m             {
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m                 Err(-1)
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m fn err_e14_e15_null_pointers() {
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m     // E14: pcm == NULL. E15: z == NULL. Neither is checked by the C, so both
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m     // must fault, and the Rust must fault the SAME way (same signal).
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m     for (c_mode, r_mode, row) in [
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m         ("c_null_pcm", "r_null_pcm", "E14 pcm==NULL"),
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m         ("c_null_z", "r_null_z", "E15 z==NULL"),
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m         ("c_null_both", "r_null_both", "E14+E15 both NULL"),
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m         let c = run_fault_child(c_mode);
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m         let r = run_fault_child(r_mode);
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m             c, r,
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m             "{row}: C outcome {c:?} != Rust outcome {r:?} (expected both SIGSEGV = Err(11))"
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m             c,
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m             Err(11),
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m             "{row}: expected SIGSEGV from the unchecked null dereference, got {c:?}"
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m // E16 — nch == 0: the two stores collide, second wins
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m fn err_e16_nch_zero_second_store_wins() {
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m     let h = Harness::load();
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xE16);
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m     for _ in 0..1000 {
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m         // Make the two accumulators land on distinguishable sentinels so the
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m         // "which store wins" question has an observable answer.
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m         let (a1, a2) = (1.0e6f32, -1.0e6f32);
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m         let z = z_for_accumulators(a1, a2).unwrap();
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m         let pre: Vec<i16> = (0..PCM_LEN).map(|_| rng.next_u32() as i16).collect();
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m         let out = h.assert_same("E16 nch=0", &z, 0, &pre, PCM_MID);
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m             out[PCM_MID], -32768,
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m             "E16: with nch=0 the pcm[16*nch] store must overwrite pcm[0]"
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m // E17 — negative nch: signed pointer arithmetic, must not wrap through usize
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m fn err_e17_negative_nch() {
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m     let h = Harness::load();
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xE17);
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m     for nch in -64i32..0 {
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m         let (a1, a2) = (1.0e6f32, -1.0e6f32);
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m         let z = z_for_accumulators(a1, a2).unwrap();
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m         let pre: Vec<i16> = (0..PCM_LEN).map(|_| rng.next_u32() as i16).collect();
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m         let out = h.assert_same(&format!("E17 nch={nch}"), &z, nch, &pre, PCM_MID);
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m         let idx = (PCM_MID as isize + 16 * nch as isize) as usize;
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m         assert_eq!(out[PCM_MID], 32767, "E17 nch={nch}: pcm[0]");
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m         assert_eq!(out[idx], -32768, "E17 nch={nch}: pcm[16*nch] at index {idx}");
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m // E18 — `16 * nch` overflows int
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m fn err_e18_nch_int_overflow() {
