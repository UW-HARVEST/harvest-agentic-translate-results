#include <stdio.h>
#include <stdint.h>
#include <stddef.h>
#include <string.h>
extern char *bin2hex(char *, size_t, const uint8_t *, size_t);
int main(void){
    uint8_t bin[256]; char hex[600];
    for(int i=0;i<256;i++) bin[i]=(uint8_t)i;
    for(size_t n=0;n<=256;n++){
        memset(hex,0x7f,sizeof hex);
        bin2hex(hex, n*2+1, bin, n);
        fwrite(hex,1,n*2+1,stdout);
        fputc('\n',stdout);
    }
    /* NULL bin with len 0 */
    memset(hex,0x7f,sizeof hex);
    bin2hex(hex,1,NULL,0); fwrite(hex,1,1,stdout); fputc('\n',stdout);
    return 0;
}
EOF
