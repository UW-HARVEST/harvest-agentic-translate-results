Purpose: Add rlib crate-type so cargo test rebuilds the cdylib

[package]
name = "translation"
version = "0.1.0"
edition = "2024"

[lib]
# `rlib` is added alongside `cdylib` so that `cargo test` treats the library as
# a dependency of the integration tests and therefore REBUILDS the `.so` before
# running them. With `cdylib` alone, `cargo test` skips the library target
# entirely and the tests silently load a stale `.so`.
crate-type = ["cdylib", "rlib"]
path = "src/lib.rs"
name = "bin2hex_lib"

[dev-dependencies]
