    18	#[unsafe(no_mangle)]
    19	pub unsafe extern "C" fn gaussian_kernel(dest: *mut f32, size: c_int, radius: f32) {
    20	    let sigma: f32 = 1.6f32;
    21	    let tetha: f32 = 2.25f32;
    22	    // int hsize = size / 2;  (C integer division truncates toward zero)
    23	    let hsize: c_int = size / 2;
    24	
    25	    let s2: f32 = 1.0f32 / unsafe { expf(sigma * sigma * tetha) };
