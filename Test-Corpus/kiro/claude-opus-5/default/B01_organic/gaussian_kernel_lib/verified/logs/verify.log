[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m // Row 17: poison pattern -> which slots are written / left alone.
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m fn row17_poison_pattern_untouched_tail() {
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m     let mut rng = Rng::new(0x1011);
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m     for _ in 0..N {
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m         let size = (rng.int_in(2, 64) as c_int) & !1;
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m         let radius = rng.logunif_f32(1e-2, 1e2);
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m         let n = buffer_len(size);
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m         // Distinct poison per slot so a stray write of the "right" value is
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m         // still detected.
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m         let fill: Vec<f32> = (0..n)
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m             .map(|i| f32::from_bits(0xDEAD_0000u32 | (i as u32 & 0xFFFF)))
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m             .collect();
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m         let (c, r) = run_both(size, radius, &fill);
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m         assert_same(size, radius, &c, &r, "row17 poison");
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m         // Also assert the C really writes exactly written_len(size) slots and
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m         // Rust agrees about which ones stayed poisoned.
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m         let w = written_len(size);
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m         for i in w..n {
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m                 c[i], fill[i].to_bits(),
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m                 "C wrote past written_len at [{i}] for size={size}"
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m                 r[i], fill[i].to_bits(),
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m                 "Rust wrote past written_len at [{i}] for size={size}"
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m // Row 18: repeated in-place invocation (statelessness).
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m fn row18_repeated_inplace_calls() {
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     let cf = c_gaussian_kernel();
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m     let rf = rust_gaussian_kernel();
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m     let mut rng = Rng::new(0x1012);
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m     for _ in 0..N {
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         let size = rng.int_in(1, 80) as c_int;
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         let n = buffer_len(size);
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         let r1 = rng.logunif_f32(1e-2, 1e2);
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         let r2 = rng.logunif_f32(1e-2, 1e2);
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         let r3 = rng.logunif_f32(1e-2, 1e2);
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m         let mut cbuf = vec![poison(); n];
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m         let mut rbuf = vec![poison(); n];
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         unsafe {
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m             for radius in [r1, r2, r3] {
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m                 cf(cbuf.as_mut_ptr(), size, radius);
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m                 rf(rbuf.as_mut_ptr(), size, radius);
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m         let c: Vec<u32> = cbuf.iter().map(|f| f.to_bits()).collect();
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         let r: Vec<u32> = rbuf.iter().map(|f| f.to_bits()).collect();
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         assert_same(size, r3, &c, &r, "row18 repeated in-place");
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         // A fresh single call with r3 must give the same answer (stateless).
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         let (c1, r1b) = run_both_poisoned(size, r3);
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         assert_same(size, r3, &c, &c1, "row18 C not stateless");
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         assert_same(size, r3, &r, &r1b, "row18 Rust not stateless");
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m // Row 19: radius values sitting on the `v > 0` clamp boundary.
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m /// `v = 1/expf(x*x) - s2` flips sign at `x*x == sigma^2*tetha`, i.e.
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m /// `|x| == 1.6*1.5 == 2.4`. With `x = r * (1.6/radius)` that is
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m /// `radius == r * 1.6 / 2.4` for the element at offset `r`.
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m fn row19_clamp_boundary_radii() {
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m     let mut cases: Vec<f32> = Vec::new();
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m     for r in 1..=48i32 {
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m         let base = (r as f32) * 1.6f32 / 2.4f32;
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m         // walk a few ULPs either side of the exact flip point
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m         let b = base.to_bits();
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m         for d in -4i32..=4 {
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m             let bits = (b as i64 + d as i64) as u32;
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m             let v = f32::from_bits(bits);
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m             if v.is_finite() && v > 0.0 {
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m                 cases.push(v);
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m                 cases.push(-v);
