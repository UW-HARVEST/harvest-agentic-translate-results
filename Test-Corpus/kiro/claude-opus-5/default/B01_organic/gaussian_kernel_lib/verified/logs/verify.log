[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m // E20 — isum = 1/sum overflow
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m fn e20_reciprocal_of_sum_overflow_is_unreachable_but_parity_holds() {
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m     // `sum` is a sum of clamped values, each either 0 or `1/expf(x*x) - s2`.
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m     // Because s2 ~= 3.15e-3, the smallest representable *positive* v is on the
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m     // order of one ulp at that magnitude (~2.3e-10), so a positive `sum` can
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m     // never be small enough for `1.0f/sum` to overflow to +inf. Rather than
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m     // fake this row, search hard for the smallest positive sum reachable and
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m     // assert (a) C/Rust parity throughout and (b) that the search confirms
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m     // non-reachability.
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m     let mut rng = seeded(20);
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m     let mut min_positive_sum = f32::INFINITY;
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m     let mut saw_inf_or_nan_output = false;
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m     // Sweep radii densely just below the all-clamped threshold, where exactly
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m     // one tap survives with the smallest possible value.
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m     let mut probe = |size: i32, radius: f32, min: &mut f32, saw: &mut bool| {
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m         let out = expect_match(size, radius);
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m         let b = branches(size, radius);
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m         if b.normalised {
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m             let s2v = s2();
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m             let mut sum = 0.0f32;
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m             let hsize = size / 2;
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m             let rs = 1.6f32 / radius;
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m             let mut r = -hsize;
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m             while r <= hsize {
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m                 let x = (r as f32) * rs;
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m                 let v = (1.0f32 / (x * x).exp()) - s2v;
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m                 sum += if v > 0.0 { v } else { 0.0 };
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m                 r += 1;
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m             if sum > 0.0 && sum < *min {
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m                 *min = sum;
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m         if out.iter().take(touched_len(size)).any(|v| !v.is_finite()) {
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m             *saw = true;
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m     // Dense ULP walk around the boundary radius for several r.
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m     for r in 1..=6i32 {
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m         let base = ((r as f32) * (2.0f32 / 3.0f32)).to_bits();
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m         for d in 0..4000u32 {
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m             for cand in [base.wrapping_sub(d), base.wrapping_add(d)] {
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m                 let radius = f32::from_bits(cand);
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m                 if !radius.is_finite() || radius == 0.0 {
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m                     continue;
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m                 probe(2 * r + 1, radius, &mut min_positive_sum, &mut saw_inf_or_nan_output);
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m     // Broad randomized search.
