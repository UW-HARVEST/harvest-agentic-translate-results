    bl = subprocess.run(['cargo','build'],capture_output=True,text=True,timeout=300)
    if bl.returncode!=0:
        results.append((name,"BUILD-FAIL",bl.stderr[-300:])); continue
    t = subprocess.run(['cargo','test','--','--test-threads=4'],capture_output=True,text=True,timeout=600)
    caught = t.returncode != 0
    fails=[l for l in t.stdout.splitlines() if l.startswith('    ') and l.strip() and 'test result' not in l]
    results.append((name, "CAUGHT" if caught else "*** SURVIVED ***", "; ".join(x.strip() for x in fails[:6])))
