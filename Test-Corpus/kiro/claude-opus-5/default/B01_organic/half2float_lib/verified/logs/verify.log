/// `float half2float(uint16_t h)`
///
/// Mirrors the C implementation exactly:
/// ```c
/// int n = h >> 10;
/// out.num = m__mantissa[(h & 0x3ff) + m__offset[n]] + m__exponent[n];
/// return out.flt;
/// ```
/// The addition is unsigned 32-bit and wraps, matching C's `uint32_t`
/// arithmetic, and the result is reinterpreted as a `float`.
#[unsafe(no_mangle)]
pub extern "C" fn half2float(h: u16) -> core::ffi::c_float {
    let n = (h >> 10) as usize;
    let idx = (h & 0x3ff) as usize + M_OFFSET[n] as usize;
    let num = M_MANTISSA[idx].wrapping_add(M_EXPONENT[n]);
    f32::from_bits(num)
}
