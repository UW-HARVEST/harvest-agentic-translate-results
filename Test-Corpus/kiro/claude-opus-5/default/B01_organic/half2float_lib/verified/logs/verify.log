python3 - <<'EOF'
import re
c = open('c_src/src/lib.c').read()
r = open('translation/src/lib.rs').read()

def grab(text, start_marker, end='};'):
    i = text.index(start_marker)
    j = text.index(end, i)
    body = text[i+len(start_marker):j]
    return [int(x,16) for x in re.findall(r'0x[0-9a-fA-F]+', body)]

cm = grab(c, 'm__mantissa[2048] = {')
co = grab(c, 'm__offset[64] = {')
ce = grab(c, 'm__exponent[64] = {')

def grabr(text, marker):
    i = text.index(marker)
    j = text.index('];', i)
    return [int(x,16) for x in re.findall(r'0x[0-9a-fA-F]+', text[i+len(marker):j])]

rm = grabr(r, 'M__MANTISSA: [u32; 2048] = [')
ro = grabr(r, 'M__OFFSET: [u16; 64] = [')
re_ = grabr(r, 'M__EXPONENT: [u32; 64] = [')

for name, a, b, n in (('mantissa',cm,rm,2048),('offset',co,ro,64),('exponent',ce,re_,64)):
    print(name, 'C len', len(a), 'Rust len', len(b), 'expected', n, 'EQUAL' if a==b else 'DIFFER')
    if a != b:
        for k,(x,y) in enumerate(zip(a,b)):
            if x!=y: print('  idx',k,hex(x),hex(y))
