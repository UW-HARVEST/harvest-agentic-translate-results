#include <stdio.h>
#include <stddef.h>
#include <wchar.h>
#include <string.h>

int TESTFN(wchar_t *dst, size_t numElem, const wchar_t *src);

static void dump(const char *label, wchar_t *buf, size_t n, int rc) {
    printf("%s rc=%d buf=[", label, rc);
    for (size_t i = 0; i < n; i++) printf("%d,", (int)buf[i]);
    printf("]\n");
}

#define CAP 8
static void run(const char *label, const wchar_t *init, size_t initlen,
                size_t numElem, const wchar_t *src) {
    wchar_t buf[CAP];
    for (size_t i = 0; i < CAP; i++) buf[i] = -1;
    memcpy(buf, init, initlen * sizeof(wchar_t));
    int rc = TESTFN(buf, numElem, src);
    dump(label, buf, CAP, rc);
}

int main(void) {
    wchar_t empty[1] = {0};
    wchar_t ab[3] = {L'a', L'b', 0};
    wchar_t full[4] = {L'a', L'b', L'c', L'd'};
    wchar_t s_x[2] = {L'x', 0};
    wchar_t s_long[6] = {L'1',L'2',L'3',L'4',L'5',0};
    wchar_t s_empty[1] = {0};

    printf("nulldst rc=%d\n", TESTFN(NULL, 8, s_x));
    printf("nulldst0 rc=%d\n", TESTFN(NULL, 0, s_x));

    run("zero", ab, 3, 0, s_x);
    run("nullsrc", ab, 3, 4, NULL);
    run("nullsrc-empty", empty, 1, 1, NULL);
    run("append", ab, 3, 8, s_x);
    run("append-empty-dst", empty, 1, 8, s_x);
    run("append-empty-src", ab, 3, 8, s_empty);
    run("exactfit", ab, 3, 6, s_long);
    run("toosmall", ab, 3, 5, s_long);
    run("unterm", full, 4, 4, s_x);
    run("unterm-room", full, 4, 6, s_x);
    run("cap1", empty, 1, 1, s_x);
    run("cap1-empty", empty, 1, 1, s_empty);
    return 0;
}
