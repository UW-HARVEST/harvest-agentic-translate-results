  uint32_t Ps[]={0,1,2,7,31,32,33,62,63,64,65,66,100,127,128,4096,0x10000,0x7FFFFFFF,0x80000000,0xFFFFFFFF};
  st=0xC0FFEE1234ULL;
  for(size_t i=0;i<sizeof(Ss)/4;i++) for(size_t j=0;j<sizeof(Ps)/4;j++) for(int k=0;k<400;k++){
    BW x,y; uint64_t v=nx();
    x.val=nx(); x.bits=Ss[i]; x.pos=(uint32_t)nx(); x.len=(uint32_t)nx(); x.tot=(uint32_t)nx(); x.buffer=(uint8_t*)nx();
    y=x;
    int ra=a(&x,Ps[j],v), rb=b(&y,Ps[j],v); n++;
    if(ra!=rb||memcmp(&x,&y,sizeof(BW))){ if(bad<5) printf("  MISMATCH S=%u P=%u v=%016llx: valA=%016llx bitsA=%u totA=%u | valB=%016llx bitsB=%u totB=%u\n",Ss[i],Ps[j],(unsigned long long)v,(unsigned long long)x.val,x.bits,x.tot,(unsigned long long)y.val,y.bits,y.tot); bad++; }
  }
  // plus fully random
