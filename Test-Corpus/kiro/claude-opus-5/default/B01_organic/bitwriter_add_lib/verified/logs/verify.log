[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m                 let _ = sc;
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m                 assert_same(p, "C15 u32 wrap skips loop", s, bits, rng.interesting_u64());
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m         }
