  if(!ha||!hb){fprintf(stderr,"dlopen: %s\n",dlerror());return 2;}
  F a=(F)dlsym(ha,"bitwriter_add"), b=(F)dlsym(hb,"bitwriter_add");
  if(!a||!b){fprintf(stderr,"dlsym\n");return 3;}
  long bad=0, n=0;
