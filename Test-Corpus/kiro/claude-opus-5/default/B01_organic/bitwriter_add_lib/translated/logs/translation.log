#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <dlfcn.h>

typedef struct { uint64_t val; uint32_t bits, pos, len, tot; uint8_t *buffer; } bwr;
typedef int (*fn_t)(bwr*, uint32_t, uint64_t);

static uint64_t rng_s = 0x123456789abcdefULL;
static uint64_t rnd(void){ rng_s ^= rng_s<<13; rng_s ^= rng_s>>7; rng_s ^= rng_s<<17; return rng_s; }

int main(int argc, char**argv){
    void *hc = dlopen(argv[1], RTLD_NOW), *hr = dlopen(argv[2], RTLD_NOW);
    if(!hc||!hr){ fprintf(stderr,"dlopen: %s\n", dlerror()); return 2; }
    fn_t fc = (fn_t)dlsym(hc,"bitwriter_add"), fr = (fn_t)dlsym(hr,"bitwriter_add");
    if(!fc||!fr){ fprintf(stderr,"dlsym failed\n"); return 2; }

    long n=0, bad=0;
    /* exhaustive-ish sweep over interesting bits / bw->bits combos */
    uint64_t vals[] = {0, 1, 2, 3, 0xFFULL, 0xFFFFFFFFULL, 0xFFFFFFFFFFFFFFFFULL,
                       0x8000000000000000ULL, 0x5555555555555555ULL, 0xAAAAAAAAAAAAAAAAULL,
                       0x123456789ABCDEF0ULL, 0x7FFFFFFFFFFFFFFFULL};
    uint32_t bitset[] = {0,1,2,3,4,5,7,8,15,16,31,32,33,47,63,64,65,100,127,128,255,
                         1000, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFE, 0xFFFFFFFF};
    uint32_t bwbits[] = {0,1,2,3,7,8,15,16,31,32,33,48,63,64,65,100,1000,
                         0xFFFFFFFF, 0xFFFFFF00, 0x80000000};
    for(size_t a=0;a<sizeof(vals)/sizeof(*vals);a++)
    for(size_t b=0;b<sizeof(bitset)/sizeof(*bitset);b++)
    for(size_t c=0;c<sizeof(bwbits)/sizeof(*bwbits);c++)
    for(int vseed=0; vseed<3; vseed++){
        bwr s1, s2;
        memset(&s1,0,sizeof s1);
        s1.val = vals[(a+vseed)%(sizeof(vals)/sizeof(*vals))];
        s1.bits = bwbits[c];
        s1.pos = 0x11223344u; s1.len = 0x55667788u; s1.tot = (uint32_t)(0xDEADBEEFu ^ (uint32_t)a);
        s1.buffer = (uint8_t*)0x1234;
        s2 = s1;
        int r1 = fc(&s1, bitset[b], vals[a]);
        int r2 = fr(&s2, bitset[b], vals[a]);
        n++;
        if(r1!=r2 || memcmp(&s1,&s2,sizeof s1)!=0){
            if(bad++<10) printf("MISMATCH bits=%u bwbits=%u val=%llx: C{v=%llx b=%u t=%u r=%d} R{v=%llx b=%u t=%u r=%d}\n",
                bitset[b], bwbits[c], (unsigned long long)vals[a],
                (unsigned long long)s1.val,s1.bits,s1.tot,r1,
                (unsigned long long)s2.val,s2.bits,s2.tot,r2);
        }
    }
    /* random fuzz */
    for(long k=0;k<3000000;k++){
        bwr s1,s2; memset(&s1,0,sizeof s1);
        s1.val=rnd(); s1.bits=(uint32_t)rnd()>>(rnd()%32); s1.pos=(uint32_t)rnd();
        s1.len=(uint32_t)rnd(); s1.tot=(uint32_t)rnd(); s1.buffer=(uint8_t*)rnd();
        uint32_t bits=(uint32_t)rnd()>>(rnd()%32); uint64_t v=rnd()>>(rnd()%64);
        s2=s1;
        int r1=fc(&s1,bits,v), r2=fr(&s2,bits,v); n++;
        if(r1!=r2||memcmp(&s1,&s2,sizeof s1)!=0){
            if(bad++<20) printf("FUZZ MISMATCH bits=%u bwbits=%u val=%llx: C{v=%llx b=%u} R{v=%llx b=%u}\n",
                bits,s1.bits,(unsigned long long)v,(unsigned long long)s1.val,s1.bits,
                (unsigned long long)s2.val,s2.bits);
        }
    }
    printf("cases=%ld mismatches=%ld\n", n, bad);
    return bad!=0;
}
EOF
