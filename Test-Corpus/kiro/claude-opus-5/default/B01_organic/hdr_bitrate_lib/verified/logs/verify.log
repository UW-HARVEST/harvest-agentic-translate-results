[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m const PROT_NONE: c_int = 0;
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m const PROT_READ: c_int = 1;
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m const PROT_WRITE: c_int = 2;
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m const MAP_PRIVATE: c_int = 0x02;
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m const MAP_ANONYMOUS: c_int = 0x20;
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m /// E6 + C28 — place the 3-byte header so that `h[2]` is the last readable byte
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m /// before an unmapped page. Any read of `h[3]` (or beyond) by either library
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m /// faults and kills this test process, which is a loud failure. Conversely a
