[0m[49m[38;5;10m+     24[0m:[38;5;10m[49m     let h2 = (k << 4) | (rng.next_u8() & 0x0F);
[0m[49m[38;5;10m+     25[0m:[38;5;10m[49m     [rng.next_u8(), h1, h2]
[0m[49m[38;5;10m+     26[0m:[38;5;10m[49m }
