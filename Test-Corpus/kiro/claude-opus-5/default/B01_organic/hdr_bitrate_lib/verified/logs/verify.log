[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m /// E5 — maximal index combination `i=1, layer=0b11, k=15`: flat offset 90,
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m /// one byte past the end of the entire table.
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m fn e5_max_index_past_end_of_table() {
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x05);
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m     for _ in 0..ITERS {
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m         let buf = header(&mut rng, 1, 3, 15, 3 + rng.below(20) as usize);
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m         assert_eq!(buf[1] & 0x08, 0x08);
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m         assert_eq!((buf[1] >> 1) & 3, 3);
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m         assert_eq!(buf[2] >> 4, 15);
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m         diff("E5", &buf);
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m /// E7 (enum-domain part) — the version / layer / bitrate fields are unvalidated
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m /// bit-fields, so every out-of-range "variant" (reserved layer `0b00`, `free`
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m /// bitrate `0b0000`, `bad` bitrate `0b1111`) is a real input. Also passes the
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m /// full `int` domain of each field explicitly, one step past every documented
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m /// range.
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m fn e7_out_of_range_enum_variants() {
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m     // Every layer field value including the reserved 0b00, and every bitrate
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m     // nibble including `free` (0) and `bad` (15), for both version bits.
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m     for i in 0..2u8 {
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m         for layer in 0..4u8 {
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m             for k in 0..16u8 {
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m                 let mut buf = vec![0u8; 3];
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m                 buf[1] = (i << 3) | (layer << 1);
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m                 buf[2] = k << 4;
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m                 diff("E7", &buf);
