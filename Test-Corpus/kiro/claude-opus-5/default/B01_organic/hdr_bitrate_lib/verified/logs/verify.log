[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m             PROT_READ | PROT_WRITE,
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m             MAP_PRIVATE | MAP_ANONYMOUS,
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m             -1,
