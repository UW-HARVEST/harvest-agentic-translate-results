[0m[49m[38;5;10m+    14[0m:[38;5;10m[49m C_BUILD="$ROOT/../c_src/build"
[0m[49m[38;5;10m+    15[0m:[38;5;10m[49m TIMEOUT=${TIMEOUT:-600}
[0m[49m[38;5;10m+    16[0m:[38;5;10m[49m fails=0
