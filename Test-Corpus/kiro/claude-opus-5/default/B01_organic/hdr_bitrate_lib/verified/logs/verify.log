[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m /// Randomized iterations per `CONFIGS.md` row.
[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m const ITERS_PER_ROW: usize = 64;
[0m[49m[38;5;10m+     16[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     17[0m:[38;5;10m[49m /// Build a header for row `(i, layer, k)`, randomizing every bit the C ignores.
[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m fn header_for(rng: &mut Rng, i: u8, layer: u8, k: u8) -> [u8; 3] {
[0m[49m[38;5;10m+     19[0m:[38;5;10m[49m     // h[1]: bit3 = i, bits2..1 = layer, bit0 free, bits7..4 free.
[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m     let free_hi = rng.next_u8() & 0xF0;
[0m[49m[38;5;10m+     21[0m:[38;5;10m[49m     let free_lo_bit = rng.next_u8() & 0x01;
[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m     let h1 = free_hi | (i << 3) | (layer << 1) | free_lo_bit;
