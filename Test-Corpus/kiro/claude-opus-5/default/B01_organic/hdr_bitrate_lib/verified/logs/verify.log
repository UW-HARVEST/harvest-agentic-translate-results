[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m fn errors_row7b_undersized_buffer_crash_parity() {
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     let pair = Pair::load();
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m     let (c, rust) = (pair.c, pair.rust);
