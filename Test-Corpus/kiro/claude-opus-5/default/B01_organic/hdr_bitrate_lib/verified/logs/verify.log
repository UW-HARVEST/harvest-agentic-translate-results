[0m[49m[38;5;10m+    19[0m:[38;5;10m[49m if [[ ! -d $C_BUILD ]] || ! ls "$C_BUILD"/lib*.so >/dev/null 2>&1; then
[0m[49m[38;5;10m+    20[0m:[38;5;10m[49m   echo "== building C shared library =="
[0m[49m[38;5;10m+    21[0m:[38;5;10m[49m   mkdir -p "$C_BUILD"
[0m[49m[38;5;10m+    22[0m:[38;5;10m[49m   (cd "$C_BUILD" && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON >/dev/null \
[0m[49m[38;5;10m+    23[0m:[38;5;10m[49m      && cmake --build . >/dev/null) || { echo "C build FAILED"; exit 1; }
[0m[49m[38;5;10m+    24[0m:[38;5;10m[49m fi
[0m[49m[38;5;10m+    25[0m:[38;5;10m[49m C_SO=$(ls "$C_BUILD"/lib*.so | head -1)
[0m[49m[38;5;10m+    26[0m:[38;5;10m[49m echo "C  .so: $C_SO"
[0m[49m[38;5;10m+    27[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    28[0m:[38;5;10m[49m # ---- feature combinations -------------------------------------------------
