[0m[49m[38;5;10m+    610[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x06);
[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m     // Header occupies the final 3 bytes of the readable page.
