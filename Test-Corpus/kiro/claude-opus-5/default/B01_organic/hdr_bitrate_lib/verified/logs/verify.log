[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m     let mprotect: MprotectFn =
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m         *unsafe { this.get::<MprotectFn>(b"mprotect\0").expect("libc mprotect") };
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m     let munmap: MunmapFn = *unsafe { this.get::<MunmapFn>(b"munmap\0").expect("libc munmap") };
