[0m[49m[38;5;10m+     24[0m:[38;5;10m[49m     for k in 0u8..15 {
[0m[49m[38;5;10m+     25[0m:[38;5;10m[49m         for _ in 0..32 {
[0m[49m[38;5;10m+     26[0m:[38;5;10m[49m             let buf = [rng.next_u8(), (rng.next_u8() & 0xF0) | 0x00 | (rng.next_u8() & 1), (k << 4) | (rng.next_u8() & 0xF)];
