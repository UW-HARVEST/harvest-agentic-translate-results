[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m /// Build a header with the three fields the C reads set explicitly and every
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m /// bit the C ignores filled with random noise (axis D of `CONFIGS.md`).
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m /// * `i`     — version bit, `h[1] & 0x8`
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m /// * `layer` — raw 2-bit layer field, `(h[1] >> 1) & 3`
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m /// * `k`     — bitrate nibble, `h[2] >> 4`
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m fn header(rng: &mut Rng, i: u8, layer: u8, k: u8, len: usize) -> Vec<u8> {
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m     assert!(i < 2 && layer < 4 && k < 16);
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m     let mut buf = vec![0u8; len];
