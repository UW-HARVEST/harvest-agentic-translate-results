[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m     let page = unsafe { getpagesize() } as usize;
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m     assert!(page >= 8 && page.is_power_of_two(), "odd page size {page}");
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m     let total = page * 2;
