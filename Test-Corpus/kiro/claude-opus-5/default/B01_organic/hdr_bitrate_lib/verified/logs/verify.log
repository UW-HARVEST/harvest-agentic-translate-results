[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m     fn next_u64(&mut self) -> u64 {
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m         self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         let mut z = self.0;
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m         z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m         z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m         z ^ (z >> 31)
