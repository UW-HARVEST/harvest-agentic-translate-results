[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m                 buf2[2] = (k << 4) | 0x0F;
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m                 diff("E7/sat", &buf2);
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m // E6 / C28 — over-read detection using an unmapped guard page.
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m // libc is reached through the already-loaded process image, so no extra
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m // dependency is needed.
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m type MmapFn = unsafe extern "C" fn(*mut c_void, usize, c_int, c_int, c_int, i64) -> *mut c_void;
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m type MprotectFn = unsafe extern "C" fn(*mut c_void, usize, c_int) -> c_int;
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m type MunmapFn = unsafe extern "C" fn(*mut c_void, usize) -> c_int;
