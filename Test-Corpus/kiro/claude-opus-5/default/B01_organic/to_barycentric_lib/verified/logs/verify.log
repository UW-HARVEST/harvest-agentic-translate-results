[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m         for s2 in 0..8usize {
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m             if s1 == s2 {
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m                 continue;
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m             for &(a, b) in PAYLOADS {
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m                 let mut vs = [
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m                     rng.vec_with(|r| r.scaled(4.0)),
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m                     rng.vec_with(|r| r.scaled(4.0)),
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m                     rng.vec_with(|r| r.scaled(4.0)),
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m                     rng.vec_with(|r| r.scaled(4.0)),
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m                 ];
