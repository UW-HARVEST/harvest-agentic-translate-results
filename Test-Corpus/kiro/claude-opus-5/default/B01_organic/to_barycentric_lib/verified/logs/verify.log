[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m     let c = call_c(vs[0], vs[1], vs[2], vs[3]);
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m     assert_eq!(c.to_bits(), call_rust(vs[0], vs[1], vs[2], vs[3]).to_bits());
