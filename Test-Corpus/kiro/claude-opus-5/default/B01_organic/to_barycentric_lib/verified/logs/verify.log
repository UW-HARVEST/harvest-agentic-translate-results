#include <stdio.h>
#include <stdint.h>
#include <dlfcn.h>
#include <stdlib.h>
typedef struct { float x,y; } V;
typedef V (*F)(V,V,V,V);
static uint64_t s=0x5EED1234DEADBEEFULL;
static uint32_t nx(void){ s+=0x9E3779B97F4A7C15ULL; uint64_t z=s;
  z=(z^(z>>30))*0xBF58476D1CE4E5B9ULL; z=(z^(z>>27))*0x94D049BB133111EBULL; return (uint32_t)((z^(z>>31))>>32); }
static float fb(void){ union{uint32_t u; float f;} c; c.u=nx(); return c.f; }
int main(void){
  void *a=dlopen("./libO0.so",RTLD_NOW), *b=dlopen("./libO2.so",RTLD_NOW);
  if(!a||!b){ printf("dlopen fail\n"); return 1; }
  F f0=(F)dlsym(a,"to_barycentric"), f2=(F)dlsym(b,"to_barycentric");
  long diff_all=0, diff_nonnan_input=0, n=5000000;
  for(long i=0;i<n;i++){
    V p1={fb(),fb()},p2={fb(),fb()},p3={fb(),fb()},p={fb(),fb()};
    V r0=f0(p1,p2,p3,p), r2=f2(p1,p2,p3,p);
    union{float f;uint32_t u;} a0,a2,b0,b2; a0.f=r0.x;a2.f=r2.x;b0.f=r0.y;b2.f=r2.y;
    if(a0.u!=a2.u||b0.u!=b2.u){ diff_all++;
      int nan_in=0; float c[8]={p1.x,p1.y,p2.x,p2.y,p3.x,p3.y,p.x,p.y};
      for(int k=0;k<8;k++){ union{float f;uint32_t u;} t; t.f=c[k];
        if((t.u&0x7f800000)==0x7f800000 && (t.u&0x7fffff)) nan_in++; }
      if(nan_in<2) diff_nonnan_input++;
    }
  }
  printf("n=%ld  -O0 vs -O2 differ=%ld  of which fewer-than-2-NaN-inputs=%ld\n", n, diff_all, diff_nonnan_input);
  return 0;
}
EOF
