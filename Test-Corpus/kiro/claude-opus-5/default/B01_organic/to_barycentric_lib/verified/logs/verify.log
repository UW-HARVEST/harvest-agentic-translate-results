[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m                 assert!(
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m                     out.x.to_bits() & 0x0040_0000 != 0 && out.y.to_bits() & 0x0040_0000 != 0,
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m                     "err13: sNaN {:#010x} leaked unquieted: {out:?}",
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m                     n.to_bits()
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m     // Pinned: sNaN 0x7f800001 must become qNaN 0x7fc00001, payload retained.
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m     let vs = [
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m         Vec2::new(SNAN, 1.0),
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m         Vec2::new(2.0, 0.0),
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m         Vec2::new(0.0, 3.0),
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m         Vec2::new(0.5, 0.5),
