[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m         let a = rng.pow2(-4, 4);
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m         let t = rng.pow2(-4, 4);
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m         // v0 = (a, a), v1 = (t, -t)  =>  dot01 = a*t + a*(-t) = +-0.0 exactly
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m         let p3 = Vec2::new(p1.x + a, p1.y + a);
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m         let p2 = Vec2::new(p1.x + t, p1.y - t);
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m         let p = rng.vec_with(|r| r.small_int(8));
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m         [p1, p2, p3, p]
