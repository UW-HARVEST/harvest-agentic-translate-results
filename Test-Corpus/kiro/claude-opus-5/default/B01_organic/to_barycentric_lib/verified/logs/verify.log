[0m[49m[38;5;10m+    606[0m:[38;5;10m[49m             rng.vec_with(pick),
[0m[49m[38;5;10m+    607[0m:[38;5;10m[49m             rng.vec_with(pick),
[0m[49m[38;5;10m+    608[0m:[38;5;10m[49m             rng.vec_with(pick),
[0m[49m[38;5;10m+    609[0m:[38;5;10m[49m             rng.vec_with(pick),
[0m[49m[38;5;10m+    610[0m:[38;5;10m[49m         ]
[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m }
