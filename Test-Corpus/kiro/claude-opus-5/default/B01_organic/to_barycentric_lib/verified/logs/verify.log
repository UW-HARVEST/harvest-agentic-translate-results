[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m                 set_slot(&mut vs, s2, f32::from_bits(b));
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m                 total += 1;
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m                 if let Err(e) = diff("err14", vs[0], vs[1], vs[2], vs[3]) {
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m                     divergences += 1;
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m                     if reports.len() < 3 {
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m                         reports.push(e);
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m                     }
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m         divergences,
[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m         0,
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m         "err14: {divergences}/{total} distinct-NaN-payload cases diverged\n{}",
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m         reports.join("\n---\n")
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m     // Three or more distinct payloads at once.
[0m[49m[38;5;10m+    466[0m:[38;5;10m[49m     for _ in 0..5000 {
[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m         let mut vs = [
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m             rng.vec_with(|r| r.scaled(4.0)),
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m             rng.vec_with(|r| r.scaled(4.0)),
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m             rng.vec_with(|r| r.scaled(4.0)),
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m             rng.vec_with(|r| r.scaled(4.0)),
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m         ];
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m         for slot in 0..8 {
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m             if rng.bool() {
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m                 let payload = (rng.next_u32() & 0x007f_ffff).max(1);
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m                 let sign = if rng.bool() { 0x8000_0000u32 } else { 0 };
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m                 set_slot(&mut vs, slot, f32::from_bits(sign | 0x7f80_0000 | payload));
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m         expect_agree("err14-multi", vs[0], vs[1], vs[2], vs[3]);
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m // Row 15 — negative NaN: the sign bit must propagate identically
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m fn row15_negative_nan() {
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m     let mut rng = Rng::for_row("err15");
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m     let mut saw_negative_result = false;
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m     for slot in 0..8usize {
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m         for &n in &[QNAN_NEG, NAN_C, SNAN_NEG, f32::from_bits(0xffff_ffff)] {
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m             for _ in 0..250 {
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m                 let mut vs = [
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m                     rng.vec_with(|r| r.scaled(4.0)),
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m                     rng.vec_with(|r| r.scaled(4.0)),
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m                     rng.vec_with(|r| r.scaled(4.0)),
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m                     rng.vec_with(|r| r.scaled(4.0)),
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m                 ];
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m                 set_slot(&mut vs, slot, n);
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m                 let out = expect_agree("err15", vs[0], vs[1], vs[2], vs[3]);
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m                 assert_nan("err15", out);
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m                 if out.x.to_bits() & 0x8000_0000 != 0 {
