import re, subprocess, sys, shutil, os
ORIG = open('src/lib.rs').read()
lines = ORIG.split('\n')
# find commutative arithmetic instruction lines inside the global_asm block
targets = []
pat = re.compile(r'^(\s*)"(mulss|addss)\s+(xmm\d+),\s*(xmm\d+)",(.*)$')
for i,l in enumerate(lines):
    m = pat.match(l)
    if m:
        indent, op, d, s, rest = m.groups()
        if d == s:      # squaring: operand order is meaningless
            continue
        targets.append((i, indent, op, d, s, rest))
print(f"{len(targets)} mutable instructions", file=sys.stderr)
results = []
for idx,(i, indent, op, d, s, rest) in enumerate(targets):
    new = list(lines)
    new[i] = (f'{indent}"movaps xmm15, {s}",\n'
              f'{indent}"{op}  xmm15, {d}",\n'
              f'{indent}"movaps {d}, xmm15", // MUTANT swap of {op} {d},{s}')
    open('src/lib.rs','w').write('\n'.join(new))
    b = subprocess.run(['cargo','build','--release'], capture_output=True, text=True)
    if b.returncode != 0:
        results.append((idx, op, d, s, 'BUILD-FAIL')); continue
    t = subprocess.run(['cargo','test','--release','--','--test-threads=4'],
                       capture_output=True, text=True, timeout=600)
    caught = 'FAILED' in t.stdout or t.returncode != 0
    results.append((idx, op, d, s, 'CAUGHT' if caught else 'NOT-CAUGHT'))
    print(f"{idx:2d} {op} {d},{s} -> {results[-1][4]}", file=sys.stderr)
open('src/lib.rs','w').write(ORIG)
subprocess.run(['cargo','build','--release'], capture_output=True)
print("\n=== SUMMARY ===")
for r in results: print(r)
