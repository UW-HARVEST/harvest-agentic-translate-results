[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m     assert!(
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m         saw_negative_result,
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m         "err15: a negative NaN input never produced a negative NaN result, so \
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m          the sign-propagation path was not actually exercised"
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m // Row 16 — subnormal inputs (an FTZ/DAZ mismatch detector)
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m fn row16_subnormal() {
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m     // Exhaustive over a set of subnormal magnitudes in every slot.
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m     let subs: Vec<f32> = (0..24)
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m         .map(|k| f32::from_bits(1u32 << k))
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m         .filter(|f| f.to_bits() < 0x0080_0000)
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m         .collect();
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m     let mut rng = Rng::for_row("err16");
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m     for slot in 0..8usize {
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m         for &s in &subs {
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m             for &sv in &[s, -s] {
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m                 for _ in 0..40 {
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m                     let mut vs = [
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m                         rng.vec_with(|r| r.scaled(1.0)),
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m                         rng.vec_with(|r| r.scaled(1.0)),
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m                         rng.vec_with(|r| r.scaled(1.0)),
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m                         rng.vec_with(|r| r.scaled(1.0)),
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m                     ];
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m                     set_slot(&mut vs, slot, sv);
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m                     expect_agree("err16", vs[0], vs[1], vs[2], vs[3]);
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m     // All-subnormal input: every intermediate is subnormal or zero. If either
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m     // build had FTZ/DAZ enabled, these would disagree.
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m     for _ in 0..4000 {
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m         let pick = |r: &mut Rng| {
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m             let bits = (r.next_u32() % 0x0080_0000).max(1);
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m             let sign = if r.bool() { 0x8000_0000u32 } else { 0 };
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m             f32::from_bits(sign | bits)
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m         let vs = [
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m             rng.vec_with(pick),
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m             rng.vec_with(pick),
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m             rng.vec_with(pick),
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m             rng.vec_with(pick),
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m         ];
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m         expect_agree("err16-all-subnormal", vs[0], vs[1], vs[2], vs[3]);
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m // Row 17 — negative zero inputs
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m fn row17_negative_zero() {
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m     // Exhaustive: every slot independently 0.0 or -0.0 (256 combinations),
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m     // and every slot independently 0.0 / -0.0 / 1.0 / -1.0 (65536 combinations).
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m     let pool = [0.0f32, -0.0, 1.0, -1.0];
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m     let mut cases = Vec::with_capacity(65536);
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m     for m in 0u32..65536 {
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m         let mut vs = [Vec2::new(0.0, 0.0); 4];
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m         for slot in 0..8 {
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m             let idx = ((m >> (2 * slot)) & 0b11) as usize;
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m             set_slot(&mut vs, slot, pool[idx]);
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m         cases.push(vs);
