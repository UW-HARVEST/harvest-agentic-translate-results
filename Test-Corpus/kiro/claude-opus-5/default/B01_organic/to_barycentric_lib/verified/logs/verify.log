[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m // Row 28 — full-mantissa components: every product and sum is inexact
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m fn row28_full_mantissa_rounding() {
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m     run_row("cfg28", N, |rng| {
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m         // exponent kept moderate, mantissa fully random => 24 significant bits
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m         let pick = |r: &mut Rng| {
[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m             let exp = 100u32 + r.below(56); // biased exponent 100..155
[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m             let mant = r.next_u32() & 0x007f_ffff;
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m             let sign = if r.bool() { 0x8000_0000u32 } else { 0 };
[0m[49m[38;5;10m+    603[0m:[38;5;10m[49m             f32::from_bits(sign | (exp << 23) | mant)
[0m[49m[38;5;10m+    604[0m:[38;5;10m[49m         };
