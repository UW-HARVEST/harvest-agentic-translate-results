[0m[49m[38;5;10m+    628[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    629[0m:[38;5;10m[49m     run_row("cfg29-inexact", N, |rng| {
[0m[49m[38;5;10m+    630[0m:[38;5;10m[49m         let p1 = rng.vec_with(|r| r.small_int(4));
