[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m // Row 14 — two DIFFERENT NaN payloads meeting in one commutative operation
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m fn row14_two_distinct_nan_payloads() {
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m     // Exhaustive over ordered slot pairs x an assortment of payload pairs.
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m     const PAYLOADS: &[(u32, u32)] = &[
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m         (0x7fc0_00aa, 0x7fc0_00bb),
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m         (0x7fc0_00bb, 0x7fc0_00aa),
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m         (0x7fc0_0001, 0xffc0_0001),
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m         (0xffc0_00cc, 0x7fd0_00dd),
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m         (0x7f80_0001, 0x7fc0_ffff),
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m         (0x7fff_ffff, 0xff80_0002),
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m     let mut rng = Rng::for_row("err14");
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m     let mut divergences = 0usize;
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m     let mut total = 0usize;
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m     let mut reports = Vec::new();
