[49m[38;5;10m+      1[0m:[38;5;10m[49m //! Heavy structured sweeps for the arithmetic kernels.
[0m[49m[38;5;10m+      2[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+      3[0m:[38;5;10m[49m //! The randomized rows in `configs.rs` sample uniformly over bit patterns, which
[0m[49m[38;5;10m+      4[0m:[38;5;10m[49m //! under-samples the *interactions* that matter: two NaNs with different
[0m[49m[38;5;10m+      5[0m:[38;5;10m[49m //! payloads, `0 * inf`, `inf - inf`, and the exponent boundaries where a product
[0m[49m[38;5;10m+      6[0m:[38;5;10m[49m //! overflows or underflows. This file builds a dense structured grid over
[0m[49m[38;5;10m+      7[0m:[38;5;10m[49m //! (sign x exponent x mantissa) instead, so those interactions occur
[0m[49m[38;5;10m+      8[0m:[38;5;10m[49m //! systematically rather than by chance.
[0m[49m[38;5;10m+      9[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+     10[0m:[38;5;10m[49m //! Run with `cargo test --test heavy -- --ignored` (they take longer than the
[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m //! default suite, so they are `#[ignore]`d).
