[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m mod harness;
[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m use harness::*;
[0m[49m[38;5;10m+     16[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     17[0m:[38;5;10m[49m /// Exponents chosen at every boundary the format has: zero/subnormal (0), the
[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m /// smallest normal (1), around 1.0 (126/127/128), the top of the normal range
[0m[49m[38;5;10m+     19[0m:[38;5;10m[49m /// (253/254), and the inf/NaN encoding (255).
[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m const EXPONENTS: &[u32] = &[0, 1, 2, 63, 126, 127, 128, 190, 252, 253, 254, 255];
[0m[49m[38;5;10m+     21[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m /// Mantissas at their boundaries plus a couple of arbitrary payloads. With
[0m[49m[38;5;10m+     23[0m:[38;5;10m[49m /// exponent 255 these select inf (0), signalling NaNs (1, 0x3FFFFF, 0x7FFFFF)
[0m[49m[38;5;10m+     24[0m:[38;5;10m[49m /// and quiet NaNs (0x400000, 0x401234, 0x5EADBE).
[0m[49m[38;5;10m+     25[0m:[38;5;10m[49m const MANTISSAS: &[u32] = &[0, 1, 0x3F_FFFF, 0x40_0000, 0x40_1234, 0x5E_ADBE, 0x7F_FFFF];
[0m[49m[38;5;10m+     26[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     27[0m:[38;5;10m[49m /// The full structured grid: 2 signs x 12 exponents x 7 mantissas = 168 values,
[0m[49m[38;5;10m+     28[0m:[38;5;10m[49m /// spanning every float class and both NaN kinds with distinct payloads.
[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m fn grid() -> Vec<f32> {
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m     let mut v = Vec::with_capacity(2 * EXPONENTS.len() * MANTISSAS.len());
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m     for sign in [0u32, 1u32] {
