[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m     let h = p.c_header(t);
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m     // (0u32 - 1) << 4 == 0xFFFFFFF0, OR-ed over BASE|0x6000 -> 0xFFFFFFF0 | low bits
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m     assert_eq!(h, (BASE | (0x06 << 12)) | 0xFFFF_FFF0, "got 0x{h:08X}");
