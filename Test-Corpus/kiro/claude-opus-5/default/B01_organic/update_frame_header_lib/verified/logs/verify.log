[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m         let mut t = quiet();
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m         t.channels = ch;
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m         t.channel_mode = 0;
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m         p.check(t);
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m         assert_eq!(
