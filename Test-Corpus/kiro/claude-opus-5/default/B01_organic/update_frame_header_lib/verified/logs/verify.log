[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m         p.check(t);
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m         assert_eq!(p.c_header(t) & 0xFFFF_FFF0, 0xFFFF_FFF0);
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m 
