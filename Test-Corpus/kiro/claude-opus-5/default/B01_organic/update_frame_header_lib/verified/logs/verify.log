[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m fn err_13_channel_mode_out_of_range_enum() {
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m     let p = Pair::load();
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m     let mut rng = Rng::new(0x1013);
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     // TFLAC_CHANNEL_MODE_COUNT (4) and every other byte with no valid variant.
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m     for m in 4u16..=255 {
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m         let m = m as u8;
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m         let mut t = quiet();
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m         t.channel_mode = m;
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m         t.channels = 1;
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m         p.check(t);
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m         // It must behave EXACTLY like the aliased in-range mode, because the C
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m         // reduces with `% 4` before the switch (so `default:` is unreachable).
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m         let mut aliased = t;
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m         aliased.channel_mode = m % 4;
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m             p.c_header(t),
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m             p.c_header(aliased),
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m             "channel_mode {m} must alias to {}",
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m             m % 4
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m         let want = match m % 4 {
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m             0 => 0x00, // (channels 1 - 1) << 4
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m             1 => 0x08,
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m             2 => 0x09,
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m             _ => 0x0A,
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m         assert_eq!(nibbles(p.c_header(t)).2, want, "channel_mode {m}");
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m     // Same, with the other axes randomized.
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m     for _ in 0..5000 {
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m         let mut t = rand_other_axes(&mut rng);
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m         t.channel_mode = rng.range_u32(4, 255) as u8;
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m         p.check(t);
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m         let mut aliased = t;
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m         aliased.channel_mode = t.channel_mode % 4;
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m         assert_eq!(p.c_header(t), p.c_header(aliased));
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m     }
