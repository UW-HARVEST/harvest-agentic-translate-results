[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m fn err_15_channels_out_of_range() {
