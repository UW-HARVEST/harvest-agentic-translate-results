[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m fn err_14_channels_zero_underflow() {
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m     let p = Pair::load();
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m     let mut rng = Rng::new(0x1014);
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m 
