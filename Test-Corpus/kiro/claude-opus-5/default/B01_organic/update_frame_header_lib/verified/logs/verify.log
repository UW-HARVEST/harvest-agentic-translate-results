[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m         a.channel_mode = residue;
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m         let mut b = quiet();
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m         b.channels = 12345;
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m         b.channel_mode = residue;
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m         p.check(a);
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m         p.check(b);
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m             p.c_header(a),
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m             p.c_header(b),
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m             "channels must be ignored for mode {residue}"
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m 
