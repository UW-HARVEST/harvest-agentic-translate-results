[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m fn g6_arbitrary_struct_bit_patterns() {
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     let mut adversarial: Vec<[u8; 16]> = Vec::new();
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     // Patterns that are invalid for bool (>1), for NonZero (0), for a
