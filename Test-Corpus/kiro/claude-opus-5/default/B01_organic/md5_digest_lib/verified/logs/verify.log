mov -0x8(%rbp),%rax
mov (%rax),%eax       ; load m->a AGAIN
shr $0x8,%eax
mov %eax,%edx
mov -0x10(%rbp),%rax
add $0x1,%rax
mov %dl,(%rax)        ; out[1] = (u8)(a>>8)     <-- single byte store
```
and the same pattern continues with `0x4(%rax)` for b, `0x8(%rax)` for c, `0xc(%rax)` for d. So when `out` overlaps the struct, an earlier byte store can change the field value that a later byte store observes, and the C output reflects that.

