[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m             for &blocksize in &[0u32, 1, 2, 4096, u32::MAX] {
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m                 assert_same(blocksize, c, bitdepth);
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m 
