[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m fn cfg_c16_plus7_overflow() {
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m     // Construct exact hits analytically for the non-stereo branch, where the
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m     // inner sum is `blocksize * bitdepth * channels` (mod 2^32).
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m     //
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m     // Target sums: 0xFFFF_FFF9 ..= 0xFFFF_FFFF (7 values that make +7 wrap).
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m     let mut hits = 0usize;
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m     for target in 0xFFFF_FFF9u32..=0xFFFF_FFFF {
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m         // With channels = 1 and bitdepth = 1, the inner sum is exactly blocksize.
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m         assert_same(target, 1, 1);
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m         // Confirm the C really wraps here: (target + 7) mod 2^32 is small, so
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m         // the byte count must be tiny rather than huge.
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m         let got = call_c(target, 1, 1);
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m         let bytes = got.wrapping_sub(18).wrapping_sub(1);
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m             bytes < 1,
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m             "expected +7 to wrap to a tiny byte count, got {bytes}"
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m         hits += 1;
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m     assert_eq!(hits, 7);
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m     // Stereo branch: inner sum = blocksize*bitdepth + blocksize*(bitdepth+1)
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m     //                          = blocksize*(2*bitdepth + 1)   (mod 2^32)
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m     // With bitdepth = 0 (!= 32) this is just blocksize.
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m     for target in 0xFFFF_FFF9u32..=0xFFFF_FFFF {
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m         assert_same(target, 2, 0);
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m     // Randomized search for additional wrap-adjacent inner sums.
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m     let mut rng = Rng::new(0xC016);
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m     for _ in 0..ITERS {
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m         let bitdepth = rng.range(1, 64);
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m         let channels = {
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m             let c = rng.range(1, 64);
[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m             if c == 2 { 1 } else { c }
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m         let prod = bitdepth.wrapping_mul(channels);
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m         if prod == 0 {
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m         }
