[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m         let blocksize = (0x1_0000_0000u64 / prod as u64) as u32;
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m         for delta in 0..4u32 {
