[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m /// C20: unconstrained uniform fuzz over the full u32^3 domain.
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m fn cfg_c20_uniform_fuzz_full_domain() {
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m     let mut rng = Rng::new(0xC020);
