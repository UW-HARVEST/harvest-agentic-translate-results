[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m                 assert_same(blocksize, channels, bitdepth);
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m                 // Also probe one-off-power values, which straddle the
