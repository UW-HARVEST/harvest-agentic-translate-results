[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m     /// Uniform in `lo..=hi`.
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m     fn range(&mut self, lo: u32, hi: u32) -> u32 {
