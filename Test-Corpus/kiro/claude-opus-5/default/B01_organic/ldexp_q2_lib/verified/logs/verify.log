[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m         let e = pick(&mut rng);
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m         out.push((y, e));
[0m[49m[38;5;10m+     32[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     33[0m:[38;5;10m[49m     out
[0m[49m[38;5;10m+     34[0m:[38;5;10m[49m }
