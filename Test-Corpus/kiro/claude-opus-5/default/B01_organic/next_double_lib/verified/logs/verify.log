[0m[49m[38;5;10m+    690[0m:[38;5;10m[49m             let out = Command::new(exe)
[0m[49m[38;5;10m+    691[0m:[38;5;10m[49m                 .args(["--exact", NULL_TEST, "--test-threads=1", "--nocapture"])
[0m[49m[38;5;10m+    692[0m:[38;5;10m[49m                 .env(CHILD_VAR, which)
