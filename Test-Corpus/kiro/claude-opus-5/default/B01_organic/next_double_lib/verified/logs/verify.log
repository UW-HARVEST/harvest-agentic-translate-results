     1	//! Rust translation of the C library in `c_src/`.
     2	//!
     3	//! Public ABI (from `nm -D` on the C shared object):
     4	//!   * `next_double`
     5	//!
     6	//! Header (`include/lib.h`):
     7	//! ```c
     8	//! typedef struct cn_rnd_t { uint64_t state[2]; } cn_rnd_t;
     9	//! double next_double(cn_rnd_t *rnd);
    10	//! ```
    11	
    12	use std::ffi::c_double;
    13	
    14	/// Mirrors `cn_rnd_t` from `include/lib.h`: two `uint64_t` words.
    15	/// `#[repr(C)]` keeps layout/alignment identical to the C struct.
    16	#[repr(C)]
    17	pub struct cn_rnd_t {
    18	    pub state: [u64; 2],
    19	}
    20	
    21	/// Translation of the file-local `static uint64_t cn_rnd_next(cn_rnd_t *rnd)`.
    22	///
    23	/// xorshift128+ style step. All arithmetic in C is on `uint64_t`, i.e. modulo
    24	/// 2^64, so the final addition uses `wrapping_add` to reproduce it exactly
    25	/// (and to avoid a debug-build overflow panic).
    26	#[inline]
    27	fn cn_rnd_next(rnd: &mut cn_rnd_t) -> u64 {
    28	    let mut x: u64 = rnd.state[0];
    29	    let y: u64 = rnd.state[1];
    30	    rnd.state[0] = y;
    31	    x ^= x << 23;
    32	    x ^= x >> 17;
    33	    x ^= y ^ (y >> 26);
    34	    rnd.state[1] = x;
    35	    x.wrapping_add(y)
    36	}
    37	
    38	/// `double next_double(cn_rnd_t *rnd)`
    39	///
    40	/// Builds an IEEE-754 double in [1.0, 2.0) from the top 52 bits of the
    41	/// generated value and subtracts 1.0. The C code type-puns through
    42	/// `*(double *)&result`; `f64::from_bits` is the exact equivalent bit
    43	/// reinterpretation.
    44	#[unsafe(no_mangle)]
    45	pub unsafe extern "C" fn next_double(rnd: *mut cn_rnd_t) -> c_double {
    46	    // The C function dereferences `rnd` unconditionally (no NULL check);
    47	    // reproduce that behaviour rather than "fixing" it.
    48	    let rnd: &mut cn_rnd_t = unsafe { &mut *rnd };
    49	
    50	    let value: u64 = cn_rnd_next(rnd);
    51	    let exponent: u64 = 1023;
    52	    let mantissa: u64 = value >> 12;
    53	    let result: u64 = (exponent << 52) | mantissa;
    54	    f64::from_bits(result) - 1.0
    55	}
