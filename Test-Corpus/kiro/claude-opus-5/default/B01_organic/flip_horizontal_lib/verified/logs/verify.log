[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m fn phase_c_generic_boundaries() {
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m     let impls = load_impls();
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m 
