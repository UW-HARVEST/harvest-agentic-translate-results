[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m         let im = impls();
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m         for (name, f) in [("C", im.c), ("Rust", im.rust)] {
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m             let mut work = seed.clone_layout();
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m             let pix = work.pix_ptr();
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m             let mut img = cp_image_t { w, h, pix };
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m             unsafe { f(&mut img) };
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m             assert_eq!(
