[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m CRATE_DIR="$PWD"
[0m[49m[38;5;10m+     19[0m:[38;5;10m[49m ROOT="$(cd .. && pwd)"
[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m C_DIR="$ROOT/c_src"
