[0m[49m[38;5;10m+     53[0m:[38;5;10m[49m     split($0, a, "="); gsub(/[[:space:]]/, "", a[1]);
[0m[49m[38;5;10m+     54[0m:[38;5;10m[49m     if (a[1] != "default") print a[1]
[0m[49m[38;5;10m+     55[0m:[38;5;10m[49m   }' Cargo.toml)
