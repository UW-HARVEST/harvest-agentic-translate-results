[0m[49m[38;5;10m+     226[0m:[38;5;10m[49m         let span = (hi as i64 - lo as i64 + 1) as u64;
[0m[49m[38;5;10m+     227[0m:[38;5;10m[49m         (lo as i64 + (self.next_u64() % span) as i64) as i32
[0m[49m[38;5;10m+     228[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     229[0m:[38;5;10m[49m     /// A value biased toward interesting magnitudes / boundaries.
[0m[49m[38;5;10m+     230[0m:[38;5;10m[49m     fn spicy_i32(&mut self) -> i32 {
[0m[49m[38;5;10m+     231[0m:[38;5;10m[49m         match self.next_u64() % 8 {
[0m[49m[38;5;10m+     232[0m:[38;5;10m[49m             0 => 0,
[0m[49m[38;5;10m+     233[0m:[38;5;10m[49m             1 => self.range(-16, 16),
[0m[49m[38;5;10m+     234[0m:[38;5;10m[49m             2 => self.range(-1024, 1024),
[0m[49m[38;5;10m+     235[0m:[38;5;10m[49m             3 => i32::MAX,
[0m[49m[38;5;10m+     236[0m:[38;5;10m[49m             4 => i32::MIN,
[0m[49m[38;5;10m+     237[0m:[38;5;10m[49m             5 => i32::MAX - self.range(0, 64),
[0m[49m[38;5;10m+     238[0m:[38;5;10m[49m             6 => i32::MIN + self.range(0, 64),
[0m[49m[38;5;10m+     239[0m:[38;5;10m[49m             _ => self.i32_full(),
[0m[49m[38;5;10m+     240[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     241[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     242[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     243[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     244[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     245[0m:[38;5;10m[49m // Axis helpers (derived from CONFIGS.md)
[0m[49m[38;5;10m+     246[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     247[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     248[0m:[38;5;10m[49m /// The four `lsbit` modes the C dispatches on.
[0m[49m[38;5;10m+     249[0m:[38;5;10m[49m #[derive(Clone, Copy, Debug)]
[0m[49m[38;5;10m+     250[0m:[38;5;10m[49m enum LsMode {
[0m[49m[38;5;10m+     251[0m:[38;5;10m[49m     Zero,
[0m[49m[38;5;10m+     252[0m:[38;5;10m[49m     Four,
[0m[49m[38;5;10m+     253[0m:[38;5;10m[49m     Odd,
[0m[49m[38;5;10m+     254[0m:[38;5;10m[49m     Even,
[0m[49m[38;5;10m+     255[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     256[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     257[0m:[38;5;10m[49m impl LsMode {
[0m[49m[38;5;10m+     258[0m:[38;5;10m[49m     fn all() -> [LsMode; 4] {
[0m[49m[38;5;10m+     259[0m:[38;5;10m[49m         [LsMode::Zero, LsMode::Four, LsMode::Odd, LsMode::Even]
[0m[49m[38;5;10m+     260[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     261[0m:[38;5;10m[49m     /// A random `lsbit` value that lands in this mode.
[0m[49m[38;5;10m+     262[0m:[38;5;10m[49m     fn sample(self, rng: &mut Rng) -> i32 {
[0m[49m[38;5;10m+     263[0m:[38;5;10m[49m         match self {
[0m[49m[38;5;10m+     264[0m:[38;5;10m[49m             LsMode::Zero => 0,
[0m[49m[38;5;10m+     265[0m:[38;5;10m[49m             LsMode::Four => 4,
[0m[49m[38;5;10m+     266[0m:[38;5;10m[49m             LsMode::Odd => loop {
[0m[49m[38;5;10m+     267[0m:[38;5;10m[49m                 let v = rng.i32_full() | 1; // odd => never 0, never 4
[0m[49m[38;5;10m+     268[0m:[38;5;10m[49m                 if v != 0 && v != 4 {
[0m[49m[38;5;10m+     269[0m:[38;5;10m[49m                     return v;
[0m[49m[38;5;10m+     270[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+     271[0m:[38;5;10m[49m             },
[0m[49m[38;5;10m+     272[0m:[38;5;10m[49m             LsMode::Even => loop {
[0m[49m[38;5;10m+     273[0m:[38;5;10m[49m                 let v = rng.i32_full() & !1; // even
[0m[49m[38;5;10m+     274[0m:[38;5;10m[49m                 if v != 0 && v != 4 {
[0m[49m[38;5;10m+     275[0m:[38;5;10m[49m                     return v;
[0m[49m[38;5;10m+     276[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+     277[0m:[38;5;10m[49m             },
[0m[49m[38;5;10m+     278[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     279[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     280[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     281[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     282[0m:[38;5;10m[49m /// The three candidate-clamp shapes, expressed as the required `uni & 7`.
[0m[49m[38;5;10m+     283[0m:[38;5;10m[49m #[derive(Clone, Copy, Debug)]
[0m[49m[38;5;10m+     284[0m:[38;5;10m[49m enum Clamp {
[0m[49m[38;5;10m+     285[0m:[38;5;10m[49m     Low,  // uni & 7 == 0  -> uni2 clamped
[0m[49m[38;5;10m+     286[0m:[38;5;10m[49m     High, // uni & 7 == 7  -> uni1 clamped
[0m[49m[38;5;10m+     287[0m:[38;5;10m[49m     Mid,  // uni & 7 in 1..=6 -> neither
[0m[49m[38;5;10m+     288[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     289[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     290[0m:[38;5;10m[49m impl Clamp {
[0m[49m[38;5;10m+     291[0m:[38;5;10m[49m     fn all() -> [Clamp; 3] {
[0m[49m[38;5;10m+     292[0m:[38;5;10m[49m         [Clamp::Low, Clamp::High, Clamp::Mid]
[0m[49m[38;5;10m+     293[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     294[0m:[38;5;10m[49m     fn low3(self, rng: &mut Rng) -> i32 {
[0m[49m[38;5;10m+     295[0m:[38;5;10m[49m         match self {
[0m[49m[38;5;10m+     296[0m:[38;5;10m[49m             Clamp::Low => 0,
[0m[49m[38;5;10m+     297[0m:[38;5;10m[49m             Clamp::High => 7,
[0m[49m[38;5;10m+     298[0m:[38;5;10m[49m             Clamp::Mid => rng.range(1, 6),
[0m[49m[38;5;10m+     299[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     300[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     301[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     302[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     303[0m:[38;5;10m[49m /// Builds a `uni` with the requested `uni & 7` class and `uni & 8` bit, and
[0m[49m[38;5;10m+     304[0m:[38;5;10m[49m /// random bits above bit 3 (so both signs of `uni` occur).
[0m[49m[38;5;10m+     305[0m:[38;5;10m[49m fn make_uni(rng: &mut Rng, clamp: Clamp, bit3: bool) -> i32 {
[0m[49m[38;5;10m+     306[0m:[38;5;10m[49m     let high = rng.i32_full() & !0xF;
[0m[49m[38;5;10m+     307[0m:[38;5;10m[49m     let mut u = high | clamp.low3(rng);
[0m[49m[38;5;10m+     308[0m:[38;5;10m[49m     if bit3 {
[0m[49m[38;5;10m+     309[0m:[38;5;10m[49m         u |= 8;
[0m[49m[38;5;10m+     310[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     311[0m:[38;5;10m[49m     u
[0m[49m[38;5;10m+     312[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     313[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     314[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     315[0m:[38;5;10m[49m // PHASE B — valid-path differential tests, one per CONFIGS.md row
[0m[49m[38;5;10m+     316[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     317[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     318[0m:[38;5;10m[49m const N: usize = 2000;
