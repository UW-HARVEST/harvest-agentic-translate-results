[0m[49m[38;5;10m+     145[0m:[38;5;10m[49m         let rust_path = rust_so_path();
[0m[49m[38;5;10m+     146[0m:[38;5;10m[49m         unsafe {
[0m[49m[38;5;10m+     147[0m:[38;5;10m[49m             let c_lib = Library::new(&c_path)
[0m[49m[38;5;10m+     148[0m:[38;5;10m[49m                 .unwrap_or_else(|e| panic!("dlopen({}) failed: {e}", c_path.display()));
[0m[49m[38;5;10m+     149[0m:[38;5;10m[49m             let rust_lib = Library::new(&rust_path)
[0m[49m[38;5;10m+     150[0m:[38;5;10m[49m                 .unwrap_or_else(|e| panic!("dlopen({}) failed: {e}", rust_path.display()));
[0m[49m[38;5;10m+     151[0m:[38;5;10m[49m             let c_sym: Symbol<EncodeQuant> = c_lib
[0m[49m[38;5;10m+     152[0m:[38;5;10m[49m                 .get(b"encode_quant\0")
[0m[49m[38;5;10m+     153[0m:[38;5;10m[49m                 .expect("C .so does not export `encode_quant`");
[0m[49m[38;5;10m+     154[0m:[38;5;10m[49m             let rust_sym: Symbol<EncodeQuant> = rust_lib
[0m[49m[38;5;10m+     155[0m:[38;5;10m[49m                 .get(b"encode_quant\0")
[0m[49m[38;5;10m+     156[0m:[38;5;10m[49m                 .expect("Rust .so does not export `encode_quant`");
[0m[49m[38;5;10m+     157[0m:[38;5;10m[49m             let c = *c_sym;
[0m[49m[38;5;10m+     158[0m:[38;5;10m[49m             let rust = *rust_sym;
[0m[49m[38;5;10m+     159[0m:[38;5;10m[49m             Both {
[0m[49m[38;5;10m+     160[0m:[38;5;10m[49m                 _c_lib: c_lib,
[0m[49m[38;5;10m+     161[0m:[38;5;10m[49m                 _rust_lib: rust_lib,
[0m[49m[38;5;10m+     162[0m:[38;5;10m[49m                 c,
[0m[49m[38;5;10m+     163[0m:[38;5;10m[49m                 rust,
[0m[49m[38;5;10m+     164[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+     165[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     166[0m:[38;5;10m[49m     })
[0m[49m[38;5;10m+     167[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     168[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     169[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     170[0m:[38;5;10m[49m // The differential assertion
[0m[49m[38;5;10m+     171[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     172[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     173[0m:[38;5;10m[49m #[derive(Clone, Copy, Debug, PartialEq, Eq)]
[0m[49m[38;5;10m+     174[0m:[38;5;10m[49m struct Args {
