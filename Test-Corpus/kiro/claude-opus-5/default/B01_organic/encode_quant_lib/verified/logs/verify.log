[0m[49m[38;5;10m+     898[0m:[38;5;10m[49m fn err_e3_lsbit_out_of_range_exhaustive_modes() {
[0m[49m[38;5;10m+     899[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE3);
