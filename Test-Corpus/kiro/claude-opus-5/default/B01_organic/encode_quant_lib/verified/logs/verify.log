[0m[49m[38;5;10m+     222[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     223[0m:[38;5;10m[49m     /// Uniform in `lo..=hi` (inclusive), works across the full i32 range.
[0m[49m[38;5;10m+     224[0m:[38;5;10m[49m     fn range(&mut self, lo: i32, hi: i32) -> i32 {
