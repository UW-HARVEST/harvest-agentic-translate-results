[0m[49m[38;5;10m+     539[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+     540[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     541[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     542[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     543[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     544[0m:[38;5;10m[49m // --- winner-selection rows (33..37) ------------------------------------------
[0m[49m[38;5;10m+     545[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+     546[0m:[38;5;10m[49m // These need inputs that actually land in each branch of
[0m[49m[38;5;10m+     547[0m:[38;5;10m[49m //     if (d1 < d0) uni = uni1;
[0m[49m[38;5;10m+     548[0m:[38;5;10m[49m //     if (d2 < d0) uni = uni2;
[0m[49m[38;5;10m+     549[0m:[38;5;10m[49m // so the harness classifies randomized samples by recomputing d0/d1/d2 and
[0m[49m[38;5;10m+     550[0m:[38;5;10m[49m // bucketing them. The classifier is used ONLY for bucketing; the pass/fail
[0m[49m[38;5;10m+     551[0m:[38;5;10m[49m // assertion is always the C-vs-Rust FFI comparison in `diff`.
[0m[49m[38;5;10m+     552[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     553[0m:[38;5;10m[49m #[derive(Clone, Copy, PartialEq, Eq, Debug, Hash)]
[0m[49m[38;5;10m+     554[0m:[38;5;10m[49m enum Winner {
[0m[49m[38;5;10m+     555[0m:[38;5;10m[49m     D0,
[0m[49m[38;5;10m+     556[0m:[38;5;10m[49m     D1Only,
[0m[49m[38;5;10m+     557[0m:[38;5;10m[49m     D2Only,
[0m[49m[38;5;10m+     558[0m:[38;5;10m[49m     Both,
[0m[49m[38;5;10m+     559[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     560[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     561[0m:[38;5;10m[49m /// Recomputes the three distances the way `lib.c` does, purely to categorise a
[0m[49m[38;5;10m+     562[0m:[38;5;10m[49m /// sample into a `Winner` bucket.
[0m[49m[38;5;10m+     563[0m:[38;5;10m[49m fn classify(a: Args) -> Winner {
[0m[49m[38;5;10m+     564[0m:[38;5;10m[49m     let mut uni = a.uni;
[0m[49m[38;5;10m+     565[0m:[38;5;10m[49m     let mut uni1 = uni.wrapping_add(1);
[0m[49m[38;5;10m+     566[0m:[38;5;10m[49m     let mut uni2 = uni.wrapping_sub(1);
[0m[49m[38;5;10m+     567[0m:[38;5;10m[49m     if ((uni ^ uni1) & !7i32) != 0 {
[0m[49m[38;5;10m+     568[0m:[38;5;10m[49m         uni1 = uni;
[0m[49m[38;5;10m+     569[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     570[0m:[38;5;10m[49m     if ((uni ^ uni2) & !7i32) != 0 {
[0m[49m[38;5;10m+     571[0m:[38;5;10m[49m         uni2 = uni;
[0m[49m[38;5;10m+     572[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     573[0m:[38;5;10m[49m     if a.lsbit != 0 {
[0m[49m[38;5;10m+     574[0m:[38;5;10m[49m         if a.lsbit == 4 {
[0m[49m[38;5;10m+     575[0m:[38;5;10m[49m             uni &= !1;
[0m[49m[38;5;10m+     576[0m:[38;5;10m[49m             uni1 &= !1;
[0m[49m[38;5;10m+     577[0m:[38;5;10m[49m             uni2 &= !1;
[0m[49m[38;5;10m+     578[0m:[38;5;10m[49m             uni |= (uni >> 1) & (uni >> 2) & 1;
[0m[49m[38;5;10m+     579[0m:[38;5;10m[49m             uni1 |= (uni1 >> 1) & (uni1 >> 2) & 1;
[0m[49m[38;5;10m+     580[0m:[38;5;10m[49m             uni2 |= (uni2 >> 1) & (uni2 >> 2) & 1;
[0m[49m[38;5;10m+     581[0m:[38;5;10m[49m         } else if (a.lsbit & 1) != 0 {
[0m[49m[38;5;10m+     582[0m:[38;5;10m[49m             uni |= 1;
[0m[49m[38;5;10m+     583[0m:[38;5;10m[49m             uni1 |= 1;
[0m[49m[38;5;10m+     584[0m:[38;5;10m[49m             uni2 |= 1;
[0m[49m[38;5;10m+     585[0m:[38;5;10m[49m         } else {
[0m[49m[38;5;10m+     586[0m:[38;5;10m[49m             uni &= !1;
[0m[49m[38;5;10m+     587[0m:[38;5;10m[49m             uni1 &= !1;
[0m[49m[38;5;10m+     588[0m:[38;5;10m[49m             uni2 &= !1;
[0m[49m[38;5;10m+     589[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     590[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     591[0m:[38;5;10m[49m     let dist = |u: i32| -> i32 {
[0m[49m[38;5;10m+     592[0m:[38;5;10m[49m         let mut d = 2i32
[0m[49m[38;5;10m+     593[0m:[38;5;10m[49m             .wrapping_mul(u & 7)
[0m[49m[38;5;10m+     594[0m:[38;5;10m[49m             .wrapping_add(1)
[0m[49m[38;5;10m+     595[0m:[38;5;10m[49m             .wrapping_mul(a.step)
[0m[49m[38;5;10m+     596[0m:[38;5;10m[49m             / 8;
[0m[49m[38;5;10m+     597[0m:[38;5;10m[49m         if (u & 8) != 0 {
[0m[49m[38;5;10m+     598[0m:[38;5;10m[49m             d = d.wrapping_neg();
[0m[49m[38;5;10m+     599[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     600[0m:[38;5;10m[49m         let p = a.pred.wrapping_add(d);
[0m[49m[38;5;10m+     601[0m:[38;5;10m[49m         let mut dd = a.tgt.wrapping_sub(p);
[0m[49m[38;5;10m+     602[0m:[38;5;10m[49m         dd ^= dd >> 31;
[0m[49m[38;5;10m+     603[0m:[38;5;10m[49m         let mut d3 = a.tgt2.wrapping_sub(p);
[0m[49m[38;5;10m+     604[0m:[38;5;10m[49m         d3 ^= d3 >> 31;
[0m[49m[38;5;10m+     605[0m:[38;5;10m[49m         dd.wrapping_add(d3 >> 5)
[0m[49m[38;5;10m+     606[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+     607[0m:[38;5;10m[49m     let (d0, d1, d2) = (dist(uni), dist(uni1), dist(uni2));
[0m[49m[38;5;10m+     608[0m:[38;5;10m[49m     match (d1 < d0, d2 < d0) {
[0m[49m[38;5;10m+     609[0m:[38;5;10m[49m         (false, false) => Winner::D0,
[0m[49m[38;5;10m+     610[0m:[38;5;10m[49m         (true, false) => Winner::D1Only,
[0m[49m[38;5;10m+     611[0m:[38;5;10m[49m         (false, true) => Winner::D2Only,
[0m[49m[38;5;10m+     612[0m:[38;5;10m[49m         (true, true) => Winner::Both,
[0m[49m[38;5;10m+     613[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     614[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     615[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     616[0m:[38;5;10m[49m /// Rows 33-36: each of the four winner-selection outcomes, including the
[0m[49m[38;5;10m+     617[0m:[38;5;10m[49m /// `Both` case where the C returns `uni2` even when `d1 < d2`.
[0m[49m[38;5;10m+     618[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     619[0m:[38;5;10m[49m fn cfg_rows_33_to_36_winner_selection() {
[0m[49m[38;5;10m+     620[0m:[38;5;10m[49m     let mut rng = Rng::new(3336);
[0m[49m[38;5;10m+     621[0m:[38;5;10m[49m     let mut counts = [0usize; 4];
[0m[49m[38;5;10m+     622[0m:[38;5;10m[49m     let target = 1500usize;
[0m[49m[38;5;10m+     623[0m:[38;5;10m[49m     let mut attempts = 0usize;
[0m[49m[38;5;10m+     624[0m:[38;5;10m[49m     while counts.iter().any(|&c| c < target) && attempts < 4_000_000 {
[0m[49m[38;5;10m+     625[0m:[38;5;10m[49m         attempts += 1;
[0m[49m[38;5;10m+     626[0m:[38;5;10m[49m         // Moderate magnitudes keep all four buckets reachable.
[0m[49m[38;5;10m+     627[0m:[38;5;10m[49m         let a = Args {
[0m[49m[38;5;10m+     628[0m:[38;5;10m[49m             uni: rng.range(-32, 47),
[0m[49m[38;5;10m+     629[0m:[38;5;10m[49m             step: rng.range(-512, 512),
[0m[49m[38;5;10m+     630[0m:[38;5;10m[49m             pred: rng.range(-2048, 2048),
[0m[49m[38;5;10m+     631[0m:[38;5;10m[49m             tgt: rng.range(-2048, 2048),
[0m[49m[38;5;10m+     632[0m:[38;5;10m[49m             tgt2: rng.range(-2048, 2048),
[0m[49m[38;5;10m+     633[0m:[38;5;10m[49m             lsbit: LsMode::all()[(rng.next_u64() % 4) as usize].sample(&mut rng),
[0m[49m[38;5;10m+     634[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+     635[0m:[38;5;10m[49m         let w = classify(a);
[0m[49m[38;5;10m+     636[0m:[38;5;10m[49m         let idx = match w {
[0m[49m[38;5;10m+     637[0m:[38;5;10m[49m             Winner::D0 => 0,
[0m[49m[38;5;10m+     638[0m:[38;5;10m[49m             Winner::D1Only => 1,
[0m[49m[38;5;10m+     639[0m:[38;5;10m[49m             Winner::D2Only => 2,
[0m[49m[38;5;10m+     640[0m:[38;5;10m[49m             Winner::Both => 3,
[0m[49m[38;5;10m+     641[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+     642[0m:[38;5;10m[49m         if counts[idx] >= target {
[0m[49m[38;5;10m+     643[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+     644[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     645[0m:[38;5;10m[49m         counts[idx] += 1;
[0m[49m[38;5;10m+     646[0m:[38;5;10m[49m         diff(&format!("cfg33-36 winner={w:?}"), a);
[0m[49m[38;5;10m+     647[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     648[0m:[38;5;10m[49m     for (i, name) in ["D0", "D1Only", "D2Only", "Both"].iter().enumerate() {
[0m[49m[38;5;10m+     649[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+     650[0m:[38;5;10m[49m             counts[i] > 0,
[0m[49m[38;5;10m+     651[0m:[38;5;10m[49m             "winner bucket {name} was never reached (counts={counts:?}, attempts={attempts})"
[0m[49m[38;5;10m+     652[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+     653[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     654[0m:[38;5;10m[49m     // The interesting quirk row (36) must have real coverage, not one hit.
[0m[49m[38;5;10m+     655[0m:[38;5;10m[49m     assert!(
[0m[49m[38;5;10m+     656[0m:[38;5;10m[49m         counts[3] >= 100,
[0m[49m[38;5;10m+     657[0m:[38;5;10m[49m         "the `both beat d0` bucket needs real coverage, got {}",
[0m[49m[38;5;10m+     658[0m:[38;5;10m[49m         counts[3]
[0m[49m[38;5;10m+     659[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+     660[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     661[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     662[0m:[38;5;10m[49m /// Row 37: exact ties (`d1 == d0` / `d2 == d0`), where the strict `<` keeps
[0m[49m[38;5;10m+     663[0m:[38;5;10m[49m /// the original `uni`. `step == 0` and clamped candidates guarantee ties.
[0m[49m[38;5;10m+     664[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     665[0m:[38;5;10m[49m fn cfg_row_37_ties() {
[0m[49m[38;5;10m+     666[0m:[38;5;10m[49m     let mut rng = Rng::new(37);
[0m[49m[38;5;10m+     667[0m:[38;5;10m[49m     // step == 0 => all three distances identical => both comparisons false.
[0m[49m[38;5;10m+     668[0m:[38;5;10m[49m     for mode in LsMode::all() {
[0m[49m[38;5;10m+     669[0m:[38;5;10m[49m         for _ in 0..N {
[0m[49m[38;5;10m+     670[0m:[38;5;10m[49m             let a = Args {
[0m[49m[38;5;10m+     671[0m:[38;5;10m[49m                 uni: rng.range(-64, 64),
[0m[49m[38;5;10m+     672[0m:[38;5;10m[49m                 step: 0,
[0m[49m[38;5;10m+     673[0m:[38;5;10m[49m                 pred: rng.spicy_i32(),
[0m[49m[38;5;10m+     674[0m:[38;5;10m[49m                 tgt: rng.spicy_i32(),
[0m[49m[38;5;10m+     675[0m:[38;5;10m[49m                 tgt2: rng.spicy_i32(),
[0m[49m[38;5;10m+     676[0m:[38;5;10m[49m                 lsbit: mode.sample(&mut rng),
[0m[49m[38;5;10m+     677[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+     678[0m:[38;5;10m[49m             assert_eq!(classify(a), Winner::D0, "step=0 must tie");
[0m[49m[38;5;10m+     679[0m:[38;5;10m[49m             diff("cfg37 tie via step=0", a);
[0m[49m[38;5;10m+     680[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     681[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     682[0m:[38;5;10m[49m     // Clamped candidate => that candidate's distance equals d0 exactly.
[0m[49m[38;5;10m+     683[0m:[38;5;10m[49m     let mut rng = Rng::new(3737);
[0m[49m[38;5;10m+     684[0m:[38;5;10m[49m     for (clamp, _which) in [(Clamp::Low, "uni2"), (Clamp::High, "uni1")] {
[0m[49m[38;5;10m+     685[0m:[38;5;10m[49m         for _ in 0..N {
[0m[49m[38;5;10m+     686[0m:[38;5;10m[49m             let a = Args {
[0m[49m[38;5;10m+     687[0m:[38;5;10m[49m                 uni: make_uni(&mut rng, clamp, rng.next_u64() & 1 == 0),
[0m[49m[38;5;10m+     688[0m:[38;5;10m[49m                 step: rng.range(1, 4096),
[0m[49m[38;5;10m+     689[0m:[38;5;10m[49m                 pred: rng.range(-4096, 4096),
[0m[49m[38;5;10m+     690[0m:[38;5;10m[49m                 tgt: rng.range(-4096, 4096),
[0m[49m[38;5;10m+     691[0m:[38;5;10m[49m                 tgt2: rng.range(-4096, 4096),
[0m[49m[38;5;10m+     692[0m:[38;5;10m[49m                 lsbit: 0,
[0m[49m[38;5;10m+     693[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+     694[0m:[38;5;10m[49m             diff("cfg37 tie via clamp", a);
[0m[49m[38;5;10m+     695[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     696[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     697[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     698[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     699[0m:[38;5;10m[49m /// Row 38: `tgt2 == tgt`.
[0m[49m[38;5;10m+     700[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     701[0m:[38;5;10m[49m fn cfg_row_38_tgt2_equals_tgt() {
[0m[49m[38;5;10m+     702[0m:[38;5;10m[49m     let mut rng = Rng::new(38);
[0m[49m[38;5;10m+     703[0m:[38;5;10m[49m     for mode in LsMode::all() {
[0m[49m[38;5;10m+     704[0m:[38;5;10m[49m         for _ in 0..N {
[0m[49m[38;5;10m+     705[0m:[38;5;10m[49m             let t = rng.spicy_i32();
[0m[49m[38;5;10m+     706[0m:[38;5;10m[49m             let a = Args {
[0m[49m[38;5;10m+     707[0m:[38;5;10m[49m                 uni: rng.spicy_i32(),
[0m[49m[38;5;10m+     708[0m:[38;5;10m[49m                 step: rng.spicy_i32(),
