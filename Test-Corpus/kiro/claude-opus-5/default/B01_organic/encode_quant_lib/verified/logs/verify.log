[0m[49m[38;5;10m+     518[0m:[38;5;10m[49m         7,
[0m[49m[38;5;10m+     519[0m:[38;5;10m[49m         8,
[0m[49m[38;5;10m+     520[0m:[38;5;10m[49m         15,
[0m[49m[38;5;10m+     521[0m:[38;5;10m[49m         16,
[0m[49m[38;5;10m+     522[0m:[38;5;10m[49m         i32::MAX - 8,
[0m[49m[38;5;10m+     523[0m:[38;5;10m[49m         i32::MAX - 7,
[0m[49m[38;5;10m+     524[0m:[38;5;10m[49m         i32::MAX - 1,
[0m[49m[38;5;10m+     525[0m:[38;5;10m[49m         i32::MAX,
[0m[49m[38;5;10m+     526[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+     527[0m:[38;5;10m[49m     for &uni in &unis {
[0m[49m[38;5;10m+     528[0m:[38;5;10m[49m         for mode in LsMode::all() {
[0m[49m[38;5;10m+     529[0m:[38;5;10m[49m             for _ in 0..500 {
[0m[49m[38;5;10m+     530[0m:[38;5;10m[49m                 let a = Args {
[0m[49m[38;5;10m+     531[0m:[38;5;10m[49m                     uni,
[0m[49m[38;5;10m+     532[0m:[38;5;10m[49m                     step: rng.spicy_i32(),
[0m[49m[38;5;10m+     533[0m:[38;5;10m[49m                     pred: rng.spicy_i32(),
[0m[49m[38;5;10m+     534[0m:[38;5;10m[49m                     tgt: rng.spicy_i32(),
[0m[49m[38;5;10m+     535[0m:[38;5;10m[49m                     tgt2: rng.spicy_i32(),
[0m[49m[38;5;10m+     536[0m:[38;5;10m[49m                     lsbit: mode.sample(&mut rng),
[0m[49m[38;5;10m+     537[0m:[38;5;10m[49m                 };
