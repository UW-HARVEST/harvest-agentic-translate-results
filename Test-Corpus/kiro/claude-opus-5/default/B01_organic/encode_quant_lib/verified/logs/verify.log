[0m[49m[38;5;10m+     177[0m:[38;5;10m[49m     pred: i32,
[0m[49m[38;5;10m+     178[0m:[38;5;10m[49m     tgt: i32,
[0m[49m[38;5;10m+     179[0m:[38;5;10m[49m     tgt2: i32,
[0m[49m[38;5;10m+     180[0m:[38;5;10m[49m     lsbit: i32,
[0m[49m[38;5;10m+     181[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     182[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     183[0m:[38;5;10m[49m /// Calls BOTH `.so`s through FFI and asserts byte-identical results.
[0m[49m[38;5;10m+     184[0m:[38;5;10m[49m #[track_caller]
[0m[49m[38;5;10m+     185[0m:[38;5;10m[49m fn diff(row: &str, a: Args) -> i32 {
