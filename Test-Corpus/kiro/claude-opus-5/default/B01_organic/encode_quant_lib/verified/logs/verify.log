[0m[49m[38;5;10m+     187[0m:[38;5;10m[49m     let c = unsafe { (l.c)(a.uni, a.step, a.pred, a.tgt, a.tgt2, a.lsbit) };
[0m[49m[38;5;10m+     188[0m:[38;5;10m[49m     let r = unsafe { (l.rust)(a.uni, a.step, a.pred, a.tgt, a.tgt2, a.lsbit) };
[0m[49m[38;5;10m+     189[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+     190[0m:[38;5;10m[49m         c, r,
[0m[49m[38;5;10m+     191[0m:[38;5;10m[49m         "\n[{row}] DIVERGENCE\n  encode_quant(uni={}, step={}, pred={}, tgt={}, tgt2={}, lsbit={})\n  \
[0m[49m[38;5;10m+     192[0m:[38;5;10m[49m          C    = {c} (0x{c:08x})\n  Rust = {r} (0x{r:08x})\n",
[0m[49m[38;5;10m+     193[0m:[38;5;10m[49m         a.uni, a.step, a.pred, a.tgt, a.tgt2, a.lsbit
[0m[49m[38;5;10m+     194[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+     195[0m:[38;5;10m[49m     c
[0m[49m[38;5;10m+     196[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     197[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     198[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     199[0m:[38;5;10m[49m // Deterministic PRNG (xorshift64*), fixed seed per row for reproducibility
[0m[49m[38;5;10m+     200[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     201[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     202[0m:[38;5;10m[49m struct Rng(u64);
[0m[49m[38;5;10m+     203[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     204[0m:[38;5;10m[49m impl Rng {
[0m[49m[38;5;10m+     205[0m:[38;5;10m[49m     fn new(seed: u64) -> Self {
[0m[49m[38;5;10m+     206[0m:[38;5;10m[49m         // Avoid the zero state; mix so nearby seeds diverge immediately.
[0m[49m[38;5;10m+     207[0m:[38;5;10m[49m         Rng(seed
[0m[49m[38;5;10m+     208[0m:[38;5;10m[49m             .wrapping_mul(0x9E37_79B9_7F4A_7C15)
[0m[49m[38;5;10m+     209[0m:[38;5;10m[49m             .wrapping_add(0xD1B5_4A32_D192_ED03)
[0m[49m[38;5;10m+     210[0m:[38;5;10m[49m             | 1)
[0m[49m[38;5;10m+     211[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     212[0m:[38;5;10m[49m     fn next_u64(&mut self) -> u64 {
[0m[49m[38;5;10m+     213[0m:[38;5;10m[49m         let mut x = self.0;
[0m[49m[38;5;10m+     214[0m:[38;5;10m[49m         x ^= x >> 12;
[0m[49m[38;5;10m+     215[0m:[38;5;10m[49m         x ^= x << 25;
[0m[49m[38;5;10m+     216[0m:[38;5;10m[49m         x ^= x >> 27;
[0m[49m[38;5;10m+     217[0m:[38;5;10m[49m         self.0 = x;
[0m[49m[38;5;10m+     218[0m:[38;5;10m[49m         x.wrapping_mul(0x2545_F491_4F6C_DD1D)
[0m[49m[38;5;10m+     219[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     220[0m:[38;5;10m[49m     fn i32_full(&mut self) -> i32 {
