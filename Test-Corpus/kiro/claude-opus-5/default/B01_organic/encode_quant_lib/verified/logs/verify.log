[0m[49m[38;5;10m+     125[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+     126[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     127[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     128[0m:[38;5;10m[49m struct Both {
[0m[49m[38;5;10m+     129[0m:[38;5;10m[49m     _c_lib: Library,
[0m[49m[38;5;10m+     130[0m:[38;5;10m[49m     _rust_lib: Library,
[0m[49m[38;5;10m+     131[0m:[38;5;10m[49m     c: EncodeQuant,
[0m[49m[38;5;10m+     132[0m:[38;5;10m[49m     rust: EncodeQuant,
[0m[49m[38;5;10m+     133[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     134[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     135[0m:[38;5;10m[49m // SAFETY: the loaded functions are pure leaf functions taking/returning ints;
[0m[49m[38;5;10m+     136[0m:[38;5;10m[49m // no per-thread state and no unloading occurs (the Libraries live forever in a
