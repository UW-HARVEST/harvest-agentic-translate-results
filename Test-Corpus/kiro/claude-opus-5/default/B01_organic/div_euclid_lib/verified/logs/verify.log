=== src/lib.c ===
#include "lib.h"^M$
^M$
int div_euclid(int v1, int v2) {^M$
    if (v2 == 0) {^M$
        return 0;^M$
    }^M$
    int q, r;^M$
    if (v1 >= 0)^M$
        if (v2 >= 0)^M$
            return ((v1) / (v2));^M$
        else if (v2 != (-0x7fffffff - 1))^M$
            q = -((v1) / (-v2)), r = ((v1) % (-v2));^M$
        else^M$
            q = 0, r = v1;^M$
    else if (v1 != (-0x7fffffff - 1))^M$
        if (v2 >= 0)^M$
            q = -((-v1) / (v2)), r = -((-v1) % (v2));^M$
        else if (v2 != (-0x7fffffff - 1))^M$
            q = ((-v1) / (-v2)), r = -((-v1) % (-v2));^M$
        else^M$
            q = 1, r = v1 - q * v2;^M$
    else if (v2 >= 0)^M$
        q = -((-(v1 + v2)) / (v2)) - 1, r = -((-(v1 + v2)) % (v2));^M$
    else if (v2 != (-0x7fffffff - 1))^M$
        q = ((-(v1 - v2)) / (-v2)) + 1, r = -((-(v1 - v2)) % (-v2));^M$
    else^M$
        q = 1, r = 0;^M$
    if (r >= 0)^M$
        return q;^M$
    else^M$
        return q + (v2 > 0 ? -1 : 1);^M$
}^M$
