use std::ffi::c_int;
use std::path::{Path, PathBuf};
use std::process::Command;
use std::sync::OnceLock;

pub type DivEuclidFn = unsafe extern "C" fn(c_int, c_int) -> c_int;

pub const I32_MIN: c_int = i32::MIN;
pub const I32_MAX: c_int = i32::MAX;

