     1	//! Rust translation of the C library in `c_src/`.
     2	//!
     3	//! Public ABI (from `nm -D` on the C shared object and `include/lib.h`):
     4	//!   * `div_euclid`
     5	//!
     6	//! The header declares no namespace/renaming macros, so the source-level name
     7	//! is also the final linker symbol name.
     8	
     9	use std::ffi::c_int;
    10	
    11	/// `INT_MIN`, written the way the C source spells it: `(-0x7fffffff - 1)`.
    12	const C_INT_MIN: c_int = -0x7fffffff - 1;
    13	
    14	/// Translation of `int div_euclid(int v1, int v2)` from `c_src/src/lib.c`.
    15	///
    16	/// The C body is a chain of nested `if`/`else` statements relying on the usual
    17	/// dangling-`else` binding; the structure below reproduces that binding
    18	/// exactly. Every arithmetic operation is expressed with `wrapping_*` so the
    19	/// Rust build can never panic where the C would simply compute a value — the
    20	/// operand ranges enforced by the C branches mean no wrap actually occurs, so
    21	/// the results are identical to the C.
    22	///
    23	/// Behaviour is preserved verbatim, including the `v2 == 0` early return of `0`
    24	/// and the exact order of the `v2 >= 0` / `v2 != INT_MIN` checks.
    25	#[unsafe(no_mangle)]
    26	pub extern "C" fn div_euclid(v1: c_int, v2: c_int) -> c_int {
    27	    if v2 == 0 {
    28	        return 0;
    29	    }
    30	
    31	    // `int q, r;` — every path below assigns both before they are read.
    32	    let q: c_int;
    33	    let r: c_int;
    34	
    35	    if v1 >= 0 {
    36	        if v2 >= 0 {
    37	            // return ((v1) / (v2));
    38	            return v1.wrapping_div(v2);
    39	        } else if v2 != C_INT_MIN {
    40	            // q = -((v1) / (-v2)), r = ((v1) % (-v2));
    41	            let nv2 = v2.wrapping_neg();
    42	            q = v1.wrapping_div(nv2).wrapping_neg();
    43	            r = v1.wrapping_rem(nv2);
    44	        } else {
    45	            // q = 0, r = v1;
    46	            q = 0;
    47	            r = v1;
    48	        }
    49	    } else if v1 != C_INT_MIN {
    50	        let nv1 = v1.wrapping_neg();
    51	        if v2 >= 0 {
    52	            // q = -((-v1) / (v2)), r = -((-v1) % (v2));
    53	            q = nv1.wrapping_div(v2).wrapping_neg();
    54	            r = nv1.wrapping_rem(v2).wrapping_neg();
    55	        } else if v2 != C_INT_MIN {
    56	            // q = ((-v1) / (-v2)), r = -((-v1) % (-v2));
    57	            let nv2 = v2.wrapping_neg();
    58	            q = nv1.wrapping_div(nv2);
    59	            r = nv1.wrapping_rem(nv2).wrapping_neg();
    60	        } else {
    61	            // q = 1, r = v1 - q * v2;
    62	            // The comma operator sequences these, so `q` is already 1 here.
    63	            q = 1;
    64	            r = v1.wrapping_sub(q.wrapping_mul(v2));
    65	        }
    66	    } else if v2 >= 0 {
    67	        // q = -((-(v1 + v2)) / (v2)) - 1, r = -((-(v1 + v2)) % (v2));
    68	        let t = v1.wrapping_add(v2).wrapping_neg();
    69	        q = t.wrapping_div(v2).wrapping_neg().wrapping_sub(1);
    70	        r = t.wrapping_rem(v2).wrapping_neg();
    71	    } else if v2 != C_INT_MIN {
    72	        // q = ((-(v1 - v2)) / (-v2)) + 1, r = -((-(v1 - v2)) % (-v2));
    73	        let t = v1.wrapping_sub(v2).wrapping_neg();
    74	        let nv2 = v2.wrapping_neg();
    75	        q = t.wrapping_div(nv2).wrapping_add(1);
    76	        r = t.wrapping_rem(nv2).wrapping_neg();
    77	    } else {
    78	        // q = 1, r = 0;
    79	        q = 1;
    80	        r = 0;
    81	    }
    82	
    83	    if r >= 0 {
    84	        q
    85	    } else {
    86	        // return q + (v2 > 0 ? -1 : 1);
    87	        q.wrapping_add(if v2 > 0 { -1 } else { 1 })
    88	    }
    89	}
