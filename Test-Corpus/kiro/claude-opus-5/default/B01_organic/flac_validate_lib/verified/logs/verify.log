cat > /tmp/run_all.sh <<'EOF'
#!/usr/bin/env bash
set -uo pipefail
# Enumerate every feature combination declared in Cargo.toml (excluding
# "default") and run the differential suite for each, in both profiles.
mapfile -t FEATS < <(awk '/^\[features\]/{f=1;next} /^\[/{f=0} f && /=/{split($0,a,"=");gsub(/ /,"",a[1]); if(a[1]!="default"&&a[1]!="") print a[1]}' Cargo.toml)
COMBOS=("")
n=${#FEATS[@]}
if (( n > 0 )); then
  for ((m=0; m<(1<<n); m++)); do
    sel=(); for ((i=0;i<n;i++)); do (( m & (1<<i) )) && sel+=("${FEATS[i]}"); done
    COMBOS+=("$(IFS=,; echo "${sel[*]}")")
  done
fi
fail=0
for profile in "" "--release"; do
  for combo in "${COMBOS[@]}"; do
    label="profile=${profile:-dev} features='${combo:-<none>}'"
    echo "=================== $label"
    if ! timeout 600 cargo test $profile --no-default-features ${combo:+--features "$combo"} \
         2>&1 | grep -E "^(test result|error|.*panicked)" ; then :; fi
    # capture real status
    timeout 600 cargo test $profile --no-default-features ${combo:+--features "$combo"} \
      > /tmp/t.log 2>&1 || { echo "FAILED: $label"; fail=1; }
  done
done
# Default-feature run as well.
for profile in "" "--release"; do
  echo "=================== profile=${profile:-dev} features=<default>"
  timeout 600 cargo test $profile 2>&1 | grep -E "^test result"
  timeout 600 cargo test $profile > /tmp/t.log 2>&1 || { echo "FAILED default ${profile:-dev}"; fail=1; }
done
exit $fail
EOF
