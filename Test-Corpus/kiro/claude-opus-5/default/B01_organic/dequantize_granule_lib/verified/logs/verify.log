[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m     let case = Case::new(107_000, 1, 1, BaMode::Const(ba))
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m         .at(-64)
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m         .limit(LimitMode::Abs(1_000_000))
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m         .buf(BufMode::Split)
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m         .iters(1);
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m     let out = run_both(&c, &r, &case, 0);
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m     let f = out.floats();
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m     let first = out.written_indices()[0];
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m         f[first], -37.0,
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m         "negative pos must read 0x5A from before bs->buf: expected 90 - 127 = -37, got {}",
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m         f[first]
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m     // `pos = -1` => s = 7, `pos >> 3` = -1.
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     let case = Case::new(107_001, 2, 2, BaMode::Const(4))
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m         .at(-1)
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m         .limit(LimitMode::Abs(1_000_000))
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m         .buf(BufMode::Random)
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         .iters(8);
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m     check_case(&c, &r, &case);
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m // Row 8 — `n + s >= 40` makes `cache |= next << shl` an over-wide shift (UB in
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m // C; a 5-bit-masked `shl` on x86). Verified against a hand-computed value.
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m // ba = 22 => mod = 65, n = 59. With an all-ones buffer and s = 0:
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m //   shl = 59; iterations at shl = 51, 43, 35, 27, 19, 11, 3 each OR in
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m //   255 << (shl & 31), then `next >> 5` = 7. The OR of
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m //   255<<19 | 255<<11 | 255<<3 | 255<<27 | 255<<19 | 255<<11 | 255<<3 | 7
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m //   is 0xFFFF_FFFF, so code = 0xFFFF_FFFF.
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m //   0xFFFF_FFFF % 65 = 60, 60 - 32 = 28.
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m // A non-masking (mathematically correct) shift would give a different code.
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m fn row08_over_wide_shift_is_masked() {
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m     let (c, r) = load_impls();
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m     let ba = 22u8;
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m     assert_eq!(grouped_mod(k_of(ba)), 65);
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m     assert_eq!(grouped_n(k_of(ba)), 59);
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     // Recompute the expectation with the same masked-shift semantics.
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m     let mut cache: u32 = 0;
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m     let mut shl: i32 = 59;
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m     let mut next: u32 = 255;
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m     loop {
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         shl -= 8;
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m         if shl <= 0 {
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m             break;
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         cache |= next.wrapping_shl(shl as u32);
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         next = 255;
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m     }
