[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m fn row07_negative_pos_reads_before_buffer() {
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     let (c, r) = load_impls();
