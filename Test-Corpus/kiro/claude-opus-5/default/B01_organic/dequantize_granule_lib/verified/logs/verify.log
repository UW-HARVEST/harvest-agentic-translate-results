[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m         let expected = -(half(ba) as f32);
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m         let f = out.floats();
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m         for &i in &out.written_indices() {
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m             assert_eq!(f[i], expected, "limit={lim} slot {i}");
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m         }
