[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m         0x0000_0000,
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m         "errors_row01: C returned {:?}, expected +0.0f",
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m         p.c(-16)
