[0m[49m[38;5;10m+     43[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     44[0m:[38;5;10m[49m fn errors_row02_negative_index_oob_does_not_trap() {
[0m[49m[38;5;10m+     45[0m:[38;5;10m[49m     let p = Pair::load();
[0m[49m[38;5;10m+     46[0m:[38;5;10m[49m     let mut r = Rng::new(SEED ^ 0xE02);
