float pow43(int x) {
    float frac;
    int sign, mult = 256;
    if (x < 129) {
        return g_pow43[16 + x];
    }
    if (x < 1024) {
        mult = 16;
        x <<= 3;
    }
    sign = 2 * x & 64;
    frac = (float)((x & 63) - sign) / ((x & ~63) + sign);
    return g_pow43[16 + ((x + sign) >> 6)] *
           (1.f + frac * ((4.f / 3) + frac * (2.f / 9))) * mult;
}

