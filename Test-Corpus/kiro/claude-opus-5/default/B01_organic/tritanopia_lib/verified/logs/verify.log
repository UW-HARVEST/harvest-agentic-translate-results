[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m         (255u8, 255u8, 0u8),
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m         (0, 0, 255),
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m         (255, 0, 0),
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m         (0, 255, 255),
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m         (0, 0, 0),
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m         (255, 255, 255),
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m     ] {
