#include <stdio.h>
#include <math.h>
typedef struct { unsigned char R,G,B; } u8rgb;
typedef struct { float R,G,B; } frgb;
static float rg(float c){ return (float)(c>0.04045? pow((c+0.055)/1.055,2.4) : c/12.92); }
int main(void){
  // Axis 1: removeGamma branch boundary over byte values
  int lastLinear=-1, firstPow=-1;
  for(int b=0;b<256;b++){ float c=(float)b/255.f; if(c>0.04045){ if(firstPow<0) firstPow=b; } else lastLinear=b; }
  printf("A1 removeGamma: linear for bytes 0..%d, pow for %d..255\n", lastLinear, firstPow);

  // Axis 2/3: post-matrix ranges & applyGamma branch / denorm out-of-range reachability
  double minv[3]={9,9,9}, maxv[3]={-9,-9,-9};
  long applyLinear[3]={0,0,0}, applyPow[3]={0,0,0}, negch[3]={0,0,0}, ovf[3]={0,0,0};
  int minAt[3][3], maxAt[3][3];
  for(int r=0;r<256;r++)for(int g=0;g<256;g++)for(int bb=0;bb<256;bb++){
    float R=rg((float)r/255.f), G=rg((float)g/255.f), B=rg((float)bb/255.f);
    float o[3];
    o[0]=R+0.12739886310880f*G-0.12739886341072f*B;
    o[1]=-4.486E-11f*R+0.87390929928361f*G+0.12609070101523f*B;
    o[2]=3.1113E-10f*R+0.87390929725848f*G+0.12609070067115f*B;
    for(int k=0;k<3;k++){
      if(o[k]<minv[k]){minv[k]=o[k];minAt[k][0]=r;minAt[k][1]=g;minAt[k][2]=bb;}
      if(o[k]>maxv[k]){maxv[k]=o[k];maxAt[k][0]=r;maxAt[k][1]=g;maxAt[k][2]=bb;}
      if((double)o[k]>0.00313080495356037151702786377709) applyPow[k]++; else applyLinear[k]++;
      if(o[k]<0.f) negch[k]++;
      float ag = (float)((double)o[k]>0.00313080495356037151702786377709 ? 1.055*pow(o[k],0.4166666666)-0.055 : (double)o[k]*12.92);
      float d = ag*255.f+0.5f;
      if(!(d>=0.f && d<256.f)) ovf[k]++;
    }
  }
  const char*nm[3]={"R","G","B"};
  for(int k=0;k<3;k++)
    printf("A2 %s: post-matrix min=%.9g at (%d,%d,%d) max=%.9g at (%d,%d,%d) applyLinear=%ld applyPow=%ld negative=%ld denormOutOfRange=%ld\n",
      nm[k],minv[k],minAt[k][0],minAt[k][1],minAt[k][2],maxv[k],maxAt[k][0],maxAt[k][1],maxAt[k][2],applyLinear[k],applyPow[k],negch[k],ovf[k]);
  return 0;
}
EOF
