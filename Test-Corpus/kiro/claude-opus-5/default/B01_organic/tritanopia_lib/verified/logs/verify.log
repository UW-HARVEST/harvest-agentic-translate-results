[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m             pair.agree(CbRgb255::new(0, g, b));
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m             pair.agree(CbRgb255::new(g, g, b));
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m         }
