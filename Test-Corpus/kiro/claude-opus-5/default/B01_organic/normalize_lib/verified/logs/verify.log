#include <string.h>
typedef void (*fn)(float*, const float*, int);
static unsigned s=123456789u;
static unsigned nx(void){ s^=s<<13; s^=s>>17; s^=s<<5; return s; }
int main(int argc,char**argv){
  fn f[8]; int nf=argc-1;
  for(int i=0;i<nf;i++){ void*h=dlopen(argv[i+1],RTLD_NOW); if(!h){printf("dlopen %s: %s\n",argv[i+1],dlerror());return 1;} f[i]=(fn)dlsym(h,"normalize"); }
