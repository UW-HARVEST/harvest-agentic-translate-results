[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m /// Distinct, recognisable sentinel so that "was not written" is observable.
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m pub fn sentinel(i: usize) -> f32 {
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m     f32::from_bits(0x4B00_0000u32.wrapping_add(i as u32 * 7 + 1)) // ~8.4e6, all distinct
