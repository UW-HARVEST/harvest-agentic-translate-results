[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m             let total = off + n + 2 * GUARD;
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m             (vec![0.0; total], off, off)
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m         Alias::Delta(d) => {
