[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m             let dest_off = base + n + 2 * GUARD;
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m             let total = dest_off + n + 2 * GUARD;
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m             (vec![0.0; total], dest_off, src_off)
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m         Alias::InPlace => {
