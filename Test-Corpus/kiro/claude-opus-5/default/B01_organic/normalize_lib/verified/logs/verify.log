      bad++; if(bad>3) return 1;
    }
    for(int i=0;i<nf;i++) free(d[i]);
    free(src);
  }
  printf(bad?"DIFFERENCES FOUND\n":"all optimization levels agree bit-for-bit\n");
  return bad?1:0;
}
