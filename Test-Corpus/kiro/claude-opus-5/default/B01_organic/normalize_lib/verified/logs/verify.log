[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m /// Padding, in elements, kept around every live region so that an off-by-one
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m /// over-write lands inside the compared buffer instead of corrupting the heap.
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m pub const GUARD: usize = 8;
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m /// Build a flat scratch buffer and return `(buffer, dest_off, src_off)`.
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m /// `src` always occupies `[src_off, src_off + n)`; `dest` is placed according
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m /// to `alias`. Everything outside the live regions is a guard band that must be
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m /// bit-identical after both calls.
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m pub fn layout(n: usize, alias: Alias) -> (Vec<f32>, usize, usize) {
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m     let base = GUARD + 8; // headroom for negative deltas
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m     match alias {
