[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m // pointer-relationship axis (axis B of CONFIGS.md)
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m #[derive(Copy, Clone, Debug)]
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m pub enum Alias {
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m     /// `dest` and `src` are far apart in the buffer.
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m     Disjoint,
