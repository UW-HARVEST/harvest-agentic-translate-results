[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m /// Paint guard bands (and, for the disjoint case, the whole `dest` region)
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m /// with sentinels, so a missing or extra write is visible.
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m pub fn paint_untouched(buf: &mut [f32], live: &[(usize, usize)]) {
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m     'outer: for i in 0..buf.len() {
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m         for &(off, n) in live {
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m             if i >= off && i < off + n {
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m                 continue 'outer;
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m         }
