[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m // element populations (axis D of CONFIGS.md)
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m #[derive(Copy, Clone, Debug, PartialEq, Eq)]
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m pub enum Pop {
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m     /// Uniform in [-1, 1).
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m     Uniform,
