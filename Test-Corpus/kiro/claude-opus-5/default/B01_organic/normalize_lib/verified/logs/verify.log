    int mode = nx()%4;
    for(int k=0;k<n;k++){
      unsigned b=nx();
      if(mode==0){ src[k]=((float)(int)b)/2147483648.0f; }
      else if(mode==1){ memcpy(&src[k],&b,4); }
      else if(mode==2){ int e=(int)(nx()%120)-60; src[k]=ldexpf(1.0f+((float)(nx()&0xffff))/65536.0f,e)*((nx()&1)?-1:1); }
