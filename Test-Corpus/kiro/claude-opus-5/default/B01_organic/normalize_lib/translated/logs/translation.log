void normalize(float *dest, const float *src, int size);
static unsigned long long s = 88172645463325252ULL;
static unsigned long long xs(void){ s^=s<<13; s^=s>>7; s^=s<<17; return s; }
int main(void){
    for (int t = 0; t < 20000; t++) {
        int n = (int)(xs() % 17);
        float src[16], dst[16];
        for (int i = 0; i < 16; i++) {
            unsigned u = (unsigned)xs();
            if (xs() & 1) { u = (u & 0x807fffff) | (((xs()%254)+1) << 23); } /* mostly-normal floats */
            memcpy(&src[i], &u, 4);
        }
        memset(dst, 0x5A, sizeof dst);
        int alias = (xs() & 3) == 0;
        if (alias) { memcpy(dst, src, sizeof src); normalize(dst, dst, n); }
        else normalize(dst, src, n);
        for (int i = 0; i < 16; i++) { unsigned u; memcpy(&u, &dst[i], 4); printf("%08x", u); }
        printf("\n");
    }
    return 0;
}
