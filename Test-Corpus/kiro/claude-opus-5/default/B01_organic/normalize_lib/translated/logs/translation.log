#include <stdio.h>
#include <string.h>
#include <math.h>
void normalize(float *dest, const float *src, int size);
static void dump(const char *tag, float *b, int n) {
    printf("%s:", tag);
    for (int i = 0; i < n; i++) { unsigned u; memcpy(&u, &b[i], 4); printf(" %08x", u); }
    printf("\n");
}
int main(void) {
    float in[8]  = {3.0f, 4.0f, 0.0f, -1.5f, 1e-20f, 7.25f, -0.125f, 1e20f};
    float zeros[4] = {0,0,0,0};
    float neg[3] = {-0.0f, -0.0f, -0.0f};
    float nan3[3] = {NAN, 1.0f, 2.0f};
    float tiny[3] = {1e-30f, 1e-30f, 1e-30f};
    float out[8];

    memset(out, 0xAA, sizeof out); normalize(out, in, 8);     dump("basic", out, 8);
    memset(out, 0xAA, sizeof out); normalize(out, in, 0);     dump("size0", out, 8);
    memset(out, 0xAA, sizeof out); normalize(out, in, 1);     dump("size1", out, 8);
    memset(out, 0xAA, sizeof out); normalize(out, zeros, 4);  dump("zerosrc", out, 4);
    memset(out, 0xAA, sizeof out); normalize(out, neg, 3);    dump("negzero", out, 3);
    memset(out, 0xAA, sizeof out); normalize(out, nan3, 3);   dump("nan", out, 3);
    memset(out, 0xAA, sizeof out); normalize(out, tiny, 3);   dump("tiny", out, 3);

    float a[8]; memcpy(a, in, sizeof in); normalize(a, a, 8);  dump("alias", a, 8);
    float z[4] = {0,0,0,0}; normalize(z, z, 4);                dump("aliaszero", z, 4);

    float big[5] = {1e20f, 1e20f, 1e20f, 1e20f, 1e20f};
    memset(out, 0xAA, sizeof out); normalize(out, big, 5);    dump("overflow", out, 5);
    return 0;
}
EOF
