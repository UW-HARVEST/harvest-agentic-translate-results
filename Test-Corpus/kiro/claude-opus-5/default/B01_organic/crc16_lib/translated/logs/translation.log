#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <dlfcn.h>

typedef uint16_t (*crc16_fn)(const uint8_t*, uint32_t, uint16_t);

static uint32_t rs = 0x12345678u;
static uint32_t nextr(void){ rs ^= rs<<13; rs ^= rs>>17; rs ^= rs<<5; return rs; }

int main(int argc, char** argv){
    void *hc = dlopen(argv[1], RTLD_NOW), *hr = dlopen(argv[2], RTLD_NOW);
    if(!hc||!hr){ fprintf(stderr,"dlopen: %s\n", dlerror()); return 2; }
    crc16_fn c = (crc16_fn)dlsym(hc,"crc16");
    crc16_fn r = (crc16_fn)dlsym(hr,"crc16");
    if(!c||!r){ fprintf(stderr,"dlsym failed\n"); return 2; }

    uint8_t buf[4096];
    long fails=0, cases=0;

    /* zero-length, NULL pointer */
    if(c(NULL,0,0) != r(NULL,0,0)){ printf("FAIL null/0\n"); fails++; } cases++;
    for(uint32_t seed=0; seed<0x10000u; seed+=0x101u){
        if(c(NULL,0,(uint16_t)seed) != r(NULL,0,(uint16_t)seed)){ printf("FAIL null/0 seed %u\n",seed); fails++; } cases++;
    }

    /* exhaustive single byte x seed sample */
    for(int b=0;b<256;b++){
        buf[0]=(uint8_t)b;
        for(uint32_t s=0;s<0x10000u;s+=0x1111u){
            uint16_t seed=(uint16_t)s;
            if(c(buf,1,seed)!=r(buf,1,seed)){ printf("FAIL b=%d s=%u\n",b,seed); fails++; } cases++;
        }
    }

    /* all lengths 0..1024 with random data and random seeds */
    for(uint32_t len=0; len<=1024; len++){
        for(int rep=0; rep<3; rep++){
            for(uint32_t i=0;i<len;i++) buf[i]=(uint8_t)(nextr()>>7);
            uint16_t seed=(uint16_t)nextr();
            uint16_t a=c(buf,len,seed), bb=r(buf,len,seed);
            if(a!=bb){ printf("FAIL len=%u rep=%d seed=%u -> C=%04x R=%04x\n",len,rep,seed,a,bb); fails++; }
            cases++;
        }
    }

    /* patterned data: all 0x00, all 0xFF, incrementing */
    for(uint32_t len=0; len<=300; len++){
        memset(buf,0x00,len); if(c(buf,len,0xFFFF)!=r(buf,len,0xFFFF)){printf("FAIL zeros len=%u\n",len);fails++;} cases++;
        memset(buf,0xFF,len); if(c(buf,len,0x0000)!=r(buf,len,0x0000)){printf("FAIL ones len=%u\n",len);fails++;} cases++;
        for(uint32_t i=0;i<len;i++) buf[i]=(uint8_t)i;
        if(c(buf,len,0xABCD)!=r(buf,len,0xABCD)){printf("FAIL inc len=%u\n",len);fails++;} cases++;
    }

    /* large buffers */
    for(int rep=0; rep<200; rep++){
        for(uint32_t i=0;i<4096;i++) buf[i]=(uint8_t)(nextr()>>11);
        uint16_t seed=(uint16_t)nextr();
        if(c(buf,4096,seed)!=r(buf,4096,seed)){printf("FAIL big rep=%d\n",rep);fails++;} cases++;
    }

    printf("cases=%ld fails=%ld\n", cases, fails);
    return fails?1:0;
}
EOF
