#include <stdio.h>
#include <stdint.h>
#include <dlfcn.h>
typedef uint16_t (*fn)(const uint8_t*, uint32_t, uint16_t);
int main(int argc,char**argv){
  void*hc=dlopen(argv[1],RTLD_NOW),*hr=dlopen(argv[2],RTLD_NOW);
  fn c=(fn)dlsym(hc,"crc16"), r=(fn)dlsym(hr,"crc16");
  long cases=0,fails=0; uint8_t b[8]={0};
  /* sweep every byte position 0..7 over all 256 values, and seed over all 65536 high/low combos sampled */
  for(int pos=0;pos<8;pos++){
    for(int v=0;v<256;v++){
      for(int k=0;k<8;k++) b[k]=0;
      b[pos]=(uint8_t)v;
      for(uint32_t s=0;s<65536;s+=257){
        uint16_t seed=(uint16_t)s;
        if(c(b,8,seed)!=r(b,8,seed)){printf("FAIL pos=%d v=%d s=%u\n",pos,v,seed);fails++;}
        cases++;
      }
    }
  }
  /* exhaustive seed sweep on a fixed 8-byte block: covers tables[7] and tables[6] indices fully */
  for(int k=0;k<8;k++) b[k]=(uint8_t)(k*37+11);
  for(uint32_t s=0;s<65536;s++){
    uint16_t seed=(uint16_t)s;
    if(c(b,8,seed)!=r(b,8,seed)){printf("FAIL seed=%u\n",s);fails++;}
    cases++;
  }
  /* exhaustive seed sweep at len=1 for every byte: covers tables[0] fully */
  for(int v=0;v<256;v++){
    uint8_t one=(uint8_t)v;
    for(uint32_t s=0;s<65536;s+=13){
      uint16_t seed=(uint16_t)s;
      if(c(&one,1,seed)!=r(&one,1,seed)){printf("FAIL one v=%d s=%u\n",v,s);fails++;}
      cases++;
    }
  }
  printf("cases=%ld fails=%ld\n",cases,fails); return fails?1:0;
}
EOF
