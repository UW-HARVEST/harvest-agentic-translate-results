[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m fn e7_seed_max_block_max_table_index() {
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m     let im = Impls::load();
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m     // Choose d[0],d[1] so that (crc ^ (d0<<8|d1)) >> 8 == 0xFF and & 0xFF == 0xFF,
