[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m // Covers every table[7] / table[6] index via crc>>8 and crc&0xFF.
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m fn c11_exhaustive_seeds_block_loop() {
