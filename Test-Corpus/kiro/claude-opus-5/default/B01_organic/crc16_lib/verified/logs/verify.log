[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m                 "C12 DIVERGENCE: len={len} seed=0x{seed:04x} C=0x{cv:04x} Rust=0x{rv:04x}"
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m // C13 — data-value axis: 0..=255 repeated, len swept 0..=300 so every byte
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m // value lands in every block position and every tail position.
