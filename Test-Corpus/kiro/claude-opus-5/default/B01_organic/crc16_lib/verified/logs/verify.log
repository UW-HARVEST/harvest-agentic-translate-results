[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m         blk0[0] = (word0 >> 8) as u8;
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m         blk0[1] = (word0 & 0xFF) as u8;
