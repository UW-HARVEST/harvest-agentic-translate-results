[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m         let rotated: Vec<u8> = (0..512).map(|i| ((i + rot) % 256) as u8).collect();
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m         for len in 0u32..=64 {
