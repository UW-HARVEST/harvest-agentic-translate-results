[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m // C14 — table coverage: force d[2]..d[7] to take all 256 values so tables
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m // [5],[4],[3],[2],[1],[0] are each indexed across their full range.
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m fn c14_full_table_index_coverage() {
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m     let im = Impls::load();
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x0E);
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m     // For each of the 6 value-indexed block slots (d[2]..d[7]) and each of the
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m     // 256 byte values, build a block where that slot holds the value.
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m     for slot in 2usize..8 {
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m         for v in 0u16..=255 {
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m             let mut blk = [0u8; 8];
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m             rng.fill(&mut blk);
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m             blk[slot] = v as u8;
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m             for &seed in &[0x0000u16, 0xFFFF, 0x5A5A] {
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m                 im.check(&blk, 8, seed, "C14 table index coverage");
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m     // And drive crc>>8 / crc&0xFF (tables [7]/[6]) across all 256 values each
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m     // by choosing seeds that, after the d[0]/d[1] xor, hit every index.
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m     for hi in 0u16..=255 {
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m         for lo in [0x00u16, 0x7F, 0x80, 0xFF] {
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m             let seed = (hi << 8) | lo;
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m             let blk = [0u8; 8];
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m             im.check(&blk, 8, seed, "C14 crc-derived index coverage");
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m // C15 — streaming: split a 1024-byte buffer at EVERY offset into two calls,
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m // feeding call 1's result in as call 2's seed. C-chained vs Rust-chained, and
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m // both vs the one-shot value.
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m fn c15_streaming_every_split_point() {
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m     let im = Impls::load();
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x0F);
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m     let data = rng.bytes(1024);
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m     let seed0 = 0x0000u16;
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m     let one_shot_c = im.c_call(&data, 1024, seed0);
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m     let one_shot_r = im.rust_call(&data, 1024, seed0);
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m     assert_eq!(one_shot_c, one_shot_r, "C15 one-shot mismatch");
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m     for split in 0usize..=1024 {
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m         let (a, b) = data.split_at(split);
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m         let mid_c = im.c_call(a, a.len() as u32, seed0);
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m         let mid_r = im.rust_call(a, a.len() as u32, seed0);
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m             mid_c, mid_r,
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m             "C15 first-chunk mismatch at split={split}: C=0x{mid_c:04x} Rust=0x{mid_r:04x}"
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m         let end_c = im.c_call(b, b.len() as u32, mid_c);
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m         let end_r = im.rust_call(b, b.len() as u32, mid_r);
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m             end_c, end_r,
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m             "C15 second-chunk mismatch at split={split}: C=0x{end_c:04x} Rust=0x{end_r:04x}"
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m         // Cross-check: the chained result of a split at a multiple of 8 must
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m         // equal the one-shot result (the block loop is resumable there).
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m         if split % 8 == 0 {
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m                 end_c, one_shot_c,
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m                 "C15 chained != one-shot at 8-aligned split={split} (C itself)"
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m // C16 — streaming with many random chunks.
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m fn c16_streaming_random_chunks() {
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m     let im = Impls::load();
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x10);
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m     for _ in 0..1000 {
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m         let total = rng.below(2048);
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m         let data = rng.bytes(total);
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m         let nchunks = 1 + rng.below(16);
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m         let mut cuts: Vec<usize> = (0..nchunks - 1).map(|_| rng.below(total + 1)).collect();
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m         cuts.push(0);
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m         cuts.push(total);
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m         cuts.sort_unstable();
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m         let seed = rng.next_u16();
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m         let mut cc = seed;
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m         let mut rc = seed;
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m         for w in cuts.windows(2) {
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m             let chunk = &data[w[0]..w[1]];
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m             cc = im.c_call(chunk, chunk.len() as u32, cc);
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m             rc = im.rust_call(chunk, chunk.len() as u32, rc);
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m                 cc, rc,
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m                 "C16 chunk mismatch: total={total} chunk={}..{} C=0x{cc:04x} Rust=0x{rc:04x}",
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m                 w[0], w[1]
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m // C17 — alignment independence: same payload read from offsets 0..=7.
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m fn c17_alignment_offsets() {
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m     let im = Impls::load();
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x11);
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m     let backing = rng.bytes(128);
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m     for off in 0usize..=7 {
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m         for len in 0u32..=56 {
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m             let slice = &backing[off..off + len as usize];
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m             for &seed in &[0x0000u16, 0xFFFF, 0x9E3Du16] {
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m                 let cv = im.c_call(slice, len, seed);
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m                 let rv = im.rust_call(slice, len, seed);
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m                 assert_eq!(
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m                     cv, rv,
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m                     "C17 mismatch: off={off} len={len} seed=0x{seed:04x} C=0x{cv:04x} Rust=0x{rv:04x}"
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m // C18 — a len==0 call chained into a non-zero call.
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m fn c18_zero_length_composition() {
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m     let im = Impls::load();
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x12);
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m     let data = rng.bytes(64);
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m     for _ in 0..500 {
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m         let seed = rng.next_u16();
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m         let len = rng.below(65) as u32;
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m         let c0 = im.c_call(&data, 0, seed);
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m         let r0 = im.rust_call(&data, 0, seed);
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m         assert_eq!(c0, r0);
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m         assert_eq!(c0, seed, "C18: len=0 must be the identity on the seed");
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m         let c1 = im.c_call(&data, len, c0);
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m         let r1 = im.rust_call(&data, len, r0);
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m         assert_eq!(c1, r1, "C18 chained mismatch");
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m         let direct_c = im.c_call(&data, len, seed);
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m         assert_eq!(c1, direct_c, "C18: zero-length prefix changed the result");
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m // C19 — known-answer / anti-triviality. Guards against both sides being
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m // broken the same way (e.g. always returning the seed).
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m fn c19_known_answer_and_anti_triviality() {
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m     let im = Impls::load();
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m     let check_str = b"123456789";
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m     let c = im.check(check_str, check_str.len() as u32, 0x0000, "C19 123456789");
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m     // Not a hardcoded expectation of the algorithm's identity, but the result
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m     // must at least not be the trivial passthrough / zero.
