[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m     let seeds = [0x0000u16, 0xFFFF, 0x1234, 0xABCD, 0x00FF, 0xFF00];
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m     for len in 0u32..=300 {
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         for &seed in &seeds {
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m             im.check(&data, len, seed, "C13 all byte values");
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         }
