[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m     let payloads: Vec<Vec<u8>> = vec![
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m         b"123456789".to_vec(),
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m         b"The quick brown fox jumps over the lazy dog".to_vec(),
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m         vec![0x00; 1],
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m         vec![0x00; 8],
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m         vec![0x00; 9],
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m         vec![0xFF; 1],
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m         vec![0xFF; 8],
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m         vec![0xFF; 17],
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m         Vec::new(),
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m     let mut seen = std::collections::HashSet::new();
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m     for p in &payloads {
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m         let v = im.check(p, p.len() as u32, 0x0000, "C19 payload");
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m         seen.insert(v);
