[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m             // then pass count = n + 1. The C reads the tail; both must agree.
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m             let mut s: Vec<f32> = (0..3 * (n + 1)).map(|_| rng.tame_f32()).collect();
