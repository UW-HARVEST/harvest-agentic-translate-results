[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m     for i in 0..ITERS {
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m         let lane = rng.below(3) as usize;
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m         let mut s = [rng.tame_f32(), rng.tame_f32(), rng.tame_f32()];
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m         s[lane] = if rng.next_u32() & 1 == 0 {
