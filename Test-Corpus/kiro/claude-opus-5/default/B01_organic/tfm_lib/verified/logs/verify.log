[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m // Row 11 — sqd == -0.0 is NOT clamped, sqrtf(-0.0) == -0.0
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m fn row_11_negative_zero_discriminant() {
