[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m         [f32::INFINITY, 0.0, 0.0],
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m         [-0.0, f32::NEG_INFINITY, 0.0],
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m         [1.0, 1.0, f32::INFINITY],
