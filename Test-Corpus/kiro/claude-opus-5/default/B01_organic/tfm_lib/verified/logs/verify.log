[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m /// Build a `count`-element `src` (3 floats per element) from a per-lane closure.
[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m fn build(count: usize, mut lane: impl FnMut(usize, usize) -> f32) -> Vec<f32> {
