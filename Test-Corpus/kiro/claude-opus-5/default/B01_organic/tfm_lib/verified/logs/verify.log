[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m fn row_09_negative_discriminant_clamped_not_errored() {
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     let mut rng = Rng::new(0x2222_0009);
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m     // Near-equal dx2/dy2 with dxy == 0 makes the expanded sqd round negative.
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m     let mut saw_clamp = false;
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     for i in 0..2000 {
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m         let a = rng.normal_f32();
