[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m             let mut s = [1.5f32, -2.5, 3.5];
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m             s[lane] = n;
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m             diff_call("err14", &s, 1);
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m             let mut s2 = [-2.5f32, 1.5, 3.5];
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m             s2[lane] = n;
