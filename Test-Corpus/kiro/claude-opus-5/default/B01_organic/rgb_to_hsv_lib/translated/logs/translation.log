#include <stdio.h>
#include <stdint.h>
#include <math.h>
#include <dlfcn.h>
typedef void (*fn_t)(float*, const float*);
static uint32_t st = 0x12345678u;
static uint32_t nxt(void){ st ^= st<<13; st ^= st>>17; st ^= st<<5; return st; }
int main(int argc, char**argv){
    void *h = dlopen(argv[1], RTLD_NOW);
    if(!h){ fprintf(stderr,"%s\n", dlerror()); return 1; }
    fn_t f = (fn_t)dlsym(h, "rgb_to_hsv");
    if(!f){ fprintf(stderr,"no sym\n"); return 1; }
    float specials[] = {0.f,1.f,-0.f,-1.f,0.5f,255.f,1e-45f,3.4e38f,NAN,INFINITY,-INFINITY};
    int ns = sizeof(specials)/sizeof(*specials);
    for(int i=0;i<ns;i++)for(int j=0;j<ns;j++)for(int k=0;k<ns;k++){
        float in[3]={specials[i],specials[j],specials[k]}, out[3]={0,0,0};
        f(out,in);
        uint32_t o[3]; memcpy(o,out,12);
        printf("%08x %08x %08x\n",o[0],o[1],o[2]);
    }
    for(int t=0;t<200000;t++){
        float in[3], out[3]={0,0,0};
        for(int c=0;c<3;c++){ uint32_t u=nxt(); in[c] = (float)(u%1000001)/1000000.0f * ((u&0x80000000u)?-1.f:1.f); }
        f(out,in);
        uint32_t o[3]; memcpy(o,out,12);
        printf("%08x %08x %08x\n",o[0],o[1],o[2]);
    }
    for(int t=0;t<200000;t++){
        float in[3], out[3]={0,0,0};
        for(int c=0;c<3;c++){ uint32_t u=nxt(); memcpy(&in[c],&u,4); }
        f(out,in);
        uint32_t o[3]; memcpy(o,out,12);
        printf("%08x %08x %08x\n",o[0],o[1],o[2]);
    }
    return 0;
}
EOF
