[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m         let v = match rng.below(6) {
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m             0 => rng.unit(),
[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m             1 => rng.range(-1000.0, 1000.0),
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m             2 => rng.subnormal(),
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m             3 => rng.any_f32(),
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m             4 => f32::MAX,
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m             _ => rng.range(0.0, f32::MAX),
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m         assert_same(&[v, v, v], "C6");
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m     for v in [0.0f32, -0.0, 0.5, 1.0, -1.0, -2.0, f32::MAX, f32::MIN, f32::MIN_POSITIVE] {
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m         assert_same(&[v, v, v], "C6/pinned");
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m // C7 — channels 1..4 ULP apart (tiny / subnormal delta)
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m fn add_ulps(x: f32, n: i32) -> f32 {
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m     let b = x.to_bits() as i32;
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m     f32::from_bits(b.wrapping_add(n) as u32)
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m fn cfg_c7_one_ulp_apart() {
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 7);
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m     for _ in 0..ITERS {
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m         let base = match rng.below(4) {
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m             0 => rng.unit(),
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m             1 => rng.subnormal(),
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m             2 => rng.range(-1.0, 1.0),
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m             _ => rng.any_f32(),
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m         let d1 = (rng.below(9) as i32) - 4;
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m         let d2 = (rng.below(9) as i32) - 4;
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m         assert_same(&[base, add_ulps(base, d1), add_ulps(base, d2)], "C7");
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     // Pinned: adjacent floats at several scales.
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     for base in [1.0f32, 0.5, 1e-30, 1e30, f32::MIN_POSITIVE, 0.0] {
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m         for d in [-2i32, -1, 0, 1, 2] {
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m             assert_same(&[base, add_ulps(base, d), add_ulps(base, -d)], "C7/pinned");
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m // C8 — exact two-channel ties (if / else-if priority)
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m fn cfg_c8_two_channel_ties() {
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 8);
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m     for _ in 0..ITERS {
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m         let hi = rng.range(0.3, 1.0);
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m         let lo = rng.range(-1.0, 0.3);
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m         // r == g > b : r branch must win over the g branch.
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m         assert_same(&[hi, hi, lo], "C8/r==g");
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m         // g == b > r : r==max false, g==max true => g branch (not else).
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m         assert_same(&[lo, hi, hi], "C8/g==b");
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m         // r == b > g : r==max true => r branch.
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m         assert_same(&[hi, lo, hi], "C8/r==b");
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m         // all three tie => delta == 0 early return.
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m         assert_same(&[hi, hi, hi], "C8/all");
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     // Pinned checks of the documented branch priority.
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m     let out = check(&[1.0, 1.0, 0.0], "C8/pinned r==g");
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m     assert_eq!(out[0].to_bits(), 60.0f32.to_bits(), "r branch: (g-b)/delta*60 = 60");
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m     let out = check(&[0.0, 1.0, 1.0], "C8/pinned g==b");
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m     assert_eq!(out[0].to_bits(), 180.0f32.to_bits(), "g branch: (2+(b-r)/delta)*60 = 180");
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m     let out = check(&[1.0, 0.0, 1.0], "C8/pinned r==b");
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m     assert_eq!(out[0].to_bits(), 300.0f32.to_bits(), "r branch: (g-b)/delta*60 = -60 -> 300");
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m // C9 — exact hue boundaries at several s/v levels
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m fn cfg_c9_hue_boundaries() {
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     // Unit hue wheel in 1-degree steps, reconstructed exactly the way an HSV
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     // consumer would, at a spread of v and s levels.
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     for vi in 0..=8u32 {
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m         let v = vi as f32 / 8.0;
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m         for si in 0..=8u32 {
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m             let s = si as f32 / 8.0;
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m             for deg in 0..=360u32 {
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m                 let h = deg as f32;
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m                 let c = v * s;
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m                 let hp = h / 60.0;
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m                 let x = c * (1.0 - ((hp % 2.0) - 1.0).abs());
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m                 let m = v - c;
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m                 let (r1, g1, b1) = match deg / 60 {
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m                     0 => (c, x, 0.0),
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m                     1 => (x, c, 0.0),
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m                     2 => (0.0, c, x),
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m                     3 => (0.0, x, c),
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m                     4 => (x, 0.0, c),
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m                     _ => (c, 0.0, x),
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m                 assert_same(&[r1 + m, g1 + m, b1 + m], "C9");
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m     // The six primaries/secondaries plus black and white.
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m     for src in [
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m         [1.0f32, 0.0, 0.0],
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m         [1.0, 1.0, 0.0],
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m         [0.0, 1.0, 0.0],
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m         [0.0, 1.0, 1.0],
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         [0.0, 0.0, 1.0],
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m         [1.0, 0.0, 1.0],
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m         [0.0, 0.0, 0.0],
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m         [1.0, 1.0, 1.0],
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m         assert_same(&src, "C9/pinned");
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m // C10 — all channels negative
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m fn cfg_c10_all_negative() {
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 10);
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m     for _ in 0..ITERS {
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         let scale = match rng.below(4) {
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m             0 => 1.0f32,
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m             1 => 1e-20,
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m             2 => 1e20,
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m             _ => f32::MAX / 4.0,
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m         let src = [
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m             -rng.unit() * scale,
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m             -rng.unit() * scale,
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m             -rng.unit() * scale,
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m         ];
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m         assert_same(&src, "C10");
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m     for src in [
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m         [-1.0f32, -2.0, -3.0],
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         [-3.0, -2.0, -1.0],
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         [-1.0, -3.0, -2.0],
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         [-0.5, -0.5, -1.0],
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m         assert_same(&src, "C10/pinned");
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m // C11 — mixed sign (includes max == 0 with delta > 0)
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m fn cfg_c11_mixed_sign() {
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 11);
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m     for _ in 0..ITERS {
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m         let pick = |rng: &mut Rng| -> f32 {
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m             match rng.below(5) {
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m                 0 => 0.0,
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m                 1 => -0.0,
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m                 2 => rng.range(-1.0, 0.0),
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m                 3 => rng.range(0.0, 1.0),
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m                 _ => rng.range(-1e6, 1e6),
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m         let src = [pick(&mut rng), pick(&mut rng), pick(&mut rng)];
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m         assert_same(&src, "C11");
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m     // max == 0 with delta != 0 (ERRORS.md E2) in each channel position.
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m     for src in [
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m         [-1.0f32, 0.0, 0.0],
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m         [0.0, -1.0, 0.0],
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m         [0.0, 0.0, -1.0],
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m         [-1.0, -2.0, 0.0],
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m         [0.0, -0.0, -5.0],
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m         let out = check(&src, "C11/max==0");
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m         assert_eq!(out[0].to_bits(), 0.0f32.to_bits());
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m         assert_eq!(out[1].to_bits(), 0.0f32.to_bits());
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m         assert_eq!(out[2], 0.0f32);
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m // C12 — all 8 signed-zero combinations
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m fn cfg_c12_signed_zero_grid() {
