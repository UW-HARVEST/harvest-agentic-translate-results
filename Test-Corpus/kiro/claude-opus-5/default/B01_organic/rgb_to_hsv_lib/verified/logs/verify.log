[0m[49m[38;5;10m+     82[0m:[38;5;10m[49m             "both" => f(std::ptr::null_mut(), std::ptr::null()),
[0m[49m[38;5;10m+     83[0m:[38;5;10m[49m             other => panic!("bad case {other}"),
