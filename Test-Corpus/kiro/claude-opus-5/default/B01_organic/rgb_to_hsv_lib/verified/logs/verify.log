[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m         "E23: null src must produce the same outcome; C={c:?} Rust={r:?}"
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m         c,
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m         Err(libc::SIGSEGV),
