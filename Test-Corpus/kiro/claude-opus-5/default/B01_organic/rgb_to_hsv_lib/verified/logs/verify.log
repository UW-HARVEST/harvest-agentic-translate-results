[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m             common::bits3(&br),
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m             "E21 divergence for {src:?}"
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m     }
