[0m[49m[38;5;10m+     10[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m mod common;
[0m[49m[38;5;10m+     12[0m:[38;5;10m[49m use common::{c_impl, pair, rust_impl, Rng, CANARY, N, SEED};
