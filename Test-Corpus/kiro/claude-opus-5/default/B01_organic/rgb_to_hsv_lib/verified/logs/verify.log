[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m // E23 — src == NULL
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m fn err_e23_null_src_faults_identically() {
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m     let c = run_isolated(Which::C, false, true);
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m     let r = run_isolated(Which::Rust, false, true);
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m     assert_eq!(
