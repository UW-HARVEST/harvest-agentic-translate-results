[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m         Which::C => common::c_fn(),
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m         Which::Rust => common::rust_fn(),
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m     let mut buf = [0.0f32; 3];
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m     let src_buf = [0.5f32, 0.25, 0.75];
