[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xE19);
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m     for _ in 0..10_000 {
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m         let hi = rng.range(-1e3, 1e3);
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m         let lo = hi - rng.unit() * 1e3 - 1.0;
