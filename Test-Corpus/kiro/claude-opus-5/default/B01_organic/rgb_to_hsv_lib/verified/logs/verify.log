[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m             } else {
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m                 buf.as_mut_ptr()
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m             let src = if src_null {
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m                 std::ptr::null()
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m             } else {
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m                 src_buf.as_ptr()
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m             f(dest, src);
