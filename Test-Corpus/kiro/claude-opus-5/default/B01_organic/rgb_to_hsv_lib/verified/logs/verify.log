[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m             libc::_exit(0);
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m         let mut status: libc::c_int = 0;
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m         let w = libc::waitpid(pid, &mut status, 0);
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m         assert_eq!(w, pid, "waitpid failed");
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m         if libc::WIFSIGNALED(status) {
