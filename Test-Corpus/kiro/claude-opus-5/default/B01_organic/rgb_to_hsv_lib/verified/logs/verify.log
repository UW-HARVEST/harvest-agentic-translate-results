[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m             ru(br.as_mut_ptr(), br.as_ptr());
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m         assert_eq!(
