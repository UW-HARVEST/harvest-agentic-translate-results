[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m     // delta=1, else branch: 4 + (0-0.25)/1 = 3.75, *60 = 225.
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m     assert_eq!(b(out[0]), b(225.0), "E20: else branch, got {}", out[0]);
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m 
