[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m // E19 — tie g == b == max, r smaller: the `g` branch, not `else`
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m fn err_e19_tie_g_b() {
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m     let out = check(&[0.0, 1.0, 1.0], "E19");
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m     // r==max? 0==1 false. g==max? true => g branch: 2 + (b-r)/delta = 2+1 = 3,
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m     // *60 = 180.  The else branch would give 4 + (r-g)/delta = 4-1 = 3 -> 180.
