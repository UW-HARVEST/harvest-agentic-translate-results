[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m // E20 — the final `else` is an unconditional fallthrough, not a `b == max` test
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m fn err_e20_else_fallthrough() {
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m     // Ordinary route: b strict max.
