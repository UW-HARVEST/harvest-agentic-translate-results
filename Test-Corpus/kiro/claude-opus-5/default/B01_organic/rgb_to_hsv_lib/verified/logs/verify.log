[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m // E22 — partial overlap dest = src +/- 1
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m fn err_e22_alias_offset() {
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m     let c = common::c_fn();
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m     let ru = common::rust_fn();
