#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <math.h>
void hsl_to_rgb(float*,const float*);
void rust_hsl_to_rgb(float*,const float*);
static uint32_t bits(float f){uint32_t u;memcpy(&u,&f,4);return u;}
int main(void){
  float hs[]={-720,-360,-180,-60,-1,-0.0f,0,1e-8f,30,59.999f,60,90,119.9f,120,150,179.9f,180,210,239.9f,240,270,299.9f,300,330,359.999f,360,400,720,1e9f,NAN,INFINITY,-INFINITY};
  float ss[]={0,-0.0f,1e-9f,0.25f,0.5f,0.75f,1,2,-0.5f,NAN};
  float ls[]={0,0.1f,0.25f,0.5f,0.75f,0.9f,1,-0.3f,1.7f,NAN};
  long n=0,bad=0;
  for(unsigned i=0;i<sizeof hs/4;i++)for(unsigned j=0;j<sizeof ss/4;j++)for(unsigned k=0;k<sizeof ls/4;k++){
    float src[3]={hs[i],ss[j],ls[k]};
    float a[3]={9,9,9},b[3]={9,9,9};
    hsl_to_rgb(a,src); rust_hsl_to_rgb(b,src);
    n++;
    if(memcmp(a,b,12)){bad++;if(bad<10)printf("MISMATCH h=%g s=%g l=%g C=%08x,%08x,%08x R=%08x,%08x,%08x\n",src[0],src[1],src[2],bits(a[0]),bits(a[1]),bits(a[2]),bits(b[0]),bits(b[1]),bits(b[2]));}
  }
  /* aliasing / in-place case */
  for(unsigned i=0;i<sizeof hs/4;i++){
    float a[3]={hs[i],0.6f,0.4f},b[3]={hs[i],0.6f,0.4f};
    hsl_to_rgb(a,a); rust_hsl_to_rgb(b,b); n++;
    if(memcmp(a,b,12)){bad++;printf("ALIAS MISMATCH h=%g\n",hs[i]);}
  }
  printf("cases=%ld mismatches=%ld\n",n,bad);
  return bad!=0;
}
