#include <stdio.h>
#include <stdlib.h>
#include <dlfcn.h>
typedef struct { unsigned char R,G,B; } rgb;
typedef float (*fn)(rgb, rgb);
int main(int argc, char**argv){
    void*h=dlopen(argv[1],RTLD_NOW); if(!h){fprintf(stderr,"%s\n",dlerror());return 1;}
    fn f=(fn)dlsym(h,"contrast_ratio"); if(!f){fprintf(stderr,"no sym\n");return 1;}
    unsigned s=12345;
    for(int i=0;i<200000;i++){
        rgb a,b;
        s=s*1103515245u+12345u; a.R=s>>16; s=s*1103515245u+12345u; a.G=s>>16;
        s=s*1103515245u+12345u; a.B=s>>16; s=s*1103515245u+12345u; b.R=s>>16;
        s=s*1103515245u+12345u; b.G=s>>16; s=s*1103515245u+12345u; b.B=s>>16;
        if(i<64){ a.R=a.G=a.B=(i%2)?0:255; b.R=b.G=b.B=(i%4<2)?0:255; }
        float v=f(a,b);
        unsigned bits; __builtin_memcpy(&bits,&v,4);
        printf("%02x%02x%02x %02x%02x%02x %08x\n",a.R,a.G,a.B,b.R,b.G,b.B,bits);
    }
    return 0;
}
EOF
