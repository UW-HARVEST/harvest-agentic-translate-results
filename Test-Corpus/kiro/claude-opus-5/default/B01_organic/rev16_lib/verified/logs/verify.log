# (test fn name, expected call count)
counts = {
 'configs_row01_exhaustive_low_half': '65_536',
 'configs_row02_exhaustive_low_half_high_saturated': '65_536',
 'configs_row03_randomized_full_domain': '2_000_000',
 'configs_row04_randomized_half_cross_product': '400_000',
 'configs_row05_single_bit_set': '32',
