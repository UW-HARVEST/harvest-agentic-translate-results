[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m     Path::new(env!("CARGO_MANIFEST_DIR"))
[0m[49m[38;5;10m+     19[0m:[38;5;10m[49m         .parent()
[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m         .expect("crate dir has a parent")
