 'phase_c_exhaustive_upper_half_discard': '65_536',
}
lines = s.split('\n')
out=[]
i=0
while i < len(lines):
    out.append(lines[i])
    m = re.match(r'fn (\w+)\(\) \{', lines[i])
    if m and m.group(1) in counts:
        name=m.group(1)
        # find matching closing brace at column 0
        j=i+1
        while lines[j] != '}':
            out.append(lines[j]); j+=1
        out.append('    p.expect_calls(%s);' % counts[name])
        out.append('}')
        i=j+1
        continue
    i+=1
open(p,'w').write('\n'.join(out))
print("patched")
EOF
