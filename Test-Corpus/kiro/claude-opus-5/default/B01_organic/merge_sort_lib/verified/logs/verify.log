[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m             rust_byte_count(s),
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m             "memcpy byte-count mismatch for size={s}"
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m 
