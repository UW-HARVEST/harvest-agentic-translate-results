[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m // expression is `SPRITE_SIZE.wrapping_mul(size as usize)`; this test asserts it
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m // equals the C codegen `(size_t)(int64_t)size * 16` for the whole interesting
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m // range of negative and positive sizes.
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m fn err_11_negative_size_byte_count_matches() {
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m     /// Exactly what `cltq; shl $0x4` produces.
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m     fn c_byte_count(size: i32) -> usize {
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m         ((size as i64 as u64).wrapping_mul(16)) as usize
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m     /// Exactly what `translation/src/lib.rs` computes.
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m     fn rust_byte_count(size: i32) -> usize {
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m         16usize.wrapping_mul(size as usize)
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m     let mut sizes: Vec<i32> = vec![
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m         i32::MIN,
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m         i32::MIN + 1,
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m         -1_000_000,
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m         -65537,
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m         -65536,
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m         -257,
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m         -256,
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m         -2,
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m         -1,
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m         0,
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m         1,
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m         2,
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m         255,
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m         256,
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m         65535,
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m         65536,
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m         i32::MAX - 1,
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m         i32::MAX,
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m     let mut rng = Rng::new(RNG_SEED ^ 0xEB);
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m     for _ in 0..2000 {
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m         sizes.push(rng.next_i32());
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m 
