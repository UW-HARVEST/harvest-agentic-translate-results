- SPX_SHA256_BLOCK_BYTES = 64
- SPX_SHA256_OUTPUT_BYTES = 32
- SPX_SHA512_BLOCK_BYTES = 128
- SPX_SHA512_OUTPUT_BYTES = 64
- SPX_SHA256_ADDR_BYTES = 22
- SPX_SHA512: bool = true if N >= 24 (i.e., 192s/192f/256s/256f), false for 128s/128f

