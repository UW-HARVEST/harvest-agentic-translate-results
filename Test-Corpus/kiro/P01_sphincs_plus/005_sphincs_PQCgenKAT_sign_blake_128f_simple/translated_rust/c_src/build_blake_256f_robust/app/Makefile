# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /local/home/scheschb/reserach/TRACTOR/harvest-agentic/results/P01_sphincs_plus/005_sphincs_PQCgenKAT_sign_blake_128f_simple/translated_rust/c_src/build_blake_256f_robust && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

