            br_aes_ct64_bitslice_sbox(&mut q);
            shift_rows(&mut q);
            mix_columns(&mut q);
            for k in 0..8 { q[k] ^= ctx.tweaked512_rc64[2 * i + j][k]; }
        }
        for j in 0..8 {
            let t = q[j];
