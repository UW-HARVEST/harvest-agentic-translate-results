de_ptr;\n        (node.child_count, node.child_ids)\n    };\n    let mut count = 0;\n    for i in 0..child_count as usize {\n        count += 1;\n        count += tree_count_descendants(tree, child_ids[i]);\n    }\n    count\n}\n\npub fn tree_find_path(\n    tree: &Tree,\n    id: TreeId,\n    path: &mut [TreeId],\n    max_length: i32,\n) -> i32 {\n    if !tree_contains(tree, id) {\n        return -1;\n    }\n    let mut temp_path = [0u64; 1000];\n    let mut length = 0usize;\n    let mut current_id = id;\n\n    while length < 1000 {\n        temp_path[length] = current_id;\n        length += 1;\n        if current_id == tree.root_id {\n            break;\n        }\n        let node_ptr = tree_get_node(tree, current_id);\n        if node_ptr.is_null() {\n            return -1;\n        }\n        current_id = unsafe { (*node_ptr).parent_id };\n    }\n\n    let mut out_len = length;\n    if out_len > max_length as usize {\n        out_len = max_length as usize;\n    }\n\n    for i in 0..out_len {\n        path[i] = temp_path[length - 1 - i];\n    }\n\n    out_len as i32\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2086,"cache_read_input_tokens":31741,"cache_creation":{"ephemeral_5m_input_tokens":2086,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"3afccd82-c759-4f49-8bb6-a51d6ab3e3b8","uuid":"ec47b769-34f5-48f1-9757-0624749baa24"}
