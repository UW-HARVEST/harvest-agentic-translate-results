rent_id);\n178\t    if (parent) {\n179\t        for (int i = 0; i < parent->child_count; i++) {\n180\t            if (parent->child_ids[i] == id) {\n181\t                // Shift remaining children\n182\t                for (int j = i; j < parent->child_count - 1; j++) {\n183\t                    parent->child_ids[j] = parent->child_ids[j + 1];\n184\t                }\n185\t                parent->child_count--;\n186\t                break;\n187\t            }\n188\t        }\n189\t    }\n190\t    \n191\t    // Remove this node and all descendants\n192\t    tree_remove_subtree(tree, id);\n193\t    \n194\t    return 0;\n195\t}\n196\t\n197\ttree_node_t* tree_get_node(tree_t *tree, tree_id_t id) {\n198\t    if (!tree) {\n199\t        return NULL;\n200\t    }\n201\t    \n202\t    return (tree_node_t *)hashmap_get(tree->node_map, id);\n203\t}\n204\t\n205\tint tree_contains(tree_t *tree, tree_id_t id) {\n206\t    return tree_get_node(tree, id) != NULL;\n207\t}\n208\t\n209\tsize_t tree_size(tree_t *tree) {\n210\t    return tree ? tree->node_count : 0;\n211\t}\n212\t\n213\tstatic void tree_print_helper(tree_t *tree, tree_id_t id, int depth) {\n214\t    tree_node_t *node = tree_get_node(tree, id);\n215\t    if (!node) {\n216\t        return;\n217\t    }\n218\t    \n219\t    // Print indentation\n220\t    for (int i = 0; i < depth; i++) {\n221\t        printf(\"  \");\n222\t    }\n223\t    \n224\t    printf(\"[%lu] %s\\n\", node->id, node->data);\n225\t    \n226\t    // Print children\n227\t    for (int i = 0; i < node->child_count; i++) {\n228\t        tree_print_helper(tree, node->child_ids[i], depth + 1);\n229\t    }\n230\t}\n231\t\n232\tvoid tree_print(tree_t *tree) {\n233\t    if (!tree || !tree->has_root) {\n234\t        printf(\"(empty tree)\\n\");\n235\t        return;\n236\t    }\n237\t    \n238\t    tree_print_helper(tree, tree->root_id, 0);\n239\t}\n240\t\n241\tint tree_get_depth(tree_t *tree, tree_id_t id) {\n242\t    if (!tree || !tree_contains(tree, id)) {\n243\