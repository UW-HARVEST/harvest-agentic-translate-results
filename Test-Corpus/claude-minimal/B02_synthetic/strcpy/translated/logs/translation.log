scanf(\"%d\", &operation) != 1) {\n46\t        fprintf(stderr, \"Error reading operation\\n\");\n47\t        return 1;\n48\t    }\n49\t    \n50\t    /* Read flags */\n51\t    if (scanf(\"%u\", &flags) != 1) {\n52\t        fprintf(stderr, \"Error reading flags\\n\");\n53\t        return 1;\n54\t    }\n55\t    \n56\t    /* Read input length */\n57\t    if (scanf(\"%zu\", &input_len) != 1) {\n58\t        fprintf(stderr, \"Error reading input length\\n\");\n59\t        return 1;\n60\t    }\n61\t    \n62\t    if (input_len > MAX_BUFFER_SIZE) {\n63\t        fprintf(stderr, \"Error: input length %zu exceeds maximum %d\\n\", \n64\t                input_len, MAX_BUFFER_SIZE);\n65\t        return 1;\n66\t    }\n67\t    \n68\t    /* Read input buffer data */\n69\t    for (size_t i = 0; i < input_len; i++) {\n70\t        unsigned int byte;\n71\t        if (scanf(\"%u\", &byte) != 1) {\n72\t            fprintf(stderr, \"Error reading input byte %zu\\n\", i);\n73\t            return 1;\n74\t        }\n75\t        input_buffer[i] = (char)byte;\n76\t    }\n77\t    \n78\t    /* Read reference length */\n79\t    if (scanf(\"%zu\", &ref_len) != 1) {\n80\t        fprintf(stderr, \"Error reading reference length\\n\");\n81\t        return 1;\n82\t    }\n83\t    \n84\t    if (ref_len > MAX_BUFFER_SIZE) {\n85\t        fprintf(stderr, \"Error: reference length %zu exceeds maximum %d\\n\", \n86\t                ref_len, MAX_BUFFER_SIZE);\n87\t        return 1;\n88\t    }\n89\t    \n90\t    /* Read reference buffer data */\n91\t    for (size_t i = 0; i < ref_len; i++) {\n92\t        unsigned int byte;\n93\t        if (scanf(\"%u\", &byte) != 1) {\n94\t            fprintf(stderr, \"Error reading reference byte %zu\\n\", i);\n95\t            return 1;\n96\t        }\n97\t        ref_buffer[i] = (char)byte;\n98\t    }\n99\t    \n100\t    /* Call the library function */\n101\t    int result = process_strings(input_buffer, input_len, \n102\t                                 ref_buffer, ref_len, \n