{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_kp252xzpvmybmqz35ivvfclnmvwf27luknu7rx46xpl7qcgrmnza","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01FEs4Xha3XwY8dTbNPqxWT6","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-translate-ZguS92/translated_rust/src/lib.rs","content":"use std::os::raw::c_float;\n\n/// Converts an HSV color to RGB.\n///\n/// # Safety\n///\n/// `dest` must be a valid pointer to at least 3 writable `f32` values.\n/// `src` must be a valid pointer to at least 3 readable `f32` values.\n#[no_mangle]\npub unsafe extern \"C\" fn hsv_to_rgb(dest: *mut c_float, src: *const c_float) {\n    let mut h: f32 = *src.offset(0);\n    let s: f32 = *src.offset(1);\n    let v: f32 = *src.offset(2);\n\n    if s == 0.0 {\n        *dest.offset(0) = v;\n        *dest.offset(1) = v;\n        *dest.offset(2) = v;\n        return;\n    }\n\n    h /= 60.0_f32;\n    let i: i32 = h.floor() as i32;\n    let f: f32 = h - (i as f32);\n    let p: f32 = v * (1.0 - s);\n    let q: f32 = v * (1.0 - s * f);\n    let t: f32 = v * (1.0 - s * (1.0 - f));\n\n    let (r, g, b) = match i {\n        0 => (v, t, p),\n        1 => (q, v, p),\n        2 => (p, v, t),\n        3 => (p, q, v),\n        4 => (t, p, v),\n        _ => (v, p, q),\n    };\n\n    *dest.offset(0) = r;\n    *dest.offset(1) = g;\n    *dest.offset(2) = b;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":273,"cache_read_input_tokens":14653,"cache_creation":{"ephemeral_5m_input_tokens":273,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"376ff6e2-da26-4b9a-99a6-fcdd39d21eb8","uuid":"23adc797-4dfa-416f-9361-d5abe830874e"}
