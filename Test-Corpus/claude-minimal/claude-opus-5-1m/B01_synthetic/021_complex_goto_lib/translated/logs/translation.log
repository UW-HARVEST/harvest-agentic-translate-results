bel1\n            if !skip_label1 {\n                if x > 0 {\n                    println!(\"x\");\n                    x -= 1;\n                }\n            }\n            skip_label1 = false;\n\n            // label2\n            if y == 0 {\n                // Equivalent to `continue` in the outer while loop.\n                break;\n            }\n            println!(\"y\");\n            y -= 1;\n            if x < 3 {\n                // Equivalent to `goto label1`.\n                continue;\n            }\n            // Fall through to the bottom of the outer while body.\n            break;\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":263,"cache_read_input_tokens":15780,"cache_creation":{"ephemeral_5m_input_tokens":263,"ephemeral_1h_input_tokens":0},"output_tokens":41,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fa15444a-35cd-4315-87c7-f9b8aa50243c","uuid":"5f7dcf46-bda9-45c2-a213-c79082f44f58"}
