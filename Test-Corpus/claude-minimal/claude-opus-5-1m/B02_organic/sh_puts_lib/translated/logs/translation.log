n    // Step 5: dropping `strmap` here is the Rust equivalent of\n    // `shfree(strmap)`.\n}\n\n/// C-ABI shim so the public symbol matches the original library.\n#[no_mangle]\npub extern \"C\" fn sh_puts(num: c_int) {\n    sh_puts_impl(num);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
