\n\nfn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> bool {\n    let d0 = B.max.x < A.min.x;\n    let d1 = A.max.x < B.min.x;\n    let d2 = B.max.y < A.min.y;\n    let d3 = A.max.y < B.min.y;\n    !(d0 || d1 || d2 || d3)\n}\n\nfn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> bool {\n    let aa = A;\n    let bb = B;\n    let dist = unsafe {\n        c2GJK(\n            &aa as *const _ as *const c_void,\n            C2_TYPE::C2_TYPE_AABB,\n            None,\n            &bb as *const _ as *const c_void,\n            C2_TYPE::C2_TYPE_CAPSULE,\n            None,\n            None,\n            None,\n            true,\n            None,\n            None,\n        )\n    };\n    dist == 0.0\n}\n\nfn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> bool {\n    let aa = A;\n    let bb = B;\n    let dist = unsafe {\n        c2GJK(\n            &aa as *const _ as *const c_void,\n            C2_TYPE::C2_TYPE_CAPSULE,\n            None,\n            &bb as *const _ as *const c_void,\n            C2_TYPE::C2_TYPE_CAPSULE,\n            None,\n            None,\n            None,\n            true,\n            None,\n            None,\n        )\n    };\n    dist == 0.0\n}\n\nfn c2CircletoCircle(A: c2Circle, B: c2Circle) -> bool {\n    let c = c2Sub(B.p, A.p);\n    let d2 = c2Dot(c, c);\n    let mut r2 = A.r + B.r;\n    r2 *= r2;\n    d2 < r2\n}\n\nfn c2CircletoAABB(A: c2Circle, B: c2AABB) -> bool {\n    let l = c2Clampv(A.p, B.min, B.max);\n    let ab = c2Sub(A.p, l);\n    let d2 = c2Dot(ab, ab);\n    let r2 = A.r * A.r;\n    d2 < r2\n}\n\nfn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> bool {\n    let n = c2Sub(B.b, B.a);\n    let ap = c2Sub(A.p, B.a);\n    let da = c2Dot(ap, n);\n    let d2;\n    if da < 0.0 {\n        d2 = c2Dot(ap, ap);\n    } else {\n        let db = c2Dot(c2Sub(A.p, B.b), n);\n        if db < 0.0 {\n            let e = c2Sub(ap, c2Mulvs(n, da / c2Dot(n, n)));\n            d2 = c2Dot(e, e);\n        } else {\n            let bp = c2Sub(A.p, B.b);\n            d