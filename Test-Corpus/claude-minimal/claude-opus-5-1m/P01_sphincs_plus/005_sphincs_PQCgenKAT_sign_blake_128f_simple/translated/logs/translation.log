{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016JiPGJixrdeNZmzCdnGbMn","type":"tool_result","content":"1\t/* Based on the public domain implementation in\n2\t * crypto_hash/keccakc512/simple/ from http://bench.cr.yp.to/supercop.html\n3\t * by Ronny Van Keer\n4\t * and the public domain \"TweetFips202\" implementation\n5\t * from https://twitter.com/tweetfips202\n6\t * by Gilles Van Assche, Daniel J. Bernstein, and Peter Schwabe */\n7\t\n8\t#include <stddef.h>\n9\t#include <stdint.h>\n10\t\n11\t#include \"../include/fips202.h\"\n12\t\n13\t#define NROUNDS 24\n14\t#define ROL(a, offset) (((a) << (offset)) ^ ((a) >> (64 - (offset))))\n15\t\n16\t/*************************************************\n17\t * Name:        load64\n18\t *\n19\t * Description: Load 8 bytes into uint64_t in little-endian order\n20\t *\n21\t * Arguments:   - const uint8_t *x: pointer to input byte array\n22\t *\n23\t * Returns the loaded 64-bit unsigned integer\n24\t **************************************************/\n25\tstatic uint64_t load64(const uint8_t *x) {\n26\t    uint64_t r = 0;\n27\t    for (size_t i = 0; i < 8; ++i) {\n28\t        r |= (uint64_t)x[i] << 8 * i;\n29\t    }\n30\t\n31\t    return r;\n32\t}\n33\t\n34\t/*************************************************\n35\t * Name:        store64\n36\t *\n37\t * Description: Store a 64-bit integer to a byte array in little-endian order\n38\t *\n39\t * Arguments:   - uint8_t *x: pointer to the output byte array\n40\t *              - uint64_t u: input 64-bit unsigned integer\n41\t **************************************************/\n42\tstatic void store64(uint8_t *x, uint64_t u) {\n43\t    for (size_t i = 0; i < 8; ++i) {\n44\t        x[i] = (uint8_t) (u >> 8 * i);\n45\t    }\n46\t}\n47\t\n48\t/* Keccak round constants */\n49\tstatic const uint64_t KeccakF_RoundConstants[NROUNDS] = {\n50\t    0x0000000000000001ULL, 0x0000000000008082ULL,\n51\t    0x800000000000808aULL, 0x8000000080008000ULL,\n52\t    0x000000000000808bULL, 0x0000000080000001ULL,\n53\t    0x8000000080008081ULL, 0x8000000000008009ULL,\n54\t    0x000000000000008aULL, 0x0000000000000088ULL,\n55\t    0x0000000080008009ULL, 0x000000008000000aULL,\n56\t    0x000000008000808bULL, 0x800000000000008bULL,\n57\t    0x8000000000008089ULL, 0x8000000000008003ULL,\n58\t    0x8000000000008002ULL, 0x8000000000000080ULL,\n59\t    0x000000000000800aULL, 0x800000008000000aULL,\n60\t    0x8000000080008081ULL, 0x8000000000008080ULL,\n61\t    0x0000000080000001ULL, 0x8000000080008008ULL\n62\t};\n63\t\n64\t/*************************************************\n65\t * Name:        KeccakF1600_StatePermute\n66\t *\n67\t * Description: The Keccak F1600 Permutation\n68\t *\n69\t * Arguments:   - uint64_t *state: pointer to input/output Keccak state\n70\t **************************************************/\n71\tstatic void KeccakF1600_StatePermute(uint64_t *state) {\n72\t    int round;\n73\t\n74\t    uint64_t Aba, Abe, Abi, Abo, Abu;\n75\t    uint64_t Aga, Age, Agi, Ago, Agu;\n76\t    uint64_t Aka, Ake, Aki, Ako, Aku;\n77\t    uint64_t Ama, Ame, Ami, Amo, Amu;\n78\t    uint64_t Asa, Ase, Asi, Aso, Asu;\n79\t    uint64_t BCa, BCe, BCi, BCo, BCu;\n80\t    uint64_t Da, De, Di, Do, Du;\n81\t    uint64_t Eba, Ebe, Ebi, Ebo, Ebu;\n82\t    uint64_t Ega, Ege, Egi, Ego, Egu;\n83\t    uint64_t Eka, Eke, Eki, Eko, Eku;\n84\t    uint64_t Ema, Eme, Emi, Emo, Emu;\n85\t    uint64_t Esa, Ese, Esi, Eso, Esu;\n86\t\n87\t    // copyFromState(A, state)\n88\t    Aba = state[0];\n89\t    Abe = state[1];\n90\t    Abi = state[2];\n91\t    Abo = state[3];\n92\t    Abu = state[4];\n93\t    Aga = state[5];\n94\t    Age = state[6];\n95\t    Agi = state[7];\n96\t    Ago = state[8];\n97\t    Agu = state[9];\n98\t    Aka = state[10];\n99\t    Ake = state[11];\n100\t    Aki = state[12];\n101\t    Ako = state[13];\n102\t    Aku = state[14];\n103\t    Ama = state[15];\n104\t    Ame = state[16];\n105\t    Ami = state[17];\n106\t    Amo = state[18];\n107\t    Amu = state[19];\n108\t    Asa = state[20];\n109\t    Ase = state[21];\n110\t    Asi = state[22];\n111\t    Aso = state[23];\n112\t    Asu = state[24];\n113\t\n114\t    for (round = 0; round < NROUNDS; round += 2) {\n115\t        //    prepareTheta\n116\t        BCa = Aba ^ Aga ^ Aka ^ Ama ^ Asa;\n117\t        BCe = Abe ^ Age ^ Ake ^ Ame ^ Ase;\n118\t        BCi = Abi ^ Agi ^ Aki ^ Ami ^ Asi;\n119\t        BCo = Abo ^ Ago ^ Ako ^ Amo ^ Aso;\n120\t        BCu = Abu ^ Agu ^ Aku ^ Amu ^ Asu;\n121\t\n122\t        // thetaRhoPiChiIotaPrepareTheta(round  , A, E)\n123\t        Da = BCu ^ ROL(BCe, 1);\n124\t        De = BCa ^ ROL(BCi, 1);\n125\t        Di = BCe ^ ROL(BCo, 1);\n126\t        Do = BCi ^ ROL(BCu, 1);\n127\t        Du = BCo ^ ROL(BCa, 1);\n128\t\n129\t        Aba ^= Da;\n130\t        BCa = Aba;\n131\t        Age ^= De;\n132\t        BCe = ROL(Age, 44);\n133\t        Aki ^= Di;\n134\t        BCi = ROL(Aki, 43);\n135\t        Amo ^= Do;\n136\t        BCo = ROL(Amo, 21);\n137\t        Asu ^= Du;\n138\t        BCu = ROL(Asu, 14);\n139\t        Eba = BCa ^ ((~BCe) & BCi);\n140\t        Eba ^= KeccakF_RoundConstants[round];\n141\t        Ebe = BCe ^ ((~BCi) & BCo);\n142\t        Ebi = BCi ^ ((~BCo) & BCu);\n143\t        Ebo = BCo ^ ((~BCu) & BCa);\n144\t        Ebu = BCu ^ ((~BCa) & BCe);\n145\t\n146\t        Abo ^= Do;\n147\t        BCa = ROL(Abo, 28);\n148\t        Agu ^= Du;\n149\t        BCe = ROL(Agu, 20);\n150\t        Aka ^= Da;\n151\t        BCi = ROL(Aka, 3);\n152\t        Ame ^= De;\n153\t        BCo = ROL(Ame, 45);\n154\t        Asi ^= Di;\n155\t        BCu = ROL(Asi, 61);\n156\t        Ega = BCa ^ ((~BCe) & BCi);\n157\t        Ege = BCe ^ ((~BCi) & BCo);\n158\t        Egi = BCi ^ ((~BCo) & BCu);\n159\t        Ego = BCo ^ ((~BCu) & BCa);\n160\t        Egu = BCu ^ ((~BCa) & BCe);\n161\t\n162\t        Abe ^= De;\n163\t        BCa = ROL(Abe, 1);\n164\t        Agi ^= Di;\n165\t        BCe = ROL(Agi, 6);\n166\t        Ako ^= Do;\n167\t        BCi = ROL(Ako, 25);\n168\t        Amu ^= Du;\n169\t        BCo = ROL(Amu, 8);\n170\t        Asa ^= Da;\n171\t        BCu = ROL(Asa, 18);\n172\t        Eka = BCa ^ ((~BCe) & BCi);\n173\t        Eke = BCe ^ ((~BCi) & BCo);\n174\t        Eki = BCi ^ ((~BCo) & BCu);\n175\t        Eko = BCo ^ ((~BCu) & BCa);\n176\t        Eku = BCu ^ ((~BCa) & BCe);\n177\t\n178\t        Abu ^= Du;\n179\t        BCa = ROL(Abu, 27);\n180\t        Aga ^= Da;\n181\t        BCe = ROL(Aga, 36);\n182\t        Ake ^= De;\n183\t        BCi = ROL(Ake, 10);\n184\t        Ami ^= Di;\n185\t        BCo = ROL(Ami, 15);\n186\t        Aso ^= Do;\n187\t        BCu = ROL(Aso, 56);\n188\t        Ema = BCa ^ ((~BCe) & BCi);\n189\t        Eme = BCe ^ ((~BCi) & BCo);\n190\t        Emi = BCi ^ ((~BCo) & BCu);\n191\t        Emo = BCo ^ ((~BCu) & BCa);\n192\t        Emu = BCu ^ ((~BCa) & BCe);\n193\t\n194\t        Abi ^= Di;\n195\t        BCa = ROL(Abi, 62);\n196\t        Ago ^= Do;\n197\t        BCe = ROL(Ago, 55);\n198\t        Aku ^= Du;\n199\t        BCi = ROL(Aku, 39);\n200\t        Ama ^= Da;\n201\t        BCo = ROL(Ama, 41);\n202\t        Ase ^= De;\n203\t        BCu = ROL(Ase, 2);\n204\t        Esa = BCa ^ ((~BCe) & BCi);\n205\t        Ese = BCe ^ ((~BCi) & BCo);\n206\t        Esi = BCi ^ ((~BCo) & BCu);\n207\t        Eso = BCo ^ ((~BCu) & BCa);\n208\t        Esu = BCu ^ ((~BCa) & BCe);\n209\t\n210\t        //    prepareTheta\n211\t        BCa = Eba ^ Ega ^ Eka ^ Ema ^ Esa;\n212\t        BCe = Ebe ^ Ege ^ Eke ^ Eme ^ Ese;\n213\t        BCi = Ebi ^ Egi ^ Eki ^ Emi ^ Esi;\n214\t        BCo = Ebo ^ Ego ^ Eko ^ Emo ^ Eso;\n215\t        BCu = Ebu ^ Egu ^ Eku ^ Emu ^ Esu;\n216\t\n217\t        // thetaRhoPiChiIotaPrepareTheta(round+1, E, A)\n218\t        Da = BCu ^ ROL(BCe, 1);\n219\t        De = BCa ^ ROL(BCi, 1);\n220\t        Di = BCe ^ ROL(BCo, 1);\n221\t        Do = BCi ^ ROL(BCu, 1);\n222\t        Du = BCo ^ ROL(BCa, 1);\n223\t\n224\t        Eba ^= Da;\n225\t        BCa = Eba;\n226\t        Ege ^= De;\n227\t        BCe = ROL(Ege, 44);\n228\t        Eki ^= Di;\n229\t        BCi = ROL(Eki, 43);\n230\t        Emo ^= Do;\n231\t        BCo = ROL(Emo, 21);\n232\t        Esu ^= Du;\n233\t        BCu = ROL(Esu, 14);\n234\t        Aba = BCa ^ ((~BCe) & BCi);\n235\t        Aba ^= KeccakF_RoundConstants[round + 1];\n236\t        Abe = BCe ^ ((~BCi) & BCo);\n237\t        Abi = BCi ^ ((~BCo) & BCu);\n238\t        Abo = BCo ^ ((~BCu) & BCa);\n239\t        Abu = BCu ^ ((~BCa) & BCe);\n240\t\n241\t        Ebo ^= Do;\n242\t        BCa = ROL(Ebo, 28);\n243\t        Egu ^= Du;\n244\t        BCe = ROL(Egu, 20);\n245\t        Eka ^= Da;\n246\t        BCi = ROL(Eka, 3);\n247\t        Eme ^= De;\n248\t        BCo = ROL(Eme, 45);\n249\t        Esi ^= Di;\n250\t        BCu = ROL(Esi, 61);\n251\t        Aga = BCa ^ ((~BCe) & BCi);\n252\t        Age = BCe ^ ((~BCi) & BCo);\n253\t        Agi = BCi ^ ((~BCo) & BCu);\n254\t        Ago = BCo ^ ((~BCu) & BCa);\n255\t        Agu = BCu ^ ((~BCa) & BCe);\n256\t\n257\t        Ebe ^= De;\n258\t        BCa = ROL(Ebe, 1);\n259\t        Egi ^= Di;\n260\t        BCe = ROL(Egi, 6);\n261\t        Eko ^= Do;\n262\t        BCi = ROL(Eko, 25);\n263\t        Emu ^= Du;\n264\t        BCo = ROL(Emu, 8);\n265\t        Esa ^= Da;\n266\t        BCu = ROL(Esa, 18);\n267\t        Aka = BCa ^ ((~BCe) & BCi);\n268\t        Ake = BCe ^ ((~BCi) & BCo);\n269\t        Aki = BCi ^ ((~BCo) & BCu);\n270\t        Ako = BCo ^ ((~BCu) & BCa);\n271\t        Aku = BCu ^ ((~BCa) & BCe);\n272\t\n273\t        Ebu ^= Du;\n274\t        BCa = ROL(Ebu, 27);\n275\t        Ega ^= Da;\n276\t        BCe = ROL(Ega, 36);\n277\t        Eke ^= De;\n278\t        BCi = ROL(Eke, 10);\n279\t        Emi ^= Di;\n280\t        BCo = ROL(Emi, 15);\n281\t        Eso ^= Do;\n282\t        BCu = ROL(Eso, 56);\n283\t        Ama = BCa ^ ((~BCe) & BCi);\n284\t        Ame = BCe ^ ((~BCi) & BCo);\n285\t        Ami = BCi ^ ((~BCo) & BCu);\n286\t        Amo = BCo ^ ((~BCu) & BCa);\n287\t        Amu = BCu ^ ((~BCa) & BCe);\n288\t\n289\t        Ebi ^= Di;\n290\t        BCa = ROL(Ebi, 62);\n291\t        Ego ^= Do;\n292\t        BCe = ROL(Ego, 55);\n293\t        Eku ^= Du;\n294\t        BCi = ROL(Eku, 39);\n295\t        Ema ^= Da;\n296\t        BCo = ROL(Ema, 41);\n297\t        Ese ^= De;\n298\t        BCu = ROL(Ese, 2);\n299\t        Asa = BCa ^ ((~BCe) & BCi);\n300\t        Ase = BCe ^ ((~BCi) & BCo);\n301\t        Asi = BCi ^ ((~BCo) & BCu);\n302\t        Aso = BCo ^ ((~BCu) & BCa);\n303\t        Asu = BCu ^ ((~BCa) & BCe);\n304\t    }\n305\t\n306\t    // copyToState(state, A)\n307\t    state[0] = Aba;\n308\t    state[1] = Abe;\n309\t    state[2] = Abi;\n310\t    state[3] = Abo;\n311\t    state[4] = Abu;\n312\t    state[5] = Aga;\n313\t    state[6] = Age;\n314\t    state[7] = Agi;\n315\t    state[8] = Ago;\n316\t    state[9] = Agu;\n317\t    state[10] = Aka;\n318\t    state[11] = Ake;\n319\t    state[12] = Aki;\n320\t    state[13] = Ako;\n321\t    state[14] = Aku;\n322\t    state[15] = Ama;\n323\t    state[16] = Ame;\n324\t    state[17] = Ami;\n325\t    state[18] = Amo;\n326\t    state[19] = Amu;\n327\t    state[20] = Asa;\n328\t    state[21] = Ase;\n329\t    state[22] = Asi;\n330\t    state[23] = Aso;\n331\t    state[24] = Asu;\n332\t}\n333\t\n334\t/*************************************************\n335\t * Name:        keccak_absorb\n336\t *\n337\t * Description: Absorb step of Keccak;\n338\t *              non-incremental, starts by zeroeing the state.\n339\t *\n340\t * Arguments:   - uint64_t *s: pointer to (uninitialized) output Keccak state\n341\t *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n342\t *              - const uint8_t *m: pointer to input to be absorbed into s\n343\t *              - size_t mlen: length of input in bytes\n344\t *              - uint8_t p: domain-separation byte for different\n345\t *                                 Keccak-derived functions\n346\t **************************************************/\n347\tstatic void keccak_absorb(uint64_t *s, uint32_t r, const uint8_t *m,\n348\t                          size_t mlen, uint8_t p) {\n349\t    size_t i;\n350\t    uint8_t t[200];\n351\t\n352\t    /* Zero state */\n353\t    for (i = 0; i < 25; ++i) {\n354\t        s[i] = 0;\n355\t    }\n356\t\n357\t    while (mlen >= r) {\n358\t        for (i = 0; i < r / 8; ++i) {\n359\t            s[i] ^= load64(m + 8 * i);\n360\t        }\n361\t\n362\t        KeccakF1600_StatePermute(s);\n363\t        mlen -= r;\n364\t        m += r;\n365\t    }\n366\t\n367\t    for (i = 0; i < r; ++i) {\n368\t        t[i] = 0;\n369\t    }\n370\t    for (i = 0; i < mlen; ++i) {\n371\t        t[i] = m[i];\n372\t    }\n373\t    t[i] = p;\n374\t    t[r - 1] |= 128;\n375\t    for (i = 0; i < r / 8; ++i) {\n376\t        s[i] ^= load64(t + 8 * i);\n377\t    }\n378\t}\n379\t\n380\t/*************************************************\n381\t * Name:        keccak_squeezeblocks\n382\t *\n383\t * Description: Squeeze step of Keccak. Squeezes full blocks of r bytes each.\n384\t *              Modifies the state. Can be called multiple times to keep\n385\t *              squeezing, i.e., is incremental.\n386\t *\n387\t * Arguments:   - uint8_t *h: pointer to output blocks\n388\t *              - size_t nblocks: number of blocks to be\n389\t *                                                squeezed (written to h)\n390\t *              - uint64_t *s: pointer to input/output Keccak state\n391\t *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n392\t **************************************************/\n393\tstatic void keccak_squeezeblocks(uint8_t *h, size_t nblocks,\n394\t                                 uint64_t *s, uint32_t r) {\n395\t    while (nblocks > 0) {\n396\t        KeccakF1600_StatePermute(s);\n397\t        for (size_t i = 0; i < (r >> 3); i++) {\n398\t            store64(h + 8 * i, s[i]);\n399\t        }\n400\t        h += r;\n401\t        nblocks--;\n402\t    }\n403\t}\n404\t\n405\t/*************************************************\n406\t * Name:        keccak_inc_init\n407\t *\n408\t * Description: Initializes the incremental Keccak state to zero.\n409\t *\n410\t * Arguments:   - uint64_t *s_inc: pointer to input/output incremental state\n411\t *                First 25 values represent Keccak state.\n412\t *                26th value represents either the number of absorbed bytes\n413\t *                that have not been permuted, or not-yet-squeezed bytes.\n414\t **************************************************/\n415\tstatic void keccak_inc_init(uint64_t *s_inc) {\n416\t    size_t i;\n417\t\n418\t    for (i = 0; i < 25; ++i) {\n419\t        s_inc[i] = 0;\n420\t    }\n421\t    s_inc[25] = 0;\n422\t}\n423\t\n424\t/*************************************************\n425\t * Name:        keccak_inc_absorb\n426\t *\n427\t * Description: Incremental keccak absorb\n428\t *              Preceded by keccak_inc_init, succeeded by keccak_inc_finalize\n429\t *\n430\t * Arguments:   - uint64_t *s_inc: pointer to input/output incremental state\n431\t *                First 25 values represent Keccak state.\n432\t *                26th value represents either the number of absorbed bytes\n433\t *                that have not been permuted, or not-yet-squeezed bytes.\n434\t *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n435\t *              - const uint8_t *m: pointer to input to be absorbed into s\n436\t *              - size_t mlen: length of input in bytes\n437\t **************************************************/\n438\tstatic void keccak_inc_absorb(uint64_t *s_inc, uint32_t r, const uint8_t *m,\n439\t                              size_t mlen) {\n440\t    size_t i;\n441\t\n442\t    /* Recall that s_inc[25] is the non-absorbed bytes xored into the state */\n443\t    while (mlen + s_inc[25] >= r) {\n444\t        for (i = 0; i < r - s_inc[25]; i++) {\n445\t            /* Take the i'th byte from message\n446\t               xor with the s_inc[25] + i'th byte of the state; little-endian */\n447\t            s_inc[(s_inc[25] + i) >> 3] ^= (uint64_t)m[i] << (8 * ((s_inc[25] + i) & 0x07));\n448\t        }\n449\t        mlen -= (size_t)(r - s_inc[25]);\n450\t        m += r - s_inc[25];\n451\t        s_inc[25] = 0;\n452\t\n453\t        KeccakF1600_StatePermute(s_inc);\n454\t    }\n455\t\n456\t    for (i = 0; i < mlen; i++) {\n457\t        s_inc[(s_inc[25] + i) >> 3] ^= (uint64_t)m[i] << (8 * ((s_inc[25] + i) & 0x07));\n458\t    }\n459\t    s_inc[25] += mlen;\n460\t}\n461\t\n462\t/*************************************************\n463\t * Name:        keccak_inc_finalize\n464\t *\n465\t * Description: Finalizes Keccak absorb phase, prepares for squeezing\n466\t *\n467\t * Arguments:   - uint64_t *s_inc: pointer to input/output incremental state\n468\t *                First 25 values represent Keccak state.\n469\t *                26th value represents either the number of absorbed bytes\n470\t *                that have not been permuted, or not-yet-squeezed bytes.\n471\t *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n472\t *              - uint8_t p: domain-separation byte for different\n473\t *                                 Keccak-derived functions\n474\t **************************************************/\n475\tstatic void keccak_inc_finalize(uint64_t *s_inc, uint32_t r, uint8_t p) {\n476\t    /* After keccak_inc_absorb, we are guaranteed that s_inc[25] < r,\n477\t       so we can always use one more byte for p in the current state. */\n478\t    s_inc[s_inc[25] >> 3] ^= (uint64_t)p << (8 * (s_inc[25] & 0x07));\n479\t    s_inc[(r - 1) >> 3] ^= (uint64_t)128 << (8 * ((r - 1) & 0x07));\n480\t    s_inc[25] = 0;\n481\t}\n482\t\n483\t/*************************************************\n484\t * Name:        keccak_inc_squeeze\n485\t *\n486\t * Description: Incremental Keccak squeeze; can be called on byte-level\n487\t *\n488\t * Arguments:   - uint8_t *h: pointer to output bytes\n489\t *              - size_t outlen: number of bytes to be squeezed\n490\t *              - uint64_t *s_inc: pointer to input/output incremental state\n491\t *                First 25 values represent Keccak state.\n492\t *                26th value represents either the number of absorbed bytes\n493\t *                that have not been permuted, or not-yet-squeezed bytes.\n494\t *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n495\t **************************************************/\n496\tstatic void keccak_inc_squeeze(uint8_t *h, size_t outlen,\n497\t                               uint64_t *s_inc, uint32_t r) {\n498\t    size_t i;\n499\t\n500\t    /* First consume any bytes we still have sitting around */\n501\t    for (i = 0; i < outlen && i < s_inc[25]; i++) {\n502\t        /* There are s_inc[25] bytes left, so r - s_inc[25] is the first\n503\t           available byte. We consume from there, i.e., up to r. */\n504\t        h[i] = (uint8_t)(s_inc[(r - s_inc[25] + i) >> 3] >> (8 * ((r - s_inc[25] + i) & 0x07)));\n505\t    }\n506\t    h += i;\n507\t    outlen -= i;\n508\t    s_inc[25] -= i;\n509\t\n510\t    /* Then squeeze the remaining necessary blocks */\n511\t    while (outlen > 0) {\n512\t        KeccakF1600_StatePermute(s_inc);\n513\t\n514\t        for (i = 0; i < outlen && i < r; i++) {\n515\t            h[i] = (uint8_t)(s_inc[i >> 3] >> (8 * (i & 0x07)));\n516\t        }\n517\t        h += i;\n518\t        outlen -= i;\n519\t        s_inc[25] = r - i;\n520\t    }\n521\t}\n522\t\n523\tvoid shake256_inc_init(uint64_t *s_inc) {\n524\t    keccak_inc_init(s_inc);\n525\t}\n526\t\n527\tvoid shake256_inc_absorb(uint64_t *s_inc, const uint8_t *input, size_t inlen) {\n528\t    keccak_inc_absorb(s_inc, SHAKE256_RATE, input, inlen);\n529\t}\n530\t\n531\tvoid shake256_inc_finalize(uint64_t *s_inc) {\n532\t    keccak_inc_finalize(s_inc, SHAKE256_RATE, 0x1F);\n533\t}\n534\t\n535\tvoid shake256_inc_squeeze(uint8_t *output, size_t outlen, uint64_t *s_inc) {\n536\t    keccak_inc_squeeze(output, outlen, s_inc, SHAKE256_RATE);\n537\t}\n538\t\n539\t/*************************************************\n540\t * Name:        shake256_absorb\n541\t *\n542\t * Description: Absorb step of the SHAKE256 XOF.\n543\t *              non-incremental, starts by zeroeing the state.\n544\t *\n545\t * Arguments:   - uint64_t *s: pointer to (uninitialized) output Keccak state\n546\t *              - const uint8_t *input: pointer to input to be absorbed\n547\t *                                            into s\n548\t *              - size_t inlen: length of input in bytes\n549\t **************************************************/\n550\tvoid shake256_absorb(uint64_t *s, const uint8_t *input, size_t inlen) {\n551\t    keccak_absorb(s, SHAKE256_RATE, input, inlen, 0x1F);\n552\t}\n553\t\n554\t/*************************************************\n555\t * Name:        shake256_squeezeblocks\n556\t *\n557\t * Description: Squeeze step of SHAKE256 XOF. Squeezes full blocks of\n558\t *              SHAKE256_RATE bytes each. Modifies the state. Can be called\n559\t *              multiple times to keep squeezing, i.e., is incremental.\n560\t *\n561\t * Arguments:   - uint8_t *output: pointer to output blocks\n562\t *              - size_t nblocks: number of blocks to be squeezed\n563\t *                                (written to output)\n564\t *              - uint64_t *s: pointer to input/output Keccak state\n565\t **************************************************/\n566\tvoid shake256_squeezeblocks(uint8_t *output, size_t nblocks, uint64_t *s) {\n567\t    keccak_squeezeblocks(output, nblocks, s, SHAKE256_RATE);\n568\t}\n569\t\n570\t/*************************************************\n571\t * Name:        shake256\n572\t *\n573\t * Description: SHAKE256 XOF with non-incremental API\n574\t *\n575\t * Arguments:   - uint8_t *output: pointer to output\n576\t *              - size_t outlen: requested output length in bytes\n577\t *              - const uint8_t *input: pointer to input\n578\t *              - size_t inlen: length of input in bytes\n579\t **************************************************/\n580\tvoid shake256(uint8_t *output, size_t outlen,\n581\t              const uint8_t *input, size_t inlen) {\n582\t    size_t nblocks = outlen / SHAKE256_RATE;\n583\t    uint8_t t[SHAKE256_RATE];\n584\t    uint64_t s[25];\n585\t\n586\t    shake256_absorb(s, input, inlen);\n587\t    shake256_squeezeblocks(output, nblocks, s);\n588\t\n589\t    output += nblocks * SHAKE256_RATE;\n590\t    outlen -= nblocks * SHAKE256_RATE;\n591\t\n592\t    if (outlen) {\n593\t        shake256_squeezeblocks(t, 1, s);\n594\t        for (size_t i = 0; i < outlen; ++i) {\n595\t            output[i] = t[i];\n596\t        }\n597\t    }\n598\t}\n599\t"}]},"parent_tool_use_id":null,"session_id":"98245e70-06fe-4bf3-abe8-2ed274597074","uuid":"c7ad8efd-6672-4324-85ef-cc06adbac1a9","timestamp":"2026-06-01T19:05:12.849Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-translate-cmgRjw/translated_rust/c_src/lib/shake/src/fips202.c","content":"/* Based on the public domain implementation in\n * crypto_hash/keccakc512/simple/ from http://bench.cr.yp.to/supercop.html\n * by Ronny Van Keer\n * and the public domain \"TweetFips202\" implementation\n * from https://twitter.com/tweetfips202\n * by Gilles Van Assche, Daniel J. Bernstein, and Peter Schwabe */\n\n#include <stddef.h>\n#include <stdint.h>\n\n#include \"../include/fips202.h\"\n\n#define NROUNDS 24\n#define ROL(a, offset) (((a) << (offset)) ^ ((a) >> (64 - (offset))))\n\n/*************************************************\n * Name:        load64\n *\n * Description: Load 8 bytes into uint64_t in little-endian order\n *\n * Arguments:   - const uint8_t *x: pointer to input byte array\n *\n * Returns the loaded 64-bit unsigned integer\n **************************************************/\nstatic uint64_t load64(const uint8_t *x) {\n    uint64_t r = 0;\n    for (size_t i = 0; i < 8; ++i) {\n        r |= (uint64_t)x[i] << 8 * i;\n    }\n\n    return r;\n}\n\n/*************************************************\n * Name:        store64\n *\n * Description: Store a 64-bit integer to a byte array in little-endian order\n *\n * Arguments:   - uint8_t *x: pointer to the output byte array\n *              - uint64_t u: input 64-bit unsigned integer\n **************************************************/\nstatic void store64(uint8_t *x, uint64_t u) {\n    for (size_t i = 0; i < 8; ++i) {\n        x[i] = (uint8_t) (u >> 8 * i);\n    }\n}\n\n/* Keccak round constants */\nstatic const uint64_t KeccakF_RoundConstants[NROUNDS] = {\n    0x0000000000000001ULL, 0x0000000000008082ULL,\n    0x800000000000808aULL, 0x8000000080008000ULL,\n    0x000000000000808bULL, 0x0000000080000001ULL,\n    0x8000000080008081ULL, 0x8000000000008009ULL,\n    0x000000000000008aULL, 0x0000000000000088ULL,\n    0x0000000080008009ULL, 0x000000008000000aULL,\n    0x000000008000808bULL, 0x800000000000008bULL,\n    0x8000000000008089ULL, 0x8000000000008003ULL,\n    0x8000000000008002ULL, 0x8000000000000080ULL,\n    0x000000000000800aULL, 0x800000008000000aULL,\n    0x8000000080008081ULL, 0x8000000000008080ULL,\n    0x0000000080000001ULL, 0x8000000080008008ULL\n};\n\n/*************************************************\n * Name:        KeccakF1600_StatePermute\n *\n * Description: The Keccak F1600 Permutation\n *\n * Arguments:   - uint64_t *state: pointer to input/output Keccak state\n **************************************************/\nstatic void KeccakF1600_StatePermute(uint64_t *state) {\n    int round;\n\n    uint64_t Aba, Abe, Abi, Abo, Abu;\n    uint64_t Aga, Age, Agi, Ago, Agu;\n    uint64_t Aka, Ake, Aki, Ako, Aku;\n    uint64_t Ama, Ame, Ami, Amo, Amu;\n    uint64_t Asa, Ase, Asi, Aso, Asu;\n    uint64_t BCa, BCe, BCi, BCo, BCu;\n    uint64_t Da, De, Di, Do, Du;\n    uint64_t Eba, Ebe, Ebi, Ebo, Ebu;\n    uint64_t Ega, Ege, Egi, Ego, Egu;\n    uint64_t Eka, Eke, Eki, Eko, Eku;\n    uint64_t Ema, Eme, Emi, Emo, Emu;\n    uint64_t Esa, Ese, Esi, Eso, Esu;\n\n    // copyFromState(A, state)\n    Aba = state[0];\n    Abe = state[1];\n    Abi = state[2];\n    Abo = state[3];\n    Abu = state[4];\n    Aga = state[5];\n    Age = state[6];\n    Agi = state[7];\n    Ago = state[8];\n    Agu = state[9];\n    Aka = state[10];\n    Ake = state[11];\n    Aki = state[12];\n    Ako = state[13];\n    Aku = state[14];\n    Ama = state[15];\n    Ame = state[16];\n    Ami = state[17];\n    Amo = state[18];\n    Amu = state[19];\n    Asa = state[20];\n    Ase = state[21];\n    Asi = state[22];\n    Aso = state[23];\n    Asu = state[24];\n\n    for (round = 0; round < NROUNDS; round += 2) {\n        //    prepareTheta\n        BCa = Aba ^ Aga ^ Aka ^ Ama ^ Asa;\n        BCe = Abe ^ Age ^ Ake ^ Ame ^ Ase;\n        BCi = Abi ^ Agi ^ Aki ^ Ami ^ Asi;\n        BCo = Abo ^ Ago ^ Ako ^ Amo ^ Aso;\n        BCu = Abu ^ Agu ^ Aku ^ Amu ^ Asu;\n\n        // thetaRhoPiChiIotaPrepareTheta(round  , A, E)\n        Da = BCu ^ ROL(BCe, 1);\n        De = BCa ^ ROL(BCi, 1);\n        Di = BCe ^ ROL(BCo, 1);\n        Do = BCi ^ ROL(BCu, 1);\n        Du = BCo ^ ROL(BCa, 1);\n\n        Aba ^= Da;\n        BCa = Aba;\n        Age ^= De;\n        BCe = ROL(Age, 44);\n        Aki ^= Di;\n        BCi = ROL(Aki, 43);\n        Amo ^= Do;\n        BCo = ROL(Amo, 21);\n        Asu ^= Du;\n        BCu = ROL(Asu, 14);\n        Eba = BCa ^ ((~BCe) & BCi);\n        Eba ^= KeccakF_RoundConstants[round];\n        Ebe = BCe ^ ((~BCi) & BCo);\n        Ebi = BCi ^ ((~BCo) & BCu);\n        Ebo = BCo ^ ((~BCu) & BCa);\n        Ebu = BCu ^ ((~BCa) & BCe);\n\n        Abo ^= Do;\n        BCa = ROL(Abo, 28);\n        Agu ^= Du;\n        BCe = ROL(Agu, 20);\n        Aka ^= Da;\n        BCi = ROL(Aka, 3);\n        Ame ^= De;\n        BCo = ROL(Ame, 45);\n        Asi ^= Di;\n        BCu = ROL(Asi, 61);\n        Ega = BCa ^ ((~BCe) & BCi);\n        Ege = BCe ^ ((~BCi) & BCo);\n        Egi = BCi ^ ((~BCo) & BCu);\n        Ego = BCo ^ ((~BCu) & BCa);\n        Egu = BCu ^ ((~BCa) & BCe);\n\n        Abe ^= De;\n        BCa = ROL(Abe, 1);\n        Agi ^= Di;\n        BCe = ROL(Agi, 6);\n        Ako ^= Do;\n        BCi = ROL(Ako, 25);\n        Amu ^= Du;\n        BCo = ROL(Amu, 8);\n        Asa ^= Da;\n        BCu = ROL(Asa, 18);\n        Eka = BCa ^ ((~BCe) & BCi);\n        Eke = BCe ^ ((~BCi) & BCo);\n        Eki = BCi ^ ((~BCo) & BCu);\n        Eko = BCo ^ ((~BCu) & BCa);\n        Eku = BCu ^ ((~BCa) & BCe);\n\n        Abu ^= Du;\n        BCa = ROL(Abu, 27);\n        Aga ^= Da;\n        BCe = ROL(Aga, 36);\n        Ake ^= De;\n        BCi = ROL(Ake, 10);\n        Ami ^= Di;\n        BCo = ROL(Ami, 15);\n        Aso ^= Do;\n        BCu = ROL(Aso, 56);\n        Ema = BCa ^ ((~BCe) & BCi);\n        Eme = BCe ^ ((~BCi) & BCo);\n        Emi = BCi ^ ((~BCo) & BCu);\n        Emo = BCo ^ ((~BCu) & BCa);\n        Emu = BCu ^ ((~BCa) & BCe);\n\n        Abi ^= Di;\n        BCa = ROL(Abi, 62);\n        Ago ^= Do;\n        BCe = ROL(Ago, 55);\n        Aku ^= Du;\n        BCi = ROL(Aku, 39);\n        Ama ^= Da;\n        BCo = ROL(Ama, 41);\n        Ase ^= De;\n        BCu = ROL(Ase, 2);\n        Esa = BCa ^ ((~BCe) & BCi);\n        Ese = BCe ^ ((~BCi) & BCo);\n        Esi = BCi ^ ((~BCo) & BCu);\n        Eso = BCo ^ ((~BCu) & BCa);\n        Esu = BCu ^ ((~BCa) & BCe);\n\n        //    prepareTheta\n        BCa = Eba ^ Ega ^ Eka ^ Ema ^ Esa;\n        BCe = Ebe ^ Ege ^ Eke ^ Eme ^ Ese;\n        BCi = Ebi ^ Egi ^ Eki ^ Emi ^ Esi;\n        BCo = Ebo ^ Ego ^ Eko ^ Emo ^ Eso;\n        BCu = Ebu ^ Egu ^ Eku ^ Emu ^ Esu;\n\n        // thetaRhoPiChiIotaPrepareTheta(round+1, E, A)\n        Da = BCu ^ ROL(BCe, 1);\n        De = BCa ^ ROL(BCi, 1);\n        Di = BCe ^ ROL(BCo, 1);\n        Do = BCi ^ ROL(BCu, 1);\n        Du = BCo ^ ROL(BCa, 1);\n\n        Eba ^= Da;\n        BCa = Eba;\n        Ege ^= De;\n        BCe = ROL(Ege, 44);\n        Eki ^= Di;\n        BCi = ROL(Eki, 43);\n        Emo ^= Do;\n        BCo = ROL(Emo, 21);\n        Esu ^= Du;\n        BCu = ROL(Esu, 14);\n        Aba = BCa ^ ((~BCe) & BCi);\n        Aba ^= KeccakF_RoundConstants[round + 1];\n        Abe = BCe ^ ((~BCi) & BCo);\n        Abi = BCi ^ ((~BCo) & BCu);\n        Abo = BCo ^ ((~BCu) & BCa);\n        Abu = BCu ^ ((~BCa) & BCe);\n\n        Ebo ^= Do;\n        BCa = ROL(Ebo, 28);\n        Egu ^= Du;\n        BCe = ROL(Egu, 20);\n        Eka ^= Da;\n        BCi = ROL(Eka, 3);\n        Eme ^= De;\n        BCo = ROL(Eme, 45);\n        Esi ^= Di;\n        BCu = ROL(Esi, 61);\n        Aga = BCa ^ ((~BCe) & BCi);\n        Age = BCe ^ ((~BCi) & BCo);\n        Agi = BCi ^ ((~BCo) & BCu);\n        Ago = BCo ^ ((~BCu) & BCa);\n        Agu = BCu ^ ((~BCa) & BCe);\n\n        Ebe ^= De;\n        BCa = ROL(Ebe, 1);\n        Egi ^= Di;\n        BCe = ROL(Egi, 6);\n        Eko ^= Do;\n        BCi = ROL(Eko, 25);\n        Emu ^= Du;\n        BCo = ROL(Emu, 8);\n        Esa ^= Da;\n        BCu = ROL(Esa, 18);\n        Aka = BCa ^ ((~BCe) & BCi);\n        Ake = BCe ^ ((~BCi) & BCo);\n        Aki = BCi ^ ((~BCo) & BCu);\n        Ako = BCo ^ ((~BCu) & BCa);\n        Aku = BCu ^ ((~BCa) & BCe);\n\n        Ebu ^= Du;\n        BCa = ROL(Ebu, 27);\n        Ega ^= Da;\n        BCe = ROL(Ega, 36);\n        Eke ^= De;\n        BCi = ROL(Eke, 10);\n        Emi ^= Di;\n        BCo = ROL(Emi, 15);\n        Eso ^= Do;\n        BCu = ROL(Eso, 56);\n        Ama = BCa ^ ((~BCe) & BCi);\n        Ame = BCe ^ ((~BCi) & BCo);\n        Ami = BCi ^ ((~BCo) & BCu);\n        Amo = BCo ^ ((~BCu) & BCa);\n        Amu = BCu ^ ((~BCa) & BCe);\n\n        Ebi ^= Di;\n        BCa = ROL(Ebi, 62);\n        Ego ^= Do;\n        BCe = ROL(Ego, 55);\n        Eku ^= Du;\n        BCi = ROL(Eku, 39);\n        Ema ^= Da;\n        BCo = ROL(Ema, 41);\n        Ese ^= De;\n        BCu = ROL(Ese, 2);\n        Asa = BCa ^ ((~BCe) & BCi);\n        Ase = BCe ^ ((~BCi) & BCo);\n        Asi = BCi ^ ((~BCo) & BCu);\n        Aso = BCo ^ ((~BCu) & BCa);\n        Asu = BCu ^ ((~BCa) & BCe);\n    }\n\n    // copyToState(state, A)\n    state[0] = Aba;\n    state[1] = Abe;\n    state[2] = Abi;\n    state[3] = Abo;\n    state[4] = Abu;\n    state[5] = Aga;\n    state[6] = Age;\n    state[7] = Agi;\n    state[8] = Ago;\n    state[9] = Agu;\n    state[10] = Aka;\n    state[11] = Ake;\n    state[12] = Aki;\n    state[13] = Ako;\n    state[14] = Aku;\n    state[15] = Ama;\n    state[16] = Ame;\n    state[17] = Ami;\n    state[18] = Amo;\n    state[19] = Amu;\n    state[20] = Asa;\n    state[21] = Ase;\n    state[22] = Asi;\n    state[23] = Aso;\n    state[24] = Asu;\n}\n\n/*************************************************\n * Name:        keccak_absorb\n *\n * Description: Absorb step of Keccak;\n *              non-incremental, starts by zeroeing the state.\n *\n * Arguments:   - uint64_t *s: pointer to (uninitialized) output Keccak state\n *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n *              - const uint8_t *m: pointer to input to be absorbed into s\n *              - size_t mlen: length of input in bytes\n *              - uint8_t p: domain-separation byte for different\n *                                 Keccak-derived functions\n **************************************************/\nstatic void keccak_absorb(uint64_t *s, uint32_t r, const uint8_t *m,\n                          size_t mlen, uint8_t p) {\n    size_t i;\n    uint8_t t[200];\n\n    /* Zero state */\n    for (i = 0; i < 25; ++i) {\n        s[i] = 0;\n    }\n\n    while (mlen >= r) {\n        for (i = 0; i < r / 8; ++i) {\n            s[i] ^= load64(m + 8 * i);\n        }\n\n        KeccakF1600_StatePermute(s);\n        mlen -= r;\n        m += r;\n    }\n\n    for (i = 0; i < r; ++i) {\n        t[i] = 0;\n    }\n    for (i = 0; i < mlen; ++i) {\n        t[i] = m[i];\n    }\n    t[i] = p;\n    t[r - 1] |= 128;\n    for (i = 0; i < r / 8; ++i) {\n        s[i] ^= load64(t + 8 * i);\n    }\n}\n\n/*************************************************\n * Name:        keccak_squeezeblocks\n *\n * Description: Squeeze step of Keccak. Squeezes full blocks of r bytes each.\n *              Modifies the state. Can be called multiple times to keep\n *              squeezing, i.e., is incremental.\n *\n * Arguments:   - uint8_t *h: pointer to output blocks\n *              - size_t nblocks: number of blocks to be\n *                                                squeezed (written to h)\n *              - uint64_t *s: pointer to input/output Keccak state\n *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n **************************************************/\nstatic void keccak_squeezeblocks(uint8_t *h, size_t nblocks,\n                                 uint64_t *s, uint32_t r) {\n    while (nblocks > 0) {\n        KeccakF1600_StatePermute(s);\n        for (size_t i = 0; i < (r >> 3); i++) {\n            store64(h + 8 * i, s[i]);\n        }\n        h += r;\n        nblocks--;\n    }\n}\n\n/*************************************************\n * Name:        keccak_inc_init\n *\n * Description: Initializes the incremental Keccak state to zero.\n *\n * Arguments:   - uint64_t *s_inc: pointer to input/output incremental state\n *                First 25 values represent Keccak state.\n *                26th value represents either the number of absorbed bytes\n *                that have not been permuted, or not-yet-squeezed bytes.\n **************************************************/\nstatic void keccak_inc_init(uint64_t *s_inc) {\n    size_t i;\n\n    for (i = 0; i < 25; ++i) {\n        s_inc[i] = 0;\n    }\n    s_inc[25] = 0;\n}\n\n/*************************************************\n * Name:        keccak_inc_absorb\n *\n * Description: Incremental keccak absorb\n *              Preceded by keccak_inc_init, succeeded by keccak_inc_finalize\n *\n * Arguments:   - uint64_t *s_inc: pointer to input/output incremental state\n *                First 25 values represent Keccak state.\n *                26th value represents either the number of absorbed bytes\n *                that have not been permuted, or not-yet-squeezed bytes.\n *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n *              - const uint8_t *m: pointer to input to be absorbed into s\n *              - size_t mlen: length of input in bytes\n **************************************************/\nstatic void keccak_inc_absorb(uint64_t *s_inc, uint32_t r, const uint8_t *m,\n                              size_t mlen) {\n    size_t i;\n\n    /* Recall that s_inc[25] is the non-absorbed bytes xored into the state */\n    while (mlen + s_inc[25] >= r) {\n        for (i = 0; i < r - s_inc[25]; i++) {\n            /* Take the i'th byte from message\n               xor with the s_inc[25] + i'th byte of the state; little-endian */\n            s_inc[(s_inc[25] + i) >> 3] ^= (uint64_t)m[i] << (8 * ((s_inc[25] + i) & 0x07));\n        }\n        mlen -= (size_t)(r - s_inc[25]);\n        m += r - s_inc[25];\n        s_inc[25] = 0;\n\n        KeccakF1600_StatePermute(s_inc);\n    }\n\n    for (i = 0; i < mlen; i++) {\n        s_inc[(s_inc[25] + i) >> 3] ^= (uint64_t)m[i] << (8 * ((s_inc[25] + i) & 0x07));\n    }\n    s_inc[25] += mlen;\n}\n\n/*************************************************\n * Name:        keccak_inc_finalize\n *\n * Description: Finalizes Keccak absorb phase, prepares for squeezing\n *\n * Arguments:   - uint64_t *s_inc: pointer to input/output incremental state\n *                First 25 values represent Keccak state.\n *                26th value represents either the number of absorbed bytes\n *                that have not been permuted, or not-yet-squeezed bytes.\n *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n *              - uint8_t p: domain-separation byte for different\n *                                 Keccak-derived functions\n **************************************************/\nstatic void keccak_inc_finalize(uint64_t *s_inc, uint32_t r, uint8_t p) {\n    /* After keccak_inc_absorb, we are guaranteed that s_inc[25] < r,\n       so we can always use one more byte for p in the current state. */\n    s_inc[s_inc[25] >> 3] ^= (uint64_t)p << (8 * (s_inc[25] & 0x07));\n    s_inc[(r - 1) >> 3] ^= (uint64_t)128 << (8 * ((r - 1) & 0x07));\n    s_inc[25] = 0;\n}\n\n/*************************************************\n * Name:        keccak_inc_squeeze\n *\n * Description: Incremental Keccak squeeze; can be called on byte-level\n *\n * Arguments:   - uint8_t *h: pointer to output bytes\n *              - size_t outlen: number of bytes to be squeezed\n *              - uint64_t *s_inc: pointer to input/output incremental state\n *                First 25 values represent Keccak state.\n *                26th value represents either the number of absorbed bytes\n *                that have not been permuted, or not-yet-squeezed bytes.\n *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n **************************************************/\nstatic void keccak_inc_squeeze(uint8_t *h, size_t outlen,\n                               uint64_t *s_inc, uint32_t r) {\n    size_t i;\n\n    /* First consume any bytes we still have sitting around */\n    for (i = 0; i < outlen && i < s_inc[25]; i++) {\n        /* There are s_inc[25] bytes left, so r - s_inc[25] is the first\n           available byte. We consume from there, i.e., up to r. */\n        h[i] = (uint8_t)(s_inc[(r - s_inc[25] + i) >> 3] >> (8 * ((r - s_inc[25] + i) & 0x07)));\n    }\n    h += i;\n    outlen -= i;\n    s_inc[25] -= i;\n\n    /* Then squeeze the remaining necessary blocks */\n    while (outlen > 0) {\n        KeccakF1600_StatePermute(s_inc);\n\n        for (i = 0; i < outlen && i < r; i++) {\n            h[i] = (uint8_t)(s_inc[i >> 3] >> (8 * (i & 0x07)));\n        }\n        h += i;\n        outlen -= i;\n        s_inc[25] = r - i;\n    }\n}\n\nvoid shake256_inc_init(uint64_t *s_inc) {\n    keccak_inc_init(s_inc);\n}\n\nvoid shake256_inc_absorb(uint64_t *s_inc, const uint8_t *input, size_t inlen) {\n    keccak_inc_absorb(s_inc, SHAKE256_RATE, input, inlen);\n}\n\nvoid shake256_inc_finalize(uint64_t *s_inc) {\n    keccak_inc_finalize(s_inc, SHAKE256_RATE, 0x1F);\n}\n\nvoid shake256_inc_squeeze(uint8_t *output, size_t outlen, uint64_t *s_inc) {\n    keccak_inc_squeeze(output, outlen, s_inc, SHAKE256_RATE);\n}\n\n/*************************************************\n * Name:        shake256_absorb\n *\n * Description: Absorb step of the SHAKE256 XOF.\n *              non-incremental, starts by zeroeing the state.\n *\n * Arguments:   - uint64_t *s: pointer to (uninitialized) output Keccak state\n *              - const uint8_t *input: pointer to input to be absorbed\n *                                            into s\n *              - size_t inlen: length of input in bytes\n **************************************************/\nvoid shake256_absorb(uint64_t *s, const uint8_t *input, size_t inlen) {\n    keccak_absorb(s, SHAKE256_RATE, input, inlen, 0x1F);\n}\n\n/*************************************************\n * Name:        shake256_squeezeblocks\n *\n * Description: Squeeze step of SHAKE256 XOF. Squeezes full blocks of\n *              SHAKE256_RATE bytes each. Modifies the state. Can be called\n *              multiple times to keep squeezing, i.e., is incremental.\n *\n * Arguments:   - uint8_t *output: pointer to output blocks\n *              - size_t nblocks: number of blocks to be squeezed\n *                                (written to output)\n *              - uint64_t *s: pointer to input/output Keccak state\n **************************************************/\nvoid shake256_squeezeblocks(uint8_t *output, size_t nblocks, uint64_t *s) {\n    keccak_squeezeblocks(output, nblocks, s, SHAKE256_RATE);\n}\n\n/*************************************************\n * Name:        shake256\n *\n * Description: SHAKE256 XOF with non-incremental API\n *\n * Arguments:   - uint8_t *output: pointer to output\n *              - size_t outlen: requested output length in bytes\n *              - const uint8_t *input: pointer to input\n *              - size_t inlen: length of input in bytes\n **************************************************/\nvoid shake256(uint8_t *output, size_t outlen,\n              const uint8_t *input, size_t inlen) {\n    size_t nblocks = outlen / SHAKE256_RATE;\n    uint8_t t[SHAKE256_RATE];\n    uint64_t s[25];\n\n    shake256_absorb(s, input, inlen);\n    shake256_squeezeblocks(output, nblocks, s);\n\n    output += nblocks * SHAKE256_RATE;\n    outlen -= nblocks * SHAKE256_RATE;\n\n    if (outlen) {\n        shake256_squeezeblocks(t, 1, s);\n        for (size_t i = 0; i < outlen; ++i) {\n            output[i] = t[i];\n        }\n    }\n}\n","numLines":599,"startLine":1,"totalLines":599}}}
