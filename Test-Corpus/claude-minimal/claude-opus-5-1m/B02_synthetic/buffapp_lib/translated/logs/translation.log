   buffer->data[0] = '\\0';\n49\t\n50\t    return buffer;\n51\t}\n52\t\n53\tint append_to_buffer(StringBuffer *buffer, const char *str) {\n54\t    int str_len = strlen(str);\n55\t    int required_capacity = buffer->length + str_len + 1;\n56\t\n57\t    if (required_capacity > buffer->capacity) {\n58\t        int new_capacity = required_capacity * 2;\n59\t        char *new_data = (char*)realloc(buffer->data, new_capacity);\n60\t\n61\t        if (!new_data) {\n62\t            return -1;\n63\t        }\n64\t\n65\t        buffer->data = new_data;\n66\t        buffer->capacity = new_capacity;\n67\t    }\n68\t\n69\t    strcpy(buffer->data + buffer->length, str);\n70\t    buffer->length += str_len;\n71\t\n72\t    return 0;\n73\t}\n74\t\n75\tvoid destroy_buffer(StringBuffer *buffer) {\n76\t    if (buffer) {\n77\t        if (buffer->data) {\n78\t            free(buffer->data);\n79\t        }\n80\t        free(buffer);\n81\t    }\n82\t}\n83\t\n84\tconst char* get_operation_name(int op_code) {\n85\t    switch (op_code) {\n86\t        case 0: return \"add\";\n87\t        case 1: return \"subtract\";\n88\t        case 2: return \"multiply\";\n89\t        case 3: return \"divide\";\n90\t        default: return \"unknown\";\n91\t    }\n92\t}\n93\t\n94\tint perform_operation(int a, int b, const char *operation) {\n95\t    if (strcmp(operation, \"add\") == 0) {\n96\t        return a + b;\n97\t    } else if (strcmp(operation, \"subtract\") == 0) {\n98\t        return a - b;\n99\t    } else if (strcmp(operation, \"multiply\") == 0) {\n100\t        return a * b;\n101\t    } else if (strcmp(operation, \"divide\") == 0) {\n102\t        if (b != 0) {\n103\t            return a / b;\n104\t        }\n105\t        return 0;\n106\t    }\n107\t    return 0;\n108\t}\n109\t\n110\t// TODO: lib test stdout\n111\tint buffapp(int param1, int param2, int param3, int param4) {\n112\t    StringBuffer *log_buffer = create_buffer(32);\n113\t    int result = 0;\n114\t    char temp[64];\n115\t\n116\t    log