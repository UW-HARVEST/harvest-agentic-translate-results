{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VcPUZQcXZMYSm8LDWUCiFw","type":"tool_result","content":"1\t/*\n2\t * Copyright 2025 MIT Lincoln Laboratory\n3\t * Permission is hereby granted, free of charge,\n4\t * to any person obtaining a copy of this software\n5\t * and associated documentation files (the \"Software\"),\n6\t * to deal in the Software without restriction,\n7\t * including without limitation the rights to use, copy,\n8\t * modify, merge, publish, distribute, sublicense,\n9\t * and/or sell copies of the Software,\n10\t * and to permit persons to whom the Software is furnished to do so,\n11\t * subject to the following conditions:\n12\t * \n13\t * The above copyright notice and this permission notice\n14\t * shall be included in all copies or substantial portions of the Software.\n15\t * \n16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n18\t * THE WARRANTIES OF MERCHANTABILITY,\n19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n24\t */\n25\t#include <stddef.h>\n26\t#include <string.h>\n27\t#include <stdint.h>\n28\t\n29\t/* Forward declarations */\n30\tstatic size_t compact_runs(uint8_t *buf, size_t len, uint8_t threshold);\n31\tstatic void rotate_buffer(uint8_t *buf, size_t len, int offset);\n32\tstatic size_t remove_duplicates(uint8_t *buf, size_t len, int preserve_order);\n33\tstatic void interleave_halves(uint8_t *buf, size_t len);\n34\tstatic void reverse_segments(uint8_t *buf, size_t len, size_t seg_size);\n35\t\n36\t/**\n37\t * Main entrance function - processes buffer based on operation flags\n38\t * \n39\t * @param buffer Input/output buffer\n40\t * @param length Buffer length\n41\t * @param flags Bit flags: \n42\t *              bit 0: rotate buffer\n43\t *              bit 1: compact runs\n44\t *              bit 2: remove duplicates\n45\t *              bit 3: interleave halves\n46\t *              bit 4: reverse segments\n47\t * @param param1 Operation-specific parameter (rotation offset, run threshold, segment size)\n48\t * @param param2 Secondary parameter (preserve order flag, etc)\n49\t * @return New buffer length after processing\n50\t */\n51\tsize_t process_buffer(uint8_t *buffer, size_t length, uint32_t flags, \n52\t                     int param1, int param2) {\n53\t    size_t new_len = length;\n54\t    \n55\t    if (buffer == NULL || length == 0) {\n56\t        return 0;\n57\t    }\n58\t    \n59\t    /* Branch based on multiple flags - creates diverse control flow */\n60\t    if (flags & 0x01) {  /* Rotate */\n61\t        int offset = param1 % (int)length;\n62\t        if (offset != 0) {\n63\t            rotate_buffer(buffer, length, offset);\n64\t        }\n65\t    }\n66\t    \n67\t    if (flags & 0x02) {  /* Compact runs */\n68\t        uint8_t threshold = (param1 > 0 && param1 <= 255) ? (uint8_t)param1 : 3;\n69\t        new_len = compact_runs(buffer, new_len, threshold);\n70\t    }\n71\t    \n72\t    if (flags & 0x04) {  /* Remove duplicates */\n73\t        int preserve = (param2 != 0);\n74\t        new_len = remove_duplicates(buffer, new_len, preserve);\n75\t    }\n76\t    \n77\t    /* Conditional chaining based on length */\n78\t    if ((flags & 0x08) && new_len >= 2) {  /* Interleave */\n79\t        interleave_halves(buffer, new_len);\n80\t    }\n81\t    \n82\t    if ((flags & 0x10) && new_len >= 4) {  /* Reverse segments */\n83\t        size_t seg_size = (param1 > 0) ? (size_t)param1 : 4;\n84\t        if (seg_size <= new_len) {\n85\t            reverse_segments(buffer, new_len, seg_size);\n86\t        }\n87\t    }\n88\t    \n89\t    return new_len;\n90\t}\n91\t\n92\t/**\n93\t * Rotate buffer by offset positions (positive = right, negative = left)\n94\t * Uses multiple memmove operations with different patterns\n95\t */\n96\tstatic void rotate_buffer(uint8_t *buf, size_t len, int offset) {\n97\t    if (len <= 1) return;\n98\t    \n99\t    /* Normalize offset */\n100\t    offset = offset % (int)len;\n101\t    if (offset < 0) offset += len;\n102\t    if (offset == 0) return;\n103\t    \n104\t    /* Use reversal algorithm with memmove */\n105\t    uint8_t temp[256];\n106\t    size_t chunk = (offset < 256) ? offset : 256;\n107\t    \n108\t    if ((size_t)offset < len / 2) {\n109\t        /* Small offset: move prefix aside, shift main part, restore prefix */\n110\t        size_t i;\n111\t        for (i = 0; i < (size_t)offset; i += chunk) {\n112\t            size_t copy_len = ((size_t)offset - i < chunk) ? (size_t)offset - i : chunk;\n113\t            memmove(temp, buf + i, copy_len);\n114\t            memmove(buf + i, buf + offset, len - offset);\n115\t            memmove(buf + len - offset, temp, copy_len);\n116\t        }\n117\t    } else {\n118\t        /* Large offset: work from the right */\n119\t        size_t shift = len - offset;\n120\t        memmove(temp, buf, shift);\n121\t        memmove(buf, buf + shift, offset);\n122\t        memmove(buf + offset, temp, shift);\n123\t    }\n124\t}\n125\t\n126\t/**\n127\t * Compact consecutive runs of same value if run length >= threshold\n128\t * Complex nested loops with multiple data paths\n129\t */\n130\tstatic size_t compact_runs(uint8_t *buf, size_t len, uint8_t threshold) {\n131\t    size_t read = 0, write = 0;\n132\t    \n133\t    while (read < len) {\n134\t        uint8_t current = buf[read];\n135\t        size_t run_len = 1;\n136\t        \n137\t        /* Count run length */\n138\t        while (read + run_len < len && buf[read + run_len] == current) {\n139\t            run_len++;\n140\t        }\n141\t        \n142\t        if (run_len >= threshold) {\n143\t            /* Compact to 2 elements: value, count */\n144\t            if (run_len > 255) run_len = 255;  /* Cap at 255 */\n145\t            \n146\t            buf[write++] = current;\n147\t            buf[write++] = (uint8_t)run_len;\n148\t            \n149\t            /* Shift remaining data if needed */\n150\t            if (read + run_len < len) {\n151\t                size_t remaining = len - (read + run_len);\n152\t                memmove(buf + write, buf + read + run_len, remaining);\n153\t            }\n154\t            len = write + (len - (read + run_len));\n155\t            read = write;\n156\t        } else {\n157\t            /* Keep run as-is, but may need to move it */\n158\t            if (write != read) {\n159\t                memmove(buf + write, buf + read, run_len);\n160\t            }\n161\t            write += run_len;\n162\t            read += run_len;\n163\t        }\n164\t    }\n165\t    \n166\t    return len;\n167\t}\n168\t\n169\t/**\n170\t * Remove duplicate values - different paths for ordered/unordered\n171\t */\n172\tstatic size_t remove_duplicates(uint8_t *buf, size_t len, int preserve_order) {\n173\t    if (len <= 1) return len;\n174\t    \n175\t    if (preserve_order) {\n176\t        /* Preserve order: O(n^2) but maintains sequence */\n177\t        size_t write = 1;\n178\t        for (size_t i = 1; i < len; i++) {\n179\t            size_t j;\n180\t            for (j = 0; j < write; j++) {\n181\t                if (buf[i] == buf[j]) break;\n182\t            }\n183\t            if (j == write) {\n184\t                if (write != i) {\n185\t                    buf[write] = buf[i];\n186\t                }\n187\t                write++;\n188\t            }\n189\t        }\n190\t        return write;\n191\t    } else {\n192\t        /* Don't preserve order: sort-like approach with memmove */\n193\t        uint8_t seen[256] = {0};\n194\t        size_t write = 0;\n195\t        \n196\t        for (size_t i = 0; i < len; i++) {\n197\t            if (!seen[buf[i]])