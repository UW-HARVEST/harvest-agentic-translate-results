a.offset(i + 1) = (g * 255.0f32) as u8;\n        *data.offset(i + 2) = (b * 255.0f32) as u8;\n        i += pixel_size;\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
