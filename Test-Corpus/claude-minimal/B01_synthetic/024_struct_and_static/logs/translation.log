atic mut THE_HOUSE: House = House {\n    floors: 2,\n    bedrooms: 5,\n    bathrooms: 2.5,\n};\n\nfn add_floor(house: &mut House) {\n    house.floors += 1;\n}\n\nfn add_bedrooms(house: &mut House, extra_bedrooms: i32) {\n    house.bedrooms += extra_bedrooms;\n}\n\nfn add_floor_to_the_house() {\n    unsafe {\n        add_floor(&mut THE_HOUSE);\n    }\n}\n\nfn print_the_house() {\n    unsafe {\n        println!(\n            \"The house has {} floors, {} bedrooms, and {:.1} bathrooms\",\n            THE_HOUSE.floors, THE_HOUSE.bedrooms, THE_HOUSE.bathrooms\n        );\n    }\n}\n\nfn run(extra_bedrooms: i32) {\n    print_the_house();\n    add_floor_to_the_house();\n    print_the_house();\n    unsafe {\n        THE_HOUSE.bathrooms += 1.0;\n    }\n    print_the_house();\n    unsafe {\n        add_bedrooms(&mut THE_HOUSE, extra_bedrooms);\n    }\n    print_the_house();\n}\n\nfn main() {\n    // Match scanf(\"%d\", &x) behavior: read an integer from stdin.\n    // If parsing fails, x remains 0 (matching the C program where x = 0\n    // and scanf would leave it unchanged on failure).\n    let mut x: i32 = 0;\n\n    let stdin = io::stdin();\n    let mut input = String::new();\n    // Read all of stdin so we can scan whitespace-separated integers like scanf.\n    let _ = stdin.lock().read_to_string_helper(&mut input);\n\n    if let Some(token) = input.split_whitespace().next() {\n        if let Ok(parsed) = token.parse::<i32>() {\n            x = parsed;\n        }\n    }\n\n    run(x);\n    run(x);\n}\n\n// Helper trait to read all of stdin into a string without pulling in\n// extra dependencies. We define this so we can call read_to_string-like\n// behavior on a locked stdin handle.\ntrait ReadToStringHelper {\n    fn read_to_string_helper(&mut self, buf: &mut String) -> io::Result<usize>;\n}\n\nimpl<R: BufRead> ReadToStringHelper for R {\n    fn read_to_string_helper(&mut self, buf: &mut String) -> io::Result<usize> {\n        let mut total = 0;\n        loop {\n            let mut line = String::new();\n            let n = self.read_line(&mut line)?;\n            if n == 0 {\n                break;\n            }\n            total += n;\n            buf.push_str(&line);\n        }\n        let _ = io::stdout().flush();\n        Ok(total)\n    }\n}\n","userModified":false}}
