49\tCJSON_PUBLIC(cJSON_bool) cJSON_IsFalse(const cJSON * const item);\n150\tCJSON_PUBLIC(cJSON_bool) cJSON_IsTrue(const cJSON * const item);\n151\tCJSON_PUBLIC(cJSON_bool) cJSON_IsBool(const cJSON * const item);\n152\tCJSON_PUBLIC(cJSON_bool) cJSON_IsNull(const cJSON * const item);\n153\tCJSON_PUBLIC(cJSON_bool) cJSON_IsNumber(const cJSON * const item);\n154\tCJSON_PUBLIC(cJSON_bool) cJSON_IsString(const cJSON * const item);\n155\tCJSON_PUBLIC(cJSON_bool) cJSON_IsArray(const cJSON * const item);\n156\tCJSON_PUBLIC(cJSON_bool) cJSON_IsObject(const cJSON * const item);\n157\tCJSON_PUBLIC(cJSON_bool) cJSON_IsRaw(const cJSON * const item);\n158\t\n159\t/* These calls create a cJSON item of the appropriate type. */\n160\tCJSON_PUBLIC(cJSON *) cJSON_CreateNull(void);\n161\tCJSON_PUBLIC(cJSON *) cJSON_CreateTrue(void);\n162\tCJSON_PUBLIC(cJSON *) cJSON_CreateFalse(void);\n163\tCJSON_PUBLIC(cJSON *) cJSON_CreateBool(cJSON_bool boolean);\n164\tCJSON_PUBLIC(cJSON *) cJSON_CreateNumber(double num);\n165\tCJSON_PUBLIC(cJSON *) cJSON_CreateString(const char *string);\n166\t/* raw json */\n167\tCJSON_PUBLIC(cJSON *) cJSON_CreateRaw(const char *raw);\n168\tCJSON_PUBLIC(cJSON *) cJSON_CreateArray(void);\n169\tCJSON_PUBLIC(cJSON *) cJSON_CreateObject(void);\n170\t\n171\t/* Create a string where valuestring references a string so\n172\t * it will not be freed by cJSON_Delete */\n173\tCJSON_PUBLIC(cJSON *) cJSON_CreateStringReference(const char *string);\n174\t/* Create an object/array that only references it's elements so\n175\t * they will not be freed by cJSON_Delete */\n176\tCJSON_PUBLIC(cJSON *) cJSON_CreateObjectReference(const cJSON *child);\n177\tCJSON_PUBLIC(cJSON *) cJSON_CreateArrayReference(const cJSON *child);\n178\t\n179\t/* These utilities create an Array of count items.\n180\t * The parameter count cannot be greater than the number of elements in the number array, otherwise array access will be out of bounds.*/\n181\tCJSON_PUBLIC(cJSON *) cJSON_CreateIntArray(const int