alse\n56\t#endif\n57\t#define false ((cJSON_bool)0)\n58\t\n59\t/* define isnan and isinf for ANSI C, if in C99 or above, isnan and isinf has been defined in math.h */\n60\t#ifndef isinf\n61\t#define isinf(d) (isnan((d - d)) && !isnan(d))\n62\t#endif\n63\t#ifndef isnan\n64\t#define isnan(d) (d != d)\n65\t#endif\n66\t\n67\t#ifndef NAN\n68\t#define NAN 0.0/0.0\n69\t#endif\n70\t\n71\ttypedef struct {\n72\t    const unsigned char *json;\n73\t    size_t position;\n74\t} error;\n75\tstatic error global_error = { NULL, 0 };\n76\t\n77\tCJSON_PUBLIC(const char *) cJSON_GetErrorPtr(void)\n78\t{\n79\t    return (const char*) (global_error.json + global_error.position);\n80\t}\n81\t\n82\tCJSON_PUBLIC(char *) cJSON_GetStringValue(const cJSON * const item)\n83\t{\n84\t    if (!cJSON_IsString(item))\n85\t    {\n86\t        return NULL;\n87\t    }\n88\t\n89\t    return item->valuestring;\n90\t}\n91\t\n92\tCJSON_PUBLIC(double) cJSON_GetNumberValue(const cJSON * const item)\n93\t{\n94\t    if (!cJSON_IsNumber(item))\n95\t    {\n96\t        return (double) NAN;\n97\t    }\n98\t\n99\t    return item->valuedouble;\n100\t}\n101\t\n102\t/* This is a safeguard to prevent copy-pasters from using incompatible C and header files */\n103\t#if (CJSON_VERSION_MAJOR != 1) || (CJSON_VERSION_MINOR != 7) || (CJSON_VERSION_PATCH != 19)\n104\t    #error cJSON.h and cJSON.c have different versions. Make sure that both have the same.\n105\t#endif\n106\t\n107\tCJSON_PUBLIC(const char*) cJSON_Version(void)\n108\t{\n109\t    static char version[15];\n110\t    sprintf(version, \"%i.%i.%i\", CJSON_VERSION_MAJOR, CJSON_VERSION_MINOR, CJSON_VERSION_PATCH);\n111\t\n112\t    return version;\n113\t}\n114\t\n115\t/* Case insensitive string comparison, doesn't consider two NULL pointers equal though */\n116\tstatic int case_insensitive_strcmp(const unsigned char *string1, const unsigned char *string2)\n117\t{\n118\t    if ((string1 == NULL) || (string2 == NULL))\n119\t    {\n120\t        return 1;\n121\t    }\n122\t