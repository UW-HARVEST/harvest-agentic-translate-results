ault();\n    time.tm_mday = day;\n    time.tm_mon = month;\n    time.tm_year = year;\n\n    let mut fq = FileQueueT::default();\n\n    unsafe {\n        if Init_FileQueue(&mut fq, &time, flags) < 0 {\n            eprintln!(\"File queue initialization failed\");\n            return std::ptr::null_mut();\n        }\n\n        let al_data = Read_FileMon(&mut fq, &time, timeout);\n\n        if !fq.fp.is_null() {\n            libc::fclose(fq.fp);\n            fq.fp = std::ptr::null_mut();\n        }\n\n        al_data\n    }\n}\n","structuredPatch":[{"oldStart":58,"oldLines":7,"newStart":58,"newLines":6,"lines":[" ","         if !fq.fp.is_null() {","             libc::fclose(fq.fp);","-            fq.fp = std::ptr::null_mut();","         }"," ","         al_data"]}],"userModified":false,"replaceAll":false}}
