iled\");\n            return std::ptr::null_mut();\n        }\n\n        let al_data = Read_FileMon(&mut fq, &time, timeout);\n\n        if !fq.fp.is_null() {\n            libc::fclose(fq.fp);\n            fq.fp = std::ptr::null_mut();\n        }\n\n        al_data\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
