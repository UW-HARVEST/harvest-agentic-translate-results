e you will be including system headers files can will have issues.\n44\t\n45\t  Remember, if you use a C library function that is not defined in bg_lib.c,\n46\t  you will have to add your own version for support in the VM.\n47\t\n48\t **********************************************************************/\n49\t\n50\t#ifdef Q3_VM\n51\t\n52\t#include \"bg_lib.h\"\n53\t\n54\t#else\n55\t\n56\t#include <assert.h>\n57\t#include <math.h>\n58\t#include <stdio.h>\n59\t#include <stdarg.h>\n60\t#include <string.h>\n61\t#include <stdlib.h>\n62\t#include <time.h>\n63\t#include <ctype.h>\n64\t#include <limits.h>\n65\t\n66\t#endif\n67\t\n68\t\n69\t#define id386\t0\n70\t#define idppc\t0\n71\t#define idppc_altivec 0\n72\t\n73\t// for windows fastcall option\n74\t\n75\t#define\tQDECL\n76\t\n77\tshort   ShortSwap (short l);\n78\tint\t\tLongSwap (int l);\n79\tfloat\tFloatSwap (const float *f);\n80\t\n81\t//======================= LINUX DEFINES =================================\n82\t\n83\t// the mac compiler can't handle >32k of locals, so we\n84\t// just waste space and make big arrays static...\n85\t#ifdef __linux__\n86\t\n87\t// bk001205 - from Makefile\n88\t#define stricmp strcasecmp\n89\t\n90\t#define\tMAC_STATIC // bk: FIXME\n91\t#define ID_INLINE inline\n92\t\n93\t#define\tCPUSTRING\t\"linux-other\"\n94\t\n95\t\n96\t#define\tPATH_SEP '/'\n97\t\n98\t\n99\tinline static short BigShort( short l) { return ShortSwap(l); }\n100\t#define LittleShort\n101\tinline static int BigLong(int l) { return LongSwap(l); }\n102\t#define LittleLong\n103\tinline static float BigFloat(const float *l) { return FloatSwap(l); }\n104\t#define LittleFloat\n105\t#endif\n106\t\n107\t//=============================================================\n108\t\n109\ttypedef unsigned char \t\tbyte;\n110\t\n111\ttypedef enum {qfalse, qtrue}\tqboolean;\n112\t\n113\ttypedef int\t\tqhandle_t;\n114\ttypedef int\t\tsfxHandle_t;\n115\ttypedef int\t\tfileHandle_t;\n116\ttypedef int\t\tclipHandle_t;\n117\t\n118\t\n119\t#ifndef NULL\n120\t#define NULL ((void *)0)\n121\t#endif\n122\t\n123\t#define\tMAX_QINT\t\t\t0x7fffffff\n124\t#define\tMIN_QINT\t\t\t(-MAX_QINT-1)\n125\t\n126\t\n127\t// angle indexes\n128\t#define\tPITCH\t\t\t\t0\t\t// up / down\n129\t#define\tYAW\t\t\t\t\t1\t\t// left / right\n130\t#define\tROLL\t\t\t\t2\t\t// fall over\n131\t\n132\t// the game guarantees that no string from the network will ever\n133\t// exceed MAX_STRING_CHARS\n134\t#define\tMAX_STRING_CHARS\t1024\t// max length of a string passed to Cmd_TokenizeString\n135\t#define\tMAX_STRING_TOKENS\t1024\t// max tokens resulting from Cmd_TokenizeString\n136\t#define\tMAX_TOKEN_CHARS\t\t1024\t// max length of an individual token\n137\t\n138\t#define\tMAX_INFO_STRING\t\t1024\n139\t#define\tMAX_INFO_KEY\t\t  1024\n140\t#define\tMAX_INFO_VALUE\t\t1024\n141\t\n142\t#define\tBIG_INFO_STRING\t\t8192  // used for system info key only\n143\t#define\tBIG_INFO_KEY\t\t  8192\n144\t#define\tBIG_INFO_VALUE\t\t8192\n145\t\n146\t\n147\t#define\tMAX_QPATH\t\t\t64\t\t// max length of a quake game pathname\n148\t#ifdef PATH_MAX\n149\t#define MAX_OSPATH\t\t\tPATH_MAX\n150\t#else\n151\t#define\tMAX_OSPATH\t\t\t256\t\t// max length of a filesystem pathname\n152\t#endif\n153\t\n154\t#define\tMAX_NAME_LENGTH\t\t32\t\t// max length of a client name\n155\t\n156\t#define\tMAX_SAY_TEXT\t150\n157\t\n158\t// paramters for command buffer stuffing\n159\ttypedef enum {\n160\t\tEXEC_NOW,\t\t\t// don't return until completed, a VM should NEVER use this,\n161\t\t\t\t\t\t\t// because some commands might cause the VM to be unloaded...\n162\t\tEXEC_INSERT,\t\t// insert at current position, but don't run yet\n163\t\tEXEC_APPEND\t\t\t// add to end of the command buffer (normal case)\n164\t} cbufExec_t;\n165\t\n166\t\n167\t//\n168\t// these aren't needed by any of the VMs.  put in another header?\n169\t//\n170\t#define\tMAX_MAP_AREA_BYTES\t\t32\t\t// bit vector of area visibility\n171\t\n172\t\n173\t// print levels from renderer (FIXME: set up for game / c