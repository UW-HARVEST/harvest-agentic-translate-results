n249\t\t\ts->a = s->c;\n250\t\t\ts->a.u = uCA;\n251\t\t\ts->b.u = vCA;\n252\t\t\ts->div = uCA + vCA;\n253\t\t\ts->count = 2;\n254\t\t} else {\n255\t\t\ts->a.u = uABC;\n256\t\t\ts->b.u = vABC;\n257\t\t\ts->c.u = wABC;\n258\t\t\ts->div = uABC + vABC + wABC;\n259\t\t\ts->count = 3;\n260\t\t}\n261\t}\n262\t\n263\tc2v c2Neg(c2v a) {\n264\t\treturn c2V(-a.x, -a.y);\n265\t}\n266\t\n267\tc2v c2Skew(c2v a) {\n268\t\tc2v b;\n269\t\tb.x = -a.y;\n270\t\tb.y = a.x;\n271\t\treturn b;\n272\t}\n273\t\n274\tc2v c2CCW90(c2v a) {\n275\t\tc2v b;\n276\t\tb.x = a.y;\n277\t\tb.y = -a.x;\n278\t\treturn b;\n279\t}\n280\t\n281\tc2v c2D(c2Simplex *s) {\n282\t\tswitch (s->count) {\n283\t\t\tcase 1:\n284\t\t\t\treturn c2Neg(s->a.p);\n285\t\t\tcase 2: {\n286\t\t\t\t\tc2v ab = c2Sub(s->b.p, s->a.p);\n287\t\t\t\t\tif (c2Det2(ab, c2Neg(s->a.p)) > 0)\n288\t\t\t\t\t\treturn c2Skew(ab);\n289\t\t\t\t\treturn c2CCW90(ab);\n290\t\t\t\t}\n291\t\t\tcase 3:\n292\t\t\tdefault:\n293\t\t\t\treturn c2V(0, 0);\n294\t\t}\n295\t}\n296\t\n297\tint c2Support(const c2v *verts, int count, c2v d) {\n298\t\tint imax = 0;\n299\t\tfloat dmax = c2Dot(verts[0], d);\n300\t\tfor (int i = 1; i < count; ++i) {\n301\t\t\tfloat dot = c2Dot(verts[i], d);\n302\t\t\tif (dot > dmax) {\n303\t\t\t\timax = i;\n304\t\t\t\tdmax = dot;\n305\t\t\t}\n306\t\t}\n307\t\treturn imax;\n308\t}\n309\t\n310\tvoid c2Witness(c2Simplex *s, c2v *a, c2v *b) {\n311\t\tfloat den = 1.0f / s->div;\n312\t\tswitch (s->count) {\n313\t\t\tcase 1:\n314\t\t\t\t*a = s->a.sA;\n315\t\t\t\t*b = s->a.sB;\n316\t\t\t\tbreak;\n317\t\t\tcase 2:\n318\t\t\t\t*a = c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\n319\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u)));\n320\t\t\t\t*b = c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\n321\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u)));\n322\t\t\t\tbreak;\n323\t\t\tcase 3:\n324\t\t\t\t*a = c2Add(c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\n325\t\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u))),\n326\t\t\t\t\t\tc2Mulvs(s->c.sA, (den * s->c.u)));\n327\t\t\t\t*b = c2Add(c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\n328\t\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u))),\n329\t\t\t\t\t\tc2Mulvs(s->c.sB, (den * s->c.u)));\n330\t\t\t\tbreak;\n331\t\t\tdefault:\n332\t\t\t\t*a = c2V(0, 0);\n333\t\t\t\t*b = c2V(0, 0);\n334\t\t}\n335\t}\n336\t\n337\tc2v c2Div(c2v a, float b) {\n338\t\treturn c2Mulvs(a, 1.0f / b);\n339\t}\n340\t\n341\tc2v c2Norm(c2v a) {\n342\t\treturn c2Div(a, c2Len(a));\n343\t}\n344\t\n345\tc2v c2L(c2Simplex *s) {\n346\t    float den = 1.0f / s->div;\n347\t    switch (s->count) {\n348\t    case 1:\n349\t        return s->a.p;\n350\t    case 2:\n351\t        return c2Add(c2Mulvs(s->a.p, (den * s->a.u)),\n352\t                     c2Mulvs(s->b.p, (den * s->b.u)));\n353\t    default:\n354\t        return c2V(0, 0);\n355\t    }\n356\t}\n357\t\n358\tc2v c2MulrvT(c2r a, c2v b) {\n359\t    return c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y);\n360\t}\n361\t\n362\tfloat c2GJK(const void *A, C2_TYPE typeA, const c2x *ax_ptr, const void *B,\n363\t\t\tC2_TYPE typeB, const c2x *bx_ptr, c2v *outA, c2v *outB,\n364\t\t\tint use_radius, int *iterations, c2GJKCache *cache) {\n365\t\tc2x ax;\n366\t\tc2x bx;\n367\t\tif (!ax_ptr)\n368\t\t\tax = c2xIdentity();\n369\t\telse\n370\t\t\tax = *ax_ptr;\n371\t\tif (!bx_ptr)\n372\t\t\tbx = c2xIdentity();\n373\t\telse\n374\t\t\tbx = *bx_ptr;\n375\t\tc2Proxy pA;\n376\t\tc2Proxy pB;\n377\t\tc2MakeProxy(A, typeA, &pA);\n378\t\tc2MakeProxy(B, typeB, &pB);\n379\t\tc2Simplex s;\n380\t\tc2sv *verts = &s.a;\n381\t\tint cache_was_read = 0;\n382\t\tif (cache) {\n383\t\t\tint cache_was_good = !!cache->count;\n384\t\t\tif (cache_was_good) {\n385\t\t\t\tfor (int i = 0; i < cache->count; ++i) {\n386\t\t\t\t\tint iA = cache->iA[i];\n387\t\t\t\t\tint iB = cache->iB[i];\n388\t\t\t\t\tc2v sA = c2Mulxv(ax, pA.verts[iA]);\n389\t\t\t\t\tc2v sB = c2Mulxv(bx, pB.verts[iB]);\n390\t\t\t\t\tc2sv *v = verts + i;\n391\t\t\t\t\tv->iA = iA;\n392\t\t\t\t\tv->sA = sA;\n393\t\t\t\t\tv->iB = iB;\n394\t\t\t\t\tv->sB = sB;\n395\t\t\