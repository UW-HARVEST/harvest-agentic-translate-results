{\n249\t\t\ts->b = s->a;\n250\t\t\ts->a = s->c;\n251\t\t\ts->a.u = uCA;\n252\t\t\ts->b.u = vCA;\n253\t\t\ts->div = uCA + vCA;\n254\t\t\ts->count = 2;\n255\t\t} else {\n256\t\t\ts->a.u = uABC;\n257\t\t\ts->b.u = vABC;\n258\t\t\ts->c.u = wABC;\n259\t\t\ts->div = uABC + vABC + wABC;\n260\t\t\ts->count = 3;\n261\t\t}\n262\t}\n263\t\n264\tc2v c2Neg(c2v a) {\n265\t\treturn c2V(-a.x, -a.y);\n266\t}\n267\t\n268\tc2v c2Skew(c2v a) {\n269\t\tc2v b;\n270\t\tb.x = -a.y;\n271\t\tb.y = a.x;\n272\t\treturn b;\n273\t}\n274\t\n275\tc2v c2CCW90(c2v a) {\n276\t\tc2v b;\n277\t\tb.x = a.y;\n278\t\tb.y = -a.x;\n279\t\treturn b;\n280\t}\n281\t\n282\tc2v c2D(c2Simplex *s) {\n283\t\tswitch (s->count) {\n284\t\t\tcase 1:\n285\t\t\t\treturn c2Neg(s->a.p);\n286\t\t\tcase 2: {\n287\t\t\t\t\tc2v ab = c2Sub(s->b.p, s->a.p);\n288\t\t\t\t\tif (c2Det2(ab, c2Neg(s->a.p)) > 0)\n289\t\t\t\t\t\treturn c2Skew(ab);\n290\t\t\t\t\treturn c2CCW90(ab);\n291\t\t\t\t}\n292\t\t\tcase 3:\n293\t\t\tdefault:\n294\t\t\t\treturn c2V(0, 0);\n295\t\t}\n296\t}\n297\t\n298\tint c2Support(const c2v *verts, int count, c2v d) {\n299\t\tint imax = 0;\n300\t\tfloat dmax = c2Dot(verts[0], d);\n301\t\tfor (int i = 1; i < count; ++i) {\n302\t\t\tfloat dot = c2Dot(verts[i], d);\n303\t\t\tif (dot > dmax) {\n304\t\t\t\timax = i;\n305\t\t\t\tdmax = dot;\n306\t\t\t}\n307\t\t}\n308\t\treturn imax;\n309\t}\n310\t\n311\tvoid c2Witness(c2Simplex *s, c2v *a, c2v *b) {\n312\t\tfloat den = 1.0f / s->div;\n313\t\tswitch (s->count) {\n314\t\t\tcase 1:\n315\t\t\t\t*a = s->a.sA;\n316\t\t\t\t*b = s->a.sB;\n317\t\t\t\tbreak;\n318\t\t\tcase 2:\n319\t\t\t\t*a = c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\n320\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u)));\n321\t\t\t\t*b = c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\n322\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u)));\n323\t\t\t\tbreak;\n324\t\t\tcase 3:\n325\t\t\t\t*a = c2Add(c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\n326\t\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u))),\n327\t\t\t\t\t\tc2Mulvs(s->c.sA, (den * s->c.u)));\n328\t\t\t\t*b = c2Add(c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\n329\t\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u))),\n330\t\t\t\t\t\tc2Mulvs(s->c.sB, (den * s->c.u)));\n331\t\t\t\tbreak;\n332\t\t\tdefault:\n333\t\t\t\t*a = c2V(0, 0);\n334\t\t\t\t*b = c2V(0, 0);\n335\t\t}\n336\t}\n337\t\n338\tc2v c2Div(c2v a, float b) {\n339\t\treturn c2Mulvs(a, 1.0f / b);\n340\t}\n341\t\n342\tc2v c2Norm(c2v a) {\n343\t\treturn c2Div(a, c2Len(a));\n344\t}\n345\t\n346\tc2v c2L(c2Simplex *s) {\n347\t    float den = 1.0f / s->div;\n348\t    switch (s->count) {\n349\t    case 1:\n350\t        return s->a.p;\n351\t    case 2:\n352\t        return c2Add(c2Mulvs(s->a.p, (den * s->a.u)),\n353\t                     c2Mulvs(s->b.p, (den * s->b.u)));\n354\t    default:\n355\t        return c2V(0, 0);\n356\t    }\n357\t}\n358\t\n359\tc2v c2MulrvT(c2r a, c2v b) {\n360\t    return c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y);\n361\t}\n362\t\n363\tfloat c2GJK(const void *A, C2_TYPE typeA, const c2x *ax_ptr, const void *B,\n364\t\t\tC2_TYPE typeB, const c2x *bx_ptr, c2v *outA, c2v *outB,\n365\t\t\tint use_radius, int *iterations, c2GJKCache *cache) {\n366\t\tc2x ax;\n367\t\tc2x bx;\n368\t\tif (!ax_ptr)\n369\t\t\tax = c2xIdentity();\n370\t\telse\n371\t\t\tax = *ax_ptr;\n372\t\tif (!bx_ptr)\n373\t\t\tbx = c2xIdentity();\n374\t\telse\n375\t\t\tbx = *bx_ptr;\n376\t\tc2Proxy pA;\n377\t\tc2Proxy pB;\n378\t\tc2MakeProxy(A, typeA, &pA);\n379\t\tc2MakeProxy(B, typeB, &pB);\n380\t\tc2Simplex s;\n381\t\tc2sv *verts = &s.a;\n382\t\tint cache_was_read = 0;\n383\t\tif (cache) {\n384\t\t\tint cache_was_good = !!cache->count;\n385\t\t\tif (cache_was_good) {\n386\t\t\t\tfor (int i = 0; i < cache->count; ++i) {\n387\t\t\t\t\tint iA = cache->iA[i];\n388\t\t\t\t\tint iB = cache->iB[i];\n389\t\t\t\t\tc2v sA = c2Mulxv(ax, pA.verts[iA]);\n390\t\t\t\t\tc2v sB = c2Mulxv(bx, pB.verts[iB]);\n391\t\t\t\t\tc2sv *v = verts + i;\n392\t\t\t\t\tv->iA = iA;\n393\t\t\t\t\tv->sA = sA;\n394\t\t\t\t\tv->iB = iB;\n395\t\t\t