[?25l[0m[38;5;141m> [0mNow I need to generate the tables.rs file with the exact half-float lookup tables from the C code. Let me extract them programmatically:[0m[0m
[?25l[0m[0mI will run the following command: [38;5;141mcd /tmp/harvest-translate-PVfjEt/translated_rust && python3 -c "
import re

with open('c_src/src/lib.c', 'r') as f:
    content = f.read()

# Extract m__mantissa table
m = re.search(r'static uint32_t m__mantissa\[2048\] = \{([^;]+)\};', content, re.DOTALL)
mantissa_text = m.group(1)
mantissa_vals = re.findall(r'0x[0-9a-fA-F]+', mantissa_text)
assert len(mantissa_vals) == 2048, f'Got {len(mantissa_vals)} mantissa values'

# Extract m__offset table
m = re.search(r'static uint16_t m__offset\[64\] = \{([^;]+)\};', content, re.DOTALL)
offset_text = m.group(1)
offset_vals = re.findall(r'0x[0-9a-fA-F]+', offset_text)
assert len(offset_vals) == 64, f'Got {len(offset_vals)} offset values'

# Extract m__exponent table
m = re.search(r'static uint32_t m__exponent\[64\] = \{([^;]+)\};', content, re.DOTALL)
exp_text = m.group(1)
exp_vals = re.findall(r'0x[0-9a-fA-F]+', exp_text)
assert len(exp_vals) == 64, f'Got {len(exp_vals)} exponent values'

with open('src/tables.rs', 'w') as f:
    # Mantissa
    f.write('static M_MANTISSA_TABLE: [u32; 2048] = [\n')
    for i in range(0, 2048, 8):
        chunk = mantissa_vals[i:i+8]
        f.write('    ' + ', '.join(chunk) + ',\n')
    f.write('];\n\n')

    # Offset
    f.write('static M_OFFSET: [u16; 64] = [\n')
    for i in range(0, 64, 8):
        chunk = offset_vals[i:i+8]
        f.write('    ' + ', '.join(chunk) + ',\n')
    f.write('];\n\n')

    # Exponent
    f.write('static M_EXPONENT: [u32; 64] = [\n')
    for i in range(0, 64, 8):
        chunk = exp_vals[i:i+8]
        f.write('    ' + ', '.join(chunk) + ',\n')
    f.write('];\n')

print('tables.rs generated successfully')
"
