import re

with open("/tmp/harvest-translate-BppNfX/translated_rust/c_src/include/lib.h") as f:
    header = f.read()

# Extract all hex values from the table
nums = re.findall(r'0x[0-9a-fA-F]+', header)
# Skip the typedefs - the table values start after the array declaration
# Find the start of the table data
table_start = header.index('{', header.index('tflac_crc16_tables'))
table_section = header[table_start:]
nums = re.findall(r'0x[0-9a-fA-F]+', table_section)

# Should be 8*256 = 2048 values
assert len(nums) == 2048, f"Expected 2048, got {len(nums)}"

lines = []
lines.append("use std::ffi::c_uint;")
lines.append("")
lines.append("type TflacU8 = u8;")
lines.append("type TflacU16 = u16;")
lines.append("type TflacU32 = c_uint;")
lines.append("")
lines.append("static TFLAC_CRC16_TABLES: [[TflacU16; 256]; 8] = [")

for t in range(8):
    lines.append("    [")
    for row in range(32):  # 256/8 = 32 rows of 8
        vals = nums[t*256 + row*8 : t*256 + row*8 + 8]
        lines.append("        " + ", ".join(vals) + ",")
    lines.append("    ],")

lines.append("];")
lines.append("")
lines.append("#[unsafe(no_mangle)]")
lines.append('pub extern "C" fn crc16(d: *const TflacU8, len: TflacU32, crc16: TflacU16) -> TflacU16 {')
lines.append("    let mut d = d;")
lines.append("    let mut len = len;")
lines.append("    let mut crc = crc16;")
lines.append("    unsafe {")
lines.append("        while len >= 8 {")
lines.append("            crc ^= (*d.add(0) as u16) << 8 | (*d.add(1) as u16);")
lines.append("            crc = TFLAC_CRC16_TABLES[7][(crc >> 8) as usize]")
lines.append("                ^ TFLAC_CRC16_TABLES[6][(crc & 0xFF) as usize]")
lines.append("                ^ TFLAC_CRC16_TABLES[5][*d.add(2) as usize]")
lines.append("                ^ TFLAC_CRC16_TABLES[4][*d.add(3) as usize]")
lines.append("                ^ TFLAC_CRC16_TABLES[3][*d.add(4) as usize]")
lines.append("                ^ TFLAC_CRC16_TABLES[2][*d.add(5) as usize]")
lines.append("                ^ TFLAC_CRC16_TABLES[1][*d.add(6) as usize]")
lines.append("                ^ TFLAC_CRC16_TABLES[0][*d.add(7) as usize];")
lines.append("            d = d.add(8);")
lines.append("            len -= 8;")
lines.append("        }")
lines.append("        while len > 0 {")
lines.append("            len -= 1;")
lines.append("            crc = (crc << 8) ^ TFLAC_CRC16_TABLES[0][((crc >> 8) ^ (*d as u16)) as usize];")
lines.append("            d = d.add(1);")
lines.append("        }")
lines.append("    }")
lines.append("    crc")
lines.append("}")

with open("/tmp/harvest-translate-BppNfX/translated_rust/src/lib.rs", "w") as f:
    f.write("\n".join(lines) + "\n")

print("Generated src/lib.rs successfully")
