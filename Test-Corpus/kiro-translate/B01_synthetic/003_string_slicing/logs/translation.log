pass=0; fail=0

compare() {
    local desc="$1"; shift
    c_out=$("$C" "$@" 2>&1); c_rc=$?
    r_out=$("$R" "$@" 2>&1); r_rc=$?
    if [ "$c_out" = "$r_out" ] && [ "$c_rc" = "$r_rc" ]; then
        pass=$((pass+1))
    else
        fail=$((fail+1))
        echo "FAIL: $desc"
        echo "  C (rc=$c_rc): $(echo "$c_out" | xxd | head -3)"
        echo "  R (rc=$r_rc): $(echo "$r_out" | xxd | head -3)"
    fi
}

