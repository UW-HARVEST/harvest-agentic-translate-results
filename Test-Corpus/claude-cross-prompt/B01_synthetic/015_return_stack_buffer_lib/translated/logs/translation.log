ement on overflow, matching common C int (32-bit) behavior.\nfn scanf_int<R: Read>(reader: &mut R) -> Option<i32> {\n    let mut buf = [0u8; 1];\n\n    // Skip whitespace.\n    let mut c;\n    loop {\n        let n = reader.read(&mut buf).ok()?;\n        if n == 0 {\n            return None;\n        }\n        c = buf[0];\n        if !(c == b' ' || c == b'\\t' || c == b'\\n' || c == b'\\r' || c == 0x0B || c == 0x0C) {\n            break;\n        }\n    }\n\n    let mut negative = false;\n    if c == b'-' {\n        negative = true;\n        let n = reader.read(&mut buf).ok()?;\n        if n == 0 {\n            return None;\n        }\n        c = buf[0];\n    } else if c == b'+' {\n        let n = reader.read(&mut buf).ok()?;\n        if n == 0 {\n            return None;\n        }\n        c = buf[0];\n    }\n\n    if !c.is_ascii_digit() {\n        return None;\n    }\n\n    let mut value: i32 = 0;\n    loop {\n        if c.is_ascii_digit() {\n            let digit = (c - b'0') as i32;\n            value = value.wrapping_mul(10).wrapping_add(digit);\n            let n = reader.read(&mut buf).ok()?;\n            if n == 0 {\n                break;\n            }\n            c = buf[0];\n        } else {\n            break;\n        }\n    }\n\n    if negative {\n        value = value.wrapping_neg();\n    }\n    Some(value)\n}\n\nfn main() {\n    let stdin = io::stdin();\n    let mut handle = stdin.lock();\n    let use_good = scanf_int(&mut handle).unwrap_or(0);\n    driver(use_good);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":149,"cache_read_input_tokens":18384,"cache_creation":{"ephemeral_5m_input_tokens":149,"ephemeral_1h_input_tokens":0},"output_tokens":36,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"181b56ce-2bfc-452c-a3ea-47107c1a5ba6","uuid":"f69f25b5-e664-4d2c-839c-7a799518d774"}
