har {\n    static mut CHAR_STRING: [c_char; 19] = [\n        b'h' as c_char,\n        b'e' as c_char,\n        b'l' as c_char,\n        b'p' as c_char,\n        b'e' as c_char,\n        b'r' as c_char,\n        b'G' as c_char,\n        b'o' as c_char,\n        b'o' as c_char,\n        b'd' as c_char,\n        b'1' as c_char,\n        b' ' as c_char,\n        b's' as c_char,\n        b't' as c_char,\n        b'r' as c_char,\n        b'i' as c_char,\n        b'n' as c_char,\n        b'g' as c_char,\n        0,\n    ];\n    unsafe { (&raw mut CHAR_STRING) as *mut c_char }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn good() {\n    printLine(helper_good1());\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn main() -> c_int {\n    let mut x: c_int = 0;\n    let fmt = b\"%d\\0\".as_ptr() as *const c_char;\n    scanf(fmt, &mut x as *mut c_int);\n\n    if x != 0 {\n        good();\n    } else {\n        bad();\n    }\n\n    0\n}\n","structuredPatch":[{"oldStart":68,"oldLines":7,"newStart":68,"newLines":7,"lines":["         b'g' as c_char,","         0,","     ];","-    unsafe { (&raw mut CHAR_STRING) as *mut c_char }","+    (&raw mut CHAR_STRING) as *mut c_char"," }"," "," #[unsafe(no_mangle)]"]}],"userModified":false,"replaceAll":false}}
