ow.h\"\n\n#include <errno.h>\n#include <math.h>\n#include <stdio.h>\n#include <stdlib.h>\n\n// Takes two arguments, a base and an exponent, and returns base^exponent\ndouble my_pow(double base, double exponent) {\n  // Calculate power\n  errno = 0;\n  double result = pow(base, exponent);\n  if (errno == EDOM) {\n    fprintf(stderr,\n            \"Domain error: pow(%.2f, %.2f) is undefined in the real number \"\n            \"domain.\\n\",\n            base, exponent);\n    return -1;\n  } else if (errno == ERANGE) {\n    fprintf(stderr,\n            \"Range error: pow(%.2f, %.2f) caused overflow or underflow.\\n\",\n            base, exponent);\n    return -1;\n  }\n\n  return result;\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
