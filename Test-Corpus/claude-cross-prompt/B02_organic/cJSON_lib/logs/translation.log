   codepoint = first_code;\n726\t    }\n727\t\n728\t    /* encode as UTF-8\n729\t     * takes at maximum 4 bytes to encode:\n730\t     * 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx */\n731\t    if (codepoint < 0x80)\n732\t    {\n733\t        /* normal ascii, encoding 0xxxxxxx */\n734\t        utf8_length = 1;\n735\t    }\n736\t    else if (codepoint < 0x800)\n737\t    {\n738\t        /* two bytes, encoding 110xxxxx 10xxxxxx */\n739\t        utf8_length = 2;\n740\t        first_byte_mark = 0xC0; /* 11000000 */\n741\t    }\n742\t    else if (codepoint < 0x10000)\n743\t    {\n744\t        /* three bytes, encoding 1110xxxx 10xxxxxx 10xxxxxx */\n745\t        utf8_length = 3;\n746\t        first_byte_mark = 0xE0; /* 11100000 */\n747\t    }\n748\t    else if (codepoint <= 0x10FFFF)\n749\t    {\n750\t        /* four bytes, encoding 1110xxxx 10xxxxxx 10xxxxxx 10xxxxxx */\n751\t        utf8_length = 4;\n752\t        first_byte_mark = 0xF0; /* 11110000 */\n753\t    }\n754\t    else\n755\t    {\n756\t        /* invalid unicode codepoint */\n757\t        goto fail;\n758\t    }\n759\t\n760\t    /* encode as utf8 */\n761\t    for (utf8_position = (unsigned char)(utf8_length - 1); utf8_position > 0; utf8_position--)\n762\t    {\n763\t        /* 10xxxxxx */\n764\t        (*output_pointer)[utf8_position] = (unsigned char)((codepoint | 0x80) & 0xBF);\n765\t        codepoint >>= 6;\n766\t    }\n767\t    /* encode first byte */\n768\t    if (utf8_length > 1)\n769\t    {\n770\t        (*output_pointer)[0] = (unsigned char)((codepoint | first_byte_mark) & 0xFF);\n771\t    }\n772\t    else\n773\t    {\n774\t        (*output_pointer)[0] = (unsigned char)(codepoint & 0x7F);\n775\t    }\n776\t\n777\t    *output_pointer += utf8_length;\n778\t\n779\t    return sequence_length;\n780\t\n781\tfail:\n782\t    return 0;\n783\t}\n784\t\n785\t/* Parse the input text into an unescaped cinput, and populate item. */\n786\tstatic cJSON_bool parse_string(cJSON * const item, parse_buffer * const input_buffer)\n787\