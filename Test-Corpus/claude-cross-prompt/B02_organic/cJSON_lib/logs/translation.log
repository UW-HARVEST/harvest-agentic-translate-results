onst unsigned char*)string, &global_hooks);\n2490\t        if(!item->valuestring)\n2491\t        {\n2492\t            cJSON_Delete(item);\n2493\t            return NULL;\n2494\t        }\n2495\t    }\n2496\t\n2497\t    return item;\n2498\t}\n2499\t\n2500\tCJSON_PUBLIC(cJSON *) cJSON_CreateStringReference(const char *string)\n2501\t{\n2502\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2503\t    if (item != NULL)\n2504\t    {\n2505\t        item->type = cJSON_String | cJSON_IsReference;\n2506\t        item->valuestring = (char*)cast_away_const(string);\n2507\t    }\n2508\t\n2509\t    return item;\n2510\t}\n2511\t\n2512\tCJSON_PUBLIC(cJSON *) cJSON_CreateObjectReference(const cJSON *child)\n2513\t{\n2514\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2515\t    if (item != NULL) {\n2516\t        item->type = cJSON_Object | cJSON_IsReference;\n2517\t        item->child = (cJSON*)cast_away_const(child);\n2518\t    }\n2519\t\n2520\t    return item;\n2521\t}\n2522\t\n2523\tCJSON_PUBLIC(cJSON *) cJSON_CreateArrayReference(const cJSON *child) {\n2524\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2525\t    if (item != NULL) {\n2526\t        item->type = cJSON_Array | cJSON_IsReference;\n2527\t        item->child = (cJSON*)cast_away_const(child);\n2528\t    }\n2529\t\n2530\t    return item;\n2531\t}\n2532\t\n2533\tCJSON_PUBLIC(cJSON *) cJSON_CreateRaw(const char *raw)\n2534\t{\n2535\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2536\t    if(item)\n2537\t    {\n2538\t        item->type = cJSON_Raw;\n2539\t        item->valuestring = (char*)cJSON_strdup((const unsigned char*)raw, &global_hooks);\n2540\t        if(!item->valuestring)\n2541\t        {\n2542\t            cJSON_Delete(item);\n2543\t            return NULL;\n2544\t        }\n2545\t    }\n2546\t\n2547\t    return item;\n2548\t}\n2549\t\n2550\tCJSON_PUBLIC(cJSON *) cJSON_CreateArray(void)\n2551\t{\n2552\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2553\t    if(item)\n2554\t    {\n2555\t        i