eturn 0;\n107\t}\n108\t\n109\t/* Create a bunch of objects as demonstration. */\n110\tstatic void create_objects(const char *strings[7], int numbers[3][3], int ids[4], struct record fields[2])\n111\t{\n112\t    /* declare a few. */\n113\t    cJSON *root = NULL;\n114\t    cJSON *fmt = NULL;\n115\t    cJSON *img = NULL;\n116\t    cJSON *thm = NULL;\n117\t    cJSON *fld = NULL;\n118\t    int i = 0;\n119\t\n120\t    volatile double zero = 0.0;\n121\t\n122\t    /* Here we construct some JSON standards, from the JSON site. */\n123\t\n124\t    /* Our \"Video\" datatype: */\n125\t    root = cJSON_CreateObject();\n126\t    cJSON_AddItemToObject(root, \"name\", cJSON_CreateString(\"Jack (\\\"Bee\\\") Nimble\"));\n127\t    cJSON_AddItemToObject(root, \"format\", fmt = cJSON_CreateObject());\n128\t    cJSON_AddStringToObject(fmt, \"type\", \"rect\");\n129\t    cJSON_AddNumberToObject(fmt, \"width\", 1920);\n130\t    cJSON_AddNumberToObject(fmt, \"height\", 1080);\n131\t    cJSON_AddFalseToObject (fmt, \"interlace\");\n132\t    cJSON_AddNumberToObject(fmt, \"frame rate\", 24);\n133\t\n134\t    /* Print to text */\n135\t    if (print_preallocated(root) != 0) {\n136\t        cJSON_Delete(root);\n137\t        exit(EXIT_FAILURE);\n138\t    }\n139\t    cJSON_Delete(root);\n140\t\n141\t    /* Our \"days of the week\" array: */\n142\t    root = cJSON_CreateStringArray(strings, 7);\n143\t\n144\t    if (print_preallocated(root) != 0) {\n145\t        cJSON_Delete(root);\n146\t        exit(EXIT_FAILURE);\n147\t    }\n148\t    cJSON_Delete(root);\n149\t\n150\t    /* Our matrix: */\n151\t    root = cJSON_CreateArray();\n152\t    for (i = 0; i < 3; i++)\n153\t    {\n154\t        cJSON_AddItemToArray(root, cJSON_CreateIntArray(numbers[i], 3));\n155\t    }\n156\t\n157\t    /* cJSON_ReplaceItemInArray(root, 1, cJSON_CreateString(\"Replacement\")); */\n158\t\n159\t    if (print_preallocated(root) != 0) {\n160\t        cJSON_Delete(root);\n161\t        exit(EXIT_FAILURE);\n162\t    }\n163\t    cJS