{\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\npub fn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\npub fn c2RotIdentity() -> c2r {\n    c2r { c: 1.0, s: 0.0 }\n}\n\npub fn c2xIdentity() -> c2x {\n    c2x {\n        p: c2V(0.0, 0.0),\n        r: c2RotIdentity(),\n    }\n}\n\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Proxy {\n    pub radius: f32,\n    pub count: i32,\n    pub verts: [c2v; 8],\n}\n\npub fn c2BBVerts(out: &mut [c2v], bb: &c2AABB) {\n    out[0] = bb.min;\n    out[1] = c2V(bb.max.x, bb.min.y);\n    out[2] = bb.max;\n    out[3] = c2V(bb.min.x, bb.max.y);\n}\n\npub enum Shape {\n    Circle(c2Circle),\n    AABB(c2AABB),\n    Capsule(c2Capsule),\n}\n\npub fn c2MakeProxy(shape: &Shape, _type: C2_TYPE, p: &mut c2Proxy) {\n    match shape {\n        Shape::Circle(c) => {\n            p.radius = c.r;\n            p.count = 1;\n            p.verts[0] = c.p;\n        }\n        Shape::AABB(bb) => {\n            p.radius = 0.0;\n            p.count = 4;\n            c2BBVerts(&mut p.verts, bb);\n        }\n        Shape::Capsule(c) => {\n            p.radius = c.r;\n            p.count = 2;\n            p.verts[0] = c.a;\n            p.verts[1] = c.b;\n        }\n    }\n}\n\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2sv {\n    pub sA: c2v,\n    pub sB: c2v,\n    pub p: c2v,\n    pub u: f32,\n    pub iA: i32,\n    pub iB: i32,\n}\n\n#[derive(Copy, Clone, Debug, Default)]\npub struct c2Simplex {\n    pub a: c2sv,\n    pub b: c2sv,\n    pub c: c2sv,\n    pub d: c2sv,\n    pub div: f32,\n    pub count: i32,\n}\n\nimpl c2Simplex {\n    fn get(&self, i: usize) -> c2sv {\n        match i {\n            0 => self.a,\n            1 => self.b,\n            2 => self.c,\n            3 => self.d,\n            _ => panic!(\"simplex index out of bounds\"),\n        }\n    }\n    fn set(&mut self, i: usize, v: c2sv) {\n        match i {\n            0 => self.a = v,\n            1 => self.b = v,\n            2 => self.c = v,\n            3