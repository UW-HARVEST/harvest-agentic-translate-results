ult();\n    bb.min = c2V(a1, a2);\n    bb.max = c2V(a3, a4);\n\n    let mut cap = c2Capsule::default();\n    cap.a = c2V(b1, b2);\n    cap.b = c2V(b3, b4);\n    cap.r = b5;\n\n    let cap_shape = Shape::Capsule(cap);\n    let bb_shape = Shape::AABB(bb);\n\n    if reverse != 0 {\n        c2GJK(\n            &cap_shape,\n            C2_TYPE::C2_TYPE_CAPSULE,\n            None,\n            &bb_shape,\n            C2_TYPE::C2_TYPE_AABB,\n            None,\n            Some(&mut a),\n            Some(&mut b),\n            1,\n            None,\n            None,\n        );\n    } else {\n        c2GJK(\n            &bb_shape,\n            C2_TYPE::C2_TYPE_AABB,\n            None,\n            &cap_shape,\n            C2_TYPE::C2_TYPE_CAPSULE,\n            None,\n            Some(&mut a),\n            Some(&mut b),\n            1,\n            None,\n            None,\n        );\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
