gn = -1;\n        idx += 1;\n    }\n    let start = idx;\n    let mut value: i64 = 0;\n    while idx < bytes.len() && (bytes[idx] as char).is_ascii_digit() {\n        value = value\n            .wrapping_mul(10)\n            .wrapping_add((bytes[idx] - b'0') as i64);\n        idx += 1;\n    }\n    if idx == start {\n        return None;\n    }\n    Some(value.wrapping_mul(sign) as i32)\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
