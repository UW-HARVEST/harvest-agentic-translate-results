{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' c_src/include/read-alert.h\"","aggregated_output":"/* Copyright (C) 2015, Wazuh Inc.\n * Copyright (C) 2009 Trend Micro Inc.\n * All right reserved.\n *\n * This program is free software; you can redistribute it\n * and/or modify it under the terms of the GNU General Public\n * License (version 2) as published by the FSF - Free Software\n * Foundation\n */\n\n#ifndef CRALERT_H\n#define CRALERT_H\n\n#include <stdio.h>\n\n#define ALERTS_DAILY \"alerts.log\"\n\n#define CRALERT_MAIL_SET    0x001\n#define CRALERT_EXEC_SET    0x002\n#define CRALERT_READ_ALL    0x004\n#define CRALERT_READ_FAILED 0x008\n#define CRALERT_FP_SET      0x010\n\n/* File queue */\ntypedef struct alert_data {\n    unsigned int rule;\n    unsigned int level;\n    char *alertid;\n    char *date;\n    char *location;\n    char *comment;\n    char *group;\n    char *srcip;\n    int srcport;\n    char *dstip;\n    int dstport;\n    char *user;\n    char *filename;\n} alert_data;\n\nalert_data *GetAlertData(int flag, FILE *fp) __attribute__((nonnull));\nvoid        FreeAlertData(alert_data *al_data) __attribute__((nonnull));\n\n#endif /* CRALERT_H */\n","exit_code":0,"status":"completed"}}
