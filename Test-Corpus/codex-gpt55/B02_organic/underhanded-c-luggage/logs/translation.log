{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'nl -ba c_src/src/luggage.c'","aggregated_output":"     1\t// By Jan Wrobel <wrr@mixedbit.org>\n     2\t\n     3\t#include <stdio.h>\n     4\t#include <stdlib.h>\n     5\t#include <string.h>\n     6\t\n     7\t#define LUGGAGE_ID_LENGTH 8\n     8\t#define FLIGHT_ID_LENGTH 6\n     9\t#define AIRPORT_CODE_LENGTH 3\n    10\t#define COMMENTS_LENGTH 80\n    11\t\n    12\ttypedef struct RoutingDirective {\n    13\t\tunsigned int time_stamp;\n    14\t\tchar luggage_id[LUGGAGE_ID_LENGTH + 1];\n    15\t\tchar flight_id[FLIGHT_ID_LENGTH + 1];\n    16\t\tchar departure[AIRPORT_CODE_LENGTH + 1];\n    17\t\tchar arrival[AIRPORT_CODE_LENGTH + 1];\n    18\t\tchar comments[COMMENTS_LENGTH + 1];\n    19\t\tstruct RoutingDirective *next_directive;\n    20\t} RoutingDirective;\n    21\t\n    22\tvoid addRoutingDirectiveToList(RoutingDirective *previous_directive,\n    23\t\t\t\t       RoutingDirective *new_directive) {\n    24\t\tRoutingDirective *next_directive = previous_directive->next_directive;\n    25\t\tif (next_directive == NULL ||\n    26\t\t    next_directive->time_stamp > new_directive->time_stamp) {\n    27\t\t\tnew_directive->next_directive = next_directive;\n    28\t\t\tprevious_directive->next_directive = new_directive;\n    29\t\t} else {\n    30\t\t\taddRoutingDirectiveToList(next_directive, new_directive);\n    31\t\t}\n    32\t}\n    33\t\n    34\tint supersedes(RoutingDirective *directive, char *luggage_id, char *departure) {\n    35\t\tif (directive == NULL) {\n    36\t\t\treturn 0;\n    37\t\t}\n    38\t\tif (strcmp(directive->luggage_id, luggage_id) != 0) {\n    39\t\t\treturn supersedes(directive->next_directive,\n    40\t\t\t\t\t  luggage_id,\n    41\t\t\t\t\t  departure);\n    42\t\t}\n    43\t\tif (strcmp(directive->departure, departure) == 0) {\n    44\t\t\treturn 1;\n    45\t\t}\n    46\t\treturn 0;\n    47\t}\n    48\t\n    49\tint superseded(RoutingDirective *directive) {\n    50\t\treturn supersedes(directive->next_directive,\n    51\t\t\t\t  directive->luggage_id,\n    52\t\t\t\t  directive->departure);\n    53\t}\n    54\t\n    55\t\n    56\tint matches(char* expected, char* actual) {\n    57\t\treturn (expected[0] == '-' || strcmp(expected, actual) == 0);\n    58\t}\n    59\t\n    60\tvoid printMatchingDirectives(RoutingDirective* first_directive,\n    61\t\t\t\t     char *expected_luggage_id,\n    62\t\t\t\t     char *expected_flight_id,\n    63\t\t\t\t     char *expected_departure,\n    64\t\t\t\t     char *expected_arrival) {\n    65\t\tRoutingDirective *directive;\n    66\t\tfor (directive = first_directive; directive != NULL;\n    67\t\t     directive = directive->next_directive) {\n    68\t\t\tif (!superseded(directive) &&\n    69\t\t\t    matches(expected_luggage_id, directive->luggage_id) &&\n    70\t\t\t    matches(expected_flight_id, directive->flight_id) &&\n    71\t\t\t    matches(expected_departure, directive->departure) &&\n    72\t\t\t    matches(expected_arrival, directive->arrival)) {\n    73\t                        printf(\"%010u %s %s %s %s %s\\n\",\n    74\t\t\t\t       directive->time_stamp,\n    75\t\t\t\t       directive->luggage_id,\n    76\t\t\t\t       directive->flight_id,\n    77\t\t\t\t       directive->departure,\n    78\t\t\t\t       directive->arrival,\n    79\t\t\t\t       directive->comments);\n    80\t\t\t}\n    81\t\t}\n    82\t}\n    83\t\n    84\tint main(int argc, char *argv[]) {\n    85\t        if (argc != 5) {\n    86\t                fprintf(stderr, \"Command line error: 4 arguments expected\\n\");\n    87\t                exit(1);\n    88\t        }\n    89\t\tRoutingDirective directive_list_head;\n    90\t\tdirective_list_head.time_stamp = 0;\n    91\t\tdirective_list_head.next_directive = NULL;\n    92\t\n    93\t\twhile (1) {\n    94\t\t\tunsigned int time_stamp;\n    95\t\t\tchar luggage_id[LUGGAGE_ID_LENGTH + 1];\n    96\t\t\tchar flight_id[FLIGHT_ID_LENGTH + 1];\n    97\t\t\tchar departure[AIRPORT_CODE_LENGTH + 1];\n    98\t\t\tchar arrival[AIRPORT_CODE_LENGTH + 1];\n    99\t\t\tchar comments[COMMENTS_LENGTH + 1];\n   100\t\t\tcomments[0] = 0; // comments are optional.\n   101\t\n   102\t\t\tif (scanf(\"%d \", &time_stamp) == EOF) {\n   103\t\t\t\tbreak;\n   104\t\t\t}\n   105\t\t\tif (scanf(\"%8[A-Z0-9] %6[A-Z0-9] \",\n   106\t\t\t\t  luggage_id, flight_id) == EOF) {\n   107\t\t\t\tbreak;\n   108\t\t\t}\n   109\t\t\tif (scanf(\"%3[A-Z] %3[A-Z]\", departure, arrival) == EOF) {\n   110\t\t\t\tbreak;\n   111\t\t\t}\n   112\t\t\tif (scanf(\"%80[^\\n]\", comments) == EOF) {\n   113\t\t\t\tbreak;\n   114\t\t\t}\n   115\t\n   116\t\t\tRoutingDirective *new_directive =\n   117\t\t\t\t(RoutingDirective*) calloc(1, sizeof(RoutingDirective));\n   118\t\t\tnew_directive->time_stamp = time_stamp;\n   119\t\t\tstrcpy(new_directive->luggage_id, luggage_id);\n   120\t\t\tstrcpy(new_directive->flight_id, flight_id);\n   121\t\t\tstrcpy(new_directive->departure, departure);\n   122\t\t\tstrcpy(new_directive->arrival, arrival);\n   123\t\t\tstrcpy(new_directive->comments, comments);\n   124\t\t\tnew_directive->next_directive = NULL;\n   125\t\n   126\t\t\taddRoutingDirectiveToList(&directive_list_head, new_directive);\n   127\t\t}\n   128\t\tprintMatchingDirectives(directive_list_head.next_directive,\n   129\t\t\t\t\targv[1], argv[2], argv[3], argv[4]);\n   130\t        exit(0);\n   131\t}\n","exit_code":0,"status":"completed"}}
