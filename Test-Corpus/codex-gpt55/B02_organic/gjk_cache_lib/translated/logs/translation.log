, c2Capsule(c2v(10,-2), c2v(12,5), c_float(1.5)), 2),\n    (c2Circle(c2v(0,0), c_float(15)), 0, c2Capsule(c2v(100,-25), c2v(75,100), c_float(10)), 2),\n    (c2AABB(c2v(0,0), c2v(5,5)), 1, c2Capsule(c2v(1,1), c2v(2,3), c_float(0.5)), 2),\n    (c2Circle(c2v(-3.25,7.5), c_float(2.25)), 0, c2AABB(c2v(8,-1), c2v(9,6)), 1),\n]\nfor i, (A,ta,B,tb) in enumerate(cases):\n    c0, c1 = c2GJKCache(), c2GJKCache()\n    r0 = call(libs[0], A, ta, B, tb, 1, c0)\n    r1 = call(libs[1], A, ta, B, tb, 1, c1)\n    if r0 \"'!= r1:\n        print('\"'mismatch first', i, r0, r1); raise SystemExit(1)\n    r0b = call(libs[0], A, ta, B, tb, 1, c0)\n    r1b = call(libs[1], A, ta, B, tb, 1, c1)\n    if r0b \"'!= r1b:\n        print('\"'mismatch cached', i, r0b, r1b); raise SystemExit(1)\n\nfor reverse in (0,1,2,255):\n    a0,b0,a1,b1 = c2v(123,456), c2v(789,321), c2v(123,456), c2v(789,321)\n    libs[0].gjk_cache(ctypes.c_char(reverse), ctypes.byref(a0), ctypes.byref(b0), -1,-2,3,4,10,-2,12,5,1.5)\n    libs[1].gjk_cache(ctypes.c_char(reverse), ctypes.byref(a1), ctypes.byref(b1), -1,-2,3,4,10,-2,12,5,1.5)\n    if (vbits(a0),vbits(b0)) \"'!= (vbits(a1),vbits(b1)):\n        print('\"'mismatch gjk_cache', reverse, vbits(a0), vbits(a1), vbits(b0), vbits(b1)); raise SystemExit(1)\nprint('ctypes comparison passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
