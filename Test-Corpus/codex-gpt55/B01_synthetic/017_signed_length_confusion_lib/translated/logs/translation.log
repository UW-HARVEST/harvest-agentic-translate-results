{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"gcc -shared -fPIC -I c_src/include c_src/src/driver.c -o /tmp/harvest_c_driver.so && python3 - <<'PY'\nimport ctypes, os, sys\n\nlibc = ctypes.CDLL(None)\nlibs = [\n    ('c', ctypes.CDLL('/tmp/harvest_c_driver.so')),\n    ('rust', ctypes.CDLL('target/release/libdriver.so')),\n]\nfor _, lib in libs:\n    lib.driver.argtypes = [ctypes.c_int]\n    lib.driver.restype = None\n\ndef capture(fn, value):\n    r, w = os.pipe()\n    saved = os.dup(1)\n    try:\n        os.dup2(w, 1)\n        os.close(w)\n        fn(value)\n        libc.fflush(None)\n        os.dup2(saved, 1)\n        chunks = []\n        while True:\n            data = os.read(r, 4096)\n            if not data:\n                break\n            chunks.append(data)\n        return b''.join(chunks)\n    finally:\n        try:\n            os.dup2(saved, 1)\n        except OSError:\n            pass\n        os.close(saved)\n        os.close(r)\n\nfor value in [0, 1, 5, 99, 100, 101]:\n    c_out = capture(libs[0][1].driver, value)\n    rust_out = capture(libs[1][1].driver, value)\n    print(value, c_out == rust_out, repr(c_out), repr(rust_out))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
