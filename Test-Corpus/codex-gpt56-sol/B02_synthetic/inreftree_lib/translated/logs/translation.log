ht_child_id;\r\n    42\t    char label[32];\r\n    43\t} TreeNode;\r\n    44\t\r\n    45\t#define MAX_NODES 50\r\n    46\tTreeNode node_table[MAX_NODES];\r\n    47\tint node_count = 0;\r\n    48\t\r\n    49\ttypedef int (*OperationFunc)(int a, int b, int unused1, int unused2);\r\n    50\t\r\n    51\tint add_op(int a, int b, int unused1, int unused2) {\r\n    52\t    return a + b;\r\n    53\t}\r\n    54\t\r\n    55\tint multiply_op(int a, int b, int unused1, int unused2) {\r\n    56\t    return a * b;\r\n    57\t}\r\n    58\t\r\n    59\tint subtract_op(int a, int b, int unused1, int unused2) {\r\n    60\t    return a - b;\r\n    61\t}\r\n    62\t\r\n    63\tint divide_op(int a, int b, int unused1, int unused2) {\r\n    64\t    if (b == 0) return 0;\r\n    65\t    return a / b;\r\n    66\t}\r\n    67\t\r\n    68\tint modulo_op(int a, int b, int unused1, int unused2) {\r\n    69\t    if (b == 0) return 0;\r\n    70\t    return a % b;\r\n    71\t}\r\n    72\t\r\n    73\tTreeNode* find_node_by_id(int id) {\r\n    74\t    for (int i = 0; i < node_count; i++) {\r\n    75\t        if (node_table[i].id == id) {\r\n    76\t            return &node_table[i];\r\n    77\t        }\r\n    78\t    }\r\n    79\t    return NULL;\r\n    80\t}\r\n    81\t\r\n    82\tint add_tree_node(int id, int value, int parent_id, const char* label) {\r\n    83\t    if (node_count >= MAX_NODES) {\r\n    84\t        return -1;\r\n    85\t    }\r\n    86\t\r\n    87\t    TreeNode* node = &node_table[node_count];\r\n    88\t    node->id = id;\r\n    89\t    node->value = value;\r\n    90\t    node->parent_id = parent_id;\r\n    91\t    node->left_child_id = -1;\r\n    92\t    node->right_child_id = -1;\r\n    93\t    strncpy(node->label, label, 31);\r\n    94\t    node->label[31] = '\\0';\r\n    95\t\r\n    96\t    if (parent_id != -1) {\r\n    97\t        TreeNode* parent = find_node_by_id(parent_id);\r\n    98\t        if (parent == NULL || parent->id != parent_id) {\r\n    99\t            return -1