{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"printf '%s\\\\n' '--- lib.rs ---' && nl -ba src/lib.rs && printf '%s\\\\n' '--- config.rs ---' && nl -ba src/config.rs && printf '%s\\\\n' '--- core.rs ---' && nl -ba src/core.rs && printf '%s\\\\n' '--- main.rs ---' && nl -ba src/main.rs\"","aggregated_output":"--- lib.rs ---\n     1\tmod config;\n     2\tmod core;\n--- config.rs ---\n     1\tuse std::ffi::c_int;\n     2\t\n     3\t#[derive(Clone, Copy)]\n     4\tpub(crate) enum Operation {\n     5\t    Add,\n     6\t    Sub,\n     7\t    Mul,\n     8\t}\n     9\t\n    10\tpub(crate) const OPERATION: Operation = if cfg!(feature = \"add\") {\n    11\t    Operation::Add\n    12\t} else if cfg!(feature = \"sub\") {\n    13\t    Operation::Sub\n    14\t} else if cfg!(feature = \"mul\") {\n    15\t    Operation::Mul\n    16\t} else {\n    17\t    Operation::Add\n    18\t};\n    19\t\n    20\tpub(crate) const REPEAT: c_int = if cfg!(feature = \"0\") {\n    21\t    0\n    22\t} else if cfg!(feature = \"1\") {\n    23\t    1\n    24\t} else if cfg!(feature = \"2\") {\n    25\t    2\n    26\t} else if cfg!(feature = \"3\") {\n    27\t    3\n    28\t} else if cfg!(feature = \"4\") {\n    29\t    4\n    30\t} else if cfg!(feature = \"5\") {\n    31\t    5\n    32\t} else if cfg!(feature = \"6\") {\n    33\t    6\n    34\t} else if cfg!(feature = \"7\") {\n    35\t    7\n    36\t} else {\n    37\t    5\n    38\t};\n--- core.rs ---\n     1\tuse std::ffi::{c_char, c_int};\n     2\t\n     3\tuse crate::config::{OPERATION, Operation, REPEAT};\n     4\t\n     5\tpub(crate) type OpFn = extern \"C\" fn(c_int, c_int) -> c_int;\n     6\t\n     7\tunsafe extern \"C\" {\n     8\t    fn printf(format: *const c_char, ...) -> c_int;\n     9\t}\n    10\t\n    11\t#[unsafe(no_mangle)]\n    12\tpub extern \"C\" fn op_add(a: c_int, b: c_int) -> c_int {\n    13\t    a.wrapping_add(b)\n    14\t}\n    15\t\n    16\t#[unsafe(no_mangle)]\n    17\tpub extern \"C\" fn op_sub(a: c_int, b: c_int) -> c_int {\n    18\t    a.wrapping_sub(b)\n    19\t}\n    20\t\n    21\t#[unsafe(no_mangle)]\n    22\tpub extern \"C\" fn op_mul(a: c_int, b: c_int) -> c_int {\n    23\t    a.wrapping_mul(b)\n    24\t}\n    25\t\n    26\tconst fn selected_op() -> OpFn {\n    27\t    match OPERATION {\n    28\t        Operation::Add => op_add,\n    29\t        Operation::Sub => op_sub,\n    30\t        Operation::Mul => op_mul,\n    31\t    }\n    32\t}\n    33\t\n    34\tconst fn initial_value() -> c_int {\n    35\t    match OPERATION {\n    36\t        Operation::Add | Operation::Sub => 0,\n    37\t        Operation::Mul => 1,\n    38\t    }\n    39\t}\n    40\t\n    41\tfn step(acc: c_int, i: c_int) -> c_int {\n    42\t    match OPERATION {\n    43\t        Operation::Add => acc.wrapping_add(i),\n    44\t        Operation::Sub => acc.wrapping_sub(i),\n    45\t        Operation::Mul => acc.wrapping_mul(i.wrapping_add(1)),\n    46\t    }\n    47\t}\n    48\t\n    49\tfn accumulate_steps(n: c_int) -> c_int {\n    50\t    let mut acc = initial_value();\n    51\t    let mut i = 0;\n    52\t    while i < n {\n    53\t        acc = step(acc, i);\n    54\t        i += 1;\n    55\t    }\n    56\t    acc\n    57\t}\n    58\t\n    59\tpub(crate) fn configured_accumulator() -> c_int {\n    60\t    accumulate_steps(REPEAT)\n    61\t}\n    62\t\n    63\tfn generated_accumulator(n: c_int) -> c_int {\n    64\t    match n {\n    65\t        0..=6 => accumulate_steps(n),\n    66\t        _ => initial_value(),\n    67\t    }\n    68\t}\n    69\t\n    70\tpub(crate) fn selected_call(a: c_int, b: c_int) -> c_int {\n    71\t    selected_op()(a, b)\n    72\t}\n    73\t\n    74\t#[unsafe(no_mangle)]\n    75\tpub static mut G_OP: OpFn = selected_op();\n    76\t\n    77\tconst ADD_NAME: &[u8] = b\"add\\0\";\n    78\tconst SUB_NAME: &[u8] = b\"sub\\0\";\n    79\tconst MUL_NAME: &[u8] = b\"mul\\0\";\n    80\t\n    81\tconst fn selected_name() -> *const c_char {\n    82\t    match OPERATION {\n    83\t        Operation::Add => ADD_NAME.as_ptr().cast(),\n    84\t        Operation::Sub => SUB_NAME.as_ptr().cast(),\n    85\t        Operation::Mul => MUL_NAME.as_ptr().cast(),\n    86\t    }\n    87\t}\n    88\t\n    89\t#[unsafe(no_mangle)]\n    90\tpub static mut G_OP_NAME: *const c_char = selected_name();\n    91\t\n    92\t#[unsafe(no_mangle)]\n    93\tpub extern \"C\" fn helper_call(a: c_int, b: c_int) -> c_int {\n    94\t    let r = selected_call(a, b);\n    95\t    let acc = configured_accumulator();\n    96\t    unsafe {\n    97\t        printf(c\"helper.call=%d helper.acc=%d\\n\".as_ptr(), r, acc);\n    98\t    }\n    99\t    r.wrapping_add(acc)\n   100\t}\n   101\t\n   102\t#[unsafe(no_mangle)]\n   103\tpub extern \"C\" fn helper_ptr(a: c_int, b: c_int) -> c_int {\n   104\t    let fp = selected_op();\n   105\t    let r = fp(a, b);\n   106\t    unsafe {\n   107\t        printf(c\"helper.ptr=%d\\n\".as_ptr(), r);\n   108\t    }\n   109\t    r\n   110\t}\n   111\t\n   112\t#[unsafe(no_mangle)]\n   113\tpub extern \"C\" fn use_generated(n: c_int) -> c_int {\n   114\t    let r = generated_accumulator(n);\n   115\t    unsafe {\n   116\t        printf(c\"gen.acc=%d\\n\".as_ptr(), r);\n   117\t    }\n   118\t    r\n   119\t}\n--- main.rs ---\n     1\tmod config;\n     2\tmod core;\n     3\t\n     4\tuse std::ffi::{CString, c_char, c_int};\n     5\tuse std::io::{self, Write};\n     6\tuse std::os::unix::ffi::OsStrExt;\n     7\t\n     8\tunsafe extern \"C\" {\n     9\t    fn atoi(value: *const c_char) -> c_int;\n    10\t    fn printf(format: *const c_char, ...) -> c_int;\n    11\t}\n    12\t\n    13\tfn main() {\n    14\t    let args: Vec<_> = std::env::args_os().collect();\n    15\t    if args.len() < 3 {\n    16\t        let mut stderr = io::stderr().lock();\n    17\t        let _ = stderr.write_all(b\"usage: \");\n    18\t        let _ = stderr.write_all(args.first().map_or(b\"\", |arg| arg.as_os_str().as_bytes()));\n    19\t   