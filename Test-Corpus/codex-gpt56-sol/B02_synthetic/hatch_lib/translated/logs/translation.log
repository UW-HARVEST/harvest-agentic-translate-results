{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport os\nimport random\n\nroot = os.getcwd()\nc = ctypes.CDLL(os.path.join(root, '.reference-c-build/libtranslated_rust.so'), mode=ctypes.RTLD_LOCAL)\nr = ctypes.CDLL(os.path.join(root, 'target/release/libtranslated_rust.so'), mode=ctypes.RTLD_LOCAL)\nci = ctypes.c_int\n\nOP = ctypes.CFUNCTYPE(ci, ci, ci, ci)\nclass DataRecord(ctypes.Structure):\n    _fields_ = [('id', ci), ('value', ci), ('timestamp', ctypes.c_long), ('name', ctypes.c_char * 32)]\n\nassert ctypes.sizeof(DataRecord) == 48\n\nfor lib in (c, r):\n    lib.increment_counter.argtypes = [ci, ci]\n    lib.increment_counter.restype = None\n    lib.update_accumulator.argtypes = [ci, ci]\n    lib.update_accumulator.restype = None\n    lib.apply_operation.argtypes = [OP, ci, ci, ci]\n    lib.apply_operation.restype = ci\n    for name in ('add_three', 'multiply_add', 'complex_calc'):\n        getattr(lib, name).argtypes = [ci, ci, ci]\n        getattr(lib, name).restype = ci\n    lib.shift_array_data.argtypes = [ctypes.POINTER(ci), ci, ci]\n    lib.shift_array_data.restype = None\n    lib.process_pointer_data.argtypes = [ctypes.POINTER(ci), ci]\n    lib.process_pointer_data.restype = ci\n    lib.compute_with_dynamic_memory.argtypes = [ci, ci]\n    lib.compute_with_dynamic_memory.restype = ci\n    lib.get_time_based_value.argtypes = [ci]\n    lib.get_time_based_value.restype = ci\n    lib.manipulate_records.argtypes = [ctypes.POINTER(DataRecord), ci, ci]\n    lib.manipulate_records.restype = ci\n    lib.hatch.argtypes = [ci, ci, ci, ci]\n    lib.hatch.restype = ci\n\nchecks = 0\ndef eq(label, cv, rv):\n    global checks\n    checks += 1\n    if cv \"'!= rv:\n        raise AssertionError(f'\"'{label}: C={cv\"'!r}, Rust={rv!r}'\"')\n\nrng = random.Random(0xC0DEC)\ntriples = [(0, 0, 0), (1, 2, 3), (-7, 5, -3), (1000, -20, 31)]\ntriples += [tuple(rng.randint(-10000, 10000) for _ in ra