{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes, os, random\nroot = os.getcwd()\nc = ctypes.CDLL(root + '/.reference-c-build/libtranslated_rust.so', mode=ctypes.RTLD_LOCAL)\nr = ctypes.CDLL(root + '/target/release/libtranslated_rust.so', mode=ctypes.RTLD_LOCAL)\nI = ctypes.c_int\nOP = ctypes.CFUNCTYPE(I, I, I, I)\nclass Record(ctypes.Structure):\n    _fields_ = [('id', I), ('value', I), ('timestamp', ctypes.c_long), ('name', ctypes.c_char * 32)]\nassert ctypes.sizeof(Record) == 48\nfor x in (c, r):\n    x.increment_counter.argtypes=[I,I]; x.increment_counter.restype=None\n    x.update_accumulator.argtypes=[I,I]; x.update_accumulator.restype=None\n    x.apply_operation.argtypes=[OP,I,I,I]; x.apply_operation.restype=I\n    for n in ('add_three','multiply_add','complex_calc'):\n        getattr(x,n).argtypes=[I,I,I]; getattr(x,n).restype=I\n    x.shift_array_data.argtypes=[ctypes.POINTER(I),I,I]; x.shift_array_data.restype=None\n    x.process_pointer_data.argtypes=[ctypes.POINTER(I),I]; x.process_pointer_data.restype=I\n    x.compute_with_dynamic_memory.argtypes=[I,I]; x.compute_with_dynamic_memory.restype=I\n    x.get_time_based_value.argtypes=[I]; x.get_time_based_value.restype=I\n    x.manipulate_records.argtypes=[ctypes.POINTER(Record),I,I]; x.manipulate_records.restype=I\n    x.hatch.argtypes=[I,I,I,I]; x.hatch.restype=I\nchecks=0\ndef same(label,a,b):\n    global checks\n    checks+=1\n    assert a == b, f'{label}: C={a\"'!r} Rust={b!r}'\"'\nrng=random.Random(71237)\ntriples=[(0,0,0),(1,2,3),(-7,5,-3)]+[tuple(rng.randint(-10000,10000) for _ in range(3)) for _ in range(32)]\nfor args in triples:\n    for n in ('add_three','multiply_add','complex_calc'):\n        same(n,getattr(c,n)(*args),getattr(r,n)(*args))\n@OP\ndef cb(a,b,d): return a*5-b*2+d\nfor args in triples: same('apply_operation',c.apply_operation(cb,*args),r.apply_operation(cb,*args))\nfor size,shift in ((10,3),(6,1),(5,0),(5,5),(5,-1),(0,1)):\n    A=I*max(size,1); ca=A(*range(max(size,1))); ra=A(*range(max(size,1)))\n    c.shift_array_data(ca,size,shift); r.shift_array_data(ra,size,shift)\n    same('shift_array_data',bytes(ca),bytes(ra))\nfor base,count in ((0,0),(7,1),(-5,8),(123,64),(9,-1)):\n    same('compute_with_dynamic_memory',c.compute_with_dynamic_memory(base,count),r.compute_with_dynamic_memory(base,count))\nfor seed in (-10000,-7,0,1,59,10000):\n    same('get_time_based_value',c.get_time_based_value(seed),r.get_time_based_value(seed))\nfor shift in (0,1,2,4,5,-1):\n    A=Record*6; ca=A(); ra=A()\n    for i in range(6):\n        for a in (ca,ra):\n            a[i].id=i+10; a[i].value=i*13-20; a[i].timestamp=1700000000+i; a[i].name=f'Record_{i}'.encode()\n    same('manipulate_records result',c.manipulate_records(ca,5,shift),r.manipulate_records(ra,5,shift))\n    same('manipulate_records bytes',bytes(ca),bytes(ra))\nfor value in (3,-8,21):\n    c.increment_counter(value,999); r.increment_counter(value,999)\n    same('increment_counter',c.complex_calc(17,4,-3),r.complex_calc(17,4,-3))\nfor value in (11,-2,7):\n    c.update_accumulator(value,888); r.update_accumulator(value,888)\n    cp=I(23); rp=I(23)\n    same('update_accumulator/process_pointer_data',c.process_pointer_data(ctypes.byref(cp),-5),r.process_pointer_data(ctypes.byref(rp),-5))\nfor args in ((1,2,3,4),(-3,5,-2,11),(20,-7,4,-9),(0,0,0,0)):\n    same('hatch',c.hatch(*args),r.hatch(*args))\nprint(f'PASS: {checks} final differential checks across all 12 exports')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
