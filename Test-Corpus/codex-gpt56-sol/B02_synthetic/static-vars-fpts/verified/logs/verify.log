{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba c_src/src/main.c; nl -ba src/analyzer.rs; nl -ba src/tokenizer.rs; nl -ba src/main.rs'","aggregated_output":"     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t// main.c\n    26\t#include <stdio.h>\n    27\t#include <stdlib.h>\n    28\t#include <string.h>\n    29\t#include \"tokenizer.h\"\n    30\t#include \"analyzer.h\"\n    31\t\n    32\t#define MAX_INPUT_SIZE 4096\n    33\t\n    34\tvoid print_menu(void) {\n    35\t    printf(\"\\n=== Text Analyzer ===\\n\");\n    36\t    printf(\"1. Analyze text\\n\");\n    37\t    printf(\"2. Load text from file\\n\");\n    38\t    printf(\"3. Show token distribution\\n\");\n    39\t    printf(\"4. Calculate complexity score\\n\");\n    40\t    printf(\"5. Find pattern\\n\");\n    41\t    printf(\"6. Interactive tokenizer\\n\");\n    42\t    printf(\"7. Exit\\n\");\n    43\t    printf(\"Choice: \");\n    44\t}\n    45\t\n    46\tvoid print_analysis_result(analysis_result_t result) {\n    47\t    printf(\"\\n=== Analysis Results ===\\n\");\n    48\t    printf(\"Words/Identifiers: %zu\\n\", result.word_count);\n    49\t    printf(\"Numbers: %zu\\n\", result.number_count);\n    50\t    printf(\"Keywords: %zu\\n\", result.keyword_count);\n    51\t    printf(\"Operators: %zu\\n\", result.operator_count);\n    52\t    printf(\"Comments: %zu\\n\", result.comment_count);\n    53\t    printf(\"Strings: %zu\\n\", result.string_count);\n    54\t    printf(\"Lines: %zu\\n\", result.line_count);\n    55\t    printf(\"Characters: %zu\\n\", result.char_count);\n    56\t}\n    57\t\n    58\tvoid interactive_tokenizer(tokenizer_ops_t ops) {\n    59\t    printf(\"\\nEnter text (empty line to stop):\\n\");\n    60\t    \n    61\t    char input[MAX_INPUT_SIZE] = \"\";\n    62\t    char line[256];\n    63\t    \n    64\t    while (fgets(line, sizeof(line), stdin)) {\n    65\t        if (line[0] == '\\n') {\n    66\t            break;\n    67\t        }\n    68\t        strncat(input, line, MAX_INPUT_SIZE - strlen(input) - 1);\n    69\t    }\n    70\t    \n    71\t    if (ops.load_text(input) != 0) {\n    72\t        printf(\"Failed to load text\\n\");\n    73\t        return;\n    74\t    }\n    75\t    \n    76\t    printf(\"\\n=== Tokens ===\\n\");\n    77\t    \n    78\t    const char *token_type_names[] = {\n    79\t        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCT\", \"SPACE\",\n    80\t        \"NEWLINE\", \"IDENT\", \"KEYWORD\", \"OPERATOR\", \n    81\t        \"STRING\", \"COMMENT\", \"ERROR\"\n    82\t    };\n    83\t    \n    84\t    token_t token;\n    85\t    int count = 0;\n    86\t    \n    87\t    while ((token = ops.next_token()).type != TOKEN_EOF) {\n    88\t        printf(\"[%s] '%s' (L%d:C%d)\\n\",\n    89\t               token_type_names[token.type],\n    90\t               token.value,\n    91\t               token.line,\n    92\t               token.column);\n    93\t        count++;\n    94\t        \n    95\t        if (count > 100) {\n    96\t            printf(\"... (truncated, too many tokens)\\n\");\n    97\t            break;\n    98\t        }\n    99\t    }\n   100\t}\n   101\t\n   102\tchar* read_file(const char *filename) {\n   103\t    FILE *file = fopen(filename, \"r\");\n   104\t    if (!file) {\n   105\t        fprintf(stderr, \"Error: Could not open file '%s'\\n\", filename);\n   106\t        return NULL;\n   107\t    }\n   108\t    \n   109\t    fseek(file, 0, SEEK_END);\n   110\t    long size = ftell(file);\n   111\t    fseek(file, 0, SEEK_SET);\n   112\t    \n   113\t    if (size > MAX_BUFFER_SIZE) {\n   114\t        fprintf(stderr, \"Error: File too large\\n\");\n   115\t        fclose(file);\n   116\t        return NULL;\n   117\t    }\n   118\t    \n   119\t    char *content = malloc(size + 1);\n   120\t    if (!content) {\n   121\t        fprintf(stderr, \"Error: Memory allocation failed\\n\");\n   122\t        fclose(file);\n   123\t        return NULL;\n   124\t    }\n   125\t    \n   126\t    size_t read_size = fread(content, 1, size, file);\n   127\t    content[read_size] = '\\0';\n   128\t    \n   129\t    fclose(file);\n   130\t    return content;\n   131\t}\n   132\t\n   133\tint main(void) {\n   134\t    // Get tokenizer operations (function pointers)\n   135\t    tokenizer_ops_t ops = get_tokenizer_ops();\n   136\t    \n   137\t    // Initialize analyzer with function pointers\n   138\t    analyzer_init(ops);\n   139\t    \n   140\t    printf(\"Text Analysis and Tokenization System\\n\");\n   141\t    printf(\"This system demonstrates function pointers and static globals\\n\");\n   142\t    \n   143\t    char input[256];\n   144\t    int choice;\n   145\t    \n   146\t    while (1) {\n   147\t        print_menu();\n   148\t        \n   149\t        if (!fgets(input, sizeof(input), stdin)) {\n   150\t            break;\n   151\t        }\n   152\t        \n   153\t        if (sscanf(input, \"%d\", &choice) != 1) {\n   154\t            printf(\"Invalid input\\n\");\n   155\t            continue;\n   156\t        }\n   157\t        \n   158\t        switch (choice) {\n   159\t            case 1: {\n   160\t                printf(\"Enter text to analyze (empty line to stop):\\n\");\n   161\t                char text[MAX_INPUT_SIZE] = \"\";\n   162\t                char line[256];\n   163\t                \n   164\t                while (fgets(line, sizeof(line), stdin)) {\n   165\t                    if (line[0] == '\\n') {\n   166\t                        break;\n   167\t                    }\n   168\t                    strncat(text, line, MAX_INPUT_SIZE - strlen(text) - 1);\n   169\t                }\n   170\t                \n   171\t                analysis_result_t result = analyze_text(text);\n   172\t                print_analysis_result(result);\n   173\t                break;\n   174\t            }\n   175\t            \n   176\t            case 2: {\n   177\t                printf(\"Enter filename: \");\n   178\t                if (!fgets(input, sizeof(input), stdin)) {\n   179\t                    break;\n   180\t                }\n   181\t                input[strcspn(input, \"\\n\")] = 0;\n   182\t                \n   183\t                char *content = read_file(input);\n   184\t                if (content) {\n   185\t                    analysis_result_t result = analyze_text(content);\n   186\t                    print_analysis_result(result);\n   187\t                    free(content);\n   188\t                }\n   189\t                break;\n   190\t            }\n   191\t            \n   192\t            case 3: {\n   193\t                print_token_distribution();\n   194\t                break;\n   195\t            }\n   196\t            \n   197\t            case 4: {\n   198\t                int score = calculate_complexity_score();\n   199\t                printf(\"\\nComplexity Score: %d\\n\", score);\n   200\t                if (score < 10) {\n   201\t                    printf(\"Complexity: Low\\n\");\n   202\t                } else if (score < 50) {\n   203\t                    printf(\"Complexity: Medium\\n\");\n   204\t                } else {\n   205\t                    printf(\"Complexity: High\\n\");\n   206\t                }\n   207\t                break;\n   208\t            }\n   209\t            \n   210\t            case 5: {\n   211\t                printf(\"Enter pattern to search: \");\n   212\t                if (!fgets(input, sizeof(input), stdin)) {\n   213\t                    break;\n   214\t                }\n   215\t                input[strcspn(input, \"\\n\")] = 0;\n   216\t                \n   217\t                find_patterns(input);\n   218\t                break;\n   219\t            }\n   220\t            \n   221\t            case 6: {\n   222\t                interactive_tokenizer(ops);\n   223\t                break;\n   224\t            }\n   225\t            \n   226\t            case 7: {\n   227\t                printf(\"Goodbye!\\n\");\n   228\t                return 0;\n   229\t            }\n   230\t            \n   231\t            default:\n   232\t                printf(\"Invalid choice\\n\");\n   233\t                break;\n   234\t        }\n   235\t    }\n   236\t    \n   237\t    return 0;\n   238\t}\n     1\tuse std::fmt::Write as _;\n     2\t\n     3\tuse crate::tokenizer::{TokenType, Tokenizer};\n     4\t\n     5\t#[derive(Default)]\n     6\tpub struct AnalysisResult {\n     7\t    pub word_count: usize,\n     8\t    pub number_count: usize,\n     9\t    pub keyword_count: usize,\n    10\t    pub operator_count: usize,\n    11\t    pub comment_count: usize,\n    12\t    pub string_count: usize,\n    13\t    pub line_count: usize,\n    14\t    pub char_count: usize,\n    15\t}\n    16\t\n    17\tpub struct Analyzer {\n    18\t    tokenizer: Tokenizer,\n    19\t    initialized: bool,\n    20\t    token_type_counts: [i32; 20],\n    21\t    common_words: Vec<(Vec<u8>, i32)>,\n    22\t}\n    23\t\n    24\timpl Analyzer {\n    25\t    pub fn new() -> Self {\n    26\t        Self {\n    27\t            tokenizer: Tokenizer::new(),\n    28\t            initialized: true,\n    29\t            token_type_counts: [0; 20],\n    30\t            common_words: Vec::new(),\n    31\t        }\n    32\t    }\n    33\t\n    34\t    fn track_word(&mut self, word: &[u8]) {\n    35\t        for (known_word, count) in &mut self.common_words {\n    36\t            if known_word == word {\n    37\t                *count = count.wrapping_add(1);\n    38\t                return;\n    39\t            }\n    40\t        }\n    41\t\n    42\t        if self.common_words.len() < 100 {\n    43\t            self.common_words.push((word.to_vec(), 1));\n    44\t        }\n    45\t    }\n    46\t\n    47\t    pub fn analyze_text(&mut self, text: &[u8], stderr: &mut Vec<u8>) -> AnalysisResult {\n    48\t        let mut result = AnalysisResult::default();\n    49\t\n    50\t        if !self.initialized {\n    51\t            stderr.extend_from_slice(b\"Error: Analyzer not initialized\\n\");\n    52\t            return result;\n    53\t        }\n    54\t\n    55\t        if !self.tokenizer.load_text(text, stderr) {\n    56\t            stderr.extend_from_slice(b\"Error: Failed to load text\\n\");\n    57\t            return result;\n    58\t        }\n    59\t\n    60\t        loop {\n    61\t            let token = self.tokenizer.next_token();\n    62\t            if token.token_type == TokenType::Eof {\n    63\t                break;\n    64\t            }\n    65\t\n    66\t            let index = token.token_type as usize;\n    67\t            self.token_type_counts[index] = self.token_type_counts[index].wrapping_add(1);\n    68\t\n    69\t            match token.token_type {\n    70\t                TokenType::Word | TokenType::Identifier => {\n    71\t                    result.word_count += 1;\n    72\t                    self.track_word(&token.value);\n    73\t                }\n    74\t                TokenType::Number => result.number_count += 1,\n    75\t                TokenType::Keyword => result.keyword_count += 1,\n    76\t                TokenType::Operator => result.operator_count += 1,\n    77\t                TokenType::Comment => result.comment_count += 1,\n    78\t                TokenType::String => result.string_count += 1,\n    79\t                TokenType::Newline => result.line_count += 1,\n    80\t                _ => {}\n    81\t            }\n    82\t        }\n    83\t\n    84\t        let (lines, _tokens, chars) = self.tokenizer.stats();\n    85\t        result.line_count = lines;\n    86\t        result.char_count = chars;\n    87\t        result\n    88\t    }\n    89\t\n    90\t    pub fn print_token_distribution(&mut self, stdout: &mut Vec<u8>) {\n    91\t        stdout.extend_from_slice(b\"\\n=== Token Distribution ===\\n\");\n    92\t\n    93\t        const TOKEN_NAMES: &[&str] = &[\n    94\t            \"EOF\",\n    95\t            \"WORD\",\n    96\t            \"NUMBER\",\n    97\t            \"PUNCTUATION\",\n    98\t            \"WHITESPACE\",\n    99\t            \"NEWLINE\",\n   100\t            \"IDENTIFIER\",\n   101\t            \"KEYWORD\",\n   102\t            \"OPERATOR\",\n   103\t            \"STRING\",\n   104\t            \"COMMENT\",\n   105\t            \"ERROR\",\n   106\t        ];\n   107\t\n   108\t        for (index, name) in TOKEN_NAMES.iter().enumerate() {\n   109\t            if self.token_type_counts[index] > 0 {\n   110\t                let mut line = String::new();\n   111\t                writeln!(line, \"{}: {}\", name, self.token_type_counts[index]).unwrap();\n   112\t                stdout.extend_from_slice(line.as_bytes());\n   113\t            }\n   114\t        }\n   115\t\n   116\t        stdout.extend_from_slice(b\"\\n=== Most Common Words ===\\n\");\n   117\t\n   118\t        let len = self.common_words.len();\n   119\t        for i in 0..len.saturating_sub(1) {\n   120\t            for j in 0..len - i - 1 {\n   121\t                if self.common_words[j].1 < self.common_words[j + 1].1 {\n   122\t                    self.common_words.swap(j, j + 1);\n   123\t                }\n   124\t            }\n   125\t        }\n   126\t\n   127\t        for (index, (word, count)) in self.common_words.iter().take(10).enumerate() {\n   128\t            let prefix = format!(\"{}. \", index + 1);\n   129\t            stdout.extend_from_slice(prefix.as_bytes());\n   130\t            stdout.extend_from_slice(word);\n   131\t            let suffix = format!(\": {} times\\n\", count);\n   132\t            stdout.extend_from_slice(suffix.as_bytes());\n   133\t        }\n   134\t    }\n   135\t\n   136\t    pub fn calculate_complexity_score(&self) -> i32 {\n   137\t        let mut score = 0i32;\n   138\t        score =\n   139\t            score.wrapping_add(self.token_type_counts[TokenType::Keyword as usize].wrapping_mul(2));\n   140\t        score = score.wrapping_add(self.token_type_counts[TokenType::Operator as usize]);\n   141\t        score = score.wrapping_add(self.token_type_counts[TokenType::Punctuation as usize] / 10);\n   142\t        score = score.wrapping_sub(self.token_type_counts[TokenType::Comment as usize]);\n   143\t\n   144\t        if score < 0 {\n   145\t            0\n   146\t        } else {\n   147\t            score\n   148\t        }\n   149\t    }\n   150\t\n   151\t    pub fn find_patterns(&mut self, pattern: &[u8], stdout: &mut Vec<u8>) {\n   152\t        if !self.initialized {\n   153\t            return;\n   154\t        }\n   155\t\n   156\t        stdout.extend_from_slice(b\"\\n=== Searching for pattern: '\");\n   157\t        stdout.extend_from_slice(pattern);\n   158\t        stdout.extend_from_slice(b\"' ===\\n\");\n   159\t\n   160\t        self.tokenizer.reset();\n   161\t\n   162\t        let mut count = 0i32;\n   163\t        loop {\n   164\t            let token = self.tokenizer.next_token();\n   165\t            if token.token_type == TokenType::Eof {\n   166\t                break;\n   167\t            }\n   168\t\n   169\t            if contains(&token.value, pattern) {\n   170\t                let prefix = format!(\"Line {}, Column {}: \", token.line, token.column);\n   171\t                stdout.extend_from_slice(prefix.as_bytes());\n   172\t                stdout.extend_from_slice(&token.value);\n   173\t                stdout.push(b'\\n');\n   174\t                count = count.wrapping_add(1);\n   175\t            }\n   176\t        }\n   177\t\n   178\t        let line = format!(\"Found {} occurrences\\n\", count);\n   179\t        stdout.extend_from_slice(line.as_bytes());\n   180\t    }\n   181\t\n   182\t    pub fn tokenizer_mut(&mut self) -> &mut Tokenizer {\n   183\t        &mut self.tokenizer\n   184\t    }\n   185\t}\n   186\t\n   187\tfn contains(haystack: &[u8], needle: &[u8]) -> bool {\n   188\t    needle.is_empty()\n   189\t        || haystack\n   190\t            .windows(needle.len())\n   191\t            .any(|window| window == needle)\n   192\t}\n     1\tpub const MAX_TOKEN_LENGTH: usize = 256;\n     2\tpub const MAX_BUFFER_SIZE: usize = 8192;\n     3\t\n     4\t#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n     5\t#[repr(usize)]\n     6\t#[allow(dead_code)]\n     7\tpub enum TokenType {\n     8\t    Eof = 0,\n     9\t    Word,\n    10\t    Number,\n    11\t    Punctuation,\n    12\t    Whitespace,\n    13\t    Newline,\n    14\t    Identifier,\n    15\t    Keyword,\n    16\t    Operator,\n    17\t    String,\n    18\t    Comment,\n    19\t    Error,\n    20\t}\n    21\t\n    22\t#[derive(Clone)]\n    23\tpub struct Token {\n    24\t    pub token_type: TokenType,\n    25\t    pub value: Vec<u8>,\n    26\t    pub line: i32,\n    27\t    pub column: i32,\n    28\t}\n    29\t\n    30\tpub struct Tokenizer {\n    31\t    input_buffer: Vec<u8>,\n    32\t    current_position: usize,\n    33\t    current_line: i32,\n    34\t    current_column: i32,\n    35\t    total_tokens_processed: usize,\n    36\t    total_lines_processed: usize,\n    37\t    total_chars_processed: usize,\n    38\t    lookahead_token: Option<Token>,\n    39\t}\n    40\t\n    41\tconst KEYWORDS: &[&[u8]] = &[\n    42\t    b\"if\",\n    43\t    b\"else\",\n    44\t    b\"while\",\n    45\t    b\"for\",\n    46\t    b\"return\",\n    47\t    b\"int\",\n    48\t    b\"char\",\n    49\t    b\"float\",\n    50\t    b\"double\",\n    51\t    b\"void\",\n    52\t    b\"struct\",\n    53\t    b\"typedef\",\n    54\t    b\"const\",\n    55\t    b\"static\",\n    56\t    b\"extern\",\n    57\t    b\"auto\",\n    58\t    b\"register\",\n    59\t    b\"sizeof\",\n    60\t    b\"break\",\n    61\t    b\"continue\",\n    62\t    b\"switch\",\n    63\t    b\"case\",\n    64\t    b\"default\",\n    65\t    b\"do\",\n    66\t    b\"goto\",\n    67\t    b\"enum\",\n    68\t    b\"union\",\n    69\t    b\"signed\",\n    70\t    b\"unsigned\",\n    71\t    b\"long\",\n    72\t    b\"short\",\n    73\t];\n    74\t\n    75\timpl Tokenizer {\n    76\t    pub fn new() -> Self {\n    77\t        Self {\n    78\t            input_buffer: Vec::new(),\n    79\t            current_position: 0,\n    80\t            current_line: 1,\n    81\t            current_column: 1,\n    82\t            total_tokens_processed: 0,\n    83\t            total_lines_processed: 0,\n    84\t            total_chars_processed: 0,\n    85\t            lookahead_token: None,\n    86\t        }\n    87\t    }\n    88\t\n    89\t    fn is_keyword(value: &[u8]) -> bool {\n    90\t        KEYWORDS.contains(&value)\n    91\t    }\n    92\t\n    93\t    fn peek_char(&self) -> u8 {\n    94\t        self.input_buffer\n    95\t            .get(self.current_position)\n    96\t            .copied()\n    97\t            .unwrap_or(0)\n    98\t    }\n    99\t\n   100\t    fn advance_char(&mut self) -> u8 {\n   101\t        if self.current_position >= self.input_buffer.len() {\n   102\t            return 0;\n   103\t        }\n   104\t\n   105\t        let c = self.input_buffer[self.current_position];\n   106\t        self.current_position += 1;\n   107\t        self.total_chars_processed += 1;\n   108\t\n   109\t        if c == b'\\n' {\n   110\t            self.current_line += 1;\n   111\t            self.current_column = 1;\n   112\t            self.total_lines_processed += 1;\n   113\t        } else {\n   114\t            self.current_column += 1;\n   115\t        }\n   116\t\n   117\t        c\n   118\t    }\n   119\t\n   120\t    fn skip_whitespace(&mut self) {\n   121\t        while self.peek_char() != 0 && is_space(self.peek_char()) && self.peek_char() != b'\\n' {\n   122\t            self.advance_char();\n   123\t        }\n   124\t    }\n   125\t\n   126\t    fn create_token(&mut self, token_type: TokenType, value: &[u8], length: usize) -> Token {\n   127\t        let token_length = if length < MAX_TOKEN_LENGTH {\n   128\t            length\n   129\t        } else {\n   130\t            MAX_TOKEN_LENGTH - 1\n   131\t        };\n   132\t        let column = (self.current_column as usize).wrapping_sub(token_length) as i32;\n   133\t        self.total_tokens_processed += 1;\n   134\t\n   135\t        Token {\n   136\t            token_type,\n   137\t            value: value[..token_length].to_vec(),\n   138\t            line: self.current_line,\n   139\t            column,\n   140\t        }\n   141\t    }\n   142\t\n   143\t    fn scan_word(&mut self) -> Token {\n   144\t        let mut buffer = Vec::with_capacity(MAX_TOKEN_LENGTH);\n   145\t\n   146\t        while self.peek_char() != 0\n   147\t            && (is_alphanumeric(self.peek_char()) || self.peek_char() == b'_')\n   148\t            && buffer.len() < MAX_TOKEN_LENGTH - 1\n   149\t        {\n   150\t            buffer.push(self.advance_char());\n   151\t        }\n   152\t\n   153\t        let token_type = if Self::is_keyword(&buffer) {\n   154\t            TokenType::Keyword\n   155\t        } else {\n   156\t            TokenType::Identifier\n   157\t        };\n   158\t        self.create_token(token_type, &buffer, buffer.len())\n   159\t    }\n   160\t\n   161\t    fn scan_number(&mut self) -> Token {\n   162\t        let mut buffer = Vec::with_capacity(MAX_TOKEN_LENGTH);\n   163\t        let mut has_decimal = false;\n   164\t\n   165\t        while self.peek_char() != 0\n   166\t            && (is_digit(self.peek_char()) || self.peek_char() == b'.')\n   167\t            && buffer.len() < MAX_TOKEN_LENGTH - 1\n   168\t        {\n   169\t            if self.peek_char() == b'.' {\n   170\t                if has_decimal {\n   171\t                    break;\n   172\t                }\n   173\t                has_decimal = true;\n   174\t            }\n   175\t            buffer.push(self.advance_char());\n   176\t        }\n   177\t\n   178\t        self.create_token(TokenType::Number, &buffer, buffer.len())\n   179\t    }\n   180\t\n   181\t    fn scan_string(&mut self) -> Token {\n   182\t        let mut buffer = Vec::with_capacity(MAX_TOKEN_LENGTH);\n   183\t        let quote = self.advance_char();\n   184\t        buffer.push(quote);\n   185\t\n   186\t        while self.peek_char() != 0\n   187\t            && self.peek_char() != quote\n   188\t            && self.peek_char() != b'\\n'\n   189\t            && buffer.len() < MAX_TOKEN_LENGTH - 2\n   190\t        {\n   191\t            if self.peek_char() == b'\\\\' {\n   192\t                buffer.push(self.advance_char());\n   193\t                if self.peek_char() != 0 {\n   194\t                    buffer.push(self.advance_char());\n   195\t                }\n   196\t            } else {\n   197\t                buffer.push(self.advance_char());\n   198\t            }\n   199\t        }\n   200\t\n   201\t        if self.peek_char() == quote {\n   202\t            buffer.push(self.advance_char());\n   203\t        }\n   204\t\n   205\t        self.create_token(TokenType::String, &buffer, buffer.len())\n   206\t    }\n   207\t\n   208\t    fn scan_comment(&mut self) -> Token {\n   209\t        let mut buffer = Vec::with_capacity(MAX_TOKEN_LENGTH);\n   210\t        buffer.push(self.advance_char());\n   211\t\n   212\t        if self.peek_char() == b'/' {\n   213\t            buffer.push(self.advance_char());\n   214\t            while self.peek_char() != 0\n   215\t                && self.peek_char() != b'\\n'\n   216\t                && buffer.len() < MAX_TOKEN_LENGTH - 1\n   217\t            {\n   218\t                buffer.push(self.advance_char());\n   219\t            }\n   220\t        } else if self.peek_char() == b'*' {\n   221\t            buffer.push(self.advance_char());\n   222\t            while self.peek_char() != 0 && buffer.len() < MAX_TOKEN_LENGTH - 2 {\n   223\t                if self.peek_char() == b'*' {\n   224\t                    buffer.push(self.advance_char());\n   225\t                    if self.peek_char() == b'/' {\n   226\t                        buffer.push(self.advance_char());\n   227\t                        break;\n   228\t                    }\n   229\t                } else {\n   230\t                    buffer.push(self.advance_char());\n   231\t                }\n   232\t            }\n   233\t        }\n   234\t\n   235\t        self.create_token(TokenType::Comment, &buffer, buffer.len())\n   236\t    }\n   237\t\n   238\t    fn scan_operator(&mut self) -> Token {\n   239\t        let mut buffer = Vec::with_capacity(2);\n   240\t        let c = self.peek_char();\n   241\t        buffer.push(self.advance_char());\n   242\t\n   243\t        let next = self.peek_char();\n   244\t        if (c == b'=' && next == b'=')\n   245\t            || (c == b'!' && next == b'=')\n   246\t            || (c == b'<' && next == b'=')\n   247\t            || (c == b'>' && next == b'=')\n   248\t            || (c == b'&' && next == b'&')\n   249\t            || (c == b'|' && next == b'|')\n   250\t            || (c == b'+' && next == b'+')\n   251\t            || (c == b'-' && next == b'-')\n   252\t            || (c == b'-' && next == b'>')\n   253\t            || (c == b'<' && next == b'<')\n   254\t            || (c == b'>' && next == b'>')\n   255\t        {\n   256\t            buffer.push(self.advance_char());\n   257\t        }\n   258\t\n   259\t        self.create_token(TokenType::Operator, &buffer, buffer.len())\n   260\t    }\n   261\t\n   262\t    pub fn next_token(&mut self) -> Token {\n   263\t        if let Some(token) = self.lookahead_token.take() {\n   264\t            return token;\n   265\t        }\n   266\t\n   267\t        self.skip_whitespace();\n   268\t\n   269\t        if self.current_position >= self.input_buffer.len() {\n   270\t            return self.create_token(TokenType::Eof, b\"\", 0);\n   271\t        }\n   272\t\n   273\t        let c = self.peek_char();\n   274\t        if c == b'\\n' {\n   275\t            let newline = [self.advance_char()];\n   276\t            return self.create_token(TokenType::Newline, &newline, 1);\n   277\t        }\n   278\t\n   279\t        if is_alpha(c) || c == b'_' {\n   280\t            return self.scan_word();\n   281\t        }\n   282\t\n   283\t        if is_digit(c) {\n   284\t            return self.scan_number();\n   285\t        }\n   286\t\n   287\t        if c == b'\"' || c == b'\\'' {\n   288\t            return self.scan_string();\n   289\t        }\n   290\t\n   291\t        // The second peek in the C condition still sees c, so every slash enters here.\n   292\t        if c == b'/' && (self.peek_char() == b'/' || self.peek_char() == b'*') {\n   293\t            return self.scan_comment();\n   294\t        }\n   295\t\n   296\t        if b\"+-*/%=<>!&|^~?:\".contains(&c) {\n   297\t            return self.scan_operator();\n   298\t        }\n   299\t\n   300\t        if b\"(){}[];,.\".contains(&c) {\n   301\t            let punctuation = [self.advance_char()];\n   302\t            return self.create_token(TokenType::Punctuation, &punctuation, 1);\n   303\t        }\n   304\t\n   305\t        let unknown = [self.advance_char()];\n   306\t        self.create_token(TokenType::Error, &unknown, 1)\n   307\t    }\n   308\t\n   309\t    #[allow(dead_code)]\n   310\t    pub fn peek_token(&mut self) -> Token {\n   311\t        if self.lookahead_token.is_none() {\n   312\t            self.lookahead_token = Some(self.next_token());\n   313\t        }\n   314\t        self.lookahead_token.as_ref().unwrap().clone()\n   315\t    }\n   316\t\n   317\t    pub fn reset(&mut self) {\n   318\t        self.current_position = 0;\n   319\t        self.current_line = 1;\n   320\t        self.current_column = 1;\n   321\t        self.lookahead_token = None;\n   322\t    }\n   323\t\n   324\t    pub fn load_text(&mut self, text: &[u8], stderr: &mut Vec<u8>) -> bool {\n   325\t        let length = text.iter().position(|&c| c == 0).unwrap_or(text.len());\n   326\t        if length >= MAX_BUFFER_SIZE {\n   327\t            stderr.extend_from_slice(b\"Error: Input text too large\\n\");\n   328\t            return false;\n   329\t        }\n   330\t\n   331\t        self.input_buffer.clear();\n   332\t        self.input_buffer.extend_from_slice(&text[..length]);\n   333\t        self.reset();\n   334\t        true\n   335\t    }\n   336\t\n   337\t    pub fn stats(&self) -> (usize, usize, usize) {\n   338\t        (\n   339\t            self.total_lines_processed,\n   340\t            self.total_tokens_processed,\n   341\t            self.total_chars_processed,\n   342\t        )\n   343\t    }\n   344\t}\n   345\t\n   346\tfn is_alpha(c: u8) -> bool {\n   347\t    c.is_ascii_alphabetic()\n   348\t}\n   349\t\n   350\tfn is_digit(c: u8) -> bool {\n   351\t    c.is_ascii_digit()\n   352\t}\n   353\t\n   354\tfn is_alphanumeric(c: u8) -> bool {\n   355\t    c.is_ascii_alphanumeric()\n   356\t}\n   357\t\n   358\tfn is_space(c: u8) -> bool {\n   359\t    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n   360\t}\n     1\tmod analyzer;\n     2\tmod tokenizer;\n     3\t\n     4\tuse std::fs::File;\n     5\tuse std::io::{Read, Seek, SeekFrom, Write};\n     6\tuse std::os::unix::ffi::OsStrExt;\n     7\tuse std::path::Path;\n     8\t\n     9\tuse analyzer::{AnalysisResult, Analyzer};\n    10\tuse tokenizer::{TokenType, MAX_BUFFER_SIZE};\n    11\t\n    12\tconst MAX_INPUT_SIZE: usize = 4096;\n    13\t\n    14\tstruct Input {\n    15\t    bytes: Vec<u8>,\n    16\t    position: usize,\n    17\t}\n    18\t\n    19\timpl Input {\n    20\t    fn from_stdin() -> Self {\n    21\t        let mut bytes = Vec::new();\n    22\t        std::io::stdin().read_to_end(&mut bytes).ok();\n    23\t        Self { bytes, position: 0 }\n    24\t    }\n    25\t\n    26\t    fn fgets(&mut self, size: usize) -> Option<Vec<u8>> {\n    27\t        if self.position >= self.bytes.len() {\n    28\t            return None;\n    29\t        }\n    30\t\n    31\t        let start = self.position;\n    32\t        let limit = start.saturating_add(size.saturating_sub(1));\n    33\t        while self.position < self.bytes.len() && self.position < limit {\n    34\t            let c = self.bytes[self.position];\n    35\t            self.position += 1;\n    36\t            if c == b'\\n' {\n    37\t                break;\n    38\t            }\n    39\t        }\n    40\t        Some(self.bytes[start..self.position].to_vec())\n    41\t    }\n    42\t}\n    43\t\n    44\tfn c_string(bytes: &[u8]) -> &[u8] {\n    45\t    let end = bytes.iter().position(|&c| c == 0).unwrap_or(bytes.len());\n    46\t    &bytes[..end]\n    47\t}\n    48\t\n    49\tfn append_c_string(destination: &mut Vec<u8>, source: &[u8], capacity: usize) {\n    50\t    let available = capacity.saturating_sub(destination.len() + 1);\n    51\t    let source = c_string(source);\n    52\t    destination.extend_from_slice(&source[..source.len().min(available)]);\n    53\t}\n    54\t\n    55\tfn print_menu(stdout: &mut Vec<u8>) {\n    56\t    stdout.extend_from_slice(b\"\\n=== Text Analyzer ===\\n\");\n    57\t    stdout.extend_from_slice(b\"1. Analyze text\\n\");\n    58\t    stdout.extend_from_slice(b\"2. Load text from file\\n\");\n    59\t    stdout.extend_from_slice(b\"3. Show token distribution\\n\");\n    60\t    stdout.extend_from_slice(b\"4. Calculate complexity score\\n\");\n    61\t    stdout.extend_from_slice(b\"5. Find pattern\\n\");\n    62\t    stdout.extend_from_slice(b\"6. Interactive tokenizer\\n\");\n    63\t    stdout.extend_from_slice(b\"7. Exit\\n\");\n    64\t    stdout.extend_from_slice(b\"Choice: \");\n    65\t}\n    66\t\n    67\tfn print_analysis_result(result: AnalysisResult, stdout: &mut Vec<u8>) {\n    68\t    stdout.extend_from_slice(b\"\\n=== Analysis Results ===\\n\");\n    69\t    stdout.extend_from_slice(format!(\"Words/Identifiers: {}\\n\", result.word_count).as_bytes());\n    70\t    stdout.extend_from_slice(format!(\"Numbers: {}\\n\", result.number_count).as_bytes());\n    71\t    stdout.extend_from_slice(format!(\"Keywords: {}\\n\", result.keyword_count).as_bytes());\n    72\t    stdout.extend_from_slice(format!(\"Operators: {}\\n\", result.operator_count).as_bytes());\n    73\t    stdout.extend_from_slice(format!(\"Comments: {}\\n\", result.comment_count).as_bytes());\n    74\t    stdout.extend_from_slice(format!(\"Strings: {}\\n\", result.string_count).as_bytes());\n    75\t    stdout.extend_from_slice(format!(\"Lines: {}\\n\", result.line_count).as_bytes());\n    76\t    stdout.extend_from_slice(format!(\"Characters: {}\\n\", result.char_count).as_bytes());\n    77\t}\n    78\t\n    79\tfn interactive_tokenizer(\n    80\t    analyzer: &mut Analyzer,\n    81\t    input: &mut Input,\n    82\t    stdout: &mut Vec<u8>,\n    83\t    stderr: &mut Vec<u8>,\n    84\t) {\n    85\t    stdout.extend_from_slice(b\"\\nEnter text (empty line to stop):\\n\");\n    86\t\n    87\t    let mut text = Vec::new();\n    88\t    while let Some(line) = input.fgets(256) {\n    89\t        if line.first() == Some(&b'\\n') {\n    90\t            break;\n    91\t        }\n    92\t        append_c_string(&mut text, &line, MAX_INPUT_SIZE);\n    93\t    }\n    94\t\n    95\t    if !analyzer.tokenizer_mut().load_text(&text, stderr) {\n    96\t        stdout.extend_from_slice(b\"Failed to load text\\n\");\n    97\t        return;\n    98\t    }\n    99\t\n   100\t    stdout.extend_from_slice(b\"\\n=== Tokens ===\\n\");\n   101\t    const TOKEN_TYPE_NAMES: &[&[u8]] = &[\n   102\t        b\"EOF\",\n   103\t        b\"WORD\",\n   104\t        b\"NUMBER\",\n   105\t        b\"PUNCT\",\n   106\t        b\"SPACE\",\n   107\t        b\"NEWLINE\",\n   108\t        b\"IDENT\",\n   109\t        b\"KEYWORD\",\n   110\t        b\"OPERATOR\",\n   111\t        b\"STRING\",\n   112\t        b\"COMMENT\",\n   113\t        b\"ERROR\",\n   114\t    ];\n   115\t\n   116\t    let mut count = 0;\n   117\t    loop {\n   118\t        let token = analyzer.tokenizer_mut().next_token();\n   119\t        if token.token_type == TokenType::Eof {\n   120\t            break;\n   121\t        }\n   122\t\n   123\t        stdout.push(b'[');\n   124\t        stdout.extend_from_slice(TOKEN_TYPE_NAMES[token.token_type as usize]);\n   125\t        stdout.extend_from_slice(b\"] '\");\n   126\t        stdout.extend_from_slice(&token.value);\n   127\t        stdout.extend_from_slice(format!(\"' (L{}:C{})\\n\", token.line, token.column).as_bytes());\n   128\t        count += 1;\n   129\t\n   130\t        if count > 100 {\n   131\t            stdout.extend_from_slice(b\"... (truncated, too many tokens)\\n\");\n   132\t            break;\n   133\t        }\n   134\t    }\n   135\t}\n   136\t\n   137\tfn read_file(filename: &[u8], stderr: &mut Vec<u8>) -> Option<Vec<u8>> {\n   138\t    let path = Path::new(std::ffi::OsStr::from_bytes(filename));\n   139\t    let mut file = match File::open(path) {\n   140\t        Ok(file) => file,\n   141\t        Err(_) => {\n   142\t            stderr.extend_from_slice(b\"Error: Could not open file '\");\n   143\t            stderr.extend_from_slice(filename);\n   144\t            stderr.extend_from_slice(b\"'\\n\");\n   145\t            return None;\n   146\t        }\n   147\t    };\n   148\t\n   149\t    let size = file.seek(SeekFrom::End(0)).unwrap_or(0);\n   150\t    let _ = file.seek(SeekFrom::Start(0));\n   151\t\n   152\t    if size > MAX_BUFFER_SIZE as u64 {\n   153\t        stderr.extend_from_slice(b\"Error: File too large\\n\");\n   154\t        return None;\n   155\t    }\n   156\t\n   157\t    let mut content = Vec::with_capacity(size as usize);\n   158\t    let mut limited = file.take(size);\n   159\t    loop {\n   160\t        let mut chunk = [0u8; 4096];\n   161\t        match limited.read(&mut chunk) {\n   162\t            Ok(0) => break,\n   163\t            Ok(read) => content.extend_from_slice(&chunk[..read]),\n   164\t            Err(_) => break,\n   165\t        }\n   166\t    }\n   167\t    Some(content)\n   168\t}\n   169\t\n   170\tfn parse_scanf_int(input: &[u8]) -> Option<i32> {\n   171\t    let input = c_string(input);\n   172\t    let mut position = 0;\n   173\t    while position < input.len() && is_space(input[position]) {\n   174\t        position += 1;\n   175\t    }\n   176\t\n   177\t    let negative = match input.get(position) {\n   178\t        Some(b'-') => {\n   179\t            position += 1;\n   180\t            true\n   181\t        }\n   182\t        Some(b'+') => {\n   183\t            position += 1;\n   184\t            false\n   185\t        }\n   186\t        _ => false,\n   187\t    };\n   188\t\n   189\t    let start = position;\n   190\t    let mut value = 0u64;\n   191\t    while position < input.len() && input[position].is_ascii_digit() {\n   192\t        value = value\n   193\t            .saturating_mul(10)\n   194\t            .saturating_add((input[position] - b'0') as u64);\n   195\t        position += 1;\n   196\t    }\n   197\t\n   198\t    if position == start {\n   199\t        return None;\n   200\t    }\n   201\t\n   202\t    let signed = if negative {\n   203\t        (value as i64).wrapping_neg()\n   204\t    } else {\n   205\t        value as i64\n   206\t    };\n   207\t    Some(signed as i32)\n   208\t}\n   209\t\n   210\tfn is_space(c: u8) -> bool {\n   211\t    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n   212\t}\n   213\t\n   214\tfn main() {\n   215\t    let mut input = Input::from_stdin();\n   216\t    let mut stdout = Vec::new();\n   217\t    let mut stderr = Vec::new();\n   218\t    let mut analyzer = Analyzer::new();\n   219\t\n   220\t    stdout.extend_from_slice(b\"Text Analysis and Tokenization System\\n\");\n   221\t    stdout.extend_from_slice(b\"This system demonstrates function pointers and static globals\\n\");\n   222\t\n   223\t    loop {\n   224\t        print_menu(&mut stdout);\n   225\t\n   226\t        let Some(choice_line) = input.fgets(256) else {\n   227\t            break;\n   228\t        };\n   229\t        let Some(choice) = parse_scanf_int(&choice_line) else {\n   230\t            stdout.extend_from_slice(b\"Invalid input\\n\");\n   231\t            continue;\n   232\t        };\n   233\t\n   234\t        match choice {\n   235\t            1 => {\n   236\t                stdout.extend_from_slice(b\"Enter text to analyze (empty line to stop):\\n\");\n   237\t                let mut text = Vec::new();\n   238\t                while let Some(line) = input.fgets(256) {\n   239\t                    if line.first() == Some(&b'\\n') {\n   240\t                        break;\n   241\t                    }\n   242\t                    append_c_string(&mut text, &line, MAX_INPUT_SIZE);\n   243\t                }\n   244\t\n   245\t                let result = analyzer.analyze_text(&text, &mut stderr);\n   246\t                print_analysis_result(result, &mut stdout);\n   247\t            }\n   248\t            2 => {\n   249\t                stdout.extend_from_slice(b\"Enter filename: \");\n   250\t                if let Some(filename_line) = input.fgets(256) {\n   251\t                    let filename = c_string(&filename_line);\n   252\t                    let newline = filename\n   253\t                        .iter()\n   254\t                        .position(|&c| c == b'\\n')\n   255\t                        .unwrap_or(filename.len());\n   256\t                    let filename = &filename[..newline];\n   257\t\n   258\t                    if let Some(content) = read_file(filename, &mut stderr) {\n   259\t                        let result = analyzer.analyze_text(&content, &mut stderr);\n   260\t                        print_analysis_result(result, &mut stdout);\n   261\t                    }\n   262\t                }\n   263\t            }\n   264\t            3 => analyzer.print_token_distribution(&mut stdout),\n   265\t            4 => {\n   266\t                let score = analyzer.calculate_complexity_score();\n   267\t                stdout.extend_from_slice(format!(\"\\nComplexity Score: {}\\n\", score).as_bytes());\n   268\t                if score < 10 {\n   269\t                    stdout.extend_from_slice(b\"Complexity: Low\\n\");\n   270\t                } else if score < 50 {\n   271\t                    stdout.extend_from_slice(b\"Complexity: Medium\\n\");\n   272\t                } else {\n   273\t                    stdout.extend_from_slice(b\"Complexity: High\\n\");\n   274\t                }\n   275\t            }\n   276\t            5 => {\n   277\t                stdout.extend_from_slice(b\"Enter pattern to search: \");\n   278\t                if let Some(pattern_line) = input.fgets(256) {\n   279\t                    let pattern = c_string(&pattern_line);\n   280\t                    let newline = pattern\n   281\t                        .iter()\n   282\t                        .position(|&c| c == b'\\n')\n   283\t                        .unwrap_or(pattern.len());\n   284\t                    analyzer.find_patterns(&pattern[..newline], &mut stdout);\n   285\t                }\n   286\t            }\n   287\t            6 => interactive_tokenizer(&mut analyzer, &mut input, &mut stdout, &mut stderr),\n   288\t            7 => {\n   289\t                stdout.extend_from_slice(b\"Goodbye!\\n\");\n   290\t                break;\n   291\t            }\n   292\t            _ => stdout.extend_from_slice(b\"Invalid choice\\n\"),\n   293\t        }\n   294\t    }\n   295\t\n   296\t    let _ = std::io::stdout().write_all(&stdout);\n   297\t    let _ = std::io::stderr().write_all(&stderr);\n   298\t}\n","exit_code":0,"status":"completed"}}
