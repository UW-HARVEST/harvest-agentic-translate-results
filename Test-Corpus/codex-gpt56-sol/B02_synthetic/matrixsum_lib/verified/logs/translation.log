{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"python3 - .c-build/libtranslated_rust.so target/release/libtranslated_rust.so <<'PY'\nimport subprocess\nimport sys\n\nchild = r'''\nimport ctypes\nimport random\nimport struct\nimport sys\n\nlib = ctypes.CDLL(sys.argv[1])\n\nclass DynamicArray(ctypes.Structure):\n    _fields_ = [\n        (\\\"data\\\", ctypes.POINTER(ctypes.c_int)),\n        (\\\"size\\\", ctypes.c_size_t),\n        (\\\"capacity\\\", ctypes.c_size_t),\n    ]\n\narray_pointer = ctypes.POINTER(DynamicArray)\nlib.init_array.argtypes = [ctypes.c_size_t]\nlib.init_array.restype = array_pointer\nlib.expand_array.argtypes = [array_pointer]\nlib.expand_array.restype = ctypes.c_int\nlib.add_element.argtypes = [array_pointer, ctypes.c_int]\nlib.add_element.restype = ctypes.c_int\nlib.free_array.argtypes = [array_pointer]\nlib.free_array.restype = None\nlib.process_flags.argtypes = [ctypes.c_int]\nlib.process_flags.restype = ctypes.c_int\nlib.calculate_matrix_checksum.argtypes = []\nlib.calculate_matrix_checksum.restype = ctypes.c_int\nlib.matrixsum.argtypes = [ctypes.c_int] * 4\nlib.matrixsum.restype = ctypes.c_int\n\nout = bytearray()\ndef i32(value):\n    out.extend(struct.pack(\\\"=i\\\", value))\ndef usize(value):\n    out.extend(value.to_bytes(ctypes.sizeof(ctypes.c_size_t), sys.byteorder))\n\n# Null checks on all pointer-taking operations.\ni32(lib.expand_array(None))\ni32(lib.add_element(None, 123))\nlib.free_array(None)\n\n# Every relevant flag combination plus high and negative bits.\nfor flags in list(range(32)) + [-1, -16, -(2**31), 2**31 - 1]:\n    i32(lib.process_flags(flags))\n\n# Initial mutable data bytes and checksum.\nmatrix_type = (ctypes.c_int * 4) * 3\nmatrix = matrix_type.in_dll(lib, \\\"matrix\\\")\nout.extend(ctypes.string_at(ctypes.addressof(matrix), ctypes.sizeof(matrix)))\ni32(lib.calculate_matrix_checksum())\n\n# Allocation, implicit growth, stored values, and public struct layout.\narr = lib.init_array(2)\ni32(int(bool(arr)))\nusize(arr.contents.size)\nusize(arr.contents.capacity)\nfor value in [7, -9, 2**31 - 1, -(2**31), 123456789]:\n    i32(lib.add_element(arr, value))\n    usize(arr.contents.size)\n    usize(arr.contents.capacity)\n    for index in range(arr.contents.size):\n        i32(arr.contents.data[index])\nlib.free_array(arr)\n\n# Explicit expansion from an odd capacity.\narr = lib.init_array(3)\ni32(lib.expand_array(arr))\nusize(arr.contents.size)\nusize(arr.contents.capacity)\nlib.free_array(arr)\n\n# Oversized allocation must fail after size_t multiplication wraps as in C.\narr = lib.init_array((1 << (ctypes.sizeof(ctypes.c_size_t) * 8)) - 1)\ni32(int(bool(arr)))\nif arr:\n    lib.free_array(arr)\n\n# Fixed edge corpus and deterministic randomized matrixsum inputs.\ncases = [\n    (0, 0, 0, 0),\n    (1, 2, 3, 4),\n    (-1, -2, -3, -4),\n    (2**31 - 1, 0, 0, 0),\n    (-(2**31), 0, 0, 0),\n    (2**31 - 1, -(2**31), 17, -17),\n]\nrng = random.Random(0x5EED)\nfor _ in range(2000):\n    cases.append(tuple(rng.randint(-(2**31), 2**31 - 1) for _ in range(4)))\nfor case in cases:\n    i32(lib.matrixsum(*case))\n\n# External writes to the exported matrix must affect both functions identically.\nmutations = [\n    (0, 0, -1),\n    (1, 2, 2**31 - 1),\n    (2, 3, -(2**31)),\n]\nfor row, column, value in mutations:\n    matrix[row][column] = value\n    i32(lib.calculate_matrix_checksum())\n    i32(lib.matrixsum(1, 0, -1, 0))\nout.extend(ctypes.string_at(ctypes.addressof(matrix), ctypes.sizeof(matrix)))\n\nsys.stdout.buffer.write(out)\n'''\n\noutputs = []\nfor library in sys.argv[1:]:\n    result = subprocess.run(\n        [sys.executable, \\\"-c\\\", child, library],\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        check=False,\n    )\n    if result.returncode \"'!= 0:\n        sys.stderr.write(f\"{library} failed with {result.returncode}:'\"\\\\n\\\")\n        sys.stderr.buffer.write(result.stderr)\n        raise SystemExit(1)\n    outputs.append(result.stdout)\n\nif outputs[0] \"'!= outputs[1]:\n    limit = min(len(outputs[0]), len(outputs[1]))\n    offset = next((i for i in range(limit) if outputs[0][i] != outputs[1][i]), limit)\n    print(f\"mismatch at byte {offset}; lengths={list(map(len, outputs))}\", file=sys.stderr)\n    raise SystemExit(1)\n\nimport hashlib\nprint(f\"byte-identical differential output: {len(outputs[0])} bytes\")\nprint(f\"sha256: {hashlib.sha256(outputs[0]).hexdigest()}\")\nprint(\"matrixsum cases: 2006\")\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
