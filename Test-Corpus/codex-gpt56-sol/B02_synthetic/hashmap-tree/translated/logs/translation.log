{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba c_src/src/tree.c && nl -ba c_src/include/tree.h'","aggregated_output":"     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t// tree.c\n    26\t#include \"tree.h\"\n    27\t#include <stdlib.h>\n    28\t#include <string.h>\n    29\t#include <stdio.h>\n    30\t\n    31\ttree_t* tree_create(void) {\n    32\t    tree_t *tree = malloc(sizeof(tree_t));\n    33\t    if (!tree) {\n    34\t        return NULL;\n    35\t    }\n    36\t    \n    37\t    tree->node_map = hashmap_create();\n    38\t    if (!tree->node_map) {\n    39\t        free(tree);\n    40\t        return NULL;\n    41\t    }\n    42\t    \n    43\t    tree->root_id = 0;\n    44\t    tree->has_root = 0;\n    45\t    tree->node_count = 0;\n    46\t    \n    47\t    return tree;\n    48\t}\n    49\t\n    50\tstatic void tree_free_node(tree_node_t *node) {\n    51\t    if (node) {\n    52\t        free(node);\n    53\t    }\n    54\t}\n    55\t\n    56\tvoid tree_delete(tree_t *tree) {\n    57\t    if (!tree) {\n    58\t        return;\n    59\t    }\n    60\t    \n    61\t    // Free all nodes in the hashmap\n    62\t    for (size_t i = 0; i < tree->node_map->capacity; i++) {\n    63\t        if (tree->node_map->entries[i].occupied && \n    64\t            !tree->node_map->entries[i].deleted) {\n    65\t            tree_free_node((tree_node_t *)tree->node_map->entries[i].value);\n    66\t        }\n    67\t    }\n    68\t    \n    69\t    hashmap_destroy(tree->node_map);\n    70\t    free(tree);\n    71\t}\n    72\t\n    73\tint tree_add_node(tree_t *tree, tree_id_t id, tree_id_t parent_id, const char *data) {\n    74\t    if (!tree) {\n    75\t        return -1;\n    76\t    }\n    77\t    \n    78\t    // Check if node already exists\n    79\t    if (tree_contains(tree, id)) {\n    80\t        fprintf(stderr, \"Error: Node with ID %lu already exists\\n\", id);\n    81\t        return -1;\n    82\t    }\n    83\t    \n    84\t    // Allocate new node\n    85\t    tree_node_t *node = malloc(sizeof(tree_node_t));\n    86\t    if (!node) {\n    87\t        fprintf(stderr, \"Error: Failed to allocate node\\n\");\n    88\t        return -1;\n    89\t    }\n    90\t    \n    91\t    node->id = id;\n    92\t    node->parent_id = parent_id;\n    93\t    node->child_count = 0;\n    94\t    \n    95\t    if (data) {\n    96\t        strncpy(node->data, data, MAX_DATA_LENGTH - 1);\n    97\t        node->data[MAX_DATA_LENGTH - 1] = '\\0';\n    98\t    } else {\n    99\t        node->data[0] = '\\0';\n   100\t    }\n   101\t    \n   102\t    // If this is the first node, make it the root\n   103\t    if (!tree->has_root) {\n   104\t        tree->root_id = id;\n   105\t        tree->has_root = 1;\n   106\t        node->parent_id = 0; // Root has no parent\n   107\t    } else {\n   108\t        // Find parent and add this node as a child\n   109\t        tree_node_t *parent = tree_get_node(tree, parent_id);\n   110\t        if (!parent) {\n   111\t            fprintf(stderr, \"Error: Parent node %lu not found\\n\", parent_id);\n   112\t            free(node);\n   113\t            return -1;\n   114\t        }\n   115\t        \n   116\t        if (parent->child_count >= MAX_CHILDREN) {\n   117\t            fprintf(stderr, \"Error: Parent has maximum children\\n\");\n   118\t            free(node);\n   119\t            return -1;\n   120\t        }\n   121\t        \n   122\t        parent->child_ids[parent->child_count++] = id;\n   123\t    }\n   124\t    \n   125\t    // Add to hashmap\n   126\t    if (hashmap_put(tree->node_map, id, node) != 0) {\n   127\t        fprintf(stderr, \"Error: Failed to add node to hashmap\\n\");\n   128\t        free(node);\n   129\t        return -1;\n   130\t    }\n   131\t    \n   132\t    tree->node_count++;\n   133\t    return 0;\n   134\t}\n   135\t\n   136\tstatic int tree_remove_subtree(tree_t *tree, tree_id_t id) {\n   137\t    tree_node_t *node = tree_get_node(tree, id);\n   138\t    if (!node) {\n   139\t        return -1;\n   140\t    }\n   141\t    \n   142\t    // Recursively remove all children first\n   143\t    for (int i = 0; i < node->child_count; i++) {\n   144\t        tree_remove_subtree(tree, node->child_ids[i]);\n   145\t    }\n   146\t    \n   147\t    // Remove this node from hashmap\n   148\t    tree_node_t *removed = (tree_node_t *)hashmap_remove(tree->node_map, id);\n   149\t    if (removed) {\n   150\t        tree_free_node(removed);\n   151\t        tree->node_count--;\n   152\t    }\n   153\t    \n   154\t    return 0;\n   155\t}\n   156\t\n   157\tint tree_remove_node(tree_t *tree, tree_id_t id) {\n   158\t    if (!tree) {\n   159\t        return -1;\n   160\t    }\n   161\t    \n   162\t    tree_node_t *node = tree_get_node(tree, id);\n   163\t    if (!node) {\n   164\t        fprintf(stderr, \"Error: Node %lu not found\\n\", id);\n   165\t        return -1;\n   166\t    }\n   167\t    \n   168\t    // If removing root, tree becomes empty\n   169\t    if (id == tree->root_id) {\n   170\t        tree_remove_subtree(tree, id);\n   171\t        tree->has_root = 0;\n   172\t        tree->root_id = 0;\n   173\t        return 0;\n   174\t    }\n   175\t    \n   176\t    // Remove from parent's child list\n   177\t    tree_node_t *parent = tree_get_node(tree, node->parent_id);\n   178\t    if (parent) {\n   179\t        for (int i = 0; i < parent->child_count; i++) {\n   180\t            if (parent->child_ids[i] == id) {\n   181\t                // Shift remaining children\n   182\t                for (int j = i; j < parent->child_count - 1; j++) {\n   183\t                    parent->child_ids[j] = parent->child_ids[j + 1];\n   184\t                }\n   185\t                parent->child_count--;\n   186\t                break;\n   187\t            }\n   188\t        }\n   189\t    }\n   190\t    \n   191\t    // Remove this node and all descendants\n   192\t    tree_remove_subtree(tree, id);\n   193\t    \n   194\t    return 0;\n   195\t}\n   196\t\n   197\ttree_node_t* tree_get_node(tree_t *tree, tree_id_t id) {\n   198\t    if (!tree) {\n   199\t        return NULL;\n   200\t    }\n   201\t    \n   202\t    return (tree_node_t *)hashmap_get(tree->node_map, id);\n   203\t}\n   204\t\n   205\tint tree_contains(tree_t *tree, tree_id_t id) {\n   206\t    return tree_get_node(tree, id) != NULL;\n   207\t}\n   208\t\n   209\tsize_t tree_size(tree_t *tree) {\n   210\t    return tree ? tree->node_count : 0;\n   211\t}\n   212\t\n   213\tstatic void tree_print_helper(tree_t *tree, tree_id_t id, int depth) {\n   214\t    tree_node_t *node = tree_get_node(tree, id);\n   215\t    if (!node) {\n   216\t        return;\n   217\t    }\n   218\t    \n   219\t    // Print indentation\n   220\t    for (int i = 0; i < depth; i++) {\n   221\t        printf(\"  \");\n   222\t    }\n   223\t    \n   224\t    printf(\"[%lu] %s\\n\", node->id, node->data);\n   225\t    \n   226\t    // Print children\n   227\t    for (int i = 0; i < node->child_count; i++) {\n   228\t        tree_print_helper(tree, node->child_ids[i], depth + 1);\n   229\t    }\n   230\t}\n   231\t\n   232\tvoid tree_print(tree_t *tree) {\n   233\t    if (!tree || !tree->has_root) {\n   234\t        printf(\"(empty tree)\\n\");\n   235\t        return;\n   236\t    }\n   237\t    \n   238\t    tree_print_helper(tree, tree->root_id, 0);\n   239\t}\n   240\t\n   241\tint tree_get_depth(tree_t *tree, tree_id_t id) {\n   242\t    if (!tree || !tree_contains(tree, id)) {\n   243\t        return -1;\n   244\t    }\n   245\t    \n   246\t    int depth = 0;\n   247\t    tree_id_t current_id = id;\n   248\t    \n   249\t    while (current_id != tree->root_id) {\n   250\t        tree_node_t *node = tree_get_node(tree, current_id);\n   251\t        if (!node) {\n   252\t            return -1;\n   253\t        }\n   254\t        current_id = node->parent_id;\n   255\t        depth++;\n   256\t    }\n   257\t    \n   258\t    return depth;\n   259\t}\n   260\t\n   261\tint tree_get_height(tree_t *tree, tree_id_t id) {\n   262\t    tree_node_t *node = tree_get_node(tree, id);\n   263\t    if (!node) {\n   264\t        return -1;\n   265\t    }\n   266\t    \n   267\t    if (node->child_count == 0) {\n   268\t        return 0;\n   269\t    }\n   270\t    \n   271\t    int max_height = 0;\n   272\t    for (int i = 0; i < node->child_count; i++) {\n   273\t        int child_height = tree_get_height(tree, node->child_ids[i]);\n   274\t        if (child_height > max_height) {\n   275\t            max_height = child_height;\n   276\t        }\n   277\t    }\n   278\t    \n   279\t    return max_height + 1;\n   280\t}\n   281\t\n   282\tint tree_count_descendants(tree_t *tree, tree_id_t id) {\n   283\t    tree_node_t *node = tree_get_node(tree, id);\n   284\t    if (!node) {\n   285\t        return -1;\n   286\t    }\n   287\t    \n   288\t    int count = 0;\n   289\t    for (int i = 0; i < node->child_count; i++) {\n   290\t        count++; // Count the child\n   291\t        count += tree_count_descendants(tree, node->child_ids[i]);\n   292\t    }\n   293\t    \n   294\t    return count;\n   295\t}\n   296\t\n   297\tint tree_find_path(tree_t *tree, tree_id_t id, tree_id_t *path, int max_length) {\n   298\t    if (!tree || !path || !tree_contains(tree, id)) {\n   299\t        return -1;\n   300\t    }\n   301\t    \n   302\t    // Build path from node to root, then reverse\n   303\t    tree_id_t temp_path[1000];\n   304\t    int length = 0;\n   305\t    tree_id_t current_id = id;\n   306\t    \n   307\t    while (length < 1000) {\n   308\t        temp_path[length++] = current_id;\n   309\t        \n   310\t        if (current_id == tree->root_id) {\n   311\t            break;\n   312\t        }\n   313\t        \n   314\t        tree_node_t *node = tree_get_node(tree, current_id);\n   315\t        if (!node) {\n   316\t            return -1;\n   317\t        }\n   318\t        current_id = node->parent_id;\n   319\t    }\n   320\t    \n   321\t    // Reverse into output path\n   322\t    if (length > max_length) {\n   323\t        length = max_length;\n   324\t    }\n   325\t    \n   326\t    for (int i = 0; i < length; i++) {\n   327\t        path[i] = temp_path[length - 1 - i];\n   328\t    }\n   329\t    \n   330\t    return length;\n   331\t}\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t