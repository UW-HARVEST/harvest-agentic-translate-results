55\t    printf(\"\\n=== Testing Tree Count Descendants ===\\n\");\n   256\t    \n   257\t    tree_t *tree = tree_create();\n   258\t    \n   259\t    /*\n   260\t     * Build tree:\n   261\t     *        1\n   262\t     *       / \\\n   263\t     *      2   5\n   264\t     *     / \\\n   265\t     *    3   4\n   266\t     */\n   267\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n   268\t    assert(tree_add_node(tree, 2, 1, \"child1\") == 0);\n   269\t    assert(tree_add_node(tree, 3, 2, \"grandchild1\") == 0);\n   270\t    assert(tree_add_node(tree, 4, 2, \"grandchild2\") == 0);\n   271\t    assert(tree_add_node(tree, 5, 1, \"child2\") == 0);\n   272\t    \n   273\t    assert(tree_count_descendants(tree, 1) == 4);\n   274\t    assert(tree_count_descendants(tree, 2) == 2);\n   275\t    assert(tree_count_descendants(tree, 3) == 0);\n   276\t    assert(tree_count_descendants(tree, 5) == 0);\n   277\t    \n   278\t    tree_delete(tree);\n   279\t    TEST_PASS;\n   280\t}\n   281\t\n   282\tvoid test_tree_find_path(void) {\n   283\t    printf(\"\\n=== Testing Tree Find Path ===\\n\");\n   284\t    \n   285\t    tree_t *tree = tree_create();\n   286\t    \n   287\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n   288\t    assert(tree_add_node(tree, 2, 1, \"child\") == 0);\n   289\t    assert(tree_add_node(tree, 3, 2, \"grandchild\") == 0);\n   290\t    \n   291\t    tree_id_t path[10];\n   292\t    int length;\n   293\t    \n   294\t    length = tree_find_path(tree, 3, path, 10);\n   295\t    assert(length == 3);\n   296\t    assert(path[0] == 1);\n   297\t    assert(path[1] == 2);\n   298\t    assert(path[2] == 3);\n   299\t    \n   300\t    length = tree_find_path(tree, 1, path, 10);\n   301\t    assert(length == 1);\n   302\t    assert(path[0] == 1);\n   303\t    \n   304\t    tree_delete(tree);\n   305\t    TEST_PASS;\n   306\t}\n   307\t\n   308\tvoid test_tree_duplicate_id(void) {\n   309\t    printf(\"\\n=== Testing Tree Duplicate ID ===\\n\");\n  