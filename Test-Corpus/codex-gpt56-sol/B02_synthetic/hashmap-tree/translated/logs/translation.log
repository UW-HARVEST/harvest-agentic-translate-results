t(tree_add_node(tree, 6, 2, \"gc2\") == 0);\n   365\t    assert(tree_add_node(tree, 7, 3, \"gc3\") == 0);\n   366\t    assert(tree_add_node(tree, 8, 4, \"gc4\") == 0);\n   367\t    assert(tree_add_node(tree, 9, 4, \"gc5\") == 0);\n   368\t    assert(tree_add_node(tree, 10, 7, \"ggc1\") == 0);\n   369\t    \n   370\t    assert(tree_size(tree) == 10);\n   371\t    assert(tree_get_height(tree, 1) == 3);\n   372\t    assert(tree_count_descendants(tree, 1) == 9);\n   373\t    assert(tree_count_descendants(tree, 2) == 2);\n   374\t    assert(tree_count_descendants(tree, 7) == 1);\n   375\t    \n   376\t    tree_print(tree);\n   377\t    \n   378\t    tree_delete(tree);\n   379\t    TEST_PASS;\n   380\t}\n   381\t\n   382\tint main(void) {\n   383\t    printf(\"╔════════════════════════════════════════╗\\n\");\n   384\t    printf(\"║  TREE WITH HASHMAP ID MAPPING TESTS   ║\\n\");\n   385\t    printf(\"╚════════════════════════════════════════╝\\n\");\n   386\t    \n   387\t    // Hashmap tests\n   388\t    test_hashmap_basic();\n   389\t    test_hashmap_collisions();\n   390\t    \n   391\t    // Tree creation tests\n   392\t    test_tree_creation();\n   393\t    test_tree_add_root();\n   394\t    test_tree_add_children();\n   395\t    \n   396\t    // Tree structure tests\n   397\t    test_tree_deep_hierarchy();\n   398\t    test_tree_complex_structure();\n   399\t    \n   400\t    // Tree removal tests\n   401\t    test_tree_remove_leaf();\n   402\t    test_tree_remove_subtree();\n   403\t    test_tree_remove_root();\n   404\t    \n   405\t    // Tree query tests\n   406\t    test_tree_count_descendants();\n   407\t    test_tree_find_path();\n   408\t    \n   409\t    // Error handling tests\n   410\t    test_tree_duplicate_id();\n   411\t    test_tree_max_children();\n   412\t    \n   413\t    printf(\"\\n\");\n   414\t    printf(\"========================================\\n\");\n   415\t    printf(\"  All tests passed successfully!\\n\");\n   416\t    printf(\"========