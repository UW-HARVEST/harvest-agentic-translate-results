ash *= 1099511628211ULL;\n    39\t    }\n    40\t    \n    41\t    return hash;\n    42\t}\n    43\t\n    44\tstatic int should_resize(hashmap_t *map) {\n    45\t    double load = (double)(map->size + map->deleted_count) / map->capacity;\n    46\t    return load > HASHMAP_LOAD_FACTOR;\n    47\t}\n    48\t\n    49\tstatic int hashmap_resize(hashmap_t *map) {\n    50\t    size_t old_capacity = map->capacity;\n    51\t    hashmap_entry_t *old_entries = map->entries;\n    52\t    \n    53\t    // Double capacity\n    54\t    map->capacity *= 2;\n    55\t    map->entries = calloc(map->capacity, sizeof(hashmap_entry_t));\n    56\t    if (!map->entries) {\n    57\t        map->entries = old_entries;\n    58\t        map->capacity = old_capacity;\n    59\t        return -1;\n    60\t    }\n    61\t    \n    62\t    map->size = 0;\n    63\t    map->deleted_count = 0;\n    64\t    \n    65\t    // Rehash all entries\n    66\t    for (size_t i = 0; i < old_capacity; i++) {\n    67\t        if (old_entries[i].occupied && !old_entries[i].deleted) {\n    68\t            hashmap_put(map, old_entries[i].key, old_entries[i].value);\n    69\t        }\n    70\t    }\n    71\t    \n    72\t    free(old_entries);\n    73\t    return 0;\n    74\t}\n    75\t\n    76\thashmap_t* hashmap_create(void) {\n    77\t    hashmap_t *map = malloc(sizeof(hashmap_t));\n    78\t    if (!map) {\n    79\t        return NULL;\n    80\t    }\n    81\t    \n    82\t    map->capacity = HASHMAP_INITIAL_CAPACITY;\n    83\t    map->size = 0;\n    84\t    map->deleted_count = 0;\n    85\t    map->entries = calloc(map->capacity, sizeof(hashmap_entry_t));\n    86\t    \n    87\t    if (!map->entries) {\n    88\t        free(map);\n    89\t        return NULL;\n    90\t    }\n    91\t    \n    92\t    return map;\n    93\t}\n    94\t\n    95\tvoid hashmap_destroy(hashmap_t *map) {\n    96\t    if (map) {\n    97\t        free(map->entries);\n    98\t        free(map);\n    99\t    }\n   100\t}\n   101\t\n   102\tint hashmap_put(hashmap_t *map, tree_id_t key, void *value) {\n   103\t    if (!map) {\n   104\t        return -1;\n   105\t    }\n   106\t    \n   107\t    if (should_resize(map)) {\n   108\t        if (hashmap_resize(map) != 0) {\n   109\t            return -1;\n   110\t        }\n   111\t    }\n   112\t    \n   113\t    uint64_t hash = hash_function(key);\n   114\t    size_t index = hash % map->capacity;\n   115\t    size_t probe = 0;\n   116\t    \n   117\t    // Linear probing\n   118\t    while (probe < map->capacity) {\n   119\t        size_t current = (index + probe) % map->capacity;\n   120\t        \n   121\t        if (!map->entries[current].occupied) {\n   122\t            // Empty slot\n   123\t            map->entries[current].key = key;\n   124\t            map->entries[current].value = value;\n   125\t            map->entries[current].occupied = 1;\n   126\t            map->entries[current].deleted = 0;\n   127\t            map->size++;\n   128\t            return 0;\n   129\t        } else if (map->entries[current].deleted) {\n   130\t            // Reuse deleted slot\n   131\t            map->entries[current].key = key;\n   132\t            map->entries[current].value = value;\n   133\t            map->entries[current].deleted = 0;\n   134\t            map->size++;\n   135\t            map->deleted_count--;\n   136\t            return 0;\n   137\t        } else if (map->entries[current].key == key) {\n   138\t            // Update existing\n   139\t            map->entries[current].value = value;\n   140\t            return 0;\n   141\t        }\n   142\t        \n   143\t        probe++;\n   144\t    }\n   145\t    \n   146\t    return -1; // Map is full (shouldn't happen with resizing)\n   147\t}\n   148\t\n   149\tvoid* hashmap_get(hashmap_t *map, tree_id_t key) {\n   150\t    if (!map) {\n   151\t        return NULL;\n   152\t    }\n   153\t    \n   154\t    uint64_t hash = hash_function(key);\n   155\t    size_t index = hash % map->capacity;\n   156\t    size_t probe = 0;\n   157\t    \n   158\t    while (probe < map->capacity) {\n   159\t        size_t current = (index + probe) % map->capacity;\n   160\t        \n   161\t        if (!map->entries[current].occupied) {\n   162\t            return NULL;\n   163\t        }\n   164\t        \n   165\t        if (!map->entries[current].deleted && map->entries[current].key == key) {\n   166\t            return map->entries[current].value;\n   167\t        }\n   168\t        \n   169\t        probe++;\n   170\t    }\n   171\t    \n   172\t    return NULL;\n   173\t}\n   174\t\n   175\tvoid* hashmap_remove(hashmap_t *map, tree_id_t key) {\n   176\t    if (!map) {\n   177\t        return NULL;\n   178\t    }\n   179\t    \n   180\t    uint64_t hash = hash_function(key);\n   181\t    size_t index = hash % map->capacity;\n   182\t    size_t probe = 0;\n   183\t    \n   184\t    while (probe < map->capacity) {\n   185\t        size_t current = (index + probe) % map->capacity;\n   186\t        \n   187\t        if (!map->entries[current].occupied) {\n   188\t            return NULL;\n   189\t        }\n   190\t        \n   191\t        if (!map->entries[current].deleted && map->entries[current].key == key) {\n   192\t            void *value = map->entries[current].value;\n   193\t            map->entries[current].deleted = 1;\n   194\t            map->size--;\n   195\t            map->deleted_count++;\n   196\t            return value;\n   197\t        }\n   198\t        \n   199\t        probe++;\n   200\t    }\n   201\t    \n   202\t    return NULL;\n   203\t}\n   204\t\n   205\tint hashmap_contains(hashmap_t *map, tree_id_t key) {\n   206\t    return hashmap_get(map, key) != NULL;\n   207\t}\n   208\t\n   209\tsize_t hashmap_size(hashmap_t *map) {\n   210\t    return map ? map->size : 0;\n   211\t}\n   212\t\n   213\tvoid hashmap_clear(hashmap_t *map) {\n   214\t    if (!map) {\n   215\t        return;\n   216\t    }\n   217\t    \n   218\t    for (size_t i = 0; i < map->capacity; i++) {\n   219\t        map->entries[i].occupied = 0;\n   220\t        map->entries[i].deleted = 0;\n   221\t    }\n   222\t    \n   223\t    map->size = 0;\n   224\t    map->deleted_count = 0;\n   225\t}\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t// hashmap.h\n    26\t#ifndef HASHMAP_H\n    27\t#define HASHMAP_H\n    28\t\n    29\t#include <stddef.h>\n    30\t#include <stdint.h>\n    31\t\n    32\t#define HASHMAP_INITIAL_CAPACITY 16\n    33\t#define HASHMAP_LOAD_FACTOR 0.75\n    34\t\n    35\ttypedef uint64_t tree_id_t;\n    36\t\n    37\ttypedef struct hashmap_entry {\n    38\t    tree_id_t key;\n    39\t    void *value;\n    40\t    int occupied;\n    41\t    int deleted;\n    42\t} hashmap_entry_t;\n    43\t\n    44\ttypedef struct {\n    45\t    hashmap_entry_t *entries;\n    46\t    size_t capacity;\n    47\t    size_t size;\n    48\t    size_t deleted_count;\n    49\t} hashmap_t;\n    50\t\n    51\t// Create a new hashmap\n    52\thashmap_t* hashmap_create(void);\n    53\t\n    54\t// Destroy hashmap (does not free values)\n    55\tvoid hashmap_destroy(hashmap_t *map);\n    56\t\n    57\t// Insert or update a key-value pair\n    58\tint hashmap_put(hashmap_t *map, tree_id_t key, void *value);\n    59\t\n    60\t// Get value by key (returns NULL if not found)\n    61\tvoid* hashmap_get(hashmap_t *map, tree_id_t key);\n    62\t\n    63\t// Remove a key-value pair (returns the value or NULL)\n    64\tvoid* hashmap_remove(hashmap_t *map, tree_id_t key);\n    65\t\n    66\t// Check if key exists\n    67\tint hashmap_contains(hashmap_t *map, tree_id_t key);\n    68\t\n    69\t// Get current size\n    70\tsize_t hashmap_size(hashmap_t *map);\n    71\t\n    72\t// Clear all entries\n    73\tvoid hashmap_clear(hashmap_t *map);\n    74\t\n    75\t#endif // HASHMAP_H\n","exit_code":0,"status":"completed"}}
