{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport math\nimport random\nimport struct\n\ncl = C.CDLL('./c_reference_build/libtranslated_rust.so', mode=C.RTLD_LOCAL)\nrl = C.CDLL('./target/release/libtranslated_rust.so', mode=C.RTLD_LOCAL)\n\nclass V(C.Structure): _fields_ = [('x', C.c_float), ('y', C.c_float)]\nclass R(C.Structure): _fields_ = [('c', C.c_float), ('s', C.c_float)]\nclass X(C.Structure): _fields_ = [('p', V), ('r', R)]\nclass Circle(C.Structure): _fields_ = [('p', V), ('r', C.c_float)]\nclass AABB(C.Structure): _fields_ = [('min', V), ('max', V)]\nclass Capsule(C.Structure): _fields_ = [('a', V), ('b', V), ('r', C.c_float)]\nclass Cache(C.Structure): _fields_ = [('metric', C.c_float), ('count', C.c_int), ('iA', C.c_int*3), ('iB', C.c_int*3), ('div', C.c_float)]\nclass Proxy(C.Structure): _fields_ = [('radius', C.c_float), ('count', C.c_int), ('verts', V*8)]\nclass SV(C.Structure): _fields_ = [('sA', V), ('sB', V), ('p', V), ('u', C.c_float), ('iA', C.c_int), ('iB', C.c_int)]\nclass Simplex(C.Structure): _fields_ = [('a', SV), ('b', SV), ('c', SV), ('d', SV), ('div', C.c_float), ('count', C.c_int)]\n\ndef setup(lib):\n    sigs = {\n      'c2V': ([C.c_float,C.c_float],V), 'c2Mulvs':([V,C.c_float],V),\n      'c2Maxv':([V,V],V), 'c2Minv':([V,V],V), 'c2Clampv':([V,V,V],V),\n      'c2Sub':([V,V],V), 'c2Dot':([V,V],C.c_float), 'c2RotIdentity':([],R),\n      'c2xIdentity':([],X), 'c2BBVerts':([C.POINTER(V),C.POINTER(AABB)],None),\n      'c2MakeProxy':([C.c_void_p,C.c_int,C.POINTER(Proxy)],None), 'c2Len':([V],C.c_float),\n      'c2Det2':([V,V],C.c_float), 'c2GJKSimplexMetric':([C.POINTER(Simplex)],C.c_float),\n      'c2Mulrv':([R,V],V), 'c2Add':([V,V],V), 'c2Mulxv':([X,V],V),\n      'c22':([C.POINTER(Simplex)],None), 'c23':([C.POINTER(Simplex)],None),\n      'c2Neg':([V],V), 'c2Skew':([V],V), 'c2CCW90':([V],V), 'c2D':([C.POINTER(Simplex)],V),\n      'c2Support':([C.POINTER(V),C.c_int,V],C.c_int), 'c2Witness':([C.POINTER(Simplex),C.POINTER(V),C.POINTER(V)],None),\n      'c2Div':([V,C.c_float],V), 'c2Norm':([V],V), 'c2L':([C.POINTER(Simplex)],V), 'c2MulrvT':([R,V],V),\n      'c2GJK':([C.c_void_p,C.c_int,C.POINTER(X),C.c_void_p,C.c_int,C.POINTER(X),C.POINTER(V),C.POINTER(V),C.c_int,C.POINTER(C.c_int),C.POINTER(Cache)],C.c_float),\n      'c2AABBtoAABB':([AABB,AABB],C.c_int), 'c2AABBtoCapsule':([AABB,Capsule],C.c_int),\n      'c2CapsuletoCapsule':([Capsule,Capsule],C.c_int), 'c2CircletoCircle':([Circle,Circle],C.c_int),\n      'c2CircletoAABB':([Circle,AABB],C.c_int), 'c2CircletoCapsule':([Circle,Capsule],C.c_int),\n      'c2Collided':([C.c_void_p,C.c_int,C.c_void_p,C.c_int],C.c_int),\n      'ptr_from_parts':([C.c_int]+[C.c_float]*5,C.c_void_p),\n      'omni_collide':([C.c_int]+[C.c_float]*5+[C.c_int]+[C.c_float]*5,C.c_int),\n    }\n    for name,(args,res) in sigs.items():\n        fn=getattr(lib,name); fn.argtypes=args; fn.restype=res\nsetup(cl); setup(rl)\nlibc=C.CDLL(None); libc.free.argtypes=[C.c_void_p]\n\ndef raw(x): return bytes(C.string_at(C.byref(x),C.sizeof(x)))\ndef fraw(x): return struct.pack('=f',x)\ndef result_raw(x):\n    if isinstance(x,(V,R,X)): return raw(x)\n    if isinstance(x,float): return fraw(x)\n    return x\n\ndef eqcall(name,*args):\n    a=getattr(cl,name)(*args); b=getattr(rl,name)(*args)\n    if result_raw(a)\"'!=result_raw(b): raise AssertionError((name,result_raw(a),result_raw(b),args))\n\ndef copy(x): return type(x).from_buffer_copy(raw(x))\ndef rv(rng): return V(rng.uniform(-100,100),rng.uniform(-100,100))\ndef rsv(rng): return SV(rv(rng),rv(rng),rv(rng),rng.uniform(-100,100),rng.randrange(4),rng.randrange(4))\ndef rsimplex(rng,count): return Simplex(rsv(rng),rsv(rng),rsv(rng),rsv(rng),rng.uniform(0.1,100),count)\ndef shape(t,p):\n    return Capsule(V(*p[:2]),V(*p[2:4]),p[4]) if t==0 else Circle(V(*p[:2]),p[2]) if t==1 else AABB(V(*p[:2]),V(*p[2:4]))\n\nrng=random.Random(0xAB1C0DE)\nassert raw(cl.c2Rot