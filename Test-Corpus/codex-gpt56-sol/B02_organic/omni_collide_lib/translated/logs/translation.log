{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport random\nimport struct\n\nc_lib = C.CDLL('./c_reference_build/libtranslated_rust.so')\nr_lib = C.CDLL('./target/release/libtranslated_rust.so')\n\nclass V(C.Structure):\n    _fields_ = [('x', C.c_float), ('y', C.c_float)]\nclass R(C.Structure):\n    _fields_ = [('c', C.c_float), ('s', C.c_float)]\nclass X(C.Structure):\n    _fields_ = [('p', V), ('r', R)]\nclass Circle(C.Structure):\n    _fields_ = [('p', V), ('r', C.c_float)]\nclass AABB(C.Structure):\n    _fields_ = [('min', V), ('max', V)]\nclass Capsule(C.Structure):\n    _fields_ = [('a', V), ('b', V), ('r', C.c_float)]\nclass Cache(C.Structure):\n    _fields_ = [('metric', C.c_float), ('count', C.c_int), ('iA', C.c_int * 3), ('iB', C.c_int * 3), ('div', C.c_float)]\n\nomni_args = [C.c_int] + [C.c_float] * 5 + [C.c_int] + [C.c_float] * 5\nfor lib in (c_lib, r_lib):\n    lib.omni_collide.argtypes = omni_args\n    lib.omni_collide.restype = C.c_int\n    lib.c2GJK.argtypes = [C.c_void_p, C.c_int, C.POINTER(X), C.c_void_p, C.c_int, C.POINTER(X), C.POINTER(V), C.POINTER(V), C.c_int, C.POINTER(C.c_int), C.POINTER(Cache)]\n    lib.c2GJK.restype = C.c_float\n\ndef fbits(v):\n    return struct.pack('=f', v)\ndef raw(v):\n    return bytes(C.string_at(C.byref(v), C.sizeof(v)))\ndef shape(t, p):\n    if t == 0:\n        return Capsule(V(p[0], p[1]), V(p[2], p[3]), p[4])\n    if t == 1:\n        return Circle(V(p[0], p[1]), p[2])\n    return AABB(V(p[0], p[1]), V(p[2], p[3]))\n\nrng = random.Random(0xC0111DE)\nfor case in range(30000):\n    ta, tb = rng.randrange(3), rng.randrange(3)\n    pa = [rng.uniform(-1000, 1000) for _ in range(5)]\n    pb = [rng.uniform(-1000, 1000) for _ in range(5)]\n    ca = c_lib.omni_collide(ta, *pa, tb, *pb)\n    ra = r_lib.omni_collide(ta, *pa, tb, *pb)\n    if ca \"'!= ra:\n        raise SystemExit(f'\"'omni mismatch case={case}: {(ta, pa, tb, pb)} C={ca} Rust={ra}')\n\nfor case in range(20000):\n    ta, tb = rng.randrange(3), rng.randrange(3)\n    pa = [rng.uniform(-1000, 1000) for _ in range(5)]\n    pb = [rng.uniform(-1000, 1000) for _ in range(5)]\n    sa, sb = shape(ta, pa), shape(tb, pb)\n    angle_a = rng.uniform(-3.14, 3.14)\n    angle_b = rng.uniform(-3.14, 3.14)\n    import math\n    xa = X(V(rng.uniform(-10,10), rng.uniform(-10,10)), R(math.cos(angle_a), math.sin(angle_a)))\n    xb = X(V(rng.uniform(-10,10), rng.uniform(-10,10)), R(math.cos(angle_b), math.sin(angle_b)))\n    init = Cache(0.0, 0, (C.c_int * 3)(0,0,0), (C.c_int * 3)(0,0,0), 0.0)\n    cc = Cache.from_buffer_copy(raw(init)); rc = Cache.from_buffer_copy(raw(init))\n    coa, cob, roa, rob = V(), V(), V(), V()\n    ci, ri = C.c_int(), C.c_int()\n    cd = c_lib.c2GJK(C.byref(sa), ta, C.byref(xa), C.byref(sb), tb, C.byref(xb), C.byref(coa), C.byref(cob), case & 1, C.byref(ci), C.byref(cc))\n    rd = r_lib.c2GJK(C.byref(sa), ta, C.byref(xa), C.byref(sb), tb, C.byref(xb), C.byref(roa), C.byref(rob), case & 1, C.byref(ri), C.byref(rc))\n    got = (fbits(cd), raw(coa), raw(cob), ci.value, raw(cc))\n    want = (fbits(rd), raw(roa), raw(rob), ri.value, raw(rc))\n    if got \"'!= want:\n        raise SystemExit(f'\"'GJK mismatch case={case} types={ta,tb}\\\\nC={got}\\\\nRust={want}')\n\nprint('PASS: 30,000 omni_collide and 20,000 bit-exact c2GJK comparisons')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
