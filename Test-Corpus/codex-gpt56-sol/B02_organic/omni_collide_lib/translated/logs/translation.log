[rng.uniform(-20,20) for _ in range(5)]))),('c2AABBtoCapsule',(aabb,capsule)),('c2CapsuletoCapsule',(capsule,shape(0,[rng.uniform(-20,20) for _ in range(5)]))),('c2CircletoCircle',(circle,shape(1,[rng.uniform(-20,20) for _ in range(5)]))),('c2CircletoAABB',(circle,aabb)),('c2CircletoCapsule',(circle,capsule))]: eqcall(name,*args)\n    for ta in range(3):\n      for tb in range(3): eqcall('c2Collided',C.byref(objs[ta]),ta,C.byref(objs[tb]),tb)\n\nsizes=[C.sizeof(Capsule),C.sizeof(Circle),C.sizeof(AABB)]\nfor t in range(3):\n  for _ in range(1000):\n    p=[rng.uniform(-20,20) for _ in range(5)]\n    cp=cl.ptr_from_parts(t,*p); rp=rl.ptr_from_parts(t,*p)\n    assert C.string_at(cp,sizes[t])==C.string_at(rp,sizes[t])\n    libc.free(cp); libc.free(rp)\n\n# Exercise the cache-read branch by feeding each implementation its first-call cache.\nfor _ in range(10000):\n    ta,tb=rng.randrange(3),rng.randrange(3); sa=shape(ta,[rng.uniform(-20,20) for _ in range(5)]); sb=shape(tb,[rng.uniform(-20,20) for _ in range(5)])\n    cc,rc=Cache(),Cache(); coa,cob,roa,rob=V(),V(),V(),V(); ci,ri=C.c_int(),C.c_int()\n    for passno in range(2):\n        cd=cl.c2GJK(C.byref(sa),ta,None,C.byref(sb),tb,None,C.byref(coa),C.byref(cob),1,C.byref(ci),C.byref(cc))\n        rd=rl.c2GJK(C.byref(sa),ta,None,C.byref(sb),tb,None,C.byref(roa),C.byref(rob),1,C.byref(ri),C.byref(rc))\n        assert (fraw(cd),raw(coa),raw(cob),ci.value,raw(cc))==(fraw(rd),raw(roa),raw(rob),ri.value,raw(rc))\n\nprint('PASS: all 39 exports exercised with byte-exact differential checks')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
