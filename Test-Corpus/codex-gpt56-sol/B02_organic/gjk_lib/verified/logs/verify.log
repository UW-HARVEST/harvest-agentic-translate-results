148\t#[cfg(target_arch = \"x86_64\")]\n   149\t#[inline(always)]\n   150\tfn fp_mul(lhs: f32, rhs: f32) -> f32 {\n   151\t    let mut result = lhs;\n   152\t    unsafe {\n   153\t        std::arch::asm!(\n   154\t            \"mulss {result}, {rhs}\",\n   155\t            result = inout(xmm_reg) result,\n   156\t            rhs = in(xmm_reg) rhs,\n   157\t            options(pure, nomem, nostack, preserves_flags),\n   158\t        );\n   159\t    }\n   160\t    result\n   161\t}\n   162\t\n   163\t#[cfg(not(target_arch = \"x86_64\"))]\n   164\t#[inline(always)]\n   165\tfn fp_mul(lhs: f32, rhs: f32) -> f32 {\n   166\t    lhs * rhs\n   167\t}\n   168\t\n   169\t#[unsafe(no_mangle)]\n   170\t#[inline(never)]\n   171\tpub extern \"C\" fn c2V(x: f32, y: f32) -> C2v {\n   172\t    C2v { x, y }\n   173\t}\n   174\t\n   175\t#[unsafe(no_mangle)]\n   176\t#[inline(never)]\n   177\tpub extern \"C\" fn c2Mulvs(mut a: C2v, b: f32) -> C2v {\n   178\t    a.x = fp_mul(b, a.x);\n   179\t    a.y = fp_mul(b, a.y);\n   180\t    a\n   181\t}\n   182\t\n   183\t#[unsafe(no_mangle)]\n   184\t#[inline(never)]\n   185\tpub extern \"C\" fn c2Maxv(a: C2v, b: C2v) -> C2v {\n   186\t    c2V(\n   187\t        if a.x > b.x { a.x } else { b.x },\n   188\t        if a.y > b.y { a.y } else { b.y },\n   189\t    )\n   190\t}\n   191\t\n   192\t#[unsafe(no_mangle)]\n   193\t#[inline(never)]\n   194\tpub extern \"C\" fn c2Minv(a: C2v, b: C2v) -> C2v {\n   195\t    c2V(\n   196\t        if a.x < b.x { a.x } else { b.x },\n   197\t        if a.y < b.y { a.y } else { b.y },\n   198\t    )\n   199\t}\n   200\t\n   201\t#[unsafe(no_mangle)]\n   202\t#[inline(never)]\n   203\tpub extern \"C\" fn c2Clampv(a: C2v, lo: C2v, hi: C2v) -> C2v {\n   204\t    c2Maxv(lo, c2Minv(a, hi))\n   205\t}\n   206\t\n   207\t#[unsafe(no_mangle)]\n   208\t#[inline(never)]\n   209\tpub extern \"C\" fn c2Sub(mut a: C2v, b: C2v) -> C2v {\n   210\t    a.x = fp_sub(a.x, b.x);\n   211\t    a.y = fp_sub(a.y, b.y);\n   212\t    a\n   213\t}\n   214\t\n   215\t#[unsafe(no_mangle)]\n   216\t#[inline(never)]\n   217\tpub extern \"C\" fn c2Dot(a: C2v, b: C2v) -> f32 {\n   218\t    fp_add(fp_mul(a.x, b.x), fp_mul(a.y, b.y))\n   219\t}\n   220\t\n   221\t#[unsafe(no_mangle)]\n   222\t#[inline(never)]\n   223\tpub extern \"C\" fn c2RotIdentity() -> C2r {\n   224\t    C2r { c: 1.0, s: 0.0 }\n   225\t}\n   226\t\n   227\t#[unsafe(no_mangle)]\n   228\t#[inline(never)]\n   229\tpub extern \"C\" fn c2xIdentity() -> C2x {\n   230\t    C2x {\n   231\t        p: c2V(0.0, 0.0),\n   232\t        r: c2RotIdentity(),\n   233\t    }\n   234\t}\n   235\t\n   236\t#[unsafe(no_mangle)]\n   237\t#[inline(never)]\n   238\tpub extern \"C\" fn c2BBVerts(out: *mut C2v, bb: *mut C2Aabb) {\n   239\t    unsafe {\n   240\t        let bb = *bb;\n   241\t        *out.add(0) = bb.min;\n   242\t        *out.add(1) = c2V(bb.max.x, bb.min.y);\n   243\t        *out.add(2) = bb.max;\n   244\t        *out.add(3) = c2V(bb.min.x, bb.max.y);\n   245\t    }\n   246\t}\n   247\t\n   248\t#[unsafe(no_mangle)]\n   249\t#[inline(never)]\n   250\tpub extern \"C\" fn c2MakeProxy(shape: *const c_void, shape_type: C2Type, p: *mut C2Proxy) {\n   251\t    unsafe {\n   252\t        match shape_type {\n   253\t            C2Type::Circle => {\n   254\t                let circle = &*(shape.cast::<C2Circle>());\n   255\t                (*p).radius = circle.r;\n   256\t                (*p).count = 1;\n   257\t                (*p).verts[0] = circle.p;\n   258\t            }\n   259\t            C2Type::Aabb => {\n   260\t                let bb = shape.cast::<C2Aabb>().cast_mut();\n   261\t                (*p).radius = 0.0;\n   262\t                (*p).count = 4;\n   263\t                c2BBVerts((*p).verts.as_mut_ptr(), bb);\n   264\t            }\n   265\t            C2Type::Capsule => {\n   266\t                let capsule = &*(shape.cast::<C2Capsule>());\n   267\t                (*p).radius = capsule.r;\n   268\t                (*p).count = 2;\n   269\t                (*p).verts[0] = capsule.a;\n   270\t                (*p).verts[1] = capsule.b;\n   271\t            }\n   272\t        }\n   273\t    }\n   274\t}\n   275\t\n   276\t#[unsafe(no_mangle)]\n   277\t#[inline(never)]\n   278\tpub extern \"C\" fn c2Len(a: C2v) -> f32 {\n   279\t    c2Dot(a, a).sqrt()\n   280\t}\n   281\t\n   282\t#[unsafe(no_mangle)]\n   283\t#[inline(never)]\n   284\tpub extern \"C\" fn c2Det2(a: C2v, b: C2v) -> f32 {\n   285\t    fp_sub(fp_mul(a.x, b.y), fp_mul(a.y, b.x))\n   286\t}\n   287\t\n   288\t#[unsafe(no_mangle)]\n   289\t#[inline(never)]\n   290\tpub extern \"C\" fn c2GJKSimplexMetric(s: *mut C2Simplex) -> f32 {\n   291\t    unsafe {\n   292\t        match (*s).count {\n   293\t            2 => c2Len(c2Sub((*s).b.p, (*s).a.p)),\n   294\t            3 => c2Det2(c2Sub((*s).b.p, (*s).a.p), c2Sub((*s).c.p, (*s).a.p)),\n   295\t            _ => 0.0,\n   296\t        }\n   297\t    }\n   298\t}\n   299\t\n   300\t#[unsafe(no_mangle)]\n   301\t#[inline(never)]\n   302\tpub extern \"C\" fn c2Mulrv(a: C2r, b: C2v) -> C2v {\n   303\t    c2V(\n   304\t        fp_sub(fp_mul(a.c, b.x), fp_mul(a.s, b.y)),\n   305\t        fp_add(fp_mul(a.c, b.y), fp_mul(a.s, b.x)),\n   306\t    )\n   307\t}\n   308\t\n   309\t#[unsafe(no_mangle)]\n   310\t#[inline(never)]\n   311\tpub extern \"C\" fn c2Add(mut a: C2v, b: C2v) -> C2v {\n   312\t    a.x = fp_add(a.x, b.x);\n   313\t    a.y = fp_add(a.y, b.y);\n   314\t    a\n   315\t}\n   316\t\n   317\t#[unsafe(no_mangle)]\n   318\t#[inline(never)]\n   319\tpub extern \"C\" fn c2Mulxv(a: C2x, b: C2v) -> C2v {\n   320\t    c2Add(c2Mulrv(a.r, b), a.p)\n   321\t}\n   322\t\n   323\t#[unsafe(no_mangle)]\n   324\t#[inline(never)]\n   325\tpub extern \"C\" fn c22(s: *mut C2Simplex) {\n   326\t    unsafe {\n   327\t        let a = (*s).a.p;\n   328\t        let b = (*s).b.p;\n   329\t        let u = c2Dot(b, c2Sub(b, a));\n   330\t        let v = c2Dot(a, c2Sub(a, b));\n   331\t        if v <= 0.0 {\n   332\t            (*s).a.u = 1.0;\n   333\t            (*s).div = 1.0;\n   334\t            (*s).count = 1;\n   335\t        } else if u <= 0.0 {\n   336\t            (*s).a = (*s).b;\n   337\t            (*s).a.u = 1.0;\n   338\t            (*s).div = 1.0;\n   339\t            (*s).count = 1;\n   340\t        } else {\n   341\t            (*s).a.u = u;\n   342\t            (*s).b.u = v;\n   343\t            (*s).div = fp_add(u, v);\n   344\t            (*s).count = 2;\n   345\t        }\n   346\t    }\n   347\t}\n   348\t\n   349\t#[unsafe(no_mangle)]\n   350\t#[inline(never)]\n   351\tpub extern \"C\" fn c23(s: *mut C2Simplex) {\n   352\t    unsafe {\n   353\t        let a = (*s).a.p;\n   354\t        let b = (*s).b.p;\n   355\t        let c = (*s).c.p;\n   356\t        let uAB = c2Dot(b, c2Sub(b, a));\n   357\t        let vAB = c2Dot(a, c2Sub(a, b));\n   358\t        let uBC = c2Dot(c, c2Sub(c, b));\n   359\t        let vBC = c2Dot(b, c2Sub(b, c));\n   360\t        let uCA = c2Dot(a, c2Sub(a, c));\n   361\t        let vCA = c2Dot(c, c2Sub(c, a));\n   362\t        let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n   363\t        let uABC = fp_mul(c2Det2(b, c), area);\n   364\t        let vABC = fp_mul(c2Det2(c, a), area);\n   365\t        let wABC = fp_mul(c2Det2(a, b), area);\n   366\t        if vAB <= 0.0 && uCA <= 0.0 {\n   367\t            (*s).a.u = 1.0;\n   368\t            (*s).div = 1.0;\n   369\t            (*s).count = 1;\n   370\t        } else if uAB <= 0.0 && vBC <= 0.0 {\n   371\t            (*s).a = (*s).b;\n   372\t            (*s).a.u = 1.0;\n   373\t            (*s).div = 1.0;\n   374\t            (*s).count = 1;\n   375\t        } else if uBC <= 0.0 && vCA <= 0.0 {\n   376\t            (*s).a = (*s).c;\n   377\t            (*s).a.u = 1.0;\n   378\t            (*s).div = 1.0;\n   379\t            (*s).count = 1;\n   380\t        } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n   381\t            (*s).a.u = uAB;\n   382\t            (*s).b.u = vAB;\n   383\t            (*s).div = fp_add(uAB, vAB);\n   384\t            (*s).count = 2;\n   385\t        } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n   386\t            (*s).a = (*s).b;\n   387\t            (*s).b = (*s).c;\n   388\t            (*s).a.u = uBC;\n   389\t            (*s).b.u = vBC;\n   390\t            (*s).div = fp_add(vBC, uBC);\n   391\t            (*s).count = 2;\n   392\t        } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n   393\t            (*s).b = (*s).a;\n   394\t            (*s).a = (*s).c;\n   395\t            (*s).a.u = uCA;\n   396\t            (*s).b.u = vCA;\n   397\t            (*s).div = fp_add(uCA, vCA);\n   398\t            (*s).count = 2;\n   399\t        } else {\n   400\t            (*s).a.u = uABC;\n   401\t            (*s).b.u = vABC;\n   402\t            (*s).c.u = wABC;\n   403\t            (*s).div = fp_add(wABC, fp_add(uABC, vABC));\n   404\t            (*s).count = 3;\n   405\t        }\n   406\t    }\n   407\t}\n   408\t\n   409\t#[unsafe(no_mangle)]\n   410\t#[inline(never)]\n   411\tpub extern \"C\" fn c2Neg(a: C2v) -> C2v {\n   412\t    c2V(-a.x, -a.y)\n   413\t}\n   414\t\n   415\t#[unsafe(no_mangle)]\n   416\t#[inline(never)]\n   417\tpub extern \"C\" fn c2Skew(a: C2v) -> C2v {\n   418\t    C2v { x: -a.y, y: a.x }\n   419\t}\n   420\t\n   421\t#[unsafe(no_mangle)]\n   422\t#[inline(never)]\n   423\tpub extern \"C\" fn c2CCW90(a: C2v) -> C2v {\n   424\t    C2v { x: a.y, y: -a.x }\n   425\t}\n   426\t\n   427\t#[unsafe(no_mangle)]\n   428\t#[inline(never)]\n   429\tpub extern \"C\" fn c2D(s: *mut C2Simplex) -> C2v {\n   430\t    unsafe {\n   431\t        match (*s).count {\n   432\t            1 => c2Neg((*s).a.p),\n   433\t            2 => {\n   434\t                let ab = c2Sub((*s).b.p, (*s).a.p);\n   435\t                if c2Det2(ab, c2Neg((*s).a.p)) > 0.0 {\n   436\t                    c2Skew(ab)\n   437\t                } else {\n   438\t                    c2CCW90(ab)\n   439\t                }\n   440\t            }\n   441\t            _ => c2V(0.0, 0.0),\n   442\t        }\n   443\t    }\n   444\t}\n   445\t\n   446\t#[unsafe(no_mangle)]\n   447\t#[inline(never)]\n   448\tpub extern \"C\" fn c2Support(verts: *const C2v, count: c_int, d: C2v) -> c_int {\n   449\t    unsafe {\n   450\t        let mut imax = 0;\n   451\t        let mut dmax = c2Dot(*verts, d);\n   452\t        let mut i = 1;\n   453\t        while i < count {\n   454\t            let dot = c2Dot(*verts.add(i as usize), d);\n   455\t            if dot > dmax {\n   456\t                imax = i;\n   457\t                dmax = dot;\n   458\t            }\n   459\t            i += 1;\n   460\t        }\n   461\t        imax\n   462\t    }\n   463\t}\n   464\t\n   465\t#[unsafe(no_mangle)]\n   466\t#[inline(never)]\n   467\tpub extern \"C\" fn c2Witness(s: *mut C2Simplex, a: *mut C2v, b: *mut C2v) {\n   468\t    unsafe {\n   469\t        let den = 1.0 / (*s).div;\n   470\t        match (*s).count {\n   471\t            1 => {\n   472\t                *a = (*s).a.sA;\n   473\t                *b = (*s).a.sB;\n   474\t            }\n   475\t            2 => {\n   476\t                *a = c2Add(\n   477\t                    c2Mulvs((*s).a.sA, fp_mul(den, (*s).a.u)),\n   478\t                    c2Mulvs((*s).b.sA, fp_mul(den, (*s).b.u)),\n   479\t                );\n   480\t                *b = c2Add(\n   481\t                    c2Mulvs((*s).a.sB, fp_mul(den, (*s).a.u)),\n   482\t                    c2Mulvs((*s).b.sB, fp_mul(den, (*s).b.u)),\n   483\t                );\n   484\t            }\n   485\t            3 => {\n   486\t                *a = c2Add(\n   487\t                    c2Add(\n   488\t                        c2Mulvs((*s).a.sA, fp_mul(den, (*s).a.u)),\n   489\t                        c2Mulvs((*s).b.sA, fp_mul(den, (*s).b.u)),\n   490\t                    ),\n   491\t                    c2Mulvs((*s).c.sA, fp_mul(den, (*s).c.u)),\n   492\t                );\n   493\t                *b = c2Add(\n   494\t                    c2Add(\n   495\t                        c2Mulvs((*s).a.sB, fp_mul(den, (*s).a.u)),\n   496\t                        c2Mulvs((*s).b.sB, fp_mul(den, (*s).b.u)),\n   497\t                    ),\n   498\t                    c2Mulvs((*s).c.sB, fp_mul(den, (*s).c.u)),\n   499\t                );\n   500\t            }\n   501\t            _ => {\n   502\t                *a = c2V(0.0, 0.0);\n   503\t                *b = c2V(0.0, 0.0);\n   504\t            }\n   505\t        }\n   506\t    }\n   507\t}\n   508\t\n   509\t#[unsafe(no_mangle)]\n   510\t#[inline(never)]\n   511\tpub extern \"C\" fn c2Div(a: C2v, b: f32) -> C2v {\n   512\t    c2Mulvs(a, 1.0 / b)\n   513\t}\n   514\t\n   515\t#[unsafe(no_mangle)]\n   516\t#[inline(never)]\n   517\tpub extern \"C\" fn c2Norm(a: C2v) -> C2v {\n   518\t    c2Div(a, c2Len(a))\n   519\t}\n   520\t\n   521\t#[unsafe(no_mangle)]\n   522\t#[inline(never)]\n   523\tpub extern \"C\" fn c2L(s: *mut C2Simplex) -> C2v {\n   524\t    unsafe {\n   525\t        let den = 1.0 / (*s).div;\n   526\t        match (*s).count {\n   527\t            1 => (*s).a.p,\n   528\t            2 => c2Add(\n   529\t                c2Mulvs((*s).a.p, fp_mul((*s).a.u, den)),\n   530\t                c2Mulvs((*s).b.p, fp_mul(den, (*s).b.u)),\n   531\t            ),\n   532\t            _ => c2V(0.0, 0.0),\n   533\t        }\n   534\t    }\n   535\t}\n   536\t\n   537\t#[unsafe(no_mangle)]\n   538\t#[inline(never)]\n   539\tpub extern \"C\" fn c2MulrvT(a: C2r, b: C2v) -> C2v {\n   540\t    c2V(\n   541\t        fp_add(fp_mul(a.c, b.x), fp_mul(a.s, b.y)),\n   542\t        fp_sub(fp_mul(a.c, b.y), fp_mul(a.s, b.x)),\n   543\t    )\n   544\t}\n   545\t\n   546\t#[unsafe(no_mangle)]\n   547\t#[inline(never)]\n   548\tpub extern \"C\" fn c2GJK(\n   549\t    A: *const c_void,\n   550\t    typeA: C2Type,\n   551\t    ax_ptr: *const C2x,\n   552\t    B: *const c_void,\n   553\t    typeB: C2Type,\n   554\t    bx_ptr: *const C2x,\n   555\t    out