 0.0;\n   606\t                    i += 1;\n   607\t                }\n   608\t                s.count = (*cache).count;\n   609\t                s.div = (*cache).div;\n   610\t                let metric_old = (*cache).metric;\n   611\t                let metric = c2GJKSimplexMetric(&mut s);\n   612\t                let min_metric = if metric < metric_old {\n   613\t                    metric\n   614\t                } else {\n   615\t                    metric_old\n   616\t                };\n   617\t                let max_metric = if metric > metric_old {\n   618\t                    metric\n   619\t                } else {\n   620\t                    metric_old\n   621\t                };\n   622\t                if !(min_metric < max_metric * 2.0 && metric < -1.0e8) {\n   623\t                    cache_was_read = true;\n   624\t                }\n   625\t            }\n   626\t        }\n   627\t        if !cache_was_read {\n   628\t            s.a.iA = 0;\n   629\t            s.a.iB = 0;\n   630\t            s.a.sA = c2Mulxv(ax, pA.verts[0]);\n   631\t            s.a.sB = c2Mulxv(bx, pB.verts[0]);\n   632\t            s.a.p = c2Sub(s.a.sB, s.a.sA);\n   633\t            s.a.u = 1.0;\n   634\t            s.div = 1.0;\n   635\t            s.count = 1;\n   636\t        }\n   637\t        let mut saveA = [0; 3];\n   638\t        let mut saveB = [0; 3];\n   639\t        let mut d0 = f32::MAX;\n   640\t        let mut iter = 0;\n   641\t        let mut hit = false;\n   642\t        while iter < 20 {\n   643\t            let save_count = s.count;\n   644\t            let mut i = 0;\n   645\t            while i < save_count {\n   646\t                saveA[i as usize] = (*verts.add(i as usize)).iA;\n   647\t                saveB[i as usize] = (*verts.add(i as usize)).iB;\n   648\t                i += 1;\n   649\t            }\n   650\t            match s.count {\n   651\t                2 => c22(&mut s),\n   652\t                3 => c23(&mut s),\n   653\t            