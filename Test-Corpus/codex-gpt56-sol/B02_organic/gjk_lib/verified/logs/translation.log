{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport random\nimport struct\n\nclass V(C.Structure):\n    _fields_ = [('x', C.c_float), ('y', C.c_float)]\n\nlibs = [C.CDLL('.c-reference-build/libtranslated_rust.so'), C.CDLL('target/release/libtranslated_rust.so')]\nfor lib in libs:\n    lib.gjk.argtypes = [C.c_char, C.POINTER(V), C.POINTER(V)] + [C.c_float] * 9\n    lib.gjk.restype = None\n\ndef bits(v):\n    return bytes(v)\n\nrng = random.Random(0xC2)\nfor case in range(50000):\n    x1, x2 = sorted((rng.uniform(-1000, 1000), rng.uniform(-1000, 1000)))\n    y1, y2 = sorted((rng.uniform(-1000, 1000), rng.uniform(-1000, 1000)))\n    values = [x1, y1, x2, y2,\n              rng.uniform(-1000, 1000), rng.uniform(-1000, 1000),\n              rng.uniform(-1000, 1000), rng.uniform(-1000, 1000),\n              rng.uniform(0, 100)]\n    reverse = case & 1\n    outputs = []\n    for lib in libs:\n        a, b = V(), V()\n        lib.gjk(reverse, C.byref(a), C.byref(b), *values)\n        outputs.append((bits(a), bits(b)))\n    if outputs[0] \"'!= outputs[1]:\n        print('\"'mismatch', case, reverse, values, outputs)\n        raise SystemExit(1)\nprint('gjk byte-identical cases: 50000')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
