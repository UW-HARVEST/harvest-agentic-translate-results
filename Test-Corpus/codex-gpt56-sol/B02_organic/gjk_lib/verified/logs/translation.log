{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport random\nimport struct\n\nclass V(C.Structure): _fields_=[('x',C.c_float),('y',C.c_float)]\nclass R(C.Structure): _fields_=[('c',C.c_float),('s',C.c_float)]\nclass X(C.Structure): _fields_=[('p',V),('r',R)]\nclass Circle(C.Structure): _fields_=[('p',V),('r',C.c_float)]\nclass AABB(C.Structure): _fields_=[('min',V),('max',V)]\nclass Capsule(C.Structure): _fields_=[('a',V),('b',V),('r',C.c_float)]\nclass Cache(C.Structure): _fields_=[('metric',C.c_float),('count',C.c_int),('iA',C.c_int*3),('iB',C.c_int*3),('div',C.c_float)]\nclass Proxy(C.Structure): _fields_=[('radius',C.c_float),('count',C.c_int),('verts',V*8)]\nclass SV(C.Structure): _fields_=[('sA',V),('sB',V),('p',V),('u',C.c_float),('iA',C.c_int),('iB',C.c_int)]\nclass Simplex(C.Structure): _fields_=[('a',SV),('b',SV),('c',SV),('d',SV),('div',C.c_float),('count',C.c_int)]\n\nclib=C.CDLL('.c-reference-build/libtranslated_rust.so')\nrlib=C.CDLL('target/release/libtranslated_rust.so')\nlibs=(clib,rlib)\ncovered=set()\nrng=random.Random(0xAB1)\n\ndef raw(x):\n    if isinstance(x,C.Structure) or isinstance(x,C.Array): return bytes(x)\n    if isinstance(x,float): return struct.pack('=f',x)\n    if isinstance(x,int): return struct.pack('=i',x)\n    if x is None: return b''\n    raise TypeError(type(x))\n\ndef proto(name,args,ret):\n    covered.add(name)\n    for lib in libs:\n        f=getattr(lib,name); f.argtypes=args; f.restype=ret\n\ndef same_value(name,args):\n    vals=[getattr(lib,name)(*args) for lib in libs]\n    if raw(vals[0]) \"'!= raw(vals[1]): raise AssertionError((name,args,raw(vals[0]).hex(),raw(vals[1]).hex()))\n\nvalue_specs={\n'\"'c2V':([C.c_float,C.c_float],V), 'c2Mulvs':([V,C.c_float],V),\n'c2Maxv':([V,V],V), 'c2Minv':([V,V],V), 'c2Clampv':([V,V,V],V),\n'c2Sub':([V,V],V), 'c2Dot':([V,V],C.c_float), 'c2RotIdentity':([],R),\n'c2xIdentity':([],X), 'c2Len':([V],C.c_float), 'c2Det2':([V,V],C.c_float),\n'c2Mulrv':([R,V],V), 'c2Add':([V,V],V), 'c2Mulxv':([X,V],V),\n'c2Neg':([V],V), 'c2Skew':([V],V), 'c2CCW90':([V],V),\n'c2Div':([V,C.c_float],V), 'c2Norm':([V],V), 'c2MulrvT':([R,V],V),\n}\nfor n,(a,r) in value_specs.items(): proto(n,a,r)\nfor _ in range(10000):\n    f=lambda: C.c_float(rng.uniform(-100,100)).value\n    a,b,lo,hi=V(f(),f()),V(f(),f()),V(f(),f()),V(f(),f())\n    lo,hi=V(min(lo.x,hi.x),min(lo.y,hi.y)),V(max(lo.x,hi.x),max(lo.y,hi.y))\n    s=f() or 1.0; rot=R(f(),f()); x=X(a,rot)\n    calls=[('c2V',(f(),f())),('c2Mulvs',(a,s)),('c2Maxv',(a,b)),('c2Minv',(a,b)),\n      ('c2Clampv',(a,lo,hi)),('c2Sub',(a,b)),('c2Dot',(a,b)),('c2Len',(a,)),\n      ('c2Det2',(a,b)),('c2Mulrv',(rot,a)),('c2Add',(a,b)),('c2Mulxv',(x,b)),\n      ('c2Neg',(a,)),('c2Skew',(a,)),('c2CCW90',(a,)),('c2Div',(a,s)),\n      ('c2Norm',(a,)),('c2MulrvT',(rot,a))]\n    for n,args in calls: same_value(n,args)\nsame_value('c2RotIdentity',()); same_value('c2xIdentity',())\n\nproto('c2BBVerts',[C.POINTER(V),C.POINTER(AABB)],None)\nproto('c2MakeProxy',[C.c_void_p,C.c_int,C.POINTER(Proxy)],None)\nfor _ in range(2000):\n    f=lambda: C.c_float(rng.uniform(-100,100)).value\n    shapes=[Circle(V(f(),f()),abs(f())), AABB(V(f(),f()),V(f(),f())), Capsule(V(f(),f()),V(f(),f()),abs(f()))]\n    bb=shapes[1]\n    outs=[]\n    for lib in libs:\n        out=(V*4)(); local=AABB.from_buffer_copy(bytes(bb)); lib.c2BBVerts(out,C.byref(local)); outs.append(bytes(out))\n    assert outs[0]==outs[1]\n    for typ,shape in enumerate(shapes):\n        outs=[]\n        for lib in libs:\n            p=Proxy(); C.memset(C.byref(p),0xA5,C.sizeof(p)); local=type(shape).from_buffer_copy(bytes(shape))\n            lib.c2MakeProxy(C.byref(local),typ,C.byref(p)); outs.append(bytes(p))\n        assert outs[0]==outs[1],('proxy',typ)\n\nproto('c22',[C.POINTER(Simplex)],None); proto('c23',[C.POINTER(Simplex)],None)\nproto('c2GJKSimplexMetric',[C.POINTER(Simplex)],C.c_float)\nproto('c2D',[C.