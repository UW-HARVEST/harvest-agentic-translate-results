t#[unsafe(no_mangle)]\n   266\tpub extern \"C\" fn c23(s: *mut c2Simplex) {\n   267\t    unsafe {\n   268\t        let a = (*s).verts[0].p;\n   269\t        let b = (*s).verts[1].p;\n   270\t        let c = (*s).verts[2].p;\n   271\t        let uAB = c2Dot(b, c2Sub(b, a));\n   272\t        let vAB = c2Dot(a, c2Sub(a, b));\n   273\t        let uBC = c2Dot(c, c2Sub(c, b));\n   274\t        let vBC = c2Dot(b, c2Sub(b, c));\n   275\t        let uCA = c2Dot(a, c2Sub(a, c));\n   276\t        let vCA = c2Dot(c, c2Sub(c, a));\n   277\t        let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n   278\t        let uABC = c2Det2(b, c) * area;\n   279\t        let vABC = c2Det2(c, a) * area;\n   280\t        let wABC = c2Det2(a, b) * area;\n   281\t        if vAB <= 0.0 && uCA <= 0.0 {\n   282\t            (*s).verts[0].u = 1.0;\n   283\t            (*s).div = 1.0;\n   284\t            (*s).count = 1;\n   285\t        } else if uAB <= 0.0 && vBC <= 0.0 {\n   286\t            (*s).verts[0] = (*s).verts[1];\n   287\t            (*s).verts[0].u = 1.0;\n   288\t            (*s).div = 1.0;\n   289\t            (*s).count = 1;\n   290\t        } else if uBC <= 0.0 && vCA <= 0.0 {\n   291\t            (*s).verts[0] = (*s).verts[2];\n   292\t            (*s).verts[0].u = 1.0;\n   293\t            (*s).div = 1.0;\n   294\t            (*s).count = 1;\n   295\t        } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n   296\t            (*s).verts[0].u = uAB;\n   297\t            (*s).verts[1].u = vAB;\n   298\t            (*s).div = uAB + vAB;\n   299\t            (*s).count = 2;\n   300\t        } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n   301\t            (*s).verts[0] = (*s).verts[1];\n   302\t            (*s).verts[1] = (*s).verts[2];\n   303\t            (*s).verts[0].u = uBC;\n   304\t            (*s).verts[1].u = vBC;\n   305\t            (*s).div = uBC + vBC;\n   306\t            (*s).count = 2;\n   307\t        } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n   308\t            (*s).verts[1] = (*s).verts[0];\n   309\t            (*s).verts[0] = (*s).verts[2];\n   310\t            (*s).verts[0].u = uCA;\n   311\t            (*s).verts[1].u = vCA;\n   312\t            (*s).div = uCA + vCA;\n   313\t            (*s).count = 2;\n   314\t        } else {\n   315\t            (*s).verts[0].u = uABC;\n   316\t            (*s).verts[1].u = vABC;\n   317\t            (*s).verts[2].u = wABC;\n   318\t            (*s).div = uABC + vABC + wABC;\n   319\t            (*s).count = 3;\n   320\t        }\n   321\t    }\n   322\t}\n   323\t\n   324\t#[unsafe(no_mangle)]\n   325\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n   326\t    c2V(-a.x, -a.y)\n   327\t}\n   328\t\n   329\t#[unsafe(no_mangle)]\n   330\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n   331\t    c2v { x: -a.y, y: a.x }\n   332\t}\n   333\t\n   334\t#[unsafe(no_mangle)]\n   335\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n   336\t    c2v { x: a.y, y: -a.x }\n   337\t}\n   338\t\n   339\t#[unsafe(no_mangle)]\n   340\tpub extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n   341\t    unsafe {\n   342\t        match (*s).count {\n   343\t            1 => c2Neg((*s).verts[0].p),\n   344\t            2 => {\n   345\t                let ab = c2Sub((*s).verts[1].p, (*s).verts[0].p);\n   346\t                if c2Det2(ab, c2Neg((*s).verts[0].p)) > 0.0 {\n   347\t                    c2Skew(ab)\n   348\t                } else {\n   349\t                    c2CCW90(ab)\n   350\t                }\n   351\t            }\n   352\t            _ => c2V(0.0, 0.0),\n   353\t        }\n   354\t    }\n   355\t}\n   356\t\n   357\t#[unsafe(no_mangle)]\n   358\tpub extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n   359\t    unsafe {\n   360\t        let mut imax = 0;\n   361\t        let mut dmax = c2Dot(verts.read(), d);\n   362\t        let mut i = 1;\n   363\t        while i < count {\n   364\t            let dot = c2Dot(verts.add(i as usize).read(), d);\n   365\t      