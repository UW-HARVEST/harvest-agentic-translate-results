\n        }\n        let trns_len = if trns.is_null() {\n            0\n        } else {\n            chunk_byte_length(trns)\n        };\n        depalette(img.w, img.h, out, img.pix, plte, trns, trns_len);\n    } else {\n        convert(bpp, img.w, img.h, out, img.pix);\n    }\n    free(data.cast());\n    img\n}\n","exit_code":0,"status":"completed"}}
