    35\t\n    36\t#[repr(C)]\n    37\tpub struct Stat {\n    38\t    st_dev: u64,\n    39\t    st_ino: u64,\n    40\t    st_nlink: u64,\n    41\t    st_mode: u32,\n    42\t    st_uid: u32,\n    43\t    st_gid: u32,\n    44\t    __pad0: c_int,\n    45\t    st_rdev: u64,\n    46\t    st_size: i64,\n    47\t    st_blksize: i64,\n    48\t    st_blocks: i64,\n    49\t    st_atime: i64,\n    50\t    st_atime_nsec: i64,\n    51\t    st_mtime: i64,\n    52\t    st_mtime_nsec: i64,\n    53\t    st_ctime: i64,\n    54\t    st_ctime_nsec: i64,\n    55\t    __reserved: [i64; 3],\n    56\t}\n    57\t\n    58\t#[repr(C)]\n    59\tpub struct FileQueue {\n    60\t    last_change: i64,\n    61\t    year: c_int,\n    62\t    day: c_int,\n    63\t    flags: c_int,\n    64\t    mon: [c_char; 4],\n    65\t    file_name: [c_char; MAX_FQUEUE + 1],\n    66\t    fp: *mut CFile,\n    67\t    f_status: Stat,\n    68\t}\n    69\t\n    70\t#[repr(C)]\n    71\tpub struct AlertData {\n    72\t    rule: c_uint,\n    73\t    level: c_uint,\n    74\t    alertid: *mut c_char,\n    75\t    date: *mut c_char,\n    76\t    location: *mut c_char,\n    77\t    comment: *mut c_char,\n    78\t    group: *mut c_char,\n    79\t    srcip: *mut c_char,\n    80\t    srcport: c_int,\n    81\t    dstip: *mut c_char,\n    82\t    dstport: c_int,\n    83\t    user: *mut c_char,\n    84\t    filename: *mut c_char,\n    85\t}\n    86\t\n    87\tconst _: () = {\n    88\t    assert!(size_of::<Tm>() == 56);\n    89\t    assert!(size_of::<Stat>() == 144);\n    90\t    assert!(std::mem::offset_of!(Stat, st_mtime) == 88);\n    91\t    assert!(size_of::<FileQueue>() == 440);\n    92\t    assert!(std::mem::offset_of!(FileQueue, fp) == 288);\n    93\t    assert!(std::mem::offset_of!(FileQueue, f_status) == 296);\n    94\t    assert!(size_of::<AlertData>() == 96);\n    95\t    assert!(std::mem::offset_of!(AlertData, srcport) == 56);\n    96\t    assert!(std::mem::offset_of!(AlertData, filename) == 88);\n    97\t};\n    98\t\n  