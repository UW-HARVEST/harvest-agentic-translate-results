{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport os\nimport random\n\nroot = os.getcwd()\nc_lib = ctypes.CDLL(os.path.join(root, \\\"c_ref_build/libdriver.so\\\"), mode=ctypes.RTLD_LOCAL)\nrust_lib = ctypes.CDLL(os.path.join(root, \\\"target/release/libdriver.so\\\"), mode=ctypes.RTLD_LOCAL)\nlibc = ctypes.CDLL(None)\nlibc.fflush.argtypes = [ctypes.c_void_p]\nlibc.fflush.restype = ctypes.c_int\n\nfor function in (c_lib.driver, rust_lib.driver):\n    function.argtypes = [ctypes.c_int, ctypes.c_int]\n    function.restype = None\n\ndef capture(function, x, y):\n    libc.fflush(None)\n    read_fd, write_fd = os.pipe()\n    saved_stdout = os.dup(1)\n    try:\n        os.dup2(write_fd, 1)\n        os.close(write_fd)\n        function(x, y)\n        libc.fflush(None)\n    finally:\n        os.dup2(saved_stdout, 1)\n        os.close(saved_stdout)\n    data = os.read(read_fd, 64)\n    os.close(read_fd)\n    return data\n\ndef expected(x, y):\n    unsigned = (x & 0xffffffff) | ((~y) & 0xffffffff)\n    signed = unsigned if unsigned < 0x80000000 else unsigned - 0x100000000\n    return f\\\"{signed}\\\\n\\\".encode(\\\"ascii\\\")\n\nvalues = [\n    -2147483648, -2147483647, -1073741824, -65536, -32768, -256,\n    -1, 0, 1, 255, 32767, 65535, 1073741823, 2147483646, 2147483647,\n]\npairs = [(x, y) for x in values for y in values]\nrandom.seed(0xD12E7)\npairs.extend((random.randint(-2147483648, 2147483647),\n              random.randint(-2147483648, 2147483647)) for _ in range(10000))\n\nfor index, (x, y) in enumerate(pairs):\n    c_output = capture(c_lib.driver, x, y)\n    rust_output = capture(rust_lib.driver, x, y)\n    wanted = expected(x, y)\n    if c_output \"'!= rust_output or c_output != wanted:\n        raise SystemExit(\n            f\"mismatch at {index}: ({x}, {y}) C={c_output!r} Rust={rust_output!r} expected={wanted!r}\"\n        )\n\nprint(f\"verified {len(pairs)} input pairs; all captured outputs are byte-identical\")\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
