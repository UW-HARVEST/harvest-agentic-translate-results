[14] = \"\";\n    47\t        if (fgets(inputBuffer, 14, stdin) != NULL)\n    48\t        {\n    49\t            /* Convert to int */\n    50\t            data = atoi(inputBuffer);\n    51\t        }\n    52\t        else\n    53\t        {\n    54\t            printLine(\"fgets() failed.\");\n    55\t        }\n    56\t    }\n    57\t    {\n    58\t        int i;\n    59\t        int buffer[10] = { 0 };\n    60\t        if (data >= 0)\n    61\t        {\n    62\t            buffer[data] = 1;\n    63\t            /* Print the array values */\n    64\t            for(i = 0; i < 10; i++)\n    65\t            {\n    66\t                printIntLine(buffer[i]);\n    67\t            }\n    68\t        }\n    69\t        else\n    70\t        {\n    71\t            printLine(\"ERROR: Array index is negative.\");\n    72\t        }\n    73\t    }\n    74\t}\n    75\t\n    76\t\n    77\t/* goodG2B uses the GoodSource with the BadSink */\n    78\tstatic void goodG2B()\n    79\t{\n    80\t    int data;\n    81\t    /* Initialize data */\n    82\t    data = -1;\n    83\t    data = 7;\n    84\t    {\n    85\t        int i;\n    86\t        int buffer[10] = { 0 };\n    87\t        if (data >= 0)\n    88\t        {\n    89\t            buffer[data] = 1;\n    90\t            /* Print the array values */\n    91\t            for(i = 0; i < 10; i++)\n    92\t            {\n    93\t                printIntLine(buffer[i]);\n    94\t            }\n    95\t        }\n    96\t        else\n    97\t        {\n    98\t            printLine(\"ERROR: Array index is negative.\");\n    99\t        }\n   100\t    }\n   101\t}\n   102\t\n   103\t/* goodB2G uses the BadSource with the GoodSink */\n   104\tstatic void goodB2G()\n   105\t{\n   106\t    int data;\n   107\t    /* Initialize data */\n   108\t    data = -1;\n   109\t    {\n   110\t        char inputBuffer[14] = \"\";\n   111\t        if (fgets(inputBuffer, 14, stdin) != NULL)\n   112\t        {\n   113\t            /* Convert to int */\n   114\t            data = atoi(inputBuffer);\n   115\t        }\n   116\t        else\n   117\t        {\n   118\t            printLine(\"fgets() failed.\");\n   119\t        }\n   120\t    }\n   121\t    {\n   122\t        int i;\n   123\t        int buffer[10] = { 0 };\n   124\t        if (data >= 0 && data < (10))\n   125\t        {\n   126\t            buffer[data] = 1;\n   127\t            /* Print the array values */\n   128\t            for(i = 0; i < 10; i++)\n   129\t            {\n   130\t                printIntLine(buffer[i]);\n   131\t            }\n   132\t        }\n   133\t        else\n   134\t        {\n   135\t            printLine(\"ERROR: Array index is out-of-bounds\");\n   136\t        }\n   137\t    }\n   138\t}\n   139\t\n   140\tvoid good()\n   141\t{\n   142\t    goodG2B();\n   143\t    goodB2G();\n   144\t}\n   145\t\n   146\tint main(int argc, char * argv[])\n   147\t{\n   148\t    printLine(\"Calling good()...\");\n   149\t    good();\n   150\t    printLine(\"Finished good()\");\n   151\t    printLine(\"Calling bad()...\");\n   152\t    bad();\n   153\t    printLine(\"Finished bad()\");\n   154\t    return 0;\n   155\t}\n","exit_code":0,"status":"completed"}}
