{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/main.rs'","aggregated_output":"     1\tuse std::ffi::{c_char, c_int};\n     2\tuse std::io::{self, Read, Write};\n     3\t\n     4\tunsafe extern \"C\" {\n     5\t    fn atoi(nptr: *const c_char) -> c_int;\n     6\t}\n     7\t\n     8\tfn print_line(output: &mut impl Write, line: &str) -> io::Result<()> {\n     9\t    writeln!(output, \"{line}\")\n    10\t}\n    11\t\n    12\tfn print_int_line(output: &mut impl Write, number: i32) -> io::Result<()> {\n    13\t    writeln!(output, \"{number}\")\n    14\t}\n    15\t\n    16\tfn fgets_14(input: &mut impl Read) -> Option<Vec<u8>> {\n    17\t    let mut buffer = Vec::with_capacity(13);\n    18\t\n    19\t    while buffer.len() < 13 {\n    20\t        let mut byte = [0_u8; 1];\n    21\t        match input.read(&mut byte) {\n    22\t            Ok(0) => break,\n    23\t            Ok(_) => {\n    24\t                buffer.push(byte[0]);\n    25\t                if byte[0] == b'\\n' {\n    26\t                    break;\n    27\t                }\n    28\t            }\n    29\t            Err(_) => return None,\n    30\t        }\n    31\t    }\n    32\t\n    33\t    (!buffer.is_empty()).then_some(buffer)\n    34\t}\n    35\t\n    36\tfn c_atoi(input: &[u8]) -> i32 {\n    37\t    let mut nul_terminated = Vec::with_capacity(input.len() + 1);\n    38\t    nul_terminated.extend_from_slice(input);\n    39\t    nul_terminated.push(0);\n    40\t\n    41\t    // The source calls the platform C library's atoi, including its overflow behavior.\n    42\t    unsafe { atoi(nul_terminated.as_ptr().cast::<c_char>()) as i32 }\n    43\t}\n    44\t\n    45\tfn print_buffer(output: &mut impl Write, buffer: &[i32; 10]) -> io::Result<()> {\n    46\t    for value in buffer {\n    47\t        print_int_line(output, *value)?;\n    48\t    }\n    49\t    Ok(())\n    50\t}\n    51\t\n    52\tfn bad(input: &mut impl Read, output: &mut impl Write) -> io::Result<()> {\n    53\t    let mut data = -1;\n    54\t    if let Some(input_buffer) = fgets_14(input) {\n    55\t        data = c_atoi(&input_buffer);\n    56\t    } else {\n    57\t        print_line(output, \"fgets() failed.\")?;\n    58\t    }\n    59\t\n    60\t    let mut buffer = [0_i32; 10];\n    61\t    if data >= 0 {\n    62\t        // C writes out of bounds here when data >= 10, which has no defined output.\n    63\t        // Keep the missing upper-bound validation without making safe Rust corrupt memory.\n    64\t        if let Some(element) = buffer.get_mut(data as usize) {\n    65\t            *element = 1;\n    66\t        }\n    67\t        print_buffer(output, &buffer)?;\n    68\t    } else {\n    69\t        print_line(output, \"ERROR: Array index is negative.\")?;\n    70\t    }\n    71\t    Ok(())\n    72\t}\n    73\t\n    74\tfn good_g2b(output: &mut impl Write) -> io::Result<()> {\n    75\t    let data = 7;\n    76\t    let mut buffer = [0_i32; 10];\n    77\t    if data >= 0 {\n    78\t        buffer[data as usize] = 1;\n    79\t        print_buffer(output, &buffer)?;\n    80\t    } else {\n    81\t        print_line(output, \"ERROR: Array index is negative.\")?;\n    82\t    }\n    83\t    Ok(())\n    84\t}\n    85\t\n    86\tfn good_b2g(input: &mut impl Read, output: &mut impl Write) -> io::Result<()> {\n    87\t    let mut data = -1;\n    88\t    if let Some(input_buffer) = fgets_14(input) {\n    89\t        data = c_atoi(&input_buffer);\n    90\t    } else {\n    91\t        print_line(output, \"fgets() failed.\")?;\n    92\t    }\n    93\t\n    94\t    let mut buffer = [0_i32; 10];\n    95\t    if data >= 0 && data < 10 {\n    96\t        buffer[data as usize] = 1;\n    97\t        print_buffer(output, &buffer)?;\n    98\t    } else {\n    99\t        print_line(output, \"ERROR: Array index is out-of-bounds\")?;\n   100\t    }\n   101\t    Ok(())\n   102\t}\n   103\t\n   104\tfn good(input: &mut impl Read, output: &mut imp