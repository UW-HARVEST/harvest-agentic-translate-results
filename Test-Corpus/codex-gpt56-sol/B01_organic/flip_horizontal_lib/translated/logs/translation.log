{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\n\nC_LIB = \\\"/tmp/harvest_translate_c_ref_20260824_1027/libtranslated_rust.so\\\"\nRUST_LIB = \\\"target/release/libtranslated_rust.so\\\"\n\nclass Pixel(ctypes.Structure):\n    _fields_ = [(\\\"r\\\", ctypes.c_uint8), (\\\"g\\\", ctypes.c_uint8),\n                (\\\"b\\\", ctypes.c_uint8), (\\\"a\\\", ctypes.c_uint8)]\n\nclass Image(ctypes.Structure):\n    _fields_ = [(\\\"w\\\", ctypes.c_int), (\\\"h\\\", ctypes.c_int),\n                (\\\"pix\\\", ctypes.POINTER(Pixel))]\n\nc_lib = ctypes.CDLL(C_LIB)\nrust_lib = ctypes.CDLL(RUST_LIB)\nfor lib in (c_lib, rust_lib):\n    lib.flip_horizontal.argtypes = [ctypes.POINTER(Image)]\n    lib.flip_horizontal.restype = None\n\nrng = random.Random(0xC0FFEE)\ncases = [(w, h) for h in range(21) for w in range(21)]\ncases += [(1, 127), (127, 1), (63, 64), (64, 63), (127, 65), (256, 32)]\ncases += [(-7, -9), (12, -3), (-4, 0), (-8, 1)]\n\nfor case_index, (w, h) in enumerate(cases):\n    logical_pixels = w * h if w > 0 and h > 0 else 0\n    payload_pixels = max(logical_pixels, 1)\n    total_pixels = payload_pixels + 2\n    initial = bytes(rng.randrange(256) for _ in range(total_pixels * 4))\n    outputs = []\n\n    for lib in (c_lib, rust_lib):\n        buf = (Pixel * total_pixels)()\n        ctypes.memmove(buf, initial, len(initial))\n        pix = ctypes.cast(ctypes.byref(buf, ctypes.sizeof(Pixel)), ctypes.POINTER(Pixel))\n        image = Image(w=w, h=h, pix=pix)\n        lib.flip_horizontal(ctypes.byref(image))\n        outputs.append(bytes(buf))\n\n    expected = bytearray(initial)\n    if w > 0 and h > 1:\n        row_bytes = w * 4\n        payload_start = 4\n        payload = initial[payload_start:payload_start + logical_pixels * 4]\n        reversed_rows = b\\\"\\\".join(\n            payload[row * row_bytes:(row + 1) * row_bytes]\n            for row in range(h - 1, -1, -1)