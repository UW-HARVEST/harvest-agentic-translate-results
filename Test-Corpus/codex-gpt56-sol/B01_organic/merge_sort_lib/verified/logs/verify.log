{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba c_src/include/lib.h; printf '%s\\\\n' '--- C source ---'; nl -ba c_src/src/lib.c\"","aggregated_output":"     1\ttypedef struct spritebatch_sprite_t {\n     2\t    unsigned long long texture_id;\n     3\t    int sort_bits;\n     4\t} spritebatch_sprite_t;\n     5\t\n     6\tvoid merge_sort(spritebatch_sprite_t *a, spritebatch_sprite_t *b, int size);\n--- C source ---\n     1\t#include <string.h>\r\n     2\t\r\n     3\t#include \"lib.h\"\r\n     4\t\r\n     5\tstatic int spritebatch_internal_sprite_less_than_or_equal(spritebatch_sprite_t *a,\r\n     6\t                                               spritebatch_sprite_t *b) {\r\n     7\t    if (a->sort_bits <= b->sort_bits)\r\n     8\t        return 1;\r\n     9\t    if (a->sort_bits == b->sort_bits && a->texture_id <= b->texture_id)\r\n    10\t        return 1;\r\n    11\t    return 0;\r\n    12\t}\r\n    13\t\r\n    14\tstatic void spritebatch_internal_merge_sort_iteration(spritebatch_sprite_t *a, int lo,\r\n    15\t                                               int split, int hi,\r\n    16\t                                               spritebatch_sprite_t *b) {\r\n    17\t    int i = lo, j = split;\r\n    18\t    for (int k = lo; k < hi; k++) {\r\n    19\t        if (i < split &&\r\n    20\t            (j >= hi ||\r\n    21\t             spritebatch_internal_sprite_less_than_or_equal(a + i, a + j))) {\r\n    22\t            b[k] = a[i];\r\n    23\t            i = i + 1;\r\n    24\t        } else {\r\n    25\t            b[k] = a[j];\r\n    26\t            j = j + 1;\r\n    27\t        }\r\n    28\t    }\r\n    29\t}\r\n    30\t\r\n    31\tstatic void spritebatch_internal_merge_sort_recurse(spritebatch_sprite_t *b, int lo,\r\n    32\t                                             int hi, spritebatch_sprite_t *a) {\r\n    33\t    if (hi - lo <= 1)\r\n    34\t        return;\r\n    35\t    int split = (lo + hi) / 2;\r\n    36\t    spritebatch_internal_merge_sort_recurse(a, lo, split, b);\r\n    37\t    spritebatch_internal_merge_sort_recurse(a, split, hi, b);\r\n    38\t    spritebatch_internal_merge_sort_iteration(b, lo, split, hi, a);\r\n    39\t}\r\n    40\t\r\n    41\tvoid merge_sort(spritebatch_sprite_t *a,\r\n    42\t                                     spritebatch_sprite_t *b, int size) {\r\n    43\t    memcpy(b, a, sizeof(spritebatch_sprite_t) * size);\r\n    44\t    spritebatch_internal_merge_sort_recurse(b, 0, size, a);\r\n    45\t}\r\n","exit_code":0,"status":"completed"}}
