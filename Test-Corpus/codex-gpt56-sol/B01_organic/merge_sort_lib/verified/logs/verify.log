{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/lib.rs; printf '%s\\\\n' '--- manifest exact ---'; nl -ba Cargo.toml\"","aggregated_output":"     1\tuse std::ffi::{c_int, c_ulonglong};\n     2\tuse std::ptr;\n     3\t\n     4\t#[repr(C)]\n     5\t#[derive(Clone, Copy)]\n     6\tpub struct SpritebatchSprite {\n     7\t    pub texture_id: c_ulonglong,\n     8\t    pub sort_bits: c_int,\n     9\t}\n    10\t\n    11\tunsafe fn less_than_or_equal(a: *const SpritebatchSprite, b: *const SpritebatchSprite) -> bool {\n    12\t    unsafe { (*a).sort_bits <= (*b).sort_bits }\n    13\t}\n    14\t\n    15\tunsafe fn merge_sort_iteration(\n    16\t    a: *mut SpritebatchSprite,\n    17\t    lo: c_int,\n    18\t    split: c_int,\n    19\t    hi: c_int,\n    20\t    b: *mut SpritebatchSprite,\n    21\t) {\n    22\t    let mut i = lo;\n    23\t    let mut j = split;\n    24\t    let mut k = lo;\n    25\t\n    26\t    while k < hi {\n    27\t        let take_left = i < split\n    28\t            && (j >= hi\n    29\t                || unsafe {\n    30\t                    less_than_or_equal(a.wrapping_offset(i as isize), a.wrapping_offset(j as isize))\n    31\t                });\n    32\t\n    33\t        if take_left {\n    34\t            unsafe {\n    35\t                ptr::copy_nonoverlapping(\n    36\t                    a.wrapping_offset(i as isize),\n    37\t                    b.wrapping_offset(k as isize),\n    38\t                    1,\n    39\t                );\n    40\t            }\n    41\t            i = i.wrapping_add(1);\n    42\t        } else {\n    43\t            unsafe {\n    44\t                ptr::copy_nonoverlapping(\n    45\t                    a.wrapping_offset(j as isize),\n    46\t                    b.wrapping_offset(k as isize),\n    47\t                    1,\n    48\t                );\n    49\t            }\n    50\t            j = j.wrapping_add(1);\n    51\t        }\n    52\t        k = k.wrapping_add(1);\n    53\t    }\n    54\t}\n    55\t\n    56\tunsafe fn merge_sort_recurse(\n    57\t    b: *mut SpritebatchSprite,\n    58\t    lo: c_int,\n    59\t    hi: c_int,\n    60\t    a: *mut SpritebatchSprite,\n    61\t) {\n    62\t    if hi.wrapping_sub(lo) <= 1 {\n    63\t        return;\n    64\t    }\n    65\t\n    66\t    let split = lo.wrapping_add(hi) / 2;\n    67\t    unsafe {\n    68\t        merge_sort_recurse(a, lo, split, b);\n    69\t        merge_sort_recurse(a, split, hi, b);\n    70\t        merge_sort_iteration(b, lo, split, hi, a);\n    71\t    }\n    72\t}\n    73\t\n    74\t#[unsafe(no_mangle)]\n    75\tpub unsafe extern \"C\" fn merge_sort(\n    76\t    a: *mut SpritebatchSprite,\n    77\t    b: *mut SpritebatchSprite,\n    78\t    size: c_int,\n    79\t) {\n    80\t    let byte_count = size_of::<SpritebatchSprite>().wrapping_mul(size as usize);\n    81\t    unsafe {\n    82\t        ptr::copy_nonoverlapping(a.cast::<u8>(), b.cast::<u8>(), byte_count);\n    83\t        merge_sort_recurse(b, 0, size, a);\n    84\t    }\n    85\t}\n--- manifest exact ---\n     1\t[package]\n     2\tname = \"translated_rust\"\n     3\tversion = \"0.1.0\"\n     4\tedition = \"2024\"\n     5\t\n     6\t[lib]\n     7\tcrate-type = [\"cdylib\"]\n     8\tname = \"merge_sort_lib\"\n     9\t\n    10\t[profile.release]\n    11\tpanic = \"abort\"\n    12\t\n    13\t[workspace]\n    14\t\n","exit_code":0,"status":"completed"}}
