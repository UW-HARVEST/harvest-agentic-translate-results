n    48\t                ^ CRC16_TABLES[6][(crc & 0xff) as usize]\n    49\t                ^ CRC16_TABLES[5][*data.add(2) as usize]\n    50\t                ^ CRC16_TABLES[4][*data.add(3) as usize]\n    51\t                ^ CRC16_TABLES[3][*data.add(4) as usize]\n    52\t                ^ CRC16_TABLES[2][*data.add(5) as usize]\n    53\t                ^ CRC16_TABLES[1][*data.add(6) as usize]\n    54\t                ^ CRC16_TABLES[0][*data.add(7) as usize];\n    55\t            data = data.add(8);\n    56\t        }\n    57\t        len -= 8;\n    58\t    }\n    59\t\n    60\t    while len != 0 {\n    61\t        // SAFETY: The function's C contract requires `len` readable bytes.\n    62\t        unsafe {\n    63\t            crc = (crc << 8) ^ CRC16_TABLES[0][((crc >> 8) as u8 ^ *data) as usize];\n    64\t            data = data.add(1);\n    65\t        }\n    66\t        len -= 1;\n    67\t    }\n    68\t\n    69\t    crc\n    70\t}\n    71\t\n    72\t#[cfg(test)]\n    73\tmod tests {\n    74\t    use super::crc16;\n    75\t\n    76\t    #[test]\n    77\t    fn known_flac_crc16() {\n    78\t        let data = b\"123456789\";\n    79\t        // SAFETY: `data` contains the stated number of readable bytes.\n    80\t        let crc = unsafe { crc16(data.as_ptr(), data.len() as u32, 0) };\n    81\t        assert_eq!(crc, 0xfee8);\n    82\t    }\n    83\t\n    84\t    #[test]\n    85\t    fn empty_input_preserves_initial_crc() {\n    86\t        // SAFETY: A null pointer is not dereferenced when the length is zero.\n    87\t        let crc = unsafe { crc16(std::ptr::null(), 0, 0xa5c3) };\n    88\t        assert_eq!(crc, 0xa5c3);\n    89\t    }\n    90\t}\n   90 src/lib.rs\n   20 c_src/src/lib.c\n  282 c_src/include/lib.h\n   11 Cargo.toml\n   15 c_src/CMakeLists.txt\n  418 total\n","exit_code":0,"status":"completed"}}
