{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'nl -ba c_src/include/lib.h; nl -ba c_src/src/lib.c'","aggregated_output":"     1\t#include <stdint.h>\n     2\t\n     3\ttypedef int16_t mp3d_sample_t;\n     4\t\n     5\tvoid synth_pair(mp3d_sample_t *pcm, int nch, const float *z);\n     1\t#include \"lib.h\"\n     2\t\n     3\tstatic int16_t mp3d_scale_pcm(float sample) {\n     4\t    if (sample >= 32766.5)\n     5\t        return (int16_t)32767;\n     6\t    if (sample <= -32767.5)\n     7\t        return (int16_t)-32768;\n     8\t    int16_t s = (int16_t)(sample + .5f);\n     9\t    s -= (s < 0);\n    10\t    return s;\n    11\t}\n    12\t\n    13\tvoid synth_pair(mp3d_sample_t *pcm, int nch, const float *z) {\n    14\t    float a;\n    15\t    a = (z[14 * 64] - z[0]) * 29;\n    16\t    a += (z[1 * 64] + z[13 * 64]) * 213;\n    17\t    a += (z[12 * 64] - z[2 * 64]) * 459;\n    18\t    a += (z[3 * 64] + z[11 * 64]) * 2037;\n    19\t    a += (z[10 * 64] - z[4 * 64]) * 5153;\n    20\t    a += (z[5 * 64] + z[9 * 64]) * 6574;\n    21\t    a += (z[8 * 64] - z[6 * 64]) * 37489;\n    22\t    a += z[7 * 64] * 75038;\n    23\t    pcm[0] = mp3d_scale_pcm(a);\n    24\t    z += 2;\n    25\t    a = z[14 * 64] * 104;\n    26\t    a += z[12 * 64] * 1567;\n    27\t    a += z[10 * 64] * 9727;\n    28\t    a += z[8 * 64] * 64019;\n    29\t    a += z[6 * 64] * -9975;\n    30\t    a += z[4 * 64] * -45;\n    31\t    a += z[2 * 64] * 146;\n    32\t    a += z[0 * 64] * -5;\n    33\t    pcm[16 * nch] = mp3d_scale_pcm(a);\n    34\t}\n","exit_code":0,"status":"completed"}}
