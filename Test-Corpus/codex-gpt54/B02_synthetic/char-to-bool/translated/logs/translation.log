b.c:146:        return 30 + permission_value;  /* 35 */\nc_src/src/lib.c:147:    } else if (write && execute) {\nc_src/src/lib.c:148:        /* Write/execute but no read - unusual case */\nc_src/src/lib.c:149:        return 20 + permission_value;  /* 23 */\nc_src/src/lib.c:150:    } else if (read) {\nc_src/src/lib.c:151:        /* Read only */\nc_src/src/lib.c:152:        return 10 + permission_value;  /* 14 */\nc_src/src/lib.c:153:    } else if (write) {\nc_src/src/lib.c:154:        /* Write only - dangerous */\nc_src/src/lib.c:155:        return -10;\nc_src/src/lib.c:156:    } else if (execute) {\nc_src/src/lib.c:157:        /* Execute only - very unusual */\nc_src/src/lib.c:158:        return -20;\nc_src/src/lib.c:159:    }\nc_src/src/lib.c:160:    \nc_src/src/lib.c:161:    /* No permissions */\nc_src/src/lib.c:162:    return 0;\nc_src/src/lib.c:163:}\nc_src/src/lib.c:164:\nc_src/src/lib.c:165:/**\nc_src/src/lib.c:166: * Evaluate three conditions with different logic operators\nc_src/src/lib.c:167: */\nc_src/src/lib.c:168:static int evaluate_conditions(bool cond1, bool cond2, bool cond3, int logic_op) {\nc_src/src/lib.c:169:    bool result;\nc_src/src/lib.c:170:    \nc_src/src/lib.c:171:    switch (logic_op) {\nc_src/src/lib.c:172:        case 0: {\nc_src/src/lib.c:173:            /* AND - all must be true */\nc_src/src/lib.c:174:            result = cond1 && cond2 && cond3;\nc_src/src/lib.c:175:            \nc_src/src/lib.c:176:            if (result) {\nc_src/src/lib.c:177:                return 100;\nc_src/src/lib.c:178:            } else {\nc_src/src/lib.c:179:                /* Partial matches */\nc_src/src/lib.c:180:                if (cond1 && cond2) return 50;\nc_src/src/lib.c:181:                if (cond1 && cond3) return 51;\nc_src/src/lib.c:182:                if (cond2 && cond3) return 52;\nc_src/src/lib.c:183:                if (cond1) return 10;\nc_src/src/lib.c:184:                if (cond2) return 11;\nc_src/src/lib.c:185:                if (cond3