{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes, os, tempfile, subprocess, textwrap, json, sys\nbase = '/tmp/harvest-translate-ryfoqh/translated_rust'\nlibs = {\n    'c': '/tmp/harvest-translate-ryfoqh/c_build/libdriver_c.so',\n    'rust': f'{base}/target/release/libdriver.so',\n}\ncases = [\n    ('empty', b'', None),\n    ('basic', b'alpha\\\\nbeta\\\\n', None),\n    ('long', b'x'*300 + b'\\\\nshort', '2'),\n]\nscript = r'''\nimport ctypes, os, sys\nlib = ctypes.CDLL(sys.argv[1])\nlib.driver.argtypes = [ctypes.c_char_p]\nlib.driver.restype = ctypes.c_int\nif sys.argv[3] == 'unset':\n    os.environ.pop('MAX_TASKS', None)\nelse:\n    os.environ['MAX_TASKS'] = sys.argv[3]\nos.environ['LOG_FILE'] = sys.argv[2]\nres = lib.driver(sys.argv[4].encode('latin1'))\nprint(f'RESULT={res}', file=sys.stderr)\n'''\nall_ok = True\nfor name, payload, max_tasks in cases:\n    results = {}\n    for kind, lib in libs.items():\n        tmp = tempfile.mkdtemp(prefix=f'cmp_{name}_{kind}_')\n        log = os.path.join(tmp, 'out.log')\n        proc = subprocess.run(\n            ['python3', '-c', script, lib, log, max_tasks if max_tasks is not None else 'unset', payload.decode('latin1')],\n            capture_output=True,\n            env=os.environ.copy(),\n        )\n        log_bytes = open(log, 'rb').read() if os.path.exists(log) else b''\n        results[kind] = (proc.returncode, proc.stdout, proc.stderr, log_bytes)\n    same = results['c'] == results['rust']\n    print(name, 'MATCH' if same else 'DIFF')\n    if not same:\n        all_ok = False\n        for kind in ('c', 'rust'):\n            rc, out, err, log_bytes = results[kind]\n            print(kind, json.dumps({\n                'rc': rc,\n                'stdout': out.decode('latin1'),\n                'stderr': err.decode('latin1'),\n                'log': log_bytes.decode('latin1'),\n            }, indent=2))\nif not all_ok:\n    sys.exit(1)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
