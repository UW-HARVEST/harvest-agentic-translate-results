)malloc(length + 1);\n        if (!task) {\n            fprintf(stderr, \"Error: Failed to allocate memory for task.\\n\");\n            destroy_task_manager(manager);\n            finalize_logger();\n            return EXIT_FAILURE;\n        }\n        strncpy(task, start, length);\n        task[length] = '\\0';\n\n        add_task(manager, task, priority++);\n        free(task);\n        start = (*end == '\\n') ? end + 1 : end;\n    }    \n\n    print_tasks(manager);\n\n    destroy_task_manager(manager);\n    finalize_logger();\n\n    return 0;\n}\n","exit_code":0,"status":"completed"}}
