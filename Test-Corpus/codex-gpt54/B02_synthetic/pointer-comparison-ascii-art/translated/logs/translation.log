{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -c \"sed -n '1,220p' src/input.rs\"","aggregated_output":"use std::io::{self, Read};\n\npub trait ByteReader {\n    fn getchar(&mut self) -> Option<u8>;\n    fn peek(&mut self) -> Option<u8>;\n\n    fn fgets(&mut self, size: usize) -> Option<String> {\n        if size == 0 {\n            return None;\n        }\n\n        let mut buf = Vec::new();\n        let limit = size.saturating_sub(1);\n        while buf.len() < limit {\n            match self.getchar() {\n                Some(byte) => {\n                    buf.push(byte);\n                    if byte == b'\\n' {\n                        break;\n                    }\n                }\n                None => break,\n            }\n        }\n\n        if buf.is_empty() {\n            None\n        } else {\n            Some(String::from_utf8_lossy(&buf).into_owned())\n        }\n    }\n\n    fn scanf_d(&mut self) -> Option<i32> {\n        loop {\n            match self.peek() {\n                Some(byte) if byte.is_ascii_whitespace() => {\n                    self.getchar();\n                }\n                _ => break,\n            }\n        }\n\n        let mut buf = Vec::new();\n\n        if matches!(self.peek(), Some(b'+') | Some(b'-')) {\n            buf.push(self.getchar().unwrap());\n        }\n\n        while matches!(self.peek(), Some(byte) if byte.is_ascii_digit()) {\n            buf.push(self.getchar().unwrap());\n        }\n\n        let digits = match buf.as_slice() {\n            [b'+'] | [b'-'] | [] => return None,\n            [b'+', rest @ ..] | [b'-', rest @ ..] if rest.is_empty() => return None,\n            _ => &buf[..],\n        };\n\n        let text = String::from_utf8_lossy(digits);\n        text.parse::<i32>().ok()\n    }\n\n    fn flush_until_newline(&mut self) {\n        loop {\n            if self.getchar() == Some(b'\\n') {\n                break;\n            }\n        }\n    }\n}\n\npub struct StreamReader<R: Read> {\n    inner: R,\n    peeked: Option<Option<u8>>,\n}\n\nimpl<R: Read> StreamReader<R> {\n    pub fn new(inner: R) -> Self {\n        Self { inner, peeked: None }\n    }\n\n    fn read_byte(&mut self) -> Option<u8> {\n        let mut buf = [0_u8; 1];\n        match self.inner.read(&mut buf) {\n            Ok(0) | Err(_) => None,\n            Ok(_) => Some(buf[0]),\n        }\n    }\n}\n\nimpl<R: Read> ByteReader for StreamReader<R> {\n    fn getchar(&mut self) -> Option<u8> {\n        match self.peeked.take() {\n            Some(byte) => byte,\n            None => self.read_byte(),\n        }\n    }\n\n    fn peek(&mut self) -> Option<u8> {\n        match self.peeked {\n            Some(byte) => byte,\n            None => {\n                let byte = self.read_byte();\n                self.peeked = Some(byte);\n                byte\n            }\n        }\n    }\n}\n\npub fn stdin_reader() -> StreamReader<io::StdinLock<'static>> {\n    let stdin = Box::leak(Box::new(io::stdin()));\n    StreamReader::new(stdin.lock())\n}\n","exit_code":0,"status":"completed"}}
