{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes, zlib, struct, os\nfrom ctypes import *\n\nroot='/tmp/harvest-translate-Kzt41e/translated_rust'\nrust = ctypes.CDLL(os.path.join(root, 'target/release/libtranslated_rust.so'))\nc = ctypes.CDLL('/tmp/harvest-translate-Kzt41e/libc_ref.so')\nlibc = ctypes.CDLL(None)\n\nclass Pixel(Structure):\n    _fields_ = [('r', c_ubyte), ('g', c_ubyte), ('b', c_ubyte), ('a', c_ubyte)]\nclass Image(Structure):\n    _fields_ = [('w', c_int), ('h', c_int), ('pix', POINTER(Pixel))]\n\nfor lib in (rust, c):\n    lib.cp_inflate.argtypes = [c_void_p, c_int, c_void_p, c_int]\n    lib.cp_inflate.restype = c_int\n    lib.load_png_mem.argtypes = [POINTER(c_ubyte), c_int]\n    lib.load_png_mem.restype = Image\n\nlibc.free.argtypes = [c_void_p]\n\ndef err(lib):\n    return c_char_p.in_dll(lib, 'cp_error_reason').value\n\ndef png_chunk(name, data):\n    return struct.pack('>I', len(data)) + name + data + struct.pack('>I', 0)\n\ndef make_png(w, h, color_type, rows, plte=None, trns=None):\n    bit_depth = 8\n    ihdr = struct.pack('>IIBBBBB', w, h, bit_depth, color_type, 0, 0, 0)\n    raw = b''.join(bytes([0]) + row for row in rows)\n    z = zlib.compress(raw)\n    parts = [b'\\\\x89PNG\\\\r\\\\n\\\\x1a\\\\n', png_chunk(b'IHDR', ihdr)]\n    if plte is not None:\n        parts.append(png_chunk(b'PLTE', plte))\n    if trns is not None:\n        parts.append(png_chunk(b'tRNS', trns))\n    parts.append(png_chunk(b'IDAT', z))\n    parts.append(png_chunk(b'IEND', b''))\n    return b''.join(parts)\n\ncases = []\n# grayscale 2x1\ncases.append(('gray', make_png(2,1,0,[bytes([10, 200]) ])))\n# rgb 2x1\ncases.append(('rgb', make_png(2,1,2,[bytes([1,2,3, 250,251,252]) ])))\n# indexed 2x1\ncases.append(('indexed', make_png(2,1,3,[bytes([0,1])], plte=bytes([255,0,0, 0,255,0]), trns=bytes([128,255]))))\n# gray+alpha 2x1\ncases.append(('graya', make_png(2,1,4,[bytes([50,60, 70,80]) ])))\n# rgba 2x1\ncases.append(('rgba', make_png(2,1,6,[bytes([1,2,3,4, 5,6,7,8]) ])))\n# invalid signature\ncases.append(('bad_sig', b'notapng'))\n# indexed without plte\ncases.append(('bad_indexed', make_png(1,1,3,[bytes([0]) ])))\n\nfor name, data in cases:\n    buf = (c_ubyte * len(data)).from_buffer_copy(data)\n    ri = rust.load_png_mem(buf, len(data))\n    ci = c.load_png_mem(buf, len(data))\n    rpix = bytes(string_at(ri.pix, ri.w * ri.h * sizeof(Pixel))) if ri.pix else b''\n    cpix = bytes(string_at(ci.pix, ci.w * ci.h * sizeof(Pixel))) if ci.pix else b''\n    re = err(rust)\n    ce = err(c)\n    if (ri.w, ri.h, rpix, re) \"'!= (ci.w, ci.h, cpix, ce):\n        print('\"'MISMATCH', name)\n        print(' rust', ri.w, ri.h, re, rpix)\n        print(' c   ', ci.w, ci.h, ce, cpix)\n        raise SystemExit(1)\n    if ri.pix: libc.free(ri.pix)\n    if ci.pix: libc.free(ci.pix)\n\n# cp_inflate: compare a few raw deflate payloads inside zlib wrapper, as load_png_mem does\nfor payload in [b'', b'hello hello hello', bytes(range(64)), b'a'*300]:\n    z = zlib.compress(payload)\n    raw = z[2:-4]\n    inbuf = (c_ubyte * len(raw)).from_buffer_copy(raw)\n    out_r = create_string_buffer(max(1, len(payload)))\n    out_c = create_string_buffer(max(1, len(payload)))\n    rr = rust.cp_inflate(cast(inbuf, c_void_p), len(raw), cast(out_r, c_void_p), len(payload))\n    rc = c.cp_inflate(cast(inbuf, c_void_p), len(raw), cast(out_c, c_void_p), len(payload))\n    re = err(rust)\n    ce = err(c)\n    if (rr, out_r.raw[:len(payload)], re) \"'!= (rc, out_c.raw[:len(payload)], ce):\n        print('\"'INFLATE MISMATCH', payload)\n        print(' rust', rr, re, out_r.raw[:len(payload)])\n        print(' c   ', rc, ce, out_c.raw[:len(payload)])\n        raise SystemExit(1)\n\nprint('ok')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
