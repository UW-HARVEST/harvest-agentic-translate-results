4\t    }\n   525\t\n   526\t    let mut a = C2v::default();\n   527\t    let mut b = C2v::default();\n   528\t    c2_witness(&s, &mut a, &mut b);\n   529\t    let mut dist = c2_len(c2_sub(a, b));\n   530\t    if hit != 0 {\n   531\t        a = b;\n   532\t        dist = 0.0;\n   533\t    } else if use_radius != 0 {\n   534\t        let r_a = p_a.radius;\n   535\t        let r_b = p_b.radius;\n   536\t        if dist > r_a + r_b && dist > f32::EPSILON {\n   537\t            dist -= r_a + r_b;\n   538\t            let n = c2_norm(c2_sub(b, a));\n   539\t            a = c2_add(a, c2_mulvs(n, r_a));\n   540\t            b = c2_sub(b, c2_mulvs(n, r_b));\n   541\t            if a.x == b.x && a.y == b.y {\n   542\t                dist = 0.0;\n   543\t            }\n   544\t        } else {\n   545\t            let p = c2_mulvs(c2_add(a, b), 0.5);\n   546\t            a = p;\n   547\t            b = p;\n   548\t            dist = 0.0;\n   549\t        }\n   550\t    }\n   551\t    if let Some(cache_ref) = cache.as_mut() {\n   552\t        cache_ref.metric = c2_gjk_simplex_metric(&s);\n   553\t        cache_ref.count = s.count;\n   554\t        let mut i = 0;\n   555\t        while i < s.count {\n   556\t            let v = s.verts[i as usize];\n   557\t            cache_ref.i_a[i as usize] = v.i_a;\n   558\t            cache_ref.i_b[i as usize] = v.i_b;\n   559\t            i += 1;\n   560\t        }\n   561\t        cache_ref.div = s.div;\n   562\t    }\n   563\t    if let Some(out) = out_a {\n   564\t        *out = a;\n   565\t    }\n   566\t    if let Some(out) = out_b {\n   567\t        *out = b;\n   568\t    }\n   569\t    if let Some(out) = iterations {\n   570\t        *out = iter;\n   571\t    }\n   572\t    dist\n   573\t}\n   574\t\n   575\tenum ShapeRef<'a> {\n   576\t    Circle(&'a C2Circle),\n   577\t    Aabb(&'a C2Aabb),\n   578\t    Capsule(&'a C2Capsule),\n   579\t}\n   580\t\n   581\tfn c2_aabb_to_aabb(a: C2Aabb, b: C2Aabb) -> c_int {\n   582\t    let d0 = 