{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"nl -ba Cargo.toml && printf '\\\\n' && nl -ba src/lib.rs | sed -n '1,260p' && printf '\\\\n' && nl -ba src/lib.rs | sed -n '261,520p' && printf '\\\\n' && nl -ba src/lib.rs | sed -n '521,820p'\"","aggregated_output":"     1\t[package]\n     2\tname = \"translated_rust\"\n     3\tversion = \"0.1.0\"\n     4\tedition = \"2021\"\n     5\t\n     6\t[lib]\n     7\tcrate-type = [\"cdylib\"]\n     8\t\n     9\t[profile.release]\n    10\tpanic = \"abort\"\n\n     1\tuse std::ffi::c_int;\n     2\t\n     3\t#[derive(Copy, Clone, Eq, PartialEq)]\n     4\t#[repr(i32)]\n     5\tenum C2Type {\n     6\t    Circle,\n     7\t    Aabb,\n     8\t    Capsule,\n     9\t}\n    10\t\n    11\t#[derive(Copy, Clone, Default)]\n    12\t#[repr(C)]\n    13\tstruct C2v {\n    14\t    x: f32,\n    15\t    y: f32,\n    16\t}\n    17\t\n    18\t#[derive(Copy, Clone, Default)]\n    19\t#[repr(C)]\n    20\tstruct C2r {\n    21\t    c: f32,\n    22\t    s: f32,\n    23\t}\n    24\t\n    25\t#[derive(Copy, Clone, Default)]\n    26\t#[repr(C)]\n    27\tstruct C2x {\n    28\t    p: C2v,\n    29\t    r: C2r,\n    30\t}\n    31\t\n    32\t#[derive(Copy, Clone, Default)]\n    33\t#[repr(C)]\n    34\tstruct C2Circle {\n    35\t    p: C2v,\n    36\t    r: f32,\n    37\t}\n    38\t\n    39\t#[derive(Copy, Clone, Default)]\n    40\t#[repr(C)]\n    41\tstruct C2Aabb {\n    42\t    min: C2v,\n    43\t    max: C2v,\n    44\t}\n    45\t\n    46\t#[derive(Copy, Clone, Default)]\n    47\t#[repr(C)]\n    48\tstruct C2Capsule {\n    49\t    a: C2v,\n    50\t    b: C2v,\n    51\t    r: f32,\n    52\t}\n    53\t\n    54\t#[derive(Copy, Clone, Default)]\n    55\t#[repr(C)]\n    56\tstruct C2GjkCache {\n    57\t    metric: f32,\n    58\t    count: c_int,\n    59\t    i_a: [c_int; 3],\n    60\t    i_b: [c_int; 3],\n    61\t    div: f32,\n    62\t}\n    63\t\n    64\t#[derive(Copy, Clone)]\n    65\tstruct C2Proxy {\n    66\t    radius: f32,\n    67\t    count: c_int,\n    68\t    verts: [C2v; 8],\n    69\t}\n    70\t\n    71\timpl Default for C2Proxy {\n    72\t    fn default() -> Self {\n    73\t        Self {\n    74\t            radius: 0.0,\n    75\t            count: 0,\n    76\t            verts: [C2v::default(); 8],\n    77\t        }\n    78\t    }\n    79\t}\n    80\t\n    81\t#[derive(Copy, Clone, Default)]\n    82\tstruct C2sv {\n    83\t    s_a: C2v,\n    84\t    s_b: C2v,\n    85\t    p: C2v,\n    86\t    u: f32,\n    87\t    i_a: c_int,\n    88\t    i_b: c_int,\n    89\t}\n    90\t\n    91\t#[derive(Copy, Clone)]\n    92\tstruct C2Simplex {\n    93\t    verts: [C2sv; 4],\n    94\t    div: f32,\n    95\t    count: c_int,\n    96\t}\n    97\t\n    98\timpl Default for C2Simplex {\n    99\t    fn default() -> Self {\n   100\t        Self {\n   101\t            verts: [C2sv::default(); 4],\n   102\t            div: 0.0,\n   103\t            count: 0,\n   104\t        }\n   105\t    }\n   106\t}\n   107\t\n   108\tfn c2_v(x: f32, y: f32) -> C2v {\n   109\t    C2v { x, y }\n   110\t}\n   111\t\n   112\tfn c2_mulvs(mut a: C2v, b: f32) -> C2v {\n   113\t    a.x *= b;\n   114\t    a.y *= b;\n   115\t    a\n   116\t}\n   117\t\n   118\tfn c2_maxv(a: C2v, b: C2v) -> C2v {\n   119\t    c2_v(if a.x > b.x { a.x } else { b.x }, if a.y > b.y { a.y } else { b.y })\n   120\t}\n   121\t\n   122\tfn c2_minv(a: C2v, b: C2v) -> C2v {\n   123\t    c2_v(if a.x < b.x { a.x } else { b.x }, if a.y < b.y { a.y } else { b.y })\n   124\t}\n   125\t\n   126\tfn c2_clampv(a: C2v, lo: C2v, hi: C2v) -> C2v {\n   127\t    c2_maxv(lo, c2_minv(a, hi))\n   128\t}\n   129\t\n   130\tfn c2_sub(mut a: C2v, b: C2v) -> C2v {\n   131\t    a.x -= b.x;\n   132\t    a.y -= b.y;\n   133\t    a\n   134\t}\n   135\t\n   136\tfn c2_dot(a: C2v, b: C2v) -> f32 {\n   137\t    a.x * b.x + a.y * b.y\n   138\t}\n   139\t\n   140\tfn c2_rot_identity() -> C2r {\n   141\t    C2r { c: 1.0, s: 0.0 }\n   142\t}\n   143\t\n   144\tfn c2x_identity() -> C2x {\n   145\t    C2x {\n   146\t        p: c2_v(0.0, 0.0),\n   147\t        r: c2_rot_identity(),\n   148\t    }\n   149\t}\n   150\t\n   151\tfn c2_bb_verts(out: &mut [C2v; 8], bb: &C2Aabb) {\n   152\t    out[0] = bb.min;\n   153\t    out[1] = c2_v(bb.max.x, bb.min.y);\n   154\t    out[2] = bb.max;\n   155\t    out[3] = c2_v(bb.min.x, bb.max.y);\n   156\t}\n   157\t\n   158\tfn c2_make_proxy_aabb(shape: &C2Aabb, p: &mut C2Proxy) {\n   159\t    p.radius = 0.0;\n   160\t    p.count = 4;\n   161\t    c2_bb_verts(&mut p.verts, shape);\n   162\t}\n   163\t\n   164\tfn c2_make_proxy_circle(shape: &C2Circle, p: &mut C2Proxy) {\n   165\t    p.radius = shape.r;\n   166\t    p.count = 1;\n   167\t    p.verts[0] = shape.p;\n   168\t}\n   169\t\n   170\tfn c2_make_proxy_capsule(shape: &C2Capsule, p: &mut C2Proxy) {\n   171\t    p.radius = shape.r;\n   172\t    p.count = 2;\n   173\t    p.verts[0] = shape.a;\n   174\t    p.verts[1] = shape.b;\n   175\t}\n   176\t\n   177\tfn c2_len(a: C2v) -> f32 {\n   178\t    c2_dot(a, a).sqrt()\n   179\t}\n   180\t\n   181\tfn c2_det2(a: C2v, b: C2v) -> f32 {\n   182\t    a.x * b.y - a.y * b.x\n   183\t}\n   184\t\n   185\tfn c2_gjk_simplex_metric(s: &C2Simplex) -> f32 {\n   186\t    match s.count {\n   187\t        1 => 0.0,\n   188\t        2 => c2_len(c2_sub(s.verts[1].p, s.verts[0].p)),\n   189\t        3 => c2_det2(c2_sub(s.verts[1].p, s.verts[0].p), c2_sub(s.verts[2].p, s.verts[0].p)),\n   190\t        _ => 0.0,\n   191\t    }\n   192\t}\n   193\t\n   194\tfn c2_mulrv(a: C2r, b: C2v) -> C2v {\n   195\t    c2_v(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n   196\t}\n   197\t\n   198\tfn c2_add(mut a: C2v, b: C2v) -> C2v {\n   199\t    a.x += b.x;\n   200\t    a.y += b.y;\n   201\t    a\n   202\t}\n   203\t\n   204\tfn c2_mulxv(a: C2x, b: C2v) -> C2v {\n   205\t    c2_add(c2_mulrv(a.r, b), a.p)\n   206\t}\n   207\t\n   208\tfn c22(s: &mut C2Simplex) {\n   209\t    let a = s.verts[0].p;\n   210\t    let b = s.verts[1].p;\n   211\t    let u = c2_dot(b, c2_sub(b, a));\n   212\t    let v = c2_dot(a, c2_sub(a, b));\n   213\t    if v <= 0.0 {\n   214\t        s.verts[0].u = 1.0;\n   215\t        s.div = 1.0;\n   216\t        s.count = 1;\n   217\t    } else if u <= 0.0 {\n   218\t        s.verts[0] = s.verts[1];\n   219\t        s.verts[0].u = 1.0;\n   220\t        s.div = 1.0;\n   221\t        s.count = 1;\n   222\t    } else {\n   223\t        s.verts[0].u = u;\n   224\t        s.verts[1].u = v;\n   225\t        s.div = u + v;\n   226\t        s.count = 2;\n   227\t    }\n   228\t}\n   229\t\n   230\tfn c23(s: &mut C2Simplex) {\n   231\t    let a = s.verts[0].p;\n   232\t    let b = s.verts[1].p;\n   233\t    let c = s.verts[2].p;\n   234\t    let u_ab = c2_dot(b, c2_sub(b, a));\n   235\t    let v_ab = c2_dot(a, c2_sub(a, b));\n   236\t    let u_bc = c2_dot(c, c2_sub(c, b));\n   237\t    let v_bc = c2_dot(b, c2_sub(b, c));\n   238\t    let u_ca = c2_dot(a, c2_sub(a, c));\n   239\t    let v_ca = c2_dot(c, c2_sub(c, a));\n   240\t    let area = c2_det2(c2_sub(b, a), c2_sub(c, a));\n   241\t    let u_abc = c2_det2(b, c) * area;\n   242\t    let v_abc = c2_det2(c, a) * area;\n   243\t    let w_abc = c2_det2(a, b) * area;\n   244\t    if v_ab <= 0.0 && u_ca <= 0.0 {\n   245\t        s.verts[0].u = 1.0;\n   246\t        s.div = 1.0;\n   247\t        s.count = 1;\n   248\t    } else if u_ab <= 0.0 && v_bc <= 0.0 {\n   249\t        s.verts[0] = s.verts[1];\n   250\t        s.verts[0].u = 1.0;\n   251\t        s.div = 1.0;\n   252\t        s.count = 1;\n   253\t    } else if u_bc <= 0.0 && v_ca <= 0.0 {\n   254\t        s.verts[0] = s.verts[2];\n   255\t        s.verts[0].u = 1.0;\n   256\t        s.div = 1.0;\n   257\t        s.count = 1;\n   258\t    } else if u_ab > 0.0 && v_ab > 0.0 && w_abc <= 0.0 {\n   259\t        s.verts[0].u = u_ab;\n   260\t        s.verts[1].u = v_ab;\n\n   261\t        s.div = u_ab + v_ab;\n   262\t        s.count = 2;\n   263\t    } else if u_bc > 0.0 && v_bc > 0.0 && u_abc <= 0.0 {\n   264\t        s.verts[0] = s.verts[1];\n   265\t        s.verts[1] = s.verts[2];\n   266\t        s.verts[0].u = u_bc;\n   267\t        s.verts[1].u = v_bc;\n   268\t        s.div = u_bc + v_bc;\n   269\t        s.count = 2;\n   270\t    } else if u_ca > 0.0 && v_ca > 0.0 && v_abc <= 0.0 {\n   271\t        s.verts[1] = s.verts[0];\n   272\t        s.verts[0] = s.verts[2];\n   273\t        s.verts[0].u = u_ca;\n   274\t        s.verts[1].u = v_ca;\n   275\t        s.div = u_ca + v_ca;\n   276\t        s.count = 2;\n   277\t    } else {\n   278\t        s.verts[0].u = u_abc;\n   279\t        s.verts[1].u = v_abc;\n   280\t        s.verts[2].u = w_abc;\n   281\t        s.div = u_abc + v_abc + w_abc;\n   282\t        s.count = 3;\n   283\t    }\n   284\t}\n   285\t\n   286\tfn c2_neg(a: C2v) -> C2v {\n   287\t    c2_v(-a.x, -a.y)\n   288\t}\n   289\t\n   290\tfn c2_skew(a: C2v) -> C2v {\n   291\t    C2v { x: -a.y, y: a.x }\n   292\t}\n   293\t\n   294\tfn c2_ccw90(a: C2v) -> C2v {\n   295\t    C2v { x: a.y, y: -a.x }\n   296\t}\n   297\t\n   298\tfn c2_d(s: &C2Simplex) -> C2v {\n   299\t    match s.count {\n   300\t        1 => c2_neg(s.verts[0].p),\n   301\t        2 => {\n   302\t            let ab = c2_sub(s.verts[1].p, s.verts[0].p);\n   303\t            if c2_det2(ab, c2_neg(s.verts[0].p)) > 0.0 {\n   304\t                c2_skew(ab)\n   305\t            } else {\n   306\t                c2_ccw90(ab)\n   307\t            }\n   308\t        }\n   309\t        _ => c2_v(0.0, 0.0),\n   310\t    }\n   311\t}\n   312\t\n   313\tfn c2_support(verts: &[C2v; 8], count: c_int, d: C2v) -> c_int {\n   314\t    let mut imax = 0;\n   315\t    let mut dmax = c2_dot(verts[0], d);\n   316\t    let mut i = 1;\n   317\t    while i < count {\n   318\t        let dot = c2_dot(verts[i as usize], d);\n   319\t        if dot > dmax {\n   320\t            imax = i;\n   321\t            dmax = dot;\n   322\t        }\n   323\t        i += 1;\n   324\t    }\n   325\t    imax\n   326\t}\n   327\t\n   328\tfn c2_witness(s: &C2Simplex, a: &mut C2v, b: &mut C2v) {\n   329\t    let den = 1.0 / s.div;\n   330\t    match s.count {\n   331\t        1 => {\n   332\t            *a = s.verts[0].s_a;\n   333\t            *b = s.verts[0].s_b;\n   334\t        }\n   335\t        2 => {\n   336\t            *a = c2_add(\n   337\t                c2_mulvs(s.verts[0].s_a, den * s.verts[0].u),\n   338\t                c2_mulvs(s.verts[1].s_a, den * s.verts[1].u),\n   339\t            );\n   340\t            *b = c2_add(\n   341\t                c2_mulvs(s.verts[0].s_b, den * s.verts[0].u),\n   342\t                c2_mulvs(s.verts[1].s_b, den * s.verts[1].u),\n   343\t            );\n   344\t        }\n   345\t        3 => {\n   346\t            *a = c2_add(\n   347\t                c2_add(\n   348\t                    c2_mulvs(s.verts[0].s_a, den * s.verts[0].u),\n   349\t                    c2_mulvs(s.verts[1].s_a, den * s.verts[1].u),\n   350\t                ),\n   351\t                c2_mulvs(s.verts[2].s_a, den * s.verts[2].u),\n   352\t            );\n   353\t            *b = c2_add(\n   354\t                c2_add(\n   355\t                    c2_mulvs(s.verts[0].s_b, den * s.verts[0].u),\n   356\t                    c2_mulvs(s.verts[1].s_b, den * s.verts[1].u),\n   357\t                ),\n   358\t                c2_mulvs(s.verts[2].s_b, den * s.verts[2].u),\n   359\t            );\n   360\t        }\n   361\t        _ => {\n   362\t            *a = c2_v(0.0, 0.0);\n   363\t            *b = c2_v(0.0, 0.0);\n   364\t        }\n   365\t    }\n   366\t}\n   367\t\n   368\tfn c2_div(a: C2v, b: f32) -> C2v {\n   369\t    c2_mulvs(a, 1.0 / b)\n   370\t}\n   371\t\n   372\tfn c2_norm(a: C2v) -> C2v {\n   373\t    c2_div(a, c2_len(a))\n   374\t}\n   375\t\n   376\tfn c2_l(s: &C2Simplex) -> C2v {\n   377\t    let den = 1.0 / s.div;\n   378\t    match s.count {\n   379\t        1 => s.verts[0].p,\n   380\t        2 => c2_add(\n   381\t            c2_mulvs(s.verts[0].p, den * s.verts[0].u),\n   382\t            c2_mulvs(s.verts[1].p, den * s.verts[1].u),\n   383\t        ),\n   384\t        _ => c2_v(0.0, 0.0),\n   385\t    }\n   386\t}\n   387\t\n   388\tfn c2_mulrv_t(a: C2r, b: C2v) -> C2v {\n   389\t    c2_v(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n   390\t}\n   391\t\n   392\tfn c2_gjk(\n   393\t    a_shape: ShapeRef<'_>,\n   394\t    type_a: C2Type,\n   395\t    ax_ptr: Option<&C2x>,\n   396\t    b_shape: ShapeRef<'_>,\n   397\t    type_b: C2Type,\n   398\t    bx_ptr: Option<&C2x>,\n   399\t    out_a: Option<&mut C2v>,\n   400\t    out_b: Option<&mut C2v>,\n   401\t    use_radius: c_int,\n   402\t    iterations: Option<&mut c_int>,\n   403\t    cache: Option<&mut C2GjkCache>,\n   404\t) -> f32 {\n   405\t    let ax = if let Some(v) = ax_ptr { *v } else { c2x_identity() };\n   406\t    let bx = if let Some(v) = bx_ptr { *v } else { c2x_identity() };\n   407\t    let mut p_a = C2Proxy::default();\n   408\t    let mut p_b = C2Proxy::default();\n   409\t    match (type_a, a_shape) {\n   410\t        (C2Type::Circle, ShapeRef::Circle(shape)) => c2_make_proxy_circle(shape, &mut p_a),\n   411\t        (C2Type::Aabb, ShapeRef::Aabb(shape)) => c2_make_proxy_aabb(shape, &mut p_a),\n   412\t        (C2Type::Capsule, ShapeRef::Capsule(shape)) => c2_make_proxy_capsule(shape, &mut p_a),\n   413\t        _ => {}\n   414\t    }\n   415\t    match (type_b, b_shape) {\n   416\t        (C2Type::Circle, ShapeRef::Circle(shape)) => c2_make_proxy_circle(shape, &mut p_b),\n   417\t        (C2Type::Aabb, ShapeRef::Aabb(shape)) => c2_make_proxy_aabb(shape, &mut p_b),\n   418\t        (C2Type::Capsule, ShapeRef::Capsule(shape)) => c2_make_proxy_capsule(shape, &mut p_b),\n   419\t        _ => {}\n   420\t    }\n   421\t\n   422\t    let mut s = C2Simplex::default();\n   423\t    let mut cache_was_read = 0;\n   424\t    let mut cache = cache;\n   425\t    if let Some(cache_ref) = cache.as_mut() {\n   426\t        let cach