lue << ((0u32.wrapping_sub(count)) & 0x1F))\n}\n#[inline]\npub fn rotate_right_u16(value: U16, count: U32) -> U16 {\n    let count = count & 0x0F;\n    (value >> count) | (value << ((0u32.wrapping_sub(count)) & 0x0F))\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
