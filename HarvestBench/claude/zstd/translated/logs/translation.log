fault tableLog value when none specified */\n39\t#define HUF_SYMBOLVALUE_MAX  255\n40\t\n41\t#define HUF_TABLELOG_ABSOLUTEMAX  12  /* absolute limit of HUF_MAX_TABLELOG. Beyond that value, code does not work */\n42\t#if (HUF_TABLELOG_MAX > HUF_TABLELOG_ABSOLUTEMAX)\n43\t#  error \"HUF_TABLELOG_MAX is too large !\"\n44\t#endif\n45\t\n46\t\n47\t/* ****************************************\n48\t*  Static allocation\n49\t******************************************/\n50\t/* HUF buffer bounds */\n51\t#define HUF_CTABLEBOUND 129\n52\t#define HUF_BLOCKBOUND(size) (size + (size>>8) + 8)   /* only true when incompressible is pre-filtered with fast heuristic */\n53\t#define HUF_COMPRESSBOUND(size) (HUF_CTABLEBOUND + HUF_BLOCKBOUND(size))   /* Macro version, useful for static allocation */\n54\t\n55\t/* static allocation of HUF's Compression Table */\n56\t/* this is a private definition, just exposed for allocation and strict aliasing purpose. never EVER access its members directly */\n57\ttypedef size_t HUF_CElt;   /* consider it an incomplete type */\n58\t#define HUF_CTABLE_SIZE_ST(maxSymbolValue)   ((maxSymbolValue)+2)   /* Use tables of size_t, for proper alignment */\n59\t#define HUF_CTABLE_SIZE(maxSymbolValue)       (HUF_CTABLE_SIZE_ST(maxSymbolValue) * sizeof(size_t))\n60\t#define HUF_CREATE_STATIC_CTABLE(name, maxSymbolValue) \\\n61\t    HUF_CElt name[HUF_CTABLE_SIZE_ST(maxSymbolValue)] /* no final ; */\n62\t\n63\t/* static allocation of HUF's DTable */\n64\ttypedef U32 HUF_DTable;\n65\t#define HUF_DTABLE_SIZE(maxTableLog)   (1 + (1<<(maxTableLog)))\n66\t#define HUF_CREATE_STATIC_DTABLEX1(DTable, maxTableLog) \\\n67\t        HUF_DTable DTable[HUF_DTABLE_SIZE((maxTableLog)-1)] = { ((U32)((maxTableLog)-1) * 0x01000001) }\n68\t#define HUF_CREATE_STATIC_DTABLEX2(DTable, maxTableLog) \\\n69\t        HUF_DTable DTable[HUF_DTABLE_SIZE(maxTableLog)] = { ((U32)(maxTableLog) * 0x01000001) }\n70\t\n71\t\n72\t/* ****************************************\n73\t*  Advanced decompression functions\n74\t******************************************/\n75\t\n76\t/**\n77\t * Huffman flags bitset.\n78\t * For all flags, 0 is the default value.\n79\t */\n80\ttypedef enum {\n81\t    /**\n82\t     * If compiled with DYNAMIC_BMI2: Set flag only if the CPU supports BMI2 at runtime.\n83\t     * Otherwise: Ignored.\n84\t     */\n85\t    HUF_flags_bmi2 = (1 << 0),\n86\t    /**\n87\t     * If set: Test possible table depths to find the one that produces the smallest header + encoded size.\n88\t     * If unset: Use heuristic to find the table depth.\n89\t     */\n90\t    HUF_flags_optimalDepth = (1 << 1),\n91\t    /**\n92\t     * If set: If the previous table can encode the input, always reuse the previous table.\n93\t     * If unset: If the previous table can encode the input, reuse the previous table if it results in a smaller output.\n94\t     */\n95\t    HUF_flags_preferRepeat = (1 << 2),\n96\t    /**\n97\t     * If set: Sample the input and check if the sample is uncompressible, if it is then don't attempt to compress.\n98\t     * If unset: Always histogram the entire input.\n99\t     */\n100\t    HUF_flags_suspectUncompressible = (1 << 3),\n101\t    /**\n102\t     * If set: Don't use assembly implementations\n103\t     * If unset: Allow using assembly implementations\n104\t     */\n105\t    HUF_flags_disableAsm = (1 << 4),\n106\t    /**\n107\t     * If set: Don't use the fast decoding loop, always use the fallback decoding loop.\n108\t     * If unset: Use the fast decoding loop when possible.\n109\t     */\n110\t    HUF_flags_disableFast = (1 << 5)\n111\t} HUF_flags_e;\n112\t\n113\t\n114\t/* ****************************************\n115\t *  HUF detailed API\n116\t * ****************************************/\n117\t#define HUF_OPTIMAL_DEPTH_THRESHOLD ZSTD_btultra\n118\t\n119\t/*! HUF_compress() does the following:\n120\t *  1. count symbol occurrence from source[] into table count[] using FSE_count() (exposed within \"fse.h\")\n121\t *  2. (optional) refine tableLog using HUF_optimalTableLog()\n122\t *  3. build Huffman table from count using HUF_buildCTable()\n123\t *  4. save Huffman table to memory buffer using HUF_writeCTable()\n124\t *  5. encode the data stream using HUF_compress4X_usingCTable()\n125\t *\n126\t *  The following API allows targeting specific sub-functions for advanced tasks.\n127\t *  For example, it's possible to compress several blocks using the same 'CTable',\n128\t *  or to save and regenerate 'CTable' using external methods.\n129\t */\n130\tunsigned HUF_minTableLog(unsigned symbolCardinality);\n131\tunsigned HUF_cardinality(const unsigned* count, unsigned maxSymbolValue);\n132\tunsigned HUF_optimalTableLog(unsigned maxTableLog, size_t srcSize, unsigned maxSymbolValue, void* workSpace,\n133\t size_t wkspSize, HUF_CElt* table, const unsigned* count, int flags); /* table is used as scratch space for building and testing tables, not a return value */\n134\tsize_t HUF_writeCTable_wksp(void* dst, size_t maxDstSize, const HUF_CElt* CTable, unsigned maxSymbolValue, unsigned huffLog, void* workspace, size_t workspaceSize);\n135\tsize_t HUF_compress4X_usingCTable(void* dst, size_t dstSize, const void* src, size_t srcSize, const HUF_CElt* CTable, int flags);\n136\tsize_t HUF_estimateCompressedSize(const HUF_CElt* CTable, const unsigned* count, unsigned maxSymbolValue);\n137\tint HUF_validateCTable(const HUF_CElt* CTable, const unsigned* count, unsigned maxSymbolValue);\n138\t\n139\ttypedef enum {\n140\t   HUF_repeat_none,  /**< Cannot use the previous table */\n141\t   HUF_repeat_check, /**< Can use the previous table but it must be checked. Note : The previous table must have been constructed by HUF_compress{1, 4}X_repeat */\n142\t   HUF_repeat_valid  /**< Can use the previous table and it is assumed to be valid */\n143\t } HUF_repeat;\n144\t\n145\t/** HUF_compress4X_repeat() :\n146\t *  Same as HUF_compress4X_wksp(), but considers using hufTable if *repeat != HUF_repeat_none.\n147\t *  If it uses hufTable