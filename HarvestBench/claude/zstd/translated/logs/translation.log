{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Dhh3KAYRHRovw8PGiyf8CL","type":"tool_result","content":"1555\t}\n1556\t\n1557\t/// intentional underflow : ensure repIndex isn't overlapping dict + prefix\n1558\t#[inline]\n1559\tpub fn ZSTD_index_overlap_check(prefixLowestIndex: U32, repIndex: U32) -> i32 {\n1560\t    ((prefixLowestIndex.wrapping_sub(1)).wrapping_sub(repIndex) >= 3) as i32\n1561\t}\n1562\t\n1563\t/* Short Cache */\n1564\tpub const ZSTD_SHORT_CACHE_TAG_BITS: U32 = 8;\n1565\tpub const ZSTD_SHORT_CACHE_TAG_MASK: U32 = (1u32 << ZSTD_SHORT_CACHE_TAG_BITS) - 1;\n1566\t\n1567\t/// Unpacks hashAndTag into (hash, tag), then packs (index, tag) into hashTable[hash].\n1568\t#[inline]\n1569\tpub unsafe fn ZSTD_writeTaggedIndex(hashTable: *mut U32, hashAndTag: usize, index: U32) {\n1570\t    let hash = hashAndTag >> ZSTD_SHORT_CACHE_TAG_BITS;\n1571\t    let tag = (hashAndTag as U32) & ZSTD_SHORT_CACHE_TAG_MASK;\n1572\t    debug_assert!(index >> (32 - ZSTD_SHORT_CACHE_TAG_BITS) == 0);\n1573\t    *hashTable.add(hash) = (index << ZSTD_SHORT_CACHE_TAG_BITS) | tag;\n1574\t}\n1575\t\n1576\t/// Unpacks tag1 and tag2 from lower bits and checks if the tags match.\n1577\t#[inline]\n1578\tpub fn ZSTD_comparePackedTags(packedTag1: usize, packedTag2: usize) -> i32 {\n1579\t    let tag1 = (packedTag1 as U32) & ZSTD_SHORT_CACHE_TAG_MASK;\n1580\t    let tag2 = (packedTag2 as U32) & ZSTD_SHORT_CACHE_TAG_MASK;\n1581\t    (tag1 == tag2) as i32\n1582\t}\n1583\t\n1584\t/// SequencePosition (shared internal, used across module boundaries)."}]},"parent_tool_use_id":"toolu_bdrk_01N9jT6e3wFEhYX1FJb5qEWW","session_id":"d726b7a2-9f1b-40fa-9ece-fa56fda2dd37","uuid":"0cfa49d1-a50c-4260-9fa9-abedf61b6ea7","timestamp":"2026-08-05T05:09:46.948Z","subagent_type":"general-purpose","task_description":"Translate zstd_fast"}
