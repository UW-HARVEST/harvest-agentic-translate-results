pub unsafe fn ZSTD_storeSeq(\n913\t    seqStorePtr: *mut SeqStore_t,\n914\t    litLength: usize,\n915\t    literals: *const u8,\n916\t    litLimit: *const u8,\n917\t    offBase: U32,\n918\t    matchLength: usize,\n919\t) {\n920\t    let litLimit_w = litLimit.offset(-(WILDCOPY_OVERLENGTH as isize));\n921\t    let litEnd = literals.add(litLength);\n922\t    debug_assert!(\n923\t        ((*seqStorePtr).sequences).offset_from((*seqStorePtr).sequencesStart) < (*seqStorePtr).maxNbSeq as isize\n924\t    );\n925\t    /* copy Literals */\n926\t    debug_assert!((*seqStorePtr).maxNbLit <= 128 * (1 << 10));\n927\t    debug_assert!(\n928\t        ((*seqStorePtr).lit).add(litLength) <= ((*seqStorePtr).litStart).add((*seqStorePtr).maxNbLit)\n929\t    );\n930\t    debug_assert!(literals.add(litLength) <= litLimit);\n931\t    if litEnd <= litLimit_w {\n932\t        /* Common case we can use wildcopy. First copy 16 bytes. */\n933\t        ZSTD_copy16((*seqStorePtr).lit as *mut c_void, literals as *const c_void);\n934\t        if litLength > 16 {\n935\t            ZSTD_wildcopy(\n936\t                ((*seqStorePtr).lit).add(16) as *mut c_void,\n937\t                literals.add(16) as *const c_void,\n938\t                (litLength as isize) - 16,\n939\t                ZSTD_no_overlap,\n940\t            );\n941\t        }\n942\t    } else {\n943\t        ZSTD_safecopyLiterals((*seqStorePtr).lit, literals, litEnd, litLimit_w);\n944\t    }\n945\t    (*seqStorePtr).lit = ((*seqStorePtr).lit).add(litLength);\n946\t\n947\t    ZSTD_storeSeqOnly(seqStorePtr, litLength, offBase, matchLength);\n948\t}\n949\t\n950\t/// updates in-place @rep (array of repeat offsets)\n951\t#[inline]\n952\tpub unsafe fn ZSTD_updateRep(rep: *mut U32, offBase: U32, ll0: U32) {\n953\t    if OFFBASE_IS_OFFSET(offBase) {\n954\t        /* full offset */\n955\t        *rep.add(2) = *rep.add(1);\n956\t        *rep.add(1) = *rep.add(0);\n957\t        *rep.add(0) = OFFBASE_TO_OFFSET(offBase);\n958\t    } else {\n959\t   