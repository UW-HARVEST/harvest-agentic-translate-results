nst u8, ptr as *mut u8, 2);\n59\t}\n60\t#[inline]\n61\tpub unsafe fn mem_write32(ptr: *mut core::ffi::c_void, value: U32) {\n62\t    core::ptr::copy_nonoverlapping(&value as *const U32 as *const u8, ptr as *mut u8, 4);\n63\t}\n64\t#[inline]\n65\tpub unsafe fn mem_write64(ptr: *mut core::ffi::c_void, value: U64) {\n66\t    core::ptr::copy_nonoverlapping(&value as *const U64 as *const u8, ptr as *mut u8, 8);\n67\t}\n68\t\n69\t#[inline]\n70\tpub fn mem_swap32(x: U32) -> U32 {\n71\t    x.swap_bytes()\n72\t}\n73\t#[inline]\n74\tpub fn mem_swap64(x: U64) -> U64 {\n75\t    x.swap_bytes()\n76\t}\n77\t#[inline]\n78\tpub fn mem_swap_st(x: usize) -> usize {\n79\t    x.swap_bytes()\n80\t}\n81\t\n82\t#[inline]\n83\tpub unsafe fn mem_read_le16(ptr: *const core::ffi::c_void) -> U16 {\n84\t    if mem_is_little_endian() != 0 {\n85\t        mem_read16(ptr)\n86\t    } else {\n87\t        let p = ptr as *const u8;\n88\t        (*p as U16) + ((*p.add(1) as U16) << 8)\n89\t    }\n90\t}\n91\t#[inline]\n92\tpub unsafe fn mem_write_le16(ptr: *mut core::ffi::c_void, val: U16) {\n93\t    if mem_is_little_endian() != 0 {\n94\t        mem_write16(ptr, val);\n95\t    } else {\n96\t        let p = ptr as *mut u8;\n97\t        *p = val as u8;\n98\t        *p.add(1) = (val >> 8) as u8;\n99\t    }\n100\t}\n101\t#[inline]\n102\tpub unsafe fn mem_read_le24(ptr: *const core::ffi::c_void) -> U32 {\n103\t    (mem_read_le16(ptr) as U32) + ((*((ptr as *const u8).add(2)) as U32) << 16)\n104\t}\n105\t#[inline]\n106\tpub unsafe fn mem_write_le24(ptr: *mut core::ffi::c_void, val: U32) {\n107\t    mem_write_le16(ptr, val as U16);\n108\t    *((ptr as *mut u8).add(2)) = (val >> 16) as u8;\n109\t}\n110\t#[inline]\n111\tpub unsafe fn mem_read_le32(ptr: *const core::ffi::c_void) -> U32 {\n112\t    if mem_is_little_endian() != 0 {\n113\t        mem_read32(ptr)\n114\t    } else {\n115\t        mem_swap32(mem_read32(ptr))\n116\t    }\n117\t}\n118\t#[inline]\n119\tpub unsafe fn mem_write_le32(ptr: *mut core::ffi::c_void