n53\tpub fn fse_dtable_size(max_table_log: u32) -> usize {\n54\t    fse_dtable_size_u32(max_table_log) * core::mem::size_of::<FSE_DTable>()\n55\t}\n56\t#[inline]\n57\tpub fn fse_build_dtable_wksp_size(max_table_log: u32, max_symbol_value: u32) -> usize {\n58\t    core::mem::size_of::<i16>() * (max_symbol_value as usize + 1)\n59\t        + (1usize << max_table_log)\n60\t        + 8\n61\t}\n62\t#[inline]\n63\tpub fn fse_decompress_wksp_size_u32(max_table_log: u32, max_symbol_value: u32) -> usize {\n64\t    fse_dtable_size_u32(max_table_log)\n65\t        + 1\n66\t        + (fse_build_dtable_wksp_size(max_table_log, max_symbol_value) + core::mem::size_of::<u32>()\n67\t            - 1)\n68\t            / core::mem::size_of::<u32>()\n69\t        + (FSE_MAX_SYMBOL_VALUE as usize + 1) / 2\n70\t        + 1\n71\t}\n72\t#[inline]\n73\tpub fn fse_decompress_wksp_size(max_table_log: u32, max_symbol_value: u32) -> usize {\n74\t    fse_decompress_wksp_size_u32(max_table_log, max_symbol_value) * core::mem::size_of::<u32>()\n75\t}"}]},"parent_tool_use_id":"toolu_bdrk_015ATHCGqmuxvv9YCbxuXng8","session_id":"d726b7a2-9f1b-40fa-9ece-fa56fda2dd37","uuid":"075b3f9f-8dfb-4bd0-9b8c-2d3d046fe823","timestamp":"2026-08-05T04:04:59.489Z","subagent_type":"general-purpose","task_description":"Translate huf_decompress"}
