rt) as usize\n1037\t}\n1038\t\n1039\t/// Can count match length with `ip` & `match` in 2 different segments.\n1040\t#[inline]\n1041\tpub unsafe fn ZSTD_count_2segments(\n1042\t    ip: *const u8,\n1043\t    r#match: *const u8,\n1044\t    iEnd: *const u8,\n1045\t    mEnd: *const u8,\n1046\t    iStart: *const u8,\n1047\t) -> usize {\n1048\t    let ip_plus = ip.offset(mEnd.offset_from(r#match));\n1049\t    let vEnd = if ip_plus < iEnd { ip_plus } else { iEnd };\n1050\t    let matchLength = ZSTD_count(ip, r#match, vEnd);\n1051\t    if r#match.add(matchLength) != mEnd {\n1052\t        return matchLength;\n1053\t    }\n1054\t    matchLength + ZSTD_count(ip.add(matchLength), iStart, iEnd)\n1055\t}\n1056\t\n1057\t/*-*************************************\n1058\t *  Hashes\n1059\t ***************************************/\n1060\tconst prime3bytes: U32 = 506832829;\n1061\t#[inline]\n1062\tfn ZSTD_hash3(u: U32, h: U32, s: U32) -> U32 {\n1063\t    debug_assert!(h <= 32);"}]},"parent_tool_use_id":"toolu_bdrk_018tDxRpXPxVMEhJZmseoyxZ","session_id":"d726b7a2-9f1b-40fa-9ece-fa56fda2dd37","uuid":"ef6a64e9-ff94-4f50-9dfe-8b62f577f749","timestamp":"2026-08-05T05:10:28.315Z","subagent_type":"general-purpose","task_description":"Translate zstd_ldm"}
