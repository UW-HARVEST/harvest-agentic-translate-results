                   notDone = 0;\n4036\t                    break;\n4037\t                }\n4038\t                if ((size_t)(iend-ip) >= neededInSize) {  /* decode directly from src */\n4039\t                    size_t const decodedSize = ZSTDv06_decompressContinue(zbd->zd,\n4040\t                        zbd->outBuff + zbd->outStart, zbd->outBuffSize - zbd->outStart,\n4041\t                        ip, neededInSize);\n4042\t                    if (ZSTDv06_isError(decodedSize)) return decodedSize;\n4043\t                    ip += neededInSize;\n4044\t                    if (!decodedSize) break;   /* this was just a header */\n4045\t                    zbd->outEnd = zbd->outStart +  decodedSize;\n4046\t                    zbd->stage = ZBUFFds_flush;\n4047\t                    break;\n4048\t                }\n4049\t                if (ip==iend) { notDone = 0; break; }   /* no more input */\n4050\t                zbd->stage = ZBUFFds_load;\n4051\t            }\n4052\t\t    /* fall-through */\n4053\t        case ZBUFFds_load:\n4054\t            {   size_t const neededInSize = ZSTDv06_nextSrcSizeToDecompress(zbd->zd);\n4055\t                size_t const toLoad = neededInSize - zbd->inPos;   /* should always be <= remaining space within inBuff */\n4056\t                size_t loadedSize;\n4057\t                if (toLoad > zbd->inBuffSize - zbd->inPos) return ERROR(corruption_detected);   /* should never happen */\n4058\t                loadedSize = ZBUFFv06_limitCopy(zbd->inBuff + zbd->inPos, toLoad, ip, iend-ip);\n4059\t                ip += loadedSize;\n4060\t                zbd->inPos += loadedSize;\n4061\t                if (loadedSize < toLoad) { notDone = 0; break; }   /* not enough input, wait for more */\n4062\t\n4063\t                /* decode loaded input */\n4064\t                {   size_t const decodedSize = ZSTDv06_decompressContinue(zbd->zd,\n4065\t                        zbd->outBuff + zbd->outStart, zbd->outBuffSize - zbd->outStart,\n4066\t              