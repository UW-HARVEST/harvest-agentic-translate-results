************************************************\n96\t*  Block entropic compression\n97\t*********************************************************/\n98\t\n99\t/* See doc/zstd_compression_format.md for detailed format description */\n100\t\n101\t#[unsafe(no_mangle)]\n102\tpub unsafe extern \"C\" fn ZSTD_seqToCodes(seqStorePtr: *const SeqStore_t) -> c_int {\n103\t    let sequences: *const SeqDef = (*seqStorePtr).sequencesStart;\n104\t    let llCodeTable: *mut BYTE = (*seqStorePtr).llCode;\n105\t    let ofCodeTable: *mut BYTE = (*seqStorePtr).ofCode;\n106\t    let mlCodeTable: *mut BYTE = (*seqStorePtr).mlCode;\n107\t    let nbSeq: U32 = (*seqStorePtr)\n108\t        .sequences\n109\t        .offset_from((*seqStorePtr).sequencesStart) as U32;\n110\t    let mut u: U32;\n111\t    let mut longOffsets: c_int = 0;\n112\t    u = 0;\n113\t    while u < nbSeq {\n114\t        let llv: U32 = (*sequences.offset(u as isize)).litLength as U32;\n115\t        let ofCode: U32 = ZSTD_highbit32((*sequences.offset(u as isize)).offBase);\n116\t        let mlv: U32 = (*sequences.offset(u as isize)).mlBase as U32;\n117\t        *llCodeTable.offset(u as isize) = ZSTD_LLcode(llv) as BYTE;\n118\t        *ofCodeTable.offset(u as isize) = ofCode as BYTE;\n119\t        *mlCodeTable.offset(u as isize) = ZSTD_MLcode(mlv) as BYTE;\n120\t        if MEM_32bits() != 0 && ofCode >= STREAM_ACCUMULATOR_MIN() {\n121\t            longOffsets = 1;\n122\t        }\n123\t        u = u.wrapping_add(1);\n124\t    }\n125\t    if (*seqStorePtr).longLengthType == ZSTD_llt_literalLength {\n126\t        *llCodeTable.offset((*seqStorePtr).longLengthPos as isize) = MaxLL as BYTE;\n127\t    }\n128\t    if (*seqStorePtr).longLengthType == ZSTD_llt_matchLength {\n129\t        *mlCodeTable.offset((*seqStorePtr).longLengthPos as isize) = MaxML as BYTE;\n130\t    }\n131\t    longOffsets\n132\t}\n133\t\n134\t/* ZSTD_useTargetCBlockSize():\n135\t * Returns if target compressed block size param is being used.\n136\t * If used, compression will do best effort to make a compressed block size to be around targetCBlockSize.\n137\t * Returns 1 if true, 0 otherwise. */\n138\tunsafe fn ZSTD_useTargetCBlockSize(cctxParams: *const ZSTD_CCtx_params) -> c_int {\n139\t    ((*cctxParams).targetCBlockSize != 0) as c_int\n140\t}\n141\t\n142\t/* ZSTD_blockSplitterEnabled():\n143\t * Returns if block splitting param is being used\n144\t * If used, compression will do best effort to split a block in order to improve compression ratio.\n145\t * At the time this function is called, the parameter must be finalized.\n146\t * Returns 1 if true, 0 otherwise. */\n147\tunsafe fn ZSTD_blockSplitterEnabled(cctxParams: *mut ZSTD_CCtx_params) -> c_int {\n148\t    ((*cctxParams).postBlockSplitter == ZSTD_ps_enable) as c_int\n149\t}\n150\t\n151\t/* Type returned by ZSTD_buildSequencesStatistics containing finalized symbol encoding types\n152\t * and size of the sequences statistics\n153\t */\n154\t#[repr(C)]\n155\t#[derive(Copy, Clone, Default)]\n156\tpub struct ZSTD_symbolEncodingTypeStats_t {\n157\t    pub LLtype: U32,\n158\t    pub Offtype: U32,\n159\t    pub MLtype: U32,\n160\t    pub size: usize,\n161\t    /* Accounts for bug in 1.3.4. More detail in ZSTD_entropyCompressSeqStore_internal() */\n162\t    pub lastCountSize: usize,\n163\t    pub longOffsets: c_int,\n164\t}\n165\t\n166\t// __END__\n167\t"}]},"parent_tool_use_id":"toolu_bdrk_01CokQzLAPP1HtRyDx9Bz8cL","session_id":"91081e33-7aae-4a44-80fe-383759459deb","uuid":"55f186ca-1316-4be6-a841-03853e4b15b7","timestamp":"2026-08-22T22:58:15.184Z","subagent_type":"general-purpose","task_description":"Translate zstd_compress part 4"}
