set(-WILDCOPY_OVERLENGTH).offset_from(op));\n        op = op.wrapping_offset(oend.wrapping_offset(-WILDCOPY_OVERLENGTH).offset_from(op));\n    }\n\n    /* Handle the leftovers. */\n    while op < oend {\n        *op = *ip;\n        op = op.add(1);\n        ip = ip.add(1);\n    }\n}\n\n// __END__\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":3,"cache_creation_input_tokens":4002,"cache_read_input_tokens":126274,"cache_creation":{"ephemeral_5m_input_tokens":4002,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01MNF9BTJSzJUwm6nWt3koQt","session_id":"91081e33-7aae-4a44-80fe-383759459deb","uuid":"1cace458-19cf-4d41-9549-cf328bba3586","timestamp":"2026-08-22T22:59:03.194Z","subagent_type":"general-purpose","task_description":"Translate zstd_decompress_block"}
