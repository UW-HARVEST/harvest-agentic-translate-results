es, and\n#   * the modules you name on the command line.\n#\n# Module paths are given relative to src/ without the .rs extension, e.g.\n#   ./check.sh legacy/zstd_v05\n#   ./check.sh compress/zstd_fast compress/zstd_double_fast\nset -u\n\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n: \"${TMPDIR:=/tmp}\"\n\nif [ \"$#\" -lt 1 ]; then\n    echo \"usage: $0 <module-path-under-src-without-.rs> ...\" >&2\n    exit 2\nfi\n\nNAME=\"check_$(echo \"$*\" | tr ' /' '__')\"\nWORK=\"$TMPDIR/$NAME\"\nrm -rf \"$WORK\"\nmkdir -p \"$WORK\"\n\ncat > \"$WORK/Cargo.toml\" <<EOF\n[package]\nname = \"checkmod\"\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[lib]\nname = \"checkmod\"\npath = \"src/check_root.rs\"\ncrate-type = [\"lib\"]\n\n[profile.dev]\noverflow-checks = false\ndebug-assertions = false\nEOF\n\nln -s \"$ROOT/src\" \"$WORK/src\"\n\nROOTFILE=\"$ROOT/src/check_root.rs\"\n\n{\n  cat <<'EOF'\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n#![allow(unused_parens)]\n#![allow(unused_mut)]\n#![allow(unused_variables)]\n#![allow(unused_assignments)]\n#![allow(unused_unsafe)]\n#![allow(dead_code)]\n#![allow(static_mut_refs)]\n#![allow(clippy::all)]\n\npub mod libc;\npub mod zstd_h;\n\npub mod common {\n    pub mod bits;\n    pub mod bitstream;\n    pub mod debug;\n    pub mod entropy_common;\n    pub mod error_private;\n    pub mod fse;\n    pub mod fse_decompress;\n    pub mod huf;\n    pub mod mem;\n    pub mod pool;\n    pub mod threading;\n    pub mod xxhash;\n    pub mod zstd_common;\n    pub mod zstd_internal;\n}\n\npub mod compress {\n    pub mod clevels;\n    pub mod zstd_compress_internal;\n    pub mod zstd_cwksp;\n}\n\npub mod decompress {\n    pub mod zstd_decompress_internal;\n}\nEOF\n  # group the requested modules by directory\n  python3 - \"$@\" <<'PY'\nimport sys, collections\ngroups = collections.defaultdict(list)\nfor m in sys.argv[1:]:\n    m = m.removesuffix('.rs')\n    parts = m.split('/')\n    if len(parts) == 1:\n        groups[''].append(parts[0])\n    else:\n        groups['/'.join(parts[:-1])].append(parts[-1])\ncore = {'common'}\nalready = {'common': set(), 'compress': {'clevels','zstd_compress_internal','zstd_cwksp'}, 'decompress': {'zstd_decompress_internal'}}\nfor d, mods in groups.items():\n    if d == '':\n        for m in mods:\n            print(f\"pub mod {m};\")\n    else:\n        segs = d.split('/')\n        # only single-level dirs are used in this project\n        mods = [m for m in mods if m not in already.get(segs[0], set())]\n        if not mods:\n            continue\n        if segs[0] in already:\n            # dir already declared in the fixed preamble: re-open it via #[path]\n            print(f\"pub mod {segs[0]}_extra {{\")\n            for m in mods:\n                print(f'    #[path = \"../{d}/{m}.rs\"] pub mod {m};')\n            print(\"}\")\n        else:\n            print(f\"pub mod {segs[0]} {{\")\n            for m in mods:\n                print(f\"    pub mod {m};\")\n            print(\"}\")\nPY\n} > \"$ROOTFILE\"\n\ncd \"$WORK\" || exit 1\nCARGO_TARGET_DIR=\"$WORK/target\" cargo build --message-format=short 2>&1\nSTATUS=$?\nrm -f \"$ROOTFILE\"\nexit $STATUS\n","userModified":false}}
