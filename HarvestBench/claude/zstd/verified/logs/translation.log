D_getErrorCode_local(res) == ZSTD_error_prefix_unknown) && (moreThan1Frame == 1)\n            {\n                return ERROR(ZSTD_error_srcSize_wrong);\n            }\n            if ERR_isError(res) != 0 {\n                return res;\n            }\n            if res != 0 {\n                dst = (dst as *mut BYTE).wrapping_add(res) as *mut c_void;\n            }\n            dstCapacity -= res;\n        }\n        moreThan1Frame = 1;\n    }\n\n    if srcSize != 0 {\n        return ERROR(ZSTD_error_srcSize_wrong);\n    }\n\n    (dst as *mut BYTE).offset_from(dststart as *mut BYTE) as usize\n}\n\n/* `ZSTD_getErrorCode()` is exported by common/zstd_common.c; use the local\n * inline equivalent (ERR_getErrorCode) so this module stays self-contained. */\n#[inline(always)]\nunsafe fn ZSTD_getErrorCode_local(code: usize) -> i32 {\n    ERR_getErrorCode(code)\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn ZSTD_decompress_usingDict(\n    dctx: *mut ZSTD_DCtx,\n    dst: *mut c_void,\n    dstCapacity: usize,\n    src: *const c_void,\n    srcSize: usize,\n    dict: *const c_void,\n    dictSize: usize,\n) -> usize {\n    ZSTD_decompressMultiFrame(\n        dctx,\n        dst,\n        dstCapacity,\n        src,\n        srcSize,\n        dict,\n        dictSize,\n        core::ptr::null(),\n    )\n}\n\nunsafe fn ZSTD_getDDict(dctx: *mut ZSTD_DCtx) -> *const ZSTD_DDict {\n    match (*dctx).dictUses {\n        ZSTD_use_indefinitely => (*dctx).ddict,\n        ZSTD_use_once => {\n            (*dctx).dictUses = ZSTD_dont_use;\n            (*dctx).ddict\n        }\n        _ => {\n            /* ZSTD_dont_use, and the impossible `default` case */\n            ZSTD_clearDict(dctx);\n            core::ptr::null()\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn ZSTD_decompressDCtx(\n    dctx: *mut ZSTD_DCtx,\n    dst: *mut c_void,\n    dstCapacity: usize,\n    src: *const c_void,\n    srcSize: usize,\n) -> usize {\n    ZSTD_decompress_usingDDict(dctx, dst, dstCapacity, src, srcSize, ZSTD_getDDict(dctx))\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn ZSTD_decompress(\n    dst: *mut c_void,\n    dstCapacity: usize,\n    src: *const c_void,\n    srcSize: usize,\n) -> usize {\n    /* ZSTD_HEAPMODE >= 1 */\n    let regenSize: usize;\n    let dctx: *mut ZSTD_DCtx = ZSTD_createDCtx_internal(ZSTD_defaultCMem);\n    if dctx.is_null() {\n        return ERROR(ZSTD_error_memory_allocation);\n    }\n    regenSize = ZSTD_decompressDCtx(dctx, dst, dstCapacity, src, srcSize);\n    ZSTD_freeDCtx(dctx);\n    regenSize\n}\n\n// __END__\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":3,"cache_creation_input_tokens":2690,"cache_read_input_tokens":139752,"cache_creation":{"ephemeral_5m_input_tokens":2690,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_016F7Yq5JjcB2rbtd7fKVh25","session_id":"91081e33-7aae-4a44-80fe-383759459deb","uuid":"cd2dbc82-0916-4bce-b76f-f102fc7a0ecf","timestamp":"2026-08-22T23:04:24.478Z","subagent_type":"general-purpose","task_description":"Translate zstd_decompress"}
