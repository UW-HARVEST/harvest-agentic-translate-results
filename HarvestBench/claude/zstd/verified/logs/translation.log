u8, d as *mut u8, l);\n    }\n}\n\n/// `ZSTD_memmove`\n#[inline(always)]\npub unsafe fn ZSTD_memmove(d: *mut c_void, s: *const c_void, l: size_t) {\n    if l != 0 {\n        core::ptr::copy(s as *const u8, d as *mut u8, l);\n    }\n}\n\n/// `ZSTD_memset`\n#[inline(always)]\npub unsafe fn ZSTD_memset(p: *mut c_void, v: c_int, l: size_t) {\n    if l != 0 {\n        core::ptr::write_bytes(p as *mut u8, v as u8, l);\n    }\n}\n---ERRPRIV---\n7:pub const ZSTD_error_no_error: i32 = 0;\n8:pub const ZSTD_error_GENERIC: i32 = 1;\n9:pub const ZSTD_error_prefix_unknown: i32 = 10;\n10:pub const ZSTD_error_version_unsupported: i32 = 12;\n11:pub const ZSTD_error_frameParameter_unsupported: i32 = 14;\n12:pub const ZSTD_error_frameParameter_windowTooLarge: i32 = 16;\n13:pub const ZSTD_error_corruption_detected: i32 = 20;\n14:pub const ZSTD_error_checksum_wrong: i32 = 22;\n15:pub const ZSTD_error_literals_headerWrong: i32 = 24;\n16:pub const ZSTD_error_dictionary_corrupted: i32 = 30;\n17:pub const ZSTD_error_dictionary_wrong: i32 = 32;\n18:pub const ZSTD_error_dictionaryCreation_failed: i32 = 34;\n19:pub const ZSTD_error_parameter_unsupported: i32 = 40;\n20:pub const ZSTD_error_parameter_combination_unsupported: i32 = 41;\n21:pub const ZSTD_error_parameter_outOfBound: i32 = 42;\n22:pub const ZSTD_error_tableLog_tooLarge: i32 = 44;\n23:pub const ZSTD_error_maxSymbolValue_tooLarge: i32 = 46;\n24:pub const ZSTD_error_maxSymbolValue_tooSmall: i32 = 48;\n25:pub const ZSTD_error_cannotProduce_uncompressedBlock: i32 = 49;\n26:pub const ZSTD_error_stabilityCondition_notRespected: i32 = 50;\n27:pub const ZSTD_error_stage_wrong: i32 = 60;\n28:pub const ZSTD_error_init_missing: i32 = 62;\n29:pub const ZSTD_error_memory_allocation: i32 = 64;\n30:pub const ZSTD_error_workSpace_tooSmall: i32 = 66;\n31:pub const ZSTD_error_dstSize_tooSmall: i32 = 70;\n32:pub const ZSTD_error_srcSize_wrong: i32 = 72;\n33:pub const ZSTD_error_dstBuffer_null: i32 = 74;\n34:pub const ZSTD_error_noForwardProgress_destF