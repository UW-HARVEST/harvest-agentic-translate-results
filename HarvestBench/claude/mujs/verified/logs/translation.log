823\t\n824\t/* C library math predicates */\n825\t#[inline(always)]\n826\tpub fn isnan(x: f64) -> bool {\n827\t    x.is_nan()\n828\t}\n829\t#[inline(always)]\n830\tpub fn isinf(x: f64) -> bool {\n831\t    x.is_infinite()\n832\t}\n833\t#[inline(always)]\n834\tpub fn isfinite(x: f64) -> bool {\n835\t    x.is_finite()\n836\t}\n837\t#[inline(always)]\n838\tpub fn signbit(x: f64) -> bool {\n839\t    x.is_sign_negative()\n840\t}\n841\t\n842\t/* ctype.h (C locale) */\n843\t#[inline(always)]\n844\tpub fn isdigit(c: c_int) -> bool {\n845\t    c >= '0' as c_int && c <= '9' as c_int\n846\t}\n847\t#[inline(always)]\n848\tpub fn isalpha(c: c_int) -> bool {\n849\t    (c >= 'a' as c_int && c <= 'z' as c_int) || (c >= 'A' as c_int && c <= 'Z' as c_int)\n850\t}\n851\t#[inline(always)]\n852\tpub fn isupper(c: c_int) -> bool {\n853\t    c >= 'A' as c_int && c <= 'Z' as c_int\n854\t}\n855\t#[inline(always)]\n856\tpub fn islower(c: c_int) -> bool {\n857\t    c >= 'a' as c_int && c <= 'z' as c_int\n858\t}\n859\t#[inline(always)]\n860\tpub fn isspace(c: c_int) -> bool {\n861\t    c == ' ' as c_int || (c >= 0x09 && c <= 0x0d)\n862\t}\n863\t#[inline(always)]\n864\tpub fn toupper(c: c_int) -> c_int {\n865\t    if islower(c) {\n866\t        c - 32\n867\t    } else {\n868\t        c\n869\t    }\n870\t}\n871\t#[inline(always)]\n872\tpub fn tolower(c: c_int) -> c_int {\n873\t    if isupper(c) {\n874\t        c + 32\n875\t    } else {\n876\t        c\n877\t    }\n878\t}\n879\t\n880\t/* ---------------------------------------------------------------- libc */\n881\t\n882\t#[repr(C)]\n883\tpub struct FILE {\n884\t    _opaque: [u8; 0],\n885\t}\n886\t\n887\t#[repr(C)]\n888\t#[derive(Copy, Clone)]\n889\tpub struct tm {\n890\t    pub tm_sec: c_int,\n891\t    pub tm_min: c_int,\n892\t    pub tm_hour: c_int,\n893\t    pub tm_mday: c_int,\n894\t    pub tm_mon: c_int,\n895\t    pub tm_year: c_int,\n896\t    pub tm_wday: c_int,\n897\t    pub tm_yday: c_int,\n898\t    pub tm_isdst: c_int,\n899\t    pub tm_gmt