51\t                \"movaps %xmm1, 64(%rsp)\",\n52\t                \"movaps %xmm2, 80(%rsp)\",\n53\t                \"movaps %xmm3, 96(%rsp)\",\n54\t                \"movaps %xmm4, 112(%rsp)\",\n55\t                \"movaps %xmm5, 128(%rsp)\",\n56\t                \"movaps %xmm6, 144(%rsp)\",\n57\t                \"movaps %xmm7, 160(%rsp)\",\n58\t                \"91:\",\n59\t                concat!(\"movl $\", $gp, \", 176(%rsp)\"),\n60\t                \"movl $48, 180(%rsp)\",\n61\t                \"leaq 16(%rbp), %rax\",\n62\t                \"movq %rax, 184(%rsp)\",\n63\t                \"movq %rsp, %rax\",\n64\t                \"movq %rax, 192(%rsp)\",\n65\t                \"movq 0(%rsp), %rdi\",\n66\t                \"movq 8(%rsp), %rsi\",\n67\t                \"leaq 176(%rsp), %rdx\",\n68\t                \"xorl %eax, %eax\",\n69\t                concat!(\"call \", stringify!($target), \"@PLT\"),\n70\t                \"movq %rbp, %rsp\",\n71\t                \"pop %rbp\",\n72\t                \"ret\",\n73\t                options(att_syntax)\n74\t            )\n75\t        }\n76\t    };\n77\t    ($name:ident => $target:ident, gp = $gp:expr, nargs = 3) => {\n78\t        #[unsafe(naked)]\n79\t        #[unsafe(no_mangle)]\n80\t        pub unsafe extern \"C\" fn $name() {\n81\t            naked_asm!(\n82\t                \"push %rbp\",\n83\t                \"mov %rsp, %rbp\",\n84\t                \"sub $208, %rsp\",\n85\t                \"movq %rdi, 0(%rsp)\",\n86\t                \"movq %rsi, 8(%rsp)\",\n87\t                \"movq %rdx, 16(%rsp)\",\n88\t                \"movq %rcx, 24(%rsp)\",\n89\t                \"movq %r8, 32(%rsp)\",\n90\t                \"movq %r9, 40(%rsp)\",\n91\t                \"testb %al, %al\",\n92\t                \"je 91f\",\n93\t                \"movaps %xmm0, 48(%rsp)\",\n94\t                \"movaps %xmm1, 64(%rsp)\",\n95\t                \"movaps %xmm2, 80(%rsp)\",\n96\t                \"movaps %xmm3, 96(%rsp)\",\n97\t                \"movaps %xmm4, 112(%rsp)\",\n98\t                \"movaps %xmm5, 128(%rsp)\",\n99\t                \"movaps %xmm6, 144(%rsp)\",\n100\t                \"movaps %xmm7, 160(%rsp)\",\n101\t                \"91:\",\n102\t                concat!(\"movl $\", $gp, \", 176(%rsp)\"),\n103\t                \"movl $48, 180(%rsp)\",\n104\t                \"leaq 16(%rbp), %rax\",\n105\t                \"movq %rax, 184(%rsp)\",\n106\t                \"movq %rsp, %rax\",\n107\t                \"movq %rax, 192(%rsp)\",\n108\t                \"movq 0(%rsp), %rdi\",\n109\t                \"movq 8(%rsp), %rsi\",\n110\t                \"movq 16(%rsp), %rdx\",\n111\t                \"leaq 176(%rsp), %rcx\",\n112\t                \"xorl %eax, %eax\",\n113\t                concat!(\"call \", stringify!($target), \"@PLT\"),\n114\t                \"movq %rbp, %rsp\",\n115\t                \"pop %rbp\",\n116\t                \"ret\",\n117\t                options(att_syntax)\n118\t            )\n119\t        }\n120\t    };\n121\t}\n122\t\n123\tva_trampoline!(js_error => js_error_va, gp = \"16\", nargs = 2);\n124\tva_trampoline!(js_evalerror => js_evalerror_va, gp = \"16\", nargs = 2);\n125\tva_trampoline!(js_rangeerror => js_rangeerror_va, gp = \"16\", nargs = 2);\n126\tva_trampoline!(js_referenceerror => js_referenceerror_va, gp = \"16\", nargs = 2);\n127\tva_trampoline!(js_syntaxerror => js_syntaxerror_va, gp = \"16\", nargs = 2);\n128\tva_trampoline!(js_typeerror => js_typeerror_va, gp = \"16\", nargs = 2);\n129\tva_trampoline!(js_urierror => js_urierror_va, gp = \"16\", nargs = 2);\n130\tva_trampoline!(jsC_error => jsC_error_va, gp = \"24\", nargs = 3);\n131\t\n132\t/* ================================================================ *\n133\t * Formatting macros.\n134\t *\n135\t * C code calls e.g. `js_typeerror(J, \"'%s' is read-only\", name)`.  The Rust\n136\t * translation calls `js_typeerror!(J, c\"'%s' is read-only\".as_ptr(), name)`\n137\t * which formats into a 256 byte buffer exactly like the C implementation\n138\t * (vsnprintf into `char buf[256]`) and then throws.\n139\t * ================================================================ */\n140\t\n141\tmacro_rules! jsfmt256 {\n142\t    ($buf:ident, $($a:expr),*) => {\n143\t        let mut $buf: [c_char; 256] = [0; 256];\n144\t        crate::jsi::snprintf($buf.as_mut_ptr(), 256, $($a),*);\n145\t    };\n146\t}\n147\t\n148\tmacro_rules! js_error {\n149\t    ($J:expr, $($a:expr),*) => {{\n150\t        jsfmt256!(buf__, $($a),*);\n151\t        crate::jserror::js_error_str($J, buf__.as_ptr())\n152\t    }};\n153\t}\n154\tmacro_rules! js_evalerror {\n155\t    ($J:expr, $($a:expr),*) => {{\n156\t        jsfmt256!(buf__, $($a),*);\n157\t        crate::jserror::js_evalerror_str($J, buf__.as_ptr())\n158\t    }};\n159\t}\n160\tmacro_rules! js_rangeerror {\n161\t    ($J:expr, $($a:expr),*) => {{\n162\t        jsfmt256!(buf__, $($a),*);\n163\t        crate::jserror::js_rangeerror_str($J, buf__.as_ptr())\n164\t    }};\n165\t}\n166\tmacro_rules! js_referenceerror {\n167\t    ($J:expr, $($a:expr),*) => {{\n168\t        jsfmt256!(buf__, $($a),*);\n169\t        crate::jserror::js_referenceerror_str($J, buf__.as_ptr())\n170\t    }};\n171\t}\n172\tmacro_rules! js_syntaxerror {\n173\t    ($J:expr, $($a:expr),*) => {{\n174\t        jsfmt256!(buf__, $($a),*);\n175\t        crate::jserror::js_syntaxerror_str($J, buf__.as_ptr())\n176\t    }};\n177\t}\n178\tmacro_rules! js_typeerror {\n179\t    ($J:expr, $($a:expr),*) => {{\n180\t        jsfmt256!(buf__, $($a),*);\n181\t        crate::jserror::js_typeerror_str($J, buf__.as_ptr())\n182\t    }};\n183\t}\n184\tmacro_rules! js_urierror {\n185\t    ($J:expr, $($a:expr),*) => {{\n186\t        jsfmt256!(buf__, $($a),*);\n187\t        crate::jserror::js_urierror_str($J, buf__.as_ptr())\n188\t    }};\n189\t}\n190\tmacro_rules! jsC_error {\n191\t    ($J:expr, $node:expr, $($a:expr),*) => {{\n192\t        jsfmt256!(buf__, $($a),*);\n193\t        crate::jscompile::jsC_error_str($J, $node, buf__.as_ptr())\n194\t    }};\n195\t}\n196\t\n197\t\n198\t/// `setjmp(js_savetry(J))`\n199\tmacro_rules! js_try {\n200\t    ($J:expr) => {\n201\t        crate::jsi::_setjmp(crate::jsrun::js_savetry($J) as *mut crate::jsi::jmp_buf) != 0\n202\t    };\n203\t}\n204\t\n205\t/// `setjmp(js_savetrypc(J, PC))`\n206\tmacro_rules! js_trypc {\n207\t    ($J:expr, $pc:expr) => {\n208\t        crate::jsi::_setjmp(crate::jsrun::js_savetrypc($J, $pc) as *mut crate::jsi::jmp_buf) != 0\n209\t    };\n210\t}\n211\t\n212\t/* ================================================================ *\n213\t * Modules -- one per C source file.\n214\t * ================================================================ */\n215\t\n216\tpub mod jsarray;\n217\tpub mod jsboolean;\n218\tpub mod jsbuiltin;\n219\tpub mod jscompile;\n220\tpub mod jsdate;\n221\tpub mod jsdtoa;\n222\tpub mod jserror;\n223\tpub mod jsfunction;\n224\tpub mod jsgc;\n225\tpub mod jsintern;\n226\tpub mod jslex;\n227\tpub mod jsmath;\n228\tpub mod jsnumber;\n229\tpub mod jsobject;\n230\tpub mod json;\n231\tpub mod jsparse;\n232\tpub mod jsproperty;\n233\tpub mod jsregexp;\n234\tpub mod jsrepr;\n235\tpub mod jsrun;\n236\tpub mod jsstate;\n237\tpub mod jsstring;\n238\tpub mod jsvalue;\n239\tpub mod regexp;\n240\tpub mod utf;\n241\tpub mod utfdata;\n242\t\n243\t/// Everything that is a non-static function in the C sources, flattened into\n244\t/// one namespace so that translated modules can call each other exactly the\n245\t/// way the C code does.\n246\tpub mod prelude {\n247\t    pub use crate::jsarray::*;\n248\t    pub use crate::jsboolean::*;\n249\t    pub use crate::jsbuiltin::*;\n250\t    pub use crate::jscompile::*;\n251\t    pub use crate::jsdate::*;\n252\t    pub use crate::jsdtoa::*;\n253\t    pub use crate::jserror::*;\n254\t    pub use crate::jsfunction::*;\n255\t    pub use crate::jsgc::*;\n256\t    pub use crate::jsintern::*;\n257\t    pub use crate::jslex::*;\n258\t    pub use crate::jsmath::*;\n259\t    pub use crate::jsnumber::*;\n260\t    pub use crate::jsobject::*;\n261\t    pub use crate::json::*;\n262\t    pub use crate::jsparse::*;\n263\t    pub use crate::jsproperty::*;\n264\t    pub use crate::jsregexp::*;\n265\t    pub use crate::jsrepr::*;\n266\t    pub use crate::jsrun::*;\n267\t    pub use crate::jsstate::*;\n268\t    pub use crate::jsstring::*;\n269\t    pub use crate::jsvalue::*;\n270\t    pub use crate::regexp::*;\n271\t    pub use crate::utf::*;\n272\t    pub use crate::utfdata::*;\n273\t}\n274\t\n275\t/* TEMPORARY layout verification */\n276\t#[unsafe(no_mangle)]\n277\tpub unsafe extern \"C\" fn mujs_layout_dump() {\n278\t    use std::mem::{offset_of, size_of};\n279\t    macro_rules! p { ($t:ty, $($f:tt)+) => {\n280\t        printf(c\"%-28s %4d  size %4d\\n\".as_ptr(),\n281\t            concat!(stringify!($t), \".\", stringify!($($f)+), \"\\0\").as_ptr(),\n282\t            offset_of!($t, $($f)+) as c_int, size_of::<$t>() as c_int);\n283\t    } }\n284\t    p!(js_Value, t.r#type); p!(js_String, p); p!(js_Buffer, s); p!(js_Property, name);\n285\t    p!(js_Iterator, name);\n286\t    p!(js_Object, u); p!(js_Object, gcnext); p!(js_Object, gcroot); p!(js_Object, gcmark);\n287\t    p!(js_Object, count); p!(js_Object, prototype);\n288\t    printf(c\"sizeof js_ObjectU %d\\n\".as_ptr(), size_of::<js_ObjectU>() as c_int);\n289\t    p!(js_Environment, gcmark); p!(js_Function, gcmark); p!(js_Ast, gcnext);\n290\t    p!(js_Jumpbuf, E); p!(js_Jumpbuf, pc);\n291\t    printf(c\"sizeof js_Jumpbuf %d\\n\".as_ptr(), size_of::<js_Jumpbuf>() as c_int);\n292\t    p!(js_State, trybuf); p!(js_State, trace); p!(js_State, envstack); p!(js_State, stack);\n293\t    p!(js_State, scratch); p!(js_State, lexbuf); p!(js_State, gcast);\n294\t    printf(c\"sizeof js_State %d\\n\".as_ptr(), size_of::<js_State>() as c_int);\n295\t    printf(c\"sizeof Resub %d nsub off %d sub off %d\\n\".as_ptr(), size_of::<Resub>() as c_int,\n296\t        offset_of!(Resub, nsub) as c_int, offset_of!(Resub, sub) as c_int);\n297\t    printf(c\"sizeof js_StackTrace %d\\n\".as_ptr(), size_of::<js_StackTrace>() as c_int);\n298\t    printf(c\"sizeof js_Value %d\\n\".as_ptr(), size_of::<js_Value>() as c_int);\n299\t    printf(c\"sizeof js_Property %d\\n\".as_ptr(), size_of::<js_Property>() as c_int);\n300\t    printf(c\"sizeof js_Function %d\\n\".as_ptr(), size_of::<js_Function>() as c_int);\n301\t    printf(c\"sizeof js_Ast %d\\n\".as_ptr(), size_of::<js_Ast>() as c_int);\n302\t    printf(c\"sizeof js_StringNode %d string off %d\\n\".as_ptr(), size_of::<js_StringNode>() as c_int,\n303\t        offset_of!(js_StringNode, string) as c_int);\n304\t}\n305\t"}]},"parent_tool_use_id":"toolu_bdrk_01XvEL9qmkPcsaVbxxjd7HEu","session_id":"6e63ba36-2d65-497f-a5b2-8fd6eb67db8b","uuid":"5acfdd5f-fcb4-4e05-83cc-dd2ef7ddf5d5","timestamp":"2026-08-22T21:37:34.932Z","subagent_type":"general-purpose","task_description":"Translate json.c and jsrepr.c"}
