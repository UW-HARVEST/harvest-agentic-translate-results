{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GW43Q3cuANzaNqgsF5WJ2y","type":"tool_result","content":"1\t//! Translated from c_src/src/jserror.c\n2\tuse crate::jsi::*;\n3\tuse crate::prelude::*;\n4\t\n5\tunsafe fn jsB_stacktrace(J: *mut js_State, skip: c_int) -> c_int {\n6\t    let mut buf: [c_char; 256] = [0; 256];\n7\t    let mut n: c_int = (*J).tracetop - skip;\n8\t    if n <= 0 {\n9\t        return 0;\n10\t    }\n11\t    while n > 0 {\n12\t        let name = (*J).trace[n as usize].name;\n13\t        let file = (*J).trace[n as usize].file;\n14\t        let line = (*J).trace[n as usize].line;\n15\t        if line > 0 {\n16\t            if *name != 0 {\n17\t                snprintf(\n18\t                    buf.as_mut_ptr(),\n19\t                    256,\n20\t                    c\"\\n\\tat %s (%s:%d)\".as_ptr(),\n21\t                    name,\n22\t                    file,\n23\t                    line,\n24\t                );\n25\t            } else {\n26\t                snprintf(buf.as_mut_ptr(), 256, c\"\\n\\tat %s:%d\".as_ptr(), file, line);\n27\t            }\n28\t        } else {\n29\t            snprintf(buf.as_mut_ptr(), 256, c\"\\n\\tat %s (%s)\".as_ptr(), name, file);\n30\t        }\n31\t        js_pushstring(J, buf.as_ptr());\n32\t        if n < (*J).tracetop - skip {\n33\t            js_concat(J);\n34\t        }\n35\t        n -= 1;\n36\t    }\n37\t    1\n38\t}\n39\t\n40\tunsafe extern \"C\" fn Ep_toString(J: *mut js_State) {\n41\t    let mut name: *const c_char = c\"Error\".as_ptr();\n42\t    let mut message: *const c_char = c\"\".as_ptr();\n43\t\n44\t    if js_isobject(J, -1) == 0 {\n45\t        js_typeerror!(J, c\"not an object\".as_ptr());\n46\t    }\n47\t\n48\t    if js_hasproperty(J, 0, c\"name\".as_ptr()) != 0 {\n49\t        name = js_tostring(J, -1);\n50\t    }\n51\t    if js_hasproperty(J, 0, c\"message\".as_ptr()) != 0 {\n52\t        message = js_tostring(J, -1);\n53\t    }\n54\t\n55\t    if *name == 0 {\n56\t        js_pushstring(J, message);\n57\t    } else if *message == 0 {\n58\t        js_pushstring(J, name);\n59\t    } else {\n60\t        js_pushstring(J, name);\n61\t        js_pushstring(J, c\": \".as_ptr());\n62\t        js_concat(J);\n63\t        js_pushstring(J, message);\n64\t        js_concat(J);\n65\t    }\n66\t}\n67\t\n68\tunsafe extern \"C\" fn Ep_get_stack(J: *mut js_State) {\n69\t    Ep_toString(J);\n70\t    js_getproperty(J, 0, c\"stackTrace\".as_ptr());\n71\t    js_concat(J);\n72\t}\n73\t\n74\tunsafe fn jsB_ErrorX(J: *mut js_State, prototype: *mut js_Object) -> c_int {\n75\t    js_pushobject(J, jsV_newobject(J, JS_CERROR, prototype));\n76\t    if js_isdefined(J, 1) != 0 {\n77\t        js_pushstring(J, js_tostring(J, 1));\n78\t        js_defproperty(J, -2, c\"message\".as_ptr(), JS_DONTENUM);\n79\t    }\n80\t    if jsB_stacktrace(J, 1) != 0 {\n81\t        js_defproperty(J, -2, c\"stackTrace\".as_ptr(), JS_DONTENUM);\n82\t    }\n83\t    1\n84\t}\n85\t\n86\tunsafe fn js_newerrorx(J: *mut js_State, message: *const c_char, prototype: *mut js_Object) {\n87\t    js_pushobject(J, jsV_newobject(J, JS_CERROR, prototype));\n88\t    js_pushstring(J, message);\n89\t    js_setproperty(J, -2, c\"message\".as_ptr());\n90\t    if jsB_stacktrace(J, 0) != 0 {\n91\t        js_setproperty(J, -2, c\"stackTrace\".as_ptr());\n92\t    }\n93\t}\n94\t\n95\tmacro_rules! DERROR {\n96\t    ($jsB:ident, $new:ident, $str:ident, $va:ident, $proto:ident) => {\n97\t        unsafe extern \"C\" fn $jsB(J: *mut js_State) {\n98\t            jsB_ErrorX(J, (*J).$proto);\n99\t        }\n100\t        #[unsafe(no_mangle)]\n101\t        pub unsafe extern \"C\" fn $new(J: *mut js_State, s: *const c_char) {\n102\t            js_newerrorx(J, s, (*J).$proto);\n103\t        }\n104\t        /// `js_xxxerror(J, message)` -- the non-variadic core.\n105\t        pub unsafe fn $str(J: *mut js_State, buf: *const c_char) -> ! {\n106\t            js_newerrorx(J, buf, (*J).$proto);\n107\t            js_throw