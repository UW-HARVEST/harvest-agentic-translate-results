paque to most modules; defined in jsintern.rs / regexp.rs */\n717\t#[repr(C)]\n718\tpub struct js_StringNode {\n719\t    pub left: *mut js_StringNode,\n720\t    pub right: *mut js_StringNode,\n721\t    pub level: c_int,\n722\t    pub string: [c_char; 1],\n723\t}\n724\t\n725\t/* Resub for regexp.c public API */\n726\t#[derive(Copy, Clone)]\n727\t#[repr(C)]\n728\tpub struct Resub_sub {\n729\t    pub sp: *const c_char,\n730\t    pub ep: *const c_char,\n731\t}\n732\t\n733\t#[repr(C)]\n734\tpub struct Resub {\n735\t    pub nsub: c_int,\n736\t    pub sub: [Resub_sub; REG_MAXSUB],\n737\t}\n738\t\n739\t/* ---------------------------------------------------------------- offsets */\n740\t\n741\tpub const SOFFSETOF_JS_VALUE_TYPE: c_int = 15; /* soffsetof(js_Value, t.type) */\n742\tpub const SOFFSETOF_JS_STRING_P: c_int = 9; /* soffsetof(js_String, p) */\n743\tpub const SOFFSETOF_JS_BUFFER_S: c_int = 8; /* soffsetof(js_Buffer, s) */\n744\tpub const SOFFSETOF_JS_PROPERTY_NAME: c_int = 56; /* soffsetof(js_Property, name) */\n745\tpub const SOFFSETOF_JS_ITERATOR_NAME: c_int = 8; /* soffsetof(js_Iterator, name) */\n746\tpub const SOFFSETOF_JS_STRINGNODE_STRING: c_int = 20; /* soffsetof(js_StringNode, string) */\n747\t\n748\t/* ---------------------------------------------------------------- helpers */\n749\t\n750\t/// Pointer to the flexible char array of a js_String.\n751\t#[inline(always)]\n752\tpub unsafe fn js_String_p(s: *mut js_String) -> *mut c_char {\n753\t    std::ptr::addr_of_mut!((*s).p) as *mut c_char\n754\t}\n755\t\n756\t/// Pointer to the flexible char array of a js_Property.\n757\t#[inline(always)]\n758\tpub unsafe fn js_Property_name(p: *mut js_Property) -> *mut c_char {\n759\t    std::ptr::addr_of_mut!((*p).name) as *mut c_char\n760\t}\n761\t\n762\t/// Pointer to the flexible char array of a js_Iterator.\n763\t#[inline(always)]\n764\tpub unsafe fn js_Iterator_name(p: *mut js_Iterator) -> *mut c_char {\n765\t    std::ptr::addr_of_mut!((*p).name) as *mut c_char\n766\t}\n767\t\n768\t/// Pointer to the flexible char array of a js_StringNode.\n769\t#[inline(always)]\n770\tpub unsafe fn js_StringNode_string(p: *mut js_StringNode) -> *mut c_char {\n771\t    std::ptr::addr_of_mut!((*p).string) as *mut c_char\n772\t}\n773\t\n774\t/// Pointer to the (growable) char array of a js_Buffer.\n775\t#[inline(always)]\n776\tpub unsafe fn js_Buffer_s(p: *mut js_Buffer) -> *mut c_char {\n777\t    std::ptr::addr_of_mut!((*p).s) as *mut c_char\n778\t}\n779\t\n780\t/// Pointer to the short string storage of a js_Value.\n781\t#[inline(always)]\n782\tpub unsafe fn js_Value_shrstr(v: *mut js_Value) -> *mut c_char {\n783\t    std::ptr::addr_of_mut!((*v).u.shrstr) as *mut c_char\n784\t}\n785\t\n786\t/// Pointer to the short string storage of a js_Object (JS_CSTRING).\n787\t#[inline(always)]\n788\tpub unsafe fn js_Object_shrstr(v: *mut js_Object) -> *mut c_char {\n789\t    std::ptr::addr_of_mut!((*v).u.s.shrstr) as *mut c_char\n790\t}\n791\t\n792\t/// JSV_ISSTRING(v)\n793\t#[inline(always)]\n794\tpub unsafe fn JSV_ISSTRING(v: *const js_Value) -> bool {\n795\t    let t = (*v).t.r#type;\n796\t    t == JS_TSHRSTR || t == JS_TMEMSTR || t == JS_TLITSTR\n797\t}\n798\t\n799\t/// JSV_TOSTRING(v)\n800\t#[inline(always)]\n801\tpub unsafe fn JSV_TOSTRING(v: *const js_Value) -> *const c_char {\n802\t    let t = (*v).t.r#type;\n803\t    if t == JS_TSHRSTR {\n804\t        std::ptr::addr_of!((*v).u.shrstr) as *const c_char\n805\t    } else if t == JS_TLITSTR {\n806\t        (*v).u.litstr\n807\t    } else if t == JS_TMEMSTR {\n808\t        js_String_p((*v).u.memstr)\n809\t    } else {\n810\t        c\"\".as_ptr()\n811\t    }\n812\t}\n813\t\n814\t/* volatile access, for locals that must survive longjmp (C's `volatile`) */\n815\t#[inline(always)]\n816\tpub unsafe fn vread<T: Copy>(p: *const T) -> T {\n817\t    std::ptr::read_volatile(p)\n818\t}\n819\t#[inline(always)]\n820\tpub unsafe fn vwrite<T: Copy>(p: *mut T, v: T) {\n821\t    std::ptr::write_volatile(p, v)\n822\t}\n823\t\n824\t/* C library math predicates */\n825\t#[inline(always)]\n826\tpub fn isnan(x: f64) -> bool {\n827\t    x.is_nan()\n828\t}\n829\t#[inline(always)]\n830\tpub fn isinf(x: f64) -> bool {\n831\t    x.is_infinite()\n832\t}\n833\t#[inline(always)]\n834\tpub fn isfinite(x: f64) -> bool {\n835\t    x.is_finite()\n836\t}\n837\t#[inline(always)]\n838\tpub fn signbit(x: f64) -> bool {\n839\t    x.is_sign_negative()\n840\t}\n841\t\n842\t/* ctype.h (C locale) */\n843\t#[inline(always)]\n844\tpub fn isdigit(c: c_int) -> bool {\n845\t    c >= '0' as c_int && c <= '9' as c_int\n846\t}\n847\t#[inline(always)]\n848\tpub fn isalpha(c: c_int) -> bool {\n849\t    (c >= 'a' as c_int && c <= 'z' as c_int) || (c >= 'A' as c_int && c <= 'Z' as c_int)\n850\t}\n851\t#[inline(always)]\n852\tpub fn isupper(c: c_int) -> bool {\n853\t    c >= 'A' as c_int && c <= 'Z' as c_int\n854\t}\n855\t#[inline(always)]\n856\tpub fn islower(c: c_int) -> bool {\n857\t    c >= 'a' as c_int && c <= 'z' as c_int\n858\t}\n859\t#[inline(always)]\n860\tpub fn isspace(c: c_int) -> bool {\n861\t    c == ' ' as c_int || (c >= 0x09 && c <= 0x0d)\n862\t}\n863\t#[inline(always)]\n864\tpub fn toupper(c: c_int) -> c_int {\n865\t    if islower(c) {\n866\t        c - 32\n867\t    } else {\n868\t        c\n869\t    }\n870\t}\n871\t#[inline(always)]\n872\tpub fn tolower(c: c_int) -> c_int {\n873\t    if isupper(c) {\n874\t        c + 32\n875\t    } else {\n876\t        c\n877\t    }\n878\t}\n879\t\n880\t/* ---------------------------------------------------------------- libc */\n881\t\n882\t#[repr(C)]\n883\tpub struct FILE {\n884\t    _opaque: [u8; 0],\n885\t}\n886\t\n887\t#[repr(C)]\n888\t#[derive(Copy, Clone)]\n889\tpub struct tm {\n890\t    pub tm_sec: c_int,\n891\t    pub tm_min: c_int,\n892\t    pub tm_hour: c_int,\n893\t    pub tm_mday: c_int,\n894\t    pub tm_mon: c_int,\n895\t    pub tm_year: c_int,\n896\t    pub tm_wday: c_int,\n897\t    pub tm_yday: c_int,\n898\t    pub tm_isdst: c_int,\n899\t    pub tm_gmt