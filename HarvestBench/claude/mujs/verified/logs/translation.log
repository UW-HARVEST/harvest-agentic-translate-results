{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DxpD49jjPPSxrE4hwtpDHb","type":"tool_result","content":"1\t//! Shared types, constants and the exception mechanism for the MuJS port.\n2\t//! Mirrors mujs.h / jsi.h.\n3\t#![allow(non_camel_case_types, non_snake_case, non_upper_case_globals, dead_code)]\n4\t\n5\tuse std::os::raw::{c_char, c_int, c_uint, c_ushort, c_void};\n6\t\n7\tpub type Rune = c_int;\n8\tpub const EOF: c_int = -1;\n9\t\n10\t/* Limits */\n11\tpub const JS_STACKSIZE: usize = 4096;\n12\tpub const JS_ENVLIMIT: usize = 1024;\n13\tpub const JS_TRYLIMIT: usize = 64;\n14\tpub const JS_ARRAYLIMIT: c_int = 1 << 26;\n15\tpub const JS_GCFACTOR: f64 = 5.0;\n16\tpub const JS_ASTLIMIT: c_int = 400;\n17\tpub const JS_STRLIMIT: c_int = 1 << 28;\n18\t\n19\t/* mujs.h state flags */\n20\tpub const JS_STRICT: c_int = 1;\n21\t\n22\t/* RegExp flags */\n23\tpub const JS_REGEXP_G: c_int = 1;\n24\tpub const JS_REGEXP_I: c_int = 2;\n25\tpub const JS_REGEXP_M: c_int = 4;\n26\t\n27\t/* Property attribute flags */\n28\tpub const JS_READONLY: c_int = 1;\n29\tpub const JS_DONTENUM: c_int = 2;\n30\tpub const JS_DONTCONF: c_int = 4;\n31\t\n32\t/* js_type() */\n33\tpub const JS_ISUNDEFINED: c_int = 0;\n34\tpub const JS_ISNULL: c_int = 1;\n35\tpub const JS_ISBOOLEAN: c_int = 2;\n36\tpub const JS_ISNUMBER: c_int = 3;\n37\tpub const JS_ISSTRING: c_int = 4;\n38\tpub const JS_ISFUNCTION: c_int = 5;\n39\tpub const JS_ISOBJECT: c_int = 6;\n40\t\n41\t/* ToPrimitive hint */\n42\tpub const JS_HNONE: c_int = 0;\n43\tpub const JS_HNUMBER: c_int = 1;\n44\tpub const JS_HSTRING: c_int = 2;\n45\t\n46\t/* enum js_Type (stored in the value type tag byte) */\n47\tpub const JS_TSHRSTR: c_char = 0;\n48\tpub const JS_TUNDEFINED: c_char = 1;\n49\tpub const JS_TNULL: c_char = 2;\n50\tpub const JS_TBOOLEAN: c_char = 3;\n51\tpub const JS_TNUMBER: c_char = 4;\n52\tpub const JS_TLITSTR: c_char = 5;\n53\tpub const JS_TMEMSTR: c_char = 6;\n54\tpub const JS_TOBJECT: c_char = 7;\n55\t\n56\t/* enum js_Class (stored in js_Object.type as int) */\n57\tpub const JS_COBJECT: c_int = 0;\n58\tpub const JS_CARRAY: c_int = 1;\n59\tpub const JS_CFUNCTION: c_int = 2;\n60\tpub const JS_CSCRIPT: c_int = 3;\n61\tpub const JS_CCFUNCTION: c_int = 4;\n62\tpub const JS_CERROR: c_int = 5;\n63\tpub const JS_CBOOLEAN: c_int = 6;\n64\tpub const JS_CNUMBER: c_int = 7;\n65\tpub const JS_CSTRING: c_int = 8;\n66\tpub const JS_CREGEXP: c_int = 9;\n67\tpub const JS_CDATE: c_int = 10;\n68\tpub const JS_CMATH: c_int = 11;\n69\tpub const JS_CJSON: c_int = 12;\n70\tpub const JS_CARGUMENTS: c_int = 13;\n71\tpub const JS_CITERATOR: c_int = 14;\n72\tpub const JS_CUSERDATA: c_int = 15;\n73\t\n74\t/* Instruction size */\n75\tpub type js_Instruction = c_ushort;\n76\t\n77\t/* Callback function pointer types (nullable) */\n78\tpub type js_Alloc =\n79\t    Option<unsafe extern \"C-unwind\" fn(memctx: *mut c_void, ptr: *mut c_void, size: c_int) -> *mut c_void>;\n80\tpub type js_Panic = Option<unsafe extern \"C-unwind\" fn(J: *mut js_State)>;\n81\tpub type js_CFunction = Option<unsafe extern \"C-unwind\" fn(J: *mut js_State)>;\n82\tpub type js_Finalize = Option<unsafe extern \"C-unwind\" fn(J: *mut js_State, p: *mut c_void)>;\n83\tpub type js_HasProperty =\n84\t    Option<unsafe extern \"C-unwind\" fn(J: *mut js_State, p: *mut c_void, name: *const c_char) -> c_int>;\n85\tpub type js_Put =\n86\t    Option<unsafe extern \"C-unwind\" fn(J: *mut js_State, p: *mut c_void, name: *const c_char) -> c_int>;\n87\tpub type js_Delete =\n88\t    Option<unsafe extern \"C-unwind\" fn(J: *mut js_State, p: *mut c_void, name: *const c_char) -> c_int>;\n89\tpub type js_Report = Option<unsafe extern \"C-unwind\" fn(J: *mut js_State, message: *const c_char)>;\n90\t\n91\t/* Value: a 16-byte union with the type tag in the last byte */\n92\t#[repr(C)]\n93\t#[derive(Copy, Clone)]\n94\tpub union js_Value {\n95\t    pub t: JsValueT,\n96\t    pub u: JsValueU,\n97\t}\n98\t\n99\t#[repr(C)]\n100\t#[derive(Copy, Clone)]\n101\tpub struct JsValueT {\n102\t    pub pad: [c_char; 15],\n103\t    pub type_: c_char,\n104\t}\n105\t\n106\t#[repr(C)]\n107\t#[derive(Copy, Clone)]\n108\tpub union JsValueU {\n109\t    pub shrstr: [c_char; 16],\n110\t    pub boolean: c_int,\n111\t    pub number: f64,\n112\t    pub litstr: *const c_char,\n113\t    pub memstr: *mut js_String,\n114\t    pub object: *mut js_Object,\n115\t}\n116\t\n117\timpl js_Value {\n118\t    #[inline]\n119\t    pub fn zeroed() -> js_Value {\n120\t        unsafe { std::mem::zeroed() }\n121\t    }\n122\t    #[inline]\n123\t    pub fn type_(&self) -> c_char {\n124\t        unsafe { self.t.type_ }\n125\t    }\n126\t    #[inline]\n127\t    pub fn set_type(&mut self, t: c_char) {\n128\t        self.t.type_ = t;\n129\t    }\n130\t}\n131\t\n132\t#[repr(C)]\n133\tpub struct js_String {\n134\t    pub gcnext: *mut js_String,\n135\t    pub gcmark: c_char,\n136\t    pub p: [c_char; 1], // flexible array member\n137\t}\n138\t\n139\t#[repr(C)]\n140\t#[derive(Copy, Clone)]\n141\tpub struct js_Regexp {\n142\t    pub prog: *mut c_void,\n143\t    pub source: *mut c_char,\n144\t    pub flags: c_ushort,\n145\t    pub last: c_ushort,\n146\t}\n147\t\n148\t#[repr(C)]\n149\t#[derive(Copy, Clone)]\n150\tpub struct ObjS {\n151\t    pub length: c_int,\n152\t    pub string: *mut c_char,\n153\t    pub shrstr: [c_char; 16],\n154\t}\n155\t\n156\t#[repr(C)]\n157\t#[derive(Copy, Clone)]\n158\tpub struct ObjA {\n159\t    pub length: c_int,\n160\t    pub simple: c_int,\n161\t    pub flat_length: c_int,\n162\t    pub flat_capacity: c_int,\n163\t    pub array: *mut js_Value,\n164\t}\n165\t\n166\t#[repr(C)]\n167\t#[derive(Copy, Clone)]\n168\tpub struct ObjF {\n169\t    pub function: *mut js_Function,\n170\t    pub scope: *mut js_Environment,\n171\t}\n172\t\n173\t#[repr(C)]\n174\t#[derive(Copy, Clone)]\n175\tpub struct ObjC {\n176\t    pub name: *const c_char,\n177\t    pub function: js_CFunction,\n178\t    pub constructor: js_CFunction,\n179\t    pub length: c_int,\n180\t    pub data: *mut c_void,\n181\t    pub finalize: js_Finalize,\n182\t}\n183\t\n184\t#[repr(C)]\n185\t#[derive(Copy, Clone)]\n186\tpub struct ObjIter {\n187\t    pub target: *mut js_Object,\n188\t    pub i: c_int,\n189\t    pub n: c_int,\n190\t    pub head: *mut js_Iterator,\n191\t    pub current: *mut js_Iterator,\n192\t}\n193\t\n194\t#[repr(C)]\n195\t#[derive(Copy, Clone)]\n196\tpub struct ObjUser {\n197\t    pub tag: *const c_char,\n198\t    pub data: *mut c_void,\n199\t    pub has: js_HasProperty,\n200\t    pub put: js_Put,\n201\t    pub delete: js_Delete,\n202\t    pub finalize: js_Finalize,\n203\t}\n204\t\n205\t#[repr(C)]\n206\t#[derive(Copy, Clone)]\n207\tpub union ObjU {\n208\t    pub boolean: c_int,\n209\t    pub number: f64,\n210\t    pub s: ObjS,\n211\t    pub a: ObjA,\n212\t    pub f: ObjF,\n213\t    pub c: ObjC,\n214\t    pub r: js_Regexp,\n215\t    pub iter: ObjIter,\n216\t    pub user: ObjUser,\n217\t}\n218\t\n219\t#[repr(C)]\n220\tpub struct js_Object {\n221\t    pub type_: c_int, // enum js_Class\n222\t    pub extensible: c_int,\n223\t    pub properties: *mut js_Property,\n224\t    pub count: c_int,\n225\t    pub prototype: *mut js_Object,\n226\t    pub u: ObjU,\n227\t    pub gcnext: *mut js_Object,\n228\t    pub gcroot: *mut js_Object,\n229\t    pub gcmark: c_int,\n230\t}\n231\t\n232\t#[repr(C)]\n233\tpub struct js_Property {\n234\t    pub left: *mut js_Property,\n235\t    pub right: *mut js_Property,\n236\t    pub level: c_int,\n237\t    pub atts: c_int,\n238\t    pub value: js_Value,\n239\t    pub getter: *mut js_Object,\n240\t    pub setter: *mut js_Object,\n241\t    pub name: [c_char; 1], // flexible array member\n242\t}\n243\t\n244\t#[repr(C)]\n245\tpub struct js_Iterator {\n246\t    pub next: *mut js_Iterator,\n247\t    pub name: [c_char; 1], // flexible array member\n248\t}\n249\t\n250\t#[repr(C)]\n251\tpub struct js_Environment {\n252\t    pub outer: *mut js_Environment,\n253\t    pub variables: *mut js_Object,\n254\t    pub gcnext: *mut js_Environment,\n255\t    pub gcmark: c_int,\n256\t}\n257\t\n258\t#[repr(C)]\n259\tpub struct js_StringNode {\n260\t    pub left: *mut js_StringNode,\n261\t    pub right: *mut js_StringNode,\n262\t    pub level: c_int,\n263\t    pub string: [c_char; 1], // flexible array member\n264\t}\n265\t\n266\t#[repr(C)]\n267\t#[derive(Copy, Clone)]\n268\tpub struct js_StackTrace {\n269\t    pub name: *const c_char,\n270\t    pub file: *const c_char,\n271\t    pub line: c_int,\n272\t    pub stack: c_int,\n273\t}\n274\t\n275\timpl js_StackTrace {\n276\t    pub const fn zeroed() -> js_StackTrace {\n277\t        js_StackTrace { name: std::ptr::null(), file: std::ptr::null(), line: 0, stack: 0 }\n278\t    }\n279\t}\n280\t\n281\t/// Exception handling record. `buf` is only present for C-ABI compatibility\n282\t/// with the public `js_savetry` interface; internally we use panic/unwind.\n283\t#[repr(C)]\n284\t#[derive(Copy, Clone)]\n285\tpub struct js_Jumpbuf {\n286\t    pub buf: [u8; 512], // jmp_buf placeholder (real jmp_buf is ~200 bytes)\n287\t    pub E: *mut js_Environment,\n288\t    pub envtop: c_int,\n289\t    pub tracetop: c_int,\n290\t    pub top: c_int,\n291\t    pub bot: c_int,\n292\t    pub strict: c_int,\n293\t    pub pc: *mut js_Instruction,\n294\t}\n295\t\n296\timpl js_Jumpbuf {\n297\t    pub fn zeroed() -> js_Jumpbuf {\n298\t        js_Jumpbuf {\n299\t            buf: [0u8; 512],\n300\t            E: std::ptr::null_mut(),\n301\t            envtop: 0,\n302\t            tracetop: 0,\n303\t            top: 0,\n304\t            bot: 0,\n305\t            strict: 0,\n306\t            pc: std::ptr::null_mut(),\n307\t        }\n308\t    }\n309\t}\n310\t\n311\t/* String buffer */\n312\t#[repr(C)]\n313\tpub struct js_Buffer {\n314\t    pub n: c_int,\n315\t    pub m: c_int,\n316\t    pub s: [c_char; 64],\n317\t}\n318\t\n319\t/* Function (bytecode) */\n320\t#[repr(C)]\n321\tpub struct js_Function {\n322\t    pub name: *const c_char,\n323\t    pub script: c_int,\n324\t    pub lightweight: c_int,\n325\t    pub strict: c_int,\n326\t    pub arguments: c_int,\n327\t    pub numparams: c_int,\n328\t\n329\t    pub code: *mut js_Instruction,\n330\t    pub codecap: c_int,\n331\t    pub codelen: c_int,\n332\t\n333\t    pub funtab: *mut *mut js_Function,\n334\t    pub funcap: c_int,\n335\t    pub funlen: c_int,\n336\t\n337\t    pub vartab: *mut *const c_char,\n338\t    pub varcap: c_int,\n339\t    pub varlen: c_int,\n340\t\n341\t    pub filename: *const c_char,\n342\t    pub line: c_int,\n343\t    pub lastline: c_int,\n344\t\n345\t    pub gcnext: *mut js_Function,\n346\t    pub gcmark: c_int,\n347\t}\n348\t\n349\t/* AST */\n350\t#[repr(C)]\n351\tpub struct js_JumpList {\n352\t    pub type_: c_int, // enum js_AstType\n353\t    pub inst: c_int,\n354\t    pub next: *mut js_JumpList,\n355\t}\n356\t\n357\t#[repr(C)]\n358\tpub struct js_Ast {\n359\t    pub type_: c_int, // enum js_AstType\n360\t    pub line: c_int,\n361\t    pub parent: *mut js_Ast,\n362\t    pub a: *mut js_Ast,\n363\t    pub b: *mut js_Ast,\n364\t    pub c: *mut js_Ast,\n365\t    pub d: *mut js_Ast,\n366\t    pub number: f64,\n367\t    pub string: *const c_char,\n368\t    pub jumps: *mut js_JumpList,\n369\t    pub casejump: c_int,\n370\t    pub gcnext: *mut js_Ast,\n371\t}\n372\t\n373\t/* Lexer buffer sub-struct */\n374\t#[repr(C)]\n375\tpub struct LexBuf {\n376\t    pub text: *mut c_char,\n377\t    pub len: c_int,\n378\t    pub cap: c_int,\n379\t}\n380\t\n381\t/* The interpreter state */\n382\t#[repr(C)]\n383\tpub struct js_State {\n384\t    pub actx: *mut c_void,\n385\t    pub uctx: *mut c_void,\n386\t    pub alloc: js_Alloc,\n387\t    pub report: js_Report,\n388\t    pub panic: js_Panic,\n389\t\n390\t    pub strings: *mut js_StringNode,\n391\t\n392\t    pub default_strict: c_int,\n393\t    pub strict: c_int,\n394\t\n395\t    pub filename: *const c_char,\n396\t    pub source: *const c_char,\n397\t    pub line: c_int,\n398\t\n399\t    pub lexbuf: LexBuf,\n400\t    pub lexline: c_int,\n401\t    pub lexchar: c_int,\n402\t    pub lasttoken: c_int,\n403\t    pub newline: c_int,\n404\t\n405\t    pub astdepth: c_int,\n406\t    pub lookahead: c_int,\n407\t    pub text: *const c_char,\n408\t    pub number: f64,\n409\t    pub gcast: *mut js_Ast,\n410\t\n411\t    pub Object_prototype: *mut js_Object,\n412\t    pub Array_prototype: *mut js_Object,\n413\t    pub Function_prototype: *mut js_Object,\n414\t    pub Boolean_prototype: *mut js_Object,\n415\t    pub Number_prototype: *mut js_Object,\n416\t    pub String_prototype: *mut js_Object,\n417\t    pub RegExp_prototype: *mut js_Object,\n418\t    pub Date_prototype: *mut js_Object,\n419\t\n420\t    pub Error_prototype: *mut js_Object,\n421\t    pub EvalError_prototype: *mut js_Object,\n422\t    pub RangeError_prototype: *mut js_Object,\n423\t    pub ReferenceError_prototype: *mut js_Object,\n424\t    pub SyntaxError_prototype: *mut js_Object,\n425\t    pub TypeError_prototype: *mut js_Object,\n426\t    pub URIError_prototype: *mut js_Object,\n427\t\n428\t    pub seed: c_uint,\n429\t\n430\t    pub scratch: [c_char; 12],\n431\t\n432\t    pub nextref: c_int,\n433\t    pub R: *mut js_Object,\n434\t    pub G: *mut js_Object,\n435\t    pub E: *mut js_Environment,\n436\t    pub GE: *mut js_Environment,\n437\t\n438\t    pub top: c_int,\n439\t    pub bot: c_int,\n440\t    pub stack: *mut js_Value,\n441\t\n442\t    pub gcmark: c_int,\n443\t    pub gccounter: c_uint,\n444\t    pub gcthresh: c_uint,\n445\t    pub gcenv: *mut js_Environment,\n446\t    pub gcfun: *mut js_Function,\n447\t    pub gcobj: *mut js_Object,\n448\t    pub gcstr: *mut js_String,\n449\t\n450\t    pub gcroot: *mut js_Object,\n451\t\n452\t    pub runlimit: c_int,\n453\t    pub memlimit: c_int,\n454\t\n455\t    pub envtop: c_int,\n456\t    pub envstack: [*mut js_Environment; JS_ENVLIMIT],\n457\t\n458\t    pub tracetop: c_int,\n459\t    pub trace: [js_StackTrace; JS_ENVLIMIT],\n460\t\n461\t    pub trytop: c_int,\n462\t    pub trybuf: [js_Jumpbuf; JS_TRYLI