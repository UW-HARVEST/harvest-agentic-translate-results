static char *readfile(const char *fn) {\n\tFILE *f = fopen(fn, \"rb\");\n\tlong n; char *s;\n\tif (!f) { fprintf(stderr, \"cannot open %s\\n\", fn); exit(1); }\n\tfseek(f, 0, SEEK_END); n = ftell(f); fseek(f, 0, SEEK_SET);\n\ts = malloc(n+1); fread(s, 1, n, f); s[n] = 0; fclose(f);\n\treturn s;\n}\n\nint main(int argc, char **argv)\n{\n\tjs_State *J;\n\tchar *src;\n\tint rc;\n\n\tJ = js_newstate(NULL, NULL, argc > 2 && !strcmp(argv[2], \"strict\") ? JS_STRICT : 0);\n\tif (!J) { printf(\"cannot create state\\n\"); return 1; }\n\n\tjs_setreport(J, myreport);\n\tprintf(\"version %d\\n\", JS_VERSION);\n\n\tjs_newcfunction(J, jsB_print, \"print\", 0); js_setglobal(J, \"print\");\n\tjs_newcfunction(J, jsB_write, \"write\", 0); js_setglobal(J, \"write\");\n\tjs_newcfunction(J, jsB_gc, \"gc\", 0); js_setglobal(J, \"gc\");\n\tjs_newcfunction(J, jsB_repr, \"repr\", 0); js_setglobal(J, \"repr\");\n\tjs_newcfunction(J, jsB_throwit, \"throwit\", 0); js_setglobal(J, \"throwit\");\n\tjs_newcfunction(J, jsB_mkud, \"mkud\", 0); js_setglobal(J, \"mkud\");\n\n\tsrc = readfile(argv[1]);\n\n\t/* run with pcall so we exercise more of the API */\n\tif (js_ploadstring(J, \"[test]\", src)) {\n\t\tprintf(\"LOADERR: %s\\n\", js_trystring(J, -1, \"Error\"));\n\t\tjs_pop(J, 1);\n\t} else {\n\t\tjs_pushundefined(J);\n\t\tif (js_pcall(J, 0)) {\n\t\t\tprintf(\"PCALLERR: %s\\n\", js_trystring(J, -1, \"Error\"));\n\t\t\tif (js_iserror(J, -1)) {\n\t\t\t\tjs_getproperty(J, -1, \"stackTrace\");\n\t\t\t\tprintf(\"TRACE: %s\\n\", js_trystring(J, -1, \"?\"));\n\t\t\t\tjs_pop(J, 1);\n\t\t\t}\n\t\t} else {\n\t\t\tprintf(\"RESULT: %s\\n\", js_tryrepr(J, -1, \"?\"));\n\t\t}\n\t\tjs_pop(J, 1);\n\t}\n\n\t/* dostring too */\n\trc = js_dostring(J, \"print('dostring ok', typeof print);\");\n\tprintf(\"dostring rc=%d\\n\", rc);\n\n\t/* exercise the C-side try/catch and variadic errors */\n\tif (js_try(J)) {\n\t\tprintf(\"caught: %s\\n\", js_trystring(J, -1, \"Error\"));\n\t\tjs_pop(J, 1);\n\t} else {\n\t\tjs_typeer