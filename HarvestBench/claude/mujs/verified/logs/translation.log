   0\n}\n\n/* Exceptions */\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn js_savetrypc(\n    J: *mut js_State,\n    pc: *mut js_Instruction,\n) -> *mut c_void {\n    if (*J).trytop as usize == JS_TRYLIMIT {\n        js_trystackoverflow(J);\n    }\n    let t = (*J).trytop as usize;\n    (*J).trybuf[t].E = (*J).E;\n    (*J).trybuf[t].envtop = (*J).envtop;\n    (*J).trybuf[t].tracetop = (*J).tracetop;\n    (*J).trybuf[t].top = (*J).top;\n    (*J).trybuf[t].bot = (*J).bot;\n    (*J).trybuf[t].strict = (*J).strict;\n    (*J).trybuf[t].pc = pc;\n    (*J).trytop += 1;\n    std::ptr::addr_of_mut!((*J).trybuf[t].buf) as *mut c_void\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn js_savetry(J: *mut js_State) -> *mut c_void {\n    if (*J).trytop as usize == JS_TRYLIMIT {\n        js_trystackoverflow(J);\n    }\n    let t = (*J).trytop as usize;\n    (*J).trybuf[t].E = (*J).E;\n    (*J).trybuf[t].envtop = (*J).envtop;\n    (*J).trybuf[t].tracetop = (*J).tracetop;\n    (*J).trybuf[t].top = (*J).top;\n    (*J).trybuf[t].bot = (*J).bot;\n    (*J).trybuf[t].strict = (*J).strict;\n    (*J).trybuf[t].pc = null_mut();\n    (*J).trytop += 1;\n    std::ptr::addr_of_mut!((*J).trybuf[t].buf) as *mut c_void\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn js_endtry(J: *mut js_State) {\n    if (*J).trytop == 0 {\n        js_error!(J, c\"endtry: exception stack underflow\".as_ptr());\n    }\n    (*J).trytop -= 1;\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn js_throw(J: *mut js_State) -> ! {\n    if (*J).trytop > 0 {\n        let v: js_Value = *stackidx(J, -1);\n        (*J).trytop -= 1;\n        let t = (*J).trytop as usize;\n        (*J).E = (*J).trybuf[t].E;\n        (*J).envtop = (*J).trybuf[t].envtop;\n        (*J).tracetop = (*J).trybuf[t].tracetop;\n        (*J).top = (*J).trybuf[t].top;\n        (*J).bot = (*J).trybuf[t].bot;\n        (*J).strict = (*J).trybuf[t].strict;\n        js_pushvalue(J, v);\n        longjmp(std::ptr::addr_of_mut!((*J).trybuf[t].buf), 1);\n    }\n    if let Some(panic) = (*J).panic {\n        panic(J);\n    }\n    abort()\n}\n\n/* Main interpreter loop */\n\nunsafe fn js_dumpvalue(J: *mut js_State, v: js_Value) {\n    let mut v = v;\n    let vp: *mut js_Value = std::ptr::addr_of_mut!(v);\n    match (*vp).t.r#type {\n        JS_TUNDEFINED => {\n            printf(c\"undefined\".as_ptr());\n        }\n        JS_TNULL => {\n            printf(c\"null\".as_ptr());\n        }\n        JS_TBOOLEAN => {\n            printf(if (*vp).u.boolean != 0 {\n                c\"true\".as_ptr()\n            } else {\n                c\"false\".as_ptr()\n            });\n        }\n        JS_TNUMBER => {\n            printf(c\"%.9g\".as_ptr(), (*vp).u.number);\n        }\n        JS_TSHRSTR => {\n            printf(c\"'%s'\".as_ptr(), js_Value_shrstr(vp));\n        }\n        JS_TLITSTR => {\n            printf(c\"'%s'\".as_ptr(), (*vp).u.litstr);\n        }\n        JS_TMEMSTR => {\n            printf(c\"'%s'\".as_ptr(), js_String_p((*vp).u.memstr));\n        }\n        JS_TOBJECT => {\n            if (*vp).u.object == (*J).G {\n                printf(c\"[Global]\".as_ptr());\n                return;\n            }\n            match (*(*vp).u.object).r#type {\n                JS_COBJECT => {\n                    printf(c\"[Object %p]\".as_ptr(), (*vp).u.object as *mut c_void);\n                }\n                JS_CARRAY => {\n                    printf(c\"[Array %p]\".as_ptr(), (*vp).u.object as *mut c_void);\n                }\n                JS_CFUNCTION => {\n                    printf(\n                        c\"[Function %p, %s, %s:%d]\".as_ptr(),\n                        (*vp).u.object as *mut c_void,\n                        (*(*(*vp).u.object).u.f.function).name,\n                        (*(*(*vp).u.object).u.f.function).filename,\n                        (*(*(*vp).u.object).u.f.function).line,\n                    );\n                }\n                JS_CSCRIPT => {\n                    print