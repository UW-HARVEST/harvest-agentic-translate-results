;\n178\t        jsB_props(J, c\"message\".as_ptr(), c\"\".as_ptr());\n179\t\n180\t        js_newcfunction(J, Some(Ep_get_stack), c\"stack\".as_ptr(), 0);\n181\t        js_pushnull(J);\n182\t        js_defaccessor(\n183\t            J,\n184\t            -3,\n185\t            c\"stack\".as_ptr(),\n186\t            JS_READONLY | JS_DONTENUM | JS_DONTCONF,\n187\t        );\n188\t    }\n189\t    js_newcconstructor(\n190\t        J,\n191\t        Some(jsB_Error),\n192\t        Some(jsB_Error),\n193\t        c\"Error\".as_ptr(),\n194\t        1,\n195\t    );\n196\t    js_defglobal(J, c\"Error\".as_ptr(), JS_DONTENUM);\n197\t\n198\t    macro_rules! IERROR {\n199\t        ($proto:ident, $jsB:ident, $name:expr) => {\n200\t            js_pushobject(J, (*J).$proto);\n201\t            jsB_props(J, c\"name\".as_ptr(), $name);\n202\t            js_newcconstructor(J, Some($jsB), Some($jsB), $name, 1);\n203\t            js_defglobal(J, $name, JS_DONTENUM);\n204\t        };\n205\t    }\n206\t\n207\t    IERROR!(EvalError_prototype, jsB_EvalError, c\"EvalError\".as_ptr());\n208\t    IERROR!(RangeError_prototype, jsB_RangeError, c\"RangeError\".as_ptr());\n209\t    IERROR!(\n210\t        ReferenceError_prototype,\n211\t        jsB_ReferenceError,\n212\t        c\"ReferenceError\".as_ptr()\n213\t    );\n214\t    IERROR!(\n215\t        SyntaxError_prototype,\n216\t        jsB_SyntaxError,\n217\t        c\"SyntaxError\".as_ptr()\n218\t    );\n219\t    IERROR!(TypeError_prototype, jsB_TypeError, c\"TypeError\".as_ptr());\n220\t    IERROR!(URIError_prototype, jsB_URIError, c\"URIError\".as_ptr());\n221\t}\n222\t"}]},"parent_tool_use_id":"toolu_bdrk_01QE1sPtGD8H9c5yvZfrXAkr","session_id":"6e63ba36-2d65-497f-a5b2-8fd6eb67db8b","uuid":"2e304a7c-7e77-4a35-aaaf-fda45727a8d2","timestamp":"2026-08-22T21:36:59.236Z","subagent_type":"general-purpose","task_description":"Translate jscompile.c to Rust"}
