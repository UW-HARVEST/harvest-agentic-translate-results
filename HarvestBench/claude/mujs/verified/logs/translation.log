paque to most modules; defined in jsintern.rs / regexp.rs */\n717\t#[repr(C)]\n718\tpub struct js_StringNode {\n719\t    pub left: *mut js_StringNode,\n720\t    pub right: *mut js_StringNode,\n721\t    pub level: c_int,\n722\t    pub string: [c_char; 1],\n723\t}\n724\t\n725\t/* Resub for regexp.c public API */\n726\t#[derive(Copy, Clone)]\n727\t#[repr(C)]\n728\tpub struct Resub_sub {\n729\t    pub sp: *const c_char,\n730\t    pub ep: *const c_char,\n731\t}\n732\t\n733\t#[repr(C)]\n734\tpub struct Resub {\n735\t    pub nsub: c_int,\n736\t    pub sub: [Resub_sub; REG_MAXSUB],\n737\t}\n738\t\n739\t/* ---------------------------------------------------------------- offsets */\n740\t\n741\tpub const SOFFSETOF_JS_VALUE_TYPE: c_int = 15; /* soffsetof(js_Value, t.type) */\n742\tpub const SOFFSETOF_JS_STRING_P: c_int = 9; /* soffsetof(js_String, p) */\n743\tpub const SOFFSETOF_JS_BUFFER_S: c_int = 8; /* soffsetof(js_Buffer, s) */\n744\tpub const SOFFSETOF_JS_PROPERTY_NAME: c_int = 56; /* soffsetof(js_Property, name) */\n745\tpub const SOFFSETOF_JS_ITERATOR_NAME: c_int = 8; /* soffsetof(js_Iterator, name) */\n746\tpub const SOFFSETOF_JS_STRINGNODE_STRING: c_int = 20; /* soffsetof(js_StringNode, string) */\n747\t\n748\t/* ---------------------------------------------------------------- helpers */\n749\t\n750\t/// Pointer to the flexible char array of a js_String.\n751\t#[inline(always)]\n752\tpub unsafe fn js_String_p(s: *mut js_String) -> *mut c_char {\n753\t    std::ptr::addr_of_mut!((*s).p) as *mut c_char\n754\t}\n755\t\n756\t/// Pointer to the flexible char array of a js_Property.\n757\t#[inline(always)]\n758\tpub unsafe fn js_Property_name(p: *mut js_Property) -> *mut c_char {\n759\t    std::ptr::addr_of_mut!((*p).name) as *mut c_char\n760\t}\n761\t\n762\t/// Pointer to the flexible char array of a js_Iterator.\n763\t#[inline(always)]\n764\tpub unsafe fn js_Iterator_name(p: *mut js_Iterator) -> *mut c_char {\n765\t    std::ptr::addr_of_mut!((*p).name) as *mut c_char\n766\