as f64;\n40\t            c = *s as c_uchar;\n41\t            s = s.add(1);\n42\t        }\n43\t    } else {\n44\t        x = 0.0;\n45\t        c = *s as c_uchar;\n46\t        s = s.add(1);\n47\t        while (js_strtol_table[c as usize] as c_int) < base {\n48\t            x = x * base as f64 + js_strtol_table[c as usize] as f64;\n49\t            c = *s as c_uchar;\n50\t            s = s.add(1);\n51\t        }\n52\t    }\n53\t    if !p.is_null() {\n54\t        *p = s.sub(1) as *mut c_char;\n55\t    }\n56\t    x\n57\t}\n58\t\n59\t#[unsafe(no_mangle)]\n60\tpub unsafe extern \"C\" fn jsV_numbertointeger(n: f64) -> c_int {\n61\t    let mut n = n;\n62\t    if n == 0.0 {\n63\t        return 0;\n64\t    }\n65\t    if isnan(n) {\n66\t        return 0;\n67\t    }\n68\t    n = if n < 0.0 { -floor(-n) } else { floor(n) };\n69\t    if n < INT_MIN as f64 {\n70\t        return INT_MIN;\n71\t    }\n72\t    if n > INT_MAX as f64 {\n73\t        return INT_MAX;\n74\t    }\n75\t    n as c_int\n76\t}\n77\t\n78\t#[unsafe(no_mangle)]\n79\tpub unsafe extern \"C\" fn jsV_numbertoint32(n: f64) -> c_int {\n80\t    let two32: f64 = 4294967296.0;\n81\t    let two31: f64 = 2147483648.0;\n82\t    let mut n = n;\n83\t\n84\t    if !isfinite(n) || n == 0.0 {\n85\t        return 0;\n86\t    }\n87\t\n88\t    n = fmod(n, two32);\n89\t    n = if n >= 0.0 { floor(n) } else { ceil(n) + two32 };\n90\t    if n >= two31 {\n91\t        (n - two32) as c_int\n92\t    } else {\n93\t        n as c_int\n94\t    }\n95\t}\n96\t\n97\t#[unsafe(no_mangle)]\n98\tpub unsafe extern \"C\" fn jsV_numbertouint32(n: f64) -> c_uint {\n99\t    jsV_numbertoint32(n) as c_uint\n100\t}\n101\t\n102\t#[unsafe(no_mangle)]\n103\tpub unsafe extern \"C\" fn jsV_numbertoint16(n: f64) -> c_short {\n104\t    jsV_numbertoint32(n) as c_short\n105\t}\n106\t\n107\t#[unsafe(no_mangle)]\n108\tpub unsafe extern \"C\" fn jsV_numbertouint16(n: f64) -> c_ushort {\n109\t    jsV_numbertoint32(n) as c_ushort\n110\t}\n111\t\n112\t/* obj.toString() */\n11