            resume_unwind(payload);\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10896,"cache_read_input_tokens":259844,"cache_creation":{"ephemeral_5m_input_tokens":10896,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d89652df-3211-45b0-b03a-84321fcd3e8b","uuid":"ecadd8b2-627c-44ba-abaf-35e03fda4aeb","timestamp":"2026-08-05T03:48:49.347Z"}
