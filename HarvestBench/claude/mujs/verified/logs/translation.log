ValueU,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct JsValueT {\n    pub pad: [c_char; 15],\n    pub type_: c_char,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub union JsValueU {\n    pub shrstr: [c_char; 16],\n    pub boolean: c_int,\n    pub number: f64,\n    pub litstr: *const c_char,\n    pub memstr: *mut js_String,\n    pub object: *mut js_Object,\n}\n\nimpl js_Value {\n    #[inline]\n    pub fn zeroed() -> js_Value {\n        unsafe { std::mem::zeroed() }\n    }\n    #[inline]\n    pub fn type_(&self) -> c_char {\n        unsafe { self.t.type_ }\n    }\n    #[inline]\n    pub fn set_type(&mut self, t: c_char) {\n        self.t.type_ = t;\n    }\n}\n\n#[repr(C)]\npub struct js_String {\n    pub gcnext: *mut js_String,\n    pub gcmark: c_char,\n    pub p: [c_char; 1], // flexible array member\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct js_Regexp {\n    pub prog: *mut c_void,\n    pub source: *mut c_char,\n    pub flags: c_ushort,\n    pub last: c_ushort,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct ObjS {\n    pub length: c_int,\n    pub string: *mut c_char,\n    pub shrstr: [c_char; 16],\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct ObjA {\n    pub length: c_int,\n    pub simple: c_int,\n    pub flat_length: c_int,\n    pub flat_capacity: c_int,\n    pub array: *mut js_Value,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct ObjF {\n    pub function: *mut js_Function,\n    pub scope: *mut js_Environment,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct ObjC {\n    pub name: *const c_char,\n    pub function: js_CFunction,\n    pub constructor: js_CFunction,\n    pub length: c_int,\n    pub data: *mut c_void,\n    pub finalize: js_Finalize,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct ObjIter {\n    pub target: *mut js_Object,\n    pub i: c_int,\n    pub n: c_int,\n    pub head: *mut js_Iterator,\n    pub current: *mut js_Iterator,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct ObjUser {\n    pub tag: *const c_char,\n    pub data: *mut c_void,\n    pub has: js_HasProperty,\n    pub put: js_Put,\n    pub delete: js_Delete,\n    pub finalize: js_Finalize,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub union ObjU {\n    pub boolean: c_int,\n    pub number: f64,\n    pub s: ObjS,\n    pub a: ObjA,\n    pub f: ObjF,\n    pub c: ObjC,\n    pub r: js_Regexp,\n    pub iter: ObjIter,\n    pub user: ObjUser,\n}\n\n#[repr(C)]\npub struct js_Object {\n    pub type_: c_int, // enum js_Class\n    pub extensible: c_int,\n    pub properties: *mut js_Property,\n    pub count: c_int,\n    pub prototype: *mut js_Object,\n    pub u: ObjU,\n    pub gcnext: *mut js_Object,\n    pub gcroot: *mut js_Object,\n    pub gcmark: c_int,\n}\n\n#[repr(C)]\npub struct js_Property {\n    pub left: *mut js_Property,\n    pub right: *mut js_Property,\n    pub level: c_int,\n    pub atts: c_int,\n    pub value: js_Value,\n    pub getter: *mut js_Object,\n    pub setter: *mut js_Object,\n    pub name: [c_char; 1], // flexible array member\n}\n\n#[repr(C)]\npub struct js_Iterator {\n    pub next: *mut js_Iterator,\n    pub name: [c_char; 1], // flexible array member\n}\n\n#[repr(C)]\npub struct js_Environment {\n    pub outer: *mut js_Environment,\n    pub variables: *mut js_Object,\n    pub gcnext: *mut js_Environment,\n    pub gcmark: c_int,\n}\n\n#[repr(C)]\npub struct js_StringNode {\n    pub left: *mut js_StringNode,\n    pub right: *mut js_StringNode,\n    pub level: c_int,\n    pub string: [c_char; 1], // flexible array member\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct js_StackTrace {\n    pub name: *const c_char,\n    pub file: *const c_char,\n    pub line: c_int,\n    pub stack: c_int,\n}\n\nimpl js_StackTrace {\n    pub const fn zeroed() -> js_StackTrace {\n        js_StackTrace { name: std::ptr::null(), file: std::ptr::null(), line: 0, stack: 0 }\n    }\n}\n\n/// Exception handling record. `buf` is only present for C-ABI compatibility\n/// with the public `js_savetry` interface; internally 