+ (P - 1) - 1) + 1;\n        denorm = 1;\n    }\n    ds = (d2.d() - 1.5) * 0.289529654602168 + 0.1760912590558 + (i as f64) * 0.301029995663981;\n    k = ds as c_int;\n    if ds < 0.0 && ds != (k as f64) {\n        k -= 1;\n    }\n    k_check = 1;\n    if k >= 0 && k <= TEN_PMAX {\n        if u.d() < TENS[k as usize] {\n            k -= 1;\n        }\n        k_check = 0;\n    }\n    j = bbits - i - 1;\n    if j >= 0 {\n        b2 = 0;\n        s2 = j;\n    } else {\n        b2 = -j;\n        s2 = 0;\n    }\n    if k >= 0 {\n        b5 = 0;\n        s5 = k;\n        s2 += k;\n    } else {\n        b2 -= k;\n        b5 = -k;\n        s5 = 0;\n    }\n\n    if mode < 0 || mode > 9 {\n        mode = 0;\n    }\n\n    try_quick = 1;\n\n    if mode > 5 {\n        mode -= 4;\n        try_quick = 0;\n    }\n    leftright = 1;\n    ilim = -1;\n    ilim1 = -1;\n    match mode {\n        0 | 1 => {\n            i = 18;\n            ndigits = 0;\n        }\n        2 => {\n            leftright = 0;\n            if ndigits <= 0 {\n                ndigits = 1;\n            }\n            ilim = ndigits;\n            ilim1 = ndigits;\n            i = ndigits;\n        }\n        4 => {\n            if ndigits <= 0 {\n                ndigits = 1;\n            }\n            ilim = ndigits;\n            ilim1 = ndigits;\n            i = ndigits;\n        }\n        3 => {\n            leftright = 0;\n            i = ndigits + k + 1;\n            ilim = i;\n            ilim1 = i - 1;\n            if i <= 0 {\n                i = 1;\n            }\n        }\n        5 => {\n            i = ndigits + k + 1;\n            ilim = i;\n            ilim1 = i - 1;\n            if i <= 0 {\n                i = 1;\n            }\n        }\n        _ => {}\n    }\n    if buf.is_null() {\n        buf = rv_alloc(i);\n        // blen = sizeof(Bigint)+((1<<((int*)buf)[-1])-1)*sizeof(ULong)-sizeof(int)\n        let kk = *((buf as *mut c_int).offset(-1));\n        blen = core::mem::size_of::<Bigint>() + (((1i64 << kk) - 1) as usize) * 4\n            - core::mem::size_of::<c_int>();\n    } else if blen <= i as usize {\n        buf = ptr::null_mut();\n        if !rve.is_null() {\n            *rve = buf.wrapping_add(i as usize);\n        }\n        return buf;\n    }\n    s = buf;\n\n    spec_case = 0;\n    if mode < 2 || leftright != 0 {\n        if u.word1() == 0\n            && (u.word0() & BNDRY_MASK) == 0\n            && (u.word0() & (EXP_MASK & !EXP_MSK1)) != 0\n        {\n            spec_case = 1;\n        }\n    }\n\n    // ---- try_quick floating-point fast path ----\n    'after_fast: {\n        if ilim >= 0 && ilim <= QUICK_MAX && try_quick != 0 {\n            i = 0;\n            d2.set_d(u.d());\n            k0 = k;\n            j1 = -k;\n            ilim0 = ilim;\n            ieps = 2;\n            if k > 0 {\n                ds = TENS[(k & 0xf) as usize];\n                j = k >> 4;\n                if j & (0x10) != 0 {\n                    // Bletch = 0x10\n                    j &= 0x10 - 1;\n                    u.set_d(u.d() / BIGTENS[(N_BIGTENS - 1) as usize]);\n                    ieps += 1;\n                }\n                while j != 0 {\n                    if j & 1 != 0 {\n                        ieps += 1;\n                        ds *= BIGTENS[i as usize];\n                    }\n                    j >>= 1;\n                    i += 1;\n                }\n                u.set_d(u.d() / ds);\n            } else if j1 > 0 {\n                u.set_d(u.d() * TENS[(j1 & 0xf) as usize]);\n                let mut jj = j1 >> 4;\n                while jj != 0 {\n                    if jj & 1 != 0 {\n                        ieps += 1;\n                        u.set_d(u.d() * BIGTENS[i as usize]);\n                    }\n                    jj >>= 1;\n                    i += 1;\n                }\n            }\n            if k_check != 0 && u.d() < 1.0 && ilim > 0 {\n                if ilim1 <= 0 {\n                    // goto fast_failed\n                    s = buf;\n                    u.set_d(d2.d());\n                    k = k0;\n                    ilim = ilim0;\n                    break 'after_fast;\n                }\n                ilim = ilim1;\n                k -= 1;\n                u.set_d(u.d() * 10.0);\n                ieps += 1;\n            }\n            eps.set_d((ieps as f64) * u.d() + 7.0);\n            eps.set_word0(eps.word0().wrapping_sub(((P - 1) as u32).wrapping_mul(EXP_MSK1)));\n            if ilim == 0 {\n                s_big = ptr::null_mut();\n                mhi = ptr::null_mut();\n                u.set_d(u.d() - 5.0);\n                if u.d() > eps.d() {\n                    // one_digit\n                    *s = b'1' as c_char;\n                    s = s.add(1);\n                    k += 1;\n                    return finish_ret(\n                        b, s_big, mlo_none(), mhi, buf, s, k, decpt, rve,\n                    );\n                }\n                if u.d() < -eps.d() {\n                    return no_digits_ret(b, s_big, mhi, buf, k, ndigits, decpt, rve, &mut s);\n                }\n                // fast_failed\n                s = buf;\n                u.set_d(d2.d());\n                k = k0;\n                ilim = ilim0;\n                break 'after_fast;\n            }\n            if leftright != 0 {\n                eps.set_d(0.5 / TENS[(ilim - 1) as usize] - eps.d());\n                if j1 >= 307 {\n                    eps1.set_d(1.01e256);\n                    eps1.set_word0(eps1.word0().wrapping_sub(EXP_MSK1.wrapping_mul((BIAS + P - 1) as u32)));\n                    eps1.set_d(eps1.d() * TENS[(j1 & 0xf) as usize]);\n                    let mut ii = 0;\n                    let mut jj = (j1 - 256) >> 4;\n                    while jj != 0 {\n                        if jj & 1 != 0 {\n                            eps1.set_d(eps1.d() * BIGTENS[ii as usize]);\n                        }\n                        jj >>= 1;\n                        ii += 1;\n                    }\n                    if eps.d() < eps1.d() {\n                        eps.set_d(eps1.d());\n                    }\n                    if 10.0 - u.d() < 10.0 * eps.d() && eps.d() < 1.0 {\n                        *s = b'1' as c_char;\n                        s = s.add(1);\n                        k += 1;\n                        return finish_ret(b, ptr::null_mut(), ptr::null_mut(), ptr::null_mut(), buf, s, k, decpt, rve);\n                    }\n                }\n                i = 0;\n                loop {\n                    l = u.d() as i64 as i32;\n                    u.set_d(u.d() - (l as f64));\n                    *s = (b'0' as c_int + l) as c_char;\n                    s = s.add(1);\n                    if 1.0 - u.d() < eps.d() {\n                        // bump_up then retc\n                        return bump_up_retc(buf, s, &mut k, decpt, rve, b);\n                    }\n                    if u.d() < eps.d() {\n                        return retc_ret(buf, s, k, decpt, rve, b);\n                    }\n                    i += 1;\n                    if i >= ilim {\n                        break;\n                    }\n                    eps.set_d(eps.d() * 10.0);\n                    u.set_d(u.d() * 10.0);\n                }\n            } else {\n                eps.set_d(eps.d() * TENS[(ilim - 1) as usize]);\n                i = 1;\n                loop {\n                    l = u.d() as i64 as i32;\n                    u.set_d(u.d() - (l as f64));\n                    if u.d() == 0.0 {\n                        ilim = i;\n                    }\n                    *s = (b'0' as c_int + l) as c_char;\n                    s = s.add(1);\n                    if i == ilim {\n                        if u.d() > 0.5 + eps.d() {\n                            return bump_up_retc(buf, s, &mut k, decpt, rve, b);\n                        } else if u.d() < 0.5 - eps.d() {\n                            return retc_ret(buf, s, k, de