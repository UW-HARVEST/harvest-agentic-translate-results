       1 + P - bbits\n        };\n        b2 += i;\n        s2 += i;\n        mhi = i2b(1);\n    }\n    if m2 > 0 && s2 > 0 {\n        i = if m2 < s2 { m2 } else { s2 };\n        b2 -= i;\n        m2 -= i;\n        s2 -= i;\n    }\n    if b5 > 0 {\n        if leftright != 0 {\n            if m5 > 0 {\n                mhi = pow5mult(mhi, m5);\n                b1 = mult(mhi, b);\n                bfree(b);\n                b = b1;\n            }\n            j = b5 - m5;\n            if j != 0 {\n                b = pow5mult(b, j);\n            }\n        } else {\n            b = pow5mult(b, b5);\n        }\n    }\n    s_big = i2b(1);\n    if s5 > 0 {\n        s_big = pow5mult(s_big, s5);\n    }\n\n    if spec_case != 0 {\n        b2 += LOG2P;\n        s2 += LOG2P;\n    }\n\n    i = dshift(s_big, s2);\n    b2 += i;\n    m2 += i;\n    s2 += i;\n    if b2 > 0 {\n        b = lshift(b, b2);\n    }\n    if s2 > 0 {\n        s_big = lshift(s_big, s2);\n    }\n    if k_check != 0 {\n        if cmp(b, s_big) < 0 {\n            k -= 1;\n            b = multadd(b, 10, 0);\n            if leftright != 0 {\n                mhi = multadd(mhi, 10, 0);\n            }\n            ilim = ilim1;\n        }\n    }\n    if ilim <= 0 && (mode == 3 || mode == 5) {\n        s_big = multadd(s_big, 5, 0);\n        if ilim < 0 || cmp(b, s_big) <= 0 {\n            // no_digits\n            k = -1 - ndigits;\n            return ret_ret(b, s_big, mlo, mhi, buf, s, k, decpt, rve);\n        }\n        // one_digit\n        *s = b'1' as c_char;\n        s = s.add(1);\n        k += 1;\n        return ret_ret(b, s_big, mlo, mhi, buf, s, k, decpt, rve);\n    }\n    if leftright != 0 {\n        if m2 > 0 {\n            mhi = lshift(mhi, m2);\n        }\n        mlo = mhi;\n        if spec_case != 0 {\n            mhi = balloc((*mlo).k);\n            bcopy(mhi, mlo);\n            mhi = lshift(mhi, LOG2P);\n        }\n\n        i = 1;\n        loop {\n            dig = quorem(b, s_big) + b'0' as c_int;\n