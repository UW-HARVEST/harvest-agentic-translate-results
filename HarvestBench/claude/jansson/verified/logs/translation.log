                  if (dump(separator, separator_length, data) ||\n398\t                        do_dump(json_object_iter_value(iter), flags, depth + 1, parents,\n399\t                                dump, data))\n400\t                        return -1;\n401\t\n402\t                    if (next) {\n403\t                        if (dump(\",\", 1, data) ||\n404\t                            dump_indent(flags, depth + 1, 1, dump, data))\n405\t                            return -1;\n406\t                    } else {\n407\t                        if (dump_indent(flags, depth, 0, dump, data))\n408\t                            return -1;\n409\t                    }\n410\t\n411\t                    iter = next;\n412\t                }\n413\t            }\n414\t\n415\t            hashtable_del(parents, loop_key, loop_key_len);\n416\t            return embed ? 0 : dump(\"}\", 1, data);\n417\t        }\n418\t\n419\t        default:\n420\t            /* not reached */\n421\t            return -1;\n422\t    }\n423\t}\n424\t\n425\tchar *json_dumps(const json_t *json, size_t flags) {\n426\t    strbuffer_t strbuff;\n427\t    char *result;\n428\t\n429\t    if (strbuffer_init(&strbuff))\n430\t        return NULL;\n431\t\n432\t    if (json_dump_callback(json, dump_to_strbuffer, (void *)&strbuff, flags))\n433\t        result = NULL;\n434\t    else {\n435\t        char *new_result;\n436\t        result = strbuffer_steal_value(&strbuff);\n437\t        // technically the resizing is not needed.\n438\t        new_result = jsonp_realloc(result, strbuff.size, strbuff.length + 1);\n439\t        if (new_result) { // when realloc fails we just use the original pointer\n440\t            result = new_result;\n441\t        }\n442\t    }\n443\t\n444\t    strbuffer_close(&strbuff);\n445\t    return result;\n446\t}\n447\t\n448\tsize_t json_dumpb(const json_t *json, char *buffer, size_t size, size_t flags) {\n449\t    struct buffer buf = {size, 0, buffer};\n450\t\n451\t    if (json_dump_callback(json, du