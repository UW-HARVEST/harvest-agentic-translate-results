         lex_free_string(lex);\n            return;\n        } else if c == STREAM_STATE_EOF {\n            error_set(\n                error,\n                lex,\n                json_error_premature_end_of_input,\n                b\"premature end of input\\0\".as_ptr() as *const c_char,\n            );\n            lex_free_string(lex);\n            return;\n        } else if 0 <= c && c <= 0x1F {\n            /* control character */\n            lex_unget_unsave(lex, c);\n            if c == '\\n' as c_int {\n                error_set(\n                    error,\n                    lex,\n                    json_error_invalid_syntax,\n                    b\"unexpected newline\\0\".as_ptr() as *const c_char,\n                );\n            } else {\n                error_set(\n                    error,\n                    lex,\n                    json_error_invalid_syntax,\n                    b\"control character 0x%x\\0\".as_ptr() as *const c_char,\n                    c,\n                );\n            }\n            lex_free_string(lex);\n            return;\n        } else if c == '\\\\' as c_int {\n            c = lex_get_save(lex, error);\n            if c == 'u' as c_int {\n                c = lex_get_save(lex, error);\n                i = 0;\n                while i < 4 {\n                    if !l_isxdigit(c) {\n                        error_set(\n                            error,\n                            lex,\n                            json_error_invalid_syntax,\n                            b\"invalid escape\\0\".as_ptr() as *const c_char,\n                        );\n                        lex_free_string(lex);\n                        return;\n                    }\n                    c = lex_get_save(lex, error);\n                    i += 1;\n                }\n            } else if c == '\"' as c_int\n                || c == '\\\\' as c_int\n                || c == '/' as c_int\n                || c == 'b' as c_int\n               