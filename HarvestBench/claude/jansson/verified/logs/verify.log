set(&object->hashtable, key, key_len, value)) {\n138\t        json_decref(value);\n139\t        return -1;\n140\t    }\n141\t\n142\t    return 0;\n143\t}\n144\t\n145\tint json_object_set_new(json_t *json, const char *key, json_t *value) {\n146\t    if (!key) {\n147\t        json_decref(value);\n148\t        return -1;\n149\t    }\n150\t\n151\t    return json_object_setn_new(json, key, strlen(key), value);\n152\t}\n153\t\n154\tint json_object_setn_new(json_t *json, const char *key, size_t key_len, json_t *value) {\n155\t    if (!key || !utf8_check_string(key, key_len)) {\n156\t        json_decref(value);\n157\t        return -1;\n158\t    }\n159\t\n160\t    return json_object_setn_new_nocheck(json, key, key_len, value);\n161\t}\n162\t\n163\tint json_object_del(json_t *json, const char *key) {\n164\t    if (!key)\n165\t        return -1;\n166\t\n167\t    return json_object_deln(json, key, strlen(key));\n168\t}\n169\t\n170\tint json_object_deln(json_t *json, const char *key, size_t key_len) {\n171\t    json_object_t *object;\n172\t\n173\t    if (!key || !json_is_object(json))\n174\t        return -1;\n175\t\n176\t    object = json_to_object(json);\n177\t    return hashtable_del(&object->hashtable, key, key_len);\n178\t}\n179\t\n180\tint json_object_clear(json_t *json) {\n181\t    json_object_t *object;\n182\t\n183\t    if (!json_is_object(json))\n184\t        return -1;\n185\t\n186\t    object = json_to_object(json);\n187\t    hashtable_clear(&object->hashtable);\n188\t\n189\t    return 0;\n190\t}\n191\t\n192\tint json_object_update(json_t *object, json_t *other) {\n193\t    const char *key;\n194\t    size_t key_len;\n195\t    json_t *value;\n196\t\n197\t    if (!json_is_object(object) || !json_is_object(other))\n198\t        return -1;\n199\t\n200\t    json_object_keylen_foreach(other, key, key_len, value) {\n201\t        if (json_object_setn_nocheck(object, key, key_len, value))\n202\t            return -1;\n203\t    }\n204\t\n205\t    return 0;\n206\t}\n207\t\n208\tint json_object_update_existing(json_t *object, json_t *other) {\n209\t    const char *key;\n210\t    size_t key_len;\n211\t    json_t *value;\n212\t\n213\t    if (!json_is_object(object) || !json_is_object(other))\n214\t        return -1;\n215\t\n216\t    json_object_keylen_foreach(other, key, key_len, value) {\n217\t        if (json_object_getn(object, key, key_len))\n218\t            json_object_setn_nocheck(object, key, key_len, value);\n219\t    }\n220\t\n221\t    return 0;\n222\t}\n223\t\n224\tint json_object_update_missing(json_t *object, json_t *other) {\n225\t    const char *key;\n226\t    size_t key_len;\n227\t    json_t *value;\n228\t\n229\t    if (!json_is_object(object) || !json_is_object(other))\n230\t        return -1;\n231\t\n232\t    json_object_keylen_foreach(other, key, key_len, value) {\n233\t        if (!json_object_getn(object, key, key_len))\n234\t            json_object_setn_nocheck(object, key, key_len, value);\n235\t    }\n236\t\n237\t    return 0;\n238\t}\n239\t\n240\tint do_object_update_recursive(json_t *object, json_t *other, hashtable_t *parents) {\n241\t    const char *key;\n242\t    size_t key_len;\n243\t    json_t *value;\n244\t    char loop_key[LOOP_KEY_LEN];\n245\t    int res = 0;\n246\t    size_t loop_key_len;\n247\t\n248\t    if (!json_is_object(object) || !json_is_object(other))\n249\t        return -1;\n250\t\n251\t    if (jsonp_loop_check(parents, other, loop_key, sizeof(loop_key), &loop_key_len))\n252\t        return -1;\n253\t\n254\t    json_object_keylen_foreach(other, key, key_len, value) {\n255\t        json_t *v = json_object_getn(object, key, key_len);\n256\t\n257\t        if (json_is_object(v) && json_is_object(value)) {\n258\t            if (do_object_update_recursive(v, value, parents)) {\n259\t                res = -1;\n260\t                break;\n261\t            }\n262\t        } else {\n263\t            if (json_object_setn_nocheck(object, key, key_len, value)) {\n264\t                res = -1;\n265\t                break;\n266\t            }\n267\t        }\n268\t    }\n269\t\n270\t    hashtable_del(parents, loop_key, loop_key_len);\n271\t\n272\t    return res;\n273\t}\n274\t\n275\tint json_object_update_recursive(json_t *object, json_t *other) {\n276\t    int res;\n277\t    hashtable_t parents_set;\n278\t\n279\t    if (hashtable_init(&parents_set))\n280\t        return -1;\n281\t    res = do_object_update_recursive(object, other, &parents_set);\n282\t    hashtable_close(&parents_set);\n283\t\n284\t    return res;\n285\t}\n286\t\n287\tvoid *json_object_iter(json_t *json) {\n288\t    json_object_t *object;\n289\t\n290\t    if (!json_is_object(json))\n291\t        return NULL;\n292\t\n293\t    object = json_to_object(json);\n294\t    return hashtable_iter(&object->hashtable);\n295\t}\n296\t\n297\tvoid *json_object_iter_at(json_t *json, const char *key) {\n298\t    json_object_t *object;\n299\t\n300\t    if (!key || !json_is_object(json))\n301\t        return NULL;\n302\t\n303\t    object = json_to_object(json);\n304\t    return hashtable_iter_at(&object->hashtable, key, strlen(key));\n305\t}\n306\t\n307\tvoid *json_object_iter_next(json_t *json, void *iter) {\n308\t    json_object_t *object;\n309\t\n310\t    if (!json_is_object(json) || iter == NULL)\n311\t        return NULL;\n312\t\n313\t    object = json_to_object(json);\n314\t    return hashtable_iter_next(&object->hashtable, iter);\n315\t}\n316\t\n317\tconst char *json_object_iter_key(void *iter) {\n318\t    if (!iter)\n319\t        return NULL;\n320\t\n321\t    return hashtable_iter_key(iter);\n322\t}\n323\t\n324\tsize_t json_object_iter_key_len(void *iter) {\n325\t    if (!iter)\n326\t        return 0;\n327\t\n328\t    return hashtable_iter_key_len(iter);\n329\t}\n330\t\n331\tjson_t *json_object_iter_value(void *iter) {\n332\t    if (!iter)\n333\t        return NULL;\n334\t\n335\t    return (json_t *)hashtable_iter_value(iter);\n336\t}\n337\t\n338\tint json_object_iter_set_new(json_t *json, void *iter, json_t *value) {\n339\t    if (!json_is_object(json) || !iter || !value) {\n340\t        json_decref(value);\n341\t        return -1;\n342\t    }\n343\t\n344\t    hashtable_iter_set(iter, value);\n345\t    return 0;\n346\t}\n347\t\n348\tvoid *json_object_key_to_iter(const char *key) {\n349\t    if (!key)\n350\t        return NULL;\n351\t\n352\t    return hashtable_key_to_iter(key);\n353\t}\n354\t\n355\tstatic int json_object_equal(const json_t *object1, const json_t *object2) {\n356\t    const char *key;\n357\t    size_t key_len;\n358\t    const json_t *value1, *value2;\n359\t\n360\t    if (json_object_size(object1) != json_object_size(object2))\n361\t        return 0;\n362\t\n363\t    json_object_keylen_foreach((json_t *)object1, key, key_len, value1) {\n364\t        value2 = json_object_getn(object2, key, key_len);\n365\t\n366\t        if (!json_equal(value1, value2))\n367\t            return 0;\n368\t    }\n369\t\n370\t    return 1;\n371\t}\n372\t\n373\tstatic json_t *json_object_copy(json_t *object) {\n374\t    json_t *result;\n375\t\n376\t    const char *key;\n377\t    size_t key_len;\n378\t    json_t *value;\n379\t\n380\t    result = json_object();\n381\t    if (!result)\n382\t        return NULL;\n383\t\n384\t    json_object_keylen_foreach(object, key, key_len, value)\n385\t        json_object_setn_nocheck(result, key, key_len, value);\n386\t\n387\t    return result;\n388\t}\n389\t\n390\tstatic json_t *json_object_deep_copy(const json_t *object, hashtable_t *parents) {\n391\t    json_t *result;\n392\t    void *iter;\n393\t    char loop_key[LOOP_KEY_LEN];\n394\t    size_t loop_key_len;\n395\t\n396\t    if (jsonp_loop_check(parents, object, loop_key, sizeof(loop_key), &loop_key_len))\n397\t        return NULL;\n398\t\n399\t    result = json_object();\n400\t    if (!result)\n401\t        goto out;\n402\t\n403\t    /* Cannot use json_object_foreach because object has to be cast\n404\t       non-const */\n405\t    iter = json_object_iter((json_t *)object);\n406\t    while (iter) {\n407\t        const char *key;\n408\t        size_t key_len;\n409\t        const json_t *value;\n410\t        key = json_object_iter_key(iter);\n411\t        key_len = json_object_iter_key_len(iter);\n412\t        value = json_object_iter_value(iter);\n413\t\n414\t        if (json_object_setn_new_nocheck(result, key, key_len,\n415\t                                         do_deep_copy(value, parents))) {\n416\t            json_decref(result);\n417\t            result = NULL;\n418\t            break;\n419\t        }\n420\t        iter = json_object_iter_next((json_t *)object, iter);\n421\t    }\n422\t\n423\tout:\n424\t    hashtable_del(parents, loop_key, loop_key_len);\n425\t\n426\t    return result;\n427\t}\n428\t\n429\t/*** array ***/\n430\t\n431\tjson_t *json_array(void) {\n432\t    json_array_t *array = jsonp_malloc(sizeof(json_array_t));\n433\t    if (!array)\n434\t        return NULL;\n435\t    json_init(&array->json, JSON_ARRAY);\n436\t\n437\t    array->entries = 0;\n438\t    array->size = 8;\n439\t\n440\t    array->table = jsonp_malloc(array->size * sizeof(json_t *));\n441\t    if (!array->table) {\n442\t        jsonp_free(array);\n443\t        return NULL;\n444\t    }\n445\t\n446\t    return &array->json;\n447\t}\n448\t\n449\tstatic void json_delete_array(json_array_t *array) {\n450\t    size_t i;\n451\t\n452\t    for (i = 0; i < array->entries; i++)\n453\t        json_decref(array->table[i]);\n454\t\n455\t    jsonp_free(array->table);\n456\t    jsonp_free(array);\n457\t}\n458\t\n459\tsize_t json_array_size(const json_t *json) {\n460\t    if (!json_is_array(json))\n461\t        return 0;\n462\t\n463\t    return json_to_array(json)->entries;\n464\t}\n465\t\n466\tjson_t *json_array_get(const json_t *json, size_t index) {\n467\t    json_array_t *array;\n468\t    if (!json_is_array(json))\n469\t        return NULL;\n470\t    array = json_to_array(json);\n471\t\n472\t    if (index >= array->entries)\n473\t        return NULL;\n474\t\n475\t    return array->table[index];\n476\t}\n477\t\n478\tint json_array_set_new(json_t *json, size_t index, json_t *value) {\n479\t    json_array_t *array;\n480\t\n481\t    if (!value)\n482\t        return -1;\n483\t\n484\t    if (!json_is_array(json) || json == value) {\n485\t        json_decref(value);\n486\t        return -1;\n487\t    }\n488\t    array = json_to_array(json);\n489\t\n490\t    if (index >= array->entries) {\n491\t        json_decref(value);\n492\t        return -1;\n493\t    }\n494\t\n495\t    json_decref(array->table[index]);\n496\t    array->table[index] = value;\n497\t\n498\t    return 0;\n499\t}\n500\t\n501\tstatic void array_move(json_array_t *array, size_t dest, size_t src, size_t count) {\n502\t    memmove(&array->table[dest], &array->table[src], count * sizeof(json_t *));\n503\t}\n504\t\n505\tstatic void array_copy(json_t **dest, size_t dpos, json_t **src, size_t spos,\n506\t                       size_t count) {\n507\t    memcpy(&dest[dpos], &src[spos], count * sizeof(json_t *));\n508\t}\n509\t\n510\tstatic json_t **json_array_grow(json_array_t *array, size_t amount) {\n511\t    size_t new_size;\n512\t    json_t **old_table, **new_table;\n513\t\n514\t    if (array->entries + amount <= array->size)\n515\t        return array->table;\n516\t\n517\t    old_table = array->table;\n518\t\n519\t    new_size = max(array->size + amount, array->size * 2);\n520\t    new_table = jsonp_realloc(old_table, array->size * sizeof(json_t *),\n521\t                              new_size * sizeof(json_t *));\n522\t    if (!new_table)\n523\t        return NULL;\n524\t\n525\t    array->size = new_size;\n526\t    array->table = new_table;\n527\t\n528\t    return array->table;\n529\t}\n530\t\n531\tint json_array_append_new(json_t *json, json_t *value) {\n532\t    json_array_t *array;\n533\t\n534\t    if (!value)\n535\t        return -1;\n536\t\n537\t    if (!json_is_array(json) || json == value) {\n538\t        json_decref(value);\n539\t        return -1;\n540\t    }\n541\t    array = json_to_array(json);\n542\t\n543\t    if (!json_array_grow(array, 1)) {\n544\t        json_decref(value);\n545\t        return -1;\n546\t    }\n547\t\n548\t    array->table[array->entries] = value;\n549\t    array->entries++;\n550\t\n551\t    return 0;\n552\t}\n553\t\n554\tint json_array_insert_new(json_t *json, size_t index, json_t *value) {\n555\t    json_array_t *array;\n556\t\n557\t    if (!value)\n558\t        return -1;\n559\t\n560\t    if (!json_is_array(json) || json == value) {\n561\t        json_decref(value);\n562\t        return -1;\n563\t    }\n564\t    array = json_to_array(json);\n565\t\n566\t    if (index > array->entries) {\n567\t        json_decref(value);\n568\t        return -1;\n569\t    }\n570\t\n571\t    if (!json_array_grow(array, 1)) {\n572\t        json_decref(value);\n573\t        return -1;\n574\t    }\n575\t    if (index != array->entries)\n576\t        array_move(array, index + 1, index, array->entries - index);\n577\t\n578\t    array->table[index] = value;\n579\t    array->entries++;\n580\t\n581\t    return 0;\n582\t}\n583\t\n584\tint json_array_remove(json_t *json, size_t index) {\n585\t    json_array_t *array;\n586\t\n587\t    if (!json_is_array(json))\n588\t        return -1;\n589\t    array = json_to_array(json);\n590\t\n591\t    if (index >= array->entries)\n592\t        return -1;\n593\t\n594\t    json_decref(array->table[index]);\n595\t\n596\t    /* If we're removing the last element, nothing has to be moved */\n597\t    if (index < array->entries - 1)\n598\t        array_move(array, index, index + 1, array->entries - index - 1);\n599\t\n600\t    array->entries--;\n601\t\n602\t    return 0;\n603\t}\n604\t\n605\tint json_array_clear(json_t *json) {\n606\t    json_array_t *array;\n607\t    size_t i;\n608\t\n609\t    if (!json_is_array(json))\n610\t        return -1;\n611\t    array = json_to_array(json);\n612\t\n613\t    for (i = 0; i < array->entries; i++)\n614\t        json_decref(array->table[i]);\n615\t\n616\t    array->entries = 0;\n617\t    return 0;\n618\t}\n619\t\n620\tint json_array_extend(json_t *json, json_t *other_json) {\n621\t    json_array_t *array, *other;\n622\t    size_t i;\n623\t\n624\t    if (!json_is_array(json) || !json_is_array(other_json))\n625\t        return -1;\n626\t    array = json_to_array(json);\n627\t    other = json_to_array(other_json);\n628\t\n629\t    if (!json_array_grow(array, other->entries))\n630\t        return -1;\n631\t\n632\t    for (i = 0; i < other->entries; i++)\n633\t        json_incref(other->table[i]);\n634\t\n635\t    array_copy(array->table, array->entries, other->table, 0, other->entries);\n636\t\n637\t    array->entries += other->entries;\n638\t    return 0;\n639\t}\n640\t\n641\tstatic int json_array_equal(const json_t *array1, const json_t *array2) {\n642\t    size_t i, size;\n643\t\n644\t    size = json_array_size(array1);\n645\t    if (size != json_array_size(array2))\n646\t        return 0;\n647\t\n648\t    for (i = 0; i < size; i++) {\n649\t        json_t *value1, *value2;\n650\t\n651\t        value1 = json_array_get(array1, i);\n652\t        value2 = json_array_get(array2, i);\n653\t\n654\t        if (!json_equal(value1, value2))\n655\t            return 0;\n656\t    }\n657\t\n658\t    return 1;\n659\t}\n660\t\n661\tstatic json_t *json_array_copy(json_t *array) {\n662\t    json_t *result;\n663\t    size_t i;\n664\t\n665\t    result = json_array();\n666\t    if (!result)\n667\t        return NULL;\n668\t\n669\t    for (i = 0; i < json_array_size(array); i++)\n670\t        json_array_append(result, json_array_get(array, i));\n671\t\n672\t    return result;\n673\t}\n674\t\n675\tstatic json_t *json_array_deep_copy(const json_t *array, hashtable_t *parents) {\n676\t    json_t *result;\n677\t    size_t i;\n678\t    char loop_key[LOOP_KEY_LEN];\n679\t    size_t loop_key_len;\n680\t\n681\t    if (jsonp_loop_check(parents, array, loop_key, sizeof(loop_key), &loop_key_len))\n682\t        return NULL;\n683\t\n684\t    result = json_array();\n685\t    if (!result)\n686\t        goto out;\n687\t\n688\t    for (i = 0; i < json_array_size(array); i++) {\n689\t        if (json_array_append_new(result,\n690\t                                  do_deep_copy(json_array_get(array, i), parents))) {\n691\t            json_decref(result);\n692\t            result = NULL;\n693\t            break;\n694\t        }\n695\t    }\n696\t\n697\tout:\n698\t    hashtable_del(parents, loop_key, loop_key_len);\n699\t\n700\t    return result;\n701\t}\n702\t\n703\t/*** string ***/\n704\t\n705\tstatic json_t *string_create(const char *value, size_t len, int own) {\n706\t    char *v;\n707\t    json_string_t *string;\n708\t\n709\t    if (!value)\n710\t        return NULL;\n711\t\n712\t    if (own)\n713\t        v = (char *)value;\n714\t    else {\n715\t        v = jsonp_strndup(value, len);\n716\t        if (!v)\n717\t            return NULL;\n718\t    }\n719\t\n720\t    string = jsonp_malloc(sizeof(json_string_t));\n721\t    if (!string) {\n722\t        jsonp_free(v);\n723\t        return NULL;\n724\t    }\n725\t    json_init(&string->json, JSON_STRING);\n726\t    string->value = v;\n727\t    string->length = len;\n728\t\n729\t    return &string->json;\n730\t}\n731\t\n732\tjson_t *json_string_nocheck(const char *value) {\n733\t    if (!value)\n734\t        return NULL;\n735\t\n736\t    return string_create(value, strlen(value), 0);\n737\t}\n738\t\n739\tjson_t *json_stringn_nocheck(const char *value, size_t len) {\n740\t    return string_create(value, len, 0);\n741\t}\n742\t\n743\t/* this is private; \"steal\" is not a public API concept */\n744\tjson_t *jsonp_stringn_nocheck_own(const char *value, size_t len) {\n745\t    return string_create(value, len, 1);\n746\t}\n747\t\n748\tjson_t *json_string(const char *value) {\n749\t    if (!value)\n750\t        return NULL;\n751\t\n752\t    return json_stringn(value, strlen(value));\n753\t}\n754\t\n755\tjson_t *json_stringn(const char *value, size_t len) {\n756\t    if (!value || !utf8_check_string(value, len))\n757\t        return NULL;\n758\t\n759\t    return json_stringn_nocheck(value, len);\n760\t}\n761\t\n762\tconst char *json_string_value(const json_t *json) {\n763\t    if (!json_is_string(json))\n764\t        return NULL;\n765\t\n766\t    return json_to_string(json)->value;\n767\t}\n768\t\n769\tsize_t json_string_length(const json_t *json) {\n770\t    if (!json_is_string(json))\n771\t        return 0;\n772\t\n773\t    return json_to_string(json)->length;\n774\t}\n775\t\n776\tint json_string_set_nocheck(json_t *json, const char *value) {\n777\t    if (!value)\n778\t        return -1;\n779\t\n780\t    return json_string_setn_nocheck(json, value, strlen(value));\n781\t}\n782\t\n783\tint json_string_setn_nocheck(json_t *json, const char *value, size_t len) {\n784\t    char *dup;\n785\t    json_string_t *string;\n786\t\n787\t    if (!json_is_string(json) || !value)\n788\t        return -1;\n789\t\n790\t    dup = jsonp_strndup(value, len);\n791\t    if (!dup)\n792\t        return -1;\n793\t\n794\t    string = json_to_string(json);\n795\t    jsonp_free(string->value);\n796\t    string->value = dup;\n797\t    string->length = len;\n798\t\n799\t    return 0;\n800\t}\n801\t\n802\tint json_string_set(json_t *json, const char *value) {\n803\t    if (!value)\n804\t        return -1;\n805\t\n806\t    return json_string_setn(json, value, strlen(value));\n807\t}\n808\t\n809\tint json_string_setn(json_t *json, const char *value, size_t len) {\n810\t    if (!value || !utf8_check_string(value, len))\n811\t        return -1;\n812\t\n813\t    return json_string_setn_nocheck(json, value, len);\n814\t}\n815\t\n816\tstatic void json_delete_string(json_string_t *string) {\n817\t    jsonp_free(string->value);\n818\t    jsonp_free(string);\n819\t}\n820\t\n821\tstatic int json_string_equal(const json_t *string1, const json_t *string2) {\n822\t    json_string_t *s1, *s2;\n823\t\n824\t    s1 = json_to_string(string1);\n825\t    s2 = json_to_string(string2);\n826\t    return s1->length == s2->length && !memcmp(s1->value, s2->value, s1->length);\n827\t}\n828\t\n829\tstatic json_t *json_string_copy(const json_t *string) {\n830\t    json_string_t *s;\n831\t\n832\t    s = json_to_string(string);\n833\t    return json_stringn_nocheck(s->value, s->length);\n834\t}\n835\t\n836\tjson_t *json_vsprintf(const char *fmt, va_list ap) {\n837\t    json_t *json = NULL;\n838\t    int length;\n839\t    char *buf;\n840\t    va_list aq;\n841\t    va_copy(aq, ap);\n842\t\n843\t    length = vsnprintf(NULL, 0, fmt, ap);\n844\t    if (length < 0)\n845\t        goto out;\n846\t    if (length == 0) {\n847\t        json = json_string(\"\");\n848\t        goto out;\n849\t    }\n850\t\n851\t    buf = jsonp_malloc((size_t)length + 1);\n852\t    if (!buf)\n853\t        goto out;\n854\t\n855\t    vsnprintf(buf, (size_t)length + 1, fmt, aq);\n856\t    if (!utf8_check_string(buf, length)) {\n857\t        jsonp_free(buf);\n858\t        goto out;\n859\t    }\n860\t\n861\t    json = jsonp_stringn_nocheck_own(buf, length);\n862\t\n863\tout:\n864\t    va_end(aq);\n865\t    return json;\n866\t}\n867\t\n868\tjson_t *json_sprintf(const char *fmt, ...) {\n869\t    json_t *result;\n870\t    va_list ap;\n871\t\n872\t    va_start(ap, fmt);\n873\t    result = json_vsprintf(fmt, ap);\n874\t    va_end(ap);\n875\t\n876\t    return result;\n877\t}\n878\t\n879\t/*** integer ***/\n880\t\n881\tjson_t *json_integer(json_int_t value) {\n882\t    json_integer_t *integer = jsonp_malloc(sizeof(json_integer_t));\n883\t    if (!integer)\n884\t        return NULL;\n885\t    json_init(&integer->json, JSON_INTEGER);\n886\t\n887\t    integer->value = value;\n888\t    return &integer->json;\n889\t}\n890\t\n891\tjson_int_t json_integer_value(const json_t *json) {\n892\t    if (!json_is_integer(json))\n893\t        return 0;\n894\t\n895\t    return json_to_integer(json)->value;\n896\t}\n897\t\n898\tint json_integer_set(json_t *json, json_int_t value) {\n899\t    if (!json_is_integer(json))\n900\t        return -1;\n901\t\n902\t    json_to_integer(json)->value = value;\n903\t\n904\t    return 0;\n905\t}\n906\t\n907\tstatic void json_delete_integer(json_integer_t *integer) { jsonp_free(integer); }\n908\t\n909\tstatic int json_integer_equal(const json_t *integer1, const json_t *integer2) {\n910\t    return json_integer_value(integer1) == json_integer_value(integer2);\n911\t}\n912\t\n913\tstatic json_t *json_integer_copy(const json_t *integer) {\n914\t    return json_integer(json_integer_value(integer));\n915\t}\n916\t\n917\t/*** real ***/\n918\t\n919\tjson_t *json_real(double value) {\n920\t    json_real_t *real;\n921\t\n922\t    if (isnan(value) || isinf(value))\n923\t        return NULL;\n924\t\n925\t    real = jsonp_malloc(sizeof(json_real_t));\n926\t    if (!real)\n927\t        return NULL;\n928\t    json_init(&real->json, JSON_REAL);\n929\t\n930\t    real->value = value;\n931\t    return &real->json;\n932\t}\n933\t\n934\tdouble json_real_value(const json_t *json) {\n935\t    if (!json_is_real(json))\n936\t        return 0;\n937\t\n938\t    return json_to_real(json)->value;\n939\t}\n940\t\n941\tint json_real_set(json_t *json, double value) {\n942\t    if (!json_is_real(json) || isnan(value) || isinf(value))\n943\t        return -1;\n944\t\n945\t    json_to_real(json)->value = value;\n946\t\n947\t    return 0;\n948\t}\n949\t\n950\tstatic void json_delete_real(json_real_t *real) { jsonp_free(real); }\n951\t\n952\tstatic int json_real_equal(const json_t *real1, const json_t *real2) {\n953\t    return json_real_value(real1) == json_real_value(real2);\n954\t}\n955\t\n956\tstatic json_t *json_real_copy(const json_t *real) {\n957\t    return json_real(json_real_value(real));\n958\t}\n959\t\n960\t/*** number ***/\n961\t\n962\tdouble json_number_value(const json_t *json) {\n963\t    if (json_is_integer(json))\n964\t        return (double)json_integer_value(json);\n965\t    else if (json_is_real(json))\n966\t        return json_real_value(json);\n967\t    else\n968\t        return 0.0;\n969\t}\n970\t\n971\t/*** simple values ***/\n972\t\n973\tjson_t *json_true(void) {\n974\t    static json_t the_true = {JSON_TRUE, (size_t)-1};\n975\t    return &the_true;\n976\t}\n977\t\n978\tjson_t *json_false(void) {\n979\t    static json_t the_false = {JSON_FALSE, (size_t)-1};\n980\t    return &the_false;\n981\t}\n982\t\n983\tjson_t *json_null(void) {\n984\t    static json_t the_null = {JSON_NULL, (size_t)-1};\n985\t    return &the_null;\n986\t}\n987\t\n988\t/*** deletion ***/\n989\t\n990\tvoid json_delete(json_t *json) {\n991\t    if (!json)\n992\t        return;\n993\t\n994\t    switch (json_typeof(json)) {\n995\t        case JSON_OBJECT:\n996\t            json_delete_object(json_to_object(json));\n997\t            break;\n998\t        case JSON_ARRAY:\n999\t            json_delete_array(json_to_array(json));\n1000\t            break;\n1001\t        case JSON_STRING:\n1002\t            json_delete_string(json_to_string(json));\n1003\t            break;\n1004\t        case JSON_INTEGER:\n1005\t            json_delete_integer(json_to_integer(json));\n1006\t            break;\n1007\t        case JSON_REAL:\n1008\t            json_delete_real(json_to_real(json));\n1009\t            break;\n1010\t        default:\n1011\t            return;\n1012\t    }\n1013\t\n1014\t    /* json_delete is not called for true, false or null */\n1015\t}\n1016\t\n1017\t/*** equality ***/\n1018\t\n1019\tint json_equal(const json_t *json1, const json_t *json2) {\n1020\t    if (!json1 || !json2)\n1021\t        return 0;\n1022\t\n1023\t    if (json_typeof(json1) != json_typeof(json2))\n1024\t        return 0;\n1025\t\n1026\t    /* this covers true, false and null as they are singletons */\n1027\t    if (json1 == json2)\n1028\t        return 1;\n1029\t\n1030\t    switch (json_typeof(json1)) {\n1031\t        case JSON_OBJECT:\n1032\t            return json_object_equal(json1, json2);\n1033\t        case JSON_ARRAY:\n1034\t            return json_array_equal(json1, json2);\n1035\t        case JSON_STRING:\n1036\t            return json_string_equal(json1, json2);\n1037\t        case JSON_INTEGER:\n1038\t            return json_integer_equal(json1, json2);\n1039\t        case JSON_REAL:\n1040\t            return json_real_equal(json1, json2);\n1041\t        default:\n1042\t            return 0;\n1043\t    }\n1044\t}\n1045\t\n1046\t/*** copying ***/\n1047\t\n1048\tjson_t *json_copy(json_t *json) {\n1049\t    if (!json)\n1050\t        return NULL;\n1051\t\n1052\t    switch (json_typeof(json)) {\n1053\t        case JSON_OBJECT:\n1054\t            return json_object_copy(json);\n1055\t        case JSON_ARRAY:\n1056\t            return json_array_copy(json);\n1057\t        case JSON_STRING:\n1058\t            return json_string_copy(json);\n1059\t        case JSON_INTEGER:\n1060\t            return json_integer_copy(json);\n1061\t        case JSON_REAL:\n1062\t            return json_real_copy(json);\n1063\t        case JSON_TRUE:\n1064\t        case JSON_FALSE:\n1065\t        case JSON_NULL:\n1066\t            return json;\n1067\t        default:\n1068\t            return NULL;\n1069\t    }\n1070\t}\n1071\t\n1072\tjson_t *json_deep_copy(const json_t *json) {\n1073\t    json_t *res;\n1074\t    hashtable_t parents_set;\n1075\t\n1076\t    if (hashtable_init(&parents_set))\n1077\t        return NULL;\n1078\t    res = do_deep_copy(json, &parents_set);\n1079\t    hashtable_close(&parents_set);\n1080\t\n1081\t    return res;\n1082\t}\n1083\t\n1084\tjson_t *do_deep_copy(const json_t *json, hashtable_t *parents) {\n1085\t    if (!json)\n1086\t        return NULL;\n1087\t\n1088\t    switch (json_typeof(json)) {\n1089\t        case JSON_OBJECT:\n1090\t            return json_object_deep_copy(json, parents);\n1091\t        case JSON_ARRAY:\n1092\t            return json_array_deep_copy(json, parents);\n1093\t            /* for the rest of the types, deep copying doesn't differ from\n1094\t               shallow copying */\n1095\t        case JSON_STRING:\n1096\t            return json_string_copy(json);\n1097\t        case JSON_INTEGER:\n1098\t            return json_integer_copy(json);\n1099\t        case JSON_REAL:\n1100\t            return json_real_copy(json);\n1101\t        case JSON_TRUE:\n1102\t        case JSON_FALSE:\n1103\t        case JSON_NULL:\n1104\t            return (json_t *)json;\n1105\t        default:\n1106\t            return NULL;\n1107\t    }\n1108\t}\n1109\t"}]},"parent_tool_use_id":null,"session_id":"6e05495f-912c-47bf-afee-7047866965e6","uuid":"0a44ff7a-43b8-49ac-be9a-840a6994db02","timestamp":"2026-08-05T06:08:59.417Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-work-Rb2qmv/translated_rust/c_src/src/value.c","content":"/*\n * Copyright (c) 2009-2016 Petri Lehtinen <petri@digip.org>\n *\n * Jansson is free software; you can redistribute it and/or modify\n * it under the terms of the MIT license. See LICENSE for details.\n */\n\n#ifndef _GNU_SOURCE\n#define _GNU_SOURCE\n#endif\n\n#ifdef HAVE_CONFIG_H\n#include <jansson_private_config.h>\n#endif\n\n#include <math.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <string.h>\n\n#ifdef HAVE_STDINT_H\n#include <stdint.h>\n#endif\n\n#include \"hashtable.h\"\n#include \"jansson.h\"\n#include \"jansson_private.h\"\n#include \"utf.h\"\n\n/* Work around nonstandard isnan() and isinf() implementations */\n#ifndef isnan\n#ifndef __sun\nstatic JSON_INLINE int isnan(double x) { return x != x; }\n#endif\n#endif\n#ifndef isinf\nstatic JSON_INLINE int isinf(double x) { return !isnan(x) && isnan(x - x); }\n#endif\n\njson_t *do_deep_copy(const json_t *json, hashtable_t *parents);\n\nstatic JSON_INLINE void json_init(json_t *json, json_type type) {\n    json->type = type;\n    json->refcount = 1;\n}\n\nint jsonp_loop_check(hashtable_t *parents, const json_t *json, char *key, size_t key_size,\n                     size_t *key_len_out) {\n    size_t key_len = snprintf(key, key_size, \"%p\", json);\n\n    if (key_len_out)\n        *key_len_out = key_len;\n\n    if (hashtable_get(parents, key, key_len))\n        return -1;\n\n    return hashtable_set(parents, key, key_len, json_null());\n}\n\n/*** object ***/\n\nextern volatile uint32_t hashtable_seed;\n\njson_t *json_object(void) {\n    json_object_t *object = jsonp_malloc(sizeof(json_object_t));\n    if (!object)\n        return NULL;\n\n    if (!hashtable_seed) {\n        /* Autoseed */\n        json_object_seed(0);\n    }\n\n    json_init(&object->json, JSON_OBJECT);\n\n    if (hashtable_init(&object->hashtable)) {\n        jsonp_free(object);\n        return NULL;\n    }\n\n    return &object->json;\n}\n\nstatic void json_delete_object(json_object_t *object) {\n    hashtable_close(&object->hashtable);\n    jsonp_free(object);\n}\n\nsize_t json_object_size(const json_t *json) {\n    json_object_t *object;\n\n    if (!json_is_object(json))\n        return 0;\n\n    object = json_to_object(json);\n    return object->hashtable.size;\n}\n\njson_t *json_object_get(const json_t *json, const char *key) {\n    if (!key)\n        return NULL;\n\n    return json_object_getn(json, key, strlen(key));\n}\n\njson_t *json_object_getn(const json_t *json, const char *key, size_t key_len) {\n    json_object_t *object;\n\n    if (!key || !json_is_object(json))\n        return NULL;\n\n    object = json_to_object(json);\n    return hashtable_get(&object->hashtable, key, key_len);\n}\n\nint json_object_set_new_nocheck(json_t *json, const char *key, json_t *value) {\n    if (!key) {\n        json_decref(value);\n        return -1;\n    }\n    return json_object_setn_new_nocheck(json, key, strlen(key), value);\n}\n\nint json_object_setn_new_nocheck(json_t *json, const char *key, size_t key_len,\n                                 json_t *value) {\n    json_object_t *object;\n\n    if (!value)\n        return -1;\n\n    if (!key || !json_is_object(json) || json == value) {\n        json_decref(value);\n        return -1;\n    }\n    object = json_to_object(json);\n\n    if (hashtable_set(&object->hashtable, key, key_len, value)) {\n        json_decref(value);\n        return -1;\n    }\n\n    return 0;\n}\n\nint json_object_set_new(json_t *json, const char *key, json_t *value) {\n    if (!key) {\n        json_decref(value);\n        return -1;\n    }\n\n    return json_object_setn_new(json, key, strlen(key), value);\n}\n\nint json_object_setn_new(json_t *json, const char *key, size_t key_len, json_t *value) {\n    if (!key || !utf8_check_string(key, key_len)) {\n        json_decref(value);\n        return -1;\n    }\n\n    return json_object_setn_new_nocheck(json, key, key_len, value);\n}\n\nint json_object_del(json_t *json, const char *key) {\n    if (!key)\n        return -1;\n\n    return json_object_deln(json, key, strlen(key));\n}\n\nint json_object_deln(json_t *json, const char *key, size_t key_len) {\n    json_object_t *object;\n\n    if (!key || !json_is_object(json))\n        return -1;\n\n    object = json_to_object(json);\n    return hashtable_del(&object->hashtable, key, key_len);\n}\n\nint json_object_clear(json_t *json) {\n    json_object_t *object;\n\n    if (!json_is_object(json))\n        return -1;\n\n    object = json_to_object(json);\n    hashtable_clear(&object->hashtable);\n\n    return 0;\n}\n\nint json_object_update(json_t *object, json_t *other) {\n    const char *key;\n    size_t key_len;\n    json_t *value;\n\n    if (!json_is_object(object) || !json_is_object(other))\n        return -1;\n\n    json_object_keylen_foreach(other, key, key_len, value) {\n        if (json_object_setn_nocheck(object, key, key_len, value))\n            return -1;\n    }\n\n    return 0;\n}\n\nint json_object_update_existing(json_t *object, json_t *other) {\n    const char *key;\n    size_t key_len;\n    json_t *value;\n\n    if (!json_is_object(object) || !json_is_object(other))\n        return -1;\n\n    json_object_keylen_foreach(other, key, key_len, value) {\n        if (json_object_getn(object, key, key_len))\n            json_object_setn_nocheck(object, key, key_len, value);\n    }\n\n    return 0;\n}\n\nint json_object_update_missing(json_t *object, json_t *other) {\n    const char *key;\n    size_t key_len;\n    json_t *value;\n\n    if (!json_is_object(object) || !json_is_object(other))\n        return -1;\n\n    json_object_keylen_foreach(other, key, key_len, value) {\n        if (!json_object_getn(object, key, key_len))\n            json_object_setn_nocheck(object, key, key_len, value);\n    }\n\n    return 0;\n}\n\nint do_object_update_recursive(json_t *object, json_t *other, hashtable_t *parents) {\n    const char *key;\n    size_t key_len;\n    json_t *value;\n    char loop_key[LOOP_KEY_LEN];\n    int res = 0;\n    size_t loop_key_len;\n\n    if (!json_is_object(object) || !json_is_object(other))\n        return -1;\n\n    if (jsonp_loop_check(parents, other, loop_key, sizeof(loop_key), &loop_key_len))\n        return -1;\n\n    json_object_keylen_foreach(other, key, key_len, value) {\n        json_t *v = json_object_getn(object, key, key_len);\n\n        if (json_is_object(v) && json_is_object(value)) {\n            if (do_object_update_recursive(v, value, parents)) {\n                res = -1;\n                break;\n            }\n        } else {\n            if (json_object_setn_nocheck(object, key, key_len, value)) {\n                res = -1;\n                break;\n            }\n        }\n    }\n\n    hashtable_del(parents, loop_key, loop_key_len);\n\n    return res;\n}\n\nint json_object_update_recursive(json_t *object, json_t *other) {\n    int res;\n    hashtable_t parents_set;\n\n    if (hashtable_init(&parents_set))\n        return -1;\n    res = do_object_update_recursive(object, other, &parents_set);\n    hashtable_close(&parents_set);\n\n    return res;\n}\n\nvoid *json_object_iter(json_t *json) {\n    json_object_t *object;\n\n    if (!json_is_object(json))\n        return NULL;\n\n    object = json_to_object(json);\n    return hashtable_iter(&object->hashtable);\n}\n\nvoid *json_object_iter_at(json_t *json, const char *key) {\n    json_object_t *object;\n\n    if (!key || !json_is_object(json))\n        return NULL;\n\n    object = json_to_object(json);\n    return hashtable_iter_at(&object->hashtable, key, strlen(key));\n}\n\nvoid *json_object_iter_next(json_t *json, void *iter) {\n    json_object_t *object;\n\n    if (!json_is_object(json) || iter == NULL)\n        return NULL;\n\n    object = json_to_object(json);\n    return hashtable_iter_next(&object->hashtable, iter);\n}\n\nconst char *json_object_iter_key(void *iter) {\n    if (!iter)\n        return NULL;\n\n    return hashtable_iter_key(iter);\n}\n\nsize_t json_object_iter_key_len(void *iter) {\n    if (!iter)\n        return 0;\n\n    return hashtable_iter_key_len(iter);\n}\n\njson_t *json_object_iter_value(void *iter) {\n    if (!iter)\n        return NULL;\n\n    return (json_t *)hashtable_iter_value(iter);\n}\n\nint json_object_iter_set_new(json_t *json, void *iter, json_t *value) {\n    if (!json_is_object(json) || !iter || !value) {\n        json_decref(value);\n        return -1;\n    }\n\n    hashtable_iter_set(iter, value);\n    return 0;\n}\n\nvoid *json_object_key_to_iter(const char *key) {\n    if (!key)\n        return NULL;\n\n    return hashtable_key_to_iter(key);\n}\n\nstatic int json_object_equal(const json_t *object1, const json_t *object2) {\n    const char *key;\n    size_t key_len;\n    const json_t *value1, *value2;\n\n    if (json_object_size(object1) != json_object_size(object2))\n        return 0;\n\n    json_object_keylen_foreach((json_t *)object1, key, key_len, value1) {\n        value2 = json_object_getn(object2, key, key_len);\n\n        if (!json_equal(value1, value2))\n            return 0;\n    }\n\n    return 1;\n}\n\nstatic json_t *json_object_copy(json_t *object) {\n    json_t *result;\n\n    const char *key;\n    size_t key_len;\n    json_t *value;\n\n    result = json_object();\n    if (!result)\n        return NULL;\n\n    json_object_keylen_foreach(object, key, key_len, value)\n        json_object_setn_nocheck(result, key, key_len, value);\n\n    return result;\n}\n\nstatic json_t *json_object_deep_copy(const json_t *object, hashtable_t *parents) {\n    json_t *result;\n    void *iter;\n    char loop_key[LOOP_KEY_LEN];\n    size_t loop_key_len;\n\n    if (jsonp_loop_check(parents, object, loop_key, sizeof(loop_key), &loop_key_len))\n        return NULL;\n\n    result = json_object();\n    if (!result)\n        goto out;\n\n    /* Cannot use json_object_foreach because object has to be cast\n       non-const */\n    iter = json_object_iter((json_t *)object);\n    while (iter) {\n        const char *key;\n        size_t key_len;\n        const json_t *value;\n        key = json_object_iter_key(iter);\n        key_len = json_object_iter_key_len(iter);\n        value = json_object_iter_value(iter);\n\n        if (json_object_setn_new_nocheck(result, key, key_len,\n                                         do_deep_copy(value, parents))) {\n            json_decref(result);\n            result = NULL;\n            break;\n        }\n        iter = json_object_iter_next((json_t *)object, iter);\n    }\n\nout:\n    hashtable_del(parents, loop_key, loop_key_len);\n\n    return result;\n}\n\n/*** array ***/\n\njson_t *json_array(void) {\n    json_array_t *array = jsonp_malloc(sizeof(json_array_t));\n    if (!array)\n        return NULL;\n    json_init(&array->json, JSON_ARRAY);\n\n    array->entries = 0;\n    array->size = 8;\n\n    array->table = jsonp_malloc(array->size * sizeof(json_t *));\n    if (!array->table) {\n        jsonp_free(array);\n        return NULL;\n    }\n\n    return &array->json;\n}\n\nstatic void json_delete_array(json_array_t *array) {\n    size_t i;\n\n    for (i = 0; i < array->entries; i++)\n        json_decref(array->table[i]);\n\n    jsonp_free(array->table);\n    jsonp_free(array);\n}\n\nsize_t json_array_size(const json_t *json) {\n    if (!json_is_array(json))\n        return 0;\n\n    return json_to_array(json)->entries;\n}\n\njson_t *json_array_get(const json_t *json, size_t index) {\n    json_array_t *array;\n    if (!json_is_array(json))\n        return NULL;\n    array = json_to_array(json);\n\n    if (index >= array->entries)\n        return NULL;\n\n    return array->table[index];\n}\n\nint json_array_set_new(json_t *json, size_t index, json_t *value) {\n    json_array_t *array;\n\n    if (!value)\n        return -1;\n\n    if (!json_is_array(json) || json == value) {\n        json_decref(value);\n        return -1;\n    }\n    array = json_to_array(json);\n\n    if (index >= array->entries) {\n        json_decref(value);\n        return -1;\n    }\n\n    json_decref(array->table[index]);\n    array->table[index] = value;\n\n    return 0;\n}\n\nstatic void array_move(json_array_t *array, size_t dest, size_t src, size_t count) {\n    memmove(&array->table[dest], &array->table[src], count * sizeof(json_t *));\n}\n\nstatic void array_copy(json_t **dest, size_t dpos, json_t **src, size_t spos,\n                       size_t count) {\n    memcpy(&dest[dpos], &src[spos], count * sizeof(json_t *));\n}\n\nstatic json_t **json_array_grow(json_array_t *array, size_t amount) {\n    size_t new_size;\n    json_t **old_table, **new_table;\n\n    if (array->entries + amount <= array->size)\n        return array->table;\n\n    old_table = array->table;\n\n    new_size = max(array->size + amount, array->size * 2);\n    new_table = jsonp_realloc(old_table, array->size * sizeof(json_t *),\n                              new_size * sizeof(json_t *));\n    if (!new_table)\n        return NULL;\n\n    array->size = new_size;\n    array->table = new_table;\n\n    return array->table;\n}\n\nint json_array_append_new(json_t *json, json_t *value) {\n    json_array_t *array;\n\n    if (!value)\n        return -1;\n\n    if (!json_is_array(json) || json == value) {\n        json_decref(value);\n        return -1;\n    }\n    array = json_to_array(json);\n\n    if (!json_array_grow(array, 1)) {\n        json_decref(value);\n        return -1;\n    }\n\n    array->table[array->entries] = value;\n    array->entries++;\n\n    return 0;\n}\n\nint json_array_insert_new(json_t *json, size_t index, json_t *value) {\n    json_array_t *array;\n\n    if (!value)\n        return -1;\n\n    if (!json_is_array(json) || json == value) {\n        json_decref(value);\n        return -1;\n    }\n    array = json_to_array(json);\n\n    if (index > array->entries) {\n        json_decref(value);\n        return -1;\n    }\n\n    if (!json_array_grow(array, 1)) {\n        json_decref(value);\n        return -1;\n    }\n    if (index != array->entries)\n        array_move(array, index + 1, index, array->entries - index);\n\n    array->table[index] = value;\n    array->entries++;\n\n    return 0;\n}\n\nint json_array_remove(json_t *json, size_t index) {\n    json_array_t *array;\n\n    if (!json_is_array(json))\n        return -1;\n    array = json_to_array(json);\n\n    if (index >= array->entries)\n        return -1;\n\n    json_decref(array->table[index]);\n\n    /* If we're removing the last element, nothing has to be moved */\n    if (index < array->entries - 1)\n        array_move(array, index, index + 1, array->entries - index - 1);\n\n    array->entries--;\n\n    return 0;\n}\n\nint json_array_clear(json_t *json) {\n    json_array_t *array;\n    size_t i;\n\n    if (!json_is_array(json))\n        return -1;\n    array = json_to_array(json);\n\n    for (i = 0; i < array->entries; i++)\n        json_decref(array->table[i]);\n\n    array->entries = 0;\n    return 0;\n}\n\nint json_array_extend(json_t *json, json_t *other_json) {\n    json_array_t *array, *other;\n    size_t i;\n\n    if (!json_is_array(json) || !json_is_array(other_json))\n        return -1;\n    array = json_to_array(json);\n    other = json_to_array(other_json);\n\n    if (!json_array_grow(array, other->entries))\n        return -1;\n\n    for (i = 0; i < other->entries; i++)\n        json_incref(other->table[i]);\n\n    array_copy(array->table, array->entries, other->table, 0, other->entries);\n\n    array->entries += other->entries;\n    return 0;\n}\n\nstatic int json_array_equal(const json_t *array1, const json_t *array2) {\n    size_t i, size;\n\n    size = json_array_size(array1);\n    if (size != json_array_size(array2))\n        return 0;\n\n    for (i = 0; i < size; i++) {\n        json_t *value1, *value2;\n\n        value1 = json_array_get(array1, i);\n        value2 = json_array_get(array2, i);\n\n        if (!json_equal(value1, value2))\n            return 0;\n    }\n\n    return 1;\n}\n\nstatic json_t *json_array_copy(json_t *array) {\n    json_t *result;\n    size_t i;\n\n    result = json_array();\n    if (!result)\n        return NULL;\n\n    for (i = 0; i < json_array_size(array); i++)\n        json_array_append(result, json_array_get(array, i));\n\n    return result;\n}\n\nstatic json_t *json_array_deep_copy(const json_t *array, hashtable_t *parents) {\n    json_t *result;\n    size_t i;\n    char loop_key[LOOP_KEY_LEN];\n    size_t loop_key_len;\n\n    if (jsonp_loop_check(parents, array, loop_key, sizeof(loop_key), &loop_key_len))\n        return NULL;\n\n    result = json_array();\n    if (!result)\n        goto out;\n\n    for (i = 0; i < json_array_size(array); i++) {\n        if (json_array_append_new(result,\n                                  do_deep_copy(json_array_get(array, i), parents))) {\n            json_decref(result);\n            result = NULL;\n            break;\n        }\n    }\n\nout:\n    hashtable_del(parents, loop_key, loop_key_len);\n\n    return result;\n}\n\n/*** string ***/\n\nstatic json_t *string_create(const char *value, size_t len, int own) {\n    char *v;\n    json_string_t *string;\n\n    if (!value)\n        return NULL;\n\n    if (own)\n        v = (char *)value;\n    else {\n        v = jsonp_strndup(value, len);\n        if (!v)\n            return NULL;\n    }\n\n    string = jsonp_malloc(sizeof(json_string_t));\n    if (!string) {\n        jsonp_free(v);\n        return NULL;\n    }\n    json_init(&string->json, JSON_STRING);\n    string->value = v;\n    string->length = len;\n\n    return &string->json;\n}\n\njson_t *json_string_nocheck(const char *value) {\n    if (!value)\n        return NULL;\n\n    return string_create(value, strlen(value), 0);\n}\n\njson_t *json_stringn_nocheck(const char *value, size_t len) {\n    return string_create(value, len, 0);\n}\n\n/* this is private; \"steal\" is not a public API concept */\njson_t *jsonp_stringn_nocheck_own(const char *value, size_t len) {\n    return string_create(value, len, 1);\n}\n\njson_t *json_string(const char *value) {\n    if (!value)\n        return NULL;\n\n    return json_stringn(value, strlen(value));\n}\n\njson_t *json_stringn(const char *value, size_t len) {\n    if (!value || !utf8_check_string(value, len))\n        return NULL;\n\n    return json_stringn_nocheck(value, len);\n}\n\nconst char *json_string_value(const json_t *json) {\n    if (!json_is_string(json))\n        return NULL;\n\n    return json_to_string(json)->value;\n}\n\nsize_t json_string_length(const json_t *json) {\n    if (!json_is_string(json))\n        return 0;\n\n    return json_to_string(json)->length;\n}\n\nint json_string_set_nocheck(json_t *json, const char *value) {\n    if (!value)\n        return -1;\n\n    return json_string_setn_nocheck(json, value, strlen(value));\n}\n\nint json_string_setn_nocheck(json_t *json, const char *value, size_t len) {\n    char *dup;\n    json_string_t *string;\n\n    if (!json_is_string(json) || !value)\n        return -1;\n\n    dup = jsonp_strndup(value, len);\n    if (!dup)\n        return -1;\n\n    string = json_to_string(json);\n    jsonp_free(string->value);\n    string->value = dup;\n    string->length = len;\n\n    return 0;\n}\n\nint json_string_set(json_t *json, const char *value) {\n    if (!value)\n        return -1;\n\n    return json_string_setn(json, value, strlen(value));\n}\n\nint json_string_setn(json_t *json, const char *value, size_t len) {\n    if (!value || !utf8_check_string(value, len))\n        return -1;\n\n    return json_string_setn_nocheck(json, value, len);\n}\n\nstatic void json_delete_string(json_string_t *string) {\n    jsonp_free(string->value);\n    jsonp_free(string);\n}\n\nstatic int json_string_equal(const json_t *string1, const json_t *string2) {\n    json_string_t *s1, *s2;\n\n    s1 = json_to_string(string1);\n    s2 = json_to_string(string2);\n    return s1->length == s2->length && !memcmp(s1->value, s2->value, s1->length);\n}\n\nstatic json_t *json_string_copy(const json_t *string) {\n    json_string_t *s;\n\n    s = json_to_string(string);\n    return json_stringn_nocheck(s->value, s->length);\n}\n\njson_t *json_vsprintf(const char *fmt, va_list ap) {\n    json_t *json = NULL;\n    int length;\n    char *buf;\n    va_list aq;\n    va_copy(aq, ap);\n\n    length = vsnprintf(NULL, 0, fmt, ap);\n    if (length < 0)\n        goto out;\n    if (length == 0) {\n        json = json_string(\"\");\n        goto out;\n    }\n\n    buf = jsonp_malloc((size_t)length + 1);\n    if (!buf)\n        goto out;\n\n    vsnprintf(buf, (size_t)length + 1, fmt, aq);\n    if (!utf8_check_string(buf, length)) {\n        jsonp_free(buf);\n        goto out;\n    }\n\n    json = jsonp_stringn_nocheck_own(buf, length);\n\nout:\n    va_end(aq);\n    return json;\n}\n\njson_t *json_sprintf(const char *fmt, ...) {\n    json_t *result;\n    va_list ap;\n\n    va_start(ap, fmt);\n    result = json_vsprintf(fmt, ap);\n    va_end(ap);\n\n    return result;\n}\n\n/*** integer ***/\n\njson_t *json_integer(json_int_t value) {\n    json_integer_t *integer = jsonp_malloc(sizeof(json_integer_t));\n    if (!integer)\n        return NULL;\n    json_init(&integer->json, JSON_INTEGER);\n\n    integer->value = value;\n    return &integer->json;\n}\n\njson_int_t json_integer_value(const json_t *json) {\n    if (!json_is_integer(json))\n        return 0;\n\n    return json_to_integer(json)->value;\n}\n\nint json_integer_set(json_t *json, json_int_t value) {\n    if (!json_is_integer(json))\n        return -1;\n\n    json_to_integer(json)->value = value;\n\n    return 0;\n}\n\nstatic void json_delete_integer(json_integer_t *integer) { jsonp_free(integer); }\n\nstatic int json_integer_equal(const json_t *integer1, const json_t *integer2) {\n    return json_integer_value(integer1) == json_integer_value(integer2);\n}\n\nstatic json_t *json_integer_copy(const json_t *integer) {\n    return json_integer(json_integer_value(integer));\n}\n\n/*** real ***/\n\njson_t *json_real(double value) {\n    json_real_t *real;\n\n    if (isnan(value) || isinf(value))\n        return NULL;\n\n    real = jsonp_malloc(sizeof(json_real_t));\n    if (!real)\n        return NULL;\n    json_init(&real->json, JSON_REAL);\n\n    real->value = value;\n    return &real->json;\n}\n\ndouble json_real_value(const json_t *json) {\n    if (!json_is_real(json))\n        return 0;\n\n    return json_to_real(json)->value;\n}\n\nint json_real_set(json_t *json, double value) {\n    if (!json_is_real(json) || isnan(value) || isinf(value))\n        return -1;\n\n    json_to_real(json)->value = value;\n\n    return 0;\n}\n\nstatic void json_delete_real(json_real_t *real) { jsonp_free(real); }\n\nstatic int json_real_equal(const json_t *real1, const json_t *real2) {\n    return json_real_value(real1) == json_real_value(real2);\n}\n\nstatic json_t *json_real_copy(const json_t *real) {\n    return json_real(json_real_value(real));\n}\n\n/*** number ***/\n\ndouble json_number_value(const json_t *json) {\n    if (json_is_integer(json))\n        return (double)json_integer_value(json);\n    else if (json_is_real(json))\n        return json_real_value(json);\n    else\n        return 0.0;\n}\n\n/*** simple values ***/\n\njson_t *json_true(void) {\n    static json_t the_true = {JSON_TRUE, (size_t)-1};\n    return &the_true;\n}\n\njson_t *json_false(void) {\n    static json_t the_false = {JSON_FALSE, (size_t)-1};\n    return &the_false;\n}\n\njson_t *json_null(void) {\n    static json_t the_null = {JSON_NULL, (size_t)-1};\n    return &the_null;\n}\n\n/*** deletion ***/\n\nvoid json_delete(json_t *json) {\n    if (!json)\n        return;\n\n    switch (json_typeof(json)) {\n        case JSON_OBJECT:\n            json_delete_object(json_to_object(json));\n            break;\n        case JSON_ARRAY:\n            json_delete_array(json_to_array(json));\n            break;\n        case JSON_STRING:\n            json_delete_string(json_to_string(json));\n            break;\n        case JSON_INTEGER:\n            json_delete_integer(json_to_integer(json));\n            break;\n        case JSON_REAL:\n            json_delete_real(json_to_real(json));\n            break;\n        default:\n            return;\n    }\n\n    /* json_delete is not called for true, false or null */\n}\n\n/*** equality ***/\n\nint json_equal(const json_t *json1, const json_t *json2) {\n    if (!json1 || !json2)\n        return 0;\n\n    if (json_typeof(json1) != json_typeof(json2))\n        return 0;\n\n    /* this covers true, false and null as they are singletons */\n    if (json1 == json2)\n        return 1;\n\n    switch (json_typeof(json1)) {\n        case JSON_OBJECT:\n            return json_object_equal(json1, json2);\n        case JSON_ARRAY:\n            return json_array_equal(json1, json2);\n        case JSON_STRING:\n            return json_string_equal(json1, json2);\n        case JSON_INTEGER:\n            return json_integer_equal(json1, json2);\n        case JSON_REAL:\n            return json_real_equal(json1, json2);\n        default:\n            return 0;\n    }\n}\n\n/*** copying ***/\n\njson_t *json_copy(json_t *json) {\n    if (!json)\n        return NULL;\n\n    switch (json_typeof(json)) {\n        case JSON_OBJECT:\n            return json_object_copy(json);\n        case JSON_ARRAY:\n            return json_array_copy(json);\n        case JSON_STRING:\n            return json_string_copy(json);\n        case JSON_INTEGER:\n            return json_integer_copy(json);\n        case JSON_REAL:\n            return json_real_copy(json);\n        case JSON_TRUE:\n        case JSON_FALSE:\n        case JSON_NULL:\n            return json;\n        default:\n            return NULL;\n    }\n}\n\njson_t *json_deep_copy(const json_t *json) {\n    json_t *res;\n    hashtable_t parents_set;\n\n    if (hashtable_init(&parents_set))\n        return NULL;\n    res = do_deep_copy(json, &parents_set);\n    hashtable_close(&parents_set);\n\n    return res;\n}\n\njson_t *do_deep_copy(const json_t *json, hashtable_t *parents) {\n    if (!json)\n        return NULL;\n\n    switch (json_typeof(json)) {\n        case JSON_OBJECT:\n            return json_object_deep_copy(json, parents);\n        case JSON_ARRAY:\n            return json_array_deep_copy(json, parents);\n            /* for the rest of the types, deep copying doesn't differ from\n               shallow copying */\n        case JSON_STRING:\n            return json_string_copy(json);\n        case JSON_INTEGER:\n            return json_integer_copy(json);\n        case JSON_REAL:\n            return json_real_copy(json);\n        case JSON_TRUE:\n        case JSON_FALSE:\n        case JSON_NULL:\n            return (json_t *)json;\n        default:\n            return NULL;\n    }\n}\n","numLines":1109,"startLine":1,"totalLines":1109}}}
