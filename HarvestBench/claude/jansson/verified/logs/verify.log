d = if depth == 0 {\n        rng.below(5) // scalars only\n    } else {\n        rng.below(7)\n    };\n    match kind {\n        0 => {\n            // integer\n            let v = rng.next() as i64;\n            format!(\"{}\", v)\n        }\n        1 => {\n            // real\n            let mant = (rng.next() % 1_000_000) as f64;\n            let exp = (rng.below(20) as i64) - 10;\n            format!(\"{}e{}\", mant, exp)\n        }\n        2 => {\n            let mut s = String::new();\n            json_escape_into(&mut s, &rand_string(rng));\n            s\n        }\n        3 => \"true\".into(),\n        4 => match rng.below(2) {\n            0 => \"false\".into(),\n            _ => \"null\".into(),\n        },\n        5 => {\n            // array\n            let n = rng.below(5);\n            let mut s = String::from(\"[\");\n            for i in 0..n {\n                if i > 0 {\n                    s.push(',');\n                }\n                s.push_str(&gen_json(rng, depth - 1));\n            }\n            s.push(']');\n            s\n        }\n        _ => {\n            // object with unique keys\n            let n = rng.below(5);\n            let mut s = String::from(\"{\");\n            for i in 0..n {\n                if i > 0 {\n                    s.push(',');\n                }\n                let mut k = String::new();\n                json_escape_into(&mut k, &format!(\"k{}_{}\", i, rng.below(1000)));\n                s.push_str(&k);\n                s.push(':');\n                s.push_str(&gen_json(rng, depth - 1));\n            }\n            s.push('}');\n            s\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1898,"cache_read_input_tokens":55928,"cache_creation":{"ephemeral_5m_input_tokens":1898,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"sess