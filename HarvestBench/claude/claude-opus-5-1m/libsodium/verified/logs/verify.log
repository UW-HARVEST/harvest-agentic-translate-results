{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01M9RVPuMBy3c1qW1T4pMPaK","type":"tool_result","content":"1\t//! Phase C — AEAD error paths (`ERRORS.md` rows for the `crypto_aead_*` group).\n2\t//!\n3\t//! Two kinds of row:\n4\t//!\n5\t//! * **`return -1` rows** — called directly on both `.so`s; the return value,\n6\t//!   the out-parameters (`*mlen_p`) and the output buffer contents (whether the\n7\t//!   plaintext got zeroed) must match byte-for-byte.\n8\t//! * **`sodium_misuse()` rows** — `sodium_misuse()` runs the installed handler\n9\t//!   and then `abort()`s. Each such row is run in a **child process** (once\n10\t//!   against the C `.so`, once against the Rust `.so`) with an observing\n11\t//!   handler installed, so the abort *and* the side effects written before it\n12\t//!   are compared exactly.\n13\t\n14\tmod common;\n15\tuse common::*;\n16\t\n17\ttype Enc = unsafe extern \"C\" fn(\n18\t    *mut u8, *mut u64, *const u8, u64, *const u8, u64, *const u8, *const u8, *const u8,\n19\t) -> i32;\n20\ttype Dec = unsafe extern \"C\" fn(\n21\t    *mut u8, *mut u64, *mut u8, *const u8, u64, *const u8, u64, *const u8, *const u8,\n22\t) -> i32;\n23\ttype EncDet = unsafe extern \"C\" fn(\n24\t    *mut u8, *mut u8, *mut u64, *const u8, u64, *const u8, u64, *const u8, *const u8, *const u8,\n25\t) -> i32;\n26\ttype DecDet = unsafe extern \"C\" fn(\n27\t    *mut u8, *mut u8, *const u8, u64, *const u8, *const u8, u64, *const u8, *const u8,\n28\t) -> i32;\n29\t\n30\tconst AEADS: &[&str] = &[\n31\t    \"crypto_aead_aegis128l\",\n32\t    \"crypto_aead_aegis256\",\n33\t    \"crypto_aead_chacha20poly1305\",\n34\t    \"crypto_aead_chacha20poly1305_ietf\",\n35\t    \"crypto_aead_xchacha20poly1305_ietf\",\n36\t];\n37\t\n38\tfn g(p: &str, s: &str) -> usize {\n39\t    unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{p}_{s}\"))() }\n40\t}\n41\tfn gmax(p: &str) -> u64 {\n42\t    unsafe { sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), &format!(\"{p}_messagebytes_max\"))() }\n43\t}\n44\t\n45\t// ===========================================================================\n46\t// `return -1` rows\n47\t// ===========================================================================\n48\t\n49\t/// ERRORS rows: `_decrypt` with `clen < ABYTES` (0 and ABYTES-1) —\n50\t/// returns -1, `*mlen_p` set to 0, output buffer untouched.\n51\t#[test]\n52\tfn decrypt_clen_below_abytes() {\n53\t    setup();\n54\t    let mut rng = Rng::new(0x9000);\n55\t    for &p in AEADS {\n56\t        let ab = g(p, \"abytes\");\n57\t        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n58\t        for clen in 0..=ab {\n59\t            if clen == ab {\n60\t                continue; // ab itself is valid (mlen = 0)\n61\t            }\n62\t            let k = rng.bytes(g(p, \"keybytes\"));\n63\t            let npub = rng.bytes(g(p, \"npubbytes\"));\n64\t            let c = rng.bytes(ab.max(1));\n65\t            for mlen_p_null in [false, true] {\n66\t                let mut m1 = canary(64);\n67\t                let mut m2 = canary(64);\n68\t                let mut o1 = 0xDEAD_BEEF_u64;\n69\t                let mut o2 = 0xDEAD_BEEF_u64;\n70\t                let (p1, p2) = if mlen_p_null {\n71\t                    (std::ptr::null_mut(), std::ptr::null_mut())\n72\t                } else {\n73\t                    (&raw mut o1, &raw mut o2)\n74\t                };\n75\t                let (ra, rb) = unsafe {\n76\t                    (\n77\t                        cd(m1.as_mut_ptr(), p1, std::ptr::null_mut(), c.as_ptr(),\n78\t                           clen as u64, std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n79\t                        rd(m2.as_mut_ptr(), p2, std::ptr::null_mut(), c.as_ptr(),\n80\t                           clen as u64, std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n81\t                    )\n82\t                };\n83\t                eq_i32(&format!(\"{p}_decrypt(clen={clen}) rc\"), ra, rb);\n84\t                assert_eq!(ra, -1, \"{p}_decrypt(clen={clen}) must reject\");\n85\t                eq_usize(&format!(\"{p}_decrypt(clen={clen}) *mlen_p\"), o1 as usize, o2 as usize);\n86\t                if !mlen_p_null {\n87\t                    assert_eq!(o1, 0, \"{p}_decrypt short clen must set *mlen_p = 0\");\n88\t                }\n89\t                eq_bytes(&format!(\"{p}_decrypt(clen={clen}) m untouched\"), &m1, &m2);\n90\t                assert_eq!(m1, canary(64), \"{p}_decrypt short clen wrote to m\");\n91\t            }\n92\t        }\n93\t    }\n94\t}\n95\t\n96\t/// ERRORS rows: `_decrypt` with a wrong tag — for `mlen == 0` (`memset` is a\n97\t/// no-op) and for `mlen > 0` (the plaintext region must be zeroed).\n98\t#[test]\n99\tfn decrypt_bad_tag_zeroes_plaintext() {\n100\t    setup();\n101\t    let mut rng = Rng::new(0x9001);\n102\t    for &p in AEADS {\n103\t        let ab = g(p, \"abytes\");\n104\t        let (ce, _) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n105\t        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n106\t        for &mlen in &[0usize, 1, 16, 32, 100] {\n107\t            for &adlen in &[0usize, 16] {\n108\t                let k = rng.bytes(g(p, \"keybytes\"));\n109\t                let npub = rng.bytes(g(p, \"npubbytes\"));\n110\t                let m = rng.bytes(mlen);\n111\t                let ad = rng.bytes(adlen);\n112\t                let mut good = canary(mlen + ab);\n113\t                unsafe {\n114\t                    ce(good.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), mlen as u64,\n115\t                       ad.as_ptr(), adlen as u64, std::ptr::null(), npub.as_ptr(), k.as_ptr());\n116\t                }\n117\t                // Corrupt in three distinct places: tag first byte, tag last\n118\t                // byte, and (when mlen > 0) a ciphertext byte.\n119\t                let mut variants: Vec<(String, Vec<u8>)> = Vec::new();\n120\t                let mut v = good.clone();\n121\t                v[mlen] ^= 0x01;\n122\t                variants.push((\"tag[0]\".into(), v));\n123\t                let mut v = good.clone();\n124\t                let last = v.len() - 1;\n125\t                v[last] ^= 0x80;\n126\t                variants.push((\"tag[last]\".into(), v));\n127\t                if mlen > 0 {\n128\t                    let mut v = good.clone();\n129\t                    v[0] ^= 0x01;\n130\t                    variants.push((\"c[0]\".into(), v));\n131\t                }\n132\t                for (what, bad) in variants {\n133\t                    for m_null in [false, true] {\n134\t                        let mut m1 = canary(mlen.max(1));\n135\t                        let mut m2 = canary(mlen.max(1));\n136\t                        let mut o1 = 0xDEAD_u64;\n137\t                        let mut o2 = 0xDEAD_u64;\n138\t                        let (mp1, mp2) = if m_null {\n139\t                            (std::ptr::null_mut(), std::ptr::null_mut())\n140\t                        } else {\n141\t                            (m1.as_mut_ptr(), m2.as_mut_ptr())\n142\t                        };\n143\t                        let (ra, rb) = unsafe {\n144\t                            (\n145\t                                cd(mp1, &mut o1, std::ptr::null_mut(), bad.as_ptr(),\n146\t                                   bad.len() as u64, ad.as_ptr(), adlen as u64,\n147\t                                   npub.as_ptr(), k.as_ptr()),\n148\t                                rd(mp2, &mut o2, std::ptr::null_mut(), bad.as_ptr(),\n149\t                                   bad.len() as u64, ad.as_ptr(), adlen as u64,\n150\t                                   npub.as_ptr(), k.as_ptr()),\n151\t                            )\n152\t                        };\n153\t                        eq_i32(&format!(\"{p}_decrypt bad {what} m_null={m_null} rc\"), ra, rb);\n154\t                        assert_eq!(ra, -1);\n155\t                        eq_usize(\n156\t                            &format!(\"{p}_decrypt bad {what} *mlen_p\"),\n157\t                            o1 as usize, o2 as usize,\n158\t                        );\n159\t                        assert_eq!(o1, 0);\n160\t                        eq_bytes(\n161\t                            &format!(\"{p}_decrypt bad {what} m_null={m_null} buffer\"),\n162\t                            &m1, &m2,\n163\t                        );\n164\t                        if !m_null && mlen > 0 {\n165\t                            assert_eq!(\n166\t                                m1, vec![0u8; mlen],\n167\t                                \"{p}_decrypt must zero the plaintext on tag failure\"\n168\t                            );\n169\t                        }\n170\t                        if m_null {\n171\t                            assert_eq!(\n172\t                                m1, canary(mlen.max(1)),\n173\t                                \"{p}_decrypt m=NULL must not write anything\"\n174\t                            );\n175\t                        }\n176\t                    }\n177\t                }\n178\t            }\n179\t        }\n180\t    }\n181\t}\n182\t\n183\t/// ERRORS row: `_decrypt` with a *correct* tag but mismatched AD.\n184\t#[test]\n185\tfn decrypt_ad_mismatch() {\n186\t    setup();\n187\t    let mut rng = Rng::new(0x9002);\n188\t    for &p in AEADS {\n189\t        let ab = g(p, \"abytes\");\n190\t        let (ce, _) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n191\t        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n192\t        let mlen = 100usize;\n193\t        for &(enc_ad, dec_ad) in &[(16usize, 0usize), (0, 16), (16, 17), (17, 16), (100, 99)] {\n194\t            let k = rng.bytes(g(p, \"keybytes\"));\n195\t            let npub = rng.bytes(g(p, \"npubbytes\"));\n196\t            let m = rng.bytes(mlen);\n197\t            let ad = rng.bytes(enc_ad.max(dec_ad));\n198\t            let mut c = canary(mlen + ab);\n199\t            unsafe {\n200\t                ce(c.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), mlen as u64,\n201\t                   ad.as_ptr(), enc_ad as u64, std::ptr::null(), npub.as_ptr(), k.as_ptr());\n202\t            }\n203\t            let mut m1 = canary(mlen);\n204\t            let mut m2 = canary(mlen);\n205\t            let mut o1 = 0xDEADu64;\n206\t            let mut o2 = 0xDEADu64;\n207\t            let (ra, rb) = unsafe {\n208\t                (\n209\t                    cd(m1.as_mut_ptr(), &mut o1, std::ptr::null_mut(), c.as_ptr(),\n210\t                       (mlen + ab) as u64, ad.as_ptr(), dec_ad as u64, npub.as_ptr(), k.as_ptr()),\n211\t                    rd(m2.as_mut_ptr(), &mut o2, std::ptr::null_mut(), c.as_ptr(),\n212\t                       (mlen + ab) as u64, ad.as_ptr(), dec_ad as u64, npub.as_ptr(), k.as_ptr()),\n213\t                )\n214\t            };\n215\t            eq_i32(&format!(\"{p} ad mismatch {enc_ad}->{dec_ad} rc\"), ra, rb);\n216\t            assert_eq!(ra, -1);\n217\t            eq_usize(&format!(\"{p} ad mismatch *mlen_p\"), o1 as usize, o2 as usize);\n218\t            eq_bytes(&format!(\"{p} ad mismatch m\"), &m1, &m2);\n219\t        }\n220\t    }\n221\t}\n222\t\n223\t/// ERRORS rows: xchacha20poly1305 with a nonce wrong in the first half (the\n224\t/// hchacha20 subkey) vs the second half (`npub2[4..12]`) — two distinct\n225\t/// dependencies, both must reject identically.\n226\t#[test]\n227\tfn xchacha_wrong_nonce_halves() {\n228\t    setup();\n229\t    let mut rng = Rng::new(0x9003);\n230\t    let p = \"crypto_aead_xchacha20poly1305_ietf\";\n231\t    let (ce, _) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n232\t    let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n233\t    let mlen = 100usize;\n234\t    for byte_idx in [0usize, 5, 15, 16, 20, 23] {\n235\t        let k = rng.bytes(32);\n236\t        let npub = rng.bytes(24);\n237\t        let m = rng.bytes(mlen);\n238\t        let mut c = canary(mlen + 16);\n239\t        unsafe {\n240\t            ce(c.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), mlen as u64,\n241\t               std::ptr::null(), 0, std::ptr::null(), npub.as_ptr(), k.as_ptr());\n242\t        }\n243\t        let mut bad = npub.clone();\n244\t        bad[byte_idx] ^= 0xff;\n245\t        let mut m1 = canary(mlen);\n246\t        let mut m2 = canary(mlen);\n247\t        let mut o1 = 0xDEADu64;\n248\t        let mut o2 = 0xDEADu64;\n249\t        let (ra, rb) = unsafe {\n250\t            (\n251\t                cd(m1.as_mut_ptr(), &mut o1, std::ptr::null_mut(), c.as_ptr(),\n252\t                   (mlen + 16) as u64, std::ptr::null(), 0, bad.as_ptr(), k.as_ptr()),\n253\t                rd(m2.as_mut_ptr(), &mut o2, std::ptr::null_mut(), c.as_ptr(),\n254\t                   (mlen + 16) as u64, std::ptr::null(), 0, bad.as_ptr(), k.as_ptr()),\n255\t            )\n256\t        };\n257\t        eq_i32(&format!(\"xchacha wrong npub[{byte_idx}] rc\"), ra, rb);\n258\t        assert_eq!(ra, -1);\n259\t        eq_usize(\"xchacha wrong npub *mlen_p\", o1 as usize, o2 as usize);\n260\t        eq_bytes(&format!(\"xchacha wrong npub[{byte_idx}] m\"), &m1, &m2);\n261\t        assert_eq!(m1, vec![0u8; mlen]);\n262\t    }\n263\t}\n264\t\n265\t/// ERRORS rows: `_decrypt_detached` with a wrong MAC (with and without `m`).\n266\t#[test]\n267\tfn decrypt_detached_bad_mac() {\n268\t    setup();\n269\t    let mut rng = Rng::new(0x9004);\n270\t    for &p in AEADS {\n271\t        let ab = g(p, \"abytes\");\n272\t        let (ced, _) = pair::<EncDet>(&format!(\"{p}_encrypt_detached\"));\n273\t        let (cdd, rdd) = pair::<DecDet>(&format!(\"{p}_decrypt_detached\"));\n274\t        for &clen in &[0usize, 1, 5, 16, 32, 100] {\n275\t            let k = rng.bytes(g(p, \"keybytes\"));\n276\t            let npub = rng.bytes(g(p, \"npubbytes\"));\n277\t            let m = rng.bytes(clen);\n278\t            let mut c = canary(clen.max(1));\n279\t            let mut tag = canary(ab);\n280\t            unsafe {\n281\t                ced(c.as_mut_ptr(), tag.as_mut_ptr(), std::ptr::null_mut(),\n282\t                    m.as_ptr(), clen as u64, std::ptr::null(), 0,\n283\t                    std::ptr::null(), npub.as_ptr(), k.as_ptr());\n284\t            }\n285\t            // three distinct wrong MACs, incl. the all-zero and all-ff ones the\n286\t            // table calls out explicitly\n287\t            let mut macs: Vec<(String, Vec<u8>)> = vec![\n288\t                (\"zero\".into(), vec![0u8; ab]),\n289\t                (\"ff\".into(), vec![0xffu8; ab]),\n290\t            ];\n291\t            let mut flip = tag.clone();\n292\t            flip[0] ^= 1;\n293\t            macs.push((\"flip0\".into(), flip));\n294\t            let mut flip = tag.clone();\n295\t            flip[ab - 1] ^= 0x80;\n296\t            macs.push((\"flipN\".into(), flip));\n297\t            for (what, mac) in macs {\n298\t                if mac == tag {\n299\t                    continue;\n300\t                }\n301\t                for m_null in [false, true] {\n302\t                    let mut m1 = canary(clen.max(1));\n303\t                    let mut m2 = canary(clen.max(1));\n304\t                    let (mp1, mp2) = if m_null {\n305\t                        (std::ptr::null_mut(), std::ptr::null_mut())\n306\t                    } else {\n307\t                        (m1.as_mut_ptr(), m2.as_mut_ptr())\n308\t                    };\n309\t                    let (ra, rb) = unsafe {\n310\t                        (\n311\t                            cdd(mp1, std::ptr::null_mut(), c.as_ptr(), clen as u64,\n312\t                                mac.as_ptr(), std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n313\t                            rdd(mp2, std::ptr::null_mut(), c.as_ptr(), clen as u64,\n314\t                                mac.as_ptr(), std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n315\t                        )\n316\t                    };\n317\t                    eq_i32(\n318\t                        &format!(\"{p}_decrypt_detached mac={what} clen={clen} m_null={m_null} rc\"),\n319\t                        ra, rb,\n320\t                    );\n321\t                    assert_eq!(ra, -1);\n322\t                    eq_bytes(\n323\t                        &format!(\"{p}_decrypt_detached mac={what} clen={clen} m_null={m_null}\"),\n324\t                        &m1, &m2,\n325\t                    );\n326\t                    if m_null {\n327\t                        assert_eq!(m1, canary(clen.max(1)), \"{p} m=NULL must not write\");\n328\t                    } else if clen > 0 {\n329\t                        assert_eq!(m1, vec![0u8; clen], \"{p} must zero m on MAC failure\");\n330\t                    }\n331\t                }\n332\t            }\n333\t        }\n334\t    }\n335\t}\n336\t\n337\t/// ERRORS rows: AEGIS `_decrypt_detached` with `clen`/`adlen` above\n338\t/// `MESSAGEBYTES_MAX` returns `-1` *immediately* (asymmetric with the encrypt\n339\t/// side, which aborts). The guard precedes every dereference, so no buffer is\n340\t/// needed. Also the combined `_decrypt` with `clen = MAX + ABYTES + 1`.\n341\t#[test]\n342\tfn aegis_decrypt_oversized_lengths_return_minus_one() {\n343\t    setup();\n344\t    for &p in &[\"crypto_aead_aegis128l\", \"crypto_aead_aegis256\"] {\n345\t        let ab = g(p, \"abytes\") as u64;\n346\t        let max = gmax(p);\n347\t        let (cdd, rdd) = pair::<DecDet>(&format!(\"{p}_decrypt_detached\"));\n348\t        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n349\t        let k = [7u8; 32];\n350\t        let npub = [9u8; 32];\n351\t        let mac = [0u8; 32];\n352\t        let cbuf = [0u8; 64];\n353\t\n354\t        for &(clen, adlen, what) in &[\n355\t            (max + 1, 0u64, \"clen = MAX+1\"),\n356\t            (u64::MAX, 0, \"clen = u64::MAX\"),\n357\t            (0, max + 1, \"adlen = MAX+1\"),\n358\t            (0, u64::MAX, \"adlen = u64::MAX\"),\n359\t            (max + 1, max + 1, \"both = MAX+1\"),\n360\t        ] {\n361\t            let mut m1 = canary(64);\n362\t            let mut m2 = canary(64);\n363\t            let (ra, rb) = unsafe {\n364\t                (\n365\t                    cdd(m1.as_mut_ptr(), std::ptr::null_mut(), cbuf.as_ptr(), clen,\n366\t                        mac.as_ptr(), std::ptr::null(), adlen, npub.as_ptr(), k.as_ptr()),\n367\t                    rdd(m2.as_mut_ptr(), std::ptr::null_mut(), cbuf.as_ptr(), clen,\n368\t                        mac.as_ptr(), std::ptr::null(), adlen, npub.as_ptr(), k.as_ptr()),\n369\t                )\n370\t            };\n371\t            eq_i32(&format!(\"{p}_decrypt_detached {what} rc\"), ra, rb);\n372\t            assert_eq!(ra, -1, \"{p}_decrypt_detached {what} must return -1\");\n373\t            eq_bytes(&format!(\"{p}_decrypt_detached {what} m\"), &m1, &m2);\n374\t            assert_eq!(m1, canary(64));\n375\t        }\n376\t\n377\t        // combined _decrypt: clen - ABYTES > MESSAGEBYTES_MAX -> inner guard\n378\t        for &clen in &[max + ab + 1, u64::MAX] {\n379\t            let mut m1 = canary(64);\n380\t            let mut m2 = canary(64);\n381\t            let mut o1 = 0xDEADu64;\n382\t            let mut o2 = 0xDEADu64;\n383\t            let (ra, rb) = unsafe {\n384\t                (\n385\t                    cd(m1.as_mut_ptr(), &mut o1, std::ptr::null_mut(), cbuf.as_ptr(),\n386\t                       clen, std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n387\t                    rd(m2.as_mut_ptr(), &mut o2, std::ptr::null_mut(), cbuf.as_ptr(),\n388\t                       clen, std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n389\t                )\n390\t            };\n391\t            eq_i32(&format!(\"{p}_decrypt(clen={clen}) rc\"), ra, rb);\n392\t            assert_eq!(ra, -1);\n393\t            eq_usize(&format!(\"{p}_decrypt(clen={clen}) *mlen_p\"), o1 as usize, o2 as usize);\n394\t            assert_eq!(o1, 0);\n395\t            eq_bytes(&format!(\"{p}_decrypt(clen={clen}) m\"), &m1, &m2);\n396\t        }\n397\t    }\n398\t}\n399\t\n400\t/// ERRORS rows: all nine operational `crypto_aead_aes256gcm_*` entry points\n401\t/// set `errno = ENOSYS` and return `-1` in this build.\n402\t#[test]\n403\tfn aes256gcm_sets_enosys() {\n404\t    setup();\n405\t    const ENOSYS: i32 = 38;\n406\t    let mut rng = Rng::new(0x9005);\n407\t    let k = rng.bytes(32);\n408\t    let npub = rng.bytes(12);\n409\t    let m = rng.bytes(64);\n410\t    let ad = rng.bytes(16);\n411\t    let mac = rng.bytes(16);\n412\t    let mut out = canary(128);\n413\t    let mut len = 0u64;\n414\t    let mut st = State::new(512);\n415\t\n416\t    let clear_errno = || {\n417\t        // reset errno via a syscall that is known to succeed\n418\t        let _ = std::fs::metadata(\"/\");\n419\t        let _ = std::io::Error::from_raw_os_error(0);\n420\t    };\n421\t    let errno = || std::io::Error::last_os_error().raw_os_error().unwrap_or(0);\n422\t\n423\t    macro_rules! check {\n424\t        ($name:literal, $ty:ty, $call:expr) => {{\n425\t            let (c, r) = pair::<$ty>($name);\n426\t            for which in [c, r] {\n427\t                clear_errno();\n428\t                let f = which;\n429\t                let rc = unsafe { $call(f) };\n430\t                assert_eq!(rc, -1, concat!($name, \" must return -1\"));\n431\t                assert_eq!(errno(), ENOSYS, concat!($name, \" must set errno = ENOSYS\"));\n432\t            }\n433\t        }};\n434\t    }\n435\t\n436\t    check!(\"crypto_aead_aes256gcm_encrypt\", Enc, |f: Enc| f(\n437\t        out.as_mut_ptr(), &mut len, m.as_ptr(), 64, ad.as_ptr(), 16,\n438\t        std::ptr::null(), npub.as_ptr(), k.as_ptr()));\n439\t    check!(\"crypto_aead_aes256gcm_decrypt\", Dec, |f: Dec| f(\n440\t        out.as_mut_ptr(), &mut len, std::ptr::null_mut(), m.as_ptr(), 64,\n441\t        ad.as_ptr(), 16, npub.as_ptr(), k.as_ptr()));\n442\t    check!(\"crypto_aead_aes256gcm_encrypt_detached\", EncDet, |f: EncDet| f(\n443\t        out.as_mut_ptr(), out.as_mut_ptr(), &mut len, m.as_ptr(), 64,\n444\t        ad.as_ptr(), 16, std::ptr::null(), npub.as_ptr(), k.as_ptr()));\n445\t    check!(\"crypto_aead_aes256gcm_decrypt_detached\", DecDet, |f: DecDet| f(\n446\t        out.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), 64, mac.as_ptr(),\n447\t        ad.as_ptr(), 16, npub.as_ptr(), k.as_ptr()));\n448\t    check!(\n449\t        \"crypto_aead_aes256gcm_beforenm\",\n450\t        unsafe extern \"C\" fn(*mut u8, *const u8) -> i32,\n451\t        |f: unsafe extern \"C\" fn(*mut u8, *const u8) -> i32| f(st.as_mut_ptr(), k.as_ptr())\n452\t    );\n453\t\n454\t    type EncAfter = unsafe extern \"C\" fn(\n455\t        *mut u8, *mut u64, *const u8, u64, *const u8, u64, *const u8, *const u8, *const u8,\n456\t    ) -> i32;\n457\t    for name in [\n458\t        \"crypto_aead_aes256gcm_encrypt_afternm\",\n459\t        \"crypto_aead_aes256gcm_decrypt_afternm\",\n460\t        \"crypto_aead_aes256gcm_encrypt_detached_afternm\",\n461\t        \"crypto_aead_aes256gcm_decrypt_detached_afternm\",\n462\t    ] {\n463\t        let (c, r) = pair::<EncAfter>(name);\n464\t        for f in [c, r] {\n465\t            clear_errno();\n466\t            let rc = unsafe {\n467\t                f(out.as_mut_ptr(), &mut len, m.as_ptr(), 64, ad.as_ptr(), 16,\n468\t                  std::ptr::null(), npub.as_ptr(), st.as_ptr())\n469\t            };\n470\t            assert_eq!(rc, -1, \"{name} must return -1\");\n471\t            assert_eq!(errno(), ENOSYS, \"{name} must set errno = ENOSYS\");\n472\t        }\n473\t    }\n474\t}\n475\t\n476\t// ===========================================================================\n477\t// `sodium_misuse()` rows — run out of process\n478\t// ===========================================================================\n479\t\n480\t/// Every abort-path row, identified by tag.\n481\tconst MISUSE_CASES: &[&str] = &[\n482\t    // aegis128l / aegis256 combined encrypt: mlen > MESSAGEBYTES_MAX\n483\t    \"aegis128l/encrypt/mlen=max+1\",\n484\t    \"aegis128l/encrypt/mlen=u64max\",\n485\t    \"aegis256/encrypt/mlen=max+1\",\n486\t    \"aegis256/encrypt/mlen=u64max\",\n487\t    // combined encrypt with oversized adlen (guard lives in _encrypt_detached)\n488\t    \"aegis128l/encrypt/adlen=max+1\",\n489\t    \"aegis256/encrypt/adlen=max+1\",\n490\t    // detached encrypt: *maclen_p is written BEFORE the abort\n491\t    \"aegis128l/encrypt_detached/mlen=max+1\",\n492\t    \"aegis128l/encrypt_detached/adlen=max+1\",\n493\t    \"aegis256/encrypt_detached/mlen=max+1\",\n494\t    \"aegis256/encrypt_detached/adlen=max+1\",\n495\t    // poly1305 AEADs: combined encrypt guards\n496\t    \"chacha20poly1305/encrypt/mlen=max+1\",\n497\t    \"chacha20poly1305_ietf/encrypt/mlen=max+1\",\n498\t    \"chacha20poly1305_ietf/encrypt/mlen=u64max\",\n499\t    \"xchacha20poly1305_ietf/encrypt/mlen=max+1\",\n500\t];\n501\t\n502\tfn prefix_of(tag: &str) -> String {\n503\t    format!(\"crypto_aead_{}\", tag.split('/').next().unwrap())\n504\t}\n505\t\n506\t/// The child half: performs exactly one misusing call on the selected library.\n507\t#[test]\n508\tfn misuse_child() {\n509\t    let Some((tag, lib)) = child_case() else {\n510\t        return;\n511\t    };\n512\t    let p = prefix_of(&tag);\n513\t    let ab = g(&p, \"abytes\");\n514\t    let max = gmax(&p);\n515\t    let k = vec![3u8; g(&p, \"keybytes\")];\n516\t    let npub = vec![4u8; g(&p, \"npubbytes\")];\n517\t    let mbuf = [0u8; 64];\n518\t    let mut cbuf = canary(128);\n519\t    let mut tagbuf = canary(64);\n520\t    let mut maclen = 0xA5A5_A5A5_A5A5_A5A5u64;\n521\t    let mut clen = 0xA5A5_A5A5_A5A5_A5A5u64;\n522\t\n523\t    let parts: Vec<&str> = tag.split('/').collect();\n524\t    let (func, cond) = (parts[1], parts[2]);\n525\t    let big = match cond {\n526\t        \"mlen=max+1\" | \"adlen=max+1\" => max + 1,\n527\t        \"mlen=u64max\" | \"adlen=u64max\" => u64::MAX,\n528\t        other => panic!(\"unknown condition {other}\"),\n529\t    };\n530\t\n531\t    match func {\n532\t        \"encrypt\" => {\n533\t            // observe *clen_p (must remain untouched: the guard precedes it)\n534\t            set_observation((&raw const clen).cast(), 8);\n535\t            let f = sym::<Enc>(lib, &format!(\"{p}_encrypt\"));\n536\t            let (mlen, adlen) = if cond.starts_with(\"mlen\") { (big, 0) } else { (0, big) };\n537\t            let rc = unsafe {\n538\t                f(cbuf.as_mut_ptr(), &raw mut clen, mbuf.as_ptr(), mlen,\n539\t                  std::ptr::null(), adlen, std::ptr::null(), npub.as_ptr(), k.as_ptr())\n540\t            };\n541\t            println!(\"OBS returned rc={rc} clen={clen} ab={ab}\");\n542\t        }\n543\t        \"encrypt_detached\" => {\n544\t            // observe *maclen_p, which IS written before the abort\n545\t            set_observation((&raw const maclen).cast(), 8);\n546\t            let f = sym::<EncDet>(lib, &format!(\"{p}_encrypt_detached\"));\n547\t            let (mlen, adlen) = if cond.starts_with(\"mlen\") { (big, 0) } else { (0, big) };\n548\t            let rc = unsafe {\n549\t                f(cbuf.as_mut_ptr(), tagbuf.as_mut_ptr(), &raw mut maclen, mbuf.as_ptr(),\n550\t                  mlen, std::ptr::null(), adlen, std::ptr::null(), npub.as_ptr(), k.as_ptr())\n551\t            };\n552\t            println!(\"OBS returned rc={rc} maclen={maclen}\");\n553\t        }\n554\t        other => panic!(\"unknown function {other}\"),\n555\t    }\n556\t    // If we get here, the library did NOT abort.\n557\t    use std::io::Write;\n558\t    let _ = std::io::stdout().flush();\n559\t    std::process::exit(0);\n560\t}\n561\t\n562\t#[test]\n563\tfn misuse_paths_match() {\n564\t    if child_tag().is_some() {\n565\t        return;\n566\t    }\n567\t    setup();\n568\t    for &tag in MISUSE_CASES {\n569\t        let c = run_child(\"misuse_child\", \"c\", tag);\n570\t        let r = run_child(\"misuse_child\", \"r\", tag);\n571\t        eq_child(tag, &c, &r);\n572\t        // the C reference must genuinely have gone through sodium_misuse()\n573\t        assert_eq!(\n574\t            c.status.code(),\n575\t            Some(MISUSE_EXIT),\n576\t            \"{tag}: C did not reach sodium_misuse (stdout: {}, stderr: {})\",\n577\t            String::from_utf8_lossy(&c.stdout),\n578\t            String::from_utf8_lossy(&c.stderr)\n579\t        );\n580\t    }\n581\t}\n582\t\n583\t/// ERRORS rows recorded as **not constructible** — documented here so the row\n584\t/// is not silently dropped, with the reason and the place the same C branch\n585\t/// *is* covered.\n586\t#[test]\n587\tfn documented_unreachable_error_rows() {\n588\t    setup();\n589\t    // 1. `crypto_aead_chacha20poly1305_encrypt_detached` / `xchacha..._encrypt_detached`\n590\t    //    have no length guard of their own; the only downstream guard is\n591\t    //    `mlen > SODIUM_SIZE_MAX (= u64::MAX)`, which an `unsigned long long`\n592\t    //    argument can never exceed. Assert the constant so the claim is checked.\n593\t    for p in [\"crypto_stream_chacha20\"] {\n594\t        let m = unsafe {\n595\t            sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), &format!(\"{p}_messagebytes_max\"))()\n596\t        };\n597\t        let m2 = unsafe {\n598\t            sym::<unsafe extern \"C\" fn() -> u64>(r_lib(), &format!(\"{p}_messagebytes_max\"))()\n599\t        };\n600\t        assert_eq!(m, m2);\n601\t        assert_eq!(m, u64::MAX, \"{p}_MESSAGEBYTES_MAX must be unfireable\");\n602\t    }\n603\t    // 2. `crypto_aead_chacha20poly1305_ietf_{encrypt,decrypt}_detached` with\n604\t    //    `mlen > 64*(2^32-1)` aborts inside `crypto_stream_chacha20_ietf_xor_ic`\n605\t    //    (counter-overflow guard). Reaching it through the AEAD needs a 256 GiB\n606\t    //    buffer, but the *same* C branch is driven directly by\n607\t    //    `t06_stream_errors::chacha20_ietf_counter_overflow`.\n608\t    let ietf_max = unsafe {\n609\t        sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), \"crypto_aead_chacha20poly1305_ietf_messagebytes_max\")()\n610\t    };\n611\t    assert_eq!(ietf_max, 64 * (u32::MAX as u64));\n612\t    // 3. `aegis128l_mac`/`aegis256_mac` with `maclen ∉ {16, 32}` is dead code:\n613\t    //    the wrappers hard-code `maclen = ABYTES = 32`. Verified by the\n614\t    //    constant, which is the only value the public API can produce.\n615\t    for p in [\"crypto_aead_aegis128l\", \"crypto_aead_aegis256\"] {\n616\t        assert_eq!(g(p, \"abytes\"), 32, \"{p}_ABYTES pins aegis*_mac's maclen\");\n617\t    }\n618\t    // 4. NULL `c`/`mac`/`npub`/`k` are `__attribute__((nonnull))` parameters:\n619\t    //    the C performs no runtime check, so passing NULL is UB, not a defined\n620\t    //    rejection. Not testable differentially.\n621\t}\n622\t"}]},"parent_tool_use_id":"toolu_bdrk_01Aw2j196PG6UFGUL4fdGJ7V","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"23803d82-f697-4d3f-b5bf-e21e61e93dab","timestamp":"2026-08-23T08:27:22.686Z","subagent_type":"general-purpose","task_description":"Phase B+C tests: sodium+randombytes"}
