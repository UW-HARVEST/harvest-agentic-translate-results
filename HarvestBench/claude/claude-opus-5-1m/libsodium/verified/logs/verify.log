t;\n   117\t}\n   118\t\n   119\tsize_t\n   120\tcrypto_hash_sha3256_bytes(void)\n   121\t{\n   122\t    return crypto_hash_sha3256_BYTES;\n   123\t}\n   124\t\n   125\tsize_t\n   126\tcrypto_hash_sha3256_statebytes(void)\n   127\t{\n   128\t    return sizeof(crypto_hash_sha3256_state);\n   129\t}\n   130\t\n   131\tint\n   132\tcrypto_hash_sha3256_init(crypto_hash_sha3256_state *state)\n   133\t{\n   134\t    COMPILER_ASSERT(sizeof(crypto_hash_sha3256_state) >= sizeof(sha3_state_internal));\n   135\t    return sha3_init((sha3_state_internal *) (void *) state,\n   136\t                     SHA3_256_RATE, crypto_hash_sha3256_BYTES);\n   137\t}\n   138\t\n   139\tint\n   140\tcrypto_hash_sha3256_update(crypto_hash_sha3256_state *state,\n   141\t                           const unsigned char *in, unsigned long long inlen)\n   142\t{\n   143\t    return sha3_update((sha3_state_internal *) (void *) state, in, (size_t) inlen);\n   144\t}\n   145\t\n   146\tint\n   147\tcrypto_hash_sha3256_final(crypto_hash_sha3256_state *state, unsigned char *out)\n   148\t{\n   149\t    return sha3_final((sha3_state_internal *) (void *) state, out);\n   150\t}\n   151\t\n   152\tint\n   153\tcrypto_hash_sha3256(unsigned char *out, const unsigned char *in, unsigned long long inlen)\n   154\t{\n   155\t    crypto_hash_sha3256_state state;\n   156\t\n   157\t    crypto_hash_sha3256_init(&state);\n   158\t    crypto_hash_sha3256_update(&state, in, inlen);\n   159\t    crypto_hash_sha3256_final(&state, out);\n   160\t    sodium_memzero(&state, sizeof state);\n   161\t\n   162\t    return 0;\n   163\t}\n   164\t\n   165\tsize_t\n   166\tcrypto_hash_sha3512_bytes(void)\n   167\t{\n   168\t    return crypto_hash_sha3512_BYTES;\n   169\t}\n   170\t\n   171\tsize_t\n   172\tcrypto_hash_sha3512_statebytes(void)\n   173\t{\n   174\t    return sizeof(crypto_hash_sha3512_state);\n   175\t}\n   176\t\n   177\tint\n   178\tcrypto_hash_sha3512_init(crypto_hash_sha3512_state *state)\n   179\t{\n   180\t  