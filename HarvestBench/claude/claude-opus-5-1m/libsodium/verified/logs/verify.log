XOR(tmp, state[3]);\n45\t\n46\t    for (i = 0; i < 7; i++) {\n47\t        aegis256_update(state, tmp);\n48\t    }\n49\t\n50\t    if (maclen == 16) {\n51\t        /* LCOV_EXCL_START */\n52\t        tmp = AES_BLOCK_XOR(state[5], state[4]);\n53\t        tmp = AES_BLOCK_XOR(tmp, AES_BLOCK_XOR(state[3], state[2]));\n54\t        tmp = AES_BLOCK_XOR(tmp, AES_BLOCK_XOR(state[1], state[0]));\n55\t        AES_BLOCK_STORE(mac, tmp);\n56\t        /* LCOV_EXCL_STOP */\n57\t    } else if (maclen == 32) {\n58\t        tmp = AES_BLOCK_XOR(AES_BLOCK_XOR(state[2], state[1]), state[0]);\n59\t        AES_BLOCK_STORE(mac, tmp);\n60\t        tmp = AES_BLOCK_XOR(AES_BLOCK_XOR(state[5], state[4]), state[3]);\n61\t        AES_BLOCK_STORE(mac + 16, tmp);\n62\t    } else {\n63\t        memset(mac, 0, maclen); /* LCOV_EXCL_LINE */\n64\t        return -1;             /* LCOV_EXCL_LINE */\n65\t    }\n66\t    return 0;\n67\t}\n68\t\n69\tstatic inline void\n70\taegis256_absorb(const uint8_t *const src, aes_block_t *const state)\n71\t{\n72\t    aes_block_t msg;\n73\t\n74\t    msg = AES_BLOCK_LOAD(src);\n75\t    aegis256_update(state, msg);\n76\t}\n77\t\n78\tstatic inline void\n79\taegis256_absorb2(const uint8_t *const src, aes_block_t *const state)\n80\t{\n81\t    aes_block_t msg, msg2;\n82\t\n83\t    msg  = AES_BLOCK_LOAD(src + 0 * AES_BLOCK_LENGTH);\n84\t    msg2 = AES_BLOCK_LOAD(src + 1 * AES_BLOCK_LENGTH);\n85\t    aegis256_update(state, msg);\n86\t    aegis256_update(state, msg2);\n87\t}\n88\t\n89\tstatic inline void\n90\taegis256_enc(uint8_t *const dst, const uint8_t *const src, aes_block_t *const state)\n91\t{\n92\t    aes_block_t msg;\n93\t    aes_block_t tmp;\n94\t\n95\t    msg = AES_BLOCK_LOAD(src);\n96\t    tmp = AES_BLOCK_XOR(msg, state[5]);\n97\t    tmp = AES_BLOCK_XOR(tmp, state[4]);\n98\t    tmp = AES_BLOCK_XOR(tmp, state[1]);\n99\t    tmp = AES_BLOCK_XOR(tmp, AES_BLOCK_AND(state[2], state[3]));\n100\t    AES_BLOCK_STORE(dst, tmp);\n101\t\n102\t    aegis256_update(state, msg);\n103\t}\n104\t\n105\tstatic inline void\n106\taegis256_dec(uint8_t *const dst, const uint8_t *const src, aes_block_t *const state)\n107\t{\n108\t    aes_block_t msg;\n109\t\n110\t    msg = AES_BLOCK_LOAD(src);\n111\t    msg = AES_BLOCK_XOR(msg, state[5]);\n112\t    msg = AES_BLOCK_XOR(msg, state[4]);\n113\t    msg = AES_BLOCK_XOR(msg, state[1]);\n114\t    msg = AES_BLOCK_XOR(msg, AES_BLOCK_AND(state[2], state[3]));\n115\t    AES_BLOCK_STORE(dst, msg);\n116\t\n117\t    aegis256_update(state, msg);\n118\t}\n119\t\n120\tstatic inline void\n121\taegis256_declast(uint8_t *const dst, const uint8_t *const src, size_t len, aes_block_t *const state)\n122\t{\n123\t    uint8_t     pad[RATE];\n124\t    aes_block_t msg;\n125\t\n126\t    memset(pad, 0, sizeof pad);\n127\t    memcpy(pad, src, len);\n128\t\n129\t    msg = AES_BLOCK_LOAD(pad);\n130\t    msg = AES_BLOCK_XOR(msg, state[5]);\n131\t    msg = AES_BLOCK_XOR(msg, state[4]);\n132\t    msg = AES_BLOCK_XOR(msg, state[1]);\n133\t    msg = AES_BLOCK_XOR(msg, AES_BLOCK_AND(state[2], state[3]));\n134\t    AES_BLOCK_STORE(pad, msg);\n135\t\n136\t    memset(pad + len, 0, sizeof pad - len);\n137\t    memcpy(dst, pad, len);\n138\t\n139\t    msg = AES_BLOCK_LOAD(pad);\n140\t\n141\t    aegis256_update(state, msg);\n142\t}\n143\t\n144\tstatic int\n145\tencrypt_detached(uint8_t *c, uint8_t *mac, size_t maclen, const uint8_t *m, size_t mlen,\n146\t                 const uint8_t *ad, size_t adlen, const uint8_t *npub, const uint8_t *k)\n147\t{\n148\t    aes_block_t                state[6];\n149\t    CRYPTO_ALIGN(RATE) uint8_t src[RATE];\n150\t    CRYPTO_ALIGN(RATE) uint8_t dst[RATE];\n151\t    size_t                     i;\n152\t\n153\t    aegis256_init(k, npub, state);\n154\t\n155\t    for (i = 0; i + 2 * RATE <= adlen; i += 2 * RATE) {\n156\t        aegis256_absorb2(ad + i, state);\n157\t    }\n158\t    for (; i + RATE <= adlen; i += RATE) {\n159\t        aegis256_absorb(ad + i, state);\n160\t    }\n161\t    if (adlen % RATE) {\n162\t        memset(src, 0, RATE);\n163\t        memcpy(src, ad + i, adlen % RATE);\n164\t        aegis256_absorb(src, state);\n165\t    }\n166\t    for (i = 0; i + RATE <= mlen; i += RATE) {\n167\t        aegis256_enc(c + i, m + i, state);\n168\t    }\n169\t    if (mlen % RATE) {\n170\t        memset(src, 0, RATE);\n171\t        memcpy(src, m + i, mlen % RATE);\n172\t        aegis256_enc(dst, src, state);\n173\t        memcpy(c + i, dst, mlen % RATE);\n174\t    }\n175\t\n176\t    return aegis256_mac(mac, maclen, adlen, mlen, state);\n177\t}\n178\t\n179\tstatic int\n180\tdecrypt_detached(uint8_t *m, const uint8_t *c, size_t clen, const uint8_t *mac, size_t maclen,\n181\t                 const uint8_t *ad, size_t adlen, const uint8_t *npub, const uint8_t *k)\n182\t{\n183\t    aes_block_t                state[6];\n184\t    CRYPTO_ALIGN(RATE) uint8_t src[RATE];\n185\t    CRYPTO_ALIGN(RATE) uint8_t dst[RATE];\n186\t    CRYPTO_ALIGN(16) uint8_t   computed_mac[32];\n187\t    const size_t               mlen = clen;\n188\t    size_t                     i;\n189\t    int                        ret;\n190\t\n191\t    aegis256_init(k, npub, state);\n192\t\n193\t    for (i = 0; i + 2 * RATE <= adlen; i += 2 * RATE) {\n194\t        aegis256_absorb2(ad + i, state);\n195\t    }\n196\t    for (; i + RATE <= adlen; i += RATE) {\n197\t        aegis256_absorb(ad + i, state);\n198\t    }\n199\t    if (adlen % RATE) {\n200\t        memset(src, 0, RATE);\n201\t        memcpy(src, ad + i, adlen % RATE);\n202\t        aegis256_absorb(src, state);\n203\t    }\n204\t    if (m != NULL) {\n205\t        for (i = 0; i + RATE <= mlen; i += RATE) {\n206\t            aegis256_dec(m + i, c + i, state);\n207\t        }\n208\t    } else {\n209\t        for (i = 0; i + RATE <= mlen; i += RATE) {\n210\t            aegis256_dec(dst, c + i, state);\n211\t        }\n212\t    }\n213\t    if (mlen % RATE) {\n214\t        if (m != NULL) {\n215\t            aegis256_declast(m + i, c + i, mlen % RATE, state);\n216\t        } else {\n217\t            aegis256_declast(dst, c + i, mlen % RATE, state);\n218\t        }\n219\t    }\n220\t\n221\t    COMPILER_ASSERT(sizeof computed_mac >= 32);\n222\t    ret = -1;\n223\t    if (aegis256_mac(computed_mac, maclen, adlen, mlen, state) == 0) {\n224\t        if (maclen == 16) {\n225\t            ret = crypto_verify_16(computed_mac, mac); /* LCOV_EXCL_LINE */\n226\t        } else if (maclen == 32) {\n227\t            ret = crypto_verify_32(computed_mac, mac);\n228\t        }\n229\t    }\n230\t    if (ret != 0) {\n231\t        if (m != NULL) {\n232\t            memset(m, 0, mlen);\n233\t        }\n234\t        return ret;\n235\t    }\n236\t    ACQUIRE_FENCE;\n237\t    return 0;\n238\t}\n239\t"}]},"parent_tool_use_id":"toolu_bdrk_01H2nXwNYPpnmRZkHiYVLhNM","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"41a7700e-251d-415d-8dff-f2502ca95083","timestamp":"2026-08-23T08:08:29.405Z","subagent_type":"general-purpose","task_description":"Phase A tables: crypto_aead"}
