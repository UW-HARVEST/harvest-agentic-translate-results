6gcm_encrypt\",\n            \"crypto_aead_aes256gcm_decrypt\",\n            \"crypto_aead_aes256gcm_encrypt_detached\",\n            \"crypto_aead_aes256gcm_decrypt_detached\",\n            \"crypto_aead_aes256gcm_beforenm\",\n            \"crypto_aead_aes256gcm_encrypt_afternm\",\n            \"crypto_aead_aes256gcm_decrypt_afternm\",\n            \"crypto_aead_aes256gcm_encrypt_detached_afternm\",\n            \"crypto_aead_aes256gcm_decrypt_detached_afternm\",\n            \"crypto_aead_aes256gcm_is_available\",\n        ] {\n            assert!(\n                unsafe { lib.get::<*const std::ffi::c_void>(name.as_bytes()) }.is_ok(),\n                \"{name} must be exported\"\n            );\n        }\n    }\n}\"\"\"\nassert old in s\ns = s.replace(old, new)\nopen(p,'w').write(s)\nprint(\"ok\")\nPY\ntimeout 600 cargo test --no-default-features --test t04_aead 2>&1 | tail -8; python3 .phaseA/coverage.py --report 2>&1 | grep -v UNCOVERED","description":"Add G3-128 assertion, run, and report coverage","timeout":600000}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5904,"cache_read_input_tokens":388028,"cache_creation":{"ephemeral_5m_input_tokens":5904,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"e5623909-1451-4e76-8cd1-b0a57627cb0c","timestamp":"2026-08-23T08:40:19.298Z"}
