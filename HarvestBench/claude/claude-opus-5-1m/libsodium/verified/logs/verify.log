 char *ip,\n485\t              size_t ip_len_) /* Some AIX versions define a macro named \"ip_len\" */\n486\t{\n487\t    const char   *ip_end = ip + ip_len_;\n488\t    const char   *end    = ip;\n489\t    const char   *zone   = NULL;\n490\t    const char   *z;\n491\t    unsigned char v4[4];\n492\t    int           is_ipv6;\n493\t\n494\t    for (; end < ip_end && *end != 0; end++) {\n495\t        /* empty */\n496\t    }\n497\t    zone = (const char *) memchr(ip, '%', (size_t) (end - ip));\n498\t    if (zone != NULL) {\n499\t        for (z = zone + 1; z < end; z++) {\n500\t            if (!((*z >= '0' && *z <= '9') || (*z >= 'a' && *z <= 'z') ||\n501\t                  (*z >= 'A' && *z <= 'Z') || *z == '-' || *z == '_' || *z == '.')) {\n502\t                return -1;\n503\t            }\n504\t        }\n505\t        if (zone + 1 >= end) {\n506\t            return -1;\n507\t        }\n508\t        end = zone;\n509\t    }\n510\t    is_ipv6 = memchr(ip, ':', (size_t) (end - ip)) != NULL;\n511\t    if (zone != NULL && !is_ipv6) {\n512\t        return -1;\n513\t    }\n514\t    if (is_ipv6) {\n515\t        return parse_ipv6(ip, end, bin) != 0 ? 0 : -1;\n516\t    }\n517\t    if (parse_ipv4(ip, end, v4) == 0) {\n518\t        return -1;\n519\t    }\n520\t    memset(bin, 0, 10U);\n521\t    bin[10] = 0xffU;\n522\t    bin[11] = 0xffU;\n523\t    memcpy(bin + 12, v4, 4U);\n524\t\n525\t    return 0;\n526\t}\n527\t\n528\tstatic const unsigned char ipv4_mapped_prefix[12] = { 0U, 0U, 0U, 0U, 0U,    0U,\n529\t                                                      0U, 0U, 0U, 0U, 0xffU, 0xffU };\n530\t\n531\tstatic void\n532\tip_write_num(char **p, unsigned int val, int base)\n533\t{\n534\t    char buf[4];\n535\t    int  n = 0;\n536\t\n537\t    do {\n538\t        unsigned int d = val % (unsigned int) base;\n539\t\n540\t        buf[n++] = (char) (d < 10U ? '0' + d : 'a' + d - 10U);\n541\t        val /= (unsigned int) base;\n542\t    } while (val != 0U);\n543\t\n544\t    while (n-- > 0) {\n545\t        *(*p)++ = buf[n];\n546\t    }\n547\t}\n548\t\n549\tchar *\n550\tsodium_bin2ip(char *ip, size_t ip_maxlen, const unsigned char bin[16])\n551\t{\n552\t    char   buf[46];\n553\t    char  *p = buf;\n554\t    int    i;\n555\t    int    best_start = -1;\n556\t    int    best_len   = 0;\n557\t    int    cur_start  = -1;\n558\t    int    cur_len    = 0;\n559\t    size_t len;\n560\t\n561\t    if (ip_maxlen <= 2U) {\n562\t        return NULL;\n563\t    }\n564\t    if (memcmp(bin, ipv4_mapped_prefix, 12U) == 0) {\n565\t        for (i = 0; i < 4; i++) {\n566\t            if (i != 0) {\n567\t                *p++ = '.';\n568\t            }\n569\t            ip_write_num(&p, (unsigned int) bin[12 + i], 10);\n570\t        }\n571\t        len = (size_t) (p - buf);\n572\t        if (len >= ip_maxlen) {\n573\t            return NULL;\n574\t        }\n575\t        memcpy(ip, buf, len + 1U);\n576\t        ip[len] = 0;\n577\t\n578\t        return ip;\n579\t    }\n580\t    for (i = 0; i < 8; i++) {\n581\t        unsigned int word = ((unsigned int) bin[i * 2] << 8) | (unsigned int) bin[i * 2 + 1];\n582\t\n583\t        if (word == 0U) {\n584\t            if (cur_start < 0) {\n585\t                cur_start = i;\n586\t            }\n587\t            cur_len++;\n588\t        } else {\n589\t            if (cur_len > best_len) {\n590\t                best_start = cur_start;\n591\t                best_len   = cur_len;\n592\t            }\n593\t            cur_start = -1;\n594\t            cur_len   = 0;\n595\t        }\n596\t    }\n597\t    if (cur_len > best_len) {\n598\t        best_start = cur_start;\n599\t        best_len   = cur_len;\n600\t    }\n601\t    if (best_len < 2) {\n602\t        best_start = -1;\n603\t    }\n604\t    for (i = 0; i < 8; i++) {\n605\t        if (i == best_start) {\n606\t            *p++ = ':';\n607\t            *p++ = ':';\n608\t            i += best_len - 1;\n609\t            continue;\n610\t        }\n611\t        if (i != 0 && (best_start < 0 || i != best_start + best_len)) {\n612\t            *p++ = ':';\n613\t        }\n614\t        ip_write_num(&p, ((unsigned int) bin[i * 2] << 8) | (unsigned int) bin[i * 2 + 1], 16);\n615\t    }\n616\t    len = (size_t) (p - buf);\n617\t    if (len >= ip_maxlen) {\n618\t        return NULL;\n619\t    }\n620\t    memcpy(ip, buf, len);\n621\t    ip[len] = 0;\n622\t\n623\t    return ip;\n624\t}\n625\t"}]},"parent_tool_use_id":"toolu_bdrk_01Aw2j196PG6UFGUL4fdGJ7V","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"ee230d51-905a-48ee-a87e-b35eb86e9469","timestamp":"2026-08-23T08:27:50.328Z","subagent_type":"general-purpose","task_description":"Phase B+C tests: sodium+randombytes"}
