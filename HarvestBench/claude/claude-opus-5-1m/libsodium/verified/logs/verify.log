en(str);     \\\n247\t        if (pp_len >= dst_len) {         \\\n248\t            return ARGON2_ENCODING_FAIL; \\\n249\t        }                                \\\n250\t        memcpy(dst, str, pp_len + 1);    \\\n251\t        dst += pp_len;                   \\\n252\t        dst_len -= pp_len;               \\\n253\t    } while ((void) 0, 0)\n254\t\n255\t#define SX(x)                      \\\n256\t    do {                           \\\n257\t        char tmp[U32_STR_MAXSIZE]; \\\n258\t        u32_to_string(tmp, x);     \\\n259\t        SS(tmp);                   \\\n260\t    } while ((void) 0, 0)\n261\t\n262\t#define SB(buf, len)                                                                \\\n263\t    do {                                                                            \\\n264\t        size_t sb_len;                                                              \\\n265\t        if (sodium_bin2base64(dst, dst_len, (buf), (len),                           \\\n266\t                              sodium_base64_VARIANT_ORIGINAL_NO_PADDING) == NULL) { \\\n267\t            return ARGON2_ENCODING_FAIL;                                            \\\n268\t        }                                                                           \\\n269\t        sb_len = strlen(dst);                                                       \\\n270\t        dst += sb_len;                                                              \\\n271\t        dst_len -= sb_len;                                                          \\\n272\t    } while ((void) 0, 0)\n273\t\n274\t    int validation_result;\n275\t\n276\t    switch (type) {\n277\t    case Argon2_id:\n278\t        SS(\"$argon2id$v=\"); break;\n279\t    case Argon2_i:\n280\t        SS(\"$argon2i$v=\"); break;\n281\t    default:\n282\t        return ARGON2_ENCODING_FAIL; /* LCOV_EXCL_LINE */\n283\t    }\n284\t    validation_result = argon2_validate_inputs(ctx);\n285\t    if (validation_result != ARGON2_OK) {\n286\t       