{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ohqp4cgw6kbsr6tfxlpzorttex3cdngqua4xdpyctyzjj3ooxqra","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01DfXo72Eac6BAdLbMcUojYo","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-rAO86K/translated_rust/tests/t05_aead_errors.rs","content":"//! Phase C — AEAD error paths (`ERRORS.md` rows for the `crypto_aead_*` group).\n//!\n//! Two kinds of row:\n//!\n//! * **`return -1` rows** — called directly on both `.so`s; the return value,\n//!   the out-parameters (`*mlen_p`) and the output buffer contents (whether the\n//!   plaintext got zeroed) must match byte-for-byte.\n//! * **`sodium_misuse()` rows** — `sodium_misuse()` runs the installed handler\n//!   and then `abort()`s. Each such row is run in a **child process** (once\n//!   against the C `.so`, once against the Rust `.so`) with an observing\n//!   handler installed, so the abort *and* the side effects written before it\n//!   are compared exactly.\n\nmod common;\nuse common::*;\n\ntype Enc = unsafe extern \"C\" fn(\n    *mut u8, *mut u64, *const u8, u64, *const u8, u64, *const u8, *const u8, *const u8,\n) -> i32;\ntype Dec = unsafe extern \"C\" fn(\n    *mut u8, *mut u64, *mut u8, *const u8, u64, *const u8, u64, *const u8, *const u8,\n) -> i32;\ntype EncDet = unsafe extern \"C\" fn(\n    *mut u8, *mut u8, *mut u64, *const u8, u64, *const u8, u64, *const u8, *const u8, *const u8,\n) -> i32;\ntype DecDet = unsafe extern \"C\" fn(\n    *mut u8, *mut u8, *const u8, u64, *const u8, *const u8, u64, *const u8, *const u8,\n) -> i32;\n\nconst AEADS: &[&str] = &[\n    \"crypto_aead_aegis128l\",\n    \"crypto_aead_aegis256\",\n    \"crypto_aead_chacha20poly1305\",\n    \"crypto_aead_chacha20poly1305_ietf\",\n    \"crypto_aead_xchacha20poly1305_ietf\",\n];\n\nfn g(p: &str, s: &str) -> usize {\n    unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{p}_{s}\"))() }\n}\nfn gmax(p: &str) -> u64 {\n    unsafe { sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), &format!(\"{p}_messagebytes_max\"))() }\n}\n\n// ===========================================================================\n// `return -1` rows\n// ===========================================================================\n\n/// ERRORS rows: `_decrypt` with `clen < ABYTES` (0 and ABYTES-1) —\n/// returns -1, `*mlen_p` set to 0, output buffer untouched.\n#[test]\nfn decrypt_clen_below_abytes() {\n    setup();\n    let mut rng = Rng::new(0x9000);\n    for &p in AEADS {\n        let ab = g(p, \"abytes\");\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for clen in 0..=ab {\n            if clen == ab {\n                continue; // ab itself is valid (mlen = 0)\n            }\n            let k = rng.bytes(g(p, \"keybytes\"));\n            let npub = rng.bytes(g(p, \"npubbytes\"));\n            let c = rng.bytes(ab.max(1));\n            for mlen_p_null in [false, true] {\n                let mut m1 = canary(64);\n                let mut m2 = canary(64);\n                let mut o1 = 0xDEAD_BEEF_u64;\n                let mut o2 = 0xDEAD_BEEF_u64;\n                let (p1, p2) = if mlen_p_null {\n                    (std::ptr::null_mut(), std::ptr::null_mut())\n                } else {\n                    (&raw mut o1, &raw mut o2)\n                };\n                let (ra, rb) = unsafe {\n                    (\n                        cd(m1.as_mut_ptr(), p1, std::ptr::null_mut(), c.as_ptr(),\n                           clen as u64, std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n                        rd(m2.as_mut_ptr(), p2, std::ptr::null_mut(), c.as_ptr(),\n                           clen as u64, std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n                    )\n                };\n                eq_i32(&format!(\"{p}_decrypt(clen={clen}) rc\"), ra, rb);\n                assert_eq!(ra, -1, \"{p}_decrypt(clen={clen}) must reject\");\n                eq_usize(&format!(\"{p}_decrypt(clen={clen}) *mlen_p\"), o1 as usize, o2 as usize);\n                if !mlen_p_null {\n                    assert_eq!(o1, 0, \"{p}_decrypt short clen must set *mlen_p = 0\");\n                }\n                eq_bytes(&format!(\"{p}_decrypt(clen={clen}) m untouched\"), &m1, &m2);\n                assert_eq!(m1, canary(64), \"{p}_decrypt short clen wrote to m\");\n            }\n        }\n    }\n}\n\n/// ERRORS rows: `_decrypt` with a wrong tag — for `mlen == 0` (`memset` is a\n/// no-op) and for `mlen > 0` (the plaintext region must be zeroed).\n#[test]\nfn decrypt_bad_tag_zeroes_plaintext() {\n    setup();\n    let mut rng = Rng::new(0x9001);\n    for &p in AEADS {\n        let ab = g(p, \"abytes\");\n        let (ce, _) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for &mlen in &[0usize, 1, 16, 32, 100] {\n            for &adlen in &[0usize, 16] {\n                let k = rng.bytes(g(p, \"keybytes\"));\n                let npub = rng.bytes(g(p, \"npubbytes\"));\n                let m = rng.bytes(mlen);\n                let ad = rng.bytes(adlen);\n                let mut good = canary(mlen + ab);\n                unsafe {\n                    ce(good.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), mlen as u64,\n                       ad.as_ptr(), adlen as u64, std::ptr::null(), npub.as_ptr(), k.as_ptr());\n                }\n                // Corrupt in three distinct places: tag first byte, tag last\n                // byte, and (when mlen > 0) a ciphertext byte.\n                let mut variants: Vec<(String, Vec<u8>)> = Vec::new();\n                let mut v = good.clone();\n                v[mlen] ^= 0x01;\n                variants.push((\"tag[0]\".into(), v));\n                let mut v = good.clone();\n                let last = v.len() - 1;\n                v[last] ^= 0x80;\n                variants.push((\"tag[last]\".into(), v));\n                if mlen > 0 {\n                    let mut v = good.clone();\n                    v[0] ^= 0x01;\n                    variants.push((\"c[0]\".into(), v));\n                }\n                for (what, bad) in variants {\n                    for m_null in [false, true] {\n                        let mut m1 = canary(mlen.max(1));\n                        let mut m2 = canary(mlen.max(1));\n                        let mut o1 = 0xDEAD_u64;\n                        let mut o2 = 0xDEAD_u64;\n                        let (mp1, mp2) = if m_null {\n                            (std::ptr::null_mut(), std::ptr::null_mut())\n                        } else {\n                            (m1.as_mut_ptr(), m2.as_mut_ptr())\n                        };\n                        let (ra, rb) = unsafe {\n                            (\n                                cd(mp1, &mut o1, std::ptr::null_mut(), bad.as_ptr(),\n                                   bad.len() as u64, ad.as_ptr(), adlen as u64,\n                                   npub.as_ptr(), k.as_ptr()),\n                                rd(mp2, &mut o2, std::ptr::null_mut(), bad.as_ptr(),\n                                   bad.len() as u64, ad.as_ptr(), adlen as u64,\n                                   npub.as_ptr(), k.as_ptr()),\n                            )\n                        };\n                        eq_i32(&format!(\"{p}_decrypt bad {what} m_null={m_null} rc\"), ra, rb);\n                        assert_eq!(ra, -1);\n                        eq_usize(\n                            &format!(\"{p}_decrypt bad {what} *mlen_p\"),\n                            o1 as usize, o2 as usize,\n                        );\n                        assert_eq!(o1, 0);\n                        eq_bytes(\n                            &format!(\"{p}_decrypt bad {what} m_null={m_null} buffer\"),\n                            &m1, &m2,\n                        );\n                        if !m_null && mlen > 0 {\n                            assert_eq!(\n                                m1, vec![0u8; mlen],\n                                \"{p}_decrypt must zero the plaintext on tag failure\"\n                            );\n                        }\n                        if m_null {\n                            assert_eq!(\n                                m1, canary(mlen.max(1)),\n                                \"{p}_decrypt m=NULL must not write anything\"\n                            );\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n/// ERRORS row: `_decrypt` with a *correct* tag but mismatched AD.\n#[test]\nfn decrypt_ad_mismatch() {\n    setup();\n    let mut rng = Rng::new(0x9002);\n    for &p in AEADS {\n        let ab = g(p, \"abytes\");\n        let (ce, _) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        let mlen = 100usize;\n        for &(enc_ad, dec_ad) in &[(16usize, 0usize), (0, 16), (16, 17), (17, 16), (100, 99)] {\n            let k = rng.bytes(g(p, \"keybytes\"));\n            let npub = rng.bytes(g(p, \"npubbytes\"));\n            let m = rng.bytes(mlen);\n            let ad = rng.bytes(enc_ad.max(dec_ad));\n            let mut c = canary(mlen + ab);\n            unsafe {\n                ce(c.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), mlen as u64,\n                   ad.as_ptr(), enc_ad as u64, std::ptr::null(), npub.as_ptr(), k.as_ptr());\n            }\n            let mut m1 = canary(mlen);\n            let mut m2 = canary(mlen);\n            let mut o1 = 0xDEADu64;\n            let mut o2 = 0xDEADu64;\n            let (ra, rb) = unsafe {\n                (\n                    cd(m1.as_mut_ptr(), &mut o1, std::ptr::null_mut(), c.as_ptr(),\n                       (mlen + ab) as u64, ad.as_ptr(), dec_ad as u64, npub.as_ptr(), k.as_ptr()),\n                    rd(m2.as_mut_ptr(), &mut o2, std::ptr::null_mut(), c.as_ptr(),\n                       (mlen + ab) as u64, ad.as_ptr(), dec_ad as u64, npub.as_ptr(), k.as_ptr()),\n                )\n            };\n            eq_i32(&format!(\"{p} ad mismatch {enc_ad}->{dec_ad} rc\"), ra, rb);\n            assert_eq!(ra, -1);\n            eq_usize(&format!(\"{p} ad mismatch *mlen_p\"), o1 as usize, o2 as usize);\n            eq_bytes(&format!(\"{p} ad mismatch m\"), &m1, &m2);\n        }\n    }\n}\n\n/// ERRORS rows: xchacha20poly1305 with a nonce wrong in the first half (the\n/// hchacha20 subkey) vs the second half (`npub2[4..12]`) — two distinct\n/// dependencies, both must reject identically.\n#[test]\nfn xchacha_wrong_nonce_halves() {\n    setup();\n    let mut rng = Rng::new(0x9003);\n    let p = \"crypto_aead_xchacha20poly1305_ietf\";\n    let (ce, _) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n    let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n    let mlen = 100usize;\n    for byte_idx in [0usize, 5, 15, 16, 20, 23] {\n        let k = rng.bytes(32);\n        let npub = rng.bytes(24);\n        let m = rng.bytes(mlen);\n        let mut c = canary(mlen + 16);\n        unsafe {\n            ce(c.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), mlen as u64,\n               std::ptr::null(), 0, std::ptr::null(), npub.as_ptr(), k.as_ptr());\n        }\n        let mut bad = npub.clone();\n        bad[byte_idx] ^= 0xff;\n        let mut m1 = canary(mlen);\n        let mut m2 = canary(mlen);\n        let mut o1 = 0xDEADu64;\n        let mut o2 = 0xDEADu64;\n        let (ra, rb) = unsafe {\n            (\n                cd(m1.as_mut_ptr(), &mut o1, std::ptr::null_mut(), c.as_ptr(),\n                   (mlen + 16) as u64, std::ptr::null(), 0, bad.as_ptr(), k.as_ptr()),\n                rd(m2.as_mut_ptr(), &mut o2, std::ptr::null_mut(), c.as_ptr(),\n                   (mlen + 16) as u64, std::ptr::null(), 0, bad.as_ptr(), k.as_ptr()),\n            )\n        };\n        eq_i32(&format!(\"xchacha wrong npub[{byte_idx}] rc\"), ra, rb);\n        assert_eq!(ra, -1);\n        eq_usize(\"xchacha wrong npub *mlen_p\", o1 as usize, o2 as usize);\n        eq_bytes(&format!(\"xchacha wrong npub[{byte_idx}] m\"), &m1, &m2);\n        assert_eq!(m1, vec![0u8; mlen]);\n    }\n}\n\n/// ERRORS rows: `_decrypt_detached` with a wrong MAC (with and without `m`).\n#[test]\nfn decrypt_detached_bad_mac() {\n    setup();\n    let mut rng = Rng::new(0x9004);\n    for &p in AEADS {\n        let ab = g(p, \"abytes\");\n        let (ced, _) = pair::<EncDet>(&format!(\"{p}_encrypt_detached\"));\n        let (cdd, rdd) = pair::<DecDet>(&format!(\"{p}_decrypt_detached\"));\n        for &clen in &[0usize, 1, 5, 16, 32, 100] {\n            let k = rng.bytes(g(p, \"keybytes\"));\n            let npub = rng.bytes(g(p, \"npubbytes\"));\n            let m = rng.bytes(clen);\n            let mut c = canary(clen.max(1));\n            let mut tag = canary(ab);\n            unsafe {\n                ced(c.as_mut_ptr(), tag.as_mut_ptr(), std::ptr::null_mut(),\n                    m.as_ptr(), clen as u64, std::ptr::null(), 0,\n                    std::ptr::null(), npub.as_ptr(), k.as_ptr());\n            }\n            // three distinct wrong MACs, incl. the all-zero and all-ff ones the\n            // table calls out explicitly\n            let mut macs: Vec<(String, Vec<u8>)> = vec![\n                (\"zero\".into(), vec![0u8; ab]),\n                (\"ff\".into(), vec![0xffu8; ab]),\n            ];\n            let mut flip = tag.clone();\n            flip[0] ^= 1;\n            macs.push((\"flip0\".into(), flip));\n            let mut flip = tag.clone();\n            flip[ab - 1] ^= 0x80;\n            macs.push((\"flipN\".into(), flip));\n            for (what, mac) in macs {\n                if mac == tag {\n                    continue;\n                }\n                for m_null in [false, true] {\n                    let mut m1 = canary(clen.max(1));\n                    let mut m2 = canary(clen.max(1));\n                    let (mp1, mp2) = if m_null {\n                        (std::ptr::null_mut(), std::ptr::null_mut())\n                    } else {\n                        (m1.as_mut_ptr(), m2.as_mut_ptr())\n                    };\n                    let (ra, rb) = unsafe {\n                        (\n                            cdd(mp1, std::ptr::null_mut(), c.as_ptr(), clen as u64,\n                                mac.as_ptr(), std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n                            rdd(mp2, std::ptr::null_mut(), c.as_ptr(), clen as u64,\n                                mac.as_ptr(), std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n                        )\n                    };\n                    eq_i32(\n                        &format!(\"{p}_decrypt_detached mac={what} clen={clen} m_null={m_null} rc\"),\n                        ra, rb,\n                    );\n                    assert_eq!(ra, -1);\n                    eq_bytes(\n                        &format!(\"{p}_decrypt_detached mac={what} clen={clen} m_null={m_null}\"),\n                        &m1, &m2,\n                    );\n                    if m_null {\n                        assert_eq!(m1, canary(clen.max(1)), \"{p} m=NULL must not write\");\n                    } else if clen > 0 {\n                        assert_eq!(m1, vec![0u8; clen], \"{p} must zero m on MAC failure\");\n                    }\n                }\n            }\n        }\n    }\n}\n\n/// ERRORS rows: AEGIS `_decrypt_detached` with `clen`/`adlen` above\n/// `MESSAGEBYTES_MAX` returns `-1` *immediately* (asymmetric with the encrypt\n/// side, which aborts). The guard precedes every dereference, so no buffer is\n/// needed. Also the combined `_decrypt` with `clen = MAX + ABYTES + 1`.\n#[test]\nfn aegis_decrypt_oversized_lengths_return_minus_one() {\n    setup();\n    for &p in &[\"crypto_aead_aegis128l\", \"crypto_aead_aegis256\"] {\n        let ab = g(p, \"abytes\") as u64;\n        let max = gmax(p);\n        let (cdd, rdd) = pair::<DecDet>(&format!(\"{p}_decrypt_detached\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        let k = [7u8; 32];\n        let npub = [9u8; 32];\n        let mac = [0u8; 32];\n        let cbuf = [0u8; 64];\n\n        for &(clen, adlen, what) in &[\n            (max + 1, 0u64, \"clen = MAX+1\"),\n            (u64::MAX, 0, \"clen = u64::MAX\"),\n            (0, max + 1, \"adlen = MAX+1\"),\n            (0, u64::MAX, \"adlen = u64::MAX\"),\n            (max + 1, max + 1, \"both = MAX+1\"),\n        ] {\n            let mut m1 = canary(64);\n            let mut m2 = canary(64);\n            let (ra, rb) = unsafe {\n                (\n                    cdd(m1.as_mut_ptr(), std::ptr::null_mut(), cbuf.as_ptr(), clen,\n                        mac.as_ptr(), std::ptr::null(), adlen, npub.as_ptr(), k.as_ptr()),\n                    rdd(m2.as_mut_ptr(), std::ptr::null_mut(), cbuf.as_ptr(), clen,\n                        mac.as_ptr(), std::ptr::null(), adlen, npub.as_ptr(), k.as_ptr()),\n                )\n            };\n            eq_i32(&format!(\"{p}_decrypt_detached {what} rc\"), ra, rb);\n            assert_eq!(ra, -1, \"{p}_decrypt_detached {what} must return -1\");\n            eq_bytes(&format!(\"{p}_decrypt_detached {what} m\"), &m1, &m2);\n            assert_eq!(m1, canary(64));\n        }\n\n        // combined _decrypt: clen - ABYTES > MESSAGEBYTES_MAX -> inner guard\n        for &clen in &[max + ab + 1, u64::MAX] {\n            let mut m1 = canary(64);\n            let mut m2 = canary(64);\n            let mut o1 = 0xDEADu64;\n            let mut o2 = 0xDEADu64;\n            let (ra, rb) = unsafe {\n                (\n                    cd(m1.as_mut_ptr(), &mut o1, std::ptr::null_mut(), cbuf.as_ptr(),\n                       clen, std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n                    rd(m2.as_mut_ptr(), &mut o2, std::ptr::null_mut(), cbuf.as_ptr(),\n                       clen, std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n                )\n            };\n            eq_i32(&format!(\"{p}_decrypt(clen={clen}) rc\"), ra, rb);\n            assert_eq!(ra, -1);\n            eq_usize(&format!(\"{p}_decrypt(clen={clen}) *mlen_p\"), o1 as usize, o2 as usize);\n            assert_eq!(o1, 0);\n            eq_bytes(&format!(\"{p}_decrypt(clen={clen}) m\"), &m1, &m2);\n        }\n    }\n}\n\n/// ERRORS rows: all nine operational `crypto_aead_aes256gcm_*` entry points\n/// set `errno = ENOSYS` and return `-1` in this build.\n#[test]\nfn aes256gcm_sets_enosys() {\n    setup();\n    const ENOSYS: i32 = 38;\n    let mut rng = Rng::new(0x9005);\n    let k = rng.bytes(32);\n    let npub = rng.bytes(12);\n    let m = rng.bytes(64);\n    let ad = rng.bytes(16);\n    let mac = rng.bytes(16);\n    let mut out = canary(128);\n    let mut len = 0u64;\n    let mut st = State::new(512);\n\n    let clear_errno = || {\n        // reset errno via a syscall that is known to succeed\n        let _ = std::fs::metadata(\"/\");\n        std::io::Error::from_raw_os_error(0);\n    };\n    let errno = || std::io::Error::last_os_error().raw_os_error().unwrap_or(0);\n\n    macro_rules! check {\n        ($name:literal, $ty:ty, $call:expr) => {{\n            let (c, r) = pair::<$ty>($name);\n            for which in [c, r] {\n                clear_errno();\n                let f = which;\n                let rc = unsafe { $call(f) };\n                assert_eq!(rc, -1, concat!($name, \" must return -1\"));\n                assert_eq!(errno(), ENOSYS, concat!($name, \" must set errno = ENOSYS\"));\n            }\n        }};\n    }\n\n    check!(\"crypto_aead_aes256gcm_encrypt\", Enc, |f: Enc| f(\n        out.as_mut_ptr(), &mut len, m.as_ptr(), 64, ad.as_ptr(), 16,\n        std::ptr::null(), npub.as_ptr(), k.as_ptr()));\n    check!(\"crypto_aead_aes256gcm_decrypt\", Dec, |f: Dec| f(\n        out.as_mut_ptr(), &mut len, std::ptr::null_mut(), m.as_ptr(), 64,\n        ad.as_ptr(), 16, npub.as_ptr(), k.as_ptr()));\n    check!(\"crypto_aead_aes256gcm_encrypt_detached\", EncDet, |f: EncDet| f(\n        out.as_mut_ptr(), out.as_mut_ptr(), &mut len, m.as_ptr(), 64,\n        ad.as_ptr(), 16, std::ptr::null(), npub.as_ptr(), k.as_ptr()));\n    check!(\"crypto_aead_aes256gcm_decrypt_detached\", DecDet, |f: DecDet| f(\n        out.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), 64, mac.as_ptr(),\n        ad.as_ptr(), 16, npub.as_ptr(), k.as_ptr()));\n    check!(\n        \"crypto_aead_aes256gcm_beforenm\",\n        unsafe extern \"C\" fn(*mut u8, *const u8) -> i32,\n        |f: unsafe extern \"C\" fn(*mut u8, *const u8) -> i32| f(st.as_mut_ptr(), k.as_ptr())\n    );\n\n    type EncAfter = unsafe extern \"C\" fn(\n        *mut u8, *mut u64, *const u8, u64, *const u8, u64, *const u8, *const u8, *const u8,\n    ) -> i32;\n    for name in [\n        \"crypto_aead_aes256gcm_encrypt_afternm\",\n        \"crypto_aead_aes256gcm_decrypt_afternm\",\n        \"crypto_aead_aes256gcm_encrypt_detached_afternm\",\n        \"crypto_aead_aes256gcm_decrypt_detached_afternm\",\n    ] {\n        let (c, r) = pair::<EncAfter>(name);\n        for f in [c, r] {\n            clear_errno();\n            let rc = unsafe {\n                f(out.as_mut_ptr(), &mut len, m.as_ptr(), 64, ad.as_ptr(), 16,\n                  std::ptr::null(), npub.as_ptr(), st.as_ptr())\n            };\n            assert_eq!(rc, -1, \"{name} must return -1\");\n            assert_eq!(errno(), ENOSYS, \"{name} must set errno = ENOSYS\");\n        }\n    }\n}\n\n// ===========================================================================\n// `sodium_misuse()` rows — run out of process\n// ===========================================================================\n\n/// Every abort-path row, identified by tag.\nconst MISUSE_CASES: &[&str] = &[\n    // aegis128l / aegis256 combined encrypt: mlen > MESSAGEBYTES_MAX\n    \"aegis128l/encrypt/mlen=max+1\",\n    \"aegis128l/encrypt/mlen=u64max\",\n    \"aegis256/encrypt/mlen=max+1\",\n    \"aegis256/encrypt/mlen=u64max\",\n    // combined encrypt with oversized adlen (guard lives in _encrypt_detached)\n    \"aegis128l/encrypt/adlen=max+1\",\n    \"aegis256/encrypt/adlen=max+1\",\n    // detached encrypt: *maclen_p is written BEFORE the abort\n    \"aegis128l/encrypt_detached/mlen=max+1\",\n    \"aegis128l/encrypt_detached/adlen=max+1\",\n    \"aegis256/encrypt_detached/mlen=max+1\",\n    \"aegis256/encrypt_detached/adlen=max+1\",\n    // poly1305 AEADs: combined encrypt guards\n    \"chacha20poly1305/encrypt/mlen=max+1\",\n    \"chacha20poly1305_ietf/encrypt/mlen=max+1\",\n    \"chacha20poly1305_ietf/encrypt/mlen=u64max\",\n    \"xchacha20poly1305_ietf/encrypt/mlen=max+1\",\n];\n\nfn prefix_of(tag: &str) -> String {\n    format!(\"crypto_aead_{}\", tag.split('/').next().unwrap())\n}\n\n/// The child half: performs exactly one misusing call on the selected library.\n#[test]\nfn misuse_child() {\n    let Some((tag, lib)) = child_case() else {\n        return;\n    };\n    let p = prefix_of(&tag);\n    let ab = g(&p, \"abytes\");\n    let max = gmax(&p);\n    let k = vec![3u8; g(&p, \"keybytes\")];\n    let npub = vec![4u8; g(&p, \"npubbytes\")];\n    let mbuf = [0u8; 64];\n    let mut cbuf = canary(128);\n    let mut tagbuf = canary(64);\n    let mut maclen = 0xA5A5_A5A5_A5A5_A5A5u64;\n    let mut clen = 0xA5A5_A5A5_A5A5_A5A5u64;\n\n    let parts: Vec<&str> = tag.split('/').collect();\n    let (func, cond) = (parts[1], parts[2]);\n    let big = match cond {\n        \"mlen=max+1\" | \"adlen=max+1\" => max + 1,\n        \"mlen=u64max\" | \"adlen=u64max\" => u64::MAX,\n        other => panic!(\"unknown condition {other}\"),\n    };\n\n    match func {\n        \"encrypt\" => {\n            // observe *clen_p (must remain untouched: the guard precedes it)\n            set_observation((&raw const clen).cast(), 8);\n            let f = sym::<Enc>(lib, &format!(\"{p}_encrypt\"));\n            let (mlen, adlen) = if cond.starts_with(\"mlen\") { (big, 0) } else { (0, big) };\n            let rc = unsafe {\n                f(cbuf.as_mut_ptr(), &raw mut clen, mbuf.as_ptr(), mlen,\n                  std::ptr::null(), adlen, std::ptr::null(), npub.as_ptr(), k.as_ptr())\n            };\n            println!(\"OBS returned rc={rc} clen={clen} ab={ab}\");\n        }\n        \"encrypt_detached\" => {\n            // observe *maclen_p, which IS written before the abort\n            set_observation((&raw const maclen).cast(), 8);\n            let f = sym::<EncDet>(lib, &format!(\"{p}_encrypt_detached\"));\n            let (mlen, adlen) = if cond.starts_with(\"mlen\") { (big, 0) } else { (0, big) };\n            let rc = unsafe {\n                f(cbuf.as_mut_ptr(), tagbuf.as_mut_ptr(), &raw mut maclen, mbuf.as_ptr(),\n                  mlen, std::ptr::null(), adlen, std::ptr::null(), npub.as_ptr(), k.as_ptr())\n            };\n            println!(\"OBS returned rc={rc} maclen={maclen}\");\n        }\n        other => panic!(\"unknown function {other}\"),\n    }\n    // If we get here, the library did NOT abort.\n    use std::io::Write;\n    let _ = std::io::stdout().flush();\n    std::process::exit(0);\n}\n\n#[test]\nfn misuse_paths_match() {\n    if child_tag().is_some() {\n        return;\n    }\n    setup();\n    for &tag in MISUSE_CASES {\n        let c = run_child(\"misuse_child\", \"c\", tag);\n        let r = run_child(\"misuse_child\", \"r\", tag);\n        eq_child(tag, &c, &r);\n        // the C reference must genuinely have gone through sodium_misuse()\n        assert_eq!(\n            c.status.code(),\n            Some(MISUSE_EXIT),\n            \"{tag}: C did not reach sodium_misuse (stdout: {}, stderr: {})\",\n            String::from_utf8_lossy(&c.stdout),\n            String::from_utf8_lossy(&c.stderr)\n        );\n    }\n}\n\n/// ERRORS rows recorded as **not constructible** — documented here so the row\n/// is not silently dropped, with the reason and the place the same C branch\n/// *is* covered.\n#[test]\nfn documented_unreachable_error_rows() {\n    setup();\n    // 1. `crypto_aead_chacha20poly1305_encrypt_detached` / `xchacha..._encrypt_detached`\n    //    have no length guard of their own; the only downstream guard is\n    //    `mlen > SODIUM_SIZE_MAX (= u64::MAX)`, which an `unsigned long long`\n    //    argument can never exceed. Assert the constant so the claim is checked.\n    for p in [\"crypto_stream_chacha20\"] {\n        let m = unsafe {\n            sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), &format!(\"{p}_messagebytes_max\"))()\n        };\n        let m2 = unsafe {\n            sym::<unsafe extern \"C\" fn() -> u64>(r_lib(), &format!(\"{p}_messagebytes_max\"))()\n        };\n        assert_eq!(m, m2);\n        assert_eq!(m, u64::MAX, \"{p}_MESSAGEBYTES_MAX must be unfireable\");\n    }\n    // 2. `crypto_aead_chacha20poly1305_ietf_{encrypt,decrypt}_detached` with\n    //    `mlen > 64*(2^32-1)` aborts inside `crypto_stream_chacha20_ietf_xor_ic`\n    //    (counter-overflow guard). Reaching it through the AEAD needs a 256 GiB\n    //    buffer, but the *same* C branch is driven directly by\n    //    `t06_stream_errors::chacha20_ietf_counter_overflow`.\n    let ietf_max = unsafe {\n        sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), \"crypto_aead_chacha20poly1305_ietf_messagebytes_max\")()\n    };\n    assert_eq!(ietf_max, 64 * (u32::MAX as u64));\n    // 3. `aegis128l_mac`/`aegis256_mac` with `maclen ∉ {16, 32}` is dead code:\n    //    the wrappers hard-code `maclen = ABYTES = 32`. Verified by the\n    //    constant, which is the only value the public API can produce.\n    for p in [\"crypto_aead_aegis128l\", \"crypto_aead_aegis256\"] {\n        assert_eq!(g(p, \"abytes\"), 32, \"{p}_ABYTES pins aegis*_mac's maclen\");\n    }\n    // 4. NULL `c`/`mac`/`npub`/`k` are `__attribute__((nonnull))` parameters:\n    //    the C performs no runtime check, so passing NULL is UB, not a defined\n    //    rejection. Not testable differentially.\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":736,"cache_read_input_tokens":232247,"cache_creation":{"ephemeral_5m_input_tokens":736,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"52c03041-8c33-4923-ae57-082d3ba964d7","timestamp":"2026-08-23T08:23:47.166Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DfXo72Eac6BAdLbMcUojYo","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-rAO86K/translated_rust/tests/t05_aead_errors.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"636c1421-90f8-4e94-82f2-4cd3a4a7861a","timestamp":"2026-08-23T08:23:47.176Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-rAO86K/translated_rust/tests/t05_aead_errors.rs","content":"//! Phase C — AEAD error paths (`ERRORS.md` rows for the `crypto_aead_*` group).\n//!\n//! Two kinds of row:\n//!\n//! * **`return -1` rows** — called directly on both `.so`s; the return value,\n//!   the out-parameters (`*mlen_p`) and the output buffer contents (whether the\n//!   plaintext got zeroed) must match byte-for-byte.\n//! * **`sodium_misuse()` rows** — `sodium_misuse()` runs the installed handler\n//!   and then `abort()`s. Each such row is run in a **child process** (once\n//!   against the C `.so`, once against the Rust `.so`) with an observing\n//!   handler installed, so the abort *and* the side effects written before it\n//!   are compared exactly.\n\nmod common;\nuse common::*;\n\ntype Enc = unsafe extern \"C\" fn(\n    *mut u8, *mut u64, *const u8, u64, *const u8, u64, *const u8, *const u8, *const u8,\n) -> i32;\ntype Dec = unsafe extern \"C\" fn(\n    *mut u8, *mut u64, *mut u8, *const u8, u64, *const u8, u64, *const u8, *const u8,\n) -> i32;\ntype EncDet = unsafe extern \"C\" fn(\n    *mut u8, *mut u8, *mut u64, *const u8, u64, *const u8, u64, *const u8, *const u8, *const u8,\n) -> i32;\ntype DecDet = unsafe extern \"C\" fn(\n    *mut u8, *mut u8, *const u8, u64, *const u8, *const u8, u64, *const u8, *const u8,\n) -> i32;\n\nconst AEADS: &[&str] = &[\n    \"crypto_aead_aegis128l\",\n    \"crypto_aead_aegis256\",\n    \"crypto_aead_chacha20poly1305\",\n    \"crypto_aead_chacha20poly1305_ietf\",\n    \"crypto_aead_xchacha20poly1305_ietf\",\n];\n\nfn g(p: &str, s: &str) -> usize {\n    unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{p}_{s}\"))() }\n}\nfn gmax(p: &str) -> u64 {\n    unsafe { sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), &format!(\"{p}_messagebytes_max\"))() }\n}\n\n// ===========================================================================\n// `return -1` rows\n// ===========================================================================\n\n/// ERRORS rows: `_decrypt` with `clen < ABYTES` (0 and ABYTES-1) —\n/// returns -1, `*mlen_p` set to 0, output buffer untouched.\n#[test]\nfn decrypt_clen_below_abytes() {\n    setup();\n    let mut rng = Rng::new(0x9000);\n    for &p in AEADS {\n        let ab = g(p, \"abytes\");\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for clen in 0..=ab {\n            if clen == ab {\n                continue; // ab itself is valid (mlen = 0)\n            }\n            let k = rng.bytes(g(p, \"keybytes\"));\n            let npub = rng.bytes(g(p, \"npubbytes\"));\n            let c = rng.bytes(ab.max(1));\n            for mlen_p_null in [false, true] {\n                let mut m1 = canary(64);\n                let mut m2 = canary(64);\n                let mut o1 = 0xDEAD_BEEF_u64;\n                let mut o2 = 0xDEAD_BEEF_u64;\n                let (p1, p2) = if mlen_p_null {\n                    (std::ptr::null_mut(), std::ptr::null_mut())\n                } else {\n                    (&raw mut o1, &raw mut o2)\n                };\n                let (ra, rb) = unsafe {\n                    (\n                        cd(m1.as_mut_ptr(), p1, std::ptr::null_mut(), c.as_ptr(),\n                           clen as u64, std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n                        rd(m2.as_mut_ptr(), p2, std::ptr::null_mut(), c.as_ptr(),\n                           clen as u64, std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n                    )\n                };\n                eq_i32(&format!(\"{p}_decrypt(clen={clen}) rc\"), ra, rb);\n                assert_eq!(ra, -1, \"{p}_decrypt(clen={clen}) must reject\");\n                eq_usize(&format!(\"{p}_decrypt(clen={clen}) *mlen_p\"), o1 as usize, o2 as usize);\n                if !mlen_p_null {\n                    assert_eq!(o1, 0, \"{p}_decrypt short clen must set *mlen_p = 0\");\n                }\n                eq_bytes(&format!(\"{p}_decrypt(clen={clen}) m untouched\"), &m1, &m2);\n                assert_eq!(m1, canary(64), \"{p}_decrypt short clen wrote to m\");\n            }\n        }\n    }\n}\n\n/// ERRORS rows: `_decrypt` with a wrong tag — for `mlen == 0` (`memset` is a\n/// no-op) and for `mlen > 0` (the plaintext region must be zeroed).\n#[test]\nfn decrypt_bad_tag_zeroes_plaintext() {\n    setup();\n    let mut rng = Rng::new(0x9001);\n    for &p in AEADS {\n        let ab = g(p, \"abytes\");\n        let (ce, _) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for &mlen in &[0usize, 1, 16, 32, 100] {\n            for &adlen in &[0usize, 16] {\n                let k = rng.bytes(g(p, \"keybytes\"));\n                let npub = rng.bytes(g(p, \"npubbytes\"));\n                let m = rng.bytes(mlen);\n                let ad = rng.bytes(adlen);\n                let mut good = canary(mlen + ab);\n                unsafe {\n                    ce(good.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), mlen as u64,\n                       ad.as_ptr(), adlen as u64, std::ptr::null(), npub.as_ptr(), k.as_ptr());\n                }\n                // Corrupt in three distinct places: tag first byte, tag last\n                // byte, and (when mlen > 0) a ciphertext byte.\n                let mut variants: Vec<(String, Vec<u8>)> = Vec::new();\n                let mut v = good.clone();\n                v[mlen] ^= 0x01;\n                variants.push((\"tag[0]\".into(), v));\n                let mut v = good.clone();\n                let last = v.len() - 1;\n                v[last] ^= 0x80;\n                variants.push((\"tag[last]\".into(), v));\n                if mlen > 0 {\n                    let mut v = good.clone();\n                    v[0] ^= 0x01;\n                    variants.push((\"c[0]\".into(), v));\n                }\n                for (what, bad) in variants {\n                    for m_null in [false, true] {\n                        let mut m1 = canary(mlen.max(1));\n                        let mut m2 = canary(mlen.max(1));\n                        let mut o1 = 0xDEAD_u64;\n                        let mut o2 = 0xDEAD_u64;\n                        let (mp1, mp2) = if m_null {\n                            (std::ptr::null_mut(), std::ptr::null_mut())\n                        } else {\n                            (m1.as_mut_ptr(), m2.as_mut_ptr())\n                        };\n                        let (ra, rb) = unsafe {\n                            (\n                                cd(mp1, &mut o1, std::ptr::null_mut(), bad.as_ptr(),\n                                   bad.len() as u64, ad.as_ptr(), adlen as u64,\n                                   npub.as_ptr(), k.as_ptr()),\n                                rd(mp2, &mut o2, std::ptr::null_mut(), bad.as_ptr(),\n                                   bad.len() as u64, ad.as_ptr(), adlen as u64,\n                                   npub.as_ptr(), k.as_ptr()),\n                            )\n                        };\n                        eq_i32(&format!(\"{p}_decrypt bad {what} m_null={m_null} rc\"), ra, rb);\n                        assert_eq!(ra, -1);\n                        eq_usize(\n                            &format!(\"{p}_decrypt bad {what} *mlen_p\"),\n                            o1 as usize, o2 as usize,\n                        );\n                        assert_eq!(o1, 0);\n                        eq_bytes(\n                            &format!(\"{p}_decrypt bad {what} m_null={m_null} buffer\"),\n                            &m1, &m2,\n                        );\n                        if !m_null && mlen > 0 {\n                            assert_eq!(\n                                m1, vec![0u8; mlen],\n                                \"{p}_decrypt must zero the plaintext on tag failure\"\n                            );\n                        }\n                        if m_null {\n                            assert_eq!(\n                                m1, canary(mlen.max(1)),\n                                \"{p}_decrypt m=NULL must not write anything\"\n                            );\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n/// ERRORS row: `_decrypt` with a *correct* tag but mismatched AD.\n#[test]\nfn decrypt_ad_mismatch() {\n    setup();\n    let mut rng = Rng::new(0x9002);\n    for &p in AEADS {\n        let ab = g(p, \"abytes\");\n        let (ce, _) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        let mlen = 100usize;\n        for &(enc_ad, dec_ad) in &[(16usize, 0usize), (0, 16), (16, 17), (17, 16), (100, 99)] {\n            let k = rng.bytes(g(p, \"keybytes\"));\n            let npub = rng.bytes(g(p, \"npubbytes\"));\n            let m = rng.bytes(mlen);\n            let ad = rng.bytes(enc_ad.max(dec_ad));\n            let mut c = canary(mlen + ab);\n            unsafe {\n                ce(c.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), mlen as u64,\n                   ad.as_ptr(), enc_ad as u64, std::ptr::null(), npub.as_ptr(), k.as_ptr());\n            }\n            let mut m1 = canary(mlen);\n            let mut m2 = canary(mlen);\n            let mut o1 = 0xDEADu64;\n            let mut o2 = 0xDEADu64;\n            let (ra, rb) = unsafe {\n                (\n                    cd(m1.as_mut_ptr(), &mut o1, std::ptr::null_mut(), c.as_ptr(),\n                       (mlen + ab) as u64, ad.as_ptr(), dec_ad as u64, npub.as_ptr(), k.as_ptr()),\n                    rd(m2.as_mut_ptr(), &mut o2, std::ptr::null_mut(), c.as_ptr(),\n                       (mlen + ab) as u64, ad.as_ptr(), dec_ad as u64, npub.as_ptr(), k.as_ptr()),\n                )\n            };\n            eq_i32(&format!(\"{p} ad mismatch {enc_ad}->{dec_ad} rc\"), ra, rb);\n            assert_eq!(ra, -1);\n            eq_usize(&format!(\"{p} ad mismatch *mlen_p\"), o1 as usize, o2 as usize);\n            eq_bytes(&format!(\"{p} ad mismatch m\"), &m1, &m2);\n        }\n    }\n}\n\n/// ERRORS rows: xchacha20poly1305 with a nonce wrong in the first half (the\n/// hchacha20 subkey) vs the second half (`npub2[4..12]`) — two distinct\n/// dependencies, both must reject identically.\n#[test]\nfn xchacha_wrong_nonce_halves() {\n    setup();\n    let mut rng = Rng::new(0x9003);\n    let p = \"crypto_aead_xchacha20poly1305_ietf\";\n    let (ce, _) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n    let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n    let mlen = 100usize;\n    for byte_idx in [0usize, 5, 15, 16, 20, 23] {\n        let k = rng.bytes(32);\n        let npub = rng.bytes(24);\n        let m = rng.bytes(mlen);\n        let mut c = canary(mlen + 16);\n        unsafe {\n            ce(c.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), mlen as u64,\n               std::ptr::null(), 0, std::ptr::null(), npub.as_ptr(), k.as_ptr());\n        }\n        let mut bad = npub.clone();\n        bad[byte_idx] ^= 0xff;\n        let mut m1 = canary(mlen);\n        let mut m2 = canary(mlen);\n        let mut o1 = 0xDEADu64;\n        let mut o2 = 0xDEADu64;\n        let (ra, rb) = unsafe {\n            (\n                cd(m1.as_mut_ptr(), &mut o1, std::ptr::null_mut(), c.as_ptr(),\n                   (mlen + 16) as u64, std::ptr::null(), 0, bad.as_ptr(), k.as_ptr()),\n                rd(m2.as_mut_ptr(), &mut o2, std::ptr::null_mut(), c.as_ptr(),\n                   (mlen + 16) as u64, std::ptr::null(), 0, bad.as_ptr(), k.as_ptr()),\n            )\n        };\n        eq_i32(&format!(\"xchacha wrong npub[{byte_idx}] rc\"), ra, rb);\n        assert_eq!(ra, -1);\n        eq_usize(\"xchacha wrong npub *mlen_p\", o1 as usize, o2 as usize);\n        eq_bytes(&format!(\"xchacha wrong npub[{byte_idx}] m\"), &m1, &m2);\n        assert_eq!(m1, vec![0u8; mlen]);\n    }\n}\n\n/// ERRORS rows: `_decrypt_detached` with a wrong MAC (with and without `m`).\n#[test]\nfn decrypt_detached_bad_mac() {\n    setup();\n    let mut rng = Rng::new(0x9004);\n    for &p in AEADS {\n        let ab = g(p, \"abytes\");\n        let (ced, _) = pair::<EncDet>(&format!(\"{p}_encrypt_detached\"));\n        let (cdd, rdd) = pair::<DecDet>(&format!(\"{p}_decrypt_detached\"));\n        for &clen in &[0usize, 1, 5, 16, 32, 100] {\n            let k = rng.bytes(g(p, \"keybytes\"));\n            let npub = rng.bytes(g(p, \"npubbytes\"));\n            let m = rng.bytes(clen);\n            let mut c = canary(clen.max(1));\n            let mut tag = canary(ab);\n            unsafe {\n                ced(c.as_mut_ptr(), tag.as_mut_ptr(), std::ptr::null_mut(),\n                    m.as_ptr(), clen as u64, std::ptr::null(), 0,\n                    std::ptr::null(), npub.as_ptr(), k.as_ptr());\n            }\n            // three distinct wrong MACs, incl. the all-zero and all-ff ones the\n            // table calls out explicitly\n            let mut macs: Vec<(String, Vec<u8>)> = vec![\n                (\"zero\".into(), vec![0u8; ab]),\n                (\"ff\".into(), vec![0xffu8; ab]),\n            ];\n            let mut flip = tag.clone();\n            flip[0] ^= 1;\n            macs.push((\"flip0\".into(), flip));\n            let mut flip = tag.clone();\n            flip[ab - 1] ^= 0x80;\n            macs.push((\"flipN\".into(), flip));\n            for (what, mac) in macs {\n                if mac == tag {\n                    continue;\n                }\n                for m_null in [false, true] {\n                    let mut m1 = canary(clen.max(1));\n                    let mut m2 = canary(clen.max(1));\n                    let (mp1, mp2) = if m_null {\n                        (std::ptr::null_mut(), std::ptr::null_mut())\n                    } else {\n                        (m1.as_mut_ptr(), m2.as_mut_ptr())\n                    };\n                    let (ra, rb) = unsafe {\n                        (\n                            cdd(mp1, std::ptr::null_mut(), c.as_ptr(), clen as u64,\n                                mac.as_ptr(), std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n                            rdd(mp2, std::ptr::null_mut(), c.as_ptr(), clen as u64,\n                                mac.as_ptr(), std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n                        )\n                    };\n                    eq_i32(\n                        &format!(\"{p}_decrypt_detached mac={what} clen={clen} m_null={m_null} rc\"),\n                        ra, rb,\n                    );\n                    assert_eq!(ra, -1);\n                    eq_bytes(\n                        &format!(\"{p}_decrypt_detached mac={what} clen={clen} m_null={m_null}\"),\n                        &m1, &m2,\n                    );\n                    if m_null {\n                        assert_eq!(m1, canary(clen.max(1)), \"{p} m=NULL must not write\");\n                    } else if clen > 0 {\n                        assert_eq!(m1, vec![0u8; clen], \"{p} must zero m on MAC failure\");\n                    }\n                }\n            }\n        }\n    }\n}\n\n/// ERRORS rows: AEGIS `_decrypt_detached` with `clen`/`adlen` above\n/// `MESSAGEBYTES_MAX` returns `-1` *immediately* (asymmetric with the encrypt\n/// side, which aborts). The guard precedes every dereference, so no buffer is\n/// needed. Also the combined `_decrypt` with `clen = MAX + ABYTES + 1`.\n#[test]\nfn aegis_decrypt_oversized_lengths_return_minus_one() {\n    setup();\n    for &p in &[\"crypto_aead_aegis128l\", \"crypto_aead_aegis256\"] {\n        let ab = g(p, \"abytes\") as u64;\n        let max = gmax(p);\n        let (cdd, rdd) = pair::<DecDet>(&format!(\"{p}_decrypt_detached\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        let k = [7u8; 32];\n        let npub = [9u8; 32];\n        let mac = [0u8; 32];\n        let cbuf = [0u8; 64];\n\n        for &(clen, adlen, what) in &[\n            (max + 1, 0u64, \"clen = MAX+1\"),\n            (u64::MAX, 0, \"clen = u64::MAX\"),\n            (0, max + 1, \"adlen = MAX+1\"),\n            (0, u64::MAX, \"adlen = u64::MAX\"),\n            (max + 1, max + 1, \"both = MAX+1\"),\n        ] {\n            let mut m1 = canary(64);\n            let mut m2 = canary(64);\n            let (ra, rb) = unsafe {\n                (\n                    cdd(m1.as_mut_ptr(), std::ptr::null_mut(), cbuf.as_ptr(), clen,\n                        mac.as_ptr(), std::ptr::null(), adlen, npub.as_ptr(), k.as_ptr()),\n                    rdd(m2.as_mut_ptr(), std::ptr::null_mut(), cbuf.as_ptr(), clen,\n                        mac.as_ptr(), std::ptr::null(), adlen, npub.as_ptr(), k.as_ptr()),\n                )\n            };\n            eq_i32(&format!(\"{p}_decrypt_detached {what} rc\"), ra, rb);\n            assert_eq!(ra, -1, \"{p}_decrypt_detached {what} must return -1\");\n            eq_bytes(&format!(\"{p}_decrypt_detached {what} m\"), &m1, &m2);\n            assert_eq!(m1, canary(64));\n        }\n\n        // combined _decrypt: clen - ABYTES > MESSAGEBYTES_MAX -> inner guard\n        for &clen in &[max + ab + 1, u64::MAX] {\n            let mut m1 = canary(64);\n            let mut m2 = canary(64);\n            let mut o1 = 0xDEADu64;\n            let mut o2 = 0xDEADu64;\n            let (ra, rb) = unsafe {\n                (\n                    cd(m1.as_mut_ptr(), &mut o1, std::ptr::null_mut(), cbuf.as_ptr(),\n                       clen, std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n                    rd(m2.as_mut_ptr(), &mut o2, std::ptr::null_mut(), cbuf.as_ptr(),\n                       clen, std::ptr::null(), 0, npub.as_ptr(), k.as_ptr()),\n                )\n            };\n            eq_i32(&format!(\"{p}_decrypt(clen={clen}) rc\"), ra, rb);\n            assert_eq!(ra, -1);\n            eq_usize(&format!(\"{p}_decrypt(clen={clen}) *mlen_p\"), o1 as usize, o2 as usize);\n            assert_eq!(o1, 0);\n            eq_bytes(&format!(\"{p}_decrypt(clen={clen}) m\"), &m1, &m2);\n        }\n    }\n}\n\n/// ERRORS rows: all nine operational `crypto_aead_aes256gcm_*` entry points\n/// set `errno = ENOSYS` and return `-1` in this build.\n#[test]\nfn aes256gcm_sets_enosys() {\n    setup();\n    const ENOSYS: i32 = 38;\n    let mut rng = Rng::new(0x9005);\n    let k = rng.bytes(32);\n    let npub = rng.bytes(12);\n    let m = rng.bytes(64);\n    let ad = rng.bytes(16);\n    let mac = rng.bytes(16);\n    let mut out = canary(128);\n    let mut len = 0u64;\n    let mut st = State::new(512);\n\n    let clear_errno = || {\n        // reset errno via a syscall that is known to succeed\n        let _ = std::fs::metadata(\"/\");\n        std::io::Error::from_raw_os_error(0);\n    };\n    let errno = || std::io::Error::last_os_error().raw_os_error().unwrap_or(0);\n\n    macro_rules! check {\n        ($name:literal, $ty:ty, $call:expr) => {{\n            let (c, r) = pair::<$ty>($name);\n            for which in [c, r] {\n                clear_errno();\n                let f = which;\n                let rc = unsafe { $call(f) };\n                assert_eq!(rc, -1, concat!($name, \" must return -1\"));\n                assert_eq!(errno(), ENOSYS, concat!($name, \" must set errno = ENOSYS\"));\n            }\n        }};\n    }\n\n    check!(\"crypto_aead_aes256gcm_encrypt\", Enc, |f: Enc| f(\n        out.as_mut_ptr(), &mut len, m.as_ptr(), 64, ad.as_ptr(), 16,\n        std::ptr::null(), npub.as_ptr(), k.as_ptr()));\n    check!(\"crypto_aead_aes256gcm_decrypt\", Dec, |f: Dec| f(\n        out.as_mut_ptr(), &mut len, std::ptr::null_mut(), m.as_ptr(), 64,\n        ad.as_ptr(), 16, npub.as_ptr(), k.as_ptr()));\n    check!(\"crypto_aead_aes256gcm_encrypt_detached\", EncDet, |f: EncDet| f(\n        out.as_mut_ptr(), out.as_mut_ptr(), &mut len, m.as_ptr(), 64,\n        ad.as_ptr(), 16, std::ptr::null(), npub.as_ptr(), k.as_ptr()));\n    check!(\"crypto_aead_aes256gcm_decrypt_detached\", DecDet, |f: DecDet| f(\n        out.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), 64, mac.as_ptr(),\n        ad.as_ptr(), 16, npub.as_ptr(), k.as_ptr()));\n    check!(\n        \"crypto_aead_aes256gcm_beforenm\",\n        unsafe extern \"C\" fn(*mut u8, *const u8) -> i32,\n        |f: unsafe extern \"C\" fn(*mut u8, *const u8) -> i32| f(st.as_mut_ptr(), k.as_ptr())\n    );\n\n    type EncAfter = unsafe extern \"C\" fn(\n        *mut u8, *mut u64, *const u8, u64, *const u8, u64, *const u8, *const u8, *const u8,\n    ) -> i32;\n    for name in [\n        \"crypto_aead_aes256gcm_encrypt_afternm\",\n        \"crypto_aead_aes256gcm_decrypt_afternm\",\n        \"crypto_aead_aes256gcm_encrypt_detached_afternm\",\n        \"crypto_aead_aes256gcm_decrypt_detached_afternm\",\n    ] {\n        let (c, r) = pair::<EncAfter>(name);\n        for f in [c, r] {\n            clear_errno();\n            let rc = unsafe {\n                f(out.as_mut_ptr(), &mut len, m.as_ptr(), 64, ad.as_ptr(), 16,\n                  std::ptr::null(), npub.as_ptr(), st.as_ptr())\n            };\n            assert_eq!(rc, -1, \"{name} must return -1\");\n            assert_eq!(errno(), ENOSYS, \"{name} must set errno = ENOSYS\");\n        }\n    }\n}\n\n// ===========================================================================\n// `sodium_misuse()` rows — run out of process\n// ===========================================================================\n\n/// Every abort-path row, identified by tag.\nconst MISUSE_CASES: &[&str] = &[\n    // aegis128l / aegis256 combined encrypt: mlen > MESSAGEBYTES_MAX\n    \"aegis128l/encrypt/mlen=max+1\",\n    \"aegis128l/encrypt/mlen=u64max\",\n    \"aegis256/encrypt/mlen=max+1\",\n    \"aegis256/encrypt/mlen=u64max\",\n    // combined encrypt with oversized adlen (guard lives in _encrypt_detached)\n    \"aegis128l/encrypt/adlen=max+1\",\n    \"aegis256/encrypt/adlen=max+1\",\n    // detached encrypt: *maclen_p is written BEFORE the abort\n    \"aegis128l/encrypt_detached/mlen=max+1\",\n    \"aegis128l/encrypt_detached/adlen=max+1\",\n    \"aegis256/encrypt_detached/mlen=max+1\",\n    \"aegis256/encrypt_detached/adlen=max+1\",\n    // poly1305 AEADs: combined encrypt guards\n    \"chacha20poly1305/encrypt/mlen=max+1\",\n    \"chacha20poly1305_ietf/encrypt/mlen=max+1\",\n    \"chacha20poly1305_ietf/encrypt/mlen=u64max\",\n    \"xchacha20poly1305_ietf/encrypt/mlen=max+1\",\n];\n\nfn prefix_of(tag: &str) -> String {\n    format!(\"crypto_aead_{}\", tag.split('/').next().unwrap())\n}\n\n/// The child half: performs exactly one misusing call on the selected library.\n#[test]\nfn misuse_child() {\n    let Some((tag, lib)) = child_case() else {\n        return;\n    };\n    let p = prefix_of(&tag);\n    let ab = g(&p, \"abytes\");\n    let max = gmax(&p);\n    let k = vec![3u8; g(&p, \"keybytes\")];\n    let npub = vec![4u8; g(&p, \"npubbytes\")];\n    let mbuf = [0u8; 64];\n    let mut cbuf = canary(128);\n    let mut tagbuf = canary(64);\n    let mut maclen = 0xA5A5_A5A5_A5A5_A5A5u64;\n    let mut clen = 0xA5A5_A5A5_A5A5_A5A5u64;\n\n    let parts: Vec<&str> = tag.split('/').collect();\n    let (func, cond) = (parts[1], parts[2]);\n    let big = match cond {\n        \"mlen=max+1\" | \"adlen=max+1\" => max + 1,\n        \"mlen=u64max\" | \"adlen=u64max\" => u64::MAX,\n        other => panic!(\"unknown condition {other}\"),\n    };\n\n    match func {\n        \"encrypt\" => {\n            // observe *clen_p (must remain untouched: the guard precedes it)\n            set_observation((&raw const clen).cast(), 8);\n            let f = sym::<Enc>(lib, &format!(\"{p}_encrypt\"));\n            let (mlen, adlen) = if cond.starts_with(\"mlen\") { (big, 0) } else { (0, big) };\n            let rc = unsafe {\n                f(cbuf.as_mut_ptr(), &raw mut clen, mbuf.as_ptr(), mlen,\n                  std::ptr::null(), adlen, std::ptr::null(), npub.as_ptr(), k.as_ptr())\n            };\n            println!(\"OBS returned rc={rc} clen={clen} ab={ab}\");\n        }\n        \"encrypt_detached\" => {\n            // observe *maclen_p, which IS written before the abort\n            set_observation((&raw const maclen).cast(), 8);\n            let f = sym::<EncDet>(lib, &format!(\"{p}_encrypt_detached\"));\n            let (mlen, adlen) = if cond.starts_with(\"mlen\") { (big, 0) } else { (0, big) };\n            let rc = unsafe {\n                f(cbuf.as_mut_ptr(), tagbuf.as_mut_ptr(), &raw mut maclen, mbuf.as_ptr(),\n                  mlen, std::ptr::null(), adlen, std::ptr::null(), npub.as_ptr(), k.as_ptr())\n            };\n            println!(\"OBS returned rc={rc} maclen={maclen}\");\n        }\n        other => panic!(\"unknown function {other}\"),\n    }\n    // If we get here, the library did NOT abort.\n    use std::io::Write;\n    let _ = std::io::stdout().flush();\n    std::process::exit(0);\n}\n\n#[test]\nfn misuse_paths_match() {\n    if child_tag().is_some() {\n        return;\n    }\n    setup();\n    for &tag in MISUSE_CASES {\n        let c = run_child(\"misuse_child\", \"c\", tag);\n        let r = run_child(\"misuse_child\", \"r\", tag);\n        eq_child(tag, &c, &r);\n        // the C reference must genuinely have gone through sodium_misuse()\n        assert_eq!(\n            c.status.code(),\n            Some(MISUSE_EXIT),\n            \"{tag}: C did not reach sodium_misuse (stdout: {}, stderr: {})\",\n            String::from_utf8_lossy(&c.stdout),\n            String::from_utf8_lossy(&c.stderr)\n        );\n    }\n}\n\n/// ERRORS rows recorded as **not constructible** — documented here so the row\n/// is not silently dropped, with the reason and the place the same C branch\n/// *is* covered.\n#[test]\nfn documented_unreachable_error_rows() {\n    setup();\n    // 1. `crypto_aead_chacha20poly1305_encrypt_detached` / `xchacha..._encrypt_detached`\n    //    have no length guard of their own; the only downstream guard is\n    //    `mlen > SODIUM_SIZE_MAX (= u64::MAX)`, which an `unsigned long long`\n    //    argument can never exceed. Assert the constant so the claim is checked.\n    for p in [\"crypto_stream_chacha20\"] {\n        let m = unsafe {\n            sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), &format!(\"{p}_messagebytes_max\"))()\n        };\n        let m2 = unsafe {\n            sym::<unsafe extern \"C\" fn() -> u64>(r_lib(), &format!(\"{p}_messagebytes_max\"))()\n        };\n        assert_eq!(m, m2);\n        assert_eq!(m, u64::MAX, \"{p}_MESSAGEBYTES_MAX must be unfireable\");\n    }\n    // 2. `crypto_aead_chacha20poly1305_ietf_{encrypt,decrypt}_detached` with\n    //    `mlen > 64*(2^32-1)` aborts inside `crypto_stream_chacha20_ietf_xor_ic`\n    //    (counter-overflow guard). Reaching it through the AEAD needs a 256 GiB\n    //    buffer, but the *same* C branch is driven directly by\n    //    `t06_stream_errors::chacha20_ietf_counter_overflow`.\n    let ietf_max = unsafe {\n        sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), \"crypto_aead_chacha20poly1305_ietf_messagebytes_max\")()\n    };\n    assert_eq!(ietf_max, 64 * (u32::MAX as u64));\n    // 3. `aegis128l_mac`/`aegis256_mac` with `maclen ∉ {16, 32}` is dead code:\n    //    the wrappers hard-code `maclen = ABYTES = 32`. Verified by the\n    //    constant, which is the only value the public API can produce.\n    for p in [\"crypto_aead_aegis128l\", \"crypto_aead_aegis256\"] {\n        assert_eq!(g(p, \"abytes\"), 32, \"{p}_ABYTES pin