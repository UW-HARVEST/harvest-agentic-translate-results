{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EWFhdw7cqVZHyYDrDG79mk","type":"tool_result","content":"1\t//! Translation of `crypto_core/softaes/softaes.c` plus the `static inline`\n2\t//! helpers and types of `include/sodium/private/softaes.h`.\n3\t//!\n4\t//! Build configuration notes (see `src/lib.rs`): the reference C build defines\n5\t//! neither `__wasm__` nor `FAVOR_PERFORMANCE`, so softaes.c compiles its\n6\t//! `#else` branch — the SRM-1R bitsliced round.  The 1024-entry `_aes_lut`\n7\t//! table and the table-driven `softaes_block_encrypt` /\n8\t//! `softaes_block_encryptlast` of the `FAVOR_PERFORMANCE` branch are therefore\n9\t//! *not* part of this translation.  `HAVE_INLINE_ASM` is likewise undefined, so\n10\t//! the `__asm__ __volatile__` compiler barriers in `softaes_block_encryptlast`\n11\t//! are absent.  `SOFTAES_STRIDE` keeps its default value of 16.\n12\t//!\n13\t//! The public entry points are renamed by `include/sodium/private/quirks.h`,\n14\t//! hence the `_sodium_` prefix on every exported symbol.\n15\t\n16\tuse crate::common::{load32_le, store32_le};\n17\t\n18\t/* ------------------------------------------------------------------ */\n19\t/* private/softaes.h                                                  */\n20\t/* ------------------------------------------------------------------ */\n21\t\n22\t/// ```c\n23\t/// typedef struct SoftAesBlock {\n24\t///     uint32_t w0;\n25\t///     uint32_t w1;\n26\t///     uint32_t w2;\n27\t///     uint32_t w3;\n28\t/// } SoftAesBlock;\n29\t/// ```\n30\t#[repr(C)]\n31\t#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\n32\tpub struct SoftAesBlock {\n33\t    pub w0: u32,\n34\t    pub w1: u32,\n35\t    pub w2: u32,\n36\t    pub w3: u32,\n37\t}\n38\t\n39\t/// `static inline SoftAesBlock softaes_block_load(const uint8_t in[16])`\n40\t#[inline(always)]\n41\tpub unsafe fn softaes_block_load(in_: *const u8) -> SoftAesBlock {\n42\t    SoftAesBlock {\n43\t        w0: unsafe { load32_le(in_.add(0)) },\n44\t        w1: unsafe { load32_le(in_.add(4)) },\n45\t        w2: unsafe { load32_le(in_.add(8)) },\n46\t        w3: unsafe { load32_le(in_.add(12)) },\n47\t    }\n48\t}\n49\t\n50\t/// `static inline SoftAesBlock softaes_block_load64x2(const uint64_t a, const uint64_t b)`\n51\t#[inline(always)]\n52\tpub fn softaes_block_load64x2(a: u64, b: u64) -> SoftAesBlock {\n53\t    SoftAesBlock {\n54\t        w0: b as u32,\n55\t        w1: (b >> 32) as u32,\n56\t        w2: a as u32,\n57\t        w3: (a >> 32) as u32,\n58\t    }\n59\t}\n60\t\n61\t/// `static inline void softaes_block_store(uint8_t out[16], const SoftAesBlock in)`\n62\t#[inline(always)]\n63\tpub unsafe fn softaes_block_store(out: *mut u8, in_: SoftAesBlock) {\n64\t    unsafe { store32_le(out.add(0), in_.w0) };\n65\t    unsafe { store32_le(out.add(4), in_.w1) };\n66\t    unsafe { store32_le(out.add(8), in_.w2) };\n67\t    unsafe { store32_le(out.add(12), in_.w3) };\n68\t}\n69\t\n70\t/// `static inline SoftAesBlock softaes_block_xor(const SoftAesBlock a, const SoftAesBlock b)`\n71\t#[inline(always)]\n72\tpub fn softaes_block_xor(a: SoftAesBlock, b: SoftAesBlock) -> SoftAesBlock {\n73\t    SoftAesBlock {\n74\t        w0: a.w0 ^ b.w0,\n75\t        w1: a.w1 ^ b.w1,\n76\t        w2: a.w2 ^ b.w2,\n77\t        w3: a.w3 ^ b.w3,\n78\t    }\n79\t}\n80\t\n81\t/// `static inline SoftAesBlock softaes_block_and(const SoftAesBlock a, const SoftAesBlock b)`\n82\t#[inline(always)]\n83\tpub fn softaes_block_and(a: SoftAesBlock, b: SoftAesBlock) -> SoftAesBlock {\n84\t    SoftAesBlock {\n85\t        w0: a.w0 & b.w0,\n86\t        w1: a.w1 & b.w1,\n87\t        w2: a.w2 & b.w2,\n88\t        w3: a.w3 & b.w3,\n89\t    }\n90\t}\n91\t\n92\t/* ------------------------------------------------------------------ */\n93\t/* softaes.c                                                          */\n94\t/* ------------------------------------------------------------------ */\n95\t\n96\t/// `static const uint8_t SBOX[256]`\n9