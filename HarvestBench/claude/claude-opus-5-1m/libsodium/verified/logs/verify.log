RPREFIXBYTES 14\n40\t#define crypto_pwhash_scryptsalsa208sha256_STRSETTINGBYTES 57\n41\t#define crypto_pwhash_scryptsalsa208sha256_STRSALTBYTES 32\n42\t#define crypto_pwhash_scryptsalsa208sha256_STRSALTBYTES_ENCODED 43\n43\t#define crypto_pwhash_scryptsalsa208sha256_STRHASHBYTES 32\n44\t#define crypto_pwhash_scryptsalsa208sha256_STRHASHBYTES_ENCODED 43\n45\t\n46\t#define BYTES2CHARS(bytes) ((((bytes) *8) + 5) / 6)\n47\t\n48\ttypedef struct {\n49\t    void * base, *aligned;\n50\t    size_t size;\n51\t} escrypt_region_t;\n52\t\n53\ttypedef escrypt_region_t escrypt_local_t;\n54\t\n55\tint escrypt_init_local(escrypt_local_t *__local);\n56\t\n57\tint escrypt_free_local(escrypt_local_t *__local);\n58\t\n59\tvoid *escrypt_alloc_region(escrypt_region_t *region, size_t size);\n60\tint escrypt_free_region(escrypt_region_t *region);\n61\t\n62\ttypedef int (*escrypt_kdf_t)(escrypt_local_t *__local, const uint8_t *__passwd,\n63\t                             size_t __passwdlen, const uint8_t *__salt,\n64\t                             size_t __saltlen, uint64_t __N, uint32_t __r,\n65\t                             uint32_t __p, uint8_t *__buf, size_t __buflen);\n66\t\n67\tint escrypt_kdf_nosse(escrypt_local_t *__local, const uint8_t *__passwd,\n68\t                      size_t __passwdlen, const uint8_t *__salt,\n69\t                      size_t __saltlen, uint64_t __N, uint32_t __r,\n70\t                      uint32_t __p, uint8_t *__buf, size_t __buflen);\n71\t\n72\tint escrypt_kdf_sse(escrypt_local_t *__local, const uint8_t *__passwd,\n73\t                    size_t __passwdlen, const uint8_t *__salt,\n74\t                    size_t __saltlen, uint64_t __N, uint32_t __r,\n75\t                    uint32_t __p, uint8_t *__buf, size_t __buflen);\n76\t\n77\tuint8_t *escrypt_r(escrypt_local_t *__local, const uint8_t *__passwd,\n78\t                   size_t __passwdlen, const uint8_t *__setting,\n79\t                   uint8_t *__buf, size_t __buflen);\n80\t\n81\tuint8_t *escrypt_gen