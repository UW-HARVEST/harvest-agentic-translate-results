{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011Qh2YgiYHHzKWLSKjo88GG","type":"tool_result","content":"1\t//! `randombytes/randombytes.c`\n2\t\n3\tpub mod internal;\n4\tpub mod os;\n5\tpub mod sysrandom;\n6\t\n7\tuse core::ffi::{c_char, c_int, c_void};\n8\t\n9\tunsafe extern \"C\" {\n10\t    fn crypto_stream_chacha20_ietf(c: *mut u8, clen: u64, n: *const u8, k: *const u8) -> c_int;\n11\t}\n12\t\n13\tpub const RANDOMBYTES_SEEDBYTES: usize = 32;\n14\t\n15\t/// `randombytes_BYTES_MAX` == min(SODIUM_SIZE_MAX, 0xffffffff)\n16\tpub const RANDOMBYTES_BYTES_MAX: u64 = 0xffffffff;\n17\t\n18\t#[repr(C)]\n19\t#[derive(Clone, Copy)]\n20\tpub struct RandombytesImplementation {\n21\t    pub implementation_name: Option<extern \"C\" fn() -> *const c_char>,\n22\t    pub random: Option<extern \"C\" fn() -> u32>,\n23\t    pub stir: Option<extern \"C\" fn()>,\n24\t    pub uniform: Option<extern \"C\" fn(u32) -> u32>,\n25\t    pub buf: Option<unsafe extern \"C\" fn(*mut c_void, usize)>,\n26\t    pub close: Option<extern \"C\" fn() -> c_int>,\n27\t}\n28\t\n29\tunsafe impl Sync for RandombytesImplementation {}\n30\t\n31\tstatic mut IMPLEMENTATION: *const RandombytesImplementation = core::ptr::null();\n32\t\n33\tfn randombytes_init_if_needed() {\n34\t    if unsafe { IMPLEMENTATION }.is_null() {\n35\t        unsafe {\n36\t            IMPLEMENTATION = &raw const sysrandom::randombytes_sysrandom_implementation;\n37\t        }\n38\t        randombytes_stir();\n39\t    }\n40\t}\n41\t\n42\t#[inline]\n43\tfn impl_ref() -> &'static RandombytesImplementation {\n44\t    unsafe { &*IMPLEMENTATION }\n45\t}\n46\t\n47\t#[unsafe(no_mangle)]\n48\tpub extern \"C\" fn randombytes_set_implementation(\n49\t    r#impl: *const RandombytesImplementation,\n50\t) -> c_int {\n51\t    unsafe { IMPLEMENTATION = r#impl };\n52\t    0\n53\t}\n54\t\n55\t#[unsafe(no_mangle)]\n56\tpub extern \"C\" fn randombytes_implementation_name() -> *const c_char {\n57\t    randombytes_init_if_needed();\n58\t    (impl_ref().implementation_name.unwrap())()\n59\t}\n60\t\n61\t#[unsafe(no_mangle)]\n62\tpub extern \"C\" fn randombytes_random() -> u32 {\n63\t    randombytes_init_if_needed();\n64\t    (impl_ref().random.unwrap())()\n65\t}\n66\t\n67\t#[unsafe(no_mangle)]\n68\tpub extern \"C\" fn randombytes_stir() {\n69\t    randombytes_init_if_needed();\n70\t    if let Some(stir) = impl_ref().stir {\n71\t        stir();\n72\t    }\n73\t}\n74\t\n75\t#[unsafe(no_mangle)]\n76\tpub extern \"C\" fn randombytes_uniform(upper_bound: u32) -> u32 {\n77\t    randombytes_init_if_needed();\n78\t    if let Some(uniform) = impl_ref().uniform {\n79\t        return uniform(upper_bound);\n80\t    }\n81\t    if upper_bound < 2 {\n82\t        return 0;\n83\t    }\n84\t    let min = (1u32.wrapping_add(!upper_bound)) % upper_bound;\n85\t    let mut r;\n86\t    loop {\n87\t        r = randombytes_random();\n88\t        if r >= min {\n89\t            break;\n90\t        }\n91\t    }\n92\t\n93\t    r % upper_bound\n94\t}\n95\t\n96\t#[unsafe(no_mangle)]\n97\tpub extern \"C\" fn randombytes_buf(buf: *mut c_void, size: usize) {\n98\t    randombytes_init_if_needed();\n99\t    if size > 0 {\n100\t        unsafe { (impl_ref().buf.unwrap())(buf, size) };\n101\t    }\n102\t}\n103\t\n104\t#[unsafe(no_mangle)]\n105\tpub unsafe extern \"C\" fn randombytes_buf_deterministic(\n106\t    buf: *mut c_void,\n107\t    size: usize,\n108\t    seed: *const u8,\n109\t) {\n110\t    static NONCE: [u8; 12] = [b'L', b'i', b'b', b's', b'o', b'd', b'i', b'u', b'm', b'D', b'R', b'G'];\n111\t\n112\t    // #if SIZE_MAX > 0x4000000000ULL  (true on 64-bit)\n113\t    if (size as u64) > 0x4000000000u64 {\n114\t        crate::sodium::core::sodium_misuse();\n115\t    }\n116\t    unsafe {\n117\t        crypto_stream_chacha20_ietf(buf as *mut u8, size as u64, NONCE.as_ptr(), seed)\n118\t    };\n119\t}\n120\t\n121\t#[unsafe(no_mangle)]\n122\tpub extern \"C\" fn randombytes_seedbytes() -> usize {\n123\t    RANDOMBYTES_SEEDBYTES\n124\t