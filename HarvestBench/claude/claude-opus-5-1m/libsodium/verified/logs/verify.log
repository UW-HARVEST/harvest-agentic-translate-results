               eq_bytes(&format!(\"chacha20 ref vtable xor_ic(len={len},ic={ic:#x})\"), &a, &b);","+            }","+            for &ic in &[0u32, 1, 0xffff_ffff, 0xffff_fffe] {","+                let mut o = [canary(len), canary(len)];","+                for (w, vt) in [c, r].into_iter().enumerate() {","+                    let f = unsafe { (*vt).stream_ietf_ext_xor_ic.unwrap() };","+                    unsafe {","+                        f(o[w].as_mut_ptr(), m.as_ptr(), len as u64, n16.as_ptr(), ic, k.as_ptr())","+                    };","+                }","+                let (a, b) = (o[0].clone(), o[1].clone());","+                eq_bytes(","+                    &format!(\"chacha20 ref vtable ietf_ext_xor_ic(len={len},ic={ic:#x})\"),","+                    &a,","+                    &b,","+                );","+            }","+        }","+    }","+","+    // ---- crypto_stream_salsa20_ref_implementation (2 slots) ----","+    #[repr(C)]","+    struct S20Vt {","+        stream: Option<unsafe extern \"C\" fn(*mut u8, u64, *const u8, *const u8) -> i32>,","+        stream_xor_ic:","+            Option<unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, u64, *const u8) -> i32>,","+    }","+    {","+        let c: *const S20Vt = sym(c_lib(), \"crypto_stream_salsa20_ref_implementation\");","+        let r: *const S20Vt = sym(r_lib(), \"crypto_stream_salsa20_ref_implementation\");","+        for &len in &[0usize, 1, 63, 64, 65, 128, 200, 1000] {","+            let k = rng.bytes(32);","+            let n = rng.bytes(8);","+            let m = rng.bytes(len);","+            let mut o = [canary(len), canary(len)];","+            for (w, vt) in [c, r].into_iter().enumerate() {","+                let f = unsafe { (*vt).stream.unwrap() };","+                unsafe { f(o[w].as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()) };","+            }","+            let (a, b) = (o[0].clone(), o[1].clone());","+            eq_bytes(&format!(\"salsa20 ref vtable stream(len