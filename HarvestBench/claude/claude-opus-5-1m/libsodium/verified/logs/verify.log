_reduce(h.as_mut_ptr());\n92\t\n93\t    _sodium_ge25519_double_scalarmult_vartime(&mut sb_ah_p2, h.as_ptr(), &A, sig.add(32));\n94\t    _sodium_ge25519_p2_to_p3(&mut sb_ah, &sb_ah_p2);\n95\t    _sodium_ge25519_p3_sub(&mut check, &expected_r, &sb_ah);\n96\t\n97\t    _sodium_ge25519_has_small_order(&check) - 1\n98\t}\n99\t\n100\t/// ```c\n101\t/// int\n102\t/// crypto_sign_ed25519_verify_detached(const unsigned char *sig,\n103\t///                                     const unsigned char *m,\n104\t///                                     unsigned long long   mlen,\n105\t///                                     const unsigned char *pk)\n106\t/// {\n107\t///     return _crypto_sign_ed25519_verify_detached(sig, m, mlen, pk, 0);\n108\t/// }\n109\t/// ```\n110\t#[unsafe(no_mangle)]\n111\tpub unsafe extern \"C\" fn crypto_sign_ed25519_verify_detached(\n112\t    sig: *const u8,\n113\t    m: *const u8,\n114\t    mlen: u64,\n115\t    pk: *const u8,\n116\t) -> c_int {\n117\t    _crypto_sign_ed25519_verify_detached(sig, m, mlen, pk, 0)\n118\t}\n119\t\n120\t/// ```c\n121\t/// int\n122\t/// crypto_sign_ed25519_open(unsigned char *m, unsigned long long *mlen_p,\n123\t///                          const unsigned char *sm, unsigned long long smlen,\n124\t///                          const unsigned char *pk)\n125\t/// {\n126\t///     unsigned long long mlen;\n127\t///\n128\t///     if (smlen < 64 || smlen - 64 > crypto_sign_ed25519_MESSAGEBYTES_MAX) {\n129\t///         goto badsig;\n130\t///     }\n131\t///     mlen = smlen - 64;\n132\t///     if (crypto_sign_ed25519_verify_detached(sm, sm + 64, mlen, pk) != 0) {\n133\t///         if (m != NULL) {\n134\t///             memset(m, 0, mlen);\n135\t///         }\n136\t///         goto badsig;\n137\t///     }\n138\t///     if (mlen_p != NULL) {\n139\t///         *mlen_p = mlen;\n140\t///     }\n141\t///     if (m != NULL) {\n142\t///         memmove(m, sm + 64, mlen);\n143\t///     }\n144\t///     return 0;\n145\t///\n146\t/// badsig:\n147\t//