oid)\n171\t{\n172\t    randombytes_init_if_needed();\n173\t    if (implementation->stir != NULL) {\n174\t        implementation->stir();\n175\t    }\n176\t}\n177\t\n178\tuint32_t\n179\trandombytes_uniform(const uint32_t upper_bound)\n180\t{\n181\t    uint32_t min;\n182\t    uint32_t r;\n183\t\n184\t    randombytes_init_if_needed();\n185\t    if (implementation->uniform != NULL) {\n186\t        return implementation->uniform(upper_bound);\n187\t    }\n188\t    if (upper_bound < 2) {\n189\t        return 0;\n190\t    }\n191\t    min = (1U + ~upper_bound) % upper_bound; /* = 2**32 mod upper_bound */\n192\t    do {\n193\t        r = randombytes_random();\n194\t    } while (r < min);\n195\t    /* r is now clamped to a set whose size mod upper_bound == 0\n196\t     * the worst case (2**31+1) requires ~ 2 attempts */\n197\t\n198\t    return r % upper_bound;\n199\t}\n200\t\n201\tvoid\n202\trandombytes_buf(void * const buf, const size_t size)\n203\t{\n204\t    randombytes_init_if_needed();\n205\t    if (size > (size_t) 0U) {\n206\t        implementation->buf(buf, size);\n207\t    }\n208\t}\n209\t\n210\tvoid\n211\trandombytes_buf_deterministic(void * const buf, const size_t size,\n212\t                              const unsigned char seed[randombytes_SEEDBYTES])\n213\t{\n214\t    static const unsigned char nonce[crypto_stream_chacha20_ietf_NONCEBYTES] = {\n215\t        'L', 'i', 'b', 's', 'o', 'd', 'i', 'u', 'm', 'D', 'R', 'G'\n216\t    };\n217\t\n218\t    COMPILER_ASSERT(randombytes_SEEDBYTES == crypto_stream_chacha20_ietf_KEYBYTES);\n219\t#if SIZE_MAX > 0x4000000000ULL\n220\t    COMPILER_ASSERT(randombytes_BYTES_MAX <= 0x4000000000ULL);\n221\t    if (size > 0x4000000000ULL) {\n222\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n223\t    }\n224\t#endif\n225\t    crypto_stream_chacha20_ietf((unsigned char *) buf, (unsigned long long) size,\n226\t                                nonce, seed);\n227\t}\n228\t\n229\tsize_t\n230\trandombytes_seedbytes(void)\n231\t{\n232\t    retur