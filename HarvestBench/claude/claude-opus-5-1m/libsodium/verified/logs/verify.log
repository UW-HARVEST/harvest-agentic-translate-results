{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_iny5y6k76vqhyx3z2fc3r7ubgcnkjniejeznbofturultnr4hmja","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_012rqLDPfpTtQAr9HEFFM7Vg","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-rAO86K/translated_rust/tests/t04_aead.rs","content":"//! Phase B — AEAD constructions (`CONFIGS.md` rows for the `crypto_aead_*`\n//! group): aegis128l, aegis256, chacha20poly1305 (original 8-byte nonce),\n//! chacha20poly1305_ietf, xchacha20poly1305_ietf, plus the aes256gcm\n//! entry points (unavailable in this build — every operation must reject\n//! identically in C and Rust).\n//!\n//! Both the *combined* and the *detached* entry points are exercised, with\n//! message/AD lengths that straddle each primitive's block, absorb and\n//! 128 KiB-chunk boundaries.\n\nmod common;\nuse common::*;\n\ntype Enc = unsafe extern \"C\" fn(\n    *mut u8,   // c\n    *mut u64,  // clen_p\n    *const u8, // m\n    u64,       // mlen\n    *const u8, // ad\n    u64,       // adlen\n    *const u8, // nsec\n    *const u8, // npub\n    *const u8, // k\n) -> i32;\n\ntype Dec = unsafe extern \"C\" fn(\n    *mut u8,   // m\n    *mut u64,  // mlen_p\n    *mut u8,   // nsec\n    *const u8, // c\n    u64,       // clen\n    *const u8, // ad\n    u64,       // adlen\n    *const u8, // npub\n    *const u8, // k\n) -> i32;\n\ntype EncDet = unsafe extern \"C\" fn(\n    *mut u8,   // c\n    *mut u8,   // mac\n    *mut u64,  // maclen_p\n    *const u8, // m\n    u64,       // mlen\n    *const u8, // ad\n    u64,       // adlen\n    *const u8, // nsec\n    *const u8, // npub\n    *const u8, // k\n) -> i32;\n\ntype DecDet = unsafe extern \"C\" fn(\n    *mut u8,   // m\n    *mut u8,   // nsec\n    *const u8, // c\n    u64,       // clen\n    *const u8, // mac\n    *const u8, // ad\n    u64,       // adlen\n    *const u8, // npub\n    *const u8, // k\n) -> i32;\n\ntype Keygen = unsafe extern \"C\" fn(*mut u8);\n\n/// The five *available* AEAD primitives.\nconst AEADS: &[&str] = &[\n    \"crypto_aead_aegis128l\",\n    \"crypto_aead_aegis256\",\n    \"crypto_aead_chacha20poly1305\",\n    \"crypto_aead_chacha20poly1305_ietf\",\n    \"crypto_aead_xchacha20poly1305_ietf\",\n];\n\nstruct Sizes {\n    kb: usize,\n    nb: usize,\n    ab: usize,\n    nsb: usize,\n    max: u64,\n}\n\nfn sizes(p: &str) -> Sizes {\n    let g = |s: &str| -> usize {\n        unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{p}_{s}\"))() }\n    };\n    let gm = || -> u64 {\n        unsafe { sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), &format!(\"{p}_messagebytes_max\"))() }\n    };\n    Sizes {\n        kb: g(\"keybytes\"),\n        nb: g(\"npubbytes\"),\n        ab: g(\"abytes\"),\n        nsb: g(\"nsecbytes\"),\n        max: gm(),\n    }\n}\n\n/// Message lengths: per-primitive block boundaries (16/32/64), poly1305 pad\n/// boundaries, and the 128 KiB `STREAM_POLY1305_CHUNK` restart boundary.\nconst MLENS: &[usize] = &[\n    0, 1, 2, 15, 16, 17, 31, 32, 33, 47, 48, 63, 64, 65, 95, 96, 127, 128, 129, 255, 256, 257, 511,\n    512, 1000, 4097,\n];\n/// AD lengths: absorb2 (2×RATE), absorb (RATE) and padded-tail shapes.\nconst ADLENS: &[usize] = &[0, 1, 8, 15, 16, 17, 31, 32, 33, 63, 64, 65, 100, 128, 200];\n/// Lengths around the 131072-byte chunk restart (slow — used sparingly).\nconst CHUNK_LENS: &[usize] = &[131071, 131072, 131073, 131136, 262144];\n\n// ---------------------------------------------------------------------------\n// combined encrypt / decrypt round trip over the message-length axis\n// ---------------------------------------------------------------------------\n\n#[test]\nfn aead_combined_message_lengths() {\n    setup();\n    let mut rng = Rng::new(0x8000);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for &mlen in MLENS {\n            for &adlen in &[0usize, 16, 100] {\n                let k = rng.bytes(s.kb);\n                let npub = rng.bytes(s.nb);\n                let m = rng.bytes(mlen);\n                let ad = rng.bytes(adlen);\n                let clen_max = mlen + s.ab;\n\n                let mut c1 = canary(clen_max);\n                let mut c2 = canary(clen_max);\n                let mut l1 = 0u64;\n                let mut l2 = 0u64;\n                let (ra, rb) = unsafe {\n                    (\n                        ce(\n                            c1.as_mut_ptr(),\n                            &mut l1,\n                            m.as_ptr(),\n                            mlen as u64,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            std::ptr::null(),\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                        re(\n                            c2.as_mut_ptr(),\n                            &mut l2,\n                            m.as_ptr(),\n                            mlen as u64,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            std::ptr::null(),\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                    )\n                };\n                eq_i32(&format!(\"{p}_encrypt rc(m={mlen},ad={adlen})\"), ra, rb);\n                eq_usize(\n                    &format!(\"{p}_encrypt *clen_p(m={mlen},ad={adlen})\"),\n                    l1 as usize,\n                    l2 as usize,\n                );\n                eq_bytes(&format!(\"{p}_encrypt(m={mlen},ad={adlen})\"), &c1, &c2);\n                assert_eq!(l1 as usize, clen_max);\n\n                // decrypt the C-produced ciphertext with both\n                let mut m1 = canary(mlen.max(1));\n                let mut m2 = canary(mlen.max(1));\n                let mut o1 = u64::MAX;\n                let mut o2 = u64::MAX;\n                let (ra, rb) = unsafe {\n                    (\n                        cd(\n                            m1.as_mut_ptr(),\n                            &mut o1,\n                            std::ptr::null_mut(),\n                            c1.as_ptr(),\n                            l1,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                        rd(\n                            m2.as_mut_ptr(),\n                            &mut o2,\n                            std::ptr::null_mut(),\n                            c1.as_ptr(),\n                            l1,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                    )\n                };\n                eq_i32(&format!(\"{p}_decrypt rc(m={mlen},ad={adlen})\"), ra, rb);\n                eq_usize(\n                    &format!(\"{p}_decrypt *mlen_p(m={mlen},ad={adlen})\"),\n                    o1 as usize,\n                    o2 as usize,\n                );\n                eq_bytes(&format!(\"{p}_decrypt(m={mlen},ad={adlen})\"), &m1, &m2);\n                assert_eq!(ra, 0, \"{p} round trip must succeed\");\n                assert_eq!(&m1[..mlen], &m[..], \"{p} round trip plaintext\");\n            }\n        }\n    }\n}\n\n#[test]\nfn aead_combined_ad_lengths() {\n    setup();\n    let mut rng = Rng::new(0x8001);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        for &adlen in ADLENS {\n            for &mlen in &[0usize, 1, 32, 64, 100] {\n                let k = rng.bytes(s.kb);\n                let npub = rng.bytes(s.nb);\n                let m = rng.bytes(mlen);\n                let ad = rng.bytes(adlen);\n                let mut c1 = canary(mlen + s.ab);\n                let mut c2 = canary(mlen + s.ab);\n                let (ra, rb) = unsafe {\n                    (\n                        ce(\n                            c1.as_mut_ptr(),\n                            std::ptr::null_mut(),\n                            m.as_ptr(),\n                            mlen as u64,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            std::ptr::null(),\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                        re(\n                            c2.as_mut_ptr(),\n                            std::ptr::null_mut(),\n                            m.as_ptr(),\n                            mlen as u64,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            std::ptr::null(),\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                    )\n                };\n                eq_i32(&format!(\"{p}_encrypt rc(ad={adlen})\"), ra, rb);\n                eq_bytes(&format!(\"{p}_encrypt(ad={adlen},m={mlen})\"), &c1, &c2);\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// detached API, and combined-vs-detached equivalence\n// ---------------------------------------------------------------------------\n\n#[test]\nfn aead_detached_and_equivalence() {\n    setup();\n    let mut rng = Rng::new(0x8002);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, _) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (ced, red) = pair::<EncDet>(&format!(\"{p}_encrypt_detached\"));\n        let (cdd, rdd) = pair::<DecDet>(&format!(\"{p}_decrypt_detached\"));\n        for &mlen in &[0usize, 1, 5, 15, 16, 17, 31, 32, 33, 63, 64, 65, 128, 1000, 4097] {\n            for &adlen in &[0usize, 1, 16, 17, 100] {\n                let k = rng.bytes(s.kb);\n                let npub = rng.bytes(s.nb);\n                let m = rng.bytes(mlen);\n                let ad = rng.bytes(adlen);\n\n                let mut c1 = canary(mlen.max(1));\n                let mut c2 = canary(mlen.max(1));\n                let mut t1 = canary(s.ab);\n                let mut t2 = canary(s.ab);\n                let mut ml1 = u64::MAX;\n                let mut ml2 = u64::MAX;\n                let (ra, rb) = unsafe {\n                    (\n                        ced(\n                            c1.as_mut_ptr(),\n                            t1.as_mut_ptr(),\n                            &mut ml1,\n                            m.as_ptr(),\n                            mlen as u64,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            std::ptr::null(),\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                        red(\n                            c2.as_mut_ptr(),\n                            t2.as_mut_ptr(),\n                            &mut ml2,\n                            m.as_ptr(),\n                            mlen as u64,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            std::ptr::null(),\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                    )\n                };\n                eq_i32(&format!(\"{p}_encrypt_detached rc(m={mlen},ad={adlen})\"), ra, rb);\n                eq_usize(&format!(\"{p}_encrypt_detached *maclen_p\"), ml1 as usize, ml2 as usize);\n                eq_bytes(&format!(\"{p}_encrypt_detached c(m={mlen},ad={adlen})\"), &c1, &c2);\n                eq_bytes(&format!(\"{p}_encrypt_detached mac(m={mlen},ad={adlen})\"), &t1, &t2);\n                assert_eq!(ml1 as usize, s.ab);\n\n                // combined output must equal detached c || mac\n                let mut comb = canary(mlen + s.ab);\n                unsafe {\n                    ce(\n                        comb.as_mut_ptr(),\n                        std::ptr::null_mut(),\n                        m.as_ptr(),\n                        mlen as u64,\n                        ad.as_ptr(),\n                        adlen as u64,\n                        std::ptr::null(),\n                        npub.as_ptr(),\n                        k.as_ptr(),\n                    );\n                }\n                eq_bytes(\n                    &format!(\"{p} combined==detached c(m={mlen},ad={adlen})\"),\n                    &comb[..mlen],\n                    &c1[..mlen],\n                );\n                eq_bytes(\n                    &format!(\"{p} combined==detached mac(m={mlen},ad={adlen})\"),\n                    &comb[mlen..],\n                    &t1,\n                );\n\n                // decrypt_detached\n                let mut p1 = canary(mlen.max(1));\n                let mut p2 = canary(mlen.max(1));\n                let (ra, rb) = unsafe {\n                    (\n                        cdd(\n                            p1.as_mut_ptr(),\n                            std::ptr::null_mut(),\n                            c1.as_ptr(),\n                            mlen as u64,\n                            t1.as_ptr(),\n                            ad.as_ptr(),\n                            adlen as u64,\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                        rdd(\n                            p2.as_mut_ptr(),\n                            std::ptr::null_mut(),\n                            c1.as_ptr(),\n                            mlen as u64,\n                            t1.as_ptr(),\n                            ad.as_ptr(),\n                            adlen as u64,\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                    )\n                };\n                eq_i32(&format!(\"{p}_decrypt_detached rc(m={mlen},ad={adlen})\"), ra, rb);\n                eq_bytes(&format!(\"{p}_decrypt_detached(m={mlen},ad={adlen})\"), &p1, &p2);\n                assert_eq!(ra, 0);\n                assert_eq!(&p1[..mlen], &m[..]);\n            }\n        }\n    }\n}\n\n/// `maclen_p == NULL` (encrypt_detached) and `clen_p`/`mlen_p == NULL`.\n#[test]\nfn aead_null_out_length_pointers() {\n    setup();\n    let mut rng = Rng::new(0x8003);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        let (ced, red) = pair::<EncDet>(&format!(\"{p}_encrypt_detached\"));\n        for &mlen in &[0usize, 1, 64, 100, 1000] {\n            let k = rng.bytes(s.kb);\n            let npub = rng.bytes(s.nb);\n            let m = rng.bytes(mlen);\n            let ad = rng.bytes(16);\n\n            // clen_p == NULL\n            let mut c1 = canary(mlen + s.ab);\n            let mut c2 = canary(mlen + s.ab);\n            unsafe {\n                let a = ce(\n                    c1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    ad.as_ptr(),\n                    16,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = re(\n                    c2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    ad.as_ptr(),\n                    16,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_encrypt clen_p=NULL rc\"), a, b);\n            }\n            eq_bytes(&format!(\"{p}_encrypt clen_p=NULL(m={mlen})\"), &c1, &c2);\n\n            // mlen_p == NULL on decrypt\n            let mut m1 = canary(mlen.max(1));\n            let mut m2 = canary(mlen.max(1));\n            unsafe {\n                let a = cd(\n                    m1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    ad.as_ptr(),\n                    16,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = rd(\n                    m2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    ad.as_ptr(),\n                    16,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_decrypt mlen_p=NULL rc\"), a, b);\n                assert_eq!(a, 0);\n            }\n            eq_bytes(&format!(\"{p}_decrypt mlen_p=NULL(m={mlen})\"), &m1, &m2);\n\n            // maclen_p == NULL on encrypt_detached\n            let mut d1 = canary(mlen.max(1));\n            let mut d2 = canary(mlen.max(1));\n            let mut t1 = canary(s.ab);\n            let mut t2 = canary(s.ab);\n            unsafe {\n                let a = ced(\n                    d1.as_mut_ptr(),\n                    t1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    ad.as_ptr(),\n                    16,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = red(\n                    d2.as_mut_ptr(),\n                    t2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    ad.as_ptr(),\n                    16,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_encrypt_detached maclen_p=NULL rc\"), a, b);\n            }\n            eq_bytes(&format!(\"{p} det maclen_p=NULL c\"), &d1, &d2);\n            eq_bytes(&format!(\"{p} det maclen_p=NULL mac\"), &t1, &t2);\n        }\n    }\n}\n\n/// `m == NULL` on decrypt (verify-only mode) and `ad == NULL` with `adlen == 0`,\n/// `m == NULL` with `mlen == 0` on encrypt, non-NULL `nsec` (must be ignored).\n#[test]\nfn aead_null_pointer_valid_shapes() {\n    setup();\n    let mut rng = Rng::new(0x8004);\n    for &p in AEADS {\n        let s = sizes(p);\n        assert_eq!(s.nsb, 0, \"{p}_nsecbytes must be 0\");\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for &mlen in &[0usize, 1, 64, 1000] {\n            let k = rng.bytes(s.kb);\n            let npub = rng.bytes(s.nb);\n            let m = rng.bytes(mlen);\n            let mut c1 = canary(mlen + s.ab);\n            let mut c2 = canary(mlen + s.ab);\n\n            // ad = NULL, adlen = 0\n            unsafe {\n                let a = ce(\n                    c1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    if mlen == 0 { std::ptr::null() } else { m.as_ptr() },\n                    mlen as u64,\n                    std::ptr::null(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = re(\n                    c2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    if mlen == 0 { std::ptr::null() } else { m.as_ptr() },\n                    mlen as u64,\n                    std::ptr::null(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_encrypt ad=NULL rc\"), a, b);\n            }\n            eq_bytes(&format!(\"{p}_encrypt ad=NULL,m={mlen}\"), &c1, &c2);\n\n            // ad = NULL, adlen = 0 must equal a non-NULL ad with adlen = 0\n            let ad0 = [0u8; 4];\n            let mut c3 = canary(mlen + s.ab);\n            unsafe {\n                ce(\n                    c3.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    if mlen == 0 { std::ptr::null() } else { m.as_ptr() },\n                    mlen as u64,\n                    ad0.as_ptr(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n            }\n            eq_bytes(&format!(\"{p} ad=NULL == ad!=NULL,adlen=0\"), &c1, &c3);\n\n            // decrypt with m = NULL (verify only)\n            let mut o1 = u64::MAX;\n            let mut o2 = u64::MAX;\n            unsafe {\n                let a = cd(\n                    std::ptr::null_mut(),\n                    &mut o1,\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = rd(\n                    std::ptr::null_mut(),\n                    &mut o2,\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_decrypt m=NULL rc(m={mlen})\"), a, b);\n                assert_eq!(a, 0, \"{p} verify-only must succeed\");\n            }\n            eq_usize(&format!(\"{p}_decrypt m=NULL *mlen_p\"), o1 as usize, o2 as usize);\n\n            // non-NULL nsec must be ignored and left untouched\n            let mut ns1 = [0xA5u8; 8];\n            let mut ns2 = [0xA5u8; 8];\n            let mut m1 = canary(mlen.max(1));\n            let mut m2 = canary(mlen.max(1));\n            unsafe {\n                let a = cd(\n                    m1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    ns1.as_mut_ptr(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = rd(\n                    m2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    ns2.as_mut_ptr(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_decrypt nsec!=NULL rc\"), a, b);\n            }\n            eq_bytes(&format!(\"{p} nsec buffer untouched\"), &ns1, &ns2);\n            assert_eq!(ns1, [0xA5u8; 8], \"{p} must not write to nsec\");\n            eq_bytes(&format!(\"{p}_decrypt nsec!=NULL plaintext\"), &m1, &m2);\n        }\n    }\n}\n\n/// In-place operation (`c == m`).\n#[test]\nfn aead_in_place() {\n    setup();\n    let mut rng = Rng::new(0x8005);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for &mlen in &[0usize, 1, 16, 17, 32, 33, 64, 65, 1000] {\n            let k = rng.bytes(s.kb);\n            let npub = rng.bytes(s.nb);\n            let m = rng.bytes(mlen);\n            let ad = rng.bytes(16);\n\n            let mut b1 = canary(mlen + s.ab);\n            let mut b2 = canary(mlen + s.ab);\n            b1[..mlen].copy_from_slice(&m);\n            b2[..mlen].copy_from_slice(&m);\n            unsafe {\n                let a = ce(\n                    b1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    b1.as_ptr(),\n                    mlen as u64,\n                    ad.as_ptr(),\n                    16,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = re(\n                    b2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    b2.as_ptr(),\n                    mlen as u64,\n                    ad.as_ptr(),\n                    16,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_encrypt in-place rc\"), a, b);\n            }\n            eq_bytes(&format!(\"{p}_encrypt in-place(m={mlen})\"), &b1, &b2);\n\n            // decrypt in place\n            let mut d1 = b1.clone();\n            let mut d2 = b1.clone();\n            unsafe {\n                let a = cd(\n                    d1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    d1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    ad.as_ptr(),\n                    16,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = rd(\n                    d2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    d2.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    ad.as_ptr(),\n                    16,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_decrypt in-place rc\"), a, b);\n                assert_eq!(a, 0);\n            }\n            eq_bytes(&format!(\"{p}_decrypt in-place(m={mlen})\"), &d1, &d2);\n            assert_eq!(&d1[..mlen], &m[..]);\n        }\n    }\n}\n\n/// Degenerate / extreme key and nonce shapes.\n#[test]\nfn aead_key_nonce_shapes() {\n    setup();\n    let mut rng = Rng::new(0x8006);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let mlen = 64usize;\n        let adlen = 16usize;\n        let m = rng.bytes(mlen);\n        let ad = rng.bytes(adlen);\n        let keys: Vec<Vec<u8>> = vec![vec![0u8; s.kb], vec![0xffu8; s.kb], rng.bytes(s.kb)];\n        let mut nonces: Vec<Vec<u8>> = vec![vec![0u8; s.nb], vec![0xffu8; s.nb], rng.bytes(s.nb)];\n        // For xchacha20: nonces differing only in the first / second half hit\n        // structurally different dependencies (hchacha20 subkey vs npub2).\n        if s.nb == 24 {\n            let base = rng.bytes(24);\n            let mut a = base.clone();\n            a[3] ^= 0xff; // first half only\n            let mut b = base.clone();\n            b[20] ^= 0xff; // second half only\n            nonces.push(base);\n            nonces.push(a);\n            nonces.push(b);\n        }\n        for k in &keys {\n            for n in &nonces {\n                let mut c1 = canary(mlen + s.ab);\n                let mut c2 = canary(mlen + s.ab);\n                unsafe {\n                    let a = ce(\n                        c1.as_mut_ptr(),\n                        std::ptr::null_mut(),\n                        m.as_ptr(),\n                        mlen as u64,\n                        ad.as_ptr(),\n                        adlen as u64,\n                        std::ptr::null(),\n                        n.as_ptr(),\n                        k.as_ptr(),\n                    );\n                    let b = re(\n                        c2.as_mut_ptr(),\n                        std::ptr::null_mut(),\n                        m.as_ptr(),\n                        mlen as u64,\n                        ad.as_ptr(),\n                        adlen as u64,\n                        std::ptr::null(),\n                        n.as_ptr(),\n                        k.as_ptr(),\n                    );\n                    eq_i32(&format!(\"{p} key/nonce shape rc\"), a, b);\n                }\n                eq_bytes(\n                    &format!(\"{p}(k={}, n={})\", hex(k), hex(n)),\n                    &c1,\n                    &c2,\n                );\n            }\n        }\n    }\n}\n\n/// The 128 KiB `STREAM_POLY1305_CHUNK` restart boundary of the three\n/// poly1305-based AEADs (and the same lengths for AEGIS as a control).\n#[test]\nfn aead_chunk_boundary_lengths() {\n    setup();\n    let mut rng = Rng::new(0x8007);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for &mlen in CHUNK_LENS {\n            let k = rng.bytes(s.kb);\n            let npub = rng.bytes(s.nb);\n            let m = rng.bytes(mlen);\n            let mut c1 = vec![0xA5u8; mlen + s.ab];\n            let mut c2 = vec![0xA5u8; mlen + s.ab];\n            unsafe {\n                let a = ce(\n                    c1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    std::ptr::null(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = re(\n                    c2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    std::ptr::null(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_encrypt chunk rc(m={mlen})\"), a, b);\n            }\n            eq_bytes(&format!(\"{p}_encrypt chunk(m={mlen})\"), &c1, &c2);\n\n            // decrypt (single un-chunked pass in C) must agree with encrypt\n            let mut d1 = vec![0xA5u8; mlen];\n            let mut d2 = vec![0xA5u8; mlen];\n            unsafe {\n                let a = cd(\n                    d1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = rd(\n                    d2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_decrypt chunk rc(m={mlen})\"), a, b);\n                assert_eq!(a, 0, \"{p} chunk round-trip\");\n            }\n            eq_bytes(&format!(\"{p}_decrypt chunk(m={mlen})\"), &d1, &d2);\n            assert_eq!(d1, m);\n        }\n    }\n}\n\n/// AEGIS detached mode accepts `clen < ABYTES` (no gate) — a valid config.\n#[test]\nfn aegis_detached_short_clen() {\n    setup();\n    let mut rng = Rng::new(0x8008);\n    for &p in &[\"crypto_aead_aegis128l\", \"crypto_aead_aegis256\"] {\n        let s = sizes(p);\n        assert_eq!(s.ab, 32);\n        let (ced, red) = pair::<EncDet>(&format!(\"{p}_encrypt_detached\"));\n        let (cdd, rdd) = pair::<DecDet>(&format!(\"{p}_decrypt_detached\"));\n        for &mlen in &[0usize, 1, 5, 31] {\n            let k = rng.bytes(s.kb);\n            let npub = rng.bytes(s.nb);\n            let m = rng.bytes(mlen);\n            let mut c1 = canary(mlen.max(1));\n            let mut c2 = canary(mlen.max(1));\n            let mut t1 = canary(s.ab);\n            let mut t2 = canary(s.ab);\n            unsafe {\n                let a = ced(\n                    c1.as_mut_ptr(),\n                    t1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    std::ptr::null(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = red(\n                    c2.as_mut_ptr(),\n                    t2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    std::ptr::null(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(\"aegis det short rc\", a, b);\n            }\n            eq_bytes(&format!(\"{p} det short c(m={mlen})\"), &c1, &c2);\n            eq_bytes(&format!(\"{p} det short mac(m={mlen})\"), &t1, &t2);\n\n            let mut p1 = canary(mlen.max(1));\n            let mut p2 = canary(mlen.max(1));\n            unsafe {\n                let a = cdd(\n                    p1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    mlen as u64,\n                    t1.as_ptr(),\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = rdd(\n                    p2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    mlen as u64,\n                    t1.as_ptr(),\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(\"aegis det short decrypt rc\", a, b);\n                assert_eq!(a, 0);\n            }\n            eq_bytes(&format!(\"{p} det short decrypt(m={mlen})\"), &p1, &p2);\n        }\n    }\n}\n\n/// Cross-variant wiring: xchacha20poly1305_ietf(k, npub24) must equal\n/// chacha20poly1305_ietf(hchacha20(npub[0..16], k), 0000||npub[16..24]).\n#[test]\nfn xchacha_equals_chacha_ietf_with_derived_subkey() {\n    setup();\n    let mut rng = Rng::new(0x8009);\n    let (cx, _) = pair::<Enc>(\"crypto_aead_xchacha20poly1305_ietf_encrypt\");\n    let (ci, _) = pair::<Enc>(\"crypto_aead_chacha20poly1305_ietf_encrypt\");\n    // use the *Rust* library for both halves of the identity too\n    let (_, rx) = pair::<Enc>(\"crypto_aead_xchacha20poly1305_ietf_encrypt\");\n    let (_, ri) = pair::<Enc>(\"crypto_aead_chacha20poly1305_ietf_encrypt\");\n    let hchacha =\n        pair::<unsafe extern \"C\" fn(*mut u8, *const u8, *const u8, *const u8) -> i32>(\n            \"crypto_core_hchacha20\",\n        );\n    for &mlen in &[0usize, 1, 64, 65, 1000] {\n        for &adlen in &[0usize, 16, 17] {\n            let k = rng.bytes(32);\n            let npub = rng.bytes(24);\n            let m = rng.bytes(mlen);\n            let ad = rng.bytes(adlen);\n            for (which, (xf, inf, hc)) in [(cx, ci, hchacha.0), (rx, ri, hchacha.1)]\n                .into_iter()\n                .enumerate()\n            {\n                let mut k2 = [0u8; 32];\n                unsafe {\n                    hc(\n                        k2.as_mut_ptr(),\n                        npub.as_ptr(),\n                        k.as_ptr(),\n                        std::ptr::null(),\n                    )\n                };\n                let mut npub2 = [0u8; 12];\n                npub2[4..].copy_from_slice(&npub[16..24]);\n\n                let mut a = canary(mlen + 16);\n                let mut b = canary(mlen + 16);\n                unsafe {\n                    xf(\n                        a.as_mut_ptr(),\n                        std::ptr::null_mut(),\n                        m.as_ptr(),\n                        mlen as u64,\n                        ad.as_ptr(),\n                        adlen as u64,\n                        std::ptr::null(),\n                        npub.as_ptr(),\n                        k.as_ptr(),\n                    );\n                    inf(\n                        b.as_mut_ptr(),\n                        std::ptr::null_mut(),\n                        m.as_ptr(),\n                        mlen as u64,\n                        ad.as_ptr(),\n                        adlen as u64,\n                        std::ptr::null(),\n                        npub2.as_ptr(),\n                        k2.as_ptr(),\n                    );\n                }\n                eq_bytes(\n                    &format!(\"xchacha==chacha_ietf (lib={which}, m={mlen}, ad={adlen})\"),\n                    &a,\n                    &b,\n                );\n            }\n        }\n    }\n}\n\n/// Every AEAD `_keygen` is deterministic under the installed RNG.\n#[test]\nfn aead_keygens() {\n    setup();\n    let mut names: Vec<String> = AEADS.iter().map(|p| format!(\"{p}_keygen\")).collect();\n    names.push(\"crypto_aead_aes256gcm_keygen\".into());\n    for name in &names {\n        let p = name.trim_end_matches(\"_keygen\");\n        let kb = unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{p}_keybytes\"))() };\n        let (c, r) = pair::<Keygen>(name);\n        for seed in 0..8u64 {\n            let mut a = canary(kb + 8);\n            let mut b = canary(kb + 8);\n            reset_rngs(0xD000 + seed);\n            unsafe { c(a.as_mut_ptr()) };\n            reset_rngs(0xD000 + seed);\n            unsafe { r(b.as_mut_ptr()) };\n            eq_bytes(&format!(\"{name} seed={seed}\"), &a, &b);\n            assert_eq!(&a[kb..], &[0xA5u8; 8], \"{name} wrote past keybytes\");\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// aes256gcm — unavailable in this build. Every operation must reject the same\n// way in C and Rust (errno included).\n// ---------------------------------------------------------------------------\n\ntype Beforenm = unsafe extern \"C\" fn(*mut u8, *const u8) -> i32;\ntype EncAfternm = unsafe extern \"C\" fn(\n    *mut u8,\n    *mut u64,\n    *const u8,\n    u64,\n    *const u8,\n    u64,\n    *const u8,\n    *const u8,\n    *const u8,\n) -> i32;\n\n#[test]\nfn aes256gcm_is_unavailable_identically() {\n    setup();\n    let mut rng = Rng::new(0x800A);\n    let (cav, rav) = pair::<unsafe extern \"C\" fn() -> i32>(\"crypto_aead_aes256gcm_is_available\");\n    let (a, b) = unsafe { (cav(), rav()) };\n    eq_i32(\"crypto_aead_aes256gcm_is_available\", a, b);\n    assert_eq!(a, 0, \"this build must not have AES-NI AES-GCM\");\n\n    let s = sizes(\"crypto_aead_aes256gcm\");\n    assert_eq!((s.kb, s.nb, s.ab, s.nsb), (32, 12, 16, 0));\n\n    let statebytes = unsafe {\n        sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), \"crypto_aead_aes256gcm_statebytes\")()\n    };\n    assert_eq!(statebytes, 512);\n\n    let (ce, re) = pair::<Enc>(\"crypto_aead_aes256gcm_encrypt\");\n    let (cd, rd) = pair::<Dec>(\"crypto_aead_aes256gcm_decrypt\");\n    let (ced, red) = pair::<EncDet>(\"crypto_aead_aes256gcm_encrypt_detached\");\n    let (cdd, rdd) = pair::<DecDet>(\"crypto_aead_aes256gcm_decrypt_detached\");\n    let (cbn, rbn) = pair::<Beforenm>(\"crypto_aead_aes256gcm_beforenm\");\n\n    for &mlen in &[0usize, 16, 17, 100] {\n        for &adlen in &[0usize, 16, 100] {\n            let k = rng.bytes(32);\n            let npub = rng.bytes(12);\n            let m = rng.bytes(mlen);\n            let ad = rng.bytes(adlen);\n\n            for null_len in [false, true] {\n                let mut c1 = canary(mlen + 16);\n                let mut c2 = canary(mlen + 16);\n                let mut l1 = 0xDEAD_BEEFu64;\n                let mut l2 = 0xDEAD_BEEFu64;\n                let lp1 = if null_len { std::ptr::null_mut() } else { &raw mut l1 };\n                let lp2 = if null_len { std::ptr::null_mut() } else { &raw mut l2 };\n                unsafe {\n                    let a = ce(\n                        c1.as_mut_ptr(), lp1, m.as_ptr(), mlen as u64,\n                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n                        npub.as_ptr(), k.as_ptr(),\n                    );\n                    let b = re(\n                        c2.as_mut_ptr(), lp2, m.as_ptr(), mlen as u64,\n                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n                        npub.as_ptr(), k.as_ptr(),\n                    );\n                    eq_i32(\"aes256gcm_encrypt rc\", a, b);\n                    assert_eq!(a, -1);\n                }\n                eq_bytes(\"aes256gcm_encrypt out untouched\", &c1, &c2);\n                assert_eq!(c1, canary(mlen + 16));\n                eq_usize(\"aes256gcm_encrypt *clen_p untouched\", l1 as usize, l2 as usize);\n\n                let mut m1 = canary(mlen.max(1));\n                let mut m2 = canary(mlen.max(1));\n                let mut o1 = 0xDEAD_BEEFu64;\n                let mut o2 = 0xDEAD_BEEFu64;\n                let op1 = if null_len { std::ptr::null_mut() } else { &raw mut o1 };\n                let op2 = if null_len { std::ptr::null_mut() } else { &raw mut o2 };\n                unsafe {\n                    let a = cd(\n                        m1.as_mut_ptr(), op1, std::ptr::null_mut(), c1.as_ptr(),\n                        (mlen + 16) as u64, ad.as_ptr(), adlen as u64,\n                        npub.as_ptr(), k.as_ptr(),\n                    );\n                    let b = rd(\n                        m2.as_mut_ptr(), op2, std::ptr::null_mut(), c1.as_ptr(),\n                        (mlen + 16) as u64, ad.as_ptr(), adlen as u64,\n                        npub.as_ptr(), k.as_ptr(),\n                    );\n                    eq_i32(\"aes256gcm_decrypt rc\", a, b);\n                    assert_eq!(a, -1);\n                }\n                eq_bytes(\"aes256gcm_decrypt out untouched\", &m1, &m2);\n                eq_usize(\"aes256gcm_decrypt *mlen_p untouched\", o1 as usize, o2 as usize);\n\n                // detached\n                let mut d1 = canary(mlen.max(1));\n                let mut d2 = canary(mlen.max(1));\n                let mut t1 = canary(16);\n                let mut t2 = canary(16);\n                let mut ml1 = 0xDEAD_BEEFu64;\n                let mut ml2 = 0xDEAD_BEEFu64;\n                let mp1 = if null_len { std::ptr::null_mut() } else { &raw mut ml1 };\n                let mp2 = if null_len { std::ptr::null_mut() } else { &raw mut ml2 };\n                unsafe {\n                    let a = ced(\n                        d1.as_mut_ptr(), t1.as_mut_ptr(), mp1, m.as_ptr(), mlen as u64,\n                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n                        npub.as_ptr(), k.as_ptr(),\n                    );\n                    let b = red(\n                        d2.as_mut_ptr(), t2.as_mut_ptr(), mp2, m.as_ptr(), mlen as u64,\n                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n                        npub.as_ptr(), k.as_ptr(),\n                    );\n                    eq_i32(\"aes256gcm_encrypt_detached rc\", a, b);\n                    assert_eq!(a, -1);\n                }\n                eq_bytes(\"aes256gcm det c untouched\", &d1, &d2);\n                eq_bytes(\"aes256gcm det mac untouched\", &t1, &t2);\n                eq_usize(\"aes256gcm det *maclen_p\", ml1 as usize, ml2 as usize);\n\n                let mut p1 = canary(mlen.max(1));\n                let mut p2 = canary(mlen.max(1));\n                let mac = rng.bytes(16);\n                unsafe {\n                    let a = cdd(\n                        p1.as_mut_ptr(), std::ptr::null_mut(), d1.as_ptr(), mlen as u64,\n                        mac.as_ptr(), ad.as_ptr(), adlen as u64, npub.as_ptr(), k.as_ptr(),\n                    );\n                    let b = rdd(\n                        p2.as_mut_ptr(), std::ptr::null_mut(), d1.as_ptr(), mlen as u64,\n                        mac.as_ptr(), ad.as_ptr(), adlen as u64, npub.as_ptr(), k.as_ptr(),\n                    );\n                    eq_i32(\"aes256gcm_decrypt_detached rc\", a, b);\n                    assert_eq!(a, -1);\n                }\n                eq_bytes(\"aes256gcm det decrypt out untouched\", &p1, &p2);\n\n                // m == NULL on decrypt_detached\n                unsafe {\n                    let a = cdd(\n                        std::ptr::null_mut(), std::ptr::null_mut(), d1.as_ptr(), mlen as u64,\n                        mac.as_ptr(), ad.as_ptr(), adlen as u64, npub.as_ptr(), k.as_ptr(),\n                    );\n                    let b = rdd(\n                        std::ptr::null_mut(), std::ptr::null_mut(), d1.as_ptr(), mlen as u64,\n                        mac.as_ptr(), ad.as_ptr(), adlen as u64, npub.as_ptr(), k.as_ptr(),\n                    );\n                    eq_i32(\"aes256gcm_decrypt_detached m=NULL rc\", a, b);\n                }\n            }\n        }\n    }\n\n    // beforenm\n    let k = rng.bytes(32);\n    let mut st1 = State::new(statebytes);\n    let mut st2 = State::new(statebytes);\n    unsafe {\n        let a = cbn(st1.as_mut_ptr(), k.as_ptr());\n        let b = rbn(st2.as_mut_ptr(), k.as_ptr());\n        eq_i32(\"aes256gcm_beforenm rc\", a, b);\n        assert_eq!(a, -1);\n    }\n    eq_bytes(\"aes256gcm_beforenm state untouched\", st1.bytes(), st2.bytes());\n\n    // *_afternm forms\n    for name in [\n        \"crypto_aead_aes256gcm_encrypt_afternm\",\n        \"crypto_aead_aes256gcm_decrypt_afternm\",\n        \"crypto_aead_aes256gcm_encrypt_detached_afternm\",\n        \"crypto_aead_aes256gcm_decrypt_detached_afternm\",\n    ] {\n        let (c, r) = pair::<EncAfternm>(name);\n        for &mlen in &[0usize, 16, 100] {\n            for &adlen in &[0usize, 16] {\n                let m = rng.bytes(mlen);\n                let ad = rng.bytes(adlen);\n                let npub = rng.bytes(12);\n                let mut out1 = canary(mlen + 32);\n                let mut out2 = canary(mlen + 32);\n                let mut l1 = 0xDEADu64;\n                let mut l2 = 0xDEADu64;\n                unsafe {\n                    let a = c(\n                        out1.as_mut_ptr(), &mut l1, m.as_ptr(), mlen as u64,\n                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n                        npub.as_ptr(), st1.as_ptr(),\n                    );\n                    let b = r(\n                        out2.as_mut_ptr(), &mut l2, m.as_ptr(), mlen as u64,\n                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n                        npub.as_ptr(), st2.as_ptr(),\n                    );\n                    eq_i32(&format!(\"{name} rc\"), a, b);\n                    assert_eq!(a, -1, \"{name} must be unavailable\");\n                }\n                eq_bytes(&format!(\"{name} out untouched\"), &out1, &out2);\n                eq_usize(&format!(\"{name} *len untouched\"), l1 as usize, l2 as usize);\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3911,"cache_read_input_tokens":171933,"cache_creation":{"ephemeral_5m_input_tokens":3911,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"d0bdd0b2-418a-44df-87e9-ba3384a5f013","timestamp":"2026-08-23T08:19:41.127Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012rqLDPfpTtQAr9HEFFM7Vg","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-rAO86K/translated_rust/tests/t04_aead.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"db183c36-11e9-4c86-8611-a675461ee794","timestamp":"2026-08-23T08:19:41.144Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-rAO86K/translated_rust/tests/t04_aead.rs","content":"//! Phase B — AEAD constructions (`CONFIGS.md` rows for the `crypto_aead_*`\n//! group): aegis128l, aegis256, chacha20poly1305 (original 8-byte nonce),\n//! chacha20poly1305_ietf, xchacha20poly1305_ietf, plus the aes256gcm\n//! entry points (unavailable in this build — every operation must reject\n//! identically in C and Rust).\n//!\n//! Both the *combined* and the *detached* entry points are exercised, with\n//! message/AD lengths that straddle each primitive's block, absorb and\n//! 128 KiB-chunk boundaries.\n\nmod common;\nuse common::*;\n\ntype Enc = unsafe extern \"C\" fn(\n    *mut u8,   // c\n    *mut u64,  // clen_p\n    *const u8, // m\n    u64,       // mlen\n    *const u8, // ad\n    u64,       // adlen\n    *const u8, // nsec\n    *const u8, // npub\n    *const u8, // k\n) -> i32;\n\ntype Dec = unsafe extern \"C\" fn(\n    *mut u8,   // m\n    *mut u64,  // mlen_p\n    *mut u8,   // nsec\n    *const u8, // c\n    u64,       // clen\n    *const u8, // ad\n    u64,       // adlen\n    *const u8, // npub\n    *const u8, // k\n) -> i32;\n\ntype EncDet = unsafe extern \"C\" fn(\n    *mut u8,   // c\n    *mut u8,   // mac\n    *mut u64,  // maclen_p\n    *const u8, // m\n    u64,       // mlen\n    *const u8, // ad\n    u64,       // adlen\n    *const u8, // nsec\n    *const u8, // npub\n    *const u8, // k\n) -> i32;\n\ntype DecDet = unsafe extern \"C\" fn(\n    *mut u8,   // m\n    *mut u8,   // nsec\n    *const u8, // c\n    u64,       // clen\n    *const u8, // mac\n    *const u8, // ad\n    u64,       // adlen\n    *const u8, // npub\n    *const u8, // k\n) -> i32;\n\ntype Keygen = unsafe extern \"C\" fn(*mut u8);\n\n/// The five *available* AEAD primitives.\nconst AEADS: &[&str] = &[\n    \"crypto_aead_aegis128l\",\n    \"crypto_aead_aegis256\",\n    \"crypto_aead_chacha20poly1305\",\n    \"crypto_aead_chacha20poly1305_ietf\",\n    \"crypto_aead_xchacha20poly1305_ietf\",\n];\n\nstruct Sizes {\n    kb: usize,\n    nb: usize,\n    ab: usize,\n    nsb: usize,\n    max: u64,\n}\n\nfn sizes(p: &str) -> Sizes {\n    let g = |s: &str| -> usize {\n        unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{p}_{s}\"))() }\n    };\n    let gm = || -> u64 {\n        unsafe { sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), &format!(\"{p}_messagebytes_max\"))() }\n    };\n    Sizes {\n        kb: g(\"keybytes\"),\n        nb: g(\"npubbytes\"),\n        ab: g(\"abytes\"),\n        nsb: g(\"nsecbytes\"),\n        max: gm(),\n    }\n}\n\n/// Message lengths: per-primitive block boundaries (16/32/64), poly1305 pad\n/// boundaries, and the 128 KiB `STREAM_POLY1305_CHUNK` restart boundary.\nconst MLENS: &[usize] = &[\n    0, 1, 2, 15, 16, 17, 31, 32, 33, 47, 48, 63, 64, 65, 95, 96, 127, 128, 129, 255, 256, 257, 511,\n    512, 1000, 4097,\n];\n/// AD lengths: absorb2 (2×RATE), absorb (RATE) and padded-tail shapes.\nconst ADLENS: &[usize] = &[0, 1, 8, 15, 16, 17, 31, 32, 33, 63, 64, 65, 100, 128, 200];\n/// Lengths around the 131072-byte chunk restart (slow — used sparingly).\nconst CHUNK_LENS: &[usize] = &[131071, 131072, 131073, 131136, 262144];\n\n// ---------------------------------------------------------------------------\n// combined encrypt / decrypt round trip over the message-length axis\n// ---------------------------------------------------------------------------\n\n#[test]\nfn aead_combined_message_lengths() {\n    setup();\n    let mut rng = Rng::new(0x8000);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for &mlen in MLENS {\n            for &adlen in &[0usize, 16, 100] {\n                let k = rng.bytes(s.kb);\n                let npub = rng.bytes(s.nb);\n                let m = rng.bytes(mlen);\n                let ad = rng.bytes(adlen);\n                let clen_max = mlen + s.ab;\n\n                let mut c1 = canary(clen_max);\n                let mut c2 = canary(clen_max);\n                let mut l1 = 0u64;\n                let mut l2 = 0u64;\n                let (ra, rb) = unsafe {\n                    (\n                        ce(\n                            c1.as_mut_ptr(),\n                            &mut l1,\n                            m.as_ptr(),\n                            mlen as u64,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            std::ptr::null(),\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                        re(\n                            c2.as_mut_ptr(),\n                            &mut l2,\n                            m.as_ptr(),\n                            mlen as u64,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            std::ptr::null(),\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                    )\n                };\n                eq_i32(&format!(\"{p}_encrypt rc(m={mlen},ad={adlen})\"), ra, rb);\n                eq_usize(\n                    &format!(\"{p}_encrypt *clen_p(m={mlen},ad={adlen})\"),\n                    l1 as usize,\n                    l2 as usize,\n                );\n                eq_bytes(&format!(\"{p}_encrypt(m={mlen},ad={adlen})\"), &c1, &c2);\n                assert_eq!(l1 as usize, clen_max);\n\n                // decrypt the C-produced ciphertext with both\n                let mut m1 = canary(mlen.max(1));\n                let mut m2 = canary(mlen.max(1));\n                let mut o1 = u64::MAX;\n                let mut o2 = u64::MAX;\n                let (ra, rb) = unsafe {\n                    (\n                        cd(\n                            m1.as_mut_ptr(),\n                            &mut o1,\n                            std::ptr::null_mut(),\n                            c1.as_ptr(),\n                            l1,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                        rd(\n                            m2.as_mut_ptr(),\n                            &mut o2,\n                            std::ptr::null_mut(),\n                            c1.as_ptr(),\n                            l1,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                    )\n                };\n                eq_i32(&format!(\"{p}_decrypt rc(m={mlen},ad={adlen})\"), ra, rb);\n                eq_usize(\n                    &format!(\"{p}_decrypt *mlen_p(m={mlen},ad={adlen})\"),\n                    o1 as usize,\n                    o2 as usize,\n                );\n                eq_bytes(&format!(\"{p}_decrypt(m={mlen},ad={adlen})\"), &m1, &m2);\n                assert_eq!(ra, 0, \"{p} round trip must succeed\");\n                assert_eq!(&m1[..mlen], &m[..], \"{p} round trip plaintext\");\n            }\n        }\n    }\n}\n\n#[test]\nfn aead_combined_ad_lengths() {\n    setup();\n    let mut rng = Rng::new(0x8001);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        for &adlen in ADLENS {\n            for &mlen in &[0usize, 1, 32, 64, 100] {\n                let k = rng.bytes(s.kb);\n                let npub = rng.bytes(s.nb);\n                let m = rng.bytes(mlen);\n                let ad = rng.bytes(adlen);\n                let mut c1 = canary(mlen + s.ab);\n                let mut c2 = canary(mlen + s.ab);\n                let (ra, rb) = unsafe {\n                    (\n                        ce(\n                            c1.as_mut_ptr(),\n                            std::ptr::null_mut(),\n                            m.as_ptr(),\n                            mlen as u64,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            std::ptr::null(),\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                        re(\n                            c2.as_mut_ptr(),\n                            std::ptr::null_mut(),\n                            m.as_ptr(),\n                            mlen as u64,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            std::ptr::null(),\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                    )\n                };\n                eq_i32(&format!(\"{p}_encrypt rc(ad={adlen})\"), ra, rb);\n                eq_bytes(&format!(\"{p}_encrypt(ad={adlen},m={mlen})\"), &c1, &c2);\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// detached API, and combined-vs-detached equivalence\n// ---------------------------------------------------------------------------\n\n#[test]\nfn aead_detached_and_equivalence() {\n    setup();\n    let mut rng = Rng::new(0x8002);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, _) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (ced, red) = pair::<EncDet>(&format!(\"{p}_encrypt_detached\"));\n        let (cdd, rdd) = pair::<DecDet>(&format!(\"{p}_decrypt_detached\"));\n        for &mlen in &[0usize, 1, 5, 15, 16, 17, 31, 32, 33, 63, 64, 65, 128, 1000, 4097] {\n            for &adlen in &[0usize, 1, 16, 17, 100] {\n                let k = rng.bytes(s.kb);\n                let npub = rng.bytes(s.nb);\n                let m = rng.bytes(mlen);\n                let ad = rng.bytes(adlen);\n\n                let mut c1 = canary(mlen.max(1));\n                let mut c2 = canary(mlen.max(1));\n                let mut t1 = canary(s.ab);\n                let mut t2 = canary(s.ab);\n                let mut ml1 = u64::MAX;\n                let mut ml2 = u64::MAX;\n                let (ra, rb) = unsafe {\n                    (\n                        ced(\n                            c1.as_mut_ptr(),\n                            t1.as_mut_ptr(),\n                            &mut ml1,\n                            m.as_ptr(),\n                            mlen as u64,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            std::ptr::null(),\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                        red(\n                            c2.as_mut_ptr(),\n                            t2.as_mut_ptr(),\n                            &mut ml2,\n                            m.as_ptr(),\n                            mlen as u64,\n                            ad.as_ptr(),\n                            adlen as u64,\n                            std::ptr::null(),\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                    )\n                };\n                eq_i32(&format!(\"{p}_encrypt_detached rc(m={mlen},ad={adlen})\"), ra, rb);\n                eq_usize(&format!(\"{p}_encrypt_detached *maclen_p\"), ml1 as usize, ml2 as usize);\n                eq_bytes(&format!(\"{p}_encrypt_detached c(m={mlen},ad={adlen})\"), &c1, &c2);\n                eq_bytes(&format!(\"{p}_encrypt_detached mac(m={mlen},ad={adlen})\"), &t1, &t2);\n                assert_eq!(ml1 as usize, s.ab);\n\n                // combined output must equal detached c || mac\n                let mut comb = canary(mlen + s.ab);\n                unsafe {\n                    ce(\n                        comb.as_mut_ptr(),\n                        std::ptr::null_mut(),\n                        m.as_ptr(),\n                        mlen as u64,\n                        ad.as_ptr(),\n                        adlen as u64,\n                        std::ptr::null(),\n                        npub.as_ptr(),\n                        k.as_ptr(),\n                    );\n                }\n                eq_bytes(\n                    &format!(\"{p} combined==detached c(m={mlen},ad={adlen})\"),\n                    &comb[..mlen],\n                    &c1[..mlen],\n                );\n                eq_bytes(\n                    &format!(\"{p} combined==detached mac(m={mlen},ad={adlen})\"),\n                    &comb[mlen..],\n                    &t1,\n                );\n\n                // decrypt_detached\n                let mut p1 = canary(mlen.max(1));\n                let mut p2 = canary(mlen.max(1));\n                let (ra, rb) = unsafe {\n                    (\n                        cdd(\n                            p1.as_mut_ptr(),\n                            std::ptr::null_mut(),\n                            c1.as_ptr(),\n                            mlen as u64,\n                            t1.as_ptr(),\n                            ad.as_ptr(),\n                            adlen as u64,\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                        rdd(\n                            p2.as_mut_ptr(),\n                            std::ptr::null_mut(),\n                            c1.as_ptr(),\n                            mlen as u64,\n                            t1.as_ptr(),\n                            ad.as_ptr(),\n                            adlen as u64,\n                            npub.as_ptr(),\n                            k.as_ptr(),\n                        ),\n                    )\n                };\n                eq_i32(&format!(\"{p}_decrypt_detached rc(m={mlen},ad={adlen})\"), ra, rb);\n                eq_bytes(&format!(\"{p}_decrypt_detached(m={mlen},ad={adlen})\"), &p1, &p2);\n                assert_eq!(ra, 0);\n                assert_eq!(&p1[..mlen], &m[..]);\n            }\n        }\n    }\n}\n\n/// `maclen_p == NULL` (encrypt_detached) and `clen_p`/`mlen_p == NULL`.\n#[test]\nfn aead_null_out_length_pointers() {\n    setup();\n    let mut rng = Rng::new(0x8003);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        let (ced, red) = pair::<EncDet>(&format!(\"{p}_encrypt_detached\"));\n        for &mlen in &[0usize, 1, 64, 100, 1000] {\n            let k = rng.bytes(s.kb);\n            let npub = rng.bytes(s.nb);\n            let m = rng.bytes(mlen);\n            let ad = rng.bytes(16);\n\n            // clen_p == NULL\n            let mut c1 = canary(mlen + s.ab);\n            let mut c2 = canary(mlen + s.ab);\n            unsafe {\n                let a = ce(\n                    c1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    ad.as_ptr(),\n                    16,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = re(\n                    c2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    ad.as_ptr(),\n                    16,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_encrypt clen_p=NULL rc\"), a, b);\n            }\n            eq_bytes(&format!(\"{p}_encrypt clen_p=NULL(m={mlen})\"), &c1, &c2);\n\n            // mlen_p == NULL on decrypt\n            let mut m1 = canary(mlen.max(1));\n            let mut m2 = canary(mlen.max(1));\n            unsafe {\n                let a = cd(\n                    m1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    ad.as_ptr(),\n                    16,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = rd(\n                    m2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    ad.as_ptr(),\n                    16,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_decrypt mlen_p=NULL rc\"), a, b);\n                assert_eq!(a, 0);\n            }\n            eq_bytes(&format!(\"{p}_decrypt mlen_p=NULL(m={mlen})\"), &m1, &m2);\n\n            // maclen_p == NULL on encrypt_detached\n            let mut d1 = canary(mlen.max(1));\n            let mut d2 = canary(mlen.max(1));\n            let mut t1 = canary(s.ab);\n            let mut t2 = canary(s.ab);\n            unsafe {\n                let a = ced(\n                    d1.as_mut_ptr(),\n                    t1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    ad.as_ptr(),\n                    16,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = red(\n                    d2.as_mut_ptr(),\n                    t2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    ad.as_ptr(),\n                    16,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_encrypt_detached maclen_p=NULL rc\"), a, b);\n            }\n            eq_bytes(&format!(\"{p} det maclen_p=NULL c\"), &d1, &d2);\n            eq_bytes(&format!(\"{p} det maclen_p=NULL mac\"), &t1, &t2);\n        }\n    }\n}\n\n/// `m == NULL` on decrypt (verify-only mode) and `ad == NULL` with `adlen == 0`,\n/// `m == NULL` with `mlen == 0` on encrypt, non-NULL `nsec` (must be ignored).\n#[test]\nfn aead_null_pointer_valid_shapes() {\n    setup();\n    let mut rng = Rng::new(0x8004);\n    for &p in AEADS {\n        let s = sizes(p);\n        assert_eq!(s.nsb, 0, \"{p}_nsecbytes must be 0\");\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for &mlen in &[0usize, 1, 64, 1000] {\n            let k = rng.bytes(s.kb);\n            let npub = rng.bytes(s.nb);\n            let m = rng.bytes(mlen);\n            let mut c1 = canary(mlen + s.ab);\n            let mut c2 = canary(mlen + s.ab);\n\n            // ad = NULL, adlen = 0\n            unsafe {\n                let a = ce(\n                    c1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    if mlen == 0 { std::ptr::null() } else { m.as_ptr() },\n                    mlen as u64,\n                    std::ptr::null(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = re(\n                    c2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    if mlen == 0 { std::ptr::null() } else { m.as_ptr() },\n                    mlen as u64,\n                    std::ptr::null(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_encrypt ad=NULL rc\"), a, b);\n            }\n            eq_bytes(&format!(\"{p}_encrypt ad=NULL,m={mlen}\"), &c1, &c2);\n\n            // ad = NULL, adlen = 0 must equal a non-NULL ad with adlen = 0\n            let ad0 = [0u8; 4];\n            let mut c3 = canary(mlen + s.ab);\n            unsafe {\n                ce(\n                    c3.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    if mlen == 0 { std::ptr::null() } else { m.as_ptr() },\n                    mlen as u64,\n                    ad0.as_ptr(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n            }\n            eq_bytes(&format!(\"{p} ad=NULL == ad!=NULL,adlen=0\"), &c1, &c3);\n\n            // decrypt with m = NULL (verify only)\n            let mut o1 = u64::MAX;\n            let mut o2 = u64::MAX;\n            unsafe {\n                let a = cd(\n                    std::ptr::null_mut(),\n                    &mut o1,\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = rd(\n                    std::ptr::null_mut(),\n                    &mut o2,\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_decrypt m=NULL rc(m={mlen})\"), a, b);\n                assert_eq!(a, 0, \"{p} verify-only must succeed\");\n            }\n            eq_usize(&format!(\"{p}_decrypt m=NULL *mlen_p\"), o1 as usize, o2 as usize);\n\n            // non-NULL nsec must be ignored and left untouched\n            let mut ns1 = [0xA5u8; 8];\n            let mut ns2 = [0xA5u8; 8];\n            let mut m1 = canary(mlen.max(1));\n            let mut m2 = canary(mlen.max(1));\n            unsafe {\n                let a = cd(\n                    m1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    ns1.as_mut_ptr(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = rd(\n                    m2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    ns2.as_mut_ptr(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_decrypt nsec!=NULL rc\"), a, b);\n            }\n            eq_bytes(&format!(\"{p} nsec buffer untouched\"), &ns1, &ns2);\n            assert_eq!(ns1, [0xA5u8; 8], \"{p} must not write to nsec\");\n            eq_bytes(&format!(\"{p}_decrypt nsec!=NULL plaintext\"), &m1, &m2);\n        }\n    }\n}\n\n/// In-place operation (`c == m`).\n#[test]\nfn aead_in_place() {\n    setup();\n    let mut rng = Rng::new(0x8005);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for &mlen in &[0usize, 1, 16, 17, 32, 33, 64, 65, 1000] {\n            let k = rng.bytes(s.kb);\n            let npub = rng.bytes(s.nb);\n            let m = rng.bytes(mlen);\n            let ad = rng.bytes(16);\n\n            let mut b1 = canary(mlen + s.ab);\n            let mut b2 = canary(mlen + s.ab);\n            b1[..mlen].copy_from_slice(&m);\n            b2[..mlen].copy_from_slice(&m);\n            unsafe {\n                let a = ce(\n                    b1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    b1.as_ptr(),\n                    mlen as u64,\n                    ad.as_ptr(),\n                    16,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = re(\n                    b2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    b2.as_ptr(),\n                    mlen as u64,\n                    ad.as_ptr(),\n                    16,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_encrypt in-place rc\"), a, b);\n            }\n            eq_bytes(&format!(\"{p}_encrypt in-place(m={mlen})\"), &b1, &b2);\n\n            // decrypt in place\n            let mut d1 = b1.clone();\n            let mut d2 = b1.clone();\n            unsafe {\n                let a = cd(\n                    d1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    d1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    ad.as_ptr(),\n                    16,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = rd(\n                    d2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    d2.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    ad.as_ptr(),\n                    16,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_decrypt in-place rc\"), a, b);\n                assert_eq!(a, 0);\n            }\n            eq_bytes(&format!(\"{p}_decrypt in-place(m={mlen})\"), &d1, &d2);\n            assert_eq!(&d1[..mlen], &m[..]);\n        }\n    }\n}\n\n/// Degenerate / extreme key and nonce shapes.\n#[test]\nfn aead_key_nonce_shapes() {\n    setup();\n    let mut rng = Rng::new(0x8006);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let mlen = 64usize;\n        let adlen = 16usize;\n        let m = rng.bytes(mlen);\n        let ad = rng.bytes(adlen);\n        let keys: Vec<Vec<u8>> = vec![vec![0u8; s.kb], vec![0xffu8; s.kb], rng.bytes(s.kb)];\n        let mut nonces: Vec<Vec<u8>> = vec![vec![0u8; s.nb], vec![0xffu8; s.nb], rng.bytes(s.nb)];\n        // For xchacha20: nonces differing only in the first / second half hit\n        // structurally different dependencies (hchacha20 subkey vs npub2).\n        if s.nb == 24 {\n            let base = rng.bytes(24);\n            let mut a = base.clone();\n            a[3] ^= 0xff; // first half only\n            let mut b = base.clone();\n            b[20] ^= 0xff; // second half only\n            nonces.push(base);\n            nonces.push(a);\n            nonces.push(b);\n        }\n        for k in &keys {\n            for n in &nonces {\n                let mut c1 = canary(mlen + s.ab);\n                let mut c2 = canary(mlen + s.ab);\n                unsafe {\n                    let a = ce(\n                        c1.as_mut_ptr(),\n                        std::ptr::null_mut(),\n                        m.as_ptr(),\n                        mlen as u64,\n                        ad.as_ptr(),\n                        adlen as u64,\n                        std::ptr::null(),\n                        n.as_ptr(),\n                        k.as_ptr(),\n                    );\n                    let b = re(\n                        c2.as_mut_ptr(),\n                        std::ptr::null_mut(),\n                        m.as_ptr(),\n                        mlen as u64,\n                        ad.as_ptr(),\n                        adlen as u64,\n                        std::ptr::null(),\n                        n.as_ptr(),\n                        k.as_ptr(),\n                    );\n                    eq_i32(&format!(\"{p} key/nonce shape rc\"), a, b);\n                }\n                eq_bytes(\n                    &format!(\"{p}(k={}, n={})\", hex(k), hex(n)),\n                    &c1,\n                    &c2,\n                );\n            }\n        }\n    }\n}\n\n/// The 128 KiB `STREAM_POLY1305_CHUNK` restart boundary of the three\n/// poly1305-based AEADs (and the same lengths for AEGIS as a control).\n#[test]\nfn aead_chunk_boundary_lengths() {\n    setup();\n    let mut rng = Rng::new(0x8007);\n    for &p in AEADS {\n        let s = sizes(p);\n        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for &mlen in CHUNK_LENS {\n            let k = rng.bytes(s.kb);\n            let npub = rng.bytes(s.nb);\n            let m = rng.bytes(mlen);\n            let mut c1 = vec![0xA5u8; mlen + s.ab];\n            let mut c2 = vec![0xA5u8; mlen + s.ab];\n            unsafe {\n                let a = ce(\n                    c1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    std::ptr::null(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = re(\n                    c2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    std::ptr::null(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_encrypt chunk rc(m={mlen})\"), a, b);\n            }\n            eq_bytes(&format!(\"{p}_encrypt chunk(m={mlen})\"), &c1, &c2);\n\n            // decrypt (single un-chunked pass in C) must agree with encrypt\n            let mut d1 = vec![0xA5u8; mlen];\n            let mut d2 = vec![0xA5u8; mlen];\n            unsafe {\n                let a = cd(\n                    d1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = rd(\n                    d2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    (mlen + s.ab) as u64,\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(&format!(\"{p}_decrypt chunk rc(m={mlen})\"), a, b);\n                assert_eq!(a, 0, \"{p} chunk round-trip\");\n            }\n            eq_bytes(&format!(\"{p}_decrypt chunk(m={mlen})\"), &d1, &d2);\n            assert_eq!(d1, m);\n        }\n    }\n}\n\n/// AEGIS detached mode accepts `clen < ABYTES` (no gate) — a valid config.\n#[test]\nfn aegis_detached_short_clen() {\n    setup();\n    let mut rng = Rng::new(0x8008);\n    for &p in &[\"crypto_aead_aegis128l\", \"crypto_aead_aegis256\"] {\n        let s = sizes(p);\n        assert_eq!(s.ab, 32);\n        let (ced, red) = pair::<EncDet>(&format!(\"{p}_encrypt_detached\"));\n        let (cdd, rdd) = pair::<DecDet>(&format!(\"{p}_decrypt_detached\"));\n        for &mlen in &[0usize, 1, 5, 31] {\n            let k = rng.bytes(s.kb);\n            let npub = rng.bytes(s.nb);\n            let m = rng.bytes(mlen);\n            let mut c1 = canary(mlen.max(1));\n            let mut c2 = canary(mlen.max(1));\n            let mut t1 = canary(s.ab);\n            let mut t2 = canary(s.ab);\n            unsafe {\n                let a = ced(\n                    c1.as_mut_ptr(),\n                    t1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    std::ptr::null(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = red(\n                    c2.as_mut_ptr(),\n                    t2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    m.as_ptr(),\n                    mlen as u64,\n                    std::ptr::null(),\n                    0,\n                    std::ptr::null(),\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(\"aegis det short rc\", a, b);\n            }\n            eq_bytes(&format!(\"{p} det short c(m={mlen})\"), &c1, &c2);\n            eq_bytes(&format!(\"{p} det short mac(m={mlen})\"), &t1, &t2);\n\n            let mut p1 = canary(mlen.max(1));\n            let mut p2 = canary(mlen.max(1));\n            unsafe {\n                let a = cdd(\n                    p1.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    mlen as u64,\n                    t1.as_ptr(),\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                let b = rdd(\n                    p2.as_mut_ptr(),\n                    std::ptr::null_mut(),\n                    c1.as_ptr(),\n                    mlen as u64,\n                    t1.as_ptr(),\n                    std::ptr::null(),\n                    0,\n                    npub.as_ptr(),\n                    k.as_ptr(),\n                );\n                eq_i32(\"aegis det short decrypt rc\", a, b);\n                assert_eq!(a, 0);\n            }\n            eq_bytes(&format!(\"{p} det short decrypt(m={mlen})\"), &p1, &p2);\n        }\n    }\n}\n\n/// Cross-variant wiring: xchacha20poly1305_ietf(k, npub24) must equal\n/// chacha20poly1305_ietf(hchacha20(npub[0..16], k), 0000||npub[16..24]).\n#[test]\nfn xchacha_equals_chacha_ietf_with_derived_subkey() {\n    setup();\n    let mut rng = Rng::new(0x8009);\n    let (cx, _) = pair::<Enc>(\"crypto_aead_xchacha20poly1305_ietf_encrypt\");\n    let (ci, _) = pair::<Enc>(\"crypto_aead_chacha20poly1305_ietf_encrypt\");\n    // use the *Rust* library for both halves of the identity too\n    let (_, rx) = pair::<Enc>(\"crypto_aead_xchacha20poly1305_ietf_encrypt\");\n    let (_, ri) = pair::<Enc>(\"crypto_aead_chacha20poly1305_ietf_encrypt\");\n    let hchacha =\n        pair::<unsafe extern \"C\" fn(*mut u8, *const u8, *const u8, *const u8) -> i32>(\n            \"crypto_core_hchacha20\",\n        );\n    for &mlen in &[0usize, 1, 64, 65, 1000] {\n        for &adlen in &[0usize, 16, 17] {\n            let k = rng.bytes(32);\n            let npub = rng.bytes(24);\n            let m = rng.bytes(mlen);\n            let ad = rng.bytes(adlen);\n            for (which, (xf, inf, hc)) in [(cx, ci, hchacha.0), (rx, ri, hchacha.1)]\n                .into_iter()\n                .enumerate()\n            {\n                let mut k2 = [0u8; 32];\n                unsafe {\n                    hc(\n                        k2.as_mut_ptr(),\n                        npub.as_ptr(),\n                        k.as_ptr(),\n                        std::ptr::null(),\n                    )\n                };\n                let mut npub2 = [0u8; 12];\n                npub2[4..].copy_from_slice(&npub[16..24]);\n\n                let mut a = canary(mlen + 16);\n                let mut b = canary(mlen + 16);\n                unsafe {\n                    xf(\n                        a.as_mut_ptr(),\n                        std::ptr::null_mut(),\n                        m.as_ptr(),\n                        mlen as u64,\n                        ad.as_ptr(),\n                        adlen as u64,\n                        std::ptr::null(),\n                        npub.as_ptr(),\n                        k.as_ptr(),\n                    );\n                    inf(\n                        b.as_mut_ptr(),\n                        std::ptr::null_mut(),\n                        m.as_ptr(),\n                        mlen as u64,\n                        ad.as_ptr(),\n                        adlen as u64,\n                        std::ptr::null(),\n                        npub2.as_ptr(),\n                        k2.as_ptr(),\n                    );\n                }\n                eq_bytes(\n                    &format!(\"xchacha==chacha_ietf (lib={which}, m={mlen}, ad={adlen})\"),\n                    &a,\n                    &b,\n                );\n            }\n        }\n    }\n}\n\n/// Every AEAD `_keygen` is deterministic under the installed RNG.\n#[test]\nfn aead_keygens() {\n    setup();\n    let mut names: Vec<String> = AEADS.iter().map(|p| format!(\"{p}_keygen\")).collect();\n    names.push(\"crypto_aead_aes256gcm_keygen\".into());\n    for name in &names {\n        let p = name.trim_end_matches(\"_keygen\");\n        let kb = unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{p}_keybytes\"))() };\n        let (c, r) = pair::<Keygen>(name);\n        for seed in 0..8u64 {\n            let mut a = canary(kb + 8);\n            let mut b = canary(kb + 8);\n            reset_rngs(0xD000 + seed);\n            unsafe { c(a.as_mut_ptr()) };\n            reset_rngs(0xD000 + seed);\n            unsafe { r(b.as_mut_ptr()) };\n            eq_bytes(&format!(\"{name} seed={seed}\"), &a, &b);\n            assert_eq!(&a[kb..], &[0xA5u8; 8], \"{name} wrote past keybytes\");\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// aes256gcm — unavailable in this build. Every operation must reject the same\n// way in C and Rust (errno included).\n// ---------------------------------------------------------------------------\n\ntype Beforenm = unsafe extern \"C\" fn(*mut u8, *const u8) -> i32;\ntype EncAfternm = unsafe extern \"C\" fn(\n    *mut u8,\n    *mut u64,\n    *const u8,\n    u64,\n    *const u8,\n    u64,\n    *const u8,\n    *const u8,\n    *const u8,\n) -> i32;\n\n#[test]\nfn aes256gcm_is_unavailable_identically() {\n    setup();\n    let mut rng = Rng::new(0x800A);\n    let (cav, rav) = pair::<unsafe extern \"C\" fn() -> i32>(\"crypto_aead_aes256gcm_is_available\");\n    let (a, b) = unsafe { (cav(), rav()) };\n    eq_i32(\"crypto_aead_aes256gcm_is_available\", a, b);\n    assert_eq!(a, 0, \"this build must not have AES-NI AES-GCM\");\n\n    let s = sizes(\"crypto_aead_aes256gcm\");\n    assert_eq!((s.kb, s.nb, s.ab, s.nsb), (32, 12, 16, 0));\n\n    let statebytes = unsafe {\n        sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), \"crypto_aead_aes256gcm_statebytes\")()\n    };\n    assert_eq!(statebytes, 512);\n\n    let (ce, re) = pair::<Enc>(\"crypto_aead_aes256gcm_encrypt\");\n    let (cd, rd) = pair::<Dec>(\"crypto_aead_aes256gcm_decrypt\");\n    let (ced, red) = pair::<EncDet>(\"crypto_aead_aes256gcm_encrypt_detached\");\n    let (cdd, rdd) = pair::<DecDet>(\"crypto_aead_aes256gcm_decrypt_detached\");\n    let (cbn, rbn) = pair::<Beforenm>(\"crypto_aead_aes256gcm_beforenm\");\n\n    for &mlen in &[0usize, 16, 17, 100] {\n        for &adlen in &[0usize, 16, 100] {\n            let k = rng.bytes(32);\n            let npub = rng.bytes(12);\n            let m = rng.bytes(mlen);\n            let ad = rng.bytes(adlen);\n\n            for null_len in [false, true] {\n                let mut c1 = canary(mlen + 16);\n                let mut c2 = canary(mlen + 16);\n                let mut l1 = 0xDEAD_BEEFu64;\n                let mut l2 = 0xDEAD_BEEFu64;\n                let lp1 = if null_len { std::ptr::null_mut() } else { &raw mut l1 };\n                let lp2 = if null_len { std::ptr::null_mut() } else { &raw mut l2 };\n                unsafe {\n                    let a = ce(\n                        c1.as_mut_ptr(), lp1, m.as_ptr(), mlen as u64,\n                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n                        npub.as_ptr(), k.as_ptr(),\n                    );\n                    let b = re(\n                        c2.as_mut_ptr(), lp2, m.as_ptr(), mlen as u64,\n                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n                        npub.as_ptr(), k.as_ptr(),\n                    );\n                    eq_i32(\"aes256gcm_encrypt rc\", a, b);\n                    assert_eq!(a, -1);\n                }\n                eq_bytes(\"aes256gcm_encrypt out untouched\", &c1, &c2);\n                assert_eq!(c1, canary(mlen + 16));\n                eq_usize(\"aes256gcm_encrypt *clen_p untouched\", l1 as usize, l2 as usize);\n\n                let mut m1 = canary(mlen.max(1));\n                let mut m2 = canary(mlen.max(1));\n                let mut o1 = 0xDEAD_BEEFu64;\n                let mut o2 = 0xDEAD_BEEFu64;\n                let op1 = if null_len { std::ptr::null_mut() } else { &raw mut o1 };\n                let op2 = if null_len { std::ptr::null_mut() } else { &raw mut o2 };\n                unsafe {\n                    let a = cd(\n                        m1.as_mut_ptr(), op1, std::ptr::null_mut(), c1.as_ptr(),\n                        (mlen + 16) as u64, ad.as_ptr(), adlen as u64,\n                        npub.as_ptr(), k.as_ptr(),\n                    );\n                    let b = rd(\n                        m2.as_mut_ptr(), op2, std::ptr::null_mut(), c1.as_ptr(),\n                        (mlen + 16) as u64, ad.as_ptr(), adlen as u64,\n                        npub.as_ptr(), k.as_ptr(),\n                    );\n                    eq_i32(\"aes256gcm_decrypt rc\", a, b);\n                    assert_eq!(a, -1);\n                }\n                eq_bytes(\"aes256gcm_decrypt out untouched\", &m1, &m2);\n                eq_usize(\"aes256gcm_decrypt *mlen_p untouched\", o1 as usize, o2 as usize);\n\n                // detached\n                let mut d1 = canary(mlen.max(1));\n                let mut d2 = canary(mlen.max(1));\n                let mut t1 = canary(16);\n                let mut t2 = canary(16);\n                let mut ml1 = 0xDEAD_BEEFu64;\n                let mut ml2 = 0xDEAD_BEEFu64;\n                let mp1 = if null_len { std::ptr::null_mut() } else { &raw mut ml1 };\n                let mp2 = if null_len { std::ptr::null_mut() } else { &raw mut ml2 };\n                unsafe {\n                    let a = ced(\n                        d1.as_mut_ptr(), t1.as_mut_ptr(), mp1, m.as_ptr(), mlen as u64,\n                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n                        npub.as_ptr(), k.as_ptr(),\n                    );\n                    let b = red(\n                        d2.as_mut_ptr(), t2.as_mut_ptr(), mp2, m.as_ptr(), mlen as u64,\n                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n                        npub.as_ptr(), k.as_ptr(),\n                    );\n                    eq_i32(\"aes256gcm_encrypt_detached rc\", a, b);\n                    assert_eq!(a, -1);\n                }\n                eq_bytes(\"aes256gcm det c untouched\", &d1, &d2);\n                eq_bytes(\"aes256gcm det mac untouched\", &t1, &t2);\n                eq_usize(\"aes256gcm det *maclen_p\", ml1 as usize, ml2 as usize);\n\n                let mut p1 = canary(mlen.max(1));\n                let mut p2 = canary(mlen.max(1));\n                let mac = rng.bytes(16);\n                unsafe {\n                    let a = cdd(\n                        p1.as_mut_ptr(), std::ptr::null_mut(), d1.as_ptr(), mlen as u64,\n                        mac.as_ptr(), ad.as_ptr(), adlen as u64, npub.as_ptr(), k.as_ptr(),\n                    );\n                    let b = rdd(\n                        p2.as_mut_ptr(), std::ptr::null_mut(), d1.as_ptr(), mlen as u64,\n                        mac.as_ptr(), ad.as_ptr(), adlen as u64, npub.as_ptr(), k.as_ptr(),\n                    );\n                    eq_i32(\"aes256gcm_decrypt_detached rc\", a, b);\n                    assert_eq!(a, -1);\n                }\n                eq_bytes(\"aes256gcm det decrypt out untouched\", &p1, &p2);\n\n                // m == NULL on decrypt_detached\n                unsafe {\n                    let a = cdd(\n                        std::ptr::null_mut(), std::ptr::null_mut(), d1.as_ptr(), mlen as u64,\n                        mac.as_ptr(), ad.as_ptr(), adlen as u64, npub.as_ptr(), k.as_ptr(),\n                    );\n                    let b = rdd(\n                        std::ptr::null_mut(), std::ptr::null_mut(), d1.as_ptr(), mlen as u64,\n                        mac.as_ptr(), ad.as_ptr(), adlen as u64, npub.as_ptr(), k.as_ptr(),\n                    );\n                    eq_i32(\"aes256gcm_decrypt_detached m=NULL rc\", a, b);\n                }\n            }\n        }\n    }\n\n    // beforenm\n    let k = rng.bytes(32);\n    let mut st1 = State::new(statebytes);\n    let mut st2 = State::new(statebytes);\n    unsafe {\n        let a = cbn(st1.as_mut_ptr(), k.as_ptr());\n        let b = rbn(st2.as_mut_ptr(), k.as_ptr());\n        eq_i32(\"aes256gcm_beforenm rc\", a, b);\n        assert_eq!(a, -1);\n    }\n    eq_bytes(\"aes256gcm_beforenm state untouched\", st1.bytes(), st2.bytes());\n\n    // *_afternm forms\n    for name in [\n        \"crypto_aead_aes256gcm_encrypt_afternm\",\n        \"crypto_aead_aes256gcm_decrypt_afternm\",\n        \"crypto_aead_aes256gcm_encrypt_detached_afternm\",\n        \"crypto_aead_aes256gcm_decrypt_detached_afternm\",\n    ] {\n        let (c, r) = pair::<EncAfternm>(name);\n        for &mlen in &[0usize, 16, 100] {\n            for &adlen in &[0usize, 16] {\n                let m = rng.bytes(mlen);\n                let ad = rng.bytes(adlen);\n                let npub = rng.bytes(12);\n                let mut out1 = canary(mlen + 32);\n                let mut out2 = canary(mlen + 32);\n                let mut l1 = 0xDEADu64;\n                let mut l2 = 0xDEADu64;\n                unsafe {\n                    let a = c(\n                        out1.as_mut_ptr(), &mut l1, m.as_ptr(), mlen as u64,\n                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n                        npub.as_ptr(), st1.as_ptr(),\n                    );\n                    let b = r(\n                        out2.as_mut_ptr(), &mut l2, m.as_ptr(), mlen as u64,\n                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n                        npub.as_ptr(), st2.as_ptr(),\n                    );\n                    eq_i32(&format!(\"{name} rc\"), a, b);\n                    assert_eq!(a, -1, \"{name} must be unavailable\");\n                }\n                eq_bytes(&format!(\"{name} out untouched\"), &out1, &out2);\n                eq_usize(&format!(\"{name} *len untouched\"), l1 as usize, l2 as usize);\n            }\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
