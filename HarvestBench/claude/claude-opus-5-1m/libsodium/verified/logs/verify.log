   let mut pad_len: usize = 0;\n226\t\n227\t    if padded_buflen < blocksize || blocksize == 0 {\n228\t        return -1;\n229\t    }\n230\t    let tail = unsafe { buf.add(padded_buflen - 1) };\n231\t\n232\t    for i in 0..blocksize {\n233\t        let c = unsafe { *tail.sub(i) };\n234\t        // (( (acc - 1U) & (pad_len - 1U) & ((c ^ 0x80) - 1U) ) >> 8) & 1U\n235\t        // The C operands promote to size_t because of pad_len.\n236\t        let is_barrier: usize = (((acc as usize).wrapping_sub(1)\n237\t            & pad_len.wrapping_sub(1)\n238\t            & ((c ^ 0x80) as usize).wrapping_sub(1))\n239\t            >> 8)\n240\t            & 1;\n241\t        acc |= c;\n242\t        pad_len |= i & (1usize.wrapping_add(!is_barrier));\n243\t        valid |= is_barrier as u8;\n244\t    }\n245\t    unsafe { *unpadded_buflen_p = padded_buflen - 1 - pad_len };\n246\t\n247\t    valid.wrapping_sub(1) as i8 as c_int\n248\t}\n249\t"}]},"parent_tool_use_id":"toolu_bdrk_01Aw2j196PG6UFGUL4fdGJ7V","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"5a1e12e5-12a2-43b1-9dd5-d9cc594d9263","timestamp":"2026-08-23T08:28:16.438Z","subagent_type":"general-purpose","task_description":"Phase B+C tests: sodium+randombytes"}
