{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019qmJVLHykMoWfJLqxteAn7","type":"tool_result","content":"//! Phase C — AEAD error paths (`ERRORS.md` rows for the `crypto_aead_*` group).\n//!\n//! Two kinds of row:\n//!\n//! * **`return -1` rows** — called directly on both `.so`s; the return value,\n//!   the out-parameters (`*mlen_p`) and the output buffer contents (whether the\n//!   plaintext got zeroed) must match byte-for-byte.\n//! * **`sodium_misuse()` rows** — `sodium_misuse()` runs the installed handler\n//!   and then `abort()`s. Each such row is run in a **child process** (once\n//!   against the C `.so`, once against the Rust `.so`) with an observing\n//!   handler installed, so the abort *and* the side effects written before it\n//!   are compared exactly.\n\nmod common;\nuse common::*;\n\ntype Enc = unsafe extern \"C\" fn(\n    *mut u8, *mut u64, *const u8, u64, *const u8, u64, *const u8, *const u8, *const u8,\n) -> i32;\ntype Dec = unsafe extern \"C\" fn(\n    *mut u8, *mut u64, *mut u8, *const u8, u64, *const u8, u64, *const u8, *const u8,\n) -> i32;\ntype EncDet = unsafe extern \"C\" fn(\n    *mut u8, *mut u8, *mut u64, *const u8, u64, *const u8, u64, *const u8, *const u8, *const u8,\n) -> i32;\ntype DecDet = unsafe extern \"C\" fn(\n    *mut u8, *mut u8, *const u8, u64, *const u8, *const u8, u64, *const u8, *const u8,\n) -> i32;\n\nconst AEADS: &[&str] = &[\n    \"crypto_aead_aegis128l\",\n    \"crypto_aead_aegis256\",\n    \"crypto_aead_chacha20poly1305\",\n    \"crypto_aead_chacha20poly1305_ietf\",\n    \"crypto_aead_xchacha20poly1305_ietf\",\n];\n\nfn g(p: &str, s: &str) -> usize {\n    unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{p}_{s}\"))() }\n}\nfn gmax(p: &str) -> u64 {\n    unsafe { sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), &format!(\"{p}_messagebytes_max\"))() }\n}\n\n// ===========================================================================\n// `return -1` rows\n// ===========================================================================\n\n/// ERRORS rows: `_decrypt` with `clen < ABYTES` (0 and ABYTES-1) —\n/// returns -1, `*mlen_p` set to 0, output buffer untouched.\n#[test]\nfn decrypt_clen_below_abytes() {\n    setup();\n    let mut rng = Rng::new(0x9000);\n    for &p in AEADS {\n        let ab = g(p, \"abytes\");\n        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n        for clen in 0..=ab {\n            if clen == ab {\n                continue; // ab itself is valid (mlen = 0)\n...\n481:const MISUSE_CASES: &[&str] = &[\n482-    // aegis128l / aegis256 combined encrypt: mlen > MESSAGEBYTES_MAX\n483-    \"aegis128l/encrypt/mlen=max+1\",\n484-    \"aegis128l/encrypt/mlen=u64max\",\n485-    \"aegis256/encrypt/mlen=max+1\",\n486-    \"aegis256/encrypt/mlen=u64max\",\n487-    // combined encrypt with oversized adlen (guard lives in _encrypt_detached)\n488-    \"aegis128l/encrypt/adlen=max+1\",\n489-    \"aegis256/encrypt/adlen=max+1\",\n490-    // detached encrypt: *maclen_p is written BEFORE the abort\n491-    \"aegis128l/encrypt_detached/mlen=max+1\",\n492-    \"aegis128l/encrypt_detached/adlen=max+1\",\n493-    \"aegis256/encrypt_detached/mlen=max+1\",\n494-    \"aegis256/encrypt_detached/adlen=max+1\",\n495-    // poly1305 AEADs: combined encrypt guards\n496-    \"chacha20poly1305/encrypt/mlen=max+1\",\n497-    \"chacha20poly1305_ietf/encrypt/mlen=max+1\",\n498-    \"chacha20poly1305_ietf/encrypt/mlen=u64max\",\n499-    \"xchacha20poly1305_ietf/encrypt/mlen=max+1\",\n500-];\n501-\n--\n508:fn misuse_child() {\n509-    let Some((tag, lib)) = child_case() else {\n510-        return;\n511-    };\n512-    let p = prefix_of(&tag);\n513-    let ab = g(&p, \"abytes\");\n514-    let max = gmax(&p);\n515-    let k = vec![3u8; g(&p, \"keybytes\")];\n516-    let npub = vec![4u8; g(&p, \"npubbytes\")];\n517-    let mbuf = [0u8; 64];\n518-    let mut cbuf = canary(128);\n519-    let mut tagbuf = canary(64);\n520-    let mut maclen = 0xA5A5_A5A5_A5A5_A5A5u64;\n521-    let mut clen = 0xA5A5_A5A5_A5A5_A5A5u64;\n522-\n523-    let parts: Vec<&str> = tag.split('/').collect();\n524-    let (func, cond) = (parts[1], parts[2]);\n525-    let big = match cond {\n526-        \"mlen=max+1\" | \"adlen=max+1\" => max + 1,\n527-        \"mlen=u64max\" | \"adlen=u64max\" => u64::MAX,\n528-        other => panic!(\"unknown condition {other}\"),\n--\n563:fn misuse_paths_match() {\n564-    if child_tag().is_some() {\n565-        return;\n566-    }\n567-    setup();\n568:    for &tag in MISUSE_CASES {\n569-        let c = run_child(\"misuse_child\", \"c\", tag);\n570-        let r = run_child(\"misuse_child\", \"r\", tag);\n571-        eq_child(tag, &c, &r);\n572-        // the C reference must genuinely have gone through sodium_misuse()\n573-        assert_eq!(\n574-            c.status.code(),\n575-            Some(MISUSE_EXIT),\n576-            \"{tag}: C did not reach sodium_misuse (stdout: {}, stderr: {})\",\n577-            String::from_utf8_lossy(&c.stdout),\n578-            String::from_utf8_lossy(&c.stderr)\n579-        );\n580-    }\n581-}\n582-\n583-/// ERRORS rows recorded as **not constructible** — documented here so the row\n584-/// is not silently dropped, with the reason and the place the same C branch\n585-/// *is* covered.\n586-#[test]\n587-fn documented_unreachable_error_rows() {\n588-    setup();","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01WrsYR539dBijXjs9pv3ndE","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"979442a9-e3e4-4589-a34d-41c90cce5b22","timestamp":"2026-08-23T08:30:15.793Z","subagent_type":"general-purpose","task_description":"Phase B+C tests: core/scalarmult/kem/ipcrypt"}
