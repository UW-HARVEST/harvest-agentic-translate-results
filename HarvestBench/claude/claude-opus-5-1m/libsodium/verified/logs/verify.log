escrypt_PBKDF2_SHA256(passwd, passwdlen, salt, saltlen, c, buf, dkLen):\n43\t * Compute PBKDF2(passwd, salt, c, dkLen) using HMAC-SHA256 as the PRF, and\n44\t * write the output to buf.  The value dkLen must be at most 32 * (2^32 - 1).\n45\t */\n46\tvoid\n47\tescrypt_PBKDF2_SHA256(const uint8_t *passwd, size_t passwdlen,\n48\t                      const uint8_t *salt, size_t saltlen, uint64_t c,\n49\t                      uint8_t *buf, size_t dkLen)\n50\t{\n51\t    crypto_auth_hmacsha256_state PShctx, hctx;\n52\t    size_t                       i;\n53\t    uint8_t                      ivec[4];\n54\t    uint8_t                      U[32];\n55\t    uint8_t                      T[32];\n56\t    uint64_t                     j;\n57\t    int                          k;\n58\t    size_t                       clen;\n59\t\n60\t#if SIZE_MAX > 0x1fffffffe0ULL\n61\t    COMPILER_ASSERT(crypto_pwhash_scryptsalsa208sha256_BYTES_MAX\n62\t                    <= 0x1fffffffe0ULL);\n63\t    if (dkLen > 0x1fffffffe0ULL) {\n64\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n65\t    }\n66\t#endif\n67\t    crypto_auth_hmacsha256_init(&PShctx, passwd, passwdlen);\n68\t    crypto_auth_hmacsha256_update(&PShctx, salt, saltlen);\n69\t\n70\t    for (i = 0; i * 32 < dkLen; i++) {\n71\t        STORE32_BE(ivec, (uint32_t)(i + 1));\n72\t        memcpy(&hctx, &PShctx, sizeof(crypto_auth_hmacsha256_state));\n73\t        crypto_auth_hmacsha256_update(&hctx, ivec, 4);\n74\t        crypto_auth_hmacsha256_final(&hctx, U);\n75\t\n76\t        memcpy(T, U, 32);\n77\t        /* LCOV_EXCL_START */\n78\t        for (j = 2; j <= c; j++) {\n79\t            crypto_auth_hmacsha256_init(&hctx, passwd, passwdlen);\n80\t            crypto_auth_hmacsha256_update(&hctx, U, 32);\n81\t            crypto_auth_hmacsha256_final(&hctx, U);\n82\t\n83\t            for (k = 0; k < 32; k++) {\n84\t                T[k] ^= U[k];\n85\t            }\n86\t        }\n87\t        /* LCOV_EXCL_STOP */\n88\t\n89\t        clen = dkLen - i * 32;\n90\t        if (clen > 32) {\n91\t            clen = 32;\n92\t        }\n93\t        memcpy(&buf[i * 32], T, clen);\n94\t    }\n95\t    sodium_memzero((void *) &PShctx, sizeof PShctx);\n96\t}\n97\t"}]},"parent_tool_use_id":"toolu_bdrk_01FJHFWSbs1nb51qZda9ZhQ1","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"275d5ff5-422a-485e-89fe-8b85e5b02155","timestamp":"2026-08-23T08:08:40.116Z","subagent_type":"general-purpose","task_description":"Phase A tables: crypto_pwhash"}
