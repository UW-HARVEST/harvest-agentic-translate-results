50, 70] {\n2308\t        assert_eq!(\n2309\t            run(&format!(\"dst_len={dst_len}\"), dst_len, &|_| {}, ARGON2_ID),\n2310\t            ARGON2_ENCODING_FAIL,\n2311\t            \"dst_len={dst_len}\"\n2312\t        );\n2313\t    }\n2314\t    // 72 = 27 (prefix) + 22 (salt) + 1 + 43 (hash) + NUL is the exact minimum\n2315\t    assert_eq!(run(\"dst_len=71\", 71, &|_| {}, ARGON2_ID), ARGON2_ENCODING_FAIL);\n2316\t    assert_eq!(run(\"dst_len=72\", 72, &|_| {}, ARGON2_ID), ARGON2_OK);\n2317\t\n2318\t    // G2-150: sodium_bin2base64 cannot fit the salt / the output\n2319\t    // (dst_len leaves room for the literals but not for the base64 field)\n2320\t    for (saltlen, outlen, dst_len) in [\n2321\t        (16u32, 32u32, 50usize),\n2322\t        (16, 32, 60),\n2323\t        (64, 32, 72),\n2324\t        (16, 64, 90),\n2325\t    ] {\n2326\t        assert_eq!(\n2327\t            run(\n2328\t                &format!(\"b64 overflow salt={saltlen} out={outlen} dst={dst_len}\"),\n2329\t                dst_len,\n2330\t                &move |c: &mut Ctx| {\n2331\t                    c.saltlen = saltlen;\n2332\t                    c.outlen = outlen;\n2333\t                },\n2334\t                ARGON2_ID\n2335\t            ),\n2336\t            ARGON2_ENCODING_FAIL\n2337\t        );\n2338\t    }\n2339\t\n2340\t    // G2-151: argon2_validate_inputs fails *after* the variant literal has\n2341\t    // been written, so its code is returned verbatim.\n2342\t    for (what, mutate, want) in [\n2343\t        (\n2344\t            \"outlen=0\",\n2345\t            &(|c: &mut Ctx| c.outlen = 0) as &dyn Fn(&mut Ctx),\n2346\t            ARGON2_OUTPUT_TOO_SHORT,\n2347\t        ),\n2348\t        (\n2349\t            \"outlen=15\",\n2350\t            &(|c: &mut Ctx| c.outlen = 15),\n2351\t            ARGON2_OUTPUT_TOO_SHORT,\n2352\t        ),\n2353\t        (\n2354\t            \"saltlen=4\",\n2355\t            &(|c: &mut Ctx| c.saltlen = 4),\n2356\t            ARGON2_SALT_TOO_SHORT,\n2357