0\t\n61\tSODIUM_EXPORT\n62\tchar *sodium_bin2hex(char *const hex, const size_t hex_maxlen, const unsigned char *const bin,\n63\t                     const size_t bin_len) __attribute__((nonnull(1)));\n64\t\n65\tSODIUM_EXPORT\n66\tint sodium_hex2bin(unsigned char *const bin, const size_t bin_maxlen, const char *const hex,\n67\t                   const size_t hex_len, const char *const ignore, size_t *const bin_len,\n68\t                   const char **const hex_end) __attribute__((nonnull(1)));\n69\t\n70\t#define sodium_base64_VARIANT_ORIGINAL            1\n71\t#define sodium_base64_VARIANT_ORIGINAL_NO_PADDING 3\n72\t#define sodium_base64_VARIANT_URLSAFE             5\n73\t#define sodium_base64_VARIANT_URLSAFE_NO_PADDING  7\n74\t\n75\t/*\n76\t * Computes the required length to encode BIN_LEN bytes as a base64 string\n77\t * using the given variant. The computed length includes a trailing \\0.\n78\t */\n79\t#define sodium_base64_ENCODED_LEN(BIN_LEN, VARIANT)                            \\\n80\t  ((BIN_LEN) / 3U > (SIZE_MAX - 5) / 4U                                        \\\n81\t       ? (size_t)SIZE_MAX                                                      \\\n82\t       : (((BIN_LEN) / 3U) * 4U +                                              \\\n83\t          ((((BIN_LEN) - ((BIN_LEN) / 3U) * 3U) |                              \\\n84\t            (((BIN_LEN) - ((BIN_LEN) / 3U) * 3U) >> 1)) &                      \\\n85\t           1U) *                                                               \\\n86\t              (4U - ((0U - (((VARIANT) & 2U) >> 1)) &                          \\\n87\t                     (3U - ((BIN_LEN) - ((BIN_LEN) / 3U) * 3U)))) +            \\\n88\t          1U))\n89\t\n90\tSODIUM_EXPORT\n91\tsize_t sodium_base64_encoded_len(const size_t bin_len, const int variant);\n92\t\n93\tSODIUM_EXPORT\n94\tchar *sodium_bin2base64(char *const b64, const size_t b64_maxlen, const unsigned char *const bin,\n95\t                        const size_t bin_len, const int variant) __attribute__((nonnull(1)));\n96\t\n97\tSODIUM_EXPORT\n98\tint sodium_base642bin(unsigned char *const bin, const size_t bin_maxlen, const char *const b64,\n99\t                      const size_t b64_len, const char *const ignore, size_t *const bin_len,\n100\t                      const char **const b64_end, const int variant) __attribute__((nonnull(1)));\n101\t\n102\tSODIUM_EXPORT\n103\tint sodium_ip2bin(unsigned char bin[16], const char *ip, size_t ip_len_)\n104\t    __attribute__((warn_unused_result)) __attribute__((nonnull));\n105\t\n106\tSODIUM_EXPORT\n107\tchar *sodium_bin2ip(char *ip, size_t ip_maxlen, const unsigned char bin[16])\n108\t    __attribute__((nonnull));\n109\t\n110\tSODIUM_EXPORT\n111\tint sodium_mlock(void *const addr, const size_t len) __attribute__((nonnull));\n112\t\n113\tSODIUM_EXPORT\n114\tint sodium_munlock(void *const addr, const size_t len) __attribute__((nonnull));\n115\t\n116\t/* WARNING: sodium_malloc() and sodium_allocarray() are not general-purpose\n117\t * allocation functions.\n118\t *\n119\t * They return a pointer to a region filled with 0xd0 bytes, immediately\n120\t * followed by a guard page. As a result, accessing a single byte after the\n121\t * requested allocation size will intentionally trigger a segmentation fault.\n122\t *\n123\t * A canary and an additional guard page placed before the beginning of the\n124\t * region may also kill the process if a buffer underflow is detected.\n125\t *\n126\t * The memory layout is:\n127\t * [unprotected region size (read only)][guard page (no access)][unprotected pages\n128\t * (read/write)][guard page (no access)]\n129\t *\n130\t * The layout of the unprotected pages is:\n131\t * [optional padding][16-bytes canary][user region]\n132\t *\n133\t * Important limitations:\n134\t * - These functions are significantly slower than standard allocation functions.\n135\t * - Each allocation requires 3 or 4 additional pages.\n136\t * - The returned address will not be aligned if the allocation size is not\n137\t *   a multiple of the required alignment. For this reason, these functions\n138\t *   are designed to store data such as secret keys and messages.\n139\t *\n140\t * sodium_malloc() can be used to allocate any libsodium data structure.\n141\t *\n142\t * The crypto_generichash_state structure is packed and its length is\n143\t * either 357 or 361 bytes. When using sodium_malloc() to allocate a\n144\t * crypto_generichash_state structure, padding must be added to ensure\n145\t * proper alignment. Use crypto_generichash_statebytes() rather than sizeof():\n146\t *\n147\t *     state = sodium_malloc(crypto_generichash_statebytes());\n148\t */\n149\t\n150\tSODIUM_EXPORT\n151\tvoid *sodium_malloc(const size_t size) __attribute__((malloc));\n152\t\n153\tSODIUM_EXPORT\n154\tvoid *sodium_allocarray(size_t count, size_t size) __attribute__((malloc));\n155\t\n156\tSODIUM_EXPORT\n157\tvoid sodium_free(void *ptr);\n158\t\n159\tSODIUM_EXPORT\n160\tint sodium_mprotect_noaccess(void *ptr) __attribute__((nonnull));\n161\t\n162\tSODIUM_EXPORT\n163\tint sodium_mprotect_readonly(void *ptr) __attribute__((nonnull));\n164\t\n165\tSODIUM_EXPORT\n166\tint sodium_mprotect_readwrite(void *ptr) __attribute__((nonnull));\n167\t\n168\tSODIUM_EXPORT\n169\tint sodium_pad(size_t *padded_buflen_p, unsigned char *buf, size_t unpadded_buflen,\n170\t               size_t blocksize, size_t max_buflen) __attribute__((nonnull(2)));\n171\t\n172\tSODIUM_EXPORT\n173\tint sodium_unpad(size_t *unpadded_buflen_p, const unsigned char *buf, size_t padded_buflen,\n174\t                 size_t blocksize) __attribute__((nonnull(2)));\n175\t\n176\t/* -------- */\n177\t\n178\tint _sodium_alloc_init(void);\n179\t\n180\t#ifdef __cplusplus\n181\t}\n182\t#endif\n183\t\n184\t#endif\n185\t"}]},"parent_tool_use_id":"toolu_bdrk_01VeFjfnRmdqN6GMu9bf1WKC","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"3fba9079-12d0-46ff-8117-9a4fd157d7d6","timestamp":"2026-08-23T08:07:30.603Z"