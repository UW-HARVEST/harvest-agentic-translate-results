/ ---- ipcrypt_soft_implementation (8 slots) ----","+    #[repr(C)]","+    struct IpVt {","+        encrypt: Option<unsafe extern \"C\" fn(*mut u8, *const u8, *const u8)>,","+        decrypt: Option<unsafe extern \"C\" fn(*mut u8, *const u8, *const u8)>,","+        nd_encrypt: Option<unsafe extern \"C\" fn(*mut u8, *const u8, *const u8, *const u8)>,","+        nd_decrypt: Option<unsafe extern \"C\" fn(*mut u8, *const u8, *const u8)>,","+        ndx_encrypt: Option<unsafe extern \"C\" fn(*mut u8, *const u8, *const u8, *const u8)>,","+        ndx_decrypt: Option<unsafe extern \"C\" fn(*mut u8, *const u8, *const u8)>,","+        pfx_encrypt: Option<unsafe extern \"C\" fn(*mut u8, *const u8, *const u8)>,","+        pfx_decrypt: Option<unsafe extern \"C\" fn(*mut u8, *const u8, *const u8)>,","+    }","+    {","+        let c: *const IpVt = sym(c_lib(), \"ipcrypt_soft_implementation\");","+        let r: *const IpVt = sym(r_lib(), \"ipcrypt_soft_implementation\");","+        // IP shapes: IPv4-mapped, native IPv6, all-zero, all-ff","+        let mut ips: Vec<Vec<u8>> = vec![vec![0u8; 16], vec![0xffu8; 16]];","+        for _ in 0..8 {","+            let mut v = vec![0u8; 16];","+            v[10] = 0xff;","+            v[11] = 0xff;","+            let r4 = rng.bytes(4);","+            v[12..16].copy_from_slice(&r4);","+            ips.push(v); // IPv4-mapped","+            ips.push(rng.bytes(16)); // native IPv6","+        }","+        // keys: random, and the degenerate k[0..16] == k[16..32]","+        let mut keys: Vec<Vec<u8>> = Vec::new();","+        for klen in [16usize, 32] {","+            for _ in 0..4 {","+                keys.push(rng.bytes(klen));","+            }","+        }","+        {","+            let half = rng.bytes(16);","+            let mut deg = half.clone();","+            deg.extend_from_slice(&half);","+            keys.push(deg); // degenerate 32-byte key","+        }","+        let tweak = rng.bytes(16);","+        for ip in &ips {","+         