tern \"C\" fn() -> u64>(name);\n        let (a, b) = unsafe { (c(), r()) };\n        assert_eq!(a, b, \"{name}(): C returned {a}, Rust returned {b}\");\n    }\n    assert_eq!(ULL_FNS.len(), 19);\n}\n\n#[test]\nfn uchar_accessors_match() {\n    setup();\n    for name in UCHAR_FNS {\n        let (c, r) = pair::<unsafe extern \"C\" fn() -> u8>(name);\n        let (a, b) = unsafe { (c(), r()) };\n        assert_eq!(a, b, \"{name}(): C returned {a}, Rust returned {b}\");\n    }\n    assert_eq!(UCHAR_FNS.len(), 8);\n}\n\n#[test]\nfn cstr_accessors_match() {\n    setup();\n    for name in CSTR_FNS {\n        let (c, r) = pair::<unsafe extern \"C\" fn() -> *const std::ffi::c_char>(name);\n        unsafe {\n            let (a, b) = (c(), r());\n            assert!(!a.is_null(), \"{name}(): C returned NULL\");\n            assert!(!b.is_null(), \"{name}(): Rust returned NULL\");\n            let (a, b) = (\n                std::ffi::CStr::from_ptr(a).to_owned(),\n                std::ffi::CStr::from_ptr(b).to_owned(),\n            );\n            assert_eq!(a, b, \"{name}(): C {a:?} vs Rust {b:?}\");\n        }\n    }\n    assert_eq!(CSTR_FNS.len(), 20);\n}\n\n#[test]\nfn int_accessors_match() {\n    setup();\n    for name in INT_FNS {\n        let (c, r) = pair::<unsafe extern \"C\" fn() -> i32>(name);\n        let (a, b) = unsafe { (c(), r()) };\n        assert_eq!(a, b, \"{name}(): C returned {a}, Rust returned {b}\");\n    }\n    assert_eq!(INT_FNS.len(), 21);\n}\n\n/// `sodium_init()` is idempotent and must return 1 on every call after the\n/// first (both libraries were already initialised by `setup()`).\n#[test]\nfn sodium_init_is_idempotent() {\n    setup();\n    let (c, r) = pair::<unsafe extern \"C\" fn() -> i32>(\"sodium_init\");\n    for _ in 0..3 {\n        let (a, b) = unsafe { (c(), r()) };\n        assert_eq!(a, 1, \"C sodium_init repeat\");\n        assert_eq!(a, b, \"sodium_init(): C {a} vs Rust {b}\");\n    }\n}\n\n/// `randombytes_close()` with our custom implementation installed.\n#[test]\nfn randombytes_close_matches() {\n    setup();\n    let (c, r) = pair::<unsafe extern \"C\" fn() -> i32>(\"randombytes_close\");\n    let (a, b) = unsafe { (c(), r()) };\n    assert_eq!(a, b, \"randombytes_close(): C {a} vs Rust {b}\");\n}\n\n/// `randombytes_stir()` must not crash and must leave both RNGs usable.\n#[test]\nfn randombytes_stir_matches() {\n    setup();\n    let (c, r) = pair::<unsafe extern \"C\" fn()>(\"randombytes_stir\");\n    unsafe {\n        c();\n        r();\n    }\n    reset_rngs(7);\n    let (cb, rb) = pair::<unsafe extern \"C\" fn(*mut u8, usize)>(\"randombytes_buf\");\n    let mut x = [0u8; 32];\n    let mut y = [0u8; 32];\n    reset_rngs(7);\n    unsafe { cb(x.as_mut_ptr(), 32) };\n    reset_rngs(7);\n    unsafe { rb(y.as_mut_ptr(), 32) };\n    eq_bytes(\"randombytes_buf after stir\", &x, &y);\n}\n'''\nopen('tests/t01_constants.rs','w').write(body)\nprint(\"size_t:\",len(sz),\"ull:\",len(ull),\"uchar:\",len(uc),\"cstr:\",len(cch),\"int:\",len(ints))\nPY","description":"Generate constant accessor test"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1913,"cache_read_input_tokens":99555,"cache_creation":{"ephemeral_5m_input_tokens":1913,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"57398025-d6a7-490d-9a05-9864f0a95d46","timestamp":"2026-08-23T08:10:57.740Z"}
