{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_qkx3kh3byquvwcxtqhdrjw47vkv2bqvqdumuqtmupxushqnmuvaq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01EUD95S8ntUY19v2ECJhnWK","name":"Edit","input":{"replace_all":false,"file_path":"/local/home/scheschb/.harvest/work/harvest-work-djFIwa/translated_rust/tests/diff_g7.rs","old_string":"                assert!(region.base.is_null() && region.aligned.is_null());\n                assert_eq!(region.size, 0);\n            }\n        }\n    }\n}","new_string":"                assert!(region.base.is_null() && region.aligned.is_null());\n                assert_eq!(region.size, 0);\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Phase B — crypto_kdf_blake2b / crypto_kdf\n// ---------------------------------------------------------------------------\n\n#[track_caller]\nfn kdf_derive_buf(\n    ctx: &str,\n    sym: &str,\n    buflen: usize,\n    subkey_len: usize,\n    subkey_id: u64,\n    c8: &[u8],\n    key: &[u8; 32],\n) -> Obs {\n    assert_eq!(c8.len(), 8, \"crypto_kdf contexts are exactly 8 bytes\");\n    both::<FnKdfDerive, _>(ctx, sym, buflen, |f, p| unsafe {\n        (*f)(\n            p,\n            subkey_len,\n            subkey_id,\n            c8.as_ptr() as *const c_char,\n            key.as_ptr(),\n        )\n    })\n}\n\n#[track_caller]\nfn kdf_derive(\n    ctx: &str,\n    sym: &str,\n    subkey_len: usize,\n    subkey_id: u64,\n    c8: &[u8],\n    key: &[u8; 32],\n) -> Obs {\n    kdf_derive_buf(ctx, sym, subkey_len, subkey_len, subkey_id, c8, key)\n}\n\n/// Both the `blake2b` primitive and the generic forwarder must agree.\n#[track_caller]\nfn kdf_both_syms(\n    ctx: &str,\n    subkey_len: usize,\n    subkey_id: u64,\n    c8: &[u8],\n    key: &[u8; 32],\n) -> Obs {\n    let a = kdf_derive(\n        ctx,\n        \"crypto_kdf_blake2b_derive_from_key\",\n        subkey_len,\n        subkey_id,\n        c8,\n        key,\n    );\n    let b = kdf_derive(\n        ctx,\n        \"crypto_kdf_derive_from_key\",\n        subkey_len,\n        subkey_id,\n        c8,\n        key,\n    );\n    cmp_obs(&format!(\"{ctx}: blake2b vs generic forwarder\"), &a, &b);\n    a\n}\n\n/// configs: `crypto_kdf_blake2b_derive_from_key` reference values and the whole\n/// valid `subkey_len` range, plus the generic forwarder.\n#[test]\nfn cfg_kdf_blake2b_reference() {\n    let key = key32();\n\n    let o = kdf_both_syms(\"kdf id=0\", 32, 0, CTX8, &key);\n    eq_ret(\"kdf id=0\", 0, o.rc);\n    assert_anchor(\n        \"kdf id=0\",\n        &o.out,\n        \"4776a92ccf3f47eba292b4146f6ed0e98d8de89bfd0fc416cbc2d3635bcd6159\",\n    );\n\n    let o = kdf_both_syms(\"kdf id=1\", 32, 1, CTX8, &key);\n    assert_anchor(\n        \"kdf id=1\",\n        &o.out,\n        \"978b004a9fe7f01e1d6f517d09021ec20034306e3d8b98fb56fa3def62aac756\",\n    );\n\n    // 2^32 exercises the upper 32 bits of the little-endian STORE64_LE salt.\n    let o = kdf_both_syms(\"kdf id=2^32\", 32, 4294967296, CTX8, &key);\n    assert_anchor(\n        \"kdf id=2^32\",\n        &o.out,\n        \"fff615c28b706ea7194c645130c8bac562a947872997ffed74df93e50c888e6f\",\n    );\n\n    let o = kdf_both_syms(\"kdf id=UINT64_MAX\", 32, u64::MAX, CTX8, &key);\n    assert_anchor(\n        \"kdf id=UINT64_MAX\",\n        &o.out,\n        \"6e1734e5c52c8b7ce6a4256f6481be5e3b205b424ad2d4d31a79f081a4ff5b54\",\n    );\n\n    // ctx_padded construction: 8 zero bytes, 0xff bytes, another ASCII context\n    let o = kdf_both_syms(\"kdf ctx=zeros\", 32, 1, &[0u8; 8], &key);\n    assert_anchor(\n        \"kdf ctx=zeros\",\n        &o.out,\n        \"c450907d2477ae4040eee97cc1aacb165ea2f5ca22497aaf654c5378fef99826\",\n    );\n    let a = kdf_both_syms(\"kdf ctx=ff\", 32, 1, &[0xffu8; 8], &key);\n    let b = kdf_both_syms(\"kdf ctx=__test__\", 32, 1, b\"__test__\", &key);\n    assert_ne!(a.out, b.out);\n\n    // key variants (the key length is fixed at KEYBYTES = 32)\n    let z = kdf_both_syms(\"kdf key=zeros\", 32, 1, CTX8, &[0u8; 32]);\n    let f = kdf_both_syms(\"kdf key=ff\", 32, 1, CTX8, &[0xffu8; 32]);\n    assert_ne!(z.out, f.out);\n\n    // subkey_len across the whole valid range, both endpoints included\n    let mut seen: Vec<Vec<u8>> = Vec::new();\n    for len in 16usize..=64 {\n        let ctx = format!(\"kdf subkey_len={len}\");\n        let o = kdf_both_syms(&ctx, len, 1, CTX8, &key);\n        eq_ret(&ctx, 0, o.rc);\n        assert_eq!(o.out.len(), len);\n        assert_eq!(o.rng, 0, \"{ctx}: derive_from_key draws no randomness\");\n        assert!(!seen.contains(&o.out), \"{ctx}: collision\");\n        seen.push(o.out);\n    }\n}\n\n/// configs: many randomized `crypto_kdf` inputs (cheap entry point).\n#[test]\nfn cfg_kdf_blake2b_randomized() {\n    let mut rng = Rng::new(0xKDF_0001u32 as u64);\n    for i in 0..400 {\n        let len = 16 + rng.below(49);\n        let id = rng.next_u64();\n        let mut c8 = [0u8; 8];\n        rng.fill(&mut c8);\n        let mut key = [0u8; 32];\n        rng.fill(&mut key);\n        kdf_both_syms(&format!(\"kdf random #{i} len={len}\"), len, id, &c8, &key);\n    }\n}\n\n/// configs: `crypto_kdf_keygen` writes exactly KEYBYTES and draws exactly\n/// KEYBYTES random bytes.\n#[test]\nfn cfg_kdf_keygen() {\n    for (sym, n) in [\n        (\"crypto_kdf_keygen\", 32usize),\n        (\"crypto_kdf_hkdf_sha256_keygen\", 32),\n        (\"crypto_kdf_hkdf_sha512_keygen\", 64),\n    ] {\n        let o = both_m::<FnKeygen, _>(sym, sym, n, RngMode::Counter(0x1234_5678), |f, p| unsafe {\n            (*f)(p);\n            0\n        });\n        assert_eq!(o.rng, n as u64, \"{sym}: must draw exactly {n} random bytes\");\n        assert!(\n            o.out.iter().any(|&b| b != FILL),\n            \"{sym}: nothing was written\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Phase B — crypto_kdf_hkdf_sha256 / crypto_kdf_hkdf_sha512\n// ---------------------------------------------------------------------------\n\n#[track_caller]\nfn hkdf_extract(ctx: &str, suite: &str, prklen: usize, salt: Option<&[u8]>, ikm: &[u8]) -> Obs {\n    let sym = format!(\"crypto_kdf_hkdf_{suite}_extract\");\n    both::<FnHkdfExtract, _>(ctx, &sym, prklen, |f, p| unsafe {\n        let (sp, sl) = match salt {\n            Some(s) => (s.as_ptr(), s.len()),\n            None => (ptr::null(), 0usize),\n        };\n        (*f)(p, sp, sl, ikm.as_ptr(), ikm.len())\n    })\n}\n\n#[track_caller]\nfn hkdf_expand(\n    ctx: &str,\n    suite: &str,\n    outlen: usize,\n    info: Option<&[u8]>,\n    prk: &[u8],\n) -> Obs {\n    let sym = format!(\"crypto_kdf_hkdf_{suite}_expand\");\n    both::<FnHkdfExpand, _>(ctx, &sym, outlen, |f, p| unsafe {\n        let (ip, il) = match info {\n            Some(s) => (s.as_ptr() as *const c_char, s.len()),\n            None => (ptr::null(), 0usize),\n        };\n        (*f)(p, outlen, ip, il, prk.as_ptr())\n    })\n}\n\n/// Streaming extract. The observation buffer holds the PRK followed by the whole\n/// state as it was left by `_extract_final`, so the mandated\n/// `sodium_memzero(state, sizeof *state)` is itself compared.\n#[track_caller]\nfn hkdf_stream(\n    ctx: &str,\n    suite: &str,\n    prklen: usize,\n    statebytes: usize,\n    salt: &[u8],\n    chunks: &[&[u8]],\n) -> Obs {\n    install_rng();\n    let l = libs();\n    let (ic, ir) = l.pair::<FnHkdfFeed>(&format!(\"crypto_kdf_hkdf_{suite}_extract_init\"));\n    let (uc, ur) = l.pair::<FnHkdfFeed>(&format!(\"crypto_kdf_hkdf_{suite}_extract_update\"));\n    let (nc, nr) = l.pair::<FnHkdfFinal>(&format!(\"crypto_kdf_hkdf_{suite}_extract_final\"));\n    let _g = rng_lock();\n    set_rng_mode(RngMode::Counter(0x5EED_0007));\n    let run = |init: &FnHkdfFeed, upd: &FnHkdfFeed, fin: &FnHkdfFinal| -> Obs {\n        observe(ctx, prklen + statebytes, &mut |p| unsafe {\n            let mut st = vec![0u64; statebytes / 8];\n            let sp = st.as_mut_ptr() as *mut c_void;\n            // pre-poison the state so that `_final`'s memzero is observable\n            ptr::write_bytes(sp as *mut u8, 0x3C, statebytes);\n            let mut rc = (*init)(sp, salt.as_ptr(), salt.len());\n            for c in chunks {\n                rc |= (*upd)(sp, c.as_ptr(), c.len());\n            }\n            rc |= (*fin)(sp, p);\n            ptr::copy_nonoverlapping(sp as *const u8, p.add(prklen), statebytes);\n            rc\n        })\n    };\n    let a = run(&ic, &uc, &nc);\n    let b = run(&ir, &ur, &nr);\n    cmp_obs(ctx, &a, &b);\n    a\n}\n\n/// configs: `_extract` reference values, `salt = NULL` handling, and the\n/// HMAC key-folding boundary on `salt`.\n#[test]\nfn cfg_hkdf_sha256_extract() {\n    let o = hkdf_extract(\n        \"hkdf256 extract(salt,ikmikmikm)\",\n        \"sha256\",\n        32,\n        Some(b\"salt\"),\n        b\"ikmikmikm\",\n    );\n    eq_ret(\"hkdf256 extract\", 0, o.rc);\n    assert_eq!(o.errno, ERRNO_SENTINEL, \"extract performs no validation\");\n    assert_eq!(o.rng, 0);\n    assert_anchor(\n        \"hkdf256 extract(salt,ikmikmikm)\",\n        &o.out,\n        \"a43aef7d7379560ac486e8fcb98b017d290d999f452bdb92517b2f6192bc078b\",\n    );\n\n    // both lengths zero: HMAC of the empty message under the all-zero key\n    let z = hkdf_extract(\"hkdf256 extract(0,0)\", \"sha256\", 32, Some(b\"\"), b\"\");\n    assert_anchor(\n        \"hkdf256 extract(0,0)\",\n        &z.out,\n        \"b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad\",\n    );\n    // salt = NULL with salt_len = 0 must give the same answer\n    let n = hkdf_extract(\"hkdf256 extract(NULL,0)\", \"sha256\", 32, None, b\"\");\n    eq_bytes(\"hkdf256 salt=NULL vs salt=\\\"\\\"\", &z.out, &n.out);\n\n    // salt length sweep (crosses HMAC-SHA256's 64-byte block)\n    let mut rng = Rng::new(0x4B_DF_0256);\n    let mut seen: Vec<Vec<u8>> = Vec::new();\n    for sl in [0usize, 1, 31, 32, 33, 63, 64, 65, 200] {\n        let salt = vec![0x41u8; sl];\n        let ctx = format!(\"hkdf256 extract salt_len={sl}\");\n        let o = hkdf_extract(&ctx, \"sha256\", 32, Some(&salt), b\"ikm\");\n        eq_ret(&ctx, 0, o.rc);\n        assert!(!seen.contains(&o.out), \"{ctx}: collision\");\n        seen.push(o.out);\n    }\n    // ikm length sweep (crosses SHA-256's padding boundary)\n    for il in [0usize, 1, 55, 56, 63, 64, 65, 200, 1000] {\n        let ikm = vec![0x42u8; il];\n        let ctx = format!(\"hkdf256 extract ikm_len={il}\");\n        let o = hkdf_extract(&ctx, \"sha256\", 32, Some(b\"salt\"), &ikm);\n        eq_ret(&ctx, 0, o.rc);\n    }\n    // many randomized inputs\n    for i in 0..300 {\n        let sl = rng.below(300);\n        let il = rng.below(300);\n        let salt = rng.bytes(sl);\n        let ikm = rng.bytes(il);\n        hkdf_extract(\n            &format!(\"hkdf256 extract random #{i}\"),\n            \"sha256\",\n            32,\n            Some(&salt),\n            &ikm,\n        );\n    }\n}\n\n/// configs: streaming `_extract_init` / `_extract_update` x N / `_extract_final`\n/// must agree with the one-shot `_extract` for the same total ikm, and `_final`\n/// must zero all 208 state bytes.\n#[test]\nfn cfg_hkdf_sha256_streaming() {\n    let one = hkdf_extract(\n        \"hkdf256 one-shot\",\n        \"sha256\",\n        32,\n        Some(b\"salt\"),\n        b\"ikmikmikm\",\n    );\n    let s = hkdf_stream(\n        \"hkdf256 stream 3x3\",\n        \"sha256\",\n        32,\n        208,\n        b\"salt\",\n        &[b\"ikm\", b\"ikm\", b\"ikm\"],\n    );\n    eq_ret(\"hkdf256 stream 3x3\", 0, s.rc);\n    eq_bytes(\"hkdf256 one-shot vs 3x3 stream\", &one.out, &s.out[..32]);\n    assert_zeroed(\"hkdf256 _final must zero the state\", &s.out[32..]);\n\n    // 0 updates == empty ikm; 1x9 and 9x1 == the same total\n    let empty = hkdf_extract(\"hkdf256 empty ikm\", \"sha256\", 32, Some(b\"salt\"), b\"\");\n    let s0 = hkdf_stream(\"hkdf256 stream 0 updates\", \"sha256\", 32, 208, b\"salt\", &[]);\n    eq_bytes(\"hkdf256 0 updates\", &empty.out, &s0.out[..32]);\n    assert_zeroed(\"hkdf256 state after 0 updates\", &s0.out[32..]);\n\n    let s1 = hkdf_stream(\n        \"hkdf256 stream 1x9\",\n        \"sha256\",\n        32,\n        208,\n        b\"salt\",\n        &[b\"ikmikmikm\"],\n    );\n    eq_bytes(\"hkdf256 1x9\", &one.out, &s1.out[..32]);\n    let nine: Vec<&[u8]> = vec![b\"i\", b\"k\", b\"m\", b\"i\", b\"k\", b\"m\", b\"i\", b\"k\", b\"m\"];\n    let s9 = hkdf_stream(\"hkdf256 stream 9x1\", \"sha256\", 32, 208, b\"salt\", &nine);\n    eq_bytes(\"hkdf256 9x1\", &one.out, &s9.out[..32]);\n\n    // a 1000-byte ikm split three different ways\n    let big = vec![0x37u8; 1000];\n    let oneshot = hkdf_extract(\"hkdf256 ikm=1000\", \"sha256\", 32, Some(b\"salt\"), &big);\n    for (a, b) in [(1usize, 999usize), (500, 500), (999, 1)] {\n        let ctx = format!(\"hkdf256 stream {a}+{b}\");\n        let s = hkdf_stream(&ctx, \"sha256\", 32, 208, b\"salt\", &[&big[..a], &big[a..]]);\n        eq_bytes(&ctx, &oneshot.out, &s.out[..32]);\n        assert_zeroed(&format!(\"{ctx}: state zeroed\"), &s.out[32..]);\n    }\n\n    // randomized splits\n    let mut rng = Rng::new(0x57_2E_A11);\n    for i in 0..100 {\n        let total = rng.below(400);\n        let ikm = rng.bytes(total);\n        let salt = rng.bytes(rng.below(80));\n        let nsplit = 1 + rng.below(5);\n        let mut bounds: Vec<usize> = (0..nsplit).map(|_| rng.below(total + 1)).collect();\n        bounds.push(0);\n        bounds.push(total);\n        bounds.sort_unstable();\n        let chunks: Vec<&[u8]> = bounds.windows(2).map(|w| &ikm[w[0]..w[1]]).collect();\n        let ctx = format!(\"hkdf256 random split #{i}\");\n        let oneshot = hkdf_extract(&ctx, \"sha256\", 32, Some(&salt), &ikm);\n        let s = hkdf_stream(&ctx, \"sha256\", 32, 208, &salt, &chunks);\n        eq_bytes(&ctx, &oneshot.out, &s.out[..32]);\n    }\n}\n\n/// configs: `_expand` output-length branches (`left = out_len & 31` is the\n/// branch), the counter increment and `T(i-1)` chaining, and BYTES_MAX.\n#[test]\nfn cfg_hkdf_sha256_expand() {\n    let prk = hkdf_extract(\"prk\", \"sha256\", 32, Some(b\"salt\"), b\"ikm\").out;\n\n    // out_len = 0 -> returns 0 and writes nothing\n    let o = hkdf_expand(\"hkdf256 expand len=0\", \"sha256\", 0, Some(b\"ctx\"), &prk);\n    eq_ret(\"hkdf256 expand len=0\", 0, o.rc);\n    assert!(o.out.is_empty());\n\n    // the biggest output is a prefix-extension family of all shorter ones\n    let big = hkdf_expand(\"hkdf256 expand len=4096\", \"sha256\", 4096, Some(b\"ctx\"), &prk);\n    eq_ret(\"hkdf256 expand len=4096\", 0, big.rc);\n    for outlen in [1usize, 31, 32, 33, 63, 64, 65, 128, 1000, 4096] {\n        let ctx = format!(\"hkdf256 expand len={outlen}\");\n        let o = hkdf_expand(&ctx, \"sha256\", outlen, Some(b\"ctx\"), &prk);\n        eq_ret(&ctx, 0, o.rc);\n        assert_eq!(o.rng, 0, \"{ctx}: expand draws no randomness\");\n        assert_eq!(o.errno, ERRNO_SENTINEL, \"{ctx}: errno touched\");\n        // the block-aligned prefix always matches; the tail block is a\n        // different HMAC because the counter differs, so only compare the\n        // full 32-byte blocks.\n        let full = outlen & !31;\n        eq_bytes(&ctx, &big.out[..full], &o.out[..full]);\n    }\n\n    // out_len = BYTES_MAX = 255 * 32: the counter reaches 255 and must not wrap\n    let m = hkdf_expand(\"hkdf256 expand BYTES_MAX\", \"sha256\", 8160, Some(b\"ctx\"), &prk);\n    eq_ret(\"hkdf256 expand BYTES_MAX\", 0, m.rc);\n    eq_bytes(\"hkdf256 expand BYTES_MAX prefix\", &big.out[..4096], &m.out[..4096]);\n\n    // ctx length sweep, and ctx = NULL with ctx_len = 0\n    let mut seen: Vec<Vec<u8>> = Vec::new();\n    for cl in [0usize, 1, 3, 32, 64, 200] {\n        let info = vec![0x55u8; cl];\n        let ctx = format!(\"hkdf256 expand ctx_len={cl}\");\n        let o = hkdf_expand(&ctx, \"sha256\", 32, Some(&info), &prk);\n        eq_ret(&ctx, 0, o.rc);\n        assert!(!seen.contains(&o.out), \"{ctx}: collision\");\n        seen.push(o.out);\n    }\n    let a = hkdf_expand(\"hkdf256 expand ctx=NULL\", \"sha256\", 32, None, &prk);\n    let b = hkdf_expand(\"hkdf256 expand ctx=\\\"\\\"\", \"sha256\", 32, Some(b\"\"), &prk);\n    eq_bytes(\"hkdf256 ctx=NULL vs ctx=\\\"\\\"\", &a.out, &b.out);\n\n    // prk variants (fixed length KEYBYTES = 32)\n    let z = hkdf_expand(\"hkdf256 expand prk=0\", \"sha256\", 64, Some(b\"ctx\"), &[0u8; 32]);\n    let f = hkdf_expand(\"hkdf256 expand prk=ff\", \"sha256\", 64, Some(b\"ctx\"), &[0xffu8; 32]);\n    assert_ne!(z.out, f.out);\n\n    // randomized\n    let mut rng = Rng::new(0xE_1A_0256);\n    for i in 0..200 {\n        let outlen = rng.below(600);\n        let cl = rng.below(120);\n        let info = rng.bytes(cl);\n        let mut k = [0u8; 32];\n        rng.fill(&mut k);\n        hkdf_expand(\n            &format!(\"hkdf256 expand random #{i} len={outlen}\"),\n            \"sha256\",\n            outlen,\n            Some(&info),\n            &k,\n        );\n    }\n}\n\n/// configs: the sha512 suite. HMAC-SHA512's block is 128 bytes, so the salt\n/// key-folding boundary is at 128, and SHA-512's padding boundary is 112/128.\n#[test]\nfn cfg_hkdf_sha512_extract_and_stream() {\n    let o = hkdf_extract(\n        \"hkdf512 extract(salt,ikm)\",\n        \"sha512\",\n        64,\n        Some(b\"salt\"),\n        b\"ikm\",\n    );\n    eq_ret(\"hkdf512 extract\", 0, o.rc);\n    assert_anchor(\n        \"hkdf512 extract(salt,ikm)\",\n        &o.out,\n        \"56cc15664b2dcaa57ae910751a1c03a80768a7abb0d4bf491d99d7949bc2c3a7\\\n         7d423e8b8c91379f35b9966744d12fbb4440f42bbaa0159fc78cd635983cb506\",\n    );\n\n    let z = hkdf_extract(\"hkdf512 extract(\\\"\\\",0)\", \"sha512\", 64, Some(b\"\"), b\"\");\n    let n = hkdf_extract(\"hkdf512 extract(NULL,0)\", \"sha512\", 64, None, b\"\");\n    eq_bytes(\"hkdf512 salt=NULL vs salt=\\\"\\\"\", &z.out, &n.out);\n\n    let mut seen: Vec<Vec<u8>> = Vec::new();\n    for sl in [0usize, 1, 31, 32, 63, 64, 65, 127, 128, 129, 200] {\n        let salt = vec![0x41u8; sl];\n        let ctx = format!(\"hkdf512 extract salt_len={sl}\");\n        let o = hkdf_extract(&ctx, \"sha512\", 64, Some(&salt), b\"ikm\");\n        eq_ret(&ctx, 0, o.rc);\n        assert!(!seen.contains(&o.out), \"{ctx}: collision\");\n        seen.push(o.out);\n    }\n    for il in [0usize, 1, 111, 112, 127, 128, 129, 200, 1000] {\n        let ikm = vec![0x42u8; il];\n        let ctx = format!(\"hkdf512 extract ikm_len={il}\");\n        let o = hkdf_extract(&ctx, \"sha512\", 64, Some(b\"salt\"), &ikm);\n        eq_ret(&ctx, 0, o.rc);\n    }\n\n    // one-shot vs streaming, and `_final` must zero all 416 state bytes\n    let one = hkdf_extract(\n        \"hkdf512 one-shot\",\n        \"sha512\",\n        64,\n        Some(b\"salt\"),\n        b\"ikmikmikm\",\n    );\n    let splits: [Vec<&[u8]>; 3] = [\n        vec![b\"ikmikmikm\"],\n        vec![b\"ikm\", b\"ikm\", b\"ikm\"],\n        vec![b\"i\", b\"k\", b\"m\", b\"i\", b\"k\", b\"m\", b\"i\", b\"k\", b\"m\"],\n    ];\n    for (i, chunks) in splits.iter().enumerate() {\n        let ctx = format!(\"hkdf512 stream split #{i}\");\n        let s = hkdf_stream(&ctx, \"sha512\", 64, 416, b\"salt\", chunks);\n        eq_ret(&ctx, 0, s.rc);\n        eq_bytes(&ctx, &one.out, &s.out[..64]);\n        assert_zeroed(&format!(\"{ctx}: _final must zero the state\"), &s.out[64..]);\n    }\n    let empty = hkdf_extract(\"hkdf512 empty ikm\", \"sha512\", 64, Some(b\"salt\"), b\"\");\n    let s0 = hkdf_stream(\"hkdf512 stream 0 updates\", \"sha512\", 64, 416, b\"salt\", &[]);\n    eq_bytes(\"hkdf512 0 updates\", &empty.out, &s0.out[..64]);\n\n    let big = vec![0x37u8; 1000];\n    let oneshot = hkdf_extract(\"hkdf512 ikm=1000\", \"sha512\", 64, Some(b\"salt\"), &big);\n    for (a, b) in [(1usize, 999usize), (500, 500), (999, 1)] {\n        let ctx = format!(\"hkdf512 stream {a}+{b}\");\n        let s = hkdf_stream(&ctx, \"sha512\", 64, 416, b\"salt\", &[&big[..a], &big[a..]]);\n        eq_bytes(&ctx, &oneshot.out, &s.out[..64]);\n    }\n\n    let mut rng = Rng::new(0x57_2E_512);\n    for i in 0..100 {\n        let sl = rng.below(300);\n        let il = rng.below(300);\n        let salt = rng.bytes(sl);\n        let ikm = rng.bytes(il);\n        let ctx = format!(\"hkdf512 random #{i}\");\n        let oneshot = hkdf_extract(&ctx, \"sha512\", 64, Some(&salt), &ikm);\n        let a = 1 + rng.below(il.max(1));\n        let chunks: Vec<&[u8]> = if il == 0 {\n            vec![]\n        } else {\n            vec![&ikm[..a.min(il)], &ikm[a.min(il)..]]\n        };\n        let s = hkdf_stream(&ctx, \"sha512\", 64, 416, &salt, &chunks);\n        eq_bytes(&ctx, &oneshot.out, &s.out[..64]);\n    }\n}\n\n/// configs: sha512 `_expand` output-length branches (mask is `out_len & 63`)\n/// and BYTES_MAX = 255 * 64.\n#[test]\nfn cfg_hkdf_sha512_expand() {\n    let prk = hkdf_extract(\"prk512\", \"sha512\", 64, Some(b\"salt\"), b\"ikm\").out;\n    let o = hkdf_expand(\"hkdf512 expand len=0\", \"sha512\", 0, Some(b\"ctx\"), &prk);\n    eq_ret(\"hkdf512 expand len=0\", 0, o.rc);\n    assert!(o.out.is_empty());\n\n    let big = hkdf_expand(\"hkdf512 expand len=1000\", \"sha512\", 1000, Some(b\"ctx\"), &prk);\n    eq_ret(\"hkdf512 expand len=1000\", 0, big.rc);\n    for outlen in [1usize, 63, 64, 65, 127, 128, 129, 256, 1000] {\n        let ctx = format!(\"hkdf512 expand len={outlen}\");\n        let o = hkdf_expand(&ctx, \"sha512\", outlen, Some(b\"ctx\"), &prk);\n        eq_ret(&ctx, 0, o.rc);\n        let full = outlen & !63;\n        eq_bytes(&ctx, &big.out[..full], &o.out[..full]);\n    }\n    let m = hkdf_expand(\"hkdf512 expand BYTES_MAX\", \"sha512\", 16320, Some(b\"ctx\"), &prk);\n    eq_ret(\"hkdf512 expand BYTES_MAX\", 0, m.rc);\n    eq_bytes(\"hkdf512 BYTES_MAX prefix\", &big.out[..960], &m.out[..960]);\n\n    let mut seen: Vec<Vec<u8>> = Vec::new();\n    for cl in [0usize, 1, 3, 64, 128, 200] {\n        let info = vec![0x55u8; cl];\n        let ctx = format!(\"hkdf512 expand ctx_len={cl}\");\n        let o = hkdf_expand(&ctx, \"sha512\", 64, Some(&info), &prk);\n        eq_ret(&ctx, 0, o.rc);\n        assert!(!seen.contains(&o.out), \"{ctx}: collision\");\n        seen.push(o.out);\n    }\n    let a = hkdf_expand(\"hkdf512 expand ctx=NULL\", \"sha512\", 64, None, &prk);\n    let b = hkdf_expand(\"hkdf512 expand ctx=\\\"\\\"\", \"sha512\", 64, Some(b\"\"), &prk);\n    eq_bytes(\"hkdf512 ctx=NULL vs ctx=\\\"\\\"\", &a.out, &b.out);\n\n    let mut rng = Rng::new(0xE_1A_0512);\n    for i in 0..200 {\n        let outlen = rng.below(600);\n        let cl = rng.below(200);\n        let info = rng.bytes(cl);\n        let mut k = [0u8; 64];\n        rng.fill(&mut k);\n        hkdf_expand(\n            &format!(\"hkdf512 expand random #{i} len={outlen}\"),\n            \"sha512\",\n            outlen,\n            Some(&info),\n            &k,\n        );\n    }\n}\n\n/// configs: RFC 5869 conformance. libsodium's `_expand` uses `ctx` where the RFC\n/// says `info`, so the published vectors apply directly. (Only the SHA-256\n/// vectors are relevant; RFC 5869 has no SHA-512 vectors.)\n#[test]\nfn cfg_hkdf_rfc5869_vectors() {\n    struct V {\n        name: &'static str,\n        ikm: &'static str,\n        salt: &'static str,\n        info: &'static str,\n        len: usize,\n        prk: &'static str,\n        okm: &'static str,\n    }\n    let vs = [\n        V {\n            name: \"RFC 5869 test case 1\",\n            ikm: \"0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b\",\n            salt: \"000102030405060708090a0b0c\",\n            info: \"f0f1f2f3f4f5f6f7f8f9\",\n            len: 42,\n            prk: \"077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5\",\n            okm: \"3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf\\\n                  34007208d5b887185865\",\n        },\n        V {\n            name: \"RFC 5869 test case 2 (long inputs)\",\n            ikm: \"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f\\\n                  202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f\\\n                  404142434445464748494a4b4c4d4e4f\",\n            salt: \"606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f\\\n                   808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f\\\n                   a0a1a2a3a4a5a6a7a8a9aaabacadaeaf\",\n            info: \"b0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecf\\\n                   d0d1d2d3d4d5d6d7d8d9dadbdcdddedfe0e1e2e3e4e5e6e7e8e9eaebecedeeef\\\n                   f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff\",\n            len: 82,\n            prk: \"06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244\",\n            okm: \"b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c\\\n                  59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71\\\n                  cc30c58179ec3e87c14c01d5c1f3434f1d87\",\n        },\n        V {\n            name: \"RFC 5869 test case 3 (zero-length salt and info)\",\n            ikm: \"0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b\",\n            salt: \"\",\n            info: \"\",\n            len: 42,\n            prk: \"19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04\",\n            okm: \"8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d\\\n                  9d201395faa4b61a96c8\",\n        },\n    ];\n    for v in vs {\n        let ikm = unhex(v.ikm);\n        let salt = unhex(v.salt);\n        let info = unhex(v.info);\n        let e = hkdf_extract(v.name, \"sha256\", 32, Some(&salt), &ikm);\n        eq_ret(v.name, 0, e.rc);\n        assert_anchor(&format!(\"{}: PRK\", v.name), &e.out, v.prk);\n        let x = hkdf_expand(v.name, \"sha256\", v.len, Some(&info), &e.out);\n        eq_ret(v.name, 0, x.rc);\n        assert_anchor(&format!(\"{}: OKM\", v.name), &x.out, v.okm);\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":436,"cache_read_input_tokens":296249,"cache_creation":{"ephemeral_5m_input_tokens":436,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01SaYbLR3rKqJqm44YiZHA4q","session_id":"9da2999f-c365-4559-ba2a-18fcf47e9927","uuid":"ece98413-89bd-4d8a-9f24-4925f2d839eb","timestamp":"2026-08-23T09:14:35.430Z","subagent_type":"general-purpose","task_description":"Write differential tests G7"}
