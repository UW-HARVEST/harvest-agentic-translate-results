{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RuANM552oDJwhkSVs3V1mK","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-work-rAO86K/translated_rust/tests/t06_internal_exports.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"c84a4a20-2aff-4696-8582-7b10596fd529","timestamp":"2026-08-23T08:35:21.113Z","tool_use_result":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-rAO86K/translated_rust/tests/t06_internal_exports.rs","oldString":"        let inp = rng.bytes(rng.below(500));","newString":"        let n = rng.below(500);\n        let inp = rng.bytes(n);","originalFile":"//! Phase B/D — the 121 `_`-prefixed **internal-but-exported** symbols.\n//!\n//! `nm -D` on the C `.so` exports 890 symbols, of which 121 are the `_sodium_*`\n//! / `_crypto_*` internals (`_sodium_softaes_*`, `_sodium_keccak1600_ref_*`,\n//! `_sodium_shake*_ref*`, `_sodium_turboshake*_ref*`, `_sodium_mlkem768_ref_*`,\n//! `_crypto_*_pick_best_implementation`, ...). They are part of the exported ABI\n//! and are exactly the \"lowest-level entry points\" that per-wrapper tests miss,\n//! so they get their own differential coverage here.\n//!\n//! This file covers: softaes (9), keccak1600 ref (5), shake/turboshake ref (20),\n//! mlkem768 ref (5), the 10 `_pick_best_implementation` selectors, the exported\n//! implementation v-tables (9 data symbols), `_sodium_alloc_init`,\n//! `_sodium_runtime_get_cpu_features`, `_crypto_sign_ed25519_detached` /\n//! `_verify_detached`.\n\nmod common;\nuse common::*;\n\n// ---------------------------------------------------------------------------\n// softaes — the AES round primitives underlying AEGIS and ipcrypt.\n//\n// This build compiles the **SRM-1R bitsliced** round (`FAVOR_PERFORMANCE` is\n// only auto-defined for `__wasm__`, and CMake passes no `-D`), NOT the\n// 1024-entry `_aes_lut` variant.\n// ---------------------------------------------------------------------------\n\n#[repr(C)]\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\nstruct SoftAesBlock {\n    w0: u32,\n    w1: u32,\n    w2: u32,\n    w3: u32,\n}\n\nimpl SoftAesBlock {\n    fn from_bytes(b: &[u8]) -> Self {\n        SoftAesBlock {\n            w0: u32::from_le_bytes(b[0..4].try_into().unwrap()),\n            w1: u32::from_le_bytes(b[4..8].try_into().unwrap()),\n            w2: u32::from_le_bytes(b[8..12].try_into().unwrap()),\n            w3: u32::from_le_bytes(b[12..16].try_into().unwrap()),\n        }\n    }\n    fn to_bytes(self) -> [u8; 16] {\n        let mut o = [0u8; 16];\n        o[0..4].copy_from_slice(&self.w0.to_le_bytes());\n        o[4..8].copy_from_slice(&self.w1.to_le_bytes());\n        o[8..12].copy_from_slice(&self.w2.to_le_bytes());\n        o[12..16].copy_from_slice(&self.w3.to_le_bytes());\n        o\n    }\n    fn xor(self, o: Self) -> Self {\n        SoftAesBlock {\n            w0: self.w0 ^ o.w0,\n            w1: self.w1 ^ o.w1,\n            w2: self.w2 ^ o.w2,\n            w3: self.w3 ^ o.w3,\n        }\n    }\n}\n\ntype AesRound = unsafe extern \"C\" fn(SoftAesBlock, SoftAesBlock) -> SoftAesBlock;\ntype AesInvMix = unsafe extern \"C\" fn(SoftAesBlock) -> SoftAesBlock;\ntype AesExpand = unsafe extern \"C\" fn(*mut SoftAesBlock, *const u8);\ntype AesInvert = unsafe extern \"C\" fn(*mut SoftAesBlock);\n\n/// `_sodium_softaes_block_encrypt` / `_decrypt` / `_encryptlast` / `_decryptlast`\n/// over many random (block, round-key) pairs plus every degenerate shape.\n#[test]\nfn softaes_round_functions() {\n    setup();\n    let mut rng = Rng::new(0xAE50);\n    let mut blocks: Vec<SoftAesBlock> = vec![\n        SoftAesBlock::default(),\n        SoftAesBlock { w0: !0, w1: !0, w2: !0, w3: !0 },\n        SoftAesBlock { w0: 1, w1: 0, w2: 0, w3: 0 },\n        SoftAesBlock { w0: 0, w1: 0, w2: 0, w3: 0x8000_0000 },\n    ];\n    // one block per single set byte, to exercise every S-box input position\n    for i in 0..16 {\n        let mut b = [0u8; 16];\n        b[i] = 0xff;\n        blocks.push(SoftAesBlock::from_bytes(&b));\n    }\n    // every possible value in byte 0\n    for v in 0..=255u8 {\n        let mut b = [0u8; 16];\n        b[0] = v;\n        blocks.push(SoftAesBlock::from_bytes(&b));\n    }\n    for _ in 0..200 {\n        blocks.push(SoftAesBlock::from_bytes(&rng.bytes(16)));\n    }\n    let rks: Vec<SoftAesBlock> = std::iter::once(SoftAesBlock::default())\n        .chain(std::iter::once(SoftAesBlock { w0: !0, w1: !0, w2: !0, w3: !0 }))\n        .chain((0..8).map(|_| SoftAesBlock::from_bytes(&rng.bytes(16))))\n        .collect();\n\n    for name in [\n        \"_sodium_softaes_block_encrypt\",\n        \"_sodium_softaes_block_decrypt\",\n        \"_sodium_softaes_block_encryptlast\",\n        \"_sodium_softaes_block_decryptlast\",\n    ] {\n        let (c, r) = pair::<AesRound>(name);\n        for b in &blocks {\n            for rk in &rks {\n                let (a, d) = unsafe { (c(*b, *rk), r(*b, *rk)) };\n                assert_eq!(\n                    a, d,\n                    \"{name}(block={}, rk={}) C={a:?} Rust={d:?}\",\n                    hex(&b.to_bytes()),\n                    hex(&rk.to_bytes())\n                );\n            }\n        }\n    }\n\n    let (c, r) = pair::<AesInvMix>(\"_sodium_softaes_inv_mix_columns\");\n    for b in &blocks {\n        let (a, d) = unsafe { (c(*b), r(*b)) };\n        assert_eq!(\n            a, d,\n            \"_sodium_softaes_inv_mix_columns({}) C={a:?} Rust={d:?}\",\n            hex(&b.to_bytes())\n        );\n    }\n}\n\n/// `_sodium_softaes_expand_key128/256` and `_invert_key_schedule128/256`.\n#[test]\nfn softaes_key_schedules() {\n    setup();\n    let mut rng = Rng::new(0xAE51);\n    for (expand, invert, nk, nr) in [\n        (\n            \"_sodium_softaes_expand_key128\",\n            \"_sodium_softaes_invert_key_schedule128\",\n            16usize,\n            11usize,\n        ),\n        (\n            \"_sodium_softaes_expand_key256\",\n            \"_sodium_softaes_invert_key_schedule256\",\n            32,\n            15,\n        ),\n    ] {\n        let (ce, re) = pair::<AesExpand>(expand);\n        let (ci, ri) = pair::<AesInvert>(invert);\n        let mut keys: Vec<Vec<u8>> = vec![vec![0u8; nk], vec![0xffu8; nk]];\n        for i in 0..nk {\n            let mut k = vec![0u8; nk];\n            k[i] = 0xff;\n            keys.push(k);\n        }\n        for _ in 0..64 {\n            keys.push(rng.bytes(nk));\n        }\n        for k in &keys {\n            let mut a = vec![SoftAesBlock::default(); nr];\n            let mut b = vec![SoftAesBlock::default(); nr];\n            unsafe {\n                ce(a.as_mut_ptr(), k.as_ptr());\n                re(b.as_mut_ptr(), k.as_ptr());\n            }\n            let fa: Vec<u8> = a.iter().flat_map(|x| x.to_bytes()).collect();\n            let fb: Vec<u8> = b.iter().flat_map(|x| x.to_bytes()).collect();\n            eq_bytes(&format!(\"{expand}(key={})\", hex(k)), &fa, &fb);\n\n            // now invert the (identical) schedules and compare again\n            let mut a2 = a.clone();\n            let mut b2 = b.clone();\n            unsafe {\n                ci(a2.as_mut_ptr());\n                ri(b2.as_mut_ptr());\n            }\n            let fa: Vec<u8> = a2.iter().flat_map(|x| x.to_bytes()).collect();\n            let fb: Vec<u8> = b2.iter().flat_map(|x| x.to_bytes()).collect();\n            eq_bytes(&format!(\"{invert}(key={})\", hex(k)), &fa, &fb);\n        }\n    }\n}\n\n/// Compose the primitives into full AES-128 / AES-256 ECB encrypt+decrypt and\n/// require the two libraries to agree, plus a real round trip. This is what\n/// catches a wrong *round order* even when each round function is right.\n#[test]\nfn softaes_full_block_cipher_roundtrip() {\n    setup();\n    let mut rng = Rng::new(0xAE52);\n    for (expand, invert, nk, nr) in [\n        (\n            \"_sodium_softaes_expand_key128\",\n            \"_sodium_softaes_invert_key_schedule128\",\n            16usize,\n            11usize,\n        ),\n        (\n            \"_sodium_softaes_expand_key256\",\n            \"_sodium_softaes_invert_key_schedule256\",\n            32,\n            15,\n        ),\n    ] {\n        let libs = [\n            (\n                sym::<AesExpand>(c_lib(), expand),\n                sym::<AesInvert>(c_lib(), invert),\n                sym::<AesRound>(c_lib(), \"_sodium_softaes_block_encrypt\"),\n                sym::<AesRound>(c_lib(), \"_sodium_softaes_block_encryptlast\"),\n                sym::<AesRound>(c_lib(), \"_sodium_softaes_block_decrypt\"),\n                sym::<AesRound>(c_lib(), \"_sodium_softaes_block_decryptlast\"),\n            ),\n            (\n                sym::<AesExpand>(r_lib(), expand),\n                sym::<AesInvert>(r_lib(), invert),\n                sym::<AesRound>(r_lib(), \"_sodium_softaes_block_encrypt\"),\n                sym::<AesRound>(r_lib(), \"_sodium_softaes_block_encryptlast\"),\n                sym::<AesRound>(r_lib(), \"_sodium_softaes_block_decrypt\"),\n                sym::<AesRound>(r_lib(), \"_sodium_softaes_block_decryptlast\"),\n            ),\n        ];\n        for _ in 0..64 {\n            let key = rng.bytes(nk);\n            let pt = rng.bytes(16);\n            let mut cts = [Vec::new(), Vec::new()];\n            let mut pts = [Vec::new(), Vec::new()];\n            for (which, (exp, inv, enc, enclast, dec, declast)) in libs.iter().enumerate() {\n                let mut rk = vec![SoftAesBlock::default(); nr];\n                unsafe { exp(rk.as_mut_ptr(), key.as_ptr()) };\n                // encrypt: AddRoundKey, nr-2 full rounds, final round\n                let mut st = SoftAesBlock::from_bytes(&pt).xor(rk[0]);\n                for i in 1..nr - 1 {\n                    st = unsafe { enc(st, rk[i]) };\n                }\n                st = unsafe { enclast(st, rk[nr - 1]) };\n                cts[which] = st.to_bytes().to_vec();\n\n                // decrypt with the inverted schedule\n                let mut drk = rk.clone();\n                unsafe { inv(drk.as_mut_ptr()) };\n                let mut st = SoftAesBlock::from_bytes(&cts[which]).xor(drk[nr - 1]);\n                for i in (1..nr - 1).rev() {\n                    st = unsafe { dec(st, drk[i]) };\n                }\n                st = unsafe { declast(st, drk[0]) };\n                pts[which] = st.to_bytes().to_vec();\n            }\n            eq_bytes(&format!(\"softaes ECB encrypt ({expand})\"), &cts[0], &cts[1]);\n            eq_bytes(&format!(\"softaes ECB decrypt ({expand})\"), &pts[0], &pts[1]);\n            assert_eq!(pts[0], pt, \"softaes ECB round trip ({expand})\");\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// _sodium_keccak1600_ref_* — the same sponge as the public wrappers\n// ---------------------------------------------------------------------------\n\ntype KcInit = unsafe extern \"C\" fn(*mut u8);\ntype KcXor = unsafe extern \"C\" fn(*mut u8, *const u8, usize, usize);\ntype KcExtract = unsafe extern \"C\" fn(*const u8, *mut u8, usize, usize);\ntype KcPermute = unsafe extern \"C\" fn(*mut u8);\n\n#[test]\nfn keccak1600_ref_internal_exports() {\n    setup();\n    let mut rng = Rng::new(0xAE60);\n    let (ci, ri) = pair::<KcInit>(\"_sodium_keccak1600_ref_init\");\n    let (cx, rx) = pair::<KcXor>(\"_sodium_keccak1600_ref_xor_bytes\");\n    let (ce, re) = pair::<KcExtract>(\"_sodium_keccak1600_ref_extract_bytes\");\n    let (c24, r24) = pair::<KcPermute>(\"_sodium_keccak1600_ref_permute_24\");\n    let (c12, r12) = pair::<KcPermute>(\"_sodium_keccak1600_ref_permute_12\");\n\n    for iter in 0..150 {\n        let ops: Vec<(u32, usize, usize)> = (0..rng.range(1, 10))\n            .map(|_| {\n                let op = rng.below(4) as u32;\n                let offset = rng.below(190);\n                let length = rng.below(200 - offset);\n                (op, offset, length)\n            })\n            .collect();\n        let data = rng.bytes(256);\n        let mut finals = [canary(200), canary(200)];\n        for (which, (init, xorb, ext, p24, p12)) in\n            [(ci, cx, ce, c24, c12), (ri, rx, re, r24, r12)]\n                .into_iter()\n                .enumerate()\n        {\n            let mut st = State::new(224);\n            unsafe {\n                init(st.as_mut_ptr());\n                for &(op, off, len) in &ops {\n                    match op {\n                        0 => xorb(st.as_mut_ptr(), data.as_ptr(), off, len),\n                        1 => {\n                            let mut t = vec![0u8; len.max(1)];\n                            ext(st.as_ptr(), t.as_mut_ptr(), off, len);\n                        }\n                        2 => p24(st.as_mut_ptr()),\n                        _ => p12(st.as_mut_ptr()),\n                    }\n                }\n                ext(st.as_ptr(), finals[which].as_mut_ptr(), 0, 200);\n            }\n        }\n        let (a, b) = (finals[0].clone(), finals[1].clone());\n        eq_bytes(\n            &format!(\"_sodium_keccak1600_ref program #{iter} ({} ops)\", ops.len()),\n            &a,\n            &b,\n        );\n    }\n\n    // the internal refs must agree with the public wrappers, in both libs\n    for lib in [c_lib(), r_lib()] {\n        let mut a = State::new(224);\n        let mut b = State::new(224);\n        unsafe {\n            sym::<KcInit>(lib, \"_sodium_keccak1600_ref_init\")(a.as_mut_ptr());\n            sym::<KcInit>(lib, \"crypto_core_keccak1600_init\")(b.as_mut_ptr());\n            let d = rng.bytes(200);\n            sym::<KcXor>(lib, \"_sodium_keccak1600_ref_xor_bytes\")(a.as_mut_ptr(), d.as_ptr(), 0, 136);\n            sym::<KcXor>(lib, \"crypto_core_keccak1600_xor_bytes\")(b.as_mut_ptr(), d.as_ptr(), 0, 136);\n            sym::<KcPermute>(lib, \"_sodium_keccak1600_ref_permute_24\")(a.as_mut_ptr());\n            sym::<KcPermute>(lib, \"crypto_core_keccak1600_permute_24\")(b.as_mut_ptr());\n        }\n        eq_bytes(\"keccak1600 ref == public wrapper\", a.bytes(), b.bytes());\n    }\n}\n\n// ---------------------------------------------------------------------------\n// _sodium_{shake,turboshake}{128,256}_ref* — same shapes as the public XOFs\n// ---------------------------------------------------------------------------\n\ntype XofOneShot = unsafe extern \"C\" fn(*mut u8, usize, *const u8, usize) -> i32;\ntype XofInit = unsafe extern \"C\" fn(*mut u8) -> i32;\ntype XofInitDom = unsafe extern \"C\" fn(*mut u8, u8) -> i32;\ntype XofUpdate = unsafe extern \"C\" fn(*mut u8, *const u8, usize) -> i32;\ntype XofSqueeze = unsafe extern \"C\" fn(*mut u8, *mut u8, usize) -> i32;\n\n/// (internal prefix, public prefix, rate)\nconst XOF_REFS: &[(&str, &str, usize)] = &[\n    (\"_sodium_shake128_ref\", \"crypto_xof_shake128\", 168),\n    (\"_sodium_shake256_ref\", \"crypto_xof_shake256\", 136),\n    (\"_sodium_turboshake128_ref\", \"crypto_xof_turboshake128\", 168),\n    (\"_sodium_turboshake256_ref\", \"crypto_xof_turboshake256\", 136),\n];\n\n#[test]\nfn xof_ref_internal_exports() {\n    setup();\n    let mut rng = Rng::new(0xAE70);\n    for &(ip, pp, rate) in XOF_REFS {\n        let statebytes = unsafe {\n            sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{pp}_statebytes\"))()\n        };\n        // one-shot\n        let (c1, r1) = pair::<XofOneShot>(ip);\n        for &inlen in &[0usize, 1, rate - 1, rate, rate + 1, 2 * rate + 3, 1000] {\n            for &outlen in &[0usize, 1, 31, rate - 1, rate, rate + 1, 2 * rate + 5, 500] {\n                let inp = rng.bytes(inlen);\n                let mut a = canary(outlen.max(1));\n                let mut b = canary(outlen.max(1));\n                let (ra, rb) = unsafe {\n                    (\n                        c1(a.as_mut_ptr(), outlen, inp.as_ptr(), inlen),\n                        r1(b.as_mut_ptr(), outlen, inp.as_ptr(), inlen),\n                    )\n                };\n                eq_i32(&format!(\"{ip} rc(in={inlen},out={outlen})\"), ra, rb);\n                eq_bytes(&format!(\"{ip}(in={inlen},out={outlen})\"), &a, &b);\n            }\n        }\n        // streaming, with all 256 domain bytes on the _with_domain form\n        let (cin, rin) = pair::<XofInit>(&format!(\"{ip}_init\"));\n        let (cid, rid) = pair::<XofInitDom>(&format!(\"{ip}_init_with_domain\"));\n        let (cu, ru) = pair::<XofUpdate>(&format!(\"{ip}_update\"));\n        let (cs, rs) = pair::<XofSqueeze>(&format!(\"{ip}_squeeze\"));\n        for dom in (0u16..=255).step_by(1) {\n            let dom = dom as u8;\n            let inlen = rng.below(2 * rate + 5);\n            let inp = rng.bytes(inlen);\n            let sq = chunks(&mut rng, rate + 21, 3);\n            let mut out = [canary(rate + 21), canary(rate + 21)];\n            let mut rcs = [0i32; 2];\n            for (which, (init, upd, sqz)) in [(cid, cu, cs), (rid, ru, rs)].into_iter().enumerate() {\n                let mut st = State::new(statebytes);\n                unsafe {\n                    rcs[which] = init(st.as_mut_ptr(), dom);\n                    if rcs[which] == 0 {\n                        upd(st.as_mut_ptr(), inp.as_ptr(), inlen);\n                        let mut o = 0usize;\n                        for &n in &sq {\n                            sqz(st.as_mut_ptr(), out[which][o..].as_mut_ptr(), n);\n                            o += n;\n                        }\n                    }\n                }\n            }\n            eq_i32(&format!(\"{ip}_init_with_domain({dom:#x}) rc\"), rcs[0], rcs[1]);\n            let (a, b) = (out[0].clone(), out[1].clone());\n            eq_bytes(&format!(\"{ip} streaming dom={dom:#x}\"), &a, &b);\n        }\n        // plain _init must equal _init_with_domain(DOMAIN_STANDARD)\n        let std_dom = unsafe {\n            sym::<unsafe extern \"C\" fn() -> u8>(c_lib(), &format!(\"{pp}_domain_standard\"))()\n        };\n        for lib in [c_lib(), r_lib()] {\n            let (mut s1, mut s2) = (State::new(statebytes), State::new(statebytes));\n            let inp = rng.bytes(300);\n            let (mut o1, mut o2) = (canary(200), canary(200));\n            unsafe {\n                sym::<XofInit>(lib, &format!(\"{ip}_init\"))(s1.as_mut_ptr());\n                sym::<XofInitDom>(lib, &format!(\"{ip}_init_with_domain\"))(s2.as_mut_ptr(), std_dom);\n                let u = sym::<XofUpdate>(lib, &format!(\"{ip}_update\"));\n                let q = sym::<XofSqueeze>(lib, &format!(\"{ip}_squeeze\"));\n                u(s1.as_mut_ptr(), inp.as_ptr(), 300);\n                u(s2.as_mut_ptr(), inp.as_ptr(), 300);\n                q(s1.as_mut_ptr(), o1.as_mut_ptr(), 200);\n                q(s2.as_mut_ptr(), o2.as_mut_ptr(), 200);\n            }\n            eq_bytes(&format!(\"{ip}_init == _init_with_domain(STD)\"), &o1, &o2);\n        }\n        let _ = (cin, rin);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// _sodium_mlkem768_ref_* — the raw ML-KEM implementation\n// ---------------------------------------------------------------------------\n\ntype KemKeypair = unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32;\ntype KemSeedKeypair = unsafe extern \"C\" fn(*mut u8, *mut u8, *const u8) -> i32;\ntype KemEnc = unsafe extern \"C\" fn(*mut u8, *mut u8, *const u8) -> i32;\ntype KemEncDet = unsafe extern \"C\" fn(*mut u8, *mut u8, *const u8, *const u8) -> i32;\ntype KemDec = unsafe extern \"C\" fn(*mut u8, *const u8, *const u8) -> i32;\n\n#[test]\nfn mlkem768_ref_internal_exports() {\n    setup();\n    let mut rng = Rng::new(0xAE80);\n    let g = |s: &str| unsafe {\n        sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"crypto_kem_mlkem768_{s}\"))()\n    };\n    let (pkb, skb, ctb, ssb, seedb) = (\n        g(\"publickeybytes\"),\n        g(\"secretkeybytes\"),\n        g(\"ciphertextbytes\"),\n        g(\"bytes\"),\n        g(\"seedbytes\"),\n    );\n\n    // deterministic seeded keypair -> identical pk/sk\n    let (csk, rsk) = pair::<KemSeedKeypair>(\"_sodium_mlkem768_ref_seed_keypair\");\n    let (cencd, rencd) = pair::<KemEncDet>(\"_sodium_mlkem768_ref_enc_deterministic\");\n    let (cdec, rdec) = pair::<KemDec>(\"_sodium_mlkem768_ref_dec\");\n\n    for _ in 0..6 {\n        let seed = rng.bytes(seedb);\n        let mut pk = [canary(pkb), canary(pkb)];\n        let mut sk = [canary(skb), canary(skb)];\n        for (w, f) in [csk, rsk].into_iter().enumerate() {\n            let rc = unsafe { f(pk[w].as_mut_ptr(), sk[w].as_mut_ptr(), seed.as_ptr()) };\n            assert_eq!(rc, 0);\n        }\n        eq_bytes(\"_sodium_mlkem768_ref_seed_keypair pk\", &pk[0], &pk[1]);\n        eq_bytes(\"_sodium_mlkem768_ref_seed_keypair sk\", &sk[0], &sk[1]);\n\n        // deterministic encapsulation\n        let eseed = rng.bytes(32);\n        let mut ct = [canary(ctb), canary(ctb)];\n        let mut ss = [canary(ssb), canary(ssb)];\n        for (w, f) in [cencd, rencd].into_iter().enumerate() {\n            let rc = unsafe {\n                f(\n                    ct[w].as_mut_ptr(),\n                    ss[w].as_mut_ptr(),\n                    pk[0].as_ptr(),\n                    eseed.as_ptr(),\n                )\n            };\n            assert_eq!(rc, 0);\n        }\n        eq_bytes(\"_sodium_mlkem768_ref_enc_deterministic ct\", &ct[0], &ct[1]);\n        eq_bytes(\"_sodium_mlkem768_ref_enc_deterministic ss\", &ss[0], &ss[1]);\n\n        // decapsulation of the valid ciphertext\n        let mut ds = [canary(ssb), canary(ssb)];\n        for (w, f) in [cdec, rdec].into_iter().enumerate() {\n            let rc = unsafe { f(ds[w].as_mut_ptr(), ct[0].as_ptr(), sk[0].as_ptr()) };\n            assert_eq!(rc, 0);\n        }\n        eq_bytes(\"_sodium_mlkem768_ref_dec ss\", &ds[0], &ds[1]);\n        assert_eq!(ds[0], ss[0], \"ML-KEM round trip\");\n\n        // ML-KEM uses IMPLICIT REJECTION: a corrupted ciphertext still returns 0\n        // but yields a different (deterministically derived) shared secret. C and\n        // Rust must derive the SAME wrong secret.\n        for &idx in &[0usize, 1, 100, 700, 1087] {\n            let mut bad = ct[0].clone();\n            bad[idx.min(ctb - 1)] ^= 0x01;\n            let mut bs = [canary(ssb), canary(ssb)];\n            let mut rcs = [0i32; 2];\n            for (w, f) in [cdec, rdec].into_iter().enumerate() {\n                rcs[w] = unsafe { f(bs[w].as_mut_ptr(), bad.as_ptr(), sk[0].as_ptr()) };\n            }\n            eq_i32(\"_sodium_mlkem768_ref_dec corrupted rc\", rcs[0], rcs[1]);\n            eq_bytes(\n                &format!(\"_sodium_mlkem768_ref_dec corrupted ss (flip {idx})\"),\n                &bs[0],\n                &bs[1],\n            );\n            assert_ne!(bs[0], ss[0], \"implicit rejection must change the secret\");\n        }\n    }\n\n    // RNG-driven keypair / enc, made deterministic by reset_rngs\n    let (ckp, rkp) = pair::<KemKeypair>(\"_sodium_mlkem768_ref_keypair\");\n    let (cenc, renc) = pair::<KemEnc>(\"_sodium_mlkem768_ref_enc\");\n    for s in 0..4u64 {\n        let mut pk = [canary(pkb), canary(pkb)];\n        let mut sk = [canary(skb), canary(skb)];\n        for (w, f) in [ckp, rkp].into_iter().enumerate() {\n            reset_rngs(0xE000 + s);\n            unsafe { f(pk[w].as_mut_ptr(), sk[w].as_mut_ptr()) };\n        }\n        eq_bytes(\"_sodium_mlkem768_ref_keypair pk\", &pk[0], &pk[1]);\n        eq_bytes(\"_sodium_mlkem768_ref_keypair sk\", &sk[0], &sk[1]);\n\n        let mut ct = [canary(ctb), canary(ctb)];\n        let mut ss = [canary(ssb), canary(ssb)];\n        for (w, f) in [cenc, renc].into_iter().enumerate() {\n            reset_rngs(0xE100 + s);\n            unsafe { f(ct[w].as_mut_ptr(), ss[w].as_mut_ptr(), pk[0].as_ptr()) };\n        }\n        eq_bytes(\"_sodium_mlkem768_ref_enc ct\", &ct[0], &ct[1]);\n        eq_bytes(\"_sodium_mlkem768_ref_enc ss\", &ss[0], &ss[1]);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// the 10 _pick_best_implementation selectors + the 9 implementation v-tables\n// ---------------------------------------------------------------------------\n\nconst PICKERS: &[&str] = &[\n    \"_crypto_aead_aegis128l_pick_best_implementation\",\n    \"_crypto_aead_aegis256_pick_best_implementation\",\n    \"_crypto_generichash_blake2b_pick_best_implementation\",\n    \"_crypto_ipcrypt_pick_best_implementation\",\n    \"_crypto_onetimeauth_poly1305_pick_best_implementation\",\n    \"_crypto_pwhash_argon2_pick_best_implementation\",\n    \"_crypto_scalarmult_curve25519_pick_best_implementation\",\n    \"_crypto_stream_chacha20_pick_best_implementation\",\n    \"_crypto_stream_salsa20_pick_best_implementation\",\n    \"_sodium_blake2b_pick_best_implementation\",\n];\n\n#[test]\nfn pick_best_implementation_selectors() {\n    setup();\n    for name in PICKERS {\n        let (c, r) = pair::<unsafe extern \"C\" fn() -> i32>(name);\n        // idempotent: calling repeatedly must keep returning the same value\n        for _ in 0..3 {\n            let (a, b) = unsafe { (c(), r()) };\n            eq_i32(name, a, b);\n        }\n    }\n    // re-picking must not perturb behaviour: a hash computed afterwards must\n    // still match between the two libraries.\n    let (c, r) = pair::<unsafe extern \"C\" fn(*mut u8, usize, *const u8, u64, *const u8, usize) -> i32>(\n        \"crypto_generichash\",\n    );\n    let mut rng = Rng::new(0xAE90);\n    for _ in 0..16 {\n        let inp = rng.bytes(rng.below(500));\n        let mut a = canary(32);\n        let mut b = canary(32);\n        unsafe {\n            c(a.as_mut_ptr(), 32, inp.as_ptr(), inp.len() as u64, std::ptr::null(), 0);\n            r(b.as_mut_ptr(), 32, inp.as_ptr(), inp.len() as u64, std::ptr::null(), 0);\n        }\n        eq_bytes(\"crypto_generichash after re-pick\", &a, &b);\n    }\n}\n\n/// The 9 exported implementation v-tables are `D` (data) symbols in both\n/// builds. Verify each is a non-NULL object whose `implementation_name`-style\n/// first field is callable where applicable, and that the two `randombytes_*`\n/// v-tables report the same implementation name.\n#[test]\nfn exported_implementation_vtables() {\n    setup();\n    const VTABLES: &[&str] = &[\n        \"aegis128l_soft_implementation\",\n        \"aegis256_soft_implementation\",\n        \"crypto_onetimeauth_poly1305_donna_implementation\",\n        \"crypto_scalarmult_curve25519_ref10_implementation\",\n        \"crypto_stream_chacha20_ref_implementation\",\n        \"crypto_stream_salsa20_ref_implementation\",\n        \"ipcrypt_soft_implementation\",\n        \"randombytes_internal_implementation\",\n        \"randombytes_sysrandom_implementation\",\n    ];\n    for name in VTABLES {\n        let c: *const *const std::ffi::c_void = sym(c_lib(), name);\n        let r: *const *const std::ffi::c_void = sym(r_lib(), name);\n        assert!(!c.is_null() && !r.is_null(), \"{name} v-table is NULL\");\n        // every slot that the C fills must also be filled by Rust (and vice\n        // versa) — compare the NULL/non-NULL pattern of the first 8 slots.\n        for i in 0..8usize {\n            let (a, b) = unsafe { (*c.add(i), *r.add(i)) };\n            assert_eq!(\n                a.is_null(),\n                b.is_null(),\n                \"{name}: slot {i} nullness differs (C={a:?}, Rust={b:?})\"\n            );\n        }\n    }\n\n    // the two randombytes v-tables expose an implementation_name() as slot 0\n    for name in [\n        \"randombytes_internal_implementation\",\n        \"randombytes_sysrandom_implementation\",\n    ] {\n        let c: *const Option<unsafe extern \"C\" fn() -> *const std::ffi::c_char> = sym(c_lib(), name);\n        let r: *const Option<unsafe extern \"C\" fn() -> *const std::ffi::c_char> = sym(r_lib(), name);\n        unsafe {\n            let (cf, rf) = (*c, *r);\n            let (cf, rf) = (cf.expect(\"C name fn\"), rf.expect(\"Rust name fn\"));\n            let (a, b) = (\n                std::ffi::CStr::from_ptr(cf()).to_owned(),\n                std::ffi::CStr::from_ptr(rf()).to_owned(),\n            );\n            assert_eq!(a, b, \"{name}.implementation_name()\");\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// misc internal exports\n// ---------------------------------------------------------------------------\n\n#[test]\nfn misc_internal_exports() {\n    setup();\n    // `_sodium_alloc_init` — idempotent, returns the same value in both\n    let (c, r) = pair::<unsafe extern \"C\" fn() -> i32>(\"_sodium_alloc_init\");\n    for _ in 0..3 {\n        let (a, b) = unsafe { (c(), r()) };\n        eq_i32(\"_sodium_alloc_init\", a, b);\n    }\n    // `_sodium_runtime_get_cpu_features` — no HAVE_* in this build, so the\n    // `_cpuid` stub zero-fills and the function reports failure.\n    let (c, r) = pair::<unsafe extern \"C\" fn() -> i32>(\"_sodium_runtime_get_cpu_features\");\n    for _ in 0..3 {\n        let (a, b) = unsafe { (c(), r()) };\n        eq_i32(\"_sodium_runtime_get_cpu_features\", a, b);\n    }\n    // `sodium_crit_enter` / `sodium_crit_leave` — the no-op stubs (no\n    // HAVE_PTHREAD / HAVE_ATOMIC_OPS), so enter returns 0 and leave returns 0\n    // after an enter.\n    let (ce, re) = pair::<unsafe extern \"C\" fn() -> i32>(\"sodium_crit_enter\");\n    let (cl, rl) = pair::<unsafe extern \"C\" fn() -> i32>(\"sodium_crit_leave\");\n    for _ in 0..3 {\n        let (a, b) = unsafe { (ce(), re()) };\n        eq_i32(\"sodium_crit_enter\", a, b);\n        let (a, b) = unsafe { (cl(), rl()) };\n        eq_i32(\"sodium_crit_leave\", a, b);\n    }\n}\n\n/// `_crypto_sign_ed25519_detached` / `_verify_detached` — the internal forms\n/// that take the extra `prehashed` flag, plus `_crypto_sign_ed25519_ref10_hinit`.\n#[test]\nfn internal_ed25519_sign_exports() {\n    setup();\n    let mut rng = Rng::new(0xAEA0);\n    type IntDetached = unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8, i32) -> i32;\n    type IntVerify = unsafe extern \"C\" fn(*const u8, *const u8, u64, *const u8, i32) -> i32;\n    type Hinit = unsafe extern \"C\" fn(*mut u8, i32) -> i32;\n\n    let (ckp, rkp) = pair::<unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32>(\"crypto_sign_ed25519_keypair\");\n    let (cd, rd) = pair::<IntDetached>(\"_crypto_sign_ed25519_detached\");\n    let (cv, rv) = pair::<IntVerify>(\"_crypto_sign_ed25519_verify_detached\");\n\n    for &mlen in &[0usize, 1, 31, 32, 33, 63, 64, 65, 127, 128, 1000] {\n        // identical keypair on both sides\n        let mut pk = [canary(32), canary(32)];\n        let mut sk = [canary(64), canary(64)];\n        for (w, f) in [ckp, rkp].into_iter().enumerate() {\n            reset_rngs(0xF000 + mlen as u64);\n            unsafe { f(pk[w].as_mut_ptr(), sk[w].as_mut_ptr()) };\n        }\n        eq_bytes(\"keypair pk\", &pk[0], &pk[1]);\n        eq_bytes(\"keypair sk\", &sk[0], &sk[1]);\n\n        let m = rng.bytes(mlen);\n        // `prehashed = 0` is the only value reachable through the public\n        // `crypto_sign_ed25519_detached`; `1` is the ed25519ph path (which\n        // expects a 64-byte prehash), and any other int is an out-of-range enum\n        // value that the C accepts across the FFI boundary.\n        for &ph in &[0i32, 1, 2, -1, i32::MAX] {\n            if ph == 1 && mlen != 64 {\n                continue; // ed25519ph needs a 64-byte prehash\n            }\n            let mut sig = [canary(64), canary(64)];\n            let mut sl = [0u64, 0u64];\n            let mut rcs = [0i32; 2];\n            for (w, f) in [cd, rd].into_iter().enumerate() {\n                rcs[w] = unsafe {\n                    f(\n                        sig[w].as_mut_ptr(),\n                        &mut sl[w],\n                        m.as_ptr(),\n                        mlen as u64,\n                        sk[0].as_ptr(),\n                        ph,\n                    )\n                };\n            }\n            eq_i32(&format!(\"_crypto_sign_ed25519_detached rc(ph={ph},m={mlen})\"), rcs[0], rcs[1]);\n            eq_usize(\"_crypto_sign_ed25519_detached *siglen\", sl[0] as usize, sl[1] as usize);\n            eq_bytes(&format!(\"_crypto_sign_ed25519_detached sig(ph={ph},m={mlen})\"), &sig[0], &sig[1]);\n\n            let mut vr = [0i32; 2];\n            for (w, f) in [cv, rv].into_iter().enumerate() {\n                vr[w] = unsafe { f(sig[0].as_ptr(), m.as_ptr(), mlen as u64, pk[0].as_ptr(), ph) };\n            }\n            eq_i32(&format!(\"_crypto_sign_ed25519_verify_detached rc(ph={ph})\"), vr[0], vr[1]);\n\n            // a corrupted signature must be rejected identically\n            for i in [0usize, 31, 32, 63] {\n                let mut bad = sig[0].clone();\n                bad[i] ^= 0x01;\n                let mut vr = [0i32; 2];\n                for (w, f) in [cv, rv].into_iter().enumerate() {\n                    vr[w] = unsafe { f(bad.as_ptr(), m.as_ptr(), mlen as u64, pk[0].as_ptr(), ph) };\n                }\n                eq_i32(\n                    &format!(\"_crypto_sign_ed25519_verify_detached bad sig[{i}] (ph={ph})\"),\n                    vr[0],\n                    vr[1],\n                );\n            }\n        }\n    }\n\n    // `_crypto_sign_ed25519_ref10_hinit(state, prehashed)` over a sha512 state\n    let (ch, rh) = pair::<Hinit>(\"_crypto_sign_ed25519_ref10_hinit\");\n    let sb = \"crypto_hash_sha512_statebytes\";\n    type ShaUpdate = unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32;\n    type ShaFinal = unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32;\n    let (cu, ru) = pair::<ShaUpdate>(\"crypto_hash_sha512_update\");\n    let (cf, rf) = pair::<ShaFinal>(\"crypto_hash_sha512_final\");\n    for &ph in &[0i32, 1, 2, -1, i32::MAX] {\n        let inp = rng.bytes(200);\n        let mut out = [canary(64), canary(64)];\n        let mut rcs = [0i32; 2];\n        for (w, (h, u, f)) in [(ch, cu, cf), (rh, ru, rf)].into_iter().enumerate() {\n            let mut st = State::for_sym(sb);\n            unsafe {\n                rcs[w] = h(st.as_mut_ptr(), ph);\n                u(st.as_mut_ptr(), inp.as_ptr(), 200);\n                f(st.as_mut_ptr(), out[w].as_mut_ptr());\n            }\n        }\n        eq_i32(&format!(\"_crypto_sign_ed25519_ref10_hinit rc(ph={ph})\"), rcs[0], rcs[1]);\n        let (a, b) = (out[0].clone(), out[1].clone());\n        eq_bytes(&format!(\"hinit digest (ph={ph})\"), &a, &b);\n    }\n}\n","structuredPatch":[{"oldStart":577,"oldLines":7,"newStart":577,"newLines":8,"lines":["     );","     let mut rng = Rng::new(0xAE90);","     for _ in 0..16 {","-        let inp = rng.bytes(rng.below(500));","+        let n = rng.below(500);","+        let inp = rng.bytes(n);","         let mut a = canary(32);","         let mut b = canary(32);","         unsafe {"]}],"userModified":false,"replaceAll":false}}
