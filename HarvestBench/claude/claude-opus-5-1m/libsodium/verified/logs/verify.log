{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QCqrrz7aVigv99ZpAk4KVu","type":"tool_result","content":"1\t//! `randombytes/sysrandom/randombytes_sysrandom.c`\n2\t\n3\tuse core::ffi::{c_char, c_int, c_void};\n4\t\n5\tuse super::RandombytesImplementation;\n6\tuse super::os;\n7\tuse crate::common::{get_errno, set_errno};\n8\tuse crate::sodium::core::sodium_misuse;\n9\t\n10\t#[repr(C)]\n11\tstruct SysRandom {\n12\t    random_data_source_fd: c_int,\n13\t    initialized: c_int,\n14\t    getrandom_available: c_int,\n15\t}\n16\t\n17\tstatic mut STREAM: SysRandom = SysRandom {\n18\t    random_data_source_fd: -1,\n19\t    initialized: 0,\n20\t    getrandom_available: 0,\n21\t};\n22\t\n23\t#[inline]\n24\tfn st() -> &'static mut SysRandom {\n25\t    unsafe { &mut *(&raw mut STREAM) }\n26\t}\n27\t\n28\tfn randombytes_sysrandom_init() {\n29\t    let errno_save = get_errno();\n30\t\n31\t    {\n32\t        let mut fodder = [0u8; 16];\n33\t        if unsafe { os::linux_getrandom(fodder.as_mut_ptr() as *mut c_void, 16) } == 0 {\n34\t            st().getrandom_available = 1;\n35\t            set_errno(errno_save);\n36\t            return;\n37\t        }\n38\t        st().getrandom_available = 0;\n39\t    }\n40\t\n41\t    st().random_data_source_fd = os::random_dev_open();\n42\t    if st().random_data_source_fd == -1 {\n43\t        sodium_misuse();\n44\t    }\n45\t    set_errno(errno_save);\n46\t}\n47\t\n48\textern \"C\" fn randombytes_sysrandom_stir() {\n49\t    if st().initialized == 0 {\n50\t        randombytes_sysrandom_init();\n51\t        st().initialized = 1;\n52\t    }\n53\t}\n54\t\n55\tfn randombytes_sysrandom_stir_if_needed() {\n56\t    if st().initialized == 0 {\n57\t        randombytes_sysrandom_stir();\n58\t    }\n59\t}\n60\t\n61\textern \"C\" fn randombytes_sysrandom_close() -> c_int {\n62\t    let mut ret: c_int = -1;\n63\t\n64\t    if st().random_data_source_fd != -1 && os::close_fd(st().random_data_source_fd) == 0 {\n65\t        st().random_data_source_fd = -1;\n66\t        st().initialized = 0;\n67\t        ret = 0;\n68\t    }\n69\t    if st().getrandom_available != 0 {\n70\t        ret = 0;\n71\t    }\n72\t    ret\n73\t}\n74\t\n75\tunsafe extern \"C\" fn randombytes_sysrandom_buf(buf: *mut c_void, size: usize) {\n76\t    randombytes_sysrandom_stir_if_needed();\n77\t    if st().getrandom_available != 0 {\n78\t        if unsafe { os::linux_getrandom(buf, size) } != 0 {\n79\t            sodium_misuse();\n80\t        }\n81\t        return;\n82\t    }\n83\t    if st().random_data_source_fd == -1\n84\t        || unsafe { os::safe_read(st().random_data_source_fd, buf, size) } != size as isize\n85\t    {\n86\t        sodium_misuse();\n87\t    }\n88\t}\n89\t\n90\textern \"C\" fn randombytes_sysrandom() -> u32 {\n91\t    let mut r: u32 = 0;\n92\t    unsafe { randombytes_sysrandom_buf(&raw mut r as *mut c_void, 4) };\n93\t    r\n94\t}\n95\t\n96\textern \"C\" fn randombytes_sysrandom_implementation_name() -> *const c_char {\n97\t    b\"sysrandom\\0\".as_ptr() as *const c_char\n98\t}\n99\t\n100\t#[unsafe(no_mangle)]\n101\tpub static mut randombytes_sysrandom_implementation: RandombytesImplementation =\n102\t    RandombytesImplementation {\n103\t        implementation_name: Some(randombytes_sysrandom_implementation_name),\n104\t        random: Some(randombytes_sysrandom),\n105\t        stir: Some(randombytes_sysrandom_stir),\n106\t        uniform: None,\n107\t        buf: Some(randombytes_sysrandom_buf),\n108\t        close: Some(randombytes_sysrandom_close),\n109\t    };\n110\t"}]},"parent_tool_use_id":"toolu_bdrk_01Aw2j196PG6UFGUL4fdGJ7V","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"d38401e8-b9e6-468d-8f89-d0a7a60784f9","timestamp":"2026-08-23T08:29:16.396Z","subagent_type":"general-purpose","task_description":"Phase B+C tests: sodium+randombytes"}
