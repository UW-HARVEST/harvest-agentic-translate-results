{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_x2tq73k4xp6r2wzdamq23lfpptuhuaspmwe7eqrxbivoc7quvvoa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01WUSH3nofg7y4mqDZcTA24o","name":"Edit","input":{"replace_all":false,"file_path":"/local/home/scheschb/.harvest/work/harvest-work-djFIwa/translated_rust/tests/diff_g7.rs","old_string":"            let rc = unsafe { (*chk_rehash)(sb.as_ptr() as *const c_char, 524288, 16777216) };\n            assert_eq!(rc, 1, \"{ctx}: cross needs_rehash(different params)\");\n        }\n    }\n}","new_string":"            let rc = unsafe { (*chk_rehash)(sb.as_ptr() as *const c_char, 524288, 16777216) };\n            assert_eq!(rc, 1, \"{ctx}: cross needs_rehash(different params)\");\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Phase B — crypto_pwhash_scryptsalsa208sha256\n// ---------------------------------------------------------------------------\n\n#[track_caller]\nfn scrypt_raw(ctx: &str, outlen: usize, pw: &[u8], salt: &[u8; 32], ops: u64, mem: usize) -> Obs {\n    both::<FnScrypt, _>(\n        ctx,\n        \"crypto_pwhash_scryptsalsa208sha256\",\n        outlen,\n        |f, p| unsafe {\n            (*f)(\n                p,\n                outlen as u64,\n                pw.as_ptr() as *const c_char,\n                pw.len() as u64,\n                salt.as_ptr(),\n                ops,\n                mem,\n            )\n        },\n    )\n}\n\n#[track_caller]\nfn scrypt_ok(ctx: &str, outlen: usize, pw: &[u8], salt: &[u8; 32], ops: u64, mem: usize) -> Obs {\n    let o = scrypt_raw(ctx, outlen, pw, salt, ops, mem);\n    eq_ret(ctx, 0, o.rc);\n    assert_eq!(o.errno, ERRNO_SENTINEL, \"{ctx}: errno touched on success\");\n    // The raw scrypt entry point draws NO random bytes.\n    assert_eq!(o.rng, 0, \"{ctx}: random-byte consumption must be 0\");\n    o\n}\n\n/// configs: baseline scrypt (`pickparams` -> N_log2 = 10, r = 8, p = 1) plus the\n/// cheapest degenerate shape (`N = 2, r = 8, p = 512`), which is the only row\n/// with `p > 1` at negligible cost, and the `opslimit < memlimit / 32` branch\n/// boundary.\n#[test]\nfn cfg_scrypt_pickparams_branches() {\n    let base = scrypt_ok(\"scrypt MIN/MIN\", 32, PW, &SALT32, 32768, 16777216);\n    assert_anchor(\n        \"scrypt MIN/MIN\",\n        &base.out,\n        \"3463bcfef2bffa06d9ae4ff763ddc647cc02cb454193e7b42928693955f720cc\",\n    );\n\n    // opslimit/memlimit BELOW the documented MINs are accepted: pickparams\n    // clamps opslimit to 32768 and never validates memlimit.\n    let deg = scrypt_ok(\"scrypt (0,0)\", 32, PW, &SALT32, 0, 0);\n    let deg2 = scrypt_ok(\"scrypt (32768,1024)\", 32, PW, &SALT32, 32768, 1024);\n    eq_bytes(\"scrypt (0,0) vs (32768,1024)\", &deg.out, &deg2.out);\n    assert_ne!(deg.out, base.out);\n\n    // Both sides of `opslimit < memlimit / 32`. All three land on\n    // N_log2 = 10, r = 8, p = 1, so they must reproduce the baseline exactly.\n    for mem in [1048576usize, 1048577, 1081344] {\n        let ctx = format!(\"scrypt (32768,{mem})\");\n        let o = scrypt_ok(&ctx, 32, PW, &SALT32, 32768, mem);\n        eq_bytes(&ctx, &base.out, &o.out);\n    }\n\n    // memlimit ABOVE MEMLIMIT_MAX is also accepted (no check exists) and, with\n    // a small opslimit, still yields N_log2 = 10.\n    let o = scrypt_ok(\"scrypt memlimit=MEMLIMIT_MAX+1\", 32, PW, &SALT32, 32768, 68719476737);\n    eq_bytes(\"scrypt memlimit above MAX\", &base.out, &o.out);\n\n    // N_log2 = 11 and 12 (2 MiB / 4 MiB)\n    let n11 = scrypt_ok(\"scrypt (65536,16MiB)\", 32, PW, &SALT32, 65536, 16777216);\n    let n12 = scrypt_ok(\"scrypt (131072,16MiB)\", 32, PW, &SALT32, 131072, 16777216);\n    assert_ne!(n11.out, n12.out);\n    assert_ne!(n11.out, base.out);\n}\n\n/// configs: the INTERACTIVE preset (`N = 16384`, 16 MiB) and the only realistic\n/// `p > 1` row with a non-trivial `N` (`N = 16384, r = 8, p = 32`). SLOW.\n#[test]\nfn cfg_scrypt_presets() {\n    let inter = scrypt_ok(\"scrypt INTERACTIVE\", 32, PW, &SALT32, 524288, 16777216);\n    let p32 = scrypt_ok(\"scrypt (16777216,16MiB) p=32\", 32, PW, &SALT32, 16777216, 16777216);\n    assert_ne!(inter.out, p32.out);\n}\n\n/// configs: the SENSITIVE preset (`N = 2^20`, 1 GiB). `#[ignore]`d: ~4 s of CPU\n/// and 1 GiB of RSS per library; the `N_log2 = 20` encoding is covered cheaply\n/// by `_sodium_escrypt_gensalt_r` instead.\n///   cargo test --release --test diff_g7 -- --ignored\n#[test]\n#[ignore]\nfn cfg_scrypt_sensitive_preset_slow() {\n    scrypt_ok(\"scrypt SENSITIVE\", 32, PW, &SALT32, 33554432, 1073741824);\n}\n\n/// configs: `outlen` only feeds the final `escrypt_PBKDF2_SHA256`; 33 and 100\n/// exercise the partial-final-block path.\n#[test]\nfn cfg_scrypt_outlen_sweep() {\n    let mut seen: Vec<Vec<u8>> = Vec::new();\n    for outlen in [16usize, 17, 31, 32, 33, 64, 100, 256] {\n        let ctx = format!(\"scrypt outlen={outlen}\");\n        let o = scrypt_ok(&ctx, outlen, PW, &SALT32, 0, 0);\n        assert_eq!(o.out.len(), outlen);\n        // PBKDF2 output is a prefix-extension family: the first 16 bytes are\n        // the same for every length.\n        if let Some(first) = seen.first() {\n            assert_eq!(&o.out[..16], &first[..16], \"{ctx}: PBKDF2 prefix changed\");\n        }\n        seen.push(o.out);\n    }\n}\n\n/// configs: password-length sweep. `passwdlen > 64` makes HMAC-SHA256 pre-hash\n/// the key.\n#[test]\nfn cfg_scrypt_passwd_lengths() {\n    let mut rng = Rng::new(0x5C_11_0001);\n    let mut seen: Vec<Vec<u8>> = Vec::new();\n    for n in [0usize, 1, 4, 63, 64, 65, 1024] {\n        let pw = rng.bytes(n);\n        let ctx = format!(\"scrypt passwdlen={n}\");\n        let o = scrypt_ok(&ctx, 32, &pw, &SALT32, 0, 0);\n        assert!(!seen.contains(&o.out), \"{ctx}: digest collision\");\n        seen.push(o.out);\n    }\n    for i in 0..20 {\n        let n = rng.below(200);\n        let pw = rng.bytes(n);\n        scrypt_ok(&format!(\"scrypt random pw #{i}\"), 32, &pw, &SALT32, 0, 0);\n    }\n}\n\n/// configs: the salt length is fixed at SALTBYTES = 32; vary the contents.\n#[test]\nfn cfg_scrypt_salt_contents() {\n    let zeros = [0u8; 32];\n    let ffs = [0xffu8; 32];\n    let a = scrypt_ok(\"scrypt salt=00..\", 32, PW, &zeros, 0, 0);\n    let b = scrypt_ok(\"scrypt salt=ff..\", 32, PW, &ffs, 0, 0);\n    let c = scrypt_ok(\"scrypt salt=41..\", 32, PW, &SALT32, 0, 0);\n    assert_ne!(a.out, b.out);\n    assert_ne!(a.out, c.out);\n    assert_ne!(b.out, c.out);\n    let mut rng = Rng::new(0x5C_5A_17);\n    for i in 0..16 {\n        let mut s = [0u8; 32];\n        rng.fill(&mut s);\n        scrypt_ok(&format!(\"scrypt random salt #{i}\"), 32, PW, &s, 0, 0);\n    }\n}\n\n// ---- scrypt `_str` / `_str_verify` / `_str_needs_rehash` ----\n\n#[track_caller]\nfn scrypt_str(ctx: &str, pw: &[u8], ops: u64, mem: usize, mode: RngMode) -> Obs {\n    both_m::<FnStr, _>(\n        ctx,\n        \"crypto_pwhash_scryptsalsa208sha256_str\",\n        102,\n        mode,\n        |f, p| unsafe {\n            (*f)(\n                p as *mut c_char,\n                pw.as_ptr() as *const c_char,\n                pw.len() as u64,\n                ops,\n                mem,\n            )\n        },\n    )\n}\n\n/// configs: the exact reference `$7$…` string, its setting prefixes for several\n/// `N_log2` values, and the 32 + 102 random-byte consumption\n/// (`randombytes_buf(salt)` plus `escrypt_r`'s pre-fill of `buf`).\n#[test]\nfn cfg_scrypt_str_reference() {\n    let o = scrypt_str(\"scrypt_str MIN/MIN\", PW, 32768, 16777216, RngMode::Fill41);\n    eq_ret(\"scrypt_str MIN/MIN\", 0, o.rc);\n    let s = cstr_of(&o.out);\n    assert_eq!(s, TS_SCRYPT_OK, \"scrypt_str reference string mismatch\");\n    assert_eq!(s.len(), 101);\n    assert_eq!(o.out[101], 0, \"the 102-byte buffer must be NUL-terminated\");\n    assert_eq!(o.rng, 32 + 102, \"scrypt_str random-byte consumption\");\n    assert_eq!(o.errno, ERRNO_SENTINEL, \"errno touched on success\");\n\n    // N_log2 encodings: itoa64[1] = '/', [10] = '8', [14] = 'C', [15] = 'D'\n    for (ops, mem, prefix) in [\n        (0u64, 0usize, \"$7$/6.....6...\"),\n        (32768, 16777216, \"$7$86..../....\"),\n        (524288, 16777216, \"$7$C6..../....\"),\n        (1048576, 33554432, \"$7$D6..../....\"),\n    ] {\n        let ctx = format!(\"scrypt_str(ops={ops},mem={mem})\");\n        let o = scrypt_str(&ctx, PW, ops, mem, RngMode::Fill41);\n        eq_ret(&ctx, 0, o.rc);\n        let s = cstr_of(&o.out);\n        assert!(\n            s.starts_with(prefix),\n            \"{ctx}: expected setting prefix {prefix:?}, got {s:?}\"\n        );\n        assert_eq!(s.len(), 101, \"{ctx}: scrypt strings are always 101 chars\");\n        // ... and the string must verify.\n        let v = str_verify(\n            &format!(\"{ctx} verify\"),\n            \"crypto_pwhash_scryptsalsa208sha256_str_verify\",\n            &s,\n            PW,\n        );\n        eq_ret(&format!(\"{ctx} verify\"), 0, v.rc);\n        assert_eq!(v.rng, 102, \"scrypt _str_verify draws 102 bytes\");\n        assert_eq!(v.errno, ERRNO_SENTINEL, \"scrypt verify must not touch errno\");\n    }\n\n    // passwdlen = 0 is valid.\n    let o = scrypt_str(\"scrypt_str(\\\"\\\")\", b\"\", 32768, 16777216, RngMode::Fill41);\n    eq_ret(\"scrypt_str(\\\"\\\")\", 0, o.rc);\n    let s = cstr_of(&o.out);\n    let v = str_verify(\n        \"scrypt verify empty pw\",\n        \"crypto_pwhash_scryptsalsa208sha256_str_verify\",\n        &s,\n        b\"\",\n    );\n    eq_ret(\"scrypt verify empty pw\", 0, v.rc);\n}\n\n/// configs: `_str` with `N_log2 = 20` (`$7$I6..../....`). `#[ignore]`d: 1 GiB of\n/// RSS and ~4 s of CPU per library. The `'I'` character itself is covered\n/// cheaply by the `_sodium_escrypt_gensalt_r` row.\n///   cargo test --release --test diff_g7 -- --ignored\n#[test]\n#[ignore]\nfn cfg_scrypt_str_nlog2_20_slow() {\n    let o = scrypt_str(\n        \"scrypt_str SENSITIVE\",\n        PW,\n        33554432,\n        1073741824,\n        RngMode::Fill41,\n    );\n    eq_ret(\"scrypt_str SENSITIVE\", 0, o.rc);\n    let s = cstr_of(&o.out);\n    assert!(s.starts_with(\"$7$I6..../....\"), \"got {s:?}\");\n}\n\n/// configs: scrypt `_str_verify` on the reference string, and\n/// `_str_needs_rehash` (which runs no KDF at all -- only `pickparams` plus\n/// `escrypt_parse_setting`).\n#[test]\nfn cfg_scrypt_verify_and_needs_rehash() {\n    let v = str_verify(\n        \"scrypt verify TS_SCRYPT_OK\",\n        \"crypto_pwhash_scryptsalsa208sha256_str_verify\",\n        TS_SCRYPT_OK,\n        PW,\n    );\n    eq_ret(\"scrypt verify TS_SCRYPT_OK\", 0, v.rc);\n    assert_eq!(v.rng, 102);\n\n    for (ops, mem, want) in [\n        (32768u64, 16777216usize, 0),\n        (524288, 16777216, 1),\n        (0, 0, 1),\n    ] {\n        let ctx = format!(\"scrypt needs_rehash(ops={ops},mem={mem})\");\n        let o = needs_rehash(\n            &ctx,\n            \"crypto_pwhash_scryptsalsa208sha256_str_needs_rehash\",\n            TS_SCRYPT_OK,\n            ops,\n            mem,\n        );\n        eq_ret(&ctx, want, o.rc);\n        assert_eq!(o.rng, 0, \"{ctx}: needs_rehash draws no randomness\");\n        if want >= 0 {\n            assert_eq!(o.errno, ERRNO_SENTINEL, \"{ctx}: errno touched\");\n        }\n    }\n}\n\n// ---- crypto_pwhash_scryptsalsa208sha256_ll and escrypt_kdf_nosse ----\n\n#[track_caller]\nfn scrypt_ll(ctx: &str, pw: &[u8], salt: &[u8], n: u64, r: u32, p: u32, buflen: usize) -> Obs {\n    both::<FnScryptLl, _>(\n        ctx,\n        \"crypto_pwhash_scryptsalsa208sha256_ll\",\n        buflen,\n        |f, o| unsafe {\n            (*f)(\n                pw.as_ptr(),\n                pw.len(),\n                salt.as_ptr(),\n                salt.len(),\n                n,\n                r,\n                p,\n                o,\n                buflen,\n            )\n        },\n    )\n}\n\n/// `_sodium_escrypt_kdf_nosse` driven directly, with a per-library\n/// `escrypt_local_t` created and released by that same library.\n#[track_caller]\nfn escrypt_kdf(ctx: &str, pw: &[u8], salt: &[u8], n: u64, r: u32, p: u32, buflen: usize) -> Obs {\n    install_rng();\n    let l = libs();\n    let (ic, ir) = l.pair::<FnLocalOp>(\"_sodium_escrypt_init_local\");\n    let (dc, dr) = l.pair::<FnLocalOp>(\"_sodium_escrypt_free_local\");\n    let (fc, fr) = l.pair::<FnEscryptKdf>(\"_sodium_escrypt_kdf_nosse\");\n    let _g = rng_lock();\n    set_rng_mode(RngMode::Counter(0x5EED_0007));\n    let run = |init: &FnLocalOp, freel: &FnLocalOp, f: &FnEscryptKdf| -> Obs {\n        let mut local = EscryptLocal::zeroed();\n        unsafe { assert_eq!((*init)(&mut local), 0, \"{ctx}: escrypt_init_local failed\") };\n        let o = observe(ctx, buflen, &mut |out| unsafe {\n            (*f)(\n                &mut local,\n                pw.as_ptr(),\n                pw.len(),\n                salt.as_ptr(),\n                salt.len(),\n                n,\n                r,\n                p,\n                out,\n                buflen,\n            )\n        });\n        unsafe { assert_eq!((*freel)(&mut local), 0, \"{ctx}: escrypt_free_local failed\") };\n        o\n    };\n    let a = run(&ic, &dc, &fc);\n    let b = run(&ir, &dr, &fr);\n    cmp_obs(ctx, &a, &b);\n    a\n}\n\n/// configs: the `_ll` reference vectors, including `r > 1` (multi-block\n/// `blockmix_salsa8`), `p > 1` (the `for i < p` smix loop) and the degenerate\n/// `N = 2, p = 512` shape. Each vector is also driven through\n/// `_sodium_escrypt_kdf_nosse`, which must produce identical bytes (`_ll` is a\n/// thin wrapper around it).\n#[test]\nfn cfg_scrypt_ll_vectors() {\n    let pw = b\"password\";\n    let salt = b\"NaCl\";\n    let vectors: [(u64, u32, u32, &str); 7] = [\n        (2, 1, 1, \"48b0d2a8a3272611984c50ebd630af52\"),\n        (16, 1, 1, \"aec6b7483ed26e08802b41f4032086a0\"),\n        (16, 8, 1, \"f5dfb3972e7908b22410c5c5f3788907\"),\n        (1024, 8, 1, \"27b418c674c769d12501fbb1f53bac32\"),\n        (1024, 8, 2, \"6d1a16d34e5543ffa9f6322de7fc17a0\"),\n        (2, 8, 512, \"d5d155826e65a35f4bb0efa09e15bb42\"),\n        (16, 4, 3, \"50638641cb578cdfc796afce315015da\"),\n    ];\n    for (n, r, p, anchor) in vectors {\n        let ctx = format!(\"_ll N={n} r={r} p={p}\");\n        let o = scrypt_ll(&ctx, pw, salt, n, r, p, 64);\n        eq_ret(&ctx, 0, o.rc);\n        assert_eq!(o.rng, 0, \"{ctx}: _ll draws no randomness\");\n        assert_anchor(&ctx, &o.out, anchor);\n        // `_sodium_escrypt_kdf_nosse` must agree bit for bit.\n        let k = escrypt_kdf(&format!(\"kdf_nosse N={n} r={r} p={p}\"), pw, salt, n, r, p, 64);\n        eq_ret(&format!(\"kdf_nosse N={n} r={r} p={p}\"), 0, k.rc);\n        eq_bytes(&format!(\"_ll vs kdf_nosse N={n} r={r} p={p}\"), &o.out, &k.out);\n    }\n\n    // empty password AND empty salt (both non-NULL, length 0)\n    let o = scrypt_ll(\"_ll empty pw/salt\", b\"\", b\"\", 16, 1, 1, 64);\n    eq_ret(\"_ll empty pw/salt\", 0, o.rc);\n    assert_anchor(\n        \"_ll empty pw/salt\",\n        &o.out,\n        \"77d6576238657b203b19ca42c18a0497\",\n    );\n}\n\n/// configs: `_ll` with the INTERACTIVE-shaped parameters (16 MiB) and the\n/// largest practical `N`. `N = 2147483648` (the largest value that passes\n/// `N <= UINT32_MAX`) is deliberately NOT exercised: it needs 256 GiB of RAM.\n#[test]\nfn cfg_scrypt_ll_large_n() {\n    let pw = b\"password\";\n    let salt = b\"NaCl\";\n    let a = scrypt_ll(\"_ll N=16384\", pw, salt, 16384, 8, 1, 64);\n    eq_ret(\"_ll N=16384\", 0, a.rc);\n    let b = scrypt_ll(\"_ll N=65536\", pw, salt, 65536, 8, 1, 64);\n    eq_ret(\"_ll N=65536\", 0, b.rc);\n    assert_ne!(a.out, b.out);\n    let k = escrypt_kdf(\"kdf_nosse N=65536\", pw, salt, 65536, 8, 1, 64);\n    eq_bytes(\"_ll vs kdf_nosse N=65536\", &b.out, &k.out);\n}\n\n/// configs: `_ll` accepts any `buflen`, including 0 (there is no `BYTES_MIN`\n/// check at this level), and the PBKDF2 block loop's partial tail.\n#[test]\nfn cfg_scrypt_ll_buflen_sweep() {\n    let pw = b\"password\";\n    let salt = b\"NaCl\";\n    let z = scrypt_ll(\"_ll buflen=0\", pw, salt, 16, 1, 1, 0);\n    eq_ret(\"_ll buflen=0\", 0, z.rc);\n    assert!(z.out.is_empty());\n\n    let full = scrypt_ll(\"_ll buflen=257\", pw, salt, 16, 1, 1, 257);\n    eq_ret(\"_ll buflen=257\", 0, full.rc);\n    for buflen in [1usize, 16, 31, 32, 33, 64, 65, 257] {\n        let ctx = format!(\"_ll buflen={buflen}\");\n        let o = scrypt_ll(&ctx, pw, salt, 16, 1, 1, buflen);\n        eq_ret(&ctx, 0, o.rc);\n        assert_eq!(o.out.len(), buflen);\n        eq_bytes(&ctx, &full.out[..buflen], &o.out);\n        let k = escrypt_kdf(&format!(\"kdf_nosse buflen={buflen}\"), pw, salt, 16, 1, 1, buflen);\n        eq_bytes(&format!(\"_ll vs kdf_nosse buflen={buflen}\"), &o.out, &k.out);\n    }\n}\n\n/// configs: `_ll` salt- and password-length grid (crosses HMAC-SHA256's\n/// 64-byte key-folding boundary on the password), plus randomized inputs.\n#[test]\nfn cfg_scrypt_ll_length_grid() {\n    let mut rng = Rng::new(0x5C_11_1111);\n    for &sl in &[0usize, 1, 4, 32, 63, 64, 65, 200] {\n        for &pl in &[0usize, 1, 8, 63, 64, 65, 200] {\n            let pw = rng.bytes(pl);\n            let salt = rng.bytes(sl);\n            let ctx = format!(\"_ll passwdlen={pl} saltlen={sl}\");\n            let o = scrypt_ll(&ctx, &pw, &salt, 16, 1, 1, 64);\n            eq_ret(&ctx, 0, o.rc);\n        }\n    }\n    for i in 0..40 {\n        let pl = rng.below(150);\n        let sl = rng.below(150);\n        let buflen = rng.below(200);\n        let pw = rng.bytes(pl);\n        let salt = rng.bytes(sl);\n        let ctx = format!(\"_ll random #{i} pl={pl} sl={sl} buflen={buflen}\");\n        let o = scrypt_ll(&ctx, &pw, &salt, 16, 1, 1, buflen);\n        eq_ret(&ctx, 0, o.rc);\n    }\n}\n\n// ---- exported scrypt internals ----\n\n/// configs: `_sodium_escrypt_PBKDF2_SHA256`, the standalone PBKDF2-HMAC-SHA256.\n/// `c = 1` is the only iteration count scrypt itself uses; `c > 1` exercises the\n/// inner `for (j = 2; j <= c; j++)` loop.\n#[test]\nfn cfg_escrypt_pbkdf2() {\n    let mut rng = Rng::new(0xPB_KD as u64 ^ 0x9999);\n    for c in [1u64, 2, 4096] {\n        for dklen in [0usize, 1, 32, 33, 64, 100] {\n            let pw = b\"password\";\n            let salt = b\"NaCl\";\n            let ctx = format!(\"PBKDF2 c={c} dkLen={dklen}\");\n            let o = both::<FnPbkdf2, _>(&ctx, \"_sodium_escrypt_PBKDF2_SHA256\", dklen, |f, p| unsafe {\n                (*f)(pw.as_ptr(), pw.len(), salt.as_ptr(), salt.len(), c, p, dklen);\n                0\n            });\n            assert_eq!(o.rng, 0, \"{ctx}: PBKDF2 draws no randomness\");\n        }\n    }\n    // randomized inputs\n    for i in 0..40 {\n        let pl = rng.below(150);\n        let sl = rng.below(150);\n        let dklen = rng.below(140);\n        let c = 1 + rng.below(4) as u64;\n        let pw = rng.bytes(pl);\n        let salt = rng.bytes(sl);\n        let ctx = format!(\"PBKDF2 random #{i}\");\n        both::<FnPbkdf2, _>(&ctx, \"_sodium_escrypt_PBKDF2_SHA256\", dklen, |f, p| unsafe {\n            (*f)(pw.as_ptr(), pw.len(), salt.as_ptr(), salt.len(), c, p, dklen);\n            0\n        });\n    }\n}\n\n/// configs: `_sodium_escrypt_parse_setting`. `rc` is the offset of the returned\n/// pointer into `setting` (-1 for NULL); the three decoded `uint32_t`s are\n/// captured in the output buffer.\n#[track_caller]\nfn parse_setting(ctx: &str, setting: &str) -> Obs {\n    let sb = cs(setting);\n    both::<FnParseSetting, _>(ctx, \"_sodium_escrypt_parse_setting\", 12, |f, p| unsafe {\n        let mut nl: u32 = 0xDEAD_BEEF;\n        let mut r: u32 = 0xDEAD_BEEF;\n        let mut pp: u32 = 0xDEAD_BEEF;\n        let got = (*f)(sb.as_ptr(), &mut nl, &mut r, &mut pp);\n        ptr::copy_nonoverlapping(nl.to_le_bytes().as_ptr(), p, 4);\n        ptr::copy_nonoverlapping(r.to_le_bytes().as_ptr(), p.add(4), 4);\n        ptr::copy_nonoverlapping(pp.to_le_bytes().as_ptr(), p.add(8), 4);\n        if got.is_null() {\n            -1\n        } else {\n            got.offset_from(sb.as_ptr()) as c_int\n        }\n    })\n}\n\n#[test]\nfn cfg_escrypt_parse_setting() {\n    let o = parse_setting(\"parse_setting TS_SCRYPT_OK\", TS_SCRYPT_OK);\n    eq_ret(\"parse_setting TS_SCRYPT_OK\", 14, o.rc);\n    assert_eq!(u32::from_le_bytes(o.out[0..4].try_into().unwrap()), 10);\n    assert_eq!(u32::from_le_bytes(o.out[4..8].try_into().unwrap()), 8);\n    assert_eq!(u32::from_le_bytes(o.out[8..12].try_into().unwrap()), 1);\n\n    let o = parse_setting(\"parse_setting $7$/6.....6...\", \"$7$/6.....6...\");\n    eq_ret(\"parse_setting $7$/6.....6...\", 14, o.rc);\n    assert_eq!(u32::from_le_bytes(o.out[0..4].try_into().unwrap()), 1);\n    assert_eq!(u32::from_le_bytes(o.out[4..8].try_into().unwrap()), 8);\n    assert_eq!(u32::from_le_bytes(o.out[8..12].try_into().unwrap()), 512);\n}\n\n/// configs: `_sodium_escrypt_gensalt_r` — `$7$` + itoa64(N_log2) + two 30-bit\n/// `encode64_uint32` fields + `encode64(salt)`, 14 + 43 = 57 characters + NUL.\n#[track_caller]\nfn gensalt(ctx: &str, nlog2: u32, r: u32, p: u32, src: &[u8], buflen: usize) -> Obs {\n    both::<FnGensalt, _>(ctx, \"_sodium_escrypt_gensalt_r\", buflen, |f, o| unsafe {\n        let got = (*f)(nlog2, r, p, src.as_ptr(), src.len(), o, buflen);\n        if got.is_null() {\n            0\n        } else if got == o {\n            1\n        } else {\n            -2\n        }\n    })\n}\n\n#[test]\nfn cfg_escrypt_gensalt() {\n    let cases: [(u32, u32, u32, &str); 4] = [\n        (10, 8, 1, \"$7$86..../....\"),\n        (1, 8, 512, \"$7$/6.....6...\"),\n        (20, 8, 1, \"$7$I6..../....\"),\n        (63, 1, 1, \"$7$z/..../....\"),\n    ];\n    for (nlog2, r, p, prefix) in cases {\n        let ctx = format!(\"gensalt({nlog2},{r},{p})\");\n        let o = gensalt(&ctx, nlog2, r, p, &SALT32, 58);\n        eq_ret(&ctx, 1, o.rc);\n        let s = cstr_of(&o.out);\n        assert_eq!(s.len(), 57, \"{ctx}: expected 57 characters, got {s:?}\");\n        assert!(\n            s.starts_with(prefix),\n            \"{ctx}: expected prefix {prefix:?}, got {s:?}\"\n        );\n        // 32 bytes of 'A' -> the `3IE/` repetition seen in TS_SCRYPT_OK\n        assert_eq!(\n            &s[14..],\n            \"3IE/3IE/3IE/3IE/3IE/3IE/3IE/3IE/3IE/3IE/32\",\n            \"{ctx}: salt encoding\"\n        );\n        assert_eq!(o.out[57], 0, \"{ctx}: must be NUL-terminated\");\n    }\n    // the setting produced for (10, 8, 1) is exactly TS_SCRYPT_OK's prefix\n    let o = gensalt(\"gensalt matches TS_SCRYPT_OK\", 10, 8, 1, &SALT32, 58);\n    assert_eq!(cstr_of(&o.out), &TS_SCRYPT_OK[..57]);\n}\n\n/// `_sodium_escrypt_r` driven directly.\n#[track_caller]\nfn escrypt_r(ctx: &str, pw: &[u8], setting: &str, buflen: usize, mode: RngMode) -> Obs {\n    install_rng();\n    let l = libs();\n    let (ic, ir) = l.pair::<FnLocalOp>(\"_sodium_escrypt_init_local\");\n    let (dc, dr) = l.pair::<FnLocalOp>(\"_sodium_escrypt_free_local\");\n    let (fc, fr) = l.pair::<FnEscryptR>(\"_sodium_escrypt_r\");\n    let sb = cs(setting);\n    let _g = rng_lock();\n    set_rng_mode(mode);\n    let run = |init: &FnLocalOp, freel: &FnLocalOp, f: &FnEscryptR| -> Obs {\n        let mut local = EscryptLocal::zeroed();\n        unsafe { assert_eq!((*init)(&mut local), 0, \"{ctx}: escrypt_init_local failed\") };\n        let o = observe(ctx, buflen, &mut |out| unsafe {\n            let got = (*f)(&mut local, pw.as_ptr(), pw.len(), sb.as_ptr(), out, buflen);\n            if got.is_null() {\n                0\n            } else if got == out {\n                1\n            } else {\n                -2\n            }\n        });\n        unsafe { assert_eq!((*freel)(&mut local), 0, \"{ctx}: escrypt_free_local failed\") };\n        o\n    };\n    let a = run(&ic, &dc, &fc);\n    let b = run(&ir, &dr, &fr);\n    cmp_obs(ctx, &a, &b);\n    a\n}\n\n#[test]\nfn cfg_escrypt_r() {\n    // reproduces TS_SCRYPT_OK from its own setting prefix\n    let o = escrypt_r(\"escrypt_r(pass, TS_SCRYPT_OK)\", PW, TS_SCRYPT_OK, 102, RngMode::Fill41);\n    eq_ret(\"escrypt_r(pass, TS_SCRYPT_OK)\", 1, o.rc);\n    assert_eq!(cstr_of(&o.out), TS_SCRYPT_OK);\n    // escrypt_r pre-fills the whole output buffer\n    assert_eq!(o.rng, 102, \"escrypt_r random-byte consumption\");\n\n    // one byte short of `need` -> NULL, and the pre-filled buffer is left as-is\n    let o = escrypt_r(\"escrypt_r buflen=101\", PW, TS_SCRYPT_OK, 101, RngMode::Fill41);\n    eq_ret(\"escrypt_r buflen=101\", 0, o.rc);\n    assert_eq!(o.rng, 101);\n}\n\n/// `_sodium_escrypt_alloc_region` / `_free_region`: the raw region allocator\n/// behind `escrypt_local_t`.\n#[test]\nfn cfg_escrypt_alloc_region() {\n    let l = libs();\n    let (ac, ar) = l.pair::<FnAllocRegion>(\"_sodium_escrypt_alloc_region\");\n    let (fc, fr) = l.pair::<FnLocalOp>(\"_sodium_escrypt_free_region\");\n    for size in [1usize, 63, 64, 65, 4096, 1 << 20] {\n        for (a, f, which) in [(&ac, &fc, \"C\"), (&ar, &fr, \"rust\")] {\n            let mut region = EscryptLocal::zeroed();\n            unsafe {\n                let got = (*(*a))(&mut region, size);\n                assert!(!got.is_null(), \"{which}: alloc_region({size}) returned NULL\");\n                assert_eq!(got, region.aligned, \"{which}: aligned mismatch\");\n                assert_eq!(\n                    (region.aligned as usize) % 64,\n                    0,\n                    \"{which}: region is not 64-byte aligned\"\n                );\n                assert_eq!(region.size, size, \"{which}: region size\");\n                // touch the whole region to prove it is really writable\n                ptr::write_bytes(region.aligned as *mut u8, 0x5A, size);\n                assert_eq!((*(*f))(&mut region), 0, \"{which}: free_region failed\");\n                assert!(region.base.is_null() && region.aligned.is_null());\n                assert_eq!(region.size, 0);\n            }\n        }\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":649,"cache_read_input_tokens":264410,"cache_creation":{"ephemeral_5m_input_tokens":649,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01SaYbLR3rKqJqm44YiZHA4q","session_id":"9da2999f-c365-4559-ba2a-18fcf47e9927","uuid":"dea375f8-d305-4b95-a759-b474ca8b8bcc","timestamp":"2026-08-23T09:08:35.302Z","subagent_type":"general-purpose","task_description":"Write differential tests G7"}
