{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_sbs33z4d2punkibg7p3itfdzet5tfysuhg3zzak4y66dl2s36lsq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Q69bTd137bomQqTnpgrN2n","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-djFIwa/translated_rust/tests/diff_g7.rs","content":"//! G7 differential tests: `crypto_pwhash` (argon2i, argon2id,\n//! scryptsalsa208sha256) and `crypto_kdf` (blake2b, hkdf_sha256, hkdf_sha512).\n//!\n//! Every call goes through `libs().pair(...)`, i.e. through the real dynamic\n//! symbol table of both shared objects. The C `.so` is ground truth.\n//!\n//! Phase B (valid paths)  -> `.phaseA/configs_G7.md`\n//! Phase C (error paths)  -> `.phaseA/errors_G7.md`\n\nmod common;\n\nuse common::*;\nuse std::ffi::{c_char, c_int, c_void};\nuse std::ptr;\nuse std::sync::Mutex;\nuse std::sync::atomic::{AtomicU32, AtomicU64, Ordering};\n\n// ---------------------------------------------------------------------------\n// C signatures\n// ---------------------------------------------------------------------------\n\n/// `crypto_pwhash`, `crypto_pwhash_argon2i`, `crypto_pwhash_argon2id`\ntype FnPwhash = unsafe extern \"C\" fn(\n    *mut u8,       // out\n    u64,           // outlen\n    *const c_char, // passwd\n    u64,           // passwdlen\n    *const u8,     // salt\n    u64,           // opslimit\n    usize,         // memlimit\n    c_int,         // alg\n) -> c_int;\n\n/// `crypto_pwhash_scryptsalsa208sha256`\ntype FnScrypt = unsafe extern \"C\" fn(*mut u8, u64, *const c_char, u64, *const u8, u64, usize) -> c_int;\n\n/// `crypto_pwhash_str`, `crypto_pwhash_argon2i_str`, `..._argon2id_str`,\n/// `crypto_pwhash_scryptsalsa208sha256_str`\ntype FnStr = unsafe extern \"C\" fn(*mut c_char, *const c_char, u64, u64, usize) -> c_int;\n\n/// `crypto_pwhash_str_alg`\ntype FnStrAlg = unsafe extern \"C\" fn(*mut c_char, *const c_char, u64, u64, usize, c_int) -> c_int;\n\n/// `crypto_pwhash*_str_verify`\ntype FnStrVerify = unsafe extern \"C\" fn(*const c_char, *const c_char, u64) -> c_int;\n\n/// `crypto_pwhash*_str_needs_rehash`\ntype FnNeedsRehash = unsafe extern \"C\" fn(*const c_char, u64, usize) -> c_int;\n\n/// `crypto_pwhash_scryptsalsa208sha256_ll`\ntype FnScryptLl =\n    unsafe extern \"C\" fn(*const u8, usize, *const u8, usize, u64, u32, u32, *mut u8, usize) -> c_int;\n\n/// `crypto_kdf_derive_from_key` / `crypto_kdf_blake2b_derive_from_key`\ntype FnKdfDerive = unsafe extern \"C\" fn(*mut u8, usize, u64, *const c_char, *const u8) -> c_int;\n\n/// `crypto_kdf_hkdf_sha*_extract`\ntype FnHkdfExtract = unsafe extern \"C\" fn(*mut u8, *const u8, usize, *const u8, usize) -> c_int;\n/// `crypto_kdf_hkdf_sha*_extract_init` / `_extract_update`\ntype FnHkdfFeed = unsafe extern \"C\" fn(*mut c_void, *const u8, usize) -> c_int;\n/// `crypto_kdf_hkdf_sha*_extract_final`\ntype FnHkdfFinal = unsafe extern \"C\" fn(*mut c_void, *mut u8) -> c_int;\n/// `crypto_kdf_hkdf_sha*_expand`\ntype FnHkdfExpand = unsafe extern \"C\" fn(*mut u8, usize, *const c_char, usize, *const u8) -> c_int;\n/// `crypto_kdf_keygen` and friends\ntype FnKeygen = unsafe extern \"C\" fn(*mut u8);\n\n// ---- exported internals ----\n\n/// `_sodium_argon2i_hash_raw` / `_sodium_argon2id_hash_raw`\ntype FnHashRaw = unsafe extern \"C\" fn(\n    u32,\n    u32,\n    u32,\n    *const c_void,\n    usize,\n    *const c_void,\n    usize,\n    *mut c_void,\n    usize,\n) -> c_int;\n\n/// `_sodium_argon2i_hash_encoded` / `_sodium_argon2id_hash_encoded`\ntype FnHashEncoded = unsafe extern \"C\" fn(\n    u32,\n    u32,\n    u32,\n    *const c_void,\n    usize,\n    *const c_void,\n    usize,\n    usize,\n    *mut c_char,\n    usize,\n) -> c_int;\n\n/// `_sodium_argon2_hash`\ntype FnArgon2Hash = unsafe extern \"C\" fn(\n    u32,\n    u32,\n    u32,\n    *const c_void,\n    usize,\n    *const c_void,\n    usize,\n    *mut c_void,\n    usize,\n    *mut c_char,\n    usize,\n    c_int,\n) -> c_int;\n\n/// `_sodium_argon2_verify`\ntype FnArgon2Verify = unsafe extern \"C\" fn(*const c_char, *const c_void, usize, c_int) -> c_int;\n/// `_sodium_argon2_ctx`\ntype FnArgon2Ctx = unsafe extern \"C\" fn(*mut Argon2Ctx, c_int) -> c_int;\n/// `_sodium_argon2_validate_inputs`\ntype FnArgon2Validate = unsafe extern \"C\" fn(*const Argon2Ctx) -> c_int;\n/// `_sodium_argon2_encode_string`\ntype FnArgon2Encode = unsafe extern \"C\" fn(*mut c_char, usize, *mut Argon2Ctx, c_int) -> c_int;\n/// `_sodium_argon2_decode_string`\ntype FnArgon2Decode = unsafe extern \"C\" fn(*mut Argon2Ctx, *const c_char, c_int) -> c_int;\n/// `_sodium_argon2_initialize`\ntype FnArgon2Initialize = unsafe extern \"C\" fn(*mut c_void, *mut Argon2Ctx) -> c_int;\n/// `_sodium_blake2b_long`\ntype FnBlake2bLong = unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize) -> c_int;\n/// `_crypto_pwhash_argon2_pick_best_implementation`\ntype FnPickBest = unsafe extern \"C\" fn() -> c_int;\n\n/// `_sodium_escrypt_parse_setting`\ntype FnParseSetting = unsafe extern \"C\" fn(*const u8, *mut u32, *mut u32, *mut u32) -> *const u8;\n/// `_sodium_escrypt_r`\ntype FnEscryptR =\n    unsafe extern \"C\" fn(*mut EscryptLocal, *const u8, usize, *const u8, *mut u8, usize) -> *mut u8;\n/// `_sodium_escrypt_gensalt_r`\ntype FnGensalt = unsafe extern \"C\" fn(u32, u32, u32, *const u8, usize, *mut u8, usize) -> *mut u8;\n/// `_sodium_escrypt_kdf_nosse`\ntype FnEscryptKdf = unsafe extern \"C\" fn(\n    *mut EscryptLocal,\n    *const u8,\n    usize,\n    *const u8,\n    usize,\n    u64,\n    u32,\n    u32,\n    *mut u8,\n    usize,\n) -> c_int;\n/// `_sodium_escrypt_init_local` / `_sodium_escrypt_free_local` / `_free_region`\ntype FnLocalOp = unsafe extern \"C\" fn(*mut EscryptLocal) -> c_int;\n/// `_sodium_escrypt_alloc_region`\ntype FnAllocRegion = unsafe extern \"C\" fn(*mut EscryptLocal, usize) -> *mut c_void;\n/// `_sodium_escrypt_PBKDF2_SHA256`\ntype FnPbkdf2 = unsafe extern \"C\" fn(*const u8, usize, *const u8, usize, u64, *mut u8, usize);\n\n// ---------------------------------------------------------------------------\n// mirrored C structs\n// ---------------------------------------------------------------------------\n\n/// `typedef struct Argon2_Context { ... } argon2_context;` from `argon2.h`,\n/// field for field.\n#[repr(C)]\n#[derive(Clone, Copy)]\nstruct Argon2Ctx {\n    out: *mut u8,\n    outlen: u32,\n    pwd: *mut u8,\n    pwdlen: u32,\n    salt: *mut u8,\n    saltlen: u32,\n    secret: *mut u8,\n    secretlen: u32,\n    ad: *mut u8,\n    adlen: u32,\n    t_cost: u32,\n    m_cost: u32,\n    lanes: u32,\n    threads: u32,\n    flags: u32,\n}\n\nimpl Argon2Ctx {\n    const fn zeroed() -> Self {\n        Argon2Ctx {\n            out: ptr::null_mut(),\n            outlen: 0,\n            pwd: ptr::null_mut(),\n            pwdlen: 0,\n            salt: ptr::null_mut(),\n            saltlen: 0,\n            secret: ptr::null_mut(),\n            secretlen: 0,\n            ad: ptr::null_mut(),\n            adlen: 0,\n            t_cost: 0,\n            m_cost: 0,\n            lanes: 0,\n            threads: 0,\n            flags: 0,\n        }\n    }\n}\n\n/// `typedef struct { void *base, *aligned; size_t size; } escrypt_region_t;`\n#[repr(C)]\n#[derive(Clone, Copy)]\nstruct EscryptLocal {\n    base: *mut c_void,\n    aligned: *mut c_void,\n    size: usize,\n}\n\nimpl EscryptLocal {\n    const fn zeroed() -> Self {\n        EscryptLocal {\n            base: ptr::null_mut(),\n            aligned: ptr::null_mut(),\n            size: 0,\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// constants\n// ---------------------------------------------------------------------------\n\nconst EFBIG: c_int = 27;\nconst SIGABRT: i32 = 6;\n\n/// A value no libsodium path ever sets, so `errno == ERRNO_SENTINEL` after a\n/// call proves the library left `errno` alone.\nconst ERRNO_SENTINEL: c_int = 24301;\n\nconst GUARD: usize = 16;\nconst FILL: u8 = 0xA5;\n\nconst ARGON2I13: c_int = 1;\nconst ARGON2ID13: c_int = 2;\n\n// argon2 error enum values used below\nconst ARGON2_OK: c_int = 0;\nconst ARGON2_OUTPUT_PTR_NULL: c_int = -1;\nconst ARGON2_OUTPUT_TOO_SHORT: c_int = -2;\nconst ARGON2_SALT_TOO_SHORT: c_int = -6;\nconst ARGON2_TIME_TOO_SMALL: c_int = -12;\nconst ARGON2_MEMORY_TOO_LITTLE: c_int = -14;\nconst ARGON2_LANES_TOO_FEW: c_int = -16;\nconst ARGON2_LANES_TOO_MANY: c_int = -17;\nconst ARGON2_PWD_PTR_MISMATCH: c_int = -18;\nconst ARGON2_SALT_PTR_MISMATCH: c_int = -19;\nconst ARGON2_SECRET_PTR_MISMATCH: c_int = -20;\nconst ARGON2_AD_PTR_MISMATCH: c_int = -21;\nconst ARGON2_INCORRECT_PARAMETER: c_int = -25;\nconst ARGON2_INCORRECT_TYPE: c_int = -26;\nconst ARGON2_ENCODING_FAIL: c_int = -31;\nconst ARGON2_DECODING_FAIL: c_int = -32;\nconst ARGON2_VERIFY_MISMATCH: c_int = -35;\n\n/// 16 bytes of `'A'` — the argon2 salt produced by the 0x41-fill RNG.\nconst SALT16: [u8; 16] = [0x41; 16];\n/// 32 bytes of `'A'` — the scrypt salt produced by the 0x41-fill RNG.\nconst SALT32: [u8; 32] = [0x41; 32];\n\nfn key32() -> [u8; 32] {\n    let mut k = [0u8; 32];\n    for (i, b) in k.iter_mut().enumerate() {\n        *b = i as u8;\n    }\n    k\n}\n\nconst CTX8: &[u8; 8] = b\"context1\";\n\n// ---- the reusable test strings from `.phaseA/errors_G7.md` ----\n\nconst TS_ARGON2ID_OK: &str =\n    \"$argon2id$v=19$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dztU\";\nconst TS_ARGON2I_OK: &str =\n    \"$argon2i$v=19$m=8,t=3,p=1$QUFBQUFBQUFBQUFBQUFBQQ$YPE4kdb9R8cegvWsL2M9A3uBJKJIDXK6rZ1OCSeXgbA\";\nconst TS_ARGON2ID_EMPTYPW: &str =\n    \"$argon2id$v=19$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$YPPDcMmhArJ84pJyRpkzAAmPekCzJYTNdX1T65uMKVs\";\nconst TS_SCRYPT_OK: &str = \"$7$86..../..../3IE/3IE/3IE/3IE/3IE/3IE/3IE/3IE/3IE/3IE/32$\\\n                            Le93rphnzLsDY426PuxmZo3dQivk6Kn9nyUxGQ4WCC6\";\n\n// prefix-mismatch set (generic dispatcher rejects with EINVAL)\nconst TS_EMPTY: &str = \"\";\nconst TS_DOLLAR: &str = \"$\";\nconst TS_TRUNC_TAG: &str = \"$argon2id\";\nconst TS_UNKNOWN_ALG: &str =\n    \"$argon2xx$v=19$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dztU\";\n\n// decoding failures (errno untouched under `_str_verify`)\nconst TS_NO_PARAMS: &str = \"$argon2id$\";\nconst TS_BAD_V18: &str =\n    \"$argon2id$v=18$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dztU\";\nconst TS_NO_V: &str =\n    \"$argon2id$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dztU\";\nconst TS_V_PLUS: &str = \"$argon2id$v=+19$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$QUFBQUFBQUFBQUFBQUFBQQ\";\nconst TS_V_LEADING_ZERO: &str =\n    \"$argon2id$v=019$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$QUFBQUFBQUFBQUFBQUFBQQ\";\nconst TS_V_OVERFLOW: &str =\n    \"$argon2id$v=4294967296$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$QUFBQUFBQUFBQUFBQUFBQQ\";\nconst TS_M_LEADING_ZERO: &str =\n    \"$argon2id$v=19$m=08,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dztU\";\nconst TS_M_OVERFLOW: &str =\n    \"$argon2id$v=19$m=4294967296,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$QUFBQUFBQUFBQUFBQUFBQQ\";\nconst TS_M7: &str = \"$argon2id$v=19$m=7,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$QUFBQUFBQUFBQUFBQUFBQQ\";\nconst TS_M8_P2: &str = \"$argon2id$v=19$m=8,t=1,p=2$QUFBQUFBQUFBQUFBQUFBQQ$QUFBQUFBQUFBQUFBQUFBQQ\";\nconst TS_T0: &str =\n    \"$argon2id$v=19$m=8,t=0,p=1$QUFBQUFBQUFBQUFBQUFBQQ$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dztU\";\nconst TS_P0: &str =\n    \"$argon2id$v=19$m=8,t=1,p=0$QUFBQUFBQUFBQUFBQUFBQQ$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dztU\";\nconst TS_P_TOO_MANY: &str =\n    \"$argon2id$v=19$m=134217728,t=1,p=16777216$QUFBQUFBQUFBQUFBQUFBQQ$QUFBQUFBQUFBQUFBQUFBQQ\";\nconst TS_REORDER: &str =\n    \"$argon2id$v=19$t=1,m=8,p=1$QUFBQUFBQUFBQUFBQUFBQQ$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dztU\";\nconst TS_EMPTY_SALT: &str = \"$argon2id$v=19$m=8,t=1,p=1$$QUFBQUFBQUFBQUFBQUFBQQ\";\nconst TS_SALT6: &str =\n    \"$argon2id$v=19$m=8,t=1,p=1$QUFBQUFB$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dztU\";\nconst TS_BAD_B64_SALT: &str =\n    \"$argon2id$v=19$m=8,t=1,p=1$!!!!$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dztU\";\nconst TS_SHORT_HASH: &str = \"$argon2id$v=19$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$QUFBQUFBQUFBQUFB\";\nconst TS_NO_HASH: &str = \"$argon2id$v=19$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ\";\nconst TS_B64_PAD: &str =\n    \"$argon2id$v=19$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dzt=\";\nconst TS_TRAIL_DOLLAR: &str =\n    \"$argon2id$v=19$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dztU$\";\n\n// well-formed but mismatching (errno = EINVAL)\nconst TS_TRUNC_HASH: &str =\n    \"$argon2id$v=19$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dzt\";\nconst TS_EXTRA_HASH: &str =\n    \"$argon2id$v=19$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$/XzkRtj6uwZ6Prg57MFBV+IfYMn6+Di2zIC/dh2dztUX\";\nconst TS_GARBAGE_HASH: &str =\n    \"$argon2id$v=19$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$QUFBQUFBQUFBQUFBQUFBQQ\";\nconst TS_LANES2_OK_FORMAT: &str =\n    \"$argon2id$v=19$m=16,t=1,p=2$QUFBQUFBQUFBQUFBQUFBQQ$QUFBQUFBQUFBQUFBQUFBQQ\";\n/// `t=4294967295` — exercises the ten-digit decimal path without running 2^32\n/// argon2 passes (see configs row \"OPSLIMIT_MAX ... DO NOT run\").\nconst TS_T_U32MAX: &str =\n    \"$argon2id$v=19$m=8,t=4294967295,p=1$QUFBQUFBQUFBQUFBQUFBQQ$QUFBQUFBQUFBQUFBQUFBQQ\";\n\nconst TS_SCRYPT_BAD_MAGIC: &str = \"$8$86..../..../3IE/3IE/3IE/3IE/3IE/3IE/3IE/3IE/3IE/3IE/32$\\\n                                  Le93rphnzLsDY426PuxmZo3dQivk6Kn9nyUxGQ4WCC6\";\nconst TS_SCRYPT_BAD_SETTING: &str = \"$7$!6..../..../3IE/3IE/3IE/3IE/3IE/3IE/3IE/3IE/3IE/3IE/32$\\\n                                    Le93rphnzLsDY426PuxmZo3dQivk6Kn9nyUxGQ4WCC6\";\nconst TS_SCRYPT_SETTING_ONLY: &str = \"$7$86..../....\";\n\n// ---------------------------------------------------------------------------\n// small utilities\n// ---------------------------------------------------------------------------\n\nfn hexs(b: &[u8]) -> String {\n    let mut s = String::with_capacity(b.len() * 2);\n    for x in b {\n        s.push_str(&format!(\"{x:02x}\"));\n    }\n    s\n}\n\nfn unhex(s: &str) -> Vec<u8> {\n    let clean: Vec<u8> = s.bytes().filter(|c| !c.is_ascii_whitespace()).collect();\n    assert!(clean.len() % 2 == 0, \"odd-length hex literal\");\n    clean\n        .chunks(2)\n        .map(|c| {\n            u8::from_str_radix(std::str::from_utf8(c).unwrap(), 16).expect(\"bad hex literal\")\n        })\n        .collect()\n}\n\n/// NUL-terminated copy of `s`, for passing to `const char *` parameters.\nfn cs(s: &str) -> Vec<u8> {\n    let mut v = s.as_bytes().to_vec();\n    v.push(0);\n    v\n}\n\n/// Assert an absolute reference value captured from the C build. On failure the\n/// full observed buffer is printed so the anchor can be re-derived.\n#[track_caller]\nfn assert_anchor(ctx: &str, got: &[u8], want_hex: &str) {\n    let want = unhex(want_hex);\n    assert!(\n        got.len() >= want.len(),\n        \"{ctx}: buffer is {} bytes, anchor needs {}\",\n        got.len(),\n        want.len()\n    );\n    assert_eq!(\n        &got[..want.len()],\n        &want[..],\n        \"{ctx}: reference digest mismatch\\n  want {}\\n  got  {}\",\n        hexs(&want),\n        hexs(got)\n    );\n}\n\n#[track_caller]\nfn assert_zeroed(ctx: &str, s: &[u8]) {\n    if let Some(i) = s.iter().position(|&b| b != 0) {\n        panic!(\n            \"{ctx}: expected the output buffer to be zeroed, but byte {i} is {:#04x}\\n  {}\",\n            s[i],\n            hexs(s)\n        );\n    }\n}\n\n#[track_caller]\nfn assert_untouched(ctx: &str, s: &[u8]) {\n    if let Some(i) = s.iter().position(|&b| b != FILL) {\n        panic!(\n            \"{ctx}: expected the output buffer to be untouched, but byte {i} is {:#04x}\\n  {}\",\n            s[i],\n            hexs(s)\n        );\n    }\n}\n\n/// The NUL-terminated string at the start of `buf`, as a `String`.\nfn cstr_of(buf: &[u8]) -> String {\n    let n = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());\n    String::from_utf8_lossy(&buf[..n]).into_owned()\n}\n\n// ---------------------------------------------------------------------------\n// injected randombytes implementation (shared by BOTH libraries)\n// ---------------------------------------------------------------------------\n//\n// `crypto_pwhash_*_str` embeds a random salt, `argon2_hash()` pre-fills the raw\n// hash buffer with `randombytes_buf()`, and `escrypt_r()` pre-fills its output\n// buffer. So the injected stream must be identical for both libraries AND the\n// number of bytes consumed is itself an observable (see the consumption table in\n// `.phaseA/configs_G7.md`).\n//\n// Two modes:\n//   * `Counter(seed)`  — a distinct byte per stream position: catches\n//                        ordering/offset bugs that a constant fill would hide.\n//   * `Fill41`         — every byte `0x41`, reproducing the exact reference\n//                        strings recorded in the Phase-A spec.\n\nconst MODE_COUNTER: u32 = 0;\nconst MODE_FILL41: u32 = 1;\n\nstatic RNG_POS: AtomicU64 = AtomicU64::new(0);\nstatic RNG_SEED: AtomicU64 = AtomicU64::new(0);\nstatic RNG_MODE: AtomicU32 = AtomicU32::new(MODE_COUNTER);\n\n/// Serialises every test that touches the injected RNG: the implementation and\n/// its position counter are process-global and shared by both `.so`s.\nstatic RNG_LOCK: Mutex<()> = Mutex::new(());\n\nfn rng_lock() -> std::sync::MutexGuard<'static, ()> {\n    RNG_LOCK.lock().unwrap_or_else(|e| e.into_inner())\n}\n\n#[derive(Copy, Clone, Debug)]\nenum RngMode {\n    Fill41,\n    Counter(u64),\n}\n\nfn rng_byte_at(seed: u64, pos: u64) -> u8 {\n    let mut z = seed.wrapping_add(pos.wrapping_mul(0x9E37_79B9_7F4A_7C15));\n    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n    ((z ^ (z >> 31)) >> 24) as u8\n}\n\nextern \"C\" fn g7_name() -> *const c_char {\n    c\"difftest_g7\".as_ptr()\n}\n\nextern \"C\" fn g7_stir() {}\n\nextern \"C\" fn g7_buf(buf: *mut c_void, size: usize) {\n    let start = RNG_POS.fetch_add(size as u64, Ordering::SeqCst);\n    if buf.is_null() || size == 0 {\n        return;\n    }\n    let fill41 = RNG_MODE.load(Ordering::SeqCst) == MODE_FILL41;\n    let seed = RNG_SEED.load(Ordering::SeqCst);\n    let p = buf as *mut u8;\n    for i in 0..size {\n        let b = if fill41 {\n            0x41\n        } else {\n            rng_byte_at(seed, start + i as u64)\n        };\n        unsafe { *p.add(i) = b };\n    }\n}\n\nextern \"C\" fn g7_random() -> u32 {\n    let mut b = [0u8; 4];\n    g7_buf(b.as_mut_ptr() as *mut c_void, 4);\n    u32::from_le_bytes(b)\n}\n\nextern \"C\" fn g7_close() -> c_int {\n    0\n}\n\nstatic G7_IMPL: RandombytesImpl = RandombytesImpl {\n    implementation_name: Some(g7_name),\n    random: Some(g7_random),\n    stir: Some(g7_stir),\n    uniform: None,\n    buf: Some(g7_buf),\n    close: Some(g7_close),\n};\n\nstatic G7_INJECTED: std::sync::OnceLock<()> = std::sync::OnceLock::new();\n\nfn install_rng() {\n    let l = libs();\n    G7_INJECTED.get_or_init(|| {\n        let (fc, fr) = l.pair::<unsafe extern \"C\" fn(*const RandombytesImpl) -> c_int>(\n            \"randombytes_set_implementation\",\n        );\n        unsafe {\n            let p: *const RandombytesImpl = &G7_IMPL;\n            assert_eq!(fc(p), 0, \"C randombytes_set_implementation failed\");\n            assert_eq!(fr(p), 0, \"rust randombytes_set_implementation failed\");\n        }\n        let n = str_accessor(\"randombytes_implementation_name\");\n        assert_eq!(n, \"difftest_g7\", \"randombytes injection did not take effect\");\n    });\n}\n\nfn set_rng_mode(m: RngMode) {\n    match m {\n        RngMode::Fill41 => {\n            RNG_MODE.store(MODE_FILL41, Ordering::SeqCst);\n            RNG_SEED.store(0, Ordering::SeqCst);\n        }\n        RngMode::Counter(seed) => {\n            RNG_MODE.store(MODE_COUNTER, Ordering::SeqCst);\n            RNG_SEED.store(seed, Ordering::SeqCst);\n        }\n    }\n}\n\nfn rng_rewind() {\n    RNG_POS.store(0, Ordering::SeqCst);\n}\n\nfn rng_used() -> u64 {\n    RNG_POS.load(Ordering::SeqCst)\n}\n\n// ---------------------------------------------------------------------------\n// the workhorse comparison driver\n// ---------------------------------------------------------------------------\n\n/// Everything observable about one call into one library.\n#[derive(Debug, Clone, PartialEq, Eq)]\nstruct Obs {\n    rc: c_int,\n    out: Vec<u8>,\n    errno: c_int,\n    /// bytes drawn from the injected `randombytes` implementation\n    rng: u64,\n}\n\n#[track_caller]\nfn cmp_obs(ctx: &str, a: &Obs, b: &Obs) {\n    eq_ret(ctx, a.rc, b.rc);\n    eq_bytes(ctx, &a.out, &b.out);\n    assert_eq!(\n        a.errno, b.errno,\n        \"{ctx}: errno differs: C={} rust={} (rc C={} rust={})\",\n        a.errno, b.errno, a.rc, b.rc\n    );\n    assert_eq!(\n        a.rng, b.rng,\n        \"{ctx}: random bytes consumed differ: C={} rust={}\",\n        a.rng, b.rng\n    );\n}\n\nfn observe(ctx: &str, buflen: usize, run: &mut dyn FnMut(*mut u8) -> c_int) -> Obs {\n    let mut buf = vec![FILL; buflen + GUARD];\n    rng_rewind();\n    set_errno(ERRNO_SENTINEL);\n    let rc = run(buf.as_mut_ptr());\n    let e = errno();\n    let used = rng_used();\n    for i in buflen..buflen + GUARD {\n        assert_eq!(\n            buf[i], FILL,\n            \"{ctx}: guard byte {} past the {buflen}-byte output buffer was clobbered\",\n            i - buflen\n        );\n    }\n    buf.truncate(buflen);\n    Obs {\n        rc,\n        out: buf,\n        errno: e,\n        rng: used,\n    }\n}\n\n/// Resolve `sym` in both libraries, run `f` against each with a fresh\n/// guard-padded output buffer and a rewound RNG, and assert every observable\n/// matches. Returns the (shared) observation.\n#[track_caller]\nfn both_m<T, F>(ctx: &str, sym: &str, buflen: usize, mode: RngMode, mut f: F) -> Obs\nwhere\n    F: FnMut(&T, *mut u8) -> c_int,\n{\n    install_rng();\n    let l = libs();\n    let (fc, fr) = l.pair::<T>(sym);\n    let _g = rng_lock();\n    set_rng_mode(mode);\n    let a = observe(ctx, buflen, &mut |p| f(&fc, p));\n    let b = observe(ctx, buflen, &mut |p| f(&fr, p));\n    cmp_obs(ctx, &a, &b);\n    a\n}\n\n/// `both_m` with the default counter-mode RNG.\n#[track_caller]\nfn both<T, F>(ctx: &str, sym: &str, buflen: usize, f: F) -> Obs\nwhere\n    F: FnMut(&T, *mut u8) -> c_int,\n{\n    both_m(ctx, sym, buflen, RngMode::Counter(0x5EED_0007), f)\n}\n\n// ---------------------------------------------------------------------------\n// Phase B — constant accessors (configs rows 1..15)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn cfg_alg_accessors() {\n    assert_eq!(int_accessor(\"crypto_pwhash_alg_argon2i13\"), 1);\n    assert_eq!(int_accessor(\"crypto_pwhash_alg_argon2id13\"), 2);\n    assert_eq!(int_accessor(\"crypto_pwhash_alg_default\"), 2);\n    assert_eq!(int_accessor(\"crypto_pwhash_argon2i_alg_argon2i13\"), 1);\n    assert_eq!(int_accessor(\"crypto_pwhash_argon2id_alg_argon2id13\"), 2);\n}\n\n#[test]\nfn cfg_pwhash_generic_accessors() {\n    assert_eq!(size_accessor(\"crypto_pwhash_bytes_min\"), 16);\n    assert_eq!(size_accessor(\"crypto_pwhash_bytes_max\"), 4294967295);\n    assert_eq!(size_accessor(\"crypto_pwhash_passwd_min\"), 0);\n    assert_eq!(size_accessor(\"crypto_pwhash_passwd_max\"), 4294967295);\n    assert_eq!(size_accessor(\"crypto_pwhash_saltbytes\"), 16);\n    assert_eq!(size_accessor(\"crypto_pwhash_strbytes\"), 128);\n\n    assert_eq!(u64_accessor(\"crypto_pwhash_opslimit_min\"), 1);\n    assert_eq!(u64_accessor(\"crypto_pwhash_opslimit_max\"), 4294967295);\n    assert_eq!(size_accessor(\"crypto_pwhash_memlimit_min\"), 8192);\n    assert_eq!(size_accessor(\"crypto_pwhash_memlimit_max\"), 4398046510080);\n\n    assert_eq!(u64_accessor(\"crypto_pwhash_opslimit_interactive\"), 2);\n    assert_eq!(size_accessor(\"crypto_pwhash_memlimit_interactive\"), 67108864);\n    assert_eq!(u64_accessor(\"crypto_pwhash_opslimit_moderate\"), 3);\n    assert_eq!(size_accessor(\"crypto_pwhash_memlimit_moderate\"), 268435456);\n    assert_eq!(u64_accessor(\"crypto_pwhash_opslimit_sensitive\"), 4);\n    assert_eq!(size_accessor(\"crypto_pwhash_memlimit_sensitive\"), 1073741824);\n\n    assert_eq!(str_accessor(\"crypto_pwhash_strprefix\"), \"$argon2id$\");\n    assert_eq!(str_accessor(\"crypto_pwhash_primitive\"), \"argon2id,argon2i\");\n}\n\n#[test]\nfn cfg_argon2i_accessors() {\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2i_bytes_min\"), 16);\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2i_bytes_max\"), 4294967295);\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2i_passwd_min\"), 0);\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2i_passwd_max\"), 4294967295);\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2i_saltbytes\"), 16);\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2i_strbytes\"), 128);\n    assert_eq!(str_accessor(\"crypto_pwhash_argon2i_strprefix\"), \"$argon2i$\");\n\n    // OPSLIMIT_MIN is 3 for argon2i, not 1.\n    assert_eq!(u64_accessor(\"crypto_pwhash_argon2i_opslimit_min\"), 3);\n    assert_eq!(u64_accessor(\"crypto_pwhash_argon2i_opslimit_max\"), 4294967295);\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2i_memlimit_min\"), 8192);\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_argon2i_memlimit_max\"),\n        4398046510080\n    );\n\n    assert_eq!(u64_accessor(\"crypto_pwhash_argon2i_opslimit_interactive\"), 4);\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_argon2i_memlimit_interactive\"),\n        33554432\n    );\n    assert_eq!(u64_accessor(\"crypto_pwhash_argon2i_opslimit_moderate\"), 6);\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_argon2i_memlimit_moderate\"),\n        134217728\n    );\n    assert_eq!(u64_accessor(\"crypto_pwhash_argon2i_opslimit_sensitive\"), 8);\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_argon2i_memlimit_sensitive\"),\n        536870912\n    );\n}\n\n#[test]\nfn cfg_argon2id_accessors() {\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2id_bytes_min\"), 16);\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2id_bytes_max\"), 4294967295);\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2id_passwd_min\"), 0);\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2id_passwd_max\"), 4294967295);\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2id_saltbytes\"), 16);\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2id_strbytes\"), 128);\n    assert_eq!(\n        str_accessor(\"crypto_pwhash_argon2id_strprefix\"),\n        \"$argon2id$\"\n    );\n\n    assert_eq!(u64_accessor(\"crypto_pwhash_argon2id_opslimit_min\"), 1);\n    assert_eq!(\n        u64_accessor(\"crypto_pwhash_argon2id_opslimit_max\"),\n        4294967295\n    );\n    assert_eq!(size_accessor(\"crypto_pwhash_argon2id_memlimit_min\"), 8192);\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_argon2id_memlimit_max\"),\n        4398046510080\n    );\n\n    assert_eq!(u64_accessor(\"crypto_pwhash_argon2id_opslimit_interactive\"), 2);\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_argon2id_memlimit_interactive\"),\n        67108864\n    );\n    assert_eq!(u64_accessor(\"crypto_pwhash_argon2id_opslimit_moderate\"), 3);\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_argon2id_memlimit_moderate\"),\n        268435456\n    );\n    assert_eq!(u64_accessor(\"crypto_pwhash_argon2id_opslimit_sensitive\"), 4);\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_argon2id_memlimit_sensitive\"),\n        1073741824\n    );\n}\n\n#[test]\nfn cfg_scrypt_accessors() {\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_scryptsalsa208sha256_bytes_min\"),\n        16\n    );\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_scryptsalsa208sha256_bytes_max\"),\n        137438953440\n    );\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_scryptsalsa208sha256_passwd_min\"),\n        0\n    );\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_scryptsalsa208sha256_passwd_max\"),\n        usize::MAX\n    );\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_scryptsalsa208sha256_saltbytes\"),\n        32\n    );\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_scryptsalsa208sha256_strbytes\"),\n        102\n    );\n    assert_eq!(\n        str_accessor(\"crypto_pwhash_scryptsalsa208sha256_strprefix\"),\n        \"$7$\"\n    );\n\n    assert_eq!(\n        u64_accessor(\"crypto_pwhash_scryptsalsa208sha256_opslimit_min\"),\n        32768\n    );\n    assert_eq!(\n        u64_accessor(\"crypto_pwhash_scryptsalsa208sha256_opslimit_max\"),\n        4294967295\n    );\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_scryptsalsa208sha256_memlimit_min\"),\n        16777216\n    );\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_scryptsalsa208sha256_memlimit_max\"),\n        68719476736\n    );\n    assert_eq!(\n        u64_accessor(\"crypto_pwhash_scryptsalsa208sha256_opslimit_interactive\"),\n        524288\n    );\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_scryptsalsa208sha256_memlimit_interactive\"),\n        16777216\n    );\n    assert_eq!(\n        u64_accessor(\"crypto_pwhash_scryptsalsa208sha256_opslimit_sensitive\"),\n        33554432\n    );\n    assert_eq!(\n        size_accessor(\"crypto_pwhash_scryptsalsa208sha256_memlimit_sensitive\"),\n        1073741824\n    );\n\n    // scrypt deliberately has NO moderate preset.\n    let l = libs();\n    assert!(\n        !l.has(\"crypto_pwhash_scryptsalsa208sha256_opslimit_moderate\"),\n        \"scrypt must not export an OPSLIMIT_MODERATE accessor\"\n    );\n    assert!(\n        !l.has(\"crypto_pwhash_scryptsalsa208sha256_memlimit_moderate\"),\n        \"scrypt must not export a MEMLIMIT_MODERATE accessor\"\n    );\n}\n\n#[test]\nfn cfg_kdf_accessors() {\n    assert_eq!(size_accessor(\"crypto_kdf_bytes_min\"), 16);\n    assert_eq!(size_accessor(\"crypto_kdf_bytes_max\"), 64);\n    assert_eq!(size_accessor(\"crypto_kdf_contextbytes\"), 8);\n    assert_eq!(size_accessor(\"crypto_kdf_keybytes\"), 32);\n    assert_eq!(str_accessor(\"crypto_kdf_primitive\"), \"blake2b\");\n\n    assert_eq!(size_accessor(\"crypto_kdf_blake2b_bytes_min\"), 16);\n    assert_eq!(size_accessor(\"crypto_kdf_blake2b_bytes_max\"), 64);\n    assert_eq!(size_accessor(\"crypto_kdf_blake2b_contextbytes\"), 8);\n    assert_eq!(size_accessor(\"crypto_kdf_blake2b_keybytes\"), 32);\n}\n\n#[test]\nfn cfg_hkdf_accessors() {\n    assert_eq!(size_accessor(\"crypto_kdf_hkdf_sha256_keybytes\"), 32);\n    assert_eq!(size_accessor(\"crypto_kdf_hkdf_sha256_bytes_min\"), 0);\n    assert_eq!(size_accessor(\"crypto_kdf_hkdf_sha256_bytes_max\"), 8160);\n    assert_eq!(size_accessor(\"crypto_kdf_hkdf_sha256_statebytes\"), 208);\n\n    assert_eq!(size_accessor(\"crypto_kdf_hkdf_sha512_keybytes\"), 64);\n    assert_eq!(size_accessor(\"crypto_kdf_hkdf_sha512_bytes_min\"), 0);\n    assert_eq!(size_accessor(\"crypto_kdf_hkdf_sha512_bytes_max\"), 16320);\n    assert_eq!(size_accessor(\"crypto_kdf_hkdf_sha512_statebytes\"), 416);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4235,"cache_read_input_tokens":208164,"cache_creation":{"ephemeral_5m_input_tokens":4235,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01SaYbLR3rKqJqm44YiZHA4q","session_id":"9da2999f-c365-4559-ba2a-18fcf47e9927","uuid":"a9d8dfa4-da2b-4e32-b208-8f83250ff908","timestamp":"2026-08-23T09:00:24.851Z","subagent_type":"general-purpose","task_description":"Write differential tests G7"}
