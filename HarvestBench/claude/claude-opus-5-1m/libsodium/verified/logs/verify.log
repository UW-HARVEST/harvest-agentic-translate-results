{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011PLKzFDc3arhsciRwTaoea","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Both the C reference `.so` (`c_src/build/libsodium.so`) and the Rust\n4\t//! `.so` (`target/<profile>/liblibsodium.so`) are loaded with `libloading`\n5\t//! and driven **only** through their exported symbols, exactly as an external\n6\t//! `dlopen` consumer would. No Rust function is ever called directly, so the\n7\t//! `#[no_mangle]` / `extern \"C\"` export wrappers are part of what is tested.\n8\t\n9\t#![allow(dead_code)]\n10\t\n11\tuse libloading::{Library, Symbol};\n12\tuse std::ffi::c_void;\n13\tuse std::path::PathBuf;\n14\tuse std::sync::OnceLock;\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// library loading\n18\t// ---------------------------------------------------------------------------\n19\t\n20\tstatic C_LIB: OnceLock<Library> = OnceLock::new();\n21\tstatic R_LIB: OnceLock<Library> = OnceLock::new();\n22\t\n23\tfn c_so_path() -> PathBuf {\n24\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"c_src/build/libsodium.so\")\n25\t}\n26\t\n27\tfn r_so_path() -> PathBuf {\n28\t    // current_exe = <target>/<profile>/deps/<testbin>\n29\t    let exe = std::env::current_exe().expect(\"current_exe\");\n30\t    let deps = exe.parent().expect(\"deps dir\");\n31\t    let profile = deps.parent().expect(\"profile dir\");\n32\t    for cand in [\n33\t        profile.join(\"liblibsodium.so\"),\n34\t        deps.join(\"liblibsodium.so\"),\n35\t    ] {\n36\t        if cand.exists() {\n37\t            return cand;\n38\t        }\n39\t    }\n40\t    panic!(\n41\t        \"Rust cdylib liblibsodium.so not found next to {:?}; run `cargo build` first\",\n42\t        exe\n43\t    );\n44\t}\n45\t\n46\tpub fn c_lib() -> &'static Library {\n47\t    C_LIB.get_or_init(|| {\n48\t        let p = c_so_path();\n49\t        assert!(\n50\t            p.exists(),\n51\t            \"C shared library missing at {p:?}. Build it with:\\n  \\\n52\t             cd c_src && mkdir -p build && cd build && \\\n53\t             cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\"\n54\t        );\n55\t        unsafe { Library::new(&p) }.unwrap_or_else(|e| panic!(\"dlopen {p:?}: {e}\"))\n56\t    })\n57\t}\n58\t\n59\tpub fn r_lib() -> &'static Library {\n60\t    R_LIB.get_or_init(|| {\n61\t        let p = r_so_path();\n62\t        unsafe { Library::new(&p) }.unwrap_or_else(|e| panic!(\"dlopen {p:?}: {e}\"))\n63\t    })\n64\t}\n65\t\n66\t/// Look a symbol up in one library, transmuting it to the requested fn type.\n67\tpub fn sym<T: Copy>(lib: &'static Library, name: &str) -> T {\n68\t    let s: Symbol<T> = unsafe { lib.get(name.as_bytes()) }\n69\t        .unwrap_or_else(|e| panic!(\"symbol `{name}` not found: {e}\"));\n70\t    *s\n71\t}\n72\t\n73\t/// Look the same symbol up in **both** libraries: `(c_fn, rust_fn)`.\n74\tpub fn pair<T: Copy>(name: &str) -> (T, T) {\n75\t    (sym::<T>(c_lib(), name), sym::<T>(r_lib(), name))\n76\t}\n77\t\n78\t/// `true` when the symbol is present in both libraries.\n79\tpub fn has_sym(name: &str) -> bool {\n80\t    unsafe { c_lib().get::<*const c_void>(name.as_bytes()) }.is_ok()\n81\t        && unsafe { r_lib().get::<*const c_void>(name.as_bytes()) }.is_ok()\n82\t}\n83\t\n84\t// ---------------------------------------------------------------------------\n85\t// deterministic PRNG for the *test driver* (reproducible inputs)\n86\t// ---------------------------------------------------------------------------\n87\t\n88\t/// splitmix64 — tiny, fixed, reproducible.\n89\tpub struct Rng(u64);\n90\t\n91\timpl Rng {\n92\t    pub fn new(seed: u64) -> Self {\n93\t        Rng(seed.wrapping_add(0x9E37_79B9_7F4A_7C15))\n94\t    }\n95\t    pub fn next_u64(&mut self) -> u64 {\n96\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n97\t        let mut z = self.0;\n98\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n99\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n100\t        z ^ (z >> 31)\n101\t    }\n102\t    pub fn next_u32(&mut self) -> u32 {\n103\t        (self.next_u64() >> 32) as u32\n104\t    }\n105\t    pub fn byte(&mut self) -> u8 {\n106\t        (self.next_u64() >> 56) as u8\n107\t    }\n108\t    /// Uniform in `[0, n)`.\n109\t    pub fn below(&mut self, n: usize) -> usize {\n110\t        if n == 0 {\n111\t            return 0;\n112\t        }\n113\t        (self.next_u64() % n as u64) as usize\n114\t    }\n115\t    /// Uniform in `[lo, hi]`.\n116\t    pub fn range(&mut self, lo: usize, hi: usize) -> usize {\n117\t        assert!(lo <= hi);\n118\t        lo + self.below(hi - lo + 1)\n119\t    }\n120\t    pub fn fill(&mut self, b: &mut [u8]) {\n121\t        for x in b.iter_mut() {\n122\t            *x = self.byte();\n123\t        }\n124\t    }\n125\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n126\t        let mut v = vec![0u8; n];\n127\t        self.fill(&mut v);\n128\t        v\n129\t    }\n130\t    pub fn bool(&mut self) -> bool {\n131\t        self.next_u64() & 1 == 1\n132\t    }\n133\t    /// Pick one element of a slice.\n134\t    pub fn pick<'a, T>(&mut self, s: &'a [T]) -> &'a T {\n135\t        &s[self.below(s.len())]\n136\t    }\n137\t}\n138\t\n139\t// ---------------------------------------------------------------------------\n140\t// deterministic `randombytes` implementation installed into BOTH libraries\n141\t// ---------------------------------------------------------------------------\n142\t\n143\t#[repr(C)]\n144\tpub struct RandombytesImpl {\n145\t    pub implementation_name: Option<unsafe extern \"C\" fn() -> *const i8>,\n146\t    pub random: Option<unsafe extern \"C\" fn() -> u32>,\n147\t    pub stir: Option<unsafe extern \"C\" fn()>,\n148\t    pub uniform: Option<unsafe extern \"C\" fn(u32) -> u32>,\n149\t    pub buf: Option<unsafe extern \"C\" fn(*mut c_void, usize)>,\n150\t    pub close: Option<unsafe extern \"C\" fn() -> i32>,\n151\t}\n152\tunsafe impl Sync for RandombytesImpl {}\n153\t\n154\t// Two *independent* PRNG states, one per loaded library, so that the C side\n155\t// and the Rust side each observe the identical byte stream when they are given\n156\t// the identical sequence of requests (see `reset_rngs`).\n157\tstatic mut STATE_C: u64 = 0;\n158\tstatic mut STATE_R: u64 = 0;\n159\t\n160\tconst NAME: &[u8] = b\"difftest-deterministic\\0\";\n161\t\n162\tfn sm64(s: &mut u64) -> u64 {\n163\t    *s = s.wrapping_add(0x9E37_79B9_7F4A_7C15);\n164\t    let mut z = *s;\n165\t    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n166\t    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n167\t    z ^ (z >> 31)\n168\t}\n169\t\n170\tunsafe extern \"C\" fn name_fn() -> *const i8 {\n171\t    NAME.as_ptr() as *const i8\n172\t}\n173\t\n174\tmacro_rules! det_impl {\n175\t    ($state:ident, $rnd:ident, $buf:ident, $stir:ident, $close:ident, $impl:ident) => {\n176\t        unsafe extern \"C\" fn $rnd() -> u32 {\n177\t            unsafe { (sm64(&mut *(&raw mut $state)) >> 32) as u32 }\n178\t        }\n179\t        unsafe extern \"C\" fn $buf(p: *mut c_void, n: usize) {\n180\t            unsafe {\n181\t                let st = &mut *(&raw mut $state);\n182\t                let mut i = 0usize;\n183\t                while i < n {\n184\t                    let w = sm64(st).to_le_bytes();\n185\t                    let take = core::cmp::min(8, n - i);\n186\t                    core::ptr::copy_nonoverlapping((&raw const w[0]).cast::<u8>(), (p as *mut u8).add(i), take);\n187\t                    i += take;\n188\t                }\n189\t            }\n190\t        }\n191\t        unsafe extern \"C\" fn $stir() {}\n192\t        unsafe extern \"C\" fn $close() -> i32 {\n193\t            0\n194\t        }\n195\t        pub static $impl: RandombytesImpl = RandombytesImpl {\n196\t            implementation_name: Some(name_fn),\n197\t            random: Some($rnd),\n198\t            stir: Some($stir),\n199\t            uniform: None,\n200\t            buf: Some($buf),\n201\t            close: Some($close),\n202\t        };\n203\t    };\n204\t}\n205\t\n206\tdet_impl!(STATE_C, c_random, c_buf, c_stir, c_close, IMPL_C);\n207\tdet_impl!(STATE_R, r_random, r_buf, r_stir, r_close, IMPL_R);\n208\t\n209\tpub const RNG_SEED_BASE: u64 = 0x5EED_1234_ABCD_0001;\n210\t\n211\t/// Rewind both libraries' deterministic RNG streams to the same seed.\n212\t/// Call this immediately before a C/Rust call pair whose result depends on\n213\t/// `randombytes_*` so that both sides consume the identical byte stream.\n214\tpub fn reset_rngs(seed: u64) {\n215\t    unsafe {\n216\t        *(&raw mut STATE_C) = seed;\n217\t        *(&raw mut STATE_R) = seed;\n218\t    }\n219\t}\n220\t\n221\ttype SetImpl = unsafe extern \"C\" fn(*const RandombytesImpl) -> i32;\n222\ttype Init = unsafe extern \"C\" fn() -> i32;\n223\t\n224\tstatic SETUP: OnceLock<()> = OnceLock::new();\n225\t\n226\t/// Install the deterministic RNG into both libraries and run `sodium_init()`\n227\t/// on both. Idempotent; every test should call it first.\n228\tpub fn setup() {\n229\t    SETUP.get_or_init(|| {\n230\t        let (c_set, r_set) = pair::<SetImpl>(\"randombytes_set_implementation\");\n231\t        unsafe {\n232\t            assert_eq!(c_set(&raw const IMPL_C), 0);\n233\t            assert_eq!(r_set(&raw const IMPL_R), 0);\n234\t        }\n235\t        reset_rngs(RNG_SEED_BASE);\n236\t        let (c_init, r_init) = pair::<Init>(\"sodium_init\");\n237\t        unsafe {\n238\t            let a = c_init();\n239\t            let b = r_init();\n240\t            assert!(a >= 0, \"C sodium_init failed: {a}\");\n241\t            assert!(b >= 0, \"Rust sodium_init failed: {b}\");\n242\t        }\n243\t    });\n244\t}\n245\t\n246\t// ---------------------------------------------------------------------------\n247\t// comparison helpers\n248\t// ---------------------------------------------------------------------------\n249\t\n250\tpub fn hex(b: &[u8]) -> String {\n251\t    let mut s = String::with_capacity(b.len() * 2);\n252\t    for x in b {\n253\t        s.push_str(&format!(\"{x:02x}\"));\n254\t    }\n255\t    s\n256\t}\n257\t\n258\t/// Assert two byte buffers are identical, printing a readable diff.\n259\t#[track_caller]\n260\tpub fn eq_bytes(what: &str, c: &[u8], r: &[u8]) {\n261\t    if c != r {\n262\t        let at = c\n263\t            .iter()\n264\t            .zip(r.iter())\n265\t            .position(|(a, b)| a != b)\n266\t            .unwrap_or(c.len().min(r.len()));\n267\t        panic!(\n268\t            \"{what}: byte mismatch at offset {at} (len C={} R={})\\n  C = {}\\n  R = {}\",\n269\t            c.len(),\n270\t            r.len(),\n271\t            hex(&c[..c.len().min(512)]),\n272\t            hex(&r[..r.len().min(512)]),\n273\t        );\n274\t    }\n275\t}\n276\t\n277\t#[track_caller]\n278\tpub fn eq_i32(what: &str, c: i32, r: i32) {\n279\t    assert_eq!(c, r, \"{what}: return value mismatch (C={c}, Rust={r})\");\n280\t}\n281\t\n282\t#[track_caller]\n283\tpub fn eq_usize(what: &str, c: usize, r: usize) {\n284\t    assert_eq!(c, r, \"{what}: return value mismatch (C={c}, Rust={r})\");\n285\t}\n286\t\n287\t/// A canary-filled output buffer: lets us detect writes past the expected end\n288\t/// and compare \"what was written\" including untouched regions.\n289\tpub fn canary(n: usize) -> Vec<u8> {\n290\t    vec![0xA5u8; n]\n291\t}\n292\t\n293\t// ---------------------------------------------------------------------------\n294\t// out-of-process execution (for paths where the C code `abort()`s:\n295\t// `assert()` failures and `sodium_misuse()`)\n296\t// ---------------------------------------------------------------------------\n297\t\n298\t/// Re-executes the current test binary with `DIFFTEST_CHILD=<tag>` set and a\n299\t/// filter selecting `child_test_name`. Returns the child's raw exit status.\n300\t///\n301\t/// Used for differential testing of abort/misuse paths: the same helper runs\n302\t/// once for the C library and once for the Rust library, and the two exit\n303\t/// statuses must match.\n304\tpub fn run_child(child_test_name: &str, which: &str, tag: &str) -> std::process::Output {\n305\t    let exe = std::env::current_exe().unwrap();\n306\t    std::process::Command::new(exe)\n307\t        .arg(\"--exact\")\n308\t        .arg(child_test_name)\n309\t        .arg(\"--nocapture\")\n310\t        .arg(\"--test-threads=1\")\n311\t        .env(\"DIFFTEST_CHILD\", tag)\n312\t        .env(\"DIFFTEST_WHICH\", which)\n313\t        .output()\n314\t        .expect(\"spawn child\")\n315\t}\n316\t\n317\tpub fn child_tag() -> Option<String> {\n318\t    std::env::var(\"DIFFTEST_CHILD\").ok()\n319\t}\n320\t\n321\tpub fn child_which() -> String {\n322\t    std::env::var(\"DIFFTEST_WHICH\").unwrap_or_default()\n323\t}\n324\t\n325\t/// In the child process: pick the library named by `DIFFTEST_WHICH`.\n326\tpub fn child_lib() -> &'static Library {\n327\t    if child_which() == \"c\" { c_lib() } else { r_lib() }\n328\t}\n329\t\n330\t/// Compare two child outcomes: same exit code and same termination signal.\n331\t#[track_caller]\n332\tpub fn eq_status(what: &str, c: &std::process::Output, r: &std::process::Output) {\n333\t    use std::os::unix::process::ExitStatusExt;\n334\t    let (cc, cs) = (c.status.code(), c.status.signal());\n335\t    let (rc, rs) = (r.status.code(), r.status.signal());\n336\t    assert_eq!(\n337\t        (cc, cs),\n338\t        (rc, rs),\n339\t        \"{what}: process outcome mismatch\\n  C: code={cc:?} signal={cs:?}\\n  \\\n340\t         R: code={rc:?} signal={rs:?}\\n  C stderr: {}\\n  R stderr: {}\",\n341\t        String::from_utf8_lossy(&c.stderr),\n342\t        String::from_utf8_lossy(&r.stderr),\n343\t    );\n344\t}\n345\t\n346\t// ---------------------------------------------------------------------------\n347\t// aligned, opaque state buffers\n348\t// ---------------------------------------------------------------------------\n349\t\n350\t/// A 64-byte-aligned heap buffer, used for the library's opaque `*_state`\n351\t/// structures (whose real alignment requirement is up to 64 bytes for the\n352\t/// BLAKE2b / Keccak / AES-GCM states).\n353\tpub struct State {\n354\t    ptr: *mut u8,\n355\t    layout: std::alloc::Layout,\n356\t    len: usize,\n357\t}\n358\t\n359\timpl State {\n360\t    pub fn new(len: usize) -> State {\n361\t        let layout = std::alloc::Layout::from_size_align(len.max(1), 64).unwrap();\n362\t        let ptr = unsafe { std::alloc::alloc_zeroed(layout) };\n363\t        assert!(!ptr.is_null(), \"alloc {len}\");\n364\t        State { ptr, layout, len }\n365\t    }\n366\t    /// Allocate a state buffer sized by the library's own `*_statebytes()`.\n367\t    pub fn for_sym(statebytes_fn: &str) -> State {\n368\t        let f = sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), statebytes_fn);\n369\t        State::new(unsafe { f() })\n370\t    }\n371\t    pub fn as_mut_ptr(&mut self) -> *mut u8 {\n372\t        self.ptr\n373\t    }\n374\t    pub fn as_ptr(&self) -> *const u8 {\n375\t        self.ptr\n376\t    }\n377\t    pub fn len(&self) -> usize {\n378\t        self.len\n379\t    }\n380\t    pub fn bytes(&self) -> &[u8] {\n381\t        unsafe { std::slice::from_raw_parts(self.ptr, self.len) }\n382\t    }\n383\t}\n384\t\n385\timpl Drop for State {\n386\t    fn drop(&mut self) {\n387\t        unsafe { std::alloc::dealloc(self.ptr, self.layout) }\n388\t    }\n389\t}\n390\t\n391\t/// Split `total` into a randomised list of chunk sizes summing to `total`.\n392\tpub fn chunks(rng: &mut Rng, total: usize, style: u32) -> Vec<usize> {\n393\t    match style {\n394\t        0 => {\n395\t            if total == 0 {\n396\t                vec![]\n397\t            } else {\n398\t                vec![total]\n399\t            }\n400\t        }\n401\t        1 => vec![1; total],                        // one byte at a time\n402\t        2 => {\n403\t            // two chunks, split at a random point (including 0 and total)\n404\t            let a = rng.below(total + 1);\n405\t            vec![a, total - a]\n406\t        }\n407\t        _ => {\n408\t            // random walk\n409\t            let mut v = Vec::new();\n410\t            let mut left = total;\n411\t            while left > 0 {\n412\t                let cap = 1 + rng.below(70);\n413\t                let n = rng.range(1, left.min(cap).max(1));\n414\t                v.push(n);\n415\t                left -= n;\n416\t            }\n417\t            v\n418\t        }\n419\t    }\n420\t}\n421\t\n422\t// ---------------------------------------------------------------------------\n423\t// sodium_misuse() observation\n424\t//\n425\t// `sodium_misuse()` calls the installed handler and *then* `abort()`s, so a\n426\t// handler that prints the observable state and `exit()`s turns an otherwise\n427\t// opaque SIGABRT into a precisely comparable outcome: the same exit code AND\n428\t// the same side effects (out-parameters written before the abort).\n429\t// ---------------------------------------------------------------------------\n430\t\n431\tuse std::sync::atomic::{AtomicPtr, AtomicUsize, Ordering};\n432\t\n433\t/// Exit code the misuse handler uses. Distinct from any libsodium value.\n434\tpub const MISUSE_EXIT: i32 = 77;\n435\t\n436\tstatic OBS_PTR: AtomicPtr<u8> = AtomicPtr::new(std::ptr::null_mut());\n437\tstatic OBS_LEN: AtomicUsize = AtomicUsize::new(0);\n438\t\n439\t/// Register a byte range whose contents the misuse handler will print.\n440\tpub fn set_observation(p: *const u8, len: usize) {\n441\t    OBS_PTR.store(p as *mut u8, Ordering::SeqCst);\n442\t    OBS_LEN.store(len, Ordering::SeqCst);\n443\t}\n444\t\n445\tpub unsafe extern \"C\" fn misuse_handler() {\n446\t    let p = OBS_PTR.load(Ordering::SeqCst);\n447\t    let n = OBS_LEN.load(Ordering::SeqCst);\n448\t    let s = if p.is_null() || n == 0 {\n449\t        String::new()\n450\t    } else {\n451\t        hex(unsafe { std::slice::from_raw_parts(p, n) })\n452\t    };\n453\t    println!(\"MISUSE obs={s}\");\n454\t    use std::io::Write;\n455\t    let _ = std::io::stdout().flush();\n456\t    std::process::exit(MISUSE_EXIT);\n457\t}\n458\t\n459\ttype SetMisuse = unsafe extern \"C\" fn(Option<unsafe extern \"C\" fn()>) -> i32;\n460\t\n461\t/// Install the observing misuse handler into one library.\n462\tpub fn install_misuse_handler(lib: &'static Library) {\n463\t    let f = sym::<SetMisuse>(lib, \"sodium_set_misuse_handler\");\n464\t    let rc = unsafe { f(Some(misuse_handler)) };\n465\t    assert_eq!(rc, 0, \"sodium_set_misuse_handler\");\n466\t}\n467\t\n468\t/// Compare two child processes: identical exit status AND identical stdout.\n469\t#[track_caller]\n470\tpub fn eq_child(what: &str, c: &std::process::Output, r: &std::process::Output) {\n471\t    eq_status(what, c, r);\n472\t    let (co, ro) = (\n473\t        String::from_utf8_lossy(&c.stdout).to_string(),\n474\t        String::from_utf8_lossy(&r.stdout).to_string(),\n475\t    );\n476\t    let pick = |s: &str| -> String {\n477\t        s.lines()\n478\t            .filter(|l| l.starts_with(\"MISUSE \") || l.starts_with(\"OBS \"))\n479\t            .collect::<Vec<_>>()\n480\t            .join(\"\\n\")\n481\t    };\n482\t    assert_eq!(\n483\t        pick(&co),\n484\t        pick(&ro),\n485\t        \"{what}: observed side effects differ\\n  C  stdout: {co}\\n  R  stdout: {ro}\"\n486\t    );\n487\t}\n488\t\n489\t/// Body of the `#[test]` that a parent re-execs. Returns the tag to run, or\n490\t/// `None` when this process is the parent (in which case the test is a no-op).\n491\tpub fn child_case() -> Option<(String, &'static Library)> {\n492\t    let tag = child_tag()?;\n493\t    let lib = child_lib();\n494\t    setup();\n495\t    install_misuse_handler(lib);\n496\t    Some((tag, lib))\n497\t}\n498\t"}]},"parent_tool_use_id":"toolu_bdrk_01UPVb62KCU2WLXnLML5Z8s2","sessio