{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Exd1P85njdJ5UsnYRX3p8F","type":"tool_result","content":"1\t//! `randombytes/internal/randombytes_internal_random.c`\n2\t//!\n3\t//! `TLS` expands to nothing (the build uses `-std=gnu99`, so\n4\t//! `__STDC_VERSION__ < 201112L`), `HAVE_GETPID` and `HAVE_RDRAND` are not\n5\t//! defined, and Linux gets `HAVE_LINUX_COMPATIBLE_GETRANDOM` via the\n6\t//! `syscall(SYS_getrandom, ...)` shim.\n7\t\n8\tuse core::ffi::{c_char, c_int, c_void};\n9\t\n10\tuse super::RandombytesImplementation;\n11\tuse super::os;\n12\tuse crate::common::{get_errno, set_errno};\n13\tuse crate::sodium::core::sodium_misuse;\n14\tuse crate::sodium::utils::sodium_memzero;\n15\t\n16\tunsafe extern \"C\" {\n17\t    fn crypto_stream_chacha20(c: *mut u8, clen: u64, n: *const u8, k: *const u8) -> c_int;\n18\t    fn crypto_stream_chacha20_xor(\n19\t        c: *mut u8,\n20\t        m: *const u8,\n21\t        mlen: u64,\n22\t        n: *const u8,\n23\t        k: *const u8,\n24\t    ) -> c_int;\n25\t}\n26\t\n27\tconst CRYPTO_STREAM_CHACHA20_KEYBYTES: usize = 32;\n28\t/// `crypto_core_hchacha20_OUTPUTBYTES`\n29\tconst INTERNAL_RANDOM_BLOCK_SIZE: usize = 32;\n30\t\n31\t#[repr(C)]\n32\tstruct InternalRandomGlobal {\n33\t    initialized: c_int,\n34\t    random_data_source_fd: c_int,\n35\t    getentropy_available: c_int,\n36\t    getrandom_available: c_int,\n37\t    rdrand_available: c_int,\n38\t}\n39\t\n40\t#[repr(C)]\n41\tstruct InternalRandom {\n42\t    initialized: c_int,\n43\t    rnd32_outleft: usize,\n44\t    key: [u8; CRYPTO_STREAM_CHACHA20_KEYBYTES],\n45\t    rnd32: [u8; 16 * INTERNAL_RANDOM_BLOCK_SIZE],\n46\t    nonce: u64,\n47\t}\n48\t\n49\tstatic mut GLOBAL: InternalRandomGlobal = InternalRandomGlobal {\n50\t    initialized: 0,\n51\t    random_data_source_fd: -1,\n52\t    getentropy_available: 0,\n53\t    getrandom_available: 0,\n54\t    rdrand_available: 0,\n55\t};\n56\t\n57\tstatic mut STREAM: InternalRandom = InternalRandom