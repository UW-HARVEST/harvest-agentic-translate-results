{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QwwQ9rGMd9rdJ3RngifnVq","type":"tool_result","content":"1\t//! Phase B — hashes, MACs, XOFs and KDFs.\n2\t//!\n3\t//! Covers the one-shot AND the low-level streaming (`_init`/`_update`/`_final`,\n4\t//! `_absorb`/`_squeeze`) entry points, with randomised update chunking so that\n5\t//! partial-block carry-over across calls is exercised.\n6\t\n7\tmod common;\n8\tuse common::*;\n9\t\n10\ttype HashOneShot = unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32;\n11\ttype StInit = unsafe extern \"C\" fn(*mut u8) -> i32;\n12\ttype StUpdate = unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> i32;\n13\ttype StFinal = unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32;\n14\ttype Keygen = unsafe extern \"C\" fn(*mut u8);\n15\t\n16\t/// Lengths straddling the SHA-2 length-padding boundaries (55/56, 111/112),\n17\t/// the 64/128-byte block sizes and the Keccak rates (72/136/168).\n18\tconst LENS: &[usize] = &[\n19\t    0, 1, 2, 31, 32, 33, 54, 55, 56, 57, 63, 64, 65, 71, 72, 73, 100, 110, 111, 112, 113, 127, 128,\n20\t    129, 135, 136, 137, 143, 144, 145, 167, 168, 169, 200, 255, 256, 257, 335, 336, 337, 511, 512,\n21\t    513, 1000, 2000,\n22\t];\n23\t\n24\t// ---------------------------------------------------------------------------\n25\t// SHA-256 / SHA-512 / SHA3-256 / SHA3-512 / generic crypto_hash\n26\t// ---------------------------------------------------------------------------\n27\t\n28\t/// (prefix, digest len, statebytes symbol)\n29\tconst SHA_FAMILY: &[(&str, usize)] = &[\n30\t    (\"crypto_hash_sha256\", 32),\n31\t    (\"crypto_hash_sha512\", 64),\n32\t    (\"crypto_hash_sha3256\", 32),\n33\t    (\"crypto_hash_sha3512\", 64),\n34\t];\n35\t\n36\t#[test]\n37\tfn sha_one_shot() {\n38\t    setup();\n39\t    let mut rng = Rng::new(0x7001);\n40\t    for &(prefix, dl) in SHA_FAMILY {\n41\t        let (c, r) = pair::<HashOneShot>(prefix);\n42\t        for &len in LENS {\n43\t            for kind in 0..3 {\n44\t                let inp = match kind {\n45\t                    0 => rng.bytes(len),\n46\t                    1 => vec![0u8; len],\n47\t                    _ => vec![0xffu8; len],\n48\t                };\n49\t                let mut a = canary(dl);\n50\t                let mut b = canary(dl);\n51\t                let (ra, rb) = unsafe {\n52\t                    (\n53\t                        c(a.as_mut_ptr(), inp.as_ptr(), len as u64),\n54\t                        r(b.as_mut_ptr(), inp.as_ptr(), len as u64),\n55\t                    )\n56\t                };\n57\t                eq_i32(&format!(\"{prefix} rc\"), ra, rb);\n58\t                eq_bytes(&format!(\"{prefix}(len={len}, kind={kind})\"), &a, &b);\n59\t            }\n60\t        }\n61\t    }\n62\t    // generic crypto_hash == crypto_hash_sha512\n63\t    let (c, r) = pair::<HashOneShot>(\"crypto_hash\");\n64\t    for &len in LENS {\n65\t        let inp = rng.bytes(len);\n66\t        let mut a = canary(64);\n67\t        let mut b = canary(64);\n68\t        let (ra, rb) = unsafe {\n69\t            (\n70\t                c(a.as_mut_ptr(), inp.as_ptr(), len as u64),\n71\t                r(b.as_mut_ptr(), inp.as_ptr(), len as u64),\n72\t            )\n73\t        };\n74\t        eq_i32(\"crypto_hash rc\", ra, rb);\n75\t        eq_bytes(&format!(\"crypto_hash(len={len})\"), &a, &b);\n76\t    }\n77\t}\n78\t\n79\t#[test]\n80\tfn sha_streaming_with_random_chunking() {\n81\t    setup();\n82\t    let mut rng = Rng::new(0x7002);\n83\t    for &(prefix, dl) in SHA_FAMILY {\n84\t        let (ci, ri) = pair::<StInit>(&format!(\"{prefix}_init\"));\n85\t        let (cu, ru) = pair::<StUpdate>(&format!(\"{prefix}_update\"));\n86\t        let (cf, rf) = pair::<StFinal>(&format!(\"{prefix}_final\"));\n87\t        let sb = format!(\"{prefix}_statebytes\");\n88\t        for &len in LENS {\n89\t            for style in 0..4u32 {\n90\t                if style == 1 && len > 300 {\n91\t                    continue; // 1-byte-at-a-time on huge inputs is slow\n92\t                }\n93\t                let inp = rng.bytes(len);\n94\t                let parts = chunks(&mut rng, len, style);\n95\t                let mut out = [canary(dl), canary(dl)];\n96\t                for (which, (init, upd, fin)) in\n97\t                    [(ci, cu, cf), (ri, ru, rf)].into_iter().enumerate()\n98\t                {\n99\t                    let mut st = State::for_sym(&sb);\n100\t                    unsafe {\n101\t                        let rc = init(st.as_mut_ptr());\n102\t                        assert_eq!(rc, 0, \"{prefix}_init rc\");\n103\t                        let mut off = 0usize;\n104\t                        for &n in &parts {\n105\t                            let rc = upd(st.as_mut_ptr(), inp[off..].as_ptr(), n as u64);\n106\t                            assert_eq!(rc, 0, \"{prefix}_update rc\");\n107\t                            off += n;\n108\t                        }\n109\t                        assert_eq!(off, len);\n110\t                        let rc = fin(st.as_mut_ptr(), out[which].as_mut_ptr());\n111\t                        assert_eq!(rc, 0, \"{prefix}_final rc\");\n112\t                    }\n113\t                }\n114\t                let (a, b) = (out[0].clone(), out[1].clone());\n115\t                eq_bytes(\n116\t                    &format!(\"{prefix} streaming(len={len}, style={style}, parts={})\", parts.len()),\n117\t                    &a,\n118\t                    &b,\n119\t                );\n120\t                // streaming must equal one-shot\n121\t                let (c1, _) = pair::<HashOneShot>(prefix);\n122\t                let mut os = canary(dl);\n123\t                unsafe { c1(os.as_mut_ptr(), inp.as_ptr(), len as u64) };\n124\t                eq_bytes(&format!(\"{prefix} streaming==one-shot(len={len})\"), &os, &a);\n125\t            }\n126\t        }\n127\t    }\n128\t}\n129\t\n130\t// ---------------------------------------------------------------------------\n131\t// BLAKE2b / generichash — one-shot, streaming, salt/personal\n132\t// ---------------------------------------------------------------------------\n133\t\n134\ttype GhOneShot =\n135\t    unsafe extern \"C\" fn(*mut u8, usize, *const u8, u64, *const u8, usize) -> i32;\n136\ttype GhInit = unsafe extern \"C\" fn(*mut u8, *const u8, usize, usize) -> i32;\n137\ttype GhFinal = unsafe extern \"C\" fn(*mut u8, *mut u8, usize) -> i32;\n138\ttype GhSaltPers = unsafe extern \"C\" fn(\n139\t    *mut u8,\n140\t    usize,\n141\t    *const u8,\n142\t    u64,\n143\t    *const u8,\n144\t    usize,\n145\t    *const u8,\n146\t    *const u8,\n147\t) -> i32;\n148\ttype GhInitSaltPers =\n149\t    unsafe extern \"C\" fn(*mut u8, *const u8, usize, usize, *const u8, *const u8) -> i32;\n150\t\n151\tconst GH_OUTLENS: &[usize] = &[1, 2, 15, 16, 17, 31, 32, 33, 47, 48, 63, 64];\n152\tconst GH_KEYLENS: &[usize] = &[0, 1, 15, 16, 17, 31, 32, 33, 63, 64];\n153\tconst GH_INLENS: &[usize] = &[0, 1, 2, 63, 64, 65, 127, 128, 129, 191, 192, 255, 256, 257, 1000];\n154\t\n155\t#[test]\n156\tfn generichash_one_shot() {\n157\t    setup();\n158\t    let mut rng = Rng::new(0x7100);\n159\t    for prefix in [\"crypto_generichash\", \"crypto_generichash_blake2b\"] {\n160\t        let (c, r) = pair::<GhOneShot>(prefix);\n161\t        for &outlen in GH_OUTLENS {\n162\t            for &keylen in GH_KEYLENS {\n163\t                for &inlen in GH_INLENS {\n164\t                    let key = rng.bytes(keylen);\n165\t                    let inp = rng.bytes(inlen);\n166\t                    // keylen == 0 must be tested both with key=NULL and key!=NULL\n167\t                    for key_null in [false, true] {\n168\t                        if key_null && keylen != 0 {\n169\t                            continue;\n170\t                        }\n171\t                        let kp = if key_null {\n172\t                            std::ptr::null()\n173\t                        } else {\n174\t                            key.as_ptr()\n175\t                        };\n176\t                        let mut a = canary(outlen);\n177\t                        let mut b = canary(outlen);\n178\t                        let (ra, rb) = unsafe {\n179\t                            (\n180\t                                c(a.as_mut_ptr(), outlen, inp.as_ptr(), inlen as u64, kp, keylen),\n181\t                                r(b.as_mut_ptr(), outlen, inp.as_ptr(), inlen as u64, kp, keylen),\n182\t                            )\n183\t                        };\n184\t                        eq_i32(&format!(\"{prefix} rc (out={outlen} key={keylen})\"), ra, rb);\n185\t                        eq_bytes(\n186\t                            &format!(\n187\t                                \"{prefix}(out={outlen}, key={keylen}, null={key_null}, in={inlen})\"\n188\t                            ),\n189\t                            &a,\n190\t                            &b,\n191\t                        );\n192\t                    }\n193\t                }\n194\t            }\n195\t        }\n196\t    }\n197\t}\n198\t\n199\t#[test]\n200\tfn generichash_streaming() {\n201\t    setup();\n202\t    let mut rng = Rng::new(0x7101);\n203\t    for prefix in [\"crypto_generichash\", \"crypto_generichash_blake2b\"] {\n204\t        let (ci, ri) = pair::<GhInit>(&format!(\"{prefix}_init\"));\n205\t        let (cu, ru) = pair::<StUpdate>(&format!(\"{prefix}_update\"));\n206\t        let (cf, rf) = pair::<GhFinal>(&format!(\"{prefix}_final\"));\n207\t        let sb = format!(\"{prefix}_statebytes\");\n208\t        for &outlen in &[16usize, 32, 64, 1, 17, 63] {\n209\t            for &keylen in &[0usize, 16, 32, 64] {\n210\t                for &inlen in &[0usize, 1, 127, 128, 129, 255, 256, 1000] {\n211\t                    for style in 0..4u32 {\n212\t                        if style == 1 && inlen > 300 {\n213\t                            continue;\n214\t                        }\n215\t                        let key = rng.bytes(keylen);\n216\t                        let inp = rng.bytes(inlen);\n217\t                        let kp = if keylen == 0 {\n218\t                            std::ptr::null()\n219\t                        } else {\n220\t                            key.as_ptr()\n221\t                        };\n222\t                        let parts = chunks(&mut rng, inlen, style);\n223\t                        let mut out = [canary(outlen), canary(outlen)];\n224\t                        for (which, (init, upd, fin)) in\n225\t                            [(ci, cu, cf), (ri, ru, rf)].into_iter().enumerate()\n226\t                        {\n227\t                            let mut st = State::for_sym(&sb);\n228\t                            unsafe {\n229\t                                assert_eq!(init(st.as_mut_ptr(), kp, keylen, outlen), 0);\n230\t                                let mut off = 0;\n231\t                                for &n in &parts {\n232\t                                    assert_eq!(\n233\t                                        upd(st.as_mut_ptr(), inp[off..].as_ptr(), n as u64),\n234\t                                        0\n235\t                                    );\n236\t                                    off += n;\n237\t                                }\n238\t                                assert_eq!(fin(st.as_mut_ptr(), out[which].as_mut_ptr(), outlen), 0);\n239\t                            }\n240\t                        }\n241\t                        let (a, b) = (out[0].clone(), out[1].clone());\n242\t                        eq_bytes(\n243\t                            &format!(\n244\t                                \"{prefix} stream(out={outlen}, key={keylen}, in={inlen}, style={style})\"\n245\t                            ),\n246\t                            &a,\n247\t                            &b,\n248\t                        );\n249\t                        // must equal the one-shot form\n250\t                        let (c1, _) = pair::<GhOneShot>(prefix);\n251\t                        let mut os = canary(outlen);\n252\t                        unsafe {\n253\t                            c1(os.as_mut_ptr(), outlen, inp.as_ptr(), inlen as u64, kp, keylen)\n254\t                        };\n255\t                        eq_bytes(&format!(\"{prefix} stream==one-shot\"), &os, &a);\n256\t                    }\n257\t                }\n258\t            }\n259\t        }\n260\t    }\n261\t}\n262\t\n263\t#[test]\n264\tfn generichash_blake2b_salt_personal() {\n265\t    setup();\n266\t    let mut rng = Rng::new(0x7102);\n267\t    let (c, r) = pair::<GhSaltPers>(\"crypto_generichash_blake2b_salt_personal\");\n268\t    for &outlen in &[16usize, 32, 64, 1, 17] {\n269\t        for &keylen in &[0usize, 16, 32, 64] {\n270\t            for &inlen in &[0usize, 1, 127, 128, 129, 500] {\n271\t                for combo in 0..4u32 {\n272\t                    let key = rng.bytes(keylen);\n273\t                    let salt = rng.bytes(16);\n274\t                    let pers = rng.bytes(16);\n275\t                    let kp = if keylen == 0 {\n276\t                        std::ptr::null()\n277\t                    } else {\n278\t                        key.as_ptr()\n279\t                    };\n280\t                    let sp = if combo & 1 == 0 {\n281\t                        std::ptr::null()\n282\t                    } else {\n283\t                        salt.as_ptr()\n284\t                    };\n285\t                    let pp = if combo & 2 == 0 {\n286\t                        std::ptr::null()\n287\t                    } else {\n288\t                        pers.as_ptr()\n289\t                    };\n290\t                    let inp = rng.bytes(inlen);\n291\t                    let mut a = canary(outlen);\n292\t                    let mut b = canary(outlen);\n293\t                    let (ra, rb) = unsafe {\n294\t                        (\n295\t                            c(\n296\t                                a.as_mut_ptr(),\n297\t                                outlen,\n298\t                                inp.as_ptr(),\n299\t                                inlen as u64,\n300\t                                kp,\n301\t                                keylen,\n302\t                                sp,\n303\t                                pp,\n304\t                            ),\n305\t                            r(\n306\t                                b.as_mut_ptr(),\n307\t                                outlen,\n308\t                                inp.as_ptr(),\n309\t                                inlen as u64,\n310\t                                kp,\n311\t                                keylen,\n312\t                                sp,\n313\t                                pp,\n314\t                            ),\n315\t                        )\n316\t                    };\n317\t                    eq_i32(\"blake2b_salt_personal rc\", ra, rb);\n318\t                    eq_bytes(\n319\t                        &format!(\"blake2b_salt_personal(out={outlen},key={keylen},in={inlen},combo={combo})\"),\n320\t                        &a,\n321\t                        &b,\n322\t                    );\n323\t                }\n324\t            }\n325\t        }\n326\t    }\n327\t}\n328\t\n329\t#[test]\n330\tfn generichash_blake2b_init_salt_personal_streaming() {\n331\t    setup();\n332\t    let mut rng = Rng::new(0x7103);\n333\t    let (ci, ri) = pair::<GhInitSaltPers>(\"crypto_generichash_blake2b_init_salt_personal\");\n334\t    let (cu, ru) = pair::<StUpdate>(\"crypto_generichash_blake2b_update\");\n335\t    let (cf, rf) = pair::<GhFinal>(\"crypto_generichash_blake2b_final\");\n336\t    for &outlen in &[16usize, 32, 64] {\n337\t        for &keylen in &[0usize, 16, 64] {\n338\t            for &inlen in &[0usize, 1, 128, 129, 500] {\n339\t                for combo in 0..4u32 {\n340\t                    let key = rng.bytes(keylen);\n341\t                    let salt = rng.bytes(16);\n342\t                    let pers = rng.bytes(16);\n343\t                    let inp = rng.bytes(inlen);\n344\t                    let kp = if keylen == 0 {\n345\t                        std::ptr::null()\n346\t                    } else {\n347\t                        key.as_ptr()\n348\t                    };\n349\t                    let sp = if combo & 1 == 0 {\n350\t                        std::ptr::null()\n351\t                    } else {\n352\t                        salt.as_ptr()\n353\t                    };\n354\t                    let pp = if combo & 2 == 0 {\n355\t                        std::ptr::null()\n356\t                    } else {\n357\t                        pers.as_ptr()\n358\t                    };\n359\t                    let parts = chunks(&mut rng, inlen, 3);\n360\t                    let mut out = [canary(outlen), canary(outlen)];\n361\t                    for (which, (init, upd, fin)) in\n362\t                        [(ci, cu, cf), (ri, ru, rf)].into_iter().enumerate()\n363\t                    {\n364\t                        let mut st = State::for_sym(\"crypto_generichash_blake2b_statebytes\");\n365\t                        unsafe {\n366\t                            assert_eq!(init(st.as_mut_ptr(), kp, keylen, outlen, sp, pp), 0);\n367\t                            let mut off = 0;\n368\t                            for &n in &parts {\n369\t                                assert_eq!(upd(st.as_mut_ptr(), inp[off..].as_ptr(), n as u64), 0);\n370\t                                off += n;\n371\t                            }\n372\t                            assert_eq!(fin(st.as_mut_ptr(), out[which].as_mut_ptr(), outlen), 0);\n373\t                        }\n374\t                    }\n375\t                    let (a, b) = (out[0].clone(), out[1].clone());\n376\t                    eq_bytes(\n377\t                        &format!(\"blake2b init_salt_personal stream(out={outlen},key={keylen},in={inlen},combo={combo})\"),\n378\t                        &a,\n379\t                        &b,\n380\t                    );\n381\t                }\n382\t            }\n383\t        }\n384\t    }\n385\t}\n386\t\n387\t// ---------------------------------------------------------------------------\n388\t// Poly1305 — one-shot, streaming, verify\n389\t// ---------------------------------------------------------------------------\n390\t\n391\ttype OtaOneShot = unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8) -> i32;\n392\ttype OtaVerify = unsafe extern \"C\" fn(*const u8, *const u8, u64, *const u8) -> i32;\n393\ttype OtaInit = unsafe extern \"C\" fn(*mut u8, *const u8) -> i32;\n394\t\n395\t#[test]\n396\tfn poly1305_one_shot_and_verify() {\n397\t    setup();\n398\t    let mut rng = Rng::new(0x7200);\n399\t    for prefix in [\"crypto_onetimeauth\", \"crypto_onetimeauth_poly1305\"] {\n400\t        let (c, r) = pair::<OtaOneShot>(prefix);\n401\t        let (cv, rv) = pair::<OtaVerify>(&format!(\"{prefix}_verify\"));\n402\t        for &len in &[\n403\t            0usize, 1, 2, 15, 16, 17, 31, 32, 33, 47, 48, 63, 64, 65, 127, 128, 129, 1000, 2000,\n404\t        ] {\n405\t            for kind in 0..3 {\n406\t                let k = match kind {\n407\t                    0 => rng.bytes(32),\n408\t                    1 => vec![0u8; 32],\n409\t                    _ => vec![0xffu8; 32],\n410\t                };\n411\t                let inp = match kind {\n412\t                    0 => rng.bytes(len),\n413\t                    1 => vec![0u8; len],\n414\t                    _ => vec![0xffu8; len],\n415\t                };\n416\t                let mut a = canary(16);\n417\t                let mut b = canary(16);\n418\t                let (ra, rb) = unsafe {\n419\t                    (\n420\t                        c(a.as_mut_ptr(), inp.as_ptr(), len as u64, k.as_ptr()),\n421\t                        r(b.as_mut_ptr(), inp.as_ptr(), len as u64, k.as_ptr()),\n422\t                    )\n423\t                };\n424\t                eq_i32(&format!(\"{prefix} rc\"), ra, rb);\n425\t                eq_bytes(&format!(\"{prefix}(len={len}, kind={kind})\"), &a, &b);\n426\t\n427\t                // verify: correct tag\n428\t                let (va, vb) = unsafe {\n429\t                    (\n430\t                        cv(a.as_ptr(), inp.as_ptr(), len as u64, k.as_ptr()),\n431\t                        rv(a.as_ptr(), inp.as_ptr(), len as u64, k.as_ptr()),\n432\t                    )\n433\t                };\n434\t                eq_i32(&format!(\"{prefix}_verify ok\"), va, vb);\n435\t                assert_eq!(va, 0);\n436\t                // verify: each byte of the tag flipped\n437\t                for i in 0..16 {\n438\t                    let mut bad = a.clone();\n439\t                    bad[i] ^= 0x80;\n440\t                    let (va, vb) = unsafe {\n441\t                        (\n442\t                            cv(bad.as_ptr(), inp.as_ptr(), len as u64, k.as_ptr()),\n443\t                            rv(bad.as_ptr(), inp.as_ptr(), len as u64, k.as_ptr()),\n444\t                        )\n445\t                    };\n446\t                    eq_i32(&format!(\"{prefix}_verify bad tag byte {i}\"), va, vb);\n447\t                    assert_eq!(va, -1);\n448\t                }\n449\t            }\n450\t        }\n451\t    }\n452\t}\n453\t\n454\t#[test]\n455\tfn poly1305_streaming() {\n456\t    setup();\n457\t    let mut rng = Rng::new(0x7201);\n458\t    for prefix in [\"crypto_onetimeauth\", \"crypto_onetimeauth_poly1305\"] {\n459\t        let (ci, ri) = pair::<OtaInit>(&format!(\"{prefix}_init\"));\n460\t        let (cu, ru) = pair::<StUpdate>(&format!(\"{prefix}_update\"));\n461\t        let (cf, rf) = pair::<StFinal>(&format!(\"{prefix}_final\"));\n462\t        let sb = format!(\"{prefix}_statebytes\");\n463\t        for &len in &[0usize, 1, 15, 16, 17, 31, 32, 33, 63, 64, 65, 127, 128, 1000] {\n464\t            for style in 0..4u32 {\n465\t                if style == 1 && len > 300 {\n466\t                    continue;\n467\t                }\n468\t                let k = rng.bytes(32);\n469\t                let inp = rng.bytes(len);\n470\t                let parts = chunks(&mut rng, len, style);\n471\t                let mut out = [canary(16), canary(16)];\n472\t                for (which, (init, upd, fin)) in\n473\t                    [(ci, cu, cf), (ri, ru, rf)].into_iter().enumerate()\n474\t                {\n475\t                    let mut st = State::for_sym(&sb);\n476\t                    unsafe {\n477\t                        assert_eq!(init(st.as_mut_ptr(), k.as_ptr()), 0);\n478\t                        let mut off = 0;\n479\t                        for &n in &parts {\n480\t                            assert_eq!(upd(st.as_mut_ptr(), inp[off..].as_ptr(), n as u64), 0);\n481\t                            off += n;\n482\t                        }\n483\t                        assert_eq!(fin(st.as_mut_ptr(), out[which].as_mut_ptr()), 0);\n484\t                    }\n485\t                }\n486\t                let (a, b) = (out[0].clone(), out[1].clone());\n487\t                eq_bytes(&format!(\"{prefix} stream(len={len}, style={style})\"), &a, &b);\n488\t                let (c1, _) = pair::<OtaOneShot>(prefix);\n489\t                let mut os = canary(16);\n490\t                unsafe { c1(os.as_mut_ptr(), inp.as_ptr(), len as u64, k.as_ptr()) };\n491\t                eq_bytes(&format!(\"{prefix} stream==one-shot(len={len})\"), &os, &a);\n492\t            }\n493\t        }\n494\t    }\n495\t}\n496\t\n497\t// ---------------------------------------------------------------------------\n498\t// XOFs: shake128/256, turboshake128/256\n499\t// ---------------------------------------------------------------------------\n500\t\n501\ttype XofOneShot = unsafe extern \"C\" fn(*mut u8, usize, *const u8, u64) -> i32;\n502\ttype XofInitDomain = unsafe extern \"C\" fn(*mut u8, u8) -> i32;\n503\ttype XofSqueeze = unsafe extern \"C\" fn(*mut u8, *mut u8, usize) -> i32;\n504\t\n505\t/// (prefix, block/rate bytes)\n506\tconst XOFS: &[(&str, usize)] = &[\n507\t    (\"crypto_xof_shake128\", 168),\n508\t    (\"crypto_xof_shake256\", 136),\n509\t    (\"crypto_xof_turboshake128\", 168),\n510\t    (\"crypto_xof_turboshake256\", 136),\n511\t];\n512\t\n513\t#[test]\n514\tfn xof_one_shot() {\n515\t    setup();\n516\t    let mut rng = Rng::new(0x7300);\n517\t    for &(prefix, rate) in XOFS {\n518\t        let (c, r) = pair::<XofOneShot>(prefix);\n519\t        let bb = sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{prefix}_blockbytes\"));\n520\t        assert_eq!(unsafe { bb() }, rate, \"{prefix}_blockbytes\");\n521\t        for &inlen in &[0usize, 1, rate - 1, rate, rate + 1, 2 * rate, 2 * rate + 1, 1000] {\n522\t            for &outlen in &[0usize, 1, 31, 32, rate - 1, rate, rate + 1, 2 * rate + 5, 1000] {\n523\t                let inp = rng.bytes(inlen);\n524\t                let mut a = canary(outlen.max(1));\n525\t                let mut b = canary(outlen.max(1));\n526\t                let (ra, rb) = unsafe {\n527\t                    (\n528\t                        c(a.as_mut_ptr(), outlen, inp.as_ptr(), inlen as u64),\n529\t                        r(b.as_mut_ptr(), outlen, inp.as_ptr(), inlen as u64),\n530\t                    )\n531\t                };\n532\t                eq_i32(&format!(\"{prefix} rc(in={inlen},out={outlen})\"), ra, rb);\n533\t                eq_bytes(&format!(\"{prefix}(in={inlen}, out={outlen})\"), &a, &b);\n534\t            }\n535\t        }\n536\t    }\n537\t}\n538\t\n539\t#[test]\n540\tfn xof_streaming_absorb_squeeze() {\n541\t    setup();\n542\t    let mut rng = Rng::new(0x7301);\n543\t    for &(prefix, rate) in XOFS {\n544\t        let (ci, ri) = pair::<StInit>(&format!(\"{prefix}_init\"));\n545\t        let (cu, ru) = pair::<StUpdate>(&format!(\"{prefix}_update\"));\n546\t        let (cs, rs) = pair::<XofSqueeze>(&format!(\"{prefix}_squeeze\"));\n547\t        let sb = format!(\"{prefix}_statebytes\");\n548\t        for &inlen in &[0usize, 1, rate - 1, rate, rate + 1, 2 * rate + 3, 1000] {\n549\t            for style in 0..4u32 {\n550\t                if style == 1 && inlen > 300 {\n551\t                    continue;\n552\t                }\n553\t                // squeeze in several successive calls of varying size\n554\t                for sq_style in 0..3u32 {\n555\t                    let inp = rng.bytes(inlen);\n556\t                    let parts = chunks(&mut rng, inlen, style);\n557\t                    let total_out = 2 * rate + 37;\n558\t                    let sq: Vec<usize> = match sq_style {\n559\t                        0 => vec![total_out],\n560\t                        1 => vec![1; total_out],\n561\t                        _ => chunks(&mut rng, total_out, 3),\n562\t                    };\n563\t                    let mut out = [canary(total_out), canary(total_out)];\n564\t                    for (which, (init, upd, sqz)) in\n565\t                        [(ci, cu, cs), (ri, ru, rs)].into_iter().enumerate()\n566\t                    {\n567\t                        let mut st = State::for_sym(&sb);\n568\t                        unsafe {\n569\t                            assert_eq!(init(st.as_mut_ptr()), 0, \"{prefix}_init\");\n570\t                            let mut off = 0;\n571\t                            for &n in &parts {\n572\t                                assert_eq!(\n573\t                                    upd(st.as_mut_ptr(), inp[off..].as_ptr(), n as u64),\n574\t                                    0,\n575\t                                    \"{prefix}_update\"\n576\t                                );\n577\t                                off += n;\n578\t                            }\n579\t                            let mut o = 0usize;\n580\t                            for &n in &sq {\n581\t                                assert_eq!(\n582\t                                    sqz(st.as_mut_ptr(), out[which][o..].as_mut_ptr(), n),\n583\t                                    0,\n584\t                                    \"{prefix}_squeeze\"\n585\t                                );\n586\t                                o += n;\n587\t                            }\n588\t                            assert_eq!(o, total_out);\n589\t                        }\n590\t                    }\n591\t                    let (a, b) = (out[0].clone(), out[1].clone());\n592\t                    eq_bytes(\n593\t                        &format!(\"{prefix} stream(in={inlen}, style={style}, sq={sq_style})\"),\n594\t                        &a,\n595\t                        &b,\n596\t                    );\n597\t                }\n598\t            }\n599\t        }\n600\t    }\n601\t}\n602\t\n603\t#[test]\n604\tfn xof_init_with_domain() {\n605\t    setup();\n606\t    let mut rng = Rng::new(0x7302);\n607\t    for &(prefix, rate) in XOFS {\n608\t        let (ci, ri) = pair::<XofInitDomain>(&format!(\"{prefix}_init_with_domain\"));\n609\t        let (cu, ru) = pair::<StUpdate>(&format!(\"{prefix}_update\"));\n610\t        let (cs, rs) = pair::<XofSqueeze>(&format!(\"{prefix}_squeeze\"));\n611\t        let sb = format!(\"{prefix}_statebytes\");\n612\t        let std_dom =\n613\t            sym::<unsafe extern \"C\" fn() -> u8>(c_lib(), &format!(\"{prefix}_domain_standard\"));\n614\t        let std_dom = unsafe { std_dom() };\n615\t        // The whole 0..=255 domain byte range is a valid *input*; whether the C\n616\t        // rejects some of it is Phase C's job — here we compare behaviour for\n617\t        // every value, return code included.\n618\t        for dom in 0u16..=255 {\n619\t            let dom = dom as u8;\n620\t            let inlen = rng.below(2 * rate + 7);\n621\t            let inp = rng.bytes(inlen);\n622\t            let total_out = rate + 13;\n623\t            let mut out = [canary(total_out), canary(total_out)];\n624\t            let mut rcs = [0i32; 2];\n625\t            for (which, (init, upd, sqz)) in [(ci, cu, cs), (ri, ru, rs)].into_iter().enumerate() {\n626\t                let mut st = State::for_sym(&sb);\n627\t                unsafe {\n628\t                    rcs[which] = init(st.as_mut_ptr(), dom);\n629\t                    if rcs[which] == 0 {\n630\t                        upd(st.as_mut_ptr(), inp.as_ptr(), inlen as u64);\n631\t                        sqz(st.as_mut_ptr(), out[which].as_mut_ptr(), total_out);\n632\t                    }\n633\t                }\n634\t            }\n635\t            eq_i32(&format!(\"{prefix}_init_with_domain({dom:#x}) rc\"), rcs[0], rcs[1]);\n636\t            let (a, b) = (out[0].clone(), out[1].clone());\n637\t            eq_bytes(&format!(\"{prefix} domain={dom:#x}\"), &a, &b);\n638\t            if dom == std_dom {\n639\t                assert_eq!(rcs[0], 0, \"{prefix} standard domain must be accepted\");\n640\t            }\n641\t        }\n642\t    }\n643\t}\n644\t\n645\t// ---------------------------------------------------------------------------\n646\t// crypto_core_keccak1600 — the raw sponge\n647\t// ---------------------------------------------------------------------------\n648\t\n649\ttype KcInit = unsafe extern \"C\" fn(*mut u8);\n650\ttype KcXor = unsafe extern \"C\" fn(*mut u8, *const u8, usize, usize);\n651\ttype KcExtract = unsafe extern \"C\" fn(*const u8, *mut u8, usize, usize);\n652\ttype KcPermute = unsafe extern \"C\" fn(*mut u8);\n653\t\n654\t#[test]\n655\tfn keccak1600_raw_sponge() {\n656\t    setup();\n657\t    let mut rng = Rng::new(0x7400);\n658\t    let (ci, ri) = pair::<KcInit>(\"crypto_core_keccak1600_init\");\n659\t    let (cx, rx) = pair::<KcXor>(\"crypto_core_keccak1600_xor_bytes\");\n660\t    let (ce, re) = pair::<KcExtract>(\"crypto_core_keccak1600_extract_bytes\");\n661\t    let (c24, r24) = pair::<KcPermute>(\"crypto_core_keccak1600_permute_24\");\n662\t    let (c12, r12) = pair::<KcPermute>(\"crypto_core_keccak1600_permute_12\");\n663\t    let statebytes =\n664\t        unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), \"crypto_core_keccak1600_statebytes\")() };\n665\t    assert_eq!(statebytes, 224);\n666\t\n667\t    for iter in 0..200 {\n668\t        // A random program of sponge operations, replayed identically on both.\n669\t        let ops: Vec<(u32, usize, usize)> = (0..rng.range(1, 12))\n670\t            .map(|_| {\n671\t                let op = rng.below(4) as u32;\n672\t                let offset = rng.below(200);\n673\t                let length = rng.below(200 - offset.min(199)).max(0);\n674\t                (op, offset, length)\n675\t            })\n676\t            .collect();\n677\t        let data = rng.bytes(256);\n678\t        let mut finals = [canary(200), canary(200)];\n679\t        for (which, (init, xorb, ext, p24, p12)) in\n680\t            [(ci, cx, ce, c24, c12), (ri, rx, re, r24, r12)]\n681\t                .into_iter()\n682\t                .enumerate()\n683\t        {\n684\t            let mut st = State::new(statebytes);\n685\t            unsafe {\n686\t                init(st.as_mut_ptr());\n687\t                for &(op, offset, length) in &ops {\n688\t                    match op {\n689\t                        0 => xorb(st.as_mut_ptr(), data.as_ptr(), offset, length),\n690\t                        1 => {\n691\t                            let mut tmp = vec![0u8; length.max(1)];\n692\t                            ext(st.as_ptr(), tmp.as_mut_ptr(), offset, length);\n693\t                        }\n694\t                        2 => p24(st.as_mut_ptr()),\n695\t                        _ => p12(st.as_mut_ptr()),\n696\t                    }\n697\t                }\n698\t                ext(st.as_ptr(), finals[which].as_mut_ptr(), 0, 200);\n699\t            }\n700\t        }\n701\t        let (a, b) = (finals[0].clone(), finals[1].clone());\n702\t        eq_bytes(&format!(\"keccak1600 program #{iter} ({} ops)\", ops.len()), &a, &b);\n703\t    }\n704\t}\n705\t\n706\t// ---------------------------------------------------------------------------\n707\t// KDFs\n708\t// ---------------------------------------------------------------------------\n709\t\n710\ttype KdfDerive =\n711\t    unsafe extern \"C\" fn(*mut u8, usize, u64, *const std::ffi::c_char, *const u8) -> i32;\n712\t\n713\t#[test]\n714\tfn kdf_blake2b_derive_from_key() {\n715\t    setup();\n716\t    let mut rng = Rng::new(0x7500);\n717\t    for prefix in [\"crypto_kdf\", \"crypto_kdf_blake2b\"] {\n718\t        let (c, r) = pair::<KdfDerive>(&format!(\"{prefix}_derive_from_key\"));\n719\t        let ctxbytes =\n720\t            unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{prefix}_contextbytes\"))() };\n721\t        let keybytes =\n722\t            unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{prefix}_keybytes\"))() };\n723\t        let bmin =\n724\t            unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{prefix}_bytes_min\"))() };\n725\t        let bmax =\n726\t            unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{prefix}_bytes_max\"))() };\n727\t        for &sklen in &[bmin, bmin + 1, 32, bmax - 1, bmax] {\n728\t            for &id in &[0u64, 1, 2, 0xffff_ffff, 0x1_0000_0000, u64::MAX] {\n729\t                for kind in 0..3 {\n730\t                    let key = match kind {\n731\t                        0 => rng.bytes(keybytes),\n732\t                        1 => vec![0u8; keybytes],\n733\t                        _ => vec![0xffu8; keybytes],\n734\t                    };\n735\t                    let ctx = match kind {\n736\t                        0 => rng.bytes(ctxbytes),\n737\t                        1 => vec![0u8; ctxbytes],\n738\t                        _ => vec![0xffu8; ctxbytes],\n739\t                    };\n740\t                    let mut a = canary(sklen);\n741\t                    let mut b = canary(sklen);\n742\t                    let (ra, rb) = unsafe {\n743\t                        (\n744\t                            c(\n745\t                                a.as_mut_ptr(),\n746\t                                sklen,\n747\t                                id,\n748\t                                ctx.as_ptr() as *const std::ffi::c_char,\n749\t                                key.as_ptr(),\n750\t                            ),\n751\t                            r(\n752\t                                b.as_mut_ptr(),\n753\t                                sklen,\n754\t                                id,\n755\t                                ctx.as_ptr() as *const std::ffi::c_char,\n756\t                                key.as_ptr(),\n757\t                            ),\n758\t                        )\n759\t                    };\n760\t                    eq_i32(&format!(\"{prefix}_derive_from_key rc\"), ra, rb);\n761\t                    eq_bytes(\n762\t                        &format!(\"{prefix}_derive_from_key(len={sklen}, id={id}, kind={kind})\"),\n763\t                        &a,\n764\t                        &b,\n765\t                    );\n766\t                }\n767\t            }\n768\t        }\n769\t    }\n770\t}\n771\t\n772\ttype HkdfExtract =\n773\t    unsafe extern \"C\" fn(*mut u8, *const u8, usize, *const u8, usize) -> i32;\n774\ttype HkdfExpand =\n775\t    unsafe extern \"C\" fn(*mut u8, usize, *const std::ffi::c_char, usize, *const u8) -> i32;\n776\ttype HkdfExInit = unsafe extern \"C\" fn(*mut u8, *const u8, usize) -> i32;\n777\ttype HkdfExUpdate = unsafe extern \"C\" fn(*mut u8, *const u8, usize) -> i32;\n778\ttype HkdfExFinal = unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32;\n779\t\n780\t#[test]\n781\tfn hkdf_extract_expand() {\n782\t    setup();\n783\t    let mut rng = Rng::new(0x7600);\n784\t    for prefix in [\"crypto_kdf_hkdf_sha256\", \"crypto_kdf_hkdf_sha512\"] {\n785\t        let kb =\n786\t            unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{prefix}_keybytes\"))() };\n787\t        let bmax =\n788\t            unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{prefix}_bytes_max\"))() };\n789\t        let (ce, re) = pair::<HkdfExtract>(&format!(\"{prefix}_extract\"));\n790\t        let (cx, rx) = pair::<HkdfExpand>(&format!(\"{prefix}_expand\"));\n791\t        for &saltlen in &[0usize, 1, 16, 32, kb, kb + 1, 100, 200] {\n792\t            for &ikmlen in &[0usize, 1, 32, 100, 200] {\n793\t                let salt = rng.bytes(saltlen);\n794\t                let ikm = rng.bytes(ikmlen);\n795\t                let sp = if saltlen == 0 {\n796\t                    std::ptr::null()\n797\t                } else {\n798\t                    salt.as_ptr()\n799\t                };\n800\t                let ip = if ikmlen == 0 {\n801\t                    std::ptr::null()\n802\t                } else {\n803\t                    ikm.as_ptr()\n804\t                };\n805\t                let mut pa = canary(kb);\n806\t                let mut pb = canary(kb);\n807\t                let (ra, rb) = unsafe {\n808\t                    (\n809\t                        ce(pa.as_mut_ptr(), sp, saltlen, ip, ikmlen),\n810\t                        re(pb.as_mut_ptr(), sp, saltlen, ip, ikmlen),\n811\t                    )\n812\t                };\n813\t                eq_i32(&format!(\"{prefix}_extract rc\"), ra, rb);\n814\t                eq_bytes(&format!(\"{prefix}_extract(salt={saltlen}, ikm={ikmlen})\"), &pa, &pb);\n815\t\n816\t                // expand from the derived PRK\n817\t                for &outlen in &[0usize, 1, 32, kb, kb + 1, 2 * kb, 3 * kb + 7, 1000, bmax] {\n818\t                    for &ctxlen in &[0usize, 1, 32, 100] {\n819\t                        let ctx = rng.bytes(ctxlen);\n820\t                        let cp = if ctxlen == 0 {\n821\t                            std::ptr::null()\n822\t                        } else {\n823\t                            ctx.as_ptr() as *const std::ffi::c_char\n824\t                        };\n825\t                        let mut a = canary(outlen.max(1));\n826\t                        let mut b = canary(outlen.max(1));\n827\t                        let (ra, rb) = unsafe {\n828\t                            (\n829\t                                cx(a.as_mut_ptr(), outlen, cp, ctxlen, pa.as_ptr()),\n830\t                                rx(b.as_mut_ptr(), outlen, cp, ctxlen, pa.as_ptr()),\n831\t                            )\n832\t                        };\n833\t                        eq_i32(&format!(\"{prefix}_expand rc(out={outlen})\"), ra, rb);\n834\t                        eq_bytes(\n835\t                            &format!(\"{prefix}_expand(out={outlen}, ctx={ctxlen})\"),\n836\t                            &a,\n837\t                            &b,\n838\t                        );\n839\t                    }\n840\t                }\n841\t            }\n842\t        }\n843\t    }\n844\t}\n845\t\n846\t#[test]\n847\tfn hkdf_extract_streaming() {\n848\t    setup();\n849\t    let mut rng = Rng::new(0x7601);\n850\t    for prefix in [\"crypto_kdf_hkdf_sha256\", \"crypto_kdf_hkdf_sha512\"] {\n851\t        let kb =\n852\t            unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{prefix}_keybytes\"))() };\n853\t        let (ci, ri) = pair::<HkdfExInit>(&format!(\"{prefix}_extract_init\"));\n854\t        let (cu, ru) = pair::<HkdfExUpdate>(&format!(\"{prefix}_extract_update\"));\n855\t        let (cf, rf) = pair::<HkdfExFinal>(&format!(\"{prefix}_extract_final\"));\n856\t        let (ce, _) = pair::<HkdfExtract>(&format!(\"{prefix}_extract\"));\n857\t        let sb = format!(\"{prefix}_statebytes\");\n858\t        for &saltlen in &[0usize, 1, 32, 100] {\n859\t            for &ikmlen in &[0usize, 1, 32, 100, 300] {\n860\t                for style in 0..4u32 {\n861\t                    let salt = rng.bytes(saltlen);\n862\t                    let ikm = rng.bytes(ikmlen);\n863\t                    let sp = if saltlen == 0 {\n864\t                        std::ptr::null()\n865\t                    } else {\n866\t                        salt.as_ptr()\n867\t                    };\n868\t                    let parts = chunks(&mut rng, ikmlen, style);\n869\t                    let mut out = [canary(kb), canary(kb)];\n870\t                    for (which, (init, upd, fin)) in\n871\t                        [(ci, cu, cf), (ri, ru, rf)].into_iter().enumerate()\n872\t                    {\n873\t                        let mut st = State::for_sym(&sb);\n874\t                        unsafe {\n875\t                            assert_eq!(init(st.as_mut_ptr(), sp, saltlen), 0);\n876\t                            let mut off = 0;\n877\t                            for &n in &parts {\n878\t                                assert_eq!(upd(st.as_mut_ptr(), ikm[off..].as_ptr(), n), 0);\n879\t                                off += n;\n880\t                            }\n881\t                            assert_eq!(fin(st.as_mut_ptr(), out[which].as_mut_ptr()), 0);\n882\t                        }\n883\t                    }\n884\t                    let (a, b) = (out[0].clone(), out[1].clone());\n885\t                    eq_bytes(\n886\t                        &format!(\"{prefix}_extract streaming(salt={saltlen}, ikm={ikmlen}, style={style})\"),\n887\t                        &a,\n888\t                        &b,\n889\t                    );\n890\t                    // streaming must equal one-shot extract\n891\t                    let mut os = canary(kb);\n892\t                    let ip = if ikmlen == 0 {\n893\t                        std::ptr::null()\n894\t                    } else {\n895\t                        ikm.as_ptr()\n896\t                    };\n897\t                    unsafe { ce(os.as_mut_ptr(), sp, saltlen, ip, ikmlen) };\n898\t                    eq_bytes(&format!(\"{prefix}_extract streaming==one-shot\"), &os, &a);\n899\t                }\n900\t            }\n901\t        }\n902\t    }\n903\t}\n904\t\n905\t#[test]\n906\tfn hash_and_kdf_keygens() {\n907\t    setup();\n908\t    for (name, len) in [\n909\t        (\"crypto_generichash_keygen\", 32usize),\n910\t        (\"crypto_generichash_blake2b_keygen\", 32),\n911\t        (\"crypto_onetimeauth_keygen\", 32),\n912\t        (\"crypto_onetimeauth_poly1305_keygen\", 32),\n913\t        (\"crypto_kdf_keygen\", 32),\n914\t        (\"crypto_kdf_hkdf_sha256_keygen\", 32),\n915\t        (\"crypto_kdf_hkdf_sha512_keygen\", 64),\n916\t    ] {\n917\t        let (c, r) = pair::<Keygen>(name);\n918\t        for seed in 0..8u64 {\n919\t            let mut a = canary(len);\n920\t            let mut b = canary(len);\n921\t            reset_rngs(0xC000 + seed);\n922\t            unsafe { c(a.as_mut_ptr()) };\n923\t            reset_rngs(0xC000 + seed);\n924\t            unsafe { r(b.as_mut_ptr()) };\n925\t            eq_bytes(&format!(\"{name} seed={seed}\"), &a, &b);\n926\t            assert_ne!(a, canary(len), \"{name} wrote nothing\");\n927\t        }\n928\t    }\n929\t}\n930\t"}]},"parent_tool_use_id":"toolu_bdrk_014UNtAYri5t489phSRr2y9D","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"84036244-d433-4c93-85cd-994bbe9729fd","timestamp":"2026-08-23T08:29:27.882Z","subagent_type":"general-purpose","task_description":"Phase C tests: hashes/MACs/XOFs/KDFs"}
