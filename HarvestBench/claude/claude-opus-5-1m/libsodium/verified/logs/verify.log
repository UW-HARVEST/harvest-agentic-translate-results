  sk: *const u8,\n160\t) -> c_int {\n161\t    _crypto_sign_ed25519_detached(sig, siglen_p, m, mlen, sk, 0)\n162\t}\n163\t\n164\t/// ```c\n165\t/// int\n166\t/// crypto_sign_ed25519(unsigned char *sm, unsigned long long *smlen_p,\n167\t///                     const unsigned char *m, unsigned long long mlen,\n168\t///                     const unsigned char *sk)\n169\t/// {\n170\t///     unsigned long long siglen;\n171\t///\n172\t///     memmove(sm + crypto_sign_ed25519_BYTES, m, mlen);\n173\t///     /* LCOV_EXCL_START */\n174\t///     if (crypto_sign_ed25519_detached(\n175\t///             sm, &siglen, sm + crypto_sign_ed25519_BYTES, mlen, sk) != 0 ||\n176\t///         siglen != crypto_sign_ed25519_BYTES) {\n177\t///         if (smlen_p != NULL) {\n178\t///             *smlen_p = 0;\n179\t///         }\n180\t///         memset(sm, 0, mlen + crypto_sign_ed25519_BYTES);\n181\t///         return -1;\n182\t///     }\n183\t///     /* LCOV_EXCL_STOP */\n184\t///\n185\t///     if (smlen_p != NULL) {\n186\t///         *smlen_p = mlen + siglen;\n187\t///     }\n188\t///     return 0;\n189\t/// }\n190\t/// ```\n191\t#[unsafe(no_mangle)]\n192\tpub unsafe extern \"C\" fn crypto_sign_ed25519(\n193\t    sm: *mut u8,\n194\t    smlen_p: *mut u64,\n195\t    m: *const u8,\n196\t    mlen: u64,\n197\t    sk: *const u8,\n198\t) -> c_int {\n199\t    let mut siglen: u64 = 0;\n200\t\n201\t    core::ptr::copy(m, sm.add(crypto_sign_ed25519_BYTES), mlen as usize);\n202\t    /* LCOV_EXCL_START */\n203\t    if crypto_sign_ed25519_detached(\n204\t        sm,\n205\t        &mut siglen,\n206\t        sm.add(crypto_sign_ed25519_BYTES) as *const u8,\n207\t        mlen,\n208\t        sk,\n209\t    ) != 0\n210\t        || siglen != crypto_sign_ed25519_BYTES as u64\n211\t    {\n212\t        if !smlen_p.is_null() {\n213\t            *smlen_p = 0;\n214\t        }\n215\t        crate::common::memset(\n216\t            sm,\n217\t            0,\n218\t            mlen.wrapping_add(crypto_sign_ed25519_BYTES as