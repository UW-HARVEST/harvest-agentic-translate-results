soft_implementation\", 32, 32),","+    ] {","+        let c: *const AegVt = sym(c_lib(), name);","+        let r: *const AegVt = sym(r_lib(), name);","+        let (ce, cd) = unsafe { ((*c).enc.unwrap(), (*c).dec.unwrap()) };","+        let (re, rd) = unsafe { ((*r).enc.unwrap(), (*r).dec.unwrap()) };","+        for &mlen in &[0usize, 1, 15, 16, 17, 31, 32, 33, 64, 100, 1000] {","+            for &adlen in &[0usize, 1, 16, 32, 100] {","+                let k = rng.bytes(kb);","+                let n = rng.bytes(nb);","+                let m = rng.bytes(mlen);","+                let ad = rng.bytes(adlen);","+                let mut cbuf = [canary(mlen.max(1)), canary(mlen.max(1))];","+                let mut tag = [canary(32), canary(32)];","+                let mut rcs = [0i32; 2];","+                for (w, f) in [ce, re].into_iter().enumerate() {","+                    rcs[w] = unsafe {","+                        f(cbuf[w].as_mut_ptr(), tag[w].as_mut_ptr(), 32, m.as_ptr(), mlen,","+                          ad.as_ptr(), adlen, n.as_ptr(), k.as_ptr())","+                    };","+                }","+                eq_i32(&format!(\"{name}.encrypt_detached rc\"), rcs[0], rcs[1]);","+                let (a, b) = (cbuf[0].clone(), cbuf[1].clone());","+                eq_bytes(&format!(\"{name}.encrypt_detached c(m={mlen},ad={adlen})\"), &a, &b);","+                let (a, b) = (tag[0].clone(), tag[1].clone());","+                eq_bytes(&format!(\"{name}.encrypt_detached mac(m={mlen},ad={adlen})\"), &a, &b);","+","+                let mut pbuf = [canary(mlen.max(1)), canary(mlen.max(1))];","+                let mut rcs = [0i32; 2];","+                for (w, f) in [cd, rd].into_iter().enumerate() {","+                    rcs[w] = unsafe {","+                        f(pbuf[w].as_mut_ptr(), cbuf[0].as_ptr(), mlen, tag[0].as_ptr(), 32,","+                          ad.as_ptr(), adlen, n.as_ptr(), k.as_ptr())","+                    };","+                }","+                eq_i32(&format!(\"{name}.decrypt_detached rc\"), rcs[0], rcs[1]);","+                assert_eq!(rcs[0], 0);","+                let (a, b) = (pbuf[0].clone(), pbuf[1].clone());","+                eq_bytes(&format!(\"{name}.decrypt_detached(m={mlen})\"), &a, &b);","+                assert_eq!(&a[..mlen], &m[..]);","+","+                // and a corrupted tag through the v-table","+                let mut bad = tag[0].clone();","+                bad[0] ^= 1;","+                let mut rcs = [0i32; 2];","+                let mut pbuf = [canary(mlen.max(1)), canary(mlen.max(1))];","+                for (w, f) in [cd, rd].into_iter().enumerate() {","+                    rcs[w] = unsafe {","+                        f(pbuf[w].as_mut_ptr(), cbuf[0].as_ptr(), mlen, bad.as_ptr(), 32,","+                          ad.as_ptr(), adlen, n.as_ptr(), k.as_ptr())","+                    };","+                }","+                eq_i32(&format!(\"{name}.decrypt_detached bad tag rc\"), rcs[0], rcs[1]);","+                assert_eq!(rcs[0], -1);","+                let (a, b) = (pbuf[0].clone(), pbuf[1].clone());","+                eq_bytes(&format!(\"{name}.decrypt_detached bad tag buf\"), &a, &b);","+            }","+        }","+    }","+","+    // ---- crypto_scalarmult_curve25519_ref10_implementation: mult, mult_base --","+    #[repr(C)]","+    struct SmVt {","+        mult: Option<unsafe extern \"C\" fn(*mut u8, *const u8, *const u8) -> i32>,","+        mult_base: Option<unsafe extern \"C\" fn(*mut u8, *const u8) -> i32>,","+    }","+    {","+        let c: *const SmVt = sym(c_lib(), \"crypto_scalarmult_curve25519_ref10_implementation\");","+        let r: *const SmVt = sym(r_lib(), \"crypto_scalarmult_curve25519_ref10_implementation\");","+        let (cm, cb) = unsafe { ((*c).mult.unwrap(), (*c).mult_base.unwrap()) };","+        let (rm, rb) = unsafe { ((*r).mult.unwrap(), (*r).mult_base.unwrap()) };","+        let mut points: Vec<Vec<u8>> = vec![vec![0u8; 32], vec![0xffu8; 3