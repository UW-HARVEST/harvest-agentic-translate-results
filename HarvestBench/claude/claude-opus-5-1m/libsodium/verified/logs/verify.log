— exported-symbol parity (Phase A / Phase D)\\n\")\nA(\"Mechanically derived from `nm -D --defined-only` on both shared objects — the\")\nA(\"**complete** dynamic-symbol table, including the 121 `_`-prefixed internal\")\nA(\"exports (`_crypto_*_pick_best_implementation`, `_sodium_softaes_*`,\")\nA(\"`_sodium_ge25519_*`, `_sodium_argon2_*`, `_sodium_escrypt_*`, ...) and the\")\nA(\"macro-generated ones.\\n\")\nA(\"```sh\")\nA(\"# C reference\")\nA(\"cd c_src && mkdir -p build && cd build \\\\\")\nA(\"  && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\")\nA(\"# Rust\")\nA(\"cargo build --no-default-features\")\nA(\"# compare\")\nA(\"nm -D --defined-only c_src/build/libsodium.so     | awk '$3!=\\\"\\\"{print $3}' | sort -u > c.txt\")\nA(\"nm -D --defined-only target/debug/liblibsodium.so | awk '$3!=\\\"\\\"{print $3}' | sort -u > r.txt\")\nA(\"comm -23 c.txt r.txt   # exported by C, MISSING from Rust\")\nA(\"comm -13 c.txt r.txt   # exported by Rust only\")\nA(\"```\")\nA(\"\")\nA(\"Reproduced end to end by `.phaseA/verify_all.sh` (step 3).\\n\")\nA(\"## Summary\\n\")\nA(\"| metric | value |\")\nA(\"|---|---|\")\nA(f\"| symbols exported by the C `.so` | **{len(c)}** |\")\nA(f\"| symbols exported by the Rust `.so` | **{len(r)}** |\")\nA(f\"| **exported by C but MISSING from Rust** | **{len(missing)}** |\")\nA(f\"| exported by Rust but not by C | **{len(extra)}** |\")\nA(f\"| non-libc **undefined** symbols in the Rust `.so` | **0** |\")\nA(f\"| exported symbols actually driven by a differential test | **{len(reached)} / {len(pub)}** |\")\nA(\"\")\nA(\"## MISSING SYMBOLS\\n\")\nif missing:\n    for m in missing: A(f\"- `{m}` **MISSING**\")\nelse:\n    A(\"**NONE — the symbol diff is empty in both directions.**\\n\")\n    A(\"```\")\n    A(\"$ comm -23 c.txt r.txt | wc -l    ->  0\")\n    A(\"$ comm -13 c.txt r.txt | wc -l    ->  0\")\n    A(\"```\\n\")\nA(\"## No symbol is stubbed\\n\")\nA(\"Symbol parity alone would be satisfiable by stubs, so it is backed by a\")\nA(\"**reachability audit** (`.phaseA/symbol_audit.py`): for each exported symbol it\")\nA(\"checks that some test in `tests/` actually looks it up and calls it — either by\")\nA(\"its literal name or through a `format!(\\\"{prefix}_suffix\\\")` construction, which\")\nA(\"is how the parameterised tests reach whole primitive families.\\n\")\nA(\"```\")\nA(f\"exported symbols (excl. ELF runtime): {len(pub)}\")\nA(f\"  referenced literally in tests      : {len(literal)}\")\nA(f\"  reachable via format! composition  : {len(composed - literal)}\")\nA(f\"  TOTAL reached                      : {len(reached)}\")\nA(f\"  UNREFERENCED                       : {len(unreached)}\")\nA(\"```\\n\")\nif unreached:\n    A(\"Unreferenced:\\n\")\n    for m in unreached: A(f\"- `{m}`\")\n    A(\"\")\nelse:\n    A(f\"Every one of the {len(pub)} exported symbols is driven, through `dlsym`, by at\")\n    A(f\"least one of the {ntests} differential tests, and each of those tests compares\")\n    A(\"the C result against the Rust result byte-for-byte (return value, every\")\n    A(\"out-parameter, `errno`, output-buffer contents including untouched regions,\")\n    A(\"and — for abort paths — the termination signal / exit code and the side\")\n    A(\"effects written before the abort).\\n\")\nA(\"## Undefined (imported) symbols in the Rust `.so`\\n\")\nA(f\"{len(ru)} undefined symbols, **all** libc / libgcc / ELF-runtime imports:\\n\")\nA(\"```\")\nfor x in ru: A(x)\nA(\"```\\n\")\nA(f\"The C `.so` imports {len(cu)}:\\n\")\nA(\"```\")\nfor x in cu: A(x)\nA(\"```\\n\")\nA(\"## Symbol-type notes\\n\")\nd = sorted(k for k,v in c.items() if v.upper()=='D')\nA(f\"* {len(d)} exports are **data objects** (`D` in both builds) — the implementation\")\nA(\"  v-tables. They are compared structurally *and* driven functionally through\")\nA(\"  their function pointers by\")\nA(\"  `t06_internal_exports::exported_implementation_vtables_are_functionally_equal`:\")\nfor n in d: A(f\"  * `{n}`\")\nw = sorted(k for k,v in c.items() if v.upper()=='W')\nA(f\"* {len(w)} exports are **weak** (`W`) in the C `.so` and strong (`T`) in the Rust\")\nA(\"  `.so`:\")\nfor n in w: A(f\"  * `{n}` -> Rust `{r.get(n)}`\")\nA(\"\")\nA(\"  Both are dynamically resolvable functions with identical names and\")\nA(\"  signatures, so `dlsym` finds them in either build; weak-vs-strong binding is a\")\nA(\"  link-time property, not part of the ABI a `dlopen` consumer observes. They are\")\nA(\"  compared by `t01_constants::int_accessors_match`.\\n\")\nA(\"## Full symbol table\\n\")\nA(\"`nm` type letters: `T` text (function), `D` initialised data, `W` weak, `B` bss.\\n\")\nA(\"| # | symbol | C type | Rust type | in Rust `.so` | driven by a test |\")\nA(\"|---|--------|--------|-----------|---------------|------------------|\")\nfor i, n in enumerate(sorted(c), 1):\n    drv = \"—\" if n in SKIP else (\"yes\" if n in reached else \"**NO**\")\n    A(f\"| {i} | `{n}` | {c[n]} | {r.get(n,'—')} | {'yes' if n in r else '**NO**'} | {drv} |\")\nopen('SYMBOLS.md','w').write(\"\\n\".join(L)+\"\\n\")\nprint(f\"SYMBOLS.md: {len(c)} C / {len(r)} Rust, missing={len(missing)}, extra={len(extra)}, reached={len(reached)}/{len(pub)}, tests={ntests}\")\nPY\nwc -l SYMBOLS.md; grep -c '| yes | yes |' SYMBOLS.md","description":"Regenerate SYMBOLS.md with reachability evidence"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1001,"cache_read_input_tokens":544922,"cache_creation":{"ephemeral_5m_input_tokens":1001,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"d9ea514a-73c2-4edd-a441-95fe5b0aff2a","timestamp":"2026-08-23T09:47:53.124Z"}
