(k(1) << 8) | (k(2) << 16) | (k(3) << 24);\n174\t    w[1] = k(4) | (k(5) << 8) | (k(6) << 16) | (k(7) << 24);\n175\t    w[2] = k(8) | (k(9) << 8) | (k(10) << 16) | (k(11) << 24);\n176\t    w[3] = k(12) | (k(13) << 8) | (k(14) << 16) | (k(15) << 24);\n177\t    w[4] = k(16) | (k(17) << 8) | (k(18) << 16) | (k(19) << 24);\n178\t    w[5] = k(20) | (k(21) << 8) | (k(22) << 16) | (k(23) << 24);\n179\t    w[6] = k(24) | (k(25) << 8) | (k(26) << 16) | (k(27) << 24);\n180\t    w[7] = k(28) | (k(29) << 8) | (k(30) << 16) | (k(31) << 24);\n181\t\n182\t    for i in 8..60usize {\n183\t        let mut temp = w[i - 1];\n184\t        if i % 8 == 0 {\n185\t            temp = sub_word(rot_word(temp)) ^ (RCON[i / 8] as u32);\n186\t        } else if i % 8 == 4 {\n187\t            temp = sub_word(temp);\n188\t        }\n189\t        w[i] = w[i - 8] ^ temp;\n190\t    }\n191\t\n192\t    for i in 0..15usize {\n193\t        unsafe {\n194\t            (*rkeys.add(i)).w0 = w[i * 4 + 0];\n195\t            (*rkeys.add(i)).w1 = w[i * 4 + 1];\n196\t            (*rkeys.add(i)).w2 = w[i * 4 + 2];\n197\t            (*rkeys.add(i)).w3 = w[i * 4 + 3];\n198\t        }\n199\t    }\n200\t}\n201\t\n202\t/// `static inline uint8_t xtime(uint8_t a)`\n203\t#[inline(always)]\n204\tfn xtime(a: u8) -> u8 {\n205\t    (((a as u32) << 1) ^ ((((a as u32) >> 7) & 1) * 0x1b)) as u8\n206\t}\n207\t\n208\t/// `static inline uint8_t gf_mul_09(uint8_t a)`\n209\t#[inline(always)]\n210\tfn gf_mul_09(a: u8) -> u8 {\n211\t    xtime(xtime(xtime(a))) ^ a\n212\t}\n213\t\n214\t/// `static inline uint8_t gf_mul_0b(uint8_t a)`\n215\t#[inline(always)]\n216\tfn gf_mul_0b(a: u8) -> u8 {\n217\t    xtime(xtime(xtime(a)) ^ a) ^ a\n218\t}\n219\t\n220\t/// `static inline uint8_t gf_mul_0d(uint8_t a)`\n221\t#[inline(always)]\n222\tfn gf_mul_0d(a: u8) -> u8 {\n223\t    xtime(xtime(xtime(a) ^ a)) ^ a\n224\t}\n225\t\n226\t/// `static inline uint8_t gf_mul_0e(uint8_t a)`\n227\t#[inline(always)]\n228\tfn gf_mul_0e(a: u8) -> u8 {\n229\t    xtime(