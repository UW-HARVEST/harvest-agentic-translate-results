{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_5qvwe5fu7zx4kg7ce77h6smb623tjnijk23l6rnfe6hnmsmnd7uq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Y7kafXn5PULRnBmbRpspuU","name":"Bash","input":{"command":"python3 - <<'PY'\np='tests/t04_aead.rs'\ns=open(p).read()\ns=s.replace(\n\"const CHUNK_LENS: &[usize] = &[131071, 131072, 131073, 131136, 262144];\",\n\"const CHUNK_LENS: &[usize] = &[131071, 131072, 131073, 131136, 200000, 262144];\")\nassert 'CHUNK_LENS: &[usize] = &[131071, 131072, 131073, 131136, 200000, 262144]' in s\nopen(p,'w').write(s)\nPY\ncat >> tests/t04_aead.rs <<'EOF'\n\n/// CONFIGS G3-100 — the original (8-byte-nonce) and IETF (12-byte-nonce)\n/// chacha20poly1305 constructions differ in nonce length, AD padding and the\n/// order of the length fields, so a ciphertext produced by one must NOT verify\n/// under the other. Both libraries must reject in exactly the same way.\n#[test]\nfn chacha20poly1305_variants_are_not_interchangeable() {\n    setup();\n    let mut rng = Rng::new(0x800B);\n    let (ce_ietf, _) = pair::<Enc>(\"crypto_aead_chacha20poly1305_ietf_encrypt\");\n    let (ce_orig, _) = pair::<Enc>(\"crypto_aead_chacha20poly1305_encrypt\");\n    let (cd_ietf, rd_ietf) = pair::<Dec>(\"crypto_aead_chacha20poly1305_ietf_decrypt\");\n    let (cd_orig, rd_orig) = pair::<Dec>(\"crypto_aead_chacha20poly1305_decrypt\");\n\n    for &mlen in &[0usize, 1, 16, 17, 64, 100] {\n        for &adlen in &[0usize, 16, 17] {\n            let k = rng.bytes(32);\n            // a 12-byte nonce whose first 8 bytes double as the original\n            // variant's nonce\n            let n12 = rng.bytes(12);\n            let m = rng.bytes(mlen);\n            let ad = rng.bytes(adlen);\n\n            // encrypt with IETF, try to decrypt with the original variant\n            let mut c = canary(mlen + 16);\n            unsafe {\n                ce_ietf(\n                    c.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), mlen as u64,\n                    ad.as_ptr(), adlen as u64, std::ptr::null(), n12.as_ptr(), k.as_ptr(),\n                );\n            }\n            let mut o1 = canary(mlen.max(1));\n            let mut o2 = canary(mlen.max(1));\n            let mut l1 = 0xDEADu64;\n            let mut l2 = 0xDEADu64;\n            let (a, b) = unsafe {\n                (\n                    cd_orig(o1.as_mut_ptr(), &mut l1, std::ptr::null_mut(), c.as_ptr(),\n                            (mlen + 16) as u64, ad.as_ptr(), adlen as u64, n12.as_ptr(), k.as_ptr()),\n                    rd_orig(o2.as_mut_ptr(), &mut l2, std::ptr::null_mut(), c.as_ptr(),\n                            (mlen + 16) as u64, ad.as_ptr(), adlen as u64, n12.as_ptr(), k.as_ptr()),\n                )\n            };\n            eq_i32(\"ietf ct under original decrypt rc\", a, b);\n            eq_usize(\"ietf ct under original decrypt *mlen_p\", l1 as usize, l2 as usize);\n            eq_bytes(\"ietf ct under original decrypt m\", &o1, &o2);\n\n            // encrypt with the original variant, try to decrypt with IETF\n            let mut c = canary(mlen + 16);\n            unsafe {\n                ce_orig(\n                    c.as_mut_ptr(), std::ptr::null_mut(), m.as_ptr(), mlen as u64,\n                    ad.as_ptr(), adlen as u64, std::ptr::null(), n12.as_ptr(), k.as_ptr(),\n                );\n            }\n            let mut o1 = canary(mlen.max(1));\n            let mut o2 = canary(mlen.max(1));\n            let mut l1 = 0xDEADu64;\n            let mut l2 = 0xDEADu64;\n            let (a, b) = unsafe {\n                (\n                    cd_ietf(o1.as_mut_ptr(), &mut l1, std::ptr::null_mut(), c.as_ptr(),\n                            (mlen + 16) as u64, ad.as_ptr(), adlen as u64, n12.as_ptr(), k.as_ptr()),\n                    rd_ietf(o2.as_mut_ptr(), &mut l2, std::ptr::null_mut(), c.as_ptr(),\n                            (mlen + 16) as u64, ad.as_ptr(), adlen as u64, n12.as_ptr(), k.as_ptr()),\n                )\n            };\n            eq_i32(\"original ct under ietf decrypt rc\", a, b);\n            eq_usize(\"original ct under ietf decrypt *mlen_p\", l1 as usize, l2 as usize);\n            eq_bytes(\"original ct under ietf decrypt m\", &o1, &o2);\n        }\n    }\n}\n\n/// CONFIGS G3-131 / G3-132 / G3-133 / G3-134 — cross-primitive invariants:\n/// tag placement, the five distinct `messagebytes_max` values, `nsecbytes == 0`\n/// everywhere, and the ABYTES split (32 for AEGIS -> `crypto_verify_32`,\n/// 16 for the poly1305 variants -> `crypto_verify_16`).\n#[test]\nfn aead_cross_primitive_invariants() {\n    setup();\n    let expect: &[(&str, usize, usize, usize, usize, u64)] = &[\n        // (prefix, keybytes, npubbytes, abytes, nsecbytes, messagebytes_max)\n        (\"crypto_aead_aegis128l\", 16, 16, 32, 0, 2305843009213693951),\n        (\"crypto_aead_aegis256\", 32, 32, 32, 0, 2305843009213693951),\n        (\"crypto_aead_chacha20poly1305\", 32, 8, 16, 0, 18446744073709551599),\n        (\"crypto_aead_chacha20poly1305_ietf\", 32, 12, 16, 0, 274877906880),\n        (\"crypto_aead_xchacha20poly1305_ietf\", 32, 24, 16, 0, 18446744073709551599),\n        (\"crypto_aead_aes256gcm\", 32, 12, 16, 0, 68719476704),\n    ];\n    for &(p, kb, nb, ab, nsb, max) in expect {\n        let s = sizes(p);\n        assert_eq!((s.kb, s.nb, s.ab, s.nsb), (kb, nb, ab, nsb), \"{p} sizes\");\n        assert_eq!(s.max, max, \"{p}_messagebytes_max\");\n        // and the Rust library must report exactly the same\n        let g = |lib: &'static libloading::Library, n: &str| -> usize {\n            unsafe { sym::<unsafe extern \"C\" fn() -> usize>(lib, &format!(\"{p}_{n}\"))() }\n        };\n        let gm = |lib: &'static libloading::Library| -> u64 {\n            unsafe { sym::<unsafe extern \"C\" fn() -> u64>(lib, &format!(\"{p}_messagebytes_max\"))() }\n        };\n        for n in [\"keybytes\", \"npubbytes\", \"abytes\", \"nsecbytes\"] {\n            assert_eq!(g(c_lib(), n), g(r_lib(), n), \"{p}_{n}\");\n        }\n        assert_eq!(gm(c_lib()), gm(r_lib()), \"{p}_messagebytes_max\");\n    }\n    // the five available primitives split 2/3 on tag length\n    let ab32: Vec<&str> = AEADS.iter().copied().filter(|p| sizes(p).ab == 32).collect();\n    let ab16: Vec<&str> = AEADS.iter().copied().filter(|p| sizes(p).ab == 16).collect();\n    assert_eq!(ab32.len(), 2, \"two AEGIS primitives use a 32-byte tag\");\n    assert_eq!(ab16.len(), 3, \"three poly1305 primitives use a 16-byte tag\");\n}\nEOF\ntimeout 600 cargo test --no-default-features --test t04_aead 2>&1 | tail -25","description":"Add G3 gap tests and run","timeout":600000}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":556,"cache_read_input_tokens":368125,"cache_creation":{"ephemeral_5m_input_tokens":556,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"73ea23f7-c43a-4a8a-a199-6e641b5b8376","timestamp":"2026-08-23T08:38:03.003Z"}
