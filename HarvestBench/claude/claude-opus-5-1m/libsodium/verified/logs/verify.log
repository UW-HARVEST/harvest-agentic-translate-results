{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DkeL3T9vqLmdCEL4ajqqfG","type":"tool_result","content":"     1\t/*\n     2\t   BLAKE2 reference source code package - C implementations\n     3\t\n     4\t   Written in 2012 by Samuel Neves <sneves@dei.uc.pt>\n     5\t\n     6\t   To the extent possible under law, the author(s) have dedicated all copyright\n     7\t   and related and neighboring rights to this software to the public domain\n     8\t   worldwide. This software is distributed without any warranty.\n     9\t\n    10\t   You should have received a copy of the CC0 Public Domain Dedication along\n    11\t   with\n    12\t   this software. If not, see\n    13\t   <http://creativecommons.org/publicdomain/zero/1.0/>.\n    14\t*/\n    15\t\n    16\t#include <assert.h>\n    17\t#include <stddef.h>\n    18\t#include <stdint.h>\n    19\t#include <stdlib.h>\n    20\t#include <string.h>\n    21\t\n    22\t#include \"blake2.h\"\n    23\t#include \"core.h\"\n    24\t#include \"private/common.h\"\n    25\t#include \"runtime.h\"\n    26\t#include \"utils.h\"\n    27\t\n    28\tstatic blake2b_compress_fn blake2b_compress = blake2b_compress_ref;\n    29\t\n    30\tstatic const uint64_t blake2b_IV[8] = {\n    31\t    0x6a09e667f3bcc908ULL, 0xbb67ae8584caa73bULL, 0x3c6ef372fe94f82bULL,\n    32\t    0xa54ff53a5f1d36f1ULL, 0x510e527fade682d1ULL, 0x9b05688c2b3e6c1fULL,\n    33\t    0x1f83d9abfb41bd6bULL, 0x5be0cd19137e2179ULL\n    34\t};\n    35\t\n    36\t/* LCOV_EXCL_START */\n    37\tstatic inline int\n    38\tblake2b_set_lastnode(blake2b_state *S)\n    39\t{\n    40\t    S->f[1] = -1;\n    41\t    return 0;\n    42\t}\n    43\t/* LCOV_EXCL_STOP */\n    44\t\n    45\tstatic inline int\n    46\tblake2b_is_lastblock(const blake2b_state *S)\n    47\t{\n    48\t    return S->f[0] != 0;\n    49\t}\n    50\t\n    51\tstatic inline int\n    52\tblake2b_set_lastblock(blake2b_state *S)\n    53\t{\n    54\t    if (S->last_node) {\n    55\t        blake2b_set_lastnode(S); /* LCOV_EXCL_LINE */\n    56\t    }\n    57\t    S->f[0] = -1;\n    58\t    return 0;\n    59\t}\n    60\t\n    61\tstatic inline int\n    62\tblake2b_increment_counter(blake2b_state *S, const uint64_t inc)\n    63\t{\n    64\t#ifdef HAVE_TI_MODE\n    65\t    uint128_t t = ((uint128_t) S->t[1] << 64) | S->t[0];\n    66\t    t += inc;\n    67\t    S->t[0] = (uint64_t)(t >> 0);\n    68\t    S->t[1] = (uint64_t)(t >> 64);\n    69\t#else\n    70\t    S->t[0] += inc;\n    71\t    S->t[1] += (S->t[0] < inc);\n    72\t#endif\n    73\t    return 0;\n    74\t}\n    75\t\n    76\t/* Parameter-related functions */\n    77\tstatic inline int\n    78\tblake2b_param_set_salt(blake2b_param *P, const uint8_t salt[BLAKE2B_SALTBYTES])\n    79\t{\n    80\t    memcpy(P->salt, salt, BLAKE2B_SALTBYTES);\n    81\t    return 0;\n    82\t}\n    83\t\n    84\tstatic inline int\n    85\tblake2b_param_set_personal(blake2b_param *P,\n    86\t                           const uint8_t  personal[BLAKE2B_PERSONALBYTES])\n    87\t{\n    88\t    memcpy(P->personal, personal, BLAKE2B_PERSONALBYTES);\n    89\t    return 0;\n    90\t}\n    91\t\n    92\tstatic inline int\n    93\tblake2b_init0(blake2b_state *S)\n    94\t{\n    95\t    int i;\n    96\t\n    97\t    for (i  = 0; i < 8; i++) {\n    98\t        S->h[i] = blake2b_IV[i];\n    99\t    }\n   100\t    /* zero everything between .t and .last_node */\n   101\t    memset((void *) &S->t, 0,\n   102\t           offsetof(blake2b_state, last_node) + sizeof(S->last_node)\n   103\t           - offsetof(blake2b_state, t));\n   104\t    return 0;\n   105\t}\n   106\t\n   107\t/* init xors IV with input parameter block */\n   108\tint\n   109\tblake2b_init_param(blake2b_state *S, const blake2b_param *P)\n   110\t{\n   111\t    size_t         i;\n   112\t    const uint8_t *p;\n   113\t\n   114\t    COMPILER_ASSERT(sizeof *P == 64);\n   115\t    blake2b_init0(S);\n   116\t    p = (const uint8_t *) (P);\n   117\t\n   118\t    /* IV XOR ParamBlock */\n   119\t    for (i = 0; i < 8; i++) {\n   120\t        S->h[i] ^= LOAD64_LE(p + sizeof(S->h[i]) * i);\n   121\t    }\n   122\t    return 0;\n   123\t}\n   124\t\n   125\tint\n   126\tblake2b_init(blake2b_state *S, const uint8_t outlen)\n   127\t{\n   128\t    blake2b_param P[1];\n   129\t\n   130\t    if ((!outlen) || (outlen > BLAKE2B_OUTBYTES)) {\n   131\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   132\t    }\n   133\t    P->digest_length = outlen;\n   134\t    P->key_length    = 0;\n   135\t    P->fanout        = 1;\n   136\t    P->depth         = 1;\n   137\t    STORE32_LE(P->leaf_length, 0);\n   138\t    STORE64_LE(P->node_offset, 0);\n   139\t    P->node_depth   = 0;\n   140\t    P->inner_length = 0;\n   141\t    memset(P->reserved, 0, sizeof(P->reserved));\n   142\t    memset(P->salt, 0, sizeof(P->salt));\n   143\t    memset(P->personal, 0, sizeof(P->personal));\n   144\t    return blake2b_init_param(S, P);\n   145\t}\n   146\t\n   147\tint\n   148\tblake2b_init_salt_personal(blake2b_state *S, const uint8_t outlen,\n   149\t                           const void *salt, const void *personal)\n   150\t{\n   151\t    blake2b_param P[1];\n   152\t\n   153\t    if ((!outlen) || (outlen > BLAKE2B_OUTBYTES)) {\n   154\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   155\t    }\n   156\t    P->digest_length = outlen;\n   157\t    P->key_length    = 0;\n   158\t    P->fanout        = 1;\n   159\t    P->depth         = 1;\n   160\t    STORE32_LE(P->leaf_length, 0);\n   161\t    STORE64_LE(P->node_offset, 0);\n   162\t    P->node_depth   = 0;\n   163\t    P->inner_length = 0;\n   164\t    memset(P->reserved, 0, sizeof(P->reserved));\n   165\t    if (salt != NULL) {\n   166\t        blake2b_param_set_salt(P, (const uint8_t *) salt);\n   167\t    } else {\n   168\t        memset(P->salt, 0, sizeof(P->salt));\n   169\t    }\n   170\t    if (personal != NULL) {\n   171\t        blake2b_param_set_personal(P, (const uint8_t *) personal);\n   172\t    } else {\n   173\t        memset(P->personal, 0, sizeof(P->personal));\n   174\t    }\n   175\t    return blake2b_init_param(S, P);\n   176\t}\n   177\t\n   178\tint\n   179\tblake2b_init_key(blake2b_state *S, const uint8_t outlen, const void *key,\n   180\t                 const uint8_t keylen)\n   181\t{\n   182\t    blake2b_param P[1];\n   183\t\n   184\t    if ((!outlen) || (outlen > BLAKE2B_OUTBYTES)) {\n   185\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   186\t    }\n   187\t    if (!key || !keylen || keylen > BLAKE2B_KEYBYTES) {\n   188\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   189\t    }\n   190\t    P->digest_length = outlen;\n   191\t    P->key_length    = keylen;\n   192\t    P->fanout        = 1;\n   193\t    P->depth         = 1;\n   194\t    STORE32_LE(P->leaf_length, 0);\n   195\t    STORE64_LE(P->node_offset, 0);\n   196\t    P->node_depth   = 0;\n   197\t    P->inner_length = 0;\n   198\t    memset(P->reserved, 0, sizeof(P->reserved));\n   199\t    memset(P->salt, 0, sizeof(P->salt));\n   200\t    memset(P->personal, 0, sizeof(P->personal));\n   201\t\n   202\t    if (blake2b_init_param(S, P) < 0) {\n   203\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   204\t    }\n   205\t    {\n   206\t        uint8_t block[BLAKE2B_BLOCKBYTES];\n   207\t        memset(block, 0, BLAKE2B_BLOCKBYTES);\n   208\t        memcpy(block, key, keylen); /* key and keylen cannot be 0 */\n   209\t        blake2b_update(S, block, BLAKE2B_BLOCKBYTES);\n   210\t        sodium_memzero(block, BLAKE2B_BLOCKBYTES); /* Burn the key from stack */\n   211\t    }\n   212\t    return 0;\n   213\t}\n   214\t\n   215\tint\n   216\tblake2b_init_key_salt_personal(blake2b_state *S, const uint8_t outlen,\n   217\t                               const void *key, const uint8_t keylen,\n   218\t                               const void *salt, const void *personal)\n   219\t{\n   220\t    blake2b_param P[1];\n   221\t\n   222\t    if ((!outlen) || (outlen > BLAKE2B_OUTBYTES)) {\n   223\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   224\t    }\n   225\t    if (!key || !keylen || keylen > BLAKE2B_KEYBYTES) {\n   226\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   227\t    }\n   228\t    P->digest_length = outlen;\n   229\t    P->key_length    = keylen;\n   230\t    P->fanout        = 1;\n   231\t    P->depth         = 1;\n   232\t    STORE32_LE(P->leaf_length, 0);\n   233\t    STORE64_LE(P->node_offset, 0);\n   234\t    P->node_depth   = 0;\n   235\t    P->inner_length = 0;\n   236\t    memset(P->reserved, 0, sizeof(P->reserved));\n   237\t    if (salt != NULL) {\n   238\t        blake2b_param_set_salt(P, (const uint8_t *) salt);\n   239\t    } else {\n   240\t        memset(P->salt, 0, sizeof(P->salt));\n   241\t    }\n   242\t    if (personal != NULL) {\n   243\t        blake2b_param_set_personal(P, (const uint8_t *) personal);\n   244\t    } else {\n   245\t        memset(P->personal, 0, sizeof(P->personal));\n   246\t    }\n   247\t\n   248\t    if (blake2b_init_param(S, P) < 0) {\n   249\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   250\t    }\n   251\t    {\n   252\t        uint8_t block[BLAKE2B_BLOCKBYTES];\n   253\t        memset(block, 0, BLAKE2B_BLOCKBYTES);\n   254\t        memcpy(block, key, keylen); /* key and keylen cannot be 0 */\n   255\t        blake2b_update(S, block, BLAKE2B_BLOCKBYTES);\n   256\t        sodium_memzero(block, BLAKE2B_BLOCKBYTES); /* Burn the key from stack */\n   257\t    }\n   258\t    return 0;\n   259\t}\n   260\t\n   261\t/* inlen now in bytes */\n   262\tint\n   263\tblake2b_update(blake2b_state *S, const uint8_t *in, uint64_t inlen)\n   264\t{\n   265\t    while (inlen > 0) {\n   266\t        size_t left = S->buflen;\n   267\t        size_t fill = 2 * BLAKE2B_BLOCKBYTES - left;\n   268\t\n   269\t        if (inlen > fill) {\n   270\t            memcpy(S->buf + left, in, fill); /* Fill buffer */\n   271\t            S->buflen += fill;\n   272\t            blake2b_increment_counter(S, BLAKE2B_BLOCKBYTES);\n   273\t            blake2b_compress(S, S->buf); /* Compress */\n   274\t            memcpy(S->buf, S->buf + BLAKE2B_BLOCKBYTES,\n   275\t                   BLAKE2B_BLOCKBYTES); /* Shift buffer left */\n   276\t            S->buflen -= BLAKE2B_BLOCKBYTES;\n   277\t            in += fill;\n   278\t            inlen -= fill;\n   279\t        } else /* inlen <= fill */\n   280\t        {\n   281\t            memcpy(S->buf + left, in, inlen);\n   282\t            S->buflen += inlen; /* Be lazy, do not compress */\n   283\t            in += inlen;\n   284\t            inlen -= inlen;\n   285\t        }\n   286\t    }\n   287\t\n   288\t    return 0;\n   289\t}\n   290\t\n   291\tint\n   292\tblake2b_final(blake2b_state *S, uint8_t *out, uint8_t outlen)\n   293\t{\n   294\t    unsigned char buffer[BLAKE2B_OUTBYTES];\n   295\t\n   296\t    if (!outlen || outlen > BLAKE2B_OUTBYTES) {\n   297\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   298\t    }\n   299\t    if (blake2b_is_lastblock(S)) {\n   300\t        return -1;\n   301\t    }\n   302\t    if (S->buflen > BLAKE2B_BLOCKBYTES) {\n   303\t        blake2b_increment_counter(S, BLAKE2B_BLOCKBYTES);\n   304\t        blake2b_compress(S, S->buf);\n   305\t        S->buflen -= BLAKE2B_BLOCKBYTES;\n   306\t        assert(S->buflen <= BLAKE2B_BLOCKBYTES);\n   307\t        memcpy(S->buf, S->buf + BLAKE2B_BLOCKBYTES, S->buflen);\n   308\t    }\n   309\t\n   310\t    blake2b_increment_counter(S, S->buflen);\n   311\t    blake2b_set_lastblock(S);\n   312\t    memset(S->buf + S->buflen, 0,\n   313\t           2 * BLAKE2B_BLOCKBYTES - S->buflen); /* Padding */\n   314\t    blake2b_compress(S, S->buf);\n   315\t\n   316\t    COMPILER_ASSERT(sizeof buffer == 64U);\n   317\t    STORE64_LE(buffer + 8 * 0, S->h[0]);\n   318\t    STORE64_LE(buffer + 8 * 1, S->h[1]);\n   319\t    STORE64_LE(buffer + 8 * 2, S->h[2]);\n   320\t    STORE64_LE(buffer + 8 * 3, S->h[3]);\n   321\t    STORE64_LE(buffer + 8 * 4, S->h[4]);\n   322\t    STORE64_LE(buffer + 8 * 5, S->h[5]);\n   323\t    STORE64_LE(buffer + 8 * 6, S->h[6]);\n   324\t    STORE64_LE(buffer + 8 * 7, S->h[7]);\n   325\t    memcpy(out, buffer, outlen); /* outlen <= BLAKE2B_OUTBYTES (64) */\n   326\t\n   327\t    sodium_memzero(S->h, sizeof S->h);\n   328\t    sodium_memzero(S->buf, sizeof S->buf);\n   329\t\n   330\t    return 0;\n   331\t}\n   332\t\n   333\t/* inlen, at least, should be uint64_t. Others can be size_t. */\n   334\tint\n   335\tblake2b(uint8_t *out, const void *in, const void *key, const uint8_t outlen,\n   336\t        const uint64_t inlen, uint8_t keylen)\n   337\t{\n   338\t    CRYPTO_ALIGN(64) blake2b_state S[1];\n   339\t\n   340\t    /* Verify parameters */\n   341\t    if (NULL == in && inlen > 0) {\n   342\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   343\t    }\n   344\t    if (NULL == out) {\n   345\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   346\t    }\n   347\t    if (!outlen || outlen > BLAKE2B_OUTBYTES) {\n   348\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   349\t    }\n   350\t    if (NULL == key && keylen > 0) {\n   351\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   352\t    }\n   353\t    if (keylen > BLAKE2B_KEYBYTES) {\n   354\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   355\t    }\n   356\t    if (keylen > 0) {\n   357\t        if (blake2b_init_key(S, outlen, key, keylen) < 0) {\n   358\t            sodium_misuse(); /* LCOV_EXCL_LINE */\n   359\t        }\n   360\t    } else {\n   361\t        if (blake2b_init(S, outlen) < 0) {\n   362\t            sodium_misuse(); /* LCOV_EXCL_LINE */\n   363\t        }\n   364\t    }\n   365\t\n   366\t    blake2b_update(S, (const uint8_t *) in, inlen);\n   367\t    blake2b_final(S, out, outlen);\n   368\t    return 0;\n   369\t}\n   370\t\n   371\tint\n   372\tblake2b_salt_personal(uint8_t *out, const void *in, const void *key,\n   373\t                      const uint8_t outlen, const uint64_t inlen,\n   374\t                      uint8_t keylen, const void *salt, const void *personal)\n   375\t{\n   376\t    CRYPTO_ALIGN(64) blake2b_state S[1];\n   377\t\n   378\t    /* Verify parameters */\n   379\t    if (NULL == in && inlen > 0) {\n   380\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   381\t    }\n   382\t    if (NULL == out) {\n   383\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   384\t    }\n   385\t    if (!outlen || outlen > BLAKE2B_OUTBYTES) {\n   386\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   387\t    }\n   388\t    if (NULL == key && keylen > 0) {\n   389\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   390\t    }\n   391\t    if (keylen > BLAKE2B_KEYBYTES) {\n   392\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n   393\t    }\n   394\t    if (keylen > 0) {\n   395\t        if (blake2b_init_key_salt_personal(S, outlen, key, keylen, salt,\n   396\t                                           personal) < 0) {\n   397\t            sodium_misuse(); /* LCOV_EXCL_LINE */\n   398\t        }\n   399\t    } else {\n   400\t        if (blake2b_init_salt_personal(S, outlen, salt, personal) < 0) {\n   401\t            sodium_misuse(); /* LCOV_EXCL_LINE */\n   402\t        }\n   403\t    }\n   404\t\n   405\t    blake2b_update(S, (const uint8_t *) in, inlen);\n   406\t    blake2b_final(S, out, outlen);\n   407\t    return 0;\n   408\t}\n   409\t\n   410\tint\n   411\tblake2b_pick_best_implementation(void)\n   412\t{\n   413\t/* LCOV_EXCL_START */\n   414\t#if defined(HAVE_AVX2INTRIN_H) && defined(HAVE_TMMINTRIN_H) && \\\n   415\t    defined(HAVE_SMMINTRIN_H)\n   416\t    if (sodium_runtime_has_avx2()) {\n   417\t        blake2b_compress = blake2b_compress_avx2;\n   418\t        return 0;\n   419\t    }\n   420\t#endif\n   421\t#if defined(HAVE_EMMINTRIN_H) && defined(HAVE_TMMINTRIN_H) && \\\n   422\t    defined(HAVE_SMMINTRIN_H)\n   423\t    if (sodium_runtime_has_sse41()) {\n   424\t        blake2b_compress = blake2b_compress_sse41;\n   425\t        return 0;\n   426\t    }\n   427\t#endif\n   428\t#if defined(HAVE_EMMINTRIN_H) && defined(HAVE_TMMINTRIN_H)\n   429\t    if (sodium_runtime_has_ssse3()) {\n   430\t        blake2b_compress = blake2b_compress_ssse3;\n   431\t        return 0;\n   432\t    }\n   433\t#endif\n   434\t    blake2b_compress = blake2b_compress_ref;\n   435\t\n   436\t    return 0;\n   437\t    /* LCOV_EXCL_STOP */\n   438\t}","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01Qmz3yyeiwdcT9MBKBzhXKC","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"1051b897-6130-4b46-92a8-fa3a82d577f4","timestamp":"2026-08-23T08:09:17.541Z","subagent_type":"general-purpose","task_description":"Phase A tables: hash/mac/xof/kdf"}
