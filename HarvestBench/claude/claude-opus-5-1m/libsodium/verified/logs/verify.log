size_t saltlen, const size_t hashlen, char *encoded,\n173\t                     const size_t encodedlen)\n174\t{\n175\t    return argon2_hash(t_cost, m_cost, parallelism, pwd, pwdlen, salt, saltlen,\n176\t                       NULL, hashlen, encoded, encodedlen, Argon2_i);\n177\t}\n178\t\n179\tint\n180\targon2i_hash_raw(const uint32_t t_cost, const uint32_t m_cost,\n181\t                 const uint32_t parallelism, const void *pwd,\n182\t                 const size_t pwdlen, const void *salt, const size_t saltlen,\n183\t                 void *hash, const size_t hashlen)\n184\t{\n185\t    return argon2_hash(t_cost, m_cost, parallelism, pwd, pwdlen, salt, saltlen,\n186\t                       hash, hashlen, NULL, 0, Argon2_i);\n187\t}\n188\t\n189\tint\n190\targon2id_hash_encoded(const uint32_t t_cost, const uint32_t m_cost,\n191\t                      const uint32_t parallelism, const void *pwd,\n192\t                      const size_t pwdlen, const void *salt,\n193\t                      const size_t saltlen, const size_t hashlen, char *encoded,\n194\t                      const size_t encodedlen)\n195\t{\n196\t    return argon2_hash(t_cost, m_cost, parallelism, pwd, pwdlen, salt, saltlen,\n197\t                       NULL, hashlen, encoded, encodedlen, Argon2_id);\n198\t}\n199\t\n200\tint\n201\targon2id_hash_raw(const uint32_t t_cost, const uint32_t m_cost,\n202\t                  const uint32_t parallelism, const void *pwd,\n203\t                  const size_t pwdlen, const void *salt, const size_t saltlen,\n204\t                  void *hash, const size_t hashlen)\n205\t{\n206\t    return argon2_hash(t_cost, m_cost, parallelism, pwd, pwdlen, salt, saltlen,\n207\t                       hash, hashlen, NULL, 0, Argon2_id);\n208\t}\n209\t\n210\tint\n211\targon2_verify(const char *encoded, const void *pwd, const size_t pwdlen,\n212\t              argon2_type type)\n213\t{\n214\t    argon2_context ctx;\n215\t    uint8_t       *out;\n216\t    int            decode_result;\n217\t    int            ret;\n218\t    size_t         encoded_len;\n219\t\n220\t    memset(&ctx, 0, sizeof ctx);\n221\t\n222\t    ctx.pwd       = NULL;\n223\t    ctx.pwdlen    = 0;\n224\t    ctx.secret    = NULL;\n225\t    ctx.secretlen = 0;\n226\t\n227\t    /* max values, to be updated in argon2_decode_string */\n228\t    encoded_len = strlen(encoded);\n229\t    if (encoded_len > UINT32_MAX) {\n230\t        return ARGON2_DECODING_LENGTH_FAIL; /* LCOV_EXCL_LINE */\n231\t    }\n232\t    ctx.adlen   = (uint32_t) encoded_len;\n233\t    ctx.saltlen = (uint32_t) encoded_len;\n234\t    ctx.outlen  = (uint32_t) encoded_len;\n235\t\n236\t    ctx.ad   = (uint8_t *) malloc(ctx.adlen);\n237\t    ctx.salt = (uint8_t *) malloc(ctx.saltlen);\n238\t    ctx.out  = (uint8_t *) malloc(ctx.outlen);\n239\t    /* LCOV_EXCL_START */\n240\t    if (!ctx.out || !ctx.salt || !ctx.ad) {\n241\t        free(ctx.ad);\n242\t        free(ctx.salt);\n243\t        free(ctx.out);\n244\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n245\t    }\n246\t    /* LCOV_EXCL_STOP */\n247\t    out = (uint8_t *) malloc(ctx.outlen);\n248\t    if (!out) {\n249\t        /* LCOV_EXCL_START */\n250\t        free(ctx.ad);\n251\t        free(ctx.salt);\n252\t        free(ctx.out);\n253\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n254\t        /* LCOV_EXCL_STOP */\n255\t    }\n256\t\n257\t    decode_result = argon2_decode_string(&ctx, encoded, type);\n258\t    if (decode_result != ARGON2_OK) {\n259\t        free(ctx.ad);\n260\t        free(ctx.salt);\n261\t        free(ctx.out);\n262\t        free(out);\n263\t        return decode_result;\n264\t    }\n265\t\n266\t    ret = argon2_hash(ctx.t_cost, ctx.m_cost, ctx.threads, pwd, pwdlen,\n267\t                      ctx.salt, ctx.saltlen, out, ctx.outlen, NULL, 0, type);\n268\t\n269\t    free(ctx.ad);\n270\t    free(ctx.salt);\n271\t\n272\t    if (ret == ARGON2_OK && sodium_memcmp(out, ctx.out, ctx.outlen) != 0) {\n273\t        ret = ARGON2_VERIFY_MISMATCH;\n274\t    }\n275\t    free(out);\n276\t    free(ctx.out);\n277\t\n278\t    return ret;\n279\t}\n280\t\n281\tint\n282\targon2i_verify(const char *encoded, const void *pwd, const size_t pwdlen)\n283\t{\n284\t    return argon2_verify(encoded, pwd, pwdlen, Argon2_i);\n285\t}\n286\t\n287\tint\n288\targon2id_verify(const char *encoded, const void *pwd, const size_t pwdlen)\n289\t{\n290\t    return argon2_verify(encoded, pwd, pwdlen, Argon2_id);\n291\t}\n292\t"}]},"parent_tool_use_id":"toolu_bdrk_01FJHFWSbs1nb51qZda9ZhQ1","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"50ab9182-17db-46d9-b85b-c27515c65450","timestamp":"2026-08-23T08:08:05.660Z","subagent_type":"general-purpose","task_description":"Phase A tables: crypto_pwhash"}
