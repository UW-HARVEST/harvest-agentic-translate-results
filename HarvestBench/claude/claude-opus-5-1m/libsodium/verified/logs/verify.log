{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013cN1wqrs1cM8T52wABLZGj","type":"tool_result","content":"1\t//! Phase B — lowest-level entry points: `crypto_verify_*`, the `crypto_core_*`\n2\t//! block/HSalsa/HChaCha cores, every `crypto_stream_*` variant (keystream,\n3\t//! `_xor`, `_xor_ic`) and `crypto_shorthash_*`.\n4\t//!\n5\t//! Driven through `dlsym` on both `.so`s. Randomised inputs, fixed seed.\n6\t\n7\tmod common;\n8\tuse common::*;\n9\t\n10\ttype Verify = unsafe extern \"C\" fn(*const u8, *const u8) -> i32;\n11\ttype Core = unsafe extern \"C\" fn(*mut u8, *const u8, *const u8, *const u8) -> i32;\n12\ttype Stream = unsafe extern \"C\" fn(*mut u8, u64, *const u8, *const u8) -> i32;\n13\ttype StreamXor = unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, *const u8) -> i32;\n14\ttype StreamXorIc64 =\n15\t    unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, u64, *const u8) -> i32;\n16\ttype StreamXorIc32 =\n17\t    unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, u32, *const u8) -> i32;\n18\ttype Shorthash = unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8) -> i32;\n19\ttype Keygen = unsafe extern \"C\" fn(*mut u8);\n20\t\n21\t/// Message lengths that straddle every block boundary used by the ref\n22\t/// implementations (64-byte ChaCha/Salsa blocks, 16-byte AEGIS/Poly steps).\n23\tconst LENS: &[usize] = &[\n24\t    0, 1, 2, 15, 16, 17, 31, 32, 33, 63, 64, 65, 66, 95, 96, 127, 128, 129, 191, 192, 193, 255,\n25\t    256, 257, 383, 384, 511, 512, 513, 1000, 1023, 1024, 1025, 4096,\n26\t];\n27\t\n28\t// ---------------------------------------------------------------------------\n29\t// CONFIGS rows: crypto_verify_16 / _32 / _64\n30\t// ---------------------------------------------------------------------------\n31\t\n32\t#[test]\n33\tfn verify_16_32_64() {\n34\t    setup();\n35\t    let mut rng = Rng::new(0x1111);\n36\t    for (name, n) in [\n37\t        (\"crypto_verify_16\", 16usize),\n38\t        (\"crypto_verify_32\", 32),\n39\t        (\"crypto_verify_64\", 64),\n40\t    ] {\n41\t        let (c, r) = pair::<Verify>(name);\n42\t        // equal / differ at each single byte position / random pairs\n43\t        let mut cases: Vec<(Vec<u8>, Vec<u8>)> = Vec::new();\n44\t        for _ in 0..8 {\n45\t            let x = rng.bytes(n);\n46\t            cases.push((x.clone(), x.clone())); // equal\n47\t            for i in 0..n {\n48\t                let mut y = x.clone();\n49\t                y[i] ^= 1 << (rng.below(8));\n50\t                cases.push((x.clone(), y)); // differ at byte i\n51\t            }\n52\t        }\n53\t        for _ in 0..64 {\n54\t            cases.push((rng.bytes(n), rng.bytes(n))); // fully random\n55\t        }\n56\t        cases.push((vec![0u8; n], vec![0u8; n]));\n57\t        cases.push((vec![0xffu8; n], vec![0xffu8; n]));\n58\t        cases.push((vec![0u8; n], vec![0xffu8; n]));\n59\t        for (x, y) in cases {\n60\t            let (a, b) = unsafe { (c(x.as_ptr(), y.as_ptr()), r(x.as_ptr(), y.as_ptr())) };\n61\t            eq_i32(&format!(\"{name}({}, {})\", hex(&x), hex(&y)), a, b);\n62\t        }\n63\t    }\n64\t}\n65\t\n66\t// ---------------------------------------------------------------------------\n67\t// CONFIGS rows: crypto_core_salsa20 / _salsa2012 / _salsa208 / _hsalsa20 /\n68\t//               _hchacha20 — with `c` = NULL and `c` = explicit constant\n69\t// ---------------------------------------------------------------------------\n70\t\n71\t#[test]\n72\tfn core_salsa_hsalsa_hchacha() {\n73\t    setup();\n74\t    let mut rng = Rng::new(0x2222);\n75\t    // (name, outlen, inlen, klen, clen)\n76\t    let specs: &[(&str, usize, usize, usize, usize)] = &[\n77\t        (\"crypto_core_salsa20\", 64, 16, 32, 16),\n78\t        (\"crypto_core_salsa2012\", 64, 16, 32, 16),\n79\t        (\"crypto_core_salsa208\", 64, 16, 32, 16),\n80\t        (\"crypto_core_hsalsa20\", 32, 16, 32, 16),\n81\t        (\"crypto_core_hchacha20\", 32, 16, 32, 16),\n82\t    ];\n83\t    for &(name, outlen, inlen, klen, clen) in specs {\n84\t        // sanity: the accessor-reported sizes must agree with the table\n85\t        let ob = sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{name}_outputbytes\"));\n86\t        assert_eq!(unsafe { ob() }, outlen, \"{name}_outputbytes\");\n87\t        let (c, r) = pair::<Core>(name);\n88\t        for iter in 0..200 {\n89\t            let inp = match iter % 4 {\n90\t                0 => rng.bytes(inlen),\n91\t                1 => vec![0u8; inlen],\n92\t                2 => vec![0xffu8; inlen],\n93\t                _ => rng.bytes(inlen),\n94\t            };\n95\t            let k = match iter % 3 {\n96\t                0 => rng.bytes(klen),\n97\t                1 => vec![0u8; klen],\n98\t                _ => vec![0xffu8; klen],\n99\t            };\n100\t            // `c` = NULL takes the built-in sigma path; non-NULL loads from `c`\n101\t            let cst: Option<Vec<u8>> = match iter % 3 {\n102\t                0 => None,\n103\t                1 => Some(b\"expand 32-byte k\".to_vec()),\n104\t                _ => Some(rng.bytes(clen)),\n105\t            };\n106\t            let cp = cst.as_ref().map_or(std::ptr::null(), |v| v.as_ptr());\n107\t            let mut o1 = canary(outlen);\n108\t            let mut o2 = canary(outlen);\n109\t            let (a, b) = unsafe {\n110\t                (\n111\t                    c(o1.as_mut_ptr(), inp.as_ptr(), k.as_ptr(), cp),\n112\t                    r(o2.as_mut_ptr(), inp.as_ptr(), k.as_ptr(), cp),\n113\t                )\n114\t            };\n115\t            eq_i32(&format!(\"{name} rc\"), a, b);\n116\t            eq_bytes(\n117\t                &format!(\n118\t                    \"{name}(in={}, k={}, c={})\",\n119\t                    hex(&inp),\n120\t                    hex(&k),\n121\t                    cst.as_ref().map_or(\"NULL\".into(), |v| hex(v))\n122\t                ),\n123\t                &o1,\n124\t                &o2,\n125\t            );\n126\t        }\n127\t    }\n128\t}\n129\t\n130\t// ---------------------------------------------------------------------------\n131\t// CONFIGS rows: every crypto_stream_* keystream / _xor entry point\n132\t// ---------------------------------------------------------------------------\n133\t\n134\t/// (module prefix, key bytes, nonce bytes)\n135\tconst STREAMS: &[(&str, usize, usize)] = &[\n136\t    (\"crypto_stream\", 32, 24),\n137\t    (\"crypto_stream_chacha20\", 32, 8),\n138\t    (\"crypto_stream_chacha20_ietf\", 32, 12),\n139\t    (\"crypto_stream_salsa20\", 32, 8),\n140\t    (\"crypto_stream_salsa2012\", 32, 8),\n141\t    (\"crypto_stream_salsa208\", 32, 8),\n142\t    (\"crypto_stream_xchacha20\", 32, 24),\n143\t    (\"crypto_stream_xsalsa20\", 32, 24),\n144\t];\n145\t\n146\tfn stream_sizes(prefix: &str) -> (usize, usize) {\n147\t    let kb = sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{prefix}_keybytes\"));\n148\t    let nb = sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{prefix}_noncebytes\"));\n149\t    unsafe { (kb(), nb()) }\n150\t}\n151\t\n152\t#[test]\n153\tfn stream_keystream_and_xor() {\n154\t    setup();\n155\t    let mut rng = Rng::new(0x3333);\n156\t    for &(prefix, kb_exp, nb_exp) in STREAMS {\n157\t        let (kb, nb) = stream_sizes(prefix);\n158\t        assert_eq!((kb, nb), (kb_exp, nb_exp), \"{prefix} key/nonce sizes\");\n159\t\n160\t        let (cks, rks) = pair::<Stream>(prefix);\n161\t        let (cx, rx) = pair::<StreamXor>(&format!(\"{prefix}_xor\"));\n162\t\n163\t        for &len in LENS {\n164\t            for kind in 0..3 {\n165\t                let k = match kind {\n166\t                    0 => rng.bytes(kb),\n167\t                    1 => vec![0u8; kb],\n168\t                    _ => vec![0xffu8; kb],\n169\t                };\n170\t                let n = match kind {\n171\t                    0 => rng.bytes(nb),\n172\t                    1 => vec![0u8; nb],\n173\t                    _ => vec![0xffu8; nb],\n174\t                };\n175\t                // keystream\n176\t                let mut a = canary(len);\n177\t                let mut b = canary(len);\n178\t                let (ra, rb) = unsafe {\n179\t                    (\n180\t                        cks(a.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n181\t                        rks(b.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n182\t                    )\n183\t                };\n184\t                eq_i32(&format!(\"{prefix}({len}) rc\"), ra, rb);\n185\t                eq_bytes(&format!(\"{prefix}(len={len}, kind={kind})\"), &a, &b);\n186\t\n187\t                // xor\n188\t                let m = rng.bytes(len);\n189\t                let mut a = canary(len);\n190\t                let mut b = canary(len);\n191\t                let (ra, rb) = unsafe {\n192\t                    (\n193\t                        cx(\n194\t                            a.as_mut_ptr(),\n195\t                            m.as_ptr(),\n196\t                            len as u64,\n197\t                            n.as_ptr(),\n198\t                            k.as_ptr(),\n199\t                        ),\n200\t                        rx(\n201\t                            b.as_mut_ptr(),\n202\t                            m.as_ptr(),\n203\t                            len as u64,\n204\t                            n.as_ptr(),\n205\t                            k.as_ptr(),\n206\t                        ),\n207\t                    )\n208\t                };\n209\t                eq_i32(&format!(\"{prefix}_xor({len}) rc\"), ra, rb);\n210\t                eq_bytes(&format!(\"{prefix}_xor(len={len}, kind={kind})\"), &a, &b);\n211\t            }\n212\t        }\n213\t    }\n214\t}\n215\t\n216\t/// In-place `_xor` (`c == m`), which the C code supports.\n217\t#[test]\n218\tfn stream_xor_in_place() {\n219\t    setup();\n220\t    let mut rng = Rng::new(0x3334);\n221\t    for &(prefix, _, _) in STREAMS {\n222\t        let (kb, nb) = stream_sizes(prefix);\n223\t        let (cx, rx) = pair::<StreamXor>(&format!(\"{prefix}_xor\"));\n224\t        for &len in &[0usize, 1, 63, 64, 65, 128, 200, 1000] {\n225\t            let k = rng.bytes(kb);\n226\t            let n = rng.bytes(nb);\n227\t            let m = rng.bytes(len);\n228\t            let mut a = m.clone();\n229\t            let mut b = m.clone();\n230\t            unsafe {\n231\t                let ra = cx(\n232\t                    a.as_mut_ptr(),\n233\t                    a.as_ptr(),\n234\t                    len as u64,\n235\t                    n.as_ptr(),\n236\t                    k.as_ptr(),\n237\t                );\n238\t                let rb = rx(\n239\t                    b.as_mut_ptr(),\n240\t                    b.as_ptr(),\n241\t                    len as u64,\n242\t                    n.as_ptr(),\n243\t                    k.as_ptr(),\n244\t                );\n245\t                eq_i32(&format!(\"{prefix}_xor in-place rc\"), ra, rb);\n246\t            }\n247\t            eq_bytes(&format!(\"{prefix}_xor in-place len={len}\"), &a, &b);\n248\t        }\n249\t    }\n250\t}\n251\t\n252\t/// `_xor_ic` with a 64-bit initial counter: chacha20 (original nonce),\n253\t/// salsa20, xchacha20, xsalsa20.\n254\t#[test]\n255\tfn stream_xor_ic_64bit_counter() {\n256\t    setup();\n257\t    let mut rng = Rng::new(0x4444);\n258\t    let names: &[&str] = &[\n259\t        \"crypto_stream_chacha20_xor_ic\",\n260\t        \"crypto_stream_salsa20_xor_ic\",\n261\t        \"crypto_stream_xchacha20_xor_ic\",\n262\t        \"crypto_stream_xsalsa20_xor_ic\",\n263\t    ];\n264\t    let ics: &[u64] = &[\n265\t        0,\n266\t        1,\n267\t        2,\n268\t        7,\n269\t        0xffff_ffff,\n270\t        0x1_0000_0000,\n271\t        0x1_0000_0001,\n272\t        u64::MAX - 20,\n273\t    ];\n274\t    for name in names {\n275\t        let prefix = name.trim_end_matches(\"_xor_ic\");\n276\t        let (kb, nb) = stream_sizes(prefix);\n277\t        let (c, r) = pair::<StreamXorIc64>(name);\n278\t        for &len in &[0usize, 1, 63, 64, 65, 127, 128, 129, 256, 300] {\n279\t            for &ic in ics {\n280\t                let k = rng.bytes(kb);\n281\t                let n = rng.bytes(nb);\n282\t                let m = rng.bytes(len);\n283\t                let mut a = canary(len);\n284\t                let mut b = canary(len);\n285\t                let (ra, rb) = unsafe {\n286\t                    (\n287\t                        c(\n288\t                            a.as_mut_ptr(),\n289\t                            m.as_ptr(),\n290\t                            len as u64,\n291\t                            n.as_ptr(),\n292\t                            ic,\n293\t                            k.as_ptr(),\n294\t                        ),\n295\t                        r(\n296\t                            b.as_mut_ptr(),\n297\t                            m.as_ptr(),\n298\t                            len as u64,\n299\t                            n.as_ptr(),\n300\t                            ic,\n301\t                            k.as_ptr(),\n302\t                        ),\n303\t                    )\n304\t                };\n305\t                eq_i32(&format!(\"{name}(len={len}, ic={ic}) rc\"), ra, rb);\n306\t                eq_bytes(&format!(\"{name}(len={len}, ic={ic:#x})\"), &a, &b);\n307\t            }\n308\t        }\n309\t    }\n310\t}\n311\t\n312\t/// `crypto_stream_chacha20_ietf_xor_ic` — 32-bit counter. `ic` values near the\n313\t/// 2^32 wrap must be exercised, but the *overflow* case is an error path\n314\t/// (`sodium_misuse`) and lives in the Phase C tests.\n315\t#[test]\n316\tfn stream_chacha20_ietf_xor_ic_32bit_counter() {\n317\t    setup();\n318\t    let mut rng = Rng::new(0x5555);\n319\t    let (c, r) = pair::<StreamXorIc32>(\"crypto_stream_chacha20_ietf_xor_ic\");\n320\t    for &len in &[0usize, 1, 63, 64, 65, 127, 128, 129, 256, 300] {\n321\t        for &ic in &[0u32, 1, 2, 7, 1000, 0xffff_fff0, 0xffff_fffe] {\n322\t            // stay within the 32-bit counter range: ic + ceil(len/64) <= 2^32\n323\t            let blocks = ((len + 63) / 64) as u64;\n324\t            if ic as u64 + blocks > 0x1_0000_0000 {\n325\t                continue;\n326\t            }\n327\t            let k = rng.bytes(32);\n328\t            let n = rng.bytes(12);\n329\t            let m = rng.bytes(len);\n330\t            let mut a = canary(len);\n331\t            let mut b = canary(len);\n332\t            let (ra, rb) = unsafe {\n333\t                (\n334\t                    c(\n335\t                        a.as_mut_ptr(),\n336\t                        m.as_ptr(),\n337\t                        len as u64,\n338\t                        n.as_ptr(),\n339\t                        ic,\n340\t                        k.as_ptr(),\n341\t                    ),\n342\t                    r(\n343\t                        b.as_mut_ptr(),\n344\t                        m.as_ptr(),\n345\t                        len as u64,\n346\t                        n.as_ptr(),\n347\t                        ic,\n348\t                        k.as_ptr(),\n349\t                    ),\n350\t                )\n351\t            };\n352\t            eq_i32(&format!(\"ietf_xor_ic(len={len}, ic={ic}) rc\"), ra, rb);\n353\t            eq_bytes(\n354\t                &format!(\"crypto_stream_chacha20_ietf_xor_ic(len={len}, ic={ic:#x})\"),\n355\t                &a,\n356\t                &b,\n357\t            );\n358\t        }\n359\t    }\n360\t}\n361\t\n362\t/// The internal `crypto_stream_chacha20_ietf_ext` / `_ext_xor_ic` exports\n363\t/// (used by `crypto_secretstream`): 16-byte nonce, 32-bit counter.\n364\t#[test]\n365\tfn stream_chacha20_ietf_ext() {\n366\t    setup();\n367\t    let mut rng = Rng::new(0x5556);\n368\t    let (c, r) = pair::<Stream>(\"crypto_stream_chacha20_ietf_ext\");\n369\t    for &len in &[0usize, 1, 63, 64, 65, 128, 200, 1000] {\n370\t        let k = rng.bytes(32);\n371\t        let n = rng.bytes(16);\n372\t        let mut a = canary(len);\n373\t        let mut b = canary(len);\n374\t        let (ra, rb) = unsafe {\n375\t            (\n376\t                c(a.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n377\t                r(b.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n378\t            )\n379\t        };\n380\t        eq_i32(\"ietf_ext rc\", ra, rb);\n381\t        eq_bytes(&format!(\"crypto_stream_chacha20_ietf_ext(len={len})\"), &a, &b);\n382\t    }\n383\t\n384\t    let (c, r) = pair::<StreamXorIc32>(\"crypto_stream_chacha20_ietf_ext_xor_ic\");\n385\t    for &len in &[0usize, 1, 63, 64, 65, 128, 200, 1000] {\n386\t        for &ic in &[0u32, 1, 5, 1000] {\n387\t            let k = rng.bytes(32);\n388\t            let n = rng.bytes(16);\n389\t            let m = rng.bytes(len);\n390\t            let mut a = canary(len);\n391\t            let mut b = canary(len);\n392\t            let (ra, rb) = unsafe {\n393\t                (\n394\t                    c(\n395\t                        a.as_mut_ptr(),\n396\t                        m.as_ptr(),\n397\t                        len as u64,\n398\t                        n.as_ptr(),\n399\t                        ic,\n400\t                        k.as_ptr(),\n401\t                    ),\n402\t                    r(\n403\t                        b.as_mut_ptr(),\n404\t                        m.as_ptr(),\n405\t                        len as u64,\n406\t                        n.as_ptr(),\n407\t                        ic,\n408\t                        k.as_ptr(),\n409\t                    ),\n410\t                )\n411\t            };\n412\t            eq_i32(\"ietf_ext_xor_ic rc\", ra, rb);\n413\t            eq_bytes(\n414\t                &format!(\"crypto_stream_chacha20_ietf_ext_xor_ic(len={len}, ic={ic})\"),\n415\t                &a,\n416\t                &b,\n417\t            );\n418\t        }\n419\t    }\n420\t}\n421\t\n422\t/// Every `crypto_stream_*_keygen` — deterministic under the installed RNG.\n423\t#[test]\n424\tfn stream_keygens() {\n425\t    setup();\n426\t    let mut names: Vec<String> = STREAMS.iter().map(|s| format!(\"{}_keygen\", s.0)).collect();\n427\t    names.push(\"crypto_stream_chacha20_ietf_keygen\".into());\n428\t    names.sort();\n429\t    names.dedup();\n430\t    for name in &names {\n431\t        let prefix = name.trim_end_matches(\"_keygen\");\n432\t        let (kb, _) = stream_sizes(prefix);\n433\t        let (c, r) = pair::<Keygen>(name);\n434\t        for seed in 0..8u64 {\n435\t            let mut a = canary(kb);\n436\t            let mut b = canary(kb);\n437\t            reset_rngs(0xA000 + seed);\n438\t            unsafe { c(a.as_mut_ptr()) };\n439\t            reset_rngs(0xA000 + seed);\n440\t            unsafe { r(b.as_mut_ptr()) };\n441\t            eq_bytes(&format!(\"{name} seed={seed}\"), &a, &b);\n442\t            assert_ne!(a, canary(kb), \"{name} wrote nothing\");\n443\t        }\n444\t    }\n445\t}\n446\t\n447\t// ---------------------------------------------------------------------------\n448\t// CONFIGS rows: crypto_shorthash_siphash24 / _siphashx24 / generic\n449\t// ---------------------------------------------------------------------------\n450\t\n451\t#[test]\n452\tfn shorthash_siphash24_and_x24() {\n453\t    setup();\n454\t    let mut rng = Rng::new(0x6666);\n455\t    for (name, outlen, keylen) in [\n456\t        (\"crypto_shorthash\", 8usize, 16usize),\n457\t        (\"crypto_shorthash_siphash24\", 8, 16),\n458\t        (\"crypto_shorthash_siphashx24\", 16, 16),\n459\t    ] {\n460\t        let (c, r) = pair::<Shorthash>(name);\n461\t        // 0..=32 covers all 8 tail-length cases of the SipHash finaliser\n462\t        let lens: Vec<usize> = (0usize..=40)\n463\t            .chain([63, 64, 65, 100, 127, 128, 1000])\n464\t            .collect();\n465\t        for &len in &lens {\n466\t            for kind in 0..3 {\n467\t                let k = match kind {\n468\t                    0 => rng.bytes(keylen),\n469\t                    1 => vec![0u8; keylen],\n470\t                    _ => vec![0xffu8; keylen],\n471\t                };\n472\t                let inp = match kind {\n473\t                    0 => rng.bytes(len),\n474\t                    1 => vec![0u8; len],\n475\t                    _ => vec![0xffu8; len],\n476\t                };\n477\t                let mut a = canary(outlen);\n478\t                let mut b = canary(outlen);\n479\t                let (ra, rb) = unsafe {\n480\t                    (\n481\t                        c(a.as_mut_ptr(), inp.as_ptr(), len as u64, k.as_ptr()),\n482\t                        r(b.as_mut_ptr(), inp.as_ptr(), len as u64, k.as_ptr()),\n483\t                    )\n484\t                };\n485\t                eq_i32(&format!(\"{name} rc\"), ra, rb);\n486\t                eq_bytes(&format!(\"{name}(len={len}, kind={kind})\"), &a, &b);\n487\t            }\n488\t        }\n489\t    }\n490\t}\n491\t\n492\t#[test]\n493\tfn shorthash_keygen() {\n494\t    setup();\n495\t    let (c, r) = pair::<Keygen>(\"crypto_shorthash_keygen\");\n496\t    for seed in 0..8u64 {\n497\t        let mut a = canary(16);\n498\t        let mut b = canary(16);\n499\t        reset_rngs(0xB000 + seed);\n500\t        unsafe { c(a.as_mut_ptr()) };\n501\t        reset_rngs(0xB000 + seed);\n502\t        unsafe { r(b.as_mut_ptr()) };\n503\t        eq_bytes(\"crypto_shorthash_keygen\", &a, &b);\n504\t    }\n505\t}\n506\t"}]},"parent_tool_use_id":"toolu_bdrk_01Aw2j196PG6UFGUL4fdGJ7V","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"9f52f148-6532-48b1-a008-687d49ca4d89","timestamp":"2026-08-23T08:27:21.562Z","subagent_type":"general-purpose","task_description":"Phase B+C tests: sodium+randombytes"}
