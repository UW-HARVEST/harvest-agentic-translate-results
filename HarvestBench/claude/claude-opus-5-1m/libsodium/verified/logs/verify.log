{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MdmmGaMTGPtWoiiXhVdoDQ","type":"tool_result","content":"592\t/// The 9 exported implementation v-tables are `D` (data) symbols in both\n593\t/// builds. Verify each is a non-NULL object whose `implementation_name`-style\n594\t/// first field is callable where applicable, and that the two `randombytes_*`\n595\t/// v-tables report the same implementation name.\n596\t#[test]\n597\tfn exported_implementation_vtables() {\n598\t    setup();\n599\t    const VTABLES: &[&str] = &[\n600\t        \"aegis128l_soft_implementation\",\n601\t        \"aegis256_soft_implementation\",\n602\t        \"crypto_onetimeauth_poly1305_donna_implementation\",\n603\t        \"crypto_scalarmult_curve25519_ref10_implementation\",\n604\t        \"crypto_stream_chacha20_ref_implementation\",\n605\t        \"crypto_stream_salsa20_ref_implementation\",\n606\t        \"ipcrypt_soft_implementation\",\n607\t        \"randombytes_internal_implementation\",\n608\t        \"randombytes_sysrandom_implementation\",\n609\t    ];\n610\t    for name in VTABLES {\n611\t        let c: *const *const std::ffi::c_void = sym(c_lib(), name);\n612\t        let r: *const *const std::ffi::c_void = sym(r_lib(), name);\n613\t        assert!(!c.is_null() && !r.is_null(), \"{name} v-table is NULL\");\n614\t        // every slot that the C fills must also be filled by Rust (and vice\n615\t        // versa) — compare the NULL/non-NULL pattern of the first 8 slots.\n616\t        for i in 0..8usize {\n617\t            let (a, b) = unsafe { (*c.add(i), *r.add(i)) };\n618\t            assert_eq!(\n619\t                a.is_null(),\n620\t                b.is_null(),\n621\t                \"{name}: slot {i} nullness differs (C={a:?}, Rust={b:?})\"\n622\t            );\n623\t        }\n624\t    }\n625\t\n626\t    // the two randombytes v-tables expose an implementation_name() as slot 0\n627\t    for name in [\n628\t        \"randombytes_internal_implementation\",\n629\t        \"randombytes_sysrandom_implementation\",\n630\t    ] {\n631\t        let c: *const Option<unsafe extern \"C\" fn() -> *const std::ffi::c_char> = sym(c_lib(), name);\n632\t        let r: *const Option<unsafe extern \"C\" fn() -> *const std::ffi::c_char> = sym(r_lib(), name);\n633\t        unsafe {\n634\t            let (cf, rf) = (*c, *r);\n635\t            let (cf, rf) = (cf.expect(\"C name fn\"), rf.expect(\"Rust name fn\"));\n636\t            let (a, b) = (\n637\t                std::ffi::CStr::from_ptr(cf()).to_owned(),\n638\t                std::ffi::CStr::from_ptr(rf()).to_owned(),\n639\t            );\n640\t            assert_eq!(a, b, \"{name}.implementation_name()\");\n641\t        }\n642\t    }\n643\t}\n644\t\n645\t// ---------------------------------------------------------------------------\n646\t// misc internal exports\n647\t// ---------------------------------------------------------------------------\n648\t\n649\t#[test]\n650\tfn misc_internal_exports() {\n651\t    setup();"}]},"parent_tool_use_id":null,"session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"2a7ddb8d-efb5-4bfe-8155-b181f8ffcd2d","timestamp":"2026-08-23T08:35:56.296Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-rAO86K/translated_rust/tests/t06_internal_exports.rs","content":"/// The 9 exported implementation v-tables are `D` (data) symbols in both\n/// builds. Verify each is a non-NULL object whose `implementation_name`-style\n/// first field is callable where applicable, and that the two `randombytes_*`\n/// v-tables report the same implementation name.\n#[test]\nfn exported_implementation_vtables() {\n    setup();\n    const VTABLES: &[&str] = &[\n        \"aegis128l_soft_implementation\",\n        \"aegis256_soft_implementation\",\n        \"crypto_onetimeauth_poly1305_donna_implementation\",\n        \"crypto_scalarmult_curve25519_ref10_implementation\",\n        \"crypto_stream_chacha20_ref_implementation\",\n        \"crypto_stream_salsa20_ref_implementation\",\n        \"ipcrypt_soft_implementation\",\n        \"randombytes_internal_implementation\",\n        \"randombytes_sysrandom_implementation\",\n    ];\n    for name in VTABLES {\n        let c: *const *const std::ffi::c_void = sym(c_lib(), name);\n        let r: *const *const std::ffi::c_void = sym(r_lib(), name);\n        assert!(!c.is_null() && !r.is_null(), \"{name} v-table is NULL\");\n        // every slot that the C fills must also be filled by Rust (and vice\n        // versa) — compare the NULL/non-NULL pattern of the first 8 slots.\n        for i in 0..8usize {\n            let (a, b) = unsafe { (*c.add(i), *r.add(i)) };\n            assert_eq!(\n                a.is_null(),\n                b.is_null(),\n                \"{name}: slot {i} nullness differs (C={a:?}, Rust={b:?})\"\n            );\n        }\n    }\n\n    // the two randombytes v-tables expose an implementation_name() as slot 0\n    for name in [\n        \"randombytes_internal_implementation\",\n        \"randombytes_sysrandom_implementation\",\n    ] {\n        let c: *const Option<unsafe extern \"C\" fn() -> *const std::ffi::c_char> = sym(c_lib(), name);\n        let r: *const Option<unsafe extern \"C\" fn() -> *const std::ffi::c_char> = sym(r_lib(), name);\n        unsafe {\n            let (cf, rf) = (*c, *r);\n            let (cf, rf) = (cf.expect(\"C name fn\"), rf.expect(\"Rust name fn\"));\n            let (a, b) = (\n                std::ffi::CStr::from_ptr(cf()).to_owned(),\n                std::ffi::CStr::from_ptr(rf()).to_owned(),\n            );\n            assert_eq!(a, b, \"{name}.implementation_name()\");\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// misc internal exports\n// ---------------------------------------------------------------------------\n\n#[test]\nfn misc_internal_exports() {\n    setup();","numLines":60,"startLine":592,"totalLines"