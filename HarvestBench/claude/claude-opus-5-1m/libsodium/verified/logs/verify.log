{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01528czTKiJagNgDh9xhmrWZ","type":"tool_result","content":"1\t//! Phase B — AEAD constructions (`CONFIGS.md` rows for the `crypto_aead_*`\n2\t//! group): aegis128l, aegis256, chacha20poly1305 (original 8-byte nonce),\n3\t//! chacha20poly1305_ietf, xchacha20poly1305_ietf, plus the aes256gcm\n4\t//! entry points (unavailable in this build — every operation must reject\n5\t//! identically in C and Rust).\n6\t//!\n7\t//! Both the *combined* and the *detached* entry points are exercised, with\n8\t//! message/AD lengths that straddle each primitive's block, absorb and\n9\t//! 128 KiB-chunk boundaries.\n10\t\n11\tmod common;\n12\tuse common::*;\n13\t\n14\ttype Enc = unsafe extern \"C\" fn(\n15\t    *mut u8,   // c\n16\t    *mut u64,  // clen_p\n17\t    *const u8, // m\n18\t    u64,       // mlen\n19\t    *const u8, // ad\n20\t    u64,       // adlen\n21\t    *const u8, // nsec\n22\t    *const u8, // npub\n23\t    *const u8, // k\n24\t) -> i32;\n25\t\n26\ttype Dec = unsafe extern \"C\" fn(\n27\t    *mut u8,   // m\n28\t    *mut u64,  // mlen_p\n29\t    *mut u8,   // nsec\n30\t    *const u8, // c\n31\t    u64,       // clen\n32\t    *const u8, // ad\n33\t    u64,       // adlen\n34\t    *const u8, // npub\n35\t    *const u8, // k\n36\t) -> i32;\n37\t\n38\ttype EncDet = unsafe extern \"C\" fn(\n39\t    *mut u8,   // c\n40\t    *mut u8,   // mac\n41\t    *mut u64,  // maclen_p\n42\t    *const u8, // m\n43\t    u64,       // mlen\n44\t    *const u8, // ad\n45\t    u64,       // adlen\n46\t    *const u8, // nsec\n47\t    *const u8, // npub\n48\t    *const u8, // k\n49\t) -> i32;\n50\t\n51\ttype DecDet = unsafe extern \"C\" fn(\n52\t    *mut u8,   // m\n53\t    *mut u8,   // nsec\n54\t    *const u8, // c\n55\t    u64,       // clen\n56\t    *const u8, // mac\n57\t    *const u8, // ad\n58\t    u64,       // adlen\n59\t    *const u8, // npub\n60\t    *const u8, // k\n61\t) -> i32;\n62\t\n63\ttype Keygen = unsafe extern \"C\" fn(*mut u8);\n64\t\n65\t/// The five *available* AEAD primitives.\n66\tconst AEADS: &[&str] = &[\n67\t    \"crypto_aead_aegis128l\",\n68\t    \"crypto_aead_aegis256\",\n69\t    \"crypto_aead_chacha20poly1305\",\n70\t    \"crypto_aead_chacha20poly1305_ietf\",\n71\t    \"crypto_aead_xchacha20poly1305_ietf\",\n72\t];\n73\t\n74\tstruct Sizes {\n75\t    kb: usize,\n76\t    nb: usize,\n77\t    ab: usize,\n78\t    nsb: usize,\n79\t    max: u64,\n80\t}\n81\t\n82\tfn sizes(p: &str) -> Sizes {\n83\t    let g = |s: &str| -> usize {\n84\t        unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{p}_{s}\"))() }\n85\t    };\n86\t    let gm = || -> u64 {\n87\t        unsafe { sym::<unsafe extern \"C\" fn() -> u64>(c_lib(), &format!(\"{p}_messagebytes_max\"))() }\n88\t    };\n89\t    Sizes {\n90\t        kb: g(\"keybytes\"),\n91\t        nb: g(\"npubbytes\"),\n92\t        ab: g(\"abytes\"),\n93\t        nsb: g(\"nsecbytes\"),\n94\t        max: gm(),\n95\t    }\n96\t}\n97\t\n98\t/// Message lengths: per-primitive block boundaries (16/32/64), poly1305 pad\n99\t/// boundaries, and the 128 KiB `STREAM_POLY1305_CHUNK` restart boundary.\n100\tconst MLENS: &[usize] = &[\n101\t    0, 1, 2, 15, 16, 17, 31, 32, 33, 47, 48, 63, 64, 65, 95, 96, 127, 128, 129, 255, 256, 257, 511,\n102\t    512, 1000, 4097,\n103\t];\n104\t/// AD lengths: absorb2 (2×RATE), absorb (RATE) and padded-tail shapes.\n105\tconst ADLENS: &[usize] = &[0, 1, 8, 15, 16, 17, 31, 32, 33, 63, 64, 65, 100, 128, 200];\n106\t/// Lengths around the 131072-byte chunk restart (slow — used sparingly).\n107\tconst CHUNK_LENS: &[usize] = &[131071, 131072, 131073, 131136, 262144];\n108\t\n109\t// ---------------------------------------------------------------------------\n110\t// combined encrypt / decrypt round trip over the message-length axis\n111\t// ---------------------------------------------------------------------------\n112\t\n113\t#[test]\n114\tfn aead_combined_message_lengths() {\n115\t    setup();\n116\t    let mut rng = Rng::new(0x8000);\n117\t    for &p in AEADS {\n118\t        let s = sizes(p);\n119\t        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n120\t        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n121\t        for &mlen in MLENS {\n122\t            for &adlen in &[0usize, 16, 100] {\n123\t                let k = rng.bytes(s.kb);\n124\t                let npub = rng.bytes(s.nb);\n125\t                let m = rng.bytes(mlen);\n126\t                let ad = rng.bytes(adlen);\n127\t                let clen_max = mlen + s.ab;\n128\t\n129\t                let mut c1 = canary(clen_max);\n130\t                let mut c2 = canary(clen_max);\n131\t                let mut l1 = 0u64;\n132\t                let mut l2 = 0u64;\n133\t                let (ra, rb) = unsafe {\n134\t                    (\n135\t                        ce(\n136\t                            c1.as_mut_ptr(),\n137\t                            &mut l1,\n138\t                            m.as_ptr(),\n139\t                            mlen as u64,\n140\t                            ad.as_ptr(),\n141\t                            adlen as u64,\n142\t                            std::ptr::null(),\n143\t                            npub.as_ptr(),\n144\t                            k.as_ptr(),\n145\t                        ),\n146\t                        re(\n147\t                            c2.as_mut_ptr(),\n148\t                            &mut l2,\n149\t                            m.as_ptr(),\n150\t                            mlen as u64,\n151\t                            ad.as_ptr(),\n152\t                            adlen as u64,\n153\t                            std::ptr::null(),\n154\t                            npub.as_ptr(),\n155\t                            k.as_ptr(),\n156\t                        ),\n157\t                    )\n158\t                };\n159\t                eq_i32(&format!(\"{p}_encrypt rc(m={mlen},ad={adlen})\"), ra, rb);\n160\t                eq_usize(\n161\t                    &format!(\"{p}_encrypt *clen_p(m={mlen},ad={adlen})\"),\n162\t                    l1 as usize,\n163\t                    l2 as usize,\n164\t                );\n165\t                eq_bytes(&format!(\"{p}_encrypt(m={mlen},ad={adlen})\"), &c1, &c2);\n166\t                assert_eq!(l1 as usize, clen_max);\n167\t\n168\t                // decrypt the C-produced ciphertext with both\n169\t                let mut m1 = canary(mlen.max(1));\n170\t                let mut m2 = canary(mlen.max(1));\n171\t                let mut o1 = u64::MAX;\n172\t                let mut o2 = u64::MAX;\n173\t                let (ra, rb) = unsafe {\n174\t                    (\n175\t                        cd(\n176\t                            m1.as_mut_ptr(),\n177\t                            &mut o1,\n178\t                            std::ptr::null_mut(),\n179\t                            c1.as_ptr(),\n180\t                            l1,\n181\t                            ad.as_ptr(),\n182\t                            adlen as u64,\n183\t                            npub.as_ptr(),\n184\t                            k.as_ptr(),\n185\t                        ),\n186\t                        rd(\n187\t                            m2.as_mut_ptr(),\n188\t                            &mut o2,\n189\t                            std::ptr::null_mut(),\n190\t                            c1.as_ptr(),\n191\t                            l1,\n192\t                            ad.as_ptr(),\n193\t                            adlen as u64,\n194\t                            npub.as_ptr(),\n195\t                            k.as_ptr(),\n196\t                        ),\n197\t                    )\n198\t                };\n199\t                eq_i32(&format!(\"{p}_decrypt rc(m={mlen},ad={adlen})\"), ra, rb);\n200\t                eq_usize(\n201\t                    &format!(\"{p}_decrypt *mlen_p(m={mlen},ad={adlen})\"),\n202\t                    o1 as usize,\n203\t                    o2 as usize,\n204\t                );\n205\t                eq_bytes(&format!(\"{p}_decrypt(m={mlen},ad={adlen})\"), &m1, &m2);\n206\t                assert_eq!(ra, 0, \"{p} round trip must succeed\");\n207\t                assert_eq!(&m1[..mlen], &m[..], \"{p} round trip plaintext\");\n208\t            }\n209\t        }\n210\t    }\n211\t}\n212\t\n213\t#[test]\n214\tfn aead_combined_ad_lengths() {\n215\t    setup();\n216\t    let mut rng = Rng::new(0x8001);\n217\t    for &p in AEADS {\n218\t        let s = sizes(p);\n219\t        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n220\t        for &adlen in ADLENS {\n221\t            for &mlen in &[0usize, 1, 32, 64, 100] {\n222\t                let k = rng.bytes(s.kb);\n223\t                let npub = rng.bytes(s.nb);\n224\t                let m = rng.bytes(mlen);\n225\t                let ad = rng.bytes(adlen);\n226\t                let mut c1 = canary(mlen + s.ab);\n227\t                let mut c2 = canary(mlen + s.ab);\n228\t                let (ra, rb) = unsafe {\n229\t                    (\n230\t                        ce(\n231\t                            c1.as_mut_ptr(),\n232\t                            std::ptr::null_mut(),\n233\t                            m.as_ptr(),\n234\t                            mlen as u64,\n235\t                            ad.as_ptr(),\n236\t                            adlen as u64,\n237\t                            std::ptr::null(),\n238\t                            npub.as_ptr(),\n239\t                            k.as_ptr(),\n240\t                        ),\n241\t                        re(\n242\t                            c2.as_mut_ptr(),\n243\t                            std::ptr::null_mut(),\n244\t                            m.as_ptr(),\n245\t                            mlen as u64,\n246\t                            ad.as_ptr(),\n247\t                            adlen as u64,\n248\t                            std::ptr::null(),\n249\t                            npub.as_ptr(),\n250\t                            k.as_ptr(),\n251\t                        ),\n252\t                    )\n253\t                };\n254\t                eq_i32(&format!(\"{p}_encrypt rc(ad={adlen})\"), ra, rb);\n255\t                eq_bytes(&format!(\"{p}_encrypt(ad={adlen},m={mlen})\"), &c1, &c2);\n256\t            }\n257\t        }\n258\t    }\n259\t}\n260\t\n261\t// ---------------------------------------------------------------------------\n262\t// detached API, and combined-vs-detached equivalence\n263\t// ---------------------------------------------------------------------------\n264\t\n265\t#[test]\n266\tfn aead_detached_and_equivalence() {\n267\t    setup();\n268\t    let mut rng = Rng::new(0x8002);\n269\t    for &p in AEADS {\n270\t        let s = sizes(p);\n271\t        let (ce, _) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n272\t        let (ced, red) = pair::<EncDet>(&format!(\"{p}_encrypt_detached\"));\n273\t        let (cdd, rdd) = pair::<DecDet>(&format!(\"{p}_decrypt_detached\"));\n274\t        for &mlen in &[0usize, 1, 5, 15, 16, 17, 31, 32, 33, 63, 64, 65, 128, 1000, 4097] {\n275\t            for &adlen in &[0usize, 1, 16, 17, 100] {\n276\t                let k = rng.bytes(s.kb);\n277\t                let npub = rng.bytes(s.nb);\n278\t                let m = rng.bytes(mlen);\n279\t                let ad = rng.bytes(adlen);\n280\t\n281\t                let mut c1 = canary(mlen.max(1));\n282\t                let mut c2 = canary(mlen.max(1));\n283\t                let mut t1 = canary(s.ab);\n284\t                let mut t2 = canary(s.ab);\n285\t                let mut ml1 = u64::MAX;\n286\t                let mut ml2 = u64::MAX;\n287\t                let (ra, rb) = unsafe {\n288\t                    (\n289\t                        ced(\n290\t                            c1.as_mut_ptr(),\n291\t                            t1.as_mut_ptr(),\n292\t                            &mut ml1,\n293\t                            m.as_ptr(),\n294\t                            mlen as u64,\n295\t                            ad.as_ptr(),\n296\t                            adlen as u64,\n297\t                            std::ptr::null(),\n298\t                            npub.as_ptr(),\n299\t                            k.as_ptr(),\n300\t                        ),\n301\t                        red(\n302\t                            c2.as_mut_ptr(),\n303\t                            t2.as_mut_ptr(),\n304\t                            &mut ml2,\n305\t                            m.as_ptr(),\n306\t                            mlen as u64,\n307\t                            ad.as_ptr(),\n308\t                            adlen as u64,\n309\t                            std::ptr::null(),\n310\t                            npub.as_ptr(),\n311\t                            k.as_ptr(),\n312\t                        ),\n313\t                    )\n314\t                };\n315\t                eq_i32(&format!(\"{p}_encrypt_detached rc(m={mlen},ad={adlen})\"), ra, rb);\n316\t                eq_usize(&format!(\"{p}_encrypt_detached *maclen_p\"), ml1 as usize, ml2 as usize);\n317\t                eq_bytes(&format!(\"{p}_encrypt_detached c(m={mlen},ad={adlen})\"), &c1, &c2);\n318\t                eq_bytes(&format!(\"{p}_encrypt_detached mac(m={mlen},ad={adlen})\"), &t1, &t2);\n319\t                assert_eq!(ml1 as usize, s.ab);\n320\t\n321\t                // combined output must equal detached c || mac\n322\t                let mut comb = canary(mlen + s.ab);\n323\t                unsafe {\n324\t                    ce(\n325\t                        comb.as_mut_ptr(),\n326\t                        std::ptr::null_mut(),\n327\t                        m.as_ptr(),\n328\t                        mlen as u64,\n329\t                        ad.as_ptr(),\n330\t                        adlen as u64,\n331\t                        std::ptr::null(),\n332\t                        npub.as_ptr(),\n333\t                        k.as_ptr(),\n334\t                    );\n335\t                }\n336\t                eq_bytes(\n337\t                    &format!(\"{p} combined==detached c(m={mlen},ad={adlen})\"),\n338\t                    &comb[..mlen],\n339\t                    &c1[..mlen],\n340\t                );\n341\t                eq_bytes(\n342\t                    &format!(\"{p} combined==detached mac(m={mlen},ad={adlen})\"),\n343\t                    &comb[mlen..],\n344\t                    &t1,\n345\t                );\n346\t\n347\t                // decrypt_detached\n348\t                let mut p1 = canary(mlen.max(1));\n349\t                let mut p2 = canary(mlen.max(1));\n350\t                let (ra, rb) = unsafe {\n351\t                    (\n352\t                        cdd(\n353\t                            p1.as_mut_ptr(),\n354\t                            std::ptr::null_mut(),\n355\t                            c1.as_ptr(),\n356\t                            mlen as u64,\n357\t                            t1.as_ptr(),\n358\t                            ad.as_ptr(),\n359\t                            adlen as u64,\n360\t                            npub.as_ptr(),\n361\t                            k.as_ptr(),\n362\t                        ),\n363\t                        rdd(\n364\t                            p2.as_mut_ptr(),\n365\t                            std::ptr::null_mut(),\n366\t                            c1.as_ptr(),\n367\t                            mlen as u64,\n368\t                            t1.as_ptr(),\n369\t                            ad.as_ptr(),\n370\t                            adlen as u64,\n371\t                            npub.as_ptr(),\n372\t                            k.as_ptr(),\n373\t                        ),\n374\t                    )\n375\t                };\n376\t                eq_i32(&format!(\"{p}_decrypt_detached rc(m={mlen},ad={adlen})\"), ra, rb);\n377\t                eq_bytes(&format!(\"{p}_decrypt_detached(m={mlen},ad={adlen})\"), &p1, &p2);\n378\t                assert_eq!(ra, 0);\n379\t                assert_eq!(&p1[..mlen], &m[..]);\n380\t            }\n381\t        }\n382\t    }\n383\t}\n384\t\n385\t/// `maclen_p == NULL` (encrypt_detached) and `clen_p`/`mlen_p == NULL`.\n386\t#[test]\n387\tfn aead_null_out_length_pointers() {\n388\t    setup();\n389\t    let mut rng = Rng::new(0x8003);\n390\t    for &p in AEADS {\n391\t        let s = sizes(p);\n392\t        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n393\t        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n394\t        let (ced, red) = pair::<EncDet>(&format!(\"{p}_encrypt_detached\"));\n395\t        for &mlen in &[0usize, 1, 64, 100, 1000] {\n396\t            let k = rng.bytes(s.kb);\n397\t            let npub = rng.bytes(s.nb);\n398\t            let m = rng.bytes(mlen);\n399\t            let ad = rng.bytes(16);\n400\t\n401\t            // clen_p == NULL\n402\t            let mut c1 = canary(mlen + s.ab);\n403\t            let mut c2 = canary(mlen + s.ab);\n404\t            unsafe {\n405\t                let a = ce(\n406\t                    c1.as_mut_ptr(),\n407\t                    std::ptr::null_mut(),\n408\t                    m.as_ptr(),\n409\t                    mlen as u64,\n410\t                    ad.as_ptr(),\n411\t                    16,\n412\t                    std::ptr::null(),\n413\t                    npub.as_ptr(),\n414\t                    k.as_ptr(),\n415\t                );\n416\t                let b = re(\n417\t                    c2.as_mut_ptr(),\n418\t                    std::ptr::null_mut(),\n419\t                    m.as_ptr(),\n420\t                    mlen as u64,\n421\t                    ad.as_ptr(),\n422\t                    16,\n423\t                    std::ptr::null(),\n424\t                    npub.as_ptr(),\n425\t                    k.as_ptr(),\n426\t                );\n427\t                eq_i32(&format!(\"{p}_encrypt clen_p=NULL rc\"), a, b);\n428\t            }\n429\t            eq_bytes(&format!(\"{p}_encrypt clen_p=NULL(m={mlen})\"), &c1, &c2);\n430\t\n431\t            // mlen_p == NULL on decrypt\n432\t            let mut m1 = canary(mlen.max(1));\n433\t            let mut m2 = canary(mlen.max(1));\n434\t            unsafe {\n435\t                let a = cd(\n436\t                    m1.as_mut_ptr(),\n437\t                    std::ptr::null_mut(),\n438\t                    std::ptr::null_mut(),\n439\t                    c1.as_ptr(),\n440\t                    (mlen + s.ab) as u64,\n441\t                    ad.as_ptr(),\n442\t                    16,\n443\t                    npub.as_ptr(),\n444\t                    k.as_ptr(),\n445\t                );\n446\t                let b = rd(\n447\t                    m2.as_mut_ptr(),\n448\t                    std::ptr::null_mut(),\n449\t                    std::ptr::null_mut(),\n450\t                    c1.as_ptr(),\n451\t                    (mlen + s.ab) as u64,\n452\t                    ad.as_ptr(),\n453\t                    16,\n454\t                    npub.as_ptr(),\n455\t                    k.as_ptr(),\n456\t                );\n457\t                eq_i32(&format!(\"{p}_decrypt mlen_p=NULL rc\"), a, b);\n458\t                assert_eq!(a, 0);\n459\t            }\n460\t            eq_bytes(&format!(\"{p}_decrypt mlen_p=NULL(m={mlen})\"), &m1, &m2);\n461\t\n462\t            // maclen_p == NULL on encrypt_detached\n463\t            let mut d1 = canary(mlen.max(1));\n464\t            let mut d2 = canary(mlen.max(1));\n465\t            let mut t1 = canary(s.ab);\n466\t            let mut t2 = canary(s.ab);\n467\t            unsafe {\n468\t                let a = ced(\n469\t                    d1.as_mut_ptr(),\n470\t                    t1.as_mut_ptr(),\n471\t                    std::ptr::null_mut(),\n472\t                    m.as_ptr(),\n473\t                    mlen as u64,\n474\t                    ad.as_ptr(),\n475\t                    16,\n476\t                    std::ptr::null(),\n477\t                    npub.as_ptr(),\n478\t                    k.as_ptr(),\n479\t                );\n480\t                let b = red(\n481\t                    d2.as_mut_ptr(),\n482\t                    t2.as_mut_ptr(),\n483\t                    std::ptr::null_mut(),\n484\t                    m.as_ptr(),\n485\t                    mlen as u64,\n486\t                    ad.as_ptr(),\n487\t                    16,\n488\t                    std::ptr::null(),\n489\t                    npub.as_ptr(),\n490\t                    k.as_ptr(),\n491\t                );\n492\t                eq_i32(&format!(\"{p}_encrypt_detached maclen_p=NULL rc\"), a, b);\n493\t            }\n494\t            eq_bytes(&format!(\"{p} det maclen_p=NULL c\"), &d1, &d2);\n495\t            eq_bytes(&format!(\"{p} det maclen_p=NULL mac\"), &t1, &t2);\n496\t        }\n497\t    }\n498\t}\n499\t\n500\t/// `m == NULL` on decrypt (verify-only mode) and `ad == NULL` with `adlen == 0`,\n501\t/// `m == NULL` with `mlen == 0` on encrypt, non-NULL `nsec` (must be ignored).\n502\t#[test]\n503\tfn aead_null_pointer_valid_shapes() {\n504\t    setup();\n505\t    let mut rng = Rng::new(0x8004);\n506\t    for &p in AEADS {\n507\t        let s = sizes(p);\n508\t        assert_eq!(s.nsb, 0, \"{p}_nsecbytes must be 0\");\n509\t        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n510\t        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n511\t        for &mlen in &[0usize, 1, 64, 1000] {\n512\t            let k = rng.bytes(s.kb);\n513\t            let npub = rng.bytes(s.nb);\n514\t            let m = rng.bytes(mlen);\n515\t            let mut c1 = canary(mlen + s.ab);\n516\t            let mut c2 = canary(mlen + s.ab);\n517\t\n518\t            // ad = NULL, adlen = 0\n519\t            unsafe {\n520\t                let a = ce(\n521\t                    c1.as_mut_ptr(),\n522\t                    std::ptr::null_mut(),\n523\t                    if mlen == 0 { std::ptr::null() } else { m.as_ptr() },\n524\t                    mlen as u64,\n525\t                    std::ptr::null(),\n526\t                    0,\n527\t                    std::ptr::null(),\n528\t                    npub.as_ptr(),\n529\t                    k.as_ptr(),\n530\t                );\n531\t                let b = re(\n532\t                    c2.as_mut_ptr(),\n533\t                    std::ptr::null_mut(),\n534\t                    if mlen == 0 { std::ptr::null() } else { m.as_ptr() },\n535\t                    mlen as u64,\n536\t                    std::ptr::null(),\n537\t                    0,\n538\t                    std::ptr::null(),\n539\t                    npub.as_ptr(),\n540\t                    k.as_ptr(),\n541\t                );\n542\t                eq_i32(&format!(\"{p}_encrypt ad=NULL rc\"), a, b);\n543\t            }\n544\t            eq_bytes(&format!(\"{p}_encrypt ad=NULL,m={mlen}\"), &c1, &c2);\n545\t\n546\t            // ad = NULL, adlen = 0 must equal a non-NULL ad with adlen = 0\n547\t            let ad0 = [0u8; 4];\n548\t            let mut c3 = canary(mlen + s.ab);\n549\t            unsafe {\n550\t                ce(\n551\t                    c3.as_mut_ptr(),\n552\t                    std::ptr::null_mut(),\n553\t                    if mlen == 0 { std::ptr::null() } else { m.as_ptr() },\n554\t                    mlen as u64,\n555\t                    ad0.as_ptr(),\n556\t                    0,\n557\t                    std::ptr::null(),\n558\t                    npub.as_ptr(),\n559\t                    k.as_ptr(),\n560\t                );\n561\t            }\n562\t            eq_bytes(&format!(\"{p} ad=NULL == ad!=NULL,adlen=0\"), &c1, &c3);\n563\t\n564\t            // decrypt with m = NULL (verify only)\n565\t            let mut o1 = u64::MAX;\n566\t            let mut o2 = u64::MAX;\n567\t            unsafe {\n568\t                let a = cd(\n569\t                    std::ptr::null_mut(),\n570\t                    &mut o1,\n571\t                    std::ptr::null_mut(),\n572\t                    c1.as_ptr(),\n573\t                    (mlen + s.ab) as u64,\n574\t                    std::ptr::null(),\n575\t                    0,\n576\t                    npub.as_ptr(),\n577\t                    k.as_ptr(),\n578\t                );\n579\t                let b = rd(\n580\t                    std::ptr::null_mut(),\n581\t                    &mut o2,\n582\t                    std::ptr::null_mut(),\n583\t                    c1.as_ptr(),\n584\t                    (mlen + s.ab) as u64,\n585\t                    std::ptr::null(),\n586\t                    0,\n587\t                    npub.as_ptr(),\n588\t                    k.as_ptr(),\n589\t                );\n590\t                eq_i32(&format!(\"{p}_decrypt m=NULL rc(m={mlen})\"), a, b);\n591\t                assert_eq!(a, 0, \"{p} verify-only must succeed\");\n592\t            }\n593\t            eq_usize(&format!(\"{p}_decrypt m=NULL *mlen_p\"), o1 as usize, o2 as usize);\n594\t\n595\t            // non-NULL nsec must be ignored and left untouched\n596\t            let mut ns1 = [0xA5u8; 8];\n597\t            let mut ns2 = [0xA5u8; 8];\n598\t            let mut m1 = canary(mlen.max(1));\n599\t            let mut m2 = canary(mlen.max(1));\n600\t            unsafe {\n601\t                let a = cd(\n602\t                    m1.as_mut_ptr(),\n603\t                    std::ptr::null_mut(),\n604\t                    ns1.as_mut_ptr(),\n605\t                    c1.as_ptr(),\n606\t                    (mlen + s.ab) as u64,\n607\t                    std::ptr::null(),\n608\t                    0,\n609\t                    npub.as_ptr(),\n610\t                    k.as_ptr(),\n611\t                );\n612\t                let b = rd(\n613\t                    m2.as_mut_ptr(),\n614\t                    std::ptr::null_mut(),\n615\t                    ns2.as_mut_ptr(),\n616\t                    c1.as_ptr(),\n617\t                    (mlen + s.ab) as u64,\n618\t                    std::ptr::null(),\n619\t                    0,\n620\t                    npub.as_ptr(),\n621\t                    k.as_ptr(),\n622\t                );\n623\t                eq_i32(&format!(\"{p}_decrypt nsec!=NULL rc\"), a, b);\n624\t            }\n625\t            eq_bytes(&format!(\"{p} nsec buffer untouched\"), &ns1, &ns2);\n626\t            assert_eq!(ns1, [0xA5u8; 8], \"{p} must not write to nsec\");\n627\t            eq_bytes(&format!(\"{p}_decrypt nsec!=NULL plaintext\"), &m1, &m2);\n628\t        }\n629\t    }\n630\t}\n631\t\n632\t/// In-place operation (`c == m`).\n633\t#[test]\n634\tfn aead_in_place() {\n635\t    setup();\n636\t    let mut rng = Rng::new(0x8005);\n637\t    for &p in AEADS {\n638\t        let s = sizes(p);\n639\t        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n640\t        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n641\t        for &mlen in &[0usize, 1, 16, 17, 32, 33, 64, 65, 1000] {\n642\t            let k = rng.bytes(s.kb);\n643\t            let npub = rng.bytes(s.nb);\n644\t            let m = rng.bytes(mlen);\n645\t            let ad = rng.bytes(16);\n646\t\n647\t            let mut b1 = canary(mlen + s.ab);\n648\t            let mut b2 = canary(mlen + s.ab);\n649\t            b1[..mlen].copy_from_slice(&m);\n650\t            b2[..mlen].copy_from_slice(&m);\n651\t            unsafe {\n652\t                let a = ce(\n653\t                    b1.as_mut_ptr(),\n654\t                    std::ptr::null_mut(),\n655\t                    b1.as_ptr(),\n656\t                    mlen as u64,\n657\t                    ad.as_ptr(),\n658\t                    16,\n659\t                    std::ptr::null(),\n660\t                    npub.as_ptr(),\n661\t                    k.as_ptr(),\n662\t                );\n663\t                let b = re(\n664\t                    b2.as_mut_ptr(),\n665\t                    std::ptr::null_mut(),\n666\t                    b2.as_ptr(),\n667\t                    mlen as u64,\n668\t                    ad.as_ptr(),\n669\t                    16,\n670\t                    std::ptr::null(),\n671\t                    npub.as_ptr(),\n672\t                    k.as_ptr(),\n673\t                );\n674\t                eq_i32(&format!(\"{p}_encrypt in-place rc\"), a, b);\n675\t            }\n676\t            eq_bytes(&format!(\"{p}_encrypt in-place(m={mlen})\"), &b1, &b2);\n677\t\n678\t            // decrypt in place\n679\t            let mut d1 = b1.clone();\n680\t            let mut d2 = b1.clone();\n681\t            unsafe {\n682\t                let a = cd(\n683\t                    d1.as_mut_ptr(),\n684\t                    std::ptr::null_mut(),\n685\t                    std::ptr::null_mut(),\n686\t                    d1.as_ptr(),\n687\t                    (mlen + s.ab) as u64,\n688\t                    ad.as_ptr(),\n689\t                    16,\n690\t                    npub.as_ptr(),\n691\t                    k.as_ptr(),\n692\t                );\n693\t                let b = rd(\n694\t                    d2.as_mut_ptr(),\n695\t                    std::ptr::null_mut(),\n696\t                    std::ptr::null_mut(),\n697\t                    d2.as_ptr(),\n698\t                    (mlen + s.ab) as u64,\n699\t                    ad.as_ptr(),\n700\t                    16,\n701\t                    npub.as_ptr(),\n702\t                    k.as_ptr(),\n703\t                );\n704\t                eq_i32(&format!(\"{p}_decrypt in-place rc\"), a, b);\n705\t                assert_eq!(a, 0);\n706\t            }\n707\t            eq_bytes(&format!(\"{p}_decrypt in-place(m={mlen})\"), &d1, &d2);\n708\t            assert_eq!(&d1[..mlen], &m[..]);\n709\t        }\n710\t    }\n711\t}\n712\t\n713\t/// Degenerate / extreme key and nonce shapes.\n714\t#[test]\n715\tfn aead_key_nonce_shapes() {\n716\t    setup();\n717\t    let mut rng = Rng::new(0x8006);\n718\t    for &p in AEADS {\n719\t        let s = sizes(p);\n720\t        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n721\t        let mlen = 64usize;\n722\t        let adlen = 16usize;\n723\t        let m = rng.bytes(mlen);\n724\t        let ad = rng.bytes(adlen);\n725\t        let keys: Vec<Vec<u8>> = vec![vec![0u8; s.kb], vec![0xffu8; s.kb], rng.bytes(s.kb)];\n726\t        let mut nonces: Vec<Vec<u8>> = vec![vec![0u8; s.nb], vec![0xffu8; s.nb], rng.bytes(s.nb)];\n727\t        // For xchacha20: nonces differing only in the first / second half hit\n728\t        // structurally different dependencies (hchacha20 subkey vs npub2).\n729\t        if s.nb == 24 {\n730\t            let base = rng.bytes(24);\n731\t            let mut a = base.clone();\n732\t            a[3] ^= 0xff; // first half only\n733\t            let mut b = base.clone();\n734\t            b[20] ^= 0xff; // second half only\n735\t            nonces.push(base);\n736\t            nonces.push(a);\n737\t            nonces.push(b);\n738\t        }\n739\t        for k in &keys {\n740\t            for n in &nonces {\n741\t                let mut c1 = canary(mlen + s.ab);\n742\t                let mut c2 = canary(mlen + s.ab);\n743\t                unsafe {\n744\t                    let a = ce(\n745\t                        c1.as_mut_ptr(),\n746\t                        std::ptr::null_mut(),\n747\t                        m.as_ptr(),\n748\t                        mlen as u64,\n749\t                        ad.as_ptr(),\n750\t                        adlen as u64,\n751\t                        std::ptr::null(),\n752\t                        n.as_ptr(),\n753\t                        k.as_ptr(),\n754\t                    );\n755\t                    let b = re(\n756\t                        c2.as_mut_ptr(),\n757\t                        std::ptr::null_mut(),\n758\t                        m.as_ptr(),\n759\t                        mlen as u64,\n760\t                        ad.as_ptr(),\n761\t                        adlen as u64,\n762\t                        std::ptr::null(),\n763\t                        n.as_ptr(),\n764\t                        k.as_ptr(),\n765\t                    );\n766\t                    eq_i32(&format!(\"{p} key/nonce shape rc\"), a, b);\n767\t                }\n768\t                eq_bytes(\n769\t                    &format!(\"{p}(k={}, n={})\", hex(k), hex(n)),\n770\t                    &c1,\n771\t                    &c2,\n772\t                );\n773\t            }\n774\t        }\n775\t    }\n776\t}\n777\t\n778\t/// The 128 KiB `STREAM_POLY1305_CHUNK` restart boundary of the three\n779\t/// poly1305-based AEADs (and the same lengths for AEGIS as a control).\n780\t#[test]\n781\tfn aead_chunk_boundary_lengths() {\n782\t    setup();\n783\t    let mut rng = Rng::new(0x8007);\n784\t    for &p in AEADS {\n785\t        let s = sizes(p);\n786\t        let (ce, re) = pair::<Enc>(&format!(\"{p}_encrypt\"));\n787\t        let (cd, rd) = pair::<Dec>(&format!(\"{p}_decrypt\"));\n788\t        for &mlen in CHUNK_LENS {\n789\t            let k = rng.bytes(s.kb);\n790\t            let npub = rng.bytes(s.nb);\n791\t            let m = rng.bytes(mlen);\n792\t            let mut c1 = vec![0xA5u8; mlen + s.ab];\n793\t            let mut c2 = vec![0xA5u8; mlen + s.ab];\n794\t            unsafe {\n795\t                let a = ce(\n796\t                    c1.as_mut_ptr(),\n797\t                    std::ptr::null_mut(),\n798\t                    m.as_ptr(),\n799\t                    mlen as u64,\n800\t                    std::ptr::null(),\n801\t                    0,\n802\t                    std::ptr::null(),\n803\t                    npub.as_ptr(),\n804\t                    k.as_ptr(),\n805\t                );\n806\t                let b = re(\n807\t                    c2.as_mut_ptr(),\n808\t                    std::ptr::null_mut(),\n809\t                    m.as_ptr(),\n810\t                    mlen as u64,\n811\t                    std::ptr::null(),\n812\t                    0,\n813\t                    std::ptr::null(),\n814\t                    npub.as_ptr(),\n815\t                    k.as_ptr(),\n816\t                );\n817\t                eq_i32(&format!(\"{p}_encrypt chunk rc(m={mlen})\"), a, b);\n818\t            }\n819\t            eq_bytes(&format!(\"{p}_encrypt chunk(m={mlen})\"), &c1, &c2);\n820\t\n821\t            // decrypt (single un-chunked pass in C) must agree with encrypt\n822\t            let mut d1 = vec![0xA5u8; mlen];\n823\t            let mut d2 = vec![0xA5u8; mlen];\n824\t            unsafe {\n825\t                let a = cd(\n826\t                    d1.as_mut_ptr(),\n827\t                    std::ptr::null_mut(),\n828\t                    std::ptr::null_mut(),\n829\t                    c1.as_ptr(),\n830\t                    (mlen + s.ab) as u64,\n831\t                    std::ptr::null(),\n832\t                    0,\n833\t                    npub.as_ptr(),\n834\t                    k.as_ptr(),\n835\t                );\n836\t                let b = rd(\n837\t                    d2.as_mut_ptr(),\n838\t                    std::ptr::null_mut(),\n839\t                    std::ptr::null_mut(),\n840\t                    c1.as_ptr(),\n841\t                    (mlen + s.ab) as u64,\n842\t                    std::ptr::null(),\n843\t                    0,\n844\t                    npub.as_ptr(),\n845\t                    k.as_ptr(),\n846\t                );\n847\t                eq_i32(&format!(\"{p}_decrypt chunk rc(m={mlen})\"), a, b);\n848\t                assert_eq!(a, 0, \"{p} chunk round-trip\");\n849\t            }\n850\t            eq_bytes(&format!(\"{p}_decrypt chunk(m={mlen})\"), &d1, &d2);\n851\t            assert_eq!(d1, m);\n852\t        }\n853\t    }\n854\t}\n855\t\n856\t/// AEGIS detached mode accepts `clen < ABYTES` (no gate) — a valid config.\n857\t#[test]\n858\tfn aegis_detached_short_clen() {\n859\t    setup();\n860\t    let mut rng = Rng::new(0x8008);\n861\t    for &p in &[\"crypto_aead_aegis128l\", \"crypto_aead_aegis256\"] {\n862\t        let s = sizes(p);\n863\t        assert_eq!(s.ab, 32);\n864\t        let (ced, red) = pair::<EncDet>(&format!(\"{p}_encrypt_detached\"));\n865\t        let (cdd, rdd) = pair::<DecDet>(&format!(\"{p}_decrypt_detached\"));\n866\t        for &mlen in &[0usize, 1, 5, 31] {\n867\t            let k = rng.bytes(s.kb);\n868\t            let npub = rng.bytes(s.nb);\n869\t            let m = rng.bytes(mlen);\n870\t            let mut c1 = canary(mlen.max(1));\n871\t            let mut c2 = canary(mlen.max(1));\n872\t            let mut t1 = canary(s.ab);\n873\t            let mut t2 = canary(s.ab);\n874\t            unsafe {\n875\t                let a = ced(\n876\t                    c1.as_mut_ptr(),\n877\t                    t1.as_mut_ptr(),\n878\t                    std::ptr::null_mut(),\n879\t                    m.as_ptr(),\n880\t                    mlen as u64,\n881\t                    std::ptr::null(),\n882\t                    0,\n883\t                    std::ptr::null(),\n884\t                    npub.as_ptr(),\n885\t                    k.as_ptr(),\n886\t                );\n887\t                let b = red(\n888\t                    c2.as_mut_ptr(),\n889\t                    t2.as_mut_ptr(),\n890\t                    std::ptr::null_mut(),\n891\t                    m.as_ptr(),\n892\t                    mlen as u64,\n893\t                    std::ptr::null(),\n894\t                    0,\n895\t                    std::ptr::null(),\n896\t                    npub.as_ptr(),\n897\t                    k.as_ptr(),\n898\t                );\n899\t                eq_i32(\"aegis det short rc\", a, b);\n900\t            }\n901\t            eq_bytes(&format!(\"{p} det short c(m={mlen})\"), &c1, &c2);\n902\t            eq_bytes(&format!(\"{p} det short mac(m={mlen})\"), &t1, &t2);\n903\t\n904\t            let mut p1 = canary(mlen.max(1));\n905\t            let mut p2 = canary(mlen.max(1));\n906\t            unsafe {\n907\t                let a = cdd(\n908\t                    p1.as_mut_ptr(),\n909\t                    std::ptr::null_mut(),\n910\t                    c1.as_ptr(),\n911\t                    mlen as u64,\n912\t                    t1.as_ptr(),\n913\t                    std::ptr::null(),\n914\t                    0,\n915\t                    npub.as_ptr(),\n916\t                    k.as_ptr(),\n917\t                );\n918\t                let b = rdd(\n919\t                    p2.as_mut_ptr(),\n920\t                    std::ptr::null_mut(),\n921\t                    c1.as_ptr(),\n922\t                    mlen as u64,\n923\t                    t1.as_ptr(),\n924\t                    std::ptr::null(),\n925\t                    0,\n926\t                    npub.as_ptr(),\n927\t                    k.as_ptr(),\n928\t                );\n929\t                eq_i32(\"aegis det short decrypt rc\", a, b);\n930\t                assert_eq!(a, 0);\n931\t            }\n932\t            eq_bytes(&format!(\"{p} det short decrypt(m={mlen})\"), &p1, &p2);\n933\t        }\n934\t    }\n935\t}\n936\t\n937\t/// Cross-variant wiring: xchacha20poly1305_ietf(k, npub24) must equal\n938\t/// chacha20poly1305_ietf(hchacha20(npub[0..16], k), 0000||npub[16..24]).\n939\t#[test]\n940\tfn xchacha_equals_chacha_ietf_with_derived_subkey() {\n941\t    setup();\n942\t    let mut rng = Rng::new(0x8009);\n943\t    let (cx, _) = pair::<Enc>(\"crypto_aead_xchacha20poly1305_ietf_encrypt\");\n944\t    let (ci, _) = pair::<Enc>(\"crypto_aead_chacha20poly1305_ietf_encrypt\");\n945\t    // use the *Rust* library for both halves of the identity too\n946\t    let (_, rx) = pair::<Enc>(\"crypto_aead_xchacha20poly1305_ietf_encrypt\");\n947\t    let (_, ri) = pair::<Enc>(\"crypto_aead_chacha20poly1305_ietf_encrypt\");\n948\t    let hchacha =\n949\t        pair::<unsafe extern \"C\" fn(*mut u8, *const u8, *const u8, *const u8) -> i32>(\n950\t            \"crypto_core_hchacha20\",\n951\t        );\n952\t    for &mlen in &[0usize, 1, 64, 65, 1000] {\n953\t        for &adlen in &[0usize, 16, 17] {\n954\t            let k = rng.bytes(32);\n955\t            let npub = rng.bytes(24);\n956\t            let m = rng.bytes(mlen);\n957\t            let ad = rng.bytes(adlen);\n958\t            for (which, (xf, inf, hc)) in [(cx, ci, hchacha.0), (rx, ri, hchacha.1)]\n959\t                .into_iter()\n960\t                .enumerate()\n961\t            {\n962\t                let mut k2 = [0u8; 32];\n963\t                unsafe {\n964\t                    hc(\n965\t                        k2.as_mut_ptr(),\n966\t                        npub.as_ptr(),\n967\t                        k.as_ptr(),\n968\t                        std::ptr::null(),\n969\t                    )\n970\t                };\n971\t                let mut npub2 = [0u8; 12];\n972\t                npub2[4..].copy_from_slice(&npub[16..24]);\n973\t\n974\t                let mut a = canary(mlen + 16);\n975\t                let mut b = canary(mlen + 16);\n976\t                unsafe {\n977\t                    xf(\n978\t                        a.as_mut_ptr(),\n979\t                        std::ptr::null_mut(),\n980\t                        m.as_ptr(),\n981\t                        mlen as u64,\n982\t                        ad.as_ptr(),\n983\t                        adlen as u64,\n984\t                        std::ptr::null(),\n985\t                        npub.as_ptr(),\n986\t                        k.as_ptr(),\n987\t                    );\n988\t                    inf(\n989\t                        b.as_mut_ptr(),\n990\t                        std::ptr::null_mut(),\n991\t                        m.as_ptr(),\n992\t                        mlen as u64,\n993\t                        ad.as_ptr(),\n994\t                        adlen as u64,\n995\t                        std::ptr::null(),\n996\t                        npub2.as_ptr(),\n997\t                        k2.as_ptr(),\n998\t                    );\n999\t                }\n1000\t                eq_bytes(\n1001\t                    &format!(\"xchacha==chacha_ietf (lib={which}, m={mlen}, ad={adlen})\"),\n1002\t                    &a,\n1003\t                    &b,\n1004\t                );\n1005\t            }\n1006\t        }\n1007\t    }\n1008\t}\n1009\t\n1010\t/// Every AEAD `_keygen` is deterministic under the installed RNG.\n1011\t#[test]\n1012\tfn aead_keygens() {\n1013\t    setup();\n1014\t    let mut names: Vec<String> = AEADS.iter().map(|p| format!(\"{p}_keygen\")).collect();\n1015\t    names.push(\"crypto_aead_aes256gcm_keygen\".into());\n1016\t    for name in &names {\n1017\t        let p = name.trim_end_matches(\"_keygen\");\n1018\t        let kb = unsafe { sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), &format!(\"{p}_keybytes\"))() };\n1019\t        let (c, r) = pair::<Keygen>(name);\n1020\t        for seed in 0..8u64 {\n1021\t            let mut a = canary(kb + 8);\n1022\t            let mut b = canary(kb + 8);\n1023\t            reset_rngs(0xD000 + seed);\n1024\t            unsafe { c(a.as_mut_ptr()) };\n1025\t            reset_rngs(0xD000 + seed);\n1026\t            unsafe { r(b.as_mut_ptr()) };\n1027\t            eq_bytes(&format!(\"{name} seed={seed}\"), &a, &b);\n1028\t            assert_eq!(&a[kb..], &[0xA5u8; 8], \"{name} wrote past keybytes\");\n1029\t        }\n1030\t    }\n1031\t}\n1032\t\n1033\t// ---------------------------------------------------------------------------\n1034\t// aes256gcm — unavailable in this build. Every operation must reject the same\n1035\t// way in C and Rust (errno included).\n1036\t// ---------------------------------------------------------------------------\n1037\t\n1038\ttype Beforenm = unsafe extern \"C\" fn(*mut u8, *const u8) -> i32;\n1039\ttype EncAfternm = unsafe extern \"C\" fn(\n1040\t    *mut u8,\n1041\t    *mut u64,\n1042\t    *const u8,\n1043\t    u64,\n1044\t    *const u8,\n1045\t    u64,\n1046\t    *const u8,\n1047\t    *const u8,\n1048\t    *const u8,\n1049\t) -> i32;\n1050\t\n1051\t#[test]\n1052\tfn aes256gcm_is_unavailable_identically() {\n1053\t    setup();\n1054\t    let mut rng = Rng::new(0x800A);\n1055\t    let (cav, rav) = pair::<unsafe extern \"C\" fn() -> i32>(\"crypto_aead_aes256gcm_is_available\");\n1056\t    let (a, b) = unsafe { (cav(), rav()) };\n1057\t    eq_i32(\"crypto_aead_aes256gcm_is_available\", a, b);\n1058\t    assert_eq!(a, 0, \"this build must not have AES-NI AES-GCM\");\n1059\t\n1060\t    let s = sizes(\"crypto_aead_aes256gcm\");\n1061\t    assert_eq!((s.kb, s.nb, s.ab, s.nsb), (32, 12, 16, 0));\n1062\t\n1063\t    let statebytes = unsafe {\n1064\t        sym::<unsafe extern \"C\" fn() -> usize>(c_lib(), \"crypto_aead_aes256gcm_statebytes\")()\n1065\t    };\n1066\t    assert_eq!(statebytes, 512);\n1067\t\n1068\t    let (ce, re) = pair::<Enc>(\"crypto_aead_aes256gcm_encrypt\");\n1069\t    let (cd, rd) = pair::<Dec>(\"crypto_aead_aes256gcm_decrypt\");\n1070\t    let (ced, red) = pair::<EncDet>(\"crypto_aead_aes256gcm_encrypt_detached\");\n1071\t    let (cdd, rdd) = pair::<DecDet>(\"crypto_aead_aes256gcm_decrypt_detached\");\n1072\t    let (cbn, rbn) = pair::<Beforenm>(\"crypto_aead_aes256gcm_beforenm\");\n1073\t\n1074\t    for &mlen in &[0usize, 16, 17, 100] {\n1075\t        for &adlen in &[0usize, 16, 100] {\n1076\t            let k = rng.bytes(32);\n1077\t            let npub = rng.bytes(12);\n1078\t            let m = rng.bytes(mlen);\n1079\t            let ad = rng.bytes(adlen);\n1080\t\n1081\t            for null_len in [false, true] {\n1082\t                let mut c1 = canary(mlen + 16);\n1083\t                let mut c2 = canary(mlen + 16);\n1084\t                let mut l1 = 0xDEAD_BEEFu64;\n1085\t                let mut l2 = 0xDEAD_BEEFu64;\n1086\t                let lp1 = if null_len { std::ptr::null_mut() } else { &raw mut l1 };\n1087\t                let lp2 = if null_len { std::ptr::null_mut() } else { &raw mut l2 };\n1088\t                unsafe {\n1089\t                    let a = ce(\n1090\t                        c1.as_mut_ptr(), lp1, m.as_ptr(), mlen as u64,\n1091\t                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n1092\t                        npub.as_ptr(), k.as_ptr(),\n1093\t                    );\n1094\t                    let b = re(\n1095\t                        c2.as_mut_ptr(), lp2, m.as_ptr(), mlen as u64,\n1096\t                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n1097\t                        npub.as_ptr(), k.as_ptr(),\n1098\t                    );\n1099\t                    eq_i32(\"aes256gcm_encrypt rc\", a, b);\n1100\t                    assert_eq!(a, -1);\n1101\t                }\n1102\t                eq_bytes(\"aes256gcm_encrypt out untouched\", &c1, &c2);\n1103\t                assert_eq!(c1, canary(mlen + 16));\n1104\t                eq_usize(\"aes256gcm_encrypt *clen_p untouched\", l1 as usize, l2 as usize);\n1105\t\n1106\t                let mut m1 = canary(mlen.max(1));\n1107\t                let mut m2 = canary(mlen.max(1));\n1108\t                let mut o1 = 0xDEAD_BEEFu64;\n1109\t                let mut o2 = 0xDEAD_BEEFu64;\n1110\t                let op1 = if null_len { std::ptr::null_mut() } else { &raw mut o1 };\n1111\t                let op2 = if null_len { std::ptr::null_mut() } else { &raw mut o2 };\n1112\t                unsafe {\n1113\t                    let a = cd(\n1114\t                        m1.as_mut_ptr(), op1, std::ptr::null_mut(), c1.as_ptr(),\n1115\t                        (mlen + 16) as u64, ad.as_ptr(), adlen as u64,\n1116\t                        npub.as_ptr(), k.as_ptr(),\n1117\t                    );\n1118\t                    let b = rd(\n1119\t                        m2.as_mut_ptr(), op2, std::ptr::null_mut(), c1.as_ptr(),\n1120\t                        (mlen + 16) as u64, ad.as_ptr(), adlen as u64,\n1121\t                        npub.as_ptr(), k.as_ptr(),\n1122\t                    );\n1123\t                    eq_i32(\"aes256gcm_decrypt rc\", a, b);\n1124\t                    assert_eq!(a, -1);\n1125\t                }\n1126\t                eq_bytes(\"aes256gcm_decrypt out untouched\", &m1, &m2);\n1127\t                eq_usize(\"aes256gcm_decrypt *mlen_p untouched\", o1 as usize, o2 as usize);\n1128\t\n1129\t                // detached\n1130\t                let mut d1 = canary(mlen.max(1));\n1131\t                let mut d2 = canary(mlen.max(1));\n1132\t                let mut t1 = canary(16);\n1133\t                let mut t2 = canary(16);\n1134\t                let mut ml1 = 0xDEAD_BEEFu64;\n1135\t                let mut ml2 = 0xDEAD_BEEFu64;\n1136\t                let mp1 = if null_len { std::ptr::null_mut() } else { &raw mut ml1 };\n1137\t                let mp2 = if null_len { std::ptr::null_mut() } else { &raw mut ml2 };\n1138\t                unsafe {\n1139\t                    let a = ced(\n1140\t                        d1.as_mut_ptr(), t1.as_mut_ptr(), mp1, m.as_ptr(), mlen as u64,\n1141\t                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n1142\t                        npub.as_ptr(), k.as_ptr(),\n1143\t                    );\n1144\t                    let b = red(\n1145\t                        d2.as_mut_ptr(), t2.as_mut_ptr(), mp2, m.as_ptr(), mlen as u64,\n1146\t                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n1147\t                        npub.as_ptr(), k.as_ptr(),\n1148\t                    );\n1149\t                    eq_i32(\"aes256gcm_encrypt_detached rc\", a, b);\n1150\t                    assert_eq!(a, -1);\n1151\t                }\n1152\t                eq_bytes(\"aes256gcm det c untouched\", &d1, &d2);\n1153\t                eq_bytes(\"aes256gcm det mac untouched\", &t1, &t2);\n1154\t                eq_usize(\"aes256gcm det *maclen_p\", ml1 as usize, ml2 as usize);\n1155\t\n1156\t                let mut p1 = canary(mlen.max(1));\n1157\t                let mut p2 = canary(mlen.max(1));\n1158\t                let mac = rng.bytes(16);\n1159\t                unsafe {\n1160\t                    let a = cdd(\n1161\t                        p1.as_mut_ptr(), std::ptr::null_mut(), d1.as_ptr(), mlen as u64,\n1162\t                        mac.as_ptr(), ad.as_ptr(), adlen as u64, npub.as_ptr(), k.as_ptr(),\n1163\t                    );\n1164\t                    let b = rdd(\n1165\t                        p2.as_mut_ptr(), std::ptr::null_mut(), d1.as_ptr(), mlen as u64,\n1166\t                        mac.as_ptr(), ad.as_ptr(), adlen as u64, npub.as_ptr(), k.as_ptr(),\n1167\t                    );\n1168\t                    eq_i32(\"aes256gcm_decrypt_detached rc\", a, b);\n1169\t                    assert_eq!(a, -1);\n1170\t                }\n1171\t                eq_bytes(\"aes256gcm det decrypt out untouched\", &p1, &p2);\n1172\t\n1173\t                // m == NULL on decrypt_detached\n1174\t                unsafe {\n1175\t                    let a = cdd(\n1176\t                        std::ptr::null_mut(), std::ptr::null_mut(), d1.as_ptr(), mlen as u64,\n1177\t                        mac.as_ptr(), ad.as_ptr(), adlen as u64, npub.as_ptr(), k.as_ptr(),\n1178\t                    );\n1179\t                    let b = rdd(\n1180\t                        std::ptr::null_mut(), std::ptr::null_mut(), d1.as_ptr(), mlen as u64,\n1181\t                        mac.as_ptr(), ad.as_ptr(), adlen as u64, npub.as_ptr(), k.as_ptr(),\n1182\t                    );\n1183\t                    eq_i32(\"aes256gcm_decrypt_detached m=NULL rc\", a, b);\n1184\t                }\n1185\t            }\n1186\t        }\n1187\t    }\n1188\t\n1189\t    // beforenm\n1190\t    let k = rng.bytes(32);\n1191\t    let mut st1 = State::new(statebytes);\n1192\t    let mut st2 = State::new(statebytes);\n1193\t    unsafe {\n1194\t        let a = cbn(st1.as_mut_ptr(), k.as_ptr());\n1195\t        let b = rbn(st2.as_mut_ptr(), k.as_ptr());\n1196\t        eq_i32(\"aes256gcm_beforenm rc\", a, b);\n1197\t        assert_eq!(a, -1);\n1198\t    }\n1199\t    eq_bytes(\"aes256gcm_beforenm state untouched\", st1.bytes(), st2.bytes());\n1200\t\n1201\t    // *_afternm forms\n1202\t    for name in [\n1203\t        \"crypto_aead_aes256gcm_encrypt_afternm\",\n1204\t        \"crypto_aead_aes256gcm_decrypt_afternm\",\n1205\t        \"crypto_aead_aes256gcm_encrypt_detached_afternm\",\n1206\t        \"crypto_aead_aes256gcm_decrypt_detached_afternm\",\n1207\t    ] {\n1208\t        let (c, r) = pair::<EncAfternm>(name);\n1209\t        for &mlen in &[0usize, 16, 100] {\n1210\t            for &adlen in &[0usize, 16] {\n1211\t                let m = rng.bytes(mlen);\n1212\t                let ad = rng.bytes(adlen);\n1213\t                let npub = rng.bytes(12);\n1214\t                let mut out1 = canary(mlen + 32);\n1215\t                let mut out2 = canary(mlen + 32);\n1216\t                let mut l1 = 0xDEADu64;\n1217\t                let mut l2 = 0xDEADu64;\n1218\t                unsafe {\n1219\t                    let a = c(\n1220\t                        out1.as_mut_ptr(), &mut l1, m.as_ptr(), mlen as u64,\n1221\t                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n1222\t                        npub.as_ptr(), st1.as_ptr(),\n1223\t                    );\n1224\t                    let b = r(\n1225\t                        out2.as_mut_ptr(), &mut l2, m.as_ptr(), mlen as u64,\n1226\t                        ad.as_ptr(), adlen as u64, std::ptr::null(),\n1227\t                        npub.as_ptr(), st2.as_ptr(),\n1228\t                    );\n1229\t                    eq_i32(&format!(\"{name} rc\"), a, b);\n1230\t                    assert_eq!(a, -1, \"{name} must be unavailable\");\n1231\t                }\n1232\t                eq_bytes(&format!(\"{name} out untouched\"), &out1, &out2);\n1233\t                eq_usize(&format!(\"{name} *len untouched\"), l1 as usize, l2 as usize);\n1234\t            }\n1235\t        }\n1236\t    }\n1237\t}\n1238\t"}]},"parent_tool_use_id":"toolu_bdrk_018AKqc9oZCiiirxxs7Qyssn","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"328d35e4-4bc6-4bf9-81a5-cd01c4256d0c","timestamp":"2026-08-23T08:29:49.137Z","subagent_type":"general-purpose","task_description":"Phase B+C tests: box/sec