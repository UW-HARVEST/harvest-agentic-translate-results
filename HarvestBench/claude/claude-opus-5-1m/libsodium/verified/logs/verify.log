{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_lr46j4klzv2e5vr6gr2w6caxrmw7oxd3ss47az7yxo55zqeiyhnq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01HQdMg7ZgrLaJ2GtwNjmVXS","name":"Edit","input":{"replace_all":false,"file_path":"/local/home/scheschb/.harvest/work/harvest-work-djFIwa/translated_rust/tests/diff_g7.rs","old_string":"        both::<FnBlake2bLong, _>(&ctx, \"_sodium_blake2b_long\", outlen, |f, p| unsafe {\n            (*f)(\n                p as *mut c_void,\n                outlen,\n                input.as_ptr() as *const c_void,\n                inlen,\n            )\n        });\n    }\n}","new_string":"        both::<FnBlake2bLong, _>(&ctx, \"_sodium_blake2b_long\", outlen, |f, p| unsafe {\n            (*f)(\n                p as *mut c_void,\n                outlen,\n                input.as_ptr() as *const c_void,\n                inlen,\n            )\n        });\n    }\n}\n\n// ===========================================================================\n// Phase C — error paths\n// ===========================================================================\n\n/// errors: `crypto_pwhash` with an out-of-range `alg`. The dispatcher's `switch`\n/// rejects BEFORE calling any primitive, so `out` is left completely UNTOUCHED —\n/// in deliberate contrast to the primitive entry points, which `memset` first.\n#[test]\nfn err_pwhash_dispatcher_bad_alg() {\n    for alg in [0i32, 3, 4, 100, 255, -1, c_int::MAX, c_int::MIN] {\n        let ctx = format!(\"crypto_pwhash alg={alg}\");\n        let o = a2_raw(&ctx, \"crypto_pwhash\", 32, PW, &SALT16, 1, 8192, alg);\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n        assert_untouched(&ctx, &o.out);\n        assert_eq!(o.rng, 0, \"{ctx}: rejected before any RNG use\");\n    }\n    // ... and the two valid values are accepted.\n    for (alg, ops) in [(ARGON2I13, 3u64), (ARGON2ID13, 1)] {\n        let ctx = format!(\"crypto_pwhash alg={alg} (valid)\");\n        let o = a2_raw(&ctx, \"crypto_pwhash\", 32, PW, &SALT16, ops, 8192, alg);\n        eq_ret(&ctx, 0, o.rc);\n    }\n}\n\n/// errors: the primitive entry points reject the sibling algorithm, and every\n/// rejected call has already `memset` the output buffer.\n#[test]\nfn err_pwhash_primitive_bad_alg() {\n    for alg in [0i32, 2, 3, 4, 255, -1, c_int::MAX, c_int::MIN] {\n        let ctx = format!(\"crypto_pwhash_argon2i alg={alg}\");\n        let o = a2_raw(&ctx, \"crypto_pwhash_argon2i\", 32, PW, &SALT16, 3, 8192, alg);\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n        assert_zeroed(&ctx, &o.out);\n    }\n    for alg in [0i32, 1, 3, 4, 255, -1, c_int::MAX, c_int::MIN] {\n        let ctx = format!(\"crypto_pwhash_argon2id alg={alg}\");\n        let o = a2_raw(&ctx, \"crypto_pwhash_argon2id\", 32, PW, &SALT16, 1, 8192, alg);\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n        assert_zeroed(&ctx, &o.out);\n    }\n}\n\n/// errors: `outlen`, `opslimit` and `memlimit` bounds on the raw argon2 entry\n/// points (`EINVAL` below the minimum, `EFBIG` above the maximum), plus the\n/// `out == passwd` alias check. Every rejected call leaves `out` zeroed.\n#[test]\nfn err_argon2_raw_bounds() {\n    // outlen < BYTES_MIN\n    for (sym, ops) in [\n        (\"crypto_pwhash_argon2i\", 3u64),\n        (\"crypto_pwhash_argon2id\", 1),\n    ] {\n        let alg = if sym.ends_with(\"argon2i\") {\n            ARGON2I13\n        } else {\n            ARGON2ID13\n        };\n        for outlen in [0usize, 1, 15] {\n            let ctx = format!(\"{sym} outlen={outlen}\");\n            let o = a2_raw(&ctx, sym, outlen, PW, &SALT16, ops, 8192, alg);\n            eq_ret(&ctx, -1, o.rc);\n            assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n            assert_zeroed(&ctx, &o.out);\n        }\n\n        // passwdlen / opslimit / memlimit ABOVE the maximum -> EFBIG.\n        // `passwd` is never dereferenced on this path, so a lying length is safe.\n        let cases: [(&str, u64, u64, usize); 3] = [\n            (\"passwdlen=2^32\", 4294967296, ops, 8192),\n            (\"opslimit=2^32\", PW.len() as u64, 4294967296, 8192),\n            (\"memlimit=MEMLIMIT_MAX+1024\", PW.len() as u64, ops, 4398046511104),\n        ];\n        for (label, pwlen, o_, m_) in cases {\n            let ctx = format!(\"{sym} {label}\");\n            let obs = both::<FnPwhash, _>(&ctx, sym, 32, |f, p| unsafe {\n                (*f)(\n                    p,\n                    32,\n                    PW.as_ptr() as *const c_char,\n                    pwlen,\n                    SALT16.as_ptr(),\n                    o_,\n                    m_,\n                    alg,\n                )\n            });\n            eq_ret(&ctx, -1, obs.rc);\n            assert_eq!(obs.errno, EFBIG, \"{ctx}: expected EFBIG\");\n            assert_zeroed(&ctx, &obs.out);\n        }\n\n        // memlimit BELOW MEMLIMIT_MIN -> EINVAL\n        for mem in [0usize, 1, 8191] {\n            let ctx = format!(\"{sym} memlimit={mem}\");\n            let o = a2_raw(&ctx, sym, 32, PW, &SALT16, ops, mem, alg);\n            eq_ret(&ctx, -1, o.rc);\n            assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n            assert_zeroed(&ctx, &o.out);\n        }\n\n        // `out == passwd` (exact pointer aliasing)\n        let ctx = format!(\"{sym} out == passwd\");\n        let o = both::<FnPwhash, _>(&ctx, sym, 32, |f, p| unsafe {\n            (*f)(p, 32, p as *const c_char, 4, SALT16.as_ptr(), ops, 8192, alg)\n        });\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n        assert_zeroed(&ctx, &o.out);\n    }\n\n    // OPSLIMIT_MIN is 3 for argon2i but 1 for argon2id.\n    for ops in [0u64, 1, 2] {\n        let ctx = format!(\"crypto_pwhash_argon2i opslimit={ops}\");\n        let o = a2_raw(&ctx, \"crypto_pwhash_argon2i\", 32, PW, &SALT16, ops, 8192, ARGON2I13);\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n        assert_zeroed(&ctx, &o.out);\n        // ... and the same through the dispatcher\n        let ctx = format!(\"crypto_pwhash alg=1 opslimit={ops}\");\n        let o = a2_raw(&ctx, \"crypto_pwhash\", 32, PW, &SALT16, ops, 8192, ARGON2I13);\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n        assert_zeroed(&ctx, &o.out);\n    }\n    // argon2id accepts opslimit = 1 but not 0.\n    let o = a2_raw(\n        \"crypto_pwhash_argon2id opslimit=0\",\n        \"crypto_pwhash_argon2id\",\n        32,\n        PW,\n        &SALT16,\n        0,\n        8192,\n        ARGON2ID13,\n    );\n    eq_ret(\"crypto_pwhash_argon2id opslimit=0\", -1, o.rc);\n    assert_eq!(o.errno, EINVAL);\n    assert_zeroed(\"crypto_pwhash_argon2id opslimit=0\", &o.out);\n    let o = a2_raw(\n        \"crypto_pwhash_argon2i opslimit=2 vs argon2id\",\n        \"crypto_pwhash_argon2id\",\n        32,\n        PW,\n        &SALT16,\n        2,\n        8192,\n        ARGON2ID13,\n    );\n    eq_ret(\"opslimit=2 is valid for argon2id\", 0, o.rc);\n}\n\n/// errors: `crypto_pwhash*_str` bounds. All of them leave the whole 128-byte\n/// buffer zeroed by the leading `memset(out, 0, STRBYTES)`.\n#[test]\nfn err_argon2_str_bounds() {\n    for (sym, minops) in [\n        (\"crypto_pwhash_argon2i_str\", 3u64),\n        (\"crypto_pwhash_argon2id_str\", 1),\n        (\"crypto_pwhash_str\", 1),\n    ] {\n        // EFBIG rows\n        let cases: [(&str, u64, u64, usize, c_int); 3] = [\n            (\"passwdlen=2^32\", 4294967296, minops, 8192, EFBIG),\n            (\"opslimit=2^32\", 4, 4294967296, 8192, EFBIG),\n            (\"memlimit=MEMLIMIT_MAX+1024\", 4, minops, 4398046511104, EFBIG),\n        ];\n        for (label, pwlen, ops, mem, want) in cases {\n            let ctx = format!(\"{sym} {label}\");\n            let o = both::<FnStr, _>(&ctx, sym, 128, |f, p| unsafe {\n                (*f)(\n                    p as *mut c_char,\n                    PW.as_ptr() as *const c_char,\n                    pwlen,\n                    ops,\n                    mem,\n                )\n            });\n            eq_ret(&ctx, -1, o.rc);\n            assert_eq!(o.errno, want, \"{ctx}: unexpected errno\");\n            assert_zeroed(&ctx, &o.out);\n            assert_eq!(o.rng, 0, \"{ctx}: rejected before randombytes_buf(salt)\");\n        }\n        // EINVAL rows: opslimit below the minimum\n        let below: Vec<u64> = if minops == 3 { vec![0, 1, 2] } else { vec![0] };\n        for ops in below {\n            let ctx = format!(\"{sym} opslimit={ops}\");\n            let o = a2_str(&ctx, sym, PW, ops, 8192, RngMode::Counter(1));\n            eq_ret(&ctx, -1, o.rc);\n            assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n            assert_zeroed(&ctx, &o.out);\n            assert_eq!(o.rng, 0);\n        }\n        // EINVAL rows: memlimit below MEMLIMIT_MIN\n        for mem in [0usize, 1, 8191] {\n            let ctx = format!(\"{sym} memlimit={mem}\");\n            let o = a2_str(&ctx, sym, PW, minops, mem, RngMode::Counter(1));\n            eq_ret(&ctx, -1, o.rc);\n            assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n            assert_zeroed(&ctx, &o.out);\n        }\n    }\n\n    // `_str_alg` inherits the same bounds for the two VALID algorithm values.\n    for (alg, minops) in [(ARGON2I13, 3u64), (ARGON2ID13, 1)] {\n        let ctx = format!(\"crypto_pwhash_str_alg alg={alg} memlimit=8191\");\n        let o = a2_str_alg(&ctx, PW, minops, 8191, alg, RngMode::Counter(1));\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EINVAL);\n        assert_zeroed(&ctx, &o.out);\n    }\n}\n\n/// errors: `crypto_pwhash_str_verify` / `_str_needs_rehash` reject anything that\n/// matches neither `\"$argon2id$\"` nor `\"$argon2i$\"` with `-1` / `EINVAL`.\n#[test]\nfn err_generic_prefix_mismatch() {\n    let bad = [\n        TS_EMPTY,\n        TS_DOLLAR,\n        TS_TRUNC_TAG,\n        TS_UNKNOWN_ALG,\n        TS_SCRYPT_OK,\n        \"$argon2\",\n        \"$argon2i\",\n        \"argon2id$v=19$m=8,t=1,p=1$QUFBQUFBQUFBQUFBQUFBQQ$QUFBQUFBQUFBQUFBQUFBQQ\",\n    ];\n    for s in bad {\n        let ctx = format!(\"crypto_pwhash_str_verify({s:?})\");\n        let o = str_verify(&ctx, \"crypto_pwhash_str_verify\", s, PW);\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n        assert_eq!(o.rng, 0, \"{ctx}: rejected before any argon2 work\");\n\n        let ctx = format!(\"crypto_pwhash_str_needs_rehash({s:?})\");\n        let o = needs_rehash(&ctx, \"crypto_pwhash_str_needs_rehash\", s, 1, 8192);\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n    }\n}\n\n/// errors: the argon2 `_str_verify` errno discipline. `EINVAL` is set ONLY for\n/// `ARGON2_VERIFY_MISMATCH`; every DECODING failure leaves `errno` untouched.\n#[test]\nfn err_argon2_str_verify_errno_discipline() {\n    // ---- decoding failures: errno UNTOUCHED ----\n    let decode_fail = [\n        (\"TS_EMPTY\", TS_EMPTY),\n        (\"TS_TRUNC_TAG\", TS_TRUNC_TAG),\n        (\"TS_NO_PARAMS\", TS_NO_PARAMS),\n        (\"TS_BAD_V18\", TS_BAD_V18),\n        (\"TS_NO_V\", TS_NO_V),\n        (\"TS_V_PLUS\", TS_V_PLUS),\n        (\"TS_V_LEADING_ZERO\", TS_V_LEADING_ZERO),\n        (\"TS_V_OVERFLOW\", TS_V_OVERFLOW),\n        (\"TS_M_LEADING_ZERO\", TS_M_LEADING_ZERO),\n        (\"TS_M_OVERFLOW\", TS_M_OVERFLOW),\n        (\"TS_M7\", TS_M7),\n        (\"TS_M8_P2\", TS_M8_P2),\n        (\"TS_T0\", TS_T0),\n        (\"TS_P0\", TS_P0),\n        (\"TS_P_TOO_MANY\", TS_P_TOO_MANY),\n        (\"TS_REORDER\", TS_REORDER),\n        (\"TS_EMPTY_SALT\", TS_EMPTY_SALT),\n        (\"TS_SALT6\", TS_SALT6),\n        (\"TS_BAD_B64_SALT\", TS_BAD_B64_SALT),\n        (\"TS_SHORT_HASH\", TS_SHORT_HASH),\n        (\"TS_NO_HASH\", TS_NO_HASH),\n        (\"TS_B64_PAD\", TS_B64_PAD),\n        (\"TS_TRAIL_DOLLAR\", TS_TRAIL_DOLLAR),\n        // a correctly-formed argon2i string fed to the argon2id verifier\n        (\"TS_ARGON2I_OK\", TS_ARGON2I_OK),\n    ];\n    for (name, s) in decode_fail {\n        let ctx = format!(\"argon2id_str_verify({name})\");\n        let o = str_verify(&ctx, \"crypto_pwhash_argon2id_str_verify\", s, PW);\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(\n            o.errno, ERRNO_SENTINEL,\n            \"{ctx}: a DECODING failure must leave errno untouched\"\n        );\n        assert_eq!(o.rng, 0, \"{ctx}: no argon2_hash means no randombytes_buf\");\n        // ... and the generic wrapper forwards without setting errno itself\n        if s.starts_with(\"$argon2id$\") || s.starts_with(\"$argon2i$\") {\n            let ctx = format!(\"crypto_pwhash_str_verify({name}) forwarded\");\n            let o = str_verify(&ctx, \"crypto_pwhash_str_verify\", s, PW);\n            eq_ret(&ctx, -1, o.rc);\n            assert_eq!(\n                o.errno, ERRNO_SENTINEL,\n                \"{ctx}: the generic wrapper must not set EINVAL when it forwards\"\n            );\n        }\n    }\n\n    // an argon2id string fed to the argon2i verifier: `CC(\"$argon2i\")` succeeds\n    // (the argon2id prefix starts with it) and only `CC(\"$v=\")` fails.\n    let o = str_verify(\n        \"argon2i_str_verify(TS_ARGON2ID_OK)\",\n        \"crypto_pwhash_argon2i_str_verify\",\n        TS_ARGON2ID_OK,\n        PW,\n    );\n    eq_ret(\"argon2i_str_verify(TS_ARGON2ID_OK)\", -1, o.rc);\n    assert_eq!(o.errno, ERRNO_SENTINEL, \"decoding failure: errno untouched\");\n\n    // ---- verify mismatches: errno = EINVAL ----\n    let mismatch = [\n        (\"TS_TRUNC_HASH (31-byte hash decodes fine)\", TS_TRUNC_HASH, 31u64),\n        (\"TS_EXTRA_HASH (33-byte hash)\", TS_EXTRA_HASH, 33),\n        (\"TS_GARBAGE_HASH\", TS_GARBAGE_HASH, 16),\n        (\"TS_LANES2_OK_FORMAT\", TS_LANES2_OK_FORMAT, 16),\n    ];\n    for (name, s, hashlen) in mismatch {\n        let ctx = format!(\"argon2id_str_verify({name})\");\n        let o = str_verify(&ctx, \"crypto_pwhash_argon2id_str_verify\", s, PW);\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(\n            o.errno, EINVAL,\n            \"{ctx}: ARGON2_VERIFY_MISMATCH must set EINVAL\"\n        );\n        assert_eq!(\n            o.rng, hashlen,\n            \"{ctx}: argon2_hash draws the DECODED hash length\"\n        );\n    }\n\n    // a well-formed string with the wrong password\n    for (sym, s) in [\n        (\"crypto_pwhash_argon2id_str_verify\", TS_ARGON2ID_OK),\n        (\"crypto_pwhash_argon2i_str_verify\", TS_ARGON2I_OK),\n        (\"crypto_pwhash_str_verify\", TS_ARGON2ID_OK),\n        (\"crypto_pwhash_str_verify\", TS_ARGON2I_OK),\n    ] {\n        let ctx = format!(\"{sym} wrong password\");\n        let o = str_verify(&ctx, sym, s, b\"wrong\");\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EINVAL, \"{ctx}: mismatch must set EINVAL\");\n    }\n    // the empty-password string with a non-empty password\n    let o = str_verify(\n        \"emptypw string with a password\",\n        \"crypto_pwhash_argon2id_str_verify\",\n        TS_ARGON2ID_EMPTYPW,\n        PW,\n    );\n    eq_ret(\"emptypw string with a password\", -1, o.rc);\n    assert_eq!(o.errno, EINVAL);\n\n    // ---- passwdlen > PASSWD_MAX -> EFBIG, before `str` is even read ----\n    for sym in [\n        \"crypto_pwhash_argon2i_str_verify\",\n        \"crypto_pwhash_argon2id_str_verify\",\n    ] {\n        let ctx = format!(\"{sym} passwdlen=2^32\");\n        let sb = cs(TS_ARGON2ID_OK);\n        let o = both::<FnStrVerify, _>(&ctx, sym, 0, |f, _p| unsafe {\n            (*f)(\n                sb.as_ptr() as *const c_char,\n                PW.as_ptr() as *const c_char,\n                4294967296,\n            )\n        });\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EFBIG, \"{ctx}: expected EFBIG\");\n        assert_eq!(o.rng, 0);\n    }\n}\n\n/// errors: `_str_needs_rehash` sets `EINVAL` **on decode failure** — the exact\n/// opposite of `_str_verify`.\n#[test]\nfn err_argon2_needs_rehash_errno_discipline() {\n    let bad = [\n        TS_EMPTY,\n        TS_NO_PARAMS,\n        TS_BAD_V18,\n        TS_NO_V,\n        TS_V_PLUS,\n        TS_V_LEADING_ZERO,\n        TS_V_OVERFLOW,\n        TS_M_LEADING_ZERO,\n        TS_M_OVERFLOW,\n        TS_M7,\n        TS_M8_P2,\n        TS_T0,\n        TS_P0,\n        TS_REORDER,\n        TS_EMPTY_SALT,\n        TS_SALT6,\n        TS_BAD_B64_SALT,\n        TS_SHORT_HASH,\n        TS_NO_HASH,\n        TS_B64_PAD,\n        TS_TRAIL_DOLLAR,\n        // a well-formed argon2i string fed to the argon2id needs_rehash\n        TS_ARGON2I_OK,\n    ];\n    for s in bad {\n        let ctx = format!(\"argon2id_str_needs_rehash({s:?})\");\n        let o = needs_rehash(\n            &ctx,\n            \"crypto_pwhash_argon2id_str_needs_rehash\",\n            s,\n            1,\n            8192,\n        );\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(\n            o.errno, EINVAL,\n            \"{ctx}: a decode failure in _needs_rehash MUST set EINVAL\"\n        );\n    }\n    // and the mirror: an argon2id string through the argon2i needs_rehash\n    let o = needs_rehash(\n        \"argon2i_str_needs_rehash(TS_ARGON2ID_OK)\",\n        \"crypto_pwhash_argon2i_str_needs_rehash\",\n        TS_ARGON2ID_OK,\n        1,\n        8192,\n    );\n    eq_ret(\"argon2i_str_needs_rehash(TS_ARGON2ID_OK)\", -1, o.rc);\n    assert_eq!(o.errno, EINVAL);\n\n    // opslimit > UINT32_MAX -> EINVAL\n    for sym in [\n        \"crypto_pwhash_argon2i_str_needs_rehash\",\n        \"crypto_pwhash_argon2id_str_needs_rehash\",\n        \"crypto_pwhash_str_needs_rehash\",\n    ] {\n        let s = if sym.contains(\"argon2i_\") {\n            TS_ARGON2I_OK\n        } else {\n            TS_ARGON2ID_OK\n        };\n        let ctx = format!(\"{sym} opslimit=2^32\");\n        let o = needs_rehash(&ctx, sym, s, 4294967296, 8192);\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n\n        // memlimit / 1024 > UINT32_MAX, i.e. memlimit >= 2^32 * 1024\n        let ctx = format!(\"{sym} memlimit=2^32*1024\");\n        let o = needs_rehash(&ctx, sym, s, 1, 4398046511104);\n        eq_ret(&ctx, -1, o.rc);\n        assert_eq!(o.errno, EINVAL, \"{ctx}: expected EINVAL\");\n    }\n\n    // strlen(str) >= crypto_pwhash_STRBYTES (128) -> EINVAL. A 128-character\n    // string built by padding a valid one.\n    let long = format!(\"{TS_ARGON2ID_OK}{}\", \"X\".repeat(128 - TS_ARGON2ID_OK.len()));\n    assert_eq!(long.len(), 128);\n    let o = needs_rehash(\n        \"needs_rehash strlen=128\",\n        \"crypto_pwhash_argon2id_str_needs_rehash\",\n        &long,\n        1,\n        8192,\n    );\n    eq_ret(\"needs_rehash strlen=128\", -1, o.rc);\n    assert_eq!(o.errno, EINVAL);\n}\n\n/// errors: `_sodium_argon2_ctx` / `_sodium_argon2_validate_inputs` /\n/// `_sodium_argon2_initialize` / `_sodium_argon2_encode_string` /\n/// `_sodium_argon2_decode_string` — paths unreachable from the public API.\n#[test]\nfn err_argon2_internals() {\n    // argon2_ctx with a type outside {Argon2_i, Argon2_id} -> INCORRECT_TYPE\n    for type_ in [0i32, 3, 4, -1, c_int::MAX] {\n        let ctx = format!(\"_sodium_argon2_ctx type={type_}\");\n        let o = argon2_ctx_call(&ctx, 1, 8, 1, 32, PW, &SALT16, None, None, type_);\n        eq_ret(&ctx, ARGON2_INCORRECT_TYPE, o.rc);\n    }\n\n    // argon2_validate_inputs: every pointer/length mismatch\n    let out = [0u8; 32];\n    let scratch = [0x11u8; 32];\n    struct Case {\n        name: &'static str,\n        want: c_int,\n        mutate: fn(&mut Argon2Ctx),\n    }\n    let cases = [\n        Case {\n            name: \"out == NULL\",\n            want: ARGON2_OUTPUT_PTR_NULL,\n            mutate: |c| c.out = ptr::null_mut(),\n        },\n        Case {\n            name: \"outlen < ARGON2_MIN_OUTLEN\",\n            want: ARGON2_OUTPUT_TOO_SHORT,\n            mutate: |c| c.outlen = 15,\n        },\n        Case {\n            name: \"pwd == NULL with pwdlen != 0\",\n            want: ARGON2_PWD_PTR_MISMATCH,\n            mutate: |c| c.pwd = ptr::null_mut(),\n        },\n        Case {\n            name: \"salt == NULL with saltlen != 0\",\n            want: ARGON2_SALT_PTR_MISMATCH,\n            mutate: |c| c.salt = ptr::null_mut(),\n        },\n        Case {\n            name: \"secret == NULL with secretlen != 0\",\n            want: ARGON2_SECRET_PTR_MISMATCH,\n            mutate: |c| c.secretlen = 8,\n        },\n        Case {\n            name: \"ad == NULL with adlen != 0\",\n            want: ARGON2_AD_PTR_MISMATCH,\n            mutate: |c| c.adlen = 8,\n        },\n        Case {\n            name: \"saltlen < ARGON2_MIN_SALT_LENGTH\",\n            want: ARGON2_SALT_TOO_SHORT,\n            mutate: |c| c.saltlen = 7,\n        },\n        Case {\n            name: \"lanes < ARGON2_MIN_LANES\",\n            want: ARGON2_LANES_TOO_FEW,\n            mutate: |c| c.lanes = 0,\n        },\n        Case {\n            name: \"lanes > ARGON2_MAX_LANES\",\n            want: ARGON2_LANES_TOO_MANY,\n            mutate: |c| c.lanes = 16777216,\n        },\n        Case {\n            name: \"m_cost < ARGON2_MIN_MEMORY\",\n            want: ARGON2_MEMORY_TOO_LITTLE,\n            mutate: |c| c.m_cost = 7,\n        },\n        Case {\n            name: \"m_cost < 8 * lanes\",\n            want: ARGON2_MEMORY_TOO_LITTLE,\n            mutate: |c| {\n                c.lanes = 2;\n                c.threads = 2;\n                c.m_cost = 8;\n            },\n        },\n        Case {\n            name: \"t_cost < ARGON2_MIN_TIME\",\n            want: ARGON2_TIME_TOO_SMALL,\n            mutate: |c| c.t_cost = 0,\n        },\n    ];\n    for case in &cases {\n        let ctx = format!(\"validate_inputs({})\", case.name);\n        let o = both::<FnArgon2Validate, _>(\n            &ctx,\n            \"_sodium_argon2_validate_inputs\",\n            0,\n            |f, _p| unsafe {\n                let mut c = Argon2Ctx::zeroed();\n                c.out = out.as_ptr() as *mut u8;\n                c.outlen = 32;\n                c.pwd = PW.as_ptr() as *mut u8;\n                c.pwdlen = 4;\n                c.salt = SALT16.as_ptr() as *mut u8;\n                c.saltlen = 16;\n                c.secret = ptr::null_mut();\n                c.secretlen = 0;\n                c.ad = ptr::null_mut();\n                c.adlen = 0;\n                c.t_cost = 1;\n                c.m_cost = 8;\n                c.lanes = 1;\n                c.threads = 1;\n                (case.mutate)(&mut c);\n                (*f)(&c)\n            },\n        );\n        eq_ret(&ctx, case.want, o.rc);\n    }\n    // context == NULL\n    let o = both::<FnArgon2Validate, _>(\n        \"validate_inputs(NULL)\",\n        \"_sodium_argon2_validate_inputs\",\n        0,\n        |f, _p| unsafe { (*f)(ptr::null()) },\n    );\n    eq_ret(\"validate_inputs(NULL)\", ARGON2_INCORRECT_PARAMETER, o.rc);\n    let _ = scratch;\n\n    // argon2_initialize(NULL, NULL) -> INCORRECT_PARAMETER\n    let o = both::<FnArgon2Initialize, _>(\n        \"argon2_initialize(NULL, NULL)\",\n        \"_sodium_argon2_initialize\",\n        0,\n        |f, _p| unsafe { (*f)(ptr::null_mut(), ptr::null_mut()) },\n    );\n    eq_ret(\n        \"argon2_initialize(NULL, NULL)\",\n        ARGON2_INCORRECT_PARAMETER,\n        o.rc,\n    );\n\n    // encode_string: dst_len too small for a LITERAL section -> ENCODING_FAIL.\n    // (When the shortfall lands on a base64 section instead, `sodium_bin2base64`\n    // calls `sodium_misuse()`; see `err_argon2_encode_string_b64_overflow`.)\n    for dst_len in [1usize, 5, 12, 13, 20, 25] {\n        let ctx = format!(\"encode_string dst_len={dst_len}\");\n        let o = both::<FnArgon2Encode, _>(&ctx, \"_sodium_argon2_encode_string\", dst_len, |f, p| unsafe {\n            let mut c = Argon2Ctx::zeroed();\n            c.out = out.as_ptr() as *mut u8;\n            c.outlen = 32;\n            c.salt = SALT16.as_ptr() as *mut u8;\n            c.saltlen = 16;\n            c.t_cost = 1;\n            c.m_cost = 8;\n            c.lanes = 1;\n            c.threads = 1;\n            (*f)(p as *mut c_char, dst_len, &mut c, ARGON2ID13)\n        });\n        eq_ret(&ctx, ARGON2_ENCODING_FAIL, o.rc);\n    }\n    // encode_string with an unknown type -> ENCODING_FAIL (checked before\n    // validate_inputs)\n    for type_ in [0i32, 3, -1] {\n        let ctx = format!(\"encode_string type={type_}\");\n        let o = both::<FnArgon2Encode, _>(&ctx, \"_sodium_argon2_encode_string\", 256, |f, p| unsafe {\n            let mut c = Argon2Ctx::zeroed();\n            c.out = out.as_ptr() as *mut u8;\n            c.outlen = 32;\n            c.salt = SALT16.as_ptr() as *mut u8;\n            c.saltlen = 16;\n            c.t_cost = 1;\n            c.m_cost = 8;\n            c.lanes = 1;\n            c.threads = 1;\n            (*f)(p as *mut c_char, 256, &mut c, type_)\n        });\n        eq_ret(&ctx, ARGON2_ENCODING_FAIL, o.rc);\n    }\n\n    // decode_string with an unknown type -> INCORRECT_TYPE\n    for type_ in [0i32, 3, -1] {\n        let ctx = format!(\"decode_string type={type_}\");\n        let o = both::<FnArgon2Decode, _>(&ctx, \"_sodium_argon2_decode_string\", 0, |f, _p| unsafe {\n            let sb = cs(TS_ARGON2ID_OK);\n            let mut dsalt = [0u8; 64];\n            let mut dout = [0u8; 64];\n            let mut c = Argon2Ctx::zeroed();\n            c.salt = dsalt.as_mut_ptr();\n            c.saltlen = 64;\n            c.out = dout.as_mut_ptr();\n            c.outlen = 64;\n            (*f)(&mut c, sb.as_ptr() as *const c_char, type_)\n        });\n        eq_ret(&ctx, AR