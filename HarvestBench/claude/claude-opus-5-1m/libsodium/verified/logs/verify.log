mmon.h\"\n40\t\n41\tstatic inline void\n42\tblkcpy(uint32_t *dest, const uint32_t *src, size_t len)\n43\t{\n44\t    memcpy(dest, src, len * 64);\n45\t}\n46\t\n47\tstatic inline void\n48\tblkxor(uint32_t *dest, const uint32_t *src, size_t len)\n49\t{\n50\t    size_t i;\n51\t\n52\t    for (i = 0; i < len * 16; i++) {\n53\t        dest[i] ^= src[i];\n54\t    }\n55\t}\n56\t\n57\t/*\n58\t * salsa20_8(B):\n59\t * Apply the salsa20/8 core to the provided block.\n60\t */\n61\tstatic void\n62\tsalsa20_8(uint32_t B[16])\n63\t{\n64\t    uint32_t x[16];\n65\t    size_t   i;\n66\t\n67\t    blkcpy(x, B, 1);\n68\t    for (i = 0; i < 8; i += 2) {\n69\t#define R(a, b) (((a) << (b)) | ((a) >> (32 - (b))))\n70\t        /* Operate on columns. */\n71\t        x[4] ^= R(x[0] + x[12], 7);\n72\t        x[8] ^= R(x[4] + x[0], 9);\n73\t        x[12] ^= R(x[8] + x[4], 13);\n74\t        x[0] ^= R(x[12] + x[8], 18);\n75\t\n76\t        x[9] ^= R(x[5] + x[1], 7);\n77\t        x[13] ^= R(x[9] + x[5], 9);\n78\t        x[1] ^= R(x[13] + x[9], 13);\n79\t        x[5] ^= R(x[1] + x[13], 18);\n80\t\n81\t        x[14] ^= R(x[10] + x[6], 7);\n82\t        x[2] ^= R(x[14] + x[10], 9);\n83\t        x[6] ^= R(x[2] + x[14], 13);\n84\t        x[10] ^= R(x[6] + x[2], 18);\n85\t\n86\t        x[3] ^= R(x[15] + x[11], 7);\n87\t        x[7] ^= R(x[3] + x[15], 9);\n88\t        x[11] ^= R(x[7] + x[3], 13);\n89\t        x[15] ^= R(x[11] + x[7], 18);\n90\t\n91\t        /* Operate on rows. */\n92\t        x[1] ^= R(x[0] + x[3], 7);\n93\t        x[2] ^= R(x[1] + x[0], 9);\n94\t        x[3] ^= R(x[2] + x[1], 13);\n95\t        x[0] ^= R(x[3] + x[2], 18);\n96\t\n97\t        x[6] ^= R(x[5] + x[4], 7);\n98\t        x[7] ^= R(x[6] + x[5], 9);\n99\t        x[4] ^= R(x[7] + x[6], 13);\n100\t        x[5] ^= R(x[4] + x[7], 18);\n101\t\n102\t        x[11] ^= R(x[10] + x[9], 7);\n103\t        x[8] ^= R(x[11] + x[10], 9);\n104\t        x[9] ^= R(x[8] + x[11], 13);\n105\t        x[10] ^= R(x[9] + x[8], 18);\n106\t\n107\t        x[12] ^= R(x[15] + x[14], 7);\n108\t        x[13] ^= R(x[12] + x[15], 9);\n109\t        x[14] ^= R(x[13] + x[12], 13);\n110\t        x[15] ^= R(x[14] + x[13], 18);\n111\t#undef R\n112\t    }\n113\t    for (i = 0; i < 16; i++) {\n114\t        B[i] += x[i];\n115\t    }\n116\t}\n117\t\n118\t/*\n119\t * blockmix_salsa8(Bin, Bout, X, r):\n120\t * Compute Bout = BlockMix_{salsa20/8, r}(Bin).\n121\t * The input Bin must be 128r bytes in length;\n122\t * The output Bout must also be the same size.\n123\t * The temporary space X must be 64 bytes.\n124\t */\n125\tstatic void\n126\tblockmix_salsa8(const uint32_t *Bin, uint32_t *Bout, uint32_t *X, size_t r)\n127\t{\n128\t    size_t i;\n129\t\n130\t    /* 1: X <-- B_{2r - 1} */\n131\t    blkcpy(X, &Bin[(2 * r - 1) * 16], 1);\n132\t\n133\t    /* 2: for i = 0 to 2r - 1 do */\n134\t    for (i = 0; i < 2 * r; i += 2) {\n135\t        /* 3: X <-- H(X \\xor B_i) */\n136\t        blkxor(X, &Bin[i * 16], 1);\n137\t        salsa20_8(X);\n138\t\n139\t        /* 4: Y_i <-- X */\n140\t        /* 6: B' <-- (Y_0, Y_2 ... Y_{2r-2}, Y_1, Y_3 ... Y_{2r-1}) */\n141\t        blkcpy(&Bout[i * 8], X, 1);\n142\t\n143\t        /* 3: X <-- H(X \\xor B_i) */\n144\t        blkxor(X, &Bin[i * 16 + 16], 1);\n145\t        salsa20_8(X);\n146\t\n147\t        /* 4: Y_i <-- X */\n148\t        /* 6: B' <-- (Y_0, Y_2 ... Y_{2r-2}, Y_1, Y_3 ... Y_{2r-1}) */\n149\t        blkcpy(&Bout[i * 8 + r * 16], X, 1);\n150\t    }\n151\t}\n152\t\n153\t/*\n154\t * integerify(B, r):\n155\t * Return the result of parsing B_{2r-1} as a little-endian integer.\n156\t */\n157\tstatic inline uint64_t\n158\tintegerify(const uint32_t *B, size_t r)\n159\t{\n160\t    const uint32_t *X = B + (2 * r - 1) * 16;\n161\t\n162\t    return ((uint64_t) (X[1]) << 32) + X[0];\n163\t}\n164\t\n165\t/*\n166\t * smix(B, r, N, V, XY):\n167\t * Compute B = SMix_r(B, N).  The input B must be 128r bytes in length;\n168\t * the temporary storage V must be 128rN bytes in length; the temporary\n169\t * storage XY must be 256r + 64 bytes in length.  The value N must be a\n170\t * power of 2 greater than 1.  The arrays B, V, and XY must be aligned to a\n171\t * multiple of 64 bytes.\n172\t */\n173\tstatic void\n174\tsmix(uint8_t *B, size_t r, uint64_t N, uint32_t *V, uint32_t *XY)\n175\t{\n176\t    uint32_t *X = XY;\n177\t    uint32_t *Y = &XY[32 * r];\n178\t    uint32_t *Z = &XY[64 * r];\n179\t    uint64_t  i;\n180\t    uint64_t  j;\n181\t    size_t    k;\n182\t\n183\t    /* 1: X <-- B */\n184\t    for (k = 0; k < 32 * r; k++) {\n185\t        X[k] = LOAD32_LE(&B[4 * k]);\n186\t    }\n187\t    /* 2: for i = 0 to N - 1 do */\n188\t    for (i = 0; i < N; i += 2) {\n189\t        /* 3: V_i <-- X */\n190\t        blkcpy(&V[i * (32 * r)], X, 2 * r);\n191\t\n192\t        /* 4: X <-- H(X) */\n193\t        blockmix_salsa8(X, Y, Z, r);\n194\t\n195\t        /* 3: V_i <-- X */\n196\t        blkcpy(&V[(i + 1) * (32 * r)], Y, 2 * r);\n197\t\n198\t        /* 4: X <-- H(X) */\n199\t        blockmix_salsa8(Y, X, Z, r);\n200\t    }\n201\t\n202\t    /* 6: for i = 0 to N - 1 do */\n203\t    for (i = 0; i < N; i += 2) {\n204\t        /* 7: j <-- Integerify(X) mod N */\n205\t        j = integerify(X, r) & (N - 1);\n206\t\n207\t        /* 8: X <-- H(X \\xor V_j) */\n208\t        blkxor(X, &V[j * (32 * r)], 2 * r);\n209\t        blockmix_salsa8(X, Y, Z, r);\n210\t\n211\t        /* 7: j <-- Integerify(X) mod N */\n212\t        j = integerify(Y, r) & (N - 1);\n213\t\n214\t        /* 8: X <-- H(X \\xor V_j) */\n215\t        blkxor(Y, &V[j * (32 * r)], 2 * r);\n216\t        blockmix_salsa8(Y, X, Z, r);\n217\t    }\n218\t    /* 10: B' <-- X */\n219\t    for (k = 0; k < 32 * r; k++) {\n220\t        STORE32_LE(&B[4 * k], X[k]);\n221\t    }\n222\t}\n223\t\n224\t/*\n225\t * escrypt_kdf(local, passwd, passwdlen, salt, saltlen,\n226\t *     N, r, p, buf, buflen):\n227\t * Compute scrypt(passwd[0 .. passwdlen - 1], salt[0 .. saltlen - 1], N, r,\n228\t * p, buflen) and write the result into buf.  The parameters r, p, and buflen\n229\t * must satisfy r * p < 2^30 and buflen <= (2^32 - 1) * 32.  The parameter N\n230\t * must be a power of 2 greater than 1.\n231\t *\n232\t * Return 0 on success; or -1 on error.\n233\t */\n234\tint\n235\tescrypt_kdf_nosse(escrypt_local_t *local, const uint8_t *passwd,\n236\t                  size_t passwdlen, const uint8_t *salt, size_t saltlen,\n237\t                  uint64_t N, uint32_t _r, uint32_t _p, uint8_t *buf,\n238\t                  size_t buflen)\n239\t{\n240\t    size_t    B_size, V_size, XY_size, need;\n241\t    uint8_t * B;\n242\t    uint32_t *V, *XY;\n243\t    size_t    r = _r, p = _p;\n244\t    uint32_t  i;\n245\t\n246\t/* Sanity-check parameters. */\n247\t#if SIZE_MAX > UINT32_MAX\n248\t    if (buflen > (((uint64_t)(1) << 32) - 1) * 32) {\n249\t        errno = EFBIG;\n250\t        return -1;\n251\t    }\n252\t#endif\n253\t    if ((uint64_t)(r) * (uint64_t)(p) >= ((uint64_t) 1 << 30)) {\n254\t        errno = EFBIG;\n255\t        return -1;\n256\t    }\n257\t    if (N > UINT32_MAX) {\n258\t        errno = EFBIG;\n259\t        return -1;\n260\t    }\n261\t    if (((N & (N - 1)) != 0) || (N < 2)) {\n262\t        errno = EINVAL;\n263\t        return -1;\n264\t    }\n265\t    if (r == 0 || p == 0) {\n266\t        errno = EINVAL;\n267\t        return -1;\n268\t    }\n269\t    if ((r > SIZE_MAX / 128 / p) ||\n270\t#if SIZE_MAX / 256 <= UINT32_MAX\n271\t        (r > SIZE_MAX / 256) ||\n272\t#endif\n273\t        (N > SIZE_MAX / 128 / r)) {\n274\t        errno = ENOMEM;\n275\t        return -1;\n276\t    }\n277\t\n278\t    /* Allocate memory. */\n279\t    B_size = (size_t) 128 * r * p;\n280\t    V_size = (size_t) 128 * r * (size_t) N;\n281\t    need   = B_size + V_size;\n282\t    if (need < V_size) {\n283\t        errno = ENOMEM;\n284\t        return -1;\n285\t    }\n286\t    XY_size = (size_t) 256 * r + 64;\n287\t    need += XY_size;\n288\t    if (need < XY_size) {\n289\t        errno = ENOMEM;\n290\t        return -1;\n291\t    }\n292\t    if (local->size < need) {\n293\t        if (escrypt_free_region(local)) {\n294\t            return -1;\n295\t        }\n296\t        if (!escrypt_alloc_region(local, need)) {\n297\t            return -1;\n298\t        }\n299\t    }\n300\t    B  = (uint8_t *) local->aligned;\n301\t    V  = (uint32_t *) ((uint8_t *) B + B_size);\n302\t    XY = (uint32_t *) ((uint8_t *) V + V_size);\n303\t\n304\t    /* 1: (B_0 ... B_{p-1}) <-- PBKDF2(P, S, 1, p * MFLen) */\n305\t    escrypt_PBKDF2_SHA256(passwd, passwdlen, salt, saltlen, 1, B, B_size);\n306\t\n307\t    /* 2: for i = 0 to p - 1 do */\n308\t    for (i = 0; i < p; i++) {\n309\t        /* 3: B_i <-- MF(B_i, N) */\n310\t        smix(&B[(size_t) 128 * i * r], r, N, V, XY);\n311\t    }\n312\t\n313\t    /* 5: DK <-- PBKDF2(P, B, 1, dkLen) */\n314\t    escrypt_PBKDF2_SHA256(passwd, passwdlen, B, B_size, 1, buf, buflen);\n315\t\n316\t    /* Success! */\n317\t    return 0;\n318\t}\n319\t"}]},"parent_tool_use_id":"toolu_bdrk_01FJHFWSbs1nb51qZda9ZhQ1","session_id":"d07924e0-d479-4dd8-8d3b-8728ce2d0a77","uuid":"7118ffcb-0de9-44d4-84d7-2a95fd845bcb","timestamp":"2026-08-23T08:08:34.216Z","subagent_type":"general-purpose","task_description":"Phase A tables: crypto_pwhash"}
