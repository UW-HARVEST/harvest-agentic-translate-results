     c >>= 8;\n313\t    }\n314\t}\n315\t\n316\tvoid\n317\tsodium_add(unsigned char *a, const unsigned char *b, const size_t len)\n318\t{\n319\t    size_t        i;\n320\t    uint_fast16_t c = 0U;\n321\t\n322\t#ifdef HAVE_AMD64_ASM\n323\t    uint64_t t64, t64_2, t64_3;\n324\t    uint32_t t32;\n325\t\n326\t    if (len == 12U) {\n327\t        __asm__ __volatile__(\n328\t            \"movq (%[in]), %[t64] \\n\"\n329\t            \"movl 8(%[in]), %[t32] \\n\"\n330\t            \"addq %[t64], (%[out]) \\n\"\n331\t            \"adcl %[t32], 8(%[out]) \\n\"\n332\t            : [t64] \"=&r\"(t64), [t32] \"=&r\"(t32)\n333\t            : [in] \"S\"(b), [out] \"D\"(a)\n334\t            : \"memory\", \"flags\", \"cc\");\n335\t        return;\n336\t    } else if (len == 24U) {\n337\t        __asm__ __volatile__(\n338\t            \"movq (%[in]), %[t64] \\n\"\n339\t            \"movq 8(%[in]), %[t64_2] \\n\"\n340\t            \"movq 16(%[in]), %[t64_3] \\n\"\n341\t            \"addq %[t64], (%[out]) \\n\"\n342\t            \"adcq %[t64_2], 8(%[out]) \\n\"\n343\t            \"adcq %[t64_3], 16(%[out]) \\n\"\n344\t            : [t64] \"=&r\"(t64), [t64_2] \"=&r\"(t64_2), [t64_3] \"=&r\"(t64_3)\n345\t            : [in] \"S\"(b), [out] \"D\"(a)\n346\t            : \"memory\", \"flags\", \"cc\");\n347\t        return;\n348\t    } else if (len == 8U) {\n349\t        __asm__ __volatile__(\n350\t            \"movq (%[in]), %[t64] \\n\"\n351\t            \"addq %[t64], (%[out]) \\n\"\n352\t            : [t64] \"=&r\"(t64)\n353\t            : [in] \"S\"(b), [out] \"D\"(a)\n354\t            : \"memory\", \"flags\", \"cc\");\n355\t        return;\n356\t    }\n357\t#endif\n358\t    for (i = 0U; i < len; i++) {\n359\t        c += (uint_fast16_t) a[i] + (uint_fast16_t) b[i];\n360\t        a[i] = (unsigned char) c;\n361\t        c >>= 8;\n362\t    }\n363\t}\n364\t\n365\tvoid\n366\tsodium_sub(unsigned char *a, const unsigned char *b, const size_t len)\n367\t{\n368\t    uint_fast16_t c = 0U;\n369\t