{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HNMSMUDLeoBacTV8ZHPxPE","type":"tool_result","content":"1\t//! `sodium/utils.c`\n2\t//!\n3\t//! With no `HAVE_*` macros defined:\n4\t//!  * `HAVE_ALIGNED_MALLOC` is **not** defined (needs WINAPI_DESKTOP, or\n5\t//!    MAP_ANON+HAVE_MMAP, or HAVE_POSIX_MEMALIGN) so `sodium_malloc()` is the\n6\t//!    plain `malloc()` variant, `sodium_free()` is `free()`, and\n7\t//!    `sodium_mprotect_*()` all set `ENOSYS` and return -1.\n8\t//!  * `HAVE_WEAK_SYMBOLS` is not defined, so `sodium_memzero()` uses the\n9\t//!    volatile byte loop and the `_sodium_dummy_symbol_*` helpers are absent.\n10\t//!  * `HAVE_C_VARARRAYS`/`HAVE_ALLOCA` are not defined, so `sodium_stackzero()`\n11\t//!    has an empty body.\n12\t//!  * `HAVE_MLOCK` is not defined, so mlock/munlock set `ENOSYS`, return -1.\n13\t\n14\tuse core::ffi::{c_int, c_void};\n15\tuse core::ptr;\n16\t\n17\tuse crate::common::{ENOMEM, ENOSYS, SIZE_MAX, free, malloc, set_errno};\n18\tuse crate::sodium::core::sodium_misuse;\n19\t\n20\tconst CANARY_SIZE: usize = 16;\n21\tconst GARBAGE_VALUE: u8 = 0xdb;\n22\t\n23\tstatic mut CANARY: [u8; CANARY_SIZE] = [0; CANARY_SIZE];\n24\t\n25\t#[unsafe(no_mangle)]\n26\tpub unsafe extern \"C\" fn sodium_memzero(pnt: *mut c_void, len: usize) {\n27\t    let pnt_ = pnt as *mut u8;\n28\t    let mut i: usize = 0;\n29\t    while i < len {\n30\t        unsafe { ptr::write_volatile(pnt_.add(i), 0u8) };\n31\t        i += 1;\n32\t    }\n33\t}\n34\t\n35\t#[unsafe(no_mangle)]\n36\tpub extern \"C\" fn sodium_stackzero(_len: usize) {\n37\t    // HAVE_C_VARARRAYS / HAVE_ALLOCA undefined -> empty body\n38\t}\n39\t\n40\t#[unsafe(no_mangle)]\n41\tpub unsafe extern \"C\" fn sodium_memcmp(b1_: *const c_void, b2_: *const c_void, len: usize) -> c_int {\n42\t    let b1 = b1_ as *const u8;\n43\t    let b2 = b2_ as *const u8;\n44\t    let mut d: u8 = 0;\n45\t    for i in 0..len {\n46\t        d |= unsafe { ptr::read_volatile(b1.add(i)) ^ ptr::read_volatile(b2.add(i)) };\n47\t    }\n48\t    (1 & ((d as c_int).wrapping_sub(1) >> 8)) - 1\n49\t}\n50\t\n51\t#[unsafe(no_mangle)]\n52\tpub unsafe extern \"C\" fn sodium_compare(b1_: *const u8, b2_: *const u8, len: usize) -> c_int {\n53\t    let mut gt: u8 = 0;\n54\t    let mut eq: u8 = 1;\n55\t    let mut i = len;\n56\t    while i != 0 {\n57\t        i -= 1;\n58\t        let x1 = unsafe { ptr::read_volatile(b1_.add(i)) } as u16;\n59\t        let x2 = unsafe { ptr::read_volatile(b2_.add(i)) } as u16;\n60\t        gt |= (((x2 as u32).wrapping_sub(x1 as u32) >> 8) as u8) & eq;\n61\t        eq &= ((((x2 ^ x1) as u32).wrapping_sub(1)) >> 8) as u8;\n62\t    }\n63\t    ((gt as c_int) + (gt as c_int) + (eq as c_int)) - 1\n64\t}\n65\t\n66\t#[unsafe(no_mangle)]\n67\tpub unsafe extern \"C\" fn sodium_is_zero(n: *const u8, nlen: usize) -> c_int {\n68\t    let mut d: u8 = 0;\n69\t    for i in 0..nlen {\n70\t        d |= unsafe { *n.add(i) };\n71\t    }\n72\t    1 & ((d as c_int).wrapping_sub(1) >> 8)\n73\t}\n74\t\n75\t#[unsafe(no_mangle)]\n76\tpub unsafe extern \"C\" fn sodium_increment(n: *mut u8, nlen: usize) {\n77\t    let mut c: usize = 1;\n78\t    for i in 0..nlen {\n79\t        c += unsafe { *n.add(i) } as usize;\n80\t        unsafe { *n.add(i) = c as u8 };\n81\t        c >>= 8;\n82\t    }\n83\t}\n84\t\n85\t#[unsafe(no_mangle)]\n86\tpub unsafe extern \"C\" fn sodium_add(a: *mut u8, b: *const u8, len: usize) {\n87\t    let mut c: usize = 0;\n88\t    for i in 0..len {\n89\t        c += unsafe { *a.add(i) } as usize + unsafe { *b.add(i) } as usize;\n90\t        unsafe { *a.add(i) = c as u8 };\n91\t        c >>= 8;\n92\t    }\n93\t}\n94\t\n95\t#[unsafe(no_mangle)]\n96\tpub unsafe extern \"C\" fn sodium_sub(a: *mut u8, b: *const u8, len: usize) {\n97\t    // uint_fast16_t on x86-64 glibc is unsigned long (64-bit); the sequence\n98\t    // c = a[i] - b[i] - c; a[i] = (uchar) c; c = (c >> 8) & 1;\n99\t    // is width independent because only the low bit of (c >> 8) is kept