{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01SEHNNUQNSyDVPH9XRngPvH","type":"tool_result","content":"1\t//! Differential comparison in a forked child.\n2\t//!\n3\t//! Some inputs are fatal to the C library — it dereferences a NULL, walks off the\n4\t//! end of a buffer, or reaches `PNG_ABORT()`.  Those are still *observations*\n5\t//! that the Rust translation has to reproduce, so each side of the comparison is\n6\t//! run in its own `fork()`ed child: the parent then compares the exit status, the\n7\t//! terminating signal, and everything the child wrote (its event trace plus\n8\t//! whatever the library printed on stdout/stderr).\n9\t#![allow(dead_code)]\n10\t\n11\tuse super::*;\n12\tuse core::ffi::c_int;\n13\tuse std::io::Write;\n14\tuse std::os::unix::io::AsRawFd;\n15\t\n16\textern \"C\" {\n17\t    fn fork() -> i32;\n18\t    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;\n19\t    fn _exit(code: i32) -> !;\n20\t    fn dup2(old: i32, new: i32) -> i32;\n21\t}\n22\t\n23\t#[derive(PartialEq, Eq, Debug, Clone)]\n24\tpub struct ChildResult {\n25\t    /// `Some(exit code)`, or `None` if the child died from a signal.\n26\t    pub exit: Option<i32>,\n27\t    pub signal: i32,\n28\t    pub text: String,\n29\t}\n30\t\n31\tpub fn scratch_dir() -> std::path::PathBuf {\n32\t    let d = std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"target/forked\");\n33\t    let _ = std::fs::create_dir_all(&d);\n34\t    d\n35\t}\n36\t\n37\tstatic SEQ: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);\n38\t\n39\t/// Run `body` in a forked child and capture everything it produced.\n40\tpub fn run_in_child(body: &mut dyn FnMut() -> String) -> ChildResult {\n41\t    let n = SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n42\t    let path = scratch_dir().join(format!(\"c{}-{}.txt\", std::process::id(), n));\n43\t    let _ = std::fs::remove_file(&path);\n44\t    let pid = unsafe { fork() };\n45\t    assert!(pid >= 0, \"fork failed\");\n46\t    if pid == 0 {\n47\t        // ---- child ----\n48\t        let f = std::fs::OpenOptions::new()\n49\t            .create(true)\n50\t            .append(true)\n51\t            .open(&path)\n52\t            .expect(\"open capture file\");\n53\t        let fd = f.as_raw_fd();\n54\t        unsafe {\n55\t            dup2(fd, 1);\n56\t            dup2(fd, 2);\n57\t        }\n58\t        let mut state = Box::new(Tls::default());\n59\t        set_tls(&mut *state as *mut Tls);\n60\t        let r = body();\n61\t        let mut out = String::new();\n62\t        for e in &state.trace {\n63\t            out.push_str(e);\n64\t            out.push('\\n');\n65\t        }\n66\t        out.push_str(\"=> \");\n67\t        out.push_str(&r);\n68\t        out.push('\\n');\n69\t        let mut g = std::fs::OpenOptions::new()\n70\t            .append(true)\n71\t            .open(&path)\n72\t            .expect(\"reopen capture file\");\n73\t        let _ = g.write_all(out.as_bytes());\n74\t        let _ = g.flush();\n75\t        drop(g);\n76\t        unsafe { _exit(0) }\n77\t    }\n78\t    // ---- parent ----\n79\t    let mut status = 0i32;\n80\t    let r = unsafe { waitpid(pid, &mut status, 0) };\n81\t    assert_eq!(r, pid, \"waitpid\");\n82\t    let text = std::fs::read(&path)\n83\t        .map(|b| String::from_utf8_lossy(&b).into_owned())\n84\t        .unwrap_or_default();\n85\t    let _ = std::fs::remove_file(&path);\n86\t    if status & 0x7f == 0 {\n87\t        ChildResult {\n88\t            exit: Some((status >> 8) & 0xff),\n89\t            signal: 0,\n90\t            text,\n91\t        }\n92\t    } else {\n93\t        ChildResult {\n94\t            exit: None,\n95\t            signal: status & 0x7f,\n96\t            text,\n97\t        }\n98\t    }\n99\t}\n100\t\n101\tpub static FORKED_CASES: std::sync::atomic::AtomicUsize =\n102\t    std::sync::atomic::AtomicUsize::new(0);\n103\t\n104\t/// Run `f` for both libraries, each in its own child, and require the same\n105\t/// result — including dying from the same signal.\n106\t#[track_caller]\n107\tpub fn assert_same_forked<F>(case: &str, f: F)\n108\twhere\n109\t    F: Fn(&Api) -> String,\n110\t{\n111\t    let l = libs();\n112\t    let mut res = Vec::new();\n113\t    for api in [&l.c, &l.rust] {\n114\t        res.push(run_in_child(&mut || {\n115\t            set_cur_api(api as *const Api);\n116\t            f(api)\n117\t        }));\n118\t    }\n119\t    FORKED_CASES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n120\t    assert!(\n121\t        res[0] == res[1],\n122\t        \"forked case `{}` diverged\\n  C   : exit={:?} signal={} text={:?}\\n  Rust: exit={:?} signal={} text={:?}\",\n123\t        case,\n124\t        res[0].exit,\n125\t        res[0].signal,\n126\t        res[0].text,\n127\t        res[1].exit,\n128\t        res[1].signal,\n129\t        res[1].text\n130\t    );\n131\t}\n132\t\n133\t/// The common shape: create a struct, run `body` under the error trap, report.\n134\tpub fn guarded_in_child(\n135\t    api: &Api,\n136\t    write: bool,\n137\t    body: &mut dyn FnMut(&Api, *mut PngStruct, *mut PngInfo),\n138\t) -> String {\n139\t    unsafe {\n140\t        let (png, info) = if write { new_write(api) } else { new_read(api) };\n141\t        let g = guarded(api, png, &mut || body(api, png, info));\n142\t        let extra = format!(\"{:?} out={} bytes\", g, tls().output.len());\n143\t        // NB: no destroy -- the child is about to _exit and the struct may be in\n144\t        // an undefined state after a fatal error, exactly as in a real crash.\n145\t        let _ = (png, info);\n146\t        extra\n147\t    }\n148\t}\n149\t\n150\tpub const _UNUSED_FORKED: c_int = 0;\n151\t"}]},"parent_tool_use_id":"toolu_bdrk_01UP6NJVScwKVWsWLKn6DXBk","session_id":"309de29f-cb7a-4138-9016-7ab2e7ef6079","uuid":"88bb25a8-40cc-42e4-89dc-1e00c70bd0b3","timestamp":"2026-08-23T02:53:27.173Z","subagent_type":"general-purpose","task_description":"Write high-level API