274\t    if (transforms & PNG_TRANSFORM_SHIFT) != 0 {\n275\t        if ((*info_ptr).valid & PNG_INFO_sBIT) != 0 {\n276\t            png_set_shift(png_ptr, core::ptr::addr_of!((*info_ptr).sig_bit));\n277\t        }\n278\t    }\n279\t\n280\t    /* Flip the RGB pixels to BGR (or RGBA to BGRA) */\n281\t    if (transforms & PNG_TRANSFORM_BGR) != 0 {\n282\t        png_set_bgr(png_ptr);\n283\t    }\n284\t\n285\t    /* Swap the RGBA or GA data to ARGB or AG (or BGRA to ABGR) */\n286\t    if (transforms & PNG_TRANSFORM_SWAP_ALPHA) != 0 {\n287\t        png_set_swap_alpha(png_ptr);\n288\t    }\n289\t\n290\t    /* Swap bytes of 16-bit files to least significant byte first */\n291\t    if (transforms & PNG_TRANSFORM_SWAP_ENDIAN) != 0 {\n292\t        png_set_swap(png_ptr);\n293\t    }\n294\t\n295\t    /* Added at libpng-1.2.41 */\n296\t    /* Invert the alpha channel from opacity to transparency */\n297\t    if (transforms & PNG_TRANSFORM_INVERT_ALPHA) != 0 {\n298\t        png_set_invert_alpha(png_ptr);\n299\t    }\n300\t\n301\t    /* Added at libpng-1.2.41 */\n302\t    /* Expand grayscale image to RGB */\n303\t    if (transforms & PNG_TRANSFORM_GRAY_TO_RGB) != 0 {\n304\t        png_set_gray_to_rgb(png_ptr);\n305\t    }\n306\t\n307\t    /* Added at libpng-1.5.4 */\n308\t    if (transforms & PNG_TRANSFORM_EXPAND_16) != 0 {\n309\t        png_set_expand_16(png_ptr);\n310\t    }\n311\t\n312\t    /* We don't handle adding filler bytes */\n313\t\n314\t    /* We use png_read_image and rely on that for interlace handling, but we also\n315\t     * call png_read_update_info therefore must turn on interlace handling now:\n316\t     */\n317\t    png_set_interlace_handling(png_ptr);\n318\t\n319\t    /* Optional call to gamma correct and add the background to the palette\n320\t     * and update info structure.  REQUIRED if you are expecting libpng to\n321\t     * update the palette for you (i.e., you selected such a transform above).\n322\t     */\n323\t    png_read_update_info(png_ptr, info_p