{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PM8QTWRSD4K8bFGp9EGJfo","type":"tool_result","content":"1\t//! The public libpng ABI types, transcribed from `c_src/include/png.h`.\n2\t//!\n3\t//! These are the *caller's* view of the ABI: the differential tests are an\n4\t//! ordinary external consumer of the shared library, so they only ever use the\n5\t//! types png.h exposes.  `png_struct` / `png_info` are opaque.\n6\t#![allow(non_snake_case, non_camel_case_types, non_upper_case_globals, dead_code)]\n7\t\n8\tuse core::ffi::{c_char, c_int, c_long, c_uint, c_ulong, c_void};\n9\t\n10\t/// Opaque `png_struct`.\n11\t#[repr(C)]\n12\tpub struct PngStruct {\n13\t    _opaque: [u8; 0],\n14\t}\n15\t/// Opaque `png_info`.\n16\t#[repr(C)]\n17\tpub struct PngInfo {\n18\t    _opaque: [u8; 0],\n19\t}\n20\t/// Opaque `jmp_buf` (glibc x86-64: 200 bytes).\n21\t#[repr(C)]\n22\t#[derive(Clone, Copy)]\n23\tpub struct JmpBuf(pub [u64; 25]);\n24\t\n25\t#[repr(C)]\n26\t#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]\n27\tpub struct Tm {\n28\t    pub tm_sec: c_int,\n29\t    pub tm_min: c_int,\n30\t    pub tm_hour: c_int,\n31\t    pub tm_mday: c_int,\n32\t    pub tm_mon: c_int,\n33\t    pub tm_year: c_int,\n34\t    pub tm_wday: c_int,\n35\t    pub tm_yday: c_int,\n36\t    pub tm_isdst: c_int,\n37\t    pub tm_gmtoff: c_long,\n38\t    pub tm_zone: *const c_char,\n39\t}\n40\t\n41\t#[repr(C)]\n42\t#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]\n43\tpub struct png_color {\n44\t    pub red: u8,\n45\t    pub green: u8,\n46\t    pub blue: u8,\n47\t}\n48\t\n49\t#[repr(C)]\n50\t#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]\n51\tpub struct png_color_16 {\n52\t    pub index: u8,\n53\t    pub red: u16,\n54\t    pub green: u16,\n55\t    pub blue: u16,\n56\t    pub gray: u16,\n57\t}\n58\t\n59\t#[repr(C)]\n60\t#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]\n61\tpub struct png_color_8 {\n62\t    pub red: u8,\n63\t    pub green: u8,\n64\t    pub blue: u8,\n65\t    pub gray: u8,\n66\t    pub alpha: u8,\n67\t}\n68\t\n69\t#[repr(C)]\n70\t#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]\n71\tpub struct png_sPLT_entry {\n72\t    pub red: u16,\n73\t    pub green: u16,\n74\t    pub blue: u16,\n75\t    pub alpha: u16,\n76\t    pub frequency: u16,\n77\t}\n78\t\n79\t#[repr(C)]\n80\t#[derive(Clone, Copy)]\n81\tpub struct png_sPLT_t {\n82\t    pub name: *mut c_char,\n83\t    pub depth: u8,\n84\t    pub entries: *mut png_sPLT_entry,\n85\t    pub nentries: i32,\n86\t}\n87\t\n88\t#[repr(C)]\n89\t#[derive(Clone, Copy)]\n90\tpub struct png_text {\n91\t    pub compression: c_int,\n92\t    pub key: *mut c_char,\n93\t    pub text: *mut c_char,\n94\t    pub text_length: usize,\n95\t    pub itxt_length: usize,\n96\t    pub lang: *mut c_char,\n97\t    pub lang_key: *mut c_char,\n98\t}\n99\t\n100\t#[repr(C)]\n101\t#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]\n102\tpub struct png_time {\n103\t    pub year: u16,\n104\t    pub month: u8,\n105\t    pub day: u8,\n106\t    pub hour: u8,\n107\t    pub minute: u8,\n108\t    pub second: u8,\n109\t}\n110\t\n111\t#[repr(C)]\n112\t#[derive(Clone, Copy)]\n113\tpub struct png_unknown_chunk {\n114\t    pub name: [u8; 5],\n115\t    pub data: *mut u8,\n116\t    pub size: usize,\n117\t    pub location: u8,\n118\t}\n119\t\n120\t#[repr(C)]\n121\t#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]\n122\tpub struct png_row_info {\n123\t    pub width: u32,\n124\t    pub rowbytes: usize,\n125\t    pub color_type: u8,\n126\t    pub bit_depth: u8,\n127\t    pub channels: u8,\n128\t    pub pixel_depth: u8,\n129\t}\n130\t\n131\t#[repr(C)]\n132\t#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]\n133\tpub struct png_xy {\n134\t    pub redx: i32,\n135\t    pub redy: i32,\n136\t    pub greenx: i32,\n137\t    pub greeny: i32,\n138\t    pub bluex: i32,\n139\t    pub bluey: i32,\n140\t    pub whitex: i32,\n141\t    pub whitey: i32,\n142\t}\n143\t\n144\t#[repr(C)]\n145\t#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]\n146\tpub struct png_XYZ {\n147\t    pub red_X: i32,\n148\t    pub red_Y: i32,\n149\t    pub red_Z: i32,\n150\t    pub green_X: i32,\n151\t    pub green_Y: i32,\n152\t    pub green_Z: i32,\n153\t    pub blue_X: i32,\n154\t    pub blue_Y: i32,\n155\t    pub blue_Z: i32,\n156\t}\n157\t\n158\t#[repr(C)]\n159\t#[derive(Clone, Copy)]\n160\tpub struct png_image {\n161\t    pub opaque: *mut c_void,\n162\t    pub version: u32,\n163\t    pub width: u32,\n164\t    pub height: u32,\n165\t    pub format: u32,\n166\t    pub flags: u32,\n167\t    pub colormap_entries: u32,\n168\t    pub warning_or_error: u32,\n169\t    pub message: [c_char; 64],\n170\t}\n171\t\n172\timpl Default for png_image {\n173\t    fn default() -> Self {\n174\t        png_image {\n175\t            opaque: core::ptr::null_mut(),\n176\t            version: 0,\n177\t            width: 0,\n178\t            height: 0,\n179\t            format: 0,\n180\t            flags: 0,\n181\t            colormap_entries: 0,\n182\t            warning_or_error: 0,\n183\t            message: [0; 64],\n184\t        }\n185\t    }\n186\t}\n187\t\n188\tpub type png_error_ptr = Option<unsafe extern \"C\" fn(*mut PngStruct, *const c_char)>;\n189\tpub type png_rw_ptr = Option<unsafe extern \"C\" fn(*mut PngStruct, *mut u8, usize)>;\n190\tpub type png_flush_ptr = Option<unsafe extern \"C\" fn(*mut PngStruct)>;\n191\tpub type png_read_status_ptr = Option<unsafe extern \"C\" fn(*mut PngStruct, u32, c_int)>;\n192\tpub type png_write_status_ptr = Option<unsafe extern \"C\" fn(*mut PngStruct, u32, c_int)>;\n193\tpub type png_progressive_info_ptr = Option<unsafe extern \"C\" fn(*mut PngStruct, *mut PngInfo)>;\n194\tpub type png_progressive_end_ptr = Option<unsafe extern \"C\" fn(*mut PngStruct, *mut PngInfo)>;\n195\tpub type png_progressive_row_ptr =\n196\t    Option<unsafe extern \"C\" fn(*mut PngStruct, *mut u8, u32, c_int)>;\n197\tpub type png_user_transform_ptr =\n198\t    Option<unsafe extern \"C\" fn(*mut PngS