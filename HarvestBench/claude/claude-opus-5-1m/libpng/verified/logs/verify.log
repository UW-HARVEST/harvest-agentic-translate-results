lost,\n53\t     * or abandoned.  It was only to support some internal back-door access\n54\t     * to png_struct) in libpng-1.4.x.\n55\t     */\n56\t    png_app_warning(\n57\t        png_ptr,\n58\t        b\"png_process_data_skip is not implemented in any current version of libpng\\0\".as_ptr()\n59\t            as png_const_charp,\n60\t    );\n61\t    0\n62\t}\n63\t\n64\t/* What we do with the incoming data depends on what we were previously\n65\t * doing before we ran out of data...\n66\t */\n67\t/* png_process_some_data */\n68\t#[unsafe(no_mangle)]\n69\tpub unsafe extern \"C\" fn png_process_some_data(png_ptr: png_structrp, info_ptr: png_inforp) {\n70\t    if png_ptr == core::ptr::null_mut() {\n71\t        return;\n72\t    }\n73\t\n74\t    match (*png_ptr).process_mode {\n75\t        PNG_READ_SIG_MODE => {\n76\t            png_push_read_sig(png_ptr, info_ptr);\n77\t        }\n78\t\n79\t        PNG_READ_CHUNK_MODE => {\n80\t            png_push_read_chunk(png_ptr, info_ptr);\n81\t        }\n82\t\n83\t        PNG_READ_IDAT_MODE => {\n84\t            png_push_read_IDAT(png_ptr);\n85\t        }\n86\t\n87\t        _ => {\n88\t            (*png_ptr).buffer_size = 0;\n89\t        }\n90\t    }\n91\t}\n92\t\n93\t/* Read any remaining signature bytes from the stream and compare them with\n94\t * the correct PNG signature.  It is possible that this routine is called\n95\t * with bytes already read from the signature, either because they have been\n96\t * checked by the calling application, or because of multiple calls to this\n97\t * routine.\n98\t */\n99\t/* png_push_read_sig */\n100\t#[unsafe(no_mangle)]\n101\tpub unsafe extern \"C\" fn png_push_read_sig(png_ptr: png_structrp, info_ptr: png_inforp) {\n102\t    let num_checked: usize = (*png_ptr).sig_bytes as usize; /* SAFE, does not exceed 8 */\n103\t    let mut num_to_check: usize = 8 - num_checked;\n104\t\n105\t    if (*png_ptr).buffer_size < num_to_check {\n106\t        num_to_check = (*png_ptr).buffer_size;\n107\t    }