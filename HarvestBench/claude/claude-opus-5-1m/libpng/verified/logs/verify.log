, *mut u8)>;\n199\tpub type png_user_chunk_ptr =\n200\t    Option<unsafe extern \"C\" fn(*mut PngStruct, *mut png_unknown_chunk) -> c_int>;\n201\tpub type png_longjmp_ptr = Option<unsafe extern \"C\" fn(*mut JmpBuf, c_int)>;\n202\tpub type png_malloc_ptr = Option<unsafe extern \"C\" fn(*mut PngStruct, usize) -> *mut c_void>;\n203\tpub type png_free_ptr = Option<unsafe extern \"C\" fn(*mut PngStruct, *mut c_void)>;\n204\t\n205\t/* ------------------------------------------------------------------ */\n206\t/* png.h constants                                                     */\n207\t/* ------------------------------------------------------------------ */\n208\t\n209\tpub const PNG_LIBPNG_VER_STRING: &[u8] = b\"1.6.59.git\\0\";\n210\t\n211\tpub const PNG_COLOR_MASK_PALETTE: c_int = 1;\n212\tpub const PNG_COLOR_MASK_COLOR: c_int = 2;\n213\tpub const PNG_COLOR_MASK_ALPHA: c_int = 4;\n214\t\n215\tpub const PNG_COLOR_TYPE_GRAY: c_int = 0;\n216\tpub const PNG_COLOR_TYPE_PALETTE: c_int = 3;\n217\tpub const PNG_COLOR_TYPE_RGB: c_int = 2;\n218\tpub const PNG_COLOR_TYPE_RGB_ALPHA: c_int = 6;\n219\tpub const PNG_COLOR_TYPE_GRAY_ALPHA: c_int = 4;\n220\t\n221\tpub const PNG_COMPRESSION_TYPE_BASE: c_int = 0;\n222\tpub const PNG_FILTER_TYPE_BASE: c_int = 0;\n223\tpub const PNG_INTRAPIXEL_DIFFERENCING: c_int = 64;\n224\tpub const PNG_INTERLACE_NONE: c_int = 0;\n225\tpub const PNG_INTERLACE_ADAM7: c_int = 1;\n226\tpub const PNG_INTERLACE_LAST: c_int = 2;\n227\t\n228\tpub const PNG_NO_FILTERS: c_int = 0x00;\n229\tpub const PNG_FILTER_NONE: c_int = 0x08;\n230\tpub const PNG_FILTER_SUB: c_int = 0x10;\n231\tpub const PNG_FILTER_UP: c_int = 0x20;\n232\tpub const PNG_FILTER_AVG: c_int = 0x40;\n233\tpub const PNG_FILTER_PAETH: c_int = 0x80;\n234\tpub const PNG_FAST_FILTERS: c_int = PNG_FILTER_NONE | PNG_FILTER_SUB | PNG_FILTER_UP;\n235\tpub const PNG_ALL_FILTERS: c_int = PNG_FAST_FILTERS | PNG_FILTER_AVG | PNG_FILTER_PAETH;\n236\t\n237\tpub const PNG_FILTER_VALUE_NONE: c_int = 0;\n238\tpub