{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LsdCV3kJE1vSum9xYHcUmr","type":"tool_result","content":"1\t//! Differential comparison in a forked child.\n2\t//!\n3\t//! Some inputs are fatal to the C library — it dereferences a NULL, walks off the\n4\t//! end of a buffer, or reaches `PNG_ABORT()`.  Those are still *observations*\n5\t//! that the Rust translation has to reproduce, so each side of the comparison is\n6\t//! run in its own `fork()`ed child: the parent then compares the exit status, the\n7\t//! terminating signal, and everything the child wrote (its event trace plus\n8\t//! whatever the library printed on stdout/stderr).\n9\t#![allow(dead_code)]\n10\t\n11\tuse super::*;\n12\tuse core::ffi::c_int;\n13\tuse std::io::Write;\n14\tuse std::os::unix::io::AsRawFd;\n15\t\n16\textern \"C\" {\n17\t    fn fork() -> i32;\n18\t    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;\n19\t    fn _exit(code: i32) -> !;\n20\t    fn dup2(old: i32, new: i32) -> i32;\n21\t}\n22\t\n23\t#[derive(PartialEq, Eq, Debug, Clone)]\n24\tpub struct ChildResult {\n25\t    /// `Some(exit code)`, or `None` if the child died from a signal.\n26\t    pub exit: Option<i32>,\n27\t    pub signal: i32,\n28\t    pub text: String,\n29\t}\n30\t\n31\tpub fn scratch_dir() -> std::path::PathBuf {\n32\t    let d = std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"target/forked\");\n33\t    let _ = std::fs::create_dir_all(&d);\n34\t    d\n35\t}\n36\t\n37\tstatic SEQ: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);\n38\t\n39\t/// Run `body` in a forked child and capture everything it produced.\n40\tpub fn run_in_child(body: &mut dyn FnMut() -> String) -> ChildResult {\n41\t    // Make sure every process-global lazy singleton is fully initialised *before*\n42\t    // the fork, so the child never has to take a lock another thread may have been\n43\t    // holding at the instant of the fork.\n44\t    let _ = libs();\n45\t    let n = SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n46\t    let path = scratch_dir().join(format!(\"c{}-{}.txt\", std::process::id(), n));\n47\t    let _ = std::fs::remove_file(&path);\n48\t    let pid = unsafe { fork() };\n49\t    assert!(pid >= 0, \"fork failed\");\n50\t    if pid == 0 {\n51\t        // ---- child ----\n52\t        IN_FORKED_CHILD.store(true, std::sync::atomic::Ordering::Relaxed);\n53\t        let f = std::fs::OpenOptions::new()\n54\t            .create(true)\n55\t            .append(true)\n56\t            .open(&path)\n57\t            .expect(\"open capture file\");\n58\t        let fd = f.as_raw_fd();\n59\t        unsafe {\n60\t            dup2(fd, 1);\n61\t            dup2(fd, 2);\n62\t        }\n63\t        let mut state = Box::new(Tls::default());\n64\t        set_tls(&mut *state as *mut Tls);\n65\t        let r = body();\n66\t        let mut out = String::new();\n67\t        for e in &state.trace {\n68\t            out.push_str(e);\n69\t            out.push('\\n');\n70\t        }\n71\t        out.push_str(\"=> \");\n72\t        out.push_str(&r);\n73\t        out.push('\\n');\n74\t        let mut g = std::fs::OpenOptions::new()\n75\t            .append(true)\n76\t            .open(&path)\n77\t            .expect(\"reopen capture file\");\n78\t        let _ = g.write_all(out.as_bytes());\n79\t        let _ = g.flush();\n80\t        drop(g);\n81\t        unsafe { _exit(0) }\n82\t    }\n83\t    // ---- parent ----\n84\t    let mut status = 0i32;\n85\t    let r = unsafe { waitpid(pid, &mut status, 0) };\n86\t    assert_eq!(r, pid, \"waitpid\");\n87\t    let text = std::fs::read(&path)\n88\t        .map(|b| String::from_utf8_lossy(&b).into_owned())\n89\t        .unwrap_or_default();\n90\t    let _ = std::fs::remove_file(&path);\n91\t    if status & 0x7f == 0 {\n92\t        ChildResult {\n93\t            exit: Some((status >> 8) & 0xff),\n94\t            signal: 0,\n95\t            text,\n96\t        }\n97\t    } else {\n98\t        ChildResult {\n99\t            exit: None,\n100\t            signal: status & 0x7f,\n101\t            text,\n102\t        }\n103\t    }\n104\t}\n105\t\n106\tpub static FORKED_CASES: std::sync::atomic::AtomicUsize =\n107\t    std::sync::atomic::AtomicUsize::new(0);\n108\t\n109\t/// Run `f` for both libraries, each in its own child, and require the same\n110\t/// result — including dying from the same signal.\n111\t#[track_caller]\n112\tpub fn assert_same_forked<F>(case: &str, f: F)\n113\twhere\n114\t    F: Fn(&Api) -> String,\n115\t{\n116\t    let l = libs();\n117\t    let mut res = Vec::new();\n118\t    for api in [&l.c, &l.rust] {\n119\t        res.push(run_in_child(&mut || {\n120\t            set_cur_api(api as *const Api);\n121\t            f(api)\n122\t        }));\n123\t    }\n124\t    FORKED_CASES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n125\t    assert!(\n126\t        res[0] == res[1],\n127\t        \"forked case `{}` diverged\\n  C   : exit={:?} signal={} text={:?}\\n  Rust: exit={:?} signal={} text={:?}\",\n128\t        case,\n129\t        res[0].exit,\n130\t        res[0].signal,\n131\t        res[0].text,\n132\t        res[1].exit,\n133\t        res[1].signal,\n134\t        res[1].text\n135\t    );\n136\t}\n137\t\n138\t/// The common shape: create a struct, run `body` under the error trap, report.\n139\tpub fn guarded_in_child(\n140\t    api: &Api,\n141\t    write: bool,\n142\t    body: &mut dyn FnMut(&Api, *mut PngStruct, *mut PngInfo),\n143\t) -> String {\n144\t    unsafe {\n145\t        let (png, info) = if write { new_write(api) } else { new_read(api) };\n146\t        let g = guarded(api, png, &mut || body(api, png, info));\n147\t        let extra = format!(\"{:?} out={} bytes\", g, tls().output.len());\n148\t        // NB: no destroy -- the child is about to _exit and the struct may be in\n149\t        // an undefined state after a fatal error, exactly as in a real crash.\n150\t        let _ = (png, info);\n151\t        extra\n152\t    }\n153\t}\n154\t\n155\tpub const _UNUSED_FORKED: c_int = 0;\n156\t"}]},"parent_tool_use_id":"toolu_bdrk_01Q2LumuFA2ZNcudyRk6z47M","session_id":"309de29f-cb7a-4138-9016-7ab2e7ef6079","uuid":"fbdd3a6d-7442-47ce-af3e-cbbee5cf9794","timestamp":"2026-08-23T04:02:22.692Z","subagent_type":"general-purpose","task_description":"Close remaining error-surface gaps"}
