\t                o.push(format!(\"guard={:?}\", wr.guard));\n241\t                o.output = wr.bytes.clone();\n242\t                o\n243\t            });\n244\t        }\n245\t    }\n246\t    for mem_level in [1, 2, 5, 8, 9] {\n247\t        for wbits in [8, 9, 11, 14, 15] {\n248\t            let opts = WriteOpts {\n249\t                mem_level: Some(mem_level),\n250\t                window_bits: Some(wbits),\n251\t                ..Default::default()\n252\t            };\n253\t            assert_same(\n254\t                &format!(\"mem_level={} window_bits={}\", mem_level, wbits),\n255\t                |api| unsafe {\n256\t                    let mut o = Outcome::default();\n257\t                    let wr = write_plain(api, &img, &opts);\n258\t                    o.push(format!(\"guard={:?}\", wr.guard));\n259\t                    o.output = wr.bytes.clone();\n260\t                    o\n261\t                },\n262\t            );\n263\t        }\n264\t    }\n265\t    // out-of-range values: libpng clamps them and warns\n266\t    for (tag, opts) in [\n267\t        (\n268\t            \"level=-2\",\n269\t            WriteOpts {\n270\t                level: Some(-2),\n271\t                ..Default::default()\n272\t            },\n273\t        ),\n274\t        (\n275\t            \"level=10\",\n276\t            WriteOpts {\n277\t                level: Some(10),\n278\t                ..Default::default()\n279\t            },\n280\t        ),\n281\t        (\n282\t            \"strategy=5\",\n283\t            WriteOpts {\n284\t                strategy: Some(5),\n285\t                ..Default::default()\n286\t            },\n287\t        ),\n288\t        (\n289\t            \"mem_level=0\",\n290\t            WriteOpts {\n291\t                mem_level: Some(0),\n292\t                ..Default::default()\n293\t            },\n294\t        ),\n295\t        (\n296\t            \"mem_level=10\",\n297\t            WriteOpts {\n298\t                mem_level: Some(1