{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Eqfa61ebnThZGNv1emNrrD","type":"tool_result","content":"1\t//! Differential-test harness.\n2\t//!\n3\t//! Both libraries under test are loaded with `libloading::Library::new` and\n4\t//! driven **only** through their exported symbols (see `api.rs`, which is\n5\t//! generated from `c_src/include/png.h` + `c_src/include/pngpriv.h` and covers\n6\t//! all 384 exported symbols).  No Rust function is ever called directly, so the\n7\t//! `#[no_mangle]` export wrappers are exercised too.\n8\t#![allow(dead_code)]\n9\t\n10\tpub mod api;\n11\tpub mod forked;\n12\tpub mod helpers;\n13\tpub mod sweep;\n14\tpub mod types;\n15\t\n16\t#[allow(unused_imports)]\n17\tpub use api::{Api, API_NAMES};\n18\t#[allow(unused_imports)]\n19\tpub use forked::*;\n20\t#[allow(unused_imports)]\n21\tpub use helpers::*;\n22\tpub use types::*;\n23\t\n24\tuse core::ffi::{c_char, c_int, c_void};\n25\tuse std::path::{Path, PathBuf};\n26\tuse std::sync::OnceLock;\n27\t\n28\t/* ------------------------------------------------------------------ */\n29\t/* library discovery + loading                                         */\n30\t/* ------------------------------------------------------------------ */\n31\t\n32\tfn crate_root() -> PathBuf {\n33\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n34\t}\n35\t\n36\t/// `target/<profile>/` of the currently running test binary.\n37\tfn target_profile_dir() -> PathBuf {\n38\t    let exe = std::env::current_exe().expect(\"current_exe\");\n39\t    // .../target/<profile>/deps/<test>-<hash>\n40\t    exe.parent()\n41\t        .and_then(Path::parent)\n42\t        .expect(\"target/<profile>\")\n43\t        .to_path_buf()\n44\t}\n45\t\n46\tfn c_so_path() -> PathBuf {\n47\t    crate_root().join(\"c_src/build/libpng.so\")\n48\t}\n49\t\n50\tfn rust_so_path() -> PathBuf {\n51\t    let p = target_profile_dir().join(\"liblibpng.so\");\n52\t    if p.exists() {\n53\t        return p;\n54\t    }\n55\t    for prof in [\"release\", \"debug\"] {\n56\t        let q = crate_root().join(\"target\").join(prof).join(\"liblibpng.so\");\n57\t        if q.exists() {\n58\t            return q;\n59\t        }\n60\t    }\n61\t    p\n62\t}\n63\t\n64\tfn shim_so_path() -> PathBuf {\n65\t    target_profile_dir().join(\"libpngharness.so\")\n66\t}\n67\t\n68\tfn build_shim() -> PathBuf {\n69\t    let out = shim_so_path();\n70\t    let src = crate_root().join(\"tests/common/shim.c\");\n71\t    let fresh = std::fs::metadata(&out)\n72\t        .and_then(|a| a.modified())\n73\t        .ok()\n74\t        .zip(std::fs::metadata(&src).and_then(|a| a.modified()).ok())\n75\t        .map(|(o, s)| o >= s)\n76\t        .unwrap_or(false);\n77\t    if !fresh {\n78\t        let tmp = out.with_extension(format!(\"so.{}\", std::process::id()));\n79\t        let st = std::process::Command::new(\"cc\")\n80\t            .args([\"-O1\", \"-fPIC\", \"-shared\", \"-o\"])\n81\t            .arg(&tmp)\n82\t            .arg(&src)\n83\t            .status()\n84\t            .expect(\"cc (needed to build the test's setjmp shim)\");\n85\t        assert!(st.success(), \"failed to compile {}\", src.display());\n86\t        let _ = std::fs::rename(&tmp, &out);\n87\t    }\n88\t    out\n89\t}\n90\t\n91\t/// `cargo test` does not necessarily rebuild a `cdylib`-only lib target, so make\n92\t/// sure we are never silently testing a stale artefact.\n93\tfn assert_fresh(so: &Path) {\n94\t    let so_mtime = std::fs::metadata(so).and_then(|m| m.modified()).unwrap();\n95\t    let mut newest = so_mtime;\n96\t    let mut newest_path = so.to_path_buf();\n97\t    let mut stack = vec![crate_root().join(\"src\")];\n98\t    while let Some(d) = stack.pop() {\n99\t        let Ok(rd) = std::fs::read_dir(&d) else { continue };\n100\t        for e in rd.flatten() {\n101\t            let p = e.path();\n102\t            if p.is_dir() {\n103\t                stack.push(p);\n104\t            } else if let Ok(m) = e.metadata().and_then(|m| m.modified()) {\n105\t                if m > newest {\n106\t                    newest = m;\n107\t                    newest_path = p;\n108\t                }\n109\t            }\n110\t        }\n111\t    }\n112\t    assert!(\n113\t        newest <= so_mtime,\n114\t        \"{} is older than {} -- run `cargo build --release` first \\\n115\t         (cargo test does not rebuild a cdylib-only lib target)\",\n116\t        so.display(),\n117\t        newest_path.display()\n118\t    );\n119\t}\n120\t\n121\tpub struct Shim {\n122\t    pub run: unsafe extern \"C\" fn(\n123\t        set_longjmp_fn: *mut c_void,\n124\t        png_ptr: *mut PngStruct,\n125\t        body: unsafe extern \"C\" fn(*mut c_void),\n126\t        arg: *mut c_void,\n127\t    ) -> c_int,\n128\t    pub last_error: unsafe extern \"C\" fn() -> *const c_char,\n129\t    pub error_fn: unsafe extern \"C\" fn(*mut PngStruct, *const c_char),\n130\t    pub jmp_buf_size: unsafe extern \"C\" fn() -> usize,\n131\t    _lib: &'static libloading::Library,\n132\t}\n133\t\n134\tpub struct Libs {\n135\t    pub c: Api,\n136\t    pub rust: Api,\n137\t    pub shim: Shim,\n138\t}\n139\t\n140\t/// SAFETY: every field is either a plain function pointer or a pointer into a\n141\t/// permanently mapped, read-only section of a dlopen'd library; both are safe to\n142\t/// read from any thread.\n143\tunsafe impl Send for Libs {}\n144\tunsafe impl Sync for Libs {}\n145\t\n146\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n147\t\n148\tpub fn libs() -> &'static Libs {\n149\t    let _ = root_pid();\n150\t    LIBS.get_or_init(|| unsafe {\n151\t        let cp = c_so_path();\n152\t        assert!(\n153\t            cp.exists(),\n154\t            \"C reference library not built: {}\\n\\\n155\t             build it with:\\n  cd c_src && mkdir -p build && cd build && \\\n156\t             cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\",\n157\t            cp.display()\n158\t        );\n159\t        let rp = rust_so_path();\n160\t        assert!(rp.exists(), \"Rust cdylib not built: {}\", rp.display());\n161\t        assert_fresh(&rp);\n162\t\n163\t        // `c_src/CMakeLists.txt` links only zlib, so the reference `libpng.so`\n164\t        // leaves `floor`/`pow`/`log`/... undefined and relies on the *program*\n165\t        // pulling in libm.  A Rust test binary does not necessarily do that, so\n166\t        // publish libm into the global symbol scope first.  (Without this the C\n167\t        // library dies with `symbol lookup error: undefined symbol: floor` the\n168\t        // first time a gamma computation runs.)\n169\t        {\n170\t            use libloading::os::unix as u;\n171\t            let m = u::Library::open(Some(\"libm.so.6\"), 0x2 /*RTLD_NOW*/ | 0x100 /*RTLD_GLOBAL*/)\n172\t                .expect(\"dlopen libm.so.6 (RTLD_GLOBAL)\");\n173\t            std::mem::forget(m);\n174\t        }\n175\t\n176\t        let cl: &'static libloading::Library =\n177\t            Box::leak(Box::new(libloading::Library::new(&cp).expect(\"dlopen C .so\")));\n178\t        let rl: &'static libloading::Library = Box::leak(Box::new(\n179\t            libloading::Library::new(&rp).expect(\"dlopen Rust .so\"),\n180\t        ));\n181\t        let sp = build_shim();\n182\t        let sl: &'static libloading::Library = Box::leak(Box::new(\n183\t            libloading::Library::new(&sp).expect(\"dlopen shim .so\"),\n184\t        ));\n185\t\n186\t        let shim = Shim {\n187\t            run: *sl.get(b\"harness_run\").unwrap(),\n188\t            last_error: *sl.get(b\"harness_last_error\").unwrap(),\n189\t            error_fn: *sl.get(b\"harness_error_fn\").unwrap(),\n190\t            jmp_buf_size: *sl.get(b\"harness_jmp_buf_size\").unwrap(),\n191\t            _lib: sl,\n192\t        };\n193\t        assert_eq!(\n194\t            (shim.jmp_buf_size)(),\n195\t            200,\n196\t            \"glibc jmp_buf is expected to be 200 bytes on this target\"\n197\t        );\n198\t\n199\t        Libs {\n200\t            c: Api::load(cl, \"C\"),\n201\t            rust: Api::load(rl, \"Rust\"),\n202\t            shim,\n203\t        }\n204\t    })\n205\t}\n206\t\n207\t/* ------------------------------------------------------------------ */\n208\t/* per-thread callback state                                           */\n209\t/* ------------------------------------------------------------------ */\n210\t\n211\t/// State the libpng callbacks operate on.  It is reached through a thread-local\n212\t/// raw pointer rather than `png_get_io_ptr()` so that the very same callback\n213\t/// works for both libraries; a raw pointer (not `RefCell`) because libpng may\n214\t/// `longjmp` out of a callback, which would leave a `RefCell` borrowed forever.\n215\tpub struct Tls {\n216\t    /// Ordered log of everything the library reported / did.\n217\t    pub trace: Vec<String>,\n218\t    /// Bytes the library may read (`png_set_read_fn`).\n219\t    pub input: Vec<u8>,\n220\t    pub in_pos: usize,\n221\t    /// Bytes the library wrote (`png_set_write_fn`).\n222\t    pub output: Vec<u8>,\n223\t    pub flushes: u32,\n224\t    /// Rows handed to / expected from the library.\n225\t    pub rows: Vec<Vec<u8>>,\n226\t    /// Scratch used by user callbacks.\n227\t    pub counter: u64,\n228\t    /// Allocation bookkeeping for the custom allocator test.\n229\t    pub allocs: Vec<(usize, usize)>,\n230\t    pub alloc_serial: u64,\n231\t    /// Set to make the read callback report a short read.\n232\t    pub truncate_reads_at: Option<usize>,\n233\t}\n234\t\n235\timpl Default for Tls {\n236\t    fn default() -> Self {\n237\t        Tls {\n238\t            trace: Vec::new(),\n239\t            input: Vec::new(),\n240\t            in_pos: 0,\n241\t            output: Vec::new(),\n242\t            flushes: 0,\n243\t            rows: Vec::new(),\n244\t            counter: 0,\n245\t            allocs: Vec::new(),\n246\t            alloc_serial: 0,\n247\t            truncate_reads_at: None,\n248\t        }\n249\t    }\n250\t}\n251\t\n252\tthread_local! {\n253\t    static TLS: std::cell::Cell<*mut Tls> = const { std::cell::Cell::new(core::ptr::null_mut()) };\n254\t}\n255\t\n256\tpub fn tls() -> &'static mut Tls {\n257\t    let p = TLS.with(|c| c.get());\n258\t    assert!(!p.is_null(), \"no Tls installed on this thread\");\n259\t    unsafe { &mut *p }\n260\t}\n261\t\n262\tpub fn set_tls(p: *mut Tls) -> *mut Tls {\n263\t    TLS.with(|c| c.replace(p))\n264\t}\n265\t\n266\tpub fn log(s: impl Into<String>) {\n267\t    tls().trace.push(s.into());\n268\t}\n269\t\n270\t/* ------------------------------------------------------------------ */\n271\t/* libpng callbacks (shared by both libraries)                         */\n272\t/* ------------------------------------------------------------------ */\n273\t\n274\tunsafe fn cstr(p: *const c_char) -> String {\n275\t    if p.is_null() {\n276\t        \"<null>\".to_string()\n277\t    } else {\n278\t        std::ffi::CStr::from_ptr(p).to_string_lossy().into_owned()\n279\t    }\n280\t}\n281\t\n282\tpub unsafe extern \"C\" fn warn_cb(_png: *mut PngStruct, msg: *const c_char) {\n283\t    let m = cstr(msg);\n284\t    observe(&m);\n285\t    log(format!(\"warning: {}\", m));\n286\t}\n287\t\n288\tpub unsafe extern \"C\" fn read_cb(png: *mut PngStruct, data: *mut u8, len: usize) {\n289\t    let t = tls();\n290\t    let avail = t.input.len().saturating_sub(t.in_pos);\n291\t    let mut n = len.min(avail);\n292\t    if let Some(limit) = t.truncate_reads_at {\n293\t        if t.in_pos + n > limit {\n294\t            n = limit.saturating_sub(t.in_pos);\n295\t        }\n296\t    }\n297\t    if n > 0 {\n298\t        core::ptr::copy_nonoverlapping(t.input.as_ptr().add(t.in_pos), data, n);\n299\t        t.in_pos += n;\n300\t    }\n301\t    if n < len {\n302\t        // Same behaviour as libpng's own png_default_read_data on a short read.\n303\t        log(format!(\"read_fn: short read ({} of {})\", n, len));\n304\t        let api = CUR_API.with(|c| c.get());\n305\t        assert!(!api.is_null());\n306\t        ((*api).png_error)(png, b\"Read Error\\0\".as_ptr() as *const c_char);\n307\t    }\n308\t}\n309\t\n310\tpub unsafe extern \"C\" fn write_cb(_png: *mut PngStruct, data: *mut u8, len: usize) {\n311\t    let t = tls();\n312\t    t.output.extend_from_slice(core::slice::from_raw_parts(data, len));\n313\t}\n314\t\n315\tpub unsafe extern \"C\" fn flush_cb(_png: *mut PngStruct) {\n316\t    tls().flushes += 1;\n317\t}\n318\t\n319\tpub unsafe extern \"C\" fn read_status_cb(_png: *mut PngStruct, row: u32, pass: c_int) {\n320\t    log(format!(\"read_row_status row={} pass={}\", row, pass));\n321\t}\n322\t\n323\tpub unsafe extern \"C\" fn write_status_cb(_png: *mut PngStruct, row: u32, pass: c_int) {\n324\t    log(format!(\"write_row_status row={} pass={}\", row, pass));\n325\t}\n326\t\n327\tthread_local! {\n328\t    static CUR_API: std::cell::Cell<*const Api> =\n329\t        const { std::cell::Cell::new(core::ptr::null()) };\n330\t}\n331\t\n332\tpub fn set_cur_api(p: *const Api) -> *const Api {\n333\t    CUR_API.with(|c| c.replace(p))\n334\t}\n335\t\n336\tpub fn cur_api() -> &'static Api {\n337\t    let p = CUR_API.with(|c| c.get());\n338\t    assert!(!p.is_null());\n339\t    unsafe { &*p }\n340\t}\n341\t\n342\t/* ------------------------------------------------------------------ */\n343\t/* running a scenario under the libpng error trap                      */\n344\t/* ------------------------------------------------------------------ */\n345\t\n346\tunsafe extern \"C\" fn trampoline(arg: *mut c_void) {\n347\t    let f = arg as *mut &mut dyn FnMut();\n348\t    (*f)();\n349\t}\n350\t\n351\t/// Result of `guarded`.\n352\t#[derive(Debug, Clone, PartialEq, Eq)]\n353\tpub enum Guard {\n354\t    /// The body ran to completion.\n355\t    Ok,\n356\t    /// libpng raised a fatal error with this message.\n357\t    Error(String),\n358\t    /// `png_set_longjmp_fn` returned NULL.\n359\t    NoTrap,\n360\t}\n361\t\n362\t/// Run `body` with a libpng error trap armed on `png_ptr`.\n363\tpub unsafe fn guarded(api: &Api, png_ptr: *mut PngStruct, body: &mut dyn FnMut()) -> Guard {\n364\t    let sh = &libs().shim;\n365\t    let mut b: &mut dyn FnMut() = body;\n366\t    let arg = &mut b as *mut &mut dyn FnMut() as *mut c_void;\n367\t    let r = (sh.run)(\n368\t        api.png_set_longjmp_fn as *mut c_void,\n369\t        png_ptr,\n370\t        trampoline,\n371\t        arg,\n372\t    );\n373\t    match r {\n374\t        0 => Guard::Ok,\n375\t        1 => {\n376\t            let m = cstr((sh.last_error)());\n377\t            observe(&m);\n378\t            Guard::Error(m)\n379\t        }\n380\t        _ => Guard::NoTrap,\n381\t    }\n382\t}\n383\t\n384\t/// Every distinct diagnostic message either library has produced in this process.\n385\t///\n386\t/// `tests/errors.rs` diffs this against `tests/error_sites.txt` (generated from\n387\t/// the C sources by `tools/gen_error_sites.py`) to report which of libpng's\n388\t/// rejection sites the error-path tests have actually reached.\n389\tpub static OBSERVED: std::sync::Mutex<Option<std::collections::BTreeSet<String>>> =\n390\t    std::sync::Mutex::new(None);\n391\t\n392\t/// Set in a `fork()`ed child (see `forked.rs`).  A child must not touch the\n393\t/// process-global `OBSERVED` mutex: if another thread happened to hold it at the\n394\t/// moment of the fork, that lock is held forever in the child's copy of memory\n395\t/// and the child would deadlock.  A child's observations are useless for coverage\n396\t/// anyway -- they live in a separate address space.\n397\tpub static IN_FORKED_CHILD: std::sync::atomic::AtomicBool =\n398\t    std::sync::atomic::AtomicBool::new(false);\n399\t\n400\tpub fn observe(msg: &str) {\n401\t    if IN_FORKED_CHILD.load(std::sync::atomic::Ordering::Relaxed) {\n402\t        // Lock-free path: a forked child may not take a process-global mutex, but\n403\t        // its observations are valuable (the out-of-memory scenarios live there),\n404\t        // so append them straight to this process's file.\n405\t        append_observed(msg);\n406\t        return;\n407\t    }\n408\t    // try_lock, never lock: this runs from inside libpng callbacks and must never\n409\t    // be able to block.\n410\t    if let Ok(mut g) = OBSERVED.try_lock() {\n411\t        if g.get_or_insert_with(Default::default).insert(msg.to_string()) {\n412\t            drop(g);\n413\t            append_observed(msg);\n414\t        }\n415\t    }\n416\t}\n417\t\n418\t/// Where every test binary records the diagnostics it saw, so that\n419\t/// `tools/error_coverage.py` can compute the coverage of the *whole* suite (each\n420\t/// integration test is its own process, so an in-process set only ever sees a\n421\t/// fraction of libpng's error surface).\n422\tpub fn observed_dir() -> PathBuf {\n423\t    let d = crate_root().join(\"target/observed\");\n424\t    let _ = std::fs::create_dir_all(&d);\n425\t    d\n426\t}\n427\t\n428\t/// The pid of the *test process*, captured before any fork, so that a forked\n429\t/// child appends to the same file as its parent instead of creating a new one.\n430\tstatic ROOT_PID: std::sync::OnceLock<u32> = std::sync::OnceLock::new();\n431\t\n432\tpub fn root_pid() -> u32 {\n433\t    *ROOT_PID.get_or_init(std::process::id)\n434\t}\n435\t\n436\tfn append_observed(msg: &str) {\n437\t    use std::io::Write;\n438\t    let p = observed_dir().join(format!(\"{}.txt\", root_pid()));\n439\t    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(p) {\n440\t        let _ = f.write_all(msg.replace('\\n', \" \").as_bytes());\n441\t        let _ = f.write_all(b\"\\n\");\n442\t    }\n443\t}\n444\t\n445\t/// The union of everything every test binary of this run has observed.\n446\tpub fn observed_all() -> std::collections::BTreeSet<String> {\n447\t    let mut set = observed();\n448\t    if let Ok(rd) = std::fs::read_dir(observed_dir()) {\n449\t        for e in rd.flatten() {\n450\t            if let Ok(t) = std::fs::read_to_string(e.path()) {\n451\t                for l in t.lines() {\n452\t                    set.insert(l.to_string());\n453\t                }\n454\t            }\n455\t        }\n456\t    }\n457\t    set\n458\t}\n459\t\n460\tpub fn observed() -> std::collections::BTreeSet<String> {\n461\t    OBSERVED\n462\t        .lock()\n463\t        .unwrap()\n464\t        .clone()\n465\t        .unwrap_or_default()\n466\t}\n467\t\n468\t/* ------------------------------------------------------------------ */\n469\t/* the differential driver                                             */\n470\t/* ------------------------------------------------------------------ */\n471\t\n472\t/// Everything a scenario observed: an ordered event log plus the produced bytes.\n473\t#[derive(Default, Clone, PartialEq, Eq)]\n474\tpub struct Outcome {\n475\t    pub trace: Vec<String>,\n476\t    pub output: Vec<u8>,\n477\t}\n478\t\n479\timpl Outcome {\n480\t    pub fn push(&mut self, s: impl Into<String>) {\n481\t        self.trace.push(s.into());\n482\t    }\n483\t}\n484\t\n485\t/// Run `f` once against the C library and once against the Rust library, each\n486\t/// with a fresh `Tls`, and return the two outcomes.\n487\tpub fn run_both<F>(mut f: F) -> (Outcome, Outcome)\n488\twhere\n489\t    F: FnMut(&Api) -> Outcome,\n490\t{\n491\t    let l = libs();\n492\t    let mut out = Vec::new();\n493\t    for api in [&l.c, &l.rust] {\n494\t        let mut state = Box::new(Tls::default());\n495\t        let prev = set_tls(&mut *state as *mut Tls);\n496\t        let prev_api = set_cur_api(api as *const Api);\n497\t        let mut o = f(api);\n498\t        // The event log the callbacks appended goes first, then whatever the\n499\t        // scenario itself recorded, so that both sides are ordered identically.\n500\t        let mut trace = std::mem::take(&mut state.trace);\n501\t        trace.append(&mut o.trace);\n502\t        o.trace = trace;\n503\t        set_cur_api(prev_api);\n504\t        set_tls(prev);\n505\t        out.push(o);\n506\t    }\n507\t    let b = out.pop().unwrap();\n508\t    let a = out.pop().unwrap();\n509\t    (a, b)\n510\t}\n511\t\n512\tfn hexdump(b: &[u8], from: usize) -> String {\n513\t    let start = from.saturating_sub(16) & !15;\n514\t    let end = (from + 48).min(b.len());\n515\t    let mut s = String::new();\n516\t    let mut i = start;\n517\t    while i < end {\n518\t        s.push_str(&format!(\"{:08x} \", i));\n519\t        for j in i..(i + 16).min(end) {\n520\t            s.push_str(&format!(\"{:02x} \", b[j]));\n521\t        }\n522\t        s.push('\\n');\n523\t        i += 16;\n524\t    }\n525\t    s\n526\t}\n527\t\n528\t/// How many differential comparisons this test binary has performed.\n529\tpub static CASES: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);\n530\t\n531\t/// Assert the two libraries behaved identically for the scenario `f`.\n532\t#[track_caller]\n533\tpub fn assert_same<F>(case: &str, f: F)\n534\twhere\n535\t    F: FnMut(&Api) -> Outcome,\n536\t{\n537\t    let (c, r) = run_both(f);\n538\t    CASES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n539\t    assert!(\n540\t        !c.trace.is_empty() || !c.output.is_empty(),\n541\t        \"case `{}`: the scenario recorded nothing at all -- the test is not \\\n542\t         actually exercising the library\",\n543\t        case\n544\t    );\n545\t    if c.trace != r.trace {\n546\t        let n = c\n547\t            .trace\n548\t            .iter()\n549\t            .zip(r.trace.iter())\n550\t            .position(|(a, b)| a != b)\n551\t            .unwrap_or(c.trace.len().min(r.trace.len()));\n552\t        let ctx = n.saturating_sub(4);\n553\t        let mut msg = format!(\n554\t            \"case `{}`: event traces differ at index {} (C has {} events, Rust has {})\\n\",\n555\t            case,\n556\t            n,\n557\t            c.trace.len(),\n558\t            r.trace.len()\n559\t        );\n560\t        for i in ctx..(n + 6).min(c.trace.len().max(r.trace.len())) {\n561\t            let a = c.trace.get(i).map(String::as_str).unwrap_or(\"<none>\");\n562\t            let b = r.trace.get(i).map(String::as_str).unwrap_or(\"<none>\");\n563\t            msg += &format!(\n564\t                \"  [{}] {} C: {}\\n       {} R: {}\\n\",\n565\t                i,\n566\t                if a == b { ' ' } else { '!' },\n567\t                a,\n568\t                if a == b { ' ' } else { '!' },\n569\t                b\n570\t            );\n571\t        }\n572\t        panic!(\"{}\", msg);\n573\t    }\n574\t    if c.output != r.output {\n575\t        let n = c\n576\t            .output\n577\t            .iter()\n578\t            .zip(r.output.iter())\n579\t            .position(|(a, b)| a != b)\n580\t            .unwrap_or(c.output.len().min(r.output.len()));\n581\t        panic!(\n582\t            \"case `{}`: output bytes differ at offset {} (C {} bytes, Rust {} bytes)\\nC:\\n{}\\nRust:\\n{}\",\n583\t            case,\n584\t            n,\n585\t            c.output.len(),\n586\t            r.output.len(),\n587\t            hexdump(&c.output, n),\n588\t            hexdump(&r.output, n)\n589\t        );\n590\t    }\n591\t}\n592\t\n593\t/* ------------------------------------------------------------------ */\n594\t/* deterministic RNG (no external crates)                              */\n595\t/* ------------------------------------------------------------------ */\n596\t\n597\t/// SplitMix64 — fixed seed, so every failure is reproducible.\n598\tpub struct Rng(pub u64);\n599\t\n600\timpl Rng {\n601\t    pub fn new(seed: u64) -> Rng {\n602\t        Rng(seed ^ 0x9e3779b97f4a7c15)\n603\t    }\n604\t    pub fn next_u64(&mut self) -> u64 {\n605\t        self.0 = self.0.wrapping_add(0x9e3779b97f4a7c15);\n606\t        let mut z = self.0;\n607\t        z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);\n608\t        z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);\n609\t        z ^ (z >> 31)\n610\t    }\n611\t    pub fn u32(&mut self) -> u32 {\n612\t        (self.next_u64() >> 32) as u32\n613\t    }\n614\t    pub fn u8(&mut self) -> u8 {\n615\t        (self.next_u64() >> 56) as u8\n616\t    }\n617\t    /// Uniform in `0..n`.\n618\t    pub fn below(&mut self, n: usize) -> usize {\n619\t        assert!(n > 0);\n620\t        (self.next_u64() % n as u64) as usize\n621\t    }\n622\t    pub fn range(&mut self, lo: i64, hi: i64) -> i64 {\n623\t        assert!(hi > lo);\n624\t        lo + (self.next_u64() % (hi - lo) as u64) as i64\n625\t    }\n626\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n627\t        (0..n).map(|_| self.u8()).collect()\n628\t    }\n629\t    pub fn pick<T: Copy>(&mut self, v: &[T]) -> T {\n630\t        v[self.below(v.len())]\n631\t    }\n632\t    pub fn bool(&mut self) -> bool {\n633\t        self.next_u64() & 1 == 1\n634\t    }\n635\t}\n636\t\n637\t/* ------------------------------------------------------------------ */\n638\t/* small helpers                                                       */\n639\t/* ------------------------------------------------------------------ */\n640\t\n641\tpub fn cs(s: &str) -> std::ffi::CString {\n642\t    std::ffi::CString::new(s).unwrap()\n643\t}\n644\t\n645\tpub const VER: *const c_char = b\"1.6.59.git\\0\".as_ptr() as *const c_char;\n646\t\n647\t/// Create a read struct with the harness error/warning handlers installed.\n648\tpub unsafe fn new_read(api: &Api) -> (*mut PngStruct, *mut PngInfo) {\n649\t    let sh = &libs().shim;\n650\t    let png = (api.png_create_read_struct)(VER, core::ptr::null_mut(), Some(sh.error_fn), Some(warn_cb));\n651\t    assert!(!png.is_null(), \"{}: png_create_read_struct failed\", api.which);\n652\t    let info = (api.png_create_info_struct)(png);\n653\t    assert!(!info.is_null());\n654\t    (png, info)\n655\t}\n656\t\n657\tpub unsafe fn new_write(api: &Api) -> (*mut PngStruct, *mut PngInfo) {\n658\t    let sh = &libs().shim;\n659\t    let png =\n660\t        (api.png_create_write_struct)(VER, core::ptr::null_mut(), Some(sh.error_fn), Some(warn_cb));\n661\t    assert!(!png.is_null(), \"{}: png_create_write_struct failed\", api.which);\n662\t    let info = (api.png_create_info_struct)(png);\n663\t    assert!(!info.is_null());\n664\t    (png, info)\n665\t}\n666\t\n667\tpub unsafe fn destroy_read(api: &Api, png: *mut PngStruct, info: *mut PngInfo) {\n668\t    let mut p = png;\n669\t    let mut i = info;\n670\t    (api.png_destroy_read_struct)(&mut p, &mut i, core::ptr::null_mut());\n671\t}\n672\t\n673\tpub unsafe fn destroy_write(api: &Api, png: *mut PngStruct, info: *mut PngInfo) {\n674\t    let mut p = png;\n675\t    let mut i = info;\n676\t    (api.png_destroy_write_struct)(&mut p, &mut i);\n677\t}\n678\t"}]},"parent_tool_use_id":"toolu_bdrk_01Q2LumuFA2ZNcudyRk6z47M","session_id":"309de29f-cb7a-4138-9016-7ab2e7ef6079","uuid":"6bd6c5ed-0b44-4e7d-b00f-315d69f5e1ab","timestamp":"2026-08-23T04:02:18.409Z","subagent_type":"general-purpose","task_description":"Close remaining error-surface gaps"}
