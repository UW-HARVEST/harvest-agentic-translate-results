12\tpub const PNG_FORMAT_LINEAR_Y_ALPHA: u32 = PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_ALPHA;\n413\tpub const PNG_FORMAT_LINEAR_RGB: u32 = PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_COLOR;\n414\tpub const PNG_FORMAT_LINEAR_RGB_ALPHA: u32 =\n415\t    PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_COLOR | PNG_FORMAT_FLAG_ALPHA;\n416\tpub const PNG_FORMAT_RGB_COLORMAP: u32 = PNG_FORMAT_RGB | PNG_FORMAT_FLAG_COLORMAP;\n417\tpub const PNG_FORMAT_BGR_COLORMAP: u32 = PNG_FORMAT_BGR | PNG_FORMAT_FLAG_COLORMAP;\n418\tpub const PNG_FORMAT_RGBA_COLORMAP: u32 = PNG_FORMAT_RGBA | PNG_FORMAT_FLAG_COLORMAP;\n419\tpub const PNG_FORMAT_ARGB_COLORMAP: u32 = PNG_FORMAT_ARGB | PNG_FORMAT_FLAG_COLORMAP;\n420\tpub const PNG_FORMAT_BGRA_COLORMAP: u32 = PNG_FORMAT_BGRA | PNG_FORMAT_FLAG_COLORMAP;\n421\tpub const PNG_FORMAT_ABGR_COLORMAP: u32 = PNG_FORMAT_ABGR | PNG_FORMAT_FLAG_COLORMAP;\n422\t\n423\tpub const PNG_IMAGE_FLAG_COLORSPACE_NOT_sRGB: u32 = 0x01;\n424\tpub const PNG_IMAGE_FLAG_FAST: u32 = 0x02;\n425\tpub const PNG_IMAGE_FLAG_16BIT_sRGB: u32 = 0x04;\n426\t\n427\tpub const PNG_UINT_31_MAX: u32 = 0x7fffffff;\n428\tpub const PNG_UINT_32_MAX: u32 = 0xffffffff;\n429\tpub const PNG_MAX_PALETTE_LENGTH: c_int = 256;\n430\tpub const PNG_FP_1: c_int = 100000;\n431\tpub const PNG_FP_HALF: c_int = 50000;\n432\tpub const PNG_FP_MAX: i32 = 0x7fffffff;\n433\tpub const PNG_FP_MIN: i32 = -PNG_FP_MAX;\n434\t\n435\tpub const PNG_DEFAULT_sBIT: c_int = 0;\n436\tpub const PNG_GAMMA_THRESHOLD_FIXED: i32 = 5000;\n437\t\n438\t/// `PNG_ROWBYTES` from pngpriv.h\n439\tpub fn png_rowbytes(pixel_bits: usize, width: usize) -> usize {\n440\t    if pixel_bits >= 8 {\n441\t        width * (pixel_bits / 8)\n442\t    } else {\n443\t        (width * pixel_bits + 7) >> 3\n444\t    }\n445\t}\n446\t\n447\tpub fn channels_of(color_type: c_int) -> usize {\n448\t    match color_type {\n449\t        PNG_COLOR_TYPE_GRAY => 1,\n450\t        PNG_COLOR_TYPE_PALETTE => 1,\n451\t        PNG_COLOR_TYPE_RGB => 3,\n452\t        PNG_COLOR_TYPE_GRAY_ALPHA => 2,\n453\t        PNG_COLOR_TYPE_RGB_ALPHA => 4,\n454\t        _ => 0,\n455\t    }\n456\t}\n457\t\n458\t/// The 15 valid (color_type, bit_depth) pairs of the PNG specification.\n459\tpub const VALID_SHAPES: [(c_int, c_int); 15] = [\n460\t    (PNG_COLOR_TYPE_GRAY, 1),\n461\t    (PNG_COLOR_TYPE_GRAY, 2),\n462\t    (PNG_COLOR_TYPE_GRAY, 4),\n463\t    (PNG_COLOR_TYPE_GRAY, 8),\n464\t    (PNG_COLOR_TYPE_GRAY, 16),\n465\t    (PNG_COLOR_TYPE_PALETTE, 1),\n466\t    (PNG_COLOR_TYPE_PALETTE, 2),\n467\t    (PNG_COLOR_TYPE_PALETTE, 4),\n468\t    (PNG_COLOR_TYPE_PALETTE, 8),\n469\t    (PNG_COLOR_TYPE_RGB, 8),\n470\t    (PNG_COLOR_TYPE_RGB, 16),\n471\t    (PNG_COLOR_TYPE_GRAY_ALPHA, 8),\n472\t    (PNG_COLOR_TYPE_GRAY_ALPHA, 16),\n473\t    (PNG_COLOR_TYPE_RGB_ALPHA, 8),\n474\t    (PNG_COLOR_TYPE_RGB_ALPHA, 16),\n475\t];\n476\t\n477\tpub const _UNUSED: (c_uint, c_ulong) = (0, 0);\n478\t"}]},"parent_tool_use_id":"toolu_bdrk_01GWcu9bgbVggeqy4XeSbuyX","session_id":"309de29f-cb7a-4138-9016-7ab2e7ef6079","uuid":"36cbc0c8-bc96-45c8-a891-a0fbcab960cf","timestamp":"2026-08-23T02:56:19.211Z","subagent_type":"general-purpose","task_description":"Write misc/IO/limits tests"}
