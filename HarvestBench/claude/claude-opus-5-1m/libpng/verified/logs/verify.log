        * bits.  Carefully select the smaller and cast it to the type of the\n454\t         * larger - this cannot overflow.  Do not cast in the following test - it\n455\t         * will break on either 16-bit or 64-bit platforms.\n456\t         */\n457\t        if (idat_size as usize) < save_size {\n458\t            save_size = idat_size as usize;\n459\t        } else {\n460\t            idat_size = save_size as png_uint_32;\n461\t        }\n462\t\n463\t        png_calculate_crc(png_ptr, (*png_ptr).save_buffer_ptr, save_size);\n464\t\n465\t        png_process_IDAT_data(png_ptr, (*png_ptr).save_buffer_ptr, save_size);\n466\t\n467\t        (*png_ptr).idat_size = (*png_ptr).idat_size.wrapping_sub(idat_size);\n468\t        (*png_ptr).buffer_size -= save_size;\n469\t        (*png_ptr).save_buffer_size -= save_size;\n470\t        (*png_ptr).save_buffer_ptr = (*png_ptr).save_buffer_ptr.add(save_size);\n471\t    }\n472\t\n473\t    if (*png_ptr).idat_size != 0 && (*png_ptr).current_buffer_size != 0 {\n474\t        let mut save_size: usize = (*png_ptr).current_buffer_size;\n475\t        let mut idat_size: png_uint_32 = (*png_ptr).idat_size;\n476\t\n477\t        /* We want the smaller of 'idat_size' and 'current_buffer_size', but they\n478\t         * are of different types and we don't know which variable has the fewest\n479\t         * bits.  Carefully select the smaller and cast it to the type of the\n480\t         * larger - this cannot overflow.\n481\t         */\n482\t        if (idat_size as usize) < save_size {\n483\t            save_size = idat_size as usize;\n484\t        } else {\n485\t            idat_size = save_size as png_uint_32;\n486\t        }\n487\t\n488\t        png_calculate_crc(png_ptr, (*png_ptr).current_buffer_ptr, save_size);\n489\t\n490\t        png_process_IDAT_data(png_ptr, (*png_ptr).current_buffer_ptr, save_size);\n491\t\n492\t        (*png_ptr).idat_size = (*png_ptr).idat_size.wrapping_sub(idat_size);\n493\t        (*png_ptr).buffer_size -= save