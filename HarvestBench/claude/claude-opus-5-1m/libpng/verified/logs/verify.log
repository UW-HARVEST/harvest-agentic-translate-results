ec<u8> = (0..n).map(|i| (i as u8) ^ 0x55).collect();\n                                (api.png_set_tRNS)(\n                                    png,\n                                    info,\n                                    t.as_ptr(),\n                                    n as c_int,\n                                    core::ptr::null(),\n                                );\n                            }\n                            PNG_COLOR_TYPE_GRAY => {\n                                let c = png_color_16 {\n                                    index: 0,\n                                    red: 0,\n                                    green: 0,\n                                    blue: 0,\n                                    gray: 1,\n                                };\n                                (api.png_set_tRNS)(png, info, core::ptr::null(), 0, &c);\n                            }\n                            _ => {\n                                let c = png_color_16 {\n                                    index: 0,\n                                    red: 1,\n                                    green: 2,\n                                    blue: 3,\n                                    gray: 0,\n                                };\n                                (api.png_set_tRNS)(png, info, core::ptr::null(), 0, &c);\n                            }\n                        }\n                    })\n                    .bytes\n                });\n                for tr in [\n                    vec![Tf::TrnsToAlpha],\n                    vec![Tf::Expand],\n                    vec![Tf::TrnsToAlpha, Tf::Expand16],\n                    vec![Tf::Expand, Tf::Strip16, Tf::Bgr],\n                    vec![Tf::Expand, Tf::GrayToRgb, Tf::Filler(0x11, PNG_FILLER_AFTER)],\n                ] {\n                    let tr2 = tr.clone();\n                    same(\n                        &format!(\"C-137 {} tRNS {:?}\", tag, tr),\n                        |api|