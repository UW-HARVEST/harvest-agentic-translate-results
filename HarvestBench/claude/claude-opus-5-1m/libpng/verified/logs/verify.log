 mut ihdr = Vec::new();\n460\t    ihdr.extend_from_slice(&1u32.to_be_bytes());\n461\t    ihdr.extend_from_slice(&1u32.to_be_bytes());\n462\t    ihdr.extend_from_slice(&[8, 0, 0, 0, 0]);\n463\t    // zlib stream for a single row: filter 0 + one byte, stored (level 0).\n464\t    let raw = [0u8, 0x80u8];\n465\t    let mut z = vec![0x78, 0x01, 0x01, 0x02, 0x00, 0xfd, 0xff];\n466\t    z.extend_from_slice(&raw);\n467\t    let mut adler: (u32, u32) = (1, 0);\n468\t    for &b in &raw {\n469\t        adler.0 = (adler.0 + b as u32) % 65521;\n470\t        adler.1 = (adler.1 + adler.0) % 65521;\n471\t    }\n472\t    z.extend_from_slice(&(((adler.1) << 16) | adler.0).to_be_bytes());\n473\t    let mut v = SIG.to_vec();\n474\t    v.extend_from_slice(&chunk(b\"IHDR\", &ihdr));\n475\t    v.extend_from_slice(&chunk(b\"IDAT\", &z));\n476\t    v.extend_from_slice(&chunk(b\"IEND\", &[]));\n477\t    v\n478\t}\n479\t\n480\t/* ------------------------------------------------------------------ */\n481\t/* misc callbacks used by several test files                           */\n482\t/* ------------------------------------------------------------------ */\n483\t\n484\tpub unsafe extern \"C\" fn user_transform_cb(\n485\t    _png: *mut PngStruct,\n486\t    row_info: *mut png_row_info,\n487\t    row: *mut u8,\n488\t) {\n489\t    let ri = *row_info;\n490\t    log(format!(\n491\t        \"user_transform w={} rowbytes={} ct={} bd={} ch={} pd={}\",\n492\t        ri.width, ri.rowbytes, ri.color_type, ri.bit_depth, ri.channels, ri.pixel_depth\n493\t    ));\n494\t    // A deterministic, in-place mangle so the effect is visible in the output.\n495\t    for i in 0..ri.rowbytes {\n496\t        *row.add(i) = (*row.add(i)).rotate_left(3) ^ (i as u8);\n497\t    }\n498\t}\n499\t\n500\tpub unsafe extern \"C\" fn malloc_cb(png: *mut PngStruct, size: usize) -> *mut c_void {\n501\t    let t = tls();\n502\t    t.alloc_serial += 1;\n503\t    let serial = t.alloc_serial;\n504\t    let p = libc_malloc(size.max(1));\n5