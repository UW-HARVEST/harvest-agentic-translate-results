{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UogfJ2U64kYxAN3DJcKe5x","type":"tool_result","content":"860\t    eprintln!(\"[highlevel::read_png] {} differential comparisons\", n);\n861\t    TOTAL.fetch_add(n, std::sync::atomic::Ordering::Relaxed);\n862\t}\n863\t\n864\t/// A datastream whose IHDR declares `h` rows; `png_read_info` stops at IDAT so\n865\t/// nothing is ever decoded.\n866\tfn tall_png(h: u32) -> Vec<u8> {\n867\t    let mut ihdr = Vec::new();\n868\t    ihdr.extend_from_slice(&1u32.to_be_bytes());\n869\t    ihdr.extend_from_slice(&h.to_be_bytes());\n870\t    ihdr.extend_from_slice(&[8, 0, 0, 0, 0]);\n871\t    let mut v = SIG.to_vec();\n872\t    v.extend_from_slice(&chunk(b\"IHDR\", &ihdr));\n873\t    v.extend_from_slice(&chunk(b\"IDAT\", &[0x78, 0x01, 0x00]));\n874\t    v.extend_from_slice(&chunk(b\"IEND\", &[]));\n875\t    v\n876\t}\n877\t\n878\t/* ------------------------------------------------------------------ */\n879\t/* C-132: png_write_png                                                */\n880\t/* ------------------------------------------------------------------ */\n881\t\n882\t#[test]\n883\tfn write_png() {\n884\t    let mut n = 0usize;\n885\t\n886\t    let mut cases: Vec<WriteCase> = Vec::new();\n887\t    for (ct, bd) in VALID_SHAPES {\n888\t        for il in [PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n889\t            for rich in [false, true] {\n890\t                let (w, h) = if rich { (8, 3) } else { (13, 5) };\n891\t                let mut rng = Rng::new(\n892\t                    0x132_0000\n893\t                        ^ ((ct as u64) << 40)\n894\t                        ^ ((bd as u64) << 32)\n895\t                        ^ ((il as u64) << 24)\n896\t                        ^ ((rich as u64) << 16),\n897\t                );\n898\t                cases.push(WriteCase::random(&mut rng, w, h, ct, bd, il, rich));\n899\t            }\n900\t        }\n901\t    }\n902\t\n903\t    /* --- every write-legal flag on its own, over every shape ------------ */\n904\t    let mut single: Vec<c_int> = vec![PNG_TRANSFORM_IDENTITY];\n905\t    single.extend_from_slice(&WRITE_FLAGS);\n906\t    for wc in &cases {\n907\t        for &t in &single {\n908\t            let case = format!(\n909\t                \"write_png {} ct={} bd={} il={} rich={}\",\n910\t                tname(t),\n911\t                wc.ct,\n912\t                wc.bd,\n913\t                wc.il,\n914\t                wc.rich.is_some()\n915\t            );\n916\t            n += 1;\n917\t            assert_same(&case, |api| unsafe {\n918\t                drive_write_png(api, wc, t, true, t & 1 != 0)\n919\t            });\n920\t        }\n921\t    }\n922\t\n923\t    /* --- BEFORE+AFTER together: png_app_error (pngwrite.c:1472) --------- */\n924\t    for wc in &cases {\n925\t        let t = PNG_TRANSFORM_STRIP_FILLER_BEFORE | PNG_TRANSFORM_STRIP_FILLER_AFTER;\n926\t        let case = format!(\n927\t            \"write_png filler both ct={} bd={} il={} rich={}\",\n928\t            wc.ct, wc.bd, wc.il, wc.rich.is_some()\n929\t        );"}]},"parent_tool_use_id":"toolu_bdrk_01UP6NJVScwKVWsWLKn6DXBk","session_id":"309de29f-cb7a-4138-9016-7ab2e7ef6079","uuid":"d1776dbf-0c8e-4ebe-8461-325a22c4bc42","timestamp":"2026-08-23T03:09:11.313Z","subagent_type":"general-purpose","task_description":"Write high-level API tests"}
