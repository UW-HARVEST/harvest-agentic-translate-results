alette = if ct == PNG_COLOR_TYPE_PALETTE {\n450\t            (0..(1usize << bd.min(8)))\n451\t                .map(|_| png_color {\n452\t                    red: rng.u8(),\n453\t                    green: rng.u8(),\n454\t                    blue: rng.u8(),\n455\t                })\n456\t                .collect()\n457\t        } else {\n458\t            Vec::new()\n459\t        };\n460\t        let r = if rich {\n461\t            Some(rich_for(rng, ct, bd, palette.len()))\n462\t        } else {\n463\t            None\n464\t        };\n465\t        let rowsize = read_rowsize(w);\n466\t        let rows = (0..h as usize).map(|_| rng.bytes(rowsize)).collect();\n467\t        WriteCase {\n468\t            w,\n469\t            h,\n470\t            ct,\n471\t            bd,\n472\t            il,\n473\t            palette,\n474\t            rich: r,\n475\t            rows,\n476\t        }\n477\t    }\n478\t}\n479\t\n480\t/// Drive one complete `png_write_png` and record the produced file.\n481\tunsafe fn drive_write_png(\n482\t    api: &Api,\n483\t    wc: &WriteCase,\n484\t    transforms: c_int,\n485\t    set_rows: bool,\n486\t    params_nonnull: bool,\n487\t) -> Outcome {\n488\t    let mut o = Outcome::default();\n489\t    let (png, info) = new_write(api);\n490\t    (api.png_set_write_fn)(png, ptr::null_mut(), Some(write_cb), Some(flush_cb));\n491\t\n492\t    let mut own = OwnRows::filled(&wc.rows);\n493\t    let rows_ptr = own.as_ptr();\n494\t    let mut params = [0x5au8; 16];\n495\t    let pp = if params_nonnull {\n496\t        params.as_mut_ptr() as *mut c_void\n497\t    } else {\n498\t        ptr::null_mut()\n499\t    };"}]},"parent_tool_use_id":"toolu_bdrk_01UP6NJVScwKVWsWLKn6DXBk","session_id":"309de29f-cb7a-4138-9016-7ab2e7ef6079","uuid":"3a1ebfc4-45d0-4e1b-a259-8ebf32e9d2cb","timestamp":"2026-08-23T03:12:40.686Z","subagent_type":"general-purpose","task_description":"Write high-level API tests"}
