{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011WP7pTutyjFjY1BB99h5Gc","type":"tool_result","content":"1\t//! Harness self-check: both shared objects load, expose the same symbols, and\n2\t//! agree on a trivial write/read round trip.\n3\tmod common;\n4\t\n5\tuse common::*;\n6\tuse core::ffi::c_char;\n7\t\n8\t#[test]\n9\tfn both_libraries_load_and_export_every_symbol() {\n10\t    let l = libs();\n11\t    // `Api::load` panics on the first missing symbol, so reaching here means all\n12\t    // 384 exported symbols resolved in BOTH shared objects.\n13\t    assert_eq!(API_NAMES.len(), 381);\n14\t    assert_eq!(l.c.which, \"C\");\n15\t    assert_eq!(l.rust.which, \"Rust\");\n16\t}\n17\t\n18\t#[test]\n19\tfn version_numbers_match() {\n20\t    let l = libs();\n21\t    unsafe {\n22\t        assert_eq!(\n23\t            (l.c.png_access_version_number)(),\n24\t            (l.rust.png_access_version_number)()\n25\t        );\n26\t        let a = std::ffi::CStr::from_ptr((l.c.png_get_libpng_ver)(core::ptr::null_mut()));\n27\t        let b = std::ffi::CStr::from_ptr((l.rust.png_get_libpng_ver)(core::ptr::null_mut()));\n28\t        assert_eq!(a, b);\n29\t        let a = std::ffi::CStr::from_ptr((l.c.png_get_header_version)(core::ptr::null_mut()));\n30\t        let b = std::ffi::CStr::from_ptr((l.rust.png_get_header_version)(core::ptr::null_mut()));\n31\t        assert_eq!(a, b);\n32\t        let a = std::ffi::CStr::from_ptr((l.c.png_get_copyright)(core::ptr::null_mut()));\n33\t        let b = std::ffi::CStr::from_ptr((l.rust.png_get_copyright)(core::ptr::null_mut()));\n34\t        assert_eq!(a, b);\n35\t    }\n36\t}\n37\t\n38\t/// Build an 8-bit RGB image of the given size with a deterministic pattern.\n39\tfn pattern(w: u32, h: u32, chans: usize, seed: u64) -> Vec<Vec<u8>> {\n40\t    let mut rng = Rng::new(seed);\n41\t    (0..h)\n42\t        .map(|_| (0..(w as usize * chans)).map(|_| rng.u8()).collect())\n43\t        .collect()\n44\t}\n45\t\n46\t#[test]\n47\tfn trivial_write_round_trip_is_byte_identical() {\n48\t    assert_same(\"write 8x8 rgb8\", |api| unsafe {\n49\t        let mut o = Outcome::default();\n50\t        let (png, info) = new_write(api);\n51\t        (api.png_set_write_fn)(png, core::ptr::null_mut(), Some(write_cb), Some(flush_cb));\n52\t        let rows = pattern(8, 8, 3, 1);\n53\t        let g = guarded(api, png, &mut || {\n54\t            (api.png_set_IHDR)(\n55\t                png,\n56\t                info,\n57\t                8,\n58\t                8,\n59\t                8,\n60\t                PNG_COLOR_TYPE_RGB,\n61\t                PNG_INTERLACE_NONE,\n62\t                PNG_COMPRESSION_TYPE_BASE,\n63\t                PNG_FILTER_TYPE_BASE,\n64\t            );\n65\t            (api.png_write_info)(png, info);\n66\t            for r in &rows {\n67\t                (api.png_write_row)(png, r.as_ptr() as *mut u8);\n68\t            }\n69\t            (api.png_write_end)(png, info);\n70\t        });\n71\t        o.push(format!(\"guard={:?}\", g));\n72\t        o.output = std::mem::take(&mut tls().output);\n73\t        destroy_write(api, png, info);\n74\t        o\n75\t    });\n76\t}\n77\t\n78\t#[test]\n79\tfn trivial_read_round_trip_is_byte_identical() {\n80\t    // Produce the file once with the C library, then read it with both.\n81\t    let l = libs();\n82\t    let file = unsafe {\n83\t        let mut state = Box::new(Tls::default());\n84\t        let prev = set_tls(&mut *state as *mut Tls);\n85\t        let prev_api = set_cur_api(&l.c as *const Api);\n86\t        let api = &l.c;\n87\t        let (png, info) = new_write(api);\n88\t        (api.png_set_write_fn)(png, core::ptr::null_mut(), Some(write_cb), Some(flush_cb));\n89\t        let rows = pattern(9, 5, 4, 7);\n90\t        let g = guarded(api, png, &mut || {\n91\t            (api.png_set_IHDR)(\n92\t                png,\n93\t                info,\n94\t                9,\n95\t                5,\n96\t                8,\n97\t                PNG_COLOR_TYPE_RGB_ALPHA,\n98\t                PNG_INTERLACE_NONE,\n99\t                PNG_COMPRESSION_TYPE_BASE,\n100\t                PNG_FILTER_TYPE_BASE,\n101\t            );\n102\t            (api.png_write_info)(png, info);\n103\t            for r in &rows {\n104\t                (api.png_write_row)(png, r.as_ptr() as *mut u8);\n105\t            }\n106\t            (api.png_write_end)(png, info);\n107\t        });\n108\t        assert_eq!(g, Guard::Ok);\n109\t        destroy_write(api, png, info);\n110\t        let out = std::mem::take(&mut state.output);\n111\t        set_cur_api(prev_api);\n112\t        set_tls(prev);\n113\t        out\n114\t    };\n115\t    assert!(file.len() > 8);\n116\t\n117\t    assert_same(\"read 9x5 rgba8\", |api| unsafe {\n118\t        let mut o = Outcome::default();\n119\t        tls().input = file.clone();\n120\t        let (png, info) = new_read(api);\n121\t        (api.png_set_read_fn)(png, core::ptr::null_mut(), Some(read_cb));\n122\t        let g = guarded(api, png, &mut || {\n123\t            (api.png_read_info)(png, info);\n124\t            let w = (api.png_get_image_width)(png, info);\n125\t            let h = (api.png_get_image_height)(png, info);\n126\t            let rb = (api.png_get_rowbytes)(png, info);\n127\t            log(format!(\"w={} h={} rowbytes={}\", w, h, rb));\n128\t            log(format!(\n129\t                \"depth={} color={} interlace={} comp={} filter={}\",\n130\t                (api.png_get_bit_depth)(png, info),\n131\t                (api.png_get_color_type)(png, info),\n132\t                (api.png_get_interlace_type)(png, info),\n133\t                (api.png_get_compression_type)(png, info),\n134\t                (api.png_get_filter_type)(png, info)\n135\t            ));\n136\t            let mut row = vec![0u8; rb];\n137\t            for y in 0..h {\n138\t                (api.png_read_row)(png, row.as_mut_ptr(), core::ptr::null_mut());\n139\t                log(format!(\"row {}: {:02x?}\", y, &row));\n140\t            }\n141\t            (api.png_read_end)(png, info);\n142\t        });\n143\t        o.push(format!(\"guard={:?}\", g));\n144\t        destroy_read(api, png, info);\n145\t        o\n146\t    });\n147\t}\n148\t\n149\t#[test]\n150\tfn fatal_error_is_reported_identically() {\n151\t    // Feed both libraries garbage: the signature check must fail the same way.\n152\t    assert_same(\"bad signature\", |api| unsafe {\n153\t        let mut o = Outcome::default();\n154\t        tls().input = b\"not a png file at all, really not\".to_vec();\n155\t        let (png, info) = new_read(api);\n156\t        (api.png_set_read_fn)(png, core::ptr::null_mut(), Some(read_cb));\n157\t        let g = guarded(api, png, &mut || {\n158\t            (api.png_read_info)(png, info);\n159\t        });\n160\t        o.push(format!(\"guard={:?}\", g));\n161\t        destroy_read(api, png, info);\n162\t        o\n163\t    });\n164\t}\n165\t\n166\t#[test]\n167\tfn pure_functions_agree() {\n168\t    let l = libs();\n169\t    let mut rng = Rng::new(0xfeed);\n170\t    unsafe {\n171\t        for _ in 0..2000 {\n172\t            let b = rng.bytes(4);\n173\t            assert_eq!(\n174\t                (l.c.png_get_uint_32)(b.as_ptr()),\n175\t                (l.rust.png_get_uint_32)(b.as_ptr())\n176\t            );\n177\t            assert_eq!(\n178\t                (l.c.png_get_uint_16)(b.as_ptr()),\n179\t                (l.rust.png_get_uint_16)(b.as_ptr())\n180\t            );\n181\t            assert_eq!(\n182\t                (l.c.png_get_int_32)(b.as_ptr()),\n183\t                (l.rust.png_get_int_32)(b.as_ptr())\n184\t            );\n185\t            let mut x = [0u8; 4];\n186\t            let mut y = [0u8; 4];\n187\t            let v = rng.u32();\n188\t            (l.c.png_save_uint_32)(x.as_mut_ptr(), v);\n189\t            (l.rust.png_save_uint_32)(y.as_mut_ptr(), v);\n190\t            assert_eq!(x, y);\n191\t            (l.c.png_save_int_32)(x.as_mut_ptr(), v as i32);\n192\t            (l.rust.png_save_int_32)(y.as_mut_ptr(), v as i32);\n193\t            assert_eq!(x, y);\n194\t            (l.c.png_save_uint_16)(x.as_mut_ptr(), (v & 0xffff) as u32);\n195\t            (l.rust.png_save_uint_16)(y.as_mut_ptr(), (v & 0xffff) as u32);\n196\t            assert_eq!(x, y);\n197\t        }\n198\t        // png_sig_cmp over random prefixes\n199\t        for _ in 0..2000 {\n200\t            let b = rng.bytes(8);\n201\t            let start = rng.below(8);\n202\t            let n = rng.below(9 - start);\n203\t            assert_eq!(\n204\t                (l.c.png_sig_cmp)(b.as_ptr(), start, n),\n205\t                (l.rust.png_sig_cmp)(b.as_ptr(), start, n),\n206\t                \"png_sig_cmp({:02x?}, {}, {})\",\n207\t                b,\n208\t                start,\n209\t                n\n210\t            );\n211\t        }\n212\t        // exported data tables\n213\t        for i in 0..256 {\n214\t            assert_eq!(\n215\t                *l.c.png_sRGB_table.add(i),\n216\t                *l.rust.png_sRGB_table.add(i),\n217\t                \"png_sRGB_table[{}]\",\n218\t                i\n219\t            );\n220\t        }\n221\t        for i in 0..512 {\n222\t            assert_eq!(*l.c.png_sRGB_base.add(i), *l.rust.png_sRGB_base.add(i));\n223\t            assert_eq!(*l.c.png_sRGB_delta.add(i), *l.rust.png_sRGB_delta.add(i));\n224\t        }\n225\t    }\n226\t    let _ = 0 as *const c_char;\n227\t}\n228\t"}]},"parent_tool_use_id":"toolu_bdrk_01GWcu9bgbVggeqy4XeSbuyX","session_id":"309de29f-cb7a-4138-9016-7ab2e7ef6079","uuid":"cb389076-a4d6-4616-89e7-67cdc09dded1","timestamp":"2026-08-23T02:59:29.016Z","subagent_type":"general-purpose","task_description":"Write misc/IO/limits tests"}
