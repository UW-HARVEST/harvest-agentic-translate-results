nwrap(),\n            jmp_buf_size: *sl.get(b\"harness_jmp_buf_size\").unwrap(),\n            _lib: sl,\n        };\n        assert_eq!(\n            (shim.jmp_buf_size)(),\n            200,\n            \"glibc jmp_buf is expected to be 200 bytes on this target\"\n        );\n\n        Libs {\n            c: Api::load(cl, \"C\"),\n            rust: Api::load(rl, \"Rust\"),\n            shim,\n        }\n    })","numLines":50,"startLine":138,"totalLines":571}}}
