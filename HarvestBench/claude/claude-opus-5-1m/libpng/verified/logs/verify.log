{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KrKNNWzcPwRRHbowxTLZJb","type":"tool_result","content":"1\t//! Differential-test harness.\n2\t//!\n3\t//! Both libraries under test are loaded with `libloading::Library::new` and\n4\t//! driven **only** through their exported symbols (see `api.rs`, which is\n5\t//! generated from `c_src/include/png.h` + `c_src/include/pngpriv.h` and covers\n6\t//! all 384 exported symbols).  No Rust function is ever called directly, so the\n7\t//! `#[no_mangle]` export wrappers are exercised too.\n8\t#![allow(dead_code)]\n9\t\n10\tpub mod api;\n11\tpub mod helpers;\n12\tpub mod types;\n13\t\n14\t#[allow(unused_imports)]\n15\tpub use api::{Api, API_NAMES};\n16\t#[allow(unused_imports)]\n17\tpub use helpers::*;\n18\tpub use types::*;\n19\t\n20\tuse core::ffi::{c_char, c_int, c_void};\n21\tuse std::path::{Path, PathBuf};\n22\tuse std::sync::OnceLock;\n23\t\n24\t/* ------------------------------------------------------------------ */\n25\t/* library discovery + loading                                         */\n26\t/* ------------------------------------------------------------------ */\n27\t\n28\tfn crate_root() -> PathBuf {\n29\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n30\t}\n31\t\n32\t/// `target/<profile>/` of the currently running test binary.\n33\tfn target_profile_dir() -> PathBuf {\n34\t    let exe = std::env::current_exe().expect(\"current_exe\");\n35\t    // .../target/<profile>/deps/<test>-<hash>\n36\t    exe.parent()\n37\t        .and_then(Path::parent)\n38\t        .expect(\"target/<profile>\")\n39\t        .to_path_buf()\n40\t}\n41\t\n42\tfn c_so_path() -> PathBuf {\n43\t    crate_root().join(\"c_src/build/libpng.so\")\n44\t}\n45\t\n46\tfn rust_so_path() -> PathBuf {\n47\t    let p = target_profile_dir().join(\"liblibpng.so\");\n48\t    if p.exists() {\n49\t        return p;\n50\t    }\n51\t    for prof in [\"release\", \"debug\"] {\n52\t        let q = crate_root().join(\"target\").join(prof).join(\"liblibpng.so\");\n53\t        if q.exists() {\n54\t            return q;\n55\t        }\n56\t    }\n57\t    p\n58\t}\n59\t\n60\tfn shim_so_path() -> PathBuf {\n61\t    target_profile_dir().join(\"libpngharness.so\")\n62\t}\n63\t\n64\tfn build_shim() -> PathBuf {\n65\t    let out = shim_so_path();\n66\t    let src = crate_root().join(\"tests/common/shim.c\");\n67\t    let fresh = std::fs::metadata(&out)\n68\t        .and_then(|a| a.modified())\n69\t        .ok()\n70\t        .zip(std::fs::metadata(&src).and_then(|a| a.modified()).ok())\n71\t        .map(|(o, s)| o >= s)\n72\t        .unwrap_or(false);\n73\t    if !fresh {\n74\t        let tmp = out.with_extension(format!(\"so.{}\", std::process::id()));\n75\t        let st = std::process::Command::new(\"cc\")\n76\t            .args([\"-O1\", \"-fPIC\", \"-shared\", \"-o\"])\n77\t            .arg(&tmp)\n78\t            .arg(&src)\n79\t            .status()\n80\t            .expect(\"cc (needed to build the test's setjmp shim)\");\n81\t        assert!(st.success(), \"failed to compile {}\", src.display());\n82\t        let _ = std::fs::rename(&tmp, &out);\n83\t    }\n84\t    out\n85\t}\n86\t\n87\t/// `cargo test` does not necessarily rebuild a `cdylib`-only lib target, so make\n88\t/// sure we are never silently testing a stale artefact.\n89\tfn assert_fresh(so: &Path) {\n90\t    let so_mtime = std::fs::metadata(so).and_then(|m| m.modified()).unwrap();\n91\t    let mut newest = so_mtime;\n92\t    let mut newest_path = so.to_path_buf();\n93\t    let mut stack = vec![crate_root().join(\"src\")];\n94\t    while let Some(d) = stack.pop() {\n95\t        let Ok(rd) = std::fs::read_dir(&d) else { continue };\n96\t        for e in rd.flatten() {\n97\t            let p = e.path();\n98\t            if p.is_dir() {\n99\t                stack.push(p);\n100\t            } else if let Ok(m) = e.metadata().and_then(|m| m.modified()) {\n101\t                if m > newest {\n102\t                    newest = m;\n103\t                    newest_path = p;\n104\t                }\n105\t            }\n106\t        }\n107\t    }\n108\t    assert!(\n109\t        newest <= so_mtime,\n110\t        \"{} is older than {} -- run `cargo build --release` first \\\n111\t         (cargo test does not rebuild a cdylib-only lib target)\",\n112\t        so.display(),\n113\t        newest_path.display()\n114\t    );\n115\t}\n116\t\n117\tpub struct Shim {\n118\t    pub run: unsafe extern \"C\" fn(\n119\t        set_longjmp_fn: *mut c_void,\n120\t        png_ptr: *mut PngStruct,\n121\t        body: unsafe extern \"C\" fn(*mut c_void),\n122\t        arg: *mut c_void,\n123\t    ) -> c_int,\n124\t    pub last_error: unsafe extern \"C\" fn() -> *const c_char,\n125\t    pub error_fn: unsafe extern \"C\" fn(*mut PngStruct, *const c_char),\n126\t    pub jmp_buf_size: unsafe extern \"C\" fn() -> usize,\n127\t    _lib: &'static libloading::Library,\n128\t}\n129\t\n130\tpub struct Libs {\n131\t    pub c: Api,\n132\t    pub rust: Api,\n133\t    pub shim: Shim,\n134\t}\n135\t\n136\t/// SAFETY: every field is either a plain function pointer or a pointer into a\n137\t/// permanently mapped, read-only section of a dlopen'd library; both are safe to\n138\t/// read from any thread.\n139\tunsafe impl Send for Libs {}\n140\tunsafe impl Sync for Libs {}\n141\t\n142\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n143\t\n144\tpub fn libs() -> &'static Libs {\n145\t    LIBS.get_or_init(|| unsafe {\n146\t        let cp = c_so_path();\n147\t        assert!(\n148\t            cp.exists(),\n149\t            \"C reference library not built: {}\\n\\\n150\t             build it with:\\n  cd c_src && mkdir -p build && cd build && \\\n151\t             cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\",\n152\t            cp.display()\n153\t        );\n154\t        let rp = rust_so_path();\n155\t        assert!(rp.exists(), \"Rust cdylib not built: {}\", rp.display());\n156\t        assert_fresh(&rp);\n157\t\n158\t        let cl: &'static libloading::Library =\n159\t            Box::leak(Box::new(libloading::Library::new(&cp).expect(\"dlopen C .so\")));\n160\t        let rl: &'static libloading::Library = Box::leak(Box::new(\n161\t            libloading::Library::new(&rp).expect(\"dlopen Rust .so\"),\n162\t        ));\n163\t        let sp = build_shim();\n164\t        let sl: &'static libloading::Library = Box::leak(Box::new(\n165\t            libloading::Library::new(&sp).expect(\"dlopen shim .so\"),\n166\t        ));\n167\t\n168\t        let shim = Shim {\n169\t            run: *sl.get(b\"harness_run\").unwrap(),\n170\t            last_error: *sl.get(b\"harness_last_error\").unwrap(),\n171\t            error_fn: *sl.get(b\"harness_error_fn\").unwrap(),\n172\t            jmp_buf_size: *sl.get(b\"harness_jmp_buf_size\").unwrap(),\n173\t            _lib: sl,\n174\t        };\n175\t        assert_eq!(\n176\t            (shim.jmp_buf_size)(),\n177\t            200,\n178\t            \"glibc jmp_buf is expected to be 200 bytes on this target\"\n179\t        );\n180\t\n181\t        Libs {\n182\t            c: Api::load(cl, \"C\"),\n183\t            rust: Api::load(rl, \"Rust\"),\n184\t            shim,\n185\t        }\n186\t    })\n187\t}\n188\t\n189\t/* ------------------------------------------------------------------ */\n190\t/* per-thread callback state                                           */\n191\t/* ------------------------------------------------------------------ */\n192\t\n193\t/// State the libpng callbacks operate on.  It is reached through a thread-local\n194\t/// raw pointer rather than `png_get_io_ptr()` so that the very same callback\n195\t/// works for both libraries; a raw pointer (not `RefCell`) because libpng may\n196\t/// `longjmp` out of a callback, which would leave a `RefCell` borrowed forever.\n197\tpub struct Tls {\n198\t    /// Ordered log of everything the library reported / did.\n199\t    pub trace: Vec<String>,\n200\t    /// Bytes the library may read (`png_set_read_fn`).\n201\t    pub input: Vec<u8>,\n202\t    pub in_pos: usize,\n203\t    /// Bytes the library wrote (`png_set_write_fn`).\n204\t    pub output: Vec<u8>,\n205\t    pub flushes: u32,\n206\t    /// Rows handed to / expected from the library.\n207\t    pub rows: Vec<Vec<u8>>,\n208\t    /// Scratch used by user callbacks.\n209\t    pub counter: u64,\n210\t    /// Allocation bookkeeping for the custom allocator test.\n211\t    pub allocs: Vec<(usize, usize)>,\n212\t    pub alloc_serial: u64,\n213\t    /// Set to make the read callback report a short read.\n214\t    pub truncate_reads_at: Option<usize>,\n215\t}\n216\t\n217\timpl Default for Tls {\n218\t    fn default() -> Self {\n219\t        Tls {\n220\t            trace: Vec::new(),\n221\t            input: Vec::new(),\n222\t            in_pos: 0,\n223\t            output: Vec::new(),\n224\t            flushes: 0,\n225\t            rows: Vec::new(),\n226\t            counter: 0,\n227\t            allocs: Vec::new(),\n228\t            alloc_serial: 0,\n229\t            truncate_reads_at: None,\n230\t        }\n231\t    }\n232\t}\n233\t\n234\tthread_local! {\n235\t    static TLS: std::cell::Cell<*mut Tls> = const { std::cell::Cell::new(core::ptr::null_mut()) };\n236\t}\n237\t\n238\tpub fn tls() -> &'static mut Tls {\n239\t    let p = TLS.with(|c| c.get());\n240\t    assert!(!p.is_null(), \"no Tls installed on this thread\");\n241\t    unsafe { &mut *p }\n242\t}\n243\t\n244\tpub fn set_tls(p: *mut Tls) -> *mut Tls {\n245\t    TLS.with(|c| c.replace(p))\n246\t}\n247\t\n248\tpub fn log(s: impl Into<String>) {\n249\t    tls().trace.push(s.into());\n250\t}\n251\t\n252\t/* ------------------------------------------------------------------ */\n253\t/* libpng callbacks (shared by both libraries)                         */\n254\t/* ------------------------------------------------------------------ */\n255\t\n256\tunsafe fn cstr(p: *const c_char) -> String {\n257\t    if p.is_null() {\n258\t        \"<null>\".to_string()\n259\t    } else {\n260\t        std::ffi::CStr::from_ptr(p).to_string_lossy().into_owned()\n261\t    }\n262\t}\n263\t\n264\tpub unsafe extern \"C\" fn warn_cb(_png: *mut PngStruct, msg: *const c_char) {\n265\t    log(format!(\"warning: {}\", cstr(msg)));\n266\t}\n267\t\n268\tpub unsafe extern \"C\" fn read_cb(png: *mut PngStruct, data: *mut u8, len: usize) {\n269\t    let t = tls();\n270\t    let avail = t.input.len().saturating_sub(t.in_pos);\n271\t    let mut n = len.min(avail);\n272\t    if let Some(limit) = t.truncate_reads_at {\n273\t        if t.in_pos + n > limit {\n274\t            n = limit.saturating_sub(t.in_pos);\n275\t        }\n276\t    }\n277\t    if n > 0 {\n278\t        core::ptr::copy_nonoverlapping(t.input.as_ptr().add(t.in_pos), data, n);\n279\t        t.in_pos += n;\n280\t    }\n281\t    if n < len {\n282\t        // Same behaviour as libpng's own png_default_read_data on a short read.\n283\t        log(format!(\"read_fn: short read ({} of {})\", n, len));\n284\t        let api = CUR_API.with(|c| c.get());\n285\t        assert!(!api.is_null());\n286\t        ((*api).png_error)(png, b\"Read Error\\0\".as_ptr() as *const c_char);\n287\t    }\n288\t}\n289\t\n290\tpub unsafe extern \"C\" fn write_cb(_png: *mut PngStruct, data: *mut u8, len: usize) {\n291\t    let t = tls();\n292\t    t.output.extend_from_slice(core::slice::from_raw_parts(data, len));\n293\t}\n294\t\n295\tpub unsafe extern \"C\" fn flush_cb(_png: *mut PngStruct) {\n296\t    tls().flushes += 1;\n297\t}\n298\t\n299\tpub unsafe extern \"C\" fn read_status_cb(_png: *mut PngStruct, row: u32, pass: c_int) {\n300\t    log(format!(\"read_row_status row={} pass={}\", row, pass));\n301\t}\n302\t\n303\tpub unsafe extern \"C\" fn write_status_cb(_png: *mut PngStruct, row: u32, pass: c_int) {\n304\t    log(format!(\"write_row_status row={} pass={}\", row, pass));\n305\t}\n306\t\n307\tthread_local! {\n308\t    static CUR_API: std::cell::Cell<*const Api> =\n309\t        const { std::cell::Cell::new(core::ptr::null()) };\n310\t}\n311\t\n312\tpub fn set_cur_api(p: *const Api) -> *const Api {\n313\t    CUR_API.with(|c| c.replace(p))\n314\t}\n315\t\n316\tpub fn cur_api() -> &'static Api {\n317\t    let p = CUR_API.with(|c| c.get());\n318\t    assert!(!p.is_null());\n319\t    unsafe { &*p }\n320\t}\n321\t\n322\t/* ------------------------------------------------------------------ */\n323\t/* running a scenario under the libpng error trap                      */\n324\t/* ------------------------------------------------------------------ */\n325\t\n326\tunsafe extern \"C\" fn trampoline(arg: *mut c_void) {\n327\t    let f = arg as *mut &mut dyn FnMut();\n328\t    (*f)();\n329\t}\n330\t\n331\t/// Result of `guarded`.\n332\t#[derive(Debug, Clone, PartialEq, Eq)]\n333\tpub enum Guard {\n334\t    /// The body ran to completion.\n335\t    Ok,\n336\t    /// libpng raised a fatal error with this message.\n337\t    Error(String),\n338\t    /// `png_set_longjmp_fn` returned NULL.\n339\t    NoTrap,\n340\t}\n341\t\n342\t/// Run `body` with a libpng error trap armed on `png_ptr`.\n343\tpub unsafe fn guarded(api: &Api, png_ptr: *mut PngStruct, body: &mut dyn FnMut()) -> Guard {\n344\t    let sh = &libs().shim;\n345\t    let mut b: &mut dyn FnMut() = body;\n346\t    let arg = &mut b as *mut &mut dyn FnMut() as *mut c_void;\n347\t    let r = (sh.run)(\n348\t        api.png_set_longjmp_fn as *mut c_void,\n349\t        png_ptr,\n350\t        trampoline,\n351\t        arg,\n352\t    );\n353\t    match r {\n354\t        0 => Guard::Ok,\n355\t        1 => Guard::Error(cstr((sh.last_error)())),\n356\t        _ => Guard::NoTrap,\n357\t    }\n358\t}\n359\t\n360\t/* ------------------------------------------------------------------ */\n361\t/* the differential driver                                             */\n362\t/* ------------------------------------------------------------------ */\n363\t\n364\t/// Everything a scenario observed: an ordered event log plus the produced bytes.\n365\t#[derive(Default, Clone, PartialEq, Eq)]\n366\tpub struct Outcome {\n367\t    pub trace: Vec<String>,\n368\t    pub output: Vec<u8>,\n369\t}\n370\t\n371\timpl Outcome {\n372\t    pub fn push(&mut self, s: impl Into<String>) {\n373\t        self.trace.push(s.into());\n374\t    }\n375\t}\n376\t\n377\t/// Run `f` once against the C library and once against the Rust library, each\n378\t/// with a fresh `Tls`, and return the two outcomes.\n379\tpub fn run_both<F>(mut f: F) -> (Outcome, Outcome)\n380\twhere\n381\t    F: FnMut(&Api) -> Outcome,\n382\t{\n383\t    let l = libs();\n384\t    let mut out = Vec::new();\n385\t    for api in [&l.c, &l.rust] {\n386\t        let mut state = Box::new(Tls::default());\n387\t        let prev = set_tls(&mut *state as *mut Tls);\n388\t        let prev_api = set_cur_api(api as *const Api);\n389\t        let mut o = f(api);\n390\t        // The event log the callbacks appended goes first, then whatever the\n391\t        // scenario itself recorded, so that both sides are ordered identically.\n392\t        let mut trace = std::mem::take(&mut state.trace);\n393\t        trace.append(&mut o.trace);\n394\t        o.trace = trace;\n395\t        set_cur_api(prev_api);\n396\t        set_tls(prev);\n397\t        out.push(o);\n398\t    }\n399\t    let b = out.pop().unwrap();\n400\t    let a = out.pop().unwrap();\n401\t    (a, b)\n402\t}\n403\t\n404\tfn hexdump(b: &[u8], from: usize) -> String {\n405\t    let start = from.saturating_sub(16) & !15;\n406\t    let end = (from + 48).min(b.len());\n407\t    let mut s = String::new();\n408\t    let mut i = start;\n409\t    while i < end {\n410\t        s.push_str(&format!(\"{:08x} \", i));\n411\t        for j in i..(i + 16).min(end) {\n412\t            s.push_str(&format!(\"{:02x} \", b[j]));\n413\t        }\n414\t        s.push('\\n');\n415\t        i += 16;\n416\t    }\n417\t    s\n418\t}\n419\t\n420\t/// How many differential comparisons this test binary has performed.\n421\tpub static CASES: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);\n422\t\n423\t/// Assert the two libraries behaved identically for the scenario `f`.\n424\t#[track_caller]\n425\tpub fn assert_same<F>(case: &str, f: F)\n426\twhere\n427\t    F: FnMut(&Api) -> Outcome,\n428\t{\n429\t    let (c, r) = run_both(f);\n430\t    CASES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n431\t    assert!(\n432\t        !c.trace.is_empty() || !c.output.is_empty(),\n433\t        \"case `{}`: the scenario recorded nothing at all -- the test is not \\\n434\t         actually exercising the library\",\n435\t        case\n436\t    );\n437\t    if c.trace != r.trace {\n438\t        let n = c\n439\t            .trace\n440\t            .iter()\n441\t            .zip(r.trace.iter())\n442\t            .position(|(a, b)| a != b)\n443\t            .unwrap_or(c.trace.len().min(r.trace.len()));\n444\t        let ctx = n.saturating_sub(4);\n445\t        let mut msg = format!(\n446\t            \"case `{}`: event traces differ at index {} (C has {} events, Rust has {})\\n\",\n447\t            case,\n448\t            n,\n449\t            c.trace.len(),\n450\t            r.trace.len()\n451\t        );\n452\t        for i in ctx..(n + 6).min(c.trace.len().max(r.trace.len())) {\n453\t            let a = c.trace.get(i).map(String::as_str).unwrap_or(\"<none>\");\n454\t            let b = r.trace.get(i).map(String::as_str).unwrap_or(\"<none>\");\n455\t            msg += &format!(\n456\t                \"  [{}] {} C: {}\\n       {} R: {}\\n\",\n457\t                i,\n458\t                if a == b { ' ' } else { '!' },\n459\t                a,\n460\t                if a == b { ' ' } else { '!' },\n461\t                b\n462\t            );\n463\t        }\n464\t        panic!(\"{}\", msg);\n465\t    }\n466\t    if c.output != r.output {\n467\t        let n = c\n468\t            .output\n469\t            .iter()\n470\t            .zip(r.output.iter())\n471\t            .position(|(a, b)| a != b)\n472\t            .unwrap_or(c.output.len().min(r.output.len()));\n473\t        panic!(\n474\t            \"case `{}`: output bytes differ at offset {} (C {} bytes, Rust {} bytes)\\nC:\\n{}\\nRust:\\n{}\",\n475\t            case,\n476\t            n,\n477\t            c.output.len(),\n478\t            r.output.len(),\n479\t            hexdump(&c.output, n),\n480\t            hexdump(&r.output, n)\n481\t        );\n482\t    }\n483\t}\n484\t\n485\t/* ------------------------------------------------------------------ */\n486\t/* deterministic RNG (no external crates)                              */\n487\t/* ------------------------------------------------------------------ */\n488\t\n489\t/// SplitMix64 — fixed seed, so every failure is reproducible.\n490\tpub struct Rng(pub u64);\n491\t\n492\timpl Rng {\n493\t    pub fn new(seed: u64) -> Rng {\n494\t        Rng(seed ^ 0x9e3779b97f4a7c15)\n495\t    }\n496\t    pub fn next_u64(&mut self) -> u64 {\n497\t        self.0 = self.0.wrapping_add(0x9e3779b97f4a7c15);\n498\t        let mut z = self.0;\n499\t        z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);\n500\t        z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);\n501\t        z ^ (z >> 31)\n502\t    }\n503\t    pub fn u32(&mut self) -> u32 {\n504\t        (self.next_u64() >> 32) as u32\n505\t    }\n506\t    pub fn u8(&mut self) -> u8 {\n507\t        (self.next_u64() >> 56) as u8\n508\t    }\n509\t    /// Uniform in `0..n`.\n510\t    pub fn below(&mut self, n: usize) -> usize {\n511\t        assert!(n > 0);\n512\t        (self.next_u64() % n as u64) as usize\n513\t    }\n514\t    pub fn range(&mut self, lo: i64, hi: i64) -> i64 {\n515\t        assert!(hi > lo);\n516\t        lo + (self.next_u64() % (hi - lo) as u64) as i64\n517\t    }\n518\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n519\t        (0..n).map(|_| self.u8()).collect()\n520\t    }\n521\t    pub fn pick<T: Copy>(&mut self, v: &[T]) -> T {\n522\t        v[self.below(v.len())]\n523\t    }\n524\t    pub fn bool(&mut self) -> bool {\n525\t        self.next_u64() & 1 == 1\n526\t    }\n527\t}\n528\t\n529\t/* ------------------------------------------------------------------ */\n530\t/* small helpers                                                       */\n531\t/* ------------------------------------------------------------------ */\n532\t\n533\tpub fn cs(s: &str) -> std::ffi::CString {\n534\t    std::ffi::CString::new(s).unwrap()\n535\t}\n536\t\n537\tpub const VER: *const c_char = b\"1.6.59.git\\0\".as_ptr() as *const c_char;\n538\t\n539\t/// Create a read struct with the harness error/warning handlers installed.\n540\tpub unsafe fn new_read(api: &Api) -> (*mut PngStruct, *mut PngInfo) {\n541\t    let sh = &libs().shim;\n542\t    let png = (api.png_create_read_struct)(VER, core::ptr::null_mut(), Some(sh.error_fn), Some(warn_cb));\n543\t    assert!(!png.is_null(), \"{}: png_create_read_struct failed\", api.which);\n544\t    let info = (api.png_create_info_struct)(png);\n545\t    assert!(!info.is_null());\n546\t    (png, info)\n547\t}\n548\t\n549\tpub unsafe fn new_write(api: &Api) -> (*mut PngStruct, *mut PngInfo) {\n550\t    let sh = &libs().shim;\n551\t    let png =\n552\t        (api.png_create_write_struct)(VER, core::ptr::null_mut(), Some(sh.error_fn), Some(warn_cb));\n553\t    assert!(!png.is_null(), \"{}: png_create_write_struct failed\", api.which);\n554\t    let info = (api.png_create_info_struct)(png);\n555\t    assert!(!info.is_null());\n556\t    (png, info)\n557\t}\n558\t\n559\tpub unsafe fn destroy_read(api: &Api, png: *mut PngStruct, info: *mut PngInfo) {\n560\t    let mut p = png;\n561\t    let mut i = info;\n562\t    (api.png_destroy_read_struct)(&mut p, &mut i, core::ptr::null_mut());\n563\t}\n564\t\n565\tpub unsafe fn destroy_write(api: &Api, png: *mut PngStruct, info: *mut PngInfo) {\n566\t    let mut p = png;\n567\t    let mut i = info;\n568\t    (api.png_destroy_write_struct)(&mut p, &mut i);\n569\t}\n570\t"}]},"parent_tool_us