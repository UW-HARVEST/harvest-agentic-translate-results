{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01H1g2whSygWQSGKtNcDq6qn","type":"tool_result","content":"210\t\n211\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n212\tenum RowAct {\n213\t    /// `png_progressive_combine_row` into `tls().rows[row_number]`.\n214\t    Combine,\n215\t    /// Log the raw interlaced pass row the callback was handed.\n216\t    Raw,\n217\t    /// Only log that the callback happened (used where combining would be\n218\t    /// undefined, e.g. a deliberately corrupted `transformed_pixel_depth`).\n219\t    Nothing,\n220\t}\n221\t\n222\t#[derive(Clone)]\n223\tstruct Cfg {\n224\t    /* --- what the info callback does --- */\n225\t    tr: Vec<Tf>,\n226\t    /// call `png_set_interlace_handling` (so the app gets `height` rows/pass)\n227\t    ih: bool,\n228\t    /// `png_read_update_info` (false → `png_start_read_image`)\n229\t    update_info: bool,\n230\t    /// call neither → `row_buf` stays NULL, which libpng has to survive\n231\t    no_row_init: bool,\n232\t    benign: Option<c_int>,\n233\t    act: RowAct,\n234\t\n235\t    /* --- pausing / skipping --- */\n236\t    pause_info: Option<c_int>,\n237\t    pause_end: Option<c_int>,\n238\t    pause_feed: Option<c_int>,\n239\t    skip_feed: bool,\n240\t\n241\t    /* --- struct-wide options installed before the first feed --- */\n242\t    keep_unknown: Option<c_int>,\n243\t    crc_action: Option<(c_int, c_int)>,\n244\t\n245\t    /* --- how the stream is fed --- */\n246\t    sig_bytes: Option<c_int>,\n247\t    /// `png_process_data(..., NULL, 0)` calls after the piece list is exhausted\n248\t    trailing_empty: usize,\n249\t    /// pass a NULL buffer for the trailing empty feeds\n250\t    trailing_null: bool,\n251\t    log_feeds: bool,\n252\t    log_rows: bool,\n253\t\n254\t    /* --- runtime state, filled in by the callbacks --- */\n255\t    rowbytes: usize,\n256\t    width: u32,\n257\t    height: u32,\n258\t    pd: usize,\n259\t    interlaced: bool,\n260\t    info_calls: usize,\n261\t    row_calls: usize,\n262\t    end_calls: usize,\n263\t    pause_ret: usize,\n264\t}\n265\t\n266\timpl Default for Cfg {\n267\t    fn default() -> Self {\n268\t        Cfg {\n269\t            tr: Vec::new(),\n270\t            ih: true,\n271\t            update_info: true,\n272\t            no_row_init: false,\n273\t            benign: None,\n274\t            act: RowAct::Combine,\n275\t            keep_unknown: None,\n276\t            crc_action: None,\n277\t            pause_info: None,\n278\t            pause_end: None,\n279\t            pause_feed: None,\n280\t            skip_feed: false,\n281\t            sig_bytes: None,\n282\t            trailing_empty: 0,\n283\t            trailing_null: false,\n284\t            log_feeds: false,\n285\t            log_rows: true,\n286\t            rowbytes: 0,\n287\t            width: 0,\n288\t            height: 0,\n289\t            pd: 0,\n290\t            interlaced: false,\n291\t            info_calls: 0,\n292\t            row_calls: 0,\n293\t            end_calls: 0,\n294\t            pause_ret: 0,\n295\t        }\n296\t    }\n297\t}\n298\t\n299\tthread_local! {\n300\t    static CFG: std::cell::UnsafeCell<Cfg> = std::cell::UnsafeCell::new(Cfg::default());\n301\t}\n302\t\n303\t/// The active configuration.  A raw pointer, not a `RefCell`: libpng may\n304\t/// `longjmp` straight out of a callback, which would leave a `RefCell`\n305\t/// permanently borrowed.\n306\tfn cfg() -> &'static mut Cfg {\n307\t    let p = CFG.with(|c| c.get());\n308\t    unsafe { &mut *p }\n309\t}\n310\t\n311\tconst PASS_START: [u32; 7] = [0, 4, 0, 2, 0, 1, 0];\n312\tconst PASS_INC: [u32; 7] = [8, 8, 4, 4, 2, 2, 1];\n313\t\n314\t/// Width of the interlaced row of `pass` (`png_ptr->iwidth`).\n315\tfn iwidth(width: u32, interlaced: bool, pass: c_int) -> u32 {\n316\t    if !interlaced {\n317\t        return width;\n318\t    }\n319\t    let p = pass.clamp(0, 6) as usize;\n320\t    (width + PASS_INC[p] - 1 - PASS_START[p]) / PASS_INC[p]\n321\t}\n322\t\n323\tunsafe extern \"C\" fn info_cb(png: *mut PngStruct, info: *mut PngInfo) {\n324\t    let api = cur_api();\n325\t    let c = cfg();\n326\t    c.info_calls += 1;\n327\t    log(format!(\"info_cb #{}\", c.info_calls));\n328\t    log_info(api, png, info, \"info_cb\");\n329\t    if let Some(b) = c.benign {\n330\t        (api.png_set_benign_errors)(png, b);\n331\t    }\n332\t    let trs = c.tr.clone();\n333\t    for t in trs {\n334\t        apply(api, png, t);\n335\t    }\n336\t    c.width = (api.png_get_image_width)(png, info);\n337\t    c.height = (api.png_get_image_height)(png, info);\n338\t    c.interlaced = (api.png_get_interlace_type)(png, info) as c_int == PNG_INTERLACE_ADAM7;\n339\t    if c.interlaced && c.ih {\n340\t        log(format!(\n341\t            \"interlace_handling={}\",\n342\t            (api.png_set_interlace_handling)(png)\n343\t        ));\n344\t    }\n345\t    if !c.no_row_init {\n346\t        if c.update_info {\n347\t            (api.png_read_update_info)(png, info);\n348\t        } else {\n349\t            (api.png_start_read_image)(png);\n350\t        }\n351\t    }\n352\t    log_info(api, png, info, \"after row init\");\n353\t    c.rowbytes = (api.png_get_rowbytes)(png, info);\n354\t    c.pd = (api.png_get_channels)(png, info) as usize * (api.png_get_bit_depth)(png, info) as usize;\n355\t    // The destination rows png_progressive_combine_row writes into.  They must\n356\t    // be *zeroed*: png_combine_row only fills in the pixels of the current pass\n357\t    // and preserves the rest, so an uninitialised buffer would make the\n358\t    // comparison depend on uninitialised heap.\n359\t    tls().rows = vec![vec![0u8; c.rowbytes.max(1)]; (c.height.max(1)) as usize];\n360\t    log(format!(\n361\t        \"info_cb: dest {} rows of {} bytes, pixel_depth={}\",\n362\t        tls().rows.len(),\n363\t        c.rowbytes,\n364\t        c.pd\n365\t    ));\n366\t    if let Some(s) = c.pause_info {\n367\t        let r = (api.png_process_