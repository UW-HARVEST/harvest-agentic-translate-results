{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01NEiF4M6ouGWWpfw5cRs5oV","type":"tool_result","content":"180\t    (*png_ptr).read_row_fn = read_row_fn;\n181\t}\n182\t\n183\t#[unsafe(no_mangle)]\n184\tpub unsafe extern \"C\" fn png_read_png(\n185\t    png_ptr: png_structrp,\n186\t    info_ptr: png_inforp,\n187\t    transforms: c_int,\n188\t    _params: png_voidp,\n189\t) {\n190\t    if png_ptr == core::ptr::null_mut() || info_ptr == core::ptr::null_mut() {\n191\t        return;\n192\t    }\n193\t\n194\t    /* png_read_info() gives us all of the information from the\n195\t     * PNG file before the first IDAT (image data chunk).\n196\t     */\n197\t    png_read_info(png_ptr, info_ptr);\n198\t    if (*info_ptr).height as usize\n199\t        > PNG_UINT_32_MAX as usize / core::mem::size_of::<png_bytep>()\n200\t    {\n201\t        png_error(\n202\t            png_ptr,\n203\t            b\"Image is too high to process with png_read_png()\\0\".as_ptr() as png_const_charp,\n204\t        );\n205\t    }\n206\t\n207\t    /* -------------- image transformations start here ------------------- */\n208\t    /* libpng 1.6.10: add code to cause a png_app_error if a selected TRANSFORM\n209\t     * is not implemented.  This will only happen in de-configured (non-default)\n210\t     * libpng builds.  The results can be unexpected - png_read_png may return\n211\t     * short or mal-formed rows because the transform is skipped.\n212\t     */\n213\t\n214\t    /* Tell libpng to strip 16-bit/color files down to 8 bits per color.\n215\t     */\n216\t    if (transforms & PNG_TRANSFORM_SCALE_16) != 0 {\n217\t        /* Added at libpng-1.5.4. \"strip_16\" produces the same result that it\n218\t         * did in earlier versions, while \"scale_16\" is now more accurate.\n219\t         */\n220\t        png_set_scale_16(png_ptr);\n221\t    }\n222\t\n223\t    /* If both SCALE and STRIP are required pngrtran will effectively cancel the\n224\t     * latter by doing SCALE