       let mut rows: Vec<*mut u8> = vec![ptr::null_mut(); 4];\n1180\t            // Sets PNG_INFO_IDAT ...\n1181\t            (api.png_set_rows)(png, info, rows.as_mut_ptr());\n1182\t            // ... which png_set_rows(NULL) does *not* clear (pngset.c:1789).\n1183\t            (api.png_set_rows)(png, info, ptr::null_mut());\n1184\t            (api.png_write_png)(png, info, 0, ptr::null_mut());\n1185\t        })\n1186\t    });\n1187\t\n1188\t    /* --- rows present but every entry NULL ----------------------------- */\n1189\t    FORKED.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n1190\t    assert_same_forked(\"write_png with NULL rows\", |api| unsafe {\n1191\t        let mut rows: Vec<*mut u8> = vec![ptr::null_mut(); 4];\n1192\t        let rp = rows.as_mut_ptr();\n1193\t        guarded_in_child(api, true, &mut |api, png, info| {\n1194\t            (api.png_set_write_fn)(png, ptr::null_mut(), Some(write_cb), Some(flush_cb));\n1195\t            (api.png_set_IHDR)(\n1196\t                png,\n1197\t                info,\n1198\t                4,\n1199\t                4,\n1200\t                8,\n1201\t                PNG_COLOR_TYPE_RGB,\n1202\t                PNG_INTERLACE_NONE,\n1203\t                PNG_COMPRESSION_TYPE_BASE,\n1204\t                PNG_FILTER_TYPE_BASE,\n1205\t            );\n1206\t            (api.png_set_rows)(png, info, rp);\n1207\t            (api.png_write_png)(png, info, 0, ptr::null_mut());\n1208\t        })\n1209\t    });\n1210\t\n1211\t    eprintln!(\"[highlevel::write_png] {} differential comparisons\", n);\n1212\t    TOTAL.fetch_add(n, std::sync::atomic::Ordering::Relaxed);\n1213\t}\n1214\t\n1215\t/* ------------------------------------------------------------------ */\n1216\t/* C-133: png_read_png + png_write_png round trip                      */\n1217\t/* ------------------------------------------------------------------ */\n1218\t\n1219\t/// `png_read_png` with `t_read`, then `png_write_png` with `t_write` on the\n1220\t///