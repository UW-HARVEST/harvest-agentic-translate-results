id *png_ptr,\n                void (*body)(void *), void *arg)\n{\n   jmp_buf *jb = set_longjmp_fn(png_ptr, longjmp, sizeof(jmp_buf));\n\n   if (jb == NULL)\n      return -1;\n\n   if (setjmp(*jb) != 0)\n      return 1;\n\n   body(arg);\n   return 0;\n}\n\n/* Same, but the body may also be entered when no png_ptr exists yet (the\n * create call itself).  `out` receives the png_ptr the body produced. */\nsize_t harness_jmp_buf_size(void)\n{\n   return sizeof(jmp_buf);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
