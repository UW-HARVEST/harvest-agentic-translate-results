  }\n535\t        o\n536\t    });\n537\t    for pre in 0..=8usize {\n538\t        assert_same(&format!(\"sig_bytes={}\", pre), |api| unsafe {\n539\t            let mut o = Outcome::default();\n540\t            tls().input = file[pre..].to_vec();\n541\t            tls().in_pos = 0;\n542\t            let (png, info) = new_read(api);\n543\t            (api.png_set_read_fn)(png, core::ptr::null_mut(), Some(read_cb));\n544\t            let g = guarded(api, png, &mut || {\n545\t                (api.png_set_sig_bytes)(png, pre as c_int);\n546\t                (api.png_read_info)(png, info);\n547\t                let sig = (api.png_get_signature)(png, info);\n548\t                if sig.is_null() {\n549\t                    log(\"signature=<null>\".to_string());\n550\t                } else {\n551\t                    log(format!(\n552\t                        \"signature={:02x?}\",\n553\t                        core::slice::from_raw_parts(sig, 8)\n554\t                    ));\n555\t                }\n556\t                let rb = (api.png_get_rowbytes)(png, info);\n557\t                let h = (api.png_get_image_height)(png, info) as usize;\n558\t                let mut row = vec![0u8; rb];\n559\t                for _ in 0..h {\n560\t                    (api.png_read_row)(png, row.as_mut_ptr(), core::ptr::null_mut());\n561\t                    log(format!(\"row {:02x?}\", row));\n562\t                }\n563\t                (api.png_read_end)(png, info);\n564\t            });\n565\t            o.push(format!(\"guard={:?}\", g));\n566\t            destroy_read(api, png, info);\n567\t            o\n568\t        });\n569\t    }\n570\t}\n571\t\n572\t/// C-154: `png_read_end` variants and unread rows.\n573\t#[test]\n574\tfn read_end() {\n575\t    let mut rng = Rng::new(0xe4d);\n576\t    let img = Img::random(&mut rng, 10, 8, PNG_COLOR_TYPE_RGB, 8);\n577\t    let mut file = Vec::new();\n578\t    assert_same(\"read_end write\", |api| unsafe {\n579\t        let mut o = Outcome::de