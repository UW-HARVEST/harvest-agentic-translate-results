{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Ao6YM9Vn9L5hXKpNuogYyC","type":"tool_result","content":"1\t//! Reusable \"drive a whole libpng operation\" helpers shared by the test files.\n2\t//!\n3\t//! Everything here goes through `Api` (i.e. through the dlopen'd exports) and\n4\t//! records an event trace, so a scenario built out of these helpers can be run\n5\t//! against both libraries and compared.\n6\t#![allow(dead_code)]\n7\t\n8\tuse super::*;\n9\tuse core::ffi::{c_int, c_void};\n10\t\n11\t/* ------------------------------------------------------------------ */\n12\t/* test images                                                         */\n13\t/* ------------------------------------------------------------------ */\n14\t\n15\t#[derive(Clone, Debug)]\n16\tpub struct Img {\n17\t    pub w: u32,\n18\t    pub h: u32,\n19\t    pub color_type: c_int,\n20\t    pub bit_depth: c_int,\n21\t    pub interlace: c_int,\n22\t    /// Only used when `color_type == PNG_COLOR_TYPE_PALETTE`.\n23\t    pub palette: Vec<png_color>,\n24\t    pub rows: Vec<Vec<u8>>,\n25\t}\n26\t\n27\timpl Img {\n28\t    pub fn rowbytes(&self) -> usize {\n29\t        png_rowbytes(\n30\t            (self.bit_depth as usize) * channels_of(self.color_type),\n31\t            self.w as usize,\n32\t        )\n33\t    }\n34\t\n35\t    /// A random image of the given shape.  Palette indices are kept in range so\n36\t    /// that the default configuration produces no warnings; the\n37\t    /// `check_for_invalid_index` tests deliberately break that.\n38\t    pub fn random(rng: &mut Rng, w: u32, h: u32, color_type: c_int, bit_depth: c_int) -> Img {\n39\t        let mut img = Img {\n40\t            w,\n41\t            h,\n42\t            color_type,\n43\t            bit_depth,\n44\t            interlace: PNG_INTERLACE_NONE,\n45\t            palette: Vec::new(),\n46\t            rows: Vec::new(),\n47\t        };\n48\t        if color_type == PNG_COLOR_TYPE_PALETTE {\n49\t            let n = 1usize << bit_depth.min(8);\n50\t            img.palette = (0..n)\n51\t                .map(|_| png_color {\n52\t                    red: rng.u8(),\n53\t                    green: rng.u8(),\n54\t                    blue: rng.u8(),\n55\t                })\n56\t                .collect();\n57\t        }\n58\t        let rb = img.rowbytes();\n59\t        img.rows = (0..h).map(|_| rng.bytes(rb)).collect();\n60\t        img\n61\t    }\n62\t}\n63\t\n64\t/* ------------------------------------------------------------------ */\n65\t/* writing                                                             */\n66\t/* ------------------------------------------------------------------ */\n67\t\n68\t#[derive(Clone, Default, Debug)]\n69\tpub struct WriteOpts {\n70\t    pub filter_mask: Option<c_int>,\n71\t    pub level: Option<c_int>,\n72\t    pub strategy: Option<c_int>,\n73\t    pub mem_level: Option<c_int>,\n74\t    pub window_bits: Option<c_int>,\n75\t    pub method: Option<c_int>,\n76\t    pub buffer_size: Option<usize>,\n77\t    /// Write the rows with `png_write_image` instead of row by row.\n78\t    pub bulk: bool,\n79\t    /// Call `png_write_rows` with this many rows at a time (0 = one by one).\n80\t    pub rows_at_a_time: usize,\n81\t    pub flush_every: Option<c_int>,\n82\t    pub status_fn: bool,\n83\t}\n84\t\n85\t/// The result of driving a complete write.\n86\tpub struct Written {\n87\t    pub bytes: Vec<u8>,\n88\t    pub guard: Guard,\n89\t}\n90\t\n91\t/// Drive a complete libpng write.  `extra` runs after `png_set_IHDR` (and after\n92\t/// `png_set_PLTE` for palette images) but before `png_write_info`, which is\n93\t/// where an application installs chunks and write transforms.\n94\tpub unsafe fn write_image(\n95\t    api: &Api,\n96\t    img: &Img,\n97\t    opts: &WriteOpts,\n98\t    extra: &mut dyn FnMut(&Api, *mut PngStruct, *mut PngInfo),\n99\t) -> Written {\n100\t    let (png, info) = new_write(api);\n101\t    (api.png_set_write_fn)(png, core::ptr::null_mut(), Some(write_cb), Some(flush_cb));\n102\t    if opts.status_fn {\n103\t        (api.png_set_write_status_fn)(png, Some(write_status_cb));\n104\t    }\n105\t    if let Some(n) = opts.buffer_size {\n106\t        (api.png_set_compression_buffer_size)(png, n);\n107\t    }\n108\t    if let Some(v) = opts.level {\n109\t        (api.png_set_compression_level)(png, v);\n110\t    }\n111\t    if let Some(v) = opts.strategy {\n112\t        (api.png_set_compression_strategy)(png, v);\n113\t    }\n114\t    if let Some(v) = opts.mem_level {\n115\t        (api.png_set_compression_mem_level)(png, v);\n116\t    }\n117\t    if let Some(v) = opts.window_bits {\n118\t        (api.png_set_compression_window_bits)(png, v);\n119\t    }\n120\t    if let Some(v) = opts.method {\n121\t        (api.png_set_compression_method)(png, v);\n122\t    }\n123\t    if let Some(v) = opts.flush_every {\n124\t        (api.png_set_flush)(png, v);\n125\t    }\n126\t\n127\t    let guard = guarded(api, png, &mut || {\n128\t        (api.png_set_IHDR)(\n129\t            png,\n130\t            info,\n131\t            img.w,\n132\t            img.h,\n133\t            img.bit_depth,\n134\t            img.color_type,\n135\t            img.interlace,\n136\t            PNG_COMPRESSION_TYPE_BASE,\n137\t            PNG_FILTER_TYPE_BASE,\n138\t        );\n139\t        if img.color_type == PNG_COLOR_TYPE_PALETTE && !img.palette.is_empty() {\n140\t            (api.png_set_PLTE)(\n141\t                png,\n142\t                info,\n143\t                img.palette.as_ptr(),\n144\t                img.palette.len() as c_int,\n145\t            );\n146\t        }\n147\t        extra(api, png, info);\n148\t        if let Some(m) = opts.filter_mask {\n149\t            (api.png_set_filter)(png, PNG_FILTER_TYPE_BASE, m);\n150\t        }\n151\t        (api.png_write_info)(png, info);\n152\t        let passes = if img.interlace == PNG_INTERLACE_ADAM7 {\n153\t            (api.png_set_interlace_handling)(png)\n154\t        } else {\n155\t            1\n156\t        };\n157\t        log(format!(\"write passes={}\", passes));\n158\t        if opts.bulk {\n159\t            let mut ptrs: Vec<*mut u8> = img.rows.iter().map(|r| r.as_ptr() as *mut u8).collect();\n160\t            (api.png_write_image)(png, ptrs.as_mut_ptr());\n161\t        } else if opts.rows_at_a_time > 0 {\n162\t            for _ in 0..passes {\n163\t                let mut i = 0;\n164\t                while i < img.rows.len() {\n165\t                    let n = opts.rows_at_a_time.min(img.rows.len() - i);\n166\t                    let mut ptrs: Vec<*mut u8> = img.rows[i..i + n]\n167\t                        .iter()\n168\t                        .map(|r| r.as_ptr() as *mut u8)\n169\t                        .collect();\n170\t                    (api.png_write_rows)(png, ptrs.as_mut_ptr(), n as u32);\n171\t                    i += n;\n172\t                }\n173\t            }\n174\t        } else {\n175\t            for _ in 0..passes {\n176\t                for r in &img.rows {\n177\t                    (api.png_write_row)(png, r.as_ptr() as *mut u8);\n178\t                }\n179\t            }\n180\t        }\n181\t        (api.png_write_end)(png, info);\n182\t    });\n183\t    log(format!(\"write guard={:?} flushes={}\", guard, tls().flushes));\n184\t    destroy_write(api, png, info);\n185\t    Written {\n186\t        bytes: std::mem::take(&mut tls().output),\n187\t        guard,\n188\t    }\n189\t}\n190\t\n191\t/// A plain write with no extra chunks or transforms.\n192\tpub unsafe fn write_plain(api: &Api, img: &Img, opts: &WriteOpts) -> Written {\n193\t    write_image(api, img, opts, &mut |_, _, _| {})\n194\t}\n195\t\n196\t/* ------------------------------------------------------------------ */\n197\t/* reading                                                             */\n198\t/* ------------------------------------------------------------------ */\n199\t\n200\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n201\tpub enum RowMode {\n202\t    /// `png_read_row` once per row per pass.\n203\t    Row,\n204\t    /// `png_read_row` with a non-NULL `display_row`.\n205\t    RowDisplay,\n206\t    /// `png_read_rows` with `n` rows at a time.\n207\t    Rows(usize),\n208\t    /// `png_read_image`.\n209\t    Image,\n210\t    /// Do not read any rows at all.\n211\t    None,\n212\t}\n213\t\n214\t#[derive(Clone, Debug)]\n215\tpub struct ReadOpts {\n216\t    pub rows: RowMode,\n217\t    pub update_info: bool,\n218\t    pub status_fn: bool,\n219\t    pub read_end: bool,\n220\t    /// `png_read_end(png, NULL)` instead of `png_read_end(png, info)`.\n221\t    pub end_null_info: bool,\n222\t}\n223\t\n224\timpl Default for ReadOpts {\n225\t    fn default() -> Self {\n226\t        ReadOpts {\n227\t            rows: RowMode::Row,\n228\t            update_info: true,\n229\t            status_fn: false,\n230\t            read_end: true,\n231\t            end_null_info: false,\n232\t        }\n233\t    }\n234\t}\n235\t\n236\tpub struct ReadResult {\n237\t    pub guard: Guard,\n238\t    pub rows: Vec<Vec<u8>>,\n239\t}\n240\t\n241\t/// Log everything `png_get_*` reports about the current info state.\n242\tpub unsafe fn log_info(api: &Api, png: *mut PngStruct, info: *mut PngInfo, tag: &str) {\n243\t    let mut w = 0u32;\n244\t    let mut h = 0u32;\n245\t    let mut d = 0;\n246\t    let mut ct = 0;\n247\t    let mut il = 0;\n248\t    let mut comp = 0;\n249\t    let mut filt = 0;\n250\t    let r = (api.png_get_IHDR)(\n251\t        png, info, &mut w, &mut h, &mut d, &mut ct, &mut il, &mut comp, &mut filt,\n252\t    );\n253\t    log(format!(\n254\t        \"{}: IHDR r={} {}x{} depth={} color={} il={} comp={} filter={}\",\n255\t        tag, r, w, h, d, ct, il, comp, filt\n256\t    ));\n257\t    log(format!(\n258\t        \"{}: rowbytes={} channels={} valid=0x{:x} palette_max={}\",\n259\t        tag,\n260\t        (api.png_get_rowbytes)(png, info),\n261\t        (api.png_get_channels)(png, info),\n262\t        (api.png_get_valid)(png, info, 0xffffffff),\n263\t        (api.png_get_palette_max)(png, info)\n264\t    ));\n265\t}\n266\t\n267\t/// Drive a complete libpng read.  `setup` runs after `png_read_info`, which is\n268\t/// where an application installs read transforms and inspects the info struct.\n269\tpub unsafe fn read_image(\n270\t    api: &Api,\n271\t    data: &[u8],\n272\t    opts: &ReadOpts,\n273\t    setup: &mut dyn FnMut(&Api, *mut PngStruct, *mut PngInfo),\n274\t) -> ReadResult {\n275\t    tls().input = data.to_vec();\n276\t    tls().in_pos = 0;\n277\t    let (png, info) = new_read(api);\n278\t    (api.png_set_read_fn)(png, core::ptr::null_mut(), Some(read_cb));\n279\t    if opts.status_fn {\n280\t        (api.png_set_read_status_fn)(png, Some(read_status_cb));\n281\t    }\n282\t    let mut out: Vec<Vec<u8>> = Vec::new();\n283\t    let guard = guarded(api, png, &mut || {\n284\t        (api.png_read_info)(png, info);\n285\t        log_info(api, png, info, \"after read_info\");\n286\t        setup(api, png, info);\n287\t        if opts.update_info {\n288\t            (api.png_read_update_info)(png, info);\n289\t            log_info(api, png, info, \"after update_info\");\n290\t        }\n291\t        let h = (api.png_get_image_height)(png, info) as usize;\n292\t        let rb = (api.png_get_rowbytes)(png, info);\n293\t        let passes = if (api.png_get_interlace_type)(png, info) as c_int == PNG_INTERLACE_ADAM7 {\n294\t            7\n295\t        } else {\n296\t            1\n297\t        };\n298\t        out = vec![vec![0u8; rb]; h];\n299\t        match opts.rows {\n300\t            RowMode::None => {}\n301\t            RowMode::Row | RowMode::RowDisplay => {\n302\t                let mut disp = vec![vec![0u8; rb]; h];\n303\t                for _ in 0..passes {\n304\t                    for y in 0..h {\n305\t                        let d = if opts.rows == RowMode::RowDisplay {\n306\t                            disp[y].as_mut_ptr()\n307\t                        } else {\n308\t                            core::ptr::null_mut()\n309\t                        };\n310\t                        (api.png_read_row)(png, out[y].as_mut_ptr(), d);\n311\t                    }\n312\t                }\n313\t                if opts.rows == RowMode::RowDisplay {\n314\t                    for (y, d) in disp.iter().enumerate() {\n315\t                        log(format!(\"display row {}: {:02x?}\", y, d));\n316\t                    }\n317\t                }\n318\t            }\n319\t            RowMode::Rows(n) => {\n320\t                let n = n.max(1);\n321\t                for _ in 0..passes {\n322\t                    let mut y = 0;\n323\t                    while y < h {\n324\t                        let k = n.min(h - y);\n325\t                        let mut ptrs: Vec<*mut u8> =\n326\t                            out[y..y + k].iter().map(|r| r.as_ptr() as *mut u8).collect();\n327\t                        (api.png_read_rows)(\n328\t                            png,\n329\t                            ptrs.as_mut_ptr(),\n330\t                            core::ptr::null_mut(),\n331\t                            k as u32,\n332\t                        );\n333\t                        y += k;\n334\t                    }\n335\t                }\n336\t            }\n337\t            RowMode::Image => {\n338\t                let mut ptrs: Vec<*mut u8> = out.iter().map(|r| r.as_ptr() as *mut u8).collect();\n339\t                (api.png_read_image)(png, ptrs.as_mut_ptr());\n340\t            }\n341\t        }\n342\t        if opts.read_end {\n343\t            if opts.end_null_info {\n344\t                (api.png_read_end)(png, core::ptr::null_mut());\n345\t            } else {\n346\t                (api.png_read_end)(png, info);\n347\t                log_info(api, png, info, \"after read_end\");\n348\t            }\n349\t        }\n350\t    });\n351\t    log(format!(\"read guard={:?}\", guard));\n352\t    for (y, r) in out.iter().enumerate() {\n353\t        log(format!(\"row {}: {:02x?}\", y, r));\n354\t    }\n355\t    destroy_read(api, png, info);\n356\t    ReadResult { guard, rows: out }\n357\t}\n358\t\n359\tpub unsafe fn read_plain(api: &Api, data: &[u8], opts: &ReadOpts) -> ReadResult {\n360\t    read_image(api, data, opts, &mut |_, _, _| {})\n361\t}\n362\t\n363\t/* ------------------------------------------------------------------ */\n364\t/* building a PNG datastream by hand                                   */\n365\t/* ------------------------------------------------------------------ */\n366\t\n367\tpub const SIG: [u8; 8] = [137, 80, 78, 71, 13, 10, 26, 10];\n368\t\n369\t/// CRC-32 as used by PNG (zlib's polynomial).\n370\tpub fn crc32(data: &[u8]) -> u32 {\n371\t    static mut TABLE: [u32; 256] = [0; 256];\n372\t    static ONCE: std::sync::Once = std::sync::Once::new();\n373\t    unsafe {\n374\t        ONCE.call_once(|| {\n375\t            for n in 0..256u32 {\n376\t                let mut c = n;\n377\t                for _ in 0..8 {\n378\t                    c = if c & 1 != 0 { 0xedb88320 ^ (c >> 1) } else { c >> 1 };\n379\t                }\n380\t                TABLE[n as usize] = c;\n381\t            }\n382\t        });\n383\t        let mut c = 0xffffffffu32;\n384\t        for &b in data {\n385\t            c = TABLE[((c ^ b as u32) & 0xff) as usize] ^ (c >> 8);\n386\t        }\n387\t        c ^ 0xffffffff\n388\t    }\n389\t}\n390\t\n391\t/// A raw PNG chunk: length, type, data, CRC.\n392\tpub fn chunk(name: &[u8; 4], data: &[u8]) -> Vec<u8> {\n393\t    let mut v = Vec::with_capacity(data.len() + 12);\n394\t    v.extend_from_slice(&(data.len() as u32).to_be_bytes());\n395\t    v.extend_from_slice(name);\n396\t    v.extend_from_slice(data);\n397\t    let mut crc_input = name.to_vec();\n398\t    crc_input.extend_from_slice(data);\n399\t    v.extend_from_slice(&crc32(&crc_input).to_be_bytes());\n400\t    v\n401\t}\n402\t\n403\t/// A chunk with a deliberately wrong CRC.\n404\tpub fn chunk_bad_crc(name: &[u8; 4], data: &[u8]) -> Vec<u8> {\n405\t    let mut v = chunk(name, data);\n406\t    let n = v.len();\n407\t    v[n - 1] ^= 0xff;\n408\t    v\n409\t}\n410\t\n411\t/// Split a PNG datastream into `(header, chunks..)` so tests can insert chunks.\n412\tpub fn split_chunks(png: &[u8]) -> Vec<(String, std::ops::Range<usize>)> {\n413\t    let mut out = Vec::new();\n414\t    let mut i = 8;\n415\t    while i + 8 <= png.len() {\n416\t        let len = u32::from_be_bytes([png[i], png[i + 1], png[i + 2], png[i + 3]]) as usize;\n417\t        let name = String::from_utf8_lossy(&png[i + 4..i + 8]).into_owned();\n418\t        let end = i + 12 + len;\n419\t        if end > png.len() {\n420\t            break;\n421\t        }\n422\t        out.push((name, i..end));\n423\t        i = end;\n424\t    }\n425\t    out\n426\t}\n427\t\n428\t/// Insert `extra` immediately before the first chunk named `before`.\n429\tpub fn insert_before(png: &[u8], before: &str, extra: &[u8]) -> Vec<u8> {\n430\t    let chunks = split_chunks(png);\n431\t    let at = chunks\n432\t        .iter()\n433\t        .find(|(n, _)| n == before)\n434\t        .map(|(_, r)| r.start)\n435\t        .unwrap_or(png.len());\n436\t    let mut v = png[..at].to_vec();\n437\t    v.extend_from_slice(extra);\n438\t    v.extend_from_slice(&png[at..]);\n439\t    v\n440\t}\n441\t\n442\tpub fn insert_after_last(png: &[u8], after: &str, extra: &[u8]) -> Vec<u8> {\n443\t    let chunks = split_chunks(png);\n444\t    let at = chunks\n445\t        .iter()\n446\t        .filter(|(n, _)| n == after)\n447\t        .next_back()\n448\t        .map(|(_, r)| r.end)\n449\t        .unwrap_or(png.len());\n450\t    let mut v = png[..at].to_vec();\n451\t    v.extend_from_slice(extra);\n452\t    v.extend_from_slice(&png[at..]);\n453\t    v\n454\t}\n455\t\n456\t/// A minimal valid PNG built entirely by hand (so the *reader* is the only\n457\t/// thing under test).  1x1, 8-bit gray, one IDAT.\n458\tpub fn handmade_gray1x1() -> Vec<u8> {\n459\t    let mut ihdr = Vec::new();\n460\t    ihdr.extend_from_slice(&1u32.to_be_bytes());\n461\t    ihdr.extend_from_slice(&1u32.to_be_bytes());\n462\t    ihdr.extend_from_slice(&[8, 0, 0, 0, 0]);\n463\t    // zlib stream for a single row: filter 0 + one byte, stored (level 0).\n464\t    let raw = [0u8, 0x80u8];\n465\t    let mut z = vec![0x78, 0x01, 0x01, 0x02, 0x00, 0xfd, 0xff];\n466\t    z.extend_from_slice(&raw);\n467\t    let mut adler: (u32, u32) = (1, 0);\n468\t    for &b in &raw {\n469\t        adler.0 = (adler.0 + b as u32) % 65521;\n470\t        adler.1 = (adler.1 + adler.0) % 65521;\n471\t    }\n472\t    z.extend_from_slice(&(((adler.1) << 16) | adler.0).to_be_bytes());\n473\t    let mut v = SIG.to_vec();\n474\t    v.extend_from_slice(&chunk(b\"IHDR\", &ihdr));\n475\t    v.extend_from_slice(&chunk(b\"IDAT\", &z));\n476\t    v.extend_from_slice(&chunk(b\"IEND\", &[]));\n477\t    v\n478\t}\n479\t\n480\t/* ------------------------------------------------------------------ */\n481\t/* misc callbacks used by several test files                           */\n482\t/* ------------------------------------------------------------------ */\n483\t\n484\tpub unsafe extern \"C\" fn user_transform_cb(\n485\t    _png: *mut PngStruct,\n486\t    row_info: *mut png_row_info,\n487\t    row: *mut u8,\n488\t) {\n489\t    let ri = *row_info;\n490\t    log(format!(\n491\t        \"user_transform w={} rowbytes={} ct={} bd={} ch={} pd={}\",\n492\t        ri.width, ri.rowbytes, ri.color_type, ri.bit_depth, ri.channels, ri.pixel_depth\n493\t    ));\n494\t    // A deterministic, in-place mangle so the effect is visible in the output.\n495\t    for i in 0..ri.rowbytes {\n496\t        *row.add(i) = (*row.add(i)).rotate_left(3) ^ (i as u8);\n497\t    }\n498\t}\n499\t\n500\tpub unsafe extern \"C\" fn malloc_cb(png: *mut PngStruct, size: usize) -> *mut c_void {\n501\t    let t = tls();\n502\t    t.alloc_serial += 1;\n503\t    let serial = t.alloc_serial;\n504\t    let p = libc_malloc(size.max(1));\n505\t    t.allocs.push((serial as usize, size));\n506\t    log(format!(\"malloc #{} size={} ok={}\", serial, size, !p.is_null()));\n507\t    let _ = png;\n508\t    p\n509\t}\n510\t\n511\tpub unsafe extern \"C\" fn free_cb(_png: *mut PngStruct, p: *mut c_void) {\n512\t    tls().counter += 1;\n513\t    libc_free(p);\n514\t}\n515\t\n516\textern \"C\" {\n517\t    #[link_name = \"malloc\"]\n518\t    fn libc_malloc(n: usize) -> *mut c_void;\n519\t    #[link_name = \"free\"]\n520\t    fn libc_free(p: *mut c_void);\n521\t}\n522\t"}]},"parent_tool_use_id":"toolu_bdrk_01Q2LumuFA2ZNcudyRk6z47M","session_id":"309de29f-cb7a-4138-9016-7ab2e7ef6079","uuid":"99f36746-cfe3-4938-ad0b-b9537b840b42","timestamp":"2026-08-23T04:02:18.869Z","subagent_type":"general-purpose","task_description":"Close remaining error-surface gaps"}
