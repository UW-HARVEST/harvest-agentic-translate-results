{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JcmGNUf85bktaSFrkuCfCS","type":"tool_result","content":"1\t//! Phase B — the low-level sequential write and read entry points.\n2\t//!\n3\t//! Covers CONFIGS.md rows C-26 … C-64 (the colour-type × bit-depth × interlace\n4\t//! matrix and the write-side option axes).\n5\t#![allow(non_snake_case)]\n6\t\n7\tmod common;\n8\t\n9\tuse common::*;\n10\tuse core::ffi::c_int;\n11\t\n12\tconst SIZES: [(u32, u32); 12] = [\n13\t    (1, 1),\n14\t    (1, 7),\n15\t    (7, 1),\n16\t    (2, 3),\n17\t    (3, 2),\n18\t    (5, 5),\n19\t    (8, 8),\n20\t    (9, 5),\n21\t    (15, 2),\n22\t    (16, 16),\n23\t    (17, 3),\n24\t    (33, 4),\n25\t];\n26\t\n27\t/// C-26 … C-55: every legal (colour type, bit depth) × interlace, randomised\n28\t/// over size, pixel data, filter mask and zlib level.\n29\t#[test]\n30\tfn matrix() {\n31\t    for (ct, bd) in VALID_SHAPES {\n32\t        for il in [PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n33\t            for (si, &(w, h)) in SIZES.iter().enumerate() {\n34\t                let mut rng = Rng::new(\n35\t                    0x5eed ^ ((ct as u64) << 40) ^ ((bd as u64) << 32) ^ ((il as u64) << 24) ^ si as u64,\n36\t                );\n37\t                let mut img = Img::random(&mut rng, w, h, ct, bd);\n38\t                img.interlace = il;\n39\t                let opts = WriteOpts {\n40\t                    filter_mask: Some(rng.pick(&[\n41\t                        PNG_NO_FILTERS,\n42\t                        PNG_FILTER_NONE,\n43\t                        PNG_FILTER_SUB,\n44\t                        PNG_FILTER_UP,\n45\t                        PNG_FILTER_AVG,\n46\t                        PNG_FILTER_PAETH,\n47\t                        PNG_FAST_FILTERS,\n48\t                        PNG_ALL_FILTERS,\n49\t                    ])),\n50\t                    level: Some(rng.range(0, 10) as c_int),\n51\t                    status_fn: true,\n52\t                    ..Default::default()\n53\t                };\n54\t                let case = format!(\"write ct={} bd={} il={} {}x{}\", ct, bd, il, w, h);\n55\t                let mut file: Vec<u8> = Vec::new();\n56\t                assert_same(&case, |api| unsafe {\n57\t                    let mut o = Outcome::default();\n58\t                    let wr = write_image(api, &img, &opts, &mut |_, _, _| {});\n59\t                    o.push(format!(\"guard={:?}\", wr.guard));\n60\t                    o.output = wr.bytes.clone();\n61\t                    if api.which == \"C\" {\n62\t                        file = wr.bytes.clone();\n63\t                    }\n64\t                    o\n65\t                });\n66\t                assert!(!file.is_empty(), \"{}: nothing written\", case);\n67\t\n68\t                // and read it straight back with both libraries\n69\t                let ropts = ReadOpts {\n70\t                    status_fn: true,\n71\t                    ..Default::default()\n72\t                };\n73\t                assert_same(&format!(\"read back {}\", case), |api| unsafe {\n74\t                    let mut o = Outcome::default();\n75\t                    let rr = read_plain(api, &file, &ropts);\n76\t                    o.push(format!(\"guard={:?}\", rr.guard));\n77\t                    for r in &rr.rows {\n78\t                        o.output.extend_from_slice(r);\n79\t                    }\n80\t                    o\n81\t                });\n82\t            }\n83\t        }\n84\t    }\n85\t}\n86\t\n87\t/// C-56: `png_write_rows` / `png_write_image` / `png_read_rows` /\n88\t/// `png_read_image` instead of the one-row entry points.\n89\t#[test]\n90\tfn bulk_rows() {\n91\t    for (ct, bd) in VALID_SHAPES {\n92\t        for il in [PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n93\t            let mut rng = Rng::new(0xb01c ^ ((ct as u64) << 8) ^ bd as u64 ^ ((il as u64) << 16));\n94\t            let mut img = Img::random(&mut rng, 11, 6, ct, bd);\n95\t            img.interlace = il;\n96\t            for (tag, opts) in [\n97\t                (\n98\t                    \"write_image\",\n99\t                    WriteOpts {\n100\t                        bulk: true,\n101\t                        ..Default::default()\n102\t                    },\n103\t                ),\n104\t                (\n105\t                    \"write_rows(1)\",\n106\t                    WriteOpts {\n107\t                        rows_at_a_time: 1,\n108\t                        ..Default::default()\n109\t                    },\n110\t                ),\n111\t                (\n112\t                    \"write_rows(4)\",\n113\t                    WriteOpts {\n114\t                        rows_at_a_time: 4,\n115\t                        ..Default::default()\n116\t                    },\n117\t                ),\n118\t            ] {\n119\t                let case = format!(\"{} ct={} bd={} il={}\", tag, ct, bd, il);\n120\t                let mut file = Vec::new();\n121\t                assert_same(&case, |api| unsafe {\n122\t                    let mut o = Outcome::default();\n123\t                    let wr = write_image(api, &img, &opts, &mut |_, _, _| {});\n124\t                    o.push(format!(\"guard={:?}\", wr.guard));\n125\t                    o.output = wr.bytes.clone();\n126\t                    if api.which == \"C\" {\n127\t                        file = wr.bytes.clone();\n128\t                    }\n129\t                    o\n130\t                });\n131\t                for mode in [\n132\t                    RowMode::Row,\n133\t                    RowMode::RowDisplay,\n134\t                    RowMode::Rows(1),\n135\t                    RowMode::Rows(3),\n136\t                    RowMode::Image,\n137\t                ] {\n138\t                    let ropts = ReadOpts {\n139\t                        rows: mode,\n140\t                        ..Default::default()\n141\t                    };\n142\t                    assert_same(&format!(\"{} read {:?}\", case, mode), |api| unsafe {\n143\t                        let mut o = Outcome::default();\n144\t                        let rr = read_plain(api, &file, &ropts);\n145\t                        o.push(format!(\"guard={:?}\", rr.guard));\n146\t                        for r in &rr.rows {\n147\t                            o.output.extend_from_slice(r);\n148\t                        }\n149\t                        o\n150\t                    });\n151\t                }\n152\t            }\n153\t        }\n154\t    }\n155\t}\n156\t\n157\t/// C-57: every filter mask, including changing it between rows.\n158\t#[test]\n159\tfn filters() {\n160\t    let masks = [\n161\t        PNG_NO_FILTERS,\n162\t        PNG_FILTER_NONE,\n163\t        PNG_FILTER_SUB,\n164\t        PNG_FILTER_UP,\n165\t        PNG_FILTER_AVG,\n166\t        PNG_FILTER_PAETH,\n167\t        PNG_FAST_FILTERS,\n168\t        PNG_ALL_FILTERS,\n169\t        PNG_FILTER_SUB | PNG_FILTER_PAETH,\n170\t        PNG_FILTER_NONE | PNG_FILTER_AVG,\n171\t    ];\n172\t    for (ct, bd) in VALID_SHAPES {\n173\t        for &m in &masks {\n174\t            let mut rng = Rng::new(0xf117 ^ (m as u64) ^ ((ct as u64) << 16) ^ ((bd as u64) << 24));\n175\t            let img = Img::random(&mut rng, 13, 7, ct, bd);\n176\t            let opts = WriteOpts {\n177\t                filter_mask: Some(m),\n178\t                ..Default::default()\n179\t            };\n180\t            assert_same(\n181\t                &format!(\"filter mask 0x{:02x} ct={} bd={}\", m, ct, bd),\n182\t                |api| unsafe {\n183\t                    let mut o = Outcome::default();\n184\t                    let wr = write_plain(api, &img, &opts);\n185\t                    o.push(format!(\"guard={:?}\", wr.guard));\n186\t                    o.output = wr.bytes.clone();\n187\t                    o\n188\t                },\n189\t            );\n190\t        }\n191\t    }\n192\t    // change the mask between rows\n193\t    let mut rng = Rng::new(0xf118);\n194\t    let img = Img::random(&mut rng, 20, 9, PNG_COLOR_TYPE_RGB, 8);\n195\t    assert_same(\"filter mask changed per row\", |api| unsafe {\n196\t        let mut o = Outcome::default();\n197\t        let (png, info) = new_write(api);\n198\t        (api.png_set_write_fn)(png, core::ptr::null_mut(), Some(write_cb), Some(flush_cb));\n199\t        let g = guarded(api, png, &mut || {\n200\t            (api.png_set_IHDR)(\n201\t                png,\n202\t                info,\n203\t                img.w,\n204\t                img.h,\n205\t                img.bit_depth,\n206\t                img.color_type,\n207\t                PNG_INTERLACE_NONE,\n208\t                PNG_COMPRESSION_TYPE_BASE,\n209\t                PNG_FILTER_TYPE_BASE,\n210\t            );\n211\t            (api.png_write_info)(png, info);\n212\t            for (i, r) in img.rows.iter().enumerate() {\n213\t                (api.png_set_filter)(png, PNG_FILTER_TYPE_BASE, masks[i % masks.len()]);\n214\t                (api.png_write_row)(png, r.as_ptr() as *mut u8);\n215\t            }\n216\t            (api.png_write_end)(png, info);\n217\t        });\n218\t        o.push(format!(\"guard={:?}\", g));\n219\t        o.output = std::mem::take(&mut tls().output);\n220\t        destroy_write(api, png, info);\n221\t        o\n222\t    });\n223\t}\n224\t\n225\t/// C-58: the zlib knobs.\n226\t#[test]\n227\tfn zlib_knobs() {\n228\t    let mut rng = Rng::new(0x21_1b);\n229\t    let img = Img::random(&mut rng, 24, 12, PNG_COLOR_TYPE_RGB, 8);\n230\t    for level in [-1, 0, 1, 5, 9] {\n231\t        for strategy in [0, 1, 2, 3, 4] {\n232\t            let opts = WriteOpts {\n233\t                level: Some(level),\n234\t                strategy: Some(strategy),\n235\t                ..Default::default()\n236\t            };\n237\t            assert_same(&format!(\"level={} strategy={}\", level, strategy), |api| unsafe {\n238\t                let mut o = Outcome::default();\n239\t                let wr = write_plain(api, &img, &opts);\n240\t                o.push(format!(\"guard={:?}\", wr.guard));\n241\t                o.output = wr.bytes.clone();\n242\t                o\n243\t            });\n244\t        }\n245\t    }\n246\t    for mem_level in [1, 2, 5, 8, 9] {\n247\t        for wbits in [8, 9, 11, 14, 15] {\n248\t            let opts = WriteOpts {\n249\t                mem_level: Some(mem_level),\n250\t                window_bits: Some(wbits),\n251\t                ..Default::default()\n252\t            };\n253\t            assert_same(\n254\t                &format!(\"mem_level={} window_bits={}\", mem_level, wbits),\n255\t                |api| unsafe {\n256\t                    let mut o = Outcome::default();\n257\t                    let wr = write_plain(api, &img, &opts);\n258\t                    o.push(format!(\"guard={:?}\", wr.guard));\n259\t                    o.output = wr.bytes.clone();\n260\t                    o\n261\t                },\n262\t            );\n263\t        }\n264\t    }\n265\t    // out-of-range values: libpng clamps them and warns\n266\t    for (tag, opts) in [\n267\t        (\n268\t            \"level=-2\",\n269\t            WriteOpts {\n270\t                level: Some(-2),\n271\t                ..Default::default()\n272\t            },\n273\t        ),\n274\t        (\n275\t            \"level=10\",\n276\t            WriteOpts {\n277\t                level: Some(10),\n278\t                ..Default::default()\n279\t            },\n280\t        ),\n281\t        (\n282\t            \"strategy=5\",\n283\t            WriteOpts {\n284\t                strategy: Some(5),\n285\t                ..Default::default()\n286\t            },\n287\t        ),\n288\t        (\n289\t            \"mem_level=0\",\n290\t            WriteOpts {\n291\t                mem_level: Some(0),\n292\t                ..Default::default()\n293\t            },\n294\t        ),\n295\t        (\n296\t            \"mem_level=10\",\n297\t            WriteOpts {\n298\t                mem_level: Some(10),\n299\t                ..Default::default()\n300\t            },\n301\t        ),\n302\t        (\n303\t            \"window_bits=7\",\n304\t            WriteOpts {\n305\t                window_bits: Some(7),\n306\t                ..Default::default()\n307\t            },\n308\t        ),\n309\t        (\n310\t            \"window_bits=16\",\n311\t            WriteOpts {\n312\t                window_bits: Some(16),\n313\t                ..Default::default()\n314\t            },\n315\t        ),\n316\t        (\n317\t            \"window_bits=-15\",\n318\t            WriteOpts {\n319\t                window_bits: Some(-15),\n320\t                ..Default::default()\n321\t            },\n322\t        ),\n323\t        (\n324\t            \"method=7\",\n325\t            WriteOpts {\n326\t                method: Some(7),\n327\t                ..Default::default()\n328\t            },\n329\t        ),\n330\t    ] {\n331\t        assert_same(tag, |api| unsafe {\n332\t            let mut o = Outcome::default();\n333\t            let wr = write_plain(api, &img, &opts);\n334\t            o.push(format!(\"guard={:?}\", wr.guard));\n335\t            o.output = wr.bytes.clone();\n336\t            o\n337\t        });\n338\t    }\n339\t}\n340\t\n341\t/// C-59: `png_set_compression_buffer_size` / `png_get_compression_buffer_size`.\n342\t#[test]\n343\tfn buffer_size() {\n344\t    let mut rng = Rng::new(0xb_0f5);\n345\t    let img = Img::random(&mut rng, 40, 30, PNG_COLOR_TYPE_RGB_ALPHA, 8);\n346\t    for n in [1usize, 2, 3, 8, 100, 1024, 8192, 65536] {\n347\t        let opts = WriteOpts {\n348\t            buffer_size: Some(n),\n349\t            ..Default::default()\n350\t        };\n351\t        assert_same(&format!(\"buffer_size={}\", n), |api| unsafe {\n352\t            let mut o = Outcome::default();\n353\t            let (png, _info) = new_write(api);\n354\t            (api.png_set_compression_buffer_size)(png, n);\n355\t            o.push(format!(\n356\t                \"get_compression_buffer_size={}\",\n357\t                (api.png_get_compression_buffer_size)(png)\n358\t            ));\n359\t            destroy_write(api, png, core::ptr::null_mut());\n360\t            let wr = write_plain(api, &img, &opts);\n361\t            o.push(format!(\"guard={:?}\", wr.guard));\n362\t            o.output = wr.bytes.clone();\n363\t            o\n364\t        });\n365\t    }\n366\t}\n367\t\n368\t/// C-60: the raw chunk writer.\n369\t#[test]\n370\tfn raw_chunks() {\n371\t    let names: [&[u8; 4]; 6] = [b\"IHDR\", b\"tEXt\", b\"prVt\", b\"PrVt\", b\"pRvT\", b\"ReSe\"];\n372\t    for name in names {\n373\t        for len in [0usize, 1, 7, 8191, 8192, 8193] {\n374\t            for pieces in [1usize, 2, 5] {\n375\t                let mut rng = Rng::new(0xc4c4 ^ len as u64 ^ ((pieces as u64) << 20));\n376\t                let data = rng.bytes(len);\n377\t                assert_same(\n378\t                    &format!(\n379\t                        \"raw chunk {} len={} pieces={}\",\n380\t                        String::from_utf8_lossy(name),\n381\t                        len,\n382\t                        pieces\n383\t                    ),\n384\t                    |api| unsafe {\n385\t                        let mut o = Outcome::default();\n386\t                        let (png, _info) = new_write(api);\n387\t                        (api.png_set_write_fn)(\n388\t                            png,\n389\t                            core::ptr::null_mut(),\n390\t                            Some(write_cb),\n391\t                            Some(flush_cb),\n392\t                        );\n393\t                        let g = guarded(api, png, &mut || {\n394\t                            (api.png_write_sig)(png);\n395\t                            if pieces == 1 {\n396\t                                (api.png_write_chunk)(\n397\t                                    png,\n398\t                                    name.as_ptr(),\n399\t                                    data.as_ptr(),\n400\t                                    data.len(),\n401\t                                );\n402\t                            } else {\n403\t                                (api.png_write_chunk_start)(png, name.as_ptr(), data.len() as u32);\n404\t                                let step = data.len().div_ceil(pieces).max(1);\n405\t                                let mut i = 0;\n406\t                                while i < data.len() {\n407\t                                    let k = step.min(data.len() - i);\n408\t                                    (api.png_write_chunk_data)(png, data.as_ptr().add(i), k);\n409\t                                    i += k;\n410\t                                }\n411\t                                (api.png_write_chunk_end)(png);\n412\t                            }\n413\t                        });\n414\t                        o.push(format!(\"guard={:?}\", g));\n415\t                        o.output = std::mem::take(&mut tls().output);\n416\t                        destroy_write(api, png, core::ptr::null_mut());\n417\t                        o\n418\t                    },\n419\t                );\n420\t            }\n421\t        }\n422\t    }\n423\t}\n424\t\n425\t/// C-61: `png_set_flush` / `png_write_flush`.\n426\t#[test]\n427\tfn flush() {\n428\t    let mut rng = Rng::new(0xf1_05);\n429\t    let img = Img::random(&mut rng, 30, 20, PNG_COLOR_TYPE_RGB, 8);\n430\t    for every in [0, 1, 2, 7, 1000] {\n431\t        let opts = WriteOpts {\n432\t            flush_every: Some(every),\n433\t            ..Default::default()\n434\t        };\n435\t        assert_same(&format!(\"flush every {}\", every), |api| unsafe {\n436\t            let mut o = Outcome::default();\n437\t            let wr = write_plain(api, &img, &opts);\n438\t            o.push(format!(\"guard={:?}\", wr.guard));\n439\t            o.output = wr.bytes.clone();\n440\t            o\n441\t        });\n442\t    }\n443\t    // explicit png_write_flush between rows\n444\t    assert_same(\"explicit write_flush\", |api| unsafe {\n445\t        let mut o = Outcome::default();\n446\t        let (png, info) = new_write(api);\n447\t        (api.png_set_write_fn)(png, core::ptr::null_mut(), Some(write_cb), Some(flush_cb));\n448\t        let g = guarded(api, png, &mut || {\n449\t            (api.png_set_IHDR)(\n450\t                png,\n451\t                info,\n452\t                img.w,\n453\t                img.h,\n454\t                8,\n455\t                PNG_COLOR_TYPE_RGB,\n456\t                PNG_INTERLACE_NONE,\n457\t                PNG_COMPRESSION_TYPE_BASE,\n458\t                PNG_FILTER_TYPE_BASE,\n459\t            );\n460\t            (api.png_write_info)(png, info);\n461\t            for (i, r) in img.rows.iter().enumerate() {\n462\t                (api.png_write_row)(png, r.as_ptr() as *mut u8);\n463\t                if i % 3 == 0 {\n464\t                    (api.png_write_flush)(png);\n465\t                }\n466\t            }\n467\t            (api.png_write_end)(png, info);\n468\t        });\n469\t        o.push(format!(\"guard={:?} flushes={}\", g, tls().flushes));\n470\t        o.output = std::mem::take(&mut tls().output);\n471\t        destroy_write(api, png, info);\n472\t        o\n473\t    });\n474\t}\n475\t\n476\t/// C-62: the info getters, before and after `png_read_update_info`.\n477\t#[test]\n478\tfn info_getters() {\n479\t    for (ct, bd) in VALID_SHAPES {\n480\t        let mut rng = Rng::new(0x9e77 ^ ((ct as u64) << 8) ^ bd as u64);\n481\t        let img = Img::random(&mut rng, 12, 4, ct, bd);\n482\t        let mut file = Vec::new();\n483\t        assert_same(&format!(\"getters write ct={} bd={}\", ct, bd), |api| unsafe {\n484\t            let mut o = Outcome::default();\n485\t            let wr = write_plain(api, &img, &WriteOpts::default());\n486\t            o.output = wr.bytes.clone();\n487\t            if api.which == \"C\" {\n488\t                file = wr.bytes.clone();\n489\t            }\n490\t            o\n491\t        });\n492\t        assert_same(&format!(\"getters read ct={} bd={}\", ct, bd), |api| unsafe {\n493\t            let mut o = Outcome::default();\n494\t            let rr = read_image(\n495\t                api,\n496\t                &file,\n497\t                &ReadOpts::default(),\n498\t                &mut |api, png, info| {\n499\t                    log(format!(\n500\t                        \"extra: w={} h={} d={} ct={} il={} comp={} filt={} rb={} ch={}\",\n501\t                        (api.png_get_image_width)(png, info),\n502\t                        (api.png_get_image_height)(png, info),\n503\t                        (api.png_get_bit_depth)(png, info),\n504\t                        (api.png_get_color_type)(png, info),\n505\t                        (api.png_get_interlace_type)(png, info),\n506\t                        (api.png_get_compression_type)(png, info),\n507\t                        (api.png_get_filter_type)(png, info),\n508\t                        (api.png_get_rowbytes)(png, info),\n509\t                        (api.png_get_channels)(png, info),\n510\t                    ));\n511\t                },\n512\t            );\n513\t            o.push(format!(\"guard={:?}\", rr.guard));\n514\t            for r in &rr.rows {\n515\t                o.output.extend_from_slice(r);\n516\t            }\n517\t            o\n518\t        });\n519\t    }\n520\t}\n521\t\n522\t/// C-64: `png_set_sig_bytes` / `png_get_signature`.\n523\t#[test]\n524\tfn sig_bytes() {\n525\t    let mut rng = Rng::new(0x5169);\n526\t    let img = Img::random(&mut rng, 6, 3, PNG_COLOR_TYPE_GRAY, 8);\n527\t    let mut file = Vec::new();\n528\t    assert_same(\"sig write\", |api| unsafe {\n529\t        let mut o = Outcome::default();\n530\t        let wr = write_plain(api, &img, &WriteOpts::default());\n531\t        o.output = wr.bytes.clone();\n532\t        if api.which == \"C\" {\n533\t            file = wr.bytes.clone();\n534\t        }\n535\t        o\n536\t    });\n537\t    for pre in 0..=8usize {\n538\t        assert_same(&format!(\"sig_bytes={}\", pre), |api| unsafe {\n539\t            let mut o = Outcome::default();\n540\t            tls().input = file[pre..].to_vec();\n541\t            tls().in_pos = 0;\n542\t            let (png, info) = new_read(api);\n543\t            (api.png_set_read_fn)(png, core::ptr::null_mut(), Some(read_cb));\n544\t            let g = guarded(api, png, &mut || {\n545\t                (api.png_set_sig_bytes)(png, pre as c_int);\n546\t                (api.png_read_info)(png, info);\n547\t                let sig = (api.png_get_signature)(png, info);\n548\t                if sig.is_null() {\n549\t                    log(\"signature=<null>\".to_string());\n550\t                } else {\n551\t                    log(format!(\n552\t                        \"signature={:02x?}\",\n553\t                        core::slice::from_raw_parts(sig, 8)\n554\t                    ));\n555\t                }\n556\t                let rb = (api.png_get_rowbytes)(png, info);\n557\t                let h = (api.png_get_image_height)(png, info) as usize;\n558\t                let mut row = vec![0u8; rb];\n559\t                for _ in 0..h {\n560\t                    (api.png_read_row)(png, row.as_mut_ptr(), core::ptr::null_mut());\n561\t                    log(format!(\"row {:02x?}\", row));\n562\t                }\n563\t                (api.png_read_end)(png, info);\n564\t            });\n565\t            o.push(format!(\"guard={:?}\", g));\n566\t            destroy_read(api, png, info);\n567\t            o\n568\t        });\n569\t    }\n570\t}\n571\t\n572\t/// C-154: `png_read_end` variants and unread rows.\n573\t#[test]\n574\tfn read_end() {\n575\t    let mut rng = Rng::new(0xe4d);\n576\t    let img = Img::random(&mut rng, 10, 8, PNG_COLOR_TYPE_RGB, 8);\n577\t    let mut file = Vec::new();\n578\t    assert_same(\"read_end write\", |api| unsafe {\n579\t        let mut o = Outcome::default();\n580\t        let wr = write_plain(api, &img, &WriteOpts::default());\n581\t        o.output = wr.bytes.clone();\n582\t        if api.which == \"C\" {\n583\t            file = wr.bytes.clone();\n584\t        }\n585\t        o\n586\t    });\n587\t    for (tag, opts) in [\n588\t        (\n589\t            \"all rows + read_end(info)\",\n590\t            ReadOpts {\n591\t                ..Default::default()\n592\t            },\n593\t        ),\n594\t        (\n595\t            \"all rows + read_end(NULL)\",\n596\t            ReadOpts {\n597\t                end_null_info: true,\n598\t                ..Default::default()\n599\t            },\n600\t        ),\n601\t        (\n602\t            \"no rows + read_end(info)\",\n603\t            ReadOpts {\n604\t                rows: RowMode::None,\n605\t                ..Default::default()\n606\t            },\n607\t        ),\n608\t        (\n609\t            \"no rows, no read_end\",\n610\t            ReadOpts {\n611\t                rows: RowMode::None,\n612\t                read_end: false,\n613\t                ..Default::default()\n614\t            },\n615\t        ),\n616\t        (\n617\t            \"no update_info\",\n618\t            ReadOpts {\n619\t                update_info: false,\n620\t                ..Default::default()\n621\t            },\n622\t        ),\n623\t    ] {\n624\t        assert_same(tag, |api| unsafe {\n625\t            let mut o = Outcome::default();\n626\t            let rr = read_plain(api, &file, &opts);\n627\t            o.push(format!(\"guard={:?}\", rr.guard));\n628\t            for r in &rr.rows {\n629\t                o.output.extend_from_slice(r);\n630\t            }\n631\t            o\n632\t        });\n633\t    }\n634\t}\n635\t"}]},"parent_tool_use_id":"toolu_bdrk_01DkTVAznv6jg5QHC72BbbtR","session_id":"309de29f-cb7a-4138-9016-7ab2e7ef6079","uuid":"aca7f099-b4a4-4626-9335-61d989e0cd40","timestamp":"2026-08-23T02:53:24.857Z","subagent_type":"general-purpose","task_descrip