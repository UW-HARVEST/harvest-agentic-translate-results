{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017Tya6Vv4W7nwzS34ZDFWBh","type":"tool_result","content":"1\t//! Differential-test harness.\n2\t//!\n3\t//! Both libraries under test are loaded with `libloading::Library::new` and\n4\t//! driven **only** through their exported symbols (see `api.rs`, which is\n5\t//! generated from `c_src/include/png.h` + `c_src/include/pngpriv.h` and covers\n6\t//! all 384 exported symbols).  No Rust function is ever called directly, so the\n7\t//! `#[no_mangle]` export wrappers are exercised too.\n8\t#![allow(dead_code)]\n9\t\n10\tpub mod api;\n11\tpub mod forked;\n12\tpub mod helpers;\n13\tpub mod sweep;\n14\tpub mod types;\n15\t\n16\t#[allow(unused_imports)]\n17\tpub use api::{Api, API_NAMES};\n18\t#[allow(unused_imports)]\n19\tpub use forked::*;\n20\t#[allow(unused_imports)]\n21\tpub use helpers::*;\n22\tpub use types::*;\n23\t\n24\tuse core::ffi::{c_char, c_int, c_void};\n25\tuse std::path::{Path, PathBuf};\n26\tuse std::sync::OnceLock;\n27\t\n28\t/* ------------------------------------------------------------------ */\n29\t/* library discovery + loading                                         */\n30\t/* ------------------------------------------------------------------ */\n31\t\n32\tfn crate_root() -> PathBuf {\n33\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n34\t}\n35\t\n36\t/// `target/<profile>/` of the currently running test binary.\n37\tfn target_profile_dir() -> PathBuf {\n38\t    let exe = std::env::current_exe().expect(\"current_exe\");\n39\t    // .../target/<profile>/deps/<test>-<hash>\n40\t    exe.parent()\n41\t        .and_then(Path::parent)\n42\t        .expect(\"target/<profile>\")\n43\t        .to_path_buf()\n44\t}\n45\t\n46\tfn c_so_path() -> PathBuf {\n47\t    crate_root().join(\"c_src/build/libpng.so\")\n48\t}\n49\t\n50\tfn rust_so_path() -> PathBuf {\n51\t    let p = target_profile_dir().join(\"liblibpng.so\");\n52\t    if p.exists() {\n53\t        return p;\n54\t    }\n55\t    for prof in [\"release\", \"debug\"] {\n56\t        let q = crate_root().join(\"target\").join(prof).join(\"liblibpng.so\");\n57\t        if q.exists() {\n58\t            return q;\n59\t        }\n60\t    }\n61\t    p\n62\t}\n63\t\n64\tfn shim_so_path() -> PathBuf {\n65\t    target_profile_dir().join(\"libpngharness.so\")\n66\t}\n67\t\n68\tfn build_shim() -> PathBuf {\n69\t    let out = shim_so_path();\n70\t    let src = crate_root().join(\"tests/common/shim.c\");\n71\t    let fresh = std::fs::metadata(&out)\n72\t        .and_then(|a| a.modified())\n73\t        .ok()\n74\t        .zip(std::fs::metadata(&src).and_then(|a| a.modified()).ok())\n75\t        .map(|(o, s)| o >= s)\n76\t        .unwrap_or(false);\n77\t    if !fresh {\n78\t        let tmp = out.with_extension(format!(\"so.{}\", std::process::id()));\n79\t        let st = std::process::Command::new(\"cc\")\n80\t            .args([\"-O1\", \"-fPIC\", \"-shared\", \"-o\"])\n81\t            .arg(&tmp)\n82\t            .arg(&src)\n83\t            .status()\n84\t            .expect(\"cc (needed to build the test's setjmp shim)\");\n85\t        assert!(st.success(), \"failed to compile {}\", src.display());\n86\t        let _ = std::fs::rename(&tmp, &out);\n87\t    }\n88\t    out\n89\t}\n90\t\n91\t/// `cargo test` does not necessarily rebuild a `cdylib`-only lib target, so make\n92\t/// sure we are never silently testing a stale artefact.\n93\tfn assert_fresh(so: &Path) {\n94\t    let so_mtime = std::fs::metadata(so).and_then(|m| m.modified()).unwrap();\n95\t    let mut newest = so_mtime;\n96\t    let mut newest_path = so.to_path_buf();\n97\t    let mut stack = vec![crate_root().join(\"src\")];\n98\t    while let Some(d) = stack.pop() {\n99\t        let Ok(rd) = std::fs::read_dir(&d) else { continue };\n100\t        for e in rd.flatten() {\n101\t            let p = e.path();\n102\t            if p.is_dir() {\n103\t                stack.push(p);\n104\t            } else if let Ok(m) = e.metadata().and_then(|m| m.modified()) {\n105\t                if m > newest {\n106\t                    newest = m;\n107\t                    newest_path = p;\n108\t                }\n109\t            }\n110\t        }\n111\t    }\n112\t    assert!(\n113\t        newest <= so_mtime,\n114\t        \"{} is older than {} -- run `cargo build --release` first \\\n115\t         (cargo test does not rebuild a cdylib-only lib target)\",\n116\t        so.display(),\n117\t        newest_path.display()\n118\t    );\n119\t}\n120\t\n121\tpub struct Shim {\n122\t    pub run: unsafe extern \"C\" fn(\n123\t        set_longjmp_fn: *mut c_void,\n124\t        png_ptr: *mut PngStruct,\n125\t        body: unsafe extern \"C\" fn(*mut c_void),\n126\t        arg: *mut c_void,\n127\t    ) -> c_int,\n128\t    pub last_error: unsafe extern \"C\" fn() -> *const c_char,\n129\t    pub error_fn: unsafe extern \"C\" fn(*mut PngStruct, *const c_char),\n130\t    pub jmp_buf_size: unsafe extern \"C\" fn() -> usize,\n131\t    _lib: &'static libloading::Library,\n132\t}\n133\t\n134\tpub struct Libs {\n135\t    pub c: Api,\n136\t    pub rust: Api,\n137\t    pub shim: Shim,\n138\t}\n139\t\n140\t/// SAFETY: every field is either a plain function pointer or a pointer into a\n141\t/// permanently mapped, read-only section of a dlopen'd library; both are safe to\n142\t/// read from any thread.\n143\tunsafe impl Send for Libs {}\n144\tunsafe impl Sync for Libs {}\n145\t\n146\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n147\t\n148\tpub fn libs() -> &'static Libs {\n149\t    LIBS.get_or_init(|| unsafe {\n150\t        let cp = c_so_path();\n151\t        assert!(\n152\t            cp.exists(),\n153\t            \"C reference library not built: {}\\n\\\n154\t             build it with:\\n  cd c_src && mkdir -p build && cd build && \\\n155\t             cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\",\n156\t            cp.display()\n157\t        );\n158\t        let rp = rust_so_path();\n159\t        assert!(rp.exists(), \"Rust cdylib not built: {}\", rp.display());\n160\t        assert_fresh(&rp);\n161\t\n162\t        // `c_src/CMakeLists.txt` links only zlib, so the reference `libpng.so`\n163\t        // leaves `floor`/`pow`/`log`/... undefined and relies on the *program*\n164\t        // pulling in libm.  A Rust test binary does not necessarily do that, so\n165\t        // publish libm into the global symbol scope first.  (Without this the C\n166\t        // library dies with `symbol lookup error: undefined symbol: floor` the\n167\t        // first time a gamma computation runs.)\n168\t        {\n169\t            use libloading::os::unix as u;\n170\t            let m = u::Library::open(Some(\"libm.so.6\"), 0x2 /*RTLD_NOW*/ | 0x100 /*RTLD_GLOBAL*/)\n171\t                .expect(\"dlopen libm.so.6 (RTLD_GLOBAL)\");\n172\t            std::mem::forget(m);\n173\t        }\n174\t\n175\t        let cl: &'static libloading::Library =\n176\t            Box::leak(Box::new(libloading::Library::new(&cp).expect(\"dlopen C .so\")));\n177\t        let rl: &'static libloading::Library = Box::leak(Box::new(\n178\t            libloading::Library::new(&rp).expect(\"dlopen Rust .so\"),\n179\t        ));\n180\t        let sp = build_shim();\n181\t        let sl: &'static libloading::Library = Box::leak(Box::new(\n182\t            libloading::Library::new(&sp).expect(\"dlopen shim .so\"),\n183\t        ));\n184\t\n185\t        let shim = Shim {\n186\t            run: *sl.get(b\"harness_run\").unwrap(),\n187\t            last_error: *sl.get(b\"harness_last_error\").unwrap(),\n188\t            error_fn: *sl.get(b\"harness_error_fn\").unwrap(),\n189\t            jmp_buf_size: *sl.get(b\"harness_jmp_buf_size\").unwrap(),\n190\t            _lib: sl,\n191\t        };\n192\t        assert_eq!(\n193\t            (shim.jmp_buf_size)(),\n194\t            200,\n195\t            \"glibc jmp_buf is expected to be 200 bytes on this target\"\n196\t        );\n197\t\n198\t        Libs {\n199\t            c: Api::load(cl, \"C\"),\n200\t            rust: Api::load(rl, \"Rust\"),\n201\t            shim,\n202\t        }\n203\t    })\n204\t}\n205\t\n206\t/* ------------------------------------------------------------------ */\n207\t/* per-thread callback state                                           */\n208\t/* ------------------------------------------------------------------ */\n209\t\n210\t/// State the libpng callbacks operate on.  It is reached through a thread-local\n211\t/// raw pointer rather than `png_get_io_ptr()` so that the very same callback\n212\t/// works for both libraries; a raw pointer (not `RefCell`) because libpng may\n213\t/// `longjmp` out of a callback, which would leave a `RefCell` borrowed forever.\n214\tpub struct Tls {\n215\t    /// Ordered log of everything the library reported / did.\n216\t    pub trace: Vec<String>,\n217\t    /// Bytes the library may read (`png_set_read_fn`).\n218\t    pub input: Vec<u8>,\n219\t    pub in_pos: usize,\n220\t    /// Bytes the library wrote (`png_set_write_fn`).\n221\t    pub output: Vec<u8>,\n222\t    pub flushes: u32,\n223\t    /// Rows handed to / expected from the library.\n224\t    pub rows: Vec<Vec<u8>>,\n225\t    /// Scratch used by user callbacks.\n226\t    pub counter: u64,\n227\t    /// Allocation bookkeeping for the custom allocator test.\n228\t    pub allocs: Vec<(usize, usize)>,\n229\t    pub alloc_serial: u64,\n230\t    /// Set to make the read callback report a short read.\n231\t    pub truncate_reads_at: Option<usize>,\n232\t}\n233\t\n234\timpl Default for Tls {\n235\t    fn default() -> Self {\n236\t        Tls {\n237\t            trace: Vec::new(),\n238\t            input: Vec::new(),\n239\t            in_pos: 0,\n240\t            output: Vec::new(),\n241\t            flushes: 0,\n242\t            rows: Vec::new(),\n243\t            counter: 0,\n244\t            allocs: Vec::new(),\n245\t            alloc_serial: 0,\n246\t            truncate_reads_at: None,\n247\t        }\n248\t    }\n249\t}\n250\t\n251\tthread_local! {\n252\t    static TLS: std::cell::Cell<*mut Tls> = const { std::cell::Cell::new(core::ptr::null_mut()) };\n253\t}\n254\t\n255\tpub fn tls() -> &'static mut Tls {\n256\t    let p = TLS.with(|c| c.get());\n257\t    assert!(!p.is_null(), \"no Tls installed on this thread\");\n258\t    unsafe { &mut *p }\n259\t}\n260\t\n261\tpub fn set_tls(p: *mut Tls) -> *mut Tls {\n262\t    TLS.with(|c| c.replace(p))\n263\t}\n264\t\n265\tpub fn log(s: impl Into<String>) {\n266\t    tls().trace.push(s.into());\n267\t}\n268\t\n269\t/* ------------------------------------------------------------------ */\n270\t/* libpng callbacks (shared by both libraries)                         */\n271\t/* ------------------------------------------------------------------ */\n272\t\n273\tunsafe fn cstr(p: *const c_char) -> String {\n274\t    if p.is_null() {\n275\t        \"<null>\".to_string()\n276\t    } else {\n277\t        std::ffi::CStr::from_ptr(p).to_string_lossy().into_owned()\n278\t    }\n279\t}\n280\t\n281\tpub unsafe extern \"C\" fn warn_cb(_png: *mut PngStruct, msg: *const c_char) {\n282\t    let m = cstr(msg);\n283\t    observe(&m);\n284\t    log(format!(\"warning: {}\", m));\n285\t}\n286\t\n287\tpub unsafe extern \"C\" fn read_cb(png: *mut PngStruct, data: *mut u8, len: usize) {\n288\t    let t = tls();\n289\t    let avail = t.input.len().saturating_sub(t.in_pos);\n290\t    let mut n = len.min(avail);\n291\t    if let Some(limit) = t.truncate_reads_at {\n292\t        if t.in_pos + n > limit {\n293\t            n = limit.saturating_sub(t.in_pos);\n294\t        }\n295\t    }\n296\t    if n > 0 {\n297\t        core::ptr::copy_nonoverlapping(t.input.as_ptr().add(t.in_pos), data, n);\n298\t        t.in_pos += n;\n299\t    }\n300\t    if n < len {\n301\t        // Same behaviour as libpng's own png_default_read_data on a short read.\n302\t        log(format!(\"read_fn: short read ({} of {})\", n, len));\n303\t        let api = CUR_API.with(|c| c.get());\n304\t        assert!(!api.is_null());\n305\t        ((*api).png_error)(png, b\"Read Error\\0\".as_ptr() as *const c_char);\n306\t    }\n307\t}\n308\t\n309\tpub unsafe extern \"C\" fn write_cb(_png: *mut PngStruct, data: *mut u8, len: usize) {\n310\t    let t = tls();\n311\t    t.output.extend_from_slice(core::slice::from_raw_parts(data, len));\n312\t}\n313\t\n314\tpub unsafe extern \"C\" fn flush_cb(_png: *mut PngStruct) {\n315\t    tls().flushes += 1;\n316\t}\n317\t\n318\tpub unsafe extern \"C\" fn read_status_cb(_png: *mut PngStruct, row: u32, pass: c_int) {\n319\t    log(format!(\"read_row_status row={} pass={}\", row, pass));\n320\t}\n321\t\n322\tpub unsafe extern \"C\" fn write_status_cb(_png: *mut PngStruct, row: u32, pass: c_int) {\n323\t    log(format!(\"write_row_status row={} pass={}\", row, pass));\n324\t}\n325\t\n326\tthread_local! {\n327\t    static CUR_API: std::cell::Cell<*const Api> =\n328\t        const { std::cell::Cell::new(core::ptr::null()) };\n329\t}\n330\t\n331\tpub fn set_cur_api(p: *const Api) -> *const Api {\n332\t    CUR_API.with(|c| c.replace(p))\n333\t}\n334\t\n335\tpub fn cur_api() -> &'static Api {\n336\t    let p = CUR_API.with(|c| c.get());\n337\t    assert!(!p.is_null());\n338\t    unsafe { &*p }\n339\t}\n340\t\n341\t/* ------------------------------------------------------------------ */\n342\t/* running a scenario under the libpng error trap                      */\n343\t/* ------------------------------------------------------------------ */\n344\t\n345\tunsafe extern \"C\" fn trampoline(arg: *mut c_void) {\n346\t    let f = arg as *mut &mut dyn FnMut();\n347\t    (*f)();\n348\t}\n349\t\n350\t/// Result of `guarded`.\n351\t#[derive(Debug, Clone, PartialEq, Eq)]\n352\tpub enum Guard {\n353\t    /// The body ran to completion.\n354\t    Ok,\n355\t    /// libpng raised a fatal error with this message.\n356\t    Error(String),\n357\t    /// `png_set_longjmp_fn` returned NULL.\n358\t    NoTrap,\n359\t}\n360\t\n361\t/// Run `body` with a libpng error trap armed on `png_ptr`.\n362\tpub unsafe fn guarded(api: &Api, png_ptr: *mut PngStruct, body: &mut dyn FnMut()) -> Guard {\n363\t    let sh = &libs().shim;\n364\t    let mut b: &mut dyn FnMut() = body;\n365\t    let arg = &mut b as *mut &mut dyn FnMut() as *mut c_void;\n366\t    let r = (sh.run)(\n367\t        api.png_set_longjmp_fn as *mut c_void,\n368\t        png_ptr,\n369\t        trampoline,\n370\t        arg,\n371\t    );\n372\t    match r {\n373\t        0 => Guard::Ok,\n374\t        1 => {\n375\t            let m = cstr((sh.last_error)());\n376\t            observe(&m);\n377\t            Guard::Error(m)\n378\t        }\n379\t        _ => Guard::NoTrap,\n380\t    }\n381\t}\n382\t\n383\t/// Every distinct diagnostic message either library has produced in this process.\n384\t///\n385\t/// `tests/errors.rs` diffs this against `tests/error_sites.txt` (generated from\n386\t/// the C sources by `tools/gen_error_sites.py`) to report which of libpng's\n387\t/// rejection sites the error-path tests have actually reached.\n388\tpub static OBSERVED: std::sync::Mutex<Option<std::collections::BTreeSet<String>>> =\n389\t    std::sync::Mutex::new(None);\n390\t\n391\tpub fn observe(msg: &str) {\n392\t    let mut g = OBSERVED.lock().unwrap();\n393\t    g.get_or_insert_with(Default::default).insert(msg.to_string());\n394\t}\n395\t\n396\tpub fn observed() -> std::collections::BTreeSet<String> {\n397\t    OBSERVED\n398\t        .lock()\n399\t        .unwrap()\n400\t        .clone()\n401\t        .unwrap_or_default()\n402\t}\n403\t\n404\t/* ------------------------------------------------------------------ */\n405\t/* the differential driver                                             */\n406\t/* ------------------------------------------------------------------ */\n407\t\n408\t/// Everything a scenario observed: an ordered event log plus the produced bytes.\n409\t#[derive(Default, Clone, PartialEq, Eq)]\n410\tpub struct Outcome {\n411\t    pub trace: Vec<String>,\n412\t    pub output: Vec<u8>,\n413\t}\n414\t\n415\timpl Outcome {\n416\t    pub fn push(&mut self, s: impl Into<String>) {\n417\t        self.trace.push(s.into());\n418\t    }\n419\t}\n420\t\n421\t/// Run `f` once against the C library and once against the Rust library, each\n422\t/// with a fresh `Tls`, and return the two outcomes.\n423\tpub fn run_both<F>(mut f: F) -> (Outcome, Outcome)\n424\twhere\n425\t    F: FnMut(&Api) -> Outcome,\n426\t{\n427\t    let l = libs();\n428\t    let mut out = Vec::new();\n429\t    for api in [&l.c, &l.rust] {\n430\t        let mut state = Box::new(Tls::default());\n431\t        let prev = set_tls(&mut *state as *mut Tls);\n432\t        let prev_api = set_cur_api(api as *const Api);\n433\t        let mut o = f(api);\n434\t        // The event log the callbacks appended goes first, then whatever the\n435\t        // scenario itself recorded, so that both sides are ordered identically.\n436\t        let mut trace = std::mem::take(&mut state.trace);\n437\t        trace.append(&mut o.trace);\n438\t        o.trace = trace;\n439\t        set_cur_api(prev_api);\n440\t        set_tls(prev);\n441\t        out.push(o);\n442\t    }\n443\t    let b = out.pop().unwrap();\n444\t    let a = out.pop().unwrap();\n445\t    (a, b)\n446\t}\n447\t\n448\tfn hexdump(b: &[u8], from: usize) -> String {\n449\t    let start = from.saturating_sub(16) & !15;\n450\t    let end = (from + 48).min(b.len());\n451\t    let mut s = String::new();\n452\t    let mut i = start;\n453\t    while i < end {\n454\t        s.push_str(&format!(\"{:08x} \", i));\n455\t        for j in i..(i + 16).min(end) {\n456\t            s.push_str(&format!(\"{:02x} \", b[j]));\n457\t        }\n458\t        s.push('\\n');\n459\t        i += 16;\n460\t    }\n461\t    s\n462\t}\n463\t\n464\t/// How many differential comparisons this test binary has performed.\n465\tpub static CASES: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);\n466\t\n467\t/// Assert the two libraries behaved identically for the scenario `f`.\n468\t#[track_caller]\n469\tpub fn assert_same<F>(case: &str, f: F)\n470\twhere\n471\t    F: FnMut(&Api) -> Outcome,\n472\t{\n473\t    let (c, r) = run_both(f);\n474\t    CASES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n475\t    assert!(\n476\t        !c.trace.is_empty() || !c.output.is_empty(),\n477\t        \"case `{}`: the scenario recorded nothing at all -- the test is not \\\n478\t         actually exercising the library\",\n479\t        case\n480\t    );\n481\t    if c.trace != r.trace {\n482\t        let n = c\n483\t            .trace\n484\t            .iter()\n485\t            .zip(r.trace.iter())\n486\t            .position(|(a, b)| a != b)\n487\t            .unwrap_or(c.trace.len().min(r.trace.len()));\n488\t        let ctx = n.saturating_sub(4);\n489\t        let mut msg = format!(\n490\t            \"case `{}`: event traces differ at index {} (C has {} events, Rust has {})\\n\",\n491\t            case,\n492\t            n,\n493\t            c.trace.len(),\n494\t            r.trace.len()\n495\t        );\n496\t        for i in ctx..(n + 6).min(c.trace.len().max(r.trace.len())) {\n497\t            let a = c.trace.get(i).map(String::as_str).unwrap_or(\"<none>\");\n498\t            let b = r.trace.get(i).map(String::as_str).unwrap_or(\"<none>\");\n499\t            msg += &format!(\n500\t                \"  [{}] {} C: {}\\n       {} R: {}\\n\",\n501\t                i,\n502\t                if a == b { ' ' } else { '!' },\n503\t                a,\n504\t                if a == b { ' ' } else { '!' },\n505\t                b\n506\t            );\n507\t        }\n508\t        panic!(\"{}\", msg);\n509\t    }\n510\t    if c.output != r.output {\n511\t        let n = c\n512\t            .output\n513\t            .iter()\n514\t            .zip(r.output.iter())\n515\t            .position(|(a, b)| a != b)\n516\t            .unwrap_or(c.output.len().min(r.output.len()));\n517\t        panic!(\n518\t            \"case `{}`: output bytes differ at offset {} (C {} bytes, Rust {} bytes)\\nC:\\n{}\\nRust:\\n{}\",\n519\t            case,\n520\t            n,\n521\t            c.output.len(),\n522\t            r.output.len(),\n523\t            hexdump(&c.output, n),\n524\t            hexdump(&r.output, n)\n525\t        );\n526\t    }\n527\t}\n528\t\n529\t/* ------------------------------------------------------------------ */\n530\t/* deterministic RNG (no external crates)                              */\n531\t/* ------------------------------------------------------------------ */\n532\t\n533\t/// SplitMix64 — fixed seed, so every failure is reproducible.\n534\tpub struct Rng(pub u64);\n535\t\n536\timpl Rng {\n537\t    pub fn new(seed: u64) -> Rng {\n538\t        Rng(seed ^ 0x9e3779b97f4a7c15)\n539\t    }\n540\t    pub fn next_u64(&mut self) -> u64 {\n541\t        self.0 = self.0.wrapping_add(0x9e3779b97f4a7c15);\n542\t        let mut z = self.0;\n543\t        z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);\n544\t        z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);\n545\t        z ^ (z >> 31)\n546\t    }\n547\t    pub fn u32(&mut self) -> u32 {\n548\t        (self.next_u64() >> 32) as u32\n549\t    }\n550\t    pub fn u8(&mut self) -> u8 {\n551\t        (self.next_u64() >> 56) as u8\n552\t    }\n553\t    /// Uniform in `0..n`.\n554\t    pub fn below(&mut self, n: usize) -> usize {\n555\t        assert!(n > 0);\n556\t        (self.next_u64() % n as u64) as usize\n557\t    }\n558\t    pub fn range(&mut self, lo: i64, hi: i64) -> i64 {\n559\t        assert!(hi > lo);\n560\t        lo + (self.next_u64() % (hi - lo) as u64) as i64\n561\t    }\n562\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n563\t        (0..n).map(|_| self.u8()).collect()\n564\t    }\n565\t    pub fn pick<T: Copy>(&mut self, v: &[T]) -> T {\n566\t        v[self.below(v.len())]\n567\t    }\n568\t    pub fn bool(&mut self) -> bool {\n569\t        self.next_u64() & 1 == 1\n570\t    }\n571\t}\n572\t\n573\t/* ------------------------------------------------------------------ */\n574\t/* small helpers                                                       */\n575\t/* ------------------------------------------------------------------ */\n576\t\n577\tpub fn cs(s: &str) -> std::ffi::CString {\n578\t    std::ffi::CString::new(s).unwrap()\n579\t}\n580\t\n581\tpub const VER: *const c_char = b\"1.6.59.git\\0\".as_ptr() as *const c_char;\n582\t\n583\t/// Create a read struct with the harness error/warning handlers installed.\n584\tpub unsafe fn new_read(api: &Api) -> (*mut PngStruct, *mut PngInfo) {\n585\t    let sh = &libs().shim;\n586\t    let png = (api.png_create_read_struct)(VER, core::ptr::null_mut(), Some(sh.error_fn), Some(warn_cb));\n587\t    assert!(!png.is_null(), \"{}: png_create_read_struct failed\", api.which);\n588\t    let info = (api.png_create_info_struct)(png);\n589\t    assert!(!info.is_null());\n590\t    (png, info)\n591\t}\n592\t\n593\tpub unsafe fn new_write(api: &Api) -> (*mut PngStruct, *mut PngInfo) {\n594\t    let sh = &libs().shim;\n595\t    let png =\n596\t        (api.png_create_write_struct)(VER, core::ptr::null_mut(), Some(sh.error_fn), Some(warn_cb));\n597\t    assert!(!png.is_null(), \"{}: png_create_write_struct failed\", api.which);\n598\t    let info = (api.png_create_info_struct)(png);\n599\t    assert!(!info.is_null());\n600\t    (png, info)\n601\t}\n602\t\n603\tpub unsafe fn destroy_read(api: &Api, png: *mut PngStruct, info: *mut PngInfo) {\n604\t    let mut p = png;\n605\t    let mut i = info;\n606\t    (api.png_destroy_read_struct)(&mut p, &mut i, core::ptr::null_mut());\n607\t}\n608\t\n609\tpub unsafe fn destroy_write(api: &Api, png: *mut PngStruct, info: *mut PngInfo) {\n610\t    let mut p = png;\n611\t    let mut i = info;\n612\t    (api.png_destroy_write_struct)(&mut p, &mut i);\n613\t}\n614\t"}]},"parent_tool_use_id":"toolu_bdrk_01GWcu9bgbVggeqy4XeSbuyX","session_id":"309de29f-cb7a-4138-9016-7ab2e7ef6079","uuid":"ac7a55a7-1e6a-432a-b0bf