path, dlerror()); exit(1); }\n  GETSYM((*L), compile, \"pcre2_compile_8\");\n  GETSYM((*L), code_free, \"pcre2_code_free_8\");\n  GETSYM((*L), substitute, \"pcre2_substitute_8\");\n  GETSYM((*L), md_create_from_pattern, \"pcre2_match_data_create_from_pattern_8\");\n  GETSYM((*L), md_free, \"pcre2_match_data_free_8\");\n  GETSYM((*L), match, \"pcre2_match_8\");\n  GETSYM((*L), mc_create, \"pcre2_match_context_create_8\");\n  GETSYM((*L), mc_free, \"pcre2_match_context_free_8\");\n  GETSYM((*L), set_subst_callout, \"pcre2_set_substitute_callout_8\");\n  GETSYM((*L), set_subst_case_callout, \"pcre2_set_substitute_case_callout_8\");\n}\n\n/* ---- callouts (shared by both libraries) ---- */\nstatic int cb_mode = 0;\nstatic int subst_callout(scb_t *b, void *data)\n{\n  (void)data;\n  /* also sanity-check that the block contents agree by hashing into a global */\n  switch (cb_mode)\n    {\n    case 1: return 0;\n    case 2: return (b->subscount % 2 == 0)? 1 : 0;     /* reject even */\n    case 3: return (b->subscount >= 2)? -1 : 0;        /* stop after 2 */\n    case 4: return 1;                                  /* reject all */\n    default: return 0;\n    }\n}\n\nstatic PCRE2_SIZE case_cb(PCRE2_SPTR input, PCRE2_SIZE len, unsigned char *out,\n                          PCRE2_SIZE cap, int to_case, void *data)\n{\n  PCRE2_SIZE i, n;\n  int mode = (int)(size_t)data;\n  n = (mode == 2)? 2 * len : len;         /* mode 2: doubles the text */\n  if (mode == 3) return ~(PCRE2_SIZE)0;   /* error */\n  if (n <= cap)\n    {\n    PCRE2_SIZE k = 0;\n    for (i = 0; i < len; i++)\n      {\n      unsigned char c = input[i];\n      unsigned char t = c;\n      if (to_case == 1) { if (c >= 'A' && c <= 'Z') t = c + 32; }\n      else if (to_case == 2) { if (c >= 'a' && c <= 'z') t = c - 32; }\n      else if (to_case == 3) { if (i == 0) { if (c >= 'a' && c <= 'z') t = c - 32; }\n                               else { if (c >= 'A' && c <= 'Z') t = c + 32; } }\n      out[k++] = t;\n      if (mode == 2) out[k++] = t;\n      }\n    }\n  return n;\n}\n\nstatic const char *cur_pat, *cur_subj, *cur_rep;\nstatic uint32_t cur_opt;\nstatic PCRE2_SIZE cur_bufsize;\nstatic void bad(const char *what, long long a, long long b)\n{\n  printf(\"MISMATCH %-14s pat=<%s> subj=<%s> rep=<%s> opt=%#x buf=%zu : C=%lld RUST=%lld\\n\",\n         what, cur_pat, cur_subj, cur_rep, cur_opt, cur_bufsize, a, b);\n  failures++;\n}\n\nstatic void one(void *c1, void *c2, void *mc1, void *mc2,\n                const char *subj, PCRE2_SIZE slen, PCRE2_SIZE start,\n                const char *rep, PCRE2_SIZE rlen, uint32_t opt, PCRE2_SIZE bufsize,\n                void *md1, void *md2)\n{\n  unsigned char b1[600], b2[600];\n  PCRE2_SIZE l1 = bufsize, l2 = bufsize;\n  int r1, r2;\n  cur_subj = subj; cur_rep = rep; cur_opt = opt; cur_bufsize = bufsize;\n  memset(b1, 0x77, sizeof(b1));\n  memset(b2, 0x77, sizeof(b2));\n  r1 = C.substitute(c1, (PCRE2_SPTR)subj, slen, start, opt, md1, mc1,\n                    (PCRE2_SPTR)rep, rlen, b1, &l1);\n  r2 = R.substitute(c2, (PCRE2_SPTR)subj, slen, start, opt, md2, mc2,\n                    (PCRE2_SPTR)rep, rlen, b2, &l2);\n  checks++;\n  if (r1 != r2) { bad(\"rc\", r1, r2); return; }\n  if (l1 != l2) { bad(\"blength\", (long long)l1, (long long)l2); return; }\n  if (memcmp(b1, b2, sizeof(b1)) != 0)\n    {\n    size_t k;\n    for (k = 0; k < sizeof(b1); k++) if (b1[k] != b2[k]) break;\n    bad(\"text\", b1[k], b2[k]);\n    return;\n    }\n  /* Second pass: if OVERFLOW_LENGTH reported a needed size, rerun with it. */\n  if (r1 == -48 && (opt & 0x00001000u) != 0 && l1 != PCRE2_UNSET && l1 <= sizeof(b1))\n    {\n    PCRE2_SIZE m1 = l1, m2 = l2;\n    int s1, s2;\n    memset(b1, 0x77, sizeof(b1));\n    memset(b2, 0x77, sizeof(b2));\n    s1 = C.substitute(c1, (PCRE2_SPTR)subj, slen, start, opt, md1, mc1,\n                      (PCRE2_SPTR)rep, rlen, b1, &m1);\n    s2 = R.substitute(c2, (PCRE2_SPTR)subj, slen, start, opt, md2, mc2,\n                      (PCR