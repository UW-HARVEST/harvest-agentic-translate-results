{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KLt3TZhDAqsp3HNQbr3qA9","type":"tool_result","content":"1\t// Translated from c_src/src/pcre2_match_next.c\n2\tuse crate::internal::*;\n3\t\n4\t/* Advance the offset by one code unit, and return the new value.\n5\tIt is only called when the offset is not at the end of the subject. */\n6\t\n7\tunsafe fn do_bumpalong(match_data: *mut pcre2_real_match_data, offset: PCRE2_SIZE) -> PCRE2_SIZE {\n8\t    let subject: PCRE2_SPTR = (*match_data).subject;\n9\t    let subject_length: PCRE2_SIZE = (*match_data).subject_length;\n10\t    let utf: BOOL = if ((*(*match_data).code).overall_options & PCRE2_UTF) != 0 {\n11\t        TRUE\n12\t    } else {\n13\t        FALSE\n14\t    };\n15\t\n16\t    /* Skip over CRLF as an atomic sequence, if CRLF is configured as a newline\n17\t    sequence. */\n18\t\n19\t    if *subject.add(offset) as u32 == CHAR_CR\n20\t        && offset + 1 < subject_length\n21\t        && *subject.add(offset + 1) as u32 == CHAR_LF\n22\t    {\n23\t        let nl: u32 = (*(*match_data).code).newline_convention as u32;\n24\t        if nl == PCRE2_NEWLINE_CRLF || nl == PCRE2_NEWLINE_ANY || nl == PCRE2_NEWLINE_ANYCRLF {\n25\t            return offset + 2;\n26\t        }\n27\t    }\n28\t\n29\t    /* Advance by one full character if in UTF mode. */\n30\t\n31\t    if utf != 0 {\n32\t        let mut next: PCRE2_SPTR = subject.add(offset).add(1);\n33\t        let subject_end: PCRE2_SPTR = subject.add(subject_length);\n34\t\n35\t        FORWARDCHARTEST!(next, subject_end);\n36\t        return next.offset_from(subject) as PCRE2_SIZE;\n37\t    }\n38\t\n39\t    offset + 1\n40\t}\n41\t\n42\t/*************************************************\n43\t*                Advance the match               *\n44\t*************************************************/\n45\t\n46\t#[unsafe(no_mangle)]\n47\tpub unsafe extern \"C\" fn pcre2_next_match_8(\n48\t    match_data: *mut pcre2_real_match_data,\n49\t    offset: *mut PCRE2_SIZE,\n50\t    options: *mut u32,\n51\t) -> c_int {\n52\t    let rc: c_int = (*match_data).rc;\n53\t    let start_offset: PCRE2_SIZE = (*match_data).start_offset;\n54\t    let ovector: *mut PCRE2_SIZE = (*match_data).ovector.as_mut_ptr();\n55\t\n56\t    /* Match error, or no match: no further iteration possible. In previous versions\n57\t    of PCRE2, we recommended that clients use a strategy which involved retrying in\n58\t    certain cases after PCRE2_ERROR_NOMATCH, but this is no longer required. */\n59\t\n60\t    if rc < 0 {\n61\t        return FALSE;\n62\t    }\n63\t\n64\t    /* Match succeeded: get the start offset for the next match */\n65\t\n66\t    /* Although \\K can affect the position of ovector[0], there are no ways to do\n67\t    anything surprising with ovector[1], which must always be >= start_offset. */\n68\t\n69\t    /* PCRE2_ASSERT(ovector[1] >= start_offset); -- a no-op without PCRE2_DEBUG */\n70\t\n71\t    /* Special handling for patterns which contain \\K in a lookaround, which enables\n72\t    the match start to be pushed back to before the starting search offset\n73\t    (ovector[0] < start_offset) or after the match ends (ovector[0] > ovector[1]).\n74\t    This is not a problem if ovector[1] > start_offset, because in this case, we can\n75\t    just attempt the next match at ovector[1]: we are making progress, which is all\n76\t    that we require.\n77\t\n78\t    However, if we have ovector[1] == start_offset, then we have a very rare case\n79\t    which must be handled specially, because it's a non-empty match which\n80\t    nonetheless fails to make progress through the subject. */\n81\t\n82\t    if *ovector.add(0) != start_offset && *ovector.add(1) == start_offset {\n83\t        /* If the match end is at the end of the subject, we are done. */\n84\t\n85\t        if start_offset >= (*match_data).subject_length {\n86\t            return FALSE;\n87\t        }\n88\t\n89\t        /* Otherwise, bump along by one code unit, and do a n