2 = OP_ANYNL_EXTRA + OP_TYPEUPTO;\n70\tpub const OPX_ANYNL_TYPEMINUPTO: u32 = OP_ANYNL_EXTRA + OP_TYPEMINUPTO;\n71\tpub const OPX_ANYNL_TYPEPOSUPTO: u32 = OP_ANYNL_EXTRA + OP_TYPEPOSUPTO;\n72\t\n73\tpub const OPX_HSPACE_TYPEPLUS: u32 = OP_HSPACE_EXTRA + OP_TYPEPLUS;\n74\tpub const OPX_HSPACE_TYPEMINPLUS: u32 = OP_HSPACE_EXTRA + OP_TYPEMINPLUS;\n75\tpub const OPX_HSPACE_TYPEPOSPLUS: u32 = OP_HSPACE_EXTRA + OP_TYPEPOSPLUS;\n76\tpub const OPX_HSPACE_TYPEQUERY: u32 = OP_HSPACE_EXTRA + OP_TYPEQUERY;\n77\tpub const OPX_HSPACE_TYPEMINQUERY: u32 = OP_HSPACE_EXTRA + OP_TYPEMINQUERY;\n78\tpub const OPX_HSPACE_TYPEPOSQUERY: u32 = OP_HSPACE_EXTRA + OP_TYPEPOSQUERY;\n79\tpub const OPX_HSPACE_TYPESTAR: u32 = OP_HSPACE_EXTRA + OP_TYPESTAR;\n80\tpub const OPX_HSPACE_TYPEMINSTAR: u32 = OP_HSPACE_EXTRA + OP_TYPEMINSTAR;\n81\tpub const OPX_HSPACE_TYPEPOSSTAR: u32 = OP_HSPACE_EXTRA + OP_TYPEPOSSTAR;\n82\tpub const OPX_HSPACE_TYPEEXACT: u32 = OP_HSPACE_EXTRA + OP_TYPEEXACT;\n83\tpub const OPX_HSPACE_TYPEUPTO: u32 = OP_HSPACE_EXTRA + OP_TYPEUPTO;\n84\tpub const OPX_HSPACE_TYPEMINUPTO: u32 = OP_HSPACE_EXTRA + OP_TYPEMINUPTO;\n85\tpub const OPX_HSPACE_TYPEPOSUPTO: u32 = OP_HSPACE_EXTRA + OP_TYPEPOSUPTO;\n86\t\n87\tpub const OPX_VSPACE_TYPEPLUS: u32 = OP_VSPACE_EXTRA + OP_TYPEPLUS;\n88\tpub const OPX_VSPACE_TYPEMINPLUS: u32 = OP_VSPACE_EXTRA + OP_TYPEMINPLUS;\n89\tpub const OPX_VSPACE_TYPEPOSPLUS: u32 = OP_VSPACE_EXTRA + OP_TYPEPOSPLUS;\n90\tpub const OPX_VSPACE_TYPEQUERY: u32 = OP_VSPACE_EXTRA + OP_TYPEQUERY;\n91\tpub const OPX_VSPACE_TYPEMINQUERY: u32 = OP_VSPACE_EXTRA + OP_TYPEMINQUERY;\n92\tpub const OPX_VSPACE_TYPEPOSQUERY: u32 = OP_VSPACE_EXTRA + OP_TYPEPOSQUERY;\n93\tpub const OPX_VSPACE_TYPESTAR: u32 = OP_VSPACE_EXTRA + OP_TYPESTAR;\n94\tpub const OPX_VSPACE_TYPEMINSTAR: u32 = OP_VSPACE_EXTRA + OP_TYPEMINSTAR;\n95\tpub const OPX_VSPACE_TYPEPOSSTAR: u32 = OP_VSPACE_EXTRA + OP_TYPEPOSSTAR;\n96\tpub const OPX_VSPACE_TYPEEXACT: u32 = OP_VSPACE_EXTRA + OP_TYPEEXACT;\n97\tpub const OPX_VSPACE_TYPEUPTO: u32 = OP_VSPACE_EXTRA + OP_TYPEUPTO;\n98\tpub const OPX_VSPACE_TYPEMINUPTO: u32 = OP_VSPACE_EXTRA + OP_TYPEMINUPTO;\n99\tpub const OPX_VSPACE_TYPEPOSUPTO: u32 = OP_VSPACE_EXTRA + OP_TYPEPOSUPTO;\n100\t\n101\t/* Structure for holding data about a particular state. */\n102\t\n103\t#[repr(C)]\n104\t#[derive(Copy, Clone)]\n105\tpub struct stateblock {\n106\t    pub offset: c_int, /* Offset to opcode (-ve has meaning) */\n107\t    pub count: c_int,  /* Count for repeats */\n108\t    pub data: c_int,   /* Some use extra data */\n109\t}\n110\t\n111\tpub const INTS_PER_STATEBLOCK: c_int = (size_of::<stateblock>() / size_of::<c_int>()) as c_int;\n112\t\n113\tpub const OVEC_UNIT: usize = size_of::<PCRE2_SIZE>() / size_of::<c_int>();\n114\t\n115\tpub const RWS_BASE_SIZE: usize = DFA_START_RWS_SIZE / size_of::<c_int>();\n116\tpub const RWS_RSIZE: usize = 1000;\n117\tpub const RWS_OVEC_RSIZE: usize = 1000 * OVEC_UNIT;\n118\tpub const RWS_OVEC_OSIZE: usize = 2 * OVEC_UNIT;\n119\t\n120\t/* This structure is at the start of each workspace block. */\n121\t\n122\t#[repr(C)]\n123\t#[derive(Copy, Clone)]\n124\tpub struct RWS_anchor {\n125\t    pub next: *mut RWS_anchor,\n126\t    pub size: u32, /* Number of ints */\n127\t    pub free: u32, /* Number of ints */\n128\t}\n129\t\n130\tpub const RWS_ANCHOR_SIZE: usize = size_of::<RWS_anchor>() / size_of::<c_int>();\n131\t"}]},"parent_tool_use_id":"toolu_bdrk_01L8BHvKyEiauC6ikheGr5aW","session_id":"69c7dc4d-05f2-4bba-997b-e68ff82cc8bc","uuid":"ac2352d3-bd88-4401-a648-d2a8effec226","timestamp":"2026-08-22T22:36:52.209Z","subagent_type":"general-purpose","task_description":"dfa helpers + public fn"}
