#[macro_export]\n325\tmacro_rules! PUTCHAR {\n326\t    ($c:expr, $p:expr, $utf:expr) => {\n327\t        if ($utf) != 0 && $c > $crate::internal::MAX_UTF_SINGLE_CU {\n328\t            $crate::internal::_pcre2_ord2utf_8($c, $p)\n329\t        } else {\n330\t            *($p) = $c as u8;\n331\t            1u32\n332\t        }\n333\t    };\n334\t}\n335\t\n336\t// ---------------------------------------------------------------- table access\n337\t\n338\t// MAX_255(c) -> BOOL (always TRUE in 8-bit mode)\n339\t#[macro_export]\n340\tmacro_rules! MAX_255 {\n341\t    ($c:expr) => {\n342\t        $crate::internal::TRUE\n343\t    };\n344\t}\n345\t\n346\t// CHMAX_255(c) -> BOOL\n347\t#[macro_export]\n348\tmacro_rules! CHMAX_255 {\n349\t    ($c:expr) => {\n350\t        ((($c) <= 255u32) as $crate::internal::BOOL)\n351\t    };\n352\t}\n353\t\n354\t// TABLE_GET(c, table, default) -> u8 (8-bit mode ignores the default)\n355\t#[macro_export]\n356\tmacro_rules! TABLE_GET {\n357\t    ($c:expr, $table:expr, $default:expr) => {\n358\t        *($table).offset(($c) as isize)\n359\t    };\n360\t}\n361\t\n362\t// ---------------------------------------------------------------- newlines\n363\t\n364\t// IS_NEWLINE(p): blk is a *mut/&mut struct with nltype/nllen/nl fields,\n365\t// psend is the end-of-subject pointer expression.\n366\t#[macro_export]\n367\tmacro_rules! IS_NEWLINE {\n368\t    ($p:expr, $blk:expr, $psend:expr, $utf:expr) => {\n369\t        if (*$blk).nltype != $crate::internal::NLTYPE_FIXED {\n370\t            ($p) < ($psend)\n371\t                && $crate::internal::_pcre2_is_newline_8(\n372\t                    $p,\n373\t                    (*$blk).nltype,\n374\t                    $psend,\n375\t                    &mut (*$blk).nllen,\n376\t                    $utf,\n377\t                ) != 0\n378\t        } else {\n379\t            ($p) <= ($psend).offset(-((*$blk).nllen as isize))\n380\t                && *($p) == (*$blk).nl[0]\n381\t                && ((*$blk).nllen == 1 || *($p).offset(1) == (*$blk).nl[1])\n382\t        }\n383\t    };\n384\t}\n385\t\n386\t// WAS_NEWLINE(p)\n387\t#[macro_export]\n388\tmacro_rules! WAS_NEWLINE {\n389\t    ($p:expr, $blk:expr, $psstart:expr, $utf:expr) => {\n390\t        if (*$blk).nltype != $crate::internal::NLTYPE_FIXED {\n391\t            ($p) > ($psstart)\n392\t                && $crate::internal::_pcre2_was_newline_8(\n393\t                    $p,\n394\t                    (*$blk).nltype,\n395\t                    $psstart,\n396\t                    &mut (*$blk).nllen,\n397\t                    $utf,\n398\t                ) != 0\n399\t        } else {\n400\t            ($p) >= ($psstart).offset((*$blk).nllen as isize)\n401\t                && *($p).offset(-((*$blk).nllen as isize)) == (*$blk).nl[0]\n402\t                && ((*$blk).nllen == 1\n403\t                    || *($p).offset(-((*$blk).nllen as isize) + 1) == (*$blk).nl[1])\n404\t        }\n405\t    };\n406\t}\n407\t\n408\t// ---------------------------------------------------------------- bit maps\n409\t\n410\t// MAPBIT(map,n) -> u32 (non-zero if set); map is *const u32\n411\t#[macro_export]\n412\tmacro_rules! MAPBIT {\n413\t    ($map:expr, $n:expr) => {\n414\t        (*($map).offset((($n) / 32) as isize) & (1u32 << (($n) % 32)))\n415\t    };\n416\t}\n417\t\n418\t// MAPSET(map,n); map is *mut u32\n419\t#[macro_export]\n420\tmacro_rules! MAPSET {\n421\t    ($map:expr, $n:expr) => {\n422\t        *($map).offset((($n) / 32) as isize) |= 1u32 << (($n) % 32)\n423\t    };\n424\t}\n425\t\n426\t// SETBIT(a,b): a is *mut u8 (class bitmap)\n427\t#[macro_export]\n428\tmacro_rules! SETBIT {\n429\t    ($a:expr, $b:expr) => {\n430\t        *($a).offset((($b) >> 3) as isize) |= (1u32 << (($b) & 0x7)) as u8\n431\t    };\n432\t}\n433\t\n434\t// ---------------------------------------------------------------- parsed pattern\n435\t\n436\t// META_CODE(x), META_DATA(x), META_DIFF(x,y)\n437\t#[macro_export]\n438\tmacro_rules! META_CODE {\n439\t    ($x:expr) =>