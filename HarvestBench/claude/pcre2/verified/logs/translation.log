 = (argc > 1 && strcmp(argv[1], \"gen\") == 0);\n  const char *path = argv[2];\n\n  if (gen) {\n    pcre2_code *codes[NCASES];\n    for (int i = 0; i < NCASES; i++) {\n      int errcode; PCRE2_SIZE erroff;\n      codes[i] = pcre2_compile((PCRE2_SPTR)cases[i].pat, PCRE2_ZERO_TERMINATED,\n        cases[i].copts, &errcode, &erroff, NULL);\n      if (codes[i] == NULL) {\n        printf(\"COMPILE FAIL case %d pat=%s err=%d off=%lu\\n\", i, cases[i].pat, errcode, (unsigned long)erroff);\n        return 1;\n      }\n    }\n    uint8_t *bytes; PCRE2_SIZE bsize;\n    int n = pcre2_serialize_encode((const pcre2_code **)codes, NCASES, &bytes, &bsize, NULL);\n    if (n != NCASES) { printf(\"ENCODE FAIL %d\\n\", n); return 1; }\n    FILE *f = fopen(path, \"wb\");\n    fwrite(bytes, 1, bsize, f); fclose(f);\n    printf(\"encoded %d codes, %lu bytes\\n\", n, (unsigned long)bsize);\n    return 0;\n  }\n\n  /* run */\n  FILE *f = fopen(path, \"rb\");\n  if (!f) { printf(\"no blob\\n\"); return 1; }\n  fseek(f, 0, SEEK_END); long bsize = ftell(f); fseek(f, 0, SEEK_SET);\n  uint8_t *bytes = malloc(bsize);\n  if (fread(bytes, 1, bsize, f) != (size_t)bsize) return 1;\n  fclose(f);\n  pcre2_code *codes[NCASES];\n  int n = pcre2_serialize_decode(codes, NCASES, bytes, NULL);\n  if (n != NCASES) { printf(\"DECODE FAIL %d\\n\", n); return 1; }\n\n  pcre2_match_context *mc = pcre2_match_context_create(NULL);\n  pcre2_set_callout(mc, callout, NULL);\n\n  for (int i = 0; i < NCASES; i++) {\n    pcre2_match_data *md = pcre2_match_data_create_from_pattern(codes[i], NULL);\n    size_t slen = cases[i].slen < 0 ? strlen(cases[i].subj) : (size_t)cases[i].slen;\n    printf(\"case %2d pat=<%s> subj=<%s>\\n\", i, cases[i].pat, cases[i].subj);\n    int rc = pcre2_match(codes[i], (PCRE2_SPTR)cases[i].subj, slen, cases[i].soff,\n                         cases[i].mopts, md, mc);\n    printf(\"   rc=%d startchar=%lu\", rc, (unsigned long)pcre2_get_startchar(md));\n    if (rc > 0) {\n      PCRE2_SIZE *ov = pc