ern \"C\" fn pcre2_compile_context_create_8(\n    gcontext: *mut pcre2_real_general_context,\n) -> *mut pcre2_real_compile_context {\n    let ccontext = _pcre2_memctl_malloc_8(\n        size_of::<pcre2_real_compile_context>(),\n        gcontext as *mut pcre2_memctl,\n    ) as *mut pcre2_real_compile_context;\n    if ccontext.is_null() {\n        return core::ptr::null_mut();\n    }\n    *ccontext = _pcre2_default_compile_context_8;\n    if !gcontext.is_null() {\n        *(ccontext as *mut pcre2_memctl) = *(gcontext as *mut pcre2_memctl);\n    }\n    ccontext\n}\n\n/* A default match context is set up to save having to initialize at run time\nwhen no context is supplied to a match function. */\n=== grep static mut usage pattern ===\nsrc/pcre2_convert.rs:1237:        ccontext = (&raw mut _pcre2_default_convert_context_8) as *mut pcre2_real_convert_context;\nsrc/pcre2_match_public.rs:312:        mcontext = (&raw mut _pcre2_default_match_context_8) as *mut pcre2_real_match_context;","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01QMCbxDgq3be8ZcA1GvHguZ","session_id":"69c7dc4d-05f2-4bba-997b-e68ff82cc8bc","uuid":"653462a9-b18a-4339-87a9-27a4b80243c6","timestamp":"2026-08-22T22:48:43.608Z","subagent_type":"general-purpose","task_description":"compile part p10 pcre2_compile"}
