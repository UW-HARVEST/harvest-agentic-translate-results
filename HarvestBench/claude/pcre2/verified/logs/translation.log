*/\n1310\t\n1311\t      {\n1312\t      uint32_t *classwords = cb->classbits.classwords;\n1313\t\n1314\t      if (local_negate)\n1315\t        for (int i = 0; i < 8; i++)\n1316\t          classwords[i] |= (uint32_t)(~pbits.classwords[i]);\n1317\t      else\n1318\t        for (int i = 0; i < 8; i++)\n1319\t          classwords[i] |= pbits.classwords[i];\n1320\t      }\n1321\t\n1322\t#ifdef SUPPORT_WIDE_CHARS\n1323\t    /* Every class contains at least one < 256 character. */\n1324\t    xclass_props |= XCLASS_HAS_8BIT_CHARS;\n1325\t#endif\n1326\t    continue;               /* End of POSIX handling */\n1327\t\n1328\t    /* Other than POSIX classes, the only items we should encounter are\n1329\t    \\d-type escapes and literal characters (possibly as ranges). */\n1330\t    case META_BIGVALUE:\n1331\t    meta = *(pptr++);\n1332\t    break;\n1333\t\n1334\t    case META_ESCAPE:\n1335\t    escape = META_DATA(meta);\n1336\t\n1337\t    switch(escape)\n1338\t      {\n1339\t      case ESC_d:\n1340\t      for (int i = 0; i < 32; i++) classbits[i] |= cbits[i+cbit_digit];\n1341\t      break;\n1342\t\n1343\t      case ESC_D:\n1344\t      should_flip_negation = TRUE;\n1345\t      for (int i = 0; i < 32; i++)\n1346\t        classbits[i] |= (uint8_t)(~cbits[i+cbit_digit]);\n1347\t      break;\n1348\t\n1349\t      case ESC_w:\n1350\t      for (int i = 0; i < 32; i++) classbits[i] |= cbits[i+cbit_word];\n1351\t      break;\n1352\t\n1353\t      case ESC_W:\n1354\t      should_flip_negation = TRUE;\n1355\t      for (int i = 0; i < 32; i++)\n1356\t        classbits[i] |= (uint8_t)(~cbits[i+cbit_word]);\n1357\t      break;\n1358\t\n1359\t      /* Perl 5.004 onwards omitted VT from \\s, but restored it at Perl\n1360\t      5.18. Before PCRE 8.34, we had to preserve the VT bit if it was\n1361\t      previously set by something earlier in the character class.\n1362\t      Luckily, the value of CHAR_VT is 0x0b in both ASCII and EBCDIC, so\n1363\t      we could just adjust the appropriate bit. Fr