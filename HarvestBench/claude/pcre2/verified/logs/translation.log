--------------------------------\n187\tThe C code uses gotos, which Rust does not have. The interpreter is therefore\n188\ttranslated into a state machine: a `state` variable holds the \"program counter\"\n189\tand 'sm: loop { ... } dispatches on it.\n190\t\n191\t  * states 0..=172   : the opcode currently being processed (i.e. the C\n192\t                       `switch(Fop)` cases). The `match` arms use the OP_xxx\n193\t                       constants directly.\n194\t  * ST_TOP           : top of the C `for (;;)` loop: fetch Fop and dispatch.\n195\t  * ST_MATCH_RECURSE : the C MATCH_RECURSE label (create a new frame).\n196\t  * ST_NEW_FRAME     : the C NEW_FRAME label.\n197\t  * ST_RETURN_SWITCH : the C RETURN_SWITCH label (pop a frame and resume).\n198\t  * ST_L_RMnnn       : the C L_RMnnn resume labels (= 2000 + nnn).\n199\t  * ST_xxx (3000+)   : the other labels inside the switch arms.\n200\t--------------------------------------------------------------------------- */\n201\t\n202\tconst ST_TOP: u32 = 1000;\n203\tconst ST_MATCH_RECURSE: u32 = 1001;\n204\tconst ST_NEW_FRAME: u32 = 1002;\n205\tconst ST_RETURN_SWITCH: u32 = 1003;\n206\t\n207\tconst ST_L_RM_BASE: u32 = 2000;\n208\t\n209\tconst ST_L_RM1: u32 = 2001;\n210\tconst ST_L_RM2: u32 = 2002;\n211\tconst ST_L_RM3: u32 = 2003;\n212\tconst ST_L_RM4: u32 = 2004;\n213\tconst ST_L_RM5: u32 = 2005;\n214\tconst ST_L_RM6: u32 = 2006;\n215\tconst ST_L_RM7: u32 = 2007;\n216\tconst ST_L_RM8: u32 = 2008;\n217\tconst ST_L_RM9: u32 = 2009;\n218\tconst ST_L_RM10: u32 = 2010;\n219\tconst ST_L_RM11: u32 = 2011;\n220\tconst ST_L_RM12: u32 = 2012;\n221\tconst ST_L_RM13: u32 = 2013;\n222\tconst ST_L_RM14: u32 = 2014;\n223\tconst ST_L_RM15: u32 = 2015;\n224\tconst ST_L_RM16: u32 = 2016;\n225\tconst ST_L_RM17: u32 = 2017;\n226\tconst ST_L_RM18: u32 = 2018;\n227\tconst ST_L_RM19: u32 = 2019;\n228\tconst ST_L_RM20: u32 = 2020;\n229\tconst ST_L_RM21: u32 = 2021;\n230\tconst ST_L_RM22: u32 = 2022;\n231\tconst ST_L_RM23: u32 = 2023;\n232\tconst ST_L_RM24: u32 = 2024;\n233\tconst ST_L_RM25: u32 = 2025;\n234\tconst ST_L_RM26: u32 = 2026;\n235\tconst ST_L_RM27: u32 = 2027;\n236\tconst ST_L_RM28: u32 = 2028;\n237\tconst ST_L_RM29: u32 = 2029;\n238\tconst ST_L_RM30: u32 = 2030;\n239\tconst ST_L_RM31: u32 = 2031;\n240\tconst ST_L_RM32: u32 = 2032;\n241\tconst ST_L_RM33: u32 = 2033;\n242\tconst ST_L_RM34: u32 = 2034;\n243\tconst ST_L_RM35: u32 = 2035;\n244\tconst ST_L_RM36: u32 = 2036;\n245\tconst ST_L_RM37: u32 = 2037;\n246\tconst ST_L_RM38: u32 = 2038;\n247\tconst ST_L_RM39: u32 = 2039;\n248\tconst ST_L_RM100: u32 = 2100;\n249\tconst ST_L_RM101: u32 = 2101;\n250\tconst ST_L_RM102: u32 = 2102;\n251\tconst ST_L_RM103: u32 = 2103;\n252\tconst ST_L_RM200: u32 = 2200;\n253\tconst ST_L_RM201: u32 = 2201;\n254\tconst ST_L_RM202: u32 = 2202;\n255\tconst ST_L_RM203: u32 = 2203;\n256\tconst ST_L_RM204: u32 = 2204;\n257\tconst ST_L_RM205: u32 = 2205;\n258\tconst ST_L_RM206: u32 = 2206;\n259\tconst ST_L_RM207: u32 = 2207;\n260\tconst ST_L_RM208: u32 = 2208;\n261\tconst ST_L_RM209: u32 = 2209;\n262\tconst ST_L_RM210: u32 = 2210;\n263\tconst ST_L_RM211: u32 = 2211;\n264\tconst ST_L_RM212: u32 = 2212;\n265\tconst ST_L_RM213: u32 = 2213;\n266\tconst ST_L_RM214: u32 = 2214;\n267\tconst ST_L_RM215: u32 = 2215;\n268\tconst ST_L_RM216: u32 = 2216;\n269\tconst ST_L_RM217: u32 = 2217;\n270\tconst ST_L_RM218: u32 = 2218;\n271\tconst ST_L_RM219: u32 = 2219;\n272\tconst ST_L_RM220: u32 = 2220;\n273\tconst ST_L_RM221: u32 = 2221;\n274\tconst ST_L_RM222: u32 = 2222;\n275\tconst ST_L_RM223: u32 = 2223;\n276\tconst ST_L_RM224: u32 = 2224;\n277\t\n278\t/* The other labels in the C switch statement. Extra states that an individual\n279\topcode group needs internally may be added in the 4000+ range by the code that\n280\tneeds them. */\n281\t\n282\tconst ST_REPEATCHAR: u32 = 3001;\n283\tconst ST_REPEATNOTCHAR: u32 = 3002;\n284\tconst ST_REPEATTYPE: u32 = 3003;\n285\tconst ST_REF_REPEAT: u32 = 3004;\n286\tconst ST_POSSESSIVE_NON_CAPTURE: u32 = 3005;\n287\tconst ST_POSSESSIVE_CAPTURE: u32 = 3006;\n288\tconst ST_POSSESSIVE_GROUP: u32 = 3007;\n289\tconst ST_GROUPLOOP: u32 = 3008;\n290\tconst ST_ASSERT_NOT_FAILED: u32 = 3009;\n291\tconst ST_ASSERT_NL_OR_EOS: u32 = 3010;\n292\tconst ST_SCS_OFFSET_FOUND: u32 = 3011;\n293\tconst ST_GOT_MAX: u32 = 3012;\n294\tconst ST_ENDLOOP99: u32 = 3013;\n295\tconst ST_ENDLOOP00: u32 = 3014;\n296\tconst ST_ENDLOOP01: u32 = 3015;\n297\tconst ST_ENDLOOP02: u32 = 3016;\n298\tconst ST_ENDLOOP03: u32 = 3017;\n299\t\n300\t\n301\t/* Spare states for the individual opcode-group fragments. Fragment k may use\n302\tST_Ck_1 .. ST_Ck_8 for control flow that needs extra labels (e.g. the top of a\n303\tloop whose body contains an RMATCH). */\n304\t\n305\tconst ST_C1_1: u32 = 4011;\n306\tconst ST_C1_2: u32 = 4012;\n307\tconst ST_C1_3: u32 = 4013;\n308\tconst ST_C1_4: u32 = 4014;\n309\tconst ST_C1_5: u32 = 4015;\n310\tconst ST_C1_6: u32 = 4016;\n311\tconst ST_C1_7: u32 = 4017;\n312\tconst ST_C1_8: u32 = 4018;\n313\t\n314\tconst ST_C2_1: u32 = 4021;\n315\tconst ST_C2_2: u32 = 4022;\n316\tconst ST_C2_3: u32 = 4023;\n317\tconst ST_C2_4: u32 = 4024;\n318\tconst ST_C2_5: u32 = 4025;\n319\tconst ST_C2_6: u32 = 4026;\n320\tconst ST_C2_7: u32 = 4027;\n321\tconst ST_C2_8: u32 = 4028;\n322\t\n323\tconst ST_C3_1: u32 = 4031;\n324\tconst ST_C3_2: u32 = 4032;\n325\tconst ST_C3_3: u32 = 4033;\n326\tconst ST_C3_4: u32 = 4034;\n327\tconst ST_C3_5: u32 = 4035;\n328\tconst ST_C3_6: u32 = 4036;\n329\tconst ST_C3_7: u32 = 4037;\n330\tconst ST_C3_8: u32 = 4038;\n331\t\n332\tconst ST_C4_1: u32 = 4041;\n333\tconst ST_C4_2: u32 = 4042;\n334\tconst ST_C4_3: u32 = 4043;\n335\tconst ST_C4_4: u32 = 4044;\n336\tconst ST_C4_5: u32 = 4045;\n337\tconst ST_C4_6: u32 = 4046;\n338\tconst ST_C4_7: u32 = 4047;\n339\tconst ST_C4_8: u32 = 4048;\n340\t\n341\tconst ST_C5_1: u32 = 4051;\n342\tconst ST_C5_2: u32 = 4052;\n343\tconst ST_C5_3: u32 = 4053;\n344\tconst ST_C5_4: u32 = 4054;\n345\tconst ST_C5_5: u32 = 4055;\n346\tconst ST_C5_6: u32 = 4056;\n347\tconst ST_C5_7: u32 = 4057;\n348\tconst ST_C5_8: u32 = 4058;\n349\t\n350\tconst ST_C6_1: u32 = 4061;\n351\tconst ST_C6_2: u32 = 4062;\n352\tconst ST_C6_3: u32 = 4063;\n353\tconst ST_C6_4: u32 = 4064;\n354\tconst ST_C6_5: u32 = 4065;\n355\tconst ST_C6_6: u32 = 4066;\n356\tconst ST_C6_7: u32 = 4067;\n357\tconst ST_C6_8: u32 = 4068;\n358\t\n359\tconst ST_C7_1: u32 = 4071;\n360\tconst ST_C7_2: u32 = 4072;\n361\tconst ST_C7_3: u32 = 4073;\n362\tconst ST_C7_4: u32 = 4074;\n363\tconst ST_C7_5: u32 = 4075;\n364\tconst ST_C7_6: u32 = 4076;\n365\tconst ST_C7_7: u32 = 4077;\n366\tconst ST_C7_8: u32 = 4078;\n367\t\n368\tconst ST_C8_1: u32 = 4081;\n369\tconst ST_C8_2: u32 = 4082;\n370\tconst ST_C8_3: u32 = 4083;\n371\tconst ST_C8_4: u32 = 4084;\n372\tconst ST_C8_5: u32 = 4085;\n373\tconst ST_C8_6: u32 = 4086;\n374\tconst ST_C8_7: u32 = 4087;\n375\tconst ST_C8_8: u32 = 4088;\n376\t\n377\tconst ST_C9_1: u32 = 4091;\n378\tconst ST_C9_2: u32 = 4092;\n379\tconst ST_C9_3: u32 = 4093;\n380\tconst ST_C9_4: u32 = 4094;\n381\tconst ST_C9_5: u32 = 4095;\n382\tconst ST_C9_6: u32 = 4096;\n383\tconst ST_C9_7: u32 = 4097;\n384\tconst ST_C9_8: u32 = 4098;\n385\t\n386\tconst ST_C10_1: u32 = 4101;\n387\tconst ST_C10_2: u32 = 4102;\n388\tconst ST_C10_3: u32 = 4103;\n389\tconst ST_C10_4: u32 = 4104;\n390\tconst ST_C10_5: u32 = 4105;\n391\tconst ST_C10_6: u32 = 4106;\n392\tconst ST_C10_7: u32 = 4107;\n393\tconst ST_C10_8: u32 = 4108;\n394\t\n395\tconst ST_C11_1: u32 = 4111;\n396\tconst ST_C11_2: u32 = 4112;\n397\tconst ST_C11_3: u32 = 4113;\n398\tconst ST_C11_4: u32 = 4114;\n399\tconst ST_C11_5: u32 = 4115;\n400\tconst ST_C11_6: u32 = 4116;\n401\tconst ST_C11_7: u32 = 4117;\n402\tconst ST_C11_8: u32 = 4118;\n403\t\n404\tconst ST_C12_1: u32 = 4121;\n405\tconst ST_C12_2: u32 = 4122;\n406\tconst ST_C12_3: u32 = 4123;\n407\tconst ST_C12_4: u32 = 4124;\n408\tconst ST_C12_5: u32 = 4125;\n409\tconst ST_C12_6: u32 = 4126;\n410\tconst ST_C12_7: u32 = 4127;\n411\tconst ST_C12_8: u32 = 4128;\n412\t\n413\tconst ST_C13_1: u32 = 4131;\n414\tconst ST_C13_2: u32 = 4132;\n415\tconst ST_C13_3: u32 = 4133;\n416\tconst ST_C13_4: u32 = 4134;\n417\tconst ST_C13_5: u32 = 4135;\n418\tconst ST_C13_6: u32 = 4136;\n419\tconst ST_C13_7: u32 = 4137;\n420\tconst ST_C13_8: u32 = 4138;\n421\t\n422\t/* Static helper functions of pcre2_match.c: do_callout(), match_ref() and\n423\trecurse_update_offsets(). */\n424\tinclude!(\"pcre2_match_helpers.rs\");\n425\t\n426\t/*************************************************\n427\t*         Match from current position            *\n428\t*************************************************/\n429\t\n430\t/* This function is called to run one match attempt at a single starting point\n431\tin the subject.\n432\t\n433\tArguments:\n434\t   start_eptr   starting character in subject\n435\t   start_ecode  starting position in compiled code\n436\t   top_bracket  number of capturing parentheses in the pattern\n437\t   frame_size   size of each backtracking frame\n438\t   match_data   pointer to the match_data block\n439\t   mb           pointer to \"static\" variables block\n440\t\n441\tReturns:        MATCH_MATCH if matched            )  these values are >= 0\n442\t                MATCH_NOMATCH if failed to match  )\n443\t                negative MATCH_xxx value for PRUNE, SKIP, etc\n444\t                negative PCRE2_ERROR_xxx value if aborted by an error condition\n445\t                (e.g. stopped by repeated call or depth limit)\n446\t*/\n447\t\n448\tunsafe fn r#match(\n449\t    start_eptr: PCRE2_SPTR,\n450\t    start_ecode_arg: PCRE2_SPTR,\n451\t    top_bracket: u16,\n452\t    frame_size: PCRE2_SIZE,\n453\t    match_data: *mut pcre2_real_match_data,\n454\t    mb: *mut match_block,\n455\t) -> c_int {\n456\t    /* Frame-handling variables */\n457\t\n458\t    let mut F: *mut heapframe; /* Current frame pointer */\n459\t    let mut N: *mut heapframe = core::ptr::null_mut(); /* Temporary frame pointers */\n460\t    let mut P: *mut heapframe = core::ptr::null_mut();\n461\t\n462\t    let mut frames_top: *mut heapframe; /* End of frames vector */\n463\t    let mut assert_accept_frame: *mut heapframe = core::ptr::null_mut(); /* For passing back a frame with captures */\n464\t    let frame_copy_size: PCRE2_SIZE; /* Amount to copy when creating a new frame */\n465\t\n466\t    /* Local variables that do not need to be preserved over calls to RMATCH(). */\n467\t\n468\t    let mut branch_end: PCRE2_SPTR = core::ptr::null();\n469\t    let mut branch_start: PCRE2_SPTR;\n470\t    let mut bracode: PCRE2_SPTR; /* Temp pointer to start of group */\n471\t    let mut offset: PCRE2_SIZE; /* Used for group offsets */\n472\t    let mut length: PCRE2_SIZE; /* Used for various length calculations */\n473\t\n474\t    let mut rrc: c_int = 0; /* Return from functions & backtracking \"recursions\" */\n475\t    let mut proptype: c_int; /* Type of character property */\n476\t\n477\t    let mut i: u32; /* Used for local loops */\n478\t    let mut fc: u32; /* Character values */\n479\t    let mut number: u32; /* Used for group and other numbers */\n480\t    let mut reptype: u32 = 0; /* Type of repetition (0 to avoid compiler warning) */\n481\t    let mut group_frame_type: u32; /* Specifies type for new group frames */\n482\t\n483\t    let mut condition: BOOL; /* Used in conditional groups */\n484\t    let mut cur_is_word: BOOL; /* Used in \"word\" tests */\n485\t    let mut prev_is_word: BOOL; /* Used in \"word\" tests */\n486\t\n487\t    /* The code pointer for the next RMATCH \"recursion\" */\n488\t    let mut start_ecode: PCRE2_SPTR = start_ecode_arg;\n489\t\n490\t    /* UTF and UCP flags */\n491\t\n492\t    let utf: BOOL = (((*mb).poptions & PCRE2_UTF) != 0) as BOOL;\n493\t    let ucp: BOOL = (((*mb).poptions & PCRE2_UCP) != 0) as BOOL;\n494\t\n495\t    /* This is the length of the last part of a backtracking frame that must be\n496\t    copied when a new frame is created. */\n497\t\n498\t    frame_copy_size = frame_size - offset_of!(heapframe, eptr);\n499\t\n500\t    /* Set up the first frame and the end of the frames vector. */\n501\t\n502\t    F = (*match_data).heapframes;\n503\t    frames_top = ((*match_data).heapframes as *mut u8).add((*match_data).heapframes_size)\n504\t        as *mut heapframe;\n505\t\n506\t    (*F).rdepth = 0; /* \"Recursion\" depth */\n507\t    (*F).capture_last = 0; /* Number of most recent capture */\n508\t    (*F).current_recurse = RECURSE_UNSET; /* Not pattern recursing. */\n509\t    (*F).eptr = start_eptr; /* Current data pointer */\n510\t    (*F).start_match = start_eptr; /* and start match */\n511\t    (*F).mark = core::ptr::null(); /* Most recent mark */\n512\t    (*F).offset_top = 0; /* End of captures within the frame */\n513\t    (*F).last_group_offset = PCRE2_UNSET; /* Saved frame of most recent group */\n514\t    group_frame_type = 0; /* Not a start of group frame */\n515\t\n516\t    let mut state: u32 = ST_NEW_FRAME; /* Start processing with this frame */\n517\t\n518\t    'sm: loop {\n519\t        /* ------------------------------------------------------------------\n520\t        Local macros standing in for the C macros of the same name. Note that\n521\t        RMATCH() and RRETURN() transfer control, so the code that follows an\n522\t        RMATCH() in the C source lives in the ST_L_RMnnn state.\n523\t        ------------------------------------------------------------------ */\n524\t\n525\t        macro_rules! CHECK_PARTIAL {\n526\t            () => {\n527\t                if (*F).eptr >= (*mb).end_subject {\n528\t                    SCHECK_PARTIAL!();\n529\t                }\n530\t            };\n531\t        }\n532\t\n533\t        macro_rules! SCHECK_PARTIAL {\n534\t            () => {\n535\t                if (*mb).partial != 0\n536\t                    && ((*F).eptr > (*mb).start_used_ptr || (*mb).allowemptypartial != 0)\n537\t                {\n538\t                    (*mb).hitend = TRUE;\n539\t                    if (*mb).partial > 1 {\n540\t                        return PCRE2_ERROR_PARTIAL;\n541\t                    }\n542\t                }\n543\t            };\n544\t        }\n545\t\n546\t        macro_rules! RMATCH {\n547\t            ($ra:expr, $rb:expr) => {{\n548\t                start_ecode = $ra;\n549\t                (*F).return_id = $rb;\n550\t                state = ST_MATCH_RECURSE;\n551\t                continue 'sm;\n552\t            }};\n553\t        }\n554\t\n555\t        macro_rules! RRETURN {\n556\t            ($ra:expr) => {{\n557\t                rrc = $ra;\n558\t                state = ST_RETURN_SWITCH;\n559\t                continue 'sm;\n560\t            }};\n561\t        }\n562\t\n563\t        /* Fovector[n] */\n564\t        macro_rules! Fov {\n565\t            ($i:expr) => {\n566\t                *(*F).ovector.as_mut_ptr().add($i as usize)\n567\t            };\n568\t        }\n569\t\n570\t        /* Frame machinery states. */\n571\t\n572\t        match state {\n573\t            ST_MATCH_RECURSE => {\n574\t                /* Set up a new backtracking frame. If the vector is full, get a new one,\n575\t                doubling the size, but constrained by the heap limit (which is in KiB). */\n576\t\n577\t                N = (F as *mut u8).add(frame_size) as *mut heapframe;\n578\t                if (N as *mut u8).add(frame_size) as *mut heapframe >= frames_top {\n579\t                    let new: *mut c_void;\n580\t                    let mut newsize: PCRE2_SIZE;\n581\t                    let usedsize: PCRE2_SIZE =\n582\t                        (N as *mut u8).offset_from((*match_data).heapframes as *mut u8) as PCRE2_SIZE;\n583\t\n584\t                    if (*match_data).heapframes_size >= PCRE2_SIZE_MAX / 2 {\n585\t                        if (*match_data).heapframes_size == PCRE2_SIZE_MAX - 1 {\n586\t                            return PCRE2_ERROR_NOMEMORY;\n587\t                        }\n588\t                        newsize = PCRE2_SIZE_MAX - 1;\n589\t                    } else {\n590\t                        newsize = (*match_data).heapframes_size * 2;\n591\t                    }\n592\t\n593\t                    if newsize / 1024 >= (*mb).heap_limit as PCRE2_SIZE {\n594\t                        let old_size: PCRE2_SIZE = (*match_data).heapframes_size / 1024;\n595\t                        if (*mb).heap_limit as PCRE2_SIZE <= old_size {\n596\t                            return PCRE2_ERROR_HEAPLIMIT;\n597\t                        } else {\n598\t                            let mut max_delta: PCRE2_SIZE =\n599\t                                1024 * ((*mb).heap_limit as PCRE2_SIZE - old_size);\n600\t                            let over_bytes: c_int =\n601\t                                ((*match_data).heapframes_size % 1024) as c_int;\n602\t                            if over_bytes != 0 {\n603\t                                max_delta -= (1024 - over_bytes) as PCRE2_SIZE;\n604\t                            }\n605\t                            newsize = (*match_data).heapframes_size + max_delta;\n606\t                        }\n607\t                    }\n608\t\n609\t                    /* With a heap limit set, the permitted additional size may not be enough\n610\t                    for another frame, so do a final check. */\n611\t\n612\t                    if newsize - usedsize < frame_size {\n613\t                        return PCRE2_ERROR_HEAPLIMIT;\n614\t                    }\n615\t                    new = ((*match_data).memctl.malloc.unwrap())(\n616\t                        newsize,\n617\t                        (*match_data).memctl.memory_data,\n618\t                    );\n619\t                    if new.is_null() {\n620\t                        return PCRE2_ERROR_NOMEMORY;\n621\t                    }\n622\t                    memcpy(new, (*match_data).heapframes as *const c_void, usedsize);\n623\t\n624\t                    N = (new as *mut u8).add(usedsize) as *mut heapframe;\n625\t                    F = (N as *mut u8).sub(frame_size) as *mut heapframe;\n626\t\n627\t                    ((*match_data).memctl.free.unwrap())(\n628\t                        (*match_data).heapframes as *mut c_void,\n629\t                        (*match_data).memctl.memory_data,\n630\t                    );\n631\t                    (*match_data).heapframes = new as *mut heapframe;\n632\t                    (*match_data).heapframes_size = newsize;\n633\t                    frames_top = (new as *mut u8).add(newsize) as *mut heapframe;\n634\t                }\n635\t\n636\t                /* Copy those fields that must be copied into the new frame, increase the\n637\t                \"recursion\" depth (i.e. the new frame's index) and then make the new frame\n638\t                current. */\n639\t\n640\t                memcpy(\n641\t                    (N as *mut u8).add(offset_of!(heapframe, eptr)) as *mut c_void,\n642\t                    (F as *mut u8).add(offset_of!(heapframe, eptr)) as *const c_void,\n643\t                    frame_copy_size,\n644\t                );\n645\t\n646\t                (*N).rdepth = (*F).rdepth + 1;\n647\t                F = N;\n648\t\n649\t                state = ST_NEW_FRAME;\n650\t                continue 'sm;\n651\t            }\n652\t\n653\t            ST_NEW_FRAME => {\n654\t                (*F).group_frame_type = group_frame_type;\n655\t                (*F).ecode = start_ecode; /* Starting code pointer */\n656\t                (*F).back_frame = frame_size; /* Default is go back one frame */\n657\t\n658\t                /* If this is a special type of group frame, remember its offset for quick\n659\t                access at the end of the group. If this is a recursion, set a new current\n660\t                recursion value. */\n661\t\n662\t                if group_frame_type != 0 {\n663\t                    (*F).last_group_offset = (F as *mut u8)\n664\t                        .offset_from((*match_data).heapframes as *mut u8)\n665\t                        as PCRE2_SI