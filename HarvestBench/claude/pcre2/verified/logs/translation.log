{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Lin8HYSnRa15N4kGHqeqP5","type":"tool_result","content":"1\t// Translated from c_src/src/pcre2_dfa_match.c\n2\tuse crate::internal::*;\n3\t\n4\tinclude!(\"pcre2_dfa_match_head.rs\");\n5\tinclude!(\"pcre2_dfa_match_tables.rs\");\n6\t\n7\t/* The static helper functions do_callout_dfa() and more_workspace(). */\n8\tinclude!(\"pcre2_dfa_match_helpers.rs\");\n9\t\n10\t/*************************************************\n11\t*     Match a Regular Expression - DFA engine    *\n12\t*************************************************/\n13\t\n14\t/* This is the main matching function. It is called recursively for some\n15\tpatterns (assertions, recursion, possessive groups).\n16\t\n17\tReturns:            > 0 => number of match offset pairs placed in offsets\n18\t                    = 0 => offsets overflowed; longest matches are present\n19\t                     -1 => failed to match\n20\t                   < -1 => some kind of unexpected problem\n21\t*/\n22\t\n23\tunsafe fn internal_dfa_match(\n24\t    mb: *mut dfa_match_block,\n25\t    this_start_code: PCRE2_SPTR,\n26\t    current_subject_arg: PCRE2_SPTR,\n27\t    start_offset: PCRE2_SIZE,\n28\t    offsets: *mut PCRE2_SIZE,\n29\t    offsetcount_arg: u32,\n30\t    workspace: *mut c_int,\n31\t    wscount_arg: c_int,\n32\t    rlevel_arg: u32,\n33\t    RWS: *mut c_int,\n34\t) -> c_int {\n35\t    let mut current_subject: PCRE2_SPTR = current_subject_arg;\n36\t    let mut offsetcount: u32 = offsetcount_arg;\n37\t    let mut wscount: c_int = wscount_arg;\n38\t    let mut rlevel: u32 = rlevel_arg;\n39\t\n40\t    let mut active_states: *mut stateblock;\n41\t    let mut new_states: *mut stateblock;\n42\t    let mut temp_states: *mut stateblock;\n43\t    let mut next_active_state: *mut stateblock;\n44\t    let mut next_new_state: *mut stateblock;\n45\t    let ctypes: *const u8;\n46\t    let lcc: *const u8;\n47\t    let fcc: *const u8;\n48\t    let mut ptr: PCRE2_SPTR;\n49\t    let mut end_code: PCRE2_SPTR;\n50\t    let mut new_recursive: dfa_recursion_info = core::mem::zeroed();\n51\t    let mut active_count: c_int;\n52\t    let mut new_count: c_int;\n53\t    let mut match_count: c_int;\n54\t\n55\t    /* Some fields in the mb block are frequently referenced, so we load them into\n56\t    independent variables in the hope that this will perform better. */\n57\t\n58\t    let start_subject: PCRE2_SPTR = (*mb).start_subject;\n59\t    let end_subject: PCRE2_SPTR = (*mb).end_subject;\n60\t    let start_code: PCRE2_SPTR = (*mb).start_code;\n61\t\n62\t    let utf: BOOL = (((*mb).poptions & PCRE2_UTF) != 0) as BOOL;\n63\t    let utf_or_ucp: BOOL = (utf != 0 || ((*mb).poptions & PCRE2_UCP) != 0) as BOOL;\n64\t\n65\t    let mut reset_could_continue: BOOL = FALSE;\n66\t\n67\t    let mcc = (*mb).match_call_count;\n68\t    (*mb).match_call_count = mcc + 1;\n69\t    if mcc >= (*mb).match_limit {\n70\t        return PCRE2_ERROR_MATCHLIMIT;\n71\t    }\n72\t    {\n73\t        let old = rlevel;\n74\t        rlevel = old + 1;\n75\t        if old > (*mb).match_limit_depth {\n76\t            return PCRE2_ERROR_DEPTHLIMIT;\n77\t        }\n78\t    }\n79\t    offsetcount &= (-2i32) as u32; /* Round down */\n80\t\n81\t    wscount -= 2;\n82\t    wscount = (wscount - (wscount % (INTS_PER_STATEBLOCK * 2))) / (2 * INTS_PER_STATEBLOCK);\n83\t\n84\t    ctypes = (*mb).tables.add(ctypes_offset);\n85\t    lcc = (*mb).tables.add(lcc_offset);\n86\t    fcc = (*mb).tables.add(fcc_offset);\n87\t\n88\t    match_count = PCRE2_ERROR_NOMATCH; /* A negative number */\n89\t\n90\t    active_states = workspace.add(2) as *mut stateblock;\n91\t    new_states = active_states.add(wscount as usize);\n92\t    next_new_state = new_states;\n93\t    new_count = 0;\n94\t    active_count = 0;\n95\t    next_active_state = active_states;\n96\t\n97\t    /* The macros used for adding states to the two state vectors (one for the\n98\t    current character, one for the following character). */\n99\t\n100\t    macro_rules! ADD_ACTIVE {\n101\t        ($x:expr, $y:expr) => {{\n102\t            let ac__ = active_count;\n103\t            active_count = ac__ + 1;\n104\t            if ac__ < wscount {\n105\t                (*next_active_state).offset = $x;\n106\t                (*next_active_state).count = $y;\n107\t                next_active_state = next_active_state.add(1);\n108\t            } else {\n109\t                return PCRE2_ERROR_DFA_WSSIZE;\n110\t            }\n111\t        }};\n112\t    }\n113\t\n114\t    macro_rules! ADD_ACTIVE_DATA {\n115\t        ($x:expr, $y:expr, $z:expr) => {{\n116\t            let ac__ = active_count;\n117\t            active_count = ac__ + 1;\n118\t            if ac__ < wscount {\n119\t                (*next_active_state).offset = $x;\n120\t                (*next_active_state).count = $y;\n121\t                (*next_active_state).data = $z;\n122\t                next_active_state = next_active_state.add(1);\n123\t            } else {\n124\t                return PCRE2_ERROR_DFA_WSSIZE;\n125\t            }\n126\t        }};\n127\t    }\n128\t\n129\t    macro_rules! ADD_NEW {\n130\t        ($x:expr, $y:expr) => {{\n131\t            let nc__ = new_count;\n132\t            new_count = nc__ + 1;\n133\t            if nc__ < wscount {\n134\t                (*next_new_state).offset = $x;\n135\t                (*next_new_state).count = $y;\n136\t                next_new_state = next_new_state.add(1);\n137\t            } else {\n138\t                return PCRE2_ERROR_DFA_WSSIZE;\n139\t            }\n140\t        }};\n141\t    }\n142\t\n143\t    macro_rules! ADD_NEW_DATA {\n144\t        ($x:expr, $y:expr, $z:expr) => {{\n145\t            let nc__ = new_count;\n146\t            new_count = nc__ + 1;\n147\t            if nc__ < wscount {\n148\t                (*next_new_state).offset = $x;\n149\t                (*next_new_state).count = $y;\n150\t                (*next_new_state).data = $z;\n151\t                next_new_state = next_new_state.add(1);\n152\t            } else {\n153\t                return PCRE2_ERROR_DFA_WSSIZE;\n154\t            }\n155\t        }};\n156\t    }\n157\t\n158\t    /* The first thing in any (sub) pattern is a bracket of some sort. Push all\n159\t    the alternative states onto the list, and find out where the end is. This\n160\t    makes is possible to use this function recursively, when we want to stop at a\n161\t    matching internal ket rather than at the end.\n162\t\n163\t    If we are dealing with a backward assertion we have to find out the maximum\n164\t    amount to move back, and set up each alternative appropriately. */\n165\t\n166\t    if *this_start_code as u32 == OP_ASSERTBACK || *this_start_code as u32 == OP_ASSERTBACK_NOT {\n167\t        let mut max_back: usize = 0;\n168\t        let gone_back: usize;\n169\t\n170\t        end_code = this_start_code;\n171\t        loop {\n172\t            let back: usize = GET2!(end_code, 2 + LINK_SIZE) as usize;\n173\t            if back > max_back {\n174\t                max_back = back;\n175\t            }\n176\t            end_code = end_code.add(GET!(end_code, 1) as usize);\n177\t            if *end_code as u32 != OP_ALT {\n178\t                break;\n179\t            }\n180\t        }\n181\t\n182\t        /* If we can't go back the amount required for the longest lookbehind\n183\t        pattern, go back as far as we can; some alternatives may still be viable. */\n184\t\n185\t        /* In character mode we have to step back character by character */\n186\t\n187\t        if utf != 0 {\n188\t            let mut gb: usize = 0;\n189\t            while gb < max_back {\n190\t                if current_subject <= start_subject {\n191\t                    break;\n192\t                }\n193\t                current_subject = current_subject.sub(1);\n194\t                ACROSSCHAR!(\n195\t                    current_subject > start_subject,\n196\t                    current_subject,\n197\t                    current_subject = current_subject.sub(1)\n198\t                );\n199\t                gb += 1;\n200\t            }\n201\t            gone_back = gb;\n202\t        } else {\n203\t            /* In byte-mode we can do this quickly. */\n204\t            let current_offset: usize = current_subject.offset_from(start_subject) as usize;\n205\t            gone_back = if current_offset < max_back {\n206\t                current_offset\n207\t            } else {\n208\t                max_back\n209\t            };\n210\t            current_subject = current_subject.sub(gone_back);\n211\t        }\n212\t\n213\t        /* Save the earliest consulted character */\n214\t\n215\t        if current_subject < (*mb).start_used_ptr {\n216\t            (*mb).start_used_ptr = current_subject;\n217\t        }\n218\t\n219\t        /* Now we can process the individual branches. There will be an OP_REVERSE at\n220\t        the start of each branch, except when the length of the branch is zero. */\n221\t\n222\t        end_code = this_start_code;\n223\t        loop {\n224\t            let revlen: u32 = if *end_code.add(1 + LINK_SIZE) as u32 == OP_REVERSE {\n225\t                (1 + IMM2_SIZE) as u32\n226\t            } else {\n227\t                0\n228\t            };\n229\t            let back: usize = if revlen == 0 {\n230\t                0\n231\t            } else {\n232\t                GET2!(end_code, 2 + LINK_SIZE) as usize\n233\t            };\n234\t            if back <= gone_back {\n235\t                let bstate: c_int =\n236\t                    (end_code.offset_from(start_code) as usize + 1 + LINK_SIZE + revlen as usize)\n237\t                        as c_int;\n238\t                ADD_NEW_DATA!(-bstate, 0, (gone_back - back) as c_int);\n239\t            }\n240\t            end_code = end_code.add(GET!(end_code, 1) as usize);\n241\t            if *end_code as u32 != OP_ALT {\n242\t                break;\n243\t            }\n244\t        }\n245\t    }\n246\t    /* This is t