             i = 1;\n714\t                while i < length {\n715\t                    groupnumber = groupnumber * 10 + (*name.add(i as usize) as u32 - CHAR_0);\n716\t                    if groupnumber > MAX_GROUP_NUMBER as u32 {\n717\t                        *errorcodeptr = ERR61;\n718\t                        (*cb).erroroffset = offset + i as PCRE2_SIZE;\n719\t                        return 0;\n720\t                    }\n721\t                    i += 1;\n722\t                }\n723\t            }\n724\t\n725\t            if meta != META_COND_RNUMBER || groupnumber > (*cb).bracount {\n726\t                *errorcodeptr = ERR15;\n727\t                (*cb).erroroffset = offset;\n728\t                return 0;\n729\t            }\n730\t\n731\t            /* (?Rdigits) treated as a recursion reference by number. A value of\n732\t            zero (which is the result of both (?R) and (?R0)) means \"any\", and is\n733\t            translated into RREF_ANY (which is 0xffff). */\n734\t\n735\t            if groupnumber == 0 {\n736\t                groupnumber = RREF_ANY;\n737\t            }\n738\t            /* PCRE2_ASSERT(start_pptr[0] == META_COND_RNUMBER); */\n739\t            *start_pptr.add(1) = groupnumber;\n740\t            skipunits = 1 + IMM2_SIZE as u32;\n741\t            break 'group_process_note_empty;\n742\t        }\n743\t\n744\t        /* From here on, we know we have a name (not a number),\n745\t        so treat META_COND_RNUMBER the same as META_COND_NAME. */\n746\t        if meta == META_COND_RNUMBER {\n747\t            meta = META_COND_NAME;\n748\t        }\n749\t\n750\t        if ((*ng).hash_dup & NAMED_GROUP_IS_DUPNAME) == 0 {\n751\t            /* Found a non-duplicated name. Since it is a global,\n752\t            it is enough to update it in the pre-processing phase. */\n753\t            if (*ng).number > (*cb).top_backref {\n754\t                (*cb).top_backref = (*ng).number;\n755\t            }\n756\t\n757\t            *start_pptr.add(0) = meta;\n758\t            *start_pptr.add(1) = (*ng).number;\n759\t\n760\t            skipunits = 1 + IMM2_SIZE as u32;\n761\t            break 'group_process_note_empty;\n762\t        }\n763\t\n764\t        /* We have a duplicated name. In the compile pass we have to search the\n765\t        main table in order to get the index and count values. */\n766\t\n767\t        *start_pptr.add(0) = meta | 1;\n768\t        *start_pptr.add(1) = ng.offset_from((*cb).named_groups) as u32;\n769\t\n770\t        /* A duplicated name was found. Note that if an R<digits> name is found\n771\t        (META_COND_RNUMBER), it is a reference test, not a recursion test. */\n772\t        skipunits = 1 + 2 * IMM2_SIZE as u32;\n773\t    } else {\n774\t        /* Otherwise lengthptr equals to NULL,\n775\t        which is the second phase of compilation. */\n776\t        let mut count: c_int;\n777\t        let mut index: c_int;\n778\t        let ng: *mut named_group;\n779\t\n780\t        /* Generate code using the data\n781\t        collected in the pre-processing phase. */\n782\t\n783\t        if meta == META_COND_RNUMBER {\n784\t            *code.add(1 + LINK_SIZE) = OP_RREF as u8;\n785\t            PUT2!(code, 2 + LINK_SIZE, *pptr.add(1));\n786\t            skipunits = 1 + IMM2_SIZE as u32;\n787\t            pptr = pptr.add(1 + SIZEOFFSET);\n788\t            break 'group_process_note_empty;\n789\t        }\n790\t\n791\t        if meta_arg == 0 {\n792\t            *code.add(1 + LINK_SIZE) = if meta == META_COND_RNAME {\n793\t                OP_RREF as u8\n794\t            } else {\n795\t                OP_CREF as u8\n796\t            };\n797\t            PUT2!(code, 2 + LINK_SIZE, *pptr.add(1));\n798\t            skipunits = 1 + IMM2_SIZE as u32;\n799\t            pptr = pptr.add(1 + SIZEOFFSET);\n800\t            break 'group_process_note_empty;\n801\t        }\n802\t\n803\t        ng = (*cb).named_groups.add(*pptr.add(1) as usize);\n804\t        count = 0; /* Values for first pass (avoids compi