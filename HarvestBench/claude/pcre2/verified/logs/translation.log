 (cranges != NULL) break;\n1422\t#endif\n1423\t      add_not_list_to_class(options & ~PCRE2_CASELESS, xoptions,\n1424\t        cb, PRIV(vspace_list));\n1425\t#else\n1426\t      PCRE2_ASSERT(cranges != NULL);\n1427\t#endif\n1428\t      break;\n1429\t\n1430\t      /* If Unicode is not supported, \\P and \\p are not allowed and are\n1431\t      faulted at parse time, so will never appear here. */\n1432\t\n1433\t#ifdef SUPPORT_UNICODE\n1434\t      case ESC_p:\n1435\t      case ESC_P:\n1436\t        {\n1437\t        uint32_t ptype = *pptr >> 16;\n1438\t        uint32_t pdata = *(pptr++) & 0xffff;\n1439\t\n1440\t        /* The \"Any\" is processed by PRIV(update_classbits)(). */\n1441\t        if (ptype == PT_ANY)\n1442\t          {\n1443\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1444\t          if (!utf && escape == ESC_p) memset(classbits, 0xff, 32);\n1445\t#endif\n1446\t          continue;\n1447\t          }\n1448\t\n1449\t        PRIV(update_classbits)(ptype, pdata, (escape == ESC_P), classbits);\n1450\t\n1451\t        if ((xclass_props & XCLASS_HIGH_ANY) == 0)\n1452\t          {\n1453\t          if (lengthptr != NULL)\n1454\t            *lengthptr += 3;\n1455\t          else\n1456\t            {\n1457\t            *class_uchardata++ = (escape == ESC_p)? XCL_PROP : XCL_NOTPROP;\n1458\t            *class_uchardata++ = ptype;\n1459\t            *class_uchardata++ = pdata;\n1460\t            }\n1461\t          xclass_props |= XCLASS_REQUIRED | XCLASS_HAS_PROPS;\n1462\t          }\n1463\t        }\n1464\t      continue;\n1465\t#endif\n1466\t      }\n1467\t\n1468\t#ifdef SUPPORT_WIDE_CHARS\n1469\t    /* Every non-property class contains at least one < 256 character. */\n1470\t    xclass_props |= XCLASS_HAS_8BIT_CHARS;\n1471\t#endif\n1472\t    /* End handling \\d-type escapes */\n1473\t    continue;\n1474\t\n1475\t    CLASS_END_CASES(meta)\n1476\t    /* Literals. */\n1477\t    if (meta < META_END) break;\n1478\t    /* Non-literals: end of class contents. */\n1479\t    goto END_PROCESSING;\n1480\t    }\n1481\t\n1482\t  /* A literal character may be followed by a range meta. At parse time\n1483\t  there are checks for out-of-order characters, for ranges where the two\n1484\t  characters are equal, and for hyphens that cannot indicate a range. At\n1485\t  this point, therefore, no checking is needed. */\n1486\t\n1487\t  c = meta;\n1488\t\n1489\t  /* Remember if \\r or \\n were explicitly used */\n1490\t\n1491\t  if (c == CHAR_CR || c == CHAR_NL) cb->external_flags |= PCRE2_HASCRORLF;\n1492\t\n1493\t  /* Process a character range */\n1494\t\n1495\t  if (*pptr == META_RANGE_LITERAL || *pptr == META_RANGE_ESCAPED)\n1496\t    {\n1497\t    uint32_t d;\n1498\t\n1499\t#ifdef EBCDIC\n1500\t    BOOL range_is_literal = (*pptr == META_RANGE_LITERAL);\n1501\t#endif\n1502\t    ++pptr;\n1503\t    d = *(pptr++);\n1504\t    if (d == META_BIGVALUE) d = *(pptr++);\n1505\t\n1506\t    /* Remember an explicit \\r or \\n, and add the range to the class. */\n1507\t\n1508\t    if (d == CHAR_CR || d == CHAR_NL) cb->external_flags |= PCRE2_HASCRORLF;\n1509\t\n1510\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1511\t#ifdef SUPPORT_UNICODE\n1512\t    if (cranges != NULL) continue;\n1513\t    xclass_props |= XCLASS_HAS_8BIT_CHARS;\n1514\t#endif\n1515\t\n1516\t    /* In an EBCDIC environment, Perl treats alphabetic ranges specially\n1517\t    because there are holes in the encoding, and simply using the range\n1518\t    A-Z (for example) would include the characters in the holes. This\n1519\t    applies only to literal ranges; [\\xC1-\\xE9] is different to [A-Z]. */\n1520\t\n1521\t#ifdef EBCDIC\n1522\t    if (range_is_literal &&\n1523\t         (cb->ctypes[c] & ctype_letter) != 0 &&\n1524\t         (cb->ctypes[d] & ctype_letter) != 0 &&\n1525\t         (c <= CHAR_z) == (d <= CHAR_z))\n1526\t      {\n1527\t      uint32_t uc = (d <= CHAR_z)? 0 : 64;\n1528\t      uint32_t C = c - uc;\n1529\t      uint32_t D = d - uc;\n1530\t\n1531\t      if (C <= CHAR_i)\n1532\t        {\n1533\t        add_to_class(options, xoptions, cb, C + uc,\n1534\t          ((D < CHAR_i)? D : CHAR_i) + uc);\n1535\t        C = CHAR_j;\n1536\t        }\n1537\t\n1538\t      if (C <= D && C <= CHAR_r)\n1539\t        {\n1540\t        add_to_class(options, xoptions, cb, C + uc,\n1541\t          ((D < CHAR_r)? D : CHAR_r) + uc);\n1542\t        C = CHAR_s;\n1543\t        }\n1544\t\n1545\t      if (C <= D)\n1546\t        add_to_class(options, xoptions, cb, C + uc, D + uc);\n1547\t      }\n1548\t    else\n1549\t#endif\n1550\t    /* Not an EBCDIC special range */\n1551\t\n1552\t    add_to_class(options, xoptions, cb, c, d);\n1553\t#else\n1554\t    PCRE2_ASSERT(cranges != NULL);\n1555\t#endif\n1556\t    continue;\n1557\t    }  /* End of range handling */\n1558\t\n1559\t  /* Character ranges are ignored when class_ranges is present. */\n1560\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1561\t#ifdef SUPPORT_UNICODE\n1562\t  if (cranges != NULL) continue;\n1563\t  xclass_props |= XCLASS_HAS_8BIT_CHARS;\n1564\t#endif\n1565\t  /* Handle a single character. */\n1566\t\n1567\t  add_to_class(options, xoptions, cb, meta, meta);\n1568\t#else\n1569\t  PCRE2_ASSERT(cranges != NULL);\n1570\t#endif\n1571\t  }   /* End of main class-processing loop */\n1572\t\n1573\tEND_PROCESSING:\n1574\t\n1575\t#ifdef SUPPORT_WIDE_CHARS\n1576\tPCRE2_ASSERT((xclass_props & XCLASS_HAS_PROPS) == 0 ||\n1577\t             (xclass_props & XCLASS_HIGH_ANY) == 0);\n1578\t\n1579\tif (cranges != NULL)\n1580\t  {\n1581\t  uint32_t *range = (uint32_t*)(cranges + 1);\n1582\t  uint32_t *end = range + cranges->range_list_size;\n1583\t\n1584\t  while (range < end && range[0] < 256)\n1585\t    {\n1586\t    PCRE2_ASSERT((xclass_props & XCLASS_HAS_8BIT_CHARS) != 0);\n1587\t    /* Add range to bitset. If we are in UTF or UCP mode, then clear the\n1588\t    caseless bit, because the cranges handle caselessness (only) in this\n1589\t    condition; see the condition for PARSE_CLASS_CASELESS_UTF in\n1590\t    compile_optimize_class(). */\n1591\t    add_to_class(((options & (PCRE2_UTF|PCRE2_UCP)) != 0)?\n1592\t        (options & ~PCRE2_CASELESS) : options, xoptions, cb, range[0], range[1]);\n1593\t\n1594\t    if (range[1] > 255) break;\n1595\t    range += 2;\n1596\t    }\n1597\t\n1598\t  if (cranges->char_lists_size > 0)\n1599\t    {\n1600\t    /* The cranges structure is still used and freed later. */\n1601\t    PCRE2_ASSERT((xclass_props & XCLASS_HIGH_ANY) == 0);\n1602\t    xclass_props |= XCLASS_REQUIRED | XCLASS_HAS_CHAR_LISTS;\n1603\t    }\n1604\t  else\n1605\t    {\n1606\t    if ((xclass_props & XCLASS_HIGH_ANY) != 0)\n1607\t      {\n1608\t      PCRE2_ASSERT(range + 2 == end && range[0] <= 256 &&\n1609\t        range[1] >= GET_MAX_CHAR_VALUE(utf));\n1610\t      should_flip_negation = TRUE;\n1611\t      range = end;\n1612\t      }\n1613\t\n1614\t    while (range < end)\n1615\t      {\n1616\t      uint32_t range_start = range[0];\n1617\t      uint32_t range_end = range[1];\n1618\t\n1619\t      range += 2;\n1620\t      xclass_props |= XCLASS_REQUIRED;\n1621\t\n1622\t      if (range_start < 256) range_start = 256;\n1623\t\n1624\t      if (lengthptr != NULL)\n1625\t        {\n1626\t#ifdef SUPPORT_UNICODE\n1627\t        if (utf)\n1628\t          {\n1629\t          *lengthptr += 1;\n1630\t\n1631\t          if (range_start < range_end)\n1632\t            *lengthptr += PRIV(ord2utf)(range_start, class_uchardata);\n1633\t\n1634\t          *lengthptr += PRIV(ord2utf)(range_end, class_uchardata);\n1635\t          continue;\n1636\t          }\n1637\t#endif  /* SUPPORT_UNICODE */\n1638\t\n1639\t        *lengthptr += range_start < range_end ? 3 : 2;\n1640\t        continue;\n1641\t        }\n1642\t\n1643\t#ifdef SUPPORT_UNICODE\n1644\t      if (utf)\n1645\t        {\n1646\t        if (range_start < range_end)\n1647\t          {\n1648\t          *class_uchardata++ = XCL_RANGE;\n1649\t          class_uchardata += PRIV(ord2utf)(range_start, class_uchardata);\n1650\t          }\n1651\t        else\n1652\t          *class_uchardata++ = XCL_SINGLE;\n1653\t\n1654\t        class_uchardata += PRIV(ord2utf)(range_end, class_uchardata);\n1655\t        continue;\n1656\t        }\n1657\t#endif  /* SUPPORT_UNICODE */\n1658\t\n1659\t      /* Without UTF support, character values are constrained\n1660\t      by the bit length, and can only be > 256 for 16-bit and\n1661\t      32-bit libraries. */\n1662\t#if PCRE2_CODE_UNIT_WIDTH != 8\n1663\t      if (range_start < range_end)\n1664\t        {\n1665\t        *class_uchardata++ = XCL_RANGE;\n1666\t        *class_uchardata++ = range_start;\n1667\t        }\n1668\t      else\n1669\t        *class_uchardata++ = XCL_SINGLE;\n1670\t\n1671\t      *class_uchardata++ = range_end;\n1672\t#endif  /* PCRE2_CODE_UNIT_WIDTH == 8 */\n1673\t      }\n1674\t\n1675\t    if (lengthptr == NULL)\n1676\t      cb->cx->memctl.free(cranges, cb->cx->memctl.memory_data);\n1677\t    }\n1678\t  }\n1679\t#endif /* SUPPORT_WIDE_CHARS */\n1680\t\n1681\t/* If there are characters with values > 255, or Unicode property settings\n1682\t(\\p or \\P), we have to compile an extended class, with its own opcode,\n1683\tunless there were no property settings and there was a negated special such\n1684\tas \\S in the class, and PCRE2_UCP is not set, because in that case all\n1685\tcharacters > 255 are in or not in the class, so any that were explicitly\n1686\tgiven as well can be ignored.\n1687\t\n1688\tIn the UCP case, if certain negated POSIX classes (ex: [:^ascii:]) were\n1689\twere present in a class, we either have to match or not match all wide\n1690\tcharacters (depending on whether the whole class is or is not negated).\n1691\tThis requirement is indicated by match_all_or_no_wide_chars being true.\n1692\tWe do this by including an explicit range, which works in both cases.\n1693\tThis applies only in UTF and 16-bit and 32-bit non-UTF modes, since there\n1694\tcannot be any wide characters in 8-bit non-UTF mode.\n1695\t\n1696\tWhen there *are* properties in a positive UTF-8 or any 16-bit or 32_bit\n1697\tclass where \\S etc is present without PCRE2_UCP, causing an extended class\n1698\tto be compiled, we make sure that all characters > 255 are included by\n1699\tforcing match_all_or_no_wide_chars to be true.\n1700\t\n1701\tIf, when generating an xclass, there are no characters < 256, we can omit\n1702\tthe bitmap in the actual compiled code. */\n1703\t\n1704\t#ifdef SUPPORT_WIDE_CHARS  /* Defined for 16/32 bits, or 8-bit with Unicode */\n1705\tif ((xclass_props & XCLASS_REQUIRED) != 0)\n1706\t  {\n1707\t  PCRE2_UCHAR *previous = code;\n1708\t\n1709\t  if ((xclass_props & XCLASS_HAS_CHAR_LISTS) == 0)\n1710\t    *class_uchardata++ = XCL_END;    /* Marks the end of extra data */\n1711\t  *code++ = OP_XCLASS;\n1712\t  code += LINK_SIZE;\n1713\t  *code = negate_class? XCL_NOT:0;\n1714\t  if ((xclass_props & XCLASS_HAS_PROPS) != 0) *code |= XCL_HASPROP;\n1715\t\n1716\t  /* If the map is required, move up the extra data to make room for it;\n1717\t  otherwise just move the code pointer to the end of the extra data. */\n1718\t\n1719\t  if ((xclass_props & XCLASS_HAS_8BIT_CHARS) != 0 || has_bitmap != NULL)\n1720\t    {\n1721\t    if (negate_class)\n1722\t      {\n1723\t      uint32_t *classwords = cb->classbits.classwords;\n1724\t      for (int i = 0; i < 8; i++) classwords[i] = ~classwords[i];\n1725\t      }\n1726\t\n1727\t    if (has_bitmap == NULL)\n1728\t      {\n1729\t      *code++ |= XCL_MAP;\n1730\t      (void)memmove(code + (32 / sizeof(PCRE2_UCHAR)), code,\n1731\t        CU2BYTES(class_uchardata - code));\n1732\t      memcpy(code, classbits, 32);\n1733\t      code = class_uchardata + (32 / sizeof(PCRE2_UCHAR));\n1734\t      }\n1735\t    else\n1736\t      {\n1737\t      code = class_uchardata;\n1738\t      if ((xclass_props & XCLASS_HAS_8BIT_CHARS) != 0)\n1739\t        *has_bitmap = TRUE;\n1740\t      }\n1741\t    }\n1742\t  else code = class_uchardata;\n1743\t\n1744\t  if ((xclass_props & XCLASS_HAS_CHAR_LISTS) != 0)\n1745\t    {\n1746\t    /* Char list