{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01XNkooUASJQhA27JzfmAEud","type":"tool_result","content":"1\t// Macros translated from pcre2_internal.h / pcre2_intmodedep.h / pcre2_compile.h.\n2\t// 8-bit code unit width, SUPPORT_UNICODE enabled, LINK_SIZE == 2.\n3\t//\n4\t// CONVENTIONS\n5\t// -----------\n6\t// * All pointer arguments are raw pointers (`*const u8` / `*mut u8` etc.), so all\n7\t//   of these macros must be used inside an `unsafe` block/fn.\n8\t// * Macros that assign to their first argument (like the C versions) work with any\n9\t//   place expression: a local, `(*ptr).field`, etc.\n10\t// * Where a C macro implicitly referenced a variable named `utf` (GETCHARTEST etc.)\n11\t//   the Rust macro takes it as an extra final argument, because Rust macros are\n12\t//   hygienic.\n13\t#![allow(unused_macros)]\n14\t\n15\t// ---------------------------------------------------------------- GET / PUT\n16\t\n17\t// GET(a,n): read a 2-byte (LINK_SIZE) big-endian value, returns u32\n18\t#[macro_export]\n19\tmacro_rules! GET {\n20\t    ($a:expr, $n:expr) => {\n21\t        ((*($a).offset(($n) as isize) as u32) << 8) | (*($a).offset(($n) as isize + 1) as u32)\n22\t    };\n23\t}\n24\t\n25\t// PUT(a,n,d): store a 2-byte (LINK_SIZE) big-endian value\n26\t#[macro_export]\n27\tmacro_rules! PUT {\n28\t    ($a:expr, $n:expr, $d:expr) => {{\n29\t        let d__ = $d;\n30\t        *($a).offset(($n) as isize) = (d__ >> 8) as u8;\n31\t        *($a).offset(($n) as isize + 1) = (d__ & 255) as u8;\n32\t    }};\n33\t}\n34\t\n35\t// GET2(a,n): read a 2-byte (IMM2_SIZE) big-endian value, returns u32\n36\t#[macro_export]\n37\tmacro_rules! GET2 {\n38\t    ($a:expr, $n:expr) => {\n39\t        ((*($a).offset(($n) as isize) as u32) << 8) | (*($a).offset(($n) as isize + 1) as u32)\n40\t    };\n41\t}\n42\t\n43\t// PUT2(a,n,d)\n44\t#[macro_export]\n45\tmacro_rules! PUT2 {\n46\t    ($a:expr, $n:expr, $d:expr) => {{\n47\t        let d__ = $d;\n48\t        *($a).offset(($n) as isize) = (d__ >> 8) as u8;\n49\t        *($a).offset(($n) as isize + 1) = (d__ & 255) as u8;\n50\t    }};\n51\t}\n52\t\n53\t// PUTINC(a,n,d): PUT then advance a by LINK_SIZE\n54\t#[macro_export]\n55\tmacro_rules! PUTINC {\n56\t    ($a:expr, $n:expr, $d:expr) => {{\n57\t        PUT!($a, $n, $d);\n58\t        $a = ($a).add($crate::internal::LINK_SIZE);\n59\t    }};\n60\t}\n61\t\n62\t// PUT2INC(a,n,d): PUT2 then advance a by IMM2_SIZE\n63\t#[macro_export]\n64\tmacro_rules! PUT2INC {\n65\t    ($a:expr, $n:expr, $d:expr) => {{\n66\t        PUT2!($a, $n, $d);\n67\t        $a = ($a).add($crate::internal::IMM2_SIZE);\n68\t    }};\n69\t}\n70\t\n71\t// ------------------------------------------------------------ UTF-8 decoding\n72\t\n73\t// HASUTF8EXTRALEN(c)\n74\t#[macro_export]\n75\tmacro_rules! HASUTF8EXTRALEN {\n76\t    ($c:expr) => {\n77\t        ($c) >= 0xc0\n78\t    };\n79\t}\n80\t\n81\t// HAS_EXTRALEN(c)\n82\t#[macro_export]\n83\tmacro_rules! HAS_EXTRALEN {\n84\t    ($c:expr) => {\n85\t        ($c) >= 0xc0\n86\t    };\n87\t}\n88\t\n89\t// GET_EXTRALEN(c) - number of additional code units, returns u32\n90\t#[macro_export]\n91\tmacro_rules! GET_EXTRALEN {\n92\t    ($c:expr) => {\n93\t        $crate::pcre2_tables::_pcre2_utf8_table4[(($c) & 0x3f) as usize] as u32\n94\t    };\n95\t}\n96\t\n97\t// NOT_FIRSTCU(c)\n98\t#[macro_export]\n99\tmacro_rules! NOT_FIRSTCU {\n100\t    ($c:expr) => {\n101\t        (($c) & 0xc0) == 0x80\n102\t    };\n103\t}\n104\t\n105\t// GETUTF8(c, eptr): complete decoding of a character whose first code unit is\n106\t// already in c; does not advance eptr.\n107\t#[macro_export]\n108\tmacro_rules! GETUTF8 {\n109\t    ($c:expr, $eptr:expr) => {{\n110\t        if ($c & 0x20u32) == 0 {\n111\t            $c = (($c & 0x1fu32) << 6) | (*($eptr).offset(1) as u32 & 0x3fu32);\n112\t        } else if ($c & 0x10u32) == 0 {\n113\t            $c = (($c & 0x0fu32) << 12)\n114\t                | ((*($eptr).offset(1) as u32 & 0x3fu32) << 6)\n115\t                | (*($eptr).offset(2) as u32 & 0x3fu32);\n116\t        } else if ($c & 0x08u32) == 0 {\n117\t            $c = (($c & 0x07u32) << 18)\n118\t                | ((*($eptr).offset(1) as u32 & 0x3fu32) << 12)\n119\t                | ((*($eptr).offset(2) as u32 & 0x3fu32) << 6)\n120\t                | (*($eptr).offset(3) as u32 & 0x3fu32);\n121\t        } else if ($c & 0x04u32) == 0 {\n122\t            $c = (($c & 0x03u32) << 24)\n123\t                | ((*($eptr).offset(1) as u32 & 0x3fu32) << 18)\n124\t                | ((*($eptr).offset(2) as u32 & 0x3fu32) << 12)\n125\t                | ((*($eptr).offset(3) as u32 & 0x3fu32) << 6)\n126\t                | (*($eptr).offset(4) as u32 & 0x3fu32);\n127\t        } else {\n128\t            $c = (($c & 0x01u32) << 30)\n129\t                | ((*($eptr).offset(1) as u32 & 0x3fu32) << 24)\n130\t                | ((*($eptr).offset(2) as u32 & 0x3fu32) << 18)\n131\t                | ((*($eptr).offset(3) as u32 & 0x3fu32) << 12)\n132\t                | ((*($eptr).offset(4) as u32 & 0x3fu32) << 6)\n133\t                | (*($eptr).offset(5) as u32 & 0x3fu32);\n134\t        }\n135\t    }};\n136\t}\n137\t\n138\t// GETUTF8INC(c, eptr): as above but advances eptr past the trailing code units.\n139\t// NOTE: like the C macro, eptr must already have been advanced past the first\n140\t// code unit.\n141\t#[macro_export]\n142\tmacro_rules! GETUTF8INC {\n143\t    ($c:expr, $eptr:expr) => {{\n144\t        if ($c & 0x20u32) == 0 {\n145\t            $c = (($c & 0x1fu32) << 6) | (*$eptr as u32 & 0x3fu32);\n146\t            $eptr = ($eptr).add(1);\n147\t        } else if ($c & 0x10u32) == 0 {\n148\t            $c = (($c & 0x0fu32) << 12)\n149\t                | ((*$eptr as u32 & 0x3fu32) << 6)\n150\t                | (*($eptr).offset(1) as u32 & 0x3fu32);\n151\t            $eptr = ($eptr).add(2);\n152\t        } else if ($c & 0x08u32) == 0 {\n153\t            $c = (($c & 0x07u32) << 18)\n154\t                | ((*$eptr as u32 & 0x3fu32) << 12)\n155\t                | ((*($eptr).offset(1) as u32 & 0x3fu32) << 6)\n156\t                | (*($eptr).offset(2) as u32 & 0x3fu32);\n157\t            $eptr = ($eptr).add(3);\n158\t        } else if ($c & 0x04u32) == 0 {\n159\t            $c = (($c & 0x03u32) << 24)\n160\t                | ((*$eptr as u32 & 0x3fu32) << 18)\n161\t                | ((*($eptr).offset(1) as u32 & 0x3fu32) << 12)\n162\t                | ((*($eptr).offset(2) as u32 & 0x3fu32) << 6)\n163\t                | (*($eptr).offset(3) as u32 & 0x3fu32);\n164\t            $eptr = ($eptr).add(4);\n165\t        } else {\n166\t            $c = (($c & 0x01u32) << 30)\n167\t                | ((*$eptr as u32 & 0x3fu32) << 24)\n168\t                | ((*($eptr).offset(1) as u32 & 0x3fu32) << 18)\n169\t                | ((*($eptr).offset(2) as u32 & 0x3fu32) << 12)\n170\t                | ((*($eptr).offset(3) as u32 & 0x3fu32) << 6)\n171\t                | (*($eptr).offset(4) as u32 & 0x3fu32);\n172\t            $eptr = ($eptr).add(5);\n173\t        }\n174\t    }};\n175\t}\n176\t\n177\t// GETUTF8LEN(c, eptr, len): does not advance eptr, adds the number of extra\n178\t// code units to len.\n179\t#[macro_export]\n180\tmacro_rules! GETUTF8LEN {\n181\t    ($c:expr, $eptr:expr, $len:expr) => {{\n182\t        if ($c & 0x20u32) == 0 {\n183\t            $c = (($c & 0x1fu32) << 6) | (*($eptr).offset(1) as u32 & 0x3fu32);\n184\t            $len += 1;\n185\t        } else if ($c & 0x10u32) == 0 {\n186\t            $c = (($c & 0x0fu32) << 12)\n187\t                | ((*($eptr).offset(1) as u32 & 0x3fu32) << 6)\n188\t                | (*($eptr).offset(2) as u32 & 0x3fu32);\n189\t            $len += 2;\n190\t        } else if ($c & 0x08u32) == 0 {\n191\t            $c = (($c & 0x07u32) << 18)\n192\t                | ((*($eptr).offset(1) as u32 & 0x3fu32) << 12)\n193\t                | ((*($eptr).offset(2) as u32 & 0x3fu32) << 6)\n194\t                | (*($eptr).offset(3) as u32 & 0x3fu32);\n195\t            $len += 3;\n196\t        } else if ($c & 0x04u32) == 0 {\n197\t            $c = (($c & 0x03u32) << 24)\n198\t                | ((*($eptr).offset(1) as u32 & 0x3fu32) << 18)\n199\t                | ((*($eptr).offset(2) as u32 & 0x3fu32) << 12)\n200\t                | ((*($eptr).offset(3) as u32 & 0x3fu32) << 6)\n201\t                | (*($eptr).offset(4) as u32 & 0x3fu32);\n202\t            $len += 4;\n203\t        } else {\n204\t            $c = (($c & 0x01u32) << 30)\n205\t                | ((*($eptr).offset(1) as u32 & 0x3fu32) << 24)\n206\t                | ((*($eptr).offset(2) as u32 & 0x3fu32) << 18)\n207\t                | ((*($eptr).offset(3) as u32 & 0x3fu32) << 12)\n208\t                | ((*($eptr).offset(4) as u32 & 0x3fu32) << 6)\n209\t                | (*($eptr).offset(5) as u32 & 0x3fu32);\n210\t            $len += 5;\n211\t        }\n212\t    }};\n213\t}\n214\t\n215\t// GETCHAR(c, eptr): c must be a u32 place; does not advance eptr\n216\t#[macro_export]\n217\tmacro_rules! GETCHAR {\n218\t    ($c:expr, $eptr:expr) => {{\n219\t        $c = *($eptr) as u32;\n220\t        if $c >= 0xc0u32 {\n221\t            GETUTF8!($c, $eptr);\n222\t        }\n223\t    }};\n224\t}\n225\t\n226\t// GETCHARTEST(c, eptr, utf)\n227\t#[macro_export]\n228\tmacro_rules! GETCHARTEST {\n229\t    ($c:expr, $eptr:expr, $utf:expr) => {{\n230\t        $c = *($eptr) as u32;\n231\t        if ($utf) != 0 && $c >= 0xc0u32 {\n232\t            GETUTF8!($c, $eptr);\n233\t        }\n234\t    }};\n235\t}\n236\t\n237\t// GETCHARINC(c, eptr)\n238\t#[macro_export]\n239\tmacro_rules! GETCHARINC {\n240\t    ($c:expr, $eptr:expr) => {{\n241\t        $c = *($eptr) as u32;\n242\t        $eptr = ($eptr).add(1);\n243\t        if $c >= 0xc0u32 {\n244\t            GETUTF8INC!($c, $eptr);\n245\t        }\n246\t    }};\n247\t}\n248\t\n249\t// GETCHARINCTEST(c, eptr, utf)\n250\t#[macro_export]\n251\tmacro_rules! GETCHARINCTEST {\n252\t    ($c:expr, $eptr:expr, $utf:expr) => {{\n253\t        $c = *($eptr) as u32;\n254\t        $eptr = ($eptr).add(1);\n255\t        if ($utf) != 0 && $c >= 0xc0u32 {\n256\t            GETUTF8INC!($c, $eptr);\n257\t        }\n258\t    }};\n259\t}\n260\t\n261\t// GETCHARLEN(c, eptr, len)\n262\t#[macro_export]\n263\tmacro_rules! GETCHARLEN {\n264\t    ($c:expr, $eptr:expr, $len:expr) => {{\n265\t        $c = *($eptr) as u32;\n266\t        if $c >= 0xc0u32 {\n267\t            GETUTF8LEN!($c, $eptr, $len);\n268\t        }\n269\t    }};\n270\t}\n271\t\n272\t// GETCHARLENTEST(c, eptr, len, utf)\n273\t#[macro_export]\n274\tmacro_rules! GETCHARLENTEST {\n275\t    ($c:expr, $eptr:expr, $len:expr, $utf:expr) => {{\n276\t        $c = *($eptr) as u32;\n277\t        if ($utf) != 0 && $c >= 0xc0u32 {\n278\t            GETUTF8LEN!($c, $eptr, $len);\n279\t        }\n280\t    }};\n281\t}\n282\t\n283\t// BACKCHAR(eptr): move back to the start of a UTF-8 character\n284\t#[macro_export]\n285\tmacro_rules! BACKCHAR {\n286\t    ($eptr:expr) => {\n287\t        while (*($eptr) & 0xc0u8) == 0x80u8 {\n288\t            $eptr = ($eptr).sub(1);\n289\t        }\n290\t    };\n291\t}\n292\t\n293\t// FORWARDCHAR(eptr)\n294\t#[macro_export]\n295\tmacro_rules! FORWARDCHAR {\n296\t    ($eptr:expr) => {\n297\t        while (*($eptr) & 0xc0u8) == 0x80u8 {\n298\t            $eptr = ($eptr).add(1);\n299\t        }\n300\t    };\n301\t}\n302\t\n303\t// FORWARDCHARTEST(eptr, end)\n304\t#[macro_export]\n305\tmacro_rules! FORWARDCHARTEST {\n306\t    ($eptr:expr, $end:expr) => {\n307\t        while ($eptr) < ($end) && (*($eptr) & 0xc0u8) == 0x80u8 {\n308\t            $eptr = ($eptr).add(1);\n309\t        }\n310\t    };\n311\t}\n312\t\n313\t// ACROSSCHAR(condition, eptr, action)\n314\t#[macro_export]\n315\tmacro_rules! ACROSSCHAR {\n316\t    ($cond:expr, $eptr:expr, $action:expr) => {\n317\t        while ($cond) && (*($eptr) & 0xc0u8) == 0x80u8 {\n318\t            $action;\n319\t        }\n320\t    };\n321\t}\n322\t\n323\t// PUTCHAR(c, p, utf) -> number of code units written (u32)\n324\t#[macro_export]\n325\tmacro_rules! PUTCHAR {\n326\t    ($c:expr, $p:expr, $utf:expr) => {\n327\t        if ($utf) != 0 && $c > $crate::internal::MAX_UTF_SINGLE_CU {\n328\t            $crate::internal::_pcre2_ord2utf_8($c, $p)\n329\t        } else {\n330\t            *($p) = $c as u8;\n331\t            1u32\n332\t        }\n333\t    };\n334\t}\n335\t\n336\t// ---------------------------------------------------------------- table access\n337\t\n338\t// MAX_255(c) -> BOOL (always TRUE in 8-bit mode)\n339\t#[macro_export]\n340\tmacro_rules! MAX_255 {\n341\t    ($c:expr) => {\n342\t        $crate::internal::TRUE\n343\t    };\n344\t}\n345\t\n346\t// CHMAX_255(c) -> BOOL\n347\t#[macro_export]\n348\tmacro_rules! CHMAX_255 {\n349\t    ($c:expr) => {\n350\t        ((($c) <= 255u32) as $crate::internal::BOOL)\n351\t    };\n352\t}\n353\t\n354\t// TABLE_GET(c, table, default) -> u8 (8-bit mode ignores the default)\n355\t#[macro_export]\n356\tmacro_rules! TABLE_GET {\n357\t    ($c:expr, $table:expr, $default:expr) => {\n358\t        *($table).offset(($c) as isize)\n359\t    };\n360\t}\n361\t\n362\t// ---------------------------------------------------------------- newlines\n363\t\n364\t// IS_NEWLINE(p): blk is a *mut/&mut struct with nltype/nllen/nl fields,\n365\t// psend is the end-of-subject pointer expression.\n366\t#[macro_export]\n367\tmacro_rules! IS_NEWLINE {\n368\t    ($p:expr, $blk:expr, $psend:expr, $utf:expr) => {\n369\t        if (*$blk).nltype != $crate::internal::NLTYPE_FIXED {\n370\t            ($p) < ($psend)\n371\t                && $crate::internal::_pcre2_is_newline_8(\n372\t                    $p,\n373\t                    (*$blk).nltype,\n374\t                    $psend,\n375\t                    &mut (*$blk).nllen,\n376\t                    $utf,\n377\t                ) != 0\n378\t        } else {\n379\t            ($p) <= ($psend).offset(-((*$blk).nllen as isize))\n380\t                && *($p) == (*$blk).nl[0]\n381\t                && ((*$blk).nllen == 1 || *($p).offset(1) == (*$blk).nl[1])\n382\t        }\n383\t    };\n384\t}\n385\t\n386\t// WAS_NEWLINE(p)\n387\t#[macro_export]\n388\tmacro_rules! WAS_NEWLINE {\n389\t    ($p:expr, $blk:expr, $psstart:expr, $utf:expr) => {\n390\t        if (*$blk).nltype != $crate::internal::NLTYPE_FIXED {\n391\t            ($p) > ($psstart)\n392\t                && $crate::internal::_pcre2_was_newline_8(\n393\t                    $p,\n394\t                    (*$blk).nltype,\n395\t                    $psstart,\n396\t                    &mut (*$blk).nllen,\n397\t                    $utf,\n398\t                ) != 0\n399\t        } else {\n400\t            ($p) >= ($psstart).offset((*$blk).nllen as isize)\n401\t                && *($p).offset(-((*$blk).nllen as isize)) == (*$blk).nl[0]\n402\t                && ((*$blk).nllen == 1\n403\t                    || *($p).offset(-((*$blk).nllen as isize) + 1) == (*$blk).nl[1])\n404\t        }\n405\t    };\n406\t}\n407\t\n408\t// ---------------------------------------------------------------- bit maps\n409\t\n410\t// MAPBIT(map,n) -> u32 (non-zero if set); map is *const u32\n411\t#[macro_export]\n412\tmacro_rules! MAPBIT {\n413\t    ($map:expr, $n:expr) => {\n414\t        (*($map).offset((($n) / 32) as isize) & (1u32 << (($n) % 32)))\n415\t    };\n416\t}\n417\t\n418\t// MAPSET(map,n); map is *mut u32\n419\t#[macro_export]\n420\tmacro_rules! MAPSET {\n421\t    ($map:expr, $n:expr) => {\n422\t        *($map).offset((($n) / 32) as isize) |= 1u32 << (($n) % 32)\n423\t    };\n424\t}\n425\t\n426\t// SETBIT(a,b): a is *mut u8 (class bitmap)\n427\t#[macro_export]\n428\tmacro_rules! SETBIT {\n429\t    ($a:expr, $b:expr) => {\n430\t        *($a).offset((($b) >> 3) as isize) |= (1u32 << (($b) & 0x7)) as u8\n431\t    };\n432\t}\n433\t\n434\t// ---------------------------------------------------------------- parsed pattern\n435\t\n436\t// META_CODE(x), META_DATA(x), META_DIFF(x,y)\n437\t#[macro_export]\n438\tmacro_rules! META_CODE {\n439\t    ($x:expr) => {\n440\t        ($x) & 0xffff0000u32\n441\t    };\n442\t}\n443\t#[macro_export]\n444\tmacro_rules! META_DATA {\n445\t    ($x:expr) => {\n446\t        ($x) & 0x0000ffffu32\n447\t    };\n448\t}\n449\t#[macro_export]\n450\tmacro_rules! META_DIFF {\n451\t    ($x:expr, $y:expr) => {\n452\t        (($x) - ($y)) >> 16\n453\t    };\n454\t}\n455\t\n456\t// PUTOFFSET(s,p): store a PCRE2_SIZE into two uint32_t elements, advancing p\n457\t#[macro_export]\n458\tmacro_rules! PUTOFFSET {\n459\t    ($s:expr, $p:expr) => {{\n460\t        *$p = (($s) >> 32) as u32;\n461\t        $p = ($p).add(1);\n462\t        *$p = (($s) & 0xffffffff) as u32;\n463\t        $p = ($p).add(1);\n464\t    }};\n465\t}\n466\t\n467\t// GETOFFSET(s,p): read a PCRE2_SIZE from two uint32_t elements, advancing p\n468\t#[macro_export]\n469\tmacro_rules! GETOFFSET {\n470\t    ($s:expr, $p:expr) => {{\n471\t        $s = ((*($p).offset(0) as $crate::internal::PCRE2_SIZE) << 32)\n472\t            | (*($p).offset(1) as $crate::internal::PCRE2_SIZE);\n473\t        $p = ($p).add(2);\n474\t    }};\n475\t}\n476\t\n477\t// GETPLUSOFFSET(s,p): read from p[1],p[2], advancing p by 2\n478\t#[macro_export]\n479\tmacro_rules! GETPLUSOFFSET {\n480\t    ($s:expr, $p:expr) => {{\n481\t        $s = ((*($p).offset(1) as $crate::internal::PCRE2_SIZE) << 32)\n482\t            | (*($p).offset(2) as $crate::internal::PCRE2_SIZE);\n483\t        $p = ($p).add(2);\n484\t    }};\n485\t}\n486\t\n487\t// READPLUSOFFSET(s,p): read from p[1],p[2] without advancing\n488\t#[macro_export]\n489\tmacro_rules! READPLUSOFFSET {\n490\t    ($s:expr, $p:expr) => {\n491\t        $s = ((*($p).offset(1) as $crate::internal::PCRE2_SIZE) << 32)\n492\t            | (*($p).offset(2) as $crate::internal::PCRE2_SIZE)\n493\t    };\n494\t}\n495\t\n496\t// SKIPOFFSET(p)\n497\t#[macro_export]\n498\tmacro_rules! SKIPOFFSET {\n499\t    ($p:expr) => {\n500\t        $p = ($p).add(2)\n501\t    };\n502\t}\n503\t\n504\t// ---------------------------------------------------