{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014mdzMthA5n95H39XCZU3Ra","type":"tool_result","content":"1\t// Translated from c_src/src/pcre2_dfa_match.c\n2\tuse crate::internal::*;\n3\t\n4\tinclude!(\"pcre2_dfa_match_head.rs\");\n5\tinclude!(\"pcre2_dfa_match_tables.rs\");\n6\t\n7\t/* The static helper functions do_callout_dfa() and more_workspace(). */\n8\tinclude!(\"pcre2_dfa_match_helpers.rs\");\n9\t\n10\t/*************************************************\n11\t*     Match a Regular Expression - DFA engine    *\n12\t*************************************************/\n13\t\n14\t/* This is the main matching function. It is called recursively for some\n15\tpatterns (assertions, recursion, possessive groups).\n16\t\n17\tReturns:            > 0 => number of match offset pairs placed in offsets\n18\t                    = 0 => offsets overflowed; longest matches are present\n19\t                     -1 => failed to match\n20\t                   < -1 => some kind of unexpected problem\n21\t*/\n22\t\n23\tunsafe fn internal_dfa_match(\n24\t    mb: *mut dfa_match_block,\n25\t    this_start_code: PCRE2_SPTR,\n26\t    current_subject_arg: PCRE2_SPTR,\n27\t    start_offset: PCRE2_SIZE,\n28\t    offsets: *mut PCRE2_SIZE,\n29\t    offsetcount_arg: u32,\n30\t    workspace: *mut c_int,\n31\t    wscount_arg: c_int,\n32\t    rlevel_arg: u32,\n33\t    RWS: *mut c_int,\n34\t) -> c_int {\n35\t    let mut current_subject: PCRE2_SPTR = current_subject_arg;\n36\t    let mut offsetcount: u32 = offsetcount_arg;\n37\t    let mut wscount: c_int = wscount_arg;\n38\t    let mut rlevel: u32 = rlevel_arg;\n39\t\n40\t    let mut active_states: *mut stateblock;\n41\t    let mut new_states: *mut stateblock;\n42\t    let mut temp_states: *mut stateblock;\n43\t    let mut next_active_state: *mut stateblock;\n44\t    let mut next_new_state: *mut stateblock;\n45\t    let ctypes: *const u8;\n46\t    let lcc: *const u8;\n47\t    let fcc: *const u8;\n48\t    let mut ptr: PCRE2_SPTR;\n49\t    let mut end_code: PCRE2_SPTR;\n50\t    let mut new_recursive: dfa_recursion_info = core::mem::zeroed();\n51\t    let mut active_count: c_int;\n52\t    let mut new_count: c_int;\n53\t    let mut match_count: c_int;\n54\t\n55\t    /* Some fields in the mb block are frequently referenced, so we load them into\n56\t    independent variables in the hope that this will perform better. */\n57\t\n58\t    let start_subject: PCRE2_SPTR = (*mb).start_subject;\n59\t    let end_subject: PCRE2_SPTR = (*mb).end_subject;\n60\t    let start_code: PCRE2_SPTR = (*mb).start_code;\n61\t\n62\t    let utf: BOOL = (((*mb).poptions & PCRE2_UTF) != 0) as BOOL;\n63\t    let utf_or_ucp: BOOL = (utf != 0 || ((*mb).poptions & PCRE2_UCP) != 0) as BOOL;\n64\t\n65\t    let mut reset_could_continue: BOOL = FALSE;\n66\t\n67\t    let mcc = (*mb).match_call_count;\n68\t    (*mb).match_call_count = mcc + 1;\n69\t    if mcc >= (*mb).match_limit {\n70\t        return PCRE2_ERROR_MATCHLIMIT;\n71\t    }\n72\t    {\n73\t        let old = rlevel;\n74\t        rlevel = old + 1;\n75\t        if old > (*mb).match_limit_depth {\n76\t            return PCRE2_ERROR_DEPTHLIMIT;\n77\t        }\n78\t    }\n79\t    offsetcount &= (-2i32) as u32; /* Round down */\n80\t\n81\t    wscount -= 2;\n82\t    wscount = (wscount - (wscount % (INTS_PER_STATEBLOCK * 2))) / (2 * INTS_PER_STATEBLOCK);\n83\t\n84\t    ctypes = (*mb).tables.add(ctypes_offset);\n85\t    lcc = (*mb).tables.add(lcc_offset);\n86\t    fcc = (*mb).tables.add(fcc_offset);\n87\t\n88\t    match_count = PCRE2_ERROR_NOMATCH; /* A negative number */\n89\t\n90\t    active_states = workspace.add(2) as *mut stateblock;\n91\t    new_states = active_states.add(wscount as usize);\n92\t    next_new_state = new_states;\n93\t    new_count = 0;\n94\t    active_count = 0;\n95\t    next_active_state = active_states;\n96\t\n97\t    /* The macros used for adding states to the two state vectors (one for the\n98\t    current character, one for the following character). */\n99\t\n100\t    macro_rules! ADD_ACTIVE {\n101\t        ($x:expr, $y:expr) => {{\n102\t            let ac__ = active_count;\n103\t            active_count = ac__ + 1;\n104\t            if ac__ < wscount {\n105\t                (*next_active_state).offset = $x;\n106\t                (*next_active_state).count = $y;\n107\t                next_active_state = next_active_state.add(1);\n108\t            } else {\n109\t                return PCRE2_ERROR_DFA_WSSIZE;\n110\t            }\n111\t        }};\n112\t    }\n113\t\n114\t    macro_rules! ADD_ACTIVE_DATA {\n115\t        ($x:expr, $y:expr, $z:expr) => {{\n116\t            let ac__ = active_count;\n117\t            active_count = ac__ + 1;\n118\t            if ac__ < wscount {\n119\t                (*next_active_state).offset = $x;\n120\t                (*next_active_state).count = $y;\n121\t                (*next_active_state).data = $z;\n122\t                next_active_state = next_active_state.add(1);\n123\t            } else {\n124\t                return PCRE2_ERROR_DFA_WSSIZE;\n125\t            }\n126\t        }};\n127\t    }\n128\t\n129\t    macro_rules! ADD_NEW {\n130\t        ($x:expr, $y:expr) => {{\n131\t            let nc__ = new_count;\n132\t            new_count = nc__ + 1;\n133\t            if nc__ < wscount {\n134\t                (*next_new_state).offset = $x;\n135\t                (*next_new_state).count = $y;\n136\t                next_new_state = next_new_state.add(1);\n137\t            } else {\n138\t                return PCRE2_ERROR_DFA_WSSIZE;\n139\t            }\n140\t        }};\n141\t    }\n142\t\n143\t    macro_rules! ADD_NEW_DATA {\n144\t        ($x:expr, $y:expr, $z:expr) => {{\n145\t            let nc__ = new_count;\n146\t            new_count = nc__ + 1;\n147\t            if nc__ < wscount {\n148\t                (*next_new_state).offset = $x;\n149\t                (*next_new_state).count = $y;\n150\t                (*next_new_state).data = $z;\n151\t                next_new_state = next_new_state.add(1);\n152\t            } else {\n153\t                return PCRE2_ERROR_DFA_WSSIZE;\n154\t            }\n155\t        }};\n156\t    }\n157\t\n158\t    /* The first thing in any (sub) pattern is a bracket of some sort. Push all\n159\t    the alternative states onto the list, and find out where the end is. This\n160\t    makes is possible to use this function recursively, when we want to stop at a\n161\t    matching internal ket rather than at the end.\n162\t\n163\t    If we are dealing with a backward assertion we have to find out the maximum\n164\t    amount to move back, and set up each alternative appropriately. */\n165\t\n166\t    if *this_start_code as u32 == OP_ASSERTBACK || *this_start_code as u32 == OP_ASSERTBACK_NOT {\n167\t        let mut max_back: usize = 0;\n168\t        let gone_back: usize;\n169\t\n170\t        end_code = this_start_code;\n171\t        loop {\n172\t            let back: usize = GET2!(end_code, 2 + LINK_SIZE) as usize;\n173\t            if back > max_back {\n174\t                max_back = back;\n175\t            }\n176\t            end_code = end_code.add(GET!(end_code, 1) as usize);\n177\t            if *end_code as u32 != OP_ALT {\n178\t                break;\n179\t            }\n180\t        }\n181\t\n182\t        /* If we can't go back the amount required for the longest lookbehind\n183\t        pattern, go back as far as we can; some alternatives may still be viable. */\n184\t\n185\t        /* In character mode we have to step back character by character */\n186\t\n187\t        if utf != 0 {\n188\t            let mut gb: usize = 0;\n189\t            while gb < max_back {\n190\t                if current_subject <= start_subject {\n191\t                    break;\n192\t                }\n193\t                current_subject = current_subject.sub(1);\n194\t                ACROSSCHAR!(\n195\t                    current_subject > start_subject,\n196\t                    current_subject,\n197\t                    current_subject = current_subject.sub(1)\n198\t                );\n199\t                gb += 1;\n200\t            }\n201\t            gone_back = gb;\n202\t        } else {\n203\t            /* In byte-mode we can do this quickly. */\n204\t            let current_offset: usize = current_subject.offset_from(start_subject) as usize;\n205\t            gone_back = if current_offset < max_back {\n206\t                current_offset\n207\t            } else {\n208\t                max_back\n209\t            };\n210\t            current_subject = current_subject.sub(gone_back);\n211\t        }\n212\t\n213\t        /* Save the earliest consulted character */\n214\t\n215\t        if current_subject < (*mb).start_used_ptr {\n216\t            (*mb).start_used_ptr = current_subject;\n217\t        }\n218\t\n219\t        /* Now we can process the individual branches. There will be an OP_REVERSE at\n220\t        the start of each branch, except when the length of the branch is zero. */\n221\t\n222\t        end_code = this_start_code;\n223\t        loop {\n224\t            let revlen: u32 = if *end_code.add(1 + LINK_SIZE) as u32 == OP_REVERSE {\n225\t                (1 + IMM2_SIZE) as u32\n226\t            } else {\n227\t                0\n228\t            };\n229\t            let back: usize = if revlen == 0 {\n230\t                0\n231\t            } else {\n232\t                GET2!(end_code, 2 + LINK_SIZE) as usize\n233\t            };\n234\t            if back <= gone_back {\n235\t                let bstate: c_int =\n236\t                    (end_code.offset_from(start_code) as usize + 1 + LINK_SIZE + revlen as usize)\n237\t                        as c_int;\n238\t                ADD_NEW_DATA!(-bstate, 0, (gone_back - back) as c_int);\n239\t            }\n240\t            end_code = end_code.add(GET!(end_code, 1) as usize);\n241\t            if *end_code as u32 != OP_ALT {\n242\t                break;\n243\t            }\n244\t        }\n245\t    }\n246\t    /* This is the code for a \"normal\" subpattern (not a backward assertion). The\n247\t    start of a whole pattern is always one of these. If we are at the top level,\n248\t    we may be asked to restart matching from the same point that we reached for a\n249\t    previous partial match. We still have to scan through the top-level branches to\n250\t    find the end state. */\n251\t    else {\n252\t        end_code = this_start_code;\n253\t\n254\t        /* Restarting */\n255\t\n256\t        if rlevel == 1 && ((*mb).moptions & PCRE2_DFA_RESTART) != 0 {\n257\t            loop {\n258\t                end_code = end_code.add(GET!(end_code, 1) as usize);\n259\t                if *end_code as u32 != OP_ALT {\n260\t                    break;\n261\t                }\n262\t            }\n263\t            new_count = *workspace.add(1);\n264\t            if *workspace == 0 {\n265\t                memcpy(\n266\t                    new_states as *mut c_void,\n267\t                    active_states as *const c_void,\n268\t                    new_count as usize * size_of::<stateblock>(),\n269\t                );\n270\t            }\n271\t        }\n272\t        /* Not restarting */\n273\t        else {\n274\t            let mut length: c_int = (1 + LINK_SIZE\n275\t                + (if *this_start_code as u32 == OP_CBRA\n276\t                    || *this_start_code as u32 == OP_SCBRA\n277\t                    || *this_start_code as u32 == OP_CBRAPOS\n278\t                    || *this_start_code as u32 == OP_SCBRAPOS\n279\t                {\n280\t                    IMM2_SIZE\n281\t                } else {\n282\t                    0\n283\t                })) as c_int;\n284\t            loop {\n285\t                ADD_NEW!(end_code.offset_from(start_code) as c_int + length, 0);\n286\t                end_code = end_code.add(GET!(end_code, 1) as usize);\n287\t                length = (1 + LINK_SIZE) as c_int;\n288\t                if *end_code as u32 != OP_ALT {\n289\t                    break;\n290\t                }\n291\t            }\n292\t        }\n293\t    }\n294\t\n295\t    *workspace = 0; /* Bit indicating which vector is current */\n296\t\n297\t    /* Loop for scanning the subject */\n298\t\n299\t    ptr = current_subject;\n300\t    'subject_loop: loop {\n301\t        let mut i: c_int;\n302\t        let mut j: c_int;\n303\t        let mut clen: c_int;\n304\t        let mut dlen: c_int;\n305\t        let mut c: u32;\n306\t        let mut d: u32;\n307\t        let mut partial_newline: BOOL = FALSE;\n308\t        let mut could_continue: BOOL = reset_could_continue;\n309\t        reset_could_continue = FALSE;\n310\t\n311\t        if ptr > (*mb).last_used_ptr {\n312\t            (*mb).last_used_ptr = ptr;\n313\t        }\n314\t\n315\t        /* Make the new state list into the active state list and empty the\n316\t        new state list. */\n317\t\n318\t        temp_states = active_states;\n319\t        active_states = new_states;\n320\t        new_states = temp_states;\n321\t        active_count = new_count;\n322\t        new_count = 0;\n323\t\n324\t        *workspace ^= 1; /* Remember for the restarting feature */\n325\t        *workspace.add(1) = active_count;\n326\t\n327\t        /* Set the pointers for adding new states */\n328\t\n329\t        next_active_state = active_states.add(active_count as usize);\n330\t        next_new_state = new_states;\n331\t\n332\t        /* Load the current character from the subject outside the loop, as many\n333\t        different states may want to look at it, and we assume that at least one\n334\t        will. */\n335\t\n336\t        if ptr < end_subject {\n337\t            clen = 1; /* Number of data items in the character */\n338\t            GETCHARLENTEST!(c, ptr, clen, utf);\n339\t        } else {\n340\t            clen = 0; /* This indicates the end of the subject */\n341\t            c = NOTACHAR; /* This value should never actually be used */\n342\t        }\n343\t\n344\t        /* Scan up the active states and act on each one. The result of an action\n345\t        may be to add more states to the currently active list (e.g. on hitting a\n346\t        parenthesis) or it may be to put states on the new list, for considering\n347\t        when we move the character pointer on. */\n348\t\n349\t        i = 0;\n350\t        while i < active_count {\n351\t            /* The C code uses `continue` and `goto NEXT_ACTIVE_STATE` to go on to\n352\t            the next active state; both are `break 'next_active_state` here so that\n353\t            the loop increment below still happens. */\n354\t            'next_active_state: {\n355\t                let current_state: *mut stateblock = active_states.add(i as usize);\n356\t                let mut caseless: BOOL = FALSE;\n357\t                let mut code: PCRE2_SPTR;\n358\t                let mut codevalue: u32;\n359\t                let mut state_offset: c_int = (*current_state).offset;\n360\t                let mut rrc: c_int;\n361\t                let mut count: c_int;\n362\t\n363\t                /* A negative offset is a special case meaning \"hold off going to this\n364\t                (negated) state until the number of characters in the data field have\n365\t                been skipped\". If the could_continue flag was passed over from a previous\n366\t                state, arrange for it to passed on. */\n367\t\n368\t                if state_offset < 0 {\n369\t                    if (*current_state).data > 0 {\n370\t                        ADD_NEW_DATA!(\n371\t                            state_offset,\n372\t                            (*current_state).count,\n373\t                            (*current_state).data - 1\n374\t                        );\n375\t                        if could_continue != 0 {\n376\t                            reset_could_continue = TRUE;\n377\t                        }\n378\t                        break 'next_active_state;\n379\t                    } else {\n380\t                        state_offset = -state_offset;\n381\t                        (*current_state).offset = state_offset;\n382\t                    }\n383\t                }\n384\t\n385\t                /* Check for a duplicate state with the same count, and skip if found. */\n386\t\n387\t                j = 0;\n388\t                while j < i {\n389\t                    if (*active_states.add(j as usize)).offset == state_offset\n390\t                        && (*active_states.add(j as usize)).count == (*current_state).count\n391\t                    {\n392\t                        break 'next_active_state;\n393\t                    }\n394\t                    j += 1;\n395\t                }\n396\t\n397\t                /* The state offset is the offset to the opcode */\n398\t\n399\t                code = start_code.add(state_offset as usize);\n400\t                codevalue = *code as u32;\n401\t\n402\t                /* If this opcode inspects a character, but we are at the end of the\n403\t                subject, remember the fact for use when testing for a partial match. */\n404\t\n405\t                if clen == 0 && *poptable.as_ptr().add(codevalue as usize) != 0 {\n406\t                    could_continue = TRUE;\n407\t                }\n408\t\n409\t                /* If this opcode is followed by an inline character, load it. */\n410\t\n411\t                if *coptable.as_ptr().add(codevalue as usize) > 0 {\n412\t                    dlen = 1;\n413\t                    if utf != 0 {\n414\t                        let dptr = code.add(*coptable.as_ptr().add(codevalue as usize) as usize);\n415\t                        GETCHARLEN!(d, dptr, dlen);\n416\t                    } else {\n417\t                        d = *code.add(*coptable.as_ptr().add(codevalue as usize) as usize) as u32;\n418\t                    }\n419\t                    if codevalue >= OP_TYPESTAR {\n420\t                        if d == OP_ANYBYTE {\n421\t                            return PCRE2_ERROR_DFA_UITEM;\n422\t                        } else if d == OP_NOTPROP || d == OP_PROP {\n423\t                            codevalue += OP_PROP_EXTRA;\n424\t                        } else if d == OP_ANYNL {\n425\t                            codevalue += OP_ANYNL_EXTRA;\n426\t                        } else if d == OP_EXTUNI {\n427\t                            codevalue += OP_EXTUNI_EXTRA;\n428\t                        } else if d == OP_NOT_HSPACE || d == OP_HSPACE {\n429\t                            codevalue += OP_HSPACE_EXTRA;\n430\t                        } else if d == OP_NOT_VSPACE || d == OP_VSPACE {\n431\t                            codevalue += OP_VSPACE_EXTRA;\n432\t                        }\n433\t                    }\n434\t                } else {\n435\t                    dlen = 0; /* Not strictly necessary, but compilers moan */\n436\t                    d = NOTACHAR; /* if these variables are not set. */\n437\t                }\n438\t\n439\t                /* Now process the individual opcodes. Each fragment handles a set of\n440\t                opcodes; an unhandled codevalue falls through to the next fragment and\n441\t                finally to the C `default:` case. */\n442\t\n443\t                include!(\"pcre2_dfa_ops1.rs\");\n444\t                include!(\"pcre2_dfa_ops2.rs\");\n445\t                include!(\"pcre2_dfa_ops3.rs\");\n446\t                include!(\"pcre2_dfa_ops4.rs\");\n447\t                include!(\"pcre2_dfa_ops5.rs\");\n448\t                include!(\"pcre2_dfa_ops6.rs\");\n449\t\n450\t                /* Unsupported opcode */\n451\t                return PCRE2_ERROR_DFA_UITEM;\n452\t            }\n453\t            i += 1;\n454\t        } /* End of loop scanning active states */\n455\t\n456\t        /* We have finished the processing at the current subject character. If no\n457\t        new states have been set for the next character, we have found all the\n458\t        matches that we are going to find. If partial matching has been requested,\n459\t        check for appropriate conditions.\n460\t\n461\t        The \"could_continue\" variable is true if a state could have continued but\n462\t        for the fact that the end of the subject was reached. */\n463\t\n464\t        if new_count <= 0 {\n465\t            if could_continue != 0\n466\t                && (((*mb).moptions & PCRE2_PARTIAL_HARD) != 0\n467\t                    || (((*mb).moptions & PCRE2_PARTIAL_SOFT) != 0 && match_count < 0))\n468\t                && (partial_newline != 0\n469\t                    || (ptr >= end_subject\n470\t                        && (ptr > (*mb).start_used_ptr || (*mb).allowemptypartial != 0)))\n471\t            {\n472\t                match_count = PCRE2_ERROR_PARTIAL;\n473\t            }\n474\t            break 'subject_loop; /* Exit from loop along the subject string */\n475\t        }\n476\t\n477\t        /* One or more states are active for the next character. */\n478\t\n479\t        ptr = ptr.add(clen as usize); /* Advance to next subject character */\n480\t    } /* Loop to move along the subject string */\n481\t\n482\t    /* Control gets here from \"break\" a few lines above. If we have a match and\n483\t    PCRE2_ENDANCHORED is set, the match fails. */\n484\t\n485\t    if match_count >= 0\n486\t        && (((*mb).moptions | (*mb).poptions) & PCRE2_ENDANCHORED) != 0\n487\t        && ptr < end_subject\n488\t    {\n489\t        match_count = PCRE2_ERROR_NOMATCH;\n490\t    }\n491\t\n492\t    match_count\n493\t}\n494\t\n495\t/*************************************************\n496\t*     Match a pattern using the DFA algorithm    *\n497\t*************************************************/\n498\t\n499\tinclude!(\"pcre2_dfa_match_public.rs\");\n500\t"}]},"parent_tool_use_id":"toolu_bdrk_0194jx7XYGxHvgm4sUhy7TVo","session_id":"69c7dc4d-05f2-4bba-997b-e68ff82cc8bc","uuid":"87121877-835e-471f-bafd-2f7c06cb2c65","timestamp":"2026-08-22T22:35:46.882Z","subagent_type":"general-purpose","task_description":"dfa fragment