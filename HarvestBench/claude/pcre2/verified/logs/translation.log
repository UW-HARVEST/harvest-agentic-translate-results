{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013RcJDoWbJQQXSnHi6m9opg","type":"tool_result","content":"1\t/*************************************************\n2\t*      Perl-Compatible Regular Expressions       *\n3\t*************************************************/\n4\t\n5\t/* PCRE is a library of functions to support regular expressions whose syntax\n6\tand semantics are as close as possible to those of the Perl 5 language.\n7\t\n8\t                       Written by Philip Hazel\n9\t     Original API code Copyright (c) 1997-2012 University of Cambridge\n10\t          New API code Copyright (c) 2016-2024 University of Cambridge\n11\t\n12\t-----------------------------------------------------------------------------\n13\tRedistribution and use in source and binary forms, with or without\n14\tmodification, are permitted provided that the following conditions are met:\n15\t\n16\t    * Redistributions of source code must retain the above copyright notice,\n17\t      this list of conditions and the following disclaimer.\n18\t\n19\t    * Redistributions in binary form must reproduce the above copyright\n20\t      notice, this list of conditions and the following disclaimer in the\n21\t      documentation and/or other materials provided with the distribution.\n22\t\n23\t    * Neither the name of the University of Cambridge nor the names of its\n24\t      contributors may be used to endorse or promote products derived from\n25\t      this software without specific prior written permission.\n26\t\n27\tTHIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\"\n28\tAND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE\n29\tIMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE\n30\tARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE\n31\tLIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR\n32\tCONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF\n33\tSUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\n34\tINTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\n35\tCONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\n36\tARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE\n37\tPOSSIBILITY OF SUCH DAMAGE.\n38\t-----------------------------------------------------------------------------\n39\t*/\n40\t\n41\t\n42\t#include \"pcre2_internal.h\"\n43\t\n44\t\n45\t\n46\t#define PTR_STACK_SIZE 20\n47\t\n48\t#define SUBSTITUTE_OPTIONS \\\n49\t  (PCRE2_SUBSTITUTE_EXTENDED|PCRE2_SUBSTITUTE_GLOBAL| \\\n50\t   PCRE2_SUBSTITUTE_LITERAL|PCRE2_SUBSTITUTE_MATCHED| \\\n51\t   PCRE2_SUBSTITUTE_OVERFLOW_LENGTH|PCRE2_SUBSTITUTE_REPLACEMENT_ONLY| \\\n52\t   PCRE2_SUBSTITUTE_UNKNOWN_UNSET|PCRE2_SUBSTITUTE_UNSET_EMPTY)\n53\t\n54\t\n55\t\n56\t/*************************************************\n57\t*           Find end of substitute text          *\n58\t*************************************************/\n59\t\n60\t/* In extended mode, we recognize ${name:+set text:unset text} and similar\n61\tconstructions. This requires the identification of unescaped : and }\n62\tcharacters. This function scans for such. It must deal with nested ${\n63\tconstructions. The pointer to the text is updated, either to the required end\n64\tcharacter, or to where an error was detected.\n65\t\n66\tArguments:\n67\t  code      points to the compiled expression (for options)\n68\t  ptrptr    points to the pointer to the start of the text (updated)\n69\t  ptrend    end of the whole string\n70\t  last      TRUE if the last expected string (only } recognized)\n71\t\n72\tReturns:    0 on success\n73\t            negative error code on failure\n74\t*/\n75\t\n76\tstatic int\n77\tfind_text_end(const pcre2_code *code, PCRE2_SPTR *ptrptr, PCRE2_SPTR ptrend,\n78\t  BOOL last)\n79\t{\n80\tint rc = 0;\n81\tuint32_t nestlevel = 0;\n82\tBOOL literal = FALSE;\n83\tPCRE2_SPTR ptr = *ptrptr;\n84\t\n85\tfor (; ptr < ptrend; ptr++)\n86\t  {\n87\t  if (literal)\n88\t    {\n89\t    if (ptr[0] == CHAR_BACKSLASH && ptr < ptrend - 1 && ptr[1] == CHAR_E)\n90\t      {\n91\t      literal = FALSE;\n92\t      ptr += 1;\n93\t      }\n94\t    }\n95\t\n96\t  else if (*ptr == CHAR_RIGHT_CURLY_BRACKET)\n97\t    {\n98\t    if (nestlevel == 0) goto EXIT;\n99\t    nestlevel--;\n100\t    }\n101\t\n102\t  else if (*ptr == CHAR_COLON && !last && nestlevel == 0) goto EXIT;\n103\t\n104\t  else if (*ptr == CHAR_DOLLAR_SIGN)\n105\t    {\n106\t    if (ptr < ptrend - 1 && ptr[1] == CHAR_LEFT_CURLY_BRACKET)\n107\t      {\n108\t      nestlevel++;\n109\t      ptr += 1;\n110\t      }\n111\t    }\n112\t\n113\t  else if (*ptr == CHAR_BACKSLASH)\n114\t    {\n115\t    int erc;\n116\t    int errorcode;\n117\t    uint32_t ch;\n118\t    PCRE2_SPTR esc_end_ptr;\n119\t\n120\t    if (ptr < ptrend - 1) switch (ptr[1])\n121\t      {\n122\t      case CHAR_L:\n123\t      case CHAR_l:\n124\t      case CHAR_U:\n125\t      case CHAR_u:\n126\t      ptr += 1;\n127\t      continue;\n128\t      }\n129\t\n130\t    ptr += 1;  /* Must point after \\ */\n131\t    erc = PRIV(check_escape)(&ptr, ptrend, &ch, &errorcode,\n132\t      code->overall_options, code->extra_options, code->top_bracket, FALSE, NULL);\n133\t    if (errorcode != 0)\n134\t      {\n135\t      /* errorcode from check_escape is positive, so must not be returned by\n136\t      pcre2_substitute(). */\n137\t      rc = PCRE2_ERROR_BADREPESCAPE;\n138\t      goto EXIT;\n139\t      }\n140\t\n141\t    esc_end_ptr = ptr;\n142\t    ptr -= 1;  /* Rewind by one, because the for-loop will increment it */\n143\t\n144\t    switch(erc)\n145\t      {\n146\t      case 0:      /* Data character */\n147\t      case ESC_b:  /* Data character */\n148\t      case ESC_v:  /* Data character */\n149\t      case ESC_E:  /* Isolated \\E is ignored */\n150\t      break;\n151\t\n152\t      case ESC_Q:\n153\t      literal = TRUE;\n154\t      break;\n155\t\n156\t      case ESC_g:\n157\t      /* The \\g<name> form (\\g<number> already handled by check_escape)\n158\t\n159\t      Don't worry about finding the matching \">\". We are super, super lenient\n160\t      about validating ${} replacements inside find_text_end(), so we certainly\n161\t      don't need to worry about other syntax. Importantly, a \\g<..> or $<...>\n162\t      sequence can't contain a '}' character. */\n163\t      break;\n164\t\n165\t      default:\n166\t      if (erc < 0)\n167\t        break;  /* capture group reference */\n168\t      ptr = esc_end_ptr;\n169\t      rc = PCRE2_ERROR_BADREPESCAPE;\n170\t      goto EXIT;\n171\t      }\n172\t    }\n173\t  }\n174\t\n175\trc = PCRE2_ERROR_REPMISSINGBRACE;   /* Terminator not found */\n176\t\n177\tEXIT:\n178\t*ptrptr = ptr;\n179\treturn rc;\n180\t}\n181\t\n182\t\n183\t/*************************************************\n184\t*           Validate group name                  *\n185\t*************************************************/\n186\t\n187\t/* This function scans for a capture group name, validating it\n188\tconsists of legal characters, is not empty, and does not exceed\n189\tMAX_NAME_SIZE.\n190\t\n191\tArguments:\n192\t  ptrptr    points to the pointer to the start of the text (updated)\n193\t  ptrend    end of the whole string\n194\t  utf       true if the input is UTF-encoded\n195\t  ctypes    pointer to the character types table\n196\t\n197\tReturns:    TRUE if a name was read\n198\t            FALSE otherwise\n199\t*/\n200\t\n201\tstatic BOOL\n202\tread_name_subst(PCRE2_SPTR *ptrptr, PCRE2_SPTR ptrend, BOOL utf,\n203\t    const uint8_t* ctypes)\n204\t{\n205\tPCRE2_SPTR ptr = *ptrptr;\n206\tPCRE2_SPTR nameptr = ptr;\n207\t\n208\tif (ptr >= ptrend)                 /* No characters in name */\n209\t  goto FAILED;\n210\t\n211\t/* We do not need to check whether the name starts with a non-digit.\n212\tWe are simply referencing names here, not defining them. */\n213\t\n214\t/* See read_name in the pcre2_compile.c for the corresponding logic\n215\trestricting group names inside the pattern itself. */\n216\t\n217\t#ifdef SUPPORT_UNICODE\n218\tif (utf)\n219\t  {\n220\t  uint32_t c, type;\n221\t\n222\t  while (ptr < ptrend)\n223\t    {\n224\t    GETCHAR(c, ptr);\n225\t    type = UCD_CHARTYPE(c);\n226\t    if (type != ucp_Nd && PRIV(ucp_gentype)[type] != ucp_L &&\n227\t        c != CHAR_UNDERSCORE) break;\n228\t    ptr++;\n229\t    FORWARDCHARTEST(ptr, ptrend);\n230\t    }\n231\t  }\n232\telse\n233\t#else\n234\t(void)utf;  /* Avoid compiler warning */\n235\t#endif      /* SUPPORT_UNICODE */\n236\t\n237\t/* Handle group names in non-UTF modes. */\n238\t\n239\t  {\n240\t  while (ptr < ptrend && MAX_255(*ptr) && (ctypes[*ptr] & ctype_word) != 0)\n241\t    {\n242\t    ptr++;\n243\t    }\n244\t  }\n245\t\n246\t/* Check name length */\n247\t\n248\tif (ptr - nameptr > MAX_NAME_SIZE)\n249\t  goto FAILED;\n250\t\n251\t/* Subpattern names must not be empty */\n252\tif (ptr == nameptr)\n253\t  goto FAILED;\n254\t\n255\t*ptrptr = ptr;\n256\treturn TRUE;\n257\t\n258\tFAILED:\n259\t*ptrptr = ptr;\n260\treturn FALSE;\n261\t}\n262\t\n263\t\n264\t/*************************************************\n265\t*              Case transformations              *\n266\t*************************************************/\n267\t\n268\t#define PCRE2_SUBSTITUTE_CASE_NONE                 0\n269\t// 1, 2, 3 are PCRE2_SUBSTITUTE_CASE_LOWER, UPPER, TITLE_FIRST.\n270\t#define PCRE2_SUBSTITUTE_CASE_REVERSE_TITLE_FIRST  4\n271\t\n272\ttypedef struct {\n273\t  int to_case; /* One of PCRE2_SUBSTITUTE_CASE_xyz */\n274\t  BOOL single_char;\n275\t} case_state;\n276\t\n277\t/* Helper to guess how much a string is likely to increase in size when\n278\tcase-transformed. Usually, strings don't change size at all, but some rare\n279\tcharacters do grow. Estimate +10%, plus another few characters.\n280\t\n281\tPerforming this estimation is unfortunate, but inevitable, since we can't call\n282\tthe callout if we ran out of buffer space to prepare its input.\n283\t\n284\tBecause this estimate is inexact (and in pathological cases, underestimates the\n285\trequired buffer size) we must document that when you have a\n286\tsubstitute_case_callout, and you are using PCRE2_SUBSTITUTE_OVERFLOW_LENGTH, you\n287\tmay need more than two calls to determine the final buffer size. */\n288\t\n289\tstatic PCRE2_SIZE\n290\tpessimistic_case_inflation(PCRE2_SIZE len)\n291\t{\n292\treturn (len >> 3u) + 10;\n293\t}\n294\t\n295\t/* Case transformation behaviour if no callout is passed. */\n296\t\n297\tstatic PCRE2_SIZE\n298\tdefault_substitute_case_callout(\n299\t  PCRE2_SPTR input, PCRE2_SIZE input_len,\n300\t  PCRE2_UCHAR *output, PCRE2_SIZE output_cap,\n301\t  case_state *state, const pcre2_code *code)\n302\t{\n303\tPCRE2_SPTR input_end = input + input_len;\n304\t#ifdef SUPPORT_UNICODE\n305\tBOOL utf;\n306\tBOOL ucp;\n307\t#endif\n308\tPCRE2_UCHAR temp[6];\n309\tBOOL next_to_upper;\n310\tBOOL rest_to_upper;\n311\tBOOL single_char;\n312\tBOOL overflow = FALSE;\n313\tPCRE2_SIZE written = 0;\n314\t\n315\t/* Helpful simplifying invariant: input and output are disjoint buffers.\n316\tI believe that this code is technically undefined behaviour, because the two\n317\tpointers input/output are \"unrelated\" pointers and hence not comparable. Casting\n318\tvia char* bypasses some but not all of those technical rules. It is not included\n319\tin release builds, in any case. */\n320\tPCRE2_ASSERT((char *)(input + input_len) <= (char *)output ||\n321\t             (char *)(output + output_cap) <= (char *)input);\n322\t\n323\t#ifdef SUPPORT_UNICODE\n324\tutf = (code->overall_options & PCRE2_UTF) != 0;\n325\tucp = (code->overall_options & PCRE2_UCP) != 0;\n326\t#endif\n327\t\n328\tif (input_len == 0) return 0;\n329\t\n330\tswitch (state->to_case)\n331\t  {\n332\t  /* LCOV_EXCL_START */\n333\t  default:\n334\t  PCRE2_DEBUG_UNREACHABLE();\n335\t  return 0;\n336\t  /* LCOV_EXCL_STOP */\n337\t\n338\t  case PCRE2_SUBSTITUTE_CASE_LOWER: // Can be single_char TRUE or FALSE\n339\t  case PCRE2_SUBSTITUTE_CASE_UPPER: // Can only be single_char FALSE\n340\t  next_to_upper = rest_to_upper = (state->to_case == PCRE2_SUBSTITUTE_CASE_UPPER);\n341\t  break;\n342\t\n343\t  case PCRE2_SUBSTITUTE_CASE_TITLE_FIRST: // Can be single_char TRUE or FALSE\n344\t  next_to_upper = TRUE;\n345\t  rest_to_upper = FALSE;\n346\t  state->to_case = PCRE2_SUBSTITUTE_CASE_LOWER;\n347\t  break;\n348\t\n349\t  case PCRE2_SUBSTITUTE_CASE_REVERSE_TITLE_FIRST: // Can only be single_char FALSE\n350\t  next_to_upper = FALSE;\n351\t  rest_to_upper = TRUE;\n352\t  state->to_case = PCRE2_SUBSTITUTE_CASE_UPPER;\n353\t  break;\n354\t  }\n355\t\n356\tsingle_char = state->single_char;\n357\tif (single_char)\n358\t  state->to_case = PCRE2_SUBSTITUTE_CASE_NONE;\n359\t\n360\twhile (input < input_end)\n361\t  {\n362\t  uint32_t ch;\n363\t  unsigned int chlen;\n364\t\n365\t  GETCHARINCTEST(ch, input);\n366\t\n367\t#ifdef SUPPORT_UNICODE\n368\t  if ((utf || ucp) && ch >= 128)\n369\t    {\n370\t    uint32_t type = UCD_CHARTYPE(ch);\n371\t    if (PRIV(ucp_gentype)[type] == ucp_L &&\n372\t        type != (next_to_upper? ucp_Lu : ucp_Ll))\n373\t      ch = UCD_OTHERCASE(ch);\n374\t\n375\t    /* TODO This is far from correct... it doesn't support the SpecialCasing.txt\n376\t    mappings, but worse, it's not even correct for all the ordinary case\n377\t    mappings. We should add support for those (at least), and then add the\n378\t    SpecialCasing.txt mappings for Esszet and ligatures, and finally use the\n379\t    Turkish casing flag on the match context. */\n380\t    }\n381\t  else\n382\t#endif\n383\t  if (MAX_255(ch))\n384\t    {\n385\t    if (((code->tables + cbits_offset +\n386\t        (next_to_upper? cbit_upper:cbit_lower)\n387\t        )[ch/8] & (1u << (ch%8))) == 0)\n388\t      ch = (code->tables + fcc_offset)[ch];\n389\t    }\n390\t\n391\t#ifdef SUPPORT_UNICODE\n392\t  if (utf) chlen = PRIV(ord2utf)(ch, temp); else\n393\t#endif\n394\t    {\n395\t    temp[0] = ch;\n396\t    chlen = 1;\n397\t    }\n398\t\n399\t  if (!overflow && chlen <= output_cap)\n400\t    {\n401\t    memcpy(output, temp, CU2BYTES(chlen));\n402\t    output += chlen;\n403\t    output_cap -= chlen;\n404\t    }\n405\t  else\n406\t    {\n407\t    overflow = TRUE;\n408\t    }\n409\t\n410\t  if (chlen > ~(PCRE2_SIZE)0 - written)  /* Integer overflow */\n411\t    return ~(PCRE2_SIZE)0;\n412\t  written += chlen;\n413\t\n414\t  next_to_upper = rest_to_upper;\n415\t\n416\t  /* memcpy the remainder, if only transforming a single character. */\n417\t\n418\t  if (single_char)\n419\t    {\n420\t    PCRE2_SIZE rest_len = input_end - input;\n421\t\n422\t    if (!overflow && rest_len <= output_cap)\n423\t      memcpy(output, input, CU2BYTES(rest_len));\n424\t\n425\t    if (rest_len > ~(PCRE2_SIZE)0 - written)  /* Integer overflow */\n426\t      return ~(PCRE2_SIZE)0;\n427\t    written += rest_len;\n428\t\n429\t    return written;\n430\t    }\n431\t  }\n432\t\n433\treturn written;\n434\t}\n435\t\n436\t/* Helper to perform the call to the substitute_case_callout. We wrap the\n437\tuser-provided callout because our internal arguments are slightly extended. We\n438\tdon't want the user callout to handle the case of \"\\l\" (first character only to\n439\tlowercase) or \"\\l\\U\" (first character to lowercase, rest to uppercase) because\n440\tthose are not operations defined by Unicode. Instead the user callout simply\n441\tneeds to provide the three Unicode primitives: lower, upper, titlecase. */\n442\t\n443\tstatic PCRE2_SIZE\n444\tdo_case_copy(\n445\t  PCRE2_UCHAR *input_output, PCRE2_SIZE input_len, PCRE2_SIZE output_cap,\n446\t  case_state *state, BOOL utf,\n447\t  PCRE2_SIZE (*substitute_case_callout)(PCRE2_SPTR, PCRE2_SIZE, PCRE2_UCHAR *,\n448\t                                        PCRE2_SIZE, int, void *),\n449\t  void *substitute_case_callout_data)\n450\t{\n451\tPCRE2_SPTR input = input_output;\n452\tPCRE2_UCHAR *output = input_output;\n453\tPCRE2_SIZE rc;\n454\tPCRE2_SIZE rc2;\n455\tint ch1_to_case;\n456\tint rest_to_case;\n457\tPCRE2_UCHAR ch1[6];\n458\tPCRE2_SIZE ch1_len;\n459\tPCRE2_SPTR rest;\n460\tPCRE2_SIZE rest_len;\n461\tBOOL ch1_overflow = FALSE;\n462\tBOOL rest_overflow = FALSE;\n463\t\n464\t#if PCRE2_CODE_UNIT_WIDTH == 32 || !defined(SUPPORT_UNICODE)\n465\t(void)utf; /* Avoid compiler warning. */\n466\t#endif\n467\t\n468\tPCRE2_ASSERT(input_len != 0);\n469\t\n470\tswitch (state->to_case)\n471\t  {\n472\t  /* LCOV_EXCL_START */\n473\t  default:\n474\t  PCRE2_DEBUG_UNREACHABLE();\n475\t  return 0;\n476\t  /* LCOV_EXCL_STOP */\n477\t\n478\t  case PCRE2_SUBSTITUTE_CASE_LOWER: // Can be single_char TRUE or FALSE\n479\t  case PCRE2_SUBSTITUTE_CASE_UPPER: // Can only be single_char FALSE\n480\t  case PCRE2_SUBSTITUTE_CASE_TITLE_FIRST: // Can be single_char TRUE or FALSE\n481\t\n482\t  /* The easy case, where our internal casing operations align with those of\n483\t  the callout. */\n484\t\n485\t  if (state->single_char == FALSE)\n486\t    {\n487\t    rc = substitute_case_callout(input, input_len, output, output_cap,\n488\t                                 state->to_case, substitute_case_callout_data);\n489\t\n490\t    if (state->to_case == PCRE2_SUBSTITUTE_CASE_TITLE_FIRST)\n491\t      state->to_case = PCRE2_SUBSTITUTE_CASE_LOWER;\n492\t\n493\t    return rc;\n494\t    }\n495\t\n496\t  ch1_to_case = state->to_case;\n497\t  rest_to_case = PCRE2_SUBSTITUTE_CASE_NONE;\n498\t  break;\n499\t\n500\t  case PCRE2_SUBSTITUTE_CASE_REVERSE_TITLE_FIRST: // Can only be single_char FALSE\n501\t  ch1_to_case = PCRE2_SUBSTITUTE_CASE_LOWER;\n502\t  rest_to_case = PCRE2_SUBSTITUTE_CASE_UPPER;\n503\t  break;\n504\t  }\n505\t\n506\t/* Identify the leading character. Take copy, because its storage overlaps with\n507\t`output`, and hence may be scrambled by the callout. */\n508\t\n509\t  {\n510\t  PCRE2_SPTR ch_end = input;\n511\t  uint32_t ch;\n512\t\n513\t  GETCHARINCTEST(ch, ch_end);\n514\t  (void) ch;\n515\t  PCRE2_ASSERT(ch_end <= input + input_len && ch_end - input <= 6);\n516\t  ch1_len = ch_end - input;\n517\t  memcpy(ch1, input, CU2BYTES(ch1_len));\n518\t  }\n519\t\n520\trest = input + ch1_len;\n521\trest_len = input_len - ch1_len;\n522\t\n523\t/* Transform just ch1. The buffers are always in-place (input == output). With a\n524\tcustom callout, we need a loop to discover its required buffer size. The loop\n525\twouldn't be required if the callout were well-behaved, but it might be naughty\n526\tand return \"5\" the first time, then \"10\" the next time we call it using the\n527\texact same input! */\n528\t\n529\t  {\n530\t  PCRE2_SIZE ch1_cap;\n531\t  PCRE2_SIZE max_ch1_cap;\n532\t\n533\t  ch1_cap = ch1_len;  /* First attempt uses the space vacated by ch1. */\n534\t  PCRE2_ASSERT(output_cap >= input_len && input_len >= rest_len);\n535\t  max_ch1_cap = output_cap - rest_len;\n536\t\n537\t  while (TRUE)\n538\t    {\n539\t    rc = substitute_case_callout(ch1, ch1_len, output, ch1_cap, ch1_to_case,\n540\t                                 substitute_case_callout_data);\n541\t    if (rc == ~(PCRE2_SIZE)0) return rc;\n542\t\n543\t    if (rc <= ch1_cap) break;\n544\t\n545\t    if (rc > max_ch1_cap)\n546\t      {\n547\t      ch1_overflow = TRUE;\n548\t      break;\n549\t      }\n550\t\n551\t    /* Move the rest to the right, to make room for expanding ch1. */\n552\t\n553\t    memmove(input_output + rc, rest, CU2BYTES(rest_len));\n554\t    rest = input + rc;\n555\t\n556\t    ch1_cap = rc;\n557\t\n558\t    /* Proof of loop termination: `ch1_cap` is growing on each iteration, but\n559\t    the loop ends if `rc` reaches the (unchanging) upper bound of output_cap. */\n560\t    }\n561\t  }\n562\t\n563\tif (rest_to_case == PCRE2_SUBSTITUTE_CASE_NONE)\n564\t  {\n565\t  if (!ch1_overflow)\n566\t    {\n567\t    PCRE2_ASSERT(rest_len <= output_cap - rc);\n568\t    memmove(output + rc, rest, CU2BYTES(rest_len));\n569\t    }\n570\t  rc2 = rest_len;\n571\t\n572\t  state->to_case = PCRE2_SUBSTITUTE_CASE_NONE;\n573\t  }\n574\telse\n575\t  {\n576\t  PCRE2_UCHAR dummy[1];\n577\t\n578\t  rc2 = substitute_case_callout(rest, rest_len,\n579\t                                ch1_overflow? dummy : output + rc,\n580\t                                ch1_overflow? 0u : output_cap - rc,\n581\t                                rest_to_case, substitute_case_callout_data);\n582\t  if (rc2 == ~(PCRE2_SIZE)0) return rc2;\n583\t\n584\t  if (!ch1_overflow && rc2 > output_cap - rc) rest_overflow = TRUE;\n585\t\n586\t  /* If ch1 grows so that `xform(ch1)+rest` can't fit in the buffer, but then\n587\t  `rest` shrinks, it's actually possible for the total calculated length of\n588\t  `xform(ch1)+xform(rest)` to come out at less than output_cap. But we can't\n589\t  report that, because it would make it seem that the operation succeeded.\n590\t  If either of xform(ch1) or xform(rest) won't fit in the buffer, our final\n591\t  result must be > output_cap. */\n592\t  if (ch1_overflow && rc2 < rest_len)\n593\t    rc2 = rest_len;\n594\t\n595\t  state->to_case = PCRE2_SUBSTITUTE_CASE_UPPER;\n596\t  }\n597\t\n598\tif (rc2 > ~(PCRE2_SIZE)0 - rc)  /* Integer overflow */\n599\t  return ~(PCRE2_SIZE)0;\n600\t\n601\tPCRE2_ASSERT(!(ch1_overflow || rest_overflow) || rc + rc2 > output_cap);\n602\t(void)rest_overflow;\n603\t\n604\treturn rc + rc2;\n605\t}\n606\t\n607\t\n608\t/*************************************************\n609\t*              Match and substitute              *\n610\t*************************************************/\n611\t\n612\t/* This function applies a compiled re to a subject string and creates a new\n613\tstring with substitutions. The first 7 arguments are the same as for\n614\tpcre2_match(). Either string length may be PCRE2_ZERO_TERMINATED.\n615\t\n616\tArguments:\n617\t  code            points to the compiled expression\n618\t  subject         points to the subject string\n619\t  length          length of subject string (may contain binary zeros)\n620\t  start_offset    where to start in the subject string\n621\t  options         option bits\n622\t  match_data      points to a match_data block, or is NULL\n623\t  context         points a PCRE2 context\n624\t  replacement     points to the replacement string\n625\t  rlength         length of replacement string\n626\t  buffer          where to put the substituted string\n627\t  blength         points to length of buffer; updated to length of string\n628\t\n629\tReturns:          >= 0 number of substitutions made\n630\t                  < 0 an error code\n631\t                  PCRE2_ERROR_BADREPLACEMENT means invalid use of $\n632\t*/\n633\t\n634\t/* This macro checks for space in the buffer before copying into it. On\n635\toverflow, either give an error immediately, or keep on, accumulating the\n636\tlength. */\n637\t\n638\t#define CHECKMEMCPY(from, length_) \\\n639\t  do {    \\\n640\t     PCRE2_SIZE chkmc_length = length_; \\\n641\t     if (overflowed) \\\n642\t       {  \\\n643\t       if (chkmc_length > ~(PCRE2_SIZE)0 - extra_needed)  /* Integer overflow */ \\\n644\t         goto TOOLARGEREPLACE; \\\n645\t       extra_needed += chkmc_length; \\\n646\t       }  \\\n647\t     else if (lengthleft < chkmc_length) \\\n648\t       {  \\\n649\t       if ((suboptions & PCRE2_SUBSTITUTE_OVERFLOW_LENGTH) == 0) goto NOROOM; \\\n650\t       overflowed = TRUE; \\\n651\t       extra_needed = chkmc_length - lengthleft; \\\n652\t       }  \\\n653\t     else \\\n654\t       {  \\\n655\t       memcpy(buffer + buff_offset, from, CU2BYTES(chkmc_length)); \\\n656\t       buff_offset += chkmc_length; \\\n657\t       lengthleft -= chkmc_length; \\\n658\t       }  \\\n659\t     }    \\\n660\t  while (0)\n661\t\n662\t/* This macro checks for space and copies characters with casing modifications.\n663\tOn overflow, it behaves as for CHECKMEMCPY().\n664\t\n665\tWhen substitute_case_callout is NULL, the source and destination buffers must\n666\tnot overlap, because our default handler does not support this. */\n667\t\n668\t#define CHECKCASECPY_BASE(length_, do_call) \\\n669\t  do {    \\\n670\t     PCRE2_SIZE chkcc_length = (PCRE2_SIZE)(length_); \\\n671\t     PCRE2_SIZE chkcc_rc; \\\n672\t     do_call \\\n673\t     if (lengthleft < chkcc_rc) \\\n674\t       {  \\\n675\t       if ((suboptions & PCRE2_SUBSTITUTE_OVERFLOW_LENGTH) == 0) goto NOROOM; \\\n676\t       overflowed = TRUE; \\\n677\t       extra_needed = chkcc_rc - lengthleft; \\\n678\t       }  \\\n679\t     else \\\n680\t       {  \\\n681\t       buff_offset += chkcc_rc; \\\n682\t       lengthleft -= chkcc_rc; \\\n683\t       }  \\\n684\t     }    \\\n685\t  while (0)\n686\t\n687\t#define CHECKCASECPY_DEFAULT(from, length_) \\\n688\t  CHECKCASECPY_BASE(length_, { \\\n689\t    chkcc_rc = default_substitute_case_callout(from, chkcc_length,         \\\n690\t                                               buffer + buff_offset,       \\\n691\t                                               overflowed? 0 : lengthleft, \\\n692\t                                               &forcecase, code);          \\\n693\t    if (overflowed) \\\n694\t      { \\\n695\t      if (chkcc_rc > ~(PCRE2_SIZE)0 - extra_needed)  /* Integer overflow */ \\\n696\t        goto TOOLARGEREPLACE; \\\n697\t      extra_needed += chkcc_rc; \\\n698\t      break; \\\n699\t      } \\\n700\t  })\n701\t\n702\t#define CHECKCASECPY_CALLOUT(length_) \\\n703\t  CHECKCASECPY_BASE(length_, { \\\n704\t    chkcc_rc = do_case_copy(buffer + buff_offset, chkcc_length, \\\n705\t                            lengthleft, &forcecase, utf,        \\\n706\t                            substitute_case_callout,            \\\n707\t                            substitute_case_callout_data);      \\\n708\t    if (chkcc_rc == ~(PCRE2_SIZE)0) goto CASEERROR; \\\n709\t  })\n710\t\n711\t/* This macro does a delayed case transformation, for the situation when we have\n712\ta case-forcing callout. */\n713\t\n714\t#define DELAYEDFORCECASE() \\\n715\t  do {      \\\n716\t     PCRE2_SIZE chars_outstanding = (buff_offset - casestart_offset) + \\\n717\t            (extra_needed - casestart_extra_needed); \\\n718\t     if (chars_outstanding > 0) \\\n719\t       {    \\\n720\t       if (overflowed) \\\n721\t         {  \\\n722\t         PCRE2_SIZE guess = pessimistic_case_inflation(chars_outstanding); \\\n723\t         if (guess > ~(PCRE2_SIZE)0 - extra_needed)  /* Integer overflow */ \\\n724\t           goto TOOLARGEREPLACE; \\\n725\t         extra_needed += guess; \\\n726\t         }  \\\n727\t       else \\\n728\t         {  \\\n729\t         /* Rewind the buffer */ \\\n730\t         lengthleft += (buff_offset - casestart_offset); \\\n731\t         buff_offset = casestart_offset; \\\n732\t         /* Care! In-place case transformation */ \\\n733\t         CHECKCASECPY_CALLOUT(chars_outstanding); \\\n734\t         }  \\\n735\t       }    \\\n736\t     }      \\\n737\t  while (0)\n738\t\n739\t\n740\t/* Here's the function */\n741\t\n742\tPCRE2_EXP_DEFN int PCRE2_CALL_CONVENTION\n743\tpcre2_substitute(const pcre2_code *code, PCRE2_SPTR subject, PCRE2_SIZE length,\n744\t  PCRE2_SIZE start_offset, uint32_t options, pcre2_match_data *match_data,\n745\t  pcre2_match_context *mcontext, PCRE2_SPTR replacement, PCRE2_SIZE rlength,\n746\t  PCRE2_UCHAR *buffer, PCRE2_SIZE *blength)\n747\t{\n748\tint rc;\n749\tint subs;\n750\tuint32_t ovector_count;\n751\tuint32_t goptions = 0;\n752\tuint32_t suboptions;\n753\tpcre2_match_data *internal_match_data = NULL;\n754\tBOOL escaped_literal = FALSE;\n755\tBOOL overflowed = FALSE;\n756\tBOOL use_existing_match;\n757\tBOOL replacement_only;\n758\tBOOL utf = (code->overall_options & PCRE2_UTF) != 0;\n759\tBOOL partial = (options & (PCRE2_PARTIAL_HARD|PCRE2_PARTIAL_SOFT)) != 0;\n760\tPCRE2_UCHAR temp[6];\n761\tPCRE2_UCHAR null_str[1] = { 0xcd };\n762\tPCRE2_SPTR original_subject = subject;\n763\tPCRE2_SPTR ptr;\n764\tPCRE2_SPTR repend = NULL;\n765\tPCRE2_SIZE extra_needed = 0;\n766\tPCRE2_SIZE buff_offset, buff_length, lengthleft, fraglength;\n767\tPCRE2_SIZE *ovector;\n768\tPCRE2_SIZE ovecsave[2] = { 0, 0 };\n769\tpcre2_substitute_callout_block scb;\n770\tPCRE2_SIZE sub_start_extra_needed;\n771\tPCRE2_SIZE (*substitute_case_callout)(PCRE2_SPTR, PCRE2_SIZE, PCRE2_UCHAR *,\n772\t                                      PCRE2_SIZE, int, void *) = NULL;\n773\tvoid *substitute_case_callout_data = NULL;\n774\t\n775\t/* General initialization */\n776\t\n777\tbuff_offset = 0;\n778\tlengthleft = buff_length = *blength;\n779\t*blength = PCRE2_UNSET;\n780\t\n781\tif (mcontext != NULL)\n782\t  {\n783\t  substitute_case_callout = mcontext->substitute_case_callout;\n784\t  substitute_case_callout_data = mcontext->substitute_case_callout_data;\n785\t  }\n786\t\n787\t/* Partial matching is supported, with limitations. We allow matching in partial\n788\tmode, however, if a partial match is found, the substitution will fail with a\n789\tPCRE2_ERROR_PARTIAL error. Additionally, outputting the after-match text is not\n790\tallowed (PCRE2_ERROR_BADOPTION), and certain replacement items such as $' and $_\n791\tare not supported (PCRE2_ERROR_PARTIALSUBS).\n792\t\n793\tThis must come after setting *blength to PCRE2_UNSET, so as not to imply an\n794\toffset in the replacement. */\n795\t\n796\tif (partial && (options & PCRE2_SUBSTITUTE_REPLACEMENT_ONLY) == 0)\n797\t  return PCRE2_ERROR_BADOPTION;\n798\t\n799\t/* Validate length and find the end of the replacement. A NULL replacement of\n800\tzero length is interpreted as an empty string. */\n801\t\n802\tif (replacement == NULL)\n803\t  {\n804\t  if (rlength != 0) return PCRE2_ERROR_NULL;\n805\t  replacement = null_str;\n806\t  }\n807\t\n808\tif (rlength == PCRE2_ZERO_TERMINATED) rlength = PRIV(strlen)(replacement);\n809\trepend = replacement + rlength;\n810\t\n811\t/* A NULL subject of zero length is treated as an empty string. */\n812\t\n813\tif (subject == NULL)\n814\t  {\n815\t  if (length != 0) return PCRE2_ERROR_NULL;\n816\t  subject = null_str;\n817\t  }\n818\t\n819\tif (length == PCRE2_ZERO_TERMINATED) length = PRIV(strlen)(subject);\n820\t\n821\t/* Check for using a match that has already happened. Note that the subject\n822\tpointer in the match data may be NULL after a no-match. */\n823\t\n824\tuse_existing_match = ((options & PCRE2_SUBSTITUTE_MATCHED) != 0);\n825\treplacement_only = ((options & PCRE2_SUBSTITUTE_REPLACEMENT_ONLY) != 0);\n826\t\n827\tif (use_existing_match && match_data == NULL) return PCRE2_ERROR_NULL;\n828\t\n829\t/* If an existing match is being passed in, we should check that it matches\n830\tthe passed-in subject pointer, length, and match options. We don't currently\n831\thave a use-case for someone to match on one subject, then try and use that\n832\tmatch data on a different subject. In a UTF-encoded string, a simple change\n833\tlike replacing one character for another won't preserve the code unit offsets,\n834\tso it's hard to see, in the general case, how it would be safe or useful to\n835\tsupport swapping or mutating the subject string.\n836\t\n837\tSimilarly, using different match options between the first (external) and\n838\tsubsequent (internal, global) matches is hard to justify. */\n839\t\n840\tif (use_existing_match)\n841\t  {\n842\t  /* Return early, as the rest of the match_data may not have been\n843\t  initialised. This duplicates and must be in sync with the check below that\n844\t  aborts substitution on any result other than success or no-match. */\n845\t  if (match_data->rc < 0 && match_data->rc != PCRE2_ERROR_NOMATCH)\n846\t    return match_data->rc;\n847\t\n848\t  /* Not supported if the passed-in match was from the DFA interpreter. */\n849\t  if (match_data->matchedby == PCRE2_MATCHEDBY_DFA_INTERPRETER)\n850\t    return PCRE2_ERROR_DFA_UFUNC;\n851\t\n852\t  if (code != match_data->code)\n853\t    return PCRE2_ERROR_DIFFSUBSPATTERN;\n854\t\n855\t  /* We want the passed-in subject strings to match. This implies the effective\n856\t  length must match, and either: the pointers are equal (with strict matching\n857\t  of NULL against NULL); or, the special case of PCRE2_COPY_MATCHED_SUBJECT\n858\t  where we cannot compare pointers but we can verify the contents. */\n859\t  if (length != match_data->subject_length ||\n860\t      !(original_subject == match_data->subject ||\n861\t        ((match_data->flags & PCRE2_MD_COPIED_SUBJECT) != 0 &&\n862\t         (length == 0 ||\n863\t          memcmp(subject, match_data->subject, CU2BYTES(length)) == 0))))\n864\t    return PCRE2_ERROR_DIFFSUBSSUBJECT;\n865\t\n866\t  if (start_offset != match_data->start_offset)\n867\t    return PCRE2_ERROR_DIFFSUBSOFFSET;\n868\t\n869\t  if ((options & ~(SUBSTITUTE_OPTIONS|PCRE2_NO_UTF_CHECK)) !=\n870\t      (match_data->options & ~PCRE2_NO_UTF_CHECK))\n871\t    return PCRE2_ERROR_DIFFSUBSOPTIONS;\n872\t  }\n873\t\n874\t/* If starting from an existing match, there must be an externally provided\n875\tmatch data block. We create an internal match_data block in two cases: (a) an\n876\texternal one is not supplied (and we are not starting from an existing match);\n877\t(b) an existing match is to be used for the first substitution. In the latter\n878\tcase, we copy the existing match into the internal block, except for any cached\n879\theap frame size and pointer. This ensures that no changes are made to the\n880\texternal match data block. */\n881\t\n882\t/* WARNING: In both cases below a general context is constructed \"by hand\"\n883\tbecause calling pcre2_general_context_create() involves a memory allocation. If\n884\tthe contents of a general context control block are ever changed there will\n885\thave to be changes below. */\n886\t\n887\tif (match_data == NULL)\n888\t  {\n889\t  pcre2_general_context gcontext;\n890\t  gcontext.memctl = (mcontext == NULL)?\n891\t    ((pcre2_real_code *)code)->memctl :\n892\t    ((pcre2_real_match_context *)mcontext)->memctl;\n893\t  match_data = internal_match_data =\n894\t    pcre2_match_data_create_from_pattern(code, &gcontext);\n895\t  if (internal_match_data == NULL) return PCRE2_ERROR_NOMEMORY;\n896\t  }\n897\t\n898\telse if (use_existing_match)\n899\t  {\n900\t  int pairs;\n901\t  pcre2_general_context gcontext;\n902\t  gcontext.memctl = (mcontext == NULL)?\n903\t    ((pcre2_real_code *)code)->memctl :\n904\t    ((pcre2_real_match_context *)mcontext)->memctl;\n905\t  pairs = (code->top_bracket + 1 < match_data->oveccount)?\n906\t    code->top_bracket + 1 : match_data->oveccount;\n907\t  internal_match_data = pcre2_match_data_create(match_data->oveccount,\n908\t    &gcontext);\n909\t  if (internal_match_data == NULL) return PCRE2_ERROR_NOMEMORY;\n910\t  memcpy(internal_match_data, match_data, offsetof(pcre2_match_data, ovector)\n911\t    + 2*pairs*sizeof(PCRE2_SIZE));\n912\t  internal_match_data->heapframes = NULL;\n913\t  internal_match_data->heapframes_size = 0;\n914\t  /* Ensure that the subject is not freed when internal_match_data is */\n915\t  internal_match_data->flags &= ~PCRE2_MD_COPIED_SUBJECT;\n916\t  match_data = internal_match_data;\n917\t  }\n918\t\n919\t/* If using an internal match data, there's no need to copy the subject. */\n920\t\n921\tif (internal_match_data != NULL) options &= ~PCRE2_COPY_MATCHED_SUBJECT;\n922\t\n923\t/* Remember ovector details */\n924\t\n925\tovector = pcre2_get_ovector_pointer(match_data);\n926\tovector_count = pcre2_get_ovector_count(match_data);\n927\t\n928\t/* Fixed things in the callout block */\n929\t\n930\tscb.version = 0;\n931\tscb.input = subject;\n932\tscb.output = (PCRE2_SPTR)buffer;\n933\tscb.ovector = ovector;\n934\t\n935\t/* Check UTF replacement string if necessary. */\n936\t\n937\t#ifdef SUPPORT_UNICODE\n938\tif (utf && (options & PCRE2_NO_UTF_CHECK) == 0)\n939\t  {\n940\t  rc = PRIV(valid_utf)(replacement, rlength, &(match_data->startchar));\n941\t  if (rc != 0)\n942\t    {\n943\t    match_data->leftchar = 0;\n944\t    goto EXIT;\n945\t    }\n946\t  }\n947\t#endif  /* SUPPORT_UNICODE */\n948\t\n949\t/* Save the substitute options and remove them from the match options. */\n950\t\n951\tsuboptions = options & SUBSTITUTE_OPTIONS;\n952\toptions &= ~SUBSTITUTE_OPTIONS;\n953\t\n954\t/* Error if the start match offset is greater than the length of the subject. */\n955\t\n956\tif (start_offset > length)\n957\t  {\n958\t  match_data->leftchar = 0;\n959\t  rc = PCRE2_ERROR_BADOFFSET;\n960\t  goto EXIT;\n961\t  }\n962\t\n963\t/* Copy up to the start offset, unless only the replacement is required. */\n964\t\n965\tif (!replacement_only) CHECKMEMCPY(subject, start_offset);\n966\t\n967\t/* Loop for global substituting. If PCRE2_SUBSTITUTE_MATCHED is set, the first\n968\tmatch is taken from the match_data that was passed in. */\n969\t\n970\tsubs = 0;\n971\tfor (;;)\n972\t  {\n973\t  PCRE2_SPTR ptrstack[PTR_STACK_SIZE];\n974\t  uint32_t ptrstackptr = 0;\n975\t  case_state forcecase = { PCRE2_SUBSTITUTE_CASE_NONE, FALSE };\n976\t  PCRE2_SIZE casestart_offset = 0;\n977\t  PCRE2_SIZE casestart_extra_needed = 0;\n978\t\n979\t  if (use_existing_match)\n980\t    {\n981\t    rc = match_data->rc;\n982\t    use_existing_match = FALSE;\n983\t    }\n984\t  else rc = pcre2_match(code, subject, length, start_offset, options|goptions,\n985\t    match_data, mcontext);\n986\t\n987\t#ifdef SUPPORT_UNICODE\n988\t  if (utf) options |= PCRE2_NO_UTF_CHECK;  /* Only need to check once */\n989\t#endif\n990\t\n991\t  /* Any error other than no match returns the error code. No match breaks the\n992\t  global loop. */\n993\t\n994\t  if (rc == PCRE2_ERROR_NOMATCH) break;\n995\t\n996\t  if (rc < 0) goto EXIT;\n997\t\n998\t  /* Handle a successful match. Matches that use \\K to end before they start\n999\t  or start before the current point in the subject are not supported. */\n1000\t\n1001\t  if (ovector[1] < ovector[0] || ovector[0] < start_offset)\n1002\t    {\n1003\t    rc = PCRE2_ERROR_BADSUBSPATTERN;\n1004\t    goto EXIT;\n1005\t    }\n1006\t\n1007\t  /* Assert that our replacement loop is making progress, checked even in\n1008\t  release builds. This should be impossible to hit, however, an infinite loop\n1009\t  would be fairly catastrophic.\n1010\t\n1011\t  \"Progress\" is measured as ovector[1] strictly advancing, or, an empty match\n1012\t  after a non-empty match. */\n1013\t\n1014\t  /* LCOV_EXCL_START */\n1015\t  if (subs > 0 &&\n1016\t      !(ovector[1] > ovecsave[1] ||\n1017\t        (ovector[1] == ovector[0] && ovecsave[1] > ovecsave[0] &&\n1018\t         ovector[1] == ovecsave[1])))\n1019\t    {\n1020\t    PCRE2_DEBUG_UNREACHABLE();\n1021\t    rc = PCRE2_ERROR_INTERNAL_DUPMATCH;\n1022\t    goto EXIT;\n1023\t    }\n1024\t  /* LCOV_EXCL_STOP */\n1025\t\n1026\t  ovecsave[0] = ovector[0];\n1027\t  ovecsave[1] = ovector[1];\n1028\t\n1029\t  /* Count substitutions with a paranoid check for integer overflow; surely no\n1030\t  real call to this function would ever hit this! */\n1031\t\n1032\t  if (subs == INT_MAX)\n1033\t    {\n1034\t    rc = PCRE2_ERROR_TOOMANYREPLACE;\n1035\t    goto EXIT;\n1036\t    }\n1037\t  subs++;\n1038\t\n1039\t  /* Copy the text leading up to the match (unless not required); remember\n1040\t  where the insert begins and how many ovector pairs are set; and remember how\n1041\t  much space we have requested in extra_needed. */\n1042\t\n1043\t  if (rc == 0) rc = ovector_count;\n1044\t  fraglength = ovector[0] - start_offset;\n1045\t  if (!replacement_only) CHECKMEMCPY(subject + start_offset, fraglength);\n1046\t  scb.output_offsets[0] = buff_offset;\n1047\t  scb.oveccount = rc;\n1048\t  sub_start_extra_needed = extra_needed;\n1049\t\n1050\t  /* Process the replacement string. If the entire replacement is literal, just\n1051\t  copy it with length check. */\n1052\t\n1053\t  ptr = replacement;\n1054\t  if ((suboptions & PCRE2_SUBSTITUTE_LITERAL) != 0)\n1055\t    {\n1056\t    CHECKMEMCPY(ptr, rlength);\n1057\t    }\n1058\t\n1059\t  /* Within a non-literal replacement, which must be scanned character by\n1060\t  character, local literal mode can be set by \\Q, but only in extended mode\n1061\t  when backslashes are being interpreted. In extended mode we must handle\n1062\t  nested substrings that are to be reprocessed. */\n1063\t\n1064\t  else for (;;)\n1065\t    {\n1066\t    uint32_t ch;\n1067\t    unsigned int chlen;\n1068\t    int group;\n1069\t    uint32_t special;\n1070\t    PCRE2_SPTR text1_start = NULL;\n1071\t    PCRE2_SPTR text1_end = NULL;\n1072\t    PCRE2_SPTR text2_start = NULL;\n1073\t    PCRE2_SPTR text2_end = NULL;\n1074\t    PCRE2_UCHAR name[MAX_NAME_SIZE + 1];\n1075\t\n1076\t    /* If at the end of a nested substring, pop the stack. */\n1077\t\n1078\t    if (ptr >= repend)\n1079\t      {\n1080\t      if (ptrstackptr == 0) break;       /* End of replacement string */\n1081\t      repend = ptrstack[--ptrstackptr];\n1082\t      ptr = ptrstack[--ptrstackptr];\n1083\t      continue;\n1084\t      }\n1085\t\n1086\t    /* Handle the next character */\n1087\t\n1088\t    if (escaped_literal)\n1089\t      {\n1090\t      if (ptr[0] == CHAR_BACKSLASH && ptr < repend - 1 && ptr[1] == CHAR_E)\n1091\t        {\n1092\t        escaped_literal = FALSE;\n1093\t        ptr += 2;\n1094\t        continue;\n1095\t        }\n1096\t      goto LOADLITERAL;\n1097\t      }\n1098\t\n1099\t    /* Not in literal mode. */\n1100\t\n1101\t    if (*ptr == CHAR_DOLLAR_SIGN)\n1102\t      {\n1103\t      BOOL inparens;\n1104\t      BOOL inangle;\n1105\t      BOOL star;\n1106\t      PCRE2_SIZE sublength;\n1107\t      PCRE2_UCHAR next;\n1108\t      PCRE2_SPTR subptr, subptrend;\n1109\t\n1110\t      if (++ptr >= repend) goto BAD;\n1111\t      if ((next = *ptr) == CHAR_DOLLAR_SIGN) goto LOADLITERAL;\n1112\t\n1113\t      special = 0;\n1114\t      text1_start = NULL;\n1115\t      text1_end = NULL;\n1116\t      text2_start = NULL;\n1117\t      text2_end = NULL;\n1118\t      group = -1;\n1119\t      inparens = FALSE;\n1120\t      inangle = FALSE;\n1121\t      star = FALSE;\n1122\t      subptr = NULL;\n1123\t      subptrend = NULL;\n1124\t\n1125\t      /* Special $ sequences, as supported by Perl, JavaScript, .NET and others. */\n1126\t      if (next == CHAR_AMPERSAND)\n1127\t        {\n1128\t        ++ptr;\n1129\t        group = 0;\n1130\t        goto GROUP_SUBSTITUTE;\n1131\t        }\n1132\t      if (next == CHAR_GRAVE_ACCENT || next == CHAR_APOSTROPHE)\n1133\t        {\n1134\t        ++ptr;\n1135\t\n1136\t        /* (Sanity-check ovector before reading from it.) */\n1137\t        rc = pcre2_substring_length_bynumber(match_data, 0, &sublength);\n1138\t        /* LCOV_EXCL_START */\n1139\t        if (rc < 0)\n1140\t          {\n1141\t          PCRE2_DEBUG_UNREACHABLE();\n1142\t          goto PTREXIT;\n1143\t          }\n1144\t        /* LCOV_EXCL_STOP */\n1145\t\n1146\t        if (next == CHAR_GRAVE_ACCENT)\n1147\t          {\n1148\t          subptr = subject;\n1149\t          subptrend = subject + ovector[0];\n1150\t          }\n1151\t        else\n1152\t          {\n1153\t          if (partial)\n1154\t            {\n1155\t            rc = PCRE2_ERROR_PARTIALSUBS;\n1156\t            goto PTREXIT;\n1157\t            }\n1158\t\n1159\t          subptr = subject + ovector[1];\n1160\t          subptrend = subject + length;\n1161\t          }\n1162\t\n1163\t        goto SUBPTR_SUBSTITUTE;\n1164\t        }\n1165\t      if (next == CHAR_UNDERSCORE)\n1166\t        {\n1167\t        /* Java, .NET support $_ for \"entire input string\". */\n1168\t        ++ptr;\n1169\t\n1170\t        if (partial)\n1171\t          {\n1172\t          rc = PCRE2_ERROR_PARTIALSUBS;\n1173\t          goto PTREXIT;\n1174\t          }\n1175\t\n1176\t        subptr = subject;\n1177\t        subptrend = subject + length;\n1178\t        goto SUBPTR_SUBSTITUTE;\n1179\t        }\n1180\t      if (next == CHAR_PLUS &&\n1181\t          !(ptr+1 < repend && ptr[1] == CHAR_LEFT_CURLY_BRACKET))\n1182\t        {\n1183\t        /* Perl supports $+ for \"highest captured group\" (not the same as $^N\n1184\t        which is mainly only useful inside Perl's match callbacks). We also\n1185\t        don't accept \"$+{...\" since that's Perl syntax for our ${name}. */\n1186\t        ++ptr;\n1187\t        if (code->top_bracket == 0)\n1188\t          {\n1189\t          /* Treat either as \"no such group\" or \"all groups unset\" based on the\n1190\t          PCRE2_SUBSTITUTE_UNKNOWN_UNSET option. */\n1191\t          if ((suboptions & PCRE2_SUBSTITUTE_UNKNOWN_UNSET) == 0)\n1192\t            {\n1193\t            rc = PCRE2_ERROR_NOSUBSTRING;\n1194\t            goto PTREXIT;\n1195\t            }\n1196\t          group = 0;\n1197\t          }\n1198\t        else\n1199\t          {\n1200\t          /* If we have any capture groups, then the ovector needs to be large\n1201\t          enough for all of them, or the result won't be accurate. */\n1202\t          if (match_data->oveccount < code->top_bracket + 1)\n1203\t            {\n1204\t            rc = PCRE2_ERROR_UNAVAILABLE;\n1205\t            goto PTREXIT;\n1206\t            }\n1207\t          for (group = code->top_bracket; group > 0; group--)\n1208\t            if (ovector[2*group] != PCRE2_UNSET) break;\n1209\t          }\n1210\t        if (group == 0)\n1211\t          {\n1212\t          if ((suboptions & PCRE2_SUBSTITUTE_UNSET_EMPTY) != 0) continue;\n1213\t          rc = PCRE2_ERROR_UNSET;\n1214\t          goto PTREXIT;\n1215\t          }\n1216\t        goto GROUP_SUBSTITUTE;\n1217\t        }\n1218\t\n1219\t      if (next == CHAR_LEFT_CURLY_BRACKET)\n1220\t        {\n1221\t        if (++ptr >= repend) goto BAD;\n1222\t        next = *ptr;\n1223\t        inparens = TRUE;\n1224\t        }\n1225\t      else if (next == CHAR_LESS_THAN_SIGN)\n1226\t        {\n1227\t        /* JavaScript compatibility syntax, $<name>. Processes only named\n1228\t        groups (not numbered) and does not support extensions such as star\n1229\t        (you can do ${name} and ${*name}, but not $<*name>). */\n1230\t        if (++ptr >= repend) goto BAD;\n1231\t        next = *ptr;\n1232\t        inangle = TRUE;\n1233\t        }\n1234\t\n1235\t      if (!inangle && next == CHAR_ASTERISK)\n1236\t        {\n1237\t        if (++ptr >= repend) goto BAD;\n1238\t        next = *ptr;\n1239\t        star = TRUE;\n1240\t        }\n1241\t\n1242\t      if (!star && !inangle && next >= CHAR_0 && next <= CHAR_9)\n1243\t        {\n1244\t        group = next - CHAR_0;\n1245\t        while (++ptr < repend)\n1246\t          {\n1247\t          next = *ptr;\n1248\t          if (next < CHAR_0 || next > CHAR_9) break;\n1249\t          group = group * 10 + (next - CHAR_0);\n1250\t\n1251\t          /* A check for a number greater than the hightest captured group\n1252\t          is sufficient here; no need for a separate overflow check. If unknown\n1253\t          groups are to be treated as unset, just skip over any remaining\n1254\t          digits and carry on. */\n1255\t\n1256\t          if (group > code->top_bracket)\n1257\t            {\n1258\t            if ((suboptions & PCRE2_SUBSTITUTE_UNKNOWN_UNSET) != 0)\n1259\t              {\n1260\t              while (++ptr < repend && *ptr >= CHAR_0 && *ptr <= CHAR_9);\n1261\t              break;\n1262\t              }\n1263\t            else\n1264\t              {\n1265\t              rc = PCRE2_ERROR_NOSUBSTRING;\n1266\t              goto PTREXIT;\n1267\t              }\n1268\t            }\n1269\t          }\n1270\t        }\n1271\t      else\n1272\t        {\n1273\t        PCRE2_SIZE name_len;\n1274\t        PCRE2_SPTR name_start = ptr;\n1275\t        if (!read_name_subst(&ptr, repend, utf, code->tables + ctypes_offset))\n1276\t          goto BAD;\n1277\t        name_len = ptr - name_start;\n1278\t        memcpy(name, name_start, CU2BYTES(name_len));\n1279\t        name[name_len] = 0;\n1280\t        }\n1281\t\n1282\t      next = 0; /* not used or updated after this point */\n1283\t      (void)next;\n1284\t\n1285\t      /* In extended mode we recognize ${name:+set text:unset text} and\n1286\t      ${name:-default text}. */\n12