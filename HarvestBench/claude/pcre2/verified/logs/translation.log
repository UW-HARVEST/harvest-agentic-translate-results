{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KhFtaGZmWrVPwdpj7hnUcD","type":"tool_result","content":"1\t/*************************************************\n2\t*      Perl-Compatible Regular Expressions       *\n3\t*************************************************/\n4\t\n5\t/* PCRE is a library of functions to support regular expressions whose syntax\n6\tand semantics are as close as possible to those of the Perl 5 language.\n7\t\n8\t                       Written by Philip Hazel\n9\t     Original API code Copyright (c) 1997-2012 University of Cambridge\n10\t          New API code Copyright (c) 2016-2024 University of Cambridge\n11\t\n12\t-----------------------------------------------------------------------------\n13\tRedistribution and use in source and binary forms, with or without\n14\tmodification, are permitted provided that the following conditions are met:\n15\t\n16\t    * Redistributions of source code must retain the above copyright notice,\n17\t      this list of conditions and the following disclaimer.\n18\t\n19\t    * Redistributions in binary form must reproduce the above copyright\n20\t      notice, this list of conditions and the following disclaimer in the\n21\t      documentation and/or other materials provided with the distribution.\n22\t\n23\t    * Neither the name of the University of Cambridge nor the names of its\n24\t      contributors may be used to endorse or promote products derived from\n25\t      this software without specific prior written permission.\n26\t\n27\tTHIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\"\n28\tAND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE\n29\tIMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE\n30\tARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE\n31\tLIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR\n32\tCONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF\n33\tSUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\n34\tINTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\n35\tCONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\n36\tARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE\n37\tPOSSIBILITY OF SUCH DAMAGE.\n38\t-----------------------------------------------------------------------------\n39\t*/\n40\t\n41\t\n42\t#include \"pcre2_internal.h\"\n43\t\n44\t\n45\t\n46\t#define PTR_STACK_SIZE 20\n47\t\n48\t#define SUBSTITUTE_OPTIONS \\\n49\t  (PCRE2_SUBSTITUTE_EXTENDED|PCRE2_SUBSTITUTE_GLOBAL| \\\n50\t   PCRE2_SUBSTITUTE_LITERAL|PCRE2_SUBSTITUTE_MATCHED| \\\n51\t   PCRE2_SUBSTITUTE_OVERFLOW_LENGTH|PCRE2_SUBSTITUTE_REPLACEMENT_ONLY| \\\n52\t   PCRE2_SUBSTITUTE_UNKNOWN_UNSET|PCRE2_SUBSTITUTE_UNSET_EMPTY)\n53\t\n54\t\n55\t\n56\t/*************************************************\n57\t*           Find end of substitute text          *\n58\t*************************************************/\n59\t\n60\t/* In extended mode, we recognize ${name:+set text:unset text} and similar\n61\tconstructions. This requires the identification of unescaped : and }\n62\tcharacters. This function scans for such. It must deal with nested ${\n63\tconstructions. The pointer to the text is updated, either to the required end\n64\tcharacter, or to where an error was detected.\n65\t\n66\tArguments:\n67\t  code      points to the compiled expression (for options)\n68\t  ptrptr    points to the pointer to the start of the text (updated)\n69\t  ptrend    end of the whole string\n70\t  last      TRUE if the last expected string (only } recognized)\n71\t\n72\tReturns:    0 on success\n73\t            negative error code on failure\n74\t*/\n75\t\n76\tstatic int\n77\tfind_text_end(const pcre2_code *code, PCRE2_SPTR *ptrptr, PCRE2_SPTR ptrend,\n78\t  BOOL last)\n79\t{\n80\tint rc = 0;\n81\tuint32_t nestlevel = 0;\n82\tBOOL literal = FALSE;\n83\tPCRE2_SPTR ptr = *ptrptr;\n84\t\n85\tfor (; ptr < ptrend; ptr++)\n86\t  {\n87\t  if (literal)\n88\t    {\n89\t    if (ptr[0] == CHAR_BACKSLASH && ptr < ptrend - 1 && ptr[1] == CHAR_E)\n90\t      {\n91\t      literal = FALSE;\n92\t      ptr += 1;\n93\t      }\n94\t    }\n95\t\n96\t  else if (*ptr == CHAR_RIGHT_CURLY_BRACKET)\n97\t    {\n98\t    if (nestlevel == 0) goto EXIT;\n99\t    nestlevel--;\n100\t    }\n101\t\n102\t  else if (*ptr == CHAR_COLON && !last && nestlevel == 0) goto EXIT;\n103\t\n104\t  else if (*ptr == CHAR_DOLLAR_SIGN)\n105\t    {\n106\t    if (ptr < ptrend - 1 && ptr[1] == CHAR_LEFT_CURLY_BRACKET)\n107\t      {\n108\t      nestlevel++;\n109\t      ptr += 1;\n110\t      }\n111\t    }\n112\t\n113\t  else if (*ptr == CHAR_BACKSLASH)\n114\t    {\n115\t    int erc;\n116\t    int errorcode;\n117\t    uint32_t ch;\n118\t    PCRE2_SPTR esc_end_ptr;\n119\t\n120\t    if (ptr < ptrend - 1) switch (ptr[1])\n121\t      {\n122\t      case CHAR_L:\n123\t      case CHAR_l:\n124\t      case CHAR_U:\n125\t      case CHAR_u:\n126\t      ptr += 1;\n127\t      continue;\n128\t      }\n129\t\n130\t    ptr += 1;  /* Must point after \\ */\n131\t    erc = PRIV(check_escape)(&ptr, ptrend, &ch, &errorcode,\n132\t      code->overall_options, code->extra_options, code->top_bracket, FALSE, NULL);\n133\t    if (errorcode != 0)\n134\t      {\n135\t      /* errorcode from check_escape is positive, so must not be returned by\n136\t      pcre2_substitute(). */\n137\t      rc = PCRE2_ERROR_BADREPESCAPE;\n138\t      goto EXIT;\n139\t      }\n140\t\n141\t    esc_end_ptr = ptr;\n142\t    ptr -= 1;  /* Rewind by one, because the for-loop will increment it */\n143\t\n144\t    switch(erc)\n145\t      {\n146\t      case 0:      /* Data character */\n147\t      case ESC_b:  /* Data character */\n148\t      case ESC_v:  /* Data character */\n149\t      case ESC_E:  /* Isolated \\E is ignored */\n150\t      break;\n151\t\n152\t      case ESC_Q:\n153\t      literal = TRUE;\n154\t      break;\n155\t\n156\t      case ESC_g:\n157\t      /* The \\g<name> form (\\g<number> already handled by check_escape)\n158\t\n159\t      Don't worry about finding the matching \">\". We are super, super lenient\n160\t      about validating ${} replacements inside find_text_end(), so we certainly\n161\t      don't need to worry about other syntax. Importantly, a \\g<..> or $<...>\n162\t      sequence can't contain a '}' character. */\n163\t      break;\n164\t\n165\t      default:\n166\t      if (erc < 0)\n167\t        break;  /* capture group reference */\n168\t      ptr = esc_end_ptr;\n169\t      rc = PCRE2_ERROR_BADREPESCAPE;\n170\t      goto EXIT;\n171\t      }\n172\t    }\n173\t  }\n174\t\n175\trc = PCRE2_ERROR_REPMISSINGBRACE;   /* Terminator not found */\n176\t\n177\tEXIT:\n178\t*ptrptr = ptr;\n179\treturn rc;\n180\t}\n181\t\n182\t\n183\t/*************************************************\n184\t*           Validate group name                  *\n185\t*************************************************/\n186\t\n187\t/* This function scans for a capture group name, validating it\n188\tconsists of legal characters, is not empty, and does not exceed\n189\tMAX_NAME_SIZE.\n190\t\n191\tArguments:\n192\t  ptrptr    points to the pointer to the start of the text (updated)\n193\t  ptrend    end of the whole string\n194\t  utf       true if the input is UTF-encoded\n195\t  ctypes    pointer to the character types table\n196\t\n197\tReturns:    TRUE if a name was read\n198\t            FALSE otherwise\n199\t*/\n200\t\n201\tstatic BOOL\n202\tread_name_subst(PCRE2_SPTR *ptrptr, PCRE2_SPTR ptrend, BOOL utf,\n203\t    const uint8_t* ctypes)\n204\t{\n205\tPCRE2_SPTR ptr = *ptrptr;\n206\tPCRE2_SPTR nameptr = ptr;\n207\t\n208\tif (ptr >= ptrend)                 /* No characters in name */\n209\t  goto FAILED;\n210\t\n211\t/* We do not need to check whether the name starts with a non-digit.\n212\tWe are simply referencing names here, not defining them. */\n213\t\n214\t/* See read_name in the pcre2_compile.c for the corresponding logic\n215\trestricting group names inside the pattern itself. */\n216\t\n217\t#ifdef SUPPORT_UNICODE\n218\tif (utf)\n219\t  {\n220\t  uint32_t c, type;\n221\t\n222\t  while (ptr < ptrend)\n223\t    {\n224\t    GETCHAR(c, ptr);\n225\t    type = UCD_CHARTYPE(c);\n226\t    if (type != ucp_Nd && PRIV(ucp_gentype)[type] != ucp_L &&\n227\t        c != CHAR_UNDERSCORE) break;\n228\t    ptr++;\n229\t    FORWARDCHARTEST(ptr, ptrend);\n230\t    }\n231\t  }\n232\telse\n233\t#else\n234\t(void)utf;  /* Avoid compiler warning */\n235\t#endif      /* SUPPORT_UNICODE */\n236\t\n237\t/* Handle group names in non-UTF modes. */\n238\t\n239\t  {\n240\t  while (ptr < ptrend && MAX_255(*ptr) && (ctypes[*ptr] & ctype_word) != 0)\n241\t    {\n242\t    ptr++;\n243\t    }\n244\t  }\n245\t\n246\t/* Check name length */\n247\t\n248\tif (ptr - nameptr > MAX_NAME_SIZE)\n249\t  goto FAILED;\n250\t\n251\t/* Subpattern names must not be empty */\n252\tif (ptr == nameptr)\n253\t  goto FAILED;\n254\t\n255\t*ptrptr = ptr;\n256\treturn TRUE;\n257\t\n258\tFAILED:\n259\t*ptrptr = ptr;\n260\treturn FALSE;\n261\t}\n262\t\n263\t\n264\t/*************************************************\n265\t*              Case transformations              *\n266\t*************************************************/\n267\t\n268\t#define PCRE2_SUBSTITUTE_CASE_NONE                 0\n269\t// 1, 2, 3 are PCRE2_SUBSTITUTE_CASE_LOWER, UPPER, TITLE_FIRST.\n270\t#define PCRE2_SUBSTITUTE_CASE_REVERSE_TITLE_FIRST  4\n271\t\n272\ttypedef struct {\n273\t  int to_case; /* One of PCRE2_SUBSTITUTE_CASE_xyz */\n274\t  BOOL single_char;\n275\t} case_state;\n276\t\n277\t/* Helper to guess how much a string is likely to increase in size when\n278\tcase-transformed. Usually, strings don't change size at all, but some rare\n279\tcharacters do grow. Estimate +10%, plus another few characters.\n280\t\n281\tPerforming this estimation is unfortunate, but inevitable, since we can't call\n282\tthe callout if we ran out of buffer space to prepare its input.\n283\t\n284\tBecause this estimate is inexact (and in pathological cases, underestimates the\n285\trequired buffer size) we must document that when you have a\n286\tsubstitute_case_callout, and you are using PCRE2_SUBSTITUTE_OVERFLOW_LENGTH, you\n287\tmay need more than two calls to determine the final buffer size. */\n288\t\n289\tstatic PCRE2_SIZE\n290\tpessimistic_case_inflation(PCRE2_SIZE len)\n291\t{\n292\treturn (len >> 3u) + 10;\n293\t}\n294\t\n295\t/* Case transformation behaviour if no callout is passed. */\n296\t\n297\tstatic PCRE2_SIZE\n298\tdefault_substitute_case_callout(\n299\t  PCRE2_SPTR input, PCRE2_SIZE input_len,\n300\t  PCRE2_UCHAR *output, PCRE2_SIZE output_cap,\n301\t  case_state *state, const pcre2_code *code)\n302\t{\n303\tPCRE2_SPTR input_end = input + input_len;\n304\t#ifdef SUPPORT_UNICODE\n305\tBOOL utf;\n306\tBOOL ucp;\n307\t#endif\n308\tPCRE2_UCHAR temp[6];\n309\tBOOL next_to_upper;\n310\tBOOL rest_to_upper;\n311\tBOOL single_char;\n312\tBOOL overflow = FALSE;\n313\tPCRE2_SIZE written = 0;\n314\t\n315\t/* Helpful simplifying invariant: input and output are disjoint buffers.\n316\tI believe that this code is technically undefined behaviour, because the two\n317\tpointers input/output are \"unrelated\" pointers and hence not comparable. Casting\n318\tvia char* bypasses some but not all of those technical rules. It is not included\n319\tin release builds, in any case. */\n320\tPCRE2_ASSERT((char *)(input + input_len) <= (char *)output ||\n321\t             (char *)(output + output_cap) <= (char *)input);\n322\t\n323\t#ifdef SUPPORT_UNICODE\n324\tutf = (code->overall_options & PCRE2_UTF) != 0;\n325\tucp = (code->overall_options & PCRE2_UCP) != 0;\n326\t#endif\n327\t\n328\tif (input_len == 0) return 0;\n329\t\n330\tswitch (state->to_case)\n331\t  {\n332\t  /* LCOV_EXCL_START */\n333\t  default:\n334\t  PCRE2_DEBUG_UNREACHABLE();\n335\t  return 0;\n336\t  /* LCOV_EXCL_STOP */\n337\t\n338\t  case PCRE2_SUBSTITUTE_CASE_LOWER: // Can be single_char TRUE or FALSE\n339\t  case PCRE2_SUBSTITUTE_CASE_UPPER: // Can only be single_char FALSE\n340\t  next_to_upper = rest_to_upper = (state->to_case == PCRE2_SUBSTITUTE_CASE_UPPER);\n341\t  break;\n342\t\n343\t  case PCRE2_SUBSTITUTE_CASE_TITLE_FIRST: // Can be single_char TRUE or FALSE\n344\t  next_to_upper = TRUE;\n345\t  rest_to_upper = FALSE;\n346\t  state->to_case = PCRE2_SUBSTITUTE_CASE_LOWER;\n347\t  break;\n348\t\n349\t  case PCRE2_SUBSTITUTE_CASE_REVERSE_TITLE_FIRST: // Can only be single_char FALSE\n350\t  next_to_upper = FALSE;\n351\t  rest_to_upper = TRUE;\n352\t  state->to_case = PCRE2_SUBSTITUTE_CASE_UPPER;\n353\t  break;\n354\t  }\n355\t\n356\tsingle_char = state->single_char;\n357\tif (single_char)\n358\t  state->to_case = PCRE2_SUBSTITUTE_CASE_NONE;\n359\t\n360\twhile (input < input_end)\n361\t  {\n362\t  uint32_t ch;\n363\t  unsigned int chlen;\n364\t\n365\t  GETCHARINCTEST(ch, input);\n366\t\n367\t#ifdef SUPPORT_UNICODE\n368\t  if ((utf || ucp) && ch >= 128)\n369\t    {\n370\t    uint32_t type = UCD_CHARTYPE(ch);\n371\t    if (PRIV(ucp_gentype)[type] == ucp_L &&\n372\t        type != (next_to_upper? ucp_Lu : ucp_Ll))\n373\t      ch = UCD_OTHERCASE(ch);\n374\t\n375\t    /* TODO This is far from correct... it doesn't support the SpecialCasing.txt\n376\t    mappings, but worse, it's not even correct for all the ordinary case\n377\t    mappings. We should add support for those (at least), and then add the\n378\t    SpecialCasing.txt mappings for Esszet and ligatures, and finally use the\n379\t    Turkish casing flag on the match context. */\n380\t    }\n381\t  else\n382\t#endif\n383\t  if (MAX_255(ch))\n384\t    {\n385\t    if (((code->tables + cbits_offset +\n386\t        (next_to_upper? cbit_upper:cbit_lower)\n387\t        )[ch/8] & (1u << (ch%8))) == 0)\n388\t      ch = (code->tables + fcc_offset)[ch];\n389\t    }\n390\t\n391\t#ifdef SUPPORT_UNICODE\n392\t  if (utf) chlen = PRIV(ord2utf)(ch, temp); else\n393\t#endif\n394\t    {\n395\t    temp[0] = ch;\n396\t    chlen = 1;\n397\t    }\n398\t\n399\t  if (!overflow && chlen <= output_cap)\n400\t    {\n401\t    memcpy(output, temp, CU2BYTES(chlen));\n402\t    output += chlen;\n403\t    output_cap -= chlen;\n404\t    }\n405\t  else\n406\t    {\n407\t    overflow = TRUE;\n408\t    }\n409\t\n410\t  if (chlen > ~(PCRE2_SIZE)0 - written)  /* Integer overflow */\n411\t    return ~(PCRE2_SIZE)0;\n412\t  written += chlen;\n413\t\n414\t  next_to_upper = rest_to_upper;\n415\t\n416\t  /* memcpy the remainder, if only transforming a single character. */\n417\t\n418\t  if (single_char)\n419\t    {\n420\t    PCRE2_SIZE rest_len = input_end - input;\n421\t\n422\t    if (!overflow && rest_len <= output_cap)\n423\t      memcpy(output, input, CU2BYTES(rest_len));\n424\t\n425\t    if (rest_len > ~(PCRE2_SIZE)0 - written)  /* Integer overflow */\n426\t      return ~(PCRE2_SIZE)0;\n427\t    written += rest_len;\n428\t\n429\t    return written;\n430\t    }\n431\t  }\n432\t\n433\treturn written;\n434\t}\n435\t\n436\t/* Helper to perform the call to the substitute_case_callout. We wrap the\n437\tuser-provided callout because our internal arguments are slightly extended. We\n438\tdon't want the user callout to handle the case of \"\\l\" (first character only to\n439\tlowercase) or \"\\l\\U\" (first character to lowercase, rest to uppercase) because\n440\tthose are not operations defined by Unicode. Instead the user callout simply\n441\tneeds to provide the three Unicode primitives: lower, upper, titlecase. */\n442\t\n443\tstatic PCRE2_SIZE\n444\tdo_case_copy(\n445\t  PCRE2_UCHAR *input_output, PCRE2_SIZE input_len, PCRE2_SIZE output_cap,\n446\t  case_state *state, BOOL utf,\n447\t  PCRE2_SIZE (*substitute_case_callout)(PCRE2_SPTR, PCRE2_SIZE, PCRE2_UCHAR *,\n448\t                                        PCRE2_SIZE, int, void *),\n449\t  void *substitute_case_callout_data)\n450\t{\n451\tPCRE2_SPTR input = input_output;\n452\tPCRE2_UCHAR *output = input_output;\n453\tPCRE2_SIZE rc;\n454\tPCRE2_SIZE rc2;\n455\tint ch1_to_case;\n456\tint rest_to_case;\n457\tPCRE2_UCHAR ch1[6];\n458\tPCRE2_SIZE ch1_len;\n459\tPCRE2_SPTR rest;\n460\tPCRE2_SIZE rest_len;\n461\tBOOL ch1_overflow = FALSE;\n462\tBOOL rest_overflow = FALSE;\n463\t\n464\t#if PCRE2_CODE_UNIT_WIDTH == 32 || !defined(SUPPORT_UNICODE)\n465\t(void)utf; /* Avoid compiler warning. */\n466\t#endif\n467\t\n468\tPCRE2_ASSERT(input_len != 0);\n469\t\n470\tswitch (state->to_case)\n471\t  {\n472\t  /* LCOV_EXCL_START */\n473\t  default:\n474\t  PCRE2_DEBUG_UNREACHABLE();\n475\t  return 0;\n476\t  /* LCOV_EXCL_STOP */\n477\t\n478\t  case PCRE2_SUBSTITUTE_CASE_LOWER: // Can be single_char TRUE or FALSE\n479\t  case PCRE2_SUBSTITUTE_CASE_UPPER: // Can only be single_char FALSE\n480\t  case PCRE2_SUBSTITUTE_CASE_TITLE_FIRST: // Can be single_char TRUE or FALSE\n481\t\n482\t  /* The easy case, where our internal casing operations align with those of\n483\t  the callout. */\n484\t\n485\t  if (state->single_char == FALSE)\n486\t    {\n487\t    rc = substitute_case_callout(input, input_len, output, output_cap,\n488\t                                 state->to_case, substitute_case_callout_data);\n489\t\n490\t    if (state->to_case == PCRE2_SUBSTITUTE_CASE_TITLE_FIRST)\n491\t      state->to_case = PCRE2_SUBSTITUTE_CASE_LOWER;\n492\t\n493\t    return rc;\n494\t    }\n495\t\n496\t  ch1_to_case = state->to_case;\n497\t  rest_to_case = PCRE2_SUBSTITUTE_CASE_NONE;\n498\t  break;\n499\t\n500\t  case PCRE2_SUBSTITUTE_CASE_REVERSE_TITLE_FIRST: // Can only be single_char FALSE\n501\t  ch1_to_case = PCRE2_SUBSTITUTE_CASE_LOWER;\n502\t  rest_to_case = PCRE2_SUBSTITUTE_CASE_UPPER;\n503\t  break;\n504\t  }\n505\t\n506\t/* Identify the leading character. Take copy, because its storage overlaps with\n507\t`output`, and hence may be scrambled by the callout. */\n508\t\n509\t  {\n510\t  PCRE2_SPTR ch_end = input;\n511\t  uint32_t ch;\n512\t\n513\t  GETCHARINCTEST(ch, ch_end);\n514\t  (void) ch;\n515\t  PCRE2_ASSERT(ch_end <= input + input_len && ch_end - input <= 6);\n516\t  ch1_len = ch_end - input;\n517\t  memcpy(ch1, input, CU2BYTES(ch1_len));\n518\t  }\n519\t\n520\trest = input + ch1_len;\n521\trest_len = input_len - ch1_len;\n522\t\n523\t/* Transform just ch1. The buffers are always in-place (input == output). With a\n524\tcustom callout, we need a loop to discover its required buffer size. The loop\n525\twouldn't be required if the callout were well-behaved, but it might be naughty\n526\tand return \"5\" the first time, then \"10\" the next time we call it using the\n527\texact same input! */\n528\t\n529\t  {\n530\t  PCRE2_SIZE ch1_cap;\n531\t  PCRE2_SIZE max_ch1_cap;\n532\t\n533\t  ch1_cap = ch1_len;  /* First attempt uses the space vacated by ch1. */\n534\t  PCRE2_ASSERT(output_cap >= input_len && input_len >= rest_len);\n535\t  max_ch1_cap = output_cap - rest_len;\n536\t\n537\t  while (TRUE)\n538\t    {\n539\t    rc = substitute_case_callout(ch1, ch1_len, output, ch1_cap, ch1_to_case,\n540\t                                 substitute_case_callout_data);\n541\t    if (rc == ~(PCRE2_SIZE)0) return rc;\n542\t\n543\t    if (rc <= ch1_cap) break;\n544\t\n545\t    if (rc > max_ch1_cap)\n546\t      {\n547\t      ch1_overflow = TRUE;\n548\t      break;\n549\t      }\n550\t\n551\t    /* Move the rest to the right, to make room for expanding ch1. */\n552\t\n553\t    memmove(input_output + rc, rest, CU2BYTES(rest_len));\n554\t    rest = input + rc;\n555\t\n556\t    ch1_cap = rc;\n557\t\n558\t    /* Proof of loop termination: `ch1_cap` is growing on each iteration, but\n559\t    the loop ends if `rc` reaches the (unchanging) upper bound of output_cap. */\n560\t    }\n561\t  }\n562\t\n563\tif (rest_to_case == PCRE2_SUBSTITUTE_CASE_NONE)\n564\t  {\n565\t  if (!ch1_overflow)\n566\t    {\n567\t    PCRE2_ASSERT(rest_len <= output_cap - rc);\n568\t    memmove(output + rc, rest, CU2BYTES(rest_len));\n569\t    }\n570\t  rc2 = rest_len;\n571\t\n572\t  state->to_case = PCRE2_SUBSTITUTE_CASE_NONE;\n573\t  }\n574\telse\n575\t  {\n576\t  PCRE2_UCHAR dummy[1];\n577\t\n578\t  rc2 = substitute_case_callout(rest, rest_len,\n579\t                                ch1_overflow? dummy : output + rc,\n580\t                                ch1_overflow? 0u : output_cap - rc,\n581\t                                rest_to_case, substitute_case_callout_data);\n582\t  if (rc2 == ~(PCRE2_SIZE)0) return rc2;\n583\t\n584\t  if (!ch1_overflow && rc2 > output_cap - rc) rest_overflow = TRUE;\n585\t\n586\t  /* If ch1 grows so that `xform(ch1)+rest` can't fit in the buffer, but then\n587\t  `rest` shrinks, it's actually possible for the total calculated length of\n588\t  `xform(ch1)+xform(rest)` to come out at less than output_cap. But we can't\n589\t  report that, because it would make it seem that the operation succeeded.\n590\t  If either of xform(ch1) or xform(rest) won't fit in the buffer, our final\n591\t  result must be > output_cap. */\n592\t  if (ch1_overflow && rc2 < rest_len)\n593\t    rc2 = rest_len;\n594\t\n595\t  state->to_case = PCRE2_SUBSTITUTE_CASE_UPPER;\n596\t  }\n597\t\n598\tif (rc2 > ~(PCRE2_SIZE)0 - rc)  /* Integer overflow */\n599\t  return ~(PCRE2_SIZE)0;\n600\t\n601\tPCRE2_ASSERT(!(ch1_overflow || rest_overflow) || rc + rc2 > output_cap);\n602\t(void)rest_overflow;\n603\t\n604\treturn rc + rc2;\n605\t}\n606\t\n607\t\n608\t/*************************************************\n609\t*              Match and substitute              *\n610\t*************************************************/\n611\t\n612\t/* This function applies a compiled re to a subject string and creates a new\n613\tstring with substitutions. The first 7 arguments are the same as for\n614\tpcre2_match(). Either string length may be PCRE2_ZERO_TERMINATED.\n615\t\n616\tArguments:\n617\t  code            points to the compiled expression\n618\t  subject         points to the subject string\n619\t  length          length of subject string (may contain binary zeros)\n620\t  start_offset    where to start in the subject string\n621\t  options         option bits\n622\t  match_data      points to a match_data block, or is NULL\n623\t  context         points a PCRE2 context\n624\t  replacement     points to the replacement string\n625\t  rlength         length of replacement string\n626\t  buffer          where to put the substituted string\n627\t  blength         points to length of buffer; updated to length of string\n628\t\n629\tReturns:          >= 0 number of substitutions made\n630\t                  < 0 an error code\n631\t                  PCRE2_ERROR_BADREPLACEMENT means invalid use of $\n632\t*/\n633\t\n634\t/* This macro checks for space in the buffer before copying into it. On\n635\toverflow, either give an error immediately, or keep on, accumulating the\n636\tlength. */\n637\t\n638\t#define CHECKMEMCPY(from, length_) \\\n639\t  do {    \\\n640\t     PCRE2_SIZE chkmc_length = length_; \\\n641\t     if (overflowed) \\\n642\t       {  \\\n643\t       if (chkmc_length > ~(PCRE2_SIZE)0 - extra_needed)  /* Integer overflow */ \\\n644\t         goto TOOLARGEREPLACE; \\\n645\t       extra_needed += chkmc_length; \\\n646\t       }  \\\n647\t     else if (lengthleft < chkmc_length) \\\n648\t       {  \\\n649\t       if ((suboptions & PCRE2_SUBSTITUTE_OVERFLOW_LENGTH) == 0) goto NOROOM; \\\n650\t       overflowed = TRUE; \\\n651\t       extra_needed = chkmc_length - lengthleft; \\\n652\t       }  \\\n653\t     else \\\n654\t       {  \\\n655\t       memcpy(buffer + buff_offset, from, CU2BYTES(chkmc_length)); \\\n656\t       buff_offset += chkmc_length; \\\n657\t       lengthleft -= chkmc_length; \\\n658\t       }  \\\n659\t     }    \\\n660\t  while (0)\n661\t\n662\t/* This macro checks for space and copies characters with casing modifications.\n663\tOn overflow, it behaves as for CHECKMEMCPY().\n664\t\n665\tWhen substitute_case_callout is NULL, the source and destination buffers must\n666\tnot overlap, because our default handler does not suppo