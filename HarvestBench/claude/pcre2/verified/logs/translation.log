{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QdNeEYS1XRzMfdtc7Xm4Nf","type":"tool_result","content":"1\t/*************************************************\n2\t*      Perl-Compatible Regular Expressions       *\n3\t*************************************************/\n4\t\n5\t/* PCRE is a library of functions to support regular expressions whose syntax\n6\tand semantics are as close as possible to those of the Perl 5 language.\n7\t\n8\t                       Written by Philip Hazel\n9\t     Original API code Copyright (c) 1997-2012 University of Cambridge\n10\t          New API code Copyright (c) 2015-2024 University of Cambridge\n11\t\n12\t-----------------------------------------------------------------------------\n13\tRedistribution and use in source and binary forms, with or without\n14\tmodification, are permitted provided that the following conditions are met:\n15\t\n16\t    * Redistributions of source code must retain the above copyright notice,\n17\t      this list of conditions and the following disclaimer.\n18\t\n19\t    * Redistributions in binary form must reproduce the above copyright\n20\t      notice, this list of conditions and the following disclaimer in the\n21\t      documentation and/or other materials provided with the distribution.\n22\t\n23\t    * Neither the name of the University of Cambridge nor the names of its\n24\t      contributors may be used to endorse or promote products derived from\n25\t      this software without specific prior written permission.\n26\t\n27\tTHIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\"\n28\tAND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE\n29\tIMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE\n30\tARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE\n31\tLIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR\n32\tCONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF\n33\tSUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\n34\tINTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\n35\tCONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\n36\tARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE\n37\tPOSSIBILITY OF SUCH DAMAGE.\n38\t-----------------------------------------------------------------------------\n39\t*/\n40\t\n41\t\n42\t#include \"pcre2_internal.h\"\n43\t\n44\t\n45\t\n46\t/* These defines enable debugging code */\n47\t\n48\t/* #define DEBUG_FRAMES_DISPLAY */\n49\t/* #define DEBUG_SHOW_OPS */\n50\t/* #define DEBUG_SHOW_RMATCH */\n51\t\n52\t#ifdef DEBUG_FRAMES_DISPLAY\n53\t#include <stdarg.h>\n54\t#endif\n55\t\n56\t#ifdef DEBUG_SHOW_OPS\n57\tstatic const char *OP_names[] = { OP_NAME_LIST };\n58\t#endif\n59\t\n60\t/* These defines identify the name of the block containing \"static\"\n61\tinformation, and fields within it. */\n62\t\n63\t#define NLBLOCK mb              /* Block containing newline information */\n64\t#define PSSTART start_subject   /* Field containing processed string start */\n65\t#define PSEND   end_subject     /* Field containing processed string end */\n66\t\n67\t#define RECURSE_UNSET 0xffffffffu  /* Bigger than max group number */\n68\t\n69\t/* Masks for identifying the public options that are permitted at match time. */\n70\t\n71\t#define PUBLIC_MATCH_OPTIONS \\\n72\t  (PCRE2_ANCHORED|PCRE2_ENDANCHORED|PCRE2_NOTBOL|PCRE2_NOTEOL|PCRE2_NOTEMPTY| \\\n73\t   PCRE2_NOTEMPTY_ATSTART|PCRE2_NO_UTF_CHECK|PCRE2_PARTIAL_HARD| \\\n74\t   PCRE2_PARTIAL_SOFT|PCRE2_NO_JIT|PCRE2_COPY_MATCHED_SUBJECT| \\\n75\t   PCRE2_DISABLE_RECURSELOOP_CHECK)\n76\t\n77\t#define PUBLIC_JIT_MATCH_OPTIONS \\\n78\t   (PCRE2_NO_UTF_CHECK|PCRE2_NOTBOL|PCRE2_NOTEOL|PCRE2_NOTEMPTY|\\\n79\t    PCRE2_NOTEMPTY_ATSTART|PCRE2_PARTIAL_SOFT|PCRE2_PARTIAL_HARD|\\\n80\t    PCRE2_COPY_MATCHED_SUBJECT)\n81\t\n82\t/* Non-error returns from and within the match() function. Error returns are\n83\texternally defined PCRE2_ERROR_xxx codes, which are all negative. */\n84\t\n85\t#define MATCH_MATCH        1\n86\t#define MATCH_NOMATCH      0\n87\t\n88\t/* Special internal returns used in the match() function. Make them\n89\tsufficiently negative to avoid the external error codes. */\n90\t\n91\t#define MATCH_ACCEPT       (-999)\n92\t#define MATCH_KETRPOS      (-998)\n93\t/* The next 5 must be kept together and in sequence so that a test that checks\n94\tfor any one of them can use a range. */\n95\t#define MATCH_COMMIT       (-997)\n96\t#define MATCH_PRUNE        (-996)\n97\t#define MATCH_SKIP         (-995)\n98\t#define MATCH_SKIP_ARG     (-994)\n99\t#define MATCH_THEN         (-993)\n100\t#define MATCH_BACKTRACK_MAX MATCH_THEN\n101\t#define MATCH_BACKTRACK_MIN MATCH_COMMIT\n102\t\n103\t/* Group frame type values. Zero means the frame is not a group frame. The\n104\tlower 16 bits are used for data (e.g. the capture number). Group frames are\n105\tused for most groups so that information about the start is easily available at\n106\tthe end without having to scan back through intermediate frames (backtrack\n107\tpoints). */\n108\t\n109\t#define GF_CAPTURE     0x00010000u\n110\t#define GF_NOCAPTURE   0x00020000u\n111\t#define GF_CONDASSERT  0x00030000u\n112\t#define GF_RECURSE     0x00040000u\n113\t\n114\t/* Masks for the identity and data parts of the group frame type. */\n115\t\n116\t#define GF_IDMASK(a)   ((a) & 0xffff0000u)\n117\t#define GF_DATAMASK(a) ((a) & 0x0000ffffu)\n118\t\n119\t/* Repetition types */\n120\t\n121\tenum { REPTYPE_MIN, REPTYPE_MAX, REPTYPE_POS };\n122\t\n123\t/* Min and max values for the common repeats; a maximum of UINT32_MAX =>\n124\tinfinity. */\n125\t\n126\tstatic const uint32_t rep_min[] = {\n127\t  0, 0,       /* * and *? */\n128\t  1, 1,       /* + and +? */\n129\t  0, 0,       /* ? and ?? */\n130\t  0, 0,       /* dummy placefillers for OP_CR[MIN]RANGE */\n131\t  0, 1, 0 };  /* OP_CRPOS{STAR, PLUS, QUERY} */\n132\t\n133\tstatic const uint32_t rep_max[] = {\n134\t  UINT32_MAX, UINT32_MAX,      /* * and *? */\n135\t  UINT32_MAX, UINT32_MAX,      /* + and +? */\n136\t  1, 1,                        /* ? and ?? */\n137\t  0, 0,                        /* dummy placefillers for OP_CR[MIN]RANGE */\n138\t  UINT32_MAX, UINT32_MAX, 1 }; /* OP_CRPOS{STAR, PLUS, QUERY} */\n139\t\n140\t/* Repetition types - must include OP_CRPOSRANGE (not needed above) */\n141\t\n142\tstatic const uint32_t rep_typ[] = {\n143\t  REPTYPE_MAX, REPTYPE_MIN,    /* * and *? */\n144\t  REPTYPE_MAX, REPTYPE_MIN,    /* + and +? */\n145\t  REPTYPE_MAX, REPTYPE_MIN,    /* ? and ?? */\n146\t  REPTYPE_MAX, REPTYPE_MIN,    /* OP_CRRANGE and OP_CRMINRANGE */\n147\t  REPTYPE_POS, REPTYPE_POS,    /* OP_CRPOSSTAR, OP_CRPOSPLUS */\n148\t  REPTYPE_POS, REPTYPE_POS };  /* OP_CRPOSQUERY, OP_CRPOSRANGE */\n149\t\n150\t/* Numbers for RMATCH calls at backtracking points. When these lists are\n151\tchanged, the code at RETURN_SWITCH below must be updated in sync.  */\n152\t\n153\tenum { RM1=1, RM2,  RM3,  RM4,  RM5,  RM6,  RM7,  RM8,  RM9,  RM10,\n154\t       RM11,  RM12, RM13, RM14, RM15, RM16, RM17, RM18, RM19, RM20,\n155\t       RM21,  RM22, RM23, RM24, RM25, RM26, RM27, RM28, RM29, RM30,\n156\t       RM31,  RM32, RM33, RM34, RM35, RM36, RM37, RM38, RM39 };\n157\t\n158\t#ifdef SUPPORT_WIDE_CHARS\n159\tenum { RM100=100, RM101, RM102, RM103 };\n160\t#endif\n161\t\n162\t#ifdef SUPPORT_UNICODE\n163\tenum { RM200=200, RM201, RM202, RM203, RM204, RM205, RM206, RM207,\n164\t       RM208,     RM209, RM210, RM211, RM212, RM213, RM214, RM215,\n165\t       RM216,     RM217, RM218, RM219, RM220, RM221, RM222, RM223,\n166\t       RM224 };\n167\t#endif\n168\t\n169\t/* Define short names for general fields in the current backtrack frame, which\n170\tis always pointed to by the F variable. Occasional references to fields in\n171\tother frames are written out explicitly. There are also some fields in the\n172\tcurrent frame that are used for short-term, localised backtracking memory.\n173\tThese are members of the fields union and #defined with Lxxx names at the\n174\tpoint of use and undefined afterwards. */\n175\t\n176\t#define Fback_frame        F->back_frame\n177\t#define Fcapture_last      F->capture_last\n178\t#define Fcurrent_recurse   F->current_recurse\n179\t#define Fecode             F->ecode\n180\t#define Feptr              F->eptr\n181\t#define Fgroup_frame_type  F->group_frame_type\n182\t#define Flast_group_offset F->last_group_offset\n183\t#define Fmark              F->mark\n184\t#define Frdepth            F->rdepth\n185\t#define Fstart_match       F->start_match\n186\t#define Foffset_top        F->offset_top\n187\t#define Fop                F->op\n188\t#define Fovector           F->ovector\n189\t#define Freturn_id         F->return_id\n190\t\n191\t\n192\t#ifdef DEBUG_FRAMES_DISPLAY\n193\t/*************************************************\n194\t*      Display current frames and contents       *\n195\t*************************************************/\n196\t\n197\t/* This debugging function displays the current set of frames and their\n198\tcontents. It is not called automatically from anywhere, the intention being\n199\tthat calls can be inserted where necessary when debugging frame-related\n200\tproblems.\n201\t\n202\tArguments:\n203\t  f           the file to write to\n204\t  F           the current top frame\n205\t  P           a previous frame of interest\n206\t  frame_size  the frame size\n207\t  mb          points to the match block\n208\t  match_data  points to the match data block\n209\t  s           identification text\n210\t\n211\tReturns:    nothing\n212\t*/\n213\t\n214\tstatic void\n215\tdisplay_frames(FILE *f, heapframe *F, heapframe *P, PCRE2_SIZE frame_size,\n216\t  match_block *mb, pcre2_match_data *match_data, const char *s, ...)\n217\t{\n218\tuint32_t i;\n219\theapframe *Q;\n220\tva_list ap;\n221\tva_start(ap, s);\n222\t\n223\tfprintf(f, \"FRAMES \");\n224\tvfprintf(f, s, ap);\n225\tva_end(ap);\n226\t\n227\tif (P != NULL) fprintf(f, \" P=%lu\",\n228\t  ((char *)P - (char *)(match_data->heapframes))/frame_size);\n229\tfprintf(f, \"\\n\");\n230\t\n231\tfor (i = 0, Q = match_data->heapframes;\n232\t     Q <= F;\n233\t     i++, Q = (heapframe *)((char *)Q + frame_size))\n234\t  {\n235\t  fprintf(f, \"Frame %d type=%x subj=%lu code=%d back=%lu id=%d\",\n236\t    i, Q->group_frame_type, Q->eptr - mb->start_subject, *(Q->ecode),\n237\t    Q->back_frame, Q->return_id);\n238\t\n239\t  if (Q->last_group_offset == PCRE2_UNSET)\n240\t    fprintf(f, \" lgoffset=unset\\n\");\n241\t  else\n242\t    fprintf(f, \" lgoffset=%lu\\n\",  Q->last_group_offset/frame_size);\n243\t  }\n244\t}\n245\t\n246\t#endif\n247\t\n248\t\n249\t\n250\t/*************************************************\n251\t*                Process a callout               *\n252\t*************************************************/\n253\t\n254\t/* This function is called for all callouts, whether \"standalone\" or at the\n255\tstart of a conditional group. Feptr will be pointing to either OP_CALLOUT or\n256\tOP_CALLOUT_STR. A callout block is allocated in pcre2_match() and initialized\n257\twith fixed values.\n258\t\n259\tArguments:\n260\t  F          points to the current backtracking frame\n261\t  mb         points to the match block\n262\t  lengthptr  where to return the length of the callout item\n263\t\n264\tReturns:     the return from the callout\n265\t             or 0 if no callout function exists\n266\t*/\n267\t\n268\tstatic int\n269\tdo_callout(heapframe *F, match_block *mb, PCRE2_SIZE *lengthptr)\n270\t{\n271\tint rc;\n272\tPCRE2_SIZE save0, save1;\n273\tPCRE2_SIZE *callout_ovector;\n274\tpcre2_callout_block *cb;\n275\t\n276\t*lengthptr = (*Fecode == OP_CALLOUT)?\n277\t  PRIV(OP_lengths)[OP_CALLOUT] : GET(Fecode, 1 + 2*LINK_SIZE);\n278\t\n279\tif (mb->callout == NULL) return 0;   /* No callout function provided */\n280\t\n281\t/* The original matching code (pre 10.30) worked directly with the ovector\n282\tpassed by the user, and this was passed to callouts. Now that the working\n283\tovector is in the backtracking frame, it no longer needs to reserve space for\n284\tthe overall match offsets (which would waste space in the frame). For backward\n285\tcompatibility, however, we pass capture_top and offset_vector to the callout as\n286\tif for the extended ovector, and we ensure that the first two slots are unset\n287\tby preserving and restoring their current contents. Picky compilers complain if\n288\treferences such as Fovector[-2] are use directly, so we set up a separate\n289\tpointer. */\n290\t\n291\tcallout_ovector = (PCRE2_SIZE *)(Fovector) - 2;\n292\t\n293\t/* The cb->version, cb->subject, cb->subject_length, and cb->start_match fields\n294\tare set externally. The first 3 never change; the last is updated for each\n295\tbumpalong. */\n296\t\n297\tcb = mb->cb;\n298\tcb->capture_top      = (uint32_t)Foffset_top/2 + 1;\n299\tcb->capture_last     = Fcapture_last;\n300\tcb->offset_vector    = callout_ovector;\n301\tcb->mark             = mb->nomatch_mark;\n302\tcb->current_position = (PCRE2_SIZE)(Feptr - mb->start_subject);\n303\tcb->pattern_position = GET(Fecode, 1);\n304\tcb->next_item_length = GET(Fecode, 1 + LINK_SIZE);\n305\t\n306\tif (*Fecode == OP_CALLOUT)  /* Numerical callout */\n307\t  {\n308\t  cb->callout_number = Fecode[1 + 2*LINK_SIZE];\n309\t  cb->callout_string_offset = 0;\n310\t  cb->callout_string = NULL;\n311\t  cb->callout_string_length = 0;\n312\t  }\n313\telse  /* String callout */\n314\t  {\n315\t  cb->callout_number = 0;\n316\t  cb->callout_string_offset = GET(Fecode, 1 + 3*LINK_SIZE);\n317\t  cb->callout_string = Fecode + (1 + 4*LINK_SIZE) + 1;\n318\t  cb->callout_string_length =\n319\t    *lengthptr - (1 + 4*LINK_SIZE) - 2;\n320\t  }\n321\t\n322\tsave0 = callout_ovector[0];\n323\tsave1 = callout_ovector[1];\n324\tcallout_ovector[0] = callout_ovector[1] = PCRE2_UNSET;\n325\trc = mb->callout(cb, mb->callout_data);\n326\tcallout_ovector[0] = save0;\n327\tcallout_ovector[1] = save1;\n328\tcb->callout_flags = 0;\n329\treturn rc;\n330\t}\n331\t\n332\t\n333\t\n334\t/*************************************************\n335\t*          Match a back-reference                *\n336\t*************************************************/\n337\t\n338\t/* This function is called only when it is known that the offset lies within\n339\tthe offsets that have so far been used in the match. Note that in caseless\n340\tUTF-8 mode, the number of subject bytes matched may be different to the number\n341\tof reference bytes. (In theory this could also happen in UTF-16 mode, but it\n342\tseems unlikely.)\n343\t\n344\tArguments:\n345\t  offset      index into the offset vector\n346\t  caseless    TRUE if caseless\n347\t  caseopts    bitmask of REFI_FLAG_XYZ values\n348\t  F           the current backtracking frame pointer\n349\t  mb          points to match block\n350\t  lengthptr   pointer for returning the length matched\n351\t\n352\tReturns:      = 0 sucessful match; number of code units matched is set\n353\t              < 0 no match\n354\t              > 0 partial match\n355\t*/\n356\t\n357\tstatic int\n358\tmatch_ref(PCRE2_SIZE offset, BOOL caseless, int caseopts, heapframe *F,\n359\t  match_block *mb, PCRE2_SIZE *lengthptr)\n360\t{\n361\tPCRE2_SPTR p;\n362\tPCRE2_SIZE length;\n363\tPCRE2_SPTR eptr;\n364\tPCRE2_SPTR eptr_start;\n365\t\n366\t#ifndef SUPPORT_UNICODE\n367\t(void)caseopts; /* Avoid compiler warning. */\n368\t#endif\n369\t\n370\t/* Deal with an unset group. The default is no match, but there is an option to\n371\tmatch an empty string. */\n372\t\n373\tif (offset >= Foffset_top || Fovector[offset] == PCRE2_UNSET)\n374\t  {\n375\t  if ((mb->poptions & PCRE2_MATCH_UNSET_BACKREF) != 0)\n376\t    {\n377\t    *lengthptr = 0;\n378\t    return 0;      /* Match */\n379\t    }\n380\t  else return -1;  /* No match */\n381\t  }\n382\t\n383\t/* Separate the caseless and UTF cases for speed. */\n384\t\n385\teptr = eptr_start = Feptr;\n386\tp = mb->start_subject + Fovector[offset];\n387\tlength = Fovector[offset+1] - Fovector[offset];\n388\tPCRE2_ASSERT(eptr <= mb->end_subject);\n389\t\n390\tif (caseless)\n391\t  {\n392\t#if defined SUPPORT_UNICODE\n393\t  BOOL utf = (mb->poptions & PCRE2_UTF) != 0;\n394\t  BOOL caseless_restrict = (caseopts & REFI_FLAG_CASELESS_RESTRICT) != 0;\n395\t  BOOL turkish_casing = !caseless_restrict && (caseopts & REFI_FLAG_TURKISH_CASING) != 0;\n396\t\n397\t  if (utf || (mb->poptions & PCRE2_UCP) != 0)\n398\t    {\n399\t    PCRE2_SPTR endptr = p + length;\n400\t\n401\t    /* Match characters up to the end of the reference. NOTE: the number of\n402\t    code units matched may differ, because in UTF-8 there are some characters\n403\t    whose upper and lower case codes have different numbers of bytes. For\n404\t    example, U+023A (2 bytes in UTF-8) is the upper case version of U+2C65 (3\n405\t    bytes in UTF-8); a sequence of 3 of the former uses 6 bytes, as does a\n406\t    sequence of two of the latter. It is important, therefore, to check the\n407\t    length along the reference, not along the subject (earlier code did this\n408\t    wrong). UCP uses Unicode properties but without UTF encoding. */\n409\t\n410\t    while (p < endptr)\n411\t      {\n412\t      uint32_t c, d;\n413\t      const ucd_record *ur;\n414\t      if (eptr >= mb->end_subject) return 1;   /* Partial match */\n415\t\n416\t      if (utf)\n417\t        {\n418\t        GETCHARINC(c, eptr);\n419\t        GETCHARINC(d, p);\n420\t        }\n421\t      else\n422\t        {\n423\t        c = *eptr++;\n424\t        d = *p++;\n425\t        }\n426\t\n427\t      if (turkish_casing && UCD_ANY_I(d))\n428\t        {\n429\t        c = UCD_FOLD_I_TURKISH(c);\n430\t        d = UCD_FOLD_I_TURKISH(d);\n431\t        if (c != d) return -1;  /* No match */\n432\t        }\n433\t      else if (c != d && c != (uint32_t)((int)d + (ur = GET_UCD(d))->other_case))\n434\t        {\n435\t        const uint32_t *pp = PRIV(ucd_caseless_sets) + ur->caseset;\n436\t\n437\t        /* When PCRE2_EXTRA_CASELESS_RESTRICT is set, ignore any caseless sets\n438\t        that start with an ASCII character. */\n439\t        if (caseless_restrict && *pp < 128) return -1;  /* No match */\n440\t\n441\t        for (;;)\n442\t          {\n443\t          if (c < *pp) return -1;  /* No match */\n444\t          if (c == *pp++) break;\n445\t          }\n446\t        }\n447\t      }\n448\t    }\n449\t  else\n450\t#endif\n451\t\n452\t  /* Not in UTF or UCP mode */\n453\t    {\n454\t    for (; length > 0; length--)\n455\t      {\n456\t      uint32_t cc, cp;\n457\t      if (eptr >= mb->end_subject) return 1;   /* Partial match */\n458\t      cc = *eptr;\n459\t      cp = *p;\n460\t      if (TABLE_GET(cp, mb->lcc, cp) != TABLE_GET(cc, mb->lcc, cc))\n461\t        return -1;  /* No match */\n462\t      p++;\n463\t      eptr++;\n464\t      }\n465\t    }\n466\t  }\n467\t\n468\t/* In the caseful case, we can just compare the code units, whether or not we\n469\tare in UTF and/or UCP mode. When partial matching, we have to do this unit by\n470\tunit. */\n471\t\n472\telse\n473\t  {\n474\t  if (mb->partial != 0)\n475\t    {\n476\t    for (; length > 0; length--)\n477\t      {\n478\t      if (eptr >= mb->end_subject) return 1;   /* Partial match */\n479\t      if (*p++ != *eptr++) return -1;  /* No match */\n480\t      }\n481\t    }\n482\t\n483\t  /* Not partial matching */\n484\t\n485\t  else\n486\t    {\n487\t    if ((PCRE2_SIZE)(mb->end_subject - eptr) < length ||\n488\t        memcmp(p, eptr, CU2BYTES(length)) != 0) return -1;  /* No match */\n489\t    eptr += length;\n490\t    }\n491\t  }\n492\t\n493\t*lengthptr = eptr - eptr_start;\n494\treturn 0;  /* Match */\n495\t}\n496\t\n497\t\n498\t\n499\t/*************************************************\n500\t*     Restore offsets after a recurse            *\n501\t*************************************************/\n502\t\n50