t#ifdef DEBUG_SHOW_PARSED\n829\t/*************************************************\n830\t*     Show the parsed pattern for debugging      *\n831\t*************************************************/\n832\t\n833\t/* For debugging the pre-scan, this code, which outputs the parsed data vector,\n834\tcan be enabled. */\n835\t\n836\tstatic void show_parsed(compile_block *cb)\n837\t{\n838\tuint32_t *pptr = cb->parsed_pattern;\n839\t\n840\tfor (;;)\n841\t  {\n842\t  int max, min;\n843\t  PCRE2_SIZE offset;\n844\t  uint32_t i;\n845\t  uint32_t length;\n846\t  uint32_t meta_arg = META_DATA(*pptr);\n847\t\n848\t  fprintf(stderr, \"+++ %02d %.8x \", (int)(pptr - cb->parsed_pattern), *pptr);\n849\t\n850\t  if (*pptr < META_END)\n851\t    {\n852\t    if (*pptr > 32 && *pptr < 128) fprintf(stderr, \"%c\", *pptr);\n853\t    pptr++;\n854\t    }\n855\t\n856\t  else switch (META_CODE(*pptr++))\n857\t    {\n858\t    default:\n859\t    fprintf(stderr, \"**** OOPS - unknown META value - giving up ****\\n\");"}]},"parent_tool_use_id":"toolu_bdrk_017D2JdBQgEnZGPyNZrxVexQ","session_id":"69c7dc4d-05f2-4bba-997b-e68ff82cc8bc","uuid":"0b6853c6-2b9c-43a3-989d-f69cb7043da3","timestamp":"2026-08-22T22:40:01.200Z","subagent_type":"general-purpose","task_description":"compile tables part"}
