onst LAST_AUTOTAB_LEFT_OP: u8 = OP_EXTUNI;\n1169\tpub const LAST_AUTOTAB_RIGHT_OP: u8 = OP_DOLLM;\n1170\t\n1171\t// ---------- GET/PUT link macros (8-bit, LINK_SIZE=2) ----------\n1172\t#[inline]\n1173\tpub unsafe fn GET(a: *const u8, n: usize) -> u32 {\n1174\t    ((*a.add(n) as u32) << 8) | (*a.add(n + 1) as u32)\n1175\t}\n1176\t#[inline]\n1177\tpub unsafe fn PUT(a: *mut u8, n: usize, d: u32) {\n1178\t    *a.add(n) = (d >> 8) as u8;\n1179\t    *a.add(n + 1) = (d & 255) as u8;\n1180\t}\n1181\t#[inline]\n1182\tpub unsafe fn GET2(a: *const u8, n: usize) -> u32 {\n1183\t    ((*a.add(n) as u32) << 8) | (*a.add(n + 1) as u32)\n1184\t}\n1185\t#[inline]\n1186\tpub unsafe fn PUT2(a: *mut u8, n: usize, d: u32) {\n1187\t    *a.add(n) = (d >> 8) as u8;\n1188\t    *a.add(n + 1) = (d & 255) as u8;\n1189\t}\n1190\t#[inline]\n1191\tpub fn CU2BYTES(x: usize) -> usize { x }\n1192\t#[inline]\n1193\tpub fn BYTES2CU(x: usize) -> usize { x }\n1194\t\n1195\t// ---------- extern data tables (defined in tables_data.rs) ----------\n1196\textern \"C\" {\n1197\t    pub static _pcre2_OP_lengths_8: [u8; OP_TABLE_LENGTH];\n1198\t    pub static _pcre2_hspace_list_8: [u32; 20];\n1199\t    pub static _pcre2_vspace_list_8: [u32; 8];\n1200\t    pub static _pcre2_callout_start_delims_8: [u32; 9];\n1201\t    pub static _pcre2_callout_end_delims_8: [u32; 9];\n1202\t    pub static _pcre2_default_tables_8: [u8; TABLES_LENGTH];\n1203\t    pub static _pcre2_utf8_table1: [i32; 6];\n1204\t    pub static _pcre2_utf8_table1_size: u32;\n1205\t    pub static _pcre2_utf8_table2: [i32; 6];\n1206\t    pub static _pcre2_utf8_table3: [i32; 6];\n1207\t    pub static _pcre2_utf8_table4: [u8; 64];\n1208\t    pub static _pcre2_ucp_gentype_8: [u32; 29];\n1209\t    pub static _pcre2_ucp_gbtable_8: [u32; 15];\n1210\t    pub static _pcre2_ucd_records_8: [UcdRecord; 1563];\n1211\t    pub static _pcre2_ucd_stage1_8: [u16; 8704];\n1212\t    pub static _pcre2_ucd_stage2_8: [u16; 40192];\n1213\t    pub static _pcre2_ucd_caseless_sets_8: [u32; 118];\n1214\t    pub static _pcre2_ucd_boolprop_sets_8: [u32; 382];\n1215\t    pub static _pcre2_ucd_script_sets_8: [u32; 476];\n1216\t    pub static _pcre2_ucd_digit_sets_8: [u32; 78];\n1217\t    pub static _pcre2_ucd_nocase_ranges_8: [u32; 82];\n1218\t    pub static _pcre2_ucd_nocase_ranges_size_8: u32;\n1219\t    pub static _pcre2_ucd_turkish_dotted_i_caseset_8: u32;\n1220\t    pub static _pcre2_posix_class_maps8: [i32; 42];\n1221\t    pub static _pcre2_utt_8: [UcpTypeTable; 518];\n1222\t    pub static _pcre2_utt_names_8: [u8; 3834];\n1223\t    pub static _pcre2_utt_size_8: usize;\n1224\t}\n1225\t\n1226\t// ---------- UCD access helpers ----------\n1227\t#[inline]\n1228\tpub fn GET_UCD(ch: u32) -> &'static UcdRecord {\n1229\t    REAL_GET_UCD(ch)\n1230\t}\n1231\t#[inline]\n1232\tpub fn REAL_GET_UCD(ch: u32) -> &'static UcdRecord {\n1233\t    unsafe {\n1234\t        let stage1 = _pcre2_ucd_stage1_8[(ch as usize) / UCD_BLOCK_SIZE] as usize;\n1235\t        let idx = _pcre2_ucd_stage2_8[stage1 * UCD_BLOCK_SIZE + (ch as usize) % UCD_BLOCK_SIZE] as usize;\n1236\t        &_pcre2_ucd_records_8[idx]\n1237\t    }\n1238\t}\n1239\t#[inline]\n1240\tpub fn UCD_CHARTYPE(ch: u32) -> u32 { GET_UCD(ch).chartype as u32 }\n1241\t#[inline]\n1242\tpub fn UCD_SCRIPT(ch: u32) -> u32 { GET_UCD(ch).script as u32 }\n1243\t#[inline]\n1244\tpub fn UCD_CATEGORY(ch: u32) -> u32 { unsafe { _pcre2_ucp_gentype_8[UCD_CHARTYPE(ch) as usize] } }\n1245\t#[inline]\n1246\tpub fn UCD_GRAPHBREAK(ch: u32) -> u32 { GET_UCD(ch).gbprop as u32 }\n1247\t#[inline]\n1248\tpub fn UCD_CASESET(ch: u32) -> u32 { GET_UCD(ch).caseset as u32 }\n1249\t#[inline]\n1250\tpub fn UCD_OTHERCASE(ch: u32) -> u32 { (ch as i32 + GET_UCD(ch).other_case) as u32 }\n1251\t#[inline]\n1252\tpub fn UCD_SCRIPTX(ch: u32) -> u32 { (GET_UCD(ch).scriptx_bidiclass & UCD_SCRIPTX_MASK) as u32 }\n1253\t#[inline]\n1254\tpub fn UCD_BPROPS(ch: u32) -> u32 { (GET_UCD(ch).bprops & UCD_BPROPS_MASK) as u32 }\n1255\t#[inline]\n1256\tpub fn UCD_BIDICLASS(ch: u32) -> u32 { (GET_UCD(ch).scriptx_bidiclass >> UCD_BIDICLASS_SHIFT) as u32 }\n1257\t\n1258\t// ---------- UTF-8 character macros (8-bit) ----------\n1259\tpub const MAYBE_UTF_MULTI: bool = true;\n1260\t\n1261\t#[inline]\n1262\tpub fn HASUTF8EXTRALEN(c: u32) -> bool { c >= 0xc0 }\n1263\t#[inline]\n1264\tpub fn HAS_EXTRALEN(c: u32) -> bool { HASUTF8EXTRALEN(c) }\n1265\t#[inline]\n1266\tpub unsafe fn GET_EXTRALEN(c: u32) -> u32 { _pcre2_utf8_table4[(c & 0x3f) as usize] as u32 }\n1267\t#[inline]\n1268\tpub fn NOT_FIRSTCU(c: u32) -> bool { (c & 0xc0) == 0x80 }\n1269\t\n1270\t/// GETUTF8: decode remaining bytes of a UTF-8 char at eptr[0..], not advancing.\n1271\t#[inline]\n1272\tpub unsafe fn getutf8(c: u32, eptr: PCRE2_SPTR) -> u32 {\n1273\t    if (c & 0x20) == 0 {\n1274\t        ((c & 0x1f) << 6) | (*eptr.add(1) as u32 & 0x3f)\n1275\t    } else if (c & 0x10) == 0 {\n1276\t        ((c & 0x0f) << 12) | ((*eptr.add(1) as u32 & 0x3f) << 6) | (*eptr.add(2) as u32 & 0x3f)\n1277\t    } else if (c & 0x08) == 0 {\n1278\t        ((c & 0x07) << 18)\n1279\t            | ((*eptr.add(1) as u32 & 0x3f) << 12)\n1280\t            | ((*eptr.add(2) as u32 & 0x3f) << 6)\n1281\t            | (*eptr.add(3) as u32 & 0x3f)\n1282\t    } else if (c & 0x04) == 0 {\n1283\t        ((c & 0x03) << 24)\n1284\t            | ((*eptr.add(1) as u32 & 0x3f) << 18)\n1285\t            | ((*eptr.add(2) as u32 & 0x3f) << 12)\n1286\t            | ((*eptr.add(3) as u32 & 0x3f) << 6)\n1287\t            | (*eptr.add(4) as u32 & 0x3f)\n1288\t    } else {\n1289\t        ((c & 0x01) << 30)\n1290\t            | ((*eptr.add(1) as u32 & 0x3f) << 24)\n1291\t            | ((*eptr.add(2) as u32 & 0x3f) << 18)\n1292\t            | ((*eptr.add(3) as u32 & 0x3f) << 12)\n1293\t            | ((*eptr.add(4) as u32 & 0x3f) << 6)\n1294\t            | (*eptr.add(5) as u32 & 0x3f)\n1295\t    }\n1296\t}\n1297\t\n1298\t/// GETCHAR: decode full char at eptr, not advancing (UTF known).\n1299\t#[inline]\n1300\tpub unsafe fn GETCHAR(eptr: PCRE2_SPTR) -> u32 {\n1301\t    let c = *eptr as u32;\n1302\t    if c >= 0xc0 { getutf8(c, eptr) } else { c }\n1303\t}\n1304\t\n1305\t/// GETCHARLEN: decode char at eptr; return (char, extra_len_added).\n1306\t/// Mirrors C's `len++`-style extra length accumulation.\n1307\t#[inline]\n1308\tpub unsafe fn GETCHARLEN(eptr: PCRE2_SPTR) -> (u32, u32) {\n1309\t    let c = *eptr as u32;\n1310\t    if c < 0xc0 {\n1311\t        return (c, 0);\n1312\t    }\n1313\t    let extra = if (c & 0x20) == 0 {\n1314\t        1\n1315\t    } else if (c & 0x10) == 0 {\n1316\t        2\n1317\t    } else if (c & 0x08) == 0 {\n1318\t        3\n1319\t    } else if (c & 0x04) == 0 {\n1320\t        4\n1321\t    } else {\n1322\t        5\n1323\t    };\n1324\t    (getutf8(c, eptr), extra)\n1325\t}\n1326\t\n1327\t/// GETCHARINC: decode char and return (char, code_units_consumed).\n1328\t#[inline]\n1329\tpub unsafe fn GETCHARINC(eptr: PCRE2_SPTR) -> (u32, usize) {\n1330\t    let c = *eptr as u32;\n1331\t    if c < 0xc0 {\n1332\t        return (c, 1);\n1333\t    }\n1334\t    let (val, extra) = GETCHARLEN(eptr);\n1335\t    (val, 1 + extra as usize)\n1336\t}\n1337\t\n1338\t/// BACKCHAR: move ptr back over UTF-8 continuation bytes.\n1339\t#[inline]\n1340\tpub unsafe fn BACKCHAR(mut eptr: PCRE2_SPTR) -> PCRE2_SPTR {\n1341\t    while (*eptr & 0xc0) == 0x80 {\n1342\t        eptr = eptr.sub(1);\n1343\t    }\n1344\t    eptr\n1345\t}\n1346\t\n1347\t// ---------- libc bindings ----------\n1348\textern \"C\" {\n1349\t    pub fn malloc(size: usize) -> *mut c_void;\n1350\t    pub fn free(ptr: *mut c_void);\n1351\t    pub fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n1352\t    pub fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n1353\t    pub fn memset(dst: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n1354\t    pub fn memchr(s: *const c_void, c: c_int, n: usize) -> *mut c_void;\n1355\t    pub fn strlen(s: *const c_char) -> usize;\n1356