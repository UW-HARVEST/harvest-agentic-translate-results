{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VxhotVq3V8PRZGsk5yGkAN","type":"tool_result","content":"1\t/*************************************************\n2\t*      Perl-Compatible Regular Expressions       *\n3\t*************************************************/\n4\t\n5\t/* PCRE is a library of functions to support regular expressions whose syntax\n6\tand semantics are as close as possible to those of the Perl 5 language.\n7\t\n8\t                       Written by Philip Hazel\n9\t     Original API code Copyright (c) 1997-2012 University of Cambridge\n10\t          New API code Copyright (c) 2016-2024 University of Cambridge\n11\t*/\n12\t\n13\t#![allow(non_snake_case)]\n14\t#![allow(non_upper_case_globals)]\n15\t#![allow(unused_assignments)]\n16\t#![allow(unused_parens)]\n17\t\n18\tuse core::ffi::{c_int, c_void};\n19\tuse crate::pcre2_internal::*;\n20\t\n21\t/* In the 8-bit library, MAX_255 is always TRUE. */\n22\t#[inline]\n23\tfn MAX_255(_c: u32) -> bool {\n24\t    true\n25\t}\n26\t\n27\t/* GETCHAR: decode a full char at ptr without advancing (UTF assumed). */\n28\tmacro_rules! GETCHAR {\n29\t    ($c:ident, $ptr:expr) => {\n30\t        $c = GETCHAR($ptr);\n31\t    };\n32\t}\n33\t\n34\t/* FORWARDCHARTEST: advance ptr over UTF-8 continuation bytes, bounded by end. */\n35\tmacro_rules! FORWARDCHARTEST {\n36\t    ($ptr:expr, $end:expr) => {\n37\t        while $ptr < $end && (*$ptr & 0xc0) == 0x80 {\n38\t            $ptr = $ptr.add(1);\n39\t        }\n40\t    };\n41\t}\n42\t\n43\tconst PTR_STACK_SIZE: usize = 20;\n44\t\n45\tconst SUBSTITUTE_OPTIONS: u32 =\n46\t    PCRE2_SUBSTITUTE_EXTENDED | PCRE2_SUBSTITUTE_GLOBAL |\n47\t    PCRE2_SUBSTITUTE_LITERAL | PCRE2_SUBSTITUTE_MATCHED |\n48\t    PCRE2_SUBSTITUTE_OVERFLOW_LENGTH | PCRE2_SUBSTITUTE_REPLACEMENT_ONLY |\n49\t    PCRE2_SUBSTITUTE_UNKNOWN_UNSET | PCRE2_SUBSTITUTE_UNSET_EMPTY;\n50\t\n51\t\n52\t/*************************************************\n53\t*           Find end of substitute text          *\n54\t*************************************************/\n55\t\n56\t/* In extended mode, we recognize ${name:+set text:unset text} and similar\n57\tconstructions. This requires the identification of unescaped : and }\n58\tcharacters. This function scans for such. It must deal with nested ${\n59\tconstructions. The pointer to the text is updated, either to the required end\n60\tcharacter, or to where an error was detected.\n61\t\n62\tArguments:\n63\t  code      points to the compiled expression (for options)\n64\t  ptrptr    points to the pointer to the start of the text (updated)\n65\t  ptrend    end of the whole string\n66\t  last      TRUE if the last expected string (only } recognized)\n67\t\n68\tReturns:    0 on success\n69\t            negative error code on failure\n70\t*/\n71\t\n72\tunsafe fn find_text_end(\n73\t    code: *const pcre2_real_code,\n74\t    ptrptr: *mut PCRE2_SPTR,\n75\t    ptrend: PCRE2_SPTR,\n76\t    last: BOOL,\n77\t) -> c_int {\n78\t    let mut rc: c_int = 0;\n79\t    let mut nestlevel: u32 = 0;\n80\t    let mut literal: BOOL = FALSE;\n81\t    let mut ptr: PCRE2_SPTR = *ptrptr;\n82\t    let mut hit_exit = false;\n83\t\n84\t    while ptr < ptrend {\n85\t        if literal != FALSE {\n86\t            if *ptr.add(0) == CHAR_BACKSLASH as PCRE2_UCHAR\n87\t                && ptr < ptrend.sub(1)\n88\t                && *ptr.add(1) == CHAR_E as PCRE2_UCHAR\n89\t            {\n90\t                literal = FALSE;\n91\t                ptr = ptr.add(1);\n92\t            }\n93\t        } else if *ptr == CHAR_RIGHT_CURLY_BRACKET as PCRE2_UCHAR {\n94\t            if nestlevel == 0 {\n95\t                hit_exit = true;\n96\t                break;\n97\t            }\n98\t            nestlevel -= 1;\n99\t        } else if *ptr == CHAR_COLON as PCRE2_UCHAR && last == FALSE && nestlevel == 0 {\n100\t            hit_exit = true;\n101\t            break;\n102\t        } else if *ptr == CHAR_DOLLAR_SIGN as PCRE2_UCHAR {\n103\t            if ptr < ptrend.sub(1) && *ptr.add(1) == CHAR_LEFT_CURLY_BRACKET as PCRE2_UCHAR {\n104\t                nestlevel += 1;\n105\t                ptr = ptr.add(1);\n106\t            }\n107\t        } else if *ptr == CHAR_BACKSLASH as PCRE2_UCHAR {\n108\t            let erc: c_int;\n109\t            let mut errorcode: c_int = 0;\n110\t            let mut ch: u32 = 0;\n111\t            let esc_end_ptr: PCRE2_SPTR;\n112\t\n113\t            if ptr < ptrend.sub(1) {\n114\t                let c1 = *ptr.add(1) as u32;\n115\t                if c1 == CHAR_L || c1 == CHAR_l || c1 == CHAR_U || c1 == CHAR_u {\n116\t                    ptr = ptr.add(1);\n117\t                    ptr = ptr.add(1); /* for-loop increment */\n118\t                    continue;\n119\t                }\n120\t            }\n121\t\n122\t            ptr = ptr.add(1); /* Must point after \\ */\n123\t            erc = crate::pcre2_compile::_pcre2_check_escape_8(\n124\t                &mut ptr as *mut PCRE2_SPTR,\n125\t                ptrend,\n126\t                &mut ch as *mut u32,\n127\t                &mut errorcode as *mut c_int,\n128\t                (*code).overall_options,\n129\t                (*code).extra_options,\n130\t                (*code).top_bracket,\n131\t                FALSE,\n132\t                core::ptr::null_mut(),\n133\t            );\n134\t            if errorcode != 0 {\n135\t                /* errorcode from check_escape is positive, so must not be returned by\n136\t                pcre2_substitute(). */\n137\t                rc = PCRE2_ERROR_BADREPESCAPE;\n138\t                hit_exit = true;\n139\t                break;\n140\t            }\n141\t\n142\t            esc_end_ptr = ptr;\n143\t            ptr = ptr.sub(1); /* Rewind by one, because the for-loop will increment it */\n144\t\n145\t            if erc == 0 || erc == ESC_b || erc == ESC_v || erc == ESC_E {\n146\t                /* Data character / Isolated \\E is ignored */\n147\t            } else if erc == ESC_Q {\n148\t                literal = TRUE;\n149\t            } else if erc == ESC_g {\n150\t                /* The \\g<name> form (\\g<number> already handled by check_escape) */\n151\t            } else {\n152\t                if erc < 0 {\n153\t                    /* capture group reference */\n154\t                } else {\n155\t                    ptr = esc_end_ptr;\n156\t                    rc = PCRE2_ERROR_BADREPESCAPE;\n157\t                    hit_exit = true;\n158\t                    break;\n159\t                }\n160\t            }\n161\t        }\n162\t        ptr = ptr.add(1);\n163\t    }\n164\t\n165\t    if !hit_exit {\n166\t        rc = PCRE2_ERROR_REPMISSINGBRACE; /* Terminator not found */\n167\t    }\n168\t\n169\t    // EXIT:\n170\t    *ptrptr = ptr;\n171\t    rc\n172\t}\n173\t\n174\t\n175\t/*************************************************\n176\t*           Validate group name                  *\n177\t*************************************************/\n178\t\n179\t/* This function scans for a capture group name, validating it\n180\tconsists of legal characters, is not empty, and does not exceed\n181\tMAX_NAME_SIZE.\n182\t\n183\tArguments:\n184\t  ptrptr    points to the pointer to the start of the text (updated)\n185\t  ptrend    end of the whole string\n186\t  utf       true if the input is UTF-encoded\n187\t  ctypes    pointer to the character types table\n188\t\n189\tReturns:    TRUE if a name was read\n190\t            FALSE otherwise\n191\t*/\n192\t\n193\tunsafe fn read_name_subst(\n194\t    ptrptr: *mut PCRE2_SPTR,\n195\t    ptrend: PCRE2_SPTR,\n196\t    utf: BOOL,\n197\t    ctypes: *const u8,\n198\t) -> BOOL {\n199\t    let mut ptr: PCRE2_SPTR = *ptrptr;\n200\t    let nameptr: PCRE2_SPTR = ptr;\n201\t\n202\t    if ptr >= ptrend {\n203\t        /* No characters in name */\n204\t        *ptrptr = ptr;\n205\t        return FALSE;\n206\t    }\n207\t\n208\t    /* We do not need to check whether the name starts with a non-digit.\n209\t    We are simply referencing names here, not defining them. */\n210\t\n211\t    if utf != FALSE {\n212\t        let mut c: u32;\n213\t        let mut typ: u32;\n214\t\n215\t        while ptr < ptrend {\n216\t            GETCHAR!(c, ptr);\n217\t            typ = UCD_CHARTYPE(c);\n218\t            if typ != ucp_Nd\n219\t                && *_pcre2_ucp_gentype_8.as_ptr().add(typ as usize) as u32 != ucp_L\n220\t                && c != CHAR_UNDERSCORE\n221\t            {\n222\t                break;\n223\t            }\n224\t            ptr = ptr.add(1);\n225\t            FORWARDCHARTEST!(ptr, ptrend);\n226\t        }\n227\t    } else {\n228\t        /* Handle group names in non-UTF modes. */\n229\t        while ptr < ptrend\n230\t            && MAX_255(*ptr as u32)\n231\t            && (*ctypes.add(*ptr as usize) & ctype_word) != 0\n232\t        {\n233\t            ptr = ptr.add(1);\n234\t        }\n235\t    }\n236\t\n237\t    /* Check name length */\n238\t    if ptr.offset_from(nameptr) > MAX_NAME_SIZE as isize {\n239\t        *ptrptr = ptr;\n240\t        return FALSE;\n241\t    }\n242\t\n243\t    /* Subpattern names must not be empty */\n244\t    if ptr == nameptr {\n245\t        *ptrptr = ptr;\n246\t        return FALSE;\n247\t    }\n248\t\n249\t    *ptrptr = ptr;\n250\t    TRUE\n251\t}\n252\t\n253\t\n254\t/*************************************************\n255\t*              Case transformations              *\n256\t*************************************************/\n257\t\n258\tconst PCRE2_SUBSTITUTE_CASE_NONE: c_int = 0;\n259\t// 1, 2, 3 are PCRE2_SUBSTITUTE_CASE_LOWER, UPPER, TITLE_FIRST.\n260\tconst PCRE2_SUBSTITUTE_CASE_REVERSE_TITLE_FIRST: c_int = 4;\n261\t\n262\t#[derive(Clone, Copy)]\n263\tstruct case_state {\n264\t    to_case: c_int, /* One of PCRE2_SUBSTITUTE_CASE_xyz */\n265\t    single_char: BOOL,\n266\t}\n267\t\n268\t/* Helper to guess how much a string is likely to increase in size when\n269\tcase-transformed. Usually, strings don't change size at all, but some rare\n270\tcharacters do grow. Estimate +10%, plus another few characters. */\n271\t\n272\tfn pessimistic_case_inflation(len: PCRE2_SIZE) -> PCRE2_SIZE {\n273\t    (len >> 3u32) + 10\n274\t}\n275\t\n276\t/* Case transformation behaviour if no callout is passed. */\n277\t\n278\tunsafe fn default_substitute_case_callout(\n279\t    mut input: PCRE2_SPTR,\n280\t    input_len: PCRE2_SIZE,\n281\t    mut output: *mut PCRE2_UCHAR,\n282\t    mut output_cap: PCRE2_SIZE,\n283\t    state: *mut case_state,\n284\t    code: *const pcre2_code,\n285\t) -> PCRE2_SIZE {\n286\t    let input_end: PCRE2_SPTR = input.add(input_len);\n287\t    let utf: BOOL;\n288\t    let ucp: BOOL;\n289\t    let mut temp: [PCRE2_UCHAR; 6] = [0; 6];\n290\t    let mut next_to_upper: BOOL;\n291\t    let rest_to_upper: BOOL;\n292\t    let single_char: BOOL;\n293\t    let mut overflow: BOOL = FALSE;\n294\t    let mut written: PCRE2_SIZE = 0;\n295\t\n296\t    utf = ((*code).overall_options & PCRE2_UTF != 0) as BOOL;\n297\t    ucp = ((*code).overall_options & PCRE2_UCP != 0) as BOOL;\n298\t\n299\t    if input_len == 0 {\n300\t        return 0;\n301\t    }\n302\t\n303\t    match (*state).to_case {\n304\t        PCRE2_SUBSTITUTE_CASE_LOWER | PCRE2_SUBSTITUTE_CASE_UPPER => {\n305\t            // LOWER can be single_char TRUE or FALSE; UPPER only single_char FALSE\n306\t            next_to_upper = ((*state).to_case == PCRE2_SUBSTITUTE_CASE_UPPER) as BOOL;\n307\t            rest_to_upper = next_to_upper;\n308\t        }\n309\t        PCRE2_SUBSTITUTE_CASE_TITLE_FIRST => {\n310\t            next_to_upper = TRUE;\n311\t            rest_to_upper = FALSE;\n312\t            (*state).to_case = PCRE2_SUBSTITUTE_CASE_LOWER;\n313\t        }\n314\t        PCRE2_SUBSTITUTE_CASE_REVERSE_TITLE_FIRST => {\n315\t            next_to_upper = FALSE;\n316\t            rest_to_upper = TRUE;\n317\t            (*state).to_case = PCRE2_SUBSTITUTE_CASE_UPPER;\n318\t        }\n319\t        _ => {\n320\t            /* LCOV_EXCL_START */\n321\t            return 0;\n322\t            /* LCOV_EXCL_STOP */\n323\t        }\n324\t    }\n325\t\n326\t    single_char = (*state).single_char;\n327\t    if single_char != FALSE {\n328\t        (*state).to_case = PCRE2_SUBSTITUTE_CASE_NONE;\n329\t    }\n330\t\n331\t    while input < input_end {\n332\t        let mut ch: u32;\n333\t        let chlen: u32;\n334\t\n335\t        // GETCHARINCTEST(ch, input)\n336\t        if utf != FALSE {\n337\t            let (v, n) = GETCHARINC(input);\n338\t            ch = v;\n339\t            input = input.add(n);\n340\t        } else {\n341\t            ch = *input as u32;\n342\t            input = input.add(1);\n343\t        }\n344\t\n345\t        if (utf != FALSE || ucp != FALSE) && ch >= 128 {\n346\t            let typ: u32 = UCD_CHARTYPE(ch);\n347\t            if *_pcre2_ucp_gentype_8.as_ptr().add(typ as usize) as u32 == ucp_L\n348\t                && typ != (if next_to_upper != FALSE { ucp_Lu } else { ucp_Ll })\n349\t            {\n350\t                ch = UCD_OTHERCASE(ch);\n351\t            }\n352\t        } else if MAX_255(ch) {\n353\t            if (*((*code).tables.add(\n354\t                cbits_offset + (if next_to_upper != FALSE { cbit_upper } else { cbit_lower }),\n355\t            ).add((ch / 8) as usize))\n356\t                & (1u8 << (ch % 8)))\n357\t                == 0\n358\t            {\n359\t                ch = *(*code).tables.add(fcc_offset).add(ch as usize) as u32;\n360\t            }\n361\t        }\n362\t\n363\t        if utf != FALSE {\n364\t            chlen = crate::pcre2_ord2utf::_pcre2_ord2utf_8(ch, temp.as_mut_ptr());\n365\t        } else {\n366\t            temp[0] = ch as PCRE2_UCHAR;\n367\t            chlen = 1;\n368\t        }\n369\t\n370\t        if overflow == FALSE && chlen as PCRE2_SIZE <= output_cap {\n371\t            memcpy(\n372\t                output as *mut c_void,\n373\t                temp.as_ptr() as *const c_void,\n374\t                CU2BYTES(chlen as usize),\n375\t            );\n376\t            output = output.add(chlen as usize);\n377\t            output_cap -= chlen as PCRE2_SIZE;\n378\t        } else {\n379\t            overflow = TRUE;\n380\t        }\n381\t\n382\t        if chlen as PCRE2_SIZE > !(0 as PCRE2_SIZE) - written {\n383\t            /* Integer overflow */\n384\t            return !(0 as PCRE2_SIZE);\n385\t        }\n386\t        written += chlen as PCRE2_SIZE;\n387\t\n388\t        next_to_upper = rest_to_upper;\n389\t\n390\t        /* memcpy the remainder, if only transforming a single character. */\n391\t        if single_char != FALSE {\n392\t            let rest_len: PCRE2_SIZE = input_end.offset_from(input) as PCRE2_SIZE;\n393\t\n394\t            if overflow == FALSE && rest_len <= output_cap {\n395\t                memcpy(\n396\t                    output as *mut c_void,\n397\t                    input as *const c_void,\n398\t                    CU2BYTES(rest_len),\n399\t                );\n400\t            }\n401\t\n402\t            if rest_len > !(0 as PCRE2_SIZE) - written {\n403\t                /* Integer overflow */\n404\t                return !(0 as PCRE2_SIZE);\n405\t            }\n406\t            written += rest_len;\n407\t\n408\t            return written;\n409\t        }\n410\t    }\n411\t\n412\t    written\n413\t}\n414\t\n415\t/* Helper to perform the call to the substitute_case_callout. We wrap the\n416\tuser-provided callout because our internal arguments are slightly extended. We\n417\tdon't want the user callout to handle the case of \"\\l\" (first character only to\n418\tlowercase) or \"\\l\\U\" (first character to lowercase, rest to uppercase) because\n419\tthose are not operations defined by Unicode. Instead the user callout simply\n420\tneeds to provide the three Unicode primitives: lower, upper, titlecase. */\n421\t\n422\tunsafe fn do_case_copy(\n423\t    input_output: *mut PCRE2_UCHAR,\n424\t    input_len: PCRE2_SIZE,\n425\t    output_cap: PCRE2_SIZE,\n426\t    state: *mut case_state,\n427\t    utf: BOOL,\n428\t    substitute_case_callout: SubstCaseCalloutFn,\n429\t    substitute_case_callout_data: *mut c_void,\n430\t) -> PCRE2_SIZE {\n431\t    let input: PCRE2_SPTR = input_output;\n432\t    let output: *mut PCRE2_UCHAR = input_output;\n433\t    let mut rc: PCRE2_SIZE;\n434\t    let mut rc2: PCRE2_SIZE;\n435\t    let ch1_to_case: c_int;\n436\t    let rest_to_case: c_int;\n437\t    let mut ch1: [PCRE2_UCHAR; 6] = [0; 6];\n438\t    let ch1_len: PCRE2_SIZE;\n439\t    let mut rest: PCRE2_SPTR;\n440\t    let rest_len: PCRE2_SIZE;\n441\t    let mut ch1_overflow: BOOL = FALSE;\n442\t    let mut rest_overflow: BOOL = FALSE;\n443\t\n444\t    let _ = utf;\n445\t\n446\t    let callout = substitute_case_callout.unwrap();\n447\t\n448\t    match (*state).to_case {\n449\t        PCRE2_SUBSTITUTE_CASE_LOWER\n450\t        | PCRE2_SUBSTITUTE_CASE_UPPER\n451\t        | PCRE2_SUBSTITUTE_CASE_TITLE_FIRST => {\n452\t            /* The easy case, where our internal casing operations align with those of\n453\t            the callout. */\n454\t            if (*state).single_char == FALSE {\n455\t                rc = callout(\n456\t                    input,\n457\t                    input_len,\n458\t                    output,\n459\t                    output_cap,\n460\t                    (*state).to_case,\n461\t                    substitute_case_callout_data,\n462\t                );\n463\t\n464\t                if (*state).to_case == PCRE2_SUBSTITUTE_CASE_TITLE_FIRST {\n465\t                    (*state).to_case = PCRE2_SUBSTITUTE_CASE_LOWER;\n466\t                }\n467\t\n468\t                return rc;\n469\t            }\n470\t\n471\t            ch1_to_case = (*state).to_case;\n472\t            rest_to_case = PCRE2_SUBSTITUTE_CASE_NONE;\n473\t        }\n474\t        PCRE2_SUBSTITUTE_CASE_REVERSE_TITLE_FIRST => {\n475\t            ch1_to_case = PCRE2_SUBSTITUTE_CASE_LOWER;\n476\t            rest_to_case = PCRE2_SUBSTITUTE_CASE_UPPER;\n477\t        }\n478\t        _ => {\n479\t            /* LCOV_EXCL_START */\n480\t            return 0;\n481\t            /* LCOV_EXCL_STOP */\n482\t        }\n483\t    }\n484\t\n485\t    /* Identify the leading character. Take copy, because its storage overlaps with\n486\t    `output`, and hence may be scrambled by the callout. */\n487\t    {\n488\t        let mut ch_end: PCRE2_SPTR = input;\n489\t\n490\t        // GETCHARINCTEST(ch, ch_end)\n491\t        if utf != FALSE {\n492\t            let (_v, n) = GETCHARINC(ch_end);\n493\t            ch_end = ch_end.add(n);\n494\t        } else {\n495\t            ch_end = ch_end.add(1);\n496\t        }\n497\t        ch1_len = ch_end.offset_from(input) as PCRE2_SIZE;\n498\t        memcpy(\n499\t            ch1.as_mut_ptr() as *mut c_void,\n500\t            input as *const c_void,\n501\t            CU2BYTES(ch1_len),\n502\t        );\n503\t    }\n504\t\n505\t    rest = input.add(ch1_len);\n506\t    rest_len = input_len - ch1_len;\n507\t\n508\t    /* Transform just ch1. The buffers are always in-place (input == output). */\n509\t    {\n510\t        let mut ch1_cap: PCRE2_SIZE;\n511\t        let max_ch1_cap: PCRE2_SIZE;\n512\t\n513\t        ch1_cap = ch1_len; /* First attempt uses the space vacated by ch1. */\n514\t        max_ch1_cap = output_cap - rest_len;\n515\t\n516\t        loop {\n517\t            rc = callout(\n518\t                ch1.as_ptr(),\n519\t                ch1_len,\n520\t                output,\n521\t                ch1_cap,\n522\t                ch1_to_case,\n523\t                substitute_case_callout_data,\n524\t            );\n525\t            if rc == !(0 as PCRE2_SIZE) {\n526\t                return rc;\n527\t            }\n528\t\n529\t            if rc <= ch1_cap {\n530\t                break;\n531\t            }\n532\t\n533\t            if rc > max_ch1_cap {\n534\t                ch1_overflow = TRUE;\n535\t                break;\n536\t            }\n537\t\n538\t            /* Move the rest to the right, to make room for expanding ch1. */\n539\t            memmove(\n540\t                input_output.add(rc) as *mut c_void,\n541\t                rest as *const c_void,\n542\t                CU2BYTES(rest_len),\n543\t            );\n544\t            rest = input.add(rc);\n545\t\n546\t            ch1_cap = rc;\n547\t\n548\t            /* Proof of loop termination: `ch1_cap` is growing on each iteration, but\n549\t            the loop ends if `rc` reaches the (unchanging) upper bound of output_cap. */\n550\t        }\n551\t    }\n552\t\n553\t    if rest_to_case == PCRE2_SUBSTITUTE_CASE_NONE {\n554\t        if ch1_overflow == FALSE {\n555\t            memmove(\n556\t                output.add(rc) as *mut c_void,\n557\t                rest as *const c_void,\n558\t                CU2BYTES(rest_len),\n559\t            );\n560\t        }\n561\t        rc2 = rest_len;\n562\t\n563\t        (*state).to_case = PCRE2_SUBSTITUTE_CASE_NONE;\n564\t    } else {\n565\t        let mut dummy: [PCRE2_UCHAR; 1] = [0; 1];\n566\t\n567\t        rc2 = callout(\n568\t            rest,\n569\t            rest_len,\n570\t            if ch1_overflow != FALSE {\n571\t                dummy.as_mut_ptr()\n572\t            } else {\n573\t                output.add(rc)\n574\t            },\n575\t            if ch1_overflow != FALSE {\n576\t                0 as PCRE2_SIZE\n577\t            } else {\n578\t                output_cap - rc\n579\t            },\n580\t            rest_to_case,\n581\t            substitute_case_callout_data,\n582\t        );\n583\t        if rc2 == !(0 as PCRE2_SIZE) {\n584\t            return rc2;\n585\t        }\n586\t\n587\t        if ch1_overflow == FALSE && rc2 > output_cap - rc {\n588\t            rest_overflow = TRUE;\n589\t        }\n590\t\n591\t        /* If ch1 grows so that `xform(ch1)+rest` can't fit in the buffer, but then\n592\t        `rest` shrinks, it's actually possible for the total calculated length of\n593\t        `xform(ch1)+xform(rest)` to come out at less than output_cap. But we can't\n594\t      