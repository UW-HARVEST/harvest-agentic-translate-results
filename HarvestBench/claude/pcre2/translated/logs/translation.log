 ucp_Katakana: u32 = 28;\n504\tpub const ucp_Bopomofo: u32 = 29;\n505\tpub const ucp_Han: u32 = 30;\n506\tpub const ucp_Unknown: u32 = 99;\n507\tpub const ucp_Common: u32 = 100;\n508\tpub const ucp_Inherited: u32 = 107;\n509\tpub const ucp_Script_Count: u32 = 175;\n510\t\n511\t// MAPBIT/MAPSET helpers over u32 bitmap slices\n512\t#[inline]\n513\tpub fn MAPBIT(map: &[u32], n: u32) -> u32 { map[(n / 32) as usize] & (1u32 << (n % 32)) }\n514\t#[inline]\n515\tpub fn MAPSET(map: &mut [u32], n: u32) { map[(n / 32) as usize] |= 1u32 << (n % 32); }\n516\t\n517\t#[inline]\n518\tpub fn UCD_SCRIPTX_PROP(p: &UcdRecord) -> u32 { (p.scriptx_bidiclass & UCD_SCRIPTX_MASK) as u32 }\n519\t#[inline]\n520\tpub fn UCD_BPROPS_PROP(p: &UcdRecord) -> u32 { (p.bprops & UCD_BPROPS_MASK) as u32 }\n521\t#[inline]\n522\tpub fn UCD_BIDICLASS_PROP(p: &UcdRecord) -> u32 { (p.scriptx_bidiclass >> UCD_BIDICLASS_SHIFT) as u32 }\n523\t\n524\tpub const ucp_bidiL: u16 = 9;\n525\t\n526\t// ---------- Character constants (ASCII/UTF-8) ----------\n527\tpub const CHAR_NUL: u32 = 0;\n528\tpub const CHAR_HT: u32 = 0x09;\n529\tpub const CHAR_LF: u32 = 0x0a;\n530\tpub const CHAR_NL: u32 = 0x0a;\n531\tpub const CHAR_VT: u32 = 0x0b;\n532\tpub const CHAR_FF: u32 = 0x0c;\n533\tpub const CHAR_CR: u32 = 0x0d;\n534\tpub const CHAR_NEL: u32 = 0x85;\n535\tpub const CHAR_BS: u32 = 0x08;\n536\tpub const CHAR_BEL: u32 = 0x07;\n537\tpub const CHAR_ESC: u32 = 0x1b;\n538\tpub const CHAR_DEL: u32 = 0x7f;\n539\tpub const CHAR_SPACE: u32 = 0x20;\n540\tpub const CHAR_NBSP: u32 = 0xa0;\n541\tpub const CHAR_EXCLAMATION_MARK: u32 = 0x21;\n542\tpub const CHAR_QUOTATION_MARK: u32 = 0x22;\n543\tpub const CHAR_NUMBER_SIGN: u32 = 0x23;\n544\tpub const CHAR_DOLLAR_SIGN: u32 = 0x24;\n545\tpub const CHAR_PERCENT_SIGN: u32 = 0x25;\n546\tpub const CHAR_AMPERSAND: u32 = 0x26;\n547\tpub const CHAR_APOSTROPHE: u32 = 0x27;\n548\tpub const CHAR_LEFT_PARENTHESIS: u32 = 0x28;\n549\tpub const CHAR_RIGHT_PARENTHESIS: u32 = 0x29;\n550\tpub const CHAR_ASTERISK: u32 = 0x2a;\n551\tpub const CHAR_PLUS: u32 = 0x2b;\n552\tpub const CHAR_COMMA: u32 = 0x2c;\n553\tpub const CHAR_MINUS: u32 = 0x2d;\n554\tpub const CHAR_DOT: u32 = 0x2e;\n555\tpub const CHAR_SLASH: u32 = 0x2f;\n556\tpub const CHAR_0: u32 = 0x30;\n557\tpub const CHAR_1: u32 = 0x31;\n558\tpub const CHAR_2: u32 = 0x32;\n559\tpub const CHAR_3: u32 = 0x33;\n560\tpub const CHAR_4: u32 = 0x34;\n561\tpub const CHAR_5: u32 = 0x35;\n562\tpub const CHAR_6: u32 = 0x36;\n563\tpub const CHAR_7: u32 = 0x37;\n564\tpub const CHAR_8: u32 = 0x38;\n565\tpub const CHAR_9: u32 = 0x39;\n566\tpub const CHAR_COLON: u32 = 0x3a;\n567\tpub const CHAR_SEMICOLON: u32 = 0x3b;\n568\tpub const CHAR_LESS_THAN_SIGN: u32 = 0x3c;\n569\tpub const CHAR_EQUALS_SIGN: u32 = 0x3d;\n570\tpub const CHAR_GREATER_THAN_SIGN: u32 = 0x3e;\n571\tpub const CHAR_QUESTION_MARK: u32 = 0x3f;\n572\tpub const CHAR_COMMERCIAL_AT: u32 = 0x40;\n573\tpub const CHAR_A: u32 = 0x41;\n574\tpub const CHAR_B: u32 = 0x42;\n575\tpub const CHAR_C: u32 = 0x43;\n576\tpub const CHAR_D: u32 = 0x44;\n577\tpub const CHAR_E: u32 = 0x45;\n578\tpub const CHAR_F: u32 = 0x46;\n579\tpub const CHAR_G: u32 = 0x47;\n580\tpub const CHAR_H: u32 = 0x48;\n581\tpub const CHAR_I: u32 = 0x49;\n582\tpub const CHAR_J: u32 = 0x4a;\n583\tpub const CHAR_K: u32 = 0x4b;\n584\tpub const CHAR_L: u32 = 0x4c;\n585\tpub const CHAR_M: u32 = 0x4d;\n586\tpub const CHAR_N: u32 = 0x4e;\n587\tpub const CHAR_O: u32 = 0x4f;\n588\tpub const CHAR_P: u32 = 0x50;\n589\tpub const CHAR_Q: u32 = 0x51;\n590\tpub const CHAR_R: u32 = 0x52;\n591\tpub const CHAR_S: u32 = 0x53;\n592\tpub const CHAR_T: u32 = 0x54;\n593\tpub const CHAR_U: u32 = 0x55;\n594\tpub const CHAR_V: u32 = 0x56;\n595\tpub const CHAR_W: u32 = 0x57;\n596\tpub const CHAR_X: u32 = 0x58;\n597\tpub const CHAR_Y: u32 = 0x59;\n598\tpub const CHAR_Z: u32 = 0x5a;\n599\tpub const CHAR_LEFT_SQUARE_BRACKET: u32 = 0x5b;\n600\tpub const CHAR_BACKSLASH: u32 = 0x5c;\n601\tpub const CHAR_RIGHT_SQUARE_BRACKET: u32 = 0x5d;\n602\tpub const CHAR_CIRCUMFLEX_ACCENT: u32 = 0x5e;\n603\tpub const CHAR_UNDERSCORE: u32 = 0x5f;\n604\tpub const CHAR_GRAVE_ACCENT: u32 = 0x60;\n605\tpub const CHAR_a: u32 = 0x61;\n606\tpub const CHAR_b: u32 = 0x62;\n607\tpub const CHAR_c: u32 = 0x63;\n608\tpub const CHAR_d: u32 = 0x64;\n609\tpub const CHAR_e: u32 = 0x65;\n610\tpub const CHAR_f: u32 = 0x66;\n611\tpub const CHAR_g: u32 = 0x67;\n612\tpub const CHAR_h: u32 = 0x68;\n613\tpub const CHAR_i: u32 = 0x69;\n614\tpub const CHAR_j: u32 = 0x6a;\n615\tpub const CHAR_k: u32 = 0x6b;\n616\tpub const CHAR_l: u32 = 0x6c;\n617\tpub const CHAR_m: u32 = 0x6d;\n618\tpub const CHAR_n: u32 = 0x6e;\n619\tpub const CHAR_o: u32 = 0x6f;\n620\tpub const CHAR_p: u32 = 0x70;\n621\tpub const CHAR_q: u32 = 0x71;\n622\tpub const CHAR_r: u32 = 0x72;\n623\tpub const CHAR_s: u32 = 0x73;\n624\tpub const CHAR_t: u32 = 0x74;\n625\tpub const CHAR_u: u32 = 0x75;\n626\tpub const CHAR_v: u32 = 0x76;\n627\tpub const CHAR_w: u32 = 0x77;\n628\tpub const CHAR_x: u32 = 0x78;\n629\tpub const CHAR_y: u32 = 0x79;\n630\tpub const CHAR_z: u32 = 0x7a;\n631\tpub const CHAR_LEFT_CURLY_BRACKET: u32 = 0x7b;\n632\tpub const CHAR_VERTICAL_LINE: u32 = 0x7c;\n633\tpub const CHAR_RIGHT_CURLY_BRACKET: u32 = 0x7d;\n634\tpub const CHAR_TILDE: u32 = 0x7e;\n635\t\n636\t// ---------- repr(C) data-table element structs ----------\n637\t#[repr(C)]\n638\t#[derive(Clone, Copy)]\n639\tpub struct UcdRecord {\n640\t    pub script: u8,\n641\t    pub chartype: u8,\n642\t    pub gbprop: u8,\n643\t    pub caseset: u8,\n644\t    pub other_case: i32,\n645\t    pub scriptx_bidiclass: u16,\n646\t    pub bprops: u16,\n647\t}\n648\t\n649\t#[repr(C)]\n650\t#[derive(Clone, Copy)]\n651\tpub struct UcpTypeTable {\n652\t    pub name_offset: u16,\n653\t    pub type_: u16,\n654\t    pub value: u16,\n655\t}\n656\t\n657\t// ---------- Memory control ----------\n658\tpub type MallocFn = Option<unsafe extern \"C\" fn(usize, *mut c_void) -> *mut c_void>;\n659\tpub type FreeFn = Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void)>;\n660\t\n661\t#[repr(C)]\n662\t#[derive(Clone, Copy)]\n663\tpub struct pcre2_memctl {\n664\t    pub malloc: MallocFn,\n665\t    pub free: FreeFn,\n666\t    pub memory_data: *mut c_void,\n667\t}\n668\t\n669\t// ---------- Public callback types ----------\n670\tpub type JitCallback = Option<unsafe extern \"C\" fn(*mut c_void) -> *mut c_void>;\n671\tpub type CalloutFn = Option<unsafe extern \"C\" fn(*mut pcre2_callout_block, *mut c_void) -> c_int>;\n672\tpub type SubstCalloutFn =\n673\t    Option<unsafe extern \"C\" fn(*mut pcre2_substitute_callout_block, *mut c_void) -> c_int>;\n674\tpub type SubstCaseCalloutFn = Option<\n675\t    unsafe extern \"C\" fn(PCRE2_SPTR, PCRE2_SIZE, *mut PCRE2_UCHAR, PCRE2_SIZE, c_int, *mut c_void) -> PCRE2_SIZE,\n676\t>;\n677\tpub type StackGuardFn = Option<unsafe extern \"C\" fn(u32, *mut c_void) -> c_int>;\n678\t\n679\t// ---------- Public callout block structures ----------\n680\t#[repr(C)]\n681\tpub struct pcre2_callout_block {\n682\t    pub version: u32,\n683\t    pub callout_number: u32,\n684\t    pub capture_top: u32,\n685\t    pub capture_last: u32,\n686\t    pub offset_vector: *mut PCRE2_SIZE,\n687\t    pub mark: PCRE2_SPTR,\n688\t    pub subject: PCRE2_SPTR,\n689\t    pub subject_length: PCRE2_SIZE,\n690\t    pub start_match: PCRE2_SIZE,\n691\t    pub current_position: PCRE2_SIZE,\n692\t    pub pattern_position: PCRE2_SIZE,\n693\t    pub next_item_length: PCRE2_SIZE,\n694\t    pub callout_string_offset: PCRE2_SIZE,\n695\t    pub callout_string_length: PCRE2_SIZE,\n696\t    pub callout_string: PCRE2_SPTR,\n697\t    pub callout_flags: u32,\n698\t}\n699\t\n700\t#[repr(C)]\n701\tpub struct pcre2_callout_enumerate_block {\n702\t    pub version: u32,\n703\t    pub pattern_position: PCRE2_SIZE,\n704\t    pub next_item_length: PCRE2_SIZE,\n705\t    pub callout_number: u32,\n706\t    pub callout_string_offset: PCRE2_SIZE,\n707\t    pub callout_string_length: PCRE2_SIZE,\n708\t    pub callout_string: PCRE2_SPTR,\n709\t}\n710\t\n711\t#[repr(C)]\n712\tpub struct pcre2_substitute_callout_block {\n713\t    pub version: u32,\n714\t    pub input: PCRE2_SPTR,\n715\t    pub output: PCRE2_SPTR,\n716\t    pub output_offsets: [PCRE2_SIZE; 2],\n717\t    pub ovector: *mut PCRE2_SIZE,\n718\t    pub oveccount: u32,\n719\t    pub subscount: u32,\n720\t}\n721\t\n722\t// ---------- Hidden context structures ----------\n723\t#[repr(C)]\n724\t#[derive(Clone, Copy)]\n725\tpub struct pcre2_real_general_context {\n726\t    pub memctl: pcre2_memctl,\n727\t}\n728\t\n729\t#[repr(C)]\n730\t#[derive(Clone, Copy)]\n731\tpub struct pcre2_real_compile_context {\n732\t    pub memctl: pcre2_memctl,\n733\t    pub stack_guard: StackGuardFn,\n734\t    pub stack_guard_data: *mut c_void,\n735\t    pub tables: *const u8,\n736\t    pub max_pattern_length: PCRE2_SIZE,\n737\t    pub max_pattern_compiled_length: PCRE2_SIZE,\n738\t    pub bsr_convention: u16,\n739\t    pub newline_convention: u16,\n740\t    pub parens_nest_limit: u32,\n741\t    pub extra_options: u32,\n742\t    pub max_varlookbehind: u32,\n743\t    pub optimization_flags: u32,\n744\t}\n745\t\n746\t#[repr(C)]\n747\t#[derive(Clone, Copy)]\n748\tpub struct pcre2_real_match_context {\n749\t    pub memctl: pcre2_memctl,\n750\t    // SUPPORT_JIT is not defined, so no jit_callback fields.\n751\t    pub callout: CalloutFn,\n752\t    pub callout_data: *mut c_void,\n753\t    pub substitute_callout: SubstCalloutFn,\n754\t    pub substitute_callout_data: *mut c_void,\n755\t    pub substitute_case_callout: SubstCaseCalloutFn,\n756\t    pub substitute_case_callout_data: *mut c_void,\n757\t    pub offset_limit: PCRE2_SIZE,\n758\t    pub heap_limit: u32,\n759\t    pub match_limit: u32,\n760\t    pub depth_limit: u32,\n761\t}\n762\t\n763\t#[repr(C)]\n764\t#[derive(Clone, Copy)]\n765\tpub struct pcre2_real_convert_context {\n766\t    pub memctl: pcre2_memctl,\n767\t    pub glob_separator: u32,\n768\t    pub glob_escape: u32,\n769\t}\n770\t\n771\t#[repr(C)]\n772\tpub struct pcre2_real_code {\n773\t    pub memctl: pcre2_memctl,\n774\t    pub tables: *const u8,\n775\t    pub executable_jit: *mut c_void,\n776\t    pub start_bitmap: [u8; 32],\n777\t    pub blocksize: PCRE2_SIZE,\n778\t    pub code_start: PCRE2_SIZE,\n779\t    pub magic_number: u32,\n780\t    pub compile_options: u32,\n781\t    pub overall_options: u32,\n782\t    pub extra_options: u32,\n783\t    pub flags: u32,\n784\t    pub limit_heap: u32,\n785\t    pub limit_match: u32,\n786\t    pub limit_depth: u32,\n787\t    pub first_codeunit: u32,\n788\t    pub last_codeunit: u32,\n789\t    pub bsr_convention: u16,\n790\t    pub newline_convention: u16,\n791\t    pub max_lookbehind: u16,\n792\t    pub minlength: u16,\n793\t    pub top_bracket: u16,\n794\t    pub top_backref: u16,\n795\t    pub name_entry_size: u16,\n796\t    pub name_count: u16,\n797\t    pub optimization_flags: u32,\n798\t}\n799\t\n800\t// The match data: ovector is variable length; header up to ovector matters.\n801\t#[repr(C)]\n802\tpub struct pcre2_real_match_data {\n803\t    pub memctl: pcre2_memctl,\n804\t    pub code: *const pcre2_real_code,\n805\t    pub subject: PCRE2_SPTR,\n806\t    pub mark: PCRE2_SPTR,\n807\t    pub heapframes: *mut c_void,\n808\t    pub heapframes_size: PCRE2_SIZE,\n809\t    pub subject_length: PCRE2_SIZE,\n810\t    pub start_offset: PCRE2_SIZE,\n811\t    pub leftchar: PCRE2_SIZE,\n812\t    pub rightchar: PCRE2_SIZE,\n813\t    pub startchar: PCRE2_SIZE,\n814\t    pub matchedby: u8,\n815\t    pub flags: u8,\n816\t    pub oveccount: u16,\n817\t    pub options: u32,\n818\t    pub rc: c_int,\n819\t    pub ovector: [PCRE2_SIZE; 1], // flexible array in practice\n820\t}\n821\t\n822\t/// Offset (in bytes) of the ovector field in pcre2_real_match_data.\n823\tpub fn match_data_ovector_offset() -> usize {\n824\t    // memoffset-free: build via manual layout knowledge is error-prone; use core.\n825\t    // 12 usize-ish fields precede; compute with a dummy.\n826\t    #[repr(C)]\n827\t    struct Head {\n828\t        memctl: pcre2_memctl,\n829\t        code: *const pcre2_real_code,\n830\t        subject: PCRE2_SPTR,\n831\t        mark: PCRE2_SPTR,\n832\t        heapframes: *mut c_void,\n833\t        heapframes_size: PCRE2_SIZE,\n834\t        subject_length: PCRE2_SIZE,\n835\t        start_offset: PCRE2_SIZE,\n836\t        leftchar: PCRE2_SIZE,\n837\t        rightchar: PCRE2_SIZE,\n838\t        startchar: PCRE2_SIZE,\n839\t        matchedby: u8,\n840\t        flags: u8,\n841\t        oveccount: u16,\n842\t        options: u32,\n843\t        rc: c_int,\n844\t    }\n845\t    // ovector must be 8-aligned; the C struct places ovector right after rc with\n846\t    // padding to PCRE2_SIZE alignment.\n847\t    let base = core::mem::size_of::<Head>();\n848\t    let align = core::mem::align_of::<PCRE2_SIZE>();\n849\t    (base + align - 1) & !(align - 1)\n850\t}\n851\t\n852\tpub type pcre2_general_context = pcre2_real_general_context;\n853\tpub type pcre2_compile_context = pcre2_real_compile_context;\n854\tpub type pcre2_match_context = pcre2_real_match_context;\n855\tpub type pcre2_convert_context = pcre2_real_convert_context;\n856\tpub type pcre2_code = pcre2_real_code;\n857\tpub type pcre2_match_data = pcre2_real_match_data;\n858\t\n859\t#[repr(C)]\n860\tpub struct pcre2_real_jit_stack {\n861\t    pub memctl: pcre2_memctl,\n862\t    pub stack: *mut c_void,\n863\t}\n864\t\n865\t// ---------- Serialized header ----------\n866\t#[repr(C)]\n867\tpub struct pcre2_serialized_data {\n868\t    pub magic: u32,\n869\t    pub version: u32,\n870\t    pub config: u32,\n871\t    pub number_of_codes: i32,\n872\t}\n873\t\n874\t// ---------- small compile helper structs ----------\n875\t#[repr(C)]\n876\tpub struct open_capitem {\n877\t    pub next: *mut open_capitem,\n878\t    pub number: u16,\n879\t    pub assert_depth: u16,\n880\t}\n881\t\n882\t#[repr(C)]\n883\tpub struct named_group {\n884\t    pub name: PCRE2_SPTR,\n885\t    pub number: u32,\n886\t    pub length: u16,\n887\t    pub hash_dup: u16,\n888\t}\n889\t\n890\t// ---------- Private compile structures ----------\n891\t#[repr(C)]\n892\tpub struct recurse_check {\n893\t    pub prev: *mut recurse_check,\n894\t    pub group: PCRE2_SPTR,\n895\t}\n896\t\n897\t#[repr(C)]\n898\tpub struct parsed_recurse_check {\n899\t    pub prev: *mut parsed_recurse_check,\n900\t    pub groupptr: *mut u32,\n901\t}\n902\t\n903\t#[repr(C)]\n904\tpub struct recurse_cache {\n905\t    pub group: PCRE2_SPTR,\n906\t    pub groupnumber: c_int,\n907\t}\n908\t\n909\t#[repr(C)]\n910\tpub struct branch_chain {\n911\t    pub outer: *mut branch_chain,\n912\t    pub current_branch: *mut PCRE2_UCHAR,\n913\t}\n914\t\n915\t#[repr(C)]\n916\tpub struct compile_data {\n917\t    pub next: *mut compile_data,\n918\t}\n919\t\n920\t#[repr(C)]\n921\tpub struct class_ranges {\n922\t    pub header: compile_data,\n923\t    pub char_lists_size: usize,\n924\t    pub char_lists_start: usize,\n925\t    pub range_list_size: u16,\n926\t    pub char_lists_types: u16,\n927\t}\n928\t\n929\t#[repr(C)]\n930\tpub struct recurse_arguments {\n931\t    pub header: compile_data,\n932\t    pub size: usize,\n933\t    pub skip_size: usize,\n934\t}\n935\t\n936\t#[repr(C)]\n937\tpub union class_bits_storage {\n938\t    pub classbits: [u8; 32],\n939\t    pub classwords: [u32; 8],\n940\t}\n941\t\n942\t#[repr(C)]\n943\tpub struct compile_block {\n944\t    pub cx: *mut pcre2_real_compile_context,\n945\t    pub lcc: *const u8,\n946\t    pub fcc: *const u8,\n947\t    pub cbits: *const u8,\n948\t    pub ctypes: *const u8,\n949\t    pub start_workspace: *mut PCRE2_UCHAR,\n950\t    pub start_code: *mut PCRE2_UCHAR,\n951\t    pub start_pattern: PCRE2_SPTR,\n952\t    pub end_pattern: PCRE2_SPTR,\n953\t    pub name_table: *mut PCRE2_UCHAR,\n954\t    pub workspace_size: PCRE2_SIZE,\n955\t    pub small_ref_offset: [PCRE2_SIZE; 10],\n956\t    pub erroroffset: PCRE2_SIZE,\n957\t    pub classbits: class_bits_storage,\n958\t    pub names_found: u16,\n959\t    pub n