         /* If group is still negative, it means we did not find a group\n1394\t            that is in the ovector. Just set the first group. */\n1395\t\n1396\t            if (group < 0) group = GET2(first, 0);\n1397\t            }\n1398\t          }\n1399\t\n1400\t        /* We now have a group that is identified by number. Find the length of\n1401\t        the captured string. If a group in a non-special substitution is unset\n1402\t        when PCRE2_SUBSTITUTE_UNSET_EMPTY is set, substitute nothing. */\n1403\t\n1404\t        rc = pcre2_substring_length_bynumber(match_data, group, &sublength);\n1405\t        if (rc < 0)\n1406\t          {\n1407\t          if (rc == PCRE2_ERROR_NOSUBSTRING &&\n1408\t              (suboptions & PCRE2_SUBSTITUTE_UNKNOWN_UNSET) != 0)\n1409\t            {\n1410\t            rc = PCRE2_ERROR_UNSET;\n1411\t            }\n1412\t          if (rc != PCRE2_ERROR_UNSET) goto PTREXIT;  /* Non-unset errors */\n1413\t          if (special == 0)                           /* Plain substitution */\n1414\t            {\n1415\t            if ((suboptions & PCRE2_SUBSTITUTE_UNSET_EMPTY) != 0) continue;\n1416\t            goto PTREXIT;                             /* Else error */\n1417\t            }\n1418\t          }\n1419\t\n1420\t        /* If special is '+' we have a 'set' and possibly an 'unset' text,\n1421\t        both of which are reprocessed when used. If special is '-' we have a\n1422\t        default text for when the group is unset; it must be reprocessed. */\n1423\t\n1424\t        if (special != 0)\n1425\t          {\n1426\t          if (special == CHAR_MINUS)\n1427\t            {\n1428\t            if (rc == 0) goto LITERAL_SUBSTITUTE;\n1429\t            text2_start = text1_start;\n1430\t            text2_end = text1_end;\n1431\t            }\n1432\t\n1433\t          if (ptrstackptr >= PTR_STACK_SIZE) goto BAD;\n1434\t          ptrstack[ptrstackptr++] = ptr;\n1435\t          ptrstack[ptrstackptr++] = repend;\n1436\t\n1437\t          if (rc == 0)\n1438\t            {\n1439\t            ptr = text1_start;\n1440\t            repend = text1_end;\n1441\t            }\n1442\t          else\n1443\t            {\n1444\t            ptr = text2_start;\n1445\t            repend = text2_end;\n1446\t            }\n1447\t          continue;\n1448\t          }\n1449\t\n1450\t        /* Otherwise we have a literal substitution of a group's contents. */\n1451\t\n1452\t        LITERAL_SUBSTITUTE:\n1453\t        subptr = subject + ovector[group*2];\n1454\t        subptrend = subject + ovector[group*2 + 1];\n1455\t\n1456\t        /* Substitute a literal string, possibly forcing alphabetic case. */\n1457\t\n1458\t        SUBPTR_SUBSTITUTE:\n1459\t        if (forcecase.to_case != PCRE2_SUBSTITUTE_CASE_NONE &&\n1460\t            substitute_case_callout == NULL)\n1461\t          CHECKCASECPY_DEFAULT(subptr, subptrend - subptr);\n1462\t        else\n1463\t          CHECKMEMCPY(subptr, subptrend - subptr);\n1464\t        }\n1465\t      }   /* End of $ processing */\n1466\t\n1467\t    /* Handle an escape sequence in extended mode. We can use check_escape()\n1468\t    to process \\Q, \\E, \\c, \\o, \\x and \\ followed by non-alphanumerics, but\n1469\t    the case-forcing escapes are not supported in pcre2_compile() so must be\n1470\t    recognized here. */\n1471\t\n1472\t    else if ((suboptions & PCRE2_SUBSTITUTE_EXTENDED) != 0 &&\n1473\t              *ptr == CHAR_BACKSLASH)\n1474\t      {\n1475\t      int errorcode;\n1476\t      case_state new_forcecase = { PCRE2_SUBSTITUTE_CASE_NONE, FALSE };\n1477\t\n1478\t      if (ptr < repend - 1) switch (ptr[1])\n1479\t        {\n1480\t        case CHAR_L:\n1481\t        new_forcecase.to_case = PCRE2_SUBSTITUTE_CASE_LOWER;\n1482\t        new_forcecase.single_char = FALSE;\n1483\t        ptr += 2;\n1484\t        break;\n1485\t\n1486\t        case CHAR_l:\n1487\t        new_forcecase.to_case = PCRE2_SUBSTITUTE_CASE_LOWER;\n1488\t        new_forcecase.single_char = TRUE;\n1489\t        ptr += 2;\n1490\t        if (ptr + 2 < repend && ptr[0] == CHAR_BACKSLASH && ptr[1] == CHAR_U)\n1491\t          {\n1492\t          /* Perl reverse-title-casing feature for \\l\\U */\n1493\t          new_forcecase.to_case = PCRE2_SUBSTITUTE_CASE_REVERSE_TITLE_FIRST;\n1494\t          new_forcecase.single_char = FALSE;\n1495\t          ptr += 2;\n1496\t          }\n1497\t        break;\n1498\t\n1499\t        case CHAR_U:\n1500\t        new_forcecase.to_case = PCRE2_SUBSTITUTE_CASE_UPPER;\n1501\t        new_forcecase.single_char = FALSE;\n1502\t        ptr += 2;\n1503\t        break;\n1504\t\n1505\t        case CHAR_u:\n1506\t        new_forcecase.to_case = PCRE2_SUBSTITUTE_CASE_TITLE_FIRST;\n1507\t        new_forcecase.single_char = TRUE;\n1508\t        ptr += 2;\n1509\t        if (ptr + 2 < repend && ptr[0] == CHAR_BACKSLASH && ptr[1] == CHAR_L)\n1510\t          {\n1511\t          /* Perl title-casing feature for \\u\\L */\n1512\t          new_forcecase.to_case = PCRE2_SUBSTITUTE_CASE_TITLE_FIRST;\n1513\t          new_forcecase.single_char = FALSE;\n1514\t          ptr += 2;\n1515\t          }\n1516\t        break;\n1517\t\n1518\t        default:\n1519\t        break;\n1520\t        }\n1521\t\n1522\t      if (new_forcecase.to_case != PCRE2_SUBSTITUTE_CASE_NONE)\n1523\t        {\n1524\t        SETFORCECASE:\n1525\t\n1526\t        /* If the substitute_case_callout is unset, our case-forcing is done\n1527\t        immediately. If there is a callout however, then its action is delayed\n1528\t        until all the characters have been collected.\n1529\t\n1530\t        Apply the callout now, before we set the new casing mode. */\n1531\t\n1532\t        if (substitute_case_callout != NULL &&\n1533\t            forcecase.to_case != PCRE2_SUBSTITUTE_CASE_NONE)\n1534\t          DELAYEDFORCECASE();\n1535\t\n1536\t        forcecase = new_forcecase;\n1537\t        casestart_offset = buff_offset;\n1538\t        casestart_extra_needed = extra_needed;\n1539\t        continue;\n1540\t        }\n1541\t\n1542\t      ptr++;  /* Point after \\ */\n1543\t      rc = PRIV(check_escape)(&ptr, repend, &ch, &errorcode,\n1544\t        code->overall_options, code->extra_options, code->top_bracket, FALSE, NULL);\n1545\t      if (errorcode != 0) goto BADESCAPE;\n1546\t\n1547\t      switch(rc)\n1548\t        {\n1549\t        case ESC_E:\n1550\t        goto SETFORCECASE;\n1551\t\n1552\t        case ESC_Q:\n1553\t        escaped_literal = TRUE;\n1554\t        continue;\n1555\t\n1556\t        case 0:      /* Data character */\n1557\t        case ESC_b:  /* \\b is backspace in a substitution */\n1558\t        case ESC_v:  /* \\v is vertical tab in a substitution */\n1559\t\n1560\t        if (rc == ESC_b) ch = CHAR_BS;\n1561\t        if (rc == ESC_v) ch = CHAR_VT;\n1562\t\n1563\t#ifdef SUPPORT_UNICODE\n1564\t        if (utf) chlen = PRIV(ord2utf)(ch, temp); else\n1565\t#endif\n1566\t          {\n1567\t          temp[0] = ch;\n1568\t          chlen = 1;\n1569\t          }\n1570\t\n1571\t        if (forcecase.to_case != PCRE2_SUBSTITUTE_CASE_NONE &&\n1572\t            substitute_case_callout == NULL)\n1573\t          CHECKCASECPY_DEFAULT(temp, chlen);\n1574\t        else\n1575\t          CHECKMEMCPY(temp, chlen);\n1576\t        continue;\n1577\t\n1578\t        case ESC_g:\n1579\t          {\n1580\t          PCRE2_SIZE name_len;\n1581\t          PCRE2_SPTR name_start;\n1582\t\n1583\t          /* Parse the \\g<name> form (\\g<number> already handled by check_escape) */\n1584\t          if (ptr >= repend || *ptr != CHAR_LESS_THAN_SIGN)\n1585\t            goto BADESCAPE;\n1586\t          ++ptr;\n1587\t\n1588\t          name_start = ptr;\n1589\t          if (!read_name_subst(&ptr, repend, utf, code->tables + ctypes_offset))\n1590\t            goto BADESCAPE;\n1591\t          name_len = ptr - name_start;\n1592\t\n1593\t          if (ptr >= repend || *ptr != CHAR_GREATER_THAN_SIGN)\n1594\t            goto BADESCAPE;\n1595\t          ++ptr;\n1596\t\n1597\t          special = 