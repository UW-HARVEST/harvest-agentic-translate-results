E_LOWER | PCRE2_SUBSTITUTE_CASE_UPPER => {\n            // LOWER can be single_char TRUE or FALSE; UPPER only single_char FALSE\n            next_to_upper = ((*state).to_case == PCRE2_SUBSTITUTE_CASE_UPPER) as BOOL;\n            rest_to_upper = next_to_upper;\n        }\n        PCRE2_SUBSTITUTE_CASE_TITLE_FIRST => {\n            next_to_upper = TRUE;\n            rest_to_upper = FALSE;\n            (*state).to_case = PCRE2_SUBSTITUTE_CASE_LOWER;\n        }\n        PCRE2_SUBSTITUTE_CASE_REVERSE_TITLE_FIRST => {\n            next_to_upper = FALSE;\n            rest_to_upper = TRUE;\n            (*state).to_case = PCRE2_SUBSTITUTE_CASE_UPPER;\n        }\n        _ => {\n            /* LCOV_EXCL_START */\n            return 0;\n            /* LCOV_EXCL_STOP */\n        }\n    }\n\n    single_char = (*state).single_char;\n    if single_char != FALSE {\n        (*state).to_case = PCRE2_SUBSTITUTE_CASE_NONE;\n    }\n\n    while input < input_end {\n        let mut ch: u32;\n        let chlen: u32;\n\n        // GETCHARINCTEST(ch, input)\n        if utf != FALSE {\n            let (v, n) = GETCHARINC(input);\n            ch = v;\n            input = input.add(n);\n        } else {\n            ch = *input as u32;\n            input = input.add(1);\n        }\n\n        if (utf != FALSE || ucp != FALSE) && ch >= 128 {\n            let typ: u32 = UCD_CHARTYPE(ch);\n            if *_pcre2_ucp_gentype_8.as_ptr().add(typ as usize) as u32 == ucp_L\n                && typ != (if next_to_upper != FALSE { ucp_Lu } else { ucp_Ll })\n            {\n                ch = UCD_OTHERCASE(ch);\n            }\n        } else if MAX_255(ch) {\n            if (*((*code).tables.add(\n                cbits_offset + (if next_to_upper != FALSE { cbit_upper } else { cbit_lower }),\n            ).add((ch / 8) as usize))\n                & (1u8 << (ch % 8)))\n                == 0\n            {\n                ch = *(*code).tables.add(fcc_offset).add(ch as usize) as u32;\n            }\n        }\n\n        if utf != FALSE {\n            chlen = crate::pcre2_ord2utf::_pcre2_ord2utf_8(ch, temp.as_mut_ptr());\n        } else {\n            temp[0] = ch as PCRE2_UCHAR;\n            chlen = 1;\n        }\n\n        if overflow == FALSE && chlen as PCRE2_SIZE <= output_cap {\n            memcpy(\n                output as *mut c_void,\n                temp.as_ptr() as *const c_void,\n                CU2BYTES(chlen as usize),\n            );\n            output = output.add(chlen as usize);\n            output_cap -= chlen as PCRE2_SIZE;\n        } else {\n            overflow = TRUE;\n        }\n\n        if chlen as PCRE2_SIZE > !(0 as PCRE2_SIZE) - written {\n            /* Integer overflow */\n            return !(0 as PCRE2_SIZE);\n        }\n        written += chlen as PCRE2_SIZE;\n\n        next_to_upper = rest_to_upper;\n\n        /* memcpy the remainder, if only transforming a single character. */\n        if single_char != FALSE {\n            let rest_len: PCRE2_SIZE = input_end.offset_from(input) as PCRE2_SIZE;\n\n            if overflow == FALSE && rest_len <= output_cap {\n                memcpy(\n                    output as *mut c_void,\n                    input as *const c_void,\n                    CU2BYTES(rest_len),\n                );\n            }\n\n            if rest_len > !(0 as PCRE2_SIZE) - written {\n                /* Integer overflow */\n                return !(0 as PCRE2_SIZE);\n            }\n            written += rest_len;\n\n            return written;\n        }\n    }\n\n    written\n}\nRUSTEOF\necho done"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":163,"cache_read_input_tokens":50726,"cache_creation":{"ephemeral_5m_input_tokens":163,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01GgucZ4dFe7bRDeobPfSGPs","session_id":"f08167af-b65d-45d4-8780-bbe04557b3d8","uui