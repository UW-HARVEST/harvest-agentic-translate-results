{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FT7DPLtWrfQk3nyn8vddMJ","type":"tool_result","content":"1\t/*************************************************\n2\t*       Perl-Compatible Regular Expressions      *\n3\t*************************************************/\n4\t\n5\t/* This is the public header file for the PCRE library, second API, to be\n6\t#included by applications that call PCRE2 functions.\n7\t\n8\t           Copyright (c) 2016-2024 University of Cambridge\n9\t\n10\t-----------------------------------------------------------------------------\n11\tRedistribution and use in source and binary forms, with or without\n12\tmodification, are permitted provided that the following conditions are met:\n13\t\n14\t    * Redistributions of source code must retain the above copyright notice,\n15\t      this list of conditions and the following disclaimer.\n16\t\n17\t    * Redistributions in binary form must reproduce the above copyright\n18\t      notice, this list of conditions and the following disclaimer in the\n19\t      documentation and/or other materials provided with the distribution.\n20\t\n21\t    * Neither the name of the University of Cambridge nor the names of its\n22\t      contributors may be used to endorse or promote products derived from\n23\t      this software without specific prior written permission.\n24\t\n25\tTHIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\"\n26\tAND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE\n27\tIMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE\n28\tARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE\n29\tLIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR\n30\tCONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF\n31\tSUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\n32\tINTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\n33\tCONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\n34\tARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE\n35\tPOSSIBILITY OF SUCH DAMAGE.\n36\t-----------------------------------------------------------------------------\n37\t*/\n38\t\n39\t#ifndef PCRE2_H_IDEMPOTENT_GUARD\n40\t#define PCRE2_H_IDEMPOTENT_GUARD\n41\t\n42\t/* The current PCRE version information. */\n43\t\n44\t#define PCRE2_MAJOR           10\n45\t#define PCRE2_MINOR           48\n46\t#define PCRE2_PRERELEASE      -DEV\n47\t#define PCRE2_DATE            2025-10-21\n48\t\n49\t/* When an application links to a PCRE2 DLL in Windows, the symbols that are\n50\timported have to be identified as such. When building PCRE2, the appropriate\n51\texport setting is defined in pcre2_internal.h, which includes this file. So, we\n52\tdon't change existing definitions of PCRE2_EXP_DECL.\n53\t\n54\tBy default, we use the standard \"extern\" declarations. */\n55\t\n56\t#ifndef PCRE2_EXP_DECL\n57\t#  if defined(_WIN32) && !defined(PCRE2_STATIC)\n58\t#    define PCRE2_EXP_DECL  extern __declspec(dllimport)\n59\t#  elif defined __cplusplus\n60\t#    define PCRE2_EXP_DECL  extern \"C\"\n61\t#  else\n62\t#    define PCRE2_EXP_DECL  extern\n63\t#  endif\n64\t#endif\n65\t\n66\t/* When compiling with the MSVC compiler, it is sometimes necessary to include\n67\ta \"calling convention\" before exported function names. For example:\n68\t\n69\t  void __cdecl function(....)\n70\t\n71\tmight be needed. In order to make this easy, all the exported functions have\n72\tPCRE2_CALL_CONVENTION just before their names.\n73\t\n74\tPCRE2 normally uses the platform's standard calling convention, so this should\n75\tnot be set unless you know you need it. */\n76\t\n77\t#ifndef PCRE2_CALL_CONVENTION\n78\t#define PCRE2_CALL_CONVENTION\n79\t#endif\n80\t\n81\t/* Have to include limits.h, stdlib.h, and inttypes.h to ensure that size_t and\n82\tuint8_t, UCHAR_MAX, etc are defined. Some systems that do have inttypes.h do\n83\tnot have stdint.h, which is why we use inttypes.h, which according to the C\n84\tstandard is a superset of stdint.h. If inttypes.h is not available the build\n85\twill break and the relevant values must be provided by some other means. */\n86\t\n87\t#include <limits.h>\n88\t#include <stdlib.h>\n89\t#include <inttypes.h>\n90\t\n91\t/* Allow for C++ users compiling this directly. */\n92\t\n93\t#ifdef __cplusplus\n94\textern \"C\" {\n95\t#endif\n96\t\n97\t/* The following option bits can be passed to pcre2_compile(), pcre2_match(),\n98\tor pcre2_dfa_match(). PCRE2_NO_UTF_CHECK affects only the function to which it\n99\tis passed. Put these bits at the most significant end of the options word so\n100\tothers can be added next to them */\n101\t\n102\t#define PCRE2_ANCHORED            0x80000000u\n103\t#define PCRE2_NO_UTF_CHECK        0x40000000u\n104\t#define PCRE2_ENDANCHORED         0x20000000u\n105\t\n106\t/* The following option bits can be passed only to pcre2_compile(). However,\n107\tthey may affect compilation, JIT compilation, and/or interpretive execution.\n108\tThe following tags indicate which:\n109\t\n110\tC   alters what is compiled by pcre2_compile()\n111\tJ   alters what is compiled by pcre2_jit_compile()\n112\tM   is inspected during pcre2_match() execution\n113\tD   is inspected during pcre2_dfa_match() execution\n114\t*/\n115\t\n116\t#define PCRE2_ALLOW_EMPTY_CLASS   0x00000001u  /* C       */\n117\t#define PCRE2_ALT_BSUX            0x00000002u  /* C       */\n118\t#define PCRE2_AUTO_CALLOUT        0x00000004u  /* C       */\n119\t#define PCRE2_CASELESS            0x00000008u  /* C       */\n120\t#define PCRE2_DOLLAR_ENDONLY      0x00000010u  /*   J M D */\n121\t#define PCRE2_DOTALL              0x00000020u  /* C       */\n122\t#define PCRE2_DUPNAMES            0x00000040u  /* C       */\n123\t#define PCRE2_EXTENDED            0x00000080u  /* C       */\n124\t#define PCRE2_FIRSTLINE           0x00000100u  /*   J M D */\n125\t#define PCRE2_MATCH_UNSET_BACKREF 0x00000200u  /* C J M   */\n126\t#define PCRE2_MULTILINE           0x00000400u  /* C       */\n127\t#define PCRE2_NEVER_UCP           0x00000800u  /* C       */\n128\t#define PCRE2_NEVER_UTF           0x00001000u  /* C       */\n129\t#define PCRE2_NO_AUTO_CAPTURE     0x00002000u  /* C       */\n130\t#define PCRE2_NO_AUTO_POSSESS     0x00004000u  /* C       */\n131\t#define PCRE2_NO_DOTSTAR_ANCHOR   0x00008000u  /* C       */\n132\t#define PCRE2_NO_START_OPTIMIZE   0x00010000u  /*   J M D */\n133\t#define PCRE2_UCP                 0x00020000u  /* C J M D */\n134\t#define PCRE2_UNGREEDY            0x00040000u  /* C       */\n135\t#define PCRE2_UTF                 0x00080000u  /* C J M D */\n136\t#define PCRE2_NEVER_BACKSLASH_C   0x00100000u  /* C       */\n137\t#define PCRE2_ALT_CIRCUMFLEX      0x00200000u  /*   J M D */\n138\t#define PCRE2_ALT_VERBNAMES       0x00400000u  /* C       */\n139\t#define PCRE2_USE_OFFSET_LIMIT    0x00800000u  /*   J M D */\n140\t#define PCRE2_EXTENDED_MORE       0x01000000u  /* C       */\n141\t#define PCRE2_LITERAL             0x02000000u  /* C       */\n142\t#define PCRE2_MATCH_INVALID_UTF   0x04000000u  /*   J M D */\n143\t#define PCRE2_ALT_EXTENDED_CLASS  0x08000000u  /* C       */\n144\t\n145\t/* An additional compile options word is available in the compile context. */\n146\t\n147\t#define PCRE2_EXTRA_ALLOW_SURROGATE_ESCAPES  0x00000001u  /* C */\n148\t#define PCRE2_EXTRA_BAD_ESCAPE_IS_LITERAL    0x00000002u  /* C */\n149\t#define PCRE2_EXTRA_MATCH_WORD               0x00000004u  /* C */\n150\t#define PCRE2_EXTRA_MATCH_LINE               0x00000008u  /* C */\n151\t#define PCRE2_EXTRA_ESCAPED_CR_IS_LF         0x00000010u  /* C */\n152\t#define PCRE2_EXTRA_ALT_BSUX                 0x00000020u  /* C */\n153\t#define PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK     0x00000040u  /* C */\n154\t#define PCRE2_EXTRA_CASELESS_RESTRICT        0x00000080u  /* C */\n155\t#define PCRE2_EXTRA_ASCII_BSD                0x00000100u  /* C */\n156\t#define PCRE2_EXTRA_ASCII_BSS                0x00000200u  /* C */\n157\t#define PCRE2_EXTRA_ASCII_BSW                0x00000400u  /* C */\n158\t#define PCRE2_EXTRA_ASCII_POSIX              0x00000800u  /* C */\n159\t#define PCRE2_EXTRA_ASCII_DIGIT              0x00001000u  /* C */\n160\t#define PCRE2_EXTRA_PYTHON_OCTAL             0x00002000u  /* C */\n161\t#define PCRE2_EXTRA_NO_BS0                   0x00004000u  /* C */\n162\t#define PCRE2_EXTRA_NEVER_CALLOUT            0x00008000u  /* C */\n163\t#define PCRE2_EXTRA_TURKISH_CASING           0x00010000u  /* C */\n164\t\n165\t/* These are for pcre2_jit_compile(). */\n166\t\n167\t#define PCRE2_JIT_COMPLETE        0x00000001u  /* For full matching */\n168\t#define PCRE2_JIT_PARTIAL_SOFT    0x00000002u\n169\t#define PCRE2_JIT_PARTIAL_HARD    0x00000004u\n170\t#define PCRE2_JIT_INVALID_UTF     0x00000100u\n171\t#define PCRE2_JIT_TEST_ALLOC      0x00000200u\n172\t\n173\t/* These are for pcre2_match(), pcre2_dfa_match(), pcre2_jit_match(), and\n174\tpcre2_substitute(). Some are allowed only for one of the functions, and in\n175\tthese cases it is noted below. Note that PCRE2_ANCHORED, PCRE2_ENDANCHORED and\n176\tPCRE2_NO_UTF_CHECK can also be passed to these functions (though\n177\tpcre2_jit_match() ignores the latter since it bypasses all sanity checks). */\n178\t\n179\t#define PCRE2_NOTBOL                      0x00000001u\n180\t#define PCRE2_NOTEOL                      0x00000002u\n181\t#define PCRE2_NOTEMPTY                    0x00000004u  /* ) These two must be kept */\n182\t#define PCRE2_NOTEMPTY_ATSTART            0x00000008u  /* ) adjacent to each other. */\n183\t#define PCRE2_PARTIAL_SOFT                0x00000010u\n184\t#define PCRE2_PARTIAL_HARD                0x00000020u\n185\t#define PCRE2_DFA_RESTART                 0x00000040u  /* pcre2_dfa_match() only */\n186\t#define PCRE2_DFA_SHORTEST                0x00000080u  /* pcre2_dfa_match() only */\n187\t#define PCRE2_SUBSTITUTE_GLOBAL           0x00000100u  /* pcre2_substitute() only */\n188\t#define PCRE2_SUBSTITUTE_EXTENDED         0x00000200u  /* pcre2_substitute() only */\n189\t#define PCRE2_SUBSTITUTE_UNSET_EMPTY      0x00000400u  /* pcre2_substitute() only */\n190\t#define PCRE2_SUBSTITUTE_UNKNOWN_UNSET    0x00000800u  /* pcre2_substitute() only */\n191\t#define PCRE2_SUBSTITUTE_OVERFLOW_LENGTH  0x00001000u  /* pcre2_substitute() only */\n192\t#define PCRE2_NO_JIT                      0x00002000u  /* not for pcre2_dfa_match() */\n193\t#define PCRE2_COPY_MATCHED_SUBJECT        0x00004000u\n194\t#define PCRE2_SUBSTITUTE_LITERAL          0x00008000u  /* pcre2_substitute() only */\n195\t#define PCRE2_SUBSTITUTE_MATCHED          0x00010000u  /* pcre2_substitute() only */\n196\t#define PCRE2_SUBSTITUTE_REPLACEMENT_ONLY 0x00020000u  /* pcre2_substitute() only */\n197\t#define PCRE2_DISABLE_RECURSELOOP_CHECK   0x00040000u  /* not for pcre2_dfa_match() or pcre2_jit_match() */\n198\t\n199\t/* Options for pcre2_pattern_convert(). */\n200\t\n201\t#define PCRE2_CONVERT_UTF                    0x00000001u\n202\t#define PCRE2_CONVERT_NO_UTF_CHECK           0x00000002u\n203\t#define PCRE2_CONVERT_POSIX_BASIC            0x00000004u\n204\t#define PCRE2_CONVERT_POSIX_EXTENDED         0x00000008u\n205\t#define PCRE2_CONVERT_GLOB                   0x00000010u\n206\t#define PCRE2_CONVERT_GLOB_NO_WILD_SEPARATOR 0x00000030u\n207\t#define PCRE2_CONVERT_GLOB_NO_STARSTAR       0x00000050u\n208\t\n209\t/* Newline and \\R settings, for use in compile contexts. The newline values\n210\tmust be kept in step with values set in config.h and both sets must all be\n211\tgreater than zero. */\n212\t\n213\t#define PCRE2_NEWLINE_CR          1\n214\t#define PCRE2_NEWLINE_LF          2\n215\t#define PCRE2_NEWLINE_CRLF        3\n216\t#define PCRE2_NEWLINE_ANY         4\n217\t#define PCRE2_NEWLINE_ANYCRLF     5\n218\t#define PCRE2_NEWLINE_NUL         6\n219\t\n220\t#define PCRE2_BSR_UNICODE         1\n221\t#define PCRE2_BSR_ANYCRLF         2\n222\t\n223\t/* Error codes for pcre2_compile(). Some of these are also used by\n224\tpcre2_pattern_convert(). */\n225\t\n226\t#define PCRE2_ERROR_END_BACKSLASH                  101\n227\t#define PCRE2_ERROR_END_BACKSLASH_C                102\n228\t#define PCRE2_ERROR_UNKNOWN_ESCAPE                 103\n229\t#define PCRE2_ERROR_QUANTIFIER_OUT_OF_ORDER        104\n230\t#define PCRE2_ERROR_QUANTIFIER_TOO_BIG             105\n231\t#define PCRE2_ERROR_MISSING_SQUARE_BRACKET         106\n232\t#define PCRE2_ERROR_ESCAPE_INVALID_IN_CLASS        107\n233\t#define PCRE2_ERROR_CLASS_RANGE_ORDER              108\n234\t#define PCRE2_ERROR_QUANTIFIER_INVALID             109\n235\t#define PCRE2_ERROR_INTERNAL_UNEXPECTED_REPEAT     110\n236\t#define PCRE2_ERROR_INVALID_AFTER_PARENS_QUERY     111\n237\t#define PCRE2_ERROR_POSIX_CLASS_NOT_IN_CLASS       112\n238\t#define PCRE2_ERROR_POSIX_NO_SUPPORT_COLLATING     113\n239\t#define PCRE2_ERROR_MISSING_CLOSING_PARENTHESIS    114\n240\t#define PCRE2_ERROR_BAD_SUBPATTERN_REFERENCE       115\n241\t#define PCRE2_ERROR_NULL_PATTERN                   116\n242\t#define PCRE2_ERROR_BAD_OPTIONS                    117\n243\t#define PCRE2_ERROR_MISSING_COMMENT_CLOSING        118\n244\t#define PCRE2_ERROR_PARENTHESES_NEST_TOO_DEEP      119\n245\t#define PCRE2_ERROR_PATTERN_TOO_LARGE              120\n246\t#define PCRE2_ERROR_HEAP_FAILED                    121\n247\t#define PCRE2_ERROR_UNMATCHED_CLOSING_PARENTHESIS  122\n248\t#define PCRE2_ERROR_INTERNAL_CODE_OVERFLOW         123\n249\t#define PCRE2_ERROR_MISSING_CONDITION_CLOSING      124\n250\t#define PCRE2_ERROR_LOOKBEHIND_NOT_FIXED_LENGTH    125\n251\t#define PCRE2_ERROR_ZERO_RELATIVE_REFERENCE        126\n252\t#define PCRE2_ERROR_TOO_MANY_CONDITION_BRANCHES    127\n253\t#define PCRE2_ERROR_CONDITION_ASSERTION_EXPECTED   128\n254\t#define PCRE2_ERROR_BAD_RELATIVE_REFERENCE         129\n255\t#define PCRE2_ERROR_UNKNOWN_POSIX_CLASS            130\n256\t#define PCRE2_ERROR_INTERNAL_STUDY_ERROR           131\n257\t#define PCRE2_ERROR_UNICODE_NOT_SUPPORTED          132\n258\t#define PCRE2_ERROR_PARENTHESES_STACK_CHECK        133\n259\t#define PCRE2_ERROR_CODE_POINT_TOO_BIG             134\n260\t#define PCRE2_ERROR_LOOKBEHIND_TOO_COMPLICATED     135\n261\t#define PCRE2_ERROR_LOOKBEHIND_INVALID_BACKSLASH_C 136\n262\t#define PCRE2_ERROR_UNSUPPORTED_ESCAPE_SEQUENCE    137\n263\t#define PCRE2_ERROR_CALLOUT_NUMBER_TOO_BIG         138\n264\t#define PCRE2_ERROR_MISSING_CALLOUT_CLOSING        139\n265\t#define PCRE2_ERROR_ESCAPE_INVALID_IN_VERB         140\n266\t#define PCRE2_ERROR_UNRECOGNIZED_AFTER_QUERY_P     141\n267\t#define PCRE2_ERROR_MISSING_NAME_TERMINATOR        142\n268\t#define PCRE2_ERROR_DUPLICATE_SUBPATTERN_NAME      143\n269\t#define PCRE2_ERROR_INVALID_SUBPATTERN_NAME        144\n270\t#define PCRE2_ERROR_UNICODE_PROPERTIES_UNAVAILABLE 145\n271\t#define PCRE2_ERROR_MALFORMED_UNICODE_PROPERTY     146\n272\t#define PCRE2_ERROR_UNKNOWN_UNICODE_PROPERTY       147\n273\t#define PCRE2_ERROR_SUBPATTERN_NAME_TOO_LONG       148\n274\t#define PCRE2_ERROR_TOO_MANY_NAMED_SUBPATTERNS     149\n275\t#define PCRE2_ERROR_CLASS_INVALID_RANGE            150\n276\t#define PCRE2_ERROR_OCTAL_BYTE_TOO_BIG             151\n277\t#define PCRE2_ERROR_INTERNAL_OVERRAN_WORKSPACE     152\n278\t#define PCRE2_ERROR_INTERNAL_MISSING_SUBPATTERN    153\n279\t#define PCRE2_ERROR_DEFINE_TOO_MANY_BRANCHES       154\n280\t#define PCRE2_ERROR_BACKSLASH_O_MISSING_BRACE      155\n281\t#define PCRE2_ERROR_INTERNAL_UNKNOWN_NEWLINE       156\n282\t#define PCRE2_ERROR_BACKSLASH_G_SYNTAX             157\n283\t#define PCRE2_ERROR_PARENS_QUERY_R_MISSING_CLOSING 158\n284\t/* Error 159 is obsolete and should now never occur */\n285\t#define PCRE2_ERROR_VERB_ARGUMENT_NOT_ALLOWED      159\n286\t#define PCRE2_ERROR_VERB_UNKNOWN                   160\n287\t#define PCRE2_ERROR_SUBPATTERN_NUMBER_TOO_BIG      161\n288\t#define PCRE2_ERROR_SUBPATTERN_NAME_EXPECTED       162\n289\t#define PCRE2_ERROR_INTERNAL_PARSED_OVERFLOW       163\n290\t#define PCRE2_ERROR_INVALID_OCTAL                  164\n291\t#define PCRE2_ERROR_SUBPATTERN_NAMES_MISMATCH      165\n292\t#define PCRE2_ERROR_MARK_MISSING_ARGUMENT          166\n293\t#define PCRE2_ERROR_INVALID_HEXADECIMAL            167\n294\t#define PCRE2_ERROR_BACKSLASH_C_SYNTAX             168\n295\t#define PCRE2_ERROR_BACKSLASH_K_SYNTAX             169\n296\t#define PCRE2_ERROR_INTERNAL_BAD_CODE_LOOKBEHINDS  170\n297\t#define PCRE2_ERROR_BACKSLASH_N_IN_CLASS           171\n298\t#define PCRE2_ERROR_CALLOUT_STRING_TOO_LONG        172\n299\t#define PCRE2_ERROR_UNICODE_DISALLOWED_CODE_POINT  173\n300\t#define PCRE2_ERROR_UTF_IS_DISABLED                174\n301\t#define PCRE2_ERROR_UCP_IS_DISABLED                175\n302\t#define PCRE2_ERROR_VERB_NAME_TOO_LONG             176\n303\t#define PCRE2_ERROR_BACKSLASH_U_CODE_POINT_TOO_BIG 177\n304\t#define PCRE2_ERROR_MISSING_OCTAL_OR_HEX_DIGITS    178\n305\t#define PCRE2_ERROR_VERSION_CONDITION_SYNTAX       179\n306\t#define PCRE2_ERROR_INTERNAL_BAD_CODE_AUTO_POSSESS 180\n307\t#define PCRE2_ERROR_CALLOUT_NO_STRING_DELIMITER    181\n308\t#define PCRE2_ERROR_CALLOUT_BAD_STRING_DELIMITER   182\n309\t#define PCRE2_ERROR_BACKSLASH_C_CALLER_DISABLED    183\n310\t#define PCRE2_ERROR_QUERY_BARJX_NEST_TOO_DEEP      184\n311\t#define PCRE2_ERROR_BACKSLASH_C_LIBRARY_DISABLED   185\n312\t#define PCRE2_ERROR_PATTERN_TOO_COMPLICATED        186\n313\t#define PCRE2_ERROR_LOOKBEHIND_TOO_LONG            187\n314\t#define PCRE2_ERROR_PATTERN_STRING_TOO_LONG        188\n315\t#define PCRE2_ERROR_INTERNAL_BAD_CODE              189\n316\t#define PCRE2_ERROR_INTERNAL_BAD_CODE_IN_SKIP      190\n317\t#define PCRE2_ERROR_NO_SURROGATES_IN_UTF16         191\n318\t#define PCRE2_ERROR_BAD_LITERAL_OPTIONS            192\n319\t#define PCRE2_ERROR_SUPPORTED_ONLY_IN_UNICODE      193\n320\t#define PCRE2_ERROR_INVALID_HYPHEN_IN_OPTIONS      194\n321\t#define PCRE2_ERROR_ALPHA_ASSERTION_UNKNOWN        195\n322\t#define PCRE2_ERROR_SCRIPT_RUN_NOT_AVAILABLE       196\n323\t#define PCRE2_ERROR_TOO_MANY_CAPTURES              197\n324\t#define PCRE2_ERROR_MISSING_OCTAL_DIGIT            198\n325\t#define PCRE2_ERROR_BACKSLASH_K_IN_LOOKAROUND      199\n326\t#define PCRE2_ERROR_MAX_VAR_LOOKBEHIND_EXCEEDED    200\n327\t#define PCRE2_ERROR_PATTERN_COMPILED_SIZE_TOO_BIG  201\n328\t#define PCRE2_ERROR_OVERSIZE_PYTHON_OCTAL          202\n329\t#define PCRE2_ERROR_CALLOUT_CALLER_DISABLED        203\n330\t#define PCRE2_ERROR_EXTRA_CASING_REQUIRES_UNICODE  204\n331\t#define PCRE2_ERROR_TURKISH_CASING_REQUIRES_UTF    205\n332\t#define PCRE2_ERROR_EXTRA_CASING_INCOMPATIBLE      206\n333\t#define PCRE2_ERROR_ECLASS_NEST_TOO_DEEP           207\n334\t#define PCRE2_ERROR_ECLASS_INVALID_OPERATOR        208\n335\t#define PCRE2_ERROR_ECLASS_UNEXPECTED_OPERATOR     209\n336\t#define PCRE2_ERROR_ECLASS_EXPECTED_OPERAND        210\n337\t#define PCRE2_ERROR_ECLASS_MIXED_OPERATORS         211\n338\t#define PCRE2_ERROR_ECLASS_HINT_SQUARE_BRACKET     212\n339\t#define PCRE2_ERROR_PERL_ECLASS_UNEXPECTED_EXPR    213\n340\t#define PCRE2_ERROR_PERL_ECLASS_EMPTY_EXPR         214\n341\t#define PCRE2_ERROR_PERL_ECLASS_MISSING_CLOSE      215\n342\t#define PCRE2_ERROR_PERL_ECLASS_UNEXPECTED_CHAR    216\n343\t#define PCRE2_ERROR_EXPECTED_CAPTURE_GROUP         217\n344\t#define PCRE2_ERROR_MISSING_OPENING_PARENTHESIS    218\n345\t#define PCRE2_ERROR_MISSING_NUMBER_TERMINATOR      219\n346\t#define PCRE2_ERROR_NULL_ERROROFFSET               220\n347\t\n348\t/* \"Expected\" matching error codes: no match and partial match. */\n349\t\n350\t#define PCRE2_ERROR_NOMATCH          (-1)\n351\t#define PCRE2_ERROR_PARTIAL          (-2)\n352\t\n353\t/* Error codes for UTF-8 validity checks */\n354\t\n355\t#define PCRE2_ERROR_UTF8_ERR1        (-3)\n356\t#define PCRE2_ERROR_UTF8_ERR2        (-4)\n357\t#define PCRE2_ERROR_UTF8_ERR3        (-5)\n358\t#define PCRE2_ERROR_UTF8_ERR4        (-6)\n359\t#define PCRE2_ERROR_UTF8_ERR5        (-7)\n360\t#define PCRE2_ERROR_UTF8_ERR6        (-8)\n361\t#define PCRE2_ERROR_UTF8_ERR7        (-9)\n362\t#define PCRE2_ERROR_UTF8_ERR8       (-10)\n363\t#define PCRE2_ERROR_UTF8_ERR9       (-11)\n364\t#define PCRE2_ERROR_UTF8_ERR10      (-12)\n365\t#define PCRE2_ERROR_UTF8_ERR11      (-13)\n366\t#define PCRE2_ERROR_UTF8_ERR12      (-14)\n367\t#define PCRE2_ERROR_UTF8_ERR13      (-15)\n368\t#define PCRE2_ERROR_UTF8_ERR14      (-16)\n369\t#define PCRE2_ERROR_UTF8_ERR15      (-17)\n370\t#define PCRE2_ERROR_UTF8_ERR16      (-18)\n371\t#define PCRE2_ERROR_UTF8_ERR17      (-19)\n372\t#define PCRE2_ERROR_UTF8_ERR18      (-20)\n373\t#define PCRE2_ERROR_UTF8_ERR19      (-21)\n374\t#define PCRE2_ERROR_UTF8_ERR20      (-22)\n375\t#define PCRE2_ERROR_UTF8_ERR21      (-23)\n376\t\n377\t/* Error codes for UTF-16 validity checks */\n378\t\n379\t#define PCRE2_ERROR_UTF16_ERR1      (-24)\n380\t#define PCRE2_ERROR_UTF16_ERR2      (-25)\n381\t#define PCRE2_ERROR_UTF16_ERR3      (-26)\n382\t\n383\t/* Error codes for UTF-32 validity checks */\n384\t\n385\t#define PCRE2_ERROR_UTF32_ERR1      (-27)\n386\t#define PCRE2_ERROR_UTF32_ERR2      (-28)\n387\t\n388\t/* Miscellaneous error codes for pcre2[_dfa]_match(), substring extraction\n389\tfunctions, context functions, and serializing functions. They are in numerical\n390\torder. Originally they were in alphabetical order too, but now that PCRE2 is\n391\treleased, the numbers must not be changed. */\n392\t\n393\t#define PCRE2_ERROR_BADDATA           (-29)\n394\t#define PCRE2_ERROR_MIXEDTABLES       (-30)  /* Name was changed */\n395\t#define PCRE2_ERROR_BADMAGIC          (-31)\n396\t#define PCRE2_ERROR_BADMODE           (-32)\n397\t#define PCRE2_ERROR_BADOFFSET         (-33)\n398\t#define PCRE2_ERROR_BADOPTION         (-34)\n399\t#define PCRE2_ERROR_BADREPLACEMENT    (-35)\n400\t#define PCRE2_ERROR_BADUTFOFFSET      (-36)\n401\t#define PCRE2_ERROR_CALLOUT           (-37)  /* Never used by PCRE2 itself */\n402\t#define PCRE2_ERROR_DFA_BADRESTART    (-38)\n403\t#define PCRE2_ERROR_DFA_RECURSE       (-39)\n404\t#define PCRE2_ERROR_DFA_UCOND         (-40)\n405\t#define PCRE2_ERROR_DFA_UFUNC         (-41)\n406\t#define PCRE2_ERROR_DFA_UITEM         (-42)\n407\t#define PCRE2_ERROR_DFA_WSSIZE        (-43)\n408\t#define PCRE2_ERROR_INTERNAL          (-44)\n409\t#define PCRE2_ERROR_JIT_BADOPTION     (-45)\n410\t#define PCRE2_ERROR_JIT_STACKLIMIT    (-46)\n411\t#define PCRE2_ERROR_MATCHLIMIT        (-47)\n412\t#define PCRE2_ERROR_NOMEMORY          (-48)\n413\t#define PCRE2_ERROR_NOSUBSTRING       (-49)\n414\t#define PCRE2_ERROR_NOUNIQUESUBSTRING (-50)\n415\t#define PCRE2_ERROR_NULL              (-51)\n416\t#define PCRE2_ERROR_RECURSELOOP       (-52)\n417\t#define PCRE2_ERROR_DEPTHLIMIT        (-53)\n418\t#define PCRE2_ERROR_RECURSIONLIMIT    (-53)  /* Obsolete synonym */\n419\t#define PCRE2_ERROR_UNAVAILABLE       (-54)\n420\t#define PCRE2_ERROR_UNSET             (-55)\n421\t#define PCRE2_ERROR_BADOFFSETLIMIT    (-56)\n422\t#define PCRE2_ERROR_BADREPESCAPE      (-57)\n423\t#define PCRE2_ERROR_REPMISSINGBRACE   (-58)\n424\t#define PCRE2_ERROR_BADSUBSTITUTION   (-59)\n425\t#define PCRE2_ERROR_BADSUBSPATTERN    (-60)\n426\t#define PCRE2_ERROR_TOOMANYREPLACE    (-61)\n427\t#define PCRE2_ERROR_BADSERIALIZEDDATA (-62)\n428\t#define PCRE2_ERROR_HEAPLIMIT         (-63)\n429\t#define PCRE2_ERROR_CONVERT_SYNTAX    (-64)\n430\t#define PCRE2_ERROR_INTERNAL_DUPMATCH (-65)\n431\t#define PCRE2_ERROR_DFA_UINVALID_UTF  (-66)\n432\t#define PCRE2_ERROR_INVALIDOFFSET     (-67)\n433\t#define PCRE2_ERROR_JIT_UNSUPPORTED   (-68)\n434\t#define PCRE2_ERROR_REPLACECASE       (-69)\n435\t#define PCRE2_ERROR_TOOLARGEREPLACE   (-70)\n436\t#define PCRE2_ERROR_DIFFSUBSPATTERN   (-71)\n437\t#define PCRE2_ERROR_DIFFSUBSSUBJECT   (-72)\n438\t#define PCRE2_ERROR_DIFFSUBSOFFSET    (-73)\n439\t#define PCRE2_ERROR_DIFFSUBSOPTIONS   (-74)\n440\t#define PCRE2_ERROR_BAD_BACKSLASH_K   (-75)\n441\t#define PCRE2_ERROR_PARTIALSUBS       (-76)\n442\t\n443\t\n444\t/* Request types for pcre2_pattern_info() */\n445\t\n446\t#define PCRE2_INFO_ALLOPTIONS            0\n447\t#define PCRE2_INFO_ARGOPTIONS            1\n448\t#define PCRE2_INFO_BACKREFMAX            2\n449\t#define PCRE2_INFO_BSR                   3\n450\t#define PCRE2_INFO_CAPTURECOUNT          4\n451\t#define PCRE2_INFO_FIRSTCODEUNIT         5\n452\t#define PCRE2_INFO_FIRSTCODETYPE         6\n453\t#define PCRE2_INFO_FIRSTBITMAP           7\n454\t#define PCRE2_INFO_HASCRORLF             8\n455\t#define PCRE2_INFO_JCHANGED              9\n456\t#define PCRE2_INFO_JITSIZE              10\n457\t#define PCRE2_INFO_LASTCODEUNIT         11\n458\t#define PCRE2_INFO_LASTCODETYPE         12\n459\t#define PCRE2_INFO_MATCHEMPTY           13\n460\t#define PCRE2_INFO_MATCHLIMIT           14\n461\t#define PCRE2_INFO_MAXLOOKBEHIND        15\n462\t#define PCRE2_INFO_MINLENGTH            16\n463\t#define PCRE2_INFO_NAMECOUNT            17\n464\t#define PCRE2_INFO_NAMEENTRYSIZE        18\n465\t#define PCRE2_INFO_NAMETABLE            19\n466\t#define PCRE2_INFO_NEWLINE              20\n467\t#define PCRE2_INFO_DEPTHLIMIT           21\n468\t#define PCRE2_INFO_RECURSIONLIMIT       21  /* Obsolete synonym */\n469\t#define PCRE2_INFO_SIZE                 22\n470\t#define PCRE2_INFO_HASBACKSLASHC        23\n471\t#define PCRE2_INFO_FRAMESIZE            24\n472\t#define PCRE2_INFO_HEAPLIMIT            25\n473\t#define PCRE2_INFO_EXTRAOPTIONS         26\n474\t\n475\t/* Request types for pcre2_config(). */\n476\t\n477\t#define PCRE2_CONFIG_BSR                     0\n478\t#define PCRE2_CONFIG_JIT                     1\n479\t#define PCRE2_CONFIG_JITTARGET               2\n480\t#define PCRE2_CONFIG_LINKSIZE                3\n481\t#define PCRE2_CONFIG_MATCHLIMIT              4\n482\t#define PCRE2_CONFIG_NEWLINE                 5\n483\t#define PCRE2_CONFIG_PARENSLIMIT             6\n484\t#define PCRE2_CONFIG_DEPTHLIMIT              7\n485\t#define PCRE2_CONFIG_RECURSIONLIMIT          7  /* Obsolete synonym */\n486\t#define PCRE2_CONFIG_STACKRECURSE            8  /* Obsolete */\n487\t#define PCRE2_CONFIG_UNICODE                 9\n488\t#define PCRE2_CONFIG_UNICODE_VERSION        10\n489\t#define PCRE2_CONFIG_VERSION                11\n490\t#define PCRE2_CONFIG_HEAPLIMIT              12\n491\t#define PCRE2_CONFIG_NEVER_BACKSLASH_C      13\n492\t#define PCRE2_CONFIG_COMPILED_WIDTHS        14\n493\t#define PCRE2_CONFIG_TABLES_LENGTH          15\n494\t#define PCRE2_CONFIG_EFFECTIVE_LINKSIZE     16\n495\t\n496\t/* Optimization directives for pcre2_set_optimize().\n497\tFor binary compatibility, only add to this list; do not renumber. */\n498\t\n499\t#define PCRE2_OPTIMIZATION_NONE    0\n500\t#define PCRE2_OPTIMIZATION_FULL    1\n501\t\n502\t#define PCRE2_AUTO_POSSESS         64\n503\t#define PCRE2_AUTO_POSSESS_OFF     65\n504\t#define PCRE2_DOTSTAR_ANCHOR       66\n505\t#define PCRE2_DOTSTAR_ANCHOR_OFF   67\n506\t#define PCRE2_START_OPTIMIZE       68\n507\t#define PCRE2_START_OPTIMIZE_OFF   69\n508\t\n509\t/* Types used in pcre2_set_substitute_case_callout().\n510\t\n511\tPCRE2_SUBSTITUTE_CASE_LOWER and PCRE2_SUBSTITUTE_CASE_UPPER are passed to the\n512\tcallout to indicate that the case of the entire callout input should be\n513\tcase-transformed. PCRE2_SUBSTITUTE_CASE_TITLE_FIRST is passed to indicate that\n514\tonly the first character or glyph should be transformed to Unicode titlecase,\n515\tand the rest to lowercase. */\n516\t\n517\t#define PCRE2_SUBSTITUTE_CASE_LOWER        1\n518\t#define PCRE2_SUBSTITUTE_CASE_UPPER        2\n519\t#define PCRE2_SUBSTITUTE_CASE_TITLE_FIRST  3\n520\t\n521\t/* Types for code units in patterns and subject strings. */\n522\t\n523\ttypedef uint8_t  PCRE2_UCHAR8;\n524\ttypedef uint16_t PCRE2_UCHAR16;\n525\ttypedef uint32_t PCRE2_UCHAR32;\n526\t\n527\ttypedef const PCRE2_UCHAR8  *PCRE2_SPTR8;\n528\ttypedef const PCRE2_UCHAR16 *PCRE2_SPTR16;\n529\ttypedef const PCRE2_UCHAR32 *PCRE2_SPTR32;\n530\t\n531\t/* The PCRE2_SIZE type is used for all string lengths and offsets in PCRE2,\n532\tincluding pattern offsets for errors and subject offsets after a match. We\n533\tdefine special values to indicate zero-terminated strings and unset offsets in\n534\tthe offset vector (ovector). */\n535\t\n536\t#define PCRE2_SIZE            size_t\n537\t#define PCRE2_SIZE_MAX        SIZE_MAX\n538\t#define PCRE2_ZERO_TERMINATED (~(PCRE2_SIZE)0)\n539\t#define PCRE2_UNSET           (~(PCRE2_SIZE)0)\n540\t\n541\t/* Generic types for opaque structures and JIT callback functions. These\n542\tdeclarations are defined in a macro that is expanded for each width later. */\n543\t\n544\t#define PCRE2_TYPES_LIST \\\n545\tstruct pcre2_real_general_context; \\\n546\ttypedef struct pcre2_real_general_context pcre2_general_context; \\\n547\t\\\n548\tstruct pcre2_real_compile_context; \\\n549\ttypedef struct pcre2_real_compile_context pcre2_compile_context; \\\n550\t\\\n551\tstruct pcre2_real_match_context; \\\n552\ttypedef struct pcre2_real_match_context pcre2_match_context; \\\n553\t\\\n554\tstruct pcre2_real_convert_context; \\\n555\ttypedef struct pcre2_real_convert_context pcre2_convert_context; \\\n556\t\\\n557\tstruct pcre2_real_code; \\\n558\ttypedef struct pcre2_real_code pcre2_code; \\\n559\t\\\n560\tstruct pcre2_real_match_data; \\\n561\ttypedef struct pcre2_real_match_data pcre2_match_data; \\\n562\t\\\n563\tstruct pcre2_real_jit_stack; \\\n564\ttypedef struct pcre2_real_jit_stack pcre2_jit_stack; \\\n565\t\\\n566\ttypedef pcre2_jit_stack *(*pcre2_jit_callback)(void *);\n567\t\n568\t\n569\t/* The structures for passing out data via callout functions. We use structures\n570\tso that new fields can be added on the end in future versions, without changing\n571\tthe API of the function, thereby allowing old clients to work without\n572\tmodification. Define the generic versions in a macro; the width-specific\n573\tversions are generated from this macro below. */\n574\t\n575\t/* Flags for the callout_flags field. These are cleared after a callout. */\n576\t\n577\t#define PCRE2_CALLOUT_STARTMATCH    0x00000001u  /* Set for each bumpalong */\n578\t#define PCRE2_CALLOUT_BACKTRACK     0x00000002u  /* Set after a backtrack */\n579\t\n580\t#define PCRE2_STRUCTURE_LIST \\\n581\ttypedef struct pcre2_callout_block { \\\n582\t  uint32_t      version;           /* Identifies version of block */ \\\n583\t  /* ------------------------ Version 0 ------------------------------- */ \\\n584\t  uint32_t      callout_number;    /* Number compiled into pattern */ \\\n585\t  uint32_t      capture_top;       /* Max current capture */ \\\n586\t  uint32_t      capture_last;      /* Most recently closed capture */ \\\n587\t  PCRE2_SIZE   *offset_vector;     /* The offset vector */ \\\n588\t  PCRE2_SPTR    mark;              /* Pointer to current mark or NULL */ \\\n589\t  PCRE2_SPTR    subject;           /* The subject being matched */ \\\n590\t  PCRE2_SIZE    subject_length;    /* The length of the subject */ \\\n591\t  PCRE2_SIZE    start_match;       /* Offset to start of this match attempt */ \\\n592\t  PCRE2_SIZE    current_position;  /* Where we currently are in the subject */ \\\n593\t  PCRE2_SIZE    pattern_position;  /* Offset to next item in the pattern */ \\\n594\t  PCRE2_SIZE    next_item_length;  /* Length of next item in the pattern */ \\\n595\t  /* ------------------- Added for Version 1 -------------------------- */ \\\n596\t  PCRE2_SIZE    callout_string_offset; /* Offset to string within pattern */ \\\n597\t  PCRE2_SIZE    callout_string_length; /* Length of string compiled into pattern */ \\\n598\t  PCRE2_SPTR    callout_string;    /* String compiled into pattern */ \\\n599\t  /* ------------------- Added for Version 2 -------------------------- */ \\\n600\t  uint32_t      callout_flags;     /* See above for list */ \\\n601\t  /* ------------------------------------------------------------------ */ \\\n602\t} pcre2_callout_block; \\\n603\t\\\n604\ttypedef struct pcre2_callout_enumerate_block { \\\n605\t  uint32_t      version;           /* Identifies version of block */ \\\n606\t  /* ------------------------ Version 0 ------------------------------- */ \\\n607\t  PCRE2_SIZE    pattern_position;  /* Offset to next item in the pattern */ \\\n608\t  PCRE2_SIZE    next_item_length;  /* Length of next item in the pattern */ \\\n609\t  uint32_t      callout_number;    /* Number compiled into pattern */ \\\n610\t  PCRE2_SIZE    callout_string_offset; /* Offset to string within pattern */ \\\n611\t  PCRE2_SIZE    callout_string_length; /* Length of string compiled into pattern */ \\\n612\t  PCRE2_SPTR    callout_string;    /* String compiled into pattern */ \\\n613\t  /* ------------------------------------------------------------------ */ \\\n614\t} pcre2_callout_enumerate_block; \\\n615\t\\\n616\ttypedef struct pcre2_substitute_callout_block { \\\n617\t  uint32_t      version;           /* Identifies version of block */ \\\n618\t  /* ------------------------ Version 0 ------------------------------- */ \\\n619\t  PCRE2_SPTR    input;             /* Pointer to input subject string */ \\\n620\t  PCRE2_SPTR    output;            /* Pointer to output buffer */ \\\n621\t  PCRE2_SIZE    output_offsets[2]; /* Changed portion of the output */ \\\n622\t  PCRE2_SIZE   *ovector;           /* Pointer to current ovector */ \\\n623\t  uint32_t      oveccount;         /* Count of pairs set in ovector */ \\\n624\t  uint32_t      subscount;         /* Substitution number */ \\\n625\t  /* ------------------------------------------------------------------ */ \\\n626\t} pcre2_substitute_callout_block;\n627\t\n628\t\n629\t/* List the generic forms of all other functions in macros, which will be\n630\texpanded for each width below. Start with functions that give general\n631\tinformation. */\n632\t\n633\t#define PCRE2_GENERAL_INFO_FUNCTIONS \\\n634\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION pcre2_config(uint32_t, void *);\n635\t\n636\t\n637\t/* Functions for manipulating contexts. */\n638\t\n639\t#define PCRE2_GENERAL_CONTEXT_FUNCTIONS \\\n640\tPCRE2_EXP_DECL pcre2_general_context *PCRE2_CALL_CONVENTION \\\n641\t  pcre2_general_context_copy(pcre2_general_context *); \\\n642\tPCRE2_EXP_DECL pcre2_general_context *PCRE2_CALL_CONVENTION \\\n643\t  pcre2_general_context_create(void *(*)(size_t, void *), \\\n644\t    void (*)(void *, void *), void *); \\\n645\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n646\t  pcre2_general_context_free(pcre2_general_context *);\n647\t\n648\t#define PCRE2_COMPILE_CONTEXT_FUNCTIONS \\\n649\tPCRE2_EXP_DECL pcre2_compile_context *PCRE2_CALL_CONVENTION \\\n650\t  pcre2_compile_context_copy(pcre2_compile_context *); \\\n651\tPCRE2_EXP_DECL pcre2_compile_context *PCRE2_CALL_CONVENTION \\\n652\t  pcre2_compile_context_create(pcre2_general_context *);\\\n653\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n654\t  pcre2_compile_context_free(pcre2_compile_context *); \\\n655\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n656\t  pcre2_set_bsr(pcre2_compile_context *, uint32_t); \\\n657\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n658\t  pcre2_set_character_tables(pcre2_compile_context *, const uint8_t *); \\\n659\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n660\t  pcre2_set_compile_extra_options(pcre2_compile_context *, uint32_t); \\\n661\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n662\t  pcre2_set_max_pattern_length(pcre2_compile_context *, PCRE2_SIZE); \\\n663\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n664\t  pcre2_set_max_pattern_compiled_length(pcre2_compile_context *, PCRE2_SIZE); \\\n665\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n666\t  pcre2_set_max_varlookbehind(pcre2_compile_context *, uint32_t); \\\n667\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n668\t  pcre2_set_newline(pcre2_compile_context *, uint32_t); \\\n669\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n670\t  pcre2_set_parens_nest_limit(pcre2_compile_context *, uint32_t); \\\n671\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n672\t  pcre2_set_compile_recursion_guard(pcre2_compile_context *, \\\n673\t    int (*)(uint32_t, void *), void *); \\\n674\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n675\t  pcre2_set_optimize(pcre2_compile_context *, uint32_t);\n676\t\n677\t#define PCRE2_MATCH_CONTEXT_FUNCTIONS \\\n678\tPCRE2_EXP_DECL pcre2_match_context *PCRE2_CALL_CONVENTION \\\n679\t  pcre2_match_context_copy(pcre2_match_context *); \\\n680\tPCRE2_EXP_DECL pcre2_match_context *PCRE2_CALL_CONVENTION \\\n681\t  pcre2_match_context_create(pcre2_general_context *); \\\n682\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n683\t  pcre2_match_context_free(pcre2_match_context *); \\\n684\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n685\t  pcre2_set_callout(pcre2_match_context *, \\\n686\t    int (*)(pcre2_callout_block *, void *), void *); \\\n687\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n688\t  pcre2_set_substitute_callout(pcre2_match_context *, \\\n689\t    int (*)(pcre2_substitute_callout_block *, void *), void *); \\\n690\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n691\t  pcre2_set_substitute_case_callout(pcre2_match_context *, \\\n692\t    PCRE2_SIZE (*)(PCRE2_SPTR, PCRE2_SIZE, PCRE2_UCHAR *, PCRE2_SIZE, int, \\\n693\t                   void *), \\\n694\t    void *); \\\n695\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n696\t  pcre2_set_depth_limit(pcre2_match_context *, uint32_t); \\\n697\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n698\t  pcre2_set_heap_limit(pcre2_match_context *, uint32_t); \\\n699\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n700\t  pcre2_set_match_limit(pcre2_match_context *, uint32_t); \\\n701\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n702\t  pcre2_set_offset_limit(pcre2_match_context *, PCRE2_SIZE); \\\n703\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n704\t  pcre2_set_recursion_limit(pcre2_match_context *, uint32_t); \\\n705\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n706\t  pcre2_set_recursion_memory_management(pcre2_match_context *, \\\n707\t    void *(*)(size_t, void *), void (*)(void *, void *), void *);\n708\t\n709\t#define PCRE2_CONVERT_CONTEXT_FUNCTIONS \\\n710\tPCRE2_EXP_DECL pcre2_convert_context *PCRE2_CALL_CONVENTION \\\n711\t  pcre2_convert_context_copy(pcre2_convert_context *); \\\n712\tPCRE2_EXP_DECL pcre2_convert_context *PCRE2_CALL_CONVENTION \\\n713\t  pcre2_convert_context_create(pcre2_general_context *); \\\n714\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n715\t  pcre2_convert_context_free(pcre2_convert_context *); \\\n716\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n717\t  pcre2_set_glob_escape(pcre2_convert_context *, uint32_t); \\\n718\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n719\t  pcre2_set_glob_separator(pcre2_convert_context *, uint32_t);\n720\t\n721\t\n722\t/* Functions concerned with compiling a pattern to PCRE internal code. */\n723\t\n724\t#define PCRE2_COMPILE_FUNCTIONS \\\n725\tPCRE2_EXP_DECL pcre2_code *PCRE2_CALL_CONVENTION \\\n726\t  pcre2_compile(PCRE2_SPTR, PCRE2_SIZE, uint32_t, int *, PCRE2_SIZE *, \\\n727\t    pcre2_compile_context *); \\\n728\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n729\t  pcre2_code_free(pcre2_code *); \\\n730\tPCRE2_EXP_DECL pcre2_code *PCRE2_CALL_CONVENTION \\\n731\t  pcre2_code_copy(const pcre2_code *); \\\n732\tPCRE2_EXP_DECL pcre2_code *PCRE2_CALL_CONVENTION \\\n733\t  pcre2_code_copy_with_tables(const pcre2_code *);\n734\t\n735\t\n736\t/* Functions that give information about a compiled pattern. */\n737\t\n738\t#define PCRE2_PATTERN_INFO_FUNCTIONS \\\n739\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n740\t  pcre2_pattern_info(const pcre2_code *, uint32_t, void *); \\\n741\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n742\t  pcre2_callout_enumerate(const pcre2_code *, \\\n743\t    int (*)(pcre2_callout_enumerate_block *, void *), void *);\n744\t\n745\t\n746\t/* Functions for running a match and inspecting the result. */\n747\t\n748\t#define PCRE2_MATCH_FUNCTIONS \\\n749\tPCRE2_EXP_DECL pcre2_match_data *PCRE2_CALL_CONVENTION \\\n750\t  pcre2_match_data_create(uint32_t, pcre2_general_context *); \\\n751\tPCRE2_EXP_DECL pcre2_match_data *PCRE2_CALL_CONVENTION \\\n752\t  pcre2_match_data_create_from_pattern(const pcre2_code *, \\\n753\t    pcre2_general_context *); \\\n754\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n755\t  pcre2_match_data_free(pcre2_match_data *); \\\n756\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n757\t  pcre2_dfa_match(const pcre2_code *, PCRE2_SPTR, PCRE2_SIZE, PCRE2_SIZE, \\\n758\t    uint32_t, pcre2_match_data *, pcre2_match_context *, int *, PCRE2_SIZE); \\\n759\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n760\t  pcre2_match(const pcre2_code *, PCRE2_SPTR, PCRE2_SIZE, PCRE2_SIZE, \\\n761\t    uint32_t, pcre2_match_data *, pcre2_match_context *); \\\n762\tPCRE2_EXP_DECL PCRE2_SPTR PCRE2_CALL_CONVENTION \\\n763\t  pcre2_get_mark(pcre2_match_data *); \\\n764\tPCRE2_EXP_DECL PCRE2_SIZE PCRE2_CALL_CONVENTION \\\n765\t  pcre2_get_match_data_size(pcre2_match_data *); \\\n766\tPCRE2_EXP_DECL PCRE2_SIZE PCRE2_CALL_CONVENTION \\\n767\t  pcre2_get_match_data_heapframes_size(pcre2_match_data *); \\\n768\tPCRE2_EXP_DECL uint32_t PCRE2_CALL_CONVENTION \\\n769\t  pcre2_get_ovector_count(pcre2_match_data *); \\\n770\tPCRE2_EXP_DECL PCRE2_SIZE *PCRE2_CALL_CONVENTION \\\n771\t  pcre2_get_ovector_pointer(pcre2_match_data *); \\\n772\tPCRE2_EXP_DECL PCRE2_SIZE PCRE2_CALL_CONVENTION \\\n773\t  pcre2_get_startchar(pcre2_match_data *); \\\n774\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n775\t  pcre2_next_match(pcre2_match_data *, PCRE2_SIZE *, uint32_t *);\n776\t\n777\t\n778\t/* Convenience functions for handling matched substrings. */\n779\t\n780\t#define PCRE2_SUBSTRING_FUNCTIONS \\\n781\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n782\t  pcre2_substring_copy_byname(pcre2_match_data *, PCRE2_SPTR, PCRE2_UCHAR *, \\\n783\t    PCRE2_SIZE *); \\\n784\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n785\t  pcre2_substring_copy_bynumber(pcre2_match_data *, uint32_t, PCRE2_UCHAR *, \\\n786\t    PCRE2_SIZE *); \\\n787\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n788\t  pcre2_substring_free(PCRE2_UCHAR *); \\\n789\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n790\t  pcre2_substring_get_byname(pcre2_match_data *, PCRE2_SPTR, PCRE2_UCHAR **, \\\n791\t    PCRE2_SIZE *); \\\n792\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n793\t  pcre2_substring_get_bynumber(pcre2_match_data *, uint32_t, PCRE2_UCHAR **, \\\n794\t    PCRE2_SIZE *); \\\n795\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n796\t  pcre2_substring_length_byname(pcre2_match_data *, PCRE2_SPTR, PCRE2_SIZE *); \\\n797\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n798\t  pcre2_substring_length_bynumber(pcre2_match_data *, uint32_t, PCRE2_SIZE *); \\\n799\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n800\t  pcre2_substring_nametable_scan(const pcre2_code *, PCRE2_SPTR, PCRE2_SPTR *, \\\n801\t    PCRE2_SPTR *); \\\n802\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n803\t  pcre2_substring_number_from_name(const pcre2_code *, PCRE2_SPTR); \\\n804\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n805\t  pcre2_substring_list_free(PCRE2_UCHAR **); \\\n806\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n807\t  pcre2_substring_list_get(pcre2_match_data *, PCRE2_UCHAR ***, PCRE2_SIZE **);\n808\t\n809\t\n810\t/* Functions for serializing / deserializing compiled patterns. */\n811\t\n812\t#define PCRE2_SERIALIZE_FUNCTIONS \\\n813\tPCRE2_EXP_DECL int32_t PCRE2_CALL_CONVENTION \\\n814\t  pcre2_serialize_encode(const pcre2_code **, int32_t, uint8_t **, \\\n815\t    PCRE2_SIZE *, pcre2_general_context *); \\\n816\tPCRE2_EXP_DECL int32_t PCRE2_CALL_CONVENTION \\\n817\t  pcre2_serialize_decode(pcre2_code **, int32_t, const uint8_t *, \\\n818\t    pcre2_general_context *); \\\n819\tPCRE2_EXP_DECL int32_t PCRE2_CALL_CONVENTION \\\n820\t  pcre2_serialize_get_number_of_codes(const uint8_t *); \\\n821\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n822\t  pcre2_serialize_free(uint8_t *);\n823\t\n824\t\n825\t/* Convenience function for match + substitute. */\n826\t\n827\t#define PCRE2_SUBSTITUTE_FUNCTION \\\n828\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n829\t  pcre2_substitute(const pcre2_code *, PCRE2_SPTR, PCRE2_SIZE, PCRE2_SIZE, \\\n830\t    uint32_t, pcre2_match_data *, pcre2_match_context *, PCRE2_SPTR, \\\n831\t    PCRE2_SIZE, PCRE2_UCHAR *, PCRE2_SIZE *);\n832\t\n833\t\n834\t/* Functions for converting pattern source strings. */\n835\t\n836\t#define PCRE2_CONVERT_FUNCTIONS \\\n837\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n838\t  pcre2_pattern_convert(PCRE2_SPTR, PCRE2_SIZE, uint32_t, PCRE2_UCHAR **, \\\n839\t    PCRE2_SIZE *, pcre2_convert_context *); \\\n840\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n841\t  pcre2_converted_pattern_free(PCRE2_UCHAR *);\n842\t\n843\t\n844\t/* Functions for JIT processing */\n845\t\n846\t#define PCRE2_JIT_FUNCTIONS \\\n847\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n848\t  pcre2_jit_compile(pcre2_code *, uint32_t); \\\n849\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n850\t  pcre2_jit_match(const pcre2_code *, PCRE2_SPTR, PCRE2_SIZE, PCRE2_SIZE, \\\n851\t    uint32_t, pcre2_match_data *, pcre2_match_context *); \\\n852\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n853\t  pcre2_jit_free_unused_memory(pcre2_general_context *); \\\n854\tPCRE2_EXP_DECL pcre2_jit_stack *PCRE2_CALL_CONVENTION \\\n855\t  pcre2_jit_stack_create(size_t, size_t, pcre2_general_context *); \\\n856\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n857\t  pcre2_jit_stack_assign(pcre2_match_context *, pcre2_jit_callback, void *); \\\n858\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n859\t  pcre2_jit_stack_free(pcre2_jit_stack *);\n860\t\n861\t\n862\t/* Other miscellaneous functions. */\n863\t\n864\t#define PCRE2_OTHER_FUNCTIONS \\\n865\tPCRE2_EXP_DECL int PCRE2_CALL_CONVENTION \\\n866\t  pcre2_get_error_message(int, PCRE2_UCHAR *, PCRE2_SIZE); \\\n867\tPCRE2_EXP_DECL const uint8_t *PCRE2_CALL_CONVENTION \\\n868\t  pcre2_maketables(pcre2_general_context *); \\\n869\tPCRE2_EXP_DECL void PCRE2_CALL_CONVENTION \\\n870\t  pcre2_maketables_free(pcre2_general_context *, const uint8_t *);\n871\t\n872\t/* Define macros that generate width-specific names from generic versions. The\n873\tthree-level macro scheme is necessary to get the macros expanded when we want\n874\tthem to be. First we get the width from PCRE2_LOCAL_WIDTH, which is used for\n875\tgenerating three versions of everything below. After that, PCRE2_SUFFIX will be\n876\tre-defined to use PCRE2_CODE_UNIT_WIDTH, for use when macros such as\n877\tpcre2_compile are called by application code. */\n878\t\n879\t#define PCRE2_JOIN(a,b) a ## b\n880\t#define PCRE2_GLUE(a,b) PCRE2_JOIN(a,b)\n881\t#define PCRE2_SUFFIX(a) PCRE2_GLUE(a,PCRE2_LOCAL_WIDTH)\n882\t\n883\t\n884\t/* Data types */\n885\t\n886\t#define PCRE2_UCHAR                 PCRE2_SUFFIX(PCRE2_UCHAR)\n887\t#define PCRE2_SPTR                  PCRE2_SUFFIX(PCRE2_SPTR)\n888\t\n889\t#define pcre2_code                  PCRE2_SUFFIX(pcre2_code_)\n890\t#define pcre2_jit_callback          PCRE2_SUFFIX(pcre2_jit_callback_)\n891\t#define pcre2_jit_stack             PCRE2_SUFFIX(pcre2_jit_stack_)\n892\t\n893\t#define pcre2_real_code             PCRE2_SUFFIX(pcre2_real_code_)\n894\t#define pcre2_real_general_context  PCRE2_SUFFIX(pcre2_real_general_context_)\n895\t#define pcre2_real_compile_context  PCRE2_SUFFIX(pcre2_real_compile_context_)\n896\t#define pcre2_real_convert_context  PCRE2_SUFFIX(pcre2_real_convert_context_)\n897\t#define pcre2_real_match_context    PCRE2_SUFFIX(pcre2_real_match_context_)\n898\t#define pcre2_real_jit_stack        PCRE2_SUFFIX(pcre2_real_jit_stack_)\n899\t#define pcre2_real_match_data       PCRE2_SUFFIX(pcre2_real_match_data_)\n900\t\n901\t\n902\t/* Data blocks */\n903\t\n904\t#define pcre2_callout_block            PCRE2_SUFFIX(pcre2_callout_block_)\n905\t#define pcre2_callout_enumerate_block  PCRE2_SUFFIX(pcre2_callout_enumerate_block_)\n906\t#define pcre2_substitute_callout_block PCRE2_SUFFIX(pcre2_substitute_callout_block_)\n907\t#define pcre2_general_context          PCRE2_SUFFIX(pcre2_general_context_)\n908\t#define pcre2_compile_context          PCRE2_SUFFIX(pcre2_compile_context_)\n909\t#define pcre2_convert_context          PCRE2_SUFFIX(pcre2_convert_context_)\n910\t#define pcre2_match_context            PCRE2_SUFFIX(pcre2_match_context_)\n911\t#define pcre2_match_data               PCRE2_SUFFIX(pcre2_match_data_)\n912\t\n913\t\n914\t/* Functions: the complete list in alphabetical order */\n915\t\n916\t#define pcre2_callout_enumerate               PCRE2_SUFFIX(pcre2_callout_enumerate_)\n917\t#define pcre2_code_copy                       PCRE2_SUFFIX(pcre2_code_copy_)\n918\t#define pcre2_code_copy_with_tables           PCRE2_SUFFIX(pcre2_code_copy_with_tables_)\n919\t#define pcre2_code_free                       PCRE2_SUFFIX(pcre2_code_free_)\n920\t#define pcre2_compile                         PCRE2_SUFFIX(pcre2_compile_)\n921\t#define pcre2_compile_context_copy            PCRE2_SUFFIX(pcre2_compile_context_copy_)\n922\t#define pcre2_compile_context_create          PCRE2_SUFFIX(pcre2_compile_context_create_)\n923\t#define pcre2_compile_context_free            PCRE2_SUFFIX(pcre2_compile_context_free_)\n924\t#define pcre2_config                          PCRE2_SUFFIX(pcre2_config_)\n925\t#define pcre2_convert_context_copy            PCRE2_SUFFIX(pcre2_convert_context_copy_)\n926\t#define pcre2_convert_context_create          PCRE2_SUFFIX(pcre2_convert_context_create_)\n927\t#define pcre2_convert_context_free            PCRE2_SUFFIX(pcre2_convert_context_free_)\n928\t#define pcre2_converted_pattern_free          PCRE2_SUFFIX(pcre2_converted_pattern_free_)\n929\t#define pcre2_dfa_match                       PCRE2_SUFFIX(pcre2_dfa_match_)\n930\t#define pcre2_general_context_copy            PCRE2_SUFFIX(pcre2_general_context_copy_)\n931\t#define pcre2_general_context_create          PCRE2_SUFFIX(pcre2_general_context_create_)\n932\t#define pcre2_general_context_free            PCRE2_SUFFIX(pcre2_general