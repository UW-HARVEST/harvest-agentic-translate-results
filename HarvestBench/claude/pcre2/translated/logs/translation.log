           {\n3180\t              SCHECK_PARTIAL();\n3181\t              RRETURN(MATCH_NOMATCH);\n3182\t              }\n3183\t            GETCHARINCTEST(fc, Feptr);\n3184\t            if ((fc == CHAR_DOLLAR_SIGN || fc == CHAR_COMMERCIAL_AT ||\n3185\t                 fc == CHAR_GRAVE_ACCENT || (fc >= 0xa0 && fc <= 0xd7ff) ||\n3186\t                 fc >= 0xe000) == notmatch)\n3187\t              RRETURN(MATCH_NOMATCH);\n3188\t            }\n3189\t          break;\n3190\t\n3191\t          case PT_BIDICL:\n3192\t          for (i = 1; i <= Lmin; i++)\n3193\t            {\n3194\t            if (Feptr >= mb->end_subject)\n3195\t              {\n3196\t              SCHECK_PARTIAL();\n3197\t              RRETURN(MATCH_NOMATCH);\n3198\t              }\n3199\t            GETCHARINCTEST(fc, Feptr);\n3200\t            if ((UCD_BIDICLASS(fc) == Lpropvalue) == notmatch)\n3201\t              RRETURN(MATCH_NOMATCH);\n3202\t            }\n3203\t          break;\n3204\t\n3205\t          case PT_BOOL:\n3206\t          for (i = 1; i <= Lmin; i++)\n3207\t            {\n3208\t            BOOL ok;\n3209\t            const ucd_record *prop;\n3210\t            if (Feptr >= mb->end_subject)\n3211\t              {\n3212\t              SCHECK_PARTIAL();\n3213\t              RRETURN(MATCH_NOMATCH);\n3214\t              }\n3215\t            GETCHARINCTEST(fc, Feptr);\n3216\t            prop = GET_UCD(fc);\n3217\t            ok = MAPBIT(PRIV(ucd_boolprop_sets) +\n3218\t              UCD_BPROPS_PROP(prop), Lpropvalue) != 0;\n3219\t            if (ok == notmatch)\n3220\t              RRETURN(MATCH_NOMATCH);\n3221\t            }\n3222\t          break;\n3223\t\n3224\t          /* This should not occur */\n3225\t\n3226\t          /* LCOV_EXCL_START */\n3227\t          default:\n3228\t          PCRE2_DEBUG_UNREACHABLE();\n3229\t          return PCRE2_ERROR_INTERNAL;\n3230\t          /* LCOV_EXCL_STOP */\n3231\t          }\n3232\t        }\n3233\t\n3234\t      /* Match extended Unicode sequences. We will get here only if the\n3235\t      support is in the binary; otherwise a compile-time error occurs. */\n3236\t\n3237\t      else if (Lctype == OP_EXTUNI)\n3238\t        {\n3239\t        for (i = 1; i <= Lmin; i++)\n3240\t          {\n3241\t          if (Feptr >= mb->end_subject)\n3242\t            {\n3243\t            SCHECK_PARTIAL();\n3244\t            RRETURN(MATCH_NOMATCH);\n3245\t            }\n3246\t          else\n3247\t            {\n3248\t            GETCHARINCTEST(fc, Feptr);\n3249\t            Feptr = PRIV(extuni)(fc, Feptr, mb->start_subject,\n3250\t              mb->end_subject, utf, NULL);\n3251\t            }\n3252\t          CHECK_PARTIAL();\n3253\t          }\n3254\t        }\n3255\t      else\n3256\t#endif     /* SUPPORT_UNICODE */\n3257\t\n3258\t/* Handle all other cases in UTF mode */\n3259\t\n3260\t#ifdef SUPPORT_UNICODE\n3261\t      if (utf) switch(Lctype)\n3262\t        {\n3263\t        case OP_ANY:\n3264\t        for (i = 1; i <= Lmin; i++)\n3265\t          {\n3266\t          if (Feptr >= mb->end_subject)\n3267\t            {\n3268\t            SCHECK_PARTIAL();\n3269\t            RRETURN(MATCH_NOMATCH);\n3270\t            }\n3271\t          if (IS_NEWLINE(Feptr)) RRETURN(MATCH_NOMATCH);\n3272\t          if (mb->partial != 0 &&\n3273\t              Feptr + 1 >= mb->end_subject &&\n3274\t              NLBLOCK->nltype == NLTYPE_FIXED &&\n3275\t              NLBLOCK->nllen == 2 &&\n3276\t              *Feptr == NLBLOCK->nl[0])\n3277\t            {\n3278\t            mb->hitend = TRUE;\n3279\t            if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n3280\t            }\n3281\t          Feptr++;\n3282\t          ACROSSCHAR(Feptr < mb->end_subject, Feptr, Feptr++);\n3283\t          }\n3284\t        break;\n3285\t\n3286\t        case OP_ALLANY:\n3287\t        for (i = 1; i <= Lmin; i++)\n3288\t          {\n3289\t          if (Feptr >= mb->end_subject)\n3290\t            {\n3291\t            SCHECK_PARTIAL();\n3292\t            RRETURN(MATCH_N