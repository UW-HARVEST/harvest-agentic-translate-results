ions\n9263\tare discarded, because they can cause conflicts with actual literals that\n9264\tfollow. However, if we end up without a first code unit setting for an\n9265\tunanchored pattern, it is worth scanning the regex to see if there is an\n9266\tinitial asserted first code unit. If all branches start with the same asserted\n9267\tcode unit, or with a non-conditional bracket all of whose alternatives start\n9268\twith the same asserted code unit (recurse ad lib), then we return that code\n9269\tunit, with the flags set to zero or REQ_CASELESS; otherwise return zero with\n9270\tREQ_NONE in the flags.\n9271\t\n9272\tArguments:\n9273\t  code       points to start of compiled pattern\n9274\t  flags      points to the first code unit flags\n9275\t  inassert   non-zero if in an assertion\n9276\t\n9277\tReturns:     the fixed first code unit, or 0 with REQ_NONE in flags\n9278\t*/\n9279\t\n9280\tstatic uint32_t\n9281\tfind_firstassertedcu(PCRE2_SPTR code, uint32_t *flags, uint32_t inassert)\n9282\t{\n9283\tuint32_t c = 0;\n9284\tuint32_t cflags = REQ_NONE;\n9285\t\n9286\t*flags = REQ_NONE;\n9287\tdo {\n9288\t   uint32_t d;\n9289\t   uint32_t dflags;\n9290\t   int xl = (*code == OP_CBRA || *code == OP_SCBRA ||\n9291\t             *code == OP_CBRAPOS || *code == OP_SCBRAPOS)? IMM2_SIZE:0;\n9292\t   PCRE2_SPTR scode = first_significant_code(code + 1+LINK_SIZE + xl, TRUE);\n9293\t   PCRE2_UCHAR op = *scode;\n9294\t\n9295\t   switch(op)\n9296\t     {\n9297\t     default:\n9298\t     return 0;\n9299\t\n9300\t     case OP_BRA:\n9301\t     case OP_BRAPOS:\n9302\t     case OP_CBRA:\n9303\t     case OP_SCBRA:\n9304\t     case OP_CBRAPOS:\n9305\t     case OP_SCBRAPOS:\n9306\t     case OP_ASSERT:\n9307\t     case OP_ASSERT_NA:\n9308\t     case OP_ONCE:\n9309\t     case OP_SCRIPT_RUN:\n9310\t     d = find_firstassertedcu(scode, &dflags, inassert +\n9311\t       ((op == OP_ASSERT || op == OP_ASSERT_NA)?1:0));\n9312\t     if (dflags >= REQ_NONE) return 0;\n9313\t     if (cflags >= REQ_NONE) { c = d; cflags = dflags; }\n9314\t       else if (c != d || cflags != dflags) return 0;\n9315\t     break;\n9316\t\n9317\t     case OP_EXACT:\n9318\t     scode += IMM2_SIZE;\n9319\t     PCRE2_FALLTHROUGH /* Fall through */\n9320\t\n9321\t     case OP_CHAR:\n9322\t     case OP_PLUS:\n9323\t     case OP_MINPLUS:\n9324\t     case OP_POSPLUS:\n9325\t     if (inassert == 0) return 0;\n9326\t     if (cflags >= REQ_NONE) { c = scode[1]; cflags = 0; }\n9327\t       else if (c != scode[1]) return 0;\n9328\t     break;\n9329\t\n9330\t     case OP_EXACTI:\n9331\t     scode += IMM2_SIZE;\n9332\t     PCRE2_FALLTHROUGH /* Fall through */\n9333\t\n9334\t     case OP_CHARI:\n9335\t     case OP_PLUSI:\n9336\t     case OP_MINPLUSI:\n9337\t     case OP_POSPLUSI:\n9338\t     if (inassert == 0) return 0;\n9339\t\n9340\t     /* If the character is more than one code unit long, we cannot set its\n9341\t     first code unit when matching caselessly. Later scanning may pick up\n9342\t     multiple code units. */\n9343\t\n9344\t#ifdef SUPPORT_UNICODE\n9345\t#if PCRE2_CODE_UNIT_WIDTH == 8\n9346\t     if (scode[1] >= 0x80) return 0;\n9347\t#elif PCRE2_CODE_UNIT_WIDTH == 16\n9348\t     if (scode[1] >= 0xd800 && scode[1] <= 0xdfff) return 0;\n9349\t#endif\n9350\t#endif\n9351\t\n9352\t     if (cflags >= REQ_NONE) { c = scode[1]; cflags = REQ_CASELESS; }\n9353\t       else if (c != scode[1]) return 0;\n9354\t     break;\n9355\t     }\n9356\t\n9357\t   code += GET(code, 1);\n9358\t   }\n9359\twhile (*code == OP_ALT);\n9360\t\n9361\t*flags = cflags;\n9362\treturn c;\n9363\t}\n9364\t\n9365\t\n9366\t\n9367\t/*************************************************\n9368\t*             Skip in parsed pattern             *\n9369\t*************************************************/\n9370\t\n9371\t/* This function is called to skip parts of the parsed pattern when finding the\n9372\tlength of a lookbehind branch. It is called after (*ACCEPT) and (*FAIL) to find\n9373\tthe end of the branch, it is called to skip over an internal lookaround or\n9374\t(DEFINE) group, and it is also called to skip to the end of a class, during\n9375\twhich it will never encounter nested groups (but there's no need to have\n9376\tspecial code for that).\n9377\t\n9378\tWhen called to find the end of a branch or group, pptr must point to the first\n9379\tmeta code inside the branch, not the branch-starting code. In other cases it\n9380\tcan point to the item that causes the function to be called.\n9381\t\n9382\tArguments:\n9383\t  pptr       current pointer to skip from\n9384\t  skiptype   PSKIP_CLASS when skipping to end of class\n9385\t             PSKIP_ALT when META_ALT ends the skip\n9386\t             PSKIP_KET when only META_KET ends the skip\n9387\t\n9388\tReturns:     new value of pptr\n9389\t             NULL if META_END is reached - should never occur\n9390\t               or for an unknown meta value - likewise\n9391\t*/\n9392\t\n9393\tstatic uint32_t *\n9394\tparsed_skip(uint32_t *pptr, uint32_t skiptype)\n9395\t{\n9396\tuint32_t nestlevel = 0;\n9397\t\n9398\tfor (;; pptr++)\n9399\t  {\n9400\t  uint32_t meta = META_CODE(*pptr);\n9401\t\n9402\t  switch(meta)\n9403\t    {\n9404\t    default:  /* Just skip over most items */\n9405\t    if (meta < META_END) continue;  /* Literal */\n9406\t    break;\n9407\t\n9408\t    /* The parsed regex is malformed; we have reached the end and did\n9409\t    not find the end of the construct which we are skipping over. */\n9410\t\n9411\t    /* LCOV_EXCL_START */\n9412\t    case META_END:\n9413\t    PCRE2_DEBUG_UNREACHABLE();\n9414\t    return NULL;\n9415\t    /* LCOV_EXCL_STOP */\n9416\t\n9417\t    /* The data for these items is variable in length. */\n9418\t\n9419\t    case META_BACKREF:  /* Offset is present only if group >= 10 */\n9420\t    if (META_DATA(*pptr) >= 10) pptr += SIZEOFFSET;\n9421\t    break;\n9422\t\n9423\t    case META_ESCAPE:\n9424\t    if (*pptr - META_ESCAPE == ESC_P || *pptr - META_ESCAPE == ESC_p)\n9425\t      pptr += 1;     /* Skip prop data */\n9426\t    break;\n9427\t\n9428\t    case META_MARK:     /* Add the length of the name. */\n9429\t    case META_COMMIT_ARG:\n9430\t    case META_PRUNE_ARG:\n9431\t    case META_SKIP_ARG:\n9432\t    case META_THEN_ARG:\n9433\t    pptr += pptr[1];\n9434\t    break;\n9435\t\n9436\t    /* These are the \"active\" items in this loop. */\n9437\t\n9438\t    case META_CLASS_END:\n9439\t    if (skiptype == PSKIP_CLASS) return pptr;\n9440\t    break;\n9441\t\n9442\t    case META_ATOMIC:\n9443\t    case META_CAPTURE:\n9444\t    case META_COND_ASSERT:\n9445\t    case META_COND_DEFINE:\n9446\t    case META_COND_NAME:\n9447\t    case META_COND_NUMBER:\n9448\t    case META_COND_RNAME:\n9449\t    case META_COND_RNUMBER:\n9450\t    case META_COND_VERSION:\n9451\t    case META_SCS:\n9452\t    case META_LOOKAHEAD:\n9453\t    case META_LOOKAHEADNOT:\n9454\t    case META_LOOKAHEAD_NA:\n9455\t    case META_LOOKBEHIND:\n9456\t    case META_LOOKBEHINDNOT:\n9457\t    case META_LOOKBEHIND_NA:\n9458\t    case META_NOCAPTURE:\n9459\t    case META_SCRIPT_RUN:\n9460\t    nestlevel++;\n9461\t    break;\n9462\t\n9463\t    case META_ALT:\n9464\t    if (nestlevel == 0 && skiptype == PSKIP_ALT) return pptr;\n9465\t    break;\n9466\t\n9467\t    case META_KET:\n9468\t    if (nestlevel == 0) return pptr;\n9469\t    nestlevel--;\n9470\t    break;\n9471\t    }\n9472\t\n9473\t  /* The extra data item length for each meta is in a table. */\n9474\t\n9475\t  meta = (meta >> 16) & 0x7fff;\n9476\t  if (meta >= sizeof(meta_extra_lengths)) return NULL;\n9477\t  pptr += meta_extra_lengths[meta];\n9478\t  }\n9479\t\n9480\t/* LCOV_EXCL_START */\n9481\tPCRE2_UNREACHABLE(); /* Control never reaches here */\n9482\t/* LCOV_EXCL_STOP */\n9483\t}\n9484\t\n9485\t\n9486\t\n9487\t/*************************************************\n9488\t*       Find length of a parsed group            *\n9489\t*************************************************/\n9490\t\n9491\t/* This is called for nested groups within a branch of a lookbehind whose\n9492\tlength is being computed. On entry, the pointer must be at the first element\n9493\tafter the group initializing code. On exit it points to OP_KET. Caching is used\n9494\tto improve processing speed when the same capturing group occurs many times.\n9495\t\n9496\tArguments:\n9497\t  pptrptr     pointer to pointer in the parsed pattern\n9498\t  minptr      where to return the minimum length\n9499\t  isinline    FALSE if a reference or recursion; TRUE for inline group\n9500\t  errcodeptr  pointer to the errorcode\n9501\t  lcptr       pointer to the loop counter\n9502\t  group       number of captured group or -1 for a non-capturing group\n9503\t  recurses    chain of recurse_check to catch mutual recursion\n9504\t  cb          pointer to the compile data\n9505\t\n9506\tReturns:      the maximum group length or a negative number\n9507\t*/\n9508\t\n9509\tstatic int\n9510\tget_grouplength(uint32_t **pptrptr, int *minptr, BOOL isinline, int *errcodeptr,\n9511\t  int *lcptr, int group, parsed_recurse_check *recurses, compile_block *cb)\n9512\t{\n9513\tuint32_t *gi = cb->groupinfo + 2 * group;\n9514\tint branchlength, branchminlength;\n9515\tint grouplength = -1;\n9516\tint groupminlength = INT_MAX;\n9517\t\n9518\t/* The cache can be used only if there is no possibility of there being two\n9519\tgroups with the same number. We do not need to set the end pointer for a group\n9520\tthat is being processed as a back reference or recursion, but we must do so for\n9521\tan inline group. */\n9522\t\n9523\tif (group > 0 && (cb->external_flags & PCRE2_DUPCAPUSED) == 0)\n9524\t  {\n9525\t  uint32_t groupinfo = gi[0];\n9526\t  if ((groupinfo & GI_NOT_FIXED_LENGTH) != 0) return -1;\n9527\t  if ((groupinfo & GI_SET_FIXED_LENGTH) != 0)\n9528\t    {\n9529\t    if (isinline) *pptrptr = parsed_skip(*pptrptr, PSKIP_KET);\n9530\t    *minptr = gi[1];\n9531\t    return groupinfo & GI_FIXED_LENGTH_MASK;\n9532\t    }\n9533\t  }\n9534\t\n9535\t/* Scan the group. In this case we find the end pointer of necessity. */\n9536\t\n9537\tfor(;;)\n9538\t  {\n9539\t  branchlength = get_branchlength(pptrptr, &branchminlength, errcodeptr, lcptr,\n9540\t    recurses, cb);\n9541\t  if (branchlength < 0) goto ISNOTFIXED;\n9542\t  if (branchlength > grouplength) grouplength = branchlength;\n9543\t  if (branchminlength < groupminlength) groupminlength = branchminlength;\n9544\t  if (**pptrptr == META_KET) break;\n9545\t  *pptrptr += 1;   /* Skip META_ALT */\n9546\t  }\n9547\t\n9548\tif (group > 0)\n9549\t  {\n9550\t  gi[0] |= (uint32_t)(GI_SET_FIXED_LENGTH | grouplength);\n9551\t  gi[1] = groupminlength;\n9552\t  }\n9553\t\n9554\t*minptr = groupminlength;\n9555\treturn grouplength;\n9556\t\n9557\tISNOTFIXED:\n9558\tif (group > 0) gi[0] |= GI_NOT_FIXED_LENGTH;\n9559\treturn -1;\n9560\t}\n9561\t\n9562\t\n9563\t\n9564\t/*************************************************\n9565\t*        Find length of a parsed branch          *\n9566\t*************************************************/\n9567\t\n9568\t/* Return fixed maximum and minimum lengths for a branch in a lookbehind,\n9569\tgiving an error if the length is not limited. On entry, *pptrptr points to the\n9570\tfirst element inside the branch. On exit it is set to point to the ALT or KET.\n9571\t\n9572\tArguments:\n9573\t  pptrptr     pointer to pointer in the parsed pattern\n9574\t  minptr      where to return the minimum length\n9575\t  errcodeptr  pointer to error code\n9576\t  lcptr       pointer to loop counter\n9577\t  recurses    chain of recurse_check to catch mutual recursion\n9578\t  cb          pointer to compile block\n9579\t\n9580\tReturns:      the maximum length, or a negative value on error\n9581\t*/\n9582\t\n9583\tstatic int\n9584\tget_branchlength(uint32_t **pptrptr, int *minptr, int *errcodeptr, int *lcptr,\n9585\t  parsed_recurse_check *recurses, compile_block *cb)\n9586\t{\n9587\tint branchlength = 0;\n9588\tint branchminlength = 0;\n9589\tint grouplength, groupminlength;\n9590\tuint32_t lastitemlength = 0;\n9591\tuint32_t lastitemminlength = 0;\n9592\tuint32_t *pptr = *pptrptr;\n9593\tPCRE2_SIZE offset;\n9594\tparsed_recurse_check this_recurse;\n9595\t\n9596\t/* A large and/or complex regex can take too long to process. This can happen\n9597\tmore often when (?| groups are present in the pattern because their length\n9598\tcannot be cached. */\n9599\t\n9600\tif ((*lcptr)++ > 2000)\n9601\t  {\n9602\t  *errcodeptr = ERR35;  /* Lookbehind is too complicated */\n9603\t  return -1;\n9604\t  }\n9605\t\n9606\t/* Scan the branch, accumulating the length. */\n9607\t\n9608\tfor (;; pptr++)\n9609\t  {\n9610\t  parsed_recurse_check *r;\n9611\t  uint32_t *gptr, *gptrend;\n9612\t  uint32_t escape;\n9613\t  uint32_t min, max;\n9614\t  uint32_t group = 0;\n9615\t  uint32_t itemlength = 0;\n9616\t  uint32_t itemminlength = 0;\n9617\t\n9618\t  if (*pptr < META_END)\n9619\t    {\n9620\t    itemlength = itemminlength = 1;\n9621\t    }\n9622\t\n9623\t  else switch (META_CODE(*pptr))\n9624\t    {\n9625\t    case META_KET:\n9626\t    case META_ALT:\n9627\t    goto EXIT;\n9628\t\n9629\t    /* (*ACCEPT) and (*FAIL) terminate the branch, but we must skip to the\n9630\t    actual termination. */\n9631\t\n9632\t    case META_ACCEPT:\n9633\t    case META_FAIL:\n9634\t    pptr = parsed_skip(pptr, PSKIP_ALT);\n9635\t    if (pptr == NULL) goto PARSED_SKIP_FAILED;\n9636\t    goto EXIT;\n9637\t\n9638\t    case META_MARK:\n9639\t    case META_COMMIT_ARG:\n9640\t    case META_PRUNE_ARG:\n9641\t    case META_SKIP_ARG:\n9642\t    case META_THEN_ARG:\n9643\t    pptr += pptr[1] + 1;\n9644\t    break;\n9645\t\n9646\t    case META_CIRCUMFLEX:\n9647\t    case META_COMMIT:\n9648\t    case META_DOLLAR:\n9649\t    case META_PRUNE:\n9650\t    case META_SKIP:\n9651\t    case META_THEN:\n9652\t    break;\n9653\t\n9654\t    case META_OPTIONS:\n9655\t    pptr += 2;\n9656\t    break;\n9657\t\n9658\t    case META_BIGVALUE:\n9659\t    itemlength = itemminlength = 1;\n9660\t    pptr += 1;\n9661\t    break;\n9662\t\n9663\t    case META_CLASS:\n9664\t    case META_CLASS_NOT:\n9665\t    itemlength = itemminlength = 1;\n9666\t    pptr = parsed_skip(pptr, PSKIP_CLASS);\n9667\t    if (pptr == NULL) goto PARSED_SKIP_FAILED;\n9668\t    break;\n9669\t\n9670\t    case META_CLASS_EMPTY_NOT:\n9671\t    case META_DOT:\n9672\t    itemlength = itemminlength = 1;\n9673\t    break;\n9674\t\n9675\t    case META_CALLOUT_NUMBER:\n9676\t    pptr += 3;\n9677\t    break;\n9678\t\n9679\t    case META_CALLOUT_STRING:\n9680\t    pptr += 3 + SIZEOFFSET;\n9681\t    break;\n9682\t\n9683\t    /* Only some escapes consume a character. Of those, \\R can match one or two\n9684\t    characters, but \\X is never allowed because it matches an unknown number of\n9685\t    characters. \\C is allowed only in 32-bit and non-UTF 8/16-bit modes. */\n9686\t\n9687\t    case META_ESCAPE:\n9688\t    escape = META_DATA(*pptr);\n9689\t    if (escape == ESC_X) return -1;\n9690\t    if (escape == ESC_R)\n9691\t      {\n9692\t      itemminlength = 1;\n9693\t      itemlength = 2;\n9694\t      }\n9695\t    else if (escape > ESC_b && escape < ESC_Z)\n9696\t      {\n9697\t#if PCRE2_CODE_UNIT_WIDTH != 32\n9698\t      if ((cb->external_options & PCRE2_UTF) != 0 && escape == ESC_C)\n9699\t        {\n9700\t        *errcodeptr = ERR36;\n9701\t        return -1;\n9702\t        }\n9703\t#endif\n9704\t      itemlength = itemminlength = 1;\n9705\t      if (escape == ESC_p || escape == ESC_P) pptr++;  /* Skip prop data */\n9706\t      }\n9707\t    break;\n9708\t\n9709\t    /* Lookaheads do not contribute to the length of this branch, but they may\n9710\t    contain lookbehinds within them whose lengths need to be set. */\n9711\t\n9712\t    case META_LOOKAHEAD:\n9713\t    case META_LOOKAHEADNOT:\n9714\t    case META_LOOKAHEAD_NA:\n9715\t    case META_SCS:\n9716\t    *errcodeptr = check_lookbehinds(pptr + 1, &pptr, recurses, cb, lcptr);\n9717\t    if (*errcodeptr != 0) return -1;\n9718\t\n9719\t    /* Ignore any qualifiers that follow a lookahead assertion. */\n9720\t\n9721\t    switch (pptr[1])\n9722\t      {\n9723\t      case META_ASTERISK:\n9724\t      case META_ASTERISK_PLUS:\n9725\t      case META_ASTERISK_QUERY:\n9726\t      case META_PLUS:\n9727\t      case META_PLUS_PLUS:\n9728\t      case META_PLUS_QUERY:\n9729\t      case META_QUERY:\n9730\t      case META_QUERY_PLUS:\n9731\t      case META_QUERY_QUERY:\n9732\t      pptr++;\n9733\t      break;\n9734\t\n9735\t      case META_MINMAX:\n9736\t      case META_MINMAX_PLUS:\n9737\t      case META_MINMAX_QUERY:\n9738\t      pptr += 3;\n9739\t      break;\n9740\t\n9741\t      default:\n9742\t      break;\n9743\t      }\n9744\t    break;\n9745\t\n9746\t    /* A nested lookbehind does not contribute any length to this lookbehind,\n9747\t    but must itself be checked and have its lengths set. Note that\n9748\t    set_lookbehind_lengths() updates pptr, leaving it pointing to the final ket\n9749\t    of the group, so no need to update it here. */\n9750\t\n9751\t    case META_LOOKBEHIND:\n9752\t    case META_LOOKBEHINDNOT:\n9753\t    case META_LOOKBEHIND_NA:\n9754\t    if (!set_lookbehind_lengths(&pptr, errcodeptr, lcptr, recurses, cb))\n9755\t      return -1;\n9756\t    break;\n9757\t\n9758\t    /* Back references and recursions are handled by very similar code. At this\n9759\t    stage, the names generated in the parsing pass are available, but the main\n9760\t    name table has not yet been created. So for the named varieties, scan the\n9761\t    list of names in order to get the number of the first one in the pattern,\n9762\t    and whether or not this name is duplicated. */\n9763\t\n9764\t    case META_BACKREF_BYNAME:\n9765\t    if ((cb->external_options & PCRE2_MATCH_UNSET_BACKREF) != 0)\n9766\t      goto ISNOTFIXED;\n9767\t    PCRE2_FALLTHROUGH /* Fall through */\n9768\t\n9769\t    case META_RECURSE_BYNAME:\n9770\t      {\n9771\t      PCRE2_SPTR name;\n9772\t      BOOL is_dupname = FALSE;\n9773\t      named_group *ng;\n9774\t      uint32_t meta_code = META_CODE(*pptr);\n9775\t      uint32_t length = *(++pptr);\n9776\t\n9777\t      GETPLUSOFFSET(offset, pptr);\n9778\t      name = cb->start_pattern + offset;\n9779\t      ng = PRIV(compile_find_named_group)(name, length, cb);\n9780\t\n9781\t      if (ng == NULL)\n9782\t        {\n9783\t        *errcodeptr = ERR15;  /* Non-existent subpattern */\n9784\t        cb->erroroffset = offset;\n9785\t        return -1;\n9786\t        }\n9787\t\n9788\t      group = ng->number;\n9789\t      is_dupname = (ng->hash_dup & NAMED_GROUP_IS_DUPNAME) != 0;\n9790\t\n9791\t      /* A numerical back reference can be fixed length if duplicate capturing\n9792\t      groups are not being used. A non-duplicate named back reference can also\n9793\t      be handled. */\n9794\t\n9795\t      if (meta_code == META_RECURSE_BYNAME ||\n9796\t          (!is_dupname && (cb->external_flags & PCRE2_DUPCAPUSED) == 0))\n9797\t        goto RECURSE_OR_BACKREF_LENGTH;  /* Handle as a numbered version. */\n9798\t      }\n9799\t    goto ISNOTFIXED;                     /* Duplicate name or number */\n9800\t\n9801\t    /* The offset values for back references < 10 are in a separate vector\n9802\t    because otherwise they would use more than two parsed pattern elements on\n9803\t    64-bit systems. */\n9804\t\n9805\t    case META_BACKREF:\n9806\t    if ((cb->external_options & PCRE2_MATCH_UNSET_BACKREF) != 0 ||\n9807\t        (cb->external_flags & PCRE2_DUPCAPUSED) != 0)\n9808\t      goto ISNOTFIXED;\n9809\t    group = META_DATA(*pptr);\n9810\t    if (group < 10)\n9811\t      {\n9812\t      offset = cb->small_ref_offset[group];\n9813\t      goto RECURSE_OR_BACKREF_LENGTH;\n9814\t      }\n9815\t\n9816\t    PCRE2_FALLTHROUGH /* Fall through */\n9817\t    /* For groups >= 10 - picking up group twice does no harm. */\n9818\t\n9819\t    /* A true recursion implies not fixed length, but a subroutine call may\n9820\t    be OK. Back reference \"recursions\" are also failed. */\n9821\t\