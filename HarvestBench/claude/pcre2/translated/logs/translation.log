 DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE\n35\tLIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR\n36\tCONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF\n37\tSUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\n38\tINTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\n39\tCONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\n40\tARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE\n41\tPOSSIBILITY OF SUCH DAMAGE.\n42\t-----------------------------------------------------------------------------\n43\t*/\n44\t\n45\t\n46\t#ifndef PCRE2_UCP_H_IDEMPOTENT_GUARD\n47\t#define PCRE2_UCP_H_IDEMPOTENT_GUARD\n48\t\n49\t/* This file contains definitions of the Unicode property values that are\n50\treturned by the UCD access macros and used throughout PCRE2.\n51\t\n52\tIMPORTANT: The specific values of the first two enums (general and particular\n53\tcharacter categories) are assumed by the table called catposstab in the file\n54\tpcre2_auto_possess.c. They are unlikely to change, but should be checked after\n55\tan update. */\n56\t\n57\t/* These are the general character categories. */\n58\t\n59\tenum {\n60\t  ucp_C,\n61\t  ucp_L,\n62\t  ucp_M,\n63\t  ucp_N,\n64\t  ucp_P,\n65\t  ucp_S,\n66\t  ucp_Z,\n67\t};\n68\t\n69\t/* These are the particular character categories. */\n70\t\n71\tenum {\n72\t  ucp_Cc,    /* Control */\n73\t  ucp_Cf,    /* Format */\n74\t  ucp_Cn,    /* Unassigned */\n75\t  ucp_Co,    /* Private use */\n76\t  ucp_Cs,    /* Surrogate */\n77\t  ucp_Ll,    /* Lower case letter */\n78\t  ucp_Lm,    /* Modifier letter */\n79\t  ucp_Lo,    /* Other letter */\n80\t  ucp_Lt,    /* Title case letter */\n81\t  ucp_Lu,    /* Upper case letter */\n82\t  ucp_Mc,    /* Spacing mark */\n83\t  ucp_Me,    /* Enclosing mark */\n84\t  ucp_Mn,    /* Non-spacing mark */\n85\t  ucp_Nd,    /* Decimal number */\n86\t  ucp_Nl,    /* Letter number */\n87\t  ucp_No,    /* Other number */\n88\t  ucp_Pc,    /* Connector punctuation */\n89\t  ucp_Pd,    /* Dash punctuation */\n90\t  ucp_Pe,    /* Close punctuation */\n91\t  ucp_Pf,    /* Final punctuation */\n92\t  ucp_Pi,    /* Initial punctuation */\n93\t  ucp_Po,    /* Other punctuation */\n94\t  ucp_Ps,    /* Open punctuation */\n95\t  ucp_Sc,    /* Currency symbol */\n96\t  ucp_Sk,    /* Modifier symbol */\n97\t  ucp_Sm,    /* Mathematical symbol */\n98\t  ucp_So,    /* Other symbol */\n99\t  ucp_Zl,    /* Line separator */\n100\t  ucp_Zp,    /* Paragraph separator */\n101\t  ucp_Zs,    /* Space separator */\n102\t};\n103\t\n104\t/* These are Boolean properties. */\n105\t\n106\tenum {\n107\t  ucp_ASCII,\n108\t  ucp_ASCII_Hex_Digit,\n109\t  ucp_Alphabetic,\n110\t  ucp_Bidi_Control,\n111\t  ucp_Bidi_Mirrored,\n112\t  ucp_Case_Ignorable,\n113\t  ucp_Cased,\n114\t  ucp_Changes_When_Casefolded,\n115\t  ucp_Changes_When_Casemapped,\n116\t  ucp_Changes_When_Lowercased,\n117\t  ucp_Changes_When_Titlecased,\n118\t  ucp_Changes_When_Uppercased,\n119\t  ucp_Dash,\n120\t  ucp_Default_Ignorable_Code_Point,\n121\t  ucp_Deprecated,\n122\t  ucp_Diacritic,\n123\t  ucp_Emoji,\n124\t  ucp_Emoji_Component,\n125\t  ucp_Emoji_Modifier,\n126\t  ucp_Emoji_Modifier_Base,\n127\t  ucp_Emoji_Presentation,\n128\t  ucp_Extended_Pictographic,\n129\t  ucp_Extender,\n130\t  ucp_Grapheme_Base,\n131\t  ucp_Grapheme_Extend,\n132\t  ucp_Grapheme_Link,\n133\t  ucp_Hex_Digit,\n134\t  ucp_IDS_Binary_Operator,\n135\t  ucp_IDS_Trinary_Operator,\n136\t  ucp_IDS_Unary_Operator,\n137\t  ucp_ID_Compat_Math_Continue,\n138\t  ucp_ID_Compat_Math_Start,\n139\t  ucp_ID_Continue,\n140\t  ucp_ID_Start,\n141\t  ucp_Ideographic,\n142\t  ucp_InCB,\n143\t  ucp_Join_Control,\n144\t  ucp_Logical_Order_Exception,\n145\t  ucp_Lowercase,\n146\t  ucp_Math,\n147\t  ucp_Modifier_Combining_Mark,\n148\t  ucp_Noncharacter_Code_Point,\n149\t  ucp_Pattern_Syntax,\n150\t  ucp_Pattern_White_Space,\n151\t  ucp_Prepended_Concatenation_Mark,\n152\t  ucp_Quotation_Mark,\n153\t  ucp_Radical,\n154\t  ucp_Regional_Indicator,\n155\t  ucp_Sentence_Terminal,\n156\t  ucp_Soft_Dotted,\n157\t  ucp_Terminal_Punctuation,\n158\t  ucp_Unified_Ideograph,\n159\t  ucp_Uppercase,\n160\t  ucp_Variation_Selector,\n161\t  ucp_White_Space,\n162\t  ucp_XID_Continue,\n163\t  ucp_XID_Start,\n164\t  /* This must be last */\n165\t  ucp_Bprop_Count\n166\t};\n167\t\n168\t/* Size of entries in ucd_boolprop_sets[] */\n169\t\n170\t#define ucd_boolprop_sets_item_size 2\n171\t\n172\t/* These are the bidi class values. */\n173\t\n174\tenum {\n175\t  ucp_bidiAL,   /* Arabic_Letter */\n176\t  ucp_bidiAN,   /* Arabic_Number */\n177\t  ucp_bidiB,    /* Paragraph_Separator */\n178\t  ucp_bidiBN,   /* Boundary_Neutral */\n179\t  ucp_bidiCS,   /* Common_Separator */\n180\t  ucp_bidiEN,   /* European_Number */\n181\t  ucp_bidiES,   /* European_Separator */\n182\t  ucp_bidiET,   /* European_Terminator */\n183\t  ucp_bidiFSI,  /* First_Strong_Isolate */\n184\t  ucp_bidiL,    /* Left_To_Right */\n185\t  ucp_bidiLRE,  /* Left_To_Right_Embedding */\n186\t  ucp_bidiLRI,  /* Left_To_Right_Isolate */\n187\t  ucp_bidiLRO,  /* Left_To_Right_Override */\n188\t  ucp_bidiNSM,  /* Nonspacing_Mark */\n189\t  ucp_bidiON,   /* Other_Neutral */\n190\t  ucp_bidiPDF,  /* Pop_Directional_Format */\n191\t  ucp_bidiPDI,  /* Pop_Directional_Isolate */\n192\t  ucp_bidiR,    /* Right_To_Left */\n193\t  ucp_bidiRLE,  /* Right_To_Left_Embedding */\n194\t  ucp_bidiRLI,  /* Right_To_Left_Isolate */\n195\t  ucp_bidiRLO,  /* Right_To_Left_Override */\n196\t  ucp_bidiS,    /* Segment_Separator */\n197\t  ucp_bidiWS,   /* White_Space */\n198\t};\n199\t\n200\t/* These are grapheme break properties. The Extended Pictographic property\n201\tcomes from the emoji-data.txt file. */\n202\t\n203\tenum {\n204\t  ucp_gbCR,                    /*  0 */\n205\t  ucp_gbLF,                    /*  1 */\n206\t  ucp_gbControl,               /*  2 */\n207\t  ucp_gbExtend,             