int i = 0; i < 8; i++) classwords[i] = ~classwords[i];\n1725\t      }\n1726\t\n1727\t    if (has_bitmap == NULL)\n1728\t      {\n1729\t      *code++ |= XCL_MAP;\n1730\t      (void)memmove(code + (32 / sizeof(PCRE2_UCHAR)), code,\n1731\t        CU2BYTES(class_uchardata - code));\n1732\t      memcpy(code, classbits, 32);\n1733\t      code = class_uchardata + (32 / sizeof(PCRE2_UCHAR));\n1734\t      }\n1735\t    else\n1736\t      {\n1737\t      code = class_uchardata;\n1738\t      if ((xclass_props & XCLASS_HAS_8BIT_CHARS) != 0)\n1739\t        *has_bitmap = TRUE;\n1740\t      }\n1741\t    }\n1742\t  else code = class_uchardata;\n1743\t\n1744\t  if ((xclass_props & XCLASS_HAS_CHAR_LISTS) != 0)\n1745\t    {\n1746\t    /* Char lists size is an even number, because all items are 16 or 32\n1747\t    bit values. The character list data is always aligned to 32 bits. */\n1748\t    size_t char_lists_size = cranges->char_lists_size;\n1749\t    PCRE2_ASSERT((char_lists_size & 0x1) == 0 &&\n1750\t                 (cb->char_lists_size & 0x3) == 0);\n1751\t\n1752\t    if (lengthptr != NULL)\n1753\t      {\n1754\t      char_lists_size = CLIST_ALIGN_TO(char_lists_size, sizeof(uint32_t));\n1755\t\n1756\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1757\t      *lengthptr += 2 + LINK_SIZE;\n1758\t#else\n1759\t      *lengthptr += 1 + LINK_SIZE;\n1760\t#endif\n1761\t\n1762\t      cb->char_lists_size += char_lists_size;\n1763\t\n1764\t      char_lists_size /= sizeof(PCRE2_UCHAR);\n1765\t\n1766\t      /* Storage space for character lists is included\n1767\t      in the maximum pattern size. */\n1768\t      if (*lengthptr > MAX_PATTERN_SIZE ||\n1769\t          MAX_PATTERN_SIZE - *lengthptr < char_lists_size)\n1770\t        {\n1771\t        *errorcodeptr = ERR20;   /* Pattern is too large */\n1772\t        return NULL;\n1773\t        }\n1774\t      }\n1775\t    else\n1776\t      {\n1777\t      uint8_t *data;\n1778\t\n1779\t      PCRE2_ASSERT(cranges->char_lists_types <= XCL_TYPE_MASK);\n1780\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1781\t      /* Encode as high / low bytes. */\n1782\t      code[0] = (uint8_t)(XCL_LIST |\n1783\t        (cranges->char_lists_types >> 8));\n1784\t      code[1] = (uint8_t)cranges->char_lists_types;\n1785\t      code += 2;\n1786\t#else\n1787\t      *code++ = (PCRE2_UCHAR)(XCL_LIST | cranges->char_lists_types);\n1788\t#endif\n1789\t\n1790\t      /* Character lists are stored in backwards direction from\n1791\t      byte code start. The non-dfa/dfa matchers can access these\n1792\t      lists using the byte code start stored in match blocks.\n1793\t      Each list is aligned to 32 bit with an optional unused\n1794\t      16 bit value at the beginning of the character list. */\n1795\t\n1796\t      cb->char_lists_size += char_lists_size;\n1797\t      data = (uint8_t*)cb->start_code - cb->char_lists_size;\n1798\t\n1799\t      memcpy(data, (uint8_t*)(cranges + 1) + cranges->char_lists_start,\n1800\t        char_lists_size);\n1801\t\n1802\t      /* Since character lists total size is less than MAX_PATTERN_SIZE,\n1803\t      their starting offset fits into a value which size is LINK_SIZE. */\n1804\t\n1805\t      char_lists_size = cb->char_lists_size;\n1806\t      PUT(code, 0, (uint32_t)(char_lists_size >> 1));\n1807\t      code += LINK_SIZE;\n1808\t\n1809\t      /* If we added padding to align the list, initialize the bytes to\n1810\t      defined values, so the library is valgrind-clean. It could also\n1811\t      be a security concern for clients calling into PCRE2 via bindings\n1812\t      from a memory-safe language, if pcre2_serialize_encode() exposes\n1813\t      uninitialized memory that may contain sensitive information. */\n1814\t\n1815\t      if ((char_lists_size & 0x2) != 0)\n1816\t        ((uint16_t*)data)[-1] = 0xdead;\n1817\t\n1818\t      cb->char_lists_size =\n1819\t        CLIST_ALIGN_TO(char_lists_size, sizeof(uint32_t));\n1820\t\n1821\t      cb->cx->memctl.free(cranges, cb->cx->memctl.memory_data);\n1822\t      }\n1823\t    }\n1824\t\n1825\t  /* Now fill in the complete length of the item */\n1826\t\n1827\t  PUT(previous, 1, (int)(code - previous));\n1828\t  goto DONE;   /* End of class handling */\n1829\t  }\n1830\t#endif  /* SUPPORT_WIDE_CHARS */\n1831\t\n1832\t/* If there are no characters > 255, or they are all to be included or\n1833\texcluded, set the opcode to OP_CLASS or OP_NCLASS, depending on whether the\n1834\twhole class was negated and whether there were negative specials such as \\S\n1835\t(non-UCP) in the class. Then copy the 32-byte map into the code vector,\n1836\tnegating it if necessary. */\n1837\t\n1838\tif (negate_class)\n1839\t  {\n1840\t  uint32_t *classwords = cb->classbits.classwords;\n1841\t\n1842\t  for (int i = 0; i < 8; i++) classwords[i] = ~classwords[i];\n1843\t  }\n1844\t\n1845\tif ((SELECT_VALUE8(!utf, 0) || negate_class != should_flip_negation) &&\n1846\t    cb->classbits.classwords[0] == ~(uint32_t)0)\n1847\t  {\n1848\t  const uint32_t *classwords = cb->classbits.classwords;\n1849\t  int i;\n1850\t\n1851\t  for (i = 0; i < 8; i++)\n1852\t    if (classwords[i] != ~(uint32_t)0) break;\n1853\t\n1854\t  if (i == 8)\n1855\t    {\n1856\t    *code++ = OP_ALLANY;\n1857\t    goto DONE;   /* End of class handling */\n1858\t    }\n1859\t  }\n1860\t\n1861\t*code++ = (negate_class == should_flip_negation) ? OP_CLASS : OP_NCLASS;\n1862\tmemcpy(code, classbits, 32);\n1863\tcode += 32 / sizeof(PCRE2_UCHAR);\n1864\t\n1865\tDONE:\n1866\t*pcode = code;\n1867\treturn pptr - 1;\n1868\t}\n1869\t\n1870\t\n1871\t\n1872\t/* ===================================================================*/\n1873\t/* Here follows a block of ECLASS-compiling functions. You may well want to\n1874\tread them from top to bottom; they are ordered from leafmost (at the top) to\n1875\toutermost parser (at the bottom of the file). */\n1876\t\n1877\t/* This function folds one operand using the negation operator.\n1878\tThe new, combined chunk of stack code is written out to *pop_info. */\n1879\t\n1880\tstatic void\n1881\tfold_negation(eclass_op_info *pop_info, PCRE2_SIZE *lengthptr,\n1882\t  BOOL preserve_classbits)\n1883\t{\n1884\t/* If the chunk of stack code is already composed of multiple ops, we won't\n1885\tdescend in and try and propagate the negation down the tree. (That would lead\n1886\tto O(n^2) compile-time, which could be exploitable with a malicious regex -\n1887\talthough maybe that's not really too much of a worry in a library that offers\n1888\tan exponential-time matching function!) */\n1889\t\n1890\tif (pop_info->op_single_type == 0)\n1891\t  {\n1892\t  if (lengthptr != NULL)\n1893\t    *lengthptr += 1;\n1894\t  else\n1895\t    pop_info->code_start[pop_info->length] = ECL_NOT;\n1896\t  pop_info->length += 1;\n1897\t  }\n1898\t\n1899\t/* Otherwise, it's a nice single-op item, so we can easily fold in the negation\n1900\twithout needing to produce an ECL_NOT. */\n1901\t\n1902\telse if (pop_info->op_single_type == ECL_ANY ||\n1903\t         pop_info->op_single_type == ECL_NONE)\n1904\t  {\n1905\t  pop_info->op_single_type = (pop_info->op_single_type == ECL_NONE)?\n1906\t      ECL_ANY : ECL_NONE;\n1907\t  if (lengthptr == NULL)\n1908\t    *(pop_info->code_start) = pop_info->op_single_type;\n1909\t  }\n1910\telse\n1911\t  {\n1912\t  PCRE2_ASSERT(pop_info->op_single_type == ECL_XCLASS &&\n1913\t               pop_info->length >= 1 + LINK_SIZE + 1);\n1914\t  if (lengthptr == NULL)\n1915\t    pop_info->code_start[1 + LINK_SIZE] ^= XCL_NOT;\n1916\t  }\n1917\t\n1918\tif (!preserve_classbits)\n1919\t  {\n1920\t  for (int i = 0; i < 8; i++)\n1921\t    pop_info->bits.classwords[i] = ~pop_info->bits.classwords[i];\n1922\t  }\n1923\t}\n1924\t\n1925\t\n1926\t\n1927\t/* This function folds together two operands using a binary operator.\n1928\tThe new, combined chunk of stack code is written out to *lhs_op_info. */\n1929\t\n1930\tstatic void\n1931\tfold_binary(int op, eclass_op_info *lhs_op_info, eclass_op_info *rhs_op_info,\n1932\t  PCRE2_SIZE *lengthptr)\n1933\t{\n1934\tswitch (op)\n1935\t  {\n1936\t  /* ECL_AND truth table:\n1937\t\n1938\t     LHS  RHS  RESULT\n1939\t     ----------------\n1940\t     ANY  *    RHS\n1941\t     *    ANY  LHS\n1942\t     NONE *    NONE\n1943\t     *    NONE NONE\n1944\t     X    Y    X & Y\n1945\t  */\n1946\t\n1947\t  case ECL_AND:\n1948\t  if (rhs_op_info->op_single_type == ECL_ANY)\n1949\t    {\n1950\t    /* no-op: drop the RHS */\n1951\t    }\n1952\t  else if (lhs_op_info->op_single_type == ECL_ANY)\n1953\t    {\n1954\t    /* no-op: drop the LHS, and memmove the RHS into its place */\n1955\t    if (lengthptr == NULL)\n1956\t      memmove(lhs_op_info->code_start, rhs_op_info->code_start,\n1957\t              CU2BYTES(rhs_op_info->length));\n1958\t    lhs_op_info->length = rhs_op_info->length;\n1959\t    lhs_op_info->op_single_type = rhs_op_info->op_single_type;\n1960\t    }\n1961\t  else if (rhs_op_info->op_single_type == ECL_NONE)\n1962\t    {\n1963\t    /* the result is ECL_NONE: write into the LHS */\n1964\t    if (lengthptr == NULL)\n1965\t      lhs_op_info->code_start[0] = ECL_NONE;\n1966\t    lhs_op_info->length = 1;\n1967\t    lhs_op_info->op_single_type = ECL_NONE;\n1968\t    }\n1969\t  else if (lhs_op_info->op_single_type == ECL_NONE)\n1970\t    {\n1971\t    /* the result is ECL_NONE: drop the RHS */\n1972\t    }\n1973\t  else\n1974\t    {\n1975\t    /* Both of LHS & RHS are either ECL_XCLASS, or compound operations. */\n1976\t    if (lengthptr != NULL)\n1977\t      *lengthptr += 1;\n1978\t    else\n1979\t      {\n1980\t      PCRE2_ASSERT(rhs_op_info->code_start ==\n1981\t          lhs_op_info->code_start + lhs_op_info->length);\n1982\t      rhs_op_info->code_start[rhs_op_info->length] = ECL_AND;\n1983\t      }\n1984\t    lhs_op_info->length += rhs_op_info->length + 1;\n1985\t    lhs_op_info->op_single_type = 0;\n1986\t    }\n1987\t\n1988\t  for (int i = 0; i < 8; i++)\n1989\t    lhs_op_info->bits.classwords[i] &= rhs_op_info->bits.classwords[i];\n1990\t  break;\n1991\t\n1992\t  /* ECL_OR truth table:\n1993\t\n1994\t     LHS  RHS  RESULT\n1995\t     ----------------\n1996\t     ANY  *    ANY\n1997\t     *    ANY  ANY\n1998\t     NONE *    RHS\n1999\t     *    NONE LHS\n2000\t     X    Y    X | Y\n2001\t  */\n2002\t\n2003\t  case ECL_OR:\n2004\t  if (rhs_op_info->op_single_type == ECL_NONE)\n2005\t    {\n2006\t    /* no-op: drop the RHS */\n2007\t    }\n2008\t  else if (lhs_op_info->op_single_type == ECL_NONE)\n2009\t    {\n2010\t    /* no-op: drop the LHS, and memmove the RHS into its place */\n2011\t    if (lengthptr == NULL)\n2012\t      memmove(lhs_op_info->code_start, rhs_op_info->code_start,\n2013\t              CU2BYTES(rhs_op_info->length));\n2014\t    lhs_op_info->length = rhs_op_info->length;\n2015\t    lhs_op_info->op_single_type = rhs_op_info->op_single_type;\n2016\t    }\n2017\t  else if (rhs_op_info->op_single_type == ECL_ANY)\n2018\t    {\n2019\t    /* the result is ECL_ANY: write into the LHS */\n2020\t    if (lengthptr == NULL)\n2021\t      lhs_op_info->code_start[0] = ECL_ANY;\n2022\t    lhs_op_info->length = 1;\n2023\t    lhs_op_info->op_single_type = ECL_ANY;\n2024\t    }\n2025\t  else if (lhs_op_info->op_single_type == ECL_ANY)\n2026\t    {\n2027\t    /* the result is ECL_ANY: drop the RHS */\n2028\t    }\n2029\t  else\n2030\t    {\n2031\t    /* Both of LHS & RHS are either ECL_XCLASS, or compound operations. */\n2032\t    if (lengthptr != NULL)\n2033\t      *lengthptr += 1;\n2034\t    else\n2035\t      {\n2036\t      PCRE2_ASSERT(rhs_op_info->code_start ==\n2037\t          lhs_op_info->code_start + lhs_op_info->length);\n2038\t      rhs_op_info->code_start[rhs_op_info->length] = ECL_OR;\n2039\t      }\n2040\t    lhs_op_info->length += rhs_op_info->length + 1;\n2041\t    lhs_op_info->op_single_type = 0;\n2042\t    }\n2043\t\n2044\t  for (int i = 0; i < 8; i++)\n2045\t    lhs_op_info->bits.classwords[i] |= rhs_op_info->bits.classwords[i];\n2046\t  break;\n2047\t\n2048\t  /* ECL_XOR truth table:\n2049\t\n2050\t     LHS  RHS  RESULT\n2051\t     ----------------\n2052\t     ANY  *    !RHS\n2053\t     *    ANY  !LHS\n2054\t     NONE *    RHS\n2055\t     *    NONE LHS\n2056\t     X    Y    X ^ Y\n2057\t  */\n2058\t\n2059\t  case ECL_XOR:\n2060\t  if (rhs_op_info->op_single_type == ECL_NONE)\n2061\t    {\n2062\t    /* no-op: drop the RHS */\n2063\t    }\n2064\t  else if (lhs_op_info->op_single_type == ECL_NONE)\n2065\t    {\n2066\t    /* no-op: drop the LHS, and memmove the RHS into its place */\n2067\t    if (lengthptr == NULL)\n2068\t      memmove(lhs_op_info->code_start, rhs_op_info->code_start,\n2069\t              CU2BYTES(rhs_op_info->length));\n2070\t    lhs_op_info->length = rhs_op_info->length;\n2071\t    lhs_op_info->op_single_type = rhs_op_info->op_single_type;\n2072\t    }\n2073\t  else if (rhs_op_info->op_single_type == ECL_ANY)\n2074\t    {\n2075\t    /* the result is !LHS: fold in the negation, and drop the RHS */\n2076\t    /* Preserve the classbits, because we promise to deal with them later. */\n2077\t    fold_negation(lhs_op_info, lengthptr, TRUE);\n2078\t    }\n2079\t  else if (lhs_op_info->op_single_type == ECL_ANY)\n2080\t    {\n2081\t    /* the result is !RHS: drop the LHS, memmove the RHS into its place, and\n2082\t    fold in the negation */\n2083\t    if (lengthptr == NULL)\n2084\t      memmove(lhs_op_info->code_start, rhs_op_info->code_start,\n2085\t              CU2BYTES(rhs_op_info->length));\n2086\t    lhs_op_info->length = rhs_op_info->length;\n2087\t    lhs_op_info->op_single_type = rhs_op_info->op_single_type;\n2088\t\n2089\t    /* Preserve the classbits, because we promise to deal with them later. */\n2090\t    fold_negation(lhs_op_info, lengthptr, TRUE);\n2091\t    }\n2092\t  else\n2093\t    {\n2094\t    /* Both of LHS & RHS are either ECL_XCLASS, or compound operations. */\n2095\t    if (lengthptr != NULL)\n2096\t      *lengthptr += 1;\n2097\t    else\n2098\t      {\n2099\t      PCRE2_ASSERT(rhs_op_info->code_start ==\n2100\t          lhs_op_info->code_start + lhs_op_info->length);\n2101\t      rhs_op_info->code_start[rhs_op_info->length] = ECL_XOR;\n2102\t      }\n2103\t    lhs_op_info->length += rhs_op_info->length + 1;\n2104\t    lhs_op_info->op_single_type = 0;\n2105\t    }\n2106\t\n2107\t  for (int i = 0; i < 8; i++)\n2108\t    lhs_op_info->bits.classwords[i] ^= rhs_op_info->bits.classwords[i];\n2109\t  break;\n2110\t\n2111\t  /* LCOV_EXCL_START */\n2112\t  default:\n2113\t  PCRE2_DEBUG_UNREACHABLE();\n2114\t  break;\n2115\t  /* LCOV_EXCL_STOP */\n2116\t  }\n2117\t}\n2118\t\n2119\t\n2120\t\n2121\tstatic BOOL\n2122\tcompile_eclass_nested(eclass_context *context, BOOL negated,\n2123\t  uint32_t **pptr, PCRE2_UCHAR **pcode,\n2124\t  eclass_op_info *pop_info, PCRE2_SIZE *lengthptr);\n2125\t\n2126\t/* This function consumes a group of implicitly-unioned class elements.\n2127\tThese can be characters, ranges, properties, or nested classes, as long\n2128\tas they are all joined by being placed adjacently. */\n2129\t\n2130\tstatic BOOL\n2131\tcompile_class_operand(eclass_context *context, BOOL negated,\n2132\t  uint32_t **pptr, PCRE2_UCHAR **pcode, eclass_op_info *pop_info,\n2133\t  PCRE2_SIZE *lengthptr)\n2134\t{\n2135\tuint32_t *ptr = *pptr;\n2136\tuint32_t *prev_ptr;\n2137\tPCRE2_UCHAR *code = *pcode;\n2138\tPCRE2_UCHAR *code_start = code;\n2139\tPCRE2_SIZE prev_length = (lengthptr != NULL)? *lengthptr : 0;\n2140\tPCRE2_SIZE extra_length;\n2141\tuint32_t meta = META_CODE(*ptr);\n2142\t\n2143\tswitch (meta)\n2144\t  {\n2145\t  case META_CLASS_EMPTY_NOT:\n2146\t  case META_CLASS_EMPTY:\n2147\t  ++ptr;\n2148\t  pop_info->length = 1;\n2149\t  if ((meta == META_CLASS_EMPTY) == negated)\n2150\t    {\n2151\t    *code++ = pop_info->op_single_type = ECL_ANY;\n2152\t    memset(pop_info->bits.classbits, 0xff, 32);\n2153\t    }\n2154\t  else\n2155\t    {\n2156\t    *code++ = pop_info->op_single_type = ECL_NONE;\n2157\t    memset(pop_info->bits.classbits, 0, 32);\n2158\t    }\n2159\t  break;\n2160\t\n2161\t  case META_CLASS:\n2162\t  case META_CLASS_NOT:\n2163\t  if ((*ptr & CLASS_IS_ECLASS) != 0)\n2164\t    {\n2165\t    if (!compile_eclass_nested(context, negated, &ptr, &code,\n2166\t                               pop_info, lengthptr))\n2167\t      return FALSE;\n2168\t\n2169\t    PCRE2_ASSERT(*ptr == META_CLASS_END);\n2170\t    ptr++;\n2171\t    goto DONE;\n2172\t    }\n2173\t\n2174\t  ptr++;\n2175\t  PCRE2_FALLTHROUGH /* Fall through */\n2176\t\n2177\t  default:\n2178\t  /* Scan forward characters, ranges, and properties.\n2179\t  For example: inside [a-z_ -- m] we don't have brackets around \"a-z_\" but\n2180\t  we still need to collect that fragment up into a \"leaf\" OP_CLASS. */\n2181\t\n2182\t  prev_ptr = ptr;\n2183\t  ptr = PRIV(compile_class_not_nested)(\n2184\t    context->options, context->xoptions, ptr, &code,\n2185\t    (meta != META_CLASS_NOT) == negated, &context->needs_bitmap,\n2186\t    context->errorcodeptr, context->cb, lengthptr);\n2187\t  if (ptr == NULL) return FALSE;\n2188\t\n2189\t  /* We must have a 100% guarantee that ptr increases when\n2190\t  compile_class_operand() returns, even on Release builds, so that we can\n2191\t  statically prove our loops terminate. */\n2192\t  /* LCOV_EXCL_START */\n2193\t  if (ptr <= prev_ptr)\n2194\t    {\n2195\t    PCRE2_DEBUG_UNREACHABLE();\n2196\t    return FALSE;\n2197\t    }\n2198\t  /* LCOV_EXCL_STOP */\n2199\t\n2200\t  /* If we fell through above, consume the closing ']'. */\n2201\t  if (meta == META_CLASS || meta == META_CLASS_NOT)\n2202\t    {\n2203\t    PCRE2_ASSERT(*ptr == META_CLASS_END);\n2204\t    ptr++;\n2205\t    }\n2206\t\n2207\t  /* Regardless of whether (lengthptr == NULL), some data will still be written\n2208\t  out to *pcode, which we need: we have to peek at it, to transform the opcode\n2209\t  into the ECLASS version (since we need to hoist up the bitmaps). */\n2210\t  PCRE2_ASSERT(code > code_start);\n2211\t  extra_length = (lengthptr != NULL)? *lengthptr - prev_length : 0;\n2212\t\n2213\t  /* Easiest case: convert OP_ALLANY to ECL_ANY */\n2214\t\n2215\t  if (*code_start == OP_ALLANY)\n2216\t    {\n2217\t    PCRE2_ASSERT(code - code_start == 1 && extra_length == 0);\n2218\t    pop_info->length = 1;\n2219\t    *code_start = pop_info->op_single_type = ECL_ANY;\n2220\t    memset(pop_info->bits.classbits, 0xff, 32);\n2221\t    }\n2222\t\n2223\t  /* For OP_CLASS and OP_NCLASS, we hoist out the bitmap and convert to\n2224\t  ECL_NONE / ECL_ANY respectively. */\n2225\t\n2226\t  else if (*code_start == OP_CLASS || *code_start == OP_NCLASS)\n2227\t    {\n2228\t    PCRE2_ASSERT(code - code_start == 1 + 32 / sizeof(PCRE2_UCHAR) &&\n2229\t                 extra_length == 0);\n2230\t    pop_info->length = 1;\n2231\t    *code_start = pop_info->op_single_type =\n2232\t        (*code_start == OP_CLASS)? ECL_NONE : ECL_ANY;\n2233\t    memcpy(pop_info->bits.classbits, code_start + 1, 32);\n2234\t    /* Rewind the code pointer, but make sure we adjust *lengthptr, because we\n2235\t    do need to reserve that space (even though we only use it temporarily). */\n2236\t    if (lengthptr != NULL)\n2237\t      *lengthptr += code - (code_start + 1);\n2238\t    code = code_start + 1;\n2239\t\n2240\t    if (!context->needs_bitmap && *code_start == ECL_NONE)\n2241\t      {\n2242\t      uint32_t *classwords = pop_info->bits.classwords;\n2243\t\n2244\t      for (int i = 0; i < 8; i++)\n2245\t        if (classwords[i] != 0)\n2246\t          {\n2247\t          context->needs_bitmap = TRUE;\n2248\t          break;\n2249\t          }\n2250\t      }\n2251\t    else\n2252\t      context->needs_bitmap = TRUE;\n2253\t    }\n2254\t\n2255\t  /* Finally, for OP_XCLASS we hoist out the bitmap (if any), and convert to\n2256\t  ECL_XCLASS. */\n2257\t\n2258\t  else\n2259\t    {\n2260\t    PCRE2_ASSERT(*code_start == OP_XCLASS);\n2261\t    *code_start = pop_info->op_single_type = ECL_XCLASS;\n2262\t\n2263\t    PCRE2_ASSERT(code - code_start >= 1 + LINK_SIZE + 1);\n2264\t\n2265\t    memcpy(pop_info->bits.classbits, context->cb->classbits.classbits, 32);\n2266\t    pop_info->length = (code - code_start) + extra_length;\n2267\t    }\n2268\t\n2269\t  break;\n2270\t  }  /* End of switch(meta) */\n2271\t\n2272\tpop_info->code_start = (lengthptr == NULL)? code_start : NULL;\n2273\t\n2274\tif (lengthptr != NULL)\n2275\t  {\n2276\t  *lengthptr += code - code_start;\n2277\t  code = code_start;\n2278\t  }\n2279\t\n2280\tDONE:\n2281\tPCRE2_ASSERT(lengthptr == NULL || (code == code_start));\n2282\t\n2283\t*pptr = ptr;\n2284\t*pcode = code;\n2285\treturn TRUE;\n2286\t}\n2287\t\n2288\t\n2289\t\n2290\t/* This function consumes a group of implicitly-unioned class elements.\n2291\tThese can be characters, ranges, properties, or nested classes, as long\n2292\tas they are all joined by being placed adjacently. */\n2293\t\n2294\tstatic BOOL\n2295\tcompile_class_juxtaposition(eclass_context *context, BOOL negated,\n2296\t  uint32_t **pptr, PCRE2_UCHAR **pcode, eclass_op_info *pop_info,\n2297\t  PCRE2_SIZE *lengthptr)\n2298\t{\n2299\tuint32_t *ptr = *pptr;\n2300\tPCRE2_UCHAR *code = *pcode;\n2301\t#ifdef PCRE2_DEBUG\n2302\tPCRE2_UCHAR *start_code = *pcode;\n2303\t#endif\n2304\t\n2305\t/* See compile_class_binary_loose() for comments on compile-time folding of\n2306\tthe \"negated\" flag. */\n2307\t\n2308\t/* Because it's a non-empty class, there must be an operand at the start. */\n2309\tif (!compile_class_operand(context, negated, &ptr, &code, pop_info, lengthptr))\n2310\t  return FALSE;\n2311\t\n2312\twhile (*ptr != META_CLASS_END &&\n2313\t       !(*ptr >= META_ECLASS_AND && *ptr <= META_ECLASS_NOT))\n2314\t  {\n2315\t  uint32_t op;\n2316\t  BOOL rhs_negated;\n2317\t  eclass_op_info rhs_op_info;\n2318\t\n2319\t  if (negated)\n2320\t    {\n2321\t    /* !(A juxtapose B)  ->  !A && !B */\n2322\t    op = ECL_AND;\n2323\t    rhs_negated = TRUE;\n2324\t    }\n2325\t  else\n2326\t    {\n2327\t    /* A juxtapose B  ->  A || B */\n2328\t    op = ECL_OR;\n2329\t    rhs_negated = FALSE;\n2330\t    }\n2331\t\n2332\t  /* An operand must follow the operator. */\n2333\t  if (!compile_class_operand(context, rhs_negated, &ptr, &code,\n2334\t                             &rhs_op_info, lengthptr))\n2335\t    return FALSE;\n2336\t\n2337\t  /* Convert infix to postfix (RPN). */\n2338\t  fold_binary(op, pop_info, &rhs_op_info, lengthptr);\n2339\t  if (lengthptr == NULL)\n2340\t    code = pop_info->code_start + pop_info->length;\n2341\t  }\n2342\t\n2343\tPCRE2_ASSERT(lengthptr == NULL || code == start_code);\n2344\t\n2345\t*pptr = ptr;\n2346\t*pcode = code;\n2347\treturn TRUE;\n2348\t}\n2349\t\n2350\t\n2351\t\n2352\t/* This function consumes unary prefix operators. */\n2353\t\n2354\tstatic BOOL\n2355\tcompile_class_unary(eclass_context *context, BOOL negated,\n2356\t  uint32_t **pptr, PCRE2_UCHAR **pcode, eclass_op_info *pop_info,\n2357\t  PCRE2_SIZE *lengthptr)\n2358\t{\n2359\tuint32_t *ptr = *pptr;\n2360\t#ifdef PCRE2_DEBUG\n2361\tPCRE2_UCHAR *start_code = *pcode;\n2362\t#endif\n2363\t\n2364\twhile (*ptr == META_ECLASS_NOT)\n2365\t  {\n2366\t  ++ptr;\n2367\t  negated = !negated;\n2368\t  }\n2369\t\n2370\t*pptr = ptr;\n2371\t/* Because it's a non-empty class, there must be an operand. */\n2372\tif (!compile_class_juxtaposition(context, negated, pptr, pcode,\n2373\t                                 pop_info, lengthptr))\n2374\t  return FALSE;\n2375\t\n2376\tPCRE2_ASSERT(lengthptr == NULL || *pcode == start_code);\n2377\treturn TRUE;\n2378\t}\n2379\t\n2380\t\n2381\t\n2382\t/* This function consumes tightly-binding binary operators. */\n2383\t\n2384\tstatic BOOL\n2385\tcompile_class_binary_tight(eclass_context *context, BOOL negated,\n2386\t  uint32_t **pptr, PCRE2_UCHAR **pcode, eclass_op_info *pop_info,\n2387\t  PCRE2_SIZE *lengthptr)\n2388\t{\n2389\tuint32_t *ptr = *pptr;\n2390\tPCRE2_UCHAR *code = *pcode;\n2391\t#ifdef PCRE2_DEBUG\n2392\tPCRE2_UCHAR *start_code = *pcode;\n2393\t#endif\n2394\t\n2395\t/* See compile_class_binary_loose() for comments on compile-time folding of\n2396\tthe \"negated\" flag. */\n2397\t\n2398\t/* Because it's a non-empty class, there must be an operand at the start. */\n2399\tif (!compile_class_unary(context, negated, &ptr, &code, pop_info, lengthptr))\n2400\t  return FALSE;\n2401\t\n2402\twhile (*ptr == META_ECLASS_AND)\n2403\t  {\n2404\t  uint32_t op;\n2405\t  BOOL rhs_negated;\n2406\t  eclass_op_info rhs_op_info;\n2407\t\n2408\t  if (negated)\n2409\t    {\n2410\t    /* !(A && B)  ->  !A || !B */\n2411\t    op = ECL_OR;\n2412\t    rhs_negated = TRUE;\n2413\t    }\n2414\t  else\n2415\t    {\n2416\t    /* A && B  ->  A && B */\n2417\t    op = ECL_AND;\n2418\t    rhs_negated = FALSE;\n2419\t    }\n2420\t\n2421\t  ++ptr;\n2422\t\n2423\t  /* An operand must follow the operator. */\n2424\t  if (!compile_class_unary(context, rhs_negated, &ptr, &code,\n2425\t                           &rhs_op_info, lengthptr))\n2426\t    return FALSE;\n2427\t\n2428\t  /* Convert infix to postfix (RPN). */\n2429\t  fold_binary(op, pop_info, &rhs_op_info, lengthptr);\n2430\t  if (lengthptr == NULL)\n2431\t    code = pop_info->code_start + pop_info->length;\n2432\t  }\n2433\t\n2434\tPCRE2_ASSERT(lengthptr == NULL || code == start_code);\n2435\t\n2436\t*pptr = ptr;\n2437\t*pcode = code;\n2438\treturn TRUE;\n2439\t}\n2440\t\n2441\t\n2442\t\n2443\t/* This function consumes loosely-binding binary operators. */\n2444\t\n2445\tstatic BOOL\n2446\tcompile_class_binary_loose(eclass_context *context, BOOL negated,\n2447\t  uint32_t **pptr, PCRE2_UCHAR **pcode, eclass_op_info *pop_info,\n2448\t  PCRE2_SIZE *lengthptr)\n2449\t{\n2450\tuint32_t *ptr = *pptr;\n2451\tPCRE2_UCHAR *code = *pcode;\n2452\t#ifdef PCRE2_DEBUG\n2453\tPCRE2_UCHAR *start_code = *pcode;\n2454\t#endif\n2455\t\n2456\t/* We really want to fold the negation operator, if at all possible, so that\n2457\tsimple cases can be reduced down. In particular, in 8-bit no-UTF mode, we want\n2458\tto produce a fully-folded expression, so that we can guarantee not to emit any\n2459\tOP_ECLASS codes (in the same way that we never emit OP_XCLASS in this mode).\n2460\t\n2461\tThis has the consequence that with a little ingenuity, we can in fact avoid\n2462\temitting (nearly...) all cases of the \"NOT\" operator. Imagine that we have:\n2463\t    !(A ...\n2464\tWe have parsed the preceding \"!\", and we are about to parse the \"A\" operand. We\n2465\tdon't know yet whether there will even be a following binary operand! Both of\n2466\tthese are possibilities for what follows:\n2467\t    !(A && B)\n2468\t    !(A)\n2469\tHowever, we can still fold the \"!\" into the \"A\" operand, because no matter what\n2470\tthe following binary operator will be, we can produce an expression which is\n2471\tequivalent. */\n2472\t\n2473\t/* Because it's a non-empty class, there must be an operand at the start. */\n2474\tif (!compile_class_binary_tight(context, negated, &ptr, &code,\n2475\t                                pop_info, lengthptr))\n2476\t  return FALSE;\n2477\t\n2478\twhile (*ptr >= META_ECLASS_OR && *ptr <= META_ECLASS_XOR)\n2479\t  {\n2480\t  uint32_t op;\n2481\t  BOOL op_neg;\n2482\t  BOOL rhs_negated;\n2483\t  eclass_op_info rhs_op_info;\n2484\t\n2485\t  if (negated)\n2486\t    {\n2487\t    /* The whole expression is being negated; we respond by unconditionally\n2488\t    negating the LHS A, before seeing what follows. And hooray! We can recover,\n2489\t    no matter what follows. */\n2490\t    /* !(A || B)   ->  !A && !B                     */\n2491\t    /* !(A -- B)   ->  !(A && !B)    ->  !A || B    */\n2492\t    /* !(A XOR B)  ->  !(!A XOR !B)  ->  !A XNOR !B */\n2493\t    op = (*ptr == META_ECLASS_OR )? ECL_AND :\n2494\t         (*ptr == META_ECLASS_SUB)? ECL_OR  :\n2495\t         /*ptr == META_ECLASS_XOR*/ ECL_XOR;\n2496\t    op_neg = (*ptr == META_ECLASS_XOR);\n2497\t    rhs_negated = *ptr != META_ECLASS_SUB;\n2498\t    }\n2499\t  else\n2500\t    {\n2501\t    /* A || B   ->  A || B  */\n2502\t    /* A -- B   ->  A && !B */\n2503\t    /* A XOR B  ->  A XOR B */\n2504\t    op = (*ptr == META_ECLASS_OR )? ECL_OR  :\n2505\t         (*ptr == META_ECLASS_SUB)? ECL_AND :\n2506\t         /*ptr == META_ECLASS_XOR*/ ECL_XOR;\n2507\t    op_neg = FALSE;\n2508\t    rhs_negated = *ptr == META_ECLASS_SUB;\n2509\t    }\n2510\t\n2511\t  ++ptr;\n2512\t\n2513\t  /* An operand must follow the operator. */\n2514\t  if (!compile_class_binary_tight(context, rhs_negated, &ptr, &code,\n2515\t                                  &rhs_op_info, lengthptr))\n2516\t    return FALSE;\n2517\t\n2518\t  /* Convert infix to postfix (RPN). */\n2519\t  fold_binary(op, pop_info, &rhs_op_info, lengthptr);\n2520\t  if (op_neg) fold_negation(pop_info, lengthptr, FALSE);\n2521\t  if (lengthptr == NULL)\n2522\t    code = pop_info->code_start + pop_info->length;\n2523\t  }\n2524\t\n2525\tPCRE2_ASSERT(lengthptr == NULL || code == start_code);\n2526\t\n2527\t*pptr = ptr;\n2528\t*pcode = code;\n2529\treturn TRUE;\n2530\t}\n2531\t\n2532\t\n2533\t\n2534\t/* This function converts the META codes in pptr into opcodes written to\n2535\tpcode. The pptr must start at a META_CLASS or META_CLASS_NOT.\n2536\t\n2537\tThe class is compiled as a left-associative sequence of operator\n2538\tapplications.\n2539\t\n2540\tThe pptr will be left pointing at the matching META_CLASS_END. */\n2541\t\n2542\tstatic BOOL\n2543\tcompile_eclass_nested(eclass_context *context, BOOL negated,\n2544\t  uint32_t **pptr, PCRE2_UCHAR **pcode,\n2545\t  eclass_op_info *pop_info, PCRE2_SIZE *lengthptr)\n2546\t{\n2547\tuint32_t *ptr = *pptr;\n2548\t#ifdef PCRE2_DEBUG\n2549\tPCRE2_UCHAR *start_code = *pcode;\n2550\t#endif\n2551\t\n2552\t/* The CLASS_IS_ECLASS bit must be set since it is a nested class. */\n2553\tPCRE2_ASSERT(*ptr == (META_CLASS | CLASS_IS_ECLASS) ||\n2554\t             *ptr == (META_CLASS_NOT | CLASS_IS_ECLASS));\n2555\t\n2556\tif (*ptr++ == (META_CLASS_NOT | CLASS_IS_ECLASS))\n2557\t  negated = !negated;\n2558\t\n2559\t(*pptr)++;\n2560\t\n2561\t/* Because it's a non-empty class, there must be a