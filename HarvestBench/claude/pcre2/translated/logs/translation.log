{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01XswnGYZUUWDrAwhW4TiZTC","type":"tool_result","content":"1\t/*************************************************\n2\t*      Perl-Compatible Regular Expressions       *\n3\t*************************************************/\n4\t\n5\t/* PCRE is a library of functions to support regular expressions whose syntax\n6\tand semantics are as close as possible to those of the Perl 5 language.\n7\t\n8\t                       Written by Philip Hazel\n9\t     Original API code Copyright (c) 1997-2012 University of Cambridge\n10\t          New API code Copyright (c) 2015-2024 University of Cambridge\n11\t\n12\t-----------------------------------------------------------------------------\n13\tRedistribution and use in source and binary forms, with or without\n14\tmodification, are permitted provided that the following conditions are met:\n15\t\n16\t    * Redistributions of source code must retain the above copyright notice,\n17\t      this list of conditions and the following disclaimer.\n18\t\n19\t    * Redistributions in binary form must reproduce the above copyright\n20\t      notice, this list of conditions and the following disclaimer in the\n21\t      documentation and/or other materials provided with the distribution.\n22\t\n23\t    * Neither the name of the University of Cambridge nor the names of its\n24\t      contributors may be used to endorse or promote products derived from\n25\t      this software without specific prior written permission.\n26\t\n27\tTHIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\"\n28\tAND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE\n29\tIMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE\n30\tARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE\n31\tLIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR\n32\tCONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF\n33\tSUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\n34\tINTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\n35\tCONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\n36\tARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE\n37\tPOSSIBILITY OF SUCH DAMAGE.\n38\t-----------------------------------------------------------------------------\n39\t*/\n40\t\n41\t\n42\t#include \"pcre2_internal.h\"\n43\t\n44\t\n45\t\n46\t/* These defines enable debugging code */\n47\t\n48\t/* #define DEBUG_FRAMES_DISPLAY */\n49\t/* #define DEBUG_SHOW_OPS */\n50\t/* #define DEBUG_SHOW_RMATCH */\n51\t\n52\t#ifdef DEBUG_FRAMES_DISPLAY\n53\t#include <stdarg.h>\n54\t#endif\n55\t\n56\t#ifdef DEBUG_SHOW_OPS\n57\tstatic const char *OP_names[] = { OP_NAME_LIST };\n58\t#endif\n59\t\n60\t/* These defines identify the name of the block containing \"static\"\n61\tinformation, and fields within it. */\n62\t\n63\t#define NLBLOCK mb              /* Block containing newline information */\n64\t#define PSSTART start_subject   /* Field containing processed string start */\n65\t#define PSEND   end_subject     /* Field containing processed string end */\n66\t\n67\t#define RECURSE_UNSET 0xffffffffu  /* Bigger than max group number */\n68\t\n69\t/* Masks for identifying the public options that are permitted at match time. */\n70\t\n71\t#define PUBLIC_MATCH_OPTIONS \\\n72\t  (PCRE2_ANCHORED|PCRE2_ENDANCHORED|PCRE2_NOTBOL|PCRE2_NOTEOL|PCRE2_NOTEMPTY| \\\n73\t   PCRE2_NOTEMPTY_ATSTART|PCRE2_NO_UTF_CHECK|PCRE2_PARTIAL_HARD| \\\n74\t   PCRE2_PARTIAL_SOFT|PCRE2_NO_JIT|PCRE2_COPY_MATCHED_SUBJECT| \\\n75\t   PCRE2_DISABLE_RECURSELOOP_CHECK)\n76\t\n77\t#define PUBLIC_JIT_MATCH_OPTIONS \\\n78\t   (PCRE2_NO_UTF_CHECK|PCRE2_NOTBOL|PCRE2_NOTEOL|PCRE2_NOTEMPTY|\\\n79\t    PCRE2_NOTEMPTY_ATSTART|PCRE2_PARTIAL_SOFT|PCRE2_PARTIAL_HARD|\\\n80\t    PCRE2_COPY_MATCHED_SUBJECT)\n81\t\n82\t/* Non-error returns from and within the match() function. Error returns are\n83\texternally defined PCRE2_ERROR_xxx codes, which are all negative. */\n84\t\n85\t#define MATCH_MATCH        1\n86\t#define MATCH_NOMATCH      0\n87\t\n88\t/* Special internal returns used in the match() function. Make them\n89\tsufficiently negative to avoid the external error codes. */\n90\t\n91\t#define MATCH_ACCEPT       (-999)\n92\t#define MATCH_KETRPOS      (-998)\n93\t/* The next 5 must be kept together and in sequence so that a test that checks\n94\tfor any one of them can use a range. */\n95\t#define MATCH_COMMIT       (-997)\n96\t#define MATCH_PRUNE        (-996)\n97\t#define MATCH_SKIP         (-995)\n98\t#define MATCH_SKIP_ARG     (-994)\n99\t#define MATCH_THEN         (-993)\n100\t#define MATCH_BACKTRACK_MAX MATCH_THEN\n101\t#define MATCH_BACKTRACK_MIN MATCH_COMMIT\n102\t\n103\t/* Group frame type values. Zero means the frame is not a group frame. The\n104\tlower 16 bits are used for data (e.g. the capture number). Group frames are\n105\tused for most groups so that information about the start is easily available at\n106\tthe end without having to scan back through intermediate frames (backtrack\n107\tpoints). */\n108\t\n109\t#define GF_CAPTURE     0x00010000u\n110\t#define GF_NOCAPTURE   0x00020000u\n111\t#define GF_CONDASSERT  0x00030000u\n112\t#define GF_RECURSE     0x00040000u\n113\t\n114\t/* Masks for the identity and data parts of the group frame type. */\n115\t\n116\t#define GF_IDMASK(a)   ((a) & 0xffff0000u)\n117\t#define GF_DATAMASK(a) ((a) & 0x0000ffffu)\n118\t\n119\t/* Repetition types */\n120\t\n121\tenum { REPTYPE_MIN, REPTYPE_MAX, REPTYPE_POS };\n122\t\n123\t/* Min and max values for the common repeats; a maximum of UINT32_MAX =>\n124\tinfinity. */\n125\t\n126\tstatic const uint32_t rep_min[] = {\n127\t  0, 0,       /* * and *? */\n128\t  1, 1,       /* + and +? */\n129\t  0, 0,       /* ? and ?? */\n130\t  0, 0,       /* dummy placefillers for OP_CR[MIN]RANGE */\n131\t  0, 1, 0 };  /* OP_CRPOS{STAR, PLUS, QUERY} */\n132\t\n133\tstatic const uint32_t rep_max[] = {\n134\t  UINT32_MAX, UINT32_MAX,      /* * and *? */\n135\t  UINT32_MAX, UINT32_MAX,      /* + and +? */\n136\t  1, 1,                        /* ? and ?? */\n137\t  0, 0,                        /* dummy placefillers for OP_CR[MIN]RANGE */\n138\t  UINT32_MAX, UINT32_MAX, 1 }; /* OP_CRPOS{STAR, PLUS, QUERY} */\n139\t\n140\t/* Repetition types - must include OP_CRPOSRANGE (not needed above) */\n141\t\n142\tstatic const uint32_t rep_typ[] = {\n143\t  REPTYPE_MAX, REPTYPE_MIN,    /* * and *? */\n144\t  REPTYPE_MAX, REPTYPE_MIN,    /* + and +? */\n145\t  REPTYPE_MAX, REPTYPE_MIN,    /* ? and ?? */\n146\t  REPTYPE_MAX, REPTYPE_MIN,    /* OP_CRRANGE and OP_CRMINRANGE */\n147\t  REPTYPE_POS, REPTYPE_POS,    /* OP_CRPOSSTAR, OP_CRPOSPLUS */\n148\t  REPTYPE_POS, REPTYPE_POS };  /* OP_CRPOSQUERY, OP_CRPOSRANGE */\n149\t\n150\t/* Numbers for RMATCH calls at backtracking points. When these lists are\n151\tchanged, the code at RETURN_SWITCH below must be updated in sync.  */\n152\t\n153\tenum { RM1=1, RM2,  RM3,  RM4,  RM5,  RM6,  RM7,  RM8,  RM9,  RM10,\n154\t       RM11,  RM12, RM13, RM14, RM15, RM16, RM17, RM18, RM19, RM20,\n155\t       RM21,  RM22, RM23, RM24, RM25, RM26, RM27, RM28, RM29, RM30,\n156\t       RM31,  RM32, RM33, RM34, RM35, RM36, RM37, RM38, RM39 };\n157\t\n158\t#ifdef SUPPORT_WIDE_CHARS\n159\tenum { RM100=100, RM101, RM102, RM103 };\n160\t#endif\n161\t\n162\t#ifdef SUPPORT_UNICODE\n163\tenum { RM200=200, RM201, RM202, RM203, RM204, RM205, RM206, RM207,\n164\t       RM208,     RM209, RM210, RM211, RM212, RM213, RM214, RM215,\n165\t       RM216,     RM217, RM218, RM219, RM220, RM221, RM222, RM223,\n166\t       RM224 };\n167\t#endif\n168\t\n169\t/* Define short names for general fields in the current backtrack frame, which\n170\tis always pointed to by the F variable. Occasional references to fields in\n171\tother frames are written out explicitly. There are also some fields in the\n172\tcurrent frame that are used for short-term, localised backtracking memory.\n173\tThese are members of the fields union and #defined with Lxxx names at the\n174\tpoint of use and undefined afterwards. */\n175\t\n176\t#define Fback_frame        F->back_frame\n177\t#define Fcapture_last      F->capture_last\n178\t#define Fcurrent_recurse   F->current_recurse\n179\t#define Fecode             F->ecode\n180\t#define Feptr              F->eptr\n181\t#define Fgroup_frame_type  F->group_frame_type\n182\t#define Flast_group_offset F->last_group_offset\n183\t#define Fmark              F->mark\n184\t#define Frdepth            F->rdepth\n185\t#define Fstart_match       F->start_match\n186\t#define Foffset_top        F->offset_top\n187\t#define Fop                F->op\n188\t#define Fovector           F->ovector\n189\t#define Freturn_id         F->return_id\n190\t\n191\t\n192\t#ifdef DEBUG_FRAMES_DISPLAY\n193\t/*************************************************\n194\t*      Display current frames and contents       *\n195\t*************************************************/\n196\t\n197\t/* This debugging function displays the current set of frames and their\n198\tcontents. It is not called automatically from anywhere, the intention being\n199\tthat calls can be inserted where necessary when debugging frame-related\n200\tproblems.\n201\t\n202\tArguments:\n203\t  f           the file to write to\n204\t  F           the current top frame\n205\t  P           a previous frame of interest\n206\t  frame_size  the frame size\n207\t  mb          points to the match block\n208\t  match_data  points to the match data block\n209\t  s           identification text\n210\t\n211\tReturns:    nothing\n212\t*/\n213\t\n214\tstatic void\n215\tdisplay_frames(FILE *f, heapframe *F, heapframe *P, PCRE2_SIZE frame_size,\n216\t  match_block *mb, pcre2_match_data *match_data, const char *s, ...)\n217\t{\n218\tuint32_t i;\n219\theapframe *Q;\n220\tva_list ap;\n221\tva_start(ap, s);\n222\t\n223\tfprintf(f, \"FRAMES \");\n224\tvfprintf(f, s, ap);\n225\tva_end(ap);\n226\t\n227\tif (P != NULL) fprintf(f, \" P=%lu\",\n228\t  ((char *)P - (char *)(match_data->heapframes))/frame_size);\n229\tfprintf(f, \"\\n\");\n230\t\n231\tfor (i = 0, Q = match_data->heapframes;\n232\t     Q <= F;\n233\t     i++, Q = (heapframe *)((char *)Q + frame_size))\n234\t  {\n235\t  fprintf(f, \"Frame %d type=%x subj=%lu code=%d back=%lu id=%d\",\n236\t    i, Q->group_frame_type, Q->eptr - mb->start_subject, *(Q->ecode),\n237\t    Q->back_frame, Q->return_id);\n238\t\n239\t  if (Q->last_group_offset == PCRE2_UNSET)\n240\t    fprintf(f, \" lgoffset=unset\\n\");\n241\t  else\n242\t    fprintf(f, \" lgoffset=%lu\\n\",  Q->last_group_offset/frame_size);\n243\t  }\n244\t}\n245\t\n246\t#endif\n247\t\n248\t\n249\t\n250\t/*************************************************\n251\t*                Process a callout               *\n252\t*************************************************/\n253\t\n254\t/* This function is called for all callouts, whether \"standalone\" or at the\n255\tstart of a conditional group. Feptr will be pointing to either OP_CALLOUT or\n256\tOP_CALLOUT_STR. A callout block is allocated in pcre2_match() and initialized\n257\twith fixed values.\n258\t\n259\tArguments:\n260\t  F          points to the current backtracking frame\n261\t  mb         points to the match block\n262\t  lengthptr  where to return the length of the callout item\n263\t\n264\tReturns:     the return from the callout\n265\t             or 0 if no callout function exists\n266\t*/\n267\t\n268\tstatic int\n269\tdo_callout(heapframe *F, match_block *mb, PCRE2_SIZE *lengthptr)\n270\t{\n271\tint rc;\n272\tPCRE2_SIZE save0, save1;\n273\tPCRE2_SIZE *callout_ovector;\n274\tpcre2_callout_block *cb;\n275\t\n276\t*lengthptr = (*Fecode == OP_CALLOUT)?\n277\t  PRIV(OP_lengths)[OP_CALLOUT] : GET(Fecode, 1 + 2*LINK_SIZE);\n278\t\n279\tif (mb->callout == NULL) return 0;   /* No callout function provided */\n280\t\n281\t/* The original matching code (pre 10.30) worked directly with the ovector\n282\tpassed by the user, and this was passed to callouts. Now that the working\n283\tovector is in the backtracking frame, it no longer needs to reserve space for\n284\tthe overall match offsets (which would waste space in the frame). For backward\n285\tcompatibility, however, we pass capture_top and offset_vector to the callout as\n286\tif for the extended ovector, and we ensure that the first two slots are unset\n287\tby preserving and restoring their current contents. Picky compilers complain if\n288\treferences such as Fovector[-2] are use directly, so we set up a separate\n289\tpointer. */\n290\t\n291\tcallout_ovector = (PCRE2_SIZE *)(Fovector) - 2;\n292\t\n293\t/* The cb->version, cb->subject, cb->subject_length, and cb->start_match fields\n294\tare set externally. The first 3 never change; the last is updated for each\n295\tbumpalong. */\n296\t\n297\tcb = mb->cb;\n298\tcb->capture_top      = (uint32_t)Foffset_top/2 + 1;\n299\tcb->capture_last     = Fcapture_last;\n300\tcb->offset_vector    = callout_ovector;\n301\tcb->mark             = mb->nomatch_mark;\n302\tcb->current_position = (PCRE2_SIZE)(Feptr - mb->start_subject);\n303\tcb->pattern_position = GET(Fecode, 1);\n304\tcb->next_item_length = GET(Fecode, 1 + LINK_SIZE);\n305\t\n306\tif (*Fecode == OP_CALLOUT)  /* Numerical callout */\n307\t  {\n308\t  cb->callout_number = Fecode[1 + 2*LINK_SIZE];\n309\t  cb->callout_string_offset = 0;\n310\t  cb->callout_string = NULL;\n311\t  cb->callout_string_length = 0;\n312\t  }\n313\telse  /* String callout */\n314\t  {\n315\t  cb->callout_number = 0;\n316\t  cb->callout_string_offset = GET(Fecode, 1 + 3*LINK_SIZE);\n317\t  cb->callout_string = Fecode + (1 + 4*LINK_SIZE) + 1;\n318\t  cb->callout_string_length =\n319\t    *lengthptr - (1 + 4*LINK_SIZE) - 2;\n320\t  }\n321\t\n322\tsave0 = callout_ovector[0];\n323\tsave1 = callout_ovector[1];\n324\tcallout_ovector[0] = callout_ovector[1] = PCRE2_UNSET;\n325\trc = mb->callout(cb, mb->callout_data);\n326\tcallout_ovector[0] = save0;\n327\tcallout_ovector[1] = save1;\n328\tcb->callout_flags = 0;\n329\treturn rc;\n330\t}\n331\t\n332\t\n333\t\n334\t/*************************************************\n335\t*          Match a back-reference                *\n336\t*************************************************/\n337\t\n338\t/* This function is called only when it is known that the offset lies within\n339\tthe offsets that have so far been used in the match. Note that in caseless\n340\tUTF-8 mode, the number of subject bytes matched may be different to the number\n341\tof reference bytes. (In theory this could also happen in UTF-16 mode, but it\n342\tseems unlikely.)\n343\t\n344\tArguments:\n345\t  offset      index into the offset vector\n346\t  caseless    TRUE if caseless\n347\t  caseopts    bitmask of REFI_FLAG_XYZ values\n348\t  F           the current backtracking frame pointer\n349\t  mb          points to match block\n350\t  lengthptr   pointer for returning the length matched\n351\t\n352\tReturns:      = 0 sucessful match; number of code units matched is set\n353\t              < 0 no match\n354\t              > 0 partial match\n355\t*/\n356\t\n357\tstatic int\n358\tmatch_ref(PCRE2_SIZE offset, BOOL caseless, int caseopts, heapframe *F,\n359\t  match_block *mb, PCRE2_SIZE *lengthptr)\n360\t{\n361\tPCRE2_SPTR p;\n362\tPCRE2_SIZE length;\n363\tPCRE2_SPTR eptr;\n364\tPCRE2_SPTR eptr_start;\n365\t\n366\t#ifndef SUPPORT_UNICODE\n367\t(void)caseopts; /* Avoid compiler warning. */\n368\t#endif\n369\t\n370\t/* Deal with an unset group. The default is no match, but there is an option to\n371\tmatch an empty string. */\n372\t\n373\tif (offset >= Foffset_top || Fovector[offset] == PCRE2_UNSET)\n374\t  {\n375\t  if ((mb->poptions & PCRE2_MATCH_UNSET_BACKREF) != 0)\n376\t    {\n377\t    *lengthptr = 0;\n378\t    return 0;      /* Match */\n379\t    }\n380\t  else return -1;  /* No match */\n381\t  }\n382\t\n383\t/* Separate the caseless and UTF cases for speed. */\n384\t\n385\teptr = eptr_start = Feptr;\n386\tp = mb->start_subject + Fovector[offset];\n387\tlength = Fovector[offset+1] - Fovector[offset];\n388\tPCRE2_ASSERT(eptr <= mb->end_subject);\n389\t\n390\tif (caseless)\n391\t  {\n392\t#if defined SUPPORT_UNICODE\n393\t  BOOL utf = (mb->poptions & PCRE2_UTF) != 0;\n394\t  BOOL caseless_restrict = (caseopts & REFI_FLAG_CASELESS_RESTRICT) != 0;\n395\t  BOOL turkish_casing = !caseless_restrict && (caseopts & REFI_FLAG_TURKISH_CASING) != 0;\n396\t\n397\t  if (utf || (mb->poptions & PCRE2_UCP) != 0)\n398\t    {\n399\t    PCRE2_SPTR endptr = p + length;\n400\t\n401\t    /* Match characters up to the end of the reference. NOTE: the number of\n402\t    code units matched may differ, because in UTF-8 there are some characters\n403\t    whose upper and lower case codes have different numbers of bytes. For\n404\t    example, U+023A (2 bytes in UTF-8) is the upper case version of U+2C65 (3\n405\t    bytes in UTF-8); a sequence of 3 of the former uses 6 bytes, as does a\n406\t    sequence of two of the latter. It is important, therefore, to check the\n407\t    length along the reference, not along the subject (earlier code did this\n408\t    wrong). UCP uses Unicode properties but without UTF encoding. */\n409\t\n410\t    while (p < endptr)\n411\t      {\n412\t      uint32_t c, d;\n413\t      const ucd_record *ur;\n414\t      if (eptr >= mb->end_subject) return 1;   /* Partial match */\n415\t\n416\t      if (utf)\n417\t        {\n418\t        GETCHARINC(c, eptr);\n419\t        GETCHARINC(d, p);\n420\t        }\n421\t      else\n422\t        {\n423\t        c = *eptr++;\n424\t        d = *p++;\n425\t        }\n426\t\n427\t      if (turkish_casing && UCD_ANY_I(d))\n428\t        {\n429\t        c = UCD_FOLD_I_TURKISH(c);\n430\t        d = UCD_FOLD_I_TURKISH(d);\n431\t        if (c != d) return -1;  /* No match */\n432\t        }\n433\t      else if (c != d && c != (uint32_t)((int)d + (ur = GET_UCD(d))->other_case))\n434\t        {\n435\t        const uint32_t *pp = PRIV(ucd_caseless_sets) + ur->caseset;\n436\t\n437\t        /* When PCRE2_EXTRA_CASELESS_RESTRICT is set, ignore any caseless sets\n438\t        that start with an ASCII character. */\n439\t        if (caseless_restrict && *pp < 128) return -1;  /* No match */\n440\t\n441\t        for (;;)\n442\t          {\n443\t          if (c < *pp) return -1;  /* No match */\n444\t          if (c == *pp++) break;\n445\t          }\n446\t        }\n447\t      }\n448\t    }\n449\t  else\n450\t#endif\n451\t\n452\t  /* Not in UTF or UCP mode */\n453\t    {\n454\t    for (; length > 0; length--)\n455\t      {\n456\t      uint32_t cc, cp;\n457\t      if (eptr >= mb->end_subject) return 1;   /* Partial match */\n458\t      cc = *eptr;\n459\t      cp = *p;\n460\t      if (TABLE_GET(cp, mb->lcc, cp) != TABLE_GET(cc, mb->lcc, cc))\n461\t        return -1;  /* No match */\n462\t      p++;\n463\t      eptr++;\n464\t      }\n465\t    }\n466\t  }\n467\t\n468\t/* In the caseful case, we can just compare the code units, whether or not we\n469\tare in UTF and/or UCP mode. When partial matching, we have to do this unit by\n470\tunit. */\n471\t\n472\telse\n473\t  {\n474\t  if (mb->partial != 0)\n475\t    {\n476\t    for (; length > 0; length--)\n477\t      {\n478\t      if (eptr >= mb->end_subject) return 1;   /* Partial match */\n479\t      if (*p++ != *eptr++) return -1;  /* No match */\n480\t      }\n481\t    }\n482\t\n483\t  /* Not partial matching */\n484\t\n485\t  else\n486\t    {\n487\t    if ((PCRE2_SIZE)(mb->end_subject - eptr) < length ||\n488\t        memcmp(p, eptr, CU2BYTES(length)) != 0) return -1;  /* No match */\n489\t    eptr += length;\n490\t    }\n491\t  }\n492\t\n493\t*lengthptr = eptr - eptr_start;\n494\treturn 0;  /* Match */\n495\t}\n496\t\n497\t\n498\t\n499\t/*************************************************\n500\t*     Restore offsets after a recurse            *\n501\t*************************************************/\n502\t\n503\t/* This function restores the ovector values when\n504\ta recursive block reaches its end, and the triggering\n505\trecurse has and argument list.\n506\t\n507\tArguments:\n508\t  F           the current backtracking frame pointer\n509\t  P           the previous backtracking frame pointer\n510\t*/\n511\t\n512\tstatic void\n513\trecurse_update_offsets(heapframe *F, heapframe *P)\n514\t{\n515\tPCRE2_SIZE *dst = F->ovector;\n516\tPCRE2_SIZE *src = P->ovector;\n517\t/* The first bracket has offset 2, because\n518\toffset 0 is reserved for the full match. */\n519\tPCRE2_SIZE offset = 2;\n520\tPCRE2_SIZE offset_top = Foffset_top + 2;\n521\tPCRE2_SIZE diff;\n522\tPCRE2_SPTR ecode = Fecode;\n523\t\n524\tdo\n525\t  {\n526\t  diff = (GET2(ecode, 1) << 1) - offset;\n527\t  ecode += 1 + IMM2_SIZE;\n528\t\n529\t  if (offset + diff >= offset_top)\n530\t    {\n531\t    /* Some OP_CREF opcodes are not\n532\t    processed, they must be skipped. */\n533\t    while (*ecode == OP_CREF) ecode += 1 + IMM2_SIZE;\n534\t    break;\n535\t    }\n536\t\n537\t  if (diff == 2)\n538\t    {\n539\t    dst[0] = src[0];\n540\t    dst[1] = src[1];\n541\t    }\n542\t  else if (diff >= 4)\n543\t    memcpy(dst, src, diff * sizeof(PCRE2_SIZE));\n544\t\n545\t  /* Skip the unmodified entry. */\n546\t  diff += 2;\n547\t  offset += diff;\n548\t  dst += diff;\n549\t  src += diff;\n550\t  }\n551\twhile (*ecode == OP_CREF);\n552\t\n553\tdiff = offset_top - offset;\n554\tif (diff == 2)\n555\t  {\n556\t  dst[0] = src[0];\n557\t  dst[1] = src[1];\n558\t  }\n559\telse if (diff >= 4)\n560\t  memcpy(dst, src, diff * sizeof(PCRE2_SIZE));\n561\t\n562\tFecode = ecode;\n563\tFoffset_top = (offset <= P->offset_top) ? P->offset_top : (offset - 2);\n564\t}\n565\t\n566\t\n567\t\n568\t/******************************************************************************\n569\t*******************************************************************************\n570\t                   \"Recursion\" in the match() function\n571\t\n572\tThe original match() function was highly recursive, but this proved to be the\n573\tsource of a number of problems over the years, mostly because of the relatively\n574\tsmall system stacks that are commonly found. As new features were added to\n575\tpatterns, various kludges were invented to reduce the amount of stack used,\n576\tmaking the code hard to understand in places.\n577\t\n578\tA version did exist that used individual frames on the heap instead of calling\n579\tmatch() recursively, but this ran substantially slower. The current version is\n580\ta refactoring that uses a vector of frames to remember backtracking points.\n581\tThis runs no slower, and possibly even a bit faster than the original recursive\n582\timplementation.\n583\t\n584\tAt first, an initial vector of size START_FRAMES_SIZE (enough for maybe 50\n585\tframes) was allocated on the system stack. If this was not big enough, the heap\n586\twas used for a larger vector. However, it turns out that there are environments\n587\twhere taking as little as 20KiB from the system stack is an embarrassment.\n588\tAfter another refactoring, the heap is used exclusively, but a pointer the\n589\tframes vector and its size are cached in the match_data block, so that there is\n590\tno new memory allocation if the same match_data block is used for multiple\n591\tmatches (unless the frames vector has to be extended).\n592\t*******************************************************************************\n593\t******************************************************************************/\n594\t\n595\t\n596\t\n597\t\n598\t/*************************************************\n599\t*       Macros for the match() function          *\n600\t*************************************************/\n601\t\n602\t/* These macros pack up tests that are used for partial matching several times\n603\tin the code. The second one is used when we already know we are past the end of\n604\tthe subject. We set the \"hit end\" flag if the pointer is at the end of the\n605\tsubject and either (a) the pointer is past the earliest inspected character\n606\t(i.e. something has been matched, even if not part of the actual matched\n607\tstring), or (b) the pattern contains a lookbehind. These are the conditions for\n608\twhich adding more characters may allow the current match to continue.\n609\t\n610\tFor hard partial matching, we immediately return a partial match. Otherwise,\n611\tcarrying on means that a complete match on the current subject will be sought.\n612\tA partial match is returned only if no complete match can be found. */\n613\t\n614\t#define CHECK_PARTIAL() \\\n615\t  do { \\\n616\t     if (Feptr >= mb->end_subject) \\\n617\t       { \\\n618\t       SCHECK_PARTIAL(); \\\n619\t       } \\\n620\t     } \\\n621\t  while (0)\n622\t\n623\t#define SCHECK_PARTIAL() \\\n624\t  do { \\\n625\t     if (mb->partial != 0 && \\\n626\t         (Feptr > mb->start_used_ptr || mb->allowemptypartial)) \\\n627\t       { \\\n628\t       mb->hitend = TRUE; \\\n629\t       if (mb->partial > 1) return PCRE2_ERROR_PARTIAL; \\\n630\t       } \\\n631\t     } \\\n632\t  while (0)\n633\t\n634\t\n635\t/* These macros are used to implement backtracking. They simulate a recursive\n636\tcall to the match() function by means of a local vector of frames which\n637\tremember the backtracking points. */\n638\t\n639\t#define RMATCH(ra,rb) \\\n640\t  do { \\\n641\t     start_ecode = ra; \\\n642\t     Freturn_id = rb; \\\n643\t     goto MATCH_RECURSE; \\\n644\t     L_##rb:; \\\n645\t     } \\\n646\t  while (0)\n647\t\n648\t#define RRETURN(ra) \\\n649\t  do { \\\n650\t     rrc = ra; \\\n651\t     goto RETURN_SWITCH; \\\n652\t     } \\\n653\t  while (0)\n654\t\n655\t\n656\t\n657\t/*************************************************\n658\t*         Match from current position            *\n659\t*************************************************/\n660\t\n661\t/* This function is called to run one match attempt at a single starting point\n662\tin the subject.\n663\t\n664\tPerformance note: It might be tempting to extract commonly used fields from the\n665\tmb structure (e.g. end_subject) into individual variables to improve\n666\tperformance. Tests using gcc on a SPARC disproved this; in the first case, it\n667\tmade performance worse.\n668\t\n669\tArguments:\n670\t   start_eptr   starting character in subject\n671\t   start_ecode  starting position in compiled code\n672\t   top_bracket  number of capturing parentheses in the pattern\n673\t   frame_size   size of each backtracking frame\n674\t   match_data   pointer to the match_data block\n675\t   mb           pointer to \"static\" variables block\n676\t\n677\tReturns:        MATCH_MATCH if matched            )  these values are >= 0\n678\t                MATCH_NOMATCH if failed to match  )\n679\t                negative MATCH_xxx value for PRUNE, SKIP, etc\n680\t                negative PCRE2_ERROR_xxx value if aborted by an error condition\n681\t                (e.g. stopped by repeated call or depth limit)\n682\t*/\n683\t\n684\tstatic int\n685\tmatch(PCRE2_SPTR start_eptr, PCRE2_SPTR start_ecode, uint16_t top_bracket,\n686\t  PCRE2_SIZE frame_size, pcre2_match_data *match_data, match_block *mb)\n687\t{\n688\t/* Frame-handling variables */\n689\t\n690\theapframe *F;           /* Current frame pointer */\n691\theapframe *N = NULL;    /* Temporary frame pointers */\n692\theapframe *P = NULL;\n693\t\n694\theapframe *frames_top;  /* End of frames vector */\n695\theapframe *assert_accept_frame = NULL;  /* For passing back a frame with captures */\n696\tPCRE2_SIZE frame_copy_size;   /* Amount to copy when creating a new frame */\n697\t\n698\t/* Local variables that do not need to be preserved over calls to RMATCH(). */\n699\t\n700\tPCRE2_SPTR branch_end = NULL;\n701\tPCRE2_SPTR branch_start;\n702\tPCRE2_SPTR bracode;     /* Temp pointer to start of group */\n703\tPCRE2_SIZE offset;      /* Used for group offsets */\n704\tPCRE2_SIZE length;      /* Used for various length calculations */\n705\t\n706\tint rrc;                /* Return from functions & backtracking \"recursions\" */\n707\t#ifdef SUPPORT_UNICODE\n708\tint proptype;           /* Type of character property */\n709\t#endif\n710\t\n711\tuint32_t i;             /* Used for local loops */\n712\tuint32_t fc;            /* Character values */\n713\tuint32_t number;        /* Used for group and other numbers */\n714\tuint32_t reptype = 0;   /* Type of repetition (0 to avoid compiler warning) */\n715\tuint32_t group_frame_type;  /* Specifies type for new group frames */\n716\t\n717\tBOOL condition;         /* Used in conditional groups */\n718\tBOOL cur_is_word;       /* Used in \"word\" tests */\n719\tBOOL prev_is_word;      /* Used in \"word\" tests */\n720\t\n721\t/* UTF and UCP flags */\n722\t\n723\t#ifdef SUPPORT_UNICODE\n724\tBOOL utf = (mb->poptions & PCRE2_UTF) != 0;\n725\tBOOL ucp = (mb->poptions & PCRE2_UCP) != 0;\n726\t#else\n727\tBOOL utf = FALSE;  /* Required for convenience even when no Unicode support */\n728\t#endif\n729\t\n730\t/* This is the length of the last part of a backtracking frame that must be\n731\tcopied when a new frame is created. */\n732\t\n733\tframe_copy_size = frame_size - offsetof(heapframe, eptr);\n734\t\n735\t/* Set up the first frame and the end of the frames vector. */\n736\t\n737\tF = match_data->heapframes;\n738\tframes_top = (heapframe *)((char *)F + match_data->heapframes_size);\n739\t\n740\tFrdepth = 0;                        /* \"Recursion\" depth */\n741\tFcapture_last = 0;                  /* Number of most recent capture */\n742\tFcurrent_recurse = RECURSE_UNSET;   /* Not pattern recursing. */\n743\tFstart_match = Feptr = start_eptr;  /* Current data pointer and start match */\n744\tFmark = NULL;                       /* Most recent mark */\n745\tFoffset_top = 0;                    /* End of captures within the frame */\n746\tFlast_group_offset = PCRE2_UNSET;   /* Saved frame of most recent group */\n747\tgroup_frame_type = 0;               /* Not a start of group frame */\n748\tgoto NEW_FRAME;                     /* Start processing with this frame */\n749\t\n750\t/* Come back here when we want to create a new frame for remembering a\n751\tbacktracking point. */\n752\t\n753\tMATCH_RECURSE:\n754\t\n755\t/* Set up a new backtracking frame. If the vector is full, get a new one,\n756\tdoubling the size, but constrained by the heap limit (which is in KiB). */\n757\t\n758\tN = (heapframe *)((char *)F + frame_size);\n759\tif ((heapframe *)((char *)N + frame_size) >= frames_top)\n760\t  {\n761\t  heapframe *new;\n762\t  PCRE2_SIZE newsize;\n763\t  PCRE2_SIZE usedsize = (char *)N - (char *)(match_data->heapframes);\n764\t\n765\t  if (match_data->heapframes_size >= PCRE2_SIZE_MAX / 2)\n766\t    {\n767\t    if (match_data->heapframes_size == PCRE2_SIZE_MAX - 1)\n768\t      return PCRE2_ERROR_NOMEMORY;\n769\t    newsize = PCRE2_SIZE_MAX - 1;\n770\t    }\n771\t  else\n772\t    newsize = match_data->heapframes_size * 2;\n773\t\n774\t  if (newsize / 1024 >= mb->heap_limit)\n775\t    {\n776\t    PCRE2_SIZE old_size = match_data->heapframes_size / 1024;\n777\t    if (mb->heap_limit <= old_size)\n778\t      return PCRE2_ERROR_HEAPLIMIT;\n779\t    else\n780\t      {\n781\t      PCRE2_SIZE max_delta = 1024 * (mb->heap_limit - old_size);\n782\t      int over_bytes = match_data->heapframes_size % 1024;\n783\t      if (over_bytes) max_delta -= (1024 - over_bytes);\n784\t      newsize = match_data->heapframes_size + max_delta;\n785\t      }\n786\t    }\n787\t\n788\t  /* With a heap limit set, the permitted additional size may not be enough for\n789\t  another frame, so do a final check. */\n790\t\n791\t  if (newsize - usedsize < frame_size) return PCRE2_ERROR_HEAPLIMIT;\n792\t  new = match_data->memctl.malloc(newsize, match_data->memctl.memory_data);\n793\t  if (new == NULL) return PCRE2_ERROR_NOMEMORY;\n794\t  memcpy(new, match_data->heapframes, usedsize);\n795\t\n796\t  N = (heapframe *)((char *)new + usedsize);\n797\t  F = (heapframe *)((char *)N - frame_size);\n798\t\n799\t  match_data->memctl.free(match_data->heapframes, match_data->memctl.memory_data);\n800\t  match_data->heapframes = new;\n801\t  match_data->heapframes_size = newsize;\n802\t  frames_top = (heapframe *)((char *)new + newsize);\n803\t  }\n804\t\n805\t#ifdef DEBUG_SHOW_RMATCH\n806\tfprintf(stderr, \"++ RMATCH %d frame=%d\", Freturn_id, Frdepth + 1);\n807\tif (group_frame_type != 0)\n808\t  {\n809\t  fprintf(stderr, \" type=%x \", group_frame_type);\n810\t  switch (GF_IDMASK(group_frame_type))\n811\t    {\n812\t    case GF_CAPTURE:\n813\t    fprintf(stderr, \"capture=%d\", GF_DATAMASK(group_frame_type));\n814\t    break;\n815\t\n816\t    case GF_NOCAPTURE:\n817\t    fprintf(stderr, \"nocapture op=%d\", Fop);\n818\t    break;\n819\t\n820\t    case GF_CONDASSERT:\n821\t    fprintf(stderr, \"condassert op=%d\", Fop);\n822\t    break;\n823\t\n824\t    case GF_RECURSE:\n825\t    fprintf(stderr, \"recurse=%d\", GF_DATAMASK(group_frame_type));\n826\t    break;\n827\t\n828\t    default:\n829\t    fprintf(stderr, \"*** unknown ***\");\n830\t    break;\n831\t    }\n832\t  }\n833\tfprintf(stderr, \"\\n\");\n834\t#endif\n835\t\n836\t/* Copy those fields that must be copied into the new frame, increase the\n837\t\"recursion\" depth (i.e. the new frame's index) and then make the new frame\n838\tcurrent. */\n839\t\n840\tmemcpy((char *)N + offsetof(heapframe, eptr),\n841\t       (char *)F + offsetof(heapframe, eptr),\n842\t       frame_copy_size);\n843\t\n844\tN->rdepth = Frdepth + 1;\n845\tF = N;\n846\t\n847\t/* Carry on processing with a new frame. */\n848\t\n849\tNEW_FRAME:\n850\tFgroup_frame_type = group_frame_type;\n851\tFecode = start_ecode;      /* Starting code pointer */\n852\tFback_frame = frame_size;  /* Default is go back one frame */\n853\t\n854\t/* If this is a special type of group frame, remember its offset for quick\n855\taccess at the end of the group. If this is a recursion, set a new current\n856\trecursion value. */\n857\t\n858\tif (group_frame_type != 0)\n859\t  {\n860\t  Flast_group_offset = (char *)F - (char *)match_data->heapframes;\n861\t  if (GF_IDMASK(group_frame_type) == GF_RECURSE)\n862\t    Fcurrent_recurse = GF_DATAMASK(group_frame_type);\n863\t  group_frame_type = 0;\n864\t  }\n865\t\n866\t\n867\t/* ========================================================================= */\n868\t/* This is the main processing loop. First check that we haven't recorded too\n869\tmany backtracks (search tree is too large), or that we haven't exceeded the\n870\trecursive depth limit (used too many backtracking frames). If not, process the\n871\topcodes. */\n872\t\n873\tif (mb->match_call_count++ >= mb->match_limit) return PCRE2_ERROR_MATCHLIMIT;\n874\tif (Frdepth >= mb->match_limit_depth) return PCRE2_ERROR_DEPTHLIMIT;\n875\t\n876\t#ifdef DEBUG_SHOW_OPS\n877\tfprintf(stderr, \"\\n++ New frame: type=0x%x subject offset %ld\\n\",\n878\t  GF_IDMASK(Fgroup_frame_type), Feptr - mb->start_subject);\n879\t#endif\n880\t\n881\tfor (;;)\n882\t  {\n883\t#ifdef DEBUG_SHOW_OPS\n884\tfprintf(stderr, \"++ %2ld op=%3d %s\\n\", Fecode - mb->start_code, *Fecode,\n885\t  OP_names[*Fecode]);\n886\t#endif\n887\t\n888\t  Fop = (uint8_t)(*Fecode);  /* Cast needed for 16-bit and 32-bit modes */\n889\t  switch(Fop)\n890\t    {\n891\t    /* ===================================================================== */\n892\t    /* Before OP_ACCEPT there may be any number of OP_CLOSE opcodes, to close\n893\t    any currently open capturing brackets. Unlike reaching the end of a group,\n894\t    where we know the starting frame is at the top of the chained frames, in\n895\t    this case we have to search back for the relevant frame in case other types\n896\t    of group that use chained frames have intervened. Multiple OP_CLOSEs always\n897\t    come innermost first, which matches the chain order. We can ignore this in\n898\t    a recursion, because captures are not passed out of recursions. */\n899\t\n900\t    case OP_CLOSE:\n901\t    if (Fcurrent_recurse == RECURSE_UNSET)\n902\t      {\n903\t      number = GET2(Fecode, 1);\n904\t      offset = Flast_group_offset;\n905\t      for(;;)\n906\t        {\n907\t        /* Corrupted heapframes?. Trigger an assert and return an error */\n908\t        PCRE2_ASSERT(offset != PCRE2_UNSET);\n909\t        if (offset == PCRE2_UNSET) return PCRE2_ERROR_INTERNAL;\n910\t\n911\t        N = (heapframe *)((char *)match_data->heapframes + offset);\n912\t        P = (heapframe *)((char *)N - frame_size);\n913\t        if (N->group_frame_type == (GF_CAPTURE | number)) break;\n914\t        offset = P->last_group_offset;\n915\t        }\n916\t      offset = (number << 1) - 2;\n917\t      Fcapture_last = number;\n918\t      Fovector[offset] = P->eptr - mb->start_subject;\n919\t      Fovector[offset+1] = Feptr - mb->start_subject;\n920\t      if (offset >= Foffset_top) Foffset_top = offset + 2;\n921\t      }\n922\t    Fecode += PRIV(OP_lengths)[*Fecode];\n923\t    break;\n924\t\n925\t\n926\t    /* ===================================================================== */\n927\t    /* Real or forced end of the pattern, assertion, or recursion. In an\n928\t    assertion ACCEPT, update the last used pointer and remember the current\n929\t    frame so that the captures and mark can be fished out of it. */\n930\t\n931\t    case OP_ASSERT_ACCEPT:\n932\t    if (Feptr > mb->last_used_ptr) mb->last_used_ptr = Feptr;\n933\t    assert_accept_frame = F;\n934\t    RRETURN(MATCH_ACCEPT);\n935\t\n936\t    /* For ACCEPT within a recursion, we have to find the most recent\n937\t    recursion. If not in a recursion, fall through to code that is common with\n938\t    OP_END. */\n939\t\n940\t    case OP_ACCEPT:\n941\t    if (Fcurrent_recurse != RECURSE_UNSET)\n942\t      {\n943\t#ifdef DEBUG_SHOW_OPS\n944\t      fprintf(stderr, \"++ Accept within recursion\\n\");\n945\t#endif\n946\t      offset = Flast_group_offset;\n947\t      for(;;)\n948\t        {\n949\t        /* Corrupted heapframes?. Trigger an assert and return an error */\n950\t        PCRE2_ASSERT(offset != PCRE2_UNSET);\n951\t        if (offset == PCRE2_UNSET) return PCRE2_ERROR_INTERNAL;\n952\t\n953\t        N = (heapframe *)((char *)match_data->heapframes + offset);\n954\t        P = (heapframe *)((char *)N - frame_size);\n955\t        if (GF_IDMASK(N->group_frame_type) == GF_RECURSE) break;\n956\t        offset = P->last_group_offset;\n957\t        }\n958\t\n959\t      /* N is now the frame of the recursion; the previous frame is at the\n960\t      OP_RECURSE position. Go back there, copying the current subject position\n961\t      and mark, and the start_match position (\\K might have changed it), and\n962\t      then move on past the OP_RECURSE. */\n963\t\n964\t      P->eptr = Feptr;\n965\t      P->mark = Fmark;\n966\t      P->start_match = Fstart_match;\n967\t      F = P;\n968\t      Fecode += 1 + LINK_SIZE;\n969\t      continue;\n970\t      }\n971\t    PCRE2_FALLTHROUGH /* Fall through */\n972\t\n973\t    /* OP_END itself can never be reached within a recursion because that is\n974\t    picked up when the OP_KET that always precedes OP_END is reached. */\n975\t\n976\t    case OP_END:\n977\t\n978\t    /* Fail for an empty string match if either PCRE2_NOTEMPTY is set, or if\n979\t    PCRE2_NOTEMPTY_ATSTART is set and we have matched at the start of the\n980\t    subject. In both cases, backtracking will then try other alternatives, if\n981\t    any. */\n982\t\n983\t    if (Feptr == Fstart_match &&\n984\t         ((mb->moptions & PCRE2_NOTEMPTY) != 0 ||\n985\t           ((mb->moptions & PCRE2_NOTEMPTY_ATSTART) != 0 &&\n986\t             Fstart_match == mb->start_subject + mb->start_offset)))\n987\t      {\n988\t#ifdef DEBUG_SHOW_OPS\n989\t      fprintf(stderr, \"++ Backtrack because empty string\\n\");\n990\t#endif\n991\t      RRETURN(MATCH_NOMATCH);\n992\t      }\n993\t\n994\t    /* Fail if PCRE2_ENDANCHORED is set and the end of the match is not\n995\t    the end of the subject. After (*ACCEPT) we fail the entire match (at this\n996\t    position) but backtrack if we've reached the end of the pattern. This\n997\t    applies whether or not we are in a recursion. */\n998\t\n999\t    if (Feptr < mb->end_subject &&\n1000\t        ((mb->moptions | mb->poptions) & PCRE2_ENDANCHORED) != 0)\n1001\t      {\n1002\t      if (Fop == OP_END)\n1003\t        {\n1004\t#ifdef DEBUG_SHOW_OPS\n1005\t        fprintf(stderr, \"++ Backtrack because not at end (endanchored set)\\n\");\n1006\t#endif\n1007\t        RRETURN(MATCH_NOMATCH);\n1008\t        }\n1009\t\n1010\t#ifdef DEBUG_SHOW_OPS\n1011\t      fprintf(stderr, \"++ Failed ACCEPT not at end (endanchored set)\\n\");\n1012\t#endif\n1013\t      return MATCH_NOMATCH;   /* (*ACCEPT) */\n1014\t      }\n1015\t\n1016\t    /* Fail if we detect that the start position was moved to be either after\n1017\t    the end position (\\K in lookahead) or before the start offset (\\K in\n1018\t    lookbehind). If this occurs, the pattern must have used \\K in a somewhat\n1019\t    sneaky way (e.g. by pattern recursion), because if the \\K is actually\n1020\t    syntactically inside the lookaround, it's blocked at compile-time. */\n1021\t\n1022\t    if (Fstart_match < mb->start_subject + mb->start_offset ||\n1023\t        Fstart_match > Feptr)\n1024\t      {\n1025\t      /* The \\K expression is fairly rare. We assert it was used so that we\n1026\t      catch any unexpected invalid data in start_match. */\n1027\t      PCRE2_ASSERT(mb->hasbsk);\n1028\t\n1029\t      if (!mb->allowlookaroundbsk)\n1030\t        return PCRE2_ERROR_BAD_BACKSLASH_K;\n1031\t      }\n1032\t\n1033\t    /* We have a successful match of the whole pattern. Record the result and\n1034\t    then do a direct return from the function. If there is space in the offset\n1035\t    vector, set any pairs that follow the highest-numbered captured string but\n1036\t    are less than the number of capturing groups in the pattern to PCRE2_UNSET.\n1037\t    It is documented that this happens. \"Gaps\" are set to PCRE2_UNSET\n1038\t    dynamically. It is only those at the end that need setting here. */\n1039\t\n1040\t    mb->end_match_ptr = Feptr;           /* Record where we ended */\n1041\t    mb->end_offset_top = Foffset_top;    /* and how many extracts were taken */\n1042\t    mb->mark = Fmark;                    /* and the last success mark */\n1043\t    if (Feptr > mb->last_used_ptr) mb->last_used_ptr = Feptr;\n1044\t\n1045\t    match_data->ovector[0] = Fstart_match - mb->start_subject;\n1046\t    match_data->ovector[1] = Feptr - mb->start_subject;\n1047\t\n1048\t    /* Set i to the smaller of the sizes of the external and frame ovectors. */\n1049\t\n1050\t    i = 2 * ((top_bracket + 1 > match_data->oveccount)?\n1051\t      match_data->oveccount : top_bracket + 1);\n1052\t    memcpy(match_data->ovector + 2, Fovector, (i - 2) * sizeof(PCRE2_SIZE));\n1053\t    while (--i >= Foffset_top + 2) match_data->ovector[i] = PCRE2_UNSET;\n1054\t    return MATCH_MATCH;  /* Note: NOT RRETURN */\n1055\t\n1056\t\n1057\t    /*===================================================================== */\n1058\t    /* Match any single character type except newline; have to take care with\n1059\t    CRLF newlines and partial matching. */\n1060\t\n1061\t    case OP_ANY:\n1062\t    if (IS_NEWLINE(Feptr)) RRETURN(MATCH_NOMATCH);\n1063\t    if (mb->partial != 0 &&\n1064\t        Feptr == mb->end_subject - 1 &&\n1065\t        NLBLOCK->nltype == NLTYPE_FIXED &&\n1066\t        NLBLOCK->nllen == 2 &&\n1067\t        *Feptr == NLBLOCK->nl[0])\n1068\t      {\n1069\t      mb->hitend = TRUE;\n1070\t      if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n1071\t      }\n1072\t    PCRE2_FALLTHROUGH /* Fall through */\n1073\t\n1074\t    /* Match any single character whatsoever. */\n1075\t\n1076\t    case OP_ALLANY:\n1077\t    if (Feptr >= mb->end_subject)  /* DO NOT merge the Feptr++ here; it must */\n1078\t      {                            /* not be updated before SCHECK_PARTIAL. */\n1079\t      SCHECK_PARTIAL();\n1080\t      RRETURN(MATCH_NOMATCH);\n1081\t      }\n1082\t    Feptr++;\n1083\t#ifdef SUPPORT_UNICODE\n1084\t    if (utf) ACROSSCHAR(Feptr < mb->end_subject, Feptr, Feptr++);\n1085\t#endif\n1086\t    Fecode++;\n1087\t    break;\n1088\t\n1089\t\n1090\t    /* ===================================================================== */\n1091\t    /* Match a single code unit, even in UTF mode. This opcode really does\n1092\t    match any code unit, even newline. (It really should be called ANYCODEUNIT,\n1093\t    of course - the byte name is from pre-16 bit days.) */\n1094\t\n1095\t    case OP_ANYBYTE:\n1096\t    if (Feptr >= mb->end_subject)   /* DO NOT merge the Feptr++ here; it must */\n1097\t      {                             /* not be updated before SCHECK_PARTIAL. */\n1098\t      SCHECK_PARTIAL();\n1099\t      RRETURN(MATCH_NOMATCH);\n1100\t      }\n1101\t    Feptr++;\n1102\t    Fecode++;\n1103\t    break;\n1104\t\n1105\t\n1106\t    /* ===================================================================== */\n1107\t    /* Match a single character, casefully */\n1108\t\n1109\t    case OP_CHAR:\n1110\t#ifdef SUPPORT_UNICODE\n1111\t    if (utf)\n1112\t      {\n1113\t      length = 1;\n1114\t      Fecode++;\n1115\t      GETCHARLEN(fc, Fecode, length);\n1116\t      if (length > (PCRE2_SIZE)(mb->end_subject - Feptr))\n1117\t        {\n1118\t        CHECK_PARTIAL();             /* Not SCHECK_PARTIAL() */\n1119\t        RRETURN(MATCH_NOMATCH);\n1120\t        }\n1121\t      for (; length > 0; length--)\n1122\t        {\n1123\t        if (*Fecode++ != *Feptr++) RRETURN(MATCH_NOMATCH);\n1124\t        }\n1125\t      }\n1126\t    else\n1127\t#endif\n1128\t\n1129\t    /* Not UTF mode */\n1130\t      {\n1131\t      if (mb->end_subject - Feptr < 1)\n1132\t        {\n1133\t        SCHECK_PARTIAL();            /* This one can use SCHECK_PARTIAL() */\n1134\t        RRETURN(MATCH_NOMATCH);\n1135\t        }\n1136\t      if (Fecode[1] != *Feptr++) RRETURN(MATCH_NOMATCH);\n1137\t      Fecode += 2;\n1138\t      }\n1139\t    break;\n1140\t\n1141\t\n1142\t    /* ===================================================================== */\n1143\t    /* Match a single character, caselessly. If we are at the end of the\n1144\t    subject, give up immediately. We get here only when the pattern character\n1145\t    has at most one other case. Characters with more than two cases are coded\n1146\t    as OP_PROP with the pseudo-property PT_CLIST. */\n1147\t\n1148\t    case OP_CHARI:\n1149\t    if (Feptr >= mb->end_subject)\n1150\t      {\n1151\t      SCHECK_PARTIAL();\n1152\t      RRETURN(MATCH_NOMATCH);\n1153\t      }\n1154\t\n1155\t#ifdef SUPPORT_UNICODE\n1156\t    if (utf)\n1157\t      {\n1158\t      length = 1;\n1159\t      Fecode++;\n1160\t      GETCHARLEN(fc, Fecode, length);\n1161\t\n1162\t      /* If the pattern character's value is < 128, we know that its other case\n1163\t      (if any) is also < 128 (and therefore only one code unit long in all\n1164\t      code-unit widths), so we can use the fast lookup table. We checked above\n1165\t      that there is at least one character left in the subject. */\n1166\t\n1167\t      if (fc < 128)\n1168\t        {\n1169\t        uint32_t cc = *Feptr;\n1170\t        if (mb->lcc[fc] != TABLE_GET(cc, mb->lcc, cc)) RRETURN(MATCH_NOMATCH);\n1171\t        Fecode++;\n1172\t        Feptr++;\n1173\t        }\n1174\t\n1175\t      /* Otherwise we must pick up the subject character and use Unicode\n1176\t      property support to test its other case. Note that we cannot use the\n1177\t      value of \"length\" to check for sufficient bytes left, because the other\n1178\t      case of the character may have more or fewer code units. */\n1179\t\n1180\t      else\n1181\t        {\n1182\t        uint32_t dc;\n1183\t        GETCHARINC(dc, Feptr);\n1184\t        Fecode += length;\n1185\t        if (dc != fc && dc != UCD_OTHERCASE(fc)) RRETURN(MATCH_NOMATCH);\n1186\t        }\n1187\t      }\n1188\t\n1189\t    /* If UCP is set without UTF we must do the same as above, but with one\n1190\t    character per code unit. */\n1191\t\n1192\t    else if (ucp)\n1193\t      {\n1194\t      uint32_t cc = *Feptr;\n1195\t      fc = Fecode[1];\n1196\t      if (fc < 128)\n1197\t        {\n1198\t        if (mb->lcc[fc] != TABLE_GET(cc, mb->lcc, cc)) RRETURN(MATCH_NOMATCH);\n1199\t        }\n1200\t      else\n1201\t        {\n1202\t        if (cc != fc && cc != UCD_OTHERCASE(fc)) RRETURN(MATCH_NOMATCH);\n1203\t        }\n1204\t      Feptr++;\n1205\t      Fecode += 2;\n1206\t      }\n1207\t\n1208\t    else\n1209\t#endif   /* SUPPORT_UNICODE */\n1210\t\n1211\t    /* Not UTF or UCP mode; use the table for characters < 256. */\n1212\t      {\n1213\t      if (TABLE_GET(Fecode[1], mb->lcc, Fecode[1])\n1214\t          != TABLE_GET(*Feptr, mb->lcc, *Feptr)) RRETURN(MATCH_NOMATCH);\n1215\t      Feptr++;\n1216\t      Fecode += 2;\n1217\t      }\n1218\t    break;\n1219\t\n1220\t\n1221\t    /* ===================================================================== */\n1222\t    /* Match not a single character. */\n1223\t\n1224\t    case OP_NOT:\n1225\t    case OP_NOTI:\n1226\t    if (Feptr >= mb->end_subject)\n1227\t      {\n1228\t      SCHECK_PARTIAL();\n1229\t      RRETURN(MATCH_NOMATCH);\n1230\t      }\n1231\t\n1232\t#ifdef SUPPORT_UNICODE\n1233\t    if (utf)\n1234\t      {\n1235\t      uint32_t ch;\n1236\t      Fecode++;\n1237\t      GETCHARINC(ch, Fecode);\n1238\t      GETCHARINC(fc, Feptr);\n1239\t      if (ch == fc)\n1240\t        {\n1241\t        RRETURN(MATCH_NOMATCH);  /* Caseful match */\n1242\t        }\n1243\t      else if (Fop == OP_NOTI)   /* If caseless */\n1244\t        {\n1245\t        if (ch > 127)\n1246\t          ch = UCD_OTHERCASE(ch);\n1247\t        else\n1248\t          ch = (mb->fcc)[ch];\n1249\t        if (ch == fc) RRETURN(MATCH_NOMATCH);\n1250\t        }\n1251\t      }\n1252\t\n1253\t    /* UCP without UTF is as above, but with one character per code unit. */\n1254\t\n1255\t    else if (ucp)\n1256\t      {\n1257\t      uint32_t ch;\n1258\t      fc = *Feptr++;\n1259\t      ch = Fecode[1];\n1260\t      Fecode += 2;\n1261\t\n1262\t      if (ch == fc)\n1263\t        {\n1264\t        RRETURN(MATCH_NOMATCH);  /* Caseful match */\n1265\t        }\n1266\t      else if (Fop == OP_NOTI)   /* If caseless */\n1267\t        {\n1268\t        if (ch > 127)\n1269\t          ch = UCD_OTHERCASE(ch);\n1270\t        else\n1271\t          ch = (mb->fcc)[ch];\n1272\t        if (ch == fc) RRETURN(MATCH_NOMATCH);\n1273\t        }\n1274\t      }\n1275\t\n1276\t    else\n1277\t#endif  /* SUPPORT_UNICODE */\n1278\t\n1279\t    /* Neither UTF nor UCP is set */\n1280\t\n1281\t      {\n1282\t      uint32_t ch = Fecode[1];\n1283\t      fc = *Feptr++;\n1284\t      if (ch == fc || (Fop == OP_NOTI && TABLE_GET(ch, mb->fcc, ch) == fc))\n1285\t        RRETURN(MATCH_NOMATCH);\n1286\t      Fecode += 2;\n1287\t      }\n1288\t    break;\n1289\t\n1290\t\n1291\t    /* ===================================================================== */\n1292\t    /* Match a single character repeatedly. */\n1293\t\n1294\t#define Llength      F->byte1\n1295\t#define Loclength    F->byte2\n1296\t#define Lstart_eptr  F->fields.char_repeat.start_eptr\n1297\t#define Lcharptr     F->fields.char_repeat.charptr\n1298\t#define Lmin         F->fields.char_repeat.min\n1299\t#define Lmax         F->fields.char_repeat.max\n1300\t#define Lc           F->fields.char_repeat.c\n1301\t#define Loc          F->fields.char_repeat.oc.oc\n1302\t#define Loccu        F->fields.char_repeat.oc.occu\n1303\t\n1304\t    case OP_EXACT:\n1305\t    case OP_EXACTI:\n1306\t    Lmin = Lmax = GET2(Fecode, 1);\n1307\t    Fecode += 1 + IMM2_SIZE;\n1308\t    goto REPEATCHAR;\n1309\t\n1310\t    case OP_POSUPTO:\n1311\t    case OP_POSUPTOI:\n1312\t    reptype = REPTYPE_POS;\n1313\t    Lmin = 0;\n1314\t    Lmax = GET2(Fecode, 1);\n1315\t    Fecode += 1 + IMM2_SIZE;\n1316\t    goto REPEATCHAR;\n1317\t\n1318\t    case OP_UPTO:\n1319\t    case OP_UPTOI:\n1320\t    reptype = REPTYPE_MAX;\n1321\t    Lmin = 0;\n1322\t    Lmax = GET2(Fecode, 1);\n1323\t    Fecode += 1 + IMM2_SIZE;\n1324\t    goto REPEATCHAR;\n1325\t\n1326\t    case OP_MINUPTO:\n1327\t    case OP_MINUPTOI:\n1328\t    reptype = REPTYPE_MIN;\n1329\t    Lmin = 0;\n1330\t    Lmax = GET2(Fecode, 1);\n1331\t    Fecode += 1 + IMM2_SIZE;\n1332\t    goto REPEATCHAR;\n1333\t\n1334\t    case OP_POSSTAR:\n1335\t    case OP_POSSTARI:\n1336\t    reptype = REPTYPE_POS;\n1337\t    Lmin = 0;\n1338\t    Lmax = UINT32_MAX;\n1339\t    Fecode++;\n1340\t    goto REPEATCHAR;\n1341\t\n1342\t    case OP_POSPLUS:\n1343\t    case OP_POSPLUSI:\n1344\t    reptype = REPTYPE_POS;\n1345\t    Lmin = 1;\n1346\t    Lmax = UINT32_MAX;\n1347\t    Fecode++;\n1348\t    goto REPEATCHAR;\n1349\t\n1350\t    case OP_POSQUERY:\n1351\t    case OP_POSQUERYI:\n1352\t    reptype = REPTYPE_POS;\n1353\t    Lmin = 0;\n1354\t    Lmax = 1;\n1355\t    Fecode++;\n1356\t    goto REPEATCHAR;\n1357\t\n1358\t    case OP_STAR:\n1359\t    case OP_STARI:\n1360\t    case OP_MINSTAR:\n1361\t    case OP_MINSTARI:\n1362\t    case OP_PLUS:\n1363\t    case OP_PLUSI:\n1364\t    case OP_MINPLUS:\n1365\t    case OP_MINPLUSI:\n1366\t    case OP_QUERY:\n1367\t    case OP_QUERYI:\n1368\t    case OP_MINQUERY:\n1369\t    case OP_MINQUERYI:\n1370\t    fc = *Fecode++ - ((Fop < OP_STARI)? OP_STAR : OP_STARI);\n1371\t    Lmin = rep_min[fc];\n1372\t    Lmax = rep_max[fc];\n1373\t    reptype = rep_typ[fc];\n1374\t\n1375\t    /* Common code for all repeated single-character matches. We first check\n1376\t    for the minimum number of characters. If the minimum equals the maximum, we\n1377\t    are done. Otherwise, if minimizing, check the rest of the pattern for a\n1378\t    match; if there isn't one, advance up to the maximum, one character at a\n1379\t    time.\n1380\t\n1381\t    If maximizing, advance up to the maximum number of matching characters,\n1382\t    until Feptr is past the end of the maximum run. If possessive, we are\n1383\t    then done (no backing up). Otherwise, match at this position; anything\n1384\t    other than no match is immediately returned. For nomatch, back up one\n1385\t    character, unless we are matching \\R and the last thing matched was\n1386\t    \\r\\n, in which case, back up two code units until we reach the first\n1387\t    optional character position.\n1388\t\n1389\t    The various UTF/non-UTF and caseful/caseless cases are handled separately,\n1390\t    for speed. */\n1391\t\n1392\t    REPEATCHAR:\n1393\t#ifdef SUPPORT_UNICODE\n1394\t    if (utf)\n1395\t      {\n1396\t      length = 1;\n1397\t      Lcharptr = Fecode;\n1398\t      GETCHARLEN(fc, Fecode, length);\n1399\t      Fecode += length;\n1400\t      Llength = (uint8_t)length;\n1401\t\n1402\t      /* Handle multi-code-unit character matching, caseful and caseless. */\n1403\t\n1404\t      if (length > 1)\n1405\t        {\n1406\t        uint32_t othercase;\n1407\t\n1408\t        if (Fop >= OP_STARI &&     /* Caseless */\n1409\t            (othercase = UCD_OTHERCASE(fc)) != fc)\n1410\t          Loclength = (uint8_t)PRIV(ord2utf)(othercase, Loccu);\n1411\t        else Loclength = 0;\n1412\t\n1413\t        for (i = 1; i <= Lmin; i++)\n1414\t          {\n1415\t          if (Feptr <= mb->end_subject - length &&\n1416\t            memcmp(Feptr, Lcharptr, CU2BYTES(length)) == 0) Feptr += length;\n1417\t          else if (Loclength > 0 &&\n1418\t                   Feptr <= mb->end_subject - Loclength &&\n1419\t                   memcmp(Feptr, Loccu, CU2BYTES(Loclength)) == 0)\n1420\t            Feptr += Loclength;\n1421\t          else\n1422\t            {\n1423\t            CHECK_PARTIAL();\n1424\t            RRETURN(MATCH_NOMATCH);\n1425\t            }\n1426\t          }\n1427\t\n1428\t        if (Lmin == Lmax) continue;\n1429\t\n1430\t        if (reptype == REPTYPE_MIN)\n1431\t          {\n1432\t          for (;;)\n1433\t            {\n1434\t            RMATCH(Fecode, RM202);\n1435\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n1436\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n1437\t            if (Feptr <= mb->end_subject - Llength &&\n1438\t              memcmp(Feptr, Lcharptr, CU2BYTES(Llength)) == 0) Feptr += Llength;\n1439\t            else if (Loclength > 0 &&\n1440\t                     Feptr <= mb->end_subject - Loclength &&\n1441\t                     memcmp(Feptr, Loccu, CU2BYTES(Loclength)) == 0)\n1442\t              Feptr += Loclength;\n1443\t            else\n1444\t              {\n1445\t              CHECK_PARTIAL();\n1446\t              RRETURN(MATCH_NOMATCH);\n1447\t              }\n1448\t            }\n1449\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n1450\t          }\n1451\t        else  /* Maximize */\n1452\t          {\n1453\t          Lstart_eptr = Feptr;\n1454\t          for (i = Lmin; i < Lmax; i++)\n1455\t            {\n1456\t            if (Feptr <= mb->end_subject - Llength &&\n1457\t                memcmp(Feptr, Lcharptr, CU2BYTES(Llength)) == 0)\n1458\t              Feptr += Llength;\n1459\t            else if (Loclength > 0 &&\n1460\t                     Feptr <= mb->end_subject - Loclength &&\n1461\t                     memcmp(Feptr, Loccu, CU2BYTES(Loclength)) == 0)\n1462\t              Feptr += Loclength;\n1463\t            else\n1464\t              {\n1465\t              CHECK_PARTIAL();\n1466\t              break;\n1467\t              }\n1468\t            }\n1469\t\n1470\t          /* After \\C in UTF mode, Lstart_eptr might be in the middle of a\n1471\t          Unicode character. Use <= Lstart_eptr to ensure backtracking doesn't\n1472\t          go too far. */\n1473\t\n1474\t          if (reptype != REPTYPE_POS) for(;;)\n1475\t            {\n1476\t            if (Feptr <= Lstart_eptr) break;\n1477\t            RMATCH(Fecode, RM203);\n1478\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n1479\t            Feptr--;\n1480\t            BACKCHAR(Feptr);\n1481\t            }\n1482\t          }\n1483\t        break;   /* End of repeated wide character handling */\n1484\t        }\n1485\t\n1486\t      /* Length of UTF character is 1. Put it into the preserved variable and\n1487\t      fall through to the non-UTF code. */\n1488\t\n1489\t      Lc = fc;\n1490\t      }\n1491\t    else\n1492\t#endif  /* SUPPORT_UNICODE */\n1493\t\n1494\t    /* When not in UTF mode, load a single-code-unit character. Then proceed as\n1495\t    above, using Unicode casing if either UTF or UCP is set. */\n1496\t\n1497\t    Lc = *Fecode++;\n1498\t\n1499\t    /* Caseless comparison */\n1500\t\n1501\t    if (Fop >= OP_STARI)\n1502\t      {\n1503\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1504\t#ifdef SUPPORT_UNICODE\n1505\t      if (ucp && !utf && Lc > 127) Loc = UCD_OTHERCASE(Lc);\n1506\t      else\n1507\t#endif  /* SUPPORT_UNICODE */\n1508\t      /* Lc will be < 128 in UTF-8 mode. */\n1509\t      Loc = mb->fcc[Lc];\n1510\t#else /* 16-bit & 32-bit */\n1511\t#ifdef SUPPORT_UNICODE\n1512\t      if ((utf || ucp) && Lc > 127) Loc = UCD_OTHERCASE(Lc);\n1513\t      else\n1514\t#endif  /* SUPPORT_UNICODE */\n1515\t      Loc = TABLE_GET(Lc, mb->fcc, Lc);\n1516\t#endif  /* PCRE2_CODE_UNIT_WIDTH == 8 */\n1517\t\n1518\t      for (i = 1; i <= Lmin; i++)\n1519\t        {\n1520\t        uint32_t cc;                 /* Faster than PCRE2_UCHAR */\n1521\t        if (Feptr >= mb->end_subject)\n1522\t          {\n1523\t          SCHECK_PARTIAL();\n1524\t          RRETURN(MATCH_NOMATCH);\n1525\t          }\n1526\t        cc = *Feptr;\n1527\t        if (Lc != cc && Loc != cc) RRETURN(MATCH_NOMATCH);\n1528\t        Feptr++;\n1529\t        }\n1530\t      if (Lmin == Lmax) continue;\n1531\t\n1532\t      if (reptype == REPTYPE_MIN)\n1533\t        {\n1534\t        for (;;)\n1535\t          {\n1536\t          uint32_t cc;               /* Faster than PCRE2_UCHAR */\n1537\t          RMATCH(Fecode, RM25);\n1538\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n1539\t          if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n1540\t          if (Feptr >= mb->end_subject)\n1541\t            {\n1542\t            SCHECK_PARTIAL();\n1543\t            RRETURN(MATCH_NOMATCH);\n1544\t            }\n1545\t          cc = *Feptr;\n1546\t          if (Lc != cc && Loc != cc) RRETURN(MATCH_NOMATCH);\n1547\t          Feptr++;\n1548\t          }\n1549\t        PCRE2_UNREACHABLE(); /* Control never reaches here */\n1550\t        }\n1551\t\n1552\t      else  /* Maximize */\n1553\t        {\n1554\t        Lstart_eptr = Feptr;\n1555\t        for (i = Lmin; i < Lmax; i++)\n1556\t          {\n1557\t          uint32_t cc;               /* Faster than PCRE2_UCHAR */\n1558\t          if (Feptr >= mb->end_subject)\n1559\t            {\n1560\t            SCHECK_PARTIAL();\n1561\t            break;\n1562\t            }\n1563\t          cc = *Feptr;\n1564\t          if (Lc != cc && Loc != cc) break;\n1565\t          Feptr++;\n1566\t          }\n1567\t        if (reptype != REPTYPE_POS) for (;;)\n1568\t          {\n1569\t          if (Feptr == Lstart_eptr) break;\n1570\t          RMATCH(Fecode, RM26);\n1571\t          Feptr--;\n1572\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n1573\t          }\n1574\t        }\n1575\t      }\n1576\t\n1577\t    /* Caseful comparisons (includes all multi-byte characters) */\n1578\t\n1579\t    else\n1580\t      {\n1581\t      for (i = 1; i <= Lmin; i++)\n1582\t        {\n1583\t        if (Feptr >= mb->end_subject)\n1584\t          {\n1585\t          SCHECK_PARTIAL();\n1586\t          RRETURN(MATCH_NOMATCH);\n1587\t          }\n1588\t        if (Lc != *Feptr++) RRETURN(MATCH_NOMATCH);\n1589\t        }\n1590\t\n1591\t      if (Lmin == Lmax) continue;\n1592\t\n1593\t      if (reptype == REPTYPE_MIN)\n1594\t        {\n1595\t        for (;;)\n1596\t          {\n1597\t          RMATCH(Fecode, RM27);\n1598\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n1599\t          if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n1600\t          if (Feptr >= mb->end_subject)\n1601\t            {\n1602\t            SCHECK_PARTIAL();\n1603\t            RRETURN(MATCH_NOMATCH);\n1604\t            }\n1605\t          if (Lc != *Feptr++) RRETURN(MATCH_NOMATCH);\n1606\t          }\n1607\t        PCRE2_UNREACHABLE(); /* Control never reaches here */\n1608\t        }\n1609\t      else  /* Maximize */\n1610\t        {\n1611\t        Lstart_eptr = Feptr;\n1612\t        for (i = Lmin; i < Lmax; i++)\n1613\t          {\n1614\t          if (Feptr >= mb->end_subject)\n1615\t            {\n1616\t            SCHECK_PARTIAL();\n1617\t            break;\n1618\t            }\n1619\t\n1620\t          if (Lc != *Feptr) break;\n1621\t          Feptr++;\n1622\t          }\n1623\t\n1624\t        if (reptype != REPTYPE_POS) for (;;)\n1625\t          {\n1626\t          if (Feptr <= Lstart_eptr) break;\n1627\t          RMATCH(Fecode, RM28);\n1628\t          Feptr--;\n1629\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n1630\t          }\n1631\t        }\n1632\t      }\n1633\t    break;\n1634\t\n1635\t#undef Llength\n1636\t#undef Loclength\n1637\t#undef Lstart_eptr\n1638\t#undef Lcharptr\n1639\t#undef Lmin\n1640\t#undef Lmax\n1641\t#undef Lc\n1642\t#undef Loc\n1643\t#undef Loccu\n1644\t\n1645\t\n1646\t    /* ===================================================================== */\n1647\t    /* Match a negated single one-byte character repeatedly. This is almost a\n1648\t    repeat of the code for a repeated single character, but I haven't found a\n1649\t    nice way of commoning these up that doesn't require a test of the\n1650\t    positive/negative option for each character match. Maybe that wouldn't add\n1651\t    very much to the time taken, but character matching *is* what this is all\n1652\t    about... */\n1653\t\n1654\t#define Lstart_eptr  F->fields.charnot_repeat.start_eptr\n1655\t#define Lmin         F->fields.charnot_repeat.min\n1656\t#define Lmax         F->fields.charnot_repeat.max\n165