036\t\n2037\t    /* ===================================================================== */\n2038\t    /* Match a bit-mapped character class, possibly repeatedly. These opcodes\n2039\t    are used when all the characters in the class have values in the range\n2040\t    0-255, and either the matching is caseful, or the characters are in the\n2041\t    range 0-127 when UTF processing is enabled. The only difference between\n2042\t    OP_CLASS and OP_NCLASS occurs when a data character outside the range is\n2043\t    encountered. */\n2044\t\n2045\t#define Lbyte_map_address  F->fields.class_repeat.byte_map_address\n2046\t#define Lbyte_map          ((const unsigned char *)Lbyte_map_address)\n2047\t#define Lstart_eptr        F->fields.class_repeat.start_eptr\n2048\t#define Lmin               F->fields.class_repeat.min\n2049\t#define Lmax               F->fields.class_repeat.max\n2050\t\n2051\t    case OP_NCLASS:\n2052\t    case OP_CLASS:\n2053\t      {\n2054\t      Lbyte_map_address = Fecode + 1;           /* Save for matching */\n2055\t      Fecode += 1 + (32 / sizeof(PCRE2_UCHAR)); /* Advance past the item */\n2056\t\n2057\t      /* Look past the end of the item to see if there is repeat information\n2058\t      following. Then obey similar code to character type repeats. */\n2059\t\n2060\t      switch (*Fecode)\n2061\t        {\n2062\t        case OP_CRSTAR:\n2063\t        case OP_CRMINSTAR:\n2064\t        case OP_CRPLUS:\n2065\t        case OP_CRMINPLUS:\n2066\t        case OP_CRQUERY:\n2067\t        case OP_CRMINQUERY:\n2068\t        case OP_CRPOSSTAR:\n2069\t        case OP_CRPOSPLUS:\n2070\t        case OP_CRPOSQUERY:\n2071\t        fc = *Fecode++ - OP_CRSTAR;\n2072\t        Lmin = rep_min[fc];\n2073\t        Lmax = rep_max[fc];\n2074\t        reptype = rep_typ[fc];\n2075\t        break;\n2076\t\n2077\t        case OP_CRRANGE:\n2078\t        case OP_CRMINRANGE:\n2079\t        case OP_CRPOSRANGE:\n2080\t        Lmin = GET2(Fecode, 1);\n2081\t        Lmax = GET2(Fecode, 1 + IMM2_SIZE);\n2082\t        if (Lmax == 0) Lmax = UINT32_MAX;       /* Max 0 => infinity */\n2083\t        reptype = rep_typ[*Fecode - OP_CRSTAR];\n2084\t        Fecode += 1 + 2 * IMM2_SIZE;\n2085\t        break;\n2086\t\n2087\t        default:               /* No repeat follows */\n2088\t        Lmin = Lmax = 1;\n2089\t        break;\n2090\t        }\n2091\t\n2092\t      /* First, ensure the minimum number of matches are present. */\n2093\t\n2094\t#ifdef SUPPORT_UNICODE\n2095\t      if (utf)\n2096\t        {\n2097\t        for (i = 1; i <= Lmin; i++)\n2098\t          {\n2099\t          if (Feptr >= mb->end_subject)\n2100\t            {\n2101\t            SCHECK_PARTIAL();\n2102\t            RRETURN(MATCH_NOMATCH);\n2103\t            }\n2104\t          GETCHARINC(fc, Feptr);\n2105\t          if (fc > 255)\n2106\t            {\n2107\t            if (Fop == OP_CLASS) RRETURN(MATCH_NOMATCH);\n2108\t            }\n2109\t          else\n2110\t            if ((Lbyte_map[fc/8] & (1u << (fc&7))) == 0) RRETURN(MATCH_NOMATCH);\n2111\t          }\n2112\t        }\n2113\t      else\n2114\t#endif\n2115\t      /* Not UTF mode */\n2116\t        {\n2117\t        for (i = 1; i <= Lmin; i++)\n2118\t          {\n2119\t          if (Feptr >= mb->end_subject)\n2120\t            {\n2121\t            SCHECK_PARTIAL();\n2122\t            RRETURN(MATCH_NOMATCH);\n2123\t            }\n2124\t          fc = *Feptr++;\n2125\t#if PCRE2_CODE_UNIT_WIDTH != 8\n2126\t          if (fc > 255)\n2127\t            {\n2128\t            if (Fop == OP_CLASS) RRETURN(MATCH_NOMATCH);\n2129\t            }\n2130\t          else\n2131\t#endif\n2132\t          if ((Lbyte_map[fc/8] & (1u << (fc&7))) == 0) RRETURN(MATCH_NOMATCH);\n2133\t          }\n2134\t        }\n2135\t\n2136\t      /* If Lmax == Lmin we are done. Continue with main loop. */\n2137\t\n2138\t      if (Lmin == Lmax) continue;\n2139\t\n2140\t      /* If minimizing, keep testing the rest of the expression and advancing\n2141\t      the pointe