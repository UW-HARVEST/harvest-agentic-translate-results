ROCUREMENT OF\n33\tSUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\n34\tINTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\n35\tCONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\n36\tARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE\n37\tPOSSIBILITY OF SUCH DAMAGE.\n38\t-----------------------------------------------------------------------------\n39\t*/\n40\t\n41\t\n42\t#include \"pcre2_compile.h\"\n43\t\n44\t\n45\t\n46\ttypedef struct {\n47\t  /* Option bits for eclass. */\n48\t  uint32_t options;\n49\t  uint32_t xoptions;\n50\t  /* Rarely used members. */\n51\t  int *errorcodeptr;\n52\t  compile_block *cb;\n53\t  /* Bitmap is needed. */\n54\t  BOOL needs_bitmap;\n55\t} eclass_context;\n56\t\n57\t/* Checks the allowed tokens at the end of a class structure in debug mode.\n58\tWhen a new token is not processed by all loops, and the token is equals to\n59\ta) one of the cases here:\n60\t   the compiler will complain about a duplicated case value.\n61\tb) none of the cases here:\n62\t   the loop without the handler will stop with an assertion failure. */\n63\t\n64\t#ifdef PCRE2_DEBUG\n65\t#define CLASS_END_CASES(meta) \\\n66\t  default: \\\n67\t  PCRE2_ASSERT((meta) <= META_END); \\\n68\t  PCRE2_FALLTHROUGH /* Fall through */ \\\n69\t  case META_CLASS: \\\n70\t  case META_CLASS_NOT: \\\n71\t  case META_CLASS_EMPTY: \\\n72\t  case META_CLASS_EMPTY_NOT: \\\n73\t  case META_CLASS_END: \\\n74\t  case META_ECLASS_AND: \\\n75\t  case META_ECLASS_OR: \\\n76\t  case META_ECLASS_SUB: \\\n77\t  case META_ECLASS_XOR: \\\n78\t  case META_ECLASS_NOT:\n79\t#else\n80\t#define CLASS_END_CASES(meta) \\\n81\t  default:\n82\t#endif\n83\t\n84\t#ifdef SUPPORT_WIDE_CHARS\n85\t\n86\t/* Heapsort algorithm. */\n87\t\n88\tstatic void do_heapify(uint32_t *buffer, size_t size, size_t i)\n89\t{\n90\tsize_t max;\n91\tsize_t left;\n92\tsize_t right;\n93\tuint32_t tmp1, tmp2;\n94\t\n95\twhile (TRUE)\n96\t  {\n97\t  max = i;\n98\t  left = (i << 1) + 2;\n99\t  right = left + 2;\n100\t\n101\t  if (left < size && buffer[left] > buffer[max]) max = left;\n102\t  if (right < size && buffer[right] > buffer[max]) max = right;\n103\t  if (i == max) return;\n104\t\n105\t  /* Swap items. */\n106\t  tmp1 = buffer[i];\n107\t  tmp2 = buffer[i + 1];\n108\t  buffer[i] = buffer[max];\n109\t  buffer[i + 1] = buffer[max + 1];\n110\t  buffer[max] = tmp1;\n111\t  buffer[max + 1] = tmp2;\n112\t  i = max;\n113\t  }\n114\t}\n115\t\n116\t#ifdef SUPPORT_UNICODE\n117\t\n118\t#define PARSE_CLASS_UTF               0x1\n119\t#define PARSE_CLASS_CASELESS_UTF      0x2\n120\t#define PARSE_CLASS_RESTRICTED_UTF    0x4\n121\t#define PARSE_CLASS_TURKISH_UTF       0x8\n122\t\n123\t/* Get the range of nocase characters which includes the\n124\t'c' character passed as argument, or directly follows 'c'. */\n125\t\n126\tstatic const uint32_t*\n127\tget_nocase_range(uint32_t c)\n128\t{\n129\tuint32_t left = 0;\n130\tuint32_t right = PRIV(ucd_nocase_ranges_size);\n131\tuint32_t middle;\n132\t\n133\tif (c > MAX_UTF_CODE_POINT) return PRIV(ucd_nocase_ranges) + right;\n134\t\n135\twhile (TRUE)\n136\t  {\n137\t  /* Range end of the middle element. */\n138\t  middle = ((left + right) >> 1) | 0x1;\n139\t\n140\t  if (PRIV(ucd_nocase_ranges)[middle] <= c)\n141\t    left = middle + 1;\n142\t  else if (middle > 1 && PRIV(ucd_nocase_ranges)[middle - 2] > c)\n143\t    right = middle - 1;\n144\t  else\n145\t    return PRIV(ucd_nocase_ranges) + (middle - 1);\n146\t  }\n147\t}\n148\t\n149\t/* Get the list of othercase characters, which belongs to the passed range.\n150\tCreate ranges from these characters, and append them to the buffer argument. */\n151\t\n152\tstatic size_t\n153\tutf_caseless_extend(uint32_t start, uint32_t end, uint32_t options,\n154\t  uint32_t *buffer)\n155\t{\n156\tuint32_t new_start = start;\n157\tuint32_t new_end = end;\n158\tuint32_t c = start;\n159\tconst uint32_t *list;\n160\tuint32_t tmp[3];\n161\tsize_t result = 2;\n162\tconst uint32_t *skip_range = get_nocase_range(c);\n163\tuint32_t skip_start = skip_range[0];\n164\t\n165\t#if PCRE2_CODE_UNIT_WIDTH == 8\n166\tPCRE2_ASSERT(options & PARSE_CLASS_UTF);\n167\t#endif\n168\t\n169\t#if PCRE2_CODE_UNIT_WIDTH == 32\n170\tif (end > MAX_UTF_CODE_POINT) end = MAX_UTF_CODE_POINT;\n171\t#endif\n172\t\n173\twhile (c <= end)\n174\t  {\n175\t  uint32_t co;\n176\t\n177\t  if (c > skip_start)\n178\t    {\n179\t    c = skip_range[1];\n180\t    skip_range += 2;\n181\t    skip_start = skip_range[0];\n182\t    continue;\n183\t    }\n184\t\n185\t  /* Compute caseless set. */\n186\t\n187\t  if ((options & (PARSE_CLASS_TURKISH_UTF|PARSE_CLASS_RESTRICTED_UTF)) ==\n188\t        PARSE_CLASS_TURKISH_UTF &&\n189\t      UCD_ANY_I(c))\n190\t    {\n191\t    co = PRIV(ucd_turkish_dotted_i_caseset) + (UCD_DOTTED_I(c)? 0 : 3);\n192\t    }\n193\t  else if ((co = UCD_CASESET(c)) != 0 &&\n194\t           (options & PARSE_CLASS_RESTRICTED_UTF) != 0 &&\n195\t           PRIV(ucd_caseless_sets)[co] < 128)\n196\t    {\n197\t    co = 0;  /* Ignore the caseless set if it's restricted. */\n198\t    }\n199\t\n200\t  if (co != 0)\n201\t    list = PRIV(ucd_caseless_sets) + co;\n202\t  else\n203\t    {\n204\t    co = UCD_OTHERCASE(c);\n205\t    list = tmp;\n206\t    tmp[0] = c;\n207\t    tmp[1] = NOTACHAR;\n208\t\n209\t    if (co != c)\n210\t      {\n211\t      tmp[1] = co;\n212\t      tmp[2] = NOTACHAR;\n213\t      }\n214\t    }\n215\t  c++;\n216\t\n217\t  /* Add characters. */\n218\t  do\n219\t    {\n220\t#if PCRE2_CODE_UNIT_WIDTH == 16\n221\t    if (!(options & PARSE_CLASS_UTF) && *list > 0xffff) continue;\n222\t#endif\n223\t\n224\t    if (*list < new_start)\n225\t      {\n226\t      if (*list + 1 == new_start)\n227\t        {\n228\t        new_start--;\n229\t        continue;\n230\t        }\n231\t      }\n232\t    else if (*list > new_end)\n233\t      {\n234\t      if (*list - 1 == new_end)\n235\t        {\n236\t        new_end++;\n237\t        continue;\n238\t        }\n239\t      }\n240\t    else continue;\n241\t\n242\t    result += 2;\n243\t    if (buffer != NULL)\n244\t      {\n245\t      buffer[0] = *list;\n246\t      buffer[1] = *list;\n247\t      buffer += 2;\n248\t      }\n249\t    }\n250\t  while (*(++list) != NOTACHAR);\n251\t  }\n252\t\n253\t  if (buffer != NULL)\n254\t    {\n255\t    buffer[0] = new_start;\n256\t    buffer[1] = new_end;\n257\t    buffer += 2;\n258\t    (void)buffer;\n259\t    }\n260\t  return result;\n261\t}\n262\t\n263\t#endif\n264\t\n265\t/* Add a character list to a buffer. */\n266\t\n267\tstatic size_t\n268\tappend_char_list(const uint32_t *p, uint32_t *buffer)\n269\t{\n270\tconst uint32_t *n;\n271\tsize_t result = 0;\n272\t\n273\twhile (*p != NOTACHAR)\n274\t  {\n275\t  n = p;\n276\t  while (n[0] == n[1] - 1) n++;\n277\t\n278\t  PCRE2_ASSERT(*p < 0xffff);\n279\t\n280\t  if (buffer != NULL)\n281\t    {\n282\t    buffer[0] = *p;\n283\t    buffer[1] = *n;\n284\t    buffer += 2;\n285\t    }\n286\t\n287\t  result += 2;\n288\t  p = n + 1;\n289\t  }\n290\t\n291\t  return result;\n292\t}\n293\t\n294\tstatic uint32_t\n295\tget_highest_char(uint32_t options)\n296\t{\n297\t(void)options; /* Avoid compiler warning. */\n298\t\n299\t#if PCRE2_CODE_UNIT_WIDTH == 8\n300\treturn MAX_UTF_CODE_POINT;\n301\t#else\n302\t#ifdef SUPPORT_UNICODE\n303\treturn GET_MAX_CHAR_VALUE((options & PARSE_CLASS_UTF) != 0);\n304\t#else\n305\treturn MAX_UCHAR_VALUE;\n306\t#endif\n307\t#endif\n308\t}\n309\t\n310\t/* Add a negated character list to a buffer. */\n311\tstatic size_t\n312\tappend_negated_char_list(const uint32_t *p, uint32_t options, uint32_t *buffer)\n313\t{\n314\tconst uint32_t *n;\n315\tuint32_t start = 0;\n316\tsize_t result = 2;\n317\t\n318\tPCRE2_ASSERT(*p > 0);\n319\t\n320\twhile (*p != NOTACHAR)\n321\t  {\n322\t  n = p;\n323\t  while (n[0] == n[1] - 1) n++;\n324\t\n325\t  PCRE2_ASSERT(*p < 0xffff);\n326\t\n327\t  if (buffer != NULL)\n328\t    {\n329\t    buffer[0] = start;\n330\t    buffer[1] = *p - 1;\n331\t    buffer += 2;\n332\t    }\n333\t\n334\t  result += 2;\n335\t  start = *n + 1;\n336\t  p = n + 1;\n337\t  }\n338\t\n339\t  if (buffer != NULL)\n340\t    {\n341\t    buffer[0] = start;\n342\t    buffer[1] = get_highest_char(options);\n343\t    buffer += 2;\n344\t    (void)buffer;\n345\t    }\n346\t\n347\t  return result;\n348\t}\n349\t\n350\tstatic uint32_t *\n351\tappend_non_ascii_range(uint32_t options, uint32_t *buffer)\n352\t{\n353\t  if (buffer == NULL) return NULL;\n354\t\n355\t  buffer[0] = 0x100;\n356\t  buffer[1] = get_highest_char(options);\n357\t  return buffer + 2;\n358\t}\n359\t\n360\tstatic size_t\n361\tparse_class(uint32_t *ptr, uint32_t options, uint32_t *buffer)\n362\t{\n363\tsize_t total_size = 0;\n364\tsize_t size;\n365\tuint32_t meta_arg;\n366\tuint32_t start_char;\n367\t\n368\twhile (TRUE)\n369\t  {\n370\t  switch (META_CODE(*ptr))\n371\t    {\n372\t    case META_ESCAPE:\n373\t      meta_arg = META_DATA(*ptr);\n374\t      switch (meta_arg)\n375\t        {\n376\t        case ESC_D:\n377\t        case ESC_W:\n378\t        case ESC_S:\n379\t        buffer = append_non_ascii_range(options, buffer);\n380\t        total_size += 2;\n381\t        break;\n382\t\n383\t        case ESC_h:\n384\t        size = append_char_list(PRIV(hspace_list), buffer);\n385\t        total_size += size;\n386\t        if (buffer != NULL) buffer += size;\n387\t        break;\n388\t\n389\t        case ESC_H:\n390\t        size = append_negated_char_list(PRIV(hspace_list), options, buffer);\n391\t        total_size += size;\n392\t        if (buffer != NULL) buffer += size;\n393\t        break;\n394\t\n395\t        case ESC_v:\n396\t        size = append_char_list(PRIV(vspace_list), buffer);\n397\t        total_size += size;\n398\t        if (buffer != NULL) buffer += size;\n399\t        break;\n400\t\n401\t        case ESC_V:\n402\t        size = append_negated_char_list(PRIV(vspace_list), options, buffer);\n403\t        total_size += size;\n404\t        if (buffer != NULL) buffer += size;\n405\t        break;\n406\t\n407\t        case ESC_p:\n408\t        case ESC_P:\n409\t        ptr++;\n410\t        if (meta_arg == ESC_p && (*ptr >> 16) == PT_ANY)\n411\t          {\n412\t          if (buffer != NULL)\n413\t            {\n414\t            buffer[0] = 0;\n415\t            buffer[1] = get_highest_char(options);\n416\t            buffer += 2;\n417\t            }\n418\t          total_size += 2;\n419\t          }\n420\t        break;\n421\t        }\n422\t      ptr++;\n423\t      continue;\n424\t    case META_POSIX_NEG:\n425\t      buffer = append_non_ascii_range(options, buffer);\n426\t      total_size += 2;\n427\t      ptr += 2;\n428\t      continue;\n429\t    case META_POSIX:\n430\t      ptr += 2;\n431\t      continue;\n432\t    case META_BIGVALUE:\n433\t      /* Character literal */\n434\t      ptr++;\n435\t      break;\n436\t    CLASS_END_CASES(*ptr)\n437\t      if (*ptr >= META_END) return total_size;\n438\t      break;\n439\t    }\n440\t\n441\t    start_char = *ptr;\n442\t\n443\t    if (ptr[1] == META_RANGE_LITERAL || ptr[1] == META_RANGE_ESCAPED)\n444\t      {\n445\t      ptr += 2;\n446\t      PCRE2_ASSERT(*ptr < META_END || *ptr == META_BIGVALUE);\n447\t\n448\t      if (*ptr == META_BIGVALUE) ptr++;\n449\t\n450\t#ifdef EBCDIC\n451\t#error \"Missing EBCDIC support\"\n452\t#endif\n453\t      }\n454\t\n455\t#ifdef SUPPORT_UNICODE\n456\t    if (options & PARSE_CLASS_CASELESS_UTF)\n457\t      {\n458\t      size = utf_caseless_extend(start_char, *ptr++, options, buffer);\n459\t      if (buffer != NULL) buffer += size;\n460\t      total_size += size;\n461\t      continue;\n462\t      }\n463\t#endif\n464\t\n465\t    if (buffer != NULL)\n466\t      {\n467\t      buffer[0] = start_char;\n468\t      buffer[1] = *ptr;\n469\t      buffer += 2;\n470\t      }\n471\t\n472\t    ptr++;\n473\t    total_size += 2;\n474\t  }\n475\t\n476\t  return total_size;\n477\t}\n478\t\n479\t/* Extra uint32_t values for storing the lengths of range lists in\n480\tthe worst case. Two uint32_t lengths and a range end for a range\n481\tstarting before 255 */\n482\t#define CHAR_LIST_EXTRA_SIZE 3\n483\t\n484\t/* Starting character values for each character list. */\n485\t\n486\tstatic const uint32_t char_list_starts[] = {\n487\t#if PCRE2_CODE_UNIT_WIDTH == 32\n488\t  XCL_CHAR_LIST_HIGH_32_START,\n489\t#endif\n490\t#if PCRE2_CODE_UNIT_WIDTH == 32 || defined SUPPORT_UNICODE\n491\t  XCL_CHAR_LIST_LOW_32_START,\n492\t#endif\n493\t  XCL_CHAR_LIST_HIGH_16_START,\n494\t  /* Must be terminated by XCL_CHAR_LIST_LOW_16_START,\n495\t  which also represents the end of the bitset. */\n496\t  XCL_CHAR_LIST_LOW_16_START,\n497\t};\n498\t\n499\tstatic class_ranges *\n500\tcompile_optimize_class(uint32_t *start_ptr, uint32_t options,\n501\t  uint32_t xoptions, compile_block *cb)\n502\t{\n503\tclass_ranges* cranges;\n504\tuint32_t *ptr;\n505\tuint32_t *buffer;\n506\tuint32_t *dst;\n507\tuint32_t class_options = 0;\n508\tsize_t range_list_size = 0, total_size, i;\n509\tuint32_t tmp1, tmp2;\n510\tconst uint32_t *char_list_next;\n511\tuint16_t *next_char;\n512\tuint32_t char_list_start, char_list_end;\n513\tuint32_t range_start, range_end;\n514\t\n515\t#ifdef SUPPORT_UNICODE\n516\tif (options & PCRE2_UTF)\n517\t  class_options |= PARSE_CLASS_UTF;\n518\t\n519\tif ((options & PCRE2_CASELESS) && (options & (PCRE2_UTF|PCRE2_UCP)))\n520\t  class_options |= PARSE_CLASS_CASELESS_UTF;\n521\t\n522\tif (xoptions & PCRE2_EXTRA_CASELESS_RESTRICT)\n523\t  class_options |= PARSE_CLASS_RESTRICTED_UTF;\n524\t\n525\tif (xoptions & PCRE2_EXTRA_TURKISH_CASING)\n526\t  class_options |= PARSE_CLASS_TURKISH_UTF;\n527\t#else\n528\t(void)options;   /* Avoid compiler warning. */\n529\t(void)xoptions;  /* Avoid compiler warning. */\n530\t#endif\n531\t\n532\t/* Compute required space for the range. */\n533\t\n534\trange_list_size = parse_class(start_ptr, class_options, NULL);\n535\tPCRE2_ASSERT((range_list_size & 0x1) == 0);\n536\t\n537\t/* Allocate buffer. The total_size also represents the end of the buffer. */\n538\t\n539\ttotal_size = range_list_size +\n540\t   ((range_list_size >= 2) ? CHAR_LIST_EXTRA_SIZE : 0);\n541\t\n542\tcranges = cb->cx->memctl.malloc(\n543\t  sizeof(class_ranges) + total_size * sizeof(uint32_t),\n544\t  cb->cx->memctl.memory_data);\n545\t\n546\tif (cranges == NULL) return NULL;\n547\t\n548\tcranges->header.next = NULL;\n549\t#ifdef PCRE2_DEBUG\n550\tcranges->header.type = CDATA_CRANGE;\n551\t#endif\n552\tcranges->range_list_size = (uint16_t)range_list_size;\n553\tcranges->char_lists_types = 0;\n554\tcranges->char_lists_size = 0;\n555\tcranges->char_lists_start = 0;\n556\t\n557\tif (range_list_size == 0) return cranges;\n558\t\n559\tbuffer = (uint32_t*)(cranges + 1);\n560\tparse_class(start_ptr, class_options, buffer);\n561\t\n562\t/* Using <= instead of == to help static analysis. */\n563\tif (range_list_size <= 2) return cranges;\n564\t\n565\t/* In-place sorting of ranges. */\n566\t\n567\ti = (((range_list_size >> 2) - 1) << 1);\n568\twhile (TRUE)\n569\t  {\n570\t  do_heapify(buffer, range_list_size, i);\n571\t  if (i == 0) break;\n572\t  i -= 2;\n573\t  }\n574\t\n575\ti = range_list_size - 2;\n576\twhile (TRUE)\n577\t  {\n578\t  tmp1 = buffer[i];\n579\t  tmp2 = buffer[i + 1];\n580\t  buffer[i] = buffer[0];\n581\t  buffer[i + 1] = buffer[1];\n582\t  buffer[0] = tmp1;\n583\t  buffer[1] = tmp2;\n584\t\n585\t  do_heapify(buffer, i, 0);\n586\t  if (i == 0) break;\n587\t  i -= 2;\n588\t  }\n589\t\n590\t/* Merge ranges whenever possible. */\n591\tdst = buffer;\n592\tptr = buffer + 2;\n593\trange_list_size -= 2;\n594\t\n595\t/* The second condition is a very rare corner case, where the end of the last\n596\trange is the maximum character. This range cannot be extended further. */\n597\t\n598\twhile (range_list_size > 0 && dst[1] != ~(uint32_t)0)\n599\t  {\n600\t  if (dst[1] + 1 < ptr[0])\n601\t    {\n602\t    dst += 2;\n603\t    dst[0] = ptr[0];\n604\t    dst[1] = ptr[1];\n605\t    }\n606\t  else if (dst[1] < ptr[1]) dst[1] = ptr[1];\n607\t\n608\t  ptr += 2;\n609\t  range_list_size -= 2;\n610\t  }\n611\t\n612\tPCRE2_ASSERT(dst[1] <= get_highest_char(class_options));\n613\t\n614\t/* When the number of ranges are less than six,\n615\tthey are not converted to range lists. */\n616\t\n617\tptr = buffer;\n618\twhile (ptr < dst && ptr[1] < 0x100) ptr += 2;\n619\tif (dst - ptr < (2 * (6 - 1)))\n620\t  {\n621\t  cranges->range_list_size = (uint16_t)(dst + 2 - buffer);\n622\t  return cranges;\n623\t  }\n624\t\n625\t/* Compute character lists structures. */\n626\t\n627\tchar_list_next = char_list_starts;\n628\tchar_list_start = *char_list_next++;\n629\t#if PCRE2_CODE_UNIT_WIDTH == 32\n630\tchar_list_end = XCL_CHAR_LIST_HIGH_32_END;\n631\t#elif defined SUPPORT_UNICODE\n632\tchar_list_end = XCL_CHAR_LIST_LOW_32_END;\n633\t#else\n634\tchar_list_end = XCL_CHAR_LIST_HIGH_16_END;\n635\t#endif\n636\tnext_char = (uint16_t*)(buffer + total_size);\n637\t\n638\ttmp1 = 0;\n639\ttmp2 = ((sizeof(char_list_starts) / sizeof(uint32_t)) - 1) * XCL_TYPE_BIT_LEN;\n640\tPCRE2_ASSERT(tmp2 <= 3 * XCL_TYPE_BIT_LEN && tmp2 >= XCL_TYPE_BIT_LEN);\n641\trange_start = dst[0];\n642\trange_end = dst[1];\n643\t\n644\twhile (TRUE)\n645\t  {\n646\t  if (range_start >= char_list_start)\n647\t    {\n648\t    if (range_start == range_end || range_end < char_list_end)\n649\t      {\n650\t      tmp1++;\n651\t      next_char--;\n652\t\n653\t      if (char_list_start < XCL_CHAR_LIST_LOW_32_START)\n654\t        *next_char = (uint16_t)((range_end << XCL_CHAR_SHIFT) | XCL_CHAR_END);\n655\t      else\n656\t        *(uint32_t*)(--next_char) =\n657\t          (range_end << XCL_CHAR_SHIFT) | XCL_CHAR_END;\n658\t      }\n659\t\n660\t    if (range_start < range_end)\n661\t      {\n662\t      if (range_start > char_list_start)\n663\t        {\n664\t        tmp1++;\n665\t        next_char--;\n666\t\n667\t        if (char_list_start < XCL_CHAR_LIST_LOW_32_START)\n668\t          *next_char = (uint16_t)(range_start << XCL_CHAR_SHIFT);\n669\t        else\n670\t          *(uint32_t*)(--next_char) = (range_start << XCL_CHAR_SHIFT);\n671\t        }\n672\t      else\n673\t        cranges->char_lists_types |= XCL_BEGIN_WITH_RANGE << tmp2;\n674\t      }\n675\t\n676\t    PCRE2_ASSERT((uint32_t*)next_char >= dst + 2);\n677\t\n678\t    if (dst > buffer)\n679\t      {\n680\t      dst -= 2;\n681\t      range_start = dst[0];\n682\t      range_end = dst[1];\n683\t      continue;\n684\t      }\n685\t\n686\t    range_start = 0;\n687\t    range_end = 0;\n688\t    }\n689\t\n690\t  if (range_end >= char_list_start)\n691\t    {\n692\t    PCRE2_ASSERT(range_start < char_list_start);\n693\t\n694\t    if (range_end < char_list_end)\n695\t      {\n696\t      tmp1++;\n697\t      next_char--;\n698\t\n699\t      if (char_list_start < XCL_CHAR_LIST_LOW_32_START)\n700\t        *next_char = (uint16_t)((range_end << XCL_CHAR_SHIFT) | XCL_CHAR_END);\n701\t      else\n702\t        *(uint32_t*)(--next_char) =\n703\t          (range_end << XCL_CHAR_SHIFT) | XCL_CHAR_END;\n704\t\n705\t      PCRE2_ASSERT((uint32_t*)next_char >= dst + 2);\n706\t      }\n707\t\n708\t    cranges->char_lists_types |= XCL_BEGIN_WITH_RANGE << tmp2;\n709\t    }\n710\t\n711\t  if (tmp1 >= XCL_ITEM_COUNT_MASK)\n712\t    {\n713\t    cranges->char_lists_types |= XCL_ITEM_COUNT_MASK << tmp2;\n714\t    next_char--;\n715\t\n716\t    if (char_list_start < XCL_CHAR_LIST_LOW_32_START)\n717\t      *next_char = (uint16_t)tmp1;\n718\t    else\n719\t      *(uint32_t*)(--next_char) = tmp1;\n720\t    }\n721\t  else\n722\t    cranges->char_lists_types |= tmp1 << tmp2;\n723\t\n724\t  if (range_end < XCL_CHAR_LIST_LOW_16_START || tmp2 == 0)\n725\t    {\n726\t    PCRE2_ASSERT(range_start < XCL_CHAR_LIST_LOW_16_START);\n727\t    break;\n728\t    }\n729\t\n730\t  PCRE2_ASSERT((tmp2 % XCL_TYPE_BIT_LEN) == 0);\n731\t  char_list_end = char_list_start - 1;\n732\t  char_list_start = *char_list_next++;\n733\t  tmp1 = 0;\n734\t  tmp2 -= XCL_TYPE_BIT_LEN;\n735\t  }\n736\t\n737\tif (dst[0] < XCL_CHAR_LIST_LOW_16_START) dst += 2;\n738\tPCRE2_ASSERT((uint16_t*)dst <= next_char);\n739\t\n740\tcranges->char_lists_size =\n741\t  (size_t)((uint8_t*)(buffer + total_size) - (uint8_t*)next_char);\n742\tcranges->char_lists_start = (size_t)((uint8_t*)next_char - (uint8_t*)buffer);\n743\tcranges->range_list_size = (uint16_t)(dst - buffer);\n744\treturn cranges;\n745\t}\n746\t\n747\t#endif /* SUPPORT_WIDE_CHARS */\n748\t\n749\t#ifdef SUPPORT_UNICODE\n750\t\n751\tvoid PRIV(update_classbits)(uint32_t ptype, uint32_t pdata, BOOL negated,\n752\t  uint8_t *classbits)\n753\t{\n754\t/* Update PRIV(xclass) when this function is changed. */\n755\tint c, chartype;\n756\tconst ucd_record *prop;\n757\tuint32_t gentype;\n758\tBOOL set_bit;\n759\t\n760\tif (ptype == PT_ANY)\n761\t  {\n762\t  if (!negated) memset(classbits, 0xff, 32);\n763\t  return;\n764\t  }\n765\t\n766\tfor (c = 0; c < 256; c++)\n767\t  {\n768\t  prop = GET_UCD(c);\n769\t  set_bit = FALSE;\n770\t  (void)set_bit;\n771\t\n772\t  switch (ptype)\n773\t    {\n774\t    case PT_LAMP:\n775\t    chartype = prop->chartype;\n776\t    set_bit = (chartype == ucp_Lu || chartype == ucp_Ll || chartype == ucp_Lt);\n777\t    break;\n778\t\n779\t    case PT_GC:\n780\t    set_bit = (PRIV(ucp_gentype)[prop->chartype] == pdata);\n781\t    break;\n782\t\n783\t    case PT_PC:\n784\t    set_bit = (prop->chartype == pdata);\n785\t    break;\n786\t\n787\t    case PT_SC:\n788\t    set_bit = (prop->script == pdata);\n789\t    break;\n790\t\n791\t    case PT_SCX:\n792\t    set_bit = (prop->script == pdata ||\n793\t      MAPBIT(PRIV(ucd_script_sets) + UCD_SCRIPTX_PROP(prop), pdata) != 0);\n794\t    break;\n795\t\n796\t    case PT_ALNUM:\n797\t    gentype = PRIV(ucp_gentype)[prop->chartype];\n798\t    set_bit = (gentype == ucp_L || gentype == ucp_N);\n799\t    break;\n800\t\n801\t    case PT_SPACE:    /* Perl space */\n802\t    case PT_PXSPACE:  /* POSIX space */\n803\t    switch(c)\n804\t      {\n805\t      HSPACE_BYTE_CASES:\n806\t      VSPACE_BYTE_CASES:\n807\t      set_bit = TRUE;\n808\t      break;\n809\t\n810\t      default:\n811\t      set_bit = (PRIV(ucp_gentype)[prop->chartype] == ucp_Z);\n812\t      break;\n813\t      }\n814\t    break;\n815\t\n816\t    case PT_WORD:\n817\t    chartype = prop->chartype;\n818\t    gentype = PRIV(ucp_gentype)[chartype];\n819\t    set_bit = (gentype == ucp_L || gentype == ucp_N ||\n820\t               chartype == ucp_Mn || chartype == ucp_Pc);\n821\t    break;\n822\t\n823\t    case PT_UCNC:\n824\t    set_bit = (c == CHAR_DOLLAR_SIGN || c == CHAR_COMMERCIAL_AT ||\n825\t               c == CHAR_GRAVE_ACCENT || c >= 0xa0);\n826\t    break;\n827\t\n828\t    case PT_BIDICL:\n829\t    set_bit = (UCD_BIDICLASS_PROP(prop) == pdata);\n830\t    break;\n831\t\n832\t    case PT_BOOL:\n833\t    set_bit = MAPBIT(PRIV(ucd_boolprop_sets) +\n834\t                     UCD_BPROPS_PROP(prop), pdata) != 0;\n835\t    break;\n836\t\n837\t    case PT_PXGRAPH:\n838\t    chartype = prop->chartype;\n839\t    gentype = PRIV(ucp_gentype)[chartype];\n840\t    set_bit = (gentype != ucp_Z && (gentype != ucp_C || chartype == ucp_Cf));\n841\t    break;\n842\t\n843\t    case PT_PXPRINT:\n844\t    chartype = prop->chartype;\n845\t    set_bit = (chartype != ucp_Zl && chartype != ucp_Zp &&\n846\t       (PRIV(ucp_gentype)[chartype] != ucp_C || chartype == ucp_Cf));\n847\t    break;\n848\t\n849\t    case PT_PXPUNCT:\n850\t    gentype = PRIV(ucp_gentype)[prop->chartype];\n851\t    set_bit = (gentype == ucp_P || (c < 128 && gentype == ucp_S));\n852\t    break;\n853\t\n854\t    default:\n855\t    PCRE2_ASSERT(ptype == PT_PXXDIGIT);\n856\t    set_bit = (c >= CHAR_0 && c <= CHAR_9) ||\n857\t              (c >= CHAR_A && c <= CHAR_F) ||\n858\t              (c >= CHAR_a && c <= CHAR_f);\n859\t    break;\n860\t    }\n861\t\n862\t  if (negated) set_bit = !set_bit;\n863\t  if (set_bit) *classbits |= (uint8_t)(1 << (c & 0x7));\n864\t  if ((c & 0x7) == 0x7) classbits++;\n865\t  }\n866\t}\n867\t\n868\t#endif /* SUPPORT_UNICODE */\n869\t\n870\t\n871\t\n872\t#ifdef SUPPORT_WIDE_CHARS\n873\t\n874\t/*************************************************\n875\t*           XClass related properties            *\n876\t*************************************************/\n877\t\n878\t/* XClass needs to be generated. */\n879\t#define XCLASS_REQUIRED 0x1\n880\t/* XClass has 8 bit character. */\n881\t#define XCLASS_HAS_8BIT_CHARS 0x2\n882\t/* XClass has properties. */\n883\t#define XCLASS_HAS_PROPS 0x4\n884\t/* XClass has character lists. */\n885\t#define XCLASS_HAS_CHAR_LISTS 0x8\n886\t/* XClass matches to all >= 256 characters. */\n887\t#define XCLASS_HIGH_ANY 0x10\n888\t\n889\t#endif\n890\t\n891\t\n892\t/*************************************************\n893\t*   Internal entry point for add range to class  *\n894\t*************************************************/\n895\t\n896\t/* This function sets the overall range for characters < 256.\n897\tIt also handles non-utf case folding.\n898\t\n899\tArguments:\n900\t  options       the options bits\n901\t  xoptions      the extra options bits\n902\t  cb            compile data\n903\t  start         start of range character\n904\t  end           end of range character\n905\t\n906\tReturns:        cb->classbits is updated\n907\t*/\n908\t\n909\tstatic void\n910\tadd_to_class(uint32_t options, uint32_t xoptions, compile_block *cb,\n911\t  uint32_t start, uint32_t end)\n912\t{\n913\tuint8_t *classbits = cb->classbits.classbits;\n914\tuint32_t c, byte_start, byte_end;\n915\tuint32_t classbits_end = (end <= 0xff ? end : 0xff);\n916\t\n917\t#ifndef SUPPORT_UNICODE\n918\t(void)xoptions; /* Avoid compiler warning. */\n919\t#endif\n920\t\n921\t/* If caseless matching is required, scan the range and process alternate\n922\tcases. In Unicode, there are 8-bit characters that have alternate cases that\n923\tare greater than 255 and vice-versa (though these may be ignored if caseless\n924\trestriction is in force). Sometimes we can just extend the original range. */\n925\t\n926\tif ((options & PCRE2_CASELESS) != 0)\n927\t  {\n928\t#ifdef SUPPORT_UNICODE\n929\t  /* UTF mode. This branch is taken if we don't support wide characters (e.g.\n930\t  8-bit library, without UTF), but we do treat those characters as Unicode\n931\t  (if UCP flag is set). In this case, we only need to expand the character class\n932\t  set to include the case pairs which are in the 0-255 codepoint range. */\n933\t  if ((options & (PCRE2_UTF|PCRE2_UCP)) != 0)\n934\t    {\n935\t      BOOL turkish_i = (xoptions & (PCRE2_EXTRA_TURKISH_CASING|PCRE2_EXTRA_CASELESS_RESTRICT)) ==\n936\t        PCRE2_EXTRA_TURKISH_CASING;\n937\t      if (start < 128)\n938\t        {\n939\t        uint32_t lo_end = (classbits_end < 127 ? classbits_end : 127);\n940\t        for (c = start; c <= lo_end; c++)\n941\t          {\n942\t          if (turkish_i && UCD_ANY_I(c)) continue;\n943\t          SETBIT(classbits, cb->fcc[c]);\n944\t          }\n945\t        }\n946\t      if (classbits_end >= 128)\n947\t        {\n948\t        uint32_t hi_start = (start > 128 ? start : 128);\n949\t        for (c = hi_start; c <= classbits_end; c++)\n950\t          {\n951\t          uint32_t co = UCD_OTHERCASE(c);\n952\t          if (co <= 0xff) SETBIT(classbits, co);\n953\t          }\n954\t        }\n955\t    }\n956\t\n957\t  else\n958\t#endif  /* SUPPORT_UNICODE */\n959\t\n960\t  /* Not UTF mode */\n961\t    {\n962\t    for (c = start; c <= classbits_end; c++)\n963\t      SETBIT(classbits, cb->fcc[c]);\n964\t    }\n965\t  }\n966\t\n967\t/* Use the bitmap for characters < 256. Otherwise use extra data. */\n968\t\n969\tbyte_start = (start + 7) >> 3;\n970\tbyte_end = (classbits_end + 1) >> 3;\n971\t\n972\tif (byte_start >= byte_end)\n973\t  {\n974\t  for (c = start; c <= classbits_end; c++)\n975\t    /* Regardless of start, c will always be <= 255. */\n976\t    SETBIT(classbits, c);\n977\t  return;\n978\t  }\n979\t\n980\tfor (c = byte_start; c < byte_end; c++)\n981\t  classbits[c] = 0xff;\n982\t\n983\tbyte_start <<= 3;\n984\tbyte_end <<= 3;\n985\t\n986\tfor (c = start; c < byte_start; c++)\n987\t  SETBIT(classbits, c);\n988\t\n989\tfor (c = byte_end; c <= classbits_end; c++)\n990\t  SETBIT(classbits, c);\n991\t}\n992\t\n993\t\n994\t#if PCRE2_CODE_UNIT_WIDTH == 8\n995\t/*************************************************\n996\t*   Internal entry point for add list to class   *\n997\t*************************************************/\n998\t\n999\t/* This function is used for adding a list of horizontal or vertical whitespace\n1000\tcharacters to a class. The list must be in order so that ranges of characters\n1001\tcan be detected and handled appropriately. This function sets the overall range\n1002\tso that the internal functions can try to avoid duplication when handling\n1003\tcase-independence.\n1004\t\n1005\tArguments:\n1006\t  options       the options bits\n1007\t  xoptions      the extra options bits\n1008\t  cb            contains pointers to tables etc.\n1009\t  p             points to row of 32-bit values, terminated by NOTACHAR\n1010\t\n1011\tReturns:        cb->classbits is updated\n1012\t*/\n1013\t\n1014\tstatic void\n1015\tadd_list_to_class(uint32_t options, uint32_t xoptions, compile_block *cb,\n1016\t  const uint32_t *p)\n1017\t{\n1018\twhile (p[0] < 256)\n1019\t  {\n1020\t  unsigned int n = 0;\n1021\t\n1022\t  while(p[n+1] == p[0] + n + 1) n++;\n1023\t  add_to_class(options, xoptions, cb, p[0], p[n]);\n1024\t\n1025\t  p += n + 1;\n1026\t  }\n1027\t}\n1028\t\n1029\t\n1030\t\n1031\t/*************************************************\n1032\t*    Add characters not in a list to a class     *\n1033\t*************************************************/\n1034\t\n1035\t/* This function is used for adding the complement of a list of horizontal or\n1036\tvertical whitespace to a class. The list must be in order.\n1037\t\n1038\tArguments:\n1039\t  options       the options bits\n1040\t  xoptions      the extra options bits\n1041\t  cb            contains pointers to tables etc.\n1042\t  p             points to row of 32-bit values, terminated by NOTACHAR\n1043\t\n1044\tReturns:        cb->classbits is updated\n1045\t*/\n1046\t\n1047\tstatic void\n1048\tadd_not_list_to_class(uint32_t options, uint32_t xoptions, compile_block *cb,\n1049\t  const uint32_t *p)\n1050\t{\n1051\tif (p[0] > 0)\n1052\t  add_to_class(options, xoptions, cb, 0, p[0] - 1);\n1053\twhile (p[0] < 256)\n1054\t  {\n1055\t  while (p[1] == p[0] + 1) p++;\n1056\t  add_to_class(options, xoptions, cb, p[0] + 1, (p[1] > 255) ? 255 : p[1] - 1);\n1057\t  p++;\n1058\t  }\n1059\t}\n1060\t#endif /* PCRE2_CODE_UNIT_WIDTH == 8 */\n1061\t\n1062\t\n1063\t\n1064\t/*************************************************\n1065\t*  Main entry-point to compile a character class *\n1066\t*************************************************/\n1067\t\n1068\t/* This function consumes a \"leaf\", which is a set of characters that will\n1069\tbecome a single OP_CLASS OP_NCLASS, OP_XCLASS, or OP_ALLANY. */\n1070\t\n1071\tuint32_t *\n1072\tPRIV(compile_class_not_nested)(uint32_t options, uint32_t xoptions,\n1073\t  uint32_t *start_ptr, PCRE2_UCHAR **pcode, BOOL negate_class, BOOL* has_bitmap,\n1074\t  int *errorcodeptr, compile_block *cb, PCRE2_SIZE *lengthptr)\n1075\t{\n1076\tuint32_t *pptr = start_ptr;\n1077\tPCRE2_UCHAR *code = *pcode;\n1078\tBOOL should_flip_negation;\n1079\tconst uint8_t *cbits = cb->cbits;\n1080\t/* Some functions such as add_to_class() or eclass processing\n1081\texpects that the bitset is stored in cb->classbits.classbits. */\n1082\tuint8_t *const classbits = cb->classbits.classbits;\n1083\t\n1084\t#ifdef SUPPORT_UNICODE\n1085\tBOOL utf = (options & PCRE2_UTF) != 0;\n1086\t#else  /* No Unicode support */\n1087\tBOOL utf = FALSE;\n1088\t#endif\n1089\t\n1090\t/* Helper variables for OP_XCLASS opcode (for characters > 255). */\n1091\t\n1092\t#ifdef SUPPORT_WIDE_CHARS\n1093\tuint32_t xclass_props;\n1094\tPCRE2_UCHAR *class_uchardata;\n1095\tclass_ranges* cranges;\n1096\t#else\n1097\t(void)has_bitmap;    /* Avoid compiler warning. */\n1098\t(void)errorcodeptr;  /* Avoid compiler warning. */\n1099\t(void)lengthptr;     /* Avoid compiler warning. */\n1100\t#endif\n1101\t\n1102\t/* If an XClass contains a negative special such as \\S, we need to flip the\n1103\tnegation flag at the end, so that support for characters > 255 works correctly\n1104\t(they are all included in the class). An XClass may need to insert specific\n1105\tmatching or non-matching code for wide characters.\n1106\t*/\n1107\t\n1108\tshould_flip_negation = FALSE;\n1109\t\n1110\t/* XClass will be used when characters > 255 might match. */\n1111\t\n1112\t#ifdef SUPPORT_WIDE_CHARS\n1113\txclass_props = 0;\n1114\t\n1115\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1116\tcranges = NULL;\n1117\t\n1118\tif (utf)\n1119\t#endif\n1120\t  {\n1121\t  if (lengthptr != NULL)\n1122\t    {\n1123\t    cranges = compile_optimize_class(pptr, options, xoptions, cb);\n1124\t\n1125\t    if (cranges == NULL)\n1126\t      {\n1127\t      *errorcodeptr = ERR21;\n1128\t      return NULL;\n1129\t      }\n1130\t\n1131\t    /* Caching the pre-processed character ranges. */\n1132\t    if (cb->last_data != NULL)\n1133\t      cb->last_data->next = &cranges->header;\n1134\t    else\n1135\t      cb->first_data = &cranges->header;\n1136\t\n1137\t    cb->last_data = &cranges->header;\n1138\t    }\n1139\t  else\n1140\t    {\n1141\t    /* Reuse the pre-processed character ranges. */\n1142\t    cranges = (class_ranges*)cb->first_data;\n1143\t    PCRE2_ASSERT(cranges != NULL && cranges->header.type == CDATA_CRANGE);\n1144\t    cb->first_data = cranges->header.next;\n1145\t    }\n1146\t\n1147\t  if (cranges->range_list_size > 0)\n1148\t    {\n1149\t    const uint32_t *ranges = (const uint32_t*)(cranges + 1);\n1150\t\n1151\t    if (ranges[0] <= 255)\n1152\t      xclass_props |= XCLASS_HAS_8BIT_CHARS;\n1153\t\n1154\t    if (ranges[cranges->range_list_size - 1] == GET_MAX_CHAR_VALUE(utf) &&\n1155\t        ranges[cranges->range_list_size - 2] <= 256)\n1156\t      xclass_props |= XCLASS_HIGH_ANY;\n1157\t    }\n1158\t  }\n1159\t\n1160\tclass_uchardata = code + LINK_SIZE + 2;   /* For XCLASS items */\n1161\t#endif /* SUPPORT_WIDE_CHARS */\n1162\t\n1163\t/* Initialize the 256-bit (32-byte) bit map to all zeros. We build the map\n1164\tin a temporary bit of memory, in case the class contains fewer than two\n1165\t8-bit characters because in that case the compiled code doesn't use the bit\n1166\tmap. */\n1167\t\n1168\tmemset(classbits, 0, 32);\n1169\t\n1170\t/* Process items until end_ptr is reached. */\n1171\t\n1172\twhile (TRUE)\n1173\t  {\n1174\t  uint32_t meta = *(pptr++);\n1175\t  BOOL local_negate;\n1176\t  int posix_class;\n1177\t  int taboffset, tabopt;\n1178\t  class_bits_storage pbits;\n1179\t  uint32_t escape, c;\n1180\t\n1181\t  /* Handle POSIX classes such as [:alpha:] etc. */\n1182\t  switch (META_CODE(meta))\n1183\t    {\n1184\t    case META_POSIX:\n1185\t    case META_POSIX_NEG:\n1186\t\n1187\t    local_negate = (meta == META_POSIX_NEG);\n1188\t    posix_class = *(pptr++);\n1189\t\n1190\t    if (local_negate) should_flip_negation = TRUE;  /* Note negative special */\n1191\t\n1192\t    /* If matching is caseless, upper and lower are converted to alpha.\n1193\t    This relies on the fact that the class table starts with alpha,\n1194\t    lower, upper as the first 3 entries. */\n1195\t\n1196\t    if ((options & PCRE2_CASELESS) != 0 && posix_class <= 2)\n1197\t      posix_class = 0;\n1198\t\n1199\t    /* When PCRE2_UCP is set, some of the POSIX classes are converted to\n1200\t    different escape sequences that use Unicode properties \\p or \\P.\n1201\t    Others that are not available via \\p or \\P have to generate\n1202\t    XCL_PROP/XCL_NOTPROP directly, which is done here. */\n1203\t\n1204\t#ifdef SUPPORT_UNICODE\n1205\t    /* TODO This entire block of code here appears to be unreachable!? I simply\n1206\t    can't see how it can be hit, given that the frontend parser doesn't emit\n1207\t    META_POSIX for GRAPH/PRINT/PUNCT when UCP is set. */\n1208\t    if ((options & PCRE2_UCP) != 0 &&\n1209\t        (xoptions & PCRE2_EXTRA_ASCII_POSIX) == 0)\n1210\t      {\n1211\t      uint32_t ptype;\n1212\t\n1213\t      switch(posix_class)\n1214\t        {\n1215\t        case PC_GRAPH:\n1216\t        case PC_PRINT:\n1217\t        case PC_PUNCT:\n1218\t        ptype = (posix_class == PC_GRAPH)? PT_PXGRAPH :\n1219\t                (posix_class == PC_PRINT)? PT_PXPRINT : PT_PXPUNCT;\n1220\t\n1221\t        PRIV(update_classbits)(ptype, 0, local_negate, classbits);\n1222\t\n1223\t        if ((xclass_props & XCLASS_HIGH_ANY) == 0)\n1224\t          {\n1225\t          if (lengthptr != NULL)\n1226\t            *lengthptr += 3;\n1227\t          else\n1228\t            {\n1229\t            *class_uchardata++ = local_negate? XCL_NOTPROP : XCL_PROP;\n1230\t            *class_uchardata++ = (PCRE2_UCHAR)ptype;\n1231\t            *class_uchardata++ = 0;\n1232\t            }\n1233\t          xclass_props |= XCLASS_REQUIRED | XCLASS_HAS_PROPS;\n1234\t          }\n1235\t        continue;\n1236\t\n1237\t        /* For the other POSIX classes (ex: ascii) we are going to\n1238\t        fall through to the non-UCP case and build a bit map for\n1239\t        characters with code points less than 256. However, if we are in\n1240\t        a negated POSIX class, characters with code points greater than\n1241\t        255 must either all match or all not match, depending on whether\n1242\t        the whole class is not or is negated. For example, for\n1243\t        [[:^ascii:]... they must all match, whereas for [^[:^ascii:]...\n1244\t        they must not.\n1245\t\n1246\t        In the special case where there are no xclass items, this is\n1247\t        automatically handled by the use of OP_CLASS or OP_NCLASS, but an\n1248\t        explicit range is needed for OP_XCLASS. Setting a flag here\n1249\t        causes the range to be generated later when it is known that\n1250\t        OP_XCLASS is required. In the 8-bit library this is relevant only in\n1251\t        utf mode, since no wide characters can exist otherwise. */\n1252\t\n1253\t        default:\n1254\t        break;\n1255\t        }\n1256\t      }\n1257\t#endif  /* SUPPORT_UNICODE */\n1258\t\n1259\t    /* In the non-UCP case, or when UCP makes no difference, we build the\n1260\t    bit map for the POSIX class in a chunk of local store because we may\n1261\t    be adding and subtracting from it, and we don't want to subtract bits\n1262\t    that may be in the main map already. At the end we or the result into\n1263\t    the bit map that is being built. */\n1264\t\n1265\t    posix_class *= 3;\n1266\t\n1267\t    /* Copy in the first table (always present) */\n1268\t\n1269\t    memcpy(pbits.classbits, cbits + PRIV(posix_class_maps)[posix_class], 32);\n1270\t\n1271\t    /* If there is a second table, add or remove it as required. */\n1272\t\n1273\t    taboffset = PRIV(posix_class_maps)[posix_class + 1];\n1274\t    tabopt = PRIV(posix_class_maps)[posix_class + 2];\n1275\t\n1276\t    if (taboffset >= 0)\n1277\t      {\n1278\t      if (tabopt >= 0)\n1279\t        for (int i = 0; i < 32; i++)\n1280\t          pbits.classbits[i] |= cbits[i + taboffset];\n1281\t      else\n1282\t        for (int i = 0; i < 32; i++)\n1283\t          pbits.classbits[i] &= (uint8_t)(~cbits[i + taboffset]);\n1284\t      }\n1285\t\n1286\t    /* Now see if we need to remove any special characters. An option\n1287\t    value of 1 removes vertical space and 2 removes underscore. */\n1288\t\n1289\t    if (tabopt < 0) tabopt = -tabopt;\n1290\t#ifdef EBCDIC\n1291\t      {\n1292\t      uint8_t posix_vertical[4] = { CHAR_LF, CHAR_VT, CHAR_FF, CHAR_CR };\n1293\t      uint8_t posix_underscore = CHAR_UNDERSCORE;\n1294\t      uint8_t *chars = NULL;\n1295\t      int n = 0;\n1296\t\n1297\t      if (tabopt == 1) { chars = posix_vertical; n = 4; }\n1298\t      else if (tabopt == 2) { chars = &posix_underscore; n = 1; }\n1299\t\n1300\t      for (; n > 0; ++chars, --n)\n1301\t        pbits.classbits[*chars/8] &= ~(1u << (*chars&7));\n1302\t      }\n1303\t#else\n1304\t    if (tabopt == 1) pbits.classbits[1] &= ~0x3c;\n1305\t    else if (tabopt == 2) pbits.classbits[11] &= 0x7f;\n1306\t#endif\n1307\t\n1308\t    /* Add the POSIX table or its complement into the main table that is\n1309\t    being built and we are done. */\n1310\t\n1311\t      {\n1312\t      uint32_t *classwords = cb->classbits.classwords;\n1313\t\n1314\t      if (local_negate)\n1315\t        for (int i = 0; i < 8; i++)\n1316\t          classwords[i] |= (uint32_t)(~pbits.classwords[i]);\n1317\t      else\n1318\t        for (int i = 0; i < 8; i++)\n1319\t          classwords[i] |= pbits.classwords[i];\n1320\t      }\n1321\t\n1322\t#ifdef SUPPORT_WIDE_CHARS\n1323\t    /* Every class contains at least one < 256 character. */\n1324\t    xclass_props |= XCLASS_HAS_8BIT_CHARS;\n1325\t#endif\n1326\t    continue;               /* End of POSIX handling */\n1327\t\n1328\t    /* Other than POSIX classes, the only items we should encounter are\n1329\t    \\d-type escapes and literal characters (possibly as ranges). */\n1330\t    case META_BIGVALUE:\n1331\t    meta = *(pptr++);\n1332\t    break;\n1333\t\n1334\t    case META_ESCAPE:\n1335\t    escape = META_DATA(meta);\n1336\t\n1337\t    switch(escape)\n1338\t      {\n1339\t      case ESC_d:\n1340\t      for (int i = 0; i < 32; i++) classbits[i] |= cbits[i+cbit_digit];\n1341\t      break;\n1342\t\n1343\t      case ESC_D:\n1344\t      should_flip_negation = TRUE;\n1345\t      for (int i = 0; i < 32; i++)\n1346\t        classbits[i] |= (uint8_t)(~cbits[i+cbit_digit]);\n1347\t      break;\n1348\t\n1349\t      case ESC_w:\n1350\t      for (int i = 0; i < 32; i++) classbits[i] |= cbits[i+cbit_word];\n1351\t      break;\n1352\t\n1353\t      case ESC_W:\n1354\t      should_flip_negation = TRUE;\n1355\t      for (int i = 0; i < 32; i++)\n1356\t        classbits[i] |= (uint8_t)(~cbits[i+cbit_word]);\n1357\t      break;\n1358\t\n1359\t      /* Perl 5.004 onwards omitted VT from \\s, but restored it at Perl\n1360\t      5.18. Before PCRE 8.34, we had to preserve the VT bit if it was\n1361\t      previously set by something earlier in the character class.\n1362\t      Luckily, the value of CHAR_VT is 0x0b in both ASCII and EBCDIC, so\n1363\t      we could just adjust the appropriate bit. From PCRE 8.34 we no\n1364\t      longer treat \\s and \\S specially. */\n1365\t\n1366\t      case ESC_s:\n1367\t      for (int i = 0; i < 32; i++) classbits[i] |= cbits[i+cbit_space];\n1368\t      break;\n1369\t\n1370\t      case ESC_S:\n1371\t      should_flip_negation = TRUE;\n1372\t      for (int i = 0; i < 32; i++)\n1373\t        classbits[i] |= (uint8_t)(~cbits[i+cbit_space]);\n1374\t      break;\n1375\t\n1376\t      /* When adding the horizontal or vertical space lists to a class, or\n1377\t      their complements, disable PCRE2_CASELESS, because it justs wastes\n1378\t      time, and in the \"not-x\" UTF cases can create unwanted duplicates in\n1379\t      the XCLASS list (provoked by characters that have more than one other\n1380\t      case and by both cases being in the same \"not-x\" sublist). */\n1381\t\n1382\t      case ESC_h:\n1383\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1384\t#ifdef SUPPORT_UNICODE\n1385\t      if (cranges != NULL) break;\n1386\t#endif\n1387\t      add_list_to_class(options & ~PCRE2_CASELESS, xoptions,\n1388\t        cb, PRIV(hspace_list));\n1389\t#else\n1390\t      PCRE2_ASSERT(cranges != NULL);\n1391\t#endif\n1392\t      break;\n1393\t\n1394\t      case ESC_H:\n1395\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1396\t#ifdef SUPPORT_UNICODE\n1397\t      if (cranges != NULL) break;\n1398\t#endif\n1399\t      add_not_list_to_class(options & ~PCRE2_CASELESS, xoptions,\n1400\t        cb, PRIV(hspace_list));\n1401\t#else\n1402\t      PCRE2_ASSERT(cranges != NULL);\n1403\t#endif\n1404\t      break;\n1405\t\n1406\t      case ESC_v:\n1407\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1408\t#ifdef SUPPORT_UNICODE\n1409\t      if (cranges != NULL) break;\n1410\t#endif\n1411\t      add_list_to_class(options & ~PCRE2_CASELESS, xoptions,\n1412\t        cb, PRIV(vspace_list));\n1413\t#else\n1414\t      PCRE2_ASSERT(cranges != NULL);\n1415\t#endif\n1416\t      break;\n1417\t\n1418\t      case ESC_V:\n1419\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1420\t#ifdef SUPPORT_UNICODE\n1421\t      if (cranges != NULL) break;\n1422\t#endif\n1423\t      add_not_list_to_class(options & ~PCRE2_CASELESS, xoptions,\n1424\t        cb, PRIV(vspace_list));\n1425\t#else\n1426\t      PCRE2_ASSERT(cranges != NULL);\n1427\t#endif\n1428\t      break;\n1429\t\n1430\t      /* If Unicode is not supported, \\P and \\p are not allowed and are\n1431\t      faulted at parse time, so will never appear here. */\n1432\t\n1433\t#ifdef SUPPORT_UNICODE\n1434\t      case ESC_p:\n1435\t      case ESC_P:\n1436\t        {\n1437\t        uint32_t ptype = *pptr >> 16;\n1438\t        uint32_t pdata = *(pptr++) & 0xffff;\n1439\t\n1440\t        /* The \"Any\" is processed by PRIV(update_classbits)(). */\n1441\t        if (ptype == PT_ANY)\n1442\t          {\n1443\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1444\t          if (!utf && escape == ESC_p) memset(classbits, 0xff, 32);\n1445\t#endif\n1446\t          continue;\n1447\t          }\n1448\t\n1449\t        PRIV(update_classbits)(ptype, pdata, (escape == ESC_P), classbits);\n1450\t\n1451\t        if ((xclass_props & XCLASS_HIGH_ANY) == 0)\n1452\t          {\n1453\t          if (lengthptr != NULL)\n1454\t            *lengthptr += 3;\n1455\t          else\n1456\t            {\n1457\t            *class_uchardata++ = (escape == ESC_p)? XCL_PROP : XCL_NOTPROP;\n1458\t            *class_uchardata++ = ptype;\n1459\t            *class_uchardata++ = pdata;\n1460\t            }\n1461\t          xclass_props |= XCLASS_REQUIRED | XCLASS_HAS_PROPS;\n1462\t          }\n1463\t        }\n1464\t      continue;\n1465\t#endif\n1466\t      }\n1467\t\n1468\t#ifdef SUPPORT_WIDE_CHARS\n1469\t    /* Every non-property class contains at least one < 256 character. */\n1470\t    xclass_props |= XCLASS_HAS_8BIT_CHARS;\n1471\t#endif\n1472\t    /* End handling \\d-type escapes */\n1473\t    continue;\n1474\t\n1475\t    CLASS_END_CASES(meta)\n1476\t    /* Literals. */\n1477\t    if (meta < META_END) break;\n1478\t    /* Non-literals: end of class contents. */\n1479\t    goto END_PROCESSING;\n1480\t    }\n1481\t\n1482\t  /* A literal character may be followed by a range meta. At parse time\n1483\t  there are checks for out-of-order characters, for ranges where the two\n1484\t  characters are equal, and for hyphens that cannot indicate a range. At\n1485\t  this point, therefore, no checking is needed. */\n1486\t\n1487\t  c = meta;\n1488\t\n1489\t  /* Remember if \\r or \\n were explicitly used */\n1490\t\n1491\t  if (c == CHAR_CR || c == CHAR_NL) cb->external_flags |= PCRE2_HASCRORLF;\n1492\t\n1493\t  /* Process a character range */\n1494\t\n1495\t  if (*pptr == META_RANGE_LITERAL || *pptr == META_RANGE_ESCAPED)\n1496\t    {\n1497\t    uint32_t d;\n1498\t\n1499\t#ifdef EBCDIC\n1500\t    BOOL range_is_literal = (*pptr == META_RANGE_LITERAL);\n1501\t#endif\n1502\t    ++pptr;\n1503\t    d = *(pptr++);\n1504\t    if (d == META_BIGVALUE) d = *(pptr++);\n1505\t\n1506\t    /* Remember an explicit \\r or \\n, and add the range to the class. */\n1507\t\n1508\t    if (d == CHAR_CR || d == CHAR_NL) cb->external_flags |= PCRE2_HASCRORLF;\n1509\t\n1510\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1511\t#ifdef SUPPORT_UNICODE\n1512\t    if (cranges != NULL) continue;\n1513\t    xclass_props |= XCLASS_HAS_8BIT_CHARS;\n1514\t#endif\n1515\t\n1516\t    /* In an EBCDIC environment, Perl treats alphabetic ranges specially\n1517\t    because there are holes in the encoding, and simply using the range\n1518\t    A-Z (for example) would include the characters in the holes. This\n1519\t    applies only to literal ranges; [\\xC1-\\xE9] is different to [A-Z]. */\n1520\t\n1521\t#ifdef EBCDIC\n1522\t    if (range_is_literal &&\n1523\t         (cb->ctypes[c] & ctype_letter) != 0 &&\n1524\t         (cb->ctypes[d] & ctype_letter) != 0 &&\n1525\t         (c <= CHAR_z) == (d <= CHAR_z))\n1526\t      {\n1527\t      uint32_t uc = (d <= CHAR_z)? 0 : 64;\n1528\t      uint32_t C = c - uc;\n1529\t      uint32_t D = d - uc;\n1530\t\n1531\t      if (C <= CHAR_i)\n1532\t        {\n1533\t        add_to_class(options, xoptions, cb, C + uc,\n1534\t          ((D < CHAR_i)? D : CHAR_i) + uc);\n1535\t        C = CHAR_j;\n1536\t        }\n1537\t\n1538\t      if (C <= D && C <= CHAR_r)\n1539\t        {\n1540\t        add_to_class(options, xoptions, cb, C + uc,\n1541\t          ((D < CHAR_r)? D : CHAR_r) + uc);\n1542\t        C = CHAR_s;\n1543\t        }\n1544\t\n1545\t      if (C <= D)\n1546\t        add_to_class(options, xoptions, cb, C + uc, D + uc);\n1547\t      }\n1548\t    else\n1549\t#endif\n1550\t    /* Not an EBCDIC special range */\n1551\t\n1552\t    add_to_class(options, xoptions, cb, c, d);\n1553\t#else\n1554\t    PCRE2_ASSERT(cranges != NULL);\n1555\t#endif\n1556\t    continue;\n1557\t    }  /* End of range handling */\n1558\t\n1559\t  /* Character ranges are ignored when class_ranges is present. */\n1560\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1561\t#ifdef SUPPORT_UNICODE\n1562\t  if (cranges != NULL) continue;\n1563\t  xclass_props |= XCLASS_HAS_8BIT_CHARS;\n1564\t#endif\n1565\t  /* Handle a single character. */\n1566\t\n1567\t  add_to_class(options, xoptions, cb, meta, meta);\n1568\t#else\n1569\t  PCRE2_ASSERT(cranges != NULL);\n1570\t#endif\n1571\t  }   /* End of main class-processing loop */\n1572\t\n1573\tEND_PROCESSING:\n1574\t\n1575\t#ifdef SUPPORT_WIDE_CHARS\n1576\tPCRE2_ASSERT((xclass_props & XCLASS_HAS_PROPS) == 0 ||\n1577\t             (xclass_props & XCLASS_HIGH_ANY) == 0);\n1578\t\n1579\tif (cranges != NULL)\n1580\t  {\n1581\t  uint32_t *range = (uint32_t*)(cranges + 1);\n1582\t  uint32_t *end = range + cranges->range_list_size;\n1583\t\n1584\t  while (range < end && range[0] < 256)\n1585\t    {\n1586\t    PCRE2_ASSERT((xclass_props & XCLASS_HAS_8BIT_CHARS) != 0);\n1587\t    /* Add range to bitset. If we are in UTF or UCP mode, then clear the\n1588\t    caseless bit, because the cranges handle caselessness (only) in this\n1589\t    condition; see the condition for PARSE_CLASS_CASELESS_UTF in\n1590\t    compile_optimize_class(). */\n1591\t    add_to_class(((options & (PCRE2_UTF|PCRE2_UCP)) != 0)?\n1592\t        (options & ~PCRE2_CASELESS) : options, xoptions, cb, range[0], range[1]);\n1593\t\n1594\t    if (range[1] > 255) break;\n1595\t    range += 2;\n1596\t    }\n1597\t\n1598\t  if (cranges->char_lists_size > 0)\n1599\t    {\n1600\t    /* The cranges structure is still used and freed later. */\n1601\t    PCRE2_ASSERT((xclass_props & XCLASS_HIGH_ANY) == 0);\n1602\t    xclass_props |= XCLASS_REQUIRED | XCLASS_HAS_CHAR_LISTS;\n1603\t    }\n1604\t  else\n1605\t    {\n1606\t    if ((xclass_props & XCLASS_HIGH_ANY) != 0)\n1607\t      {\n1608\t      PCRE2_ASSERT(range + 2 == end && range[0] <= 256 &&\n1609\t        range[1] >= GET_MAX_CHAR_VALUE(utf));\n1610\t      should_flip_negation = TRUE;\n1611\t      range = end;\n1612\t      }\n1613\t\n1614\t    while (range < end)\n1615\t      {\n1616\t      uint32_t range_start = range[0];\n1617\t      uint32_t range_end = range[1];\n1618\t\n1619\t      range += 2;\n1620\t      xclass_props |= XCLASS_REQUIRED;\n1621\t\n1622\t      if (range_start < 256) range_start = 256;\n1623\t\n1624\t      if (lengthptr != NULL)\n1625\t        {\n1626\t#ifdef SUPPORT_UNICODE\n1627\t        if (utf)\n1628\t          {\n1629\t          *lengthptr += 1;\n1630\t\n1631\t          if (range_start < range_end)\n1632\t            *lengthptr += PRIV(ord2utf)(range_start, class_uchardata);\n1633\t\n1634\t          *lengthptr += PRIV(ord2utf)(range_end, class_uchardata);\n1635\t          continue;\n1636\t          }\n1637\t#endif  /* SUPPORT_UNICODE */\n1638\t\n1639\t        *lengthptr += range_start < range_end ? 3 : 2;\n1640\t        continue;\n1641\t        }\n1642\t\n1643\t#ifdef SUPPORT_UNICODE\n1644\t      if (utf)\n1645\t        {\n1646\t        if (range_start < range_end)\n1647\t          {\n1648\t          *class_uchardata++ = XCL_RANGE;\n1649\t          class_uchardata += PRIV(ord2utf)(range_start, class_uchardata);\n1650\t          }\n1651\t        else\n1652\t          *class_uchardata++ = XCL_SINGLE;\n1653\t\n1654\t        class_uchardata += PRIV(ord2utf)(range_end, class_uchardata);\n1655\t        continue;\n1656\t        }\n1657\t#endif  /* SUPPORT_UNICODE */\n1658\t\n1659\t      /* Without UTF support, character values are constrained\n1660\t      by the bit length, and can only be > 256 for 16-bit and\n1661\t      32-bit libraries. */\n1662\t#if PCRE2_CODE_UNIT_WIDTH != 8\n1663\t      if (range_start < range_end)\n1664\t        {\n1665\t        *class_uchardata++ = XCL_RANGE;\n1666\t        *class_uchardata++ = range_start;\n1667\t        }\n1668\t      else\n1669\t        *class_uchardata++ = XCL_SINGLE;\n1670\t\n1671\t      *class_uchardata++ = range_end;\n1672\t#endif  /* PCRE2_CODE_UNIT_WIDTH == 8 */\n1673\t      }\n1674\t\n1675\t    if (lengthptr == NULL)\n1676\t      cb->cx->memctl.free(cranges, cb->cx->memctl.memory_data);\n1677\t    }\n1678\t  }\n1679\t#endif /* SUPPORT_WIDE_CHARS */\n1680\t\n1681\t/* If there are characters with values > 255, or Unicode property settings\n1682\t(\\p or \\P), we have to compile an extended class, with its own opcode,\n1683\tunless there were no property settings and there was a negated special such\n1684\tas \\S in the class, and PCRE2_UCP is not set, because in that case all\n1685\tcharacters > 255 are in or not in the class, so any that were explicitly\n1686\tgiven as well can be ignored.\n1687\t\n1688\tIn the UCP case, if certain negated POSIX classes (ex: [:^ascii:]) were\n1689\twere present in a class, we either have to match or not match all wide\n1690\tcharacters (depending on whether the whole class is or is not negated).\n1691\tThis requirement is indicated by match_all_or_no_wide_chars being true.\n1692\tWe do this by including an explicit range, which works in both cases.\n1693\tThis applies only in UTF and 16-bit and 32-bit non-UTF modes, since there\n1694\tcannot be any wide characters in 8-bit non-UTF mode.\n1695\t\n1696\tWhen there *are* properties in a positive UTF-8 or any 16-bit or 32_bit\n1697\tclass where \\S etc is present without PCRE2_UCP, causing an extended class\n1698\tto be compiled, we make sure that all characters > 255 are included by\n1699\tforcing match_all_or_no_wide_chars to be true.\n1700\t\n1701\tIf, when generating an xclass, there are no characters < 256, we can omit\n1702\tthe bitmap in the actual compiled code. */\n1703\t\n1704\t#ifdef SUPPORT_WIDE_CHARS  /* Defined for 16/32 bits, or 8-bit with Unicode */\n1705\tif ((xclass_props & XCLASS_REQUIRED) != 0)\n1706\t  {\n1707\t  PCRE2_UCHAR *previous = code;\n1708\t\n1709\t  if ((xclass_props & XCLASS_HAS_CHAR_LISTS) == 0)\n1710\t    *class_uchardata++ = XCL_END;    /* Marks the end of extra data */\n1711\t  *code++ = OP_XCLASS;\n1712\t  code += LINK_SIZE;\n1713\t  *code = negate_class? XCL_NOT:0;\n1714\t  if ((xclass_props & XCLASS_HAS_PROPS) != 0) *code |= XCL_HASPROP;\n1715\t\n1716\t  /* If the map is required, move up the extra data to make room for it;\n1717\t  otherwise just move the code pointer to the end of the extra data. */\n1718\t\n1719\t  if ((xclass_props & XCLASS_HAS_8BIT_CHARS) != 0 || has_bitmap != NULL)\n1720\t    {\n1721\t    if (negate_class)\n1722\t      {\n1723\t      uint32_t *classwords = cb->classbits.classwords;\n1724\t      for (int i = 0; i < 8; i++) classwords[i] = ~classwords[i];\n1725\t      }\n1726\t\n1727\t    if (has_bitmap == NULL)\n1728\t      {\n1729\t      *code++ |= XCL_MAP;\n1730\t      (void)memmove(code + (32 / sizeof(PCRE2_UCHAR)), code,\n1731\t        CU2BYTES(class_uchardata - code));\n1732\t      memcpy(code, classbits, 32);\n1733\t      code = class_uchardata + (32 / sizeof(PCRE2_UCHAR));\n1734\t      }\n1735\t    else\n1736\t      {\n1737\t      code = class_uchardata;\n1738\t      if ((xclass_props & XCLASS_HAS_8BIT_CHARS) != 0)\n1739\t        *has_bitmap = TRUE;\n1740\t      }\n1741\t    }\n1742\t  else code = class_uchardata;\n1743\t\n1744\t  if ((xclass_props & XCLASS_HAS_CHAR_LISTS) != 0)\n1745\t    {\n1746\t    /* Char lists size is an even number, because all items are 16 or 32\n1747\t    bit values. The character list data is always aligned to 32 bits. */\n1748\t    size_t char_lists_size = cranges->char_lists_size;\n1749\t    PCRE2_ASSERT((char_lists_size & 0x1) == 0 &&\n1750\t                 (cb->char_lists_size & 0x3) == 0);\n1751\t\n1752\t    if (lengthptr != NULL)\n1753\t      {\n1754\t      char_lists_size = CLIST_ALIGN_TO(char_lists_size, sizeof(uint32_t));\n1755\t\n1756\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1757\t      *lengthptr += 2 + LINK_SIZE;\n1758\t#else\n1759\t      *lengthptr += 1 + LINK_SIZE;\n1760\t#endif\n1761\t\n1762\t      cb->char_lists_size += char_lists_size;\n1763\t\n1764\t      char_lists_size /= sizeof(PCRE2_UCHAR);\n1765\t\n1766\t      /* Storage space for character lists is included\n1767\t      in the maximum pattern size. */\n1768\t      if (*lengthptr > MAX_PATTERN_SIZE ||\n1769\t          MAX_PATTERN_SIZE - *lengthptr < char_lists_size)\n1770\t        {\n1771\t        *errorcodeptr = ERR20;   /* Pattern is too large */\n1772\t        return NULL;\n1773\t        }\n1774\t      }\n1775\t    else\n1776\t      {\n1777\t      uint8_t *data;\n1778\t\n1779\t      PCRE2_ASSERT(cranges->char_lists_types <= XCL_TYPE_MASK);\n1780\t#if PCRE2_CODE_UNIT_WIDTH == 8\n1781\t      /* Encode as high / low bytes. */\n1782\t      code[0] = (uint8_t)(XCL_LIST |\n1783\t        (cranges->char_lists_types >> 8));\n1784\t      code[1] = (uint8_t)cranges->char_lists_types;\n1785\t      code += 2;\n1786\t#else\n1787\t      *code++ = (PCRE2_UCHAR)(XCL_LIST | cranges->char_lists_types);\n1788\t#endif\n1789\t\n1790\t      /* Character lists are stored in backwards direction from\n1791\t      byte code start. The non-dfa/dfa matchers can access these\n1792\t      lists using the byte code start stored in match blocks.\n1793\t      Each list is aligned to 32 bit with an optional unused\n1794\t      16 bit value at the beginning of the character list. */\n1795\t\n1796\t      cb->char_lists_size += char_lists_size;\n1797\t      data = (uint8_t*)cb->start_code - cb->char_lists_size;\n1798\t\n1799\t      memcpy(data, (uint8_t*)(cranges + 1) + cranges->char_lists_start,\n1800\t        char_lists_size);\n1801\t\n1802\t      /* Since character lists total size is less than MAX_PATTERN_SIZE,\n1803\t      their starting offset fits into a value which size is LINK_SIZE. */\n1804\t\n1805\t      char_lists_size = cb->char_lists_size;\n1806\t      PUT(code, 0, (uint32_t)(char_lists_size >> 1));\n1807\t      code += LINK_SIZE;\n1808\t\n1809\t      /* If we added padding to align the list, initialize the bytes to\n1810\t      defined values, so the library is valgrind-clean. It could also\n1811\t      be a security concern for clients calling into PCRE2 via bindings\n1812\t      from a memory-safe language, if pcre2_serialize_encode() exposes\n1813\t      uninitialized memory that may contain sensitive information. */\n1814\t\n1815\t      if ((char_lists_size & 0x2) != 0)\n1816\t        ((uint16_t*)data)[-1] = 0xdead;\n1817\t\n1818\t      cb->char_lists_size =\n1819\t        CLIST_ALIGN_TO(char_lists_size, sizeof(uint32_t));\n1820\t\n1821\t      cb->cx->memctl.free(cranges, cb->cx->memctl.memory_data);\n1822\t      }\n1823\t    }\n1824\t\n1825\t  /* Now fill in the complete length of the item */\n1826\t\n1827\t  PUT(previous, 1, (int)(code - previous));\n1828\t  goto DONE;   /* End of class handling */\n1829\t  }\n1830\t#endif  /* SUPPORT_WIDE_CHARS */\n1831\t\n1832\t/* If there are no characters > 255, or they are all to be included or\n1833\texcluded, set the opcode to OP_CLASS or OP_NCLASS, depending on whether the\n1834\twhole class was negated and whether there were negative specials such as \\S\n1835\t(non-UCP) in the class. Then copy the 32-byte map into the code vector,\n1836\tnegating it if necessary. */\n1837\t\n1838\tif (negate_class)\n1839\t  {\n1840\t  uint32_t *classwords = cb->classbits.classwords;\n1841\t\n1842\t  for (int i = 0; i < 8; i++) classwords[i] = ~classwords[i];\n1843\t  }\n1844\t\n1845\tif ((SELECT_VALUE8(!utf, 0) || negate_class != should_flip_negation) &&\n1846\t    cb->classbits.classwords[0] == ~(uint32_t)0)\n1847\t  {\n1848\t  const uint32_t *classwords = cb->classbits.classwords;\n1849\t  int i;\n1850\t\n1851\t  for (i = 0; i < 8; i++)\n1852\t    if (classwords[i] != ~(uint32_t)0) break;\n1853\t\n1854\t  if (i == 8)\n1855\t    {\n1856\t    *code++ = OP_ALLANY;\n1857\t    goto DONE;   /* End of class handling */\n1858\t    }\n1859\t  }\n1860\t\n1861\t*code++ = (negate_class == should_flip_negation) ? OP_CLASS : OP_NCLASS;\n1862\tmemcpy(code, classbits, 32);\n1863\tcode += 32 / sizeof(PCRE2_UCHAR);\n1864\t\n1865\tDONE:\n1866\t*pcode = code;\n1867\treturn pptr - 1;\n1868\t}\n1869\t\n1870\t\n1871\t\n1872\t/* ===================================================================*/\n1873\t/* Here follows a block of ECLASS-compiling functions. You may well want to\n1874\tread them from top to bottom; they are ordered from leafmost (at the top) to\n1875\toutermost parser (at the bottom of the file). */\n1876\t\n1877\t/* This function folds one operand using the negation operator.\n1878\tThe new, combined chunk of stack code is written out to *pop_info. */\n1879\t\n1880\tstatic void\n1881\tfold_negation(eclass_op_info *pop_info, PCRE2_SIZE *lengthptr,\n1882\t  BOOL preserve_classbits)\n1883\t{\n1884\t/* If the chunk of stack code is already composed of multiple ops, we won't\n1885\tdescend in and try and propagate the negation down the tree. (That would lead\n1886\tto O(n^2) compile-time, which could be exploitable with a malicious regex -\n1887\talthough maybe that's not really too much of a worry in a library that offers\n1888\tan exponential-time matching function!) */\n1889\t\n1890\tif (pop_info->op_single_type == 0)\n1891\t  {\n1892\t  if (lengthptr != NULL)\n1893\t    *lengthptr += 1;\n1894\t  else\n1895\t    pop_info->code_start[pop_info->length] = ECL_NOT;\n1896\t  pop_info->length += 1;\n1897\t  }\n1898\t\n1899\t/* Otherwise, it's a nice single-op item, so we can easily fold in the negation\n1900\twithout needing to produce an ECL_NOT. */\n1901\t\n1902\telse if (pop_info->op_single_type == ECL_ANY ||\n1903\t         pop_info->op_single_type == ECL_NONE)\n1904\t  {\n1905\t  pop_info->op_single_type = (pop_info->op_single_type == ECL_NONE)?\n1906\t      ECL_ANY : ECL_NONE;\n1907\t  if (lengthptr == NULL)\n1908\t    *(pop_info->code_start) = pop_info->op_single_type;\n1909\t  }\n1910\telse\n1911\t  {\n1912\t  PCRE2_ASSERT(pop_info->op_single_type == ECL_XCLASS &&\n1913\t               pop_info->length >= 1 + LINK_SIZE + 1);\n1914\t  if (lengthptr == NULL)\n1915\t    pop_info->code_start[1 + LINK_SIZE] ^= XCL_NOT;\n1916\t  }\n1917\t\n1918\tif (!preserve_classbits)\n1919\t  {\n1920\t  for (int i = 0; i < 8; i++)\n1921\t    pop_info->bits.classwords[i] = ~pop_info->bits.classwords[i];\n1922\t  }\n1923\t}\n1924\t\n1925\t\n1926\t\n1927\t/* This function folds together two operands using a binary operator.\n1928\tThe new, combined chunk of stack code is written out to *lhs_op_info. */\n1929\t\n1930\tstatic void\n1931\tfold_binary(int op, eclass_op_info *lhs_op_info, eclass_op_info *rhs_op_info,\n1932\t  PCRE2_SIZE *lengthptr)\n1933\t{\n1934\tswitch (op)\n1935\t  {\n1936\t  /* ECL_AND truth table:\n1937\t\n1938\t     LHS  RHS  RESULT\n1939\t     ----------------\n1940\t     ANY  *    RHS\n1941\t     *    ANY  LHS\n1942\t     NONE *    NONE\n1943\t     *    NONE NONE\n1944\t     X    Y    X & Y\n1945\t  */\n1946\t\n1947\t  case ECL_AND:\n1948\t  if (rhs_op_info->op_single_type == ECL_ANY)\n1949\t    {\n1950\t    /* no-op: drop the RHS */\n1951\t    }\n1952\t  else if (lhs_op_info->op_single_type == ECL_ANY)\n1953\t    {\n1954\t    /* no-op: drop the LHS, and memmove the RHS into its place */\n1955\t    if (lengthptr == NULL)\n1956\t      memmove(lhs_op_info->code_start, rhs_op_info->code_start,\n1957\t              CU2BYTES(rhs_op_info->length));\n1958\t    lhs_op_info->length = rhs_op_info->length;\n1959\t    lhs_op_info->op_single_type = rhs_op_info->op_single_type;\n1960\t    }\n1961\t  else if (rhs_op_info->op_single_type == ECL_NONE)\n1962\t    {\n1963\t    /* the result is ECL_NONE: write into the LHS */\n1964\t    if (lengthptr == NULL)\n1965\t      lhs_op_info->code_start[0] = ECL_NONE;\n1966\t    lhs_op_info->length = 1;\n1967\t    lhs_op_info->op_single_type = ECL_NONE;\n1968\t    }\n1969\t  else if (lhs_op_info->op_single_type == ECL_NONE)\n1970\t    {\n1971\t    /* the result is ECL_NONE: drop the RHS */\n1972\t    }\n1973\t  else\n1974\t    {\n1975\t    /* Both of LHS & RHS are either ECL_XCLASS, or compound operations. */\n1976\t    if (lengthptr != NULL)\n1977\t      *lengthptr += 1;\n1978\t    else\n1979\t      {\n1980\t      PCRE2_ASSERT(rhs_op_info->code_start ==\n1981\t          lhs_op_info->code_start + lhs_op_info->length);\n1982\t      rhs_op_info->code_start[rhs_op_info->length] = ECL_AND;\n1983\t      }\n1984\t    lhs_op_info->length += rhs_op_info->length + 1;\n1985\t    lhs_op_info->op_single_type = 0;\n1986\t    }\n1987\t\n1988\t  for (int i = 0; i < 8; i++)\n1989\t    lhs_op_info->bits.classwords[i] &= rhs_op_info->bits.classwords[i];\n1990\t  break;\n1991\t\n1992\t  /* ECL_OR truth table:\n1993\t\n1994\t     LHS  RHS  RESULT\n1995\t     ----------------\n1996\t     ANY  *    ANY\n1997\t     *    ANY  ANY\n1998\t     NONE *    RHS\n1999\t     *    NONE LHS\n2000\t     X    Y    X | Y\n2001\t  */\n2002\t\n2003\t  case ECL_OR:\n2004\t  if (rhs_op_info->op_single_type == ECL_NONE)\n2005\t    {\n2006\t    /* no-op: drop the RHS */\n2007\t    }\n2008\t  else if (lhs_op_info->op_single_type == ECL_NONE)\n2009\t    {\n2010\t    /* no-op: drop the LHS, and memmove the RHS into its place */\n2011\t    if (lengthptr == NULL)\n2012\t      memmove(lhs_op_info->code_start, rhs_op_info->code_start,\n2013\t              CU2BYTES(rhs_op_info->length));\n2014\t    lhs_op_info->length = rhs_op_info->length;\n2015\t    lhs_op_info->op_single_type = rhs_op_info->op_single_type;\n2016\t    }\n2017\t  else if (rhs_op_info->op_single_type == ECL_ANY)\n2018\t    {\n2019\t    /* the result is ECL_ANY: write into the LHS */\n2020\t    if (lengthptr == NULL)\n2021\t      lhs_op_info->code_start[0] = ECL_ANY;\n2022\t    lhs_op_info->length = 1;\n2023\t    lhs_op_info->op_single_type = ECL_ANY;\n2024\t    }\n2025\t  else if (lhs_op_info->op_single_type == ECL_ANY)\n2026\t    {\n2027\t    /* the result is ECL_ANY: drop the RHS */\n2028\t    }\n2029\t  else\n2030\t    {\n2031\t    /* Both of LHS & RHS are either ECL_XCLASS, or compound operations. */\n2032\t    if (lengthptr != NULL)\n2033\t      *lengthptr += 1;\n2034\t    else\n2035\t      {\n2036\t      PCRE2_ASSERT(rhs_op_info->code_start ==\n2037\t          lhs_op_info->code_start + lhs_op_info->length);\n2038\t      rhs_op_info->code_start[rhs_op_info->length] = ECL_OR;\n2039\t      }\n2040\t    lhs_op_info->length += rhs_op_info->length + 1;\n2041\t    lhs_op_info->op_single_type = 0;\n2042\t    }\n2043\t\n2044\t  for (int i = 0; i < 8; i++)\n2045\t    lhs_op_info->bits.classwords[i] |= rhs_op_info->bits.classwords[i];\n2046\t  break;\n2047\t\n2048\t  /* ECL_XOR truth table:\n2049\t\n2050\t     LHS  RHS  RESULT\n2051\t     ----------------\n2052\t     ANY  *    !RHS\n2053\t     *    ANY  !LHS\n2054\t     NONE *    RHS\n2055\t     *    NONE LHS\n2056\t     X    Y    X ^ Y\n2057\t  */\n2058\t\n2059\t  case ECL_XOR:\n2060\t  if (rhs_op_info->op_single_type == ECL_NONE)\n2061\t    {\n2062\t    /* no-op: drop the RHS */\n2063\t    }\n2064\t  else if (lhs_op_info->op_single_type == ECL_NONE)\n2065\t    {\n2066\t    /* no-op: drop the LHS, and memmove the RHS into its place */\n2067\t    if (lengthptr == NULL)\n2068\t      memmove(lhs_op_info->code_start, rhs_op_info->code_start,\n2069\t              CU2BYTES(rhs_op_info->length));\n2070\t    lhs_op_info->length = rhs_op_info->length;\n2071\t    lhs_op_info->op_single_type = rhs_op_info->op_single_type;\n2072\t    }\n2073\t  else if (rhs_op_info->op_single_type == ECL_ANY)\n2074\t    {\n2075\t    /* the result is !LHS: fold in the negation, and drop the RHS */\n2076\t    /* Preserve the classbits, because we promise to deal with them later. */\n2077\t    fold_negation(lhs_op_info, lengthptr, TRUE);\n2078\t    }\n2079\t  else if (lhs_op_info->op_single_type == ECL_ANY)\n2080\t    {\n2081\t    /* the result is !RHS: drop the LHS, memmove the RHS into its place, and\n2082\t    fold in the negation */\n2083\t    if (lengthptr == NULL)\n2084\t      memmove(lhs_op_info->code_start, rhs_op_info->code_start,\n2085\t              CU2BYTES(rhs_op_info->length));\n2086\t    lhs_op_info->length = rhs_op_info->length;\n2087\t    lhs_op_info->op_single_type = rhs_op_info->op_single_type;\n2088\t\n2089\t    /* Preserve the classbits, because we promise to deal with them later. */\n2090\t    fold_negation(lhs_op_info, lengthptr, TRUE);\n2091\t    }\n2092\t  else\n2093\t    {\n2094\t    /* Both of LHS & RHS are either ECL_XCLASS, or compound operations. */\n2095\t    if (lengthptr != NULL)\n2096\t      *lengthptr += 1;\n2097\t    else\n2098\t      {\n2099\t      PCRE2_ASSERT(rhs_op_info->code_start ==\n2100\t          lhs_op_info->code_start + lhs_op_info->length);\n2101\t      rhs_op_info->code_start[rhs_op_info->length] = ECL_XOR;\n2102\t      }\n2103\t    lhs_op_info->length += rhs_op_info->length + 1;\n2104\t    lhs_op_info->op_single_type = 0;\n2105\t    }\n2106\t\n2107\t  for (int i = 0; i < 8; i++)\n2108\t    lhs_op_info->bits.classwords[i] ^= rhs_op_info->bits.classwords[i];\n2109\t  break;\n2110\t\n2111\t  /* LCOV_EXCL_START */\n2112\t  default:\n2113\t  PCRE2_DEBUG_UNREACHABLE();\n2114\t  break;\n2115\t  /* LCOV_EXCL_STOP */\n2116\t  }\n2117\t}\n2118\t\n2119\t\n2120\t\n2121\tstatic BOOL\n2122\tcompile_eclass_nested(eclass_context *context, BOOL negated,\n2123\t  uint32_t **pptr, PCRE2_UCHAR **pcode,\n2124\t  eclass_op_info *pop_info, PCRE2_SIZE *lengthptr);\n2125\t\n2126\t/* This function consumes a group of implicitly-unioned class elements.\n2127\tThese can be characters, ranges, properties, or nested classes, as long\n2128\tas they are all joined by being placed adjacently. */\n2129\t\n2130\tstatic BOOL\n2131\tcompile_class_operand(eclass_context *context, BOOL negated,\n2132\t  uint32_t **pptr, PCRE2_UCHAR **pcode, eclass_op_info *pop_info,\n2133\t  PCRE2_SIZE *lengthptr)\n2134\t{\n2135\tuint32_t *ptr = *pptr;\n2136\tuint32_t *prev_ptr;\n2137\tPCRE2_UCHAR *code = *pcode;\n2138\tPCRE2_UCHAR *code_start = code;\n2139\tPCRE2_SIZE prev_length = (lengthptr != NULL)? *lengthptr : 0;\n2140\tPCRE2_SIZE extra_length;\n2141\tuint32_t meta = META_CODE(*ptr);\n2142\t\n2143\tswitch (meta)\n2144\t  {\n2145\t  case META_CLASS_EMPTY_NOT:\n2146\t  case META_CLASS_EMPTY:\n2147\t  ++ptr;\n2148\t  pop_info->length = 1;\n2149\t  if ((meta == META_CLASS_EMPTY) == negated)\n2150\t    {\n2151\t    *code++ = pop_info->op_single_type = ECL_ANY;\n2152\t    memset(pop_info->bits.classbits, 0xff, 32);\n2153\t    }\n2154\t  else\n2155\t    {\n2156\t    *code++ = pop_info->op_single_type = ECL_NONE;\n2157\t    memset(pop_info->bits.classbits, 0, 32);\n2158\t    }\n2159\t  break;\n2160\t\n2161\t  case META_CLASS:\n2162\t  case META_CLASS_NOT:\n2163\t  if ((*ptr & CLASS_IS_ECLASS) != 0)\n2164\t    {\n2165\t    if (!compile_eclass_nested(context, negated, &ptr, &code,\n2166\t                               pop_info, lengthptr))\n2167\t      return FALSE;\n2168\t\n2169\t    PCRE2_ASSERT(*ptr == META_CLASS_END);\n2170\t    ptr++;\n2171\t    goto DONE;\n2172\t    }\n2173\t\n2174\t  ptr++;\n2175\t  PCRE2_FALLTHROUGH /* Fall through */\n2176\t\n2177\t  default:\n2178\t  /* Scan forward characters, ranges, and properties.\n2179\t  For example: inside [a-z_ -- m] we don't have brackets around \"a-z_\" but\n2180\t  we still need to collect that fragment up into a \"leaf\" OP_CLASS. */\n2181\t\n2182\t  prev_ptr = ptr;\n2183\t  ptr = PRIV(compile_class_not_nested)(\n2184\t    context->options, context->xoptions, ptr, &code,\n2185\t    (meta != META_CLASS_NOT) == negated, &context->needs_bitmap,\n2186\t    context->errorcodeptr, context->cb, lengthptr);\n2187\t  if (ptr == NULL) return FALSE;\n2188\t\n2189\t  /* We must have a 100% guarantee that ptr increases when\n2190\t  compile_class_operand() returns, even on Release builds, so that we can\n2191\t  statically prove our loops terminate. */\n2192\t  /* LCOV_EXCL_START */\n2193\t  if (ptr <= prev_ptr)\n2194\t    {\n2195\t    PCRE2_DEBUG_UNREACHABLE();\n2196\t    return FALSE;\n2197\t    }\n2198\t  /* LCOV_EXCL_STOP */\n2199\t\n2200\t  /* If we fell through above, consume the closing ']'. */\n2201\t  if (meta == META_CLASS || meta == META_CLASS_NOT)\n2202\t    {\n2203\t    PCRE2_ASSERT(*ptr == META_CLASS_END);\n2204\t    ptr++;\n2205\t    }\n2206\t\n2207\t  /* Regardless of whether (lengthptr == NULL), some data will still be written\n2208\t  out to *pcode, which we need: we have to peek at it, to transform the opcode\n2209\t  into the ECLASS version (since we need to hoist up the bitmaps). */\n2210\t  PCRE2_ASSERT(code > code_start);\n2211\t  extra_length = (lengthptr != NULL)? *lengthptr - prev_length : 0;\n2212\t\n2213\t  /* Easiest case: convert OP_ALLANY to ECL_ANY */\n2214\t\n2215\t  if (*code_start == OP_ALLANY)\n2216\t    {\n2217\t    PCRE2_ASSERT(code - code_start == 1 && extra_length == 0);\n2218\t    pop_info->length = 1;\n2219\t    *code_start = pop_info->op_single_type = ECL_ANY;\n2220\t    memset(pop_info->bits.classbits, 0xff, 32);\n2221\t    }\n2222\t\n2223\t  /* For OP_CLASS and OP_NCLASS, we hoist out the bitmap and convert to\n2224\t  ECL_NONE / ECL_ANY respectively. */\n2225\t\n2226\t  else if (*code_start == OP_CLASS || *code_start == OP_NCLASS)\n2227\t    {\n2228\t    PCRE2_ASSERT(code - code_start == 1 + 32 / sizeof(PCRE2_UCHAR) &&\n2229\t                 extra_length == 0);\n2230\t    pop_info->length = 1;\n2231\t    *code_start = pop_info->op_single_type =\n2232\t        (*code_start == OP_CLASS)? ECL_NONE : ECL_ANY;\n2233\t    memcpy(pop_info->bits.classbits, code_start + 1, 32);\n2234\t    /* Rewind the code pointer, but make sure we adjust *lengthptr, because we\n2235\t    do need to reserve that space (even though we only use it temporarily). */\n2236\t    if (lengthptr != NULL)\n2237\t      *lengthptr += code - (code_start + 1);\n2238\t    code = code_start + 1;\n2239\t\n2240\t    if (!context->needs_bitmap && *code_start == ECL_NONE)\n2241\t      {\n2242\t      uint32_t *classwords = pop_info->bits.classwords;\n2243\t\n2244\t      for (int i = 0; i < 8; i++)\n2245\t        if (classwords[i] != 0)\n2246\t          {\n2247\t          context->needs_bitmap = TRUE;\n2248\t          break;\n2249\t          }\n2250\t      }\n2251\t    else\n2252\t      context->needs_bitmap = TRUE;\n2253\t    }\n2254\t\n2255\t  /* Finally, for OP_XCLASS we hoist out the bitmap (if any), and convert to\n2256\t  ECL_XCLASS. */\n2257\t\n2258\t  else\n2259\t    {\n2260\t    PCRE2_ASSERT(*code_start == OP_XCLASS);\n2261\t    *code_start = pop_info->op_single_type = ECL_XCLASS;\n2262\t\n2263\t    PCRE2_ASSERT(code - code_start >= 1 + LINK_SIZE + 1);\n2264\t\n2265\t    memcpy(pop_info->bits.classbits, context->cb->classbits.classbits, 32);\n2266\t    pop_info->length = (code - code_start) + extra_length;\n2267\t    }\n2268\t\n2269\t  break;\n2270\t  }  /* End of switch(meta) */\n2271\t\n2272\tpop_info->code_start = (lengthptr == NULL)? code_start : NULL;\n2273\t\n2274\tif (lengthptr != NULL)\n2275\t  {\n2276\t  *lengthptr += code - code_start;\n2277\t  code = code_start;\n2278\t  }\n2279\t\n2280\tDONE:\n2281\tPCRE2_ASSERT(lengthptr == NULL || (code == code_start));\n2282\t\n2283\t*pptr = ptr;\n2284\t*pcode = code;\n2285\treturn TRUE;\n2286\t}\n2287\t\n2288\t\n2289\t\n2290\t/* This function consumes a group of implicitly-unioned class elements.\n2291\tThese can be characters, ranges, properties, or nested classes, as long\n2292\tas they are all joined by being placed adjacently. */\n2293\t\n2294\tstatic BOOL\n2295\tcompile_class_juxtaposition(eclass_context *context, BOOL negated,\n2296\t  uint32_t **pptr, PCRE2_UCHAR **pcode, eclass_op_info *pop_info,\n2297\t  PCRE2_SIZE *lengthptr)\n2298\t{\n2299\tuint32_t *ptr = *pptr;\n2300\tPCRE2_UCHAR *code = *pcode;\n2301\t#ifdef PCRE2_DEBUG\n2302\tPCRE2_UCHAR *start_code = *pcode;\n2303\t#endif\n2304\t\n2305\t/* See compile_class_binary_loose() for comments on compile-time folding of\n2306\tthe \"negated\" flag. */\n2307\t\n2308\t/* Because it's a non-empty class, there must be an operand at the start. */\n2309\tif (!compile_class_operand(context, negated, &ptr, &code, pop_info, lengthptr))\n2310\t  return FALSE;\n2311\t\n2312\twhile (*ptr != META_CLASS_END &&\n2313\t       !(*ptr >= META_ECLASS_AND && *ptr <= META_ECLASS_NOT))\n2314\t  {\n2315\t  uint32_t op;\n2316\t  BOOL rhs_negated;\n2317\t  eclass_op_info rhs_op_info;\n2318\t\n2319\t  if (negated)\n2320\t    {\n2321\t    /* !(A juxtapose B)  ->  !A && !B */\n2322\t    op = ECL_AND;\n2323\t    rhs_negated = TRUE;\n2324\t    }\n2325\t  else\n2326\t    {\n2327\t    /* A juxtapose B  ->  A || B */\n2328\t    op = ECL_OR;\n2329\t    rhs_negated = FALSE;\n2330\t    }\n2331\t\n2332\t  /* An operand must follow the operator. */\n2333\t  if (!compile_class_operand(context, rhs_negated, &ptr, &code,\n2334\t                             &rhs_op_info, lengthptr))\n2335\t    return FALSE;\n2336\t\n2337\t  /* Convert infix to postfix (RPN). */\n2338\t  fold_binary(op, pop_info, &rhs_op_info, lengthptr);\n2339\t  if (lengthptr == NULL)\n2340\t    code = pop_info->code_start + pop_info->length;\n2341\t  }\n2342\t\n2343\tPCRE2_ASSERT(lengthptr == NULL || code == start_code);\n2344\t\n2345\t*pptr = ptr;\n2346\t*pcode = code;\n2347\treturn TRUE;\n2348\t}\n2349\t\n2350\t\n2351\t\n2352\t/* This function consumes unary prefix operators. */\n2353\t\n2354\tstatic BOOL\n2355\tcompile_class_unary(eclass_context *context, BOOL negated,\n2356\t  uint32_t **pptr, PCRE2_UCHAR **pcode, eclass_op_info *pop_info,\n2357\t  PCRE2_SIZE *lengthptr)\n2358\t{\n2359\tuint32_t *ptr = *pptr;\n2360\t#ifdef PCRE2_DEBUG\n2361\tPCRE2_UCHAR *start_code = *pcode;\n2362\t#endif\n2363\t\n2364\twhile (*ptr == META_ECLASS_NOT)\n2365\t  {\n2366\t  ++ptr;\n2367\t  negated = !negated;\n2368\t  }\n2369\t\n2370\t*pptr = ptr;\n2371\t/* Because it's a non-empty class, there must be an operand. */\n2372\tif (!compile_class_juxtaposition(context, negated, pptr, pcode,\n2373\t                                 pop_info, lengthptr))\n2374\t  return FALSE;\n2375\t\n2376\tPCRE2_ASSERT(lengthptr == NULL || *pcode == start_code);\n2377\treturn TRUE;\n2378\t}\n2379\t\n2380\t\n2381\t\n2382\t/* This function consumes tightly-binding binary operators. */\n2383\t\n2384\tstatic BOOL\n2385\tcompile_class_binary_tight(eclass_context *context, BOOL negated,\n2386\t  uint32_t **pptr, PCRE2_UCHAR **pcode, eclass_op_info *pop_info,\n2387\t  PCRE2_SIZE *lengthptr)\n2388\t{\n2389\tuint32_t *ptr = *pptr;\n2390\tPCRE2_UCHAR *code = *pcode;\n2391\t#ifdef PCRE2_DEBUG\n2392\tPCRE2_UCHAR *start_code = *pcode;\n2393\t#endif\n2394\t\n2395\t/* See compile_class_binary_loose() for comments on compile-time folding of\n2396\tthe \"negated\" flag. */\n2397\t\n2398\t/* Because it's a non-empty class, there must be an operand at the start. */\n2399\tif (!compile_class_unary(context, negated, &ptr, &code, pop_info, lengthptr))\n2400\t  return FALSE;\n2401\t\n2402\twhile (*ptr == META_ECLASS_AND)\n2403\t  {\n2404\t  uint32_t op;\n2405\t  BOOL rhs_negated;\n2406\t  eclass_op_info rhs_op_info;\n2407\t\n2408\t  if (negated)\n2409\t    {\n2410\t    /* !(A && B)  ->  !A || !B */\n2411\t    op = ECL_OR;\n2412\t    rhs_negated = TRUE;\n2413\t    }\n2414\t  else\n2415\t    {\n2416\t    /* A && B  ->  A && B */\n2417\t    op = ECL_AND;\n2418\t    rhs_negated = FALSE;\n2419\t    }\n2420\t\n2421\t  ++ptr;\n2422\t\n2423\t  /* An operand must follow the operator. */\n2424\t  if (!compile_class_unary(context, rhs_negated, &ptr, &code,\n2425\t                           &rhs_op_info, lengthptr))\n2426\t    return FALSE;\n2427\t\n2428\t  /* Convert infix to postfix (RPN). */\n2429\t  fold_binary(op, pop_info, &rhs_op_info, lengthptr);\n2430\t  if (lengthptr == NULL)\n2431\t    code = pop_info->code_start + pop_info->length;\n2432\t  }\n2433\t\n2434\tPCRE2_ASSERT(lengthptr == NULL || code == start_code);\n2435\t\n2436\t*pptr = ptr;\n2437\t*pcode = code;\n2438\treturn TRUE;\n2439\t}\n2440\t\n2441\t\n2442\t\n2443\t/* This function consumes loosely-binding binary operators. */\n2444\t\n2445\tstatic BOOL\n2446\tcompile_class_binary_loose(eclass_context *context, BOOL negated,\n2447\t  uint32_t **pptr, PCRE2_UCHAR **pcode, eclass_op_info *pop_info,\n2448\t  PCRE2_SIZE *lengthptr)\n2449\t{\n2450\tuint32_t *ptr = *pptr;\n2451\tPCRE2_UCHAR *code = *pcode;\n2452\t#ifdef PCRE2_DEBUG\n2453\tPCRE2_UCHAR *start_code = *pcode;\n2454\t#endif\n2455\t\n2456\t/* We really want to fold the negation operator, if at all possible, so that\n2457\tsimple cases can be reduced down. In particular, in 8-bit no-UTF mode, we want\n2458\tto produce a fully-folded expression, so that we can guarantee not to emit any\n2459\tOP_ECLASS codes (in the same way that we never emit OP_XCLASS in this mode).\n2460\t\n2461\tThis has the consequence that with a little ingenuity, we can in fact avoid\n2462\temitting (nearly...) all cases of the \"NOT\" operator. Imagine that we have:\n2463\t    !(A ...\n2464\tWe have parsed the preceding \"!\", and we are about to parse the \"A\" operand. We\n2465\tdon't know yet whether there will even be a following binary operand! Both of\n2466\tthese are possibilities for what follows:\n2467\t    !(A && B)\n2468\t    !(A)\n2469\tHowever, we can still fold the \"!\" into the \"A\" operand, because no matter what\n2470\tthe following binary operator will be, we can produce an expression which is\n2471\tequivalent. */\n2472\t\n2473\t/* Because it's a non-empty class, there must be an operand at the start. */\n2474\tif (!compile_class_binary_tight(context, negated, &ptr, &code,\n2475\t                                pop_info, lengthptr))\n2476\t  return FALSE;\n2477\t\n2478\twhile (*ptr >= META_ECLASS_OR && *ptr <= META_ECLASS_XOR)\n2479\t  {\n2480\t  uint32_t op;\n2481\t  BOOL op_neg;\n2482\t  BOOL rhs_negated;\n2483\t  eclass_op_info rhs_op_info;\n2484\t\n2485\t  if (negated)\n2486\t    {\n2487\t    /* The whole expression is being negated; we respond by unconditionally\n2488\t    negating the LHS A, before seeing what follows. And hooray! We can recover,\n2489\t    no matter what follows. */\n2490\t    /* !(A || B)   ->  !A && !B                     */\n2491\t    /* !(A -- B)   ->  !(A && !B)    ->  !A || B    */\n2492\t    /* !(A XOR B)  ->  !(!A XOR !B)  ->  !A XNOR !B */\n2493\t    op = (*ptr == META_ECLASS_OR )? ECL_AND :\n2494\t         (*ptr == META_ECLASS_SUB)? ECL_OR  :\n2495\t         /*ptr == META_ECLASS_XOR*/ ECL_XOR;\n2496\t    op_neg = (*ptr == META_ECLASS_XOR);\n2497\t    rhs_negated = *ptr != META_ECLASS_SUB;\n2498\t    }\n2499\t  else\n2500\t    {\n2501\t    /* A || B   ->  A || B  */\n2502\t    /* A -- B   ->  A && !B */\n2503\t    /* A XOR B  ->  A XOR B */\n2504\t    op = (*ptr == META_ECLASS_OR )? ECL_OR  :\n2505\t         (*ptr == META_ECLASS_SUB)? ECL_AND :\n2506\t         /*ptr == META_ECLASS_XOR*/ ECL_XOR;\n2507\t    op_neg = FALSE;\n2508\t    rhs_negated = *ptr == META_ECLASS_SUB;\n2509\t    }\n2510\t\n2511\t  ++ptr;\n2512\t\n2513\t  /* An operand must follow the operator. */\n2514\t  if (!compile_class_binary_tight(context, rhs_negated, &ptr, &code,\n2515\t                                  &rhs_op_info, lengthptr))\n2516\t    return FALSE;\n2517\t\n2518\t  /* Convert infix to postfix (RPN). */\n2519\t  fold_binary(op, pop_info, &rhs_op_info, lengthptr);\n2520\t  if (op_neg) fold_negation(pop_info, lengthptr, FALSE);\n2521\t  if (lengthptr == NULL)\n2522\t    code = pop_info->code_start + pop_info->length;\n2523\t  }\n2524\t\n2525\tPCRE2_ASSERT(lengthptr == NULL || code == start_code);\n2526\t\n2527\t*pptr = ptr;\n2528\t*pcode = code;\n2529\treturn TRUE;\n2530\t}\n2531\t\n2532\t\n2533\t\n2534\t/* This function converts the META codes in pptr into opcodes written to\n2535\tpcode. The pptr must start at a META_CLASS or META_CLASS_NOT.\n2536\t\n2537\tThe class is compiled as a left-associative sequence of operator\n2538\tapplications.\n2539\t\n2540\tThe pptr will be left pointing at the matching META_CLASS_END. */\n2541\t\n2542\tstatic BOOL\n2543\tcompile_eclass_nested(eclass_context *context, BOOL negated,\n2544\t  uint32_t **pptr, PCRE2_UCHAR **pcode,\n2545\t  eclass_op_info *pop_info, PCRE2_SIZE *lengthptr)\n2546\t{\n2547\tuint32_t *ptr = *pptr;\n2548\t#ifdef PCRE2_DEBUG\n2549\tPCRE2_UCHAR *start_code = *pcode;\n2550\t#endif\n2551\t\n2552\t/* The CLASS_IS_ECLASS bit must be set since it is a nested class. */\n2553\tPCRE2_ASSERT(*ptr == (META_CLASS | CLASS_IS_ECLASS) ||\n2554\t             *ptr == (META_CLASS_NOT | CLASS_IS_ECLASS));\n2555\t\n2556\tif (*ptr++ == (META_CLASS_NOT | CLASS_IS_ECLASS))\n2557\t  negated = !negated;\n2558\t\n2559\t(*pptr)++;\n2560\t\n2561\t/* Because it's a non-empty class, there must be an operand at the start. */\n2562\tif (!compile_class_binary_loose(context, negated, pptr, pcode,\n2563\t                                pop_info, lengthptr))\n2564\t  return FALSE;\n2565\t\n2566\tPCRE2_ASSERT(**pptr == META_CLASS_END);\n2567\tPCRE2_ASSERT(lengthptr == NULL || *pcode == start_code);\n2568\treturn TRUE;\n2569\t}\n2570\t\n2571\tBOOL\n2572\tPRIV(compile_class_nested)(uint32_t options, uint32_t xoptions,\n2573\t  uint32_t **pptr, PCRE2_UCHAR **pcode, int *errorcodeptr,\n2574\t  compile_block *cb, PCRE2_SIZE *lengthptr)\n2575\t{\n2576\teclass_context context;\n2577\teclass_op_info op_info;\n2578\tPCRE2_SIZE previous_length = (lengthptr != NULL)? *lengthptr : 0;\n2579\tPCRE2_UCHAR *code = *pcode;\n2580\tPCRE2_UCHAR *previous;\n2581\tBOOL allbitsone = TRUE;\n2582\t\n2583\tcontext.needs_bitmap = FALSE;\n2584\tcontext.options = options;\n2585\tcontext.xoptions = xoptions;\n2586\tcontext.errorcodeptr = errorcodeptr;\n2587\tcontext.cb = cb;\n2588\t\n2589\tprevious = code;\n2590\t*code++ = OP_ECLASS;\n2591\tcode += LINK_SIZE;\n2592\t*code++ = 0;  /* Flags, currently zero. */\n2593\tif (!compile_eclass_nested(&context, FALSE, pptr, &code, &op_info, lengthptr))\n2594\t  return FALSE;\n2595\t\n2596\tif (lengthptr != NULL)\n2597\t  {\n2598\t  *lengthptr += code - previous;\n2599\t  code = previous;\n2600\t  /* (*lengthptr - previous_length) now holds the amount of buffer that\n2601\t  we require to make the call to compile_class_nested() with\n2602\t  lengthptr = NULL, and including the (1+LINK_SIZE+1) that we write out\n2603\t  before that call. */\n2604\t  }\n2605\t\n2606\t/* Do some useful counting of what's in the bitmap. */\n2607\tfor (int i = 0; i < 8; i++)\n2608\t  if (op_info.bits.classwords[i] != 0xffffffff)\n2609\t    {\n2610\t    allbitsone = FALSE;\n2611\t    break;\n2612\t    }\n2613\t\n2614\t/* After constant-folding the extended class syntax, it may turn out to be\n2615\ta simple class after all. In that case, we can unwrap it from the\n2616\tOP_ECLASS container - and in fact, we must do so, because in 8-bit\n2617\tno-Unicode mode the matcher is compiled without support for OP_ECLASS. */\n2618\t\n2619\t#ifndef SUPPORT_WIDE_CHARS\n2620\tPCRE2_ASSERT(op_info.op_single_type != 0);\n2621\t#else\n2622\tif (op_info.op_single_type != 0)\n2623\t#endif\n2624\t  {\n2625\t  /* Rewind back over the OP_ECLASS. */\n2626\t  code = previous;\n2627\t\n2628\t  /* If the bits are all ones, and the \"high characters\" are all matched\n2629\t  too, we use a special-cased encoding of OP_ALLANY. */\n2630\t\n2631\t  if (op_info.op_single_type == ECL_ANY && allbitsone)\n2632\t    {\n2633\t    /* Advancing code means rewinding lengthptr, at this point. */\n2634\t    if (lengthptr != NULL) *lengthptr -= 1;\n2635\t    *code++ = OP_ALLANY;\n2636\t    }\n2637\t\n2638\t  /* If the high bits are all matched / all not-matched, then we emit an\n2639\t  OP_NCLASS/OP_CLASS respectively. */\n2640\t\n2641\t  else if (op_info.op_single_type == ECL_ANY ||\n2642\t           op_info.op_single_type == ECL_NONE)\n2643\t    {\n2644\t    PCRE2_SIZE required_len = 1 + (32 / sizeof(PCRE2_UCHAR));\n2645\t\n2646\t    if (lengthptr != NULL)\n2647\t      {\n2648\t      if (required_len > (*lengthptr - previous_length))\n2649\t      *lengthptr = previous_length + required_len;\n2650\t      }\n2651\t\n2652\t    /* Advancing code means rewinding lengthptr, at this point. */\n2653\t    if (lengthptr != NULL) *lengthptr -= required_len;\n2654\t    *code++ = (op_info.op_single_type == ECL_ANY)? OP_NCLASS : OP_CLASS;\n2655\t    memcpy(code, op_info.bits.classbits, 32);\n2656\t    code += 32 / sizeof(PCRE2_UCHAR);\n2657\t    }\n2658\t\n2659\t  /* Otherwise, we have an ECL_XCLASS, so we have the OP_XCLASS data\n2660\t  there, but, we pulled out its bitmap into op_info, so now we have to\n2661\t  put that back into the OP_XCLASS. */\n2662\t\n2663\t  else\n2664\t    {\n2665\t#ifndef SUPPORT_WIDE_CHARS\n2666\t    PCRE2_DEBUG_UNREACHABLE();\n2667\t#else\n2668\t    BOOL need_map = context.needs_bitmap;\n2669\t    PCRE2_SIZE required_len;\n2670\t\n2671\t    PCRE2_ASSERT(op_info.op_single_type == ECL_XCLASS);\n2672\t    required_len = op_info.length + (need_map? 32/sizeof(PCRE2_UCHAR) : 0);\n2673\t\n2674\t    if (lengthptr != NULL)\n2675\t      {\n2676\t      /* Don't unconditionally request all the space we need - we may\n2677\t      already have asked for more during processing of the ECLASS. */\n2678\t      if (required_len > (*lengthptr - previous_length))\n2679\t        *lengthptr = previous_length + required_len;\n2680\t\n2681\t      /* The code we write out here won't be ignored, even during the\n2682\t      (lengthptr != NULL) phase, because if there's a following quantifier\n2683\t      it will peek backwards. So we do have to write out a (truncated)\n2684\t      OP_XCLASS, even on this branch. */\n2685\t      *lengthptr -= 1 + LINK_SIZE + 1;\n2686\t      *code++ = OP_XCLASS;\n2687\t      PUT(code, 0, 1 + LINK_SIZE + 1);\n2688\t      code += LINK_SIZE;\n2689\t      *code++ = 0;\n2690\t      }\n2691\t    else\n2692\t      {\n2693\t      PCRE2_UCHAR *rest;\n2694\t      PCRE2_SIZE rest_len;\n2695\t      PCRE2_UCHAR flags;\n2696\t\n2697\t      /* 1 unit: OP_XCLASS | LINK_SIZE units | 1 unit: flags | ...rest */\n2698\t      PCRE2_ASSERT(op_info.length >= 1 + LINK_SIZE + 1);\n2699\t      rest = op_info.code_start + 1 + LINK_SIZE + 1;\n2700\t      rest_len = (op_info.code_start + op_info.length) - rest;\n2701\t\n2702\t      /* First read any data we use, before memmove splats it. */\n2703\t      flags = op_info.code_start[1 + LINK_SIZE];\n2704\t      PCRE2_ASSERT((flags & XCL_MAP) == 0);\n2705\t\n2706\t      /* Next do the memmove before any writes. */\n2707\t      memmove(code + 1 + LINK_SIZE + 1 + (need_map? 32/sizeof(PCRE2_UCHAR) : 0),\n2708\t              rest, CU2BYTES(rest_len));\n2709\t\n2710\t      /* Finally write the header data. */\n2711\t      *code++ = OP_XCLASS;\n2712\t      PUT(code, 0, (int)required_len);\n2713\t      code += LINK_SIZE;\n2714\t      *code++ = flags | (need_map? XCL_MAP : 0);\n2715\t      if (need_map)\n2716\t        {\n2717\t        memcpy(code, op_info.bits.classbits, 32);\n2718\t        code += 32 / sizeof(PCRE2_UCHAR);\n2719\t        }\n2720\t      code += rest_len;\n2721\t      }\n2722\t#endif /* SUPPORT_WIDE_CHARS