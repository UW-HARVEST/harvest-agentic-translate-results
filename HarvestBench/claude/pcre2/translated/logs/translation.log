{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0174Y756T59SCQqQSNqhyg5B","type":"tool_result","content":"160\t      about validating ${} replacements inside find_text_end(), so we certainly\n161\t      don't need to worry about other syntax. Importantly, a \\g<..> or $<...>\n162\t      sequence can't contain a '}' character. */\n163\t      break;\n164\t\n165\t      default:\n166\t      if (erc < 0)\n167\t        break;  /* capture group reference */\n168\t      ptr = esc_end_ptr;\n169\t      rc = PCRE2_ERROR_BADREPESCAPE;\n170\t      goto EXIT;\n171\t      }\n172\t    }\n173\t  }\n174\t\n175\trc = PCRE2_ERROR_REPMISSINGBRACE;   /* Terminator not found */\n176\t\n177\tEXIT:\n178\t*ptrptr = ptr;\n179\treturn rc;\n180\t}\n181\t\n182\t\n183\t/*************************************************\n184\t*           Validate group name                  *\n185\t*************************************************/\n186\t\n187\t/* This function scans for a capture group name, validating it\n188\tconsists of legal characters, is not empty, and does not exceed\n189\tMAX_NAME_SIZE.\n190\t\n191\tArguments:\n192\t  ptrptr    points to the pointer to the start of the text (updated)\n193\t  ptrend    end of the whole string\n194\t  utf       true if the input is UTF-encoded\n195\t  ctypes    pointer to the character types table\n196\t\n197\tReturns:    TRUE if a name was read\n198\t            FALSE otherwise\n199\t*/\n200\t\n201\tstatic BOOL\n202\tread_name_subst(PCRE2_SPTR *ptrptr, PCRE2_SPTR ptrend, BOOL utf,\n203\t    const uint8_t* ctypes)\n204\t{\n205\tPCRE2_SPTR ptr = *ptrptr;\n206\tPCRE2_SPTR nameptr = ptr;\n207\t\n208\tif (ptr >= ptrend)                 /* No characters in name */\n209\t  goto FAILED;\n210\t\n211\t/* We do not need to check whether the name starts with a non-digit.\n212\tWe are simply referencing names here, not defining them. */\n213\t\n214\t/* See read_name in the pcre2_compile.c for the corresponding logic\n215\trestricting group names inside the pattern itself. */\n216\t\n217\t#ifdef SUPPORT_UNICODE\n218\tif (utf)\n219\t  {\n220\t  uint32_t c, type;\n221\t\n222\t  while (ptr < ptrend)\n223\t    {\n224\t    GETCHAR(c, ptr);\n225\t    type = UCD_CHARTYPE(c);\n226\t    if (type != ucp_Nd && PRIV(ucp_gentype)[type] != ucp_L &&\n227\t        c != CHAR_UNDERSCORE) break;\n228\t    ptr++;\n229\t    FORWARDCHARTEST(ptr, ptrend);\n230\t    }\n231\t  }\n232\telse\n233\t#else\n234\t(void)utf;  /* Avoid compiler warning */\n235\t#endif      /* SUPPORT_UNICODE */\n236\t\n237\t/* Handle group names in non-UTF modes. */\n238\t\n239\t  {\n240\t  while (ptr < ptrend && MAX_255(*ptr) && (ctypes[*ptr] & ctype_word) != 0)\n241\t    {\n242\t    ptr++;\n243\t    }\n244\t  }\n245\t\n246\t/* Check name length */\n247\t\n248\tif (ptr - nameptr > MAX_NAME_SIZE)\n249\t  goto FAILED;\n250\t\n251\t/* Subpattern names must not be empty */\n252\tif (ptr == nameptr)\n253\t  goto FAILED;\n254\t\n255\t*ptrptr = ptr;\n256\treturn TRUE;\n257\t\n258\tFAILED:\n259\t*ptrptr = ptr;\n260\treturn FALSE;\n261\t}\n262\t\n263\t\n264\t/*************************************************\n265\t*              Case transformations              *\n266\t*************************************************/\n267\t\n268\t#define PCRE2_SUBSTITUTE_CASE_NONE                 0\n269\t// 1, 2, 3 are PCRE2_SUBSTITUTE_CASE_LOWER, UPPER, TITLE_FIRST.\n270\t#define PCRE2_SUBSTITUTE_CASE_REVERSE_TITLE_FIRST  4\n271\t\n272\ttypedef struct {\n273\t  int to_case; /* One of PCRE2_SUBSTITUTE_CASE_xyz */\n274\t  BOOL single_char;\n275\t} case_state;\n276\t\n277\t/* Helper to guess how much a string is likely to increase in size when\n278\tcase-transformed. Usually, strings don't change size at all, but some rare\n279\tcharacters do grow. Estimate +10%, plus another few characters.\n280\t\n281\tPerforming this estimation is unfortunate, but inevitable, since we can't call\n282\tthe callout if we ran out of buffer space to prepare its input.\n283\t\n284\tBecause this estimate is inexact (and in pathological cases, underestimates the\n285\trequired buffer size) we must document that when you have a\n286\tsubstitute_case_callout, and you are using PCRE2_SUBSTITUTE_OVERFLOW_LENGTH, you\n287\tmay need more than two calls to determine the final buffer size. */\n288\t\n289\tstatic PCRE2_SIZE\n290\tpessimistic_case_inflation(PCRE2_SIZE len)\n291\t{\n292\treturn (len >> 3u) + 10;\n293\t}\n294\t\n295\t/* Case transformation behaviour if no callout is passed. */\n296\t\n297\tstatic PCRE2_SIZE\n298\tdefault_substitute_case_callout(\n299\t  PCRE2_SPTR input, PCRE2_SIZE input_len,\n300\t  PCRE2_UCHAR *output, PCRE2_SIZE output_cap,\n301\t  case_state *state, const pcre2_code *code)\n302\t{\n303\tPCRE2_SPTR input_end = input + input_len;\n304\t#ifdef SUPPORT_UNICODE\n305\tBOOL utf;\n306\tBOOL ucp;\n307\t#endif\n308\tPCRE2_UCHAR temp[6];\n309\tBOOL next_to_upper;\n310\tBOOL rest_to_upper;\n311\tBOOL single_char;\n312\tBOOL overflow = FALSE;\n313\tPCRE2_SIZE written = 0;\n314\t\n315\t/* Helpful simplifying invariant: input and output are disjoint buffers.\n316\tI believe that this code is technically undefined behaviour, because the two\n317\tpointers input/output are \"unrelated\" pointers and hence not comparable. Casting\n318\tvia char* bypasses some but not all of those technical rules. It is not included\n319\tin release builds, in any case. */\n320\tPCRE2_ASSERT((char *)(input + input_len) <= (char *)output ||\n321\t             (char *)(output + output_cap) <= (char *)input);\n322\t\n323\t#ifdef SUPPORT_UNICODE\n324\tutf = (code->overall_options & PCRE2_UTF) != 0;\n325\tucp = (code->overall_options & PCRE2_UCP) != 0;\n326\t#endif\n327\t\n328\tif (input_len == 0) return 0;\n329\t\n330\tswitch (state->to_case)\n331\t  {\n332\t  /* LCOV_EXCL_START */\n333\t  default:\n334\t  PCRE2_DEBUG_UNREACHABLE();\n335\t  return 0;\n336\t  /* LCOV_EXCL_STOP */\n337\t\n338\t  case PCRE2_SUBSTITUTE_CASE_LOWER: // Can be single_char TRUE or FALSE\n339\t  case PCRE2_SUBSTITUTE_CASE_UPPER: // Can only be single_char FALSE"}]},"parent_tool_use_id":"toolu_bdrk_014KkVhgVTuFnDoxfiuZpZCW","session_id":"f08167af-b65d-45d4-8780-bbe04557b3d8","uuid":"271498db-6ce9-4c2f-9faf-f1abf172bb7d","timestamp":"2026-08-05T04:57:34.219Z","subagent_type":"general-purpose","task_description":"Translate pcre2_substitute.c chunked"}
