02\tpub const CHAR_UNDERSCORE: u32 = 0x5f;\n603\tpub const CHAR_GRAVE_ACCENT: u32 = 0x60;\n604\tpub const CHAR_a: u32 = 0x61;\n605\tpub const CHAR_b: u32 = 0x62;\n606\tpub const CHAR_c: u32 = 0x63;\n607\tpub const CHAR_d: u32 = 0x64;\n608\tpub const CHAR_e: u32 = 0x65;\n609\tpub const CHAR_f: u32 = 0x66;\n610\tpub const CHAR_g: u32 = 0x67;\n611\tpub const CHAR_h: u32 = 0x68;\n612\tpub const CHAR_i: u32 = 0x69;\n613\tpub const CHAR_j: u32 = 0x6a;\n614\tpub const CHAR_k: u32 = 0x6b;\n615\tpub const CHAR_l: u32 = 0x6c;\n616\tpub const CHAR_m: u32 = 0x6d;\n617\tpub const CHAR_n: u32 = 0x6e;\n618\tpub const CHAR_o: u32 = 0x6f;\n619\tpub const CHAR_p: u32 = 0x70;\n620\tpub const CHAR_q: u32 = 0x71;\n621\tpub const CHAR_r: u32 = 0x72;\n622\tpub const CHAR_s: u32 = 0x73;\n623\tpub const CHAR_t: u32 = 0x74;\n624\tpub const CHAR_u: u32 = 0x75;\n625\tpub const CHAR_v: u32 = 0x76;\n626\tpub const CHAR_w: u32 = 0x77;\n627\tpub const CHAR_x: u32 = 0x78;\n628\tpub const CHAR_y: u32 = 0x79;\n629\tpub const CHAR_z: u32 = 0x7a;\n630\tpub const CHAR_LEFT_CURLY_BRACKET: u32 = 0x7b;\n631\tpub const CHAR_VERTICAL_LINE: u32 = 0x7c;\n632\tpub const CHAR_RIGHT_CURLY_BRACKET: u32 = 0x7d;\n633\tpub const CHAR_TILDE: u32 = 0x7e;\n634\t\n635\t// ---------- repr(C) data-table element structs ----------\n636\t#[repr(C)]\n637\t#[derive(Clone, Copy)]\n638\tpub struct UcdRecord {\n639\t    pub script: u8,\n640\t    pub chartype: u8,\n641\t    pub gbprop: u8,\n642\t    pub caseset: u8,\n643\t    pub other_case: i32,\n644\t    pub scriptx_bidiclass: u16,\n645\t    pub bprops: u16,\n646\t}\n647\t\n648\t#[repr(C)]\n649\t#[derive(Clone, Copy)]\n650\tpub struct UcpTypeTable {\n651\t    pub name_offset: u16,\n652\t    pub type_: u16,\n653\t    pub value: u16,\n654\t}\n655\t\n656\t// ---------- Memory control ----------\n657\tpub type MallocFn = Option<unsafe extern \"C\" fn(usize, *mut c_void) -> *mut c_void>;\n658\tpub type FreeFn = Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void)>;\n659\t\n660\t#[repr(C)]\n661\t#[derive(Clone, Copy)]\n662\tpub struct pcre2_memctl {\n663\t    pub malloc: MallocFn,\n664\t    pub free: FreeFn,\n665\t    pub memory_data: *mut c_void,\n666\t}\n667\t\n668\t// ---------- Public callback types ----------\n669\tpub type JitCallback = Option<unsafe extern \"C\" fn(*mut c_void) -> *mut c_void>;\n670\tpub type CalloutFn = Option<unsafe extern \"C\" fn(*mut pcre2_callout_block, *mut c_void) -> c_int>;\n671\tpub type SubstCalloutFn =\n672\t    Option<unsafe extern \"C\" fn(*mut pcre2_substitute_callout_block, *mut c_void) -> c_int>;\n673\tpub type SubstCaseCalloutFn = Option<\n674\t    unsafe extern \"C\" fn(PCRE2_SPTR, PCRE2_SIZE, *mut PCRE2_UCHAR, PCRE2_SIZE, c_int, *mut c_void) -> PCRE2_SIZE,\n675\t>;\n676\tpub type StackGuardFn = Option<unsafe extern \"C\" fn(u32, *mut c_void) -> c_int>;\n677\t\n678\t// ---------- Public callout block structures ----------\n679\t#[repr(C)]\n680\tpub struct pcre2_callout_block {\n681\t    pub version: u32,\n682\t    pub callout_number: u32,\n683\t    pub capture_top: u32,\n684\t    pub capture_last: u32,\n685\t    pub offset_vector: *mut PCRE2_SIZE,\n686\t    pub mark: PCRE2_SPTR,\n687\t    pub subject: PCRE2_SPTR,\n688\t    pub subject_length: PCRE2_SIZE,\n689\t    pub start_match: PCRE2_SIZE,\n690\t    pub current_position: PCRE2_SIZE,\n691\t    pub pattern_position: PCRE2_SIZE,\n692\t    pub next_item_length: PCRE2_SIZE,\n693\t    pub callout_string_offset: PCRE2_SIZE,\n694\t    pub callout_string_length: PCRE2_SIZE,\n695\t    pub callout_string: PCRE2_SPTR,\n696\t    pub callout_flags: u32,\n697\t}\n698\t\n699\t#[repr(C)]\n700\tpub struct pcre2_callout_enumerate_block {\n701\t    pub version: u32,\n702\t    pub pattern_position: PCRE2_SIZE,\n703\t    pub next_item_length: PCRE2_SIZE,\n704\t    pub callout_number: u32,\n705\t    pub callout_string_offset: PCRE2_SIZE,\n706\t    pub callout_string_length: PCRE2_SIZE,\n707\t    pub callout_string: PCRE2_SPTR,\n708\t}\n709\t\n710\t#[repr(C)]\n711\tpub struct pcre2_substitute_callout_block {\n712\t    pub version: u32,\n713\t    pub input: PCRE2_SPTR,\n714\t    pub output: PCRE2_SPTR,\n715\t    pub output_offsets: [PCRE2_SIZE; 2],\n716\t    pub ovector: *mut PCRE2_SIZE,\n717\t    pub oveccount: u32,\n718\t    pub subscount: u32,\n719\t}\n720\t\n721\t// ---------- Hidden context structures ----------\n722\t#[repr(C)]\n723\t#[derive(Clone, Copy)]\n724\tpub struct pcre2_real_general_context {\n725\t    pub memctl: pcre2_memctl,\n726\t}\n727\t\n728\t#[repr(C)]\n729\t#[derive(Clone, Copy)]\n730\tpub struct pcre2_real_compile_context {\n731\t    pub memctl: pcre2_memctl,\n732\t    pub stack_guard: StackGuardFn,\n733\t    pub stack_guard_data: *mut c_void,\n734\t    pub tables: *const u8,\n735\t    pub max_pattern_length: PCRE2_SIZE,\n736\t    pub max_pattern_compiled_length: PCRE2_SIZE,\n737\t    pub bsr_convention: u16,\n738\t    pub newline_convention: u16,\n739\t    pub parens_nest_limit: u32,\n740\t    pub extra_options: u32,\n741\t    pub max_varlookbehind: u32,\n742\t    pub optimization_flags: u32,\n743\t}\n744\t\n745\t#[repr(C)]\n746\t#[derive(Clone, Copy)]\n747\tpub struct pcre2_real_match_context {\n748\t    pub memctl: pcre2_memctl,\n749\t    // SUPPORT_JIT is not defined, so no jit_callback fields.\n750\t    pub callout: CalloutFn,\n751\t    pub callout_data: *mut c_void,\n752\t    pub substitute_callout: SubstCalloutFn,\n753\t    pub substitute_callout_data: *mut c_void,\n754\t    pub substitute_case_callout: SubstCaseCalloutFn,\n755\t    pub substitute_case_callout_data: *mut c_void,\n756\t    pub offset_limit: PCRE2_SIZE,\n757\t    pub heap_limit: u32,\n758\t    pub match_limit: u32,\n759\t    pub depth_limit: u32,\n760\t}\n761\t\n762\t#[repr(C)]\n763\t#[derive(Clone, Copy)]\n764\tpub struct pcre2_real_convert_context {\n765\t    pub memctl: pcre2_memctl,\n766\t    pub glob_separator: u32,\n767\t    pub glob_escape: u32,\n768\t}\n769\t\n770\t#[repr(C)]\n771\tpub struct pcre2_real_code {\n772\t    pub memctl: pcre2_memctl,\n773\t    pub tables: *const u8,\n774\t    pub executable_jit: *mut c_void,\n775\t    pub start_bitmap: [u8; 32],\n776\t    pub blocksize: PCRE2_SIZE,\n777\t    pub code_start: PCRE2_SIZE,\n778\t    pub magic_number: u32,\n779\t    pub compile_options: u32,\n780\t    pub overall_options: u32,\n781\t    pub extra_options: u32,\n782\t    pub flags: u32,\n783\t    pub limit_heap: u32,\n784\t    pub limit_match: u32,\n785\t    pub limit_depth: u32,\n786\t    pub first_codeunit: u32,\n787\t    pub last_codeunit: u32,\n788\t    pub bsr_convention: u16,\n789\t    pub newline_convention: u16,\n790\t    pub max_lookbehind: u16,\n791\t    pub minlength: u16,\n792\t    pub top_bracket: u16,\n793\t    pub top_backref: u16,\n794\t    pub name_entry_size: u16,\n795\t    pub name_count: u16,\n796\t    pub optimization_flags: u32,\n797\t}\n798\t\n799\t// The match data: ovector is variable length; header up to ovector matters.\n800\t#[repr(C)]\n801\tpub struct pcre2_real_match_data {\n802\t    pub memctl: pcre2_memctl,\n803\t    pub code: *const pcre2_real_code,\n804\t    pub subject: PCRE2_SPTR,\n805\t    pub mark: PCRE2_SPTR,\n806\t    pub heapframes: *mut c_void,\n807\t    pub heapframes_size: PCRE2_SIZE,\n808\t    pub subject_length: PCRE2_SIZE,\n809\t    pub start_offset: PCRE2_SIZE,\n810\t    pub leftchar: PCRE2_SIZE,\n811\t    pub rightchar: PCRE2_SIZE,\n812\t    pub startchar: PCRE2_SIZE,\n813\t    pub matchedby: u8,\n814\t    pub flags: u8,\n815\t    pub oveccount: u16,\n816\t    pub options: u32,\n817\t    pub rc: c_int,\n818\t    pub ovector: [PCRE2_SIZE; 1], // flexible array in practice\n819\t}\n820\t\n821\t/// Offset (in bytes) of the ovector field in pcre2_real_match_data.\n822\tpub fn match_data_ovector_offset() -> usize {\n823\t    // memoffset-free: build via manual layout knowledge is error-prone; use core.\n824\t    // 12 usize-ish fields precede; compute with a dummy.\n825\t    #[repr(C)]\n826\t    struct Head {\n827\t        memctl: pcre2_memctl,\n828\t        code: *const pcre2_real_code,\n829\t        subject: PCRE2_SPTR,\n830\t        mark: PCRE2_SPTR,\n831\t        heapframes: *mut c_void,\n832\t        heapframes_size: PCRE2_SIZE,\n833\t        subject_length: PCRE2_SIZE,\n834\t        start_offset: PCRE2_SIZE,\n835\t        leftchar: PCRE2_SIZE,\n836\t        rightchar: PCRE2_SIZE,\n837\t        startchar: PCRE2_SIZE,\n838\t        matchedby: u8,\n839\t        flags: u8,\n840\t        oveccount: u16,\n841\t        options: u32,\n842\t        rc: c_int,\n843\t    }\n844\t    // ovector must be 8-aligned; the C struct places ovector right after rc with\n845\t    // padding to PCRE2_SIZE alignment.\n846\t    let base = core::mem::size_of::<Head>();\n847\t    let align = core::mem::align_of::<PCRE2_SIZE>();\n848\t    (base + align - 1) & !(align - 1)\n849\t}\n850\t\n851\tpub type pcre2_general_context = pcre2_real_general_context;\n852\tpub type pcre2_compile_context = pcre2_real_compile_context;\n853\tpub type pcre2_match_context = pcre2_real_match_context;\n854\tpub type pcre2_convert_context = pcre2_real_convert_context;\n855\tpub type pcre2_code = pcre2_real_code;\n856\tpub type pcre2_match_data = pcre2_real_match_data;\n857\t\n858\t#[repr(C)]\n859\tpub struct pcre2_real_jit_stack {\n860\t    pub memctl: pcre2_memctl,\n861\t    pub stack: *mut c_void,\n862\t}\n863\t\n864\t// ---------- Serialized header ----------\n865\t#[repr(C)]\n866\tpub struct pcre2_serialized_data {\n867\t    pub magic: u32,\n868\t    pub version: u32,\n869\t    pub config: u32,\n870\t    pub number_of_codes: i32,\n871\t}\n872\t\n873\t// ---------- small compile helper structs ----------\n874\t#[repr(C)]\n875\tpub struct open_capitem {\n876\t    pub next: *mut open_capitem,\n877\t    pub number: u16,\n878\t    pub assert_depth: u16,\n879\t}\n880\t\n881\t#[repr(C)]\n882\tpub struct named_group {\n883\t    pub name: PCRE2_SPTR,\n884\t    pub number: u32,\n885\t    pub length: u16,\n886\t    pub hash_dup: u16,\n887\t}\n888\t\n889