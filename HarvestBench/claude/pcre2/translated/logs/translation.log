 ucp_Katakana: u32 = 28;\n504\tpub const ucp_Bopomofo: u32 = 29;\n505\tpub const ucp_Han: u32 = 30;\n506\tpub const ucp_Unknown: u32 = 99;\n507\tpub const ucp_Common: u32 = 100;\n508\tpub const ucp_Inherited: u32 = 107;\n509\tpub const ucp_Script_Count: u32 = 175;\n510\t\n511\t// MAPBIT/MAPSET helpers over u32 bitmap slices\n512\t#[inline]\n513\tpub fn MAPBIT(map: &[u32], n: u32) -> u32 { map[(n / 32) as usize] & (1u32 << (n % 32)) }\n514\t#[inline]\n515\tpub fn MAPSET(map: &mut [u32], n: u32) { map[(n / 32) as usize] |= 1u32 << (n % 32); }\n516\t\n517\t#[inline]\n518\tpub fn UCD_SCRIPTX_PROP(p: &UcdRecord) -> u32 { (p.scriptx_bidiclass & UCD_SCRIPTX_MASK) as u32 }\n519\t#[inline]\n520\tpub fn UCD_BPROPS_PROP(p: &UcdRecord) -> u32 { (p.bprops & UCD_BPROPS_MASK) as u32 }\n521\t#[inline]\n522\tpub fn UCD_BIDICLASS_PROP(p: &UcdRecord) -> u32 { (p.scriptx_bidiclass >> UCD_BIDICLASS_SHIFT) as u32 }\n523\t\n524\tpub const ucp_bidiL: u16 = 9;\n525\t\n526\t// ---------- Character constants (ASCII/UTF-8) ----------\n527\tpub const CHAR_NUL: u32 = 0;\n528\tpub const CHAR_HT: u32 = 0x09;\n529\tpub const CHAR_LF: u32 = 0x0a;\n530\tpub const CHAR_NL: u32 = 0x0a;\n531\tpub const CHAR_VT: u32 = 0x0b;\n532\tpub const CHAR_FF: u32 = 0x0c;\n533\tpub const CHAR_CR: u32 = 0x0d;\n534\tpub const CHAR_NEL: u32 = 0x85;\n535\tpub const CHAR_BS: u32 = 0x08;\n536\tpub const CHAR_BEL: u32 = 0x07;\n537\tpub const CHAR_ESC: u32 = 0x1b;\n538\tpub const CHAR_DEL: u32 = 0x7f;\n539\tpub const CHAR_SPACE: u32 = 0x20;\n540\tpub const CHAR_NBSP: u32 = 0xa0;\n541\tpub const CHAR_EXCLAMATION_MARK: u32 = 0x21;\n542\tpub const CHAR_QUOTATION_MARK: u32 = 0x22;\n543\tpub const CHAR_NUMBER_SIGN: u32 = 0x23;\n544\tpub const CHAR_DOLLAR_SIGN: u32 = 0x24;\n545\tpub const CHAR_PERCENT_SIGN: u32 = 0x25;\n546\tpub const CHAR_AMPERSAND: u32 = 0x26;\n547\tpub const CHAR_APOSTROPHE: u32 = 0x27;\n548\tpub const CHAR_LEFT_PARENTHESIS: u32 = 0x28;\n549\tpub const CHAR_RIGHT_PARENTHESIS: u32 = 0x29;\n550\tpub const CHAR_A