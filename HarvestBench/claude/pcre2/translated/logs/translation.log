_)\n955\t#define pcre2_next_match                      PCRE2_SUFFIX(pcre2_next_match_)\n956\t#define pcre2_pattern_convert                 PCRE2_SUFFIX(pcre2_pattern_convert_)\n957\t#define pcre2_pattern_info                    PCRE2_SUFFIX(pcre2_pattern_info_)\n958\t#define pcre2_serialize_decode                PCRE2_SUFFIX(pcre2_serialize_decode_)\n959\t#define pcre2_serialize_encode                PCRE2_SUFFIX(pcre2_serialize_encode_)\n960\t#define pcre2_serialize_free                  PCRE2_SUFFIX(pcre2_serialize_free_)\n961\t#define pcre2_serialize_get_number_of_codes   PCRE2_SUFFIX(pcre2_serialize_get_number_of_codes_)\n962\t#define pcre2_set_bsr                         PCRE2_SUFFIX(pcre2_set_bsr_)\n963\t#define pcre2_set_callout                     PCRE2_SUFFIX(pcre2_set_callout_)\n964\t#define pcre2_set_character_tables            PCRE2_SUFFIX(pcre2_set_character_tables_)\n965\t#define pcre2_set_compile_extra_options       PCRE2_SUFFIX(pcre2_set_compile_extra_options_)\n966\t#define pcre2_set_compile_recursion_guard     PCRE2_SUFFIX(pcre2_set_compile_recursion_guard_)\n967\t#define pcre2_set_depth_limit                 PCRE2_SUFFIX(pcre2_set_depth_limit_)\n968\t#define pcre2_set_glob_escape                 PCRE2_SUFFIX(pcre2_set_glob_escape_)\n969\t#define pcre2_set_glob_separator              PCRE2_SUFFIX(pcre2_set_glob_separator_)\n970\t#define pcre2_set_heap_limit                  PCRE2_SUFFIX(pcre2_set_heap_limit_)\n971\t#define pcre2_set_match_limit                 PCRE2_SUFFIX(pcre2_set_match_limit_)\n972\t#define pcre2_set_max_varlookbehind           PCRE2_SUFFIX(pcre2_set_max_varlookbehind_)\n973\t#define pcre2_set_max_pattern_length          PCRE2_SUFFIX(pcre2_set_max_pattern_length_)\n974\t#define pcre2_set_max_pattern_compiled_length PCRE2_SUFFIX(pcre2_set_max_pattern_compiled_length_)\n975\t#define pcre2_set_newline                     PCRE2_SUFFIX(pcre2_set_newline_)\n976\t#define pcre2_set_parens_nest_limit           PCRE2_SUFFIX(pcre2_set_pare