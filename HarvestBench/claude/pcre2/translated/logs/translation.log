onst LAST_AUTOTAB_LEFT_OP: u8 = OP_EXTUNI;\n1169\tpub const LAST_AUTOTAB_RIGHT_OP: u8 = OP_DOLLM;\n1170\t\n1171\t// ---------- GET/PUT link macros (8-bit, LINK_SIZE=2) ----------\n1172\t#[inline]\n1173\tpub unsafe fn GET(a: *const u8, n: usize) -> u32 {\n1174\t    ((*a.add(n) as u32) << 8) | (*a.add(n + 1) as u32)\n1175\t}\n1176\t#[inline]\n1177\tpub unsafe fn PUT(a: *mut u8, n: usize, d: u32) {\n1178\t    *a.add(n) = (d >> 8) as u8;\n1179\t    *a.add(n + 1) = (d & 255) as u8;\n1180\t}\n1181\t#[inline]\n1182\tpub unsafe fn GET2(a: *const u8, n: usize) -> u32 {\n1183\t    ((*a.add(n) as u32) << 8) | (*a.add(n + 1) as u32)\n1184\t}\n1185\t#[inline]\n1186\tpub unsafe fn PUT2(a: *mut u8, n: usize, d: u32) {\n1187\t    *a.add(n) = (d >> 8) as u8;\n1188\t    *a.add(n + 1) = (d & 255) as u8;\n1189\t}\n1190\t#[inline]\n1191\tpub fn CU2BYTES(x: usize) -> usize { x }\n1192\t#[inline]\n1193\tpub fn BYTES2CU(x: usize) -> usize { x }\n1194\t\n1195\t// ---------- extern data tables (defined in tables_data.rs) ----------\n1196\textern \"C\" {\n1197\t    pub static _pcre2_OP_lengths_8: [u8; OP_TABLE_LENGTH];\n1198\t    pub static _pcre2_hspace_list_8: [u32; 20];\n1199\t    pub static _pcre2_vspace_list_8: [u32; 8];\n1200\t    pub static _pcre2_callout_start_delims_8: [u32; 9];\n1201\t    pub static _pcre2_callout_end_delims_8: [u32; 9];\n1202\t    pub static _pcre2_default_tables_8: [u8; TABLES_LENGTH];\n1203\t    pub static _pcre2_utf8_table1: [i32; 6];\n1204\t    pub static _pcre2_utf8_table1_size: u32;\n1205\t    pub static _pcre2_utf8_table2: [i32; 6];\n1206\t    pub static _pcre2_utf8_table3: [i32; 6];\n1207\t    pub static _pcre2_utf8_table4: [u8; 64];\n1208\t    pub static _pcre2_ucp_gentype_8: [u32; 29];\n1209\t    pub static _pcre2_ucp_gbtable_8: [u32; 15];\n1210\t    pub static _pcre2_ucd_records_8: [UcdRecord; 1563];\n1211\t    pub static _pcre2_ucd_stage1_8: [u16; 8704];\n1212\t    pub static _pcre2_ucd_stage2_8: [u16; 40192];\n1213\t    pub static _pcre2_ucd_caseless_s