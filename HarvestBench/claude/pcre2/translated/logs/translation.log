omofo: u32 = 29;\n504\tpub const ucp_Han: u32 = 30;\n505\tpub const ucp_Unknown: u32 = 99;\n506\tpub const ucp_Common: u32 = 100;\n507\tpub const ucp_Inherited: u32 = 107;\n508\tpub const ucp_Script_Count: u32 = 175;\n509\t\n510\t// MAPBIT/MAPSET helpers over u32 bitmap slices\n511\t#[inline]\n512\tpub fn MAPBIT(map: &[u32], n: u32) -> u32 { map[(n / 32) as usize] & (1u32 << (n % 32)) }\n513\t#[inline]\n514\tpub fn MAPSET(map: &mut [u32], n: u32) { map[(n / 32) as usize] |= 1u32 << (n % 32); }\n515\t\n516\t#[inline]\n517\tpub fn UCD_SCRIPTX_PROP(p: &UcdRecord) -> u32 { (p.scriptx_bidiclass & UCD_SCRIPTX_MASK) as u32 }\n518\t#[inline]\n519\tpub fn UCD_BPROPS_PROP(p: &UcdRecord) -> u32 { (p.bprops & UCD_BPROPS_MASK) as u32 }\n520\t#[inline]\n521\tpub fn UCD_BIDICLASS_PROP(p: &UcdRecord) -> u32 { (p.scriptx_bidiclass >> UCD_BIDICLASS_SHIFT) as u32 }\n522\t\n523\tpub const ucp_bidiL: u16 = 9;\n524\t\n525\t// ---------- Character constants (ASCII/UTF-8) ----------\n526\tpub const CHAR_NUL: u32 = 0;\n527\tpub const CHAR_HT: u32 = 0x09;\n528\tpub const CHAR_LF: u32 = 0x0a;\n529\tpub const CHAR_NL: u32 = 0x0a;\n530\tpub const CHAR_VT: u32 = 0x0b;\n531\tpub const CHAR_FF: u32 = 0x0c;\n532\tpub const CHAR_CR: u32 = 0x0d;\n533\tpub const CHAR_NEL: u32 = 0x85;\n534\tpub const CHAR_BS: u32 = 0x08;\n535\tpub const CHAR_BEL: u32 = 0x07;\n536\tpub const CHAR_ESC: u32 = 0x1b;\n537\tpub const CHAR_DEL: u32 = 0x7f;\n538\tpub const CHAR_SPACE: u32 = 0x20;\n539\tpub const CHAR_NBSP: u32 = 0xa0;\n540\tpub const CHAR_EXCLAMATION_MARK: u32 = 0x21;\n541\tpub const CHAR_QUOTATION_MARK: u32 = 0x22;\n542\tpub const CHAR_NUMBER_SIGN: u32 = 0x23;\n543\tpub const CHAR_DOLLAR_SIGN: u32 = 0x24;\n544\tpub const CHAR_PERCENT_SIGN: u32 = 0x25;\n545\tpub const CHAR_AMPERSAND: u32 = 0x26;\n546\tpub const CHAR_APOSTROPHE: u32 = 0x27;\n547\tpub const CHAR_LEFT_PARENTHESIS: u32 = 0x28;\n548\tpub const CHAR_RIGHT_PARENTHESIS: u32 = 0x29;\n549\tpub const CHAR_ASTERISK: u32 = 0x2a;\n550\tpub const CHAR_PLUS: u32 = 0x2b;\n551\tpub const CHAR_COMMA: u32 = 0x2c;\n552\tpub const CHAR_MINUS: u32 = 0x2d;\n553\tpub const CHAR_DOT: u32 = 0x2e;\n554\tpub const CHAR_SLASH: u32 = 0x2f;\n555\tpub const CHAR_0: u32 = 0x30;\n556\tpub const CHAR_1: u32 = 0x31;\n557\tpub const CHAR_2: u32 = 0x32;\n558\tpub const CHAR_3: u32 = 0x33;\n559\tpub const CHAR_4: u32 = 0x34;\n560\tpub const CHAR_5: u32 = 0x35;\n561\tpub const CHAR_6: u32 = 0x36;\n562\tpub const CHAR_7: u32 = 0x37;\n563\tpub const CHAR_8: u32 = 0x38;\n564\tpub const CHAR_9: u32 = 0x39;\n565\tpub const CHAR_COLON: u32 = 0x3a;\n566\tpub const CHAR_SEMICOLON: u32 = 0x3b;\n567\tpub const CHAR_LESS_THAN_SIGN: u32 = 0x3c;\n568\tpub const CHAR_EQUALS_SIGN: u32 = 0x3d;\n569\tpub const CHAR_GREATER_THAN_SIGN: u32 = 0x3e;\n570\tpub const CHAR_QUESTION_MARK: u32 = 0x3f;\n571\tpub const CHAR_COMMERCIAL_AT: u32 = 0x40;\n572\tpub const CHAR_A: u32 = 0x41;\n573\tpub const CHAR_B: u32 = 0x42;\n574\tpub const CHAR_C: u32 = 0x43;\n575\tpub const CHAR_D: u32 = 0x44;\n576\tpub const CHAR_E: u32 = 0x45;\n577\tpub const CHAR_F: u32 = 0x46;\n578\tpub const CHAR_G: u32 = 0x47;\n579\tpub const CHAR_H: u32 = 0x48;\n580\tpub const CHAR_I: u32 = 0x49;\n581\tpub const CHAR_J: u32 = 0x4a;\n582\tpub const CHAR_K: u32 = 0x4b;\n583\tpub const CHAR_L: u32 = 0x4c;\n584\tpub const CHAR_M: u32 = 0x4d;\n585\tpub const CHAR_N: u32 = 0x4e;\n586\tpub const CHAR_O: u32 = 0x4f;\n587\tpub const CHAR_P: u32 = 0x50;\n588\tpub const CHAR_Q: u32 = 0x51;\n589\tpub const CHAR_R: u32 = 0x52;\n590\tpub const CHAR_S: u32 = 0x53;\n591\tpub const CHAR_T: u32 = 0x54;\n592\tpub const CHAR_U: u32 = 0x55;\n593\tpub const CHAR_V: u32 = 0x56;\n594\tpub const CHAR_W: u32 = 0x57;\n595\tpub const CHAR_X: u32 = 0x58;\n596\tpub const CHAR_Y: u32 = 0x59;\n597\tpub const CHAR_Z: u32 = 0x5a;\n598\tpub const CHAR_LEFT_SQUARE_BRACKET: u32 = 0x5b;\n599\tpub const CHAR_BACKSLASH: u32 = 0x5c;\n600\tpub const CHAR_RIGHT_SQUARE_BRACKET: u32 = 0x5d;\n601\tpub const CHAR_CIRCUMFLEX_ACCENT: u32 = 0x5e;\n602\tpub const CHAR_UNDERSCORE: u32 = 0x5f;\n603\tpub const CHAR_GRAVE_ACCENT: u32 = 0x60;\n604\tpub const CHAR_a: u32 = 0x61;\n605\tpub const CHAR_b: u32 = 0x62;\n606\tpub const CHAR_c: u32 = 0x63;\n607\tpub const CHAR_d: u32 = 0x64;\n608\tpub const CHAR_e: u32 = 0x65;\n609\tpub const CHAR_f: u32 = 0x66;\n610\tpub const CHAR_g: u32 = 0x67;\n611\tpub const CHAR_h: u32 = 0x68;\n612\tpub const CHAR_i: u32 = 0x69;\n613\tpub const CHAR_j: u32 = 0x6a;\n614\tpub const CHAR_k: u32 = 0x6b;\n615\tpub const CHAR_l: u32 = 0x6c;\n616\tpub const CHAR_m: u32 = 0x6d;\n617\tpub const CHAR_n: u32 = 0x6e;\n618\tpub const CHAR_o: u32 = 0x6f;\n619\tpub const CHAR_p: u32 = 0x70;\n620\tpub const CHAR_q: u32 = 0x71;\n621\tpub const CHAR_r: u32 = 0x72;\n622\tpub const CHAR_s: u32 = 0x73;\n623\tpub const CHAR_t: u32 = 0x74;\n624\tpub const CHAR_u: u32 = 0x75;\n625\tpub const CHAR_v: u32 = 0x76;\n626\tpub const CHAR_w: u32 = 0x77;\n627\tpub const CHAR_x: u32 = 0x78;\n628\tpub const CHAR_y: u32 = 0x79;\n629\tpub const CHAR_z: u32 = 0x7a;\n630\tpub const CHAR_LEFT_CURLY_BRACKET: u32 = 0x7b;\n631\tpub const CHAR_VERTICAL_LINE: u32 = 0x7c;\n632\tpub const CHAR_RIGHT_CURLY_BRACKET: u32 = 0x7d;\n633\tpub const CHAR_TILDE: u32 = 0x7e;\n634\t\n635\t// ---------- repr(C) data-table element structs ----------\n636\t#[repr(C)]\n637\t#[derive(Clone, Copy)]\n638\tpub struct UcdRecord {\n639\t    pub script: u8,\n640\t    pub chartype: u8,\n641\t    pub gbprop: u8,\n642\t    pub caseset: u8,\n643\t    pub other_case: i32,\n644\t    pub scriptx_bidiclass: u16,\n645\t    pub bprops: u16,\n646\t}\n647\t\n648\t#[repr(C)]\n649\t#[derive(Clone, Copy)]\n650\tpub struct UcpTypeTable {\n651\t    pub name_offset: u16,\n652\t    pub type_: u16,\n653\t    pub value: u16,\n654\t}\n655\t\n656\t// ---------- Memory control ----------\n657\tpub type MallocFn = Option<unsafe extern \"C\" fn(usize, *mut c_void) -> *mut c_void>;\n658\tpub type FreeFn = Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void)>;\n659\t\n660\t#[repr(C)]\n661\t#[derive(Clone, Copy)]\n662\tpub struct pcre2_memctl {\n663\t    pub malloc: MallocFn,\n664\t    pub free: FreeFn,\n665\t    pub memory_data: *mut c_void,\n666\t}\n667\t\n668\t// ---------- Public callback types ----------\n669\tpub type JitCallback = Option<unsafe extern \"C\" fn(*mut c_void) -> *mut c_void>;\n670\tpub type CalloutFn = Option<unsafe extern \"C\" fn(*mut pcre2_callout_block, *mut c_void) -> c_int>;\n671\tpub type SubstCalloutFn =\n672\t    Option<unsafe extern \"C\" fn(*mut pcre2_substitute_callout_block, *mut c_void) -> c_int>;\n673\tpub type SubstCaseCalloutFn = Option<\n674\t    unsafe extern \"C\" fn(PCRE2_SPTR, PCRE2_SIZE, *mut PCRE2_UCHAR, PCRE2_SIZE, c_int, *mut c_void) -> PCRE2_SIZE,\n675\t>;\n676\tpub type StackGuardFn = Option<unsafe extern \"C\" fn(u32, *mut c_void) -> c_int>;\n677\t\n678\t// ---------- Public callout block structures ----------\n679\t#[repr(C)]\n680\tpub struct pcre2_callout_block {\n681\t    pub version: u32,\n682\t    pub callout_number: u32,\n683\t    pub capture_top: u32,\n684\t    pub capture_last: u32,\n685\t    pub offset_vector: *mut PCRE2_SIZE,\n686\t    pub mark: PCRE2_SPTR,\n687\t    pub subject: PCRE2_SPTR,\n688\t    pub subject_length: PCRE2_SIZE,\n689\t    pub start_match: PCRE2_SIZE,\n690\t    pub current_position: PCRE2_SIZE,\n691\t    pub pattern_position: PCRE2_SIZE,\n692\t    pub next_item_length: PCRE2_SIZE,\n693\t    pub callout_string_offset: PCRE2_SIZE,\n694\t    pub callout_string_length: PCRE2_SIZE,\n695\t    pub callout_string: PCRE2_SPTR,\n696\t    pub callout_flags: u32,\n697\t}\n698\t\n699\t#[repr(C)]\n700\tpub struct pcre2_callout_enumerate_block {\n701\t    pub version: u32,\n702\t    pub pattern_position: PCRE2_SIZE,\n703\t    pub next_item_length: PCRE2_SIZE,\n704\t    pub callout_number: u32,\n705\t    pub callout_string_offset: PCRE2_SIZE,\n706\t    pub callout_string_length: PCRE2_SIZE,\n707\t    pub callout_string: PCRE2_SPTR,\n708\t}\n709\t\n710\t#[repr(C)]\n711\tpub struct pcre2_substitute_callout_block {\n712\t    pub version: u32,\n713\t    pub input: PCRE2_SPTR,\n714\t    pub output: PCRE2_SPTR,\n715\t    pub output_offsets: [PCRE2_SIZE; 2],\n716\t    pub ovector: *mut PCRE2_SIZE,\n717\t    pub oveccount: u32,\n718\t    pub subscount: u32,\n719\t}\n720\t\n721\t// ---------- Hidden context structures ----------\n722\t#[repr(C)]\n723\t#[derive(Clone, Copy)]\n724\tpub struct pcre2_real_general_context {\n725\t    pub memctl: pcre2_memctl,\n726\t}\n727\t\n728\t#[repr(C)]\n729\t#[derive(Clone, Copy)]\n730\tpub struct pcre2_real_compile_context {\n731\t    pub memctl: pcre2_memctl,\n732\t    pub stack_guard: StackGuardFn,\n733\t    pub stack_guard_data: *mut c_void,\n734\t    pub tables: *const u8,\n735\t    pub max_pattern_length: PCRE2_SIZE,\n736\t    pub max_pattern_compiled_length: PCRE2_SIZE,\n737\t    pub bsr_convention: u16,\n738\t    pub newline_convention: u16,\n739\t    pub parens_nest_limit: u32,\n740\t    pub extra_options: u32,\n741\t    pub max_varlookbehind: u32,\n742\t    pub optimization_flags: u32,\n743\t}\n744\t\n745\t#[repr(C)]\n746\t#[derive(Clone, Copy)]\n747\tpub struct pcre2_real_match_context {\n748\t    pub memctl: pcre2_memctl,\n749\t    // SUPPORT_JIT is not defined, so no jit_callback fields.\n750\t    pub callout: CalloutFn,\n751\t    pub callout_data: *mut c_void,\n752\t    pub substitute_callout: SubstCalloutFn,\n753\t    pub substitute_callout_data: *mut c_void,\n754\t    pub substitute_case_callout: SubstCaseCalloutFn,\n755\t    pub substitute_case_callout_data: *mut c_void,\n756\t    pub offset_limit: PCRE2_SIZE,\n757\t    pub heap_limit: u32,\n758\t    pub match_limit: u32,\n759\t    pub depth_limit: u32,\n760\t}\n761\t\n762\t#[repr(C)]\n763\t#[derive(Clone, Copy)]\n764\tpub struct pcre2_real_convert_context {\n765\t    pub memctl: pcre2_memctl,\n766\t    pub glob_separator: u32,\n767\t    pub glob_escape: u32,\n768\t}\n769\t\n770\t#[repr(C)]\n771\tpub struct pcre2_real_code {\n772\t    pub memctl: pcre2_memctl,\n773\t    pub tables: *const u8,\n774\t    pub executable_jit: *mut c_void,\n775\t    pub start_bitmap: [u8; 32],\n776\t    pub blocksize: PCRE2_SIZE,\n777\t    pub code_start: PCRE2_SIZE,\n778\t    pub magic_number: u32,\n779\t    pub compile_options: u32,\n780\t    pub overall_options: u32,\n781\t    pub extra_options: u32,\n782\t    pub flags: u32,\n783\t    pub limit_heap: u32,\n784\t    pub limit_match: u32,\n785\t    pub limit_depth: u32,\n786\t    pub first_codeunit: u32,\n787\t    pub last_codeunit: u32,\n788\t    pub bsr_convention: u16,\n789\t    pub newline_convention: u16,\n790\t    pub max_lookbehind: u16,\n791\t    pub minlength: u16,\n792\t    pub top_bracket: u16,\n793\t    pub top_backref: u16,\n794\t    pub name_entry_size: u16,\n795\t    pub name_count: u16,\n796\t    pub optimization_flags: u32,\n797\t}\n798\t\n799\t// The match data: ovector is variable length; header up to ovector matters.\n800\t#[repr(C)]\n801\tpub struct pcre2_real_match_data {\n802\t    pub memctl: pcre2_memctl,\n803\t    pub code: *const pcre2_real_code,\n804\t    pub subject: PCRE2_SPTR,\n805\t    pub mark: PCRE2_SPTR,\n806\t    pub heapframes: *mut c_void,\n807\t    pub heapframes_size: PCRE2_SIZE,\n808\t    pub subject_length: PCRE2_SIZE,\n809\t    pub start_offset: PCRE2_SIZE,\n810\t    pub leftchar: PCRE2_SIZE,\n811\t    pub rightchar: PCRE2_SIZE,\n812\t    pub startchar: PCRE2_SIZE,\n813\t    pub matchedby: u8,\n814\t    pub flags: u8,\n815\t    pub oveccount: u16,\n816\t    pub options: u32,\n817\t    pub rc: c_int,\n818\t    pub ovector: [PCRE2_SIZE; 1], // flexible array in practice\n819\t}\n820\t\n821\t/// Offset (in bytes) of the ovector field in pcre2_real_match_data.\n822\tpub fn match_data_ovector_offset() -> usize {\n823\t    // memoffset-free: build via manual layout knowledge is error-prone; use core.\n824\t    // 12 usize-ish fields precede; compute with a dummy.\n825\t    #[repr(C)]\n826\t    struct Head {\n827\t        memctl: pcre2_memctl,\n828\t        code: *const pcre2_real_code,\n829\t        subject: PCRE2_SPTR,\n830\t        mark: PCRE2_SPTR,\n831\t        heapframes: *mut c_void,\n832\t        heapframes_size: PCRE2_SIZE,\n833\t        subject_length: PCRE2_SIZE,\n834\t        start_offset: PCRE2_SIZE,\n835\t        leftchar: PCRE2_SIZE,\n836\t        rightchar: PCRE2_SIZE,\n837\t        startchar: PCRE2_SIZE,\n838\t        matchedby: u8,\n839\t        flags: u8,\n840\t        oveccount: u16,\n841\t        options: u32,\n842\t        rc: c_int,\n843\t    }\n844\t    // ovector must be 8-aligned; the C struct places ovector right after rc with\n845\t    // padding to PCRE2_SIZE alignment.\n846\t    let base = core::mem::size_of::<Head>();\n847\t    let align = core::mem::align_of::<PCRE2_SIZE>();\n848\t    (base + align - 1) & !(align - 1)\n849\t}\n850\t\n851\tpub type pcre2_general_context = pcre2_real_general_context;\n852\tpub type pcre2_compile_context = pcre2_real_compile_context;\n853\tpub type pcre2_match_context = pcre2_real_match_context;\n854\tpub type pcre2_convert_context = pcre2_real_convert_context;\n855\tpub type pcre2_code = pcre2_real_code;\n856\tpub type pcre2_match_data = pcre2_real_match_data;\n857\t\n858\t#[repr(C)]\n859\tpub struct pcre2_real_jit_stack {\n860\t    pub memctl: pcre2_memctl,\n861\t    pub stack: *mut c_void,\n862\t}\n863\t\n864\t// ---------- Serialized header ----------\n865\t#[repr(C)]\n866\tpub struct pcre2_serialized_data {\n867\t    pub magic: u32,\n868\t    pub version: u32,\n869\t    pub config: u32,\n870\t    pub number_of_codes: i32,\n871\t}\n872\t\n873\t// ---------- small compile helper structs ----------\n874\t#[repr(C)]\n875\tpub struct open_capitem {\n876\t    pub next: *mut open_capitem,\n877\t    pub number: u16,\n878\t    pub assert_depth: u16,\n879\t}\n880\t\n881\t#[repr(C)]\n882\tpub struct named_group {\n883\t    pub name: PCRE2_SPTR,\n884\t    pub number: u32,\n885\t    pub length: u16,\n886\t    pub hash_dup: u16,\n887\t}\n888\t\n889\t// ---------- Private compile structures ----------\n890\t#[repr(C)]\n891\tpub struct recurse_check {\n892\t    pub prev: *mut recurse_check,\n893\t    pub group: PCRE2_SPTR,\n894\t}\n895\t\n896\t#[repr(C)]\n897\tpub struct parsed_recurse_check {\n898\t    pub prev: *mut parsed_recurse_check,\n899\t    pub groupptr: *mut u32,\n900\t}\n901\t\n902\t#[repr(C)]\n903\tpub struct recurse_cache {\n904\t    pub group: PCRE2_SPTR,\n905\t    pub groupnumber: c_int,\n906\t}\n907\t\n908\t#[repr(C)]\n909\tpub struct branch_chain {\n910\t    pub outer: *mut branch_chain,\n911\t    pub current_branch: *mut PCRE2_UCHAR,\n912\t}\n913\t\n914\t#[repr(C)]\n915\tpub struct compile_data {\n916\t    pub next: *mut compile_data,\n917\t}\n918\t\n919\t#[repr(C)]\n920\tpub struct class_ranges {\n921\t    pub header: compile_data,\n922\t    pub char_lists_size: usize,\n923\t    pub char_lists_start: usize,\n924\t    pub range_list_size: u16,\n925\t    pub char_lists_types: u16,\n926\t}\n927\t\n928\t#[repr(C)]\n929\tpub struct recurse_arguments {\n930\t    pub header: compile_data,\n931\t    pub size: usize,\n932\t    pub skip_size: usize,\n933\t}\n934\t\n935\t#[repr(C)]\n936\tpub union class_bits_storage {\n937\t    pub classbits: [u8; 32],\n938\t    pub classwords: [u32; 8],\n939\t}\n940\t\n941\t#[repr(C)]\n942\tpub struct compile_block {\n943\t    pub cx: *mut pcre2_real_compile_context,\n944\t    pub lcc: *const u8,\n945\t    pub fcc: *const u8,\n946\t    pub cbits: *const u8,\n947\t    pub ctypes: *const u8,\n948\t    pub start_workspace: *mut PCRE2_UCHAR,\n949\t    pub start_code: *mut PCRE2_UCHAR,\n950\t    pub start_pattern: PCRE2_SPTR,\n951\t    pub end_pattern: PCRE2_SPTR,\n952\t    pub name_table: *mut PCRE2_UCHAR,\n953\t    pub workspace_size: PCRE2_SIZE,\n954\t    pub small_ref_offset: [PCRE2_SIZE; 10],\n955\t    pub erroroffset: PCRE2_SIZE,\n956\t    pub classbits: class_bits_storage,\n957\t    pub names_found: u16,\n958\t    pub name_entry_size: u16,\n959\t    pub parens_depth: u16,\n960\t    pub assert_depth: u16,\n961\t    pub named_groups: *mut named_group,\n962\t    pub named_group_list_size: u32,\n963\t    pub external_options: u32,\n964\t    pub external_flags: u32,\n965\t    pub bracount: u32,\n966\t    pub lastcapture: u32,\n967\t    pub parsed_pattern: *mut u32,\n968\t    pub parsed_pattern_end: *mut u32,\n969\t    pub groupinfo: *mut u32,\n970\t    pub top_backref: u32,\n971\t    pub backref_map: u32,\n972\t    pub nltype: u32,\n973\t    pub nllen: u32,\n974\t    pub nl: [PCRE2_UCHAR; 4],\n975\t    pub class_op_used: [u8; ECLASS_NEST_LIMIT],\n976\t    pub req_varyopt: u32,\n977\t    pub max_varlookbehind: u32,\n978\t    pub max_lookbehind: c_int,\n979\t    pub had_accept: BOOL,\n980\t    pub had_pruneorskip: BOOL,\n981\t    pub had_recurse: BOOL,\n982\t    pub dupnames: BOOL,\n983\t    pub first_data: *mut compile_data,\n984\t    pub last_data: *mut compile_data,\n985\t    pub char_lists_size: usize, // SUPPORT_WIDE_CHARS (8-bit + unicode)\n986\t}\n987\t\n988\tpub type ucp_type_table = UcpTypeTable;\n989\t\n990\t// ---------- Opcodes ----------\n991\tpub const OP_END: u8 = 0;\n992\tpub const OP_SOD: u8 = 1;\n993\tpub const OP_SOM: u8 = 2;\n994\tpub const OP_SET_SOM: u8 = 3;\n995\tpub const OP_NOT_WORD_BOUNDARY: u8 = 4;\n996\tpub const OP_WORD_BOUNDARY: u8 = 5;\n997\tpub const OP_NOT_DIGIT: u8 = 6;\n998\tpub const OP_DIGIT: u8 = 7;\n999\tpub const OP_NOT_WHITESPACE: u8 = 8;\n1000\tpub const OP_WHITESPACE: u8 = 9;\n1001\tpub const OP_NOT_WORDCHAR: u8 = 10;\n1002\tpub const OP_WORDCHAR: u8 = 11;\n1003\tpub const OP_ANY: u8 = 12;\n1004\tpub const OP_ALLANY: u8 = 13;\n1005\tpub const OP_ANYBYTE: u8 = 14;\n1006\tpub const OP_NOTPROP: u8 = 15;\n1007\tpub const OP_PROP: u8 = 16;\n1008\tpub const OP_ANYNL: u8 = 17;\n1009\tpub const OP_NOT_HSPACE: u8 = 18;\n1010\tpub const OP_HSPACE: u8 = 19;\n1011\tpub const OP_NOT_VSPACE: u8 = 20;\n1012\tpub const OP_VSPACE: u8 = 21;\n1013\tpub const OP_EXTUNI: u8 = 22;\n1014\tpub const OP_EODN: u8 = 23