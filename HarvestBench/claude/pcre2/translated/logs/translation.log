tr >= mb->end_subject)\n3358\t            {\n3359\t            SCHECK_PARTIAL();\n3360\t            RRETURN(MATCH_NOMATCH);\n3361\t            }\n3362\t          GETCHARINC(fc, Feptr);\n3363\t          switch(fc)\n3364\t            {\n3365\t            HSPACE_CASES: break;\n3366\t            default: RRETURN(MATCH_NOMATCH);\n3367\t            }\n3368\t          }\n3369\t        break;\n3370\t\n3371\t        case OP_NOT_VSPACE:\n3372\t        for (i = 1; i <= Lmin; i++)\n3373\t          {\n3374\t          if (Feptr >= mb->end_subject)\n3375\t            {\n3376\t            SCHECK_PARTIAL();\n3377\t            RRETURN(MATCH_NOMATCH);\n3378\t            }\n3379\t          GETCHARINC(fc, Feptr);\n3380\t          switch(fc)\n3381\t            {\n3382\t            VSPACE_CASES: RRETURN(MATCH_NOMATCH);\n3383\t            default: break;\n3384\t            }\n3385\t          }\n3386\t        break;\n3387\t\n3388\t        case OP_VSPACE:\n3389\t        for (i = 1; i <= Lmin; i++)\n3390\t          {\n3391\t          if (Feptr >= mb->end_subject)\n3392\t            {\n3393\t            SCHECK_PARTIAL();\n3394\t            RRETURN(MATCH_NOMATCH);\n3395\t            }\n3396\t          GETCHARINC(fc, Feptr);\n3397\t          switch(fc)\n3398\t            {\n3399\t            VSPACE_CASES: break;\n3400\t            default: RRETURN(MATCH_NOMATCH);\n3401\t            }\n3402\t          }\n3403\t        break;\n3404\t\n3405\t        case OP_NOT_DIGIT:\n3406\t        for (i = 1; i <= Lmin; i++)\n3407\t          {\n3408\t          if (Feptr >= mb->end_subject)\n3409\t            {\n3410\t            SCHECK_PARTIAL();\n3411\t            RRETURN(MATCH_NOMATCH);\n3412\t            }\n3413\t          GETCHARINC(fc, Feptr);\n3414\t          if (fc < 128 && (mb->ctypes[fc] & ctype_digit) != 0)\n3415\t            RRETURN(MATCH_NOMATCH);\n3416\t          }\n3417\t        break;\n3418\t\n3419\t        case OP_DIGIT:\n3420\t        for (i = 1; i <= Lmin; i++)\n3421\t          {\n3422\t        