7704\t\n7705\t          PCRE2_SPTR pp1 = NULL;\n7706\t          PCRE2_SPTR pp2 = NULL;\n7707\t          PCRE2_SIZE searchlength = end_subject - start_match;\n7708\t\n7709\t          /* If we haven't got a previously found position for first_cu, or if\n7710\t          the current starting position is later, we need to do a search. If\n7711\t          the code unit is not found, set it to the end. */\n7712\t\n7713\t          if (memchr_found_first_cu == NULL ||\n7714\t              start_match > memchr_found_first_cu)\n7715\t            {\n7716\t            pp1 = memchr(start_match, first_cu, searchlength);\n7717\t            memchr_found_first_cu = (pp1 == NULL)? end_subject : pp1;\n7718\t            }\n7719\t\n7720\t          /* If the start is before a previously found position, use the\n7721\t          previous position, or NULL if a previous search failed. */\n7722\t\n7723\t          else pp1 = (memchr_found_first_cu == end_subject)? NULL :\n7724\t            memchr_found_first_cu;\n7725\t\n7726\t          /* Do the same thing for the other case. */\n7727\t\n7728\t          if (memchr_found_first_cu2 == NULL ||\n7729\t              start_match > memchr_found_first_cu2)\n7730\t            {\n7731\t            pp2 = memchr(start_match, first_cu2, searchlength);\n7732\t            memchr_found_first_cu2 = (pp2 == NULL)? end_subject : pp2;\n7733\t            }\n7734\t\n7735\t          else pp2 = (memchr_found_first_cu2 == end_subject)? NULL :\n7736\t            memchr_found_first_cu2;\n7737\t\n7738\t          /* Set the start to the end of the subject if neither case was found.\n7739\t          Otherwise, use the earlier found point. */\n7740\t\n7741\t          if (pp1 == NULL)\n7742\t            start_match = (pp2 == NULL)? end_subject : pp2;\n7743\t          else\n7744\t            start_match = (pp2 == NULL || pp1 < pp2)? pp1 : pp2;\n7745\t\n7746\t#endif  /* 8-bit handling */\n7747\t          }\n7748\t\n7749\t        /* The caseful case is much simpler. */\n7750\t\n7751\t        else\n7752\t          {\n7753\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7754\t          while (start_match < end_subject && *start_match !=\n7755\t                 first_cu)\n7756\t            start_match++;\n7757\t#else\n7758\t          start_match = memchr(start_match, first_cu, end_subject - start_match);\n7759\t          if (start_match == NULL) start_match = end_subject;\n7760\t#endif\n7761\t          }\n7762\t\n7763\t        /* If we can't find the required first code unit, having reached the\n7764\t        true end of the subject, break the bumpalong loop, to force a match\n7765\t        failure, except when doing partial matching, when we let the next cycle\n7766\t        run at the end of the subject. To see why, consider the pattern\n7767\t        /(?<=abc)def/, which partially matches \"abc\", even though the string\n7768\t        does not contain the starting character \"d\". If we have not reached the\n7769\t        true end of the subject (PCRE2_FIRSTLINE caused end_subject to be\n7770\t        temporarily modified) we also let the cycle run, because the matching\n7771\t        string is legitimately allowed to start with the first code unit of a\n7772\t        newline. */\n7773\t\n7774\t        if (mb->partial == 0 && start_match >= mb->end_subject)\n7775\t          {\n7776\t          rc = MATCH_NOMATCH;\n7777\t          break;\n7778\t          }\n7779\t        }\n7780\t\n7781\t      /* If there's no first code unit, advance to just after a linebreak for a\n7782\t      multiline match if required. */\n7783\t\n7784\t      else if (startline)\n7785\t        {\n7786\t        if (start_match > mb->start_subject + start_offset)\n7787\t          {\n7788\t#ifdef SUPPORT_UNICODE\n7789\t          if (utf)\n7790\t            {\n7791\t            while (start_match < end_subject && !WAS_NEWLINE(start_match))\n7792\t              {\n7793\t              start_match++;\n7794\t              ACROSSCHAR(start_match < end_subject, start_match, start_match++);\n7795\t              }\n7796\t            }\n7797\t          else\n7798\t#endif\n7799\t          while (start_match < end_subject && !WAS_NEWLINE(start_match))\n7800\t            start_match++;\n7801\t\n7802\t          /* If we have just passed a CR and the newline option is ANY or\n7803\t          ANYCRLF, and we are now at a LF, advance the match position by one\n7804\t          more code unit. */\n7805\t\n7806\t          if (start_match[-1] == CHAR_CR &&\n7807\t               (mb->nltype == NLTYPE_ANY || mb->nltype == NLTYPE_ANYCRLF) &&\n7808\t               start_match < end_subject &&\n7809\t               *start_match == CHAR_NL)\n7810\t            start_match++;\n7811\t          }\n7812\t        }\n7813\t\n7814\t      /* If there's no first code unit or a requirement for a multiline line\n7815\t      start, advance to a non-unique first code unit if any have been\n7816\t      identified. The bitmap contains only 256 bits. When code units are 16 or\n7817\t      32 bits wide, all code units greater than 254 set the 255 bit. */\n7818\t\n7819\t      else if (start_bits != NULL)\n7820\t        {\n7821\t        while (start_match < end_subject)\n7822\t          {\n7823\t          uint32_t c = *start_match;\n7824\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7825\t          if (c > 255) c = 255;\n7826\t#endif\n7827\t          if ((start_bits[c/8] & (1u << (c&7))) != 0) break;\n7828\t          start_match++;\n7829\t          }\n7830\t\n7831\t        /* See comment above in first_cu checking about the next few lines. */\n7832\t\n7833\t        if (mb->partial == 0 && start_match >= mb->end_subject)\n7834\t          {\n7835\t          rc = MATCH_NOMATCH;\n7836\t          break;\n7837\t          }\n7838\t        }\n7839\t      }   /* End first code unit handling */\n7840\t\n7841\t    /* Restore fudged end_subject */\n7842\t\n7843\t    end_subject = mb->end_subject;\n7844\t\n7845\t    /* The following two optimizations must be disabled for partial matching. */\n7846\t\n7847\t    if (mb->partial == 0)\n7848\t      {\n7849\t      PCRE2_SPTR p;\n7850\t\n7851\t      /* The minimum matching length is a lower bound; no string of that length\n7852\t      may actually match the pattern. Although the value is, strictly, in\n7853\t      characters, we treat it as code units to avoid spending too much time in\n7854\t      this optimization. */\n7855\t\n7856\t      if (end_subject - start_match < re->minlength)\n7857\t        {\n7858\t        rc = MATCH_NOMATCH;\n7859\t        break;\n7860\t        }\n7861\t\n7862\t      /* If req_cu is set, we know that that code unit must appear in the\n7863\t      subject for the (non-partial) match to succeed. If the first code unit is\n7864\t      set, req_cu must be later in the subject; otherwise the test starts at\n7865\t      the match point. This optimization can save a huge amount of backtracking\n7866\t      in patterns with nested unlimited repeats that aren't going to match.\n7867\t      Writing separate code for caseful/caseless versions makes it go faster,\n7868\t      as does using an autoincrement and backing off on a match. As in the case\n7869\t      of the first code unit, using memchr() in the 8-bit library gives a big\n7870\t      speed up. Unlike the first_cu check above, we do not need to call\n7871\t      memchr() twice in the caseless case because we only need to check for the\n7872\t      presence of the character in either case, not find the first occurrence.\n7873\t\n7874\t      The search can be skipped if the code unit was found later than the\n7875\t      current starting point in a previous iteration of the bumpalong loop.\n7876\t\n7877\t      HOWEVER: when the subject string is very, very long, searching to its end\n7878\t      can take a long time, and give bad performance on quite ordinary\n7879\t      anchored patterns. This showed up when somebody was matching something\n7880\t      like /^\\d+C/ on a 32-megabyte string... so we don't do this when the\n7881\t      string is sufficiently long, but it's worth searching a lot more for\n7882\t      unanchored patterns. */\n7883\t\n7884\t      p = start_match + (has_first_cu? 1:0);\n7885\t      if (has_req_cu && p > req_cu_ptr)\n7886\t        {\n7887\t        PCRE2_SIZE check_length = end_subject - start_match;\n7888\t\n7889\t        if (check_length < REQ_CU_MAX ||\n7890\t              (!anchored && check_length < REQ_CU_MAX * 1000))\n7891\t          {\n7892\t          if (req_cu != req_cu2)  /* Caseless */\n7893\t            {\n7894\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7895\t            while (p < end_subject)\n7896\t              {\n7897\t              uint32_t pp = *p++;\n7898\t              if (pp == req_cu || pp == req_cu2) { p--; break; }\n7899\t              }\n7900\t#else  /* 8-bit code units */\n7901\t            PCRE2_SPTR pp = p;\n7902\t            p = memchr(pp, req_cu, end_subject - pp);\n7903\t            if (p == NULL)\n7904\t              {\n7905\t              p = memchr(pp, req_cu2, end_subject - pp);\n7906\t              if (p == NULL) p = end_subject;\n7907\t              }\n7908\t#endif /* PCRE2_CODE_UNIT_WIDTH != 8 */\n7909\t            }\n7910\t\n7911\t          /* The caseful case */\n7912\t\n7913\t          else\n7914\t            {\n7915\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7916\t            while (p < end_subject)\n7917\t              {\n7918\t              if (*p++ == req_cu) { p--; break; }\n7919\t              }\n7920\t\n7921\t#else  /* 8-bit code units */\n7922\t            p = memchr(p, req_cu, end_subject - p);\n7923\t            if (p == NULL) p = end_subject;\n7924\t#endif\n7925\t            }\n7926\t\n7927\t          /* If we can't find the required code unit, break the bumpalong loop,\n7928\t          forcing a match failure. */\n7929\t\n7930\t          if (p >= end_subject)\n7931\t            {\n7932\t            rc = MATCH_NOMATCH;\n7933\t            break;\n7934\t            }\n7935\t\n7936\t          /* If we have found the required code unit, save the point where we\n7937\t          found it, so that we don't search again next time round the bumpalong\n7938\t          loop if the start hasn't yet passed this code unit. */\n7939\t\n7940\t          req_cu_ptr = p;\n7941\t          }\n7942\t        }\n7943\t      }\n7944\t    }\n7945\t\n7946\t  /* ------------ End of start of match optimizations ------------ */\n7947\t\n7948\t  /* Give no match if we have passed the bumpalong limit. */\n7949\t\n7950\t  if (start_match > bumpalong_limit)\n7951\t    {\n7952\t    rc = MATCH_NOMATCH;\n7953\t    break;\n7954\t    }\n7955\t\n7956\t  /* OK, we can now run the match. If \"hitend\" is set afterwards, remember the\n7957\t  first starting point for which a partial match was found. */\n7958\t\n7959\t  cb.start_match = (PCRE2_SIZE)(start_match - subject);\n7960\t  cb.callout_flags |= PCRE2_CALLOUT_STARTMATCH;\n7961\t\n7962\t  mb->start_used_ptr = start_match;\n7963\t  mb->last_used_ptr = start_match;\n7964\t#ifdef SUPPORT_UNICODE\n7965\t  mb->moptions = options | fragment_options;\n7966\t#else\n7967\t  mb->moptions = options;\n7968\t#endif\n7969\t  mb->match_call_count = 0;\n7970\t  mb->end_offset_top = 0;\n7971\t  mb->skip_arg_count = 0;\n7972\t\n7973\t#ifdef DEBUG_SHOW_OPS\n7974\t  fprintf(stderr, \"++ Calling match()\\n\");\n7975\t#endif\n7976\t\n7977\t  rc = match(start_match, mb->start_code, re->top_bracket, frame_size,\n7978\t    match_data, mb);\n7979\t\n7980\t#ifdef DEBUG_SHOW_OPS\n7981\t  fprintf(stderr, \"++ match() returned %d\\n\\n\", rc);\n7982\t#endif\n7983\t\n7984\t  if (mb->hitend && start_partial == NULL)\n7985\t    {\n7986\t    start_partial = mb->start_used_ptr;\n7987\t    match_partial = start_match;\n7988\t    }\n7989\t\n7990\t  switch(rc)\n7991\t    {\n7992\t    /* If MATCH_SKIP_ARG reaches this level it means that a MARK that matched\n7993\t    the SKIP's arg was not found. In this circumstance, Perl ignores the SKIP\n7994\t    entirely. The only way we can do that is to re-do the match at the same\n7995\t    point, with a flag to force SKIP with an argument to be ignored. Just\n7996\t    treating this case as NOMATCH does not work because it does not check other\n7997\t    alternatives in patterns such as A(*SKIP:A)B|AC when the subject is AC. */\n7998\t\n7999\t    case MATCH_SKIP_ARG:\n8000\t    new_start_match = start_match;\n8001\t    mb->ignore_skip_arg = mb->skip_arg_count;\n8002\t    break;\n8003\t\n8004\t    /* SKIP passes back the next starting point explicitly, but if it is no\n8005\t    greater than the match we have just done, treat it as NOMATCH. */\n8006\t\n8007\t    case MATCH_SKIP:\n8008\t    if (mb->verb_skip_ptr > start_match)\n8009\t      {\n8010\t      new_start_match = mb->verb_skip_ptr;\n8011\t      break;\n8012\t      }\n8013\t    PCRE2_FALLTHROUGH /* Fall through */\n8014\t\n8015\t    /* NOMATCH and PRUNE advance by one character. THEN at this level acts\n8016\t    exactly like PRUNE. Unset ignore SKIP-with-argument. */\n8017\t\n8018\t    case MATCH_NOMATCH:\n8019\t    case MATCH_PRUNE:\n8020\t    case MATCH_THEN:\n8021\t    mb->ignore_skip_arg = 0;\n8022\t    new_start_match = start_match + 1;\n8023\t#ifdef SUPPORT_UNICODE\n8024\t    if (utf)\n8025\t      ACROSSCHAR(new_start_match < end_subject, new_start_match,\n8026\t        new_start_match++);\n8027\t#endif\n8028\t    break;\n8029\t\n8030\t    /* COMMIT disables the bumpalong, but otherwise behaves as NOMATCH. */\n8031\t\n8032\t    case MATCH_COMMIT:\n8033\t    rc = MATCH_NOMATCH;\n8034\t    goto ENDLOOP;\n8035\t\n8036\t    /* Any other return is either a match, or some kind of error. */\n8037\t\n8038\t    default:\n8039\t    goto ENDLOOP;\n8040\t    }\n8041\t\n8042\t  /* Control reaches here for the various types of \"no match at this point\"\n8043\t  result. Reset the code to MATCH_NOMATCH for subsequent checking. */\n8044\t\n8045\t  rc = MATCH_NOMATCH;\n8046\t\n8047\t  /* If PCRE2_FIRSTLINE is set, the match must happen before or at the first\n8048\t  newline in the subject (though it may continue over the newline). Therefore,\n8049\t  if we have just failed to match, starting at a newline, do not continue. */\n8050\t\n8051\t  if (firstline && IS_NEWLINE(start_match)) break;\n8052\t\n8053\t  /* Advance to new matching position */\n8054\t\n8055\t  start_match = new_start_match;\n8056\t\n8057\t  /* Break the loop if the pattern is anchored or if we have passed the end of\n8058\t  the subject. */\n8059\t\n8060\t  if (anchored || start_match > end_subject) break;\n8061\t\n8062\t  /* If we have just passed a CR and we are now at a LF, and the pattern does\n8063\t  not contain any explicit matches for \\r or \\n, and the newline option is CRLF\n8064\t  or ANY or ANYCRLF, advance the match position by one more code unit. In\n8065\t  normal matching start_match will aways be greater than the first position at\n8066\t  this stage, but a failed *SKIP can cause a return at the same point, which is\n8067\t  why the first test exists. */\n8068\t\n8069\t  if (start_match > subject + start_offset &&\n8070\t      start_match[-1] == CHAR_CR &&\n8071\t      start_match < end_subject &&\n8072\t      *start_match == CHAR_NL &&\n8073\t      (re->flags & PCRE2_HASCRORLF) == 0 &&\n8074\t        (mb->nltype == NLTYPE_ANY ||\n8075\t         mb->nltype == NLTYPE_ANYCRLF ||\n8076\t         mb->nllen == 2))\n8077\t    start_match++;\n8078\t\n8079\t  mb->mark = NULL;   /* Reset for start of next match attempt */\n8080\t  }                  /* End of for(;;) \"bumpalong\" loop */\n8081\t\n8082\t/* ==========================================================================*/\n8083\t\n8084\t/* When we reach here, one of the following stopping conditions is true:\n8085\t\n8086\t(1) The match succeeded, either completely, or partially;\n8087\t\n8088\t(2) The pattern is anchored or the match was failed after (*COMMIT);\n8089\t\n8090\t(3) We are past the end of the subject or the bumpalong limit;\n8091\t\n8092\t(4) PCRE2_FIRSTLINE is set and we have failed to match at a newline, because\n8093\t    this option requests that a match occur at or before the first newline in\n8094\t    the subject.\n8095\t\n8096\t(5) Some kind of error occurred.\n8097\t\n8098\t*/\n8099\t\n8100\tENDLOOP:\n8101\t\n8102\t/* If end_subject != true_end_subject, it means we are handling invalid UTF,\n8103\tand have just processed a non-terminal fragment. If this resulted in no match\n8104\tor a partial match we must carry on to the next fragment (a partial match is\n8105\treturned to the caller only at the very end of the subject). A loop is used to\n8106\tavoid trying to match against empty fragments; if the pattern can match an\n8107\tempty string it would have done so already. */\n8108\t\n8109\t#ifdef SUPPORT_UNICODE\n8110\tif (utf && end_subject != true_end_subject &&\n8111\t    (rc == MATCH_NOMATCH || rc == PCRE2_ERROR_PARTIAL))\n8112\t  {\n8113\t  for (;;)\n8114\t    {\n8115\t    /* Advance past the first bad code unit, and then skip invalid character\n8116\t    starting code units in 8-bit and 16-bit modes. */\n8117\t\n8118\t    start_match = end_subject + 1;\n8119\t\n8120\t#if PCRE2_CODE_UNIT_WIDTH != 32\n8121\t    while (start_match < true_end_subject && NOT_FIRSTCU(*start_match))\n8122\t      start_match++;\n8123\t#endif\n8124\t\n8125\t    /* If we have hit the end of the subject, there isn't another non-empty\n8126\t    fragment, so give up. */\n8127\t\n8128\t    if (start_match >= true_end_subject)\n8129\t      {\n8130\t      rc = MATCH_NOMATCH;  /* In case it was partial */\n8131\t      match_partial = NULL;\n8132\t      break;\n8133\t      }\n8134\t\n8135\t    /* Check the rest of the subject */\n8136\t\n8137\t    mb->check_subject = start_match;\n8138\t    rc = PRIV(valid_utf)(start_match, length - (start_match - subject),\n8139\t      &(match_data->startchar));\n8140\t\n8141\t    /* The rest of the subject is valid UTF. */\n8142\t\n8143\t    if (rc == 0)\n8144\t      {\n8145\t      mb->end_subject = end_subject = true_end_subject;\n8146\t      fragment_options = PCRE2_NOTBOL;\n8147\t      goto FRAGMENT_RESTART;\n8148\t      }\n8149\t\n8150\t    /* A subsequent UTF error has been found; if the next fragment is\n8151\t    non-empty, set up to process it. Otherwise, let the loop advance. */\n8152\t\n8153\t    else if (rc < 0)\n8154\t      {\n8155\t      mb->end_subject = end_subject = start_match + match_data->startchar;\n8156\t      if (end_subject > start_match)\n8157\t        {\n8158\t        fragment_options = PCRE2_NOTBOL|PCRE2_NOTEOL;\n8159\t        goto FRAGMENT_RESTART;\n8160\t        }\n8161\t      }\n8162\t    }\n8163\t  }\n8164\t#endif  /* SUPPORT_UNICODE */\n8165\t\n8166\t/* Fill in fields that are always returned in the match data. */\n8167\t\n8168\tmatch_data->code = re;\n8169\tmatch_data->mark = mb->mark;\n8170\tmatch_data->matchedby = PCRE2_MATCHEDBY_INTERPRETER;\n8171\tmatch_data->options = original_options;\n8172\t\n8173\t/* Handle a fully successful match. Set the return code to the number of\n8174\tcaptured strings, or 0 if there were too many to fit into the ovector, and then\n8175\tset the remaining returned values before returning. Make a copy of the subject\n8176\tstring if requested. */\n8177\t\n8178\tif (rc == MATCH_MATCH)\n8179\t  {\n8180\t  match_data->rc = ((int)mb->end_offset_top >= 2 * match_data->oveccount)?\n8181\t    0 : (int)mb->end_offset_top/2 + 1;\n8182\t  match_data->subject_length = length;\n8183\t  match_data->start_offset = start_offset;\n8184\t  match_data->startchar = start_match - subject;\n8185\t  match_data->leftchar = mb->start_used_ptr - subject;\n8186\t  match_data->rightchar = ((mb->last_used_ptr > mb->end_match_ptr)?\n8187\t    mb->last_used_ptr : mb->end_match_ptr) - subject;\n8188\t  if ((options & PCRE2_COPY_MATCHED_SUBJECT) != 0)\n8189\t    {\n8190\t    if (length != 0)\n8191\t      {\n8192\t      match_data->subject = match_data->memctl.malloc(CU2BYTES(length),\n8193\t        match_data->memctl.memory_data);\n8194\t      if (match_data->subject == NULL)\n8195\t        return match_data->rc = PCRE2_ERROR_NOMEMORY;\n8196\t      memcpy((void *)match_data->subject, subject, CU2BYTES(length));\n8197\t      }\n8198\t    else\n8199\t      match_data->subject = NULL;\n8200\t    match_data->flags |= PCRE2_MD_COPIED_SUBJECT;\n8201\t    }\n8202\t  else match_data->subject = original_subject;\n8203\t\n8204\t  return match_data->rc;\n8205\t  }\n8206\t\n8207\t/* Control gets here if there has been a partial match, an error, or if the\n8208\toverall match attempt has failed at all permitted starting positions. Any mark\n8209\tdata is in the nomatch_mark field. */\n8210\t\n8211\tmatch_data->mark = mb->nomatch_mark;\n8212\t\n8213\t/* For anything other than nomatch or partial match, just return the code. */\n8214\t\n8215\tif (rc != MATCH_NOMATCH && rc != PCRE2_ERROR_PARTIAL) match_data->rc = rc;\n8216\t\n8217\t/* Handle a partial match. If a \"soft\" partial match was requested, searching\n8218\tfor a complete match will have continued, and the value of rc at this point\n8219\twill be MATCH_NOMATCH. For a \"hard\" partial match, it will already be\n8220\tPCRE2_ERROR_PARTIAL. */\n8221\t\n8222\telse if (match_partial != NULL)\n8223\t  {\n8224\t  match_data->subject = original_subject;\n8225\t  match_data->subject_length = length;\n8226\t  match_data->start_offset = start_offset;\n8227\t  match_data->ovector[0] = match_partial - subject;\n8228\t  match_data->ovector[1] = end_subject - subject;\n8229\t  match_data->startchar = match_partial - subject;\n8230\t  match_data->leftchar = start_partial - subject;\n8231\t  match_data->rightchar = end_subject - subject;\n8232\t  match_data->rc = PCRE2_ERROR_PARTIAL;\n8233\t  }\n8234\t\n8235\t/* Else this is the classic nomatch case. */\n8236\t\n8237\telse\n8238\t  {\n8239\t  match_data->subject = original_subject;\n8240\t  match_data->subject_length = length;\n8241\t  match_data->start_offset = start_offset;\n8242\t  match_data->rc = PCRE2_ERROR_NOMATCH;\n8243\t  }\n8244\t\n8245\treturn match_data->rc;\n8246\t}\n8247\t\n8248\t/* These #undefs are here to enable unity builds with CMake. */\n8249\t\n8250\t#undef NLBLOCK /* Block containing newline information */\n8251\t#undef PSSTART /* Field containing processed string start */\n8252\t#undef PSEND   /* Field containing processed string end */\n8253\t\n8254\t/* End of pcre2_match.c */\n8255\t"}]},"parent_tool_use_id":"toolu_bdrk_011sP9qjwaBYtkHUTcUFWYin","session_id":"f08167af-b65d-45d4-8780-bbe04557b3d8","uuid":"f924cad5-58c7-4c80-bc32-2db852a468cb","timestamp":"2026-08-05T04:27:54.697Z","subagent_type":"general-purpose","task_description":"Translate pcre2_match.c"}
