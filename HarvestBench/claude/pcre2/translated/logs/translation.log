PROCUREMENT OF\n33\tSUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\n34\tINTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\n35\tCONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\n36\tARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE\n37\tPOSSIBILITY OF SUCH DAMAGE.\n38\t-----------------------------------------------------------------------------\n39\t*/\n40\t\n41\t#ifndef PCRE2_COMPILE_H_IDEMPOTENT_GUARD\n42\t#define PCRE2_COMPILE_H_IDEMPOTENT_GUARD\n43\t\n44\t#include \"pcre2_internal.h\"\n45\t\n46\t/* Compile time error code numbers. They are given names so that they can more\n47\teasily be tracked. When a new number is added, the tables called eint1 and\n48\teint2 in pcre2posix.c may need to be updated, and a new error text must be\n49\tadded to compile_error_texts in pcre2_error.c. Also, the error codes in\n50\tpcre2.h.in must be updated - their values are exactly 100 greater than these\n51\tvalues. */\n52\t\n53\tenum { ERR0 = COMPILE_ERROR_BASE,\n54\t       ERR1,   ERR2,   ERR3,   ERR4,   ERR5,   ERR6,   ERR7,   ERR8,   ERR9,   ERR10,\n55\t       ERR11,  ERR12,  ERR13,  ERR14,  ERR15,  ERR16,  ERR17,  ERR18,  ERR19,  ERR20,\n56\t       ERR21,  ERR22,  ERR23,  ERR24,  ERR25,  ERR26,  ERR27,  ERR28,  ERR29,  ERR30,\n57\t       ERR31,  ERR32,  ERR33,  ERR34,  ERR35,  ERR36,  ERR37,  ERR38,  ERR39,  ERR40,\n58\t       ERR41,  ERR42,  ERR43,  ERR44,  ERR45,  ERR46,  ERR47,  ERR48,  ERR49,  ERR50,\n59\t       ERR51,  ERR52,  ERR53,  ERR54,  ERR55,  ERR56,  ERR57,  ERR58,  ERR59,  ERR60,\n60\t       ERR61,  ERR62,  ERR63,  ERR64,  ERR65,  ERR66,  ERR67,  ERR68,  ERR69,  ERR70,\n61\t       ERR71,  ERR72,  ERR73,  ERR74,  ERR75,  ERR76,  ERR77,  ERR78,  ERR79,  ERR80,\n62\t       ERR81,  ERR82,  ERR83,  ERR84,  ERR85,  ERR86,  ERR87,  ERR88,  ERR89,  ERR90,\n63\t       ERR91,  ERR92,  ERR93,  ERR94,  ERR95,  ERR96,  ERR97,  ERR98,  ERR99,  ERR100,\n64\t       ERR101, ERR102, ERR103, ERR104, ERR105, ERR106, ERR107, ERR108, ERR109, ERR110,\n65\t       ERR111, ERR112, ERR113, ERR114, ERR115, ERR116, ERR117, ERR118, ERR119, ERR120 };\n66\t\n67\t/* Code values for parsed patterns, which are stored in a vector of 32-bit\n68\tunsigned ints. Values less than META_END are literal data values. The coding\n69\tfor identifying the item is in the top 16-bits, leaving 16 bits for the\n70\tadditional data that some of them need. The META_CODE, META_DATA, and META_DIFF\n71\tmacros are used to manipulate parsed pattern elements.\n72\t\n73\tNOTE: When these definitions are changed, the table of extra lengths for each\n74\tcode (meta_extra_lengths) must be updated to remain in step. */\n75\t\n76\t#define META_END              0x80000000u  /* End of pattern */\n77\t\n78\t#define META_ALT              0x80010000u  /* alternation */\n79\t#define META_ATOMIC           0x80020000u  /* atomic group */\n80\t#define META_BACKREF          0x80030000u  /* Back ref */\n81\t#define META_BACKREF_BYNAME   0x80040000u  /* \\k'name' */\n82\t#define META_BIGVALUE         0x80050000u  /* Next is a literal > META_END */\n83\t#define META_CALLOUT_NUMBER   0x80060000u  /* (?C with numerical argument */\n84\t#define META_CALLOUT_STRING   0x80070000u  /* (?C with string argument */\n85\t#define META_CAPTURE          0x80080000u  /* Capturing parenthesis */\n86\t#define META_CIRCUMFLEX       0x80090000u  /* ^ metacharacter */\n87\t#define META_CLASS            0x800a0000u  /* start non-empty class */\n88\t#define META_CLASS_EMPTY      0x800b0000u  /* empty class */\n89\t#define META_CLASS_EMPTY_NOT  0x800c0000u  /* negative empty class */\n90\t#define META_CLASS_END        0x800d0000u  /* end of non-empty class */\n91\t#define META_CLASS_NOT        0x800e0000u  /* start non-empty negative class */\n92\t#define META_COND_ASSERT      0x800f0000u  /* (?(?assertion)... */\n93\t#define META_COND_DEFINE      0x80100000u  /* (?(DEFINE)... */\n94\t#define META_COND_NAME        0x80110000u  /* (?(<name>)... */\n95\t#define META_COND_NUMBER      0x80120000u  /* (?(digits)... */\n96\t#define META_COND_RNAME       0x80130000u  /* (?(R&name)... */\n97\t#define META_COND_RNUMBER     0x80140000u  /* (?(Rdigits)... */\n98\t#define META_COND_VERSION     0x80150000u  /* (?(VERSION<op>x.y)... */\n99\t#define META_OFFSET           0x80160000u  /* Setting offset for various META\n100\t                                              codes (e.g. META_CAPTURE_NAME) */\n101\t#define META_SCS              0x80170000u  /* (*scan_substring:... */\n102\t#define META_CAPTURE_NAME     0x80180000u  /* Next <name> in capture lists */\n103\t#define META_CAPTURE_NUMBER   0x80190000u  /* Next digits in capture lists */\n104\t#define META_DOLLAR           0x801a0000u  /* $ metacharacter */\n105\t#define META_DOT              0x801b0000u  /* . metacharacter */\n106\t#define META_ESCAPE           0x801c0000u  /* \\d and friends */\n107\t#define META_KET              0x801d0000u  /* closing parenthesis */\n108\t#define META_NOCAPTURE        0x801e0000u  /* no capture parens */\n109\t#define META_OPTIONS          0x801f0000u  /* (?i) and friends */\n110\t#define META_POSIX            0x80200000u  /* POSIX class item */\n111\t#define META_POSIX_NEG        0x80210000u  /* negative POSIX class item */\n112\t#define META_RANGE_ESCAPED    0x80220000u  /* range with at least one escape */\n113\t#define META_RANGE_LITERAL    0x80230000u  /* range defined literally */\n114\t#define META_RECURSE          0x80240000u  /* Recursion */\n115\t#define META_RECURSE_BYNAME   0x80250000u  /* (?&name) */\n116\t#define META_SCRIPT_RUN       0x80260000u  /* (*script_run:...) */\n117\t\n118\t/* These must be kept together to make it easy to check that an assertion\n119\tis present where expected in a conditional group. */\n120\t\n121\t#define META_LOOKAHEAD        0x80270000u  /* (?= */\n122\t#define META_LOOKAHEADNOT     0x80280000u  /* (?! */\n123\t#define META_LOOKBEHIND       0x80290000u  /* (?<= */\n124\t#define META_LOOKBEHINDNOT    0x802a0000u  /* (?<! */\n125\t\n126\t/* These cannot be conditions */\n127\t\n128\t#define META_LOOKAHEAD_NA     0x802b0000u  /* (*napla: */\n129\t#define META_LOOKBEHIND_NA    0x802c0000u  /* (*naplb: */\n130\t\n131\t/* These must be kept in this order, with consecutive values, and the _ARG\n132\tversions of COMMIT, PRUNE, SKIP, and THEN immediately after their non-argument\n133\tversions. */\n134\t\n135\t#define META_MARK             0x802d0000u  /* (*MARK) */\n136\t#define META_ACCEPT           0x802e0000u  /* (*ACCEPT) */\n137\t#define META_FAIL             0x802f0000u  /* (*FAIL) */\n138\t#define META_COMMIT           0x80300000u  /* These               */\n139\t#define META_COMMIT_ARG       0x80310000u  /*   pairs             */\n140\t#define META_PRUNE            0x80320000u  /*     must            */\n141\t#define META_PRUNE_ARG        0x80330000u  /*       be            */\n142\t#define META_SKIP             0x80340000u  /*         kept        */\n143\t#define META_SKIP_ARG         0x80350000u  /*           in        */\n144\t#define META_THEN             0x80360000u  /*             this    */\n145\t#define META_THEN_ARG         0x80370000u  /*               order */\n146\t\n147\t/* These must be kept in groups of adjacent 3 values, and all together. */\n148\t\n149\t#define META_ASTERISK         0x80380000u  /* *  */\n150\t#define META_ASTERISK_PLUS    0x80390000u  /* *+ */\n151\t#define META_ASTERISK_QUERY   0x803a0000u  /* *? */\n152\t#define META_PLUS             0x803b0000u  /* +  */\n153\t#define META_PLUS_PLUS        0x803c0000u  /* ++ */\n154\t#define META_PLUS_QUERY       0x803d0000u  /* +? */\n155\t#define META_QUERY            0x803e0000u  /* ?  */\n156\t#define META_QUERY_PLUS       0x803f0000u  /* ?+ */\n157\t#define META_QUERY_QUERY      0x80400000u  /* ?? */\n158\t#define META_MINMAX           0x80410000u  /* {n,m}  repeat */\n159\t#define META_MINMAX_PLUS      0x80420000u  /* {n,m}+ repeat */\n160\t#define META_MINMAX_QUERY     0x80430000u  /* {n,m}? repeat */\n161\t\n162\t/* These meta codes must be kept in a group, with the OR/SUB/XOR in\n163\tthis order, and AND/NOT at the start/end. */\n164\t\n165\t#define META_ECLASS_AND       0x80440000u  /* && (or &) in a class */\n166\t#define META_ECLASS_OR        0x80450000u  /* || (or |, +) in a class */\n167\t#define META_ECLASS_SUB       0x80460000u  /* -- (or -) in a class */\n168\t#define META_ECLASS_XOR       0x80470000u  /* ~~ (or ^) in a class */\n169\t#define META_ECLASS_NOT       0x80480000u  /* ! in a class */\n170\t\n171\t/* Convenience aliases. */\n172\t\n173\t#define META_FIRST_QUANTIFIER META_ASTERISK\n174\t#define META_LAST_QUANTIFIER  META_MINMAX_QUERY\n175\t\n176\t/* This is a special \"meta code\" that is used only to distinguish (*asr: from\n177\t(*sr: in the table of alphabetic assertions. It is never stored in the parsed\n178\tpattern because (*asr: is turned into (*sr:(*atomic: at that stage. There is\n179\ttherefore no need for it to have a length entry, so use a high value. */\n180\t\n181\t#define META_ATOMIC_SCRIPT_RUN 0x8fff0000u\n182\t\n183\t/* Macros for manipulating elements of the parsed pattern vector. */\n184\t\n185\t#define META_CODE(x)   (x & 0xffff0000u)\n186\t#define META_DATA(x)   (x & 0x0000ffffu)\n187\t#define META_DIFF(x,y) ((x-y)>>16)\n188\t\n189\t/* Macros to store and retrieve a PCRE2_SIZE value in the parsed pattern, which\n190\tconsists of uint32_t elements. Assume that if uint32_t can't hold it, two of\n191\tthem will be able to (i.e. assume a 64-bit world). */\n192\t\n193\t#if PCRE2_SIZE_MAX <= UINT32_MAX\n194\t#define PUTOFFSET(s,p) *p++ = s\n195\t#define GETOFFSET(s,p) s = *p++\n196\t#define GETPLUSOFFSET(s,p) s = *(++p)\n197\t#define READPLUSOFFSET(s,p) s = p[1]\n198\t#define SKIPOFFSET(p) p++\n199\t#define SIZEOFFSET 1\n200\t#else\n201\t#define PUTOFFSET(s,p) \\\n202\t  { *p++ = (uint32_t)(s >> 32); *p++ = (uint32_t)(s & 0xffffffff); }\n203\t#define GETOFFSET(s,p) \\\n204\t  { s = ((PCRE2_SIZE)p[0] << 32) | (PCRE2_SIZE)p[1]; p += 2; }\n205\t#define GETPLUSOFFSET(s,p) \\\n206\t  { s = ((PCRE2_SIZE)p[1] << 32) | (PCRE2_SIZE)p[2]; p += 2; }\n207\t#define READPLUSOFFSET(s,p) \\\n208\t  { s = ((PCRE2_SIZE)p[1] << 32) | (PCRE2_SIZE)p[2]; }\n209\t#define SKIPOFFSET(p) p += 2\n210\t#define SIZEOFFSET 2\n211\t#endif\n212\t\n213\t#ifdef PCRE2_DEBUG\n214\t/* Compile data types. */\n215\t#define CDATA_RECURSE_ARGS       0 /* Argument list for recurse */\n216\t#define CDATA_CRANGE             1 /* Character range list */\n217\t#endif\n218\t\n219\t/* Extended class management flags. */\n220\t\n221\t#define CLASS_IS_ECLASS 0x1\n222\t\n223\t/* Macro for the highest character value. */\n224\t\n225\t#if PCRE2_CODE_UNIT_WIDTH == 8\n226\t#define MAX_UCHAR_VALUE 0xffu\n227\t#elif PCRE2_CODE_UNIT_WIDTH == 16\n228\t#define MAX_UCHAR_VALUE 0xffffu\n229\t#else\n230\t#define MAX_UCHAR_VALUE 0xffffffffu\n231\t#endif\n232\t\n233\t#define GET_MAX_CHAR_VALUE(utf) \\\n234\t  ((utf) ? MAX_UTF_CODE_POINT : MAX_UCHAR_VALUE)\n235\t\n236\t/* Macro for setting individual bits in class bitmaps. */\n237\t\n238\t#define SETBIT(a,b) a[(b) >> 3] |= (uint8_t)(1u << ((b) & 0x7))\n239\t\n240\t/* Macro for 8 bit specific checks. */\n241\t#if PCRE2_CODE_UNIT_WIDTH == 8\n242\t#define SELECT_VALUE8(value8, value) (value8)\n243\t#else\n244\t#define SELECT_VALUE8(value8, value) (value)\n245\t#endif\n246\t\n247\t/* Macro for aligning data. */\n248\t#define CLIST_ALIGN_TO(base, align) \\\n249\t  ((base + ((size_t)(align) - 1)) & ~((size_t)(align) - 1))\n250\t\n251\t/* Structure for holding information about an OP_ECLASS internal operand.\n252\tAn \"operand\" here could be just a single OP_[X]CLASS, or it could be some\n253\tcomplex expression; but it's some sequence of ECL_* codes which pushes one\n254\tvalue to the stack. */\n255\ttypedef struct {\n256\t  /* The position of the operand - or NULL if (lengthptr != NULL). */\n257\t  PCRE2_UCHAR *code_start;\n258\t  PCRE2_SIZE length;\n259\t  /* The operand's type if it is a single code (ECL_XCLASS, ECL_ANY, ECL_NONE);\n260\t  otherwise zero if the operand is not atomic. */\n261\t  uint8_t op_single_type;\n262\t  /* Regardless of whether it's a single code or not, we fully constant-fold\n263\t  the bitmap for code points < 256. */\n264\t  class_bits_storage bits;\n265\t} eclass_op_info;\n266\t\n267\t/* Macros for the definitions below, to prevent name collisions. */\n268\t\n269\t#define _pcre2_posix_class_maps                PCRE2_SUFFIX(_pcre2_posix_class_maps)\n270\t#define _pcre2_update_classbits                PCRE2_SUFFIX(_pcre2_update_classbits_)\n271\t#define _pcre2_compile_class_nested            PCRE2_SUFFIX(_pcre2_compile_class_nested_)\n272\t#define _pcre2_compile_class_not_nested        PCRE2_SUFFIX(_pcre2_compile_class_not_nested_)\n273\t#define _pcre2_compile_get_hash_from_name      PCRE2_SUFFIX(_pcre2_compile_get_hash_from_name)\n274\t#define _pcre2_compile_find_named_group        PCRE2_SUFFIX(_pcre2_compile_find_named_group)\n275\t#define _pcre2_compile_find_dupname_details    PCRE2_SUFFIX(_pcre2_compile_find_dupname_details)\n276\t#define _pcre2_compile_add_name_to_table       PCRE2_SUFFIX(_pcre2_compile_add_name_to_table)\n277\t#define _pcre2_compile_parse_scan_substr_args  PCRE2_SUFFIX(_pcre2_compile_parse_scan_substr_args)\n278\t#define _pcre2_compile_parse_recurse_args      PCRE2_SUFFIX(_pcre2_compile_parse_recurse_args)\n279\t\n280\t\n281\t/* Indices of the POSIX classes in posix_names, posix_name_lengths,\n282\tposix_class_maps, and posix_substitutes. They must be kept in sync. */\n283\t\n284\t#define PC_DIGIT   7\n285\t#define PC_GRAPH   8\n286\t#define PC_PRINT   9\n287\t#define PC_PUNCT  10\n288\t#define PC_XDIGIT 13\n289\t\n290\textern const int PRIV(posix_class_maps)[];\n291\t\n292\t/* Defines for hash_dup member in named_group structure. */\n293\t\n294\t#define NAMED_GROUP_HASH_MASK      ((uint16_t)0x7fff)\n295\t#define NAMED_GROUP_IS_DUPNAME     ((uint16_t)0x8000)\n296\t\n297\t#define NAMED_GROUP_GET_HASH(ng)   ((ng)->hash_dup & NAMED_GROUP_HASH_MASK)\n298\t\n299\t/* Exported functions from pcre2_compile_class.c file: */\n300\t\n301\t/* Set bits in classbits according to the property type */\n302\t\n303\tvoid PRIV(update_classbits)(uint32_t ptype, uint32_t pdata, BOOL negated,\n304\t  uint8_t *classbits);\n305\t\n306\t/* Compile the META codes from start_ptr...end_ptr, writing a single OP_CLASS\n307\tOP_CLASS, OP_NCLASS, OP_XCLASS, or OP_ALLANY into pcode. */\n308\t\n309\tuint32_t *PRIV(compile_class_not_nested)(uint32_t options, uint32_t xoptions,\n310\t  uint32_t *start_ptr, PCRE2_UCHAR **pcode, BOOL negate_class, BOOL* has_bitmap,\n311\t  int *errorcodeptr, compile_block *cb, PCRE2_SIZE *lengthptr);\n312\t\n313\t/* Compile the META codes in pptr into opcodes written to pcode. The pptr must\n314\tstart at a META_CLASS or META_CLASS_NOT.\n315\t\n316\tThe pptr will be left pointing at the matching META_CLASS_END. */\n317\t\n318\tBOOL PRIV(compile_class_nested)(uint32_t options, uint32_t xoptions,\n319\t  uint32_t **pptr, PCRE2_UCHAR **pcode, int *errorcodeptr,\n320\t  compile_block *cb, PCRE2_SIZE *lengthptr);\n321\t\n322\t/* Exported functions from pcre2_compile_cgroup.c file: */\n323\t\n324\t/* Compute hash from a capture name. */\n325\t\n326\tuint16_t PRIV(compile_get_hash_from_name)(PCRE2_SPTR name, uint32_t length);\n327\t\n328\t/* Get the descriptor of a known named capture. */\n329\t\n330\tnamed_group *PRIV(compile_find_named_group)(PCRE2_SPTR name,\n331\t  uint32_t length, compile_block *cb);\n332\t\n333\t/* Add entires to name table in alphabetical order. */\n334\t\n335\tuint32_t PRIV(compile_add_name_to_table)(compile_block *cb,\n336\t  named_group *ng, uint32_t tablecount);\n337\t\n338\t/* Searches the properties of duplicated names, and returns them\n339\tin indexptr and countptr. */\n340\t\n341\tBOOL PRIV(compile_find_dupname_details)(PCRE2_SPTR name, uint32_t length,\n342\t  int *indexptr, int *countptr, int *errorcodeptr, compile_block *cb);\n343\t\n344\t/* Parse the arguments of recurse operations. */\n345\t\n346\tuint32_t * PRIV(compile_parse_scan_substr_args)(uint32_t *pptr,\n347\t  int *errorcodeptr, compile_block *cb, PCRE2_SIZE *lengthptr);\n348\t\n349\t/* Parse the arguments of recurse operations. */\n350\t\n351\tBOOL PRIV(compile_parse_recurse_args)(uint32_t *pptr_start,\n352\t  PCRE2_SIZE offset, int *errorcodeptr, compile_block *cb);\n353\t\n354\t#endif  /* PCRE2_COMPILE_H_IDEMPOTENT_GUARD */\n355\t\n356\t/* End of pcre2_compile.h */\n357\t"}]},"parent_tool_use_id":"toolu_bdrk_018sGBdYTKomBfwYi5YVoSuD","session_id":"f08167af-b65d-45d4-8780-bbe04557b3d8","uuid":"b6a5868a-1e49-434d-9e67-c0d4ccd384be","timestamp":"2026-08-05T04:18:31.432Z","subagent_type":"general-purpose","task_description":"Translate pcre2_compile_class.c"}
