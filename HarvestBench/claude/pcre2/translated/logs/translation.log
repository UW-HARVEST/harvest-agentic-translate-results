1];\n1274\t    tabopt = PRIV(posix_class_maps)[posix_class + 2];\n1275\t\n1276\t    if (taboffset >= 0)\n1277\t      {\n1278\t      if (tabopt >= 0)\n1279\t        for (int i = 0; i < 32; i++)\n1280\t          pbits.classbits[i] |= cbits[i + taboffset];\n1281\t      else\n1282\t        for (int i = 0; i < 32; i++)\n1283\t          pbits.classbits[i] &= (uint8_t)(~cbits[i + taboffset]);\n1284\t      }\n1285\t\n1286\t    /* Now see if we need to remove any special characters. An option\n1287\t    value of 1 removes vertical space and 2 removes underscore. */\n1288\t\n1289\t    if (tabopt < 0) tabopt = -tabopt;\n1290\t#ifdef EBCDIC\n1291\t      {\n1292\t      uint8_t posix_vertical[4] = { CHAR_LF, CHAR_VT, CHAR_FF, CHAR_CR };\n1293\t      uint8_t posix_underscore = CHAR_UNDERSCORE;\n1294\t      uint8_t *chars = NULL;\n1295\t      int n = 0;\n1296\t\n1297\t      if (tabopt == 1) { chars = posix_vertical; n = 4; }\n1298\t      else if (tabopt == 2) { chars = &posix_underscore; n = 1; }\n1299\t\n1300\t      for (; n > 0; ++chars, --n)\n1301\t        pbits.classbits[*chars/8] &= ~(1u << (*chars&7));\n1302\t      }\n1303\t#else\n1304\t    if (tabopt == 1) pbits.classbits[1] &= ~0x3c;\n1305\t    else if (tabopt == 2) pbits.classbits[11] &= 0x7f;\n1306\t#endif\n1307\t\n1308\t    /* Add the POSIX table or its complement into the main table that is\n1309\t    being built and we are done. */\n1310\t\n1311\t      {\n1312\t      uint32_t *classwords = cb->classbits.classwords;\n1313\t\n1314\t      if (local_negate)\n1315\t        for (int i = 0; i < 8; i++)\n1316\t          classwords[i] |= (uint32_t)(~pbits.classwords[i]);\n1317\t      else\n1318\t        for (int i = 0; i < 8; i++)\n1319\t          classwords[i] |= pbits.classwords[i];\n1320\t      }\n1321\t\n1322\t#ifdef SUPPORT_WIDE_CHARS\n1323\t    /* Every class contains at least one < 256 character. */\n1324\t    xclass_props |= XCLASS_HAS_8BIT_CHARS;\n1325\t#endif\n1326\t    continue;               /* End of POSIX handling