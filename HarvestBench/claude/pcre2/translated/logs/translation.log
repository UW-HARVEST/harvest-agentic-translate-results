   case PSO_OPTMZ:\n10561\t          optim_flags &= ~(p->value);\n10562\t\n10563\t          /* For backward compatibility the three original VERBs to disable\n10564\t          optimizations need to also update the corresponding bit in the\n10565\t          external options. */\n10566\t\n10567\t          switch(p->value)\n10568\t            {\n10569\t            case PCRE2_OPTIM_AUTO_POSSESS:\n10570\t            cb.external_options |= PCRE2_NO_AUTO_POSSESS;\n10571\t            break;\n10572\t\n10573\t            case PCRE2_OPTIM_DOTSTAR_ANCHOR:\n10574\t            cb.external_options |= PCRE2_NO_DOTSTAR_ANCHOR;\n10575\t            break;\n10576\t\n10577\t            case PCRE2_OPTIM_START_OPTIMIZE:\n10578\t            cb.external_options |= PCRE2_NO_START_OPTIMIZE;\n10579\t            break;\n10580\t            }\n10581\t\n10582\t          break;\n10583\t\n10584\t          /* LCOV_EXCL_START */\n10585\t          default:\n10586\t          /* All values in the enum need an explicit entry for this switch\n10587\t          but until a better way to prevent coding mistakes is invented keep\n10588\t          a catch all that triggers a debug build assert as a failsafe */\n10589\t          PCRE2_DEBUG_UNREACHABLE();\n10590\t          /* LCOV_EXCL_STOP */\n10591\t          }\n10592\t        break;   /* Out of the table scan loop */\n10593\t        }\n10594\t      }\n10595\t    if (i >= sizeof(pso_list)/sizeof(pso)) break;   /* Out of pso loop */\n10596\t    }\n10597\t    PCRE2_ASSERT(skipatstart <= patlen);\n10598\t  }\n10599\t\n10600\t/* End of pattern-start options; advance to start of real regex. */\n10601\t\n10602\tptr += skipatstart;\n10603\t\n10604\t/* Can't support UTF or UCP if PCRE2 was built without Unicode support. */\n10605\t\n10606\t#ifndef SUPPORT_UNICODE\n10607\tif ((cb.external_options & (PCRE2_UTF|PCRE2_UCP)) != 0)\n10608\t  {\n10609\t  errorcode = ERR32;\n10610\t  goto HAD_EARLY_ERROR;\n10611\t  }\n10612\t#endif\n10613\t\n10614\t/* Check UTF. We have the original options in 'options', with that value as\n10615\tmodified by (*UTF) etc in cb->external_options. The extra option\n10616\tPCRE2_EXTRA_ALLOW_SURROGATE_ESCAPES is not permitted in UTF-16 mode because the\n10617\tsurrogate code points cannot be represented in UTF-16. */\n10618\t\n10619\tutf = (cb.external_options & PCRE2_UTF) != 0;\n10620\tif (utf)\n10621\t  {\n10622\t  if ((options & PCRE2_NEVER_UTF) != 0)\n10623\t    {\n10624\t    errorcode = ERR74;\n10625\t    goto HAD_EARLY_ERROR;\n10626\t    }\n10627\t  if ((options & PCRE2_NO_UTF_CHECK) == 0 &&\n10628\t       (errorcode = PRIV(valid_utf)(pattern, patlen, erroroffset)) != 0)\n10629\t    goto HAD_ERROR;  /* Offset was set by valid_utf() */\n10630\t\n10631\t#if PCRE2_CODE_UNIT_WIDTH == 16\n10632\t  if ((ccontext->extra_options & PCRE2_EXTRA_ALLOW_SURROGATE_ESCAPES) != 0)\n10633\t    {\n10634\t    errorcode = ERR91;\n10635\t    goto HAD_EARLY_ERROR;\n10636\t    }\n10637\t#endif\n10638\t  }\n10639\t\n10640\t/* Check UCP lockout. */\n10641\t\n10642\tucp = (cb.external_options & PCRE2_UCP) != 0;\n10643\tif (ucp && (cb.external_options & PCRE2_NEVER_UCP) != 0)\n10644\t  {\n10645\t  errorcode = ERR75;\n10646\t  goto HAD_EARLY_ERROR;\n10647\t  }\n10648\t\n10649\t/* PCRE2_EXTRA_TURKISH_CASING checks */\n10650\t\n10651\tif ((xoptions & PCRE2_EXTRA_TURKISH_CASING) != 0)\n10652\t  {\n10653\t  if (!utf && !ucp)\n10654\t    {\n10655\t    errorcode = ERR104;\n10656\t    goto HAD_EARLY_ERROR;\n10657\t    }\n10658\t\n10659\t#if PCRE2_CODE_UNIT_WIDTH == 8\n10660\t  if (!utf)\n10661\t    {\n10662\t    errorcode = ERR105;\n10663\t    goto HAD_EARLY_ERROR;\n10664\t    }\n10665\t#endif\n10666\t\n10667\t  if ((xoptions & PCRE2_EXTRA_CASELESS_RESTRICT) != 0)\n10668\t    {\n10669\t    errorcode = ERR106;\n10670\t    goto HAD_EARLY_ERROR;\n10671\t    }\n10672\t  }\n10673\t\n10674\t/* Process the BSR setting. */\n10675\t\n10676\tif (bsr == 0) bsr = ccontext->bsr_convention;\n10677\t\n10678\t/* Process the newline setting. */\n10679\t\n10680\tif (newline == 0) newline = ccontext->newline_convention;\n10681\tcb.nltype = NLTYPE_FIXED;\n10682\tswitch(newline)\n10683\t  {\n10684\t  case PCRE2_NEWLINE_CR:\n10685\t  cb.nllen = 1;\n10686\t  cb.nl[0] = CHAR_CR;\n10687\t  break;\n10688\t\n10689\t  case PCRE2_NEWLINE_LF:\n10690\t  cb.nllen = 1;\n10691\t  cb.nl[0] = CHAR_NL;\n10692\t  break;\n10693\t\n10694\t  case PCRE2_NEWLINE_NUL:\n10695\t  cb.nllen = 1;\n10696\t  cb.nl[0] = CHAR_NUL;\n10697\t  break;\n10698\t\n10699\t  case PCRE2_NEWLINE_CRLF:\n10700\t  cb.nllen = 2;\n10701\t  cb.nl[0] = CHAR_CR;\n10702\t  cb.nl[1] = CHAR_NL;\n10703\t  break;\n10704\t\n10705\t  case PCRE2_NEWLINE_ANY:\n10706\t  cb.nltype = NLTYPE_ANY;\n10707\t  break;\n10708\t\n10709\t  case PCRE2_NEWLINE_ANYCRLF:\n10710\t  cb.nltype = NLTYPE_ANYCRLF;\n10711\t  break;\n10712\t\n10713\t  /* LCOV_EXCL_START */\n10714\t  default:\n10715\t  PCRE2_DEBUG_UNREACHABLE();\n10716\t  errorcode = ERR56;\n10717\t  goto HAD_EARLY_ERROR;\n10718\t  /* LCOV_EXCL_STOP */\n10719\t  }\n10720\t\n10721\t/* Pre-scan the pattern to do two things: (1) Discover the named groups and\n10722\ttheir numerical equivalents, so that this information is always available for\n10723\tthe remaining processing. (2) At the same time, parse the pattern and put a\n10724\tprocessed version into the parsed_pattern vector. This has escapes interpreted\n10725\tand comments removed (amongst other things). */\n10726\t\n10727\t/* Ensure that the parsed pattern buffer is big enough. For many smaller\n10728\tpatterns the vector on the stack (which was set up above) can be used. */\n10729\t\n10730\tparsed_size_needed = max_parsed_pattern(ptr, cb.end_pattern, utf, options);\n10731\t\n10732\t/* Allow for 2x uint32_t at the start and 2 at the end, for\n10733\tPCRE2_EXTRA_MATCH_WORD or PCRE2_EXTRA_MATCH_LINE (which are exclusive). */\n10734\t\n10735\tif ((ccontext->extra_options &\n10736\t     (PCRE2_EXTRA_MATCH_WORD|PCRE2_EXTRA_MATCH_LINE)) != 0)\n10737\t  parsed_size_needed += 4;\n10738\t\n10739\t/* When PCRE2_AUTO_CALLOUT is set we allow for one callout at the end. */\n10740\t\n10741\tif ((options & PCRE2_AUTO_CALLOUT) != 0)\n10742\t  parsed_size_needed += 4;\n10743\t\n10744\tparsed_size_needed += 1;  /* For the final META_END */\n10745\t\n10746\tif (parsed_size_needed > PARSED_PATTERN_DEFAULT_SIZE)\n10747\t  {\n10748\t  uint32_t *heap_parsed_pattern = ccontext->memctl.malloc(\n10749\t    parsed_size_needed * sizeof(uint32_t), ccontext->memctl.memory_data);\n10750\t  if (heap_parsed_pattern == NULL)\n10751\t    {\n10752\t    *errorptr = ERR21;\n10753\t    goto EXIT;\n10754\t    }\n10755\t  cb.parsed_pattern = heap_parsed_pattern;\n10756\t  }\n10757\tcb.parsed_pattern_end = cb.parsed_pattern + parsed_size_needed;\n10758\t\n10759\t/* Do the parsing scan. */\n10760\t\n10761\terrorcode = parse_regex(ptr, cb.external_options, xoptions, &has_lookbehind, &cb);\n10762\tif (errorcode != 0) goto HAD_CB_ERROR;\n10763\t\n10764\t/* If there are any lookbehinds, scan the parsed pattern to figure out their\n10765\tlengths. Workspace is needed to remember whether numbered groups are or are not\n10766\tof limited length, and if limited, what the minimum and maximum lengths are.\n10767\tThis caching saves re-computing the length of any group that is referenced more\n10768\tthan once, which is particularly relevant when recursion is involved.\n10769\tUnnumbered groups do not have this exposure because they cannot be referenced.\n10770\tIf there are sufficiently few groups, the default index vector on the stack, as\n10771\tset up above, can be used. Otherwise we have to get/free some heap memory. The\n10772\tvector must be initialized to zero. */\n10773\t\n10774\tif (has_lookbehind)\n10775\t  {\n10776\t  int loopcount = 0;\n10777\t  if (cb.bracount >= GROUPINFO_DEFAULT_SIZE/2)\n10778\t    {\n10779\t    cb.groupinfo = ccontext->memctl.malloc(\n10780\t      (2 * (cb.bracount + 1))*sizeof(uint32_t), ccontext->memctl.memory_data);\n10781\t    if (cb.groupinfo == NULL)\n10782\t      {\n10783\t      errorcode = ERR21;\n10784\t      cb.erroroffset = 0;\n10785\t      goto HAD_CB_ERROR;\n10786\t      }\n10787\t    }\n10788\t  memset(cb.groupinfo, 0, (2 * cb.bracount + 1) * sizeof(uint32_t));\n10789\t  errorcode = check_lookbehinds(cb.parsed_pattern, NULL, NULL, &cb, &loopcount);\n10790\t  if (errorcode != 0) goto HAD_CB_ERROR;\n10791\t  }\n10792\t\n10793\t/* For debugging, there is a function that shows the parsed pattern vector. */\n10794\t\n10795\t#ifdef DEBUG_SHOW_PARSED\n10796\tfprintf(stderr, \"+++ Pre-scan complete:\\n\");\n10797\tshow_parsed(&cb);\n10798\t#endif\n10799\t\n10800\t/* For debugging capturing information this code can be enabled. */\n10801\t\n10802\t#ifdef DEBUG_SHOW_CAPTURES\n10803\t  {\n10804\t  named_group *ng = cb.named_groups;\n10805\t  fprintf(stderr, \"+++Captures: %d\\n\", cb.bracount);\n10806\t  for (i = 0; i < cb.names_found; i++, ng++)\n10807\t    {\n10808\t    fprintf(stderr, \"+++%3d %.*s\\n\", ng->number, ng->length, ng->name);\n10809\t    }\n10810\t  }\n10811\t#endif\n10812\t\n10813\t/* Pretend to compile the pattern while actually just accumulating the amount\n10814\tof memory required in the 'length' variable. This behaviour is triggered by\n10815\tpassing a non-NULL final argument to compile_regex(). We pass a block of\n10816\tworkspace (cworkspace) for it to compile parts of the pattern into; the\n10817\tcompiled code is discarded when it is no longer needed, so hopefully this\n10818\tworkspace will never overflow, though there is a test for its doing so.\n10819\t\n10820\tOn error, errorcode will be set non-zero, so we don't need to look at the\n10821\tresult of the function. The initial options have been put into the cb block,\n10822\tbut we still have to pass a separate options variable (the first argument)\n10823\tbecause the options may change as the pattern is processed. */\n10824\t\n10825\tcb.erroroffset = patlen;   /* For any subsequent errors that do not set it */\n10826\tpptr = cb.parsed_pattern;\n10827\tcode = cworkspace;\n10828\t*code = OP_BRA;\n10829\t\n10830\t(void)compile_regex(cb.external_options, xoptions, &code, &pptr,\n10831\t   &errorcode, 0, &firstcu, &firstcuflags, &reqcu, &reqcuflags, NULL, NULL,\n10832\t   &cb, &length);\n10833\t\n10834\tif (errorcode != 0) goto HAD_CB_ERROR;  /* Offset is in cb.erroroffset */\n10835\t\n10836\t/* This should be caught in compile_regex(), but just in case... */\n10837\t\n10838\t#if defined SUPPORT_WIDE_CHARS\n10839\tPCRE2_ASSERT((cb.char_lists_size & 0x3) == 0);\n10840\tif (length > MAX_PATTERN_SIZE ||\n10841\t    MAX_PATTERN_SIZE - length < (cb.char_lists_size / sizeof(PCRE2_UCHAR)))\n10842\t#else\n10843\tif (length > MAX_PATTERN_SIZE)\n10844\t#endif\n10845\t  {\n10846\t  errorcode = ERR20;\n10847\t  cb.erroroffset = 0;\n10848\t  goto HAD_CB_ERROR;\n10849\t  }\n10850\t\n10851\t/* Compute the size of, then, if not too large, get and initialize the data\n10852\tblock for storing the compiled pattern and names table. Integer overflow should\n10853\tno longer be possible because nowadays we limit the maximum value of\n10854\tcb.names_found and cb.name_entry_size. */\n10855\t\n10856\tre_blocksize =\n10857\t  CU2BYTES((PCRE2_SIZE)cb.names_found * (PCRE2_SIZE)cb.name_entry_size);\n10858\t\n10859\t#if defined SUPPORT_WIDE_CHARS\n10860\tif (cb.char_lists_size != 0)\n10861\t  {\n10862\t#if PCRE2_CODE_UNIT_WIDTH != 32\n10863\t  /* Align to 32 bit first. This ensures the\n10864\t  allocated area will also be 32 bit aligned. */\n10865\t  re_blocksize = (PCRE2_SIZE)CLIST_ALIGN_TO(re_blocksize, sizeof(uint32_t));\n10866\t#endif\n10867\t  re_blocksize += cb.char_lists_size;\n10868\t  }\n10869\t#endif\n10870\t\n10871\tre_blocksize += CU2BYTES(length);\n10872\t\n10873\tif (re_blocksize > ccontext->max_pattern_compiled_length)\n10874\t  {\n10875\t  errorcode = ERR101;\n10876\t  cb.erroroffset = 0;\n10877\t  goto HAD_CB_ERROR;\n10878\t  }\n10879\t\n10880\tre_blocksize += sizeof(pcre2_real_code);\n10881\tre = (pcre2_real_code *)\n10882\t  ccontext->memctl.malloc(re_blocksize, ccontext->memctl.memory_data);\n10883\tif (re == NULL)\n10884\t  {\n10885\t  errorcode = ERR21;\n10886\t  cb.erroroffset = 0;\n10887\t  goto HAD_CB_ERROR;\n10888\t  }\n10889\t\n10890\t/* The compiler may put padding at the end of the pcre2_real_code structure in\n10891\torder to round it up to a multiple of 4 or 8 bytes. This means that when a\n10892\tcompiled pattern is copied (for example, when serialized) undefined bytes are\n10893\tread, and this annoys debuggers such as valgrind. To avoid this, we explicitly\n10894\twrite to the last 8 bytes of the structure before setting the fields. */\n10895\t\n10896\tmemset((char *)re + sizeof(pcre2_real_code) - 8, 0, 8);\n10897\tre->memctl = ccontext->memctl;\n10898\tre->tables = tables;\n10899\tre->executable_jit = NULL;\n10900\tmemset(re->start_bitmap, 0, 32 * sizeof(uint8_t));\n10901\tre->blocksize = re_blocksize;\n10902\tre->code_start = re_blocksize - CU2BYTES(length);\n10903\tre->magic_number = MAGIC_NUMBER;\n10904\tre->compile_options = options;\n10905\tre->overall_options = cb.external_options;\n10906\tre->extra_options = xoptions;\n10907\tre->flags = PCRE2_CODE_UNIT_WIDTH/8 | cb.external_flags | setflags;\n10908\tre->limit_heap = limit_heap;\n10909\tre->limit_match = limit_match;\n10910\tre->limit_depth = limit_depth;\n10911\tre->first_codeunit = 0;\n10912\tre->last_codeunit = 0;\n10913\tre->bsr_convention = bsr;\n10914\tre->newline_convention = newline;\n10915\tre->max_lookbehind = 0;\n10916\tre->minlength = 0;\n10917\tre->top_bracket = 0;\n10918\tre->top_backref = 0;\n10919\tre->name_entry_size = cb.name_entry_size;\n10920\tre->name_count = cb.names_found;\n10921\tre->optimization_flags = optim_flags;\n10922\t\n10923\t/* The basic block is immediately followed by the name table, and the compiled\n10924\tcode follows after that. */\n10925\t\n10926\tcodestart = (PCRE2_UCHAR *)((uint8_t *)re + re->code_start);\n10927\t\n10928\t/* Update the compile data block for the actual compile. The starting points of\n10929\tthe name/number translation table and of the code are passed around in the\n10930\tcompile data block. The start/end pattern and initial options are already set\n10931\tfrom the pre-compile phase, as is the name_entry_size field. */\n10932\t\n10933\tcb.parens_depth = 0;\n10934\tcb.assert_depth = 0;\n10935\tcb.lastcapture = 0;\n10936\tcb.name_table = (PCRE2_UCHAR *)((uint8_t *)re + sizeof(pcre2_real_code));\n10937\tcb.start_code = codestart;\n10938\tcb.req_varyopt = 0;\n10939\tcb.had_accept = FALSE;\n10940\tcb.had_pruneorskip = FALSE;\n10941\t#ifdef SUPPORT_WIDE_CHARS\n10942\tcb.char_lists_size = 0;\n10943\t#endif\n10944\t\n10945\t\n10946\t/* If any named groups were found, create the name/number table from the list\n10947\tcreated in the pre-pass. */\n10948\t\n10949\tif (cb.names_found > 0)\n10950\t  {\n10951\t  named_group *ng = cb.named_groups;\n10952\t  uint32_t tablecount = 0;\n10953\t\n10954\t  /* Length 0 represents duplicates, and they have already been handled. */\n10955\t  for (i = 0; i < cb.names_found; i++, ng++)\n10956\t    if (ng->length > 0)\n10957\t      tablecount = PRIV(compile_add_name_to_table)(&cb, ng, tablecount);\n10958\t\n10959\t  PCRE2_ASSERT(tablecount == cb.names_found);\n10960\t  }\n10961\t\n10962\t/* Set up a starting, non-extracting bracket, then compile the expression. On\n10963\terror, errorcode will be set non-zero, so we don't need to look at the result\n10964\tof the function here. */\n10965\t\n10966\tpptr = cb.parsed_pattern;\n10967\tcode = (PCRE2_UCHAR *)codestart;\n10968\t*code = OP_BRA;\n10969\tregexrc = compile_regex(re->overall_options, re->extra_options, &code,\n10970\t  &pptr, &errorcode, 0, &firstcu, &firstcuflags, &reqcu, &reqcuflags, NULL,\n10971\t  NULL, &cb, NULL);\n10972\tif (regexrc < 0) re->flags |= PCRE2_MATCH_EMPTY;\n10973\tre->top_bracket = cb.bracount;\n10974\tre->top_backref = cb.top_backref;\n10975\tre->max_lookbehind = cb.max_lookbehind;\n10976\t\n10977\tif 